struct P2 {
  x: Int
} derive (Eq)

struct Boxed[T] {
  value: T
} derive (Eq)

fn main with Console {
  let n = 7
  let flag = true

  let a1 = []
  let a2 = []
  Array::push(a1, 1)
  Array::push(a2, 1)
  println("int literal        = \{a1 == a2}")

  let b1 = []
  let b2 = []
  Array::push(b1, -1)
  Array::push(b2, -1)
  println("negative int       = \{b1 == b2}")

  let c1 = []
  let c2 = []
  Array::push(c1, ())
  Array::push(c2, ())
  println("unit literal       = \{c1 == c2}")

  let d1 = []
  let d2 = []
  Array::push(d1, [1, 2])
  Array::push(d2, [1, 2])
  println("array literal      = \{d1 == d2}")

  let e1 = []
  let e2 = []
  Array::push(e1, [-1])
  Array::push(e2, [-1])
  println("array of negative  = \{e1 == e2}")

  let f1 = []
  let f2 = []
  Array::push(f1, (1, "a"))
  Array::push(f2, (1, "a"))
  println("tuple literal      = \{f1 == f2}")

  let g1 = []
  let g2 = []
  Array::push(g1, if flag { 1 } else { 2 })
  Array::push(g2, if flag { 1 } else { 2 })
  println("conditional        = \{g1 == g2}")

  let h1 = []
  let h2 = []
  Array::push(h1, "x\{n}")
  Array::push(h2, "x\{n}")
  println("interp string      = \{h1 == h2}")

  let i1 = []
  let i2 = []
  Array::push(i1, P2::{ x: 1 })
  Array::push(i2, P2::{ x: 1 })
  println("struct literal     = \{i1 == i2}")
}
