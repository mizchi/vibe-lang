...@_theme
direction: right
src: "fn main allows\nConsole + Fs + Http" {class: box}
flags: "vibe build\n--deny-http" {class: hot}
dce: "Http を使う\nコードを DCE" {class: box}
wasm: "app.wasm\nimport:\nConsole, Fs" {class: box}
run: "起動時" {
  class: group
  check: "必須の権限が無い\n→ main の前で止める" {class: bad}
  ok: "揃っている\n→ main を実行" {class: box}
}
src -> flags: "ビルド時に一度だけ" {class: flow}
flags -> dce {class: flow}
dce -> wasm {class: flow}
wasm -> run.check {class: refused}
wasm -> run.ok {class: flow}
