...@_theme
direction: right
seed: "seed\ncompiler.wasm (sha256 で pin)" {class: box}
s1: "stage1\nseed が今のソースを\nコンパイル" {class: box}
s2: "stage2\nstage1 が自分を\nコンパイル (本番)" {class: hot}
s3: "stage3\nstage2 が自分を\nコンパイル" {class: box}
seed -> s1 {class: flow}
s1 -> s2 {class: flow}
s2 -> s3 {class: flow}
s3 -> s2: "バイト一致 = fixpoint" {class: flow}
bump: "新しい構文は\nseed を先に tag して bump" {class: bad}
bump -> seed {class: refused}
