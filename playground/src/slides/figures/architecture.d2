...@_theme
direction: right
src: "app.vibe" {class: box}
compiler: "vibe コンパイラ\n(vibe で書いて wasm で動く)" {class: hot}
wasm: "app.wasm\nimport は使う権限の分だけ" {class: box}
hosts: "ホストが import を外付けする" {
  class: group
  cli: "CLI\nRust + Wasmtime" {class: box}
  browser: "ブラウザ\n(このスライド)" {class: box}
  node: "Node.js" {class: box}
}
src -> compiler: "コンパイル" {class: flow}
compiler -> wasm {class: flow}
wasm -> hosts.cli {class: flow}
wasm -> hosts.browser {class: flow}
wasm -> hosts.node {class: flow}
