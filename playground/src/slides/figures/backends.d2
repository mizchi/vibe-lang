...@_theme
direction: right
codegen: "vibe codegen" {class: hot}
linear: "linear memory\n(本番)" {
  class: group
  simd: "v128 SIMD ✓" {class: box}
  thr: "threads: 結局どの仕様に乗るか" {class: bad}
}
gc: "wasm-gc" {
  class: group
  ref: "GC ✓" {class: box}
  arr: "ref 型の配列に v128 ✗" {class: bad}
}
wit: "WIT 境界\nジェネリクス ✗ → 型を決め打ち" {class: bad}
codegen -> linear {class: flow}
codegen -> gc {class: flow}
linear -> wit {class: flow}
gc -> wit {class: flow}
