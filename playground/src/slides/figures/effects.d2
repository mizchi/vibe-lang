...@_theme
direction: down
row: "effect row" {
  class: group
  direction: right
  alg: "代数的エフェクト\nperform Log::Emit(..)" {class: box}
  cap: "権限 (capability)\nFs::read_file(..) はただの関数呼び出し" {class: box}
}
handle: "handle { .. } with { .. }\nresume は 1 回、arm の最後だけ" {class: hot}
entry: "fn main allows A + B\n残った row は entry が与える" {class: hot}
host: "ホストの import\n(ビルド時に許可した分だけ)" {class: box}
row.alg -> handle: "ここで消える" {class: flow}
row.cap -> entry: "最後まで残る" {class: flow}
entry -> host {class: flow}
