...@_theme
direction: right
checker: "checker\n型がある" {class: box}
desugar: "normalize / desugar\n型を見ない" {class: bad}
lowering: "lowering\n== をここで決める" {class: hot}
codegen: "codegen" {class: box}
checker -> desugar {class: flow}
desugar -> lowering {class: flow}
lowering -> codegen {class: flow}
checker -> lowering: "== の型だけ別に渡す" {class: flow}
ref: "型が届かない ==\n昔: アドレスで比較 (黙って false)\n今: ビルドエラーで注釈を求める" {class: bad}
lowering -> ref {class: refused}
