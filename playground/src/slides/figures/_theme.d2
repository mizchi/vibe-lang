# Shared look for every slide figure: the deck's dark palette.
vars: {
  d2-config: {
    layout-engine: tala
    pad: 8
  }
}
style: {
  fill: "#161513"
}
classes: {
  box: {
    style: {
      fill: "#1e1c19"
      stroke: "#3a352e"
      font-color: "#f4efe4"
      border-radius: 8
      font-size: 28
    }
  }
  hot: {
    style: {
      fill: "#26231f"
      stroke: "#e07a3c"
      stroke-width: 3
      font-color: "#f4efe4"
      border-radius: 8
      font-size: 28
    }
  }
  group: {
    style: {
      fill: "#161513"
      stroke: "#5c564c"
      stroke-dash: 4
      font-color: "#e8a35a"
      border-radius: 10
      font-size: 28
    }
  }
  bad: {
    style: {
      fill: "#2a1a17"
      stroke: "#ff8f80"
      font-color: "#ff8f80"
      border-radius: 8
      font-size: 28
    }
  }
  flow: {
    style: {
      stroke: "#e07a3c"
      font-color: "#c4bcae"
      font-size: 24
      stroke-width: 2
    }
  }
  refused: {
    style: {
      stroke: "#ff8f80"
      stroke-dash: 5
      font-color: "#ff8f80"
      font-size: 24
      stroke-width: 2
    }
  }
}
