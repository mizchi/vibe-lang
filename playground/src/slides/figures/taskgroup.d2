...@_theme
direction: right
tg: "TaskGroup::run((g) -> ..) = region" {
  class: group
  a: "task a" {class: box}
  ch: "Channel" {class: box}
  b: "task b" {class: box}
  a -> ch: "send" {class: flow}
  ch -> b: "recv" {class: flow}
}
out: "run の外" {class: box}
tg -> out: "Send な値だけ" {class: flow}
leak: "TaskHandle を返す\nArray を捕まえる" {class: bad}
leak -> tg: "コンパイルエラー" {class: refused}
