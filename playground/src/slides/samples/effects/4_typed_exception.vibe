enum ParseError {
  Empty;
  NotDigit(String)
}

fn digit(s: String) -> Int with Exception[ParseError] {
  if s == "" { throw(ParseError::Empty) }
  if s < "0" || s > "9" { throw(ParseError::NotDigit(s)) }
  String::char_code_at(s, at = 0) - 48
}

fn show(s: String) -> String {
  handle { "\{digit(s = s)}" } with {
    Exception[ParseError]::Throw(e) => match e {
      Empty => "empty",
      NotDigit(c) => "not a digit: \{c}"
    }
  }
}

fn main allows Console {
  println(show(s = "7"))
  println(show(s = ""))
  println(show(s = "x"))
}
