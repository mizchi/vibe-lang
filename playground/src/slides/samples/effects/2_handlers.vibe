effect Emit { Line(String) -> Unit }

fn fizz(upto: Int) -> Unit with Emit {
  let mut i = 1
  while i <= upto {
    let s = if i % 3 == 0 { "Fizz" } else { "\{i}" }
    perform Emit::Line(s)
    i = i + 1
  }
}

fn main allows Console {
  handle { fizz(4) } with {
    Emit::Line(s) => { println(s); resume(()) }
  }
  let mut n = 0
  handle { fizz(9) } with {
    Emit::Line(_) => { n = n + 1; resume(()) }
  }
  println("lines = \{n}")
}
