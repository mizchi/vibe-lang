fn fetch_score(name: String) -> Future[Int] {
  Future::ready(String::length(name) * 10)
}

fn total(names: Array[String]) -> Int with Async {
  let mut acc = 0
  for n in names {
    acc = acc + await(fetch_score(n))
  }
  acc
}

fn main allows Console + Async {
  let later = Future::pending()
  Future::resolve(later, "resolved later")
  println(await(later))
  println("total = \{total(["vibe", "wasm"])}")
}
