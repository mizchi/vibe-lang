struct Box[T] {
  value: T
} derive (Eq)

fn main with Console {
  // annotated: does the SAME wrong comparison happen without #2157's path?
  let xs: Array[Box[Array[Int]]] = []
  let ys: Array[Box[Array[Int]]] = []
  Array::push(xs, Box::{ value: [1, 2] })
  Array::push(ys, Box::{ value: [1, 2] })
  println("annotated generic struct = \{xs == ys}")
  // and a bare (non-array) comparison of two such boxes
  let a = Box::{ value: [1, 2] }
  let b = Box::{ value: [1, 2] }
  println("bare box comparison      = \{a == b}")
}
