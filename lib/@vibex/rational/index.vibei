version 0.0.1

// @vibex/rational — 任意精度有理数 (ADR-0065 実験 scope)。@vibex/bigint の上に
// 構築。表現: num/den (BigInt)、常に正規化 — gcd 約分、den > 0 (符号は num 側)、
// zero は 0/1。Rational は bodyless type 宣言 (#739 の透過 re-export — 定義は
// impl 側)。Rational::* は名前空間 fn 宣言 (#752)。to_double は未提供
// (BigInt に Double 変換面が無いため)。signature 中の BigInt は impl が
// `import ../bigint` で取り込む型 (@vibe/parser の Expr/TypeExpr と同じ形 —
// contract 内の directory import は loader 未対応)。

import ./rational.vibe {}

type Rational

fn Rational::from_int(n: Int) -> Rational
fn Rational::from_ints(num: Int, den: Int) -> Option[Rational]
fn Rational::from_bigints(num: BigInt, den: BigInt) -> Option[Rational]
fn Rational::parse(s: String) -> Option[Rational]
fn Rational::to_string(a: Rational) -> String
fn Rational::add(a: Rational, b: Rational) -> Rational
fn Rational::sub(a: Rational, b: Rational) -> Rational
fn Rational::mul(a: Rational, b: Rational) -> Rational
fn Rational::div(a: Rational, b: Rational) -> Option[Rational]
fn Rational::cmp(a: Rational, b: Rational) -> Int
fn Rational::equals(a: Rational, b: Rational) -> Bool
fn Rational::neg(a: Rational) -> Rational
fn Rational::abs(a: Rational) -> Rational
fn Rational::is_zero(a: Rational) -> Bool

let version: String
