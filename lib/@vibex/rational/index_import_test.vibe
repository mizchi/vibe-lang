//# Imports

import . {
  Rational::from_ints, Rational::add, Rational::to_string
}

//# Misc

test "x/rational index exports the Rational API" {
  match Rational::from_ints(1, 2) {
    Some(half) => {
      match Rational::from_ints(1, 3) {
        Some(third) => assert(Rational::to_string(Rational::add(half, third)) == "5/6"),
        None => assert(false)
      }
    },
    None => assert(false)
  }
}
