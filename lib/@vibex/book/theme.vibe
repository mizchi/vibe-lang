// Rust-book-inspired layout: dark sidebar, paper content, copper accent.
// Intentionally small — one stylesheet, no JS framework.

//# Functions

export fn book_css() -> String {
  ":root{--bg:#f6f1e7;--paper:#fffaf1;--ink:#1b1a17;--muted:#5c564c;--accent:#c45c26;--accent-2:#1f4d46;--side:#161513;--side-ink:#ece6da;--side-muted:#9a9284;--code-bg:#1e1c19;--code-ink:#f4efe4;--kw:#e8a35a;--st:#8fbf8a;--cm:#8a8376;--border:#e2d8c4}*{box-sizing:border-box}html,body{margin:0;padding:0;background:var(--bg);color:var(--ink);font:18px/1.65 \"Iowan Old Style\",\"Palatino Linotype\",Palatino,Georgia,serif}a{color:var(--accent-2)}a:hover{color:var(--accent)}.layout{display:flex;min-height:100vh}nav.side{width:280px;flex:0 0 280px;background:var(--side);color:var(--side-ink);padding:1.5rem 1.1rem 3rem;position:sticky;top:0;height:100vh;overflow:auto}nav.side a{color:var(--side-ink);text-decoration:none}nav.side a:hover{color:#fff}nav.side .brand{font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:.78rem;color:var(--accent);margin:0 0 1.4rem}nav.side ol{list-style:none;margin:0;padding:0}nav.side li{margin:.18rem 0;line-height:1.35}nav.side li.part{margin-top:1.15rem;margin-bottom:.25rem;font:700 .68rem/1.2 ui-sans-serif,system-ui,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}nav.side li.part:first-child{margin-top:.2rem}nav.side li.depth-1{padding-left:.9rem;font-size:.92em;color:var(--side-muted)}nav.side li.here a{color:var(--accent)}.page{flex:1;max-width:46rem;margin:0 auto;padding:2.2rem 1.6rem 5rem;background:linear-gradient(180deg,var(--paper),var(--bg) 28rem)}main.page{box-shadow:none}.page h1,.page h2,.page h3{font-weight:650;line-height:1.25;letter-spacing:-.02em}.page h1{font-size:2.15rem;margin-top:0}.page h2{margin-top:2.2rem;border-bottom:1px solid var(--border);padding-bottom:.3rem}.page h3{margin-top:1.6rem}.page p{margin:1rem 0}pre{background:var(--code-bg);color:var(--code-ink);padding:1rem 1.1rem;overflow:auto;border-radius:6px;font:14px/1.5 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.88em}p code,li code{background:#efe6d4;padding:.1em .35em;border-radius:3px}pre code{background:transparent;padding:0;font-size:14px}.kw{color:var(--kw);font-weight:600}.st{color:var(--st)}.cm{color:var(--cm);font-style:italic}blockquote{border-left:3px solid var(--accent);margin:1.2rem 0;padding:.2rem 0 .2rem 1rem;color:var(--muted)}hr{border:0;border-top:1px solid var(--border);margin:2rem 0}.navrow{display:flex;justify-content:space-between;gap:1rem;margin-top:3rem;padding-top:1rem;border-top:1px solid var(--border)}.navrow a{text-decoration:none}.navrow .dir{display:block;font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}footer.site{margin-top:3rem;color:var(--muted);font-size:.9rem}@media(max-width:840px){.layout{display:block}nav.side{position:relative;width:auto;height:auto;padding:1rem}nav.side li.part{margin-top:.8rem}}"
}

export fn page_html(title: String, sidebar: String, body: String, prev_html: String, next_html: String) -> String {
  let sb = StringBuilder::new()
  StringBuilder::push(sb, "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<title>")
  StringBuilder::push(sb, title)
  StringBuilder::push(sb, " · The Vibe Programming Language</title>\n<style>\n")
  StringBuilder::push(sb, book_css())
  StringBuilder::push(sb, "\n</style>\n</head>\n<body>\n<div class=\"layout\">\n<nav class=\"side\">\n<p class=\"brand\"><a href=\"index.html\">The Vibe Book</a></p>\n")
  StringBuilder::push(sb, sidebar)
  StringBuilder::push(sb, "</nav>\n<main class=\"page\">\n")
  StringBuilder::push(sb, body)
  StringBuilder::push(sb, "<div class=\"navrow\">")
  StringBuilder::push(sb, prev_html)
  StringBuilder::push(sb, next_html)
  StringBuilder::push(sb, "</div>\n<footer class=\"site\">Examples are <code>.vibe.md</code> and checked by <code>vibe_md</code>.</footer>\n</main>\n</div>\n</body>\n</html>\n")
  StringBuilder::build(sb)
}
