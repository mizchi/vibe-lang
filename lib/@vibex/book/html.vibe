// @vibex/book — HTML helpers for the static book generator.
// Keyword highlighting is a small scanner, not a real lexer: strings and
// line comments are skipped so `fn` inside `"fn"` is not marked.

//# Functions

export fn escape_html(s: String) -> String {
  let n = String::length(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let c = String::char_code_at(s, i)
    if c == 38 {
      StringBuilder::push(sb, "&amp;")
    } else if c == 60 {
      StringBuilder::push(sb, "&lt;")
    } else if c == 62 {
      StringBuilder::push(sb, "&gt;")
    } else if c == 34 {
      StringBuilder::push(sb, "&quot;")
    } else {
      StringBuilder::push(sb, String::from_char_code(c))
    }
    i = i + 1
  }
  StringBuilder::build(sb)
}

fn is_ascii_letter(c: Int) -> Bool {
  c >= 65 && c <= 90 || c >= 97 && c <= 122
}

fn is_ascii_digit(c: Int) -> Bool {
  c >= 48 && c <= 57
}

fn is_ident_start(c: Int) -> Bool {
  is_ascii_letter(c) || c == 95
}

fn is_ident_cont(c: Int) -> Bool {
  is_ident_start(c) || is_ascii_digit(c)
}

fn is_vibe_keyword(word: String) -> Bool {
  word == "fn" || word == "let" || word == "mut" || word == "if" || word == "else" || word == "while" || word == "loop" || word == "for" || word == "in" || word == "match" || word == "return" || word == "break" || word == "continue" || word == "import" || word == "export" || word == "type" || word == "enum" || word == "struct" || word == "effect" || word == "handle" || word == "perform" || word == "resume" || word == "with" || word == "test" || word == "throw" || word == "trait" || word == "impl" || word == "opaque"
}

export fn slugify(s: String) -> String {
  let n = String::length(s)
  let sb = StringBuilder::new()
  let mut i = 0
  let mut dash = false
  while i < n {
    let c = String::char_code_at(s, i)
    let lower = if c >= 65 && c <= 90 {
      c + 32
    } else {
      c
    }
    if is_ascii_letter(lower) || is_ascii_digit(lower) {
      StringBuilder::push(sb, String::from_char_code(lower))
      dash = false
    } else if !dash {
      StringBuilder::push(sb, "-")
      dash = true
    } else {
      ()
    }
    i = i + 1
  }
  let out = StringBuilder::build(sb)
  let len = String::length(out)
  if len > 0 && String::char_code_at(out, len - 1) == 45 {
    out[0: len - 1]
  } else {
    out
  }
}

export fn highlight_vibe(code: String) -> String {
  let n = String::length(code)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let c = String::char_code_at(code, i)
    if c == 47 && i + 1 < n && String::char_code_at(code, i + 1) == 47 {
      let start = i
      i = i + 2
      while i < n && String::char_code_at(code, i) != 10 {
        i = i + 1
      }
      StringBuilder::push(sb, "<span class=\"cm\">")
      StringBuilder::push(sb, escape_html(code[start: i]))
      StringBuilder::push(sb, "</span>")
    } else if c == 34 {
      let start = i
      i = i + 1
      let mut done = false
      while i < n && !done {
        let ch = String::char_code_at(code, i)
        if ch == 92 && i + 1 < n {
          i = i + 2
        } else if ch == 34 {
          i = i + 1
          done = true
        } else {
          i = i + 1
        }
      }
      StringBuilder::push(sb, "<span class=\"st\">")
      StringBuilder::push(sb, escape_html(code[start: i]))
      StringBuilder::push(sb, "</span>")
    } else if c == 39 {
      let start = i
      i = i + 1
      if i < n {
        i = i + 1
      }
      if i < n && String::char_code_at(code, i) == 39 {
        i = i + 1
      }
      StringBuilder::push(sb, "<span class=\"st\">")
      StringBuilder::push(sb, escape_html(code[start: i]))
      StringBuilder::push(sb, "</span>")
    } else if is_ident_start(c) {
      let start = i
      i = i + 1
      while i < n && is_ident_cont(String::char_code_at(code, i)) {
        i = i + 1
      }
      let word = code[start: i]
      if is_vibe_keyword(word) {
        StringBuilder::push(sb, "<span class=\"kw\">")
        StringBuilder::push(sb, escape_html(word))
        StringBuilder::push(sb, "</span>")
      } else {
        StringBuilder::push(sb, escape_html(word))
      }
    } else {
      StringBuilder::push(sb, escape_html(String::from_char_code(c)))
      i = i + 1
    }
  }
  StringBuilder::build(sb)
}

fn find_char(s: String, from: Int, want: Int) -> Int {
  let n = String::length(s)
  let mut i = from
  let mut found = 0 - 1
  while i < n && found < 0 {
    if String::char_code_at(s, i) == want {
      found = i
    } else {
      i = i + 1
    }
  }
  found
}

export fn render_inline(s: String) -> String {
  let n = String::length(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let c = String::char_code_at(s, i)
    if c == 96 {
      let close = find_char(s, i + 1, 96)
      if close < 0 {
        StringBuilder::push(sb, escape_html("`"))
        i = i + 1
      } else {
        StringBuilder::push(sb, "<code>")
        StringBuilder::push(sb, escape_html(s[i + 1: close]))
        StringBuilder::push(sb, "</code>")
        i = close + 1
      }
    } else if c == 91 {
      let mid = find_char(s, i + 1, 93)
      if mid > i && mid + 1 < n && String::char_code_at(s, mid + 1) == 40 {
        let end = find_char(s, mid + 2, 41)
        if end > mid {
          StringBuilder::push(sb, "<a href=\"")
          StringBuilder::push(sb, escape_html(s[mid + 2: end]))
          StringBuilder::push(sb, "\">")
          StringBuilder::push(sb, escape_html(s[i + 1: mid]))
          StringBuilder::push(sb, "</a>")
          i = end + 1
        } else {
          StringBuilder::push(sb, escape_html("["))
          i = i + 1
        }
      } else {
        StringBuilder::push(sb, escape_html("["))
        i = i + 1
      }
    } else if c == 42 && i + 1 < n && String::char_code_at(s, i + 1) == 42 {
      let close = find_char(s, i + 2, 42)
      if close > i + 1 && close + 1 < n && String::char_code_at(s, close + 1) == 42 {
        StringBuilder::push(sb, "<strong>")
        StringBuilder::push(sb, escape_html(s[i + 2: close]))
        StringBuilder::push(sb, "</strong>")
        i = close + 2
      } else {
        StringBuilder::push(sb, escape_html("*"))
        i = i + 1
      }
    } else {
      StringBuilder::push(sb, escape_html(String::from_char_code(c)))
      i = i + 1
    }
  }
  StringBuilder::build(sb)
}
