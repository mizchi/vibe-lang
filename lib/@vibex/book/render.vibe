import @mizchi/markdown {
  Block, parse
}

import ./html.vibe {
  escape_html, highlight_vibe, render_inline, slugify
}

//# Functions

/// The page name a SUMMARY entry renders to. Output is flat, so the name has
/// to be unique across the whole book.
///
/// The canonical chapters live under `en/`, and their names are the URLs the
/// site has always published -- `en/02_x.vibe.md` stays `02_x.html`. A
/// translation is a DIFFERENT top-level directory holding the SAME basenames,
/// so taking the basename alone made `ja/01_values_functions.vibe.md` and
/// `en/01_values_functions.vibe.md` both write `01_values_functions.html`:
/// listing the Japanese book in SUMMARY.md would have silently overwritten the
/// English pages, one by one, with no error. So a top-level directory that is
/// not the canonical `en/` becomes part of the name
/// (`ja_01_values_functions.html`), which also works for whatever language
/// comes next -- and keeps every already-published English URL unchanged.
export fn html_name_for(path: String) -> String {
  let n = String::length(path)
  let mut first_slash = 0 - 1
  let mut last_slash = 0 - 1
  let mut i = 0
  while i < n {
    if String::char_code_at(path, i) == 47 {
      if first_slash < 0 {
        first_slash = i
      } else {
        ()
      }
      last_slash = i
    } else {
      ()
    }
    i = i + 1
  }
  let base = if last_slash >= 0 {
    path[last_slash + 1: n]
  } else {
    path
  }
  // Deeper directories under a language root do not disambiguate anything --
  // `en/support/mathx.vibe` has always been `mathx.html`. Only the root does.
  let top = if first_slash > 0 {
    path[0: first_slash]
  } else {
    ""
  }
  let named = if top == "" || top == "en" {
    base
  } else {
    String::concat(top, String::concat("_", base))
  }
  let bn = String::length(named)
  if bn > 8 && named[bn - 8: bn] == ".vibe.md" {
    String::concat(named[0: bn - 8], ".html")
  } else if bn > 5 && named[bn - 5: bn] == ".vibe" {
    String::concat(named[0: bn - 5], ".html")
  } else if bn > 3 && named[bn - 3: bn] == ".md" {
    String::concat(named[0: bn - 3], ".html")
  } else {
    String::concat(named, ".html")
  }
}

fn info_is_vibe(info: String) -> Bool {
  let n = String::length(info)
  if n >= 4 && info[0: 4] == "vibe" {
    true
  } else if n >= 5 && info[0: 5] == ".vibe" {
    true
  } else {
    false
  }
}

fn render_block(block: Block) -> String {
  match block {
    Heading(level, _, text) => {
      let id = slugify(text)
      let tag = String::concat("h", Int::to_string(level))
      String::concat(String::concat(String::concat(String::concat(String::concat(String::concat("<", tag), " id=\""), escape_html(id)), "\">"), render_inline(text)), String::concat(String::concat("</", tag), ">\n"))
    },
    Paragraph(text) => String::concat(String::concat("<p>", render_inline(text)), "</p>\n"),
    FencedCode(_, info, code) => {
      let body = if info_is_vibe(info) {
        highlight_vibe(code)
      } else {
        escape_html(code)
      }
      let cls = if info_is_vibe(info) {
        "hl vibe"
      } else {
        "hl"
      }
      String::concat(String::concat(String::concat(String::concat("<pre><code class=\"", cls), "\">"), body), "</code></pre>\n")
    },
    IndentedCode(code) => String::concat(String::concat("<pre><code>", escape_html(code)), "</code></pre>\n"),
    Blockquote(inner) => {
      let sb = StringBuilder::new()
      StringBuilder::push(sb, "<blockquote>\n")
      let mut i = 0
      while i < Array::length(inner) {
        StringBuilder::push(sb, render_block(Array::get(inner, i)))
        i = i + 1
      }
      StringBuilder::push(sb, "</blockquote>\n")
      StringBuilder::build(sb)
    },
    BulletList(_, items) => {
      let sb = StringBuilder::new()
      StringBuilder::push(sb, "<ul>\n")
      let mut i = 0
      while i < Array::length(items) {
        StringBuilder::push(sb, "<li>")
        StringBuilder::push(sb, render_inline(Array::get(items, i)))
        StringBuilder::push(sb, "</li>\n")
        i = i + 1
      }
      StringBuilder::push(sb, "</ul>\n")
      StringBuilder::build(sb)
    },
    OrderedList(_, items) => {
      let sb = StringBuilder::new()
      StringBuilder::push(sb, "<ol>\n")
      let mut i = 0
      while i < Array::length(items) {
        StringBuilder::push(sb, "<li>")
        StringBuilder::push(sb, render_inline(Array::get(items, i)))
        StringBuilder::push(sb, "</li>\n")
        i = i + 1
      }
      StringBuilder::push(sb, "</ol>\n")
      StringBuilder::build(sb)
    },
    ThematicBreak => "<hr />\n",
    HtmlBlock(raw) => raw,
    BlankLines(_) => ""
  }
}

export fn render_markdown(source: String) -> String {
  let doc = parse(source)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < Array::length(doc.blocks) {
    StringBuilder::push(sb, render_block(Array::get(doc.blocks, i)))
    i = i + 1
  }
  StringBuilder::build(sb)
}
