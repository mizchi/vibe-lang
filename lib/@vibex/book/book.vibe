import ./html.vibe {
  escape_html
}

import ./render.vibe {
  html_name_for, render_markdown
}

import ./summary.vibe {
  SummaryEntry
}

import ./theme.vibe {
  page_html
}

//# Functions

fn is_chapter(e: SummaryEntry) -> Bool {
  String::length(e.path) > 0
}

fn nav_neighbor(entries: Array[SummaryEntry], index: Int, step: Int) -> Option[SummaryEntry] {
  let n = Array::length(entries)
  let mut i = index + step
  while i >= 0 && i < n {
    let e = Array::get(entries, i)
    if is_chapter(e) {
      return Some(e)
    }
    i = i + step
  }
  None
}

export fn render_sidebar(entries: Array[SummaryEntry], current: String) -> String {
  let sb = StringBuilder::new()
  StringBuilder::push(sb, "<ol>\n")
  let n = Array::length(entries)
  let mut i = 0
  while i < n {
    let e = Array::get(entries, i)
    if !is_chapter(e) {
      StringBuilder::push(sb, "<li class=\"part\">")
      StringBuilder::push(sb, escape_html(e.title))
      StringBuilder::push(sb, "</li>\n")
    } else {
      let href = html_name_for(e.path)
      let here = if href == current {
        " here"
      } else {
        ""
      }
      let depth = if e.depth > 0 {
        " depth-1"
      } else {
        ""
      }
      StringBuilder::push(sb, "<li class=\"")
      StringBuilder::push(sb, depth)
      StringBuilder::push(sb, here)
      StringBuilder::push(sb, "\"><a href=\"")
      StringBuilder::push(sb, escape_html(href))
      StringBuilder::push(sb, "\">")
      StringBuilder::push(sb, escape_html(e.title))
      StringBuilder::push(sb, "</a></li>\n")
    }
    i = i + 1
  }
  StringBuilder::push(sb, "</ol>\n")
  StringBuilder::build(sb)
}

fn nav_link(label: String, entry: Option[SummaryEntry]) -> String {
  match entry {
    None => String::concat("<span></span>", ""),
    Some(e) => {
      let sb = StringBuilder::new()
      StringBuilder::push(sb, "<a href=\"")
      StringBuilder::push(sb, escape_html(html_name_for(e.path)))
      StringBuilder::push(sb, "\"><span class=\"dir\">")
      StringBuilder::push(sb, label)
      StringBuilder::push(sb, "</span>")
      StringBuilder::push(sb, escape_html(e.title))
      StringBuilder::push(sb, "</a>")
      StringBuilder::build(sb)
    }
  }
}

export fn render_page(title: String, source: String, entries: Array[SummaryEntry], index: Int) -> String {
  let n = Array::length(entries)
  let current = if index >= 0 && index < n {
    html_name_for(Array::get(entries, index).path)
  } else {
    "index.html"
  }
  let prev = nav_neighbor(entries, index, 0 - 1)
  let next = nav_neighbor(entries, index, 1)
  page_html(title, render_sidebar(entries, current), render_markdown(source), nav_link("Previous", prev), nav_link("Next", next))
}

export fn resolve_chapter_path(book_dir: String, listed: String) -> String {
  if String::length(listed) >= 4 && listed[0: 4] == "src/" {
    String::concat(String::concat(book_dir, "/"), listed)
  } else if String::length(listed) >= 3 && listed[0: 3] == "ja/" {
    String::concat(String::concat(book_dir, "/"), listed)
  } else {
    String::concat(String::concat(book_dir, "/src/"), listed)
  }
}
