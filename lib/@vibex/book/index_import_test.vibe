//# Imports

import .{
  escape_html, html_name_for, parse_summary, slugify
}

//# Misc

test "package contract exports the book helpers" {
  assert(escape_html("<") == "&lt;")
  assert(html_name_for("src/hi.vibe.md") == "hi.html")
  assert(slugify("Hello World") == "hello-world")
  let entries = parse_summary("- [Hi](src/hi.md)\n")
  assert(Array::length(entries) == 1)
}
