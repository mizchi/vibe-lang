name = @vibex/book
version = 0.0.1
description =
  #|@vibex/book — static site generator for The Vibe Programming Language
  #|book (book/*.vibe.md). Markdown in, a small rust-book-like HTML site out.
deps = {
  @mizchi/markdown : 0.2.0
  @vibe/prelude : 0.0.1
}

generated_hash =

// @vibex/book — experimental book SSG (ADR-0065). Renders checked
// `.vibe.md` chapters plus a SUMMARY.md into standalone HTML.

type SummaryEntry

fn escape_html(s: String) -> String
fn slugify(s: String) -> String
fn highlight_vibe(code: String) -> String
fn render_inline(s: String) -> String
fn html_name_for(path: String) -> String
fn render_markdown(source: String) -> String
fn parse_summary(source: String) -> Array[SummaryEntry]
fn render_sidebar(entries: Array[SummaryEntry], current: String) -> String
fn render_page(title: String, source: String, entries: Array[SummaryEntry], index: Int) -> String
fn resolve_chapter_path(book_dir: String, listed: String) -> String
fn book_css() -> String
fn page_html(title: String, sidebar: String, body: String, prev_html: String, next_html: String) -> String
