//# Imports

import ./component_parser.vibe {
  comp_section_name, count_core_modules, find_section, is_component, is_core_wasm, list_sections
}

//# Functions

fn make_bytes(values: Array[Int]) -> Bytes {
  let buf = Bytes::new()
  let mut i = 0
  while i < Array::length(values) {
    Bytes::push(buf, Array::get(values, i))
    i = i + 1
  }
  buf
}

fn component_small() -> Bytes {
  make_bytes([0, 97, 115, 109, 13, 0, 1, 0, 1, 8, 0, 97, 115, 109, 1, 0, 0, 0])
}

//# Misc

bench "component/is_component" {
  let _ = is_component(component_small())
}

bench "component/list_sections" {
  let _ = list_sections(component_small())
}

bench "component/count_core_modules" {
  let _ = count_core_modules(component_small())
}

bench "component/find_section" {
  let _ = find_section(component_small(), 1)
}

bench "component/comp_section_name" {
  let _ = comp_section_name(1)
  let _ = comp_section_name(7)
}
