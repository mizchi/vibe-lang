//# Imports

import ./component_parser.vibe {
  comp_section_name,
  comp_valtype_name,
  count_core_modules,
  count_exports,
  count_imports,
  extern_kind_name,
  extract_all_core_modules,
  extract_core_module,
  find_section,
  get_custom_section_name,
  is_component,
  is_core_wasm,
  list_sections,
  parse_canon_options,
  parse_component_type_section,
  parse_core_type_section
}

//# Functions

fn make_bytes(values: Array[Int]) -> Bytes {
  let buf = Bytes::new()
  let mut i = 0
  while i < Array::length(values) {
    Bytes::push(buf, Array::get(values, i))
    i = i + 1
  }
  buf
}

//# Misc

test "is_component valid" {
  let bytes = make_bytes([0, 97, 115, 109, 13, 0, 1, 0])
  assert(is_component(bytes) == true)
  assert(is_core_wasm(bytes) == false)
}

test "is_core_wasm valid" {
  let bytes = make_bytes([0, 97, 115, 109, 1, 0, 0, 0])
  assert(is_core_wasm(bytes) == true)
  assert(is_component(bytes) == false)
}

test "is_component too short" {
  let bytes = make_bytes([0, 97, 115])
  assert(is_component(bytes) == false)
  assert(is_core_wasm(bytes) == false)
}

test "list_sections empty component" {
  let bytes = make_bytes([0, 97, 115, 109, 13, 0, 1, 0])
  let sections = list_sections(bytes)
  assert(Array::length(sections) == 0)
}

test "list_sections with core module" {
  // Component header + core module section (id=1)
  // Core module: just header (8 bytes)
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    13,
    0,
    1,
    0,
    1,
    8,
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0
  ])
  let sections = list_sections(bytes)
  assert(Array::length(sections) == 1)
  let (sid, _, sz) = Array::get(sections, 0)
  assert(sid == 1)
  assert(sz == 8)
}

test "list_sections multiple" {
  // Component with core-module (id=1) + alias (id=6)
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    13,
    0,
    1,
    0,
    1,
    8,
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    6,
    2,
    1,
    0
  ])
  let sections = list_sections(bytes)
  assert(Array::length(sections) == 2)
  let (s0, _, _) = Array::get(sections, 0)
  let (s1, _, _) = Array::get(sections, 1)
  assert(s0 == 1)
  assert(s1 == 6)
}

test "extract_core_module" {
  // Core module section containing a minimal WASM module
  let core = make_bytes([0, 97, 115, 109, 1, 0, 0, 0])
  let component = make_bytes([
    0,
    97,
    115,
    109,
    13,
    0,
    1,
    0,
    1,
    8,
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0
  ])
  let sections = list_sections(component)
  let (_, off, sz) = Array::get(sections, 0)
  let extracted = extract_core_module(component, off, sz)
  assert(Bytes::length(extracted) == 8)
  assert(extracted[0] == 0)
  assert(extracted[1] == 97)
  assert(extracted[4] == 1)
}

test "extract_all_core_modules two modules" {
  // Component with two core module sections
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    13,
    0,
    1,
    0,
    1,
    8,
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    1,
    8,
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0
  ])
  let modules = extract_all_core_modules(bytes)
  assert(Array::length(modules) == 2)
  let (idx0, m0) = Array::get(modules, 0)
  let (idx1, m1) = Array::get(modules, 1)
  assert(idx0 == 0)
  assert(idx1 == 1)
  assert(Bytes::length(m0) == 8)
  assert(Bytes::length(m1) == 8)
  assert(m0[4] == 1)
  assert(m1[4] == 1)
}

test "extract_all_core_modules empty" {
  let bytes = make_bytes([0, 97, 115, 109, 13, 0, 1, 0])
  let modules = extract_all_core_modules(bytes)
