test "rs: component imports and exports" {
  let bytes = make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x0D,
    0x00,
    0x01,
    0x00,
    // import section (id=10): 2 imports
    0x0A,
    0x09,
    0x02,
    0x01,
    0x61,
    0x01,
    0x00,
    0x01,
    0x62,
    0x01,
    0x00,
    // export section (id=11): 1 export
    0x0B,
    0x06,
    0x01,
    0x01,
    0x78,
    0x01,
    0x00,
    0x00
  ])
  let sections = list_sections(bytes)
  assert(Array::length(sections) == 2)
  let (s0, off0, sz0) = Array::get(sections, 0)
  let (s1, off1, sz1) = Array::get(sections, 1)
  assert(s0 == 10)
  assert(s1 == 11)
  assert(count_imports(bytes, off0, sz0) == 2)
  assert(count_exports(bytes, off1, sz1) == 1)
}

