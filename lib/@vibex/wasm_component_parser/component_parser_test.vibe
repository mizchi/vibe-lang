test "parse_core_type_section" {
  // Core type section: id=3
  // 1 type: (i32, i32) -> (i32)
  // 0x60 = functype, 2 params [0x7F, 0x7F], 1 result [0x7F]
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    13,
    0,
    1,
    0,
    3,
    7,
    1,
    0x60,
    2,
    0x7F,
    0x7F,
    1,
    0x7F
  ])
  let sections = list_sections(bytes)
  let (sid, off, sz) = Array::get(sections, 0)
  assert(sid == 3)
  let types = parse_core_type_section(bytes, off, sz)
  assert(Array::length(types) == 1)
  let (params, results) = Array::get(types, 0)
  assert(Array::length(params) == 2)
  assert(Array::get(params, 0) == 0x7F)
  assert(Array::get(params, 1) == 0x7F)
  assert(Array::length(results) == 1)
  assert(Array::get(results, 0) == 0x7F)
}

test "parse_core_type_section multiple" {
  // 2 types: () -> () and (i64) -> (i64, i32)
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    13,
    0,
    1,
    0,
    3,
    10,
    2,
    0x60,
    0,
    0,
    0x60,
    1,
    0x7E,
    2,
    0x7E,
    0x7F
  ])
  let sections = list_sections(bytes)
  let (_, off, sz) = Array::get(sections, 0)
  let types = parse_core_type_section(bytes, off, sz)
  assert(Array::length(types) == 2)
  let (p0, r0) = Array::get(types, 0)
  assert(Array::length(p0) == 0)
  assert(Array::length(r0) == 0)
  let (p1, r1) = Array::get(types, 1)
  assert(Array::length(p1) == 1)
  assert(Array::get(p1, 0) == 0x7E)
  assert(Array::length(r1) == 2)
  assert(Array::get(r1, 0) == 0x7E)
  assert(Array::get(r1, 1) == 0x7F)
}

test "parse_canon_options lift with utf8 and memory" {
  // Canon section: id=8
  // 1 entry: lift (0x00), core func 0, 2 options [utf8(0), memory(3) idx 0], type idx 0
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    13,
    0,
    1,
    0,
    8,
    8,
    1,
    0,
    0,
    2,
    0,
    3,
    0,
    0
  ])
  let sections = list_sections(bytes)
  let (sid, off, sz) = Array::get(sections, 0)
  assert(sid == 8)
  let canons = parse_canon_options(bytes, off, sz)
  assert(Array::length(canons) == 1)
  let (op, fidx, opts) = Array::get(canons, 0)
  assert(op == 0)
  assert(fidx == 0)
  assert(Array::length(opts) == 2)
  let (ok0, ov0) = Array::get(opts, 0)
  assert(ok0 == 0)
  assert(ov0 == 0)
  let (ok1, ov1) = Array::get(opts, 1)
  assert(ok1 == 3)
  assert(ov1 == 0)
}

test "comp_section_name" {
  assert(comp_section_name(0) == "custom")
  assert(comp_section_name(1) == "core-module")
  assert(comp_section_name(2) == "core-instance")
  assert(comp_section_name(6) == "alias")
  assert(comp_section_name(7) == "type")
  assert(comp_section_name(8) == "canon")
  assert(comp_section_name(10) == "import")
  assert(comp_section_name(11) == "export")
  assert(comp_section_name(99) == "unknown")
}

test "comp_valtype_name" {
  assert(comp_valtype_name(122) == "s32")
  assert(comp_valtype_name(120) == "s64")
  assert(comp_valtype_name(115) == "string")
  assert(comp_valtype_name(118) == "f32")
  assert(comp_valtype_name(0) == "unknown")
}

test "extern_kind_name" {
  assert(extern_kind_name(0) == "module")
  assert(extern_kind_name(1) == "func")
  assert(extern_kind_name(3) == "type")
  assert(extern_kind_name(5) == "instance")
  assert(extern_kind_name(99) == "unknown")
}

test "rs: single_module nested core" {
  // Component with one core module section (id=1, size=8)
  // The core module is a minimal valid WASM: magic + version
  let bytes = make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x0D,
    0x00,
    0x01,
    0x00,
    0x01,
    0x08,
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00
  ])
  assert(is_component(bytes) == true)
  let sections = list_sections(bytes)
  assert(Array::length(sections) == 1)
  let (sid, off, sz) = Array::get(sections, 0)
  assert(sid == 1)
  assert(sz == 8)
  // Extract and verify the nested core module
  let core = extract_core_module(bytes, off, sz)
  assert(Bytes::length(core) == 8)
  assert(is_core_wasm(core) == true)
  assert(is_component(core) == false)
}

test "rs: single_module core has valid header" {
  let bytes = make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x0D,
    0x00,
    0x01,
    0x00,
    0x01,
    0x08,
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00
  ])
  let modules = extract_all_core_modules(bytes)
  assert(Array::length(modules) == 1)
  let (idx, core) = Array::get(modules, 0)
  assert(idx == 0)
  // Core module version should be 1
  assert(core[4] == 1)
  assert(core[5] == 0)
  assert(core[6] == 0)
  assert(core[7] == 0)
}

test "rs: nested section oversized" {
  // Component claims core module section is 10 bytes, but only 8+3=11 bytes
  // section id=1, size=10, then core module (8 bytes) + custom (3 bytes)
  // The custom section [0, 1, 0] would be within the 10-byte limit
  let bytes = make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x0D,
    0x00,
    0x01,
    0x00,
    0x01,
    0x0B,
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00,
    0x00,
    0x01,
    0x00
  ])
  // list_sections sees section id=1 with size=11
  let sections = list_sections(bytes)
  assert(Array::length(sections) == 1)
  let (sid, _, sz) = Array::get(sections, 0)
  assert(sid == 1)
  assert(sz == 11)
  // Extract: the "core module" is actually 11 bytes (includes the custom section)
  let core = extract_core_module(bytes, 10, sz)
  assert(Bytes::length(core) == 11)
  // First 8 bytes are valid WASM header
  assert(core[0] == 0x00)
  assert(core[1] == 0x61)
  assert(core[4] == 0x01)
}

test "rs: core module with type section inside component" {
  // Component -> core module -> type section () -> ()
  let bytes = make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x0D,
    0x00,
    0x01,
    0x00,
    // core module section: id=1, size=14
    0x01,
    0x0E,
    // embedded core WASM:
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00,
    // type section: 1 func () -> ()
    0x01,
    0x04,
    0x01,
    0x60,
    0x00,
    0x00
  ])
  assert(is_component(bytes) == true)
  let modules = extract_all_core_modules(bytes)
  assert(Array::length(modules) == 1)
  let (_, core) = Array::get(modules, 0)
  assert(Bytes::length(core) == 14)
  assert(is_core_wasm(core) == true)
  // Verify the core module's type section (not using wasmparser import)
  // core bytes[8] = 1 (type section id)
  assert(core[8] == 1)
  // core bytes[9] = 4 (section size)
  assert(core[9] == 4)
}

test "rs: component with 3 core modules" {
  let bytes = make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x0D,
    0x00,
    0x01,
    0x00,
    0x01,
    0x08,
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00,
    0x01,
    0x08,
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00,
    0x01,
    0x08,
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00
  ])
  assert(count_core_modules(bytes) == 3)
  let modules = extract_all_core_modules(bytes)
  assert(Array::length(modules) == 3)
  let (i0, _) = Array::get(modules, 0)
  let (i1, _) = Array::get(modules, 1)
  let (i2, _) = Array::get(modules, 2)
  assert(i0 == 0)
  assert(i1 == 1)
  assert(i2 == 2)
}

test "rs: component with core module and alias" {
  let bytes = make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x0D,
    0x00,
    0x01,
    0x00,
    // core module (id=1)
    0x01,
    0x08,
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00,
    // core instance (id=2): 1 entry, kind=0 (instantiate), module 0, 0 args
    0x02,
    0x04,
    0x01,
    0x00,
    0x00,
    0x00,
    // alias (id=6): 1 entry, sort=0(func), kind=1(core export), instance 0, name "f"
    0x06,
    0x06,
    0x01,
    0x00,
    0x01,
    0x00,
    0x01,
    0x66
  ])
  let sections = list_sections(bytes)
  assert(Array::length(sections) == 3)
  let (s0, _, _) = Array::get(sections, 0)
  let (s1, _, _) = Array::get(sections, 1)
  let (s2, _, _) = Array::get(sections, 2)
  assert(s0 == 1)
  assert(s1 == 2)
  assert(s2 == 6)
  assert(count_core_modules(bytes) == 1)
}

