test "get_custom_section_name" {
  // Custom section: id=0, size=7, name="hello" (len=5, then 'h','e','l','l','o'), data=0x42,0x43
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    13,
    0,
    1,
    0,
    0,
    7,
    5,
    104,
    101,
    108,
    108,
    111,
    42
  ])
  let sections = list_sections(bytes)
  let (sid, off, sz) = Array::get(sections, 0)
  assert(sid == 0)
  let name = get_custom_section_name(bytes, off, sz)
  assert(name == "hello")
