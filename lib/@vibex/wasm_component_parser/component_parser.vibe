//# Values

//# Functions

export fn is_component(bytes: Bytes) -> Bool {
  if Bytes::length(bytes) < 8 {
    false
  }
  else {
    (bytes[0] == 0) &&
    (bytes[1] == 97) &&
    (bytes[2] == 115) &&
    (bytes[3] == 109) &&
    (bytes[4] == 13) &&
    (bytes[5] == 0) &&
    (bytes[6] == 1) &&
    (bytes[7] == 0)
  }
}

export fn is_core_wasm(bytes: Bytes) -> Bool {
  if Bytes::length(bytes) < 8 {
    false
  }
  else {
    (bytes[0] == 0) &&
    (bytes[1] == 97) &&
    (bytes[2] == 115) &&
    (bytes[3] == 109) &&
    (bytes[4] == 1) &&
    (bytes[5] == 0) &&
    (bytes[6] == 0) &&
    (bytes[7] == 0)
  }
}

fn read_uleb128(buf: Bytes, offset: Int) -> (Int, Int) {
  let len = Bytes::length(buf)
  let mut i = offset
  let mut result = 0
  let mut shift = 0
  let mut done = false
  while (i < len) && (done == false) {
    let byte = buf[i]
    result = result|((byte&0x7F)<<shift)
    i = i + 1
    if (byte&0x80) == 0 {
      done = true
    } else {
      shift = shift + 7
    }
  }
  (result, i)
}

fn read_name(bytes: Bytes, offset: Int) -> (String, Int) {
  let (name_len, pos) = read_uleb128(bytes, offset)
  // O(N) build via StringBuilder; per-char String::concat was O(L²) (issue #366).
  let s = StringBuilder::new()
  let mut i = 0
  while i < name_len {
    StringBuilder::push(s, String::from_char_code(bytes[pos + i]))
    i = i + 1
  }
  (StringBuilder::freeze(s), pos + name_len)
}

export fn parse_canon(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Int)] {
  let end_pos = offset + size
  let result = Array::slice([(0, 0, 0)], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let op = bytes[pos]
    pos = pos + 1
    if op == 0 {
      let (func_idx, np) = read_uleb128(bytes, pos)
      pos = np
      let (opt_count, np2) = read_uleb128(bytes, pos)
      pos = np2
      let mut o = 0
      while (o < opt_count) && (pos < end_pos) {
        let opt_kind = bytes[pos]
        pos = pos + 1
        if (opt_kind == 3) || (opt_kind == 4) {
          let (_, np3) = read_uleb128(bytes, pos)
          pos = np3
        }
        o = o + 1
      }
      let (_, np4) = read_uleb128(bytes, pos)
      pos = np4
      Array::push(result, (0, func_idx, opt_count))
    } else {
      if op == 1 {
        let (func_idx, np) = read_uleb128(bytes, pos)
        pos = np
        let (opt_count, np2) = read_uleb128(bytes, pos)
        pos = np2
        let mut o = 0
        while (o < opt_count) && (pos < end_pos) {
          let opt_kind = bytes[pos]
          pos = pos + 1
          if (opt_kind == 3) || (opt_kind == 4) {
            let (_, np3) = read_uleb128(bytes, pos)
            pos = np3
          }
          o = o + 1
        }
        Array::push(result, (1, func_idx, opt_count))
      } else {
        i = cnt
      }
    }
    i = i + 1
  }
  result
}

export fn count_exports(bytes: Bytes, offset: Int, size: Int) -> Int {
  let (cnt, _) = read_uleb128(bytes, offset)
  cnt
}

export fn count_imports(bytes: Bytes, offset: Int, size: Int) -> Int {
  let (cnt, _) = read_uleb128(bytes, offset)
  cnt
}

export fn list_sections(bytes: Bytes) -> Array[(Int, Int, Int)] {
  let len = Bytes::length(bytes)
  let result = Array::slice([(0, 0, 0)], 0, 0)
  if len < 8 {
    result
  }
  else {
    let mut i = 8
    while i < len {
      let sec_id = bytes[i]
      i = i + 1
      let (sec_size, content_start) = read_uleb128(bytes, i)
      let sec_end = content_start + sec_size
      if sec_end > len {
        i = len
      }
      else {
        Array::push(result, (sec_id, content_start, sec_size))
        i = sec_end
      }
    }
    result
  }
}

export fn find_section(bytes: Bytes, target_id: Int) -> (Int, Int, Int) {
  let sections = list_sections(bytes)
  let len = Array::length(sections)
  let mut i = 0
  let mut found = 0
  let mut r_off = 0
  let mut r_sz = 0
  while (i < len) && (found == 0) {
    let (sid, off, sz) = Array::get(sections, i)
    if sid == target_id {
      found = 1
      r_off = off
      r_sz = sz
    }
    i = i + 1
  }
  (found, r_off, r_sz)
}

export fn parse_aliases(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Int, String)] {
  let end_pos = offset + size
  let result = Array::slice([(0, 0, 0, "")], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let sort = bytes[pos]
    pos = pos + 1
    if pos < end_pos {
      let alias_kind = bytes[pos]
      pos = pos + 1
      if alias_kind == 1 {
        let (instance_idx, np) = read_uleb128(bytes, pos)
        pos = np
        let (name, np2) = read_name(bytes, pos)
        pos = np2
        Array::push(result, (sort, 0, instance_idx, name))
      } else {
        if alias_kind == 2 {
          let (outer_count, np) = read_uleb128(bytes, pos)
          pos = np
          let (outer_idx, np2) = read_uleb128(bytes, pos)
          pos = np2
          Array::push(result, (sort, 1, outer_idx, ""))
        } else {
          i = cnt
        }
      }
    }
    i = i + 1
  }
  result
}

export fn extern_kind_name(kind: Int) -> String {
  if kind == 0 {
    "module"
  }
  else if kind == 1 {
    "func"
  }
  else if kind == 2 {
    "value"
  }
  else if kind == 3 {
    "type"
  }
  else if kind == 4 {
    "component"
  }
  else if kind == 5 {
    "instance"
  }
  else {
    "unknown"
  }
}

fn skip_extern_desc(bytes: Bytes, offset: Int, end_pos: Int, kind: Int) -> Int {
  let mut pos = offset
  if kind == 1 {
    let (_, np) = read_uleb128(bytes, pos)
    pos = np
  } else {
    if kind == 3 {
      if pos < end_pos {
        let bounds = bytes[pos]
        pos = pos + 1
        let (_, np) = read_uleb128(bytes, pos)
        pos = np
      }
    } else {
      if kind == 5 {
        let (_, np) = read_uleb128(bytes, pos)
        pos = np
      } else {
        let (_, np) = read_uleb128(bytes, pos)
        pos = np
      }
    }
  }
  if pos > end_pos {
    end_pos
  } else {
    pos
  }
}

export fn parse_exports(bytes: Bytes, offset: Int, size: Int) -> Array[(String, Int, Int)] {
  let end_pos = offset + size
  let result = Array::slice([("", 0, 0)], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (name, np) = read_name(bytes, pos)
    pos = np
    if pos < end_pos {
      let sort = bytes[pos]
      pos = pos + 1
      let (index, np2) = read_uleb128(bytes, pos)
      pos = np2
      if (pos < end_pos) && (bytes[pos] != 0) {
        let kind = bytes[pos]
        pos = pos + 1
        pos = skip_extern_desc(bytes, pos, end_pos, kind)
      } else {
        if pos < end_pos {
          pos = pos + 1
        }
      }
      Array::push(result, (name, sort, index))
    }
    i = i + 1
  }
  result
}

export fn parse_imports(bytes: Bytes, offset: Int, size: Int) -> Array[(String, Int)] {
  let end_pos = offset + size
  let result = Array::slice([("", 0)], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (name, np) = read_name(bytes, pos)
    pos = np
    if pos < end_pos {
      let kind = bytes[pos]
      pos = pos + 1
      pos = skip_extern_desc(bytes, pos, end_pos, kind)
      Array::push(result, (name, kind))
    }
    i = i + 1
  }
  result
}

export fn comp_section_name(id: Int) -> String {
  if id == 0 {
    "custom"
  }
  else if id == 1 {
    "core-module"
  }
  else if id == 2 {
    "core-instance"
  }
  else if id == 3 {
    "core-type"
  }
  else if id == 4 {
    "component"
  }
  else if id == 5 {
    "instance"
  }
  else if id == 6 {
    "alias"
  }
  else if id == 7 {
    "type"
  }
  else if id == 8 {
    "canon"
  }
  else if id == 9 {
    "start"
  }
  else if id == 10 {
    "import"
  }
  else if id == 11 {
    "export"
  }
  else {
    "unknown"
  }
}

export fn comp_valtype_name(vt: Int) -> String {
  if vt == 122 {
    "s32"
  }
  else if vt == 121 {
    "u32"
  }
  else if vt == 120 {
    "s64"
  }
  else if vt == 119 {
    "u64"
  }
  else if vt == 118 {
    "f32"
  }
  else if vt == 117 {
    "f64"
  }
  else if vt == 116 {
    "bool"
  }
  else if vt == 115 {
    "string"
  }
  else if vt == 114 {
    "char"
  }
  else if vt == 113 {
    "list"
  }
  else if vt == 112 {
    "record"
  }
  else if vt == 111 {
    "variant"
  }
  else if vt == 110 {
    "tuple"
  }
  else if vt == 109 {
    "flags"
  }
  else if vt == 108 {
    "enum"
  }
  else if vt == 107 {
    "option"
  }
  else if vt == 106 {
    "result"
  }
  else {
    "unknown"
  }
}

export fn count_core_modules(bytes: Bytes) -> Int {
  let sections = list_sections(bytes)
  let len = Array::length(sections)
  let mut i = 0
  let mut count = 0
  while i < len {
    let (sid, _, _) = Array::get(sections, i)
    if sid == 1 {
      count = count + 1
    }
    i = i + 1
  }
  count
}

export fn extract_core_module(bytes: Bytes, offset: Int, size: Int) -> Bytes {
  let result = Bytes::new()
  let mut i = 0
  while i < size {
    Bytes::push(result, bytes[offset + i])
    i = i + 1
  }
  result
}

export fn parse_canon_options(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Array[(Int, Int)])] {
  let end_pos = offset + size
  let empty_opts = Array::slice([(0, 0)], 0, 0)
  let result = Array::slice([(0, 0, empty_opts)], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let op = bytes[pos]
    pos = pos + 1
    if op == 0 {
      let (func_idx, np) = read_uleb128(bytes, pos)
      pos = np
      let (opt_count, np2) = read_uleb128(bytes, pos)
      pos = np2
      let opts = Array::slice([(0, 0)], 0, 0)
      let mut o = 0
      while (o < opt_count) && (pos < end_pos) {
        let opt_kind = bytes[pos]
        pos = pos + 1
        if (opt_kind == 3) || (opt_kind == 4) || (opt_kind == 5) {
          let (opt_val, np3) = read_uleb128(bytes, pos)
          pos = np3
          Array::push(opts, (opt_kind, opt_val))
        } else {
          Array::push(opts, (opt_kind, 0))
        }
        o = o + 1
      }
      let (_, np4) = read_uleb128(bytes, pos)
      pos = np4
      Array::push(result, (0, func_idx, opts))
    } else {
      if op == 1 {
        let (func_idx, np) = read_uleb128(bytes, pos)
        pos = np
        let (opt_count, np2) = read_uleb128(bytes, pos)
        pos = np2
        let opts = Array::slice([(0, 0)], 0, 0)
        let mut o = 0
        while (o < opt_count) && (pos < end_pos) {
          let opt_kind = bytes[pos]
          pos = pos + 1
          if (opt_kind == 3) || (opt_kind == 4) || (opt_kind == 5) {
            let (opt_val, np3) = read_uleb128(bytes, pos)
            pos = np3
            Array::push(opts, (opt_kind, opt_val))
          } else {
            Array::push(opts, (opt_kind, 0))
          }
          o = o + 1
        }
        Array::push(result, (1, func_idx, opts))
      } else {
        i = cnt
      }
    }
    i = i + 1
  }
  result
}

export fn parse_core_instances(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Int)] {
  let end_pos = offset + size
  let result = Array::slice([(0, 0, 0)], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let kind = bytes[pos]
    pos = pos + 1
    if kind == 0 {
      let (module_idx, np) = read_uleb128(bytes, pos)
      pos = np
      let (arg_count, np2) = read_uleb128(bytes, pos)
      pos = np2
      let mut a = 0
      while (a < arg_count) && (pos < end_pos) {
        let (_, np3) = read_name(bytes, pos)
        pos = np3
        if pos < end_pos {
          let _ = bytes[pos]
          pos = pos + 1
          let (_, np4) = read_uleb128(bytes, pos)
          pos = np4
        }
        a = a + 1
      }
      Array::push(result, (0, module_idx, arg_count))
    } else {
      if kind == 1 {
        let (export_count, np) = read_uleb128(bytes, pos)
        pos = np
        let mut e = 0
        while (e < export_count) && (pos < end_pos) {
          let (_, np2) = read_name(bytes, pos)
          pos = np2
          if pos < end_pos {
            let _ = bytes[pos]
            pos = pos + 1
            let (_, np3) = read_uleb128(bytes, pos)
            pos = np3
          }
          e = e + 1
        }
        Array::push(result, (1, 0, export_count))
      } else {
        i = cnt
      }
    }
    i = i + 1
  }
  result
}

export fn get_custom_section_name(bytes: Bytes, offset: Int, size: Int) -> String {
  let end_pos = offset + size
  if offset >= end_pos {
    ""
  }
  else {
    let (name, _) = read_name(bytes, offset)
    name
  }
}

export fn parse_core_type_section(bytes: Bytes, offset: Int, size: Int) -> Array[(Array[Int], Array[Int])] {
  let end_pos = offset + size
  let empty_ints = Array::slice([0], 0, 0)
  let result = Array::slice([(empty_ints, empty_ints)], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let tag = bytes[pos]
    pos = pos + 1
    if tag == 0x60 {
      let (param_count, np) = read_uleb128(bytes, pos)
      pos = np
      let params = Array::slice([0], 0, 0)
      let mut p = 0
      while (p < param_count) && (pos < end_pos) {
        Array::push(params, bytes[pos])
        pos = pos + 1
        p = p + 1
      }
      let (result_count, np2) = read_uleb128(bytes, pos)
      pos = np2
      let results = Array::slice([0], 0, 0)
      let mut r = 0
      while (r < result_count) && (pos < end_pos) {
        Array::push(results, bytes[pos])
        pos = pos + 1
        r = r + 1
      }
      Array::push(result, (params, results))
    } else {
      i = cnt
    }
    i = i + 1
  }
  result
}

export fn extract_all_core_modules(bytes: Bytes) -> Array[(Int, Bytes)] {
  let sections = list_sections(bytes)
  let len = Array::length(sections)
  let empty_bytes = Bytes::new()
  let result = Array::slice([(0, empty_bytes)], 0, 0)
  let mut i = 0
  let mut mod_idx = 0
  while i < len {
    let (sid, off, sz) = Array::get(sections, i)
    if sid == 1 {
      let mod_bytes = extract_core_module(bytes, off, sz)
      Array::push(result, (mod_idx, mod_bytes))
      mod_idx = mod_idx + 1
    }
    i = i + 1
  }
  result
}

export fn parse_component_type_section(bytes: Bytes, offset: Int, size: Int) -> Array[(Array[String], Array[Int], Array[Int])] {
  let end_pos = offset + size
  let empty_strs = Array::slice([""], 0, 0)
  let empty_ints = Array::slice([0], 0, 0)
  let result = Array::slice([(empty_strs, empty_ints, empty_ints)], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let def_kind = bytes[pos]
    pos = pos + 1
    if def_kind == 0x40 {
      let params_tag = bytes[pos]
      pos = pos + 1
      let param_names = Array::slice([""], 0, 0)
      let param_types = Array::slice([0], 0, 0)
      if params_tag == 1 {
        let (param_count, np) = read_uleb128(bytes, pos)
        pos = np
        let mut p = 0
        while (p < param_count) && (pos < end_pos) {
          let (pname, np2) = read_name(bytes, pos)
          pos = np2
          let (vt, np3) = read_uleb128(bytes, pos)
          pos = np3
          Array::push(param_names, pname)
          Array::push(param_types, vt)
          p = p + 1
        }
      } else {
        let (_, np) = read_uleb128(bytes, pos)
        pos = np
      }
      let result_tag = bytes[pos]
      pos = pos + 1
      let result_types = Array::slice([0], 0, 0)
      if result_tag == 0 {
        let (res_count, np) = read_uleb128(bytes, pos)
        pos = np
        let mut r = 0
        while (r < res_count) && (pos < end_pos) {
          let (_, np2) = read_name(bytes, pos)
          pos = np2
          let (vt, np3) = read_uleb128(bytes, pos)
          pos = np3
          Array::push(result_types, vt)
          r = r + 1
        }
      } else {
        let (vt, np) = read_uleb128(bytes, pos)
        pos = np
        Array::push(result_types, vt)
      }
      Array::push(result, (param_names, param_types, result_types))
    } else {
      if def_kind == 0x41 {
        let (inner_cnt, np) = read_uleb128(bytes, pos)
        pos = np
        let mut j = 0
        while (j < inner_cnt) && (pos < end_pos) {
          let inner_kind = bytes[pos]
          pos = pos + 1
          if inner_kind == 0x01 {
            let inner_tag = bytes[pos]
            pos = pos + 1
            if inner_tag == 0x40 {
              let pt = bytes[pos]
              pos = pos + 1
              if pt == 1 {
                let (pc, np2) = read_uleb128(bytes, pos)
                pos = np2
                let mut k = 0
                while (k < pc) && (pos < end_pos) {
                  let (_, np3) = read_name(bytes, pos)
                  pos = np3
                  let (_, np4) = read_uleb128(bytes, pos)
                  pos = np4
                  k = k + 1
                }
              } else {
                let (_, np2) = read_uleb128(bytes, pos)
                pos = np2
              }
              let rt = bytes[pos]
              pos = pos + 1
              if rt == 0 {
                let (rc, np2) = read_uleb128(bytes, pos)
                pos = np2
                let mut k = 0
                while (k < rc) && (pos < end_pos) {
                  let (_, np3) = read_name(bytes, pos)
                  pos = np3
                  let (_, np4) = read_uleb128(bytes, pos)
                  pos = np4
                  k = k + 1
                }
              } else {
                let (_, np2) = read_uleb128(bytes, pos)
                pos = np2
              }
            } else {
              let (_, np2) = read_uleb128(bytes, pos)
              pos = np2
            }
          } else {
            if inner_kind == 0x04 {
              let (_, np2) = read_name(bytes, pos)
              pos = np2
              let ek = bytes[pos]
              pos = pos + 1
              pos = skip_extern_desc(bytes, pos, end_pos, ek)
            } else {
              j = inner_cnt
            }
          }
          j = j + 1
        }
        let e_s = Array::slice([""], 0, 0)
        let e_i = Array::slice([0], 0, 0)
        let e_r = Array::slice([0], 0, 0)
        Array::push(result, (e_s, e_i, e_r))
      } else {
        let (_, np) = read_uleb128(bytes, pos)
        pos = np
        let e_s = Array::slice([""], 0, 0)
        let e_i = Array::slice([0], 0, 0)
        let e_r = Array::slice([0], 0, 0)
        Array::push(result, (e_s, e_i, e_r))
      }
    }
    i = i + 1
  }
  result
}
