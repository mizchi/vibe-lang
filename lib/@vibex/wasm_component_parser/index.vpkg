version 0.0.1

// @vibex/wasm_component_parser — component-model binary introspection:
// section listing, core-module extraction, import/export/canon/alias/
// instance/type-section parsers, and name helpers (ADR-0070 Phase 3, #897).
// Every declared name is a pure fn over `Bytes` + primitives/tuples/arrays
// of primitives; no opaque/transparent type surface of its own (same shape
// as @vibe/optimizer, PR #918).
//
// `version` was `export let version = "0.0.1"` directly in the old
// index.vibe facade — a real importable binding, not just contract
// metadata — preserved as an implementation-file value
// (component_parser.vibe) with a matching bodyless declaration here (Codex
// review precedent, PR #914). No other value aliases existed in the old
// facade.
//
// component_parser_test.vibe and the bench file used to pull names in via
// a literal-filename `import ./index.vibe {...}` of this package's own
// facade; both were retargeted to `import ./component_parser.vibe {...}`
// (the impl file that defines every imported name) once this contract
// replaced index.vibe. bench.vibe was ALSO renamed to
// component_parser_bench.vibe (Codex review precedent, #912/PR #913): a
// bare `bench.vibe` isn't excluded by implicit membership's
// `_bench.vibe`-suffix rule, so it would otherwise ride along as a real
// package member on every import of this package.

fn is_component(bytes: Bytes) -> Bool
fn is_core_wasm(bytes: Bytes) -> Bool
fn comp_section_name(id: Int) -> String
fn list_sections(bytes: Bytes) -> Array[(Int, Int, Int)]
fn extract_core_module(bytes: Bytes, offset: Int, size: Int) -> Bytes
fn extract_all_core_modules(bytes: Bytes) -> Array[(Int, Bytes)]
fn count_core_modules(bytes: Bytes) -> Int
fn find_section(bytes: Bytes, target_id: Int) -> (Int, Int, Int)
fn get_custom_section_name(bytes: Bytes, offset: Int, size: Int) -> String
fn parse_imports(bytes: Bytes, offset: Int, size: Int) -> Array[(String, Int)]
fn parse_exports(bytes: Bytes, offset: Int, size: Int) -> Array[(String, Int, Int)]
fn count_imports(bytes: Bytes, offset: Int, size: Int) -> Int
fn count_exports(bytes: Bytes, offset: Int, size: Int) -> Int
fn parse_canon(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Int)]
fn parse_canon_options(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Array[(Int, Int)])]
fn parse_aliases(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Int, String)]
fn parse_core_instances(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Int)]
fn parse_core_type_section(bytes: Bytes, offset: Int, size: Int) -> Array[(Array[Int], Array[Int])]
fn parse_component_type_section(bytes: Bytes, offset: Int, size: Int) -> Array[(Array[String], Array[Int], Array[Int])]
fn comp_valtype_name(vt: Int) -> String
fn extern_kind_name(kind: Int) -> String
