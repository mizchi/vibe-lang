//# Functions

// NOTE (#776): `Llm::complete` / `Rlm::run` / `Rlm::finalize` are typed by the
// checker (lib/@vibe/compiler/checker/builtins_system.vibe::lookup_io_c) for
// effect-tracking/parity purposes, but the selfhost codegen never gained a
// lowering for them (no host `Llm` import exists anywhere — see
// scripts/wasm_vibe_host_runner.js). Calling them traps codegen with
// "undefined variable (local): <name> @call" the moment this module is
// compiled (`no-dce` mode compiles every export, called or not). Until the
// `Llm` effect gets a real host backend, these stay stub passthroughs so the
// module — and its exported shape (ADR-0065) — stays compilable.

// run: (String, String) -> String with {Llm}
export let run = (task: String, prompt: String) -> String with { Llm } {
  let _ = task
  prompt
}

// complete: (String, String) -> String with {Llm}
export let complete = (system: String, user: String) -> String with { Llm } {
  let _ = system
  user
}

export let finalize = (result: String) -> String {
  result
}

export let version: String = "0.0.1"
