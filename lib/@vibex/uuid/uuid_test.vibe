//# Imports

import . {
  is_valid_v4, v4
}

//# Misc

test "v4 generates valid uuid" {
  let (uuid, _) = v4(12345)
  assert(is_valid_v4(uuid))
  assert(String::length(uuid) == 36)
}

test "v4 different seeds produce different uuids" {
  let (u1, _) = v4(1)
  let (u2, _) = v4(2)
  assert(not(u1 == u2))
}

test "v4 chaining produces unique uuids" {
  let (u1, s1) = v4(42)
  let (u2, s2) = v4(s1)
  let (u3, _) = v4(s2)
  assert(not(u1 == u2))
  assert(not(u2 == u3))
  assert(not(u1 == u3))
  assert(is_valid_v4(u1))
  assert(is_valid_v4(u2))
  assert(is_valid_v4(u3))
}

test "v4 version nibble is 4" {
  let (uuid, _) = v4(9999)
  assert(uuid[14: 15] == "4")
}

test "v4 deterministic with same seed" {
  let (u1, _) = v4(42)
  let (u2, _) = v4(42)
  assert(u1 == u2)
}

test "v4 dash positions" {
  let (uuid, _) = v4(777)
  assert(uuid[8: 9] == "-")
  assert(uuid[13: 14] == "-")
  assert(uuid[18: 19] == "-")
  assert(uuid[23: 24] == "-")
}

test "v4 variant nibble is 8-b" {
  let (uuid, _) = v4(12345)
  let variant = uuid[19: 20]
  let is_valid_variant = variant == "8" ||
  variant == "9" ||
  variant == "a" ||
  variant == "b"
  assert(is_valid_variant)
}

test "v4 many seeds all valid" {
  let mut state = 1
  let mut idx = 0
  while idx < 20 {
    let (uuid, next) = v4(state)
    assert(is_valid_v4(uuid))
    state = next
    idx = idx + 1
  }
}

test "is_valid_v4 rejects bad format" {
  assert(not(is_valid_v4("not-a-uuid")))
  assert(not(is_valid_v4("")))
}

test "is_valid_v4 rejects wrong version" {
  assert(not(is_valid_v4("00000000-0000-0000-0000-000000000000")))
  assert(not(is_valid_v4("00000000-0000-3000-0000-000000000000")))
}

test "is_valid_v4 rejects wrong length" {
  assert(not(is_valid_v4("12345678-1234-4123-8123-12345678901")))
  assert(not(is_valid_v4("12345678-1234-4123-8123-1234567890123")))
}
