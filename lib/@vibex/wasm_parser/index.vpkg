name = @vibex/wasm_parser
version = 0.0.1
description =
  #|@vibex/wasm_parser — core-wasm binary introspection: magic/version
deps = {}

generated_hash =

// @vibex/wasm_parser — core-wasm binary introspection: magic/version
// validation, section listing, per-section `parse_*` primitives, and the
// whole-module `module_*` conveniences (ADR-0070 Phase 3, #897). Every
// declared name is a pure fn over `Bytes` + primitives/tuples/arrays of
// primitives; no opaque/transparent type surface of its own (same shape as
// @vibe/optimizer, PR #918).
//
// `version` was `export let version = "0.0.1"` directly in the old
// index.vibe facade — a real importable binding, not just contract
// metadata — preserved as an implementation-file value (wasm_parser.vibe)
// with a matching bodyless declaration here (Codex review precedent, PR
// #914). No other value aliases existed in the old facade.
//
// wasm_parser_test.vibe and the bench file used to pull names in via a
// literal-filename `import ./index.vibe {...}` of this package's own
// facade; both were retargeted to `import ./wasm_parser.vibe {...}` (the
// impl file that defines every imported name) once this contract replaced
// index.vibe. bench.vibe was ALSO renamed to wasm_parser_bench.vibe (Codex
// review precedent, #912/PR #913): a bare `bench.vibe` isn't excluded by
// implicit membership's `_bench.vibe`-suffix rule. The parent-dir
// lib/@vibex/wasm/coverage_test.vibe already imports this package in
// directory form (`import ./wasm_parser {...}`), which resolves to this
// contract unchanged.

fn validate_magic(bytes: Bytes) -> Bool
fn read_version(bytes: Bytes) -> Int
fn read_name(bytes: Bytes, offset: Int) -> (String, Int)
fn list_sections(bytes: Bytes) -> Array[(Int, Int, Int)]
fn find_section(bytes: Bytes, section_id: Int) -> (Int, Int)
fn read_init_expr(bytes: Bytes, offset: Int, end_pos: Int) -> (Int, Int, Int)
fn parse_types(bytes: Bytes, offset: Int, size: Int) -> Array[(Array[Int], Array[Int])]
fn parse_type_forms(bytes: Bytes, offset: Int, size: Int) -> Array[Int]
fn scan_features(wasm_bytes: Bytes) -> Array[String]
fn parse_imports(bytes: Bytes, offset: Int, size: Int) -> Array[(String, String, Int, Int)]
fn parse_imports_full(bytes: Bytes, offset: Int, size: Int) -> Array[(String, String, Int, Int, Int, Int)]
fn parse_functions(bytes: Bytes, offset: Int, size: Int) -> Array[Int]
fn parse_memories(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int)]
fn parse_tables(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Int)]
fn parse_globals(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Int, Int)]
fn parse_exports(bytes: Bytes, offset: Int, size: Int) -> Array[(String, Int, Int)]
fn parse_start(bytes: Bytes, offset: Int, size: Int) -> Int
fn parse_elements(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Int, Array[Int])]
fn parse_code_entries(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Array[(Int, Int)])]
fn get_code_body_range(bytes: Bytes, body_offset: Int, body_size: Int) -> (Int, Int)
fn extract_code_body(bytes: Bytes, body_offset: Int, body_size: Int) -> Bytes
fn parse_data_segments(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Int, Int, Int, Int)]
fn extract_data_bytes(bytes: Bytes, data_offset: Int, data_size: Int) -> Bytes
fn parse_custom_section(bytes: Bytes, offset: Int, size: Int) -> (String, Int, Int)
fn section_name(id: Int) -> String
fn valtype_name(vt: Int) -> String
fn count_locals(local_decls: Array[(Int, Int)]) -> Int
fn module_types(bytes: Bytes) -> Array[(Array[Int], Array[Int])]
fn module_imports(bytes: Bytes) -> Array[(String, String, Int, Int)]
fn module_imports_full(bytes: Bytes) -> Array[(String, String, Int, Int, Int, Int)]
fn module_functions(bytes: Bytes) -> Array[Int]
fn module_tables(bytes: Bytes) -> Array[(Int, Int, Int)]
fn module_memories(bytes: Bytes) -> Array[(Int, Int)]
fn module_globals(bytes: Bytes) -> Array[(Int, Int, Int, Int)]
fn module_exports(bytes: Bytes) -> Array[(String, Int, Int)]
fn module_start(bytes: Bytes) -> Int
fn module_elements(bytes: Bytes) -> Array[(Int, Int, Int, Array[Int])]
fn module_code(bytes: Bytes) -> Array[(Int, Int, Array[(Int, Int)])]
fn module_data(bytes: Bytes) -> Array[(Int, Int, Int, Int, Int, Int)]
fn module_custom_sections(bytes: Bytes) -> Array[(String, Int, Int)]
fn module_summary(bytes: Bytes) -> String
