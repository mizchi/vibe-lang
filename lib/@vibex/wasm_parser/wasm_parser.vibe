//# Values

//# Functions

export fn count_locals(local_decls: Array[(Int, Int)]) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(local_decls) {
    let (c, _) = Array::get(local_decls, i)
    total = total + c
    i = i + 1
  }
  total
}

fn read_sleb128(buf: Bytes, offset: Int) -> (Int, Int) {
  let len = Bytes::length(buf)
  let mut i = offset
  let mut result = 0
  let mut shift = 0
  let mut done = false
  while (i < len) && (done == false) {
    let byte = buf[i]
    result = result|((byte&0x7F)<<shift)
    shift = shift + 7
    i = i + 1
    if (byte&0x80) == 0 {
      if (byte&0x40) > 0 {
        result = result|((-1)<<shift)
      }
      done = true
    }
  }
  (result, i)
}

fn read_uleb128(buf: Bytes, offset: Int) -> (Int, Int) {
  let len = Bytes::length(buf)
  let mut i = offset
  let mut result = 0
  let mut shift = 0
  let mut done = false
  while (i < len) && (done == false) {
    let byte = buf[i]
    result = result|((byte&0x7F)<<shift)
    i = i + 1
    if (byte&0x80) == 0 {
      done = true
    }
    else {
      shift = shift + 7
    }
  }
  (result, i)
}

export fn read_name(bytes: Bytes, offset: Int) -> (String, Int) {
  let (name_len, pos) = read_uleb128(bytes, offset)
  // O(N) build via StringBuilder; per-char String::concat was O(L²) (issue #366).
  let s = StringBuilder::new()
  let mut i = 0
  while i < name_len {
    StringBuilder::push(s, String::from_char_code(bytes[pos + i]))
    i = i + 1
  }
  (StringBuilder::freeze(s), pos + name_len)
}

export fn parse_start(bytes: Bytes, offset: Int, size: Int) -> Int {
  if size == 0 {
    -1
  }
  else {
    let (func_idx, _) = read_uleb128(bytes, offset); func_idx
  }
}

/// Read one valtype and return it with the position AFTER it.
///
/// Most valtypes are a single byte, but a typed reference is not: `0x63`
/// (ref null ht) and `0x64` (ref ht) are followed by a heap type, which for a
/// concrete type is a signed LEB index. Advancing one byte past those leaves
/// the index in the stream, where it is read as the next valtype -- and from
/// there the whole section is off by however many bytes the indices took.
///
/// The struct and array branches below already did this; the function-type
/// branch and the local declarations did not, which is why a module whose
/// SIGNATURES carry typed references desynchronized. vibe's own gc backend
/// emits exactly that shape (#1541 / #1722 give private callees typed
/// parameters and results, and reserve a `(func (result (ref null $t)))` for
/// blocktypes), so the misparse is reachable from the compiler's own output.
fn read_valtype(bytes: Bytes, pos: Int) -> (Int, Int) {
  let vt = bytes[pos]
  if (vt == 0x63) || (vt == 0x64) {
    let (_, np) = read_sleb128(bytes, pos + 1)
    (vt, np)
  } else {
    (vt, pos + 1)
  }
}

export fn parse_types(bytes: Bytes, offset: Int, size: Int) -> Array[(Array[Int], Array[Int])] {
  let end_pos = offset + size
  let result = Array::slice([
    ([
      0
    ], [
      0
    ])
  ], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut t = 0
  while (t < cnt) && (pos < end_pos) {
    let form = bytes[pos]
    pos = pos + 1
    if form == 96 {
      let (param_count, pp) = read_uleb128(bytes, pos)
      pos = pp
      let params = Array::slice([
        0
      ], 0, 0)
      let mut p = 0
      while (p < param_count) && (pos < end_pos) {
        let (vt, np) = read_valtype(bytes, pos)
        Array::push(params, vt)
        pos = np
        p = p + 1
      }
      let (result_count, rp) = read_uleb128(bytes, pos)
      pos = rp
      let results = Array::slice([
        0
      ], 0, 0)
      let mut r = 0
      while (r < result_count) && (pos < end_pos) {
        let (vt, np) = read_valtype(bytes, pos)
        Array::push(results, vt)
        pos = np
        r = r + 1
      }
      Array::push(result, (params, results))
    }
    else if form == 0x5F {
      let (field_count, fp) = read_uleb128(bytes, pos)
      pos = fp
      let mut f = 0
      while (f < field_count) && (pos < end_pos) {
        let ft = bytes[pos]
        pos = pos + 1
        if (ft == 0x63) || (ft == 0x64) {
          let (_, np) = read_sleb128(bytes, pos)
          pos = np
        } else {
          ()
        }
        if pos < end_pos {
          pos = pos + 1
        } else {
          ()
        }
        f = f + 1
      }
      Array::push(result, (Array::slice([
        0
      ], 0, 0), Array::slice([
        0
      ], 0, 0)))
    }
    else if form == 0x5E {
      let et = bytes[pos]
      pos = pos + 1
      if (et == 0x63) || (et == 0x64) {
        let (_, np) = read_sleb128(bytes, pos)
        pos = np
      } else {
        ()
      }
      if pos < end_pos {
        pos = pos + 1
      } else {
        ()
      }
      Array::push(result, (Array::slice([
        0
      ], 0, 0), Array::slice([
        0
      ], 0, 0)))
    }
    else if form == 0x50 {
      let (super_count, sp) = read_uleb128(bytes, pos)
      pos = sp
      let mut si = 0
      while (si < super_count) && (pos < end_pos) {
        let (_, np) = read_uleb128(bytes, pos)
        pos = np
        si = si + 1
      }
      if pos < end_pos {
        let inner_form = bytes[pos]
        pos = pos + 1
        if inner_form == 0x60 {
          let (pc2, pp2) = read_uleb128(bytes, pos)
          pos = pp2 + pc2
          let (rc2, rp2) = read_uleb128(bytes, pos)
          pos = rp2 + rc2
        }
        else if inner_form == 0x5F {
          let (fc2, fp2) = read_uleb128(bytes, pos)
          pos = fp2
          let mut f2 = 0
          while (f2 < fc2) && (pos < end_pos) {
            let ft2 = bytes[pos]
            pos = pos + 1
            if (ft2 == 0x63) || (ft2 == 0x64) {
              let (_, np2) = read_sleb128(bytes, pos)
              pos = np2
            } else {
              ()
            }
            if pos < end_pos {
              pos = pos + 1
            } else {
              ()
            }
            f2 = f2 + 1
          }
        }
        else if inner_form == 0x5E {
          let et2 = bytes[pos]
          pos = pos + 1
          if (et2 == 0x63) || (et2 == 0x64) {
            let (_, np2) = read_sleb128(bytes, pos)
            pos = np2
          } else {
            ()
          }
          if pos < end_pos {
            pos = pos + 1
          } else {
            ()
          }
        }
        else {
          ()
        }
      } else {
        ()
      }
      Array::push(result, (Array::slice([
        0
      ], 0, 0), Array::slice([
        0
      ], 0, 0)))
    }
    else {
      ()
    }
    t = t + 1
  }
  result
}

fn parse_limits(bytes: Bytes, offset: Int, end_pos: Int) -> (Int, Int, Int, Int) {
  let mut pos = offset
  if pos >= end_pos {
    (0, 0, -1, pos)
  }
  else {
    let flags = bytes[pos]
    pos = pos + 1
    let (min_val, p1) = read_uleb128(bytes, pos)
    pos = p1
    if (flags&1) != 0 {
      let (max_val, p2) = read_uleb128(bytes, pos)
      (flags, min_val, max_val, p2)
    } else {
      (flags, min_val, -1, pos)
    }
  }
}

fn skip_limits(bytes: Bytes, offset: Int, end_pos: Int) -> Int {
  let (_, _, _, np) = parse_limits(bytes, offset, end_pos)
  if np > end_pos {
    end_pos
  } else {
    np
  }
}

export fn parse_tables(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Int)] {
  let end_pos = offset + size
  let result = Array::slice([
    (0, 0, 0)
  ], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let reftype = bytes[pos]
    pos = pos + 1
    let (_, min_val, max_val, np) = parse_limits(bytes, pos, end_pos)
    pos = np
    Array::push(result, (reftype, min_val, max_val))
    i = i + 1
  }
  result
}

export fn read_version(bytes: Bytes) -> Int {
  if Bytes::length(bytes) < 8 {
    -1
  }
  else {
    bytes[4]|(bytes[5]<<8)|(bytes[6]<<16)|(bytes[7]<<24)
  }
}

export fn section_name(id: Int) -> String {
  if id == 0 {
    "custom"
  }
  else if id == 1 {
    "type"
  }
  else if id == 2 {
    "import"
  }
  else if id == 3 {
    "function"
  }
  else if id == 4 {
    "table"
  }
  else if id == 5 {
    "memory"
  }
  else if id == 6 {
    "global"
  }
  else if id == 7 {
    "export"
  }
  else if id == 8 {
    "start"
  }
  else if id == 9 {
    "element"
  }
  else if id == 10 {
    "code"
  }
  else if id == 11 {
    "data"
  }
  else if id == 12 {
    "datacount"
  }
  else {
    "unknown"
  }
}

export fn valtype_name(vt: Int) -> String {
  if vt == 127 {
    "i32"
  }
  else if vt == 126 {
    "i64"
  }
  else if vt == 125 {
    "f32"
  }
  else if vt == 124 {
    "f64"
  }
  else if vt == 123 {
    "v128"
  }
  else if vt == 112 {
    "funcref"
  }
  else if vt == 111 {
    "externref"
  }
  else if vt == 110 {
    "ref_null_func"
  }
  else if vt == 109 {
    "ref_null_extern"
  }
  else if vt == 99 {
    "ref"
  }
  else if vt == 100 {
    "ref_null"
  }
  else {
    "unknown"
  }
}

fn valtypes_str(types: Array[Int]) -> String {
  let s = StringBuilder::new()
  let mut i = 0
  while i < Array::length(types) {
    if i > 0 {
      StringBuilder::push(s, " ")
    } else {
      ()
    }
    StringBuilder::push(s, valtype_name(Array::get(types, i)))
    i = i + 1
  }
  StringBuilder::freeze(s)
}

fn int_to_string(n: Int) -> String {
  if n == 0 {
    "0"
  }
  else {
    let mut val = if n < 0 {
      0 - n
    } else {
      n
    }
    let mut s = ""
    while val > 0 {
      let digit = val - ((val / 10) * 10)
      s = String::concat(String::from_char_code(48 + digit), s)
      val = val / 10
    }
    if n < 0 {
      String::concat("-", s)
    } else {
      s
    }
  }
}

export fn list_sections(bytes: Bytes) -> Array[(Int, Int, Int)] {
  let len = Bytes::length(bytes)
  let result = Array::slice([
    (0, 0, 0)
  ], 0, 0)
  if len < 8 {
    result
  }
  else {
    let mut i = 8
    while i < len {
      let sec_id = bytes[i]
      i = i + 1
      let (sec_size, content_start) = read_uleb128(bytes, i)
      let sec_end = content_start + sec_size
      if sec_end > len {
        i = len
      }
      else {
        Array::push(result, (sec_id, content_start, sec_size))
        i = sec_end
      }
    }
    result
  }
}

export fn find_section(bytes: Bytes, section_id: Int) -> (Int, Int) {
  let sections = list_sections(bytes)
  let mut idx = 0
  let cnt = Array::length(sections)
  let mut found_offset = -1
  let mut found_size = 0
  while idx < cnt {
    let (sid, off, sz) = Array::get(sections, idx)
    if sid == section_id {
      found_offset = off
      found_size = sz
      idx = cnt
    } else {
      idx = idx + 1
    }
  }
  (found_offset, found_size)
}

fn find_sec(bytes: Bytes, target_id: Int) -> (Int, Int) {
  let (off, sz) = find_section(bytes, target_id)
  if off < 0 {
    (0, 0)
  } else {
    (off, sz)
  }
}

export fn module_start(bytes: Bytes) -> Int {
  let (off, sz) = find_sec(bytes, 8)
  if sz == 0 {
    -1
  }
  else {
    parse_start(bytes, off, sz)
  }
}

export fn module_types(bytes: Bytes) -> Array[(Array[Int], Array[Int])] {
  let (off, sz) = find_sec(bytes, 1)
  if sz == 0 {
    Array::slice([
      ([
        0
      ], [
        0
      ])
    ], 0, 0)
  }
  else {
    parse_types(bytes, off, sz)
  }
}

export fn module_tables(bytes: Bytes) -> Array[(Int, Int, Int)] {
  let (off, sz) = find_sec(bytes, 4)
  if sz == 0 {
    Array::slice([
      (0, 0, 0)
    ], 0, 0)
  }
  else {
    parse_tables(bytes, off, sz)
  }
}

export fn parse_exports(bytes: Bytes, offset: Int, size: Int) -> Array[(String, Int, Int)] {
  let end_pos = offset + size
  let result = Array::slice([
    ("", 0, 0)
  ], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (name, np) = read_name(bytes, pos)
    pos = np
    if pos < end_pos {
      let kind = bytes[pos]
      pos = pos + 1
      let (index, np2) = read_uleb128(bytes, pos)
      pos = np2
      Array::push(result, (name, kind, index))
    } else {
      ()
    }
    i = i + 1
  }
  result
}

export fn parse_imports(bytes: Bytes, offset: Int, size: Int) -> Array[(String, String, Int, Int)] {
  let end_pos = offset + size
  let result = Array::slice([
    ("", "", 0, 0)
  ], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (mod_name, p1) = read_name(bytes, pos)
    let (field_name, p2) = read_name(bytes, p1)
    pos = p2
    if pos < end_pos {
      let kind = bytes[pos]
      pos = pos + 1
      if kind == 0 {
        let (type_idx, np) = read_uleb128(bytes, pos)
        pos = np
        Array::push(result, (mod_name, field_name, 0, type_idx))
      } else {
        if kind == 1 {
          if pos < end_pos {
            pos = pos + 1
          } else {
            ()
          }
          pos = skip_limits(bytes, pos, end_pos)
          Array::push(result, (mod_name, field_name, 1, 0))
        } else {
          if kind == 2 {
            pos = skip_limits(bytes, pos, end_pos)
            Array::push(result, (mod_name, field_name, 2, 0))
          } else {
            if kind == 3 {
              if (pos + 2) <= end_pos {
                pos = pos + 2
              } else {
                ()
              }
              Array::push(result, (mod_name, field_name, 3, 0))
            } else {
              Array::push(result, (mod_name, field_name, kind, 0))
              i = cnt
            }
          }
        }
      }
    } else {
      ()
    }
    i = i + 1
  }
  result
}

export fn module_exports(bytes: Bytes) -> Array[(String, Int, Int)] {
  let (off, sz) = find_sec(bytes, 7)
  if sz == 0 {
    Array::slice([
      ("", 0, 0)
    ], 0, 0)
  }
  else {
    parse_exports(bytes, off, sz)
  }
}

export fn module_imports(bytes: Bytes) -> Array[(String, String, Int, Int)] {
  let (off, sz) = find_sec(bytes, 2)
  if sz == 0 {
    Array::slice([
      ("", "", 0, 0)
    ], 0, 0)
  }
  else {
    parse_imports(bytes, off, sz)
  }
}

export fn parse_memories(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int)] {
  let end_pos = offset + size
  let result = Array::slice([
    (0, 0)
  ], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (_, min_val, max_val, np) = parse_limits(bytes, pos, end_pos)
    pos = np
    Array::push(result, (min_val, max_val))
    i = i + 1
  }
  result
}

export fn read_init_expr(bytes: Bytes, offset: Int, end_pos: Int) -> (Int, Int, Int) {
  if offset >= end_pos {
    (0, 0, offset)
  }
  else {
    let op = bytes[offset]
    let mut pos = offset + 1
    if (op == 0x41) || (op == 0x42) {
      let (val, np) = read_sleb128(bytes, pos)
      pos = np
      if (pos < end_pos) && (bytes[pos] == 0x0B) {
        pos = pos + 1
      } else {
        ()
      }
      (op, val, pos)
    } else {
      if op == 0x43 {
        let val = if (pos + 4) <= end_pos {
          bytes[pos]|(bytes[pos + 1]<<8)|(bytes[pos + 2]<<16)|(bytes[pos + 3]<<24)
        } else {
          0
        }
        pos = pos + 4
        if (pos < end_pos) && (bytes[pos] == 0x0B) {
          pos = pos + 1
        } else {
          ()
        }
        (op, val, pos)
      } else {
        if op == 0x44 {
          let lo = if (pos + 4) <= end_pos {
            bytes[pos]|(bytes[pos + 1]<<8)|(bytes[pos + 2]<<16)|(bytes[pos + 3]<<24)
          } else {
            0
          }
          let hi = if (pos + 8) <= end_pos {
            bytes[pos + 4]|(bytes[pos + 5]<<8)|(bytes[pos + 6]<<16)|(bytes[pos + 7]<<24)
          } else {
            0
          }
          pos = pos + 8
          if (pos < end_pos) && (bytes[pos] == 0x0B) {
            pos = pos + 1
          } else {
            ()
          }
          (op, lo|(hi<<32), pos)
        } else {
          if op == 0x23 {
            let (idx, np) = read_uleb128(bytes, pos)
            pos = np
            if (pos < end_pos) && (bytes[pos] == 0x0B) {
              pos = pos + 1
            } else {
              ()
            }
            (op, idx, pos)
          } else {
            while (pos < end_pos) && (bytes[pos] != 0x0B) {
              pos = pos + 1
            }
            if pos < end_pos {
              pos = pos + 1
            } else {
              ()
            }
            (op, 0, pos)
          }
        }
      }
    }
  }
}

export fn parse_globals(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Int, Int)] {
  let end_pos = offset + size
  let result = Array::slice([
    (0, 0, 0, 0)
  ], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let valtype = bytes[pos]
    let mutability = bytes[pos + 1]
    pos = pos + 2
    let (init_op, init_val, np) = read_init_expr(bytes, pos, end_pos)
    pos = np
    Array::push(result, (valtype, mutability, init_op, init_val))
    i = i + 1
  }
  result
}

export fn module_globals(bytes: Bytes) -> Array[(Int, Int, Int, Int)] {
  let (off, sz) = find_sec(bytes, 6)
  if sz == 0 {
    Array::slice([
      (0, 0, 0, 0)
    ], 0, 0)
  }
  else {
    parse_globals(bytes, off, sz)
  }
}

export fn parse_elements(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Int, Array[Int])] {
  let end_pos = offset + size
  let result = Array::slice([
    (0, 0, 0, Array::slice([
      0
    ], 0, 0))
  ], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let mode = bytes[pos]
    pos = pos + 1
    if mode == 0 {
      let (init_op, init_val, np) = read_init_expr(bytes, pos, end_pos)
      pos = np
      let (func_count, fp) = read_uleb128(bytes, pos)
      pos = fp
      let indices = Array::slice([
        0
      ], 0, 0)
      let mut f = 0
      while (f < func_count) && (pos < end_pos) {
        let (fi, np2) = read_uleb128(bytes, pos)
        pos = np2
        Array::push(indices, fi)
        f = f + 1
      }
      Array::push(result, (0, init_op, init_val, indices))
    } else {
      if mode == 1 {
        let elemkind = bytes[pos]
        pos = pos + 1
        let (func_count, fp) = read_uleb128(bytes, pos)
        pos = fp
        let indices = Array::slice([
          0
        ], 0, 0)
        let mut f = 0
        while (f < func_count) && (pos < end_pos) {
          let (fi, np2) = read_uleb128(bytes, pos)
          pos = np2
          Array::push(indices, fi)
          f = f + 1
        }
        Array::push(result, (-1, 0, 0, indices))
      } else {
        if mode == 2 {
          let (table_idx, tp) = read_uleb128(bytes, pos)
          pos = tp
          let (init_op, init_val, np) = read_init_expr(bytes, pos, end_pos)
          pos = np
          let elemkind = bytes[pos]
          pos = pos + 1
          let (func_count, fp) = read_uleb128(bytes, pos)
          pos = fp
          let indices = Array::slice([
            0
          ], 0, 0)
          let mut f = 0
          while (f < func_count) && (pos < end_pos) {
            let (fi, np2) = read_uleb128(bytes, pos)
            pos = np2
            Array::push(indices, fi)
            f = f + 1
          }
          Array::push(result, (table_idx, init_op, init_val, indices))
        } else {
          i = cnt
        }
      }
    }
    i = i + 1
  }
  result
}

export fn validate_magic(bytes: Bytes) -> Bool {
  if Bytes::length(bytes) < 8 {
    false
  }
  else {
    (bytes[0] == 0) && (bytes[1] == 97) && (bytes[2] == 115) && (bytes[3] == 109)
  }
}

export fn module_elements(bytes: Bytes) -> Array[(Int, Int, Int, Array[Int])] {
  let (off, sz) = find_sec(bytes, 9)
  if sz == 0 {
    Array::slice([
      (0, 0, 0, Array::slice([
        0
      ], 0, 0))
    ], 0, 0)
  }
  else {
    parse_elements(bytes, off, sz)
  }
}

export fn module_memories(bytes: Bytes) -> Array[(Int, Int)] {
  let (off, sz) = find_sec(bytes, 5)
  if sz == 0 {
    Array::slice([
      (0, 0)
    ], 0, 0)
  }
  else {
    parse_memories(bytes, off, sz)
  }
}

export fn parse_functions(bytes: Bytes, offset: Int, size: Int) -> Array[Int] {
  let end_pos = offset + size
  let result = Array::slice([
    0
  ], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (type_idx, np) = read_uleb128(bytes, pos)
    pos = np
    Array::push(result, type_idx)
    i = i + 1
  }
  result
}

export fn module_functions(bytes: Bytes) -> Array[Int] {
  let (off, sz) = find_sec(bytes, 3)
  if sz == 0 {
    Array::slice([
      0
    ], 0, 0)
  }
  else {
    parse_functions(bytes, off, sz)
  }
}

export fn extract_data_bytes(bytes: Bytes, data_offset: Int, data_size: Int) -> Bytes {
  let result = Bytes::new()
  let mut i = 0
  while i < data_size {
    Bytes::push(result, bytes[data_offset + i])
    i = i + 1
  }
  result
}

export fn parse_code_entries(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Array[(Int, Int)])] {
  let end_pos = offset + size
  let empty_locals = Array::slice([
    (0, 0)
  ], 0, 0)
  let result = Array::slice([
    (0, 0, empty_locals)
  ], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (body_size, body_start) = read_uleb128(bytes, pos)
    let body_end = body_start + body_size
    let (local_decl_count, lp0) = read_uleb128(bytes, body_start)
    let mut lp = lp0
    let locals = Array::slice([
      (0, 0)
    ], 0, 0)
    let mut d = 0
    while (d < local_decl_count) && (lp < body_end) {
      let (lcount, p1) = read_uleb128(bytes, lp)
      lp = p1
      if lp < body_end {
        // A `(local (ref null $t))` is two-plus bytes, same as a typed
        // reference anywhere else. Reading one byte here left the type index
        // to be taken as the next declaration's count.
        let (ltype, lnext) = read_valtype(bytes, lp)
        lp = lnext
        Array::push(locals, (lcount, ltype))
      } else {
        ()
      }
      d = d + 1
    }
    Array::push(result, (body_start, body_size, locals))
    pos = body_end
    i = i + 1
  }
  result
}

export fn module_code(bytes: Bytes) -> Array[(Int, Int, Array[(Int, Int)])] {
  let (off, sz) = find_sec(bytes, 10)
  if sz == 0 {
    let el = Array::slice([
      (0, 0)
    ], 0, 0); Array::slice([
      (0, 0, el)
    ], 0, 0)
  }
  else {
    parse_code_entries(bytes, off, sz)
  }
}

export fn parse_imports_full(bytes: Bytes, offset: Int, size: Int) -> Array[(String, String, Int, Int, Int, Int)] {
  let end_pos = offset + size
  let result = Array::slice([
    ("", "", 0, 0, 0, 0)
  ], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let (mod_name, p1) = read_name(bytes, pos)
    let (field_name, p2) = read_name(bytes, p1)
    pos = p2
    if pos < end_pos {
      let kind = bytes[pos]
      pos = pos + 1
      if kind == 0 {
        let (type_idx, np) = read_uleb128(bytes, pos)
        pos = np
        Array::push(result, (mod_name, field_name, 0, type_idx, type_idx, 0))
      } else {
        if kind == 1 {
          let reftype = if pos < end_pos {
            let v = bytes[pos]; pos = pos + 1; v
          } else {
            0
          }
          let (_, min_v, max_v, np) = parse_limits(bytes, pos, end_pos)
          pos = np
          Array::push(result, (mod_name, field_name, 1, 0, reftype, min_v))
        } else {
          if kind == 2 {
            let (_, min_v, max_v, np) = parse_limits(bytes, pos, end_pos)
            pos = np
            Array::push(result, (mod_name, field_name, 2, 0, min_v, max_v))
          } else {
            if kind == 3 {
              let valtype = if pos < end_pos {
                let v = bytes[pos]; pos = pos + 1; v
              } else {
                0
              }
              let mutability = if pos < end_pos {
                let v = bytes[pos]; pos = pos + 1; v
              } else {
                0
              }
              Array::push(result, (mod_name, field_name, 3, 0, valtype, mutability))
            } else {
              Array::push(result, (mod_name, field_name, kind, 0, 0, 0))
              i = cnt
            }
          }
        }
      }
    } else {
      ()
    }
    i = i + 1
  }
  result
}

export fn get_code_body_range(bytes: Bytes, body_offset: Int, body_size: Int) -> (Int, Int) {
  let body_end = body_offset + body_size
  let (local_decl_count, pos0) = read_uleb128(bytes, body_offset)
  let mut pos = pos0
  let mut d = 0
  while d < local_decl_count {
    let (_, np) = read_uleb128(bytes, pos)
    pos = np
    pos = pos + 1
    d = d + 1
  }
  (pos, body_end)
}

export fn extract_code_body(bytes: Bytes, body_offset: Int, body_size: Int) -> Bytes {
  let (expr_start, expr_end) = get_code_body_range(bytes, body_offset, body_size)
  let result = Bytes::new()
  let mut i = expr_start
  while i < expr_end {
    Bytes::push(result, bytes[i])
    i = i + 1
  }
  result
}

export fn module_imports_full(bytes: Bytes) -> Array[(String, String, Int, Int, Int, Int)] {
  let (off, sz) = find_sec(bytes, 2)
  if sz == 0 {
    Array::slice([
      ("", "", 0, 0, 0, 0)
    ], 0, 0)
  }
  else {
    parse_imports_full(bytes, off, sz)
  }
}

export fn parse_data_segments(bytes: Bytes, offset: Int, size: Int) -> Array[(Int, Int, Int, Int, Int, Int)] {
  let end_pos = offset + size
  let result = Array::slice([
    (0, 0, 0, 0, 0, 0)
  ], 0, 0)
  let (cnt, pos0) = read_uleb128(bytes, offset)
  let mut pos = pos0
  let mut i = 0
  while (i < cnt) && (pos < end_pos) {
    let mode = bytes[pos]
    pos = pos + 1
    if mode == 0 {
      let (init_op, init_val, np) = read_init_expr(bytes, pos, end_pos)
      pos = np
      let (data_len, dp) = read_uleb128(bytes, pos)
      pos = dp
      Array::push(result, (0, 0, init_op, init_val, pos, data_len))
      pos = pos + data_len
    } else {
      if mode == 1 {
        let (data_len, dp) = read_uleb128(bytes, pos)
        pos = dp
        Array::push(result, (1, 0, 0, 0, pos, data_len))
        pos = pos + data_len
      } else {
        if mode == 2 {
          let (mem_idx, mp) = read_uleb128(bytes, pos)
          pos = mp
          let (init_op, init_val, np) = read_init_expr(bytes, pos, end_pos)
          pos = np
          let (data_len, dp) = read_uleb128(bytes, pos)
          pos = dp
          Array::push(result, (2, mem_idx, init_op, init_val, pos, data_len))
          pos = pos + data_len
        } else {
          i = cnt
        }
      }
    }
    i = i + 1
  }
  result
}

export fn module_data(bytes: Bytes) -> Array[(Int, Int, Int, Int, Int, Int)] {
  let (off, sz) = find_sec(bytes, 11)
  if sz == 0 {
    Array::slice([
      (0, 0, 0, 0, 0, 0)
    ], 0, 0)
  }
  else {
    parse_data_segments(bytes, off, sz)
  }
}

export fn parse_custom_section(bytes: Bytes, offset: Int, size: Int) -> (String, Int, Int) {
  let (name, payload_start) = read_name(bytes, offset)
  let payload_size = size - (payload_start - offset)
  (name, payload_start, payload_size)
}

export fn module_custom_sections(bytes: Bytes) -> Array[(String, Int, Int)] {
  let sections = list_sections(bytes)
  let result = Array::slice([
    ("", 0, 0)
  ], 0, 0)
  let mut i = 0
  while i < Array::length(sections) {
    let (sid, off, sz) = Array::get(sections, i)
    if sid == 0 {
      let (name, payload_off, payload_sz) = parse_custom_section(bytes, off, sz)
      Array::push(result, (name, payload_off, payload_sz))
    } else {
      ()
    }
    i = i + 1
  }
  result
}

export fn module_summary(bytes: Bytes) -> String {
  if not(validate_magic(bytes)) {
    "invalid WASM binary"
  }
  else {
    // O(N) build via StringBuilder; the `StringBuilder::push(out, ...)` dump
    // loops over types/imports/funcs were O(N²) over the module size (issue #366).
    let out = StringBuilder::new()
    StringBuilder::push(out, String::concat("wasm version ", int_to_string(read_version(bytes))))
    StringBuilder::push(out, String::concat(", size ", String::concat(int_to_string(Bytes::length(bytes)), " bytes\n")))
    let types = module_types(bytes)
    StringBuilder::push(out, String::concat("types: ", String::concat(int_to_string(Array::length(types)), "\n")))
    let mut ti = 0
    while ti < Array::length(types) {
      let (params, results) = Array::get(types, ti)
      StringBuilder::push(out, String::concat("  [", String::concat(int_to_string(ti), "] (")))
      StringBuilder::push(out, String::concat(valtypes_str(params), ") -> ("))
      StringBuilder::push(out, String::concat(valtypes_str(results), ")\n"))
      ti = ti + 1
    }
    let imports = module_imports(bytes)
    if Array::length(imports) > 0 {
      StringBuilder::push(out, String::concat("imports: ", String::concat(int_to_string(Array::length(imports)), "\n")))
      let mut ii = 0
      while ii < Array::length(imports) {
        let (m, f, k, idx) = Array::get(imports, ii)
        let kind_str = if k == 0 {
          "func"
        } else if k == 1 {
          "table"
        } else if k == 2 {
          "memory"
        } else {
          "global"
        }
        StringBuilder::push(out, String::concat("  ", String::concat(m, String::concat(".", String::concat(f, String::concat(" : ", String::concat(kind_str, "\n")))))))
        ii = ii + 1
      }
    } else {
      ()
    }
    let funcs = module_functions(bytes)
    StringBuilder::push(out, String::concat("functions: ", String::concat(int_to_string(Array::length(funcs)), "\n")))
    let tables = module_tables(bytes)
    if Array::length(tables) > 0 {
      StringBuilder::push(out, String::concat("tables: ", String::concat(int_to_string(Array::length(tables)), "\n")))
    } else {
      ()
    }
    let mems = module_memories(bytes)
    if Array::length(mems) > 0 {
      StringBuilder::push(out, String::concat("memories: ", String::concat(int_to_string(Array::length(mems)), "\n")))
      let mut mi = 0
      while mi < Array::length(mems) {
        let (min_p, max_p) = Array::get(mems, mi)
        StringBuilder::push(out, String::concat("  min=", String::concat(int_to_string(min_p), if max_p >= 0 {
          String::concat(" max=", int_to_string(max_p))
        } else {
          ""
        })))
        StringBuilder::push(out, "\n")
        mi = mi + 1
      }
    } else {
      ()
    }
    let globals = module_globals(bytes)
    if Array::length(globals) > 0 {
      StringBuilder::push(out, String::concat("globals: ", String::concat(int_to_string(Array::length(globals)), "\n")))
      let mut gi = 0
      while gi < Array::length(globals) {
        let (vt, mut_f, _, init_val) = Array::get(globals, gi)
        StringBuilder::push(out, String::concat("  ", String::concat(valtype_name(vt), if mut_f == 1 {
          " mut"
        } else {
          ""
        })))
        StringBuilder::push(out, String::concat(" = ", String::concat(int_to_string(init_val), "\n")))
        gi = gi + 1
      }
    } else {
      ()
    }
    let exports = module_exports(bytes)
    StringBuilder::push(out, String::concat("exports: ", String::concat(int_to_string(Array::length(exports)), "\n")))
    let mut ei = 0
    while ei < Array::length(exports) {
      let (name, kind, idx) = Array::get(exports, ei)
      let kind_str = if kind == 0 {
        "func"
      } else if kind == 1 {
        "table"
      } else if kind == 2 {
        "memory"
      } else {
        "global"
      }
      StringBuilder::push(out, String::concat("  ", String::concat(name, String::concat(" : ", String::concat(kind_str, String::concat(" ", String::concat(int_to_string(idx), "\n")))))))
      ei = ei + 1
    }
    let start_idx = module_start(bytes)
    if start_idx >= 0 {
      StringBuilder::push(out, String::concat("start: func ", String::concat(int_to_string(start_idx), "\n")))
    } else {
      ()
    }
    let elems = module_elements(bytes)
    if Array::length(elems) > 0 {
      StringBuilder::push(out, String::concat("elements: ", String::concat(int_to_string(Array::length(elems)), " segments\n")))
    } else {
      ()
    }
    let code = module_code(bytes)
    if Array::length(code) > 0 {
      StringBuilder::push(out, String::concat("code: ", String::concat(int_to_string(Array::length(code)), " bodies\n")))
      let mut ci = 0
      while ci < Array::length(code) {
        let (_, bsz, locals) = Array::get(code, ci)
        let nloc = count_locals(locals)
        StringBuilder::push(out, String::concat("  [", String::concat(int_to_string(ci), String::concat("] size=", String::concat(int_to_string(bsz), String::concat(" locals=", String::concat(int_to_string(nloc), "\n")))))))
        ci = ci + 1
      }
    } else {
      ()
    }
    let data = module_data(bytes)
    if Array::length(data) > 0 {
      StringBuilder::push(out, String::concat("data: ", String::concat(int_to_string(Array::length(data)), " segments\n")))
      let mut di = 0
      while di < Array::length(data) {
        let (mode, _, _, _, _, dlen) = Array::get(data, di)
        let mode_str = if mode == 0 {
          "active"
        } else if mode == 1 {
          "passive"
        } else {
          "active"
        }
        StringBuilder::push(out, String::concat("  ", String::concat(mode_str, String::concat(" size=", String::concat(int_to_string(dlen), "\n")))))
        di = di + 1
      }
    } else {
      ()
    }
    let customs = module_custom_sections(bytes)
    if Array::length(customs) > 0 {
      StringBuilder::push(out, String::concat("custom sections: ", String::concat(int_to_string(Array::length(customs)), "\n")))
      let mut ci = 0
      while ci < Array::length(customs) {
        let (name, _, psz) = Array::get(customs, ci)
        StringBuilder::push(out, String::concat("  \"", String::concat(name, String::concat("\" size=", String::concat(int_to_string(psz), "\n")))))
        ci = ci + 1
      }
    } else {
      ()
    }
    StringBuilder::freeze(out)
  }
}
