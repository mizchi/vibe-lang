test "rs: truncated section header" {
  // Valid header + section id byte but no size
  let bytes = make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00,
    0x01
  ])
  // Should not crash, may return 0 sections (incomplete section)
  let sections = list_sections(bytes)
  // The section has id but no complete size LEB128
  // Parser should handle gracefully
  assert(Array::length(sections) >= 0)
}

test "rs: truncated section payload" {
  // Type section claims 10 bytes but only has 2
  let bytes = make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00,
    0x01,
    0x0A,
    0x01,
    0x60
  ])
  let sections = list_sections(bytes)
  // Section extends beyond file end - should be skipped
