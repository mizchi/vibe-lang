test "rs: custom between standard sections" {
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    // type section
    1,
    4,
    1,
    0x60,
    0,
    0,
    // custom "x"
    0,
    3,
    1,
    0x78,
    0xFF,
    // function section
    3,
    2,
    1,
    0,
    // custom "y"
    0,
    3,
    1,
    0x79,
    0xFE,
    // code section
    10,
    4,
    1,
    2,
    0,
    0x0B
  ])
  let sections = list_sections(bytes)
  assert(Array::length(sections) == 5)
  // Check custom sections
  let customs = module_custom_sections(bytes)
  assert(Array::length(customs) == 2)
  let (n0, _, _) = Array::get(customs, 0)
  let (n1, _, _) = Array::get(customs, 1)
  assert(n0 == "x")
  assert(n1 == "y")
  // Standard sections still parse correctly
  let types = module_types(bytes)
  assert(Array::length(types) == 1)
  let funcs = module_functions(bytes)
  assert(Array::length(funcs) == 1)
  let code = module_code(bytes)
  assert(Array::length(code) == 1)
}

test "rs: validator module type counts" {
  // Module with: 1 type, 1 memory (1-5), 1 table (funcref 10),
  // 1 global (mut i32 = 0), 1 func, 1 element, 1 export
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    // type: (i32, i64) -> (i32)
    1,
    7,
    1,
    0x60,
    2,
    0x7F,
    0x7E,
    1,
    0x7F,
    // function
    3,
    2,
    1,
    0,
    // table: funcref min=10
    4,
    4,
    1,
    0x70,
    0,
    10,
    // memory: min=1 max=5
    5,
    4,
    1,
    1,
    1,
    5,
    // global: mut i32 = 0
    6,
    6,
    1,
    0x7F,
    1,
    0x41,
    0,
    0x0B,
    // export: "f" func 0
    7,
    5,
    1,
    1,
    0x66,
    0,
    0,
    // element: table 0, offset 0, [0]
    9,
    7,
    1,
    0,
    0x41,
    0,
    0x0B,
    1,
    0,
    // code: i32.const 0, end
    10,
    6,
    1,
    4,
    0,
    0x41,
    0,
    0x0B
  ])
  // types
  let types = module_types(bytes)
  assert(Array::length(types) == 1)
  let (params, results) = Array::get(types, 0)
  assert(Array::length(params) == 2)
  assert(Array::get(params, 0) == 0x7F)
  assert(Array::get(params, 1) == 0x7E)
  assert(Array::length(results) == 1)
  assert(Array::get(results, 0) == 0x7F)
  // memory
  let mems = module_memories(bytes)
  assert(Array::length(mems) == 1)
  let (min_p, max_p) = Array::get(mems, 0)
  assert(min_p == 1)
  assert(max_p == 5)
  // table
  let tables = module_tables(bytes)
  assert(Array::length(tables) == 1)
  let (rt, tmin, _) = Array::get(tables, 0)
  assert(rt == 0x70)
  assert(tmin == 10)
  // global
  let globals = module_globals(bytes)
  assert(Array::length(globals) == 1)
  let (vt, mut_f, _, _) = Array::get(globals, 0)
  assert(vt == 0x7F)
  assert(mut_f == 1)
  // function
  let funcs = module_functions(bytes)
  assert(Array::length(funcs) == 1)
  assert(Array::get(funcs, 0) == 0)
  // element
  let elems = module_elements(bytes)
  assert(Array::length(elems) == 1)
  // export
  let exports = module_exports(bytes)
  assert(Array::length(exports) == 1)
  let (en, ek, _) = Array::get(exports, 0)
  assert(en == "f")
  assert(ek == 0)
  // code
  let code = module_code(bytes)
  assert(Array::length(code) == 1)
  // summary covers everything
  let s = module_summary(bytes)
  assert(String::contains(s, "types: 1"))
  assert(String::contains(s, "functions: 1"))
  assert(String::contains(s, "memories: 1"))
  assert(String::contains(s, "globals: 1"))
  assert(String::contains(s, "exports: 1"))
  assert(String::contains(s, "elements: 1"))
  assert(String::contains(s, "code: 1"))
}

