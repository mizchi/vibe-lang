test "rs: valid header" {
  assert(validate_magic(make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00
  ])) == true)
  assert(read_version(make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00
  ])) == 1)
}

test "rs: invalid version" {
  // version 2 is not valid WASM 1.0, but magic is still correct
  let bytes = make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x02,
    0x00,
    0x00,
    0x00
  ])
  assert(validate_magic(bytes) == true)
  assert(read_version(bytes) == 2)
}

test "rs: empty bytes" {
  assert(validate_magic(make_bytes(Array::slice([
    0
  ], 0, 0))) == false)
  assert(read_version(make_bytes(Array::slice([
    0
  ], 0, 0))) == -1)
}

test "rs: incomplete magic 1 byte" {
  assert(validate_magic(make_bytes([
    0x00
  ])) == false)
}

test "rs: incomplete magic 4 bytes" {
  assert(validate_magic(make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D
  ])) == false)
}

