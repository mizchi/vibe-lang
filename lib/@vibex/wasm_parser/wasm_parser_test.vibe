test "parse_globals i32 const" {
  // 1 global: i32, immutable, init=i32.const 42, end
  let globals = parse_globals(make_bytes([
    1,
    127,
    0,
    0x41,
    42,
    0x0B
  ]), 0, 6)
  assert(Array::length(globals) == 1)
  let (vt, mut_f, init_op, init_val) = Array::get(globals, 0)
  assert(vt == 127)
  assert(mut_f == 0)
  assert(init_op == 0x41)
  assert(init_val == 42)
}

test "parse_globals i64 const" {
  // 1 global: i64, mutable, init=i64.const 10, end  (10 < 64, no sign issue)
  let globals = parse_globals(make_bytes([
    1,
    126,
    1,
    0x42,
    10,
    0x0B
  ]), 0, 6)
  let (vt, mut_f, init_op, init_val) = Array::get(globals, 0)
  assert(vt == 126)
  assert(mut_f == 1)
  assert(init_op == 0x42)
  assert(init_val == 10)
}

test "parse_globals global.get" {
  // 1 global: i32, immutable, init=global.get 0, end
  let globals = parse_globals(make_bytes([
    1,
    127,
    0,
    0x23,
    0,
    0x0B
  ]), 0, 6)
  let (_, _, init_op, init_val) = Array::get(globals, 0)
  assert(init_op == 0x23)
  assert(init_val == 0)
}

test "parse_globals multiple" {
  // 2 globals: i32 const 10, i32 const 20
  let globals = parse_globals(make_bytes([
    2,
    127,
    0,
    0x41,
    10,
    0x0B,
    127,
    1,
    0x41,
    20,
    0x0B
  ]), 0, 11)
  assert(Array::length(globals) == 2)
  let (_, _, _, v0) = Array::get(globals, 0)
  let (_, _, _, v1) = Array::get(globals, 1)
  assert(v0 == 10)
  assert(v1 == 20)
}

