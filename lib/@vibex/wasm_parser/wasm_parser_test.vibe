test "parse_start" {
  assert(parse_start(make_bytes([
    5
  ]), 0, 1) == 5)
}

test "parse_elements active" {
  // 1 active element: table 0, offset i32.const 0, 3 func indices [0, 1, 2]
  let elems = parse_elements(make_bytes([
    1,
    0,
    0x41,
    0,
    0x0B,
    3,
    0,
    1,
    2
  ]), 0, 9)
  assert(Array::length(elems) == 1)
  let (table_idx, init_op, init_val, indices) = Array::get(elems, 0)
  assert(table_idx == 0)
  assert(init_op == 0x41)
  assert(init_val == 0)
  assert(Array::length(indices) == 3)
  assert(Array::get(indices, 0) == 0)
  assert(Array::get(indices, 1) == 1)
  assert(Array::get(indices, 2) == 2)
}

test "parse_elements active with offset" {
  // offset i32.const 5, 2 funcs [3, 4]
  let elems = parse_elements(make_bytes([
    1,
    0,
    0x41,
    5,
    0x0B,
    2,
    3,
    4
  ]), 0, 8)
  let (_, _, init_val, indices) = Array::get(elems, 0)
  assert(init_val == 5)
  assert(Array::length(indices) == 2)
  assert(Array::get(indices, 0) == 3)
  assert(Array::get(indices, 1) == 4)
}

test "parse_elements multiple" {
  // 2 segments
  let elems = parse_elements(make_bytes([
    2,
    0,
    0x41,
    0,
    0x0B,
    1,
    0,
    0,
    0x41,
    10,
    0x0B,
    1,
    1
  ]), 0, 13)
  assert(Array::length(elems) == 2)
}

test "parse_code_entries" {
  let entries = parse_code_entries(make_bytes([
    1,
    4,
    0,
    65,
    42,
    11
  ]), 0, 6)
  assert(Array::length(entries) == 1)
  let (_, body_size, locals) = Array::get(entries, 0)
  assert(body_size == 4)
  assert(Array::length(locals) == 0)
}

test "parse_code_entries with locals" {
  let entries = parse_code_entries(make_bytes([
    1,
    7,
    1,
    2,
    127,
    66,
    0,
    11,
    0
  ]), 0, 9)
  let (_, _, locals) = Array::get(entries, 0)
  assert(Array::length(locals) == 1)
  let (cnt, vt) = Array::get(locals, 0)
  assert(cnt == 2)
  assert(vt == 127)
  assert(count_locals(locals) == 2)
}

test "extract_code_body" {
  // body: size=4, 0 local decls, i32.const 42, end
  let bytes = make_bytes([
    1,
    4,
    0,
    0x41,
    42,
    0x0B
  ])
  let entries = parse_code_entries(bytes, 0, 6)
  let (off, sz, _) = Array::get(entries, 0)
  let body = extract_code_body(bytes, off, sz)
  assert(Bytes::length(body) == 3)
  assert(body[0] == 0x41)
  assert(body[1] == 42)
  assert(body[2] == 0x0B)
}

test "get_code_body_range with locals" {
  // code section: 1 body
  // body size=7: [local_count=1, (2, i32=0x7F), i32.const 0, end]
  // raw: count=1 size=7 | 1 2 0x7F | 0x41 0 0x0B  (padded)
  let bytes = make_bytes([
    1,
    7,
    1,
    2,
    0x7F,
    0x41,
    0,
    0x0B,
    0
  ])
  let entries = parse_code_entries(bytes, 0, 9)
  let (off, sz, _) = Array::get(entries, 0)
  // off = body_start (after size LEB), sz = 7
  // body bytes: [1, 2, 0x7F, 0x41, 0, 0x0B, 0]
  // local decl: count=1, then (2, 0x7F) = 3 bytes total
  // expr starts at off + 3
  let (expr_start, expr_end) = get_code_body_range(bytes, off, sz)
  assert(bytes[expr_start] == 0x41)
}

test "get_code_body_range with a typed-reference local" {
  // Same shape, but the local's valtype is `(ref null $12)` = 0x63 0x0C --
  // TWO bytes. Advancing by one put the code start on the type index, so the
  // first "instruction" read was 0x0C (br). Every gc body with a typed-ref
  // local decoded from one byte too early, and extract_code_body hands that
  // range to the interpreter.
  //
  // body size=8: [local_count=1, (2, ref null 12), i32.const 0, end]
  let bytes = make_bytes([
    1,
    8,
    1,
    2,
    0x63,
    0x0C,
    0x41,
    0,
    0x0B,
    0
  ])
  let entries = parse_code_entries(bytes, 0, 10)
  let (off, sz, _) = Array::get(entries, 0)
  let (expr_start, _) = get_code_body_range(bytes, off, sz)
  assert(bytes[expr_start] == 0x41)
}

test "parse_data_segments active" {
  // mode=0, offset=i32.const 0, end, 3 bytes
  let segs = parse_data_segments(make_bytes([
    1,
    0,
    0x41,
    0,
    0x0B,
    3,
    72,
    73,
    74
  ]), 0, 9)
  assert(Array::length(segs) == 1)
  let (mode, _, init_op, init_val, data_off, data_len) = Array::get(segs, 0)
  assert(mode == 0)
  assert(init_op == 0x41)
  assert(init_val == 0)
  assert(data_len == 3)
}

test "parse_data_segments with offset" {
  // offset=i32.const 16 (16 < 64, safe sleb128)
  let segs = parse_data_segments(make_bytes([
    1,
    0,
    0x41,
    16,
    0x0B,
    2,
    65,
    66
  ]), 0, 8)
  let (_, _, _, init_val, _, data_len) = Array::get(segs, 0)
  assert(init_val == 16)
  assert(data_len == 2)
}

test "extract_data_bytes" {
  let bytes = make_bytes([
    1,
    0,
    0x41,
    0,
    0x0B,
    3,
    72,
    73,
    74
  ])
  let segs = parse_data_segments(bytes, 0, 9)
  let (_, _, _, _, data_off, data_len) = Array::get(segs, 0)
  let data = extract_data_bytes(bytes, data_off, data_len)
  assert(Bytes::length(data) == 3)
  assert(data[0] == 72)
  assert(data[1] == 73)
  assert(data[2] == 74)
}

test "parse_custom_section" {
  // name="test" (4 bytes), payload=2 bytes
  let (name, _, payload_sz) = parse_custom_section(make_bytes([
    4,
    116,
    101,
    115,
    116,
    1,
    2
  ]), 0, 7)
  assert(name == "test")
  assert(payload_sz == 2)
}

test "read_init_expr i32" {
  let (op, val, _) = read_init_expr(make_bytes([
    0x41,
    42,
    0x0B
  ]), 0, 3)
  assert(op == 0x41)
  assert(val == 42)
}

test "read_init_expr i64" {
  // i64.const 10 (10 < 64 so single-byte sleb128 is fine)
  let (op, val, _) = read_init_expr(make_bytes([
    0x42,
    10,
    0x0B
  ]), 0, 3)
  assert(op == 0x42)
  assert(val == 10)
}

test "read_init_expr global.get" {
  let (op, val, _) = read_init_expr(make_bytes([
    0x23,
    3,
    0x0B
  ]), 0, 3)
  assert(op == 0x23)
  assert(val == 3)
}

test "section_name" {
  assert(section_name(0) == "custom")
  assert(section_name(1) == "type")
  assert(section_name(7) == "export")
  assert(section_name(9) == "element")
  assert(section_name(10) == "code")
  assert(section_name(99) == "unknown")
}

test "valtype_name" {
  assert(valtype_name(127) == "i32")
  assert(valtype_name(126) == "i64")
  assert(valtype_name(125) == "f32")
  assert(valtype_name(124) == "f64")
  assert(valtype_name(112) == "funcref")
  assert(valtype_name(0) == "unknown")
}

test "full module parse" {
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    1,
    5,
    1,
    96,
    0,
    1,
    127,
    3,
    2,
    1,
    0,
    7,
    8,
    1,
    4,
    109,
    97,
    105,
    110,
    0,
    0,
    10,
    6,
    1,
    4,
    0,
    65,
    42,
    11
  ])
  assert(validate_magic(bytes) == true)
  assert(read_version(bytes) == 1)
  let sections = list_sections(bytes)
  assert(Array::length(sections) == 4)
  let (_, toff, tsz) = Array::get(sections, 0)
  let types = parse_types(bytes, toff, tsz)
  assert(Array::length(types) == 1)
  let (_, foff, fsz) = Array::get(sections, 1)
  let funcs = parse_functions(bytes, foff, fsz)
  assert(Array::length(funcs) == 1)
  let (_, eoff, esz) = Array::get(sections, 2)
  let exports = parse_exports(bytes, eoff, esz)
  assert(Array::length(exports) == 1)
  let (name, kind, idx) = Array::get(exports, 0)
  assert(name == "main")
  assert(kind == 0)
  let (_, coff, csz) = Array::get(sections, 3)
  let code = parse_code_entries(bytes, coff, csz)
  assert(Array::length(code) == 1)
}

test "full module all sections" {
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    // type: (i32) -> (i32)
    1,
    6,
    1,
    96,
    1,
    127,
    1,
    127,
    // import: "env"."g" global i32 mut
    2,
    10,
    1,
    3,
    101,
    110,
    118,
    1,
    103,
    3,
    127,
    1,
    // function: 1 func type 0
    3,
    2,
    1,
    0,
    // table: funcref min=1
    4,
    4,
    1,
    0x70,
    0,
    1,
    // memory: min=1
    5,
    3,
    1,
    0,
    1,
    // global: i32 const=0
    6,
    6,
    1,
    127,
    0,
    0x41,
    0,
    0x0B,
    // export: "f" func 1 (import counts as 0)
    7,
    5,
    1,
    1,
    102,
    0,
    1,
    // element: table 0, offset 0, [1]
    9,
    7,
    1,
    0,
    0x41,
    0,
    0x0B,
    1,
    1,
    // code: local.get 0, end
    10,
    6,
    1,
    4,
    0,
    0x20,
    0,
    0x0B,
    // data: offset 0, "AB"
    11,
    8,
    1,
    0,
    0x41,
    0,
    0x0B,
    2,
    65,
    66
  ])
  let sections = list_sections(bytes)
  // Should have: type, import, function, table, memory, global, export, element, code, data = 10
  assert(Array::length(sections) == 10)
  // Parse elements
  let (_, elem_off, elem_sz) = Array::get(sections, 7)
  let elems = parse_elements(bytes, elem_off, elem_sz)
  assert(Array::length(elems) == 1)
  let (table_idx, _, _, indices) = Array::get(elems, 0)
  assert(table_idx == 0)
  assert(Array::length(indices) == 1)
  assert(Array::get(indices, 0) == 1)
  // Parse data
  let (_, data_off, data_sz) = Array::get(sections, 9)
  let segs = parse_data_segments(bytes, data_off, data_sz)
  assert(Array::length(segs) == 1)
  let (_, _, _, _, d_off, d_len) = Array::get(segs, 0)
  let data = extract_data_bytes(bytes, d_off, d_len)
  assert(Bytes::length(data) == 2)
  assert(data[0] == 65)
  assert(data[1] == 66)
  // Parse imports full
  let (_, imp_off, imp_sz) = Array::get(sections, 1)
  let imports = parse_imports_full(bytes, imp_off, imp_sz)
  assert(Array::length(imports) == 1)
  let (_, _, ik, _, iv, im) = Array::get(imports, 0)
  assert(ik == 3)
  assert(iv == 127)
  assert(im == 1)
  // Extract code body
  let (_, code_off, code_sz) = Array::get(sections, 8)
  let code_entries = parse_code_entries(bytes, code_off, code_sz)
  let (boff, bsz, _) = Array::get(code_entries, 0)
  let body = extract_code_body(bytes, boff, bsz)
  assert(Bytes::length(body) == 3)
  assert(body[0] == 0x20)
}

