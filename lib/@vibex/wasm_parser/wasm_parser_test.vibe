//# Functions

fn make_bytes(values: Array[Int]) -> Bytes {
  let buf = Bytes::new()
  let mut i = 0
  while i < Array::length(values) {
    Bytes::push(buf, Array::get(values, i))
    i = i + 1
  }
  buf
}

//# Misc

test "validate_magic valid" {
  assert(validate_magic(make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0
  ])) == true)
}

test "validate_magic invalid" {
  assert(validate_magic(make_bytes([
    0,
    0,
    0,
    0,
    1,
    0,
    0,
    0
  ])) == false)
}

test "validate_magic too short" {
  assert(validate_magic(make_bytes([
    0,
    97,
    115
  ])) == false)
}

test "read_version" {
  assert(read_version(make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0
  ])) == 1)
}

test "list_sections empty" {
  assert(Array::length(list_sections(make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0
  ]))) == 0)
}

test "list_sections type" {
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    1,
    4,
    1,
    96,
    0,
    0
  ])
  let sections = list_sections(bytes)
  assert(Array::length(sections) == 1)
  let (sid, _, sz) = Array::get(sections, 0)
  assert(sid == 1)
  assert(sz == 4)
}

test "list_sections multiple" {
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    1,
    4,
    1,
    96,
    0,
    0,
    5,
    3,
    1,
    0,
    1
  ])
  assert(Array::length(list_sections(bytes)) == 2)
}

test "find_section found" {
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    1,
    4,
    1,
    96,
    0,
    0
  ])
  let (off, sz) = find_section(bytes, 1)
  assert(off > 0)
  assert(sz == 4)
}

test "find_section not found" {
  let (off, _) = find_section(make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0
  ]), 1)
  assert(off == -1)
}

test "parse_types void" {
  let types = parse_types(make_bytes([
    1,
    96,
    0,
    0
  ]), 0, 4)
  assert(Array::length(types) == 1)
  let (p, r) = Array::get(types, 0)
  assert(Array::length(p) == 0)
  assert(Array::length(r) == 0)
}

test "parse_types i32 i32 to i64" {
  let types = parse_types(make_bytes([
    1,
    96,
    2,
    127,
    127,
    1,
    126
  ]), 0, 7)
  let (p, r) = Array::get(types, 0)
  assert(Array::length(p) == 2)
  assert(Array::get(p, 0) == 127)
  assert(Array::get(r, 0) == 126)
}

test "parse_types multiple" {
  let types = parse_types(make_bytes([
    2,
    96,
    0,
    1,
    127,
    96,
    1,
    126,
    0
  ]), 0, 9)
  assert(Array::length(types) == 2)
}

test "parse_imports func" {
  let imports = parse_imports(make_bytes([
    1,
    3,
    101,
    110,
    118,
    3,
    97,
    100,
    100,
    0,
    0
  ]), 0, 11)
  assert(Array::length(imports) == 1)
  let (m, f, k, i) = Array::get(imports, 0)
  assert(m == "env")
  assert(f == "add")
  assert(k == 0)
  assert(i == 0)
}

test "parse_imports memory" {
  let imports = parse_imports(make_bytes([
