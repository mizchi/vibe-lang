test "rs: global global.get ref" {
  // 2 globals: first i32 const 0, second i32 = global.get 0
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    6,
    11,
    2,
    0x7F,
    0,
    0x41,
    0,
    0x0B,
    0x7F,
    0,
    0x23,
    0,
    0x0B
  ])
  let globals = module_globals(bytes)
  assert(Array::length(globals) == 2)
  let (_, _, op0, _) = Array::get(globals, 0)
  assert(op0 == 0x41)
  let (_, _, op1, val1) = Array::get(globals, 1)
  assert(op1 == 0x23)
  assert(val1 == 0)
}

test "rs: code section multiple local groups" {
  // 3 local groups: 2 x i32, 1 x i64, 3 x f32
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    10,
    12,
    1,
    10,
    3,
    2,
    0x7F,
    1,
    0x7E,
    3,
    0x7D,
    0x41,
    0,
    0x0B
  ])
  let code = module_code(bytes)
  let (_, _, locals) = Array::get(code, 0)
  assert(Array::length(locals) == 3)
  let (c0, t0) = Array::get(locals, 0)
  assert(c0 == 2)
  assert(t0 == 0x7F)
  let (c1, t1) = Array::get(locals, 1)
  assert(c1 == 1)
  assert(t1 == 0x7E)
  let (c2, t2) = Array::get(locals, 2)
  assert(c2 == 3)
  assert(t2 == 0x7D)
  assert(count_locals(locals) == 6)
}

test "rs: code body extraction skips locals" {
  // 1 local group (1 x i32), body: local.get 0, i32.const 1, i32.add, end
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    10,
    11,
    1,
    9,
    1,
    1,
    0x7F,
    0x20,
    0,
    0x41,
    1,
    0x6A,
    0x0B
  ])
  let code = module_code(bytes)
  let (boff, bsz, _) = Array::get(code, 0)
  let body = extract_code_body(bytes, boff, bsz)
  assert(Bytes::length(body) == 6)
  assert(body[0] == 0x20)
  assert(body[1] == 0)
  assert(body[2] == 0x41)
  assert(body[3] == 1)
  assert(body[4] == 0x6A)
  assert(body[5] == 0x0B)
}

test "rs: data segment long data" {
  // active segment, offset 0, 10 bytes of data
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    11,
    15,
    1,
    0,
    0x41,
    0,
    0x0B,
    10,
    0x00,
    0x01,
    0x02,
    0x03,
    0x04,
    0x05,
    0x06,
    0x07,
    0x08,
    0x09
  ])
  let data = module_data(bytes)
  let (_, _, _, _, doff, dlen) = Array::get(data, 0)
  assert(dlen == 10)
  let extracted = extract_data_bytes(bytes, doff, dlen)
  assert(Bytes::length(extracted) == 10)
  assert(extracted[0] == 0x00)
  assert(extracted[9] == 0x09)
}

