test "rs: code body extraction" {
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    10,
    8,
    1,
    6,
    1,
    1,
    0x7F,
    0x41,
    42,
    0x0B
  ])
  let code = module_code(bytes)
  let (boff, bsz, _) = Array::get(code, 0)
  let body = extract_code_body(bytes, boff, bsz)
  // should skip local decl (1 group: 1 x i32 = 3 bytes), leaving: i32.const 42, end
  assert(Bytes::length(body) == 3)
  assert(body[0] == 0x41)
  assert(body[1] == 42)
  assert(body[2] == 0x0B)
}

