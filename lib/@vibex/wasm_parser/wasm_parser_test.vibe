test "rs: section order correct" {
  // type (1) < import (2) < function (3) < export (7) < code (10)
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    1,
    4,
    1,
    0x60,
    0,
    0,
    3,
    2,
    1,
    0,
    7,
    5,
    1,
    1,
    0x66,
    0,
    0,
    10,
    5,
    1,
    3,
    0,
    0x01,
    0x0B
  ])
  let sections = list_sections(bytes)
  assert(Array::length(sections) == 4)
  let (s0, _, _) = Array::get(sections, 0)
  let (s1, _, _) = Array::get(sections, 1)
  let (s2, _, _) = Array::get(sections, 2)
  let (s3, _, _) = Array::get(sections, 3)
  assert(s0 == 1)
  assert(s1 == 3)
  assert(s2 == 7)
  assert(s3 == 10)
}

test "rs: complete module all sections" {
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    // type: (i32, i64) -> (i32)
    1,
    7,
    1,
    0x60,
    2,
    0x7F,
    0x7E,
    1,
    0x7F,
    // import: "e"."f" func type 0
    2,
    7,
    1,
    1,
    0x65,
    1,
    0x66,
    0,
    0,
    // function: 1 local func type 0
    3,
    2,
    1,
    0,
    // table: funcref min=1
    4,
    4,
    1,
    0x70,
    0,
    1,
    // memory: min=1 max=5
    5,
    4,
    1,
    1,
    1,
    5,
    // global: i32 mut init=0
    6,
    6,
    1,
    0x7F,
    1,
    0x41,
    0,
    0x0B,
    // export: "g" func 1
    7,
    5,
    1,
    1,
    0x67,
    0,
    1,
    // element: table 0, offset 0, [1]
    9,
    7,
    1,
    0,
    0x41,
    0,
    0x0B,
    1,
    1,
    // code: local.get 0, local.get 1, i32.add, end (after wrapping)
    10,
    8,
    1,
    6,
    0,
    0x20,
    0,
    0x20,
    1,
    0x0B,
    // data: offset 0, "AB"
    11,
    8,
    1,
    0,
    0x41,
    0,
    0x0B,
    2,
    0x41,
    0x42
  ])
  assert(validate_magic(bytes) == true)
  // types
  let types = module_types(bytes)
  assert(Array::length(types) == 1)
  let (params, results) = Array::get(types, 0)
  assert(Array::length(params) == 2)
  assert(Array::length(results) == 1)
  // imports
  let imports = module_imports(bytes)
  assert(Array::length(imports) == 1)
  let (m, f, k, _) = Array::get(imports, 0)
  assert(m == "e")
  assert(f == "f")
  assert(k == 0)
  // functions
  let funcs = module_functions(bytes)
  assert(Array::length(funcs) == 1)
  // tables
  let tables = module_tables(bytes)
  assert(Array::length(tables) == 1)
  let (rt, _, _) = Array::get(tables, 0)
  assert(rt == 0x70)
  // memories
  let mems = module_memories(bytes)
  assert(Array::length(mems) == 1)
  let (min_p, max_p) = Array::get(mems, 0)
  assert(min_p == 1)
  assert(max_p == 5)
  // globals
  let globals = module_globals(bytes)
  assert(Array::length(globals) == 1)
  let (vt, mut_f, _, _) = Array::get(globals, 0)
  assert(vt == 0x7F)
  assert(mut_f == 1)
  // exports
  let exports = module_exports(bytes)
  assert(Array::length(exports) == 1)
  let (en, ek, ei) = Array::get(exports, 0)
  assert(en == "g")
  assert(ek == 0)
  assert(ei == 1)
  // elements
  let elems = module_elements(bytes)
  assert(Array::length(elems) == 1)
  // code
  let code = module_code(bytes)
  assert(Array::length(code) == 1)
  // data
  let data = module_data(bytes)
  assert(Array::length(data) == 1)
  let (_, _, _, _, doff, dlen) = Array::get(data, 0)
  let extracted = extract_data_bytes(bytes, doff, dlen)
  assert(Bytes::length(extracted) == 2)
  assert(extracted[0] == 0x41)
  assert(extracted[1] == 0x42)
}

test "rs: all valtype names" {
  assert(valtype_name(0x7F) == "i32")
  assert(valtype_name(0x7E) == "i64")
  assert(valtype_name(0x7D) == "f32")
  assert(valtype_name(0x7C) == "f64")
  assert(valtype_name(0x7B) == "v128")
  assert(valtype_name(0x70) == "funcref")
  assert(valtype_name(0x6F) == "externref")
  assert(valtype_name(0x00) == "unknown")
}

test "rs: all section names" {
  assert(section_name(0) == "custom")
  assert(section_name(1) == "type")
  assert(section_name(2) == "import")
  assert(section_name(3) == "function")
  assert(section_name(4) == "table")
  assert(section_name(5) == "memory")
  assert(section_name(6) == "global")
  assert(section_name(7) == "export")
  assert(section_name(8) == "start")
  assert(section_name(9) == "element")
  assert(section_name(10) == "code")
  assert(section_name(11) == "data")
  assert(section_name(12) == "datacount")
}

