test "rs: find_section returns first" {
  // Two type sections (unusual but tests first-match)
  let bytes = make_bytes([
    0,
    97,
    115,
    109,
    1,
    0,
    0,
    0,
    1,
    4,
    1,
    0x60,
    0,
    0,
    1,
    5,
    1,
    0x60,
    1,
    0x7F,
    0
  ])
  let (off, sz) = find_section(bytes, 1)
  assert(sz == 4)
  // First type section should be used
  let types = parse_types(bytes, off, sz)
  assert(Array::length(types) == 1)
  let (p, _) = Array::get(types, 0)
  assert(Array::length(p) == 0)
}

