//# Imports

// #897 (ADR-0070 Phase 3): `FileEntry` is defined transparently in
// ./index.vpkg (the old ./types.vibe was deleted) — referenced here by name
// only (types are global in the merged program).

//# Values

//# Functions

/// #768: direct-call form throughout this file for magic host effects (Fs,
/// Env, Stdout, Stdin), not `perform <Effect>::<Op>`. The perform/effect-op
/// codegen path for these can crash with an uncaught wasm exception (see
/// #778's fix + notes) when no handler is installed; direct calls bypass
/// that machinery entirely and are what every already-working call site in
/// the compiler uses. `Process::Exec` is a real user-declared effect (not a
/// magic host builtin), so it's left as `perform` -- it needs a real handler.
export fn cd(path: String) -> Unit with Fs {
  Fs::chdir(path)
}

export fn cp(src: String, dst: String) -> Unit with Fs {
  Fs::copy(src, dst)
}

export fn mv(src: String, dst: String) -> Unit with Fs {
  Fs::rename(src, dst)
}

export fn rm(path: String) -> Unit with Fs {
  Fs::remove(path)
}

export fn cat(path: String) -> String with Fs {
  Fs::read_file(path)
}

export fn env(name: String) -> String with Env {
  Env::get(name)
}

export fn pwd() -> String with Fs {
  Fs::getcwd()
}

export fn tee(text: String, path: String) -> String with Fs {
  Fs::write_file(path, text)
  text
}

export fn echo(text: String) -> String {
  text
}

export fn exec(cmd: String) -> Unit with Process {
  let _ = perform Process::Exec(cmd)
  ()
}

export fn mkdir(path: String) -> Unit with Fs {
  Fs::mkdir(path)
}

export fn print(text: String) -> Unit with Stdout {
  Stdout::write_stream(text)
}

export fn touch(path: String) -> Unit with Fs {
  if not(Fs::exists(path)) {
    Fs::write_file(path, "")
  }
}

export fn append(path: String, content: String) -> Unit with Fs {
  Fs::append(path, content)
}

export fn env_or(name: String, fallback: String) -> String with Env {
  let value = Env::get(name)
  if value == "" {
    fallback
  } else value
}

export fn exists(path: String) -> Bool with Fs {
  Fs::exists(path)
}

export fn is_dir(path: String) -> Bool with Fs {
  Fs::is_dir(path)
}

export fn is_file(path: String) -> Bool with Fs {
  Fs::is_file(path)
}

export fn mkdir_p(path: String) -> Unit with Fs {
  Fs::mkdir_p(path)
}

export fn println(text: String) -> Unit with Stdout {
  Stdout::write_stream(text)
  Stdout::write_char(10)
}

export fn realpath(p: String) -> String with Env {
  Path::to_string(Path::resolve(p))
}

export fn sleep_ms(ms: Int) -> Unit with Async {
  sleep(ms)
}

export fn read_line() -> String with Stdin {
  Stdin::read_stream(4096)
}

export fn exec_lines(cmd: String) -> Array[String] with Process {
  sh_lines(cmd)
}

export fn write_file(path: String, content: String) -> Unit with Fs {
  Fs::write_file(path, content)
}

fn to_file_entry(name: String, path: String) -> FileEntry with Fs {
  FileEntry::{
    name: name,
    path: path,
    is_dir: Fs::is_dir(path)
  }
}

fn is_navigation_entry(name: String) -> Bool {
  if name == "." {
    true
  } else name == ".."
}

fn strip_trailing_slashes(path: String) -> String {
  let path_len = String::length(path)
  if path_len <= 1 {
    path
  }
  else if String::ends_with(path, "/") {
    path[0: path_len - 1]
  }
  else path
}

fn join_path(dir: String, name: String) -> String {
  let normalized_dir = strip_trailing_slashes(dir)
  if normalized_dir == "/" {
    "/\{name}"
  }
  else {
    "\{normalized_dir}/\{name}"
  }
}

fn list_entries(dir: String, include_hidden: Bool) -> Array[FileEntry] with Fs {
  let names = Fs::readdir(dir)
  let result = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, i)
    let visible = if include_hidden {
      true
    }
    else not(String::starts_with(name, "."))
    if visible {
      ArrayBuilder::push(result, to_file_entry(name, join_path(dir, name)))
    }
    i = i + 1
  }
  ArrayBuilder::freeze(result)
}

export fn ls(dir: String) -> Array[FileEntry] with Fs {
  list_entries(dir, false)
}

export fn ls_all(dir: String) -> Array[FileEntry] with Fs {
  list_entries(dir, true)
}

fn path_basename(path: String) -> String {
  let normalized_path = strip_trailing_slashes(path)
  let idx = String::last_index_of(normalized_path, "/")
  if idx < 0 {
    normalized_path
  }
  else normalized_path[idx + 1: String::length(normalized_path)]
}

export fn find(dir: String) -> Array[FileEntry] with Fs {
  let root_dir = strip_trailing_slashes(dir)
  let result = ArrayBuilder::new()
  let queue_paths = ArrayBuilder::new()
  let initial_names = Fs::readdir(root_dir)
  let mut k = 0
  while k < Array::length(initial_names) {
    let name = Array::get(initial_names, k)
    if not(is_navigation_entry(name)) {
      ArrayBuilder::push(queue_paths, join_path(root_dir, name))
    }
    k = k + 1
  }
  let mut paths = ArrayBuilder::freeze(queue_paths)
  while Array::length(paths) > 0 {
    let next_paths = ArrayBuilder::new()
    let mut i = 0
    while i < Array::length(paths) {
      let p = Array::get(paths, i)
      let is_directory = Fs::is_dir(p)
      ArrayBuilder::push(result, FileEntry::{
        name: path_basename(p), path: p, is_dir: is_directory
      })
      if is_directory {
        let child_names = Fs::readdir(p)
        let mut j = 0
        while j < Array::length(child_names) {
          let cname = Array::get(child_names, j)
          if not(is_navigation_entry(cname)) {
            ArrayBuilder::push(next_paths, join_path(p, cname))
          }
          j = j + 1
        }
      }
      i = i + 1
    }
    paths = ArrayBuilder::freeze(next_paths)
  }
  ArrayBuilder::freeze(result)
}

//# Canonical collision-safe aliases

/// #897 (ADR-0070 Phase 3): the old index.vibe facade defined these seven
/// shell_* wrappers as real `export fn`s directly in the facade file — a
/// `.vpkg` contract file cannot hold fn bodies, so they moved here verbatim.
/// #768/#778: the bodies stay in direct-call builtin form (never
/// `perform <Effect>::<Op>`) — the perform/effect-op codegen path for magic
/// host effects can crash with an uncaught wasm exception when no handler is
/// installed.
export fn shell_print(text: String) -> Unit with Stdout {
  Stdout::write_stream(text)
}

export fn shell_println(text: String) -> Unit with Stdout {
  Stdout::write_stream(text)
  Stdout::write_char(10)
}

export fn shell_read_line() -> String with Stdin {
  Stdin::read_stream(4096)
}

export fn shell_exists(path: String) -> Bool with Fs {
  Fs::exists(path)
}

export fn shell_is_dir(path: String) -> Bool with Fs {
  Fs::is_dir(path)
}

export fn shell_is_file(path: String) -> Bool with Fs {
  Fs::is_file(path)
}

export fn shell_write_file(path: String, content: String) -> Unit with Fs {
  Fs::write_file(path, content)
}
