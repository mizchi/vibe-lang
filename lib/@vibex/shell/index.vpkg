name = @vibex/shell
version = 0.0.1
description =
  #|@vibex/shell — POSIX-flavored shell command wrappers (commands.vibe /
deps = {
  @vibe/json : 0.0.1
  @vibe/builtin : 0.0.1
}

generated_hash =

// @vibex/shell — POSIX-flavored shell command wrappers (commands.vibe /
// commands_extra.vibe), string/array pipeline helpers incl. the jq family
// (pipeline.vibe), glob (glob.vibe), and the CSV/YAML → Json readers
// (from_csv.vibe / from_yaml.vibe) (ADR-0070 Phase 3, #897).
//
// `FileEntry` is declared TRANSPARENT (defined verbatim, not opaque):
// commands_test/pipeline_test/posix_compat_test/_types_test access
// `.name`/`.is_dir` directly, so the field layout is real public API
// surface. The definition moved here from types.vibe (which held nothing
// else and was deleted); commands.vibe/pipeline.vibe reference the type by
// name only (types are global in the merged program, same convention as
// ShResult in @vibe/process, PR #920).
//
// The effect rows below (Fs/Env/Process/Stdout/Stdin/Async) are all
// checker-builtin effects (checker/builtins_system.vibe) — no import
// needed. `Json` in the from_csv/from_yaml signatures is @vibe/json's
// transparent enum; the impl files import it via `import ../json { ... }`
// (#847 Phase B: through the json package facade, never its internal
// files).
//
// `version` was `export let version = "0.0.1"` directly in the old
// index.vibe facade — a real importable binding, not just contract
// metadata — preserved as an implementation-file value (commands.vibe) with
// a matching bodyless declaration here (Codex review precedent, PR #914).
// The old facade ALSO defined the seven `shell_*` "canonical
// collision-safe alias" wrappers as real `export fn`s directly in the
// facade file — a `.vpkg` contract file cannot hold fn bodies, so they
// moved verbatim (bodies unchanged, #768/#778 direct-call form) into
// commands.vibe.
//
// from_csv.vibe's `_csv_is_number`/`_csv_parse_line`/`_csv_escape_json`
// are exported impl helpers (from_csv_test.vibe imports them) the old
// hand-written facade never re-exported — conformance still requires every
// exported def declared here (same as @vibe/path's ref.vibe helpers, PR
// #914).

struct FileEntry {
  name: String;
  path: String;
  is_dir: Bool
}

// --- commands
fn cd(path: String) -> Unit with Fs
fn cp(src: String, dst: String) -> Unit with Fs
fn mv(src: String, dst: String) -> Unit with Fs
fn rm(path: String) -> Unit with Fs
fn cat(path: String) -> String with Fs
fn env(name: String) -> String with Env
fn pwd() -> String with Fs
fn tee(text: String, path: String) -> String with Fs
fn echo(text: String) -> String
fn exec(cmd: String) -> Unit with Process
fn mkdir(path: String) -> Unit with Fs
fn print(text: String) -> Unit with Stdout
fn touch(path: String) -> Unit with Fs
fn append(path: String, content: String) -> Unit with Fs
fn env_or(name: String, fallback: String) -> String with Env
fn exists(path: String) -> Bool with Fs
fn is_dir(path: String) -> Bool with Fs
fn is_file(path: String) -> Bool with Fs
fn mkdir_p(path: String) -> Unit with Fs
fn println(text: String) -> Unit with Stdout
fn realpath(p: String) -> String with Env
fn sleep_ms(ms: Int) -> Unit with Async
fn read_line() -> String with Stdin
fn exec_lines(cmd: String) -> Array[String] with Process
fn write_file(path: String, content: String) -> Unit with Fs
fn ls(dir: String) -> Array[FileEntry] with Fs
fn ls_all(dir: String) -> Array[FileEntry] with Fs
fn find(dir: String) -> Array[FileEntry] with Fs

// --- commands (canonical collision-safe aliases)
fn shell_print(text: String) -> Unit with Stdout
fn shell_println(text: String) -> Unit with Stdout
fn shell_read_line() -> String with Stdin
fn shell_exists(path: String) -> Bool with Fs
fn shell_is_dir(path: String) -> Bool with Fs
fn shell_is_file(path: String) -> Bool with Fs
fn shell_write_file(path: String, content: String) -> Unit with Fs

// --- commands_extra
fn df() -> Array[String] with Process
fn du(path: String) -> Array[String] with Process
fn tree(dir: String) -> String with Process
fn which(name: String) -> String with Process
fn diff_files(a: String, b: String) -> Array[String] with Process

// --- glob
fn glob(pattern: String) -> Array[String] with Process

// --- pipeline
fn jq(text: String, expr: String) -> String
fn nl(xs: Array[String], sep: String) -> Array[String]
fn tr(text: String, src_chars: String, dst_chars: String) -> String
fn wc(text: String) -> Int
fn cut(xs: Array[String], delim: String, field: Int) -> Array[String]
fn len(text: String) -> Int
fn seq(first: Int, last: Int) -> Array[String]
fn grep(xs: Array[String], pattern: String) -> Array[String]
fn trim(text: String) -> String
fn uniq(xs: Array[String]) -> Array[String]
fn wc_l(text: String) -> Int
fn count(text: String, sub: String) -> Int
fn lines(text: String) -> Array[String]
fn lower(text: String) -> String
fn paste(xs: Array[String], ys: Array[String], sep: String) -> Array[String]
fn split(text: String, sep: String) -> Array[String]
fn upper(text: String) -> String
fn expand(text: String, tab_width: Int) -> String
fn jq_arr(text: String) -> Array[String]
fn jq_num(text: String, expr: String) -> Double
fn jq_str(text: String, expr: String) -> String
fn char_at(text: String, idx: Int) -> String
fn dirname(path: String) -> String
fn grep_re(xs: Array[String], pattern: String) -> Array[String] with Process
fn replace(text: String, pattern: String, replacement: String) -> String
fn rev_str(xs: Array[String]) -> Array[String]
fn tac(text: String) -> String
fn basename(path: String) -> String
fn extname(path: String) -> String
fn index_of(text: String, sub: String) -> Int
fn join_str(xs: Array[String], sep: String) -> String
fn seq_step(first: Int, incr: Int, last: Int) -> Array[String]
fn sort_str(xs: Array[String]) -> Array[String]
fn drop_str(xs: Array[String], n: Int) -> Array[String]
fn tail_str(xs: Array[String], n: Int) -> Array[String]
fn count_str(xs: Array[String]) -> Int
fn ends_with(text: String, suffix: String) -> Bool
fn take_str(xs: Array[String], n: Int) -> Array[String]
fn head_str(xs: Array[String], n: Int) -> Array[String]
fn repeat_str(text: String, n: Int) -> String
fn starts_with(text: String, prefix: String) -> Bool
fn contains_str(text: String, sub: String) -> Bool
fn take_entries(xs: Array[FileEntry], n: Int) -> Array[FileEntry]
fn count_entries(xs: Array[FileEntry]) -> Int
fn last_index_of(text: String, sub: String) -> Int
fn pad_left(text: String, width: Int, pad: String) -> String
fn pad_right(text: String, width: Int, pad: String) -> String
fn names(entries: Array[FileEntry]) -> Array[String]
fn map_str(xs: Array[String], f: (String) -> String) -> Array[String]
fn filter_str(xs: Array[String], f: (String) -> Bool) -> Array[String]
fn where_entry(entries: Array[FileEntry], pred: (FileEntry) -> Bool) -> Array[FileEntry]

// --- from_csv / from_yaml
fn _csv_is_number(s: String) -> Bool
fn _csv_parse_line(line: String) -> Array[String]
fn _csv_escape_json(s: String) -> String
fn from_csv(text: String) -> Json
fn from_yaml(text: String) -> Json
