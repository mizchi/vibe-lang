//# Imports

// #777: `Json::parse`/`Json::stringify`/... were written against the
// MoonBit host's builtin `Json` type (auto-imported methods); the selfhost
// `@vibe/json` package only ships Result-based primitives, so use the
// direct-value convenience wrappers in json_convenience.vibe instead.
// #897: directory form (not `../json/index.vibe`) — json is a .vpkg
// contract package now.
// #1841: `String::replace_all` was reimplemented locally here to sidestep a
// selfhost miscompile that no longer reproduces (the trigger was rewritten in
// #1092); the prelude import is restored. See pipeline.vibe for the pinned
// regression shape.
import @vibe/builtin {
  String::replace_all
}

import @vibe/json {
  Json, Json::parse
}

//# Functions

export fn _csv_is_number(s: String) -> Bool {
  let len = String::length(s)
  if len == 0 {
    false
  } else {
    let mut i = 0
    let first = s[0: 1]
    if first == "-" {
      if len == 1 {
        false
      } else {
        i = 1
        let mut valid = true
        let mut has_dot = false
        while i < len {
          let ch = s[i]
          if ch == '.' {
            if has_dot {
              valid = false
            }
            has_dot = true
          } else if not(ch == '0') {
            if not(ch == '1') {
              if not(ch == '2') {
                if not(ch == '3') {
                  if not(ch == '4') {
                    if not(ch == '5') {
                      if not(ch == '6') {
                        if not(ch == '7') {
                          if not(ch == '8') {
                            if not(ch == '9') {
                              valid = false
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          i = i + 1
        }
        valid
      }
    } else {
      let mut valid = true
      let mut has_dot = false
      while i < len {
        let ch = s[i]
        if ch == '.' {
          if has_dot {
            valid = false
          }
          has_dot = true
        } else if not(ch == '0') {
          if not(ch == '1') {
            if not(ch == '2') {
              if not(ch == '3') {
                if not(ch == '4') {
                  if not(ch == '5') {
                    if not(ch == '6') {
                      if not(ch == '7') {
                        if not(ch == '8') {
                          if not(ch == '9') {
                            valid = false
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        i = i + 1
      }
      valid
    }
  }
}

export fn _csv_parse_line(line: String) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let len = String::length(line)
    let mut field_sb = StringBuilder::new()
    let mut i = 0
    let mut in_quotes = false
    while i < len {
      // #777: `line[i]` (single-index) is an Int char code — compare against
      // char literals. Where the raw character must be appended as text,
      // reuse the range-slice `line[i: i+1]` (String) instead of `ch`.
      let ch = line[i]
      let ch_str = line[i: i + 1]
      let mut extra = 0
      let prev_in_quotes = in_quotes
      if in_quotes {
        if ch == '"' {
          let mut is_escape = false
          if i + 1 < len {
            let next = line[i + 1: i + 2]
            if next == "\"" {
              is_escape = true
            }
          }
          if is_escape {
            StringBuilder::push(field_sb, "\"")
            extra = 1
          }
          if not(is_escape) {
            in_quotes = false
          }
        }
        if not(ch == '"') {
          StringBuilder::push(field_sb, ch_str)
        }
      }
      if not(prev_in_quotes) {
        if ch == '"' {
          in_quotes = true
        }
        if ch == ',' {
          ArrayBuilder::push(result, StringBuilder::freeze(field_sb))
          field_sb = StringBuilder::new()
        }
        if not(ch == '"') {
          if not(ch == ',') {
            StringBuilder::push(field_sb, ch_str)
          }
        }
      }
      i = i + 1 + extra
    }
    ArrayBuilder::push(result, StringBuilder::freeze(field_sb))
    ArrayBuilder::freeze(result)
  }
}

export fn _csv_escape_json(s: String) -> String {
  {
    let sb = StringBuilder::new()
    let len = String::length(s)
    let mut i = 0
    while i < len {
      // #777: `s[i]` is an Int char code — compare against char literals,
      // not one-char strings (Int == String is a type error).
      let ch = s[i]
      let ch_str = s[i: i + 1]
      if ch == '\\' {
        StringBuilder::push(sb, "\\\\")
      } else if ch == '"' {
        StringBuilder::push(sb, "\\\"")
      } else if ch == '\n' {
        StringBuilder::push(sb, "\\n")
      } else if ch == '\t' {
        StringBuilder::push(sb, "\\t")
      } else StringBuilder::push(sb, ch_str)
      i = i + 1
    }
    StringBuilder::freeze(sb)
  }
}

export fn from_csv(text: String) -> Json {
  let cr = String::from_char_code(13)
  let cleaned = String::replace_all(text, cr, "")
  let all_lines = String::split(cleaned, "\n")
  let num_lines = Array::length(all_lines)
  if num_lines < 2 {
    Json::parse("[]")
  } else {
    let headers = _csv_parse_line(Array::get(all_lines, 0))
    let num_headers = Array::length(headers)
    {
      let sb = StringBuilder::new()
      StringBuilder::push(sb, "[")
      let mut row_idx = 1
      let mut first_row = true
      while row_idx < num_lines {
        let line = Array::get(all_lines, row_idx)
        if not(String::trim(line) == "") {
          let fields = _csv_parse_line(line)
          if not(first_row) {
            StringBuilder::push(sb, ",")
          }
          first_row = false
          StringBuilder::push(sb, "{")
          let mut col = 0
          while col < num_headers {
            if col > 0 {
              StringBuilder::push(sb, ",")
            }
            StringBuilder::push(sb, "\"")
            StringBuilder::push(sb, _csv_escape_json(Array::get(headers, col)))
            StringBuilder::push(sb, "\":")
            let val = if col < Array::length(fields) {
              Array::get(fields, col)
            } else ""
            if _csv_is_number(val) {
              StringBuilder::push(sb, val)
            } else {
              StringBuilder::push(sb, "\"")
              StringBuilder::push(sb, _csv_escape_json(val))
              StringBuilder::push(sb, "\"")
            }
            col = col + 1
          }
          StringBuilder::push(sb, "}")
        }
        row_idx = row_idx + 1
      }
      StringBuilder::push(sb, "]")
      Json::parse(StringBuilder::freeze(sb))
    }
  }
}
