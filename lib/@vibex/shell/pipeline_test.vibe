//# Imports

// #897: retargeted from direct impl-file imports (./pipeline.vibe /
// ./types.vibe) to the package directory — `FileEntry`'s transparent
// definition now lives in index.vpkg's facade, which a direct impl-file
// import would not include.
import .{
  type FileEntry,
  basename,
  char_at,
  contains_str,
  count,
  count_entries,
  count_str,
  cut,
  dirname,
  drop_str,
  ends_with,
  expand,
  extname,
  filter_str,
  grep,
  head_str,
  index_of,
  join_str,
  jq,
  jq_arr,
  jq_num,
  jq_str,
  last_index_of,
  len,
  lines,
  lower,
  map_str,
  names,
  nl,
  pad_left,
  pad_right,
  paste,
  repeat_str,
  replace,
  rev_str,
  seq,
  seq_step,
  sort_str,
  split,
  starts_with,
  tac,
  tail_str,
  take_entries,
  take_str,
  tr,
  trim,
  uniq,
  upper,
  wc,
  wc_l,
  where_entry
}

//# Misc

test "take_str returns first n elements" {
  let xs = [
    "a",
    "b",
    "c",
    "d",
    "e"
  ]
  let result = take_str(xs, 3)
  assert(Array::length(result) == 3)
  assert(Array::get(result, 0) == "a")
  assert(Array::get(result, 2) == "c")
}

test "drop_str skips first n elements" {
  let xs = [
    "a",
    "b",
    "c",
    "d",
    "e"
  ]
  let result = drop_str(xs, 2)
  assert(Array::length(result) == 3)
  assert(Array::get(result, 0) == "c")
}

test "drop_str with negative n behaves like drop 0" {
  let xs = [
    "a",
    "b",
    "c"
  ]
  let result = drop_str(xs, -1)
  assert(Array::length(result) == 3)
  assert(Array::get(result, 0) == "a")
  assert(Array::get(result, 2) == "c")
}

test "count_str returns length" {
  let xs = [
    "a",
    "b",
    "c"
  ]
  assert(count_str(xs) == 3)
}

test "lines splits text" {
  let text = "a\nb\nc"
  let result = lines(text)
  assert(Array::length(result) == 3)
  assert(Array::get(result, 0) == "a")
  assert(Array::get(result, 2) == "c")
}

test "grep filters matching lines" {
  let xs = [
    "hello world",
    "foo bar",
    "hello again"
  ]
  let result = grep(xs, "hello")
  assert(Array::length(result) == 2)
}

test "names extracts entry names" {
  let entries = [
    FileEntry::{
      name: "a", path: "/a", is_dir: false
    },
    FileEntry::{
      name: "b", path: "/b", is_dir: true
    }
  ]
  let result = names(entries)
  assert(Array::length(result) == 2)
  assert(Array::get(result, 0) == "a")
}

test "where_entry filters entries" {
  let entries = [
    FileEntry::{
      name: "dir1", path: "/dir1", is_dir: true
    },
    FileEntry::{
      name: "file1", path: "/file1", is_dir: false
    },
    FileEntry::{
      name: "dir2", path: "/dir2", is_dir: true
    }
  ]
  let dirs = where_entry(entries, (e: FileEntry) -> Bool {
    e.is_dir
  })
  assert(Array::length(dirs) == 2)
}

test "take_entries returns first n entries" {
  let entries = [
    FileEntry::{
      name: "a", path: "/a", is_dir: false
    },
    FileEntry::{
      name: "b", path: "/b", is_dir: true
    },
    FileEntry::{
      name: "c", path: "/c", is_dir: false
    }
  ]
  let result = take_entries(entries, 2)
  assert(Array::length(result) == 2)
  assert(Array::get(result, 0).name == "a")
  assert(Array::get(result, 1).name == "b")
}

test "take_entries with negative n returns empty" {
  let entries = [
    FileEntry::{
      name: "a", path: "/a", is_dir: false
    }
  ]
  let result = take_entries(entries, -1)
  assert(Array::length(result) == 0)
}

test "pipeline composition with take_str and count_str" {
  let xs = [
    "a",
    "b",
    "c",
    "d",
    "e"
  ]
  let result = xs |> take_str(3) |> count_str()
  assert(result == 3)
}

test "grep with lines pipeline" {
  let text = "error: something\ninfo: ok\nerror: another"
  let result = text |> lines() |> grep("error")
  assert(Array::length(result) == 2)
}

test "basename extracts filename" {
  assert(basename("/foo/bar/baz.txt") == "baz.txt")
  assert(basename("file.txt") == "file.txt")
  assert(basename("/foo/") == "")
}

test "dirname extracts directory" {
  assert(dirname("/foo/bar/baz.txt") == "/foo/bar")
  assert(dirname("file.txt") == ".")
  assert(dirname("/foo") == "/")
}

test "extname extracts extension" {
  assert(extname("/foo/bar.txt") == ".txt")
  assert(extname("file") == "")
  assert(extname(".hidden") == "")
}

test "sort_str sorts strings lexicographically" {
  let xs = [
    "b",
    "aa",
    "a",
    "ab"
  ]
  let result = sort_str(xs)
  assert(Array::get(result, 0) == "a")
  assert(Array::get(result, 1) == "aa")
  assert(Array::get(result, 2) == "ab")
  assert(Array::get(result, 3) == "b")
}

test "uniq removes consecutive duplicates" {
  let xs = [
    "a",
    "a",
    "b",
    "b",
    "a"
  ]
  let result = uniq(xs)
  assert(Array::length(result) == 3)
  assert(Array::get(result, 0) == "a")
  assert(Array::get(result, 1) == "b")
  assert(Array::get(result, 2) == "a")
}

test "rev_str reverses array" {
  let xs = [
    "a",
    "b",
    "c"
  ]
  let result = rev_str(xs)
  assert(Array::get(result, 0) == "c")
  assert(Array::get(result, 1) == "b")
  assert(Array::get(result, 2) == "a")
}

test "head_str returns first n" {
  let xs = [
    "a",
    "b",
    "c",
    "d"
  ]
  let result = head_str(xs, 2)
  assert(Array::length(result) == 2)
  assert(Array::get(result, 0) == "a")
}

test "tail_str returns last n" {
  let xs = [
    "a",
    "b",
    "c",
    "d"
  ]
  let result = tail_str(xs, 2)
  assert(Array::length(result) == 2)
  assert(Array::get(result, 0) == "c")
  assert(Array::get(result, 1) == "d")
}

test "join_str joins with separator" {
  let xs = [
    "a",
    "b",
    "c"
  ]
  assert(join_str(xs, ",") == "a,b,c")
}

test "split splits string" {
  let result = split("a,b,c", ",")
  assert(Array::length(result) == 3)
  assert(Array::get(result, 0) == "a")
}

test "wc counts words" {
  assert(wc("hello world foo") == 3)
  assert(wc("") == 0)
  assert(wc("  one  ") == 1)
}

test "wc_l counts lines" {
  assert(wc_l("a\nb\nc") == 3)
  assert(wc_l("") == 0)
  assert(wc_l("single") == 1)
}

test "trim removes whitespace" {
  assert(trim("  hello  ") == "hello")
}

test "upper converts to uppercase" {
  assert(upper("hello") == "HELLO")
}

test "lower converts to lowercase" {
  assert(lower("HELLO") == "hello")
}

test "replace replaces pattern" {
  assert(replace("aXb", "X", "-") == "a-b")
}

test "contains_str checks substring" {
  assert(contains_str("hello world", "world"))
  assert(not(contains_str("hello", "xyz")))
}

test "cut extracts fields" {
  let xs = [
    "a:b:c",
    "d:e:f"
  ]
  let result = cut(xs, ":", 1)
  assert(Array::length(result) == 2)
  assert(Array::get(result, 0) == "b")
  assert(Array::get(result, 1) == "e")
}

test "cut with negative field returns empty columns" {
  let xs = [
    "a:b:c",
    "d:e:f"
  ]
  let result = cut(xs, ":", -1)
  assert(Array::length(result) == 2)
  assert(Array::get(result, 0) == "")
  assert(Array::get(result, 1) == "")
}

test "tr translates characters" {
  assert(tr("hello", "elo", "ELO") == "hELLO")
  assert(tr("abc", "a", "x") == "xbc")
}

test "seq generates number sequence" {
  let result = seq(1, 5)
  assert(Array::length(result) == 5)
  assert(Array::get(result, 0) == "1")
  assert(Array::get(result, 4) == "5")
}

test "seq_step generates stepped sequence" {
  let result = seq_step(0, 2, 6)
  assert(Array::length(result) == 4)
  assert(Array::get(result, 0) == "0")
  assert(Array::get(result, 1) == "2")
  assert(Array::get(result, 3) == "6")
}

test "nl numbers lines" {
  let xs = [
    "a",
    "b",
    "c"
  ]
  let result = nl(xs, "\t")
  assert(Array::length(result) == 3)
  assert(Array::get(result, 0) == "1\ta")
  assert(Array::get(result, 2) == "3\tc")
}

test "paste merges two arrays" {
  let xs = [
    "a",
    "b"
  ]
  let ys = [
    "1",
    "2"
  ]
  let result = paste(xs, ys, "\t")
  assert(Array::length(result) == 2)
  assert(Array::get(result, 0) == "a\t1")
  assert(Array::get(result, 1) == "b\t2")
}

test "tac reverses lines" {
  assert(tac("a\nb\nc") == "c\nb\na")
}

test "expand replaces tabs" {
  assert(expand("\thello", 4) == "    hello")
  assert(expand("a\tb", 2) == "a  b")
}

test "starts_with checks prefix" {
  assert(starts_with("hello world", "hello"))
  assert(not(starts_with("hello", "world")))
}

test "ends_with checks suffix" {
  assert(ends_with("hello world", "world"))
  assert(not(ends_with("hello", "world")))
}

test "char_at returns character" {
  assert(char_at("hello", 0) == "h")
  assert(char_at("hello", 4) == "o")
}

test "index_of finds first occurrence" {
  assert(index_of("hello world", "world") == 6)
  assert(index_of("hello", "xyz") == -1)
}

test "last_index_of finds last occurrence" {
  assert(last_index_of("abcabc", "abc") == 3)
  assert(last_index_of("hello", "xyz") == -1)
}

test "len returns string length" {
  assert(len("hello") == 5)
  assert(len("") == 0)
}

test "count counts occurrences" {
  assert(count("abcabcabc", "abc") == 3)
  assert(count("hello", "xyz") == 0)
}

test "repeat_str repeats string" {
  assert(repeat_str("ab", 3) == "ababab")
  assert(repeat_str("x", 0) == "")
}

test "pad_left pads string" {
  assert(pad_left("hi", 5, " ") == "   hi")
  assert(pad_left("hello", 3, " ") == "hello")
}

test "pad_right pads string" {
  assert(pad_right("hi", 5, " ") == "hi   ")
  assert(pad_right("hello", 3, " ") == "hello")
}

test "pad_left repeats and truncates multi-char pad" {
  assert(pad_left("hi", 7, "ab") == "ababahi")
}

test "pad_right repeats and truncates multi-char pad" {
  assert(pad_right("hi", 7, "ab") == "hiababa")
}

test "pad with empty filler returns original text" {
  assert(pad_left("hi", 7, "") == "hi")
  assert(pad_right("hi", 7, "") == "hi")
}

test "map_str transforms elements" {
  let xs = [
    "hello",
    "world"
  ]
  // #777: `String::to_upper` is a checker builtin stub with no codegen
  // backing (see pipeline.vibe's `pipeline_to_upper` comment) — use the
  // package's own `upper` (imported above), which does the same ASCII
  // uppercasing via a working implementation.
  let result = map_str(xs, (s: String) -> String {
    upper(s)
  })
  assert(Array::get(result, 0) == "HELLO")
  assert(Array::get(result, 1) == "WORLD")
}

test "filter_str filters elements" {
  let xs = [
    "hello",
    "hi",
    "hey",
    "world"
  ]
  let result = filter_str(xs, (s: String) -> Bool {
    String::starts_with(s, "h")
  })
  assert(Array::length(result) == 3)
}

test "jq extracts field as JSON" {
  let result = jq("{\"name\":\"vibe\",\"ver\":1}", "name")
  assert(result == "\"vibe\"")
}

test "jq navigates dotted path" {
  assert(jq("{\"a\":{\"b\":{\"c\":42}}}", "a.b.c") == "42")
}

test "jq indexes array with [n]" {
  assert(jq("[10,20,30]", "[0]") == "10")
  assert(jq("[10,20,30]", "[2]") == "30")
}

test "jq returns keys as JSON array" {
  let keys_json = jq("{\"a\":1,\"b\":2}", "keys")
  let keys = jq_arr(keys_json)
  assert(Array::length(keys) == 2)
}

test "jq returns values as JSON array" {
  let vals_json = jq("{\"a\":1,\"b\":2}", "values")
  let vals = jq_arr(vals_json)
  assert(Array::length(vals) == 2)
}

test "jq returns type" {
  assert(jq_str("42", "type") == "number")
  assert(jq_str("\"hello\"", "type") == "string")
  assert(jq_str("null", "type") == "null")
  assert(jq_str("[1,2]", "type") == "array")
  assert(jq_str("{\"a\":1}", "type") == "object")
}

test "jq returns length" {
  assert(jq("[1,2,3]", "length") == "3")
  assert(jq("{\"a\":1,\"b\":2}", "length") == "2")
}

test "jq with dot prefix" {
  assert(jq("{\"x\":1}", ".x") == "1")
  assert(jq("{\"a\":{\"b\":2}}", ".a.b") == "2")
}

test "jq_str extracts string field" {
  assert(jq_str("{\"name\":\"vibe\"}", "name") == "vibe")
}

test "jq_str with dotted path" {
  assert(jq_str("{\"a\":{\"name\":\"deep\"}}", "a.name") == "deep")
}

test "jq_num extracts number field" {
  assert(eq(jq_num("{\"x\":3.14}", "x"), 3.14))
}

test "jq_arr expands array elements" {
  let result = jq_arr("[1,2,3]")
  assert(Array::length(result) == 3)
  assert(Array::get(result, 0) == "1")
  assert(Array::get(result, 2) == "3")
}

test "jq pipeline: map over array" {
  let arr = "[{\"name\":\"a\"},{\"name\":\"b\"}]"
  let result = jq_arr(arr) |> map_str((item: String) -> String {
    jq_str(item, "name")
  })
  assert(Array::length(result) == 2)
  assert(Array::get(result, 0) == "a")
  assert(Array::get(result, 1) == "b")
}
