//# Imports

// #897: retargeted from direct impl-file imports (./commands.vibe /
// ./types.vibe) to the package directory — `FileEntry`'s transparent
// definition now lives in index.vpkg's facade, which a direct impl-file
// import would not include.
import .{
  append,
  cat,
  cd,
  cp,
  echo,
  env,
  env_or,
  exec_lines,
  exists,
  find,
  is_dir,
  is_file,
  ls,
  ls_all,
  mkdir,
  mkdir_p,
  mv,
  pwd,
  realpath,
  rm,
  struct FileEntry,
  tee,
  touch,
  write_file
}

//# Misc

test "echo returns text" {
  assert(echo("hello") == "hello")
}

test "pwd returns string" {
  let cwd = pwd()
  assert(String::length(cwd) > 0)
}

test "mkdir and ls" {
  let dir = "/tmp/vibe_shell_test_ls"
  mkdir_p(dir)
  let entries = ls(dir)
  assert(Array::length(entries) >= 0)
}

test "touch and cat" {
  let path = "/tmp/vibe_shell_test_touch.txt"
  touch(path)
  let content = cat(path)
  assert(content == "")
}

test "cd changes cwd" {
  cd("/tmp")
  let after = pwd()
  // macOS reports its physical `/private/tmp` path; Linux reports `/tmp`.
  assert(String::ends_with(after, suffix = "/tmp"))
}

test "ls_all shows hidden files" {
  let dir = "/tmp/vibe_shell_test_hidden"
  mkdir_p(dir)
  touch("\{dir}/.hidden")
  touch("\{dir}/visible")
  let without_all = ls(dir)
  let with_all = ls_all(dir)
  assert(Array::length(with_all) >= Array::length(without_all))
}

test "ls normalizes trailing slash path" {
  let dir = "/tmp/vibe_shell_test_ls_trailing"
  mkdir_p(dir)
  write_file(path = "\{dir}/item.txt", content = "x")
  let entries = ls("\{dir}/")
  assert(Array::length(entries) == 1)
  let item = Array::get(entries, at = 0)
  assert(item.name == "item.txt")
}

test "mkdir_p creates nested dirs" {
  let dir = "/tmp/vibe_shell_test_mkdir_p/a/b/c"
  mkdir_p(dir)
  let exists_result = Fs::exists(dir)
  assert(exists_result)
}

test "write_file and cat roundtrip" {
  let path = "/tmp/vibe_shell_test_write.txt"
  write_file(path = path, content = "hello world")
  let content = cat(path)
  assert(content == "hello world")
}

test "rm removes file" {
  let path = "/tmp/vibe_shell_test_rm.txt"
  write_file(path = path, content = "delete me")
  rm(path)
  let e = exists(path)
  assert(not(e))
}

test "cp copies file" {
  let src = "/tmp/vibe_shell_test_cp_src.txt"
  let dst = "/tmp/vibe_shell_test_cp_dst.txt"
  write_file(path = src, content = "copy me")
  cp(src = src, dst = dst)
  let content = cat(dst)
  assert(content == "copy me")
}

test "mv moves file" {
  let src = "/tmp/vibe_shell_test_mv_src.txt"
  let dst = "/tmp/vibe_shell_test_mv_dst.txt"
  write_file(path = src, content = "move me")
  mv(src = src, dst = dst)
  let e = exists(src)
  assert(not(e))
  let content = cat(dst)
  assert(content == "move me")
}

test "append appends to file" {
  let path = "/tmp/vibe_shell_test_append.txt"
  write_file(path = path, content = "hello")
  append(path = path, content = " world")
  let content = cat(path)
  assert(content == "hello world")
}

test "exists checks file existence" {
  let path = "/tmp/vibe_shell_test_exists.txt"
  write_file(path = path, content = "x")
  let e = exists(path)
  assert(e)
  let e2 = exists("/tmp/vibe_shell_test_no_such_file_999.txt")
  assert(not(e2))
}

test "is_dir and is_file" {
  let dir = "/tmp/vibe_shell_test_isdir"
  let file = "/tmp/vibe_shell_test_isfile.txt"
  mkdir_p(dir)
  write_file(path = file, content = "x")
  let d = is_dir(dir)
  assert(d)
  let f = is_file(file)
  assert(f)
  let d2 = is_dir(file)
  assert(not(d2))
  let f2 = is_file(dir)
  assert(not(f2))
}

test "env reads environment variable" {
  let path_val = env("PATH")
  assert(String::length(path_val) > 0)
}

test "env_or returns fallback for missing var" {
  let val = env_or(name = "VIBE_SHELL_TEST_NONEXISTENT_VAR_12345", fallback = "default_value")
  assert(val == "default_value")
}

test "exec_lines returns output" {
  let result = exec_lines("echo hello")
  assert(Array::length(result) >= 1)
  assert(Array::get(result, at = 0) == "hello")
}

test "tee writes file and returns text" {
  let path = "/tmp/vibe_shell_test_tee.txt"
  let result = tee(text = "tee content", path = path)
  assert(result == "tee content")
  let content = cat(path)
  assert(content == "tee content")
}

test "find recursively lists entries" {
  let base = "/tmp/vibe_shell_test_find"
  mkdir_p("\{base}/sub")
  write_file(path = "\{base}/a.txt", content = "a")
  write_file(path = "\{base}/sub/b.txt", content = "b")
  let entries = find(base)
  assert(Array::length(entries) >= 3)
}

test "realpath resolves absolute path" {
  let resolved = realpath("/tmp")
  assert(String::starts_with(resolved, prefix = "/"))
}

test "realpath resolves with trailing component" {
  let resolved = realpath("/tmp/.")
  assert(String::contains(resolved, needle = "tmp"))
}
