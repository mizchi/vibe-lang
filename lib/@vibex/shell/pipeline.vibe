//# Imports

// #897 (ADR-0070 Phase 3): `FileEntry` is defined transparently in
// ./index.vpkg (the old ./types.vibe was deleted) — referenced here by name
// only (types are global in the merged program).

// #777: `Json::parse`/`Json::stringify`/`Json::get`/... below were written
// against the MoonBit host's builtin `Json` type (auto-imported methods).
// The selfhost `@vibe/json` package only ships Result-based primitives, so
// use the direct-value convenience wrappers in json_convenience.vibe instead
// (`Json::field` there, not `Json::get` — see that file's header comment for
// why the name differs).
// #897: directory form (not `../json/index.vibe`) — json is a .vpkg
// contract package now; a literal-filename import resolves exactly one
// candidate and breaks when the file is replaced.
import @vibe/json {
  Json::field, Json::index, Json::keys, Json::length, Json::number, Json::parse, Json::string, Json::stringify, Json::type_of
}

//# Functions

/// #777: `String::count`/`String::replace_all` (`../prelude/string.vibe`) are
/// real prelude functions, not checker builtins — normally that just means
/// "needs an explicit import" (same class of host-era rot as #742). But
/// importing EITHER of them into this file, together with `dirname`'s dynamic
/// string slice below, trips a real selfhost codegen bug: the imported
/// function's `let rec` + dynamic-slice body corrupts a WASM function
/// elsewhere in this compile unit ("not enough arguments on the stack for
/// call" at runtime instantiation, in a function that never even calls the
/// import). Reimplementing the two helpers locally (iteratively, no `let
/// rec`) sidesteps the bug without touching codegen. Tracked for a real fix;
/// do not reintroduce the prelude import here without re-testing.
fn pipeline_count(s: String, sub: String) -> Int {
  let s_len = String::length(s)
  let sub_len = String::length(sub)
  if sub_len == 0 || sub_len > s_len {
    0
  } else {
    let mut i = 0
    let mut acc = 0
    while i <= s_len - sub_len {
      if s[i: i + sub_len] == sub {
        acc = acc + 1
        i = i + sub_len
      } else {
        i = i + 1
      }
    }
    acc
  }
}

fn pipeline_replace_all(s: String, pattern: String, replacement: String) -> String {
  let pat_len = String::length(pattern)
  let s_len = String::length(s)
  if pat_len == 0 || pat_len > s_len {
    s
  } else {
    let sb = StringBuilder::new()
    let mut i = 0
    while i <= s_len - pat_len {
      if s[i: i + pat_len] == pattern {
        StringBuilder::push(sb, replacement)
        i = i + pat_len
      } else {
        StringBuilder::push(sb, s[i: i + 1])
        i = i + 1
      }
    }
    if i < s_len {
      StringBuilder::push(sb, s[i: s_len])
    }
    StringBuilder::freeze(sb)
  }
}

export fn jq(text: String, expr: String) -> String {
  let root = Json::parse(text)
  let e = if String::starts_with(expr, ".") {
    expr[1: String::length(expr)]
  } else expr
  if e == "" {
    Json::stringify(root)
  } else if e == "keys" {
    {
      let ks = Json::keys(root)
      let sb = StringBuilder::new()
      StringBuilder::push(sb, "[")
      let mut i = 0
      while i < Array::length(ks) {
        if i > 0 {
          StringBuilder::push(sb, ",")
        }
        StringBuilder::push(sb, "\"")
        StringBuilder::push(sb, Array::get(ks, i))
        StringBuilder::push(sb, "\"")
        i = i + 1
      }
      StringBuilder::push(sb, "]")
      StringBuilder::freeze(sb)
    }
  } else if e == "values" {
    {
      let ks = Json::keys(root)
      let sb = StringBuilder::new()
      StringBuilder::push(sb, "[")
      let mut i = 0
      while i < Array::length(ks) {
        if i > 0 {
          StringBuilder::push(sb, ",")
        }
        StringBuilder::push(sb, Json::stringify(Json::field(root, Array::get(ks, i))))
        i = i + 1
      }
      StringBuilder::push(sb, "]")
      StringBuilder::freeze(sb)
    }
  } else if e == "type" {
    {
      let sb = StringBuilder::new()
      StringBuilder::push(sb, "\"")
      StringBuilder::push(sb, Json::type_of(root))
      StringBuilder::push(sb, "\"")
      StringBuilder::freeze(sb)
    }
  } else if e == "length" {
    __to_string(Json::length(root))
  } else if String::starts_with(e, "[") {
    let close_idx = String::index_of(e, "]")
    let idx_str = e[1: close_idx]
    let idx_len = String::length(idx_str)
    let mut idx = 0
    let mut k = 0
    while k < idx_len {
      // #777: `idx_str[k]` (single-index) is an Int char code — compare
      // against char literals, not one-char strings.
      let c = idx_str[k]
      let d = if c == '0' {
        0
      }
      else if c == '1' {
        1
      }
      else if c == '2' {
        2
      }
      else if c == '3' {
        3
      }
      else if c == '4' {
        4
      }
      else if c == '5' {
        5
      }
      else if c == '6' {
        6
      }
      else if c == '7' {
        7
      }
      else if c == '8' {
        8
      }
      else 9
      idx = idx * 10 + d
      k = k + 1
    }
    Json::stringify(Json::index(root, idx))
  } else if String::contains(e, ".") {
    let parts = String::split(e, ".")
    let mut cur = root
    let mut i = 0
    while i < Array::length(parts) {
      cur = Json::field(cur, Array::get(parts, i))
      i = i + 1
    }
    Json::stringify(cur)
  } else Json::stringify(Json::field(root, e))
}

export fn nl(xs: Array[String], sep: String) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let mut i = 0
    while i < Array::length(xs) {
      let num = __to_string(i + 1)
      ArrayBuilder::push(result, "\{num}\{sep}\{Array::get(xs, i)}")
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export fn tr(text: String, src_chars: String, dst_chars: String) -> String {
  {
    let sb = StringBuilder::new()
    let len = String::length(text)
    let mut i = 0
    while i < len {
      // #777: `text[i]` (single-index) is an Int char code — `String::index_of`
      // needs the range-slice `text[i: i+1]` (String), not the Int.
      let ch_str = text[i: i + 1]
      let idx = String::index_of(src_chars, ch_str)
      if idx >= 0 {
        if idx < String::length(dst_chars) {
          StringBuilder::push(sb, dst_chars[idx: idx + 1])
        }
      } else StringBuilder::push(sb, ch_str)
      i = i + 1
    }
    StringBuilder::freeze(sb)
  }
}

export fn wc(text: String) -> Int {
  let trimmed = String::trim(text)
  if trimmed == "" {
    0
  } else {
    let parts = String::split(trimmed, " ")
    {
      let result = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(parts) {
        let p = String::trim(Array::get(parts, i))
        if not(p == "") {
          ArrayBuilder::push(result, p)
        }
        i = i + 1
      }
      Array::length(ArrayBuilder::freeze(result))
    }
  }
}

export fn cut(xs: Array[String], delim: String, field: Int) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let mut i = 0
    while i < Array::length(xs) {
      let parts = String::split(Array::get(xs, i), delim)
      if field >= 0 && field < Array::length(parts) {
        ArrayBuilder::push(result, Array::get(parts, field))
      } else ArrayBuilder::push(result, "")
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export fn len(text: String) -> Int {
  String::length(text)
}

export fn seq(first: Int, last: Int) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let mut i = first
    while i <= last {
      ArrayBuilder::push(result, __to_string(i))
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export fn grep(xs: Array[String], pattern: String) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let mut i = 0
    while i < Array::length(xs) {
      let line = Array::get(xs, i)
      if String::contains(line, pattern) {
        ArrayBuilder::push(result, line)
      }
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export fn trim(text: String) -> String {
  String::trim(text)
}

export fn uniq(xs: Array[String]) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let len = Array::length(xs)
    let mut i = 0
    while i < len {
      let item = Array::get(xs, i)
      if i == 0 {
        ArrayBuilder::push(result, item)
      } else if not(item == Array::get(xs, i - 1)) {
        ArrayBuilder::push(result, item)
      }
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export fn wc_l(text: String) -> Int {
  if text == "" {
    0
  } else {
    let ls = String::split(text, "\n")
    Array::length(ls)
  }
}

export fn count(text: String, sub: String) -> Int {
  pipeline_count(text, sub)
}

export fn lines(text: String) -> Array[String] {
  String::split(text, "\n")
}

/// #777: `String::to_lower`/`String::to_upper` are declared as checker
/// builtins (checker/builtins_string2.vibe) but have NO codegen backing
/// anywhere (linear or wasm-gc) — calling them fails at codegen with
/// "undefined variable (local)" once the checker's builtin stub falls
/// through. `../prelude/string.vibe`'s own `String::to_lower`/`to_upper`
/// wrappers are self-recursive (call themselves) for the same reason, so
/// importing them would not help either. ASCII-only case conversion done
/// manually here via `char_code_at`/`from_char_code`, both of which ARE
/// implemented.
fn pipeline_to_lower(s: String) -> String {
  let len = String::length(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    let c = String::char_code_at(s, i)
    let c2 = if c >= 65 && c <= 90 {
      c + 32
    } else c
    StringBuilder::push(sb, String::from_char_code(c2))
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

fn pipeline_to_upper(s: String) -> String {
  let len = String::length(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    let c = String::char_code_at(s, i)
    let c2 = if c >= 97 && c <= 122 {
      c - 32
    } else c
    StringBuilder::push(sb, String::from_char_code(c2))
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

export fn lower(text: String) -> String {
  pipeline_to_lower(text)
}

export fn paste(xs: Array[String], ys: Array[String], sep: String) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let len_x = Array::length(xs)
    let len_y = Array::length(ys)
    let max_len = if len_x > len_y {
      len_x
    } else len_y
    let mut i = 0
    while i < max_len {
      let x = if i < len_x {
        Array::get(xs, i)
      } else ""
      let y = if i < len_y {
        Array::get(ys, i)
      } else ""
      ArrayBuilder::push(result, "\{x}\{sep}\{y}")
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export fn split(text: String, sep: String) -> Array[String] {
  String::split(text, sep)
}

export fn upper(text: String) -> String {
  pipeline_to_upper(text)
}

export fn expand(text: String, tab_width: Int) -> String {
  {
    let sb = StringBuilder::new()
    let len = String::length(text)
    let spaces_sb = StringBuilder::new()
    let mut s = 0
    while s < tab_width {
      StringBuilder::push(spaces_sb, " ")
      s = s + 1
    }
    let spaces = StringBuilder::freeze(spaces_sb)
    let mut i = 0
    while i < len {
      // #777: `text[i]` (single-index) is an Int char code — compare against
      // a char literal, and use the range-slice for the raw-char push.
      let ch = text[i]
      if ch == '\t' {
        StringBuilder::push(sb, spaces)
      } else StringBuilder::push(sb, text[i: i + 1])
      i = i + 1
    }
    StringBuilder::freeze(sb)
  }
}

export fn jq_arr(text: String) -> Array[String] {
  {
    let j = Json::parse(text)
    let n = Json::length(j)
    let result = ArrayBuilder::new()
    let mut i = 0
    while i < n {
      ArrayBuilder::push(result, Json::stringify(Json::index(j, i)))
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export fn jq_num(text: String, expr: String) -> Double {
  Json::number(Json::parse(jq(text, expr)))
}

export fn jq_str(text: String, expr: String) -> String {
  Json::string(Json::parse(jq(text, expr)))
}

export fn char_at(text: String, idx: Int) -> String {
  // #777: `text[idx]` (single-index) is an Int char code — this function's
  // declared return type is String, so slice instead.
  text[idx: idx + 1]
}

export fn dirname(path: String) -> String {
  let idx = String::last_index_of(path, "/")
  if idx < 0 {
    "."
  } else if idx == 0 {
    "/"
  } else path[0: idx]
}

export fn grep_re(xs: Array[String], pattern: String) -> Array[String] with Process {
  let text = String::join(xs, "\n")
  if text == "" {
    xs
  } else {
    let escaped_text = pipeline_replace_all(text, "'", "'\\''")
    let escaped_pattern = pipeline_replace_all(pattern, "'", "'\\''")
    sh_lines("printf '%s' '\{escaped_text}' | grep -E '\{escaped_pattern}'")
  }
}

export fn replace(text: String, pattern: String, replacement: String) -> String {
  pipeline_replace_all(text, pattern, replacement)
}

export fn rev_str(xs: Array[String]) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let len = Array::length(xs)
    let mut i = len - 1
    while i >= 0 {
      ArrayBuilder::push(result, Array::get(xs, i))
      i = i - 1
    }
    ArrayBuilder::freeze(result)
  }
}

export fn tac(text: String) -> String {
  let ls = String::split(text, "\n")
  let reversed = rev_str(ls)
  String::join(reversed, "\n")
}

export fn basename(path: String) -> String {
  let idx = String::last_index_of(path, "/")
  if idx < 0 {
    path
  } else path[idx + 1: String::length(path)]
}

export fn extname(path: String) -> String {
  let base = basename(path)
  let idx = String::last_index_of(base, ".")
  if idx <= 0 {
    ""
  } else base[idx: String::length(base)]
}

export fn index_of(text: String, sub: String) -> Int {
  String::index_of(text, sub)
}

export fn join_str(xs: Array[String], sep: String) -> String {
  String::join(xs, sep)
}

export fn seq_step(first: Int, incr: Int, last: Int) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let mut i = first
    if incr > 0 {
      while i <= last {
        ArrayBuilder::push(result, __to_string(i))
        i = i + incr
      }
    } else if incr < 0 {
      while i >= last {
        ArrayBuilder::push(result, __to_string(i))
        i = i + incr
      }
    }
    ArrayBuilder::freeze(result)
  }
}

/// #768/#1184: keep Array-sourced operands behind typed String parameters so
/// the relational operator is lowered as a lexical String comparison.
fn str_lex_lt(a: String, b: String) -> Bool {
  a < b
}

export fn sort_str(xs: Array[String]) -> Array[String] {
  let len = Array::length(xs)
  let arr = xs[0: len]
  let mut i2 = 1
  while i2 < len {
    let key = Array::get(arr, i2)
    let mut j = i2 - 1
    while j >= 0 {
      if str_lex_lt(key, Array::get(arr, j)) {
        arr[j + 1] = Array::get(arr, j)
        j = j - 1
      } else break
    }
    arr[j + 1] = key
    i2 = i2 + 1
  }
  arr
}

fn clamp_int(value: Int, lower: Int, upper: Int) -> Int {
  if value < lower {
    lower
  } else if value > upper {
    upper
  } else value
}

export fn drop_str(xs: Array[String], n: Int) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let len = Array::length(xs)
    let start = clamp_int(n, 0, len)
    let mut i = start
    while i < len {
      ArrayBuilder::push(result, Array::get(xs, i))
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export fn tail_str(xs: Array[String], n: Int) -> Array[String] {
  {
    let result = ArrayBuilder::new()
    let len = Array::length(xs)
    let keep = clamp_int(n, 0, len)
    let start = if len > keep {
      len - keep
    } else 0
    let mut i = start
    while i < len {
      ArrayBuilder::push(result, Array::get(xs, i))
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export fn count_str(xs: Array[String]) -> Int {
  Array::length(xs)
}

export fn ends_with(text: String, suffix: String) -> Bool {
  String::ends_with(text, suffix)
}

fn array_take[T](xs: Array[T], n: Int) -> Array[T] {
  {
    let result = ArrayBuilder::new()
    let len = Array::length(xs)
    let limit = clamp_int(n, 0, len)
    let mut i = 0
    while i < limit {
      ArrayBuilder::push(result, Array::get(xs, i))
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export fn take_str(xs: Array[String], n: Int) -> Array[String] {
  array_take(xs, n)
}

export fn head_str(xs: Array[String], n: Int) -> Array[String] {
  take_str(xs, n)
}

export fn repeat_str(text: String, n: Int) -> String {
  {
    let sb = StringBuilder::new()
    let mut i = 0
    while i < n {
      StringBuilder::push(sb, text)
      i = i + 1
    }
    StringBuilder::freeze(sb)
  }
}

export fn starts_with(text: String, prefix: String) -> Bool {
  String::starts_with(text, prefix)
}

export fn contains_str(text: String, sub: String) -> Bool {
  String::contains(text, sub)
}

export fn take_entries(xs: Array[FileEntry], n: Int) -> Array[FileEntry] {
  array_take(xs, n)
}

export fn count_entries(xs: Array[FileEntry]) -> Int {
  Array::length(xs)
}

export fn last_index_of(text: String, sub: String) -> Int {
  String::last_index_of(text, sub)
}

fn build_pad_prefix(needed: Int, pad: String) -> String {
  if needed <= 0 {
    ""
  } else {
    let pad_len = String::length(pad)
    if pad_len <= 0 {
      ""
    } else {
      let sb = StringBuilder::new()
      let mut remaining = needed
      while remaining >= pad_len {
        StringBuilder::push(sb, pad)
        remaining = remaining - pad_len
      }
      if remaining > 0 {
        StringBuilder::push(sb, pad[0: remaining])
      }
      StringBuilder::freeze(sb)
    }
  }
}

export fn pad_left(text: String, width: Int, pad: String) -> String {
  let text_len = String::length(text)
  if text_len >= width {
    text
  } else {
    let needed = width - text_len
    let prefix = build_pad_prefix(needed, pad)
    "\{prefix}\{text}"
  }
}

export fn pad_right(text: String, width: Int, pad: String) -> String {
  let text_len = String::length(text)
  if text_len >= width {
    text
  } else {
    let needed = width - text_len
    let suffix = build_pad_prefix(needed, pad)
    "\{text}\{suffix}"
  }
}

fn pipeline_arr_map[A, B](xs: Array[A], f: (A) -> B) -> Array[B] {
  {
    let result = ArrayBuilder::new()
    let len = Array::length(xs)
    let mut i = 0
    while i < len {
      ArrayBuilder::push(result, f(Array::get(xs, i)))
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export fn names(entries: Array[FileEntry]) -> Array[String] {
  pipeline_arr_map(entries, (entry: FileEntry) -> String {
    entry.name
  })
}

export fn map_str(xs: Array[String], f: (String) -> String) -> Array[String] {
  pipeline_arr_map(xs, f)
}

fn pipeline_arr_filter[T](xs: Array[T], pred: (T) -> Bool) -> Array[T] {
  {
    let result = ArrayBuilder::new()
    let len = Array::length(xs)
    let mut i = 0
    while i < len {
      let item = Array::get(xs, i)
      if pred(item) {
        ArrayBuilder::push(result, item)
      }
      i = i + 1
    }
    ArrayBuilder::freeze(result)
  }
}

export fn filter_str(xs: Array[String], f: (String) -> Bool) -> Array[String] {
  pipeline_arr_filter(xs, f)
}

export fn where_entry(entries: Array[FileEntry], pred: (FileEntry) -> Bool) -> Array[FileEntry] {
  pipeline_arr_filter(entries, pred)
}
