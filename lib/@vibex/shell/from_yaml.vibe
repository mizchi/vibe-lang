//# Imports

// #777: `Json::parse`/... were written against the MoonBit host's builtin
// `Json` type (auto-imported methods); the selfhost `@vibe/json` package
// only ships Result-based primitives, so use the direct-value convenience
// wrappers in json_convenience.vibe instead.
// #897: directory form (not `../json/index.vibe`) — json is a .vpkg
// contract package now.
// #1841: `String::replace_all` was reimplemented locally here to sidestep a
// selfhost miscompile that no longer reproduces (the trigger was rewritten in
// #1092); the prelude import is restored. See pipeline.vibe for the pinned
// regression shape.
import @vibe/builtin {
  String::replace_all
}

import @vibe/json {
  Json::parse
}

//# Functions

/// #777: `ch: String` was wrong — every call site passes `s[i]` (single-
/// index), which is an Int char code, not a one-char String. Fixed the
/// parameter type and the literal comparisons to match (char literals, not
/// one-char strings).
fn _yaml_is_digit(ch: Int) -> Bool {
  if ch == '0' {
    true
  }
  else if ch == '1' {
    true
  }
  else if ch == '2' {
    true
  }
  else if ch == '3' {
    true
  }
  else if ch == '4' {
    true
  }
  else if ch == '5' {
    true
  }
  else if ch == '6' {
    true
  }
  else if ch == '7' {
    true
  }
  else if ch == '8' {
    true
  }
  else if ch == '9' {
    true
  }
  else false
}

fn _yaml_is_number(s: String) -> Bool {
  let len = String::length(s)
  if len == 0 {
    false
  } else {
    let mut start = 0
    let first = s[0: 1]
    if first == "-" {
      if len == 1 {
        start = -1
      }
      if len > 1 {
        start = 1
      }
    }
    if start < 0 {
      false
    } else {
      let mut i = start
      let mut valid = true
      let mut has_dot = false
      while i < len {
        let ch = s[i]
        if ch == '.' {
          if has_dot {
            valid = false
          }
          has_dot = true
        }
        if not(ch == '.') {
          if not(_yaml_is_digit(ch)) {
            valid = false
          }
        }
        i = i + 1
      }
      valid
    }
  }
}

fn _yaml_find_colon(line: String) -> Int {
  let len = String::length(line)
  let mut i = 0
  let mut in_sq = false
  let mut in_dq = false
  let mut found = -1
  while i < len {
    let ch = line[i]
    let was_sq = in_sq
    let was_dq = in_dq
    if was_sq {
      if ch == '\'' {
        in_sq = false
      }
    }
    if not(was_sq) {
      if was_dq {
        if ch == '"' {
          in_dq = false
        }
      }
    }
    if not(was_sq) {
      if not(was_dq) {
        if ch == '\'' {
          in_sq = true
        }
        if ch == '"' {
          in_dq = true
        }
        if ch == ':' {
          if found < 0 {
            if i + 1 >= len {
              found = i
            }
            if i + 1 < len {
              let next = line[i + 1: i + 2]
              if next == " " {
                found = i
              }
            }
          }
        }
      }
    }
    i = i + 1
  }
  found
}

fn _yaml_escape_json(s: String) -> String {
  {
    let sb = StringBuilder::new()
    let len = String::length(s)
    let mut i = 0
    while i < len {
      // #777: `s[i]` is an Int char code — compare against char literals,
      // and use the range-slice for the raw-char push.
      let ch = s[i]
      if ch == '\\' {
        StringBuilder::push(sb, "\\\\")
      }
      if ch == '"' {
        StringBuilder::push(sb, "\\\"")
      }
      if ch == '\n' {
        StringBuilder::push(sb, "\\n")
      }
      if ch == '\t' {
        StringBuilder::push(sb, "\\t")
      }
      if not(ch == '\\') {
        if not(ch == '"') {
          if not(ch == '\n') {
            if not(ch == '\t') {
              StringBuilder::push(sb, s[i: i + 1])
            }
          }
        }
      }
      i = i + 1
    }
    StringBuilder::freeze(sb)
  }
}

fn _yaml_count_indent(line: String) -> Int {
  let len = String::length(line)
  let mut i = 0
  let mut result = -1
  while i < len {
    if result < 0 {
      let ch = line[i]
      if not(ch == ' ') {
        result = i
      }
    }
    i = i + 1
  }
  if result < 0 {
    len
  } else result
}

fn _yaml_strip_comment(line: String) -> String {
  let len = String::length(line)
  let mut i = 0
  let mut in_sq = false
  let mut in_dq = false
  let mut result_end = len
  while i < len {
    let ch = line[i]
    let was_sq = in_sq
    let was_dq = in_dq
    if was_sq {
      if ch == '\'' {
        in_sq = false
      }
    }
    if not(was_sq) {
      if was_dq {
        if ch == '"' {
          in_dq = false
        }
      }
    }
    if not(was_sq) {
      if not(was_dq) {
        if ch == '\'' {
          in_sq = true
        }
        if ch == '"' {
          in_dq = true
        }
        if ch == '#' {
          if result_end == len {
            if i == 0 {
              result_end = 0
            }
            if i > 0 {
              let prev = line[i - 1: i]
              if prev == " " {
                result_end = i
              }
            }
          }
        }
      }
    }
    i = i + 1
  }
  if result_end == len {
    line
  } else String::trim(line[0: result_end])
}

fn _yaml_scalar_to_json(s: String) -> String {
  let trimmed = String::trim(s)
  if trimmed == "true" {
    "true"
  } else if trimmed == "false" {
    "false"
  } else if trimmed == "null" {
    "null"
  } else if trimmed == "~" {
    "null"
  } else if trimmed == "" {
    "null"
  } else if _yaml_is_number(trimmed) {
    trimmed
  } else {
    let len = String::length(trimmed)
    let first = trimmed[0: 1]
    let last = trimmed[len - 1: len]
    if first == "\"" {
      if last == "\"" {
        let inner = trimmed[1: len - 1]
        {
          let sb = StringBuilder::new()
          StringBuilder::push(sb, "\"")
          StringBuilder::push(sb, _yaml_escape_json(inner))
          StringBuilder::push(sb, "\"")
          StringBuilder::freeze(sb)
        }
      } else {
        let sb = StringBuilder::new()
        StringBuilder::push(sb, "\"")
        StringBuilder::push(sb, _yaml_escape_json(trimmed))
        StringBuilder::push(sb, "\"")
        StringBuilder::freeze(sb)
      }
    } else if first == "'" {
      if last == "'" {
        let inner = trimmed[1: len - 1]
        {
          let sb = StringBuilder::new()
          StringBuilder::push(sb, "\"")
          StringBuilder::push(sb, _yaml_escape_json(inner))
          StringBuilder::push(sb, "\"")
          StringBuilder::freeze(sb)
        }
      } else {
        let sb = StringBuilder::new()
        StringBuilder::push(sb, "\"")
        StringBuilder::push(sb, _yaml_escape_json(trimmed))
        StringBuilder::push(sb, "\"")
        StringBuilder::freeze(sb)
      }
    } else {
      let sb = StringBuilder::new()
      StringBuilder::push(sb, "\"")
      StringBuilder::push(sb, _yaml_escape_json(trimmed))
      StringBuilder::push(sb, "\"")
      StringBuilder::freeze(sb)
    }
  }
}

fn _yaml_parse_block(lines_arr: Array[String], indents_arr: Array[Int], num_lines: Int, cursor: Array[Int], base_indent: Int) -> String {
  let idx = Array::get(cursor, 0)
  if idx >= num_lines {
    "null"
  } else {
    let line = Array::get(lines_arr, idx)
    let trimmed = String::trim(line)
    let content = trimmed[0: String::length(trimmed)]
    if String::starts_with(content, "- ") {
      {
        let sb = StringBuilder::new()
        StringBuilder::push(sb, "[")
        let mut first = true
        while Array::get(cursor, 0) < num_lines {
          let ci = Array::get(cursor, 0)
          let cur_indent = Array::get(indents_arr, ci)
          let mut skip_line = false
          if cur_indent < base_indent {
            cursor[0] = num_lines + ci + 1
            skip_line = true
          }
          if cur_indent > base_indent {
            if not(skip_line) {
              cursor[0] = num_lines + ci + 1
              skip_line = true
            }
          }
          if not(skip_line) {
            let cur_line = Array::get(lines_arr, ci)
            let cur_trimmed = String::trim(cur_line)
            if not(String::starts_with(cur_trimmed, "- ")) {
              cursor[0] = num_lines + ci + 1
            }
            if String::starts_with(cur_trimmed, "- ") {
              if not(first) {
                StringBuilder::push(sb, ",")
              }
              first = false
              let item_str = cur_trimmed[2: String::length(cur_trimmed)]
              let colon_pos = _yaml_find_colon(item_str)
              cursor[0] = ci + 1
              if colon_pos >= 0 {
                let item_key = String::trim(item_str[0: colon_pos])
                let item_val_str = String::trim(item_str[colon_pos + 1: String::length(item_str)])
                if item_val_str == "" {
                  let item_cursor_ok = Array::get(cursor, 0) < num_lines
                  let item_indent_ok = if item_cursor_ok {
                    Array::get(indents_arr, Array::get(cursor, 0)) > cur_indent
                  } else false
                  if item_indent_ok {
                    let next_ind2 = Array::get(indents_arr, Array::get(cursor, 0))
                    let sub = _yaml_parse_block(lines_arr, indents_arr, num_lines, cursor, next_ind2)
                    StringBuilder::push(sb, "{\"")
                    StringBuilder::push(sb, _yaml_escape_json(item_key))
                    StringBuilder::push(sb, "\":")
                    StringBuilder::push(sb, sub)
                    StringBuilder::push(sb, "}")
                  }
                  if not(item_indent_ok) {
                    StringBuilder::push(sb, "{\"")
                    StringBuilder::push(sb, _yaml_escape_json(item_key))
                    StringBuilder::push(sb, "\":null}")
                  }
                }
                if not(item_val_str == "") {
                  StringBuilder::push(sb, "{\"")
                  StringBuilder::push(sb, _yaml_escape_json(item_key))
                  StringBuilder::push(sb, "\":")
                  StringBuilder::push(sb, _yaml_scalar_to_json(item_val_str))
                  StringBuilder::push(sb, "}")
                }
              }
              if not(colon_pos >= 0) {
                let scalar_cursor_ok = Array::get(cursor, 0) < num_lines
                let scalar_indent_ok = if scalar_cursor_ok {
                  Array::get(indents_arr, Array::get(cursor, 0)) > cur_indent
                } else false
                if scalar_indent_ok {
                  let next_ind3 = Array::get(indents_arr, Array::get(cursor, 0))
                  let sub2 = _yaml_parse_block(lines_arr, indents_arr, num_lines, cursor, next_ind3)
                  StringBuilder::push(sb, sub2)
                }
                if not(scalar_indent_ok) {
                  StringBuilder::push(sb, _yaml_scalar_to_json(item_str))
                }
              }
            }
          }
        }
        if Array::get(cursor, 0) > num_lines {
          let real_cursor = Array::get(cursor, 0) - num_lines - 1
          cursor[0] = real_cursor
        }
        StringBuilder::push(sb, "]")
        StringBuilder::freeze(sb)
      }
    } else {
      let colon_pos = _yaml_find_colon(content)
      if colon_pos >= 0 {
        {
          let sb = StringBuilder::new()
          StringBuilder::push(sb, "{")
          let mut first = true
          while Array::get(cursor, 0) < num_lines {
            let ci = Array::get(cursor, 0)
            let cur_indent = Array::get(indents_arr, ci)
            let mut skip_line = false
            if cur_indent < base_indent {
              cursor[0] = num_lines + ci + 1
              skip_line = true
            }
            if cur_indent > base_indent {
              if not(skip_line) {
                cursor[0] = num_lines + ci + 1
                skip_line = true
              }
            }
            if not(skip_line) {
              let cur_line = Array::get(lines_arr, ci)
              let cur_trimmed = String::trim(cur_line)
              let cp = _yaml_find_colon(cur_trimmed)
              if cp < 0 {
                cursor[0] = num_lines + ci + 1
              }
              if cp >= 0 {
                if not(first) {
                  StringBuilder::push(sb, ",")
                }
                first = false
                let key = String::trim(cur_trimmed[0: cp])
                let val_str = String::trim(cur_trimmed[cp + 1: String::length(cur_trimmed)])
                cursor[0] = ci + 1
                if val_str == "" {
                  let cursor_ok = Array::get(cursor, 0) < num_lines
                  let indent_ok = if cursor_ok {
                    Array::get(indents_arr, Array::get(cursor, 0)) > base_indent
                  } else false
                  if indent_ok {
                    let next_ind = Array::get(indents_arr, Array::get(cursor, 0))
                    let sub = _yaml_parse_block(lines_arr, indents_arr, num_lines, cursor, next_ind)
                    StringBuilder::push(sb, "\"")
                    StringBuilder::push(sb, _yaml_escape_json(key))
                    StringBuilder::push(sb, "\":")
                    StringBuilder::push(sb, sub)
                  }
                  if not(indent_ok) {
                    StringBuilder::push(sb, "\"")
                    StringBuilder::push(sb, _yaml_escape_json(key))
                    StringBuilder::push(sb, "\":null")
                  }
                }
                if not(val_str == "") {
                  StringBuilder::push(sb, "\"")
                  StringBuilder::push(sb, _yaml_escape_json(key))
                  StringBuilder::push(sb, "\":")
                  StringBuilder::push(sb, _yaml_scalar_to_json(val_str))
                }
              }
            }
          }
          if Array::get(cursor, 0) > num_lines {
            let real_cursor = Array::get(cursor, 0) - num_lines - 1
            cursor[0] = real_cursor
          }
          StringBuilder::push(sb, "}")
          StringBuilder::freeze(sb)
        }
      } else {
        cursor[0] = idx + 1
        _yaml_scalar_to_json(content)
      }
    }
  }
}

export fn from_yaml(text: String) -> Json {
  let cr = String::from_char_code(13)
  let cleaned = String::replace_all(text, cr, "")
  let raw_lines = String::split(cleaned, "\n")
  let num_raw = Array::length(raw_lines)
  {
    let lines_b = ArrayBuilder::new()
    let indents_b = ArrayBuilder::new()
    let mut i = 0
    while i < num_raw {
      let line = Array::get(raw_lines, i)
      let stripped = _yaml_strip_comment(line)
      let trimmed = String::trim(stripped)
      if not(trimmed == "") {
        ArrayBuilder::push(lines_b, stripped)
        ArrayBuilder::push(indents_b, _yaml_count_indent(stripped))
      }
      i = i + 1
    }
    let lines_arr = ArrayBuilder::freeze(lines_b)
    let indents_arr = ArrayBuilder::freeze(indents_b)
    let num_lines = Array::length(lines_arr)
    if num_lines == 0 {
      Json::parse("null")
    } else {
      let base = Array::get(indents_arr, 0)
      let cursor = [0]
      Json::parse(_yaml_parse_block(lines_arr, indents_arr, num_lines, cursor, base))
    }
  }
}
