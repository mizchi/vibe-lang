//# Imports

// #897: retargeted from direct impl-file imports to the package directory —
// pipeline.vibe references `FileEntry`, whose transparent definition now
// lives in index.vpkg's facade; a direct impl-file import would merge
// pipeline.vibe without that definition.
import .{
  diff_files, du, glob, grep_re, tree, which
}

//# Misc

test "tree returns directory listing" {
  let dir = "/tmp/vibe_tree_test_2"
  // #777: `Fs::mkdir_p` is a checker-only stub with no codegen (same class
  // as the tracked #768 Fs-effect-capability gap) — shell out to the real
  // `mkdir -p` via `sh_lines` (fixed for #777) instead.
  sh_lines("mkdir -p \{dir}/sub")
  Fs::write_file("\{dir}/file.txt", "x")
  let output = tree(dir)
  assert(String::contains(output, "file.txt"))
  assert(String::contains(output, "sub"))
}

test "which finds ls" {
  let path = which("ls")
  assert(String::length(path) > 0)
}

test "du returns output" {
  let result = du("/tmp")
  assert(Array::length(result) > 0)
}

test "glob matches txt files" {
  let dir = "/tmp/vibe_glob_test_3"
  sh_lines("mkdir -p \{dir}")
  Fs::write_file("\{dir}/a.txt", "a")
  Fs::write_file("\{dir}/b.txt", "b")
  Fs::write_file("\{dir}/c.md", "c")
  let result = glob("\{dir}/*.txt")
  assert(Array::length(result) == 2)
}

test "glob star pattern" {
  let dir = "/tmp/vibe_glob_test_3"
  let result = glob("\{dir}/*")
  assert(Array::length(result) >= 3)
}

test "glob question mark" {
  let dir = "/tmp/vibe_glob_test_3"
  let result = glob("\{dir}/?.txt")
  assert(Array::length(result) == 2)
}

test "grep_re filters with regex" {
  let input = ["hello world", "foo bar", "hello foo", "baz"]
  let result = grep_re(input, "^hello")
  assert(Array::length(result) == 2)
}

test "diff_files same files returns empty" {
  let a = "/tmp/vibe_diff_same.txt"
  Fs::write_file(a, "line1\nline2\n")
  let result = diff_files(a, a)
  assert(Array::length(result) == 0)
}
