//# Misc

test "sh_lines: echo hello" {
  let lines = sh_lines("echo hello")
  assert(Array::length(lines) == 1)
  assert(Array::get(lines, 0) == "hello")
}

test "sh_lines: echo with multiple words" {
  let lines = sh_lines("echo foo bar baz")
  assert(Array::length(lines) == 1)
  assert(Array::get(lines, 0) == "foo bar baz")
}

test "sh_lines: printf multiline" {
  let lines = sh_lines("printf 'line1\nline2\nline3'")
  assert(Array::length(lines) == 3)
  assert(Array::get(lines, 0) == "line1")
  assert(Array::get(lines, 1) == "line2")
  assert(Array::get(lines, 2) == "line3")
}

test "sh_lines: ls /tmp (directory listing)" {
  let lines = sh_lines("ls /tmp")
  assert(Array::length(lines) > 0)
}

test "sh_lines: ls -a (short flag)" {
  let lines = sh_lines("ls", a = true)
  let mut found_dot = false
  let mut i = 0
  while i < Array::length(lines) {
    if Array::get(lines, i) == "." {
      found_dot = true
    }
    i = i + 1
  }
  assert(found_dot)
}

test "sh_lines: ls -a -l (multiple short flags)" {
  let lines = sh_lines("ls", a = true, l = true)
  assert(Array::length(lines) > 0)
}

test "sh_lines: ls -a repeated (flag idempotent)" {
  let lines_a = sh_lines("ls", a = true)
  let lines_a2 = sh_lines("ls", a = true)
  assert(Array::length(lines_a) == Array::length(lines_a2))
}

test "sh_lines: cat with pipe" {
  let lines = sh_lines("echo hello | cat")
  assert(Array::length(lines) == 1)
  assert(Array::get(lines, 0) == "hello")
}

test "sh_lines: wc -l (short flag with pipe)" {
  let lines = sh_lines("printf 'a\nb\nc'", l = true)
  assert(Array::length(lines) >= 1)
}

test "sh_lines: which echo (command lookup)" {
  let lines = sh_lines("which echo")
  assert(Array::length(lines) >= 1)
  assert(String::contains(Array::get(lines, 0), "echo"))
}

test "sh_lines: date command" {
  let lines = sh_lines("date +%Y")
  assert(Array::length(lines) == 1)
  assert(String::length(Array::get(lines, 0)) == 4)
}

test "sh_lines: uname (system info)" {
  let lines = sh_lines("uname")
  assert(Array::length(lines) == 1)
  assert(String::length(Array::get(lines, 0)) > 0)
}

test "sh_lines: seq (number sequence)" {
  let lines = sh_lines("seq 1 5")
  assert(Array::length(lines) == 5)
  assert(Array::get(lines, 0) == "1")
  assert(Array::get(lines, 4) == "5")
}

test "sh_lines: grep with pipe" {
  let lines = sh_lines("echo -e 'apple\nbanana\ncherry' | grep an")
  assert(Array::length(lines) == 1)
  assert(Array::get(lines, 0) == "banana")
}

test "sh_lines: head (first lines)" {
  let lines = sh_lines("seq 1 10 | head -3")
  assert(Array::length(lines) == 3)
  assert(Array::get(lines, 0) == "1")
  assert(Array::get(lines, 2) == "3")
}

test "sh_lines: tail (last lines)" {
  let lines = sh_lines("seq 1 10 | tail -3")
  assert(Array::length(lines) == 3)
  assert(Array::get(lines, 0) == "8")
  assert(Array::get(lines, 2) == "10")
}

test "sh_lines: sort" {
  let lines = sh_lines("printf 'cherry\napple\nbanana' | sort")
  assert(Array::length(lines) == 3)
  assert(Array::get(lines, 0) == "apple")
  assert(Array::get(lines, 1) == "banana")
  assert(Array::get(lines, 2) == "cherry")
}

test "sh_lines: sort -r (reverse sort with flag)" {
  let lines = sh_lines("printf 'cherry\napple\nbanana' | sort -r")
  assert(Array::length(lines) == 3)
  assert(Array::get(lines, 0) == "cherry")
  assert(Array::get(lines, 1) == "banana")
  assert(Array::get(lines, 2) == "apple")
}

test "sh_lines: uniq (remove duplicates)" {
  let lines = sh_lines("printf 'a\na\nb\nb\nc' | uniq")
  assert(Array::length(lines) == 3)
  assert(Array::get(lines, 0) == "a")
  assert(Array::get(lines, 1) == "b")
  assert(Array::get(lines, 2) == "c")
}

test "sh_lines: wc -l via pipe" {
  let lines = sh_lines("printf 'a\nb\nc\n' | wc -l")
  assert(Array::length(lines) == 1)
  assert(String::contains(Array::get(lines, 0), "3"))
}

test "sh_lines: tr (character translation)" {
  let lines = sh_lines("echo hello | tr 'a-z' 'A-Z'")
  assert(Array::length(lines) == 1)
  assert(Array::get(lines, 0) == "HELLO")
}

test "sh_lines: cut (field extraction)" {
  let lines = sh_lines("echo 'a:b:c' | cut -d: -f2")
  assert(Array::length(lines) == 1)
  assert(Array::get(lines, 0) == "b")
}

test "sh_lines: env (environment variable)" {
  let lines = sh_lines("echo $HOME")
  assert(Array::length(lines) == 1)
  assert(String::contains(Array::get(lines, 0), "/"))
}

test "sh_lines: pwd (working directory)" {
  let lines = sh_lines("pwd")
  assert(Array::length(lines) == 1)
  assert(String::contains(Array::get(lines, 0), "/"))
}
