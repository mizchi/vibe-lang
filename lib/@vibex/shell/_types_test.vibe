//# Imports

// #897: retargeted from ./types.vibe (deleted) to the package directory —
// `FileEntry`'s transparent definition now lives in index.vpkg's facade.
import .{
  struct FileEntry
}

//# Misc

test "FileEntry struct" {
  let entry = FileEntry::{
    name: "test",
    path: "/test",
    is_dir: false
  }
  assert(entry.name == "test")
}
