name = @vibex/z3_wasi
version = 0.0.1
description =
  #|@vibex/z3_wasi — z3 linked in-process through the typed core-wasm import
  #|of z3_wasi.wasm, and the `vibe check --prove --solver=wasm` prover over it.
deps = {
  @vibe/lsp : 0.0.1
  @vibe/prove : 0.0.1
}

generated_hash =

// @vibex/z3_wasi — z3 in the same process as the program (#3719, ADR-0121).
// z3_wasi.wasm is built by scripts/build_z3_wasi.sh (single-threaded, wasm
// exceptions, no imports) and is not committed. prove_main.vibex is the entry
// `vibe check --prove --solver=wasm` runs.

fn eval_smtlib2_fresh(_ script: String) -> String with Exception
fn z3_wasi_version() -> String with Exception
fn prove_source_in_process(_ source: String) -> Array[(Int, String)] with Exception
fn prove_files_in_process(paths: Array[String], json: Bool, root: String) -> Int with Exception + Fs + Console
let prove_rlimit: Int
