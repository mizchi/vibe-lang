// The entry `vibe check --prove --solver=wasm` runs (#3719): the prover and
// z3_wasi.wasm in one process. Its arguments are
// `[--json] [--root DIR] <file>...`: a relative file is read under DIR.
import ./prove_in_process.vibe {
  prove_files_in_process
}

fn main() -> Unit allows Env + Fs + Console + Process::exit + Exception {
  let paths: Array[String] = []
  let mut json = false
  let mut root = ""
  let mut i = 0
  while i < Env::args_len() {
    let a = Env::args_get(i)
    if a == "--json" {
      json = true
    } else if a == "--root" && i + 1 < Env::args_len() {
      i = i + 1
      root = Env::args_get(i)
    } else {
      Array::push(paths, value = a)
    }
    i = i + 1
  }
  Process::exit(prove_files_in_process(paths = paths, json = json, root = root))
}
