//# Imports

import . {
  BigInt::from_int, BigInt::parse, BigInt::to_string, BigInt::mul, BigInt::equals
}

//# Misc

test "x/bigint index exports the BigInt API" {
  let two32 = BigInt::from_int(4294967296)
  let p64 = BigInt::mul(two32, two32)
  assert(BigInt::to_string(p64) == "18446744073709551616")
  match BigInt::parse("18446744073709551616") {
    Some(parsed) => assert(BigInt::equals(parsed, p64)),
    None => assert(false)
  }
}
