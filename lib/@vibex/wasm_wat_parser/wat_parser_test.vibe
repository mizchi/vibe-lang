test "rs: string hex escape" {
  // \01 = byte 1
  let src = "\"\\01\""
  let decoded = decode_string(token_text(src, Array::get(filter_tokens(tokenize(src)), 0)))
  assert(String::length(decoded) == 1)
}

test "rs: string hex escape ff" {
  // \ff = byte 255
  let src = "\"\\ff\""
  let decoded = decode_string(token_text(src, Array::get(filter_tokens(tokenize(src)), 0)))
