test "rs: string empty" {
  let src = "\"\""
  let tokens = filter_tokens(tokenize(src))
  assert(Array::length(tokens) == 1)
  let (ty, _, _) = Array::get(tokens, 0)
  assert(ty == tok_type_string())
  assert(decode_string(token_text(src, Array::get(tokens, 0))) == "")
}

test "rs: string simple" {
  let src = "\"a\""
  let tokens = filter_tokens(tokenize(src))
  assert(Array::length(tokens) == 1)
  assert(decode_string(token_text(src, Array::get(tokens, 0))) == "a")
}

