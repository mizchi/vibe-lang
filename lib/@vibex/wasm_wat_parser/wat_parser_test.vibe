test "rs: integer 1" {
  assert(parse_int("1") == 1)
}

test "rs: integer 0" {
  assert(parse_int("0") == 0)
}

test "rs: integer negative" {
  assert(parse_int("-1") == -1)
}

test "rs: integer positive sign" {
  assert(parse_int("+1") == 1)
}

test "rs: integer hex" {
  assert(parse_int("0x10") == 16)
}

test "rs: integer hex negative" {
  assert(parse_int("-0x10") == -16)
}

test "rs: integer hex uppercase" {
  assert(parse_int("0xFF") == 255)
}

test "rs: integer large" {
  assert(parse_int("12345") == 12345)
