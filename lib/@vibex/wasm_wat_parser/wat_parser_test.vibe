test "rs: decode_string empty quotes" {
  assert(decode_string("\"\"") == "")
}

test "rs: decode_string no quotes" {
  assert(decode_string("") == "")
}

test "rs: decode_string multiple escapes" {
  let s = decode_string("\"\\n\\t\\\\\"")
  assert(String::length(s) == 3)
}

test "rs: mixed token sequence" {
  let src = "(module $m (func $f (param i32) (result i64) local.get 0))"
  let tokens = filter_tokens(tokenize(src))
  // ( module $m ( func $f ( param i32 ) ( result i64 ) local.get 0 ) )
  assert(Array::length(tokens) > 10)
  let (t0, _, _) = Array::get(tokens, 0)
  assert(t0 == tok_type_lparen())
  assert(token_text(src, Array::get(tokens, 1)) == "module")
  let (t2, _, _) = Array::get(tokens, 2)
  assert(t2 == tok_type_ident())
  assert(token_text(src, Array::get(tokens, 2)) == "$m")
}

test "rs: inline data string" {
  let src = "(data (i32.const 0) \"\\00\\01\\02\\03\")"
  let tokens = filter_tokens(tokenize(src))
  // Find the string token
  let cnt = Array::length(tokens)
  let mut found = false
  let mut si = 0
  while si < cnt {
    let (ty, _, _) = Array::get(tokens, si)
    if ty == tok_type_string() {
      let decoded = decode_string(token_text(src, Array::get(tokens, si)))
      assert(String::length(decoded) == 4)
      found = true
    } else {
      ()
    }
    si = si + 1
  }
  assert(found == true)
}

test "rs: is_instruction comprehensive" {
  // True cases
  assert(is_instruction("i32.const") == true)
  assert(is_instruction("i64.add") == true)
  assert(is_instruction("f32.mul") == true)
  assert(is_instruction("f64.div") == true)
  assert(is_instruction("local.get") == true)
  assert(is_instruction("local.set") == true)
  assert(is_instruction("local.tee") == true)
  assert(is_instruction("global.get") == true)
  assert(is_instruction("global.set") == true)
  assert(is_instruction("memory.size") == true)
  assert(is_instruction("memory.grow") == true)
  assert(is_instruction("call") == true)
  assert(is_instruction("call_indirect") == true)
  assert(is_instruction("block") == true)
  assert(is_instruction("loop") == true)
  assert(is_instruction("if") == true)
  assert(is_instruction("else") == true)
  assert(is_instruction("end") == true)
  assert(is_instruction("br") == true)
  assert(is_instruction("br_if") == true)
  assert(is_instruction("br_table") == true)
  assert(is_instruction("return") == true)
  assert(is_instruction("drop") == true)
  assert(is_instruction("select") == true)
  assert(is_instruction("unreachable") == true)
  assert(is_instruction("nop") == true)
  // False cases
  assert(is_instruction("module") == false)
  assert(is_instruction("func") == false)
  assert(is_instruction("type") == false)
  assert(is_instruction("param") == false)
  assert(is_instruction("result") == false)
  assert(is_instruction("export") == false)
  assert(is_instruction("import") == false)
  assert(is_instruction("table") == false)
  assert(is_instruction("memory") == false)
  assert(is_instruction("data") == false)
  assert(is_instruction("elem") == false)
}

test "rs: multiline wat" {
  let src = "(module\n  (type (func))\n  (func (type 0)\n    nop\n  )\n)"
  let names = wat_section_names(src)
  assert(Array::length(names) == 2)
  assert(Array::get(names, 0) == "type")
  assert(Array::get(names, 1) == "func")
}

test "rs: wat with comments" {
  let src = "(module\n  ;; type section\n  (type (func))\n  (; block comment ;)\n  (func (type 0))\n)"
  let names = wat_section_names(src)
  assert(Array::length(names) == 2)
}

test "rs: wat empty module" {
  assert(Array::length(wat_section_names("(module)")) == 0)
  assert(wat_func_count("(module)") == 0)
}

test "rs: wat multiple imports" {
  let src = "(module (import \"a\" \"b\" (func)) (import \"c\" \"d\" (memory 1)))"
  let imports = wat_imports(src)
  assert(Array::length(imports) == 2)
  let (m0, f0, k0) = Array::get(imports, 0)
  assert(m0 == "a")
  assert(f0 == "b")
  assert(k0 == "func")
  let (m1, f1, k1) = Array::get(imports, 1)
  assert(m1 == "c")
  assert(f1 == "d")
  assert(k1 == "memory")
}

test "rs: wat globals and tables" {
  let s = wat_summary("(module (global (mut i32) (i32.const 0)) (table 10 funcref))")
  assert(String::contains(s, "globals: 1"))
  assert(String::contains(s, "tables: 1"))
}
