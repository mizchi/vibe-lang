  let decoded = decode_string(token_text(src, Array::get(filter_tokens(tokenize(src)), 0)))
  assert(String::length(decoded) == 3)
}

test "rs: string escape quote" {
  let src = "\"a\\\"b\""
  let decoded = decode_string(token_text(src, Array::get(filter_tokens(tokenize(src)), 0)))
  assert(String::length(decoded) == 3)
