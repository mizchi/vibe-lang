//# Values

//# Functions

fn hex_val(_ c: Int) -> Int {
  if (c >= 48) && (c <= 57) {
    c - 48
  }
  else {
    if (c >= 97) && (c <= 102) {
      c - 87
    }
    else {
      if (c >= 65) && (c <= 70) {
        c - 55
      }
      else {
        0
      }
    }
  }
}

let tok_eof: Int = 9

let tok_int: Int = 5

fn is_digit(_ c: Int) -> Bool {
  (c >= 48) && (c <= 57)
}

export fn parse_int(_ s: String) -> Int {
  let len = String::length(s)
  if len == 0 {
    0
  }
  else {
    let mut neg = false
    let mut start = 0
    if String::char_code_at(s, at = 0) == 45 {
      neg = true
      start = 1
    } else {
      if String::char_code_at(s, at = 0) == 43 {
        start = 1
      }
    }
    let mut val = 0
    if ((start + 1) < len) && (String::char_code_at(s, at = start) == 48) && ((String::char_code_at(s, at = start + 1) == 120) || (String::char_code_at(s, at = start + 1) == 88)) {
      let mut i = start + 2
      while i < len {
        let c = String::char_code_at(s, at = i)
        if (c >= 48) && (c <= 57) {
          val = val * 16 + (c - 48)
        }
        else {
          if (c >= 97) && (c <= 102) {
            val = val * 16 + (c - 87)
          }
          else {
            if (c >= 65) && (c <= 70) {
              val = val * 16 + (c - 55)
            }
          }
        }
        i = i + 1
      }
    } else {
      let mut i = start
      while i < len {
        let c = String::char_code_at(s, at = i)
        if (c >= 48) && (c <= 57) {
          val = val * 10 + (c - 48)
        }
        i = i + 1
      }
    }
    if neg {
      0 - val
    } else {
      val
    }
  }
}

let tok_float: Int = 6

let tok_ident: Int = 4

fn is_id_char(_ c: Int) -> Bool {
  ((c >= 97) && (c <= 122)) ||
  ((c >= 65) && (c <= 90)) ||
  ((c >= 48) && (c <= 57)) ||
  (c == 95) || (c == 46) || (c == 47) || (c == 58) || (c == 45)
}

let tok_lparen: Int = 1

let tok_rparen: Int = 2

let tok_string: Int = 7

export fn token_text(src: String, tok: (Int, Int, Int)) -> String {
  let (_, start, end_pos) = tok
  String::substring(src, start = start, end = end_pos)
}

fn token_type(tokens: Array[(Int, Int, Int)], idx: Int) -> Int {
  let (ty, _, _) = Array::get(tokens, at = idx)
  ty
}

let tok_comment: Int = 8

let tok_keyword: Int = 3

fn is_hex_digit(_ c: Int) -> Bool {
  ((c >= 48) && (c <= 57)) ||
  ((c >= 97) && (c <= 102)) ||
  ((c >= 65) && (c <= 70))
}

export fn tokenize(_ src: String) -> Array[(Int, Int, Int)] {
  let len = String::length(src)
  let result = Array::slice([(0, 0, 0)], start = 0, end = 0)
  let mut i = 0
  while i < len {
    let c = String::char_code_at(src, at = i)
    if (c == 32) || (c == 9) || (c == 10) || (c == 13) {
      i = i + 1
    } else {
      if c == 40 {
        if ((i + 1) < len) && (String::char_code_at(src, at = i + 1) == 59) {
          let start = i
          i = i + 2
          let mut depth = 1
          while (i < len) && (depth > 0) {
            let cc = String::char_code_at(src, at = i)
            if (cc == 59) && ((i + 1) < len) && (String::char_code_at(src, at = i + 1) == 41) {
              depth = depth - 1
              i = i + 2
            } else {
              if (cc == 40) && ((i + 1) < len) && (String::char_code_at(src, at = i + 1) == 59) {
                depth = depth + 1
                i = i + 2
              } else {
                i = i + 1
              }
            }
          }
          Array::push(result, value = (tok_comment, start, i))
        } else {
          Array::push(result, value = (tok_lparen, i, i + 1))
          i = i + 1
        }
      } else {
        if c == 41 {
          Array::push(result, value = (tok_rparen, i, i + 1))
          i = i + 1
        } else {
          if c == 59 {
            let start = i
            while (i < len) && (String::char_code_at(src, at = i) != 10) {
              i = i + 1
            }
            Array::push(result, value = (tok_comment, start, i))
          } else {
            if c == 34 {
              let start = i
              i = i + 1
              while (i < len) && (String::char_code_at(src, at = i) != 34) {
                if String::char_code_at(src, at = i) == 92 {
                  i = i + 2
                } else {
                  i = i + 1
                }
              }
              if i < len {
                i = i + 1
              }
              Array::push(result, value = (tok_string, start, i))
            } else {
              if c == 36 {
                let start = i
                i = i + 1
                while (i < len) && (is_id_char(String::char_code_at(src, at = i))) {
                  i = i + 1
                }
                Array::push(result, value = (tok_ident, start, i))
              } else {
                if is_digit(c) || ((c == 45) && ((i + 1) < len) && (is_digit(String::char_code_at(src, at = i + 1)))) || ((c == 43) && ((i + 1) < len) && (is_digit(String::char_code_at(src, at = i + 1)))) {
                  let start = i
                  if (c == 45) || (c == 43) {
                    i = i + 1
                  }
                  if ((i + 1) < len) && (String::char_code_at(src, at = i) == 48) && ((String::char_code_at(src, at = i + 1) == 120) || (String::char_code_at(src, at = i + 1) == 88)) {
                    i = i + 2
                    while (i < len) && (is_hex_digit(String::char_code_at(src, at = i)) || (String::char_code_at(src, at = i) == 95)) {
                      i = i + 1
                    }
                  } else {
                    while (i < len) && (is_digit(String::char_code_at(src, at = i)) || (String::char_code_at(src, at = i) == 95)) {
                      i = i + 1
                    }
                  }
                  let mut is_float = false
                  if (i < len) && (String::char_code_at(src, at = i) == 46) {
                    is_float = true
                    i = i + 1
                    while (i < len) && (is_digit(String::char_code_at(src, at = i))) {
                      i = i + 1
                    }
                  }
                  if (i < len) && ((String::char_code_at(src, at = i) == 101) || (String::char_code_at(src, at = i) == 69)) {
                    is_float = true
                    i = i + 1
                    if (i < len) && ((String::char_code_at(src, at = i) == 43) || (String::char_code_at(src, at = i) == 45)) {
                      i = i + 1
                    }
                    while (i < len) && (is_digit(String::char_code_at(src, at = i))) {
                      i = i + 1
                    }
                  }
                  if is_float {
                    Array::push(result, value = (tok_float, start, i))
                  } else {
                    Array::push(result, value = (tok_int, start, i))
                  }
                } else {
                  let start = i
                  while (i < len) && (is_id_char(String::char_code_at(src, at = i))) {
                    i = i + 1
                  }
                  if i > start {
                    Array::push(result, value = (tok_keyword, start, i))
                  } else {
                    i = i + 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  Array::push(result, value = (tok_eof, len, len))
  result
}

export fn tok_type_int() -> Int {
  5
}

export fn decode_string(_ s: String) -> String {
  let len = String::length(s)
  if len < 2 {
    ""
  }
  else {
    // O(N) build via StringBuilder; per-char String::concat was O(L²) (issue #366).
    let result = StringBuilder::new()
    let mut i = 1
    let end_pos = len - 1
    while i < end_pos {
      let c = String::char_code_at(s, at = i)
      if c == 92 {
        i = i + 1
        if i < end_pos {
          let c2 = String::char_code_at(s, at = i)
          if c2 == 110 {
            StringBuilder::push(result, value = String::from_char_code(10)); i = i + 1
          }
          else {
            if c2 == 116 {
              StringBuilder::push(result, value = String::from_char_code(9)); i = i + 1
            }
            else {
              if c2 == 92 {
                StringBuilder::push(result, value = "\\"); i = i + 1
              }
              else {
                if c2 == 34 {
                  StringBuilder::push(result, value = "\""); i = i + 1
                }
                else {
                  if is_hex_digit(c2) && ((i + 1) < end_pos) && (is_hex_digit(String::char_code_at(s, at = i + 1))) {
                    let h = hex_val(c2) * 16 + hex_val(String::char_code_at(s, at = i + 1))
                    StringBuilder::push(result, value = String::from_char_code(h))
                    i = i + 2
                  } else {
                    StringBuilder::push(result, value = String::from_char_code(c2))
                    i = i + 1
                  }
                }
              }
            }
          }
        }
      } else {
        StringBuilder::push(result, value = String::from_char_code(c))
        i = i + 1
      }
    }
    StringBuilder::freeze(result)
  }
}

export fn filter_tokens(_ tokens: Array[(Int, Int, Int)]) -> Array[(Int, Int, Int)] {
  let result = Array::slice([(0, 0, 0)], start = 0, end = 0)
  let mut i = 0
  while i < Array::length(tokens) {
    let (ty, s, e) = Array::get(tokens, at = i)
    if (ty != tok_comment) && (ty != tok_eof) {
      Array::push(result, value = (ty, s, e))
    }
    i = i + 1
  }
  result
}

fn int_to_string(_ n: Int) -> String {
  if n == 0 {
    "0"
  }
  else {
    let mut val = if n < 0 {
      0 - n
    } else {
      n
    }
    let mut s = ""
    while val > 0 {
      let digit = val - ((val / 10) * 10)
      s = String::concat(String::from_char_code(48 + digit), s)
      val = val / 10
    }
    if n < 0 {
      String::concat("-", s)
    } else {
      s
    }
  }
}

export fn is_instruction(_ kw: String) -> Bool {
  String::starts_with(kw, prefix = "i32.") ||
  String::starts_with(kw, prefix = "i64.") ||
  String::starts_with(kw, prefix = "f32.") ||
  String::starts_with(kw, prefix = "f64.") ||
  String::starts_with(kw, prefix = "local.") ||
  String::starts_with(kw, prefix = "global.") ||
  String::starts_with(kw, prefix = "memory.") ||
  (kw == "call") ||
  (kw == "call_indirect") ||
  (kw == "block") ||
  (kw == "loop") ||
  (kw == "if") ||
  (kw == "else") ||
  (kw == "end") ||
  (kw == "br") ||
  (kw == "br_if") ||
  (kw == "br_table") ||
  (kw == "return") ||
  (kw == "drop") ||
  (kw == "select") ||
  (kw == "unreachable") ||
  (kw == "nop")
}

export fn tok_type_float() -> Int {
  6
}

export fn tok_type_ident() -> Int {
  4
}

export fn tok_type_lparen() -> Int {
  1
}

export fn tok_type_rparen() -> Int {
  2
}

export fn tok_type_string() -> Int {
  7
}

export fn tok_type_keyword() -> Int {
  3
}

export fn parse_module_sections(src: String, tokens: Array[(Int, Int, Int)]) -> Array[(String, Int, Int)] {
  let result = Array::slice([("", 0, 0)], start = 0, end = 0)
  let cnt = Array::length(tokens)
  let mut i = 0
  while (i < cnt) && (token_type(tokens = tokens, idx = i) != tok_lparen) {
    i = i + 1
  }
  if i >= cnt {
    result
  }
  else {
    i = i + 1
    if (i < cnt) && (token_type(tokens = tokens, idx = i) == tok_keyword) {
      i = i + 1
    }
    while i < cnt {
      let ty = token_type(tokens = tokens, idx = i)
      if ty == tok_rparen {
        i = cnt
      } else {
        if ty == tok_lparen {
          let section_start = i
          i = i + 1
          if (i < cnt) && (token_type(tokens = tokens, idx = i) == tok_keyword) {
            let kw = token_text(src = src, tok = Array::get(tokens, at = i))
            let mut depth = 1
            let kw_idx = i
            i = i + 1
            while (i < cnt) && (depth > 0) {
              let t = token_type(tokens = tokens, idx = i)
              if t == tok_lparen {
                depth = depth + 1
              }
              else {
                if t == tok_rparen {
                  depth = depth - 1
                }
              }
              i = i + 1
            }
            Array::push(result, value = (kw, kw_idx + 1, i - 1))
          } else {
            i = i + 1
          }
        } else {
          i = i + 1
        }
      }
    }
    result
  }
}

export fn wat_exports(_ src: String) -> Array[(String, String)] {
  let tokens = filter_tokens(tokenize(src))
  let sections = parse_module_sections(src = src, tokens = tokens)
  let result = Array::slice([("", "")], start = 0, end = 0)
  let mut i = 0
  while i < Array::length(sections) {
    let (kw, start, end_idx) = Array::get(sections, at = i)
    if kw == "export" {
      let mut name = ""
      let mut kind = ""
      let mut j = start
      while j < end_idx {
        let (ty, _, _) = Array::get(tokens, at = j)
        if ty == tok_string {
          name = decode_string(token_text(src = src, tok = Array::get(tokens, at = j)))
        } else {
          if ty == tok_keyword {
            let text = token_text(src = src, tok = Array::get(tokens, at = j))
            if (text == "func") || (text == "memory") || (text == "table") || (text == "global") {
              kind = text
            } else {
              ()
            }
          } else {
            ()
          }
        }
        j = j + 1
      }
      Array::push(result, value = (name, kind))
    } else {
      ()
    }
    i = i + 1
  }
  result
}

export fn wat_imports(_ src: String) -> Array[(String, String, String)] {
  let tokens = filter_tokens(tokenize(src))
  let sections = parse_module_sections(src = src, tokens = tokens)
  let result = Array::slice([("", "", "")], start = 0, end = 0)
  let mut i = 0
  while i < Array::length(sections) {
    let (kw, start, end_idx) = Array::get(sections, at = i)
    if kw == "import" {
      let mut mod_name = ""
      let mut field_name = ""
      let mut kind = ""
      let mut str_count = 0
      let mut j = start
      while j < end_idx {
        let (ty, _, _) = Array::get(tokens, at = j)
        if ty == tok_string {
          let decoded = decode_string(token_text(src = src, tok = Array::get(tokens, at = j)))
          if str_count == 0 {
            mod_name = decoded
          }
          else {
            field_name = decoded
          }
          str_count = str_count + 1
        } else {
          if ty == tok_keyword {
            let text = token_text(src = src, tok = Array::get(tokens, at = j))
            if (text == "func") || (text == "memory") || (text == "table") || (text == "global") {
              kind = text
            } else {
              ()
            }
          } else {
            ()
          }
        }
        j = j + 1
      }
      Array::push(result, value = (mod_name, field_name, kind))
    } else {
      ()
    }
    i = i + 1
  }
  result
}

export fn wat_summary(_ src: String) -> String {
  let tokens = filter_tokens(tokenize(src))
  let sections = parse_module_sections(src = src, tokens = tokens)
  let mut out = ""
  let mut types = 0
  let mut funcs = 0
  let mut imports = 0
  let mut exports = 0
  let mut memories = 0
  let mut tables = 0
  let mut globals = 0
  let mut data_segs = 0
  let mut i = 0
  while i < Array::length(sections) {
    let (kw, _, _) = Array::get(sections, at = i)
    if kw == "type" {
      types = types + 1
    }
    else if kw == "func" {
      funcs = funcs + 1
    }
    else if kw == "import" {
      imports = imports + 1
    }
    else if kw == "export" {
      exports = exports + 1
    }
    else if kw == "memory" {
      memories = memories + 1
    }
    else if kw == "table" {
      tables = tables + 1
    }
    else if kw == "global" {
      globals = globals + 1
    }
    else if kw == "data" {
      data_segs = data_segs + 1
    }
    else {
      ()
    }
    i = i + 1
  }
  out = String::concat("sections: ", int_to_string(Array::length(sections)))
  if types > 0 {
    out = String::concat(out, String::concat("\ntypes: ", int_to_string(types)))
  } else {
    ()
  }
  if funcs > 0 {
    out = String::concat(out, String::concat("\nfuncs: ", int_to_string(funcs)))
  } else {
    ()
  }
  if imports > 0 {
    out = String::concat(out, String::concat("\nimports: ", int_to_string(imports)))
  } else {
    ()
  }
  if exports > 0 {
    out = String::concat(out, String::concat("\nexports: ", int_to_string(exports)))
  } else {
    ()
  }
  if memories > 0 {
    out = String::concat(out, String::concat("\nmemories: ", int_to_string(memories)))
  } else {
    ()
  }
  if tables > 0 {
    out = String::concat(out, String::concat("\ntables: ", int_to_string(tables)))
  } else {
    ()
  }
  if globals > 0 {
    out = String::concat(out, String::concat("\nglobals: ", int_to_string(globals)))
  } else {
    ()
  }
  if data_segs > 0 {
    out = String::concat(out, String::concat("\ndata: ", int_to_string(data_segs)))
  } else {
    ()
  }
  out
}

export fn wat_type_sigs(_ src: String) -> Array[String] {
  let tokens = filter_tokens(tokenize(src))
  let sections = parse_module_sections(src = src, tokens = tokens)
  let result = Array::slice([""], start = 0, end = 0)
  let mut i = 0
  while i < Array::length(sections) {
    let (kw, start, end_idx) = Array::get(sections, at = i)
    if kw == "type" {
      let mut sig = "("
      let mut j = start
      let mut in_params = false
      let mut in_results = false
      while j < end_idx {
        let (ty, _, _) = Array::get(tokens, at = j)
        let text = token_text(src = src, tok = Array::get(tokens, at = j))
        if (ty == tok_keyword) && (text == "param") {
          in_params = true; in_results = false
        }
        else if (ty == tok_keyword) && (text == "result") {
          in_results = true; in_params = false; sig = String::concat(sig, ") -> (")
        }
        else if ty == tok_keyword {
          if in_params || in_results {
            if String::ends_with(sig, suffix = "(") {
              sig = String::concat(sig, text)
            }
            else {
              sig = String::concat(sig, String::concat(" ", text))
            }
          } else {
            ()
          }
        } else {
          ()
        }
        j = j + 1
      }
      if not(String::contains(sig, needle = "->")) {
        sig = String::concat(sig, ") -> (")
      } else {
        ()
      }
      sig = String::concat(sig, ")")
      Array::push(result, value = sig)
    } else {
      ()
    }
    i = i + 1
  }
  result
}

export fn wat_func_count(_ src: String) -> Int {
  let tokens = filter_tokens(tokenize(src))
  let sections = parse_module_sections(src = src, tokens = tokens)
  let mut count = 0
  let mut i = 0
  while i < Array::length(sections) {
    let (kw, _, _) = Array::get(sections, at = i)
    if kw == "func" {
      count = count + 1
    } else {
      ()
    }
    i = i + 1
  }
  count
}

export fn wat_section_names(_ src: String) -> Array[String] {
  let tokens = filter_tokens(tokenize(src))
  let sections = parse_module_sections(src = src, tokens = tokens)
  let result = Array::slice([""], start = 0, end = 0)
  let mut i = 0
  while i < Array::length(sections) {
    let (kw, _, _) = Array::get(sections, at = i)
    Array::push(result, value = kw)
    i = i + 1
  }
  result
}
