//# Imports

import ./cstring.vibe {
  read_cstring, write_cstring
}

//# Misc

// A fake foreign memory: 64 zeroed bytes and a bump allocator from 8.
fn fake_memory() -> (Array[Int], Array[Int]) {
  let bytes: Array[Int] = []
  let mut i = 0
  while i < 64 {
    Array::push(bytes, value = 0)
    i = i + 1
  }
  (bytes, [8])
}

test "a string round-trips through a foreign memory" {
  let (mem, next) = fake_memory()
  let alloc = (n: Int) -> Int {
    let p = Array::get(next, at = 0)
    Array::set(next, at = 0, value = p + n)
    p
  }
  let store = (a: Int, v: Int) -> Unit {
    Array::set(mem, at = a, value = v)
  }
  let load = (a: Int) -> Int {
    Array::get(mem, at = a)
  }
  let p = write_cstring(s = "(check-sat)", alloc = alloc, store_u8 = store)
  inspect(p, content = "8")
  inspect(Array::get(mem, at = 8 + 11), content = "0")
  inspect(read_cstring(p = p, load_u8 = load), content = "(check-sat)")
}

test "a NUL byte is refused instead of truncating" {
  // Built with from_byte rather than a `\u{0}` escape: the formatter refuses
  // a file with a `\u{..}` string inside a call argument, array or tuple
  // (#3713).
  let with_nul = String::concat("a", String::concat(String::from_byte(0), "b"))
  let (mem, _) = fake_memory()
  let r = handle {
    let _ = write_cstring(s = with_nul, alloc = (n: Int) -> Int {
      8
    }, store_u8 = (a: Int, v: Int) -> Unit {
      Array::set(mem, at = a, value = v)
    })
    "written"
  } with { Exception::Throw(m) => m }
  inspect(r, content = "write_cstring: byte 1 is NUL, which a C string cannot hold")
}

test "a null pointer is refused" {
  let r = handle {
    read_cstring(p = 0, load_u8 = (a: Int) -> Int {
      0
    })
  } with { Exception::Throw(m) => m }
  inspect(r, content = "read_cstring: null pointer")
}
