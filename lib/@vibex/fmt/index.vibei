version 0.0.1

// @vibex/fmt — 位置プレースホルダの文字列フォーマット (ADR-0065 実験 scope)。

import ./fmt.vibe {}

type FmtArg

fn format(template: String, args: Array[FmtArg]) -> String
fn s(v: String) -> FmtArg
fn i(v: Int) -> FmtArg
fn f(v: Double) -> FmtArg
fn b(v: Bool) -> FmtArg
fn join(parts: Array[String], sep: String) -> String
fn pad_left(s: String, width: Int, fill: String) -> String
fn pad_right(s: String, width: Int, fill: String) -> String

let version: String
