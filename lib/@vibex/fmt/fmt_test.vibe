//# Imports

import .{
  FmtArg, b, f, format, i, join, pad_left, pad_right, s
}

//# Functions

fn empty_args() -> Array[FmtArg] {
  Array::slice([s("")], start = 0, end = 0)
}

fn empty_strings() -> Array[String] {
  Array::slice([""], start = 0, end = 0)
}

//# Misc

test "format string interpolation" {
  let result = format(template = "{} is {} years old", args = [
    s("Alice"),
    i(25)
  ])
  assert(result == "Alice is 25 years old")
}

test "format with bool and double" {
  let result = format(template = "active={} score={}", args = [b(true), f(3.14)])
  assert(result == "active=true score=3.14")
}

test "format no placeholders" {
  let result = format(template = "hello world", args = empty_args())
  assert(result == "hello world")
}

test "format extra placeholders kept" {
  let result = format(template = "{} {} {}", args = [s("a")])
  assert(result == "a {} {}")
}

test "format negative int" {
  assert(format(template = "{}", args = [i(-42)]) == "-42")
}

test "format zero" {
  assert(format(template = "{}", args = [i(0)]) == "0")
}

test "format multiple same type" {
  let result = format(template = "{} + {} = {}", args = [i(1), i(2), i(3)])
  assert(result == "1 + 2 = 3")
}

test "format single placeholder" {
  assert(format(template = "val={}", args = [i(99)]) == "val=99")
}

test "format bool false" {
  assert(format(template = "{}", args = [b(false)]) == "false")
}

test "format adjacent placeholders" {
  assert(format(template = "{}{}", args = [s("ab"), s("cd")]) == "abcd")
}

test "format placeholder at start" {
  assert(format(template = "{} end", args = [s("start")]) == "start end")
}

test "format placeholder at end" {
  assert(format(template = "start {}", args = [s("end")]) == "start end")
}

test "format no braces" {
  assert(format(template = "plain text", args = [s("ignored")]) == "plain text")
}

test "format single open brace not placeholder" {
  assert(format(template = "a { b", args = empty_args()) == "a { b")
}

test "join strings" {
  assert(join(parts = ["a", "b", "c"], sep = ", ") == "a, b, c")
}

test "join empty" {
  assert(join(parts = empty_strings(), sep = ", ") == "")
}

test "join single element" {
  assert(join(parts = ["only"], sep = ", ") == "only")
}

test "join with empty separator" {
  assert(join(parts = ["a", "b", "c"], sep = "") == "abc")
}

test "join with long separator" {
  assert(join(parts = ["x", "y"], sep = " --- ") == "x --- y")
}

test "pad_left" {
  assert(pad_left(s = "42", width = 5, fill = "0") == "00042")
}

test "pad_left already wide enough" {
  assert(pad_left(s = "hello", width = 3, fill = "0") == "hello")
}

test "pad_right" {
  assert(pad_right(s = "hi", width = 5, fill = ".") == "hi...")
}

test "pad_right already wide enough" {
  assert(pad_right(s = "hello", width = 3, fill = ".") == "hello")
}

test "pad_left single char" {
  assert(pad_left(s = "x", width = 4, fill = " ") == "   x")
}
