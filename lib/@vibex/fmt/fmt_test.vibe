//# Imports

import .{
  FmtArg, b, f, format, i, join, pad_left, pad_right, s
}

//# Functions

fn empty_args() -> Array[FmtArg] {
  Array::slice([s("")], 0, 0)
}

fn empty_strings() -> Array[String] {
  Array::slice([""], 0, 0)
}

//# Misc

test "format string interpolation" {
  let result = format("{} is {} years old", [s("Alice"), i(25)])
  assert(result == "Alice is 25 years old")
}

test "format with bool and double" {
  let result = format("active={} score={}", [b(true), f(3.14)])
  assert(result == "active=true score=3.14")
}

test "format no placeholders" {
  let result = format("hello world", empty_args())
  assert(result == "hello world")
}

test "format extra placeholders kept" {
  let result = format("{} {} {}", [s("a")])
  assert(result == "a {} {}")
}

test "format negative int" {
  assert(format("{}", [i(-42)]) == "-42")
}

test "format zero" {
  assert(format("{}", [i(0)]) == "0")
}

test "format multiple same type" {
  let result = format("{} + {} = {}", [i(1), i(2), i(3)])
  assert(result == "1 + 2 = 3")
}

test "format single placeholder" {
  assert(format("val={}", [i(99)]) == "val=99")
}

test "format bool false" {
  assert(format("{}", [b(false)]) == "false")
}

test "format adjacent placeholders" {
  assert(format("{}{}", [s("ab"), s("cd")]) == "abcd")
}

test "format placeholder at start" {
  assert(format("{} end", [s("start")]) == "start end")
}

test "format placeholder at end" {
  assert(format("start {}", [s("end")]) == "start end")
}

test "format no braces" {
  assert(format("plain text", [s("ignored")]) == "plain text")
}

test "format single open brace not placeholder" {
  assert(format("a { b", empty_args()) == "a { b")
}

test "join strings" {
  assert(join(["a", "b", "c"], ", ") == "a, b, c")
}

test "join empty" {
  assert(join(empty_strings(), ", ") == "")
}

test "join single element" {
  assert(join(["only"], ", ") == "only")
}

test "join with empty separator" {
  assert(join(["a", "b", "c"], "") == "abc")
}

test "join with long separator" {
  assert(join(["x", "y"], " --- ") == "x --- y")
}

test "pad_left" {
  assert(pad_left("42", 5, "0") == "00042")
}

test "pad_left already wide enough" {
  assert(pad_left("hello", 3, "0") == "hello")
}

test "pad_right" {
  assert(pad_right("hi", 5, ".") == "hi...")
}

test "pad_right already wide enough" {
  assert(pad_right("hello", 3, ".") == "hello")
}

test "pad_left single char" {
  assert(pad_left("x", 4, " ") == "   x")
}
