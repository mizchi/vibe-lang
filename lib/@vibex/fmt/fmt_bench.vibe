//# Imports

import .{
  b, f, format, i, join, pad_left, pad_right, s
}

//# Misc

bench "fmt/format_simple" {
  let _ = format(template = "{} is {} years old", args = [s("Alice"), i(25)])
}

bench "fmt/format_many_args" {
  let _ = format(template = "{} {} {} {} {}", args = [
    s("a"),
    i(1),
    f(3.14),
    b(true),
    s("end")
  ])
}

bench "fmt/join_10" {
  let _ = join(parts = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"], sep = ", ")
}

bench "fmt/pad_left" {
  let _ = pad_left(s = "42", width = 10, fill = "0")
}

bench "fmt/pad_right" {
  let _ = pad_right(s = "hi", width = 10, fill = ".")
}
