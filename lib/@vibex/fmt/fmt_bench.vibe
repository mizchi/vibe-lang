//# Imports

import .{
  b, f, format, i, join, pad_left, pad_right, s
}

//# Misc

bench "fmt/format_simple" {
  let _ = format("{} is {} years old", [s("Alice"), i(25)])
}

bench "fmt/format_many_args" {
  let _ = format("{} {} {} {} {}", [s("a"), i(1), f(3.14), b(true), s("end")])
}

bench "fmt/join_10" {
  let _ = join(["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"], ", ")
}

bench "fmt/pad_left" {
  let _ = pad_left("42", 10, "0")
}

bench "fmt/pad_right" {
  let _ = pad_right("hi", 10, ".")
}
