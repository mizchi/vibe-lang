// @vibex/scan — immutable な文字列 Scanner (ADR-0065 実験 scope)。
// bare 形と Scanner:: 名前空間形の両方が公開面。

import ./scan.vibe {}

type Scanner

fn new(input: String) -> Scanner
fn pos(scan: Scanner) -> Int
fn peek(scan: Scanner) -> Option[String]
fn next(scan: Scanner) -> Option[(String, Scanner)]
fn eat(scan: Scanner, prefix: String) -> Option[Scanner]
fn eat_if(scan: Scanner, pred: (ch: String) -> Bool) -> Option[(String, Scanner)]
fn take_while(scan: Scanner, pred: (ch: String) -> Bool) -> (String, Scanner)
fn take_until(scan: Scanner, needle: String) -> (String, Scanner)
fn remaining(scan: Scanner) -> String
fn is_done(scan: Scanner) -> Bool
fn Scanner::advance(scan: Scanner, count: Int) -> Scanner
fn Scanner::pos(scan: Scanner) -> Int
fn Scanner::peek(scan: Scanner) -> Option[String]
fn Scanner::next(scan: Scanner) -> Option[(String, Scanner)]
fn Scanner::eat(scan: Scanner, prefix: String) -> Option[Scanner]
fn Scanner::eat_if(scan: Scanner, pred: (ch: String) -> Bool) -> Option[(String, Scanner)]
fn Scanner::take_while(scan: Scanner, pred: (ch: String) -> Bool) -> (String, Scanner)
fn Scanner::take_until(scan: Scanner, needle: String) -> (String, Scanner)
fn Scanner::remaining(scan: Scanner) -> String
fn Scanner::is_done(scan: Scanner) -> Bool

let version: String
