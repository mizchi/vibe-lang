//# Imports

import .{
  eat, new, remaining, take_until
}

//# Misc

test "index exports top level scanner helpers" {
  let scan = new("left:right")
  let (left, before_colon) = take_until(scan, ":")
  assert(left == "left")
  match eat(before_colon, ":") {
    Some(after_colon) => assert(remaining(after_colon) == "right"),
    _ => assert(false)
  }
}
