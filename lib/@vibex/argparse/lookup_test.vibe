import ./lookup.vibe {
  after_dash_in, arg_in, flag_in, option_in
}

test "a flag is seen only before --" {
  assert(flag_in(args = ["--self-test", "--root", "lib"], name = "--self-test"))
  assert(!flag_in(args = ["--", "--self-test"], name = "--self-test"))
  assert(!flag_in(args = ["--check"], name = "--self-test"))
}

test "an option takes the next token and stops at --" {
  assert(option_in(args = ["--index", "1", "--total", "4"], name = "--total") == "4")
  assert(option_in(args = ["--", "--index", "1"], name = "--index") == "")
  assert(option_in(args = ["--index"], name = "--index") == "")
}

test "tokens after -- are the task's data" {
  let files = after_dash_in(["--index", "0", "--", "a.vibe", "b.vibe"])
  assert(Array::length(files) == 2)
  assert(Array::get(files, at = 0) == "a.vibe")
  assert(Array::get(files, at = 1) == "b.vibe")
  assert(Array::length(after_dash_in(["--self-test"])) == 0)
}

test "arg is a raw index and is empty past the end" {
  assert(arg_in(args = ["report.json", "prev.json"], index = 1) == "prev.json")
  assert(arg_in(args = ["report.json"], index = 1) == "")
  assert(arg_in(args = ["report.json"], index = 0 - 1) == "")
}
