import ./lookup.vibe {
  after_dash_in, arg_in, flag_in, option_in
}

test "a flag is seen only before --" {
  assert(flag_in(["--self-test", "--root", "lib"], "--self-test"))
  assert(!flag_in(["--", "--self-test"], "--self-test"))
  assert(!flag_in(["--check"], "--self-test"))
}

test "an option takes the next token and stops at --" {
  assert(option_in(["--index", "1", "--total", "4"], "--total") == "4")
  assert(option_in(["--", "--index", "1"], "--index") == "")
  assert(option_in(["--index"], "--index") == "")
}

test "tokens after -- are the task's data" {
  let files = after_dash_in(["--index", "0", "--", "a.vibe", "b.vibe"])
  assert(Array::length(files) == 2)
  assert(Array::get(files, 0) == "a.vibe")
  assert(Array::get(files, 1) == "b.vibe")
  assert(Array::length(after_dash_in(["--self-test"])) == 0)
}

test "arg is a raw index and is empty past the end" {
  assert(arg_in(["report.json", "prev.json"], 1) == "prev.json")
  assert(arg_in(["report.json"], 1) == "")
  assert(arg_in(["report.json"], 0 - 1) == "")
}
