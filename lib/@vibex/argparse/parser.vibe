//# Types

export enum ArgToken {
  Positional(String);
  Flag(String);
  Opt(String, String)
}

export enum ArgList {
  ArgNil;
  ArgCons(ArgToken, ArgList)
}

export enum ParseResult {
  ParseOk(ArgList);
  ParseErr(String)
}

//# Functions

fn takes_value(valued: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(valued) {
    if Array::get(valued, i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// `valued` names long options that take the next token (`--index 0`),
/// not only `--index=0`. A name that is not listed stays a flag, so
/// `--verbose file` is still a flag plus a positional.
export fn parse_args_taking(args: Array[String], valued: Array[String]) -> ParseResult {
  let total = Array::length(args)
  let starts_with_dash = (s: String) -> Bool {
    String::length(s) > 0 && s[0: 1] == "-"
  }
  let starts_with_double_dash = (s: String) -> Bool {
    String::length(s) > 1 && s[0: 2] == "--"
  }
  let is_option_token = (s: String) -> Bool {
    String::length(s) > 1 && starts_with_dash(s)
  }
  let prepend_token = (token: ArgToken, result: ParseResult) -> ParseResult {
    match result {
      ParseOk(rest) => ParseOk(ArgCons(token, rest)),
      ParseErr(msg) => ParseErr(msg)
    }
  }
  let rec prepend_short_flags = (body: String, j: Int, tail: ArgList) -> ArgList {
    if j >= String::length(body) {
      tail
    } else {
      ArgCons(Flag(String::substring(body, j, j + 1)), prepend_short_flags(body, j + 1, tail))
    }
  }
  let rec r#loop = (i: Int, stop: Bool) -> ParseResult {
    if i >= total {
      ParseOk(ArgNil)
    } else {
      let arg = Array::get(args, i)
      if stop {
        prepend_token(Positional(arg), r#loop(i + 1, true))
      } else if arg == "--" {
        r#loop(i + 1, true)
      } else if starts_with_double_dash(arg) && String::length(arg) > 2 {
        let body = arg[2: String::length(arg)]
        let eq_pos = String::index_of(body, "=")
        if eq_pos == 0 {
          ParseErr("empty option name: \{arg}")
        } else if eq_pos > 0 {
          let key = body[0: eq_pos]
          let value = body[eq_pos + 1: String::length(body)]
          prepend_token(Opt(key, value), r#loop(i + 1, false))
        } else if takes_value(valued, body) && i + 1 < total {
          let next = Array::get(args, i + 1)
          if next == "--" {
            prepend_token(Flag(body), r#loop(i + 1, false))
          } else {
            prepend_token(Opt(body, next), r#loop(i + 2, false))
          }
        } else {
          prepend_token(Flag(body), r#loop(i + 1, false))
        }
      } else if starts_with_dash(arg) && String::length(arg) > 1 {
        let body = arg[1: String::length(arg)]
        let eq_pos = String::index_of(body, "=")
        if eq_pos == 0 {
          ParseErr("empty option name: \{arg}")
        } else if eq_pos == 1 {
          let key = body[0: 1]
          let value = body[2: String::length(body)]
          prepend_token(Opt(key, value), r#loop(i + 1, false))
        } else if String::length(body) == 1 {
          if i + 1 < total {
            let next_arg = Array::get(args, i + 1)
            if is_option_token(next_arg) {
              prepend_token(Flag(body), r#loop(i + 1, false))
            } else {
              prepend_token(Opt(body, next_arg), r#loop(i + 2, false))
            }
          } else {
            prepend_token(Flag(body), r#loop(i + 1, false))
          }
        } else {
          match r#loop(i + 1, false) {
            ParseOk(tail) => ParseOk(prepend_short_flags(body, 0, tail)),
            ParseErr(msg) => ParseErr(msg)
          }
        }
      } else {
        prepend_token(Positional(arg), r#loop(i + 1, false))
      }
    }
  }
  r#loop(0, false)
}

export fn parse_args(args: Array[String]) -> ParseResult {
  parse_args_taking(args, [])
}

export fn has_flag(items: ArgList, name: String) -> Bool {
  match items {
    ArgNil => false,
    ArgCons(Flag(found), rest) => if found == name {
      true
    } else {
      has_flag(rest, name)
    },
    ArgCons(_, rest) => has_flag(rest, name)
  }
}

export fn opt_value(items: ArgList, name: String) -> String {
  match items {
    ArgNil => "",
    ArgCons(Opt(found, value), rest) => if found == name {
      value
    } else {
      opt_value(rest, name)
    },
    ArgCons(_, rest) => opt_value(rest, name)
  }
}

/// Tokens after the first `--`. This is the same marker `parse_args` uses
/// to stop recognising options.
export fn tokens_after_dash(args: Array[String]) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  let mut take = false
  while i < Array::length(args) {
    if take {
      Array::push(out, Array::get(args, i))
    } else if Array::get(args, i) == "--" {
      take = true
    } else {
      ()
    }
    i = i + 1
  }
  out
}

