test "exec_module with locals" {
  // func(x: i32) -> i32: tmp = x + 10; return tmp
  // Uses 1 local declaration (1 x i32)
  let wasm = make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00,
    // type section: (i32) -> i32
    0x01,
    0x06,
    0x01,
    0x60,
    0x01,
    0x7F,
    0x01,
    0x7F,
    // func section
    0x03,
    0x02,
    0x01,
    0x00,
    // export section: "f" = func 0
    0x07,
    0x05,
    0x01,
    0x01,
    0x66,
    0x00,
    0x00,
    // code section. The two sizes below were each one short of the bytes that
    // follow -- 0x0E/0x0C for 15/13 -- and `wasm-tools validate` rejects the
    // result. It went unnoticed because exec_module_with_args checked only
    // length and magic; the validator added there for #1745 (5) caught it on
    // the first run.
    0x0A,
    0x0F,
    0x01,
    0x0D,
    // body size = 13
    0x01,
    // 1 local declaration group
    0x01,
    0x7F,
    // 1 local of type i32
    0x20,
    0x00,
    // local.get 0
    0x41,
    0x0A,
    // i32.const 10
    0x6A,
    // i32.add
    0x21,
    0x01,
    // local.set 1
    0x20,
    0x01,
    // local.get 1
    0x0B
    // end
  ])
  let args = Array::slice([
    0
  ], 0, 0)
  Array::push(args, 32)
  let (ec, result) = exec_module_with_args(wasm, "f", args)
  assert(ec == 0)
  assert(result == 42)
}

test "exec_module multi-function call" {
  // func0 = double(x) = x + x, func1 = main() = double(21)
  let wasm = make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00,
    // type section: type0=(i32)->i32, type1=()->i32
    0x01,
    0x0A,
    0x02,
    0x60,
    0x01,
    0x7F,
    0x01,
    0x7F,
    0x60,
    0x00,
    0x01,
    0x7F,
    // func section: func0=type0, func1=type1
    0x03,
    0x03,
    0x02,
    0x00,
    0x01,
    // export section: "main" = func 1
    0x07,
    0x08,
    0x01,
    0x04,
    0x6D,
    0x61,
    0x69,
    0x6E,
    0x00,
    0x01,
    // code section: 2 bodies. The size was 0x11 for 16 bytes of content
    // (1 count + 1+7 + 1+6), which `wasm-tools validate` rejects. Same class
    // as the one in "exec_module with locals" above, and unnoticed for the
    // same reason: nothing checked section sizes before #1745 (5).
    0x0A,
    0x10,
    0x02,
    // func 0: size=7, 0 locals, local.get 0, local.get 0, i32.add, end
    0x07,
    0x00,
    0x20,
    0x00,
    0x20,
    0x00,
    0x6A,
    0x0B,
    // func 1: size=6, 0 locals, i32.const 21, call 0, end
    0x06,
    0x00,
    0x41,
    0x15,
    0x10,
    0x00,
    0x0B
  ])
  let (ec, result) = exec_module(wasm, "main")
  assert(ec == 0)
  assert(result == 42)
}

test "exec_module with global" {
  // 1 mutable global (i32, init=42), func reads it
  let wasm = make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00,
    // type section: ()->i32
    0x01,
    0x05,
    0x01,
    0x60,
    0x00,
    0x01,
    0x7F,
    // func section
    0x03,
    0x02,
    0x01,
    0x00,
    // global section (id=6): 1 global, i32 mutable, init=i32.const 42
    0x06,
    0x06,
    0x01,
    0x7F,
    0x01,
    // i32, mutable
    0x41,
    0x2A,
    0x0B,
    // i32.const 42, end
    // export section: "g" = func 0
    0x07,
    0x05,
    0x01,
    0x01,
    0x67,
    0x00,
    0x00,
    // code section: global.get 0, end
    0x0A,
    0x06,
    0x01,
    0x04,
    0x00,
    0x23,
    0x00,
    0x0B
  ])
  let (ec, result) = exec_module(wasm, "g")
  assert(ec == 0)
  assert(result == 42)
}

test "br_table index 0" {
  // block (result i32)
  //   block (void)
  //     i32.const 0 (index)
  //     br_table count=2 [0, 1, default=2]
  //   end
  //   i32.const 10
  //   br 0
  // end
  let code = make_bytes([
    0x02,
    0x7F,
    // block (result i32)
    0x02,
    0x40,
    //   block (void)
    0x41,
    0,
    //     i32.const 0 (index)
    0x0E,
    2,
    0,
    1,
    2,
    //     br_table count=2 [0, 1, default=2]
    0x0B,
    //   end inner
    0x41,
    10,
    //   i32.const 10
    0x0C,
    0,
    //   br 0
    0x0B,
    // end outer
    0x0B
    // final end
  ])
  let (exit, result) = exec_body(code, 0, 18, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 10)
}

test "rs: sequential accumulation" {
  // Accumulate: local 0 += 1 repeated 5 times, then return
  let code = make_bytes([
    0x20,
    0,
    0x41,
    1,
    0x6A,
    0x21,
    0,
    // local.get 0, i32.const 1, i32.add, local.set 0
    0x20,
    0,
    0x41,
    1,
    0x6A,
    0x21,
    0,
    0x20,
    0,
    0x41,
    1,
    0x6A,
    0x21,
    0,
    0x20,
    0,
    0x41,
    1,
    0x6A,
    0x21,
    0,
    0x20,
    0,
    0x41,
    1,
    0x6A,
    0x21,
    0,
    0x20,
    0,
    // local.get 0
    0x0B
  ])
  let mem = Bytes::new()
  let mut mi = 0
  while mi < 256 {
    Bytes::push(mem, 0); mi = mi + 1
  }
  let (exit, result) = exec_body(code, 0, Bytes::length(code), make_locals(1), empty_stack(), mem, empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 5)
}

test "rs: recursive call double" {
  // func 0 (double): local.get 0, local.get 0, i32.add, end
  // func 1 (main): i32.const 21, call 0, end
  let code = make_bytes([
    // func 0 (double): param 0 = n, returns n+n
    0x20,
    0,
    // local.get 0
    0x20,
    0,
    // local.get 0
    0x6A,
    // i32.add
    0x0B,
    // end func 0
    // func 1 (main):
    0x41,
    21,
    // i32.const 21
    0x10,
    0,
    // call 0
    0x0B
    // end func 1
  ])
  let funcs = Array::slice([
    (0, 0, 0, 0)
  ], 0, 0)
  Array::push(funcs, (0, 6, 1, 0))
  // func 0: start=0, end=6, 1 param
  Array::push(funcs, (6, 11, 0, 0))
  // func 1: start=6, end=11
  let mem = Bytes::new()
  let mut mi = 0
  while mi < 256 {
    Bytes::push(mem, 0); mi = mi + 1
  }
  let (exit, result) = exec_body(code, 6, 11, make_locals(0), empty_stack(), mem, empty_globals(), funcs)
  assert(exit == 0)
  assert(result == 42)
}

test "loop counter" {
  // Loop from 0 to 10:
  // local 0 = counter (starts at 0)
  // loop $L
  //   local.get 0          ; get counter
  //   i32.const 1          ; add 1
  //   i32.add
  //   local.set 0          ; save counter
  //   local.get 0          ; check counter
  //   i32.const 10
  //   i32.lt_s             ; counter < 10?
  //   br_if 0              ; jump back to loop start
  // end
  // local.get 0            ; return counter
  // end
  let code = make_bytes([
    0x03,
    0x40,
    // loop (void)
    0x20,
    0,
    //   local.get 0
    0x41,
    1,
    //   i32.const 1
    0x6A,
    //   i32.add
    0x21,
    0,
    //   local.set 0
    0x20,
    0,
    //   local.get 0
    0x41,
    10,
    //   i32.const 10
    0x48,
    //   i32.lt_s
    0x0D,
    0,
    //   br_if 0
    0x0B,
    // end loop
    0x20,
    0,
    // local.get 0
    0x0B
    // end
  ])
  let (exit, result) = exec_body(code, 0, 19, make_locals(1), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 10)
}

test "nested loop" {
  // outer loop: i from 0 to 3
  // inner loop: j from 0 to 4
  // result = i * 4 + j = 3*4 + 4 = ... but actually we just count total iterations
  // local 0 = outer counter, local 1 = inner counter, local 2 = total
  let code = make_bytes([
    0x03,
    0x40,
    // loop $outer
    0x41,
    0,
    //   i32.const 0
    0x21,
    1,
    //   local.set 1 (reset inner counter)
    0x03,
    0x40,
    //   loop $inner
    0x20,
    2,
    //     local.get 2 (total)
    0x41,
    1,
    //     i32.const 1
    0x6A,
    //     i32.add
    0x21,
    2,
    //     local.set 2
    0x20,
    1,
    //     local.get 1
    0x41,
    1,
    //     i32.const 1
    0x6A,
    //     i32.add
    0x21,
    1,
    //     local.set 1
    0x20,
    1,
    //     local.get 1
    0x41,
    4,
    //     i32.const 4
    0x48,
    //     i32.lt_s
    0x0D,
    0,
    //     br_if 0 (back to inner)
    0x0B,
    //   end inner
    0x20,
    0,
    //   local.get 0
    0x41,
    1,
    //   i32.const 1
    0x6A,
    //   i32.add
    0x21,
    0,
    //   local.set 0
    0x20,
    0,
    //   local.get 0
    0x41,
    3,
    //   i32.const 3
    0x48,
    //   i32.lt_s
    0x0D,
    0,
    //   br_if 0 (back to outer)
    0x0B,
    // end outer
    0x20,
    2,
    // local.get 2 (total)
    0x0B
    // end
  ])
  let (exit, result) = exec_body(code, 0, 46, make_locals(3), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 12)
  // 3 * 4 = 12 iterations
}

test "loop with if inside" {
  // Loop counting even numbers from 0 to 9
  // local 0 = counter, local 1 = even_count
  // loop: counter++; if counter % 2 == 0 then even_count++; if counter < 10 br 1 (to loop)
  let code = make_bytes([
    0x03,
    0x40,
    // loop
    0x20,
    0,
    //   local.get 0
    0x41,
    1,
    //   i32.const 1
    0x6A,
    //   i32.add
    0x21,
    0,
    //   local.set 0
    // if (counter & 1) == 0 then even_count++
    0x20,
    0,
    //   local.get 0
    0x41,
    1,
    //   i32.const 1
    0x71,
    //   i32.and
    0x45,
    //   i32.eqz (== 0 means even)
    0x04,
    0x40,
    //   if (void)
    0x20,
    1,
    //     local.get 1
    0x41,
    1,
    //     i32.const 1
    0x6A,
    //     i32.add
    0x21,
    1,
    //     local.set 1
    0x0B,
    //   end if
    0x20,
    0,
    //   local.get 0
    0x41,
    10,
    //   i32.const 10
    0x48,
    //   i32.lt_s
    0x0D,
    0,
    //   br_if 0
    0x0B,
    // end loop
    0x20,
    1,
    // local.get 1 (even_count)
    0x0B
    // end
  ])
  let (exit, result) = exec_body(code, 0, 36, make_locals(2), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 5)
  // 2, 4, 6, 8, 10 = 5 even numbers
}

test "unsigned comparison i32.lt_u" {
  // -1 (0xFFFFFFFF unsigned) should be > 1 when unsigned
  // i32.const -1, i32.const 1, i32.lt_u -> 0 (false, -1 unsigned is large)
  let code = make_bytes([
    0x41,
    0x7F,
    0x41,
    1,
    0x49,
    0x0B
  ])
  let (exit, result) = exec_body(code, 0, 6, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 0)
  // 0xFFFFFFFF is NOT less than 1 unsigned
}

test "unsigned comparison i32.gt_u" {
  // -1 (0xFFFFFFFF unsigned) > 1 unsigned
  let code = make_bytes([
    0x41,
    0x7F,
    0x41,
    1,
    0x4B,
    0x0B
  ])
  let (exit, result) = exec_body(code, 0, 6, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 1)
  // 0xFFFFFFFF IS greater than 1 unsigned
}

test "i32.clz" {
  // clz(1) = 31 (only bit 0 set)
  let code = make_bytes([
    0x41,
    1,
    0x67,
    0x0B
  ])
  let (exit, result) = exec_body(code, 0, 4, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 31)
}

test "i32.ctz" {
  // ctz(0x80) = 7 (bit 7 is lowest set bit)
  let code = make_bytes([
    0x41,
    0x80,
    0x01,
    0x68,
    0x0B
  ])
  let (exit, result) = exec_body(code, 0, 5, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 7)
}

test "i32.popcnt" {
