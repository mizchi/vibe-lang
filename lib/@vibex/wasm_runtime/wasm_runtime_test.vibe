test "i32.div_u" {
  // div_u(100, 7) = 14
  let code = make_bytes([
    0x41,
    0xE4,
    0x00,
    0x41,
    7,
    0x6E,
    0x0B
  ])
  let (exit, result) = exec_body(code, 0, 7, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
