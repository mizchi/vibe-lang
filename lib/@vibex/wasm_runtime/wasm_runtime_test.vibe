}

test "i32.load16_u and i32.store16" {
  // Store 0x1234 as 16-bit at addr 0, then load it back
  let code = make_bytes([
    0x41,
    0,
    // i32.const 0 (addr)
    0x41,
    0xB4,
    0x24,
    // i32.const 0x1234 (4660 in sleb128)
    0x3B,
    1,
    0,
    // i32.store16 align=1 offset=0
    0x41,
    0,
    // i32.const 0 (addr)
    0x2F,
    1,
    0,
    // i32.load16_u align=1 offset=0
    0x0B
    // end
  ])
  let (exit, result) = exec_body(code, 0, 14, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 0x1234)
}

test "i32.load8_s sign extension" {
  // Store 0xFF (255) at addr 0, load as signed byte -> -1
  let code = make_bytes([
    0x41,
    0,
    // i32.const 0 (addr)
    0x41,
    0xFF,
    0x01,
    // i32.const 255
    0x3A,
    0,
    0,
    // i32.store8 align=0 offset=0
    0x41,
    0,
    // i32.const 0 (addr)
    0x2C,
    0,
    0,
    // i32.load8_s align=0 offset=0
    0x0B
    // end
  ])
  let (exit, result) = exec_body(code, 0, 14, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == -1)
}

test "opcode_name new opcodes" {
  assert(opcode_name(0x11) == "call_indirect")
  assert(opcode_name(0x2C) == "i32.load8_s")
  assert(opcode_name(0x2E) == "i32.load16_s")
  assert(opcode_name(0x2F) == "i32.load16_u")
  assert(opcode_name(0x3B) == "i32.store16")
  assert(opcode_name(0x49) == "i32.lt_u")
  assert(opcode_name(0x4B) == "i32.gt_u")
  assert(opcode_name(0x4D) == "i32.le_u")
  assert(opcode_name(0x4F) == "i32.ge_u")
  assert(opcode_name(0x54) == "i64.lt_u")
  assert(opcode_name(0x56) == "i64.gt_u")
  assert(opcode_name(0x58) == "i64.le_u")
  assert(opcode_name(0x5A) == "i64.ge_u")
  assert(opcode_name(0x67) == "i32.clz")
  assert(opcode_name(0x68) == "i32.ctz")
  assert(opcode_name(0x69) == "i32.popcnt")
  assert(opcode_name(0x6E) == "i32.div_u")
  assert(opcode_name(0x70) == "i32.rem_u")
  assert(opcode_name(0x76) == "i32.shr_u")
  assert(opcode_name(0x77) == "i32.rotl")
  assert(opcode_name(0x78) == "i32.rotr")
  assert(opcode_name(0x79) == "i64.clz")
  assert(opcode_name(0x7A) == "i64.ctz")
  assert(opcode_name(0x7B) == "i64.popcnt")
  assert(opcode_name(0x80) == "i64.div_u")
  assert(opcode_name(0x82) == "i64.rem_u")
  assert(opcode_name(0x88) == "i64.shr_u")
  assert(opcode_name(0x89) == "i64.rotl")
  assert(opcode_name(0x8A) == "i64.rotr")
}

test "gc struct new get set" {
  // gc_heap[0] = type descriptor for type 0 with 2 fields: [2]
  let gc_heap = Array::slice([
    Array::slice([
      0
    ], 0, 0)
  ], 0, 0)
  Array::push(gc_heap, Array::slice([
    2
  ], 0, 1))
  // type 0 has 2 fields
  // Code:
  // i64.const 42           (0x42, 42)
  // i64.const 99           (0x42, 99)
  // struct.new 0           (0xFB, 0x00, 0x00)
  // local.set 0            (0x21, 0x00)
  // local.get 0            (0x20, 0x00)
  // struct.get 0 0         (0xFB, 0x02, 0x00, 0x00) -> should be 42
  // local.get 0            (0x20, 0x00)
  // i64.const 100          (0x42, 0x64)
  // struct.set 0 1         (0xFB, 0x05, 0x00, 0x01)
  // local.get 0            (0x20, 0x00)
  // struct.get 0 1         (0xFB, 0x02, 0x00, 0x01) -> should be 100
  // end                    (0x0B)
  let code = make_bytes([
    0x42,
    42,
    0x42,
    0xE3,
    0x00,
    0xFB,
    0x00,
    0x00,
    0x21,
    0x00,
    0x20,
    0x00,
    0xFB,
    0x02,
    0x00,
    0x00,
    0x1A,
    0x20,
    0x00,
    0x42,
    0xE4,
    0x00,
    0xFB,
    0x05,
    0x00,
    0x01,
    0x20,
    0x00,
    0xFB,
    0x02,
    0x00,
    0x01,
    0x0B
  ])
  let locals = make_locals(1)
  let stack = empty_stack()
  let mem = make_memory(1)
  let (exit, result) = exec_body_gc(code, 0, Bytes::length(code), locals, stack, mem, empty_globals(), empty_funcs(), gc_heap)
  assert(exit == 0)
  assert(result == 100)
  // struct.set wrote 100 to field 1, then struct.get reads it back
  // Also verify first field was 42
  let code2 = make_bytes([
    0x42,
    42,
    0x42,
    0xE3,
    0x00,
    0xFB,
    0x00,
    0x00,
    0x21,
    0x00,
    0x20,
    0x00,
    0xFB,
    0x02,
    0x00,
    0x00,
    0x0B
  ])
  let gc_heap2 = Array::slice([
    Array::slice([
      0
    ], 0, 0)
  ], 0, 0)
  Array::push(gc_heap2, Array::slice([
    2
  ], 0, 1))
  let (exit2, result2) = exec_body_gc(code2, 0, Bytes::length(code2), make_locals(1), empty_stack(), make_memory(1), empty_globals(), empty_funcs(), gc_heap2)
  assert(exit2 == 0)
  assert(result2 == 42)
}

test "gc array new get set len" {
  let gc_heap = empty_gc_heap()
  // Code:
  // i64.const 7                  (0x42, 7)   - fill value
  // i64.const 3                  (0x42, 3)   - length
  // array.new 0                  (0xFB, 0x06, 0x00)
  // local.set 0                  (0x21, 0x00)
  //
  // Test array.len:
  // local.get 0                  (0x20, 0x00)
  // array.len                    (0xFB, 0x0F)  -> 3
  // drop                         (0x1A)
  //
  // Test array.get:
  // local.get 0                  (0x20, 0x00)
  // i64.const 1                  (0x42, 1)
  // array.get 0                  (0xFB, 0x0B, 0x00) -> 7
  // drop                         (0x1A)
  //
  // Test array.set + get:
  // local.get 0                  (0x20, 0x00)
  // i64.const 2                  (0x42, 2)   - index
  // i64.const 55                 (0x42, 55)  - value
  // array.set 0                  (0xFB, 0x0E, 0x00)
  // local.get 0                  (0x20, 0x00)
  // i64.const 2                  (0x42, 2)
  // array.get 0                  (0xFB, 0x0B, 0x00) -> 55
  // end                          (0x0B)
  let code = make_bytes([
    0x42,
    7,
    0x42,
    3,
    0xFB,
    0x06,
    0x00,
    0x21,
    0x00,
    0x20,
    0x00,
    0xFB,
    0x0F,
    0x1A,
    0x20,
    0x00,
    0x42,
    1,
    0xFB,
    0x0B,
    0x00,
    0x1A,
    0x20,
    0x00,
    0x42,
    2,
    0x42,
    55,
    0xFB,
    0x0E,
    0x00,
    0x20,
    0x00,
    0x42,
    2,
    0xFB,
    0x0B,
    0x00,
    0x0B
  ])
  let (exit, result) = exec_body_gc(code, 0, Bytes::length(code), make_locals(1), empty_stack(), make_memory(1), empty_globals(), empty_funcs(), gc_heap)
  assert(exit == 0)
  assert(result == 55)
}

test "gc array len" {
