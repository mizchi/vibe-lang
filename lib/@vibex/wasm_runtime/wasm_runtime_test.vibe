//# Imports

import ./wasm_runtime.vibe {
  disassemble, exec_body, exec_body_gc, exec_module, exec_module_with_args, make_memory, opcode_name
}

//# Functions

fn make_bytes(values: Array[Int]) -> Bytes {
  let buf = Bytes::new()
  let mut i = 0
  while i < Array::length(values) {
    Bytes::push(buf, Array::get(values, i))
    i = i + 1
  }
  buf
}

fn empty_funcs() -> Array[(Int, Int, Int, Int)] {
  Array::slice([
    (0, 0, 0, 0)
  ], 0, 0)
}

fn empty_stack() -> Array[Int] {
  Array::slice([
    0
  ], 0, 0)
}

fn make_locals(n: Int) -> Array[Int] {
  let arr = Array::slice([
    0
  ], 0, 0)
  let mut i = 0
  while i < n {
    Array::push(arr, 0); i = i + 1
  }
  arr
}

fn empty_gc_heap() -> Array[Array[Int]] {
  Array::slice([
    Array::slice([
      0
    ], 0, 0)
  ], 0, 0)
}

fn empty_globals() -> Array[Int] {
  Array::slice([
    0
  ], 0, 0)
}

//# Misc

test "i32 const and add" {
  let code = make_bytes([
    0x41,
    3,
    0x41,
    5,
    0x6A,
    0x0B
  ])
  let locals = make_locals(0)
  let stack = empty_stack()
  let mem = make_memory(1)
  let (exit, result) = exec_body(code, 0, 6, locals, stack, mem, empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 8)
}

