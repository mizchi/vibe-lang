test "opcode_name" {
  assert(opcode_name(0x41) == "i32.const")
  assert(opcode_name(0x6A) == "i32.add")
  assert(opcode_name(0x7C) == "i64.add")
  assert(opcode_name(0x20) == "local.get")
  assert(opcode_name(0x10) == "call")
  assert(opcode_name(0xFF) == "unknown")
}

test "opcode_name extended" {
  assert(opcode_name(0x22) == "local.tee")
  assert(opcode_name(0x23) == "global.get")
  assert(opcode_name(0x24) == "global.set")
  assert(opcode_name(0x28) == "i32.load")
  assert(opcode_name(0x2D) == "i32.load8_u")
  assert(opcode_name(0x36) == "i32.store")
  assert(opcode_name(0x3A) == "i32.store8")
  assert(opcode_name(0x3F) == "memory.size")
  assert(opcode_name(0x40) == "memory.grow")
  assert(opcode_name(0x0E) == "br_table")
  assert(opcode_name(0x45) == "i32.eqz")
  assert(opcode_name(0x6D) == "i32.div_s")
  assert(opcode_name(0x71) == "i32.and")
  assert(opcode_name(0xAD) == "i64.extend_i32_u")
}

