test "gc ref null and is_null" {
  let gc_heap = Array::slice([
    Array::slice([
      0
    ], 0, 0)
  ], 0, 0)
  Array::push(gc_heap, Array::slice([
    1
  ], 0, 1))
  // type 0 has 1 field
  // ref.null 0, ref.is_null -> 1
  let code = make_bytes([
    0xD0,
    0x00,
    0xD1,
    0x0B
  ])
  let (exit, result) = exec_body_gc(code, 0, Bytes::length(code), make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs(), gc_heap)
  assert(exit == 0)
  assert(result == 1)
  // struct.new then ref.is_null -> 0
  let gc_heap2 = Array::slice([
    Array::slice([
      0
    ], 0, 0)
  ], 0, 0)
  Array::push(gc_heap2, Array::slice([
    1
  ], 0, 1))
  let code2 = make_bytes([
    0x42,
    42,
    0xFB,
    0x00,
    0x00,
    0xD1,
    0x0B
  ])
  let (exit2, result2) = exec_body_gc(code2, 0, Bytes::length(code2), make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs(), gc_heap2)
  assert(exit2 == 0)
  assert(result2 == 0)
}

