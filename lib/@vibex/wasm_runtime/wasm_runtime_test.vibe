  let code = make_bytes([
    0x41,
    0xFF,
    0x01,
    0x69,
    0x0B
  ])
  let (exit, result) = exec_body(code, 0, 5, make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs())
  assert(exit == 0)
