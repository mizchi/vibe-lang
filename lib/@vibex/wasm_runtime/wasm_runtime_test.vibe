test "gc struct new default" {
  let gc_heap = Array::slice([
    Array::slice([
      0
    ], 0, 0)
  ], 0, 0)
  Array::push(gc_heap, Array::slice([
    3
  ], 0, 1))
  // type 0 has 3 fields
  // struct.new_default 0, struct.get 0 2 -> should be 0
  let code = make_bytes([
    0xFB,
    0x01,
    0x00,
    0xFB,
    0x02,
    0x00,
    0x02,
    0x0B
  ])
  let (exit, result) = exec_body_gc(code, 0, Bytes::length(code), make_locals(0), empty_stack(), make_memory(1), empty_globals(), empty_funcs(), gc_heap)
  assert(exit == 0)
  assert(result == 0)
}

