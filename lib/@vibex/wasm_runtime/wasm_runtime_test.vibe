test "memory.grow returns old size" {
  // i32.const 3, memory.grow -> should return 1 (old page count)
  let code = make_bytes([
    0x41,
    3,
    0x40,
    0x00,
    0x0B
  ])
  // Use a small initial memory to avoid slow test
  let mem = Bytes::new()
  let mut mi = 0
  while mi < 256 {
    Bytes::push(mem, 0); mi = mi + 1
  }
  // memory is 256 bytes = 0 pages (less than 1), so size = 0
  // Actually make_memory(1) = 65536 bytes. Let's use that.
  let mem2 = make_memory(1)
  let (exit, result) = exec_body(code, 0, 5, make_locals(0), empty_stack(), mem2, empty_globals(), empty_funcs())
  assert(exit == 0)
  assert(result == 1)
}

test "disassemble basic" {
  let code = make_bytes([
    0x41,
    3,
    0x41,
    5,
    0x6A,
    0x0B
  ])
  let lines = disassemble(code, 0, 6)
  assert(Array::length(lines) == 4)
  assert(Array::get(lines, 0) == "i32.const 3")
  assert(Array::get(lines, 1) == "i32.const 5")
  assert(Array::get(lines, 2) == "i32.add")
  assert(Array::get(lines, 3) == "end")
}

test "disassemble locals" {
  let code = make_bytes([
    0x20,
    0,
    0x21,
    1,
    0x22,
    2,
    0x0B
  ])
  let lines = disassemble(code, 0, 7)
  assert(Array::length(lines) == 4)
  assert(Array::get(lines, 0) == "local.get 0")
  assert(Array::get(lines, 1) == "local.set 1")
  assert(Array::get(lines, 2) == "local.tee 2")
  assert(Array::get(lines, 3) == "end")
}

test "disassemble memory ops" {
  let code = make_bytes([
    0x28,
    2,
    0,
    0x0B
  ])
  let lines = disassemble(code, 0, 4)
  assert(Array::length(lines) == 2)
  assert(Array::get(lines, 0) == "i32.load align=2 offset=0")
  assert(Array::get(lines, 1) == "end")
}

test "disassemble call" {
  let code = make_bytes([
    0x10,
    3,
    0x0B
  ])
  let lines = disassemble(code, 0, 3)
  assert(Array::length(lines) == 2)
  assert(Array::get(lines, 0) == "call 3")
  assert(Array::get(lines, 1) == "end")
}

test "disassemble gc instructions do not desync the stream" {
  // local.get 0 | struct.get $12 1 | ref.cast null $12 | end
  //
  // Before the fold onto next_instruction this produced SIX lines --
  // "unknown", then "block 12" and "nop" decoded out of struct.get's type and
  // field indices, then "br 11" out of ref.cast's. None of those instructions
  // are in this body. Every gc body the compiler emits took that path, so the
  // count is the assertion that matters here.
  let code = make_bytes([
    0x20,
    0,
    0xFB,
    2,
    12,
    1,
    0xFB,
    23,
    12,
    0x0B
  ])
  let lines = disassemble(code, 0, 10)
  assert(Array::length(lines) == 4)
  assert(Array::get(lines, 0) == "local.get 0")
  assert(Array::get(lines, 1) == "struct.get")
  assert(Array::get(lines, 2) == "ref.cast null")
  assert(Array::get(lines, 3) == "end")
}

test "disassemble stops rather than guess past an undecodable opcode" {
  // 0xFD is the simd prefix, whose immediates the stepper does not enumerate.
  // Resuming at the next byte is the guess that made the old listing fiction.
  let code = make_bytes([
    0x01,
    0xFD,
    12,
    0x0B
  ])
  let lines = disassemble(code, 0, 4)
  assert(Array::length(lines) == 2)
  assert(Array::get(lines, 0) == "nop")
  assert(String::contains(Array::get(lines, 1), "cannot decode"))
}

test "exec_module simple add" {
  let wasm = make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00,
    // type section: (i32, i32) -> i32
    0x01,
    0x07,
    0x01,
    0x60,
    0x02,
    0x7F,
    0x7F,
    0x01,
    0x7F,
    // func section
    0x03,
    0x02,
    0x01,
    0x00,
    // export section: "add" = func 0
    0x07,
    0x07,
    0x01,
    0x03,
    0x61,
    0x64,
    0x64,
    0x00,
    0x00,
    // code section: local.get 0, local.get 1, i32.add, end
    0x0A,
    0x09,
    0x01,
    0x07,
    0x00,
    0x20,
    0x00,
    0x20,
    0x01,
    0x6A,
    0x0B
  ])
  let args = Array::slice([
    0
  ], 0, 0)
  Array::push(args, 13)
  Array::push(args, 29)
  let (ec, result) = exec_module_with_args(wasm, "add", args)
  assert(ec == 0)
  assert(result == 42)
}

test "exec_module no-param func" {
  let wasm = make_bytes([
    0x00,
    0x61,
    0x73,
    0x6D,
    0x01,
    0x00,
    0x00,
    0x00,
    // type section: () -> i32
    0x01,
    0x05,
    0x01,
    0x60,
    0x00,
    0x01,
    0x7F,
    // func section
    0x03,
    0x02,
    0x01,
    0x00,
    // export section: "run" = func 0
    0x07,
    0x07,
    0x01,
    0x03,
    0x72,
    0x75,
    0x6E,
    0x00,
    0x00,
    // code section: i32.const 42, end  (42 = 0x2A, fits in 1-byte sleb128)
    0x0A,
    0x06,
    0x01,
    0x04,
    0x00,
    0x41,
    0x2A,
    0x0B
  ])
  let (ec, result) = exec_module(wasm, "run")
  assert(ec == 0)
  assert(result == 42)
}

