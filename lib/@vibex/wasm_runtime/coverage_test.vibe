//# Imports

import @vibex/wasm_parser {
  count_locals, read_version, section_name, validate_magic, valtype_name
}

import ./wasm_runtime.vibe {
  opcode_name
}

//# Misc

test "cov: section_name" {
  assert(section_name(0) == "custom")
  assert(section_name(1) == "type")
  assert(section_name(2) == "import")
  assert(section_name(3) == "function")
  assert(section_name(4) == "table")
  assert(section_name(5) == "memory")
  assert(section_name(6) == "global")
  assert(section_name(7) == "export")
  assert(section_name(8) == "start")
  assert(section_name(9) == "element")
  assert(section_name(10) == "code")
  assert(section_name(11) == "data")
  assert(section_name(12) == "datacount")
  assert(section_name(99) == "unknown")
}

test "cov: valtype_name" {
  assert(valtype_name(127) == "i32")
  assert(valtype_name(126) == "i64")
  assert(valtype_name(125) == "f32")
  assert(valtype_name(124) == "f64")
  assert(valtype_name(123) == "v128")
  assert(valtype_name(112) == "funcref")
  assert(valtype_name(111) == "externref")
  assert(valtype_name(110) == "ref_null_func")
  assert(valtype_name(109) == "ref_null_extern")
  assert(valtype_name(99) == "ref")
  assert(valtype_name(100) == "ref_null")
  assert(valtype_name(0) == "unknown")
}

test "cov: opcode_name" {
  assert(opcode_name(0x00) == "unreachable")
  assert(opcode_name(0x01) == "nop")
  assert(opcode_name(0x02) == "block")
  assert(opcode_name(0x03) == "loop")
  assert(opcode_name(0x04) == "if")
  assert(opcode_name(0x05) == "else")
  assert(opcode_name(0x0B) == "end")
  assert(opcode_name(0x0C) == "br")
  assert(opcode_name(0x0D) == "br_if")
  assert(opcode_name(0x0E) == "br_table")
  assert(opcode_name(0x0F) == "return")
  assert(opcode_name(0x10) == "call")
  assert(opcode_name(0x11) == "call_indirect")
  assert(opcode_name(0x1A) == "drop")
  assert(opcode_name(0x1B) == "select")
  assert(opcode_name(0x20) == "local.get")
  assert(opcode_name(0x21) == "local.set")
  assert(opcode_name(0x22) == "local.tee")
  assert(opcode_name(0x23) == "global.get")
  assert(opcode_name(0x24) == "global.set")
  assert(opcode_name(0x28) == "i32.load")
  assert(opcode_name(0x29) == "i64.load")
  assert(opcode_name(0x2C) == "i32.load8_s")
  assert(opcode_name(0x2D) == "i32.load8_u")
  assert(opcode_name(0x2E) == "i32.load16_s")
  assert(opcode_name(0x2F) == "i32.load16_u")
  assert(opcode_name(0x36) == "i32.store")
  assert(opcode_name(0x37) == "i64.store")
  assert(opcode_name(0x3A) == "i32.store8")
  assert(opcode_name(0x3B) == "i32.store16")
  assert(opcode_name(0x3F) == "memory.size")
  assert(opcode_name(0x40) == "memory.grow")
  assert(opcode_name(0x41) == "i32.const")
  assert(opcode_name(0x42) == "i64.const")
  assert(opcode_name(0x45) == "i32.eqz")
  assert(opcode_name(0x46) == "i32.eq")
  assert(opcode_name(0x47) == "i32.ne")
  assert(opcode_name(0x48) == "i32.lt_s")
  assert(opcode_name(0x49) == "i32.lt_u")
  assert(opcode_name(0x4A) == "i32.gt_s")
  assert(opcode_name(0x4B) == "i32.gt_u")
  assert(opcode_name(0x6A) == "i32.add")
  assert(opcode_name(0x6B) == "i32.sub")
  assert(opcode_name(0x6C) == "i32.mul")
  assert(opcode_name(0x6D) == "i32.div_s")
  assert(opcode_name(0x6E) == "i32.div_u")
  assert(opcode_name(0x6F) == "i32.rem_s")
  assert(opcode_name(0x70) == "i32.rem_u")
  assert(opcode_name(0x67) == "i32.clz")
  assert(opcode_name(0x68) == "i32.ctz")
  assert(opcode_name(0x69) == "i32.popcnt")
  assert(opcode_name(0x71) == "i32.and")
  assert(opcode_name(0x74) == "i32.shl")
  assert(opcode_name(0x76) == "i32.shr_u")
  assert(opcode_name(0x77) == "i32.rotl")
  assert(opcode_name(0x78) == "i32.rotr")
  assert(opcode_name(0x7C) == "i64.add")
  assert(opcode_name(0x79) == "i64.clz")
  assert(opcode_name(0x80) == "i64.div_u")
  assert(opcode_name(0x89) == "i64.rotl")
  assert(opcode_name(0xA7) == "i32.wrap_i64")
  assert(opcode_name(0xAC) == "i64.extend_i32_s")
  assert(opcode_name(0xAD) == "i64.extend_i32_u")
  assert(opcode_name(0xFF) == "unknown")
}

test "cov: count_locals" {
  let e = Array::slice([(0, 0)], 0, 0)
  assert(count_locals(e) == 0)
  Array::push(e, (3, 127))
  assert(count_locals(e) == 3)
  Array::push(e, (2, 126))
  assert(count_locals(e) == 5)
}

test "cov: validate_magic" {
  let b = Bytes::new()
  Bytes::push(b, 0)
  Bytes::push(b, 97)
  Bytes::push(b, 115)
  Bytes::push(b, 109)
  Bytes::push(b, 1)
  Bytes::push(b, 0)
  Bytes::push(b, 0)
  Bytes::push(b, 0)
  assert(validate_magic(b) == true)
  let c = Bytes::new()
  Bytes::push(c, 0)
  Bytes::push(c, 0)
  assert(validate_magic(c) == false)
}

test "cov: read_version" {
  let b = Bytes::new()
  Bytes::push(b, 0)
  Bytes::push(b, 97)
  Bytes::push(b, 115)
  Bytes::push(b, 109)
  Bytes::push(b, 1)
  Bytes::push(b, 0)
  Bytes::push(b, 0)
  Bytes::push(b, 0)
  assert(read_version(b) == 1)
  assert(read_version(Bytes::new()) == -1)
}
