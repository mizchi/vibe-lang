//# Imports

import ./wasm_runtime.vibe {
  disassemble, exec_body, make_memory, opcode_name
}

//# Functions

fn make_bytes(values: Array[Int]) -> Bytes {
  let buf = Bytes::new()
  let mut i = 0
  while i < Array::length(values) {
    Bytes::push(buf, Array::get(values, i))
    i = i + 1
  }
  buf
}

fn code_add() -> Bytes {
  make_bytes([0x41, 3, 0x41, 5, 0x6A, 0x0B])
}

fn empty_funcs() -> Array[(Int, Int, Int, Int)] {
  Array::slice([(0, 0, 0, 0)], 0, 0)
}

fn empty_stack() -> Array[Int] {
  Array::slice([0], 0, 0)
}

fn make_locals(n: Int) -> Array[Int] {
  let arr = Array::slice([0], 0, 0)
  let mut i = 0
  while i < n {
    Array::push(arr, 0); i = i + 1
  }
  arr
}

fn empty_globals() -> Array[Int] {
  Array::slice([0], 0, 0)
}

//# Misc

bench "wasm_runtime/exec_add" {
  let c = code_add()
  let mem = Bytes::new()
  let mut mi = 0
  while mi < 256 {
    Bytes::push(mem, 0); mi = mi + 1
  }
  let _ = exec_body(c, 0, 6, make_locals(0), empty_stack(), mem, empty_globals(), empty_funcs())
}

bench "wasm_runtime/opcode_name" {
  let _ = opcode_name(0x41)
  let _ = opcode_name(0x6A)
  let _ = opcode_name(0x20)
}

bench "wasm_runtime/disassemble" {
  let _ = disassemble(code_add(), 0, 6)
}
