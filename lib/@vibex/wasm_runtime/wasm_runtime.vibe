  } else if op == 0x7A {
    "i64.ctz"
  }
  else if op == 0x7B {
    "i64.popcnt"
  }
  else if op == 0x7C {
    "i64.add"
  } else if op == 0x7D {
    "i64.sub"
  }
  else if op == 0x7E {
    "i64.mul"
