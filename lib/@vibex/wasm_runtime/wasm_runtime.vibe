      stack_push(s = stack, v = ctz32(stack_pop(stack)))
    }
    else if op == 0x69 {
      stack_push(s = stack, v = popcnt32(stack_pop(stack)))
    }
    else if op == 0x77 {
      let b = stack_pop(stack); stack_push(s = stack, v = signed_i32(rotl32(a = stack_pop(stack), b = b)))
    }
    else if op == 0x78 {
      let b = stack_pop(stack); stack_push(s = stack, v = signed_i32(rotr32(a = stack_pop(stack), b = b)))
