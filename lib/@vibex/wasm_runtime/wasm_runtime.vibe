//# Imports

import @vibex/wasm_parser {
  next_instruction, validate_structure
}

//# Values

//# Functions

fn br_to(block_stack: Array[(Int, Int)], depth: Int) -> Int {
  let blen = Array::length(block_stack)
  let target_idx = blen - 1 - depth
  if target_idx >= 0 {
    let (target, kind) = Array::get(block_stack, at = target_idx)
    if kind == 1 {
      Array::truncate(block_stack, length = target_idx + 1)
    } else {
      Array::truncate(block_stack, length = target_idx)
    }
    target
  } else {
    -1
  }
}

/// Interpret the low 32 bits of a host `Int` as a signed wasm i32.
///
/// wasm i32 values are 32 bits; the operand stack carries them in a 62-bit host
/// `Int`. Arithmetic that overflows 32 bits leaves a host value whose LOW 32
/// BITS are right and whose sign is not -- `i32.const 2147483647` plus one is
/// host `2147483648`, not `INT_MIN`.
///
/// Every opcode that reads its operand as SIGNED then answers wrong:
/// `i32.lt_s` says `(MAX+1) < -1` is false, `i32.shr_s` shifts a zero into the
/// sign position, `i32.rem_s` returns `+2` where the engine returns `-2`.
/// Applying this at each signed consumer would mean restating the rule at every
/// signed opcode and re-deriving it for each one added later, so it is applied
/// at the four PRODUCERS that can leave the range as well (add/sub/mul/shl).
/// Everything downstream then reads an honest signed i32.
///
/// i64 opcodes are deliberately untouched: a 64-bit value does not fit the
/// 62-bit host `Int` at all, which is a different and larger problem.
fn signed_i32(_ n: Int) -> Int {
  let v = n&0xFFFFFFFF
  if v >= 0x80000000 {
    v - 0x100000000
  } else {
    v
  }
}

fn clz32(_ n: Int) -> Int {
  let v = n&0xFFFFFFFF
  if v == 0 {
    32
  }
  else {
    let mut count = 0
    let mut x = v
    while (x&0x80000000) == 0 {
      x = x<<1; count = count + 1
    }
    count
  }
}

fn clz64(_ n: Int) -> Int {
  if n == 0 {
    64
  }
  else {
    let mut count = 0
    let mut done = false
    while (count < 64) && (done == false) {
      if (n&(1<<(63 - count))) != 0 {
        done = true
      } else {
        count = count + 1
      }
    }
    count
  }
}

fn ctz32(_ n: Int) -> Int {
  let v = n&0xFFFFFFFF
  if v == 0 {
    32
  }
  else {
    let mut count = 0
    let mut x = v
    while (x&1) == 0 {
      x = (x>>1)&0x7FFFFFFF; count = count + 1
    }
    count
  }
}

fn ctz64(_ n: Int) -> Int {
  if n == 0 {
    64
  }
  else {
    let mut count = 0
    let mut x = n
    let mut done = false
    while (done == false) && (count < 64) {
      if (x&1) == 0 {
        x = x>>1; count = count + 1
      } else {
        done = true
      }
    }
    count
  }
}

fn rotl32(a: Int, b: Int) -> Int {
  let v = a&0xFFFFFFFF
  let shift = b&31
  if shift == 0 {
    v
  }
  else {
    ((v<<shift)|(((v>>(32 - shift)))&((1<<shift) - 1)))&0xFFFFFFFF
  }
}

fn rotr32(a: Int, b: Int) -> Int {
  let v = a&0xFFFFFFFF
  let shift = b&31
  if shift == 0 {
    v
  }
  else {
    ((((v>>shift))&((1<<(32 - shift)) - 1))|(v<<(32 - shift)))&0xFFFFFFFF
  }
}

fn popcnt32(_ n: Int) -> Int {
  let mut count = 0
  let mut x = n&0xFFFFFFFF
  while x != 0 {
    count = count + (x&1); x = (x>>1)&0x7FFFFFFF
  }
  count
}

fn popcnt64(_ n: Int) -> Int {
  let mut count = 0
  let mut x = n
  let mut i = 0
  while i < 64 {
    count = count + (x&1); x = x>>1; i = i + 1
  }
  count
}

fn stack_pop(_ s: Array[Int]) -> Int {
  let n = Array::length(s)
  if n == 0 {
    0
  } else {
    let v = Array::get(s, at = n - 1); Array::truncate(s, length = n - 1); v
  }
}

fn stack_peek(_ s: Array[Int]) -> Int {
  let n = Array::length(s)
  if n == 0 {
    0
  } else {
    Array::get(s, at = n - 1)
  }
}

fn stack_push(s: Array[Int], v: Int) -> Unit {
  Array::push(s, value = v)
}

export fn make_memory(_ pages: Int) -> Bytes {
  let size = pages * 65536
  let mem = Bytes::new()
  let mut i = 0
  while i < size {
    Bytes::push(mem, value = 0); i = i + 1
  }
  mem
}

export fn opcode_name(_ op: Int) -> String {
  if op == 0x00 {
    "unreachable"
  } else if op == 0x01 {
    "nop"
  }
  else if op == 0x02 {
    "block"
  } else if op == 0x03 {
    "loop"
  }
  else if op == 0x04 {
    "if"
  } else if op == 0x05 {
    "else"
  }
  else if op == 0x0B {
    "end"
  } else if op == 0x0C {
    "br"
  }
  else if op == 0x0D {
    "br_if"
  } else if op == 0x0E {
    "br_table"
  }
  else if op == 0x0F {
    "return"
  }
  else if op == 0x10 {
    "call"
  } else if op == 0x11 {
    "call_indirect"
  }
  else if op == 0x1A {
    "drop"
  }
  else if op == 0x1B {
    "select"
  }
  else if op == 0x20 {
    "local.get"
  } else if op == 0x21 {
    "local.set"
  }
  else if op == 0x22 {
    "local.tee"
  }
  else if op == 0x23 {
    "global.get"
  } else if op == 0x24 {
    "global.set"
  }
  else if op == 0x28 {
    "i32.load"
  } else if op == 0x29 {
    "i64.load"
  }
  else if op == 0x2C {
    "i32.load8_s"
  }
  else if op == 0x2D {
    "i32.load8_u"
  }
  else if op == 0x2E {
    "i32.load16_s"
  } else if op == 0x2F {
    "i32.load16_u"
  }
  else if op == 0x36 {
    "i32.store"
  } else if op == 0x37 {
    "i64.store"
  }
  else if op == 0x3A {
    "i32.store8"
  } else if op == 0x3B {
    "i32.store16"
  }
  else if op == 0x3F {
    "memory.size"
  } else if op == 0x40 {
    "memory.grow"
  }
  else if op == 0x41 {
    "i32.const"
