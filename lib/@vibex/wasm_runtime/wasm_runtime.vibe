    else if op == 0x11 {
      let (_, np) = read_uleb128(buf = code, offset = pc)
      let (_, np2) = read_uleb128(buf = code, offset = np)
      pc = np2
      exit_code = 1
    }
    else if op == 0x3F {
      pc = pc + 1
      stack_push(s = stack, v = Bytes::length(memory) / mem_page_size)
    }
    else if op == 0x40 {
      pc = pc + 1
      let delta = stack_pop(stack)
      let cur_pages = Bytes::length(memory) / mem_page_size
      let new_bytes = delta * mem_page_size
      let mut gi = 0
      while gi < new_bytes {
        Bytes::push(memory, value = 0); gi = gi + 1
      }
      stack_push(s = stack, v = cur_pages)
    }
    else if op == 0x02 {
      let (_, np) = read_sleb128(buf = code, offset = pc); pc = np; Array::push(block_stack, value = (find_end(code = code, start = pc, limit = pc_end), 0))
    }
    else if op == 0x03 {
      let (_, np) = read_sleb128(buf = code, offset = pc); pc = np; Array::push(block_stack, value = (pc, 1))
    }
    else if op == 0x04 {
      let (_, np) = read_sleb128(buf = code, offset = pc); pc = np
      let cond = stack_pop(stack)
      let epc = find_end(code = code, start = pc, limit = pc_end)
      let elpc = find_else(code = code, start = pc, limit = epc)
      if cond != 0 {
        Array::push(block_stack, value = (epc, 0))
      }
      else {
        if elpc > 0 {
          pc = elpc; Array::push(block_stack, value = (epc, 0))
        } else {
          pc = epc
        }
      }
    }
    else if op == 0x05 {
      let blen = Array::length(block_stack)
      if blen > 0 {
        let (t, _) = Array::get(block_stack, at = blen - 1)
        Array::truncate(block_stack, length = blen - 1)
        pc = t
      } else {
        ()
      }
    }
    else if op == 0x0B {
      let blen = Array::length(block_stack)
      if blen > 1 {
        Array::truncate(block_stack, length = blen - 1)
      } else {
        ()
      }
    }
    else if op == 0x0C {
      let (d, np) = read_uleb128(buf = code, offset = pc); pc = np; pc = br_to(block_stack = block_stack, depth = d)
    }
    else if op == 0x0D {
      let (d, np) = read_uleb128(buf = code, offset = pc); pc = np
      let cond = stack_pop(stack)
      if cond != 0 {
        pc = br_to(block_stack = block_stack, depth = d)
      } else {
        ()
      }
    }
    else if op == 0x0E {
      let (count, np) = read_uleb128(buf = code, offset = pc)
      pc = np
      let labels = Array::slice([0], start = 0, end = 0)
      let mut li = 0
      while li <= count {
        let (lbl, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        Array::push(labels, value = lbl)
        li = li + 1
      }
      let idx = stack_pop(stack)
      let target_depth = if idx < count {
        Array::get(labels, at = idx)
      } else {
        Array::get(labels, at = count)
      }
      pc = br_to(block_stack = block_stack, depth = target_depth)
    }
    else if op == 0x0F {
      ret_val = if Array::length(stack) > 0 {
        stack_pop(stack)
      } else {
        0
      }
      exit_code = 2
    }
    else if op == 0x10 {
      let (fi, np) = read_uleb128(buf = code, offset = pc); pc = np
      if fi < Array::length(func_bodies) {
        let (fs, fe, fp, fl) = Array::get(func_bodies, at = fi)
        let cl = Array::slice([0], start = 0, end = 0)
        let mut li = 0
        while li < (fp + fl) {
          Array::push(cl, value = 0); li = li + 1
        }
        let mut pi = fp - 1
        while pi >= 0 {
          Array::set(cl, at = pi, value = stack_pop(stack)); pi = pi - 1
        }
        let cs = Array::slice([0], start = 0, end = 0)
        let (ce, cv) = exec_body(code = code, pc_start = fs, pc_end = fe, locals = cl, stack = cs, memory = memory, globals = globals, func_bodies = func_bodies)
        if ce == 1 {
          exit_code = 1
        } else {
          stack_push(s = stack, v = cv)
        }
      } else {
        ()
      }
    }
    else {
      ()
    }
  }
  if exit_code != 2 {
    ret_val = if Array::length(stack) > 0 {
      stack_pop(stack)
    } else {
      0
    }
  }
  (exit_code, ret_val)
}

/// GC-aware instruction executor.
/// gc_heap is an Array of Arrays. Each entry is a GC object.
/// Struct: [type_idx, field0, field1, ...]
/// Array:  [type_idx, length, elem0, elem1, ...]
/// Null reference = -1, valid reference = index into gc_heap.
export fn exec_body_gc(code: Bytes, pc_start: Int, pc_end: Int, locals: Array[Int], stack: Array[Int], memory: Bytes, globals: Array[Int], func_bodies: Array[(Int, Int, Int, Int)], gc_heap: Array[Array[Int]]) -> (Int, Int) {
  let mut pc = pc_start
  let mut exit_code = 0
  let block_stack = Array::slice([(0, 0)], start = 0, end = 0)
  Array::push(block_stack, value = (pc_end, 0))
  let mut ret_val = 0
  let mem_page_size = 65536
  while (pc >= 0) && (pc < pc_end) && (exit_code == 0) {
    let op = code[pc]
    pc = pc + 1
    if op == 0x41 {
      let (v, np) = read_sleb128(buf = code, offset = pc); pc = np; stack_push(s = stack, v = v)
    }
    else if op == 0x42 {
      let (v, np) = read_sleb128(buf = code, offset = pc); pc = np; stack_push(s = stack, v = v)
    }
    else if op == 0x20 {
      let (i, np) = read_uleb128(buf = code, offset = pc); pc = np; stack_push(s = stack, v = Array::get(locals, at = i))
    }
    else if op == 0x21 {
      let (i, np) = read_uleb128(buf = code, offset = pc); pc = np; Array::set(locals, at = i, value = stack_pop(stack))
    }
    else if op == 0x22 {
      let (i, np) = read_uleb128(buf = code, offset = pc); pc = np; Array::set(locals, at = i, value = stack_peek(stack))
    }
    else if op == 0x23 {
      let (i, np) = read_uleb128(buf = code, offset = pc); pc = np; stack_push(s = stack, v = if i < Array::length(globals) {
        Array::get(globals, at = i)
      } else {
        0
      })
    }
    else if op == 0x24 {
      let (i, np) = read_uleb128(buf = code, offset = pc); pc = np; let v = stack_pop(stack); if i < Array::length(globals) {
        Array::set(globals, at = i, value = v)
      } else {
        ()
      }
    }
    else if op == 0x01 {
      ()
    }
    else if op == 0x00 {
      exit_code = 1
    }
    else if op == 0x1A {
      let _ = stack_pop(stack); ()
    }
    else if op == 0x1B {
      let c = stack_pop(stack); let b = stack_pop(stack); let a = stack_pop(stack); stack_push(s = stack, v = if c != 0 {
        a
      } else {
        b
      })
    }
    else if op == 0xD0 {
      let (_, np) = read_uleb128(buf = code, offset = pc); pc = np; stack_push(s = stack, v = -1)
    }
    else if op == 0xD1 {
      let r = stack_pop(stack); stack_push(s = stack, v = if r == -1 {
        1
      } else {
        0
      })
    }
    else if op == 0xD2 {
      let (fi, np) = read_uleb128(buf = code, offset = pc); pc = np; stack_push(s = stack, v = fi)
    }
    else if op == 0x6A {
      let b = stack_pop(stack); stack_push(s = stack, v = signed_i32(stack_pop(stack) + b))
    }
    else if op == 0x6B {
      let b = stack_pop(stack); stack_push(s = stack, v = signed_i32(stack_pop(stack) - b))
    }
    else if op == 0x6C {
      let b = stack_pop(stack); stack_push(s = stack, v = signed_i32(stack_pop(stack) * b))
    }
    else if op == 0x6D {
      let b = signed_i32(stack_pop(stack))
      let a = signed_i32(stack_pop(stack))
      // The spec traps i32.div_s on division by zero OR on overflow. Only the
      // zero case was here, so INT_MIN / -1 returned the two's-complement
      // wrap (INT_MIN again) where the engine traps (#1745).
      if (b == 0) || ((a == -2147483648) && (b == -1)) {
        exit_code = 1
      } else {
        stack_push(s = stack, v = a / b)
      }
    }
    else if op == 0x6F {
      let b = stack_pop(stack); let a = stack_pop(stack); if b == 0 {
        exit_code = 1
      } else {
        stack_push(s = stack, v = a - ((a / b) * b))
      }
    }
    else if op == 0x71 {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack)&b)
    }
    else if op == 0x72 {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack)|b)
    }
    else if op == 0x73 {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack)^b)
    }
    else if op == 0x74 {
      let b = stack_pop(stack); stack_push(s = stack, v = signed_i32(stack_pop(stack)<<(b&31)))
    }
    else if op == 0x75 {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack)>>(b&31))
    }
    else if op == 0x6E {
      let b = stack_pop(stack); let a = stack_pop(stack); if b == 0 {
        exit_code = 1
      } else {
        let ua = a&0xFFFFFFFF; let ub = b&0xFFFFFFFF; stack_push(s = stack, v = signed_i32(ua / ub))
      }
    }
    else if op == 0x70 {
      let b = stack_pop(stack); let a = stack_pop(stack); if b == 0 {
        exit_code = 1
      } else {
        let ua = a&0xFFFFFFFF; let ub = b&0xFFFFFFFF; stack_push(s = stack, v = signed_i32(ua - ((ua / ub) * ub)))
      }
    }
    else if op == 0x67 {
      stack_push(s = stack, v = clz32(stack_pop(stack)))
    }
    else if op == 0x68 {
      stack_push(s = stack, v = ctz32(stack_pop(stack)))
    }
    else if op == 0x69 {
      stack_push(s = stack, v = popcnt32(stack_pop(stack)))
    }
    else if op == 0x77 {
      let b = stack_pop(stack); stack_push(s = stack, v = signed_i32(rotl32(a = stack_pop(stack), b = b)))
    }
    else if op == 0x78 {
      let b = stack_pop(stack); stack_push(s = stack, v = signed_i32(rotr32(a = stack_pop(stack), b = b)))
    }
    else if op == 0x76 {
      let b = stack_pop(stack); let a = stack_pop(stack)&0xFFFFFFFF; stack_push(s = stack, v = signed_i32((a>>(b&31))&((1<<(32 - (b&31))) - 1)))
    }
    else if op == 0x45 {
      stack_push(s = stack, v = if stack_pop(stack) == 0 {
        1
      } else {
        0
      })
    }
    else if op == 0x46 {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) == b {
        1
      } else {
        0
      })
    }
    else if op == 0x47 {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) != b {
        1
      } else {
        0
      })
    }
    else if op == 0x48 {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) < b {
        1
      } else {
        0
      })
    }
    else if op == 0x4A {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) > b {
        1
      } else {
        0
      })
    }
    else if op == 0x4C {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) <= b {
        1
      } else {
        0
      })
    }
    else if op == 0x4E {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) >= b {
        1
      } else {
        0
      })
    }
    else if op == 0x49 {
      let b = stack_pop(stack); let ub = b&0xFFFFFFFF; let ua = stack_pop(stack)&0xFFFFFFFF; stack_push(s = stack, v = if ua < ub {
        1
      } else {
        0
      })
    }
    else if op == 0x4B {
      let b = stack_pop(stack); let ub = b&0xFFFFFFFF; let ua = stack_pop(stack)&0xFFFFFFFF; stack_push(s = stack, v = if ua > ub {
        1
      } else {
        0
      })
    }
    else if op == 0x4D {
      let b = stack_pop(stack); let ub = b&0xFFFFFFFF; let ua = stack_pop(stack)&0xFFFFFFFF; stack_push(s = stack, v = if ua <= ub {
        1
      } else {
        0
      })
    }
    else if op == 0x4F {
      let b = stack_pop(stack); let ub = b&0xFFFFFFFF; let ua = stack_pop(stack)&0xFFFFFFFF; stack_push(s = stack, v = if ua >= ub {
        1
      } else {
        0
      })
    }
    else if op == 0x7C {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack) + b)
    }
    else if op == 0x7D {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack) - b)
    }
    else if op == 0x7E {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack) * b)
    }
    else if op == 0x7F {
      let b = stack_pop(stack); let a = stack_pop(stack); if b == 0 {
        exit_code = 1
      } else {
        stack_push(s = stack, v = a / b)
      }
    }
    else if op == 0x81 {
      let b = stack_pop(stack); let a = stack_pop(stack); if b == 0 {
        exit_code = 1
      } else {
        stack_push(s = stack, v = a - ((a / b) * b))
      }
    }
    else if op == 0x83 {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack)&b)
    }
    else if op == 0x84 {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack)|b)
    }
    else if op == 0x85 {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack)^b)
    }
    else if op == 0x86 {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack)<<(b&63))
    }
    else if op == 0x87 {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack)>>(b&63))
    }
    else if op == 0x80 {
      let b = stack_pop(stack); let a = stack_pop(stack); if b == 0 {
        exit_code = 1
      } else {
        stack_push(s = stack, v = a / b)
      }
    }
    else if op == 0x82 {
      let b = stack_pop(stack); let a = stack_pop(stack); if b == 0 {
        exit_code = 1
      } else {
        stack_push(s = stack, v = a - ((a / b) * b))
      }
    }
    else if op == 0x79 {
      stack_push(s = stack, v = clz64(stack_pop(stack)))
    }
    else if op == 0x7A {
      stack_push(s = stack, v = ctz64(stack_pop(stack)))
    }
    else if op == 0x7B {
      stack_push(s = stack, v = popcnt64(stack_pop(stack)))
    }
    else if op == 0x89 {
      let b = stack_pop(stack); let a = stack_pop(stack); let shift = b&63; stack_push(s = stack, v = if shift == 0 {
        a
      } else {
        (a<<shift)|((a>>(64 - shift))&((1<<shift) - 1))
      })
    }
    else if op == 0x8A {
      let b = stack_pop(stack); let a = stack_pop(stack); let shift = b&63; stack_push(s = stack, v = if shift == 0 {
        a
      } else {
        ((a>>shift)&((1<<(64 - shift)) - 1))|(a<<(64 - shift))
      })
    }
    else if op == 0x88 {
      let b = stack_pop(stack); let a = stack_pop(stack); let shift = b&63; stack_push(s = stack, v = if shift == 0 {
        a
      } else {
        (a>>shift)&((1<<(64 - shift)) - 1)
      })
    }
    else if op == 0x50 {
      stack_push(s = stack, v = if stack_pop(stack) == 0 {
        1
      } else {
        0
      })
    }
    else if op == 0x51 {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) == b {
        1
      } else {
        0
      })
    }
    else if op == 0x52 {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) != b {
        1
      } else {
        0
      })
    }
    else if op == 0x53 {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) < b {
        1
      } else {
        0
      })
    }
    else if op == 0x55 {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) > b {
        1
      } else {
        0
      })
    }
    else if op == 0x57 {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) <= b {
        1
      } else {
        0
      })
    }
    else if op == 0x59 {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) >= b {
        1
      } else {
        0
      })
    }
    else if op == 0x54 {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) < b {
        1
      } else {
        0
      })
    }
    else if op == 0x56 {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) > b {
        1
      } else {
        0
      })
    }
    else if op == 0x58 {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) <= b {
        1
      } else {
        0
      })
    }
    else if op == 0x5A {
      let b = stack_pop(stack); stack_push(s = stack, v = if stack_pop(stack) >= b {
        1
      } else {
        0
      })
    }
    else if op == 0xA7 {
      stack_push(s = stack, v = signed_i32(stack_pop(stack)&0xFFFFFFFF))
    }
    else if op == 0xAC {
      ()
    }
    else if op == 0xAD {
      stack_push(s = stack, v = stack_pop(stack)&0xFFFFFFFF)
    }
    else if op == 0x28 {
      let (_, np) = read_uleb128(buf = code, offset = pc)
      let (off, np2) = read_uleb128(buf = code, offset = np)
      pc = np2
      let addr = mem_addr(raw = stack_pop(stack), off = off)
      if mem_in_bounds(m = memory, a = addr, width = 4) {
        stack_push(s = stack, v = signed_i32(mem_load_i32(m = memory, a = addr)))
      } else {
        exit_code = 1
      }
    }
    else if op == 0x29 {
      let (_, np) = read_uleb128(buf = code, offset = pc)
      let (off, np2) = read_uleb128(buf = code, offset = np)
      pc = np2
      let addr = mem_addr(raw = stack_pop(stack), off = off)
      if mem_in_bounds(m = memory, a = addr, width = 8) {
        stack_push(s = stack, v = mem_load_i64(m = memory, a = addr))
      } else {
        exit_code = 1
      }
