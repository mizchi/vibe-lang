        exit_code = 1
      }
    }
    else if op == 0x2F {
      let (_, np) = read_uleb128(buf = code, offset = pc)
      let (off, np2) = read_uleb128(buf = code, offset = np)
      pc = np2
      let addr = mem_addr(raw = stack_pop(stack), off = off)
      if mem_in_bounds(m = memory, a = addr, width = 2) {
        stack_push(s = stack, v = mem_load_i16_u(m = memory, a = addr))
      } else {
        exit_code = 1
      }
    }
    else if op == 0x3B {
      let (_, np) = read_uleb128(buf = code, offset = pc)
      let (off, np2) = read_uleb128(buf = code, offset = np)
      pc = np2
      let v = stack_pop(stack)
      let addr = mem_addr(raw = stack_pop(stack), off = off)
      if mem_in_bounds(m = memory, a = addr, width = 2) {
        mem_store_i16(m = memory, a = addr, v = v)
      } else {
        exit_code = 1
      }
    }
    else if op == 0x11 {
      let (_, np) = read_uleb128(buf = code, offset = pc)
      let (_, np2) = read_uleb128(buf = code, offset = np)
      pc = np2
      exit_code = 1
    }
    else if op == 0x3F {
      pc = pc + 1
      stack_push(s = stack, v = Bytes::length(memory) / mem_page_size)
    }
    else if op == 0x40 {
      pc = pc + 1
      let delta = stack_pop(stack)
      let cur_pages = Bytes::length(memory) / mem_page_size
      let new_bytes = delta * mem_page_size
      let mut gi = 0
      while gi < new_bytes {
        Bytes::push(memory, value = 0); gi = gi + 1
      }
      stack_push(s = stack, v = cur_pages)
    }
    else if op == 0x02 {
      let (_, np) = read_sleb128(buf = code, offset = pc); pc = np; Array::push(block_stack, value = (find_end(code = code, start = pc, limit = pc_end), 0))
    }
    else if op == 0x03 {
      let (_, np) = read_sleb128(buf = code, offset = pc); pc = np; Array::push(block_stack, value = (pc, 1))
    }
    else if op == 0x04 {
      let (_, np) = read_sleb128(buf = code, offset = pc); pc = np
      let cond = stack_pop(stack)
      let epc = find_end(code = code, start = pc, limit = pc_end)
      let elpc = find_else(code = code, start = pc, limit = epc)
      if cond != 0 {
        Array::push(block_stack, value = (epc, 0))
      }
      else {
        if elpc > 0 {
          pc = elpc; Array::push(block_stack, value = (epc, 0))
        } else {
          pc = epc
        }
      }
    }
    else if op == 0x05 {
      let blen = Array::length(block_stack)
      if blen > 0 {
        let (t, _) = Array::get(block_stack, at = blen - 1)
        Array::truncate(block_stack, length = blen - 1)
        pc = t
      } else {
        ()
      }
    }
    else if op == 0x0B {
      let blen = Array::length(block_stack)
      if blen > 1 {
        Array::truncate(block_stack, length = blen - 1)
      } else {
        ()
      }
    }
    else if op == 0x0C {
      let (d, np) = read_uleb128(buf = code, offset = pc); pc = np; pc = br_to(block_stack = block_stack, depth = d)
    }
    else if op == 0x0D {
      let (d, np) = read_uleb128(buf = code, offset = pc); pc = np
      let cond = stack_pop(stack)
      if cond != 0 {
        pc = br_to(block_stack = block_stack, depth = d)
      } else {
        ()
      }
    }
    else if op == 0x0E {
      let (count, np) = read_uleb128(buf = code, offset = pc)
      pc = np
      let labels = Array::slice([0], start = 0, end = 0)
      let mut li = 0
      while li <= count {
        let (lbl, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        Array::push(labels, value = lbl)
        li = li + 1
      }
      let idx = stack_pop(stack)
      let target_depth = if idx < count {
        Array::get(labels, at = idx)
      } else {
        Array::get(labels, at = count)
      }
      pc = br_to(block_stack = block_stack, depth = target_depth)
    }
    else if op == 0x0F {
      ret_val = if Array::length(stack) > 0 {
        stack_pop(stack)
      } else {
        0
      }
      exit_code = 2
    }
    else if op == 0x10 {
      let (fi, np) = read_uleb128(buf = code, offset = pc); pc = np
      if fi < Array::length(func_bodies) {
        let (fs, fe, fp, fl) = Array::get(func_bodies, at = fi)
        let cl = Array::slice([0], start = 0, end = 0)
        let mut li = 0
        while li < (fp + fl) {
          Array::push(cl, value = 0); li = li + 1
        }
        let mut pi = fp - 1
        while pi >= 0 {
          Array::set(cl, at = pi, value = stack_pop(stack)); pi = pi - 1
        }
        let cs = Array::slice([0], start = 0, end = 0)
        let (ce, cv) = exec_body_gc(code = code, pc_start = fs, pc_end = fe, locals = cl, stack = cs, memory = memory, globals = globals, func_bodies = func_bodies, gc_heap = gc_heap)
        if ce == 1 {
          exit_code = 1
        } else {
          stack_push(s = stack, v = cv)
        }
      } else {
        ()
      }
    }
    else if op == 0xFB {
      let (sub_op, np) = read_uleb128(buf = code, offset = pc)
      pc = np
      if sub_op == 0 {
        let (type_idx, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        let field_count = if type_idx < Array::length(gc_heap) {
          let type_info = Array::get(gc_heap, at = type_idx)
          if Array::length(type_info) > 0 {
            Array::get(type_info, at = 0)
          } else {
            0
          }
        } else {
          0
        }
        let obj = Array::slice([0], start = 0, end = 0)
        Array::push(obj, value = type_idx)
        let fields_tmp = Array::slice([0], start = 0, end = 0)
        let mut fi = 0
        while fi < field_count {
          Array::push(fields_tmp, value = stack_pop(stack)); fi = fi + 1
        }
        let mut ri = field_count - 1
        while ri >= 0 {
          Array::push(obj, value = Array::get(fields_tmp, at = ri)); ri = ri - 1
        }
        let ref_idx = Array::length(gc_heap)
        Array::push(gc_heap, value = obj)
        stack_push(s = stack, v = ref_idx)
      }
      else if sub_op == 1 {
        let (type_idx, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        let field_count = if type_idx < Array::length(gc_heap) {
          let type_info = Array::get(gc_heap, at = type_idx)
          if Array::length(type_info) > 0 {
            Array::get(type_info, at = 0)
          } else {
            0
          }
        } else {
          0
        }
        let obj = Array::slice([0], start = 0, end = 0)
        Array::push(obj, value = type_idx)
        let mut fi = 0
        while fi < field_count {
          Array::push(obj, value = 0); fi = fi + 1
        }
        let ref_idx = Array::length(gc_heap)
        Array::push(gc_heap, value = obj)
        stack_push(s = stack, v = ref_idx)
      }
      else if sub_op == 2 {
        let (_, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        let (field_idx, np3) = read_uleb128(buf = code, offset = pc)
        pc = np3
        let ref_val = stack_pop(stack)
        if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          let obj = Array::get(gc_heap, at = ref_val)
          stack_push(s = stack, v = Array::get(obj, at = field_idx + 1))
        } else {
          exit_code = 1
        }
      }
      else if sub_op == 3 {
        let (_, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        let (field_idx, np3) = read_uleb128(buf = code, offset = pc)
        pc = np3
        let ref_val = stack_pop(stack)
        if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          let obj = Array::get(gc_heap, at = ref_val)
          stack_push(s = stack, v = Array::get(obj, at = field_idx + 1))
        } else {
          exit_code = 1
        }
      }
      else if sub_op == 4 {
        let (_, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        let (field_idx, np3) = read_uleb128(buf = code, offset = pc)
        pc = np3
        let ref_val = stack_pop(stack)
        if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          let obj = Array::get(gc_heap, at = ref_val)
          stack_push(s = stack, v = Array::get(obj, at = field_idx + 1))
        } else {
          exit_code = 1
        }
      }
      else if sub_op == 5 {
        let (_, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        let (field_idx, np3) = read_uleb128(buf = code, offset = pc)
        pc = np3
        let val = stack_pop(stack)
        let ref_val = stack_pop(stack)
        if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          let obj = Array::get(gc_heap, at = ref_val)
          Array::set(obj, at = field_idx + 1, value = val)
        } else {
          exit_code = 1
        }
      }
      else if sub_op == 6 {
        let (type_idx, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        let length = stack_pop(stack)
        let val = stack_pop(stack)
        let obj = Array::slice([0], start = 0, end = 0)
        Array::push(obj, value = type_idx)
        Array::push(obj, value = length)
        let mut ai = 0
        while ai < length {
          Array::push(obj, value = val); ai = ai + 1
        }
        let ref_idx = Array::length(gc_heap)
        Array::push(gc_heap, value = obj)
        stack_push(s = stack, v = ref_idx)
      }
      else if sub_op == 7 {
        let (type_idx, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        let length = stack_pop(stack)
        let obj = Array::slice([0], start = 0, end = 0)
        Array::push(obj, value = type_idx)
        Array::push(obj, value = length)
        let mut ai = 0
        while ai < length {
          Array::push(obj, value = 0); ai = ai + 1
        }
        let ref_idx = Array::length(gc_heap)
        Array::push(gc_heap, value = obj)
        stack_push(s = stack, v = ref_idx)
      }
      else if sub_op == 0x0B {
        let (_, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        let idx = stack_pop(stack)
        let ref_val = stack_pop(stack)
        if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          let obj = Array::get(gc_heap, at = ref_val)
          stack_push(s = stack, v = Array::get(obj, at = idx + 2))
        } else {
          exit_code = 1
        }
      }
      else if sub_op == 0x0C {
        let (_, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        let idx = stack_pop(stack)
        let ref_val = stack_pop(stack)
        if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          let obj = Array::get(gc_heap, at = ref_val)
          stack_push(s = stack, v = Array::get(obj, at = idx + 2))
        } else {
          exit_code = 1
        }
      }
      else if sub_op == 0x0D {
        let (_, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        let idx = stack_pop(stack)
        let ref_val = stack_pop(stack)
        if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          let obj = Array::get(gc_heap, at = ref_val)
          stack_push(s = stack, v = Array::get(obj, at = idx + 2))
        } else {
          exit_code = 1
        }
      }
      else if sub_op == 0x0E {
        let (_, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        let val = stack_pop(stack)
        let idx = stack_pop(stack)
        let ref_val = stack_pop(stack)
        if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          let obj = Array::get(gc_heap, at = ref_val)
          Array::set(obj, at = idx + 2, value = val)
        } else {
          exit_code = 1
        }
      }
      else if sub_op == 0x0F {
        let ref_val = stack_pop(stack)
        if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          let obj = Array::get(gc_heap, at = ref_val)
          stack_push(s = stack, v = Array::get(obj, at = 1))
        } else {
          exit_code = 1
        }
      }
      else if sub_op == 0x12 {
        let (type_idx, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        let (count, np3) = read_uleb128(buf = code, offset = pc)
        pc = np3
        let obj = Array::slice([0], start = 0, end = 0)
        Array::push(obj, value = type_idx)
        Array::push(obj, value = count)
        let vals_tmp = Array::slice([0], start = 0, end = 0)
        let mut vi = 0
        while vi < count {
          Array::push(vals_tmp, value = stack_pop(stack)); vi = vi + 1
        }
        let mut ri = count - 1
        while ri >= 0 {
          Array::push(obj, value = Array::get(vals_tmp, at = ri)); ri = ri - 1
        }
        let ref_idx = Array::length(gc_heap)
        Array::push(gc_heap, value = obj)
        stack_push(s = stack, v = ref_idx)
      }
      else if sub_op == 0x1A {
        let (_, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
        let ref_val = stack_pop(stack)
        stack_push(s = stack, v = if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          1
        } else {
          0
        })
      }
      else if sub_op == 0x1B {
        let (_, np2) = read_uleb128(buf = code, offset = pc)
        pc = np2
      }
      else {
        ()
      }
    }
    else {
      ()
    }
  }
  if exit_code != 2 {
    ret_val = if Array::length(stack) > 0 {
      stack_pop(stack)
    } else {
      0
    }
  }
  (exit_code, ret_val)
}

/// Whether validate_structure found anything, as a Bool.
///
/// Spelled with `match` rather than `validate_structure(b) != None` at the call
/// site. In an `else if` condition the parser reads `None {` as the start of a
/// record literal, and `pkf run fmt` then REWRITES it to `None::{` -- output
/// that does not parse at all. The first form compiled on one stage2 and not on
/// the one CI builds; the second compiles nowhere. Neither failure names the
/// real problem, so the comparison form is worth avoiding here entirely.
fn module_is_structurally_invalid(_ wasm_bytes: Bytes) -> Bool {
  match validate_structure(wasm_bytes) {
    None => false,
    Some(_) => true
  }
}

export fn exec_module_with_args(wasm_bytes: Bytes, export_name: String, args: Array[Int]) -> (Int, Int) {
  let len = Bytes::length(wasm_bytes)
  if len < 8 {
    (-1, 0)
  }
  else if (wasm_bytes[0] != 0x00) || (wasm_bytes[1] != 0x61) || (wasm_bytes[2] != 0x73) || (wasm_bytes[3] != 0x6D) {
    (-1, 0)
  }
  else if module_is_structurally_invalid(wasm_bytes) {
    // #1745 (5). Length and magic were the only things checked here, so a
    // module whose sections do not survive their own size field reached the
    // executor: one corrupted length byte in a corpus of 54 killed the host
    // PROCESS, uncatchable by this function's caller, which is a containment
    // breach in the one place that exists to run untrusted wasm.
    //
    // Safe to put in front of execution because the never-reject half of
    // validate_structure's contract is MEASURED, not assumed
    // (scripts/test_wasm_validate_parity.sh, against wasm-tools as the
    // oracle). A validator that guessed here would turn a containment fix
    // into a new way to refuse legitimate modules.
    //
    // It still does not type the operand stack, so an ill-TYPED module gets
    // through -- that is the other half of #1745 (5), and it needs a different
    // machine than this one.
    (-1, 0)
  }
  else {
    let type_param_counts = Array::slice([0], start = 0, end = 0)
    let type_result_counts = Array::slice([0], start = 0, end = 0)
    let func_type_indices = Array::slice([0], start = 0, end = 0)
    let code_starts = Array::slice([0], start = 0, end = 0)
    let code_ends = Array::slice([0], start = 0, end = 0)
    let code_local_counts = Array::slice([0], start = 0, end = 0)
    let mut export_func_idx = -1
    let mut mem_pages = 0
    let globals = Array::slice([0], start = 0, end = 0)
    let mut pos = 8
    let mut parse_ok = true
    while (pos < len) && parse_ok {
      let section_id = wasm_bytes[pos]
      pos = pos + 1
      let (section_size, np) = read_uleb128(buf = wasm_bytes, offset = pos)
      pos = np
      let section_end = pos + section_size
      if section_id == 1 {
        let (type_count, tp) = read_uleb128(buf = wasm_bytes, offset = pos)
        let mut tpos = tp
        let mut ti = 0
        while ti < type_count {
          tpos = tpos + 1
          let (param_count, pp) = read_uleb128(buf = wasm_bytes, offset = tpos)
          tpos = pp + param_count
          let (result_count, rp) = read_uleb128(buf = wasm_bytes, offset = tpos)
          tpos = rp + result_count
          Array::push(type_param_counts, value = param_count)
          Array::push(type_result_counts, value = result_count)
          ti = ti + 1
        }
        pos = section_end
      }
      else if section_id == 3 {
        let (func_count, fp) = read_uleb128(buf = wasm_bytes, offset = pos)
        let mut fpos = fp
        let mut fi = 0
        while fi < func_count {
          let (type_idx, np2) = read_uleb128(buf = wasm_bytes, offset = fpos)
          fpos = np2
          Array::push(func_type_indices, value = type_idx)
          fi = fi + 1
        }
        pos = section_end
      }
      else if section_id == 5 {
        let (mem_count, mp) = read_uleb128(buf = wasm_bytes, offset = pos)
        if mem_count > 0 {
          let flags = wasm_bytes[mp]
          let (min_pages, mp2) = read_uleb128(buf = wasm_bytes, offset = mp + 1)
          mem_pages = min_pages
          if (flags&1) == 1 {
            let (_, _mp3) = read_uleb128(buf = wasm_bytes, offset = mp2)
            ()
          }
        }
        pos = section_end
      }
      else if section_id == 6 {
        let (global_count, gp) = read_uleb128(buf = wasm_bytes, offset = pos)
        let mut gpos = gp
        let mut gi = 0
        while gi < global_count {
          gpos = gpos + 2
          let init_op = wasm_bytes[gpos]
          gpos = gpos + 1
          if (init_op == 0x41) || (init_op == 0x42) {
            let (val, gnp) = read_sleb128(buf = wasm_bytes, offset = gpos)
            gpos = gnp
            Array::push(globals, value = val)
          } else {
            Array::push(globals, value = 0)
          }
          while (gpos < section_end) && (wasm_bytes[gpos] != 0x0B) {
            gpos = gpos + 1
          }
          if gpos < section_end {
            gpos = gpos + 1
          }
          gi = gi + 1
        }
        pos = section_end
      }
      else if section_id == 7 {
        let (export_count, ep) = read_uleb128(buf = wasm_bytes, offset = pos)
        let mut epos = ep
        let mut ei = 0
        while ei < export_count {
          let (ename, enp) = read_name(buf = wasm_bytes, offset = epos)
          epos = enp
          let kind = wasm_bytes[epos]
          epos = epos + 1
          let (eidx, enp2) = read_uleb128(buf = wasm_bytes, offset = epos)
          epos = enp2
          if (kind == 0) && (ename == export_name) {
            export_func_idx = eidx
          } else {
            ()
          }
          ei = ei + 1
        }
        pos = section_end
      }
      else if section_id == 10 {
        let (code_count, cp) = read_uleb128(buf = wasm_bytes, offset = pos)
        let mut cpos = cp
        let mut ci = 0
        while ci < code_count {
          let (body_size, cnp) = read_uleb128(buf = wasm_bytes, offset = cpos)
          cpos = cnp
          let body_end = cpos + body_size
          let (local_decl_count, lp) = read_uleb128(buf = wasm_bytes, offset = cpos)
          let mut lpos = lp
          let mut total_locals = 0
          let mut ldi = 0
          while ldi < local_decl_count {
            let (lcount, lnp) = read_uleb128(buf = wasm_bytes, offset = lpos)
            lpos = lnp + 1
            total_locals = total_locals + lcount
            ldi = ldi + 1
          }
          Array::push(code_starts, value = lpos)
          Array::push(code_ends, value = body_end)
          Array::push(code_local_counts, value = total_locals)
          cpos = body_end
          ci = ci + 1
        }
        pos = section_end
      }
      else if section_id == 11 {
        pos = section_end
      }
      else {
        pos = section_end
      }
    }
    if export_func_idx < 0 {
      (-2, 0)
    }
    else {
      let func_bodies = Array::slice([(0, 0, 0, 0)], start = 0, end = 0)
      let num_funcs = Array::length(code_starts)
      let mut fi = 0
      while fi < num_funcs {
        let cs = Array::get(code_starts, at = fi)
        let ce = Array::get(code_ends, at = fi)
        let lc = Array::get(code_local_counts, at = fi)
        let pc = if fi < Array::length(func_type_indices) {
          let tidx = Array::get(func_type_indices, at = fi)
          if tidx < Array::length(type_param_counts) {
            Array::get(type_param_counts, at = tidx)
          } else {
            0
          }
        } else {
          0
        }
        Array::push(func_bodies, value = (cs, ce, pc, lc))
        fi = fi + 1
      }
      let memory = make_memory(if mem_pages > 0 {
        mem_pages
      } else {
        1
      })
      if export_func_idx < Array::length(func_bodies) {
        let (fs, fe, fp, fl) = Array::get(func_bodies, at = export_func_idx)
        let call_locals = Array::slice([0], start = 0, end = 0)
        let mut li = 0
        while li < (fp + fl) {
          Array::push(call_locals, value = 0); li = li + 1
        }
        let mut ai = 0
        while ai < fp {
          if ai < Array::length(args) {
            Array::set(call_locals, at = ai, value = Array::get(args, at = ai))
          } else {
            ()
          }
          ai = ai + 1
        }
        let call_stack = Array::slice([0], start = 0, end = 0)
        let (ec, rv) = exec_body(code = wasm_bytes, pc_start = fs, pc_end = fe, locals = call_locals, stack = call_stack, memory = memory, globals = globals, func_bodies = func_bodies)
        let final_ec = if ec == 2 {
          0
        } else {
          ec
        }
        (final_ec, rv)
      } else {
        (-2, 0)
      }
    }
  }
}

/// Parse a WASM module binary, find export by name, execute it.
/// Returns (exit_code, result). exit_code: 0=ok, 1=trap, -1=parse error, -2=export not found
export fn exec_module(wasm_bytes: Bytes, export_name: String) -> (Int, Int) {
  exec_module_with_args(wasm_bytes = wasm_bytes, export_name = export_name, args = Array::slice([
    0
  ], start = 0, end = 0))
}
