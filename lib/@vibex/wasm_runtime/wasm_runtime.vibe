      }
    }
    else if op == 0x2E {
      let (_, np) = read_uleb128(buf = code, offset = pc)
      let (off, np2) = read_uleb128(buf = code, offset = np)
      pc = np2
      let addr = mem_addr(raw = stack_pop(stack), off = off)
      if mem_in_bounds(m = memory, a = addr, width = 2) {
        stack_push(s = stack, v = mem_load_i16_s(m = memory, a = addr))
