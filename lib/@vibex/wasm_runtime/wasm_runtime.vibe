        let (type_idx, np2) = read_uleb128(code, pc)
        pc = np2
        let length = stack_pop(stack)
        let obj = Array::slice([
          0
        ], 0, 0)
        Array::push(obj, type_idx)
        Array::push(obj, length)
        let mut ai = 0
        while ai < length {
          Array::push(obj, 0); ai = ai + 1
        }
        let ref_idx = Array::length(gc_heap)
        Array::push(gc_heap, obj)
        stack_push(stack, ref_idx)
      }
      else if sub_op == 0x0B {
        let (_, np2) = read_uleb128(code, pc)
        pc = np2
        let idx = stack_pop(stack)
        let ref_val = stack_pop(stack)
        if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          let obj = Array::get(gc_heap, ref_val)
          stack_push(stack, Array::get(obj, idx + 2))
        } else {
          exit_code = 1
        }
      }
      else if sub_op == 0x0C {
        let (_, np2) = read_uleb128(code, pc)
        pc = np2
        let idx = stack_pop(stack)
        let ref_val = stack_pop(stack)
        if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          let obj = Array::get(gc_heap, ref_val)
          stack_push(stack, Array::get(obj, idx + 2))
        } else {
          exit_code = 1
        }
      }
      else if sub_op == 0x0D {
        let (_, np2) = read_uleb128(code, pc)
        pc = np2
        let idx = stack_pop(stack)
        let ref_val = stack_pop(stack)
        if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          let obj = Array::get(gc_heap, ref_val)
          stack_push(stack, Array::get(obj, idx + 2))
        } else {
          exit_code = 1
        }
      }
      else if sub_op == 0x0E {
        let (_, np2) = read_uleb128(code, pc)
        pc = np2
        let val = stack_pop(stack)
        let idx = stack_pop(stack)
        let ref_val = stack_pop(stack)
        if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          let obj = Array::get(gc_heap, ref_val)
          Array::set(obj, idx + 2, val)
        } else {
          exit_code = 1
        }
      }
      else if sub_op == 0x0F {
        let ref_val = stack_pop(stack)
        if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          let obj = Array::get(gc_heap, ref_val)
          stack_push(stack, Array::get(obj, 1))
        } else {
          exit_code = 1
        }
      }
      else if sub_op == 0x12 {
        let (type_idx, np2) = read_uleb128(code, pc)
        pc = np2
        let (count, np3) = read_uleb128(code, pc)
        pc = np3
        let obj = Array::slice([
          0
        ], 0, 0)
        Array::push(obj, type_idx)
        Array::push(obj, count)
        let vals_tmp = Array::slice([
          0
        ], 0, 0)
        let mut vi = 0
        while vi < count {
          Array::push(vals_tmp, stack_pop(stack)); vi = vi + 1
        }
        let mut ri = count - 1
        while ri >= 0 {
          Array::push(obj, Array::get(vals_tmp, ri)); ri = ri - 1
        }
        let ref_idx = Array::length(gc_heap)
        Array::push(gc_heap, obj)
        stack_push(stack, ref_idx)
      }
      else if sub_op == 0x1A {
        let (_, np2) = read_uleb128(code, pc)
        pc = np2
        let ref_val = stack_pop(stack)
        stack_push(stack, if (ref_val >= 0) && (ref_val < Array::length(gc_heap)) {
          1
        } else {
          0
        })
      }
      else if sub_op == 0x1B {
        let (_, np2) = read_uleb128(code, pc)
        pc = np2
      }
      else {
        ()
      }
    }
    else {
      ()
    }
  }
  if exit_code != 2 {
    ret_val = if Array::length(stack) > 0 {
      stack_pop(stack)
    } else {
      0
    }
  }
  (exit_code, ret_val)
}

export fn exec_module_with_args(wasm_bytes: Bytes, export_name: String, args: Array[Int]) -> (Int, Int) {
  let len = Bytes::length(wasm_bytes)
  if len < 8 {
    (-1, 0)
  }
  else if (wasm_bytes[0] != 0x00) || (wasm_bytes[1] != 0x61) || (wasm_bytes[2] != 0x73) || (wasm_bytes[3] != 0x6D) {
    (-1, 0)
  }
  else {
    let type_param_counts = Array::slice([
      0
    ], 0, 0)
    let type_result_counts = Array::slice([
      0
    ], 0, 0)
    let func_type_indices = Array::slice([
      0
    ], 0, 0)
    let code_starts = Array::slice([
      0
    ], 0, 0)
    let code_ends = Array::slice([
      0
    ], 0, 0)
    let code_local_counts = Array::slice([
      0
    ], 0, 0)
    let mut export_func_idx = -1
    let mut mem_pages = 0
    let globals = Array::slice([
      0
    ], 0, 0)
    let mut pos = 8
    let mut parse_ok = true
    while (pos < len) && parse_ok {
      let section_id = wasm_bytes[pos]
      pos = pos + 1
      let (section_size, np) = read_uleb128(wasm_bytes, pos)
      pos = np
      let section_end = pos + section_size
      if section_id == 1 {
        let (type_count, tp) = read_uleb128(wasm_bytes, pos)
        let mut tpos = tp
        let mut ti = 0
        while ti < type_count {
          tpos = tpos + 1
          let (param_count, pp) = read_uleb128(wasm_bytes, tpos)
          tpos = pp + param_count
          let (result_count, rp) = read_uleb128(wasm_bytes, tpos)
          tpos = rp + result_count
          Array::push(type_param_counts, param_count)
          Array::push(type_result_counts, result_count)
          ti = ti + 1
        }
        pos = section_end
      }
      else if section_id == 3 {
        let (func_count, fp) = read_uleb128(wasm_bytes, pos)
        let mut fpos = fp
        let mut fi = 0
        while fi < func_count {
          let (type_idx, np2) = read_uleb128(wasm_bytes, fpos)
          fpos = np2
          Array::push(func_type_indices, type_idx)
          fi = fi + 1
        }
        pos = section_end
      }
      else if section_id == 5 {
        let (mem_count, mp) = read_uleb128(wasm_bytes, pos)
        if mem_count > 0 {
          let flags = wasm_bytes[mp]
          let (min_pages, mp2) = read_uleb128(wasm_bytes, mp + 1)
          mem_pages = min_pages
          if (flags&1) == 1 {
            let (_, _mp3) = read_uleb128(wasm_bytes, mp2)
            ()
          }
        }
        pos = section_end
      }
      else if section_id == 6 {
        let (global_count, gp) = read_uleb128(wasm_bytes, pos)
        let mut gpos = gp
        let mut gi = 0
        while gi < global_count {
          gpos = gpos + 2
          let init_op = wasm_bytes[gpos]
          gpos = gpos + 1
          if (init_op == 0x41) || (init_op == 0x42) {
            let (val, gnp) = read_sleb128(wasm_bytes, gpos)
            gpos = gnp
            Array::push(globals, val)
          } else {
            Array::push(globals, 0)
          }
          while (gpos < section_end) && (wasm_bytes[gpos] != 0x0B) {
            gpos = gpos + 1
          }
          if gpos < section_end {
            gpos = gpos + 1
          }
          gi = gi + 1
        }
        pos = section_end
      }
      else if section_id == 7 {
        let (export_count, ep) = read_uleb128(wasm_bytes, pos)
        let mut epos = ep
        let mut ei = 0
        while ei < export_count {
          let (ename, enp) = read_name(wasm_bytes, epos)
          epos = enp
          let kind = wasm_bytes[epos]
          epos = epos + 1
          let (eidx, enp2) = read_uleb128(wasm_bytes, epos)
          epos = enp2
          if (kind == 0) && (ename == export_name) {
            export_func_idx = eidx
          } else {
            ()
          }
          ei = ei + 1
        }
        pos = section_end
      }
      else if section_id == 10 {
        let (code_count, cp) = read_uleb128(wasm_bytes, pos)
        let mut cpos = cp
        let mut ci = 0
        while ci < code_count {
          let (body_size, cnp) = read_uleb128(wasm_bytes, cpos)
          cpos = cnp
          let body_end = cpos + body_size
          let (local_decl_count, lp) = read_uleb128(wasm_bytes, cpos)
          let mut lpos = lp
          let mut total_locals = 0
          let mut ldi = 0
          while ldi < local_decl_count {
            let (lcount, lnp) = read_uleb128(wasm_bytes, lpos)
            lpos = lnp + 1
            total_locals = total_locals + lcount
            ldi = ldi + 1
          }
          Array::push(code_starts, lpos)
          Array::push(code_ends, body_end)
          Array::push(code_local_counts, total_locals)
          cpos = body_end
          ci = ci + 1
        }
        pos = section_end
      }
      else if section_id == 11 {
        pos = section_end
      }
      else {
        pos = section_end
      }
    }
    if export_func_idx < 0 {
      (-2, 0)
    }
    else {
      let func_bodies = Array::slice([
        (0, 0, 0, 0)
      ], 0, 0)
      let num_funcs = Array::length(code_starts)
      let mut fi = 0
      while fi < num_funcs {
        let cs = Array::get(code_starts, fi)
        let ce = Array::get(code_ends, fi)
        let lc = Array::get(code_local_counts, fi)
        let pc = if fi < Array::length(func_type_indices) {
          let tidx = Array::get(func_type_indices, fi)
          if tidx < Array::length(type_param_counts) {
            Array::get(type_param_counts, tidx)
          } else {
            0
          }
        } else {
          0
        }
        Array::push(func_bodies, (cs, ce, pc, lc))
        fi = fi + 1
      }
      let memory = make_memory(if mem_pages > 0 {
        mem_pages
      } else {
        1
      })
      if export_func_idx < Array::length(func_bodies) {
        let (fs, fe, fp, fl) = Array::get(func_bodies, export_func_idx)
        let call_locals = Array::slice([
          0
        ], 0, 0)
        let mut li = 0
        while li < (fp + fl) {
          Array::push(call_locals, 0); li = li + 1
        }
        let mut ai = 0
        while ai < fp {
          if ai < Array::length(args) {
            Array::set(call_locals, ai, Array::get(args, ai))
          } else {
            ()
          }
          ai = ai + 1
        }
        let call_stack = Array::slice([
          0
        ], 0, 0)
        let (ec, rv) = exec_body(wasm_bytes, fs, fe, call_locals, call_stack, memory, globals, func_bodies)
        let final_ec = if ec == 2 {
          0
        } else {
          ec
        }
        (final_ec, rv)
      } else {
        (-2, 0)
      }
    }
  }
}

/// Parse a WASM module binary, find export by name, execute it.
/// Returns (exit_code, result). exit_code: 0=ok, 1=trap, -1=parse error, -2=export not found
export fn exec_module(wasm_bytes: Bytes, export_name: String) -> (Int, Int) {
  exec_module_with_args(wasm_bytes, export_name, Array::slice([
    0
  ], 0, 0))
}
