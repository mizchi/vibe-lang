    "i64.gt_u"
  }
  else if op == 0x57 {
    "i64.le_s"
  } else if op == 0x58 {
    "i64.le_u"
  }
  else if op == 0x59 {
    "i64.ge_s"
  } else if op == 0x5A {
    "i64.ge_u"
  }
  else if op == 0x67 {
    "i32.clz"
  } else if op == 0x68 {
    "i32.ctz"
  }
  else if op == 0x69 {
    "i32.popcnt"
  }
  else if op == 0x6A {
    "i32.add"
  } else if op == 0x6B {
    "i32.sub"
  }
  else if op == 0x6C {
    "i32.mul"
