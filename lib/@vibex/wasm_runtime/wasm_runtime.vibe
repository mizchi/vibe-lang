    "i32.lt_s"
  }
  else if op == 0x49 {
    "i32.lt_u"
  }
  else if op == 0x4A {
    "i32.gt_s"
  } else if op == 0x4B {
    "i32.gt_u"
  }
  else if op == 0x4C {
    "i32.le_s"
  } else if op == 0x4D {
    "i32.le_u"
  }
  else if op == 0x4E {
    "i32.ge_s"
  } else if op == 0x4F {
    "i32.ge_u"
  }
  else if op == 0x50 {
    "i64.eqz"
  } else if op == 0x51 {
    "i64.eq"
  }
  else if op == 0x52 {
    "i64.ne"
  } else if op == 0x53 {
    "i64.lt_s"
  }
  else if op == 0x54 {
    "i64.lt_u"
  }
  else if op == 0x55 {
