    }
    else if op == 0x49 {
      let b = stack_pop(stack); let ub = b&0xFFFFFFFF; let ua = stack_pop(stack)&0xFFFFFFFF; stack_push(s = stack, v = if ua < ub {
        1
      } else {
        0
      })
    }
    else if op == 0x4B {
      let b = stack_pop(stack); let ub = b&0xFFFFFFFF; let ua = stack_pop(stack)&0xFFFFFFFF; stack_push(s = stack, v = if ua > ub {
        1
      } else {
        0
      })
    }
    else if op == 0x4D {
      let b = stack_pop(stack); let ub = b&0xFFFFFFFF; let ua = stack_pop(stack)&0xFFFFFFFF; stack_push(s = stack, v = if ua <= ub {
        1
      } else {
        0
      })
    }
    else if op == 0x4F {
      let b = stack_pop(stack); let ub = b&0xFFFFFFFF; let ua = stack_pop(stack)&0xFFFFFFFF; stack_push(s = stack, v = if ua >= ub {
        1
      } else {
        0
      })
    }
    else if op == 0x7C {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack) + b)
    }
    else if op == 0x7D {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack) - b)
    }
    else if op == 0x7E {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack) * b)
    }
    else if op == 0x7F {
      let b = stack_pop(stack); let a = stack_pop(stack); if b == 0 {
        exit_code = 1
      } else {
        stack_push(s = stack, v = a / b)
      }
    }
    else if op == 0x81 {
      let b = stack_pop(stack); let a = stack_pop(stack); if b == 0 {
        exit_code = 1
      } else {
        stack_push(s = stack, v = a - ((a / b) * b))
      }
    }
    else if op == 0x83 {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack)&b)
    }
    else if op == 0x84 {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack)|b)
    }
    else if op == 0x85 {
      let b = stack_pop(stack); stack_push(s = stack, v = stack_pop(stack)^b)
