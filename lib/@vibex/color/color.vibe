//# Functions

let esc: String = String::from_char_code(27)

fn wrap(code: String, text: String) -> String {
  "\{esc}[\{code}m\{text}\{esc}[0m"
}

export fn dim(_ text: String) -> String {
  wrap(code = "2", text = text)
}

export fn red(_ text: String) -> String {
  wrap(code = "31", text = text)
}

export fn blue(_ text: String) -> String {
  wrap(code = "34", text = text)
}

export fn bold(_ text: String) -> String {
  wrap(code = "1", text = text)
}

export fn cyan(_ text: String) -> String {
  wrap(code = "36", text = text)
}

export fn black(_ text: String) -> String {
  wrap(code = "30", text = text)
}

export fn green(_ text: String) -> String {
  wrap(code = "32", text = text)
}

export fn strip(_ text: String) -> String {
  let len = String::length(text)
  let mut result = ""
  let mut idx = 0
  // host-era rot (#742 class): `text[i]` returns the char CODE under
  // selfhost, so the old `text[j] == "m"` compared Int to String and the
  // `"\{ch}"` interpolation printed a number — byte-code comparisons and
  // from_char_code throughout instead.
  while idx < len {
    if String::char_code_at(text, at = idx) == 27 && idx + 1 < len && String::char_code_at(text, at = idx + 1) == '[' {
      let mut j = idx + 2
      while j < len && not(String::char_code_at(text, at = j) == 'm') {
        j = j + 1
      }
      idx = j + 1
    } else {
      result = String::concat(result, String::from_char_code(String::char_code_at(text, at = idx)))
      idx = idx + 1
    }
  }
  result
}

export fn white(_ text: String) -> String {
  wrap(code = "37", text = text)
}

export fn bg_red(_ text: String) -> String {
  wrap(code = "41", text = text)
}

export fn italic(_ text: String) -> String {
  wrap(code = "3", text = text)
}

export fn yellow(_ text: String) -> String {
  wrap(code = "33", text = text)
}

export fn bg_blue(_ text: String) -> String {
  wrap(code = "44", text = text)
}

export fn magenta(_ text: String) -> String {
  wrap(code = "35", text = text)
}

export fn bg_green(_ text: String) -> String {
  wrap(code = "42", text = text)
}

export fn bg_yellow(_ text: String) -> String {
  wrap(code = "43", text = text)
}

export fn underline(_ text: String) -> String {
  wrap(code = "4", text = text)
}

export fn bright_red(_ text: String) -> String {
  wrap(code = "91", text = text)
}

export fn bright_blue(_ text: String) -> String {
  wrap(code = "94", text = text)
}

export fn bright_green(_ text: String) -> String {
  wrap(code = "92", text = text)
}

export fn bright_yellow(_ text: String) -> String {
  wrap(code = "93", text = text)
}

export fn strikethrough(_ text: String) -> String {
  wrap(code = "9", text = text)
}

