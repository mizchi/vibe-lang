//# Functions

let esc: String = String::from_char_code(27)

fn wrap(code: String, text: String) -> String {
  "\{esc}[\{code}m\{text}\{esc}[0m"
}

export fn dim(text: String) -> String {
  wrap("2", text)
}

export fn red(text: String) -> String {
  wrap("31", text)
}

export fn blue(text: String) -> String {
  wrap("34", text)
}

export fn bold(text: String) -> String {
  wrap("1", text)
}

export fn cyan(text: String) -> String {
  wrap("36", text)
}

export fn black(text: String) -> String {
  wrap("30", text)
}

export fn green(text: String) -> String {
  wrap("32", text)
}

export fn strip(text: String) -> String {
  let len = String::length(text)
  let mut result = ""
  let mut idx = 0
  // host-era rot (#742 class): `text[i]` returns the char CODE under
  // selfhost, so the old `text[j] == "m"` compared Int to String and the
  // `"\{ch}"` interpolation printed a number — byte-code comparisons and
  // from_char_code throughout instead.
  while idx < len {
    if String::char_code_at(text, idx) == 27 && idx + 1 < len && String::char_code_at(text, idx + 1) == '[' {
      let mut j = idx + 2
      while j < len && not(String::char_code_at(text, j) == 'm') {
        j = j + 1
      }
      idx = j + 1
    } else {
      result = String::concat(result, String::from_char_code(String::char_code_at(text, idx)))
      idx = idx + 1
    }
  }
  result
}

export fn white(text: String) -> String {
  wrap("37", text)
}

export fn bg_red(text: String) -> String {
  wrap("41", text)
}

export fn italic(text: String) -> String {
  wrap("3", text)
}

export fn yellow(text: String) -> String {
  wrap("33", text)
}

export fn bg_blue(text: String) -> String {
  wrap("44", text)
}

export fn magenta(text: String) -> String {
  wrap("35", text)
}

export fn bg_green(text: String) -> String {
  wrap("42", text)
}

export fn bg_yellow(text: String) -> String {
  wrap("43", text)
}

export fn underline(text: String) -> String {
  wrap("4", text)
}

export fn bright_red(text: String) -> String {
  wrap("91", text)
}

export fn bright_blue(text: String) -> String {
  wrap("94", text)
}

export fn bright_green(text: String) -> String {
  wrap("92", text)
}

export fn bright_yellow(text: String) -> String {
  wrap("93", text)
}

export fn strikethrough(text: String) -> String {
  wrap("9", text)
}

