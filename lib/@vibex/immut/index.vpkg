fn ImmutArray::set[T](a: ImmutArray[T], i: Int, v: T) -> ImmutArray[T]
fn ImmutArray::from_array[T](xs: Array[T]) -> ImmutArray[T]
fn ImmutArray::to_array[T](a: ImmutArray[T]) -> Array[T]

