fn ImmutMap::has_key[V](m: ImmutMap[V], key: String) -> Bool
fn ImmutMap::delete[V](m: ImmutMap[V], key: String) -> ImmutMap[V]
fn ImmutMap::size[V](m: ImmutMap[V]) -> Int
fn ImmutMap::keys[V](m: ImmutMap[V]) -> Array[String]

fn ImmutArray::empty[T]() -> ImmutArray[T]
fn ImmutArray::length[T](a: ImmutArray[T]) -> Int
fn ImmutArray::push[T](a: ImmutArray[T], v: T) -> ImmutArray[T]
