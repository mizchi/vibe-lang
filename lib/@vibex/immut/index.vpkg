// @vibex/immut — persistent (immutable) collections (#841 C 群、ADR-0065
// 実験 scope)。0.4.0 並行モデル (ADR-0068) の sendable データの布石:
// 更新は常に新しい値を返し、旧版は構造共有のまま不変。
// - ImmutMap[V]: HAMT (5-bit branching / 32-way)、String key、FNV-1a 31-bit
// - ImmutArray[T]: persistent vector (32-way trie、tail 最適化なしの簡略版)
// 型は bodyless 宣言 (#739 の透過 re-export — 定義は impl 側)。

type ImmutMap[V]
type ImmutArray[T]

fn ImmutMap::hash_key(key: String) -> Int
fn ImmutMap::empty[V]() -> ImmutMap[V]
