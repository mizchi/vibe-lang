//# Imports

import .{
  ImmutArray::empty,
  ImmutArray::get,
  ImmutArray::length,
  ImmutArray::push,
  MapHamt::delete,
  MapHamt::empty,
  MapHamt::get,
  MapHamt::set,
  MapHamt::size
}

//# Misc

test "x/immut index exports the MapHamt API" {
  let m = MapHamt::set(MapHamt::set(MapHamt::empty(), key = "a", value = 1), key = "b", value = 2)
  match MapHamt::get(m, key = "a") {
    Some(v) => assert_eq(v, 1),
    None => assert(false)
  }
  let m2 = MapHamt::delete(m, key = "a")
  assert_eq(MapHamt::size(m2), 1)
  assert_eq(MapHamt::size(m), 2)
}

test "x/immut index exports the ImmutArray API" {
  let a = ImmutArray::push(ImmutArray::push(ImmutArray::empty(), v = 10), v = 20)
  assert_eq(ImmutArray::length(a), 2)
  match ImmutArray::get(a, i = 1) {
    Some(v) => assert_eq(v, 20),
    None => assert(false)
  }
}
