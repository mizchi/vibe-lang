//# Imports

import . {
  ImmutArray::empty, ImmutArray::get, ImmutArray::length, ImmutArray::push, ImmutMap::delete, ImmutMap::empty, ImmutMap::get, ImmutMap::set, ImmutMap::size
}

//# Misc

test "x/immut index exports the ImmutMap API" {
  let m = ImmutMap::set(ImmutMap::set(ImmutMap::empty(), "a", 1), "b", 2)
  match ImmutMap::get(m, "a") {
    Some(v) => assert_eq(v, 1),
    None => assert(false)
  }
  let m2 = ImmutMap::delete(m, "a")
  assert_eq(ImmutMap::size(m2), 1)
  assert_eq(ImmutMap::size(m), 2)
}

test "x/immut index exports the ImmutArray API" {
  let a = ImmutArray::push(ImmutArray::push(ImmutArray::empty(), 10), 20)
  assert_eq(ImmutArray::length(a), 2)
  match ImmutArray::get(a, 1) {
    Some(v) => assert_eq(v, 20),
    None => assert(false)
  }
}
