//# Imports

import ./immut_map.vibe {
  ImmutMap::delete, ImmutMap::empty, ImmutMap::has_key, ImmutMap::set, ImmutMap::size, MapHamt
}

//# Helpers

fn get_or[V](m: MapHamt[V], key: String, fallback: V) -> V {
  match MapHamt::get(m, key = key) {
    Some(v) => v,
    None => fallback
  }
}

fn contains(xs: Array[String], key: String) -> Bool {
  let n = Array::length(xs)
  let mut i = 0
  let mut found = false
  while i < n {
    if Array::get(xs, at = i) == key {
      found = true
    }
    i = i + 1
  }
  found
}

fn int_key(_ i: Int) -> String {
  "k\{i}"
}

//# Basics

test "empty map has size 0 and no keys" {
  let m: MapHamt[Int] = MapHamt::empty()
  assert_eq(MapHamt::size(m), 0)
  assert(MapHamt::get(m, key = "missing") is None)
  assert(not(MapHamt::has_key(m, key = "missing")))
  assert_eq(Array::length(MapHamt::keys(m)), 0)
}

test "set then get" {
  let m = MapHamt::set(MapHamt::empty(), key = "a", value = 1)
  let m2 = MapHamt::set(m, key = "b", value = 2)
  assert_eq(get_or(m = m2, key = "a", fallback = -1), 1)
  assert_eq(get_or(m = m2, key = "b", fallback = -1), 2)
  assert(MapHamt::get(m2, key = "c") is None)
  assert_eq(MapHamt::size(m2), 2)
}

test "set overwrites without growing" {
  let m = MapHamt::set(MapHamt::set(MapHamt::empty(), key = "a", value = 1), key = "a", value = 42)
  assert_eq(get_or(m = m, key = "a", fallback = -1), 42)
  assert_eq(MapHamt::size(m), 1)
}

test "string values" {
  let m = MapHamt::set(MapHamt::set(MapHamt::empty(), key = "name", value = "vibe"), key = "kind", value = "lang")
  assert_eq(get_or(m = m, key = "name", fallback = "?"), "vibe")
  assert_eq(get_or(m = m, key = "kind", fallback = "?"), "lang")
}

//# Persistence (old version stays unchanged)

test "set does not mutate the old map" {
  let m0: MapHamt[Int] = MapHamt::empty()
  let m1 = MapHamt::set(m0, key = "a", value = 1)
  let m2 = MapHamt::set(m1, key = "b", value = 2)
  let m3 = MapHamt::set(m2, key = "a", value = 99)
  // every older version still sees its own state
  assert_eq(MapHamt::size(m0), 0)
  assert(MapHamt::get(m0, key = "a") is None)
  assert_eq(get_or(m = m1, key = "a", fallback = -1), 1)
  assert(MapHamt::get(m1, key = "b") is None)
  assert_eq(get_or(m = m2, key = "a", fallback = -1), 1)
  assert_eq(get_or(m = m2, key = "b", fallback = -1), 2)
  assert_eq(get_or(m = m3, key = "a", fallback = -1), 99)
  assert_eq(get_or(m = m3, key = "b", fallback = -1), 2)
  assert_eq(MapHamt::size(m2), 2)
  assert_eq(MapHamt::size(m3), 2)
}

test "delete does not mutate the old map" {
  let m1 = MapHamt::set(MapHamt::set(MapHamt::empty(), key = "a", value = 1), key = "b", value = 2)
  let m2 = MapHamt::delete(m1, key = "a")
  assert(MapHamt::get(m2, key = "a") is None)
  assert_eq(MapHamt::size(m2), 1)
  // old version keeps both entries
  assert_eq(get_or(m = m1, key = "a", fallback = -1), 1)
  assert_eq(get_or(m = m1, key = "b", fallback = -1), 2)
  assert_eq(MapHamt::size(m1), 2)
}

test "old map fully intact after many sets (structural sharing)" {
  let mut base: MapHamt[Int] = MapHamt::empty()
  let mut i = 0
  while i < 50 {
    base = MapHamt::set(base, key = int_key(i), value = i * 7)
    i = i + 1
  }
  // derive a heavily modified new version
  let mut derived = base
  let mut j = 0
  while j < 50 {
    derived = MapHamt::set(derived, key = int_key(j), value = 0 - j)
    j = j + 1
  }
  derived = MapHamt::set(derived, key = "extra", value = 12345)
  // base still has every original value
  let mut k = 0
  while k < 50 {
    assert_eq(get_or(m = base, key = int_key(k), fallback = -1), k * 7)
    k = k + 1
  }
  assert(MapHamt::get(base, key = "extra") is None)
  assert_eq(MapHamt::size(base), 50)
  assert_eq(MapHamt::size(derived), 51)
  assert_eq(get_or(m = derived, key = "extra", fallback = -1), 12345)
}

//# Deletion

test "delete missing key is a no-op" {
  let m = MapHamt::set(MapHamt::empty(), key = "a", value = 1)
  let m2 = MapHamt::delete(m, key = "nope")
  assert_eq(MapHamt::size(m2), 1)
  assert_eq(get_or(m = m2, key = "a", fallback = -1), 1)
  let e: MapHamt[Int] = MapHamt::empty()
  assert_eq(MapHamt::size(MapHamt::delete(e, key = "x")), 0)
}

test "delete everything returns to empty" {
  let mut m: MapHamt[Int] = MapHamt::empty()
  let mut i = 0
  while i < 20 {
    m = MapHamt::set(m, key = int_key(i), value = i)
    i = i + 1
  }
  let mut j = 0
  while j < 20 {
    m = MapHamt::delete(m, key = int_key(j))
    j = j + 1
  }
  assert_eq(MapHamt::size(m), 0)
  assert(m is MEmpty)
}

test "delete collapses branch chains back to a leaf" {
  let mut m: MapHamt[Int] = MapHamt::empty()
  let mut i = 0
  while i < 40 {
    m = MapHamt::set(m, key = int_key(i), value = i)
    i = i + 1
  }
  // remove all but one entry: the trie must shrink to a single leaf
  let mut j = 0
  while j < 40 {
    if j != 17 {
      m = MapHamt::delete(m, key = int_key(j))
    }
    j = j + 1
  }
  assert_eq(MapHamt::size(m), 1)
  assert_eq(get_or(m = m, key = int_key(17), fallback = -1), 17)
  match m {
    MLeaf(h, k, v) => {
      assert_eq(h, MapHamt::hash_key(int_key(17)))
      assert_eq(k, int_key(17))
      assert_eq(v, 17)
    },
    _ => assert(false)
  }
}

//# Hash & collisions
// "c2ya8" and "czki6" collide under the 31-bit FNV-1a used by MapHamt
// (both hash to 713304578) — found by brute force over short keys.

test "hash_key stays in 31 bits" {
  assert(MapHamt::hash_key("") >= 0)
  assert(MapHamt::hash_key("") <= 0x7FFFFFFF)
  assert(MapHamt::hash_key("hello world") >= 0)
  assert(MapHamt::hash_key("hello world") <= 0x7FFFFFFF)
  // distinct short keys should hash differently (sanity, not a guarantee)
  assert(MapHamt::hash_key("a") != MapHamt::hash_key("b"))
}

test "colliding keys both live in a Collision node" {
  assert_eq(MapHamt::hash_key("c2ya8"), MapHamt::hash_key("czki6"))
  let m = MapHamt::set(MapHamt::set(MapHamt::empty(), key = "c2ya8", value = 111), key = "czki6", value = 222)
  assert_eq(MapHamt::size(m), 2)
  assert_eq(get_or(m = m, key = "c2ya8", fallback = -1), 111)
  assert_eq(get_or(m = m, key = "czki6", fallback = -1), 222)
  // the two equal-hash leaves must have fused into a Collision node
  match m {
    MCollision(h, ks, vs) => {
      assert_eq(h, MapHamt::hash_key("c2ya8"))
      assert_eq(Array::length(ks), 2)
      assert_eq(Array::length(vs), 2)
    },
    _ => assert(false)
  }
}

test "collision set overwrite and delete" {
  let m = MapHamt::set(MapHamt::set(MapHamt::empty(), key = "c2ya8", value = 1), key = "czki6", value = 2)
  // overwrite inside the collision node
  let m2 = MapHamt::set(m, key = "czki6", value = 20)
  assert_eq(get_or(m = m2, key = "czki6", fallback = -1), 20)
  assert_eq(get_or(m = m2, key = "c2ya8", fallback = -1), 1)
  assert_eq(MapHamt::size(m2), 2)
  // old version unchanged
  assert_eq(get_or(m = m, key = "czki6", fallback = -1), 2)
  // deleting one member collapses Collision back to a Leaf
  let m3 = MapHamt::delete(m2, key = "c2ya8")
  assert_eq(MapHamt::size(m3), 1)
  assert_eq(get_or(m = m3, key = "czki6", fallback = -1), 20)
  assert(m3 is MLeaf(_, _, _))
  // get of a same-hash but absent key misses inside the collision node
  assert(MapHamt::get(m2, key = "c2ya9") is None)
}

test "collision node with a third same-slot key" {
  // a non-colliding key still routes past the collision node fine
  let m = MapHamt::set(MapHamt::set(MapHamt::set(MapHamt::empty(), key = "c2ya8", value = 1), key = "czki6", value = 2), key = "other", value = 3)
  assert_eq(MapHamt::size(m), 3)
  assert_eq(get_or(m = m, key = "c2ya8", fallback = -1), 1)
  assert_eq(get_or(m = m, key = "czki6", fallback = -1), 2)
  assert_eq(get_or(m = m, key = "other", fallback = -1), 3)
  let keys = MapHamt::keys(m)
  assert_eq(Array::length(keys), 3)
  assert(contains(xs = keys, key = "c2ya8"))
  assert(contains(xs = keys, key = "czki6"))
  assert(contains(xs = keys, key = "other"))
}

//# Scale

test "1000 inserts then all gets" {
  let mut m: MapHamt[Int] = MapHamt::empty()
  let mut i = 0
  while i < 1000 {
    m = MapHamt::set(m, key = int_key(i), value = i * 3 + 1)
    i = i + 1
  }
  assert_eq(MapHamt::size(m), 1000)
  let mut j = 0
  while j < 1000 {
    assert_eq(get_or(m = m, key = int_key(j), fallback = -1), j * 3 + 1)
    j = j + 1
  }
  assert(MapHamt::get(m, key = "k1000") is None)
  assert(MapHamt::get(m, key = "unrelated") is None)
}

test "1000 inserts then delete half" {
  let mut m: MapHamt[Int] = MapHamt::empty()
  let mut i = 0
  while i < 1000 {
    m = MapHamt::set(m, key = int_key(i), value = i)
    i = i + 1
  }
  let mut j = 0
  while j < 1000 {
    if j % 2 == 0 {
      m = MapHamt::delete(m, key = int_key(j))
    }
    j = j + 1
  }
  assert_eq(MapHamt::size(m), 500)
  let mut k = 0
  while k < 1000 {
    if k % 2 == 0 {
      assert(MapHamt::get(m, key = int_key(k)) is None)
    } else {
      assert_eq(get_or(m = m, key = int_key(k), fallback = -1), k)
    }
    k = k + 1
  }
}

test "keys returns every key exactly once" {
  let mut m: MapHamt[Int] = MapHamt::empty()
  let mut i = 0
  while i < 100 {
    m = MapHamt::set(m, key = int_key(i), value = i)
    i = i + 1
  }
  // overwrite a few — must not duplicate keys
  m = MapHamt::set(m, key = int_key(3), value = 33)
  m = MapHamt::set(m, key = int_key(77), value = 777)
  let ks = MapHamt::keys(m)
  assert_eq(Array::length(ks), 100)
  assert_eq(MapHamt::size(m), 100)
  // no duplicates: every listed key occurs exactly once
  let n = Array::length(ks)
  let mut a = 0
  while a < n {
    let key = Array::get(ks, at = a)
    let mut count = 0
    let mut b = 0
    while b < n {
      if Array::get(ks, at = b) == key {
        count = count + 1
      }
      b = b + 1
    }
    assert_eq(count, 1)
    a = a + 1
  }
  // and every inserted key is present
  let mut c = 0
  while c < 100 {
    assert(contains(xs = ks, key = int_key(c)))
    c = c + 1
  }
}

//# The deprecated `ImmutMap::*` spelling (ADR-0100 (3) / #1262)
//#
//# The rename keeps working for code that never spells the type out, which is
//# the whole point of shipping aliases rather than a hard break. Pinning it
//# here means the alias block cannot be dropped by accident -- and the
//# `vibe check` warning that names the replacement is pinned separately, in
//# compiler_gate.sh 103.

test "the legacy ImmutMap spelling still builds and reads the same map" {
  let m = ImmutMap::set(m = ImmutMap::set(m = ImmutMap::empty(), key = "a", value = 1), key = "b", value = 2)
  assert(ImmutMap::size(m) == 2)
  assert(ImmutMap::has_key(m = m, key = "a"))
  // ... and it is the SAME type, so the new spelling reads what the old wrote
  assert(MapHamt::size(m) == 2)
  match MapHamt::get(m, key = "b") {
    Some(v) => assert(v == 2),
    None => assert(false)
  }
  let dropped = ImmutMap::delete(m = m, key = "a")
  assert(MapHamt::size(dropped) == 1)
  assert(!MapHamt::has_key(dropped, key = "a"))
  // the older version is untouched -- persistence survives the alias hop
  assert(ImmutMap::size(m) == 2)
}
