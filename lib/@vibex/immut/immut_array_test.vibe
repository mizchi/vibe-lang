//# Imports

import ./immut_array.vibe {
  ImmutArray
}

//# Helpers

fn get_or[T](a: ImmutArray[T], i: Int, fallback: T) -> T {
  match ImmutArray::get(a, i = i) {
    Some(v) => v,
    None => fallback
  }
}

fn push_n(a: ImmutArray[Int], from: Int, count: Int) -> ImmutArray[Int] {
  let mut out = a
  let mut i = 0
  while i < count {
    out = ImmutArray::push(out, v = (from + i) * 3 + 1)
    i = i + 1
  }
  out
}

//# Basics

test "empty vector" {
  let a: ImmutArray[Int] = ImmutArray::empty()
  assert_eq(ImmutArray::length(a), 0)
  assert(ImmutArray::get(a, i = 0) is None)
  assert_eq(Array::length(ImmutArray::to_array(a)), 0)
}

test "push then get" {
  let a = ImmutArray::push(ImmutArray::push(ImmutArray::push(ImmutArray::empty(), v = 10), v = 20), v = 30)
  assert_eq(ImmutArray::length(a), 3)
  assert_eq(get_or(a = a, i = 0, fallback = -1), 10)
  assert_eq(get_or(a = a, i = 1, fallback = -1), 20)
  assert_eq(get_or(a = a, i = 2, fallback = -1), 30)
}

test "string elements" {
  let a = ImmutArray::push(ImmutArray::push(ImmutArray::empty(), v = "hello"), v = "world")
  assert_eq(get_or(a = a, i = 0, fallback = "?"), "hello")
  assert_eq(get_or(a = a, i = 1, fallback = "?"), "world")
}

test "bounds: negative and past-end get are None" {
  let a = ImmutArray::push(ImmutArray::empty(), v = 5)
  assert(ImmutArray::get(a, i = -1) is None)
  assert(ImmutArray::get(a, i = 1) is None)
  assert(ImmutArray::get(a, i = 100) is None)
}

//# Persistence (old version stays unchanged)

test "push does not mutate the old vector" {
  let a0: ImmutArray[Int] = ImmutArray::empty()
  let a1 = ImmutArray::push(a0, v = 1)
  let a2 = ImmutArray::push(a1, v = 2)
  assert_eq(ImmutArray::length(a0), 0)
  assert(ImmutArray::get(a0, i = 0) is None)
  assert_eq(ImmutArray::length(a1), 1)
  assert(ImmutArray::get(a1, i = 1) is None)
  assert_eq(get_or(a = a1, i = 0, fallback = -1), 1)
  assert_eq(ImmutArray::length(a2), 2)
  assert_eq(get_or(a = a2, i = 1, fallback = -1), 2)
}

test "set does not mutate the old vector (structural sharing)" {
  let base = push_n(a = ImmutArray::empty(), from = 0, count = 100)
  let modified = ImmutArray::set(ImmutArray::set(base, i = 0, v = -100), i = 64, v = -6400)
  assert_eq(get_or(a = modified, i = 0, fallback = 0), -100)
  assert_eq(get_or(a = modified, i = 64, fallback = 0), -6400)
  // untouched slots shared with base
  assert_eq(get_or(a = modified, i = 50, fallback = 0), 50 * 3 + 1)
  // base is fully intact
  let mut i = 0
  while i < 100 {
    assert_eq(get_or(a = base, i = i, fallback = -1), i * 3 + 1)
    i = i + 1
  }
  assert_eq(ImmutArray::length(base), 100)
  assert_eq(ImmutArray::length(modified), 100)
}

test "set out of range is a no-op" {
  let a = ImmutArray::push(ImmutArray::empty(), v = 7)
  let b = ImmutArray::set(a, i = 5, v = 99)
  assert_eq(ImmutArray::length(b), 1)
  assert_eq(get_or(a = b, i = 0, fallback = -1), 7)
  assert(ImmutArray::get(b, i = 5) is None)
  let c = ImmutArray::set(a, i = -1, v = 99)
  assert_eq(get_or(a = c, i = 0, fallback = -1), 7)
}

test "long chain of old versions all stay valid" {
  // capture 3 snapshots along a push chain and check each afterwards
  let s10 = push_n(a = ImmutArray::empty(), from = 0, count = 10)
  let s40 = push_n(a = s10, from = 10, count = 30)
  let s80 = push_n(a = s40, from = 40, count = 40)
  assert_eq(ImmutArray::length(s10), 10)
  assert_eq(ImmutArray::length(s40), 40)
  assert_eq(ImmutArray::length(s80), 80)
  let mut i = 0
  while i < 10 {
    assert_eq(get_or(a = s10, i = i, fallback = -1), i * 3 + 1)
    i = i + 1
  }
  let mut j = 0
  while j < 40 {
    assert_eq(get_or(a = s40, i = j, fallback = -1), j * 3 + 1)
    j = j + 1
  }
  assert(ImmutArray::get(s10, i = 10) is None)
  assert(ImmutArray::get(s40, i = 40) is None)
}

//# Scale & level growth (leaf 32 -> depth 2 at 33 -> depth 3 past 1024)

test "push across the 32-element leaf boundary" {
  let a = push_n(a = ImmutArray::empty(), from = 0, count = 33)
  assert_eq(ImmutArray::length(a), 33)
  assert_eq(get_or(a = a, i = 31, fallback = -1), 31 * 3 + 1)
  assert_eq(get_or(a = a, i = 32, fallback = -1), 32 * 3 + 1)
}

test "1100 pushes then all gets (crosses the 1024 boundary)" {
  let a = push_n(a = ImmutArray::empty(), from = 0, count = 1100)
  assert_eq(ImmutArray::length(a), 1100)
  let mut i = 0
  while i < 1100 {
    assert_eq(get_or(a = a, i = i, fallback = -1), i * 3 + 1)
    i = i + 1
  }
  assert(ImmutArray::get(a, i = 1100) is None)
}

test "set at deep indexes after level growth" {
  let a = push_n(a = ImmutArray::empty(), from = 0, count = 1100)
  let b = ImmutArray::set(ImmutArray::set(a, i = 1050, v = -1), i = 0, v = -2)
  assert_eq(get_or(a = b, i = 1050, fallback = 0), -1)
  assert_eq(get_or(a = b, i = 0, fallback = 0), -2)
  assert_eq(get_or(a = b, i = 1099, fallback = 0), 1099 * 3 + 1)
  // old version unchanged at both ends
  assert_eq(get_or(a = a, i = 1050, fallback = 0), 1050 * 3 + 1)
  assert_eq(get_or(a = a, i = 0, fallback = 0), 0 * 3 + 1)
}

//# Conversions

test "from_array / to_array roundtrip" {
  let src = [3, 1, 4, 1, 5, 9, 2, 6]
  let a = ImmutArray::from_array(src)
  assert_eq(ImmutArray::length(a), 8)
  assert_eq(get_or(a = a, i = 0, fallback = -1), 3)
  assert_eq(get_or(a = a, i = 7, fallback = -1), 6)
  let back = ImmutArray::to_array(a)
  assert_eq(Array::length(back), 8)
  let mut i = 0
  while i < 8 {
    assert_eq(Array::get(back, at = i), Array::get(src, at = i))
    i = i + 1
  }
}

test "to_array of a large vector preserves order" {
  let a = push_n(a = ImmutArray::empty(), from = 0, count = 200)
  let xs = ImmutArray::to_array(a)
  assert_eq(Array::length(xs), 200)
  let mut i = 0
  while i < 200 {
    assert_eq(Array::get(xs, at = i), i * 3 + 1)
    i = i + 1
  }
}

test "from_array of empty array" {
  let src: Array[Int] = []
  let a = ImmutArray::from_array(src)
  assert_eq(ImmutArray::length(a), 0)
  assert(ImmutArray::get(a, i = 0) is None)
}
