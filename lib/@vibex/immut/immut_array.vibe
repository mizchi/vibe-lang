//# @vibex/immut — ImmutArray: persistent (immutable) vector, 32-way trie.
//#
//# Clojure-style persistent vector SIMPLIFIED: no tail buffer — every push
//# copies the O(log32 n) path from root to the last leaf. push / set return
//# a NEW vector; the old version stays valid and unchanged, sharing all
//# untouched subtrees (structural sharing). 0.4.0 concurrency groundwork
//# (ADR-0068): immutable, hence sendable between tasks.
//#
//# Shape invariants:
//# - leaves hold up to 32 elements; internal nodes up to 32 children
//# - `shift` is the root level (0 = root is a leaf; +5 per level)
//# - the trie is left-packed: index i lives at 5-bit digit path
//#   (i >> shift) & 31, ..., i & 31
//# - the root overflows exactly when length == 1 << (shift + 5); a new
//#   root is added above (old root = child 0, new path = child 1)

//# Types

/// Trie node (package-private; the contract exposes only ImmutArray).
enum VecNode[T] {
  VLeafN(Array[T]);
  VBranchN(Array[VecNode[T]])
}

/// (length, shift, root)
export enum ImmutArray[T] {
  IAVec(Int, Int, VecNode[T])
}

//# Internal helpers

fn va_empty[T]() -> Array[T] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

fn va1[T](_ a: T) -> Array[T] {
  let b = ArrayBuilder::new()
  ArrayBuilder::push(b, value = a)
  ArrayBuilder::freeze(b)
}

fn va2[T](a: T, b2: T) -> Array[T] {
  let b = ArrayBuilder::new()
  ArrayBuilder::push(b, value = a)
  ArrayBuilder::push(b, value = b2)
  ArrayBuilder::freeze(b)
}

/// Copy with slot idx replaced (old array untouched).
fn va_set_at[T](xs: Array[T], idx: Int, v: T) -> Array[T] {
  let n = Array::length(xs)
  let b = ArrayBuilder::new()
  let mut i = 0
  while i < n {
    if i == idx {
      ArrayBuilder::push(b, value = v)
    } else {
      ArrayBuilder::push(b, value = Array::get(xs, at = i))
    }
    i = i + 1
  }
  ArrayBuilder::freeze(b)
}

/// Copy with v appended (old array untouched).
fn va_append_one[T](xs: Array[T], v: T) -> Array[T] {
  let n = Array::length(xs)
  let b = ArrayBuilder::new()
  let mut i = 0
  while i < n {
    ArrayBuilder::push(b, value = Array::get(xs, at = i))
    i = i + 1
  }
  ArrayBuilder::push(b, value = v)
  ArrayBuilder::freeze(b)
}

/// A fresh single-element spine from level `shift` down to a leaf.
fn new_path[T](shift: Int, v: T) -> VecNode[T] {
  if shift == 0 {
    VLeafN(va1(v))
  } else {
    VBranchN(va1(new_path(shift = shift - 5, v = v)))
  }
}

/// Append at index idx (== old length) under `node` at level `shift`,
/// copying only the touched path. Caller guarantees the subtree is not full.
fn node_push[T](node: VecNode[T], shift: Int, idx: Int, v: T) -> VecNode[T] {
  match node {
    VLeafN(vals) => VLeafN(va_append_one(xs = vals, v = v)),
    VBranchN(kids) => {
      let ci = (idx>>shift)&0x1F
      if ci < Array::length(kids) {
        VBranchN(va_set_at(xs = kids, idx = ci, v = node_push(node = Array::get(kids, at = ci), shift = shift - 5, idx = idx, v = v)))
      } else {
        VBranchN(va_append_one(xs = kids, v = new_path(shift = shift - 5, v = v)))
      }
    }
  }
}

fn node_get[T](node: VecNode[T], shift: Int, i: Int) -> T {
  match node {
    VLeafN(vals) => Array::get(vals, at = i&0x1F),
    VBranchN(kids) => node_get(node = Array::get(kids, at = (i>>shift)&0x1F), shift = shift - 5, i = i)
  }
}

fn node_set[T](node: VecNode[T], shift: Int, i: Int, v: T) -> VecNode[T] {
  match node {
    VLeafN(vals) => VLeafN(va_set_at(xs = vals, idx = i&0x1F, v = v)),
    VBranchN(kids) => {
      let ci = (i>>shift)&0x1F
      VBranchN(va_set_at(xs = kids, idx = ci, v = node_set(node = Array::get(kids, at = ci), shift = shift - 5, i = i, v = v)))
    }
  }
}

//# Public API

export fn ImmutArray::empty[T]() -> ImmutArray[T] {
  IAVec(0, 0, VLeafN(va_empty()))
}

export fn ImmutArray::length[T](_ a: ImmutArray[T]) -> Int {
  match a {
    IAVec(len, _, _) => len
  }
}

/// Returns a NEW vector with v appended; the receiver is unchanged.
export fn ImmutArray::push[T](_ a: ImmutArray[T], v: T) -> ImmutArray[T] {
  match a {
    IAVec(len, shift, root) => {
      if len == 0 {
        IAVec(1, 0, VLeafN(va1(v)))
      }
      else if len == (1<<(shift + 5)) {
        // root full: grow one level (old root left, new spine right)
        IAVec(len + 1, shift + 5, VBranchN(va2(a = root, b2 = new_path(shift = shift, v = v))))
      }
      else {
        IAVec(len + 1, shift, node_push(node = root, shift = shift, idx = len, v = v))
      }
    }
  }
}

export fn ImmutArray::get[T](_ a: ImmutArray[T], i: Int) -> Option[T] {
  match a {
    IAVec(len, shift, root) => {
      if i < 0 || i >= len {
        None
      } else {
        Some(node_get(node = root, shift = shift, i = i))
      }
    }
  }
}

/// Returns a NEW vector with slot i replaced; the receiver is unchanged.
/// Out-of-range i returns the receiver as-is (no-op).
export fn ImmutArray::set[T](_ a: ImmutArray[T], i: Int, v: T) -> ImmutArray[T] {
  match a {
    IAVec(len, shift, root) => {
      if i < 0 || i >= len {
        IAVec(len, shift, root)
      } else {
        IAVec(len, shift, node_set(node = root, shift = shift, i = i, v = v))
      }
    }
  }
}

export fn ImmutArray::from_array[T](_ xs: Array[T]) -> ImmutArray[T] {
  let n = Array::length(xs)
  let mut out = ImmutArray::empty()
  let mut i = 0
  while i < n {
    out = ImmutArray::push(out, v = Array::get(xs, at = i))
    i = i + 1
  }
  out
}

export fn ImmutArray::to_array[T](_ a: ImmutArray[T]) -> Array[T] {
  match a {
    IAVec(len, shift, root) => {
      let b = ArrayBuilder::new()
      let mut i = 0
      while i < len {
        ArrayBuilder::push(b, value = node_get(node = root, shift = shift, i = i))
        i = i + 1
      }
      ArrayBuilder::freeze(b)
    }
  }
}
