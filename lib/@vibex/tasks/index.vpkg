name = @vibex/tasks
version = 0.0.1
description =
  #|Process exit for a .vibex task: die, expect, and finish.
  #|Argument grammar belongs to @vibex/argparse.
deps = {
  @vibe/console : 0.0.1
  @vibe/process : 0.0.1
}

generated_hash =

// Process exit for a `.vibex` task. `die` writes stderr and exits 1,
// `expect` does that when a condition fails, and `finish` exits only
// when the status is non-zero. Reading argv is `@vibex/argparse`.

fn die(message: String) -> Unit with Stderr + Process
fn expect(cond: Bool, message: String) -> Unit with Stderr + Process
fn finish(status: Int) -> Unit with Process
