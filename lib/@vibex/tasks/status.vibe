import @vibe/console {
  eprintln
}
import @vibe/process {
  exit
}

/// Print `message` to stderr and exit 1. A task's own name belongs in the
/// message; this function does not add one.
export fn die(message: String) -> Unit with Stderr + Process {
  eprintln(message)
  exit(1)
}

export fn expect(cond: Bool, message: String) -> Unit with Stderr + Process {
  if cond {
    ()
  } else {
    die(message)
  }
}

/// Exit with `status` when it is non-zero. Zero returns, so a clean task
/// still falls off the end of `main`.
export fn finish(status: Int) -> Unit with Process {
  if status != 0 {
    exit(status)
  } else {
    ()
  }
}
