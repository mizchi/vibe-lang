//# Imports

import ./adler32.vibe {
  adler32
}

import ./deflate.vibe {
  deflate_stored
}

import ./inflate.vibe {
  inflate
}

//# Functions

/// Wrap raw DEFLATE in a zlib stream: 2-byte header + DEFLATE + 4-byte Adler-32.
///
/// Header bytes (RFC 1950):
///   byte 0: CMF
///     bits 0..3 = CM (8 = deflate)
///     bits 4..7 = CINFO (7 = 32K window, the standard)
///     → 0x78
///   byte 1: FLG, where (CMF<<8 | FLG) must be a multiple of 31.
///     We use FLG = 0x01 → 0x7801 is divisible by 31. This is the
///     "no preset dictionary, fastest" variant.
export fn zlib_compress_stored(data: Bytes) -> Bytes {
  let out = Bytes::new()
  Bytes::push(out, 0x78)
  Bytes::push(out, 0x01)
  Bytes::append(out, deflate_stored(data))
  let adler = adler32(data)
  // big-endian
  Bytes::push(out, (adler>>24)&0xFF)
  Bytes::push(out, (adler>>16)&0xFF)
  Bytes::push(out, (adler>>8)&0xFF)
  Bytes::push(out, adler&0xFF)
  out
}

/// Parse a zlib stream and return the raw decompressed bytes.
/// Throws on header/checksum mismatch.
export fn zlib_decompress(data: Bytes) -> Bytes with Error {
  let len = Bytes::length(data)
  if len < 6 {
    throw("zlib: input too short")
  }
  let cmf = Bytes::get(data, 0)
  let flg = Bytes::get(data, 1)
  let cm = cmf&0x0F
  if cm != 8 {
    throw("zlib: unsupported compression method")
  }
  if ((cmf * 256 + flg) % 31) != 0 {
    throw("zlib: header check bits mismatch")
  }
  if (flg&0x20) != 0 {
    throw("zlib: preset dictionary not supported")
  }
  // DEFLATE payload is bytes [2 .. len-4); trailer is the last 4 bytes.
  let deflate_payload = Bytes::slice(data, 2, len - 4)
  let result = inflate(deflate_payload)
  let expected_adler =
  (Bytes::get(data, len - 4)<<24)|
  (Bytes::get(data, len - 3)<<16)|
  (Bytes::get(data, len - 2)<<8)|
  Bytes::get(data, len - 1)
  let actual_adler = adler32(result)
  if expected_adler != actual_adler {
    throw("zlib: adler32 mismatch")
  }
  result
}

