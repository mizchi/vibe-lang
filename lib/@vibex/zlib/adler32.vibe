//# Functions

// Adler-32 checksum (RFC 1950).
// Two rolling sums modulo 65521 packed into a 32-bit word.

let mod_adler = 65521

export fn adler32_init() -> Int {
  // Initial state: A=1, B=0  →  encoded as (B<<16) | A = 1
  1
}

/// Update an Adler-32 state with `count` bytes from `buf` starting at `off`.
export fn adler32_update(state: Int, buf: Bytes, off: Int, count: Int) -> Int {
  let mut a = state&0xFFFF
  let mut b = (state>>16)&0xFFFF
  let mut i = 0
  while i < count {
    a = (a + Bytes::get(buf, off + i)) % mod_adler
    b = (b + a) % mod_adler
    i = i + 1
  }
  ((b&0xFFFF)<<16)|(a&0xFFFF)
}

export fn adler32(buf: Bytes) -> Int {
  adler32_update(adler32_init(), buf, 0, Bytes::length(buf))
}
