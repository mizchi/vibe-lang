//# Types

// Mutable bit-stream reader (LSB-first, the DEFLATE convention).
//
// Uses `mut` struct fields (ADR-0052). The reader is a handle that
// callers pass around; the cursor advances by direct field assignment.

export struct BitReader {
  buf: Bytes;
  mut byte_pos: Int;
  mut bit_pos: Int
}

export fn new_reader(buf: Bytes) -> BitReader {
  BitReader::{
    buf: buf, byte_pos: 0, bit_pos: 0
  }
}

/// Read `n` bits (n <= 24), advancing the cursor. Throws on EOF.
export fn read_bits(r: BitReader, n: Int) -> Int with Error {
  let mut value = 0
  let mut shift = 0
  let mut remaining = n
  let mut bp = r.byte_pos
  let mut bi = r.bit_pos
  let buf_len = Bytes::length(r.buf)
  while remaining > 0 {
    if bp >= buf_len {
      throw("bitstream: EOF")
    }
    let byte = Bytes::get(r.buf, bp)
    let avail = 8 - bi
    let take = if remaining < avail {
      remaining
    } else {
      avail
    }
    let chunk = (byte>>bi)&((1<<take) - 1)
    value = value|(chunk<<shift)
    shift = shift + take
    remaining = remaining - take
    bi = bi + take
    if bi >= 8 {
      bi = 0
      bp = bp + 1
    }
  }
  r.byte_pos = bp
  r.bit_pos = bi
  value
}

/// Skip remaining bits in current byte; next read starts at the next byte.
export fn align_to_byte(r: BitReader) -> Unit {
  if r.bit_pos != 0 {
    r.byte_pos = r.byte_pos + 1
    r.bit_pos = 0
  }
}

/// Read one whole byte (must be byte-aligned).
export fn read_byte(r: BitReader) -> Int with Error {
  if r.bit_pos != 0 {
    throw("bitstream: read_byte requires byte alignment")
  }
  let bp = r.byte_pos
  if bp >= Bytes::length(r.buf) {
    throw("bitstream: EOF on read_byte")
  }
  r.byte_pos = bp + 1
  Bytes::get(r.buf, bp)
}

//# Writer

// Mutable bit-stream writer (LSB-first). Uses `mut` fields for the
// bit accumulator + bit count (ADR-0052).

export struct BitWriter {
  buf: Bytes;
  mut acc: Int;
  mut acc_bits: Int
}

export fn new_writer() -> BitWriter {
  BitWriter::{
    buf: Bytes::new(), acc: 0, acc_bits: 0
  }
}

export fn write_bits(w: BitWriter, value: Int, n: Int) -> Unit {
  let mut acc = w.acc
  let mut acc_bits = w.acc_bits
  acc = acc|((value&((1<<n) - 1))<<acc_bits)
  acc_bits = acc_bits + n
  while acc_bits >= 8 {
    Bytes::push(w.buf, acc&0xFF)
    acc = (acc>>8)&0xFFFFFF
    acc_bits = acc_bits - 8
  }
  w.acc = acc
  w.acc_bits = acc_bits
}

/// Flush any partial byte (pad with zero bits) and align to byte boundary.
export fn flush_to_byte(w: BitWriter) -> Unit {
  if w.acc_bits > 0 {
    Bytes::push(w.buf, w.acc&0xFF)
    w.acc = 0
    w.acc_bits = 0
  }
}

export fn writer_bytes(w: BitWriter) -> Bytes {
  w.buf
}

export fn write_byte(w: BitWriter, b: Int) -> Unit {
  // Precondition: byte-aligned (callers must call flush_to_byte first).
  Bytes::push(w.buf, b&0xFF)
}
