//# Imports

import . {
  PriorityQueue::from_array, PriorityQueue::new_int_max, PriorityQueue::pop, PriorityQueue::push, PriorityQueue::to_sorted_array, int_cmp_asc
}

//# Misc

test "x/pqueue index exports the PriorityQueue API" {
  let q = PriorityQueue::new_int_max()
  PriorityQueue::push(q, 2)
  PriorityQueue::push(q, 9)
  PriorityQueue::push(q, 5)
  assert(PriorityQueue::pop(q) == Some(9))
  assert(PriorityQueue::pop(q) == Some(5))
  assert(PriorityQueue::pop(q) == Some(2))
  assert(PriorityQueue::pop(q) is None)
  let sorted = PriorityQueue::to_sorted_array(PriorityQueue::from_array([3, 1, 2], int_cmp_asc))
  assert(sorted == [1, 2, 3])
}
