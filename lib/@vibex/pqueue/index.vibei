version 0.0.1

// @vibex/pqueue — 優先度付きキュー (binary min-heap, issue #841 B 群,
// ADR-0065 実験 scope)。explicit-dict 方式: 比較関数 `cmp: (T, T) -> Int`
// を closure field で持ち、`cmp(a, b) < 0` の要素から dequeue される
// (数値昇順 comparator で min-heap、反転で max-heap)。同順位 (cmp == 0)
// 同士の順序は保証しない (not stable)。
// PriorityQueue は bodyless type 宣言 (#739 の透過 re-export — 定義は
// impl 側)。PriorityQueue::* は名前空間 fn 宣言 (#752)。
//
// push/pop O(log n)、peek O(1)、from_array O(n) (Floyd heapify、入力は
// コピーされ非破壊)、to_sorted_array O(n log n) (非破壊)。backing buffer
// は @vibex/deque と同じ generic 割り当て方式 (最初の push まで空)。

import ./pqueue.vibe {}

type PriorityQueue[T]

fn PriorityQueue::new[T](cmp: (T, T) -> Int) -> PriorityQueue[T]
fn PriorityQueue::new_int_min() -> PriorityQueue[Int]
fn PriorityQueue::new_int_max() -> PriorityQueue[Int]
fn PriorityQueue::push[T](q: PriorityQueue[T], x: T) -> Unit
fn PriorityQueue::pop[T](q: PriorityQueue[T]) -> Option[T]
fn PriorityQueue::peek[T](q: PriorityQueue[T]) -> Option[T]
fn PriorityQueue::length[T](q: PriorityQueue[T]) -> Int
fn PriorityQueue::is_empty[T](q: PriorityQueue[T]) -> Bool
fn PriorityQueue::from_array[T](arr: Array[T], cmp: (T, T) -> Int) -> PriorityQueue[T]
fn PriorityQueue::to_sorted_array[T](q: PriorityQueue[T]) -> Array[T]
fn PriorityQueue::clear[T](q: PriorityQueue[T]) -> Unit
fn int_cmp_asc(a: Int, b: Int) -> Int
fn int_cmp_desc(a: Int, b: Int) -> Int

let version: String
