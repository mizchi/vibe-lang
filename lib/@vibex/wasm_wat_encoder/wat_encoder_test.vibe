//# Imports

import ./wat_encoder.vibe {
  compile
}

//# Functions

fn check_magic(bytes: Bytes) -> Bool {
  if Bytes::length(bytes) < 8 {
    false
  }
  else {
    (bytes[0] == 0x00) && (bytes[1] == 0x61) && (bytes[2] == 0x73) && (bytes[3] == 0x6D) &&
    (bytes[4] == 0x01) && (bytes[5] == 0x00) && (bytes[6] == 0x00) && (bytes[7] == 0x00)
  }
}

fn hex1(d: Int) -> String {
  if d < 10 {
    String::from_char_code(48 + d)
  } else {
    String::from_char_code(55 + d)
  }
}

fn hex2(n: Int) -> String {
  String::concat(hex1((n>>4)&15), hex1(n&15))
}

/// Encode `(f32.const <lit>)` and return the 4 literal bytes as big-endian
/// hex -- the IEEE-754 bit pattern the module actually carries, which is the
/// part every other float test here leaves unchecked.
fn f32_const_bits(lit: String) -> String {
  let src = String::concat(String::concat("(module (func (export \"f\") (result f32) f32.const ", lit), "))",)
  let bytes = compile(src)
  let len = Bytes::length(bytes)
  let mut i = 0
  let mut out = "NOT-FOUND"
  while i + 5 < len {
    // 0x43 is f32.const; in this one-instruction body it is followed by the 4
    // literal bytes and then 0x0B (end). Requiring the 0x0B keeps a stray 0x43
    // length or index byte from matching.
    if bytes[i] == 0x43 && bytes[i + 5] == 0x0B {
      out = String::concat(String::concat(hex2(bytes[i + 4]), hex2(bytes[i + 3])), String::concat(hex2(bytes[i + 2]), hex2(bytes[i + 1])),)
      i = len
    } else {
      i = i + 1
    }
  }
  out
}

fn find_export(bytes: Bytes, name: String) -> Bool {
  let len = Bytes::length(bytes)
  let mut i = 8
  let mut found = false
  while (i < len) && (found == false) {
    let sec_id = bytes[i]
    i = i + 1
    let mut size = 0
    let mut shift = 0
    let mut reading = true
    while (i < len) && reading {
      let byte = bytes[i]
      size = size|((byte&0x7F)<<shift)
      i = i + 1
      if (byte&0x80) == 0 {
        reading = false
      }
      else {
        shift = shift + 7
      }
    }
    if sec_id == 7 {
      let sec_end = i + size
      let mut cnt = 0
      let mut shift2 = 0
      let mut reading2 = true
      while (i < sec_end) && reading2 {
        let byte = bytes[i]
        cnt = cnt|((byte&0x7F)<<shift2)
        i = i + 1
        if (byte&0x80) == 0 {
          reading2 = false
        }
        else {
          shift2 = shift2 + 7
        }
      }
      let mut ei = 0
      while (ei < cnt) && (found == false) {
        let mut nlen = 0
        let mut shift3 = 0
        let mut reading3 = true
        while (i < sec_end) && reading3 {
          let byte = bytes[i]
          nlen = nlen|((byte&0x7F)<<shift3)
          i = i + 1
          if (byte&0x80) == 0 {
            reading3 = false
          }
          else {
            shift3 = shift3 + 7
          }
        }
        let mut ename = ""
        let mut ni = 0
        while ni < nlen {
          ename = String::concat(ename, String::from_char_code(bytes[i]))
          i = i + 1
          ni = ni + 1
        }
        i = i + 1
        let mut reading4 = true
        while (i < sec_end) && reading4 {
          let byte = bytes[i]
          i = i + 1
          if (byte&0x80) == 0 {
            reading4 = false
          }
        }
        if ename == name {
          found = true
        }
        ei = ei + 1
      }
      i = sec_end
    } else {
      i = i + size
    }
  }
  found
}

fn check_sections_ordered(bytes: Bytes) -> Bool {
  let len = Bytes::length(bytes)
  if len < 8 {
    true
  }
  else {
    let mut i = 8
    let mut prev_id = -1
    let mut ok = true
    while (i < len) && ok {
      let sec_id = bytes[i]
      i = i + 1
      let mut size = 0
      let mut shift = 0
      let mut reading = true
      while (i < len) && reading {
        let byte = bytes[i]
        size = size|((byte&0x7F)<<shift)
        i = i + 1
        if (byte&0x80) == 0 {
          reading = false
        }
        else {
          shift = shift + 7
        }
      }
      if sec_id > 0 {
        if sec_id <= prev_id {
          ok = false
        }
        else {
          prev_id = sec_id
        }
      }
      i = i + size
    }
    ok
  }
}

//# Misc

test "minimal module" {
  let bytes = compile("(module)")
  assert(check_magic(bytes))
  assert(Bytes::length(bytes) == 8)
}

test "simple func" {
  let bytes = compile("(module (func (result i32) i32.const 42))")
  assert(check_magic(bytes))
  assert(check_sections_ordered(bytes))
  assert(Bytes::length(bytes) > 8)
}

test "export func" {
  let bytes = compile("(module (func (export \"main\") (result i32) i32.const 42))")
  assert(check_magic(bytes))
  assert(check_sections_ordered(bytes))
  assert(find_export(bytes, "main"))
}

test "params" {
  let bytes = compile("(module (func (export \"add\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.add))")
  assert(check_magic(bytes))
  assert(check_sections_ordered(bytes))
  assert(find_export(bytes, "add"))
}

test "memory" {
  let bytes = compile("(module (memory 1) (func (export \"f\") (result i32) i32.const 0 i32.load))")
  assert(check_magic(bytes))
  assert(check_sections_ordered(bytes))
  assert(find_export(bytes, "f"))
}

test "multiple funcs" {
  let wat = "(module (func $helper (result i32) i32.const 10) (func (export \"main\") (result i32) call $helper i32.const 5 i32.add))"
  let bytes = compile(wat)
  assert(check_magic(bytes))
  assert(check_sections_ordered(bytes))
  assert(find_export(bytes, "main"))
}

test "import" {
  let bytes = compile("(module (import \"env\" \"log\" (func (param i32))))")
  assert(check_magic(bytes))
  assert(check_sections_ordered(bytes))
  // Should have type section and import section
  assert(Bytes::length(bytes) > 8)
}

test "global" {
  let bytes = compile("(module (global i32 (i32.const 42)))")
  assert(check_magic(bytes))
  assert(check_sections_ordered(bytes))
}

test "data section" {
  let bytes = compile("(module (memory 1) (data (i32.const 0) \"hello\"))")
  assert(check_magic(bytes))
  assert(check_sections_ordered(bytes))
  assert(Bytes::length(bytes) > 8)
}

test "roundtrip magic and sections" {
  let wat = "(module (func (export \"add\") (param i32 i32) (result i32) local.get 0 local.get 1 i32.add) (memory 1) (data (i32.const 0) \"test\"))"
  let bytes = compile(wat)
  assert(check_magic(bytes))
  assert(check_sections_ordered(bytes))
  assert(find_export(bytes, "add"))
  // Verify it has multiple sections (type, func, memory, export, code, data = 6 sections)
  assert(Bytes::length(bytes) > 30)
}

test "f64 const" {
  let bytes = compile("(module (func (export \"f\") (result f64) f64.const 3.14))")
  assert(check_magic(bytes))
  assert(check_sections_ordered(bytes))
  assert(find_export(bytes, "f"))
}

// 上の "f64 const" は magic / セクション順 / export の有無しか見ておらず、
// **オペランドのバイト列が丸ごと誤っていても通る**。f64 のビットパターンを
// 62-bit tagged な `Int` 1 つで運んでいた旧実装 (`make_i64` /
// `Double::to_i64_bits`) が長く放置されたのはこれが理由なので、出てくる
// 8 バイトそのものを固定する。
//
// 注: subnormal (例 1.5e-323) はここでは扱わない。`parse_decimal_double` が
// 誤った値を返す**別の既存バグ**で、hi/lo 化の前後で挙動が変わらないことは
// 確認済み。
fn f64_operand(bytes: Bytes) -> Array[Int] {
  let out: Array[Int] = [
  ]
  let mut i = 0
  while i + 8 < Bytes::length(bytes) {
    if Bytes::get(bytes, i) == 0x44 {
      let mut k = 0
      while k < 8 {
        Array::push(out, Bytes::get(bytes, i + 1 + k))
        k = k + 1
      }
      i = Bytes::length(bytes)
    } else {
      i = i + 1
    }
  }
  out
}

fn assert_f64_operand(wat: String, want: Array[Int]) -> Unit {
  let got = f64_operand(compile(wat))
  assert(Array::length(got) == 8)
  let mut i = 0
  while i < 8 {
    assert(Array::get(got, i) == Array::get(want, i))
    i = i + 1
  }
}

test "f64.const emits the IEEE-754 little-endian bit pattern" {
  // 1.0 = 0x3FF0000000000000. 値が Int の上限 (2^61-1) の約 2 倍あるので、
  // 1 つの Int で運ぼうとすると必ず壊れる。
  assert_f64_operand("(module (func (export \"f\") (result f64) f64.const 1.0))", [
    0,
    0,
    0,
    0,
    0,
    0,
    240,
    63
  ])
  // -2.0 = 0xC000000000000000 (符号 bit が立ち、上位側だけが非ゼロ)
  assert_f64_operand("(module (func (export \"f\") (result f64) f64.const -2.0))", [
    0,
    0,
    0,
    0,
    0,
    0,
    0,
    192
  ])
  // inf は上位側だけのケース
  assert_f64_operand("(module (func (export \"f\") (result f64) f64.const inf))", [
    0,
    0,
    0,
    0,
    0,
    0,
    240,
    127
  ])
}

test "f32 const" {
  let bytes = compile("(module (func (export \"f\") (result f32) f32.const 1.5))")
  assert(check_magic(bytes))
  assert(check_sections_ordered(bytes))
  assert(find_export(bytes, "f"))
}

// The test above -- and every other float test here -- only checks that a
// module came out with the right shape. None of them look at the literal
// bytes, so the encoder was free to emit a different number than the source
// asked for, which is exactly what it did: f64->f32 narrowing truncated the
// mantissa instead of rounding to nearest-even, and flushed f32 subnormals to
// zero. `f32.const 1.5` is exactly representable, so the one value under test
// could not show either bug.
//
// Expected bit patterns come from IEEE-754, not from this implementation.
test "f32 const literal bits: round to nearest, ties to even" {
  // Exactly representable -- unchanged by rounding.
  inspect(f32_const_bits("1.5"), "3FC00000")
  inspect(f32_const_bits("2.5"), "40200000")
  inspect(f32_const_bits("0.0"), "00000000")
  // Not representable: the discarded bits round the mantissa UP. Truncation
  // produced 3DCCCCCC / 3E4CCCCC / 40490FCF here, each 1 ULP low.
  inspect(f32_const_bits("0.1"), "3DCCCCCD")
  inspect(f32_const_bits("0.2"), "3E4CCCCD")
  inspect(f32_const_bits("3.14159"), "40490FD0")
  inspect(f32_const_bits("-0.1"), "BDCCCCCD")
  // A tie: 16777217 sits halfway between two f32s, and ties-to-even picks the
  // one with an even mantissa (16777216).
  inspect(f32_const_bits("16777217.0"), "4B800000")
}

test "f32 const literal bits: subnormals and overflow" {
  // Below the smallest normal f32 (2^-126) but above zero. These were all
  // flushed to 00000000.
  inspect(f32_const_bits("1e-40"), "000116C2")
  inspect(f32_const_bits("1e-45"), "00000001")
  // 1.5e-45 is under the midpoint between the first two subnormals
  // (2.1e-45), so it rounds DOWN to the first one.
  inspect(f32_const_bits("1.5e-45"), "00000001")
  inspect(f32_const_bits("2.8e-45"), "00000002")
  // Genuinely too small to represent.
  inspect(f32_const_bits("1e-46"), "00000000")
  // The largest finite f32, and the first value that overflows to infinity.
  inspect(f32_const_bits("3.4028235e38"), "7F7FFFFF")
  inspect(f32_const_bits("3.5e38"), "7F800000")
}

test "f64 arithmetic" {
  let bytes = compile("(module (func (export \"f\") (param f64 f64) (result f64) local.get 0 local.get 1 f64.add))")
  assert(check_magic(bytes))
  assert(find_export(bytes, "f"))
}

test "f32 compare" {
  let bytes = compile("(module (func (export \"f\") (param f32 f32) (result i32) local.get 0 local.get 1 f32.lt))")
  assert(check_magic(bytes))
  assert(find_export(bytes, "f"))
}

test "float conversion" {
  let bytes = compile("(module (func (export \"f\") (param i32) (result f64) local.get 0 f64.convert_i32_s))")
  assert(check_magic(bytes))
  assert(find_export(bytes, "f"))
}

test "table and elem" {
  let wat = "(module (table 2 funcref) (func $a (result i32) i32.const 1) (func $b (result i32) i32.const 2) (elem (i32.const 0) $a $b))"
  let bytes = compile(wat)
  assert(check_magic(bytes))
  assert(check_sections_ordered(bytes))
}

test "call_indirect" {
  let wat = "(module (type (func (result i32))) (table 2 funcref) (func $f (result i32) i32.const 42) (elem (i32.const 0) $f) (func (export \"main\") (result i32) i32.const 0 call_indirect 0))"
  let bytes = compile(wat)
  assert(check_magic(bytes))
  assert(check_sections_ordered(bytes))
}

test "br_table" {
  let bytes = compile("(module (func (export \"f\") (param i32) (result i32) (block (block (block (local.get 0) (br_table 0 1 2)) (return (i32.const 10))) (return (i32.const 20))) (i32.const 30)))")
  assert(check_magic(bytes))
  assert(find_export(bytes, "f"))
}

test "i64 sub-word load" {
  let bytes = compile("(module (memory 1) (func (export \"f\") (result i64) i32.const 0 i64.load8_u))")
  assert(check_magic(bytes))
  assert(find_export(bytes, "f"))
}

test "f64 load store" {
  let bytes = compile("(module (memory 1) (func (export \"f\") (param f64) i32.const 0 local.get 0 f64.store))")
  assert(check_magic(bytes))
  assert(find_export(bytes, "f"))
}
