        let next = pos + 1
        let (align0, offset0, next2) = parse_mem_args(src, tokens, next, end_pos, 2)
        write_uleb128(buf, align0)
        write_uleb128(buf, offset0)
        next2
      }
      else if kw == "br_table" {
        Bytes::push(buf, 0x0E)
        let labels = empty_int_array()
        let mut next = pos + 1
        while (next < end_pos) && ((tok_type(tokens, next) == tok_int) || (tok_type(tokens, next) == tok_ident)) {
          let arg = tok_text(src, tokens, next)
          if tok_type(tokens, next) == tok_ident {
            let idx = map_get(label_names, label_indices, arg)
            let depth = if idx >= 0 {
              label_depth - idx - 1
            } else {
              0
            }
            Array::push(labels, depth)
          } else {
            Array::push(labels, parse_int(arg))
          }
          next = next + 1
        }
        let label_count = Array::length(labels)
        if label_count > 0 {
          write_uleb128(buf, label_count - 1)
          let mut li = 0
          while li < label_count {
            write_uleb128(buf, Array::get(labels, li))
            li = li + 1
          }
        } else {
          write_uleb128(buf, 0)
          write_uleb128(buf, 0)
        }
        next
      }
      else if kw == "call_indirect" {
        Bytes::push(buf, 0x11)
        let next = pos + 1
        if (next < end_pos) && (tok_type(tokens, next) == tok_lparen) && ((next + 1) < end_pos) && (tok_text(src, tokens, next + 1) == "type") {
          let type_pos = next + 2
          if type_pos < end_pos {
            let type_arg = tok_text(src, tokens, type_pos)
            if tok_type(tokens, type_pos) == tok_int {
              write_uleb128(buf, parse_int(type_arg))
            } else {
              write_uleb128(buf, 0)
            }
          } else {
            write_uleb128(buf, 0)
          }
          Bytes::push(buf, 0x00)
          let mut skip = type_pos + 1
          if (skip < end_pos) && (tok_type(tokens, skip) == tok_rparen) {
            skip = skip + 1
          }
          skip
        } else if (next < end_pos) && (tok_type(tokens, next) == tok_int) {
          write_uleb128(buf, parse_int(tok_text(src, tokens, next)))
          Bytes::push(buf, 0x00)
          next + 1
        } else {
          write_uleb128(buf, 0)
          Bytes::push(buf, 0x00)
          next
        }
      }
      else if kw == "f32.const" {
        Bytes::push(buf, 0x43)
        let next = pos + 1
        if next < end_pos {
          let bits = parse_f32_bits(tok_text(src, tokens, next))
          write_f32_le(buf, bits)
          next + 1
        } else {
          next
        }
      }
      else if kw == "f64.const" {
        Bytes::push(buf, 0x44)
        let next = pos + 1
        if next < end_pos {
          let (bits_hi, bits_lo) = parse_f64_bits(tok_text(src, tokens, next))
          write_f64_le(buf, bits_hi, bits_lo)
          next + 1
        } else {
          next
        }
      }
      else {
        pos + 1
      }
    }
