        Bytes::push(global_payload, value = 0x41)
      }
      write_sleb128(buf = global_payload, val = Array::get(global_init_vals, at = gli))
      Bytes::push(global_payload, value = 0x0B)
      gli = gli + 1
    }
    emit_section(out = out, section_id = 6, payload = global_payload)
  }
  let export_count = Array::length(export_names)
  if export_count > 0 {
    let export_payload = Bytes::new()
    write_uleb128(buf = export_payload, val = export_count)
    let mut ei = 0
    while ei < export_count {
      write_name(buf = export_payload, s = Array::get(export_names, at = ei))
      Bytes::push(export_payload, value = Array::get(export_kinds, at = ei))
      write_uleb128(buf = export_payload, val = Array::get(export_indices, at = ei))
      ei = ei + 1
    }
    emit_section(out = out, section_id = 7, payload = export_payload)
  }
  if start_func >= 0 {
    let start_payload = Bytes::new()
    write_uleb128(buf = start_payload, val = start_func)
    emit_section(out = out, section_id = 8, payload = start_payload)
  }
  if Array::length(elem_offsets) > 0 {
    let elem_payload = Bytes::new()
    write_uleb128(buf = elem_payload, val = Array::length(elem_offsets))
    let mut eli = 0
    while eli < Array::length(elem_offsets) {
      Bytes::push(elem_payload, value = 0x00)
      Bytes::push(elem_payload, value = 0x41)
      write_sleb128(buf = elem_payload, val = Array::get(elem_offsets, at = eli))
      Bytes::push(elem_payload, value = 0x0B)
      let efuncs = Array::get(elem_func_indices, at = eli)
      write_uleb128(buf = elem_payload, val = Array::length(efuncs))
      let mut efi = 0
      while efi < Array::length(efuncs) {
        write_uleb128(buf = elem_payload, val = Array::get(efuncs, at = efi))
        efi = efi + 1
      }
      eli = eli + 1
    }
    emit_section(out = out, section_id = 9, payload = elem_payload)
  }
  if func_count > 0 {
    let code_payload = Bytes::new()
    write_uleb128(buf = code_payload, val = func_count)
    let mut ci = 0
    while ci < func_count {
      let body = compile_func_body(src = src, tokens = tokens, body_start = Array::get(func_bodies_start, at = ci), body_end = Array::get(func_bodies_end, at = ci), func_names = func_names, func_indices = func_indices, global_names = global_names, global_indices = global_indices, param_names = Array::get(func_param_names, at = ci), param_count = Array::get(func_param_counts, at = ci), local_types = Array::get(func_local_types, at = ci), local_decl_names = Array::get(func_local_names, at = ci))
      let body_len = Bytes::length(body)
      write_uleb128(buf = code_payload, val = body_len)
      append_bytes(dst = code_payload, src = body)
      ci = ci + 1
    }
    emit_section(out = out, section_id = 10, payload = code_payload)
  }
  let data_count = Array::length(data_offsets)
  if data_count > 0 {
    let data_payload = Bytes::new()
    write_uleb128(buf = data_payload, val = data_count)
    let mut dti = 0
    while dti < data_count {
      Bytes::push(data_payload, value = 0x00)
      Bytes::push(data_payload, value = 0x41)
      write_sleb128(buf = data_payload, val = Array::get(data_offsets, at = dti))
      Bytes::push(data_payload, value = 0x0B)
      let db = Array::get(data_bytes, at = dti)
      write_uleb128(buf = data_payload, val = Bytes::length(db))
      append_bytes(dst = data_payload, src = db)
      dti = dti + 1
    }
    emit_section(out = out, section_id = 11, payload = data_payload)
  }
  out
}
