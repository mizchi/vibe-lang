// lib/@vibex/wasm_wat_encoder/wat_encoder.vibe — compile.

import @vibe/core {
  struct BigInt
}

import ./wat_encoder_instruction.vibe {
  append_bytes,
  decode_string,
  decode_string_bytes,
  emit_instruction,
  emit_section,
  empty_int_array,
  find_or_add_type,
  map_get,
  map_indices_new,
  map_names_new,
  map_set,
  parse_func_sig,
  parse_int,
  tok_ident,
  tok_int,
  tok_keyword,
  tok_lparen,
  tok_rparen,
  tok_string,
  tok_text,
  tok_type,
  tokenize,
  valtype_code,
  write_name,
  write_sleb128,
  write_uleb128
}

/// Return the `)` paired with `open_pos`, or `end_pos` for malformed input.
/// Keeping this structural (rather than searching source text) also makes
/// comments and quoted parentheses harmless here.
fn folded_close(tokens: Array[(Int, Int, Int)], open_pos: Int, end_pos: Int) -> Int {
  let mut depth = 0
  let mut pos = open_pos
  let mut close = end_pos
  while pos < end_pos && close == end_pos {
    let ty = tok_type(tokens = tokens, idx = pos)
    if ty == tok_lparen {
      depth = depth + 1
    } else if ty == tok_rparen {
      depth = depth - 1
      if depth == 0 {
        close = pos
      }
    }
    pos = pos + 1
  }
  close
}

fn folded_group_kind(src: String, tokens: Array[(Int, Int, Int)], open_pos: Int, end_pos: Int) -> String {
  if open_pos + 1 < end_pos && tok_type(tokens = tokens, idx = open_pos) == tok_lparen {
    tok_text(src = src, tokens = tokens, idx = open_pos + 1)
  } else {
    ""
  }
}

/// Emit a sequence of flat and folded instructions. Folded operands recurse
/// through `emit_folded_instruction`; flat instructions keep using the one
/// opcode/immediate encoder above, so the two syntaxes cannot drift apart.
fn emit_instruction_range(buf: Bytes, src: String, tokens: Array[(Int, Int, Int)], start_pos: Int, end_pos: Int, func_names: Array[String], func_indices: Array[Int], local_names: Array[String], local_indices: Array[Int], global_names: Array[String], global_indices: Array[Int], label_names: Array[String], label_indices: Array[Int], label_depth: Int) -> Unit {
  let mut pos = start_pos
  while pos < end_pos {
    if tok_type(tokens = tokens, idx = pos) == tok_lparen {
      pos = emit_folded_instruction(buf = buf, src = src, tokens = tokens, open_pos = pos, end_pos = end_pos, func_names = func_names, func_indices = func_indices, local_names = local_names, local_indices = local_indices, global_names = global_names, global_indices = global_indices, label_names = label_names, label_indices = label_indices, label_depth = label_depth)
    } else if tok_type(tokens = tokens, idx = pos) == tok_rparen {
      pos = end_pos
    } else {
      pos = emit_instruction(buf = buf, src = src, tokens = tokens, pos = pos, end_pos = end_pos, func_names = func_names, func_indices = func_indices, local_names = local_names, local_indices = local_indices, global_names = global_names, global_indices = global_indices, label_names = label_names, label_indices = label_indices, label_depth = label_depth)
    }
  }
}

/// Lower one WAT folded instruction `(op operand...)` to stack-machine order:
/// each nested operand is emitted first, then `op`. Immediate arguments such
/// as the index in `local.set 1` remain attached to `op`.
///
/// Structured control is the exception to the final-op rule: `block`/`loop`
/// open before their bodies, while folded `if` evaluates its condition before
/// opening the if and then emits its `then`/`else` groups.
fn emit_folded_instruction(buf: Bytes, src: String, tokens: Array[(Int, Int, Int)], open_pos: Int, end_pos: Int, func_names: Array[String], func_indices: Array[Int], local_names: Array[String], local_indices: Array[Int], global_names: Array[String], global_indices: Array[Int], label_names: Array[String], label_indices: Array[Int], label_depth: Int) -> Int {
  let close = folded_close(tokens = tokens, open_pos = open_pos, end_pos = end_pos)
  let head = open_pos + 1
  if head >= close || tok_type(tokens = tokens, idx = head) != tok_keyword {
    if close < end_pos {
      close + 1
    } else {
      end_pos
    }
  } else {
    let kw = tok_text(src = src, tokens = tokens, idx = head)
    let mut prefix_end = head + 1
    if kw == "br_table" {
      while prefix_end < close && (tok_type(tokens = tokens, idx = prefix_end) == tok_int || tok_type(tokens = tokens, idx = prefix_end) == tok_ident) {
        prefix_end = prefix_end + 1
      }
    } else if prefix_end < close && tok_type(tokens = tokens, idx = prefix_end) == tok_ident {
      prefix_end = prefix_end + 1
    } else if (kw == "br" || kw == "br_if" || kw == "call" || kw == "local.get" || kw == "local.set" || kw == "local.tee" || kw == "global.get" || kw == "global.set") && prefix_end < close && tok_type(tokens = tokens, idx = prefix_end) != tok_lparen {
      prefix_end = prefix_end + 1
    } else if (kw == "i32.const" || kw == "i64.const" || kw == "f32.const" || kw == "f64.const") && prefix_end < close {
      prefix_end = prefix_end + 1
    } else if String::starts_with(kw, prefix = "i32.load") || String::starts_with(kw, prefix = "i64.load") || String::starts_with(kw, prefix = "f32.load") || String::starts_with(kw, prefix = "f64.load") || String::starts_with(kw, prefix = "i32.store") || String::starts_with(kw, prefix = "i64.store") || String::starts_with(kw, prefix = "f32.store") || String::starts_with(kw, prefix = "f64.store") {
      while prefix_end < close && tok_type(tokens = tokens, idx = prefix_end) == tok_keyword && (String::starts_with(tok_text(src = src, tokens = tokens, idx = prefix_end), prefix = "offset=") || String::starts_with(tok_text(src = src, tokens = tokens, idx = prefix_end), prefix = "align=")) {
        prefix_end = prefix_end + 1
      }
    }
    // `(result ...)` and call_indirect's `(type ...)` are annotations, not
    // operand expressions. Leave them in the prefix consumed by the flat
    // immediate encoder.
    let annotation = if prefix_end < close {
      folded_group_kind(src = src, tokens = tokens, open_pos = prefix_end, end_pos = close)
    } else {
      ""
    }
    if annotation == "result" || (kw == "call_indirect" && annotation == "type") {
      let annotation_close = folded_close(tokens = tokens, open_pos = prefix_end, end_pos = close)
      prefix_end = if annotation_close < close {
        annotation_close + 1
      } else {
        close
      }
    }
    if kw == "block" || kw == "loop" {
      let _ = emit_instruction(buf = buf, src = src, tokens = tokens, pos = head, end_pos = prefix_end, func_names = func_names, func_indices = func_indices, local_names = local_names, local_indices = local_indices, global_names = global_names, global_indices = global_indices, label_names = label_names, label_indices = label_indices, label_depth = label_depth)
      emit_instruction_range(buf = buf, src = src, tokens = tokens, start_pos = prefix_end, end_pos = close, func_names = func_names, func_indices = func_indices, local_names = local_names, local_indices = local_indices, global_names = global_names, global_indices = global_indices, label_names = label_names, label_indices = label_indices, label_depth = label_depth + 1)
      Bytes::push(buf, value = 0x0B)
    } else if kw == "if" {
      let mut then_pos = prefix_end
      while then_pos < close && folded_group_kind(src = src, tokens = tokens, open_pos = then_pos, end_pos = close) != "then" {
        if tok_type(tokens = tokens, idx = then_pos) == tok_lparen {
          let child_close = folded_close(tokens = tokens, open_pos = then_pos, end_pos = close)
          emit_instruction_range(buf = buf, src = src, tokens = tokens, start_pos = then_pos, end_pos = child_close + 1, func_names = func_names, func_indices = func_indices, local_names = local_names, local_indices = local_indices, global_names = global_names, global_indices = global_indices, label_names = label_names, label_indices = label_indices, label_depth = label_depth)
          then_pos = child_close + 1
        } else {
          then_pos = emit_instruction(buf = buf, src = src, tokens = tokens, pos = then_pos, end_pos = close, func_names = func_names, func_indices = func_indices, local_names = local_names, local_indices = local_indices, global_names = global_names, global_indices = global_indices, label_names = label_names, label_indices = label_indices, label_depth = label_depth)
        }
      }
      let _ = emit_instruction(buf = buf, src = src, tokens = tokens, pos = head, end_pos = prefix_end, func_names = func_names, func_indices = func_indices, local_names = local_names, local_indices = local_indices, global_names = global_names, global_indices = global_indices, label_names = label_names, label_indices = label_indices, label_depth = label_depth)
      if then_pos < close {
        let then_close = folded_close(tokens = tokens, open_pos = then_pos, end_pos = close)
        emit_instruction_range(buf = buf, src = src, tokens = tokens, start_pos = then_pos + 2, end_pos = then_close, func_names = func_names, func_indices = func_indices, local_names = local_names, local_indices = local_indices, global_names = global_names, global_indices = global_indices, label_names = label_names, label_indices = label_indices, label_depth = label_depth + 1)
        let else_pos = then_close + 1
        if else_pos < close && folded_group_kind(src = src, tokens = tokens, open_pos = else_pos, end_pos = close) == "else" {
          Bytes::push(buf, value = 0x05)
          let else_close = folded_close(tokens = tokens, open_pos = else_pos, end_pos = close)
          emit_instruction_range(buf = buf, src = src, tokens = tokens, start_pos = else_pos + 2, end_pos = else_close, func_names = func_names, func_indices = func_indices, local_names = local_names, local_indices = local_indices, global_names = global_names, global_indices = global_indices, label_names = label_names, label_indices = label_indices, label_depth = label_depth + 1)
        }
      }
      Bytes::push(buf, value = 0x0B)
    } else {
      emit_instruction_range(buf = buf, src = src, tokens = tokens, start_pos = prefix_end, end_pos = close, func_names = func_names, func_indices = func_indices, local_names = local_names, local_indices = local_indices, global_names = global_names, global_indices = global_indices, label_names = label_names, label_indices = label_indices, label_depth = label_depth)
      let _ = emit_instruction(buf = buf, src = src, tokens = tokens, pos = head, end_pos = prefix_end, func_names = func_names, func_indices = func_indices, local_names = local_names, local_indices = local_indices, global_names = global_names, global_indices = global_indices, label_names = label_names, label_indices = label_indices, label_depth = label_depth)
    }
    if close < end_pos {
      close + 1
    } else {
      end_pos
    }
  }
}

fn compile_func_body(src: String, tokens: Array[(Int, Int, Int)], body_start: Int, body_end: Int, func_names: Array[String], func_indices: Array[Int], global_names: Array[String], global_indices: Array[Int], param_names: Array[String], param_count: Int, local_types: Array[Int], local_decl_names: Array[String]) -> Bytes {
  let code = Bytes::new()
  let ln = map_names_new()
  let li = map_indices_new()
  let mut pi = 0
  while pi < Array::length(param_names) {
    let pn = Array::get(param_names, at = pi)
    if String::length(pn) > 0 {
      map_set(names = ln, indices = li, name = pn, idx = pi)
    }
    pi = pi + 1
  }
  let mut di = 0
  while di < Array::length(local_decl_names) {
    let dn = Array::get(local_decl_names, at = di)
    if String::length(dn) > 0 {
      map_set(names = ln, indices = li, name = dn, idx = param_count + di)
    }
    di = di + 1
  }
  let lbl_names = map_names_new()
  let lbl_indices = map_indices_new()
  let local_count = Array::length(local_types)
  if local_count == 0 {
    write_uleb128(buf = code, val = 0)
  } else {
    let groups_types = empty_int_array()
    let groups_counts = empty_int_array()
    let mut gi = 0
    while gi < local_count {
      let lt = Array::get(local_types, at = gi)
      let gl = Array::length(groups_types)
      if (gl > 0) && (Array::get(groups_types, at = gl - 1) == lt) {
        let prev = Array::get(groups_counts, at = gl - 1)
        Array::truncate(groups_counts, length = gl - 1)
        Array::push(groups_counts, value = prev + 1)
      } else {
        Array::push(groups_types, value = lt)
        Array::push(groups_counts, value = 1)
      }
      gi = gi + 1
    }
    write_uleb128(buf = code, val = Array::length(groups_types))
    let mut k = 0
    while k < Array::length(groups_types) {
      write_uleb128(buf = code, val = Array::get(groups_counts, at = k))
      Bytes::push(code, value = Array::get(groups_types, at = k))
      k = k + 1
    }
  }
  emit_instruction_range(buf = code, src = src, tokens = tokens, start_pos = body_start, end_pos = body_end, func_names = func_names, func_indices = func_indices, local_names = ln, local_indices = li, global_names = global_names, global_indices = global_indices, label_names = lbl_names, label_indices = lbl_indices, label_depth = 0)
  Bytes::push(code, value = 0x0B)
  code
}

export fn compile(_ src: String) -> Bytes {
  let tokens = tokenize(src)
  let tok_count = Array::length(tokens)
  let out = Bytes::new()
  Bytes::push(out, value = 0x00)
  Bytes::push(out, value = 0x61)
  Bytes::push(out, value = 0x73)
  Bytes::push(out, value = 0x6D)
  Bytes::push(out, value = 0x01)
  Bytes::push(out, value = 0x00)
  Bytes::push(out, value = 0x00)
  Bytes::push(out, value = 0x00)
  let types_params = Array::slice([Array::slice([0], start = 0, end = 0)], start = 0, end = 0)
  let types_results = Array::slice([Array::slice([0], start = 0, end = 0)], start = 0, end = 0)
  let import_modules = Array::slice([""], start = 0, end = 0)
  let import_names = Array::slice([""], start = 0, end = 0)
  let import_kinds = Array::slice([0], start = 0, end = 0)
  let import_type_indices = Array::slice([0], start = 0, end = 0)
  let import_global_valtypes = Array::slice([0], start = 0, end = 0)
  let import_global_muts = Array::slice([0], start = 0, end = 0)
  let func_type_indices = Array::slice([0], start = 0, end = 0)
  let func_bodies_start = Array::slice([0], start = 0, end = 0)
  let func_bodies_end = Array::slice([0], start = 0, end = 0)
  let func_param_names = Array::slice([Array::slice([""], start = 0, end = 0)], start = 0, end = 0)
  let func_param_counts = Array::slice([0], start = 0, end = 0)
  let func_local_types = Array::slice([Array::slice([0], start = 0, end = 0)], start = 0, end = 0)
  let func_local_names = Array::slice([Array::slice([""], start = 0, end = 0)], start = 0, end = 0)
  let func_names = map_names_new()
  let func_indices = map_indices_new()
  let global_names = map_names_new()
  let global_indices = map_indices_new()
  let export_names = Array::slice([""], start = 0, end = 0)
  let export_kinds = Array::slice([0], start = 0, end = 0)
  let export_indices = Array::slice([0], start = 0, end = 0)
  let mem_min = Array::slice([0], start = 0, end = 0)
  let mem_max = Array::slice([0], start = 0, end = 0)
  let mem_has_max = Array::slice([0], start = 0, end = 0)
  let global_valtypes = Array::slice([0], start = 0, end = 0)
  let global_muts = Array::slice([0], start = 0, end = 0)
  let global_init_vals = Array::slice([0], start = 0, end = 0)
  let global_init_types = Array::slice([0], start = 0, end = 0)
  let table_min = Array::slice([0], start = 0, end = 0)
  let table_max = Array::slice([0], start = 0, end = 0)
  let table_has_max = Array::slice([0], start = 0, end = 0)
  let elem_offsets = Array::slice([0], start = 0, end = 0)
  let elem_func_indices = Array::slice([Array::slice([0], start = 0, end = 0)], start = 0, end = 0)
  let data_offsets = Array::slice([0], start = 0, end = 0)
  let data_bytes = Array::slice([Bytes::new()], start = 0, end = 0)
  let mut start_func = -1
  let mut import_func_count = 0
  let mut pos = 0
  while (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) != tok_lparen) {
    pos = pos + 1
  }
  if pos < tok_count {
    pos = pos + 1
  }
  if (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) == tok_keyword) && (tok_text(src = src, tokens = tokens, idx = pos) == "module") {
    pos = pos + 1
  }
  while pos < tok_count {
    let cur_ty = tok_type(tokens = tokens, idx = pos)
    if cur_ty == tok_rparen {
      pos = tok_count
    } else if cur_ty == tok_lparen {
      pos = pos + 1
      if (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) == tok_keyword) {
        let section_kw = tok_text(src = src, tokens = tokens, idx = pos)
        pos = pos + 1
        if section_kw == "type" {
          if (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) == tok_ident) {
            pos = pos + 1
          }
          if (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) == tok_lparen) {
            pos = pos + 1
            if (pos < tok_count) && (tok_text(src = src, tokens = tokens, idx = pos) == "func") {
              pos = pos + 1
              let result0 = parse_func_sig(src = src, tokens = tokens, start_pos = pos, tok_count = tok_count)
              let (params0, results0, new_pos0) = result0
              let _ = find_or_add_type(types_params = types_params, types_results = types_results, params = params0, results = results0)
              pos = new_pos0
            }
          }
          let mut depth = 1
          while (pos < tok_count) && (depth > 0) {
            if tok_type(tokens = tokens, idx = pos) == tok_lparen {
              depth = depth + 1
            }
            else if tok_type(tokens = tokens, idx = pos) == tok_rparen {
              depth = depth - 1
            }
            pos = pos + 1
          }
        }
        else if section_kw == "import" {
          let mut mod_name = ""
          let mut field_name = ""
          let mut str_count = 0
          while (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) == tok_string) {
            if str_count == 0 {
              mod_name = decode_string(tok_text(src = src, tokens = tokens, idx = pos))
            } else {
              field_name = decode_string(tok_text(src = src, tokens = tokens, idx = pos))
            }
            str_count = str_count + 1
            pos = pos + 1
          }
          if (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) == tok_lparen) {
            pos = pos + 1
            if pos < tok_count {
              let desc_kw = tok_text(src = src, tokens = tokens, idx = pos)
              pos = pos + 1
              if desc_kw == "func" {
                if (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) == tok_ident) {
                  let fname = tok_text(src = src, tokens = tokens, idx = pos)
                  map_set(names = func_names, indices = func_indices, name = fname, idx = import_func_count)
                  pos = pos + 1
                }
                if (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) == tok_lparen) {
                  let result1 = parse_func_sig(src = src, tokens = tokens, start_pos = pos, tok_count = tok_count)
                  let (params1, results1, new_pos1) = result1
                  let tidx = find_or_add_type(types_params = types_params, types_results = types_results, params = params1, results = results1)
                  Array::push(import_modules, value = mod_name)
                  Array::push(import_names, value = field_name)
                  Array::push(import_kinds, value = 0)
                  Array::push(import_type_indices, value = tidx)
                  Array::push(import_global_valtypes, value = 0)
                  Array::push(import_global_muts, value = 0)
                  pos = new_pos1
                } else {
                  let tidx = find_or_add_type(types_params = types_params, types_results = types_results, params = empty_int_array(), results = empty_int_array())
                  Array::push(import_modules, value = mod_name)
                  Array::push(import_names, value = field_name)
                  Array::push(import_kinds, value = 0)
                  Array::push(import_type_indices, value = tidx)
                  Array::push(import_global_valtypes, value = 0)
                  Array::push(import_global_muts, value = 0)
                }
                import_func_count = import_func_count + 1
              }
              else if desc_kw == "memory" {
                let mut min_val = 0
                let mut max_val = 0
                let mut has_max_val = 0
                if (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) == tok_int) {
                  min_val = parse_int(tok_text(src = src, tokens = tokens, idx = pos))
                  pos = pos + 1
                  if (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) == tok_int) {
                    max_val = parse_int(tok_text(src = src, tokens = tokens, idx = pos))
                    has_max_val = 1
                    pos = pos + 1
                  }
                }
                Array::push(import_modules, value = mod_name)
                Array::push(import_names, value = field_name)
                Array::push(import_kinds, value = 2)
                Array::push(import_type_indices, value = 0)
                Array::push(import_global_valtypes, value = 0)
                Array::push(import_global_muts, value = 0)
                Array::push(mem_min, value = min_val)
                Array::push(mem_max, value = max_val)
                Array::push(mem_has_max, value = has_max_val)
              }
              else if desc_kw == "global" {
                let mut vt = 0x7F
                let mut mutability = 0
                if (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) == tok_lparen) {
                  pos = pos + 1
                  if (pos < tok_count) && (tok_text(src = src, tokens = tokens, idx = pos) == "mut") {
                    mutability = 1
                    pos = pos + 1
                    if pos < tok_count {
                      vt = valtype_code(tok_text(src = src, tokens = tokens, idx = pos))
                      pos = pos + 1
                    }
                  }
                  if (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) == tok_rparen) {
                    pos = pos + 1
                  }
                } else if (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) == tok_keyword) {
                  vt = valtype_code(tok_text(src = src, tokens = tokens, idx = pos))
                  pos = pos + 1
                }
                Array::push(import_modules, value = mod_name)
                Array::push(import_names, value = field_name)
                Array::push(import_kinds, value = 3)
                Array::push(import_type_indices, value = 0)
                Array::push(import_global_valtypes, value = vt)
                Array::push(import_global_muts, value = mutability)
              }
            }
          }
          let mut depth2 = 1
          while (pos < tok_count) && (depth2 > 0) {
            if tok_type(tokens = tokens, idx = pos) == tok_lparen {
              depth2 = depth2 + 1
            }
            else if tok_type(tokens = tokens, idx = pos) == tok_rparen {
              depth2 = depth2 - 1
            }
            pos = pos + 1
          }
        }
        else if section_kw == "func" {
          let func_idx = import_func_count + Array::length(func_type_indices)
          if (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) == tok_ident) {
            let fname = tok_text(src = src, tokens = tokens, idx = pos)
            map_set(names = func_names, indices = func_indices, name = fname, idx = func_idx)
            pos = pos + 1
          }
          let mut check_export = true
          while check_export {
            if (pos < tok_count) && (tok_type(tokens = tokens, idx = pos) == tok_lparen) {
              let next_pos = pos + 1
              if (next_pos < tok_count) && (tok_type(tokens = tokens, idx = next_pos) == tok_keyword) && (tok_text(src = src, tokens = tokens, idx = next_pos) == "export") {
                let str_pos = next_pos + 1
                if (str_pos < tok_count) && (tok_type(tokens = tokens, idx = str_pos) == tok_string) {
                  let ename = decode_string(tok_text(src = src, tokens = tokens, idx = str_pos))
                  Array::push(export_names, value = ename)
