  if export_count > 0 {
    let export_payload = Bytes::new()
    write_uleb128(export_payload, export_count)
    let mut ei = 0
    while ei < export_count {
      write_name(export_payload, Array::get(export_names, ei))
      Bytes::push(export_payload, Array::get(export_kinds, ei))
      write_uleb128(export_payload, Array::get(export_indices, ei))
      ei = ei + 1
    }
    emit_section(out, 7, export_payload)
  }
  if start_func >= 0 {
    let start_payload = Bytes::new()
    write_uleb128(start_payload, start_func)
    emit_section(out, 8, start_payload)
  }
  if Array::length(elem_offsets) > 0 {
    let elem_payload = Bytes::new()
    write_uleb128(elem_payload, Array::length(elem_offsets))
    let mut eli = 0
    while eli < Array::length(elem_offsets) {
      Bytes::push(elem_payload, 0x00)
      Bytes::push(elem_payload, 0x41)
      write_sleb128(elem_payload, Array::get(elem_offsets, eli))
      Bytes::push(elem_payload, 0x0B)
      let efuncs = Array::get(elem_func_indices, eli)
      write_uleb128(elem_payload, Array::length(efuncs))
      let mut efi = 0
      while efi < Array::length(efuncs) {
        write_uleb128(elem_payload, Array::get(efuncs, efi))
        efi = efi + 1
      }
      eli = eli + 1
    }
    emit_section(out, 9, elem_payload)
  }
  if func_count > 0 {
    let code_payload = Bytes::new()
    write_uleb128(code_payload, func_count)
    let mut ci = 0
    while ci < func_count {
      let body = compile_func_body(src, tokens, Array::get(func_bodies_start, ci), Array::get(func_bodies_end, ci), func_names, func_indices, global_names, global_indices, Array::get(func_param_names, ci), Array::get(func_param_counts, ci), Array::get(func_local_types, ci), Array::get(func_local_names, ci))
      let body_len = Bytes::length(body)
      write_uleb128(code_payload, body_len)
      append_bytes(code_payload, body)
      ci = ci + 1
    }
    emit_section(out, 10, code_payload)
  }
  let data_count = Array::length(data_offsets)
  if data_count > 0 {
    let data_payload = Bytes::new()
    write_uleb128(data_payload, data_count)
    let mut dti = 0
    while dti < data_count {
      Bytes::push(data_payload, 0x00)
      Bytes::push(data_payload, 0x41)
      write_sleb128(data_payload, Array::get(data_offsets, dti))
      Bytes::push(data_payload, 0x0B)
      let db = Array::get(data_bytes, dti)
      write_uleb128(data_payload, Bytes::length(db))
      append_bytes(data_payload, db)
      dti = dti + 1
    }
    emit_section(out, 11, data_payload)
  }
  out
}
