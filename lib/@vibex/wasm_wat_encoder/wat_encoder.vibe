      }
      else if kw == "f32.trunc" {
        Bytes::push(buf, 0x8F); pos + 1
      }
      else if kw == "f32.nearest" {
        Bytes::push(buf, 0x90); pos + 1
      }
      else if kw == "f32.sqrt" {
        Bytes::push(buf, 0x91); pos + 1
      }
      else if kw == "f32.add" {
        Bytes::push(buf, 0x92); pos + 1
      }
      else if kw == "f32.sub" {
        Bytes::push(buf, 0x93); pos + 1
      }
      else if kw == "f32.mul" {
        Bytes::push(buf, 0x94); pos + 1
      }
      else if kw == "f32.div" {
        Bytes::push(buf, 0x95); pos + 1
      }
      else if kw == "f32.min" {
        Bytes::push(buf, 0x96); pos + 1
      }
      else if kw == "f32.max" {
        Bytes::push(buf, 0x97); pos + 1
      }
      else if kw == "f32.copysign" {
        Bytes::push(buf, 0x98); pos + 1
      }
      else if kw == "f64.abs" {
        Bytes::push(buf, 0x99); pos + 1
      }
      else if kw == "f64.neg" {
        Bytes::push(buf, 0x9A); pos + 1
      }
      else if kw == "f64.ceil" {
        Bytes::push(buf, 0x9B); pos + 1
      }
      else if kw == "f64.floor" {
        Bytes::push(buf, 0x9C); pos + 1
      }
      else if kw == "f64.trunc" {
        Bytes::push(buf, 0x9D); pos + 1
      }
      else if kw == "f64.nearest" {
        Bytes::push(buf, 0x9E); pos + 1
      }
      else if kw == "f64.sqrt" {
        Bytes::push(buf, 0x9F); pos + 1
      }
      else if kw == "f64.add" {
        Bytes::push(buf, 0xA0); pos + 1
      }
      else if kw == "f64.sub" {
        Bytes::push(buf, 0xA1); pos + 1
      }
      else if kw == "f64.mul" {
        Bytes::push(buf, 0xA2); pos + 1
      }
      else if kw == "f64.div" {
        Bytes::push(buf, 0xA3); pos + 1
      }
      else if kw == "f64.min" {
        Bytes::push(buf, 0xA4); pos + 1
      }
      else if kw == "f64.max" {
        Bytes::push(buf, 0xA5); pos + 1
      }
      else if kw == "f64.copysign" {
        Bytes::push(buf, 0xA6); pos + 1
      }
      else if kw == "i32.wrap_i64" {
        Bytes::push(buf, 0xA7); pos + 1
      }
      else if kw == "i32.trunc_f32_s" {
        Bytes::push(buf, 0xA8); pos + 1
      }
      else if kw == "i32.trunc_f32_u" {
        Bytes::push(buf, 0xA9); pos + 1
      }
      else if kw == "i32.trunc_f64_s" {
        Bytes::push(buf, 0xAA); pos + 1
      }
      else if kw == "i32.trunc_f64_u" {
        Bytes::push(buf, 0xAB); pos + 1
      }
      else if kw == "i64.extend_i32_s" {
        Bytes::push(buf, 0xAC); pos + 1
      }
      else if kw == "i64.extend_i32_u" {
        Bytes::push(buf, 0xAD); pos + 1
      }
      else if kw == "i64.trunc_f32_s" {
        Bytes::push(buf, 0xAE); pos + 1
      }
      else if kw == "i64.trunc_f32_u" {
        Bytes::push(buf, 0xAF); pos + 1
      }
      else if kw == "i64.trunc_f64_s" {
        Bytes::push(buf, 0xB0); pos + 1
      }
      else if kw == "i64.trunc_f64_u" {
        Bytes::push(buf, 0xB1); pos + 1
      }
      else if kw == "f32.convert_i32_s" {
        Bytes::push(buf, 0xB2); pos + 1
      }
      else if kw == "f32.convert_i32_u" {
        Bytes::push(buf, 0xB3); pos + 1
      }
      else if kw == "f32.convert_i64_s" {
        Bytes::push(buf, 0xB4); pos + 1
      }
      else if kw == "f32.convert_i64_u" {
        Bytes::push(buf, 0xB5); pos + 1
      }
      else if kw == "f32.demote_f64" {
        Bytes::push(buf, 0xB6); pos + 1
      }
      else if kw == "f64.convert_i32_s" {
        Bytes::push(buf, 0xB7); pos + 1
      }
      else if kw == "f64.convert_i32_u" {
        Bytes::push(buf, 0xB8); pos + 1
      }
      else if kw == "f64.convert_i64_s" {
        Bytes::push(buf, 0xB9); pos + 1
      }
      else if kw == "f64.convert_i64_u" {
        Bytes::push(buf, 0xBA); pos + 1
      }
      else if kw == "f64.promote_f32" {
        Bytes::push(buf, 0xBB); pos + 1
      }
      else if kw == "i32.reinterpret_f32" {
        Bytes::push(buf, 0xBC); pos + 1
      }
      else if kw == "i64.reinterpret_f64" {
        Bytes::push(buf, 0xBD); pos + 1
      }
      else if kw == "f32.reinterpret_i32" {
        Bytes::push(buf, 0xBE); pos + 1
      }
      else if kw == "f64.reinterpret_i64" {
        Bytes::push(buf, 0xBF); pos + 1
      }
      else if kw == "f32.load" {
        Bytes::push(buf, 0x2A)
        let next = pos + 1
        let (align0, offset0, next2) = parse_mem_args(src, tokens, next, end_pos, 2)
        write_uleb128(buf, align0)
        write_uleb128(buf, offset0)
        next2
      }
      else if kw == "f64.load" {
        Bytes::push(buf, 0x2B)
        let next = pos + 1
        let (align0, offset0, next2) = parse_mem_args(src, tokens, next, end_pos, 3)
        write_uleb128(buf, align0)
        write_uleb128(buf, offset0)
        next2
      }
      else if kw == "f32.store" {
        Bytes::push(buf, 0x38)
        let next = pos + 1
        let (align0, offset0, next2) = parse_mem_args(src, tokens, next, end_pos, 2)
        write_uleb128(buf, align0)
        write_uleb128(buf, offset0)
        next2
      }
      else if kw == "f64.store" {
        Bytes::push(buf, 0x39)
        let next = pos + 1
        let (align0, offset0, next2) = parse_mem_args(src, tokens, next, end_pos, 3)
        write_uleb128(buf, align0)
        write_uleb128(buf, offset0)
        next2
      }
      else if kw == "i64.load8_s" {
        Bytes::push(buf, 0x30)
        let next = pos + 1
        let (align0, offset0, next2) = parse_mem_args(src, tokens, next, end_pos, 0)
        write_uleb128(buf, align0)
        write_uleb128(buf, offset0)
        next2
      }
      else if kw == "i64.load8_u" {
        Bytes::push(buf, 0x31)
        let next = pos + 1
        let (align0, offset0, next2) = parse_mem_args(src, tokens, next, end_pos, 0)
        write_uleb128(buf, align0)
        write_uleb128(buf, offset0)
        next2
      }
      else if kw == "i64.load16_s" {
        Bytes::push(buf, 0x32)
        let next = pos + 1
        let (align0, offset0, next2) = parse_mem_args(src, tokens, next, end_pos, 1)
        write_uleb128(buf, align0)
        write_uleb128(buf, offset0)
        next2
      }
      else if kw == "i64.load16_u" {
        Bytes::push(buf, 0x33)
        let next = pos + 1
        let (align0, offset0, next2) = parse_mem_args(src, tokens, next, end_pos, 1)
        write_uleb128(buf, align0)
        write_uleb128(buf, offset0)
        next2
      }
      else if kw == "i64.load32_s" {
        Bytes::push(buf, 0x34)
        let next = pos + 1
        let (align0, offset0, next2) = parse_mem_args(src, tokens, next, end_pos, 2)
        write_uleb128(buf, align0)
        write_uleb128(buf, offset0)
        next2
      }
      else if kw == "i64.load32_u" {
        Bytes::push(buf, 0x35)
        let next = pos + 1
        let (align0, offset0, next2) = parse_mem_args(src, tokens, next, end_pos, 2)
        write_uleb128(buf, align0)
        write_uleb128(buf, offset0)
        next2
      }
      else if kw == "i64.store8" {
        Bytes::push(buf, 0x3C)
        let next = pos + 1
        let (align0, offset0, next2) = parse_mem_args(src, tokens, next, end_pos, 0)
        write_uleb128(buf, align0)
        write_uleb128(buf, offset0)
        next2
      }
      else if kw == "i64.store16" {
        Bytes::push(buf, 0x3D)
        let next = pos + 1
        let (align0, offset0, next2) = parse_mem_args(src, tokens, next, end_pos, 1)
        write_uleb128(buf, align0)
        write_uleb128(buf, offset0)
        next2
      }
      else if kw == "i64.store32" {
        Bytes::push(buf, 0x3E)
        let next = pos + 1
        let (align0, offset0, next2) = parse_mem_args(src, tokens, next, end_pos, 2)
        write_uleb128(buf, align0)
        write_uleb128(buf, offset0)
        next2
      }
      else if kw == "br_table" {
        Bytes::push(buf, 0x0E)
        let labels = empty_int_array()
        let mut next = pos + 1
        while (next < end_pos) && ((tok_type(tokens, next) == tok_int) || (tok_type(tokens, next) == tok_ident)) {
          let arg = tok_text(src, tokens, next)
          if tok_type(tokens, next) == tok_ident {
            let idx = map_get(label_names, label_indices, arg)
            let depth = if idx >= 0 {
              label_depth - idx - 1
            } else {
              0
            }
            Array::push(labels, depth)
          } else {
            Array::push(labels, parse_int(arg))
          }
          next = next + 1
        }
        let label_count = Array::length(labels)
        if label_count > 0 {
          write_uleb128(buf, label_count - 1)
          let mut li = 0
          while li < label_count {
            write_uleb128(buf, Array::get(labels, li))
            li = li + 1
          }
        } else {
          write_uleb128(buf, 0)
          write_uleb128(buf, 0)
        }
        next
      }
      else if kw == "call_indirect" {
        Bytes::push(buf, 0x11)
        let next = pos + 1
        if (next < end_pos) && (tok_type(tokens, next) == tok_lparen) && ((next + 1) < end_pos) && (tok_text(src, tokens, next + 1) == "type") {
          let type_pos = next + 2
          if type_pos < end_pos {
            let type_arg = tok_text(src, tokens, type_pos)
            if tok_type(tokens, type_pos) == tok_int {
              write_uleb128(buf, parse_int(type_arg))
            } else {
              write_uleb128(buf, 0)
            }
          } else {
            write_uleb128(buf, 0)
          }
          Bytes::push(buf, 0x00)
          let mut skip = type_pos + 1
          if (skip < end_pos) && (tok_type(tokens, skip) == tok_rparen) {
            skip = skip + 1
          }
          skip
        } else if (next < end_pos) && (tok_type(tokens, next) == tok_int) {
          write_uleb128(buf, parse_int(tok_text(src, tokens, next)))
          Bytes::push(buf, 0x00)
          next + 1
        } else {
          write_uleb128(buf, 0)
          Bytes::push(buf, 0x00)
          next
        }
      }
      else if kw == "f32.const" {
        Bytes::push(buf, 0x43)
        let next = pos + 1
        if next < end_pos {
          let bits = parse_f32_bits(tok_text(src, tokens, next))
          write_f32_le(buf, bits)
          next + 1
        } else {
          next
        }
      }
      else if kw == "f64.const" {
        Bytes::push(buf, 0x44)
        let next = pos + 1
        if next < end_pos {
          let (bits_hi, bits_lo) = parse_f64_bits(tok_text(src, tokens, next))
          write_f64_le(buf, bits_hi, bits_lo)
          next + 1
        } else {
          next
        }
      }
      else {
        pos + 1
      }
    }
  }
}

fn compile_func_body(src: String, tokens: Array[(Int, Int, Int)], body_start: Int, body_end: Int, func_names: Array[String], func_indices: Array[Int], global_names: Array[String], global_indices: Array[Int], param_names: Array[String], param_count: Int, local_types: Array[Int], local_decl_names: Array[String]) -> Bytes {
  let code = Bytes::new()
  let ln = map_names_new()
  let li = map_indices_new()
  let mut pi = 0
  while pi < Array::length(param_names) {
    let pn = Array::get(param_names, pi)
    if String::length(pn) > 0 {
      map_set(ln, li, pn, pi)
    }
    pi = pi + 1
  }
  let mut di = 0
  while di < Array::length(local_decl_names) {
    let dn = Array::get(local_decl_names, di)
    if String::length(dn) > 0 {
      map_set(ln, li, dn, param_count + di)
    }
    di = di + 1
  }
  let lbl_names = map_names_new()
  let lbl_indices = map_indices_new()
  let local_count = Array::length(local_types)
  if local_count == 0 {
    write_uleb128(code, 0)
  } else {
    let groups_types = empty_int_array()
    let groups_counts = empty_int_array()
    let mut gi = 0
    while gi < local_count {
      let lt = Array::get(local_types, gi)
      let gl = Array::length(groups_types)
      if (gl > 0) && (Array::get(groups_types, gl - 1) == lt) {
        let prev = Array::get(groups_counts, gl - 1)
        Array::truncate(groups_counts, gl - 1)
        Array::push(groups_counts, prev + 1)
      } else {
        Array::push(groups_types, lt)
        Array::push(groups_counts, 1)
      }
      gi = gi + 1
    }
    write_uleb128(code, Array::length(groups_types))
    let mut k = 0
    while k < Array::length(groups_types) {
      write_uleb128(code, Array::get(groups_counts, k))
      Bytes::push(code, Array::get(groups_types, k))
      k = k + 1
    }
  }
  let paren_is_block = Array::slice([
    0
  ], 0, 0)
  let mut ip = body_start
  while ip < body_end {
    let cur_ty = tok_type(tokens, ip)
    if cur_ty == tok_lparen {
      let nxt = ip + 1
      if (nxt < body_end) && (tok_type(tokens, nxt) == tok_keyword) {
        let nkw = tok_text(src, tokens, nxt)
        if (nkw == "block") || (nkw == "loop") || (nkw == "if") {
          Array::push(paren_is_block, 1)
          ip = ip + 1
        } else if (nkw == "result") || (nkw == "then") || (nkw == "else") {
          Array::push(paren_is_block, 0)
          ip = ip + 1
        } else {
          Array::push(paren_is_block, 0)
          ip = ip + 1
        }
      } else {
        Array::push(paren_is_block, 0)
        ip = ip + 1
      }
    } else if cur_ty == tok_rparen {
      let plen = Array::length(paren_is_block)
      if plen > 0 {
        let is_block = Array::get(paren_is_block, plen - 1)
        Array::truncate(paren_is_block, plen - 1)
        if is_block == 1 {
          Bytes::push(code, 0x0B)
        }
      }
      ip = ip + 1
    } else {
      ip = emit_instruction(code, src, tokens, ip, body_end, func_names, func_indices, ln, li, global_names, global_indices, lbl_names, lbl_indices, 0)
    }
  }
  Bytes::push(code, 0x0B)
  code
}

export fn compile(src: String) -> Bytes {
  let tokens = tokenize(src)
  let tok_count = Array::length(tokens)
  let out = Bytes::new()
  Bytes::push(out, 0x00)
  Bytes::push(out, 0x61)
  Bytes::push(out, 0x73)
  Bytes::push(out, 0x6D)
  Bytes::push(out, 0x01)
  Bytes::push(out, 0x00)
  Bytes::push(out, 0x00)
  Bytes::push(out, 0x00)
  let types_params = Array::slice([
    Array::slice([
      0
    ], 0, 0)
  ], 0, 0)
  let types_results = Array::slice([
    Array::slice([
      0
    ], 0, 0)
  ], 0, 0)
  let import_modules = Array::slice([
    ""
  ], 0, 0)
  let import_names = Array::slice([
    ""
  ], 0, 0)
  let import_kinds = Array::slice([
    0
  ], 0, 0)
  let import_type_indices = Array::slice([
    0
  ], 0, 0)
  let import_global_valtypes = Array::slice([
    0
  ], 0, 0)
  let import_global_muts = Array::slice([
    0
  ], 0, 0)
  let func_type_indices = Array::slice([
    0
  ], 0, 0)
  let func_bodies_start = Array::slice([
    0
  ], 0, 0)
  let func_bodies_end = Array::slice([
    0
  ], 0, 0)
  let func_param_names = Array::slice([
    Array::slice([
      ""
    ], 0, 0)
  ], 0, 0)
  let func_param_counts = Array::slice([
    0
  ], 0, 0)
  let func_local_types = Array::slice([
    Array::slice([
      0
    ], 0, 0)
  ], 0, 0)
  let func_local_names = Array::slice([
    Array::slice([
      ""
    ], 0, 0)
  ], 0, 0)
  let func_names = map_names_new()
  let func_indices = map_indices_new()
  let global_names = map_names_new()
  let global_indices = map_indices_new()
  let export_names = Array::slice([
    ""
  ], 0, 0)
  let export_kinds = Array::slice([
    0
  ], 0, 0)
  let export_indices = Array::slice([
    0
  ], 0, 0)
  let mem_min = Array::slice([
    0
  ], 0, 0)
  let mem_max = Array::slice([
    0
  ], 0, 0)
  let mem_has_max = Array::slice([
    0
  ], 0, 0)
  let global_valtypes = Array::slice([
    0
  ], 0, 0)
  let global_muts = Array::slice([
    0
  ], 0, 0)
  let global_init_vals = Array::slice([
    0
  ], 0, 0)
  let global_init_types = Array::slice([
    0
  ], 0, 0)
  let table_min = Array::slice([
    0
  ], 0, 0)
  let table_max = Array::slice([
    0
  ], 0, 0)
  let table_has_max = Array::slice([
    0
  ], 0, 0)
  let elem_offsets = Array::slice([
    0
  ], 0, 0)
  let elem_func_indices = Array::slice([
    Array::slice([
      0
    ], 0, 0)
  ], 0, 0)
  let data_offsets = Array::slice([
    0
  ], 0, 0)
  let data_bytes = Array::slice([
    Bytes::new()
  ], 0, 0)
  let mut start_func = -1
  let mut import_func_count = 0
  let mut pos = 0
  while (pos < tok_count) && (tok_type(tokens, pos) != tok_lparen) {
    pos = pos + 1
  }
  if pos < tok_count {
    pos = pos + 1
  }
  if (pos < tok_count) && (tok_type(tokens, pos) == tok_keyword) && (tok_text(src, tokens, pos) == "module") {
    pos = pos + 1
  }
  while pos < tok_count {
    let cur_ty = tok_type(tokens, pos)
    if cur_ty == tok_rparen {
      pos = tok_count
    } else if cur_ty == tok_lparen {
      pos = pos + 1
      if (pos < tok_count) && (tok_type(tokens, pos) == tok_keyword) {
        let section_kw = tok_text(src, tokens, pos)
        pos = pos + 1
        if section_kw == "type" {
          if (pos < tok_count) && (tok_type(tokens, pos) == tok_ident) {
            pos = pos + 1
          }
          if (pos < tok_count) && (tok_type(tokens, pos) == tok_lparen) {
            pos = pos + 1
            if (pos < tok_count) && (tok_text(src, tokens, pos) == "func") {
              pos = pos + 1
              let result0 = parse_func_sig(src, tokens, pos, tok_count)
              let (params0, results0, new_pos0) = result0
              let _ = find_or_add_type(types_params, types_results, params0, results0)
              pos = new_pos0
            }
          }
          let mut depth = 1
          while (pos < tok_count) && (depth > 0) {
            if tok_type(tokens, pos) == tok_lparen {
              depth = depth + 1
            }
            else if tok_type(tokens, pos) == tok_rparen {
              depth = depth - 1
            }
            pos = pos + 1
          }
        }
        else if section_kw == "import" {
          let mut mod_name = ""
          let mut field_name = ""
          let mut str_count = 0
          while (pos < tok_count) && (tok_type(tokens, pos) == tok_string) {
            if str_count == 0 {
              mod_name = decode_string(tok_text(src, tokens, pos))
            } else {
              field_name = decode_string(tok_text(src, tokens, pos))
            }
            str_count = str_count + 1
            pos = pos + 1
          }
          if (pos < tok_count) && (tok_type(tokens, pos) == tok_lparen) {
            pos = pos + 1
            if pos < tok_count {
              let desc_kw = tok_text(src, tokens, pos)
              pos = pos + 1
              if desc_kw == "func" {
                if (pos < tok_count) && (tok_type(tokens, pos) == tok_ident) {
                  let fname = tok_text(src, tokens, pos)
                  map_set(func_names, func_indices, fname, import_func_count)
                  pos = pos + 1
                }
                if (pos < tok_count) && (tok_type(tokens, pos) == tok_lparen) {
                  let result1 = parse_func_sig(src, tokens, pos, tok_count)
                  let (params1, results1, new_pos1) = result1
                  let tidx = find_or_add_type(types_params, types_results, params1, results1)
                  Array::push(import_modules, mod_name)
                  Array::push(import_names, field_name)
                  Array::push(import_kinds, 0)
                  Array::push(import_type_indices, tidx)
                  Array::push(import_global_valtypes, 0)
                  Array::push(import_global_muts, 0)
                  pos = new_pos1
                } else {
                  let tidx = find_or_add_type(types_params, types_results, empty_int_array(), empty_int_array())
                  Array::push(import_modules, mod_name)
                  Array::push(import_names, field_name)
                  Array::push(import_kinds, 0)
                  Array::push(import_type_indices, tidx)
                  Array::push(import_global_valtypes, 0)
                  Array::push(import_global_muts, 0)
                }
                import_func_count = import_func_count + 1
              }
              else if desc_kw == "memory" {
                let mut min_val = 0
                let mut max_val = 0
                let mut has_max_val = 0
                if (pos < tok_count) && (tok_type(tokens, pos) == tok_int) {
                  min_val = parse_int(tok_text(src, tokens, pos))
                  pos = pos + 1
                  if (pos < tok_count) && (tok_type(tokens, pos) == tok_int) {
                    max_val = parse_int(tok_text(src, tokens, pos))
                    has_max_val = 1
                    pos = pos + 1
                  }
                }
                Array::push(import_modules, mod_name)
                Array::push(import_names, field_name)
                Array::push(import_kinds, 2)
                Array::push(import_type_indices, 0)
                Array::push(import_global_valtypes, 0)
                Array::push(import_global_muts, 0)
                Array::push(mem_min, min_val)
                Array::push(mem_max, max_val)
                Array::push(mem_has_max, has_max_val)
              }
              else if desc_kw == "global" {
                let mut vt = 0x7F
                let mut mutability = 0
