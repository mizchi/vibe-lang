// @vibex/collections — Deque[T]: ring-buffer-backed double-ended queue.
//
// Layout: a single backing `Array[Option[T]]` (mut field, ADR-0052) plus
// `head` (physical index of the front element) and `size` (live element
// count). Capacity is `Array::length(buf)`; the logical element at
// position `i` (0 <= i < size) lives at physical index
// `(head + i) % capacity`.
//
// Using `Array[Option[T]]` slots (rather than a raw `Array[T]`, which
// would need a sentinel default value of type T for the unused slots)
// sidesteps the #829 generic-struct-instantiation gap the same way
// hashmap.vibe does: every slot read goes through a `match` on Option, so
// a miscompiled "opaque" read surfaces as a pattern-match failure, never
// as silently reinterpreted garbage.
//
// Growth: push_front/push_back double the capacity (min 4) whenever
// size == capacity, by copying the live elements into a fresh backing
// array *in logical order* (new head = 0) — "rebuild, don't patch", the
// same approach as HashMap's rehash. The copy loop reads through the old
// `head`/modulo arithmetic before `d.buf`/`d.head` are overwritten, so
// growth is correct regardless of where `head` currently sits in the old
// array (this is the case most likely to hide an off-by-one: growing
// right after a wraparound, when head != 0).
//
// Shrinking is not implemented (pop never reallocates) — this trades a
// little peak memory for a much simpler, harder-to-get-wrong
// implementation, matching the "correctness over performance" guidance
// for this batch (#841).
//
// No method-bearing trait (e.g. Iterable) is implemented here, matching
// the other @vibex/collections containers (HashMap/HashSet/SortedMap/
// SortedSet also only expose `to_array`); iteration support is via
// `Deque::to_array` / `Deque::from_array`.

//# Types

export struct Deque[T] {
  mut buf: Array[Option[T]];
  mut head: Int;
  mut size: Int
}

//# Internal helpers

fn alloc_slots[T](cap: Int) -> Array[Option[T]] {
  let b = ArrayBuilder::new()
  let mut i = 0
  while i < cap {
    let none_slot: Option[T] = None
    ArrayBuilder::push(b, none_slot)
    i = i + 1
  }
  ArrayBuilder::freeze(b)
}

// Physical index of logical position `i` (0 <= i < d.size) in `d`.
fn phys_index[T](d: Deque[T], i: Int) -> Int {
  let cap = Array::length(d.buf)
  let idx = (d.head + i) % cap
  if idx < 0 {
    idx + cap
  } else {
    idx
  }
}

// Double the backing array, copying live elements into logical order.
// Called only when size == capacity, right before a push, so the new
// array always has room for at least one more element.
fn grow[T](d: Deque[T]) -> Unit {
  let cap = Array::length(d.buf)
  let new_cap = if cap < 1 {
    4
  } else {
    cap * 2
  }
  let fresh: Array[Option[T]] = alloc_slots(new_cap)
  let mut i = 0
  while i < d.size {
    Array::set(fresh, i, Array::get(d.buf, phys_index(d, i)))
    i = i + 1
  }
  d.buf = fresh
  d.head = 0
}

//# Constructors

export fn Deque::with_capacity[T](capacity: Int) -> Deque[T] {
  let cap = if capacity < 4 {
    4
  } else {
    capacity
  }
  Deque::{ buf: alloc_slots(cap), head: 0, size: 0 }
}

export fn Deque::new[T]() -> Deque[T] {
  Deque::with_capacity(8)
}

//# Operations

export fn Deque::length[T](d: Deque[T]) -> Int {
  d.size
}

export fn Deque::is_empty[T](d: Deque[T]) -> Bool {
  d.size == 0
}

export fn Deque::push_back[T](d: Deque[T], x: T) -> Unit {
  if d.size == Array::length(d.buf) {
    grow(d)
  }
  let idx = phys_index(d, d.size)
  Array::set(d.buf, idx, Some(x))
  d.size = d.size + 1
}

export fn Deque::push_front[T](d: Deque[T], x: T) -> Unit {
  if d.size == Array::length(d.buf) {
    grow(d)
  }
  let cap = Array::length(d.buf)
  let mut new_head = d.head - 1
  if new_head < 0 {
    new_head = new_head + cap
  }
  Array::set(d.buf, new_head, Some(x))
  d.head = new_head
  d.size = d.size + 1
}

export fn Deque::pop_front[T](d: Deque[T]) -> Option[T] {
  if d.size == 0 {
    None
  } else {
    let idx = d.head
    let result = Array::get(d.buf, idx)
    let none_slot: Option[T] = None
    Array::set(d.buf, idx, none_slot)
    let cap = Array::length(d.buf)
    let mut next_head = d.head + 1
    if next_head >= cap {
      next_head = next_head - cap
    }
    d.head = next_head
    d.size = d.size - 1
    result
  }
}

export fn Deque::pop_back[T](d: Deque[T]) -> Option[T] {
  if d.size == 0 {
    None
  } else {
    let idx = phys_index(d, d.size - 1)
    let result = Array::get(d.buf, idx)
    let none_slot: Option[T] = None
    Array::set(d.buf, idx, none_slot)
    d.size = d.size - 1
    result
  }
}

export fn Deque::peek_front[T](d: Deque[T]) -> Option[T] {
  if d.size == 0 {
    None
  } else {
    Array::get(d.buf, d.head)
  }
}

export fn Deque::peek_back[T](d: Deque[T]) -> Option[T] {
  if d.size == 0 {
    None
  } else {
    Array::get(d.buf, phys_index(d, d.size - 1))
  }
}

export fn Deque::to_array[T](d: Deque[T]) -> Array[T] {
  let b = ArrayBuilder::new()
  let mut i = 0
  while i < d.size {
    match Array::get(d.buf, phys_index(d, i)) {
      Some(v) => ArrayBuilder::push(b, v),
      None => ()
    }
    i = i + 1
  }
  ArrayBuilder::freeze(b)
}

export fn Deque::from_array[T](xs: Array[T]) -> Deque[T] {
  let n = Array::length(xs)
  let cap = if n < 4 {
    4
  } else {
    n
  }
  let d: Deque[T] = Deque::with_capacity(cap)
  let mut i = 0
  while i < n {
    Deque::push_back(d, Array::get(xs, i))
    i = i + 1
  }
  d
}
