version 0.0.1

// @vibex/collections — 汎用データ構造 第 1 弾 (explicit-dict 方式)。
// HashMap / HashSet: open addressing (linear probing + tombstone、負荷率 0.7
// で 2x rehash)。SortedMap / SortedSet: AVL (immutable node + mut root 差し替え)。
// 比較・ハッシュは関数を明示引数で渡す (method-bearing trait 非依存)。
// Int / String key は new_int / new_string 特化コンストラクタを使う。
// keys/values/to_array は HashMap/HashSet では順序不定、SortedMap/SortedSet
// では昇順。range(lo, hi) は両端 inclusive。

import ./key.vibe {}
import ./hashmap.vibe {}
import ./hashset.vibe {}
import ./sortedmap.vibe {}
import ./sortedset.vibe {}

type HashMap[K, V]
type HashSet[T]
type SortedMap[K, V]
type SortedSet[T]

// key dictionaries (Int / String)
fn hash_int(x: Int) -> Int
fn eq_int(a: Int, b: Int) -> Bool
fn compare_int(a: Int, b: Int) -> Int
fn hash_string(s: String) -> Int
fn eq_string(a: String, b: String) -> Bool
fn compare_string(a: String, b: String) -> Int

// HashMap
fn HashMap::new[K, V](hash_fn: (K) -> Int, eq_fn: (K, K) -> Bool) -> HashMap[K, V]
fn HashMap::with_capacity[K, V](hash_fn: (K) -> Int, eq_fn: (K, K) -> Bool, capacity: Int) -> HashMap[K, V]
fn HashMap::new_int[V]() -> HashMap[Int, V]
fn HashMap::new_string[V]() -> HashMap[String, V]
fn HashMap::with_capacity_int[V](capacity: Int) -> HashMap[Int, V]
fn HashMap::with_capacity_string[V](capacity: Int) -> HashMap[String, V]
fn HashMap::set[K, V](m: HashMap[K, V], k: K, v: V) -> Unit
fn HashMap::get[K, V](m: HashMap[K, V], k: K) -> Option[V]
fn HashMap::has[K, V](m: HashMap[K, V], k: K) -> Bool
fn HashMap::delete[K, V](m: HashMap[K, V], k: K) -> Bool
fn HashMap::size[K, V](m: HashMap[K, V]) -> Int
fn HashMap::keys[K, V](m: HashMap[K, V]) -> Array[K]
fn HashMap::values[K, V](m: HashMap[K, V]) -> Array[V]
fn HashMap::to_array[K, V](m: HashMap[K, V]) -> Array[(K, V)]

// HashSet
fn HashSet::new[T](hash_fn: (T) -> Int, eq_fn: (T, T) -> Bool) -> HashSet[T]
fn HashSet::with_capacity[T](hash_fn: (T) -> Int, eq_fn: (T, T) -> Bool, capacity: Int) -> HashSet[T]
fn HashSet::new_int() -> HashSet[Int]
fn HashSet::new_string() -> HashSet[String]
fn HashSet::add[T](s: HashSet[T], x: T) -> Unit
fn HashSet::has[T](s: HashSet[T], x: T) -> Bool
fn HashSet::delete[T](s: HashSet[T], x: T) -> Bool
fn HashSet::size[T](s: HashSet[T]) -> Int
fn HashSet::to_array[T](s: HashSet[T]) -> Array[T]
fn HashSet::union[T](a: HashSet[T], b: HashSet[T]) -> HashSet[T]
fn HashSet::intersect[T](a: HashSet[T], b: HashSet[T]) -> HashSet[T]
fn HashSet::difference[T](a: HashSet[T], b: HashSet[T]) -> HashSet[T]

// SortedMap
fn SortedMap::new[K, V](cmp: (K, K) -> Int) -> SortedMap[K, V]
fn SortedMap::new_int[V]() -> SortedMap[Int, V]
fn SortedMap::new_string[V]() -> SortedMap[String, V]
fn SortedMap::set[K, V](m: SortedMap[K, V], k: K, v: V) -> Unit
fn SortedMap::get[K, V](m: SortedMap[K, V], k: K) -> Option[V]
fn SortedMap::has[K, V](m: SortedMap[K, V], k: K) -> Bool
fn SortedMap::delete[K, V](m: SortedMap[K, V], k: K) -> Bool
fn SortedMap::size[K, V](m: SortedMap[K, V]) -> Int
fn SortedMap::min[K, V](m: SortedMap[K, V]) -> Option[(K, V)]
fn SortedMap::max[K, V](m: SortedMap[K, V]) -> Option[(K, V)]
fn SortedMap::keys[K, V](m: SortedMap[K, V]) -> Array[K]
fn SortedMap::values[K, V](m: SortedMap[K, V]) -> Array[V]
fn SortedMap::to_array[K, V](m: SortedMap[K, V]) -> Array[(K, V)]
fn SortedMap::range[K, V](m: SortedMap[K, V], lo: K, hi: K) -> Array[(K, V)]

// SortedSet
fn SortedSet::new[T](cmp: (T, T) -> Int) -> SortedSet[T]
fn SortedSet::new_int() -> SortedSet[Int]
fn SortedSet::new_string() -> SortedSet[String]
fn SortedSet::add[T](s: SortedSet[T], x: T) -> Unit
fn SortedSet::has[T](s: SortedSet[T], x: T) -> Bool
fn SortedSet::delete[T](s: SortedSet[T], x: T) -> Bool
fn SortedSet::size[T](s: SortedSet[T]) -> Int
fn SortedSet::min[T](s: SortedSet[T]) -> Option[T]
fn SortedSet::max[T](s: SortedSet[T]) -> Option[T]
fn SortedSet::to_array[T](s: SortedSet[T]) -> Array[T]
fn SortedSet::range[T](s: SortedSet[T], lo: T, hi: T) -> Array[T]
fn SortedSet::union[T](a: SortedSet[T], b: SortedSet[T]) -> SortedSet[T]
fn SortedSet::intersect[T](a: SortedSet[T], b: SortedSet[T]) -> SortedSet[T]
fn SortedSet::difference[T](a: SortedSet[T], b: SortedSet[T]) -> SortedSet[T]

let version: String
