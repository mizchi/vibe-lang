//# Imports

import .{
  Deque, Deque::is_empty, Deque::new as deque_new, Deque::pop_front as deque_pop_front, Deque::push_back as deque_push_back, HashMap, HashMap::get, HashMap::new_int, HashMap::set, HashSet, HashSet::add, HashSet::has, HashSet::new_string, SortedMap, SortedMap::keys, SortedMap::new_int as sorted_map_new_int, SortedMap::set as sorted_map_set, SortedSet, SortedSet::add as sorted_set_add, SortedSet::new_int as sorted_set_new_int, SortedSet::to_array, compare_string, hash_int, version
}

//# Misc

test "x/collections index exports the five containers" {
  let m: HashMap[Int, String] = HashMap::new_int()
  HashMap::set(m, 1, "one")
  match HashMap::get(m, 1) {
    Some(v) => assert_eq(v, "one"),
    None => assert_eq(1, 2)
  }

  let hs: HashSet[String] = HashSet::new_string()
  HashSet::add(hs, "x")
  assert_eq(HashSet::has(hs, "x"), true)

  let sm: SortedMap[Int, Int] = sorted_map_new_int()
  sorted_map_set(sm, 2, 20)
  sorted_map_set(sm, 1, 10)
  let ks = SortedMap::keys(sm)
  assert_eq(Array::get(ks, 0), 1)
  assert_eq(Array::get(ks, 1), 2)

  let ss: SortedSet[Int] = sorted_set_new_int()
  sorted_set_add(ss, 3)
  sorted_set_add(ss, 1)
  let xs = SortedSet::to_array(ss)
  assert_eq(Array::get(xs, 0), 1)
  assert_eq(Array::get(xs, 1), 3)

  let dq: Deque[Int] = deque_new()
  deque_push_back(dq, 1)
  deque_push_back(dq, 2)
  assert_eq(Deque::is_empty(dq), false)
  match deque_pop_front(dq) {
    Some(v) => assert_eq(v, 1),
    None => assert_eq(1, 2)
  }

  assert_eq(hash_int(0), 0)
  assert_eq(compare_string("a", "b") < 0, true)
  assert_eq(version, "0.0.1")
}
