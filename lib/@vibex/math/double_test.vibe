//# Imports

import ./double.vibe {
  acos, asin, atan, atan2, cos, degrees, exp_double, hypot, ln, log10, pi, pow_double, radians, sin, sqrt, tan
}

//# Functions

let approx = (a: Double, b: Double) -> Bool {
  let diff = a - b
  let d = if diff < 0.0 {
    0.0 - diff
  } else {
    diff
  }
  d < 0.0001
}

//# Misc

test "sin 0" {
  assert(approx(sin(0.0), 0.0))
}

test "sin pi/2" {
  assert(approx(sin(pi / 2.0), 1.0))
}

test "sin pi" {
  assert(approx(sin(pi), 0.0))
}

test "sin -pi/2" {
  assert(approx(sin(0.0 - pi / 2.0), -1.0))
}

test "cos 0" {
  assert(approx(cos(0.0), 1.0))
}

test "cos pi/2" {
  assert(approx(cos(pi / 2.0), 0.0))
}

test "cos pi" {
  assert(approx(cos(pi), -1.0))
}

test "tan 0" {
  assert(approx(tan(0.0), 0.0))
}

test "tan pi/4" {
  assert(approx(tan(pi / 4.0), 1.0))
}

test "sqrt 4" {
  assert(approx(sqrt(4.0), 2.0))
}

test "sqrt 2" {
  assert(approx(sqrt(2.0), 1.4142))
}

test "sqrt 0" {
  assert(approx(sqrt(0.0), 0.0))
}

test "atan 0" {
  assert(approx(atan(0.0), 0.0))
}

test "atan 1" {
  assert(approx(atan(1.0), pi / 4.0))
}

test "atan -1" {
  assert(approx(atan(-1.0), 0.0 - pi / 4.0))
}

test "atan large" {
  // atan(100) ≈ pi/2 - 0.01 ≈ 1.5608
  let v = atan(100.0)
  assert(v > 1.5)
  assert(v < 1.58)
}

test "atan2 quadrants" {
  assert(approx(atan2(1.0, 1.0), pi / 4.0))
  assert(approx(atan2(1.0, -1.0), 3.0 * pi / 4.0))
  assert(approx(atan2(-1.0, -1.0), 0.0 - 3.0 * pi / 4.0))
  assert(approx(atan2(-1.0, 1.0), 0.0 - pi / 4.0))
}

test "atan2 axes" {
  assert(approx(atan2(1.0, 0.0), pi / 2.0))
  assert(approx(atan2(-1.0, 0.0), 0.0 - pi / 2.0))
  assert(approx(atan2(0.0, 1.0), 0.0))
}

test "asin 0" {
  assert(approx(asin(0.0), 0.0))
}

test "asin 1" {
  assert(approx(asin(1.0), pi / 2.0))
}

test "asin -1" {
  assert(approx(asin(-1.0), 0.0 - pi / 2.0))
}

test "acos 1" {
  assert(approx(acos(1.0), 0.0))
}

test "acos 0" {
  assert(approx(acos(0.0), pi / 2.0))
}

test "acos -1" {
  assert(approx(acos(-1.0), pi))
}

test "exp 0" {
  assert(approx(exp_double(0.0), 1.0))
}

test "exp 1" {
  assert(approx(exp_double(1.0), 2.7182))
}

test "ln 1" {
  assert(approx(ln(1.0), 0.0))
}

test "ln e" {
  assert(approx(ln(2.71828), 1.0))
}

test "log10 100" {
  assert(approx(log10(100.0), 2.0))
}

test "log10 1000" {
  assert(approx(log10(1000.0), 3.0))
}

test "pow_double" {
  assert(approx(pow_double(2.0, 3.0), 8.0))
  assert(approx(pow_double(2.0, 0.5), 1.4142))
}

test "hypot" {
  assert(approx(hypot(3.0, 4.0), 5.0))
  assert(approx(hypot(5.0, 12.0), 13.0))
}

test "degrees" {
  assert(approx(degrees(pi), 180.0))
  assert(approx(degrees(pi / 2.0), 90.0))
}

test "radians" {
  assert(approx(radians(180.0), pi))
  assert(approx(radians(90.0), pi / 2.0))
}

test "sin/asin roundtrip" {
  assert(approx(asin(sin(0.5)), 0.5))
  assert(approx(asin(sin(1.0)), 1.0))
}

test "cos/acos roundtrip" {
  assert(approx(acos(cos(0.5)), 0.5))
  assert(approx(acos(cos(1.0)), 1.0))
}

test "exp/ln roundtrip" {
  assert(approx(ln(exp_double(2.0)), 2.0))
  assert(approx(exp_double(ln(5.0)), 5.0))
}
