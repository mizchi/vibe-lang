//# Functions

export let abs = (n: Int) -> Int {
  if n < 0 {
    0 - n
  } else {
    n
  }
}

export let gcd = (a: Int, b: Int) -> Int {
  let mut x = abs(a)
  let mut y = abs(b)
  while y > 0 {
    let t = y
    y = x - (x / y) * y
    x = t
  }
  x
}

export let lcm = (a: Int, b: Int) -> Int {
  let g = gcd(a, b)
  if g == 0 {
    0
  } else {
    abs(a) / g * abs(b)
  }
}

export let max = (a: Int, b: Int) -> Int {
  if a >= b {
    a
  } else {
    b
  }
}

export let min = (a: Int, b: Int) -> Int {
  if a <= b {
    a
  } else {
    b
  }
}

export let pow = (base: Int, exp: Int) -> Int {
  if exp < 0 {
    0
  }
  else {
    let mut result = 1
    let mut b = base
    let mut e = exp
    while e > 0 {
      if (e&1) == 1 {
        result = result * b
      }
      b = b * b
      e = e>>1
    }
    result
  }
}

export let sum = (arr: Array[Int]) -> Int {
  let len = Array::length(arr)
  let mut total = 0
  let mut i = 0
  while i < len {
    total = total + Array::get(arr, i)
    i = i + 1
  }
  total
}

export let comb = (n: Int, k: Int) -> Int {
  if k < 0 || k > n {
    0
  } else {
    let mut kk = k
    if kk > n - kk {
      kk = n - kk
    }
    let mut result = 1
    let mut i = 0
    while i < kk {
      result = result * (n - i) / (i + 1)
      i = i + 1
    }
    result
  }
}

export let log2 = (n: Int) -> Int {
  let mut v = n
  let mut r = 0
  while v > 1 {
    v = v>>1
    r = r + 1
  }
  r
}

export let perm = (n: Int, k: Int) -> Int {
  if k < 0 || k > n {
    0
  } else {
    let mut result = 1
    let mut i = 0
    while i < k {
      result = result * (n - i)
      i = i + 1
    }
    result
  }
}

export let sign = (n: Int) -> Int {
  if n > 0 {
    1
  } else if n < 0 {
    -1
  } else {
    0
  }
}

export let clamp = (n: Int, lo: Int, hi: Int) -> Int {
  if n < lo {
    lo
  } else if n > hi {
    hi
  } else {
    n
  }
}

export let divmod = (a: Int, d: Int) -> (Int, Int) {
  let q = a / d
  let r = a - (q * d)
  (q, r)
}

export let is_odd = (n: Int) -> Bool {
  (n&1) == 1
}

export let is_even = (n: Int) -> Bool {
  (n&1) == 0
}

export let product = (arr: Array[Int]) -> Int {
  let len = Array::length(arr)
  let mut total = 1
  let mut i = 0
  while i < len {
    total = total * Array::get(arr, i)
    i = i + 1
  }
  total
}

export let sqrt_int = (n: Int) -> Int {
  if n <= 0 {
    0
  } else {
    let mut x = n
    let mut y = (x + 1) / 2
    while y < x {
      x = y
      y = (x + n / x) / 2
    }
    x
  }
}

export let max_array = (arr: Array[Int]) -> Int {
  let len = Array::length(arr)
  let mut m = Array::get(arr, 0)
  let mut i = 1
  while i < len {
    let v = Array::get(arr, i)
    if v > m {
      m = v
    }
    i = i + 1
  }
  m
}

export let min_array = (arr: Array[Int]) -> Int {
  let len = Array::length(arr)
  let mut m = Array::get(arr, 0)
  let mut i = 1
  while i < len {
    let v = Array::get(arr, i)
    if v < m {
      m = v
    }
    i = i + 1
  }
  m
}

export let is_power_of_two = (n: Int) -> Bool {
  n > 0 && (n&(n - 1)) == 0
}

export let version: String = "0.0.1"
