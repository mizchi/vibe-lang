//# Imports

import ./wat_parser.vibe {
  decode_string, filter_tokens, is_instruction, parse_int, parse_module_sections, tokenize, wat_exports, wat_func_count, wat_section_names
}

//# Functions

fn small_wat() -> String {
  "(module (type (func (result i32))) (func (type 0) i32.const 42 end) (memory 1024) (export \"_start\" (func 0)))"
}

//# Misc

bench "watparser/tokenize" {
  let _ = tokenize(small_wat())
}

bench "watparser/filter_tokens" {
  let _ = filter_tokens(tokenize(small_wat()))
}

bench "watparser/parse_sections" {
  let src = small_wat()
  let _ = parse_module_sections(src, filter_tokens(tokenize(src)))
}

bench "watparser/parse_int" {
  let _ = parse_int("123456")
}

bench "watparser/decode_string" {
  let _ = decode_string("\"hello\"")
}

bench "watparser/is_instruction" {
  let _ = is_instruction("i32.const")
}

bench "watparser/wat_section_names" {
  let _ = wat_section_names(small_wat())
}

bench "watparser/wat_exports" {
  let _ = wat_exports(small_wat())
}

bench "watparser/wat_func_count" {
  let _ = wat_func_count(small_wat())
}
