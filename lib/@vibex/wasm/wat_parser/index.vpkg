version 0.0.1

// @vibex/wasm/wat_parser — WAT text tokenizer (offset-tuple tokens),
// token-type tag accessors, section scanner, and `wat_*` whole-source
// summaries (ADR-0070 Phase 3, #897). Every declared name is a pure fn
// over `String` + primitives/tuples/arrays of primitives; no
// opaque/transparent type surface of its own (same shape as
// @vibe/optimizer, PR #918).
//
// `version` was `export let version = "0.0.1"` directly in the old
// index.vibe facade — a real importable binding, not just contract
// metadata — preserved as an implementation-file value (wat_parser.vibe)
// with a matching bodyless declaration here (Codex review precedent, PR
// #914). No other value aliases existed in the old facade.
//
// wat_parser_test.vibe and the bench file used to pull names in via a
// literal-filename `import ./index.vibe {...}` of this package's own
// facade; both were retargeted to `import ./wat_parser.vibe {...}` (the
// impl file that defines every imported name) once this contract replaced
// index.vibe. bench.vibe was ALSO renamed to wat_parser_bench.vibe (Codex
// review precedent, #912/PR #913): a bare `bench.vibe` isn't excluded by
// implicit membership's `_bench.vibe`-suffix rule.

import ./wat_parser.vibe {}

let version: String

fn tokenize(src: String) -> Array[(Int, Int, Int)]
fn token_text(src: String, tok: (Int, Int, Int)) -> String
fn filter_tokens(tokens: Array[(Int, Int, Int)]) -> Array[(Int, Int, Int)]
fn parse_module_sections(src: String, tokens: Array[(Int, Int, Int)]) -> Array[(String, Int, Int)]
fn is_instruction(kw: String) -> Bool
fn parse_int(s: String) -> Int
fn decode_string(s: String) -> String
fn tok_type_lparen() -> Int
fn tok_type_rparen() -> Int
fn tok_type_keyword() -> Int
fn tok_type_ident() -> Int
fn tok_type_int() -> Int
fn tok_type_float() -> Int
fn tok_type_string() -> Int
fn wat_section_names(src: String) -> Array[String]
fn wat_type_sigs(src: String) -> Array[String]
fn wat_exports(src: String) -> Array[(String, String)]
fn wat_imports(src: String) -> Array[(String, String, String)]
fn wat_func_count(src: String) -> Int
fn wat_summary(src: String) -> String
