version 0.0.1

// @vibex/wasm/wasm_runtime — a tiny core-wasm interpreter: linear +
// gc-heap body executors, module-level exec drivers, and the
// opcode-name/disassembly helpers (ADR-0070 Phase 3, #897). Every declared
// name is a pure fn over `Bytes`/`Array[Int]` + primitives/tuples; no
// opaque/transparent type surface of its own (same shape as
// @vibe/optimizer, PR #918).
//
// `version` was `export let version = "0.0.1"` directly in the old
// index.vibe facade — a real importable binding, not just contract
// metadata — preserved as an implementation-file value (wasm_runtime.vibe)
// with a matching bodyless declaration here (Codex review precedent, PR
// #914). No other value aliases existed in the old facade.
//
// wasm_runtime_test.vibe and the bench file used to pull names in via a
// literal-filename `import ./index.vibe {...}` of this package's own
// facade; both were retargeted to `import ./wasm_runtime.vibe {...}` (the
// impl file that defines every imported name) once this contract replaced
// index.vibe. bench.vibe was ALSO renamed to wasm_runtime_bench.vibe
// (Codex review precedent, #912/PR #913): a bare `bench.vibe` isn't
// excluded by implicit membership's `_bench.vibe`-suffix rule. The
// parent-dir lib/@vibex/wasm/{coverage,spec_control,spec_i32}_test.vibe
// already import this package in directory form (`import ./wasm_runtime
// {...}`), which resolves to this contract unchanged.

import ./wasm_runtime.vibe {}

let version: String

fn make_memory(pages: Int) -> Bytes
fn opcode_name(op: Int) -> String
fn disassemble(code: Bytes, start: Int, end_pos: Int) -> Array[String]
fn exec_body(code: Bytes, pc_start: Int, pc_end: Int, locals: Array[Int], stack: Array[Int], memory: Bytes, globals: Array[Int], func_bodies: Array[(Int, Int, Int, Int)]) -> (Int, Int)
fn exec_body_gc(code: Bytes, pc_start: Int, pc_end: Int, locals: Array[Int], stack: Array[Int], memory: Bytes, globals: Array[Int], func_bodies: Array[(Int, Int, Int, Int)], gc_heap: Array[Array[Int]]) -> (Int, Int)
fn exec_module(wasm_bytes: Bytes, export_name: String) -> (Int, Int)
fn exec_module_with_args(wasm_bytes: Bytes, export_name: String, args: Array[Int]) -> (Int, Int)
