//# Imports

import ./concurrent.vibe {
  type Channel,
  type ChannelConfigError,
  type Receiver,
  type SendError,
  type Sender,
  type TaskError,
  type TaskGroup,
  type TaskHandle,
  type TaskStep,
  Channel::bounded,
  Receiver::recv,
  Receiver::recv_wait,
  Sender::clone,
  Sender::release,
  Sender::send,
  Sender::send_wait,
  TaskGroup::adopt,
  TaskGroup::pump,
  TaskGroup::pump_all,
  TaskGroup::run,
  TaskGroup::spawn,
  TaskGroup::spawn_suspend,
  TaskHandle::cancel,
  TaskHandle::join,
  TaskHandle::park,
  TaskHandle::park_poll,
  TaskHandle::result_wait,
  TaskHandle::settle,
  TaskHandle::wake
}

//# Test types

/// #1374: a payload type of this file's own, so the kind the throw site records
/// is unambiguously not `String`.
enum SettleBoom {
  SettleBang(Int)
}

//# Test helpers

/// #1324: `TaskHandle::join` / `TaskGroup::run` now THROW their `TaskError`
/// instead of returning `Result[T, TaskError]`. The happy path is the value
/// itself (an unexpected failure fails the test by escaping); a test that
/// asserts a SPECIFIC failure catches it. `TaskGroup::run` is caught INLINE
/// at the use site, never through a helper or a closure literal: its row
/// carries the effect variable `e`, and the ADR-0076 lowering refuses a
/// row-variable callee reached from a closure literal (scps_calls_ok).
fn caught_join[rg, e, T](h: TaskHandle[rg, e, T]) -> Option[TaskError] with e {
  handle {
    let _v = TaskHandle::join(h)
    None
  } with Exception[TaskError] {
    Throw(err) => Some(err)
  }
}

//# Types

/// Transparent effect declaration (#752): matches the package contract's
/// Async by definition — the declaration IS the contract.
effect Async {
  Suspend(Int) -> Int
}

//# Misc

/// THE capability run-to-completion could not express (concurrent.vibe's
/// old header note): two tasks blocking mid-body against each other.
/// Both bodies suspend twice; pump_all round-robins the stored
/// continuations, so the log interleaves 1..6 in strict alternation.
/// `log` is deliberately a LOCAL of the test: suspend continuations
/// capturing a function-local alongside a second suspend site is exactly
/// the #1097 use-after-free shape — keeping it local makes this test the
/// library-level regression lock for that fix.
test "adopted tasks interleave mid-body via Async::Suspend" {
  let log: Array[Int] = [
  ]
  let out = TaskGroup::run((g) -> {
    let ha = TaskGroup::adopt(g)
    TaskHandle::settle(ha, handle {
      Array::push(log, 1)
      let _w1 = perform Async::Suspend(0)
      Array::push(log, 3)
      let _w2 = perform Async::Suspend(0)
      Array::push(log, 5)
      SDone(100)
    } with Async {
      Suspend(r) => {
        TaskHandle::park_poll(ha, resume, r == 1)
        SParked
      }
    })
    let hb = TaskGroup::adopt(g)
    TaskHandle::settle(hb, handle {
      Array::push(log, 2)
      let _w1 = perform Async::Suspend(0)
      Array::push(log, 4)
      let _w2 = perform Async::Suspend(0)
      Array::push(log, 6)
      SDone(200)
    } with Async {
      Suspend(r) => {
        TaskHandle::park_poll(hb, resume, r == 1)
        SParked
      }
    })
    TaskGroup::pump_all(g)
    let ra = TaskHandle::join(ha)
    let rb = TaskHandle::join(hb)
    ra + rb
  })
  assert_eq(out, 300)
  assert(Array::length(log) == 6)
  assert(Array::get(log, 0) == 1)
  assert(Array::get(log, 1) == 2)
  assert(Array::get(log, 2) == 3)
  assert(Array::get(log, 3) == 4)
  assert(Array::get(log, 4) == 5)
  assert(Array::get(log, 5) == 6)
}

test "wake delivers the resume value to the suspension point" {
  let out = TaskGroup::run((g) -> {
    let h = TaskGroup::adopt(g)
    TaskHandle::settle(h, handle {
      let got = perform Async::Suspend(7)
      SDone(got * 2)
    } with Async {
      Suspend(r) => {
        TaskHandle::park(h, resume)
        SParked
      }
    })
    let woke = TaskHandle::wake(h, 21)
    let again = TaskHandle::wake(h, 99)
    let r = TaskHandle::join(h)
    if woke && !again {
      r
    } else {
      -2
    }
  })
  assert_eq(out, 42)
}

test "cancel on a parked task resolves Cancelled and drops the continuation" {
  let out = TaskGroup::run((g) -> {
    let h = TaskGroup::adopt(g)
    TaskHandle::settle(h, handle {
      let got = perform Async::Suspend(0)
      SDone(got)
    } with Async {
      Suspend(r) => {
        TaskHandle::park(h, resume)
        SParked
      }
    })
    TaskHandle::cancel(h)
    let woke = TaskHandle::wake(h, 1)
    let cancelled = caught_join(h) is Some(TaskError::Cancelled)
    if !woke && cancelled {
      1
    } else {
      0
    }
  })
  assert_eq(out, 1)
}

/// closure-CPS (ADR-0076 追記31 Vertical B): the handle site lives inside
/// spawn_suspend (the library) — the task bodies here are PLAIN closures
/// with an Async row, no user-side handle boilerplate at all. The suspend
/// lowering step-compiles the two literals at this call site and
/// spawn_suspend's internal handle bubbles the steps through its `f()`
/// closure-param call. Pins the same strict 1..6 alternation as the
/// adoption-site test above.
///
/// #1081 step 3 Phase B: unlike the adoption-site test above (which drives
/// its closures through a local `handle` expression, not a `TaskGroup::
/// spawn_suspend` CALL, so the `Spawnable[r]` check does not apply to it),
/// these ARE spawn_suspend calls -- an outer captured plain `Array` is no
/// longer a legal capture. A same-region `Sender` IS Spawnable-legal
/// (docs/concurrency.md), so each task reports through a cloned Sender
/// instead of a shared Array. `Sender::send` used to be a plain row-free
/// function, but #1181 made `TaskGroup`/`Channel`/`Sender` row-polymorphic
/// in `e` to let spawned tasks use effects beyond `Error`, so `Sender::send`
/// now declares `with { e }` -- a row VARIABLE, which the suspend lowering's
/// eligibility check (`scps_calls_ok`/`scps_row_has_var`,
/// `inline_direct_perform.vibe`) always conservatively rejects as a callee
/// from inside an `Async`-carrying closure (it cannot see that `e` resolves
/// to `{}` here). `Sender::send_wait`'s row is variable-free
/// (`with { Exception[SendError], Async }` since #1324 -- a BRACKETED label
/// is not a row variable and does not affect eligibility) and it is
/// eligible; its buffered fast path is identical to `Sender::send`'s, and
/// capacity (6) never drops below the 6 total sends here, so the fast path
/// is always taken, no `Closed` is ever thrown, and behavior is unchanged.
test "spawn_suspend interleaves two plain closure bodies" {
  let out = TaskGroup::run((g) -> {
    {
      let (tx, rx) = Channel::bounded(g, 6)
      {
        let tx2 = Sender::clone(tx)
        let ha = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
          let _s1 = Sender::send_wait(tx, 1)
          let _a = perform Async::Suspend(0)
          let _s3 = Sender::send_wait(tx, 3)
          let _b = perform Async::Suspend(0)
          let _s5 = Sender::send_wait(tx, 5)
          Sender::release(tx)
          100
        })
        let hb = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
          let _s2 = Sender::send_wait(tx2, 2)
          let _a = perform Async::Suspend(0)
          let _s4 = Sender::send_wait(tx2, 4)
          let _b = perform Async::Suspend(0)
          let _s6 = Sender::send_wait(tx2, 6)
          Sender::release(tx2)
          200
        })
        TaskGroup::pump_all(g)
        let ra = TaskHandle::join(ha)
        let rb = TaskHandle::join(hb)
        let log = ArrayBuilder::new()
        let mut going = true
        while going {
          match Receiver::recv(rx) {
            Some(v) => ArrayBuilder::push(log, v),
            None => {
              going = false
            }
          }
        }
        ArrayBuilder::push(log, ra + rb)
        ArrayBuilder::freeze(log)
      }
    }
  })
  let log = out
  assert_eq(Array::length(log), 7)
  assert_eq(Array::get(log, 0), 1)
  assert_eq(Array::get(log, 1), 2)
  assert_eq(Array::get(log, 2), 3)
  assert_eq(Array::get(log, 3), 4)
  assert_eq(Array::get(log, 4), 5)
  assert_eq(Array::get(log, 5), 6)
  assert_eq(Array::get(log, 6), 300)
}

/// A pure body (no perform at all) passed to spawn_suspend still settles:
/// the arg-position rule Done-wraps the literal so it matches the step
/// convention spawn_suspend's transformed body expects.
test "spawn_suspend with a pure body settles synchronously" {
  let out = TaskGroup::run((g) -> {
    let h = TaskGroup::spawn_suspend(g, () -> 6 * 7)
    TaskHandle::join(h)
  })
  assert_eq(out, 42)
}

/// Codex review (#1111): the ADOPTION-lane canonical arm must propagate
/// the suspend reason (park_poll(h, resume, r == 1)); a channel wait
/// parked through it is poller-classified, so a deliverable message
/// resumes it and an undeliverable one would TRAP (not livelock). Here:
/// an adopted consumer blocks in recv_wait, the run body then supplies
/// the message through the stack-driving send, and pump_all delivers.
test "adoption-lane recv_wait parks as a poller and resumes on delivery" {
  let out = TaskGroup::run((g) -> {
    {
      let pair = Channel::bounded(g, 1)
      {
        let (tx, rx) = pair
        let h = TaskGroup::adopt(g)
        TaskHandle::settle(h, handle {
          let r1 = Receiver::recv_wait(rx)
          let a = match r1 {
            Some(v) => v,
            None => 0 - 1
          }
          SDone(a * 3)
        } with Async {
          Suspend(r) => {
            TaskHandle::park_poll(h, resume, r == 1)
            SParked
          }
        })
        let _s = Sender::send(tx, 14)
        Sender::release(tx)
        TaskGroup::pump_all(g)
        TaskHandle::join(h)
      }
    }
  })
  assert_eq(out, 42)
}

/// Codex review regression (#1110): a LONE task that yields (Suspend(0))
/// three or more times must complete normally — cooperative yields carry
/// no progress bump, and the first deadlock-detector counted them as
/// stalls (traps at the 3rd consecutive yield of a single task). Yields
/// are never deadlock evidence; only pollers (Suspend(1)) are.
test "a lone spawn_suspend task may yield three times without tripping the deadlock trap" {
  let out = TaskGroup::run((g) -> {
    let h = TaskGroup::spawn_suspend(g, () -> Int with Async {
      let _y1 = perform Async::Suspend(0)
      let _y2 = perform Async::Suspend(0)
      let _y3 = perform Async::Suspend(0)
      21
    })
    TaskGroup::pump_all(g)
    (TaskHandle::join(h) * 2)
  })
  assert_eq(out, 42)
}

/// Fail-fast × suspendable (ADR-0068 次スライス): a spawn_suspend body
/// whose Error::Throw escapes converts to Failed, records the group's
/// first observed failure, and AUTO-CANCELS parked siblings (their stored
/// continuations are dropped). Case 1: the throw happens on the settle
/// leg (before any suspend) — the sibling parked first and never wakes.
test "spawn_suspend Error on the settle leg fails fast and cancels the parked sibling" {
  let out = handle {
    TaskGroup::run((g) -> {
      let ha = TaskGroup::spawn_suspend(g, () -> Int with Async {
        let _w = perform Async::Suspend(0)
        100
      })
      let hb = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
        throw("boom")
      })
      TaskGroup::pump_all(g)
      let a_cancelled = caught_join(ha) is Some(TaskError::Cancelled)
      let b_failed = match caught_join(hb) {
        Some(TaskError::Failed(m)) => m == "boom",
        _ => false
      }
      if a_cancelled && b_failed {
        1
      } else {
        0
      }
    })
    None
  } with Exception[TaskError] {
    Throw(err) => Some(err)
  }
  assert(match out {
    Some(TaskError::Failed(m)) => m == "boom",
    _ => false
  })
}

/// #1374: the SUSPEND lane's two Error boundaries (the settle leg and each
/// resumed leg) funnel their payload into `fail_msg: String` through
/// `conc_fail_cell`, exactly like spawn's runner does -- so they had the same
/// erased-arm hazard, and #1375 fixed only the runner. A typed payload here
/// used to be stored as a raw pointer.
///
/// The payload is a ctor CALL rather than a bare nullary ctor: #1081's
/// Spawnable check reads a bare `Closed` inside a spawned closure as a captured
/// value and rejects it, which has nothing to do with what this test measures.
/// The kind the throw site records is the payload's declared TYPE, so the arm
/// reports `<SettleBoom>`; the String case directly above is unchanged, which
/// is the pair that matters -- the fix must be invisible to existing throws.
test "a typed throw on the settle leg is reported by kind, not as a pointer" {
  let out = handle {
    TaskGroup::run((g) -> {
      let hb = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
        throw(SettleBang(3))
      })
      TaskGroup::pump_all(g)
      match caught_join(hb) {
        Some(TaskError::Failed(m)) => assert_eq(m, "<SettleBoom>"),
        _ => assert(false)
      }
      1
    })
    None
  } with Exception[TaskError] {
    Throw(err) => Some(err)
  }
  match out {
    Some(TaskError::Failed(m)) => assert_eq(m, "<SettleBoom>"),
    _ => assert(false)
  }
}

/// Case 2: the throw happens on a RESUMED leg (after a suspend) — it runs
/// on the pump's stack, caught by the park wrapper's per-leg Error
/// boundary. The parked sibling is cancelled by the fail-fast sweep.
test "spawn_suspend Error after a resume fails fast from the pump stack" {
  let out = handle {
    TaskGroup::run((g) -> {
      let ha = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
        let _w = perform Async::Suspend(0)
        throw("later")
      })
      let hb = TaskGroup::spawn_suspend(g, () -> Int with Async {
        let _w1 = perform Async::Suspend(0)
        let _w2 = perform Async::Suspend(0)
        200
      })
      TaskGroup::pump_all(g)
      let a_failed = match caught_join(ha) {
        Some(TaskError::Failed(m)) => m == "later",
        _ => false
      }
      let b_cancelled = caught_join(hb) is Some(TaskError::Cancelled)
      if a_failed && b_cancelled {
        1
      } else {
        0
      }
    })
    None
  } with Exception[TaskError] {
    Throw(err) => Some(err)
  }
  assert(match out {
    Some(TaskError::Failed(m)) => m == "later",
    _ => false
  })
}

/// #1115 Codex review: BOTH failure lanes must run the fail-fast sweep.
/// A run-to-completion spawn child throwing (dispatched by run's close
/// drive) cancels the parked suspendable sibling — without the shared
/// sweep the close-time terminal check would TRAP on the still-parked
/// cell instead of returning Err(Failed(...)).
test "a spawn-lane failure cancels a parked spawn_suspend sibling" {
  let out = handle {
    TaskGroup::run((g) -> {
      let ha = TaskGroup::spawn_suspend(g, () -> Int with Async {
        let _w = perform Async::Suspend(0)
        100
      })
      let _hb = TaskGroup::spawn(g, () -> Int with Error {
        throw("spawn-lane")
      })
      7
    })
    None
  } with Exception[TaskError] {
    Throw(err) => Some(err)
  }
  assert(match out {
    Some(TaskError::Failed(m)) => m == "spawn-lane",
    _ => false
  })
}

/// Channel blocking (ADR-0076 追記31 の続きスライス): the shape the module
/// header called out as impossible under run-to-completion — a producer
/// overflowing a capacity-1 channel while the consumer drains — now works
/// with BOTH sides as plain spawn_suspend closures. send_wait deposits and
/// suspends when the buffer is full; recv_wait suspends while empty;
/// pump_all round-robins them. The log pins the exact deterministic
/// interleaving (producer logs 1..3 after each send, consumer logs 100+v
/// after each recv).
///
/// #1081 step 3 Phase B: an outer captured Array is no longer Spawnable-
/// legal for the same reason as the interleave test above. `tx`/`rx` are
/// already the channel under test (capacity 1, deliberately overflowed), so
/// a SECOND same-region channel (capacity 6, comfortably ahead of demand —
/// never itself blocks) carries the log entries instead; each side gets its
/// own cloned Sender. The log channel uses `Sender::send_wait`, not the
/// stack-driving `Sender::send`: #1181 made `Sender::send` row-polymorphic
/// (`with { e }`), which the suspend lowering's eligibility check
/// (`scps_calls_ok`/`scps_row_has_var`) always conservatively rejects as an
/// ineligible callee inside an `Async`-carrying closure (it cannot see that
/// `e` resolves to `{}` here). `send_wait`'s row is variable-free
/// (`with { Exception[SendError], Async }` since #1324) and is eligible,
/// and its buffered fast path is identical to `send`'s -- the log channel
/// (capacity 6, only 3 sends per side) never overflows it, so it never
/// actually suspends and the mid-body suspend points send_wait/recv_wait
/// pin on `tx`/`rx` are unaffected.
test "spawn_suspend producer/consumer block mid-body through a capacity-1 channel" {
  let out = TaskGroup::run((g) -> {
    {
      let pair = Channel::bounded(g, 1)
      {
        let (tx, rx) = pair
        {
          let logpair = Channel::bounded(g, 6)
          {
            let (logtx, logrx) = logpair
            let logtx2 = Sender::clone(logtx)
            let hp = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
              let _a = Sender::send_wait(tx, 10)
              let _l1 = Sender::send_wait(logtx, 1)
              let _b = Sender::send_wait(tx, 20)
              let _l2 = Sender::send_wait(logtx, 2)
              let _c = Sender::send_wait(tx, 30)
              let _l3 = Sender::send_wait(logtx, 3)
              Sender::release(tx)
              Sender::release(logtx)
              0
            })
            let hc = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
              let r1 = Receiver::recv_wait(rx)
              let a = match r1 {
                Some(v) => v,
                None => 0 - 1
              }
              let _l4 = Sender::send_wait(logtx2, 100 + a)
              let r2 = Receiver::recv_wait(rx)
              let b = match r2 {
                Some(v) => v,
                None => 0 - 1
              }
              let _l5 = Sender::send_wait(logtx2, 100 + b)
              let r3 = Receiver::recv_wait(rx)
              let c = match r3 {
                Some(v) => v,
                None => 0 - 1
              }
              let _l6 = Sender::send_wait(logtx2, 100 + c)
              Sender::release(logtx2)
              a * 100 + b * 10 + c
            })
            TaskGroup::pump_all(g)
            let rp = TaskHandle::join(hp)
            let rc = TaskHandle::join(hc)
            let log = ArrayBuilder::new()
            let mut going = true
            while going {
              match Receiver::recv(logrx) {
                Some(v) => ArrayBuilder::push(log, v),
                None => {
                  going = false
                }
              }
            }
            (rp * 10000 + rc, ArrayBuilder::freeze(log))
          }
        }
      }
    }
  })
  {
    let (v, log) = out
    {
      assert_eq(v, 1230)
      assert_eq(Array::length(log), 6)
      assert_eq(Array::get(log, 0), 1)
      assert_eq(Array::get(log, 1), 110)
      assert_eq(Array::get(log, 2), 120)
      assert_eq(Array::get(log, 3), 2)
      assert_eq(Array::get(log, 4), 3)
      assert_eq(Array::get(log, 5), 130)
    }
  }
}

/// Rendezvous (capacity 0): the suspended sender deposits first (the
/// linearization point), parks, and is woken after the receiver consumes.
test "spawn_suspend rendezvous send_wait/recv_wait on a capacity-0 channel" {
  let out = TaskGroup::run((g) -> {
    let pair = Channel::bounded(g, 0)
    {
      let (tx, rx) = pair
      let hp = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
        let _a = Sender::send_wait(tx, 7)
        Sender::release(tx)
        1
      })
      let hc = TaskGroup::spawn_suspend(g, () -> Int with Async {
        let r = Receiver::recv_wait(rx)
        match r {
          Some(v) => v,
          None => 0 - 1
        }
      })
      TaskGroup::pump_all(g)
      let rp = TaskHandle::join(hp)
      let rc = TaskHandle::join(hc)
      rp * 10 + rc
    }
  })
  assert_eq(out, 17)
}

test "a body that never suspends settles synchronously" {
  let out = TaskGroup::run((g) -> {
    let h = TaskGroup::adopt(g)
    TaskHandle::settle(h, handle {
      SDone(11 * 3)
    } with Async {
      Suspend(r) => {
        TaskHandle::park(h, resume)
        SParked
      }
    })
    TaskHandle::join(h)
  })
  assert_eq(out, 33)
}

/// ADR-0089 Decision 1 increment 3 (#1218): PLAIN `sleep` inside
/// spawn_suspend tasks parks with a sleep debt instead of blocking the
/// instance. The compiler retargets `sleep(ms)` to a synthesized
/// `perform Async::Suspend(-ms)` whenever the program contains a
/// `handle ... with Async` (spawn_suspend's internal handle qualifies), so
/// the library needs no special spelling any more -- `sleep_wait` is now
/// just an alias.
///
/// The log ORDER is the discriminator, no wall clock needed: task A sends
/// 1 and sleeps 10ms, task B sends 2 and sleeps 5ms. A blocking sleep
/// would run A to completion at its spawn site -> [1, 3, 2, 4]. Parking
/// with debts lets the pump settle the smaller debt first, so B resumes
/// before A -> [1, 2, 4, 3].
test "plain sleep parks a spawn_suspend task instead of blocking it" {
  let out = TaskGroup::run((g) -> {
    {
      let (tx, rx) = Channel::bounded(g, 4)
      {
        let tx2 = Sender::clone(tx)
        let ha = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
          let _s1 = Sender::send_wait(tx, 1)
          sleep(10)
          let _s3 = Sender::send_wait(tx, 3)
          Sender::release(tx)
          100
        })
        let hb = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
          let _s2 = Sender::send_wait(tx2, 2)
          sleep(5)
          let _s4 = Sender::send_wait(tx2, 4)
          Sender::release(tx2)
          200
        })
        TaskGroup::pump_all(g)
        let ra = TaskHandle::join(ha)
        let rb = TaskHandle::join(hb)
        let log = ArrayBuilder::new()
        let mut going = true
        while going {
          match Receiver::recv(rx) {
            Some(v) => ArrayBuilder::push(log, v),
            None => {
              going = false
            }
          }
        }
        ArrayBuilder::push(log, ra + rb)
        ArrayBuilder::freeze(log)
      }
    }
  })
  let log = out
  assert_eq(Array::length(log), 5)
  assert_eq(Array::get(log, 0), 1)
  assert_eq(Array::get(log, 1), 2)
  assert_eq(Array::get(log, 2), 4)
  assert_eq(Array::get(log, 3), 3)
  assert_eq(Array::get(log, 4), 300)
}

/// ADR-0089 Decision 2 (#1218): a Future cell is scheduler-visible data.
/// Task A awaits a PENDING future (parking as a poller through __aw_poll's
/// Suspend(1)); task B sleeps, then resolves the cell. Under the old
/// pump_all rule this trapped as a false deadlock: A (resumable poller)
/// kept the sleep-debt settle from ever firing, so B never woke to
/// resolve. The force-settle path (conc_force_settle_sleep_debt) advances
/// virtual time once the resumable pollers stop progressing. B sleeping
/// FIRST pins that A really parks and is completed by B's resolve, not by
/// eager settle order.
test "await on a pending future parks until a sleeping sibling resolves it" {
  let out = TaskGroup::run((g) -> {
    let f = Future::pending()
    let ha = TaskGroup::spawn_suspend(g, () -> Int with Async {
      await(f) + 2
    })
    let hb = TaskGroup::spawn_suspend(g, () -> Int with Async {
      sleep(5)
      Future::resolve(f, 40)
      1
    })
    TaskGroup::pump_all(g)
    let ra = TaskHandle::join(ha)
    let rb = TaskHandle::join(hb)
    ra + rb
  })
  assert_eq(out, 43)
}

/// Same scheduler hole, channel spelling: a consumer polling recv_wait on
/// a producer that sleeps between sends must not trap as deadlock -- the
/// forced settle wakes the producer.
test "recv_wait on a sleeping producer advances virtual time instead of trapping" {
  let out = TaskGroup::run((g) -> {
    {
      let (tx, rx) = Channel::bounded(g, 2)
      {
        let hc = TaskGroup::spawn_suspend(g, () -> Int with Async {
          // let-bound, not a match scrutinee: a suspending call is only
          // eligible on the let/seq/tail spine (ADR-0076 追記31).
          let got = Receiver::recv_wait(rx)
          match got {
            Some(v) => v + 2,
            None => -1
          }
        })
        let hp = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
          sleep(5)
          let _s = Sender::send_wait(tx, 40)
          Sender::release(tx)
          0
        })
        TaskGroup::pump_all(g)
        let rc = TaskHandle::join(hc)
        let rp = TaskHandle::join(hp)
        rc + rp
      }
    }
  })
  assert_eq(out, 42)
}

/// ADR-0089 Decision 2 (#1218): a task handle IS a future --
/// TaskHandle::result_wait is the suspendable-lane join. B parks on A's
/// completion; A finishes only after a sleep (exercising the forced
/// settle), and B resumes with A's value.
test "result_wait awaits a sibling task's result" {
  let out = TaskGroup::run((g) -> {
    let ha = TaskGroup::spawn_suspend(g, () -> Int with Async {
      sleep(5)
      40
    })
    let hb = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
      // let-bound, not a match scrutinee (spine eligibility, ADR-0076).
      let got = TaskHandle::result_wait(ha)
      got + 2
    })
    TaskGroup::pump_all(g)
    TaskHandle::join(hb)
  })
  assert_eq(out, 42)
}

/// result_wait on a CANCELLED sibling THROWS `Cancelled`: cancel resolves
/// the parked sibling immediately, and the awaiter's next resume observes
/// the terminal state. (A FAILED sibling is deliberately not pinned here --
/// fail-fast cancels the parked awaiter itself; the group result carries
/// the failure.)
///
/// #1324 moved this from `Err(Cancelled)` to a throw, which CHANGES what an
/// awaiter can do: a suspend-class closure literal cannot contain a
/// `handle`, so the awaiter can no longer branch on the outcome (the old
/// body returned 42 from an `Err(Cancelled)` arm). Cancellation now
/// propagates -- it fails the awaiting task, fail-fast fails the group, and
/// the catch has to sit around the `TaskGroup::run` call at the use site.
/// The `Cancelled` VARIANT still survives that trip (#1392 slice 3 renders
/// the payload at the throw site), which is what `Failed(Cancelled)` below
/// pins; before it, the erased runner arm could only report `<TaskError>`.
test "result_wait propagates a cancelled sibling to the awaiter" {
  let out = handle {
    let v = TaskGroup::run((g) -> {
      let ha = TaskGroup::spawn_suspend(g, () -> Int with Async {
        let _w = perform Async::Suspend(0)
        99
      })
      let hb = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
        // let-bound, not a match scrutinee (spine eligibility, ADR-0076).
        let got = TaskHandle::result_wait(ha)
        got + 1
      })
      TaskHandle::cancel(ha)
      TaskGroup::pump_all(g)
      TaskHandle::join(hb)
    })
    "no throw: \{v}"
  } with Exception[TaskError] {
    // Matched, not interpolated: `"\{err}"` on a PATTERN-BOUND binder is the
    // one interpolation shape #1392 left rendering as a pointer decimal.
    Throw(err) => match err {
      TaskError::Failed(m) => "Failed(\{m})",
      TaskError::Cancelled => "Cancelled"
    }
  }
  assert_eq(out, "Failed(Cancelled)")
}

/// Direct wake (ADR-0089 #1218): several awaiters parked on ONE sibling
/// all resume when it completes. Each awaiter registers on the target's
/// waiter list and is SKIPPED by the pump until the completion notify
/// clears its flag -- but the observable outcome is identical to the old
/// per-round re-poll.
test "direct wake resumes every result_wait awaiter of one sibling" {
  let out = TaskGroup::run((g) -> {
    let ha = TaskGroup::spawn_suspend(g, () -> Int with Async {
      let _w1 = perform Async::Suspend(0)
      let _w2 = perform Async::Suspend(0)
      40
    })
    let hb = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
      let got = TaskHandle::result_wait(ha)
      got + 1
    })
    let hc = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
      let got = TaskHandle::result_wait(ha)
      got + 2
    })
    let hd = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
      let got = TaskHandle::result_wait(ha)
      got + 3
    })
    TaskGroup::pump_all(g)
    let rb = TaskHandle::join(hb)
    let rc = TaskHandle::join(hc)
    let rd = TaskHandle::join(hd)
    rb + rc + rd
  })
  assert_eq(out, 126)
}

/// A manual TaskHandle::wake on a direct-parked awaiter is a legal
/// spurious wake: the resumed leg re-checks its condition, re-registers,
/// and the eventual completion notify still delivers the value. Pins the
/// wrapper's resume-time flag clearing (a stale direct_wait must never
/// survive into an unrelated later park).
test "manual wake of a direct-parked awaiter is a safe spurious poll" {
  let out = TaskGroup::run((g) -> {
    let ha = TaskGroup::spawn_suspend(g, () -> Int with Async {
      let _w1 = perform Async::Suspend(0)
      40
    })
    let hb = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
      let got = TaskHandle::result_wait(ha)
      // A cooperative yield AFTER the direct-parked wait: if the resume
      // left a stale direct_wait flag, this yield would be skipped by the
      // pump and strand the task behind the fallback valve. (Spine
      // discipline: calls let-bound, the value expression in tail position.)
      let _y = perform Async::Suspend(0)
      got + 2
    })
    // hb is now parked on ha (direct). Wake it manually: it must simply
    // re-check, re-park, and still complete once ha does.
    let woke = TaskHandle::wake(hb, 0)
    assert(woke)
    TaskGroup::pump_all(g)
    TaskHandle::join(hb)
  })
  assert_eq(out, 42)
}

/// A direct-parked consumer must not hold the virtual clock back: the
/// producer sleeps between sends, and the sleep debt settles immediately
/// (conc_settle_sleep_debt skips direct-parked waiters) instead of
/// needing the pump_all stall counter to force it.
test "direct-parked recv_wait does not block a sleeping producer's clock" {
  let out = TaskGroup::run((g) -> {
    {
      let ends = Channel::bounded(g, 1)
      {
        let (tx, rx) = ends
        let hp = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
          sleep(5)
          let _s1 = Sender::send_wait(tx, 21)
          sleep(5)
          let _s2 = Sender::send_wait(tx, 21)
          Sender::release(tx)
          0
        })
        let hc = TaskGroup::spawn_suspend(g, () -> Int with Async {
          // Spine discipline: needing calls let-bound, matches in tail.
          let a0 = Receiver::recv_wait(rx)
          let b0 = Receiver::recv_wait(rx)
          match a0 {
            Some(a) => match b0 {
              Some(b) => a + b,
              None => -20
            },
            None => -10
          }
        })
        TaskGroup::pump_all(g)
        let _p = TaskHandle::join(hp)
        TaskHandle::join(hc)
      }
    }
  })
  assert_eq(out, 42)
}

/// Direct wake for BUILTIN futures (ADR-0089 #1218): with the
/// @vibex/concurrent hooks linked, `await(f)` polls through __aw_wait
/// (registering the awaiter on the cell) and `Future::resolve` notifies —
/// all three awaiters park direct-wake and the single resolve makes them
/// resumable. Byte-for-byte the same observable results as the old
/// per-round re-poll.
test "resolve direct-wakes several awaiters of one pending future" {
  let out = TaskGroup::run((g) -> {
    let f = Future::pending()
    let ha = TaskGroup::spawn_suspend(g, () -> Int with Async {
      await(f) + 1
    })
    let hb = TaskGroup::spawn_suspend(g, () -> Int with Async {
      await(f) + 2
    })
    let hc = TaskGroup::spawn_suspend(g, () -> Int with Async {
      await(f) + 3
    })
    let hr = TaskGroup::spawn_suspend(g, () -> Int with Async {
      let _y1 = perform Async::Suspend(0)
      let _y2 = perform Async::Suspend(0)
      Future::resolve(f, 10)
      0
    })
    TaskGroup::pump_all(g)
    let ra = TaskHandle::join(ha)
    let rb = TaskHandle::join(hb)
    let rc = TaskHandle::join(hc)
    ra + rb + rc
  })
  assert_eq(out, 36)
}

//# CPS-split callee results (#1371)

/// A NEEDING function: its row carries Async, so the suspend lowering
/// compiles a CPS CLONE of it and the call site consumes the clone's steps
/// instead of calling it directly.
fn needing_value(x: Int) -> Int with Async {
  let _w = perform Async::Suspend(0)
  x + 111
}

/// Two suspension points and work on both sides of them, so the clone has
/// three steps and real state to carry across each one.
fn needing_two_steps(x: Int) -> Int with Async {
  let a = x + 1
  let _w1 = perform Async::Suspend(0)
  let _w2 = perform Async::Suspend(0)
  a + 100
}

/// #1371's headline shape: a `throw` on the FAR SIDE of a suspension point,
/// inside a needing fn rather than in the task body itself.
fn needing_throws(x: Int) -> Int with Async + Error {
  let _w = perform Async::Suspend(0)
  if x > 0 {
    throw("boom")
  } else {
    x
  }
}

/// #1371: a needing call in TAIL position of a spawn_suspend body splits to
/// the step PASSTHROUGH form -- the literal returns the CLONE's step and
/// builds none of its own. scps_literal_is_step_for did not recognize that
/// as already-split, so the arg-position fixup Done-wrapped it a second
/// time and the task settled with the step OBJECT (a heap pointer) as its
/// value. The task looked like it had SUCCEEDED, so nothing surfaced.
test "a needing callee in tail position returns its value" {
  let out = TaskGroup::run((g) -> {
    let h = TaskGroup::spawn_suspend(g, () -> Int with Async {
      needing_value(0)
    })
    TaskGroup::pump_all(g)
    TaskHandle::join(h)
  })
  assert_eq(out, 111)
}

/// The non-tail counterpart, which went through the bubble combinator and
/// was always correct. Kept beside the tail case so a future change that
/// breaks only one of the two spines is visibly asymmetric.
test "a needing callee in non-tail position returns its value" {
  let out = TaskGroup::run((g) -> {
    let h = TaskGroup::spawn_suspend(g, () -> Int with Async {
      let v = needing_value(0)
      v + 1000
    })
    TaskGroup::pump_all(g)
    TaskHandle::join(h)
  })
  assert_eq(out, 1111)
}

/// Same tail shape across TWO suspensions: the double-split defect made the
/// continuation unreachable, so this leg never ran past the first one.
test "a two-step needing callee in tail position runs to completion" {
  let out = TaskGroup::run((g) -> {
    let h = TaskGroup::spawn_suspend(g, () -> Int with Async {
      needing_two_steps(0)
    })
    TaskGroup::pump_all(g)
    TaskHandle::join(h)
  })
  assert_eq(out, 101)
}

/// #1371 as reported: because the continuation was never resumed, a `throw`
/// past the first suspension in a CPS-split callee never executed at all --
/// the task settled "successfully" with a garbage value instead of failing.
/// The payload is a String on purpose: an enum payload would also exercise
/// the erased-handler kind confusion (#1374), which is a separate defect.
test "a throw past the first suspension in a needing callee fails the task" {
  let out = handle {
    TaskGroup::run((g) -> {
      let h = TaskGroup::spawn_suspend(g, () -> Int with Async + Error {
        needing_throws(1)
      })
      TaskGroup::pump_all(g)
      TaskHandle::join(h)
    })
  } with Exception[TaskError] {
    Throw(err) => match err {
      TaskError::Failed(m) => if m == "boom" {
        1
      } else {
        0 - 1
      },
      _ => 0 - 2
    }
  }
  assert_eq(out, 1)
}
