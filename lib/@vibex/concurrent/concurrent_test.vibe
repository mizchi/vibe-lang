//# Imports

import ./concurrent.vibe {
  type Channel,
  type ChannelConfigError,
  type Parallel,
  type Receiver,
  type SendError,
  type Sender,
  type TaskError,
  type TaskGroup,
  type TaskHandle,
  Channel::bounded,
  Parallel::map,
  Receiver::recv,
  Sender::clone,
  Sender::release,
  Sender::send,
  TaskGroup::run,
  TaskGroup::spawn,
  TaskHandle::cancel,
  TaskHandle::join
}

//# Lifecycle conformance locks (docs/concurrency.md)

/// The eager prototype ran the thunk inside spawn; the ADR-0068 scheduler
/// must not. That absence-of-eager-execution property is now pinned by
/// "cancel before dispatch resolves Cancelled without running the body"
/// below (cancelling instead of joining resolves the task WITHOUT ever
/// running its closure -- an eagerly-run closure could not be cancelled
/// away) -- #1081 step 3 Phase B's `Spawnable[r]` capture check rejects the
/// outer-Array capture this test used to observe "not yet run" directly, so
/// this test now just locks the join-driven return value.
test "spawn is deferred: child does not run before join" {
  let r = TaskGroup::run((n) -> {
    let t = TaskGroup::spawn(n, () -> {
      42
    })
    TaskHandle::join(t)
  })
  match r {
    Ok(joined) => assert(joined is Ok(42)),
    Err(_) => assert(false)
  }
}

test "join is idempotent: repeated joins observe the same outcome" {
  let r = TaskGroup::run((n) -> {
    let t = TaskGroup::spawn(n, () -> {
      7
    })
    let a = TaskHandle::join(t)
    let b = TaskHandle::join(t)
    (a, b)
  })
  match r {
    Ok((a, b)) => {
      assert(a is Ok(7))
      assert(b is Ok(7))
    },
    Err(_) => assert(false)
  }
}

/// #1081 step 3 Phase B: a plain outer ArrayBuilder can no longer be
/// captured into a spawn closure to log interleaving order (not Send). A
/// same-region Sender IS Spawnable-legal (docs/concurrency.md), so each
/// task reports its own tag through a cloned Sender instead; the channel's
/// per-sender FIFO ordering pins the exact same dispatch-order guarantee.
test "dispatch order is deterministic FIFO in spawn order" {
  let r = TaskGroup::run((n) -> {
    match Channel::bounded(n, 3) {
      Err(_) => [
      ],
      Ok((s, rx)) => {
        let s1 = Sender::clone(s)
        let s2 = Sender::clone(s)
        let t1 = TaskGroup::spawn(n, () -> {
          let _ = Sender::send(s1, 1); Sender::release(s1); 0
        })
        let t2 = TaskGroup::spawn(n, () -> {
          let _ = Sender::send(s2, 2); Sender::release(s2); 0
        })
        let t3 = TaskGroup::spawn(n, () -> {
          let _ = Sender::send(s, 3); Sender::release(s); 0
        })
        // Joining the LAST task drives the queue; earlier spawns run first.
        let _ = TaskHandle::join(t3)
        let _ = TaskHandle::join(t1)
        let _ = TaskHandle::join(t2)
        let log = ArrayBuilder::new()
        let mut going = true
        while going {
          match Receiver::recv(rx) {
            Some(v) => ArrayBuilder::push(log, v),
            None => {
              going = false
            }
          }
        }
        ArrayBuilder::freeze(log)
      }
    }
  })
  match r {
    Ok(order) => {
      assert_eq(Array::length(order), 3)
      assert_eq(Array::get(order, 0), 1)
      assert_eq(Array::get(order, 1), 2)
      assert_eq(Array::get(order, 2), 3)
    },
    Err(_) => assert(false)
  }
}

/// #1081 step 3 Phase B note: this used to observe the never-joined child's
/// side effect through an outer captured Array AFTER `run` returned, which
/// specifically proved the CLOSE-time drain (not the body) dispatched it.
/// The `Spawnable[r]` capture check now rejects that Array capture, and any
/// Spawnable-legal replacement (join/channel-recv on the same handle from
/// inside the body) would itself force dispatch, no longer isolating
/// "close drove it" from "the body drove it" -- same class of gap as the
/// region-escape note above. What remains checkable, and is checked here,
/// is that the group still closes Ok with a spawned-but-never-joined live
/// child (does not hang or trap).
test "task-group close joins children the body never joined" {
  let r = TaskGroup::run((n) -> {
    let _t = TaskGroup::spawn(n, () -> {
      1
    })
    // body returns without joining; normal close must run the child
    99
  })
  assert(r is Ok(99))
}

test "cancel before dispatch resolves Cancelled without running the body" {
  let r = TaskGroup::run((n) -> {
    let t = TaskGroup::spawn(n, () -> {
      1
    })
    TaskHandle::cancel(t)
    // cancel is idempotent
    TaskHandle::cancel(t)
    let out = TaskHandle::join(t)
    assert(out is Err(TaskError::Cancelled))
    // repeated join observes the same terminal outcome
    assert(TaskHandle::join(t) is Err(TaskError::Cancelled))
    0
  })
  assert(r is Ok(0))
}

test "cancel after terminal is a no-op" {
  let r = TaskGroup::run((n) -> {
    let t = TaskGroup::spawn(n, () -> {
      5
    })
    let first = TaskHandle::join(t)
    TaskHandle::cancel(t)
    let second = TaskHandle::join(t)
    (first, second)
  })
  match r {
    Ok((first, second)) => {
      assert(first is Ok(5))
      assert(second is Ok(5))
    },
    Err(_) => assert(false)
  }
}

test "explicitly cancelled child does not fail the task group" {
  let r = TaskGroup::run((n) -> {
    let t = TaskGroup::spawn(n, () -> {
      1
    })
    TaskHandle::cancel(t)
    123
  })
  assert(r is Ok(123))
}

//# Failure conformance locks

test "unhandled child throw becomes Failed(msg) and fails the task group" {
  let r: Result[Int, TaskError] = TaskGroup::run((n) -> {
    let t = TaskGroup::spawn(n, () -> {
      throw("boom")
      0
    })
    let out = TaskHandle::join(t)
    match out {
      Err(TaskError::Failed(msg)) => assert_eq(msg, "boom"),
      _ => assert(false)
    }
    7
  })
  // The group result reports the first observed failure even though
  // the body itself completed normally.
  match r {
    Err(TaskError::Failed(msg)) => assert_eq(msg, "boom"),
    _ => assert(false)
  }
}

/// #1081 step 3 Phase B: the good sibling's outer-Array "did it run" check
/// is no longer Spawnable-legal. Joining `good` directly instead is BOTH
/// legal and more precise: it forces the same FIFO dispatch (`_bad` is
/// earlier in spawn order and runs first, setting `n.failing`) and then
/// observes the fail-fast cancellation on `good` itself via the type-safe
/// join result, rather than an out-of-band side effect.
test "fail-fast: sibling still Ready when a child fails is cancelled" {
  let r: Result[Int, TaskError] = TaskGroup::run((n) -> {
    let _bad = TaskGroup::spawn(n, () -> {
      throw("first-failure")
      0
    })
    let good = TaskGroup::spawn(n, () -> {
      1
    })
    assert(TaskHandle::join(good) is Err(TaskError::Cancelled))
    0
  })
  match r {
    Err(TaskError::Failed(msg)) => assert_eq(msg, "first-failure"),
    _ => assert(false)
  }
}

test "child Err value is a recoverable result, not a task failure" {
  let r = TaskGroup::run((n) -> {
    let t = TaskGroup::spawn(n, () -> {
      let out: Result[Int, String] = Err("recoverable")
      out
    })
    TaskHandle::join(t)
  })
  match r {
    Ok(joined) => match joined {
      Ok(inner) => assert(inner is Err("recoverable")),
      Err(_) => assert(false)
    },
    Err(_) => assert(false)
  }
}

//# Channel conformance locks

test "negative capacity is a configuration error" {
  let r = TaskGroup::run((n) -> {
    let ch = Channel::bounded(n, -1)
    assert(ch is Err(ChannelConfigError::NegativeCapacity))
    0
  })
  assert(r is Ok(0))
}

test "bounded buffer preserves per-sender FIFO order" {
  let r = TaskGroup::run((n) -> {
    match Channel::bounded(n, 2) {
      Err(_) => -1,
      Ok((s, rx)) => {
        assert(Sender::send(s, 10) is Ok(_))
        assert(Sender::send(s, 20) is Ok(_))
        assert(Receiver::recv(rx) is Some(10))
        assert(Receiver::recv(rx) is Some(20))
        Sender::release(s)
        0
      }
    }
  })
  assert(r is Ok(0))
}

test "close on last sender release: drain buffered messages then None" {
  let r = TaskGroup::run((n) -> {
    match Channel::bounded(n, 4) {
      Err(_) => -1,
      Ok((s, rx)) => {
        let _ = Sender::send(s, 1)
        let _ = Sender::send(s, 2)
        Sender::release(s)
        assert(Receiver::recv(rx) is Some(1))
        assert(Receiver::recv(rx) is Some(2))
        assert(Receiver::recv(rx) is None)
        // recv after drained-close stays None (stable)
        assert(Receiver::recv(rx) is None)
        0
      }
    }
  })
  assert(r is Ok(0))
}

test "send to a closed channel is Err(Closed)" {
  let r = TaskGroup::run((n) -> {
    match Channel::bounded(n, 1) {
      Err(_) => -1,
      Ok((s, _rx)) => {
        let extra = Sender::clone(s)
        Sender::release(s)
        // one live sender (the clone) remains: still open
        assert(Sender::send(extra, 5) is Ok(_))
        Sender::release(extra)
        // last release closed the channel
        assert(Sender::send(extra, 6) is Err(SendError::Closed))
        0
      }
    }
  })
  assert(r is Ok(0))
}

test "clone keeps the channel open until every sender is released" {
  let r = TaskGroup::run((n) -> {
    match Channel::bounded(n, 4) {
      Err(_) => -1,
      Ok((s1, rx)) => {
        let s2 = Sender::clone(s1)
        let _ = Sender::send(s1, 1)
        let _ = Sender::send(s2, 2)
        Sender::release(s1)
        // s2 still live: not closed, buffered messages intact
        assert(Receiver::recv(rx) is Some(1))
        let _ = Sender::send(s2, 3)
        Sender::release(s2)
        assert(Receiver::recv(rx) is Some(2))
        assert(Receiver::recv(rx) is Some(3))
        assert(Receiver::recv(rx) is None)
        0
      }
    }
  })
  assert(r is Ok(0))
}

test "recv blocks by driving a spawned producer (buffer path)" {
  let r = TaskGroup::run((n) -> {
    match Channel::bounded(n, 1) {
      Err(_) => -1,
      Ok((s, rx)) => {
        let _p = TaskGroup::spawn(n, () -> {
          let _ = Sender::send(s, 77)
          Sender::release(s)
          0
        })
        // Nothing is buffered yet: recv must dispatch the producer.
        let got = Receiver::recv(rx)
        assert(got is Some(77))
        assert(Receiver::recv(rx) is None)
        0
      }
    }
  })
  assert(r is Ok(0))
}

test "rendezvous (capacity 0): recv drives the producer and pairs up" {
  let r = TaskGroup::run((n) -> {
    match Channel::bounded(n, 0) {
      Err(_) => -1,
      Ok((s, rx)) => {
        let _p = TaskGroup::spawn(n, () -> {
          let a = Sender::send(s, 1)
          let b = Sender::send(s, 2)
          Sender::release(s)
          assert(a is Ok(_))
          assert(b is Ok(_))
          0
        })
        assert(Receiver::recv(rx) is Some(1))
        assert(Receiver::recv(rx) is Some(2))
        assert(Receiver::recv(rx) is None)
        0
      }
    }
  })
  assert(r is Ok(0))
}

/// #1081 step 3 Phase B: the consumer used to write its received value into
/// a captured outer Array (not Spawnable-legal); it returns the value
/// instead, observed through the type-safe `TaskHandle::join` result. Send
/// already drives the consumer to completion (rendezvous, capacity 0), so
/// the join below reads an already-terminal cell -- same timing as before.
test "rendezvous (capacity 0): sender blocks until a consumer task runs" {
  let r = TaskGroup::run((n) -> {
    match Channel::bounded(n, 0) {
      Err(_) => -1,
      Ok((s, rx)) => {
        let consumer = TaskGroup::spawn(n, () -> {
          match Receiver::recv(rx) {
            Some(v) => v,
            None => 0 - 1
          }
        })
        // The body is the sender: send must drive the consumer task and
        // only return Ok once the message is consumed.
        let sent = Sender::send(s, 42)
        assert(sent is Ok(_))
        assert(TaskHandle::join(consumer) is Ok(42))
        Sender::release(s)
        0
      }
    }
  })
  assert(r is Ok(0))
}

/// #1081 step 3 Phase B: same replacement as the rendezvous test above --
/// the consumer returns its drained value instead of writing an outer
/// captured Array.
test "full buffer send blocks and is promoted when a consumer drains" {
  let r = TaskGroup::run((n) -> {
    match Channel::bounded(n, 1) {
      Err(_) => -1,
      Ok((s, rx)) => {
        let _ = Sender::send(s, 1)
        let consumer = TaskGroup::spawn(n, () -> {
          match Receiver::recv(rx) {
            Some(v) => v,
            None => 0 - 1
          }
        })
        // Buffer is full: this send must drive the consumer, get its
        // message promoted into the freed slot, then return Ok.
        let sent = Sender::send(s, 2)
        assert(sent is Ok(_))
        assert(TaskHandle::join(consumer) is Ok(1))
        assert(Receiver::recv(rx) is Some(2))
        Sender::release(s)
        0
      }
    }
  })
  assert(r is Ok(0))
}

// "task-group close closes remaining endpoints" used to leak a Receiver
// into an outer `let mut` array to observe post-close draining from
// outside the nursery. #1081 step 3's region escape check rejects the
// return-position form of this (fixtures/err_region_escape_return.vibe),
// but NOT this exact outer-`let mut`-array form: this checker generalizes
// `let`/`let mut` bindings (confirmed: two `Array::set` calls with
// mismatched element types on the same `let mut arr = [...]` both type-
// check clean), so every reference to `leaked` inside the nursery body
// gets its own fresh, disconnected instantiation of the element type --
// there is no single accumulated type for the escape check to inspect via
// the checking env. This is a known, documented gap (see docs/
// concurrency.md's #1081 step 3 実装ノート), not a false claim of
// soundness this test would otherwise make. The runtime's close-on-drop
// behavior (`chan_closed` checking `c.group.phase >= 2`) is unchanged
// regardless and is exercised structurally by every other channel test in
// this file that lets a task group close with live endpoints.

//# Composition

test "pipeline: body consumes a spawned producer past capacity" {
  // The body is the receiver, so the producer's overflow sends resolve
  // as deposits for the committed receiver (rendezvous linearization) —
  // strict suspension-based backpressure interleaving needs the ADR-0076
  // suspend IR (see module header).
  let r = TaskGroup::run((n) -> {
    match Channel::bounded(n, 2) {
      Err(_) => Err(Cancelled),
      Ok((s, rx)) => {
        let _producer = TaskGroup::spawn(n, () -> {
          let mut i = 1
          while i <= 5 {
            let _ = Sender::send(s, i * 10)
            i = i + 1
          }
          Sender::release(s)
          0
        })
        let mut sum = 0
        let mut going = true
        while going {
          match Receiver::recv(rx) {
            Some(v) => {
              sum = sum + v
            },
            None => {
              going = false
            }
          }
        }
        Ok(sum)
      }
    }
  })
  match r {
    Ok(joined) => assert(joined is Ok(150)),
    Err(_) => assert(false)
  }
}

test "Parallel::map returns results in input index order" {
  let r = TaskGroup::run((n) -> {
    Parallel::map(n, [
      1,
      2,
      3,
      4,
      5
    ], (x) -> {
      x * x
    })
  })
  match r {
    Ok(mapped) => match mapped {
      Ok(sq) => {
        assert_eq(Array::length(sq), 5)
        assert_eq(Array::get(sq, 0), 1)
        assert_eq(Array::get(sq, 1), 4)
        assert_eq(Array::get(sq, 2), 9)
        assert_eq(Array::get(sq, 3), 16)
        assert_eq(Array::get(sq, 4), 25)
      },
      Err(_) => assert(false)
    },
    Err(_) => assert(false)
  }
}

test "Parallel::map surfaces the first failure" {
  let r: Result[Result[Array[Int], TaskError], TaskError] = TaskGroup::run((n) -> {
    Parallel::map(n, [
      1,
      2,
      3
    ], (x) -> {
      if x == 2 {
        throw("map-boom")
      }
      x
    })
  })
  // Inner: the map observed the failure. Outer: the task group reports the
  // same first failure at close.
  match r {
    Err(TaskError::Failed(msg)) => assert_eq(msg, "map-boom"),
    _ => assert(false)
  }
}

test "Parallel::map on an empty input is Ok([])" {
  let r = TaskGroup::run((n) -> {
    let empty: Array[Int] = [
    ]
    Parallel::map(n, empty, (x) -> {
      x
    })
  })
  match r {
    Ok(mapped) => match mapped {
      Ok(out) => assert_eq(Array::length(out), 0),
      Err(_) => assert(false)
    },
    Err(_) => assert(false)
  }
}

test "pipeline: spawned producer and consumer within capacity" {
  let r = TaskGroup::run((n) -> {
    match Channel::bounded(n, 8) {
      Err(_) => Err(Cancelled),
      Ok((s, rx)) => {
        let _producer = TaskGroup::spawn(n, () -> {
          let mut i = 1
          while i <= 5 {
            let _ = Sender::send(s, i * 10)
            i = i + 1
          }
          Sender::release(s)
          0
        })
        let consumer = TaskGroup::spawn(n, () -> {
          let mut sum = 0
          let mut going = true
          while going {
            match Receiver::recv(rx) {
              Some(v) => {
                sum = sum + v
              },
              None => {
                going = false
              }
            }
          }
          sum
        })
        TaskHandle::join(consumer)
      }
    }
  })
  match r {
    Ok(joined) => assert(joined is Ok(150)),
    Err(_) => assert(false)
  }
}

// #1181: TaskGroup::spawn's closure row used to be fixed to { Error },
// blocking any spawned task from touching the filesystem or shelling out
// to a subprocess. Locks the fix: a spawned closure performing both Fs
// and Process alongside Error. (Uses sh_lines, not sh, to capture the
// subprocess's output -- sh() itself does not capture stdout into its
// return value, a separate pre-existing bug unrelated to this fix.)
test "spawned task may perform Fs and Process alongside Error" {
  let path = "/tmp/vibe_concurrent_test_spawn_fs_process.txt"
  let r = TaskGroup::run((n) -> {
    let t = TaskGroup::spawn(n, () -> {
      Fs::write_file(path, "hello from a spawned task")
      let sh_lines_out = sh_lines("echo from-subprocess")
      let file_contents = Fs::read_file(path)
      "\{Array::get(sh_lines_out, 0)}|\{file_contents}"
    })
    TaskHandle::join(t)
  })
  match r {
    Ok(joined) => assert(joined is Ok("from-subprocess|hello from a spawned task")),
    Err(_) => assert(false)
  }
}
