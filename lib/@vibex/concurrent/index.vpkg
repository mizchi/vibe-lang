version 0.0.1

// @vibex/concurrent — ADR-0068 shared-nothing structured concurrency,
// cooperative run-to-completion slice (docs/concurrency.md, ADR-0065
// 実験 scope)。deferred spawn + FIFO deterministic scheduler。blocking
// 操作 (join / send / recv / task-group close) が ready queue を呼び出し
// スタック上で駆動する (thread-of-control borrowing)。継続 (ADR-0076
// Phase 3 suspend IR) が入ったら内部を差し替え、surface は維持する。
//
// 未実装 (ADR-0068 実装順で後続): region generativity / escape check、
// `Send` / `Spawnable` capture check、blocking API の Async::suspend row、
// mid-run cancel 観測、message deep-copy (単一 heap — immutable 値を送る
// こと)、Task::yield。task handle の綴りは builtin `Task::*` (退役予定の
// eager prototype) との衝突回避で `TaskHandle`。

type TaskGroup
type TaskHandle[T]
type TaskError
type SendError
type ChannelConfigError
type Channel[T]
type Sender[T]
type Receiver[T]

// internal representation types (exported for same-package tests only;
// opaque with type params is not yet supported, #729)
opaque type TaskCell
type ResCell[T]
type Ring[T]

fn TaskGroup::run[T](body: (TaskGroup) -> T with { e }) -> Result[T, TaskError] with { e }
fn TaskGroup::spawn[T: Send](n: TaskGroup, f: () -> T with { Error }) -> TaskHandle[T]
fn TaskHandle::join[T](h: TaskHandle[T]) -> Result[T, TaskError]
fn TaskHandle::cancel[T](h: TaskHandle[T]) -> Unit
fn Channel::bounded[T: Send](n: TaskGroup, capacity: Int) -> Result[(Sender[T], Receiver[T]), ChannelConfigError]
fn Sender::send[T](s: Sender[T], v: T) -> Result[Unit, SendError]
fn Sender::clone[T](s: Sender[T]) -> Sender[T]
fn Sender::release[T](s: Sender[T]) -> Unit
fn Receiver::recv[T](r: Receiver[T]) -> Option[T]

// combinators (index-ordered results; completion order not observable)
type Parallel
fn Parallel::map[T: Send, U: Send](n: TaskGroup, xs: Array[T], f: (T) -> U with { Error }) -> Result[Array[U], TaskError]

// --- suspendable tasks (ADR-0068 実装ノート 3c; ADR-0076 Phase 3a/3b の
// first-class resume が前提)。task body は adoption site の
// `handle ... with Async` の中で走り、arm が `resume` を
// TaskHandle::park で継続 slot へ保存する。pump/wake が保存された継続を
// 次の suspend まで走らせる。透明 effect 宣言 (#752): 定義そのものが契約。
effect Async {
  Suspend(Int) -> Int
}

type TaskStep[T]

fn TaskGroup::adopt[T: Send](n: TaskGroup) -> TaskHandle[T]
fn TaskGroup::pump(n: TaskGroup) -> Bool
fn TaskGroup::pump_all(n: TaskGroup) -> Unit
fn TaskHandle::settle[T](h: TaskHandle[T], step: TaskStep[T]) -> Unit
fn TaskHandle::park[T](h: TaskHandle[T], k: (Int) -> TaskStep[T]) -> Unit
fn TaskHandle::wake[T](h: TaskHandle[T], v: Int) -> Bool
