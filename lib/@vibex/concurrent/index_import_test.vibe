//# Imports

import .{
  type TaskError, TaskGroup::run, TaskGroup::spawn, TaskHandle::join
}

//# Misc

test "x/concurrent index exports the task group API" {
  let r = TaskGroup::run((n) -> {
    let t = TaskGroup::spawn(n, () -> {
      21 * 2
    })
    TaskHandle::join(t)
  })
  match r {
    Ok(joined) => assert(joined is Ok(42)),
    Err(_) => assert(false)
  }
}
