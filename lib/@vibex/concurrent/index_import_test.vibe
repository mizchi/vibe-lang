//# Imports

import . {
  type TaskError, Nursery::run, Nursery::spawn, TaskHandle::join
}

//# Misc

test "x/concurrent index exports the nursery API" {
  let r = Nursery::run((n) -> {
    let t = Nursery::spawn(n, () -> { 21 * 2 })
    TaskHandle::join(t)
  })
  match r {
    Ok(joined) => assert(joined is Ok(42)),
    Err(_) => assert(false)
  }
}
