version 0.0.1

// @vibex/effect_demo — effect 宣言そのものが契約になる、という #752 パターンの
// 実証実験 (ADR-0065 実験 scope)。汎用のコレクション操作ライブラリではない。
// Predicate / Transform は透明 effect 宣言: 定義そのものが契約 (#752)。

effect Predicate {
  Test(Int) -> Bool
}

effect Transform {
  Apply(Int) -> Int
}

fn empty_array[T]() -> Array[T]
fn map_effect(arr: Array[Int]) -> Array[Int] with { Transform }
fn filter_effect(arr: Array[Int]) -> Array[Int] with { Predicate }

