//# Imports

import .{
  Deque::length, Deque::new, Deque::pop_back, Deque::pop_front, Deque::push_back, Deque::push_front
}

//# Misc

test "x/deque index exports the Deque API" {
  let d = Deque::new()
  Deque::push_back(d, 2)
  Deque::push_front(d, 1)
  Deque::push_back(d, 3)
  assert(Deque::length(d) == 3)
  assert(Deque::pop_front(d) == Some(1))
  assert(Deque::pop_back(d) == Some(3))
  assert(Deque::pop_front(d) == Some(2))
  assert(Deque::pop_front(d) is None)
}
