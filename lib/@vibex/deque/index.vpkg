version 0.0.1

// @vibex/deque — 両端キュー (growable ring buffer, issue #841 B 群,
// ADR-0065 実験 scope)。head/len + 2 倍成長の ring buffer で両端 O(1)。
// Deque は bodyless type 宣言 (#739 の透過 re-export — 定義は impl 側)。
// Deque::* は名前空間 fn 宣言 (#752)。
//
// generic 割り当ての都合 (任意の T の default 値は作れない) で backing
// buffer は最初の push まで空 — `with_capacity(n)` の n は初回 push が
// 消費する容量ヒント。pop 済み slot は上書きされるまで旧要素を保持する。

type Deque[T]

fn Deque::new[T]() -> Deque[T]
fn Deque::with_capacity[T](n: Int) -> Deque[T]
fn Deque::push_back[T](d: Deque[T], x: T) -> Unit
fn Deque::push_front[T](d: Deque[T], x: T) -> Unit
fn Deque::pop_back[T](d: Deque[T]) -> Option[T]
fn Deque::pop_front[T](d: Deque[T]) -> Option[T]
fn Deque::front[T](d: Deque[T]) -> Option[T]
fn Deque::back[T](d: Deque[T]) -> Option[T]
fn Deque::get[T](d: Deque[T], i: Int) -> Option[T]
fn Deque::length[T](d: Deque[T]) -> Int
fn Deque::is_empty[T](d: Deque[T]) -> Bool
fn Deque::to_array[T](d: Deque[T]) -> Array[T]
fn Deque::clear[T](d: Deque[T]) -> Unit

