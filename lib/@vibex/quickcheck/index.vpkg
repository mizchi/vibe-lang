name = @vibex/quickcheck
version = 0.0.1
description =
  #|@vibex/quickcheck — property テスト (seed 引き回し RNG + Random effect)
deps = {}

generated_hash =

// @vibex/quickcheck — property テスト (seed 引き回し RNG + Random effect)
// (ADR-0065 実験 scope)。Random は透明 effect 宣言 (#752)。

effect Random {
  NextInt(Int, Int) -> Int;
  NextBool -> Bool
}

type Rng
type QcResult

fn rng_new(_ seed: Int) -> Rng
fn rng_next(_ rng: Rng) -> (Int, Rng)
fn gen_bool(_ rng: Rng) -> (Bool, Rng)
fn gen_int(_ rng: Rng) -> (Int, Rng)
fn gen_int_range(rng: Rng, lo: Int, hi: Int) -> (Int, Rng)
fn gen_nat(_ rng: Rng) -> (Int, Rng)
fn gen_int_array(rng: Rng, max_len: Int) -> (Array[Int], Rng)
fn gen_string(rng: Rng, max_len: Int) -> (String, Rng)
fn check_bool(name: String, seed: Int, count: Int, prop: (Bool) -> Bool) -> QcResult
fn check_int(name: String, seed: Int, count: Int, prop: (Int) -> Bool) -> QcResult
fn check_int2(name: String, seed: Int, count: Int, prop: (Int, Int) -> Bool) -> QcResult
fn check_int_array(name: String, seed: Int, count: Int, max_len: Int, prop: (Array[Int]) -> Bool) -> QcResult
fn check_nat(name: String, seed: Int, count: Int, prop: (Int) -> Bool) -> QcResult
fn check_string(name: String, seed: Int, count: Int, max_len: Int, prop: (String) -> Bool) -> QcResult
fn check_prop(count: Int, prop: () -> Bool with Random) -> Bool with Random
fn is_ok(_ result: QcResult) -> Bool
fn fail_msg(_ result: QcResult) -> String
fn show_bool(_ b: Bool) -> String
fn show_int(_ n: Int) -> String
fn show_int_array(_ arr: Array[Int]) -> String

