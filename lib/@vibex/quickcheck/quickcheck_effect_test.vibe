//# Imports

import .{
  Random
}

//# Misc

test "always true" {
  let result = handle {
    let v = perform Random::NextBool
    v
  } with { Random::NextBool => resume(true); Random::NextInt(_lo, _hi) => resume(0) }
  assert(result == true)
}

test "int range" {
  let result = handle {
    let a = perform Random::NextInt(1, 10)
    let b = perform Random::NextInt(1, 10)
    a + b
  } with { Random::NextBool => resume(false); Random::NextInt(_lo, _hi) => resume(5) }
  assert(result == 10)
}

test "deterministic sequence" {
  // All NextBool → false, so property (b) -> !b succeeds
  let ok = handle {
    let v1 = perform Random::NextBool
    let v2 = perform Random::NextBool
    not(v1) && not(v2)
  } with { Random::NextBool => resume(false); Random::NextInt(_lo, _hi) => resume(0) }
  assert(ok == true)
}
