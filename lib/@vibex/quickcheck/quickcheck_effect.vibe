//# Types

// The Random effect DEFINITION lives in the package contract (index.vibei)
// as a transparent declaration (#752) — this file only uses it.

//# Functions

/// check_prop: (Int, () -> Bool with Random) -> Bool with Random
export fn check_prop(count: Int, prop: () -> Bool with Random) -> Bool with Random {
  let mut i = 0
  let mut ok = true
  while i < count {
    if not(prop()) {
      ok = false
    }
    i = i + 1
  }
  ok
}
