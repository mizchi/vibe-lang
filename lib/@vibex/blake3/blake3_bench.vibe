//# Imports

import ./blake3.vibe {
  blake3
}

//# Helpers

/// Input construction happens INSIDE each bench block (top-level lets stay
/// literal-only in bench files), so the "baseline" cases below measure the
/// construction cost alone — subtract it to isolate pure hashing cost.
/// @vibe/core/sha1_bench.vibe carries the same 1KiB/8KiB + baseline cases
/// for a like-for-like sha1 vs blake3 comparison.
fn make_a(n: Int) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    StringBuilder::push(sb, "a")
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

//# Misc

bench "blake3 empty" {
  let _ = blake3("")
}

bench "blake3 short" {
  let _ = blake3("Hello, BLAKE3!")
}

bench "blake3 medium" {
  let _ = blake3("abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789")
}

bench "blake3 1KiB" {
  let _ = blake3(make_a(1024))
}

bench "blake3 8KiB" {
  let _ = blake3(make_a(8192))
}

bench "baseline make_a 1KiB" {
  let _ = make_a(1024)
}

bench "baseline make_a 8KiB" {
  let _ = make_a(8192)
}
