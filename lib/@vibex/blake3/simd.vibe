//# Driver — Bytes-based chunk/tree (mirrors ../blake3.vibe's scalar shape)

fn make_iv32() -> Bytes {
  let b = Bytes::new()
  push_word_le(b, 0x6A09E667)
  push_word_le(b, 0xBB67AE85)
  push_word_le(b, 0x3C6EF372)
  push_word_le(b, 0xA54FF53A)
  push_word_le(b, 0x510E527F)
  push_word_le(b, 0x9B05688C)
  push_word_le(b, 0x1F83D9AB)
  push_word_le(b, 0x5BE0CD19)
  b
}

fn push_word_le(b: Bytes, w: Int) -> Unit {
  Bytes::push(b, w&255)
  Bytes::push(b, (w>>8)&255)
  Bytes::push(b, (w>>16)&255)
  Bytes::push(b, (w>>24)&255)
}

/// io buffer for one deferred compression: cv (32 bytes) + zero tail.
fn new_io_with_cv(cv: Bytes) -> Bytes {
  let io = Bytes::new()
  Bytes::blit(io, cv, 0, 32)
  Bytes::fill(io, 0, 32)
  io
}

/// Deferred final compression, cv/block held as raw little-endian Bytes.
struct SimdOutput {
  cv: Bytes;
  block: Bytes;
  counter: Int;
  blen: Int;
  flags: Int
}

fn chunk_output_s(data: Bytes, start: Int, len: Int, counter: Int) -> SimdOutput {
  let num_blocks = if len == 0 {
    1
  } else {
    (len + 63) / 64
  }
  let io = new_io_with_cv(make_iv32())
  let mut b = 0
  while b < num_blocks - 1 {
    let flags = if b == 0 {
      s_flag_chunk_start
    } else {
      0
    }
    let _ = b3_compress_kernel(io, data, start + b * 64, counter, 64, flags)
    b = b + 1
  }
  let cv = Bytes::new()
  Bytes::blit(cv, io, 0, 32)
  let last_start = start + (num_blocks - 1) * 64
  let last_len = len - (num_blocks - 1) * 64
  let block = Bytes::new()
  // Bytes::blit takes (dst, src, src_start, src_END) -- a slice, not a count.
  Bytes::blit(block, data, last_start, last_start + last_len)
  Bytes::fill(block, 0, 64 - last_len)
  let start_flag = if num_blocks == 1 {
    s_flag_chunk_start
  } else {
    0
  }
  SimdOutput::{
    cv: cv, block: block, counter: counter, blen: last_len, flags: start_flag|s_flag_chunk_end
  }
}

fn chaining_value_s(o: SimdOutput) -> Bytes {
  let io = new_io_with_cv(o.cv)
  let _ = b3_compress_kernel(io, o.block, 0, o.counter, o.blen, o.flags)
  let cv = Bytes::new()
  Bytes::blit(cv, io, 0, 32)
  cv
}

fn parent_output_s(left_cv: Bytes, right_cv: Bytes) -> SimdOutput {
  let block = Bytes::new()
  Bytes::blit(block, left_cv, 0, 32)
  Bytes::blit(block, right_cv, 0, 32)
  SimdOutput::{
    cv: make_iv32(), block: block, counter: 0, blen: 64, flags: s_flag_parent
  }
}

/// Same spec tree shape as the scalar implementation: the left subtree takes
/// the largest power-of-two number of chunks strictly below the total.
fn subtree_output_s(data: Bytes, start: Int, len: Int, chunk_counter: Int) -> SimdOutput {
  if len <= s_chunk_len {
    chunk_output_s(data, start, len, chunk_counter)
  } else {
    let full_chunks = (len - 1) / s_chunk_len
    let mut left_chunks = 1
    while left_chunks * 2 <= full_chunks {
      left_chunks = left_chunks * 2
    }
    let left_len = left_chunks * s_chunk_len
    let left_cv = chaining_value_s(subtree_output_s(data, start, left_len, chunk_counter))
    let right_cv = chaining_value_s(subtree_output_s(data, start + left_len, len - left_len, chunk_counter + left_chunks))
    parent_output_s(left_cv, right_cv)
  }
}

fn s_hex_digit(d: Int) -> Int {
  if d < 10 {
    48 + d
  } else {
    87 + d
  }
}

fn root_hex_s(o: SimdOutput) -> String {
  let io = new_io_with_cv(o.cv)
  let _ = b3_compress_kernel(io, o.block, 0, 0, o.blen, o.flags|s_flag_root)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 32 {
    let b = Bytes::get(io, i)
    StringBuilder::push(sb, String::from_char_code(s_hex_digit((b>>4)&15)))
    StringBuilder::push(sb, String::from_char_code(s_hex_digit(b&15)))
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

//# Public API

/// BLAKE3 digest (64 hex chars) of a byte buffer — SIMD kernel path.
export fn blake3_bytes_simd(data: Bytes) -> String {
  root_hex_s(subtree_output_s(data, 0, Bytes::length(data), 0))
}

/// BLAKE3 digest (64 hex chars) of a string — SIMD kernel path. Char codes
/// are taken mod 256 (same byte convention as the scalar blake3).
export fn blake3_simd(msg: String) -> String {
  let len = String::length(msg)
  let data = Bytes::new(len)
  let mut i = 0
  while i < len {
    Bytes::set(data, i, String::char_code_at(msg, i)&255)
    i = i + 1
  }
  blake3_bytes_simd(data)
}
