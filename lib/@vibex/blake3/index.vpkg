name = @vibex/blake3
version = 0.0.1
description =
  #|@vibex/blake3 — BLAKE3 hash (256-bit, hex digest)。cache fingerprint の
  #|sha1 置き換え検討用 (ADR-0065 実験 scope)。
deps = {}

generated_hash =

// @vibex/blake3 — BLAKE3 (spec-complete: chunk/tree hashing, official test
// vectors in blake3_test.vibe)。出力は 256-bit digest の little-endian hex。

fn blake3(msg: String) -> String
fn blake3_bytes(data: Bytes) -> String

// SIMD kernel path (inline wasm, linear backend のみ — simd.vibe 冒頭参照)
fn blake3_simd(msg: String) -> String
fn blake3_bytes_simd(data: Bytes) -> String
