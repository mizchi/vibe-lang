//# Functions

// The Predicate / Transform effect DEFINITIONS live in the package contract
// (index.vibei) as transparent declarations (#752, ADR-0063: effect rows are
// core contract surface) — this file only uses them.

// map_effect: (Array[Int]) -> Array[Int] with {Transform}
export let map_effect = (arr: Array[Int]) -> Array[Int] with { Transform } {
  let b = ArrayBuilder::new()
  for x in arr {
    ArrayBuilder::push(b, perform Transform::Apply(x))
  }
  ArrayBuilder::freeze(b)
}

// filter_effect: (Array[Int]) -> Array[Int] with {Predicate}
export let filter_effect = (arr: Array[Int]) -> Array[Int] with { Predicate } {
  let b = ArrayBuilder::new()
  for x in arr {
    if perform Predicate::Test(x) {
      ArrayBuilder::push(b, x)
    }
  }
  ArrayBuilder::freeze(b)
}
