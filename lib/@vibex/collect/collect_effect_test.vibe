//# Types

effect Predicate {
  Test(Int) -> Bool
}

effect Transform {
  Apply(Int) -> Int
}

//# Misc

test "filter all pass" {
  let result = handle {
    let a = perform Predicate::Test(2)
    let b = perform Predicate::Test(4)
    let c = perform Predicate::Test(6)
    let mut count = 0
    if a {
      count = count + 1
    }
    if b {
      count = count + 1
    }
    if c {
      count = count + 1
    }
    count
  } with Predicate {
    Test(_x) => resume(true)
  }
  assert(result == 3)
}

test "map double" {
  let result = handle {
    let a = perform Transform::Apply(5)
    let b = perform Transform::Apply(10)
    a + b
  } with Transform {
    Apply(x) => resume(x * 2)
  }
  // 10 + 20 = 30
  assert(result == 30)
}

test "swap behavior" {
  // Same logic, different Transform handler
  let result = handle {
    let a = perform Transform::Apply(5)
    let b = perform Transform::Apply(10)
    a + b
  } with Transform {
    Apply(x) => resume(x + 100)
  }
  // 105 + 110 = 215
  assert(result == 215)
}
