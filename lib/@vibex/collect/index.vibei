version 0.0.1

// @vibex/collect — effect ベースのコレクション操作 (ADR-0065 実験 scope)。
// Predicate / Transform は透明 effect 宣言: 定義そのものが契約 (#752)。

import ./collect.vibe {}
import ./collect_effect.vibe {}

effect Predicate {
  Test(Int) -> Bool
}

effect Transform {
  Apply(Int) -> Int
}

fn empty_array[T]() -> Array[T]
fn map_effect(arr: Array[Int]) -> Array[Int] with { Transform }
fn filter_effect(arr: Array[Int]) -> Array[Int] with { Predicate }

let version: String
