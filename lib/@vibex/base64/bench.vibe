//# Imports

import . {
  decode, encode, encode_url_safe
}

//# Misc

bench "base64/encode_short" {
  let _ = encode("Hello")
}

bench "base64/encode_medium" {
  let _ = encode("The quick brown fox jumps over the lazy dog")
}

bench "base64/decode_short" {
  let _ = decode("SGVsbG8=")
}

bench "base64/decode_medium" {
  let _ = decode("VGhlIHF1aWNrIGJyb3duIGZveCBqdW1wcyBvdmVyIHRoZSBsYXp5IGRvZw==")
}

bench "base64/roundtrip" {
  let encoded = encode("Hello, World!")
  let _ = decode(encoded)
}

bench "base64/encode_url_safe" {
  let _ = encode_url_safe("Hello, World!")
}
