// Derived-`==` coverage for this package's enums (#1556).
//
// `T::equals` is DERIVED: `desugar_derives` emits one for every declared enum
// whether or not anything uses `==` on that type. Nothing in the suite called
// these, so all of their branches sat unreached -- 1,710 across 96 types, 3.8%
// of the whole branch denominator. That is worth a test beyond the number:
// ADR-0097 / #1526 are actively changing what `==` means in each context, and a
// structural comparison over a package's own data types is exactly the surface
// those changes move.
//
// Shape of the generated function:
//   match a { V(..) => match b { V(..) => fields..., _ => false }, ... }
// so covering it takes each variant compared to ITSELF (the inner matching arm)
// and to a DIFFERENT one (the inner `_`). The two loops per type do that.
//
// Both sides are bound to NAMES with an explicit type before comparing.
// Comparing `Array::get(..)` results directly is the documented
// reference-equality hole (AGENTS.md: "関数戻り値経由") -- the dispatch cannot
// see the operand type through a call result, so `==` silently stays reference
// equality. Measured on Token: 9/270 branches with the direct form, 270/270
// with the bound form. The loops PASS either way, which is what makes it worth
// spelling out here.
//# Imports

import ./regexp.vibe {
  Re
}

//# Helpers

/// One literal per `Re` variant, in declaration order (#1556).
fn every_re() -> Array[Re] {
  [
    RChar(7),
    RDot,
    RSeq([
      RDot
    ]),
    RAlt(RDot, RDot),
    RStar(RDot),
    RStarLazy(RDot),
    RPlus(RDot),
    RPlusLazy(RDot),
    ROpt(RDot),
    ROptLazy(RDot),
    RClass([
      (1, 2)
    ]),
    RNClass([
      (1, 2)
    ]),
    RAnchorStart,
    RAnchorEnd,
    RRepeat(RDot, 7, 7),
    RRepeatLazy(RDot, 7, 7),
    RWordBound,
    RNotWordBound,
    RLookAhead(RDot),
    RNegLookAhead(RDot),
    RLookBehind(RDot),
    RNegLookBehind(RDot),
    RAtomic(RDot),
    RCapture(RDot, 7),
    RBackRef(7),
    RFlags(RDot, 7)
  ]
}

/// The same variants rebuilt with DIFFERENT payloads, in lockstep with
/// `every_re`. Comparing the two arrays element-wise keeps the tag fixed and
/// varies only the fields, which is the only way into the field-comparison
/// branches of a matched arm.
fn every_re_alt() -> Array[Re] {
  [
    RChar(8),
    RDot,
    RSeq([
      RDot
    ]),
    RAlt(RDot, RDot),
    RStar(RDot),
    RStarLazy(RDot),
    RPlus(RDot),
    RPlusLazy(RDot),
    ROpt(RDot),
    ROptLazy(RDot),
    RClass([
      (3, 4)
    ]),
    RNClass([
      (3, 4)
    ]),
    RAnchorStart,
    RAnchorEnd,
    RRepeat(RDot, 8, 8),
    RRepeatLazy(RDot, 8, 8),
    RWordBound,
    RNotWordBound,
    RLookAhead(RDot),
    RNegLookAhead(RDot),
    RLookBehind(RDot),
    RNegLookBehind(RDot),
    RAtomic(RDot),
    RCapture(RDot, 8),
    RBackRef(8),
    RFlags(RDot, 8)
  ]
}

//# Tests

test "Re ==: every variant is structurally equal to itself" {
  let vs = every_re()
  let n = Array::length(vs)
  let mut same = 0
  let mut i = 0
  while i < n {
    let a: Re = Array::get(vs, i)
    let b: Re = Array::get(vs, i)
    if a == b {
      same = same + 1
    } else {
      ()
    }
    i = i + 1
  }
  // Both numbers are pinned: a variant added to the enum but not to
  // `every_re` shows up as a count mismatch rather than as silence.
  inspect(n, "26")
  inspect(same, "26")
}

test "Re ==: distinct variants are never equal" {
  let vs = every_re()
  let n = Array::length(vs)
  let mut differ = 0
  let mut i = 0
  while i < n {
    let j = if i + 1 < n {
      i + 1
    } else {
      0
    }
    let a: Re = Array::get(vs, i)
    let b: Re = Array::get(vs, j)
    if a == b {
      ()
    } else {
      differ = differ + 1
    }
    i = i + 1
  }
  inspect(differ, "26")
}

test "Re ==: same variant with different payloads is not equal" {
  let vs = every_re()
  let alt = every_re_alt()
  let n = Array::length(vs)
  let mut differ = 0
  let mut i = 0
  while i < n {
    let a: Re = Array::get(vs, i)
    let b: Re = Array::get(alt, i)
    if a == b {
      ()
    } else {
      differ = differ + 1
    }
    i = i + 1
  }
  // Exactly the variants that CARRY a payload must differ; the nullary ones
  // rebuild identically and must still compare equal. A derive that compared
  // tags only would report 0 here.
  inspect(Array::length(alt), "26")
  inspect(differ, "8")
}
