// @vibex/regexp — 正規表現 (compile/検索/置換/分割 + capture group)
// (ADR-0065 実験 scope)。

import ./regexp.vibe {}

type Re
type Regex
type Match

fn compile(pattern: String) -> Re
fn compile_regex(pattern: String) -> Regex
fn is_match(re: Re, s: String) -> Bool
fn test_match(re: Re, s: String) -> Bool
fn find(re: Re, s: String) -> Int
fn find_match(re: Re, s: String) -> String
fn find_all(re: Re, s: String) -> Array[String]
fn count(re: Re, s: String) -> Int
fn split(re: Re, s: String) -> Array[String]
fn replace_first(re: Re, s: String, replacement: String) -> String
fn replace_all(re: Re, s: String, replacement: String) -> String
fn escape(s: String) -> String
fn debug_match_pos(re: Re, s: String) -> Int
fn match_groups(regex: Regex, s: String) -> Match
fn find_all_groups(regex: Regex, s: String) -> Array[Match]
fn replace_with_groups(regex: Regex, s: String, replacement: String) -> String
fn has_match(m: Match) -> Bool
fn get_match_text(m: Match) -> String
fn get_capture(m: Match, idx: Int) -> String
fn get_named_capture(m: Match, name: String) -> String

let version: String
