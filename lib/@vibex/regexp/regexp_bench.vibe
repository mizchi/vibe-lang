//# Imports

import .{
  compile,
  compile_regex,
  count,
  find,
  find_all,
  find_match,
  get_capture,
  get_named_capture,
  has_match,
  is_match,
  match_groups,
  replace_all,
  replace_first,
  replace_with_groups,
  split,
  test_match
}

//# Misc

bench "regexp/compile_simple" {
  let _ = compile("hello")
}

bench "regexp/compile_complex" {
  let _ = compile("(foo|bar)+[0-9]*\\.\\w+")
}

bench "regexp/test_match_literal" {
  let re = compile("hello")
  let _ = test_match(re = re, s = "hello")
}

bench "regexp/test_match_class" {
  let re = compile("[a-z]+[0-9]+")
  let _ = test_match(re = re, s = "abc123")
}

bench "regexp/find_in_string" {
  let re = compile("\\d+")
  let _ = find(re = re, s = "the answer is 42 ok")
}

bench "regexp/find_match" {
  let re = compile("[a-z]+")
  let _ = find_match(re = re, s = "123hello456")
}

bench "regexp/backtrack_star" {
  let re = compile("a.*b")
  let _ = test_match(re = re, s = "axxxxxxxxxxxb")
}

bench "regexp/anchor_start_end" {
  let re = compile("^hello$")
  let _ = test_match(re = re, s = "hello")
}

bench "regexp/find_all" {
  let re = compile("\\d+")
  let _ = find_all(re = re, s = "a1b23c456d7890")
}

bench "regexp/replace_all" {
  let re = compile("\\d+")
  let _ = replace_all(re = re, s = "a1b23c456", replacement = "N")
}

bench "regexp/replace_first" {
  let re = compile("\\d+")
  let _ = replace_first(re = re, s = "a1b23c456", replacement = "X")
}

bench "regexp/split" {
  let re = compile(",")
  let _ = split(re = re, s = "a,b,c,d,e,f")
}

bench "regexp/repeat_exact" {
  let re = compile("[a-z]{4}")
  let _ = test_match(re = re, s = "abcd")
}

bench "regexp/word_boundary" {
  let re = compile("\\bhello\\b")
  let _ = is_match(re = re, s = "say hello world")
}

bench "regexp/count" {
  let re = compile("\\d+")
  let _ = count(re = re, s = "a1b23c456d7e8f9")
}

bench "regexp/compile_regex_named" {
  let _ = compile_regex("(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})")
}

bench "regexp/match_groups_numbered" {
  let re = compile_regex("(\\d+)-(\\d+)")
  let _ = match_groups(regex = re, s = "2026-03")
}

bench "regexp/match_groups_named" {
  let re = compile_regex("(?<year>\\d{4})-(?<month>\\d{2})")
  let _ = match_groups(regex = re, s = "date: 2026-03-13")
}

bench "regexp/get_capture" {
  let re = compile_regex("(\\w+)@(\\w+)")
  let m = match_groups(regex = re, s = "user@host")
  let _ = get_capture(m = m, idx = 0)
  let _ = get_capture(m = m, idx = 1)
}

bench "regexp/get_named_capture" {
  let re = compile_regex("(?<user>\\w+)@(?<host>\\w+)")
  let m = match_groups(regex = re, s = "user@host")
  let _ = get_named_capture(m = m, name = "user")
  let _ = get_named_capture(m = m, name = "host")
}

bench "regexp/backreference" {
  let re = compile_regex("(\\w+)=\\1")
  let m = match_groups(regex = re, s = "abc=abc")
  let _ = has_match(m)
}

bench "regexp/non_capturing_group" {
  let re = compile_regex("(?:foo|bar)(baz)")
  let _ = match_groups(regex = re, s = "foobaz")
}

bench "regexp/replace_with_groups" {
  let re = compile_regex("(\\w+)@(\\w+)")
  let _ = replace_with_groups(regex = re, s = "user@host other@place", replacement = "$2/$1")
}

bench "regexp/replace_with_named_groups" {
  let re = compile_regex("(?<first>\\w+)-(?<last>\\w+)")
  let _ = replace_with_groups(regex = re, s = "John-Doe Jane-Smith", replacement = "${last}, ${first}")
}
