//# Types

export enum Re {
  RChar(Int);
  RDot;
  RSeq(Array[Re]);
  RAlt(Re, Re);
  RStar(Re);
  RStarLazy(Re);
  RPlus(Re);
  RPlusLazy(Re);
  ROpt(Re);
  ROptLazy(Re);
  RClass(Array[(Int, Int)]);
  RNClass(Array[(Int, Int)]);
  RAnchorStart;
  RAnchorEnd;
  RRepeat(Re, Int, Int);
  RRepeatLazy(Re, Int, Int);
  RWordBound;
  RNotWordBound;
  RLookAhead(Re);
  RNegLookAhead(Re);
  RLookBehind(Re);
  RNegLookBehind(Re);
  RAtomic(Re);
  RCapture(Re, Int);
  RBackRef(Int);
  RFlags(Re, Int)
}

export enum Regex {
  Regex(Re, Array[String])
}

export enum Match {
  Match(String, Array[String], Array[String])
  // Match(full_match, group_values, group_names)
}

//# Functions

fn char_at(s: String, idx: Int) -> String {
  String::substring(s, idx, idx + 1)
}

fn empty_res() -> Array[Re] {
  Array::slice([RDot], 0, 0)
}

export fn has_match(m: Match) -> Bool {
  match m {
    Match(full, _, _) => String::length(full) > 0
  }
}

fn in_ranges(c: Int, ranges: Array[(Int, Int)]) -> Bool {
  let len = Array::length(ranges)
  let rec check = (i: Int) -> Bool {
    if i >= len {
      false
    }
    else {
      let (lo, hi) = Array::get(ranges, i)
      if c >= lo && c <= hi {
        true
      } else {
        check(i + 1)
      }
    }
  }
  check(0)
}

fn append_ints(target: Array[Int], source: Array[Int]) -> Unit {
  let len = Array::length(source)
  let mut i = 0
  while i < len {
    Array::push(target, Array::get(source, i))
    i = i + 1
  }
}

let flag_dotall: Int = 4

export fn get_capture(m: Match, idx: Int) -> String {
  match m {
    Match(_, captures, _) => if idx < Array::length(captures) {
      Array::get(captures, idx)
    } else {
      ""
    }
  }
}

fn lower_ascii(c: Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

fn upper_ascii(c: Int) -> Int {
  if c >= 97 && c <= 122 {
    c - 32
  } else {
    c
  }
}

fn char_at_code(s: String, idx: Int) -> Int {
  String::char_code_at(s, idx)
}

fn parse_int(s: String, start: Int) -> (Int, Int) {
  let len = String::length(s)
  let mut i = start
  let mut n = 0
  let mut done = false
  while i < len && not(done) {
    let c = char_at_code(s, i)
    if c >= 48 && c <= 57 {
      n = n * 10 + (c - 48)
      i = i + 1
    } else {
      done = true
    }
  }
  (n, i)
}

fn empty_ranges() -> Array[(Int, Int)] {
  Array::slice([(0, 0)], 0, 0)
}

fn flag_enabled(flags: Int, mask: Int) -> Bool {
  (flags&mask) != 0
}

fn is_flag_name(ch: String) -> Bool {
  ch == "i" || ch == "m" || ch == "s"
}

fn is_meta_char(c: Int) -> Bool {
  c == 46 || c == 42 || c == 43 || c == 63 || c == 94 || c == 36 ||
  c == 124 || c == 92 || c == 40 || c == 41 || c == 91 || c == 93 ||
  c == 123 || c == 125
}

export fn escape(s: String) -> String {
  let len = String::length(s)
  let mut result = ""
  let mut i = 0
  while i < len {
    let c = char_at_code(s, i)
    if is_meta_char(c) {
      result = "\{result}\\"
    }
    result = "\{result}\{char_at(s, i)}"
    i = i + 1
  }
  result
}

fn is_word_char(c: Int) -> Bool {
  (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn parse_repeat(pattern: String, pos: Int) -> (Int, Int, Int) {
  let len = String::length(pattern)
  let (n, after_n) = parse_int(pattern, pos)
  if after_n >= len {
    (0, 0, pos)
  }
  else if char_at(pattern, after_n) == "}" {
    (n, n, after_n + 1)
  }
  else if char_at(pattern, after_n) == "," {
    if after_n + 1 < len && char_at(pattern, after_n + 1) == "}" {
      (n, 999999, after_n + 2)
    } else {
      let (m, after_m) = parse_int(pattern, after_n + 1)
      if after_m < len && char_at(pattern, after_m) == "}" {
        (n, m, after_m + 1)
      } else {
        (0, 0, pos)
      }
    }
  }
  else {
    (0, 0, pos)
  }
}

fn append_states(target: Array[(Int, Array[Int])], source: Array[(Int, Array[Int])]) -> Unit {
  let len = Array::length(source)
  let mut i = 0
  while i < len {
    Array::push(target, Array::get(source, i))
    i = i + 1
  }
}

fn is_line_break(c: Int) -> Bool {
  c == 10 || c == 13
}

let flag_multiline: Int = 2

export fn get_match_text(m: Match) -> String {
  match m {
    Match(full, _, _) => full
  }
}

fn clone_int_array(items: Array[Int]) -> Array[Int] {
  Array::slice(items, 0, Array::length(items))
}

fn single_state(pos: Int, collector: Array[Int]) -> Array[(Int, Array[Int])] {
  [(pos, clone_int_array(collector))]
}

fn empty_int_array() -> Array[Int] {
  Array::slice([0], 0, 0)
}

fn empty_states() -> Array[(Int, Array[Int])] {
  Array::slice([(0, empty_int_array())], 0, 0)
}

fn repeat_impl(mc: (Re, String, Int, Int, Array[Int]) -> Array[(Int, Array[Int])], inner: Re, s: String, flags: Int, min_n: Int, max_n: Int, lazy: Bool, count: Int, cur: Int, cur_collector: Array[Int]) -> Array[(Int, Array[Int])] {
  let stop_states = if count >= min_n {
    single_state(cur, cur_collector)
  } else {
    empty_states()
  }
  if count >= max_n {
    stop_states
  } else {
    let next_states = mc(inner, s, cur, flags, cur_collector)
    let advanced_states = empty_states()
    let n_next = Array::length(next_states)
    let mut i = 0
    while i < n_next {
      let (next_pos, next_collector) = Array::get(next_states, i)
      if next_pos > cur {
        append_states(advanced_states, repeat_impl(mc, inner, s, flags, min_n, max_n, lazy, count + 1, next_pos, next_collector))
      }
      i = i + 1
    }
    let results = empty_states()
    if lazy {
      append_states(results, stop_states)
      append_states(results, advanced_states)
    } else {
      append_states(results, advanced_states)
      append_states(results, stop_states)
    }
    results
  }
}

/// Hoisted out of `match_candidates` (like `repeat_impl` above) rather than
/// defined as a nested closure that captures `match_candidates` (its own
/// enclosing `rec` binding) via `mc`: an unused nested closure capturing a
/// recursive self-reference corrupted the linear-backend heap even on
/// branches that never invoked it (#776 — minimal repro: any `let rec` with
/// an unreachable inner closure calling the outer function crashed with
/// "memory access out of bounds" on the very first call).
fn match_seq_impl(mc: (Re, String, Int, Int, Array[Int]) -> Array[(Int, Array[Int])], s: String, flags: Int, parts: Array[Re], seq_pos: Int, seq_collector: Array[Int]) -> Array[(Int, Array[Int])] {
  let part_count = Array::length(parts)
  let mut states = [(seq_pos, seq_collector)]
  let mut idx = 0
  while idx < part_count {
    let next_states = empty_states()
    let n_states = Array::length(states)
    let mut si = 0
    while si < n_states {
      let (cur_pos, cur_coll) = Array::get(states, si)
      let part_results = mc(Array::get(parts, idx), s, cur_pos, flags, cur_coll)
      append_states(next_states, part_results)
      si = si + 1
    }
    states = next_states
    idx = idx + 1
  }
  states
}

let flag_ignore_case: Int = 1

fn chars_equal(lhs: Int, rhs: Int, flags: Int) -> Bool {
  if flag_enabled(flags, flag_ignore_case) {
    lower_ascii(lhs) == lower_ascii(rhs)
  } else {
    lhs == rhs
  }
}

fn region_equals(s: String, left: Int, right: Int, size: Int, flags: Int) -> Bool {
  let mut i = 0
  let mut matched = true
  while i < size && matched {
    matched = chars_equal(char_at_code(s, left + i), char_at_code(s, right + i), flags)
    i = i + 1
  }
  matched
}

fn parse_group_name(pattern: String, pos: Int) -> (String, Int) {
  let len = String::length(pattern)
  let mut i = pos
  let mut name = ""
  while i < len && not(char_at(pattern, i) == ">") {
    name = "\{name}\{char_at(pattern, i)}"
    i = i + 1
  }
  if i < len {
    (name, i + 1)
  } else {
    (name, i)
  }
}

export fn get_named_capture(m: Match, name: String) -> String {
  match m {
    Match(_, captures, gnames) => {
      let len = Array::length(gnames)
      let mut i = 0
      let mut result = ""
      let mut found = false
      while i < len && not(found) {
        if Array::get(gnames, i) == name {
          if i < Array::length(captures) {
            result = Array::get(captures, i)
          }
          found = true
        }
        i = i + 1
      }
      result
    }
  }
}

fn empty_string_array() -> Array[String] {
  Array::slice([""], 0, 0)
}

fn empty_matches() -> Array[Match] {
  Array::slice([Match("", empty_string_array(), empty_string_array())], 0, 0)
}

fn extract_captures(collector: Array[Int], s: String, num_groups: Int) -> Array[String] {
  // Preallocate exactly num_groups slots (filled with "") — only Array::set
  // follows below. FixedArray::make is GC-backend-only (#776); the linear
  // backend has no lowering for it, so build a regular Array[String] instead.
  let captures = empty_string_array()
  let mut fill_i = 0
  while fill_i < num_groups {
    Array::push(captures, "")
    fill_i = fill_i + 1
  }
  let clen = Array::length(collector)
  let mut ci = 0
  while ci + 2 < clen {
    let tag = Array::get(collector, ci)
    if tag <= -1000 {
      let gid = 0 - tag - 1000
      if gid < num_groups {
        let start = Array::get(collector, ci + 1)
        let end = Array::get(collector, ci + 2)
        Array::set(captures, gid, s[start: end])
      }
    }
    ci = ci + 3
  }
  captures
}

fn flag_mask_for_name(ch: String) -> Int {
  if ch == "i" {
    flag_ignore_case
  }
  else if ch == "m" {
    flag_multiline
  }
  else if ch == "s" {
    flag_dotall
  }
  else {
    0
  }
}

fn parse_flag_mask(pattern: String, pos: Int) -> (Int, Int) {
  let len = String::length(pattern)
  let mut i = pos
  let mut mask = 0
  while i < len && is_flag_name(char_at(pattern, i)) {
    mask = mask|flag_mask_for_name(char_at(pattern, i))
    i = i + 1
  }
  (mask, i)
}

fn parse_class_ranges(pattern: String, pos: Int) -> (Array[(Int, Int)], Int) {
  let len = String::length(pattern)
  let mut ranges = empty_ranges()
  let mut i = pos
  while i < len && not(char_at(pattern, i) == "]") {
    if char_at(pattern, i) == "\\" && i + 1 < len {
      let next = char_at(pattern, i + 1)
      if next == "d" {
        Array::push(ranges, (48, 57))
        i = i + 2
      } else if next == "w" {
        Array::push(ranges, (48, 57))
        Array::push(ranges, (65, 90))
        Array::push(ranges, (97, 122))
        Array::push(ranges, (95, 95))
        i = i + 2
      } else if next == "s" {
        Array::push(ranges, (9, 10))
        Array::push(ranges, (13, 13))
        Array::push(ranges, (32, 32))
        i = i + 2
      } else {
        Array::push(ranges, (char_at_code(pattern, i + 1), char_at_code(pattern, i + 1)))
        i = i + 2
      }
    } else {
      let c = char_at_code(pattern, i)
      if i + 2 < len && char_at(pattern, i + 1) == "-" && not(char_at(pattern, i + 2) == "]") {
        let c2 = char_at_code(pattern, i + 2)
        Array::push(ranges, (c, c2))
        i = i + 3
      } else {
        Array::push(ranges, (c, c))
        i = i + 1
      }
    }
  }
  (ranges, i + 1)
}

fn parse2(pattern: String, pos: Int, mode: Int, acc: Array[Re], gc: Array[Int], gnames: Array[String]) -> (Re, Int) {
  let len = String::length(pattern)
  let empty_arr = empty_res()
  if mode == 0 {
    let (left, np) = parse2(pattern, pos, 1, empty_res(), gc, gnames)
    if np < len && char_at(pattern, np) == "|" {
      let (right, ep) = parse2(pattern, np + 1, 0, empty_res(), gc, gnames)
      (RAlt(left, right), ep)
    } else {
      (left, np)
    }
  } else if mode == 1 {
    if pos >= len {
      let cnt = Array::length(acc)
      if cnt == 0 {
        (RSeq(empty_arr), pos)
      }
      else if cnt == 1 {
        (Array::get(acc, 0), pos)
      }
      else {
        (RSeq(acc), pos)
      }
    } else {
      let ch = char_at(pattern, pos)
      if ch == ")" || ch == "|" {
        let cnt = Array::length(acc)
        if cnt == 0 {
          (RSeq(empty_arr), pos)
        }
        else if cnt == 1 {
          (Array::get(acc, 0), pos)
        }
        else {
          (RSeq(acc), pos)
        }
      } else {
        let (atom, ni) = parse2(pattern, pos, 2, empty_res(), gc, gnames)
        // Tail-recursive in mode 1: only this branch threads `acc`
        // forward, so mutating in place is safe (no other caller
        // observes the old prefix). Previous Array::concat(acc, [atom])
        // copied the whole prefix per atom — O(N²) for an N-atom seq.
        Array::push(acc, atom)
        parse2(pattern, ni, 1, acc, gc, gnames)
      }
    }
  } else if mode == 2 {
    let (atom, np) = parse2(pattern, pos, 3, empty_res(), gc, gnames)
    if np < len {
      let ch = char_at(pattern, np)
      if ch == "*" {
        if np + 1 < len && char_at(pattern, np + 1) == "?" {
          (RStarLazy(atom), np + 2)
        } else {
          (RStar(atom), np + 1)
        }
      }
      else if ch == "+" {
        if np + 1 < len && char_at(pattern, np + 1) == "?" {
          (RPlusLazy(atom), np + 2)
        } else {
          (RPlus(atom), np + 1)
        }
      }
      else if ch == "?" {
        if np + 1 < len && char_at(pattern, np + 1) == "?" {
          (ROptLazy(atom), np + 2)
        } else {
          (ROpt(atom), np + 1)
        }
      }
      else if ch == "{" {
        let (mn, mx, ep) = parse_repeat(pattern, np + 1)
        if ep > np {
          if ep < len && char_at(pattern, ep) == "?" {
            (RRepeatLazy(atom, mn, mx), ep + 1)
          } else {
            (RRepeat(atom, mn, mx), ep)
          }
        }
        else {
          (atom, np)
        }
      }
      else {
        (atom, np)
      }
    } else {
      (atom, np)
    }
  } else {
    if pos >= len {
      (RSeq(empty_arr), pos)
    } else {
      let ch = char_at(pattern, pos)
      if ch == "^" {
        (RAnchorStart, pos + 1)
      }
      else if ch == "$" {
        (RAnchorEnd, pos + 1)
      }
      else if ch == "(" {
        if pos + 1 < len && char_at(pattern, pos + 1) == "?" {
          if pos + 2 < len && char_at(pattern, pos + 2) == "=" {
            let (inner, ep) = parse2(pattern, pos + 3, 0, empty_res(), gc, gnames)
            let skip = if ep < len && char_at(pattern, ep) == ")" {
              ep + 1
            } else {
              ep
            }
            (RLookAhead(inner), skip)
          }
          else if pos + 2 < len && char_at(pattern, pos + 2) == "!" {
            let (inner, ep) = parse2(pattern, pos + 3, 0, empty_res(), gc, gnames)
            let skip = if ep < len && char_at(pattern, ep) == ")" {
              ep + 1
            } else {
              ep
            }
            (RNegLookAhead(inner), skip)
          }
          else if pos + 2 < len && char_at(pattern, pos + 2) == ">" {
            let (inner, ep) = parse2(pattern, pos + 3, 0, empty_res(), gc, gnames)
            let skip = if ep < len && char_at(pattern, ep) == ")" {
              ep + 1
            } else {
              ep
            }
            (RAtomic(inner), skip)
          }
          else if pos + 2 < len && char_at(pattern, pos + 2) == "<" {
            if pos + 3 < len && char_at(pattern, pos + 3) == "=" {
              let (inner, ep) = parse2(pattern, pos + 4, 0, empty_res(), gc, gnames)
              let skip = if ep < len && char_at(pattern, ep) == ")" {
                ep + 1
              } else {
                ep
              }
              (RLookBehind(inner), skip)
            }
            else if pos + 3 < len && char_at(pattern, pos + 3) == "!" {
              let (inner, ep) = parse2(pattern, pos + 4, 0, empty_res(), gc, gnames)
              let skip = if ep < len && char_at(pattern, ep) == ")" {
                ep + 1
              } else {
                ep
              }
              (RNegLookBehind(inner), skip)
            }
            else {
              let (name, after_name) = parse_group_name(pattern, pos + 3)
              let gid = Array::get(gc, 0)
              Array::set(gc, 0, gid + 1)
              Array::push(gnames, name)
              let (inner, ep) = parse2(pattern, after_name, 0, empty_res(), gc, gnames)
              let skip = if ep < len && char_at(pattern, ep) == ")" {
                ep + 1
              } else {
                ep
              }
              (RCapture(inner, gid), skip)
            }
          }
          else if pos + 2 < len && char_at(pattern, pos + 2) == ":" {
            let (inner, ep) = parse2(pattern, pos + 3, 0, empty_res(), gc, gnames)
            let skip = if ep < len && char_at(pattern, ep) == ")" {
              ep + 1
            } else {
              ep
            }
            (inner, skip)
          }
          else {
            let (mask, after_flags) = parse_flag_mask(pattern, pos + 2)
            if mask != 0 && after_flags < len && char_at(pattern, after_flags) == ":" {
              let (inner, ep) = parse2(pattern, after_flags + 1, 0, empty_res(), gc, gnames)
              let skip = if ep < len && char_at(pattern, ep) == ")" {
                ep + 1
              } else {
                ep
              }
              (RFlags(inner, mask), skip)
            }
            else {
              let gid = Array::get(gc, 0)
              Array::set(gc, 0, gid + 1)
              Array::push(gnames, "")
              let (inner, ep) = parse2(pattern, pos + 1, 0, empty_res(), gc, gnames)
              let skip = if ep < len && char_at(pattern, ep) == ")" {
                ep + 1
              } else {
                ep
              }
              (RCapture(inner, gid), skip)
            }
          }
        } else {
          let gid = Array::get(gc, 0)
          Array::set(gc, 0, gid + 1)
          Array::push(gnames, "")
          let (inner, ep) = parse2(pattern, pos + 1, 0, empty_res(), gc, gnames)
          let skip = if ep < len && char_at(pattern, ep) == ")" {
            ep + 1
          } else {
            ep
          }
          (RCapture(inner, gid), skip)
        }
      }
      else if ch == "[" {
        let negated = pos + 1 < len && char_at(pattern, pos + 1) == "^"
        let start = if negated {
          pos + 2
        } else {
          pos + 1
        }
        let (ranges, ep) = parse_class_ranges(pattern, start)
        if negated {
          (RNClass(ranges), ep)
        }
        else {
          (RClass(ranges), ep)
        }
      }
      else if ch == "." {
        (RDot, pos + 1)
      }
      else if ch == "\\" && pos + 1 < len {
        let next = char_at(pattern, pos + 1)
        if next == "d" {
          (RClass([(48, 57)]), pos + 2)
        }
        else if next == "D" {
          (RNClass([(48, 57)]), pos + 2)
        }
        else if next == "w" {
          (RClass([(48, 57), (65, 90), (97, 122), (95, 95)]), pos + 2)
        }
        else if next == "W" {
          (RNClass([(48, 57), (65, 90), (97, 122), (95, 95)]), pos + 2)
        }
        else if next == "s" {
          (RClass([(32, 32), (9, 9), (10, 10), (13, 13)]), pos + 2)
        }
        else if next == "S" {
          (RNClass([(32, 32), (9, 9), (10, 10), (13, 13)]), pos + 2)
        }
        else if next == "b" {
          (RWordBound, pos + 2)
        }
        else if next == "B" {
          (RNotWordBound, pos + 2)
        }
        else if next == "t" {
          (RChar(9), pos + 2)
        }
        else if next == "n" {
          (RChar(10), pos + 2)
        }
        else if next == "r" {
          (RChar(13), pos + 2)
        }
        else {
          let nc = char_at_code(pattern, pos + 1)
          if nc >= 49 && nc <= 57 {
            (RBackRef(nc - 49), pos + 2)
          } else {
            (RChar(nc), pos + 2)
          }
        }
      }
      else {
        (RChar(char_at_code(pattern, pos)), pos + 1)
      }
    }
  }
}

fn find_capture_bounds(collector: Array[Int], group_id: Int) -> (Int, Int) {
  let clen = Array::length(collector)
  let mut ci = 0
  let mut cap_start = -1
  let mut cap_end = -1
  while ci + 2 < clen {
    let tag = Array::get(collector, ci)
    if tag == 0 - group_id - 1000 {
      cap_start = Array::get(collector, ci + 1)
      cap_end = Array::get(collector, ci + 2)
    }
    ci = ci + 3
  }
  (cap_start, cap_end)
}

fn is_at_word_boundary(s: String, pos: Int) -> Bool {
  let len = String::length(s)
  let before = if pos > 0 {
    is_word_char(char_at_code(s, pos - 1))
  } else {
    false
  }
  let after = if pos < len {
    is_word_char(char_at_code(s, pos))
  } else {
    false
  }
  if before {
    not(after)
  } else {
    after
  }
}

fn parse_leading_flags(pattern: String) -> (Int, Int) {
  let len = String::length(pattern)
  let mut pos = 0
  let mut flags = 0
  let mut scanning = true
  while scanning &&
  pos + 3 < len &&
  char_at(pattern, pos) == "(" &&
  char_at(pattern, pos + 1) == "?" {
    let (mask, end_pos) = parse_flag_mask(pattern, pos + 2)
    if mask != 0 && end_pos < len && char_at(pattern, end_pos) == ")" {
      flags = flags|mask
      pos = end_pos + 1
    } else {
      scanning = false
    }
  }
  (flags, pos)
}

export fn compile_regex(pattern: String) -> Regex {
  let gc = [0]
  let gnames = empty_string_array()
  let (flags, start_pos) = parse_leading_flags(pattern)
  let (inner, _) = parse2(pattern, start_pos, 0, empty_res(), gc, gnames)
  let re = if flags != 0 {
    RFlags(inner, flags)
  } else {
    inner
  }
  Regex(re, gnames)
}

export fn compile(pattern: String) -> Re {
  match compile_regex(pattern) {
    Regex(re, _) => re
  }
}

fn in_ranges_with_flags(c: Int, ranges: Array[(Int, Int)], flags: Int) -> Bool {
  in_ranges(c, ranges) ||
  (flag_enabled(flags, flag_ignore_case) && (in_ranges(lower_ascii(c), ranges) || in_ranges(upper_ascii(c), ranges)))
}

fn match_candidates(re: Re, s: String, pos: Int, flags: Int, collector: Array[Int]) -> Array[(Int, Array[Int])] {
  let len = String::length(s)
  match re {
    RChar(c) => if pos < len && chars_equal(c, char_at_code(s, pos), flags) {
      single_state(pos + 1, collector)
    } else {
      empty_states()
    },
    RDot => if pos < len &&
    (flag_enabled(flags, flag_dotall) || not(is_line_break(char_at_code(s, pos)))) {
      single_state(pos + 1, collector)
    } else {
      empty_states()
    },
    RClass(ranges) => if pos < len && in_ranges_with_flags(char_at_code(s, pos), ranges, flags) {
      single_state(pos + 1, collector)
    } else {
      empty_states()
    },
    RNClass(ranges) => if pos < len &&
    not(in_ranges_with_flags(char_at_code(s, pos), ranges, flags)) {
      single_state(pos + 1, collector)
    } else {
      empty_states()
    },
    RAnchorStart => if pos == 0 ||
    (flag_enabled(flags, flag_multiline) && pos > 0 && is_line_break(char_at_code(s, pos - 1))) {
      single_state(pos, collector)
    } else {
      empty_states()
    },
    RAnchorEnd => if pos == len ||
    (flag_enabled(flags, flag_multiline) && pos < len && is_line_break(char_at_code(s, pos))) {
      single_state(pos, collector)
    } else {
      empty_states()
    },
    RWordBound => if is_at_word_boundary(s, pos) {
      single_state(pos, collector)
    } else {
      empty_states()
    },
    RNotWordBound => if not(is_at_word_boundary(s, pos)) {
      single_state(pos, collector)
    } else {
      empty_states()
    },
    RRepeat(inner, min_n, max_n) => repeat_impl(match_candidates, inner, s, flags, min_n, max_n, false, 0, pos, collector),
    RRepeatLazy(inner, min_n, max_n) => repeat_impl(match_candidates, inner, s, flags, min_n, max_n, true, 0, pos, collector),
    RCapture(inner, group_id) => {
      let inner_states = match_candidates(inner, s, pos, flags, collector)
      let results = empty_states()
      let len = Array::length(inner_states)
      let mut i = 0
      while i < len {
        let (end_pos, next_collector) = Array::get(inner_states, i)
        let tagged = clone_int_array(next_collector)
        let tag = 0 - group_id - 1000
        Array::push(tagged, tag)
        Array::push(tagged, pos)
        Array::push(tagged, end_pos)
        Array::push(results, (end_pos, tagged))
        i = i + 1
      }
      results
    },
    RBackRef(group_id) => {
      let (cap_start, cap_end) = find_capture_bounds(collector, group_id)
      if cap_start < 0 {
        empty_states()
      } else {
        let cap_len = cap_end - cap_start
        if pos + cap_len > len || not(region_equals(s, cap_start, pos, cap_len, flags)) {
          empty_states()
        } else {
          single_state(pos + cap_len, collector)
        }
      }
    },
    RSeq(seq_parts) => match_seq_impl(match_candidates, s, flags, seq_parts, pos, collector),
    RAlt(a, b) => {
      let results = empty_states()
      append_states(results, match_candidates(a, s, pos, flags, collector))
      append_states(results, match_candidates(b, s, pos, flags, collector))
      results
    },
    RStar(inner) => repeat_impl(match_candidates, inner, s, flags, 0, 999999, false, 0, pos, collector),
    RStarLazy(inner) => repeat_impl(match_candidates, inner, s, flags, 0, 999999, true, 0, pos, collector),
    RPlus(inner) => repeat_impl(match_candidates, inner, s, flags, 1, 999999, false, 0, pos, collector),
    RPlusLazy(inner) => repeat_impl(match_candidates, inner, s, flags, 1, 999999, true, 0, pos, collector),
    ROpt(inner) => repeat_impl(match_candidates, inner, s, flags, 0, 1, false, 0, pos, collector),
    ROptLazy(inner) => repeat_impl(match_candidates, inner, s, flags, 0, 1, true, 0, pos, collector),
    RLookAhead(inner) => if Array::length(match_candidates(inner, s, pos, flags, collector)) > 0 {
      single_state(pos, collector)
    } else {
      empty_states()
    },
    RNegLookAhead(inner) => if Array::length(match_candidates(inner, s, pos, flags, collector)) == 0 {
      single_state(pos, collector)
    } else {
      empty_states()
    },
    RLookBehind(inner) => {
      let mut start = 0
      let mut matched = false
      while start <= pos && not(matched) {
        let look_states = match_candidates(inner, s, start, flags, collector)
        let llen = Array::length(look_states)
        let mut li = 0
        while li < llen && not(matched) {
          let (end_pos, _) = Array::get(look_states, li)
          if end_pos == pos {
            matched = true
          }
          li = li + 1
        }
        start = start + 1
      }
      if matched {
        single_state(pos, collector)
      } else {
        empty_states()
      }
    },
    RNegLookBehind(inner) => {
      let mut start = 0
      let mut matched = false
      while start <= pos && not(matched) {
        let look_states = match_candidates(inner, s, start, flags, collector)
        let llen = Array::length(look_states)
        let mut li = 0
        while li < llen && not(matched) {
          let (end_pos, _) = Array::get(look_states, li)
          if end_pos == pos {
            matched = true
          }
          li = li + 1
        }
        start = start + 1
      }
      if matched {
        empty_states()
      } else {
        single_state(pos, collector)
      }
    },
    RAtomic(inner) => {
      let inner_states = match_candidates(inner, s, pos, flags, collector)
      if Array::length(inner_states) > 0 {
        [Array::get(inner_states, 0)]
      } else {
        empty_states()
      }
    },
    RFlags(inner, extra_flags) => match_candidates(inner, s, pos, flags|extra_flags, collector)
  }
}

fn match_first_state(re: Re, s: String, pos: Int, collector: Array[Int]) -> (Int, Array[Int]) {
  let states = match_candidates(re, s, pos, 0, collector)
  if Array::length(states) > 0 {
    // #787 workaround: `Array::get(states, 0)` returns a `(Int, Array[Int])`
    // tuple whose inner array is NOT retained under RC, so the following drop of
    // the `states` container frees it and the returned array dangles (heap
    // corruption that surfaces on the next allocation). Clone the extracted
    // array so the returned tuple owns its own copy. Same class as #776/#725.
    let (fp, fc) = Array::get(states, 0)
    (fp, clone_int_array(fc))
  } else {
    (-1, empty_int_array())
  }
}

fn match_engine(re: Re, s: String, pos: Int, mode: Int, parts: Array[Re], idx: Int, collector: Array[Int]) -> Int {
  let _ = mode
  let _ = parts
  let _ = idx
  let (matched_pos, matched_collector) = match_first_state(re, s, pos, collector)
  if matched_pos >= 0 {
    append_ints(collector, matched_collector)
  }
  matched_pos
}

fn do_match(re: Re, s: String, pos: Int) -> Int {
  let dummy_parts = empty_res()
  let dummy_collector = empty_int_array()
  match_engine(re, s, pos, 0, dummy_parts, 0, dummy_collector)
}

export fn find(re: Re, s: String) -> Int {
  let len = String::length(s)
  let rec try_pos = (pos: Int) -> Int {
    if pos > len {
      -1
    }
    else {
      let r = do_match(re, s, pos)
      if r >= 0 {
        pos
      } else {
        try_pos(pos + 1)
      }
    }
  }
  try_pos(0)
}

export fn split(re: Re, s: String) -> Array[String] {
  let len = String::length(s)
  let mut results = empty_string_array()
  let mut start = 0
  let mut pos = 0
  while pos <= len {
    let r = do_match(re, s, pos)
    if r >= 0 && r > pos {
      Array::push(results, s[start: pos])
      start = r
      pos = r
    } else {
      pos = pos + 1
    }
  }
  Array::push(results, s[start: len])
  results
}

export fn find_all(re: Re, s: String) -> Array[String] {
  let len = String::length(s)
  let mut results = empty_string_array()
  let mut pos = 0
  while pos <= len {
    let r = do_match(re, s, pos)
    if r >= 0 {
      Array::push(results, s[pos: r])
      if r == pos {
        pos = pos + 1
      } else {
        pos = r
      }
    } else {
      pos = pos + 1
    }
  }
  results
}

export fn count(re: Re, s: String) -> Int {
  Array::length(find_all(re, s))
}

export fn is_match(re: Re, s: String) -> Bool {
  find(re, s) >= 0
}

export fn find_match(re: Re, s: String) -> String {
  let len = String::length(s)
  let rec try_pos = (pos: Int) -> String {
    if pos > len {
      ""
    }
    else {
      let r = do_match(re, s, pos)
      if r >= 0 {
        s[pos: r]
      } else {
        try_pos(pos + 1)
      }
    }
  }
  try_pos(0)
}

export fn test_match(re: Re, s: String) -> Bool {
  do_match(re, s, 0) == String::length(s)
}

export fn replace_all(re: Re, s: String, replacement: String) -> String {
  let len = String::length(s)
  let mut result = ""
  let mut pos = 0
  while pos <= len {
    let r = do_match(re, s, pos)
    if r >= 0 {
      result = "\{result}\{replacement}"
      if r == pos {
        if pos < len {
          result = "\{result}\{char_at(s, pos)}"
        }
        pos = pos + 1
      } else {
        pos = r
      }
    } else {
      if pos < len {
        result = "\{result}\{char_at(s, pos)}"
      }
      pos = pos + 1
    }
  }
  result
}

export fn match_groups(regex: Regex, s: String) -> Match {
  match regex {
    Regex(re, gnames) => {
      let len = String::length(s)
      let num_groups = Array::length(gnames)
      let dummy_parts = empty_res()
      let mut pos = 0
      let mut found = false
      let mut match_start = 0
      let mut match_end = 0
      let mut result_captures = empty_string_array()
      while pos <= len && not(found) {
        let collector = empty_int_array()
        let r = match_engine(re, s, pos, 0, dummy_parts, 0, collector)
        if r >= 0 {
          found = true
          match_start = pos
          match_end = r
          result_captures = extract_captures(collector, s, num_groups)
        } else {
          pos = pos + 1
        }
      }
      if found {
        let full = s[match_start: match_end]
        Match(full, result_captures, gnames)
      } else {
        Match("", empty_string_array(), gnames)
      }
    }
  }
}

export fn replace_first(re: Re, s: String, replacement: String) -> String {
  let len = String::length(s)
  let rec try_pos = (pos: Int) -> String {
    if pos > len {
      s
    }
    else {
      let r = do_match(re, s, pos)
      if r >= 0 {
        "\{s[0:pos]}\{replacement}\{s[r:len]}"
      } else {
        try_pos(pos + 1)
      }
    }
  }
  try_pos(0)
}

export fn debug_match_pos(re: Re, s: String) -> Int {
  do_match(re, s, 0)
}

export fn find_all_groups(regex: Regex, s: String) -> Array[Match] {
  match regex {
    Regex(re, gnames) => {
      let len = String::length(s)
      let num_groups = Array::length(gnames)
      let dummy_parts = empty_res()
      let mut results = empty_matches()
      let mut pos = 0
      while pos <= len {
        let collector = empty_int_array()
        let r = match_engine(re, s, pos, 0, dummy_parts, 0, collector)
        if r >= 0 {
          let full = s[pos: r]
          let caps = extract_captures(collector, s, num_groups)
          Array::push(results, Match(full, caps, gnames))
          if r == pos {
            pos = pos + 1
          }
          else {
            pos = r
          }
        } else {
          pos = pos + 1
        }
      }
      results
    }
  }
}

export fn replace_with_groups(regex: Regex, s: String, replacement: String) -> String {
  match regex {
    Regex(re, gnames) => {
      let len = String::length(s)
      let num_groups = Array::length(gnames)
      let rlen = String::length(replacement)
      let dummy_parts = empty_res()
      let mut result = ""
      let mut pos = 0
      while pos <= len {
        let collector = empty_int_array()
        let r = match_engine(re, s, pos, 0, dummy_parts, 0, collector)
        if r >= 0 {
          let caps = extract_captures(collector, s, num_groups)
          let mut expanded = ""
          let mut ri = 0
          while ri < rlen {
            if ri + 1 < rlen && char_at(replacement, ri) == "$" {
              let nc = char_at_code(replacement, ri + 1)
              if nc >= 49 && nc <= 57 {
                let gid = nc - 49
                if gid < Array::length(caps) {
                  expanded = "\{expanded}\{Array::get(caps, gid)}"
                }
                ri = ri + 2
              }
              else if nc == 123 {
                let mut ni = ri + 2
                let mut gname = ""
                let mut name_done = false
                while ni < rlen && not(name_done) {
                  if char_at(replacement, ni) == "}" {
                    name_done = true
                  } else {
                    gname = "\{gname}\{char_at(replacement, ni)}"
                    ni = ni + 1
                  }
                }
                let gnlen = Array::length(gnames)
                let mut gi = 0
                let mut gfound = false
                while gi < gnlen && not(gfound) {
                  if Array::get(gnames, gi) == gname {
                    if gi < Array::length(caps) {
                      expanded = "\{expanded}\{Array::get(caps, gi)}"
                    }
                    gfound = true
                  }
                  gi = gi + 1
                }
                ri = ni + 1
              }
              else {
                expanded = "\{expanded}\{char_at(replacement, ri)}"
                ri = ri + 1
              }
            } else {
              expanded = "\{expanded}\{char_at(replacement, ri)}"
              ri = ri + 1
            }
          }
          result = "\{result}\{expanded}"
          if r == pos {
            if pos < len {
              result = "\{result}\{char_at(s, pos)}"
            }
            pos = pos + 1
          } else {
            pos = r
          }
        } else {
          if pos < len {
            result = "\{result}\{char_at(s, pos)}"
          }
          pos = pos + 1
        }
      }
      result
    }
  }
}

