//# Values

//# Types

// #897 (ADR-0070 Phase 3): the WIT token/AST enums stay DEFINED (and
// exported) here, with `opaque type` declarations in ./index.vpkg — NOT
// transparent contract definitions, even though the variants are real
// public surface (wit_parser_test.vibe constructs/matches them all). A
// transparent contract definition lives only in the facade unit, and enum
// VARIANTS do not resolve across units the way type names do (@vibe/json's
// "unknown name: JNull" precedent, PR #923). The opaque declaration +
// exported impl definitions ride the same #716 re-export machinery the old
// hand-written index.vibe used, so variant visibility for consumers is
// unchanged. (The old trailing `export { ... }` name blocks became
// redundant once the defs themselves were marked `export` and were
// removed.)

/// --- Tokens ---
export enum WitToken {
  WTIdent(String);
  WTKeyword(String);
  WTSymbol(String);
  WTStringLit(String);
  WTNumber(String);
  WTDoc(String);
  WTEof
}

/// --- AST Types ---
export enum WitTypeExpr {
  TyBool;
  TyU8;
  TyU16;
  TyU32;
  TyU64;
  TyS8;
  TyS16;
  TyS32;
  TyS64;
  TyF32;
  TyF64;
  TyChar;
  TyString;
  TyId(String);
  TyList(WitTypeExpr);
  TyOption(WitTypeExpr);
  TyFuture(WitTypeExpr);
  TyStream(WitTypeExpr);
  TyResult(WitTypeExpr, Option[WitTypeExpr]);
  TyTuple(Array[WitTypeExpr]);
  TyOwn(String);
  TyBorrow(String)
}

export enum WitFuncKind {
  FKFreestanding;
  FKConstructor(String);
  FKMethod(String);
  FKStatic(String)
}

export enum WitTypeDef {
  TDRecord(String, Array[(String, WitTypeExpr)], Option[String]);
  TDEnum(String, Array[String], Option[String]);
  TDFlags(String, Array[String], Option[String]);
  TDVariant(String, Array[(String, Option[WitTypeExpr])], Option[String]);
  TDAlias(String, WitTypeExpr, Option[String]);
  TDResource(String, Array[(String, WitFuncKind, Bool, Array[(String, WitTypeExpr)], Option[WitTypeExpr], Option[String])], Option[String])
}

export enum WitInterfaceItem {
  IIUse(String, String, Option[String], String, Array[String]);
  IITypeDef(WitTypeDef);
  IIFunction(String, WitFuncKind, Bool, Array[(String, WitTypeExpr)], Option[WitTypeExpr], Option[String])
}

export enum WitWorldItem {
  WIInterface(String, String, Option[String], String);
  WIFunction(String, WitFuncKind, Bool, Array[(String, WitTypeExpr)], Option[WitTypeExpr], Option[String]);
  WIInlineInterface(String, Option[String], Array[WitInterfaceItem]);
  WIInclude(String, String, Option[String], String, Array[(String, String)])
}

//# Functions

fn wit_is_digit(_ c: Int) -> Bool {
  c >= 48 && c <= 57
}

fn wit_take_docs(tokens: Array[WitToken], pos: Array[Int]) -> Option[String] {
  let sb = StringBuilder::new()
  let mut count = 0
  while Array::get(pos, at = 0) < Array::length(tokens) {
    match Array::get(tokens, at = Array::get(pos, at = 0)) {
      WTDoc(text) => {
        if count > 0 {
          StringBuilder::push(sb, value = String::from_char_code(10))
        }
        let mut j = 0
        while j < String::length(text) {
          StringBuilder::push(sb, value = String::from_char_code(String::char_code_at(text, at = j)))
          j = j + 1
        }
        pos[0] = Array::get(pos, at = 0) + 1
        count = count + 1
      },
      _ => break
    }
  }
  if count > 0 {
    Some(StringBuilder::freeze(sb))
  } else {
    None
  }
}

fn wit_tok_is_kw(tok: WitToken, kw: String) -> Bool {
  match tok {
    WTKeyword(s) => s == kw,
    _ => false
  }
}

fn wit_is_keyword(_ name: String) -> Bool {
  name == "package" || name == "world" || name == "interface" ||
  name == "include" || name == "as" || name == "with" || name == "from" ||
  name == "record" || name == "enum" || name == "flags" ||
  name == "variant" || name == "resource" || name == "func" ||
  name == "constructor" || name == "import" || name == "export" ||
  name == "use" || name == "type" ||
  name == "list" || name == "option" || name == "result" ||
  name == "tuple" || name == "future" || name == "stream" ||
  name == "own" || name == "borrow" || name == "async" || name == "static" ||
  name == "bool" || name == "u8" || name == "u16" || name == "u32" || name == "u64" ||
  name == "s8" || name == "s16" || name == "s32" || name == "s64" ||
  name == "f32" || name == "f64" || name == "char" || name == "string"
}

fn wit_tok_is_doc(_ tok: WitToken) -> Bool {
  match tok {
    WTDoc(_) => true,
    _ => false
  }
}

fn wit_peek(tokens: Array[WitToken], pos: Array[Int]) -> WitToken {
  while Array::get(pos, at = 0) < Array::length(tokens) && wit_tok_is_doc(Array::get(tokens, at = Array::get(pos, at = 0))) {
    pos[0] = Array::get(pos, at = 0) + 1
  }
  if Array::get(pos, at = 0) < Array::length(tokens) {
    Array::get(tokens, at = Array::get(pos, at = 0))
  } else {
    WTEof
  }
}

fn wit_tok_is_eof(_ tok: WitToken) -> Bool {
  match tok {
    WTEof => true,
    _ => false
  }
}

fn wit_advance(tokens: Array[WitToken], pos: Array[Int]) -> WitToken {
  let tok = wit_peek(tokens = tokens, pos = pos)
  if not(wit_tok_is_eof(tok)) {
    pos[0] = Array::get(pos, at = 0) + 1
  }
  tok
}

fn wit_match_kw(tokens: Array[WitToken], pos: Array[Int], kw: String) -> Bool {
  if wit_tok_is_kw(tok = wit_peek(tokens = tokens, pos = pos), kw = kw) {
    let _ = wit_advance(tokens = tokens, pos = pos)
    true
  } else {
    false
  }
}

/// wit_expect_kw: (Array[WitToken], Array[Int], String) -> Unit with Exception
fn wit_expect_kw(tokens: Array[WitToken], pos: Array[Int], kw: String) -> Unit with Exception {
  if not(wit_match_kw(tokens = tokens, pos = pos, kw = kw)) {
    throw(String::concat("expected '", String::concat(kw, "'")))
  }
}

fn wit_tok_is_sym(tok: WitToken, sym: String) -> Bool {
  match tok {
    WTSymbol(s) => s == sym,
    _ => false
  }
}

fn wit_match_sym(tokens: Array[WitToken], pos: Array[Int], sym: String) -> Bool {
  if wit_tok_is_sym(tok = wit_peek(tokens = tokens, pos = pos), sym = sym) {
    let _ = wit_advance(tokens = tokens, pos = pos)
    true
  } else {
    false
  }
}

/// wit_expect_sym: (Array[WitToken], Array[Int], String) -> Unit with Exception
fn wit_expect_sym(tokens: Array[WitToken], pos: Array[Int], sym: String) -> Unit with Exception {
  if not(wit_match_sym(tokens = tokens, pos = pos, sym = sym)) {
    throw(String::concat("expected '", String::concat(sym, "'")))
  }
}

/// wit_expect_ident: (Array[WitToken], Array[Int]) -> String with Exception
fn wit_expect_ident(tokens: Array[WitToken], pos: Array[Int]) -> String with Exception {
  match wit_peek(tokens = tokens, pos = pos) {
    WTIdent(s) => {
      let _ = wit_advance(tokens = tokens, pos = pos); s
    },
    _ => {
      throw("expected identifier"); ""
    }
  }
}

/// wit_parse_enum: (Array[WitToken], Array[Int], String, Option[String]) -> WitTypeDef with Exception
fn wit_parse_enum(tokens: Array[WitToken], pos: Array[Int], name: String, docs: Option[String]) -> WitTypeDef with Exception {
  wit_expect_sym(tokens = tokens, pos = pos, sym = "{")
  let cases = ArrayBuilder::new()
  while not(wit_match_sym(tokens = tokens, pos = pos, sym = "}")) {
    ArrayBuilder::push(cases, value = wit_expect_ident(tokens = tokens, pos = pos))
    if not(wit_match_sym(tokens = tokens, pos = pos, sym = ",")) {
      wit_expect_sym(tokens = tokens, pos = pos, sym = "}")
      break
    }
  }
  TDEnum(name, ArrayBuilder::freeze(cases), docs)
}

/// wit_parse_flags: (Array[WitToken], Array[Int], String, Option[String]) -> WitTypeDef with Exception
fn wit_parse_flags(tokens: Array[WitToken], pos: Array[Int], name: String, docs: Option[String]) -> WitTypeDef with Exception {
  wit_expect_sym(tokens = tokens, pos = pos, sym = "{")
  let cases = ArrayBuilder::new()
  while not(wit_match_sym(tokens = tokens, pos = pos, sym = "}")) {
    ArrayBuilder::push(cases, value = wit_expect_ident(tokens = tokens, pos = pos))
    if not(wit_match_sym(tokens = tokens, pos = pos, sym = ",")) {
      wit_expect_sym(tokens = tokens, pos = pos, sym = "}")
      break
    }
  }
  TDFlags(name, ArrayBuilder::freeze(cases), docs)
}

fn wit_is_whitespace(_ c: Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13
}

fn wit_is_ident_start(_ c: Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

/// wit_parse_use_path: (Array[WitToken], Array[Int]) -> (String, String, Option[String], String) with Exception
fn wit_parse_use_path(tokens: Array[WitToken], pos: Array[Int]) -> (String, String, Option[String], String) with Exception {
  let first = wit_expect_ident(tokens = tokens, pos = pos)
  if wit_match_sym(tokens = tokens, pos = pos, sym = ":") {
    let pkg_name = wit_expect_ident(tokens = tokens, pos = pos)
    let mut version: Option[String] = None
    if wit_match_sym(tokens = tokens, pos = pos, sym = "@") {
      let sb = StringBuilder::new()
      match wit_peek(tokens = tokens, pos = pos) {
        WTNumber(n) => {
          let _ = wit_advance(tokens = tokens, pos = pos); let mut k = 0; while k < String::length(n) {
            StringBuilder::push(sb, value = String::from_char_code(String::char_code_at(n, at = k))); k = k + 1
          }
        },
        _ => throw("expected version number")
      }
      version = Some(StringBuilder::freeze(sb))
    }
    wit_expect_sym(tokens = tokens, pos = pos, sym = "/")
    let iface = wit_expect_ident(tokens = tokens, pos = pos)
    (first, pkg_name, version, iface)
  } else {
    ("", "", None, first)
  }
}

/// wit_parse_use_decl: (Array[WitToken], Array[Int]) -> WitInterfaceItem with Exception
fn wit_parse_use_decl(tokens: Array[WitToken], pos: Array[Int]) -> WitInterfaceItem with Exception {
  let (ns, pkg_name, version, iface) = wit_parse_use_path(tokens = tokens, pos = pos)
  wit_expect_sym(tokens = tokens, pos = pos, sym = ".")
  wit_expect_sym(tokens = tokens, pos = pos, sym = "{")
  let names = ArrayBuilder::new()
  while not(wit_match_sym(tokens = tokens, pos = pos, sym = "}")) {
    ArrayBuilder::push(names, value = wit_expect_ident(tokens = tokens, pos = pos))
    if not(wit_match_sym(tokens = tokens, pos = pos, sym = ",")) {
      wit_expect_sym(tokens = tokens, pos = pos, sym = "}")
      break
    }
  }
  wit_expect_sym(tokens = tokens, pos = pos, sym = ";")
  IIUse(ns, pkg_name, version, iface, ArrayBuilder::freeze(names))
}

/// wit_parse_type_expr: (Array[WitToken], Array[Int]) -> WitTypeExpr with Exception
fn wit_parse_type_expr(tokens: Array[WitToken], pos: Array[Int]) -> WitTypeExpr with Exception {
  let tok = wit_peek(tokens = tokens, pos = pos)
  match tok {
    WTKeyword(kw) => if kw == "bool" {
      let _ = wit_advance(tokens = tokens, pos = pos); TyBool
    }
    else if kw == "u8" {
      let _ = wit_advance(tokens = tokens, pos = pos); TyU8
    }
    else if kw == "u16" {
      let _ = wit_advance(tokens = tokens, pos = pos); TyU16
    }
    else if kw == "u32" {
      let _ = wit_advance(tokens = tokens, pos = pos); TyU32
    }
    else if kw == "u64" {
      let _ = wit_advance(tokens = tokens, pos = pos); TyU64
    }
    else if kw == "s8" {
      let _ = wit_advance(tokens = tokens, pos = pos); TyS8
    }
    else if kw == "s16" {
      let _ = wit_advance(tokens = tokens, pos = pos); TyS16
    }
    else if kw == "s32" {
      let _ = wit_advance(tokens = tokens, pos = pos); TyS32
    }
    else if kw == "s64" {
      let _ = wit_advance(tokens = tokens, pos = pos); TyS64
    }
    else if kw == "f32" {
      let _ = wit_advance(tokens = tokens, pos = pos); TyF32
    }
    else if kw == "f64" {
      let _ = wit_advance(tokens = tokens, pos = pos); TyF64
    }
    else if kw == "char" {
      let _ = wit_advance(tokens = tokens, pos = pos); TyChar
    }
    else if kw == "string" {
      let _ = wit_advance(tokens = tokens, pos = pos); TyString
    }
    else if kw == "list" {
      let _ = wit_advance(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = "<")
      let inner = wit_parse_type_expr(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = ">")
      TyList(inner)
    }
    else if kw == "option" {
      let _ = wit_advance(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = "<")
      let inner = wit_parse_type_expr(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = ">")
      TyOption(inner)
    }
    else if kw == "future" {
      let _ = wit_advance(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = "<")
      let inner = wit_parse_type_expr(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = ">")
      TyFuture(inner)
    }
    else if kw == "stream" {
      let _ = wit_advance(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = "<")
      let inner = wit_parse_type_expr(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = ">")
      TyStream(inner)
    }
    else if kw == "result" {
      let _ = wit_advance(tokens = tokens, pos = pos)
      if wit_match_sym(tokens = tokens, pos = pos, sym = "<") {
        let ok_ty = wit_parse_type_expr(tokens = tokens, pos = pos)
        let err_ty = if wit_match_sym(tokens = tokens, pos = pos, sym = ",") {
          Some(wit_parse_type_expr(tokens = tokens, pos = pos))
        } else {
          None
        }
        wit_expect_sym(tokens = tokens, pos = pos, sym = ">")
        TyResult(ok_ty, err_ty)
      } else {
        TyResult(TyTuple(Array::slice([TyBool], start = 0, end = 0)), Some(TyTuple(Array::slice([
          TyBool
        ], start = 0, end = 0))))
      }
    }
    else if kw == "tuple" {
      let _ = wit_advance(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = "<")
      let items = ArrayBuilder::new()
      if not(wit_match_sym(tokens = tokens, pos = pos, sym = ">")) {
        let first = wit_parse_type_expr(tokens = tokens, pos = pos)
        ArrayBuilder::push(items, value = first)
        while wit_match_sym(tokens = tokens, pos = pos, sym = ",") {
          if wit_tok_is_sym(tok = wit_peek(tokens = tokens, pos = pos), sym = ">") {
            break
          }
          ArrayBuilder::push(items, value = wit_parse_type_expr(tokens = tokens, pos = pos))
        }
        wit_expect_sym(tokens = tokens, pos = pos, sym = ">")
      }
      TyTuple(ArrayBuilder::freeze(items))
    }
    else if kw == "own" {
      let _ = wit_advance(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = "<")
      let name = wit_expect_ident(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = ">")
      TyOwn(name)
    }
    else if kw == "borrow" {
      let _ = wit_advance(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = "<")
      let name = wit_expect_ident(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = ">")
      TyBorrow(name)
    }
    else {
      throw(String::concat("unexpected keyword in type: ", kw)); TyBool
    }
    ,
    WTIdent(name) => {
      let _ = wit_advance(tokens = tokens, pos = pos)
      if name == "_" {
        TyTuple(Array::slice([TyBool], start = 0, end = 0))
      } else {
        TyId(name)
      }
    },
    _ => {
      throw("expected type expression"); TyBool
    }
  }
}

/// wit_parse_params: (Array[WitToken], Array[Int]) -> Array[(String, WitTypeExpr)] with Exception
fn wit_parse_params(tokens: Array[WitToken], pos: Array[Int]) -> Array[(String, WitTypeExpr)] with Exception {
  wit_expect_sym(tokens = tokens, pos = pos, sym = "(")
  let params = ArrayBuilder::new()
  if not(wit_match_sym(tokens = tokens, pos = pos, sym = ")")) {
    let name = wit_expect_ident(tokens = tokens, pos = pos)
    wit_expect_sym(tokens = tokens, pos = pos, sym = ":")
    let ty = wit_parse_type_expr(tokens = tokens, pos = pos)
    ArrayBuilder::push(params, value = (name, ty))
    while wit_match_sym(tokens = tokens, pos = pos, sym = ",") {
      if wit_tok_is_sym(tok = wit_peek(tokens = tokens, pos = pos), sym = ")") {
        break
      }
      let n = wit_expect_ident(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = ":")
      let t = wit_parse_type_expr(tokens = tokens, pos = pos)
      ArrayBuilder::push(params, value = (n, t))
    }
    wit_expect_sym(tokens = tokens, pos = pos, sym = ")")
  }
  ArrayBuilder::freeze(params)
}

/// wit_parse_record: (Array[WitToken], Array[Int], String, Option[String]) -> WitTypeDef with Exception
fn wit_parse_record(tokens: Array[WitToken], pos: Array[Int], name: String, docs: Option[String]) -> WitTypeDef with Exception {
  wit_expect_sym(tokens = tokens, pos = pos, sym = "{")
  let fields = ArrayBuilder::new()
  while not(wit_match_sym(tokens = tokens, pos = pos, sym = "}")) {
    let fname = wit_expect_ident(tokens = tokens, pos = pos)
    wit_expect_sym(tokens = tokens, pos = pos, sym = ":")
    let ty = wit_parse_type_expr(tokens = tokens, pos = pos)
    ArrayBuilder::push(fields, value = (fname, ty))
    if not(wit_match_sym(tokens = tokens, pos = pos, sym = ",")) {
      wit_expect_sym(tokens = tokens, pos = pos, sym = "}")
      break
    }
  }
  TDRecord(name, ArrayBuilder::freeze(fields), docs)
}

/// wit_parse_variant: (Array[WitToken], Array[Int], String, Option[String]) -> WitTypeDef with Exception
fn wit_parse_variant(tokens: Array[WitToken], pos: Array[Int], name: String, docs: Option[String]) -> WitTypeDef with Exception {
  wit_expect_sym(tokens = tokens, pos = pos, sym = "{")
  let cases = ArrayBuilder::new()
  while not(wit_match_sym(tokens = tokens, pos = pos, sym = "}")) {
    let cname = wit_expect_ident(tokens = tokens, pos = pos)
    let payload = if wit_match_sym(tokens = tokens, pos = pos, sym = "(") {
      let ty = wit_parse_type_expr(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = ")")
      Some(ty)
    } else {
      None
    }
    ArrayBuilder::push(cases, value = (cname, payload))
    if not(wit_match_sym(tokens = tokens, pos = pos, sym = ",")) {
      wit_expect_sym(tokens = tokens, pos = pos, sym = "}")
      break
    }
  }
  TDVariant(name, ArrayBuilder::freeze(cases), docs)
}

/// wit_parse_function: (Array[WitToken], Array[Int], WitFuncKind, Option[String]) -> (String, WitFuncKind, Bool, Array[(String, WitTypeExpr)], Option[WitTypeExpr], Option[String]) with Exception
///
/// The `Bool` is the `async` marker. It used to be matched and DISCARDED
/// (`let _ = wit_match_kw(..., "async")`), so `f: async func() -> future<s64>`
/// and `f: func() -> future<s64>` parsed to the same item and a caller could
/// not tell them apart (#2064). Asking "does it return a future?" instead is
/// not the same question -- WIT lets a plain `func` return `future<T>`, and
/// lets an `async func` return something else -- so recovering the marker
/// from the result type classifies by SHAPE where the source made a
/// DECLARATION, which is the habit #1963 exists to remove.
fn wit_parse_function(tokens: Array[WitToken], pos: Array[Int], kind: WitFuncKind, docs: Option[String]) -> (String, WitFuncKind, Bool, Array[(String, WitTypeExpr)], Option[WitTypeExpr], Option[String]) with Exception {
  let name = wit_expect_ident(tokens = tokens, pos = pos)
  wit_expect_sym(tokens = tokens, pos = pos, sym = ":")
  let is_async = wit_match_kw(tokens = tokens, pos = pos, kw = "async")
  wit_expect_kw(tokens = tokens, pos = pos, kw = "func")
  let params = wit_parse_params(tokens = tokens, pos = pos)
  let result = if wit_match_sym(tokens = tokens, pos = pos, sym = "->") {
    Some(wit_parse_type_expr(tokens = tokens, pos = pos))
  } else {
    None
  }
  wit_expect_sym(tokens = tokens, pos = pos, sym = ";")
  (name, kind, is_async, params, result, docs)
}

/// wit_parse_resource: (Array[WitToken], Array[Int], String, Option[String]) -> WitTypeDef with Exception
fn wit_parse_resource(tokens: Array[WitToken], pos: Array[Int], name: String, docs: Option[String]) -> WitTypeDef with Exception {
  if wit_match_sym(tokens = tokens, pos = pos, sym = ";") {
    TDResource(name, Array::slice([
      ("", FKFreestanding, false, Array::slice([("", TyBool)], start = 0, end = 0), None, None)
    ], start = 0, end = 0), docs)
  } else {
    wit_expect_sym(tokens = tokens, pos = pos, sym = "{")
    let funcs = ArrayBuilder::new()
    while not(wit_match_sym(tokens = tokens, pos = pos, sym = "}")) {
      let fdocs = wit_take_docs(tokens = tokens, pos = pos)
      if wit_match_kw(tokens = tokens, pos = pos, kw = "constructor") {
        let params = wit_parse_params(tokens = tokens, pos = pos)
        let result = if wit_match_sym(tokens = tokens, pos = pos, sym = "->") {
          Some(wit_parse_type_expr(tokens = tokens, pos = pos))
        } else {
          None
        }
        wit_expect_sym(tokens = tokens, pos = pos, sym = ";")
        ArrayBuilder::push(funcs, value = ("constructor", FKConstructor(name), false, params, result, fdocs))
      } else {
        let fname = wit_expect_ident(tokens = tokens, pos = pos)
        wit_expect_sym(tokens = tokens, pos = pos, sym = ":")
        // ORDER MATTERS, and this site had it backwards. WIT spells a static
        // method `id ':' 'static' func-type`, with `async` belonging to the
        // func-type -- so `static` comes FIRST. Matching `async` first made
        // the parser reject the VALID `f: static async func()` (`expected
        // 'func'`, because `async` was still unconsumed) while ACCEPTING the
        // invalid `f: async static func()`. Measured both ways; Codex on
        // #2961 caught it.
        let is_static = wit_match_kw(tokens = tokens, pos = pos, kw = "static")
        // Kept, not dropped -- see wit_parse_function. A resource METHOD may
        // be async too, and wasi:http's client surface is written that way.
        let method_is_async = wit_match_kw(tokens = tokens, pos = pos, kw = "async")
        if method_is_async && not(is_static) && wit_match_kw(tokens = tokens, pos = pos, kw = "static") {
          // The reversed order, refused by name rather than as a bare
          // `expected 'func'` three tokens later.
          throw("in resource function '\{fname}': write `static async func`, not `async static func` -- WIT puts `static` before the function type, and `async` is part of that type")
        } else {
          ()
        }
        wit_expect_kw(tokens = tokens, pos = pos, kw = "func")
        let params = wit_parse_params(tokens = tokens, pos = pos)
        let result = if wit_match_sym(tokens = tokens, pos = pos, sym = "->") {
          Some(wit_parse_type_expr(tokens = tokens, pos = pos))
        } else {
          None
        }
        wit_expect_sym(tokens = tokens, pos = pos, sym = ";")
        let kind = if is_static {
          FKStatic(name)
        } else {
          FKMethod(name)
        }
        ArrayBuilder::push(funcs, value = (fname, kind, method_is_async, params, result, fdocs))
      }
    }
    TDResource(name, ArrayBuilder::freeze(funcs), docs)
  }
}

/// wit_parse_type_alias: (Array[WitToken], Array[Int], String, Option[String]) -> WitTypeDef with Exception
fn wit_parse_type_alias(tokens: Array[WitToken], pos: Array[Int], name: String, docs: Option[String]) -> WitTypeDef with Exception {
  wit_expect_sym(tokens = tokens, pos = pos, sym = "=")
  let ty = wit_parse_type_expr(tokens = tokens, pos = pos)
  wit_expect_sym(tokens = tokens, pos = pos, sym = ";")
  TDAlias(name, ty, docs)
}

fn wit_is_ident_continue(_ c: Int) -> Bool {
  wit_is_ident_start(c) || (c >= 48 && c <= 57) || c == 45
}

/// wit_tokenize: (String) -> Array[WitToken] with Exception
export fn wit_tokenize(_ src: String) -> Array[WitToken] with Exception {
  let len = String::length(src)
  let tokens = ArrayBuilder::new()
  let mut i = 0
  while i < len {
    let c = String::char_code_at(src, at = i)
    if wit_is_whitespace(c) {
      i = i + 1
    } else if c == 47 && (i + 1) < len && String::char_code_at(src, at = i + 1) == 47 {
      i = i + 2
      if i < len && String::char_code_at(src, at = i) == 47 {
        i = i + 1
      }
      let sb = StringBuilder::new()
      while i < len && String::char_code_at(src, at = i) != 10 {
        StringBuilder::push(sb, value = String::from_char_code(String::char_code_at(src, at = i)))
        i = i + 1
      }
      let text = String::trim(StringBuilder::freeze(sb))
      ArrayBuilder::push(tokens, value = WTDoc(text))
    } else if c == 37 {
      i = i + 1
      if i < len && wit_is_ident_start(String::char_code_at(src, at = i)) {
        let sb = StringBuilder::new()
        while i < len && wit_is_ident_continue(String::char_code_at(src, at = i)) {
          StringBuilder::push(sb, value = String::from_char_code(String::char_code_at(src, at = i)))
          i = i + 1
        }
        ArrayBuilder::push(tokens, value = WTIdent(StringBuilder::freeze(sb)))
      } else {
        throw("expected identifier after %")
      }
    } else if wit_is_ident_start(c) {
      let sb = StringBuilder::new()
      while i < len && wit_is_ident_continue(String::char_code_at(src, at = i)) {
        StringBuilder::push(sb, value = String::from_char_code(String::char_code_at(src, at = i)))
        i = i + 1
      }
      let name = StringBuilder::freeze(sb)
      if wit_is_keyword(name) {
        ArrayBuilder::push(tokens, value = WTKeyword(name))
      } else {
        ArrayBuilder::push(tokens, value = WTIdent(name))
      }
    } else if wit_is_digit(c) {
      let sb = StringBuilder::new()
      while i < len && wit_is_digit(String::char_code_at(src, at = i)) {
        StringBuilder::push(sb, value = String::from_char_code(String::char_code_at(src, at = i)))
        i = i + 1
      }
      while i < len && String::char_code_at(src, at = i) == 46 && (i + 1) < len && wit_is_digit(String::char_code_at(src, at = i + 1)) {
        StringBuilder::push(sb, value = ".")
        i = i + 1
        while i < len && wit_is_digit(String::char_code_at(src, at = i)) {
          StringBuilder::push(sb, value = String::from_char_code(String::char_code_at(src, at = i)))
          i = i + 1
        }
      }
      ArrayBuilder::push(tokens, value = WTNumber(StringBuilder::freeze(sb)))
    } else if c == 34 {
      i = i + 1
      let sb = StringBuilder::new()
      while i < len && String::char_code_at(src, at = i) != 34 {
        if String::char_code_at(src, at = i) == 92 {
          i = i + 1
          if i >= len {
            throw("unterminated escape")
          }
          let esc = String::char_code_at(src, at = i)
          if esc == 110 {
            StringBuilder::push(sb, value = String::from_char_code(10))
          }
          else if esc == 116 {
            StringBuilder::push(sb, value = String::from_char_code(9))
          }
          else if esc == 114 {
            StringBuilder::push(sb, value = String::from_char_code(13))
          }
          else if esc == 34 {
            StringBuilder::push(sb, value = String::from_char_code(34))
          }
          else if esc == 92 {
            StringBuilder::push(sb, value = String::from_char_code(92))
          }
          else {
            StringBuilder::push(sb, value = String::from_char_code(esc))
          }
          i = i + 1
        } else {
          StringBuilder::push(sb, value = String::from_char_code(String::char_code_at(src, at = i)))
          i = i + 1
        }
      }
      if i >= len {
        throw("unterminated string")
      }
      i = i + 1
      ArrayBuilder::push(tokens, value = WTStringLit(StringBuilder::freeze(sb)))
    } else if c == 45 && (i + 1) < len && String::char_code_at(src, at = i + 1) == 62 {
      ArrayBuilder::push(tokens, value = WTSymbol("->"))
      i = i + 2
    } else {
      let sym = if c == 123 {
        "{"
      }
      else if c == 125 {
        "}"
      }
      else if c == 40 {
        "("
      }
      else if c == 41 {
        ")"
      }
      else if c == 60 {
        "<"
      }
      else if c == 62 {
        ">"
      }
      else if c == 58 {
        ":"
      }
      else if c == 59 {
        ";"
      }
      else if c == 44 {
        ","
      }
      else if c == 46 {
        "."
      }
      else if c == 47 {
        "/"
      }
      else if c == 64 {
        "@"
      }
      else if c == 61 {
        "="
      }
      else if c == 43 {
        "+"
      }
      else if c == 45 {
        "-"
      }
      else {
        ""
      }
      if sym == "" {
        throw("unexpected character")
      }
      ArrayBuilder::push(tokens, value = WTSymbol(sym))
      i = i + 1
    }
  }
  ArrayBuilder::push(tokens, value = WTEof)
  ArrayBuilder::freeze(tokens)
}

/// wit_parse_interface_items: (Array[WitToken], Array[Int]) -> Array[WitInterfaceItem] with Exception
fn wit_parse_interface_items(tokens: Array[WitToken], pos: Array[Int]) -> Array[WitInterfaceItem] with Exception {
  wit_expect_sym(tokens = tokens, pos = pos, sym = "{")
  let items = ArrayBuilder::new()
  while not(wit_match_sym(tokens = tokens, pos = pos, sym = "}")) {
    let docs = wit_take_docs(tokens = tokens, pos = pos)
    if wit_match_kw(tokens = tokens, pos = pos, kw = "use") {
      ArrayBuilder::push(items, value = wit_parse_use_decl(tokens = tokens, pos = pos))
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "record") {
      let name = wit_expect_ident(tokens = tokens, pos = pos)
      ArrayBuilder::push(items, value = IITypeDef(wit_parse_record(tokens = tokens, pos = pos, name = name, docs = docs)))
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "enum") {
      let name = wit_expect_ident(tokens = tokens, pos = pos)
      ArrayBuilder::push(items, value = IITypeDef(wit_parse_enum(tokens = tokens, pos = pos, name = name, docs = docs)))
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "flags") {
      let name = wit_expect_ident(tokens = tokens, pos = pos)
      ArrayBuilder::push(items, value = IITypeDef(wit_parse_flags(tokens = tokens, pos = pos, name = name, docs = docs)))
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "variant") {
      let name = wit_expect_ident(tokens = tokens, pos = pos)
      ArrayBuilder::push(items, value = IITypeDef(wit_parse_variant(tokens = tokens, pos = pos, name = name, docs = docs)))
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "resource") {
      let name = wit_expect_ident(tokens = tokens, pos = pos)
      ArrayBuilder::push(items, value = IITypeDef(wit_parse_resource(tokens = tokens, pos = pos, name = name, docs = docs)))
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "type") {
      let name = wit_expect_ident(tokens = tokens, pos = pos)
      ArrayBuilder::push(items, value = IITypeDef(wit_parse_type_alias(tokens = tokens, pos = pos, name = name, docs = docs)))
    } else {
      let (fname, kind, fn_is_async, params, result, _) = wit_parse_function(tokens = tokens, pos = pos, kind = FKFreestanding, docs = docs)
      ArrayBuilder::push(items, value = IIFunction(fname, kind, fn_is_async, params, result, docs))
    }
  }
  ArrayBuilder::freeze(items)
}

/// wit_parse_world: (Array[WitToken], Array[Int], Option[String]) -> (String, Option[String], Array[WitTypeDef], Array[WitWorldItem], Array[WitWorldItem]) with Exception
fn wit_parse_world(tokens: Array[WitToken], pos: Array[Int], docs: Option[String]) -> (String, Option[String], Array[WitTypeDef], Array[WitWorldItem], Array[WitWorldItem]) with Exception {
  let name = wit_expect_ident(tokens = tokens, pos = pos)
  wit_expect_sym(tokens = tokens, pos = pos, sym = "{")
  let types = ArrayBuilder::new()
  let imports = ArrayBuilder::new()
  let exports = ArrayBuilder::new()
  while not(wit_match_sym(tokens = tokens, pos = pos, sym = "}")) {
    let item_docs = wit_take_docs(tokens = tokens, pos = pos)
    if wit_match_kw(tokens = tokens, pos = pos, kw = "record") {
      let tname = wit_expect_ident(tokens = tokens, pos = pos)
      ArrayBuilder::push(types, value = wit_parse_record(tokens = tokens, pos = pos, name = tname, docs = item_docs))
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "enum") {
      let tname = wit_expect_ident(tokens = tokens, pos = pos)
      ArrayBuilder::push(types, value = wit_parse_enum(tokens = tokens, pos = pos, name = tname, docs = item_docs))
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "flags") {
      let tname = wit_expect_ident(tokens = tokens, pos = pos)
      ArrayBuilder::push(types, value = wit_parse_flags(tokens = tokens, pos = pos, name = tname, docs = item_docs))
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "variant") {
      let tname = wit_expect_ident(tokens = tokens, pos = pos)
      ArrayBuilder::push(types, value = wit_parse_variant(tokens = tokens, pos = pos, name = tname, docs = item_docs))
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "resource") {
      let tname = wit_expect_ident(tokens = tokens, pos = pos)
      ArrayBuilder::push(types, value = wit_parse_resource(tokens = tokens, pos = pos, name = tname, docs = item_docs))
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "type") {
      let tname = wit_expect_ident(tokens = tokens, pos = pos)
      ArrayBuilder::push(types, value = wit_parse_type_alias(tokens = tokens, pos = pos, name = tname, docs = item_docs))
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "import") {
      match wit_peek(tokens = tokens, pos = pos) {
        WTIdent(_) => {
          let iname = wit_expect_ident(tokens = tokens, pos = pos)
          if wit_match_sym(tokens = tokens, pos = pos, sym = ":") {
            // A world function may be `async func`, and this site did not
            // match the keyword at all -- so `import x: async func(..)` was a
            // PARSE ERROR ("expected 'func' or 'interface' after ':'"), not a
            // dropped marker. That is the exact spelling #2064 needs for a
            // program to declare a WIT-derived async import.
            let fn_is_async = wit_match_kw(tokens = tokens, pos = pos, kw = "async")
            if wit_match_kw(tokens = tokens, pos = pos, kw = "func") {
              let params = wit_parse_params(tokens = tokens, pos = pos)
              let result = if wit_match_sym(tokens = tokens, pos = pos, sym = "->") {
                Some(wit_parse_type_expr(tokens = tokens, pos = pos))
              } else {
                None
              }
              wit_expect_sym(tokens = tokens, pos = pos, sym = ";")
              ArrayBuilder::push(imports, value = WIFunction(iname, FKFreestanding, fn_is_async, params, result, item_docs))
            } else if fn_is_async {
              // `async interface` is not a thing. Refuse rather than fall
              // through to the interface arm, which would accept it and drop
              // the marker -- the failure this whole change is about.
              throw("expected 'func' after 'async' in world item '\{iname}': only a function can be async -- write `\{iname}: async func(..)`, or drop `async` to declare an interface")
            } else if wit_match_kw(tokens = tokens, pos = pos, kw = "interface") {
              let items = wit_parse_interface_items(tokens = tokens, pos = pos)
              ArrayBuilder::push(imports, value = WIInlineInterface(iname, item_docs, items))
            } else {
              throw("expected 'func' or 'interface' after ':'")
            }
          } else {
            wit_expect_sym(tokens = tokens, pos = pos, sym = ";")
            ArrayBuilder::push(imports, value = WIInterface("", "", None, iname))
          }
        },
        _ => throw("expected import item")
      }
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "export") {
      match wit_peek(tokens = tokens, pos = pos) {
        WTIdent(_) => {
          let iname = wit_expect_ident(tokens = tokens, pos = pos)
          if wit_match_sym(tokens = tokens, pos = pos, sym = ":") {
            // A world function may be `async func`, and this site did not
            // match the keyword at all -- so `export x: async func(..)` was a
            // PARSE ERROR ("expected 'func' or 'interface' after ':'"), not a
            // dropped marker. That is the exact spelling #2064 needs for a
            // program to declare a WIT-derived async import.
            let fn_is_async = wit_match_kw(tokens = tokens, pos = pos, kw = "async")
            if wit_match_kw(tokens = tokens, pos = pos, kw = "func") {
              let params = wit_parse_params(tokens = tokens, pos = pos)
              let result = if wit_match_sym(tokens = tokens, pos = pos, sym = "->") {
                Some(wit_parse_type_expr(tokens = tokens, pos = pos))
              } else {
                None
              }
              wit_expect_sym(tokens = tokens, pos = pos, sym = ";")
              ArrayBuilder::push(exports, value = WIFunction(iname, FKFreestanding, fn_is_async, params, result, item_docs))
            } else if fn_is_async {
              // `async interface` is not a thing. Refuse rather than fall
              // through to the interface arm, which would accept it and drop
              // the marker -- the failure this whole change is about.
              throw("expected 'func' after 'async' in world item '\{iname}': only a function can be async -- write `\{iname}: async func(..)`, or drop `async` to declare an interface")
            } else if wit_match_kw(tokens = tokens, pos = pos, kw = "interface") {
              let items = wit_parse_interface_items(tokens = tokens, pos = pos)
              ArrayBuilder::push(exports, value = WIInlineInterface(iname, item_docs, items))
            } else {
              throw("expected 'func' or 'interface' after ':'")
            }
          } else {
            wit_expect_sym(tokens = tokens, pos = pos, sym = ";")
            ArrayBuilder::push(exports, value = WIInterface("", "", None, iname))
          }
        },
        _ => throw("expected export item")
      }
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "include") {
      let (ns, pkg, ver, iface) = wit_parse_use_path(tokens = tokens, pos = pos)
      let renames = ArrayBuilder::new()
      if wit_match_kw(tokens = tokens, pos = pos, kw = "with") {
        wit_expect_sym(tokens = tokens, pos = pos, sym = "{")
        while not(wit_match_sym(tokens = tokens, pos = pos, sym = "}")) {
          let from_name = wit_expect_ident(tokens = tokens, pos = pos)
          wit_expect_kw(tokens = tokens, pos = pos, kw = "as")
          let to_name = wit_expect_ident(tokens = tokens, pos = pos)
          ArrayBuilder::push(renames, value = (from_name, to_name))
          if not(wit_match_sym(tokens = tokens, pos = pos, sym = ",")) {
            wit_expect_sym(tokens = tokens, pos = pos, sym = "}")
            break
          }
        }
      }
      wit_expect_sym(tokens = tokens, pos = pos, sym = ";")
      ArrayBuilder::push(imports, value = WIInclude(ns, pkg, ver, iface, ArrayBuilder::freeze(renames)))
    } else {
      throw("unexpected world item")
    }
  }
  (name, docs, ArrayBuilder::freeze(types), ArrayBuilder::freeze(imports), ArrayBuilder::freeze(exports))
}

/// wit_parse: (String) -> (Option[(String, String, Option[String])], Array[(String, Option[String], Array[WitInterfaceItem])], Array[(String, Option[String], Array[WitTypeDef], Array[WitWorldItem], Array[WitWorldItem])]) with Exception
export fn wit_parse(_ source: String) -> (Option[(String, String, Option[String])], Array[(String, Option[String], Array[WitInterfaceItem])], Array[(String, Option[String], Array[WitTypeDef], Array[WitWorldItem], Array[WitWorldItem])]) with Exception {
  let tokens = wit_tokenize(source)
  let pos = [0]
  let mut pkg: Option[(String, String, Option[String])] = None
  let interfaces = ArrayBuilder::new()
  let worlds = ArrayBuilder::new()
  while not(wit_tok_is_eof(wit_peek(tokens = tokens, pos = pos))) {
    let docs = wit_take_docs(tokens = tokens, pos = pos)
    if wit_match_kw(tokens = tokens, pos = pos, kw = "package") {
      let ns = wit_expect_ident(tokens = tokens, pos = pos)
      wit_expect_sym(tokens = tokens, pos = pos, sym = ":")
      let name = wit_expect_ident(tokens = tokens, pos = pos)
      let mut version: Option[String] = None
      if wit_match_sym(tokens = tokens, pos = pos, sym = "@") {
        match wit_peek(tokens = tokens, pos = pos) {
          WTNumber(n) => {
            let _ = wit_advance(tokens = tokens, pos = pos); version = Some(n)
          },
          _ => throw("expected version")
        }
      }
      wit_expect_sym(tokens = tokens, pos = pos, sym = ";")
      pkg = Some((ns, name, version))
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "interface") {
      let name = wit_expect_ident(tokens = tokens, pos = pos)
      let items = wit_parse_interface_items(tokens = tokens, pos = pos)
      ArrayBuilder::push(interfaces, value = (name, docs, items))
    } else if wit_match_kw(tokens = tokens, pos = pos, kw = "world") {
      let w = wit_parse_world(tokens = tokens, pos = pos, docs = docs)
      ArrayBuilder::push(worlds, value = w)
    } else {
      throw("unexpected top-level item")
    }
  }
  (pkg, ArrayBuilder::freeze(interfaces), ArrayBuilder::freeze(worlds))
}

