//# The inverse projection: WIT types -> vibe (ADR-0113 §7, #2064)
//
// `wit_gen` (lib/@vibe/compiler/wit_gen.vibe) projects a vibe signature onto
// WIT. A package that is not vibe arrives as WIT, and `vibe add` derives its
// vibe contract by the exact inverse of that mapping. This file is the
// type-level half of that inverse: a parsed `WitTypeExpr` to the vibe type
// spelling a contract would carry, and a function signature to its `fn`
// declaration.
//
// The admitted subset is the bijection in component-build-convention.md §2,
// read backwards. Everything outside it is REFUSED here, naming the type (and
// the function, from `from_wit_func`), because an unusable package must be
// refused when it is added, not when it is called:
//
//   - an integer other than `s64`, `s32` and `u32`, and `f32`: `s64` is the
//     boundary spelling of `Int`, `s32` / `u32` are `Int32` / `UInt32`
//     (#3730), and there is one `Double`. `s8` / `u8` / `s16` / `u16` stay
//     refused here although a component `.wasm` import offers them as
//     `Int32` / `UInt32` (#3826): there the runner refuses an argument
//     outside the narrow range at the call, while a contract derived here is
//     lowered by the canonical ABI, which would truncate one (300 as a `u8`
//     is 44) with nothing checking it;
//   - `u8` outside `list<u8>`;
//   - `borrow<..>`: a borrowed handle has no vibe value to stand for it;
//   - a `stream` of anything but `u8`, and a `result` with no error type.
//
// Two readings are CHOICES rather than inverses, both recorded in §7:
// `list<tuple<string, V>>` stays `Array[(String, V)]` (a foreign author did
// not write a map, and duplicate keys are legal in the list), and a
// function's own `result<T, E>` becomes `-> T with Exception[E]` -- inside
// vibe, failure belongs in the row (#1324). A `result` nested inside another
// type has no row to move to and stays the explicit `Result[T, E]` of
// `@vibe/wit_runtime`.

import ./wit_parser.vibe {
  FKConstructor,
  FKFreestanding,
  FKMethod,
  FKStatic,
  IIFunction,
  IITypeDef,
  IIUse,
  TDAlias,
  TDEnum,
  TDFlags,
  TDRecord,
  TDResource,
  TDVariant,
  TyBool,
  TyBorrow,
  TyChar,
  TyF32,
  TyF64,
  TyFuture,
  TyId,
  TyList,
  TyOption,
  TyOwn,
  TyResult,
  TyS16,
  TyS32,
  TyS64,
  TyS8,
  TyStream,
  TyString,
  TyTuple,
  TyU16,
  TyU32,
  TyU64,
  TyU8,
  WitInterfaceItem,
  WitTypeDef,
  WitTypeExpr,
  wit_parse
}

/// The vibe type spelling of a WIT type, or a refusal naming it.
export fn from_wit_type(_ t: WitTypeExpr) -> String with Exception {
  fw_type(t = t, ctx = "")
}

/// The vibe declaration of a WIT function:
/// `name: async func(x: s64) -> result<string, string>` becomes
/// `fn name(x: Int) -> String with Exception[String] + Async`.
/// A refusal names the function as well as the type.
export fn from_wit_func(name: String, is_async: Bool, params: Array[(String, WitTypeExpr)], result: Option[WitTypeExpr]) -> String with Exception {
  fw_signature(spelled = fw_ident(name = fw_snake(name), ctx = " (in `\{name}`)"), is_async = is_async, params = params, result = result, ctx_name = name)
}

/// `fn <spelled>(..) -> ..`, refusals naming `ctx_name`.
fn fw_signature(spelled: String, is_async: Bool, params: Array[(String, WitTypeExpr)], result: Option[WitTypeExpr], ctx_name: String) -> String with Exception {
  let ctx = " (in `\{ctx_name}`)"
  let sb = StringBuilder::new()
  StringBuilder::push(sb, value = "fn ")
  StringBuilder::push(sb, value = spelled)
  StringBuilder::push(sb, value = "(")
  let mut i = 0
  while i < Array::length(params) {
    let (pname, pty) = Array::get(params, at = i)
    if i > 0 {
      StringBuilder::push(sb, value = ", ")
    } else {
      ()
    }
    StringBuilder::push(sb, value = fw_ident(name = fw_snake(pname), ctx = ctx))
    StringBuilder::push(sb, value = ": ")
    StringBuilder::push(sb, value = fw_type(t = pty, ctx = ctx))
    i = i + 1
  }
  StringBuilder::push(sb, value = ") -> ")
  let rows: Array[String] = []
  match result {
    Some(TyResult(ok, err)) => match err {
      Some(e) => {
        // `result<_, E>`: the parser reads `_` as the empty tuple. As a
        // function's own result it is just "no value", i.e. `Unit`.
        let ok_text = match ok {
          TyTuple(items) => if Array::length(items) == 0 {
            "Unit"
          } else {
            fw_type(t = ok, ctx = ctx)
          },
          _ => fw_type(t = ok, ctx = ctx)
        }
        StringBuilder::push(sb, value = ok_text)
        Array::push(rows, value = "Exception[\{fw_type(t = e, ctx = ctx)}]")
      },
      None => throw(fw_refusal(what = "result<..> with no error type", ctx = ctx))
    },
    Some(other) => StringBuilder::push(sb, value = fw_type(t = other, ctx = ctx)),
    None => StringBuilder::push(sb, value = "Unit")
  }
  if is_async {
    Array::push(rows, value = "Async")
  } else {
    ()
  }
  if Array::length(rows) > 0 {
    StringBuilder::push(sb, value = " with ")
    StringBuilder::push(sb, value = String::join(rows, sep = " + "))
  } else {
    ()
  }
  StringBuilder::freeze(sb)
}

/// The vibe declaration(s) of a WIT type definition (§7):
///
/// - `record` -> `export struct`, fields in order;
/// - `enum` -> a payload-less `export enum`;
/// - `variant` -> `export enum` with payloads, a `tuple<..>` payload read back
///   as that many payloads (the inverse of §2's `B(U, V)` -> `b(tuple<u, v>)`);
/// - `type x = ..` -> `type X = ..`;
/// - `resource` -> an `opaque type` plus its functions taking the handle
///   first, and an explicit `drop`: a resource handle is not a vibe heap
///   value, so RC does not free it and the consumer has to;
/// - `flags` is refused (no vibe mapping, §7).
export fn from_wit_typedef(_ typedef: WitTypeDef) -> String with Exception {
  match typedef {
    TDRecord(name, fields, _) => {
      let ctx = " (in record `\{name}`)"
      let lines: Array[String] = []
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fty) = Array::get(fields, at = i)
        Array::push(lines, value = "  \{fw_ident(name = fw_snake(fname), ctx = ctx)}: \{fw_type(t = fty, ctx = ctx)}")
        i = i + 1
      }
      "export struct \{fw_type_name(name)} {\n\{String::join(lines, sep = ";\n")}\n}"
    },
    TDEnum(name, cases, _) => {
      let parts: Array[String] = []
      let mut i = 0
      while i < Array::length(cases) {
        Array::push(parts, value = "  \{fw_case_name(case = Array::get(cases, at = i), ctx = " (in enum `\{name}`)")}")
        i = i + 1
      }
      "export enum \{fw_type_name(name)} {\n\{String::join(parts, sep = ";\n")}\n}"
    },
    TDVariant(name, cases, _) => {
      let ctx = " (in variant `\{name}`)"
      let parts: Array[String] = []
      let mut i = 0
      while i < Array::length(cases) {
        let (cname, payload) = Array::get(cases, at = i)
        let head = fw_case_name(case = cname, ctx = ctx)
        Array::push(parts, value = match payload {
          Some(TyTuple(items)) => {
            if Array::length(items) == 1 {
              // `c(tuple<T>)` would read back as `C(T)`, which projects to
              // `c(T)`: a different ABI shape (Codex on #3059), like the
              // one-element tuple `fw_type` refuses.
              throw(fw_refusal(what = "tuple<..> with one element", ctx = ctx))
            } else {
              ()
            }
            let tys: Array[String] = []
            let mut k = 0
            while k < Array::length(items) {
              Array::push(tys, value = fw_type(t = Array::get(items, at = k), ctx = ctx))
              k = k + 1
            }
            "  \{head}(\{String::join(tys, sep = ", ")})"
          },
          Some(t) => "  \{head}(\{fw_type(t = t, ctx = ctx)})",
          None => "  \{head}"
        })
        i = i + 1
      }
      "export enum \{fw_type_name(name)} {\n\{String::join(parts, sep = ";\n")}\n}"
    },
    TDAlias(name, t, _) => "type \{fw_type_name(name)} = \{fw_type(t = t, ctx = " (in type `\{name}`)")}",
    TDFlags(name, _, _) => throw(fw_refusal(what = "flags \{name}", ctx = "")),
    TDResource(name, funcs, _) => {
      let ty = fw_type_name(name)
      // The explicit release is spelled `drop` (§7); a resource whose own
      // interface already has a `drop` would declare it twice (Codex on
      // #3059), so it is refused rather than silently renamed.
      let mut fi = 0
      while fi < Array::length(funcs) {
        let (fname, _, _, _, _, _) = Array::get(funcs, at = fi)
        if fname == "drop" {
          throw(fw_refusal(what = "resource `\{name}` declaring its own `drop` (the derived handle release is `\{ty}::drop`)", ctx = ""))
        } else {
          ()
        }
        fi = fi + 1
      }
      // The constructor is spelled `new`; a function of that name beside a
      // constructor would declare `\{ty}::new` twice (Codex on #3059).
      let mut has_ctor = false
      let mut has_new = false
      let mut ci = 0
      while ci < Array::length(funcs) {
        let (fname, kind, _, _, _, _) = Array::get(funcs, at = ci)
        match kind {
          FKConstructor(_) => {
            has_ctor = true
          },
          _ => if fw_snake(fname) == "new" {
            has_new = true
          } else {
            ()
          }
        }
        ci = ci + 1
      }
      if has_ctor && has_new {
        throw(fw_refusal(what = "resource `\{name}` declaring both a constructor and a function named `new` (the derived constructor is `\{ty}::new`)", ctx = ""))
      } else {
        ()
      }
      let out: Array[String] = ["opaque type \{ty}"]
      let mut i = 0
      while i < Array::length(funcs) {
        let (fname, kind, is_async, params, result, _) = Array::get(funcs, at = i)
        let res_ctx = " (in resource `\{name}`)"
        let method_name = fw_ident(name = fw_snake(fname), ctx = res_ctx)
        let qualified = "\{ty}::\{method_name}"
        let decl = match kind {
          FKConstructor(_) => fw_signature(spelled = "\{ty}::new", is_async = is_async, params = params, result = Some(TyOwn(name)), ctx_name = qualified),
          FKMethod(_) => {
            // The receiver is spelled `self`; a method whose own parameter is
            // also `self` would declare it twice (Codex on #3059).
            let mut sp = 0
            while sp < Array::length(params) {
              if fw_snake(Array::get(params, at = sp).0) == "self" {
                throw(fw_refusal(what = "method `\{fname}` with a parameter named `self` (the receiver is `self`)", ctx = res_ctx))
              } else {
                ()
              }
              sp = sp + 1
            }
            let with_self: Array[(String, WitTypeExpr)] = [
              ("self", TyOwn(name))
            ]
            let mut p = 0
            while p < Array::length(params) {
              Array::push(with_self, value = Array::get(params, at = p))
              p = p + 1
            }
            fw_signature(spelled = qualified, is_async = is_async, params = with_self, result = result, ctx_name = qualified)
          },
          FKStatic(_) => fw_signature(spelled = qualified, is_async = is_async, params = params, result = result, ctx_name = qualified),
          FKFreestanding => fw_signature(spelled = qualified, is_async = is_async, params = params, result = result, ctx_name = qualified)
        }
        Array::push(out, value = decl)
        i = i + 1
      }
      Array::push(out, value = "fn \{ty}::drop(self: \{ty}) -> Unit")
      String::join(out, sep = "\n")
    }
  }
}

/// Method-style spelling of `from_wit_type`.
export fn WitTypeExpr::from_wit_type(_ recv: WitTypeExpr) -> String with Exception {
  from_wit_type(recv)
}

/// Method-style spelling of `from_wit_typedef`.
export fn WitTypeDef::from_wit_typedef(_ recv: WitTypeDef) -> String with Exception {
  from_wit_typedef(recv)
}

/// Every type definition of one interface, in order, as one declaration block.
///
/// WIT scopes a case name by its type, so `enum a { ok }` and `enum b { ok }`
/// may sit side by side; vibe constructors share one namespace, so both would
/// become `Ok` and the contract would fail to check (Codex on #3059). The
/// collision is refused here, naming both types, rather than renamed -- a
/// renamed constructor would no longer be the name the interface publishes.
export fn from_wit_typedefs(_ defs: Array[WitTypeDef]) -> String with Exception {
  let seen_ctor: Array[String] = []
  let seen_owner: Array[String] = []
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(defs) {
    let def = Array::get(defs, at = i)
    let (owner, cases) = match def {
      TDEnum(name, cs, _) => (name, cs),
      TDVariant(name, cs, _) => {
        let names: Array[String] = []
        let mut k = 0
        while k < Array::length(cs) {
          Array::push(names, value = Array::get(cs, at = k).0)
          k = k + 1
        }
        (name, names)
      },
      _ => ("", [])
    }
    let mut c = 0
    while c < Array::length(cases) {
      let ctor = fw_pascal(Array::get(cases, at = c))
      let mut j = 0
      while j < Array::length(seen_ctor) {
        if Array::get(seen_ctor, at = j) == ctor {
          let first = Array::get(seen_owner, at = j)
          throw(fw_refusal(what = "case `\{Array::get(cases, at = c)}` in both `\{first}` and `\{owner}` (both would be the constructor `\{ctor}`)", ctx = ""))
        } else {
          ()
        }
        j = j + 1
      }
      Array::push(seen_ctor, value = ctor)
      Array::push(seen_owner, value = owner)
      c = c + 1
    }
    Array::push(out, value = from_wit_typedef(def))
    i = i + 1
  }
  String::join(out, sep = "\n\n")
}

/// #2064: the vibe bindings for every function a WIT package's interfaces
/// import as a host future -- the IMPORT half of ADR-0113, derived from the
/// WIT text rather than written by hand.
///
/// Each `f: async func() -> s64` in interface `i` of package `ns:pkg@v`
/// becomes
///
///     export fn f() -> Future[Int] {
///       host_future_named("ns:pkg/i@v#f")
///     }
///
/// and the address is what linked_compile turns into the
/// `vibe.wit_future_get$ns:pkg/i@v#f` metadata import, which the composer
/// imports from that versioned interface. Only that shape is admitted today --
/// the composer imports it as `async func() -> s64` with no parameters -- so any
/// other function, an unversioned package, or two interfaces exporting the
/// same function name is refused, named, rather than skipped: a binding file
/// that silently lacks a function the interface declares is worse than none.
export fn from_wit_future_imports(_ source: String) -> String with Exception {
  let (pkg, ifaces, _) = wit_parse(source)
  let (ns, pname, version) = match pkg {
    Some(p) => p,
    None => throw(fw_refusal(what = "a WIT file without a `package` line", ctx = " (the import address needs the package)"))
  }
  let ver = match version {
    Some(v) => v,
    None => throw(fw_refusal(what = "package `\{ns}:\{pname}` without a version", ctx = " (the composer imports a versioned interface)"))
  }
  let out: Array[String] = []
  let seen: Array[String] = []
  let mut i = 0
  while i < Array::length(ifaces) {
    let (iname, _, items) = Array::get(ifaces, at = i)
    let iface_id = "\{ns}:\{pname}/\{iname}@\{ver}"
    let mut k = 0
    while k < Array::length(items) {
      match Array::get(items, at = k) {
        IIFunction(fname, kind, is_async, params, result, _) => {
          let ctx = " (in interface `\{iname}`)"
          let admitted = match kind {
            FKFreestanding => is_async && Array::length(params) == 0 && match result {
              Some(TyS64) => true,
              _ => false
            },
            _ => false
          }
          // #2066: `async func() -> response`, the `types` interface's
          // `record response { status: s32, body: stream<u8> }` -- or with
          // one `string` parameter (a request's URL, say).
          let response = match kind {
            FKFreestanding => is_async && fw_response_params_admitted(params) && match result {
              Some(TyId(rname)) => rname == "response" && fw_uses_types_response(items) && fw_types_declares_response(ifaces),
              _ => false
            },
            _ => false
          }
          if !admitted && !response {
            throw(fw_refusal(what = "function `\{fname}` as a host-future import (only `async func() -> s64`, or `async func() -> response` / `async func(<name>: string) -> response` over the `types` interface's `record response { status: s32, body: stream<u8> }`, is admitted)", ctx = ctx))
          } else {
            ()
          }
          let vname = fw_ident(name = fw_snake(fname), ctx = ctx)
          if vname == "host_future_get" || vname == "host_future_named" || vname == "host_response_named" || vname == "host_response_named_with" || vname == "host_stream_named" || vname == "host_stream_next" || vname == "host_stream_close" || vname == "sleep" || vname == "sleep_blocking" || vname == "assert" || String::starts_with(vname, prefix = "vibe_hf_") || String::starts_with(vname, prefix = "vibe_hs_") {
            // A binding's body calls one of these builtins, which this
            // declaration would shadow; a program defining any of them also
            // turns off the entry boundary that settles host futures or
            // sleeps (`lc_inject_async_sleep_boundary`), and the boundary and
            // scheduler hooks synthesize calls to `sleep_blocking`, `assert`
            // and the `vibe_hf_*` / `vibe_hs_*` raw halves after checking
            // (Codex on #3059).
            throw(fw_refusal(what = "function `\{fname}` (its binding `\{vname}` would shadow a compiler-owned builtin)", ctx = ctx))
          } else if vname == "await" {
            // A program defining `await` turns off the builtin await lowering
            // for the whole merged program (Codex on #3059).
            throw(fw_refusal(what = "function `\{fname}` (its binding `await` would shadow the builtin every consumer awaits with)", ctx = ctx))
          } else {
            ()
          }
          let mut j = 0
          while j < Array::length(seen) {
            if Array::get(seen, at = j) == vname {
              throw(fw_refusal(what = "function `\{fname}` declared by two interfaces (both would be the binding `\{vname}`)", ctx = ctx))
            } else {
              ()
            }
            j = j + 1
          }
          Array::push(seen, value = vname)
          if response && Array::length(params) == 1 {
            // The parameter's WIT label rides the address (`#<func>?<label>`)
            // so the composer can declare the function exactly as the WIT does.
            let (plabel, _) = Array::get(params, at = 0)
            // The body calls `host_response_named_with`; a parameter spelled
            // that way would shadow it (Codex on #3091), so it takes another
            // name. The WIT label in the address stays as written.
            let pname0 = fw_ident(name = fw_snake(plabel), ctx = ctx)
            let pname = if pname0 == "host_response_named_with" {
              "request_arg"
            } else {
              pname0
            }
            Array::push(out, value = "/// `\{iface_id}#\{fname}`, imported as a host response taking `\{plabel}` (#2066).\nexport fn \{vname}(\{pname}: String) -> Future[HostResponse] {\n  host_response_named_with(\"\{iface_id}#\{fname}?\{plabel}\", body = \{pname})\n}")
          } else if response {
            Array::push(out, value = "/// `\{iface_id}#\{fname}`, imported as a host response (#2066).\nexport fn \{vname}() -> Future[HostResponse] {\n  host_response_named(\"\{iface_id}#\{fname}\")\n}")
          } else {
            Array::push(out, value = "/// `\{iface_id}#\{fname}`, imported as a host future (#2064).\nexport fn \{vname}() -> Future[Int] {\n  host_future_named(\"\{iface_id}#\{fname}\")\n}")
          }
        },
        // A resource's functions are functions of the interface too; none is
        // a host-future import, so they are refused rather than silently
        // missing from the bindings (Codex on #3059).
        IITypeDef(TDResource(rname, funcs, _)) => if Array::length(funcs) > 0 {
          let (fname, _, _, _, _, _) = Array::get(funcs, at = 0)
          throw(fw_refusal(what = "function `\{fname}` of resource `\{rname}` as a host-future import (only a freestanding `async func() -> s64` is admitted)", ctx = " (in interface `\{iname}`)"))
        } else {
          ()
        },
        _ => ()
      }
      k = k + 1
    }
    i = i + 1
  }
  String::join(out, sep = "\n\n")
}

/// Does this interface bring `response` in from its package's `types`
/// interface (`use types.{response};`)? The composer imports the record from
/// exactly that sibling, so no other spelling is admitted.
/// #2066: a response function takes no parameter, or exactly one `string`.
fn fw_response_params_admitted(_ params: Array[(String, WitTypeExpr)]) -> Bool {
  if Array::length(params) == 0 {
    true
  } else if Array::length(params) == 1 {
    let (_, pty) = Array::get(params, at = 0)
    match pty {
      TyString => true,
      _ => false
    }
  } else {
    false
  }
}

fn fw_uses_types_response(_ items: Array[WitInterfaceItem]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(items) {
    match Array::get(items, at = i) {
      IIUse(ns, _, _, from, names) => if ns == "" && from == "types" {
        let mut n = 0
        while n < Array::length(names) {
          if Array::get(names, at = n) == "response" {
            found = true
          } else {
            ()
          }
          n = n + 1
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// Does the package's `types` interface declare exactly
/// `record response { status: s32, body: stream<u8> }`?
fn fw_types_declares_response(_ ifaces: Array[(String, Option[String], Array[WitInterfaceItem])]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(ifaces) {
    let (iname, _, items) = Array::get(ifaces, at = i)
    if iname == "types" {
      let mut k = 0
      while k < Array::length(items) {
        match Array::get(items, at = k) {
          IITypeDef(TDRecord("response", fields, _)) => if Array::length(fields) == 2 {
            let status_ok = match Array::get(fields, at = 0) {
              ("status", TyS32) => true,
              _ => false
            }
            let body_ok = match Array::get(fields, at = 1) {
              ("body", TyStream(TyU8)) => true,
              _ => false
            }
            if status_ok && body_ok {
              found = true
            } else {
              ()
            }
          } else {
            ()
          },
          _ => ()
        }
        k = k + 1
      }
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn fw_refusal(what: String, ctx: String) -> String {
  "wit: `\{what}` has no vibe mapping\{ctx}"
}

fn fw_type(t: WitTypeExpr, ctx: String) -> String with Exception {
  match t {
    TyBool => "Bool",
    TyS64 => "Int",
    TyS32 => "Int32",
    TyU32 => "UInt32",
    TyF64 => "Float64",
    TyChar => "Char",
    TyString => "String",
    TyList(TyU8) => "Bytes",
    TyList(el) => "Array[\{fw_type(t = el, ctx = ctx)}]",
    TyOption(el) => "Option[\{fw_type(t = el, ctx = ctx)}]",
    TyFuture(el) => "Future[\{fw_type(t = el, ctx = ctx)}]",
    // The host owns the producer end of a boundary byte stream (ADR-0089 D4),
    // which is the nominal `HostStream` handle.
    TyStream(TyU8) => "HostStream",
    TyStream(_) => throw(fw_refusal(what = "stream<..> of anything but u8", ctx = ctx)),
    TyResult(ok, err) => match err {
      Some(e) => "Result[\{fw_type(t = ok, ctx = ctx)}, \{fw_type(t = e, ctx = ctx)}]",
      None => throw(fw_refusal(what = "result<..> with no error type", ctx = ctx))
    },
    // `_` (the parser's empty tuple) as a type argument: `wit_type_text` has
    // no inverse for `Unit` outside a function's result, so the round trip
    // could not hold -- refuse it rather than emit `()`.
    TyTuple(items) => if Array::length(items) == 0 {
      throw(fw_refusal(what = "_ (no value) inside another type", ctx = ctx))
    } else if Array::length(items) == 1 {
      // vibe reads `(T)` as grouping, not a one-element tuple, so `tuple<T>`
      // would come back as `T` -- a different ABI shape (Codex on #3059).
      throw(fw_refusal(what = "tuple<..> with one element", ctx = ctx))
    } else {
      let parts: Array[String] = []
      let mut i = 0
      while i < Array::length(items) {
        Array::push(parts, value = fw_type(t = Array::get(items, at = i), ctx = ctx))
        i = i + 1
      }
      "(\{String::join(parts, sep = ", ")})"
    },
    TyId(name) => fw_type_name(name),
    TyOwn(name) => fw_type_name(name),
    TyBorrow(name) => throw(fw_refusal(what = "borrow<\{name}>", ctx = ctx)),
    TyU8 => throw(fw_refusal(what = "u8 outside list<u8>", ctx = ctx)),
    TyU16 => throw(fw_refusal(what = "u16", ctx = ctx)),
    TyU64 => throw(fw_refusal(what = "u64", ctx = ctx)),
    TyS8 => throw(fw_refusal(what = "s8", ctx = ctx)),
    TyS16 => throw(fw_refusal(what = "s16", ctx = ctx)),
    TyF32 => throw(fw_refusal(what = "f32", ctx = ctx))
  }
}

/// The vibe keywords (the lexer's `keyword_lookup`); a derived name that is one
/// is written as a raw identifier. `fn` has no raw form (#1280: `r#fn` lexes
/// as the keyword), so it is refused.
let fw_vibe_keywords: Array[String] = [
  "fn",
  "if",
  "in",
  "is",
  "do",
  "as",
  "let",
  "rec",
  "mut",
  "for",
  "else",
  "enum",
  "true",
  "type",
  "test",
  "with",
  "loop",
  "open",
  "impl",
  "false",
  "match",
  "guard",
  "trait",
  "throw",
  "while",
  "break",
  "bench",
  "raise",
  "yield",
  "struct",
  "export",
  "return",
  "region",
  "handle",
  "module",
  "derive",
  "import",
  "declare",
  "example",
  "continue",
  "suberror",
  "taskgroup"
]

fn fw_ident(name: String, ctx: String) -> String with Exception {
  if name == "fn" {
    throw(fw_refusal(what = "identifier `fn` (a vibe keyword with no raw form)", ctx = ctx))
  } else if name == "true" || name == "false" {
    // `r#true` lexes to the identifier `true`, but the parser still reads
    // that as the boolean literal (Codex on #3059), so there is no spelling.
    throw(fw_refusal(what = "identifier `\{name}` (a vibe literal with no raw form)", ctx = ctx))
  } else {
    let mut keyword = false
    let mut i = 0
    while i < Array::length(fw_vibe_keywords) {
      if Array::get(fw_vibe_keywords, at = i) == name {
        keyword = true
      } else {
        ()
      }
      i = i + 1
    }
    if keyword {
      "r#\{name}"
    } else {
      name
    }
  }
}

/// A WIT case name as a vibe constructor, refused when it lands on a
/// constructor the compiler owns: `Some(x)` is typed as the builtin
/// `Option`'s wherever it is written, so a foreign `some(s64)` case could
/// never be built (Codex on #3059); `None`, `Ok` and `Err` are the same.
fn fw_case_name(case: String, ctx: String) -> String with Exception {
  let ctor = fw_pascal(case)
  if ctor == "Some" || ctor == "None" || ctor == "Ok" || ctor == "Err" {
    throw(fw_refusal(what = "case `\{case}` (its vibe constructor `\{ctor}` is the builtin one)", ctx = ctx))
  } else {
    ctor
  }
}

/// A WIT type name as a vibe type name, refused when it lands on a builtin
/// spelling: `record int { value: s64 }` would read `export struct Int { value:
/// Int }`, where the field's `Int` no longer means the scalar (Codex on #3059).
/// `Future` and `HostStream` are what `future<T>` / `stream<u8>` project to,
/// so a foreign type of that name would collide the same way; `Float` and
/// `StdinStream` complete the checker's own reserved set (`resolve_builtin`),
/// which refuses a declaration of any of them.
fn fw_type_name(_ name: String) -> String with Exception {
  let ty = fw_pascal(name)
  let builtins = [
    "Bool",
    "Int",
    "Double",
    "Char",
    "String",
    "Bytes",
    "Array",
    "Option",
    "Result",
    "Unit",
    "Map",
    "Future",
    "HostStream",
    "HostResponse",
    "Float",
    "Float64",
    "Float32",
    "StdinStream"
  ]
  let mut clash = false
  let mut i = 0
  while i < Array::length(builtins) {
    if Array::get(builtins, at = i) == ty {
      clash = true
    } else {
      ()
    }
    i = i + 1
  }
  if clash {
    throw(fw_refusal(what = "type `\{name}` (its vibe name `\{ty}` is a builtin type)", ctx = ""))
  } else {
    ty
  }
}

/// `price-info` -> `PriceInfo`: a WIT type name is kebab-case, a vibe type
/// name is PascalCase.
fn fw_pascal(_ name: String) -> String {
  let sb = StringBuilder::new()
  let mut upper = true
  let mut i = 0
  while i < String::length(name) {
    let c = String::byte_at(name, at = i)
    if c == '-' {
      upper = true
    } else if upper && c >= 'a' && c <= 'z' {
      StringBuilder::push(sb, value = String::from_byte(c - 32))
      upper = false
    } else {
      StringBuilder::push(sb, value = String::from_byte(c))
      upper = false
    }
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

/// `get-price` -> `get_price`: WIT identifiers are kebab-case, vibe values
/// are snake_case.
fn fw_snake(_ name: String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < String::length(name) {
    let c = String::byte_at(name, at = i)
    if c == '-' {
      StringBuilder::push(sb, value = "_")
    } else {
      StringBuilder::push(sb, value = String::from_byte(c))
    }
    i = i + 1
  }
  StringBuilder::freeze(sb)
}
