//# The inverse projection: WIT types -> vibe (ADR-0113 §7, #2064)
//
// `wit_gen` (lib/@vibe/compiler/wit_gen.vibe) projects a vibe signature onto
// WIT. A package that is not vibe arrives as WIT, and `vibe add` derives its
// vibe contract by the exact inverse of that mapping. This file is the
// type-level half of that inverse: a parsed `WitTypeExpr` to the vibe type
// spelling a contract would carry, and a function signature to its `fn`
// declaration.
//
// The admitted subset is the bijection in component-build-convention.md §2,
// read backwards. Everything outside it is REFUSED here, naming the type (and
// the function, from `from_wit_func`), because an unusable package must be
// refused when it is added, not when it is called:
//
//   - an integer other than `s64`, and `f32`: vibe has one `Int` (63-bit
//     inside, `s64` at the boundary) and one `Double`;
//   - `u8` outside `list<u8>`;
//   - `borrow<..>`: a borrowed handle has no vibe value to stand for it;
//   - a `stream` of anything but `u8`, and a `result` with no error type.
//
// Two readings are CHOICES rather than inverses, both recorded in §7:
// `list<tuple<string, V>>` stays `Array[(String, V)]` (a foreign author did
// not write a map, and duplicate keys are legal in the list), and a
// function's own `result<T, E>` becomes `-> T with Exception[E]` -- inside
// vibe, failure belongs in the row (#1324). A `result` nested inside another
// type has no row to move to and stays the explicit `Result[T, E]` of
// `@vibe/wit_runtime`.

import ./wit_parser.vibe {
  FKConstructor,
  FKFreestanding,
  FKMethod,
  FKStatic,
  TDAlias,
  TDEnum,
  TDFlags,
  TDRecord,
  TDResource,
  TDVariant,
  TyBool,
  TyBorrow,
  TyChar,
  TyF32,
  TyF64,
  TyFuture,
  TyId,
  TyList,
  TyOption,
  TyOwn,
  TyResult,
  TyS16,
  TyS32,
  TyS64,
  TyS8,
  TyStream,
  TyString,
  TyTuple,
  TyU16,
  TyU32,
  TyU64,
  TyU8,
  WitTypeDef,
  WitTypeExpr
}

/// The vibe type spelling of a WIT type, or a refusal naming it.
export fn from_wit_type(t: WitTypeExpr) -> String with Exception {
  fw_type(t, "")
}

/// The vibe declaration of a WIT function:
/// `name: async func(x: s64) -> result<string, string>` becomes
/// `fn name(x: Int) -> String with Exception[String] + Async`.
/// A refusal names the function as well as the type.
export fn from_wit_func(name: String, is_async: Bool, params: Array[(String, WitTypeExpr)], result: Option[WitTypeExpr]) -> String with Exception {
  fw_signature(fw_ident(fw_snake(name), " (in `\{name}`)"), is_async, params, result, name)
}

/// `fn <spelled>(..) -> ..`, refusals naming `ctx_name`.
fn fw_signature(spelled: String, is_async: Bool, params: Array[(String, WitTypeExpr)], result: Option[WitTypeExpr], ctx_name: String) -> String with Exception {
  let ctx = " (in `\{ctx_name}`)"
  let sb = StringBuilder::new()
  StringBuilder::push(sb, "fn ")
  StringBuilder::push(sb, spelled)
  StringBuilder::push(sb, "(")
  let mut i = 0
  while i < Array::length(params) {
    let (pname, pty) = Array::get(params, i)
    if i > 0 {
      StringBuilder::push(sb, ", ")
    } else {
      ()
    }
    StringBuilder::push(sb, fw_ident(fw_snake(pname), ctx))
    StringBuilder::push(sb, ": ")
    StringBuilder::push(sb, fw_type(pty, ctx))
    i = i + 1
  }
  StringBuilder::push(sb, ") -> ")
  let rows: Array[String] = []
  match result {
    Some(TyResult(ok, err)) => match err {
      Some(e) => {
        // `result<_, E>`: the parser reads `_` as the empty tuple. As a
        // function's own result it is just "no value", i.e. `Unit`.
        let ok_text = match ok {
          TyTuple(items) => if Array::length(items) == 0 {
            "Unit"
          } else {
            fw_type(ok, ctx)
          },
          _ => fw_type(ok, ctx)
        }
        StringBuilder::push(sb, ok_text)
        Array::push(rows, "Exception[\{fw_type(e, ctx)}]")
      },
      None => throw(fw_refusal("result<..> with no error type", ctx))
    },
    Some(other) => StringBuilder::push(sb, fw_type(other, ctx)),
    None => StringBuilder::push(sb, "Unit")
  }
  if is_async {
    Array::push(rows, "Async")
  } else {
    ()
  }
  if Array::length(rows) > 0 {
    StringBuilder::push(sb, " with ")
    StringBuilder::push(sb, String::join(rows, " + "))
  } else {
    ()
  }
  StringBuilder::freeze(sb)
}

/// The vibe declaration(s) of a WIT type definition (§7):
///
/// - `record` -> `export struct`, fields in order;
/// - `enum` -> a payload-less `export enum`;
/// - `variant` -> `export enum` with payloads, a `tuple<..>` payload read back
///   as that many payloads (the inverse of §2's `B(U, V)` -> `b(tuple<u, v>)`);
/// - `type x = ..` -> `type X = ..`;
/// - `resource` -> an `opaque type` plus its functions taking the handle
///   first, and an explicit `drop`: a resource handle is not a vibe heap
///   value, so RC does not free it and the consumer has to;
/// - `flags` is refused (no vibe mapping, §7).
export fn from_wit_typedef(typedef: WitTypeDef) -> String with Exception {
  match typedef {
    TDRecord(name, fields, _) => {
      let ctx = " (in record `\{name}`)"
      let lines: Array[String] = []
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fty) = Array::get(fields, i)
        Array::push(lines, "  \{fw_ident(fw_snake(fname), ctx)}: \{fw_type(fty, ctx)}")
        i = i + 1
      }
      "export struct \{fw_pascal(name)} {\n\{String::join(lines, ";\n")}\n}"
    },
    TDEnum(name, cases, _) => {
      let parts: Array[String] = []
      let mut i = 0
      while i < Array::length(cases) {
        Array::push(parts, "  \{fw_pascal(Array::get(cases, i))}")
        i = i + 1
      }
      "export enum \{fw_pascal(name)} {\n\{String::join(parts, ";\n")}\n}"
    },
    TDVariant(name, cases, _) => {
      let ctx = " (in variant `\{name}`)"
      let parts: Array[String] = []
      let mut i = 0
      while i < Array::length(cases) {
        let (cname, payload) = Array::get(cases, i)
        let head = fw_pascal(cname)
        Array::push(parts, match payload {
          Some(TyTuple(items)) => {
            let tys: Array[String] = []
            let mut k = 0
            while k < Array::length(items) {
              Array::push(tys, fw_type(Array::get(items, k), ctx))
              k = k + 1
            }
            "  \{head}(\{String::join(tys, ", ")})"
          },
          Some(t) => "  \{head}(\{fw_type(t, ctx)})",
          None => "  \{head}"
        })
        i = i + 1
      }
      "export enum \{fw_pascal(name)} {\n\{String::join(parts, ";\n")}\n}"
    },
    TDAlias(name, t, _) => "type \{fw_pascal(name)} = \{fw_type(t, " (in type `\{name}`)")}",
    TDFlags(name, _, _) => throw(fw_refusal("flags \{name}", "")),
    TDResource(name, funcs, _) => {
      let ty = fw_pascal(name)
      // The explicit release is spelled `drop` (§7); a resource whose own
      // interface already has a `drop` would declare it twice (Codex on
      // #3059), so it is refused rather than silently renamed.
      let mut fi = 0
      while fi < Array::length(funcs) {
        let (fname, _, _, _, _, _) = Array::get(funcs, fi)
        if fname == "drop" {
          throw(fw_refusal("resource `\{name}` declaring its own `drop` (the derived handle release is `\{ty}::drop`)", ""))
        } else {
          ()
        }
        fi = fi + 1
      }
      let out: Array[String] = ["opaque type \{ty}"]
      let mut i = 0
      while i < Array::length(funcs) {
        let (fname, kind, is_async, params, result, _) = Array::get(funcs, i)
        let res_ctx = " (in resource `\{name}`)"
        let method_name = fw_ident(fw_snake(fname), res_ctx)
        let qualified = "\{ty}::\{method_name}"
        let decl = match kind {
          FKConstructor(_) => fw_signature("\{ty}::new", is_async, params, Some(TyOwn(name)), qualified),
          FKMethod(_) => {
            let with_self: Array[(String, WitTypeExpr)] = [
              ("self", TyOwn(name))
            ]
            let mut p = 0
            while p < Array::length(params) {
              Array::push(with_self, Array::get(params, p))
              p = p + 1
            }
            fw_signature(qualified, is_async, with_self, result, qualified)
          },
          FKStatic(_) => fw_signature(qualified, is_async, params, result, qualified),
          FKFreestanding => fw_signature(qualified, is_async, params, result, qualified)
        }
        Array::push(out, decl)
        i = i + 1
      }
      Array::push(out, "fn \{ty}::drop(self: \{ty}) -> Unit")
      String::join(out, "\n")
    }
  }
}

/// Method-style spelling of `from_wit_type`.
export fn WitTypeExpr::from_wit_type(recv: WitTypeExpr) -> String with Exception {
  from_wit_type(recv)
}

/// Method-style spelling of `from_wit_typedef`.
export fn WitTypeDef::from_wit_typedef(recv: WitTypeDef) -> String with Exception {
  from_wit_typedef(recv)
}

fn fw_refusal(what: String, ctx: String) -> String {
  "wit: `\{what}` has no vibe mapping\{ctx}"
}

fn fw_type(t: WitTypeExpr, ctx: String) -> String with Exception {
  match t {
    TyBool => "Bool",
    TyS64 => "Int",
    TyF64 => "Double",
    TyChar => "Char",
    TyString => "String",
    TyList(TyU8) => "Bytes",
    TyList(el) => "Array[\{fw_type(el, ctx)}]",
    TyOption(el) => "Option[\{fw_type(el, ctx)}]",
    TyFuture(el) => "Future[\{fw_type(el, ctx)}]",
    // The host owns the producer end of a boundary byte stream (ADR-0089 D4),
    // which is the nominal `HostStream` handle.
    TyStream(TyU8) => "HostStream",
    TyStream(_) => throw(fw_refusal("stream<..> of anything but u8", ctx)),
    TyResult(ok, err) => match err {
      Some(e) => "Result[\{fw_type(ok, ctx)}, \{fw_type(e, ctx)}]",
      None => throw(fw_refusal("result<..> with no error type", ctx))
    },
    // `_` (the parser's empty tuple) as a type argument: `wit_type_text` has
    // no inverse for `Unit` outside a function's result, so the round trip
    // could not hold -- refuse it rather than emit `()`.
    TyTuple(items) => if Array::length(items) == 0 {
      throw(fw_refusal("_ (no value) inside another type", ctx))
    } else if Array::length(items) == 1 {
      // vibe reads `(T)` as grouping, not a one-element tuple, so `tuple<T>`
      // would come back as `T` -- a different ABI shape (Codex on #3059).
      throw(fw_refusal("tuple<..> with one element", ctx))
    } else {
      let parts: Array[String] = []
      let mut i = 0
      while i < Array::length(items) {
        Array::push(parts, fw_type(Array::get(items, i), ctx))
        i = i + 1
      }
      "(\{String::join(parts, ", ")})"
    },
    TyId(name) => fw_pascal(name),
    TyOwn(name) => fw_pascal(name),
    TyBorrow(name) => throw(fw_refusal("borrow<\{name}>", ctx)),
    TyU8 => throw(fw_refusal("u8 outside list<u8>", ctx)),
    TyU16 => throw(fw_refusal("u16", ctx)),
    TyU32 => throw(fw_refusal("u32", ctx)),
    TyU64 => throw(fw_refusal("u64", ctx)),
    TyS8 => throw(fw_refusal("s8", ctx)),
    TyS16 => throw(fw_refusal("s16", ctx)),
    TyS32 => throw(fw_refusal("s32", ctx)),
    TyF32 => throw(fw_refusal("f32", ctx))
  }
}

/// The vibe keywords (the lexer's `keyword_lookup`); a derived name that is one
/// is written as a raw identifier. `fn` has no raw form (#1280: `r#fn` lexes
/// as the keyword), so it is refused.
let fw_vibe_keywords: Array[String] = [
  "fn",
  "if",
  "in",
  "is",
  "do",
  "as",
  "let",
  "rec",
  "mut",
  "for",
  "else",
  "enum",
  "true",
  "type",
  "test",
  "with",
  "loop",
  "open",
  "impl",
  "false",
  "match",
  "guard",
  "trait",
  "throw",
  "while",
  "break",
  "bench",
  "raise",
  "yield",
  "struct",
  "export",
  "return",
  "region",
  "handle",
  "module",
  "derive",
  "import",
  "declare",
  "example",
  "continue",
  "suberror",
  "taskgroup"
]

fn fw_ident(name: String, ctx: String) -> String with Exception {
  if name == "fn" {
    throw(fw_refusal("identifier `fn` (a vibe keyword with no raw form)", ctx))
  } else if name == "true" || name == "false" {
    // `r#true` lexes to the identifier `true`, but the parser still reads
    // that as the boolean literal (Codex on #3059), so there is no spelling.
    throw(fw_refusal("identifier `\{name}` (a vibe literal with no raw form)", ctx))
  } else {
    let mut keyword = false
    let mut i = 0
    while i < Array::length(fw_vibe_keywords) {
      if Array::get(fw_vibe_keywords, i) == name {
        keyword = true
      } else {
        ()
      }
      i = i + 1
    }
    if keyword {
      "r#\{name}"
    } else {
      name
    }
  }
}

/// `price-info` -> `PriceInfo`: a WIT type name is kebab-case, a vibe type
/// name is PascalCase.
fn fw_pascal(name: String) -> String {
  let sb = StringBuilder::new()
  let mut upper = true
  let mut i = 0
  while i < String::length(name) {
    let c = String::byte_at(name, i)
    if c == '-' {
      upper = true
    } else if upper && c >= 'a' && c <= 'z' {
      StringBuilder::push(sb, String::from_byte(c - 32))
      upper = false
    } else {
      StringBuilder::push(sb, String::from_byte(c))
      upper = false
    }
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

/// `get-price` -> `get_price`: WIT identifiers are kebab-case, vibe values
/// are snake_case.
fn fw_snake(name: String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < String::length(name) {
    let c = String::byte_at(name, i)
    if c == '-' {
      StringBuilder::push(sb, "_")
    } else {
      StringBuilder::push(sb, String::from_byte(c))
    }
    i = i + 1
  }
  StringBuilder::freeze(sb)
}
