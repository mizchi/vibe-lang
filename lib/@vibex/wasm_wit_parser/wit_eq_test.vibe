test "WitToken: every represented variant is the declared one, in order" {
  // `wittoken_tag` is exhaustive over the DECLARATION (see its doc comment), so a
  // new variant breaks compilation of this file. This pins the other half:
  // that `every_wittoken` holds the variants it claims to, in declaration order.
  //
  // `want` is the declaration index of each entry -- NOT `0..n`, because a
  // variant this file has no sample for is omitted and leaves a gap. Writing
  // `tag(vs[i]) == i` instead was wrong for exactly that reason, and this test
  // is what caught it.
  let want = [0, 1, 2, 3, 4, 5, 6]
  let vs = every_wittoken()
  let n = Array::length(vs)
  let mut in_order = 0
  let mut i = 0
  while i < n {
    let a: WitToken = Array::get(vs, i)
    if wittoken_tag(a) == Array::get(want, i) {
      in_order = in_order + 1
    } else {
      ()
    }
    i = i + 1
  }
  inspect(Array::length(want), "7")
  inspect(in_order, "7")
}

