// Derived-`==` coverage for this package's enums (#1556).
//
// `T::equals` is DERIVED: `desugar_derives` emits one for every declared enum
// whether or not anything uses `==` on that type. Nothing in the suite called
// these, so all of their branches sat unreached -- 1,710 across 96 types, 3.8%
// of the whole branch denominator. That is worth a test beyond the number:
// ADR-0097 / #1526 are actively changing what `==` means in each context, and a
// structural comparison over a package's own data types is exactly the surface
// those changes move.
//
// Shape of the generated function:
//   match a { V(..) => match b { V(..) => fields..., _ => false }, ... }
// so covering it takes each variant compared to ITSELF (the inner matching arm)
// and to a DIFFERENT one (the inner `_`). The two loops per type do that.
//
// Both sides are bound to NAMES with an explicit type before comparing.
// Comparing `Array::get(..)` results directly is the documented
// reference-equality hole (AGENTS.md: "関数戻り値経由") -- the dispatch cannot
// see the operand type through a call result, so `==` silently stays reference
// equality. Measured on Token: 9/270 branches with the direct form, 270/270
// with the bound form. The loops PASS either way, which is what makes it worth
// spelling out here.
//# Imports

import ./wit_parser.vibe {
  WitFuncKind, WitInterfaceItem, WitToken, WitTypeDef, WitTypeExpr, WitWorldItem
}

//# Helpers

/// Exhaustive over the DECLARATION: one arm per declared variant, no `_`.
///
/// This is the completeness ratchet, and it is a BUILD-time one. Pinning
/// `Array::length(every_witfunckind())` against a literal cannot work -- that number
/// is the array's own length, so a variant added to the enum but not to the
/// array leaves it unchanged and the test still passes. Adding a variant here
/// instead makes this match non-exhaustive, which the checker rejects
/// ("non-exhaustive match: variant `X` of enum WitFuncKind is not handled"), so the
/// file stops compiling until the new variant is represented.
fn witfunckind_tag(v: WitFuncKind) -> Int {
  match v {
    FKFreestanding => 0,
    FKConstructor(_) => 1,
    FKMethod(_) => 2,
    FKStatic(_) => 3
  }
}

/// One literal per `WitFuncKind` variant, in declaration order (#1556).
fn every_witfunckind() -> Array[WitFuncKind] {
  [FKFreestanding, FKConstructor("s"), FKMethod("s"), FKStatic("s")]
}

/// The same variants rebuilt with the SAME payloads, INDEPENDENTLY constructed.
///
/// `every_witfunckind()` compared against itself would pass under reference equality,
/// because both operands are the very same object out of one array -- and the
/// negative tests pass under reference equality too, since their payloads
/// genuinely differ. Only comparing two structurally-equal but distinct objects
/// separates "compares fields" from "compares identity".
fn every_witfunckind_same() -> Array[WitFuncKind] {
  [FKFreestanding, FKConstructor("s"), FKMethod("s"), FKStatic("s")]
}

/// The same variants rebuilt with DIFFERENT payloads, in lockstep with
/// `every_witfunckind`. Comparing the two arrays element-wise keeps the tag fixed and
/// varies only the fields, which is the only way into the field-comparison
/// branches of a matched arm.
fn every_witfunckind_alt() -> Array[WitFuncKind] {
  [FKFreestanding, FKConstructor("t"), FKMethod("t"), FKStatic("t")]
}

/// Exhaustive over the DECLARATION: one arm per declared variant, no `_`.
///
/// This is the completeness ratchet, and it is a BUILD-time one. Pinning
/// `Array::length(every_wittypeexpr())` against a literal cannot work -- that number
/// is the array's own length, so a variant added to the enum but not to the
/// array leaves it unchanged and the test still passes. Adding a variant here
/// instead makes this match non-exhaustive, which the checker rejects
/// ("non-exhaustive match: variant `X` of enum WitTypeExpr is not handled"), so the
/// file stops compiling until the new variant is represented.
fn wittypeexpr_tag(v: WitTypeExpr) -> Int {
  match v {
    TyBool => 0,
    TyU8 => 1,
    TyU16 => 2,
    TyU32 => 3,
    TyU64 => 4,
    TyS8 => 5,
    TyS16 => 6,
    TyS32 => 7,
    TyS64 => 8,
    TyF32 => 9,
    TyF64 => 10,
    TyChar => 11,
    TyString => 12,
    TyId(_) => 13,
    TyList(_) => 14,
    TyOption(_) => 15,
    TyFuture(_) => 16,
    TyStream(_) => 17,
    TyResult(_, _) => 18,
    TyTuple(_) => 19,
    TyOwn(_) => 20,
    TyBorrow(_) => 21
  }
}

/// One literal per `WitTypeExpr` variant, in declaration order (#1556).
fn every_wittypeexpr() -> Array[WitTypeExpr] {
  [
    TyBool,
    TyU8,
    TyU16,
    TyU32,
    TyU64,
    TyS8,
    TyS16,
    TyS32,
    TyS64,
    TyF32,
    TyF64,
    TyChar,
    TyString,
    TyId("s"),
    TyList(TyBool),
    TyOption(TyBool),
    TyFuture(TyBool),
    TyStream(TyBool),
    TyResult(TyBool, Some(TyBool)),
    TyTuple([TyBool]),
    TyOwn("s"),
    TyBorrow("s")
  ]
}

/// The same variants rebuilt with the SAME payloads, INDEPENDENTLY constructed.
///
/// `every_wittypeexpr()` compared against itself would pass under reference equality,
/// because both operands are the very same object out of one array -- and the
/// negative tests pass under reference equality too, since their payloads
/// genuinely differ. Only comparing two structurally-equal but distinct objects
