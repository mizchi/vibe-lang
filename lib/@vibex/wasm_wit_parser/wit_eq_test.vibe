/// This is the completeness ratchet, and it is a BUILD-time one. Pinning
/// `Array::length(every_wittoken())` against a literal cannot work -- that number
/// is the array's own length, so a variant added to the enum but not to the
/// array leaves it unchanged and the test still passes. Adding a variant here
/// instead makes this match non-exhaustive, which the checker rejects
/// ("non-exhaustive match: variant `X` of enum WitToken is not handled"), so the
/// file stops compiling until the new variant is represented.
fn wittoken_tag(v: WitToken) -> Int {
  match v {
    WTIdent(_) => 0,
    WTKeyword(_) => 1,
    WTSymbol(_) => 2,
    WTStringLit(_) => 3,
    WTNumber(_) => 4,
    WTDoc(_) => 5,
    WTEof => 6
  }
}

/// One literal per `WitToken` variant, in declaration order (#1556).
