fn every_wittypeexpr_same() -> Array[WitTypeExpr] {
  [
    TyBool,
    TyU8,
    TyU16,
    TyU32,
    TyU64,
    TyS8,
    TyS16,
    TyS32,
    TyS64,
    TyF32,
    TyF64,
    TyChar,
    TyString,
    TyId("s"),
    TyList(TyBool),
    TyOption(TyBool),
    TyFuture(TyBool),
    TyStream(TyBool),
    TyResult(TyBool, Some(TyBool)),
    TyTuple([TyBool]),
    TyOwn("s"),
    TyBorrow("s")
  ]
}

/// The same variants rebuilt with DIFFERENT payloads, in lockstep with
/// `every_wittypeexpr`. Comparing the two arrays element-wise keeps the tag fixed and
/// varies only the fields, which is the only way into the field-comparison
/// branches of a matched arm.
fn every_wittypeexpr_alt() -> Array[WitTypeExpr] {
  [
    TyBool,
    TyU8,
    TyU16,
    TyU32,
    TyU64,
    TyS8,
    TyS16,
    TyS32,
    TyS64,
    TyF32,
    TyF64,
    TyChar,
    TyString,
    TyId("t"),
    TyList(TyU8),
    TyOption(TyU8),
    TyFuture(TyU8),
    TyStream(TyU8),
    TyResult(TyU8, Some(TyU8)),
    TyTuple([TyBool]),
    TyOwn("t"),
    TyBorrow("t")
  ]
}

/// Exhaustive over the DECLARATION: one arm per declared variant, no `_`.
