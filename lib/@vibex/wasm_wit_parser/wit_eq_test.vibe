/// Exhaustive over the DECLARATION: one arm per declared variant, no `_`.
///
/// This is the completeness ratchet, and it is a BUILD-time one. Pinning
/// `Array::length(every_wittypedef())` against a literal cannot work -- that number
/// is the array's own length, so a variant added to the enum but not to the
/// array leaves it unchanged and the test still passes. Adding a variant here
/// instead makes this match non-exhaustive, which the checker rejects
/// ("non-exhaustive match: variant `X` of enum WitTypeDef is not handled"), so the
/// file stops compiling until the new variant is represented.
fn wittypedef_tag(v: WitTypeDef) -> Int {
  match v {
    TDRecord(_, _, _) => 0,
    TDEnum(_, _, _) => 1,
    TDFlags(_, _, _) => 2,
    TDVariant(_, _, _) => 3,
    TDAlias(_, _, _) => 4,
    TDResource(_, _, _) => 5
  }
}

/// One literal per `WitTypeDef` variant, in declaration order (#1556).
fn every_wittypedef() -> Array[WitTypeDef] {
  [
    TDRecord("s", [("f", TyBool)], Some("s")),
    TDEnum("s", ["p"], Some("s")),
    TDFlags("s", ["p"], Some("s")),
    TDVariant("s", [("f", Some(TyBool))], Some("s")),
    TDAlias("s", TyBool, Some("s")),
    TDResource("s", [
      ("m", FKFreestanding, [("p", TyBool)], Some(TyBool), Some("d"))
    ], Some("s"))
  ]
}

/// The same variants rebuilt with the SAME payloads, INDEPENDENTLY constructed.
///
/// `every_wittypedef()` compared against itself would pass under reference equality,
/// because both operands are the very same object out of one array -- and the
/// negative tests pass under reference equality too, since their payloads
/// genuinely differ. Only comparing two structurally-equal but distinct objects
/// separates "compares fields" from "compares identity".
fn every_wittypedef_same() -> Array[WitTypeDef] {
  [
    TDRecord("s", [("f", TyBool)], Some("s")),
    TDEnum("s", ["p"], Some("s")),
    TDFlags("s", ["p"], Some("s")),
    TDVariant("s", [("f", Some(TyBool))], Some("s")),
    TDAlias("s", TyBool, Some("s")),
    TDResource("s", [
      ("m", FKFreestanding, [("p", TyBool)], Some(TyBool), Some("d"))
    ], Some("s"))
  ]
}

/// The same variants rebuilt with DIFFERENT payloads, in lockstep with
/// `every_wittypedef`. Comparing the two arrays element-wise keeps the tag fixed and
/// varies only the fields, which is the only way into the field-comparison
/// branches of a matched arm.
fn every_wittypedef_alt() -> Array[WitTypeDef] {
  [
    TDRecord("t", [("g", TyU8)], Some("t")),
    TDEnum("t", ["q"], Some("t")),
    TDFlags("t", ["q"], Some("t")),
    TDVariant("t", [("g", Some(TyU8))], Some("t")),
    TDAlias("t", TyU8, Some("t")),
    TDResource("t", [("n", FKMethod("m"), [("q", TyU8)], Some(TyU8), Some("e"))], Some("t"))
  ]
}

/// Exhaustive over the DECLARATION: one arm per declared variant, no `_`.
///
/// This is the completeness ratchet, and it is a BUILD-time one. Pinning
/// `Array::length(every_witinterfaceitem())` against a literal cannot work -- that number
/// is the array's own length, so a variant added to the enum but not to the
/// array leaves it unchanged and the test still passes. Adding a variant here
/// instead makes this match non-exhaustive, which the checker rejects
/// ("non-exhaustive match: variant `X` of enum WitInterfaceItem is not handled"), so the
/// file stops compiling until the new variant is represented.
fn witinterfaceitem_tag(v: WitInterfaceItem) -> Int {
  match v {
    IIUse(_, _, _, _, _) => 0,
    IITypeDef(_) => 1,
    IIFunction(_, _, _, _, _) => 2
  }
}

/// One literal per `WitInterfaceItem` variant, in declaration order (#1556).
fn every_witinterfaceitem() -> Array[WitInterfaceItem] {
  [
    IIUse("s", "s", Some("s"), "s", ["p"]),
    IITypeDef(TDAlias("a", TyBool, Some("d"))),
    IIFunction("s", FKFreestanding, [("f", TyBool)], Some(TyBool), Some("s"))
  ]
}

/// The same variants rebuilt with the SAME payloads, INDEPENDENTLY constructed.
///
/// `every_witinterfaceitem()` compared against itself would pass under reference equality,
/// because both operands are the very same object out of one array -- and the
/// negative tests pass under reference equality too, since their payloads
/// genuinely differ. Only comparing two structurally-equal but distinct objects
/// separates "compares fields" from "compares identity".
fn every_witinterfaceitem_same() -> Array[WitInterfaceItem] {
  [
    IIUse("s", "s", Some("s"), "s", ["p"]),
    IITypeDef(TDAlias("a", TyBool, Some("d"))),
    IIFunction("s", FKFreestanding, [("f", TyBool)], Some(TyBool), Some("s"))
  ]
}

/// The same variants rebuilt with DIFFERENT payloads, in lockstep with
/// `every_witinterfaceitem`. Comparing the two arrays element-wise keeps the tag fixed and
/// varies only the fields, which is the only way into the field-comparison
/// branches of a matched arm.
fn every_witinterfaceitem_alt() -> Array[WitInterfaceItem] {
  [
    IIUse("t", "t", Some("t"), "t", ["q"]),
    IITypeDef(TDAlias("b", TyU8, Some("e"))),
    IIFunction("t", FKMethod("m"), [("g", TyU8)], Some(TyU8), Some("t"))
  ]
}

/// Exhaustive over the DECLARATION: one arm per declared variant, no `_`.
///
/// This is the completeness ratchet, and it is a BUILD-time one. Pinning
/// `Array::length(every_witworlditem())` against a literal cannot work -- that number
/// is the array's own length, so a variant added to the enum but not to the
/// array leaves it unchanged and the test still passes. Adding a variant here
/// instead makes this match non-exhaustive, which the checker rejects
/// ("non-exhaustive match: variant `X` of enum WitWorldItem is not handled"), so the
/// file stops compiling until the new variant is represented.
fn witworlditem_tag(v: WitWorldItem) -> Int {
  match v {
    WIInterface(_, _, _, _) => 0,
    WIFunction(_, _, _, _, _) => 1,
    WIInlineInterface(_, _, _) => 2,
    WIInclude(_, _, _, _, _) => 3
  }
}

/// One literal per `WitWorldItem` variant, in declaration order (#1556).
fn every_witworlditem() -> Array[WitWorldItem] {
  [
    WIInterface("s", "s", Some("s"), "s"),
    WIFunction("s", FKFreestanding, [("f", TyBool)], Some(TyBool), Some("s")),
    WIInlineInterface("s", Some("s"), [
      IITypeDef(TDAlias("a", TyBool, Some("d")))
    ]),
    WIInclude("s", "s", Some("s"), "s", [("a", "b")])
  ]
}

/// The same variants rebuilt with the SAME payloads, INDEPENDENTLY constructed.
///
/// `every_witworlditem()` compared against itself would pass under reference equality,
/// because both operands are the very same object out of one array -- and the
/// negative tests pass under reference equality too, since their payloads
/// genuinely differ. Only comparing two structurally-equal but distinct objects
/// separates "compares fields" from "compares identity".
fn every_witworlditem_same() -> Array[WitWorldItem] {
  [
    WIInterface("s", "s", Some("s"), "s"),
    WIFunction("s", FKFreestanding, [("f", TyBool)], Some(TyBool), Some("s")),
    WIInlineInterface("s", Some("s"), [
      IITypeDef(TDAlias("a", TyBool, Some("d")))
    ]),
    WIInclude("s", "s", Some("s"), "s", [("a", "b")])
  ]
}

/// The same variants rebuilt with DIFFERENT payloads, in lockstep with
/// `every_witworlditem`. Comparing the two arrays element-wise keeps the tag fixed and
/// varies only the fields, which is the only way into the field-comparison
/// branches of a matched arm.
fn every_witworlditem_alt() -> Array[WitWorldItem] {
  [
    WIInterface("t", "t", Some("t"), "t"),
    WIFunction("t", FKMethod("m"), [("g", TyU8)], Some(TyU8), Some("t")),
    WIInlineInterface("t", Some("t"), [IITypeDef(TDAlias("b", TyU8, Some("e")))]),
    WIInclude("t", "t", Some("t"), "t", [("c", "d")])
  ]
}

//# Tests

test "WitFuncKind ==: every variant is structurally equal to itself" {
  let vs = every_witfunckind()
  let n = Array::length(vs)
  let mut same = 0
  let mut i = 0
  while i < n {
    let a: WitFuncKind = Array::get(vs, i)
    let b: WitFuncKind = Array::get(vs, i)
    if a == b {
      same = same + 1
    } else {
      ()
    }
    i = i + 1
  }
  inspect(same, "4")
}

test "WitFuncKind ==: distinct variants are never equal" {
  let vs = every_witfunckind()
  let n = Array::length(vs)
  let mut differ = 0
  let mut i = 0
  while i < n {
    let j = if i + 1 < n {
      i + 1
    } else {
      0
    }
    let a: WitFuncKind = Array::get(vs, i)
    let b: WitFuncKind = Array::get(vs, j)
    if a == b {
      ()
    } else {
      differ = differ + 1
    }
    i = i + 1
  }
  inspect(differ, "4")
}

test "WitFuncKind ==: structurally equal but distinct values are equal" {
  let vs = every_witfunckind()
  let same = every_witfunckind_same()
  let n = Array::length(vs)
  let mut equal = 0
  let mut i = 0
  while i < n {
    let a: WitFuncKind = Array::get(vs, i)
    let b: WitFuncKind = Array::get(same, i)
    if a == b {
      equal = equal + 1
    } else {
      ()
    }
    i = i + 1
  }
  // Every variant, including the ones carrying arrays and nested values. A
  // regression from structural to reference comparison drops this below n.
  inspect(equal, "4")
}

test "WitFuncKind: every represented variant is the declared one, in order" {
  // `witfunckind_tag` is exhaustive over the DECLARATION (see its doc comment), so a
  // new variant breaks compilation of this file. This pins the other half:
  // that `every_witfunckind` holds the variants it claims to, in declaration order.
  //
  // `want` is the declaration index of each entry -- NOT `0..n`, because a
  // variant this file has no sample for is omitted and leaves a gap. Writing
  // `tag(vs[i]) == i` instead was wrong for exactly that reason, and this test
  // is what caught it.
  let want = [0, 1, 2, 3]
  let vs = every_witfunckind()
  let n = Array::length(vs)
  let mut in_order = 0
  let mut i = 0
  while i < n {
    let a: WitFuncKind = Array::get(vs, i)
    if witfunckind_tag(a) == Array::get(want, i) {
      in_order = in_order + 1
    } else {
      ()
    }
    i = i + 1
  }
  inspect(Array::length(want), "4")
  inspect(in_order, "4")
}

test "WitFuncKind ==: same variant with different payloads is not equal" {
  let vs = every_witfunckind()
  let alt = every_witfunckind_alt()
  let n = Array::length(vs)
  let mut differ = 0
  let mut i = 0
  while i < n {
    let a: WitFuncKind = Array::get(vs, i)
    let b: WitFuncKind = Array::get(alt, i)
    if a == b {
      ()
    } else {
      differ = differ + 1
    }
    i = i + 1
  }
  // Exactly the variants that CARRY a payload must differ; the nullary ones
  // rebuild identically and must still compare equal. A derive that compared
  // tags only would report 0 here.
  inspect(Array::length(alt), "4")
  inspect(differ, "3")
}

