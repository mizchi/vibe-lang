  #|@vibex/wasm_wit_parser — WIT (WebAssembly Interface Types) text-format
deps = {}

generated_hash =

// @vibex/wasm_wit_parser — WIT (WebAssembly Interface Types) text-format
// tokenizer + parser producing a typed token/AST enum surface (ADR-0070
// Phase 3, #897).
//
// All six enums (`WitToken`/`WitTypeExpr`/`WitFuncKind`/`WitTypeDef`/
// `WitInterfaceItem`/`WitWorldItem`) are declared `opaque type` here even
// though their variant layout is real public surface (the old index.vibe
// facade re-exported every variant by name, and wit_parser_test.vibe
// constructs/matches them all), deliberately following @vibe/json's `Json`/
// `RpcMessage` precedent (PR #923) rather than the transparent-when-public
// convention: a transparent enum definition lives only in the FACADE unit,
// and enum VARIANTS do not resolve across units the way type names do —
// the defining impl unit itself would break with "unknown name: <Variant>"
// if the definitions moved here. The exported definitions stay in
// wit_parser.vibe (its old trailing `export { ... }` name blocks were
// replaced by marking the enum defs themselves `export`, which also
// exports the variants) and ride the same #716 re-export machinery the old
// hand-written index.vibe used, so variant visibility for consumers is
// unchanged. The in-package test already imported `./wit_parser.vibe`
// directly and needed no retarget.
//
// `version` was `export let version = "0.0.1"` directly in the old
// index.vibe facade — a real importable binding, not just contract
// metadata — preserved as an implementation-file value (wit_parser.vibe)
// with a matching bodyless declaration here (Codex review precedent, PR
// #914). No other value aliases existed in the old facade.

opaque type WitToken
opaque type WitTypeExpr
opaque type WitFuncKind
opaque type WitTypeDef
opaque type WitInterfaceItem
opaque type WitWorldItem

fn wit_tokenize(src: String) -> Array[WitToken] with Error
fn wit_parse(source: String) -> (Option[(String, String, Option[String])], Array[(String, Option[String], Array[WitInterfaceItem])], Array[(String, Option[String], Array[WitTypeDef], Array[WitWorldItem], Array[WitWorldItem])]) with Error
