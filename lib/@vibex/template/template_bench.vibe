//# Imports

import . {
  extract_keys, has_vars, render, render_map
}

//# Misc

bench "template/render_simple" {
  let _ = render("Hello, {{name}}!", [
    ("name", "Alice")
  ])
}

bench "template/render_multi" {
  let _ = render("{{a}}-{{b}}-{{c}}-{{d}}", [
    ("a", "1"),
    ("b", "2"),
    ("c", "3"),
    ("d", "4")
  ])
}

bench "template/render_map" {
  let _ = render_map("Hello {{name}}, welcome to {{place}}!", Map::from_pairs([
    ("name", "Bob"),
    ("place", "Tokyo")
  ]))
}

bench "template/has_vars" {
  let _ = has_vars("Hello {{name}}, your score is {{score}}.")
}

bench "template/extract_keys" {
  let _ = extract_keys("{{a}} and {{b}} and {{c}} and {{d}}")
}
