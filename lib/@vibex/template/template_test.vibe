//# Imports

import . {
  extract_keys, has_vars, render, render_map
}

//# Functions

let empty_pairs = () -> Array[(String, String)] {
  Array::slice([
    ("", "")
  ], 0, 0)
}

//# Misc

test "render with array pairs" {
  let result = render("Hello, {{name}}! You are {{age}}.", [
    ("name", "Alice"),
    ("age", "25")
  ])
  assert(result == "Hello, Alice! You are 25.")
}

test "render no vars" {
  let result = render("no vars here", empty_pairs())
  assert(result == "no vars here")
}

test "render multiple occurrences" {
  let result = render("{{x}} and {{x}}", [
    ("x", "42")
  ])
  assert(result == "42 and 42")
}

test "render empty template" {
  let result = render("", [
    ("x", "42")
  ])
  assert(result == "")
}

test "render multiple vars" {
  let result = render("{{a}}-{{b}}-{{c}}", [
    ("a", "1"),
    ("b", "2"),
    ("c", "3")
  ])
  assert(result == "1-2-3")
}

test "render var at start" {
  let result = render("{{x}} end", [
    ("x", "start")
  ])
  assert(result == "start end")
}

test "render var at end" {
  let result = render("start {{x}}", [
    ("x", "end")
  ])
  assert(result == "start end")
}

test "render var is entire template" {
  let result = render("{{x}}", [
    ("x", "hello")
  ])
  assert(result == "hello")
}

test "render unmatched var preserved" {
  let result = render("{{a}} {{b}}", [
    ("a", "ok")
  ])
  assert(String::contains(result, "ok"))
}

test "render adjacent vars" {
  let result = render("{{a}}{{b}}", [
    ("a", "foo"),
    ("b", "bar")
  ])
  assert(result == "foobar")
}

test "render empty value" {
  let result = render("before{{x}}after", [
    ("x", "")
  ])
  assert(result == "beforeafter")
}

test "render special chars in value" {
  let result = render("msg={{m}}", [
    ("m", "hello world & 'bye'")
  ])
  assert(result == "msg=hello world & 'bye'")
}

test "render_map with map" {
  let result = render_map("Hi {{name}}", map {
    name: "Bob"
  })
  assert(result == "Hi Bob")
}

test "render_map missing key preserved" {
  let result = render_map("{{found}} {{missing}}", map {
    found: "ok"
  })
  assert(String::contains(result, "ok"))
  assert(String::contains(result, "{{missing}}"))
}

test "render_map multiple vars" {
  let result = render_map("{{a}}+{{b}}", map {
    a: "1",
    b: "2"
  })
  assert(result == "1+2")
}

test "render_map empty template" {
  let result = render_map("", map {
    x: "y"
  })
  assert(result == "")
}

test "render_map no vars in template" {
  let result = render_map("plain text", map {
    x: "y"
  })
  assert(result == "plain text")
}

test "has_vars detects placeholders" {
  assert(has_vars("{{x}}"))
  assert(not(has_vars("no vars")))
}

test "has_vars single braces" {
  assert(not(has_vars("{x}")))
}

test "has_vars empty string" {
  assert(not(has_vars("")))
}

test "has_vars multiple vars" {
  assert(has_vars("{{a}} and {{b}}"))
}

test "has_vars var in middle" {
  assert(has_vars("before {{x}} after"))
}

test "extract_keys finds all keys" {
  let keys = extract_keys("{{a}} and {{b}} and {{c}}")
  assert(Array::length(keys) == 3)
  assert(Array::get(keys, 0) == "a")
  assert(Array::get(keys, 1) == "b")
  assert(Array::get(keys, 2) == "c")
}

test "extract_keys no vars" {
  let keys = extract_keys("no vars here")
  assert(Array::length(keys) == 0)
}

test "extract_keys empty string" {
  let keys = extract_keys("")
  assert(Array::length(keys) == 0)
}

test "extract_keys single key" {
  let keys = extract_keys("{{name}}")
  assert(Array::length(keys) == 1)
  assert(Array::get(keys, 0) == "name")
}

test "extract_keys with surrounding text" {
  let keys = extract_keys("Hello {{name}}, welcome to {{place}}!")
  assert(Array::length(keys) == 2)
  assert(Array::get(keys, 0) == "name")
  assert(Array::get(keys, 1) == "place")
}

test "extract_keys adjacent" {
  let keys = extract_keys("{{a}}{{b}}")
  assert(Array::length(keys) == 2)
}
