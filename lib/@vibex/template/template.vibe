//# Functions

// Was `import ../collect { empty_array }` — inlined on the @vibex move
// (ADR-0065) so the package has no cross-package dependency for a one-liner.
fn empty_array[T]() -> Array[T] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

// host-era rot (#742 class): `String::replace_all` never existed under
// selfhost and `"\(key)"` was the retired host interpolation spelling —
// a pure-vibe scan/concat replacement (String::index_of is the SIMD builtin).
fn replace_all(s: String, needle: String, replacement: String) -> String {
  let nlen = String::length(needle)
  if nlen == 0 {
    s
  } else {
    let mut out = ""
    let mut rest = s
    let mut idx = String::index_of(rest, needle)
    while idx >= 0 {
      out = String::concat(out, String::concat(String::substring(rest, 0, idx), replacement))
      rest = String::substring(rest, idx + nlen, String::length(rest))
      idx = String::index_of(rest, needle)
    }
    String::concat(out, rest)
  }
}

export fn render(template: String, vars: Array[(String, String)]) -> String {
  let mut result = template
  let var_count = Array::length(vars)
  let mut idx = 0
  while idx < var_count {
    let (key, value) = Array::get(vars, idx)
    let placeholder = String::concat("{{", String::concat(key, "}}"))
    result = replace_all(result, placeholder, value)
    idx = idx + 1
  }
  result
}

export fn has_vars(template: String) -> Bool {
  String::contains(template, "{{") && String::contains(template, "}}")
}

fn find_close(s: String, start: Int) -> Int {
  let len = String::length(s)
  let mut idx = start
  let mut found = -1
  while idx + 1 < len && found < 0 {
    if s[idx: idx + 2] == "}}" {
      found = idx
    } else {
      idx = idx + 1
    }
  }
  found
}

export fn render_map(template: String, vars: Map[String, String]) -> String {
  let len = String::length(template)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    if i + 1 < len && template[i: i + 2] == "{{" {
      let close = find_close(template, i + 2)
      if close > 0 {
        let key = String::trim(template[i + 2: close])
        if Map::has_key(vars, key) {
          StringBuilder::push(sb, Map::get(vars, key))
        } else {
          StringBuilder::push(sb, template[i: close + 2])
        }
        i = close + 2
      } else {
        StringBuilder::push(sb, template[i: i + 1])
        i = i + 1
      }
    } else {
      StringBuilder::push(sb, template[i: i + 1])
      i = i + 1
    }
  }
  StringBuilder::freeze(sb)
}

export fn extract_keys(template: String) -> Array[String] {
  let len = String::length(template)
  let keys: Array[String] = empty_array()
  let mut i = 0
  while i < len {
    if i + 1 < len && template[i: i + 2] == "{{" {
      let close = find_close(template, i + 2)
      if close > 0 {
        let key = String::trim(template[i + 2: close])
        Array::push(keys, key)
        i = close + 2
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  keys
}

export let version: String = "0.0.1"
