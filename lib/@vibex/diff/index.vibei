version 0.0.1

// @vibex/diff — 行単位 diff + unified 形式整形 (ADR-0065 実験 scope)。

import ./diff.vibe {}

type DiffOp

fn diff_lines(old_text: String, new_text: String) -> Array[DiffOp]
fn format_unified(ops: Array[DiffOp]) -> String
fn has_changes(ops: Array[DiffOp]) -> Bool
fn count_additions(ops: Array[DiffOp]) -> Int
fn count_deletions(ops: Array[DiffOp]) -> Int

let version: String
