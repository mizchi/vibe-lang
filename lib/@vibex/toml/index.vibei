version 0.0.1

// @vibex/toml — TOML parse + TomlValue アクセサ (ADR-0065 実験 scope)。

import ./toml.vibe {}

type TomlValue

fn parse(text: String) -> TomlValue
fn TomlValue::get(table: TomlValue, key: String) -> TomlValue
fn TomlValue::as_string(v: TomlValue) -> String
fn TomlValue::as_int(v: TomlValue) -> Int
fn TomlValue::as_float(v: TomlValue) -> Double
fn TomlValue::as_bool(v: TomlValue) -> Bool
fn TomlValue::as_array(v: TomlValue) -> Array[TomlValue]
fn TomlValue::as_table(v: TomlValue) -> Array[(String, TomlValue)]

let version: String
