//# Imports

import ./toml.vibe {
  TomlValue::as_bool, TomlValue::as_int, TomlValue::as_string, TomlValue::get, parse
}

//# Misc

bench "toml/parse_simple" {
  let _ = parse("name = \"app\"\nversion = 42\nenabled = true")
}

bench "toml/parse_section" {
  let _ = parse("[server]\nhost = \"localhost\"\nport = 8080\nssl = true")
}

bench "toml/parse_multi_section" {
  let _ = parse("[db]\nhost = \"pg\"\nport = 5432\n[cache]\nhost = \"redis\"\nport = 6379\n[app]\nname = \"test\"\ndebug = false")
}

bench "toml/parse_array" {
  let _ = parse("tags = [1, 2, 3, 4, 5]\nnames = [\"a\", \"b\", \"c\"]")
}

bench "toml/get_key" {
  let doc = parse("a = 1\nb = 2\nc = 3\nd = 4\ne = 5")
  let _ = TomlValue::as_int(TomlValue::get(doc, "e"))
}
