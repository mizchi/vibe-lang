//# Imports

import .{
  Json, JsonSchema, validate
}

//# Misc

test "jsonschema any/null/bool primitives" {
  assert(validate(schema = SAny, value = JStr("x")))
  assert(validate(schema = SNull, value = JNull))
  assert(not(validate(schema = SNull, value = JNum(0.0))))
  assert(validate(schema = SBool, value = JBool(true)))
  assert(not(validate(schema = SBool, value = JStr("true"))))
}

test "jsonschema string and number" {
  assert(validate(schema = SString, value = JStr("ok")))
  assert(not(validate(schema = SString, value = JNum(1.0))))
  assert(validate(schema = SNumber, value = JNum(3.14)))
  assert(not(validate(schema = SNumber, value = JBool(false))))
}

test "jsonschema array item validation" {
  let numbers = SArray(SNumber)
  assert(validate(schema = numbers, value = JArr([
    JNum(1.0),
    JNum(2.0),
    JNum(3.0)
  ])))
  assert(not(validate(schema = numbers, value = JArr([JNum(1.0), JStr("x")]))))
}

test "jsonschema object required and typed properties" {
  let person = SObject(["name", "age"], [("name", SString), ("age", SNumber)])
  let ok = JObj(Map::from_pairs([("name", JStr("alice")), ("age", JNum(20.0))]))
  let missing = JObj(Map::from_pairs([("name", JStr("alice"))]))
  let bad = JObj(Map::from_pairs([("name", JStr("alice")), ("age", JStr("20"))]))
  assert(validate(schema = person, value = ok))
  assert(not(validate(schema = person, value = missing)))
  assert(not(validate(schema = person, value = bad)))
}

test "jsonschema object allows extra keys" {
  let person = SObject(["name"], [("name", SString)])
  let with_extra = JObj(Map::from_pairs([
    ("name", JStr("alice")),
    ("city", JStr("tokyo"))
  ]))
  assert(validate(schema = person, value = with_extra))
}

test "jsonschema one_of" {
  let union = SOneOf([SString, SNumber])
  assert(validate(schema = union, value = JStr("x")))
  assert(validate(schema = union, value = JNum(1.0)))
  assert(not(validate(schema = union, value = JBool(true))))
}

test "jsonschema nested object array" {
  let item = SObject(["id"], [("id", SNumber)])
  let schema = SArray(item)
  let ok = JArr([
    JObj(Map::from_pairs([("id", JNum(1.0))])),
    JObj(Map::from_pairs([("id", JNum(2.0))])),
  ])
  let bad = JArr([
    JObj(Map::from_pairs([("id", JNum(1.0))])),
    JObj(Map::from_pairs([("id", JStr("oops"))])),
  ])
  assert(validate(schema = schema, value = ok))
  assert(not(validate(schema = schema, value = bad)))
}
