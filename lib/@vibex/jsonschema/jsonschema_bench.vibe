//# Imports

import .{
  type Json, type JsonSchema, validate
}

//# Functions

let nested_ok: Json = JObj(Map::from_pairs([
  ("items", JArr([
    JObj(Map::from_pairs([("id", JNum(1.0)), ("kind", JStr("a"))])),
    JObj(Map::from_pairs([("id", JNum(2.0)), ("kind", JStr("b"))])),
    JObj(Map::from_pairs([("id", JNum(3.0)), ("kind", JStr("c"))]))
  ])),
  ("meta", JObj(Map::from_pairs([("version", JNum(1.0))])))
]))

let person_ok: Json = JObj(Map::from_pairs([
  ("id", JNum(1.0)),
  ("name", JStr("alice")),
  ("active", JBool(true)),
  ("score", JNum(98.5)),
  ("city", JStr("tokyo"))
]))

let nested_bad: Json = JObj(Map::from_pairs([
  ("items", JArr([
    JObj(Map::from_pairs([("id", JNum(1.0)), ("kind", JStr("a"))])),
    JObj(Map::from_pairs([("id", JStr("2")), ("kind", JStr("b"))])),
    JObj(Map::from_pairs([("id", JNum(3.0)), ("kind", JStr("c"))]))
  ])),
  ("meta", JObj(Map::from_pairs([("version", JNum(1.0))])))
]))

let person_bad: Json = JObj(Map::from_pairs([
  ("id", JNum(1.0)),
  ("name", JStr("alice")),
  ("active", JBool(true)),
  ("score", JStr("98.5"))
]))

let item_schema: JsonSchema = SObject(["id", "kind"], [
  ("id", SNumber),
  ("kind", SString)
])

let nested_schema: JsonSchema = SObject(["items", "meta"], [
  ("items", SArray(item_schema)),
  ("meta", SObject(["version"], [("version", SNumber)]))
])

let person_schema: JsonSchema = SObject(["id", "name", "active", "score"], [
  ("id", SNumber),
  ("name", SString),
  ("active", SBool),
  ("score", SNumber)
])

//# Misc

bench "jsonschema/person_ok" {
  let _ = validate(person_schema, person_ok)
}

bench "jsonschema/person_bad" {
  let _ = validate(person_schema, person_bad)
}

bench "jsonschema/nested_ok" {
  let _ = validate(nested_schema, nested_ok)
}

bench "jsonschema/nested_bad" {
  let _ = validate(nested_schema, nested_bad)
}
