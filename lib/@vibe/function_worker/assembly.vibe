    dbgargs_base: dbgargs_base,
    dbgargs_cap: dbgargs_cap,
    dbgargs_count_addr: dbgargs_count_addr,
    dbgargs_reserve: dbgargs_reserve,
    div_zero_abort_idx: div_zero_abort_idx,
    double_to_int_idx: double_to_int_idx,
