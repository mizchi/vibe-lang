  fa_put_int(b, sections.lambda_slot_base)
  fa_put_bool(b, sections.library_mode)
  fa_put_bool(b, sections.linemap_on)
  fa_put_linemap(b, sections.linemap_state)
  fa_put_imports(b, sections.linked_imports)
  fa_put_lambdas(b, sections.lt_w)
  fa_put_bool(b, sections.need_div_zero_abort)
