    sh_capture_close_import_idx: sh_capture_close_import_idx,
    sh_capture_exit_code_import_idx: sh_capture_exit_code_import_idx,
    sh_capture_import_idx: sh_capture_import_idx,
    sh_capture_stderr_import_idx: sh_capture_stderr_import_idx,
    sh_capture_stdout_import_idx: sh_capture_stdout_import_idx,
    sh_import_idx: sh_import_idx,
    sh_lines_import_idx: sh_lines_import_idx,
    shadow_uaf_abort_idx: shadow_uaf_abort_idx,
    simd_scan_alnum_idx: simd_scan_alnum_idx,
    simd_scan_alnum_str_idx: simd_scan_alnum_str_idx,
    simd_scan_line_end_str_idx: simd_scan_line_end_str_idx,
    simd_scan_string_special_str_idx: simd_scan_string_special_str_idx,
    simd_skip_ws_idx: simd_skip_ws_idx,
    sleep_import_idx: sleep_import_idx,
    sleep_needs_component_adapter: sleep_needs_component_adapter,
    sources_idx: sources_idx,
    stderr_write_char_import_idx: stderr_write_char_import_idx,
    stderr_write_stream_import_idx: stderr_write_stream_import_idx,
    stdin_provider_acquire_import_idx: stdin_provider_acquire_import_idx,
    stdin_provider_close_import_idx: stdin_provider_close_import_idx,
    stdin_provider_read_import_idx: stdin_provider_read_import_idx,
    stdin_read_char_import_idx: stdin_read_char_import_idx,
    stdin_read_stream_import_idx: stdin_read_stream_import_idx,
    stdout_write_char_import_idx: stdout_write_char_import_idx,
    stdout_write_stream_import_idx: stdout_write_stream_import_idx,
    str_char_code_at_idx: str_char_code_at_idx,
    str_concat_idx: str_concat_idx,
    str_eq_idx: str_eq_idx,
    str_from_char_code_idx: str_from_char_code_idx,
    str_len_idx: str_len_idx,
    str_lex_diff_idx: str_lex_diff_idx,
    str_offsets: str_offsets,
    str_strs: str_strs,
    str_substring_idx: str_substring_idx,
    string_contains_idx: string_contains_idx,
    string_ends_with_idx: string_ends_with_idx,
    string_index_of_idx: string_index_of_idx,
    string_join_idx: string_join_idx,
    string_last_index_of_idx: string_last_index_of_idx,
    string_split_idx: string_split_idx,
    string_starts_with_idx: string_starts_with_idx,
    string_trim_idx: string_trim_idx,
    table_slots_used: table_slots_used,
    tcp_close_import_idx: tcp_close_import_idx,
    tcp_connect_import_idx: tcp_connect_import_idx,
    tcp_read_import_idx: tcp_read_import_idx,
    tcp_write_import_idx: tcp_write_import_idx,
    test_fn_names: test_fn_names,
    thunk_names_list: thunk_names_list,
    trace_cap: trace_cap,
    trace_counter_addr: trace_counter_addr,
    trace_log_base: trace_log_base,
    trace_reserve: trace_reserve
  }
  let builtins = LinkedBuiltinBodies::{
    bodies: bodies,
    builtin_type_idxs: types,
    meta_i32: i32s,
    meta_i64: i64s,
    meta_v128: v128s
  }
  let replay = FunctionReplayState::{
    validation: validation,
    builtins: builtins,
    guard_layout: layout,
    publish_layout: publish,
    placed_files: placed,
    lambdas: lt_w,
    slots: table_slots_used,
    blind_owners: blind_owners,
    blind_offsets: blind_offsets,
    blind_kinds: blind_kinds,
    blind_syms: blind_syms,
    linemap: linemap_state,
    cache: cache,
    used: false
  }
  let state = FunctionAssembly::{
    sections: sections,
    replay: replay,
    enable_rc: enable_rc
  }
  fa_check(state)
  state
}

/// Canonical replay validates the complete product before modifying any output
/// cell. Final sections consume only the decoded owned state and real products.
export fn finish_function_assembly(state: FunctionAssembly, products: CodegenBodyCache) -> Bytes with Exception {
  fa_check(state)
  let body = replay_function_state(state.replay, products)
  lc_emit_module_sections(LinkedSectionInputs::{
    plan: state.sections,
    body: body
  }, false, false, false, state.enable_rc, false)
}

export fn FunctionAssembly::write_function_assembly(recv: FunctionAssembly, context_digest: String) -> Bytes with Exception {
  write_function_assembly(recv, context_digest)
}

export fn FunctionAssembly::finish_function_assembly(recv: FunctionAssembly, products: CodegenBodyCache) -> Bytes with Exception {
  finish_function_assembly(recv, products)
}
