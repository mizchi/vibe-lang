  let simd_scan_alnum_idx = fa_get_int(r)
  let simd_scan_alnum_str_idx = fa_get_int(r)
  let simd_scan_line_end_str_idx = fa_get_int(r)
  let simd_scan_string_special_str_idx = fa_get_int(r)
  let simd_skip_ws_idx = fa_get_int(r)
  let sleep_import_idx = fa_get_int(r)
  let sleep_needs_component_adapter = fa_get_bool(r)
  let sources_idx = fa_get_int(r)
  let stderr_write_char_import_idx = fa_get_int(r)
  let stderr_write_stream_import_idx = fa_get_int(r)
  let stdin_provider_acquire_import_idx = fa_get_int(r)
  let stdin_provider_close_import_idx = fa_get_int(r)
  let stdin_provider_read_import_idx = fa_get_int(r)
  let stdin_read_char_import_idx = fa_get_int(r)
  let stdin_read_stream_import_idx = fa_get_int(r)
  let stdout_write_char_import_idx = fa_get_int(r)
  let stdout_write_stream_import_idx = fa_get_int(r)
  let str_char_code_at_idx = fa_get_int(r)
  let str_concat_idx = fa_get_int(r)
  let str_eq_idx = fa_get_int(r)
  let str_from_char_code_idx = fa_get_int(r)
  let str_len_idx = fa_get_int(r)
  let str_lex_diff_idx = fa_get_int(r)
  let str_offsets = fa_get_ints(r)
  let str_substring_idx = fa_get_int(r)
  let string_contains_idx = fa_get_int(r)
  let string_ends_with_idx = fa_get_int(r)
  let string_index_of_idx = fa_get_int(r)
  let string_join_idx = fa_get_int(r)
  let string_last_index_of_idx = fa_get_int(r)
  let string_split_idx = fa_get_int(r)
  let string_starts_with_idx = fa_get_int(r)
  let string_trim_idx = fa_get_int(r)
  let table_slots_used = fa_get_ints(r)
  let tcp_close_import_idx = fa_get_int(r)
  let tcp_connect_import_idx = fa_get_int(r)
  let tcp_read_import_idx = fa_get_int(r)
  let tcp_write_import_idx = fa_get_int(r)
  let test_fn_names = fa_get_strings(r)
  let thunk_names_list = fa_get_strings(r)
  let trace_cap = fa_get_int(r)
  let trace_counter_addr = fa_get_int(r)
  let trace_log_base = fa_get_int(r)
  let trace_reserve = fa_get_int(r)
  let n = ast_binary_read_count_checked(r)
  let bodies: Array[Bytes] = []
  let mut i = 0
  while i < n {
    Array::push(bodies, fa_get_bytes(r)); i = i + 1
  }
  let types = fa_get_ints(r)
  let i32s = fa_get_ints(r)
  let i64s = fa_get_ints(r)
  let v128s = fa_get_ints(r)
  let layout = fa_get_ints(r)
  let publish = fa_get_bool(r)
  let placed = fa_get_ints(r)
  let collect = fa_get_int(r)
  fa_require(collect == 0 || collect == 1, "invalid cache collection flag")
  let cache = match linear_body_cache_from_bytes(fa_get_bytes(r)) {
    Some(value) => value,
    None => throw("function assembly: invalid cache template")
  }
  Array::set(cache.collect, 0, collect)
  fa_require(ast_binary_reader_remaining(r) == 0, "trailing packet bytes")
  // Version7 puts the complete literal pool before worker metadata and syntax.
  let prefix = linear_string_reader(shared)
  fa_require(fa_get_string(prefix) == "vibe-function-context-7", "unsupported context")
  let str_strs = fa_get_strings(prefix)
  let debug_break = fa_get_bool(prefix)
  let debug_trace = fa_get_bool(prefix)
  let context_rc = fa_get_bool(prefix)
  let shadow = fa_get_bool(prefix)
  let exceptions = fa_get_bool(prefix)
  fa_require(!debug_break && !debug_trace && !shadow && context_rc == enable_rc && (!exceptions || facts.uses_exceptions), "context modes differ")
  let sections = LinkedSectionPlan::{
    arr_concat_idx: arr_concat_idx,
    arr_get_idx: arr_get_idx,
    arr_len_idx: arr_len_idx,
    arr_new_idx: arr_new_idx,
