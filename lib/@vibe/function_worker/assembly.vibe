  fa_put_int(b, sections.fs_remove_import_idx)
  fa_put_int(b, sections.fs_remove_tree_import_idx)
  fa_put_int(b, sections.fs_rename_import_idx)
  fa_put_int(b, sections.fs_stat_token_import_idx)
  fa_put_int(b, sections.fs_stat_token_stub_idx)
  fa_put_int(b, sections.fs_write_bytes_import_idx)
  fa_put_int(b, sections.fs_write_bytes_stub_idx)
  fa_put_int(b, sections.fs_write_file_import_idx)
  fa_put_int(b, sections.fs_write_file_stub_idx)
  fa_put_int(b, sections.func_offset)
  fa_put_int(b, sections.generic_add_idx)
  fa_put_int(b, sections.generic_rel_diff_idx)
  fa_put_int(b, sections.heap_grow_check_idx)
  fa_put_int(b, sections.heap_start)
  fa_put_strings(b, sections.hf_all_names)
  fa_put_int(b, sections.hf_arg_push_import_idx)
  fa_put_int(b, sections.hf_arm_import_idx)
  fa_put_int(b, sections.hf_cancel_import_idx)
  fa_put_int(b, sections.hf_get_import_idx)
  fa_put_strings(b, sections.hf_named_names)
  fa_put_strings(b, sections.hf_response_addresses)
  fa_put_strings(b, sections.hf_response_arg_addresses)
  fa_put_int(b, sections.hf_wait_any_import_idx)
  fa_put_int(b, sections.hf_wait_import_idx)
  fa_put_strings(b, sections.hf_wit_names)
  fa_put_int(b, sections.hs_arm_import_idx)
  fa_put_int(b, sections.hs_cancel_import_idx)
