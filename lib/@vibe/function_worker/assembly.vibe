// Private assembly packet: owned metadata and fresh output cells, with no AST.
// The original phase receipt must bind both packet and shared-context bytes.
import @vibe/compiler/cache {
  AstBinaryReader,
  ast_binary_read_bool_checked,
  ast_binary_read_count_checked,
  ast_binary_read_string_checked,
  ast_binary_read_svarint_checked,
  ast_binary_reader_remaining,
  ast_binary_write_bool,
  ast_binary_write_svarint,
  ast_binary_write_varint
}
import @vibe/compiler/codegen/wasi {
  LinkedBuiltinBodies,
  LinkedModulePreparation,
  LinkedSectionFacts,
  LinkedSectionInputs,
  LinkedSectionPlan,
  lc_emit_module_sections,
  lc_function_linemap_new
}
import @vibe/compiler/codegen/common_base {
  CodegenBodyCache, CovState, DbgProv, LambdaTable, LineMapState, codegen_body_cache_to_bytes
}
import @vibe/lowering_worker/linear {
  linear_body_cache_from_bytes, linear_string_reader
}
import @vibe/blake3/simd {
  blake3_bytes_simd
}
import ./product.vibe {
  function_product_plan_new
}
import ./product_plan_wire.vibe {
  read_function_product_plan, write_function_product_plan
}
import ./replay.vibe {
  FunctionReplayState, function_replay_state_new, replay_function_state
}

/// No syntax, source text, function-emitter closure, Store handle or compiler
/// input record is retained. The section and replay records share fresh output
/// cells within this instance; their owned wire form crosses the native phase.
export struct FunctionAssembly {
  sections: LinkedSectionPlan;
  replay: FunctionReplayState;
  enable_rc: Bool
}

fn fa_require(ok: Bool, message: String) -> Unit with Exception {
  if !ok {
    throw("function assembly: " + message)
  } else ()
}

fn fa_digest(value: String) -> Unit with Exception {
  fa_require(String::length(value) == 64, "invalid digest")
  let mut i = 0
  while i < 64 {
    let c = String::char_code_at(value, i)
    fa_require((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'), "invalid digest")
    i = i + 1
  }
}

// Reserve a conservative varint allowance before any variable-size append.
// Ordinary Bytes growth keeps small packets from reserving another64MiB.
fn fa_room(b: Bytes, length: Int) -> Unit with Exception {
  fa_require(length >= 0 && length <= 64 * 1024 * 1024 - 10 && Bytes::length(b) <= 64 * 1024 * 1024 - 10 - length, "exceeds64MiB")
}
fn fa_put_int(b: Bytes, value: Int) -> Unit with Exception {
  fa_room(b, 0); ast_binary_write_svarint(b, value)
}
fn fa_get_int(r: AstBinaryReader) -> Int with Exception {
  ast_binary_read_svarint_checked(r)
}
fn fa_put_bool(b: Bytes, value: Bool) -> Unit with Exception {
  fa_room(b, 0); ast_binary_write_bool(b, value)
}
fn fa_get_bool(r: AstBinaryReader) -> Bool with Exception {
  ast_binary_read_bool_checked(r)
}
fn fa_put_count(b: Bytes, value: Int) -> Unit with Exception {
  fa_room(b, 0); fa_require(value >= 0, "negative count")
  ast_binary_write_varint(b, value)
}
fn fa_put_string(b: Bytes, value: String) -> Unit with Exception {
  fa_room(b, String::length(value))
  ast_binary_write_varint(b, String::length(value))
  let mut i = 0
  while i < String::length(value) {
    Bytes::push(b, String::char_code_at(value, i)); i = i + 1
  }
}
fn fa_get_string(r: AstBinaryReader) -> String with Exception {
  ast_binary_read_string_checked(r)
}
fn fa_put_bytes(b: Bytes, value: Bytes) -> Unit with Exception {
  fa_room(b, Bytes::length(value))
  ast_binary_write_varint(b, Bytes::length(value))
  Bytes::blit(b, value, 0, Bytes::length(value))
}
fn fa_get_bytes(r: AstBinaryReader) -> Bytes with Exception {
  let n = ast_binary_read_count_checked(r)
  let value = Bytes::slice(r.bytes, r.pos, r.pos + n)
  r.pos = r.pos + n
  value
}
fn fa_put_ints(b: Bytes, values: Array[Int]) -> Unit with Exception {
  fa_put_count(b, Array::length(values))
  for value in values {
    fa_put_int(b, value)
  }
  ()
}
fn fa_get_ints(r: AstBinaryReader) -> Array[Int] with Exception {
  let n = ast_binary_read_count_checked(r)
  let values: Array[Int] = []
  let mut i = 0
  while i < n {
    Array::push(values, fa_get_int(r)); i = i + 1
  }
  values
}
fn fa_put_strings(b: Bytes, values: Array[String]) -> Unit with Exception {
  fa_put_count(b, Array::length(values))
  for value in values {
    fa_put_string(b, value)
  }
  ()
}
fn fa_get_strings(r: AstBinaryReader) -> Array[String] with Exception {
  let n = ast_binary_read_count_checked(r)
  let values: Array[String] = []
  let mut i = 0
  while i < n {
    Array::push(values, fa_get_string(r)); i = i + 1
  }
  values
}
fn fa_put_int_matrix(b: Bytes, values: Array[Array[Int]]) -> Unit with Exception {
  fa_put_count(b, Array::length(values))
  for value in values {
    fa_put_ints(b, value)
  }
  ()
}
fn fa_get_int_matrix(r: AstBinaryReader) -> Array[Array[Int]] with Exception {
  let n = ast_binary_read_count_checked(r)
  let values: Array[Array[Int]] = []
  let mut i = 0
  while i < n {
    Array::push(values, fa_get_ints(r)); i = i + 1
  }
  values
}
fn fa_put_string_matrix(b: Bytes, values: Array[Array[String]]) -> Unit with Exception {
  fa_put_count(b, Array::length(values))
  for value in values {
    fa_put_strings(b, value)
  }
  ()
}
fn fa_get_string_matrix(r: AstBinaryReader) -> Array[Array[String]] with Exception {
  let n = ast_binary_read_count_checked(r)
  let values: Array[Array[String]] = []
  let mut i = 0
  while i < n {
    Array::push(values, fa_get_strings(r)); i = i + 1
  }
  values
}
fn fa_put_imports(b: Bytes, values: Array[(String, String, Int, Int)]) -> Unit with Exception {
  fa_put_count(b, Array::length(values))
  for value in values {
    let (import_module, name, arity, index) = value
    fa_put_string(b, import_module); fa_put_string(b, name)
    fa_put_int(b, arity); fa_put_int(b, index)
  }
  ()
}
fn fa_get_imports(r: AstBinaryReader) -> Array[(String, String, Int, Int)] with Exception {
  let n = ast_binary_read_count_checked(r)
  let values: Array[(String, String, Int, Int)] = []
  let mut i = 0
  while i < n {
    let import_module = fa_get_string(r)
    let name = fa_get_string(r)
    let arity = fa_get_int(r)
    let index = fa_get_int(r)
    Array::push(values, (import_module, name, arity, index)); i = i + 1
  }
  values
}
fn fa_put_facts(b: Bytes, value: LinkedSectionFacts) -> Unit with Exception {
  fa_put_bool(b, value.entry_returns_unit); fa_put_bool(b, value.uses_exceptions)
  fa_put_string_matrix(b, value.debug_param_names)
  fa_put_bool(b, value.strip_executable_exports)
}
fn fa_get_facts(r: AstBinaryReader) -> LinkedSectionFacts with Exception {
  let unit = fa_get_bool(r)
  let exceptions = fa_get_bool(r)
  let names = fa_get_string_matrix(r)
  let strip = fa_get_bool(r)
  LinkedSectionFacts::{
    entry_returns_unit: unit,
    uses_exceptions: exceptions,
    debug_param_names: names,
    strip_executable_exports: strip
  }
}
fn fa_put_prov(b: Bytes, value: DbgProv) -> Unit with Exception {
  fa_put_strings(b, value.files); fa_put_int_matrix(b, value.file_nls)
  fa_put_ints(b, value.stmt_file_id)
}
fn fa_get_prov(r: AstBinaryReader) -> DbgProv with Exception {
  let files = fa_get_strings(r)
  let nls = fa_get_int_matrix(r)
  let owners = fa_get_ints(r)
  DbgProv::{ files: files, file_nls: nls, stmt_file_id: owners }
}
fn fa_put_cov(b: Bytes, value: CovState) -> Unit with Exception {
  fa_require(!value.enabled && Array::length(value.next) == 1 && Array::get(value.next, 0) == 0 && Array::length(value.cur_fn) == 1 && Array::get(value.cur_fn, 0) == 0 && Array::length(value.owners) == 0, "coverage or consumed coverage state")
  fa_put_int(b, value.base); fa_put_int(b, value.cap)
}
fn fa_get_cov(r: AstBinaryReader) -> CovState with Exception {
  let base = fa_get_int(r)
  let cap = fa_get_int(r)
  CovState::{
    enabled: false,
    base: base,
    cap: cap,
    next: [0],
    cur_fn: [0],
    owners: []
  }
}
fn fa_check_linemap(value: LineMapState) -> Unit with Exception {
  fa_require(Array::length(value.cur_fn) == 1 && Array::get(value.cur_fn, 0) == 0 && Array::length(value.site) == 1 && Array::get(value.site, 0) == 0 && Array::length(value.funcs) == 0 && Array::length(value.offsets) == 0 && Array::length(value.file_ids) == 0 && Array::length(value.lines) == 0 && Array::length(value.grp_fn) == 0 && Array::length(value.grp_start) == 0 && Array::length(value.grp_first_off) == 0 && Bytes::length(value.stream) == 0, "expected a fresh line publisher")
}
fn fa_put_linemap(b: Bytes, value: LineMapState) -> Unit with Exception {
  fa_check_linemap(value); fa_put_bool(b, value.enabled)
}
fn fa_get_linemap(r: AstBinaryReader) -> LineMapState with Exception {
  lc_function_linemap_new(fa_get_bool(r))
}
fn fa_check_lambdas(value: LambdaTable) -> Unit with Exception {
  fa_require(value.base == 0 && Array::length(value.bodies) == 0 && Array::length(value.param_counts) == 0 && Array::length(value.captures) == 0 && Array::length(value.meta_i32) == 0 && Array::length(value.meta_i64) == 0, "expected fresh whole-module lambdas")
}
fn fa_put_lambdas(b: Bytes, value: LambdaTable) -> Unit with Exception {
  fa_check_lambdas(value)
}
fn fa_get_lambdas(r: AstBinaryReader) -> LambdaTable {
  LambdaTable::{
    base: 0,
    bodies: [],
    param_counts: [],
    captures: [],
    meta_i32: [],
    meta_i64: []
  }
}

fn fa_check(state: FunctionAssembly) -> Unit with Exception {
  let sections = state.sections
  let replay = state.replay
  let plan = replay.validation
  fa_require(!replay.used, "assembly was already consumed")
  fa_require(!sections.library_mode && !sections.cov_state.enabled, "library and coverage modes are unsupported")
  // Section name/signature tables include the appended builtin aliases;
  // only their leading user range belongs to the executable function plan.
  fa_require(sections.num_user_funcs == plan.num_user_funcs && Array::length(plan.fn_names) == plan.num_user_funcs && Array::length(sections.fn_names_list) >= plan.num_user_funcs && Array::length(sections.fn_param_counts) == Array::length(sections.fn_names_list), "function column counts differ")
  let mut fi = 0
  while fi < plan.num_user_funcs {
    fa_require(Array::get(sections.fn_names_list, fi) == Array::get(plan.fn_names, fi), "planned function name differs")
    fi = fi + 1
  }
  fa_require(sections.lambda_slot_base == plan.lambda_slot_base, "lambda slot base differs")
  fa_require(sections.linemap_on == plan.linemap_on && sections.linemap_state.enabled == plan.linemap_on, "line publisher mode differs")
  fa_require(Array::length(sections.prov.files) == plan.source_file_count, "source file count differs")
  fa_require(sections.num_strings == Array::length(sections.str_strs) && Array::length(sections.str_offsets) == sections.num_strings, "literal pool columns differ")
  let n = Array::length(replay.builtins.bodies)
  fa_require(n == sections.num_generated && Array::length(replay.builtins.builtin_type_idxs) == n && Array::length(replay.builtins.meta_i32) == n && Array::length(replay.builtins.meta_i64) == n && Array::length(replay.builtins.meta_v128) == n, "builtin columns differ")
  fa_require(Array::length(replay.placed_files) == (if plan.linemap_on {
    plan.num_user_funcs
  } else {
    0
  }), "line placement columns differ")
  fa_require(Array::length(sections.table_slots_used) == 0 && Array::length(sections.blind_owners) == 0 && Array::length(sections.blind_offsets) == 0 && Array::length(sections.blind_kinds) == 0 && Array::length(sections.blind_syms) == 0, "expected fresh relocation output")
  fa_check_linemap(sections.linemap_state)
  fa_check_lambdas(sections.lt_w)
}

/// Project while syntax is still available, then consume the preparation token.
/// The result keeps only owned assembly/validation data and empty output cells.
export fn function_assembly_new(prepared: LinkedModulePreparation) -> FunctionAssembly with Exception {
  fa_require(!prepared.used, "preparation was already consumed")
  fa_require(!prepared.coverage && !prepared.debug_break && !prepared.debug_trace && !prepared.rc_shadow, "coverage and debug modes are unsupported")
  fa_require(Array::length(prepared.input.body_cache_in.fn_indices) == 0 && Array::length(prepared.input.body_cache_out.fn_indices) == 0 && prepared.input.slice_lo == 0 && prepared.input.slice_hi < 0, "expected a fresh whole-program body phase")
  let validation = function_product_plan_new(prepared.functions, prepared.input)
  let replay = function_replay_state_new(validation, prepared.input, prepared.enable_rc, false)
  let state = FunctionAssembly::{
    sections: prepared.sections,
    replay: replay,
    enable_rc: prepared.enable_rc
  }
  fa_check(state)
  prepared.used = true
  state
}

/// The large runtime literal pool is referenced through the original context,
/// never serialized again in this packet. All other section fields are explicit.
export fn write_function_assembly(state: FunctionAssembly, context_digest: String) -> Bytes with Exception {
  fa_digest(context_digest); fa_check(state)
  let b = Bytes::new()
  fa_put_string(b, "vibe-function-assembly-1")
  fa_put_string(b, context_digest)
  fa_put_bool(b, state.enable_rc)
  fa_put_bytes(b, write_function_product_plan(state.replay.validation))
  let sections = state.sections
  fa_put_int(b, sections.arr_concat_idx)
  fa_put_int(b, sections.arr_get_idx)
  fa_put_int(b, sections.arr_len_idx)
  fa_put_int(b, sections.arr_new_idx)
  fa_put_int(b, sections.arr_push_all_idx)
  fa_put_int(b, sections.arr_push_idx)
  fa_put_int(b, sections.arr_set_idx)
  fa_put_int(b, sections.arr_slice_idx)
  fa_put_int(b, sections.arr_truncate_idx)
  fa_put_int(b, sections.array_capacity_idx)
  fa_put_ints(b, sections.blind_kinds)
  fa_put_ints(b, sections.blind_offsets)
  fa_put_ints(b, sections.blind_owners)
  fa_put_ints(b, sections.blind_syms)
  fa_put_int(b, sections.bytes_append_idx)
  fa_put_int(b, sections.bytes_blit_idx)
  fa_put_int(b, sections.bytes_capacity_idx)
  fa_put_int(b, sections.bytes_compare_idx)
  fa_put_int(b, sections.bytes_concat_idx)
  fa_put_int(b, sections.bytes_count_byte_idx)
  fa_put_int(b, sections.bytes_from_array_idx)
  fa_put_int(b, sections.bytes_get_idx)
  fa_put_int(b, sections.bytes_index_of_bytes_idx)
  fa_put_int(b, sections.bytes_index_of_idx)
  fa_put_int(b, sections.bytes_last_index_of_idx)
  fa_put_int(b, sections.bytes_len_idx)
  fa_put_int(b, sections.bytes_new_idx)
  fa_put_int(b, sections.bytes_push_idx)
  fa_put_int(b, sections.bytes_set_idx)
  fa_put_int(b, sections.bytes_slice_idx)
  fa_put_int(b, sections.bytes_to_array_idx)
  fa_put_int(b, sections.compact_fingerprint_hash_idx)
  fa_put_int(b, sections.cov_base)
  fa_put_int(b, sections.cov_branch_base)
  fa_put_int(b, sections.cov_branch_reserve)
  fa_put_int(b, sections.cov_count)
  fa_put_int(b, sections.cov_reserve)
  fa_put_cov(b, sections.cov_state)
  fa_put_int(b, sections.dbg_break_import_idx)
  fa_put_int(b, sections.dbg_line_import_idx)
  fa_put_bool(b, sections.dbg_line_on)
  fa_put_int(b, sections.dbgargs_base)
  fa_put_int(b, sections.dbgargs_cap)
  fa_put_int(b, sections.dbgargs_count_addr)
  fa_put_int(b, sections.dbgargs_reserve)
  fa_put_int(b, sections.div_zero_abort_idx)
  fa_put_int(b, sections.double_to_int_idx)
  fa_put_int(b, sections.eff_reserve)
  fa_put_strings(b, sections.effect_names_list)
  fa_put_bool(b, sections.enable_late_dce)
  fa_put_string(b, sections.entry_name)
  fa_put_string(b, sections.entry_name_in)
  fa_put_int(b, sections.entry_user_idx)
  fa_put_int(b, sections.env_args_get_import_idx)
  fa_put_int(b, sections.env_args_len_import_idx)
  fa_put_int(b, sections.env_get_import_idx)
  fa_put_int(b, sections.eq_idx)
  fa_put_strings(b, sections.export_fn_names)
  fa_put_ints(b, sections.export_fn_user_indices)
  fa_put_strings(b, sections.fn_names_list)
  fa_put_ints(b, sections.fn_param_counts)
  fa_put_facts(b, sections.facts)
  fa_put_int(b, sections.frozen_array_copy_idx)
  fa_put_int(b, sections.fs_append_import_idx)
  fa_put_int(b, sections.fs_chdir_import_idx)
  fa_put_int(b, sections.fs_copy_import_idx)
  fa_put_int(b, sections.fs_exists_import_idx)
  fa_put_int(b, sections.fs_exists_stub_idx)
  fa_put_int(b, sections.fs_getcwd_import_idx)
  fa_put_int(b, sections.fs_is_dir_import_idx)
  fa_put_int(b, sections.fs_is_file_import_idx)
  fa_put_int(b, sections.fs_mkdir_import_idx)
  fa_put_int(b, sections.fs_mkdir_p_import_idx)
