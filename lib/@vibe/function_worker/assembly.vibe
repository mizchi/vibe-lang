  fa_put_int(b, sections.shadow_uaf_abort_idx)
  fa_put_int(b, sections.simd_scan_alnum_idx)
  fa_put_int(b, sections.simd_scan_alnum_str_idx)
  fa_put_int(b, sections.simd_scan_line_end_str_idx)
  fa_put_int(b, sections.simd_scan_string_special_str_idx)
  fa_put_int(b, sections.simd_skip_ws_idx)
  fa_put_int(b, sections.sleep_import_idx)
  fa_put_bool(b, sections.sleep_needs_component_adapter)
  fa_put_int(b, sections.sources_idx)
  fa_put_int(b, sections.stderr_write_char_import_idx)
  fa_put_int(b, sections.stderr_write_stream_import_idx)
  fa_put_int(b, sections.stdin_provider_acquire_import_idx)
  fa_put_int(b, sections.stdin_provider_close_import_idx)
  fa_put_int(b, sections.stdin_provider_read_import_idx)
  fa_put_int(b, sections.stdin_read_char_import_idx)
  fa_put_int(b, sections.stdin_read_stream_import_idx)
  fa_put_int(b, sections.stdout_write_char_import_idx)
  fa_put_int(b, sections.stdout_write_stream_import_idx)
  fa_put_int(b, sections.str_char_code_at_idx)
  fa_put_int(b, sections.str_concat_idx)
  fa_put_int(b, sections.str_eq_idx)
  fa_put_int(b, sections.str_from_char_code_idx)
  fa_put_int(b, sections.str_len_idx)
  fa_put_int(b, sections.str_lex_diff_idx)
  fa_put_ints(b, sections.str_offsets)
  fa_put_int(b, sections.str_substring_idx)
  fa_put_int(b, sections.string_contains_idx)
  fa_put_int(b, sections.string_ends_with_idx)
  fa_put_int(b, sections.string_index_of_idx)
  fa_put_int(b, sections.string_join_idx)
  fa_put_int(b, sections.string_last_index_of_idx)
  fa_put_int(b, sections.string_split_idx)
  fa_put_int(b, sections.string_starts_with_idx)
  fa_put_int(b, sections.string_trim_idx)
  fa_put_ints(b, sections.table_slots_used)
  fa_put_int(b, sections.tcp_close_import_idx)
  fa_put_int(b, sections.tcp_connect_import_idx)
  fa_put_int(b, sections.tcp_read_import_idx)
  fa_put_int(b, sections.tcp_write_import_idx)
  fa_put_strings(b, sections.test_fn_names)
  fa_put_strings(b, sections.thunk_names_list)
  fa_put_int(b, sections.trace_cap)
  fa_put_int(b, sections.trace_counter_addr)
  fa_put_int(b, sections.trace_log_base)
  fa_put_int(b, sections.trace_reserve)
  let builtins = state.replay.builtins
  fa_put_count(b, Array::length(builtins.bodies))
  for body in builtins.bodies {
    fa_put_bytes(b, body)
  }
  fa_put_ints(b, builtins.builtin_type_idxs)
  fa_put_ints(b, builtins.meta_i32)
  fa_put_ints(b, builtins.meta_i64)
  fa_put_ints(b, builtins.meta_v128)
  fa_put_ints(b, state.replay.guard_layout)
  fa_put_bool(b, state.replay.publish_layout)
  fa_put_ints(b, state.replay.placed_files)
  fa_require(Array::length(state.replay.cache.collect) == 1, "invalid cache collection cell")
  fa_put_int(b, Array::get(state.replay.cache.collect, 0))
  fa_put_bytes(b, codegen_body_cache_to_bytes(state.replay.cache))
  b
}

/// Authenticate actual input buffers against the original trusted phase receipt
/// before decoding. Reading just the context's owned literal prefix avoids AST
/// placeholders and a second copy of every compiler/CLI source literal.
export fn read_function_assembly(bytes: Bytes, shared: Bytes, packet_digest: String, context_digest: String) -> FunctionAssembly with Exception {
  fa_digest(packet_digest); fa_digest(context_digest)
  fa_require(Bytes::length(bytes) <= 64 * 1024 * 1024 && Bytes::length(shared) <= 64 * 1024 * 1024, "exceeds64MiB")
  fa_require(blake3_bytes_simd(bytes) == packet_digest, "packet receipt differs")
  fa_require(blake3_bytes_simd(shared) == context_digest, "context receipt differs")
  let r = linear_string_reader(bytes)
  fa_require(fa_get_string(r) == "vibe-function-assembly-1", "unsupported format")
  fa_require(fa_get_string(r) == context_digest, "context binding differs")
  let enable_rc = fa_get_bool(r)
  let validation = read_function_product_plan(fa_get_bytes(r))
  let arr_concat_idx = fa_get_int(r)
  let arr_get_idx = fa_get_int(r)
  let arr_len_idx = fa_get_int(r)
  let arr_new_idx = fa_get_int(r)
  let arr_push_all_idx = fa_get_int(r)
  let arr_push_idx = fa_get_int(r)
  let arr_set_idx = fa_get_int(r)
  let arr_slice_idx = fa_get_int(r)
  let arr_truncate_idx = fa_get_int(r)
  let array_capacity_idx = fa_get_int(r)
  let blind_kinds = fa_get_ints(r)
  let blind_offsets = fa_get_ints(r)
  let blind_owners = fa_get_ints(r)
  let blind_syms = fa_get_ints(r)
  let bytes_append_idx = fa_get_int(r)
  let bytes_blit_idx = fa_get_int(r)
  let bytes_capacity_idx = fa_get_int(r)
  let bytes_compare_idx = fa_get_int(r)
  let bytes_concat_idx = fa_get_int(r)
  let bytes_count_byte_idx = fa_get_int(r)
  let bytes_from_array_idx = fa_get_int(r)
  let bytes_get_idx = fa_get_int(r)
  let bytes_index_of_bytes_idx = fa_get_int(r)
  let bytes_index_of_idx = fa_get_int(r)
  let bytes_last_index_of_idx = fa_get_int(r)
  let bytes_len_idx = fa_get_int(r)
  let bytes_new_idx = fa_get_int(r)
  let bytes_push_idx = fa_get_int(r)
  let bytes_set_idx = fa_get_int(r)
  let bytes_slice_idx = fa_get_int(r)
  let bytes_to_array_idx = fa_get_int(r)
  let compact_fingerprint_hash_idx = fa_get_int(r)
  let cov_base = fa_get_int(r)
  let cov_branch_base = fa_get_int(r)
  let cov_branch_reserve = fa_get_int(r)
  let cov_count = fa_get_int(r)
  let cov_reserve = fa_get_int(r)
  let cov_state = fa_get_cov(r)
  let dbg_break_import_idx = fa_get_int(r)
  let dbg_line_import_idx = fa_get_int(r)
  let dbg_line_on = fa_get_bool(r)
