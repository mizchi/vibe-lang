import ./product.vibe {
  validate_function_product
}
// Owned function snapshot. Mutable compiler objects never cross stores.
import @vibe/compiler/cache {
  AstBinaryReader,
  ast_binary_read_bool_checked,
  ast_binary_read_count_checked,
  ast_binary_read_string_checked,
  ast_binary_read_svarint_checked,
  ast_binary_read_varint_checked,
  ast_binary_reader_remaining,
  ast_binary_reader_with_string_pool,
  ast_binary_write_bool,
  ast_binary_write_svarint,
  ast_binary_write_varint
}
import @vibe/compiler/codegen/wasi {
  LinkedBodyInputs, LinkedBodyPlan, LinkedFunctionPlan, lc_function_effects_new, lc_function_linemap_new
}
import @vibe/compiler/codegen/common_base {
  CodegenBodyCache, DbgProv, codegen_body_cache_discard, codegen_body_cache_new, codegen_body_cache_to_bytes, cov_disabled, str_table_new
}
import @vibe/compiler/core {
  Expr, MergedOffsetLocations, TypeExpr, merged_offset_locations_snapshot, sorted_names_of, with_merged_offset_locations
}
import @vibe/core {
  struct MutMap
}
import @vibe/lowering_worker/linear {
  linear_body_cache_from_bytes, linear_string_reader, linear_write_string, linear_write_string_index
}

/// One decoded worker's private copy of the canonical input. This record is
/// not Send; only its bounded wire representation crosses the native bridge.
export struct FunctionContext {
  plan: LinkedFunctionPlan;
  input: LinkedBodyInputs;
  debug_break: Bool;
  debug_trace: Bool;
  enable_rc: Bool;
  rc_shadow: Bool;
  mut loaded_lo: Int;
  mut loaded_hi: Int;
  cache_template: Bytes;
  locations: MergedOffsetLocations
}

fn fw_put_ints(b: Bytes, xs: Array[Int]) -> Unit {
  ast_binary_write_varint(b, Array::length(xs))
  for x in xs {
    ast_binary_write_svarint(b, x)
  }
  ()
}
fn fw_get_ints(r: AstBinaryReader) -> Array[Int] with Exception {
  let xs: Array[Int] = []
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  while i < n {
    Array::push(xs, ast_binary_read_svarint_checked(r)); i = i + 1
  }
  xs
}
fn fw_put_bools(b: Bytes, xs: Array[Bool]) -> Unit {
  ast_binary_write_varint(b, Array::length(xs))
  for x in xs {
    ast_binary_write_bool(b, x)
  }
  ()
}
fn fw_get_bools(r: AstBinaryReader) -> Array[Bool] with Exception {
  let xs: Array[Bool] = []
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  while i < n {
    Array::push(xs, ast_binary_read_bool_checked(r)); i = i + 1
  }
  xs
}
fn fw_put_strings(b: Bytes, xs: Array[String]) -> Unit with Exception {
  ast_binary_write_varint(b, Array::length(xs))
  for x in xs {
    linear_write_string(b, x)
  }
  ()
}
// Only metadata after all_fn_names_list can refer to this pool. Runtime
// literal slots remain unchanged for the independent per-range AST codec.
fn fw_put_name(b: Bytes, value: String, names: MutMap[String, Int]) -> Unit with Exception {
  if String::length(value) >= 16 {
    match MutMap::get(names, value) {
      Some(index) => {
        linear_write_string_index(b, index); return ()
      },
      None => ()
    }
  } else ()
  linear_write_string(b, value)
}
fn fw_put_names(b: Bytes, xs: Array[String], names: MutMap[String, Int]) -> Unit with Exception {
  ast_binary_write_varint(b, Array::length(xs))
  for value in xs {
    fw_put_name(b, value, names)
  }
  ()
}
fn fw_get_strings(r: AstBinaryReader) -> Array[String] with Exception {
  let xs: Array[String] = []
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  while i < n {
    Array::push(xs, ast_binary_read_string_checked(r)); i = i + 1
  }
  xs
}
fn fw_put_matrix(b: Bytes, xs: Array[Array[String]]) -> Unit with Exception {
  ast_binary_write_varint(b, Array::length(xs))
  for x in xs {
    fw_put_strings(b, x)
  }
  ()
}
fn fw_get_matrix(r: AstBinaryReader) -> Array[Array[String]] with Exception {
  let xs: Array[Array[String]] = []
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  while i < n {
    Array::push(xs, fw_get_strings(r)); i = i + 1
  }
  xs
}
fn fw_put_pairs(b: Bytes, xs: Array[(String, Int)], names: MutMap[String, Int]) -> Unit with Exception {
  ast_binary_write_varint(b, Array::length(xs))
  for x in xs {
    fw_put_name(b, x.0, names); ast_binary_write_svarint(b, x.1)
  }
  ()
}
fn fw_get_pairs(r: AstBinaryReader) -> Array[(String, Int)] with Exception {
  let xs: Array[(String, Int)] = []
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  while i < n {
    let key = ast_binary_read_string_checked(r)
    let value = ast_binary_read_svarint_checked(r)
    Array::push(xs, (key, value)); i = i + 1
  }
  xs
}
fn fw_put_triples(b: Bytes, xs: Array[(String, Int, Int)], names: MutMap[String, Int]) -> Unit with Exception {
  ast_binary_write_varint(b, Array::length(xs))
  for x in xs {
    fw_put_name(b, x.0, names); ast_binary_write_svarint(b, x.1); ast_binary_write_svarint(b, x.2)
  }
  ()
}
fn fw_get_triples(r: AstBinaryReader) -> Array[(String, Int, Int)] with Exception {
  let xs: Array[(String, Int, Int)] = []
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  while i < n {
    let key = ast_binary_read_string_checked(r)
    let a = ast_binary_read_svarint_checked(r)
    let b = ast_binary_read_svarint_checked(r)
    Array::push(xs, (key, a, b)); i = i + 1
  }
  xs
}
fn fw_put_map(b: Bytes, m: MutMap[String, Int], names: MutMap[String, Int]) -> Unit with Exception {
  let keys = sorted_names_of(MutMap::keys(m))
  ast_binary_write_varint(b, Array::length(keys))
  for key in keys {
    fw_put_name(b, key, names)
    match MutMap::get(m, key) {
      Some(value) => ast_binary_write_svarint(b, value),
      None => throw("function context: map changed during snapshot")
    }
  }
  ()
}
fn fw_get_map(r: AstBinaryReader) -> MutMap[String, Int] with Exception {
  let m: MutMap[String, Int] = MutMap::new_string()
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  let mut previous = ""
  while i < n {
    let key = ast_binary_read_string_checked(r)
    let value = ast_binary_read_svarint_checked(r)
    if i > 0 && !(previous < key) {
      throw("function context: map keys are not canonical")
    } else ()
    MutMap::set(m, key, value); previous = key; i = i + 1
  }
  m
}
fn fw_put_prov(b: Bytes, p: DbgProv) -> Unit with Exception {
  fw_put_strings(b, p.files)
  fw_put_ints(b, p.stmt_file_id)
  ast_binary_write_varint(b, Array::length(p.file_nls))
  for rows in p.file_nls {
    fw_put_ints(b, rows)
  }
  ()
}
fn fw_get_prov(r: AstBinaryReader) -> DbgProv with Exception {
  let files = fw_get_strings(r)
  let ids = fw_get_ints(r)
  let nls: Array[Array[Int]] = []
  let n = ast_binary_read_count_checked(r)
  let mut i = 0
  while i < n {
    Array::push(nls, fw_get_ints(r)); i = i + 1
  }
  DbgProv::{ files: files, stmt_file_id: ids, file_nls: nls }
}
fn fw_put_blob(b: Bytes, value: Bytes) -> Unit {
  ast_binary_write_varint(b, Bytes::length(value))
  Bytes::blit(b, value, 0, Bytes::length(value))
}
fn fw_get_blob(r: AstBinaryReader) -> Bytes with Exception {
  let n = ast_binary_read_varint_checked(r)
  if n < 0 || n > ast_binary_reader_remaining(r) {
    throw("function context: blob exceeds input")
  } else ()
  let bytes = Bytes::slice(r.bytes, r.pos, r.pos + n)
  r.pos = r.pos + n
  bytes
}

/// Capture after planning, before any body output. The existing cache codec
/// supplies an owned template of coordinator guards, not cached function data.
export fn function_context_new(plan: LinkedFunctionPlan, input: LinkedBodyInputs, debug_break: Bool, debug_trace: Bool, enable_rc: Bool, rc_shadow: Bool) -> FunctionContext with Exception {
  if Array::length(input.body_cache_in.fn_indices) != 0 || Array::length(input.body_cache_out.fn_indices) != 0 || Array::length(input.lt_w.bodies) != 0 || input.slice_lo != 0 || input.slice_hi >= 0 {
    throw("function workers: expected a fresh whole-program body phase")
  } else ()
  let loaded_hi = input.num_user_funcs
  let locations = merged_offset_locations_snapshot()
  let template = codegen_body_cache_to_bytes(input.body_cache_out)
  FunctionContext::{
    plan: plan,
    input: input,
    debug_break: debug_break,
    debug_trace: debug_trace,
    enable_rc: enable_rc,
    rc_shadow: rc_shadow,
    loaded_lo: 0,
    loaded_hi: loaded_hi,
    cache_template: template,
    locations: locations
  }
}

/// Encode bounded shared tables once. Per-range AST is carried by each job.
export fn write_function_context(ctx: FunctionContext) -> Bytes with Exception {
  let b = Bytes::with_capacity(64 * 1024 * 1024)
  linear_write_string(b, "vibe-function-context-7")
  fw_put_strings(b, ctx.input.str_strs)
  ast_binary_write_bool(b, ctx.debug_break)
  ast_binary_write_bool(b, ctx.debug_trace)
  ast_binary_write_bool(b, ctx.enable_rc)
  ast_binary_write_bool(b, ctx.rc_shadow)
  ast_binary_write_bool(b, ctx.input.has_exceptions)
  fw_put_ints(b, ctx.input.all_fn_indices_list)
  fw_put_strings(b, ctx.input.all_fn_names_list)
  let names: MutMap[String, Int] = MutMap::with_capacity_string(Array::length(ctx.input.all_fn_names_list) * 2 + 16)
  let mut name_i = Array::length(ctx.input.all_fn_names_list)
  while name_i > 0 {
    name_i = name_i - 1
    MutMap::set(names, Array::get(ctx.input.all_fn_names_list, name_i), name_i)
  }
  fw_put_names(b, ctx.input.all_fn_names_sorted, names)
  fw_put_ints(b, ctx.input.all_fn_names_sorted_pos)
  fw_put_bools(b, ctx.input.all_fn_needs_env_list)
  fw_put_ints(b, ctx.input.all_fn_param_counts)
  fw_put_ints(b, ctx.input.all_fn_returns_list)
  ast_binary_write_svarint(b, ctx.input.arr_get_idx)
  ast_binary_write_svarint(b, ctx.input.arr_len_idx)
  ast_binary_write_svarint(b, ctx.input.arr_new_idx)
  ast_binary_write_svarint(b, ctx.input.arr_push_idx)
  ast_binary_write_svarint(b, ctx.input.arr_slice_idx)
  fw_put_ints(b, ctx.input.bool_render_offsets)
  ast_binary_write_svarint(b, ctx.input.bytes_append_idx)
  ast_binary_write_svarint(b, ctx.input.bytes_get_idx)
  ast_binary_write_svarint(b, ctx.input.bytes_len_idx)
  ast_binary_write_svarint(b, ctx.input.bytes_new_idx)
  ast_binary_write_svarint(b, ctx.input.bytes_push_idx)
  fw_put_strings(b, ctx.input.const_int_names_list)
  fw_put_ints(b, ctx.input.const_int_values_list)
  ast_binary_write_svarint(b, ctx.input.cov_base)
  fw_put_ints(b, ctx.input.ctor_field_counts_list)
  fw_put_ints(b, ctx.input.ctor_float_fields_list)
  fw_put_strings(b, ctx.input.ctor_names_list)
  fw_put_ints(b, ctx.input.ctor_tags_list)
  fw_put_strings(b, ctx.input.ctor_type_names_list)
  ast_binary_write_svarint(b, ctx.input.dbg_break_import_idx)
  ast_binary_write_svarint(b, ctx.input.dbg_line_import_idx)
  ast_binary_write_bool(b, ctx.input.dbg_line_on)
  fw_put_map(b, ctx.input.dbg_name_file, names)
  fw_put_map(b, ctx.input.dbg_owner_file, names)
  ast_binary_write_svarint(b, ctx.input.dbgargs_base)
  ast_binary_write_svarint(b, ctx.input.dbgargs_cap)
  ast_binary_write_svarint(b, ctx.input.dbgargs_count_addr)
  ast_binary_write_svarint(b, ctx.input.div_zero_abort_idx)
  fw_put_strings(b, ctx.input.effect_names_list)
  fw_put_ints(b, ctx.input.effect_op_arities_list)
  fw_put_strings(b, ctx.input.effect_op_keys_list)
  linear_write_string(b, ctx.input.entry_name)
  ast_binary_write_svarint(b, ctx.input.eq_idx)
  ast_binary_write_svarint(b, ctx.input.fi)
  fw_put_ints(b, ctx.input.float_call_offsets)
  fw_put_names(b, ctx.input.float_ret_fn_names, names)
  fw_put_names(b, ctx.input.fn_names_list, names)
  ast_binary_write_svarint(b, ctx.input.func_offset)
  ast_binary_write_svarint(b, ctx.input.heap_grow_check_idx)
  fw_put_ints(b, ctx.input.int_render_offsets)
  fw_put_triples(b, ctx.input.iw_callees, names)
  fw_put_names(b, ctx.input.iw_names, names)
  fw_put_strings(b, ctx.input.iw_wats)
  ast_binary_write_svarint(b, ctx.input.lambda_slot_base)
  ast_binary_write_bool(b, ctx.input.late_dce_rewrote_bodies)
  fw_put_ints(b, ctx.input.lc_agg_ret_infos)
  fw_put_names(b, ctx.input.lc_agg_ret_names, names)
  fw_put_names(b, ctx.input.lc_agg_ret_names_sorted, names)
  fw_put_ints(b, ctx.input.lc_agg_ret_names_sorted_pos)
  fw_put_ints(b, ctx.input.lc_borrow_param_mask)
  fw_put_strings(b, ctx.input.lc_borrow_param_user_srt)
  fw_put_names(b, ctx.input.lc_borrow_ret_names, names)
  fw_put_strings(b, ctx.input.lc_borrow_view_ret)
  fw_put_strings(b, ctx.input.lc_ctor_names_sorted)
  fw_put_ints(b, ctx.input.lc_ctor_names_sorted_pos)
  fw_put_map(b, ctx.input.lc_fn_file_of, names)
  fw_put_map(b, ctx.input.lc_fn_stmt_of, names)
  fw_put_names(b, ctx.input.lc_heap_ret_names, names)
  fw_put_ints(b, ctx.input.lc_name_unique)
  fw_put_names(b, ctx.input.lc_owned_return_names, names)
  fw_put_pairs(b, ctx.input.lc_passthrough_ret_params, names)
  ast_binary_write_svarint(b, ctx.input.lc_perceus_pin)
  fw_put_names(b, ctx.input.lc_scalar_ret_names, names)
  fw_put_strings(b, ctx.input.lc_struct_names_sorted)
  fw_put_ints(b, ctx.input.lc_struct_names_sorted_pos)
  fw_put_strings(b, ctx.input.lc_type_names_sorted)
  ast_binary_write_bool(b, ctx.input.library_mode)
  ast_binary_write_bool(b, ctx.input.linemap_on)
  ast_binary_write_svarint(b, ctx.input.map_build_index_idx)
  ast_binary_write_svarint(b, ctx.input.map_cap_idx)
  ast_binary_write_svarint(b, ctx.input.map_hash_idx)
  ast_binary_write_svarint(b, ctx.input.map_index_insert_idx)
  ast_binary_write_svarint(b, ctx.input.map_probe_index_idx)
  ast_binary_write_bool(b, ctx.input.need_array_capacity)
  ast_binary_write_bool(b, ctx.input.need_bytes_capacity)
  ast_binary_write_bool(b, ctx.input.need_div_zero_abort)
  ast_binary_write_bool(b, ctx.input.need_region_arena)
  ast_binary_write_svarint(b, ctx.input.num_src_pairs)
  ast_binary_write_svarint(b, ctx.input.num_user_funcs)
  ast_binary_write_svarint(b, ctx.input.oob_abort_idx)
  ast_binary_write_svarint(b, ctx.input.pi)
  ast_binary_write_svarint(b, ctx.input.pin_region_capacity)
  ast_binary_write_svarint(b, ctx.input.print_i64_raw_idx)
  ast_binary_write_svarint(b, ctx.input.print_str_idx)
  fw_put_prov(b, ctx.input.prov)
  ast_binary_write_svarint(b, ctx.input.rc_alloc_idx)
  ast_binary_write_svarint(b, ctx.input.rc_bins_base)
  ast_binary_write_bool(b, ctx.input.rc_closure_arms)
  ast_binary_write_bool(b, ctx.input.rc_map_arms)
  ast_binary_write_svarint(b, ctx.input.rc_drop_idx)
  ast_binary_write_svarint(b, ctx.input.rc_dup_idx)
  ast_binary_write_svarint(b, ctx.input.region_arr_new_idx)
  ast_binary_write_svarint(b, ctx.input.region_bytes_new_idx)
  ast_binary_write_svarint(b, ctx.input.region_data_base)
  ast_binary_write_svarint(b, ctx.input.region_limit)
  ast_binary_write_svarint(b, ctx.input.region_ptr_addr)
  ast_binary_write_svarint(b, ctx.input.shadow_uaf_abort_idx)
  ast_binary_write_svarint(b, ctx.input.src_str_base)
  ast_binary_write_svarint(b, ctx.input.str_char_code_at_idx)
  ast_binary_write_svarint(b, ctx.input.str_concat_idx)
  ast_binary_write_svarint(b, ctx.input.str_eq_idx)
  ast_binary_write_svarint(b, ctx.input.str_len_idx)
  fw_put_ints(b, ctx.input.str_lengths)
  ast_binary_write_svarint(b, ctx.input.str_lex_diff_idx)
  fw_put_ints(b, ctx.input.str_offsets)
  ast_binary_write_svarint(b, ctx.input.str_operand_abort_idx)
  ast_binary_write_svarint(b, ctx.input.str_substring_idx)
  ast_binary_write_svarint(b, ctx.input.string_index_of_idx)
  fw_put_matrix(b, ctx.input.struct_field_names)
  fw_put_strings(b, ctx.input.struct_names)
  fw_put_names(b, ctx.input.thunk_names_list, names)
  ast_binary_write_svarint(b, ctx.input.trace_cap)
  ast_binary_write_svarint(b, ctx.input.trace_counter_addr)
  ast_binary_write_svarint(b, ctx.input.trace_log_base)
  ast_binary_write_bool(b, ctx.input.user_shadows_trunc_builtins)
  ast_binary_write_varint(b, Array::length(ctx.plan.bodies))
  ast_binary_write_varint(b, Array::length(ctx.plan.source_types))
  fw_put_ints(b, ctx.plan.lambda_bases)
  ast_binary_write_svarint(b, ctx.plan.lambda_count)
  ast_binary_write_bool(b, ctx.plan.enable_rc)
  fw_put_blob(b, ctx.cache_template)
  fw_put_strings(b, ctx.locations.paths)
  fw_put_ints(b, ctx.locations.bases)
  fw_put_ints(b, ctx.locations.lengths)
  fw_put_bools(b, ctx.locations.placed)
  ast_binary_write_varint(b, Array::length(ctx.locations.newlines))
  for rows in ctx.locations.newlines {
    fw_put_ints(b, rows)
  }
  if Bytes::length(b) > 64 * 1024 * 1024 {
    throw("function context: exceeds 64 MiB")
  } else ()
  b
}

/// Decode shared tables once per worker. Body slots start unloaded; job
/// decoding fills only its assigned range against the checked string pool.
export fn read_function_context(bytes: Bytes) -> FunctionContext with Exception {
  if Bytes::length(bytes) > 64 * 1024 * 1024 {
    throw("function context: exceeds 64 MiB")
  } else ()
  let prefix = linear_string_reader(bytes)
  if ast_binary_read_string_checked(prefix) != "vibe-function-context-7" {
    throw("function context: unsupported format")
  } else ()
  let str_strs = fw_get_strings(prefix)
  let r = prefix
  let debug_break = ast_binary_read_bool_checked(r)
  let debug_trace = ast_binary_read_bool_checked(r)
  let enable_rc = ast_binary_read_bool_checked(r)
  let rc_shadow = ast_binary_read_bool_checked(r)
  let has_exceptions = ast_binary_read_bool_checked(r)
  let all_fn_indices_list = fw_get_ints(r)
  let all_fn_names_list = fw_get_strings(r)
  let r = ast_binary_reader_with_string_pool(r, FrozenArray::from_array(all_fn_names_list))
  let all_fn_names_sorted = fw_get_strings(r)
  let all_fn_names_sorted_pos = fw_get_ints(r)
  let all_fn_needs_env_list = fw_get_bools(r)
  let all_fn_param_counts = fw_get_ints(r)
  let all_fn_returns_list = fw_get_ints(r)
  let arr_get_idx = ast_binary_read_svarint_checked(r)
  let arr_len_idx = ast_binary_read_svarint_checked(r)
  let arr_new_idx = ast_binary_read_svarint_checked(r)
  let arr_push_idx = ast_binary_read_svarint_checked(r)
  let arr_slice_idx = ast_binary_read_svarint_checked(r)
  let bool_render_offsets = fw_get_ints(r)
  let bytes_append_idx = ast_binary_read_svarint_checked(r)
  let bytes_get_idx = ast_binary_read_svarint_checked(r)
  let bytes_len_idx = ast_binary_read_svarint_checked(r)
  let bytes_new_idx = ast_binary_read_svarint_checked(r)
  let bytes_push_idx = ast_binary_read_svarint_checked(r)
  let const_int_names_list = fw_get_strings(r)
  let const_int_values_list = fw_get_ints(r)
  let cov_base = ast_binary_read_svarint_checked(r)
  let ctor_field_counts_list = fw_get_ints(r)
  let ctor_float_fields_list = fw_get_ints(r)
  let ctor_names_list = fw_get_strings(r)
  let ctor_tags_list = fw_get_ints(r)
  let ctor_type_names_list = fw_get_strings(r)
  let dbg_break_import_idx = ast_binary_read_svarint_checked(r)
  let dbg_line_import_idx = ast_binary_read_svarint_checked(r)
  let dbg_line_on = ast_binary_read_bool_checked(r)
  let dbg_name_file = fw_get_map(r)
  let dbg_owner_file = fw_get_map(r)
  let dbgargs_base = ast_binary_read_svarint_checked(r)
  let dbgargs_cap = ast_binary_read_svarint_checked(r)
  let dbgargs_count_addr = ast_binary_read_svarint_checked(r)
  let div_zero_abort_idx = ast_binary_read_svarint_checked(r)
  let effect_names_list = fw_get_strings(r)
  let effect_op_arities_list = fw_get_ints(r)
  let effect_op_keys_list = fw_get_strings(r)
  let entry_name = ast_binary_read_string_checked(r)
  let eq_idx = ast_binary_read_svarint_checked(r)
  let fi = ast_binary_read_svarint_checked(r)
  let float_call_offsets = fw_get_ints(r)
  let float_ret_fn_names = fw_get_strings(r)
  let fn_names_list = fw_get_strings(r)
  let func_offset = ast_binary_read_svarint_checked(r)
  let heap_grow_check_idx = ast_binary_read_svarint_checked(r)
  let int_render_offsets = fw_get_ints(r)
  let iw_callees = fw_get_triples(r)
  let iw_names = fw_get_strings(r)
  let iw_wats = fw_get_strings(r)
  let lambda_slot_base = ast_binary_read_svarint_checked(r)
  let late_dce_rewrote_bodies = ast_binary_read_bool_checked(r)
  let lc_agg_ret_infos = fw_get_ints(r)
  let lc_agg_ret_names = fw_get_strings(r)
  let lc_agg_ret_names_sorted = fw_get_strings(r)
  let lc_agg_ret_names_sorted_pos = fw_get_ints(r)
  let lc_borrow_param_mask = fw_get_ints(r)
  let lc_borrow_param_user_srt = fw_get_strings(r)
  let lc_borrow_ret_names = fw_get_strings(r)
  let lc_borrow_view_ret = fw_get_strings(r)
  let lc_ctor_names_sorted = fw_get_strings(r)
  let lc_ctor_names_sorted_pos = fw_get_ints(r)
  let lc_fn_file_of = fw_get_map(r)
  let lc_fn_stmt_of = fw_get_map(r)
  let lc_heap_ret_names = fw_get_strings(r)
  let lc_name_unique = fw_get_ints(r)
  let lc_owned_return_names = fw_get_strings(r)
  let lc_passthrough_ret_params = fw_get_pairs(r)
  let lc_perceus_pin = ast_binary_read_svarint_checked(r)
  let lc_scalar_ret_names = fw_get_strings(r)
  let lc_struct_names_sorted = fw_get_strings(r)
  let lc_struct_names_sorted_pos = fw_get_ints(r)
  let lc_type_names_sorted = fw_get_strings(r)
  let library_mode = ast_binary_read_bool_checked(r)
  let linemap_on = ast_binary_read_bool_checked(r)
  let map_build_index_idx = ast_binary_read_svarint_checked(r)
  let map_cap_idx = ast_binary_read_svarint_checked(r)
  let map_hash_idx = ast_binary_read_svarint_checked(r)
  let map_index_insert_idx = ast_binary_read_svarint_checked(r)
  let map_probe_index_idx = ast_binary_read_svarint_checked(r)
  let need_array_capacity = ast_binary_read_bool_checked(r)
  let need_bytes_capacity = ast_binary_read_bool_checked(r)
  let need_div_zero_abort = ast_binary_read_bool_checked(r)
  let need_region_arena = ast_binary_read_bool_checked(r)
  let num_src_pairs = ast_binary_read_svarint_checked(r)
  let num_user_funcs = ast_binary_read_svarint_checked(r)
  let oob_abort_idx = ast_binary_read_svarint_checked(r)
  let pi = ast_binary_read_svarint_checked(r)
  let pin_region_capacity = ast_binary_read_svarint_checked(r)
  let print_i64_raw_idx = ast_binary_read_svarint_checked(r)
  let print_str_idx = ast_binary_read_svarint_checked(r)
  let prov = fw_get_prov(r)
  let rc_alloc_idx = ast_binary_read_svarint_checked(r)
  let rc_bins_base = ast_binary_read_svarint_checked(r)
  let rc_closure_arms = ast_binary_read_bool_checked(r)
  let rc_map_arms = ast_binary_read_bool_checked(r)
  let rc_drop_idx = ast_binary_read_svarint_checked(r)
  let rc_dup_idx = ast_binary_read_svarint_checked(r)
  let region_arr_new_idx = ast_binary_read_svarint_checked(r)
  let region_bytes_new_idx = ast_binary_read_svarint_checked(r)
  let region_data_base = ast_binary_read_svarint_checked(r)
  let region_limit = ast_binary_read_svarint_checked(r)
  let region_ptr_addr = ast_binary_read_svarint_checked(r)
  let shadow_uaf_abort_idx = ast_binary_read_svarint_checked(r)
  let src_str_base = ast_binary_read_svarint_checked(r)
  let str_char_code_at_idx = ast_binary_read_svarint_checked(r)
  let str_concat_idx = ast_binary_read_svarint_checked(r)
  let str_eq_idx = ast_binary_read_svarint_checked(r)
  let str_len_idx = ast_binary_read_svarint_checked(r)
  let str_lengths = fw_get_ints(r)
  let str_lex_diff_idx = ast_binary_read_svarint_checked(r)
  let str_offsets = fw_get_ints(r)
  let str_operand_abort_idx = ast_binary_read_svarint_checked(r)
  let str_substring_idx = ast_binary_read_svarint_checked(r)
  let string_index_of_idx = ast_binary_read_svarint_checked(r)
  let struct_field_names = fw_get_matrix(r)
  let struct_names = fw_get_strings(r)
  let thunk_names_list = fw_get_strings(r)
  let trace_cap = ast_binary_read_svarint_checked(r)
  let trace_counter_addr = ast_binary_read_svarint_checked(r)
  let trace_log_base = ast_binary_read_svarint_checked(r)
  let user_shadows_trunc_builtins = ast_binary_read_bool_checked(r)
  let bodies: Array[Expr] = []
  let body_n = ast_binary_read_count_checked(r)
  let mut bi = 0
  while bi < body_n {
    Array::push(bodies, EUnit); bi = bi + 1
  }
  let source_types: Array[Option[TypeExpr]] = []
  let type_n = ast_binary_read_count_checked(r)
  let mut ti = 0
  while ti < type_n {
    Array::push(source_types, None)
    ti = ti + 1
  }
  let lambda_bases = fw_get_ints(r)
  let lambda_count = ast_binary_read_svarint_checked(r)
  let plan_rc = ast_binary_read_bool_checked(r)
  let template = fw_get_blob(r)
  let location_paths = fw_get_strings(r)
  let location_bases = fw_get_ints(r)
  let location_lengths = fw_get_ints(r)
  let location_placed = fw_get_bools(r)
  let location_newlines: Array[Array[Int]] = []
  let location_count = ast_binary_read_count_checked(r)
  let mut location_i = 0
  while location_i < location_count {
    Array::push(location_newlines, fw_get_ints(r)); location_i = location_i + 1
  }
  let locations = MergedOffsetLocations::{
    paths: location_paths,
    bases: location_bases,
    lengths: location_lengths,
    newlines: location_newlines,
    placed: location_placed
  }
  if ast_binary_reader_remaining(r) != 0 || body_n != num_user_funcs || type_n != num_user_funcs || Array::length(lambda_bases) != num_user_funcs || plan_rc != enable_rc || lambda_count < 0 {
    throw("function context: plan counts, RC mode or input boundary mismatch")
  } else ()
  if Array::length(str_strs) != Array::length(str_offsets) || Array::length(str_strs) != Array::length(str_lengths) {
    throw("function context: string table arrays differ")
  } else ()
  if num_user_funcs < 0 || Array::length(fn_names_list) < num_user_funcs || Array::length(all_fn_names_list) != Array::length(all_fn_indices_list) || Array::length(all_fn_names_list) != Array::length(all_fn_param_counts) || Array::length(all_fn_names_list) != Array::length(all_fn_needs_env_list) || Array::length(all_fn_names_list) != Array::length(all_fn_returns_list) {
    throw("function context: function table columns differ")
  } else ()
  let mut previous_lambda = 0
  let mut check_i = 0
  while check_i < num_user_funcs {
    let base = Array::get(lambda_bases, check_i)
    if base < previous_lambda || base > lambda_count || (check_i == 0 && base != 0) {
      throw("function context: invalid planned lambda bases")
    } else ()
    previous_lambda = base; check_i = check_i + 1
  }
  let template_cache = match linear_body_cache_from_bytes(template) {
    Some(cache) => cache,
    None => throw("function context: invalid guard template")
  }
  if Array::length(template_cache.fn_indices) != 0 {
    throw("function context: template contains bodies")
  } else ()
  let effects = lc_function_effects_new(0)
  let input = LinkedBodyInputs::{
    has_exceptions: has_exceptions,
    all_fn_indices_list: all_fn_indices_list,
    all_fn_names_list: all_fn_names_list,
    all_fn_names_sorted: all_fn_names_sorted,
    all_fn_names_sorted_pos: all_fn_names_sorted_pos,
    all_fn_needs_env_list: all_fn_needs_env_list,
    all_fn_param_counts: all_fn_param_counts,
    all_fn_returns_list: all_fn_returns_list,
    arr_get_idx: arr_get_idx,
    arr_len_idx: arr_len_idx,
    arr_new_idx: arr_new_idx,
    arr_push_idx: arr_push_idx,
    arr_slice_idx: arr_slice_idx,
    blind_kinds: effects.blind_kinds,
    blind_offsets: effects.blind_offsets,
    blind_owners: effects.blind_owners,
    blind_syms: effects.blind_syms,
    body_cache_in: codegen_body_cache_discard(),
    body_cache_in_ok: false,
    body_cache_out: template_cache,
    bool_render_offsets: bool_render_offsets,
    bytes_append_idx: bytes_append_idx,
    bytes_get_idx: bytes_get_idx,
    bytes_len_idx: bytes_len_idx,
    bytes_new_idx: bytes_new_idx,
    bytes_push_idx: bytes_push_idx,
    const_int_names_list: const_int_names_list,
    const_int_values_list: const_int_values_list,
    cov_base: cov_base,
    cov_state: cov_disabled(),
    ctor_field_counts_list: ctor_field_counts_list,
    ctor_float_fields_list: ctor_float_fields_list,
    ctor_names_list: ctor_names_list,
    ctor_tags_list: ctor_tags_list,
    ctor_type_names_list: ctor_type_names_list,
    dbg_break_import_idx: dbg_break_import_idx,
    dbg_line_import_idx: dbg_line_import_idx,
    dbg_line_on: dbg_line_on,
    dbg_name_file: dbg_name_file,
    dbg_owner_file: dbg_owner_file,
    dbgargs_base: dbgargs_base,
    dbgargs_cap: dbgargs_cap,
    dbgargs_count_addr: dbgargs_count_addr,
    div_zero_abort_idx: div_zero_abort_idx,
    effect_names_list: effect_names_list,
    effect_op_arities_list: effect_op_arities_list,
    effect_op_keys_list: effect_op_keys_list,
    entry_name: entry_name,
    eq_idx: eq_idx,
    fi: fi,
    float_call_offsets: float_call_offsets,
    float_ret_fn_names: float_ret_fn_names,
    fn_names_list: fn_names_list,
    fn_stmt_indices: [],
    func_offset: func_offset,
    heap_grow_check_idx: heap_grow_check_idx,
    int_render_offsets: int_render_offsets,
    iw_callees: iw_callees,
    iw_names: iw_names,
    iw_wats: iw_wats,
    lambda_slot_base: lambda_slot_base,
    late_dce_rewrote_bodies: late_dce_rewrote_bodies,
    lc_agg_ret_infos: lc_agg_ret_infos,
    lc_agg_ret_names: lc_agg_ret_names,
    lc_agg_ret_names_sorted: lc_agg_ret_names_sorted,
    lc_agg_ret_names_sorted_pos: lc_agg_ret_names_sorted_pos,
    lc_borrow_param_mask: lc_borrow_param_mask,
    lc_borrow_param_user_srt: lc_borrow_param_user_srt,
    lc_borrow_ret_names: lc_borrow_ret_names,
    lc_borrow_view_ret: lc_borrow_view_ret,
    lc_ctor_names_sorted: lc_ctor_names_sorted,
    lc_ctor_names_sorted_pos: lc_ctor_names_sorted_pos,
    lc_fn_file_of: lc_fn_file_of,
    lc_fn_stmt_of: lc_fn_stmt_of,
    lc_heap_ret_names: lc_heap_ret_names,
    lc_name_unique: lc_name_unique,
    lc_owned_return_names: lc_owned_return_names,
    lc_passthrough_ret_params: lc_passthrough_ret_params,
    lc_perceus_pin: lc_perceus_pin,
    lc_scalar_ret_names: lc_scalar_ret_names,
    lc_struct_names_sorted: lc_struct_names_sorted,
    lc_struct_names_sorted_pos: lc_struct_names_sorted_pos,
    lc_type_names_sorted: lc_type_names_sorted,
    library_mode: library_mode,
    linemap_off: lc_function_linemap_new(false),
    linemap_on: linemap_on,
    linemap_state: lc_function_linemap_new(linemap_on),
    lt_w: effects.lambdas,
    map_build_index_idx: map_build_index_idx,
    map_cap_idx: map_cap_idx,
    map_hash_idx: map_hash_idx,
    map_index_insert_idx: map_index_insert_idx,
    map_probe_index_idx: map_probe_index_idx,
    need_array_capacity: need_array_capacity,
    need_bytes_capacity: need_bytes_capacity,
    need_div_zero_abort: need_div_zero_abort,
    need_region_arena: need_region_arena,
    num_src_pairs: num_src_pairs,
    num_user_funcs: num_user_funcs,
    oob_abort_idx: oob_abort_idx,
    pi: pi,
    pin_region_capacity: pin_region_capacity,
    print_i64_raw_idx: print_i64_raw_idx,
    print_str_idx: print_str_idx,
    prov: prov,
    rc_alloc_idx: rc_alloc_idx,
    rc_bins_base: rc_bins_base,
    rc_closure_arms: rc_closure_arms,
    rc_map_arms: rc_map_arms,
    rc_drop_idx: rc_drop_idx,
    rc_dup_idx: rc_dup_idx,
    region_arr_new_idx: region_arr_new_idx,
    region_bytes_new_idx: region_bytes_new_idx,
    region_data_base: region_data_base,
    region_limit: region_limit,
    region_ptr_addr: region_ptr_addr,
    shadow_uaf_abort_idx: shadow_uaf_abort_idx,
    slice_hi: -1,
    slice_lo: 0,
    src_str_base: src_str_base,
    stmts: [],
    str_char_code_at_idx: str_char_code_at_idx,
    str_concat_idx: str_concat_idx,
    str_eq_idx: str_eq_idx,
    str_len_idx: str_len_idx,
    str_lengths: str_lengths,
    str_lex_diff_idx: str_lex_diff_idx,
    str_offsets: str_offsets,
    str_operand_abort_idx: str_operand_abort_idx,
    str_strs: str_strs,
    str_substring_idx: str_substring_idx,
    str_table_shared: str_table_new(str_strs, str_offsets, str_lengths),
    string_index_of_idx: string_index_of_idx,
    struct_field_names: struct_field_names,
    struct_names: struct_names,
    table_slots_used: effects.slots,
    thunk_names_list: thunk_names_list,
    trace_cap: trace_cap,
    trace_counter_addr: trace_counter_addr,
    trace_log_base: trace_log_base,
    user_shadows_trunc_builtins: user_shadows_trunc_builtins
  }
  FunctionContext::{
    plan: LinkedFunctionPlan::{
      bodies: bodies,
      source_types: source_types,
      lambda_bases: lambda_bases,
      lambda_count: lambda_count,
      enable_rc: plan_rc
    },
    input: input,
    debug_break: debug_break,
    debug_trace: debug_trace,
    enable_rc: enable_rc,
    rc_shadow: rc_shadow,
    loaded_lo: 0,
    loaded_hi: 0,
    cache_template: template,
    locations: locations
  }
}

fn fw_copy_input(input: LinkedBodyInputs, offered: CodegenBodyCache, output: CodegenBodyCache, replay: Bool, lo: Int, hi: Int, publish: Bool) -> LinkedBodyInputs {
  let effects = lc_function_effects_new(0)
  let parent_blind_kinds = input.blind_kinds
  let worker_blind_kinds = effects.blind_kinds
  let blind_kinds = if publish {
    parent_blind_kinds
  } else {
    worker_blind_kinds
  }
  let parent_blind_offsets = input.blind_offsets
  let worker_blind_offsets = effects.blind_offsets
  let blind_offsets = if publish {
    parent_blind_offsets
  } else {
    worker_blind_offsets
  }
  let parent_blind_owners = input.blind_owners
  let worker_blind_owners = effects.blind_owners
  let blind_owners = if publish {
    parent_blind_owners
  } else {
    worker_blind_owners
  }
  let parent_blind_syms = input.blind_syms
  let worker_blind_syms = effects.blind_syms
  let blind_syms = if publish {
    parent_blind_syms
  } else {
    worker_blind_syms
  }
  let parent_cov_state = input.cov_state
  let worker_cov_state = cov_disabled()
  let cov_state = if publish {
    parent_cov_state
  } else {
    worker_cov_state
  }
  let parent_linemap_off = input.linemap_off
  let worker_linemap_off = lc_function_linemap_new(false)
  let linemap_off = if publish {
    parent_linemap_off
  } else {
    worker_linemap_off
  }
  let parent_linemap_state = input.linemap_state
  let worker_linemap_state = lc_function_linemap_new(input.linemap_on)
  let linemap_state = if publish {
    parent_linemap_state
  } else {
    worker_linemap_state
  }
  let parent_lt_w = input.lt_w
  let worker_lt_w = effects.lambdas
  let lt_w = if publish {
    parent_lt_w
  } else {
    worker_lt_w
  }
  let parent_table_slots_used = input.table_slots_used
  let worker_table_slots_used = effects.slots
  let table_slots_used = if publish {
    parent_table_slots_used
  } else {
    worker_table_slots_used
  }
  LinkedBodyInputs::{
    has_exceptions: input.has_exceptions,
    all_fn_indices_list: input.all_fn_indices_list,
    all_fn_names_list: input.all_fn_names_list,
    all_fn_names_sorted: input.all_fn_names_sorted,
    all_fn_names_sorted_pos: input.all_fn_names_sorted_pos,
    all_fn_needs_env_list: input.all_fn_needs_env_list,
    all_fn_param_counts: input.all_fn_param_counts,
    all_fn_returns_list: input.all_fn_returns_list,
    arr_get_idx: input.arr_get_idx,
    arr_len_idx: input.arr_len_idx,
    arr_new_idx: input.arr_new_idx,
    arr_push_idx: input.arr_push_idx,
    arr_slice_idx: input.arr_slice_idx,
    blind_kinds: blind_kinds,
    blind_offsets: blind_offsets,
    blind_owners: blind_owners,
    blind_syms: blind_syms,
    body_cache_in: offered,
    body_cache_in_ok: replay,
    body_cache_out: output,
    bool_render_offsets: input.bool_render_offsets,
    bytes_append_idx: input.bytes_append_idx,
    bytes_get_idx: input.bytes_get_idx,
    bytes_len_idx: input.bytes_len_idx,
    bytes_new_idx: input.bytes_new_idx,
    bytes_push_idx: input.bytes_push_idx,
    const_int_names_list: input.const_int_names_list,
    const_int_values_list: input.const_int_values_list,
    cov_base: input.cov_base,
    cov_state: cov_state,
    ctor_field_counts_list: input.ctor_field_counts_list,
    ctor_float_fields_list: input.ctor_float_fields_list,
    ctor_names_list: input.ctor_names_list,
    ctor_tags_list: input.ctor_tags_list,
    ctor_type_names_list: input.ctor_type_names_list,
    dbg_break_import_idx: input.dbg_break_import_idx,
    dbg_line_import_idx: input.dbg_line_import_idx,
    dbg_line_on: input.dbg_line_on,
    dbg_name_file: input.dbg_name_file,
    dbg_owner_file: input.dbg_owner_file,
    dbgargs_base: input.dbgargs_base,
    dbgargs_cap: input.dbgargs_cap,
    dbgargs_count_addr: input.dbgargs_count_addr,
    div_zero_abort_idx: input.div_zero_abort_idx,
    effect_names_list: input.effect_names_list,
    effect_op_arities_list: input.effect_op_arities_list,
    effect_op_keys_list: input.effect_op_keys_list,
    entry_name: input.entry_name,
    eq_idx: input.eq_idx,
    fi: input.fi,
    float_call_offsets: input.float_call_offsets,
    float_ret_fn_names: input.float_ret_fn_names,
    fn_names_list: input.fn_names_list,
    fn_stmt_indices: input.fn_stmt_indices,
    func_offset: input.func_offset,
    heap_grow_check_idx: input.heap_grow_check_idx,
    int_render_offsets: input.int_render_offsets,
    iw_callees: input.iw_callees,
    iw_names: input.iw_names,
    iw_wats: input.iw_wats,
    lambda_slot_base: input.lambda_slot_base,
    late_dce_rewrote_bodies: input.late_dce_rewrote_bodies,
    lc_agg_ret_infos: input.lc_agg_ret_infos,
    lc_agg_ret_names: input.lc_agg_ret_names,
    lc_agg_ret_names_sorted: input.lc_agg_ret_names_sorted,
    lc_agg_ret_names_sorted_pos: input.lc_agg_ret_names_sorted_pos,
    lc_borrow_param_mask: input.lc_borrow_param_mask,
    lc_borrow_param_user_srt: input.lc_borrow_param_user_srt,
    lc_borrow_ret_names: input.lc_borrow_ret_names,
    lc_borrow_view_ret: input.lc_borrow_view_ret,
    lc_ctor_names_sorted: input.lc_ctor_names_sorted,
    lc_ctor_names_sorted_pos: input.lc_ctor_names_sorted_pos,
    lc_fn_file_of: input.lc_fn_file_of,
    lc_fn_stmt_of: input.lc_fn_stmt_of,
    lc_heap_ret_names: input.lc_heap_ret_names,
    lc_name_unique: input.lc_name_unique,
    lc_owned_return_names: input.lc_owned_return_names,
    lc_passthrough_ret_params: input.lc_passthrough_ret_params,
    lc_perceus_pin: input.lc_perceus_pin,
    lc_scalar_ret_names: input.lc_scalar_ret_names,
    lc_struct_names_sorted: input.lc_struct_names_sorted,
    lc_struct_names_sorted_pos: input.lc_struct_names_sorted_pos,
    lc_type_names_sorted: input.lc_type_names_sorted,
    library_mode: input.library_mode,
    linemap_off: linemap_off,
    linemap_on: input.linemap_on,
    linemap_state: linemap_state,
    lt_w: lt_w,
    map_build_index_idx: input.map_build_index_idx,
    map_cap_idx: input.map_cap_idx,
    map_hash_idx: input.map_hash_idx,
    map_index_insert_idx: input.map_index_insert_idx,
    map_probe_index_idx: input.map_probe_index_idx,
    need_array_capacity: input.need_array_capacity,
    need_bytes_capacity: input.need_bytes_capacity,
    need_div_zero_abort: input.need_div_zero_abort,
    need_region_arena: input.need_region_arena,
    num_src_pairs: input.num_src_pairs,
    num_user_funcs: input.num_user_funcs,
    oob_abort_idx: input.oob_abort_idx,
    pi: input.pi,
    pin_region_capacity: input.pin_region_capacity,
    print_i64_raw_idx: input.print_i64_raw_idx,
    print_str_idx: input.print_str_idx,
    prov: input.prov,
    rc_alloc_idx: input.rc_alloc_idx,
    rc_bins_base: input.rc_bins_base,
    rc_closure_arms: input.rc_closure_arms,
    rc_map_arms: input.rc_map_arms,
    rc_drop_idx: input.rc_drop_idx,
    rc_dup_idx: input.rc_dup_idx,
    region_arr_new_idx: input.region_arr_new_idx,
    region_bytes_new_idx: input.region_bytes_new_idx,
    region_data_base: input.region_data_base,
    region_limit: input.region_limit,
    region_ptr_addr: input.region_ptr_addr,
    shadow_uaf_abort_idx: input.shadow_uaf_abort_idx,
    slice_hi: hi,
    slice_lo: lo,
    src_str_base: input.src_str_base,
    stmts: input.stmts,
    str_char_code_at_idx: input.str_char_code_at_idx,
    str_concat_idx: input.str_concat_idx,
    str_eq_idx: input.str_eq_idx,
    str_len_idx: input.str_len_idx,
    str_lengths: input.str_lengths,
    str_lex_diff_idx: input.str_lex_diff_idx,
    str_offsets: input.str_offsets,
    str_operand_abort_idx: input.str_operand_abort_idx,
    str_strs: input.str_strs,
    str_substring_idx: input.str_substring_idx,
    str_table_shared: input.str_table_shared,
    string_index_of_idx: input.string_index_of_idx,
    struct_field_names: input.struct_field_names,
    struct_names: input.struct_names,
    table_slots_used: table_slots_used,
    thunk_names_list: input.thunk_names_list,
    trace_cap: input.trace_cap,
    trace_counter_addr: input.trace_counter_addr,
    trace_log_base: input.trace_log_base,
    user_shadows_trunc_builtins: input.user_shadows_trunc_builtins
  }
}

/// Emit a disjoint range against the same canonical plan with private outputs.
/// Each job clones only the small guard template; decoded input remains local.
export fn run_function_range(ctx: FunctionContext, lo: Int, hi: Int) -> CodegenBodyCache with Exception {
  if lo < 0 || hi < lo || hi > ctx.input.num_user_funcs || lo < ctx.loaded_lo || hi > ctx.loaded_hi {
    throw("function worker: invalid range")
  } else ()
  with_merged_offset_locations(ctx.locations, () -> CodegenBodyCache with Exception {
    let output = match linear_body_cache_from_bytes(ctx.cache_template) {
      Some(cache) => cache,
      None => throw("function worker: invalid guard template")
    }
    let input = fw_copy_input(ctx.input, codegen_body_cache_discard(), output, false, lo, hi, false)
    LinkedFunctionPlan::emit(ctx.plan, input, false, ctx.debug_break, ctx.debug_trace, ctx.enable_rc, ctx.rc_shadow)
    output
  })
}

/// Replay complete validated products into the coordinator's original tables.
/// Only the caller publishes Wasm sections and persistent state.
export fn replay_function_products(ctx: FunctionContext, products: CodegenBodyCache) -> LinkedBodyPlan with Exception {
  validate_function_product(ctx.plan, ctx.input, products, 0, ctx.input.num_user_funcs)
  let input = fw_copy_input(ctx.input, products, ctx.input.body_cache_out, true, 0, -1, true)
  LinkedFunctionPlan::emit(ctx.plan, input, false, ctx.debug_break, ctx.debug_trace, ctx.enable_rc, ctx.rc_shadow)
}

export fn FunctionContext::write_function_context(recv: FunctionContext) -> Bytes with Exception {
  write_function_context(recv)
}

export fn FunctionContext::run_function_range(recv: FunctionContext, lo: Int, hi: Int) -> CodegenBodyCache with Exception {
  run_function_range(recv, lo, hi)
}

export fn FunctionContext::replay_function_products(recv: FunctionContext, products: CodegenBodyCache) -> LinkedBodyPlan with Exception {
  replay_function_products(recv, products)
}
