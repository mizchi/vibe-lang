import ./product.vibe {
  FunctionProductPlan
}
import @vibe/compiler/cache {
  AstBinaryReader,
  ast_binary_read_bool_checked,
  ast_binary_read_count_checked,
  ast_binary_read_string_checked,
  ast_binary_read_svarint_checked,
  ast_binary_reader_remaining,
  ast_binary_write_bool,
  ast_binary_write_svarint,
  ast_binary_write_varint
}
import @vibe/lowering_worker/linear {
  linear_string_reader
}

fn fp_wire_require(ok: Bool, message: String) -> Unit with Exception {
  if !ok {
    throw("function product plan: " + message)
  } else ()
}

fn fp_wire_check(plan: FunctionProductPlan) -> Unit with Exception {
  let n = plan.num_user_funcs
  fp_wire_require(n >= 0 && plan.lambda_count >= 0 && plan.source_file_count >= 0 && plan.lambda_slot_base >= 0, "invalid scalar counts")
  fp_wire_require(Array::length(plan.lambda_bases) == n && Array::length(plan.fn_names) == n && Array::length(plan.fn_files) == n && Array::length(plan.fn_src_stmts) == n, "function columns differ")
  fp_wire_require(n > 0 || plan.lambda_count == 0, "lambdas without an owner")
  let mut previous = 0
  let mut i = 0
  while i < n {
    let base = Array::get(plan.lambda_bases, i)
    fp_wire_require(base >= previous && base <= plan.lambda_count && (i > 0 || base == 0), "invalid lambda bases")
    previous = base
    i = i + 1
  }
  for slot in plan.allowed_slots {
    fp_wire_require(slot >= 0, "invalid function-table slot")
  }
  ()
}

fn fp_wire_put_ints(bytes: Bytes, values: Array[Int]) -> Unit {
  ast_binary_write_varint(bytes, Array::length(values))
  for value in values {
    ast_binary_write_svarint(bytes, value)
  }
  ()
}

// Standalone packets must not inherit an enclosing AST encoder's string pool.
fn fp_wire_put_string(bytes: Bytes, value: String) -> Unit {
  ast_binary_write_varint(bytes, String::length(value))
  let mut i = 0
  while i < String::length(value) {
    Bytes::push(bytes, String::char_code_at(value, i))
    i = i + 1
  }
}

fn fp_wire_get_ints(reader: AstBinaryReader, expected: Int) -> Array[Int] with Exception {
  let n = ast_binary_read_count_checked(reader)
  fp_wire_require(expected < 0 || n == expected, "integer column count differs")
  let values: Array[Int] = []
  let mut i = 0
  while i < n {
    Array::push(values, ast_binary_read_svarint_checked(reader))
    i = i + 1
  }
  values
}

/// Only primitive metadata crosses this boundary. The enclosing native phase
/// receipt must bind these bytes to the original preparation/context digest.
export fn write_function_product_plan(plan: FunctionProductPlan) -> Bytes with Exception {
  fp_wire_check(plan)
  let bytes = Bytes::new()
  fp_wire_put_string(bytes, "vibe-function-product-plan-1")
  ast_binary_write_varint(bytes, plan.num_user_funcs)
  ast_binary_write_svarint(bytes, plan.lambda_count)
  ast_binary_write_svarint(bytes, plan.lambda_slot_base)
  ast_binary_write_svarint(bytes, plan.source_file_count)
  ast_binary_write_bool(bytes, plan.linemap_on)
  ast_binary_write_varint(bytes, Array::length(plan.fn_names))
  for name in plan.fn_names {
    fp_wire_put_string(bytes, name)
  }
  fp_wire_put_ints(bytes, plan.fn_files)
  fp_wire_put_ints(bytes, plan.fn_src_stmts)
  fp_wire_put_ints(bytes, plan.lambda_bases)
  fp_wire_put_ints(bytes, plan.allowed_slots)
  fp_wire_require(Bytes::length(bytes) <= 64 * 1024 * 1024, "exceeds 64 MiB input limit")
  bytes
}

export fn read_function_product_plan(bytes: Bytes) -> FunctionProductPlan with Exception {
  fp_wire_require(Bytes::length(bytes) <= 64 * 1024 * 1024, "exceeds 64 MiB input limit")
  let reader = linear_string_reader(bytes)
  fp_wire_require(ast_binary_read_string_checked(reader) == "vibe-function-product-plan-1", "unsupported format")
  let n = ast_binary_read_count_checked(reader)
  let lambda_count = ast_binary_read_svarint_checked(reader)
  let lambda_slot_base = ast_binary_read_svarint_checked(reader)
  let source_file_count = ast_binary_read_svarint_checked(reader)
  let linemap_on = ast_binary_read_bool_checked(reader)
  let names_count = ast_binary_read_count_checked(reader)
  fp_wire_require(names_count == n, "function name count differs")
  let names: Array[String] = []
  let mut i = 0
  while i < n {
    Array::push(names, ast_binary_read_string_checked(reader))
    i = i + 1
  }
  let files = fp_wire_get_ints(reader, n)
  let statements = fp_wire_get_ints(reader, n)
  let bases = fp_wire_get_ints(reader, n)
  let slots = fp_wire_get_ints(reader, -1)
  fp_wire_require(ast_binary_reader_remaining(reader) == 0, "trailing bytes")
  let plan = FunctionProductPlan::{
    num_user_funcs: n,
    lambda_bases: bases,
    lambda_count: lambda_count,
    fn_names: names,
    fn_files: files,
    fn_src_stmts: statements,
    allowed_slots: slots,
    lambda_slot_base: lambda_slot_base,
    linemap_on: linemap_on,
    source_file_count: source_file_count
  }
  fp_wire_check(plan)
  plan
}

export fn FunctionProductPlan::write_function_product_plan(recv: FunctionProductPlan) -> Bytes with Exception {
  write_function_product_plan(recv)
}
