/// #1259 step 7: one user function's codegen OUTPUT, carried as a value.
///
/// Body codegen has to become something a coordinator can hand out per
/// function and collect back, and the compiler runs inside wasm -- it cannot
/// spawn workers, and it must not grow an `Fs` row to persist anything (that
/// row propagates out through the codegen facades and into the signatures of
/// user programs that call `compile_wasi_module`, which is not acceptable).
/// So the unit of exchange is a VALUE: the caller (file_compile, which already
/// has Fs) does any serialization.
///
/// Parallel arrays rather than an array of records, matching how `bodies` /
/// `meta_i32` / `meta_i64` and LambdaTable are already carried in this
/// codegen.
///
/// `fn_*` is one entry per cached user function, keyed by `fn_indices`.
/// `lam_*` is one entry per lambda that function produced, keyed by the
/// PLANNED lambda index (#1275/#1277) -- which is what makes a body compiled
/// in isolation reusable: its emitted table_slot immediates already refer to
/// the slots the whole-program assembly will install these lambdas at.
export struct CodegenBodyCache {
  fn_indices: Array[Int];
  /// #2669 step 2a: the function each entry was harvested from, by NAME.
  ///
  /// `fn_indices` keys the lookup today, and that is exactly why
  /// `decode_body_cache_payload_for` can only keep the unchanged leading
  /// PREFIX of files: over an identical prefix, cache index i and build index
  /// i are the same function, and past the first change they are not. The
  /// prefix rule is that precondition, not caution.
  ///
  /// A name does not move when something ahead of it is inserted, so keying
  /// on it is what lets the filter keep every unchanged file instead. Recorded
  /// now and checked against the index lookup; nothing depends on it yet.
  fn_names: Array[String];
  /// #2669 step 2b: the SOURCE FILE each entry was harvested from, by index
  /// into the compile's file list, or -1 when the compile could not say.
  ///
  /// This is what the widened filter keys on, and it exists because a
  /// statement POSITION after lowering cannot answer the question: prelude
  /// insertion and DCE compaction move it across source-file boundaries.
  /// `fn_src_stmts` now preserves the original position too, for the prefix
  /// fallback, but a file id directly answers the wider unchanged-file query.
  ///
  /// The file id comes from the pre-prelude name -> file snapshot
  /// (`pre_prelude_let_names` / `pre_prelude_let_files`), the identity that
  /// survives the prelude -- the same one interior-line breakpoints resolve a
  /// function's file through.
  fn_files: Array[Int];
  fn_bodies: Array[Bytes];
  fn_meta_i32: Array[Int];
  fn_meta_i64: Array[Int];
  /// v128-local run length of the function's code-entry locals header
  /// (inline-wasm fns with `(local $x v128)` declarations; 0 otherwise).
  fn_meta_v128: Array[Int];
  lam_owner: Array[Int];
  lam_indices: Array[Int];
  lam_bodies: Array[Bytes];
  lam_param_counts: Array[Int];
  lam_captures: Array[Array[String]];
  lam_meta_i32: Array[Int];
  lam_meta_i64: Array[Int];
  /// The `table_slots_used` entries this function's compile appended, keyed by
  /// owning function index. Not part of the function's own bytes -- the log is
  /// read only after the body loop, to decide which table slots the element
  /// section registers -- but a replayed function never runs the pushes, so
  /// without carrying them a fully replayed build would emit a SMALLER element
  /// section than a compiled one. The consumer builds a flag set, so order and
  /// duplicates do not matter, which is what lets slices merge freely.
  slot_owner: Array[Int];
  slot_values: Array[Int];
  /// #2669 slice 3: the references this function's compile recorded that the
  /// INSTRUCTION ENCODING does not expose -- a function used as a value, and
  /// the funcref slot a capturing lambda stores in its closure header. Carried
  /// for the same reason as slot_owner above: a replayed function never runs
  /// the emission, so without these a replaying build's log is short by
  /// exactly the functions it replayed, and the paired-count invariant that
  /// keeps the recording honest could only be checked on compiled ones.
  ///
  /// `blind_fn` is the owning user function, the selection key that lets
  /// merge and filter reuse the same keep-set logic the slots use.
  /// `blind_body` is the BODY the record sits in -- the same function, or one
  /// of its lambdas as `blind_owner_of_lambda` -- because the offset is
  /// relative to that body's instruction stream and to no other.
  blind_fn: Array[Int];
  blind_body: Array[Int];
  blind_offsets: Array[Int];
  blind_kinds: Array[Int];
  blind_syms: Array[Int];
  /// #2199: production `vibe.linemap` rows this function recorded. Replay
  /// skips `compile_expr`, so without these a warm/verify compile emits a
  /// shorter (or empty) linemap than a fresh one and `verify` traps on the
  /// byte mismatch. Offsets are body-relative, same as `LineMapState` at
  /// record time; the consuming compile adds locals-header length.
  lm_owner: Array[Int];
  lm_offsets: Array[Int];
  lm_file_ids: Array[Int];
  lm_lines: Array[Int];
  /// #2721: the ORIGINAL merged-statement index, before the prelude or DCE,
  /// parallel to fn_indices (-1 for an unknown or ambiguous origin). Replay ignores
  /// it; the cross-compile persistence layer uses it to keep only the
  /// entries whose source-group prefix is unchanged.
  fn_src_stmts: Array[Int];
  /// #2388 step 3 guards. Cross-compile replay is only sound while the
  /// layout facts every cached body's immediates were emitted against still
  /// hold in the consuming compile. `guard_meta` is exactly
  /// `[pin_src_n, pin_capacity, lambda_slot_base, num_imported_funcs,
  /// num_generated]` when the recording compile ran the #2388 step-2 pin
  /// reorder, and empty otherwise -- an empty guard makes the cache
  /// in-process-only (the consumer treats it as unusable across compiles).
  /// The import/generated counts pin `func_offset`, the base every user
  /// call immediate is built on. `guard_synth_names`/`guard_synth_stmts`
  /// are the synthesized region's function names and their merged-statement
  /// positions: a prelude whose synthesized output changed in CONTENT keeps
  /// name and position, so synthesized entries are never replayed across
  /// compiles at all -- these lists exist to pin their count, order, and
  /// insertion positions, which is what keeps every pre-pass table
  /// (string pool, signatures) and the synth index region aligned for the
  /// source bodies that ARE replayed. `guard_import_names` is the sorted
  /// used-builtin-name set plus the linked-import names: the gated host
  /// imports are assigned indices by a fixed code sequence of
  /// `Map::has_key(used_builtin_names, ...)` tests, so set equality (not
  /// merely count equality -- two different sets of the same size assign
  /// DIFFERENT indices to each import) pins the whole import vector.
  /// `guard_borrow_names`/`guard_borrow_masks` are the ADR-0092 program-wide
  /// borrow-parameter inference (sorted names, masks aligned): it is
  /// CALL-SITE sensitive -- a position ever passed a non-ident argument is
  /// disqualified -- so an edit anywhere can flip an unchanged function's
  /// owned/borrowed parameter ABI, changing both its own drop obligations
  /// and every caller's dup obligations. Replay is only sound while the
  /// whole vector is unchanged.
  /// `guard_unmangled_names` closes the global name-membership class:
  /// compile_call's `prefer_bound_call` and the func-table name lookups are
  /// cross-file matches on the spelled name, and only builtin-spelled names
  /// take those branches. Prefix defs are #716 path-mangled, so the names
  /// that can flip such a branch are the unmangled source-region ones;
  /// `__test_`/`__bench_` blocks are excluded (nothing calls them by name),
  /// which is what keeps the append-a-test edit inside the cache.
  guard_meta: Array[Int];
  guard_synth_names: Array[String];
  guard_synth_stmts: Array[Int];
  guard_import_names: Array[String];
  guard_borrow_names: Array[String];
  guard_borrow_masks: Array[Int];
  guard_unmangled_names: Array[String];
  /// #2669 step 2b: the PROGRAM-WIDE inputs a cached body's bytes depend on,
  /// as a fixed-order list of `[h1, h2]` fingerprints -- the fact the prefix
  /// rule used to supply for free, so replay can reach past the leading prefix
  /// to EVERY unchanged file.
  ///
  /// Merge order is topological, so a body in the unchanged PREFIX can only
  /// reference things declared in the unchanged prefix: its call immediates,
  /// funcref slots, string offsets, constructor tags and exception tags could
  /// not have moved. A body from a file AFTER the edit has none of that
  /// protection.
  ///
  /// What must be pinned is not a list of index spaces someone thought of --
  /// four reference classes were found missing one at a time in the reloc scan
  /// for exactly that reason. It is a CLOSED set, and `CompileCtx` is what
  /// closes it: a function's bytes are a function of its own AST and the
  /// context it is compiled in, and a per-function value is in turn a function
  /// of its own AST and the program-wide part of that context (the Perceus
  /// plan, for instance, takes only the body plus the borrow tables). So the
  /// slots are every program-wide field the per-function `CompileCtx` is built
  /// from, enumerated at that construction site in `linked_compile.vibe`.
  ///
  /// Fingerprints rather than the values: the pinned set includes the entire
  /// string pool and the whole function vector, which would roughly double the
  /// artifact. The artifact already stakes correctness on a fingerprint of the
  /// same shape -- `bcw_checksum` decides whether a stored body is read at all.
  ///
  /// The LENGTH is a schema check: a compile whose slot count differs from the
  /// harvest's is one whose enumeration changed, and it declines.
  guard_layout: Array[Int];
  /// #2669 step 2b (Codex P0): the checker's PER-MODULE typed-lowering
  /// classification, fingerprinted in each module's OWN coordinates.
  ///
  /// `guard_layout` folds `float_ret_fn_names` but deliberately not the three
  /// typed-lowering OFFSET arrays, because those are positions in the merged
  /// text -- a comment anywhere shifts every offset after it, and folding them
  /// made a comment-only edit decline the whole widened lane (measured:
  /// `offered=4394 recompiled=5155`, a cold build in all but name).
  ///
  /// What that leaves unpinned is the CLASSIFICATION those offsets carry, and
  /// one class of it is name-keyed nowhere: a callee that changes from `Int` to
  /// `Bool` keeps its name, its arity and its scalar-return classification,
  /// while every render and `eq` argument fed by it changes tag. So this
  /// fingerprints each module's own table -- `module_typed_lowering_offsets_for_path`
  /// and `module_typed_eq_rows_for_path`, before the merge rebases them.
  ///
  /// Those rows follow the INTERFACES a module reads, not the text anyone else
  /// moves. Measured on a two-file chain, editing the callee's file and reading
  /// the untouched CONSUMER's rows: a comment, a same-length body edit, and a
  /// body edit that LENGTHENS the callee's file all leave them at `[715]`;
  /// changing the callee's return type from `Int` to `Bool` moves them to
  /// `[717]`. That is the dependence this guard exists to see, and the reason
  /// the merged arrays cannot stand in for it.
  ///
  /// Filled in by the FS lane, which is the layer that knows the file list;
  /// empty on every in-process lane, where it pins nothing and nothing reads it.
  guard_typed_lowering: Array[Int];
  /// #2669 step 2b, and NOT part of the artifact: what the CONSUMING build's
  /// file table said, filled in by `decode_body_cache_payload_for` and read by
  /// the body loop. One element, the merged-statement limit of the unchanged
  /// leading PREFIX -- the subset that stays replayable when the three guards
  /// above do not hold, so widening can never leave a build with less than it
  /// had. Empty means "no narrowing available", which is what an in-process
  /// cache and a hand-built one both are.
  consumer_src_limit: Array[Int];
  /// #2199 follow-up: does anyone READ what this cache collects? One element,
  /// 1 to record and 0 to decline. The ordinary `vibe run` / `vibe test`
  /// compile passes a fresh cache as its out-parameter and drops it on the
  /// floor, so every row `codegen_body_cache_record` fills there is allocated
  /// and never read -- and the per-function `vibe.linemap` rows made that the
  /// largest of them (measured: 4.6 MiB of the selfcompile KPI's bump heap,
  /// which never frees). `codegen_body_cache_discard` is that cache.
  collect: Array[Int]
}
