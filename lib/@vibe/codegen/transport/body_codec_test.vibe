test "VBC7 populated and empty streams match the frozen main codec" {
  assert(bytes_eq(a = CodegenBodyCache::codegen_body_cache_to_bytes(sample_cache()), b = populated_golden()))
  assert(bytes_eq(a = codegen_body_cache_to_bytes(sample_cache()), b = populated_golden()))
  assert(bytes_eq(a = codegen_body_cache_to_bytes(codegen_body_cache_new()), b = empty_golden()))
  match codegen_body_cache_from_bytes(populated_golden()) {
    Some(cache) => assert(bytes_eq(a = codegen_body_cache_to_bytes(cache), b = populated_golden())),
    None => assert(false)
  }
}

test "VBC7 refuses every strict truncation and unsupported versions" {
  let complete = populated_golden()
  let mut end = 0
  while end < Bytes::length(complete) {
    match codegen_body_cache_from_bytes(Bytes::slice(complete, start = 0, end = end)) {
      None => (),
      Some(_) => assert(false)
    }
    end = end + 1
  }
  for version in ['1', '2', '3', '4', '5', '6', '8'] {
    let bytes = populated_golden()
    Bytes::set(bytes, at = 3, value = version)
    match codegen_body_cache_from_bytes(bytes) {
      None => (),
      Some(_) => assert(false)
    }
  }
}

test "VBC7 refuses negative function indices and incomplete parallel columns" {
  let negative = codegen_body_cache_new()
  Array::push(negative.fn_indices, value = -1)
  match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(negative)) {
    None => (),
    Some(_) => assert(false)
  }
  let incomplete = sample_cache()
  Array::push(incomplete.lm_owner, value = 0)
  match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(incomplete)) {
    None => (),
    Some(_) => assert(false)
  }
  // #2818: an entry without a fold signature is not "unfolded" -- it is a
  // stream that cannot say, and replaying it could be silently wrong.
  let unsigned = sample_cache()
  Array::push(unsigned.fn_indices, value = 4)
  Array::push(unsigned.fn_names, value = "gamma")
  Array::push(unsigned.fn_files, value = 1)
  Array::push(unsigned.fn_src_stmts, value = 8)
  Array::push(unsigned.fn_bodies, value = string_to_bytes("f"))
  Array::push(unsigned.fn_meta_i32, value = 0)
  Array::push(unsigned.fn_meta_i64, value = 0)
  Array::push(unsigned.fn_meta_v128, value = 0)
  match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(unsigned)) {
    None => (),
    Some(_) => assert(false)
  }
  let unaligned = sample_cache()
  Array::push(unaligned.guard_fold_names, value = "delta")
  match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(unaligned)) {
    None => (),
    Some(_) => assert(false)
  }
}

test "VBC7 retains the negative-field diagnostic" {
  let invalid = codegen_body_cache_new()
  Array::push(invalid.fn_indices, value = -2)
  let message = handle {
    let _ = codegen_body_cache_to_bytes(invalid)
    "unexpected success"
  } with { Exception::Throw(message) => message }
  assert(message == "body-cache codec: negative field -2")
}

test "VBC7 written behind a prefix decodes in place, byte for byte" {
  // The persisted artifact holds a header and a file table before the
  // stream; writing into that buffer and decoding at the offset must answer
  // exactly what the standalone stream does (#2818).
  let buf = string_to_bytes("hdr")
  codegen_body_cache_write_to(buf = buf, cache = sample_cache())
  assert(bytes_eq(a = Bytes::slice(buf, start = 3, end = Bytes::length(buf)), b = populated_golden()))
  match codegen_body_cache_from_bytes_at(b = buf, start = 3) {
    Some(cache) => assert(bytes_eq(a = codegen_body_cache_to_bytes(cache), b = populated_golden())),
    None => assert(false)
  }
  // The offset is where the magic must be, not a hint.
  match codegen_body_cache_from_bytes_at(b = buf, start = 2) {
    None => (),
    Some(_) => assert(false)
  }
  match codegen_body_cache_from_bytes_at(b = buf, start = 0 - 1) {
    None => (),
    Some(_) => assert(false)
  }
  match codegen_body_cache_from_bytes_at(b = buf, start = Bytes::length(buf)) {
    None => (),
    Some(_) => assert(false)
  }
}
