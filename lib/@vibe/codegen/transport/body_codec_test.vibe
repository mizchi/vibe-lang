import ./body_product.vibe {
  CodegenBodyCache
}
import ./body_codec.vibe {
  CodegenBodyCache::codegen_body_cache_to_bytes, codegen_body_cache_from_bytes, codegen_body_cache_new, codegen_body_cache_to_bytes
}

// Golden streams were generated by the unchanged codec on main ab9f2662.
// Comparing a fixed stream also catches paired encoder/decoder order changes.
fn bytes_from_ints(values: Array[Int]) -> Bytes {
  let bytes = Bytes::new()
  let mut i = 0
  while i < Array::length(values) {
    Bytes::push(bytes, Array::get(values, i))
    i = i + 1
  }
  bytes
}

fn string_to_bytes(s: String) -> Bytes {
  let out = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Bytes::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  out
}

fn bytes_eq(a: Bytes, b: Bytes) -> Bool {
  let n = Bytes::length(a)
  if n != Bytes::length(b) {
    false
  } else {
    let mut i = 0
    let mut same = true
    while same && i < n {
      if Bytes::get(a, i) != Bytes::get(b, i) {
        same = false
      } else {
        i = i + 1
      }
    }
    same
  }
}

/// A populated cache exercising every field group: one function entry in the
/// source region (fn_index 0), one outside it (fn_index 3, which the filter
/// must drop), a lambda with captures, a slot-log entry, and recorded
/// guards.
fn sample_cache() -> CodegenBodyCache {
  let c = codegen_body_cache_new()
  Array::push(c.fn_indices, 0)
  Array::push(c.fn_names, "alpha")
  Array::push(c.fn_files, 0)
  Array::push(c.fn_src_stmts, 2)
  Array::push(c.fn_bodies, string_to_bytes("ab"))
  Array::push(c.fn_meta_i32, 1)
  Array::push(c.fn_meta_i64, 2)
  Array::push(c.fn_meta_v128, 0)
  Array::push(c.fn_indices, 3)
  Array::push(c.fn_names, "beta")
  Array::push(c.fn_files, 1)
  Array::push(c.fn_src_stmts, 7)
  Array::push(c.fn_bodies, string_to_bytes("cde"))
  Array::push(c.fn_meta_i32, 4)
  Array::push(c.fn_meta_i64, 5)
  Array::push(c.fn_meta_v128, 1)
  Array::push(c.lam_owner, 0)
  Array::push(c.lam_indices, 5)
  Array::push(c.lam_bodies, string_to_bytes("xyz"))
  Array::push(c.lam_param_counts, 2)
  Array::push(c.lam_captures, ["a", "bb"])
  Array::push(c.lam_meta_i32, 9)
  Array::push(c.lam_meta_i64, 0 - 1)
  Array::push(c.slot_owner, 0)
  Array::push(c.slot_values, 1029)
  // #2669 slice 3: blind references, one owned by the FUNCTION and one owned
  // by a LAMBDA. The lambda's owner is `blind_owner_of_lambda(5)` = -7, which
  // is what makes this case load-bearing: the plain int codec encodes `v + 1`
  // unsigned and throws below -1, so before the zigzag column this aborted
  // the whole serialization. The sample had no blind rows at all, so the
  // round-trip proved nothing about them.
  Array::push(c.blind_fn, 0)
  Array::push(c.blind_body, 0)
  Array::push(c.blind_offsets, 17)
  Array::push(c.blind_kinds, 101)
  Array::push(c.blind_syms, 42)
  Array::push(c.blind_fn, 0)
  Array::push(c.blind_body, 0 - 7)
  Array::push(c.blind_offsets, 3)
  Array::push(c.blind_kinds, 102)
  Array::push(c.blind_syms, 1030)
  // #2199: per-function linemap rows. Replay skips `compile_expr`, so these
  // have to round-trip or `verify` sees a shorter `vibe.linemap` than fresh.
  Array::push(c.lm_owner, 0)
  Array::push(c.lm_offsets, 12)
  Array::push(c.lm_file_ids, 0)
  Array::push(c.lm_lines, 4)
  Array::push(c.lm_owner, 3)
  Array::push(c.lm_offsets, 8)
  Array::push(c.lm_file_ids, 1)
  Array::push(c.lm_lines, 9)
  Array::push(c.guard_meta, 1)
  Array::push(c.guard_meta, 1024)
  Array::push(c.guard_meta, 2048)
  Array::push(c.guard_meta, 7)
  Array::push(c.guard_meta, 40)
  Array::push(c.guard_synth_names, "Pt::equals")
  Array::push(c.guard_synth_stmts, 42)
  Array::push(c.guard_import_names, "vibe_env_get")
  Array::push(c.guard_import_names, "vibe_http_request_raw")
  Array::push(c.guard_borrow_names, "peek")
  Array::push(c.guard_borrow_masks, 5)
  Array::push(c.guard_unmangled_names, "run")
  // #2669 step 2b: two layout slots, and one typed-lowering slot.
  Array::push(c.guard_layout, 3)
  Array::push(c.guard_layout, 12)
  Array::push(c.guard_layout, 99)
  Array::push(c.guard_layout, 77)
  Array::push(c.guard_typed_lowering, 5)
  Array::push(c.guard_typed_lowering, 8)
  c
}

