test "VBC6 populated and empty streams match the frozen main codec" {
  assert(bytes_eq(CodegenBodyCache::codegen_body_cache_to_bytes(sample_cache()), populated_golden()))
  assert(bytes_eq(codegen_body_cache_to_bytes(sample_cache()), populated_golden()))
  assert(bytes_eq(codegen_body_cache_to_bytes(codegen_body_cache_new()), empty_golden()))
  match codegen_body_cache_from_bytes(populated_golden()) {
    Some(cache) => assert(bytes_eq(codegen_body_cache_to_bytes(cache), populated_golden())),
    None => assert(false)
  }
}

test "VBC6 refuses every strict truncation and unsupported versions" {
  let complete = populated_golden()
  let mut end = 0
  while end < Bytes::length(complete) {
    match codegen_body_cache_from_bytes(Bytes::slice(complete, 0, end)) {
      None => (),
      Some(_) => assert(false)
    }
    end = end + 1
  }
  for version in ['1', '2', '3', '4', '5', '7'] {
    let bytes = populated_golden()
    Bytes::set(bytes, 3, version)
    match codegen_body_cache_from_bytes(bytes) {
      None => (),
      Some(_) => assert(false)
    }
  }
}

test "VBC6 refuses negative function indices and incomplete parallel columns" {
  let negative = codegen_body_cache_new()
  Array::push(negative.fn_indices, -1)
  match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(negative)) {
    None => (),
    Some(_) => assert(false)
  }
  let incomplete = sample_cache()
  Array::push(incomplete.lm_owner, 0)
  match codegen_body_cache_from_bytes(codegen_body_cache_to_bytes(incomplete)) {
    None => (),
    Some(_) => assert(false)
  }
}

test "VBC6 retains the negative-field diagnostic" {
  let invalid = codegen_body_cache_new()
  Array::push(invalid.fn_indices, -2)
  let message = handle {
    let _ = codegen_body_cache_to_bytes(invalid)
    "unexpected success"
  } with { Exception::Throw(message) => message }
  assert(message == "body-cache codec: negative field -2")
}
