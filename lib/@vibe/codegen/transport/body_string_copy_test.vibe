import ./body_codec.vibe {
  codegen_body_cache_from_bytes_with_string_copy
}

test "body string copier is never called for an unchecked span" {
  for suffix in [[0], [127, 97], [128], [255, 255, 255, 255, 255, 127]] {
    let wire = Bytes::from_array([86, 66, 67, 54, 1, 2])
    for byte in suffix {
      Bytes::push(wire, byte)
    }
    let calls: Array[Int] = []
    let result = codegen_body_cache_from_bytes_with_string_copy(wire, (b, at, n) -> {
      Array::push(calls, at)
      // A bad callback invocation must be observed without reading bad memory.
      "unexpected"
    })
    assert_eq(Array::length(calls), 0)
    assert(match result {
      None => true,
      Some(_) => false
    })
  }
}
