import @vibe/core {
  array_empty, write_uleb128
}

import ./body_product.vibe {
  CodegenBodyCache
}

/// An empty cache. Threading one of these in means "compile everything, cache
/// nothing" -- the pre-#1259 behaviour.
export fn codegen_body_cache_new() -> CodegenBodyCache {
  CodegenBodyCache::{
    fn_indices: array_empty(),
    fn_names: array_empty(),
    fn_files: array_empty(),
    fn_bodies: array_empty(),
    fn_meta_i32: array_empty(),
    fn_meta_i64: array_empty(),
    fn_meta_v128: array_empty(),
    lam_owner: array_empty(),
    lam_indices: array_empty(),
    lam_bodies: array_empty(),
    lam_param_counts: array_empty(),
    lam_captures: array_empty(),
    lam_meta_i32: array_empty(),
    lam_meta_i64: array_empty(),
    slot_owner: array_empty(),
    slot_values: array_empty(),
    blind_fn: array_empty(),
    blind_body: array_empty(),
    blind_offsets: array_empty(),
    blind_kinds: array_empty(),
    blind_syms: array_empty(),
    lm_owner: array_empty(),
    lm_offsets: array_empty(),
    lm_file_ids: array_empty(),
    lm_lines: array_empty(),
    fn_src_stmts: array_empty(),
    guard_meta: array_empty(),
    guard_synth_names: array_empty(),
    guard_synth_stmts: array_empty(),
    guard_import_names: array_empty(),
    guard_borrow_names: array_empty(),
    guard_borrow_masks: array_empty(),
    guard_unmangled_names: array_empty(),
    guard_layout: array_empty(),
    guard_typed_lowering: array_empty(),
    consumer_src_limit: array_empty(),
    collect: [1]
  }
}

/// An out-cache for a compile that will not read it: `record` is a no-op, so
/// the compile allocates none of the per-function rows. Everything else --
/// the guards a caller pushes directly, replay from an IN cache -- is
/// unchanged, and reading this cache afterwards is what the name refuses.
export fn codegen_body_cache_discard() -> CodegenBodyCache {
  let c = codegen_body_cache_new()
  Array::set(c.collect, 0, 0)
  c
}

//# CodegenBodyCache codec (#2388 step 3)

// Length-prefixed binary layout, "VBC6" magic. Every integer is LEB128 of
// (value + 1), so -1 (a recording site with no statement) round-trips and
// any other negative -- which no field legitimately holds -- fails loudly at
// encode time instead of corrupting the stream. Deserialize is fail-safe:
// anything malformed returns None and the caller compiles from scratch; a
// damaged artifact can cost a cache miss, never a wrong body.

fn bcc_push_int(buf: Bytes, v: Int) -> Unit with Exception {
  if v < 0 - 1 {
    throw(String::concat("body-cache codec: negative field ", bcc_int_to_string(v)))
  } else {
    ()
  }
  write_uleb128(buf, v + 1)
}

fn bcc_push_int_array(buf: Bytes, xs: Array[Int]) -> Unit with Exception {
  bcc_push_int(buf, Array::length(xs))
  let mut i = 0
  while i < Array::length(xs) {
    bcc_push_int(buf, Array::get(xs, i))
    i = i + 1
  }
}

/// #2669 slice 3: an Int array whose values may be BELOW -1.
///
/// The plain codec above encodes `v + 1` as an unsigned LEB and throws for
/// anything under -1, which is right for every column it was written for --
/// those are indices and counts. `blind_body` is not: a record made inside a
/// lambda names it as `blind_owner_of_lambda`, i.e. `-2 - lambda_idx`, so
/// writing it through `bcc_push_int_array` aborted the harvest of any program
/// with a function value inside a lambda. Found by review on #2710; the
/// in-process replay test never serializes, so nothing else saw it.
///
/// Zigzag, written arithmetically rather than with shifts so it does not
/// depend on the tagged Int's width: non-negative `v` maps to `2v`, negative
/// to `-2v - 1`, which is a bijection onto the non-negatives the plain
/// encoder already accepts.
fn bcc_push_zigzag_int_array(buf: Bytes, xs: Array[Int]) -> Unit with Exception {
  bcc_push_int(buf, Array::length(xs))
  let mut i = 0
  while i < Array::length(xs) {
    let v = Array::get(xs, i)
    let z = if v >= 0 {
      v * 2
    } else {
      0 - v * 2 - 1
    }
    bcc_push_int(buf, z)
    i = i + 1
  }
}

fn bcc_push_bytes(buf: Bytes, b: Bytes) -> Unit with Exception {
  bcc_push_int(buf, Bytes::length(b))
  Bytes::append(buf, b)
}

fn bcc_push_bytes_array(buf: Bytes, xs: Array[Bytes]) -> Unit with Exception {
  bcc_push_int(buf, Array::length(xs))
  let mut i = 0
  while i < Array::length(xs) {
    bcc_push_bytes(buf, Array::get(xs, i))
    i = i + 1
  }
}

fn bcc_push_string(buf: Bytes, s: String) -> Unit with Exception {
  bcc_push_int(buf, String::length(s))
  let mut i = 0
  while i < String::length(s) {
    Bytes::push(buf, String::char_code_at(s, i))
    i = i + 1
  }
}

fn bcc_push_string_array(buf: Bytes, xs: Array[String]) -> Unit with Exception {
  bcc_push_int(buf, Array::length(xs))
  let mut i = 0
  while i < Array::length(xs) {
    bcc_push_string(buf, Array::get(xs, i))
    i = i + 1
  }
}

fn bcc_push_string_arrays(buf: Bytes, xs: Array[Array[String]]) -> Unit with Exception {
  bcc_push_int(buf, Array::length(xs))
  let mut i = 0
  while i < Array::length(xs) {
    let inner = Array::get(xs, i)
    bcc_push_int(buf, Array::length(inner))
    let mut j = 0
    while j < Array::length(inner) {
      bcc_push_string(buf, Array::get(inner, j))
      j = j + 1
    }
    i = i + 1
  }
}

export fn codegen_body_cache_to_bytes(cache: CodegenBodyCache) -> Bytes with Exception {
  let buf = Bytes::new()
  Bytes::push(buf, 'V')
  Bytes::push(buf, 'B')
  Bytes::push(buf, 'C')
  // Bumped on every stream change so an artifact written by an older compiler
  // is REJECTED rather than read short: '1' -> '2' when #2669 slice 3 added
  // the blind-reference arrays, '2' -> '3' when step 2a added fn_names. (The
  // store is keyed on the codegen fingerprint too, so this is the second line
  // of defence, not the first.) '3' -> '4' when step 2b added the layout
  // guard, the typed-lowering guard and the per-entry source file that let
  // replay reach past the leading prefix.
  // '4' -> '5': fn_src_stmts now uses pre-prelude coordinates. Reading an
  // old compacted position against a source-prefix boundary is unsound.
  // '5' -> '6': per-function vibe.linemap rows, so a replayed body still
  // contributes production trap provenance (#2199).
  Bytes::push(buf, '6')
  bcc_push_int_array(buf, cache.fn_indices)
  bcc_push_string_array(buf, cache.fn_names)
  bcc_push_int_array(buf, cache.fn_files)
  bcc_push_int_array(buf, cache.fn_src_stmts)
  bcc_push_bytes_array(buf, cache.fn_bodies)
  bcc_push_int_array(buf, cache.fn_meta_i32)
  bcc_push_int_array(buf, cache.fn_meta_i64)
  bcc_push_int_array(buf, cache.fn_meta_v128)
  bcc_push_int_array(buf, cache.lam_owner)
  bcc_push_int_array(buf, cache.lam_indices)
  bcc_push_bytes_array(buf, cache.lam_bodies)
  bcc_push_int_array(buf, cache.lam_param_counts)
  bcc_push_string_arrays(buf, cache.lam_captures)
  bcc_push_int_array(buf, cache.lam_meta_i32)
  bcc_push_int_array(buf, cache.lam_meta_i64)
  bcc_push_int_array(buf, cache.slot_owner)
  bcc_push_int_array(buf, cache.slot_values)
  bcc_push_int_array(buf, cache.blind_fn)
  bcc_push_zigzag_int_array(buf, cache.blind_body)
  bcc_push_int_array(buf, cache.blind_offsets)
  bcc_push_int_array(buf, cache.blind_kinds)
  bcc_push_int_array(buf, cache.blind_syms)
  bcc_push_int_array(buf, cache.lm_owner)
  bcc_push_int_array(buf, cache.lm_offsets)
  bcc_push_int_array(buf, cache.lm_file_ids)
  bcc_push_int_array(buf, cache.lm_lines)
  bcc_push_int_array(buf, cache.guard_meta)
  bcc_push_string_array(buf, cache.guard_synth_names)
  bcc_push_int_array(buf, cache.guard_synth_stmts)
  bcc_push_string_array(buf, cache.guard_import_names)
  bcc_push_string_array(buf, cache.guard_borrow_names)
  bcc_push_int_array(buf, cache.guard_borrow_masks)
  bcc_push_string_array(buf, cache.guard_unmangled_names)
  bcc_push_int_array(buf, cache.guard_layout)
  bcc_push_int_array(buf, cache.guard_typed_lowering)
  buf
}

/// Encode the cache with the same VBC6 wire format as the compatibility function.
export fn CodegenBodyCache::codegen_body_cache_to_bytes(cache: CodegenBodyCache) -> Bytes with Exception {
  codegen_body_cache_to_bytes(cache)
}

// Reader state: (value, next_pos), pos = -1 on malformed input. Every reader
// checks bounds before consuming; a bad stream degrades to None at the top.
fn bcc_read_int(b: Bytes, pos: Int) -> (Int, Int) {
  let n = Bytes::length(b)
  let mut p = pos
  let mut shift = 0
  let mut acc = 0
  let mut done = false
  let mut bad = false
  while !done && !bad {
    if p >= n || shift > 34 {
      bad = true
    } else {
      let byte = Bytes::get(b, p)
      p = p + 1
      acc = acc|((byte&127)<<shift)
      shift = shift + 7
      if (byte&128) == 0 {
        done = true
      } else {
        ()
      }
    }
  }
  if bad {
    (0, 0 - 1)
  } else {
    (acc - 1, p)
  }
}

fn bcc_read_int_array(b: Bytes, pos: Int, out: Array[Int]) -> Int {
  let (count, p0) = bcc_read_int(b, pos)
  if p0 < 0 || count < 0 {
    0 - 1
  } else {
    let mut p = p0
    let mut i = 0
    while p >= 0 && i < count {
      let (v, np) = bcc_read_int(b, p)
      if np < 0 {
        p = 0 - 1
      } else {
        Array::push(out, v)
        p = np
      }
      i = i + 1
    }
    p
  }
}

/// The inverse of bcc_push_zigzag_int_array.
fn bcc_read_zigzag_int_array(b: Bytes, pos: Int, out: Array[Int]) -> Int {
  let (count, p0) = bcc_read_int(b, pos)
  if p0 < 0 || count < 0 {
    0 - 1
  } else {
    let mut p = p0
    let mut i = 0
    while p >= 0 && i < count {
      let (z, np) = bcc_read_int(b, p)
      if np < 0 || z < 0 {
        p = 0 - 1
      } else {
        let v = if z % 2 == 0 {
          z / 2
        } else {
          0 - ((z + 1) / 2)
        }
        Array::push(out, v)
        p = np
      }
      i = i + 1
    }
    p
  }
}

fn bcc_read_bytes(b: Bytes, pos: Int) -> (Bytes, Int) {
  let (len, p0) = bcc_read_int(b, pos)
  if p0 < 0 || len < 0 || p0 + len > Bytes::length(b) {
    (Bytes::new(), 0 - 1)
  } else {
    (Bytes::slice(b, p0, p0 + len), p0 + len)
  }
}

fn bcc_read_bytes_array(b: Bytes, pos: Int, out: Array[Bytes]) -> Int {
  let (count, p0) = bcc_read_int(b, pos)
  if p0 < 0 || count < 0 {
    0 - 1
  } else {
    let mut p = p0
    let mut i = 0
    while p >= 0 && i < count {
      let (v, np) = bcc_read_bytes(b, p)
      if np < 0 {
        p = 0 - 1
      } else {
        Array::push(out, v)
        p = np
      }
      i = i + 1
    }
    p
  }
}

fn bcc_read_string(b: Bytes, pos: Int) -> (String, Int) {
  let (len, p0) = bcc_read_int(b, pos)
  if p0 < 0 || len < 0 || p0 + len > Bytes::length(b) {
    ("", 0 - 1)
  } else {
    let parts = array_empty()
    let mut i = 0
    while i < len {
      Array::push(parts, String::from_byte(Bytes::get(b, p0 + i)))
      i = i + 1
    }
    (String::join(parts, ""), p0 + len)
  }
}

fn bcc_read_string_array(b: Bytes, pos: Int, out: Array[String]) -> Int {
  let (count, p0) = bcc_read_int(b, pos)
  if p0 < 0 || count < 0 {
    0 - 1
  } else {
    let mut p = p0
    let mut i = 0
    while p >= 0 && i < count {
      let (s, np) = bcc_read_string(b, p)
      if np < 0 {
        p = 0 - 1
      } else {
        Array::push(out, s)
        p = np
      }
      i = i + 1
    }
    p
  }
}

fn bcc_read_string_arrays(b: Bytes, pos: Int, out: Array[Array[String]]) -> Int {
  let (count, p0) = bcc_read_int(b, pos)
  if p0 < 0 || count < 0 {
    0 - 1
  } else {
    let mut p = p0
    let mut i = 0
    while p >= 0 && i < count {
      let (ilen, np0) = bcc_read_int(b, p)
      if np0 < 0 || ilen < 0 {
        p = 0 - 1
      } else {
        let inner = array_empty()
        let mut p2 = np0
        let mut j = 0
        while p2 >= 0 && j < ilen {
          let (s, np) = bcc_read_string(b, p2)
          if np < 0 {
            p2 = 0 - 1
          } else {
            Array::push(inner, s)
            p2 = np
          }
          j = j + 1
        }
        if p2 < 0 {
          p = 0 - 1
        } else {
          Array::push(out, inner)
          p = p2
        }
      }
      i = i + 1
    }
    p
  }
}

export fn codegen_body_cache_from_bytes(b: Bytes) -> Option[CodegenBodyCache] {
  if Bytes::length(b) < 4 || Bytes::get(b, 0) != 'V' || Bytes::get(b, 1) != 'B' || Bytes::get(b, 2) != 'C' || Bytes::get(b, 3) != '6' {
    None
  } else {
    let out = codegen_body_cache_new()
    let mut p = 4
    p = bcc_read_int_array(b, p, out.fn_indices)
    if p >= 0 {
      p = bcc_read_string_array(b, p, out.fn_names)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.fn_files)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.fn_src_stmts)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_bytes_array(b, p, out.fn_bodies)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.fn_meta_i32)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.fn_meta_i64)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.fn_meta_v128)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.lam_owner)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.lam_indices)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_bytes_array(b, p, out.lam_bodies)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.lam_param_counts)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_string_arrays(b, p, out.lam_captures)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.lam_meta_i32)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.lam_meta_i64)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.slot_owner)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.slot_values)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.blind_fn)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_zigzag_int_array(b, p, out.blind_body)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.blind_offsets)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.blind_kinds)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.blind_syms)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.lm_owner)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.lm_offsets)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.lm_file_ids)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.lm_lines)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.guard_meta)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_string_array(b, p, out.guard_synth_names)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.guard_synth_stmts)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_string_array(b, p, out.guard_import_names)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_string_array(b, p, out.guard_borrow_names)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.guard_borrow_masks)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_string_array(b, p, out.guard_unmangled_names)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.guard_layout)
    } else {
      ()
    }
    if p >= 0 {
      p = bcc_read_int_array(b, p, out.guard_typed_lowering)
    } else {
      ()
    }
    let fn_n = Array::length(out.fn_indices)
    let lam_n = Array::length(out.lam_owner)
    let guard_n = Array::length(out.guard_meta)
    // A function index is a position in the program's function list, so a
    // NEGATIVE one is not a function and the entry holding it is not a body
    // this compile could replay. Refusing the whole cache is the established
    // rule for this artifact (#2388: a stale entry may cause a miss, never a
    // wrong body), and it is also what keeps `codegen_body_cache_slot_index`
    // exactly equivalent to the scan it replaces -- a direct-address table
    // has no slot for a negative key, so a cache that carried one would make
    // the two lookups disagree.
    let mut fni = 0
    let mut fn_index_negative = false
    while fni < fn_n {
      if Array::get(out.fn_indices, fni) < 0 {
        fn_index_negative = true
      } else {
        ()
      }
      fni = fni + 1
    }
    if p < 0 || fn_index_negative || Array::length(out.fn_names) != fn_n || Array::length(out.fn_files) != fn_n || Array::length(out.fn_src_stmts) != fn_n || Array::length(out.fn_bodies) != fn_n || Array::length(out.fn_meta_i32) != fn_n || Array::length(out.fn_meta_i64) != fn_n || Array::length(out.fn_meta_v128) != fn_n || Array::length(out.lam_indices) != lam_n || Array::length(out.lam_bodies) != lam_n || Array::length(out.lam_param_counts) != lam_n || Array::length(out.lam_captures) != lam_n || Array::length(out.lam_meta_i32) != lam_n || Array::length(out.lam_meta_i64) != lam_n || Array::length(out.slot_owner) != Array::length(out.slot_values) || Array::length(out.blind_body) != Array::length(out.blind_fn) || Array::length(out.blind_offsets) != Array::length(out.blind_fn) || Array::length(out.blind_kinds) != Array::length(out.blind_fn) || Array::length(out.blind_syms) != Array::length(out.blind_fn) || Array::length(out.lm_offsets) != Array::length(out.lm_owner) || Array::length(out.lm_file_ids) != Array::length(out.lm_owner) || Array::length(out.lm_lines) != Array::length(out.lm_owner) || (guard_n != 0 && guard_n != 5) || Array::length(out.guard_synth_names) != Array::length(out.guard_synth_stmts) || Array::length(out.guard_borrow_names) != Array::length(out.guard_borrow_masks) || Array::length(out.guard_layout) % 2 != 0 || Array::length(out.guard_typed_lowering) % 2 != 0 {
      None
    } else {
      Some(out)
    }
  }
}

// Preserve compiler/core/polyfill.vibe's existing diagnostic formatting.
fn bcc_int_to_string(n: Int) -> String {
  if n == 0 {
    "0"
  } else {
    let mut val = n
    let mut neg = false
    if val < 0 {
      neg = true
      val = 0 - val
    }
    let digits = array_empty()
    while val > 0 {
      let d = val - (val / 10) * 10
      let ch = if d == 0 {
        "0"
      }
      else if d == 1 {
        "1"
      }
      else if d == 2 {
        "2"
      }
      else if d == 3 {
        "3"
      }
      else if d == 4 {
        "4"
      }
      else if d == 5 {
        "5"
      }
      else if d == 6 {
        "6"
      }
      else if d == 7 {
        "7"
      }
      else if d == 8 {
        "8"
      }
      else {
        "9"
      }
      Array::push(digits, ch)
      val = val / 10
    }
    let mut result = if neg {
      "-"
    } else {
      ""
    }
    let mut i = Array::length(digits) - 1
    while i >= 0 {
      result = String::concat(result, Array::get(digits, i))
      i = i - 1
    }
    result
  }
}
