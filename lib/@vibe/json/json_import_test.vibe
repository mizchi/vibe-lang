//# Imports

// #897 (ADR-0070 Phase 3): this file was named test_json_import.vibe — a
// plain `.vibe` sibling containing only `test {}` blocks, which implicit
// .vpkg membership would merge (and, on a no-entry `vibe test` run, EXECUTE)
// into every consumer of @vibe/json — renamed to *_test.vibe so it is
// excluded like any other test file (same fix as @vibe/io's
// example_io_test.vibe, PR #915). Import retargeted to the package
// directory (the canonical post-#897 form; `Json` is `opaque type` in
// index.vpkg, its definition re-exported from json_types.vibe).

import ../prelude/index.vibe {
  Result
}

import .{
  Json, parse, stringify
}

//# Misc

fn parse_ok(s: String) -> Bool {
  match parse(s) {
    Result::Ok(_) => true,
    Result::Err(_) => false
  }
}

fn parse_err(s: String) -> Bool {
  match parse(s) {
    Result::Ok(_) => false,
    Result::Err(_) => true
  }
}

test "parse_null" {
  match parse("null") {
    Result::Ok((j, _)) => match j {
      JNull => assert(true),
      _ => assert(false)
    },
    Result::Err(_) => assert(false)
  }
}

test "parse_array" {
  match parse("[1,2,3]") {
    Result::Ok((j, _)) => match j {
      JArr(_) => assert(true),
      _ => assert(false)
    },
    Result::Err(_) => assert(false)
  }
}

test "parse_object_multi" {
  match parse("{\"a\":1,\"b\":2}") {
    Result::Ok((j, _)) => match j {
      JObj(_) => assert(true),
      _ => assert(false)
    },
    Result::Err(_) => assert(false)
  }
}

test "parse_complex" {
  match parse("{\"name\":\"vibe\",\"nums\":[1.5,2,3.25],\"ok\":true,\"meta\":null}") {
    Result::Ok((j, _)) => match j {
      JObj(_) => assert(true),
      _ => assert(false)
    },
    Result::Err(_) => assert(false)
  }
}

test "roundtrip_array" {
  match parse("[1,2,3]") {
    Result::Ok((parsed, _)) => assert(stringify(parsed) == "[1,2,3]"),
    Result::Err(_) => assert(false)
  }
}

test "parse_ok_test" {
  assert(parse_ok("null"))
  assert(parse_ok("42"))
  assert(parse_ok("\"hello\""))
  assert(parse_ok("[1,2]"))
  assert(parse_ok("{\"a\":1}"))
}

test "parse_err_test" {
  assert(parse_err("true false"))
  assert(parse_err(""))
}
