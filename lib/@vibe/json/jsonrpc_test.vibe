//# Imports

import ../prelude {
  Result
}

// #897: retargeted from direct impl-file imports (./json.vibe /
// ./jsonrpc.vibe) to the package directory — the transparent
// Json/RpcId/RpcMessage definitions now live in index.vpkg's facade, which
// a direct impl-file import would not include.
import .{
  Json, RpcId, RpcMessage, parse_message, stringify_error, stringify_notification, stringify_request, stringify_response
}

//# Misc

test "parse_request" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":[1,2],\"id\":1}") {
    Result::Ok(Request(method, _, id)) => {
      assert(method == "add")
      match id {
        IdNum(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "parse_request_string_id" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"method\":\"foo\",\"params\":null,\"id\":\"abc\"}") {
    Result::Ok(Request(method, _, id)) => {
      assert(method == "foo")
      match id {
        IdStr(s) => assert(s == "abc"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "parse_request_null_id" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"method\":\"foo\",\"params\":null,\"id\":null}") {
    Result::Ok(Request(_, _, id)) => match id {
      IdNull => assert(true),
      _ => assert(false)
    },
    _ => assert(false)
  }
}

test "parse_notification" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"method\":\"update\",\"params\":[1]}") {
    Result::Ok(Notification(method, _)) => assert(method == "update"),
    _ => assert(false)
  }
}

test "parse_notification_no_params" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"method\":\"ping\"}") {
    Result::Ok(Notification(method, params)) => {
      assert(method == "ping")
      match params {
        JNull => assert(true),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "parse_success_response" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"result\":42,\"id\":1}") {
    Result::Ok(SuccessResponse(id, result)) => {
      match id {
        IdNum(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
      match result {
        JNum(n) => assert(eq(n, 42.0)),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "parse_error_response" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32601,\"message\":\"Method not found\"},\"id\":1}") {
    Result::Ok(ErrorResponse(id, code, message, _)) => {
      match id {
        IdNum(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
      assert(eq(code, -32601))
      assert(message == "Method not found")
    },
    _ => assert(false)
  }
}

test "parse_error_response_with_data" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32600,\"message\":\"Invalid\",\"data\":\"detail\"},\"id\":\"x\"}") {
    Result::Ok(ErrorResponse(id, code, _, data)) => {
      match id {
        IdStr(s) => assert(s == "x"),
        _ => assert(false)
      }
      assert(eq(code, -32600))
      match data {
        JStr(s) => assert(s == "detail"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "parse_invalid_jsonrpc_version" {
  match parse_message("{\"jsonrpc\":\"1.0\",\"method\":\"foo\"}") {
    Result::Err(_) => assert(true),
    _ => assert(false)
  }
}

test "parse_invalid_not_object" {
  match parse_message("[1,2,3]") {
    Result::Err(_) => assert(true),
    _ => assert(false)
  }
}

test "parse_missing_jsonrpc" {
  match parse_message("{\"method\":\"foo\"}") {
    Result::Err(_) => assert(true),
    _ => assert(false)
  }
}

test "stringify_request_roundtrip" {
  let s = stringify_request("add", JArr([
    JNum(1.0),
    JNum(2.0)
  ]), IdNum(1))
  match parse_message(s) {
    Result::Ok(Request(method, _, id)) => {
      assert(method == "add")
      match id {
        IdNum(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "stringify_notification_roundtrip" {
  let s = stringify_notification("ping", JNull)
  match parse_message(s) {
    Result::Ok(Notification(method, _)) => assert(method == "ping"),
    _ => assert(false)
  }
}

test "stringify_response_roundtrip" {
  let s = stringify_response(IdNum(42), JStr("ok"))
  match parse_message(s) {
    Result::Ok(SuccessResponse(id, result)) => {
      match id {
        IdNum(n) => assert(eq(n, 42)),
        _ => assert(false)
      }
      match result {
        JStr(v) => assert(v == "ok"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "stringify_error_roundtrip" {
  let s = stringify_error(IdNum(1), -32601, "Method not found", JNull)
  match parse_message(s) {
    Result::Ok(ErrorResponse(id, code, message, _)) => {
      match id {
        IdNum(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
      assert(eq(code, -32601))
      assert(message == "Method not found")
    },
    _ => assert(false)
  }
}
