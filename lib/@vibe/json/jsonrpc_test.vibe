//# Imports

// #897: retargeted from direct impl-file imports (./json.vibe /
// ./jsonrpc.vibe) to the package directory — the transparent
// Json/RpcId/RpcMessage definitions now live in index.vpkg's facade, which
// a direct impl-file import would not include.
import .{
  Json,
  RpcId,
  RpcMessage,
  RpcMessage::parse,
  RpcMessage::stringify_error,
  RpcMessage::stringify_notification,
  RpcMessage::stringify_request,
  RpcMessage::stringify_response,
  parse_message,
  stringify_error,
  stringify_notification,
  stringify_request,
  stringify_response
}

//# Helpers

/// #1324 slice 3: `parse_message` throws its `String` instead of returning
/// `Result[RpcMessage, String]`. Tests that merely need a message to PARSE
/// dropped their `_ => assert(false)` fallback -- an escaping throw fails
/// the test by itself (test blocks carry an ambient `Error`) -- so only the
/// tests asserting a REJECTION need to catch.
fn parse_message_throws(s: String) -> Bool {
  handle {
    let _ = parse_message(s)
    false
  } with Exception {
    Throw(_) => true
  }
}

//# Misc

test "parse_request" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":[1,2],\"id\":1}") {
    Request(method, _, id) => {
      assert(method == "add")
      match id {
        IdNum(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "parse_request_string_id" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"method\":\"foo\",\"params\":null,\"id\":\"abc\"}") {
    Request(method, _, id) => {
      assert(method == "foo")
      match id {
        IdStr(s) => assert(s == "abc"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "parse_request_null_id" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"method\":\"foo\",\"params\":null,\"id\":null}") {
    Request(_, _, id) => match id {
      IdNull => assert(true),
      _ => assert(false)
    },
    _ => assert(false)
  }
}

test "parse_notification" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"method\":\"update\",\"params\":[1]}") {
    Notification(method, _) => assert(method == "update"),
    _ => assert(false)
  }
}

test "parse_notification_no_params" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"method\":\"ping\"}") {
    Notification(method, params) => {
      assert(method == "ping")
      match params {
        JNull => assert(true),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "parse_success_response" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"result\":42,\"id\":1}") {
    SuccessResponse(id, result) => {
      match id {
        IdNum(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
      match result {
        JNum(n) => assert(eq(n, 42.0)),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "parse_error_response" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32601,\"message\":\"Method not found\"},\"id\":1}") {
    ErrorResponse(id, code, message, _) => {
      match id {
        IdNum(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
      assert(eq(code, -32601))
      assert(message == "Method not found")
    },
    _ => assert(false)
  }
}

test "parse_error_response_with_data" {
  match parse_message("{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32600,\"message\":\"Invalid\",\"data\":\"detail\"},\"id\":\"x\"}") {
    ErrorResponse(id, code, _, data) => {
      match id {
        IdStr(s) => assert(s == "x"),
        _ => assert(false)
      }
      assert(eq(code, -32600))
      match data {
        JStr(s) => assert(s == "detail"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "parse_invalid_jsonrpc_version" {
  assert(parse_message_throws("{\"jsonrpc\":\"1.0\",\"method\":\"foo\"}"))
}

test "parse_invalid_not_object" {
  assert(parse_message_throws("[1,2,3]"))
}

test "parse_missing_jsonrpc" {
  assert(parse_message_throws("{\"method\":\"foo\"}"))
}

test "stringify_request_roundtrip" {
  let s = stringify_request("add", JArr([
    JNum(1.0),
    JNum(2.0)
  ]), IdNum(1))
  match parse_message(s) {
    Request(method, _, id) => {
      assert(method == "add")
      match id {
        IdNum(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "stringify_notification_roundtrip" {
  let s = stringify_notification("ping", JNull)
  match parse_message(s) {
    Notification(method, _) => assert(method == "ping"),
    _ => assert(false)
  }
}

test "stringify_response_roundtrip" {
  let s = stringify_response(IdNum(42), JStr("ok"))
  match parse_message(s) {
    SuccessResponse(id, result) => {
      match id {
        IdNum(n) => assert(eq(n, 42)),
        _ => assert(false)
      }
      match result {
        JStr(v) => assert(v == "ok"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "stringify_error_roundtrip" {
  let s = stringify_error(IdNum(1), -32601, "Method not found", JNull)
  match parse_message(s) {
    ErrorResponse(id, code, message, _) => {
      match id {
        IdNum(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
      assert(eq(code, -32601))
      assert(message == "Method not found")
    },
    _ => assert(false)
  }
}

// #1189 naming consistency (wave 2): RpcMessage::* companions agree with
// the bare parse_message/stringify_* forms. None of these take an
// RpcMessage value as a parameter (they construct/render one, same shape
// as Json::parse in json_convenience.vibe), so this is a plain
// equivalence check rather than a dot-call parity test.
test "rpc_method_style_parity" {
  let req = "{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":[1,2],\"id\":1}"
  match (RpcMessage::parse(req), parse_message(req)) {
    (Request(m1, _, _), Request(m2, _, _)) => assert(m1 == m2),
    _ => assert(false)
  }
  assert(RpcMessage::stringify_error(IdNum(1), -32601, "Method not found", JNull) == stringify_error(IdNum(1), -32601, "Method not found", JNull))
  assert(RpcMessage::stringify_request("add", JNull, IdNum(1)) == stringify_request("add", JNull, IdNum(1)))
  assert(RpcMessage::stringify_response(IdNum(1), JNull) == stringify_response(IdNum(1), JNull))
  assert(RpcMessage::stringify_notification("ping", JNull) == stringify_notification("ping", JNull))
}
