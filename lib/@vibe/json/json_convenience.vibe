//# Imports

// #777: host-era `Json::xxx(...)` direct-value accessors. The MoonBit host
// exposed `Json` as a builtin type with these methods auto-imported
// alongside the type; the selfhost `@vibe/json` package only ships the
// throwing primitives (`parse`, `Json::get`, `json_as_*`). Library code
// migrated verbatim from the host era (lib/@vibe/shell/{pipeline,from_csv,
// from_yaml}.vibe and their tests) still calls the old direct-value surface,
// so this module reimplements it on top of the real primitives: parse
// failures / type mismatches default to a safe zero value (JNull / 0.0 / ""
// / false / empty array) instead of throwing, matching the old host
// behavior these call sites were written against.
//
// NOTE: the object-field accessor is named `Json::field`, NOT `Json::get` —
// `Json::get` already exists in ./json_types.vibe with a DIFFERENT
// (throwing, and returning `Json` not a defaulted value) signature. Since
// this module transitively depends on
// json_types.vibe (for the `Json` type itself), a same-named-but-different
// `Json::get` here collides under FS-mode's whole-source-tree symbol merge:
// call sites resolve to the wrong implementation and the mismatched runtime
// representation traps downstream (confirmed empirically — do not reuse
// `Json::get` for a different signature anywhere in this tree).

import ./json_types.vibe {
  Json
}

import ./json_parse.vibe {
  parse
}

import ./json_stringify.vibe {
  stringify
}

//# Functions

/// #1324 slice 3: `parse` throws instead of returning `Result`, so the
/// default-to-JNull behavior this module exists to provide is now a `handle`
/// rather than an `Err` arm. The observable contract is unchanged.
export fn Json::parse(s: String) -> Json {
  handle {
    let (j, _) = parse(s)
    j
  } with Exception {
    Throw(_) => JNull
  }
}

export fn Json::stringify(j: Json) -> String {
  stringify(j)
}

export fn Json::field(j: Json, key: String) -> Json {
  match j {
    JObj(m) => if Map::has_key(m, key) {
      let v: Json = Map::get(m, key)
      v
    } else {
      JNull
    },
    _ => JNull
  }
}

/// #1845: absence-aware object accessor. `Json::field` conflates a missing
/// key with an explicit `null` (both come back `JNull`); `get_opt` keeps
/// them distinct — `None` = key absent (or `j` not an object),
/// `Some(JNull)` = key present and bound to JSON null.
export fn Json::get_opt(j: Json, key: String) -> Option[Json] {
  match j {
    JObj(m) => if Map::has_key(m, key) {
      let v: Json = Map::get(m, key)
      Some(v)
    } else {
      None
    },
    _ => None
  }
}

export fn Json::index(j: Json, idx: Int) -> Json {
  match j {
    JArr(a) => if idx >= 0 && idx < Array::length(a) {
      Array::get(a, idx)
    } else {
      JNull
    },
    _ => JNull
  }
}

export fn Json::number(j: Json) -> Double {
  match j {
    JNum(n) => n,
    _ => 0.0
  }
}

export fn Json::string(j: Json) -> String {
  match j {
    JStr(s) => s,
    _ => ""
  }
}

export fn Json::bool(j: Json) -> Bool {
  match j {
    JBool(b) => b,
    _ => false
  }
}

export fn Json::is_null(j: Json) -> Bool {
  match j {
    JNull => true,
    _ => false
  }
}

export fn Json::length(j: Json) -> Int {
  match j {
    JArr(a) => Array::length(a),
    JObj(m) => Array::length(Map::keys(m)),
    _ => 0
  }
}

export fn Json::keys(j: Json) -> Array[String] {
  match j {
    JObj(m) => Map::keys(m),
    _ => []
  }
}

export fn Json::type_of(j: Json) -> String {
  match j {
    JNull => "null",
    JBool(_) => "boolean",
    JNum(_) => "number",
    JStr(_) => "string",
    JArr(_) => "array",
    JObj(_) => "object"
  }
}
