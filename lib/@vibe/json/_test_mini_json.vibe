//# Types

export enum Json {
  JNull;
  JBool(Bool);
  JNum(Float64);
  JStr(String);
  JArr(Array[Json]);
  JObj(Map[String, Json])
}

//# Functions

fn is_ws(_ c: Int) -> Bool {
  c == ' ' || c == '\n' || c == '\t' || c == '\r'
}

fn skip_ws(s: String, len: Int, i: Int) -> Int {
  if i < len {
    let c = String::char_code_at(s, at = i)
    if is_ws(c) {
      skip_ws(s = s, len = len, i = i + 1)
    } else i
  } else i
}

fn is_digit(_ c: Int) -> Bool {
  c >= '0' && c < ':'
}

export fn stringify(_ j: Json) -> String {
  match j {
    JNull => "null",
    JBool(b) => if b {
      "true"
    } else "false",
    JNum(n) => __to_string(n),
    JStr(s) => s,
    JArr(_) => "[]",
    JObj(_) => "{}"
  }
}

fn parse_string(s: String, len: Int, i: Int) -> (String, Int) with Exception[String] {
  if i >= len {
    throw("unexpected eof")
  }
  else if String::char_code_at(s, at = i) != '"' {
    throw("expected string")
  }
  else {
    let rec scan = (idx: Int, start: Int, acc: String) -> (String, Int) with Exception[String] {
      if idx >= len {
        throw("unterminated string")
      }
      else {
        let c = String::char_code_at(s, at = idx)
        if c < ' ' {
          throw("invalid string")
        }
        else if c == '"' {
          let chunk = s[start: idx]
          ("\{acc}\{chunk}", idx + 1)
        }
        else if c == '\\' {
          let chunk = s[start: idx]
          let next = idx + 1
          if next >= len {
            throw("unterminated string")
          }
          else {
            let esc = String::char_code_at(s, at = next)
            let escaped = if esc == '"' {
              "\""
            }
            else if esc == '\\' {
              "\\"
            }
            else if esc == '/' {
              "/"
            }
            else if esc == 'n' {
              "\n"
            }
            else if esc == 't' {
              "\t"
            }
            else if esc == 'r' {
              "r"
            }
            else throw("invalid escape")
            scan(next + 1, next + 1, "\{acc}\{chunk}\{escaped}")
          }
        }
        else scan(idx + 1, start, acc)
      }
    }
    scan(i + 1, i + 1, "")
  }
}

fn apply_exponent(value: Float64, exp: Int) -> Float64 {
  if exp == 0 {
    value
  }
  else if exp < 0 {
    apply_exponent(value = value / 10.0, exp = exp + 1)
  }
  else apply_exponent(value = value * 10.0, exp = exp - 1)
}

fn build_json_map(keys: Array[String], vals: Array[Json]) -> Map[String, Json] {
  {
    let b = MapBuilder::new()
    let len = Array::length(keys)
    let mut i = 0
    while i < len {
      MapBuilder::set(b, key = Array::get(keys, at = i), value = Array::get(vals, at = i))
      i += 1
    }
    MapBuilder::freeze(b)
  }
}

fn make_empty_map() -> Map[String, Json] {
  {
    let b = MapBuilder::new()
    MapBuilder::freeze(b)
  }
}

fn digit_to_double(_ c: Int) -> Float64 {
  Int::to_float64(c - 48)
}

fn parse_fraction(s: String, len: Int, i: Int, acc: Float64, scale: Float64, seen: Bool) -> (Float64, Int) with Exception[String] {
  if i < len {
    let c = String::char_code_at(s, at = i)
    if is_digit(c) {
      parse_fraction(s = s, len = len, i = i + 1, acc = acc + digit_to_double(c) / scale, scale = scale * 10.0, seen = true)
    }
    else if seen {
      (acc, i)
    }
    else throw("expected fraction")
  } else if seen {
    (acc, i)
  }
  else throw("expected fraction")
}

fn empty_json_array() -> Array[Json] {
  Array::slice([JNull], start = 0, end = 0)
}

fn parse_digits_int(s: String, len: Int, i: Int, acc: Int) -> (Int, Int) {
  if i < len {
    let c = String::char_code_at(s, at = i)
    if is_digit(c) {
      parse_digits_int(s = s, len = len, i = i + 1, acc = acc * 10 + (c - 48))
    } else (acc, i)
  } else (acc, i)
}

fn starts_with_from(s: String, len: Int, i: Int, word: String, wi: Int, wlen: Int) -> Bool {
  if wi >= wlen {
    true
  }
  else {
    let si = i + wi
    if si >= len {
      false
    }
    else if String::char_code_at(s, at = si) == String::char_code_at(word, at = wi) {
      starts_with_from(s = s, len = len, i = i, word = word, wi = wi + 1, wlen = wlen)
    } else false
  }
}

fn starts_with(s: String, len: Int, i: Int, word: String) -> Bool {
  let wlen = String::length(word)
  i + wlen <= len && starts_with_from(s = s, len = len, i = i, word = word, wi = 0, wlen = wlen)
}

fn parse_digits_double(s: String, len: Int, i: Int, acc: Float64, seen: Bool) -> (Float64, Int) with Exception[String] {
  if i < len {
    let c = String::char_code_at(s, at = i)
    if is_digit(c) {
      parse_digits_double(s = s, len = len, i = i + 1, acc = acc * 10.0 + digit_to_double(c), seen = true)
    }
    else if seen {
      (acc, i)
    }
    else throw("expected digit")
  } else if seen {
    (acc, i)
  }
  else throw("expected digit")
}

fn parse_int_part(s: String, len: Int, i: Int) -> (Float64, Int) with Exception[String] {
  if i < len {
    let c = String::char_code_at(s, at = i)
    if c == '0' {
      let next = i + 1
      if next < len && is_digit(String::char_code_at(s, at = next)) {
        throw("leading zero")
      }
      else (0.0, next)
    }
    else if is_digit(c) {
      parse_digits_double(s = s, len = len, i = i, acc = 0.0, seen = false)
    }
    else throw("expected digit")
  } else throw("expected digit")
}

fn parse_exponent_if_any(s: String, len: Int, i: Int, value: Float64) -> (Float64, Int) with Exception[String] {
  let parse_exp = (exp_sign: Int, exp_idx: Int) -> (Float64, Int) with Exception[String] {
    if exp_idx < len && is_digit(String::char_code_at(s, at = exp_idx)) {
      let (exp, exp_next) = parse_digits_int(s = s, len = len, i = exp_idx, acc = 0)
      let signed_exp = if exp_sign < 0 {
        0 - exp
      } else exp
      (apply_exponent(value = value, exp = signed_exp), exp_next)
    } else throw("expected exponent")
  }
  if i < len {
    let c = String::char_code_at(s, at = i)
    if c == 'e' || c == 'E' {
      let exp_start = i + 1
      if exp_start < len {
        let sign_char = String::char_code_at(s, at = exp_start)
        if sign_char == '-' {
          parse_exp(-1, exp_start + 1)
        }
        else if sign_char == '+' {
          parse_exp(1, exp_start + 1)
        }
        else parse_exp(1, exp_start)
      } else throw("expected exponent")
    } else (value, i)
  } else (value, i)
}

fn parse_fraction_if_any(s: String, len: Int, i: Int, value: Float64) -> (Float64, Int) with Exception[String] {
  if i < len && String::char_code_at(s, at = i) == '.' {
    let (frac, next) = parse_fraction(s = s, len = len, i = i + 1, acc = 0.0, scale = 10.0, seen = false)
    (value + frac, next)
  } else (value, i)
}

fn parse_number_body(s: String, len: Int, idx: Int, sign: Float64) -> (Json, Int) with Exception[String] {
  let (int_part, next) = parse_int_part(s = s, len = len, i = idx)
  let (with_frac, next_frac) = parse_fraction_if_any(s = s, len = len, i = next, value = int_part)
  let (with_exp, next_exp) = parse_exponent_if_any(s = s, len = len, i = next_frac, value = with_frac)
  (JNum(with_exp * sign), next_exp)
}

fn parse_number(s: String, len: Int, i: Int) -> (Json, Int) with Exception[String] {
  if i >= len {
    throw("expected number")
  }
  else if String::char_code_at(s, at = i) == '-' {
    parse_number_body(s = s, len = len, idx = i + 1, sign = -1.0)
  }
  else parse_number_body(s = s, len = len, idx = i, sign = 1.0)
}

fn parse_value(s: String, len: Int, i: Int) -> (Json, Int) with Exception[String] {
  let idx = skip_ws(s = s, len = len, i = i)
  if idx >= len {
    throw("unexpected eof")
  }
  else {
    let c = String::char_code_at(s, at = idx)
    if c == 'n' {
      if starts_with(s = s, len = len, i = idx, word = "null") {
        (JNull, idx + 4)
      }
      else throw("expected null")
    }
    else if c == 't' {
      if starts_with(s = s, len = len, i = idx, word = "true") {
        (JBool(true), idx + 4)
      }
      else throw("expected true")
    }
    else if c == 'f' {
      if starts_with(s = s, len = len, i = idx, word = "false") {
        (JBool(false), idx + 5)
      }
      else throw("expected false")
    }
    else if c == '"' {
      let (value, next) = parse_string(s = s, len = len, i = idx)
      (JStr(value), next)
    }
    else if c == '[' {
      {
        let arr_start = skip_ws(s = s, len = len, i = idx + 1)
        if arr_start >= len {
          throw("unexpected eof")
        }
        else if String::char_code_at(s, at = arr_start) == ']' {
          (JArr(empty_json_array()), arr_start + 1)
        } else {
          let b = ArrayBuilder::new()
          let (first_val, first_next) = parse_value(s = s, len = len, i = arr_start)
          ArrayBuilder::push(b, value = first_val)
          let mut cur = skip_ws(s = s, len = len, i = first_next)
          while cur < len && String::char_code_at(s, at = cur) == ',' {
            let (v, nx) = parse_value(s = s, len = len, i = cur + 1)
            ArrayBuilder::push(b, value = v)
            cur = skip_ws(s = s, len = len, i = nx)
          }
          if cur < len && String::char_code_at(s, at = cur) == ']' {
            (JArr(ArrayBuilder::freeze(b)), cur + 1)
          } else throw("expected , or ]")
        }
      }
    }
    else if c == '{' {
      {
        let obj_start = skip_ws(s = s, len = len, i = idx + 1)
        if obj_start >= len {
          throw("unexpected eof")
        }
        else if String::char_code_at(s, at = obj_start) == '}' {
          (JObj(make_empty_map()), obj_start + 1)
        } else {
          let kb = ArrayBuilder::new()
          let vb = ArrayBuilder::new()
          let (first_key, kn) = parse_string(s = s, len = len, i = obj_start)
          let colon1 = skip_ws(s = s, len = len, i = kn)
          if colon1 >= len || String::char_code_at(s, at = colon1) != ':' {
            throw("expected :")
          }
          else {
            let (first_val, vn) = parse_value(s = s, len = len, i = colon1 + 1)
            ArrayBuilder::push(kb, value = first_key)
            ArrayBuilder::push(vb, value = first_val)
            let mut cur = skip_ws(s = s, len = len, i = vn)
            while cur < len && String::char_code_at(s, at = cur) == ',' {
              let (k, kn2) = parse_string(s = s, len = len, i = skip_ws(s = s, len = len, i = cur + 1))
              let colon2 = skip_ws(s = s, len = len, i = kn2)
              if colon2 >= len || String::char_code_at(s, at = colon2) != ':' {
                throw("expected :")
              }
              else {
                let (v, vn2) = parse_value(s = s, len = len, i = colon2 + 1)
                ArrayBuilder::push(kb, value = k)
                ArrayBuilder::push(vb, value = v)
                cur = skip_ws(s = s, len = len, i = vn2)
              }
            }
            if cur < len && String::char_code_at(s, at = cur) == '}' {
              let keys = ArrayBuilder::freeze(kb)
              let vals = ArrayBuilder::freeze(vb)
              (JObj(build_json_map(keys = keys, vals = vals)), cur + 1)
            } else throw("expected , or }")
          }
        }
      }
    }
    else if c == '-' || is_digit(c) {
      parse_number(s = s, len = len, i = idx)
    }
    else throw("unexpected token")
  }
}

export fn parse(_ s: String) -> (Json, Int) with Exception[String] {
  parse_value(s = s, len = String::length(s), i = 0)
}
