import ./json_types.vibe {
  Json
}

fn is_ws(c: Int) -> Bool {
  c == ' ' || c == '\n' || c == '\t' || c == '\r'
}

fn skip_ws(s: String, len: Int, i: Int) -> Int {
  if i < len {
    let c = String::char_code_at(s, i)
    if is_ws(c) {
      skip_ws(s, len, i + 1)
    } else i
  } else i
}

fn is_digit(c: Int) -> Bool {
  c >= '0' && c < ':'
}

fn parse_string(s: String, len: Int, i: Int) -> (String, Int) with Exception[String] {
  if i >= len {
    throw("unexpected eof")
  } else if String::char_code_at(s, i) != '"' {
    throw("expected string")
  } else {
    let rec scan = (idx: Int, start: Int, acc: String) -> (String, Int) with Exception[String] {
      if idx >= len {
        throw("unterminated string")
      } else {
        let c = String::char_code_at(s, idx)
        if c < ' ' {
          throw("invalid string")
        } else if c == '"' {
          let chunk = s[start: idx]
          ("\{acc}\{chunk}", idx + 1)
        } else if c == '\\' {
          let chunk = s[start: idx]
          let next = idx + 1
          if next >= len {
            throw("unterminated string")
          } else {
            let esc = String::char_code_at(s, next)
            let escaped = if esc == '"' {
              "\""
            } else if esc == '\\' {
              "\\"
            } else if esc == '/' {
              "/"
            } else if esc == 'n' {
              "\n"
            } else if esc == 't' {
              "\t"
            } else if esc == 'r' {
              String::from_char_code(13)
            } else throw("invalid escape")
            scan(next + 1, next + 1, "\{acc}\{chunk}\{escaped}")
          }
        } else scan(idx + 1, start, acc)
      }
    }
    scan(i + 1, i + 1, "")
  }
}

fn build_json_map(keys: Array[String], vals: Array[Json]) -> Map[String, Json] {
  let b = MapBuilder::new()
  let len = Array::length(keys)
  let mut i = 0
  while i < len {
    MapBuilder::set(b, Array::get(keys, i), Array::get(vals, i))
    i = i + 1
  }
  MapBuilder::freeze(b)
}

fn make_empty_map() -> Map[String, Json] {
  let b = MapBuilder::new()
  MapBuilder::freeze(b)
}

fn empty_json_array() -> Array[Json] {
  Array::slice([JNull], 0, 0)
}

fn starts_with_from(s: String, len: Int, i: Int, word: String, wi: Int, wlen: Int) -> Bool {
  if wi >= wlen {
    true
  } else {
    let si = i + wi
    if si >= len {
      false
    } else if String::char_code_at(s, si) == String::char_code_at(word, wi) {
      starts_with_from(s, len, i, word, wi + 1, wlen)
    } else false
  }
}

fn starts_with(s: String, len: Int, i: Int, word: String) -> Bool {
  let wlen = String::length(word)
  i + wlen <= len && starts_with_from(s, len, i, word, 0, wlen)
}

fn scan_digits(s: String, len: Int, i: Int, seen: Bool) -> Int with Exception[String] {
  if i < len {
    let c = String::char_code_at(s, i)
    if is_digit(c) {
      scan_digits(s, len, i + 1, true)
    } else if seen {
      i
    } else throw("expected digit")
  } else if seen {
    i
  } else throw("expected digit")
}

fn scan_number_end(s: String, len: Int, i: Int) -> Int with Exception[String] {
  if i >= len {
    throw("expected number")
  }
  let mut cur = i
  if String::char_code_at(s, cur) == '-' {
    cur = cur + 1
    if cur >= len {
      throw("expected digit")
    }
  }
  let first = String::char_code_at(s, cur)
  if first == '0' {
    cur = cur + 1
    if cur < len && is_digit(String::char_code_at(s, cur)) {
      throw("leading zero")
    }
  } else if is_digit(first) {
    cur = scan_digits(s, len, cur, false)
  } else {
    throw("expected digit")
  }
  if cur < len && String::char_code_at(s, cur) == '.' {
    cur = scan_digits(s, len, cur + 1, false)
  }
  if cur < len {
    let exp_char = String::char_code_at(s, cur)
    if exp_char == 'e' || exp_char == 'E' {
      let exp_start = cur + 1
      if exp_start >= len {
        throw("expected exponent")
      }
      let digit_start = if String::char_code_at(s, exp_start) == '+' || String::char_code_at(s, exp_start) == '-' {
        exp_start + 1
      } else {
        exp_start
      }
      if digit_start >= len {
        throw("expected exponent")
      }
      cur = scan_digits(s, len, digit_start, false)
    }
  }
  cur
}

fn parse_number(s: String, len: Int, i: Int) -> (Json, Int) with Exception[String] {
  let end = scan_number_end(s, len, i)
  let mut cur = i
  let mut neg = false
  if String::char_code_at(s, cur) == '-' {
    neg = true
    cur = cur + 1
  }
  let mut int_part = 0.0
  while cur < end && is_digit(String::char_code_at(s, cur)) {
    let digit = String::char_code_at(s, cur) - 48
    int_part = int_part * 10.0 + Int::to_double(digit)
    cur = cur + 1
  }
  let mut frac_part = 0.0
  let mut frac_div = 1.0
  if cur < end && String::char_code_at(s, cur) == '.' {
    cur = cur + 1
    while cur < end && is_digit(String::char_code_at(s, cur)) {
      let digit = String::char_code_at(s, cur) - 48
      frac_part = frac_part * 10.0 + Int::to_double(digit)
      frac_div = frac_div * 10.0
      cur = cur + 1
    }
  }
  let mut exp_value = 0
  let mut exp_neg = false
  if cur < end {
    let exp_char = String::char_code_at(s, cur)
    if exp_char == 'e' || exp_char == 'E' {
      cur = cur + 1
      if cur < end {
        let sign_char = String::char_code_at(s, cur)
        if sign_char == '+' || sign_char == '-' {
          exp_neg = sign_char == '-'
          cur = cur + 1
        }
      }
      while cur < end && is_digit(String::char_code_at(s, cur)) {
        let digit = String::char_code_at(s, cur) - 48
        exp_value = exp_value * 10 + digit
        cur = cur + 1
      }
    }
  }
  let mut value = int_part + frac_part / frac_div
  if exp_value > 0 {
    let mut scale = 1.0
    let mut ei = 0
    while ei < exp_value {
      scale = scale * 10.0
      ei = ei + 1
    }
    if exp_neg {
      value = value / scale
    } else {
      value = value * scale
    }
  }
  if neg {
    value = 0.0 - value
  }
  (JNum(value), end)
}

fn parse_value(s: String, len: Int, i: Int) -> (Json, Int) with Exception[String] {
  let idx = skip_ws(s, len, i)
  if idx >= len {
    throw("unexpected eof")
  } else {
    let c = String::char_code_at(s, idx)
    if c == 'n' {
      if starts_with(s, len, idx, "null") {
        (JNull, idx + 4)
      } else throw("expected null")
    } else if c == 't' {
      if starts_with(s, len, idx, "true") {
        (JBool(true), idx + 4)
      } else throw("expected true")
    } else if c == 'f' {
      if starts_with(s, len, idx, "false") {
        (JBool(false), idx + 5)
      } else throw("expected false")
    } else if c == '"' {
      let (value, next) = parse_string(s, len, idx)
      (JStr(value), next)
    } else if c == '[' {
      let arr_start = skip_ws(s, len, idx + 1)
      if arr_start >= len {
        throw("unexpected eof")
      } else if String::char_code_at(s, arr_start) == ']' {
        (JArr(empty_json_array()), arr_start + 1)
      } else {
        let b = ArrayBuilder::new()
        let (first_val, first_next) = parse_value(s, len, arr_start)
        ArrayBuilder::push(b, first_val)
        let mut cur = skip_ws(s, len, first_next)
        while cur < len && String::char_code_at(s, cur) == ',' {
          let (v, nx) = parse_value(s, len, cur + 1)
          ArrayBuilder::push(b, v)
          cur = skip_ws(s, len, nx)
        }
        if cur < len && String::char_code_at(s, cur) == ']' {
          (JArr(ArrayBuilder::freeze(b)), cur + 1)
        } else throw("expected , or ]")
      }
    } else if c == '{' {
      let obj_start = skip_ws(s, len, idx + 1)
      if obj_start >= len {
        throw("unexpected eof")
      } else if String::char_code_at(s, obj_start) == '}' {
        (JObj(make_empty_map()), obj_start + 1)
      } else {
        let kb = ArrayBuilder::new()
        let vb = ArrayBuilder::new()
        let (first_key, kn) = parse_string(s, len, obj_start)
        let colon1 = skip_ws(s, len, kn)
        if colon1 >= len || String::char_code_at(s, colon1) != ':' {
          throw("expected :")
        } else {
          let (first_val, vn) = parse_value(s, len, colon1 + 1)
          ArrayBuilder::push(kb, first_key)
          ArrayBuilder::push(vb, first_val)
          let mut cur = skip_ws(s, len, vn)
          while cur < len && String::char_code_at(s, cur) == ',' {
            let ws_after_comma = skip_ws(s, len, cur + 1)
            let (k, kn2) = parse_string(s, len, ws_after_comma)
            let colon2 = skip_ws(s, len, kn2)
            if colon2 >= len || String::char_code_at(s, colon2) != ':' {
              throw("expected :")
            }
            let (v, vn2) = parse_value(s, len, colon2 + 1)
            ArrayBuilder::push(kb, k)
            ArrayBuilder::push(vb, v)
            cur = skip_ws(s, len, vn2)
          }
          if cur < len && String::char_code_at(s, cur) == '}' {
            let keys = ArrayBuilder::freeze(kb)
            let vals = ArrayBuilder::freeze(vb)
            (JObj(build_json_map(keys, vals)), cur + 1)
          } else throw("expected , or }")
        }
      }
    } else if c == '-' || is_digit(c) {
      parse_number(s, len, idx)
    } else throw("unexpected token")
  }
}

/// #1324 slice 3: this used to be a `Result[(Json, Int), String]` wrapper
/// around a private `parse_throw`. The wrapper is gone -- the parser already
/// threw internally, so the `Result` was a re-wrap of a throw the caller
/// then usually re-threw. A caller that wants to branch writes
/// `handle { parse(s) } with Exception { Throw(msg) => .. }`.
export fn parse(s: String) -> (Json, Int) with Exception[String] {
  let len = String::length(s)
  let (value, next) = parse_value(s, len, 0)
  let end = skip_ws(s, len, next)
  if end == len {
    (value, end)
  } else throw("trailing input")
}
