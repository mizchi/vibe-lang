import ./json_types.vibe {
  Json
}

/// Iterative on purpose (StringBuilder + while, not a local `let rec`): a
/// local `let rec` closure self-calls through the function table
/// (call_indirect), which the self-tail-call pass (rewrite_self_tail_calls)
/// does NOT turn into a loop -- it only covers TOP-LEVEL self-recursion. One
/// frame per scanned character overflowed the real wasm call stack on long
/// strings (see lib/@vibe/builtin/string.vibe's string_index_of_from comment
/// for the same bug class; filed/fixed here as #1188's escape_string half).
fn escape_string(s: String) -> String {
  let len = String::length(s)
  let b = StringBuilder::new()
  StringBuilder::push(b, "\"")
  let mut i = 0
  while i < len {
    let c = String::char_code_at(s, i)
    if c == '"' {
      StringBuilder::push(b, "\\\"")
    } else if c == '\\' {
      StringBuilder::push(b, "\\\\")
    } else if c == '\n' {
      StringBuilder::push(b, "\\n")
    } else if c == '\t' {
      StringBuilder::push(b, "\\t")
    } else if c == '\r' {
      StringBuilder::push(b, "\\r")
    } else {
      StringBuilder::push(b, String::from_char_code(c))
    }
    i = i + 1
  }
  StringBuilder::push(b, "\"")
  StringBuilder::freeze(b)
}

/// #742/#744: the selfhost linear backend has no Double→String path —
/// `__to_string` on a Double stringifies the raw f64 bit pattern as an integer
/// (42.0 became "4631107791820423168"). Format in library code: integer part exactly, then
/// 15 significant fractional digits with trailing zeros trimmed (round-trips
/// human-scale JSON values like 3.14 / 0.0125).
fn pad_to_15(s: String) -> String {
  let rec go = (acc: String) -> String {
    if String::length(acc) < 15 {
      go(String::concat("0", acc))
    } else acc
  }
  go(s)
}

fn format_number(n: Double) -> String {
  let neg = n < 0.0
  let a = if neg {
    0.0 - n
  } else n
  if a >= 900000000000000.0 {
    // Fractional digits are meaningless out here; integer part only.
    let big = __to_string(Double::to_int(a))
    if neg {
      String::concat("-", big)
    } else big
  } else {
    let ip = Double::to_int(a)
    let frac = a - Int::to_double(ip)
    let scaled_raw = Double::to_int(frac * 1000000000000000.0 + 0.5)
    let carried = scaled_raw >= 1000000000000000
    let ip2 = if carried {
      ip + 1
    } else ip
    let scaled = if carried {
      0
    } else scaled_raw
    let int_str = __to_string(ip2)
    // Nested ifs: `neg && ...` trips codegen's float-binop classifier because
    // `neg` comes from a Double comparison (#744).
    let signed = if neg {
      if ip2 > 0 || scaled > 0 {
        String::concat("-", int_str)
      } else int_str
    } else int_str
    if scaled == 0 {
      signed
    } else {
      let ds = pad_to_15(__to_string(scaled))
      let rec trim_end = (k: Int) -> Int {
        if k > 0 && String::char_code_at(ds, k - 1) == '0' {
          trim_end(k - 1)
        } else k
      }
      String::concat(signed, String::concat(".", ds[0: trim_end(15)]))
    }
  }
}

/// JArr/JObj build their output with StringBuilder + while, not the local
/// `let rec` closure the two branches used before #1188: that closure
/// self-calls through the function table once per array element / object
/// key, and rewrite_self_tail_calls only turns TOP-LEVEL self-recursion into
/// a loop (see lib/@vibe/builtin/string.vibe's string_index_of_from comment
/// for the same bug class) -- confirmed empirically to overflow the real wasm
/// call stack around a few thousand elements, well within range for
/// realistic data (e.g. a compiler coverage report's branch-hit array).
fn stringify_impl(j: Json) -> String {
  match j {
    JNull => "null",
    JBool(b) => if b {
      "true"
    } else "false",
    JNum(n) => format_number(n),
    JStr(s) => escape_string(s),
    JArr(a) => {
      let len = Array::length(a)
      let b = StringBuilder::new()
      StringBuilder::push(b, "[")
      let mut i = 0
      while i < len {
        if i > 0 {
          StringBuilder::push(b, ",")
        } else {
          ()
        }
        StringBuilder::push(b, stringify_impl(Array::get(a, i)))
        i = i + 1
      }
      StringBuilder::push(b, "]")
      StringBuilder::freeze(b)
    },
    JObj(m) => {
      let keys = Map::keys(m)
      let len = Array::length(keys)
      let b = StringBuilder::new()
      StringBuilder::push(b, "{")
      let mut i = 0
      while i < len {
        let k = Array::get(keys, i)
        if i > 0 {
          StringBuilder::push(b, ",")
        } else {
          ()
        }
        StringBuilder::push(b, escape_string(k))
        StringBuilder::push(b, ":")
        StringBuilder::push(b, stringify_impl(Map::get(m, k)))
        i = i + 1
      }
      StringBuilder::push(b, "}")
      StringBuilder::freeze(b)
    }
  }
}

export fn stringify(j: Json) -> String {
  stringify_impl(j)
}
