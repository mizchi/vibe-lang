//# Imports

import ../prelude/result.vibe {
  Result
}

import ./json.vibe {
  Json, parse, stringify
}

//# Misc

let parse_ok = (s: String) -> Bool {
  match parse(s) {
    Result::Ok(_) => true,
    Result::Err(_) => false
  }
}

let parse_err = (s: String) -> Bool {
  match parse(s) {
    Result::Ok(_) => false,
    Result::Err(_) => true
  }
}

test "parse_null" {
  match parse("null") {
    Result::Ok((j, _)) => match j {
      JNull => assert(true),
      _ => assert(false)
    },
    Result::Err(_) => assert(false)
  }
}

test "parse_array" {
  match parse("[1,2,3]") {
    Result::Ok((j, _)) => match j {
      JArr(_) => assert(true),
      _ => assert(false)
    },
    Result::Err(_) => assert(false)
  }
}

test "parse_object_multi" {
  match parse("{\"a\":1,\"b\":2}") {
    Result::Ok((j, _)) => match j {
      JObj(_) => assert(true),
      _ => assert(false)
    },
    Result::Err(_) => assert(false)
  }
}

test "parse_complex" {
  match parse("{\"name\":\"vibe\",\"nums\":[1.5,2,3.25],\"ok\":true,\"meta\":null}") {
    Result::Ok((j, _)) => match j {
      JObj(_) => assert(true),
      _ => assert(false)
    },
    Result::Err(_) => assert(false)
  }
}

test "roundtrip_array" {
  match parse("[1,2,3]") {
    Result::Ok((parsed, _)) => assert(stringify(parsed) == "[1,2,3]"),
    Result::Err(_) => assert(false)
  }
}

test "parse_ok_test" {
  assert(parse_ok("null"))
  assert(parse_ok("42"))
  assert(parse_ok("\"hello\""))
  assert(parse_ok("[1,2]"))
  assert(parse_ok("{\"a\":1}"))
}

test "parse_err_test" {
  assert(parse_err("true false"))
  assert(parse_err(""))
}
