//# Imports

import ./json.vibe {
  Json, parse, stringify
}

//# Types

// #897 (ADR-0070 Phase 3): declared `opaque type` in ./index.vpkg (not
// transparent) — see json_types.vibe's `Json` comment: enum variants do not
// resolve across units, so the definitions must stay in the impl file.

export enum RpcId {
  IdNum(Int);
  IdStr(String);
  IdNull
}

export enum RpcMessage {
  Request(String, Json, RpcId);
  Notification(String, Json);
  SuccessResponse(RpcId, Json);
  ErrorResponse(RpcId, Int, String, Json)
}

//# Functions

/// Inlined @vibe/prelude::from_option (#769 precedent, cache_underlying.vibe):
/// generate_bundle.sh strips import lines from embedded sources and
/// collect_merged_stmts resolves references BY NAME, so a cross-package
/// prelude FUNCTION reference here is unresolvable once this file rides in
/// the compiler's merged bundle (@vibe/prelude has no bundle rows). A local
/// definition survives the strip; Option/Some/None are builtins and need no
/// import.
fn require_key(obj: Map[String, Json], key: String) -> Json with { Error } {
  if Map::has_key(obj, key) {
    Map::get(obj, key)
  } else {
    throw("missing key: \{key}")
  }
}

fn get_string(obj: Map[String, Json], key: String) -> String with { Error } {
  match require_key(obj, key) {
    JStr(s) => s,
    _ => throw("expected string for key: \{key}")
  }
}

fn get_object(j: Json, message: String) -> Map[String, Json] with { Error } {
  match j {
    JObj(m) => m,
    _ => throw(message)
  }
}

fn parse_rpc_id(j: Json) -> RpcId with { Error } {
  match j {
    JNum(n) => IdNum(Double::to_int(n)),
    JStr(s) => IdStr(s),
    JNull => IdNull,
    _ => throw("invalid id")
  }
}

/// #1324 slice 3: this was a `Result[RpcMessage, String]` built out of ~60
/// lines of nested `match .. { Ok(..) => .., Err(msg) => Err(msg) }`. Every
/// one of those `Err(msg) => Err(msg)` arms was a hand-rolled propagation
/// that the `Error` row now does for free, so the body is linear code and
/// only the real decisions are left. Callers that want to branch write
/// `handle { parse_message(s) } with Error { Throw(msg) => .. }`.
export fn parse_message(input: String) -> RpcMessage with { Error } {
  let (json, _) = parse(input)
  let obj = get_object(json, "expected object")
  if get_string(obj, "jsonrpc") != "2.0" {
    throw("invalid jsonrpc version")
  } else if Map::has_key(obj, "method") {
    let method = get_string(obj, "method")
    let params = if Map::has_key(obj, "params") {
      Map::get(obj, "params")
    } else JNull
    if Map::has_key(obj, "id") {
      Request(method, params, parse_rpc_id(Map::get(obj, "id")))
    } else Notification(method, params)
  } else if Map::has_key(obj, "result") {
    let id = parse_rpc_id(require_key(obj, "id"))
    SuccessResponse(id, Map::get(obj, "result"))
  } else if Map::has_key(obj, "error") {
    let id = parse_rpc_id(require_key(obj, "id"))
    let err_obj = get_object(Map::get(obj, "error"), "error must be object")
    let code = match require_key(err_obj, "code") {
      JNum(n) => Double::to_int(n),
      _ => throw("error code must be number")
    }
    let message = get_string(err_obj, "message")
    let data = if Map::has_key(err_obj, "data") {
      Map::get(err_obj, "data")
    } else JNull
    ErrorResponse(id, code, message, data)
  } else throw("invalid message: missing method, result, or error")
}

fn rpc_id_json_str(id: RpcId) -> String {
  match id {
    IdNum(n) => stringify(JNum(Int::to_double(n))),
    IdStr(s) => stringify(JStr(s)),
    IdNull => "null"
  }
}

export fn stringify_error(id: RpcId, code: Int, message: String, data: Json) -> String {
  let code_str = stringify(JNum(Int::to_double(code)))
  let msg_str = stringify(JStr(message))
  let data_str = stringify(data)
  let id_str = rpc_id_json_str(id)
  let err_str = "{\"code\":\{code_str},\"message\":\{msg_str},\"data\":\{data_str}}"
  "{\"jsonrpc\":\"2.0\",\"error\":\{err_str},\"id\":\{id_str}}"
}

export fn stringify_request(method: String, params: Json, id: RpcId) -> String {
  let method_str = stringify(JStr(method))
  let params_str = stringify(params)
  let id_str = rpc_id_json_str(id)
  "{\"jsonrpc\":\"2.0\",\"method\":\{method_str},\"params\":\{params_str},\"id\":\{id_str}}"
}

export fn stringify_response(id: RpcId, result: Json) -> String {
  let result_str = stringify(result)
  let id_str = rpc_id_json_str(id)
  "{\"jsonrpc\":\"2.0\",\"result\":\{result_str},\"id\":\{id_str}}"
}

export fn stringify_notification(method: String, params: Json) -> String {
  let method_str = stringify(JStr(method))
  let params_str = stringify(params)
  "{\"jsonrpc\":\"2.0\",\"method\":\{method_str},\"params\":\{params_str}}"
}

// #1189 naming consistency (wave 2): qualified companions grouping the
// parse/serialize surface under the type they construct/render --
// RpcMessage (Request/Notification/SuccessResponse/ErrorResponse), the
// same "no literal receiver, still Type::-namespaced" shape as
// Json::parse/Json::stringify in json_convenience.vibe.
export fn RpcMessage::parse(input: String) -> RpcMessage with { Error } {
  parse_message(input)
}

export fn RpcMessage::stringify_error(id: RpcId, code: Int, message: String, data: Json) -> String {
  stringify_error(id, code, message, data)
}

export fn RpcMessage::stringify_request(method: String, params: Json, id: RpcId) -> String {
  stringify_request(method, params, id)
}

export fn RpcMessage::stringify_response(id: RpcId, result: Json) -> String {
  stringify_response(id, result)
}

export fn RpcMessage::stringify_notification(method: String, params: Json) -> String {
  stringify_notification(method, params)
}
