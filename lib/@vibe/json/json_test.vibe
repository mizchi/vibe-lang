//# Imports

// #897: retargeted from `import ./json.vibe` to the package directory (the
// canonical post-#897 form; `Json` is `opaque type` in index.vpkg, its
// definition re-exported from json_types.vibe).
import .{
  Json, json_as_arr, json_as_bool, json_as_num, json_as_obj, json_as_str, parse, stringify
}

//# Functions

let input = "{\"name\":\"vibe\",\"nums\":[1.5,2,3.25],\"ok\":true,\"meta\":null}"

/// #1324 slice 3: `parse` throws instead of returning `Result`, so the
/// "did it parse" predicate is a `handle` rather than a match. Everything
/// below that merely NEEDED the parse to succeed dropped its `Err(_) =>
/// assert(false)` arm entirely -- an escaping throw fails the test by
/// itself (test blocks carry an ambient `Error`).
fn parse_ok(s: String) -> Bool {
  handle {
    let _ = parse(s)
    true
  } with { Exception::Throw(_) => false }
}

fn parse_err(s: String) -> Bool {
  !parse_ok(s)
}

/// Catch a parse failure's MESSAGE (empty string when it succeeded).
fn parse_err_msg(s: String) -> String {
  handle {
    let _ = parse(s)
    ""
  } with { Exception::Throw(msg) => msg }
}

//# Misc

test "json_parser_complex" {
  assert(parse_ok(input))
}

test "json_parser_numbers" {
  assert(parse_ok("0"))
  assert(parse_ok("-12"))
  assert(parse_ok("3.5"))
  assert(parse_ok("1e3"))
  assert(parse_ok("1.25e-2"))
  assert(parse_ok("1E+2"))
  assert(parse_ok("-0.0"))
}

test "json_parser_exponent_value" {
  let (j, _) = parse("1.25e-2")
  assert(eq(json_as_num(j), 0.0125))
}

test "json_parser_whitespace_nested_string" {
  assert(parse_ok(" \n\t{\"a\": 1}\n "))
  assert(parse_ok("{\"a\":[true,false,null,{\"b\":2}],\"c\":{}}"))
  assert(parse_ok("\"he\\\\llo\\n\\t\\\"/\""))
}

test "json_parser_errors" {
  assert(parse_ok("[]"))
  assert(parse_err("\"abc"))
  assert(parse_err("true false"))
  assert(parse_err("1e"))
  assert(parse_err("1e+"))
  assert(parse_err("1e-"))
  assert(parse_err("[1,]"))
  assert(parse_err("{\"a\":1,}"))
  assert(parse_err("\"a\\b\""))
  assert(parse_err("01"))
  assert(parse_err("-01"))
  assert(parse_err("00"))
  assert(parse_err(".1"))
  assert(parse_err("1."))
  assert(parse_err("+1"))
  assert(parse_err("-"))
  assert(parse_err("\"a\nb\""))
}

test "json_parser_thrown_error_message" {
  assert_eq(parse_err_msg("1e"), "expected exponent")
  assert_eq(parse_err_msg("true false"), "trailing input")
}

test "stringify_null" {
  assert(stringify(JNull) == "null")
}

test "stringify_bool" {
  assert(stringify(JBool(true)) == "true")
  assert(stringify(JBool(false)) == "false")
}

test "stringify_number" {
  assert(stringify(JNum(0.0)) == "0")
  assert(stringify(JNum(42.0)) == "42")
  assert(stringify(JNum(3.14)) == "3.14")
  assert(stringify(JNum(-1.0)) == "-1")
}

test "stringify_string" {
  assert(stringify(JStr("hello")) == "\"hello\"")
  assert(stringify(JStr("")) == "\"\"")
}

test "stringify_escape_quote" {
  assert(stringify(JStr("a\"b")) == "\"a\\\"b\"")
}

test "stringify_escape_backslash" {
  assert(stringify(JStr("a\\b")) == "\"a\\\\b\"")
}

test "stringify_escape_newline" {
  assert(stringify(JStr("a\nb")) == "\"a\\nb\"")
}

test "stringify_escape_tab" {
  assert(stringify(JStr("a\tb")) == "\"a\\tb\"")
}

test "stringify_escape_cr" {
  let cr_str = "a\{String::from_char_code(13)}b"
  assert(stringify(JStr(cr_str)) == "\"a\\rb\"")
}

test "stringify_array" {
  let (empty_arr, _) = parse("[]")
  assert(stringify(empty_arr) == "[]")
  assert(stringify(JArr([JNum(1.0), JNum(2.0), JNum(3.0)])) == "[1,2,3]")
  assert(stringify(JArr([JStr("a"), JNull, JBool(true)])) == "[\"a\",null,true]")
}

test "stringify_object" {
  let (empty_obj, _) = parse("{}")
  assert(stringify(empty_obj) == "{}")
  assert(stringify(JObj(Map::from_pairs([("x", JNum(1.0))]))) == "{\"x\":1}")
}

test "roundtrip_simple" {
  let original = "{\"name\":\"vibe\",\"ok\":true}"
  let (parsed, _) = parse(original)
  assert(parse_ok(stringify(parsed)))
}

test "roundtrip_array" {
  let original = "[1,2,3]"
  let (parsed, _) = parse(original)
  assert(stringify(parsed) == "[1,2,3]")
}

test "roundtrip_nested" {
  let original = "{\"a\":[1,true,null],\"b\":{\"c\":\"hello\"}}"
  let (parsed, _) = parse(original)
  assert(parse_ok(stringify(parsed)))
}

test "Json::get" {
  let (j, _) = parse("{\"name\":\"vibe\",\"ver\":1}")
  assert(json_as_str(Json::get(j, "name")) == "vibe")
  assert(eq(json_as_num(Json::get(j, "ver")), 1.0))
}

/// The failure side of the accessors, which the old `Err(_) => assert(false)`
/// arms never actually asserted anything about.
test "Json::get and json_as_* throw their message" {
  let (j, _) = parse("{\"a\":1}")
  let missing = handle {
    let _ = Json::get(j, "nope")
    ""
  } with { Exception::Throw(msg) => msg }
  assert_eq(missing, "key not found: nope")
  let mismatch = handle {
    let _ = json_as_str(j)
    ""
  } with { Exception::Throw(msg) => msg }
  assert_eq(mismatch, "not a string")
}

test "json_as_bool" {
  let (j, _) = parse("true")
  assert(json_as_bool(j))
}

test "json_as_arr" {
  let (j, _) = parse("[1,2]")
  assert(eq(Array::length(json_as_arr(j)), 2))
}

test "json_as_obj" {
  let (j, _) = parse("{\"a\":1}")
  assert(Map::has_key(json_as_obj(j), "a"))
}

// #1189 naming consistency (wave 2): the Json::as_* companions resolve via
// method-style dot calls (desugar_trait_dict.vibe) and agree with the bare
// json_as_* forms -- same shape as set_method_style_parity in
// lib/@vibe/core/set_test.vibe. Dot-call desugar only tracks types recorded
// in `var_types` (param annotations / `let x: T = ...`), NOT match-pattern
// bindings, so every dot-called receiver below is rebound through an
// explicit `let x: Json = ...` first (same constraint `vibe normalize`
// documents for #1194).
test "json_method_style_parity" {
  let (parsed, _) = parse("{\"a\":[1,2],\"b\":true,\"c\":\"x\"}")
  let obj: Json = parsed
  let dot_obj = obj.as_obj()
  let bare_obj = json_as_obj(obj)
  assert(Map::has_key(dot_obj, "a") == Map::has_key(bare_obj, "a"))
  let arr: Json = Json::get(obj, "a")
  assert(eq(Array::length(arr.as_arr()), Array::length(json_as_arr(arr))))
  let bv: Json = Json::get(obj, "b")
  assert(bv.as_bool() == json_as_bool(bv))
  let cv: Json = Json::get(obj, "c")
  assert(cv.as_str() == json_as_str(cv))
  let nv: Json = JNum(1.0)
  assert(eq(nv.as_num(), json_as_num(nv)))
}
