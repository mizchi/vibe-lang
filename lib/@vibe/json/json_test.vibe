//# Imports

import @vibe/prelude {
  Result
}

// #897: retargeted from `import ./json.vibe` to the package directory (the
// canonical post-#897 form; `Json` is `opaque type` in index.vpkg, its
// definition re-exported from json_types.vibe).
import .{
  Json, Json::get, json_as_arr, json_as_bool, json_as_num, json_as_obj, json_as_str, parse, stringify
}

//# Functions

let input = "{\"name\":\"vibe\",\"nums\":[1.5,2,3.25],\"ok\":true,\"meta\":null}"

fn parse_ok(s: String) -> Bool {
  match parse(s) {
    Result::Ok(_) => true,
    Result::Err(_) => false
  }
}

fn parse_err(s: String) -> Bool {
  match parse(s) {
    Result::Ok(_) => false,
    Result::Err(_) => true
  }
}

//# Misc

test "json_parser_complex" {
  assert(parse_ok(input))
}

test "json_parser_numbers" {
  assert(parse_ok("0"))
  assert(parse_ok("-12"))
  assert(parse_ok("3.5"))
  assert(parse_ok("1e3"))
  assert(parse_ok("1.25e-2"))
  assert(parse_ok("1E+2"))
  assert(parse_ok("-0.0"))
}

test "json_parser_exponent_value" {
  match parse("1.25e-2") {
    Result::Ok((j, _)) => match json_as_num(j) {
      Result::Ok(value) => assert(eq(value, 0.0125)),
      Result::Err(_) => assert(false)
    },
    Result::Err(_) => assert(false)
  }
}

test "json_parser_whitespace_nested_string" {
  assert(parse_ok(" \n\t{\"a\": 1}\n "))
  assert(parse_ok("{\"a\":[true,false,null,{\"b\":2}],\"c\":{}}"))
  assert(parse_ok("\"he\\\\llo\\n\\t\\\"/\""))
}

test "json_parser_errors" {
  assert(parse_ok("[]"))
  assert(parse_err("\"abc"))
  assert(parse_err("true false"))
  assert(parse_err("1e"))
  assert(parse_err("1e+"))
  assert(parse_err("1e-"))
  assert(parse_err("[1,]"))
  assert(parse_err("{\"a\":1,}"))
  assert(parse_err("\"a\\b\""))
  assert(parse_err("01"))
  assert(parse_err("-01"))
  assert(parse_err("00"))
  assert(parse_err(".1"))
  assert(parse_err("1."))
  assert(parse_err("+1"))
  assert(parse_err("-"))
  assert(parse_err("\"a\nb\""))
}

test "json_parser_result_error_message" {
  match parse("1e") {
    Result::Ok(_) => assert(false),
    Result::Err(msg) => assert(msg == "expected exponent")
  }
  match parse("true false") {
    Result::Ok(_) => assert(false),
    Result::Err(msg) => assert(msg == "trailing input")
  }
}

test "stringify_null" {
  assert(stringify(JNull) == "null")
}

test "stringify_bool" {
  assert(stringify(JBool(true)) == "true")
  assert(stringify(JBool(false)) == "false")
}

test "stringify_number" {
  assert(stringify(JNum(0.0)) == "0")
  assert(stringify(JNum(42.0)) == "42")
  assert(stringify(JNum(3.14)) == "3.14")
  assert(stringify(JNum(-1.0)) == "-1")
}

test "stringify_string" {
  assert(stringify(JStr("hello")) == "\"hello\"")
  assert(stringify(JStr("")) == "\"\"")
}

test "stringify_escape_quote" {
  assert(stringify(JStr("a\"b")) == "\"a\\\"b\"")
}

test "stringify_escape_backslash" {
  assert(stringify(JStr("a\\b")) == "\"a\\\\b\"")
}

test "stringify_escape_newline" {
  assert(stringify(JStr("a\nb")) == "\"a\\nb\"")
}

test "stringify_escape_tab" {
  assert(stringify(JStr("a\tb")) == "\"a\\tb\"")
}

test "stringify_escape_cr" {
  let cr_str = "a\{String::from_char_code(13)}b"
  assert(stringify(JStr(cr_str)) == "\"a\\rb\"")
}

test "stringify_array" {
  match parse("[]") {
    Result::Ok((empty_arr, _)) => assert(stringify(empty_arr) == "[]"),
    Result::Err(_) => assert(false)
  }
  assert(stringify(JArr([
    JNum(1.0),
    JNum(2.0),
    JNum(3.0)
  ])) == "[1,2,3]")
  assert(stringify(JArr([
    JStr("a"),
    JNull,
    JBool(true)
  ])) == "[\"a\",null,true]")
}

test "stringify_object" {
  match parse("{}") {
    Result::Ok((empty_obj, _)) => assert(stringify(empty_obj) == "{}"),
    Result::Err(_) => assert(false)
  }
  assert(stringify(JObj(Map::from_pairs([
    ("x", JNum(1.0))
  ]))) == "{\"x\":1}")
}

test "roundtrip_simple" {
  let original = "{\"name\":\"vibe\",\"ok\":true}"
  match parse(original) {
    Result::Ok((parsed, _)) => {
      let serialized = stringify(parsed)
      assert(parse_ok(serialized))
    },
    Result::Err(_) => assert(false)
  }
}

test "roundtrip_array" {
  let original = "[1,2,3]"
  match parse(original) {
    Result::Ok((parsed, _)) => {
      let serialized = stringify(parsed)
      assert(serialized == "[1,2,3]")
    },
    Result::Err(_) => assert(false)
  }
}

test "roundtrip_nested" {
  let original = "{\"a\":[1,true,null],\"b\":{\"c\":\"hello\"}}"
  match parse(original) {
    Result::Ok((parsed, _)) => {
      let serialized = stringify(parsed)
      assert(parse_ok(serialized))
    },
    Result::Err(_) => assert(false)
  }
}

test "Json::get" {
  match parse("{\"name\":\"vibe\",\"ver\":1}") {
    Result::Ok((j, _)) => {
      match Json::get(j, "name") {
        Result::Ok(name) => match json_as_str(name) {
          Result::Ok(value) => assert(value == "vibe"),
          Result::Err(_) => assert(false)
        },
        Result::Err(_) => assert(false)
      }
      match Json::get(j, "ver") {
        Result::Ok(ver) => match json_as_num(ver) {
          Result::Ok(value) => assert(eq(value, 1.0)),
          Result::Err(_) => assert(false)
        },
        Result::Err(_) => assert(false)
      }
    },
    Result::Err(_) => assert(false)
  }
}

test "json_as_bool" {
  match parse("true") {
    Result::Ok((j, _)) => match json_as_bool(j) {
      Result::Ok(value) => assert(value),
      Result::Err(_) => assert(false)
    },
    Result::Err(_) => assert(false)
  }
}

test "json_as_arr" {
  match parse("[1,2]") {
    Result::Ok((j, _)) => match json_as_arr(j) {
      Result::Ok(arr) => assert(eq(Array::length(arr), 2)),
      Result::Err(_) => assert(false)
    },
    Result::Err(_) => assert(false)
  }
}

test "json_as_obj" {
  match parse("{\"a\":1}") {
    Result::Ok((j, _)) => match json_as_obj(j) {
      Result::Ok(m) => assert(Map::has_key(m, "a")),
      Result::Err(_) => assert(false)
    },
    Result::Err(_) => assert(false)
  }
}
