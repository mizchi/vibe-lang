//# Imports

// #1080 regression: importing just the TYPE (`{ Json }`) must bring the
// package's whole `Json::`-qualified export surface into scope under the
// FS-compile lane -- including the accessors whose RETURN type is not
// Json. bind_enum_constructor_companions (runtime/typecheck_fs.vibe) used
// to bind companions only when their return type equals the imported type
// (the enum-constructor rule), so `Json::parse`/`Json::field` (return
// Json) resolved while `Json::string`/`Json::length`/... (return
// String/Int/...) failed with "unknown name". This test deliberately
// imports ONLY `Json` and calls every #777 accessor.
import @vibe/json {
  Json
}

//# Misc

test "Json:: accessors resolve from a bare type import (#1080)" {
  let j = Json::parse("{\"s\":\"hi\",\"n\":2,\"b\":true,\"a\":[1,2,3]}")
  assert(Json::string(Json::field(j, key = "s")) == "hi")
  assert(Json::number(Json::field(j, key = "n")) == 2.0)
  assert(Json::bool(Json::field(j, key = "b")))
  assert(Json::length(Json::field(j, key = "a")) == 3)
  assert(Json::number(Json::index(Json::field(j, key = "a"), idx = 1)) == 2.0)
  assert(!Json::is_null(Json::field(j, key = "s")))
  assert(Json::is_null(Json::field(j, key = "missing")))
  assert(Json::type_of(j) == "object")
  assert(Array::length(Json::keys(j)) == 4)
  assert(String::length(Json::stringify(j)) > 0)
}

test "Json::get_opt keeps missing distinct from explicit null (#1845)" {
  let j = Json::parse("{\"present\":1,\"nul\":null}")
  match Json::get_opt(j, key = "present") {
    Some(v) => assert(Json::number(v) == 1.0),
    None => assert(false)
  }
  // explicit null: key present, value is JSON null
  match Json::get_opt(j, key = "nul") {
    Some(v) => assert(Json::is_null(v)),
    None => assert(false)
  }
  // missing key: None (Json::field would flatten this to JNull)
  match Json::get_opt(j, key = "missing") {
    Some(_) => assert(false),
    None => assert(true)
  }
  // non-object receiver: None
  match Json::get_opt(Json::parse("[1,2]"), key = "k") {
    Some(_) => assert(false),
    None => assert(true)
  }
}
