import ../prelude {
  Result
}

//# Values

// #897 (ADR-0070 Phase 3): preserved from the old index.vibe facade, which
// defined `export let version = "0.0.1"` directly (a real importable
// binding, not just contract metadata) — Codex review precedent from PR
// #914.
export let version: String = "0.0.1"

//# Types

// #897 (ADR-0070 Phase 3): `Json` stays DEFINED (and exported) here, with
// an `opaque type Json` declaration in ./index.vpkg — NOT a transparent
// contract definition, even though the variants are real public surface
// (every consumer matches/constructs JNull/JObj/...). A transparent
// contract definition lives only in the facade unit, and enum VARIANTS do
// not resolve across units the way type names do: sibling impl files
// (json_parse.vibe etc.) construct JNull/JObj without importing them, which
// broke with "unknown name: JNull" when the definition moved to the
// contract. The opaque declaration + exported impl definition rides the
// same #716 re-export machinery the old hand-written index.vibe used, so
// variant visibility for consumers is unchanged.
export enum Json {
  JNull;
  JBool(Bool);
  JNum(Double);
  JStr(String);
  JArr(Array[Json]);
  JObj(Map[String, Json])
}

export fn json_as_arr(j: Json) -> Result[Array[Json], String] {
  match j {
    JArr(a) => Ok(a),
    _ => Err("not an array")
  }
}

export fn json_as_num(j: Json) -> Result[Double, String] {
  match j {
    JNum(n) => Ok(n),
    _ => Err("not a number")
  }
}

export fn json_as_obj(j: Json) -> Result[Map[String, Json], String] {
  match j {
    JObj(m) => Ok(m),
    _ => Err("not an object")
  }
}

export fn json_as_str(j: Json) -> Result[String, String] {
  match j {
    JStr(s) => Ok(s),
    _ => Err("not a string")
  }
}

export fn json_as_bool(j: Json) -> Result[Bool, String] {
  match j {
    JBool(b) => Ok(b),
    _ => Err("not a bool")
  }
}

export fn Json::get(j: Json, key: String) -> Result[Json, String] {
  match j {
    JObj(m) => if Map::has_key(m, key) {
      Ok(Map::get(m, key))
    } else Err("key not found: \{key}"),
    _ => Err("not an object")
  }
}
