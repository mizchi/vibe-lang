import ../../../vibe/prelude/result.vibe {
  Result
}

export enum Json {
  JNull;
  JBool(Bool);
  JNum(Double);
  JStr(String);
  JArr(Array[Json]);
  JObj(Map[String, Json])
}

export let json_as_arr = (j: Json) -> Result[Array[Json], String] {
  match j {
    JArr(a) => Ok(a),
    _ => Err("not an array")
  }
}

export let json_as_num = (j: Json) -> Result[Double, String] {
  match j {
    JNum(n) => Ok(n),
    _ => Err("not a number")
  }
}

export let json_as_obj = (j: Json) -> Result[Map[String, Json], String] {
  match j {
    JObj(m) => Ok(m),
    _ => Err("not an object")
  }
}

export let json_as_str = (j: Json) -> Result[String, String] {
  match j {
    JStr(s) => Ok(s),
    _ => Err("not a string")
  }
}

export let json_as_bool = (j: Json) -> Result[Bool, String] {
  match j {
    JBool(b) => Ok(b),
    _ => Err("not a bool")
  }
}

export let Json::get = (j: Json, key: String) -> Result[Json, String] {
  match j {
    JObj(m) => if Map::has_key(m, key) {
      Ok(Map::get(m, key))
    } else Err("key not found: \{key}"),
    _ => Err("not an object")
  }
}
