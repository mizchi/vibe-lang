export let version = "0.0.1"

export ./json.vibe {
  Json,
  parse,
  stringify,
  Json::get,
  json_as_arr,
  json_as_num,
  json_as_obj,
  json_as_str,
  json_as_bool
}

export ./jsonrpc.vibe {
  RpcId,
  RpcMessage,
  parse_message,
  stringify_request,
  stringify_notification,
  stringify_response,
  stringify_error
}

// #847 Phase B: facade re-export so external callers (e.g. lib/@vibe/shell/)
// reach json_convenience.vibe only through json/index.vibe, not the
// internal file directly.
export ./json_convenience.vibe {
  Json::parse,
  Json::stringify,
  Json::field,
  Json::index,
  Json::number,
  Json::string,
  Json::bool,
  Json::is_null,
  Json::length,
  Json::keys,
  Json::type_of
}

export {
  Json,
  parse,
  stringify,
  Json::get,
  json_as_arr,
  json_as_num,
  json_as_obj,
  json_as_str,
  json_as_bool,
  RpcId,
  RpcMessage,
  parse_message,
  stringify_request,
  stringify_notification,
  stringify_response,
  stringify_error
}
