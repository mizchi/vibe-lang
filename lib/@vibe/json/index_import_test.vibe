//# Imports

import @vibe/prelude {
  Result
}

import .{
  Json, RpcId, parse, parse_message, stringify, stringify_request
}

//# Misc

test "json index exports core symbols" {
  match parse("\"ok\"") {
    Result::Ok((j, _)) => assert(stringify(j) == "\"ok\""),
    Result::Err(_) => assert(false)
  }
  match parse_message(stringify_request("ping", JNull, IdNum(1))) {
    Result::Ok(Request(method, _, _)) => assert(method == "ping"),
    _ => assert(false)
  }
}
