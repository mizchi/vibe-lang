//# Imports

import .{
  process_run, process_run_line, process_run_lines, process_run_text, run, run_line, run_lines, run_text
}

//# Misc

test "process index exports shell wrappers" {
  let _ = run
  let _ = run_line
  let _ = run_lines
  let _ = run_text
  assert(true)
}

test "process index exports canonical aliases" {
  let _ = process_run
  let _ = process_run_line
  let _ = process_run_lines
  let _ = process_run_text
  assert(true)
}
