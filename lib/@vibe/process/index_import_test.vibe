//# Imports

import .{
  process_run, process_run_line, process_run_lines, process_run_text, process_exit, run, run_line, run_lines, run_text, exit
}

//# Misc

test "process index exports shell wrappers" {
  let _ = run
  let _ = run_line
  let _ = run_lines
  let _ = run_text
  assert(true)
}

test "process index exports canonical aliases" {
  let _ = process_run
  let _ = process_run_line
  let _ = process_run_lines
  let _ = process_run_text
  let _ = process_exit
  assert(true)
}

test "process index exports exit (Codex review, PR #909)" {
  // Referenced as a value only -- calling it would terminate this test
  // process. `lib/@vibe/process/index.vpkg` must declare it (and its
  // canonical `process_exit` alias) so `import @vibe/process { exit }`
  // actually works.
  let _ = exit
  assert(true)
}
