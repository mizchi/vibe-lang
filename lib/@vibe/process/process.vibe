//# Values

//# Types

// #865: structured subprocess result ({exit_code, stdout, stderr}), so
// callers that need to branch on subprocess success/failure aren't limited to
// prefix string-matching sh_lines' "error: " convention. `ShResult` is
// defined transparently in lib/@vibe/process/index.vpkg (the contract IS the
// definition, ADR-0063) -- referenced here by name only, same convention as
// `Point` in fixtures/contract_pkg/impl.vibe.

//# Functions

/// run: (String) -> Unit with { Process }
export fn run(cmd: String) -> Unit with Process {
  // `sh` runs the command for its side effects and returns 0; discard it so
  // `run` is Unit-typed.
  let _ = sh(cmd)
  ()
}

/// run_lines: (String) -> Array[String] with { Process }
export fn run_lines(cmd: String) -> Array[String] with Process {
  sh_lines(cmd)
}

/// run_text: (String) -> String with { Process }
export fn run_text(cmd: String) -> String with Process {
  String::join(run_lines(cmd), "\n")
}

fn first_line(lines: Array[String]) -> String {
  if Array::length(lines) == 0 {
    ""
  } else Array::get(lines, 0)
}

/// run_line: (String) -> String with { Process }
export fn run_line(cmd: String) -> String with Process {
  first_line(run_lines(cmd))
}

/// sh_capture: (String) -> ShResult with { Process }
/// Runs `cmd` ONCE (unlike a naive 3-accessor design that would re-run it) and
/// returns the real exit code alongside stdout/stderr, so a caller can branch
/// on `result.exit_code == 0` instead of string-prefix matching sh_lines'
/// "error: " convention or catching sh's unconditional throw. Calls the raw
/// dunder builtins directly (not `perform`), same convention as
/// lib/@vibe/http/http.vibe's `vibe_http_*_raw` direct calls.
export fn sh_capture(cmd: String) -> ShResult with Process {
  // NOTE: `handle` is a reserved word (the `handle { ... } with Effect { }`
  // expression), so the local binding is named `cap_handle` instead.
  let cap_handle = vibe_sh_capture_raw(cmd)
  let result = ShResult::{
    exit_code: vibe_sh_capture_exit_code_raw(cap_handle),
    stdout: vibe_sh_capture_stdout_raw(cap_handle),
    stderr: vibe_sh_capture_stderr_raw(cap_handle)
  }
  vibe_sh_capture_close_raw(cap_handle)
  result
}

/// exit: (Int) -> Unit with { Process }
/// #903/#865: propagates `code` to the real OS process exit status --
/// unlike returning `code` from `main`, which the host `_start` only PRINTS
/// (see ADR-0069's entry_returns_unit comment in
/// codegen/wasi/linked_compile.vibe). Never returns in practice; typed Unit
/// because there is no `Never` type.
export fn exit(code: Int) -> Unit with Process {
  vibe_process_exit_raw(code)
}

//# Canonical collision-safe aliases

/// #897 (ADR-0070 Phase 3): the old index.vibe facade defined these as plain
/// `export let process_run = run` VALUE aliases (real importable bindings,
/// not re-exports) directly in the facade file itself. A `.vpkg` facade only
/// allocates a declared name to an EXPORTED FN/type def in a sibling impl
/// file (a bare name-to-name alias has no fn body to match), so these are
/// re-expressed here as real thin wrapper functions with the exact same
/// names/signatures/effects as the aliased functions above (same pattern as
/// @vibe/io's io_* aliases, PR #915) — no behavior change for callers.
export fn process_run(cmd: String) -> Unit with Process {
  run(cmd)
}

export fn process_run_lines(cmd: String) -> Array[String] with Process {
  run_lines(cmd)
}

export fn process_run_line(cmd: String) -> String with Process {
  run_line(cmd)
}

export fn process_run_text(cmd: String) -> String with Process {
  run_text(cmd)
}

export fn process_sh_capture(cmd: String) -> ShResult with Process {
  sh_capture(cmd)
}

export fn process_exit(code: Int) -> Unit with Process {
  exit(code)
}
