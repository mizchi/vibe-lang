name = @vibe/process
version = 0.0.1
description =
  #|@vibe/process — subprocess execution (run/run_lines/run_text/run_line),
deps = {}

generated_hash =

// @vibe/process — subprocess execution (run/run_lines/run_text/run_line),
// structured capture (sh_capture/ShResult, #865), and process exit
// (exit/Process::exit, #903/#865), plus the Process effect declaration
// itself (ADR-0070 Phase 3, #897).
//
// `ShResult` is declared TRANSPARENT (defined verbatim, not opaque):
// sh_capture_test.vibe accesses `.exit_code`/`.stdout`/`.stderr` directly,
// so the field layout is real public API surface, not an implementation
// detail. `Process` is a transparent effect definition (#752's contract
// convention for effect rows: the op signatures ARE the contract, same as
// a transparent type) -- `lib/@vibe/time/index_import_test.vibe` imports
// this declaration directly (`import ../process { Process }`, fixed from a
// literal-filename `import ../process/index.vibe` that blocked this
// package's migration -- #919) to discharge the effect in its own `handle`
// blocks.
//
// `version` was `export let version = "0.0.1"` directly in the old
// index.vibe facade -- a real importable binding, not just contract
// metadata -- so it is preserved verbatim as an implementation-file value
// (process.vibe) with a matching bodyless declaration here (Codex review
// precedent, PR #914). The old facade ALSO defined six `process_*`
// "canonical collision-safe alias" bindings (process_run, process_exit,
// ...) as plain `export let process_run = run` VALUE aliases -- same trap
// as `version` -- re-expressed as real thin wrapper functions in
// process.vibe (same pattern as @vibe/io's io_* aliases, PR #915).

struct ShResult {
  exit_code: Int;
  stdout: String;
  stderr: String
}

effect Process {
  Exec(String) -> String;
  Env(String) -> String;
  Exit(Int) -> Unit
}

fn run(cmd: String) -> Unit with Process
fn run_lines(cmd: String) -> Array[String] with Process
fn run_text(cmd: String) -> String with Process
fn run_line(cmd: String) -> String with Process
fn sh_capture(cmd: String) -> ShResult with Process
fn exit(code: Int) -> Unit with Process

// --- canonical collision-safe aliases
fn process_run(cmd: String) -> Unit with Process
fn process_run_lines(cmd: String) -> Array[String] with Process
fn process_run_line(cmd: String) -> String with Process
fn process_run_text(cmd: String) -> String with Process
fn process_sh_capture(cmd: String) -> ShResult with Process
fn process_exit(code: Int) -> Unit with Process
