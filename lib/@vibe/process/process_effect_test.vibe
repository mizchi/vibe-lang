//# Imports

import ./process_effect.vibe {
  Process
}

//# Misc

test "process mock exec" {
  let output = handle {
    perform Process::Exec("echo hello")
  } with { Process::Exec(_cmd) => resume("hello\n"); Process::Env(_key) => resume(""); Process::Exit(_code) => resume(0) }
  assert(String::length(output) == 6)
}
