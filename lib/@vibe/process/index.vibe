export let version = "0.0.1"

export ./process.vibe {
  run, run_lines, run_line, run_text, sh_capture, ShResult
}

// #847 Phase B: facade re-export so external callers reach
// process_effect.vibe only through process/index.vibe, not the internal
// file directly.
export ./process_effect.vibe {
  Process
}

// Canonical collision-safe aliases
export let process_run = run
export let process_run_lines = run_lines
export let process_run_line = run_line
export let process_run_text = run_text
export let process_sh_capture = sh_capture

export {
  run, run_lines, run_line, run_text, sh_capture, ShResult
}
