//# Imports

import ./blake3.vibe {
  blake3, blake3_bytes
}

//# Helpers

/// Official BLAKE3 test-vector input: byte i = i % 251.
fn pattern_bytes(n: Int) -> Bytes {
  let b = Bytes::new()
  let mut i = 0
  while i < n {
    Bytes::push(b, i % 251)
    i = i + 1
  }
  b
}

//# Misc

test "blake3 empty" {
  assert(blake3("") == "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262")
}

test "blake3 abc" {
  assert(blake3("abc") == "6437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d85")
}

test "blake3 short" {
  assert(blake3("Hello, BLAKE3!") == "f9966311c780665a97b5be88682f05f2c9b7259087c5113900c2390b65b0b5ff")
}

test "blake3 medium (108 chars)" {
  assert(blake3("abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789") == "12adc277387bc7b7d14ff44c6da0cace6b6f36e30342af754d6468fd164b3a4d")
}

test "blake3 single block boundaries (63/64/65)" {
  assert(blake3_bytes(pattern_bytes(63)) == "e9bc37a594daad83be9470df7f7b3798297c3d834ce80ba85d6e207627b7db7b")
  assert(blake3_bytes(pattern_bytes(64)) == "4eed7141ea4a5cd4b788606bd23f46e212af9cacebacdc7d1f4c6dc7f2511b98")
  assert(blake3_bytes(pattern_bytes(65)) == "de1e5fa0be70df6d2be8fffd0e99ceaa8eb6e8c93a63f2d8d1c30ecb6b263dee")
}

test "blake3 multi-block single chunk (511/512/1023/1024)" {
  assert(blake3_bytes(pattern_bytes(511)) == "7469b385b5290a1011288fc80a7fdb8677497dbc1d3b6daf93667725f68708f5")
  assert(blake3_bytes(pattern_bytes(512)) == "87aa0321ee04decf72d6fe8d5799d6216db538c0da4a367d6d456643e9ea7994")
  assert(blake3_bytes(pattern_bytes(1023)) == "10108970eeda3eb932baac1428c7a2163b0e924c9a9e25b35bba72b28f70bd11")
  assert(blake3_bytes(pattern_bytes(1024)) == "42214739f095a406f3fc83deb889744ac00df831c10daa55189b5d121c855af7")
}

test "blake3 multi-chunk tree (1025/2048/3072/4096)" {
  assert(blake3_bytes(pattern_bytes(1025)) == "d00278ae47eb27b34faecf67b4fe263f82d5412916c1ffd97c8cb7fb814b8444")
  assert(blake3_bytes(pattern_bytes(2048)) == "e776b6028c7cd22a4d0ba182a8bf62205d2ef576467e838ed6f2529b85fba24a")
  assert(blake3_bytes(pattern_bytes(3072)) == "b98cb0ff3623be03326b373de6b9095218513e64f1ee2edd2525c7ad1e5cffd2")
  assert(blake3_bytes(pattern_bytes(4096)) == "015094013f57a5277b59d8475c0501042c0b642e531b0a1c8f58d2163229e969")
}
