//# @vibe/blake3 — BLAKE3 hash (hex digest), pure vibe (ADR-0065 実験 scope)。
//# 32-bit word 演算は 62-bit tagged Int 上で mask32 折り返しでエミュレート
//# する (sha1.vibe と同じ流儀)。tree hashing は仕様どおり: 1024-byte chunk、
//# 左 subtree は「総 chunk 数未満の最大 2 冪」。counter は chunk index
//# (62-bit Int に収まる範囲で正確)。出力は 256-bit digest の
//# little-endian hex 64 文字。
//#
//# 圧縮の作業領域 (state / message words) は呼び出し 1 回分の Scratch に
//# まとめて確保し、全 block / 全 chunk で使い回す — 初版の per-compress
//# 確保は 8KiB 入力で ~145 KiB/op の bump-heap を積んでいた
//# (docs/internal/reports/blake3-vs-sha1-bench-2026-08-01.md)。

//# Constants

let mask32: Int = 0xFFFFFFFF

let iv0: Int = 0x6A09E667

let iv1: Int = 0xBB67AE85

let iv2: Int = 0x3C6EF372

let iv3: Int = 0xA54FF53A

let iv4: Int = 0x510E527F

let iv5: Int = 0x9B05688C

let iv6: Int = 0x1F83D9AB

let iv7: Int = 0x5BE0CD19

let flag_chunk_start: Int = 1

let flag_chunk_end: Int = 2

let flag_parent: Int = 4

let flag_root: Int = 8

let chunk_len: Int = 1024

let block_len_max: Int = 64

//# Word helpers

/// Rotate a 32-bit word right by n (1 <= n <= 31). `x` is always kept in
/// [0, 2^32) so the arithmetic `>>` never sees a sign bit.
fn rotr(x: Int, n: Int) -> Int {
  ((x>>n)|(x<<(32 - n)))&mask32
}

fn iv_words() -> Array[Int] {
  let cv = Int64Array::make(8, value = 0)
  Int64Array::set(cv, at = 0, value = iv0)
  Int64Array::set(cv, at = 1, value = iv1)
  Int64Array::set(cv, at = 2, value = iv2)
  Int64Array::set(cv, at = 3, value = iv3)
  Int64Array::set(cv, at = 4, value = iv4)
  Int64Array::set(cv, at = 5, value = iv5)
  Int64Array::set(cv, at = 6, value = iv6)
  Int64Array::set(cv, at = 7, value = iv7)
  cv
}

//# Scratch

/// Reusable compression workspace: one per top-level hash call, threaded
/// through every block/chunk/parent compression. `st` doubles as the
/// compression output (first 8 words = chaining value).
struct Scratch {
  st: Array[Int];
  m1: Array[Int];
  m2: Array[Int];
  block: Array[Int]
}

fn new_scratch() -> Scratch {
  Scratch::{
    st: Int64Array::make(16, value = 0),
    m1: Int64Array::make(16, value = 0),
    m2: Int64Array::make(16, value = 0),
    block: Int64Array::make(16, value = 0)
  }
}

//# Compression

/// The G mixing function on state indices (a, b, c, d) with message words
/// mx / my. Sums of three 32-bit words stay far below 2^61, so a single
/// trailing mask per addition is enough.
fn g_mix(st: Array[Int], a: Int, b: Int, c: Int, d: Int, mx: Int, my: Int) -> Unit {
  let va1 = (Int64Array::get(st, at = a) + Int64Array::get(st, at = b) + mx)&mask32
  let vd1 = rotr(x = Int64Array::get(st, at = d)^va1, n = 16)
  let vc1 = (Int64Array::get(st, at = c) + vd1)&mask32
  let vb1 = rotr(x = Int64Array::get(st, at = b)^vc1, n = 12)
  let va2 = (va1 + vb1 + my)&mask32
  let vd2 = rotr(x = vd1^va2, n = 8)
  let vc2 = (vc1 + vd2)&mask32
  let vb2 = rotr(x = vb1^vc2, n = 7)
  Int64Array::set(st, at = a, value = va2)
  Int64Array::set(st, at = b, value = vb2)
  Int64Array::set(st, at = c, value = vc2)
  Int64Array::set(st, at = d, value = vd2)
}

fn round_mix(st: Array[Int], m: Array[Int]) -> Unit {
  g_mix(st = st, a = 0, b = 4, c = 8, d = 12, mx = Int64Array::get(m, at = 0), my = Int64Array::get(m, at = 1))
  g_mix(st = st, a = 1, b = 5, c = 9, d = 13, mx = Int64Array::get(m, at = 2), my = Int64Array::get(m, at = 3))
  g_mix(st = st, a = 2, b = 6, c = 10, d = 14, mx = Int64Array::get(m, at = 4), my = Int64Array::get(m, at = 5))
  g_mix(st = st, a = 3, b = 7, c = 11, d = 15, mx = Int64Array::get(m, at = 6), my = Int64Array::get(m, at = 7))
  g_mix(st = st, a = 0, b = 5, c = 10, d = 15, mx = Int64Array::get(m, at = 8), my = Int64Array::get(m, at = 9))
  g_mix(st = st, a = 1, b = 6, c = 11, d = 12, mx = Int64Array::get(m, at = 10), my = Int64Array::get(m, at = 11))
  g_mix(st = st, a = 2, b = 7, c = 8, d = 13, mx = Int64Array::get(m, at = 12), my = Int64Array::get(m, at = 13))
  g_mix(st = st, a = 3, b = 4, c = 9, d = 14, mx = Int64Array::get(m, at = 14), my = Int64Array::get(m, at = 15))
}

/// dst[i] = src[MSG_PERMUTATION[i]] with
/// MSG_PERMUTATION = [2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8].
fn permute_words(src: Array[Int], dst: Array[Int]) -> Unit {
  Int64Array::set(dst, at = 0, value = Int64Array::get(src, at = 2))
  Int64Array::set(dst, at = 1, value = Int64Array::get(src, at = 6))
  Int64Array::set(dst, at = 2, value = Int64Array::get(src, at = 3))
  Int64Array::set(dst, at = 3, value = Int64Array::get(src, at = 10))
  Int64Array::set(dst, at = 4, value = Int64Array::get(src, at = 7))
  Int64Array::set(dst, at = 5, value = Int64Array::get(src, at = 0))
  Int64Array::set(dst, at = 6, value = Int64Array::get(src, at = 4))
  Int64Array::set(dst, at = 7, value = Int64Array::get(src, at = 13))
  Int64Array::set(dst, at = 8, value = Int64Array::get(src, at = 1))
  Int64Array::set(dst, at = 9, value = Int64Array::get(src, at = 11))
  Int64Array::set(dst, at = 10, value = Int64Array::get(src, at = 12))
  Int64Array::set(dst, at = 11, value = Int64Array::get(src, at = 5))
  Int64Array::set(dst, at = 12, value = Int64Array::get(src, at = 9))
  Int64Array::set(dst, at = 13, value = Int64Array::get(src, at = 14))
  Int64Array::set(dst, at = 14, value = Int64Array::get(src, at = 15))
  Int64Array::set(dst, at = 15, value = Int64Array::get(src, at = 8))
}

/// Full 7-round compression into `sc.st` (allocation-free: all working
/// arrays live in `sc`). `block` may alias `sc.block` — it is only read
/// before the first round writes to `sc.m1`. Callers read the result out
/// of `sc.st` (first 8 words = chaining value, all 16 for root output).
fn compress_into(sc: Scratch, cv: Array[Int], block: Array[Int], counter: Int, blen: Int, flags: Int) -> Unit {
  let st = sc.st
  let mut i = 0
  while i < 8 {
    Int64Array::set(st, at = i, value = Int64Array::get(cv, at = i))
    i = i + 1
  }
  Int64Array::set(st, at = 8, value = iv0)
  Int64Array::set(st, at = 9, value = iv1)
  Int64Array::set(st, at = 10, value = iv2)
  Int64Array::set(st, at = 11, value = iv3)
  Int64Array::set(st, at = 12, value = counter&mask32)
  Int64Array::set(st, at = 13, value = (counter>>32)&mask32)
  Int64Array::set(st, at = 14, value = blen)
  Int64Array::set(st, at = 15, value = flags)
  let m1 = sc.m1
  let m2 = sc.m2
  let mut j = 0
  while j < 16 {
    Int64Array::set(m1, at = j, value = Int64Array::get(block, at = j))
    j = j + 1
  }
  round_mix(st = st, m = m1)
  permute_words(src = m1, dst = m2)
  round_mix(st = st, m = m2)
  permute_words(src = m2, dst = m1)
  round_mix(st = st, m = m1)
  permute_words(src = m1, dst = m2)
  round_mix(st = st, m = m2)
  permute_words(src = m2, dst = m1)
  round_mix(st = st, m = m1)
  permute_words(src = m1, dst = m2)
  round_mix(st = st, m = m2)
  permute_words(src = m2, dst = m1)
  round_mix(st = st, m = m1)
  let mut k = 0
  while k < 8 {
    Int64Array::set(st, at = k, value = Int64Array::get(st, at = k)^Int64Array::get(st, at = k + 8))
    Int64Array::set(st, at = k + 8, value = Int64Array::get(st, at = k + 8)^Int64Array::get(cv, at = k))
    k = k + 1
  }
}

/// Copy the chaining value (first 8 words of `sc.st`) into `cv` in place.
fn copy_cv(sc: Scratch, cv: Array[Int]) -> Unit {
  let mut i = 0
  while i < 8 {
    Int64Array::set(cv, at = i, value = Int64Array::get(sc.st, at = i))
    i = i + 1
  }
}

//# Tree hashing

/// A deferred final compression: everything `compress_into` needs, minus the
/// ROOT flag decision (the same node is compressed once as a chaining value
/// or once with ROOT to produce the digest). `cv` and `block` are owned by
/// the Output (never aliased into a Scratch), so they survive across the
/// sibling subtree's compressions.
struct Output {
  cv: Array[Int];
  block: Array[Int];
  counter: Int;
  blen: Int;
  flags: Int
}

/// Read one 64-byte block at `block_start` into `w` (16 little-endian
/// words), zero-padding past `data_end`.
fn block_words_into(w: Array[Int], data: Bytes, block_start: Int, data_end: Int) -> Unit {
  let mut i = 0
  while i < 16 {
    let off = block_start + i * 4
    let b0 = if off < data_end {
      Bytes::get(data, at = off)
    } else {
      0
    }
    let b1 = if off + 1 < data_end {
      Bytes::get(data, at = off + 1)
    } else {
      0
    }
    let b2 = if off + 2 < data_end {
      Bytes::get(data, at = off + 2)
    } else {
      0
    }
    let b3 = if off + 3 < data_end {
      Bytes::get(data, at = off + 3)
    } else {
      0
    }
    Int64Array::set(w, at = i, value = (b0|(b1<<8))|((b2<<16)|(b3<<24)))
    i = i + 1
  }
}

/// Hash one <= 1024-byte chunk down to its deferred last-block compression.
/// Only the chunk's own `cv` (8 words) and the deferred last block
/// (16 words) are allocated; every intermediate block compresses through
/// `sc.block`/`sc.st`.
fn chunk_output(sc: Scratch, data: Bytes, start: Int, len: Int, counter: Int) -> Output {
  let num_blocks = if len == 0 {
    1
  } else {
    (len + 63) / 64
  }
  let cv = iv_words()
  let mut b = 0
  while b < num_blocks - 1 {
    let flags = if b == 0 {
      flag_chunk_start
    } else {
      0
    }
    block_words_into(w = sc.block, data = data, block_start = start + b * 64, data_end = start + len)
    compress_into(sc = sc, cv = cv, block = sc.block, counter = counter, blen = block_len_max, flags = flags)
    copy_cv(sc = sc, cv = cv)
    b = b + 1
  }
  let last_start = start + (num_blocks - 1) * 64
  let last_len = len - (num_blocks - 1) * 64
  let start_flag = if num_blocks == 1 {
    flag_chunk_start
  } else {
    0
  }
  let last_block = Int64Array::make(16, value = 0)
  block_words_into(w = last_block, data = data, block_start = last_start, data_end = start + len)
  Output::{
    cv: cv,
    block: last_block,
    counter: counter,
    blen: last_len,
    flags: start_flag|flag_chunk_end
  }
}

/// Finalize an Output as a chaining value. The Output is consumed: its own
/// `cv` array is overwritten with the result and returned (no allocation).
fn chaining_value(sc: Scratch, o: Output) -> Array[Int] {
  compress_into(sc = sc, cv = o.cv, block = o.block, counter = o.counter, blen = o.blen, flags = o.flags)
  copy_cv(sc = sc, cv = o.cv)
  o.cv
}

fn parent_output(left_cv: Array[Int], right_cv: Array[Int]) -> Output {
  let block = Int64Array::make(16, value = 0)
  let mut i = 0
  while i < 8 {
    Int64Array::set(block, at = i, value = Int64Array::get(left_cv, at = i))
    Int64Array::set(block, at = i + 8, value = Int64Array::get(right_cv, at = i))
    i = i + 1
  }
  Output::{
    cv: iv_words(),
    block: block,
    counter: 0,
    blen: block_len_max,
    flags: flag_parent
  }
}

/// Recursive subtree hash. The left subtree takes the largest power-of-two
/// number of chunks strictly less than the subtree's total (BLAKE3 spec
/// tree shape), so `left_chunks` below is largest_pow2(<= (len-1)/1024).
fn subtree_output(sc: Scratch, data: Bytes, start: Int, len: Int, chunk_counter: Int) -> Output {
  if len <= chunk_len {
    chunk_output(sc = sc, data = data, start = start, len = len, counter = chunk_counter)
  } else {
    let full_chunks = (len - 1) / chunk_len
    let mut left_chunks = 1
    while left_chunks * 2 <= full_chunks {
      left_chunks = left_chunks * 2
    }
    let left_len = left_chunks * chunk_len
    let left_cv = chaining_value(sc = sc, o = subtree_output(sc = sc, data = data, start = start, len = left_len, chunk_counter = chunk_counter))
    let right_cv = chaining_value(sc = sc, o = subtree_output(sc = sc, data = data, start = start + left_len, len = len - left_len, chunk_counter = chunk_counter + left_chunks))
    parent_output(left_cv = left_cv, right_cv = right_cv)
  }
}

//# Digest formatting

fn hex_digit(_ d: Int) -> Int {
  if d < 10 {
    48 + d
  } else {
    87 + d
  }
}

fn push_byte_hex(sb: StringBuilder, b: Int) -> Unit {
  StringBuilder::push(sb, value = String::from_char_code(hex_digit((b>>4)&15)))
  StringBuilder::push(sb, value = String::from_char_code(hex_digit(b&15)))
}

/// Final ROOT compression -> 64-char little-endian hex of the 256-bit digest.
fn root_hex(sc: Scratch, o: Output) -> String {
  compress_into(sc = sc, cv = o.cv, block = o.block, counter = 0, blen = o.blen, flags = o.flags|flag_root)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < 8 {
    let w = Int64Array::get(sc.st, at = i)
    push_byte_hex(sb = sb, b = w&255)
    push_byte_hex(sb = sb, b = (w>>8)&255)
    push_byte_hex(sb = sb, b = (w>>16)&255)
    push_byte_hex(sb = sb, b = (w>>24)&255)
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

//# Public API

/// BLAKE3 digest of a byte buffer, as 64 hex chars.
export fn blake3_bytes(_ data: Bytes) -> String {
  let sc = new_scratch()
  root_hex(sc = sc, o = subtree_output(sc = sc, data = data, start = 0, len = Bytes::length(data), chunk_counter = 0))
}

/// BLAKE3 digest of a string, as 64 hex chars. Char codes are taken mod 256
/// (byte-oriented input, same convention as @vibe/core sha1). The byte
/// buffer is pre-sized (`Bytes::new(len)` + set) so the conversion is one
/// allocation, not a push-growth doubling tower.
export fn blake3(_ msg: String) -> String {
  let len = String::length(msg)
  let data = Bytes::new(len)
  let mut i = 0
  while i < len {
    Bytes::set(data, at = i, value = String::char_code_at(msg, at = i)&255)
    i = i + 1
  }
  blake3_bytes(data)
}
