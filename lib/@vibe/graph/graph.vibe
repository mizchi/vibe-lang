//# Types

// RippleDb is the selfhost compiler's incremental module DB: it maps module
// path -> source, path -> fingerprint, and path -> dependency list.
//
// Previously each map was a flat association array (`Array[(String, _)]`):
// every lookup was O(n) and every upsert rebuilt the whole array O(n), so
// threading the DB through N modules was O(N^2) time AND allocations (matching
// the alloc-bound compile profile from moon-pprof). This replaces them with
// fixed-bucket hash maps: hash the path to one of NBUCKETS buckets and scan
// only that (small) bucket. Lookup/insert are O(1) amortized, so a full
// N-module compile is O(N).
//
// The maps mutate their buckets in place, so the DB is *linear*: callers must
// use the returned db and discard the old one. The selfhost compiler always
// threads `next_db`, so this is safe. eval_count lives in a 1-element array so
// it is bumped without rebuilding the enum payload.

//# Values

//# Types

export enum StrMap {
  StrMap(Array[Array[(String, String)]])
}

export enum DepsMap {
  DepsMap(Array[Array[(String, Array[String])]])
}

export enum RippleDb {
  RippleDb(StrMap, StrMap, DepsMap, Array[Int])
}

//# Functions

fn nbuckets() -> Int {
  256
}

fn bucket_mask() -> Int {
  255
}

/// FNV-1a-style string hash, masked to a non-negative bucket index. NBUCKETS is
/// a power of two so we mask with `& 255` instead of `%`. Intermediate values
/// are kept within 30 bits so the multiply stays well under the 2^61 tag limit.
fn hash_bucket(key: String) -> Int {
  let len = String::length(key)
  let rec go: (Int, Int) -> Int = (i, acc) -> {
    if i >= len {
      acc
    } else {
      let c = String::char_code_at(key, i)
      let mixed = (acc^c) * 16777619
      let bounded = mixed&1073741823
      go(i + 1, bounded)
    }
  }
  let h = go(0, 2166136261&1073741823)
  h&bucket_mask()
}

fn empty_strings() -> Array[String] {
  Array::slice([
    ""
  ], 0, 0)
}

fn empty_string_pairs() -> Array[(String, String)] {
  Array::slice([
    ("", "")
  ], 0, 0)
}

fn empty_deps_pairs() -> Array[(String, Array[String])] {
  Array::slice([
    ("", empty_strings())
  ], 0, 0)
}

/// Build a bucket array of NBUCKETS DISTINCT empty assoc arrays. (Array::make
/// would alias one array across every slot, so push fresh empties instead.)
fn new_string_buckets() -> Array[Array[(String, String)]] {
  let n = nbuckets()
  let b = ArrayBuilder::new()
  let rec go: (Int) -> Unit = (i) -> {
    if i >= n {
      ()
    } else {
      ArrayBuilder::push(b, empty_string_pairs())
      go(i + 1)
    }
  }
  go(0)
  ArrayBuilder::freeze(b)
}

fn new_deps_buckets() -> Array[Array[(String, Array[String])]] {
  let n = nbuckets()
  let b = ArrayBuilder::new()
  let rec go: (Int) -> Unit = (i) -> {
    if i >= n {
      ()
    } else {
      ArrayBuilder::push(b, empty_deps_pairs())
      go(i + 1)
    }
  }
  go(0)
  ArrayBuilder::freeze(b)
}

fn strmap_new() -> StrMap {
  StrMap(new_string_buckets())
}

fn assoc_get_string(bucket: Array[(String, String)], key: String, i: Int) -> Option[String] {
  if i >= Array::length(bucket) {
    None
  } else {
    let (k, v) = Array::get(bucket, i)
    if k == key {
      Some(v)
    } else {
      assoc_get_string(bucket, key, i + 1)
    }
  }
}

fn strmap_get(m: StrMap, key: String) -> Option[String] {
  match m {
    StrMap(buckets) => {
      let idx = hash_bucket(key)
      let bucket = Array::get(buckets, idx)
      assoc_get_string(bucket, key, 0)
    }
  }
}

/// In-place upsert into the bucket for `key`.
fn strmap_set(m: StrMap, key: String, value: String) -> Unit {
  match m {
    StrMap(buckets) => {
      let idx = hash_bucket(key)
      let bucket = Array::get(buckets, idx)
      let len = Array::length(bucket)
      let rec go: (Int) -> Unit = (i) -> {
        if i >= len {
          Array::push(bucket, (key, value))
        } else {
          let (k, _) = Array::get(bucket, i)
          if k == key {
            Array::set(bucket, i, (key, value))
          } else {
            go(i + 1)
          }
        }
      }
      go(0)
    }
  }
}

fn depsmap_new() -> DepsMap {
  DepsMap(new_deps_buckets())
}

fn assoc_get_deps(bucket: Array[(String, Array[String])], key: String, i: Int) -> Option[Array[String]] {
  if i >= Array::length(bucket) {
    None
  } else {
    let (k, v) = Array::get(bucket, i)
    if k == key {
      Some(v)
    } else {
      assoc_get_deps(bucket, key, i + 1)
    }
  }
}

fn depsmap_get(m: DepsMap, key: String) -> Option[Array[String]] {
  match m {
    DepsMap(buckets) => {
      let idx = hash_bucket(key)
      let bucket = Array::get(buckets, idx)
      assoc_get_deps(bucket, key, 0)
    }
  }
}

fn depsmap_set(m: DepsMap, key: String, deps: Array[String]) -> Unit {
  match m {
    DepsMap(buckets) => {
      let idx = hash_bucket(key)
      let bucket = Array::get(buckets, idx)
      let len = Array::length(bucket)
      let rec go: (Int) -> Unit = (i) -> {
        if i >= len {
          Array::push(bucket, (key, deps))
        } else {
          let (k, _) = Array::get(bucket, i)
          if k == key {
            Array::set(bucket, i, (key, deps))
          } else {
            go(i + 1)
          }
        }
      }
      go(0)
    }
  }
}

export fn ripple_new() -> RippleDb {
  let count = ArrayBuilder::new()
  ArrayBuilder::push(count, 0)
  RippleDb(strmap_new(), strmap_new(), depsmap_new(), ArrayBuilder::freeze(count))
}

export fn ripple_get_source(db: RippleDb, path: String) -> Option[String] {
  match db {
    RippleDb(sources, _, _, _) => strmap_get(sources, path)
  }
}

export fn ripple_get_fingerprint(db: RippleDb, path: String) -> Option[String] {
  match db {
    RippleDb(_, fingerprints, _, _) => strmap_get(fingerprints, path)
  }
}

export fn ripple_get_deps(db: RippleDb, path: String) -> Option[Array[String]] {
  match db {
    RippleDb(_, _, deps_map, _) => depsmap_get(deps_map, path)
  }
}

export fn ripple_eval_count(db: RippleDb) -> Int {
  match db {
    RippleDb(_, _, _, count) => Array::get(count, 0)
  }
}

export fn ripple_set_source(db: RippleDb, path: String, source: String) -> RippleDb {
  match db {
    RippleDb(sources, _, _, _) => {
      strmap_set(sources, path, source)
      db
    }
  }
}

export fn ripple_record_eval(db: RippleDb, path: String, fingerprint: String, deps: Array[String]) -> RippleDb {
  match db {
    RippleDb(_, fingerprints, deps_map, count) => match strmap_get(fingerprints, path) {
      Some(prev_fp) => if prev_fp == fingerprint {
        db
      } else {
        strmap_set(fingerprints, path, fingerprint)
        depsmap_set(deps_map, path, deps)
        Array::set(count, 0, Array::get(count, 0) + 1)
        db
      },
      None => {
        strmap_set(fingerprints, path, fingerprint)
        depsmap_set(deps_map, path, deps)
        Array::set(count, 0, Array::get(count, 0) + 1)
        db
      }
    }
  }
}

//# Module order planning (#1239 step 4A / #906 step 4)

/// Lexicographic (char-by-char) string ordering. Deliberately NOT a builtin
/// `<`: canonical ordering must be true lexicographic, and a length-first
/// comparison would make the plan's "canonical" order depend on path length
/// (CLAUDE.md documents that exact footgun). Mirrors
/// compiler/core/sorted_index.vibe's str_lt, duplicated rather than imported
/// because @vibe/graph must not depend on the compiler package.
fn mo_str_lt(a: String, b: String) -> Bool {
  let la = String::length(a)
  let lb = String::length(b)
  let lim = if la < lb {
    la
  } else {
    lb
  }
  let mut i = 0
  let mut res = la < lb
  let mut done = false
  while i < lim && !done {
    let ca = String::char_code_at(a, i)
    let cb = String::char_code_at(b, i)
    if ca < cb {
      res = true
      done = true
    } else if ca > cb {
      res = false
      done = true
    } else {
      i = i + 1
    }
  }
  res
}

/// Index of `p` in `names`, or -1. Linear: this pass runs once per compile
/// over the module count (hundreds), not per AST node, so the O(N^2) worst
/// case is not on any hot path -- unlike the maps above, which are indexed
/// precisely because they ARE.
fn mo_index_of(names: Array[String], p: String) -> Int {
  let n = Array::length(names)
  let mut i = 0
  let mut found = -1
  while found < 0 && i < n {
    if Array::get(names, i) == p {
      found = i
    } else {
      i = i + 1
    }
  }
  found
}

/// Declared dependencies of `p`. A module with no entry in `edges` is a leaf
/// (rank 0) -- this is how unresolvable/missing imports stay terminal instead
/// of aborting the plan, matching ensure_fingerprint_fs_go's `missing:` arm.
fn mo_deps_of(edges: Array[(String, Array[String])], p: String) -> Array[String] {
  let n = Array::length(edges)
  let mut i = 0
  let out: Array[String] = [
  ]
  let mut done = false
  while !done && i < n {
    let e = Array::get(edges, i)
    if e.0 == p {
      let deps = e.1
      let dn = Array::length(deps)
      let mut j = 0
      while j < dn {
        Array::push(out, Array::get(deps, j))
        j = j + 1
      }
      done = true
    } else {
      i = i + 1
    }
  }
  out
}

/// Intern `p` into the node table, returning its id.
fn mo_intern(names: Array[String], color: Array[Int], rank: Array[Int], p: String) -> Int {
  let existing = mo_index_of(names, p)
  if existing >= 0 {
    existing
  } else {
    Array::push(names, p)
    Array::push(color, 0)
    Array::push(rank, 0)
    Array::length(names) - 1
  }
}

/// #1239 step 4A (docs/compiler-parallelism.md "Scheduling and commit" 1-2):
/// the coordinator-side upfront pass over the import DAG. Given the resolved
/// import edges and a root, it rejects import cycles and assigns every
/// reachable module a RANK -- `rank(m) = 1 + max(rank of m's dependencies)`,
/// 0 for a leaf -- then returns the modules in CANONICAL order (rank
/// ascending, then module path ascending) alongside their ranks.
///
/// Why this is the extraction #906 step 4 asked for: today
/// ensure_fingerprint_fs_go (compiler/runtime/typecheck_fs.vibe) discovers
/// cycles incidentally, mid-recursion, via the "currently visiting" stack --
/// so the cycle check, the incremental-cache short-circuits and the single
/// commit_module_outcome call site are all tangled into one sequential walk.
/// A coordinator cannot schedule from that: it needs the order BEFORE it
/// dispatches anything. This function is that "before".
///
/// Two properties make the result usable as a parallel schedule:
///
///  - **rank is a wave number**: every module of rank k depends only on
///    modules of rank < k, so an entire rank can be dispatched concurrently
///    and ranks are joined in ascending order. (It is the longest path to a
///    leaf, not the shortest -- taking the max is what makes the guarantee
///    hold transitively.)
///  - **the order is visit-order independent**: ranks come from the DAG
///    itself and the final sort breaks ties by path, so permuting dependency
///    traversal order (compiler/runtime/typecheck_fs.vibe's dep_visit_order
///    seed, the existing #906 Phase 0 nondeterminism probe) cannot change
///    this output. That is exactly the determinism the Acceptance Criteria
///    ask of `--jobs=1/2/4`, established here without needing parallelism to
///    exist yet.
///
/// Pure by construction (`Error` only, for the cycle rejection): dependency
/// RESOLUTION needs `Fs`, ordering does not. Keeping the split means the
/// ordering rule can be tested -- and modelled against
/// formal/VibeFormal/Compiler/Scheduler.lean's acyclicity and `Ready`
/// premises (#906 step 8) -- without a filesystem in the loop.
///
/// NOT yet wired into ensure_fingerprint_fs_go: that recursion still does its
/// own inline cycle check, and switching the main path over is #906 step 4(D),
/// which is blocked on a Wasmtime multi-instance host (docs/compiler-
/// parallelism.md "Runtime backend decision") -- there is no coordinator to
/// consume this order until real workers exist.
export fn plan_module_order(edges: Array[(String, Array[String])], root: String) -> (Array[String], Array[Int]) with { Error } {
  let names: Array[String] = [
  ]
  // 0 = unvisited, 1 = on the current DFS path, 2 = finished (rank final)
  let color: Array[Int] = [
  ]
  let rank: Array[Int] = [
  ]
  // Explicit stacks instead of recursion: the import DAG is as deep as the
  // deepest import chain, and this compiler has already hit wasm stack
  // exhaustion from a recursive whole-program walk (see analyze_calls's #556
  // note in compiler/perceus/perceus.vibe).
  let st_node: Array[Int] = [
  ]
  let st_cursor: Array[Int] = [
  ]
  let root_id = mo_intern(names, color, rank, root)
  Array::set(color, root_id, 1)
  Array::push(st_node, root_id)
  Array::push(st_cursor, 0)
  while Array::length(st_node) > 0 {
    let top = Array::length(st_node) - 1
    let nid = Array::get(st_node, top)
    let cursor = Array::get(st_cursor, top)
    let deps = mo_deps_of(edges, Array::get(names, nid))
    if cursor < Array::length(deps) {
      Array::set(st_cursor, top, cursor + 1)
      let dep = Array::get(deps, cursor)
      let did = mo_intern(names, color, rank, dep)
      let dcolor = Array::get(color, did)
      if dcolor == 1 {
        // Same wording as ensure_fingerprint_fs_go's inline check, so moving
        // the rejection upfront does not change the user-visible diagnostic.
        throw(String::concat("type_db: import cycle detected at ", dep))
      } else if dcolor == 0 {
        Array::set(color, did, 1)
        Array::push(st_node, did)
        Array::push(st_cursor, 0)
      } else {
        ()
      }
    } else {
      let mut r = 0
      let mut i = 0
      while i < Array::length(deps) {
        let did = mo_index_of(names, Array::get(deps, i))
        if did >= 0 {
          let dr = Array::get(rank, did) + 1
          if dr > r {
            r = dr
          } else {
            ()
          }
        } else {
          ()
        }
        i = i + 1
      }
      Array::set(rank, nid, r)
      Array::set(color, nid, 2)
      Array::truncate(st_node, top)
      Array::truncate(st_cursor, top)
    }
  }
  // Canonical order: rank ascending, then path ascending. Insertion sort --
  // the module count is small and this keeps the ordering rule obvious enough
  // to check by eye against the doc's "canonical module-path/topological
  // order" wording.
  let out_paths: Array[String] = [
  ]
  let out_ranks: Array[Int] = [
  ]
  let total = Array::length(names)
  let mut k = 0
  while k < total {
    let nm = Array::get(names, k)
    let rk = Array::get(rank, k)
    let placed = Array::length(out_paths)
    let mut pos = 0
    let mut settled = false
    while !settled && pos < placed {
      let ork = Array::get(out_ranks, pos)
      if rk < ork || (rk == ork && mo_str_lt(nm, Array::get(out_paths, pos))) {
        settled = true
      } else {
        pos = pos + 1
      }
    }
    Array::push(out_paths, "")
    Array::push(out_ranks, 0)
    let mut shift = Array::length(out_paths) - 1
    while shift > pos {
      Array::set(out_paths, shift, Array::get(out_paths, shift - 1))
      Array::set(out_ranks, shift, Array::get(out_ranks, shift - 1))
      shift = shift - 1
    }
    Array::set(out_paths, pos, nm)
    Array::set(out_ranks, pos, rk)
    k = k + 1
  }
  (out_paths, out_ranks)
}
