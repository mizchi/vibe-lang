//# Imports

import ./option.vibe {
  Option
}

//# Functions

/// #768/#778: direct-call form, not `perform <Effect>::<Op>` -- the
/// perform/effect-op codegen path for magic host effects can crash with an
/// uncaught wasm exception in a small compiled unit (see #778's fix +
/// notes). This module is exactly the kind of small, narrow-effect-surface
/// unit that pattern hits hardest (a minimal program that just prints or
/// reads stdin).
export fn stdin_read(max_bytes: Int) -> String with Stdin {
  Stdin::read_stream(max_bytes)
}

export fn ansi_escape(suffix: String) -> Unit with Stdout {
  {
    Stdout::write_char(27)
    Stdout::write_stream(suffix)
  }
}

export fn stdout_write(s: String) -> Unit with Stdout {
  Stdout::write_stream(s)
}

/// `tap` runs a side-effecting callback on a value and returns it unchanged —
/// the generic pipeline tap for printing intermediate values:
///   x |> tap((v) -> stdout_write("step: \{Int::to_string(v)}\n")) |> next
/// The callback is fixed to the concrete `Stdout` effect.
export fn tap[T](x: T, f: (v: T) -> Unit with Stdout) -> T with Stdout {
  f(x)
  x
}

/// Railway taps live here (effect-boundary), not in the pure-data
/// option module: per the prelude Effect Signature Policy a pure-data
/// module must not expose `with <row>` in its public surface.
/// `o |> tap_some((v) -> stdout_write(...)) |> next` observes the Some
/// track without leaving the pipeline.
export fn tap_some[T](opt: Option[T], f: (v: T) -> Unit with Stdout) -> Option[T] with Stdout {
  match opt {
    Some(value) => {
      f(value)
      Some(value)
    },
    _ => None
  }
}

export fn stdout_writeln(s: String) -> Unit with Stdout {
  {
    stdout_write(s)
    Stdout::write_char(10)
  }
}

export fn stdin_read_line() -> String with Stdin {
  {
    let mut acc = ""
    let mut done = false
    while not(done) {
      let c = Stdin::read_char()
      let stop = c < 0 || c == 10
      done = stop
      acc = if stop {
        acc
      } else "\{acc}\{String::from_char_code(c)}"
    }
    acc
  }
}

export fn tui_cursor_home() -> Unit with Stdout {
  ansi_escape("[H")
}

export fn tui_clear_screen() -> Unit with Stdout {
  ansi_escape("[2J")
}

export fn tui_enter_alt_screen() -> Unit with Stdout {
  ansi_escape("[?1049h")
}

export fn tui_leave_alt_screen() -> Unit with Stdout {
  ansi_escape("[?1049l")
}
