//# Imports

import ./char.vibe {
  from_int,
  from_string,
  is_ascii,
  is_ascii_alnum,
  is_ascii_alphabetic,
  is_ascii_digit,
  is_ascii_hexdigit,
  is_ascii_lowercase,
  is_ascii_uppercase,
  is_ascii_whitespace,
  to_ascii_lowercase,
  to_ascii_uppercase,
  to_int,
  to_string
}

//# Misc

test "char_ascii_classes" {
  assert(is_ascii('A'))
  match from_int(12354) {
    Some(ch) => assert(not(is_ascii(ch))),
    _ => assert(false)
  }
  assert(is_ascii_digit('0'))
  assert(not(is_ascii_digit('A')))
  assert(is_ascii_lowercase('a'))
  assert(is_ascii_uppercase('A'))
  assert(is_ascii_alphabetic('Z'))
  assert(is_ascii_alnum('9'))
  assert(is_ascii_alnum('Z'))
  assert(not(is_ascii_alnum('-')))
  assert(is_ascii_whitespace(' '))
  assert(is_ascii_whitespace('\n'))
  assert(is_ascii_hexdigit('f'))
  assert(not(is_ascii_hexdigit('g')))
}

test "char_ascii_case_convert" {
  assert(to_ascii_lowercase('A') == 'a')
  assert(to_ascii_lowercase('a') == 'a')
  assert(to_ascii_uppercase('a') == 'A')
  assert(to_ascii_uppercase('A') == 'A')
}

test "char_string_bridge" {
  assert(eq(to_int('A'), 65))
  assert(to_string('A') == "A")
  match from_int(65) {
    Some(ch) => assert(ch == 'A'),
    _ => assert(false)
  }
  match from_string("A") {
    Some(ch) => assert(ch == 'A'),
    _ => assert(false)
  }
  match from_string("") {
    None => assert(true),
    _ => assert(false)
  }
  match from_string("AB") {
    None => assert(true),
    _ => assert(false)
  }
}
