//# Types

export struct StringView {
  source: String;
  start: Int;
  end: Int
}

export struct ArrayView[T] {
  source: Array[T];
  start: Int;
  end: Int
}

//# Functions

/// Returns the clamped, ordered (lo, hi) pair as a tuple rather than an
/// anonymous `record { start, end }`: the fields `start`/`end` collide with
/// the StringView/ArrayView struct fields, and anonymous-record `.field`
/// access currently resolves the offset via the named-struct field table
/// (start@1/end@2) instead of the record's own layout (start@0/end@1), so
/// `range.start`/`range.end` read the wrong slots and produce wrong views.
/// Tuples have an unambiguous positional layout and sidestep that bug.
fn normalize_range(start: Int, end: Int, len: Int) -> (Int, Int) {
  let a0 = if start < 0 {
    0
  }
  else if start > len {
    len
  }
  else start
  let b0 = if end < 0 {
    0
  }
  else if end > len {
    len
  }
  else end
  if a0 <= b0 {
    (a0, b0)
  }
  else (b0, a0)
}

export fn from_array_range[T](source: Array[T], start: Int, end: Int) -> ArrayView[T] {
  let len = Array::length(source)
  let (r_start, r_end) = normalize_range(start, end, len)
  ArrayView::{
    source: source,
    start: r_start,
    end: r_end
  }
}

export fn from_array[T](source: Array[T]) -> ArrayView[T] {
  from_array_range(source, 0, Array::length(source))
}

export fn from_string_range(source: String, start: Int, end: Int) -> StringView {
  let len = String::length(source)
  let (r_start, r_end) = normalize_range(start, end, len)
  StringView::{
    source: source,
    start: r_start,
    end: r_end
  }
}

export fn from_string(source: String) -> StringView {
  from_string_range(source, 0, String::length(source))
}

export fn ArrayView::data[T](view: ArrayView[T]) -> Array[T] {
  view.source
}

export fn ArrayView::view[T](view: ArrayView[T], start: Int, end: Int) -> ArrayView[T] {
  from_array_range(view.source, view.start + start, view.start + end)
}

export fn StringView::data(view: StringView) -> String {
  view.source
}

export fn StringView::view(view: StringView, start: Int, end: Int) -> StringView {
  from_string_range(view.source, view.start + start, view.start + end)
}

export fn ArrayView::length[T](view: ArrayView[T]) -> Int {
  view.end - view.start
}

export fn ArrayView::get[T](view: ArrayView[T], index: Int) -> Option[T] {
  let len = ArrayView::length(view)
  if index < 0 || index >= len {
    None
  }
  else Some(Array::get(view.source, view.start + index))
}

export fn StringView::length(view: StringView) -> Int {
  view.end - view.start
}

export fn StringView::get(view: StringView, index: Int) -> Option[String] {
  let len = StringView::length(view)
  if index < 0 || index >= len {
    None
  }
  else {
    let pos = view.start + index
    Some(view.source[pos: pos + 1])
  }
}

export fn ArrayView::is_empty[T](view: ArrayView[T]) -> Bool {
  ArrayView::length(view) == 0
}

export fn ArrayView::to_array[T](view: ArrayView[T]) -> Array[T] {
  view.source[view.start: view.end]
}

export fn StringView::contains(view: StringView, needle: String) -> Bool {
  let vlen = view.end - view.start
  let nlen = String::length(needle)
  if nlen == 0 {
    true
  }
  else if nlen > vlen {
    false
  }
  else {
    let mut i = 0
    let mut found = false
    while i <= vlen - nlen && !found {
      let mut j = 0
      let mut ok = true
      while j < nlen && ok {
        if String::char_code_at(view.source, view.start + i + j) != String::char_code_at(needle, j) {
          ok = false
        }
        j = j + 1
      }
      if ok {
        found = true
      }
      i = i + 1
    }
    found
  }
}

export fn StringView::index_of(view: StringView, needle: String) -> Int {
  let vlen = view.end - view.start
  let nlen = String::length(needle)
  if nlen == 0 {
    0
  }
  else if nlen > vlen {
    0 - 1
  }
  else {
    let mut i = 0
    let mut result = 0 - 1
    while i <= vlen - nlen && result < 0 {
      let mut j = 0
      let mut ok = true
      while j < nlen && ok {
        if String::char_code_at(view.source, view.start + i + j) != String::char_code_at(needle, j) {
          ok = false
        }
        j = j + 1
      }
      if ok {
        result = i
      }
      i = i + 1
    }
    result
  }
}

export fn StringView::is_empty(view: StringView) -> Bool {
  StringView::length(view) == 0
}

export fn StringView::to_string(view: StringView) -> String {
  view.source[view.start: view.end]
}

export fn StringView::has_prefix(view: StringView, prefix: String) -> Bool {
  let vlen = view.end - view.start
  let plen = String::length(prefix)
  if plen > vlen {
    false
  }
  else {
    let mut i = 0
    let mut ok = true
    while i < plen && ok {
      if String::char_code_at(view.source, view.start + i) != String::char_code_at(prefix, i) {
        ok = false
      }
      i = i + 1
    }
    ok
  }
}

export fn StringView::has_suffix(view: StringView, suffix: String) -> Bool {
  let vlen = view.end - view.start
  let slen = String::length(suffix)
  if slen > vlen {
    false
  }
  else {
    let offset = vlen - slen
    let mut i = 0
    let mut ok = true
    while i < slen && ok {
      if String::char_code_at(view.source, view.start + offset + i) != String::char_code_at(suffix, i) {
        ok = false
      }
      i = i + 1
    }
    ok
  }
}

export fn ArrayView::start_offset[T](view: ArrayView[T]) -> Int {
  view.start
}

export fn StringView::char_code_at(view: StringView, index: Int) -> Int {
  String::char_code_at(view.source, view.start + index)
}

export fn StringView::start_offset(view: StringView) -> Int {
  view.start
}
