//# Functions

export fn minmax(a: Int, b: Int) -> (Int, Int) {
  if a <= b {
    (a, b)
  } else (b, a)
}

export fn maximum(a: Int, b: Int) -> Int {
  if a > b {
    a
  } else b
}

export fn minimum(a: Int, b: Int) -> Int {
  if a < b {
    a
  } else b
}

export fn minmax_by[T](a: T, b: T, compare: (x: T, y: T) -> Int) -> (T, T) {
  if compare(a, b) <= 0 {
    (a, b)
  } else (b, a)
}

export fn maximum_by[T](a: T, b: T, compare: (x: T, y: T) -> Int) -> T {
  if compare(a, b) >= 0 {
    a
  } else b
}

export fn minimum_by[T](a: T, b: T, compare: (x: T, y: T) -> Int) -> T {
  if compare(a, b) <= 0 {
    a
  } else b
}

export fn int_compare(a: Int, b: Int) -> Int {
  if a < b {
    -1
  }
  else if a > b {
    1
  }
  else 0
}

export fn float_compare(a: Float, b: Float) -> Int {
  if a < b {
    -1
  }
  else if a > b {
    1
  }
  else 0
}

export fn minmax_by_key[T, K](a: T, b: T, key: (x: T) -> K, compare_key: (x: K, y: K) -> Int) -> (T, T) {
  minmax_by(a, b, (x: T, y: T) -> Int {
    compare_key(key(x), key(y))
  })
}

export fn double_compare(a: Double, b: Double) -> Int {
  if a < b {
    -1
  }
  else if a > b {
    1
  }
  else 0
}

export fn maximum_by_key[T, K](a: T, b: T, key: (x: T) -> K, compare_key: (x: K, y: K) -> Int) -> T {
  maximum_by(a, b, (x: T, y: T) -> Int {
    compare_key(key(x), key(y))
  })
}

export fn minimum_by_key[T, K](a: T, b: T, key: (x: T) -> K, compare_key: (x: K, y: K) -> Int) -> T {
  minimum_by(a, b, (x: T, y: T) -> Int {
    compare_key(key(x), key(y))
  })
}

/// Byte-wise lexicographic comparison normalized to -1, 0, or 1.
export fn string_compare(a: String, b: String) -> Int {
  if a < b {
    -1
  } else if a > b {
    1
  } else 0
}
