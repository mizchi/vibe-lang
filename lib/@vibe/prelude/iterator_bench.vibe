import ./iterator.vibe {
  Iterator::fold
}

fn sample_map() -> Map[String, Int] {
  map {
    "k00": 0,
    "k01": 1,
    "k02": 2,
    "k03": 3,
    "k04": 4,
    "k05": 5,
    "k06": 6,
    "k07": 7,
    "k08": 8,
    "k09": 9,
    "k10": 10,
    "k11": 11,
    "k12": 12,
    "k13": 13,
    "k14": 14,
    "k15": 15
  }
}

let mut sink = 0

bench "map_iterable_fold_16" {
  let m = sample_map()
  sink = sink + Iterator::fold(m, 0, (acc: Int, k: String) -> Int {
    acc + Map::get(m, k)
  })
}

bench "map_keys_fold_16" {
  let m = sample_map()
  let keys = Map::keys(m)
  sink = sink + Iterator::fold(keys, 0, (acc: Int, k: String) -> Int {
    acc + Map::get(m, k)
  })
}
