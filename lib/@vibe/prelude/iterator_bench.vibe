import ./iterator.vibe {
  Iterator::fold
}

fn sample_map() -> Map[String, Int] {
  Map::from_pairs([
    ("k00", 0),
    ("k01", 1),
    ("k02", 2),
    ("k03", 3),
    ("k04", 4),
    ("k05", 5),
    ("k06", 6),
    ("k07", 7),
    ("k08", 8),
    ("k09", 9),
    ("k10", 10),
    ("k11", 11),
    ("k12", 12),
    ("k13", 13),
    ("k14", 14),
    ("k15", 15)
  ])
}

/// DCE/const-fold sink. Top-level `let mut` is rejected since ADR-0069
/// (top level = declarations only), so each bench block sinks its fold result
/// into a local one-slot array instead of a shared top-level mut binding.
bench "map_iterable_fold_16" {
  let m = sample_map()
  let total = Iterator::fold(m, 0, (acc: Int, k: String) -> Int {
    acc + Map::get(m, k)
  })
  let sink = [0]
  Array::set(sink, 0, Array::get(sink, 0) + total)
}

bench "map_keys_fold_16" {
  let m = sample_map()
  let keys = Map::keys(m)
  let total = Iterator::fold(keys, 0, (acc: Int, k: String) -> Int {
    acc + Map::get(m, k)
  })
  let sink = [0]
  Array::set(sink, 0, Array::get(sink, 0) + total)
}
