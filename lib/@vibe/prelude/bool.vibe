//# Functions

// Compiler-provided intrinsic type explicitly published by this module.
export {
  Bool
}

export fn bool_nor(a: Bool, b: Bool) -> Bool {
  not(a || b)
}

export fn nor(a: Bool, b: Bool) -> Bool {
  bool_nor(a, b)
}

export fn bool_xor(a: Bool, b: Bool) -> Bool {
  if a {
    not(b)
  } else b
}

export fn xor(a: Bool, b: Bool) -> Bool {
  bool_xor(a, b)
}

export fn bool_all3(a: Bool, b: Bool, c: Bool) -> Bool {
  a && b && c
}

export fn all3(a: Bool, b: Bool, c: Bool) -> Bool {
  bool_all3(a, b, c)
}

export fn bool_any3(a: Bool, b: Bool, c: Bool) -> Bool {
  a || b || c
}

export fn any3(a: Bool, b: Bool, c: Bool) -> Bool {
  bool_any3(a, b, c)
}

export fn bool_nand(a: Bool, b: Bool) -> Bool {
  not(a && b)
}

export fn nand(a: Bool, b: Bool) -> Bool {
  bool_nand(a, b)
}

export fn bool_to_int(b: Bool) -> Int {
  if b {
    1
  } else 0
}

export fn to_int(b: Bool) -> Int {
  bool_to_int(b)
}

export fn int_to_bool(n: Int) -> Bool {
  n != 0
}

export fn from_int(n: Int) -> Bool {
  int_to_bool(n)
}

export fn bool_implies(a: Bool, b: Bool) -> Bool {
  if a {
    b
  } else true
}

export fn implies(a: Bool, b: Bool) -> Bool {
  bool_implies(a, b)
}

export fn Bool::nor(a: Bool, b: Bool) -> Bool {
  bool_nor(a, b)
}

export fn Bool::xor(a: Bool, b: Bool) -> Bool {
  bool_xor(a, b)
}

export fn Bool::all3(a: Bool, b: Bool, c: Bool) -> Bool {
  bool_all3(a, b, c)
}

export fn Bool::any3(a: Bool, b: Bool, c: Bool) -> Bool {
  bool_any3(a, b, c)
}

export fn Bool::nand(a: Bool, b: Bool) -> Bool {
  bool_nand(a, b)
}

export fn Bool::to_int(b: Bool) -> Int {
  bool_to_int(b)
}

export fn Bool::implies(a: Bool, b: Bool) -> Bool {
  bool_implies(a, b)
}
