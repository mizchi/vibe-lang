//# Functions

// Compiler-provided intrinsic type explicitly published by this module.
export {
  Float
}

fn float_eq(a: Float, b: Float) -> Bool {
  a == b
}

export let eq: (Float, Float) -> Bool = float_eq

fn float_abs(x: Float) -> Float {
  if x < 0.0f {
    0.0f - x
  } else x
}

export let abs: (Float) -> Float = float_abs

fn float_max(a: Float, b: Float) -> Float {
  if a > b {
    a
  } else b
}

export let max: (Float, Float) -> Float = float_max

fn float_min(a: Float, b: Float) -> Float {
  if a < b {
    a
  } else b
}

export let min: (Float, Float) -> Float = float_min

fn float_lerp(a: Float, b: Float, t: Float) -> Float {
  a + (b - a) * t
}

export let lerp: (Float, Float, Float) -> Float = float_lerp

fn float_clamp(x: Float, min_val: Float, max_val: Float) -> Float {
  if x < min_val {
    min_val
  }
  else if x > max_val {
    max_val
  }
  else x
}

export let clamp: (Float, Float, Float) -> Float = float_clamp

fn float_is_nan(x: Float) -> Bool {
  not(x == x)
}

export let is_nan: (Float) -> Bool = float_is_nan

fn float_signum(x: Float) -> Float {
  if x < 0.0f {
    0.0f - 1.0f
  }
  else if x > 0.0f {
    1.0f
  }
  else 0.0f
}

export let signum: (Float) -> Float = float_signum

fn float_square(x: Float) -> Float {
  x * x
}

export let square: (Float) -> Float = float_square

fn float_is_zero(x: Float) -> Bool {
  x == 0.0f
}

export let is_zero: (Float) -> Bool = float_is_zero

fn float_is_negative(x: Float) -> Bool {
  x < 0.0f
}

export let is_negative: (Float) -> Bool = float_is_negative

fn float_is_positive(x: Float) -> Bool {
  x > 0.0f
}

export let is_positive: (Float) -> Bool = float_is_positive

export fn Float::eq(a: Float, b: Float) -> Bool {
  float_eq(a, b)
}

export fn Float::abs(x: Float) -> Float {
  float_abs(x)
}

export fn Float::max(a: Float, b: Float) -> Float {
  float_max(a, b)
}

export fn Float::min(a: Float, b: Float) -> Float {
  float_min(a, b)
}

export fn Float::lerp(a: Float, b: Float, t: Float) -> Float {
  float_lerp(a, b, t)
}

export fn Float::clamp(x: Float, min_val: Float, max_val: Float) -> Float {
  float_clamp(x, min_val, max_val)
}

export fn Float::is_nan(x: Float) -> Bool {
  float_is_nan(x)
}

export fn Float::signum(x: Float) -> Float {
  float_signum(x)
}

export fn Float::square(x: Float) -> Float {
  float_square(x)
}

export fn Float::is_zero(x: Float) -> Bool {
  float_is_zero(x)
}

export fn Float::is_negative(x: Float) -> Bool {
  float_is_negative(x)
}

export fn Float::is_positive(x: Float) -> Bool {
  float_is_positive(x)
}
