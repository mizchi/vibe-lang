//# Types

export enum Result[T, E] {
  Ok(T);
  Err(E)
}

//# Functions

export fn ok[T, E](res: Result[T, E]) -> Option[T] {
  match res {
    Ok(value) => Some(value),
    _ => None
  }
}

export fn err[T, E](res: Result[T, E]) -> Option[E] {
  match res {
    Err(value) => Some(value),
    _ => None
  }
}

export fn bind[T, E, U](res: Result[T, E], f: (x: T) -> Result[U, E]) -> Result[U, E] {
  match res {
    Ok(value) => f(value),
    Err(e) => Err(e)
  }
}

export fn is_ok[T, E](res: Result[T, E]) -> Bool {
  res is Ok(_)
}

export fn is_err[T, E](res: Result[T, E]) -> Bool {
  not(is_ok(res))
}

export fn map_ok[T, E, U](res: Result[T, E], f: (x: T) -> U) -> Result[U, E] {
  match res {
    Ok(value) => Ok(f(value)),
    Err(e) => Err(e)
  }
}

export fn map_or[T, E, U](res: Result[T, E], default: U, f: (x: T) -> U) -> U {
  match res {
    Ok(value) => f(value),
    _ => default
  }
}

export fn flatten[T, E](res: Result[Result[T, E], E]) -> Result[T, E] {
  match res {
    Ok(inner) => inner,
    Err(e) => Err(e)
  }
}

export fn map_err[T, E, F](res: Result[T, E], f: (e: E) -> F) -> Result[T, F] {
  match res {
    Ok(value) => Ok(value),
    Err(e) => Err(f(e))
  }
}

export fn and_then[T, E, U](res: Result[T, E], f: (x: T) -> Result[U, E]) -> Result[U, E] {
  bind(res, f)
}

export fn equals_by[T, E](a: Result[T, E], b: Result[T, E], ok_eq: (x: T, y: T) -> Bool, err_eq: (x: E, y: E) -> Bool) -> Bool {
  match (a, b) {
    (Ok(x), Ok(y)) => ok_eq(x, y),
    (Err(x), Err(y)) => err_eq(x, y),
    _ => false
  }
}

export fn to_option[T, E](res: Result[T, E]) -> Option[T] {
  ok(res)
}

export fn unwrap_or[T, E](res: Result[T, E], default: T) -> T {
  match res {
    Ok(value) => value,
    _ => default
  }
}

export fn or[T, E](res: Result[T, E], default: T) -> T {
  unwrap_or(res, default)
}

export fn from_option[T, E](opt: Option[T], err_value: E) -> Result[T, E] {
  match opt {
    Some(value) => Ok(value),
    _ => Err(err_value)
  }
}

export fn unwrap_or_else[T, E](res: Result[T, E], fallback: () -> T) -> T {
  match res {
    Ok(value) => value,
    _ => fallback()
  }
}

export fn or_else[T, E](res: Result[T, E], fallback: () -> T) -> T {
  unwrap_or_else(res, fallback)
}

export fn Result::ok[T, E](res: Result[T, E]) -> Option[T] {
  ok(res)
}

export fn Result::or[T, E](res: Result[T, E], default: T) -> T {
  or(res, default)
}

export fn Result::err[T, E](res: Result[T, E]) -> Option[E] {
  err(res)
}

export fn Result::bind[T, E, U](res: Result[T, E], f: (x: T) -> Result[U, E]) -> Result[U, E] {
  bind(res, f)
}

export fn Result::is_ok[T, E](res: Result[T, E]) -> Bool {
  is_ok(res)
}

export fn Result::is_err[T, E](res: Result[T, E]) -> Bool {
  is_err(res)
}

export fn Result::map_ok[T, E, U](res: Result[T, E], f: (x: T) -> U) -> Result[U, E] {
  map_ok(res, f)
}

export fn Result::map_or[T, E, U](res: Result[T, E], default: U, f: (x: T) -> U) -> U {
  map_or(res, default, f)
}

export fn Result::flatten[T, E](res: Result[Result[T, E], E]) -> Result[T, E] {
  flatten(res)
}

export fn Result::map_err[T, E, F](res: Result[T, E], f: (e: E) -> F) -> Result[T, F] {
  map_err(res, f)
}

export fn Result::or_else[T, E](res: Result[T, E], fallback: () -> T) -> T {
  or_else(res, fallback)
}

export fn Result::and_then[T, E, U](res: Result[T, E], f: (x: T) -> Result[U, E]) -> Result[U, E] {
  and_then(res, f)
}

export fn Result::equals_by[T, E](a: Result[T, E], b: Result[T, E], ok_eq: (x: T, y: T) -> Bool, err_eq: (x: E, y: E) -> Bool) -> Bool {
  equals_by(a, b, ok_eq, err_eq)
}

export fn Result::to_option[T, E](res: Result[T, E]) -> Option[T] {
  to_option(res)
}

export fn Result::unwrap_or[T, E](res: Result[T, E], default: T) -> T {
  unwrap_or(res, default)
}

export fn Result::unwrap_or_else[T, E](res: Result[T, E], fallback: () -> T) -> T {
  unwrap_or_else(res, fallback)
}
