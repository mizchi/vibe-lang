fn is_positive(x: Int) -> Bool
fn Int::abs(x: Int) -> Int
fn abs(x: Int) -> Int
fn gcd(a: Int, b: Int) -> Int
fn lcm(a: Int, b: Int) -> Int
fn Int::gcd(a: Int, b: Int) -> Int
fn Int::lcm(a: Int, b: Int) -> Int
fn Int::max(a: Int, b: Int) -> Int
fn max(a: Int, b: Int) -> Int
fn Int::min(a: Int, b: Int) -> Int
fn min(a: Int, b: Int) -> Int
fn Int::pow(base: Int, exp: Int) -> Int
fn Int::clamp(x: Int, min_val: Int, max_val: Int) -> Int
fn clamp(x: Int, min_val: Int, max_val: Int) -> Int
fn Int::is_odd(x: Int) -> Bool
fn is_odd(x: Int) -> Bool
fn Int::signum(x: Int) -> Int
fn signum(x: Int) -> Int
fn Int::is_even(x: Int) -> Bool
fn is_even(x: Int) -> Bool
fn Int::is_zero(x: Int) -> Bool
