// bare by int.vibe (and abs/max/min/clamp/signum ALSO by double.vibe) —
// none of these bare Float forms were ever in the OLD facade's re-export
// list (only `lerp`/`square` were), so Int's bare fn (or, for square/lerp,
// nothing else) is kept as the sole bare owner and these stay declared only
// as `Float::name` below; the plain-named `.vibe` def is still legal (name-
// covered by Int's same-named bare decl) but not part of THIS package's
// external bare-name surface. See header comment.
let eq: (Float, Float) -> Bool
let lerp: (Float, Float, Float) -> Float
let is_nan: (Float) -> Bool
