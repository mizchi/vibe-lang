fn ArrayView::get[T](view: ArrayView[T], index: Int) -> Option[T]
fn StringView::length(view: StringView) -> Int
fn StringView::get(view: StringView, index: Int) -> Option[String]
fn ArrayView::is_empty[T](view: ArrayView[T]) -> Bool
fn ArrayView::to_array[T](view: ArrayView[T]) -> Array[T]
fn StringView::contains(view: StringView, needle: String) -> Bool
fn StringView::index_of(view: StringView, needle: String) -> Int
fn StringView::is_empty(view: StringView) -> Bool
fn StringView::to_string(view: StringView) -> String
fn StringView::has_prefix(view: StringView, prefix: String) -> Bool
fn StringView::has_suffix(view: StringView, suffix: String) -> Bool
fn ArrayView::start_offset[T](view: ArrayView[T]) -> Int
fn StringView::char_code_at(view: StringView, index: Int) -> Int
fn StringView::start_offset(view: StringView) -> Int

// --- io (checker-builtin Stdin/Stdout effects, no import needed — see
// checker/builtins_system.vibe)
fn stdin_read(max_bytes: Int) -> String with { Stdin }
fn ansi_escape(suffix: String) -> Unit with { Stdout }
fn stdout_write(s: String) -> Unit with { Stdout }
fn tap[T](x: T, f: (v: T) -> Unit with { Stdout }) -> T with { Stdout }
fn tap_some[T](opt: Option[T], f: (v: T) -> Unit with { Stdout }) -> Option[T] with { Stdout }
fn stdout_writeln(s: String) -> Unit with { Stdout }
fn stdin_read_line() -> String with { Stdin }
fn tui_cursor_home() -> Unit with { Stdout }
fn tui_clear_screen() -> Unit with { Stdout }
fn tui_enter_alt_screen() -> Unit with { Stdout }
fn tui_leave_alt_screen() -> Unit with { Stdout }

// --- string_parser. `or_else` also collides with option.vibe's bare
// `or_else` (Option wins that name, see the option.vibe section comment
// above) — string_parser's own `or_else[T](Parser,Parser)->Parser` is not
// part of this package's bare-name surface (it never was under the OLD
// facade either). `and_then` stays declared bare here.
fn map[A, B](parser: Parser[A], f: (x: A) -> B) -> Parser[B]
fn run[T](parser: Parser[T], input: String) -> Option[T]
fn char(expected: String) -> Parser[String]
fn fail[T]() -> Parser[T]
fn pure[T](value: T) -> Parser[T]
fn literal(expected: String) -> Parser[String]
fn and_then[A, B](parser: Parser[A], f: (x: A) -> Parser[B]) -> Parser[B]
fn any_char(input: String, pos: Int) -> ParseResult[String]
fn satisfy(pred: (ch: String) -> Bool) -> Parser[String]
fn take_while(pred: (ch: String) -> Bool) -> Parser[String]
fn take_while1(pred: (ch: String) -> Bool) -> Parser[String]
fn spaces0(input: String, pos: Int) -> ParseResult[String]
fn token[T](parser: Parser[T]) -> Parser[T]
fn kw(name: String) -> Parser[String]
fn spaces1(input: String, pos: Int) -> ParseResult[String]
fn alpha(input: String, pos: Int) -> ParseResult[String]
fn digit(input: String, pos: Int) -> ParseResult[String]
fn digits1(input: String, pos: Int) -> ParseResult[String]
fn alnum(input: String, pos: Int) -> ParseResult[String]
fn identifier(input: String, pos: Int) -> ParseResult[String]
fn uint(input: String, pos: Int) -> ParseResult[Int]

// --- func
fn compose[A, B, C](f: (x: A) -> B, g: (y: B) -> C) -> (z: A) -> C
fn identity[A](x: A) -> A
fn flip[A, B, C](f: (a: A, b: B) -> C) -> (b: B, a: A) -> C

// --- iterator (Iterable[T] trait is method-bearing but never re-exported —
// see header comment; no contract entry)
fn Iterator::fold[C: Iterable, T, B](xs: C, init: B, f: (acc: B, x: T) -> B) -> B
fn Iterator::iter[C: Iterable, T, R](xs: C, f: (x: T) -> R) -> Int
fn Iterator::find[C: Iterable, T](xs: C, pred: (x: T) -> Bool) -> Option[T]
fn Iterator::any[C: Iterable, T](xs: C, pred: (x: T) -> Bool) -> Bool
fn Iterator::all[C: Iterable, T](xs: C, pred: (x: T) -> Bool) -> Bool
fn Iterator::map[C: Iterable, A, B](xs: C, f: (x: A) -> B) -> Array[B]
fn Iterator::filter[C: Iterable, T](xs: C, pred: (x: T) -> Bool) -> Array[T]
fn Iterator::flatmap[C: Iterable, A, B](xs: C, f: (x: A) -> Array[B]) -> Array[B]

// --- lazy_iter (its own Iterator[T] trait is method-bearing but never
// re-exported — see header comment; no contract entry)
fn lazy_iter_arr[T](xs: Array[T]) -> LazyIter[T]
fn lazy_iter_map[T, U](src: LazyIter[T], f: (x: T) -> U) -> LazyIter[U]
fn lazy_iter_filter[T](src: LazyIter[T], pred: (x: T) -> Bool) -> LazyIter[T]
fn lazy_iter_collect[T](src: LazyIter[T]) -> Array[T]
fn lazy_iter_fold[T, U](src: LazyIter[T], init: U, f: (acc: U, x: T) -> U) -> U
fn lazy_iter_count[T](src: LazyIter[T]) -> Int
fn lazy_iter_find[T](src: LazyIter[T], pred: (x: T) -> Bool) -> Option[T]
fn lazy_iter_any[T](src: LazyIter[T], pred: (x: T) -> Bool) -> Bool
fn lazy_iter_all[T](src: LazyIter[T], pred: (x: T) -> Bool) -> Bool
fn lazy_iter_take_while[T](src: LazyIter[T], pred: (x: T) -> Bool) -> LazyIter[T]
fn lazy_iter_take[T](src: LazyIter[T], n: Int) -> LazyIter[T]
fn lazy_iter_drop[T](src: LazyIter[T], n: Int) -> LazyIter[T]
fn lazy_iter_enumerate[T](src: LazyIter[T]) -> LazyIter[(Int, T)]
fn lazy_iter_zip[T, U](a: LazyIter[T], b: LazyIter[U]) -> LazyIter[(T, U)]
fn lazy_iter_flat_map[T, U](src: LazyIter[T], f: (x: T) -> Array[U]) -> LazyIter[U]

// --- async_iter (its own AsyncIterator[T] trait is method-bearing but
// never re-exported — see header comment; no contract entry. `Async` is
// the checker-builtin effect, no import needed)
fn async_iter_arr[T](xs: Array[T]) -> AsyncIter[T]
fn async_iter_empty[T]() -> AsyncIter[T]
fn async_iter_once[T](x: T) -> AsyncIter[T]
fn async_iter_map[T, U](src: AsyncIter[T], f: (x: T) -> U) -> AsyncIter[U]
fn async_iter_filter[T](src: AsyncIter[T], pred: (x: T) -> Bool) -> AsyncIter[T]
fn async_iter_take[T](src: AsyncIter[T], n: Int) -> AsyncIter[T]
fn async_iter_take_while[T](src: AsyncIter[T], pred: (x: T) -> Bool) -> AsyncIter[T]
fn async_iter_collect[T](src: AsyncIter[T]) -> Array[T] with { Async }
fn async_iter_fold[T, U](src: AsyncIter[T], init: U, f: (acc: U, x: T) -> U) -> U with { Async }
fn async_iter_count[T](src: AsyncIter[T]) -> Int with { Async }
fn async_iter_find[T](src: AsyncIter[T], pred: (x: T) -> Bool) -> Option[T] with { Async }
fn async_iter_any[T](src: AsyncIter[T], pred: (x: T) -> Bool) -> Bool with { Async }
fn async_iter_all[T](src: AsyncIter[T], pred: (x: T) -> Bool) -> Bool with { Async }
