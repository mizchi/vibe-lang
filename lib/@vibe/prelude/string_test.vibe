//# Imports

import ./string.vibe {
  Lines::parse,
  Lines::stringify,
  PromptText::new,
  String,
  String::compare,
  String::count,
  String::drop,
  String::equals,
  String::head,
  String::init,
  String::is_blank,
  String::is_empty,
  String::is_not_empty,
  String::last,
  String::pad_left,
  String::pad_right,
  String::repeat,
  String::replace,
  String::replace_all,
  String::split,
  String::tail,
  String::take,
  String::to_lower,
  String::to_upper,
  String::trim,
  String::trim_end,
  String::trim_start,
  from_char_code
}

//# Functions

fn string_drop(s: String, n: Int) -> String {
  String::drop(s, n)
}

fn string_head(s: String) -> String {
  String::head(s)
}

fn string_init(s: String) -> String {
  String::init(s)
}

fn string_last(s: String) -> String {
  String::last(s)
}

fn string_tail(s: String) -> String {
  String::tail(s)
}

fn string_take(s: String, n: Int) -> String {
  String::take(s, n)
}

fn string_count(s: String, sub: String) -> Int {
  String::count(s, sub)
}

fn string_repeat(s: String, n: Int) -> String {
  String::repeat(s, n)
}

fn string_compare(a: String, b: String) -> Int {
  String::compare(a, b)
}

fn string_replace(s: String, pattern: String, replacement: String) -> String {
  String::replace(s, pattern, replacement)
}

fn string_is_blank(s: String) -> Bool {
  String::is_blank(s)
}

fn string_is_empty(s: String) -> Bool {
  String::is_empty(s)
}

fn string_pad_left(s: String, target_len: Int, pad_char: String) -> String {
  String::pad_left(s, target_len, pad_char)
}

fn string_trim_end(s: String) -> String {
  String::trim_end(s)
}

fn string_pad_right(s: String, target_len: Int, pad_char: String) -> String {
  String::pad_right(s, target_len, pad_char)
}

fn string_trim_start(s: String) -> String {
  String::trim_start(s)
}

fn string_replace_all(s: String, pattern: String, replacement: String) -> String {
  String::replace_all(s, pattern, replacement)
}

fn string_is_not_empty(s: String) -> Bool {
  String::is_not_empty(s)
}

//# Misc

test "string_is_empty" {
  assert(string_is_empty(""))
  assert(not(string_is_empty("a")))
}

test "string_equals_compare_blank" {
  assert(String::equals("abc", "abc"))
  assert(not(String::equals("abc", "ab")))
  assert(eq(string_compare("abc", "abc"), 0))
  assert(eq(string_compare("abc", "abd"), -1))
  assert(eq(string_compare("abd", "abc"), 1))
  assert(string_is_blank(""))
  assert(string_is_blank("    "))
  assert(not(string_is_blank(" a ")))
}

test "string_type_members_and_method_style" {
  assert(String::is_empty(""))
  assert(not(String::is_empty("x")))
  assert(not(string_is_not_empty("")))
  assert(string_is_not_empty("x"))
  assert("".is_empty())
  assert(not("x".is_empty()))
}

test "string_head_tail" {
  assert(String::equals(string_head("hello"), "h"))
  assert(String::equals(string_tail("hello"), "ello"))
  assert(String::equals(string_head(""), ""))
  assert(String::equals(string_tail(""), ""))
  assert(String::equals(string_tail("x"), ""))
}

test "string_last_init" {
  assert(String::equals(string_last("hello"), "o"))
  assert(String::equals(string_init("hello"), "hell"))
  assert(String::equals(string_last(""), ""))
  assert(String::equals(string_init("x"), ""))
}

test "string_take_drop" {
  assert(String::equals(string_take("hello", 3), "hel"))
  assert(String::equals(string_drop("hello", 2), "llo"))
  assert(String::equals(string_take("hi", 10), "hi"))
  assert(String::equals(string_drop("hi", 10), ""))
}

test "string_repeat" {
  assert(String::equals(string_repeat("ab", 3), "ababab"))
  assert(String::equals(string_repeat("x", 0), ""))
  assert(String::equals(string_repeat("", 5), ""))
}

test "string_pad" {
  assert(String::equals(string_pad_left("42", 5, "0"), "00042"))
  assert(String::equals(string_pad_right("hi", 5, "."), "hi..."))
  assert(String::equals(string_pad_left("hello", 3, "x"), "hello"))
  assert(String::equals(string_pad_left("a", 3, "xy"), "xya"))
  assert(String::equals(string_pad_right("a", 3, "xy"), "axy"))
}

test "string_pad_edge_cases" {
  assert(String::equals(string_pad_left("ab", 5, ""), "ab"))
  assert(String::equals(string_pad_right("ab", 5, ""), "ab"))
  assert(String::equals(string_pad_left("ab", 0, "0"), "ab"))
  assert(String::equals(string_pad_right("ab", -1, "0"), "ab"))
}

test "string_contains" {
  assert(String::contains("hello world", "lo wo"))
  assert(String::contains("abc", ""))
  assert(not(String::contains("abc", "xyz")))
}

test "string_index_of" {
  assert(eq(String::index_of("hello", "ll"), 2))
  assert(eq(String::index_of("hello", "x"), -1))
  assert(eq(String::index_of("hello", ""), 0))
}

test "string_replace" {
  assert(String::equals(string_replace("hello world", "world", "vibe"), "hello vibe"))
  assert(String::equals(string_replace("aaa", "a", "b"), "baa"))
  assert(String::equals(string_replace("hello", "x", "y"), "hello"))
  assert(String::equals(string_replace("abc", "", "X"), "abc"))
}

test "string_count" {
  assert(eq(string_count("hello", "l"), 2))
  assert(eq(string_count("aaaa", "aa"), 2))
  assert(eq(string_count("abc", ""), 0))
}

test "string_replace_all" {
  assert(String::equals(string_replace_all("foo bar foo", "foo", "x"), "x bar x"))
  assert(String::equals(string_replace_all("aaaa", "aa", "b"), "bb"))
  assert(String::equals(string_replace_all("abc", "", "z"), "abc"))
  assert(String::equals(string_replace_all("ababa", "aba", "x"), "xba"))
}

test "string_type_calls_only" {
  assert(String::is_empty(""))
  assert(String::contains("hello", "ell"))
  assert(String::equals(String::replace_all("foo foo", "foo", "x"), "x x"))
}

test "string_trim" {
  assert(String::equals(String::trim("  hello  "), "hello"))
  assert(String::equals(string_trim_start("   hi"), "hi"))
  assert(String::equals(string_trim_end("hi   "), "hi"))
}

test "string_from_char_code_is_top_level" {
  assert(String::equals(from_char_code(65), "A"))
}

/// Regression: String::split used to be a stub that recursed into itself
/// (`String::split(s, sep)`), so importing this module and calling split
/// trapped with infinite recursion. It now splits on the separator.
test "string_split" {
  let parts = String::split("a,b,c", ",")
  assert(Array::length(parts) == 3)
  assert(String::equals(Array::get(parts, 0), "a"))
  assert(String::equals(Array::get(parts, 1), "b"))
  assert(String::equals(Array::get(parts, 2), "c"))
}

test "string_split_no_match" {
  let parts = String::split("hello", "x")
  assert(Array::length(parts) == 1)
  assert(String::equals(Array::get(parts, 0), "hello"))
}

test "string_split_empty_sep" {
  let parts = String::split("hi", "")
  assert(Array::length(parts) == 1)
  assert(String::equals(Array::get(parts, 0), "hi"))
}

/// #768: real direct-import coverage for String::to_lower/to_upper (fixed
/// previously but never actually exercised via a real import+call anywhere
/// -- the closing test at the time only ran through handler.vibe's own
/// ascii_lower workaround) and for the newly-added Lines::/PromptText::
/// builtins.
test "string_to_lower" {
  assert(String::to_lower("ABC") == "abc")
  assert(String::to_lower("MiXeD 123!") == "mixed 123!")
}

test "string_to_upper" {
  assert(String::to_upper("abc") == "ABC")
  assert(String::to_upper("MiXeD 123!") == "MIXED 123!")
}

test "lines_parse_and_stringify_roundtrip" {
  let lines = Lines::parse("a\nb\nc")
  assert(Array::length(lines) == 3)
  assert(String::equals(Array::get(lines, 0), "a"))
  assert(String::equals(Array::get(lines, 1), "b"))
  assert(String::equals(Array::get(lines, 2), "c"))
  assert(String::equals(Lines::stringify(lines), "a\nb\nc"))
}

test "prompt_text_new_is_identity" {
  assert(String::equals(PromptText::new("hello"), "hello"))
}

