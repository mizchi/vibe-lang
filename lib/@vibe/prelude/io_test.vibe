//# Imports

import ./io.vibe {
  ansi_escape,
  stdin_read,
  stdin_read_line,
  stdout_write,
  stdout_writeln,
  tap,
  tap_err,
  tap_ok,
  tap_some,
  tui_clear_screen,
  tui_cursor_home,
  tui_enter_alt_screen,
  tui_leave_alt_screen
}

import ./result.vibe {
  Result
}

import ./option.vibe {
  Option
}

//# Misc

test "String::from_char_code basic" {
  assert(String::from_char_code(65) == "A")
}

test "stdin_read_line eof is empty by default" {
  assert(stdin_read_line() == "")
}

test "stdout helpers run" {
  let run_stdout = (s: String) -> Unit with { Stdout } {
    {
      stdout_write(s)
      stdout_writeln(s)
    }
  }
  run_stdout("")
  assert(true)
}

test "stream helpers run" {
  let run_stream = (n: Int, s: String) -> String with { Stdin, Stdout } {
    {
      stdout_write(s)
      stdin_read(n)
    }
  }
  let read = run_stream(0, "")
  assert(read == "")
}

test "ansi escape helper runs" {
  let run_ansi = (suffix: String) -> Unit with { Stdout } {
    ansi_escape(suffix)
  }
  run_ansi("")
  assert(true)
}

test "tui preset helpers run" {
  let run_tui = () -> Unit with { Stdout } {
    {
      tui_enter_alt_screen()
      tui_clear_screen()
      tui_cursor_home()
      tui_leave_alt_screen()
    }
  }
  run_tui()
  assert(true)
}

test "tap returns its input unchanged" {
  let run = (n: Int) -> Int with { Stdout } {
    tap(n, (v: Int) -> Unit with { Stdout } {
      stdout_write("")
    })
  }
  assert(eq(run(42), 42))
}

test "tap_ok / tap_err / tap_some pass values through" {
  let noop = (v: Int) -> Unit with { Stdout } {
    stdout_write("")
  }
  let noop_s = (v: String) -> Unit with { Stdout } {
    stdout_write("")
  }
  let ok7: Result[Int, String] = Ok(7)
  match tap_ok(ok7, noop) {
    Ok(v) => assert(eq(v, 7)),
    _ => assert(false)
  }
  let bad: Result[Int, String] = Err("bad")
  match tap_ok(bad, noop) {
    Err(m) => assert(m == "bad"),
    _ => assert(false)
  }
  let boom: Result[Int, String] = Err("boom")
  match tap_err(boom, noop_s) {
    Err(m) => assert(m == "boom"),
    _ => assert(false)
  }
  let ok3: Result[Int, String] = Ok(3)
  match tap_err(ok3, noop_s) {
    Ok(v) => assert(eq(v, 3)),
    _ => assert(false)
  }
  match tap_some(Some(9), noop) {
    Some(v) => assert(eq(v, 9)),
    _ => assert(false)
  }
  let none_int: Option[Int] = None
  match tap_some(none_int, noop) {
    None => assert(true),
    _ => assert(false)
  }
}
