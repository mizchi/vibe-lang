//# Imports

import ./io.vibe {
  ansi_escape,
  stdin_read,
  stdin_read_line,
  stdout_write,
  stdout_writeln,
  tap,
  tap_some,
  tui_clear_screen,
  tui_cursor_home,
  tui_enter_alt_screen,
  tui_leave_alt_screen
}

import ./option.vibe {
  Option
}

//# Misc

test "String::from_char_code basic" {
  assert(String::from_char_code(65) == "A")
}

test "stdin_read_line eof is empty by default" {
  assert(stdin_read_line() == "")
}

test "stdout helpers run" {
  let run_stdout = (s: String) -> Unit with Stdout {
    {
      stdout_write(s)
      stdout_writeln(s)
    }
  }
  run_stdout("")
  assert(true)
}

test "stream helpers run" {
  let run_stream = (n: Int, s: String) -> String with Stdin + Stdout {
    {
      stdout_write(s)
      stdin_read(n)
    }
  }
  let read = run_stream(0, "")
  assert(read == "")
}

test "ansi escape helper runs" {
  let run_ansi = (suffix: String) -> Unit with Stdout {
    ansi_escape(suffix)
  }
  run_ansi("")
  assert(true)
}

test "tui preset helpers run" {
  let run_tui = () -> Unit with Stdout {
    {
      tui_enter_alt_screen()
      tui_clear_screen()
      tui_cursor_home()
      tui_leave_alt_screen()
    }
  }
  run_tui()
  assert(true)
}

test "tap returns its input unchanged" {
  let run = (n: Int) -> Int with Stdout {
    tap(n, (v: Int) -> Unit with Stdout {
      stdout_write("")
    })
  }
  assert(eq(run(42), 42))
}

test "tap_some passes values through" {
  let noop = (v: Int) -> Unit with Stdout {
    stdout_write("")
  }
  match tap_some(Some(9), noop) {
    Some(v) => assert(eq(v, 9)),
    _ => assert(false)
  }
  let none_int: Option[Int] = None
  match tap_some(none_int, noop) {
    None => assert(true),
    _ => assert(false)
  }
}
