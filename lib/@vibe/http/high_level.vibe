//# Imports

import ./http.vibe {
  request, respond
}

//# Types

// #897 (ADR-0070 Phase 3): `HttpRequest` / `HttpResponse` are declared
// TRANSPARENT in index.vpkg (tests and @vibe/wasi/p2 access
// `.method`/`.status`/`.body` directly), so their definitions moved there;
// this file references them by name only (types are global in the merged
// program, same convention as ShResult in @vibe/process, PR #920).

//# Functions

export fn status_ok() -> Int {
  200
}

export fn make_request(method: String, url: String, headers: Map[String, String], body: String) -> HttpRequest {
  HttpRequest::{
    method: method,
    url: url,
    headers: headers,
    body: body
  }
}

export fn headers_empty() -> Map[String, String] {
  let headers: Map[String, String] = MapBuilder::freeze(MapBuilder::new())
  headers
}

export fn make_response(status: Int, headers: Map[String, String], body: String) -> HttpResponse {
  HttpResponse::{
    status: status,
    headers: headers,
    body: body
  }
}

export fn status_created() -> Int {
  201
}

export fn headers_to_wire(headers: Map[String, String]) -> String {
  let keys = Map::keys(headers)
  let len = Array::length(keys)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    if i > 0 {
      StringBuilder::push(sb, "\n")
    }
    let key = Array::get(keys, i)
    StringBuilder::push(sb, key)
    StringBuilder::push(sb, ": ")
    StringBuilder::push(sb, Map::get(headers, key))
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

export fn request_with(request_data: HttpRequest) -> Int with Http {
  request(request_data.method, request_data.url, headers_to_wire(request_data.headers), request_data.body)
}

export fn respond_with(req_fd: Int, response_data: HttpResponse) -> Unit with Http {
  respond(req_fd, response_data.status, headers_to_wire(response_data.headers), response_data.body)
}

export fn status_not_found() -> Int {
  404
}

export fn status_is_success(status: Int) -> Bool {
  status >= 200 && status < 300
}

/// #774: `String::to_lower` is registered in the type checker's builtin table
/// (checker/builtins_string2.vibe) but has no codegen builtin-registry entry
/// (core/builtin_registry.vibe only carries `String::trim`/`to_upper`'s
/// siblings, not `to_lower`), so calling it traps at runtime with "undefined
/// variable (local): String::to_lower @call" instead of failing to compile.
/// Fixing that gap is a compiler codegen change out of scope for the HTTP
/// effect-declaration issue this module was blocked on, so header-name
/// normalization is done here with a manual ASCII-only lowercase loop built
/// from `String::char_code_at`/`String::from_char_code`, both of which ARE
/// registered in every codegen lane.
fn ascii_lower_char_code(code: Int) -> Int {
  if code >= 65 && code <= 90 {
    code + 32
  } else {
    code
  }
}

fn normalize_header_name(name: String) -> String {
  let len = String::length(name)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    let code = String::char_code_at(name, i)
    StringBuilder::push(sb, String::from_char_code(ascii_lower_char_code(code)))
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

export fn headers_get(headers: Map[String, String], name: String) -> Option[String] {
  let key = normalize_header_name(name)
  if Map::has_key(headers, key) {
    Some(Map::get(headers, key))
  } else None
}

export fn headers_set(headers: Map[String, String], name: String, value: String) -> Map[String, String] {
  let key = normalize_header_name(name)
  let keys = Map::keys(headers)
  let len = Array::length(keys)
  let builder = MapBuilder::new()
  let mut seen = false
  let mut i = 0
  while i < len {
    let existing_key = Array::get(keys, i)
    if existing_key == key {
      MapBuilder::set(builder, key, value)
      seen = true
    } else {
      MapBuilder::set(builder, existing_key, Map::get(headers, existing_key))
    }
    i = i + 1
  }
  if not(seen) {
    MapBuilder::set(builder, key, value)
  }
  MapBuilder::freeze(builder)
}

export fn headers_get_or(headers: Map[String, String], name: String, default: String) -> String {
  match headers_get(headers, name) {
    Some(value) => value,
    _ => default
  }
}

export fn status_is_client_error(status: Int) -> Bool {
  status >= 400 && status < 500
}

export fn status_is_server_error(status: Int) -> Bool {
  status >= 500 && status < 600
}

export fn status_internal_server_error() -> Int {
  500
}

//# Canonical collision-safe aliases

/// #897 (ADR-0070 Phase 3): the old index.vibe facade defined these as plain
/// `export let http_request_with = request_with` VALUE aliases (real
/// importable bindings, same trap as `version`) — re-expressed as real thin
/// wrapper functions so the contract's fn declarations can be
/// conformance-checked (same pattern as @vibe/process's process_* aliases,
/// PR #920).
export fn http_request_with(request_data: HttpRequest) -> Int with Http {
  request_with(request_data)
}

export fn http_respond_with(req_fd: Int, response_data: HttpResponse) -> Unit with Http {
  respond_with(req_fd, response_data)
}
