name = @vibe/http
version = 0.0.1
description =
  #|@vibe/http — fd-based HTTP client/server surface: the raw fd-level fns
deps = {}

generated_hash =

// @vibe/http — fd-based HTTP client/server surface: the raw fd-level fns
// (http.vibe, #794's split of direct-call client ops vs perform-based
// server ops), the high-level HttpRequest/HttpResponse helpers
// (high_level.vibe), and the HttpServer/HttpClient/HttpIncoming effect
// declarations (http_effect.vibe) (ADR-0070 Phase 3, #897).
//
// `HttpRequest`/`HttpResponse` are declared TRANSPARENT (defined verbatim,
// not opaque): high_level_test.vibe and @vibe/wasi/p2's import_test.vibe
// access `.method`/`.url`/`.status`/`.body` directly, so the field layout
// is real public API surface. The definitions moved here from
// high_level.vibe, which references them by name only (types are global in
// the merged program, same convention as ShResult in @vibe/process, PR
// #920).
//
// `HttpServer`/`HttpClient`/`HttpIncoming` are transparent effect
// definitions (#752's contract convention for effect rows). http_effect.vibe
// KEEPS its own `export effect` defs — effect defs are invisible to
// check_contract's exported-but-undeclared sweep, the duplicate definition
// is tolerated by the merge (same empirical result as @vibe/fs's `Fs`,
// PR #923), and http_effect_import_test.vibe imports them from
// `./http_effect.vibe` directly. Declaring them here matters post-#729
// boundary sealing: external mockers can no longer reach http_effect.vibe.
// Note the fns below use the checker-BUILTIN `Http` effect row
// (checker/builtins_net.vibe), not these three — both surfaces are
// pre-existing, preserved as-is.
//
// `version` was `export let version = "0.0.1"` directly in the old
// index.vibe facade — a real importable binding, not just contract
// metadata — preserved as an implementation-file value (http.vibe) with a
// matching bodyless declaration here (Codex review precedent, PR #914).
// The old facade ALSO defined the twelve qualified `Http::` "canonical
// collision-safe alias" bindings (`export let Http::close = close`, ...).
// Like @vibe/fs's `Fs::` aliases (PR #923) these could NOT be re-expressed
// as wrapper fns: the `Http::*` names are checker/codegen builtins and a fn
// def occupying one hijacks the perform lowering / raw-builtin binding
// (#794/#795). They stay bare value aliases in http.vibe, with
// http_aliases.vibe re-exporting them so #847's re-export trust discharges
// the fn declarations below. The two unqualified aliases
// (http_request_with/http_respond_with) became real thin wrapper fns in
// high_level.vibe (PR #920 pattern). NOTE for external consumers: importing
// this facade pulls the qualified `Http::` aliases into your unit, and —
// qualified exports being exempt from the #716 rename — they capture direct
// builtin `Http::request`/... calls, rerouting them through this package's
// fns (same caveat as @vibe/fs).

struct HttpRequest {
  method: String;
  url: String;
  headers: Map[String, String];
  body: String
}

struct HttpResponse {
  status: Int;
  headers: Map[String, String];
  body: String
}

effect HttpServer {
  Listen(Int) -> Int;
  Accept(Int) -> Int;
  Respond(Int, Int, String, String) -> Unit;
  Close(Int) -> Unit
}

effect HttpClient {
  Request(String, String, String, String) -> Int;
  ResponseStatus(Int) -> Int;
  ResponseHeader(Int, String) -> String;
  ResponseBody(Int) -> String
}

effect HttpIncoming {
  RequestMethod(Int) -> String;
  RequestUrl(Int) -> String;
  RequestHeader(Int, String) -> String;
  RequestBody(Int) -> String
}

// --- http (raw fd api)
fn close(fd: Int) -> Unit with Http
fn accept(server_fd: Int) -> Int with Http
fn listen(port: Int) -> Int with Http
fn request(method: String, url: String, headers: String, body: String) -> Int with Http
fn respond(req_fd: Int, status: Int, headers: String, body: String) -> Unit with Http
fn request_url(fd: Int) -> String with Http
fn request_body(fd: Int) -> String with Http
fn response_body(fd: Int) -> String with Http
fn request_header(fd: Int, name: String) -> String with Http
fn request_method(fd: Int) -> String with Http
fn response_header(fd: Int, name: String) -> String with Http
fn response_status(fd: Int) -> Int with Http

// --- high_level
fn status_ok() -> Int
fn status_created() -> Int
fn status_not_found() -> Int
fn status_internal_server_error() -> Int
fn status_is_success(status: Int) -> Bool
fn status_is_client_error(status: Int) -> Bool
fn status_is_server_error(status: Int) -> Bool
fn make_request(method: String, url: String, headers: Map[String, String], body: String) -> HttpRequest
fn make_response(status: Int, headers: Map[String, String], body: String) -> HttpResponse
fn headers_empty() -> Map[String, String]
fn headers_get(headers: Map[String, String], name: String) -> Option[String]
fn headers_get_or(headers: Map[String, String], name: String, default: String) -> String
fn headers_set(headers: Map[String, String], name: String, value: String) -> Map[String, String]
fn headers_to_wire(headers: Map[String, String]) -> String
fn request_with(request_data: HttpRequest) -> Int with Http
fn respond_with(req_fd: Int, response_data: HttpResponse) -> Unit with Http

// --- canonical collision-safe aliases
fn Http::close(fd: Int) -> Unit with Http
fn Http::accept(server_fd: Int) -> Int with Http
fn Http::listen(port: Int) -> Int with Http
fn Http::request(method: String, url: String, headers: String, body: String) -> Int with Http
fn Http::respond(req_fd: Int, status: Int, headers: String, body: String) -> Unit with Http
fn Http::request_url(fd: Int) -> String with Http
fn Http::request_body(fd: Int) -> String with Http
fn Http::response_body(fd: Int) -> String with Http
fn Http::request_header(fd: Int, name: String) -> String with Http
fn Http::request_method(fd: Int) -> String with Http
fn Http::response_header(fd: Int, name: String) -> String with Http
fn Http::response_status(fd: Int) -> Int with Http
fn http_request_with(request_data: HttpRequest) -> Int with Http
fn http_respond_with(req_fd: Int, response_data: HttpResponse) -> Unit with Http
