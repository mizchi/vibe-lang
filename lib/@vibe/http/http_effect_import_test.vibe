//# Imports

import ./http_effect.vibe {
  HttpServer
}

//# Misc

test "imported effect" {
  let fd = handle {
    perform HttpServer::Listen(8080)
  } with HttpServer {
    Listen(_port) => resume(42);
    Accept(_listener) => resume(0);
    Respond(_fd, _status, _headers, _body) => resume(());
    Close(_fd) => resume(())
  }
  assert(fd == 42)
}
