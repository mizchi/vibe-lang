// #897 (ADR-0070 Phase 3): conformance shim for the canonical `Http::`
// value aliases. http.vibe defines them as BARE value aliases
// (`export let Http::close = close` — see the comment there for why they
// cannot be wrapper fns), and a bare alias carries no signature for
// check_contract to compare against the contract's fn declarations
// ("lacks the full annotations"). Re-exporting the names here rides #847's
// re-export trust — a re-exported name satisfies its declaration at face
// value — which is exactly the trust boundary the old hand-written
// index.vibe facade already had for these bindings (same shape as
// lib/@vibe/fs/fs_aliases.vibe).
export ./http.vibe {
  Http::accept,
  Http::close,
  Http::listen,
  Http::request,
  Http::request_body,
  Http::request_header,
  Http::request_method,
  Http::request_url,
  Http::respond,
  Http::response_body,
  Http::response_header,
  Http::response_status
}
