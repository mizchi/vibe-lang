//# Types

effect HttpServer {
  Listen(Int) -> Int;
  Accept(Int) -> Int;
  Respond(Int, Int, String, String) -> Unit;
  Close(Int) -> Unit
}

effect HttpClient {
  Request(String, String, String, String) -> Int;
  ResponseStatus(Int) -> Int
}

effect HttpIncoming {
  RequestMethod(Int) -> String;
  RequestUrl(Int) -> String
}

//# Misc

test "server minimal capability" {
  let status = handle {
    let server_fd = perform HttpServer::Listen(8080)
    let req_fd = perform HttpServer::Accept(server_fd)
    perform HttpServer::Respond(req_fd, 200, "", "ok")
    perform HttpServer::Close(server_fd)
    200
  } with { HttpServer::Listen(_port) => resume(10); HttpServer::Accept(_fd) => resume(20); HttpServer::Respond(_fd, _s, _h, _b) => resume(0); HttpServer::Close(_fd) => resume(0) }
  assert(status == 200)
}

test "client only" {
  let status = handle {
    let hid = perform HttpClient::Request("GET", "http://example.com", "", "")
    perform HttpClient::ResponseStatus(hid)
  } with { HttpClient::Request(_m, _u, _h, _b) => resume(1); HttpClient::ResponseStatus(_fd) => resume(200) }
  assert(status == 200)
}

test "request read-only" {
  let method = handle {
    perform HttpIncoming::RequestMethod(1)
  } with { HttpIncoming::RequestMethod(_fd) => resume("POST"); HttpIncoming::RequestUrl(_fd) => resume("/") }
  assert(String::equals(method, "POST"))
}
