//# Functions

// Real-network e2e against the runner's `vibe.http_*` host imports. Use the
// public client spellings directly: #1508 must lower these unbound names (not
// just @vibe/http's internal raw helpers) to the client host imports.
//
// The echo-server port is overridable via VIBE_HTTP_ECHO_PORT (#934: a fixed
// port collides when concurrent worktree batteries each start their own
// server); default stays 18280 for standalone runs.

fn base_from(port: String) -> String {
  let p = if String::length(port) > 0 {
    port
  } else {
    "18280"
  }
  String::concat("http://127.0.0.1:", p)
}

test "http GET request" with Http::request + Http::response_status + Http::response_body + Http::close {
  let base = base_from(Env::get("VIBE_HTTP_ECHO_PORT"))
  let h = Http::request("GET", String::concat(base, "/hello"), "", "")
  assert(Http::response_status(h) == 200)
  assert(Http::response_body(h) == "hello")
  Http::close(h)
}

test "http POST echo" with Http::request + Http::response_status + Http::response_body + Http::close {
  let base = base_from(Env::get("VIBE_HTTP_ECHO_PORT"))
  let h = Http::request("POST", String::concat(base, "/echo"), "", "ping from vibe")
  assert(Http::response_status(h) == 200)
  assert(Http::response_body(h) == "ping from vibe")
  Http::close(h)
}

test "http 404 response" with Http::request + Http::response_status + Http::close {
  let base = base_from(Env::get("VIBE_HTTP_ECHO_PORT"))
  let h = Http::request("GET", String::concat(base, "/nonexistent"), "", "")
  assert(Http::response_status(h) == 404)
  Http::close(h)
}
