//# Imports

import ./http.vibe {
  close, request, response_body, response_status
}

//# Functions

// Real-network e2e against the runner's `vibe.http_*` host imports. As in
// lib/@vibe/fs/fs_test.vibe, the client ops compile to direct host-import
// calls (#794), so the requests hit the real test server — Http is ambient
// in test blocks (ADR-0076 追記34 V2), no row-discharge wrapper needed.
//
// The echo-server port is overridable via VIBE_HTTP_ECHO_PORT (#934: a fixed
// port collides when concurrent worktree batteries each start their own
// server); default stays 18280 for standalone runs.

fn base_from(port: String) -> String {
  let p = if String::length(port) > 0 { port } else { "18280" }
  String::concat("http://127.0.0.1:", p)
}

fn do_get(base: String) -> Bool with { Http } {
  let h = request("GET", String::concat(base, "/hello"), "", "")
  let ok = response_status(h) == 200 && response_body(h) == "hello"
  close(h)
  ok
}

fn do_post_echo(base: String) -> Bool with { Http } {
  let h = request("POST", String::concat(base, "/echo"), "", "ping from vibe")
  let ok = response_status(h) == 200 && response_body(h) == "ping from vibe"
  close(h)
  ok
}

fn do_404(base: String) -> Bool with { Http } {
  let h = request("GET", String::concat(base, "/nonexistent"), "", "")
  let ok = response_status(h) == 404
  close(h)
  ok
}

//# Misc

// ADR-0076 追記34 V2: the vacuous `handle .. with Http { Listen => .. }`
// wrappers are gone. They existed only to discharge the Http row for the
// checker (the arms never fired -- see the header comment), which stopped
// compiling once the replay engine was removed (`Http` is a checker
// BUILTIN effect with no `effect Http {..}` declaration, so the evidence
// migration has nothing to build a dict from). Http is now ambient in
// test/bench blocks like Fs/Env (test_bench_ambient_effects,
// checker/checker_effects.vibe), so the client fns are called directly.
test "http GET request" {
  let base = base_from(Env::get("VIBE_HTTP_ECHO_PORT"))
  assert(do_get(base))
}

test "http POST echo" {
  let base = base_from(Env::get("VIBE_HTTP_ECHO_PORT"))
  assert(do_post_echo(base))
}

test "http 404 response" {
  let base = base_from(Env::get("VIBE_HTTP_ECHO_PORT"))
  assert(do_404(base))
}
