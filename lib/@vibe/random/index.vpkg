version 0.0.1

// @vibe/random — 決定的な線形合同法 (LCG) 乱数。純粋関数で state を明示的に
// 受け渡す (seed で初期化 → next/next_between で (値, 次state) を得る)。公開
// API はこの契約が定義し、実装は sibling の random.vibe。directory import
// (`import .{ ... }`) か scope import (`import @vibe/random { ... }`) で消費する。

fn seed(seed_value: Int) -> Int
fn next(state: Int) -> (Int, Int)
fn next_between(state: Int, min_inclusive: Int, max_exclusive: Int) -> (Int, Int)
