import @vibe/compiler {
  configure_cfg_flags, executable_exports_stripped, strip_executable_wasm_env
}
// One synchronous compiler instance surrounds the Async-only coordinator.
// The component composition cannot host the compiler's Env/Fs imports yet.
import @vibe/blake3/simd {
  blake3_bytes_simd
}
import @vibe/compiler/checker {
  set_error_row_checked
}
import @vibe/compiler/core {
  namespace_rename_originals_snapshot, set_executable_exports_stripped
}
import @vibe/compiler/entry/compiler/file_compile {
  compile_file_fs_mode_rc_body_cached_split
}
import @vibe/compiler/codegen/wasi {
  PreludeModuleBatch, prelude_tail_record, prelude_with_module_batch_executor
}
import @vibe/compiler/normalize/desugar {
  dtd_eq_invisible_nominals, eq_invisible_nominals_reset
}
import @vibe/lowering_worker {
  module_lowering_deferred_merge
}
import @vibe/lowering_worker {
  PreludeSharedContext, write_prelude_shared_context, write_prelude_shared_job
}
import @vibe/lowering_worker {
  decode_prelude_module_product
}

fn compile_input() -> Bytes with Env + Exception + Fs {
  compile_file_fs_mode_rc_body_cached_split(Env::get("VIBE_LOWERING_INPUT"), Env::get("VIBE_LOWERING_ENTRY"), "off", true)
}

// These callbacks belong to this transient compile image. The host calls
// them on the paused parent instance; workers always use separate instances.
let batches: Array[PreludeModuleBatch] = []
let shared_contexts: Array[PreludeSharedContext] = []
let context_digest: Array[String] = [""]
let input_digests: Array[String] = []
let input_buffer: Array[Bytes] = [Bytes::new()]
let product_buffer: Array[Bytes] = [Bytes::new()]
let product_capacity: Array[Int] = [0]
let cursor: Array[Int] = [0]

// Bytes are raw pointers in the RC ABI. Reset only the length; preserve the
// allocation and capacity. No decoded AST or strings borrow these buffers.
fn clear_bytes(bytes: Bytes) -> Int = wasm
"local.get $bytes i32.wrap_i64 i32.const 0 i32.store offset=4 i64.const 0"

/// Serialize the immutable context once before the host starts worker waves.
export fn lowering_shared_context() -> Bytes with Exception {
  let bytes = Bytes::with_capacity(64 * 1024 * 1024)
  Array::set(input_buffer, 0, bytes)
  write_prelude_shared_context(bytes, Array::get(shared_contexts, 0))
  Array::set(context_digest, 0, blake3_bytes_simd(bytes))
  bytes
}

export fn lowering_job_input(index: Int) -> Bytes with Exception {
  let bytes = Array::get(input_buffer, 0)
  clear_bytes(bytes)
  let batch = Array::get(batches, 0)
  let entry = if index == batch.entry_fid {
    batch.entry_name
  } else {
    ""
  }
  write_prelude_shared_job(bytes, Array::get(batch.parts, index), Array::get(batch.context_indices, index), "f\{index}", entry, Array::get(context_digest, 0))
  Array::set(input_digests, index, blake3_bytes_simd(bytes))
  bytes
}

export fn lowering_input_release() -> Unit {
  clear_bytes(Array::get(input_buffer, 0))
  ()
}

export fn lowering_product_allocate(index: Int, length: Int) -> Bytes with Exception {
  if index != Array::get(cursor, 0) || length <= 0 {
    throw("lowering: invalid product allocation order or length")
  } else ()
  if length > Array::get(product_capacity, 0) {
    Array::set(product_buffer, 0, Bytes::with_capacity(length))
    Array::set(product_capacity, 0, length)
  } else ()
  let buffer = Array::get(product_buffer, 0)
  clear_bytes(buffer)
  buffer
}

export fn lowering_product_consume(index: Int, input_digest: String, product_digest: String) -> Unit with Exception {
  if index != Array::get(cursor, 0) || index >= Array::length(input_digests) {
    throw("lowering: product count or order mismatch")
  } else ()
  let bytes = Array::get(product_buffer, 0)
  if input_digest != Array::get(input_digests, index) {
    throw("lowering: product does not match its prepared input: input receipt")
  } else ()
  if product_digest != blake3_bytes_simd(bytes) {
    throw("lowering: product does not match its prepared input: product digest")
  } else ()
  let product = decode_prelude_module_product(bytes)
  if product.module_tag != "f\{index}" {
    throw("lowering: product belongs to a different module")
  } else ()
  let batch = Array::get(batches, 0)
  let own = Array::get(batch.parts, index)
  Array::truncate(own, 0)
  for stmt in product.own {
    Array::push(own, stmt)
  }
  for key in product.synth_keys {
    Array::push(batch.synth, key)
  }
  let mut i = 0
  while i < Array::length(product.tail.keys) {
    prelude_tail_record(batch.tail, Array::get(product.tail.keys, i), Array::get(product.tail.passes, i))
    i = i + 1
  }
  for diag in product.diagnostics {
    Array::push(batch.diagnostics, diag)
  }
  for name in product.inline_names {
    Array::push(batch.env.iw_names, name)
  }
  for wat in product.inline_wats {
    Array::push(batch.env.iw_wats, wat)
  }
  module_lowering_deferred_merge(product.deferred)
  eq_invisible_nominals_reset()
  for name in product.invisible_nominals {
    Array::push(dtd_eq_invisible_nominals, name)
  }
  clear_bytes(Array::get(product_buffer, 0))
  Array::set(cursor, 0, index + 1)
}

fn execute_batch(batch: PreludeModuleBatch) -> Unit with Exception {
  Array::push(batches, batch)
  let count = Array::length(batch.parts)
  Array::push(shared_contexts, PreludeSharedContext::{
    interfaces: batch.context_pool,
    typed_offsets: batch.offsets,
    typed_keys: batch.keys,
    facts: batch.env.trait_facts,
    namespace_originals: namespace_rename_originals_snapshot(),
    alias_renames: batch.env.alias_renames,
    calls_host_future: batch.env.calls_host_future,
    waiter_hooks: batch.env.waiter_hooks,
    aw_note: batch.env.aw_note
  })
  let mut index = 0
  while index < count {
    Array::push(input_digests, "")
    index = index + 1
  }
  let completed = compiler_lowering_run(count)
  if completed != count || Array::get(cursor, 0) != count {
    throw("lowering: unconsumed module products")
  } else ()
  Array::truncate(shared_contexts, 0)
  Array::truncate(input_digests, 0)
  Array::truncate(batches, 0)
}

fn single_compile() -> Unit with Env + Exception + Fs {
  let bytes = prelude_with_module_batch_executor(execute_batch, () -> Bytes with Env + Exception + Fs {
    compile_input()
  })
  if Array::get(cursor, 0) == 0 {
    throw("build without VIBE_TASKGROUP_LOWERING=1 for this program")
  } else ()
  Fs::write_bytes(Env::get("VIBE_LOWERING_OUTPUT"), strip_executable_wasm_env(bytes, Env::get("VIBE_LOWERING_ENTRY")))
}

fn main() -> Unit allows Env + Exception + Fs {
  configure_cfg_flags()
  set_executable_exports_stripped(executable_exports_stripped(Env::get("VIBE_LOWERING_ENTRY")))
  set_error_row_checked(Env::get("VIBE_CHECK_ERROR_ROW") != "0")
  let mode = Env::get("VIBE_LOWERING_MODE")
  if mode == "serial" {
    Fs::write_bytes(Env::get("VIBE_LOWERING_OUTPUT"), strip_executable_wasm_env(compile_input(), Env::get("VIBE_LOWERING_ENTRY")))
  } else if mode == "single" {
    single_compile()
  }
  else {
    throw("lowering: expected serial or single mode")
  }
}
