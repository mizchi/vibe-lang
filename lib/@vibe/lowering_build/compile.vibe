import @vibe/lowering_worker/linear {
  linear_string_reader
}
import @vibe/compiler/config {
  configure_compiler_cfg_flags
}

import @vibe/compiler/codegen/executable {
  executable_exports_stripped, strip_executable_wasm_env
}
// One synchronous compiler instance surrounds the Async-only coordinator.
// The component composition cannot host the compiler's Env/Fs imports yet.
import @vibe/blake3/simd {
  blake3_bytes_simd
}
import @vibe/compiler/checker {
  set_error_row_checked
}
import @vibe/compiler/core {
  namespace_rename_originals_snapshot, set_executable_exports_stripped
}
import @vibe/compiler/entry/compiler/file_compile {
  compile_file_fs_mode_rc_body_cached_split
}
import @vibe/compiler/codegen/wasi {
  PreludeModuleBatch, prelude_with_module_batch_executor
}
import @vibe/lowering_worker {
  prelude_module_product_merge
}
import @vibe/lowering_worker {
  PreludeSharedContext, write_prelude_shared_context, write_prelude_shared_job
}
import @vibe/lowering_worker {
  read_prelude_module_product
}

fn compile_input() -> Bytes with Env + Exception + Fs {
  compile_file_fs_mode_rc_body_cached_split(entry_path = Env::get("VIBE_LOWERING_INPUT"), entry_name = Env::get("VIBE_LOWERING_ENTRY"), cache_mode = "off", use_split = true)
}

// These callbacks belong to this transient compile image. The host calls
// them on the paused parent instance; workers always use separate instances.
let batches: Array[PreludeModuleBatch] = []
let shared_contexts: Array[PreludeSharedContext] = []
let context_digest: Array[String] = [""]
let input_digests: Array[String] = []
let input_buffer: Array[Bytes] = [Bytes::new()]
let product_buffer: Array[Bytes] = [Bytes::new()]
let product_capacity: Array[Int] = [0]
let cursor: Array[Int] = [0]

// Bytes are raw pointers in the RC ABI. Reset only the length; preserve the
// allocation and capacity. No decoded AST or strings borrow these buffers.
fn clear_bytes(_ bytes: Bytes) -> Int = wasm
"local.get $bytes i32.wrap_i64 i32.const 0 i32.store offset=4 i64.const 0"

/// Serialize the immutable context once before the host starts worker waves.
export fn lowering_shared_context() -> Bytes with Exception {
  let bytes = Bytes::with_capacity(64 * 1024 * 1024)
  Array::set(input_buffer, at = 0, value = bytes)
  write_prelude_shared_context(b = bytes, context = Array::get(shared_contexts, at = 0))
  Array::set(context_digest, at = 0, value = blake3_bytes_simd(bytes))
  bytes
}

export fn lowering_job_input(_ index: Int) -> Bytes with Exception {
  let bytes = Array::get(input_buffer, at = 0)
  clear_bytes(bytes)
  let batch = Array::get(batches, at = 0)
  let entry = if index == batch.entry_fid {
    batch.entry_name
  } else {
    ""
  }
  write_prelude_shared_job(b = bytes, own = Array::get(batch.parts, at = index), indices = Array::get(batch.context_indices, at = index), tag = "f\{index}", entry = entry, digest = Array::get(context_digest, at = 0))
  Array::set(input_digests, at = index, value = blake3_bytes_simd(bytes))
  bytes
}

export fn lowering_input_release() -> Unit {
  clear_bytes(Array::get(input_buffer, at = 0))
  ()
}

export fn lowering_product_allocate(index: Int, length: Int) -> Bytes with Exception {
  if index != Array::get(cursor, at = 0) || length <= 0 {
    throw("lowering: invalid product allocation order or length")
  } else ()
  if length > Array::get(product_capacity, at = 0) {
    Array::set(product_buffer, at = 0, value = Bytes::with_capacity(length))
    Array::set(product_capacity, at = 0, value = length)
  } else ()
  let buffer = Array::get(product_buffer, at = 0)
  clear_bytes(buffer)
  buffer
}

export fn lowering_product_consume(index: Int, input_digest: String, product_digest: String) -> Unit with Exception {
  if index != Array::get(cursor, at = 0) || index >= Array::length(input_digests) {
    throw("lowering: product count or order mismatch")
  } else ()
  let bytes = Array::get(product_buffer, at = 0)
  if input_digest != Array::get(input_digests, at = index) {
    throw("lowering: product does not match its prepared input: input receipt")
  } else ()
  if product_digest != blake3_bytes_simd(bytes) {
    throw("lowering: product does not match its prepared input: product digest")
  } else ()
  let product = read_prelude_module_product(linear_string_reader(bytes))
  if product.module_tag != "f\{index}" {
    throw("lowering: product belongs to a different module")
  } else ()
  // In module order (the cursor), so the program's refusals are filed as the
  // in-process driver files them; the driver reports them after this batch.
  let batch = Array::get(batches, at = 0)
  prelude_module_product_merge(product = product, own = Array::get(batch.parts, at = index), env = batch.env, synth = batch.synth, tail = batch.tail, diagnostics = batch.diagnostics)
  clear_bytes(Array::get(product_buffer, at = 0))
  Array::set(cursor, at = 0, value = index + 1)
}

fn execute_batch(_ batch: PreludeModuleBatch) -> Unit with Exception {
  Array::push(batches, value = batch)
  let count = Array::length(batch.parts)
  Array::push(shared_contexts, value = PreludeSharedContext::{
    interfaces: batch.context_pool,
    typed_offsets: batch.offsets,
    typed_keys: batch.keys,
    facts: batch.env.trait_facts,
    namespace_originals: namespace_rename_originals_snapshot(),
    alias_renames: batch.env.alias_renames,
    calls_host_future: batch.env.calls_host_future,
    waiter_hooks: batch.env.waiter_hooks,
    aw_note: batch.env.aw_note
  })
  let mut index = 0
  while index < count {
    Array::push(input_digests, value = "")
    index = index + 1
  }
  let completed = compiler_lowering_run(count)
  if completed != count || Array::get(cursor, at = 0) != count {
    throw("lowering: unconsumed module products")
  } else ()
  Array::truncate(shared_contexts, length = 0)
  Array::truncate(input_digests, length = 0)
  Array::truncate(batches, length = 0)
  // Clear callback state after the service; Bytes remain bump-backed.
  // Resetting these references does not reclaim their capacity or linear memory.
  Array::set(input_buffer, at = 0, value = Bytes::new())
  Array::set(product_buffer, at = 0, value = Bytes::new())
  Array::set(product_capacity, at = 0, value = 0)
  Array::set(context_digest, at = 0, value = "")
}

fn single_compile() -> Unit with Env + Exception + Fs {
  let bytes = prelude_with_module_batch_executor(executor = execute_batch, action = () -> Bytes with Env + Exception + Fs {
    compile_input()
  })
  if Array::get(cursor, at = 0) == 0 {
    throw("build without VIBE_TASKGROUP_LOWERING=1 for this program")
  } else ()
  Fs::write_bytes(Env::get("VIBE_LOWERING_OUTPUT"), bytes = strip_executable_wasm_env(wasm = bytes, entry_name = Env::get("VIBE_LOWERING_ENTRY")))
}

fn main() -> Unit allows Env + Exception + Fs {
  configure_compiler_cfg_flags()
  set_executable_exports_stripped(executable_exports_stripped(Env::get("VIBE_LOWERING_ENTRY")))
  set_error_row_checked(Env::get("VIBE_CHECK_ERROR_ROW") != "0")
  let mode = Env::get("VIBE_LOWERING_MODE")
  if mode == "serial" {
    Fs::write_bytes(Env::get("VIBE_LOWERING_OUTPUT"), bytes = strip_executable_wasm_env(wasm = compile_input(), entry_name = Env::get("VIBE_LOWERING_ENTRY")))
  } else if mode == "single" {
    single_compile()
  }
  else {
    throw("lowering: expected serial or single mode")
  }
}
