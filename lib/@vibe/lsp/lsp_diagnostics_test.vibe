// LSP diagnostic wire-shape coverage (#1556, #1672).
//
// `lsp_diagnostics_json_string` is what an editor actually receives, and it is
// also what `vibe check --single-file --json` emits -- one structured
// diagnostic representation shared by the editor protocol and the CLI (#820
// sub-item 1). The package's only test fed it ONE clean source, so every branch
// that turns a `line L:C: message` string into a Diagnostic sat unreached:
// severity, the fallback for a message with no position, and the byte-column ->
// UTF-16 conversion.
//
// Writing this found #1672: the conversion was not being applied at all. The
// compiler's diagnostics carry BYTE columns; LSP positions are UTF-16 code
// units. Passing the byte column through put the caret too far right on any
// line with non-ASCII before the error, and did it silently -- the diagnostic
// still rendered, just in the wrong place.
//
// These are snapshots of the real wire output, not hand-written JSON.
//
// #1941 next knife after #2024: `locate_type_error` already emits
// `line L:C-E:` from `[@off=N:M]`, but the JSON/LSP encoder used to treat
// `C-E` as a non-numeric column and collapse to `0..1`. The quux test
// below requires the encoder to slice the same token #2024 locked.
// Return-type mismatches on an offset-less literal (`EString`) now recover
// the enclosing `fn` name instead of the synthetic `0:0-0:1` fallback.
// A top-level `let x: Int = "s"` was the last shape with no `line L:` prefix
// at all; it is located at its binder now (#1941). The `synthetic` marker
// stays as the honest answer for anything that genuinely has no anchor -- it
// is just no longer reached by that shape.

//# Imports

import .{
  lsp_diagnostics_json_of_messages, lsp_diagnostics_json_of_messages_for, lsp_diagnostics_json_string
}

import @vibe/compiler/runtime {
  collect_all_diagnostics
}

import @vibe/json {
  Json
}

//# Tests

test "an unlocated diagnostic carries a VALID range plus synthetic (#2831)" {
  // Binder-name fallback is ambiguous when `fn v` and `let v` share a spelling,
  // so the type error has no `line L:` prefix.
  //
  // This asserted `"start": null, "end": null` until Codex review of #2868.
  // LSP makes `Diagnostic.range` required and types it as two `Position`
  // objects with `uinteger` fields, so null is not a weaker claim -- it is an
  // invalid payload, and a schema-checking client drops the very diagnostics
  // this path exists to deliver. The claim lives in `data.synthetic` instead,
  // which is what a client should read to know the position is artificial.
  let src = "fn v() -> Int {\n  1\n}\n\nfn f() -> Bool {\n  let v = if true { 1 } else { true }\n  true\n}\n"
  let parsed = Json::parse(lsp_diagnostics_json_string(src, checked_error_row = false))
  assert(Json::length(parsed) >= 1)
  let diag = Json::index(parsed, idx = 0)
  let range = Json::field(diag, key = "range")
  let start = Json::field(range, key = "start")
  let fin = Json::field(range, key = "end")
  assert(!(start is JNull))
  assert(!(fin is JNull))
  assert(Float64::to_int(Json::number(Json::field(start, key = "line"))) == 0)
  assert(Float64::to_int(Json::number(Json::field(start, key = "character"))) == 0)
  assert(Float64::to_int(Json::number(Json::field(fin, key = "line"))) == 0)
  assert(Float64::to_int(Json::number(Json::field(fin, key = "character"))) == 0)
  let data = Json::field(diag, key = "data")
  assert(!(data is JNull))
  assert(Json::bool(Json::field(data, key = "synthetic")))
  let raw = lsp_diagnostics_json_of_messages(source = src, msgs = [
    "if branches have incompatible types: expected Int, got Bool"
  ])
  // The marker, not the coordinates, is what separates this from a real
  // first-character highlight -- so the marker is what is asserted.
  assert(!String::contains(raw, needle = "\"start\":null"))
  assert(!String::contains(raw, needle = "\"end\":null"))
  assert(String::contains(raw, needle = "\"synthetic\":true"))
}

test "a path-prefixed FS diagnostic still slices the string (#2831)" {
  // `vibe check --json` on the FS lane throws `path: line L:C-E: …`. The
  // encoder used to treat that as unlocated because it only accepted a
  // leading `line `.
  let src = "let a: Int = \"not an int\"\n"
  let raw = Array::get(collect_all_diagnostics(src), at = 0)
  let prefixed = String::concat("foo.vibe: ", raw)
  let parsed = Json::parse(lsp_diagnostics_json_of_messages(source = src, msgs = [
    prefixed
  ]))
  let direct = Json::parse(lsp_diagnostics_json_of_messages(source = src, msgs = [
    raw
  ]))
  assert(Json::length(parsed) == 1)
  let range = Json::field(Json::index(parsed, idx = 0), key = "range")
  let direct_range = Json::field(Json::index(direct, idx = 0), key = "range")
  assert(!(Json::field(range, key = "start") is JNull))
  let sc = Float64::to_int(Json::number(Json::field(Json::field(range, key = "start"), key = "character")))
  let ec = Float64::to_int(Json::number(Json::field(Json::field(range, key = "end"), key = "character")))
  assert(String::substring(src, start = sc, end = ec) == "\"not an int\"")
  assert(Json::field(Json::index(parsed, idx = 0), key = "data") is JNull)
  let dsc = Float64::to_int(Json::number(Json::field(Json::field(direct_range, key = "start"), key = "character")))
  assert(sc == dsc)
}

test "lsp diagnostics: a clean source produces an empty array" {
  inspect(lsp_diagnostics_json_string("fn f(x: Int) -> Int { x }", checked_error_row = false), "[]")
}

test "lsp diagnostics: an empty source produces an empty array" {
  inspect(lsp_diagnostics_json_string("", checked_error_row = false), "[]")
}

test "lsp diagnostics: a parse error carries its position and error severity" {
  // severity 1 = Error. The range comes from the `line L:C:` prefix, so this
  // also pins that the prefix is consumed rather than left in the message.
  inspect(lsp_diagnostics_json_string("fn f( -> Int { 1 }", checked_error_row = false), "[{\"range\":{\"start\":{\"line\":0,\"character\":6},\"end\":{\"line\":0,\"character\":7}},\"severity\":1,\"source\":\"vibe\",\"message\":\"expected parameter name, got '->'\",\"data\":null}]",)
}

test "lsp diagnostics: return-type mismatch on a string slices the string (#2831)" {
  // EString now carries a parser offset, so the edit site is `"s"` rather than
  // the enclosing `fn` name fallback #1941 used when the literal had none.
  let src = "fn f() -> Int { \"s\" }"
  let token = "\"s\""
  let start = String::index_of(src, needle = token)
  let endo = start + String::length(token)
  assert(start >= 0)
  assert(String::substring(src, start = start, end = endo) == token)
  inspect(lsp_diagnostics_json_string(src, checked_error_row = false), "[{\"range\":{\"start\":{\"line\":0,\"character\":16},\"end\":{\"line\":0,\"character\":19}},\"severity\":1,\"source\":\"vibe\",\"message\":\"return type mismatch: expected Int, got String\",\"data\":null}]",)
  let parsed = Json::parse(lsp_diagnostics_json_string(src, checked_error_row = false))
  assert(Json::length(parsed) == 1)
  let range = Json::field(Json::index(parsed, idx = 0), key = "range")
  let rs = Json::field(range, key = "start")
  let re = Json::field(range, key = "end")
  let sl = Float64::to_int(Json::number(Json::field(rs, key = "line")))
  let sc = Float64::to_int(Json::number(Json::field(rs, key = "character")))
  let el = Float64::to_int(Json::number(Json::field(re, key = "line")))
  let ec = Float64::to_int(Json::number(Json::field(re, key = "character")))
  assert(sl == 0)
  assert(el == 0)
  assert(sc == start)
  assert(ec == endo)
  assert(String::substring(src, start = sc, end = ec) == token)
  assert(!(sl == 0 && sc == 0 && el == 0 && ec <= 1))
}

test "lsp diagnostics: columns are UTF-16 code units, not bytes (#1672)" {
  // `  let 日本 = 1` -- the lexer rejects both characters and reports BYTE
  // columns 7 and 10 (1-based). As UTF-16 code units those are 6 and 7
  // (0-based), because `日` occupies three bytes but one unit. Before #1672
  // the second one was reported as 9: two columns right of the character it
  // points at, silently. Any line with non-ASCII ahead of the error drifts,
  // and the drift compounds per character.
  inspect(lsp_diagnostics_json_string("fn f() -> Int {\n  let 日本 = 1\n  x x\n}", checked_error_row = false), "[{\"range\":{\"start\":{\"line\":1,\"character\":6},\"end\":{\"line\":1,\"character\":7}},\"severity\":1,\"source\":\"vibe\",\"message\":\"unexpected character: 日\",\"data\":null},{\"range\":{\"start\":{\"line\":1,\"character\":7},\"end\":{\"line\":1,\"character\":8}},\"severity\":1,\"source\":\"vibe\",\"message\":\"unexpected character: 本\",\"data\":null}]",)
}

test "lsp diagnostics: an ASCII line is unaffected by the UTF-16 conversion" {
  // The conversion must be identity when there is nothing multibyte to convert
  // -- a fix that shifted ASCII columns would be worse than the bug.
  inspect(lsp_diagnostics_json_string("let a = 1\nfn f( -> Int { 1 }", checked_error_row = false), "[{\"range\":{\"start\":{\"line\":1,\"character\":6},\"end\":{\"line\":1,\"character\":7}},\"severity\":1,\"source\":\"vibe\",\"message\":\"expected parameter name, got '->'\",\"data\":null}]",)
}

/// Identifier `quux` is the #2024 / #1941 range-agreement token.
/// `vibe check --single-file --json` and LSP publishDiagnostics share
/// `lsp_diagnostics_json_string`. The range must slice `quux`, not collapse
/// to 0-width or the `0..1` fallback.
test "json diagnostics slice the same unknown identifier quux (#1941)" {
  let src = "let x = quux\n"
  let token = "quux"
  let start = String::index_of(src, needle = token)
  let endo = start + String::length(token)
  assert(start >= 0)
  assert(String::substring(src, start = start, end = endo) == token)
  let parsed = Json::parse(lsp_diagnostics_json_string(src, checked_error_row = false))
  assert(Json::length(parsed) == 1)
  let range = Json::field(Json::index(parsed, idx = 0), key = "range")
  let rs = Json::field(range, key = "start")
  let re = Json::field(range, key = "end")
  let sl = Float64::to_int(Json::number(Json::field(rs, key = "line")))
  let sc = Float64::to_int(Json::number(Json::field(rs, key = "character")))
  let el = Float64::to_int(Json::number(Json::field(re, key = "line")))
  let ec = Float64::to_int(Json::number(Json::field(re, key = "character")))
  assert(el > sl || ec > sc)
  assert(!(sl == 0 && sc == 0 && el == 0 && ec <= 1))
  assert(sl == 0)
  assert(el == 0)
  assert(sc == start)
  assert(ec == endo)
  assert(String::substring(src, start = sc, end = ec) == token)
  assert(Json::string(Json::field(Json::index(parsed, idx = 0), key = "message")) == "unknown name: quux")
}

/// `let x: Int = "s"` at TOP LEVEL — #2831 gives the string token a parser
/// offset, so the range slices `"s"` rather than falling back to the binder
/// `x`. `data` is null because the node is real source, not synthetic.
test "a top-level let bound to a literal is located at the string (#2831)" {
  let src = "let x: Int = \"s\""
  let parsed = Json::parse(lsp_diagnostics_json_string(src, checked_error_row = false))
  assert(Json::length(parsed) == 1)
  let diag = Json::index(parsed, idx = 0)
  let range = Json::field(diag, key = "range")
  let rs = Json::field(range, key = "start")
  let re = Json::field(range, key = "end")
  let sl = Float64::to_int(Json::number(Json::field(rs, key = "line")))
  let sc = Float64::to_int(Json::number(Json::field(rs, key = "character")))
  let el = Float64::to_int(Json::number(Json::field(re, key = "line")))
  let ec = Float64::to_int(Json::number(Json::field(re, key = "character")))
  assert(!(sl == 0 && sc == 0 && el == 0 && ec == 0))
  assert(sl == 0)
  assert(el == 0)
  assert(String::substring(src, start = sc, end = ec) == "\"s\"")
  assert(Json::string(Json::field(diag, key = "message")) == "binding type mismatch for x: expected Int, got String")
  let data = Json::field(diag, key = "data")
  assert(data is JNull)
}

//# #2868 (Codex P2): the merged FS lane reports a DEPENDENCY's error as
//# `<dep>: line L:C: body`, where `L:C` was computed against the dep's own
//# text. Rendered against the ENTRY's text the column is converted with the
//# wrong bytes and the origin path is dropped from the message, so the
//# diagnostic reads as a confident location in a file that never had the
//# error. Measured before the fix on the source below, whose error line holds
//# 9 bytes of Japanese before the column: byte column 22 was answered as
//# UTF-16 character 21, a position the entry's own line does not even reach.
//#
//# Both halves are pinned. A foreign origin must NOT be converted; the entry's
//# OWN located diagnostic, which arrives through the same prefixed spelling,
//# must still be.

test "a dependency's located diagnostic is not converted against the entry (#2868)" {
  let entry_src = "import ./dep.vibe { bad }\nexport fn main() -> Int {\n  bad()\n}\n"
  let parsed = Json::parse(lsp_diagnostics_json_of_messages_for(path = "entry.vibe", source = entry_src, msgs = [
    "dep.vibe: line 2:22: binding type mismatch for a: expected Int, got String"
  ]))
  assert(Json::length(parsed) == 1)
  let diag = Json::index(parsed, idx = 0)
  // The range is the synthetic one: this document has no honest span for
  // another file's error.
  let range = Json::field(diag, key = "range")
  assert(Float64::to_int(Json::number(Json::field(Json::field(range, key = "start"), key = "line"))) == 0)
  assert(Float64::to_int(Json::number(Json::field(Json::field(range, key = "start"), key = "character"))) == 0)
  assert(Float64::to_int(Json::number(Json::field(Json::field(range, key = "end"), key = "character"))) == 0)
  // The message keeps the origin path -- a location without its file is what
  // made this wrong in the first place.
  assert(String::contains(Json::string(Json::field(diag, key = "message")), needle = "dep.vibe"))
  let data = Json::field(diag, key = "data")
  assert(Json::bool(Json::field(data, key = "synthetic")))
  assert(Json::string(Json::field(data, key = "originPath")) == "dep.vibe")
  assert(Float64::to_int(Json::number(Json::field(data, key = "originLine"))) == 2)
  // BYTES, as the compiler emitted them: converting to UTF-16 needs dep.vibe's
  // text, which this lane does not have.
  assert(Float64::to_int(Json::number(Json::field(data, key = "originByteColumn"))) == 22)
}

test "the entry's own prefixed diagnostic is still located (#2868)" {
  let src = "let a: Int = \"not an int\"\n"
  let raw = Array::get(collect_all_diagnostics(src), at = 0)
  let parsed = Json::parse(lsp_diagnostics_json_of_messages_for(path = "entry.vibe", source = src, msgs = [
    String::concat("entry.vibe: ", raw)
  ]))
  let direct = Json::parse(lsp_diagnostics_json_of_messages(source = src, msgs = [
    raw
  ]))
  let range = Json::field(Json::index(parsed, idx = 0), key = "range")
  let direct_range = Json::field(Json::index(direct, idx = 0), key = "range")
  let sc = Float64::to_int(Json::number(Json::field(Json::field(range, key = "start"), key = "character")))
  let ec = Float64::to_int(Json::number(Json::field(Json::field(range, key = "end"), key = "character")))
  assert(String::substring(src, start = sc, end = ec) == "\"not an int\"")
  assert(sc == Float64::to_int(Json::number(Json::field(Json::field(direct_range, key = "start"), key = "character"))))
  // Same file, so the path is consumed like any other located prefix.
  assert(!String::contains(Json::string(Json::field(Json::index(parsed, idx = 0), key = "message")), needle = "entry.vibe"))
}

test "a range that ends on a later line converts both ends (#3348)" {
  // `line L:C-L2:C2:` -- a multi-line literal, which used to be reported as
  // the point at its first byte.
  let src = "fn f() -> Int {\n  let xs: Array[Int] = [\n    \"a\"\n  ]\n  0\n}\n"
  let parsed = Json::parse(lsp_diagnostics_json_of_messages(source = src, msgs = [
    "line 2:24-4:4: type mismatch: expected Array[Int], got Array[String]"
  ]))
  let range = Json::field(Json::index(parsed, idx = 0), key = "range")
  let start = Json::field(range, key = "start")
  let end = Json::field(range, key = "end")
  inspect(Float64::to_int(Json::number(Json::field(start, key = "line"))), "1")
  inspect(Float64::to_int(Json::number(Json::field(start, key = "character"))), "23")
  inspect(Float64::to_int(Json::number(Json::field(end, key = "line"))), "3")
  inspect(Float64::to_int(Json::number(Json::field(end, key = "character"))), "3")
  inspect(Json::string(Json::field(Json::index(parsed, idx = 0), key = "message")), "type mismatch: expected Array[Int], got Array[String]")
  // A one-line range whose message opens with a digit is still one line.
  let one = Json::parse(lsp_diagnostics_json_of_messages(source = src, msgs = [
    "line 2:24-27: 3 problems"
  ]))
  let one_range = Json::field(Json::index(one, idx = 0), key = "range")
  inspect(Float64::to_int(Json::number(Json::field(Json::field(one_range, key = "end"), key = "line"))), "1")
  inspect(Json::string(Json::field(Json::index(one, idx = 0), key = "message")), "3 problems")
}
