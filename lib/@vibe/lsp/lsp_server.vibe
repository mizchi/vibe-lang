// Self-hosted `vibe lsp` (docs/user/reference/editor-and-debugging.md). Replaces the
// Node.js `clients/js/lsp_server.js` shim, which shelled out to a fresh
// `vibe` subprocess (a full wasm re-instantiation) for every single
// hover/definition/rename/etc. request. The compiler-internal query
// primitives it shelled out to (`@vibe/compiler/runtime`'s
// `type_at_source`/`binding_occurrences`/`symbol_spans`/
// `collect_all_diagnostics`) are ordinary in-process functions operating on
// an in-memory source string, so this server calls them directly instead --
// no subprocess, no temp files, no per-request wasm reload.
//
// Also serves as a real (non-toy) exercise of the effect system: the
// JSON-RPC transport/dispatch layer below never calls into the compiler
// itself -- `lsp_dispatch_request` only decides WHICH `Lsp` operation a
// request needs and hands off to `lsp_run_with_handler`, which is the only
// place any of them is `perform`ed or its real implementation lives. This
// is capability injection via algebraic effects, not effect theater: the
// dispatch code is written against the ABSTRACT `Lsp` interface only, and a
// different handler (a mock for protocol-layer testing, a future handler
// backed by a persistent incremental TypeDb instead of one-shot re-parses)
// could be substituted without touching the transport or routing code.
//
// Effect-safety notes:
// - (docs/user/reference/cheatsheet.md's replay-handler rule: "handle body must stay pure
//   until the final perform, or side effects before it re-run on every
//   resume") `lsp_run_with_handler`'s handle body is an `if`/`else` chain
//   whose every branch is EXACTLY one bare `perform`, nothing before or
//   after -- safe under replay semantics regardless of which branch runs:
//   there is no earlier side effect to duplicate, and re-executing the
//   branch on `resume` re-evaluates the same deterministic condition and
//   re-reaches the same (memoized) perform. Reading the next request, and
//   writing the response, both happen OUTSIDE any handle, in the ordinary
//   (non-effectful) main loop.
// - `perform` and `handle` for `Lsp` are always textually co-located in
//   `lsp_run_with_handler` itself, on purpose -- an earlier revision
//   dispatched via a `body: () -> Json with Lsp` closure PARAMETER
//   instead (built once per call site, passed in to be perform'd here).
//   That compiled cleanly and even ran fine under this repo's Node.js dev/
//   test runner, but trapped ("indirect call type mismatch") the moment it
//   actually executed under real wasmtime: an effectful closure captured
//   BY VALUE and invoked through an opaque higher-order-function parameter
//   is exactly the still-open GENERAL case issue #1070 documents (this is
//   NOT the same shape as this session's own #1070 fix, which covers a
//   NEEDING function calling its own closure-typed parameter --
//   `lsp_run_with_handler` isn't "needing" anything itself, since it fully
//   discharges `Lsp` right there). See `lsp_run_with_handler`'s own doc
//   comment for the restructured (closure-free, Int-tag-dispatched) shape
//   that avoids it -- verified working end-to-end under real viberun with
//   genuinely piped stdin, not just this repo's own dev-runner test
//   harness.
//
// Scope (v1): initialize/initialized/shutdown/exit, full-sync document
// store (didOpen/didChange/didClose), hover, definition, references,
// rename, documentSymbol, and diagnostics (published on every didOpen/
// didChange/didSave -- there is no timer/debounce primitive available, so
// this runs synchronously per edit rather than the JS server's 150ms
// debounce).
//
// Scope (v2, parity slice): completion (document declarations via
// symbol_spans + language keywords; keywords-only on a parse failure),
// signatureHelp (lexical backward callee scan + type_at_source, with
// parameter labels split from the rendered "(A, B) -> R" type and
// activeParameter from top-level commas), and workspace/symbol (searches
// every OPEN document in the docs store -- deliberately not a filesystem
// scan, keeping the entry row { Stdin, Console } with no Fs capability).
// Still deferred: callHierarchy and the `vibe/graph` visualizer (backed by
// clients/js/graph_query.js's whole-workspace index in the JS server;
// porting that indexing layer is a separate follow-up), and on-disk
// (unopened-file) workspace/symbol coverage. `clients/js/lsp_server.js`
// remains available (see runtime/vibe's `lsp` case) for those until then.

//# Imports

import @vibe/compiler/runtime {
  collect_all_diagnostics,
  collect_all_diagnostics_for_path,
  collect_all_diagnostics_for_path_with_error_row,
  collect_all_diagnostics_with_unstable_for_path,
  collect_syntax_diagnostics_for_path,
  collect_unstable_import_diagnostics_for_path,
  split_check_report
}

import @vibe/compiler/query {
  TypeAtFsSession,
  TypeAtMemo,
  binding_occurrences,
  doc_at_source,
  symbol_spans,
  type_at_fs_session_answer,
  type_at_fs_session_errors,
  type_at_fs_session_invalidate,
  type_at_fs_session_new,
  type_at_fs_session_release,
  type_at_fs_session_typings,
  type_at_fs_session_walks,
  type_at_memo_checks,
  type_at_memo_error_row_checked,
  type_at_memo_new,
  type_at_memo_source,
  type_at_source_memo
}

import @vibe/parser {
  offset_to_line_col
}

import @vibe/core {
  array_empty
}

// Deliberately NOT using @vibe/json/jsonrpc.vibe's RpcMessage/RpcId/
// parse_message/stringify_response/stringify_notification/stringify_error,
// even though they're a ready-made JSON-RPC 2.0 codec.
//
// HISTORY (#1078): this started as a WORKAROUND. @vibe/http declares a
// same-named `Request` effect operation, and the whole-program
// merge/flatten this compiler's own build goes through was mis-resolving
// the two `Request` declarations by bare name once the referencing code
// became reachable from an exported entry ("argument type mismatch for
// Request: expected RpcId, got Map[String, Json]"). That is FIXED as of
// 2026-07-26 -- re-verified by driving the real merge lane with both
// declarations reachable in one merged program (compiler_gate.sh 57 pins
// the shape; the http effect has since also been split into
// HttpServer/HttpClient/HttpIncoming, and the compiler bundle no longer
// pulls in @vibe/http at all).
//
// It stays hand-rolled because that is now the SIMPLER code, not because
// the codec is unusable: LSP ids round-trip opaquely (see lsp_env_id), so
// modelling them as `RpcId` and catching `parse_message`'s thrown String
// (`Result[RpcMessage, String]` before #1324 slice 3) would add structure
// this server never reads. Reach for jsonrpc.vibe here if a future need actually wants the
// typed message enum.
// The bare `{ Json }` type import is all that's needed: the FS lane's
// bind_enum_constructor_companions (runtime/typecheck_fs.vibe) binds the
// package's whole `Json::`-qualified export surface alongside the type.
// This file previously carried local json_string/json_number/... helper
// copies of the accessors as a workaround for #1080 (the FS lane only
// bound companions whose RETURN type was Json, so Json::string et al --
// which return String/Int/Bool -- didn't resolve); fixed at the source,
// so the accessors are used directly again.
import @vibe/json {
  Json
}

//# Effects

effect Lsp {
  Hover(String, Int, Int) -> Json
  Definition(String, Int, Int) -> Json
  References(String, Int, Int) -> Json
  Rename(String, Int, Int, String) -> Json
  DocumentSymbol(String) -> Json
  Diagnostics(String) -> Json
  Completion(String, Int, Int) -> Json
  SignatureHelp(String, Int, Int) -> Json
  WorkspaceSymbol(String) -> Json
}

//# Content-Length transport (LSP over stdio)

fn lsp_read_header_line() -> String with Stdin {
  let mut acc = ""
  let mut done = false
  while not(done) {
    let c = Stdin::read_char()
    if c < 0 {
      done = true
    } else if c == 10 {
      done = true
    } else if c == 13 {
      ()
    } else {
      acc = String::concat(acc, String::from_char_code(c))
    }
  }
  acc
}

fn lsp_parse_uint_or(s: String, default: Int) -> Int {
  let len = String::length(s)
  if len == 0 {
    default
  } else {
    let mut i = 0
    let mut acc = 0
    let mut ok = true
    while ok && i < len {
      let c = String::char_code_at(s, at = i)
      if c >= '0' && c <= '9' {
        acc = acc * 10 + (c - '0')
        i = i + 1
      } else {
        ok = false
      }
    }
    if ok {
      acc
    } else {
      default
    }
  }
}

/// Reads headers up to the blank line, returns the declared Content-Length
/// (-1 if the stream closed before any bytes arrived at all -- the "no more
/// messages" signal the main loop stops on; -1 with headers seen but no
/// Content-Length line is also treated as fatal for this message, since LSP
/// framing requires it).
fn lsp_read_content_length() -> Int with Stdin {
  let mut content_length = -1
  let mut done = false
  let mut saw_any = false
  while not(done) {
    let line = lsp_read_header_line()
    if String::length(line) == 0 {
      done = true
    } else {
      saw_any = true
      if String::starts_with(line, prefix = "Content-Length:") {
        let rest = String::trim(line[16: String::length(line)])
        content_length = lsp_parse_uint_or(s = rest, default = -1)
      } else {
        ()
      }
    }
  }
  if saw_any {
    content_length
  } else {
    -1
  }
}

fn lsp_read_body(_ n: Int) -> String with Stdin {
  let sb = StringBuilder::new()
  let mut remaining = n
  let mut eof = false
  while remaining > 0 && not(eof) {
    let chunk = Stdin::read_stream(remaining)
    if String::length(chunk) == 0 {
      eof = true
    } else {
      StringBuilder::push(sb, value = chunk)
      remaining = remaining - String::length(chunk)
    }
  }
  StringBuilder::freeze(sb)
}

/// One full LSP message body, or None once the client closes stdin (normal
/// shutdown path when a client exits without sending `exit`, or after we
/// stop reading post-`exit`).
fn lsp_read_message() -> Option[String] with Stdin {
  let content_length = lsp_read_content_length()
  if content_length < 0 {
    None
  } else {
    Some(lsp_read_body(content_length))
  }
}

fn lsp_write_message(_ body: String) -> Unit with Console {
  let len = String::length(body)
  Console::write_stream("Content-Length: ")
  Console::write_stream(Int::to_string(len))
  Console::write_stream("\r\n\r\n")
  Console::write_stream(body)
}

//# JSON helpers

fn jnum_int(_ n: Int) -> Json {
  JNum(Int::to_float64(n))
}

fn jpos(line: Int, character: Int) -> Json {
  JObj(Map::from_pairs([
    ("line", jnum_int(line)),
    ("character", jnum_int(character))
  ]))
}

fn jrange(start_line: Int, start_char: Int, end_line: Int, end_char: Int) -> Json {
  JObj(Map::from_pairs([
    ("start", jpos(line = start_line, character = start_char)),
    ("end", jpos(line = end_line, character = end_char))
  ]))
}

fn jrange_pos(p1: (Int, Int), p2: (Int, Int)) -> Json {
  let (l1, c1) = p1
  let (l2, c2) = p2
  jrange(start_line = l1, start_char = c1, end_line = l2, end_char = c2)
}

fn jlocation(uri: String, r: Json) -> Json {
  JObj(Map::from_pairs([("uri", JStr(uri)), ("range", r)]))
}

/// Extracts `params.textDocument.uri`; "" if absent/malformed.
fn jparam_uri(_ params: Json) -> String {
  Json::string(Json::field(Json::field(params, key = "textDocument"), key = "uri"))
}

fn jparam_line0(_ params: Json) -> Int {
  Float64::to_int(Json::number(Json::field(Json::field(params, key = "position"), key = "line")))
}

fn jparam_char0(_ params: Json) -> Int {
  Float64::to_int(Json::number(Json::field(Json::field(params, key = "position"), key = "character")))
}

//# UTF-16 <-> byte offset bridging (LSP positions are UTF-16 code units;
//# the compiler's own query primitives -- offset_to_line_col, and every
//# byte offset symbol_spans/binding_occurrences returns -- are byte-
//# indexed, matching @vibe/parser/lexer.vibe's own "byte-indexed, not
//# codepoint-indexed" convention (see its String::char_code_at usage).
//# Forwarding an LSP `character` straight into a byte-indexed query, or a
//# byte column straight into an LSP response, silently misplaces every
//# hover/definition/references/rename/documentSymbol touching non-ASCII
//# text before the cursor on its line. `lsp_utf8_seq_len` is a copy of
//# @vibe/parser/lexer.vibe's own (package-private, so not importable)
//# helper of the same name.

fn lsp_utf8_seq_len(_ b0: Int) -> Int {
  if b0 >= 0xF0 && b0 <= 0xF7 {
    4
  } else if b0 >= 0xE0 && b0 <= 0xEF {
    3
  } else if b0 >= 0xC2 && b0 <= 0xDF {
    2
  } else {
    1
  }
}

/// Decodes the Unicode scalar value of the (already-length-known) UTF-8
/// sequence starting at byte `pos`. A malformed/truncated sequence (should
/// not occur in valid document text, but LSP clients are untrusted input)
/// just decodes to whatever the available continuation bytes give --
/// `lsp_utf8_seq_len` already falls back to single-byte granularity for any
/// non-lead byte, so this never reads past what the caller determined.
fn lsp_utf8_decode(source: String, pos: Int, seq_len: Int) -> Int {
  if seq_len == 1 {
    String::char_code_at(source, at = pos)
  } else if seq_len == 2 {
    let b0 = String::char_code_at(source, at = pos)&0x1F
    let b1 = String::char_code_at(source, at = pos + 1)&0x3F
    (b0<<6)|b1
  } else if seq_len == 3 {
    let b0 = String::char_code_at(source, at = pos)&0x0F
    let b1 = String::char_code_at(source, at = pos + 1)&0x3F
    let b2 = String::char_code_at(source, at = pos + 2)&0x3F
    (b0<<12)|(b1<<6)|b2
  } else {
    let b0 = String::char_code_at(source, at = pos)&0x07
    let b1 = String::char_code_at(source, at = pos + 1)&0x3F
    let b2 = String::char_code_at(source, at = pos + 2)&0x3F
    let b3 = String::char_code_at(source, at = pos + 3)&0x3F
    (b0<<18)|(b1<<12)|(b2<<6)|b3
  }
}

/// Byte offset where 0-based line `line0` starts in `source` (0 for line0
/// <= 0, else the byte right after that line's '\n'). A single linear scan
/// from the start; LSP requests are per-edit and this file has no
/// persistent line-offset index to consult instead.
fn lsp_line_start_offset(source: String, line0: Int) -> Int {
  if line0 <= 0 {
    0
  } else {
    let len = String::length(source)
    let mut pos = 0
    let mut line = 0
    let mut found = -1
    while pos < len && found < 0 {
      if String::char_code_at(source, at = pos) == 10 {
        line = line + 1
        if line == line0 {
          found = pos + 1
        }
      }
      pos = pos + 1
    }
    if found >= 0 {
      found
    } else {
      len
    }
  }
}

/// Byte offset of the end of the line starting at `line_start` (exclusive of
/// its trailing '\n', if any; end of string otherwise).
fn lsp_line_end_offset(source: String, line_start: Int) -> Int {
  let len = String::length(source)
  let mut pos = line_start
  while pos < len && String::char_code_at(source, at = pos) != 10 {
    pos = pos + 1
  }
  pos
}

/// LSP `character` (0-based UTF-16 code units into the line starting at
/// `line_start`, ending before `line_end`) -> 0-based BYTE offset from
/// `line_start`. A surrogate pair (astral codepoint, > U+FFFF) counts as 2
/// UTF-16 units but decodes from one 4-byte UTF-8 sequence.
fn lsp_utf16_to_byte_col(source: String, line_start: Int, line_end: Int, utf16_target: Int) -> Int {
  let mut pos = line_start
  let mut units = 0
  while pos < line_end && units < utf16_target {
    let b0 = String::char_code_at(source, at = pos)
    let seq_len = lsp_utf8_seq_len(b0)
    let cp = lsp_utf8_decode(source = source, pos = pos, seq_len = seq_len)
    let width = if cp > 0xFFFF {
      2
    } else {
      1
    }
    pos = pos + seq_len
    units = units + width
  }
  pos - line_start
}

/// Reverse of lsp_utf16_to_byte_col: 0-based BYTE offset from `line_start`
/// -> 0-based UTF-16 code-unit count.
fn lsp_byte_col_to_utf16(source: String, line_start: Int, byte_col: Int) -> Int {
  let mut pos = line_start
  let target = line_start + byte_col
  let mut units = 0
  while pos < target {
    let b0 = String::char_code_at(source, at = pos)
    let seq_len = lsp_utf8_seq_len(b0)
    let cp = lsp_utf8_decode(source = source, pos = pos, seq_len = seq_len)
    let width = if cp > 0xFFFF {
      2
    } else {
      1
    }
    pos = pos + seq_len
    units = units + width
  }
  units
}

/// LSP 0-based (line, UTF-16 character) -> 0-based (line, BYTE column),
/// matching what type_at_source/binding_occurrences expect.
fn lsp_pos_to_byte_col(source: String, line0: Int, utf16_char0: Int) -> Int {
  let line_start = lsp_line_start_offset(source = source, line0 = line0)
  let line_end = lsp_line_end_offset(source = source, line_start = line_start)
  lsp_utf16_to_byte_col(source = source, line_start = line_start, line_end = line_end, utf16_target = utf16_char0)
}

/// Char-offset (as returned by symbol_spans/binding_occurrences) -> LSP
/// 0-based (line, UTF-16 character), via the parser's own offset_to_line_col
/// (which returns 1-based (line, BYTE column), matching the compiler's
/// diagnostic convention) followed by the byte->UTF-16 bridge above.
fn lsp_offset_to_pos(source: String, offset: Int) -> (Int, Int) {
  let (line1, col1) = offset_to_line_col(source = source, offset = offset)
  let line0 = line1 - 1
  let byte_col0 = col1 - 1
  let line_start = lsp_line_start_offset(source = source, line0 = line0)
  (line0, lsp_byte_col_to_utf16(source = source, line_start = line_start, byte_col = byte_col0))
}

//# Diagnostics: parsing "line L:C:" / "line L:C-E:" into an LSP Diagnostic

/// #820 sub-item 2 (structured fix-it, minimal slice): recover the
/// effect-row-mismatch's structured fields (target function name, the
/// exact operations to add, the resulting required row) from the message
/// text `effect_error_to_string` (checker_effects.vibe) already built them
/// into -- NOT re-deriving anything the checker didn't already compute,
/// and deliberately NOT attempting to locate a source position for
/// `target`. Resolving a function name to its declaration span is `vibe
/// symbols`'s job (already-shipped, AST-accurate); duplicating that as an
/// approximate offset here would be exactly the kind of half-working
/// fix-it this sub-item was previously deferred to avoid shipping. `note`
/// spells out that hand-off explicitly so a consumer doesn't assume a
/// span is present.
fn lsp_split_labels(_ s: String) -> Array[String] {
  if String::length(s) == 0 {
    array_empty()
  } else {
    let out = array_empty()
    let mut rest = s
    let mut go = true
    while go {
      let idx = String::index_of(rest, needle = ", ")
      if idx < 0 {
        Array::push(out, value = rest)
        go = false
      } else {
        Array::push(out, value = rest[0: idx])
        rest = rest[idx + 2: String::length(rest)]
      }
    }
    out
  }
}

fn lsp_effect_row_mismatch_fix(_ text: String) -> Json {
  let prefix = "effect row mismatch for '"
  if !String::starts_with(text, prefix = prefix) {
    JNull
  } else {
    let after_prefix = text[String::length(prefix): String::length(text)]
    let close_quote = String::index_of(after_prefix, needle = "'")
    if close_quote < 0 {
      JNull
    } else {
      let fname = after_prefix[0: close_quote]
      let missing_marker = ": missing { "
      let rest = after_prefix[close_quote: String::length(after_prefix)]
      let mi = String::index_of(rest, needle = missing_marker)
      if mi < 0 {
        JNull
      } else {
        let after_missing = rest[mi + String::length(missing_marker): String::length(rest)]
        let mend = String::index_of(after_missing, needle = " }")
        if mend < 0 {
          JNull
        } else {
          let missing_str = after_missing[0: mend]
          let req_marker = "requires { "
          let ri = String::index_of(after_missing, needle = req_marker)
          if ri < 0 {
            JNull
          } else {
            let after_req = after_missing[ri + String::length(req_marker): String::length(after_missing)]
            let rend = String::index_of(after_req, needle = " })")
            if rend < 0 {
              JNull
            } else {
              let required_str = after_req[0: rend]
              JObj(Map::from_pairs([
                ("kind", JStr("add_with_clause")),
                ("target", JStr(fname)),
                ("add", JArr(for x in lsp_split_labels(missing_str) {
                  JStr(x)
                })),
                ("with", JArr(for x in lsp_split_labels(required_str) {
                  JStr(x)
                })),
                ("note", JStr("no position included -- resolve `target`'s declaration via `vibe symbols <file>`"))
              ]))
            }
          }
        }
      }
    }
  }
}

/// #1129 batch: `collect_all_diagnostics` now emits soft warnings (unused
/// imports, unbound non-Unit discards) prefixed `"warning: "` (see
/// typecheck_fs.vibe's collect_all_diagnostics) -- render those as LSP
/// DiagnosticSeverity.Warning (2) rather than Error (1) so an editor doesn't
/// red-squiggle a hint that never blocks `vibe diagnostics`'s own exit code.
fn lsp_diag_severity(_ text: String) -> Int {
  if String::starts_with(text, prefix = "warning: ") {
    2
  } else {
    1
  }
}

/// `line L:C: message` or `line L:C-E: message` -> LSP Diagnostic.
///
/// `C` / `E` are BYTE columns (that is what the compiler's diagnostics carry,
/// and what every other consumer of these strings wants). `locate_type_error`
/// emits the `C-E` form from `[@off=N:M]` when start and end share a line
/// (#1941). Treating `C-E` as one integer used to fail `lsp_parse_uint_or`
/// and collapse the range to the `0..1` fallback -- a confident lie about
/// a token the checker already located. Point-only `line L:C:` still
/// highlights one character (`C` .. `C+1`), same as before.
///
/// LSP positions are UTF-16 code units, so each column has to be converted
/// against the source -- passing the byte column straight through puts the
/// editor's caret too far right on any line with non-ASCII before the error,
/// and silently: the diagnostic still renders, just at the wrong place.
/// `let 日本 = 1` reports byte column 10 for `本` where LSP wants 8.
///
/// The merged FS lane prefixes the ORIGINATING FILE: `check_module_impl`
/// emits `<path>: line L:C: body`, and `L:C` was computed against THAT file's
/// text (`locate_type_error(job.source, ..)`). Dropping `<path>` and
/// converting `C` against the checked buffer is the silent kind of wrong --
/// the diagnostic still renders, at a position in the wrong document, with no
/// trace of where it came from (Codex P2 on #2868). So the origin is split off
/// and kept.
fn lsp_split_origin(_ msg: String) -> (String, String) {
  if String::starts_with(msg, prefix = "line ") {
    ("", msg)
  } else {
    let marker = ": line "
    let at = String::index_of(msg, needle = marker)
    if at >= 0 {
      (String::substring(msg, start = 0, end = at), String::substring(msg, start = at + 2, end = String::length(msg)))
    } else {
      ("", msg)
    }
  }
}

/// `path` is the file `source` is the text OF, or `""` when the caller has no
/// path to compare against (the single-file lanes, where no message carries an
/// origin). A message whose origin names a DIFFERENT file is answered by
/// `lsp_diag_foreign_origin`: its `L:C` cannot be converted here, because the
/// conversion needs that file's bytes and this function is pure.
fn lsp_parse_diag_line_for(path: String, source: String, raw: String) -> Json {
  let (origin, payload) = lsp_split_origin(raw)
  // `path == ""` is "the caller did not say", not "a different file": the
  // single-file lanes pass nothing and nothing they emit carries an origin,
  // and `lsp_diagnostics_test.vibe`'s #2831 case feeds a prefixed message with
  // no path on purpose. Only a caller that NAMED its file can tell the two
  // apart, so only that caller gets the foreign answer.
  if origin != "" && path != "" && origin != path {
    lsp_diag_foreign_origin(raw = raw, origin = origin, payload = payload)
  } else {
    // #2992: an UNLOCATED diagnostic of the checked file itself arrives as
    // `<path>: msg` on the FS lane (there is no `: line ` for
    // `lsp_split_origin` to split on) and bare on `--single-file`, so the two
    // `--json` lanes disagreed on `message`. The client has the URI; the path
    // is not part of the message.
    let own_prefix = String::concat(path, ": ")
    let msg = if path != "" && origin == "" && String::starts_with(payload, prefix = own_prefix) {
      String::substring(payload, start = String::length(own_prefix), end = String::length(payload))
    } else {
      payload
    }
    if String::starts_with(msg, prefix = "line ") {
      let after = msg[5: String::length(msg)]
      let colon1 = String::index_of(after, needle = ":")
      if colon1 < 0 {
        lsp_diag_fallback(msg)
      } else {
        let line_str = after[0: colon1]
        let rest1 = after[colon1 + 1: String::length(after)]
        let colon2 = String::index_of(rest1, needle = ":")
        if colon2 < 0 {
          lsp_diag_fallback(msg)
        } else {
          let col_field = rest1[0: colon2]
          let tail = rest1[colon2 + 1: String::length(rest1)]
          let line1 = lsp_parse_uint_or(s = line_str, default = 1)
          let dash = String::index_of(col_field, needle = "-")
          // #3348: `L:C-L2:C2` ends on a later line. The message after a
          // position always opens with a space, so a digit right after this
          // colon is the end column, not the message.
          let colon3 = String::index_of(tail, needle = ":")
          let multi = dash >= 0 && colon3 > 0 && lsp_parse_uint_or(s = tail[0: colon3], default = 0) > 0 && String::byte_at(tail, at = 0) >= 48 && String::byte_at(tail, at = 0) <= 57
          let text = if multi {
            String::trim(tail[colon3 + 1: String::length(tail)])
          } else {
            String::trim(tail)
          }
          let col1 = if dash < 0 {
            lsp_parse_uint_or(s = col_field, default = 1)
          } else {
            lsp_parse_uint_or(s = col_field[0: dash], default = 1)
          }
          let end_line1 = if multi {
            lsp_parse_uint_or(s = col_field[dash + 1: String::length(col_field)], default = line1)
          } else {
            line1
          }
          let end_col1 = if multi {
            lsp_parse_uint_or(s = tail[0: colon3], default = 0)
          } else if dash < 0 {
            0
          } else {
            lsp_parse_uint_or(s = col_field[dash + 1: String::length(col_field)], default = 0)
          }
          let line0 = if line1 > 0 {
            line1 - 1
          } else {
            0
          }
          let byte_col0 = if col1 > 0 {
            col1 - 1
          } else {
            0
          }
          let line_start = lsp_line_start_offset(source = source, line0 = line0)
          let col0 = lsp_byte_col_to_utf16(source = source, line_start = line_start, byte_col = byte_col0)
          let end_line0 = if multi && end_line1 > line1 {
            end_line1 - 1
          } else {
            line0
          }
          let end_col0 = if end_line0 > line0 && end_col1 > 0 {
            lsp_byte_col_to_utf16(source = source, line_start = lsp_line_start_offset(source = source, line0 = end_line0), byte_col = end_col1 - 1)
          } else if end_col1 > col1 {
            lsp_byte_col_to_utf16(source = source, line_start = line_start, byte_col = end_col1 - 1)
          } else {
            col0 + 1
          }
          // #820 sub-item 2: `data` follows the LSP Diagnostic.data convention
          // (present, JNull when there's no structured fix -- e.g. every
          // diagnostic that isn't an effect-row mismatch).
          JObj(Map::from_pairs([
            ("range", jrange(start_line = line0, start_char = col0, end_line = end_line0, end_char = end_col0)),
            ("severity", jnum_int(lsp_diag_severity(text))),
            ("source", JStr("vibe")),
            ("message", JStr(text)),
            ("data", lsp_effect_row_mismatch_fix(text))
          ]))
        }
      }
    } else {
      lsp_diag_fallback(msg)
    }
  }
}

fn lsp_parse_diag_line(source: String, msg: String) -> Json {
  lsp_parse_diag_line_for(path = "", source = source, raw = msg)
}

/// A diagnostic whose `line L:C` was computed against ANOTHER file.
///
/// The range stays synthetic: this document has no honest span for it, and
/// `lsp_byte_col_to_utf16` against the wrong text answers a plausible number
/// rather than failing. The `message` keeps the WHOLE original string, origin
/// path included, so the reader is never shown a location without its file.
/// `data` carries the pieces a client can act on -- `originPath` plus the
/// compiler's own 1-based `originLine` / `originByteColumn`. The column is
/// BYTES, named so: converting it to UTF-16 code units needs that file's text,
/// which is exactly what this lane does not have.
fn lsp_diag_foreign_origin(raw: String, origin: String, payload: String) -> Json {
  let fix = lsp_effect_row_mismatch_fix(raw)
  let base = match fix {
    JObj(m) => m,
    _ => Map::from_pairs([])
  }
  let (line1, col1) = lsp_located_line_col(payload)
  let data = Map::set(Map::set(Map::set(Map::set(base, key = "synthetic", value = JBool(true)), key = "originPath", value = JStr(origin)), key = "originLine", value = jnum_int(line1)), key = "originByteColumn", value = jnum_int(col1))
  JObj(Map::from_pairs([
    ("range", lsp_diag_synthetic_range()),
    ("severity", jnum_int(lsp_diag_severity(payload))),
    ("source", JStr("vibe")),
    ("message", JStr(raw)),
    ("data", JObj(data))
  ]))
}

/// The 1-based `L` and `C` of a `line L:C: ..` / `line L:C-E: ..` payload, or
/// `(0, 0)` when it carries neither -- 0 rather than 1 so a client can tell
/// "the compiler did not locate this" from "the first column".
fn lsp_located_line_col(_ payload: String) -> (Int, Int) {
  if !String::starts_with(payload, prefix = "line ") {
    (0, 0)
  } else {
    let after = payload[5: String::length(payload)]
    let colon1 = String::index_of(after, needle = ":")
    if colon1 < 0 {
      (0, 0)
    } else {
      let rest1 = after[colon1 + 1: String::length(after)]
      let colon2 = String::index_of(rest1, needle = ":")
      if colon2 < 0 {
        (0, 0)
      } else {
        let col_field = rest1[0: colon2]
        let dash = String::index_of(col_field, needle = "-")
        let col_text = if dash < 0 {
          col_field
        } else {
          col_field[0: dash]
        }
        (lsp_parse_uint_or(s = after[0: colon1], default = 0), lsp_parse_uint_or(s = col_text, default = 0))
      }
    }
  }
}

/// Messages with no `line L:` prefix cannot claim a real source span.
/// `data.synthetic` is true so clients can tell this apart from a real
/// first-character highlight (#2831). A structured effect-row fix already
/// occupying `data` is kept: `synthetic` is merged in as a sibling field
/// rather than replacing the payload.
fn lsp_diag_fallback_data(_ msg: String) -> Json {
  let fix = lsp_effect_row_mismatch_fix(msg)
  match fix {
    JObj(m) => JObj(Map::set(m, key = "synthetic", value = JBool(true))),
    _ => JObj(Map::from_pairs([("synthetic", JBool(true))]))
  }
}

/// The range an unlocated diagnostic carries.
///
/// This was `{"start": null, "end": null}` (#2831), to avoid claiming a
/// first-character highlight the compiler never computed. LSP does not allow
/// it: `Diagnostic.range` is REQUIRED and its type is `Range`, two `Position`
/// objects whose `line` / `character` are `uinteger`. A client decoding the
/// payload against the schema -- which the typed clients do -- can reject the
/// diagnostic, or the whole `publishDiagnostics` notification it arrived in,
/// and the errors it drops are exactly the unlocated ones this path exists to
/// deliver (Codex review of #2868).
///
/// So the WIRE stays valid and the claim moves to where it can be made
/// honestly: an empty range at the document start, plus `data.synthetic` on
/// the diagnostic. A client that reads `synthetic` knows the position is
/// artificial; one that does not still gets a document it can parse.
fn lsp_diag_synthetic_range() -> Json {
  jrange(start_line = 0, start_char = 0, end_line = 0, end_char = 0)
}

fn lsp_diag_fallback(_ msg: String) -> Json {
  JObj(Map::from_pairs([
    ("range", lsp_diag_synthetic_range()),
    ("severity", jnum_int(lsp_diag_severity(msg))),
    ("source", JStr("vibe")),
    ("message", JStr(msg)),
    ("data", lsp_diag_fallback_data(msg))
  ]))
}

//# Lsp effect handler -- the real implementation, calling straight into
//# @vibe/compiler/runtime (single-file scope, matching `vibe type-at` /
//# `vibe binding-at` / `vibe symbols` / `vibe diagnostics` today; imports
//# are not resolved, same limitation those CLI subcommands already have).

//# Hover typing reuse (#1960)

/// The typing of the buffer this session last hovered, kept for its exact
/// text. One slot: an editor hovers the document it is in, and a second
/// document only costs the cold check it costs today.
///
/// The identity is the buffer text and checked Exception-row policy. A
/// different text or policy misses; type_at_source_memo checks both too.
let lsp_hover_memo: Array[Option[TypeAtMemo]] = [None]

/// How many revisions this session has typed for hover: the first hover of a
/// text types it, every later position of the same text reuses it.
let lsp_hover_memo_builds: Array[Int] = [0]

fn lsp_hover_memo_for(_ source: String, checked_error_row: Bool) -> TypeAtMemo {
  let kept = match Array::get(lsp_hover_memo, at = 0) {
    Some(m) => if type_at_memo_source(m) == source && type_at_memo_error_row_checked(m) == checked_error_row {
      Some(m)
    } else {
      None
    },
    None => None
  }
  match kept {
    Some(m) => m,
    None => {
      let m = type_at_memo_new(source, checked_error_row = checked_error_row)
      Array::set(lsp_hover_memo, at = 0, value = Some(m))
      Array::set(lsp_hover_memo_builds, at = 0, value = Array::get(lsp_hover_memo_builds, at = 0) + 1)
      m
    }
  }
}

/// The import-resolving typing of documents that are files on disk (#1960):
/// the project walk kept for the session, plus one revision's typing keyed by
/// path, buffer text and the entry's walked fingerprint. Created on first use.
let lsp_hover_fs: Array[Option[TypeAtFsSession]] = [None]

/// The document the session last typed, as (URI, the path it was typed
/// under), so `didClose` -- which reads no file -- can release it.
let lsp_hover_fs_doc: Array[(String, String)] = [("", "")]

fn lsp_hover_fs_session() -> TypeAtFsSession {
  match Array::get(lsp_hover_fs, at = 0) {
    Some(session) => session,
    None => {
      let session = type_at_fs_session_new()
      Array::set(lsp_hover_fs, at = 0, value = Some(session))
      session
    }
  }
}

/// The value of one hex digit, or -1.
fn lsp_hex_digit(_ b: Int) -> Int {
  if b >= 48 && b <= 57 {
    b - 48
  } else if b >= 65 && b <= 70 {
    b - 55
  } else if b >= 97 && b <= 102 {
    b - 87
  } else {
    -1
  }
}

/// The ASCII byte a `%XX` escape at `i` of `s` stands for, or -1.
fn lsp_percent_escape_at(s: String, i: Int) -> Int {
  if i + 2 < String::length(s) && String::byte_at(s, at = i) == 37 {
    let hi = lsp_hex_digit(String::byte_at(s, at = i + 1))
    let lo = lsp_hex_digit(String::byte_at(s, at = i + 2))
    if hi >= 0 && lo >= 0 && hi < 8 {
      hi * 16 + lo
    } else {
      -1
    }
  } else {
    -1
  }
}

/// `s` with its ASCII `%XX` escapes decoded. A `file:` URI escapes reserved
/// bytes, and editors send `@` as `%40` -- every path under `lib/@vibe` has
/// one. Any other `%` is kept as written: an escaped non-ASCII byte would
/// need byte-level decoding, and such a path then names no file, so the
/// document is typed alone rather than as some other file.
fn lsp_percent_decode(_ s: String) -> String {
  let parts: Array[String] = []
  let n = String::length(s)
  let mut start = 0
  let mut i = 0
  while i < n {
    let b = lsp_percent_escape_at(s = s, i = i)
    if b >= 0 {
      Array::push(parts, value = s[start: i])
      Array::push(parts, value = String::from_char_code(b))
      i = i + 3
      start = i
    } else {
      i = i + 1
    }
  }
  Array::push(parts, value = s[start: n])
  String::join(parts, sep = "")
}

/// The document's file, when it is a `.vibe` file on disk: the one kind of
/// document whose imports the import-resolving lane can walk. Anything else
/// -- an unsaved new buffer, a contract, a non-`file:` URI -- is typed alone.
///
/// A file inside the project is spelled relative to the project root, the
/// server's working directory, as every CLI verb reads an in-project
/// absolute path (`root_rel_of_absolute`, #3948): the loader takes a contract
/// reached through an absolute path for an external root, and the walk then
/// fails on the package's own types.
fn lsp_hover_fs_path(_ uri: String) -> String with Fs {
  let path = lsp_percent_decode(lsp_uri_to_path(uri))
  let root = Fs::getcwd()
  let prefix = String::concat(root, "/")
  let spelled = if root != "" && root != "/" && String::starts_with(path, prefix = prefix) {
    path[String::length(prefix): String::length(path)]
  } else {
    path
  }
  if String::starts_with(uri, prefix = "file://") && String::ends_with(spelled, suffix = ".vibe") && Fs::exists(spelled) {
    spelled
  } else {
    ""
  }
}

/// The type at 1-based (`line`, `col`) of the document `uri` holding `source`.
/// A file on disk is typed with its imports resolved, as `vibe type-at` and
/// `vibe check` type it (#1960, #3834); the buffer's text is what is typed,
/// not the file's. When that lane has no typing for it, and for every other
/// document, the buffer is typed alone from the kept single-file memo.
fn lsp_type_at(uri: String, source: String, line: Int, col: Int, checked_error_row: Bool) -> String with Env + Fs {
  let path = lsp_hover_fs_path(uri)
  let resolved = if path == "" {
    None
  } else {
    Array::set(lsp_hover_fs_doc, at = 0, value = (uri, path))
    type_at_fs_session_answer(session = lsp_hover_fs_session(), path = path, source = source, line = line, col = col, checked_error_row = checked_error_row)
  }
  match resolved {
    Some(ty) => ty,
    None => type_at_source_memo(source = source, line = line, col = col, memo = lsp_hover_memo_for(source, checked_error_row = checked_error_row), checked_error_row = checked_error_row)
  }
}

/// Drop the kept typing when the document it was built for closes, so a closed
/// buffer's checks are not held for the rest of the session.
fn lsp_hover_memo_release(_ source: String) -> Unit {
  match Array::get(lsp_hover_memo, at = 0) {
    Some(m) => if type_at_memo_source(m) == source {
      Array::set(lsp_hover_memo, at = 0, value = None)
    } else {
      ()
    },
    None => ()
  }
}

/// How many revisions the import-resolving lane has typed this session: the
/// counter `lsp_fs_session_test.vibe` reads to tell a reused typing from a
/// fresh one (#1960).
export fn lsp_hover_fs_typings() -> Int {
  match Array::get(lsp_hover_fs, at = 0) {
    Some(session) => type_at_fs_session_typings(session),
    None => 0
  }
}

/// How many times the import-resolving lane has walked the project this
/// session: once per revision, and again after a dependency's stat token
/// moved or a file event.
export fn lsp_hover_fs_walks() -> Int {
  match Array::get(lsp_hover_fs, at = 0) {
    Some(session) => type_at_fs_session_walks(session),
    None => 0
  }
}

/// A file event from the editor: a document opened or saved, or watched
/// files changed. A file may now exist where an import looks, which the kept
/// dependencies' stat tokens cannot show, so the next hover walks.
fn lsp_hover_fs_invalidate() -> Unit {
  match Array::get(lsp_hover_fs, at = 0) {
    Some(session) => type_at_fs_session_invalidate(session),
    None => ()
  }
}

/// `(revisions typed, checker runs of the kept revision)` for this session --
/// the deterministic work counters `lsp_session_test.vibe` reads. The second
/// is 0 when no typing is kept.
export fn lsp_hover_reuse_counters() -> (Int, Int) {
  let checks = match Array::get(lsp_hover_memo, at = 0) {
    Some(m) => type_at_memo_checks(m),
    None => 0
  }
  (Array::get(lsp_hover_memo_builds, at = 0), checks)
}

fn lsp_handle_hover(uri: String, source: String, line0: Int, char0: Int, checked_error_row: Bool) -> Json with Env + Fs {
  let ty = lsp_type_at(uri = uri, source = source, line = line0 + 1, col = char0 + 1, checked_error_row = checked_error_row)
  let doc = doc_at_source(source = source, line = line0 + 1, col = char0 + 1)
  if String::length(ty) == 0 && String::length(doc) == 0 {
    JNull
  } else {
    let ty_block = if String::length(ty) == 0 {
      ""
    } else {
      String::concat("```vibe\n", String::concat(ty, "\n```"))
    }
    let body = if String::length(doc) == 0 {
      ty_block
    } else if String::length(ty_block) == 0 {
      doc
    } else {
      String::concat(ty_block, String::concat("\n\n", doc))
    }
    JObj(Map::from_pairs([
      ("contents", JObj(Map::from_pairs([
        ("kind", JStr("markdown")),
        ("value", JStr(body))
      ])))
    ]))
  }
}

fn lsp_handle_definition(source: String, uri: String, line0: Int, char0: Int) -> Json {
  let occ = binding_occurrences(source = source, line = line0 + 1, col = char0 + 1)
  if Array::length(occ) == 0 {
    JNull
  } else {
    let (start_off, _end_off) = Array::get(occ, at = 0)
    let p = lsp_offset_to_pos(source = source, offset = start_off)
    let (l, c) = p
    jlocation(uri = uri, r = jrange(start_line = l, start_char = c, end_line = l, end_char = c))
  }
}

fn lsp_handle_references(source: String, uri: String, line0: Int, char0: Int) -> Json {
  let occ = binding_occurrences(source = source, line = line0 + 1, col = char0 + 1)
  JArr(for pair in occ {
    let (start_off, end_off) = pair
    let ps = lsp_offset_to_pos(source = source, offset = start_off)
    let pe = lsp_offset_to_pos(source = source, offset = end_off)
    jlocation(uri = uri, r = jrange_pos(p1 = ps, p2 = pe))
  })
}

fn lsp_handle_rename(source: String, uri: String, line0: Int, char0: Int, new_name: String) -> Json {
  let occ = binding_occurrences(source = source, line = line0 + 1, col = char0 + 1)
  if Array::length(occ) == 0 {
    JNull
  } else {
    let edits = for pair in occ {
      let (start_off, end_off) = pair
      let ps = lsp_offset_to_pos(source = source, offset = start_off)
      let pe = lsp_offset_to_pos(source = source, offset = end_off)
      JObj(Map::from_pairs([
        ("range", jrange_pos(p1 = ps, p2 = pe)),
        ("newText", JStr(new_name))
      ]))
    }
    let changes = Map::set(Map::new(), key = uri, value = JArr(edits))
    JObj(Map::from_pairs([("changes", JObj(changes))]))
  }
}

/// `vibe symbols` KIND -> LSP SymbolKind. 27 (Test) and 28 (Bench) are the
/// CLI's own kinds for block labels (#2632, legend v2); the protocol has no
/// Test kind, so they cross this boundary as Function (12), which is what they
/// were reported as before v2. Every other kind IS an LSP SymbolKind.
fn lsp_symbol_kind(_ kind: Int) -> Int {
  if kind == 27 || kind == 28 {
    12
  } else {
    kind
  }
}

fn lsp_handle_document_symbol(_ source: String) -> Json with Exception {
  let syms = symbol_spans(source)
  JArr(for entry in syms {
    let (name, kind, start_off, end_off) = entry
    let ps = lsp_offset_to_pos(source = source, offset = start_off)
    let pe = lsp_offset_to_pos(source = source, offset = end_off)
    let r = jrange_pos(p1 = ps, p2 = pe)
    JObj(Map::from_pairs([
      ("name", JStr(name)),
      ("kind", jnum_int(lsp_symbol_kind(kind))),
      ("range", r),
      ("selectionRange", r)
    ]))
  })
}

fn lsp_handle_diagnostics(_ source: String, checked_error_row: Bool) -> Json with Exception {
  lsp_handle_diagnostics_with_unstable(source = source, allow_unstable = true, checked_error_row = checked_error_row)
}

/// #2297: the ADR-0068 opt-in for this server run.
///
/// A cell rather than a parameter threaded through `lsp_run_with_handler`:
/// that function has nine call sites and carries the request shape, while this
/// value is constant for the whole process. Authority is settled in the
/// earliest phase and does not change during a run (ADR-0075/0084/0088), so a
/// per-request parameter would be encoding a variability that does not exist.
/// Written once by `lsp_main` from the value its caller read at the edge.
let lsp_unstable_cell: Array[Bool] = [false]

fn lsp_unstable_opt_in() -> Bool {
  Array::get(lsp_unstable_cell, at = 0)
}

/// #2297: `publishDiagnostics` was the one surface that did not report the
/// ADR-0068 opt-in -- it calls this and nothing else, while the adapter spliced
/// the verdict into the two `vibe check --single-file` forms. Taking it from
/// `collect_all_diagnostics_with_unstable` means all three read one answer.
fn lsp_handle_diagnostics_with_unstable(source: String, allow_unstable: Bool, checked_error_row: Bool) -> Json with Exception {
  lsp_handle_diagnostics_for_path(input_path = "", source = source, allow_unstable = allow_unstable, checked_error_row = checked_error_row)
}

/// #2297: the document path matters -- an `index.vpkg` buffer has to be read
/// with the contract grammar, or the scan parses its header as statements,
/// fails, and reports nothing (Codex review on #2313).
fn lsp_handle_diagnostics_for_path(input_path: String, source: String, allow_unstable: Bool, checked_error_row: Bool) -> Json with Exception {
  let diags = collect_all_diagnostics_with_unstable_for_path(input_path = input_path, source = source, allow_unstable = allow_unstable, checked_error_row = checked_error_row)
  JArr(for msg in diags {
    lsp_parse_diag_line(source = source, msg = msg)
  })
}

/// The diagnostics published for the document `uri` holding `source`.
///
/// A `.vibe` file on disk is typed with its imports resolved, by the session
/// the hovers use (#4013). Typed alone, every imported type, every
/// `Type::method` of an import and every name its package's `index.vpkg`
/// shares with its siblings is unknown, so a file `vibe check` accepts was
/// published with errors -- 62 of them on `loader/header_cache.vibe`.
///
/// Syntax comes first and from the recovering parser, so every syntax error
/// is reported and a buffer that does not parse costs no walk. A file that
/// parses is reported from the walk: its own type errors, located in the
/// buffer, and a dependency's with that file named as its origin
/// (`lsp_parse_diag_line_for`). When the walk is clean the single-file lane
/// still contributes its warnings, but never its errors: an error the
/// import-resolving check does not make comes from reading the file without
/// its imports. The ADR-0068 opt-in verdict is the import scan's, as before.
///
/// Every other document -- an unsaved buffer, a contract -- is diagnosed
/// alone, as before.
fn lsp_document_diagnostics(uri: String, source: String, allow_unstable: Bool, checked_error_row: Bool) -> Json with Env + Exception + Fs {
  let input_path = lsp_uri_to_path(uri)
  let path = lsp_hover_fs_path(uri)
  if path == "" {
    lsp_handle_diagnostics_for_path(input_path = input_path, source = source, allow_unstable = allow_unstable, checked_error_row = checked_error_row)
  } else {
    let syntax = collect_syntax_diagnostics_for_path(input_path = input_path, source = source)
    if Array::length(syntax) > 0 {
      JArr(for msg in syntax {
        lsp_parse_diag_line(source = source, msg = msg)
      })
    } else {
      Array::set(lsp_hover_fs_doc, at = 0, value = (uri, path))
      let report = type_at_fs_session_errors(session = lsp_hover_fs_session(), path = path, source = source, checked_error_row = checked_error_row)
      let found = if report == "" {
        lsp_single_file_warnings(input_path = input_path, source = source, checked_error_row = checked_error_row)
      } else {
        for msg in split_check_report(report) {
          lsp_parse_diag_line_for(path = path, source = source, raw = msg)
        }
      }
      for msg in collect_unstable_import_diagnostics_for_path(input_path = input_path, source = source, allow_unstable = allow_unstable) {
        Array::push(found, value = lsp_parse_diag_line(source = source, msg = msg))
      }
      JArr(found)
    }
  }
}

/// The warnings the single-file lane reports for `source`, rendered; its
/// errors are dropped (see `lsp_document_diagnostics`).
fn lsp_single_file_warnings(input_path: String, source: String, checked_error_row: Bool) -> Array[Json] with Exception {
  let found: Array[Json] = []
  for msg in collect_all_diagnostics_for_path_with_error_row(input_path = input_path, source = source, checked_error_row = checked_error_row) {
    let d = lsp_parse_diag_line(source = source, msg = msg)
    if Json::number(Json::field(d, key = "severity")) == 2.0 {
      Array::push(found, value = d)
    } else ()
  }
  found
}

fn lsp_document_diagnostics_safe(uri: String, source: String, allow_unstable: Bool, checked_error_row: Bool) -> Json with Env + Fs {
  handle {
    lsp_document_diagnostics(uri = uri, source = source, allow_unstable = allow_unstable, checked_error_row = checked_error_row)
  } with { Exception::Throw(_) => JArr([]) }
}

/// `document_symbol`/`diagnostics` declare `with Exception` (symbol_spans/
/// collect_all_diagnostics can throw on a genuine internal failure, not just
/// "no symbols" -- see cli_adapter.vibe's own VIBE_SYMBOLS branch, which
/// routes a caught Throw to a `.diag` sidecar rather than treating it the
/// same as an empty result). Swallow to an empty array here: an LSP response
/// must always be well-formed JSON, and "no symbols/diagnostics found" and
/// "the query itself failed" both degrade to the same safe empty response --
/// there is no sidecar channel to report the latter differently over
/// JSON-RPC.
fn lsp_document_symbol_safe(_ source: String) -> Json {
  handle {
    lsp_handle_document_symbol(source)
  } with { Exception::Throw(_) => JArr([]) }
}

export fn lsp_diagnostics_safe(_ source: String, checked_error_row: Bool) -> Json {
  handle {
    lsp_handle_diagnostics(source, checked_error_row = checked_error_row)
  } with { Exception::Throw(_) => JArr([]) }
}

export fn lsp_diagnostics_safe_with_unstable(source: String, allow_unstable: Bool, checked_error_row: Bool) -> Json {
  handle {
    lsp_handle_diagnostics_with_unstable(source = source, allow_unstable = allow_unstable, checked_error_row = checked_error_row)
  } with { Exception::Throw(_) => JArr([]) }
}

export fn lsp_diagnostics_safe_for_path(input_path: String, source: String, allow_unstable: Bool, checked_error_row: Bool) -> Json {
  handle {
    lsp_handle_diagnostics_for_path(input_path = input_path, source = source, allow_unstable = allow_unstable, checked_error_row = checked_error_row)
  } with { Exception::Throw(_) => JArr([]) }
}

/// `file:///a/b.vibe` -> `/a/b.vibe`. Only the extension is load-bearing here
/// (`is_contract_ext`), but a real path costs nothing and keeps any later
/// path-dependent check honest.
fn lsp_uri_to_path(_ uri: String) -> String {
  let prefix = "file://"
  if String::starts_with(uri, prefix = prefix) {
    uri[String::length(prefix): String::length(uri)]
  } else {
    uri
  }
}

/// #820 sub-item 1: `vibe diagnostics --json` reuses this SAME LSP diagnostic
/// shape (range/severity/source/message) rather than inventing a parallel
/// structured format -- one machine-readable diagnostic representation for
/// both the editor protocol and the CLI, built by parsing the same
/// `collect_all_diagnostics` "line L:C:" / "line L:C-E:" strings every
/// other diagnostics consumer (plain-text `vibe diagnostics`, this LSP
/// handler) already produces. Output-layer-only: no checker/lexer/parser
/// changes. `C-E` is the exclusive-end column from `[@off=N:M]` (#1941).
export fn lsp_diagnostics_json_string(_ source: String, checked_error_row: Bool) -> String {
  Json::stringify(lsp_diagnostics_safe(source, checked_error_row = checked_error_row))
}

/// #2277: the ADR-0068 opt-in diagnostic is produced by the ADAPTER, not by
/// `collect_all_diagnostics` -- it is a property of the import declaration
/// rather than of single-file analysis -- so the JSON form has to be handed it
/// or `vibe check --single-file --json` answers `[]` where the text form
/// reports the error. Same diagnostic shape either way: the extra lines are the
/// same `line L:C: message` strings every other consumer produces, mapped
/// through the same parser.
///
/// The extra lines are appended even when `collect_all_diagnostics` throws: an
/// internal failure in single-file analysis is not a reason to drop a verdict
/// the caller already computed.
export fn lsp_diagnostics_json_string_with(source: String, extra: Array[String]) -> String {
  lsp_diagnostics_json_string_with_for_path(input_path = "", source = source, extra = extra)
}

/// #2314: with the path, a `.vpkg` buffer is read with the contract grammar
/// instead of answering `expected { but got eof` about a valid contract.
export fn lsp_diagnostics_json_string_with_for_path(input_path: String, source: String, extra: Array[String]) -> String {
  let msgs = handle {
    collect_all_diagnostics_for_path(input_path = input_path, source = source)
  } with { Exception::Throw(_) => array_empty() }
  let mut i = 0
  while i < Array::length(extra) {
    Array::push(msgs, value = Array::get(extra, at = i))
    i = i + 1
  }
  lsp_diagnostics_json_of_messages(source = source, msgs = msgs)
}

/// Render an ALREADY-COLLECTED message list in the LSP Diagnostic shape.
///
/// #2314 review: the `vibe diagnostics` adapter has to render exactly the list
/// `collect_all_diagnostics_with_unstable_for_path` returns. Without this it
/// had to collect the base set here and the ADR-0068 set separately, and the
/// two drifted -- the separate scan read the RAW buffer, so a `.vpkg` header it
/// could not parse dropped the opt-in error entirely.
export fn lsp_diagnostics_json_of_messages(source: String, msgs: Array[String]) -> String {
  lsp_diagnostics_json_of_messages_for(path = "", source = source, msgs = msgs)
}

/// The same rendering, told WHICH file `source` is.
///
/// The merged FS lane (`vibe check --json <entry>`) reports a dependency's
/// error as `<dep>: line L:C: body`, located against the DEP. Without the
/// checked file's own path there is no way to tell that from the entry's own
/// located diagnostic, and both were converted against the entry's text
/// (Codex P2 on #2868). Callers that know the path pass it; `""` keeps the
/// old behaviour for the single-file lanes, where nothing carries an origin.
export fn lsp_diagnostics_json_of_messages_for(path: String, source: String, msgs: Array[String]) -> String {
  Json::stringify(handle {
    JArr(for msg in msgs {
      lsp_parse_diag_line_for(path = path, source = source, raw = msg)
    })
  } with { Exception::Throw(_) => JArr([]) })
}

//# Completion / signature help / workspace-symbol (parity slice 2).
//# Deliberately built on the SAME single-file compiler primitives as the
//# rest of this server (symbol_spans / type_at_source), not on a ported
//# clients/js/symbol_index.js whole-workspace regex index: completion
//# offers the document's own declarations plus language keywords,
//# signatureHelp resolves the callee identifier lexically and asks the
//# checker for its inferred type, and workspace/symbol searches every OPEN
//# document (the docs store) rather than scanning the filesystem -- the
//# server's entry row stays { Stdin, Console }, no Fs capability needed.

/// SymbolKind (what symbol_spans emits) -> CompletionItemKind. A block label
/// (27 / 28) completes like the Function it used to be reported as.
fn lsp_completion_item_kind(_ sym_kind: Int) -> Int {
  if sym_kind == 12 || sym_kind == 27 || sym_kind == 28 {
    3
  } else if sym_kind == 13 {
    6
  } else if sym_kind == 10 {
    13
  } else if sym_kind == 23 {
    22
  } else if sym_kind == 11 {
    8
  } else if sym_kind == 24 {
    23
  } else if sym_kind == 2 {
    9
  } else {
    7
  }
}

fn lsp_keyword_completions() -> Array[String] {
  [
    "let",
    "mut",
    "fn",
    "enum",
    "struct",
    "trait",
    "impl",
    "effect",
    "effectset",
    "handle",
    "with",
    "allows",
    "perform",
    "resume",
    "match",
    "if",
    "else",
    "while",
    "for",
    "in",
    "return",
    "break",
    "continue",
    "import",
    "export",
    "test",
    "bench",
    "throw",
    "true",
    "false",
    "type"
  ]
}

fn lsp_keyword_items() -> Array[Json] {
  for kw in lsp_keyword_completions() {
    JObj(Map::from_pairs([("label", JStr(kw)), ("kind", jnum_int(14))]))
  }
}

fn lsp_handle_completion(_ source: String) -> Json with Exception {
  let syms = symbol_spans(source)
  let sym_items = for entry in syms {
    let (name, kind, _, _) = entry
    JObj(Map::from_pairs([
      ("label", JStr(name)),
      ("kind", jnum_int(lsp_completion_item_kind(kind)))
    ]))
  }
  JArr(Array::concat(sym_items, lsp_keyword_items()))
}

/// On a parse failure (mid-edit documents are routinely unparseable) degrade
/// to keywords-only rather than an empty list -- same "always well-formed
/// JSON" reasoning as lsp_document_symbol_safe above.
fn lsp_completion_safe(_ source: String) -> Json {
  handle {
    lsp_handle_completion(source)
  } with { Exception::Throw(_) => JArr(lsp_keyword_items()) }
}

/// Identifier byte for the backward callee scan: [A-Za-z0-9_] plus ':' so a
/// qualified callee (String::concat) scans as one token.
fn lsp_is_ident_byte(_ b: Int) -> Bool {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b == 58
}

/// Backward scan from `cursor` for the innermost UNCLOSED '(' -- the call
/// whose argument list the cursor sits in. Returns (open_paren_offset,
/// top_level_commas_passed); open is -1 when the cursor is not inside an
/// argument list (including when the scan walks out of the enclosing block
/// through an unmatched '{'/'['). Purely lexical: does not skip string
/// literals or comments (acceptable for a v1 signature-help heuristic; the
/// worst case is no signature shown).
fn lsp_call_open_paren(source: String, cursor: Int) -> (Int, Int) {
  let mut pos = cursor - 1
  let mut depth = 0
  let mut commas = 0
  let mut open_off = -1
  let mut stopped = false
  while pos >= 0 && open_off < 0 && !stopped {
    let b = String::char_code_at(source, at = pos)
    if b == 41 || b == 93 || b == 125 {
      depth = depth + 1
    } else if b == 40 {
      if depth == 0 {
        open_off = pos
      } else {
        depth = depth - 1
      }
    } else if b == 91 || b == 123 {
      if depth > 0 {
        depth = depth - 1
      } else {
        stopped = true
      }
    } else if b == 44 && depth == 0 {
      commas = commas + 1
    } else {
      ()
    }
    if open_off < 0 {
      pos = pos - 1
    } else {
      ()
    }
  }
  (open_off, commas)
}

/// The checker renders function types as "(A, B) -> R"; collect the
/// top-level comma-separated parameter labels of the FIRST paren group.
fn lsp_signature_param_labels(_ ty: String) -> Array[String] {
  let out = array_empty()
  let len = String::length(ty)
  if len == 0 || String::char_code_at(ty, at = 0) != 40 {
    out
  } else {
    let mut depth = 1
    let mut pos = 1
    let mut seg_start = 1
    let mut done = false
    while pos < len && !done {
      let b = String::char_code_at(ty, at = pos)
      if b == 40 || b == 91 {
        depth = depth + 1
      } else if b == 41 || b == 93 {
        depth = depth - 1
        if depth == 0 {
          if pos > seg_start {
            Array::push(out, value = String::trim(ty[seg_start: pos]))
          } else {
            ()
          }
          done = true
        } else {
          ()
        }
      } else if b == 44 && depth == 1 {
        Array::push(out, value = String::trim(ty[seg_start: pos]))
        seg_start = pos + 1
      } else {
        ()
      }
      pos = pos + 1
    }
    out
  }
}

fn lsp_handle_signature_help(uri: String, source: String, line0: Int, byte_col: Int, checked_error_row: Bool) -> Json with Env + Fs {
  let cursor = lsp_line_start_offset(source = source, line0 = line0) + byte_col
  let (open_off, commas) = lsp_call_open_paren(source = source, cursor = cursor)
  if open_off < 0 {
    JNull
  } else {
    let mut e = open_off
    while e > 0 && (String::char_code_at(source, at = e - 1) == 32 || String::char_code_at(source, at = e - 1) == 9) {
      e = e - 1
    }
    let mut s = e
    while s > 0 && lsp_is_ident_byte(String::char_code_at(source, at = s - 1)) {
      s = s - 1
    }
    if s == e {
      JNull
    } else {
      let name = source[s: e]
      // type_at_source at the USE site reports the enclosing call's RESULT
      // type (the callee ident inside an ECall resolves to what the call
      // yields, e.g. plain "Int" for `add(1, 2)`), not the function type
      // the signature needs. Resolve the callee to its DEFINITION first
      // (same binding_occurrences contract lsp_handle_definition relies on:
      // the first occurrence is the definition) and ask for the type
      // there -- hovering a `let add = (a, b) -> ...` declaration name is
      // exactly the query that renders "(Int, Int) -> Int".
      let (l1, c1) = offset_to_line_col(source = source, offset = s)
      let occ = binding_occurrences(source = source, line = l1, col = c1)
      let (tl, tc) = if Array::length(occ) > 0 {
        let (def_start, _) = Array::get(occ, at = 0)
        offset_to_line_col(source = source, offset = def_start)
      } else {
        (l1, c1)
      }
      let ty = lsp_type_at(uri = uri, source = source, line = tl, col = tc, checked_error_row = checked_error_row)
      if String::length(ty) == 0 {
        JNull
      } else {
        let params = for p in lsp_signature_param_labels(ty) {
          JObj(Map::from_pairs([("label", JStr(p))]))
        }
        JObj(Map::from_pairs([
          ("signatures", JArr([
            JObj(Map::from_pairs([
              ("label", JStr(String::concat(name, String::concat(": ", ty)))),
              ("parameters", JArr(params))
            ]))
          ])),
          ("activeSignature", jnum_int(0)),
          ("activeParameter", jnum_int(commas))
        ]))
      }
    }
  }
}

fn lsp_symbols_for_doc_safe(_ source: String) -> Array[(String, Int, Int, Int)] {
  handle {
    symbol_spans(source)
  } with { Exception::Throw(_) => Array::slice([("", 0, 0, 0)], start = 0, end = 0) }
}

/// Local ASCII fold instead of String::to_lower: to_lower is a PRELUDE
/// function, and while it resolves fine in ordinary user programs (and in
/// the FS-compiled `vibe lsp` binary), the compiler's own MERGED unit
/// (compiler_sources_bundle -- what the s5_entry/s5_wasm tests compile
/// through the library API) does not include the prelude, so a bare call
/// dies there with "undefined variable (local): String::to_lower @call".
/// Symbol names are ASCII identifiers, so an ASCII fold is also correct.
fn lsp_ascii_lower(_ s: String) -> String {
  let len = String::length(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    let code = String::char_code_at(s, at = i)
    let lower = if code >= 65 && code <= 90 {
      code + 32
    } else {
      code
    }
    StringBuilder::push(sb, value = String::from_char_code(lower))
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

fn lsp_query_matches(name: String, query_lower: String) -> Bool {
  String::length(query_lower) == 0 || String::contains(lsp_ascii_lower(name), needle = query_lower)
}

fn lsp_handle_workspace_symbol(query: String, docs: Map[String, String]) -> Json {
  let query_lower = lsp_ascii_lower(query)
  let out = array_empty()
  let uris = Map::keys(docs)
  let mut ui = 0
  while ui < Array::length(uris) {
    let uri = Array::get(uris, at = ui)
    let src = lsp_doc_text(docs = docs, uri = uri)
    let syms = lsp_symbols_for_doc_safe(src)
    let mut si = 0
    while si < Array::length(syms) {
      let (name, kind, start_off, end_off) = Array::get(syms, at = si)
      if lsp_query_matches(name = name, query_lower = query_lower) {
        let ps = lsp_offset_to_pos(source = src, offset = start_off)
        let pe = lsp_offset_to_pos(source = src, offset = end_off)
        Array::push(out, value = JObj(Map::from_pairs([
          ("name", JStr(name)),
          ("kind", jnum_int(kind)),
          ("location", jlocation(uri = uri, r = jrange_pos(p1 = ps, p2 = pe)))
        ])))
      } else {
        ()
      }
      si = si + 1
    }
    ui = ui + 1
  }
  JArr(out)
}

/// Which `Lsp` operation a given dispatch should perform -- see
/// lsp_run_with_handler's own doc comment for why this is a plain Int tag
/// rather than a closure value.
fn lsp_op_hover() -> Int {
  0
}
fn lsp_op_definition() -> Int {
  1
}
fn lsp_op_references() -> Int {
  2
}
fn lsp_op_rename() -> Int {
  3
}
fn lsp_op_document_symbol() -> Int {
  4
}
fn lsp_op_diagnostics() -> Int {
  5
}
fn lsp_op_completion() -> Int {
  6
}
fn lsp_op_signature_help() -> Int {
  7
}
fn lsp_op_workspace_symbol() -> Int {
  8
}

/// The one place all six `Lsp` operations are actually implemented, and the
/// only place any of them is `perform`ed. `docs` is threaded in by
/// reference (an ordinary mutable-variable capture from the caller's scope,
/// per this file's own doc comment: document state is plain mutable state,
/// not itself effect-modeled -- the `Lsp` effect models the COMPILER-QUERY
/// capability, not the document store).
///
/// Earlier revision dispatched via a `body: () -> Json with Lsp`
/// closure PARAMETER (`lsp_dispatch_request` built a one-line closure
/// literal per call site and passed it in here to be perform'd) -- this
/// compiled but trapped ("indirect call type mismatch") at runtime the
/// moment it actually ran under real wasmtime (via viberun; confirmed
/// empirically, not caught by the Node dev-runner's own separate test
/// harness). Root cause: an effectful closure captured BY VALUE and invoked
/// through an opaque higher-order-function parameter is exactly the still-
/// open GENERAL case issue #1070 documents (distinct from, and not covered
/// by, this session's earlier #1070 fix for a NEEDING function calling its
/// own closure-typed parameter -- lsp_run_with_handler isn't itself
/// "needing" anything, since it fully discharges `Lsp` right here; nothing
/// downstream of it needs an evidence dict at all). Restructured so
/// `perform` and `handle` are always textually co-located in the SAME
/// function body (an `if`/`else` chain choosing which bare `perform`
/// executes, driven by `op` -- an ordinary Int, never a closure) --
/// precisely the "handle site sees the perform directly, no function-call
/// boundary in between" case ADR-0076 (docs/internal/design/effect-evidence-passing.md)
/// documents as never needing an evidence dict or any closure-value
/// machinery at all, and the only shape actually exercised (transitively,
/// via #1069/#1070/#1074's whole regression corpus) under real wasmtime so
/// far. Each `if` branch's body is EXACTLY one bare perform -- replay-safe
/// by the same reasoning as every other handle in this file (see the
/// header comment): re-executing the branch on `resume` re-evaluates the
/// same deterministic `op` comparison and re-reaches the same (memoized)
/// perform, nothing else.
fn lsp_run_with_handler(op: Int, uri: String, l: Int, c: Int, new_name: String, docs: Map[String, String], checked_error_row: Bool) -> Json with Env + Fs {
  handle {
    if op == lsp_op_hover() {
      perform Lsp::Hover(uri, l, c)
    } else if op == lsp_op_definition() {
      perform Lsp::Definition(uri, l, c)
    } else if op == lsp_op_references() {
      perform Lsp::References(uri, l, c)
    } else if op == lsp_op_rename() {
      perform Lsp::Rename(uri, l, c, new_name)
    } else if op == lsp_op_document_symbol() {
      perform Lsp::DocumentSymbol(uri)
    } else if op == lsp_op_completion() {
      perform Lsp::Completion(uri, l, c)
    } else if op == lsp_op_signature_help() {
      perform Lsp::SignatureHelp(uri, l, c)
    } else if op == lsp_op_workspace_symbol() {
      perform Lsp::WorkspaceSymbol(new_name)
    } else {
      perform Lsp::Diagnostics(uri)
    }
  } with { Lsp::Hover(u2, l2, c2) => resume({
    let src = lsp_doc_text(docs = docs, uri = u2)
    lsp_handle_hover(uri = u2, source = src, line0 = l2, char0 = lsp_pos_to_byte_col(source = src, line0 = l2, utf16_char0 = c2), checked_error_row = checked_error_row)
  }); Lsp::Definition(u2, l2, c2) => resume({
    let src = lsp_doc_text(docs = docs, uri = u2)
    lsp_handle_definition(source = src, uri = u2, line0 = l2, char0 = lsp_pos_to_byte_col(source = src, line0 = l2, utf16_char0 = c2))
  }); Lsp::References(u2, l2, c2) => resume({
    let src = lsp_doc_text(docs = docs, uri = u2)
    lsp_handle_references(source = src, uri = u2, line0 = l2, char0 = lsp_pos_to_byte_col(source = src, line0 = l2, utf16_char0 = c2))
  }); Lsp::Rename(u2, l2, c2, nn) => resume({
    let src = lsp_doc_text(docs = docs, uri = u2)
    lsp_handle_rename(source = src, uri = u2, line0 = l2, char0 = lsp_pos_to_byte_col(source = src, line0 = l2, utf16_char0 = c2), new_name = nn)
  }); Lsp::DocumentSymbol(u2) => resume(lsp_document_symbol_safe(lsp_doc_text(docs = docs, uri = u2))); Lsp::Diagnostics(u2) => resume(lsp_document_diagnostics_safe(uri = u2, source = lsp_doc_text(docs = docs, uri = u2), allow_unstable = lsp_unstable_opt_in(), checked_error_row = checked_error_row)); Lsp::Completion(u2, _, _) => resume(lsp_completion_safe(lsp_doc_text(docs = docs, uri = u2))); Lsp::SignatureHelp(u2, l2, c2) => resume({
    let src = lsp_doc_text(docs = docs, uri = u2)
    lsp_handle_signature_help(uri = u2, source = src, line0 = l2, byte_col = lsp_pos_to_byte_col(source = src, line0 = l2, utf16_char0 = c2), checked_error_row = checked_error_row)
  }); Lsp::WorkspaceSymbol(q) => resume(lsp_handle_workspace_symbol(query = q, docs = docs)) }
}

fn lsp_doc_text(docs: Map[String, String], uri: String) -> String {
  if Map::has_key(docs, key = uri) {
    Map::get(docs, key = uri)
  } else {
    ""
  }
}

//# Method dispatch: JSON-RPC method name -> Lsp effect operation

fn lsp_capabilities() -> Json {
  JObj(Map::from_pairs([
    ("textDocumentSync", jnum_int(1)),
    ("hoverProvider", JBool(true)),
    ("definitionProvider", JBool(true)),
    ("referencesProvider", JBool(true)),
    ("renameProvider", JBool(true)),
    ("documentSymbolProvider", JBool(true)),
    ("completionProvider", JObj(Map::from_pairs([
      ("triggerCharacters", JArr([JStr("."), JStr(":")]))
    ]))),
    ("signatureHelpProvider", JObj(Map::from_pairs([
      ("triggerCharacters", JArr([JStr("("), JStr(",")]))
    ]))),
    ("workspaceSymbolProvider", JBool(true))
  ]))
}

fn lsp_initialize_result() -> Json {
  JObj(Map::from_pairs([
    ("capabilities", lsp_capabilities()),
    ("serverInfo", JObj(Map::from_pairs([
      ("name", JStr("vibe-lsp-selfhost")),
      ("version", JStr("0.1.0"))
    ])))
  ]))
}

/// Handles one Request (has an `id`, needs a response) or Notification (no
/// response). Returns Some(result_json) for a request, None for a
/// notification or an unrecognized method the caller already replied `null`
/// to.
fn lsp_dispatch_request(method: String, params: Json, docs: Map[String, String], checked_error_row: Bool) -> Json with Env + Fs {
  if method == "initialize" {
    lsp_initialize_result()
  } else if method == "textDocument/hover" {
    let uri = jparam_uri(params)
    let l = jparam_line0(params)
    let c = jparam_char0(params)
    lsp_run_with_handler(op = lsp_op_hover(), uri = uri, l = l, c = c, new_name = "", docs = docs, checked_error_row = checked_error_row)
  } else if method == "textDocument/definition" {
    let uri = jparam_uri(params)
    let l = jparam_line0(params)
    let c = jparam_char0(params)
    lsp_run_with_handler(op = lsp_op_definition(), uri = uri, l = l, c = c, new_name = "", docs = docs, checked_error_row = checked_error_row)
  } else if method == "textDocument/references" {
    let uri = jparam_uri(params)
    let l = jparam_line0(params)
    let c = jparam_char0(params)
    lsp_run_with_handler(op = lsp_op_references(), uri = uri, l = l, c = c, new_name = "", docs = docs, checked_error_row = checked_error_row)
  } else if method == "textDocument/rename" {
    let uri = jparam_uri(params)
    let l = jparam_line0(params)
    let c = jparam_char0(params)
    let new_name = Json::string(Json::field(params, key = "newName"))
    lsp_run_with_handler(op = lsp_op_rename(), uri = uri, l = l, c = c, new_name = new_name, docs = docs, checked_error_row = checked_error_row)
  } else if method == "textDocument/documentSymbol" {
    let uri = jparam_uri(params)
    lsp_run_with_handler(op = lsp_op_document_symbol(), uri = uri, l = 0, c = 0, new_name = "", docs = docs, checked_error_row = checked_error_row)
  } else if method == "textDocument/completion" {
    let uri = jparam_uri(params)
    let l = jparam_line0(params)
    let c = jparam_char0(params)
    lsp_run_with_handler(op = lsp_op_completion(), uri = uri, l = l, c = c, new_name = "", docs = docs, checked_error_row = checked_error_row)
  } else if method == "textDocument/signatureHelp" {
    let uri = jparam_uri(params)
    let l = jparam_line0(params)
    let c = jparam_char0(params)
    lsp_run_with_handler(op = lsp_op_signature_help(), uri = uri, l = l, c = c, new_name = "", docs = docs, checked_error_row = checked_error_row)
  } else if method == "workspace/symbol" {
    let q = Json::string(Json::field(params, key = "query"))
    lsp_run_with_handler(op = lsp_op_workspace_symbol(), uri = "", l = 0, c = 0, new_name = q, docs = docs, checked_error_row = checked_error_row)
  } else if method == "shutdown" {
    JNull
  } else {
    JNull
  }
}

/// One request against a document store, exactly as the session loop dispatches
/// it -- the seam a session test drives without a JSON-RPC transport.
export fn lsp_request(method: String, params: Json, docs: Map[String, String], checked_error_row: Bool) -> Json with Env + Fs {
  lsp_dispatch_request(method = method, params = params, docs = docs, checked_error_row = checked_error_row)
}

/// The store after one `textDocument/didOpen` / `didChange` / `didClose`
/// notification, as the session loop applies it (the diagnostics it would
/// publish are not computed here). Any other method leaves the store as it is.
export fn lsp_notify(method: String, params: Json, docs: Map[String, String]) -> Map[String, String] {
  if method == "textDocument/didOpen" {
    lsp_apply_did_open(docs = docs, params = params)
  } else if method == "textDocument/didChange" {
    lsp_apply_did_change(docs = docs, params = params)
  } else if method == "textDocument/didClose" {
    lsp_apply_did_close(docs = docs, params = params)
  } else if method == "textDocument/didSave" || method == "workspace/didChangeWatchedFiles" {
    lsp_hover_fs_invalidate()
    docs
  } else {
    docs
  }
}

fn lsp_diagnostics_for(uri: String, docs: Map[String, String], checked_error_row: Bool) -> Json with Env + Fs {
  lsp_run_with_handler(op = lsp_op_diagnostics(), uri = uri, l = 0, c = 0, new_name = "", docs = docs, checked_error_row = checked_error_row)
}

/// The diagnostics the session loop publishes for `uri` after a `didOpen`,
/// `didChange` or `didSave` -- the seam a session test reads them through
/// (#4013).
export fn lsp_published_diagnostics(uri: String, docs: Map[String, String], checked_error_row: Bool) -> Json with Env + Fs {
  lsp_diagnostics_for(uri = uri, docs = docs, checked_error_row = checked_error_row)
}

//# Document store (plain mutable state -- see the effect handler's own doc
//# comment for why this is deliberately NOT effect-modeled)

fn lsp_apply_did_open(docs: Map[String, String], params: Json) -> Map[String, String] {
  lsp_hover_fs_invalidate()
  let uri = jparam_uri(params)
  let text = Json::string(Json::field(Json::field(params, key = "textDocument"), key = "text"))
  Map::set(docs, key = uri, value = text)
}

fn lsp_apply_did_change(docs: Map[String, String], params: Json) -> Map[String, String] {
  let uri = jparam_uri(params)
  let changes = Json::field(params, key = "contentChanges")
  if Json::length(changes) == 0 {
    docs
  } else {
    // Full-document sync (declared capability): the last change entry's
    // `text` is the WHOLE new document, matching textDocumentSync=1.
    let last = Json::index(changes, idx = Json::length(changes) - 1)
    let text = Json::string(Json::field(last, key = "text"))
    Map::set(docs, key = uri, value = text)
  }
}

fn lsp_apply_did_close(docs: Map[String, String], params: Json) -> Map[String, String] {
  let uri = jparam_uri(params)
  lsp_hover_memo_release(lsp_doc_text(docs = docs, uri = uri))
  let (fs_uri, fs_path) = Array::get(lsp_hover_fs_doc, at = 0)
  match Array::get(lsp_hover_fs, at = 0) {
    Some(session) => if fs_uri == uri {
      type_at_fs_session_release(session = session, path = fs_path)
    } else (),
    None => ()
  }
  Map::delete(docs, key = uri)
}

//# JSON-RPC envelope (built directly on Json/Json::field -- see this
//# file's import comment for why @vibe/json/jsonrpc.vibe's own RpcMessage/
//# RpcId codec is deliberately not used here)

/// JNull on malformed JSON (Json::parse's own contract) -- lsp_env_method
/// below then reads as "" for such a message, which lsp_step's dispatch
/// already treats as a no-op.
fn lsp_parse_envelope(_ body: String) -> Json {
  Json::parse(body)
}

fn lsp_env_method(_ j: Json) -> String {
  Json::string(Json::field(j, key = "method"))
}

fn lsp_env_params(_ j: Json) -> Json {
  Json::field(j, key = "params")
}

/// The raw `id` value (JNum/JStr), passed straight back into the response
/// envelope -- LSP/JSON-RPC ids round-trip opaquely, no need to model RpcId.
fn lsp_env_id(_ j: Json) -> Json {
  Json::field(j, key = "id")
}

/// A message with a non-null `id` is a request (expects a response); one
/// with no/null `id` is a notification. (JSON-RPC technically allows a null
/// `id` ON a request too, an edge case no real LSP client sends -- treating
/// it as a notification here just means we silently skip replying to a
/// message that, practically, never occurs.)
fn lsp_env_is_request(_ j: Json) -> Bool {
  String::length(lsp_env_method(j)) > 0 && !Json::is_null(lsp_env_id(j))
}

fn lsp_env_is_notification(_ j: Json) -> Bool {
  String::length(lsp_env_method(j)) > 0 && Json::is_null(lsp_env_id(j))
}

fn lsp_stringify_response(id: Json, result: Json) -> String {
  Json::stringify(JObj(Map::from_pairs([
    ("jsonrpc", JStr("2.0")),
    ("id", id),
    ("result", result)
  ])))
}

fn lsp_stringify_notification(method: String, params: Json) -> String {
  Json::stringify(JObj(Map::from_pairs([
    ("jsonrpc", JStr("2.0")),
    ("method", JStr(method)),
    ("params", params)
  ])))
}

//# Main loop

fn lsp_send_response(id: Json, result: Json) -> Unit with Console {
  lsp_write_message(lsp_stringify_response(id = id, result = result))
}

fn lsp_send_diagnostics_notification(uri: String, diags: Json) -> Unit with Console {
  let params = JObj(Map::from_pairs([("uri", JStr(uri)), ("diagnostics", diags)]))
  lsp_write_message(lsp_stringify_notification(method = "textDocument/publishDiagnostics", params = params))
}

/// One iteration: read a message, act on it, write a response if needed.
/// Returns (new_docs, should_exit).
fn lsp_step(_ docs: Map[String, String], checked_error_row: Bool) -> (Map[String, String], Bool) with Stdin + Console + Env + Fs {
  match lsp_read_message() {
    None => (docs, true),
    Some(body) => {
      let msg = lsp_parse_envelope(body)
      if lsp_env_is_request(msg) {
        let method = lsp_env_method(msg)
        let params = lsp_env_params(msg)
        let id = lsp_env_id(msg)
        let result = lsp_dispatch_request(method = method, params = params, docs = docs, checked_error_row = checked_error_row)
        lsp_send_response(id = id, result = result)
        // Per the LSP spec's shutdown sequence: reply to `shutdown`, then
        // keep serving (a well-behaved client sends nothing further, but
        // MUST NOT see the connection close before its own `exit`
        // notification arrives) until `exit` actually terminates the loop
        // below. Terminating right here used to close stdout mid-teardown
        // from the client's point of view.
        (docs, false)
      } else if lsp_env_is_notification(msg) {
        let method = lsp_env_method(msg)
        let params = lsp_env_params(msg)
        if method == "exit" {
          (docs, true)
        } else if method == "initialized" {
          (docs, false)
        } else if method == "textDocument/didOpen" {
          let new_docs = lsp_apply_did_open(docs = docs, params = params)
          let uri = jparam_uri(params)
          lsp_send_diagnostics_notification(uri = uri, diags = lsp_diagnostics_for(uri = uri, docs = new_docs, checked_error_row = checked_error_row))
          (new_docs, false)
        } else if method == "textDocument/didChange" {
          let new_docs = lsp_apply_did_change(docs = docs, params = params)
          let uri = jparam_uri(params)
          lsp_send_diagnostics_notification(uri = uri, diags = lsp_diagnostics_for(uri = uri, docs = new_docs, checked_error_row = checked_error_row))
          (new_docs, false)
        } else if method == "textDocument/didSave" {
          lsp_hover_fs_invalidate()
          let uri = jparam_uri(params)
          lsp_send_diagnostics_notification(uri = uri, diags = lsp_diagnostics_for(uri = uri, docs = docs, checked_error_row = checked_error_row))
          (docs, false)
        } else if method == "textDocument/didClose" {
          let new_docs = lsp_apply_did_close(docs = docs, params = params)
          let uri = jparam_uri(params)
          lsp_send_diagnostics_notification(uri = uri, diags = JArr([]))
          (new_docs, false)
        } else if method == "workspace/didChangeWatchedFiles" {
          lsp_hover_fs_invalidate()
          (docs, false)
        } else {
          (docs, false)
        }
      } else {
        // No method (a response to a request WE sent, or malformed JSON) --
        // this server issues no client-bound requests in v1, so there is
        // nothing to correlate a reply against; nothing to do.
        (docs, false)
      }
    }
  }
}

/// `allow_unstable` is read by the CALLER (cli_adapter), once, at server start:
/// authority is settled in the earliest phase rather than re-read per request
/// (ADR-0075/0084/0088). The `Env + Fs` on the row is the import-resolving
/// hover's (#1960): it walks the document's imports on disk, reading the
/// same build configuration `vibe check` reads.
export fn lsp_main(_ allow_unstable: Bool, checked_error_row: Bool) -> Int with Stdin + Console + Env + Fs {
  Array::set(lsp_unstable_cell, at = 0, value = allow_unstable)
  let mut docs = Map::new()
  let mut running = true
  while running {
    let (new_docs, should_exit) = lsp_step(docs, checked_error_row = checked_error_row)
    docs = new_docs
    running = not(should_exit)
  }
  0
}
