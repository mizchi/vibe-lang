name = @vibe/lsp
version = 0.0.1
description =
  #|@vibe/lsp — self-hosted `vibe lsp` Language Server Protocol server
  #|(JSON-RPC 2.0 / Content-Length transport, initialize/hover/definition/
  #|references/rename/documentSymbol/diagnostics/completion/signatureHelp/
  #|workspaceSymbol).
deps = {
  @vibe/compiler/runtime : 0.0.1
  @vibe/core : 0.2.0
  @vibe/json : 0.0.1
  @vibe/parser : 0.1.0
}

generated_hash =

// @vibe/lsp — extracted out of lib/@vibe/compiler/ (compiler 本体 のみを
// 置く場所, docs/adding-modules.md) so its effect surface reads as an
// ordinary package boundary rather than compiler-internal code: the whole
// file only ever consumes @vibe/compiler/runtime's PUBLIC contract
// (type_at_source / binding_occurrences / symbol_spans / doc_at_source /
// collect_all_diagnostics), never compiler internals, so nothing about the
// implementation actually required living inside lib/@vibe/compiler/.
//
// The `Lsp` effect itself (Hover/Definition/References/Rename/
// DocumentSymbol/Diagnostics/Completion/SignatureHelp/WorkspaceSymbol) is
// declared and fully discharged inside lsp_server.vibe's own
// `lsp_run_with_handler` — see that function's doc comment for why
// perform/handle stay textually co-located there (replay-safety, and the
// #1070 effectful-closure-parameter trap this file already worked around
// once). It never crosses this package's boundary, so it is deliberately
// NOT part of the contract below.

fn lsp_main(allow_unstable: Bool) -> Int with Stdin + Stdout
fn lsp_diagnostics_safe(source: String) -> Json
fn lsp_diagnostics_safe_with_unstable(source: String, allow_unstable: Bool) -> Json
fn lsp_diagnostics_safe_for_path(input_path: String, source: String, allow_unstable: Bool) -> Json
fn lsp_diagnostics_json_string(source: String) -> String
fn lsp_diagnostics_json_string_with(source: String, extra: Array[String]) -> String
fn lsp_diagnostics_json_string_with_for_path(input_path: String, source: String, extra: Array[String]) -> String
