name = @vibe/ast
version = 0.2.0
description =
  #|@vibe/ast — the vibe surface-syntax AST (ADR-0065 Phase 3, #753).
deps = {}

generated_hash =

// @vibe/ast — the vibe surface-syntax AST (ADR-0065 Phase 3, #753).
// The top level of this contract IS the package: the AST enums are
// TRANSPARENT type definitions (checker/codegen/printer pattern-match and
// construct them, so the definition itself is the public contract — changing
// a variant is a breaking change by construction). The implementation stub
// exists only so the explicit impl import suppresses sibling auto-discovery
// (tests beside this file must not join the facade).
//
// Node shapes deliberately expose the compiler's internal representation
// (e.g. the Int byte-offset slot on EIdent/ECall/EDot): this package is the
// compiler's own working AST, not an abstraction over it. Consumers that
// need stability should pin (#751).

export enum Pat {
  PWild;
  PBind(String);
  PInt(Int);
  PFloat(Double);
  PString(String);
  PBool(Bool);
  PCtor(String, Array[Pat]);
  PTuple(Array[Pat]);
  POr(Pat, Pat);
  PStruct(String, Array[(String, Pat)])
}

export enum TypeExpr {
  TyName(String);
  TyApp(String, Array[TypeExpr]);
  TyFn(Array[TypeExpr], TypeExpr, Option[String]);
  TyTuple(Array[TypeExpr]);
  TyUnit
}

export enum Expr {
  EInt(Int);
  EFloat(Double);
  EString(String);
  EBool(Bool);
  EIdent(String, Int);
  ETuple(Array[Expr]);
  EArray(Array[Expr]);
  // #886: the third slot carries EXPLICIT struct type arguments
  // (`Pair[Int]::{ .. }`); empty for the inferred form (`Pair::{ .. }`,
  // #829's field-driven instantiation) and for anonymous `record { .. }`.
  ERecord(String, Array[(String, Expr)], Array[TypeExpr]);
  EIf(Expr, Expr, Expr);
  ELet(String, Expr, Expr, Int);
  ELetRec(String, Expr, Expr);
  ELetMut(String, Expr, Expr, Int);
  EAssign(String, Expr, Expr);
  EAssignOp(String, String, Expr, Expr);
  ESeq(Expr, Expr);
  EMatch(Expr, Array[(Pat, Expr)]);
  EHandle(Expr, Array[(Pat, Expr)]);
  EWhile(Expr, Expr);
  ELoop(Array[(String, Expr)], Expr);
  EForIn(String, Option[String], Expr, Expr);
  ECall(Expr, Array[Expr], Int);
  EBinOp(String, Expr, Expr);
  EUnaryOp(String, Expr);
  EFn(Array[String], Array[(String, Array[String])], Array[(String, Option[TypeExpr])], Option[TypeExpr], Option[String], Expr);
  EDot(Expr, String, Int, Int);
  ELabeledArg(String, String, Expr);
  EReturn(Expr);
  EBreak(Option[Expr]);
  EContinue(Array[Expr]);
  EMap(Array[(String, Expr)]);
  ESpread(Expr);
  EStringInterp(Array[String]);
  EUnit
}

export enum Stmt {
  SLet(Bool, Bool, String, Option[TypeExpr], Expr);
  SLetMut(String, Option[TypeExpr], Expr);
  SEnum(Bool, String, Array[String], Array[(String, Array[TypeExpr])], Array[String]);
  SSuberror(Bool, String, Array[(String, Array[TypeExpr])]);
  // #829: (exported, name, fields, derives, mut field names, type params).
  // Type params are APPENDED so positional matches of the older 5-field form
  // stay aligned.
  SStruct(Bool, String, Array[(String, TypeExpr)], Array[String], Array[String], Array[String]);
  STypeAlias(Bool, String, Array[String], TypeExpr);
  // (exported, name, supers, methods, method generic metadata, header params).
  // Header params are appended so the older five slots keep their meanings.
  STrait(Bool, String, Array[String], Array[(String, Array[TypeExpr], TypeExpr)], Array[(String, Array[String], Array[(String, Array[String])])], Array[String]);
  SImpl(Array[String], Array[(String, Array[String])], String, String);
  SExternLet(String, TypeExpr);
  SImport(String, Array[(String, Option[String])]);
  STest(String, Expr);
  SBench(String, Expr);
  // #819: a documentation example. Structurally a test, but kept as its own
  // node so tooling (LSP hover, doc extraction) can tell an example from a
  // test. It NEVER reaches the checker or codegen: the default parse entry
  // points lower it to STest, exactly as SFnDecl lowers to SLet -- see
  // lower_fn_decl_stmt. That is deliberate: every one of the ~106 STest sites
  // is a structural `STest(_, body) => recurse` walk, and several sit in
  // matches with a `_` catch-all, so a variant that reached them would be
  // silently skipped by whichever site forgot it (unchecked, or never
  // compiled) rather than caught.
  SExample(String, Expr);
  SExpr(Expr);
  SExport(Array[String]);
  SReExport(String, Array[(String, Option[String])]);
  SAliasDecl(String, String);
  SLetPat(Pat, Expr);
  SModule(Bool, String, Array[Stmt]);
  SEffectDef(Bool, String, Array[String], Array[(String, Array[TypeExpr], TypeExpr)]);
  // ADR-0071 (#755, docs/effectset.md) step 2: `effectset Name = { A, B,
  // Effect::op }` -- a named, reusable set of effect-row items (effect
  // names, qualified operations, or other effectset names). Fields:
  // (exported, name -- possibly qualified as `Effect::Name`, member items
  // -- each the exact same row-item text collect_effect_names produces,
  // i.e. a bare identifier or an `Effect::op` qualified string). No type
  // params yet (generic effectsets like `State::Read[T]` are deferred).
  // Parser + printer only as of this revision -- resolution (expanding
  // members recursively, cycle/collision detection) is a separate,
  // not-yet-implemented step; see checker_stmt.vibe's explicit rejection.
  SEffectSet(Bool, String, Array[String]);
  // ADR-0064 (#727/#731): a `fn` declaration kept in declaration form —
  // (exported, name, EFn value, requires conditions, ensures conditions).
  // The parser's default program entry points lower this to the legacy
  // `SLet(exported, true, name, None, EFn(..))` shape (contracts desugared
  // to runtime asserts) via lower_fn_decl_stmt BEFORE checker/codegen, so
  // only the printer / normalize (which parse with the *_preserving entry
  // points) ever see this constructor.
  SFnDecl(Bool, String, Expr, Array[Expr], Array[Expr])
}
