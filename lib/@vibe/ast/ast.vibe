// @vibe/ast implementation stub (#753). The package's public surface is the
// transparent type definitions in index.vibei; this file carries the one
// declared value (version) and, as the explicit impl import target,
// suppresses sibling auto-discovery (test files beside the contract must
// not join the facade).

let type_param_kind_prefix = "$type_param$"

/// #3132: the source offset a COMPILER-SYNTHESIZED reference to a builtin
/// carries. A program may define its own `Array::length`; the compiler moves
/// that definition, and every reference the program wrote, aside to a name of
/// its own, and leaves a reference carrying this offset meaning the builtin.
/// An offset of -1 cannot mean that: interpolation re-parses the program's own
/// expressions without offsets, and the library lanes parse whole programs
/// that way. A real offset is never negative, so -2 collides with none.
export fn builtin_ref_offset() -> Int {
  0 - 2
}

/// A reference to the BUILTIN `name`, whatever the program being compiled
/// defines. Every pass that synthesizes a call to a builtin the compiler
/// calls by name spells it this way (scripts/review_lint.vibex refuses a bare
/// `EIdent("Array::get", ...)` outside codegen).
export fn builtin_ref(name: String) -> Expr {
  EIdent(name, builtin_ref_offset())
}

/// Canonical AST key for a type parameter and its constructor arity.
/// Arity-zero parameters keep their historical spelling so old artifacts and
/// consumers remain readable. The prefix is not a source identifier, so an
/// encoded constructor binder cannot collide with user code.
export fn type_param_key(name: String, arity: Int) -> String {
  if arity <= 0 {
    name
  } else {
    String::concat(type_param_kind_prefix, String::concat(Int::to_string(arity), String::concat("$", name)))
  }
}

fn type_param_kind_split(key: String) -> Option[(String, Int)] {
  if !String::starts_with(key, type_param_kind_prefix) {
    None
  } else {
    let mut pos = String::length(type_param_kind_prefix)
    let mut arity = 0
    let mut digits = 0
    while pos < String::length(key) && String::char_code_at(key, pos) >= '0' && String::char_code_at(key, pos) <= '9' {
      arity = arity * 10 + String::char_code_at(key, pos) - '0'
      digits = digits + 1
      pos = pos + 1
    }
    if digits == 0 || arity <= 0 || pos >= String::length(key) || String::char_code_at(key, pos) != '$' {
      None
    } else {
      Some((String::substring(key, pos + 1, String::length(key)), arity))
    }
  }
}

export fn type_param_name(key: String) -> String {
  match type_param_kind_split(key) {
    Some(pair) => pair.0,
    None => key
  }
}

export fn type_param_arity(key: String) -> Int {
  match type_param_kind_split(key) {
    Some(pair) => pair.1,
    None => 0
  }
}

export fn impl_target_head(target: TypeExpr) -> String {
  match target {
    TyName(name) => name,
    TyApp(name, _) => name,
    _ => ""
  }
}

let impl_encoded_byte_names: Array[String] = []

// The representation is byte-wise decimal plus an underscore. Prepare the
// fixed 256 spellings once; repeated type names need no integer-to-string
// allocation per byte, and each builder slot carries the whole spelling.
fn impl_prepare_byte_names() -> Unit {
  if Array::length(impl_encoded_byte_names) == 0 {
    let mut byte = 0
    while byte < 256 {
      Array::push(impl_encoded_byte_names, String::concat(Int::to_string(byte), "_"))
      byte = byte + 1
    }
  } else ()
}

export fn impl_encode_name(name: String) -> String {
  impl_prepare_byte_names()
  let buf = StringBuilder::new()
  let mut i = 0
  while i < String::length(name) {
    StringBuilder::push(buf, Array::get(impl_encoded_byte_names, String::char_code_at(name, i)))
    i = i + 1
  }
  StringBuilder::freeze(buf)
}

/// #3133: the `__index` callee of `xs[k]` is synthetic -- no identifier is
/// written there -- so its offset slot carries the `[` token's offset as a
/// KEY, encoded below `builtin_ref_offset()`. Every location consumer (hover,
/// references, `vibe grep` spans, typed-lowering keys) reads only offsets >= 0,
/// so none of them mistakes the key for a 7-byte `__index` name at the
/// bracket; the checker and the trait-dictionary pass decode it with
/// `index_site_offset`. The callee is also a compiler-synthesized reference to
/// the builtin (#3132): every key is <= `builtin_ref_offset()`, and
/// `is_builtin_ref_offset` answers true for all of them, so a program's own
/// `__index` never captures the sugar. An unlocated bracket keeps the plain
/// `builtin_ref_offset()`.
export fn index_site_key(bracket_off: Int) -> Int {
  if bracket_off < 0 {
    builtin_ref_offset()
  } else {
    0 - bracket_off - 3
  }
}

/// #3133: the `[` offset an `__index` callee's slot carries, or -1.
export fn index_site_offset(key: Int) -> Int {
  if key <= 0 - 3 {
    0 - key - 3
  } else {
    0 - 1
  }
}

/// #3132/#3133: whether an identifier's offset marks a compiler-synthesized
/// reference to the builtin -- `builtin_ref` itself, or an index site key.
export fn is_builtin_ref_offset(off: Int) -> Bool {
  off <= builtin_ref_offset()
}

/// #3185: a reference to the BUILTIN `name` that stands for a source
/// construct beginning at `off` -- `region r { .. }` is the builtin
/// `__region_run` called at the `region` keyword. The offset slot carries
/// `off` as a key in the same encoding as `index_site_key`, so
/// `is_builtin_ref_offset` marks the reference as the builtin's (a program's
/// own `fn __region_run` does not capture the syntax) while the checker can
/// still anchor a diagnostic at the construct through `index_site_offset`.
export fn builtin_ref_at(name: String, off: Int) -> Expr {
  EIdent(name, index_site_key(off))
}

/// `xs[k]`'s callee: the builtin `__index`, keyed by the `[` offset (#3133).
export fn index_ref(bracket_off: Int) -> Expr {
  EIdent("__index", index_site_key(bracket_off))
}

/// #3139: the callee of the `Array::set` that an index WRITE (`xs[i] = v`)
/// desugars to. It inherits the index's `[` key from the `__index` callee it
/// replaces, so the checker files the write's receiver under the same site
/// the read would have used. Like the read, it is a compiler-synthesized
/// reference to the builtin (#3132): its offset is always
/// `<= builtin_ref_offset()`.
export fn index_write_callee(index_callee: Expr) -> Expr {
  let key = match index_callee {
    EIdent(_, k) => if is_builtin_ref_offset(k) {
      k
    } else {
      builtin_ref_offset()
    },
    _ => builtin_ref_offset()
  }
  EIdent("Array::set", key)
}

// Append the canonical key into one builder. Nested targets do not need
// temporary keys or copies of an increasingly long parameter prefix.
fn impl_write_name(buf: StringBuilder, name: String) -> Unit {
  let mut i = 0
  while i < String::length(name) {
    StringBuilder::push(buf, Array::get(impl_encoded_byte_names, String::char_code_at(name, i)))
    i = i + 1
  }
}

fn impl_write_target_key(buf: StringBuilder, target: TypeExpr) -> Unit {
  match target {
    TyName(name) => {
      StringBuilder::push(buf, "N")
      impl_write_name(buf, name)
      StringBuilder::push(buf, "Z")
    },
    TyApp(name, args) => {
      StringBuilder::push(buf, "A")
      impl_write_name(buf, name)
      StringBuilder::push(buf, "L")
      for arg in args {
        impl_write_target_key(buf, arg)
      }
      StringBuilder::push(buf, "R")
    },
    TyFn(params, ret, effect) => {
      StringBuilder::push(buf, "F")
      for param in params {
        impl_write_target_key(buf, param)
      }
      StringBuilder::push(buf, "T")
      impl_write_target_key(buf, ret)
      match effect {
        None => StringBuilder::push(buf, "E0"),
        Some(name) => {
          StringBuilder::push(buf, "E1")
          impl_write_name(buf, name)
          StringBuilder::push(buf, "Z")
        }
      }
      StringBuilder::push(buf, "R")
    },
    TyTuple(items) => {
      StringBuilder::push(buf, "P")
      for item in items {
        impl_write_target_key(buf, item)
      }
      StringBuilder::push(buf, "R")
    },
    TyUnit => StringBuilder::push(buf, "U")
  }
}

// Pure keys may be reused across compiles, but caller-owned argument arrays
// may change. Store a deep copy of each eligible small target, never its
// mutable arrays. The fixed entry/node/name limits bound retained memory.
let impl_key_targets: Array[TypeExpr] = []
let impl_key_values: Array[String] = []
let impl_key_next: Array[Int] = []
let impl_key_heads: Array[Int] = []

fn impl_key_cost(target: TypeExpr, budget: Int) -> Int {
  if budget <= 0 {
    return -1
  } else ()
  match target {
    TyName(n) => if String::length(n) <= 128 {
      1
    } else {
      -1
    },
    TyUnit => 1,
    TyApp(n, args) => if String::length(n) > 128 {
      -1
    } else {
      impl_key_list_cost(args, budget)
    },
    TyTuple(items) => impl_key_list_cost(items, budget),
    TyFn(params, ret, effect) => {
      let effect_ok = match effect {
        None => true,
        Some(n) => String::length(n) <= 128
      }
      let cost = impl_key_list_cost(params, budget)
      if !effect_ok || cost < 0 {
        -1
      } else {
        let rc = impl_key_cost(ret, budget - cost)
        if rc < 0 {
          -1
        } else {
          cost + rc
        }
      }
    }
  }
}

fn impl_key_list_cost(items: Array[TypeExpr], budget: Int) -> Int {
  let mut used = 1
  let mut i = 0
  while i < Array::length(items) {
    let cost = impl_key_cost(Array::get(items, i), budget - used)
    if cost < 0 {
      return -1
    } else ()
    used = used + cost
    i = i + 1
  }
  used
}

fn impl_key_copy(target: TypeExpr) -> TypeExpr {
  match target {
    TyName(n) => TyName(n),
    TyUnit => TyUnit,
    TyApp(n, args) => TyApp(n, impl_key_copy_list(args)),
    TyTuple(items) => TyTuple(impl_key_copy_list(items)),
    TyFn(params, ret, effect) => TyFn(impl_key_copy_list(params), impl_key_copy(ret), effect)
  }
}

fn impl_key_copy_list(items: Array[TypeExpr]) -> Array[TypeExpr] {
  let out: Array[TypeExpr] = []
  for item in items {
    Array::push(out, impl_key_copy(item))
  }
  out
}

fn impl_key_name_bucket(name: String, tag: Int) -> Int {
  let n = String::length(name)
  let first = if n == 0 {
    0
  } else {
    String::char_code_at(name, 0)
  }
  let last = if n == 0 {
    0
  } else {
    String::char_code_at(name, n - 1)
  }
  (tag + n * 17 + first * 31 + last * 7) % 128
}

fn impl_key_bucket(target: TypeExpr) -> Int {
  match target {
    TyName(n) => impl_key_name_bucket(n, 1),
    TyApp(n, _) => impl_key_name_bucket(n, 2),
    TyTuple(items) => (3 + Array::length(items) * 17) % 128,
    TyFn(params, _, _) => (4 + Array::length(params) * 17) % 128,
    TyUnit => 5
  }
}

export fn impl_target_key(target: TypeExpr) -> String {
  match target {
    TyUnit => "U",
    _ => {
      let eligible = impl_key_cost(target, 16) > 0
      let bucket = if eligible {
        impl_key_bucket(target)
      } else {
        0
      }
      if eligible {
        if Array::length(impl_key_heads) == 0 {
          let mut i = 0
          while i < 128 {
            Array::push(impl_key_heads, -1); i = i + 1
          }
        } else ()
        let mut at = Array::get(impl_key_heads, bucket)
        while at >= 0 {
          let cached: TypeExpr = Array::get(impl_key_targets, at)
          if cached == target {
            return Array::get(impl_key_values, at)
          } else ()
          at = Array::get(impl_key_next, at)
        }
      } else ()
      impl_prepare_byte_names()
      let buf = StringBuilder::new()
      impl_write_target_key(buf, target)
      let key = StringBuilder::freeze(buf)
      if eligible && Array::length(impl_key_targets) < 128 {
        let at = Array::length(impl_key_targets)
        Array::push(impl_key_targets, impl_key_copy(target))
        Array::push(impl_key_values, key)
        Array::push(impl_key_next, Array::get(impl_key_heads, bucket))
        Array::set(impl_key_heads, bucket, at)
      } else ()
      key
    }
  }
}

fn impl_decode_name(key: String, pos: Int, terminator: Int) -> Option[(String, Int)] {
  let mut out = ""
  let mut p = pos
  let mut valid = true
  while p < String::length(key) && String::char_code_at(key, p) != terminator && valid {
    let mut code = 0
    let mut digits = 0
    while p < String::length(key) && String::char_code_at(key, p) >= '0' && String::char_code_at(key, p) <= '9' {
      code = code * 10 + String::char_code_at(key, p) - '0'
      digits = digits + 1
      p = p + 1
    }
    if digits == 0 || p >= String::length(key) || String::char_code_at(key, p) != '_' {
      valid = false
    } else {
      out = String::concat(out, String::from_char_code(code))
      p = p + 1
    }
  }
  if valid && p < String::length(key) && String::char_code_at(key, p) == terminator {
    Some((out, p + 1))
  } else {
    None
  }
}

fn impl_target_from_key_at(key: String, pos: Int) -> Option[(TypeExpr, Int)] {
  if pos >= String::length(key) {
    None
  } else {
    match String::char_code_at(key, pos) {
      'N' => match impl_decode_name(key, pos + 1, 'Z') {
        Some(decoded) => {
          let (name, next) = decoded
          Some((TyName(name), next))
        },
        None => None
      },
      'A' => match impl_decode_name(key, pos + 1, 'L') {
        Some(decoded) => {
          let (name, after_name) = decoded
          let args = []
          let mut p = after_name
          let mut valid = true
          while p < String::length(key) && String::char_code_at(key, p) != 'R' && valid {
            match impl_target_from_key_at(key, p) {
              Some(parsed) => {
                let (arg, next) = parsed
                Array::push(args, arg)
                p = next
              },
              None => {
                valid = false
              }
            }
          }
          if valid && p < String::length(key) && String::char_code_at(key, p) == 'R' {
            Some((TyApp(name, args), p + 1))
          } else {
            None
          }
        },
        None => None
      },
      'F' => {
        let params = []
        let mut p = pos + 1
        let mut valid = true
        while p < String::length(key) && String::char_code_at(key, p) != 'T' && valid {
          match impl_target_from_key_at(key, p) {
            Some(parsed) => {
              let (param, next) = parsed
              Array::push(params, param)
              p = next
            },
            None => {
              valid = false
            }
          }
        }
        if !valid || p >= String::length(key) || String::char_code_at(key, p) != 'T' {
          None
        } else {
          match impl_target_from_key_at(key, p + 1) {
            Some(parsed_ret) => {
              let (ret, after_ret) = parsed_ret
              if after_ret + 1 >= String::length(key) || String::char_code_at(key, after_ret) != 'E' {
                None
              } else {
                let effect_tag = String::char_code_at(key, after_ret + 1)
                let effect_and_pos = if effect_tag == '0' {
                  Some((None, after_ret + 2))
                } else if effect_tag == '1' {
                  match impl_decode_name(key, after_ret + 2, 'Z') {
                    Some(decoded_effect) => {
                      let (effect_name, after_effect) = decoded_effect
                      Some((Some(effect_name), after_effect))
                    },
                    None => None
                  }
                } else {
                  None
                }
                match effect_and_pos {
                  Some(ep) => {
                    let (effect, after_effect) = ep
                    if after_effect < String::length(key) && String::char_code_at(key, after_effect) == 'R' {
                      Some((TyFn(params, ret, effect), after_effect + 1))
                    } else {
                      None
                    }
                  },
                  None => None
                }
              }
            },
            None => None
          }
        }
      },
      'P' => {
        let items = []
        let mut p = pos + 1
        let mut valid = true
        while p < String::length(key) && String::char_code_at(key, p) != 'R' && valid {
          match impl_target_from_key_at(key, p) {
            Some(parsed) => {
              let (item, next) = parsed
              Array::push(items, item)
              p = next
            },
            None => {
              valid = false
            }
          }
        }
        if valid && p < String::length(key) && String::char_code_at(key, p) == 'R' {
          Some((TyTuple(items), p + 1))
        } else {
          None
        }
      },
      'U' => Some((TyUnit, pos + 1)),
      _ => None
    }
  }
}

export fn impl_target_from_key(key: String) -> Option[TypeExpr] {
  match impl_target_from_key_at(key, 0) {
    Some(parsed) => {
      let (target, next) = parsed
      if next == String::length(key) {
        Some(target)
      } else {
        None
      }
    },
    None => None
  }
}

let applied_trait_ref_prefix: String = "$trait$"

/// Canonical storage for a trait reference in the legacy String-shaped AST
/// slots. Bare names stay byte-for-byte compatible; applied references use an
/// identifier-impossible prefix plus the reversible impl-target encoding.
export fn trait_ref_key(reference: TypeExpr) -> String {
  match reference {
    TyName(name) => name,
    TyApp(_, _) => String::concat(applied_trait_ref_prefix, impl_target_key(reference)),
    _ => ""
  }
}

export fn trait_ref_from_key(key: String) -> Option[TypeExpr] {
  if String::starts_with(key, applied_trait_ref_prefix) {
    impl_target_from_key(String::substring(key, String::length(applied_trait_ref_prefix), String::length(key)))
  } else if key == "" {
    None
  } else {
    Some(TyName(key))
  }
}

export fn trait_ref_name(key: String) -> String {
  match trait_ref_from_key(key) {
    Some(reference) => impl_target_head(reference),
    None => ""
  }
}

export fn trait_ref_args(key: String) -> Array[TypeExpr] {
  match trait_ref_from_key(key) {
    Some(TyApp(_, args)) => args,
    _ => []
  }
}

export fn impl_applied_target_key(head: String, arg_keys: Array[String]) -> String {
  let mut out = String::concat("A", String::concat(impl_encode_name(head), "L"))
  let mut i = 0
  while i < Array::length(arg_keys) {
    out = String::concat(out, Array::get(arg_keys, i))
    i = i + 1
  }
  String::concat(out, "R")
}

export fn impl_specialized_method_binding_name(head: String, trait_name: String, target_key: String, method: String) -> String {
  let owner = String::concat(head, String::concat("$impl$", String::concat(impl_encode_name(trait_name), String::concat("$", target_key))))
  String::concat(owner, String::concat("::", method))
}

export fn impl_method_owner(tparams: Array[String], trait_name: String, target: TypeExpr) -> String {
  let head = impl_target_head(target)
  match target {
    TyApp(_, _) => String::concat(head, String::concat("$impl$", String::concat(impl_encode_name(trait_name), String::concat("$", impl_target_key(target))))),
    _ => if Array::length(trait_ref_args(trait_name)) > 0 {
      String::concat(head, String::concat("$impl$", String::concat(impl_encode_name(trait_name), String::concat("$", impl_target_key(target)))))
    } else {
      head
    }
  }
}

export fn impl_method_binding_name(tparams: Array[String], trait_name: String, target: TypeExpr, method: String) -> String {
  String::concat(impl_method_owner(tparams, trait_name, target), String::concat("::", method))
}

export fn impl_method_owner_head(owner: String) -> String {
  let sep = String::index_of(owner, "$impl$")
  if sep < 0 {
    owner
  } else {
    String::substring(owner, 0, sep)
  }
}

/// Is this declared type exactly `Array[Int]`?
///
/// #2348 part 2: the one place three passes ask the same question about an
/// inline-wasm param — the parser's admission check (`parse_fn_wasm_body`),
/// the codegen splice (`linked_compile.vibe`) and the `vibe check` validation
/// lane (`check_inline_wasm_fns`). They must agree by construction: a param
/// the parser admits but codegen does not recognize would reach the body
/// still tagged, and read its capacity as its length.
export fn TypeExpr::is_array_of_int(recv: TypeExpr) -> Bool {
  match recv {
    TyApp(head, args) => head == "Array" && Array::length(args) == 1 && match Array::get(args, 0) {
      TyName(elem) => elem == "Int",
      _ => false
    },
    _ => false
  }
}
