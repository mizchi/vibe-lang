// @vibe/ast implementation stub (#753). The package's public surface is the
// transparent type definitions in index.vibei; this file exists so the
// contract's explicit impl import suppresses sibling auto-discovery (test
// files beside the contract must not join the facade), and it carries the
// one fn the contract declares. That fn is not decoration: a contract with
// ZERO fn/value decls desugars to a facade with no export lines, and the
// pinned SEED's contract engine (pre-#753) re-parses such a facade with
// sibling auto-discovery — one declared fn keeps this package loadable by
// the seed until the next bump.

export let version: () -> String = () -> {
  "0.1.0"
}
