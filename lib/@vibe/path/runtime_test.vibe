//# Imports

import ./ref.vibe {
  type DynamicPath, type PathRef, dynamic
}

import ./runtime.vibe {
  resolve
}

//# Misc

test "path/runtime resolve is Env effectful" {
  let path = resolve(dynamic("./vibe/prelude/string.vibe"))
  assert(path |> is_absolute)
}

test "path/runtime DynamicPath::resolve is available" {
  let path = dynamic("./vibe/prelude/string.vibe") |> resolve
  assert(path |> is_absolute)
}
