//# Imports

import ./ref.vibe {
  type DynamicPath, type PathRef
}

//# Functions

export fn resolve(path: DynamicPath) -> PathRef with Env {
  PathRef::{
    raw: Path::to_string(Path::resolve(path.raw))
  }
}

export fn DynamicPath::resolve(path: DynamicPath) -> PathRef with Env {
  resolve(path)
}
