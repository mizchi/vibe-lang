//# Imports

import ./ref.vibe {
  struct DynamicPath, struct PathRef
}

//# Functions

export fn resolve(_ path: DynamicPath) -> PathRef with Env {
  PathRef::{
    raw: Path::to_string(Path::resolve(path.raw))
  }
}

export fn DynamicPath::resolve(_ path: DynamicPath) -> PathRef with Env {
  resolve(path)
}
