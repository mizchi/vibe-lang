// #762: `Path::ref` / `Path::resolve` resolve to an absolute path against the
// process CWD (the `resolve_path` host import). `Path::ref` is typed pure — a
// trusted path literal, so from_literal carries no effect — while the dynamic
// `Path::resolve` (runtime.vibe) carries `with Env`. `Path::to_string` is
// identity over the wrapped raw String; `Path::is_absolute` tests a leading '/'.

//# Values

//# Types

export struct PathRef {
  raw: String
}

export struct DynamicPath {
  raw: String
}

//# Functions

export fn dynamic(raw: String) -> DynamicPath {
  DynamicPath::{
    raw: raw
  }
}

export fn from_literal(literal: String) -> PathRef {
  PathRef::{
    raw: Path::to_string(Path::ref(literal))
  }
}

export fn path_ref_as_string(self: PathRef) -> String {
  self.raw
}

export fn path_ref_is_absolute(self: PathRef) -> Bool {
  Path::is_absolute(path(self.raw))
}

export fn dynamic_path_as_string(path: DynamicPath) -> String {
  path.raw
}

export fn PathRef::as_string(self: PathRef) -> String {
  path_ref_as_string(self)
}

export fn PathRef::is_absolute(self: PathRef) -> Bool {
  path_ref_is_absolute(self)
}

export fn DynamicPath::as_string(path: DynamicPath) -> String {
  dynamic_path_as_string(path)
}
