// BLOCKED (#762): this package does not compile on selfhost — `Path::ref`
// (used by from_literal below) is unknown to the checker, and Path::to_string /
// Path::resolve / Path::is_absolute have no real codegen. Reviving it needs a
// decision on Path::ref's compile-time path-resolution semantics (the tests
// require from_literal to be pure yet return a CWD-absolute path). No
// lib/@vibe/path/*_test.vibe is in the unit allowlist until #762 lands.

//# Types

export struct PathRef {
  raw: String
}

export struct DynamicPath {
  raw: String
}

//# Functions

export let dynamic = (raw: String) -> DynamicPath {
  DynamicPath::{
    raw: raw
  }
}

export let from_literal = (literal: String) -> PathRef {
  PathRef::{
    raw: Path::to_string(Path::ref(literal))
  }
}

export let path_ref_as_string = (self: PathRef) -> String {
  self.raw
}

export let path_ref_is_absolute = (self: PathRef) -> Bool {
  Path::is_absolute(path(self.raw))
}

export let dynamic_path_as_string = (path: DynamicPath) -> String {
  path.raw
}

export let PathRef::as_string = (self: PathRef) -> String {
  path_ref_as_string(self)
}

export let PathRef::is_absolute = (self: PathRef) -> Bool {
  path_ref_is_absolute(self)
}

export let DynamicPath::as_string = (path: DynamicPath) -> String {
  dynamic_path_as_string(path)
}
