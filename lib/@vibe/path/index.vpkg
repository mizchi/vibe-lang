name = @vibe/path
version = 0.0.1
description =
  #|@vibe/path — path-literal / dynamic-path values (#762, ADR-0070 Phase 3
deps = {}

generated_hash =

// @vibe/path — path-literal / dynamic-path values (#762, ADR-0070 Phase 3
// #897). `Path::ref` / `PathRef` is a trusted path literal resolved against
// the process CWD at parse time — pure, no effect. `Path::resolve` /
// `DynamicPath` is the runtime counterpart, carrying `with Env` (the
// checker builtin effect, no import needed — see checker/builtins_system.vibe).
// PathRef/DynamicPath are declared `opaque`: both wrap a single internal
// `raw: String` field that no consumer (in-repo test or otherwise) reads
// directly — every consumer goes through as_string/is_absolute/resolve.
//
// ref.vibe additionally exports `path_ref_as_string`, `path_ref_is_absolute`,
// and `dynamic_path_as_string` — the plain-named helpers the `PathRef::` /
// `DynamicPath::` method-syntax wrappers below delegate to. They are marked
// `export` in the implementation file (so `check_contract` requires them
// declared here too), but the facade re-export list intentionally used only
// the `Name::method` forms (the natural call surface via `x|>method`) — kept
// that way here too; the plain names are still part of the CONFORMANCE
// surface (declared below) even though nothing outside this package is
// expected to call them positionally.

opaque type PathRef
opaque type DynamicPath

fn dynamic(raw: String) -> DynamicPath
fn from_literal(literal: String) -> PathRef
fn path_ref_as_string(self: PathRef) -> String
fn path_ref_is_absolute(self: PathRef) -> Bool
fn dynamic_path_as_string(path: DynamicPath) -> String
fn PathRef::as_string(self: PathRef) -> String
fn PathRef::is_absolute(self: PathRef) -> Bool
fn DynamicPath::as_string(path: DynamicPath) -> String
fn resolve(path: DynamicPath) -> PathRef with Env
fn DynamicPath::resolve(path: DynamicPath) -> PathRef with Env
