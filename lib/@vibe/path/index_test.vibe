//# Imports

import .{
  dynamic, from_literal, resolve, struct DynamicPath, struct PathRef
}

//# Misc

test "path from_literal returns absolute path" {
  let path = from_literal("./vibe/prelude/string.vibe")
  assert(path |> is_absolute)
  let raw = path |> as_string
  assert(eq(String::char_code_at(raw, 0), 47))
}

test "dynamic path resolve is Env effectful" {
  let path = resolve(dynamic("./vibe/prelude/string.vibe"))
  assert(path |> is_absolute)
}

test "DynamicPath method wrappers are available" {
  let dynamic_path = dynamic("./foo/../bar.vibe")
  assert((dynamic_path |> as_string) == "./foo/../bar.vibe")
  let resolved = dynamic_path |> resolve
  assert(resolved |> is_absolute)
}
