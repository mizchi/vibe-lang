name = @vibe/testreport
version = 0.0.1
description =
  #|@vibe/testreport — the condensed report under `FAIL <file>` when a test traps (#3674).
deps = {}

generated_hash =

// @vibe/testreport — the condensed failure report both test runners print:
// the launcher's `vibe test` (via `vibe test-report`) and
// scripts/vibe_test.sh (via scripts/test_report.vibex). Every function takes
// file CONTENTS and returns the report text; the callers do the IO.

fn pct_decode(s: String) -> String
fn launcher_trap_report(stderr: String, funcmap: String, base: String, pre_abort: Bool) -> String
fn script_failure_report(stdout: String, stderr: String, funcmap: String, base: String, source: String) -> String
