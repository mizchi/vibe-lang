import ./iterator.vibe {
  Iterator::map
}

fn main with Stdout {
  let ys = [1, 2, 3] |> Iterator::map((x: Int) -> Int {
    x + 1
  })
  let a = Array::get(ys, 0)
  let b = Array::get(ys, 1)
  let c = Array::get(ys, 2)
  if a == 2 && b == 3 && c == 4 {
    println("2")
    println("3")
    println("4")
  } else {
    println("fail")
  }
}
