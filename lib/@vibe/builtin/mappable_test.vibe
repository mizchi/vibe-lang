import ./builtin.vibe {
  trait Mappable
}
import ./async_iter.vibe {
  Array::iter, AsyncIter::collect
}

test "pipeline map preserves Array" {
  let values = [1, 2] |> Mappable::map((x) -> {
    x + 1
  }) |> Mappable::map((x) -> {
    x * 2
  })
  assert_eq(values, [4, 6])
}

test "pipeline map preserves Option" {
  let value = Some(3) |> Mappable::map((x) -> {
    x + 1
  }) |> Mappable::map((x) -> {
    x * 2
  })
  assert_eq(value, Some(8))
}

test "pipeline map preserves AsyncIter" {
  let values = [1, 2] |> Array::iter |> map((x) -> {
    x + 1
  }) |> AsyncIter::collect
  assert_eq(values, [2, 3])
}
