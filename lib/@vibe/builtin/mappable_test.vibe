import ./builtin.vibe {
  trait Mappable
}

test "pipeline map preserves Array" {
  let values = [1, 2] |> Mappable::map((x) -> {
    x + 1
  }) |> Mappable::map((x) -> {
    x * 2
  })
  assert_eq(values, [4, 6])
}

test "pipeline map preserves Option" {
  let value = Some(3) |> Mappable::map((x) -> {
    x + 1
  }) |> Mappable::map((x) -> {
    x * 2
  })
  assert_eq(value, Some(8))
}
