//# Imports

import ./ordering.vibe {
  Ordering, Ordering::reverse, Ordering::to_int
}

import ./cmp.vibe {
  int_compare, maximum, maximum_by, maximum_by_key, minimum, minimum_by, minimum_by_key, minmax, minmax_by, minmax_by_key, string_compare
}

//# Misc

test "cmp_int_primitives" {
  inspect(int_compare(a = 1, b = 2), "Less")
  inspect(int_compare(a = 2, b = 2), "Equal")
  inspect(int_compare(a = 3, b = 2), "Greater")
  assert(eq(maximum(a = 3, b = 9), 9))
  assert(eq(minimum(a = 3, b = 9), 3))
  let p = minmax(a = 9, b = 3)
  assert(eq(p.0, 3))
  assert(eq(p.1, 9))
}

test "cmp_by_comparator" {
  let by_abs = (a: Int, b: Int) -> Ordering {
    let abs_a = if a < 0 {
      0 - a
    } else a
    let abs_b = if b < 0 {
      0 - b
    } else b
    int_compare(a = abs_a, b = abs_b)
  }
  assert(eq(maximum_by(a = -2, b = 5, compare = by_abs), 5))
  assert(eq(minimum_by(a = -2, b = 5, compare = by_abs), -2))
  let p = minmax_by(a = -9, b = 3, compare = by_abs)
  assert(eq(p.0, 3))
  assert(eq(p.1, -9))
}

test "cmp_by_key" {
  let neg = (x: Int) -> Int {
    0 - x
  }
  assert(eq(maximum_by_key(a = 3, b = 9, key = neg, compare_key = int_compare), 3))
  assert(eq(minimum_by_key(a = 3, b = 9, key = neg, compare_key = int_compare), 9))
  let first_char_code = (s: String) -> Int {
    String::char_code_at(s, at = 0)
  }
  let p = minmax_by_key(a = "abc", b = "x", key = first_char_code, compare_key = int_compare)
  assert(p.0 == "abc")
  assert(p.1 == "x")
}

test "cmp_string_compare" {
  inspect(string_compare(a = "a", b = "b"), "Less")
  inspect(string_compare(a = "b", b = "b"), "Equal")
  inspect(string_compare(a = "c", b = "b"), "Greater")
  // length tie-break: a prefix is lexicographically smaller.
  inspect(string_compare(a = "ab", b = "abc"), "Less")
  inspect(string_compare(a = "abc", b = "ab"), "Greater")
}

/// `<` / `>` on strings lower to a single-pass SIMD lex scan (ADR-0054).
/// Exercise the 16-byte SIMD chunk-skip path (>16 equal leading bytes)
/// end-to-end through `string_compare`.
test "cmp_string_compare_simd_chunk" {
  let p20 = "aaaaaaaaaaaaaaaaaaaa"
  // 20 equal leading bytes (> 1 chunk)
  inspect(string_compare(a = p20 + "X", b = p20 + "Y"), "Less")
  inspect(string_compare(a = p20 + "Y", b = p20 + "X"), "Greater")
  inspect(string_compare(a = p20 + "Z", b = p20 + "Z"), "Equal")
  // equal multi-chunk prefix, one is a prefix of the other.
  inspect(string_compare(a = p20, b = p20 + "tail"), "Less")
  inspect(string_compare(a = p20 + "tail", b = p20), "Greater")
}

/// #3042: the arithmetic form and the reversal of an `Ordering`.
test "ordering_to_int_and_reverse" {
  inspect(Ordering::to_int(int_compare(a = 1, b = 2)), "-1")
  inspect(Ordering::to_int(int_compare(a = 2, b = 2)), "0")
  inspect(Ordering::to_int(int_compare(a = 3, b = 2)), "1")
  inspect(Ordering::reverse(int_compare(a = 1, b = 2)), "Greater")
  inspect(Ordering::reverse(int_compare(a = 2, b = 2)), "Equal")
  inspect(Ordering::reverse(int_compare(a = 3, b = 2)), "Less")
  let descending = (a: Int, b: Int) -> Ordering {
    Ordering::reverse(int_compare(a = a, b = b))
  }
  inspect(maximum_by(a = 3, b = 9, compare = descending), "3")
}
