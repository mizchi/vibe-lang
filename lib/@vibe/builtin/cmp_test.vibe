//# Imports

import ./cmp.vibe {
  int_compare, maximum, maximum_by, maximum_by_key, minimum, minimum_by, minimum_by_key, minmax, minmax_by, minmax_by_key, string_compare
}

//# Misc

test "cmp_int_primitives" {
  assert(eq(int_compare(1, 2), -1))
  assert(eq(int_compare(2, 2), 0))
  assert(eq(int_compare(3, 2), 1))
  assert(eq(maximum(3, 9), 9))
  assert(eq(minimum(3, 9), 3))
  let p = minmax(9, 3)
  assert(eq(p.0, 3))
  assert(eq(p.1, 9))
}

test "cmp_by_comparator" {
  let by_abs = (a: Int, b: Int) -> Int {
    let abs_a = if a < 0 {
      0 - a
    } else a
    let abs_b = if b < 0 {
      0 - b
    } else b
    int_compare(abs_a, abs_b)
  }
  assert(eq(maximum_by(-2, 5, by_abs), 5))
  assert(eq(minimum_by(-2, 5, by_abs), -2))
  let p = minmax_by(-9, 3, by_abs)
  assert(eq(p.0, 3))
  assert(eq(p.1, -9))
}

test "cmp_by_key" {
  let neg = (x: Int) -> Int {
    0 - x
  }
  assert(eq(maximum_by_key(3, 9, neg, int_compare), 3))
  assert(eq(minimum_by_key(3, 9, neg, int_compare), 9))
  let first_char_code = (s: String) -> Int {
    String::char_code_at(s, 0)
  }
  let p = minmax_by_key("abc", "x", first_char_code, int_compare)
  assert(p.0 == "abc")
  assert(p.1 == "x")
}

test "cmp_string_compare" {
  assert(eq(string_compare("a", "b"), -1))
  assert(eq(string_compare("b", "b"), 0))
  assert(eq(string_compare("c", "b"), 1))
  // length tie-break: a prefix is lexicographically smaller.
  assert(eq(string_compare("ab", "abc"), -1))
  assert(eq(string_compare("abc", "ab"), 1))
}

/// string_compare now lowers to a single-pass SIMD lex scan returning the
/// signum of the lexicographic difference (ADR-0054), instead of scanning the
/// common prefix twice via `a < b` then `a > b`. Exercise the 16-byte SIMD
/// chunk-skip path (>16 equal leading bytes) end-to-end.
test "cmp_string_compare_simd_chunk" {
  let p20 = "aaaaaaaaaaaaaaaaaaaa"
  // 20 equal leading bytes (> 1 chunk)
  assert(eq(string_compare(p20 + "X", p20 + "Y"), -1))
  assert(eq(string_compare(p20 + "Y", p20 + "X"), 1))
  assert(eq(string_compare(p20 + "Z", p20 + "Z"), 0))
  // equal multi-chunk prefix, one is a prefix of the other.
  assert(eq(string_compare(p20, p20 + "tail"), -1))
  assert(eq(string_compare(p20 + "tail", p20), 1))
}
