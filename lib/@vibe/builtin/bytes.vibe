//# Types

export type Byte = Int

//# Functions

export fn get(bytes: Bytes, index: Int) -> Option[Int] {
  if index < 0 || index >= Bytes::length(bytes) {
    None
  } else Some(Bytes::get(bytes, index))
}

export fn equals(a: Bytes, b: Bytes) -> Bool {
  let len = Bytes::length(a)
  if len != Bytes::length(b) {
    false
  }
  else {
    let rec r#loop = (i: Int) -> Bool {
      if i >= len {
        true
      }
      else if Bytes::get(a, i) != Bytes::get(b, i) {
        false
      }
      else r#loop(i + 1)
    }
    r#loop(0)
  }
}

export fn length(bytes: Bytes) -> Int {
  Bytes::length(bytes)
}

export fn is_byte(value: Int) -> Bool {
  value >= 0 && value <= 255
}

export fn to_ascii(bytes: Bytes) -> Option[String] {
  let len = Bytes::length(bytes)
  let rec r#loop = (i: Int, sb: StringBuilder) -> Option[String] {
    if i >= len {
      Some(StringBuilder::freeze(sb))
    }
    else {
      let code = Bytes::get(bytes, i)
      if code < 0 || code > 127 {
        None
      }
      else {
        StringBuilder::push(sb, String::from_char_code(code))
        r#loop(i + 1, sb)
      }
    }
  }
  r#loop(0, StringBuilder::new())
}

export fn clamp_byte(value: Int) -> Int {
  if value < 0 {
    0
  }
  else if value > 255 {
    255
  }
  else value
}

export fn from_ascii(s: String) -> Option[Bytes] {
  let len = String::length(s)
  let b = Bytes::new()
  let rec r#loop = (i: Int) -> Option[Bytes] {
    if i >= len {
      Some(b)
    }
    else {
      let code = String::char_code_at(s, i)
      if code < 0 || code > 127 {
        None
      }
      else {
        Bytes::push(b, code)
        r#loop(i + 1)
      }
    }
  }
  r#loop(0)
}

fn hex_char_value(code: Int) -> Int {
  if code >= 48 && code <= 57 {
    code - 48
  }
  else if code >= 65 && code <= 70 {
    code - 55
  }
  else if code >= 97 && code <= 102 {
    code - 87
  }
  else -1
}

export fn from_hex(hex: String) -> Option[Bytes] {
  let len = String::length(hex)
  if len % 2 != 0 {
    None
  }
  else {
    let b = Bytes::new()
    let rec r#loop = (i: Int) -> Option[Bytes] {
      if i >= len {
        Some(b)
      }
      else {
        let hi = hex_char_value(String::char_code_at(hex, i))
        let lo = hex_char_value(String::char_code_at(hex, i + 1))
        if hi < 0 || lo < 0 {
          None
        }
        else {
          let value = hi * 16 + lo
          {
            Bytes::push(b, value)
            r#loop(i + 2)
          }
        }
      }
    }
    r#loop(0)
  }
}

fn hex_nibble_char(value: Int) -> String {
  if value < 10 {
    String::from_char_code(48 + value)
  } else String::from_char_code(87 + value)
}

export fn to_hex(bytes: Bytes) -> String {
  let len = Bytes::length(bytes)
  let rec r#loop = (i: Int, sb: StringBuilder) -> String {
    if i >= len {
      StringBuilder::freeze(sb)
    }
    else {
      let byte = clamp_byte(Bytes::get(bytes, i))
      let hi = byte / 16
      let lo = byte % 16
      {
        StringBuilder::push(sb, hex_nibble_char(hi))
        StringBuilder::push(sb, hex_nibble_char(lo))
      }
      r#loop(i + 1, sb)
    }
  }
  r#loop(0, StringBuilder::new())
}
