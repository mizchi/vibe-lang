//# Types

/// #736: `Iterable[T]` is a real method-bearing trait (the #636 witness-dict
/// machinery), replacing the ADR-0044 name-coupled convention. The old scheme
/// compiled `xs |> iter_length` inside a `[C: Iterable]` combinator as a call
/// to a BARE `iter_length` function that had to exist in the merged program by
/// accident — under selfhost it never resolved, so every Iterator::* combinator
/// failed to compile ("undefined variable (local): iter_length") unless some
/// import happened to export a bare `iter_length`. Qualified `C::iter_length`
/// dispatches through the threaded witness dictionary to the concrete impl.
///
/// Implement for your own type with an impl block (methods may also be given
/// as separate `let MyType::iter_length = ...` bindings — an impl block
/// desugars to exactly those):
///
///   impl [T] Iterable for MyVec[T] {
///     iter_length(self) -> Int { ... }
///     iter_get(self, i) -> T { ... }
///   }
export trait Iterable[T] {
  iter_length(Self) -> Int
  iter_get(Self, Int) -> T
}

//# Functions

/// Builtin iterables (ADR-0044 Phase 3 semantics preserved): Array yields its
/// elements, String yields Int char codes (consistent with `for c in s`), and
/// Map yields its keys in insertion order.
impl [T] Iterable for Array[T] {
  iter_length(self) -> Int {
    Array::length(self)
  }
  iter_get(self, i) -> T {
    Array::get(self, i)
  }
}

impl Iterable for String {
  iter_length(self) -> Int {
    String::length(self)
  }
  iter_get(self, i) -> Int {
    String::char_code_at(self, i)
  }
}

/// Key iteration goes through Map::keys per access; hoisting the key array out
/// of the loop needs per-call-site specialization (perf follow-up, not a
/// correctness issue — small maps dominate current usage).
impl [K, V] Iterable for Map[K, V] {
  iter_length(self) -> Int {
    Array::length(Map::keys(self))
  }
  iter_get(self, i) -> String {
    Array::get(Map::keys(self), i)
  }
}

export fn Iterator::fold[C: Iterable, T, B](xs: C, init: B, f: (acc: B, x: T) -> B) -> B {
  let len = C::iter_length(xs)
  let mut i = 0
  let mut acc = init
  while i < len {
    acc = f(acc, C::iter_get(xs, i))
    i = i + 1
  }
  acc
}

export fn Iterator::iter[C: Iterable, T, R](xs: C, f: (x: T) -> R) -> Int {
  let len = C::iter_length(xs)
  let mut i = 0
  while i < len {
    f(C::iter_get(xs, i))
    i = i + 1
  }
  i
}

export fn Iterator::find[C: Iterable, T](xs: C, pred: (x: T) -> Bool) -> Option[T] {
  let len = C::iter_length(xs)
  let mut i = 0
  let mut result = None
  while i < len {
    let value = C::iter_get(xs, i)
    if pred(value) {
      result = Some(value)
      i = len
    } else {
      i = i + 1
    }
  }
  result
}

export fn Iterator::any[C: Iterable, T](xs: C, pred: (x: T) -> Bool) -> Bool {
  let len = C::iter_length(xs)
  let mut i = 0
  let mut found = false
  while i < len {
    if pred(C::iter_get(xs, i)) {
      found = true
      i = len
    } else {
      i = i + 1
    }
  }
  found
}

export fn Iterator::all[C: Iterable, T](xs: C, pred: (x: T) -> Bool) -> Bool {
  let len = C::iter_length(xs)
  let mut i = 0
  let mut ok = true
  while i < len {
    if pred(C::iter_get(xs, i)) {
      i = i + 1
    } else {
      ok = false
      i = len
    }
  }
  ok
}

export fn Iterator::map[A, B](xs: Array[A], f: (x: A) -> B) -> Array[B] {
  let len = Array::length(xs)
  {
    let acc = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      ArrayBuilder::push(acc, f(Array::get(xs, i)))
      i = i + 1
    }
    ArrayBuilder::freeze(acc)
  }
}

export fn Iterator::filter[C: Iterable, T](xs: C, pred: (x: T) -> Bool) -> Array[T] {
  let len = C::iter_length(xs)
  {
    let acc = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      let value = C::iter_get(xs, i)
      if pred(value) {
        ArrayBuilder::push(acc, value)
      }
      i = i + 1
    }
    ArrayBuilder::freeze(acc)
  }
}

export fn Iterator::flatmap[C: Iterable, A, B](xs: C, f: (x: A) -> Array[B]) -> Array[B] {
  let len = C::iter_length(xs)
  {
    let acc = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      let chunk = f(C::iter_get(xs, i))
      let chunk_len = Array::length(chunk)
      let mut j = 0
      while j < chunk_len {
        ArrayBuilder::push(acc, Array::get(chunk, j))
        j = j + 1
      }
      i = i + 1
    }
    ArrayBuilder::freeze(acc)
  }
}
