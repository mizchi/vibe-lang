//# Types

/// #736: `Iterator[T]` is a real method-bearing trait (the #636 witness-dict
/// machinery), replacing the ADR-0044 name-coupled convention. The old scheme
/// compiled `xs |> iter_length` inside a `[C: Iterator]` combinator as a call
/// to a BARE `iter_length` function that had to exist in the merged program by
/// accident — under selfhost it never resolved, so every Iterator::* combinator
/// failed to compile ("undefined variable (local): iter_length") unless some
/// import happened to export a bare `iter_length`. Qualified `C::iter_length`
/// dispatches through the threaded witness dictionary to the concrete impl.
///
/// Implement for your own type with an impl block (methods may also be given
/// as separate `let MyType::iter_length = ...` bindings — an impl block
/// desugars to exactly those):
///
///   impl [T] Iterator[T] for MyVec[T] {
///     iter_length(self) -> Int { ... }
///     iter_get(self, i) -> T { ... }
///   }
export trait Iterator[T] {
  iter_length(Self) -> Int
  iter_get(Self, Int) -> T
}

//# Functions

/// Builtin iterables (ADR-0044 Phase 3 semantics preserved): Array yields its
/// elements, String yields Int char codes (consistent with `for c in s`), and
/// Map yields its keys in insertion order.
impl [T] Iterator[T] for Array[T] {
  iter_length(self) -> Int {
    Array::length(self)
  }
  iter_get(self, i) -> T {
    Array::get(self, i)
  }
}

impl Iterator[Int] for String {
  iter_length(self) -> Int {
    String::length(self)
  }
  iter_get(self, i) -> Int {
    String::char_code_at(self, i)
  }
}

/// Map iteration reads the insertion-order key slot directly. `Map::iter_get`
/// is a checked compiler primitive; its lowering performs the same bounds
/// trap as indexing `Map::keys(self)` without allocating that temporary array.
impl [K, V] Iterator[String] for Map[K, V] {
  iter_length(self) -> Int {
    Map::size(self)
  }
  iter_get(self, i) -> String {
    Map::iter_get(self, i)
  }
}

export fn Iterator::fold[T, C: Iterator[T], B](xs: C, init: B, f: (acc: B, x: T) -> B) -> B {
  let len = C::iter_length(xs)
  let mut i = 0
  let mut acc = init
  while i < len {
    acc = f(acc, C::iter_get(xs, i))
    i = i + 1
  }
  acc
}

export fn Iterator::iter[T, C: Iterator[T], R](xs: C, f: (x: T) -> R) -> Int {
  let len = C::iter_length(xs)
  let mut i = 0
  while i < len {
    f(C::iter_get(xs, i))
    i = i + 1
  }
  i
}

export fn Iterator::find[T, C: Iterator[T]](xs: C, pred: (x: T) -> Bool) -> Option[T] {
  let len = C::iter_length(xs)
  let mut i = 0
  let mut result = None
  while i < len {
    let value = C::iter_get(xs, i)
    if pred(value) {
      result = Some(value)
      i = len
    } else {
      i = i + 1
    }
  }
  result
}

export fn Iterator::any[T, C: Iterator[T]](xs: C, pred: (x: T) -> Bool) -> Bool {
  let len = C::iter_length(xs)
  let mut i = 0
  let mut found = false
  while i < len {
    if pred(C::iter_get(xs, i)) {
      found = true
      i = len
    } else {
      i = i + 1
    }
  }
  found
}

export fn Iterator::all[T, C: Iterator[T]](xs: C, pred: (x: T) -> Bool) -> Bool {
  let len = C::iter_length(xs)
  let mut i = 0
  let mut ok = true
  while i < len {
    if pred(C::iter_get(xs, i)) {
      i = i + 1
    } else {
      ok = false
      i = len
    }
  }
  ok
}

export fn Iterator::map[A, C: Iterator[A], B](xs: C, f: (x: A) -> B) -> Array[B] {
  let len = C::iter_length(xs)
  {
    let acc = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      ArrayBuilder::push(acc, f(C::iter_get(xs, i)))
      i = i + 1
    }
    ArrayBuilder::freeze(acc)
  }
}

export fn Iterator::filter[T, C: Iterator[T]](xs: C, pred: (x: T) -> Bool) -> Array[T] {
  let len = C::iter_length(xs)
  {
    let acc = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      let value = C::iter_get(xs, i)
      if pred(value) {
        ArrayBuilder::push(acc, value)
      }
      i = i + 1
    }
    ArrayBuilder::freeze(acc)
  }
}

export fn Iterator::flatmap[A, C: Iterator[A], B](xs: C, f: (x: A) -> Array[B]) -> Array[B] {
  let len = C::iter_length(xs)
  {
    let acc = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      let chunk = f(C::iter_get(xs, i))
      let chunk_len = Array::length(chunk)
      let mut j = 0
      while j < chunk_len {
        ArrayBuilder::push(acc, Array::get(chunk, j))
        j = j + 1
      }
      i = i + 1
    }
    ArrayBuilder::freeze(acc)
  }
}
