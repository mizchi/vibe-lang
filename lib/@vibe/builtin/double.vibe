//# Functions

// Compiler-provided intrinsic type explicitly published by this module, and
// the builtin operations published without a body. Both lanes lower a call to
// `Double::abs` / `ceil` / `floor` / `max` / `min` inline, and since #3185 a
// definition at a builtin's spelling is moved aside and answers every call
// written to that spelling (`rename_builtin_shadow_defs`) -- a body here would
// take every dependent's calls (the #2378 hazard `string.vibe` documents). The
// value aliases below (`abs`, `ceil`, ...) keep their own implementations.
export {
  Double, Double::abs, Double::ceil, Double::floor, Double::max, Double::min
}

fn double_cube(x: Double) -> Double {
  x * x * x
}

export let cube: (Double) -> Double = double_cube

fn double_lerp(a: Double, b: Double, t: Double) -> Double {
  a + (b - a) * t
}

export let lerp: (Double, Double, Double) -> Double = double_lerp

fn double_clamp(x: Double, min_val: Double, max_val: Double) -> Double {
  if x < min_val {
    min_val
  }
  else if x > max_val {
    max_val
  }
  else x
}

export let clamp: (Double, Double, Double) -> Double = double_clamp

fn double_is_nan(x: Double) -> Bool {
  not(x == x)
}

export let is_nan: (Double) -> Bool = double_is_nan

fn double_signum(x: Double) -> Double {
  if x < 0.0 {
    -1.0
  }
  else if x > 0.0 {
    1.0
  }
  else 0.0
}

export let signum: (Double) -> Double = double_signum

fn double_square(x: Double) -> Double {
  x * x
}

export let square: (Double) -> Double = double_square

// #1877: 63-bit Int max, seed-safe spelling (see prelude/int.vibe).
let double_int_max: Int = (2305843009213693951<<1)|1

let double_int_min: Int = 0 - double_int_max - 1

let double_int_max_value: Double = Int::to_double(double_int_max)

let double_int_min_value: Double = Int::to_double(double_int_min)

fn double_to_int_saturating(x: Double) -> Int {
  if x >= double_int_max_value {
    double_int_max
  }
  else if x <= double_int_min_value {
    double_int_min
  }
  else Double::to_int(x)
}

fn double_trunc(x: Double) -> Double {
  Int::to_double(double_to_int_saturating(x))
}

export let trunc: (Double) -> Double = double_trunc

fn double_fract(x: Double) -> Double {
  x - double_trunc(x)
}

export let fract: (Double) -> Double = double_fract

fn double_abs(x: Double) -> Double {
  if x < 0.0 {
    0.0 - x
  } else x
}

export let abs: (Double) -> Double = double_abs

fn double_approx_eq(a: Double, b: Double, eps: Double) -> Bool {
  Double::abs(a - b) <= eps
}

export let approx_eq: (Double, Double, Double) -> Bool = double_approx_eq

fn double_max(a: Double, b: Double) -> Double {
  if a > b {
    a
  } else b
}

export let max: (Double, Double) -> Double = double_max

fn double_min(a: Double, b: Double) -> Double {
  if a < b {
    a
  } else b
}

export let min: (Double, Double) -> Double = double_min

fn double_ceil(x: Double) -> Double {
  if x >= double_int_max_value {
    double_int_max_value
  } else {
    let i = double_to_int_saturating(x)
    let d = Int::to_double(i)
    if d < x {
      Int::to_double(i + 1)
    } else d
  }
}

export let ceil: (Double) -> Double = double_ceil

export fn Double::cube(x: Double) -> Double {
  double_cube(x)
}

export fn Double::lerp(a: Double, b: Double, t: Double) -> Double {
  double_lerp(a, b, t)
}

export fn Double::clamp(x: Double, min_val: Double, max_val: Double) -> Double {
  double_clamp(x, min_val, max_val)
}

fn double_floor(x: Double) -> Double {
  if x <= double_int_min_value {
    double_int_min_value
  } else {
    let i = double_to_int_saturating(x)
    let d = Int::to_double(i)
    if d > x {
      Int::to_double(i - 1)
    } else d
  }
}

export let floor: (Double) -> Double = double_floor

fn double_round(x: Double) -> Double {
  if x >= 0.0 {
    Double::floor(x + 0.5)
  } else Double::ceil(x - 0.5)
}

export let round: (Double) -> Double = double_round

export fn Double::fract(x: Double) -> Double {
  double_fract(x)
}

export fn Double::round(x: Double) -> Double {
  double_round(x)
}

export fn Double::trunc(x: Double) -> Double {
  double_trunc(x)
}

export fn Double::is_nan(x: Double) -> Bool {
  double_is_nan(x)
}

export fn Double::signum(x: Double) -> Double {
  double_signum(x)
}

export fn Double::square(x: Double) -> Double {
  double_square(x)
}

export fn Double::approx_eq(a: Double, b: Double, eps: Double) -> Bool {
  double_approx_eq(a, b, eps)
}
