//# Functions

// Compiler-provided intrinsic type explicitly published by this module, and
// the builtin operations published without a body. Both lanes lower a call to
// `Float64::abs` / `ceil` / `floor` / `max` / `min` inline, and since #3185 a
// definition at a builtin's spelling is moved aside and answers every call
// written to that spelling (`rename_builtin_shadow_defs`) -- a body here would
// take every dependent's calls (the #2378 hazard `string.vibe` documents). The
// value aliases below (`abs`, `ceil`, ...) keep their own implementations.
export {
  Float64, Float64::abs, Float64::ceil, Float64::floor, Float64::max, Float64::min
}

fn double_cube(_ x: Float64) -> Float64 {
  x * x * x
}

export let cube: (Float64) -> Float64 = double_cube

fn double_lerp(a: Float64, b: Float64, t: Float64) -> Float64 {
  a + (b - a) * t
}

export let lerp: (Float64, Float64, Float64) -> Float64 = double_lerp

fn double_clamp(x: Float64, min_val: Float64, max_val: Float64) -> Float64 {
  if x < min_val {
    min_val
  }
  else if x > max_val {
    max_val
  }
  else x
}

export let clamp: (Float64, Float64, Float64) -> Float64 = double_clamp

fn double_is_nan(_ x: Float64) -> Bool {
  not(x == x)
}

export let is_nan: (Float64) -> Bool = double_is_nan

fn double_signum(_ x: Float64) -> Float64 {
  if x < 0.0 {
    -1.0
  }
  else if x > 0.0 {
    1.0
  }
  else 0.0
}

export let signum: (Float64) -> Float64 = double_signum

fn double_square(_ x: Float64) -> Float64 {
  x * x
}

export let square: (Float64) -> Float64 = double_square

// #1877: 63-bit Int max, seed-safe spelling (see prelude/int.vibe).
let double_int_max: Int = (2305843009213693951<<1)|1

let double_int_min: Int = 0 - double_int_max - 1

let double_int_max_value: Float64 = Int::to_float64(double_int_max)

let double_int_min_value: Float64 = Int::to_float64(double_int_min)

fn double_to_int_saturating(_ x: Float64) -> Int {
  if x >= double_int_max_value {
    double_int_max
  }
  else if x <= double_int_min_value {
    double_int_min
  }
  else Float64::to_int(x)
}

fn double_trunc(_ x: Float64) -> Float64 {
  Int::to_float64(double_to_int_saturating(x))
}

export let trunc: (Float64) -> Float64 = double_trunc

fn double_fract(_ x: Float64) -> Float64 {
  x - double_trunc(x)
}

export let fract: (Float64) -> Float64 = double_fract

fn double_abs(_ x: Float64) -> Float64 {
  if x < 0.0 {
    0.0 - x
  } else x
}

export let abs: (Float64) -> Float64 = double_abs

fn double_approx_eq(a: Float64, b: Float64, eps: Float64) -> Bool {
  Float64::abs(a - b) <= eps
}

export let approx_eq: (Float64, Float64, Float64) -> Bool = double_approx_eq

fn double_max(a: Float64, b: Float64) -> Float64 {
  if a > b {
    a
  } else b
}

export let max: (Float64, Float64) -> Float64 = double_max

fn double_min(a: Float64, b: Float64) -> Float64 {
  if a < b {
    a
  } else b
}

export let min: (Float64, Float64) -> Float64 = double_min

fn double_ceil(_ x: Float64) -> Float64 {
  if x >= double_int_max_value {
    double_int_max_value
  } else {
    let i = double_to_int_saturating(x)
    let d = Int::to_float64(i)
    if d < x {
      Int::to_float64(i + 1)
    } else d
  }
}

export let ceil: (Float64) -> Float64 = double_ceil

export fn Float64::cube(_ x: Float64) -> Float64 {
  double_cube(x)
}

export fn Float64::lerp(_ a: Float64, b: Float64, t: Float64) -> Float64 {
  double_lerp(a = a, b = b, t = t)
}

export fn Float64::clamp(_ x: Float64, min_val: Float64, max_val: Float64) -> Float64 {
  double_clamp(x = x, min_val = min_val, max_val = max_val)
}

fn double_floor(_ x: Float64) -> Float64 {
  if x <= double_int_min_value {
    double_int_min_value
  } else {
    let i = double_to_int_saturating(x)
    let d = Int::to_float64(i)
    if d > x {
      Int::to_float64(i - 1)
    } else d
  }
}

export let floor: (Float64) -> Float64 = double_floor

fn double_round(_ x: Float64) -> Float64 {
  if x >= 0.0 {
    Float64::floor(x + 0.5)
  } else Float64::ceil(x - 0.5)
}

export let round: (Float64) -> Float64 = double_round

export fn Float64::fract(_ x: Float64) -> Float64 {
  double_fract(x)
}

export fn Float64::round(_ x: Float64) -> Float64 {
  double_round(x)
}

export fn Float64::trunc(_ x: Float64) -> Float64 {
  double_trunc(x)
}

export fn Float64::is_nan(_ x: Float64) -> Bool {
  double_is_nan(x)
}

export fn Float64::signum(_ x: Float64) -> Float64 {
  double_signum(x)
}

export fn Float64::square(_ x: Float64) -> Float64 {
  double_square(x)
}

export fn Float64::approx_eq(_ a: Float64, b: Float64, eps: Float64) -> Bool {
  double_approx_eq(a = a, b = b, eps = eps)
}
