//# Imports

// #3728: `float.vibe` publishes `export { Float }`, and every `Float::` path
// is read as `Float32::`. The type item is matched by its canonical head, so
// it can be imported under either spelling and its members reached as either.
import ./float.vibe {
  Float32
}

//# Misc

test "the width-named import reaches the members through both spellings" {
  inspect(Float32::abs(-2.5f), content = "2.5")
  inspect(Float::abs(-2.5f), content = "2.5")
  inspect(Float32::max(1.0f, b = 3.0f), content = "3")
}
