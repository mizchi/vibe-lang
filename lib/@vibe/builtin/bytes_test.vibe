//# Imports

import ./bytes.vibe {
  clamp_byte, equals, from_ascii, from_hex, get, is_byte, length, to_ascii, to_hex
}

//# Functions

fn repeat(s: String, n: Int) -> String {
  let rec r#loop = (i: Int, acc: String) -> String {
    if i <= 0 {
      acc
    } else r#loop(i - 1, "\{acc}\{s}")
  }
  r#loop(n, "")
}

//# Misc

test "bytes_byte_range" {
  assert(is_byte(0))
  assert(is_byte(255))
  assert(not(is_byte(-1)))
  assert(not(is_byte(256)))
  assert(eq(clamp_byte(-3), 0))
  assert(eq(clamp_byte(120), 120))
  assert(eq(clamp_byte(300), 255))
}

test "bytes_ascii_roundtrip" {
  match from_ascii("Az09") {
    Some(bytes) => {
      assert(eq(length(bytes), 4))
      match get(bytes, 0) {
        Some(v) => assert(eq(v, 65)),
        _ => assert(false)
      }
      match to_ascii(bytes) {
        Some(s) => assert(s == "Az09"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "bytes_new returns independent buffers" {
  let left = Bytes::new()
  Bytes::push(left, 1)
  let right = Bytes::new()
  Bytes::push(right, 2)
  assert(eq(Bytes::length(left), 1))
  assert(eq(Bytes::length(right), 1))
  assert(eq(Bytes::get(left, 0), 1))
  assert(eq(Bytes::get(right, 0), 2))
}

test "bytes_ascii_invalid" {
  match from_ascii("あ") {
    None => assert(true),
    _ => assert(false)
  }
  match to_ascii(Bytes::from_array([65, 200])) {
    None => assert(true),
    _ => assert(false)
  }
}

test "bytes_hex_roundtrip" {
  let hex = to_hex(Bytes::from_array([0, 15, 16, 255]))
  assert(hex == "000f10ff")
  match from_hex(hex) {
    Some(decoded) => assert(equals(decoded, Bytes::from_array([0, 15, 16, 255]))),
    _ => assert(false)
  }
}

test "bytes_hex_invalid" {
  match from_hex("0") {
    None => assert(true),
    _ => assert(false)
  }
  match from_hex("0g") {
    None => assert(true),
    _ => assert(false)
  }
}

test "bytes_ascii_large_roundtrip" {
  let src = repeat("abCD09", 12)
  match from_ascii(src) {
    Some(bytes) => {
      assert(eq(length(bytes), String::length(src)))
      match to_ascii(bytes) {
        Some(decoded) => assert(decoded == src),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "bytes_hex_large_roundtrip" {
  let hex = repeat("00ff10ab", 12)
  match from_hex(hex) {
    Some(bytes) => {
      assert(eq(String::length(hex), length(bytes) * 2))
      assert(to_hex(bytes) == hex)
    },
    _ => assert(false)
  }
}

test "bytes_append" {
  let dst = Bytes::from_array([1, 2, 3])
  let src = Bytes::from_array([4, 5, 6])
  Bytes::append(dst, src)
  assert(eq(Bytes::length(dst), 6))
  assert(eq(Bytes::get(dst, 0), 1))
  assert(eq(Bytes::get(dst, 3), 4))
  assert(eq(Bytes::get(dst, 5), 6))
}

test "bytes_append_empty" {
  let dst = Bytes::from_array([1, 2])
  let src = Bytes::new()
  Bytes::append(dst, src)
  assert(eq(Bytes::length(dst), 2))
  let dst2 = Bytes::new()
  Bytes::append(dst2, Bytes::from_array([10]))
  assert(eq(Bytes::length(dst2), 1))
  assert(eq(Bytes::get(dst2, 0), 10))
}

/// Bytes::new starts at capacity 64 (gen_bytes_new_body), and Bytes::append
/// is one grow plus a memory.copy rather than a per-byte push loop, so the
/// grow path is only exercised by an append that crosses that boundary --
/// the small appends above never reach it.
test "bytes_append grows past the initial capacity" {
  let dst = Bytes::new()
  let mut i = 0
  while i < 50 {
    Bytes::push(dst, i)
    i = i + 1
  }
  let src = Bytes::new()
  let mut j = 0
  while j < 200 {
    Bytes::push(src, (j + 100)&255)
    j = j + 1
  }
  Bytes::append(dst, src)
  assert(eq(Bytes::length(dst), 250))
  // Every byte, not just the seams: a grow that copied the wrong length or
  // to the wrong offset would still land the endpoints correctly for some
  // off-by-one values.
  let mut k = 0
  let mut ok = true
  while k < 250 {
    let want = if k < 50 {
      k
    } else {
      (k - 50 + 100)&255
    }
    if Bytes::get(dst, k) != want {
      ok = false
    } else {
      ()
    }
    k = k + 1
  }
  assert(ok)
  // Still appendable afterwards -- the grow must have rewritten the header's
  // capacity and data pointer, not just moved the bytes.
  Bytes::push(dst, 7)
  assert(eq(Bytes::length(dst), 251))
  assert(eq(Bytes::get(dst, 250), 7))
}

/// Appending a buffer to ITSELF. Without a grow the source and destination
/// ranges overlap (memory.copy is memmove-like, so this is defined); with one
/// the copy reads out of the buffer the header no longer points at. Both are
/// load-bearing for the memory.copy implementation and neither is reachable
/// from the small-append tests above.
test "bytes_append onto itself, with and without a grow" {
  let small = Bytes::from_array([1, 2, 3])
  Bytes::append(small, small)
  assert(eq(Bytes::length(small), 6))
  assert(eq(Bytes::get(small, 0), 1))
  assert(eq(Bytes::get(small, 2), 3))
  assert(eq(Bytes::get(small, 3), 1))
  assert(eq(Bytes::get(small, 5), 3))
  // 40 bytes doubled is 80, past the initial capacity of 64.
  let big = Bytes::new()
  let mut i = 0
  while i < 40 {
    Bytes::push(big, i)
    i = i + 1
  }
  Bytes::append(big, big)
  assert(eq(Bytes::length(big), 80))
  let mut k = 0
  let mut ok = true
  while k < 80 {
    let want = if k < 40 {
      k
    } else {
      k - 40
    }
    if Bytes::get(big, k) != want {
      ok = false
    } else {
      ()
    }
    k = k + 1
  }
  assert(ok)
}

/// Filling the buffer to EXACTLY its capacity must not grow and must not
/// overrun: the length check is `need > capacity`, not `>=`.
test "bytes_append filling exactly to capacity" {
  let dst = Bytes::new()
  let src = Bytes::new()
  let mut i = 0
  while i < 64 {
    Bytes::push(src, (i + 1)&255)
    i = i + 1
  }
  Bytes::append(dst, src)
  assert(eq(Bytes::length(dst), 64))
  assert(eq(Bytes::get(dst, 0), 1))
  assert(eq(Bytes::get(dst, 63), 64))
  Bytes::push(dst, 200)
  assert(eq(Bytes::length(dst), 65))
  assert(eq(Bytes::get(dst, 64), 200))
  assert(eq(Bytes::get(dst, 63), 64))
}

test "bytes_blit" {
  let dst = Bytes::from_array([1, 2])
  let src = Bytes::from_array([10, 20, 30, 40, 50])
  Bytes::blit(dst, src, 1, 4)
  assert(eq(Bytes::length(dst), 5))
  assert(eq(Bytes::get(dst, 0), 1))
  assert(eq(Bytes::get(dst, 1), 2))
  assert(eq(Bytes::get(dst, 2), 20))
  assert(eq(Bytes::get(dst, 3), 30))
  assert(eq(Bytes::get(dst, 4), 40))
}

test "bytes_fill" {
  let buf = Bytes::new()
  Bytes::fill(buf, 0xFF, 5)
  assert(eq(Bytes::length(buf), 5))
  assert(eq(Bytes::get(buf, 0), 255))
  assert(eq(Bytes::get(buf, 4), 255))
}

test "bytes_fill_zero" {
  let buf = Bytes::new()
  Bytes::fill(buf, 0, 10)
  assert(eq(Bytes::length(buf), 10))
  assert(eq(Bytes::get(buf, 0), 0))
  assert(eq(Bytes::get(buf, 9), 0))
}

test "bytes_new_with_length" {
  // Bytes::new(n) is a length-n zero-filled buffer (MoonBit semantics);
  // the argument used to be silently accepted and emitted as a stranded
  // wasm operand (module failed validation at instantiation).
  let buf = Bytes::new(4)
  assert(eq(Bytes::length(buf), 4))
  assert(eq(Bytes::get(buf, 0), 0))
  assert(eq(Bytes::get(buf, 3), 0))
  Bytes::set(buf, 2, 65)
  assert(eq(Bytes::get(buf, 2), 65))
  Bytes::push(buf, 9)
  assert(eq(Bytes::length(buf), 5))
  assert(eq(Bytes::get(buf, 4), 9))
}
