//# Imports

import ./bytes.vibe {
  clamp_byte, equals, from_ascii, from_hex, get, is_byte, length, to_ascii, to_hex
}

//# Functions

fn repeat(s: String, n: Int) -> String {
  let rec r#loop = (i: Int, acc: String) -> String {
    if i <= 0 {
      acc
    } else r#loop(i - 1, "\{acc}\{s}")
  }
  r#loop(n, "")
}

//# Misc

test "bytes_byte_range" {
  assert(is_byte(0))
  assert(is_byte(255))
  assert(not(is_byte(-1)))
  assert(not(is_byte(256)))
  assert(eq(clamp_byte(-3), 0))
  assert(eq(clamp_byte(120), 120))
  assert(eq(clamp_byte(300), 255))
}

test "bytes_ascii_roundtrip" {
  match from_ascii("Az09") {
    Some(bytes) => {
      assert(eq(length(bytes), 4))
      match get(bytes = bytes, index = 0) {
        Some(v) => assert(eq(v, 65)),
        _ => assert(false)
      }
      match to_ascii(bytes) {
        Some(s) => assert(s == "Az09"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "bytes_new returns independent buffers" {
  let left = Bytes::new()
  Bytes::push(left, value = 1)
  let right = Bytes::new()
  Bytes::push(right, value = 2)
  assert(eq(Bytes::length(left), 1))
  assert(eq(Bytes::length(right), 1))
  assert(eq(Bytes::get(left, at = 0), 1))
  assert(eq(Bytes::get(right, at = 0), 2))
}

test "bytes_ascii_invalid" {
  match from_ascii("あ") {
    None => assert(true),
    _ => assert(false)
  }
  match to_ascii(Bytes::from_array([65, 200])) {
    None => assert(true),
    _ => assert(false)
  }
}

test "bytes_hex_roundtrip" {
  let hex = to_hex(Bytes::from_array([0, 15, 16, 255]))
  assert(hex == "000f10ff")
  match from_hex(hex) {
    Some(decoded) => assert(equals(a = decoded, b = Bytes::from_array([
      0,
      15,
      16,
      255
    ]))),
    _ => assert(false)
  }
}

test "bytes_hex_invalid" {
  match from_hex("0") {
    None => assert(true),
    _ => assert(false)
  }
  match from_hex("0g") {
    None => assert(true),
    _ => assert(false)
  }
}

test "bytes_ascii_large_roundtrip" {
  let src = repeat(s = "abCD09", n = 12)
  match from_ascii(src) {
    Some(bytes) => {
      assert(eq(length(bytes), String::length(src)))
      match to_ascii(bytes) {
        Some(decoded) => assert(decoded == src),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "bytes_hex_large_roundtrip" {
  let hex = repeat(s = "00ff10ab", n = 12)
  match from_hex(hex) {
    Some(bytes) => {
      assert(eq(String::length(hex), length(bytes) * 2))
      assert(to_hex(bytes) == hex)
    },
    _ => assert(false)
  }
}

test "bytes_append" {
  let dst = Bytes::from_array([1, 2, 3])
  let src = Bytes::from_array([4, 5, 6])
  Bytes::append(dst, bytes = src)
  assert(eq(Bytes::length(dst), 6))
  assert(eq(Bytes::get(dst, at = 0), 1))
  assert(eq(Bytes::get(dst, at = 3), 4))
  assert(eq(Bytes::get(dst, at = 5), 6))
}

test "bytes_append_empty" {
  let dst = Bytes::from_array([1, 2])
  let src = Bytes::new()
  Bytes::append(dst, bytes = src)
  assert(eq(Bytes::length(dst), 2))
  let dst2 = Bytes::new()
  Bytes::append(dst2, bytes = Bytes::from_array([10]))
  assert(eq(Bytes::length(dst2), 1))
  assert(eq(Bytes::get(dst2, at = 0), 10))
}

/// Bytes::new starts at capacity 64 (gen_bytes_new_body), and Bytes::append
/// is one grow plus a memory.copy rather than a per-byte push loop, so the
/// grow path is only exercised by an append that crosses that boundary --
/// the small appends above never reach it.
test "bytes_append grows past the initial capacity" {
  let dst = Bytes::new()
  let mut i = 0
  while i < 50 {
    Bytes::push(dst, value = i)
    i = i + 1
  }
  let src = Bytes::new()
  let mut j = 0
  while j < 200 {
    Bytes::push(src, value = (j + 100)&255)
    j = j + 1
  }
  Bytes::append(dst, bytes = src)
  assert(eq(Bytes::length(dst), 250))
  // Every byte, not just the seams: a grow that copied the wrong length or
  // to the wrong offset would still land the endpoints correctly for some
  // off-by-one values.
  let mut k = 0
  let mut ok = true
  while k < 250 {
    let want = if k < 50 {
      k
    } else {
      (k - 50 + 100)&255
    }
    if Bytes::get(dst, at = k) != want {
      ok = false
    } else {
      ()
    }
    k = k + 1
  }
  assert(ok)
  // Still appendable afterwards -- the grow must have rewritten the header's
  // capacity and data pointer, not just moved the bytes.
  Bytes::push(dst, value = 7)
  assert(eq(Bytes::length(dst), 251))
  assert(eq(Bytes::get(dst, at = 250), 7))
}

/// Appending a buffer to ITSELF. Without a grow the source and destination
/// ranges overlap (memory.copy is memmove-like, so this is defined); with one
/// the copy reads out of the buffer the header no longer points at. Both are
/// load-bearing for the memory.copy implementation and neither is reachable
/// from the small-append tests above.
test "bytes_append onto itself, with and without a grow" {
  let small = Bytes::from_array([1, 2, 3])
  Bytes::append(small, bytes = small)
  assert(eq(Bytes::length(small), 6))
  assert(eq(Bytes::get(small, at = 0), 1))
  assert(eq(Bytes::get(small, at = 2), 3))
  assert(eq(Bytes::get(small, at = 3), 1))
  assert(eq(Bytes::get(small, at = 5), 3))
  // 40 bytes doubled is 80, past the initial capacity of 64.
  let big = Bytes::new()
  let mut i = 0
  while i < 40 {
    Bytes::push(big, value = i)
    i = i + 1
  }
  Bytes::append(big, bytes = big)
  assert(eq(Bytes::length(big), 80))
  let mut k = 0
  let mut ok = true
  while k < 80 {
    let want = if k < 40 {
      k
    } else {
      k - 40
    }
    if Bytes::get(big, at = k) != want {
      ok = false
    } else {
      ()
    }
    k = k + 1
  }
  assert(ok)
}

/// Filling the buffer to EXACTLY its capacity must not grow and must not
/// overrun: the length check is `need > capacity`, not `>=`.
test "bytes_append filling exactly to capacity" {
  let dst = Bytes::new()
  let src = Bytes::new()
  let mut i = 0
  while i < 64 {
    Bytes::push(src, value = (i + 1)&255)
    i = i + 1
  }
  Bytes::append(dst, bytes = src)
  assert(eq(Bytes::length(dst), 64))
  assert(eq(Bytes::get(dst, at = 0), 1))
  assert(eq(Bytes::get(dst, at = 63), 64))
  Bytes::push(dst, value = 200)
  assert(eq(Bytes::length(dst), 65))
  assert(eq(Bytes::get(dst, at = 64), 200))
  assert(eq(Bytes::get(dst, at = 63), 64))
}

test "bytes_blit" {
  let dst = Bytes::from_array([1, 2])
  let src = Bytes::from_array([10, 20, 30, 40, 50])
  Bytes::blit(dst, src = src, start = 1, end = 4)
  assert(eq(Bytes::length(dst), 5))
  assert(eq(Bytes::get(dst, at = 0), 1))
  assert(eq(Bytes::get(dst, at = 1), 2))
  assert(eq(Bytes::get(dst, at = 2), 20))
  assert(eq(Bytes::get(dst, at = 3), 30))
  assert(eq(Bytes::get(dst, at = 4), 40))
}

test "bytes_fill" {
  let buf = Bytes::new()
  Bytes::fill(buf, value = 0xFF, count = 5)
  assert(eq(Bytes::length(buf), 5))
  assert(eq(Bytes::get(buf, at = 0), 255))
  assert(eq(Bytes::get(buf, at = 4), 255))
}

test "bytes_fill_zero" {
  let buf = Bytes::new()
  Bytes::fill(buf, value = 0, count = 10)
  assert(eq(Bytes::length(buf), 10))
  assert(eq(Bytes::get(buf, at = 0), 0))
  assert(eq(Bytes::get(buf, at = 9), 0))
}

test "bytes_new_with_length" {
  // Bytes::new(n) is a length-n zero-filled buffer (MoonBit semantics);
  // the argument used to be silently accepted and emitted as a stranded
  // wasm operand (module failed validation at instantiation).
  let buf = Bytes::new(4)
  assert(eq(Bytes::length(buf), 4))
  assert(eq(Bytes::get(buf, at = 0), 0))
  assert(eq(Bytes::get(buf, at = 3), 0))
  Bytes::set(buf, at = 2, value = 65)
  assert(eq(Bytes::get(buf, at = 2), 65))
  Bytes::push(buf, value = 9)
  assert(eq(Bytes::length(buf), 5))
  assert(eq(Bytes::get(buf, at = 4), 9))
}

test "blit preserves partial ranges, capacity boundaries, and source bytes" {
  let src = Bytes::new()
  let mut i1 = 0
  while i1 < 200 {
    Bytes::push(src, value = i1); i1 = i1 + 1
  }
  let dst = Bytes::new()
  Bytes::fill(dst, value = 255, count = 60)
  Bytes::blit(dst, src = src, start = 3, end = 7)
  assert(Bytes::length(dst) == 64)
  Bytes::blit(dst, src = src, start = 7, end = 200)
  assert(Bytes::length(dst) == 257)
  let mut i2 = 0
  while i2 < 60 {
    assert(Bytes::get(dst, at = i2) == 255); i2 = i2 + 1
  }
  let mut i3 = 60
  while i3 < 257 {
    assert(Bytes::get(dst, at = i3) == i3 - 57); i3 = i3 + 1
  }
  let mut i4 = 0
  while i4 < 200 {
    assert(Bytes::get(src, at = i4) == i4); i4 = i4 + 1
  }
}

test "blit self-copy works before and after growth" {
  let dst = Bytes::from_array([10, 20, 30, 40])
  Bytes::blit(dst, src = dst, start = 1, end = 3)
  assert(dst == Bytes::from_array([10, 20, 30, 40, 20, 30]))
  Bytes::fill(dst, value = 50, count = 58)
  Bytes::blit(dst, src = dst, start = 1, end = 64)
  assert(Bytes::length(dst) == 127)
  let mut i5 = 64
  while i5 < 127 {
    assert(Bytes::get(dst, at = i5) == Bytes::get(dst, at = i5 - 63)); i5 = i5 + 1
  }
}

test "blit can read bytes appended earlier in a self-copy" {
  let dst = Bytes::from_array([7, 9])
  Bytes::blit(dst, src = dst, start = 0, end = 130)
  assert(Bytes::length(dst) == 132)
  let mut i6 = 0
  while i6 < 132 {
    assert(Bytes::get(dst, at = i6) == (if i6 % 2 == 0 {
      7
    } else {
      9
    })); i6 = i6 + 1
  }
}

test "blit empty and reversed ranges do not access the source" {
  let dst = Bytes::from_array([12])
  let src = Bytes::new()
  Bytes::blit(dst, src = src, start = 0, end = 0)
  Bytes::blit(dst, src = src, start = 20, end = 10)
  Bytes::blit(dst, src = src, start = -1, end = -1)
  Bytes::blit(dst, src = src, start = 1<<40, end = 1<<39)
  assert(dst == Bytes::from_array([12]))
}

fn blit_bytes_arg(log: Array[Int], id: Int, bytes: Bytes) -> Bytes {
  Array::push(log, value = id)
  bytes
}
fn blit_index_arg(log: Array[Int], id: Int, index: Int) -> Int {
  Array::push(log, value = id)
  index
}

test "blit evaluates each argument once in source order" {
  let log: Array[Int] = []
  let dst = Bytes::new()
  let src = Bytes::from_array([10, 20, 30])
  Bytes::blit(blit_bytes_arg(log = log, id = 1, bytes = dst), src = blit_bytes_arg(log = log, id = 2, bytes = src), start = blit_index_arg(log = log, id = 3, index = 1), end = blit_index_arg(log = log, id = 4, index = 3))
  assert(log == [1, 2, 3, 4])
  assert(dst == Bytes::from_array([20, 30]))
  assert(src == Bytes::from_array([10, 20, 30]))
}

test "blit over an empty range at a wide index copies nothing" {
  // #3543: an index past the bytes traps rather than wrapping into range
  // (`tests/gates/early` row 4e2 asserts the trap); an empty range reads
  // nothing, wherever it starts.
  let src = Bytes::from_array([10, 20, 30])
  let dst = Bytes::new()
  Bytes::blit(dst, src = src, start = 1<<40, end = 1<<40)
  assert(dst == Bytes::new())
  Bytes::blit(dst, src = src, start = 1, end = 3)
  assert(dst == Bytes::from_array([20, 30]))
}
