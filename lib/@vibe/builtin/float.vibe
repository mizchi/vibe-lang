//# Functions

// Compiler-provided intrinsic type explicitly published by this module.
export {
  Float32
}

fn float_eq(a: Float32, b: Float32) -> Bool {
  a == b
}

export let eq: (Float32, Float32) -> Bool = float_eq

fn float_abs(_ x: Float32) -> Float32 {
  if x < 0.0f {
    0.0f - x
  } else x
}

export let abs: (Float32) -> Float32 = float_abs

fn float_max(a: Float32, b: Float32) -> Float32 {
  if a > b {
    a
  } else b
}

export let max: (Float32, Float32) -> Float32 = float_max

fn float_min(a: Float32, b: Float32) -> Float32 {
  if a < b {
    a
  } else b
}

export let min: (Float32, Float32) -> Float32 = float_min

fn float_lerp(a: Float32, b: Float32, t: Float32) -> Float32 {
  a + (b - a) * t
}

export let lerp: (Float32, Float32, Float32) -> Float32 = float_lerp

fn float_clamp(x: Float32, min_val: Float32, max_val: Float32) -> Float32 {
  if x < min_val {
    min_val
  }
  else if x > max_val {
    max_val
  }
  else x
}

export let clamp: (Float32, Float32, Float32) -> Float32 = float_clamp

fn float_is_nan(_ x: Float32) -> Bool {
  not(x == x)
}

export let is_nan: (Float32) -> Bool = float_is_nan

fn float_signum(_ x: Float32) -> Float32 {
  if x < 0.0f {
    0.0f - 1.0f
  }
  else if x > 0.0f {
    1.0f
  }
  else 0.0f
}

export let signum: (Float32) -> Float32 = float_signum

fn float_square(_ x: Float32) -> Float32 {
  x * x
}

export let square: (Float32) -> Float32 = float_square

fn float_is_zero(_ x: Float32) -> Bool {
  x == 0.0f
}

export let is_zero: (Float32) -> Bool = float_is_zero

fn float_is_negative(_ x: Float32) -> Bool {
  x < 0.0f
}

export let is_negative: (Float32) -> Bool = float_is_negative

fn float_is_positive(_ x: Float32) -> Bool {
  x > 0.0f
}

export let is_positive: (Float32) -> Bool = float_is_positive

export fn Float32::eq(_ a: Float32, b: Float32) -> Bool {
  float_eq(a = a, b = b)
}

export fn Float32::abs(_ x: Float32) -> Float32 {
  float_abs(x)
}

export fn Float32::max(_ a: Float32, b: Float32) -> Float32 {
  float_max(a = a, b = b)
}

export fn Float32::min(_ a: Float32, b: Float32) -> Float32 {
  float_min(a = a, b = b)
}

export fn Float32::lerp(_ a: Float32, b: Float32, t: Float32) -> Float32 {
  float_lerp(a = a, b = b, t = t)
}

export fn Float32::clamp(_ x: Float32, min_val: Float32, max_val: Float32) -> Float32 {
  float_clamp(x = x, min_val = min_val, max_val = max_val)
}

export fn Float32::is_nan(_ x: Float32) -> Bool {
  float_is_nan(x)
}

export fn Float32::signum(_ x: Float32) -> Float32 {
  float_signum(x)
}

export fn Float32::square(_ x: Float32) -> Float32 {
  float_square(x)
}

export fn Float32::is_zero(_ x: Float32) -> Bool {
  float_is_zero(x)
}

export fn Float32::is_negative(_ x: Float32) -> Bool {
  float_is_negative(x)
}

export fn Float32::is_positive(_ x: Float32) -> Bool {
  float_is_positive(x)
}
