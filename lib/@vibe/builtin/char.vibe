//# Functions

export fn to_int(ch: Char) -> Int {
  Char::to_int(ch)
}

export fn from_int(code: Int) -> Option[Char] {
  if code < 0 || code > 1114111 {
    None
  } else Some(Char::from_int(code))
}

export fn is_ascii(ch: Char) -> Bool {
  let code = to_int(ch)
  code >= 0 && code <= 127
}

export fn to_string(ch: Char) -> String {
  String::from_char_code(to_int(ch))
}

export fn from_string(s: String) -> Option[Char] {
  if String::length(s) == 1 {
    from_int(String::char_code_at(s, 0))
  } else None
}

export fn is_ascii_digit(ch: Char) -> Bool {
  let code = to_int(ch)
  code >= 48 && code <= 57
}

export fn is_ascii_hexdigit(ch: Char) -> Bool {
  let code = to_int(ch)
  is_ascii_digit(ch)
  || (code >= 65 && code <= 70)
  || (code >= 97 && code <= 102)
}

export fn is_ascii_lowercase(ch: Char) -> Bool {
  let code = to_int(ch)
  code >= 97 && code <= 122
}

export fn is_ascii_uppercase(ch: Char) -> Bool {
  let code = to_int(ch)
  code >= 65 && code <= 90
}

export fn to_ascii_lowercase(ch: Char) -> Char {
  if is_ascii_uppercase(ch) {
    Char::from_int(to_int(ch) + 32)
  } else ch
}

export fn to_ascii_uppercase(ch: Char) -> Char {
  if is_ascii_lowercase(ch) {
    Char::from_int(to_int(ch) - 32)
  } else ch
}

export fn is_ascii_alphabetic(ch: Char) -> Bool {
  is_ascii_lowercase(ch) || is_ascii_uppercase(ch)
}

export fn is_ascii_alnum(ch: Char) -> Bool {
  is_ascii_alphabetic(ch) || is_ascii_digit(ch)
}

export fn is_ascii_whitespace(ch: Char) -> Bool {
  let code = to_int(ch)
  code == 32 || code == 9 || code == 10 || code == 11 || code == 12 || code == 13
}
