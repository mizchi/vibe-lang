//# Imports

import ./ordering.vibe {
  Ordering
}

import ./string.vibe {
  Lines::parse, Lines::stringify, PromptText::new, String, String::index_of_from, from_char_code
}

//# Functions

fn string_drop(s: String, n: Int) -> String {
  String::drop(s, n = n)
}

fn string_head(_ s: String) -> String {
  String::head(s)
}

fn string_init(_ s: String) -> String {
  String::init(s)
}

fn string_last(_ s: String) -> String {
  String::last(s)
}

fn string_tail(_ s: String) -> String {
  String::tail(s)
}

fn string_take(s: String, n: Int) -> String {
  String::take(s, n = n)
}

fn string_count(s: String, sub: String) -> Int {
  String::count(s, sub = sub)
}

fn string_repeat(s: String, n: Int) -> String {
  String::repeat(s, n = n)
}

fn string_compare(a: String, b: String) -> Ordering {
  String::compare(a, b = b)
}

fn string_replace(s: String, pattern: String, replacement: String) -> String {
  String::replace(s, pattern = pattern, replacement = replacement)
}

fn string_is_blank(_ s: String) -> Bool {
  String::is_blank(s)
}

fn string_is_empty(_ s: String) -> Bool {
  String::is_empty(s)
}

fn string_pad_left(s: String, target_len: Int, pad_char: String) -> String {
  String::pad_left(s, target_len = target_len, pad_char = pad_char)
}

fn string_trim_end(_ s: String) -> String {
  String::trim_end(s)
}

fn string_pad_right(s: String, target_len: Int, pad_char: String) -> String {
  String::pad_right(s, target_len = target_len, pad_char = pad_char)
}

fn string_trim_start(_ s: String) -> String {
  String::trim_start(s)
}

fn string_replace_all(s: String, pattern: String, replacement: String) -> String {
  String::replace_all(s, pattern = pattern, replacement = replacement)
}

fn string_is_not_empty(_ s: String) -> Bool {
  String::is_not_empty(s)
}

//# Misc

test "string_is_empty" {
  assert(string_is_empty(""))
  assert(not(string_is_empty("a")))
}

test "string_equals_compare_blank" {
  assert(String::equals("abc", "abc"))
  assert(not(String::equals("abc", "ab")))
  inspect(string_compare(a = "abc", b = "abc"), "Equal")
  inspect(string_compare(a = "abc", b = "abd"), "Less")
  inspect(string_compare(a = "abd", b = "abc"), "Greater")
  assert(string_is_blank(""))
  assert(string_is_blank("    "))
  assert(not(string_is_blank(" a ")))
}

test "string_type_members_and_method_style" {
  assert(String::is_empty(""))
  assert(not(String::is_empty("x")))
  assert(not(string_is_not_empty("")))
  assert(string_is_not_empty("x"))
  assert("".is_empty())
  assert(not("x".is_empty()))
}

test "string_head_tail" {
  assert(String::equals(string_head("hello"), "h"))
  assert(String::equals(string_tail("hello"), "ello"))
  assert(String::equals(string_head(""), ""))
  assert(String::equals(string_tail(""), ""))
  assert(String::equals(string_tail("x"), ""))
}

test "string_last_init" {
  assert(String::equals(string_last("hello"), "o"))
  assert(String::equals(string_init("hello"), "hell"))
  assert(String::equals(string_last(""), ""))
  assert(String::equals(string_init("x"), ""))
}

test "string_take_drop" {
  assert(String::equals(string_take(s = "hello", n = 3), "hel"))
  assert(String::equals(string_drop(s = "hello", n = 2), "llo"))
  assert(String::equals(string_take(s = "hi", n = 10), "hi"))
  assert(String::equals(string_drop(s = "hi", n = 10), ""))
}

test "string_repeat" {
  assert(String::equals(string_repeat(s = "ab", n = 3), "ababab"))
  assert(String::equals(string_repeat(s = "x", n = 0), ""))
  assert(String::equals(string_repeat(s = "", n = 5), ""))
}

test "string_pad" {
  assert(String::equals(string_pad_left(s = "42", target_len = 5, pad_char = "0"), "00042"))
  assert(String::equals(string_pad_right(s = "hi", target_len = 5, pad_char = "."), "hi..."))
  assert(String::equals(string_pad_left(s = "hello", target_len = 3, pad_char = "x"), "hello"))
  assert(String::equals(string_pad_left(s = "a", target_len = 3, pad_char = "xy"), "xya"))
  assert(String::equals(string_pad_right(s = "a", target_len = 3, pad_char = "xy"), "axy"))
}

test "string_pad_edge_cases" {
  assert(String::equals(string_pad_left(s = "ab", target_len = 5, pad_char = ""), "ab"))
  assert(String::equals(string_pad_right(s = "ab", target_len = 5, pad_char = ""), "ab"))
  assert(String::equals(string_pad_left(s = "ab", target_len = 0, pad_char = "0"), "ab"))
  assert(String::equals(string_pad_right(s = "ab", target_len = -1, pad_char = "0"), "ab"))
}

test "string_contains" {
  assert(String::contains("hello world", "lo wo"))
  assert(String::contains("abc", ""))
  assert(not(String::contains("abc", "xyz")))
}

test "string_index_of" {
  assert(eq(String::index_of("hello", "ll"), 2))
  assert(eq(String::index_of("hello", "x"), -1))
  assert(eq(String::index_of("hello", ""), 0))
}

test "string_index_of_from" {
  assert(eq(String::index_of_from("ababa", sub = "ba", start = 2), 3))
  assert(eq(String::index_of_from("ababa", sub = "ba", start = 4), -1))
  assert(eq(String::index_of_from("ababa", sub = "a", start = -1), -1))
  assert(eq(String::index_of_from("ababa", sub = "a", start = 99), -1))
}

test "string_replace" {
  assert(String::equals(string_replace(s = "hello world", pattern = "world", replacement = "vibe"), "hello vibe"))
  assert(String::equals(string_replace(s = "aaa", pattern = "a", replacement = "b"), "baa"))
  assert(String::equals(string_replace(s = "hello", pattern = "x", replacement = "y"), "hello"))
  assert(String::equals(string_replace(s = "abc", pattern = "", replacement = "X"), "abc"))
}

test "string_count" {
  assert(eq(string_count(s = "hello", sub = "l"), 2))
  assert(eq(string_count(s = "aaaa", sub = "aa"), 2))
  assert(eq(string_count(s = "abc", sub = ""), 0))
}

test "string_replace_all" {
  assert(String::equals(string_replace_all(s = "foo bar foo", pattern = "foo", replacement = "x"), "x bar x"))
  assert(String::equals(string_replace_all(s = "aaaa", pattern = "aa", replacement = "b"), "bb"))
  assert(String::equals(string_replace_all(s = "abc", pattern = "", replacement = "z"), "abc"))
  assert(String::equals(string_replace_all(s = "ababa", pattern = "aba", replacement = "x"), "xba"))
}

test "string_type_calls_only" {
  assert(String::is_empty(""))
  assert(String::contains("hello", "ell"))
  assert(String::equals(String::replace_all("foo foo", pattern = "foo", replacement = "x"), "x x"))
}

test "string_trim" {
  assert(String::equals(String::trim("  hello  "), "hello"))
  assert(String::equals(string_trim_start("   hi"), "hi"))
  assert(String::equals(string_trim_end("hi   "), "hi"))
}

test "string_from_char_code_is_top_level" {
  assert(String::equals(from_char_code(65), "A"))
}

/// Regression: String::split used to be a stub that recursed into itself
/// (`String::split(s, sep)`), so importing this module and calling split
/// trapped with infinite recursion. It now splits on the separator.
test "string_split" {
  let parts = String::split("a,b,c", ",")
  assert(Array::length(parts) == 3)
  assert(String::equals(Array::get(parts, at = 0), "a"))
  assert(String::equals(Array::get(parts, at = 1), "b"))
  assert(String::equals(Array::get(parts, at = 2), "c"))
}

test "string_split_no_match" {
  let parts = String::split("hello", "x")
  assert(Array::length(parts) == 1)
  assert(String::equals(Array::get(parts, at = 0), "hello"))
}

test "string_split_empty_sep" {
  let parts = String::split("hi", "")
  assert(Array::length(parts) == 1)
  assert(String::equals(Array::get(parts, at = 0), "hi"))
}

/// #768: real direct-import coverage for String::to_lower/to_upper (fixed
/// previously but never actually exercised via a real import+call anywhere
/// -- the closing test at the time only ran through handler.vibe's own
/// ascii_lower workaround) and for the newly-added Lines::/PromptText::
/// builtins.
test "string_to_lower" {
  assert(String::to_lower("ABC") == "abc")
  assert(String::to_lower("MiXeD 123!") == "mixed 123!")
}

test "string_to_upper" {
  assert(String::to_upper("abc") == "ABC")
  assert(String::to_upper("MiXeD 123!") == "MIXED 123!")
}

test "lines_parse_and_stringify_roundtrip" {
  let lines = Lines::parse("a\nb\nc")
  assert(Array::length(lines) == 3)
  assert(String::equals(Array::get(lines, at = 0), "a"))
  assert(String::equals(Array::get(lines, at = 1), "b"))
  assert(String::equals(Array::get(lines, at = 2), "c"))
  assert(String::equals(Lines::stringify(lines), "a\nb\nc"))
}

test "prompt_text_new_is_identity" {
  assert(String::equals(PromptText::new("hello"), "hello"))
}

