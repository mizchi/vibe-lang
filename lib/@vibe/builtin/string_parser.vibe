//# Types

export type ParseResult[T] = Option[(T, Int)]

export type Parser[T] = (input: String, pos: Int) -> ParseResult[T]

//# Functions

export let map = [A, B](parser: Parser[A], f: (x: A) -> B) -> Parser[B] {
  (input: String, pos: Int) -> ParseResult[B] {
    match parser(input, pos) {
      Some((value, next)) => Some((f(value), next)),
      _ => None
    }
  }
}

export fn run[T](parser: Parser[T], input: String) -> Option[T] {
  match parser(input, 0) {
    Some((value, next)) => if next == String::length(input) {
      Some(value)
    } else None
    ,
    _ => None
  }
}

export fn char(expected: String) -> Parser[String] {
  (input: String, pos: Int) -> ParseResult[String] {
    if String::length(expected) != 1 {
      None
    }
    else if pos >= String::length(input) {
      None
    }
    else {
      let got = input[pos: pos + 1]
      if got == expected {
        Some((got, pos + 1))
      }
      else None
    }
  }
}

export fn fail[T]() -> Parser[T] {
  (_input: String, _pos: Int) -> ParseResult[T] {
    None
  }
}

export fn pure[T](value: T) -> Parser[T] {
  (_input: String, pos: Int) -> ParseResult[T] {
    Some((value, pos))
  }
}

export fn literal(expected: String) -> Parser[String] {
  (input: String, pos: Int) -> ParseResult[String] {
    let n = String::length(expected)
    if pos + n > String::length(input) {
      None
    }
    else {
      let got = input[pos: pos + n]
      if got == expected {
        Some((expected, pos + n))
      }
      else None
    }
  }
}

export fn or_else[T](left: Parser[T], right: Parser[T]) -> Parser[T] {
  (input: String, pos: Int) -> ParseResult[T] {
    match left(input, pos) {
      Some((value, next)) => Some((value, next)),
      _ => right(input, pos)
    }
  }
}

export fn and_then[A, B](parser: Parser[A], f: (x: A) -> Parser[B]) -> Parser[B] {
  (input: String, pos: Int) -> ParseResult[B] {
    match parser(input, pos) {
      Some((value, next)) => {
        let next_parser = f(value)
        next_parser(input, next)
      },
      _ => None
    }
  }
}

export fn any_char(input: String, pos: Int) -> ParseResult[String] {
  if pos >= String::length(input) {
    None
  }
  else Some((input[pos: pos + 1], pos + 1))
}

export fn satisfy(pred: (ch: String) -> Bool) -> Parser[String] {
  (input: String, pos: Int) -> ParseResult[String] {
    match any_char(input, pos) {
      Some((ch, next)) => if pred(ch) {
        Some((ch, next))
      } else None
      ,
      _ => None
    }
  }
}

export fn take_while(pred: (ch: String) -> Bool) -> Parser[String] {
  (input: String, pos: Int) -> ParseResult[String] {
    let len = String::length(input)
    let rec scan = (i: Int) -> Int {
      if i >= len {
        i
      }
      else {
        let ch = input[i: i + 1]
        if pred(ch) {
          scan(i + 1)
        } else i
      }
    }
    let end = scan(pos)
    Some((input[pos: end], end))
  }
}

export fn take_while1(pred: (ch: String) -> Bool) -> Parser[String] {
  and_then(take_while(pred), (text: String) -> Parser[String] {
    if String::length(text) == 0 {
      fail()
    } else pure(text)
  })
}

fn is_space_char(ch: String) -> Bool {
  ch == " " || ch == "\n" || ch == "\t" || ch == "r"
}

export fn spaces0(input: String, pos: Int) -> ParseResult[String] {
  let len = String::length(input)
  let rec scan = (i: Int) -> Int {
    if i >= len {
      i
    }
    else {
      let ch = input[i: i + 1]
      if is_space_char(ch) {
        scan(i + 1)
      }
      else i
    }
  }
  let end = scan(pos)
  Some((input[pos: end], end))
}

export fn token[T](parser: Parser[T]) -> Parser[T] {
  (input: String, pos: Int) -> ParseResult[T] {
    let start = match spaces0(input, pos) {
      Some((_ws0, next)) => next,
      _ => pos
    }
    match parser(input, start) {
      Some((value, after_value)) => {
        let end = match spaces0(input, after_value) {
          Some((_ws1, next)) => next,
          _ => after_value
        }
        Some((value, end))
      },
      _ => None
    }
  }
}

export fn kw(name: String) -> Parser[String] {
  token(literal(name))
}

export fn spaces1(input: String, pos: Int) -> ParseResult[String] {
  match spaces0(input, pos) {
    Some((text, next)) => if next == pos {
      None
    }
    else Some((text, next)),
    _ => None
  }
}

fn is_single_char(ch: String) -> Bool {
  String::length(ch) == 1
}

fn is_alpha_char(ch: String) -> Bool {
  if not(is_single_char(ch)) {
    false
  }
  else {
    let code = String::char_code_at(ch, 0)
    (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
  }
}

export fn alpha(input: String, pos: Int) -> ParseResult[String] {
  if pos >= String::length(input) {
    None
  }
  else {
    let ch = input[pos: pos + 1]
    if is_alpha_char(ch) {
      Some((ch, pos + 1))
    }
    else None
  }
}

fn is_digit_char(ch: String) -> Bool {
  if not(is_single_char(ch)) {
    false
  }
  else {
    let code = String::char_code_at(ch, 0)
    code >= 48 && code <= 57
  }
}

export fn digit(input: String, pos: Int) -> ParseResult[String] {
  if pos >= String::length(input) {
    None
  }
  else {
    let ch = input[pos: pos + 1]
    if is_digit_char(ch) {
      Some((ch, pos + 1))
    }
    else None
  }
}

export fn digits1(input: String, pos: Int) -> ParseResult[String] {
  let len = String::length(input)
  let rec scan = (i: Int) -> Int {
    if i >= len {
      i
    }
    else {
      let ch = input[i: i + 1]
      if is_digit_char(ch) {
        scan(i + 1)
      }
      else i
    }
  }
  let end = scan(pos)
  if end == pos {
    None
  }
  else Some((input[pos: end], end))
}

fn is_alnum_char(ch: String) -> Bool {
  is_alpha_char(ch) || is_digit_char(ch)
}

export fn alnum(input: String, pos: Int) -> ParseResult[String] {
  if pos >= String::length(input) {
    None
  }
  else {
    let ch = input[pos: pos + 1]
    if is_alnum_char(ch) {
      Some((ch, pos + 1))
    }
    else None
  }
}

export fn identifier(input: String, pos: Int) -> ParseResult[String] {
  match alpha(input, pos) {
    Some((head, next)) => {
      let len = String::length(input)
      let rec scan = (i: Int) -> Int {
        if i >= len {
          i
        }
        else {
          let ch = input[i: i + 1]
          if is_alnum_char(ch) {
            scan(i + 1)
          }
          else i
        }
      }
      let end = scan(next)
      let tail = input[next: end]
      Some(("\{head}\{tail}", end))
    },
    _ => None
  }
}

fn parse_uint_value(text: String) -> Int {
  let len = String::length(text)
  let rec go = (i: Int, acc: Int) -> Int {
    if i >= len {
      acc
    }
    else {
      let code = String::char_code_at(text, i)
      go(i + 1, acc * 10 + (code - 48))
    }
  }
  go(0, 0)
}

export fn uint(input: String, pos: Int) -> ParseResult[Int] {
  match digits1(input, pos) {
    Some((text, next)) => Some((parse_uint_value(text), next)),
    _ => None
  }
}
