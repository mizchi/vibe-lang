//# Types

export trait Eq

export trait Ord

export trait Add

export trait Sub

export trait Mul

export trait Div

export trait Signed

// Marker registration for `[T: Default]` bounds (#1847): the method-bearing
// declaration (`trait Default { default() -> Self }`) and the primitive impl
// bodies live in @vibe/core's default.vibe, so `T::default()` dispatch needs
// that import; this marker + impls make the BOUND satisfiable for primitives
// everywhere. (`Hash` used to have the same marker/method split, until #1844
// made @vibe/core's method-bearing `Hash` the only definition.)
export trait Default

// `to_string` carries this source-level bound; its runtime lowering remains
// unchanged, but full import-path bound enforcement needs real witnesses.
export trait Show

impl Show for Int

impl Show for Double

impl Show for Bool

impl Show for Char

impl Show for String

impl Eq for Int

impl Eq for Double

impl Eq for Bool

impl Eq for Char

impl Eq for String

impl Ord for Int

impl Ord for Double

impl Ord for String

impl Add for Int

impl Add for Double

impl Add for String

impl Sub for Int

impl Sub for Double

impl Mul for Int

impl Mul for Double

impl Div for Int

impl Div for Double

impl Signed for Int

impl Signed for Double

impl Default for Int

impl Default for Double

impl Default for Bool

impl Default for String

//# Functions

export fn cmp_eq[T: Eq](a: T, b: T) -> Bool {
  a == b
}

export fn cmp_ne[T: Eq](a: T, b: T) -> Bool {
  not(cmp_eq(a, b))
}

export fn num_abs[T: Signed + Ord + Sub](x: T) -> T {
  if x < 0 {
    0 - x
  } else x
}

export fn num_add[T: Add](a: T, b: T) -> T {
  a + b
}

export fn num_div[T: Div](a: T, b: T) -> T {
  a / b
}

export fn num_mul[T: Mul](a: T, b: T) -> T {
  a * b
}

export fn num_sub[T: Sub](a: T, b: T) -> T {
  a - b
}

export fn ord_max[T: Ord](a: T, b: T) -> T {
  if a > b {
    a
  } else b
}

export fn ord_min[T: Ord](a: T, b: T) -> T {
  if a < b {
    a
  } else b
}

export fn ord_clamp[T: Ord](x: T, min_val: T, max_val: T) -> T {
  if x < min_val {
    min_val
  }
  else if x > max_val {
    max_val
  }
  else x
}

export fn num_clamp[T: Ord](x: T, min_val: T, max_val: T) -> T {
  ord_clamp(x, min_val, max_val)
}

/// Render `x`. `Show` is a marker trait with no methods, so this body cannot
/// dispatch and `__to_string` is the ADR-0058 runtime heuristic ("a tagged i64
/// that looks like a string pointer, else a decimal integer") -- which is why
/// every aggregate used to print as a pointer decimal here (#1392).
///
/// It renders structurally now because the body IS the call: desugar_trait_dict
/// recognizes a one-parameter `__to_string` pass-through by shape and inlines
/// each call site, so `to_string(v)` takes the same type-directed rewrite
/// `"\{v}"` does. Inside a generic (`f[T: Show](x) { to_string(x) }`) the
/// argument's type is a variable, nothing resolves, and the heuristic still
/// applies -- real `Show` dispatch is #1392's remaining slice.
///
/// Do not "simplify" the body away from `__to_string(x)`: that shape is what
/// the rewrite matches on.
export fn to_string[T: Show](x: T) -> String {
  __to_string(x)
}

export fn num_square[T: Mul](x: T) -> T {
  x * x
}

export fn ord_between[T: Ord + Eq](x: T, min_val: T, max_val: T) -> Bool {
  x >= min_val && x <= max_val
}

export fn default_require[T: Default](x: T) -> T {
  x
}
