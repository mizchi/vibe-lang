//# Ordering -- the result of `compare` (#3042, ADR-0115)
//#
//# `derive (Ord)` generates `T::compare(a, b) -> Ordering`, and every
//# `compare` in this package answers one, so a `match` over the result is
//# checked for exhaustiveness: `match T::compare(a, b) { Less => .., Greater =>
//# .. }` is refused for the missing `Equal`, where an `Int` of -1 / 0 / 1 let
//# the missing case through.
//#
//# The compiler gives every program this same declaration as a prelude, so
//# `Ordering`, `Less`, `Equal` and `Greater` need no import. It is declared
//# here as well because this package's own `compare` functions build values of
//# it and are compiled by the committed seed, which predates the prelude; a
//# program that links this file uses this declaration instead of the
//# compiler's copy, and the two are the same enum.

export enum Ordering {
  Less;
  Equal;
  Greater
} derive (Eq, Ord, Show)

/// The arithmetic form of an `Ordering`: -1, 0 or 1. For code that has to
/// hand a comparison to an interface that still speaks `Int` (a comparator
/// callback of `@vibe/core`'s sorted collections, say).
export fn Ordering::to_int(o: Ordering) -> Int {
  match o {
    Less => 0 - 1,
    Equal => 0,
    Greater => 1
  }
}

/// The opposite ordering: `Less` and `Greater` swap, `Equal` stays. Sorting by
/// `(a, b) -> Ordering::reverse(compare(a, b))` sorts descending.
export fn Ordering::reverse(o: Ordering) -> Ordering {
  match o {
    Less => Greater,
    Equal => Equal,
    Greater => Less
  }
}
