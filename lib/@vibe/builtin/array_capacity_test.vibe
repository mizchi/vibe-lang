test "reserved arrays start empty and preserve values across growth" {
  for n in [0, 1, 2, 3, 8, 9, 127, 513, 4096] {
    let xs: Array[Int] = Array::with_capacity(n)
    let alias = xs
    assert(Array::length(xs) == 0)
    let mut i = 0
    while i < n + 100 {
      Array::push(xs, i * 3)
      i = i + 1
    }
    assert(Array::length(alias) == n + 100)
    i = 0
    while i < Array::length(alias) {
      assert(Array::get(alias, i) == i * 3)
      i = i + 1
    }
  }
}

fn capacity_argument(calls: Array[Int]) -> Int {
  Array::push(calls, 1)
  3
}

test "capacity argument is evaluated once and element types infer from pushes" {
  let calls: Array[Int] = []
  let xs = Array::with_capacity(capacity_argument(calls))
  Array::push(xs, "hello")
  inspect(Array::length(calls), content = "1")
  inspect(Array::get(xs, 0), content = "hello")
}

fn capacity_owned_values() -> Array[Array[Int]] {
  let xs: Array[Array[Int]] = Array::with_capacity(3)
  let kept = [11, 12]
  Array::push(xs, kept)
  Array::push(xs, [21, 22])
  Array::push(xs, [31, 32])
  Array::truncate(xs, 1)
  Array::push(xs, [41, 42])
  Array::push(xs, kept)
  Array::push(xs, [51, 52])
  xs
}

test "reserved arrays own their elements through truncate reuse and later growth" {
  let xs = capacity_owned_values()
  inspect(xs, content = "[[11, 12], [41, 42], [11, 12], [51, 52]]")
  Array::set(xs, 0, [61, 62])
  inspect(Array::get(xs, 2), content = "[11, 12]")
  Array::truncate(xs, 0)
  Array::push(xs, [71, 72])
  inspect(xs, content = "[[71, 72]]")
}
