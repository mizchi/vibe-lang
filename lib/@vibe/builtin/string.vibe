//# Functions

// Every scanner in this file is a `while` loop, not a `let rec` closure. A
// local `let rec` self-calls through the function table (call_indirect), which
// the self-tail-call pass (rewrite_self_tail_calls) does NOT turn into a loop
// -- it only covers TOP-LEVEL self-recursion. One frame per scanned character
// meant a search overflowed the real wasm call stack at a ~4-5 KB haystack
// ("RangeError: Maximum call stack size exceeded", surfacing as the runner's
// "expression too deeply nested") -- hit in practice by `vibe diagnostics` /
// LSP publishDiagnostics on lsp_server.vibe itself, whose located-error path
// searches the whole source text.
//
// This file must not define a function whose name the builtin registry already
// owns. Such a definition replaces the builtin for the WHOLE linked program,
// including at call sites in files that never imported it (#2378), so a
// re-implementation here would take over every dependent's calls.
// `scripts/check_builtin_shadowing.sh` enforces that.

// Compiler-provided intrinsic signatures are explicitly published.
export {
  String, String::unicode_length, String::utf16_length, String::utf8_length
}

fn string_drop(s: String, n: Int) -> String {
  let len = String::length(s)
  if n <= 0 {
    s
  }
  else if n >= len {
    ""
  }
  else s[n: len]
}

fn string_head(s: String) -> String {
  if String::length(s) == 0 {
    ""
  }
  else s[0: 1]
}

fn string_init(s: String) -> String {
  let len = String::length(s)
  if len <= 1 {
    ""
  }
  else s[0: len - 1]
}

fn string_last(s: String) -> String {
  let len = String::length(s)
  if len == 0 {
    ""
  }
  else s[len - 1: len]
}

fn string_tail(s: String) -> String {
  let len = String::length(s)
  if len <= 1 {
    ""
  }
  else s[1: len]
}

fn string_take(s: String, n: Int) -> String {
  let len = String::length(s)
  if n <= 0 {
    ""
  }
  else if n >= len {
    s
  }
  else s[0: n]
}

fn string_repeat(s: String, n: Int) -> String {
  let rec go = (acc: String, chunk: String, count: Int) -> String {
    if count <= 0 {
      acc
    }
    else if count % 2 == 1 {
      go("\{acc}\{chunk}", "\{chunk}\{chunk}", count / 2)
    } else go(acc, "\{chunk}\{chunk}", count / 2)
  }
  go("", s, n)
}

export fn from_char_code(code: Int) -> String {
  String::from_char_code(code)
}

fn string_compare(a: String, b: String) -> Int {
  if a == b {
    0
  }
  else if a < b {
    -1
  }
  else 1
}

fn string_is_empty(s: String) -> Bool {
  String::length(s) == 0
}

fn string_build_pad(pad_char: String, pad_len: Int) -> String {
  if pad_len <= 0 {
    ""
  }
  else {
    let unit_len = String::length(pad_char)
    if unit_len == 0 {
      ""
    }
    else {
      let repeats = (pad_len + unit_len - 1) / unit_len
      string_take(string_repeat(pad_char, repeats), pad_len)
    }
  }
}

fn string_pad_left(s: String, target_len: Int, pad_char: String) -> String {
  let len = String::length(s)
  let pad_len = target_len - len
  if pad_len <= 0 {
    s
  }
  else {
    let pad = string_build_pad(pad_char, pad_len)
    if String::length(pad) == 0 {
      s
    } else "\{pad}\{s}"
  }
}

fn string_pad_right(s: String, target_len: Int, pad_char: String) -> String {
  let len = String::length(s)
  let pad_len = target_len - len
  if pad_len <= 0 {
    s
  }
  else {
    let pad = string_build_pad(pad_char, pad_len)
    if String::length(pad) == 0 {
      s
    } else "\{s}\{pad}"
  }
}

fn is_ascii_whitespace(code: Int) -> Bool {
  code == 32 || code == 9 || code == 10 || code == 13
}

fn string_equals_value(a: String, b: String) -> Bool {
  a == b
}

fn string_is_not_empty(s: String) -> Bool {
  String::length(s) > 0
}

/// Search for `sub` in `s` at or after `start`, in ONE call to the
/// `String::index_of` builtin -- the SIMD window search of ADR-0054, not a
/// byte-at-a-time loop.
///
/// Seeding the scan is free because `String::substring` does not copy: on the
/// linear lane it returns `((ptr + start) << 32) | (len - start)`, a second
/// fat value into the SAME buffer (`gen_str_substring_body`). So `s[start:
/// s_len]` is a view, and this stays one pass over the tail with no
/// allocation.
///
/// `start > s_len` answers -1. The byte-at-a-time version it replaces
/// answered `1` there for an empty needle, which no caller could reach
/// (`String::replace_all` advances by at most `s_len`) and which nothing
/// documented or tested.
///
/// Defining `String::index_of` in this file would not just shadow the builtin
/// for every dependent (see the note at the top) -- it would make this
/// function call itself.
fn string_index_of_from(s: String, sub: String, start: Int) -> Int {
  let s_len = String::length(s)
  if start < 0 {
    -1
  }
  else if start > s_len {
    -1
  }
  else {
    let hit = String::index_of(s[start: s_len], sub)
    if hit < 0 {
      -1
    } else {
      start + hit
    }
  }
}

export fn String::drop(s: String, n: Int) -> String {
  string_drop(s, n)
}

export fn String::head(s: String) -> String {
  string_head(s)
}

export fn String::init(s: String) -> String {
  string_init(s)
}

export fn String::last(s: String) -> String {
  string_last(s)
}

export fn String::tail(s: String) -> String {
  string_tail(s)
}

export fn String::take(s: String, n: Int) -> String {
  string_take(s, n)
}

/// Non-overlapping occurrences, counted by the SIMD scanner rather than by
/// walking every candidate position: each hit jumps the cursor past the match
/// instead of stepping one byte at a time on a miss.
export fn String::count(s: String, sub: String) -> Int {
  let s_len = String::length(s)
  let sub_len = String::length(sub)
  if sub_len == 0 || sub_len > s_len {
    0
  }
  else {
    let mut i = 0
    let mut acc = 0
    let mut searching = true
    while searching && i <= s_len - sub_len {
      let idx = string_index_of_from(s, sub, i)
      if idx < 0 {
        searching = false
      } else {
        acc = acc + 1
        i = idx + sub_len
      }
    }
    acc
  }
}

export fn String::equals(a: String, b: String) -> Bool {
  string_equals_value(a, b)
}

export fn String::repeat(s: String, n: Int) -> String {
  string_repeat(s, n)
}

export fn String::compare(a: String, b: String) -> Int {
  string_compare(a, b)
}

export fn String::replace(s: String, pattern: String, replacement: String) -> String {
  let pat_len = String::length(pattern)
  if pat_len == 0 {
    s
  }
  else {
    let idx = String::index_of(s, pattern)
    if idx < 0 {
      s
    }
    else {
      let before = s[0: idx]
      let after = s[idx + pat_len: String::length(s)]
      "\{before}\{replacement}\{after}"
    }
  }
}

export fn String::is_empty(s: String) -> Bool {
  string_is_empty(s)
}

export fn String::pad_left(s: String, target_len: Int, pad_char: String) -> String {
  string_pad_left(s, target_len, pad_char)
}

export fn String::trim_end(s: String) -> String {
  let len = String::length(s)
  let mut end = len
  while end > 0 && is_ascii_whitespace(String::char_code_at(s, end - 1)) {
    end = end - 1
  }
  if end == len {
    s
  }
  else s[0: end]
}

export fn String::pad_right(s: String, target_len: Int, pad_char: String) -> String {
  string_pad_right(s, target_len, pad_char)
}

export fn String::trim_start(s: String) -> String {
  let len = String::length(s)
  let mut start = 0
  while start < len && is_ascii_whitespace(String::char_code_at(s, start)) {
    start = start + 1
  }
  if start == 0 {
    s
  }
  else s[start: len]
}

export fn String::trim(s: String) -> String {
  String::trim_end(String::trim_start(s))
}

fn string_is_blank(s: String) -> Bool {
  string_is_empty(String::trim(s))
}

export fn String::is_blank(s: String) -> Bool {
  string_is_blank(s)
}

export fn String::replace_all(s: String, pattern: String, replacement: String) -> String {
  let pat_len = String::length(pattern)
  let s_len = String::length(s)
  if pat_len == 0 || pat_len > s_len {
    s
  }
  else {
    let sb = StringBuilder::new()
    let mut start = 0
    let mut done = false
    while !done {
      let idx = string_index_of_from(s, pattern, start)
      if idx < 0 {
        StringBuilder::push(sb, s[start: s_len])
        done = true
      } else {
        StringBuilder::push(sb, s[start: idx])
        StringBuilder::push(sb, replacement)
        start = idx + pat_len
      }
    }
    StringBuilder::freeze(sb)
  }
}

export fn String::is_not_empty(s: String) -> Bool {
  string_is_not_empty(s)
}

export fn String::to_upper(s: String) -> String {
  let len = String::length(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    let code = String::char_code_at(s, i)
    let upper_code = if code >= 97 && code <= 122 {
      code - 32
    } else code
    StringBuilder::push(sb, String::from_char_code(upper_code))
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

export fn String::to_lower(s: String) -> String {
  let len = String::length(s)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    let code = String::char_code_at(s, i)
    let lower_code = if code >= 65 && code <= 90 {
      code + 32
    } else code
    StringBuilder::push(sb, String::from_char_code(lower_code))
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

/// #768: checker-recognized (checker/builtins_system.vibe's lookup_io_a/
/// lookup_io_c) since the retired MoonBit host, but never implemented on
/// selfhost -- any direct call fell through codegen as an "undefined
/// variable" dead end (same "checker says yes, nothing implements it" gap
/// Fs::remove/Fs::mkdir_p had). `lib/@mizchi/markdown/markdown.vibe` calls
/// `Lines::parse`/`Lines::stringify` throughout with no import (relying on
/// the magic name), so this was a real, silently-broken dependency with no
/// test coverage catching it. `PromptText::new` is a trusted-literal marker
/// like `Path::ref` -- identity at runtime, the distinction is type-level
/// only (see checker/builtins_system.vibe's comment on Path::ref for the
/// same pattern). `Llm::complete`/`Rlm::run` were the same shape without the
/// second half -- no host runtime implementation exists anywhere -- so #2110
/// removed their declarations instead of leaving a name the checker accepts
/// and codegen cannot lower.
export fn Lines::parse(s: String) -> Array[String] {
  String::split(s, "\n")
}

export fn Lines::stringify(lines: Array[String]) -> String {
  String::join(lines, "\n")
}

export fn PromptText::new(s: String) -> String {
  s
}
