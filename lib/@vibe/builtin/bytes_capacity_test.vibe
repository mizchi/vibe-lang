test "reserved byte buffers start empty and preserve bytes across growth" {
  for n in [0, 1, 63, 64, 65, 127, 128, 513, 4096] {
    let b = Bytes::with_capacity(n)
    assert(Bytes::length(b) == 0)
    let mut i = 0
    while i < n + 100 {
      Bytes::push(b, i % 251)
      i = i + 1
    }
    assert(Bytes::length(b) == n + 100)
    i = 0
    while i < Bytes::length(b) {
      assert(Bytes::get(b, i) == i % 251)
      i = i + 1
    }
  }
}

test "reserved byte buffers support append and self blit" {
  let b = Bytes::with_capacity(128)
  Bytes::append(b, Bytes::from_array([1, 2, 3]))
  Bytes::blit(b, b, 0, 3)
  let values: Array[Int] = Bytes::to_array(b)
  inspect(values, content = "[1, 2, 3, 1, 2, 3]")
  Bytes::set(b, 1, 42)
  let sliced: Array[Int] = Bytes::to_array(Bytes::slice(b, 0, 3))
  inspect(sliced, content = "[1, 42, 3]")
}

fn capacity_argument(calls: Array[Int]) -> Int {
  Array::push(calls, 1)
  256
}

test "capacity arguments are evaluated once and the builtin is a function value" {
  let calls: Array[Int] = []
  let b = Bytes::with_capacity(capacity_argument(calls))
  inspect(Array::length(calls), content = "1")
  let reserve: (Int) -> Bytes = Bytes::with_capacity
  let other = reserve(128)
  Bytes::push(b, 7)
  Bytes::push(other, 9)
  inspect([Bytes::get(b, 0), Bytes::get(other, 0)], content = "[7, 9]")
}
