//# Imports

import @vibe/builtin {
  Int::checked_add, Int::checked_div, Int::checked_mul, Int::checked_neg, Int::checked_sub, max_value, min_value
}

//# Tests
// #3127: the checked forms answer `None` exactly where the bare operator
// wraps, and `Some` of the bare operator's answer everywhere else. The bare
// operators keep wrapping (ADR-0105).

test "bare operators still wrap" {
  inspect(max_value + 1 == min_value, content = "true")
  inspect(min_value - 1 == max_value, content = "true")
}

test "Int::checked_add" {
  inspect(Int::checked_add(2, b = 3), content = "Some(5)")
  inspect(Int::checked_add(0 - 7, b = 3), content = "Some(-4)")
  inspect(Int::checked_add(max_value, b = 0) == Some(max_value), content = "true")
  inspect(Int::checked_add(max_value, b = 1), content = "None")
  inspect(Int::checked_add(min_value, b = 0 - 1), content = "None")
  inspect(Int::checked_add(max_value, b = min_value), content = "Some(-1)")
  inspect(Int::checked_add(min_value, b = min_value), content = "None")
}

test "Int::checked_sub" {
  inspect(Int::checked_sub(3, b = 5), content = "Some(-2)")
  inspect(Int::checked_sub(min_value, b = 1), content = "None")
  inspect(Int::checked_sub(max_value, b = 0 - 1), content = "None")
  inspect(Int::checked_sub(0 - 1, b = max_value) == Some(min_value), content = "true")
  inspect(Int::checked_sub(0, b = min_value), content = "None")
  inspect(Int::checked_sub(min_value, b = min_value), content = "Some(0)")
}

test "Int::checked_mul" {
  inspect(Int::checked_mul(6, b = 7), content = "Some(42)")
  inspect(Int::checked_mul(0 - 6, b = 7), content = "Some(-42)")
  inspect(Int::checked_mul(0, b = min_value), content = "Some(0)")
  inspect(Int::checked_mul(max_value, b = 2), content = "None")
  inspect(Int::checked_mul(min_value, b = 0 - 1), content = "None")
  inspect(Int::checked_mul(0 - 1, b = min_value), content = "None")
  inspect(Int::checked_mul(max_value, b = 0 - 1) == Some(min_value + 1), content = "true")
  // 2^31 * 2^31 = 2^62 is one past max_value.
  inspect(Int::checked_mul(2147483648, b = 2147483648), content = "None")
  inspect(Int::checked_mul(2147483648, b = 1073741824), content = "Some(2305843009213693952)")
}

test "Int::checked_div" {
  inspect(Int::checked_div(7, b = 2), content = "Some(3)")
  inspect(Int::checked_div(0 - 7, b = 2), content = "Some(-3)")
  inspect(Int::checked_div(7, b = 0), content = "None")
  inspect(Int::checked_div(min_value, b = 0 - 1), content = "None")
  inspect(Int::checked_div(min_value, b = 1) == Some(min_value), content = "true")
}

test "Int::checked_neg" {
  inspect(Int::checked_neg(5), content = "Some(-5)")
  inspect(Int::checked_neg(max_value) == Some(min_value + 1), content = "true")
  inspect(Int::checked_neg(min_value), content = "None")
}
