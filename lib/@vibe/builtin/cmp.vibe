//# Imports

import ./ordering.vibe {
  Ordering
}

//# Functions

export fn minmax(a: Int, b: Int) -> (Int, Int) {
  if a <= b {
    (a, b)
  } else (b, a)
}

export fn maximum(a: Int, b: Int) -> Int {
  if a > b {
    a
  } else b
}

export fn minimum(a: Int, b: Int) -> Int {
  if a < b {
    a
  } else b
}

export fn minmax_by[T](a: T, b: T, compare: (x: T, y: T) -> Ordering) -> (T, T) {
  match compare(a, b) {
    Greater => (b, a),
    _ => (a, b)
  }
}

export fn maximum_by[T](a: T, b: T, compare: (x: T, y: T) -> Ordering) -> T {
  match compare(a, b) {
    Less => b,
    _ => a
  }
}

export fn minimum_by[T](a: T, b: T, compare: (x: T, y: T) -> Ordering) -> T {
  match compare(a, b) {
    Greater => b,
    _ => a
  }
}

export fn int_compare(a: Int, b: Int) -> Ordering {
  if a < b {
    Less
  }
  else if a > b {
    Greater
  }
  else Equal
}

export fn float_compare(a: Float, b: Float) -> Ordering {
  if a < b {
    Less
  }
  else if a > b {
    Greater
  }
  else Equal
}

export fn minmax_by_key[T, K](a: T, b: T, key: (x: T) -> K, compare_key: (x: K, y: K) -> Ordering) -> (T, T) {
  minmax_by(a, b, (x: T, y: T) -> Ordering {
    compare_key(key(x), key(y))
  })
}

export fn double_compare(a: Double, b: Double) -> Ordering {
  if a < b {
    Less
  }
  else if a > b {
    Greater
  }
  else Equal
}

export fn maximum_by_key[T, K](a: T, b: T, key: (x: T) -> K, compare_key: (x: K, y: K) -> Ordering) -> T {
  maximum_by(a, b, (x: T, y: T) -> Ordering {
    compare_key(key(x), key(y))
  })
}

export fn minimum_by_key[T, K](a: T, b: T, key: (x: T) -> K, compare_key: (x: K, y: K) -> Ordering) -> T {
  minimum_by(a, b, (x: T, y: T) -> Ordering {
    compare_key(key(x), key(y))
  })
}

/// Byte-wise lexicographic comparison.
export fn string_compare(a: String, b: String) -> Ordering {
  if a < b {
    Less
  } else if a > b {
    Greater
  } else Equal
}
