//# Imports

import ./func.vibe {
  compose, flip, identity
}

//# Misc

test "compose applies left to right" {
  let inc = (x: Int) -> Int {
    x + 1
  }
  let dbl = (x: Int) -> Int {
    x * 2
  }
  // compose(inc, dbl) = (x) -> dbl(inc(x))
  let h = compose(inc, dbl)
  assert(eq(h(10), 22))
  assert(eq(h(0), 2))
}

test "identity returns its argument" {
  assert(eq(identity(7), 7))
  assert(identity("vibe") == "vibe")
}

test "compose with identity is a no-op stage" {
  let inc = (x: Int) -> Int {
    x + 1
  }
  let h = compose(identity, inc)
  assert(eq(h(41), 42))
  let g = compose(inc, identity)
  assert(eq(g(41), 42))
}

test "flip swaps argument order" {
  let sub = (a: Int, b: Int) -> Int {
    a - b
  }
  let rsub = flip(sub)
  assert(eq(sub(10, 3), 7))
  assert(eq(rsub(10, 3), -7))
}

test "compose builds reusable pipeline stages" {
  let inc = (x: Int) -> Int {
    x + 1
  }
  let dbl = (x: Int) -> Int {
    x * 2
  }
  let neg = (x: Int) -> Int {
    0 - x
  }
  let stage = compose(compose(inc, dbl), neg)
  // neg(dbl(inc(3))) = neg(dbl(4)) = neg(8) = -8
  assert(eq(stage(3), -8))
}
