//# Functions

// Compiler-provided intrinsic signatures are explicitly published.
export {
  Int, Int::clz, Int::ctz, Int::popcount, Int::to_double, Int::to_string
}

fn int_pow(base: Int, exp: Int) -> Int {
  if exp <= 0 {
    1
  }
  else if exp == 1 {
    base
  }
  else if exp % 2 == 0 {
    let half = int_pow(base, exp / 2)
    half * half
  } else base * int_pow(base, exp - 1)
}

export fn pow(base: Int, exp: Int) -> Int {
  int_pow(base, exp)
}

fn int_is_zero(x: Int) -> Bool {
  x == 0
}

export fn is_zero(x: Int) -> Bool {
  int_is_zero(x)
}

fn int_factorial(n: Int) -> Int {
  if n <= 1 {
    1
  }
  else n * int_factorial(n - 1)
}

export fn factorial(n: Int) -> Int {
  int_factorial(n)
}

fn int_fibonacci(n: Int) -> Int {
  let rec fib = (a: Int, b: Int, count: Int) -> Int {
    if count <= 0 {
      a
    }
    else fib(b, a + b, count - 1)
  }
  fib(0, 1, n)
}

export fn fibonacci(n: Int) -> Int {
  int_fibonacci(n)
}

// #1877: Int is 63-bit; max = 2^62-1. Spelled by arithmetic because the
// committed seed's lexer still enforces the old 2^61-1 literal bound and
// seed-driven tooling (vibe fmt/check) lexes this file — collapse to the
// plain literal after the next bootstrap bump.
let int_max_value: Int = (2305843009213693951<<1)|1

export let max_value: Int = int_max_value

let int_min_value: Int = 0 - int_max_value - 1

export let min_value: Int = int_min_value

fn int_is_negative(x: Int) -> Bool {
  x < 0
}

export fn is_negative(x: Int) -> Bool {
  int_is_negative(x)
}

fn int_is_positive(x: Int) -> Bool {
  x > 0
}

export fn is_positive(x: Int) -> Bool {
  int_is_positive(x)
}

/// The position (0-based, from the least significant bit) of the `k`-th set
/// bit of `x`, or -1 when `x` has fewer than `k + 1` set bits. `k` is 0-based,
/// so `Int::select1(x, 0)` is the lowest set bit -- the same index `Int::ctz`
/// returns for a non-zero `x`.
///
/// #2344: written on top of `Int::ctz` rather than as a builtin because wasm
/// has no select instruction to lower to. `v & (v - 1)` clears the lowest set
/// bit, so this runs in one step per set bit below the answer, not per bit
/// position. `x` is the 63-bit two's complement value, so a negative `x` has
/// bit 62 set and `Int::select1(-1, 62)` is 62.
export fn Int::select1(x: Int, k: Int) -> Int {
  if k < 0 {
    0 - 1
  } else {
    let mut v = x
    let mut remaining = k
    let mut found = 0 - 1
    while found < 0 && v != 0 {
      if remaining == 0 {
        found = Int::ctz(v)
      } else {
        remaining = remaining - 1
        v = v&(v - 1)
      }
    }
    found
  }
}

export fn Int::abs(x: Int) -> Int {
  if x == int_min_value {
    int_max_value
  }
  else if x < 0 {
    0 - x
  }
  else x
}

export fn abs(x: Int) -> Int {
  Int::abs(x)
}

fn int_gcd(a: Int, b: Int) -> Int {
  let abs_a = Int::abs(a)
  let abs_b = Int::abs(b)
  if abs_b == 0 {
    abs_a
  }
  else int_gcd(abs_b, abs_a % abs_b)
}

export fn gcd(a: Int, b: Int) -> Int {
  int_gcd(a, b)
}

fn int_lcm(a: Int, b: Int) -> Int {
  if a == 0 || b == 0 {
    0
  }
  else {
    let g = int_gcd(a, b)
    let scaled = a / g
    Int::abs(scaled * b)
  }
}

export fn lcm(a: Int, b: Int) -> Int {
  int_lcm(a, b)
}

export fn Int::gcd(a: Int, b: Int) -> Int {
  int_gcd(a, b)
}

export fn Int::lcm(a: Int, b: Int) -> Int {
  int_lcm(a, b)
}

export fn Int::max(a: Int, b: Int) -> Int {
  if a > b {
    a
  } else b
}

export fn max(a: Int, b: Int) -> Int {
  Int::max(a, b)
}

export fn Int::min(a: Int, b: Int) -> Int {
  if a < b {
    a
  } else b
}

export fn min(a: Int, b: Int) -> Int {
  Int::min(a, b)
}

export fn Int::pow(base: Int, exp: Int) -> Int {
  int_pow(base, exp)
}

export fn Int::clamp(x: Int, min_val: Int, max_val: Int) -> Int {
  if x < min_val {
    min_val
  }
  else if x > max_val {
    max_val
  }
  else x
}

export fn clamp(x: Int, min_val: Int, max_val: Int) -> Int {
  Int::clamp(x, min_val, max_val)
}

export fn Int::is_odd(x: Int) -> Bool {
  x % 2 != 0
}

export fn is_odd(x: Int) -> Bool {
  Int::is_odd(x)
}

export fn Int::signum(x: Int) -> Int {
  if x < 0 {
    -1
  }
  else if x > 0 {
    1
  }
  else 0
}

export fn signum(x: Int) -> Int {
  Int::signum(x)
}

export fn Int::is_even(x: Int) -> Bool {
  x % 2 == 0
}

export fn is_even(x: Int) -> Bool {
  Int::is_even(x)
}

export fn Int::is_zero(x: Int) -> Bool {
  int_is_zero(x)
}

export fn Int::factorial(n: Int) -> Int {
  int_factorial(n)
}

export fn Int::fibonacci(n: Int) -> Int {
  int_fibonacci(n)
}

export fn Int::is_negative(x: Int) -> Bool {
  int_is_negative(x)
}

export fn Int::is_positive(x: Int) -> Bool {
  int_is_positive(x)
}
