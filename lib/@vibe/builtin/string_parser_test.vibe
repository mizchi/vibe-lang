//# Imports

import ./string_parser.vibe {
  Parser::map, and_then, char, digit, digits1, identifier, kw, literal, or_else, pure, run, spaces0, token, uint
}

//# Misc

test "string_parser: char and literal" {
  match run(parser = char("a"), input = "a") {
    Some(v) => assert(v == "a"),
    _ => assert(false)
  }
  match run(parser = char("a"), input = "ab") {
    Some(_) => assert(false),
    _ => assert(true)
  }
  match run(parser = literal("let"), input = "let") {
    Some(v) => assert(v == "let"),
    _ => assert(false)
  }
  match run(parser = literal("let"), input = "lex") {
    Some(_) => assert(false),
    _ => assert(true)
  }
}

test "string_parser: map and pure" {
  let p = Parser::map(parser = char("7"), f = (_: String) -> Int {
    7
  })
  match run(parser = p, input = "7") {
    Some(v) => assert(eq(v, 7)),
    _ => assert(false)
  }
  let p2 = and_then(parser = pure("x"), f = (v: String) -> {
    pure("\{v}y")
  })
  match run(parser = p2, input = "") {
    Some(v) => {
      assert(eq(String::length(v), 2))
      assert(v == "xy")
    },
    _ => assert(false)
  }
}

test "string_parser: or_else" {
  let ab = or_else(left = char("a"), right = char("b"))
  match run(parser = ab, input = "b") {
    Some(v) => assert(v == "b"),
    _ => assert(false)
  }
  match run(parser = or_else(left = char("a"), right = char("b")), input = "c") {
    Some(_) => assert(false),
    _ => assert(true)
  }
}

test "string_parser: digit and uint" {
  match run(parser = digit, input = "9") {
    Some(v) => assert(v == "9"),
    _ => assert(false)
  }
  match run(parser = digits1, input = "12345") {
    Some(v) => assert(v == "12345"),
    _ => assert(false)
  }
  match run(parser = uint, input = "12345") {
    Some(v) => assert(eq(v, 12345)),
    _ => assert(false)
  }
  match run(parser = uint, input = "x99") {
    Some(_) => assert(false),
    _ => assert(true)
  }
}

test "string_parser: token and spaces" {
  match run(parser = spaces0, input = "   \n") {
    Some(v) => assert(v == "   \n"),
    _ => assert(false)
  }
  match run(parser = token(uint), input = "  42\n") {
    Some(v) => assert(eq(v, 42)),
    _ => assert(false)
  }
}

test "string_parser: identifier and let-binding parser" {
  match run(parser = identifier, input = "foo_123") {
    Some(v) => assert(v == "foo_123"),
    _ => assert(false)
  }
  let parse_let_binding = and_then(parser = kw("let"), f = (_kw: String) -> {
    and_then(parser = token(identifier), f = (name: String) -> {
      and_then(parser = token(char("=")), f = (_eq: String) -> {
        Parser::map(parser = token(uint), f = (value: Int) -> String {
          let _ = value
          name
        })
      })
    })
  })
  match run(parser = parse_let_binding, input = "let foo = 42") {
    Some(v) => {
      assert(eq(String::length(v), 3))
      assert(v == "foo")
    },
    _ => assert(false)
  }
  match run(parser = parse_let_binding, input = "let 123 = 9") {
    Some(_) => assert(false),
    _ => assert(true)
  }
}
