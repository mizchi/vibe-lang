//# Imports

import ./int.vibe {
  Int,
  abs,
  clamp,
  factorial,
  fibonacci,
  gcd,
  is_even,
  is_negative,
  is_odd,
  is_positive,
  is_zero,
  lcm,
  max,
  max_value,
  min,
  min_value,
  pow,
  signum
}

//# Functions

let int_gcd = gcd

let int_lcm = lcm

let int_pow = pow

let int_is_zero = is_zero

let int_factorial = factorial

let int_fibonacci = fibonacci

let int_max_value = max_value

let int_min_value = min_value

let int_is_negative = is_negative

let int_is_positive = is_positive

//# Misc

test "Int::abs" {
  assert(eq(Int::abs(5), 5))
  assert(eq(Int::abs(-5), 5))
  assert(eq(Int::abs(0), 0))
  assert(eq(Int::abs(int_min_value), int_max_value))
}

test "int_max_min" {
  assert(eq(Int::max(3, 7), 7))
  assert(eq(Int::max(-1, -5), -1))
  assert(eq(Int::min(3, 7), 3))
  assert(eq(Int::min(-1, -5), -5))
}

test "Int::clamp" {
  assert(eq(Int::clamp(5, 0, 10), 5))
  assert(eq(Int::clamp(-5, 0, 10), 0))
  assert(eq(Int::clamp(15, 0, 10), 10))
}

test "Int::signum" {
  assert(eq(Int::signum(100), 1))
  assert(eq(Int::signum(-100), -1))
  assert(eq(Int::signum(0), 0))
}

test "int_is_even_odd" {
  assert(Int::is_even(4))
  assert(not(Int::is_even(5)))
  assert(Int::is_odd(5))
  assert(not(Int::is_odd(4)))
}

test "int_is_positive_negative_zero" {
  assert(int_is_positive(5))
  assert(not(int_is_positive(-5)))
  assert(int_is_negative(-5))
  assert(not(int_is_negative(5)))
  assert(int_is_zero(0))
  assert(not(int_is_zero(1)))
}

test "int_pow" {
  assert(eq(int_pow(2, 0), 1))
  assert(eq(int_pow(2, 1), 2))
  assert(eq(int_pow(2, 10), 1024))
  assert(eq(int_pow(3, 4), 81))
}

test "int_gcd" {
  assert(eq(int_gcd(12, 18), 6))
  assert(eq(int_gcd(17, 13), 1))
  assert(eq(int_gcd(100, 25), 25))
  assert(eq(int_gcd(-12, 18), 6))
}

test "int_lcm" {
  assert(eq(int_lcm(4, 6), 12))
  assert(eq(int_lcm(3, 5), 15))
  assert(eq(int_lcm(0, 5), 0))
  assert(eq(int_lcm(268435456, 2), 268435456))
}

test "int_factorial" {
  assert(eq(int_factorial(0), 1))
  assert(eq(int_factorial(1), 1))
  assert(eq(int_factorial(5), 120))
  assert(eq(int_factorial(10), 3628800))
}

test "int_fibonacci" {
  assert(eq(int_fibonacci(0), 0))
  assert(eq(int_fibonacci(1), 1))
  assert(eq(int_fibonacci(10), 55))
  assert(eq(int_fibonacci(15), 610))
}

test "int_short_aliases" {
  assert(eq(abs(-3), 3))
  assert(eq(clamp(99, 0, 8), 8))
  assert(is_even(10))
  assert(eq(pow(2, 8), 256))
}

test "int_type_members" {
  assert(eq(Int::abs(-3), 3))
  assert(eq(Int::pow(2, 8), 256))
  assert(Int::is_even(10))
  assert(eq(Int::gcd(12, 18), 6))
}

test "int_type_member_to_double" {
  let v = 7
  let d = Int::to_double(v)
  assert(eq(Double::to_int(d), 7))
}

test "int_parse" {
  assert(eq(match Int::parse("42") {
    Some(v) => v,
    None => -1
  }, 42))
  assert(eq(match Int::parse("-7") {
    Some(v) => v,
    None => 0
  }, -7))
  assert(eq(match Int::parse("0") {
    Some(v) => v,
    None => -1
  }, 0))
  assert(Int::parse("") is None)
  assert(Int::parse("-") is None)
  assert(Int::parse("12x") is None)
  assert(Int::parse("x12") is None)
  assert(Int::parse(" 1") is None)
  // max_value parses; max_value+1 overflows to None (#1877: the Int range
  // is 63-bit, max = 2^62-1; seed-safe spelling, see prelude/int.vibe)
  assert(eq(match Int::parse("2305843009213693951") {
    Some(v) => v,
    None => -1
  }, 2305843009213693951))
  assert(eq(match Int::parse("4611686018427387903") {
    Some(v) => v,
    None => -1
  }, (2305843009213693951<<1)|1))
  assert(Int::parse("4611686018427387904") is None)
}

// #2344: the scalar bit primitives. `Int` is a 63-bit two's complement value,
// NOT an i64, so the answers below are 63-bit answers: popcount(-1) is 63 and
// not 64, and the largest positive Int (2^62-1) has bits 0..61 set, so its
// popcount is 62 and its clz is 1.
test "Int::popcount" {
  assert(eq(Int::popcount(0), 0))
  assert(eq(Int::popcount(1), 1))
  assert(eq(Int::popcount(2), 1))
  assert(eq(Int::popcount(3), 2))
  assert(eq(Int::popcount(255), 8))
  assert(eq(Int::popcount(1023), 10))
  // negative inputs are where a bare i64.popcnt would answer one too many
  assert(eq(Int::popcount(0 - 1), 63))
  assert(eq(Int::popcount(0 - 2), 62))
  assert(eq(Int::popcount(4611686018427387903), 62))
}

test "Int::ctz" {
  assert(eq(Int::ctz(1), 0))
  assert(eq(Int::ctz(2), 1))
  assert(eq(Int::ctz(8), 3))
  assert(eq(Int::ctz(96), 5))
  assert(eq(Int::ctz(0 - 1), 0))
  assert(eq(Int::ctz(0 - 2), 1))
  // wasm answers 64 for zero, which is outside the 63-bit width
  assert(eq(Int::ctz(0), 63))
}

test "Int::clz" {
  assert(eq(Int::clz(1), 62))
  assert(eq(Int::clz(2), 61))
  assert(eq(Int::clz(3), 61))
  assert(eq(Int::clz(4), 60))
  assert(eq(Int::clz(4611686018427387903), 1))
  // only a negative value has bit 62 set
  assert(eq(Int::clz(0 - 1), 0))
  assert(eq(Int::clz(0), 63))
}

test "Int::select1" {
  // 0b1010: set bits at 1 and 3
  assert(eq(Int::select1(10, 0), 1))
  assert(eq(Int::select1(10, 1), 3))
  assert(eq(Int::select1(10, 2), 0 - 1))
  assert(eq(Int::select1(1, 0), 0))
  assert(eq(Int::select1(0, 0), 0 - 1))
  assert(eq(Int::select1(255, 7), 7))
  assert(eq(Int::select1(255, 8), 0 - 1))
  // k = 0 agrees with ctz for every non-zero input
  assert(eq(Int::select1(96, 0), Int::ctz(96)))
  // negative: bit 62 is the highest set bit of -1
  assert(eq(Int::select1(0 - 1, 62), 62))
  assert(eq(Int::select1(0 - 1, 63), 0 - 1))
  assert(eq(Int::select1(10, 0 - 1), 0 - 1))
}
