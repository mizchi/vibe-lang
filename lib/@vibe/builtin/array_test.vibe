//# Imports

import ./array.vibe {
  Array::map, all, any, append, filter, find, flatmap, fold, get, head, is_empty, iter, last, length, reverse, slice, zip
}

//# Misc

test "array_basic_access" {
  assert(eq(length([1, 2, 3]), 3))
  assert(is_empty([]))
  assert(not(is_empty([1])))
  match get([10, 20], index = 1) {
    Some(v) => assert(eq(v, 20)),
    _ => assert(false)
  }
  match get([10, 20], index = 2) {
    None => assert(true),
    _ => assert(false)
  }
  match head([5, 6]) {
    Some(v) => assert(eq(v, 5)),
    _ => assert(false)
  }
  match last([5, 6]) {
    Some(v) => assert(eq(v, 6)),
    _ => assert(false)
  }
}

test "array_transform" {
  assert(eq(Array::length(append(xs = [1, 2], ys = [3])), 3))
  assert(eq(Array::length(slice(xs = [0, 1, 2, 3], start = 1, end = 3)), 2))
  let reversed = reverse([1, 2, 3])
  assert(eq(Array::get(reversed, at = 0), 3))
  assert(eq(Array::get(reversed, at = 2), 1))
  let doubled = Array::map([1, 2, 3], f = (x: Int) -> Int {
    x * 2
  })
  assert(eq(Array::get(doubled, at = 0), 2))
  assert(eq(Array::get(doubled, at = 2), 6))
  let is_even_flags = Array::map([1, 2, 3, 4], f = (x: Int) -> Bool {
    x % 2 == 0
  })
  assert(not(Array::get(is_even_flags, at = 0)))
  assert(Array::get(is_even_flags, at = 1))
  assert(not(Array::get(is_even_flags, at = 2)))
  assert(Array::get(is_even_flags, at = 3))
  let evens = filter([1, 2, 3, 4], pred = (x: Int) -> Bool {
    x % 2 == 0
  })
  assert(eq(Array::length(evens), 2))
  assert(eq(Array::get(evens, at = 0), 2))
  assert(eq(Array::get(evens, at = 1), 4))
}

test "array_fold_find_predicates" {
  let sum = fold([1, 2, 3, 4], init = 0, f = (acc: Int, x: Int) -> Int {
    acc + x
  })
  assert(eq(sum, 10))
  match find(xs = [3, 7, 9], pred = (x: Int) -> Bool {
    x > 5
  }) {
    Some(v) => assert(eq(v, 7)),
    _ => assert(false)
  }
  match find(xs = [1, 2], pred = (x: Int) -> Bool {
    x > 5
  }) {
    None => assert(true),
    _ => assert(false)
  }
  assert(any(xs = [1, 2, 8], pred = (x: Int) -> Bool {
    x > 5
  }))
  assert(not(any(xs = [1, 2, 3], pred = (x: Int) -> Bool {
    x > 5
  })))
  assert(all(xs = [2, 4, 6], pred = (x: Int) -> Bool {
    x % 2 == 0
  }))
  assert(not(all(xs = [2, 3, 6], pred = (x: Int) -> Bool {
    x % 2 == 0
  })))
}

test "array_iter_zip_flatmap" {
  let threshold = 0
  let iter_count = iter(xs = [1, 2, 3], f = (x: Int) -> Bool {
    x > threshold
  })
  assert(eq(iter_count, 3))
  let paired = zip(xs = ["a", "b", "c"], ys = [10, 20])
  assert(eq(Array::length(paired), 2))
  match Array::get(paired, at = 0) {
    ("a", 10) => assert(true),
    _ => assert(false)
  }
  match Array::get(paired, at = 1) {
    ("b", 20) => assert(true),
    _ => assert(false)
  }
  let duplicated = flatmap(xs = [1, 3], f = (x: Int) -> Array[Int] {
    [x, x + 1]
  })
  assert(eq(Array::length(duplicated), 4))
  assert(eq(Array::get(duplicated, at = 0), 1))
  assert(eq(Array::get(duplicated, at = 1), 2))
  assert(eq(Array::get(duplicated, at = 2), 3))
  assert(eq(Array::get(duplicated, at = 3), 4))
}

test "array_function_and_method_style_parity" {
  let xs = [1, 2, 3]
  assert(eq(length(xs), xs |> length))
  assert(is_empty(xs) == (xs |> is_empty))
  match (get(xs, index = 1), xs |> get(index = 1)) {
    (Some(a), Some(b)) => assert(eq(a, b)),
    _ => assert(false)
  }
  match (head(xs), xs |> head) {
    (Some(a), Some(b)) => assert(eq(a, b)),
    _ => assert(false)
  }
  match (last(xs), xs |> last) {
    (Some(a), Some(b)) => assert(eq(a, b)),
    _ => assert(false)
  }
  let doubled_fn = Array::map(xs, f = (x: Int) -> Int {
    x * 2
  })
  let doubled_method = xs |> Array::map(f = (x: Int) -> Int {
    x * 2
  })
  assert(eq(Array::length(doubled_fn), Array::length(doubled_method)))
  assert(eq(Array::get(doubled_fn, at = 0), Array::get(doubled_method, at = 0)))
  assert(eq(Array::get(doubled_fn, at = 2), Array::get(doubled_method, at = 2)))
  let filtered_fn = filter(xs, pred = (x: Int) -> Bool {
    x >= 2
  })
  let filtered_method = xs |> filter(pred = (x: Int) -> Bool {
    x >= 2
  })
  assert(eq(Array::length(filtered_fn), Array::length(filtered_method)))
  assert(eq(Array::get(filtered_fn, at = 0), Array::get(filtered_method, at = 0)))
  assert(eq(Array::get(filtered_fn, at = 1), Array::get(filtered_method, at = 1)))
  assert(eq(fold(xs, init = 0, f = (acc: Int, x: Int) -> Int {
    acc + x
  }), xs |> fold(init = 0, f = (acc: Int, x: Int) -> Int {
    acc + x
  })))
}
