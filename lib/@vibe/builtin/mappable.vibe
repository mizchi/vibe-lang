/// A constructor whose values can be transformed without changing its shape.
export trait Mappable[F[_]] {
  map[A, B](F[A], (A) -> B) -> F[B]
}

impl Mappable[Array] for Array {
  map(xs: Array[A], f: (A) -> B) -> Array[B] {
    Array::map(xs, f)
  }
}

impl Mappable[Option] for Option {
  map(xs: Option[A], f: (A) -> B) -> Option[B] {
    match xs {
      Some(value) => Some(f(value)),
      None => None
    }
  }
}
