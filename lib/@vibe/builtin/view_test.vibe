//# Imports

import ./string_view.vibe {
  from_array, from_array_range, from_string, from_string_range, struct ArrayView, struct StringView
}

//# Misc

test "StringView basic range and methods" {
  let v = from_string_range(source = "hello", start = 1, end = 4)
  assert(StringView::to_string(v) == "ell")
  assert(StringView::length(v) == 3)
  assert(StringView::start_offset(v) == 1)
  assert(not(StringView::is_empty(v)))
}

test "StringView clamps and subview" {
  let v = from_string_range(source = "hello", start = -10, end = 99)
  assert(StringView::to_string(v) == "hello")
  let sub = StringView::view(v, start = 1, end = 4)
  assert(StringView::to_string(sub) == "ell")
  assert(StringView::start_offset(sub) == 1)
}

test "StringView get" {
  let v = from_string("hello")
  match StringView::get(v, index = 0) {
    Some(ch) => assert(ch == "h"),
    _ => assert(false)
  }
  match StringView::get(v, index = 10) {
    Some(_) => assert(false),
    _ => assert(true)
  }
}

test "ArrayView basic range and methods" {
  let xs = [10, 20, 30, 40]
  let v = from_array_range(source = xs, start = 1, end = 3)
  assert(ArrayView::length(v) == 2)
  assert(ArrayView::start_offset(v) == 1)
  assert(not(ArrayView::is_empty(v)))
  let ys = ArrayView::to_array(v)
  assert(Array::length(ys) == 2)
  assert(Array::get(ys, at = 0) == 20)
  assert(Array::get(ys, at = 1) == 30)
}

test "ArrayView get and subview" {
  let xs = [10, 20, 30, 40]
  let v = ArrayView::view(from_array(xs), start = 1, end = 4)
  match ArrayView::get(v, index = 1) {
    Some(value) => assert(value == 30),
    _ => assert(false)
  }
  match ArrayView::get(v, index = 10) {
    Some(_) => assert(false),
    _ => assert(true)
  }
}

test "ArrayView empty view" {
  let xs = [1, 2, 3]
  let v = from_array_range(source = xs, start = 10, end = 20)
  assert(ArrayView::is_empty(v))
  assert(ArrayView::length(v) == 0)
}

test "StringView contains" {
  let v = from_string("hello world")
  assert(StringView::contains(v, needle = "world"))
  assert(StringView::contains(v, needle = "hello"))
  assert(not(StringView::contains(v, needle = "xyz")))
  assert(StringView::contains(v, needle = ""))
}

test "StringView has_prefix and has_suffix" {
  let v = from_string("hello world")
  assert(StringView::has_prefix(v, prefix = "hello"))
  assert(not(StringView::has_prefix(v, prefix = "world")))
  assert(StringView::has_suffix(v, suffix = "world"))
  assert(not(StringView::has_suffix(v, suffix = "hello")))
}

test "StringView index_of" {
  let v = from_string("hello world")
  assert(eq(StringView::index_of(v, needle = "world"), 6))
  assert(eq(StringView::index_of(v, needle = "hello"), 0))
  assert(eq(StringView::index_of(v, needle = "xyz"), 0 - 1))
}

test "StringView char_code_at" {
  let v = from_string("hello")
  assert(eq(StringView::char_code_at(v, index = 0), 104))
}
