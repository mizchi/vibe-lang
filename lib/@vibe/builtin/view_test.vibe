//# Imports

import ./string_view.vibe {
  ArrayView::get,
  ArrayView::is_empty,
  ArrayView::length,
  ArrayView::start_offset,
  ArrayView::to_array,
  ArrayView::view,
  StringView::char_code_at,
  StringView::contains,
  StringView::get,
  StringView::has_prefix,
  StringView::has_suffix,
  StringView::index_of,
  StringView::is_empty,
  StringView::length,
  StringView::start_offset,
  StringView::to_string,
  StringView::view,
  from_array,
  from_array_range,
  from_string,
  from_string_range,
  struct ArrayView,
  struct StringView
}

//# Misc

test "StringView basic range and methods" {
  let v = from_string_range("hello", 1, 4)
  assert(StringView::to_string(v) == "ell")
  assert(StringView::length(v) == 3)
  assert(StringView::start_offset(v) == 1)
  assert(not(StringView::is_empty(v)))
}

test "StringView clamps and subview" {
  let v = from_string_range("hello", -10, 99)
  assert(StringView::to_string(v) == "hello")
  let sub = StringView::view(v, 1, 4)
  assert(StringView::to_string(sub) == "ell")
  assert(StringView::start_offset(sub) == 1)
}

test "StringView get" {
  let v = from_string("hello")
  match StringView::get(v, 0) {
    Some(ch) => assert(ch == "h"),
    _ => assert(false)
  }
  match StringView::get(v, 10) {
    Some(_) => assert(false),
    _ => assert(true)
  }
}

test "ArrayView basic range and methods" {
  let xs = [10, 20, 30, 40]
  let v = from_array_range(xs, 1, 3)
  assert(ArrayView::length(v) == 2)
  assert(ArrayView::start_offset(v) == 1)
  assert(not(ArrayView::is_empty(v)))
  let ys = ArrayView::to_array(v)
  assert(Array::length(ys) == 2)
  assert(Array::get(ys, 0) == 20)
  assert(Array::get(ys, 1) == 30)
}

test "ArrayView get and subview" {
  let xs = [10, 20, 30, 40]
  let v = ArrayView::view(from_array(xs), 1, 4)
  match ArrayView::get(v, 1) {
    Some(value) => assert(value == 30),
    _ => assert(false)
  }
  match ArrayView::get(v, 10) {
    Some(_) => assert(false),
    _ => assert(true)
  }
}

test "ArrayView empty view" {
  let xs = [1, 2, 3]
  let v = from_array_range(xs, 10, 20)
  assert(ArrayView::is_empty(v))
  assert(ArrayView::length(v) == 0)
}

test "StringView contains" {
  let v = from_string("hello world")
  assert(StringView::contains(v, "world"))
  assert(StringView::contains(v, "hello"))
  assert(not(StringView::contains(v, "xyz")))
  assert(StringView::contains(v, ""))
}

test "StringView has_prefix and has_suffix" {
  let v = from_string("hello world")
  assert(StringView::has_prefix(v, "hello"))
  assert(not(StringView::has_prefix(v, "world")))
  assert(StringView::has_suffix(v, "world"))
  assert(not(StringView::has_suffix(v, "hello")))
}

test "StringView index_of" {
  let v = from_string("hello world")
  assert(eq(StringView::index_of(v, "world"), 6))
  assert(eq(StringView::index_of(v, "hello"), 0))
  assert(eq(StringView::index_of(v, "xyz"), 0 - 1))
}

test "StringView char_code_at" {
  let v = from_string("hello")
  assert(eq(StringView::char_code_at(v, 0), 104))
}
