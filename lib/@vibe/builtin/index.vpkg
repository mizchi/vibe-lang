// nothing else) is kept as the sole bare owner and these stay declared only
// as `Float::name` below; the plain-named `.vibe` def is still legal (name-
// covered by Int's same-named bare decl) but not part of THIS package's
// external bare-name surface. See header comment.
let eq: (Float32, Float32) -> Bool
let lerp: (Float32, Float32, Float32) -> Float32
let is_nan: (Float32) -> Bool
let square: (Float32) -> Float32
fn Float32::eq(_ a: Float32, b: Float32) -> Bool
