// --- char. to_int/from_int (also bare-exported by bool.vibe, for Bool) and
// to_string (also bare-exported by builtin_traits.vibe, generic [T: Show])
// and from_string (also bare-exported by string_view.vibe, returning
// StringView) collide; char.vibe has no `Char::` qualified alternative for
// any of them (unlike Int/Float/Double/Bool), so under the OLD facade none
// of these four char.vibe conversions were EVER externally reachable at
// all (the old facade's char.vibe block only ever listed the is_ascii*/
// to_ascii* predicates) — that non-exposure is preserved as-is here.
fn is_ascii(_ ch: Char) -> Bool
fn is_ascii_digit(_ ch: Char) -> Bool
fn is_ascii_hexdigit(_ ch: Char) -> Bool
fn is_ascii_lowercase(_ ch: Char) -> Bool
fn is_ascii_uppercase(_ ch: Char) -> Bool
fn to_ascii_lowercase(_ ch: Char) -> Char
fn to_ascii_uppercase(_ ch: Char) -> Char
fn is_ascii_alphabetic(_ ch: Char) -> Bool
fn is_ascii_alnum(_ ch: Char) -> Bool
fn is_ascii_whitespace(_ ch: Char) -> Bool

// --- bytes. `get`/`length` are also bare-exported by array.vibe, which
// wins those two names (already in the OLD facade's bare array.vibe list);
// `equals` collides with option.vibe's `equals[T: Eq]` but neither side was
// ever in the OLD facade's bare list, and unlike Option (which keeps
// `Option::equals` below) Bytes has no qualified alternative at all, so
// Bytes keeps the bare `equals` name as its only route through the
// boundary.
fn equals(a: Bytes, b: Bytes) -> Bool
fn is_byte(_ value: Int) -> Bool
fn to_ascii(_ bytes: Bytes) -> Option[String]
fn clamp_byte(_ value: Int) -> Int
fn from_ascii(_ s: String) -> Option[Bytes]
fn from_hex(_ hex: String) -> Option[Bytes]
fn to_hex(_ bytes: Bytes) -> String

// --- cmp
fn minmax(a: Int, b: Int) -> (Int, Int)
fn maximum(a: Int, b: Int) -> Int
fn minimum(a: Int, b: Int) -> Int
fn minmax_by[T](a: T, b: T, compare: (x: T, y: T) -> Ordering) -> (T, T)
fn maximum_by[T](a: T, b: T, compare: (x: T, y: T) -> Ordering) -> T
fn minimum_by[T](a: T, b: T, compare: (x: T, y: T) -> Ordering) -> T
fn int_compare(a: Int, b: Int) -> Ordering
fn float_compare(a: Float32, b: Float32) -> Ordering
fn minmax_by_key[T, K](a: T, b: T, key: (x: T) -> K, compare_key: (x: K, y: K) -> Ordering) -> (T, T)
fn double_compare(a: Float64, b: Float64) -> Ordering
fn maximum_by_key[T, K](a: T, b: T, key: (x: T) -> K, compare_key: (x: K, y: K) -> Ordering) -> T
fn minimum_by_key[T, K](a: T, b: T, key: (x: T) -> K, compare_key: (x: K, y: K) -> Ordering) -> T
fn string_compare(a: String, b: String) -> Ordering

// --- ordering (#3042, ADR-0118): the result of every `compare`
fn Ordering::to_int(_ o: Ordering) -> Int
fn Ordering::reverse(_ o: Ordering) -> Ordering

// --- string_view
fn from_array_range[T](source: Array[T], start: Int, end: Int) -> ArrayView[T]
fn from_array[T](_ source: Array[T]) -> ArrayView[T]
fn from_string_range(source: String, start: Int, end: Int) -> StringView
fn from_string(_ source: String) -> StringView
fn ArrayView::data[T](_ view: ArrayView[T]) -> Array[T]
fn ArrayView::view[T](_ view: ArrayView[T], start: Int, end: Int) -> ArrayView[T]
fn StringView::data(_ view: StringView) -> String
fn StringView::view(_ view: StringView, start: Int, end: Int) -> StringView
fn ArrayView::length[T](_ view: ArrayView[T]) -> Int
fn ArrayView::get[T](_ view: ArrayView[T], index: Int) -> Option[T]
fn StringView::length(_ view: StringView) -> Int
fn StringView::get(_ view: StringView, index: Int) -> Option[String]
fn ArrayView::is_empty[T](_ view: ArrayView[T]) -> Bool
fn ArrayView::to_array[T](_ view: ArrayView[T]) -> Array[T]
fn StringView::contains(_ view: StringView, needle: String) -> Bool
fn StringView::index_of(_ view: StringView, needle: String) -> Int
fn StringView::is_empty(_ view: StringView) -> Bool
fn StringView::to_string(_ view: StringView) -> String
fn StringView::has_prefix(_ view: StringView, prefix: String) -> Bool
fn StringView::has_suffix(_ view: StringView, suffix: String) -> Bool
fn ArrayView::start_offset[T](_ view: ArrayView[T]) -> Int
fn StringView::char_code_at(_ view: StringView, index: Int) -> Int
fn StringView::start_offset(_ view: StringView) -> Int

// --- io: gone (#2102). This package holds the language's own helpers, and
// nothing here carries a row any more -- `Int::abs` and
// `tui_enter_alt_screen` were never neighbours.
//
// The stdio wrappers were DELETED rather than moved, because each duplicated
// a name @vibe/console already published, and `println` / `print` are
// compiler builtins on top of that:
//
//     stdout_write      ->  print       (builtin, or @vibe/console)
//     stdout_writeln    ->  println     (builtin, or @vibe/console)
//     stdin_read        ->  @vibe/console read
//     stdin_read_line   ->  @vibe/console read_line
//
// `ansi_escape`, the four `tui_*`, and `tap` / `tap_some` had no duplicate
// and moved to @vibe/console's tui.vibe.

// --- string_parser. `or_else` also collides with option.vibe's bare
// `or_else` (Option wins that name, see the option.vibe section comment
// above) — string_parser's own `or_else[T](Parser,Parser)->Parser` is not
// part of this package's bare-name surface (it never was under the OLD
// facade either). `and_then` stays declared bare here.
fn Parser::map[A, B](_ parser: Parser[A], f: (x: A) -> B) -> Parser[B]
fn run[T](parser: Parser[T], input: String) -> Option[T]
fn char(_ expected: String) -> Parser[String]
fn fail[T]() -> Parser[T]
fn pure[T](_ value: T) -> Parser[T]
fn literal(_ expected: String) -> Parser[String]
fn and_then[A, B](parser: Parser[A], f: (x: A) -> Parser[B]) -> Parser[B]
fn any_char(input: String, pos: Int) -> ParseResult[String]
fn satisfy(_ pred: (ch: String) -> Bool) -> Parser[String]
fn take_while(_ pred: (ch: String) -> Bool) -> Parser[String]
fn take_while1(_ pred: (ch: String) -> Bool) -> Parser[String]
fn spaces0(input: String, pos: Int) -> ParseResult[String]
fn token[T](_ parser: Parser[T]) -> Parser[T]
fn kw(_ name: String) -> Parser[String]
fn spaces1(input: String, pos: Int) -> ParseResult[String]
fn alpha(input: String, pos: Int) -> ParseResult[String]
fn digit(input: String, pos: Int) -> ParseResult[String]
fn digits1(input: String, pos: Int) -> ParseResult[String]
fn alnum(input: String, pos: Int) -> ParseResult[String]
fn identifier(input: String, pos: Int) -> ParseResult[String]
fn uint(input: String, pos: Int) -> ParseResult[Int]

// --- func
fn compose[A, B, C](f: (x: A) -> B, g: (y: B) -> C) -> (z: A) -> C
fn identity[A](_ x: A) -> A
fn flip[A, B, C](_ f: (a: A, b: B) -> C) -> (b: B, a: A) -> C

// --- iterator
fn Iterator::fold[T, C: Iterator[T], B](xs: C, init: B, f: (acc: B, x: T) -> B) -> B
fn Iterator::iter[T, C: Iterator[T], R](xs: C, f: (x: T) -> R) -> Int
fn Iterator::find[T, C: Iterator[T]](xs: C, pred: (x: T) -> Bool) -> Option[T]
fn Iterator::any[T, C: Iterator[T]](xs: C, pred: (x: T) -> Bool) -> Bool
fn Iterator::all[T, C: Iterator[T]](xs: C, pred: (x: T) -> Bool) -> Bool
fn Iterator::map[A, C: Iterator[A], B](xs: C, f: (x: A) -> B) -> Array[B]
fn Iterator::filter[T, C: Iterator[T]](xs: C, pred: (x: T) -> Bool) -> Array[T]
fn Iterator::flatmap[A, C: Iterator[A], B](xs: C, f: (x: A) -> Array[B]) -> Array[B]

// --- lazy_iter (its own Iterator[T] trait is method-bearing but never
// re-exported — see header comment; no contract entry)
fn lazy_iter_arr[T](_ xs: Array[T]) -> LazyIter[T]
fn lazy_iter_map[T, U](src: LazyIter[T], f: (x: T) -> U) -> LazyIter[U]
fn lazy_iter_filter[T](src: LazyIter[T], pred: (x: T) -> Bool) -> LazyIter[T]
fn lazy_iter_collect[T](_ src: LazyIter[T]) -> Array[T]
fn lazy_iter_fold[T, U](src: LazyIter[T], init: U, f: (acc: U, x: T) -> U) -> U
fn lazy_iter_count[T](_ src: LazyIter[T]) -> Int
fn lazy_iter_find[T](src: LazyIter[T], pred: (x: T) -> Bool) -> Option[T]
fn lazy_iter_any[T](src: LazyIter[T], pred: (x: T) -> Bool) -> Bool
fn lazy_iter_all[T](src: LazyIter[T], pred: (x: T) -> Bool) -> Bool
fn lazy_iter_take_while[T](src: LazyIter[T], pred: (x: T) -> Bool) -> LazyIter[T]
fn lazy_iter_take[T](src: LazyIter[T], n: Int) -> LazyIter[T]
fn lazy_iter_drop[T](src: LazyIter[T], n: Int) -> LazyIter[T]
fn lazy_iter_enumerate[T](_ src: LazyIter[T]) -> LazyIter[(Int, T)]
fn lazy_iter_zip[T, U](a: LazyIter[T], b: LazyIter[U]) -> LazyIter[(T, U)]
fn lazy_iter_flat_map[T, U](src: LazyIter[T], f: (x: T) -> Array[U]) -> LazyIter[U]

// --- async_iter (its own AsyncIterator[T] trait is method-bearing but
// never re-exported — see header comment; no contract entry. `Async` is
// the checker-builtin effect, no import needed)
fn Array::iter[T](_ xs: Array[T]) -> AsyncIter[T]
fn AsyncIter::empty[T]() -> AsyncIter[T]
fn AsyncIter::once[T](_ x: T) -> AsyncIter[T]
fn AsyncIter::map[T, U](_ src: AsyncIter[T], f: (x: T) -> U) -> AsyncIter[U]
fn AsyncIter::filter[T](_ src: AsyncIter[T], pred: (x: T) -> Bool) -> AsyncIter[T]
fn AsyncIter::take[T](_ src: AsyncIter[T], n: Int) -> AsyncIter[T]
fn AsyncIter::take_while[T](_ src: AsyncIter[T], pred: (x: T) -> Bool) -> AsyncIter[T]
fn AsyncIter::collect[T](_ src: AsyncIter[T]) -> Array[T] with Async
fn AsyncIter::fold[T, U](_ src: AsyncIter[T], init: U, f: (acc: U, x: T) -> U) -> U with Async
fn AsyncIter::count[T](_ src: AsyncIter[T]) -> Int with Async
fn AsyncIter::find[T](_ src: AsyncIter[T], pred: (x: T) -> Bool) -> Option[T] with Async
fn AsyncIter::any[T](_ src: AsyncIter[T], pred: (x: T) -> Bool) -> Bool with Async
fn AsyncIter::all[T](_ src: AsyncIter[T], pred: (x: T) -> Bool) -> Bool with Async
fn async_iter_arr[T](_ xs: Array[T]) -> AsyncIter[T]
fn async_iter_empty[T]() -> AsyncIter[T]
fn async_iter_once[T](_ x: T) -> AsyncIter[T]
fn async_iter_map[T, U](src: AsyncIter[T], f: (x: T) -> U) -> AsyncIter[U]
fn async_iter_filter[T](src: AsyncIter[T], pred: (x: T) -> Bool) -> AsyncIter[T]
fn async_iter_take[T](src: AsyncIter[T], n: Int) -> AsyncIter[T]
fn async_iter_take_while[T](src: AsyncIter[T], pred: (x: T) -> Bool) -> AsyncIter[T]
fn async_iter_collect[T](_ src: AsyncIter[T]) -> Array[T] with Async
fn async_iter_fold[T, U](src: AsyncIter[T], init: U, f: (acc: U, x: T) -> U) -> U with Async
fn async_iter_count[T](_ src: AsyncIter[T]) -> Int with Async
fn async_iter_find[T](src: AsyncIter[T], pred: (x: T) -> Bool) -> Option[T] with Async
fn async_iter_any[T](src: AsyncIter[T], pred: (x: T) -> Bool) -> Bool with Async
