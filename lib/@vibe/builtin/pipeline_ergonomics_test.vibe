//# Imports

// Runnable reference for the pipeline-ergonomics features documented in
// docs/cheatsheet.md ("Function combinators", "Railway bind", "Debugging a
// pipeline"). Co-located with the prelude it imports so `vibe test` can run it.
//
//   vibe test lib/@vibe/builtin/pipeline_ergonomics_test.vibe

import ./func.vibe {
  compose, flip, identity
}

import ./io.vibe {
  tap
}

//# Functions

fn double(x: Int) -> Int {
  x * 2
}

fn add1(x: Int) -> Int {
  x + 1
}

fn scale(factor: Int, x: Int) -> Int {
  x * factor
}

/// railway: each stage names its result; a `None` short-circuits the block.
/// #1324 made `Option` the only railway monad `let*` lowers to.
fn checked(n: Int) -> Option[Int] {
  let* positive = if n > 0 {
    Some(n)
  } else {
    None
  }
  let* small = if positive < 100 {
    Some(positive)
  } else {
    None
  }
  Some(small * 10)
}

//# Misc

test "pipe `_` placeholder: substitute at a non-first slot" {
  // 3 |> scale(10, _) == scale(10, 3); without `_` it would prepend.
  assert((3 |> scale(10, _)) == 30)
  assert((3 |> scale(10, _) |> scale(2, _)) == 60)
  assert((3 |> scale(10)) == 30)
  // no hole -> prepend (scale(3, 10))
}

test "function combinators: compose / identity / flip" {
  let inc_then_double = compose(add1, double)
  // double(add1(x))
  assert(inc_then_double(3) == 8)
  assert(identity(42) == 42)
  let sub: (Int, Int) -> Int = (a, b) -> a - b
  let flipped_sub = flip(sub)
  assert(flipped_sub(3, 10) == 7)
  // sub(10, 3)
}

test "railway bind: let* short-circuits on None" {
  match checked(5) {
    Some(v) => assert(v == 50)
    None => assert(false)
  }
  match checked(0) {
    Some(_) => assert(false)
    None => assert(true)
  }
  match checked(250) {
    Some(_) => assert(false)
    None => assert(true)
  }
}

test "tap: observe a stage without breaking the chain" {
  // tap returns its input unchanged (side effect omitted here).
  let result = 5 |> tap((_v) -> ()) |> double
  assert(result == 10)
}
