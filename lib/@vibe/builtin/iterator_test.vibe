//# Imports

import ./iterator.vibe {
  Array::flatmap, trait Iterator
}
/// A tiny local Iterator (prelude tests must not depend on lib packages;
/// @vibe/core's List has its own tests in lib/@vibe/core).
enum L3[T] {
  Mk(T, T, T)
}

impl [T] Iterator[T] for L3[T]

export fn L3::iter_length[T](_ xs: L3[T]) -> Int {
  3
}

export fn L3::iter_get[T](_ xs: L3[T], i: Int) -> T {
  match xs {
    Mk(a, b, c) => if i == 0 {
      a
    } else if i == 1 {
      b
    } else {
      c
    }
  }
}

fn list_of3[T](a: T, b: T, c: T) -> L3[T] {
  Mk(a, b, c)
}

//# Misc

enum Trio[T] {
  Trio(T, T, T)
}

impl [T] Iterator[T] for Trio[T]

fn trio_of3[T](a: T, b: T, c: T) -> Trio[T] {
  Trio(a, b, c)
}

let _iterator_test_trio_keep = trio_of3(a = 0, b = 1, c = 2)

fn Trio::iter_length[T](_ _xs: Trio[T]) -> Int {
  3
}

fn Trio::iter_get[T](_ xs: Trio[T], index: Int) -> T {
  match xs {
    Trio(a, b, c) => if index == 0 {
      a
    } else if index == 1 {
      b
    } else {
      c
    }
  }
}

test "iterator_fold_and_iter" {
  let xs = [1, 2, 3, 4]
  let total = Iterator::fold(xs, init = 0, f = (acc: Int, x: Int) -> Int {
    acc + x
  })
  assert(eq(total, 10))
  assert(eq(xs |> Iterator::fold(init = 0, f = (acc: Int, x: Int) -> Int {
    acc + x
  }), 10))
  let threshold = 0
  let count = Iterator::iter(xs = xs, f = (x: Int) -> Bool {
    x > threshold
  })
  assert(eq(count, 4))
}

test "iterator_find_and_predicates" {
  let xs = [3, 7, 9]
  match Iterator::find(xs = xs, pred = (x: Int) -> Bool {
    x > 5
  }) {
    Some(v) => assert(eq(v, 7)),
    _ => assert(false)
  }
  assert(Iterator::any(xs = xs, pred = (x: Int) -> Bool {
    x == 7
  }))
  assert(not(Iterator::all(xs = xs, pred = (x: Int) -> Bool {
    x > 5
  })))
  assert(Iterator::all(xs = [2, 4, 6], pred = (x: Int) -> Bool {
    x % 2 == 0
  }))
}

test "iterator_map_pipe_array" {
  let ys = [1, 2, 3] |> Iterator::map(f = (x: Int) -> Int {
    x + 1
  })
  assert(eq(Array::length(ys), 3))
  assert(eq(Array::get(ys, at = 0), 2))
  assert(eq(Array::get(ys, at = 2), 4))
}

test "iterator_transform" {
  let xs = [1, 2, 3]
  let doubled = Iterator::map(xs, f = (x: Int) -> Int {
    x * 2
  })
  assert(eq(Array::length(doubled), 3))
  assert(eq(Array::get(doubled, at = 0), 2))
  assert(eq(Array::get(doubled, at = 2), 6))
  let evens = Iterator::filter([1, 2, 3, 4], pred = (x: Int) -> Bool {
    x % 2 == 0
  })
  assert(eq(Array::length(evens), 2))
  assert(eq(Array::get(evens, at = 0), 2))
  assert(eq(Array::get(evens, at = 1), 4))
  let duplicated = Iterator::flatmap(xs = [1, 3], f = (x: Int) -> Array[Int] {
    [x, x + 1]
  })
  assert(eq(Array::length(duplicated), 4))
  assert(eq(Array::get(duplicated, at = 0), 1))
  assert(eq(Array::get(duplicated, at = 1), 2))
  assert(eq(Array::get(duplicated, at = 2), 3))
  assert(eq(Array::get(duplicated, at = 3), 4))
  let direct = Array::flatmap([1, 3], f = (x: Int) -> Array[Int] {
    [x, x + 1]
  })
  assert(eq(Array::length(direct), 4))
  assert(eq(Array::get(direct, at = 0), 1))
  assert(eq(Array::get(direct, at = 1), 2))
  assert(eq(Array::get(direct, at = 2), 3))
  assert(eq(Array::get(direct, at = 3), 4))
}

test "iterator_supports_string_iterable" {
  // ADR-0044 Phase 3: String implements Iterator. Iterator::* combinators
  // see each char as its Int char code (consistent with String for-in).
  let s = "abc"
  let total = Iterator::fold(s, init = 0, f = (acc: Int, c: Int) -> Int {
    acc + c
  })
  // 'a'=97, 'b'=98, 'c'=99 -> 294
  assert(eq(total, 294))
  assert(Iterator::any(xs = s, pred = (c: Int) -> Bool {
    c == 98
  }))
  assert(not(Iterator::all(xs = s, pred = (c: Int) -> Bool {
    c > 97
  })))
  match Iterator::find(xs = s, pred = (c: Int) -> Bool {
    c == 99
  }) {
    Some(v) => assert(eq(v, 99)),
    _ => assert(false)
  }
  let shifted_acc = ArrayBuilder::new()
  let mut si = 0
  while si < String::length(s) {
    ArrayBuilder::push(shifted_acc, value = String::char_code_at(s, at = si) + 1)
    si = si + 1
  }
  let shifted = ArrayBuilder::freeze(shifted_acc)
  assert(eq(Array::length(shifted), 3))
  assert(eq(Array::get(shifted, at = 0), 98))
  assert(eq(Array::get(shifted, at = 2), 100))
}

test "iterator_supports_map_iterable" {
  // ADR-0044 Phase 3: Map[K, V] implements Iterator, yielding K (key) per
  // iteration. Compiled backends lower Map iter helpers directly to key-slot
  // access, so Iterator::* over Map does not allocate Map::keys per element.
  let m = Map::from_pairs([("a", 1), ("b", 2), ("c", 3)])
  let total_keys = Iterator::fold(m, init = "", f = (acc: String, k: String) -> String {
    acc + k
  })
  // Iteration order matches insertion order for small linear-search maps.
  // Note: `eq` (from the prelude) is `(Num, Num) -> Bool` and rejects String
  // arguments; use `==` (which lowers to `String::equals` for strings).
  assert(total_keys == "abc")
  let total_vals = Iterator::fold(m, init = 0, f = (acc: Int, k: String) -> Int {
    acc + Map::get(m, key = k)
  })
  assert(eq(total_vals, 6))
  assert(Iterator::any(xs = m, pred = (k: String) -> Bool {
    k == "b"
  }))
}

test "iterator_supports_custom_iterable" {
  let xs = trio_of3(a = 2, b = 4, c = 6)
  assert(eq(Iterator::fold(xs, init = 0, f = (acc: Int, x: Int) -> Int {
    acc + x
  }), 12))
  assert(eq(Iterator::fold(list_of3(a = 1, b = 2, c = 3), init = 0, f = (acc: Int, x: Int) -> Int {
    acc + x
  }), 6))
  match Iterator::find(xs = xs, pred = (x: Int) -> Bool {
    x == 4
  }) {
    Some(v) => assert(eq(v, 4)),
    _ => assert(false)
  }
  let doubled = ArrayBuilder::freeze(Iterator::fold(xs, init = ArrayBuilder::new(), f = (acc: ArrayBuilder[Int], x: Int) -> ArrayBuilder[Int] {
    ArrayBuilder::push(acc, value = x * 2)
    acc
  }))
  assert(eq(Array::length(doubled), 3))
  assert(eq(Array::get(doubled, at = 0), 4))
  assert(eq(Array::get(doubled, at = 1), 8))
  assert(eq(Array::get(doubled, at = 2), 12))
}
