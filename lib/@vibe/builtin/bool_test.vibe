//# Imports

import ./bool.vibe {
  Bool, bool_all3, bool_any3, bool_implies, bool_nand, bool_nor, bool_to_int, bool_xor, int_to_bool, to_int, xor
}

//# Misc

test "bool_to_int" {
  assert(eq(bool_to_int(true), 1))
  assert(eq(bool_to_int(false), 0))
}

test "int_to_bool" {
  assert(int_to_bool(1))
  assert(int_to_bool(42))
  assert(int_to_bool(-1))
  assert(not(int_to_bool(0)))
}

test "bool_implies" {
  assert(bool_implies(a = false, b = false))
  assert(bool_implies(a = false, b = true))
  assert(not(bool_implies(a = true, b = false)))
  assert(bool_implies(a = true, b = true))
}

test "bool_xor" {
  assert(not(bool_xor(a = false, b = false)))
  assert(bool_xor(a = false, b = true))
  assert(bool_xor(a = true, b = false))
  assert(not(bool_xor(a = true, b = true)))
}

test "bool_nand" {
  assert(bool_nand(a = false, b = false))
  assert(bool_nand(a = false, b = true))
  assert(bool_nand(a = true, b = false))
  assert(not(bool_nand(a = true, b = true)))
}

test "bool_nor" {
  assert(bool_nor(a = false, b = false))
  assert(not(bool_nor(a = false, b = true)))
  assert(not(bool_nor(a = true, b = false)))
  assert(not(bool_nor(a = true, b = true)))
}

test "bool_all3" {
  assert(bool_all3(a = true, b = true, c = true))
  assert(not(bool_all3(a = true, b = true, c = false)))
  assert(not(bool_all3(a = false, b = false, c = false)))
}

test "bool_any3" {
  assert(bool_any3(a = true, b = false, c = false))
  assert(bool_any3(a = false, b = true, c = false))
  assert(not(bool_any3(a = false, b = false, c = false)))
}

test "bool_type_members_and_method_style" {
  let t = true
  assert(eq(Bool::to_int(true), 1))
  assert(not(int_to_bool(0)))
  assert(eq(t |> to_int, 1))
  assert(xor(a = t, b = false))
}
