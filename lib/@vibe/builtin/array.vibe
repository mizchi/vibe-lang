//# Functions

export fn all[T](xs: Array[T], pred: (x: T) -> Bool) -> Bool {
  let len = Array::length(xs)
  let rec r#loop = (i: Int) -> Bool {
    if i >= len {
      true
    } else if pred(Array::get(xs, i)) {
      r#loop(i + 1)
    } else false
  }
  r#loop(0)
}

export fn get[T](xs: Array[T], index: Int) -> Option[T] {
  if index < 0 || index >= Array::length(xs) {
    None
  } else Some(Array::get(xs, index))
}

export fn zip[A, B](xs: Array[A], ys: Array[B]) -> Array[(A, B)] {
  let len_x = Array::length(xs)
  let len_y = Array::length(ys)
  let len = if len_x < len_y {
    len_x
  } else len_y
  {
    let acc = ArrayBuilder::new()
    let rec r#loop = (i: Int) -> ArrayBuilder[(A, B)] {
      if i >= len {
        acc
      } else {
        ArrayBuilder::push(acc, (Array::get(xs, i), Array::get(ys, i)))
        r#loop(i + 1)
      }
    }
    ArrayBuilder::freeze(r#loop(0))
  }
}

export fn find[T](xs: Array[T], pred: (x: T) -> Bool) -> Option[T] {
  let len = Array::length(xs)
  let rec r#loop = (i: Int) -> Option[T] {
    if i >= len {
      None
    } else {
      let value = Array::get(xs, i)
      if pred(value) {
        Some(value)
      } else r#loop(i + 1)
    }
  }
  r#loop(0)
}

export fn any[T](xs: Array[T], pred: (x: T) -> Bool) -> Bool {
  find(xs, pred) is Some(_)
}

export fn fold[A, B](xs: Array[A], init: B, f: (acc: B, x: A) -> B) -> B {
  let len = Array::length(xs)
  let rec r#loop = (i: Int, acc: B) -> B {
    if i >= len {
      acc
    } else r#loop(i + 1, f(acc, Array::get(xs, i)))
  }
  r#loop(0, init)
}

export fn head[T](xs: Array[T]) -> Option[T] {
  get(xs, 0)
}

export fn iter[T, R](xs: Array[T], f: (x: T) -> R) -> Int {
  let len = Array::length(xs)
  let rec r#loop = (i: Int) -> Int {
    if i >= len {
      i
    } else {
      f(Array::get(xs, i))
      r#loop(i + 1)
    }
  }
  r#loop(0)
}

export fn last[T](xs: Array[T]) -> Option[T] {
  let len = Array::length(xs)
  if len == 0 {
    None
  } else Some(Array::get(xs, len - 1))
}

export fn slice[T](xs: Array[T], start: Int, end: Int) -> Array[T] {
  xs[start: end]
}

export fn append[T](xs: Array[T], ys: Array[T]) -> Array[T] {
  Array::concat(xs, ys)
}

export fn filter[T](xs: Array[T], pred: (x: T) -> Bool) -> Array[T] {
  let len = Array::length(xs)
  {
    let acc = ArrayBuilder::new()
    let rec r#loop = (i: Int) -> ArrayBuilder[T] {
      if i >= len {
        acc
      } else {
        let value = Array::get(xs, i)
        if pred(value) {
          {
            ArrayBuilder::push(acc, value)
            r#loop(i + 1)
          }
        } else r#loop(i + 1)
      }
    }
    ArrayBuilder::freeze(r#loop(0))
  }
}

export fn length[T](xs: Array[T]) -> Int {
  Array::length(xs)
}

export fn flatmap[A, B](xs: Array[A], f: (x: A) -> Array[B]) -> Array[B] {
  let len = Array::length(xs)
  {
    let acc = ArrayBuilder::new()
    let rec push_chunk = (chunk: Array[B], j: Int, chunk_len: Int) -> ArrayBuilder[B] {
      if j >= chunk_len {
        acc
      } else {
        ArrayBuilder::push(acc, Array::get(chunk, j))
        push_chunk(chunk, j + 1, chunk_len)
      }
    }
    let rec r#loop = (i: Int) -> ArrayBuilder[B] {
      if i >= len {
        acc
      } else {
        let chunk = f(Array::get(xs, i))
        {
          push_chunk(chunk, 0, Array::length(chunk))
          r#loop(i + 1)
        }
      }
    }
    ArrayBuilder::freeze(r#loop(0))
  }
}

export fn reverse[T](xs: Array[T]) -> Array[T] {
  let len = Array::length(xs)
  {
    let acc = ArrayBuilder::new()
    let rec r#loop = (i: Int) -> ArrayBuilder[T] {
      if i < 0 {
        acc
      } else {
        ArrayBuilder::push(acc, Array::get(xs, i))
        r#loop(i - 1)
      }
    }
    ArrayBuilder::freeze(r#loop(len - 1))
  }
}

export fn is_empty[T](xs: Array[T]) -> Bool {
  Array::length(xs) == 0
}

export let Array::map = [A, B](xs: Array[A], f: (x: A) -> B) -> Array[B] {
  let len = Array::length(xs)
  {
    let acc = ArrayBuilder::new()
    let rec r#loop = (i: Int) -> ArrayBuilder[B] {
      if i >= len {
        acc
      } else {
        ArrayBuilder::push(acc, f(Array::get(xs, i)))
        r#loop(i + 1)
      }
    }
    ArrayBuilder::freeze(r#loop(0))
  }
}
