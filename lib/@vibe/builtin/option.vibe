//# Types

// Option is compiler-provided, but this module explicitly publishes its
// declaration authority for sibling and package consumers.
export {
  Option
}

export trait Eq

impl Eq for Int

impl Eq for Float

impl Eq for Double

impl Eq for Bool

impl Eq for String

impl [T: Eq] Eq for Option[T]

//# Functions

export fn or[T](a: Option[T], b: Option[T]) -> Option[T] {
  match a {
    Some(_) => a,
    _ => b
  }
}

export fn and[A, B](a: Option[A], b: Option[B]) -> Option[B] {
  match a {
    Some(_) => b,
    _ => None
  }
}

export fn zip[A, B](a: Option[A], b: Option[B]) -> Option[(A, B)] {
  match (a, b) {
    (Some(x), Some(y)) => Some((x, y)),
    _ => None
  }
}

export fn equals[T: Eq](a: Option[T], b: Option[T]) -> Bool {
  match (a, b) {
    (Some(x), Some(y)) => x == y,
    (None, None) => true,
    _ => false
  }
}

export fn filter[T](opt: Option[T], pred: (x: T) -> Bool) -> Option[T] {
  match opt {
    Some(v) => if pred(v) {
      Some(v)
    } else None
    ,
    _ => None
  }
}

export fn map_or[A, B](opt: Option[A], default: B, f: (x: A) -> B) -> B {
  match opt {
    Some(v) => f(v),
    _ => default
  }
}

export fn flatmap[A, B](opt: Option[A], f: (x: A) -> Option[B]) -> Option[B] {
  match opt {
    Some(v) => f(v),
    _ => None
  }
}

export fn flatten[T](opt: Option[Option[T]]) -> Option[T] {
  match opt {
    Some(inner) => inner,
    _ => None
  }
}

export fn is_some[T](opt: Option[T]) -> Bool {
  opt is Some(_)
}

export fn is_none[T](opt: Option[T]) -> Bool {
  not(is_some(opt))
}

export fn map_opt[A, B](opt: Option[A], f: (x: A) -> B) -> Option[B] {
  match opt {
    Some(v) => Some(f(v)),
    _ => None
  }
}

export fn or_else[T](a: Option[T], fallback: () -> Option[T]) -> Option[T] {
  match a {
    Some(_) => a,
    _ => fallback()
  }
}

export fn zip_sum(a: Option[Int], b: Option[Int]) -> Option[Int] {
  match zip(a, b) {
    Some((x, y)) => Some(x + y),
    _ => None
  }
}

export fn unwrap_or[T](opt: Option[T], default: T) -> T {
  match opt {
    Some(v) => v,
    _ => default
  }
}

export fn unwrap_or_else[T](opt: Option[T], fallback: () -> T) -> T {
  match opt {
    Some(v) => v,
    _ => fallback()
  }
}

export fn Option::or[T](a: Option[T], b: Option[T]) -> Option[T] {
  or(a, b)
}

export fn Option::and[A, B](a: Option[A], b: Option[B]) -> Option[B] {
  and(a, b)
}

export fn Option::zip[A, B](a: Option[A], b: Option[B]) -> Option[(A, B)] {
  zip(a, b)
}

export fn Option::equals[T: Eq](a: Option[T], b: Option[T]) -> Bool {
  equals(a, b)
}

export fn Option::filter[T](opt: Option[T], pred: (x: T) -> Bool) -> Option[T] {
  filter(opt, pred)
}

export fn Option::map_or[A, B](opt: Option[A], default: B, f: (x: A) -> B) -> B {
  map_or(opt, default, f)
}

export fn Option::flatmap[A, B](opt: Option[A], f: (x: A) -> Option[B]) -> Option[B] {
  flatmap(opt, f)
}

export fn Option::flatten[T](opt: Option[Option[T]]) -> Option[T] {
  flatten(opt)
}

export fn Option::is_none[T](opt: Option[T]) -> Bool {
  is_none(opt)
}

export fn Option::is_some[T](opt: Option[T]) -> Bool {
  is_some(opt)
}

export fn Option::map_opt[A, B](opt: Option[A], f: (x: A) -> B) -> Option[B] {
  map_opt(opt, f)
}

export fn Option::or_else[T](a: Option[T], fallback: () -> Option[T]) -> Option[T] {
  or_else(a, fallback)
}

export fn Option::zip_sum(a: Option[Int], b: Option[Int]) -> Option[Int] {
  zip_sum(a, b)
}

export fn Option::unwrap_or[T](opt: Option[T], default: T) -> T {
  unwrap_or(opt, default)
}

export fn Option::unwrap_or_else[T](opt: Option[T], fallback: () -> T) -> T {
  unwrap_or_else(opt, fallback)
}
