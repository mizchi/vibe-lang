//# Imports

import @vibe/compiler/entry/cli_cache {
  compile_jobs_cached, parse_batch_jobs_tsv
}

import ./type_db.vibe {
  db_new
}

//# Functions

export fn main() -> Int with Error + Fs + Process + Env + Stdout + Stdin {
  let batch_tsv = perform Env::Get("VIBE_BATCH_TSV")
  let input_path = perform Env::Get("VIBE_INPUT")
  let output_path = perform Env::Get("VIBE_OUTPUT")
  let entry = perform Env::Get("VIBE_ENTRY")
  if not(batch_tsv == "") {
    let jobs = parse_batch_jobs_tsv(batch_tsv)
    let _ = compile_jobs_cached(db_new(), jobs)
    0
  }
  else if input_path == "" {
    1
  }
  else if output_path == "" {
    1
  }
  else {
    let _ = compile_jobs_cached(db_new(), [
      (input_path, output_path, entry)
    ])
    0
  }
}
