//# Imports

import ./syntax/lexer.vibe { lex }
import ./syntax/parser.vibe { parse_program }
import ./checker/checker_stmt.vibe { check_program }
import ./codegen/gc/backend_body.vibe { compile_wasi_module_gc }

//# Functions

fn read_arg(index: Int) -> String with { Env } {
  if perform Env::ArgsLen > index {
    perform Env::ArgsGet(index)
  } else {
    ""
  }
}

fn cli_main() -> Int with { Error, Fs, Env } {
  let input_path = read_arg(0)
  let output_path = read_arg(1)
  let entry_name = read_arg(2)
  if input_path == "" {
    1
  }
  else if output_path == "" {
    1
  }
  else if entry_name == "" {
    1
  }
  else {
    let source = perform Fs::ReadFile(input_path)
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _ = check_program(stmts)
    let bytes = compile_wasi_module_gc(stmts, entry_name)
    Fs::write_bytes(output_path, bytes)
    0
  }
}
