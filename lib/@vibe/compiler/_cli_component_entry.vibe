//# Imports

import @vibe/compiler/entry/source_compile {
  compile_source_wasi_mode
}

import @vibe/core {
  array_empty
}

//# Functions

fn find_colon(s: String, start: Int, end_: Int) -> Int {
  let mut out = -1
  let mut i = start
  while i < end_ && out == -1 {
    if String::char_code_at(s, i) == 58 {
      out = i
    } else {
      i = i + 1
    }
  }
  out
}

fn cache_key_for(source: String, entry_name: String, mode: String) -> String {
  String::concat(mode, String::concat("|", String::concat(entry_name, String::concat("|", source))))
}

fn parse_decimal_int(s: String, start: Int, end_: Int) -> Int with Error {
  let mut out = 0
  let mut i = start
  while i < end_ {
    let c = String::char_code_at(s, i)
    if c < 48 || c > 57 {
      throw("invalid int")
    } else {
      out = out * 10 + (c - 48)
      i = i + 1
    }
  }
  out
}

let cached_compile_key = array_empty()

fn cache_key_matches(cache_key: String) -> Bool {
  Array::length(cached_compile_key) > 0 && Array::get(cached_compile_key, 0) == cache_key
}

let cached_compile_len = array_empty()

let cached_compile_bytes = Bytes::new()

fn pack_cached_chunk(chunk_index: Int) -> Int {
  let start = chunk_index * 7
  let byte_len = Array::get(cached_compile_len, 0)
  let mut out = 0
  let mut shift = 0
  let mut k = 0
  while k < 7 && start + k < byte_len {
    out = out|(Bytes::get(cached_compile_bytes, start + k)<<shift)
    k = k + 1
    shift = shift + 8
  }
  out
}

fn remember_compiled_bytes(cache_key: String, bytes: Bytes) -> Int {
  let byte_len = Bytes::length(bytes)
  if Array::length(cached_compile_key) == 0 {
    Array::push(cached_compile_key, cache_key)
  } else {
    Array::set(cached_compile_key, 0, cache_key)
  }
  if Array::length(cached_compile_len) == 0 {
    Array::push(cached_compile_len, byte_len)
  } else {
    Array::set(cached_compile_len, 0, byte_len)
  }
  let mut i = 0
  while i < byte_len {
    let byte = Bytes::get(bytes, i)
    if i < Bytes::length(cached_compile_bytes) {
      Bytes::set(cached_compile_bytes, i, byte)
    } else {
      Bytes::push(cached_compile_bytes, byte)
    }
    i = i + 1
  }
  byte_len
}

fn ensure_compiled(source: String, entry_name: String, mode: String) -> Int with Error {
  let cache_key = cache_key_for(source, entry_name, mode)
  if cache_key_matches(cache_key) {
    Array::get(cached_compile_len, 0)
  } else {
    let bytes = compile_source_wasi_mode(source, entry_name, mode)
    remember_compiled_bytes(cache_key, bytes)
  }
}

export fn compile_cli_request(source: String, request: String) -> Int {
  handle {
    let request_len = String::length(request)
    if request == "probe:const" {
      1
    }
    else if request == "probe:compile-fixed-len" {
      ensure_compiled("let answer: () -> Int = () -> { 40 + 2 }", "answer", "mvp")
    }
    else if request_len >= 4 && request[0: 4] == "len:" {
      let entry_name = request[4: request_len]
      ensure_compiled(source, entry_name, "mvp")
    }
    else if request_len >= 9 && request[0: 9] == "len-mode:" {
      let sep = find_colon(request, 9, request_len)
      if sep == -1 {
        0
      } else {
        let mode = request[9: sep]
        let entry_name = request[sep + 1: request_len]
        ensure_compiled(source, entry_name, mode)
      }
    }
    else if request_len >= 6 && request[0: 6] == "chunk:" {
      let sep = find_colon(request, 6, request_len)
      if sep == -1 {
        0
      } else {
        let entry_name = request[6: sep]
        let chunk_index = parse_decimal_int(request, sep + 1, request_len)
        let _ = ensure_compiled(source, entry_name, "mvp")
        pack_cached_chunk(chunk_index)
      }
    }
    else if request_len >= 11 && request[0: 11] == "chunk-mode:" {
      let mode_sep = find_colon(request, 11, request_len)
      if mode_sep == -1 {
        0
      } else {
        let entry_sep = find_colon(request, mode_sep + 1, request_len)
        if entry_sep == -1 {
          0
        } else {
          let mode = request[11: mode_sep]
          let entry_name = request[mode_sep + 1: entry_sep]
          let chunk_index = parse_decimal_int(request, entry_sep + 1, request_len)
          let _ = ensure_compiled(source, entry_name, mode)
          pack_cached_chunk(chunk_index)
        }
      }
    }
    else {
      0
    }
  } with Error {
    Throw(_) => -1
  }
}
