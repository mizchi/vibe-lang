//# Imports

import ./codegen {
  compile_wasi_module
}

import ./syntax {
  lex
}

import ./parser.vibe {
  parse_program
}

//# Misc

test "wasi: tuple destr then ctor call" {
  let source = "enum Pat { PBind(String); PCtor(String, Array[Pat]); PWild }\nlet empty_pats: () -> Array[Pat] = () -> { Array::slice([PWild], 0, 0) }\nlet parse_pats: (Int) -> (Array[Pat], Int) = (pos) -> { (empty_pats(), pos + 1) }\nlet foo: () -> (Pat, Int) = () -> {\n  let (args, end) = parse_pats(0);\n  (PCtor(\"hi\", args), end)\n}\nlet main: () -> Int = () -> {\n  let (p, n) = foo();\n  n\n}\n"
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  let bytes = compile_wasi_module(stmts, "main")
  Fs::write_bytes("/tmp/test_dt_ctor.wasm", bytes)
  0
}
