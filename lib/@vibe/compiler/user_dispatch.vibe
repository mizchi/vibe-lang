    let arg = Array::get(args, i)
    if arg == "--strict" {
      strict = true
      ()
    } else if arg == "--help" || arg == "-h" {
      println("usage: vibe escapes [--strict] <file.vibe>")
      return 0
    } else if String::length(arg) > 0 && String::char_code_at(arg, 0) == 45 {
      throw(String::concat("escapes: unknown flag: ", arg))
