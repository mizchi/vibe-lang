  "usage: vibe rc-classify <file.vibe>\nNAME SET[,SET...] per user function. Empty output = no special sets.\nSets: borrow_ret, borrow_param, view_ret, scalar_ret.\n"
}

fn rc_plan_help_text() -> String {
  "usage: vibe rc-plan [--fn NAME] <file.vibe>\nFN BINDING ACTION COUNT per collapsed Perceus action.\nEmpty output = no actions. ACTION is dup, drop, or alias_dup.\n"
}

fn selfhost_cli_user_rc_classify_args(args: Array[String]) -> Int with Exception + Fs + Console {
