fn join_binding(occ: Array[(Int, Int)]) -> String {
  let n = Array::length(occ)
  if n == 0 {
    ""
  } else {
    let acc = StringBuilder::new()
    let mut i = 0
    while i < n {
      let (s, e) = Array::get(occ, i)
      if i > 0 {
        StringBuilder::push(acc, "\n")
      } else {
        ()
      }
      StringBuilder::push(acc, __to_string(s))
      StringBuilder::push(acc, " ")
      StringBuilder::push(acc, __to_string(e))
      i = i + 1
    }
    StringBuilder::freeze(acc)
  }
}

fn selfhost_cli_user_binding_at_args(args: Array[String]) -> Int with Exception + Fs + Console {
  let (src, line, col) = parse_user_type_at_args(args)
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    print_text(join_binding(binding_occurrences(Fs::read_file(src), line, col)))
    0
  }
}

fn escape_doc_field(text: String) -> String {
  let n = String::length(text)
  let acc = StringBuilder::new()
  let mut i = 0
  while i < n {
    let c = String::byte_at(text, i)
    if c == 92 {
      StringBuilder::push(acc, "\\\\")
    } else if c == 10 {
      StringBuilder::push(acc, "\\n")
    } else if c == 13 {
      ()
    } else {
      StringBuilder::push(acc, String::from_byte(c))
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

fn name_field_needs_escape(text: String) -> Bool {
  let n = String::length(text)
  let mut i = 0
  let mut found = false
  while i < n && !found {
    let c = String::byte_at(text, i)
    if c == 92 || c == 32 || (c >= 9 && c <= 13) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn name_field_escape_of(c: Int) -> String {
  if c == 92 {
    "\\\\"
  } else if c == 32 {
    "\\s"
  } else if c == 9 {
    "\\t"
  } else if c == 10 {
    "\\n"
  } else if c == 11 {
    "\\v"
  } else if c == 12 {
    "\\f"
  } else if c == 13 {
    "\\r"
  } else {
    String::from_byte(c)
  }
}

fn escape_name_field(text: String) -> String {
  if !name_field_needs_escape(text) {
    text
  } else {
    let n = String::length(text)
    let acc = StringBuilder::new()
    let mut i = 0
    while i < n {
      StringBuilder::push(acc, name_field_escape_of(String::byte_at(text, i)))
      i = i + 1
    }
    StringBuilder::freeze(acc)
  }
}

fn join_symbol_spans(syms: Array[(String, Int, Int, Int, String)]) -> String {
  let n = Array::length(syms)
  let acc = StringBuilder::new()
  let mut first = true
  let mut i = 0
  while i < n {
    let (name, kind, s, e, doc) = Array::get(syms, i)
    if String::length(name) == 0 {
      ()
    } else {
      let head = String::concat(escape_name_field(name), String::concat(" ", String::concat(__to_string(kind), String::concat(" ", String::concat(__to_string(s), String::concat(" ", __to_string(e)))))))
      let line = if String::length(doc) == 0 {
        head
      } else {
        String::concat(head, String::concat(" ", escape_doc_field(doc)))
      }
      if first {
        StringBuilder::push(acc, line)
        first = false
      } else {
        StringBuilder::push(acc, "\n")
        StringBuilder::push(acc, line)
      }
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

fn join_symbol_spans_with_path(rows: Array[(String, String, Int, Int, Int, String)]) -> String {
  let n = Array::length(rows)
  let acc = StringBuilder::new()
  let mut first = true
  let mut i = 0
  while i < n {
    let (path, name, kind, s, e, doc) = Array::get(rows, i)
    if String::length(name) == 0 {
      ()
    } else {
      let head = String::concat(path, String::concat(" ", String::concat(escape_name_field(name), String::concat(" ", String::concat(__to_string(kind), String::concat(" ", String::concat(__to_string(s), String::concat(" ", __to_string(e)))))))))
      let line = if String::length(doc) == 0 {
        head
      } else {
        String::concat(head, String::concat(" ", escape_doc_field(doc)))
      }
      if first {
        StringBuilder::push(acc, line)
        first = false
      } else {
        StringBuilder::push(acc, "\n")
        StringBuilder::push(acc, line)
      }
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

fn symbols_legend() -> String {
  "2 Module\n6 Method\n10 Enum\n11 Interface\n12 Function\n13 Variable\n23 Struct\n24 Event\n26 TypeParameter\n27 Test\n28 Bench"
}

fn selfhost_cli_user_symbols_args(args: Array[String]) -> Int with Exception + Fs + Console + Stderr {
  if Array::length(args) >= 2 && Array::get(args, 1) == "--legend" {
    println(symbols_legend())
    0
  } else if Array::length(args) >= 2 && (Array::get(args, 1) == "--help" || Array::get(args, 1) == "-h") {
    println("usage: vibe symbols [--with-path] <path>...\n       vibe symbols --legend")
    0
  } else {
    let mut with_path = false
    let paths: Array[String] = []
    let mut i = 1
    while i < Array::length(args) {
      let arg = Array::get(args, i)
      if arg == "--with-path" {
        with_path = true
        ()
      } else if arg == "--" {
        i = i + 1
        while i < Array::length(args) {
          Array::push(paths, Array::get(args, i))
          i = i + 1
        }
      } else if String::length(arg) > 0 && String::byte_at(arg, 0) == 45 {
        throw(String::concat("symbols: unknown flag: ", arg))
      } else {
        Array::push(paths, arg)
      }
      i = i + 1
    }
    if Array::length(paths) == 0 {
      throw("usage: vibe symbols [--with-path] <path>...")
    } else {
      // Every root must exist before any row is printed: a sweep that skipped
      // a missing root would print a complete-looking answer to a different
      // question (scripts/test_vibe_symbols.sh, #2381).
      let mut ci = 0
      while ci < Array::length(paths) {
        if !Fs::exists(Array::get(paths, ci)) {
          throw(String::concat("not found: ", Array::get(paths, ci)))
        } else {
          ()
        }
        ci = ci + 1
      }
      // More than one root, or a DIRECTORY root, can produce lines from more
      // than one file -- so the PATH field is not optional there, and a lone
      // directory takes the sweep rather than being read as a file.
      let many = with_path || Array::length(paths) > 1 || Fs::is_dir(Array::get(paths, 0))
      if many {
        let acc = StringBuilder::new()
        let fails: Array[String] = []
        let mut first = true
        let mut pi = 0
        while pi < Array::length(paths) {
          let (rows, failures) = symbol_spans_fs_report(Array::get(paths, pi))
          let chunk = join_symbol_spans_with_path(rows)
          if chunk != "" {
            if first {
              StringBuilder::push(acc, chunk)
              first = false
            } else {
              StringBuilder::push(acc, "\n")
              StringBuilder::push(acc, chunk)
            }
          } else {
            ()
          }
          let mut fi = 0
          while fi < Array::length(failures) {
            Array::push(fails, Array::get(failures, fi))
            fi = fi + 1
          }
          pi = pi + 1
        }
        print_text(StringBuilder::freeze(acc))
        // The symbols contract (AGENTS.md): the rows that were read reach
        // stdout, a file that could not be parsed is NAMED on stderr, and the
        // exit is non-zero. Throwing here would append the failure to the
        // machine-readable stream through the entry's `error:` framing.
        if Array::length(fails) > 0 {
          Stderr::write_stream(line_terminated(String::join(fails, "\n")))
          1
        } else {
          0
        }
      } else {
        let src = Array::get(paths, 0)
        if !Fs::exists(src) {
          throw(String::concat("not found: ", src))
        } else {
          // #2898: the file DECIDES the grammar -- a `.vpkg` is a list of
          // bodyless declarations, not statement grammar. A failure carries
          // the path and, where the contract parser can say which token it
          // stopped on, a `line L:col C:` prefix: `unexpected token: type`
          // with neither was a non-zero exit the caller could not act on.
          let text = Fs::read_file(src)
          let syms = handle {
            symbol_spans_with_docs_for_path(src, text)
          } with { Exception::Throw(msg) => throw(String::concat(src, String::concat(": ", symbol_spans_locate_failure(src, text, msg)))) }
          print_text(join_symbol_spans(syms))
          0
        }
      }
    }
  }
}

fn join_triples_name_int_int(items: Array[(String, Int, Int)]) -> String {
  let n = Array::length(items)
  let acc = StringBuilder::new()
  let mut first = true
  let mut i = 0
  while i < n {
    let (name, s, e) = Array::get(items, i)
    if String::length(name) == 0 {
      ()
    } else {
      let line = String::concat(name, String::concat(" ", String::concat(__to_string(s), String::concat(" ", __to_string(e)))))
      if first {
        StringBuilder::push(acc, line)
        first = false
      } else {
        StringBuilder::push(acc, "\n")
        StringBuilder::push(acc, line)
      }
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

fn selfhost_cli_user_escapes_args(args: Array[String]) -> Int with Exception + Fs + Console {
  let mut strict = false
  let mut src = ""
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--strict" {
      strict = true
      ()
    } else if arg == "--help" || arg == "-h" {
      println("usage: vibe escapes [--strict] <file.vibe>")
      return 0
    } else if String::length(arg) > 0 && String::byte_at(arg, 0) == 45 {
      throw(String::concat("escapes: unknown flag: ", arg))
    } else {
      src = arg
    }
    i = i + 1
  }
  if src == "" {
    throw("usage: vibe escapes [--strict] <file.vibe>")
  } else if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let spans = if strict {
      escape_spans_strict(Fs::read_file(src))
    } else {
      escape_spans(Fs::read_file(src))
    }
    print_text(join_triples_name_int_int(spans))
    0
  }
}

/// The same three lines `runtime/vibe` prints for `rc-classify --help` without
/// starting a runner (scripts/test_vibe_rc_help.sh); the two texts are kept in
/// step by hand, the gate reads the launcher's.
