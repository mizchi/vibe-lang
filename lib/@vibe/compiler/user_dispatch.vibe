//# Helpers

fn cli_bytes(value: String) -> Bytes {
  let out = Array::slice([0], 0, 0)
  let mut i = 0
  while i < String::length(value) {
    Array::push(out, String::byte_at(value, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

fn last_slash_index(path: String) -> Int {
  let len = String::length(path)
  let mut last = -1
  let mut i = 0
  while i < len {
    if String::byte_at(path, i) == 47 {
      last = i
    }
    i = i + 1
  }
  last
}

fn dirname_of(path: String) -> String {
  let slash = last_slash_index(path)
  if slash <= 0 {
    ""
  } else {
    path[0: slash]
  }
}

fn basename_of(path: String) -> String {
  let slash = last_slash_index(path)
  let len = String::length(path)
  if slash >= 0 {
    path[slash + 1: len]
  } else {
    path
  }
}

fn strip_vibe_suffix(path: String) -> String {
  let len = String::length(path)
  if len >= 6 && path[len - 6: len] == ".vibex" {
    path[0: len - 6]
  } else if len >= 5 && path[len - 5: len] == ".vibe" {
    path[0: len - 5]
  } else {
    path
  }
}

fn is_vibex_path(path: String) -> Bool {
  String::ends_with(path, ".vibex")
}

fn path_has_suffix(s: String, suffix: String) -> Bool {
  let n = String::length(s)
  let m = String::length(suffix)
  n >= m && String::substring(s, n - m, n) == suffix
}

fn ensure_parent_dir(path: String) -> Unit with Fs {
  let dir = dirname_of(path)
  if dir == "" {
    ()
  } else {
    Fs::mkdir_p(dir)
  }
}

fn default_build_dir() -> String with Env {
  let override_dir = Env::get("VIBE_BUILD_DIR")
  if override_dir == "" {
    ".vibe/build"
  } else {
    override_dir
  }
}

export fn display_under_root(path: String, build_dir: String) -> String {
  if build_dir != "" && String::starts_with(path, build_dir) && String::ends_with(build_dir, "/.vibe/build") {
    String::concat(".vibe/build", path[String::length(build_dir): String::length(path)])
  } else {
    path
  }
}

fn default_out_wasm(input_path: String) -> String with Env {
  String::concat(default_build_dir(), String::concat("/out/", String::concat(basename_of(strip_vibe_suffix(input_path)), ".wasm")))
}

fn default_run_wasm(input_path: String) -> String with Env {
  String::concat(default_build_dir(), String::concat("/run/", String::concat(basename_of(strip_vibe_suffix(input_path)), ".wasm")))
}

fn default_wit_path(input_path: String) -> String with Env {
  String::concat(default_build_dir(), String::concat("/out/", String::concat(basename_of(strip_vibe_suffix(input_path)), ".wit")))
}

fn parse_int_or(s: String, default: Int) -> Int {
  let len = String::length(s)
  if len == 0 {
    default
  } else {
    let mut i = 0
    let mut acc = 0
    let mut ok = true
    while ok && i < len {
      let c = String::byte_at(s, i)
      if c >= '0' && c <= '9' {
        acc = acc * 10 + (c - '0')
        i = i + 1
      } else {
        ok = false
      }
    }
    if ok && i == len {
      acc
    } else {
      default
    }
  }
}

/// `--jobs N`: a positive integer, refused otherwise. `vibe test` hands it to
/// the launcher, whose run-tests arm runs that many files' wasm concurrently;
/// for `build` / `check` it is accepted for compatibility and has no effect on
/// the output (it only ever pre-warmed a cache), so the value is still
/// validated rather than silently swallowed (Codex review of #2858).
fn parse_jobs_value(raw: String) -> Int with Exception {
  let n = parse_int_or(raw, 0)
  if n <= 0 {
    throw(String::concat("--jobs must be a positive integer, got: ", raw))
  } else {
    n
  }
}

fn need_value(args: Array[String], index: Int, command: String, flag: String) -> String with Exception {
  if index >= Array::length(args) {
    throw(String::concat(command, String::concat(": missing value after ", flag)))
  } else {
    Array::get(args, index)
  }
}

fn line_terminated(text: String) -> String {
  let n = String::length(text)
  if n == 0 {
    text
  } else if String::byte_at(text, n - 1) == 10 {
    text
  } else {
    String::concat(text, "\n")
  }
}

fn print_text(text: String) -> Unit with Console {
  if text == "" {
    ()
  } else {
    print(line_terminated(text))
  }
}

fn program_parses(src: String) -> Bool {
  handle {
    let _ = parse_program(lex(src))
    true
  } with { Exception::Throw(_) => false }
}

fn parse_error_of(src: String) -> String {
  handle {
    let _ = parse_program(lex(src))
    ""
  } with { Exception::Throw(msg) => msg }
}

fn is_warning_line(line: String) -> Bool {
  if String::starts_with(line, "warning: ") {
    true
  } else if String::starts_with(line, "line ") {
    String::contains(line, " warning: ")
  } else {
    false
  }
}

fn unstable_opt_in() -> Bool with Env {
  Env::get("VIBE_UNSTABLE") == "1"
}

fn compile_user_wasm(input_path: String, entry_name: String, kind: String, grants: Array[(String, String)]) -> Bytes with Exception + Fs + Env {
  if kind == "trace" {
    compile_file_fs_mode_trace(input_path, entry_name)
  } else if kind == "break" {
    compile_file_fs_mode_break(input_path, entry_name)
  } else if kind == "gc" {
    compile_file_fs_mode_gc(input_path, entry_name)
  } else if kind == "component" {
    // A COMMAND component prunes from the module's own command entry and emits
    // a LIBRARY, which is why it needs its own mode rather than `mvp`
    // (docs/internal/design/component-lazy-dispatch.md). The mode comes from
    // `cli_support.vibe` so this door and the `.vibex` CLI's `build
    // --component` cannot drift apart (#2863: the same flag produced 40 MB
    // through one door and 2.6 MB through the other).
    compile_file_fs_mode(input_path, entry_name, command_component_compile_mode())
  } else {
    compile_release_lane(input_path, entry_name, grants)
  }
}

/// The production allocator lane, selected the way `cli_adapter.vibe`'s
/// `fs_lane_compile_full` selects it: `VIBE_RC` unset or `1` is the Perceus RC
/// lane (#493 cutover, #705 parity), `0` opts back into the legacy bump lane,
/// and `shadow` is the RC lane with shadow-liveness marks. Calling
/// `compile_file_fs_mode` alone here was the bump lane for EVERY compile
/// (Codex review of #2858): a long-running program kept every allocation until
/// exit, and `VIBE_RC=shadow` silently did nothing.
fn compile_release_lane(input_path: String, entry_name: String, grants: Array[(String, String)]) -> Bytes with Exception + Fs + Env {
  let rc_flag = Env::get("VIBE_RC")
  if rc_flag == "0" {
    // #2828 rung 2: every arm carries the grants. When only the rc arm did,
    // `VIBE_RC=0` and `VIBE_RC=shadow` silently answered `NotGranted` for every
    // optional capability -- authority became a function of which allocator was
    // selected, which is the "silently wrong" this project ranks worst.
    compile_file_fs_mode_grants(input_path, entry_name, "mvp", grants)
  } else if rc_flag == "shadow" {
    compile_file_fs_mode_rc_shadow_grants(input_path, entry_name, grants)
  } else {
    compile_file_fs_mode_rc_grants(input_path, entry_name, grants)
  }
}

/// ADR-0068 (#2305): refuse an unstable import unless the caller opted in.
///
/// `runtime/vibe` did not carry this -- `cli_adapter.vibe` did, on the far
/// side of the launcher's compile invocation, so every launcher verb inherited
/// it. Calling `compile_file_fs_mode*` from here goes AROUND the adapter, so
/// without these two calls `vibe build` / `run` / `test` / `serve` write an
/// artifact for a program that imports `@vibe/concurrent` with no opt-in,
/// while `vibe check` on the same file still reports it. #2305's own note on
/// the split CLI applies unchanged: the gate belongs on the one function every
/// artifact-producing path goes through, so it covers them by construction
/// rather than by remembering.
fn reject_unstable_entry_surface(input_path: String) -> Unit with Exception + Fs + Env {
  if unstable_opt_in() {
    ()
  } else {
    let diags = check_unstable_surface_warnings_from_path(input_path)
    if Array::length(diags) > 0 {
      throw(String::join(diags, "\n"))
    } else {
      ()
    }
  }
}

/// The closure half. A SIBLING carrying the import is invisible until the
/// loader has walked it, so this can only be asked after the compile that
/// ingested it -- and before the artifact is written.
fn reject_unstable_closure_surface() -> Unit with Exception + Fs + Env {
  if unstable_opt_in() {
    ()
  } else {
    let diags = check_unstable_surface_warnings_from_closure()
    if Array::length(diags) > 0 {
      throw(String::join(diags, "\n"))
    } else {
      ()
    }
  }
}

/// Every artifact this dispatcher compiles goes through here: entry gate,
/// compile, closure gate.
fn compile_user_artifact(input_path: String, entry_name: String, kind: String, grants: Array[(String, String)]) -> Bytes with Exception + Fs + Env {
  reject_unstable_entry_surface(input_path)
  unstable_closure_reset()
  let bytes = compile_user_wasm(input_path, entry_name, kind, grants)
  reject_unstable_closure_surface()
  bytes
}

/// Binary-size (#1100): a release executable ships without its name section
/// and without the module-linking exports, keeping only what a runner
/// addresses by name. `cli_adapter.vibe` applied this to everything the
/// launcher compiled; writing the compiler's bytes straight to disk here put
/// the name section back into every `vibe build` / `compile` artifact.
/// Instrumented builds (trace / break) are debug artifacts whose tooling reads
/// both, so they keep the plain write, and the strip is itself a no-op for the
/// `__no_entry__` test/bench builds.
fn write_user_executable(output_path: String, bytes: Bytes, entry_name: String, kind: String) -> Unit with Fs + Env {
  ensure_parent_dir(output_path)
  if kind == "trace" || kind == "break" {
    Fs::write_bytes(output_path, bytes)
  } else {
    Fs::write_bytes(output_path, strip_executable_wasm_env(bytes, entry_name))
  }
}

/// `vibe run`'s executable keeps the wasm `name` section and the production
/// `vibe.linemap` / `vibe.dbgfiles` that `vibe build` strips for size
/// (#1100 / #2199): a trap backtrace names the user function
/// (`<unknown>!boom`) and an editable path:line. The launcher's funcmap
/// annotation and `vibe profile`'s frame names key on the name section
/// (scripts/test_vibe_trace.sh, scripts/test_vibe_bench.sh). The debug lanes
/// carry their own sections and are written as compiled.
fn write_user_run_executable(output_path: String, bytes: Bytes, kind: String) -> Unit with Fs + Env {
  ensure_parent_dir(output_path)
  if kind == "trace" || kind == "break" {
    Fs::write_bytes(output_path, bytes)
  } else {
    Fs::write_bytes(output_path, strip_executable_wasm(bytes, "main", false, Env::get("VIBE_WASM_KEEP_EXPORTS") != "1"))
  }
}

/// `VIBE_TEST_BACKEND` / `VIBE_BENCH_BACKEND` = `linear` (default) | `gc`.
///
/// `runtime/vibe` used to read these and hand `VIBE_BACKEND=gc` to the
/// adapter, which selected `compile_file_fs_mode_gc`. With the translation
/// moved here, a launcher that no longer sets the variable and a dispatcher
/// that never reads it means `VIBE_TEST_BACKEND=gc vibe test` silently
/// measures the LINEAR lane -- the CI `gc-gate` asks exactly that question.
/// An unrecognised value is refused by name rather than treated as `linear`.
fn user_backend_kind(var: String) -> String with Exception + Env {
  let requested = Env::get(var)
  if requested == "" || requested == "linear" {
    "mvp"
  } else if requested == "gc" {
    "gc"
  } else {
    throw(String::concat(var, String::concat(" must be 'linear' or 'gc', got: ", requested)))
  }
}

fn write_wasm(output_path: String, bytes: Bytes) -> Unit with Fs {
  ensure_parent_dir(output_path)
  Fs::write_bytes(output_path, bytes)
}

/// The parser hands back the DEFAULT build path spelled literally
/// (`.vibe/build/...`) because it has no `Env`; this re-anchors it on the real
/// build directory. A `-o` the caller wrote is passed through untouched --
/// decided by whether the flag was GIVEN, not by the path's prefix: with
/// `VIBE_BUILD_DIR` set, an explicit `-o .vibe/build/release.wasm` used to be
/// indistinguishable from the default and was moved into the override
/// directory (Codex review of #2858).
fn resolve_user_build_output(output_path: String, output_given: Bool) -> String with Env {
  if !output_given && String::starts_with(output_path, ".vibe/build/") {
    String::concat(default_build_dir(), output_path[11: String::length(output_path)])
  } else {
    output_path
  }
}

fn write_host_action(action_path: String, body: String) -> Int with Exception + Fs {
  if action_path == "" {
    throw("this command requires a host launcher to execute the planned action")
  } else {
    Fs::write_bytes(action_path, cli_bytes(body))
    0
  }
}

fn path_is_absolute(path: String) -> Bool {
  String::length(path) > 0 && String::byte_at(path, 0) == 47
}

fn join_path(dir: String, name: String) -> String {
  if dir == "" {
    name
  } else if String::ends_with(dir, "/") {
    String::concat(dir, name)
  } else {
    String::concat(dir, String::concat("/", name))
  }
}

fn strip_dot_slash(path: String) -> String {
  if String::starts_with(path, "./") {
    path[2: String::length(path)]
  } else {
    path
  }
}

fn invoke_rel_of(invoke_dir: String, project_root: String) -> String {
  if invoke_dir == "" || project_root == "" || invoke_dir == project_root {
    ""
  } else {
    let prefix = String::concat(project_root, "/")
    if String::starts_with(invoke_dir, prefix) {
      invoke_dir[String::length(prefix): String::length(invoke_dir)]
    } else {
      ""
    }
  }
}

export fn root_rel_from_invoke(invoke_rel: String, path: String) -> String {
  if path_is_absolute(path) {
    path
  } else if path == "." {
    if invoke_rel == "" {
      "."
    } else {
      invoke_rel
    }
  } else {
    let stripped = strip_dot_slash(path)
    if invoke_rel == "" {
      stripped
    } else {
      String::concat(invoke_rel, String::concat("/", stripped))
    }
  }
}

/// `--file-list` and `--resume-out` are here rather than left to the generic
/// path branch below, and the difference is `--resume-out` (#2956, Codex P2).
/// That branch only rewrites an argument that ALREADY EXISTS, which a resume
/// file by definition does not -- so from a subdirectory the guest wrote it
/// relative to the project root while the driver looked for it relative to the
/// invocation directory, and a path the caller chose silently became a
/// different path. `--file-list` happened to work through that branch, because
/// a caller's list does exist; naming both keeps the pair from depending on
/// that coincidence.
fn flag_takes_output_path(flag: String) -> Bool {
  flag == "-o" || flag == "--output" || flag == "--out" || flag == "--guest-profile" || flag == "--adapter" || flag == "--cli-wasm" || flag == "--changed" || flag == "--profile-tsv" || flag == "--profile-callstack" || flag == "--file-list" || flag == "--resume-out"
}

/// Flags whose verb parser reads the NEXT argv entry as a non-path value
/// (`need_value`). Only those belong here: a valueless flag listed by mistake
/// hides the source that follows it from the rewrite, so `vibe run --alloc-site
/// app.vibex` from a subdirectory reached the compiler with a path relative to
/// the wrong directory and reported an existing file as missing (Codex review
/// of #2858). `--mem-sample` and `--alloc-site` take their value only in the
/// `=` spelling, which the rewrite passes through untouched.
fn flag_takes_non_path(flag: String) -> Bool {
  flag == "--break" || flag == "--fn" || flag == "--pattern" || flag == "--where" || flag == "--where-row" || flag == "--entry" || flag == "--addr" || flag == "--port" || flag == "--iters" || flag == "--warmup" || flag == "--interval-us" || flag == "--jobs"
}

fn invoke_arg_exists(invoke_dir: String, arg: String) -> Bool with Fs {
  if path_is_absolute(arg) {
    Fs::exists(arg)
  } else {
    Fs::exists(join_path(invoke_dir, strip_dot_slash(arg)))
  }
}

fn looks_like_user_path(arg: String, invoke_dir: String) -> Bool with Fs {
  if String::contains(arg, "/") || String::contains(arg, ".") {
    true
  } else {
    Fs::is_dir(join_path(invoke_dir, arg))
  }
}

export fn rewrite_user_argv(args: Array[String], invoke_dir: String, project_root: String) -> Array[String] with Fs {
  let invoke_rel = invoke_rel_of(invoke_dir, project_root)
  if invoke_rel == "" || Array::length(args) == 0 {
    args
  } else {
    let out: Array[String] = []
    Array::push(out, Array::get(args, 0))
    let mut prev = ""
    let mut passthrough = false
    let mut i = 1
    while i < Array::length(args) {
      let a = Array::get(args, i)
      if passthrough {
        Array::push(out, a)
      } else if a == "--" {
        passthrough = true
        Array::push(out, a)
        prev = ""
      } else if flag_takes_output_path(prev) {
        Array::push(out, root_rel_from_invoke(invoke_rel, a))
        prev = ""
      } else if flag_takes_non_path(prev) {
        Array::push(out, a)
        prev = ""
      } else if String::starts_with(a, "--guest-profile=") {
        Array::push(out, String::concat("--guest-profile=", root_rel_from_invoke(invoke_rel, a[16: String::length(a)])))
        prev = ""
      } else if String::starts_with(a, "--file-list=") {
        // The equals spellings need their own arms for the same reason
        // `--guest-profile=` and `--out=` do: an argument beginning with `-`
        // never reaches the generic path branch, so the value rides through
        // untouched and resolves against the wrong directory.
        Array::push(out, String::concat("--file-list=", root_rel_from_invoke(invoke_rel, a[12: String::length(a)])))
        prev = ""
        ()
      } else if String::starts_with(a, "--resume-out=") {
        Array::push(out, String::concat("--resume-out=", root_rel_from_invoke(invoke_rel, a[13: String::length(a)])))
        prev = ""
        ()
      } else if String::starts_with(a, "--out=") {
        // The equals spelling `vibe profile --out=prof.json` names an output
        // path the same way the split one does (Codex review of #2858).
        Array::push(out, String::concat("--out=", root_rel_from_invoke(invoke_rel, a[6: String::length(a)])))
        prev = ""
      } else if String::length(a) > 0 && String::byte_at(a, 0) == 45 {
        Array::push(out, a)
        prev = a
      } else if looks_like_user_path(a, invoke_dir) && invoke_arg_exists(invoke_dir, a) {
        Array::push(out, root_rel_from_invoke(invoke_rel, a))
        prev = ""
      } else {
        Array::push(out, a)
        prev = ""
      }
      i = i + 1
    }
    out
  }
}

fn path_bytes_lt(a: String, b: String) -> Bool {
  let na = String::length(a)
  let nb = String::length(b)
  let n = if na < nb {
    na
  } else {
    nb
  }
  let mut i = 0
  let mut decided = 0
  while decided == 0 && i < n {
    let ca = String::byte_at(a, i)
    let cb = String::byte_at(b, i)
    if ca < cb {
      decided = 1
    } else if ca > cb {
      decided = 2
    } else {
      i = i + 1
    }
  }
  if decided == 1 {
    true
  } else if decided == 2 {
    false
  } else {
    na < nb
  }
}

fn sort_paths(items: Array[String]) -> Unit {
  let len = Array::length(items)
  let mut i = 0
  while i + 1 < len {
    let mut min_index = i
    let mut j = i + 1
    while j < len {
      if path_bytes_lt(Array::get(items, j), Array::get(items, min_index)) {
        min_index = j
      } else {
        ()
      }
      j = j + 1
    }
    if min_index != i {
      let tmp = Array::get(items, i)
      Array::set(items, i, Array::get(items, min_index))
      Array::set(items, min_index, tmp)
    } else {
      ()
    }
    i = i + 1
  }
}

fn collect_star_test_vibe(dir: String, out: Array[String]) -> Unit with Fs {
  let names = Fs::readdir(dir)
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, i)
    if name == "." || name == ".." {
      ()
    } else {
      let child = join_path(dir, name)
      if Fs::is_dir(child) {
        collect_star_test_vibe(child, out)
      } else if String::ends_with(name, "_test.vibe") {
        Array::push(out, child)
      } else {
        ()
      }
    }
    i = i + 1
  }
}

export fn expand_user_test_inputs(files: Array[String]) -> Array[String] with Exception + Fs {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(files) {
    let src = Array::get(files, i)
    if Fs::is_dir(src) {
      collect_star_test_vibe(src, out)
    } else if Fs::exists(src) {
      Array::push(out, src)
    } else {
      throw(String::concat("not found: ", src))
    }
    i = i + 1
  }
  sort_paths(out)
  if Array::length(out) == 0 {
    throw("vibe test: no test files found")
  } else {
    out
  }
}

//# Verb table

export fn user_dispatch_is_verb(name: String) -> Bool {
  name == "check" || name == "compile" || name == "build" || name == "fmt" || name == "normalize" || name == "type-at" || name == "doc-at" || name == "binding-at" || name == "symbols" || name == "escapes" || name == "rc-classify" || name == "rc-plan" || name == "allocs" || name == "deps" || name == "diagnostics" || name == "grep" || name == "run" || name == "test" || name == "bench" || name == "serve" || name == "profile" || name == "lsp" || name == "hash" || name == "inspect-update" || name == "help" || name == "--help" || name == "-h"
}

//# check

export fn parse_user_check_args(args: Array[String]) -> (String, Bool, Bool) with Exception {
  if Array::length(args) == 0 || Array::get(args, 0) != "check" {
    throw("check: expected command")
  } else {
    let mut src = ""
    let mut single = false
    let mut json = false
    let mut missing_vpkg = false
    let mut deps_missing = false
    let mut i = 1
    while i < Array::length(args) {
      let arg = Array::get(args, i)
      if arg == "--single-file" {
        single = true
        ()
      } else if arg == "--json" {
        json = true
        ()
      } else if arg == "--jobs" {
        i = i + 1
        let _ = parse_jobs_value(need_value(args, i, "check", arg))
        ()
      } else if arg == "--missing-vpkg" {
        missing_vpkg = true
        ()
      } else if arg == "--deps-missing" {
        deps_missing = true
        ()
      } else if arg == "--profile" || arg == "--profile-tsv" || arg == "--profile-callstack" {
        i = i + 1
        let _ = need_value(args, i, "check", arg)
        ()
      } else if String::length(arg) > 0 && String::byte_at(arg, 0) == 45 {
        throw(String::concat("check: unknown option: ", arg))
      } else if src == "" {
        src = arg
        ()
      } else {
        // Further positionals are more files to check (`vibe check a.vibe
        // b.vibe`, docs/user/reference/cli-commands.md); `user_check_paths`
        // collects them all, this tuple keeps naming the first.
        ()
      }
      i = i + 1
    }
    if src == "" {
      throw("usage: vibe check [--jobs N] [--single-file] [--json] <file.vibe>...")
    } else {
      (src, single, json)
    }
  }
}

fn user_check_scan(root: String, missing_vpkg: Bool) -> Int with Exception + Fs + Console {
  // Both scanners walk the root with `Fs::readdir`, which traps the whole
  // instance on a non-directory; a typo has to come back as a diagnostic
  // instead (Codex review of #2858).
  if !Fs::exists(root) {
    throw(String::concat("not found: ", root))
  } else if !Fs::is_dir(root) {
    throw(String::concat("check: ", String::concat(root, " is not a directory (--missing-vpkg and --deps-missing scan a directory tree)")))
  } else {
    ()
  }
  let rows = if missing_vpkg {
    find_missing_vpkg_dirs(root)
  } else {
    find_deps_missing(root)
  }
  if Array::length(rows) == 0 {
    if missing_vpkg {
      print(String::concat("ok: no directories missing index.vpkg under ", String::concat(root, "\n")))
    } else {
      print(String::concat("ok: no missing deps declarations under ", String::concat(root, "\n")))
    }
    0
  } else {
    print(line_terminated(String::join(rows, "\n")))
    1
  }
}

fn user_check_single(src: String, json: Bool) -> Int with Exception + Fs + Env + Console + Stderr {
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let text = Fs::read_file(src)
    // A throw that reaches HERE is an internal failure, not a diagnostic
    // about the source: `collect_all_diagnostics_with_unstable_for_path`
    // already degrades the one recoverable half itself (`typecheck_fs.vibe`
    // catches the unstable scan's lex throw so the lexer's own diagnostics
    // survive). Answering `[]` certified the file CLEAN -- empty stdout in
    // text mode, `[]` in JSON, exit 0 either way (Codex P1 on #2868). This
    // lane SELLS "empty output = clean" (CLAUDE.md, the CLI query policy), so
    // the one thing it may never do is spend that sentence on a check it
    // could not run. The message becomes an ERROR diagnostic: it starts with
    // neither `warning: ` nor `line `, so `is_warning_line` reads it as an
    // error and the exit code is 1.
    //
    // `user_diagnostics_report` below keeps the swallow on purpose: that verb
    // is deprecated and FROZEN at exit 0 for the editors still calling it, so
    // unfreezing it is a separate decision, not this fix.
    let diags = handle {
      collect_all_diagnostics_with_unstable_for_path(src, text, unstable_opt_in())
    } with { Exception::Throw(message) => {
      let failed: Array[String] = []
      Array::push(failed, String::concat("check failed: ", message))
      failed
    } }
    if json {
      print(line_terminated(lsp_diagnostics_json_of_messages(text, diags)))
      let mut has_error = false
      let mut i = 0
      while i < Array::length(diags) {
        if !is_warning_line(Array::get(diags, i)) {
          has_error = true
        }
        i = i + 1
      }
      if has_error {
        1
      } else {
        0
      }
    } else {
      // Warnings reach STDERR and leave the exit code alone -- "clean" stays
      // detectable as empty stdout even for a file that warns, as the
      // launcher reported them before (Codex review of #2858).
      let errors: Array[String] = []
      let warnings: Array[String] = []
      let mut i = 0
      while i < Array::length(diags) {
        let line = Array::get(diags, i)
        if is_warning_line(line) {
          Array::push(warnings, line)
        } else {
          Array::push(errors, line)
        }
        i = i + 1
      }
      if Array::length(warnings) > 0 {
        Stderr::write_stream(line_terminated(String::join(warnings, "\n")))
      } else {
        ()
      }
      if Array::length(errors) == 0 {
        0
      } else {
        throw(String::join(errors, "\n"))
      }
    }
  }
}

/// Every positional argument of `vibe check` is a file to check; the flags
/// that take a value are skipped with it. `parse_user_check_args` validates
/// the flags and names the first file, this names them all.
fn user_check_paths(args: Array[String]) -> Array[String] {
  let paths: Array[String] = []
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--jobs" || arg == "--profile" || arg == "--profile-tsv" || arg == "--profile-callstack" {
      i = i + 2
    } else if String::length(arg) > 0 && String::byte_at(arg, 0) == 45 {
      i = i + 1
    } else {
      Array::push(paths, arg)
      i = i + 1
    }
  }
  paths
}

fn has_control_char(value: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < String::length(value) {
    let c = String::byte_at(value, i)
    if c < 32 || c == 127 {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn remove_stale_sidecar(path: String) -> Unit with Fs {
  if path != "" && Fs::exists(path) {
    Fs::remove(path)
  } else {
    ()
  }
}

fn write_warning_rows(rows: Array[String]) -> Unit with Stderr {
  if Array::length(rows) > 0 {
    Stderr::write_stream(line_terminated(String::join(rows, "\n")))
  } else {
    ()
  }
}

/// The import-resolving check, with the policy and observation the adapter's
/// former check-only branch carried (Codex review of #2858):
///
/// - typing-dependency-env reuse is the production default for this lane
///   (`VIBE_DISABLE_TYPING_DEPENDENCY_ENV_REUSE=1` opts out; an invalidation
///   trace forces it off so the trace stays observation-only);
/// - the opt-in sidecars -- `VIBE_INCREMENTAL_TELEMETRY_OUT`,
///   `VIBE_INCREMENTAL_INVALIDATION_TRACE_OUT` (+ nonce),
///   `VIBE_INGESTION_TELEMETRY_OUT` (+ nonce) and
///   `VIBE_INGESTION_PIPELINE_TELEMETRY_OUT` (+ nonce) -- are removed before
///   the check and published only after it succeeds, so a stale file never
///   reads as this check's result (`scripts/edit_cycle_kpi.mjs` reads them);
/// - the deprecated-use, redundant-import and builtin-shadowing warnings are
///   collected from the checked source groups and written to stderr, leaving
///   stdout and the exit code to the errors.
///
/// ADR-0068 applies as on every artifact path: the closure gate is asked after
/// the walk, so a program the build refuses for an unstable import is reported
/// by `vibe check` too rather than answered clean.
fn user_check_linked(src: String) -> Int with Exception + Fs + Env + Stderr {
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let disable_reuse = Env::get("VIBE_DISABLE_TYPING_DEPENDENCY_ENV_REUSE")
    let telemetry_out = Env::get("VIBE_INCREMENTAL_TELEMETRY_OUT")
    let trace_out = Env::get("VIBE_INCREMENTAL_INVALIDATION_TRACE_OUT")
    let trace_nonce = Env::get("VIBE_INCREMENTAL_INVALIDATION_TRACE_NONCE")
    let ingestion_out = Env::get("VIBE_INGESTION_TELEMETRY_OUT")
    let ingestion_nonce = Env::get("VIBE_INGESTION_TELEMETRY_NONCE")
    let pipeline_out = Env::get("VIBE_INGESTION_PIPELINE_TELEMETRY_OUT")
    let pipeline_nonce = Env::get("VIBE_INGESTION_PIPELINE_TELEMETRY_NONCE")
    if disable_reuse != "" && disable_reuse != "1" {
      throw("VIBE_DISABLE_TYPING_DEPENDENCY_ENV_REUSE must be exactly 1 when set")
    } else {
      ()
    }
    set_experimental_typing_dependency_env_reuse_enabled(disable_reuse != "1" && trace_out == "")
    remove_stale_sidecar(telemetry_out)
    remove_stale_sidecar(trace_out)
    remove_stale_sidecar(ingestion_out)
    remove_stale_sidecar(pipeline_out)
    if trace_out != "" && trace_nonce == "" {
      throw("VIBE_INCREMENTAL_INVALIDATION_TRACE_OUT requires VIBE_INCREMENTAL_INVALIDATION_TRACE_NONCE")
    } else if ingestion_out != "" && (ingestion_nonce == "" || has_control_char(ingestion_nonce)) {
      throw("VIBE_INGESTION_TELEMETRY_OUT requires a non-empty control-free VIBE_INGESTION_TELEMETRY_NONCE")
    } else if pipeline_out != "" && (pipeline_nonce == "" || has_control_char(pipeline_nonce)) {
      throw("VIBE_INGESTION_PIPELINE_TELEMETRY_OUT requires a non-empty control-free VIBE_INGESTION_PIPELINE_TELEMETRY_NONCE")
    } else {
      ()
    }
    set_incremental_typecheck_telemetry_enabled(telemetry_out != "" || trace_out != "")
    set_ingestion_fingerprint_telemetry_enabled(ingestion_out != "")
    set_ingestion_pipeline_telemetry_enabled(pipeline_out != "")
    set_incremental_interface_trace_enabled(trace_out != "")
    reject_unstable_entry_surface(src)
    unstable_closure_reset()
    let groups = check_linked_file_source_groups(src)
    if telemetry_out != "" {
      Fs::write_file(telemetry_out, incremental_typecheck_telemetry_json())
    } else {
      ()
    }
    if trace_out != "" {
      Fs::write_file(trace_out, incremental_invalidation_trace_json(src, trace_nonce))
    } else {
      ()
    }
    if ingestion_out != "" {
      Fs::write_file(ingestion_out, ingestion_fingerprint_telemetry_json(ingestion_nonce))
    } else {
      ()
    }
    reject_unstable_closure_surface()
    write_warning_rows(check_deprecated_warnings_from_source_groups(src, groups))
    write_warning_rows(check_redundant_import_warnings_from_source_groups(src, groups))
    write_warning_rows(check_let_star_warnings_from_source_groups(src, groups))
    write_warning_rows(check_builtin_shadowing_warnings_from_source_groups(src, groups))
    // Published strictly after the check has been answered: a failure above
    // leaves no pipeline sidecar looking like a successful observation.
    if pipeline_out != "" {
      Fs::write_file(pipeline_out, ingestion_pipeline_telemetry_json(pipeline_nonce))
    } else {
      ()
    }
    0
  }
}

/// `user_check_linked` answered as a JSON array of LSP Diagnostic objects
/// (#2831). The FS lane reports diagnostics by RAISING them, so the whole
/// check runs under a handler here and the raised text becomes the array's
/// one entry; a clean file yields `[]` and exit 0. `not found` stays an
/// exception -- a usage error is not a diagnostic about the file's contents.
fn user_check_linked_json(src: String) -> Int with Exception + Fs + Env + Console + Stderr {
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let text = Fs::read_file(src)
    let diags = handle {
      let _ = user_check_linked(src)
      let empty: Array[String] = []
      empty
    } with { Exception::Throw(message) => {
      // #2831 criterion 4: the raised text is now every diagnostic the check
      // collected, `\n`-joined and each one located and path-prefixed on its
      // own. One ARRAY ENTRY per line, or the JSON lane would emit a single
      // Diagnostic whose `message` carries embedded newlines -- which is not
      // a thing an LSP client can place.
      // Per DIAGNOSTIC, not per line: `is_check_report_continuation` above
      // decides which lines belong to the one before them.
      let lines = String::split(message, "\n")
      let out: Array[String] = []
      let mut li = 0
      while li < Array::length(lines) {
        let line = Array::get(lines, li)
        if String::length(line) == 0 {
          ()
        } else if is_check_report_continuation(line) && Array::length(out) > 0 {
          let last = Array::length(out) - 1
          Array::set(out, last, String::concat(Array::get(out, last), String::concat("\n", line)))
        } else {
          Array::push(out, line)
        }
        li = li + 1
      }
      out
    } }
    // Told WHICH file `text` is: this lane reports a DEPENDENCY's error as
    // `<dep>: line L:C: body`, located against the dep. Rendered without the
    // path, that column was converted against the entry's text and the origin
    // was dropped from the message (Codex P2 on #2868).
    print(line_terminated(lsp_diagnostics_json_of_messages_for(src, text, diags)))
    if Array::length(diags) == 0 {
      0
    } else {
      1
    }
  }
}

/// The two profiling sidecars `vibe check` can be asked for: `--profile-tsv P`
/// and `--profile-callstack P`. Parsed apart from `parse_user_check_args` so
/// that tuple keeps the shape `dispatch_test.vibe` pins; a flag without a
/// value is refused there, so this scan only reads what it validated.
fn user_check_profile_paths(args: Array[String]) -> (String, String) {
  let mut tsv = ""
  let mut callstack = ""
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if (arg == "--profile-tsv" || arg == "--profile-callstack") && i + 1 < Array::length(args) {
      if arg == "--profile-tsv" {
        tsv = Array::get(args, i + 1)
      } else {
        callstack = Array::get(args, i + 1)
      }
      i = i + 2
    } else {
      i = i + 1
    }
  }
  (tsv, callstack)
}

fn profile_stage_row(stage: String, elapsed_us: Int) -> String {
  let us = if elapsed_us < 0 {
    0
  } else {
    elapsed_us
  }
  String::concat(stage, String::concat("\t", String::concat(__to_string(us / 1000), String::concat("\t", String::concat(__to_string(us), "\n")))))
}

/// Writes the check's profiling sidecars (`stage / elapsed_ms / elapsed_us`
/// TSV, the shape `scripts/test_cli_core.sh` reads). One measured stage: the
/// import-resolving check is a single call from here, so `check` and `total`
/// carry the same wall time rather than a load/type split nobody measured.
fn write_check_profiles(tsv_path: String, callstack_path: String, elapsed_us: Int) -> Unit with Fs {
  if tsv_path != "" {
    Fs::write_file(tsv_path, String::concat("stage\telapsed_ms\telapsed_us\n", String::concat(profile_stage_row("check", elapsed_us), profile_stage_row("total", elapsed_us))))
  } else {
    ()
  }
  if callstack_path != "" {
    Fs::write_file(callstack_path, String::concat("stage\telapsed_ms\telapsed_us\n", profile_stage_row("check", elapsed_us)))
  } else {
    ()
  }
}

fn selfhost_cli_user_check_args(args: Array[String]) -> Int with Exception + Fs + Env + Console + Stderr + Profiler {
  let mut missing_vpkg = false
  let mut deps_missing = false
  let mut i = 1
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if arg == "--missing-vpkg" {
      missing_vpkg = true
    } else if arg == "--deps-missing" {
      deps_missing = true
    } else {
      ()
    }
    i = i + 1
  }
  if missing_vpkg || deps_missing {
    let (root, _, _) = parse_user_check_args(args)
    user_check_scan(root, missing_vpkg)
  } else {
    let (_, single, json) = parse_user_check_args(args)
    let paths = user_check_paths(args)
    let (profile_tsv, profile_callstack) = user_check_profile_paths(args)
    // Every file must exist before any is checked: a report for the files
    // that exist would read as a complete answer to a different question.
    let mut pi = 0
    while pi < Array::length(paths) {
      if !Fs::exists(Array::get(paths, pi)) {
        throw(String::concat("not found: ", Array::get(paths, pi)))
      } else {
        ()
      }
      pi = pi + 1
    }
    // `vibe check`'s contract (AGENTS.md, #1567/#1888): the diagnostics are
    // the REPORT -- one per line on STDOUT, `error: ` framing, exit 1 -- and
    // empty stdout means clean. The lanes below raise them as an exception
    // (that is how the checker hands them back); a usage error such as a
    // missing file stays an exception and reaches stderr through the
    // dispatcher's handler, which is where the launcher printed it before.
    // Several files are checked in turn (`vibe check a.vibe b.vibe`), and
    // one failing file fails the command.
    let started_us = Profiler::now_us()
    let mut code = 0
    let mut ci = 0
    while ci < Array::length(paths) {
      let src = Array::get(paths, ci)
      let file_code = handle {
        if single {
          user_check_single(src, json)
        } else if json {
          user_check_linked_json(src)
        } else {
          user_check_linked(src)
        }
      } with { Exception::Throw(e) => {
        print(line_terminated(format_check_report(e)))
        1
      } }
      if file_code != 0 {
        code = file_code
      } else {
        ()
      }
      ci = ci + 1
    }
    // `--profile-tsv` / `--profile-callstack` (Codex review of #2858): the
    // sidecars are written for a failed check too -- a profile of a check
    // that found errors is still a profile of that check.
    write_check_profiles(profile_tsv, profile_callstack, Profiler::now_us() - started_us)
    code
  }
}

//# compile / build

/// `(input, output, entry, wit, minify, component)`.
///
/// `component` is its own field rather than a mode: `--component` selects a
/// DIFFERENT COMPILE LANE (`command_component_compile_mode()`) and a different
/// artifact (a Component Model binary wrapping the core), so folding it into
/// the wit/minify booleans would lose the refusals below.
export fn parse_user_compile_args(args: Array[String]) -> (String, String, String, Bool, Bool, Bool) with Exception {
  if Array::length(args) == 0 {
    throw("compile: expected command")
  } else {
    let cmd = Array::get(args, 0)
    if cmd != "compile" && cmd != "build" {
      throw("compile: expected command")
    } else {
      let mut src = ""
      let mut out = ""
      let mut entry = "main"
      let mut entry_override = false
      let mut wit = false
      let mut component = false
      let mut minify = false
      let mut i = 1
      while i < Array::length(args) {
        let arg = Array::get(args, i)
        if arg == "-o" || arg == "--output" || arg == "--out" {
          i = i + 1
          out = need_value(args, i, cmd, arg)
          ()
        } else if arg == "--entry" {
          i = i + 1
          entry = need_value(args, i, cmd, arg)
          entry_override = true
          ()
        } else if arg == "--wit" {
          wit = true
          ()
        } else if arg == "--component" {
          component = true
          ()
        } else if arg == "--minify" {
          minify = true
          ()
        } else if arg == "--jobs" {
          i = i + 1
          let _ = parse_jobs_value(need_value(args, i, cmd, arg))
          ()
        } else if arg == "--wasm" || arg == "--wasm-linear" || arg == "--release" {
          ()
        } else if arg == "--debug" {
          ()
        } else if String::length(arg) > 0 && String::byte_at(arg, 0) == 45 {
          throw(String::concat(cmd, String::concat(": unknown option: ", arg)))
        } else if src == "" {
          src = arg
          ()
        } else {
          throw(String::concat(cmd, ": too many input files"))
        }
        i = i + 1
      }
      if src == "" {
        throw(String::concat("usage: vibe ", String::concat(cmd, " <file.vibe|file.vibex> [-o <out.wasm>] [--entry <name>] [--wit] [--component] [--minify] [--jobs N]")))
      } else if is_vibex_path(src) && entry_override {
        throw(".vibex entry is always main; --entry is not allowed")
      } else if wit && is_vibex_path(src) {
        throw("--wit for .vibex requires semantic contract emission")
      } else if component && wit {
        throw("--component and --wit produce different artifacts from the same file; run them separately")
      } else if component && entry_override {
        throw("--component has no command entry; its surface is the lifted `run` export, so --entry is not allowed")
      } else if component && minify {
        // vibe-opt optimizes CORE modules; running it over a component binary
        // is a different operation and is not wired.
        throw("--component and --minify cannot be combined: the minifier takes a core module, not a component")
      } else if component && is_vibex_path(src) {
        // A `.vibex` is an executable root with NO export surface (ADR-0075,
        // #2229), so it can never carry the `export fn vibe_command` a command
        // component is made of. Refused here rather than deep in compilation,
        // where the message would be about exports and never mention
        // `--component`.
        throw("--component needs a .vibe module: a .vibex is an executable root with no export surface, and a command component is built from `export fn vibe_command(args: String) -> String`")
      } else {
        let resolved_entry = if component {
          // Shared with the `.vibex` CLI door, so the same flag cannot mean two
          // different entries depending on which front door was used (#2863).
          command_component_entry()
        } else if is_vibex_path(src) {
          "main"
        } else {
          entry
        }
        let resolved_out = if out == "" {
          if wit {
            String::concat(".vibe/build/out/", String::concat(basename_of(strip_vibe_suffix(src)), ".wit"))
          } else if component {
            String::concat(".vibe/build/out/", String::concat(basename_of(strip_vibe_suffix(src)), ".component.wasm"))
          } else {
            String::concat(".vibe/build/out/", String::concat(basename_of(strip_vibe_suffix(src)), ".wasm"))
          }
        } else {
          out
        }
        (src, resolved_out, resolved_entry, wit, minify, component)
      }
    }
  }
}

/// The export name a command component lifts. `runtime/viberun`'s command
/// loader looks it up by name; the vibe function BEHIND it is
/// `command_component_entry()`.
fn user_command_component_export() -> String {
  "run"
}

/// The wrap's own message names what it found in the core; this adds the edit,
/// which is what the reader is missing when the core has no command entry.
fn user_command_component_edit(input_path: String, entry: String, message: String) -> String {
  "build --component \{input_path}: \{message}; a command module exports exactly `export fn \{entry}(args: String) -> String` and returns the `vibe-command-result-v1` frame (`command_ok` / `command_result` in @vibe/command)"
}

fn emit_user_command_component(core: Bytes, input_path: String) -> Bytes with Exception {
  let entry = command_component_entry()
  handle {
    comp_emit_component_wasm_command(core, entry, user_command_component_export())
  } with { Exception::Throw(message) => throw(user_command_component_edit(input_path, entry, message)) }
}

fn args_has_flag(args: Array[String], flag: String) -> Bool {
  let mut i = 1
  let mut found = false
  while i < Array::length(args) {
    if Array::get(args, i) == flag {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn selfhost_cli_user_compile_args(args: Array[String]) -> Int with Exception + Fs + Env + Console {
  let (src, out, entry, wit, minify, component) = parse_user_compile_args(args)
  // `--debug` is the linked debug lane docs/user/reference/cli-commands.md
  // documents for `vibe build`: library modules cached as linked wasm files,
  // only the entry recompiled. The parser accepted the flag and this function
  // then built the release artifact regardless (Codex review of #2858) -- a
  // release binary reported as a debug build is the silent kind of wrong.
  let debug = args_has_flag(args, "--debug")
  let out_given = args_has_flag(args, "-o") || args_has_flag(args, "--output") || args_has_flag(args, "--out")
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else if debug && (component || wit || minify) {
    throw("--debug selects the linked debug lane and cannot be combined with --component, --wit or --minify")
  } else if debug {
    let resolved = resolve_user_build_output(out, out_given)
    ensure_parent_dir(resolved)
    // The GATED builder checks the closure its own compile ingested, so the
    // verdict covers exactly the bytes it writes (#2305, Codex review).
    reject_unstable_entry_surface(src)
    write_linked_debug_build_checked(src, resolved, entry, unstable_opt_in())
    println(String::concat("compiled (debug) ", String::concat(src, String::concat(" -> ", display_under_root(resolved, default_build_dir())))))
    0
  } else if component {
    let resolved = resolve_user_build_output(out, out_given)
    // The `dce-root` lane prunes from the command entry, so a module with no
    // `vibe_command` export compiles to nothing and the compiler says so in
    // its own words. The reader needs the EDIT -- the signature and the
    // result frame -- which is what `user_command_component_edit` adds
    // (scripts/test_component_lazy_dispatch_gate.sh asserts both). Other
    // refusals (an unstable import, a type error) keep their own message.
    let core = handle {
      compile_user_artifact(src, entry, "component", no_grants())
    } with { Exception::Throw(message) => {
      if String::contains(message, "no functions found to compile") {
        throw(user_command_component_edit(src, entry, "the module has no `\{entry}` export (\{message})"))
      } else {
        throw(message)
      }
    } }
    write_wasm(resolved, emit_user_command_component(core, src))
    println(String::concat("component ", String::concat(src, String::concat(" -> ", display_under_root(resolved, default_build_dir())))))
    0
  } else if wit {
    let resolved = resolve_user_build_output(out, out_given)
    let stmts = parse_user_entry_file(src)
    ensure_parent_dir(resolved)
    Fs::write_file(resolved, wit_from_program(stmts, stmts, basename_of(strip_vibe_suffix(src))))
    println(String::concat("wit ", String::concat(src, String::concat(" -> ", display_under_root(resolved, default_build_dir())))))
    0
  } else {
    let resolved = resolve_user_build_output(out, out_given)
    let bytes = compile_user_artifact(src, entry, "mvp", no_grants())
    write_user_executable(resolved, bytes, entry, "mvp")
    println(String::concat("compiled ", String::concat(src, String::concat(" -> ", display_under_root(resolved, default_build_dir())))))
    if minify {
      let action = Env::get("VIBE_HOST_ACTION_OUT")
      write_host_action(action, String::concat("vibe-host-action-v1\nminify\n", String::concat(resolved, "\n")))
    } else {
      0
    }
  }
}

//# fmt / normalize

export fn parse_user_fmt_args(args: Array[String]) -> (String, String) with Exception {
  if Array::length(args) == 0 || Array::get(args, 0) != "fmt" {
    throw("vibe fmt: expected command")
  } else {
    let mut mode = "write"
    let mut src = ""
    let mut i = 1
    while i < Array::length(args) {
      let arg = Array::get(args, i)
      if arg == "--check" {
        mode = "check"
        ()
      } else if arg == "--stdout" {
        mode = "stdout"
        ()
      } else if String::length(arg) > 0 && String::byte_at(arg, 0) == 45 {
        throw(String::concat("vibe fmt: unknown flag: ", arg))
      } else if src == "" {
        src = arg
        ()
      } else {
        throw("vibe fmt: takes ONE file")
      }
      i = i + 1
    }
    if src == "" {
      throw("usage: vibe fmt [--check|--stdout] <file.vibe>")
    } else {
      (src, mode)
    }
  }
}

fn selfhost_cli_user_fmt_args(args: Array[String]) -> Int with Exception + Fs + Console {
  let (src, mode) = parse_user_fmt_args(args)
  if !Fs::exists(src) {
    throw(String::concat("not found: ", src))
  } else {
    let raw = Fs::read_file(src)
    let pre = fill_require_pins_lenient(raw)
    let formatted = format_source(src, pre)
    let is_vpkg = path_has_suffix(src, ".vpkg")
    let head_end = if is_vpkg {
      0
    } else {
      let e = source_header_end(pre)
      if e > 0 {
        e
      } else {
        0
      }
    }
    let body = String::substring(pre, head_end, String::length(pre))
    let formatted_body = String::substring(formatted, head_end, String::length(formatted))
    if !is_vpkg {
      let err = parse_error_of(body)
      if String::length(err) > 0 {
        throw(String::concat("vibe fmt: refusing to format ", String::concat(src, String::concat(": it does not parse\n  ", err))))
      } else if !program_parses(formatted_body) {
        throw(String::concat("vibe fmt: refusing to rewrite ", src))
      } else {
        ()
      }
    } else {
      ()
    }
    if mode == "stdout" {
      print(formatted)
      0
    } else if mode == "check" {
      if raw == formatted {
        0
      } else {
        println(String::concat("not formatted: ", src))
        1
      }
    } else {
      if raw != formatted {
        Fs::write_file(src, formatted)
      } else {
        ()
      }
      0
    }
  }
}

