        mode = "check"
        ()
      } else if arg == "--stdout" {
        mode = "stdout"
        ()
      } else if String::length(arg) > 0 && String::byte_at(arg, 0) == 45 {
        throw(String::concat("vibe normalize: unknown flag: ", arg))
      } else if src == "" {
        src = arg
        ()
      } else {
        throw("vibe normalize: takes ONE file")
      }
      i = i + 1
