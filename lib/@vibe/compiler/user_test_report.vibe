//# `vibe test-report` — the condensed failure report under `FAIL <file>`
//# (#3674), and the `[vibe-test]` summary (#3703). The launcher's `vibe test`
//# calls it when a test file traps and once at the end of a run; the report
//# is @vibe/testreport and the summary @vibe/testrun, which
//# scripts/vibe_test.sh reaches through scripts/test_report.vibex.
//#
//#   vibe test-report launcher <stderr> <funcmap> <base> <pre_abort 0|1>
//#   vibe test-report script   <stdout> <stderr> <funcmap> <base> <source>
//#   vibe test-report summary  <results>
//#
//# `<results>` holds one @vibe/testrun result record per file that ran. The
//# summary mode only prints: the launcher keeps the run's exit status.
//#
//# File arguments are paths; one that does not exist reads as empty. A `--`
//# after the mode is accepted and dropped: the launcher passes it so that
//# `<base>` (a bare file name) is not rewritten as a path relative to the
//# directory `vibe` was invoked from.

//# Imports

import @vibe/testreport {
  launcher_trap_report, script_failure_report
}

import @vibe/testrun {
  test_run_summary
}

//# Functions

fn report_input(_ path: String) -> String with Fs {
  if path != "" && Fs::is_file(path) {
    Fs::read_file(path)
  } else {
    ""
  }
}

/// The records in a results file, one per non-empty line.
fn result_records(_ text: String) -> Array[String] {
  let out: Array[String] = []
  let lines = String::split(text, sep = "\n")
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, at = i)
    if line != "" {
      Array::push(out, value = String::concat(line, "\n"))
    } else ()
    i = i + 1
  }
  out
}

/// `vibe test-report <launcher|script|summary> ...`: print the report, exit 0.
export fn selfhost_cli_user_test_report_args(_ argv: Array[String]) -> Int with Exception + Fs + Console {
  let usage = "usage: vibe test-report launcher <stderr> <funcmap> <base> <pre_abort 0|1> | script <stdout> <stderr> <funcmap> <base> <source> | summary <results>"
  let args: Array[String] = []
  let mut i = 0
  while i < Array::length(argv) {
    if !(i == 2 && Array::get(argv, at = i) == "--") {
      Array::push(args, value = Array::get(argv, at = i))
    } else ()
    i = i + 1
  }
  let mode = if Array::length(args) > 1 {
    Array::get(args, at = 1)
  } else {
    ""
  }
  if mode == "launcher" && Array::length(args) == 6 {
    print(launcher_trap_report(stderr = report_input(Array::get(args, at = 2)), funcmap = report_input(Array::get(args, at = 3)), base = Array::get(args, at = 4), pre_abort = Array::get(args, at = 5) == "1"))
    0
  } else if mode == "script" && Array::length(args) == 7 {
    print(script_failure_report(stdout = report_input(Array::get(args, at = 2)), stderr = report_input(Array::get(args, at = 3)), funcmap = report_input(Array::get(args, at = 4)), base = Array::get(args, at = 5), source = report_input(Array::get(args, at = 6))))
    0
  } else if mode == "summary" && Array::length(args) == 3 {
    let records = result_records(report_input(Array::get(args, at = 2)))
    print(test_run_summary(records = records, files = Array::length(records), compile_fails = 0, coverage = false, seed_default = false, seed = "", covdir = ""))
    0
  } else {
    throw(usage)
  }
}
