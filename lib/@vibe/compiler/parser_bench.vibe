//# Imports

import ./parser_hotspot_probe.vibe {
  probe_parse_checker_vibe,
  probe_parse_deep_binop_chain,
  probe_parse_expr_tokens_repeat_count,
  probe_parse_lexer_vibe,
  probe_parse_parser_vibe,
  probe_parse_stmt_tokens_repeat_count,
  probe_parse_tokens_count,
  probe_parse_type_tokens_repeat_count,
  probe_parse_wide_match
}

import @vibe/compiler/syntax {
  Token, lex
}
//# Setup

let empty_tokens: Array[Token] = [
  TEof
]

let lexer_vibe_tokens: Array[Array[Token]] = [
  empty_tokens
]
let checker_vibe_tokens: Array[Array[Token]] = [
  empty_tokens
]
let parser_vibe_tokens: Array[Array[Token]] = [
  empty_tokens
]
let stmt_let_if_tokens: Array[Array[Token]] = [
  empty_tokens
]
let type_fn_app_tokens: Array[Array[Token]] = [
  empty_tokens
]
let expr_infix_chain_tokens: Array[Array[Token]] = [
  empty_tokens
]
let expr_call_postfix_tokens: Array[Array[Token]] = [
  empty_tokens
]
let expr_match_tokens: Array[Array[Token]] = [
  empty_tokens
]

fn ensure_file_tokens(box: Array[Array[Token]], path: String) -> Array[Token] with Error + Fs {
  let current = box[0]
  if Array::length(current) == 1 {
    let tokens = lex(Fs::read_file(path))
    box[0] = tokens
    tokens
  } else {
    current
  }
}

fn ensure_source_tokens(box: Array[Array[Token]], source: String) -> Array[Token] with Error {
  let current = box[0]
  if Array::length(current) == 1 {
    let tokens = lex(source)
    box[0] = tokens
    tokens
  } else {
    current
  }
}

//# Benches

bench "parse_lexer_vibe" {
  let _ = handle {
    probe_parse_lexer_vibe()
  } with Error {
    Throw(_) => 0
  }
}

bench "parse_checker_vibe" {
  let _ = handle {
    probe_parse_checker_vibe()
  } with Error {
    Throw(_) => 0
  }
}

bench "parse_parser_vibe" {
  let _ = handle {
    probe_parse_parser_vibe()
  } with Error {
    Throw(_) => 0
  }
}

bench "parse_only_lexer_vibe" {
  let _ = handle {
    probe_parse_tokens_count(ensure_file_tokens(lexer_vibe_tokens, "lib/@vibe/parser/lexer.vibe"))
  } with Error {
    Throw(_) => 0
  }
}

bench "parse_only_checker_vibe" {
  let _ = handle {
    probe_parse_tokens_count(ensure_file_tokens(checker_vibe_tokens, "lib/@vibe/compiler/checker/checker.vibe"))
  } with Error {
    Throw(_) => 0
  }
}

bench "parse_only_parser_vibe" {
  let _ = handle {
    probe_parse_tokens_count(ensure_file_tokens(parser_vibe_tokens, "lib/@vibe/parser/parser.vibe"))
  } with Error {
    Throw(_) => 0
  }
}

bench "parse_deep_binop_chain" {
  let _ = handle {
    probe_parse_deep_binop_chain()
  } with Error {
    Throw(_) => 0
  }
}

bench "parse_stmt_let_if" {
  let _ = handle {
    probe_parse_stmt_tokens_repeat_count(ensure_source_tokens(stmt_let_if_tokens, "let x = if 1 < 2 { 3 } else { 4 }\n"), 64)
  } with Error {
    Throw(_) => 0
  }
}

bench "parse_type_fn_app" {
  let _ = handle {
    probe_parse_type_tokens_repeat_count(ensure_source_tokens(type_fn_app_tokens, "(Int, String, Array[Int]) -> Option[Int]"), 64)
  } with Error {
    Throw(_) => 0
  }
}

bench "parse_expr_infix_chain" {
  let _ = handle {
    probe_parse_expr_tokens_repeat_count(ensure_source_tokens(expr_infix_chain_tokens, "1 + 2 * 3 - 4 / 5 + 6 << 1 == 10"), 64)
  } with Error {
    Throw(_) => 0
  }
}

bench "parse_expr_call_postfix" {
  let _ = handle {
    probe_parse_expr_tokens_repeat_count(ensure_source_tokens(expr_call_postfix_tokens, "foo(1, bar(2), arr[0], arr[1:3], obj.field)"), 64)
  } with Error {
    Throw(_) => 0
  }
}

bench "parse_expr_match" {
  let _ = handle {
    probe_parse_expr_tokens_repeat_count(ensure_source_tokens(expr_match_tokens, "match 0 { 0 => 100, 1 => 101, 2 => 102, _ => 999 }"), 64)
  } with Error {
    Throw(_) => 0
  }
}

bench "parse_wide_match" {
  let _ = handle {
    probe_parse_wide_match()
  } with Error {
    Throw(_) => 0
  }
}
