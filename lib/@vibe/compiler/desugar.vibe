//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

import @vibe/core {
  array_empty
}

//# Functions

fn prepend_expr(first: Expr, rest: Array[Expr]) -> Array[Expr] {
  let out = array_empty()
  Array::push(out, first)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, Array::get(rest, i))
    i = i + 1
  }
  out
}

fn empty_expr_array() -> Array[Expr] {
  array_empty()
}

fn desugar_pat(pat: Pat) -> Pat {
  match pat {
    PStruct(_, fields) => {
      // NOTE: the parser does not support tuple destructuring in the
      // for-in loop variable (`for (_, fpat) in fields`), so we extract
      // the inner pattern inside the loop body instead.
      let pats = for field in fields {
        let (_, fpat) = field
        desugar_pat(fpat)
      }
      PTuple(pats)
    },
    PCtor(name, args) => PCtor(name, for a in args {
      desugar_pat(a)
    }),
    PTuple(items) => PTuple(for item in items {
      desugar_pat(item)
    }),
    POr(a, b) => POr(desugar_pat(a), desugar_pat(b)),
    _ => pat
  }
}

export fn desugar_expr(expr: Expr) -> Expr {
  match expr {
    EBinOp(op, left, right) => if op == "|>" {
      let dl = desugar_expr(left)
      let dr = desugar_expr(right)
      match dr {
        ECall(callee, args, off) => ECall(callee, prepend_expr(dl, args), off),
        _ => ECall(dr, [dl], -1)
      }
    } else {
      EBinOp(op, desugar_expr(left), desugar_expr(right))
    }
    ,
    ECall(callee, args, off) => {
      let desugared_args = for a in args {
        desugar_expr(a)
      }
      match callee {
        EDot(obj, method_name, dot_off, fdoff) => ECall(EDot(desugar_expr(obj), method_name, dot_off, fdoff), desugared_args, off),
        _ => ECall(desugar_expr(callee), desugared_args, off)
      }
    },
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EIdent(_, _) => expr,
    EUnit => expr,
    ETuple(elems) => ETuple(for e in elems {
      desugar_expr(e)
    }),
    EArray(elems) => {
      let has_spread = {
        let mut found = false
        let mut si = 0
        while si < Array::length(elems) {
          match Array::get(elems, si) {
            ESpread(_) => {
              found = true; si = Array::length(elems)
            },
            _ => {
              si = si + 1
            }
          }
          si
        }
        found
      }
      if has_spread {
        let segments = array_empty()
        let mut buf = empty_expr_array()
        let mut si = 0
        while si < Array::length(elems) {
          let elem = Array::get(elems, si)
          match elem {
            ESpread(inner) => {
              if Array::length(buf) > 0 {
                Array::push(segments, EArray(for e in buf {
                  desugar_expr(e)
                }))
                buf = empty_expr_array()
              }
              Array::push(segments, desugar_expr(inner))
            },
            _ => Array::push(buf, elem)
          }
          si = si + 1
        }
        if Array::length(buf) > 0 {
          Array::push(segments, EArray(for e in buf {
            desugar_expr(e)
          }))
        }
        let mut acc = Array::get(segments, 0)
        let mut fi = 1
        while fi < Array::length(segments) {
          acc = ECall(EIdent("Array::concat", -1), [
            acc,
            Array::get(segments, fi)
          ], -1)
          fi = fi + 1
        }
        acc
      } else {
        EArray(for e in elems {
          desugar_expr(e)
        })
      }
    },
    ERecord(rn, fields, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fval) = Array::get(fields, i)
        Array::push(out, (fname, desugar_expr(fval)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EIf(cond, then_e, else_e) => EIf(desugar_expr(cond), desugar_expr(then_e), desugar_expr(else_e)),
    ELet(name, val, body, soff) => ELet(name, desugar_expr(val), desugar_expr(body), soff),
    ELetRec(name, val, body) => ELetRec(name, desugar_expr(val), desugar_expr(body)),
    ELetMut(name, val, body, soff) => ELetMut(name, desugar_expr(val), desugar_expr(body), soff),
    EAssign(name, val, cont) => EAssign(name, desugar_expr(val), desugar_expr(cont)),
    EAssignOp(name, op, val, cont) => EAssignOp(name, op, desugar_expr(val), desugar_expr(cont)),
    ESeq(a, b) => ESeq(desugar_expr(a), desugar_expr(b)),
    EMatch(scrutinee, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        Array::push(out, (desugar_pat(p), desugar_expr(b)))
        i = i + 1
      }
      EMatch(desugar_expr(scrutinee), out)
    },
    EHandle(scrutinee, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        Array::push(out, (p, desugar_expr(b)))
        i = i + 1
      }
      EHandle(desugar_expr(scrutinee), out)
    },
    EWhile(cond, body) => EWhile(desugar_expr(cond), desugar_expr(body)),
    ELoop(params, body) => ELoop(for param in params {
      let (name, init) = param; (name, desugar_expr(init))
    }, desugar_expr(body)),
    EForIn(name, index_name, iter, body) => EForIn(name, index_name, desugar_expr(iter), desugar_expr(body)),
    EUnaryOp(op, operand) => EUnaryOp(op, desugar_expr(operand)),
    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(type_params, bounds, params, ret_ty, effect, desugar_expr(body)),
    EDot(obj, field, off, fdoff) => EDot(desugar_expr(obj), field, off, fdoff),
    ELabeledArg(label, name, body) => ELabeledArg(label, name, desugar_expr(body)),
    EReturn(e) => EReturn(desugar_expr(e)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(desugar_expr(e))),
      None => expr
    },
    EContinue(exprs) => EContinue(for e in exprs {
      desugar_expr(e)
    }),
    EMap(fields) => {
      let out = array_empty()
      let mut mi = 0
      while mi < Array::length(fields) {
        let (k, v) = Array::get(fields, mi)
        Array::push(out, (k, desugar_expr(v)))
        mi = mi + 1
      }
      EMap(out)
    },
    ESpread(_) => expr,
    EStringInterp(_) => expr
  }
}

export fn desugar_stmt(stmt: Stmt) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, name, ty, desugar_expr(body)),
    // SFnDecl never reaches this pass on the default pipeline (parse_stmt /
    // parse_program lower it to SLet first); handled for exhaustiveness and
    // for callers feeding preserved ASTs.
    SFnDecl(exported, name, fn_value, reqs, enss) => SFnDecl(exported, name, desugar_expr(fn_value), for r in reqs {
      desugar_expr(r)
    }, for e in enss {
      desugar_expr(e)
    }),
    SLetMut(name, ty, body) => SLetMut(name, ty, desugar_expr(body)),
    STest(name, body) => STest(name, desugar_expr(body)),
    SBench(name, body) => SBench(name, desugar_expr(body)),
    // #1455: this arm was MISSING and nothing caught it -- `Stmt` arrives here
    // by import, and until an imported enum's variant list reached the
    // importing module the exhaustiveness check had no definition to check
    // against and skipped the match entirely. With no catch-all below, a
    // doctest `example` block reaching this pass trapped at runtime instead of
    // having its body desugared. `parser_expr.vibe` lowers SExample to STest,
    // so the body is an ordinary expression and is desugared the same way.
    SExample(name, body) => SExample(name, desugar_expr(body)),
    SExpr(e) => SExpr(desugar_expr(e)),
    SModule(exported, name, stmts) => SModule(exported, name, for s in stmts {
      desugar_stmt(s)
    }),
    SEnum(_, _, _, _, _) => stmt,
    SSuberror(_, _, _) => stmt,
    SEffectDef(_, _, _, _) => stmt,
    SEffectSet(_, _, _) => stmt,
    SStruct(_, _, _, _, _, _) => stmt,
    STypeAlias(_, _, _, _) => stmt,
    STrait(_, _, _, _, _, _) => stmt,
    SImpl(_, _, _, _) => stmt,
    SExternLet(_, _) => stmt,
    SImport(_, _) => stmt,
    SExport(_) => stmt,
    SReExport(_, _) => stmt,
    SAliasDecl(_, _) => stmt,
    SReExportLocalBlockers(_) => stmt,
    SLetPat(pat, expr) => SLetPat(pat, desugar_expr(expr)),
    // ADR-0075 Phase 2 (#1343): a resource declaration has no expression to
    // desugar. This match has no catch-all, so the arm is required.
    SResource(_, _) => stmt,
    // #1455 step 3: parser bookkeeping (the `Enum::Variant` pattern qualifiers
    // this parse saw). No expression, nothing to desugar -- and unlike the
    // qualifier-in-`Pat` design this replaced, passing it through unchanged IS
    // the right answer for every consumer except check_program. This match has
    // no catch-all, which is why the variant surfaced here as a build error
    // rather than being silently dropped.
    SQualifiedPatternRefs(_) => stmt,
    STestEffectRows(_) => stmt
  }
}

export fn desugar_stmts(stmts: Array[Stmt]) -> Array[Stmt] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SLetPat(PStruct(_, fields), expr) => {
        let de = desugar_expr(expr)
        let tmp_name = "__struct_tmp"
        Array::push(out, SLet(false, false, tmp_name, None, de))
        let mut fi = 0
        while fi < Array::length(fields) {
          let (fname, fpat) = Array::get(fields, fi)
          match fpat {
            PBind(bname) => {
              Array::push(out, SLet(false, false, bname, None, EDot(EIdent(tmp_name, -1), fname, -1, -1)))
            },
            _ => Array::push(out, desugar_stmt(stmt))
          }
          fi = fi + 1
        }
      },
      _ => Array::push(out, desugar_stmt(stmt))
    }
    i = i + 1
  }
  out
}
