//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

import @vibe/core {
  array_empty
}

//# Functions

fn empty_strings() -> Array[String] {
  array_empty()
}

fn empty_warnings() -> Array[(String, String, String)] {
  array_empty()
}

fn warning_array_contains_str(arr: Array[String], s: String) -> Bool {
  let len = Array::length(arr)
  let mut i = 0
  let mut found = false
  while i < len {
    if Array::get(arr, at = i) == s {
      found = true
      i = len
    } else {
      i = i + 1
    }
  }
  found
}

export fn detect_shadows(_ stmts: Array[Stmt]) -> Array[(String, String, String)] {
  let seen = empty_strings()
  let out = empty_warnings()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    match stmt {
      SLet(_, _, name, _, _) => {
        if warning_array_contains_str(arr = seen, s = name) {
          let msg = String::concat("variable '", String::concat(name, "' shadows a previous binding"))
          Array::push(out, value = ("shadow", name, msg))
        } else {
          Array::push(seen, value = name)
        }
        0
      },
      SLetMut(name, _, _) => {
        if warning_array_contains_str(arr = seen, s = name) {
          let msg = String::concat("variable '", String::concat(name, "' shadows a previous binding"))
          Array::push(out, value = ("shadow", name, msg))
        } else {
          Array::push(seen, value = name)
        }
        0
      },
      _ => 0
    }
    i = i + 1
  }
  out
}

export fn collect_defined_names(_ stmts: Array[Stmt]) -> Array[String] {
  let out = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    match stmt {
      SLet(_, _, name, _, _) => {
        Array::push(out, value = name)
        0
      },
      SLetMut(name, _, _) => {
        Array::push(out, value = name)
        0
      },
      _ => 0
    }
    i = i + 1
  }
  out
}

fn starts_with_underscore(_ s: String) -> Bool {
  if String::length(s) == 0 {
    false
  }
  else {
    String::char_code_at(s, at = 0) == 95
  }
}

fn collect_used_names_expr(expr: Expr, out: Array[String]) -> Int {
  match expr {
    EIdent(name, _) => {
      if not(warning_array_contains_str(arr = out, s = name)) {
        Array::push(out, value = name)
      }
      0
    },
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_, _) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EBreak(_) => 0,
    EContinue(_) => 0,
    EReturn(e) => collect_used_names_expr(expr = e, out = out),
    EUnaryOp(_, e) => collect_used_names_expr(expr = e, out = out),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_used_names_expr(expr = Array::get(items, at = i), out = out)
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_used_names_expr(expr = Array::get(items, at = i), out = out)
        i = i + 1
      }
      0
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, at = i)
        collect_used_names_expr(expr = val, out = out)
        i = i + 1
      }
      0
    },
    EBinOp(_, l, r, _) => {
      collect_used_names_expr(expr = l, out = out)
      collect_used_names_expr(expr = r, out = out)
      0
    },
    ECall(callee, args, _, _) => {
      collect_used_names_expr(expr = callee, out = out)
      let mut i = 0
      while i < Array::length(args) {
        collect_used_names_expr(expr = Array::get(args, at = i), out = out)
        i = i + 1
      }
      0
    },
    EIf(cond, then_e, else_e) => {
      collect_used_names_expr(expr = cond, out = out)
      collect_used_names_expr(expr = then_e, out = out)
      collect_used_names_expr(expr = else_e, out = out)
      0
    },
    ELet(_, val, body, _) => {
      collect_used_names_expr(expr = val, out = out)
      collect_used_names_expr(expr = body, out = out)
      0
    },
    ELetRec(_, val, body) => {
      collect_used_names_expr(expr = val, out = out)
      collect_used_names_expr(expr = body, out = out)
      0
    },
    ELetMut(_, val, body, _) => {
      collect_used_names_expr(expr = val, out = out)
      collect_used_names_expr(expr = body, out = out)
      0
    },
    EAssign(_, val, body, _) => {
      collect_used_names_expr(expr = val, out = out)
      collect_used_names_expr(expr = body, out = out)
      0
    },
    EAssignOp(_, _, val, body, _) => {
      collect_used_names_expr(expr = val, out = out)
      collect_used_names_expr(expr = body, out = out)
      0
    },
    ESeq(l, r) => {
      collect_used_names_expr(expr = l, out = out)
      collect_used_names_expr(expr = r, out = out)
      0
    },
    EMatch(scr, arms) => {
      collect_used_names_expr(expr = scr, out = out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, body) = Array::get(arms, at = i)
        collect_used_names_expr(expr = body, out = out)
        i = i + 1
      }
      0
    },
    EHandle(body_expr, arms) => {
      collect_used_names_expr(expr = body_expr, out = out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, at = i)
        collect_used_names_expr(expr = arm_body, out = out)
        i = i + 1
      }
      0
    },
    EWhile(cond, body) => {
      collect_used_names_expr(expr = cond, out = out)
      collect_used_names_expr(expr = body, out = out)
      0
    },
    ELoop(params, body) => {
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, at = i)
        collect_used_names_expr(expr = init, out = out)
        i = i + 1
      }
      collect_used_names_expr(expr = body, out = out)
      0
    },
    EForIn(_, _, iter, body, _) => {
      collect_used_names_expr(expr = iter, out = out)
      collect_used_names_expr(expr = body, out = out)
      0
    },
    EFn(_, _, _, _, _, body) => {
      collect_used_names_expr(expr = body, out = out)
      0
    },
    EDot(obj, _, _, _) => {
      collect_used_names_expr(expr = obj, out = out)
      0
    },
    ELabeledArg(_, _, e) => {
      collect_used_names_expr(expr = e, out = out)
      0
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, at = i)
        collect_used_names_expr(expr = val, out = out)
        i = i + 1
      }
      0
    },
    ESpread(e) => {
      collect_used_names_expr(expr = e, out = out)
      0
    },
    EStringInterp(_) => 0
  }
}

export fn collect_used_names(_ expr: Expr) -> Array[String] {
  let out = empty_strings()
  collect_used_names_expr(expr = expr, out = out)
  out
}

export fn collect_used_names_stmts(_ stmts: Array[Stmt]) -> Array[String] {
  let out = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    match stmt {
      SLet(_, _, _, _, expr) => collect_used_names_expr(expr = expr, out = out),
      SLetMut(_, _, expr) => collect_used_names_expr(expr = expr, out = out),
      SExpr(expr) => collect_used_names_expr(expr = expr, out = out),
      STest(_, expr) => collect_used_names_expr(expr = expr, out = out),
      SBench(_, expr) => collect_used_names_expr(expr = expr, out = out),
      _ => 0
    }
    i = i + 1
  }
  out
}

export fn detect_unused_vars(_ stmts: Array[Stmt]) -> Array[(String, String, String)] {
  let defined = collect_defined_names(stmts)
  let used = collect_used_names_stmts(stmts)
  let out = empty_warnings()
  let mut i = 0
  while i < Array::length(defined) {
    let name = Array::get(defined, at = i)
    if not(starts_with_underscore(name)) {
      if not(warning_array_contains_str(arr = used, s = name)) {
        let msg = String::concat("variable '", String::concat(name, "' is defined but never used"))
        Array::push(out, value = ("unused_var", name, msg))
      }
    }
    i = i + 1
  }
  out
}

fn collect_assign_targets_expr(expr: Expr, out: Array[String]) -> Int {
  match expr {
    EAssign(name, val, body, _) => {
      if not(warning_array_contains_str(arr = out, s = name)) {
        Array::push(out, value = name)
      }
      collect_assign_targets_expr(expr = val, out = out)
      collect_assign_targets_expr(expr = body, out = out)
      0
    },
    EAssignOp(name, _, val, body, _) => {
      if not(warning_array_contains_str(arr = out, s = name)) {
        Array::push(out, value = name)
      }
      collect_assign_targets_expr(expr = val, out = out)
      collect_assign_targets_expr(expr = body, out = out)
      0
    },
    EIdent(_, _) => 0,
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_, _) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EBreak(_) => 0,
    EContinue(_) => 0,
    EReturn(e) => collect_assign_targets_expr(expr = e, out = out),
    EUnaryOp(_, e) => collect_assign_targets_expr(expr = e, out = out),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_assign_targets_expr(expr = Array::get(items, at = i), out = out)
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_assign_targets_expr(expr = Array::get(items, at = i), out = out)
        i = i + 1
      }
      0
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, at = i)
        collect_assign_targets_expr(expr = val, out = out)
        i = i + 1
      }
      0
    },
    EBinOp(_, l, r, _) => {
      collect_assign_targets_expr(expr = l, out = out)
      collect_assign_targets_expr(expr = r, out = out)
      0
    },
    ECall(callee, args, _, _) => {
      collect_assign_targets_expr(expr = callee, out = out)
      let mut i = 0
      while i < Array::length(args) {
        collect_assign_targets_expr(expr = Array::get(args, at = i), out = out)
        i = i + 1
      }
      0
    },
    EIf(cond, then_e, else_e) => {
      collect_assign_targets_expr(expr = cond, out = out)
      collect_assign_targets_expr(expr = then_e, out = out)
      collect_assign_targets_expr(expr = else_e, out = out)
      0
    },
    ELet(_, val, body, _) => {
      collect_assign_targets_expr(expr = val, out = out)
      collect_assign_targets_expr(expr = body, out = out)
      0
    },
    ELetRec(_, val, body) => {
      collect_assign_targets_expr(expr = val, out = out)
      collect_assign_targets_expr(expr = body, out = out)
      0
    },
    ELetMut(_, val, body, _) => {
      collect_assign_targets_expr(expr = val, out = out)
      collect_assign_targets_expr(expr = body, out = out)
      0
    },
    ESeq(l, r) => {
      collect_assign_targets_expr(expr = l, out = out)
      collect_assign_targets_expr(expr = r, out = out)
      0
    },
    EMatch(scr, arms) => {
      collect_assign_targets_expr(expr = scr, out = out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, body) = Array::get(arms, at = i)
        collect_assign_targets_expr(expr = body, out = out)
        i = i + 1
      }
      0
    },
    EHandle(body_expr, arms) => {
      collect_assign_targets_expr(expr = body_expr, out = out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, at = i)
        collect_assign_targets_expr(expr = arm_body, out = out)
        i = i + 1
      }
      0
    },
    EWhile(cond, body) => {
      collect_assign_targets_expr(expr = cond, out = out)
      collect_assign_targets_expr(expr = body, out = out)
      0
    },
    ELoop(params, body) => {
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, at = i)
        collect_assign_targets_expr(expr = init, out = out)
        i = i + 1
      }
      collect_assign_targets_expr(expr = body, out = out)
      0
    },
    EForIn(_, _, iter, body, _) => {
      collect_assign_targets_expr(expr = iter, out = out)
      collect_assign_targets_expr(expr = body, out = out)
      0
    },
    EFn(_, _, _, _, _, body) => {
      collect_assign_targets_expr(expr = body, out = out)
      0
    },
    EDot(obj, _, _, _) => {
      collect_assign_targets_expr(expr = obj, out = out)
      0
    },
    ELabeledArg(_, _, e) => {
      collect_assign_targets_expr(expr = e, out = out)
      0
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, at = i)
        collect_assign_targets_expr(expr = val, out = out)
        i = i + 1
      }
      0
    },
    ESpread(e) => {
      collect_assign_targets_expr(expr = e, out = out)
      0
    },
    EStringInterp(_) => 0
  }
}

export fn collect_assign_targets(_ expr: Expr) -> Array[String] {
  let out = empty_strings()
  collect_assign_targets_expr(expr = expr, out = out)
  out
}

export fn collect_assign_targets_stmts(_ stmts: Array[Stmt]) -> Array[String] {
  let out = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    match stmt {
      SLet(_, _, _, _, expr) => collect_assign_targets_expr(expr = expr, out = out),
      SLetMut(_, _, expr) => collect_assign_targets_expr(expr = expr, out = out),
      SExpr(expr) => collect_assign_targets_expr(expr = expr, out = out),
      STest(_, expr) => collect_assign_targets_expr(expr = expr, out = out),
      SBench(_, expr) => collect_assign_targets_expr(expr = expr, out = out),
      _ => 0
    }
    i = i + 1
  }
  out
}

export fn detect_unused_mut(_ stmts: Array[Stmt]) -> Array[(String, String, String)] {
  let targets = collect_assign_targets_stmts(stmts)
  let out = empty_warnings()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    match stmt {
      SLetMut(name, _, _) => {
        if not(warning_array_contains_str(arr = targets, s = name)) {
          let msg = String::concat("mutable variable '", String::concat(name, "' is never reassigned, use 'let' instead"))
          Array::push(out, value = ("unused_mut", name, msg))
        }
        0
      },
      _ => 0
    }
    i = i + 1
  }
  out
}

export fn check_warnings(_ stmts: Array[Stmt]) -> Array[(String, String, String)] {
  let out = empty_warnings()
  let unused = detect_unused_vars(stmts)
  let mut i = 0
  while i < Array::length(unused) {
    Array::push(out, value = Array::get(unused, at = i))
    i = i + 1
  }
  let muts = detect_unused_mut(stmts)
  let mut j = 0
  while j < Array::length(muts) {
    Array::push(out, value = Array::get(muts, at = j))
    j = j + 1
  }
  let shadows = detect_shadows(stmts)
  let mut k = 0
  while k < Array::length(shadows) {
    Array::push(out, value = Array::get(shadows, at = k))
    k = k + 1
  }
  out
}
