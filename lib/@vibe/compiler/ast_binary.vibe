//# AST Binary ABI v1 — implementation
//#
//# Wire format spec: docs/ast_binary_abi.md (single source of truth).
//#
//# This file implements the byte-level primitives (varint, svarint,
//# string, bool, span, magic header), a cursor over `Bytes` for reads,
//# and the AST-level codecs built on them.
//#
//# Status: primitives complete + round-trip tested; `TypeExpr` and `Pat`
//# complete + round-trip tested. `Expr` / `Stmt` are not written yet.
//#
//# The blocker recorded here before #2510 was that the spec still
//# described the RETIRED MoonBit host's AST: its tag tables named
//# `Int` / `Float` / `Record` / `Map` / `Set` / `ArrayBuilder`, so
//# implementing the document would have encoded a shape this compiler
//# does not have. That is fixed — the tables are now this compiler's
//# `TypeExpr` / `Pat` / `Expr` / `Stmt` (5 / 10 / 33 / 26 variants),
//# tagged in DECLARATION ORDER, and `scripts/check_ast_binary_tags.sh`
//# holds them to `lib/@vibe/ast/index.vpkg` so they cannot drift back.
//# (The count recorded one commit earlier said 27 statements; the
//# enum has 26.)
//#
//# `PFloat` and `EFloat` carry a `Double`, which needed a read primitive
//# that did not exist until #2651: writing the pattern exactly works
//# via `Double::to_i64_bits_lo` / `_hi`, but the single-`Int`
//# `Double::from_i64_bits` cannot carry a 64-bit pattern through a
//# 63-bit `Int`, so every negative double was out of its reach.
//# `Double::from_i64_bits_lohi` is the counterpart, and `f64` on the
//# wire is the same lo/hi pair. `Double::to_string` + `Double::parse`
//# is not a substitute: measured, it drops a digit on
//# 2.2250738585072014 and answers 0 for 1e300 and 1e-300 (#2652).
//#
//# This matters for #2510: the spec names this format as the source of
//# truth for the on-disk per-file AST cache
//# (`~/.cache/vibe/prelude-<sha>.ast.bin`), so the per-module prelude
//# cache cannot be persisted until the codecs exist.

//# Imports

import @vibe/ast {
  Pat, TypeExpr
}

//# Constants ===

export let AST_BINARY_VERSION: Int = 1
export let AST_BINARY_MAGIC_V: Int = 118
/// 'v'
export let AST_BINARY_MAGIC_A: Int = 65
/// 'A'
export let AST_BINARY_MAGIC_S: Int = 83
/// 'S'
export let AST_BINARY_MAGIC_T: Int = 84
// 'T'

//# Encoder primitives ===

//# LEB128 unsigned. We avoid `leb128_encode_u32` from core/bytebuf
//# because that one shifts via `((1<<25) - 1)`, which silently clamps
//# at 32 bits; the ABI requires 64-bit-clean output for any varint
//# field (Stmt counts, string lengths). Spelled out the slow way so
//# the bytes are exactly what docs/ast_binary_abi.md specifies.
export fn ast_binary_write_varint(buf: Bytes, v: Int) -> Unit {
  let mut x = v
  let mut more = true
  while more {
    let byte = x&127
    x = (x>>7)&((1<<57) - 1)
    if x == 0 {
      Bytes::push(buf, byte)
      more = false
    } else {
      Bytes::push(buf, byte|128)
    }
  }
}

//# Standard signed LEB128 (sleb128). Arithmetic right shift keeps the
//# sign bit on the high end so the termination condition is
//# value==0/no-sign or value==-1/sign-set.
export fn ast_binary_write_svarint(buf: Bytes, v: Int) -> Unit {
  let mut value = v
  let mut more = true
  while more {
    let byte = value&127
    value = value>>7
    let sign_bit_set = (byte&64) != 0
    let terminate =
    (value == 0 && (sign_bit_set == false)) ||
    (value == (0 - 1) && sign_bit_set)
    if terminate {
      Bytes::push(buf, byte)
      more = false
    } else {
      Bytes::push(buf, byte|128)
    }
  }
}

//# Single byte 0x00 or 0x01.
export fn ast_binary_write_bool(buf: Bytes, b: Bool) -> Unit {
  if b {
    Bytes::push(buf, 1)
  } else {
    Bytes::push(buf, 0)
  }
}

//# UTF-8 encode a string and prefix with `varint(byte_count)`. vibe's
//# `String::char_code_at` returns UTF-16 code units, so we have to
//# (a) decode surrogate pairs back into code points, then (b) emit
//# UTF-8 bytes. `ast_binary_read_string` is the exact inverse.
export fn ast_binary_write_string(buf: Bytes, s: String) -> Unit {
  // Encode UTF-8 into a scratch buffer first so we can prefix with
  // the byte count (not the char/code-unit count).
  let scratch = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    let unit = String::char_code_at(s, i)
    let mut code_point = unit
    let is_high_surrogate = unit >= 55296 && unit < 56320
    if is_high_surrogate && (i + 1) < len {
      let low = String::char_code_at(s, i + 1)
      let is_low = low >= 56320 && low < 57344
      if is_low {
        code_point = ((unit - 55296)<<10) + (low - 56320) + 65536
        i = i + 1
      }
    }
    if code_point < 128 {
      Bytes::push(scratch, code_point)
    } else {
      if code_point < 2048 {
        Bytes::push(scratch, 192|(code_point>>6))
        Bytes::push(scratch, 128|(code_point&63))
      } else {
        if code_point < 65536 {
          Bytes::push(scratch, 224|(code_point>>12))
          Bytes::push(scratch, 128|((code_point>>6)&63))
          Bytes::push(scratch, 128|(code_point&63))
        } else {
          Bytes::push(scratch, 240|(code_point>>18))
          Bytes::push(scratch, 128|((code_point>>12)&63))
          Bytes::push(scratch, 128|((code_point>>6)&63))
          Bytes::push(scratch, 128|(code_point&63))
        }
      }
    }
    i = i + 1
  }
  ast_binary_write_varint(buf, Bytes::length(scratch))
  Bytes::append(buf, scratch)
}

//# Optional string: 0x00 = None, 0x01 followed by string.
export fn ast_binary_write_optstr(buf: Bytes, o: Option[String]) -> Unit {
  match o {
    None => Bytes::push(buf, 0)
    Some(s) => {
      Bytes::push(buf, 1)
      ast_binary_write_string(buf, s)
    }
  }
}

//# `svarint(start) svarint(end)`.
export fn ast_binary_write_span(buf: Bytes, start: Int, end: Int) -> Unit {
  ast_binary_write_svarint(buf, start)
  ast_binary_write_svarint(buf, end)
}

//# Magic 'vAST' + version varint. Emit this once at the start of any
//# blob.
export fn ast_binary_write_header(buf: Bytes) -> Unit {
  Bytes::push(buf, AST_BINARY_MAGIC_V)
  Bytes::push(buf, AST_BINARY_MAGIC_A)
  Bytes::push(buf, AST_BINARY_MAGIC_S)
  Bytes::push(buf, AST_BINARY_MAGIC_T)
  ast_binary_write_varint(buf, AST_BINARY_VERSION)
}

//# Reader cursor ===
//#
//# vibe doesn't have first-class Refs; we use a struct with a mut
//# field to advance the read position.
export struct AstBinaryReader {
  bytes: Bytes;
  mut pos: Int
}

export fn ast_binary_reader_new(bytes: Bytes) -> AstBinaryReader {
  AstBinaryReader::{
    bytes: bytes,
    pos: 0
  }
}

export fn ast_binary_reader_remaining(r: AstBinaryReader) -> Int {
  Bytes::length(r.bytes) - r.pos
}

//# Read one byte and advance the cursor. Returns -1 on EOF; callers
//# are expected to validate ahead-of-read for non-trivial decodes.
export fn ast_binary_read_byte(r: AstBinaryReader) -> Int {
  if r.pos >= Bytes::length(r.bytes) {
    0 - 1
  } else {
    let b = Bytes::get(r.bytes, r.pos)
    r.pos = r.pos + 1
    b
  }
}

//# LEB128 unsigned.
//#
//# The end-of-input arm is not decoration: `ast_binary_read_byte`
//# answers -1 past the end and `-1 & 128` is 128, so the continuation
//# test alone NEVER terminates on a truncated varint. Stopping keeps
//# the loop bounded; the value it then returns is not meaningful, so a
//# decoder reading untrusted bytes calls the `_checked` reader below,
//# which reports the truncation instead of answering.
export fn ast_binary_read_varint(r: AstBinaryReader) -> Int {
  let mut result = 0
  let mut shift = 0
  let mut more = true
  while more {
    if ast_binary_reader_remaining(r) <= 0 {
      more = false
    } else {
      let b = ast_binary_read_byte(r)
      result = result|((b&127)<<shift)
      if (b&128) == 0 {
        more = false
      } else {
        shift = shift + 7
      }
    }
  }
  result
}

//# sleb128. Sign-extends if the final byte has bit 6 set. Same
//# end-of-input guard as `ast_binary_read_varint` above, same reason.
export fn ast_binary_read_svarint(r: AstBinaryReader) -> Int {
  let mut result = 0
  let mut shift = 0
  let mut last_byte = 0
  let mut more = true
  while more {
    if ast_binary_reader_remaining(r) <= 0 {
      more = false
    } else {
      let b = ast_binary_read_byte(r)
      last_byte = b
      result = result|((b&127)<<shift)
      shift = shift + 7
      if (b&128) == 0 {
        more = false
      }
    }
  }
  if shift < 64 && (last_byte&64) != 0 {
    result|((0 - 1)<<shift)
  } else {
    result
  }
}

export fn ast_binary_read_bool(r: AstBinaryReader) -> Bool {
  let b = ast_binary_read_byte(r)
  b == 1
}

//# Decode the varint length-prefixed UTF-8 string back into a vibe
//# `String`. We assemble characters via char arithmetic; vibe's
//# `String::concat` joins single-character strings.
export fn ast_binary_read_string(r: AstBinaryReader) -> String {
  let byte_len = ast_binary_read_varint(r)
  let end = r.pos + byte_len
  // O(N) build via StringBuilder; the previous `out = String::concat(out, c)`
  // per character was O(L²) over the string length, paid on every string when
  // loading a cached AST (issue #366).
  let out = StringBuilder::new()
  while r.pos < end {
    let b0 = ast_binary_read_byte(r)
    let mut code_point = 0
    if b0 < 128 {
      code_point = b0
    } else {
      if (b0&224) == 192 {
        let b1 = ast_binary_read_byte(r)
        code_point = ((b0&31)<<6)|(b1&63)
      } else {
        if (b0&240) == 224 {
          let b1 = ast_binary_read_byte(r)
          let b2 = ast_binary_read_byte(r)
          code_point = ((b0&15)<<12)|((b1&63)<<6)|(b2&63)
        } else {
          let b1 = ast_binary_read_byte(r)
          let b2 = ast_binary_read_byte(r)
          let b3 = ast_binary_read_byte(r)
          code_point = ((b0&7)<<18)|((b1&63)<<12)|((b2&63)<<6)|(b3&63)
        }
      }
    }
    // Re-encode as UTF-16 surrogate pair if needed, then build a 1-char string.
    if code_point >= 65536 {
      let high = 55296 + ((code_point - 65536)>>10)
      let low = 56320 + ((code_point - 65536)&1023)
      // vibe doesn't expose a primitive char-from-code-point that handles
      // surrogates; we round-trip through Bytes which is UTF-16-aware in
      // the runtime. This branch is unused by the prelude (ASCII-only)
      // so we keep the slow path explicit and tested by the cross-impl
      // fixture once non-BMP characters get added.
      StringBuilder::push(out, String::from_char_code(high))
      StringBuilder::push(out, String::from_char_code(low))
    } else {
      StringBuilder::push(out, String::from_char_code(code_point))
    }
  }
  StringBuilder::freeze(out)
}

export fn ast_binary_read_optstr(r: AstBinaryReader) -> Option[String] {
  let tag = ast_binary_read_byte(r)
  if tag == 0 {
    None
  } else {
    Some(ast_binary_read_string(r))
  }
}

export fn ast_binary_read_span(r: AstBinaryReader) -> (Int, Int) {
  let start = ast_binary_read_svarint(r)
  let end = ast_binary_read_svarint(r)
  (start, end)
}

//# Magic + version. Returns `(ok, version)`: ok=false on bad magic,
//# version=0 on EOF.
export fn ast_binary_read_header(r: AstBinaryReader) -> (Bool, Int) {
  if ast_binary_reader_remaining(r) < 4 {
    (false, 0)
  } else {
    let v = ast_binary_read_byte(r)
    let a = ast_binary_read_byte(r)
    let s = ast_binary_read_byte(r)
    let t = ast_binary_read_byte(r)
    if v != AST_BINARY_MAGIC_V || a != AST_BINARY_MAGIC_A || s != AST_BINARY_MAGIC_S || t != AST_BINARY_MAGIC_T {
      (false, 0)
    } else {
      let version = ast_binary_read_varint(r)
      (true, version)
    }
  }
}

//# Checked reads ===
//#
//# The primitives above answer for WELL-FORMED input. These report the
//# malformed cases docs/ast_binary_abi.md requires a deserializer to
//# raise on — unexpected EOF, a length that exceeds the remaining
//# bytes, a present flag that is neither 0x00 nor 0x01. The AST-level
//# codecs below read through these and never through the raw ones,
//# because their input is a cache file: a file truncated by a crash or
//# a full disk is the normal case, not the exotic one.

export fn ast_binary_read_byte_checked(r: AstBinaryReader) -> Int with Exception {
  if ast_binary_reader_remaining(r) <= 0 {
    throw("ast_binary: unexpected end of input")
  }
  ast_binary_read_byte(r)
}

export fn ast_binary_read_varint_checked(r: AstBinaryReader) -> Int with Exception {
  let mut result = 0
  let mut shift = 0
  let mut more = true
  while more {
    if shift >= 64 {
      throw("ast_binary: varint exceeds 64 bits")
    }
    let b = ast_binary_read_byte_checked(r)
    result = result|((b&127)<<shift)
    if (b&128) == 0 {
      more = false
    } else {
      shift = shift + 7
    }
  }
  result
}

//# Is `[at, at+len)` well-formed UTF-8 whose every sequence ENDS inside
//# the range?
//#
//# This exists because checking the declared length is not enough. The
//# raw decoder reads a lead byte's continuation bytes without re-testing
//# the bound, so a string declaring ONE byte and carrying a `0xF0` lead
//# makes it consume three bytes of the NEXT field -- the decode
//# "succeeds", returns a garbage character, and leaves the cursor three
//# bytes out, so every field after it is read from the wrong offset.
//# That is a silent wrong answer from a corrupt cache file, which is
//# the one failure this format must not have.
//#
//# So the bytes are established well-formed BEFORE they are decoded,
//# rather than while. That keeps a single decoder -- duplicating the
//# decode here would be a second place for the surrogate handling to be
//# wrong in -- and makes the validator independently testable.
fn ast_binary_utf8_span_ok(b: Bytes, at: Int, len: Int) -> Bool {
  let end = at + len
  let mut i = at
  let mut ok = true
  while ok && i < end {
    let b0 = Bytes::get(b, i)
    // Continuation bytes (0b10xxxxxx) and the never-valid 0xF8..0xFF
    // both fall through to -1: neither can start a sequence.
    let need = if b0 < 128 {
      0
    } else if (b0&224) == 192 {
      1
    } else if (b0&240) == 224 {
      2
    } else if (b0&248) == 240 {
      3
    } else {
      0 - 1
    }
    if need < 0 || (i + need) >= end {
      ok = false
    } else {
      let mut k = 1
      while ok && k <= need {
        if (Bytes::get(b, i + k)&192) != 128 {
          ok = false
        } else {
          ()
        }
        k = k + 1
      }
      i = i + need + 1
    }
  }
  ok
}

//# Validate the length prefix AND the bytes it covers, then rewind and
//# let the primitive do the decode.
export fn ast_binary_read_string_checked(r: AstBinaryReader) -> String with Exception {
  let start = r.pos
  let byte_len = ast_binary_read_varint_checked(r)
  if byte_len < 0 || ast_binary_reader_remaining(r) < byte_len {
    throw("ast_binary: string length exceeds remaining input")
  }
  if ast_binary_utf8_span_ok(r.bytes, r.pos, byte_len) {
    ()
  } else {
    throw("ast_binary: string is not well-formed UTF-8 within its declared length")
  }
  r.pos = start
  ast_binary_read_string(r)
}

export fn ast_binary_read_optstr_checked(r: AstBinaryReader) -> Option[String] with Exception {
  let tag = ast_binary_read_byte_checked(r)
  if tag == 0 {
    None
  } else if tag == 1 {
    Some(ast_binary_read_string_checked(r))
  } else {
    throw("ast_binary: optional-string present flag is neither 0x00 nor 0x01")
  }
}

//# A count that exceeds the bytes left cannot be honest: every item of
//# every tagged array costs at least its one tag byte. Checking it here
//# turns a corrupt length into a cache miss instead of a loop that
//# allocates until the heap is gone.
export fn ast_binary_read_count_checked(r: AstBinaryReader) -> Int with Exception {
  let count = ast_binary_read_varint_checked(r)
  if count < 0 || count > ast_binary_reader_remaining(r) {
    throw("ast_binary: array count exceeds remaining input")
  }
  count
}

//# TypeExpr ===
//#
//# Tags are the declaration order of `TypeExpr` in
//# lib/@vibe/ast/index.vpkg, per docs/ast_binary_abi.md. They are
//# FROZEN: a variant appended to the enum takes the next free tag, not
//# the tag its declaration position would imply.

export let AST_BINARY_TAG_TY_NAME: Int = 1
export let AST_BINARY_TAG_TY_APP: Int = 2
export let AST_BINARY_TAG_TY_FN: Int = 3
export let AST_BINARY_TAG_TY_TUPLE: Int = 4
export let AST_BINARY_TAG_TY_UNIT: Int = 5

export fn ast_binary_write_type_expr(buf: Bytes, t: TypeExpr) -> Unit {
  match t {
    TyName(name) => {
      Bytes::push(buf, AST_BINARY_TAG_TY_NAME)
      ast_binary_write_string(buf, name)
    }
    TyApp(name, args) => {
      Bytes::push(buf, AST_BINARY_TAG_TY_APP)
      ast_binary_write_string(buf, name)
      ast_binary_write_type_expr_array(buf, args)
    }
    TyFn(params, ret, row) => {
      Bytes::push(buf, AST_BINARY_TAG_TY_FN)
      ast_binary_write_type_expr_array(buf, params)
      ast_binary_write_type_expr(buf, ret)
      ast_binary_write_optstr(buf, row)
    }
    TyTuple(items) => {
      Bytes::push(buf, AST_BINARY_TAG_TY_TUPLE)
      ast_binary_write_type_expr_array(buf, items)
    }
    TyUnit => Bytes::push(buf, AST_BINARY_TAG_TY_UNIT)
  }
}

export fn ast_binary_write_type_expr_array(buf: Bytes, items: Array[TypeExpr]) -> Unit {
  ast_binary_write_varint(buf, Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    ast_binary_write_type_expr(buf, Array::get(items, i))
    i = i + 1
  }
}

//# Every multi-field arm binds its fields to `let`s in wire order
//# before constructing. Passing the reads directly as constructor
//# arguments would make the BYTE ORDER depend on argument evaluation
//# order, which is exactly the kind of thing that reads correct and
//# decodes garbage (#1899).
export fn ast_binary_read_type_expr(r: AstBinaryReader) -> TypeExpr with Exception {
  let tag = ast_binary_read_byte_checked(r)
  if tag == AST_BINARY_TAG_TY_NAME {
    TyName(ast_binary_read_string_checked(r))
  } else if tag == AST_BINARY_TAG_TY_APP {
    let name = ast_binary_read_string_checked(r)
    let args = ast_binary_read_type_expr_array(r)
    TyApp(name, args)
  } else if tag == AST_BINARY_TAG_TY_FN {
    let params = ast_binary_read_type_expr_array(r)
    let ret = ast_binary_read_type_expr(r)
    let row = ast_binary_read_optstr_checked(r)
    TyFn(params, ret, row)
  } else if tag == AST_BINARY_TAG_TY_TUPLE {
    TyTuple(ast_binary_read_type_expr_array(r))
  } else if tag == AST_BINARY_TAG_TY_UNIT {
    TyUnit
  } else {
    throw("ast_binary: unknown TypeExpr tag " + Int::to_string(tag))
  }
}

export fn ast_binary_read_type_expr_array(r: AstBinaryReader) -> Array[TypeExpr] with Exception {
  let count = ast_binary_read_count_checked(r)
  let out: Array[TypeExpr] = []
  let mut i = 0
  while i < count {
    Array::push(out, ast_binary_read_type_expr(r))
    i = i + 1
  }
  out
}

//# f64 ===
//#
//# The IEEE-754 binary64 pattern as two UNSIGNED 32-bit halves, low
//# first. Not one varint: an `Int` is 63-bit, so the whole pattern does
//# not fit in one (ADR-0055 Blocker-2) and every negative double would
//# be unrepresentable. Each half fits comfortably.

export fn ast_binary_write_f64(buf: Bytes, d: Double) -> Unit {
  ast_binary_write_varint(buf, Double::to_i64_bits_lo(d))
  ast_binary_write_varint(buf, Double::to_i64_bits_hi(d))
}

export fn ast_binary_read_f64_checked(r: AstBinaryReader) -> Double with Exception {
  let lo = ast_binary_read_varint_checked(r)
  let hi = ast_binary_read_varint_checked(r)
  Double::from_i64_bits_lohi(lo, hi)
}

//# sleb128, reporting the malformed cases. Same shape and same reasons
//# as `ast_binary_read_varint_checked`.
export fn ast_binary_read_svarint_checked(r: AstBinaryReader) -> Int with Exception {
  let mut result = 0
  let mut shift = 0
  let mut last_byte = 0
  let mut more = true
  while more {
    if shift >= 64 {
      throw("ast_binary: svarint exceeds 64 bits")
    }
    let b = ast_binary_read_byte_checked(r)
    last_byte = b
    result = result|((b&127)<<shift)
    shift = shift + 7
    if (b&128) == 0 {
      more = false
    } else {
      ()
    }
  }
  if shift < 64 && (last_byte&64) != 0 {
    result|((0 - 1)<<shift)
  } else {
    result
  }
}

export fn ast_binary_read_bool_checked(r: AstBinaryReader) -> Bool with Exception {
  let b = ast_binary_read_byte_checked(r)
  if b == 0 {
    false
  } else if b == 1 {
    true
  } else {
    throw("ast_binary: bool byte is neither 0x00 nor 0x01")
  }
}

//# Pat ===
//#
//# Declaration order of `Pat` in lib/@vibe/ast/index.vpkg, per
//# docs/ast_binary_abi.md, and FROZEN the same way TypeExpr's are.

export let AST_BINARY_TAG_P_WILD: Int = 1
export let AST_BINARY_TAG_P_BIND: Int = 2
export let AST_BINARY_TAG_P_INT: Int = 3
export let AST_BINARY_TAG_P_FLOAT: Int = 4
export let AST_BINARY_TAG_P_STRING: Int = 5
export let AST_BINARY_TAG_P_BOOL: Int = 6
export let AST_BINARY_TAG_P_CTOR: Int = 7
export let AST_BINARY_TAG_P_TUPLE: Int = 8
export let AST_BINARY_TAG_P_OR: Int = 9
export let AST_BINARY_TAG_P_STRUCT: Int = 10

export fn ast_binary_write_pat(buf: Bytes, p: Pat) -> Unit {
  match p {
    PWild => Bytes::push(buf, AST_BINARY_TAG_P_WILD)
    PBind(name) => {
      Bytes::push(buf, AST_BINARY_TAG_P_BIND)
      ast_binary_write_string(buf, name)
    }
    PInt(v) => {
      Bytes::push(buf, AST_BINARY_TAG_P_INT)
      ast_binary_write_svarint(buf, v)
    }
    PFloat(d) => {
      Bytes::push(buf, AST_BINARY_TAG_P_FLOAT)
      ast_binary_write_f64(buf, d)
    }
    PString(v) => {
      Bytes::push(buf, AST_BINARY_TAG_P_STRING)
      ast_binary_write_string(buf, v)
    }
    PBool(v) => {
      Bytes::push(buf, AST_BINARY_TAG_P_BOOL)
      ast_binary_write_bool(buf, v)
    }
    PCtor(name, args) => {
      Bytes::push(buf, AST_BINARY_TAG_P_CTOR)
      ast_binary_write_string(buf, name)
      ast_binary_write_pat_array(buf, args)
    }
    PTuple(items) => {
      Bytes::push(buf, AST_BINARY_TAG_P_TUPLE)
      ast_binary_write_pat_array(buf, items)
    }
    POr(l, r) => {
      Bytes::push(buf, AST_BINARY_TAG_P_OR)
      ast_binary_write_pat(buf, l)
      ast_binary_write_pat(buf, r)
    }
    PStruct(name, fields) => {
      Bytes::push(buf, AST_BINARY_TAG_P_STRUCT)
      ast_binary_write_string(buf, name)
      ast_binary_write_varint(buf, Array::length(fields))
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fpat) = Array::get(fields, i)
        ast_binary_write_string(buf, fname)
        ast_binary_write_pat(buf, fpat)
        i = i + 1
      }
    }
  }
}

export fn ast_binary_write_pat_array(buf: Bytes, items: Array[Pat]) -> Unit {
  ast_binary_write_varint(buf, Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    ast_binary_write_pat(buf, Array::get(items, i))
    i = i + 1
  }
}

//# Fields bound in wire order before construction, for the reason
//# `ast_binary_read_type_expr` gives.
export fn ast_binary_read_pat(r: AstBinaryReader) -> Pat with Exception {
  let tag = ast_binary_read_byte_checked(r)
  if tag == AST_BINARY_TAG_P_WILD {
    PWild
  } else if tag == AST_BINARY_TAG_P_BIND {
    PBind(ast_binary_read_string_checked(r))
  } else if tag == AST_BINARY_TAG_P_INT {
    PInt(ast_binary_read_svarint_checked(r))
  } else if tag == AST_BINARY_TAG_P_FLOAT {
    PFloat(ast_binary_read_f64_checked(r))
  } else if tag == AST_BINARY_TAG_P_STRING {
    PString(ast_binary_read_string_checked(r))
  } else if tag == AST_BINARY_TAG_P_BOOL {
    PBool(ast_binary_read_bool_checked(r))
  } else if tag == AST_BINARY_TAG_P_CTOR {
    let name = ast_binary_read_string_checked(r)
    let args = ast_binary_read_pat_array(r)
    PCtor(name, args)
  } else if tag == AST_BINARY_TAG_P_TUPLE {
    PTuple(ast_binary_read_pat_array(r))
  } else if tag == AST_BINARY_TAG_P_OR {
    let l = ast_binary_read_pat(r)
    let rp = ast_binary_read_pat(r)
    POr(l, rp)
  } else if tag == AST_BINARY_TAG_P_STRUCT {
    let name = ast_binary_read_string_checked(r)
    let count = ast_binary_read_count_checked(r)
    let fields: Array[(String, Pat)] = []
    let mut i = 0
    while i < count {
      let fname = ast_binary_read_string_checked(r)
      let fpat = ast_binary_read_pat(r)
      Array::push(fields, (fname, fpat))
      i = i + 1
    }
    PStruct(name, fields)
  } else {
    throw("ast_binary: unknown Pat tag " + Int::to_string(tag))
  }
}

export fn ast_binary_read_pat_array(r: AstBinaryReader) -> Array[Pat] with Exception {
  let count = ast_binary_read_count_checked(r)
  let out: Array[Pat] = []
  let mut i = 0
  while i < count {
    Array::push(out, ast_binary_read_pat(r))
    i = i + 1
  }
  out
}
