name = @vibe/compiler/cache/policy
version = 0.0.1
description =
  #|Immutable persistent-cache decisions, separate from target flags and cache contents.

type AstCachePolicy
type IngestionStampPolicy
type CheckedModuleCachePolicy
fn ast_cache_policy(active: Bool) -> AstCachePolicy
fn ast_cache_policy_active(_ policy: AstCachePolicy) -> Bool
fn ast_cache_policy_capture() -> AstCachePolicy with AstCacheConfig
fn ingestion_stamp_policy(enabled: Bool) -> IngestionStampPolicy
fn ingestion_stamp_policy_enabled(_ policy: IngestionStampPolicy) -> Bool
fn ingestion_stamp_policy_capture() -> IngestionStampPolicy with IngestionStampConfig
fn checked_module_cache_policy(_ mode: String) -> CheckedModuleCachePolicy with Exception
fn checked_module_cache_policy_mode(_ policy: CheckedModuleCachePolicy) -> String
fn checked_module_cache_policy_capture() -> CheckedModuleCachePolicy with CheckedModuleCacheConfig + Exception
effect AstCacheConfig {
  Active() -> Bool
}
effect IngestionStampConfig {
  Enabled() -> Bool
}
effect CheckedModuleCacheConfig {
  Mode() -> String
}
