//# Imports

// #766: the generic disk-cache primitives live in @vibe/cache (no compiler
// dependency). This file is the compiler-specific adapter: it supplies the
// two identity components a generic cache can't know about — the compiler's
// own codegen fingerprint (so a codegen change invalidates stale artifacts,
// #630) and VIBE_LIB's module-resolution env seed (#758) — and re-exports
// the ORIGINAL wrapper names/signatures so every existing call site in the
// compiler keeps working unchanged.
// #769: the `cache_`-prefixed underlying names come from real forwarding
// wrappers (cache_underlying.vibe), NOT `x as cache_x` import aliases -- an
// alias only exists in the import line, which generate_bundle.sh
// strips from embedded sources, so the bundle-merge lane
// (collect_merged_stmts, s5_entry/size/wasm/determinism_test) had
// no definition for the aliased names ("undefined variable (local):
// cache_persistent_artifact_cache_path @call"). See cache_underlying.vibe.
import ./cache_underlying.vibe {
  cache_fingerprint_file_fs,
  cache_load_persistent_artifact,
  cache_persistent_artifact_cache_path,
  cache_persistent_dep_list_cache_path,
  cache_persistent_leaf_fingerprint_cache_path,
  cache_persistent_manifest_header_cache_path,
  cache_persistent_module_header_cache_path,
  cache_persistent_source_group_cache_path,
  cache_persistent_source_list_cache_path,
  cache_persistent_type_env_cache_path,
  cache_stable_text_cache_path,
  cache_store_persistent_artifact
}

import ./codegen_fingerprint.vibe {
  codegen_fingerprint
}

import @vibe/compiler/core {
  is_contract_ext, resolution_env_seed, resolve_import_path_candidates
}

//# Misc

// #897 (cache/ vpkg migration): rewritten from the old bare
// `import ../../../../lib/@vibe/cache {...}` + separate `export {...}`
// two-step to the `export <path> { names }` SReExport form -- a bare
// import + export does NOT satisfy check_contract as an implementation for
// a declared contract name (only a real local `export fn`/`export type`
// body, or an SReExport, counts; see core/ast.vibe's identical fix for
// @vibe/ast's Expr/Pat/Stmt/TypeExpr). cache/index.vpkg's fn declarations
// for these 12 names are satisfied by this SReExport at face value
// (check_contract trusts re-exported names without a body/arity check --
// the source package's own contract, lib/@vibe/cache/index.vpkg, is what
// actually pins their shape).
export ../../../../lib/@vibe/cache {
  compact_string_fingerprint,
  compilation_input_fingerprint,
  build_source_groups_fingerprint,
  normalize_persistent_cache_text,
  build_source_groups_fingerprint_from_compact_fingerprints,
  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint,
  build_fs_compile_wasi_artifact_fingerprint,
  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path,
  build_fs_compile_wasi_artifact_fingerprint_for_entry_path,
  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint,
  build_file_compile_wasi_artifact_fingerprint,
  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint_for_entry_path,
  build_file_compile_wasi_artifact_fingerprint_for_entry_path,
  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint,
  build_fs_compile_module_artifact_fingerprint,
  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path,
  build_fs_compile_module_artifact_fingerprint_for_entry_path,
  build_file_compile_module_artifact_fingerprint_from_group_fingerprint,
  build_file_compile_module_artifact_fingerprint,
  build_file_compile_module_artifact_fingerprint_from_group_fingerprint_for_entry_path,
  build_file_compile_module_artifact_fingerprint_for_entry_path
}

//# Functions

/// Cache key version tag. TWO independent reasons to bump it (#630):
///  - cache FORMAT change (how `.hex` / `.tsv` entries are serialized): bump `vNN`.
///  - CODEGEN / wasm-ABI change (the SAME source now compiles to DIFFERENT wasm):
///    bump `cgNN`. The artifact cache is keyed by the source fingerprint only, so
///    without a codegen segment a codegen change returns a STALE compiled wasm for
///    unchanged source. Bump `cg` on any change to emitted wasm / runtime ABI.
///    The `cg` segment is `codegen_fingerprint()` — a build-time hash of
///    all compiler source files (compiler_sources_manifest.tsv), regenerated with
///    the bundle. So any codegen-source change automatically changes the key and
///    invalidates stale artifacts; no manual bump needed (#630). `vNN` is still a
///    manual knob for pure cache-FORMAT changes that don't change the source hash.
fn persistent_cache_version_tag() -> String {
  // v13 (#1290): artifact identities now include ordered source paths and the
  // selected entry path, so old path-blind artifacts must never be reused.
  // v12 (#801): source list/group cache text gained a mandatory `resctx` row
  // (resolution-context fingerprint) and its version row moved to 3 — a cache
  // FORMAT change. Loaders written before #801 throw on the unknown row tag,
  // so the manual `vNN` knob is bumped to keep old and new writers in
  // disjoint key spaces (this also orphans any #801-poisoned entries).
  // v11 (#632): artifact cache switched from hex text (`.hex`) to raw binary
  // (`.bin`, via Fs::write_bytes / Fs::read_bytes) — a cache FORMAT change, so
  // the manual `vNN` knob is bumped. Old `.hex` entries are now unreferenced
  // (different key + suffix) and reclaimable via `pkf run cache-clean` (#631).
  String::concat("v13|cg-", codegen_fingerprint())
}

export fn persistent_artifact_cache_path(kind: String, entry_name: String, fingerprint: String) -> String {
  cache_persistent_artifact_cache_path(persistent_cache_version_tag(), kind, entry_name, fingerprint)
}

export fn store_persistent_artifact(kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs } {
  cache_store_persistent_artifact(persistent_cache_version_tag(), kind, entry_name, fingerprint, bytes)
}

export fn load_persistent_artifact(kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs } {
  cache_load_persistent_artifact(persistent_cache_version_tag(), kind, entry_name, fingerprint)
}

export fn persistent_dep_list_cache_path(path: String, source_fingerprint: String) -> String {
  cache_persistent_dep_list_cache_path(persistent_cache_version_tag(), path, source_fingerprint, resolution_env_seed())
}

export fn persistent_type_env_cache_path(fingerprint: String) -> String {
  cache_persistent_type_env_cache_path(persistent_cache_version_tag(), fingerprint)
}

export fn persistent_source_list_cache_path(entry_path: String) -> String {
  // #758 review (P1): the cached artifact is a RESOLVED graph — the external
  // lib roots and the freeze switch (#751) are part of its identity, or a
  // graph resolved without pins replays under VIBE_REQUIRE_PINS=1 (and a
  // VIBE_LIB change replays the previous roots). Same seed on the dep-list
  // and module-header caches below.
  cache_persistent_source_list_cache_path(persistent_cache_version_tag(), entry_path, resolution_env_seed())
}

export fn persistent_source_group_cache_path(entry_path: String) -> String {
  cache_persistent_source_group_cache_path(persistent_cache_version_tag(), entry_path, resolution_env_seed())
}

export fn persistent_module_header_cache_path(path: String, source_fingerprint: String) -> String {
  cache_persistent_module_header_cache_path(persistent_cache_version_tag(), path, source_fingerprint, resolution_env_seed())
}

export fn persistent_manifest_header_cache_path(entry_path: String) -> String {
  cache_persistent_manifest_header_cache_path(persistent_cache_version_tag(), entry_path)
}

export fn persistent_leaf_fingerprint_cache_path(path: String, source_fingerprint: String) -> String {
  cache_persistent_leaf_fingerprint_cache_path(persistent_cache_version_tag(), path, source_fingerprint)
}

/// #1308: stat-token-validated memo over `compact_string_fingerprint(
/// Fs::read_file(path))` — see cache_underlying.vibe for the memo's identity
/// argument. No version-tag adaptation: a file content fingerprint has no
/// cache-format or codegen component.
export fn fingerprint_file_fs(path: String) -> String with { Fs } {
  cache_fingerprint_file_fs(path)
}

/// #1100 (selfcompile-heap): the loader's two contract-parse memo classes.
/// Both are pure functions of file CONTENT (fingerprints in the seed) plus
/// the resolution env (resolve_path_fs winners move with VIBE_LIB etc., same
/// reason the module-header key carries the seed).
///
/// vpkg shared-import prefix: keyed by the vpkg contract's own content —
/// the prefix text derives from nothing else.
export fn persistent_vpkg_prefix_cache_path(path: String, source_fingerprint: String) -> String {
  cache_stable_text_cache_path(persistent_cache_version_tag(), "selfhost_vpkg_prefix", String::concat(path, String::concat("|", String::concat(source_fingerprint, resolution_env_seed()))))
}

/// contract facade: keyed by a CLOSURE fingerprint (the contract's original
/// on-disk text + every resolved member's path and content fingerprint) —
/// a member edit must invalidate the facade and its conformance verdict.
export fn persistent_contract_facade_cache_path(path: String, closure_fingerprint: String) -> String {
  cache_stable_text_cache_path(persistent_cache_version_tag(), "selfhost_contract_facade", String::concat(path, String::concat("|", String::concat(closure_fingerprint, resolution_env_seed()))))
}

/// #801 follow-up: the module-header and dep-list caches store RESOLVED dep
/// paths, and a `@scope/name` import resolves to a DIFFERENT package root
/// (.vibe/store wins over lib/ wins over external roots) depending on what
/// exists at resolve time. A header cached while a store copy existed lists
/// the store index.vibei as a dep; replayed after the store copy is gone (or
/// vice versa) it aims the walk at the wrong root. Unlike the source-group
/// cache (#801's resctx row), the poison here is VISIBLE in the cached rows —
/// the importing file's dep always names the winning package index — so no
/// context enumeration is needed: re-derive the `@scope/name` ref from each
/// package-index dep and check it still wins today.
fn package_ref_of_index_dep(dep: String) -> Option[String] {
  // #897: a resolved package-index dep only ever ends in `.vibei` or (once a
  // directory has migrated) `.vpkg` — no other on-disk file uses either
  // extension — so the shared `is_contract_ext` boolean is exact here, not
  // an approximation of the "/index.<ext>" filename check.
  if is_contract_ext(dep) {
    let parts = String::split(dep, "/")
    let n = Array::length(parts)
    if n >= 3 && String::starts_with(Array::get(parts, n - 3), "@") {
      Some(String::concat(Array::get(parts, n - 3), String::concat("/", Array::get(parts, n - 2))))
    } else {
      None
    }
  } else {
    None
  }
}

export fn package_index_dep_is_current(dep: String) -> Bool with { Fs } {
  match package_ref_of_index_dep(dep) {
    None => true,
    Some(pkg_ref) => {
      let candidates = resolve_import_path_candidates("", pkg_ref)
      let mut i = 0
      let mut winner = ""
      while i < Array::length(candidates) {
        if winner == "" {
          let candidate = Array::get(candidates, i)
          if Fs::exists(candidate) {
            winner = candidate
          } else {
            ()
          }
        } else {
          ()
        }
        i = i + 1
      }
      // Mirror resolve_path_fs: no existing candidate falls back to the
      // first (store) spelling.
      if winner == "" {
        Array::get(candidates, 0) == dep
      } else {
        winner == dep
      }
    }
  }
}

export fn package_index_deps_are_current(deps: Array[String]) -> Bool with { Fs } {
  let mut i = 0
  let mut ok = true
  while i < Array::length(deps) {
    if ok && !(package_index_dep_is_current(Array::get(deps, i))) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}
