//# Imports

// #769: `cache_`-prefixed forwarding wrappers around the generic @vibe/cache
// primitives, replacing persistent_cache.vibe's `import ... { x as cache_x }`
// aliases. Rationale: generate_bundle.sh strips relative import
// lines from every embedded .vibe source on the assumption that
// collect_merged_stmts resolves references BY NAME -- an `as` alias only
// exists in the import line, so the stripped bundle's merged program had
// calls to `cache_persistent_artifact_cache_path` with no such definition
// ("undefined variable (local): ... @call", the s5_entry/size/wasm/
// determinism_test failure). Real wrapper functions survive the strip: their
// bodies call the @vibe/cache definitions by their own exported names, which
// the merge resolves. Keep this file alias-free.
import @vibe/cache {
  compact_string_fingerprint,
  load_persistent_artifact,
  persistent_artifact_cache_path,
  persistent_dep_list_cache_path,
  persistent_leaf_fingerprint_cache_path,
  persistent_manifest_header_cache_path,
  persistent_module_header_cache_path,
  persistent_source_group_cache_path,
  persistent_source_list_cache_path,
  persistent_type_env_cache_path,
  stable_cache_path,
  store_persistent_artifact
}

//# Functions

/// #849 (Codex review, PR #899): VIBE_BUILD_CACHE_DIR override lives HERE,
/// not in @vibe/cache/cache.vibe — this compiler-specific wrapper layer
/// already requires host Fs/Error imports for every consumer, so an
/// `Env::get` reference here forces nothing new. Putting it in the generic
/// package instead would force a `vibe.env_get` host import onto every
/// consumer of @vibe/cache's whole linked program (even ones only using pure
/// helpers like compact_string_fingerprint), since collect_used_builtin_names
/// scans all top-level statements of the linked program, not just ones
/// reachable from the entry point. Private effect + checker-only discharge,
/// mirroring module_graph_path.vibe's ADR-0065 pattern (VIBE_LIB / VIBE_HOME
/// / HOME / VIBE_REQUIRE_PINS) so the 8 path-returning wrappers below don't
/// need an `Env` row on their own signatures or their ~20-30 call sites.
effect Env {
  Get(String) -> String
}

fn env_get_raw(name: String) -> String with { Env } {
  Env::get(name)
}

fn read_env_discharged(name: String) -> String {
  handle {
    env_get_raw(name)
  } with Env {
    Get(_n) => resume("")
  }
}

/// @vibe/cache/cache.vibe's stable_cache_path always roots paths under the
/// literal "_build/vibe_" prefix. When VIBE_BUILD_CACHE_DIR is set, rebase
/// that prefix onto the override directory (still ending in "vibe_", so the
/// existing "<prefix>_<token>_<suffix>" filename convention appends
/// unchanged) so parallel `git worktree` checkouts can share one physical
/// cache directory (the cache KEY is already content/relative-path based —
/// see #849 audit comment).
fn rebase_cache_path(path: String) -> String {
  let override_root = read_env_discharged("VIBE_BUILD_CACHE_DIR")
  let default_prefix = "_build/vibe_"
  if String::length(override_root) == 0 {
    path
  } else if !(String::starts_with(path, default_prefix)) {
    path
  } else {
    let override_len = String::length(override_root)
    let override_prefix = if String::char_code_at(override_root, override_len - 1) == 47 {
      String::concat(override_root, "vibe_")
    } else {
      String::concat(override_root, "/vibe_")
    }
    String::concat(override_prefix, path[String::length(default_prefix): String::length(path)])
  }
}

export fn cache_persistent_artifact_cache_path(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> String {
  rebase_cache_path(persistent_artifact_cache_path(version_tag, kind, entry_name, fingerprint))
}

export fn cache_store_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs } {
  store_persistent_artifact(version_tag, kind, entry_name, fingerprint, bytes)
}

export fn cache_load_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs } {
  load_persistent_artifact(version_tag, kind, entry_name, fingerprint)
}

export fn cache_persistent_dep_list_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String {
  rebase_cache_path(persistent_dep_list_cache_path(version_tag, path, source_fingerprint, resolution_seed))
}

export fn cache_persistent_type_env_cache_path(version_tag: String, fingerprint: String) -> String {
  rebase_cache_path(persistent_type_env_cache_path(version_tag, fingerprint))
}

export fn cache_persistent_source_list_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String {
  rebase_cache_path(persistent_source_list_cache_path(version_tag, entry_path, resolution_seed))
}

export fn cache_persistent_source_group_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String {
  rebase_cache_path(persistent_source_group_cache_path(version_tag, entry_path, resolution_seed))
}

export fn cache_persistent_module_header_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String {
  rebase_cache_path(persistent_module_header_cache_path(version_tag, path, source_fingerprint, resolution_seed))
}

export fn cache_persistent_manifest_header_cache_path(version_tag: String, entry_path: String) -> String {
  rebase_cache_path(persistent_manifest_header_cache_path(version_tag, entry_path))
}

export fn cache_persistent_leaf_fingerprint_cache_path(version_tag: String, path: String, source_fingerprint: String) -> String {
  rebase_cache_path(persistent_leaf_fingerprint_cache_path(version_tag, path, source_fingerprint))
}

/// #1100: generic small-text cache path (one value per key, ".txt"), through
/// the same VIBE_BUILD_CACHE_DIR rebase as every other persistent-cache
/// class. Serves the loader's vpkg shared-import-prefix and contract-facade
/// caches; the prefix segment keeps distinct classes out of each other's
/// keyspace.
export fn cache_stable_text_cache_path(version_tag: String, prefix: String, seed: String) -> String {
  rebase_cache_path(stable_cache_path(version_tag, prefix, seed, ".txt"))
}

/// #1308: process-wide memo for on-disk file content fingerprints, keyed by
/// path and validated by Fs::stat_token on every hit. A cold compile of the
/// compiler's own tree re-read + re-hashed the same 18 index.vpkg contracts
/// 1325 times (12 MB) and re-read validated sources another 148 times (3 MB)
/// — every `compact_string_fingerprint(Fs::read_file(p))` site pays the full
/// read + rolling hash each call. This turns a repeat into one stat_token
/// probe. Stat-token validation (not blind path keying) keeps a long-lived
/// process (vibe lsp) observationally equivalent to re-reading: the token is
/// the same ns-mtime identity the persistent cache layer already trusts for
/// source-row validity (build_persistent_sources_cache_text rows,
/// package_index_deps_are_current). Missing files fail on the stat exactly
/// like the read they replace. Parallel-array memo cells (module lets are
/// initialized once — the checker_effects.vibe error_row_mode_cell pattern)
/// because MapBuilder has no get/has_key surface yet (#1310).
let fingerprint_file_memo_paths = [
]

let fingerprint_file_memo_tokens = [
]

let fingerprint_file_memo_fps = [
]

export fn cache_fingerprint_file_fs(path: String) -> String with { Fs } {
  let token = Fs::stat_token(path)
  let n = Array::length(fingerprint_file_memo_paths)
  let mut i = 0
  while i < n {
    if Array::get(fingerprint_file_memo_paths, i) == path {
      if Array::get(fingerprint_file_memo_tokens, i) == token {
        return Array::get(fingerprint_file_memo_fps, i)
      } else {
        let fp = compact_string_fingerprint(Fs::read_file(path))
        Array::set(fingerprint_file_memo_tokens, i, token)
        Array::set(fingerprint_file_memo_fps, i, fp)
        return fp
      }
    } else {
      ()
    }
    i = i + 1
  }
  let fp = compact_string_fingerprint(Fs::read_file(path))
  Array::push(fingerprint_file_memo_paths, path)
  Array::push(fingerprint_file_memo_tokens, token)
  Array::push(fingerprint_file_memo_fps, fp)
  fp
}
