//# Imports

import @vibe/compiler/core {
  Expr, Pat, Subst, Type, TypeDef, TypeEnv, __to_string, types_equal
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  check_expr
}

//# Functions

fn empty_defs_array() -> Array[TypeDef] {
  array_empty()
}

fn run_check(expr: Expr, env: TypeEnv) -> Type with Error {
  let errors = array_empty()
  // check_expr grew a 7th param (the offset->type table); the probe passes
  // an empty one.
  let tytab = array_empty()
  match check_expr(expr, env, empty_defs_array(), SubstEmpty, 0, errors, tytab) {
    (ty, _, _) => if Array::length(errors) > 0 {
      throw(Array::get(errors, 0))
    } else {
      ty
    }
    ,
    _ => CtUnknown
  }
}

fn int_var_name(i: Int) -> String {
  String::concat("x_", __to_string(i))
}

fn build_chained_lets(n: Int) -> Expr {
  let mut i = n
  let mut body = EIdent(int_var_name(1), -1)
  while i >= 1 {
    body = ELet(int_var_name(i), EInt(i), body, -1)
    i = i - 1
  }
  body
}

fn build_deep_binop(n: Int) -> Expr {
  let mut i = n
  let mut acc = EInt(i)
  while i > 1 {
    i = i - 1
    acc = EBinOp("+", EInt(i), acc)
  }
  acc
}

fn build_nested_if(n: Int) -> Expr {
  let mut i = n
  let mut acc = EInt(0)
  while i > 0 {
    acc = EIf(EBool(true), EInt(i), acc)
    i = i - 1
  }
  acc
}

fn build_large_match(n: Int) -> Expr {
  let arms = array_empty()
  let mut i = 0
  while i < n {
    Array::push(arms, (PInt(i), EInt(i * 2)))
    i = i + 1
  }
  Array::push(arms, (PWild, EInt(0 - 1)))
  EMatch(EInt(0), arms)
}

fn build_seq_chain(n: Int) -> Expr {
  let mut i = n
  let mut acc = EInt(0)
  while i > 0 {
    acc = ESeq(EInt(i), acc)
    i = i - 1
  }
  acc
}

fn check_to_int_flag(expr: Expr) -> Int with Error {
  let ty = run_check(expr, EnvEmpty)
  if types_equal(ty, CtInt) {
    1
  } else {
    0
  }
}

export fn probe_check_chained_lets() -> Int with Error {
  check_to_int_flag(build_chained_lets(64))
}

export fn probe_check_deep_binop() -> Int with Error {
  check_to_int_flag(build_deep_binop(64))
}

export fn probe_check_nested_if() -> Int with Error {
  check_to_int_flag(build_nested_if(64))
}

export fn probe_check_large_match() -> Int with Error {
  check_to_int_flag(build_large_match(48))
}

export fn probe_check_seq_chain() -> Int with Error {
  check_to_int_flag(build_seq_chain(96))
}
