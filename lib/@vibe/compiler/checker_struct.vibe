//# Imports

import @vibe/compiler/core {
  Type, TypeDef, TypeExpr, find_typedef
}

import @vibe/core {
  array_empty
}

//# Functions

fn empty_strings() -> Array[String] {
  array_empty()
}

fn array_has_string(arr: Array[String], val: String, i: Int) -> Bool {
  if i >= Array::length(arr) {
    false
  } else if Array::get(arr, i) == val {
    true
  } else {
    array_has_string(arr, val, i + 1)
  }
}

fn get_struct_fields(defs: Array[TypeDef], struct_name: String) -> Option[Array[(String, Type)]] {
  match find_typedef(defs, struct_name) {
    Some(td) => match td {
      TDStruct(_, fields, _, _) => Some(fields),
      TDEnum(_, _, _) => None,
      TDAlias(_, _, _) => None,
      TDEffect(_, _, _) => None,
      TDEffectSet(_, _) => None
    },
    None => None
  }
}

export fn check_struct_arity(defs: Array[TypeDef], struct_name: String, num_args: Int) -> Bool {
  match get_struct_fields(defs, struct_name) {
    Some(fields) => Array::length(fields) == num_args,
    None => true
  }
}

export fn check_record_fields(defs: Array[TypeDef], struct_name: String, field_names: Array[String]) -> Array[String] {
  let unknown = empty_strings()
  match get_struct_fields(defs, struct_name) {
    Some(fields) => {
      let def_names = empty_strings()
      let flen = Array::length(fields)
      let mut fi = 0
      while fi < flen {
        let (name, _) = Array::get(fields, fi)
        Array::push(def_names, name)
        fi = fi + 1
      }
      let nlen = Array::length(field_names)
      let mut ni = 0
      while ni < nlen {
        let fn_name = Array::get(field_names, ni)
        if not(array_has_string(def_names, fn_name, 0)) {
          Array::push(unknown, fn_name)
        }
        ni = ni + 1
      }
      unknown
    },
    None => unknown
  }
}

export fn lookup_struct_field(defs: Array[TypeDef], struct_name: String, field_name: String) -> Type {
  match get_struct_fields(defs, struct_name) {
    Some(fields) => {
      let len = Array::length(fields)
      let mut i = 0
      let mut result = CtUnknown
      while i < len {
        let (name, ty) = Array::get(fields, i)
        if name == field_name {
          result = ty
          i = len
        } else {
          i = i + 1
        }
      }
      result
    },
    None => CtUnknown
  }
}

export fn check_missing_fields(defs: Array[TypeDef], struct_name: String, provided_names: Array[String]) -> Array[String] {
  let missing = empty_strings()
  match get_struct_fields(defs, struct_name) {
    Some(fields) => {
      let flen = Array::length(fields)
      let mut fi = 0
      while fi < flen {
        let (name, _) = Array::get(fields, fi)
        if not(array_has_string(provided_names, name, 0)) {
          Array::push(missing, name)
        }
        fi = fi + 1
      }
      missing
    },
    None => missing
  }
}

export fn check_duplicate_fields(fields: Array[(String, Type)]) -> Array[String] {
  let seen = empty_strings()
  let dupes = empty_strings()
  let len = Array::length(fields)
  let mut i = 0
  while i < len {
    let (name, _) = Array::get(fields, i)
    if array_has_string(seen, name, 0) {
      if not(array_has_string(dupes, name, 0)) {
        Array::push(dupes, name)
      }
    } else {
      Array::push(seen, name)
    }
    i = i + 1
  }
  dupes
}
