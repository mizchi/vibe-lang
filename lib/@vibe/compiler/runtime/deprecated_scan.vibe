//# `#deprecated` marker scan (#1262 / ADR-0101 migration tooling).
//#
//# A declaration annotated with `#deprecated` (optionally
//# `#deprecated("use X instead")`) on the line before it marks the declared
//# name as deprecated. `vibe check` reports every USE of such a name in the
//# checked file as a non-fatal `warning:` line — the check still passes.
//#
//# The scan is TOKEN-level on purpose: it needs no name resolution, works on
//# any file that lexes, and catches uses in every position (call, type
//# annotation, import list) with exact line:col from the lexer's offsets.
//# The trade-offs are documented and accepted for the migration use case
//# (deprecated aliases live in dependency files, uses live in the checked
//# file):
//#
//#   * a LOCAL binding that shadows a deprecated name still warns (names
//#     being migrated are `Ns::method`-shaped, where this cannot happen);
//#   * an `import ... as` alias hides the use (the alias site itself warns);
//#   * declaration sites themselves are skipped by keyword lookahead
//#     (`let`/`fn`/`enum`/`struct`/`type` binders), so a file declaring a
//#     deprecated name does not warn about its own declaration.

//# Imports

import @vibe/compiler/syntax {
  Token, lex_with_starts, offset_to_line_col, peek
}

import @vibe/compiler/core {
  append_builtin_deprecated
}

import @vibe/core {
  array_empty
}

//# Helpers

fn dep_empty_pairs() -> Array[(String, String)] {
  array_empty()
}

fn dep_empty_strs() -> Array[String] {
  array_empty()
}

/// After `#deprecated`, consume an optional `("message")`.
/// Returns (next_pos, message).
fn dep_directive_msg(tokens: Array[Token], j: Int) -> (Int, String) {
  match peek(tokens, j) {
    TLParen => match peek(tokens, j + 1) {
      TString(m) => match peek(tokens, j + 2) {
        TRParen => (j + 3, m),
        _ => (j, "")
      },
      _ => (j, "")
    },
    _ => (j, "")
  }
}

fn dep_simple_name(tokens: Array[Token], pos: Int) -> String {
  match peek(tokens, pos) {
    TIdent(nm) => nm,
    _ => ""
  }
}

/// `fn` declarations may be method-shaped: `fn Ns::method(...)`.
fn dep_qualified_name(tokens: Array[Token], pos: Int) -> String {
  match peek(tokens, pos) {
    TIdent(a) => match peek(tokens, pos + 1) {
      TDoubleColon => match peek(tokens, pos + 2) {
        TIdent(b) => String::concat(a, String::concat("::", b)),
        _ => a
      },
      _ => a
    },
    _ => ""
  }
}

/// The name declared by the statement starting at `pos0` (skipping a leading
/// `export`). "" when no recognizable declaration follows the marker — the
/// marker is then ignored.
fn dep_decl_name(tokens: Array[Token], pos0: Int) -> String {
  let mut pos = pos0
  match peek(tokens, pos) {
    TExport => {
      pos = pos + 1
    }
    _ => ()
  }
  match peek(tokens, pos) {
    TLet => {
      let mut q = pos + 1
      match peek(tokens, q) {
        TMut => {
          q = q + 1
        }
        TRec => {
          q = q + 1
        }
        _ => ()
      }
      dep_simple_name(tokens, q)
    },
    TFn => dep_qualified_name(tokens, pos + 1),
    TEnum => dep_simple_name(tokens, pos + 1),
    TStruct => dep_simple_name(tokens, pos + 1),
    TType => dep_simple_name(tokens, pos + 1),
    TIdent(kw) => if kw == "effect" {
      dep_simple_name(tokens, pos + 1)
    } else {
      ""
    },
    _ => ""
  }
}

/// Collect every `#deprecated`-marked declaration as (name, message).
fn collect_deprecated_decls_tokens(tokens: Array[Token], out: Array[(String, String)]) -> Unit {
  let n = Array::length(tokens)
  let mut i = 0
  while i < n {
    let is_dep = match Array::get(tokens, i) {
      THash => match peek(tokens, i + 1) {
        TIdent(dname) => dname == "deprecated",
        _ => false
      },
      _ => false
    }
    if is_dep {
      let (j, msg) = dep_directive_msg(tokens, i + 2)
      let name = dep_decl_name(tokens, j)
      if name != "" {
        Array::push(out, (name, msg))
      } else {
        ()
      }
      i = j
    } else {
      i = i + 1
    }
  }
}

/// Index of `name` in the deprecated list, or -1.
fn dep_find(deprecated: Array[(String, String)], name: String) -> Int {
  let mut i = 0
  let mut found = 0 - 1
  while found < 0 && i < Array::length(deprecated) {
    let (dn, _) = Array::get(deprecated, i)
    if dn == name {
      found = i
    } else {
      i = i + 1
    }
  }
  found
}

/// How many tokens a declaration keyword at `i` binds (keyword + binder
/// name), so declaration sites do not warn about their own name.
fn dep_binder_skip(tokens: Array[Token], i: Int) -> Int {
  match Array::get(tokens, i) {
    TLet => match peek(tokens, i + 1) {
      TMut => 3,
      TRec => 3,
      _ => 2
    },
    TFn => match peek(tokens, i + 2) {
      TDoubleColon => 4,
      _ => 2
    },
    TEnum => 2,
    TStruct => 2,
    TType => 2,
    _ => 1
  }
}

fn dep_warning_line(source: String, offset: Int, name: String, msg: String) -> String {
  let (line, col) = offset_to_line_col(source, offset)
  let head = String::concat("warning: line ", String::concat(Int::to_string(line), String::concat(":col ", String::concat(Int::to_string(col), String::concat(": '", String::concat(name, "' is deprecated"))))))
  if msg == "" {
    head
  } else {
    String::concat(head, String::concat(": ", msg))
  }
}

fn matching_brace(tokens: Array[Token], open_pos: Int) -> Int {
  let mut depth = 0
  let mut i = open_pos
  let mut found = 0 - 1
  while found < 0 && i < Array::length(tokens) {
    match Array::get(tokens, i) {
      TLBrace => {
        depth = depth + 1
      },
      TRBrace => {
        depth = depth - 1
        if depth == 0 {
          found = i
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn legacy_handler_warning_line(source: String, offset: Int, effect_name: String) -> String {
  let (line, col) = offset_to_line_col(source, offset)
  String::concat("warning: line ", String::concat(Int::to_string(line), String::concat(":col ", String::concat(Int::to_string(col), String::concat(": legacy handler header is deprecated; move the effect name onto each arm: write `with { ", String::concat(effect_name, "::Op(...) => ... }`"),),),),),)
}

/// Report the ADR-0102 migration spelling without confusing function effect
/// rows (`fn f() with Exception { ... }`) with handler headers. The matching
/// `}` of the `handle` body is found structurally from lexer tokens; only
/// `handle { ... } with Effect { ... }` warns.
export fn legacy_handler_warning_lines(source: String) -> Array[String] with Exception {
  let out = dep_empty_strs()
  let (tokens, starts) = lex_with_starts(source)
  let mut i = 0
  while i < Array::length(tokens) {
    match Array::get(tokens, i) {
      THandle => match peek(tokens, i + 1) {
        TLBrace => {
          let close = matching_brace(tokens, i + 1)
          if close >= 0 {
            match peek(tokens, close + 1) {
              TWith => match peek(tokens, close + 2) {
                TIdent(effect_name) => Array::push(out, legacy_handler_warning_line(source, Array::get(starts, close + 1), effect_name),),
                _ => ()
              },
              _ => ()
            }
          } else {
            ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Scan `tokens` (with `starts` offsets into `source`) for uses of any
/// deprecated name; one formatted warning line per use, in source order.
/// `base` shifts every reported offset: 0 for a whole-file scan, and the
/// snippet's absolute source offset when re-scanning a string
/// interpolation's expression fragment (whose own starts are
/// fragment-relative). Nested interpolations accumulate their bases.
fn deprecated_use_warnings_tokens(source: String, tokens: Array[Token], starts: Array[Int], deprecated: Array[(String, String)], base: Int) -> Array[String] {
  let out = dep_empty_strs()
  if Array::length(deprecated) == 0 {
    return out
  } else {
    ()
  }
  let n = Array::length(tokens)
  let mut i = 0
  while i < n {
    match Array::get(tokens, i) {
      TLet => {
        i = i + dep_binder_skip(tokens, i)
      }
      TFn => {
        i = i + dep_binder_skip(tokens, i)
      }
      TEnum => {
        i = i + dep_binder_skip(tokens, i)
      }
      TStruct => {
        i = i + dep_binder_skip(tokens, i)
      }
      TType => {
        i = i + dep_binder_skip(tokens, i)
      }
      TIdent(name) => {
        // combine one `A::b` level so qualified uses match qualified decls
        let is_qual = match peek(tokens, i + 1) {
          TDoubleColon => match peek(tokens, i + 2) {
            TIdent(_) => true,
            _ => false
          },
          _ => false
        }
        let full = if is_qual {
          match peek(tokens, i + 2) {
            TIdent(b) => String::concat(name, String::concat("::", b)),
            _ => name
          }
        } else {
          name
        }
        let hit = dep_find(deprecated, full)
        let hit2 = if hit < 0 && is_qual {
          dep_find(deprecated, name)
        } else {
          hit
        }
        if hit2 >= 0 {
          let (dn, dm) = Array::get(deprecated, hit2)
          Array::push(out, dep_warning_line(source, base + Array::get(starts, i), dn, dm))
        } else {
          ()
        }
        if is_qual {
          i = i + 3
        } else {
          i = i + 1
        }
      },
      TStringInterp(iparts, ioffsets) => {
        // #2203: a deprecated name used inside a string interpolation
        // (`"\{String::from_char_code(n)}"`) must warn like any other use --
        // this arm was the measured blind spot behind "no warning fires".
        // Expression snippets carry their absolute source offset (#947);
        // literal chunks carry -1 and hold no code. Each snippet re-lexes in
        // isolation and scans recursively with its base accumulated, so a
        // nested interpolation still reports real file positions. A snippet
        // that fails to re-lex is skipped: a warning pass must never fail a
        // clean check (unreachable in practice -- the whole file already
        // lexed once to produce this token).
        let mut pi = 0
        while pi < Array::length(iparts) {
          let part_base = Array::get(ioffsets, pi)
          if part_base >= 0 {
            handle {
              let (sub_tokens, sub_starts) = lex_with_starts(Array::get(iparts, pi))
              let sub = deprecated_use_warnings_tokens(source, sub_tokens, sub_starts, deprecated, base + part_base)
              let mut wi = 0
              while wi < Array::length(sub) {
                Array::push(out, Array::get(sub, wi))
                wi = wi + 1
              }
            } with { Exception::Throw(_) => () }
          } else {
            ()
          }
          pi = pi + 1
        }
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  out
}

//# Entry point

/// Warnings for every use, in `entry_source`, of a name whose declaration is
/// marked `#deprecated` in `entry_source` itself or in any of `dep_sources`.
export fn deprecated_warning_lines(entry_source: String, dep_sources: Array[String]) -> Array[String] with Exception {
  deprecated_warning_lines_visible(entry_source, dep_sources, dep_all_names())
}

/// Sentinel for "do not filter": `deprecated_warning_lines` keeps the old
/// every-marker-in-every-dep behaviour, which is right when `dep_sources` is
/// already exactly the set of files the entry imported.
fn dep_all_names() -> Option[Array[String]] {
  None
}

/// Warnings for `entry_source`, honouring a dependency's `#deprecated` marker
/// only when `visible_names` says the entry actually IMPORTED that name.
///
/// Codex review (PR #1713, P2): the caller now passes the whole compile
/// closure (that is what made a PACKAGE's markers reachable at all -- the
/// marker for `HashMap::new_string` lives in a package SIBLING the entry never
/// names). Handing every one of those markers to a token-level scanner is too
/// wide in the other direction: a file that imports something unrelated from
/// `@vibe/core`, then declares and calls its OWN `HashMap::new_string`, would
/// be told to use `MutMap::new_string`. That is a wrong edit, and prescribing
/// wrong edits is worse than staying quiet.
///
/// Markers declared in the ENTRY ITSELF are always honoured -- a file
/// deprecating its own helper needs no import to mean it.
export fn deprecated_warning_lines_visible(entry_source: String, dep_sources: Array[String], visible_names: Option[Array[String]]) -> Array[String] with Exception {
  let deprecated = dep_empty_pairs()
  let (tokens, starts) = lex_with_starts(entry_source)
  collect_deprecated_decls_tokens(tokens, deprecated)
  // Builtins have no `#deprecated` declaration site. Always honour the
  // language-level table (not gated on imports).
  append_builtin_deprecated(deprecated)
  // Contract-only type aliases cannot carry `#deprecated` until a
  // bootstrap bump (seed parse rejects `#` in index.vpkg). Honour the
  // same names here, gated on the entry's imports — a file that never
  // imported `HashMap` must not be told to rename its own type.
  append_visible_legacy_types(deprecated, visible_names)
  let mut d = 0
  while d < Array::length(dep_sources) {
    let dep_marks = dep_empty_pairs()
    let (dtokens, _dstarts) = lex_with_starts(Array::get(dep_sources, d))
    collect_deprecated_decls_tokens(dtokens, dep_marks)
    let mut m = 0
    while m < Array::length(dep_marks) {
      let (mname, mmsg) = Array::get(dep_marks, m)
      let keep = match visible_names {
        None => true,
        Some(names) => dep_names_contain(names, mname)
      }
      if keep {
        Array::push(deprecated, (mname, mmsg))
      } else {
        ()
      }
      m = m + 1
    }
    d = d + 1
  }
  let out = deprecated_use_warnings_tokens(entry_source, tokens, starts, deprecated, 0)
  let syntax_warnings = legacy_handler_warning_lines(entry_source)
  let mut wi = 0
  while wi < Array::length(syntax_warnings) {
    Array::push(out, Array::get(syntax_warnings, wi))
    wi = wi + 1
  }
  out
}

/// ADR-0100 (3) type aliases that live only in index.vpkg.
fn append_legacy_type_deprecated(out: Array[(String, String)]) -> Unit {
  Array::push(out, ("HashMap", "use MutMap"))
  Array::push(out, ("HashSet", "use MutSet"))
  Array::push(out, ("SortedMap", "use MutSortedMap"))
  Array::push(out, ("SortedSet", "use MutSortedSet"))
  Array::push(out, ("ImmutMap", "use MapHamt"))
}

fn append_visible_legacy_types(out: Array[(String, String)], visible_names: Option[Array[String]]) -> Unit {
  let marks = dep_empty_pairs()
  append_legacy_type_deprecated(marks)
  let mut i = 0
  while i < Array::length(marks) {
    let (mname, mmsg) = Array::get(marks, i)
    let keep = match visible_names {
      None => true,
      Some(names) => dep_names_contain(names, mname)
    }
    if keep {
      Array::push(out, (mname, mmsg))
    } else {
      ()
    }
    i = i + 1
  }
}

fn dep_names_contain(names: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(names) {
    if Array::get(names, i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}
