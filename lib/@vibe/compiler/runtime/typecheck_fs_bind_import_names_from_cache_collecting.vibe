export ../../../../lib/@vibe/checker/engine {
  DependencyInterfaceSet
}

export fn dependency_interface_set_new() -> DependencyInterfaceSet {
  engine_dependency_interface_set_new()
}

fn dependency_interface_slot(interfaces: DependencyInterfaceSet, path: String) -> Int {
  engine_dependency_interface_slot(interfaces, path)
}

/// Call only when publishing a new authoritative interface. Re-publication
/// invalidates all derived facts, even at the same path and spelling.
export fn dependency_interface_set_publish(interfaces: DependencyInterfaceSet, path: String, env: TypeEnv) -> Unit {
  engine_dependency_interface_set_publish(interfaces, path, env)
}

/// A standalone worker owns a fresh set. The serial walk already published
/// stepped dependencies and supplies only any cached frontier not stepped in
/// this walk. Changed stepped products were explicitly replaced on publish.
export fn dependency_interface_set_supply_missing(interfaces: DependencyInterfaceSet, envs: Array[(String, TypeEnv)]) -> Unit {
  engine_dependency_interface_set_supply_missing(interfaces, envs)
}

/// The path resolver sees precisely the job's dependency paths, in their
/// original order. Its environment and all projection facts come from the
/// same published view, so no independent accelerator can replace authority.
export fn build_import_envs_from_interfaces(stmts: Array[Stmt], base_dir: String, interfaces: DependencyInterfaceSet, dependency_paths: Array[String], unresolved: Array[String]) -> (TypeEnv, TypeEnv) with Env {
  engine_build_import_envs_from_interfaces(stmts, base_dir, interfaces, dependency_paths, unresolved)
}

/// #3036: one reference marker for every declaration the published surface
/// names that the published env keeps no node for -- mentioned by an
/// exported value's signature, by an exported trait's method signatures or a
/// retained implementation's target, or named inside a kept declaration --
/// and, transitively, for every declaration THOSE name. An importer compares
/// each member of the closure under its own name (`identity_closure`), so it
/// needs `Inner`'s definition as well as `Outer`'s.
export fn bind_type_reference_definitions(value_surface: Array[String], publication_env: TypeEnv, published: TypeEnv) -> TypeEnv {
  engine_bind_type_reference_definitions(value_surface, publication_env, published)
}

/// Shared by the filesystem and in-memory TypeDb lanes. The latter accepts
/// caller-provided source modules, so it must not fall back to value-only
/// imports once global trait-bound enforcement is enabled.
export fn build_trait_aware_import_env(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv with Env + Exception {
  let unresolved = array_empty()
  let env = build_import_env_collecting(stmts, base_dir, cache, unresolved)
  if Array::length(unresolved) == 0 {
    env
  } else {
    throw(Array::get(unresolved, 0))
  }
}

export fn bind_builtin_shadow_markers(env: TypeEnv, names: Array[String]) -> TypeEnv {
  engine_bind_builtin_shadow_markers(env, names)
}

fn build_import_env(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv with Env + Exception {
  build_trait_aware_import_env(stmts, base_dir, cache)
}

/// `build_import_env`, additionally collecting the imported names the
/// dependency does not export (#1521 -- see
/// `bind_import_names_from_cache_collecting`).
/// #2510 part 2: the arms matched below are the COMPLETE set of statements
/// that bind a name from another module, and `trait_witness_binding_line` reads
/// its tags off this list rather than arguing one. Adding an arm here without
/// a matching tag there lets an impl target silently re-resolve while the
/// witness-set fingerprint stays put.
export fn build_import_envs_collecting(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)], unresolved: Array[String]) -> (TypeEnv, TypeEnv) with Env {
  build_import_envs_from_published_cache(stmts, base_dir, cache, dependency_interface_set_new(), unresolved)
}

/// Use a compile-owned publication set with the actual caller's ordered cache.
/// Only dependencies referenced by this importer need a derived view.
export fn build_import_envs_from_published_cache(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)], interfaces: DependencyInterfaceSet, unresolved: Array[String]) -> (TypeEnv, TypeEnv) with Env {
  for stmt in stmts {
    let imported_path = match stmt {
      SImport(path, _) => Some(path),
      SReExport(path, _) => Some(path),
      _ => None
    }
    match imported_path {
      Some(raw_path) => {
        let resolved = resolve_cached_import_path(base_dir, raw_path, cache)
        if dependency_interface_slot(interfaces, resolved) < 0 {
          match typecheck_fs_lookup_env_cache(cache, resolved) {
            Some(env) => dependency_interface_set_publish(interfaces, resolved, env),
            None => ()
          }
        } else {
          ()
        }
      },
      _ => ()
    }
  }
  build_import_envs_using_interfaces(stmts, base_dir, cache, interfaces, unresolved)
}

fn build_import_envs_using_interfaces(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)], interfaces: DependencyInterfaceSet, unresolved: Array[String]) -> (TypeEnv, TypeEnv) with Env {
  engine_build_import_envs_using_interfaces(stmts, base_dir, cache, interfaces, unresolved)
}

fn build_import_env_collecting(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)], unresolved: Array[String]) -> TypeEnv with Env {
  let (local_env, _) = build_import_envs_collecting(stmts, base_dir, cache, unresolved)
  local_env
}

/// Build both the lexical import environment and the declaration projection
/// that exists only while publishing aliased re-exports. Callers that publish
/// a checked module must retain both halves until the public env is built.
export fn build_trait_aware_import_envs(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> (TypeEnv, TypeEnv) with Env + Exception {
  let unresolved = array_empty()
  let envs = build_import_envs_collecting(stmts, base_dir, cache, unresolved)
  if Array::length(unresolved) == 0 {
    envs
  } else {
    throw(Array::get(unresolved, 0))
  }
}

export fn type_diagnostic_display(path: String, source: String, located_msg: String) -> (String, String) with Exception {
  engine_type_diagnostic_display(path, source, located_msg)
}

/// A materialized #1840 types stub can appear in a module's resolved deps
/// without ever being seeded (manifest collect lists the contract, not the
/// generated `.vibe/build/vpkg_types/` file). Load it from disk so the
/// walk can check it instead of projecting a missing env row (#1921).
export fn load_planned_module_source(rdb: RippleDb, path: String) -> (RippleDb, Option[String]) with Env + Exception + Fs {
  match ripple_get_source(rdb, path) {
    Some(source) => (rdb, Some(source)),
    None =>
    if is_vpkg_types_stub_path(path) && Fs::exists(path) {
      let source = ingest_source_text_fs(path, cache_read_source_fs(path))
      (ripple_set_source(rdb, path, source), Some(source))
    } else {
      (rdb, None)
    }
  }
}

/// Project the coordinator's accumulated environment cache onto exactly the
/// resolved direct dependency sequence that the module header produced.
///
/// Order and duplicate paths are preserved verbatim. lookup_env_cache's
/// first-match rule is intentional: it is the same rule build_import_env uses,
/// so a duplicate cache path cannot select one interface while TDRE9 keys a
/// different one. A missing row is an infrastructure error, never EnvEmpty:
/// continuing would let an unreadable dependency silently weaken checking.
export fn project_exact_dependency_envs(deps: Array[String], full_cache: Array[(String, TypeEnv)]) -> Array[(String, TypeEnv)] with Exception {
  let projected = array_empty()
  let mut i = 0
  while i < Array::length(deps) {
    let dep_path = Array::get(deps, i)
    match typecheck_fs_lookup_env_cache(full_cache, dep_path) {
      Some(dep_env) => Array::push(projected, (dep_path, dep_env)),
      None => throw(String::concat("type_db: missing resolved dependency environment: ", dep_path))
    }
    i = i + 1
  }
  projected
}

/// Test-only semantic seam: production projects with the same helper and then
/// gives this exact table to build_import_env through ModuleJob.dep_envs.
export fn projected_import_env_for_test(source: String, path: String, deps: Array[String], full_cache: Array[(String, TypeEnv)]) -> TypeEnv with Env + Exception {
  let dep_envs = project_exact_dependency_envs(deps, full_cache)
  build_import_env(parse_program_with_path(path, source), dir_of_path(path), dep_envs)
}

/// The module's typing fingerprint (typing_module_fingerprint, the one
/// spelling of the formula) over the per-compile memo of its source
/// fingerprint: the leaf-fingerprint probe already asked the memo for this
/// path and text, so the text is hashed once per compile, not once more
/// behind a prefix here.
export fn typecheck_fs_build_fingerprint(path: String, source: String, dep_fps: Array[(String, String)], semantics_seed: String) -> String {
  engine_typecheck_fs_build_fingerprint(path, source, dep_fps, semantics_seed)
}

export fn copy_string_array(items: Array[String]) -> Array[String] {
  // Iterative push: previous recursive Array::concat(acc, [x]) was
  // O(N^2) — copied the full prefix on each step.
  let out = empty_stack()
  let mut i = 0
  let len = Array::length(items)
  while i < len {
    Array::push(out, Array::get(items, i))
    i = i + 1
  }
  out
}
