name = @vibe/compiler/runtime/typecheck_walk
version = 0.0.1
description =
  #|Dependency-ordered module checking, independent of source and cache providers.
deps = {
  @vibe/compiler/core : 0.0.1
  @vibe/compiler/incremental : 0.0.1
  @vibe/compiler/module_graph : 0.0.1
  @vibe/core : 0.2.0
}

generated_hash =

import @vibe/compiler/core {
  TypeEnv
}
import @vibe/compiler/incremental {
  RippleDb
}

struct ModuleWalkState {
  rdb: RippleDb;
  env_cache: Array[(String, TypeEnv)];
  dep_sources: Array[(String, String)];
  parse_count: Int
}

// Providers own module checking/cache IO and publication observations. A
// throwing provider returns its incoming state plus the error; the core
// raises it outside the provider arm. This keeps handler arms non-throwing.
effect ModuleWalk {
  Planned(Array[String], Array[Int], Array[(String, Array[String])]) -> Unit;
  Visit(Int) -> Array[Int];
  Step(Array[(String, String)], ModuleWalkState, String) -> (String, ModuleWalkState, Option[String]);
  Published(String, String, ModuleWalkState, Int) -> Unit;
  Failed(String) -> Unit;
  Complete -> Unit;
  Finish(ModuleWalkState, String) -> Option[String]
}

fn run_module_typecheck_walk(edges: Array[(String, Array[String])], planning_diagnostics: Array[(String, String)], initial: ModuleWalkState, root: String, collect_diagnostics: Bool) -> String with Exception + ModuleWalk

fn cached_module_dependencies(rdb: RippleDb, source_cache: Array[(String, String)], path: String, source: String) -> Option[Array[String]]
