import @vibe/checker/transport {
  append_checked_lowering_text, decode_checked_lowering, encode_checked_lowering
}

/// Preserve the runtime appender while the pure codec has its own unit.
export fn append_module_typed_lowering_text(parts: Array[String], offsets: Array[Int], eq_offs: Array[Int], eq_keys: Array[String]) -> Unit {
  append_checked_lowering_text(parts, offsets, eq_offs, eq_keys)
}

/// Preserve the runtime wire bytes through the shared checked codec.
export fn module_typed_lowering_text(offsets: Array[Int], eq_offs: Array[Int], eq_keys: Array[String]) -> String {
  encode_checked_lowering(offsets, eq_offs, eq_keys)
}

/// Preserve the runtime's complete-record refusal through the checked codec.
export fn parse_module_typed_lowering_offsets_text(text: String) -> Option[(Array[Int], Array[Int], Array[String])] {
  decode_checked_lowering(text)
}
