//# Imports

// #947: regression coverage for the `vibe type-at` / `vibe binding-at` (LSP
// hover / rename-references) position-mapping fixes — EOL-clamp, line-0,
// string-interpolation offset, and CRLF. See type_at.vibe / binding_at.vibe
// (line_col_to_offset / bind_line_col_to_offset) and
// lib/@vibe/parser/parser_expr_primary.vibe (build_interp_expr /
// shift_expr_offsets) for the fixes these tests pin down.

import ./type_at.vibe {
  type_at_source
}

import ./binding_at.vibe {
  binding_occurrences
}

import ./doc_at.vibe {
  doc_at_source
}

//# Functions

fn occ_len(occ: Array[(Int, Int)]) -> Int {
  Array::length(occ)
}

fn occ_contains(occ: Array[(Int, Int)], start: Int, end: Int) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(occ) {
    let (s, e) = Array::get(occ, i)
    if s == start && e == end {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

//# Misc

/// --- Item 1: col past end-of-line must NOT spill into the next line's
/// identifier -- it must clamp to "no result" (empty), not
/// `linestart + col - 1`.
///   line 1 (52 chars): export let add = (a: Int, b: Int) -> Int { a + b }
///   line 2:            export let subtract = (a: Int, b: Int) -> Int { a - b }
/// Column 63 on line 1 is far past line 1's own 52 characters; under the old
/// unclamped math `off = 0 + (63 - 1) = 62`, which lands inside "subtract" on
/// line 2 (offset 62) -- a col-past-EOL query silently resolving to an
/// unrelated identifier one line down.
test "type-at: col past end-of-line clamps to empty, does not spill into next line" {
  let src = "export let add = (a: Int, b: Int) -> Int { a + b }\nexport let subtract = (a: Int, b: Int) -> Int { a - b }\n"
  assert(type_at_source(src, 1, 63) == "")
  assert(occ_len(binding_occurrences(src, 1, 63)) == 0)
  // Sanity: querying the real position of `subtract` still resolves.
  assert(type_at_source(src, 2, 12) == "(Int, Int) -> Int")
}

/// --- Item 1: line 0 is out of range (1-based) and must yield empty, not
/// alias into line 1 via `linestart(=0) + col - 1`.
test "type-at: line 0 (invalid, 1-based) yields empty, does not alias to line 1" {
  let src = "export let add = (a: Int, b: Int) -> Int { a + b }\n"
  assert(type_at_source(src, 0, 12) == "")
  assert(occ_len(binding_occurrences(src, 0, 12)) == 0)
  // Sanity: the same column on the real line 1 resolves to `add`.
  assert(type_at_source(src, 1, 12) == "(Int, Int) -> Int")
}

/// --- Item 2: an identifier referenced inside a string interpolation
/// `\{...}` must resolve to its REAL source position, not a bogus span at
/// file-start offset 0 (previously: the interpolation fragment was re-lexed
/// in isolation, so its EIdent's offset was relative to the fragment (0),
/// colliding with whatever real declaration happened to sit at file offset 0
/// -- a rename using that span would have corrupted the file start).
///   offset 0..3   "let "
///   offset 4..7   "name"        (declaration)
///   offset 19..48 "let greeting = \"hello \{name}\"\n"
///   offset 43..46 "name"        (reference inside \{...})
test "binding-at: identifier inside string interpolation resolves to its real span, not offset 0" {
  let src = "let name = \"world\"\nlet greeting = \"hello \\{name}\"\n"
  let occ = binding_occurrences(src, 1, 5)
  // Exactly the declaration and the interpolation-internal use -- no extra
  // (bogus) entries, in particular none starting at 0.
  assert(occ_len(occ) == 2)
  assert(occ_contains(occ, 4, 8))
  assert(occ_contains(occ, 43, 47))
  assert(not(occ_contains(occ, 0, 4)))
}

test "type-at: identifier inside string interpolation resolves its type" {
  let src = "let name = \"world\"\nlet greeting = \"hello \\{name}\"\n"
  assert(type_at_source(src, 2, 25) == "String")
}

/// Codex P2 on #975: `parse_recur` anchors a fragment parse's located nodes at
/// outer_starts[fragment-token-index] -- the OUTER file's token table indexed
/// by the FRAGMENT's token positions -- which only lined up for a single token
/// sitting exactly at the fragment start. A leading space (`\{ name}`) or a
/// multi-token expression (`\{a + b}`) shifted spans onto the wrong
/// characters. Now each fragment is lexed with its own starts table and
/// remapped (remap_frag_off), so every token lands on its real position.
///   line 2 = "let greeting = \"hello \{ name}\"" starting at offset 19;
///   the fragment " name" starts at 43, so `name` spans 44..48.
test "binding-at: interpolation fragment with a LEADING SPACE resolves the real span" {
  let src = "let name = \"world\"\nlet greeting = \"hello \\{ name}\"\n"
  let occ = binding_occurrences(src, 1, 5)
  assert(occ_len(occ) == 2)
  assert(occ_contains(occ, 4, 8))
  assert(occ_contains(occ, 44, 48))
}

///   line 3 = "let s = \"\{a + b}\"" starting at offset 20; fragment
///   "a + b" starts at 31: `a` at 31..32, `b` at 35..36.
test "binding-at: MULTI-TOKEN interpolation fragment resolves each identifier's real span" {
  let src = "let a = 1\nlet b = 2\nlet s = \"\\{a + b}\"\n"
  let occ_a = binding_occurrences(src, 1, 5)
  assert(occ_len(occ_a) == 2)
  assert(occ_contains(occ_a, 4, 5))
  assert(occ_contains(occ_a, 31, 32))
  let occ_b = binding_occurrences(src, 2, 5)
  assert(occ_len(occ_b) == 2)
  assert(occ_contains(occ_b, 14, 15))
  assert(occ_contains(occ_b, 35, 36))
  // Hovering `b` INSIDE the fragment (line 3, col 16 = offset 35) types it.
  assert(type_at_source(src, 3, 16) == "Int")
}

/// --- Item 3: CRLF files must not drift -- `\r` must not be counted as
/// addressable line content (so end-of-line clamping lands on the real
/// content boundary) while still not shifting any other offset (byte offsets
/// are unaffected; `\r` is an ordinary byte like any other, just excluded from
/// the "is this column still inside the line" boundary check).
///   let ab = 1\r\n     -- offsets 0..11 (10 content chars + \r\n)
///   let xy = 2\r\n     -- "xy" at offset 16..18
test "binding-at: CRLF file resolves the correct byte offset" {
  let src = "let ab = 1\r\nlet xy = 2\r\n"
  let occ = binding_occurrences(src, 2, 5)
  assert(occ_len(occ) == 1)
  assert(occ_contains(occ, 16, 18))
}

test "binding-at: CRLF end-of-line clamp does not spill into the next line" {
  let src = "let ab = 1\r\nlet xy = 2\r\n"
  // Column 17 on line 1 is far past line 1's 10 real content chars; under the
  // old unclamped math this used to land exactly on "xy" (offset 16) on line
  // 2 -- the CRLF-file instance of the same col-past-EOL spillover as item 1.
  assert(occ_len(binding_occurrences(src, 1, 17)) == 0)
}

/// Binder recovery must follow lexer identifier tokens, not same-spelled raw
/// text. A comment before the declaration used to steal the binder offset, so
/// querying the call returned the comment plus the call and omitted `fn apply`.
test "binding-at: top-level fn excludes comment and string text and includes its declaration" {
  let src = "// apply: documentation label\nfn apply(x: Int) -> Int { x }\nlet y = apply(1)\nlet text = \"apply\"\n"
  let from_decl = binding_occurrences(src, 2, 4)
  let from_use = binding_occurrences(src, 3, 9)
  // declaration starts after the 30-byte comment line; call starts at 68.
  assert(occ_len(from_decl) == 2)
  assert(occ_contains(from_decl, 33, 38))
  assert(occ_contains(from_decl, 68, 73))
  assert(occ_len(from_use) == 2)
  assert(occ_contains(from_use, 33, 38))
  assert(occ_contains(from_use, 68, 73))
  // Neither the comment at 3 nor the string contents at 89 is an occurrence.
  assert(not(occ_contains(from_use, 3, 8)))
  assert(not(occ_contains(from_use, 89, 94)))
}

test "binding-at: same-spelled local remains separate from the top-level fn" {
  let src = "fn apply(x: Int) -> Int { x }\nfn local() -> Int {\n  let apply = (x: Int) -> Int { x + 1 }\n  apply(1)\n}\nlet y = apply(2)\n"
  let local_occ = binding_occurrences(src, 4, 3)
  let global_occ = binding_occurrences(src, 6, 9)
  assert(occ_len(local_occ) == 2)
  assert(occ_len(global_occ) == 2)
  assert(not(occ_contains(local_occ, 0, 5)))
  assert(occ_contains(global_occ, 3, 8))
}

/// --- doc-at (#854): `///` doc comment lookup via the declaration site
/// binding_at.vibe already recovers. Hovering the declaration name itself
/// resolves the doc; hovering a later USE of the same top-level name resolves
/// it too, since both share the same binding occurrence set.
test "doc-at: hovering the declaration resolves its doc comment" {
  let src = "/// adds two numbers\nlet add = (a: Int, b: Int) -> Int { a + b }\nadd(1, 2)"
  // "add" starts at col 5 on line 2 ("let add ...").
  assert(doc_at_source(src, 2, 5) == "adds two numbers")
}

test "doc-at: hovering a later use of the name resolves the same doc" {
  let src = "/// adds two numbers\nlet add = (a: Int, b: Int) -> Int { a + b }\nadd(1, 2)"
  // "add" on line 3, col 1.
  assert(doc_at_source(src, 3, 1) == "adds two numbers")
}

test "doc-at: no doc comment yields empty" {
  let src = "let add = (a: Int, b: Int) -> Int { a + b }\nadd(1, 2)"
  assert(doc_at_source(src, 1, 5) == "")
}

test "doc-at: no identifier at position yields empty" {
  let src = "/// adds two numbers\nlet add = (a: Int, b: Int) -> Int { a + b }"
  assert(doc_at_source(src, 1, 1) == "")
}

/// #1941 leftover: hovering the callee identifier in `add(1, 2)` must report
/// the function type, not the CallResult (`Int`) recorded at the same offset.
/// `fn add(...)` is `SFnDecl` (lowered to `SLet` for the checker); the call
/// site is an `EIdent` whose offset is also the `ECall` offset.
test "type-at: call-site callee reports the function type, not the call result" {
  let src = "fn add(a: Int, b: Int) -> Int { a + b }\nlet x = add(1, 2)\n"
  // line 2 = "let x = add(1, 2)"; `add` starts at col 9.
  inspect(type_at_source(src, 2, 9), "(Int, Int) -> Int")
  inspect(type_at_source(src, 2, 10), "(Int, Int) -> Int")
}

/// #1941 leftover: hovering the declaration name of `fn add` must report the
/// function type. Binder names are not `EIdent`s; `collect_binding_name_hits`
/// has to recover `SFnDecl` the same way it recovers `SLet`.
test "type-at: fn declaration name reports the function type" {
  let src = "fn add(a: Int, b: Int) -> Int { a + b }\n"
  // line 1 = "fn add(...)"; `add` starts at col 4.
  inspect(type_at_source(src, 1, 4), "(Int, Int) -> Int")
  inspect(type_at_source(src, 1, 5), "(Int, Int) -> Int")
}

/// #1944 leftover: `doc_at_source` goes through `binding_occurrences`, and
/// `bind_walk_stmt` only recorded `SLet` / `SLetMut`. Hovering a struct
/// declaration name therefore produced zero occurrences and `""`.
///   line 1 = "/// a 2-d point" (15 bytes + newline)
///   line 2 = "struct Point { x: Int; y: Int }"
///   `Point` starts at col 8 / offset 23.
test "doc-at: hovering a struct declaration resolves its doc comment" {
  let src = "/// a 2-d point\nstruct Point { x: Int; y: Int }\n"
  inspect(doc_at_source(src, 2, 8), "a 2-d point")
}

test "binding-at: struct declaration name includes its declaration span" {
  let src = "/// a 2-d point\nstruct Point { x: Int; y: Int }\n"
  let occ = binding_occurrences(src, 2, 8)
  assert(occ_contains(occ, 23, 28))
}

/// `enum` is `SEnum`, also dropped by `bind_walk_stmt`'s `_` arm.
///   line 1 = "/// a color" (11 bytes + newline)
///   line 2 = "enum Color { Red; Blue }"
///   `Color` starts at col 6 / offset 17.
test "doc-at: hovering an enum declaration resolves its doc comment" {
  let src = "/// a color\nenum Color { Red; Blue }\n"
  inspect(doc_at_source(src, 2, 6), "a color")
}

test "binding-at: enum declaration name includes its declaration span" {
  let src = "/// a color\nenum Color { Red; Blue }\n"
  let occ = binding_occurrences(src, 2, 6)
  assert(occ_contains(occ, 17, 22))
}

/// `type` is `STypeAlias`.
///   line 1 = "/// an id" (9 bytes + newline)
///   line 2 = "type UserId = Int"
///   `UserId` starts at col 6 / offset 15.
test "doc-at: hovering a type alias declaration resolves its doc comment" {
  let src = "/// an id\ntype UserId = Int\n"
  inspect(doc_at_source(src, 2, 6), "an id")
}

test "binding-at: type alias declaration name includes its declaration span" {
  let src = "/// an id\ntype UserId = Int\n"
  let occ = binding_occurrences(src, 2, 6)
  assert(occ_contains(occ, 15, 21))
}

/// `fn add(...)` is parsed as `SFnDecl` then lowered to `SLet` by
/// `parse_program_located` (`lower_fn_decl_stmt`). Binding-at already
/// recovers that `SLet`, so this should stay green without an `SFnDecl`
/// arm. Pin it so a future parse-preserving change does not regress doc-at.
test "doc-at: hovering a fn declaration resolves its doc comment" {
  let src = "/// adds two numbers\nfn add(a: Int, b: Int) -> Int { a + b }\n"
  inspect(doc_at_source(src, 2, 4), "adds two numbers")
}

test "type-at: function name is not stolen from a same-name call result" {
  let src = "export let add = (a: Int, b: Int) -> Int { a + b }\nfn main() -> Int { add(1, 2) }\n"
  assert(type_at_source(src, 1, 12) == "(Int, Int) -> Int")
}

test "type-at: a comment let-star is not a binder" {
  let src = "// let* dead = o\nfn f(o: Option[Int]) -> Option[Int] {\n  let* x = o\n  Some(x + 1)\n}\n"
  assert(type_at_source(src, 1, 8) == "")
}

test "type-at: let-star binder has the unwrapped payload type" {
  let src = "fn f(o: Option[Int]) -> Option[Int] {\n  let* x = o\n  Some(x + 1)\n}\n"
  assert(type_at_source(src, 2, 8) == "Int")
}

test "type-at: earlier let-star x is not stolen by a later x" {
  let src = "fn f(o: Option[Int]) -> Option[Int] {\n  let* x = o\n  Some(x + 1)\n}\nfn g(s: Option[String]) -> Option[String] {\n  let* x = s\n  Some(x)\n}\n"
  assert(type_at_source(src, 2, 8) == "Int")
}

test "binding-at: let-star binder includes the written name and its uses" {
  let src = "fn f(o: Option[Int]) -> Option[Int] {\n  let* x = o\n  Some(x + 1)\n}\n"
  let occ = binding_occurrences(src, 2, 8)
  assert(occ_len(occ) >= 2)
}

test "binding-at: nested let-star binders are distinct" {
  let src = "fn f(o: Option[Option[Int]]) -> Option[Int] {\n  let* outer = o\n  let* inner = outer\n  Some(inner)\n}\n"
  let outer_occ = binding_occurrences(src, 2, 8)
  let inner_occ = binding_occurrences(src, 3, 8)
  assert(occ_len(outer_occ) >= 2)
  assert(occ_len(inner_occ) >= 2)
  assert(type_at_source(src, 2, 8) != "")
  assert(type_at_source(src, 3, 8) != "")
}
