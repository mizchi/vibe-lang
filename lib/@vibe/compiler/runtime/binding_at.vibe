//# Imports

// `vibe binding-at` — AST-accurate, scope-aware binding occurrences: the
// foundation for scope-precision rename / references (テーマ4). Given a
// (line, col), locate the identifier under the cursor and return the source
// spans of every occurrence that resolves to the SAME binding — not merely the
// same NAME.
//
// Why this is better than a text scan: occurrences are taken from the real
// parsed AST, so there are NO false matches inside string literals, comments, or
// as substrings of a longer word — only actual identifier nodes count.
//
// SCOPE AWARENESS (テーマ4): a scope-stack walk resolves every `EIdent(name,off)`
// REFERENCE to the nearest enclosing introduction of `name` — a `let` / `let mut`
// local, a function/lambda parameter, a `for` binder, a `loop` parameter, or a
// match/handle pattern binder. Each introduction gets a unique binding id;
// references that resolve to the same introduction share it, so two distinct
// same-named locals (e.g. `x` in one function vs `x` in another, or a shadowing
// inner `let x`) are NOT conflated. A reference that resolves to no local
// introduction is treated as a module-level / free name and grouped FILE-WIDE by
// name (canonical key 0), so top-level `export let f` references across the file
// still resolve together.
//
// BINDER OFFSET RECOVERY: the AST stores binder NAMES as plain Strings without
// offsets (only `EIdent` carries an offset). We recover a binder's source span by
// scanning the lexer's IDENTIFIER tokens for the next matching name from a
// monotonically-advancing floor, walking constructs in source order. Raw text
// is deliberately never searched: comments and strings are not bindings.
//
// FALLBACK (honest): for `match`/`handle` arms whose patterns introduce nested
// sub-binders (ctor / tuple / struct / or patterns) the names ARE introduced into
// scope so references resolve correctly, but if a particular binder's source
// offset cannot be recovered from the floor its own occurrence span is omitted
// (the rename set may miss the binder site itself, never a crash). Resolution
// never crashes: any failure is swallowed and yields an empty list.
//
// All strings are built with String::concat only (never `+`, never "\{x}"
// interpolation): both mis-codegen to NUL here.

import @vibe/compiler/core {
  Expr, Pat, Stmt
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/syntax {
  Token, lex_with_offsets, parse_program_located
}

//# Functions

/// 1-based (line, col) -> 0-based char offset. Mirror of type_at.vibe's
/// line_col_to_offset (kept in sync — see its comment for the full rationale):
/// count newlines to reach the target line, add (col - 1). Returns -1
/// (invalid / no position) rather than clamping (#947) for `line`/`col` < 1,
/// `line` beyond EOF, or `col` past the end of that line's content (previously
/// unclamped, so a large `col` silently resolved into the NEXT line's
/// identifier). CRLF: a line's addressable content excludes a trailing '\r'
/// before the '\n', so query positions on CRLF files don't drift.
fn bind_line_col_to_offset(source: String, line: Int, col: Int) -> Int {
  if line < 1 || col < 1 {
    -1
  } else {
    let len = String::length(source)
    let mut i = 0
    let mut cur_line = 1
    while cur_line < line && i < len {
      if String::char_code_at(source, i) == 10 {
        cur_line = cur_line + 1
      } else {
        ()
      }
      i = i + 1
    }
    if cur_line < line {
      -1
    } else {
      let mut line_end = i
      while line_end < len && String::char_code_at(source, line_end) != 10 {
        line_end = line_end + 1
      }
      let content_end = if line_end > i && String::char_code_at(source, line_end - 1) == 13 {
        line_end - 1
      } else {
        line_end
      }
      let off = i + (col - 1)
      if off > content_end {
        -1
      } else {
        off
      }
    }
  }
}

/// A located occurrence resolved to a binding:
///   BindHit(name, off, key)
/// where `off` is the start source offset (its span is [off, off+length(name)))
/// and `key` is the canonical binding id this occurrence resolves to. key 0 means
/// "module-level / free name, grouped file-wide by name". `off` is -1 for
/// synthetic / non-located nodes, which the search ignores.
enum BindHit {
  BindHit(String, Int, Int)
}

fn bind_empty_hits() -> Array[BindHit] {
  array_empty()
}

/// Find the first identifier token named `name` at or after `from`. The lexer
/// has already removed comments and kept string contents inside TString, so
/// neither can steal a binder's source span.
fn bind_find_ident_token(tokens: Array[Token], starts: Array[Int], name: String, from: Int) -> Int {
  let mut i = 0
  let mut found = -1
  while found < 0 && i < Array::length(tokens) {
    let off = Array::get(starts, i)
    if off >= from {
      match Array::get(tokens, i) {
        TIdent(token_name) => if token_name == name {
          found = off
        } else {
          ()
        },
        _ => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Mutable walk state threaded through the AST traversal:
///   hits        — collected occurrences (references + recovered binders)
///   scope_names — scope-stack of in-scope binder names (parallel to scope_ids)
///   scope_ids   — scope-stack of binder ids (parallel to scope_names)
///   floor       — boxed monotonically-advancing scan floor for binder recovery
///   tokens      — lexer tokens (comments/string contents excluded as binders)
///   starts      — token source offsets, parallel to tokens
///
/// Binding ids are NOT a separate counter: each binder's canonical id is its
/// recovered source offset + 1 (unique per binder, and >= 1 so it never collides
/// with the module/free key 0). This avoids a separate mutable id-counter field.
struct BindState {
  hits: Array[BindHit];
  scope_names: Array[String];
  scope_ids: Array[Int];
  floor: Array[Int];
  tokens: Array[Token];
  starts: Array[Int]
}

/// A fresh single-cell mutable Int array holding `v` (a poor-man's mutable box).
/// Built via the slice+push idiom so the cell is a heap array supporting
/// Array::set, not a static read-only literal.
fn bind_box_int(v: Int) -> Array[Int] {
  let arr = array_empty()
  Array::push(arr, v)
  arr
}

fn bind_new_state(tokens: Array[Token], starts: Array[Int]) -> BindState {
  BindState::{
    hits: bind_empty_hits(),
    scope_names: array_empty(),
    scope_ids: array_empty(),
    floor: bind_box_int(0),
    tokens: tokens,
    starts: starts
  }
}

/// Resolve `name` to the nearest enclosing scope id, scanning the scope stack from
/// the top (end) down. Returns 0 (module-level / free, grouped file-wide) when no
/// local introduction is in scope.
fn bind_resolve(st: BindState, name: String) -> Int {
  let n = Array::length(st.scope_names)
  let mut i = n - 1
  let mut found = 0
  while i >= 0 && found == 0 {
    if Array::get(st.scope_names, i) == name {
      found = Array::get(st.scope_ids, i)
    } else {
      ()
    }
    i = i - 1
  }
  found
}

/// Pop the scope stack back down to `mark` entries.
fn bind_pop_scope(st: BindState, mark: Int) -> Unit {
  Array::truncate(st.scope_names, mark)
  Array::truncate(st.scope_ids, mark)
}

/// Recover a binder's source offset (from the scan floor forward), record it as an
/// occurrence, advance the floor past it, and return its unique binding id (off+1,
/// always >= 1; or 0 when the offset cannot be recovered — see file header
/// FALLBACK note). Does NOT push to scope — callers control when the binder enters
/// scope (e.g. a non-recursive `let x = v` must recover x's offset textually
/// before v, yet not have x in scope while walking v).
fn bind_recover_binder(st: BindState, name: String) -> Int {
  let from = Array::get(st.floor, 0)
  let off = bind_find_ident_token(st.tokens, st.starts, name, from)
  let id = if off >= 0 {
    off + 1
  } else {
    0
  }
  if off >= 0 {
    Array::push(st.hits, BindHit(name, off, id))
    Array::set(st.floor, 0, off + String::length(name))
  } else {
    ()
  }
  id
}

/// Push a binder (name, id) onto the current scope.
fn bind_push_binder(st: BindState, name: String, id: Int) -> Unit {
  Array::push(st.scope_names, name)
  Array::push(st.scope_ids, id)
}

/// Introduce a binder: recover its offset/id then immediately push it into scope.
/// Used where the binder's scope begins right at the binder site (params, for /
/// loop binders, match-pattern binders).
fn bind_introduce(st: BindState, name: String) -> Unit {
  let id = bind_recover_binder(st, name)
  bind_push_binder(st, name, id)
}

/// Record a reference `EIdent(name, off)`: resolve it to the nearest enclosing
/// binding (or 0 = module-level/free) and store its located span. Advance the
/// floor past it so later binder recovery does not re-find an earlier position.
fn bind_record_ref(st: BindState, name: String, off: Int) -> Unit {
  if off >= 0 {
    let key = bind_resolve(st, name)
    Array::push(st.hits, BindHit(name, off, key))
    if off >= Array::get(st.floor, 0) {
      Array::set(st.floor, 0, off + String::length(name))
    } else {
      ()
    }
  } else {
    ()
  }
}

/// Record an assignment target `name = ...` / `name op= ...`. Resolve to the
/// enclosing binding and recover the name's source offset from the floor (the
/// target name has no stored offset).
fn bind_record_assign_target(st: BindState, name: String) -> Unit {
  let key = bind_resolve(st, name)
  let from = Array::get(st.floor, 0)
  let off = bind_find_ident_token(st.tokens, st.starts, name, from)
  if off >= 0 {
    Array::push(st.hits, BindHit(name, off, key))
    Array::set(st.floor, 0, off + String::length(name))
  } else {
    ()
  }
}

/// Introduce the names bound by a pattern (PBind directly; nested binders in
/// ctor / tuple / struct / or patterns recursively). Each is introduced into the
/// current scope.
fn bind_introduce_pat(st: BindState, pat: Pat) -> Unit {
  match pat {
    PWild => (),
    PBind(name) => bind_introduce(st, name),
    PInt(_) => (),
    PFloat(_) => (),
    PString(_) => (),
    PBool(_) => (),
    PCtor(_, sub) => bind_introduce_pats(st, sub),
    PTuple(sub) => bind_introduce_pats(st, sub),
    POr(a, b) => {
      bind_introduce_pat(st, a)
      bind_introduce_pat(st, b)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        bind_introduce_pat(st, fp)
        i = i + 1
      }
    }
  }
}

fn bind_introduce_pats(st: BindState, sub: Array[Pat]) -> Unit {
  let mut i = 0
  while i < Array::length(sub) {
    bind_introduce_pat(st, Array::get(sub, i))
    i = i + 1
  }
}

/// The names a pattern binds, in source order (the order bind_introduce_pat
/// recovers them in).
fn bind_pat_names(pat: Pat, out: Array[String]) -> Unit {
  match pat {
    PWild => (),
    PBind(name) => Array::push(out, name),
    PInt(_) => (),
    PFloat(_) => (),
    PString(_) => (),
    PBool(_) => (),
    PCtor(_, sub) => bind_pats_names(sub, out),
    PTuple(sub) => bind_pats_names(sub, out),
    POr(a, b) => {
      bind_pat_names(a, out)
      bind_pat_names(b, out)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        bind_pat_names(fp, out)
        i = i + 1
      }
    }
  }
}

fn bind_pats_names(sub: Array[Pat], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(sub) {
    bind_pat_names(Array::get(sub, i), out)
    i = i + 1
  }
}

/// The smallest located offset among the hits the walk of `e` would record,
/// or -1 when it records none. The walk is undone afterwards (hits truncated,
/// floor restored), so this only LOOKS at where `e` starts in the source.
fn bind_expr_first_off(st: BindState, e: Expr) -> Int {
  let hit_mark = Array::length(st.hits)
  let floor0 = Array::get(st.floor, 0)
  bind_walk_expr(st, e)
  let mut best = -1
  let mut i = hit_mark
  while i < Array::length(st.hits) {
    match Array::get(st.hits, i) {
      BindHit(_, off, _) => if off >= 0 && (best < 0 || off < best) {
        best = off
      } else {
        ()
      }
    }
    i = i + 1
  }
  Array::truncate(st.hits, hit_mark)
  Array::set(st.floor, 0, floor0)
  best
}

/// The start of the `let` that introduces a pattern-first binding whose value
/// begins at `before`: the last `let` / `match` keyword starting in
/// [floor, before), when that keyword is `let`; -1 otherwise. Binder recovery
/// starts HERE rather than at the floor, because tokens between the floor and
/// that `let` -- a record literal's field labels, a field access `.v` -- can
/// spell the same name as a binder.
fn bind_pattern_let_start(st: BindState, before: Int) -> Int {
  let from = Array::get(st.floor, 0)
  let mut found = -1
  let mut i = 0
  while i < Array::length(st.tokens) {
    let off = Array::get(st.starts, i)
    if off >= from && off < before {
      match Array::get(st.tokens, i) {
        TLet => {
          found = off
        },
        TMatch => {
          found = -1
        },
        _ => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// True when `EMatch(s, arms)` was written pattern-FIRST: a `let (a, b) = s`
/// or `let Some(x) = s` lowers to an EMatch whose first arm's pattern precedes
/// the scrutinee in the source, unlike `match s { .. }` or `s is Some(x)`.
/// Walking such a match scrutinee-first would search for the binder AFTER the
/// value and record a later use of the same name as the declaration (#3000).
/// Decided by position, not by shape: the nearest keyword before the
/// scrutinee's first located name must be `let`, and the first binder must
/// sit between the two. A scrutinee with no located name cannot steal a
/// binder, so either order is right and the ordinary one is kept.
fn bind_match_is_pattern_first(st: BindState, s: Expr, arms: Array[(Pat, Expr)]) -> Bool {
  if Array::length(arms) == 0 {
    false
  } else {
    let (pat, _) = Array::get(arms, 0)
    let names = array_empty()
    bind_pat_names(pat, names)
    if Array::length(names) == 0 {
      false
    } else {
      let scrut_off = bind_expr_first_off(st, s)
      let let_off = if scrut_off >= 0 {
        bind_pattern_let_start(st, scrut_off)
      } else {
        -1
      }
      if let_off < 0 {
        false
      } else {
        let binder_off = bind_find_ident_token(st.tokens, st.starts, Array::get(names, 0), let_off)
        binder_off >= 0 && binder_off < scrut_off
      }
    }
  }
}

/// Move the floor to the `let` introducing a pattern-first binding whose value
/// is `v`, when that can be told (see bind_pattern_let_start).
fn bind_floor_to_pattern_let(st: BindState, v: Expr) -> Unit {
  let v_off = bind_expr_first_off(st, v)
  if v_off >= 0 {
    let let_off = bind_pattern_let_start(st, v_off)
    if let_off >= 0 {
      Array::set(st.floor, 0, let_off)
    } else {
      ()
    }
  } else {
    ()
  }
}

/// True for a value the parser synthesised to project one destructured field:
/// `__struct_destr.f`, `__rec_sub_i.j` or `__rec_field(__rec_destr, i)`.
fn bind_is_destr_projection(v: Expr) -> Bool {
  match v {
    EDot(EIdent(_, off), _, _, _) => off < 0,
    ECall(EIdent(callee, _), _, _) => callee == "__rec_field",
    _ => false
  }
}

/// The user-written names of a destructuring chain (see bind_walk_destr), in
/// source order. Synthetic `__`-prefixed intermediates are skipped.
fn bind_destr_names(e: Expr, out: Array[String]) -> Unit {
  match e {
    ELet(n, v, b, _) => if bind_is_destr_projection(v) {
      if String::starts_with(n, "__") {
        ()
      } else {
        Array::push(out, n)
      }
      bind_destr_names(b, out)
    } else {
      ()
    },
    _ => ()
  }
}

/// `let P::{ x, y } = v` / `let record { x, y } = v` lower to
/// `ELet("__struct_destr", v, ELet(x, <projection>, ELet(y, <projection>, rest)))`.
/// The binders are written BEFORE `v`, so recover them first -- walking `v`
/// first moved the floor past them and took a later use of each name for its
/// declaration (#3000) -- then walk `v` with them out of scope, and scope them
/// over the rest.
fn bind_walk_destr(st: BindState, v: Expr, chain: Expr) -> Unit {
  let names = array_empty()
  bind_destr_names(chain, names)
  bind_floor_to_pattern_let(st, v)
  let ids = array_empty()
  let mut i = 0
  while i < Array::length(names) {
    Array::push(ids, bind_recover_binder(st, Array::get(names, i)))
    i = i + 1
  }
  bind_walk_expr(st, v)
  let mark = Array::length(st.scope_names)
  bind_walk_destr_chain(st, chain, names, ids, 0)
  bind_pop_scope(st, mark)
}

fn bind_walk_destr_chain(st: BindState, e: Expr, names: Array[String], ids: Array[Int], next: Int) -> Unit {
  match e {
    ELet(n, v, b, _) => if bind_is_destr_projection(v) {
      bind_walk_expr(st, v)
      if String::starts_with(n, "__") {
        bind_push_binder(st, n, 0)
        bind_walk_destr_chain(st, b, names, ids, next)
      } else {
        bind_push_binder(st, n, Array::get(ids, next))
        bind_walk_destr_chain(st, b, names, ids, next + 1)
      }
    } else {
      bind_walk_expr(st, e)
    },
    _ => bind_walk_expr(st, e)
  }
}

/// Walk a pattern-first match (see bind_match_is_pattern_first): recover the
/// first arm's binders before the scrutinee, keep them OUT of scope while
/// walking it (`let (a, b) = f(a)` reads the outer `a`), then scope them to
/// the first arm's body. Any further arm (the `else` of a let-else / if-let)
/// is an ordinary arm.
fn bind_walk_pattern_first_match(st: BindState, s: Expr, arms: Array[(Pat, Expr)]) -> Unit {
  let (pat, body) = Array::get(arms, 0)
  let names = array_empty()
  bind_pat_names(pat, names)
  bind_floor_to_pattern_let(st, s)
  let ids = array_empty()
  let mut i = 0
  while i < Array::length(names) {
    Array::push(ids, bind_recover_binder(st, Array::get(names, i)))
    i = i + 1
  }
  bind_walk_expr(st, s)
  let mark = Array::length(st.scope_names)
  let mut j = 0
  while j < Array::length(names) {
    bind_push_binder(st, Array::get(names, j), Array::get(ids, j))
    j = j + 1
  }
  bind_walk_expr(st, body)
  bind_pop_scope(st, mark)
  let rest = array_empty()
  let mut k = 1
  while k < Array::length(arms) {
    Array::push(rest, Array::get(arms, k))
    k = k + 1
  }
  bind_walk_arms(st, rest)
}

/// Scope-aware walker. `st.hits` accumulates references (resolved to a binding id)
/// and recovered binders. Every Expr arm is enumerated so a new variant is a
/// compile error here, keeping the collector in sync with the AST.
fn bind_walk_expr(st: BindState, expr: Expr) -> Unit {
  match expr {
    EInt(_) => (),
    EFloat(_) => (),
    EString(_, _) => (),
    EBool(_) => (),
    EIdent(name, off) => bind_record_ref(st, name, off),
    EUnit => (),
    EStringInterp(_) => (),
    ETuple(items) => bind_walk_exprs(st, items),
    EArray(items) => bind_walk_exprs(st, items),
    ERecord(_, fields, _) => bind_walk_field_exprs(st, fields),
    EIf(c, t, e) => {
      bind_walk_expr(st, c)
      bind_walk_expr(st, t)
      bind_walk_expr(st, e)
    },
    ELet(name, v, b, _) => if name == "__struct_destr" || name == "__rec_destr" {
      bind_walk_destr(st, v, b)
    } else {
      // `let name = v; b`: the binder is textually BEFORE v, so recover its
      // offset first (advancing the floor past it), but keep it OUT of scope while
      // walking v — a non-recursive `let x = x + 1` references the OUTER x. Then
      // push it into scope for b only.
      let id = bind_recover_binder(st, name)
      bind_walk_expr(st, v)
      let mark = Array::length(st.scope_names)
      bind_push_binder(st, name, id)
      bind_walk_expr(st, b)
      bind_pop_scope(st, mark)
    },
    ELetRec(name, v, b) => {
      // recursive let: name is in scope for both v and b.
      let mark = Array::length(st.scope_names)
      bind_introduce(st, name)
      bind_walk_expr(st, v)
      bind_walk_expr(st, b)
      bind_pop_scope(st, mark)
    },
    ELetMut(name, v, b, _) => {
      // same binder-before-value ordering as ELet.
      let id = bind_recover_binder(st, name)
      bind_walk_expr(st, v)
      let mark = Array::length(st.scope_names)
      bind_push_binder(st, name, id)
      bind_walk_expr(st, b)
      bind_pop_scope(st, mark)
    },
    EAssign(name, v, b) => {
      // assignment target is a reference to an in-scope binding.
      bind_record_assign_target(st, name)
      bind_walk_expr(st, v)
      bind_walk_expr(st, b)
    },
    EAssignOp(name, _, v, b) => {
      bind_record_assign_target(st, name)
      bind_walk_expr(st, v)
      bind_walk_expr(st, b)
    },
    ESeq(a, b) => {
      bind_walk_expr(st, a)
      bind_walk_expr(st, b)
    },
    EMatch(s, arms) => if bind_match_is_pattern_first(st, s, arms) {
      bind_walk_pattern_first_match(st, s, arms)
    } else {
      bind_walk_expr(st, s)
      bind_walk_arms(st, arms)
    },
    EHandle(s, arms) => {
      bind_walk_expr(st, s)
      bind_walk_arms(st, arms)
    },
    EWhile(c, b) => {
      bind_walk_expr(st, c)
      bind_walk_expr(st, b)
    },
    ELoop(params, b) => {
      // loop params introduce names scoped to b; init exprs are outside scope.
      let mark = Array::length(st.scope_names)
      let mut i = 0
      while i < Array::length(params) {
        let (pname, init) = Array::get(params, i)
        bind_walk_expr(st, init)
        bind_introduce(st, pname)
        i = i + 1
      }
      bind_walk_expr(st, b)
      bind_pop_scope(st, mark)
    },
    EForIn(name, idx_opt, it, b) => {
      // `for x in it` / `for i, x in it`: the binders are written BEFORE the
      // iterable (the index first), so recover them first -- walking `it`
      // first moved the floor past them and took a later use of the same
      // name for the declaration (#3000). They stay out of scope for `it`.
      let idx_id = match idx_opt {
        Some(idx) => bind_recover_binder(st, idx),
        None => 0
      }
      let name_id = bind_recover_binder(st, name)
      bind_walk_expr(st, it)
      let mark = Array::length(st.scope_names)
      match idx_opt {
        Some(idx) => bind_push_binder(st, idx, idx_id),
        None => ()
      }
      bind_push_binder(st, name, name_id)
      bind_walk_expr(st, b)
      bind_pop_scope(st, mark)
    },
    ECall(callee, args, _) => {
      // `let* x = e` lowers to `__try_bind(e, (x) -> rest)`. Source order is
      // the binder then the value; walking the call args as written would
      // recover `x` after `e` and miss the written name.
      match callee {
        EIdent(cname, _) => if cname == "__try_bind" && Array::length(args) == 2 {
          match Array::get(args, 1) {
            EFn(_, _, params, _, _, body) => if Array::length(params) == 1 {
              let (pname, _) = Array::get(params, 0)
              let id = bind_recover_binder(st, pname)
              bind_walk_expr(st, Array::get(args, 0))
              let mark = Array::length(st.scope_names)
              bind_push_binder(st, pname, id)
              bind_walk_expr(st, body)
              bind_pop_scope(st, mark)
            } else {
              bind_walk_expr(st, callee)
              bind_walk_exprs(st, args)
            },
            _ => {
              bind_walk_expr(st, callee)
              bind_walk_exprs(st, args)
            }
          }
        } else {
          bind_walk_expr(st, callee)
          bind_walk_exprs(st, args)
        },
        _ => {
          bind_walk_expr(st, callee)
          bind_walk_exprs(st, args)
        }
      }
    },
    EBinOp(_, l, r, _) => {
      bind_walk_expr(st, l)
      bind_walk_expr(st, r)
    },
    EUnaryOp(_, e) => bind_walk_expr(st, e),
    EFn(_, _, params, _, _, body) => {
      // function / lambda parameters are scoped to body.
      let mark = Array::length(st.scope_names)
      let mut i = 0
      while i < Array::length(params) {
        let (pname, _) = Array::get(params, i)
        bind_introduce(st, pname)
        i = i + 1
      }
      bind_walk_expr(st, body)
      bind_pop_scope(st, mark)
    },
    EDot(e, _, _, _) => bind_walk_expr(st, e),
    ELabeledArg(_, _, v) => bind_walk_expr(st, v),
    EReturn(e) => bind_walk_expr(st, e),
    EBreak(opt) => match opt {
      Some(v) => bind_walk_expr(st, v),
      None => ()
    },
    EContinue(args) => bind_walk_exprs(st, args),
    EMap(fields) => bind_walk_field_exprs(st, fields),
    ESpread(e) => bind_walk_expr(st, e)
  }
}

fn bind_walk_exprs(st: BindState, items: Array[Expr]) -> Unit {
  let mut i = 0
  while i < Array::length(items) {
    bind_walk_expr(st, Array::get(items, i))
    i = i + 1
  }
}

fn bind_walk_field_exprs(st: BindState, fields: Array[(String, Expr)]) -> Unit {
  let mut i = 0
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    bind_walk_expr(st, v)
    i = i + 1
  }
}

/// A match/handle arm: the pattern binders are scoped to the arm body only.
fn bind_walk_arms(st: BindState, arms: Array[(Pat, Expr)]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (pat, e) = Array::get(arms, i)
    let mark = Array::length(st.scope_names)
    bind_introduce_pat(st, pat)
    bind_walk_expr(st, e)
    bind_pop_scope(st, mark)
    i = i + 1
  }
}

/// Record a top-level / module-level binder NAME. These group file-wide (key 0),
/// so all references to the same module name resolve together. We recover the
/// binder's offset from the floor.
fn bind_record_module_binder(st: BindState, name: String) -> Unit {
  let from = Array::get(st.floor, 0)
  let off = bind_find_ident_token(st.tokens, st.starts, name, from)
  if off >= 0 {
    Array::push(st.hits, BindHit(name, off, 0))
    Array::set(st.floor, 0, off + String::length(name))
  } else {
    ()
  }
}

/// Walk a statement. Top-level value bindings (SLet/SLetMut) and type/decl
/// names (SStruct/SEnum/STypeAlias/SFnDecl/STrait/SEffectDef) introduce a
/// module-level name (key 0 => grouped file-wide); we record the binder's
/// located NAME and walk any expression bodies. SModule recurses.
fn bind_walk_stmt(st: BindState, stmt: Stmt) -> Unit {
  match stmt {
    SLet(_, _, name, _, body) => {
      bind_record_module_binder(st, name)
      bind_walk_expr(st, body)
    },
    SLetMut(name, _, body) => {
      bind_record_module_binder(st, name)
      bind_walk_expr(st, body)
    },
    SStruct(_, name, _, _, _, _) => bind_record_module_binder(st, name),
    SEnum(_, name, _, _, _) => bind_record_module_binder(st, name),
    STypeAlias(_, name, _, _) => bind_record_module_binder(st, name),
    // Default parse_program_located lowers SFnDecl to SLet; keep the arm so
    // a preserving parse still records the name and walks contracts.
    SFnDecl(_, name, fn_value, reqs, enss) => {
      bind_record_module_binder(st, name)
      bind_walk_expr(st, fn_value)
      bind_walk_exprs(st, reqs)
      bind_walk_exprs(st, enss)
    },
    STrait(_, name, _, _, _, _) => bind_record_module_binder(st, name),
    SEffectDef(_, name, _, _) => bind_record_module_binder(st, name),
    STest(_, body) => bind_walk_expr(st, body),
    SBench(_, body) => bind_walk_expr(st, body),
    SExpr(e) => bind_walk_expr(st, e),
    SLetPat(pat, body) => {
      // A top-level `let (a, b) = e`: each binder is a module-level name,
      // written before `e` (#3000).
      let names = array_empty()
      bind_pat_names(pat, names)
      let mut i = 0
      while i < Array::length(names) {
        bind_record_module_binder(st, Array::get(names, i))
        i = i + 1
      }
      bind_walk_expr(st, body)
    },
    SModule(_, _, body) => bind_walk_stmts(st, body),
    _ => ()
  }
}

fn bind_walk_stmts(st: BindState, stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    bind_walk_stmt(st, Array::get(stmts, i))
    i = i + 1
  }
}

/// Among all hits whose span [off, off+len(name)) contains `tgt`, pick the one
/// with the largest `off` (innermost / closest start). Returns the (name, key) of
/// that hit, or ("", 0) when none.
fn bind_pick_at(hits: Array[BindHit], tgt: Int) -> (String, Int) {
  let mut best_name = ""
  let mut best_key = 0
  let mut best_off = -1
  let mut i = 0
  while i < Array::length(hits) {
    match Array::get(hits, i) {
      BindHit(name, off, key) => {
        let span_end = off + String::length(name)
        if off >= 0 && off <= tgt && tgt < span_end && off > best_off {
          best_name = name
          best_key = key
          best_off = off
        } else {
          ()
        }
      }
    }
    i = i + 1
  }
  (best_name, best_key)
}

/// Insert (start, end) into `out` keeping it sorted by start ascending and
/// de-duplicated (skip when an identical start is already present — equal starts
/// imply equal spans because the name length is fixed).
fn bind_insert_sorted_unique(out: Array[(Int, Int)], start: Int, end: Int) -> Unit {
  let n = Array::length(out)
  let mut dup = false
  let mut idx = n
  let mut j = 0
  while j < n {
    let (s, _) = Array::get(out, j)
    if s == start {
      dup = true
    } else {
      ()
    }
    if s > start && idx == n {
      idx = j
    } else {
      ()
    }
    j = j + 1
  }
  if dup {
    ()
  } else if idx == n {
    Array::push(out, (start, end))
  } else {
    Array::push(out, Array::get(out, n - 1))
    let mut k = n - 1
    while k > idx {
      Array::set(out, k, Array::get(out, k - 1))
      k = k - 1
    }
    Array::set(out, idx, (start, end))
  }
}

/// Collect the (start, end) source spans of every occurrence that resolves to the
/// SAME binding as the identifier under the cursor at 1-based (line, col). Steps:
///   1. lex + parse located; scope-aware walk collecting located references
///      (resolved to a binding id) plus recovered binders.
///   2. find the (name, key) covering the cursor offset; "" -> no occurrences.
///   3. emit a span for every hit with the same name AND key (key 0 = module /
///      free name grouped file-wide), de-duplicated and sorted by start.
/// AST-accurate and scope-aware (see file header). Any failure is swallowed and
/// yields an empty list.
fn binding_occurrences_impl(source: String, line: Int, col: Int) -> Array[(Int, Int)] with Exception {
  {
    let tgt = bind_line_col_to_offset(source, line, col)
    let empty_out = array_empty()
    if tgt < 0 {
      // Out-of-range (line, col) — see bind_line_col_to_offset (#947): no
      // position to resolve, so no occurrences.
      empty_out
    } else {
      let (tokens, starts, _ends) = lex_with_offsets(source)
      let stmts = parse_program_located(tokens, starts, source)
      let st = bind_new_state(tokens, starts)
      bind_walk_stmts(st, stmts)
      let hits = st.hits
      let (name, key) = bind_pick_at(hits, tgt)
      let out = array_empty()
      if name == "" {
        out
      } else {
        let mut i = 0
        while i < Array::length(hits) {
          match Array::get(hits, i) {
            BindHit(hname, hoff, hkey) => {
              if hname == name && hkey == key && hoff >= 0 {
                bind_insert_sorted_unique(out, hoff, hoff + String::length(hname))
              } else {
                ()
              }
            }
          }
          i = i + 1
        }
        out
      }
    }
  }
}

export fn binding_occurrences(source: String, line: Int, col: Int) -> Array[(Int, Int)] {
  handle {
    binding_occurrences_impl(source, line, col)
  } with { Exception::Throw(_) => array_empty() }
}

/// The declaration sites of every LOCAL binder the scope walk recovers: a
/// match / handle arm pattern binder (`Some(v)`, `Log::Emit(msg)`), a
/// function / lambda parameter, a local `let`, a `for` / `loop` binder and a
/// `let*` binder, as `(name, start byte offset)`. A binder's canonical id is its
/// own offset + 1, which is how a declaration is told apart from a reference
/// that resolves to it. Module-level names (key 0) are left out: `type-at`
/// already finds those through each statement's span.
///
/// `vibe type-at` (#3000) needs these because none of them is an `EIdent`: the
/// AST stores the binder as a bare String, so the hover walk never saw the
/// place a name is introduced and answered nothing there.
export fn local_binder_sites(source: String) -> Array[(String, Int)] {
  handle {
    let (tokens, starts, _ends) = lex_with_offsets(source)
    let stmts = parse_program_located(tokens, starts, source)
    let st = bind_new_state(tokens, starts)
    bind_walk_stmts(st, stmts)
    let out = array_empty()
    let mut i = 0
    while i < Array::length(st.hits) {
      match Array::get(st.hits, i) {
        BindHit(name, off, key) => if off >= 0 && key == off + 1 {
          Array::push(out, (name, off))
        } else {
          ()
        }
      }
      i = i + 1
    }
    out
  } with { Exception::Throw(_) => array_empty() }
}
