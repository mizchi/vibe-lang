//# Imports

// `vibe type-at` — first typed-hover (LSP) consumer of the real EIdent source
// offsets. Given a (line, col), locate the identifier node whose source span
// covers that position, typecheck the program, and return the inferred type of
// that name via env_lookup + type_to_string.
//
// MVP scope / LIMITATION: only env-visible names resolve — top-level bindings
// and imported names that the checker records in the returned TypeEnv. Locals
// and function parameters are NOT in that env (they live in nested scopes during
// inference and are gone by the time check_program returns), so hovering one
// yields "". A future per-node type table would lift this restriction.
//
// All strings are built with String::concat only (never `+`, never "\{x}"
// interpolation): both mis-codegen to NUL here. Ints stringify via
// __to_string.

import @vibe/compiler/core {
  Expr, Pat, Stmt, Subst, Type, TypeEnv, env_lookup, subst_apply, type_to_string
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/checker {
  check_program, check_program_type_table
}

import @vibe/compiler/syntax {
  Token, lex_with_offsets, offset_to_line_col, parse_program_located, parse_program_spans
}

//# Functions

/// 1-based (line, col) -> 0-based char offset, the inverse of offset_to_line_col.
/// `col` is the position WITHIN a line (col 1 = first char of the line, col
/// length+1 = just past the last char — a valid cursor position). We count
/// newlines: the offset of the start of line L is just past the (L-1)th
/// newline, then add (col - 1).
///
/// Returns -1 (invalid / no position) for anything out of range, rather than
/// silently clamping (#947):
///   - `line < 1` or `col < 1`: never valid (1-based).
///   - `line` beyond the last line in `source`.
///   - `col` past the END of that line's content — previously this fell
///     through to `linestart + col - 1` unclamped, which for a large enough
///     `col` landed on/inside the NEXT line (a col-past-EOL query silently
///     resolved to an unrelated identifier a line down).
/// CRLF (#947): a line's addressable content excludes a trailing '\r' before
/// the '\n' — otherwise every query position (and reported span) on a CRLF
/// file drifts by one byte per preceding CRLF line, since the line's `\r` was
/// being counted as ordinary content here but not consistently elsewhere.
fn line_col_to_offset(source: String, line: Int, col: Int) -> Int {
  if line < 1 || col < 1 {
    -1
  } else {
    let len = String::length(source)
    let mut i = 0
    let mut cur_line = 1
    // Advance to the first char of the target line.
    while cur_line < line && i < len {
      if String::char_code_at(source, i) == 10 {
        cur_line = cur_line + 1
      } else {
        ()
      }
      i = i + 1
    }
    if cur_line < line {
      // `line` is past the last line in `source`.
      -1
    } else {
      // i is the start of line `line`. Find the end of its content: the
      // offset of the terminating '\n' (or `len` for the final line), then
      // exclude a preceding '\r' (CRLF) so it isn't counted as content.
      let mut line_end = i
      while line_end < len && String::char_code_at(source, line_end) != 10 {
        line_end = line_end + 1
      }
      let content_end = if line_end > i && String::char_code_at(source, line_end - 1) == 13 {
        line_end - 1
      } else {
        line_end
      }
      let off = i + (col - 1)
      if off > content_end {
        -1
      } else {
        off
      }
    }
  }
}

/// A located identifier hit: name + source span [off, off + length(name)).
/// `off` is -1 for synthetic / non-located idents (those are ignored).
/// `CalleeHit` is an `EIdent` that is the callee of an `ECall` — the type
/// table records CallResult at that same offset (`callee_offset`), so hover
/// must not last-win the call result (#1941).
enum IdentHit {
  IdentHit(String, Int);
  CalleeHit(String, Int)
}

fn empty_hits() -> Array[IdentHit] {
  array_empty()
}

/// Read-only walker over the Expr structure (templated on normalize/index.vibe's
/// `fold_expr`, but it only COLLECTS located EIdent nodes — it never rebuilds the
/// tree). Every variant is enumerated so a new Expr arm is a compile error here,
/// keeping the collector in sync with the AST.
fn collect_expr(expr: Expr, acc: Array[IdentHit]) -> Unit {
  match expr {
    EInt(_) => (),
    EFloat(_) => (),
    EString(_) => (),
    EBool(_) => (),
    EIdent(name, off) => {
      if off >= 0 {
        Array::push(acc, IdentHit(name, off))
      } else {
        ()
      }
    },
    EUnit => (),
    EStringInterp(_) => (),
    ETuple(items) => collect_exprs(items, acc),
    EArray(items) => collect_exprs(items, acc),
    ERecord(_, fields, _) => collect_field_exprs(fields, acc),
    EIf(c, t, e) => {
      collect_expr(c, acc)
      collect_expr(t, acc)
      collect_expr(e, acc)
    },
    ELet(_, v, b, _) => {
      collect_expr(v, acc)
      collect_expr(b, acc)
    },
    ELetRec(_, v, b) => {
      collect_expr(v, acc)
      collect_expr(b, acc)
    },
    ELetMut(_, v, b, _) => {
      collect_expr(v, acc)
      collect_expr(b, acc)
    },
    EAssign(_, v, b) => {
      collect_expr(v, acc)
      collect_expr(b, acc)
    },
    EAssignOp(_, _, v, b) => {
      collect_expr(v, acc)
      collect_expr(b, acc)
    },
    ESeq(a, b) => {
      collect_expr(a, acc)
      collect_expr(b, acc)
    },
    EMatch(s, arms) => {
      collect_expr(s, acc)
      collect_arm_exprs(arms, acc)
    },
    EHandle(s, arms) => {
      collect_expr(s, acc)
      collect_arm_exprs(arms, acc)
    },
    EWhile(c, b) => {
      collect_expr(c, acc)
      collect_expr(b, acc)
    },
    ELoop(params, b) => {
      collect_loop_param_exprs(params, acc)
      collect_expr(b, acc)
    },
    EForIn(_, _, it, b) => {
      collect_expr(it, acc)
      collect_expr(b, acc)
    },
    ECall(callee, args, _) => {
      // Named callees share their EIdent offset with the ECall (`callee_offset`
      // in the parser). Mark them so type-at can prefer the function type
      // over the CallResult the checker records at that offset (#1941).
      match callee {
        EIdent(name, off) => if off >= 0 {
          Array::push(acc, CalleeHit(name, off))
        } else {
          ()
        },
        _ => collect_expr(callee, acc)
      }
      collect_exprs(args, acc)
    },
    EBinOp(_, l, r) => {
      collect_expr(l, acc)
      collect_expr(r, acc)
    },
    EUnaryOp(_, e) => collect_expr(e, acc),
    EFn(_, _, _, _, _, body) => collect_expr(body, acc),
    EDot(e, field, _, field_off) => {
      // #645: the field name is hoverable — EDot carries the field token's
      // offset, and the checker records the projection type at that offset.
      if field_off >= 0 {
        Array::push(acc, IdentHit(field, field_off))
      } else {
        ()
      }
      collect_expr(e, acc)
    },
    ELabeledArg(_, _, v) => collect_expr(v, acc),
    EReturn(e) => collect_expr(e, acc),
    EBreak(opt) => match opt {
      Some(v) => collect_expr(v, acc),
      None => ()
    },
    EContinue(args) => collect_exprs(args, acc),
    EMap(fields) => collect_field_exprs(fields, acc),
    ESpread(e) => collect_expr(e, acc)
  }
}

fn collect_exprs(items: Array[Expr], acc: Array[IdentHit]) -> Unit {
  let mut i = 0
  while i < Array::length(items) {
    collect_expr(Array::get(items, i), acc)
    i = i + 1
  }
}

fn collect_field_exprs(fields: Array[(String, Expr)], acc: Array[IdentHit]) -> Unit {
  let mut i = 0
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    collect_expr(v, acc)
    i = i + 1
  }
}

fn collect_arm_exprs(arms: Array[(Pat, Expr)], acc: Array[IdentHit]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (_, e) = Array::get(arms, i)
    collect_expr(e, acc)
    i = i + 1
  }
}

fn collect_loop_param_exprs(params: Array[(String, Expr)], acc: Array[IdentHit]) -> Unit {
  let mut i = 0
  while i < Array::length(params) {
    let (_, init) = Array::get(params, i)
    collect_expr(init, acc)
    i = i + 1
  }
}

fn collect_stmt(stmt: Stmt, acc: Array[IdentHit]) -> Unit {
  match stmt {
    SLet(_, _, _, _, body) => collect_expr(body, acc),
    SLetMut(_, _, body) => collect_expr(body, acc),
    SFnDecl(_, _, body, _, _) => collect_expr(body, acc),
    STest(_, body) => collect_expr(body, acc),
    SBench(_, body) => collect_expr(body, acc),
    SExpr(e) => collect_expr(e, acc),
    SLetPat(_, body) => collect_expr(body, acc),
    SModule(_, _, body) => collect_stmts(body, acc),
    _ => ()
  }
}

fn collect_stmts(stmts: Array[Stmt], acc: Array[IdentHit]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    collect_stmt(Array::get(stmts, i), acc)
    i = i + 1
  }
}

/// True when `source[off]` is NOT an identifier char (or off is out of range) —
/// i.e. a valid word boundary. Used to match a binding name as a whole word.
fn is_boundary_at(source: String, off: Int) -> Bool {
  if off < 0 || off >= String::length(source) {
    true
  } else {
    let c = String::char_code_at(source, off)
    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
    !is_id
  }
}

/// Find the first whole-word occurrence of `name` in `source[start..end)` and, if
/// found, push a located IdentHit for it. This recovers a source offset for a
/// let-binding NAME, which the parser stores only as a String on the Stmt (it is
/// not an EIdent and so carries no offset). Binding names are exactly the
/// env-visible top-level names, so making their definition site hoverable is the
/// useful case for this MVP.
fn push_binding_name_hit(source: String, start: Int, end: Int, name: String, acc: Array[IdentHit]) -> Unit {
  let nlen = String::length(name)
  if nlen == 0 {
    ()
  } else {
    let limit = if end > String::length(source) {
      String::length(source)
    } else {
      end
    }
    let mut i = if start < 0 {
      0
    } else {
      start
    }
    let mut found = false
    while !found && i + nlen <= limit {
      if String::substring(source, i, i + nlen) == name && is_boundary_at(source, i - 1) && is_boundary_at(source, i + nlen) {
        Array::push(acc, IdentHit(name, i))
        found = true
      } else {
        i = i + 1
      }
    }
  }
}

/// Add located hits for the NAMES of top-level (and module-body) value bindings,
/// using each statement's source span (from parse_program_spans) to scope the
/// whole-word search. SLet / SLetMut / SFnDecl names are env-visible value
/// bindings (`fn f` is SFnDecl; the default parse entry lowers it to SLet, but
/// a preserving parse still hands out SFnDecl — recover both, #1941).
fn collect_binding_name_hits(stmts: Array[Stmt], span_start: Array[Int], span_end: Array[Int], source: String, acc: Array[IdentHit]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    let start = if i < Array::length(span_start) {
      Array::get(span_start, i)
    } else {
      0
    }
    let end = if i < Array::length(span_end) {
      Array::get(span_end, i)
    } else {
      String::length(source)
    }
    match Array::get(stmts, i) {
      SLet(_, _, name, _, _) => push_binding_name_hit(source, start, end, name, acc),
      SLetMut(name, _, _) => push_binding_name_hit(source, start, end, name, acc),
      SFnDecl(_, name, _, _, _) => push_binding_name_hit(source, start, end, name, acc),
      _ => ()
    }
    i = i + 1
  }
}

fn hit_name_off(hit: IdentHit) -> (String, Int) {
  match hit {
    IdentHit(name, off) => (name, off),
    CalleeHit(name, off) => (name, off)
  }
}

fn hit_is_callee(hit: IdentHit) -> Bool {
  match hit {
    CalleeHit(_, _) => true,
    IdentHit(_, _) => false
  }
}

/// Among all collected idents whose span [off, off+len(name)) contains `tgt`,
/// pick the one with the largest `off` (innermost / closest start). Returns ""
/// when no ident covers the position.
fn pick_ident_at(hits: Array[IdentHit], tgt: Int) -> String {
  let mut best_name = ""
  let mut best_off = -1
  let mut i = 0
  while i < Array::length(hits) {
    let (name, off) = hit_name_off(Array::get(hits, i))
    let span_end = off + String::length(name)
    if off <= tgt && tgt < span_end && off > best_off {
      best_name = name
      best_off = off
    } else {
      ()
    }
    i = i + 1
  }
  best_name
}

/// Same selection as pick_ident_at, but returns the chosen ident's source
/// `off` (the innermost / largest-off hit covering `tgt`), or -1 when none.
/// Used to query the per-node type table by the hovered EIdent's offset.
fn pick_ident_off(hits: Array[IdentHit], tgt: Int) -> Int {
  let mut best_off = -1
  let mut i = 0
  while i < Array::length(hits) {
    let (name, off) = hit_name_off(Array::get(hits, i))
    let span_end = off + String::length(name)
    if off <= tgt && tgt < span_end && off > best_off {
      best_off = off
    } else {
      ()
    }
    i = i + 1
  }
  best_off
}

/// True when the innermost hit covering `tgt` is a named call callee.
fn pick_ident_is_callee(hits: Array[IdentHit], tgt: Int) -> Bool {
  let mut best_off = -1
  let mut best_callee = false
  let mut i = 0
  while i < Array::length(hits) {
    let hit = Array::get(hits, i)
    let (name, off) = hit_name_off(hit)
    let span_end = off + String::length(name)
    if off <= tgt && tgt < span_end && off > best_off {
      best_off = off
      best_callee = hit_is_callee(hit)
    } else {
      ()
    }
    i = i + 1
  }
  best_callee
}

/// Look up the recorded type for source offset `off` in the per-node type table
/// produced by check_program_type_table. Returns None when no node recorded that
/// exact offset. When multiple entries share an offset (re-checked node), the
/// last recorded one wins (closest to the final inference state).
fn tytab_lookup(table: Array[(Int, Type)], off: Int) -> Option[Type] {
  let mut found = None
  let mut i = 0
  while i < Array::length(table) {
    let (toff, tty) = Array::get(table, i)
    if toff == off {
      found = Some(tty)
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Locate the identifier at (line, col), typecheck the program, and return its
/// inferred type as a string. Resolution order:
///   1. named call callee: env lookup of the function. The checker records
///      CallResult at the callee EIdent's own offset (`callee_offset` ==
///      ident off), so a type-table last-wins would report `Int` for `add` in
///      `add(1, 2)` instead of `(Int, Int) -> Int` (#1941). Same reason
///      `vibe grep` never consults the offset table for a callee.
///   2. per-node type table (covers LOCALS and PARAMETERS — names that live in
///      nested inference scopes and are gone from the returned TypeEnv);
///   3. fall back to the top-level TypeEnv lookup (top-level / imported names,
///      and let/fn-binding definition sites whose offset is not an EIdent node).
/// Returns "" when the position is not over a located identifier, or the name
/// resolves nowhere. Any failure is swallowed and yields "".
fn type_at_use_or_env(table: Array[(Int, Type)], hits: Array[IdentHit], name: String, chosen_off: Int, final_s: Subst, stmts: Array[Stmt]) -> String with Exception {
  let mut use_ty = ""
  let mut u = 0
  while u < Array::length(hits) {
    let (hname, hoff) = hit_name_off(Array::get(hits, u))
    if hname == name && hoff != chosen_off {
      match tytab_lookup(table, hoff) {
        Some(t) => {
          use_ty = type_to_string(subst_apply(final_s, t))
        },
        None => ()
      }
    } else {
      ()
    }
    u = u + 1
  }
  if use_ty != "" {
    use_ty
  } else {
    let env = check_program(stmts)
    match env_lookup(env, name) {
      Some(t) => type_to_string(t),
      None => ""
    }
  }
}

export fn type_at_source(source: String, line: Int, col: Int) -> String {
  handle {
    let tgt = line_col_to_offset(source, line, col)
    if tgt < 0 {
      // Out-of-range (line, col): invalid `line`/`col` (< 1), `line` beyond
      // EOF, or `col` past the end of that line's content (#947). No position
      // to resolve, so no hover — matches the "position not over a located
      // identifier" empty-result convention below.
      ""
    } else {
      let (tokens, starts, ends) = lex_with_offsets(source)
      let stmts = parse_program_located(tokens, starts, source)
      let hits = empty_hits()
      // Identifier USES carry real offsets on their EIdent nodes.
      collect_stmts(stmts, hits)
      let mut lsi = 0
      let ls_ntok = Array::length(tokens)
      while lsi + 2 < ls_ntok {
        match Array::get(tokens, lsi) {
          TLet => match Array::get(tokens, lsi + 1) {
            TStar => match Array::get(tokens, lsi + 2) {
              TIdent(ls_name) => {
                let ls_off = Array::get(starts, lsi + 2)
                if ls_off >= 0 {
                  Array::push(hits, IdentHit(ls_name, ls_off))
                } else {
                  ()
                }
                lsi = lsi + 3
              },
              _ => {
                lsi = lsi + 1
              }
            },
            _ => {
              lsi = lsi + 1
            }
          },
          _ => {
            lsi = lsi + 1
          }
        }
      }
      // Identifier DEFINITIONS (let / fn binding names) carry none, so recover
      // their source offset from each statement's span and the source text.
      let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)
      collect_binding_name_hits(span_stmts, span_start, span_end, source, hits)
      let name = pick_ident_at(hits, tgt)
      if name == "" {
        ""
      } else {
        let chosen_off = pick_ident_off(hits, tgt)
        let on_callee = pick_ident_is_callee(hits, tgt)
        if on_callee {
          let env = check_program(stmts)
          match env_lookup(env, name) {
            Some(t) => type_to_string(t),
            None => {
              // Local / parameter callee: not in the final env. The table's
              // last-wins entry here is CallResult, which is the wrong type
              // for the name — prefer empty over a confident wrong answer.
              ""
            }
          }
        } else {
          // 2. per-node type table (locals + parameters).
          let (table, final_s) = check_program_type_table(stmts)
          let table_hit = if chosen_off >= 0 {
            tytab_lookup(table, chosen_off)
          } else {
            None
          }
          match table_hit {
            Some(rec_ty) => type_to_string(subst_apply(final_s, rec_ty)),
            None => type_at_use_or_env(table, hits, name, chosen_off, final_s, stmts)
          }
        }
      }
    }
  } with Exception {
    Throw(_) => ""
  }
}
