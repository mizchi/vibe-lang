generated_hash =

// @vibe/compiler/runtime/eval_loader — small helpers for the shell/REPL's
// incremental source-buffer evaluation: source lookup by path key, parse +
// export-name collection for the eval loop (ADR-0070 Phase 3, #897,
// compiler-internal batch). Compiled into the compiler itself via
// compiler_sources_manifest.tsv (group `runtime`, dual-row: this contract +
// eval_loader.vibe).
//
// The old index.vibe was not a facade but the whole implementation (the
// package is single-file), so it moved verbatim to eval_loader.vibe. No
// exported types: `Stmt` (from ../../core) arrives as structural signature
// text resolved against the implementation import when the facade is
// merged in (normalize/perceus precedent — no re-import needed here). No
// `version` binding existed (compiler-internal package).

fn contains_str(arr: Array[String], target: String) -> Bool
fn source_lookup(sources: Array[(String, String)], path_key: String) -> Option[String]
fn load_and_parse(source: String) -> Array[Stmt] with Error
fn collect_exports(stmts: Array[Stmt]) -> Array[String]
