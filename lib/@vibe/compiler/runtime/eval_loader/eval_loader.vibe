//# Imports

import @vibe/compiler/syntax {
  lex, parse, parse_program
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

//# Functions

fn resolve_interp_expr(expr: Expr) -> Expr with Exception {
  match expr {
    EStringInterp(parts) => {
      let plen = Array::length(parts)
      let exprs = ArrayBuilder::new()
      let mut i = 0
      while i < plen {
        let lit = Array::get(parts, i)
        if String::length(lit) > 0 {
          ArrayBuilder::push(exprs, EString(lit))
        }
        if i + 1 < plen {
          let expr_src = Array::get(parts, i + 1)
          let resolved = resolve_interp_expr(parse(lex(expr_src)))
          ArrayBuilder::push(exprs, ECall(EIdent("__to_string", -1), [resolved], -1))
        }
        i = i + 2
      }
      let out = ArrayBuilder::freeze(exprs)
      let len = Array::length(out)
      if len == 0 {
        EString("")
      }
      else {
        let mut acc = Array::get(out, 0)
        let mut j = 1
        while j < len {
          acc = ECall(EIdent("String::concat", -1), [acc, Array::get(out, j)], -1)
          j = j + 1
        }
        acc
      }
    },
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EUnit => expr,
    EIdent(_, _) => expr,
    ETuple(elems) => ETuple(for elem in elems {
      resolve_interp_expr(elem)
    }),
    EArray(elems) => EArray(for elem in elems {
      resolve_interp_expr(elem)
    }),
    ERecord(rn, fields, targs) => ERecord(rn, for field in fields {
      let (name, value) = field; (name, resolve_interp_expr(value))
    }, targs),
    EMap(fields) => EMap(for field in fields {
      let (name, value) = field; (name, resolve_interp_expr(value))
    }),
    EIf(cond, then_expr, else_expr) => EIf(resolve_interp_expr(cond), resolve_interp_expr(then_expr), resolve_interp_expr(else_expr)),
    ELet(name, value, body, soff) => ELet(name, resolve_interp_expr(value), resolve_interp_expr(body), soff),
    ELetRec(name, value, body) => ELetRec(name, resolve_interp_expr(value), resolve_interp_expr(body)),
    ELetMut(name, value, body, soff) => ELetMut(name, resolve_interp_expr(value), resolve_interp_expr(body), soff),
    EAssign(name, value, body) => EAssign(name, resolve_interp_expr(value), resolve_interp_expr(body)),
    EAssignOp(name, op, value, body) => EAssignOp(name, op, resolve_interp_expr(value), resolve_interp_expr(body)),
    ESeq(left, right) => ESeq(resolve_interp_expr(left), resolve_interp_expr(right)),
    EMatch(scrutinee, arms) => EMatch(resolve_interp_expr(scrutinee), for arm in arms {
      let (pat, body) = arm; (pat, resolve_interp_expr(body))
    }),
    EHandle(scrutinee, arms) => EHandle(resolve_interp_expr(scrutinee), for arm in arms {
      let (pat, body) = arm; (pat, resolve_interp_expr(body))
    }),
    EWhile(cond, body) => EWhile(resolve_interp_expr(cond), resolve_interp_expr(body)),
    ELoop(params, body) => ELoop(for param in params {
      let (name, init) = param; (name, resolve_interp_expr(init))
    }, resolve_interp_expr(body)),
    EForIn(name, index_name, iter, body) => EForIn(name, index_name, resolve_interp_expr(iter), resolve_interp_expr(body)),
    ECall(callee, args, off) => ECall(resolve_interp_expr(callee), for arg in args {
      resolve_interp_expr(arg)
    }, off),
    EBinOp(op, left, right) => EBinOp(op, resolve_interp_expr(left), resolve_interp_expr(right)),
    EUnaryOp(op, inner) => EUnaryOp(op, resolve_interp_expr(inner)),
    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(type_params, bounds, params, ret_ty, effect, resolve_interp_expr(body)),
    EDot(inner, field, off, fdoff) => EDot(resolve_interp_expr(inner), field, off, fdoff),
    EReturn(inner) => EReturn(resolve_interp_expr(inner)),
    EBreak(opt) => match opt {
      None => expr,
      Some(value) => EBreak(Some(resolve_interp_expr(value)))
    },
    EContinue(args) => EContinue(for arg in args {
      resolve_interp_expr(arg)
    }),
    ELabeledArg(label, name, value) => ELabeledArg(label, name, resolve_interp_expr(value)),
    ESpread(inner) => ESpread(resolve_interp_expr(inner))
  }
}

fn resolve_interp_stmt(stmt: Stmt) -> Stmt with Exception {
  match stmt {
    SLet(exported, is_rec, name, ty, value) => SLet(exported, is_rec, name, ty, resolve_interp_expr(value)),
    SLetMut(name, ty, value) => SLetMut(name, ty, resolve_interp_expr(value)),
    STest(name, body) => STest(name, resolve_interp_expr(body)),
    SBench(name, body) => SBench(name, resolve_interp_expr(body)),
    SExpr(expr) => SExpr(resolve_interp_expr(expr)),
    _ => stmt
  }
}

export fn contains_str(arr: Array[String], target: String) -> Bool {
  let rec go: (Int) -> Bool = (i) -> {
    if i >= Array::length(arr) {
      false
    }
    else {
      if Array::get(arr, i) == target {
        true
      }
      else {
        go(i + 1)
      }
    }
  }
  go(0)
}

export fn source_lookup(sources: Array[(String, String)], path_key: String) -> Option[String] {
  let rec go: (Int) -> Option[String] = (i) -> {
    if i >= Array::length(sources) {
      None
    }
    else {
      let (p, src) = Array::get(sources, i)
      if p == path_key {
        Some(src)
      }
      else {
        go(i + 1)
      }
    }
  }
  go(0)
}

export fn load_and_parse(source: String) -> Array[Stmt] with Exception {
  let tokens = lex(source)
  for stmt in parse_program(tokens) {
    resolve_interp_stmt(stmt)
  }
}

export fn collect_exports(stmts: Array[Stmt]) -> Array[String] {
  // Out-param accumulation: each match arm pushes directly into `out`.
  // Previously each `Array::concat(acc, [x])` allocated and copied the
  // entire growing prefix — total O(N^2) for N exports across the file.
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(true, _, name, _, _) => Array::push(out, name),
      SEnum(true, _, _, variants, _) => {
        let mut j = 0
        while j < Array::length(variants) {
          let (cname, _) = Array::get(variants, j)
          Array::push(out, cname)
          j = j + 1
        }
      },
      SExport(names) => {
        let mut j = 0
        while j < Array::length(names) {
          Array::push(out, Array::get(names, j))
          j = j + 1
        }
      },
      SReExport(_, names) => {
        let mut j = 0
        while j < Array::length(names) {
          let name = Array::get(names, j).name
          Array::push(out, name)
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}
