fn interface_effect_set(effect_name: Option[String]) -> String {
  interface_effect_set_with_vars(effect_name, array_empty(), array_empty())
}

/// Test-only seam for the public interface row projection. Checker provenance
/// must remain in checked types without perturbing public API fingerprints.
export fn incremental_interface_effect_set_for_test(effect_name: Option[String], ids: Array[Int], names: Array[String]) -> String {
  interface_effect_set_with_vars(effect_name, ids, names)
}

fn interface_lookup_var(ids: Array[Int], names: Array[String], id: Int) -> String {
  let mut i = 0
  let mut result = String::concat("free", __to_string(id))
  let mut found = false
  while i < Array::length(ids) && !found {
    if Array::get(ids, i) == id {
      result = Array::get(names, i)
      found = true
    } else {
      i = i + 1
    }
  }
  result
}

fn interface_canonical_type(ty: Type, ids: Array[Int], names: Array[String]) -> String {
  let rec types: (Array[Type], Array[Int], Array[String]) -> String = (items, vars, labels) -> {
    let out = StringBuilder::new()
    StringBuilder::push(out, "[")
    let mut i = 0
    while i < Array::length(items) {
      StringBuilder::push(out, interface_segment(interface_canonical_type(Array::get(items, i), vars, labels)))
      i = i + 1
    }
    StringBuilder::push(out, "]")
    StringBuilder::freeze(out)
  }
  match ty {
    CtInt => "int",
    CtDouble => "double",
    CtBool => "bool",
    CtString => "string",
    CtChar => "char",
    CtUnit => "unit",
    CtBytes => "bytes",
    CtUnknown => "unknown",
    CtVar(id) => String::concat("var:", interface_lookup_var(ids, names, id)),
    CtConstructor(name, arity) => String::concat("constructor:", String::concat(interface_segment(name), __to_string(arity))),
    CtApplied(head, args) => String::concat("applied:", String::concat(interface_segment(interface_canonical_type(head, ids, names)), types(args, ids, names))),
    CtEnum(name) => String::concat("enum:", interface_segment(name)),
    CtStruct(name) => String::concat("struct:", interface_segment(name)),
    CtArray(elem) => String::concat("array:", interface_segment(interface_canonical_type(elem, ids, names))),
    CtOption(elem) => String::concat("option:", interface_segment(interface_canonical_type(elem, ids, names))),
    CtTuple(items) => String::concat("tuple:", types(items, ids, names)),
    // #1839: anonymous record — names are part of the canonical form.
    CtRecord(rfields) => {
      let mut kacc = "record:"
      let mut ki = 0
      while ki < Array::length(rfields) {
        let (kname, kty) = Array::get(rfields, ki)
        kacc = String::concat(kacc, String::concat(interface_segment(kname), interface_segment(interface_canonical_type(kty, ids, names))))
        ki = ki + 1
      }
      kacc
    },
    CtNamed(name, args) => String::concat("named:", String::concat(interface_segment(name), types(args, ids, names))),
    CtFn(params, ret, effects) => String::concat("fn:", String::concat(types(params, ids, names), String::concat(interface_segment(interface_canonical_type(ret, ids, names)), interface_effect_set_with_vars(effects, ids, names)))),
    CtForAll(vars, bounds, body) => {
      let all_ids = Array::slice(ids, 0, Array::length(ids))
      let all_names = Array::slice(names, 0, Array::length(names))
      let mut i = 0
      while i < Array::length(vars) {
        Array::push(all_ids, Array::get(vars, i))
        Array::push(all_names, String::concat("q", __to_string(Array::length(all_names))))
        i = i + 1
      }
      let bound_rows = array_empty()
      let mut b = 0
      while b < Array::length(vars) {
        let id = Array::get(vars, b)
        let labels = array_empty()
        let mut j = 0
        while j < Array::length(bounds) {
          let (bound_id, raw_labels) = Array::get(bounds, j)
          if bound_id == id {
            let mut k = 0
            while k < Array::length(raw_labels) {
              Array::push(labels, Array::get(raw_labels, k))
              k = k + 1
            }
          } else {
            ()
          }
          j = j + 1
        }
        Array::push(bound_rows, String::concat(interface_lookup_var(all_ids, all_names, id), String::concat("=", String::join(interface_sorted_unique(labels), ","))))
        b = b + 1
      }
      String::concat("forall:", String::concat("[", String::concat(String::join(bound_rows, ";"), String::concat("]", interface_segment(interface_canonical_type(body, all_ids, all_names))))))
    }
  }
}

fn interface_lookup_type_param(params: Array[String], name: String) -> String {
  let mut i = 0
  let mut result = name
  let mut found = false
  while i < Array::length(params) && !found {
    if type_param_name(Array::get(params, i)) == name {
      result = String::concat("p", String::concat(__to_string(i), String::concat("/", __to_string(type_param_arity(Array::get(params, i))))))
      found = true
    } else {
      i = i + 1
    }
  }
  result
}

/// Resolve a trait-method signature name with explicit lexical scope.
/// Method binders shadow trait-header binders; names outside both scopes stay
/// free (rather than being accidentally alpha-normalized as a binder).
fn interface_lookup_trait_type_param(header_params: Array[String], method_params: Array[String], name: String) -> String {
  let mut i = 0
  let mut method_result = String::concat("free:", name)
  let mut found_method = false
  while i < Array::length(method_params) && !found_method {
    if type_param_name(Array::get(method_params, i)) == name {
      method_result = String::concat("method:", String::concat(__to_string(i), String::concat("/", __to_string(type_param_arity(Array::get(method_params, i))))))
      found_method = true
    } else {
      i = i + 1
    }
  }
  if found_method {
    method_result
  } else {
    let mut j = 0
    let mut header_result = String::concat("free:", name)
    let mut found_header = false
    while j < Array::length(header_params) && !found_header {
      if type_param_name(Array::get(header_params, j)) == name {
        header_result = String::concat("header:", String::concat(__to_string(j), String::concat("/", __to_string(type_param_arity(Array::get(header_params, j))))))
        found_header = true
      } else {
        j = j + 1
      }
    }
    header_result
  }
}

/// Canonicalize a trait method signature. Unlike ordinary declaration
/// signatures, this has nested binders: method generics take precedence over
/// the surrounding trait-header binders. This observation consumes both
/// binder lists from source `STrait`; method generic provenance is not retained
/// by TypeEnv or the full checked artifact.
fn interface_canonical_trait_method_type_expr(ty: TypeExpr, header_params: Array[String], method_params: Array[String]) -> String {
  let rec exprs: (Array[TypeExpr], Array[String], Array[String]) -> String = (items, header_scope, method_scope) -> {
    let out = StringBuilder::new()
    StringBuilder::push(out, "[")
    let mut i = 0
    while i < Array::length(items) {
      StringBuilder::push(out, interface_segment(interface_canonical_trait_method_type_expr(Array::get(items, i), header_scope, method_scope)))
      i = i + 1
    }
    StringBuilder::push(out, "]")
    StringBuilder::freeze(out)
  }
  match ty {
    TyName(name) => String::concat("name:", interface_segment(interface_lookup_trait_type_param(header_params, method_params, name))),
    TyApp(name, args) => String::concat("app:", String::concat(interface_segment(interface_lookup_trait_type_param(header_params, method_params, name)), exprs(args, header_params, method_params))),
    TyFn(args, ret, effects) => String::concat("fn:", String::concat(exprs(args, header_params, method_params), String::concat(interface_segment(interface_canonical_trait_method_type_expr(ret, header_params, method_params)), interface_effect_set(effects)))),
    TyTuple(items) => String::concat("tuple:", exprs(items, header_params, method_params)),
    TyUnit => "unit"
  }
}

fn interface_trait_header_malformed_rows(header_params: Array[String]) -> Array[String] {
  let rows = array_empty()
  let mut p = 0
  while p < Array::length(header_params) {
    let param_name = type_param_name(Array::get(header_params, p))
    let mut matches = 0
    let mut p2 = 0
    while p2 < Array::length(header_params) {
      if type_param_name(Array::get(header_params, p2)) == param_name {
        matches = matches + 1
      } else {
        ()
      }
      p2 = p2 + 1
    }
    if matches > 1 {
      // Encode the binder position, not its source spelling, so malformed
      // duplicate groups remain alpha-invariant while staying distinct from
      // a valid header of the same arity.
      Array::push(rows, String::concat("ambiguous-header-param:", __to_string(p)))
    } else {
      ()
    }
    p = p + 1
  }
  rows
}

fn interface_trait_generic_malformed_rows(method_params: Array[String], generic_bounds: Array[(String, Array[String])]) -> Array[String] {
  let rows = array_empty()
  let mut p = 0
  while p < Array::length(method_params) {
    let param_name = Array::get(method_params, p)
    let mut matches = 0
    let mut p2 = 0
    while p2 < Array::length(method_params) {
      if Array::get(method_params, p2) == param_name {
        matches = matches + 1
      } else {
        ()
      }
      p2 = p2 + 1
    }
    if matches > 1 {
      Array::push(rows, String::concat("ambiguous-method-param:", interface_segment(param_name)))
    } else {
      ()
    }
    p = p + 1
  }
  let mut b = 0
  while b < Array::length(generic_bounds) {
    let (bound_name, bound_labels) = Array::get(generic_bounds, b)
    let mut matches = 0
    let mut p3 = 0
    while p3 < Array::length(method_params) {
      if Array::get(method_params, p3) == bound_name {
        matches = matches + 1
      } else {
        ()
      }
      p3 = p3 + 1
    }
    if matches == 0 {
      Array::push(rows, String::concat("unbound-bound:", String::concat(interface_segment(bound_name), interface_bracketed(interface_sorted_unique(bound_labels), ","))))
    } else if matches > 1 {
      Array::push(rows, String::concat("ambiguous-bound:", String::concat(interface_segment(bound_name), interface_bracketed(interface_sorted_unique(bound_labels), ","))))
    } else {
      ()
    }
    b = b + 1
  }
  rows
}

fn interface_surplus_method_generic_rows(method_count: Int, method_gens: Array[(String, Array[String], Array[(String, Array[String])])]) -> Array[String] {
  let rows = array_empty()
  let mut surplus = method_count
  while surplus < Array::length(method_gens) {
    let (surplus_name, surplus_params, surplus_bounds) = Array::get(method_gens, surplus)
    let raw_params = array_empty()
    let mut sp = 0
    while sp < Array::length(surplus_params) {
      Array::push(raw_params, interface_segment(Array::get(surplus_params, sp)))
      sp = sp + 1
    }
    let raw_bounds = array_empty()
    let mut sb = 0
    while sb < Array::length(surplus_bounds) {
      let (bound_name, bound_labels) = Array::get(surplus_bounds, sb)
      Array::push(raw_bounds, String::concat(interface_segment(bound_name), interface_bracketed(interface_sorted_unique(bound_labels), ",")))
      sb = sb + 1
    }
    Array::push(rows, String::concat("surplus-method-generic:", String::concat(interface_segment(surplus_name), String::concat(interface_bracketed(raw_params, ";"), interface_bracketed(raw_bounds, ";")))))
    surplus = surplus + 1
  }
  rows
}

fn interface_canonical_type_expr(ty: TypeExpr, params: Array[String]) -> String {
  let rec exprs: (Array[TypeExpr], Array[String]) -> String = (items, type_params) -> {
    let out = StringBuilder::new()
    StringBuilder::push(out, "[")
    let mut i = 0
    while i < Array::length(items) {
      StringBuilder::push(out, interface_segment(interface_canonical_type_expr(Array::get(items, i), type_params)))
      i = i + 1
    }
    StringBuilder::push(out, "]")
    StringBuilder::freeze(out)
  }
  match ty {
    TyName(name) => String::concat("name:", interface_segment(interface_lookup_type_param(params, name))),
    TyApp(name, args) => String::concat("app:", String::concat(interface_segment(interface_lookup_type_param(params, name)), exprs(args, params))),
    TyFn(args, ret, effects) => String::concat("fn:", String::concat(exprs(args, params), String::concat(interface_segment(interface_canonical_type_expr(ret, params)), interface_effect_set(effects)))),
    TyTuple(items) => String::concat("tuple:", exprs(items, params)),
    TyUnit => "unit"
  }
}

fn interface_public_value_names(stmts: Array[Stmt]) -> Array[String] {
  let names = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exported, _, name, _, _) => if exported {
        Array::push(names, name)
      } else {
        ()
      },
      SFnDecl(exported, name, _, _, _) => if exported {
        Array::push(names, name)
      } else {
        ()
      },
      SExport(exported_names) => {
        let mut j = 0
        while j < Array::length(exported_names) {
          Array::push(names, Array::get(exported_names, j))
          j = j + 1
        }
      },
      SReExport(_, reexports) => {
        let mut j = 0
        while j < Array::length(reexports) {
          let item = Array::get(reexports, j)
          let name = item.name
          let alias = item.alias
          Array::push(names, match alias {
            Some(value) => value,
            None => name
          })
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  interface_sorted_unique(names)
}

/// Trait and impl authority is published only for explicitly exported traits,
/// plus traits required by exported value schemes and their supertrait closure.
/// This mirrors selected import projection without widening the interface to
/// typedef or effect transport.
fn interface_public_trait_names(stmts: Array[Stmt], checked_env: TypeEnv) -> Array[String] {
  let mappings = array_empty()
  env_trait_def_names_into(checked_env, ipt_trait_names)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STrait(true, name, _, _, _, _) => trait_projection_add_mapping(mappings, name, name),
      SExport(items) => {
        let mut j = 0
        while j < Array::length(items) {
          let name = Array::get(items, j)
          if trait_in_list(ipt_trait_names, name) {
            trait_projection_add_mapping(mappings, name, name)
          } else {
            ()
          }
          j = j + 1
        }
      },
      SReExport(_, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          let source_name = item.name
          let alias = item.alias
          let local_name = match alias {
            Some(value) => value,
            None => source_name
          }
          if trait_in_list(ipt_trait_names, local_name) {
            trait_projection_add_mapping(mappings, local_name, local_name)
          } else {
            ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  let values = interface_public_value_names(stmts)
  i = 0
  while i < Array::length(values) {
    match env_lookup(checked_env, Array::get(values, i)) {
      Some(ty) => trait_projection_collect_type_bounds(ty, mappings, ipt_trait_names),
      None => ()
    }
    i = i + 1
  }
  let mut cursor = 0
  while cursor < Array::length(mappings) {
    let (name, _) = Array::get(mappings, cursor)
    let supers = trait_projection_supers(checked_env, name)
    trait_projection_collect_generic_impl_bounds(checked_env, name, mappings, ipt_trait_names)
    let mut j = 0
    while j < Array::length(supers) {
      let super_name = Array::get(supers, j)
      if trait_in_list(ipt_trait_names, super_name) {
        trait_projection_add_mapping(mappings, super_name, super_name)
      } else {
        ()
      }
      j = j + 1
    }
    cursor = cursor + 1
  }
  let names = array_empty()
  i = 0
  while i < Array::length(mappings) {
    let (name, _) = Array::get(mappings, i)
    Array::push(names, name)
    i = i + 1
  }
  interface_sorted_unique(names)
}

fn interface_public_type_names(stmts: Array[Stmt], checked_env: TypeEnv) -> Array[String] {
  let names = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(true, name, _, _, _) => Array::push(names, name),
      // #3070: `suberror` is sugar for an enum (#2983); `export suberror K`
      // publishes `K` exactly as `export enum K` does. Missing here, the
      // type was never selectable, so `import ./m { K }` answered "is not
      // exported" while the interface below already carried its line.
      SSuberror(true, name, _) => Array::push(names, name),
      SStruct(true, name, _, _, _, _) => Array::push(names, name),
      STypeAlias(true, name, _, _) => Array::push(names, name),
      SEffectDef(true, name, _, _) => Array::push(names, name),
      SEffectSet(true, name, _) => Array::push(names, name),
      SExport(items) => {
        let mut j = 0
        while j < Array::length(items) {
          Array::push(names, Array::get(items, j))
          j = j + 1
        }
      },
      SReExport(_, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          let source = item.name
          let alias = item.alias
          Array::push(names, match alias {
            Some(local) => local,
            None => source
          })
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  let defs = env_type_defs(checked_env)
  let out = array_empty()
  let mut ni = 0
  while ni < Array::length(names) {
    let name = Array::get(names, ni)
    // Publish only the name the module selected. Its declaration closure is
    // retained separately by restrict_env_to_export_surface so a private
    // field/signature type remains interpretable without becoming selectable.
    if typedef_projection_contains(defs, name) || is_explicit_builtin_declaration(name) {
      // Builtin/registry declarations have no user TypeDef payload, but an
      // explicit export gives them the same selected-surface authority as a
      // contract declaration. They are never accepted merely by import name.
      Array::push(out, name)
    } else {
      ()
    }
    ni = ni + 1
  }
  interface_sorted_unique(out)
}

/// #1533: the environment a module PUBLISHES to its importers is its export
/// surface, not its full checked environment. The checked environment binds
/// every top-level `let`/`fn` -- and, via the import env at its base, every
/// name the module itself imported -- so testing an import against it let
/// `import ./dep.vibe { private_fn }` through to die in codegen. Dropping
/// the non-exported bindings here, at the single point every publication
/// path flows through (persistent store, env cache, worker env.out, TDRE9),
/// makes the existing membership check in
/// bind_import_names_from_cache_collecting the export test itself.
///
/// Value bindings are retained only when they are explicitly exported.
/// Type/constructor authority travels separately through `EnvTypeDefs`; an
/// uppercase spelling is never authority to import a private declaration.
///
/// Trait definitions and implementations are published only for the selected
/// trait surface. EnvCached wrappers are rebuilt from the restricted chain
/// (their arrays are acceleration state, same rule as the serializer's).
fn restrict_env_to_export_surface_with_defs(value_surface: Array[String], trait_surface: Array[String], type_surface: Array[String], env: TypeEnv, all_defs: Array[TypeDef], members: Array[String], strict: Bool) -> TypeEnv {
  match env {
    EnvEmpty => EnvEmpty,
    EnvBind(name, binding, rest) => {
      let restricted = restrict_env_to_export_surface_with_defs(value_surface, trait_surface, type_surface, rest, all_defs, members, strict)
      if bsearch_leftmost(value_surface, name) >= 0 || is_selected_type_companion(name, binding, type_surface, all_defs, members, strict) {
        EnvBind(name, binding, restricted)
      } else {
        restricted
      }
    },
    // #1262: `let mut` escape markers are function-local, so a module's export
    // surface never carries one. Drop it with its scope rather than inventing
    // a rule for publishing mutability across a boundary.
    EnvMutCell(_, _, rest) => restrict_env_to_export_surface_with_defs(value_surface, trait_surface, type_surface, rest, all_defs, members, strict),
    EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens) => {
      let restricted = restrict_env_to_export_surface_with_defs(value_surface, trait_surface, type_surface, rest, all_defs, members, strict)
      if bsearch_leftmost(trait_surface, name) >= 0 {
        EnvTraitDef(name, supers, is_auto, methods, restricted, params, method_gens)
      } else {
        restricted
      }
    },
    EnvTraitImpl(name, target, rest) => {
      let restricted = restrict_env_to_export_surface_with_defs(value_surface, trait_surface, type_surface, rest, all_defs, members, strict)
      if bsearch_leftmost(trait_surface, trait_ref_name(name)) >= 0 {
        EnvTraitImpl(name, target, restricted)
      } else {
        restricted
      }
    },
    EnvTraitImplGen(name, params, bounds, target, rest) => {
      let restricted = restrict_env_to_export_surface_with_defs(value_surface, trait_surface, type_surface, rest, all_defs, members, strict)
      if bsearch_leftmost(trait_surface, trait_ref_name(name)) >= 0 {
        EnvTraitImplGen(name, params, bounds, target, restricted)
      } else {
        restricted
      }
    },
    EnvTypeDefs(defs, _, rest) => {
      let restricted = restrict_env_to_export_surface_with_defs(value_surface, trait_surface, type_surface, rest, all_defs, members, strict)
      let kept = array_empty()
      let mut i = 0
      while i < Array::length(defs) {
        let def = Array::get(defs, i)
        if bsearch_leftmost(type_surface, typedef_projection_name(def)) >= 0 {
          let closure = array_empty()
          typedef_projection_add_named(typedef_projection_name(def), all_defs, closure)
          let mut ci = 0
          while ci < Array::length(closure) {
            let closure_def = Array::get(closure, ci)
            if !typedef_projection_contains(kept, typedef_projection_name(closure_def)) {
              Array::push(kept, closure_def)
            } else {
              ()
            }
            ci = ci + 1
          }
        } else {
          ()
        }
        i = i + 1
      }
      if Array::length(kept) == 0 {
        restricted
      } else {
        EnvTypeDefs(kept, type_surface, restricted)
      }
    },
    EnvFlat(bindings) => {
      let kept = array_empty()
      let mut i = 0
      while i < Array::length(bindings) {
        let (name, binding) = Array::get(bindings, i)
        if bsearch_leftmost(value_surface, name) >= 0 || is_selected_type_companion(name, binding, type_surface, all_defs, members, strict) {
          Array::push(kept, (name, binding))
        } else {
          ()
        }
        i = i + 1
      }
      EnvFlat(kept)
    },
    // The wrapper is DROPPED, not rebuilt. Its arrays are acceleration
    // state (the codec re-derives them via env_cache on both serialize and
    // parse), and every consumer of a published env either flat-walks the
    // chain or serializes it, so nothing loses correctness. Rebuilding here
    // would need core's `env_cache` -- a name this file cannot import: it
    // collides with the ubiquitous `env_cache` PARAMETERS, and the FS
    // module lane resolves an import over a same-named local (the merge
    // lane shadows correctly), while an `as` alias broke the
    // collect_merged_stmts lane instead. Both are their own bugs.
    EnvCached(_, _, rest) => restrict_env_to_export_surface_with_defs(value_surface, trait_surface, type_surface, rest, all_defs, members, strict)
  }
}

fn restrict_env_to_export_surface(value_surface: Array[String], trait_surface: Array[String], type_surface: Array[String], env: TypeEnv, strict: Bool) -> TypeEnv {
  let all_defs = env_type_defs(env)
  let restricted = restrict_env_to_export_surface_with_defs(value_surface, trait_surface, type_surface, env, all_defs, env_type_member_names(env), strict)
  if Array::length(type_surface) > 0 && Array::length(env_selectable_type_defs(restricted)) == 0 {
    // Opaque builtins and re-exported contracts can grant type authority
    // without carrying a forgeable TypeDef payload. Keep one surface node for
    // that case; concrete closures already carry their own surface node.
    EnvTypeDefs(array_empty(), type_surface, restricted)
  } else {
    restricted
  }
}

/// Builtin values are resolved outside a module's ordinary TypeEnv, so an
/// explicit export of one needs a marker binding in the published environment.
/// The marker never grants unexported builtin authority: its source is the
/// already-filtered explicit value surface.
fn prepend_explicit_builtin_value_markers(value_surface: Array[String], env: TypeEnv) -> TypeEnv {
  let mut out = env
  let mut i = 0
  while i < Array::length(value_surface) {
    let name = Array::get(value_surface, i)
    if is_explicit_builtin_declaration(name) && env_lookup(env, name) == None {
      out = EnvBind(name, env_value_binding(CtUnknown), out)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// Build the single published environment shared by the filesystem and
/// in-memory TypeDb lanes. Only declarations named by this module's explicit
/// export surface leave the check; imported authority stays local unless the
/// module re-exports it.
fn append_env_tail(head: TypeEnv, tail: TypeEnv) -> TypeEnv {
  match head {
    EnvEmpty => tail,
    EnvBind(name, binding, rest) => EnvBind(name, binding, append_env_tail(rest, tail)),
    EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens) => EnvTraitDef(name, supers, is_auto, methods, append_env_tail(rest, tail), params, method_gens),
    EnvTraitImpl(name, target, rest) => EnvTraitImpl(name, target, append_env_tail(rest, tail)),
    EnvTraitImplGen(name, params, bounds, target, rest) => EnvTraitImplGen(name, params, bounds, target, append_env_tail(rest, tail)),
    EnvTypeDefs(defs, selectable, rest) => EnvTypeDefs(defs, selectable, append_env_tail(rest, tail)),
    EnvMutCell(name, escapes, rest) => EnvMutCell(name, escapes, append_env_tail(rest, tail)),
    EnvFlat(bindings) => {
      let mut out = tail
      let mut i = Array::length(bindings) - 1
      while i >= 0 {
        let (name, binding) = Array::get(bindings, i)
        out = EnvBind(name, binding, out)
        i = i - 1
      }
      out
    },
    // Cached names are derived acceleration state. Reattaching the semantic
    // chain and letting publication discard/rebuild caches preserves meaning.
    EnvCached(_, _, rest) => append_env_tail(rest, tail)
  }
}

/// #2762: publication is where the export surface becomes a value, so it is
/// where an `export { }` naming nothing is refused.
///
/// The first attempt put the check in `check_module_impl`, which is only the
/// FS worker lane. Codex (P1 on #2806) found the hole by reading: the
/// IN-MEMORY walk in `runtime.vibe` (`ensure_fingerprint`, both arms) reaches
/// this same publication without passing through that function, so
/// `db_typecheck` and `compile_with_modules_cached` still accepted the module.
/// Measured on the branch with the first fix in place, `db_set_source` +
/// `db_typecheck` of a module whose only oddity is
/// `export { NotDeclaredAnywhere }` answered ACCEPTED -- the very defect this
/// issue is about (two lanes disagreeing about whether a module is a program),
/// reproduced between a different pair.
///
/// So it goes through the one door, for the reason #2378's marker comment
/// below already gives: every lane publishes here, and a check placed here
/// cannot be missed by a lane added later. The cost is that publication now
/// carries `with Exception` -- publication CAN fail, and the row says so.
///
/// The check reads the FINAL published env, which is what `check_module_impl`
/// handed it before this move, so the behaviour is unchanged for that lane.
/// Not the intermediate `publication_env`: `prepend_explicit_builtin_value_
/// markers` is fed `value_surface`, which contains the export names
/// themselves, so a marker could make an absent name look bound.
export fn checked_module_public_env_with_reexport_declarations(stmts: Array[Stmt], full_checked_env: TypeEnv, reexport_declarations: TypeEnv) -> TypeEnv with Exception {
  checked_module_public_env_publishing(stmts, full_checked_env, reexport_declarations, false)
}

/// Publication for the module at `path`. A package contract (`index.vpkg`)
/// publishes exactly what it declares: a type it re-exports carries its enum
/// variants, its derived methods and the methods of its impls, not every
/// function of the implementation that shares its prefix or returns it
/// (`is_selected_type_companion`). That is what keeps `@vibe/concurrent`,
/// which re-exports the stable subset of `@vibe/concurrent/experimental`,
/// from publishing `TaskGroup::spawn_suspend` through `TaskGroup`. An ordinary
/// module keeps the older companion rule.
export fn checked_module_public_env_for_path(path: String, stmts: Array[Stmt], full_checked_env: TypeEnv, reexport_declarations: TypeEnv) -> TypeEnv with Exception {
  checked_module_public_env_publishing(stmts, full_checked_env, reexport_declarations, is_contract_ext(path))
}

fn checked_module_public_env_publishing(stmts: Array[Stmt], full_checked_env: TypeEnv, reexport_declarations: TypeEnv, strict: Bool) -> TypeEnv with Exception {
  // Local declarations stay ahead of the publication-only projection, which
  // preserves lexical shadowing when both select the same public spelling.
  let publication_env = bind_type_member_markers(append_env_tail(full_checked_env, reexport_declarations), local_type_member_markers(stmts, full_checked_env))
  let value_surface = interface_public_value_names(stmts)
  let trait_surface = interface_public_trait_names(stmts, publication_env)
  let type_surface = interface_public_type_names(stmts, publication_env)
  let published = bind_type_reference_definitions(value_surface, publication_env, env_preserve_type_definition_origins(restrict_env_to_export_surface(value_surface, trait_surface, type_surface, publication_env, strict), publication_env))
  // Builtin declarations have no TypeDef node to survive the restriction.
  // Their explicit selected surface still needs a transport node, otherwise
  // the importer cannot distinguish this export from an empty dependency.
  let with_builtin_types = if Array::length(type_surface) > 0 && Array::length(env_type_defs(published)) == 0 {
    EnvTypeDefs(array_empty(), type_surface, published)
  } else {
    published
  }
  // #2378: plus one marker per `fn` this module defines at a qualified
  // builtin name, read by whichever module imports it -- see
  // builtin_shadow_marker_prefix. Bound HERE, in the one publication every
  // lane goes through (the FS wave loop, the #906 worker, and the in-memory
  // walk in runtime.vibe), so no lane can publish an unmarked env.
  let published_env = bind_builtin_shadow_markers(prepend_explicit_builtin_value_markers(value_surface, with_builtin_types), collect_builtin_shadowing_names(stmts))
  match unresolved_aggregate_export_name(stmts, published_env) {
    Some(name) => throw(unresolved_export_message(name)),
    None => ()
  }
  published_env
}

export fn checked_module_public_env(stmts: Array[Stmt], full_checked_env: TypeEnv) -> TypeEnv with Exception {
  checked_module_public_env_with_reexport_declarations(stmts, full_checked_env, EnvEmpty)
}

/// Every declaration line, with its declared type-parameter ARITY.
///
/// `params` used to reach a line only through
/// `interface_canonical_type_expr(payload, params)`, so a declaration whose
/// payloads never mention a parameter serialized identically at every arity --
/// `enum E[A] { Only }` and `enum E[A, B] { Only }` were one line, while the
/// checker registers a derived witness against `E[A]` and `E[A, B]`
/// respectively (Codex on #2742, P1). Measured, the same hole was open in the
/// enum, struct, alias and effect arms.
///
/// Taking `params` as a PARAMETER rather than folding the count in at each arm
/// is the point: every arm has to state its own, so a new one cannot quietly
/// omit it. Forms with no type parameters pass an empty array.
///
/// The COUNT, not the names: `E[A]` and `E[B]` are the same declaration, so
/// recording names would report a rename as a change. That is the same
/// invariant `trait_impl_identity_line` already records for an impl's own
/// parameters.
fn interface_decl_line(prefix: String, name: String, params: Array[String], body: String) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, prefix)
  StringBuilder::push(out, interface_segment(name))
  StringBuilder::push(out, interface_segment("\{Array::length(params)}"))
  StringBuilder::push(out, body)
  StringBuilder::freeze(out)
}

fn interface_bracketed(items: Array[String], separator: String) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "[")
  StringBuilder::push(out, String::join(items, separator))
  StringBuilder::push(out, "]")
  StringBuilder::freeze(out)
}

/// The export FLAG belongs on the line exactly when `include_private` is on.
///
/// With it off every emitted line is exported by construction, so the flag is
/// constant and recording it would only churn the interface identity's
/// preimage. With it on BOTH kinds are in the list, and the flag is then the
/// only thing telling them apart -- which matters because it is not
/// decoration: `interface_public_trait_names` puts a trait in the export
/// surface only when its declaration is exported (or an `SExport` names it),
/// and `restrict_env_to_export_surface` keeps an `EnvTraitImpl` only when its
/// trait is in that surface. Flipping `export trait Marker` to `trait Marker`
/// therefore withdraws every `Marker` impl from the published environment with
/// the trait's own text unchanged (Codex on #2742, P1: the same mechanism it
/// found for `SExport`).
///
/// Every arm goes through this one door so a new one cannot quietly emit an
/// unstamped line.
fn interface_push_decl_line(lines: Array[String], exported: Bool, include_private: Bool, line: String) -> Unit {
  if include_private {
    Array::push(lines, String::concat(if exported {
      "pub:"
    } else {
      "prv:"
    }, line))
  } else {
    Array::push(lines, line)
  }
}

/// The 7 statement kinds below ARE the type-level namespace of a module: the
/// declarations that introduce a name a type expression can resolve to. The
/// interface identity wants only the exported ones; the witness set
/// (`trait_witness_module_row`) wants them all, because a PRIVATE declaration
/// can shadow an imported name and re-resolve an impl target without appearing
/// in any interface (Codex on #2742, P1). One serializer, two callers, so the
/// two cannot drift apart.
/// Whether one declaration belongs in the serialized list.
///
/// An aggregate `export { Name }` publishes a declaration that does not carry
/// `export` itself -- `interface_public_trait_names` and
/// `interface_public_type_names` both already put such a name in the export
/// surface, and `restrict_env_to_export_surface` publishes accordingly. The
/// serializer did not agree: it read the declaration's OWN flag, so an
/// aggregate-exported declaration's contents were omitted from the interface
/// identity while its contents were published (Codex on #2756, P2).
///
/// Measured on the head before the fix, one probe module per kind, comparing
/// the module's `interface_fingerprint` across a body edit:
///
/// | aggregate-exported private declaration | edit | fingerprint |
/// |---|---|---|
/// | `trait Marker` | method renamed, method added | UNCHANGED |
/// | `effect Log` | operation renamed | UNCHANGED |
/// | `struct Point` | `derive(Eq)` -> `derive(Eq, Show)` | UNCHANGED |
/// | `enum Hue` | a whole variant added | UNCHANGED |
///
/// so it was not confined to the kinds with no value binding. A struct's and
/// an alias's TYPE still moved the identity through the `value:` row its
/// constructor produces, which is why the hole is easy to miss: the parts that
/// row cannot carry -- derives, enum variants, trait methods, effect
/// operations, effectset members -- were the ones that went unrecorded.
///
/// Taking the set as a PARAMETER rather than computing it inside is what keeps
/// the two callers honest about their own policy: the identity passes the real
/// set, and `trait_witness_module_row` passes an empty one because it already
/// emits every declaration under `include_private` and records the aggregate
/// export as its own `export:` row -- so its preimage is unchanged by this.
fn interface_decl_selected(exported: Bool, name: String, aggregate: Array[String], include_private: Bool) -> Bool {
  exported || include_private || contains_str(aggregate, name)
}

fn interface_decl_lines(stmts: Array[Stmt], include_private: Bool, aggregate: Array[String]) -> Array[String] {
  let lines = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(exported, name, params, variants, derives) => if interface_decl_selected(exported, name, aggregate, include_private) {
        let vs = array_empty()
        let mut j = 0
        while j < Array::length(variants) {
          let (vname, fields) = Array::get(variants, j)
          let fs = array_empty()
          let mut k = 0
          while k < Array::length(fields) {
            Array::push(fs, interface_canonical_type_expr(Array::get(fields, k), params))
            k = k + 1
          }
          Array::push(vs, String::concat(interface_segment(vname), String::concat("[", String::concat(String::join(fs, ";"), "]"))))
          j = j + 1
        }
        let enum_body = StringBuilder::new()
        StringBuilder::push(enum_body, interface_bracketed(vs, ";"))
        StringBuilder::push(enum_body, "derive")
        StringBuilder::push(enum_body, interface_bracketed(interface_sorted_unique(derives), ","))
        interface_push_decl_line(lines, exported, include_private, interface_decl_line("enum:", name, params, StringBuilder::freeze(enum_body)))
      } else {
        ()
      },
      SSuberror(exported, name, variants) => if interface_decl_selected(exported, name, aggregate, include_private) {
        let vs = array_empty()
        let mut j = 0
        while j < Array::length(variants) {
          let (vname, fields) = Array::get(variants, j)
          let fs = array_empty()
          let mut k = 0
          while k < Array::length(fields) {
            Array::push(fs, interface_canonical_type_expr(Array::get(fields, k), array_empty()))
            k = k + 1
          }
          Array::push(vs, String::concat(interface_segment(vname), String::concat("[", String::concat(String::join(fs, ";"), "]"))))
          j = j + 1
        }
        interface_push_decl_line(lines, exported, include_private, interface_decl_line("suberror:", name, array_empty(), interface_bracketed(vs, ";")))
      } else {
        ()
      },
      SStruct(exported, name, fields, derives, mut_fields, params) => if interface_decl_selected(exported, name, aggregate, include_private) {
        let fs = array_empty()
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, ftype) = Array::get(fields, j)
          let field_mutability = if contains_str(mut_fields, fname) {
            "mut"
          } else {
            "imm"
          }
          Array::push(fs, String::concat(interface_segment(fname), String::concat(":", String::concat(field_mutability, String::concat(":", interface_canonical_type_expr(ftype, params))))))
          j = j + 1
        }
        let struct_body = StringBuilder::new()
        StringBuilder::push(struct_body, interface_bracketed(fs, ";"))
        StringBuilder::push(struct_body, "derive")
        StringBuilder::push(struct_body, interface_bracketed(interface_sorted_unique(derives), ","))
        interface_push_decl_line(lines, exported, include_private, interface_decl_line("struct:", name, params, StringBuilder::freeze(struct_body)))
      } else {
        ()
      },
      STypeAlias(exported, name, params, body) => if interface_decl_selected(exported, name, aggregate, include_private) {
        interface_push_decl_line(lines, exported, include_private, interface_decl_line("alias:", name, params, interface_canonical_type_expr(body, params)))
      } else {
        ()
      },
      STrait(exported, name, supers, methods, method_gens, header_params) => if interface_decl_selected(exported, name, aggregate, include_private) {
        let ms = array_empty()
        let mut j = 0
        while j < Array::length(methods) {
          let (mname, args, ret) = Array::get(methods, j)
          // `parse_trait_methods` records a generic row for every method in
          // source order, including an empty row. Pair positionally rather
          // than by name so binder ownership remains observable even for
          // duplicate method spellings in an otherwise accepted source AST.
          let (generic_method, method_params, generic_bounds) = if j < Array::length(method_gens) {
            Array::get(method_gens, j)
          } else {
            ("<missing-method-generic-provenance>", array_empty(), array_empty())
          }
          let bound_rows = array_empty()
          let malformed_rows = interface_trait_generic_malformed_rows(method_params, generic_bounds)
          let mut p = 0
          while p < Array::length(method_params) {
            let param_name = Array::get(method_params, p)
            let labels = array_empty()
            let mut b = 0
            while b < Array::length(generic_bounds) {
              let (bound_name, bound_labels) = Array::get(generic_bounds, b)
              if bound_name == param_name {
                let mut q = 0
                while q < Array::length(bound_labels) {
                  Array::push(labels, Array::get(bound_labels, q))
                  q = q + 1
                }
              } else {
                ()
              }
              b = b + 1
            }
            Array::push(bound_rows, String::concat(String::concat("method:", __to_string(p)), String::concat("=", String::join(interface_sorted_unique(labels), ","))))
            p = p + 1
          }
          let arg_lines = array_empty()
          let mut k = 0
          while k < Array::length(args) {
            Array::push(arg_lines, interface_canonical_trait_method_type_expr(Array::get(args, k), header_params, method_params))
            k = k + 1
          }
          let method_body = StringBuilder::new()
          // Keep the source row's method spelling in the serialization. It is
          // normally equal to mname, but retaining it makes malformed or
          // manually-constructed AST binder association fail closed.
          StringBuilder::push(method_body, "source-method")
          StringBuilder::push(method_body, interface_segment(generic_method))
          StringBuilder::push(method_body, "gens")
          StringBuilder::push(method_body, interface_bracketed(bound_rows, ";"))
          StringBuilder::push(method_body, "malformed")
          StringBuilder::push(method_body, interface_bracketed(malformed_rows, ";"))
          StringBuilder::push(method_body, "args")
          StringBuilder::push(method_body, interface_bracketed(arg_lines, ";"))
          StringBuilder::push(method_body, "ret")
          StringBuilder::push(method_body, interface_segment(interface_canonical_trait_method_type_expr(ret, header_params, method_params)))
          Array::push(ms, String::concat(interface_segment(mname), StringBuilder::freeze(method_body)))
          j = j + 1
        }
        let surplus_method_rows = interface_surplus_method_generic_rows(Array::length(methods), method_gens)
        let header_rows = array_empty()
        let mut h = 0
        while h < Array::length(header_params) {
          Array::push(header_rows, String::concat("header:", __to_string(h)))
          h = h + 1
        }
        let trait_body = StringBuilder::new()
        StringBuilder::push(trait_body, "header-gens")
        StringBuilder::push(trait_body, interface_bracketed(header_rows, ";"))
        StringBuilder::push(trait_body, "header-malformed")
        StringBuilder::push(trait_body, interface_bracketed(interface_trait_header_malformed_rows(header_params), ";"))
        StringBuilder::push(trait_body, "super")
        StringBuilder::push(trait_body, interface_bracketed(interface_sorted_unique(supers), ","))
        StringBuilder::push(trait_body, "methods")
        StringBuilder::push(trait_body, interface_bracketed(ms, ";"))
        StringBuilder::push(trait_body, "surplus-method-generics")
        StringBuilder::push(trait_body, interface_bracketed(surplus_method_rows, ";"))
        interface_push_decl_line(lines, exported, include_private, interface_decl_line("trait:", name, header_params, StringBuilder::freeze(trait_body)))
      } else {
        ()
      },
      SEffectDef(exported, name, params, ops) => if interface_decl_selected(exported, name, aggregate, include_private) {
        let os = array_empty()
        let mut j = 0
        while j < Array::length(ops) {
          let (opname, args, ret) = Array::get(ops, j)
          let arg_lines = array_empty()
          let mut k = 0
          while k < Array::length(args) {
            Array::push(arg_lines, interface_canonical_type_expr(Array::get(args, k), params))
            k = k + 1
          }
          Array::push(os, String::concat(interface_segment(opname), String::concat("[", String::concat(String::join(arg_lines, ";"), String::concat("]", interface_canonical_type_expr(ret, params))))))
          j = j + 1
        }
        interface_push_decl_line(lines, exported, include_private, interface_decl_line("effect:", name, params, interface_bracketed(os, ";")))
      } else {
        ()
      },
      SEffectSet(exported, name, members) => if interface_decl_selected(exported, name, aggregate, include_private) {
        interface_push_decl_line(lines, exported, include_private, interface_decl_line("effectset:", name, array_empty(), interface_bracketed(interface_sorted_unique(members), ",")))
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  interface_sorted_unique(lines)
}

fn interface_public_decl_lines(stmts: Array[Stmt]) -> Array[String] {
  interface_decl_lines(stmts, false, aggregate_export_names(stmts))
}

/// A trace-only canonical token-stream identity. It length-delimits each token's
/// kind and exact source lexeme, retaining every parser-visible distinction even
/// where today's unlocated AST or printer is lossy. Whitespace and comments
/// between tokens, spans, and the module filesystem path are omitted. The
/// successful parse is repeated here only for the opt-in observation path so a
/// malformed or incomplete stream fails closed. This is deliberately
/// provisional syntax identity, not normalized typed IR.
export fn incremental_implementation_identity(source: String) -> String with Exception {
  let (tokens, starts, ends) = lex_with_offsets(source)
  let _ = parse_program_located(tokens, starts, source)
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-module-token-stream:v1\n")
  let mut i = 0
  while i < Array::length(tokens) {
    StringBuilder::push(out, interface_segment(token_to_string(Array::get(tokens, i))))
    let start = Array::get(starts, i)
    let end = Array::get(ends, i)
    StringBuilder::push(out, interface_segment(source[start: end]))
    i = i + 1
  }
  compact_string_fingerprint(StringBuilder::freeze(out))
}

/// Test-only seam for malformed transparent AST provenance that source parsing
/// cannot construct. Production interface serialization calls the same helpers.
export fn incremental_trait_generic_provenance_markers_for_test(header_params: Array[String], method_params: Array[String], generic_bounds: Array[(String, Array[String])], method_count: Int, method_gens: Array[(String, Array[String], Array[(String, Array[String])])]) -> String {
  String::concat(interface_bracketed(interface_trait_header_malformed_rows(header_params), ";"), String::concat(interface_bracketed(interface_trait_generic_malformed_rows(method_params, generic_bounds), ";"), interface_bracketed(interface_surplus_method_generic_rows(method_count, method_gens), ";")))
}

/// The ONE spelling of the interface identity's preimage version.
///
/// It was two: the preimage itself, and the `interface_fingerprint_kind` the
/// invalidation trace advertises. Bumping v4 to v5 for the arity fix moved the
/// first and left the second, so every trace claimed to be a v4 fingerprint
/// while carrying a v5 one -- and nothing caught it, because the oracle pins
/// the advertised label and both copies of the lie agreed (Codex on #2747, P2).
///
/// A version that can be bumped in one place and not the other is not a
/// version. Both sites read this.
fn interface_identity_version() -> String {
  "vibe-module-interface:v7"
}

/// What an aggregate `export { .. }` names when it does NOT name a value.
///
/// #2762: the interface identity ROW for one exported name, or `None` when the
/// module resolves nothing under that name.
///
/// The classifier is `export_local_nonvalue_kind`, imported from the checker
/// -- the SAME function the refusal consults (`unresolved_aggregate_export_name`
/// there is defined in terms of it). That is what keeps the identity and the
/// refusal from drifting: a kind added to the classifier starts producing a row
/// here AND stops being refused there, in one edit. Before #2762 only the
/// identity existed, so `export { NotDeclaredAnywhere }` checked CLEAN on the
/// lane every build uses and threw `exported name missing from checked
/// environment` on the lane the invalidation trace uses -- the two disagreed
/// about whether the module was a program.
fn interface_export_row(stmts: Array[Stmt], bindings: Array[(String, Type)], name: String) -> Option[String] {
  match env_lookup_flat(bindings, name) {
    Some(ty) => Some(String::concat("value:", String::concat(interface_segment(name), String::concat(":", interface_canonical_type(ty, array_empty(), array_empty()))))),
    None => match export_local_nonvalue_kind(stmts, name) {
      Some(kind) => Some(String::concat("export-", String::concat(kind, String::concat(":", interface_segment(name))))),
      None => None
    }
  }
}

export fn incremental_interface_identity(source: String, env: TypeEnv) -> String with Env + Exception {
  let stmts = parse_program_with_path("<incremental-interface-observation>", source)
  let out = StringBuilder::new()
  StringBuilder::push(out, String::concat(interface_identity_version(), "\n"))
  let names = interface_public_value_names(stmts)
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, i)
    match interface_export_row(stmts, env_flat_bindings(env), name) {
      Some(row) => StringBuilder::push(out, row),
      // #2762 made this unreachable from the checker's own lanes: a module
      // whose `export { }` names nothing is refused before it can be
      // observed. It stays fail-closed for the re-export and
      // declaration-exported names this list also carries, which the checker
      // refuses elsewhere (or not at all, if a route is ever found).
      None => throw(String::concat("incremental interface observation: exported name missing from checked environment: ", name))
    }
    StringBuilder::push(out, "\n")
    i = i + 1
  }
  let decls = interface_public_decl_lines(stmts)
  let mut d = 0
  while d < Array::length(decls) {
    StringBuilder::push(out, Array::get(decls, d))
    StringBuilder::push(out, "\n")
    d = d + 1
  }
  compact_string_fingerprint(StringBuilder::freeze(out))
}

/// #2510 (criterion 5, option C part 2): the canonical line for ONE `impl`.
///
/// Trait resolution composes along the import closure -- impls ride the
/// TypeEnv as `EnvTraitImpl` / `EnvTraitImplGen` nodes -- so a module sees the
/// impls of its transitive dependencies. An impl is therefore not a property
/// of any single dependency EDGE and cannot be attributed to one, which is
/// what makes "put impls in the per-module interface identity" the wrong
/// shape. The whole reachable SET gets one fingerprint instead.
///
/// Deliberately OVER-sensitive where that is cheap, because the two errors are
/// not symmetric: an extra invalidation costs a re-check, a missed one reuses
/// across a real change. So the trait is recorded by the SPELLING at the impl
/// head rather than by a resolved identity -- writing `Mod::Show` where `Show`
/// was written moves the fingerprint even though it is the same trait -- and
/// the type-parameter arity is recorded even when no parameter is used.
///
/// The target and the bounds ARE canonicalized against the impl's own type
/// parameters, so `impl[A] Show for Box[A]` and `impl[B] Show for Box[B]` are
/// one impl rather than two. Bounds are sorted: their declaration order is not
/// part of what an impl means.
fn trait_impl_identity_line(tparams: Array[String], tbounds: Array[(String, Array[String])], trait_name: String, target: TypeExpr,) -> String {
  let bounds = array_empty()
  let mut i = 0
  while i < Array::length(tbounds) {
    let (bound_param, bound_traits) = Array::get(tbounds, i)
    Array::push(bounds, String::concat(interface_segment(interface_lookup_type_param(tparams, bound_param)), interface_bracketed(interface_sorted_unique(bound_traits), ","),),)
    i = i + 1
  }
  let out = StringBuilder::new()
  StringBuilder::push(out, "impl:")
  StringBuilder::push(out, interface_segment(trait_name))
  StringBuilder::push(out, interface_segment("\{Array::length(tparams)}"))
  StringBuilder::push(out, interface_bracketed(interface_sorted_unique(bounds), ";"))
  StringBuilder::push(out, interface_segment(interface_canonical_type_expr(target, tparams)))
  StringBuilder::freeze(out)
}

/// What a type name in an impl head RESOLVES to depends on where it was bound
/// from. Two dependencies can expose different aliases under the same exposed
/// name, and the impl-owning module can switch which one it binds while `impl
/// Marker for Target` is unchanged -- both alias rows still exist and the impl
/// row is identical, so without this row nothing moves while the checked
/// `EnvTraitImpl` target changes (Codex on #2742, P1 twice: once for `import`,
/// then again for `reexport`, which binds the name locally just the same).
///
/// WHICH statements bind a name from elsewhere is not argued here, it is read
/// off `build_import_envs_collecting` above: that resolver matches exactly
/// `SImport` and `SReExport`, and those are exactly the two tags this emits. A
/// third arm there needs a third tag here -- the comment on that function says
/// so from its side.
///
/// The item KIND is recorded only as present/absent. Distinguishing the
/// variants would mean enumerating them here and re-enumerating whenever one
/// is added; the name-to-source association is what decides resolution.
fn trait_witness_binding_line(tag: String, raw_path: String, items: Array[ImportItem]) -> String {
  let rows = array_empty()
  let mut i = 0
  while i < Array::length(items) {
    let item = Array::get(items, i)
    let alias = match item.alias {
      Some(value) => value,
      None => ""
    }
    let kind = match item.kind {
      Some(_) => "k",
      None => "-"
    }
    Array::push(rows, String::concat(interface_segment(item.name), String::concat(interface_segment(alias), kind)),)
    i = i + 1
  }
  String::concat(tag, String::concat(interface_segment(raw_path), interface_bracketed(rows, ";")))
}

/// An aggregate `export { .. }` is the OTHER half of what a module publishes.
///
/// `interface_public_trait_names` adds every name listed here that names a
/// trait, so `trait Marker; impl Marker for Int; export { Marker }` publishes
/// the impl while a module without the last line does not -- with the trait
/// row and the impl row byte-for-byte identical in both (Codex on #2742, P1).
/// The same list also feeds `interface_public_value_names` and
/// `interface_public_type_names`, which is why the whole list is emitted
/// rather than the subset that happens to name a trait: deciding that subset
/// needs the checked environment, and the names are cheap.
///
/// Source order is kept, like every other line in a row: the surfaces
/// canonicalize the list themselves, so a reordering cannot change what is
/// published -- which makes keeping it the over-sensitive and therefore safe
/// direction.
fn trait_witness_export_line(items: Array[String]) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "export:")
  let mut i = 0
  while i < Array::length(items) {
    StringBuilder::push(out, interface_segment(Array::get(items, i)))
    i = i + 1
  }
  StringBuilder::freeze(out)
}

/// Everything in ONE module that decides which witnesses exist, as canonical
/// lines, each carrying the module it came from.
///
/// Two rows, and both are needed (Codex on #2742, both P1):
///
///   - `impl:` for each `SImpl`, prefixed by the OWNING MODULE. Two
///     dependencies can each declare `export trait Marker; impl Marker for
///     Int` -- nominally two different traits, which a consumer imports under
///     distinct aliases -- and those two impls have identical text.
///     Deduplicating the text collapses them, so deleting one module's impl
///     leaves the other's line and the fingerprint does not move, while one
///     imported trait has lost its witness. With the module in the row,
///     repeated REACH of one module still collapses and two modules never do.
///
///   - `alias:` for each `STypeAlias`, EXPORTED OR NOT. An alias is
///     transparent, so `type Hidden = Int; impl Marker for Hidden` is an impl
///     for `Int`, and editing the alias to `= String` re-targets the impl
///     while the `impl` row's own text does not change. A private alias is in
///     no module's interface identity either, so nothing else would catch it.
///     Every alias in the closure is emitted rather than only the ones a local
///     impl mentions, because an impl target can be an alias IMPORTED from
///     another module. That costs a full invalidation on any alias edit, which
///     is cheap at the measured 40 aliases across `lib/`.
///
/// The caller must feed EVERY module of the closure -- the same requirement
/// the impl rows already impose.
/// One canonical row for ONE module, in SOURCE ORDER.
///
/// Order is semantic here and must not be sorted away: resolution stops at the
/// first matching `EnvTypeDefs` node (core/types.vibe), and
/// `build_import_envs_collecting` prepends each projection in source order, so
/// two imports binding the same local name resolve by precedence. Swapping
/// them retargets an impl while the rows are identical AS A SET (Codex on
/// #2742, P1).
///
/// The set-ness the earlier rounds needed lives one level up instead:
/// `trait_witness_set_fingerprint` sorts and deduplicates MODULE ROWS, so the
/// order modules are walked in, and reaching one module twice, still do not
/// matter. The path is stamped once here rather than on every line.
export fn trait_witness_module_row(path: String, stmts: Array[Stmt]) -> String {
  let lines = array_empty()
  trait_witness_collect_into(stmts, lines)
  let out = StringBuilder::new()
  StringBuilder::push(out, interface_segment(path))
  let mut i = 0
  while i < Array::length(lines) {
    StringBuilder::push(out, interface_segment(Array::get(lines, i)))
    i = i + 1
  }
  StringBuilder::freeze(out)
}

/// A module BOUNDARY, not just its contents.
///
/// Flattening a nested module into the surrounding row makes two programs that
/// the checker schedules DIFFERENTLY serialize identically (Codex on #2742,
/// P1):
///
///   module M { type Target = Int }; type Target = String; impl .. for Target
///   type Target = Int; module M { type Target = String }; impl .. for Target
///
/// Depth-first both give `alias Int`, `alias String`, `impl`, while
/// `reorder_type_decls_first` takes the OUTER alias before the module in each
/// and first-match-wins then resolves the target to `String` in one and `Int`
/// in the other.
///
/// The fix is NOT to replicate the checker's schedule here -- that is a second
/// copy of a rule that can drift. Bracketing the body instead makes the row a
/// faithful encoding of the tree, so any structural difference shows, and a
/// structural difference is what a schedule difference is made of. The module
/// NAME rides along too: it cannot change type visibility (the collector
/// flattens and ignores it), which makes including it the over-sensitive and
/// therefore safe direction.
fn trait_witness_push_module(name: String, body: Array[Stmt], lines: Array[String]) -> Unit {
  Array::push(lines, String::concat("module{:", interface_segment(name)))
  trait_witness_collect_into(body, lines)
  Array::push(lines, "}module")
}

/// Recursive because the checker's own visibility collector is: a nested
/// `module M { struct Target }` is a VISIBLE type declaration, since
/// `collect_visible_type_stmts` (checker_stmt.vibe) recurses into `SModule`
/// bodies and flattens them into one list. An impl, import or re-export inside
/// a module body is still one, for the same reason.
///
/// ONE PASS over the statements, so a declaration and a binding keep their
/// relative position. Collecting the declarations first and the bindings after
/// would order every declaration ahead of every import, which is exactly the
/// precedence the first-match rule reads.
///
/// `interface_decl_lines` is called on a one-statement slice to keep it the
/// single authority on which declarations are type-level -- the interface
/// identity calls the same function with `false` -- without losing position.
///
/// THREE things move the set, and the third is the one round 8 added:
///
///   1. what PRODUCES a witness -- `SImpl`, and the derives that ride inside a
///      declaration's own line;
///   2. what decides how the names in it RESOLVE -- every type-level
///      declaration, and the statements that bind a name from elsewhere;
///   3. what decides whether the module PUBLISHES it -- a witness that does
///      not cross the boundary is not in any consumer's set.
///
/// The authority for (3) is `interface_public_trait_names` together with
/// `restrict_env_to_export_surface`: the export flag on a declaration (stamped
/// by `interface_push_decl_line`), an aggregate `export { .. }`, and a
/// re-export, which already had a row for reason (2).
///
/// One input to (3) is deliberately NOT read here: `interface_public_trait_names`
/// also collects the trait bounds of every EXPORTED VALUE, so
/// `trait Marker; impl Marker for Int; export fn f[T: Marker](x: T)` publishes
/// the impl and deleting `f` withdraws it. Those bounds live inside the
/// value's `Expr` and reading them means a new hand-written walk -- the exact
/// move rounds 3 to 6 each had to undo. It is also the one input that is
/// attributable to a single module's own interface identity in every case: the
/// value is exported, so it is in that identity by construction, and
/// `interface_canonical_type` carries its bounds. Part 1 covers it at that
/// edge. Written down here so it is a stated boundary rather than a gap.
fn trait_witness_collect_into(stmts: Array[Stmt], lines: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    let one = array_empty()
    Array::push(one, stmt)
    let decl = interface_decl_lines(one, true, array_empty())
    let mut d = 0
    while d < Array::length(decl) {
      Array::push(lines, Array::get(decl, d))
      d = d + 1
    }
    match stmt {
      SImpl(tparams, tbounds, trait_name, target) =>
      Array::push(lines, trait_impl_identity_line(tparams, tbounds, trait_name, target)),
      SExport(items) => Array::push(lines, trait_witness_export_line(items)),
      SImport(raw_path, items) => Array::push(lines, trait_witness_binding_line("import:", raw_path, items)),
      SReExport(raw_path, items) =>
      Array::push(lines, trait_witness_binding_line("reexport:", raw_path, items)),
      SModule(_, name, body) => trait_witness_push_module(name, body, lines),
      _ => ()
    }
    i = i + 1
  }
}

/// The fingerprint of a reachable witness SET.
///
/// A set, so the lines are sorted and deduplicated: modules reached in a
/// different order, or one module reached twice along two import paths, give
/// one fingerprint. That is what lets this be folded into every module's
/// typing key without making the key depend on the order modules happened to
/// be walked in. Deduplication is only safe because each ROW carries its
/// owning module, and safe to SORT only because the order that IS semantic --
/// precedence between bindings inside one module -- is held inside the row
/// rather than between rows (see `trait_witness_module_row`).
export fn trait_witness_set_fingerprint(module_rows: Array[String]) -> String {
  let sorted = interface_sorted_unique(module_rows)
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-trait-witness-set:v5\n")
  let mut i = 0
  while i < Array::length(sorted) {
    StringBuilder::push(out, Array::get(sorted, i))
    StringBuilder::push(out, "\n")
    i = i + 1
  }
  compact_string_fingerprint(StringBuilder::freeze(out))
}

/// A trace-only canonical identity for the checked effective value environment.
/// `env_flat_bindings` deliberately excludes trait/impl/type/effect declarations;
/// duplicate names resolve through the same first-binding lookup used by the
/// checker. The existing canonical Type serializer alpha-normalizes quantified
/// variables and sorts/deduplicates bounds and effects. This is not the
/// persistent TypeEnv codec and is never read by a cache lookup.
export fn incremental_checked_env_identity(env: TypeEnv) -> String with Exception {
  let bindings = env_flat_bindings(env)
  let raw_names = array_empty()
  let mut b = 0
  while b < Array::length(bindings) {
    let (name, _) = Array::get(bindings, b)
    // The checker records each declared function's return annotation under
    // this private bookkeeping name. It is not a user value binding (and can
    // retain source spelling such as a generic parameter), so including it
    // would violate the observation's alpha-normal value-env contract.
    if !String::starts_with(name, "__fn_ret__:") {
      Array::push(raw_names, name)
    } else {
      ()
    }
    b = b + 1
  }
  let names = interface_sorted_unique(raw_names)
  let out = StringBuilder::new()
  StringBuilder::push(out, "vibe-module-checked-env:v3\n")
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, i)
    match env_lookup_flat(bindings, name) {
      Some(ty) => {
        StringBuilder::push(out, "value:")
        StringBuilder::push(out, interface_segment(name))
        StringBuilder::push(out, interface_segment(interface_canonical_type(ty, array_empty(), array_empty())))
        StringBuilder::push(out, "\n")
      },
      None => throw(String::concat("incremental checked environment observation: effective value missing from flattened environment: ", name))
    }
    i = i + 1
  }
  compact_string_fingerprint(StringBuilder::freeze(out))
}

/// A trace-only observation of the complete persistent TypeEnv v9 transport.
/// The canonical cache-text bytes are the sole input. This is not a
/// CheckedProgram, typed IR, exported interface, cache key, or reuse decision.
export fn incremental_persistent_type_env_transport_identity(env: TypeEnv) -> String {
  compact_string_fingerprint(persistent_type_env_cache_text(env))
}

export fn incremental_trace_observe_checked_env(path: String, source: String, env: TypeEnv) -> Unit with Env + Exception {
  incremental_interface_trace_observe(path, incremental_interface_identity(source, env), incremental_checked_env_identity(env), incremental_persistent_type_env_transport_identity(env))
}

fn incremental_trace_hex_digit(value: Int) -> String {
  if value < 10 {
    String::from_char_code('0' + value)
  } else {
    String::from_char_code('a' + value - 10)
  }
}

fn incremental_trace_json_string(text: String) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, "\"")
  let mut i = 0
  while i < String::length(text) {
    let c = String::char_code_at(text, i)
    if c == '"' {
      StringBuilder::push(out, "\\\"")
    } else if c == '\\' {
      StringBuilder::push(out, "\\\\")
    } else if c == '\n' {
      StringBuilder::push(out, "\\n")
    } else if c == '\r' {
      StringBuilder::push(out, "\\r")
    } else if c == '\t' {
      StringBuilder::push(out, "\\t")
    } else if c < 32 {
      StringBuilder::push(out, "\\u00")
      StringBuilder::push(out, incremental_trace_hex_digit(c / 16))
      StringBuilder::push(out, incremental_trace_hex_digit(c % 16))
    } else {
      StringBuilder::push(out, String::from_char_code(c))
    }
    i = i + 1
  }
  StringBuilder::push(out, "\"")
  StringBuilder::freeze(out)
}
/// Versioned observation bridge for the bounded Incremental.lean model.
///
/// `source_fingerprint` is `compact_string_fingerprint` of the loader's
/// ingested source. `implementation_fingerprint` remains the schema-v3
/// provisional canonical token-stream identity, not normalized typed IR.
/// `checked_env_fingerprint` is a complete value-environment observation.
/// `persistent_type_env_transport_fingerprint` observes only the complete
/// persistent TypeEnv v9 transport, not a CheckedProgram, typed IR, exported
/// interface, cache key, or reuse decision. `decision` records what this current TypeDb
/// walk did (`rechecked` or `reused`), not a formal invalidation verdict.
/// This function is called only after a successful check; a missing per-module
/// observation throws rather than emitting a partial or stale sidecar.
export fn incremental_invalidation_trace_json(entry_path: String, run_nonce: String) -> String with Env + Exception + Fs {
  if String::length(run_nonce) == 0 {
    throw("incremental invalidation trace requires a non-empty run nonce")
  } else {
    ()
  }
  let (paths, _ranks, deps_by_module, sources) = module_plan_data_fs(entry_path)
  let out = StringBuilder::new()
  StringBuilder::push(out, "{\"schema\":6,\"run_nonce\":")
  StringBuilder::push(out, incremental_trace_json_string(run_nonce))
  StringBuilder::push(out, ",\"fingerprint_note\":\"source_fingerprint is ingestion telemetry; implementation_fingerprint remains the provisional canonical token-stream identity; interface_fingerprint, checked_env_fingerprint, and persistent_type_env_transport_fingerprint are observation only; persistent_type_env_transport_fingerprint is TypeEnv transport only, not CheckedProgram, typed IR, exported interface, cache key, or reuse decision; none is a production cache key\",\"modules\":[")
  let mut i = 0
  while i < Array::length(paths) {
    if i > 0 {
      StringBuilder::push(out, ",")
    } else {
      ()
    }
    let path = Array::get(paths, i)
    let decision = match incremental_typecheck_telemetry_decision_of(path) {
      Some(value) => value,
      None => throw(String::concat("incremental invalidation trace: missing decision for ", path))
    }
    StringBuilder::push(out, "{\"path\":")
    StringBuilder::push(out, incremental_trace_json_string(path))
    StringBuilder::push(out, ",\"direct_dependencies\":[")
    let deps = Array::get(deps_by_module, i)
    let mut d = 0
    while d < Array::length(deps) {
      if d > 0 {
        StringBuilder::push(out, ",")
      } else {
        ()
      }
      StringBuilder::push(out, incremental_trace_json_string(Array::get(deps, d)))
      d = d + 1
    }
    StringBuilder::push(out, "],\"source_fingerprint\":")
    let source = Array::get(sources, i)
    StringBuilder::push(out, incremental_trace_json_string(compact_string_fingerprint(source)))
    StringBuilder::push(out, ",\"source_fingerprint_kind\":\"compact_string_fingerprint(ingested_source)\",\"implementation_fingerprint\":")
    StringBuilder::push(out, incremental_trace_json_string(incremental_implementation_identity(source)))
    StringBuilder::push(out, ",\"implementation_fingerprint_kind\":\"compact_string_fingerprint(vibe-module-token-stream:v1 length_delimited(token_kind,source_lexeme))\",\"interface_fingerprint\":")
    let interface_fingerprint = match incremental_interface_trace_observation_of(path) {
      Some(value) => value,
      None => throw(String::concat("incremental invalidation trace: missing complete interface observation for ", path))
    }
    StringBuilder::push(out, incremental_trace_json_string(interface_fingerprint))
    StringBuilder::push(out, String::concat(",\"interface_fingerprint_kind\":\"compact_string_fingerprint(", String::concat(interface_identity_version(), " canonical exported surface including kinded applications)\",\"checked_env_fingerprint\":")))
    let checked_env_fingerprint = match incremental_checked_env_trace_observation_of(path) {
      Some(value) => value,
      None => throw(String::concat("incremental invalidation trace: missing complete checked environment observation for ", path))
    }
    StringBuilder::push(out, incremental_trace_json_string(checked_env_fingerprint))
    StringBuilder::push(out, ",\"checked_env_fingerprint_kind\":\"compact_string_fingerprint(vibe-module-checked-env:v3 canonical effective TypeEnv value bindings including kinded applications)\",\"persistent_type_env_transport_fingerprint\":")
    let persistent_type_env_transport_fingerprint = match incremental_persistent_type_env_transport_trace_observation_of(path) {
      Some(value) => value,
      None => throw(String::concat("incremental invalidation trace: missing complete persistent TypeEnv transport observation for ", path))
    }
    StringBuilder::push(out, incremental_trace_json_string(persistent_type_env_transport_fingerprint))
    StringBuilder::push(out, ",\"persistent_type_env_transport_fingerprint_kind\":\"compact_string_fingerprint(persistent_type_env_cache_text:v9 complete TypeEnv transport only; not CheckedProgram, typed IR, exported interface, cache key, or reuse decision)\",\"decision\":")
    StringBuilder::push(out, incremental_trace_json_string(decision))
    StringBuilder::push(out, "}")
    i = i + 1
  }
  StringBuilder::push(out, "],\"aggregate_telemetry\":")
  StringBuilder::push(out, incremental_typecheck_telemetry_v1_json())
  StringBuilder::push(out, "}")
  StringBuilder::freeze(out)
}
/// Index of `p` in `items`, or -1. Plain linear scan: the caller runs it once
/// per module over a list of the same length, and a project the size of this
/// compiler's own manifest is ~209 modules.
fn module_plan_index_of(items: Array[String], p: String) -> Int {
  let n = Array::length(items)
  let mut i = 0
  let mut found = 0 - 1
  while found < 0 && i < n {
    if Array::get(items, i) == p {
      found = i
    } else {
      i = i + 1
    }
  }
  found
}
/// #1239 step 4(D) groundwork: discover a project's WHOLE import graph, and
/// its canonical schedule, inside one compiler process.
///
/// VIBE_LIST_DEPS answers "what does this ONE file import", so a host driver
/// building the parallel pre-warm's DAG has to spawn it once per module --
/// and on a project the size of this compiler's own manifest that discovery
/// loop is what dominates the whole parallel path's wall time, independent of
/// how many jobs the later check phase gets (#1168, see discoverProject in
/// scripts/parallel_frontend_warm.mjs). This does the same BFS in-process.
///
/// The order comes from @vibe/compiler/module_graph's plan_module_order -- the same function
/// the serial walk's own upfront plan uses since #1239 step 4(A)
/// (runtime/typecheck_fs.vibe) -- so the host dispatches the schedule the
/// compiler itself planned instead of one it re-derived, and an import cycle
/// is rejected here with the identical diagnostic rather than surfacing later
/// as a driver that never makes progress.
///
/// Returns the manifest text plus, positionally, each module's INGESTED
/// source: `ingest_source_text_fs` can prepend a directory-shared import a
/// raw .vibe file never had, or rewrite a contract into its facade entirely,
/// and check_module parses that text -- never the raw bytes. Deriving deps
/// from one and handing back the other is #1168's exact bug, so both come
/// off the same `ingested` string here.
export fn module_plan_data_fs(entry_path: String) -> (Array[String], Array[Int], Array[Array[String]], Array[String]) with Env + Exception + Fs {
  // `paths` doubles as the BFS queue: discovery pushes to it, `qi` walks it.
  let paths: Array[String] = []
  let deps_of: Array[Array[String]] = []
  let sources: Array[String] = []
  Array::push(paths, entry_path)
  let mut qi = 0
  while qi < Array::length(paths) {
    let p = Array::get(paths, qi)
    qi = qi + 1
    if !Fs::exists(p) {
      throw(String::concat("module plan: cannot read module: ", p))
    } else {
      ()
    }
    let ingested = ingest_source_text_fs(p, cache_read_source_fs(p))
    let (deps, _exports, _parse_count) = load_or_parse_module_header_fs(p, ingested, 0)
    Array::push(sources, ingested)
    Array::push(deps_of, deps)
    let dlen = Array::length(deps)
    let mut i = 0
    while i < dlen {
      let d = Array::get(deps, i)
      if module_plan_index_of(paths, d) >= 0 {
        ()
      } else {
        Array::push(paths, d)
      }
      i = i + 1
    }
  }
  let edges: Array[(String, Array[String])] = []
  let mut e = 0
  while e < Array::length(paths) {
    Array::push(edges, (Array::get(paths, e), Array::get(deps_of, e)))
    e = e + 1
  }
  let (order, ranks) = plan_module_order(edges, entry_path)
  let ordered_deps: Array[Array[String]] = []
  let ordered_sources: Array[String] = []
  let mut k = 0
  while k < Array::length(order) {
    let src_index = module_plan_index_of(paths, Array::get(order, k))
    Array::push(ordered_deps, Array::get(deps_of, src_index))
    Array::push(ordered_sources, Array::get(sources, src_index))
    k = k + 1
  }
  (order, ranks, ordered_deps, ordered_sources)
}
