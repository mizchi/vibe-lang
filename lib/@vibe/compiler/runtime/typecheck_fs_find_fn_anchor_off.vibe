export fn typecheck_fs_upsert_env_cache(cache: Array[(String, TypeEnv)], path: String, env: TypeEnv) -> Array[(String, TypeEnv)] {
  let len = Array::length(cache)
  let mut i = 0
  let mut found = false
  while i < len && !found {
    let (p, _) = Array::get(cache, at = i)
    if p == path {
      Array::set(cache, at = i, value = (path, env))
      found = true
    } else {
      i = i + 1
    }
  }
  if !found {
    Array::push(cache, value = (path, env))
  }
  cache
}

export fn ensure_env_cache_for_path(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], path: String) -> Array[(String, TypeEnv)] with Env + Exception + Fs {
  ensure_env_cache_for_path_with_config(rdb = rdb, env_cache = env_cache, path = path, cfg = target_cfg_ambient())
}

/// Use this invocation's target flags for parsing and cache identity.
export fn ensure_env_cache_for_path_with_config(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], path: String, cfg: TargetCfg) -> Array[(String, TypeEnv)] with Env + Exception + Fs {
  match typecheck_fs_lookup_env_cache(cache = env_cache, path = path) {
    Some(_) => env_cache,
    None =>
    match ripple_get_fingerprint(db = rdb, path = path) {
      Some(fingerprint) =>
      match load_persistent_type_env_in_namespace(fingerprint, namespace = target_cfg_namespace(cfg)) {
        Some(cached_env) => typecheck_fs_upsert_env_cache(cache = env_cache, path = path, env = cached_env),
        None => env_cache
      },
      None => env_cache
    }
  }
}

export fn ensure_env_cache_for_paths(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], paths: Array[String]) -> Array[(String, TypeEnv)] with Env + Exception + Fs {
  ensure_env_cache_for_paths_with_config(rdb = rdb, env_cache = env_cache, paths = paths, cfg = target_cfg_ambient())
}

/// Use this invocation's target flags for parsing and cache identity.
export fn ensure_env_cache_for_paths_with_config(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], paths: Array[String], cfg: TargetCfg) -> Array[(String, TypeEnv)] with Env + Exception + Fs {
  let mut cache = env_cache
  let mut i = 0
  while i < Array::length(paths) {
    cache = ensure_env_cache_for_path_with_config(rdb = rdb, env_cache = cache, path = Array::get(paths, at = i), cfg = cfg)
    i = i + 1
  }
  cache
}

export fn is_vpkg_types_stub_path(_ path: String) -> Bool {
