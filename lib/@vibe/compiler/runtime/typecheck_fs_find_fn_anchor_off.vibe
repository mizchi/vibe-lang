}
/// A permutation of [0, n) as a visit order. Identity when no seed is set.
/// Otherwise a seeded Fisher-Yates using a small LCG -- deterministic for a
/// given (seed, n), so a failing oracle run is exactly reproducible.
export fn dep_visit_order(_ n: Int) -> Array[Int] {
  let order = array_empty()
  let mut i = 0
  while i < n {
    Array::push(order, value = i)
    i = i + 1
  }
  let seed = dep_order_seed()
  if seed == 0 || n < 2 {
    order
  } else {
    // LCG (Numerical Recipes constants), kept inside 31 bits so the 62-bit
    // Int never overflows and the sequence is identical on every backend.
    let mut state = seed
    let mut j = n - 1
    while j > 0 {
      state = (state * 1664525 + 1013904223)&2147483647
      let k = state % (j + 1)
      let tmp = Array::get(order, at = j)
      Array::set(order, at = j, value = Array::get(order, at = k))
      Array::set(order, at = k, value = tmp)
      j = j - 1
    }
    order
  }
}
/// #2386: the ModuleJob parse goes through the loader's shared located-parse
/// memo (`parse_program_located_shared`, header_cache.vibe), which the header
/// pass fills during planning -- on a cold compile every module used to be
/// lexed and parsed twice, once for its header and once here (#1100 measured
/// the merge's third parse at 102 MB of a ~850 MB cold selfcompile; this
/// removes the second). The contract is the memo's: keyed by (path, EXACT
/// source text), a shallow top-level copy on every hand-out, a throwing
/// parse never memoized, bounded for the daemon.
///
/// `current_source_parse_executions` (counter 5, and ingestion slot 15)
/// keeps its observable: one per FIRST semantic use of a (path, text) in
/// the process. With the walk's own memo that was exactly "this check
/// parsed" -- the header pass never filled it, so the first check of a text
/// always parsed, and a later check of the same text never did. The parser
/// may now have run in planning instead, so the count is taken from the
/// memo's consumed flag rather than from whether the parser ran here; the
/// typing-env-reuse oracle and the cache probe pin it per scenario. Counted
/// before the parse and marked after a successful one, as before: a
/// throwing parse counts and is asked again.
export fn parse_program_with_path_impl(path: String, source: String, observe_current_source_parse: Bool) -> Array[Stmt] with Exception {
  engine_parse_program_with_path_impl(path = path, source = source, observe_current_source_parse = observe_current_source_parse)
}

/// The NON-WALK parse entry: the build's merge/flatten lane, plus the handful
/// of import-env and interface-observation sites. The TypeDb walk calls
/// `parse_program_with_path_impl` directly instead, with the current-source
/// observable on.
///
/// #2766: a parser run reached through here is counted separately
/// (`non_walk_parse_operations`). `parse_operations` spans planning and the
/// walk and nothing else, which is truthful for a CHECK and was read as a
/// statement about a BUILD -- a warm build reported 0 parses while the merge
/// lane parsed every source in the closure. The counter that was 0 is still
/// 0 and still means what it says; the work it never covered now has its own.
export fn parse_program_with_path(path: String, source: String, checked_error_row: Bool) -> Array[Stmt] with Exception {
  engine_parse_program_with_path(path = path, source = source, checked_error_row = checked_error_row)
}

export fn store_persistent_type_env(fingerprint: String, env: TypeEnv) -> String with Env + Exception + Fs {
  store_persistent_type_env_in_namespace(fingerprint = fingerprint, env = env, namespace = persistent_cache_namespace_current())
}

/// Use the caller's captured cache namespace.
export fn store_persistent_type_env_in_namespace(fingerprint: String, env: TypeEnv, namespace: String) -> String with Env + Exception + Fs {
  let text = persistent_module_cache_text(env = env, lowering = module_typed_lowering_memo_get_by_fp(fingerprint))
  Fs::write_file(persistent_type_env_cache_path_in_namespace(fingerprint, namespace = namespace), contents = text)
  text
}

// TDRE10 binds the logical checker input, conservative fingerprint, and
// exact canonical v11 disk record, including lowering rows. Dependency inputs
// and worker transport continue to use TypeEnv v10 independently of storage.
// The target text is intentionally not replaced by a compact fingerprint:
// cache corruption must not turn a fingerprint collision into checker reuse.
//
// The alias carries only the target fingerprint (TDRE11A). Its path is a hash
// of the input key, and the key and the target text it used to repeat are
// already in the witness the lookup requires: the lookup checks the witness's
// key against its own verbatim key and the witness's target text against the
// raw record. So a path-hash collision lands on a witness whose key differs
// and misses, and the binding is still exact. An alias in an older shape
// does not parse and misses.
let typing_dependency_env_reuse_alias_v11_tag: String = "TDRE11A"
let typing_dependency_env_reuse_witness_v10_tag: String = "TDRE10W"

/// One `<byte length>:<text>` segment, pushed into a builder as its pieces
/// (#2945). The TDRE10 texts embed a module's verbatim source and its
/// dependencies' exact env texts, so they are as large as the source closure
/// they describe (the CLI's generated adapter bundle alone is 30 MB).
/// Materializing each segment with nested `String::concat` copied that text
/// once per level before the builder copied it again; pushing the pieces
/// leaves the single copy `freeze` makes, and the bytes are identical.
fn push_typing_reuse_segment(out: StringBuilder, text: String) -> Unit {
  StringBuilder::push(out, value = __to_string(String::length(text)))
  StringBuilder::push(out, value = ":")
  StringBuilder::push(out, value = text)
}

fn parse_typing_reuse_segment(text: String, pos: Int) -> Option[(String, Int)] {
  let total = String::length(text)
  let mut cursor = pos
  let mut n = 0
  let mut saw_digit = false
  let mut valid = pos >= 0 && pos < total
  while valid && cursor < total && String::char_code_at(text, at = cursor) != ':' {
    let code = String::char_code_at(text, at = cursor)
    if code < '0' || code > '9' || n > total / 10 {
      valid = false
    } else {
      n = n * 10 + (code - '0')
      saw_digit = true
      cursor = cursor + 1
    }
  }
  if !valid || !saw_digit || cursor >= total || String::char_code_at(text, at = cursor) != ':' {
    None
  } else {
    let start = cursor + 1
    let end = start + n
    if end < start || end > total {
      None
    } else {
      Some((String::substring(text, start = start, end = end), end))
    }
  }
}

fn typing_dependency_reuse_alias_text(_ target_fingerprint: String) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = typing_dependency_env_reuse_alias_v11_tag)
  push_typing_reuse_segment(out = out, text = target_fingerprint)
  StringBuilder::freeze(out)
}

fn parse_typing_dependency_reuse_alias(_ text: String) -> Option[String] {
  let tag = typing_dependency_env_reuse_alias_v11_tag
  if !String::starts_with(text, prefix = tag) {
    None
  } else {
    match parse_typing_reuse_segment(text = text, pos = String::length(tag)) {
      Some((target_fingerprint, end)) => if end == String::length(text) && String::length(target_fingerprint) > 0 {
        Some(target_fingerprint)
      } else {
        None
      },
      None => None
    }
  }
}

/// The alias path is named by the key's DIGEST, not by the key: the key is as
/// large as the module's source plus its dependencies' env texts, and naming
/// a path by it meant concatenating it first. A collision between two digests
/// only costs a reuse, because the lookup requires the witness's verbatim key
/// to equal this one.
fn typing_reuse_sidecar_path(_ input_key: TypingReuseKey) -> String with Env {
  typing_reuse_sidecar_path_in_namespace(input_key, namespace = persistent_cache_namespace_current())
}

/// Use the caller's captured cache namespace.
fn typing_reuse_sidecar_path_in_namespace(_ input_key: TypingReuseKey, namespace: String) -> String with Env {
  persistent_typing_dependency_env_reuse_sidecar_path_in_namespace(input_key.digest, namespace = namespace)
}

fn parse_typing_dependency_reuse_binding(text: String, tag: String) -> Option[(String, String, String)] {
  if !String::starts_with(text, prefix = tag) {
    None
  } else {
    match parse_typing_reuse_segment(text = text, pos = String::length(tag)) {
      Some((input_key, after_input)) =>
      match parse_typing_reuse_segment(text = text, pos = after_input) {
        Some((target_fingerprint, after_target)) =>
        match parse_typing_reuse_segment(text = text, pos = after_target) {
          Some((target_text, end)) =>
          if end == String::length(text) && String::length(input_key) > 0 && String::length(target_fingerprint) > 0 && String::length(target_text) > 0 {
            Some((input_key, target_fingerprint, target_text))
          } else {
            None
          },
          None => None
        },
        None => None
      },
      None => None
    }
  }
}

/// Exact logical input to check_module: canonical owner path, byte-exact owner
/// source, effective typing semantics, resolution authority, and every resolved direct dependency row of
/// ModuleJob.dep_envs in its actual array order. finish_typecheck_fs_impl builds
/// this table once with project_exact_dependency_envs and gives the same value
/// to both check_module and TDRE10 lookup/publication, so ambient coordinator
/// cache rows are neither checker-visible nor part of this canonical text.
export fn typing_dependency_transport_input_key(path: String, source: String, semantics_seed: String, dep_envs: Array[(String, TypeEnv)]) -> String with Env {
  typing_dependency_transport_input_key_for_cfg_identity(path = path, source = source, semantics_seed = semantics_seed, dep_envs = dep_envs, cfg_identity = "")
}

/// Bind exact target flags inside the transported alias key.
export fn typing_dependency_transport_input_key_with_config(path: String, source: String, semantics_seed: String, dep_envs: Array[(String, TypeEnv)], cfg: TargetCfg) -> String with Env {
  typing_dependency_transport_input_key_for_cfg_identity(path = path, source = source, semantics_seed = semantics_seed, dep_envs = dep_envs, cfg_identity = target_cfg_identity(cfg))
}

// The compatibility entry supplies no target flags; the scoped entry supplies
// an exact identity. Both retain the same framing and environment inputs.
fn typing_dependency_transport_input_key_for_cfg_identity(path: String, source: String, semantics_seed: String, dep_envs: Array[(String, TypeEnv)], cfg_identity: String) -> String with Env {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = "vibe-typing-dependency-transport-env:v10")
  if cfg_identity != "" {
    push_typing_reuse_segment(out = out, text = cfg_identity)
  } else ()
  push_typing_reuse_segment(out = out, text = normalize_path(path))
  push_typing_reuse_segment(out = out, text = source)
  push_typing_reuse_segment(out = out, text = semantics_seed)
  push_typing_reuse_segment(out = out, text = resolution_env_seed())
  push_typing_reuse_segment(out = out, text = __to_string(Array::length(dep_envs)))
  let mut i = 0
  while i < Array::length(dep_envs) {
    let (dep_path, dep_env) = Array::get(dep_envs, at = i)
    push_typing_reuse_segment(out = out, text = dep_path)
    push_typing_reuse_segment(out = out, text = persistent_type_env_cache_text(dep_env))
    i = i + 1
  }
  StringBuilder::freeze(out)
}

/// A dependency's encoded env text, by the dependency's conservative
/// fingerprint. `typing_dependency_transport_input_key` encodes every direct
/// dependency's env once per CONSUMER, so a widely imported module was
/// re-encoded once per importer -- measured on the CLI closure, the encoding
/// alone was 0.7 s of a warm edited build and 1.7 s of a cold one.
///
/// Keyed by the fingerprint, not by the path: the env cache is an array two
/// routes mutate (`typecheck_fs_upsert_env_cache`, `ensure_env_cache_for_path`),
/// and a path-keyed memo would have to be invalidated on both, where one
/// missed invalidation encodes a stale env into a reuse key. A fingerprint
/// names one persisted record (`persistent_type_env_cache_path`), and the env
/// cache holds, for each path, the env of the fingerprint the walk recorded
/// for it -- the identity the conservative reuse path already rests on. So
/// the memo carries no lifetime of its own and is never reset.
let typing_dependency_env_text_memo: MutMap[String, String] = MutMap::new_string()

/// Each dependency env text's `compact_string_fingerprint`, by the same
/// conservative fingerprint as `typing_dependency_env_text_memo`, so a widely
/// imported module's env is hashed once rather than once per importer.
let typing_dependency_env_digest_memo: MutMap[String, String] = MutMap::new_string()

let typing_reuse_key_header: String = "vibe-typing-dependency-transport-env:v10"

/// The reuse key of one module, kept as the payloads of its segments and never
/// concatenated (#2728). Its text -- `typing_reuse_key_text` -- is the header
/// followed by one `<byte length>:<payload>` segment per piece, which is
/// byte-identical to `typing_dependency_transport_input_key`. That text is as
/// large as the module's source plus its dependencies' env texts, and strings
/// are never reclaimed on the bump lane, so building it cost a cold compile of
/// the compiler's own closure 57 MB, a copy of it to name the alias path
/// another 57 MB, and the witness text that embeds it 62 MB more. Now the
/// alias path is named by `digest` (each piece's fingerprint, in order), the
/// witness is written piece by piece, and a stored key is compared against the
/// pieces where it lies.
/// A key held as its segments' payloads (`pieces`), each with its compact
/// fingerprint (`piece_digests`). `by_ref` marks the pieces a stored witness
/// names by digest instead of carrying inline: the dependency env texts, which
/// every consumer of a dependency would otherwise copy into its own witness
/// (#2825: 144 MB of a 173 MB cold cache on the CLI closure, for 5.6 MB of
/// distinct text).
export struct TypingReuseKey {
  pieces: Array[String];
  piece_digests: Array[String];
  by_ref: Array[Bool];
  digest: String
}

fn push_typing_reuse_key_piece(key: TypingReuseKey, digest: StringBuilder, piece: String, piece_digest: String, by_ref: Bool) -> Unit {
  Array::push(key.pieces, value = piece)
  Array::push(key.piece_digests, value = piece_digest)
  Array::push(key.by_ref, value = by_ref)
  StringBuilder::push(digest, value = piece_digest)
  StringBuilder::push(digest, value = "|")
}

/// `typing_dependency_transport_input_key` as a `TypingReuseKey`, with each
/// dependency's env text and its digest taken from the memos by its
/// fingerprint in `dep_fps`. A dependency with no fingerprint in `dep_fps` is
/// encoded directly.
export fn typing_dependency_transport_input_key_memo(path: String, source: String, semantics_seed: String, dep_envs: Array[(String, TypeEnv)], dep_fps: Array[(String, String)]) -> TypingReuseKey with Env {
  typing_dependency_transport_input_key_memo_for_cfg_identity(path = path, source = source, semantics_seed = semantics_seed, dep_envs = dep_envs, dep_fps = dep_fps, cfg_identity = "")
}

/// Use this invocation's target flags for parsing and cache identity.
export fn typing_dependency_transport_input_key_memo_with_config(path: String, source: String, semantics_seed: String, dep_envs: Array[(String, TypeEnv)], dep_fps: Array[(String, String)], cfg: TargetCfg) -> TypingReuseKey with Env {
  typing_dependency_transport_input_key_memo_for_cfg_identity(path = path, source = source, semantics_seed = semantics_seed, dep_envs = dep_envs, dep_fps = dep_fps, cfg_identity = target_cfg_identity(cfg))
}

// The compatibility entry supplies no target flags; the scoped entry supplies
// an exact identity. Both retain the same framing and environment inputs.
fn typing_dependency_transport_input_key_memo_for_cfg_identity(path: String, source: String, semantics_seed: String, dep_envs: Array[(String, TypeEnv)], dep_fps: Array[(String, String)], cfg_identity: String) -> TypingReuseKey with Env {
  let key = TypingReuseKey::{
    pieces: [],
    piece_digests: [],
    by_ref: [],
    digest: ""
  }
  let digest = StringBuilder::new()
  if cfg_identity != "" {
    push_typing_reuse_key_piece(key = key, digest = digest, piece = cfg_identity, piece_digest = compact_string_fingerprint(cfg_identity), by_ref = false)
  } else ()
  let owner = normalize_path(path)
  push_typing_reuse_key_piece(key = key, digest = digest, piece = owner, piece_digest = compact_string_fingerprint(owner), by_ref = false)
  push_typing_reuse_key_piece(key = key, digest = digest, piece = source, piece_digest = compact_string_fingerprint(source), by_ref = false)
  push_typing_reuse_key_piece(key = key, digest = digest, piece = semantics_seed, piece_digest = compact_string_fingerprint(semantics_seed), by_ref = false)
  let resolution_seed = resolution_env_seed()
  push_typing_reuse_key_piece(key = key, digest = digest, piece = resolution_seed, piece_digest = compact_string_fingerprint(resolution_seed), by_ref = false)
  let count = __to_string(Array::length(dep_envs))
  push_typing_reuse_key_piece(key = key, digest = digest, piece = count, piece_digest = count, by_ref = false)
  let mut i = 0
  while i < Array::length(dep_envs) {
    let (dep_path, dep_env) = Array::get(dep_envs, at = i)
    push_typing_reuse_key_piece(key = key, digest = digest, piece = dep_path, piece_digest = compact_string_fingerprint(dep_path), by_ref = false)
    let (env_text, env_digest) = typing_dependency_env_text(dep_path = dep_path, dep_env = dep_env, dep_fps = dep_fps)
    push_typing_reuse_key_piece(key = key, digest = digest, piece = env_text, piece_digest = env_digest, by_ref = true)
    i = i + 1
  }
  TypingReuseKey::{
    pieces: key.pieces,
    piece_digests: key.piece_digests,
    by_ref: key.by_ref,
    digest: StringBuilder::freeze(digest)
  }
}

/// The key's text, materialized. Byte-identical to
/// `typing_dependency_transport_input_key`; the lanes never call it.
export fn typing_reuse_key_text(_ key: TypingReuseKey) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = typing_reuse_key_header)
  let mut i = 0
  while i < Array::length(key.pieces) {
    push_typing_reuse_segment(out = out, text = Array::get(key.pieces, at = i))
    i = i + 1
  }
  StringBuilder::freeze(out)
}

/// Whether `text` is exactly this key's text, read in place: each piece is
/// compared through a substring view, so nothing the size of the key is
/// built.
export fn typing_reuse_key_matches(text: String, key: TypingReuseKey) -> Bool {
  let end = String::length(text)
  let header = typing_reuse_key_header
  let mut pos = String::length(header)
  let mut ok = pos <= end && String::substring(text, start = 0, end = pos) == header
  let mut i = 0
  while ok && i < Array::length(key.pieces) {
    let piece = Array::get(key.pieces, at = i)
    let prefix = String::concat(__to_string(String::length(piece)), ":")
    let piece_start = pos + String::length(prefix)
    let piece_end = piece_start + String::length(piece)
    if piece_end > end || String::substring(text, start = pos, end = piece_start) != prefix || String::substring(text, start = piece_start, end = piece_end) != piece {
      ok = false
    } else {
      pos = piece_end
    }
    i = i + 1
  }
  ok && pos == end
}

/// Whether `text` -- a key as a witness STORES it -- is exactly this key, read
/// in place. A stored piece is either inline (`<len>:<text>`, as
/// `typing_reuse_key_matches` reads it) or a reference (`#<len>:<digest>`)
/// to a text-store record (#2825). A reference matches only when its digest is
/// the live piece's AND the stored record's bytes equal the live piece: the
/// digest locates the record and rejects early, it never decides a hit. Either
/// form is accepted at any position, so the comparison is always against the
/// live bytes.
fn typing_reuse_key_matches_in_namespace(text: String, key: TypingReuseKey, namespace: String) -> Bool with Env + Fs {
  let end = String::length(text)
  let header = typing_reuse_key_header
  let mut pos = String::length(header)
  let mut ok = pos <= end && String::substring(text, start = 0, end = pos) == header
  let mut i = 0
  while ok && i < Array::length(key.pieces) {
    let piece = Array::get(key.pieces, at = i)
    if pos < end && String::byte_at(text, at = pos) == '#' {
      match parse_typing_reuse_segment(text = text, pos = pos + 1) {
        Some((stored_digest, next)) => if stored_digest != Array::get(key.piece_digests, at = i) {
          ok = false
        } else if typing_reuse_stored_text_is(digest = stored_digest, text = piece, namespace = namespace) {
          pos = next
        } else {
          ok = false
        },
        None => ok = false
      }
    } else {
      let prefix = String::concat(__to_string(String::length(piece)), ":")
      let piece_start = pos + String::length(prefix)
      let piece_end = piece_start + String::length(piece)
      if piece_end > end || String::substring(text, start = pos, end = piece_start) != prefix || String::substring(text, start = piece_start, end = piece_end) != piece {
        ok = false
      } else {
        pos = piece_end
      }
    }
    i = i + 1
  }
  ok && pos == end
}

/// The stored key's byte length, without building it: a `by_ref` piece is
/// stored as `#<len>:<digest>`, every other piece inline.
fn typing_reuse_key_length(_ key: TypingReuseKey) -> Int {
  let mut n = String::length(typing_reuse_key_header)
  let mut i = 0
  while i < Array::length(key.pieces) {
    let stored = if Array::get(key.by_ref, at = i) {
      Array::get(key.piece_digests, at = i)
    } else {
      Array::get(key.pieces, at = i)
    }
    let len = String::length(stored)
    let marker = if Array::get(key.by_ref, at = i) {
      1
    } else {
      0
    }
    n = n + marker + String::length(__to_string(len)) + 1 + len
    i = i + 1
  }
  n
}

/// The text-store records this walk has written or read, by path: what the
/// file held when this walk last touched it. Reset with the other per-walk
/// memos. A reader still compares the remembered bytes against the live
/// piece, so remembering a record can only spare a read, never admit a hit.
let typing_reuse_text_memo_cell: Array[MutMap[String, String]] = [
  MutMap::new_string()
]

fn typing_reuse_text_memo() -> MutMap[String, String] {
  Array::get(typing_reuse_text_memo_cell, at = 0)
}

fn typing_reuse_stored_text(digest: String, namespace: String) -> Option[String] with Env + Fs {
  let path = persistent_typing_dependency_env_reuse_text_path_in_namespace(digest, namespace = namespace)
  match MutMap::get(typing_reuse_text_memo(), k = path) {
    Some(text) => Some(text),
    None => if Fs::exists(path) {
      let text = Fs::read_file(path)
      MutMap::set(typing_reuse_text_memo(), k = path, v = text)
      Some(text)
    } else {
      None
    }
  }
}

/// Whether the record `digest` names holds exactly `text`. A missing record
/// does not.
fn typing_reuse_stored_text_is(digest: String, text: String, namespace: String) -> Bool with Env + Fs {
  typing_reuse_stored_text(digest = digest, namespace = namespace) == Some(text)
}

/// Store one by-reference piece. The record is rewritten unless this walk
/// already knows it holds exactly `text`, so a torn or foreign record is
/// repaired by the next publication instead of failing every later lookup.
fn typing_reuse_store_text(digest: String, text: String, namespace: String) -> Unit with Env + Fs {
  let path = persistent_typing_dependency_env_reuse_text_path_in_namespace(digest, namespace = namespace)
  if typing_reuse_stored_text_is(digest = digest, text = text, namespace = namespace) {
    ()
  } else {
    Fs::write_file(path, contents = text)
    MutMap::set(typing_reuse_text_memo(), k = path, v = text)
  }
}

/// A dependency's env text and its fingerprint.
fn typing_dependency_env_text(dep_path: String, dep_env: TypeEnv, dep_fps: Array[(String, String)]) -> (String, String) {
  let mut fp = ""
  let mut j = 0
  while fp == "" && j < Array::length(dep_fps) {
    let (p, f) = Array::get(dep_fps, at = j)
    if p == dep_path {
      fp = f
    } else {
      j = j + 1
    }
  }
  if fp == "" {
    let text = persistent_type_env_cache_text(dep_env)
    (text, compact_string_fingerprint(text))
  } else {
    let text = match MutMap::get(typing_dependency_env_text_memo, k = fp) {
      Some(text) => text,
      None => {
        let text = persistent_type_env_cache_text(dep_env)
        MutMap::set(typing_dependency_env_text_memo, k = fp, v = text)
        text
      }
    }
    match MutMap::get(typing_dependency_env_digest_memo, k = fp) {
      Some(text_digest) => (text, text_digest),
      None => {
        let text_digest = compact_string_fingerprint(text)
        MutMap::set(typing_dependency_env_digest_memo, k = fp, v = text_digest)
        (text, text_digest)
      }
    }
  }
}

/// Writes a TDRE10 binding -- `<tag><key segment><fingerprint segment><target
/// segment>`, each segment `<byte length>:<text>` -- without building it. Small pieces are staged in a builder; a large one is
/// flushed past it straight to the file. A write torn part-way leaves a
/// segment whose stated length runs past the end of the file, which does not
/// parse, so it misses like any other malformed witness.
fn write_typing_reuse_binding(path: String, tag: String, input_key: TypingReuseKey, target_fingerprint: String, target_text: String, namespace: String) -> Unit with Env + Fs {
  // The texts a witness names go first, so a witness is never on disk before
  // a record it references: a publication torn here leaves no witness at
  // all, or one whose lookup misses.
  let mut r = 0
  while r < Array::length(input_key.pieces) {
    if Array::get(input_key.by_ref, at = r) {
      typing_reuse_store_text(digest = Array::get(input_key.piece_digests, at = r), text = Array::get(input_key.pieces, at = r), namespace = namespace)
    } else ()
    r = r + 1
  }
  let staged: Array[String] = []
  let started: Array[Bool] = [false]
  typing_reuse_put(path = path, staged = staged, started = started, text = tag)
  typing_reuse_put(path = path, staged = staged, started = started, text = String::concat(__to_string(typing_reuse_key_length(input_key)), ":"))
  typing_reuse_put(path = path, staged = staged, started = started, text = typing_reuse_key_header)
  let mut i = 0
  while i < Array::length(input_key.pieces) {
    let by_ref = Array::get(input_key.by_ref, at = i)
    let piece = if by_ref {
      Array::get(input_key.piece_digests, at = i)
    } else {
      Array::get(input_key.pieces, at = i)
    }
    let marker = if by_ref {
      "#"
    } else {
      ""
    }
    typing_reuse_put(path = path, staged = staged, started = started, text = String::concat(marker, String::concat(__to_string(String::length(piece)), ":")))
    typing_reuse_put(path = path, staged = staged, started = started, text = piece)
    i = i + 1
  }
  typing_reuse_put(path = path, staged = staged, started = started, text = String::concat(__to_string(String::length(target_fingerprint)), ":"))
  typing_reuse_put(path = path, staged = staged, started = started, text = target_fingerprint)
  typing_reuse_put(path = path, staged = staged, started = started, text = String::concat(__to_string(String::length(target_text)), ":"))
  typing_reuse_put(path = path, staged = staged, started = started, text = target_text)
  typing_reuse_flush(path = path, staged = staged, started = started)
}

/// Writes the staged pieces: the first write creates (truncates) the file and
/// every later one appends.
fn typing_reuse_flush(path: String, staged: Array[String], started: Array[Bool]) -> Unit with Fs {
  let text = String::join(staged, sep = "")
  Array::truncate(staged, length = 0)
  if Array::get(started, at = 0) {
    Fs::append(path, contents = text)
  } else {
    Fs::write_file(path, contents = text)
    Array::set(started, at = 0, value = true)
  }
}

fn typing_reuse_put(path: String, staged: Array[String], started: Array[Bool], text: String) -> Unit with Fs {
  if String::length(text) >= 4096 {
    typing_reuse_flush(path = path, staged = staged, started = started)
    Fs::append(path, contents = text)
  } else {
    Array::push(staged, value = text)
  }
}

/// Decode both outputs strictly and require canonical re-encoding to equal
/// the raw file and the exact witness/alias text. Ordinary cache loading may
/// normalize a legacy host prefix; reuse bindings require byte equality.
fn load_canonical_typing_dependency_env_reuse_target(target_fingerprint: String, expected_target_text: String) -> Option[PersistentModuleCache] with Env + Fs {
  load_canonical_typing_dependency_env_reuse_target_in_namespace(target_fingerprint = target_fingerprint, expected_target_text = expected_target_text, namespace = persistent_cache_namespace_current())
}

/// Use the caller's captured cache namespace.
fn load_canonical_typing_dependency_env_reuse_target_in_namespace(target_fingerprint: String, expected_target_text: String, namespace: String) -> Option[PersistentModuleCache] with Env + Fs {
  let target_path = persistent_type_env_cache_path_in_namespace(target_fingerprint, namespace = namespace)
  if !Fs::exists(target_path) {
    None
  } else {
    handle {
      let raw_target_text = Fs::read_file(target_path)
      match parse_persistent_module_cache(raw_target_text) {
        Some(record) => {
          let canonical_target_text = persistent_module_cache_text(env = record.env, lowering = record.lowering)
          if raw_target_text == canonical_target_text && raw_target_text == expected_target_text {
            Some(record)
          } else {
            None
          }
        },
        None => None
      }
    } with { Exception::Throw(_) => None }
  }
}

/// The witness binding published for `fingerprint`, parsed but with its
/// target NOT re-validated: `(input key, target text)`. Callers that have not
/// validated that target themselves use `typing_dependency_env_reuse_witness_binding`.
fn typing_dependency_env_reuse_witness_text(_ fingerprint: String) -> Option[(String, String)] with Env + Fs {
  typing_dependency_env_reuse_witness_text_in_namespace(fingerprint, namespace = persistent_cache_namespace_current())
}

/// Use the caller's captured cache namespace.
fn typing_dependency_env_reuse_witness_text_in_namespace(_ fingerprint: String, namespace: String) -> Option[(String, String)] with Env + Fs {
  let witness_path = persistent_typing_dependency_env_reuse_eligibility_path_in_namespace(fingerprint, namespace = namespace)
  if !Fs::exists(witness_path) {
    None
  } else {
    match parse_typing_dependency_reuse_binding(text = Fs::read_file(witness_path), tag = typing_dependency_env_reuse_witness_v10_tag) {
      Some((input_key, target_fingerprint, target_text)) => if target_fingerprint != fingerprint {
        None
      } else {
        Some((input_key, target_text))
      },
      None => None
    }
  }
}

fn typing_dependency_env_reuse_witness_binding(_ fingerprint: String) -> Option[(String, String)] with Env + Fs {
  typing_dependency_env_reuse_witness_binding_in_namespace(fingerprint, namespace = persistent_cache_namespace_current())
}

/// Use the caller's captured cache namespace.
fn typing_dependency_env_reuse_witness_binding_in_namespace(_ fingerprint: String, namespace: String) -> Option[(String, String)] with Env + Fs {
  let witness_path = persistent_typing_dependency_env_reuse_eligibility_path_in_namespace(fingerprint, namespace = namespace)
  if !Fs::exists(witness_path) {
    None
  } else {
    match parse_typing_dependency_reuse_binding(text = Fs::read_file(witness_path), tag = typing_dependency_env_reuse_witness_v10_tag) {
      Some((input_key, target_fingerprint, target_text)) =>
      if target_fingerprint != fingerprint {
        None
      } else {
        match load_canonical_typing_dependency_env_reuse_target_in_namespace(target_fingerprint = target_fingerprint, expected_target_text = target_text, namespace = namespace) {
          Some(_) => Some((input_key, target_text)),
          None => None
        }
      },
      None => None
    }
  }
}

/// #2945: the dependency fingerprints whose witness this walk has already
/// validated. Without it the eligibility walk re-read and re-validated a
/// dependency's witness once per DEPENDENT: the witness embeds the
/// dependency's verbatim source and its own dependencies' env texts, and
/// validating it reads, decodes and re-encodes the target record too, so a
/// widely imported module was paid for hundreds of times. Measured on a cold
/// `vibe check lib/@vibe/cli/entry.vibe` (427 modules), that walk alone
/// allocated 882 MB of a 4 GiB address space.
///
/// Only POSITIVE answers are kept, and only for one walk
/// (`ensure_fingerprint_fs_impl` resets it with the other per-walk memos). A
/// positive answer only admits the alias lookup: that lookup still validates
/// the exact alias/witness/target binding of the module being reused, and
/// the dependency envs in its input key come from this walk's memory, not
/// from the dependency's witness, so remembering a validation cannot turn a
/// file torn after it into a reuse. A negative answer is re-asked, so a
/// witness published later in the walk is still seen.
let typing_dependency_env_reuse_valid_witness_memo: Array[String] = []

export fn typing_dependency_env_reuse_valid_witness_memo_reset() -> Unit {
  Array::truncate(typing_dependency_env_reuse_valid_witness_memo, length = 0)
  Array::set(typing_reuse_text_memo_cell, at = 0, value = MutMap::new_string())
}

fn typing_dependency_env_reuse_eligibility_is_valid(_ fingerprint: String) -> Bool with Env + Fs {
  typing_dependency_env_reuse_eligibility_is_valid_in_namespace(fingerprint, namespace = persistent_cache_namespace_current())
}

/// Use the caller's captured cache namespace.
fn typing_dependency_env_reuse_eligibility_is_valid_in_namespace(_ fingerprint: String, namespace: String) -> Bool with Env + Fs {
  if contains_str(arr = typing_dependency_env_reuse_valid_witness_memo, target = fingerprint) {
    true
  } else {
    match typing_dependency_env_reuse_witness_binding_in_namespace(fingerprint, namespace = namespace) {
      Some(_) => {
        Array::push(typing_dependency_env_reuse_valid_witness_memo, value = fingerprint)
        true
      },
      None => false
    }
  }
}

/// Eligibility is transitively witnessed by successful canonical v11 module
/// commits. Missing, malformed, stale, torn, or cross-spliced witnesses fail
/// closed before the alias lookup.
export fn typing_dependency_env_reuse_is_eligible(_ dep_fps: Array[(String, String)]) -> Bool with Env + Fs {
  typing_dependency_env_reuse_is_eligible_in_namespace(dep_fps, namespace = persistent_cache_namespace_current())
}

/// Use the caller's captured cache namespace.
export fn typing_dependency_env_reuse_is_eligible_in_namespace(_ dep_fps: Array[(String, String)], namespace: String) -> Bool with Env + Fs {
  let mut i = 0
  let mut deps_eligible = true
  while deps_eligible && i < Array::length(dep_fps) {
    let (_dep_path, dep_fingerprint) = Array::get(dep_fps, at = i)
    if typing_dependency_env_reuse_eligibility_is_valid_in_namespace(dep_fingerprint, namespace = namespace) {
      ()
    } else {
      deps_eligible = false
    }
    i = i + 1
  }
  deps_eligible
}

/// Publishing a witness also records it as valid for this walk: it binds the
/// target this walk just committed under `fingerprint`, so reading it back to
/// validate it for the next dependent would re-read and re-encode a record
/// whose text is the one just written. The memo still only admits the alias
/// lookup, which validates the exact three-way binding itself.
export fn publish_typing_dependency_env_reuse_eligibility(input_key: TypingReuseKey, fingerprint: String, target_text: String) -> Unit with Env + Fs {
  publish_typing_dependency_env_reuse_eligibility_in_namespace(input_key = input_key, fingerprint = fingerprint, target_text = target_text, namespace = persistent_cache_namespace_current())
}

/// Use the caller's captured cache namespace.
export fn publish_typing_dependency_env_reuse_eligibility_in_namespace(input_key: TypingReuseKey, fingerprint: String, target_text: String, namespace: String) -> Unit with Env + Fs {
  write_typing_reuse_binding(path = persistent_typing_dependency_env_reuse_eligibility_path_in_namespace(fingerprint, namespace = namespace), tag = typing_dependency_env_reuse_witness_v10_tag, input_key = input_key, target_fingerprint = fingerprint, target_text = target_text, namespace = namespace)
  if contains_str(arr = typing_dependency_env_reuse_valid_witness_memo, target = fingerprint) {
    ()
  } else {
    Array::push(typing_dependency_env_reuse_valid_witness_memo, value = fingerprint)
  }
}

export fn load_typing_dependency_env_reuse_target(path: String, input_key: TypingReuseKey) -> Option[(String, String, TypeEnv)] with Env + Fs {
  load_typing_dependency_env_reuse_target_in_namespace(path = path, input_key = input_key, namespace = persistent_cache_namespace_current())
}

/// Use the caller's captured cache namespace.
export fn load_typing_dependency_env_reuse_target_in_namespace(path: String, input_key: TypingReuseKey, namespace: String) -> Option[(String, String, TypeEnv)] with Env + Fs {
  let sidecar_path = typing_reuse_sidecar_path_in_namespace(input_key, namespace = namespace)
  if !Fs::exists(sidecar_path) {
    None
  } else {
    match parse_typing_dependency_reuse_alias(Fs::read_file(sidecar_path)) {
      Some(target_fingerprint) => {
        // Only an exact binding reuses: the witness the alias names carries
        // this verbatim input key, and its target text is the raw record.
        match typing_dependency_env_reuse_witness_text_in_namespace(target_fingerprint, namespace = namespace) {
          Some((witness_input_key, target_text)) => if !typing_reuse_key_matches_in_namespace(text = witness_input_key, key = input_key, namespace = namespace) {
            None
          } else {
            match load_canonical_typing_dependency_env_reuse_target_in_namespace(target_fingerprint = target_fingerprint, expected_target_text = target_text, namespace = namespace) {
              Some(record) =>
              match record.lowering {
                Some((offsets, eq_offs, eq_keys)) => {
                  module_typed_lowering_memo_put(path = path, fingerprint = target_fingerprint, offsets = offsets, eq_offs = eq_offs, eq_keys = eq_keys)
                  Some((target_fingerprint, target_text, record.env))
                },
                None => None
              },
              None => None
            }
          },
          None => None
        }
      },
      None => None
    }
  }
}

export fn write_typing_dependency_env_reuse_sidecar(input_key: TypingReuseKey, target_fingerprint: String) -> Unit with Env + Fs {
  write_typing_dependency_env_reuse_sidecar_in_namespace(input_key = input_key, target_fingerprint = target_fingerprint, namespace = persistent_cache_namespace_current())
}

/// Use the caller's captured cache namespace.
export fn write_typing_dependency_env_reuse_sidecar_in_namespace(input_key: TypingReuseKey, target_fingerprint: String, namespace: String) -> Unit with Env + Fs {
  Fs::write_file(typing_reuse_sidecar_path_in_namespace(input_key, namespace = namespace), contents = typing_dependency_reuse_alias_text(target_fingerprint))
}

export fn write_persistent_dep_list_if_missing(path: String, source: String, deps: Array[String]) -> Unit with Env + Fs {
  write_persistent_dep_list_if_missing_in_namespace(path = path, source = source, deps = deps, namespace = persistent_cache_namespace_current())
}

/// Use the caller's captured cache namespace.
export fn write_persistent_dep_list_if_missing_in_namespace(path: String, source: String, deps: Array[String], namespace: String) -> Unit with Env + Fs {
  let dep_cache_path = persistent_dep_list_cache_path_in_namespace(path = path, source_fingerprint = compact_source_fingerprint_memo(path = path, source = source), namespace = namespace)
  if !(Fs::exists(dep_cache_path)) {
    Fs::write_file(dep_cache_path, contents = persistent_dep_list_text(deps))
  } else {
    ()
  }
}
/// Span of an identifier run starting at `start` (returns the end offset).
export fn typecheck_ident_run(s: String, start: Int) -> Int {
  engine_typecheck_ident_run(s = s, start = start)
}
/// Does `msg` already carry a `line N:C` location?
///
/// Two shapes reach the final locate pass already located:
///   `line 3:3-4: <msg>`                 -- located, not yet path-prefixed
///   `/path/to/mod.vibe: line 3:3-4: ..` -- located AND path-prefixed by the
///                                          per-module pass (see the
///                                          `job.path + ": "` concat below)
///
/// The second shape used to slip past the guard, which only tested for the
/// location at index 0. A path-prefixed message then went through the
/// first-occurrence heuristic AGAIN -- against the ENTRY module's source, which
/// is not necessarily the source the error came from -- and got a SECOND,
/// earlier location glued to its front:
///
///   error: line 1:12: /tmp/x.vibe: line 3:3-4: function arity mismatch for g
///          ^^^^^^^^^ g's DECLARATION      ^^^^^^^^ the actual call site
///
/// Both locations are real positions of `g`, so nothing looks malformed; the
/// first one is simply the wrong one, and it is the one a reader (or an LSP
/// parsing `^line N:C`) takes. Reporting a confident wrong location is worse
/// than reporting none, so recognize the path-prefixed shape too.
///
/// Recognized by SHAPE, at any position: `line <digits>:<digits>` sitting
/// either at the start of the message or right after a `: ` delimiter. An
/// earlier revision anchored on the FIRST `: ` on the theory that a path cannot
/// contain one -- but `: ` is legal in a POSIX path (`/tmp/foo: bar/x.vibe`),
/// and there the anchor lands inside the path, the guard returns false, and the
/// heuristic prepends its wrong location again: the exact bug this is here to
/// stop (#1628 review, Codex P2). Scanning every candidate makes the answer
/// depend on the message's shape rather than on assumptions about path
/// contents.
///
/// Erring toward "already located" is the safe direction. A false positive
/// costs a location the heuristic might have guessed; a false negative
/// reinstates a CONFIDENTLY WRONG one. Missing information beats misinformation
/// (docs/internal/project/issue-triage.md ranks silent-wrong above every other failure).
export fn diag_already_located(_ msg: String) -> Bool {
  engine_diag_already_located(msg)
}

/// First-occurrence heuristic locator (the original behavior). Kept separate so
/// the offset-marker path can fall through to it on the marker-stripped message.
export fn locate_type_error_heuristic(source: String, msg: String) -> String {
  engine_locate_type_error_heuristic(source = source, msg = msg)
}
/// Build the `line L:col C: ` prefix for a source char offset (same format as
/// locate_by_marker). String::concat only — the `+`/interpolation NUL
/// hazard applies here too.
export fn offset_line_col_prefix(source: String, off: Int) -> String {
  engine_offset_line_col_prefix(source = source, off = off)
}
/// Build a `line L:colC-E: ` RANGE prefix from a (start, end) char-offset span.
/// When start and end fall on the same source line this carries the exact end
/// column so the LSP can highlight the precise token (incl. qualified names);
/// when end is on a later line (or not greater than start) it degrades to the
/// point prefix. Backward compatible: `line L:` still leads, so existing
/// `grep -F "line N:"` assertions keep matching. String::concat only.
export fn offset_line_col_range_prefix(source: String, start: Int, endo: Int) -> String {
  engine_offset_line_col_range_prefix(source = source, start = start, endo = endo)
}
/// Parse a non-negative decimal integer from msg[start..end). Returns -1 if the
/// span is empty or contains a non-digit (callers then fall through to the text
/// heuristic).
export fn parse_offset_digits(msg: String, start: Int, end: Int) -> Int {
  engine_parse_offset_digits(msg = msg, start = start, end = end)
}

/// Recover the source offset of a declaration name tagged `[@fn=name]`.
/// Prefer a `fn name` declaration, then `let name` / `let mut name`, then a
/// plain whole-word occurrence. -1 when the name cannot be found.
///
/// #2244 review: the scan is a raw-text heuristic, and three failure modes
/// made it confidently wrong -- a comment or string literal spelling the
/// declaration (`// let v used to be ...`) anchored the diagnostic at the
/// comment, a shadowed binder anchored at the FIRST `let v` rather than
/// the failing one, and a cross-kind collision (`fn v` at top level while
/// the failing binding is a local `let v`) anchored at the unrelated fn --
/// the marker records only the NAME, so the kind cannot break the tie.
/// So the scan skips `//` comments and string literals, and it anchors
/// only when exactly ONE declaration of the name exists across BOTH
/// declaration kinds (`fn name` and `let name` combined), falling back to
/// a bare occurrence only when it is the name's sole appearance. Anything
/// ambiguous (shadowing, re-declaration, fn/let collision) returns -1 and
/// the message stays unlocated -- missing information beats misinformation.
export fn find_fn_anchor_off(source: String, name: String) -> Int {
  engine_find_fn_anchor_off(source = source, name = name)
}
