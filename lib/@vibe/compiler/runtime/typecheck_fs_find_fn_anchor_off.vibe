/// Stable sidecar payload. Keep this manual rendering rather than depending on
/// a JSON library in the hot compiler package: all values are non-negative
/// integers and the fixed key order makes the result byte-for-byte
/// deterministic for an identical walk.
export fn incremental_typecheck_telemetry_v1_json() -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, value = "{\"schema\":1,\"modules_planned\":")
  StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(0)))
  StringBuilder::push(out, value = ",\"modules_rechecked\":")
  StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(1)))
  StringBuilder::push(out, value = ",\"modules_reused\":")
  StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(2)))
  StringBuilder::push(out, value = ",\"parse_operations\":")
  StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(3)))
  StringBuilder::push(out, value = ",\"modules_failed_or_blocked\":")
  StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(4)))
  StringBuilder::push(out, value = "}")
  StringBuilder::freeze(out)
}

export fn incremental_typecheck_telemetry_json() -> String {
  let artifact_mode = checked_module_cache_mode() != "off"
  let out = StringBuilder::new()
  StringBuilder::push(out, value = if artifact_mode {
    "{\"schema\":5,\"modules_planned\":"
  } else {
    "{\"schema\":4,\"modules_planned\":"
  })
  StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(0)))
  StringBuilder::push(out, value = ",\"modules_rechecked\":")
  StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(1)))
  StringBuilder::push(out, value = ",\"modules_reused\":")
  StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(2)))
  StringBuilder::push(out, value = ",\"parse_operations\":")
  StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(3)))
  StringBuilder::push(out, value = ",\"modules_failed_or_blocked\":")
  StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(4)))
  StringBuilder::push(out, value = ",\"current_source_parse_executions\":")
  StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(5)))
  StringBuilder::push(out, value = ",\"checker_executions\":")
  StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(6)))
  StringBuilder::push(out, value = ",\"modules_reused_conservative_fingerprint\":")
  StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(7)))
  StringBuilder::push(out, value = ",\"modules_reused_dependency_transport_env\":")
  StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(8)))
  if artifact_mode {
    StringBuilder::push(out, value = ",\"modules_reused_checked_module_artifact\":")
    StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(9)))
  }
  StringBuilder::push(out, value = ",\"non_walk_parse_operations\":")
  StringBuilder::push(out, value = __to_string(incremental_typecheck_telemetry_counter(10)))
  StringBuilder::push(out, value = ",\"ast_cache_prefetches\":")
  StringBuilder::push(out, value = __to_string(ast_cache_prefetch_count()))
  StringBuilder::push(out, value = "}")
  StringBuilder::freeze(out)
}

