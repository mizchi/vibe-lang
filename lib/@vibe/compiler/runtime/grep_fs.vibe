//# Imports

// `vibe grep`'s filesystem tier (#1572 scope 3). Kept apart from grep.vibe on
// purpose: this file imports typecheck_fs.vibe, whose `ModuleJob` is declared
// in the package CONTRACT rather than in the file itself, so anything that
// reaches typecheck_fs.vibe can only be compiled with index.vpkg in scope.
// grep.vibe stays free of that dependency, which is what lets grep_test.vibe
// drive the whole pattern language and every typed filter as plain sibling
// leaf imports.
//
// The two tiers #1572 specifies:
//   * no typed filter  -> parse only, no import resolution, one pass per file;
//   * any typed filter -> the file is typed through the SAME FS import walk
//     `vibe check` uses, so this cannot reproduce the `vibe diagnostics`
//     import-blind false positives the issue calls out.

import @vibe/compiler/core {
  TypeEnv
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/loader {
  collect_source_groups_fs
}

import @vibe/compiler/incremental {
  RippleDb, ripple_get_deps, ripple_get_fingerprint, ripple_new, ripple_set_source
}

import ./source_walk.vibe {
  source_walk_collect_files
}

import ./grep.vibe {
  GrepTyped,
  grep_check_filters,
  grep_compile_pattern,
  grep_emit_hits,
  grep_empty_hits,
  grep_empty_strings,
  grep_file_hits,
  grep_join_lines,
  grep_needs_typing,
  grep_typed_context,
  grep_typed_context_error,
  grep_untyped_context
}

import ./persistent_env_codec.vibe {
  load_persistent_type_env
}

import ./typecheck_fs.vibe {
  ensure_fingerprint_fs_impl, projected_import_env_for_test
}

//# Functions

fn grep_fs_empty_env_cache() -> Array[(String, TypeEnv)] {
  array_empty()
}

fn grep_fs_empty_pairs() -> Array[(String, String)] {
  array_empty()
}

/// The typed context for `path`, resolved the way `vibe check` resolves it.
///
/// `vibe check`'s pipeline is: collect every reachable module's INGESTED source
/// (collect_source_groups_fs), seed them all into the ripple db, then walk.
/// The seeding is load-bearing -- the walk short-circuits on any module whose
/// source it cannot find, so skipping it makes every import resolve to
/// `CtUnknown` and quietly turns every typed filter into a coin flip.
///
/// `projected_import_env_for_test` is the exported name for the exact
/// dependency projection production uses for `ModuleJob.dep_envs`
/// (typecheck_fs.vibe) -- test-only in NAME, not in behaviour.
///
/// Degrades to single-file typing when the graph cannot be resolved at all, so
/// one broken dependency costs precision on that file instead of killing the
/// sweep. On a file with imports that fallback reports imported names as
/// unknown, which makes `--only-ill-typed` over-report rather than miss sites.
/// #2914: `cache_in` is threaded THROUGH, not reset. Each call used to pass
/// `grep_fs_empty_env_cache()`, so every matching file re-typed its entire
/// dependency closure from cold. On a package that is merely slow; on the tree
/// it exhausted linear memory and the runtime reported `out of bounds memory
/// access`, which reads like a pointer bug in the query engine and is not one.
/// Proven by varying only the cap: a corpus that succeeds at the default 8192
/// MB traps with the identical message at 512 MB.
///
/// The env cache is keyed by dependency PATH and `ensure_fingerprint_fs_impl`
/// only records a module once it has actually checked it, so its entries are
/// whole per module and reusable across entries. That is the same reuse the
/// incremental build already relies on from this function; grep was the only
/// caller discarding it.
///
/// `rdb_in` and `dep_sources_in` are threaded for the same reason, and they
/// only pay off TOGETHER. Sharing the ripple db alone changes nothing
/// measurable: the db supplies the FINGERPRINT half of `step_module_fs`'s
/// reuse test, and the other half is `dep_source_cache_is_current`, which a
/// per-call empty cache answers `false` for every time -- so the walk re-checked
/// every module with the fingerprint sitting right there. Measured, sharing the
/// db by itself was +0.2% wall and no memory change.
///
/// Neither shared value can carry one entry's context into another's answer.
/// Both are keyed by dependency PATH: the ripple db maps a path to that file's
/// own text, the dep-source cache maps a path to the text last walked for it,
/// and a relative import resolves through the importing file's directory,
/// which is part of the path. `valid_persistent_type_env` is content-addressed
/// by fingerprint on top of that. `grep_fs_test.vibe` pins the property with
/// two swept files binding the same name to different types.
fn grep_fs_typed_context(path: String, raw_source: String, cache_in: Array[(String, TypeEnv)], rdb_in: RippleDb, dep_sources_in: Array[(String, String)]) -> (GrepTyped, Array[(String, TypeEnv)], RippleDb, Array[(String, String)]) with Fs {
  handle {
    let groups = collect_source_groups_fs(path)
    let mut rdb = rdb_in
    let mut entry_source = raw_source
    let mut gi = 0
    while gi < Array::length(groups) {
      let (_, sources) = Array::get(groups, gi)
      let mut si = 0
      while si < Array::length(sources) {
        let (p, text) = Array::get(sources, si)
        rdb = ripple_set_source(rdb, p, text)
        if p == path {
          entry_source = text
        } else {
          ()
        }
        si = si + 1
      }
      gi = gi + 1
    }
    let (_, walked, env_cache, dep_sources, _) = ensure_fingerprint_fs_impl(rdb, cache_in, dep_sources_in, 0, path)
    let deps = match ripple_get_deps(walked, path) {
      Some(d) => d,
      None => grep_empty_strings()
    }
    let import_env = projected_import_env_for_test(entry_source, path, deps, grep_fs_fill_dep_envs(walked, env_cache, deps))
    (grep_typed_context(raw_source, entry_source, import_env), env_cache, walked, dep_sources)
  } with {
  // The graph did not check. That is a real answer, not a reason to fall
  // back to single-file typing: doing so would type-check this file against
  // an empty environment, find nothing wrong with it, and report every match
  // in a program that does not compile as `--only-well-typed`.
  // `cache_in` and not an empty cache: entries are whole per module, so a
  // file whose own walk threw leaves the ones already recorded valid for the
  // files after it.
  // `rdb_in` / `dep_sources_in` and not fresh ones, for the same reason as
  // `cache_in`: both are per-path records of a file's own text, so the rows a
  // thrown walk already wrote stay valid for the files after it.
  Exception::Throw(msg) => (grep_typed_context_error(raw_source, msg), cache_in, rdb_in, dep_sources_in) }
}

fn grep_fs_cache_has(cache: Array[(String, TypeEnv)], path: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(cache) {
    let (p, _) = Array::get(cache, i)
    if p == path {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

/// Fill in the dependency environments the walk did NOT return in-memory.
///
/// `ensure_fingerprint_fs_impl` only adds a module to its env cache when it
/// actually re-checks it; a module whose persistent environment was already on
/// disk is recorded in the ripple db and skipped. That is the normal (warm)
/// case, so without this step a repeat run resolves imports against an empty
/// cache -- `projected_import_env_for_test` then throws and every imported name
/// types as `CtUnknown`. Reading each missing dependency back from the same
/// persistent store the walk published to is what makes the typed tier behave
/// the same warm as cold.
fn grep_fs_fill_dep_envs(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], deps: Array[String]) -> Array[(String, TypeEnv)] with Exception + Fs {
  let mut i = 0
  while i < Array::length(deps) {
    let dep = Array::get(deps, i)
    if !grep_fs_cache_has(env_cache, dep) {
      match ripple_get_fingerprint(rdb, dep) {
        Some(fingerprint) => match load_persistent_type_env(fingerprint) {
          Some(dep_env) => Array::push(env_cache, (dep, dep_env)),
          None => ()
        },
        None => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  env_cache
}

/// The linear-memory ceiling this sweep must stay under, in bytes.
///
/// wasm32 tops out at 4 GiB (`0xFFFF0000`), and that -- not the runner's
/// `MOONRUN_WT_MEMORY_MB` soft cap -- is the binding constraint: raising the
/// soft cap from 8192 to 16384 was measured to change nothing (#2914, recorded
/// in scripts/lint_review_regressions.sh).
///
/// `VIBE_GREP_MEMORY_BUDGET_MB` overrides it, which is also how the budget is
/// tested: a corpus that sweeps clean at the default must refuse at a small
/// budget, varying only the cap.
fn grep_memory_ceiling_bytes() -> Int with Env + Exception {
  let raw = Env::get("VIBE_GREP_MEMORY_BUDGET_MB")
  if raw == "" {
    4294901760
  } else {
    let mb = grep_parse_positive_int(raw)
    if mb <= 0 {
      throw("VIBE_GREP_MEMORY_BUDGET_MB must be a positive whole number of megabytes")
    } else {
      mb * 1048576
    }
  }
}

/// `text` as a positive Int, or 0 when it is not all ASCII digits. Rejecting
/// rather than saturating: a budget read as a wrong number is a budget that
/// silently does not hold.
fn grep_parse_positive_int(text: String) -> Int {
  let n = String::length(text)
  if n == 0 {
    return 0
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = String::byte_at(text, i)
    if c < 48 || c > 57 {
      return 0
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  acc
}

/// How many times the largest observed per-file cost must still fit before the
/// sweep types another file.
///
/// 2 is a compromise with no clean answer, and the number is here rather than
/// inline so it is arguable. Per-file cost spans ~50x, so a factor that made
/// the guard sound against the worst case would stop nearly every sweep
/// immediately; a factor of 1 would let a file only slightly larger than the
/// previous maximum overrun. `VIBE_GREP_MEMORY_SAFETY_FACTOR` exists for the
/// caller who would rather stop early than retry.
fn grep_memory_safety_factor() -> Int with Env + Exception {
  let raw = Env::get("VIBE_GREP_MEMORY_SAFETY_FACTOR")
  if raw == "" {
    2
  } else {
    let n = grep_parse_positive_int(raw)
    if n <= 0 {
      throw("VIBE_GREP_MEMORY_SAFETY_FACTOR must be a positive whole number")
    } else {
      n
    }
  }
}

/// The refusal text for a sweep that cannot afford the next file.
///
/// It names the edit, per the CLI diagnostic policy: which file it stopped
/// before, how far it got, and the two ways out (a narrower root, or no
/// `--where`, which is the untyped tier that handles the whole tree).
fn grep_memory_refusal(path: String, done: Int, total: Int, headroom: Int, need: Int) -> String {
  let mb = 1048576
  String::concat("vibe grep: out of memory budget before typing `", String::concat(path, String::concat("` (", String::concat(__to_string(done), String::concat(" of ", String::concat(__to_string(total), String::concat(" files swept); headroom ", String::concat(__to_string(headroom / mb), String::concat(" MB, the largest file so far needed ", String::concat(__to_string(need / mb), " MB. Lower VIBE_GREP_CHUNK_FILES so fewer files share one process, sweep a subdirectory, or drop --where to use the untyped tier. VIBE_GREP_MEMORY_BUDGET_MB raises the budget, but wasm32 linear memory stops at 4096 MB."))))))))))
}

/// `vibe grep <root>` proper. Typing runs only for files that already have a
/// structural match: typing a file the pattern never hits would be pure cost.
export fn grep_scan_fs_report(root: String, pattern: String, wheres: Array[String], where_rows: Array[String], only: String, json: Bool) -> (String, String) with Env + Exception + Fs + Profiler {
  let files = grep_empty_strings()
  source_walk_collect_files(root, files)
  grep_scan_files_report(files, pattern, wheres, where_rows, only, json, Fs::is_dir(root), "")
}

/// The files a sweep of `root` would visit, one per line, in sweep order.
///
/// #2914: this exists so a DRIVER can partition the sweep across processes
/// without re-deriving which files are in it. The skip policy is a
/// user-visible answer and `source_walk.vibe` says it lives in exactly one
/// place -- a driver that globbed for `*.vibe` itself would disagree with the
/// sweep about `deps/`, `_build/` and dotted directories, and nothing would
/// say so. Asking the sweep is what keeps one policy.
export fn grep_list_files(root: String) -> String with Fs {
  let files = grep_empty_strings()
  source_walk_collect_files(root, files)
  grep_join_lines(files, false)
}

/// Split a listing produced by `grep_list_files` back into paths.
///
/// Both halves of the file-list contract live here, with the format, so a
/// producer and a consumer cannot disagree about it. The two drivers
/// (`scripts/vibe_grep_bin.sh` and `runtime/vibe`) and the two CLI entry
/// paths (env-mode `cli_adapter`, argv-mode `user_dispatch`) all go through
/// these, rather than each carrying its own splitter.
export fn grep_split_file_list(text: String) -> Array[String] {
  let out = grep_empty_strings()
  let mut start = 0
  let mut i = 0
  while i <= String::length(text) {
    if i == String::length(text) || String::byte_at(text, i) == 10 {
      let line = String::substring(text, start, i)
      if String::length(line) > 0 {
        Array::push(out, line)
      } else {
        ()
      }
      start = i + 1
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// The chunk a driver wrote, read back as paths.
export fn grep_read_file_list(path: String) -> Array[String] with Exception + Fs {
  grep_split_file_list(Fs::read_file(path))
}

/// The sweep proper, over an EXPLICIT file list.
///
/// #2914: a single wasm32 process tops out at 4 GiB and the sweep's cost
/// accumulates across files, so a tree-wide typed sweep cannot finish in one
/// process however cheap each file is made -- measured, neither dropping the
/// 46 MB of generated bundles (file 70 -> 118 of 1224) nor building the
/// compiler on the RC lane, which frees (file 70 -> 71), changes that shape.
/// The driver runs this once per chunk in a FRESH process, which is the one
/// thing that does reset the frontier.
/// `root_is_dir` is #2940's distinction, threaded EXPLICITLY because this
/// function no longer sees the root. Naming a file is asking about that file,
/// so "it could not be parsed" must not answer as "no matches"; a sweep of a
/// directory is the opposite case and keeps #1943's skip. The chunked lane
/// gets it right because the adapter still receives the original root and
/// computes the flag from it -- a chunk is a subset of one root, never a mix.
///
/// This parameter exists because a MERGE, not a conflict, removed it: #2940
/// added `let root_is_dir = Fs::is_dir(root)` to the body that this commit had
/// already moved into a function with no `root`. Git merged both edits cleanly
/// and the result did not compile (`unknown name: root`). Passing it in is
/// what makes the dependency visible instead of ambient.
/// `resume_out`, when non-empty, names a file the sweep writes the index of
/// the first file it did NOT reach to. That turns the budget guard from a
/// REFUSAL into a hand-off: the driver restarts from there in a fresh process,
/// which is the one thing that resets the bump frontier, and no constant chunk
/// size is needed at all.
///
/// Empty keeps the #2914 (a) behaviour: throw the located diagnostic. Both
/// exist because the guard is the only thing that knows when to stop, and a
/// caller that cannot restart (a library call, `runtime/vibe` before it grows
/// a resume loop) still needs a loud failure rather than a partial answer.
///
/// TERMINATION: the guard cannot fire before at least one file has been typed
/// -- it needs `max_typed_cost > 0`, which only a completed typed file
/// supplies -- so every hand-off advances by at least one file. The driver
/// asserts that anyway, because a resume loop that does not advance would
/// print results forever, which is worse than the trap this replaces.
export fn grep_scan_files_report(files: Array[String], pattern: String, wheres: Array[String], where_rows: Array[String], only: String, json: Bool, root_is_dir: Bool, resume_out: String) -> (String, String) with Env + Exception + Fs + Profiler {
  let pat = grep_compile_pattern(pattern)
  grep_check_filters(pat, wheres, where_rows)
  let typed = grep_needs_typing(wheres, where_rows, only)
  let has_typed_filter = Array::length(wheres) > 0 || Array::length(where_rows) > 0
  let out = grep_empty_strings()
  let warnings = grep_empty_strings()
  let mut named_unparseable = ""
  // #2914: three caches for the whole sweep, not one per file. Cold every
  // time, the tree-wide typed sweep re-typed the compiler's closure once per
  // matching file and ran past the 8 GB linear-memory cap. The env cache alone
  // was not enough: `step_module_fs` reuses a module only when the ripple db
  // has its fingerprint AND the dep-source cache says its text is unchanged,
  // so a fresh db or a fresh dep-source cache re-checks the closure either
  // way. See grep_fs_typed_context for why sharing all three is sound.
  // #2914: the typed tier used to TRAP on a tree-wide sweep -- a bare wasm
  // `out of bounds memory access` naming neither the file nor the stage. The
  // budget below turns the common case into a diagnostic that names both.
  //
  // It is a HEURISTIC, not a proof, and the comment says so because the
  // diagnostic cannot: the guard stops when the headroom no longer covers
  // `grep_memory_safety_factor` times the largest per-file cost SEEN SO FAR,
  // and per-file cost tracks dependency-closure size with roughly a 50x spread
  // (24 MB to 1303 MB, measured). A file whose closure dwarfs everything
  // before it can still overrun the reserve. What the guard removes is the
  // silent case; it does not make the trap impossible.
  let memory_ceiling = grep_memory_ceiling_bytes()
  let mut max_typed_cost = 0
  let mut typed_env_cache = grep_fs_empty_env_cache()
  let mut typed_rdb = ripple_new()
  let mut typed_dep_sources = grep_fs_empty_pairs()
  let mut i = 0
  while i < Array::length(files) {
    let path = Array::get(files, i)
    let source = Fs::read_file(path)
    // A file that does not parse is not a match and not a failure: a repo
    // sweep must not stop at the first work-in-progress file. Report the
    // skip on the warning sidecar so empty stdout still means no matches,
    // not silently skipped input (#1943).
    let hits = handle {
      grep_file_hits(path, source, pat)
    } with { Exception::Throw(_) => {
      Array::push(warnings, String::concat("warning: grep: skipped `", String::concat(path, "` because it could not be parsed")))
      if !root_is_dir {
        named_unparseable = path
      } else {
        ()
      }
      grep_empty_hits()
    } }
    if Array::length(hits) > 0 {
      let ctx = if typed {
        // Checked BEFORE the allocation rather than after: once the frontier
        // is past the ceiling the process is already gone, so a check that
        // ran afterwards would never report anything.
        let heap_before = Profiler::heap_bytes()
        let headroom = memory_ceiling - heap_before
        let reserve = max_typed_cost * grep_memory_safety_factor()
        if max_typed_cost > 0 && headroom < reserve {
          if resume_out != "" {
            // Hand off, do not refuse: `i` is the index of the file NOT
            // swept, so the driver resumes exactly there. Returning early
            // keeps everything found so far -- it is a complete answer for
            // files[0..i), and the driver concatenates the rest.
            //
            // The `named_unparseable` throw below is unreachable from here by
            // construction: it needs `root_is_dir == false`, which means the
            // caller named ONE file, and the guard needs a previously typed
            // file to have a cost at all. One file cannot be both.
            Fs::write_file(resume_out, __to_string(i))
            return (grep_join_lines(out, json), grep_join_lines(warnings, false))
          } else {
            throw(grep_memory_refusal(path, i, Array::length(files), headroom, max_typed_cost))
          }
        } else {
          ()
        }
        let (typed_ctx, next_cache, next_rdb, next_dep_sources) = grep_fs_typed_context(path, source, typed_env_cache, typed_rdb, typed_dep_sources)
        typed_env_cache = next_cache
        typed_rdb = next_rdb
        typed_dep_sources = next_dep_sources
        let cost = Profiler::heap_bytes() - heap_before
        if cost > max_typed_cost {
          max_typed_cost = cost
        } else {
          ()
        }
        typed_ctx
      } else {
        grep_untyped_context()
      }
      if has_typed_filter && ctx.type_error != "" {
        // The typed answer for this file is untrustworthy, but the remaining
        // files are independent. Fail closed for this file and keep sweeping.
        Array::push(warnings, String::concat("warning: grep: skipped `", String::concat(path, String::concat("` because it could not be typed: ", ctx.type_error))))
      } else {
        grep_emit_hits(source, hits, ctx, typed, wheres, where_rows, only, json, out)
      }
    } else {
      ()
    }
    i = i + 1
  }
  if named_unparseable != "" {
    // Throwing rather than returning: the caller turns a diagnostic into a
    // non-zero exit, and the whole point is that the exit code stops agreeing
    // with "no matches". The message names the file and says what to do.
    throw(String::concat("grep: `", String::concat(named_unparseable, "` could not be parsed, so it was not searched; run `vibe check` on it, or sweep its directory to skip unparseable files")))
  } else {
    ()
  }
  (grep_join_lines(out, json), grep_join_lines(warnings, false))
}

/// Library-compatible result-only wrapper. The public CLI uses
/// `grep_scan_fs_report` so it can route per-file skips to stderr.
export fn grep_scan_fs(root: String, pattern: String, wheres: Array[String], where_rows: Array[String], only: String, json: Bool) -> String with Env + Exception + Fs + Profiler {
  let (result, _) = grep_scan_fs_report(root, pattern, wheres, where_rows, only, json)
  result
}
