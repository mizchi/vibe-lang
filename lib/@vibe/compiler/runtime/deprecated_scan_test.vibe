//# `#deprecated` marker scan (#1262 / ADR-0101): declaration markers are
//# collected from entry + dep sources, uses in the entry warn, declaration
//# sites and unused markers stay silent.

//# Imports

import ./deprecated_scan.vibe {
  deprecated_warning_lines, deprecated_warning_lines_visible
}

//# Helpers

fn no_deps() -> Array[String] {
  Array::slice([
    ""
  ], 0, 0)
}

fn warn_count(entry: String, deps: Array[String]) -> Int with Exception {
  Array::length(deprecated_warning_lines(entry, deps))
}

fn first_warning(entry: String, deps: Array[String]) -> String with Exception {
  let lines = deprecated_warning_lines(entry, deps)
  if Array::length(lines) == 0 {
    ""
  } else {
    Array::get(lines, 0)
  }
}

fn contains(haystack: String, needle: String) -> Bool {
  let hl = String::length(haystack)
  let nl = String::length(needle)
  let mut i = 0
  let mut found = false
  while !found && i + nl <= hl {
    if String::equals(String::substring(haystack, i, i + nl), needle) {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

//# Tests

test "deprecated fn: a use warns, the declaration itself does not" {
  let src = "#deprecated\nfn old_thing(x: Int) -> Int {\n  x\n}\nfn caller() -> Int {\n  old_thing(1)\n}"
  assert_eq(warn_count(src, no_deps()), 1)
  let w = first_warning(src, no_deps())
  assert(contains(w, "'old_thing' is deprecated"))
  assert(contains(w, "line 6"))
}

test "deprecated with message: the message rides along" {
  let src = "#deprecated(\"use new_thing\")\nfn old_thing() -> Int {\n  1\n}\nfn caller() -> Int {\n  old_thing()\n}"
  let w = first_warning(src, no_deps())
  assert(contains(w, "is deprecated: use new_thing"))
}

test "no marker: no warnings" {
  let src = "fn plain() -> Int {\n  1\n}\nfn caller() -> Int {\n  plain()\n}"
  assert_eq(warn_count(src, no_deps()), 0)
}

test "marked but unused: no warnings" {
  let src = "#deprecated\nfn old_thing() -> Int {\n  1\n}\nfn caller() -> Int {\n  2\n}"
  assert_eq(warn_count(src, no_deps()), 0)
}

test "qualified fn declaration: qualified use warns" {
  let src = "#deprecated(\"use MutMap::set\")\nfn OldMap::set(x: Int) -> Int {\n  x\n}\nfn caller() -> Int {\n  OldMap::set(1)\n}"
  assert_eq(warn_count(src, no_deps()), 1)
  assert(contains(first_warning(src, no_deps()), "'OldMap::set' is deprecated: use MutMap::set"))
}

test "deprecated enum: a type-annotation use warns" {
  let src = "#deprecated\nenum OldHue {\n  Red\n}\nfn pick(h: OldHue) -> Int {\n  1\n}"
  assert_eq(warn_count(src, no_deps()), 1)
  assert(contains(first_warning(src, no_deps()), "'OldHue' is deprecated"))
}

test "deprecated let and export let are collected" {
  let src = "#deprecated\nexport let old_limit = 10\nfn caller() -> Int {\n  old_limit\n}"
  assert_eq(warn_count(src, no_deps()), 1)
}

test "marker in a dep source: entry uses warn" {
  let dep = "#deprecated(\"use fresh\")\nexport fn stale(x: Int) -> Int {\n  x\n}"
  let entry = "fn caller() -> Int {\n  stale(1) + stale(2)\n}"
  let deps = no_deps()
  Array::push(deps, dep)
  assert_eq(warn_count(entry, deps), 2)
  assert(contains(first_warning(entry, deps), "'stale' is deprecated: use fresh"))
}

test "each use warns once, in source order" {
  let src = "#deprecated\nfn old_thing() -> Int {\n  1\n}\nfn a() -> Int {\n  old_thing()\n}\nfn b() -> Int {\n  old_thing()\n}"
  assert_eq(warn_count(src, no_deps()), 2)
}

test "a different name that merely contains the deprecated one is silent" {
  let src = "#deprecated\nfn old() -> Int {\n  1\n}\nfn old_two() -> Int {\n  2\n}\nfn caller() -> Int {\n  old_two()\n}"
  assert_eq(warn_count(src, no_deps()), 0)
}

//# The real ADR-0100 (3) collection aliases
//#
//# The rename SHIPPED a promise: "旧綴りの関数は #deprecated エイリアスとして
//# 残り、`vibe check` が移行先を名指しする警告を1行出す". Every other test here
//# feeds the scanner a hand-written snippet, which proves the scanner works but
//# NOT that the shipped aliases are shaped the way it expects -- the marker
//# could be attached wrong, or sit on a form the keyword lookahead skips, and
//# the promise would be silently false. So this one feeds it the ACTUAL
//# declaration text from lib/@vibe/core/hashmap.vibe.

fn collection_alias_dep() -> Array[String] {
  [
    "#deprecated(\"use MutMap\")\nexport type HashMap[K, V] = MutMap[K, V]\n\n#deprecated(\"use MutMap::new_string\")\nexport fn HashMap::new_string[V]() -> MutMap[String, V] {\n  MutMap::new_string()\n}\n\n#deprecated(\"use MutMap::set\")\nexport fn HashMap::set[K, V](m: MutMap[K, V], k: K, v: V) -> Unit {\n  MutMap::set(m, k, v)\n}"
  ]
}

test "the shipped MutMap aliases warn and name their replacement" {
  let entry = "fn build() -> Int {\n  let m = HashMap::new_string()\n  HashMap::set(m, \"a\", 1)\n  1\n}"
  let lines = deprecated_warning_lines(entry, collection_alias_dep())
  // one per USE, not one per declaration
  assert_eq(Array::length(lines), 2)
  assert(contains(Array::get(lines, 0), "'HashMap::new_string' is deprecated: use MutMap::new_string"))
  assert(contains(Array::get(lines, 1), "'HashMap::set' is deprecated: use MutMap::set"))
  // and they are WARNINGS, not errors -- the migration must not break builds
  assert(contains(Array::get(lines, 0), "warning:"))
}

test "the new MutMap spelling is silent" {
  let entry = "fn build() -> Int {\n  let m = MutMap::new_string()\n  MutMap::set(m, \"a\", 1)\n  1\n}"
  assert_eq(warn_count(entry, collection_alias_dep()), 0)
}

test "the deprecated TYPE alias warns from an annotation" {
  // The type row lives only in index.vpkg. The scanner itself already
  // honours a `#deprecated` on `type` — the remaining hole is that the
  // contract parser used to reject the directive, so the shipped file
  // could not carry it.
  let entry = "fn take(m: HashMap[String, Int]) -> Int {\n  1\n}"
  assert(contains(first_warning(entry, collection_alias_dep()), "'HashMap' is deprecated: use MutMap"))
}

test "a vpkg-shaped type alias row warns the same way as an impl-file marker" {
  let deps = [
    "#deprecated(\"use MutMap\")\ntype HashMap[K, V] = MutMap[K, V]\nfn HashMap::new_string[V]() -> MutMap[String, V]"
  ]
  let entry = "fn take(m: HashMap[String, Int]) -> Int {\n  1\n}"
  assert(contains(first_warning(entry, deps), "'HashMap' is deprecated: use MutMap"))
}

test "legacy type alias HashMap warns from the language table" {
  let entry = "fn take(m: HashMap[String, Int]) -> Int {\n  1\n}"
  assert(contains(first_warning(entry, no_deps()), "'HashMap' is deprecated: use MutMap"))
}

test "legacy type alias HashMap is silent when the entry did not import it" {
  let entry = "fn HashMap::new_string() -> Int {\n  1\n}\nfn use_it() -> Int {\n  HashMap::new_string()\n}"
  assert_eq(Array::length(deprecated_warning_lines_visible(entry, no_deps(), visible([
    "MutMap"
  ]))), 0)
}

test "legacy type alias HashMap warns when the entry imported the type" {
  let entry = "import @vibe/core {\n  HashMap\n}\nfn take(m: HashMap[String, Int]) -> Int {\n  1\n}"
  let lines = deprecated_warning_lines_visible(entry, no_deps(), visible([
    "HashMap"
  ]))
  assert(Array::length(lines) > 0)
  assert(contains(Array::get(lines, 0), "'HashMap' is deprecated: use MutMap"))
}

//# Visibility filter (Codex review, PR #1713, P2)
//#
//# `vibe check` hands the scanner the whole compile closure, because that is
//# the only way a PACKAGE's markers are reachable at all -- the marker for
//# `HashMap::new_string` lives in a sibling file the entry never names. Wide
//# collection plus a token-level scanner is too wide the other way, so a
//# dependency's marker only counts for a name the entry actually imported.

fn visible(names: Array[String]) -> Option[Array[String]] {
  Some(names)
}

test "a dep marker for a name the entry did NOT import is ignored" {
  // The entry declares and calls its OWN HashMap::new_string. Telling it to
  // use MutMap::new_string would be prescribing a WRONG edit.
  let entry = "fn HashMap::new_string() -> Int {\n  1\n}\nfn use_it() -> Int {\n  HashMap::new_string()\n}"
  let deps = [
    "#deprecated(\"use MutMap::new_string\")\nexport fn HashMap::new_string() -> Int {\n  2\n}"
  ]
  assert_eq(Array::length(deprecated_warning_lines_visible(entry, deps, visible([
    "MutMap"
  ]))), 0)
  // ... and the unfiltered form is exactly what would have warned wrongly,
  // which is why the filter has to exist rather than be assumed unnecessary.
  assert(Array::length(deprecated_warning_lines(entry, deps)) > 0)
}

test "a dep marker for a name the entry DID import still warns" {
  let entry = "import @vibe/core {\n  HashMap::new_string\n}\nfn use_it() -> Int {\n  HashMap::new_string()\n}"
  let deps = [
    "#deprecated(\"use MutMap::new_string\")\nexport fn HashMap::new_string() -> Int {\n  2\n}"
  ]
  let lines = deprecated_warning_lines_visible(entry, deps, visible([
    "HashMap::new_string"
  ]))
  assert(Array::length(lines) > 0)
  assert(contains(Array::get(lines, 0), "use MutMap::new_string"))
}

test "a marker the ENTRY declares needs no import to count" {
  let entry = "#deprecated(\"use fresh\")\nfn stale() -> Int {\n  1\n}\nfn caller() -> Int {\n  stale()\n}"
  let lines = deprecated_warning_lines_visible(entry, no_deps(), visible(Array::slice([
    ""
  ], 0, 0)))
  assert_eq(Array::length(lines), 1)
  assert(contains(Array::get(lines, 0), "'stale' is deprecated: use fresh"))
}

//# Shipped type aliases live only in the package contract (index.vpkg).
//# Function aliases already carry `#deprecated` in the impl files. The type
//# rows cannot host the directive until a bootstrap bump, so the scanner
//# honours the same names from a visibility-gated language table.

//# Builtin old spellings (no declaration site).

test "String::char_code_at warns and names byte_at" {
  let entry = "fn n(s: String) -> Int {\n  String::char_code_at(s, 0)\n}"
  let lines = deprecated_warning_lines(entry, no_deps())
  assert_eq(Array::length(lines), 1)
  assert(contains(Array::get(lines, 0), "'String::char_code_at' is deprecated: use String::byte_at"))
}

test "String::byte_at is silent" {
  let entry = "fn n(s: String) -> Int {\n  String::byte_at(s, 0)\n}"
  assert_eq(warn_count(entry, no_deps()), 0)
}

test "StringBuilder::freeze stays silent until a bootstrap bump" {
  let entry = "fn n() -> Array[Int] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}"
  assert_eq(warn_count(entry, no_deps()), 0)
}
