//# Imports

// #1572 `vibe grep`: structural AST search plus the type-aware filters.
// Every case here drives grep_scan_source (the no-Fs seam) so the whole
// pattern language, the capture wire format and the typed filters are
// covered without touching the filesystem.

import ./grep.vibe {
  grep_compile_pattern, grep_emit_hits, grep_empty_strings, grep_file_hits, grep_join_lines, grep_scan_source, grep_typed_context_error
}

import @vibe/core {
  array_empty, inspect
}

//# Functions

fn no_strings() -> Array[String] {
  array_empty()
}

fn one_string(a: String) -> Array[String] {
  let out = no_strings()
  Array::push(out, a)
  out
}

fn scan(source: String, pattern: String) -> String with Exception {
  grep_scan_source("a.vibe", source, pattern, no_strings(), no_strings(), "", false)
}

fn scan_where(source: String, pattern: String, where_clause: String) -> String with Exception {
  grep_scan_source("a.vibe", source, pattern, one_string(where_clause), no_strings(), "", false)
}

fn scan_row(source: String, pattern: String, row_clause: String) -> String with Exception {
  grep_scan_source("a.vibe", source, pattern, no_strings(), one_string(row_clause), "", false)
}

fn scan_only(source: String, pattern: String, only: String) -> String with Exception {
  grep_scan_source("a.vibe", source, pattern, no_strings(), no_strings(), only, false)
}

/// The error message a bad pattern / bad filter produces, or "" when the scan
/// unexpectedly succeeded. The whole point of these cases is that the message
/// tells the caller what to type instead.
fn scan_filtered_err(source: String, pattern: String, wheres: Array[String], where_rows: Array[String], json: Bool) -> String {
  handle {
    let _ = grep_scan_source("a.vibe", source, pattern, wheres, where_rows, "", json)
    ""
  } with { Exception::Throw(msg) => msg }
}

fn scan_err(source: String, pattern: String, wheres: Array[String]) -> String {
  scan_filtered_err(source, pattern, wheres, no_strings(), false)
}

fn scan_row_err(source: String, pattern: String, where_rows: Array[String]) -> String {
  scan_filtered_err(source, pattern, no_strings(), where_rows, false)
}

/// The same scan the FS tier performs when the import graph fails to check:
/// matching still runs, but the typed context carries the failure.
fn grep_error_scan(source: String, pattern: String, only: String) -> String with Exception {
  grep_error_scan_where(source, pattern, no_strings(), only)
}

fn grep_error_scan_where(source: String, pattern: String, wheres: Array[String], only: String) -> String with Exception {
  let hits = grep_file_hits("a.vibe", source, grep_compile_pattern(pattern))
  let out = grep_empty_strings()
  grep_emit_hits(source, hits, grep_typed_context_error(source, "dep.vibe: line 1:1: boom"), true, wheres, no_strings(), only, false, out)
  grep_join_lines(out, false)
}

fn grep_error_scan_where_err(source: String, pattern: String, wheres: Array[String]) -> String {
  handle {
    let _ = grep_error_scan_where(source, pattern, wheres, "")
    ""
  } with { Exception::Throw(msg) => msg }
}

fn count_lines(text: String) -> Int {
  let len = String::length(text)
  let mut i = 0
  let mut n = 0
  while i < len {
    if String::char_code_at(text, i) == 10 {
      n = n + 1
    } else {
      ()
    }
    i = i + 1
  }
  n
}

//# Tests

test "grep: a literal pattern matches only the identical call" {
  let src = "let a = f(1)\nlet b = f(2)\nlet c = g(1)\n"
  inspect(scan(src, "f(1)"), "a.vibe:1:9: f(1)\n")
}

test "grep: an `exp` metavariable matches any argument and captures it" {
  let src = "let a = f(1)\nlet b = f(g(2))\n"
  inspect(scan(src, "f($(x:exp))"), "a.vibe:1:9: f(1)\t$x=1\na.vibe:2:9: f(g(2))\t$x=g(2)\n")
}

test "grep: `args` matches any arity, including zero" {
  let src = "let a = f()\nlet b = f(1)\nlet c = f(1, 2, 3)\n"
  inspect(scan(src, "f($(a:args))"), "a.vibe:1:9: f()\t$a=\na.vibe:2:9: f(1)\t$a=1\na.vibe:3:9: f(1, 2, 3)\t$a=1, 2, 3\n")
}

test "grep: `args` in the middle keeps the fixed head and tail positions" {
  let src = "let a = f(1, 9)\nlet b = f(1, 5, 6, 9)\nlet c = f(2, 9)\n"
  inspect(scan(src, "f(1, $(mid:args), 9)"), "a.vibe:1:9: f(1, 9)\t$mid=\na.vibe:2:9: f(1, 5, 6, 9)\t$mid=5, 6\n")
}

test "grep: `id` only takes identifiers, `const` only literals" {
  let src = "let a = f(1)\nlet b = f(x)\n"
  inspect(scan(src, "f($(n:id))"), "a.vibe:2:9: f(x)\t$n=x\n")
  inspect(scan(src, "f($(k:const))"), "a.vibe:1:9: f(1)\t$k=1\n")
}

test "grep: `id` captures a compound-assignment target, not its operator" {
  let src = "let mut counter = 0\ncounter += 2\n"
  inspect(scan(src, "$(target:id) += 2"), "a.vibe:<synthetic>: { counter += 2; () }\t$target=counter\n")
}

test "grep: a repeated metavariable must agree, `_` never has to" {
  let src = "let a = f(x, x)\nlet b = f(x, y)\n"
  inspect(scan(src, "f($(v:exp), $(v:exp))"), "a.vibe:1:9: f(x, x)\t$v=x\n")
  inspect(count_lines(scan(src, "f($(_:exp), $(_:exp))")), "2")
}

test "grep: matching is formatting-insensitive (AST, not text)" {
  let spread = "let a = f(\n  1,\n  2\n)\n"
  inspect(scan(spread, "f(1, 2)"), "a.vibe:1:9: f(1, 2)\n")
}

test "grep: match arms with a `pat` metavariable" {
  let src = "let a = match v { Some(k) => k, None => 0 }\n"
  inspect(scan(src, "match $(s:exp) { Some($(p:pat)) => $(b:exp), None => 0 }"), "a.vibe:1:15: match v { Some(k) => k, None => 0 }\t$s=v\t$p=k\t$b=k\n")
}

test "grep: a `type` metavariable matches a lambda's annotation" {
  let src = "let a = (x: Int) -> Int { x }\n"
  inspect(scan(src, "(x: $(t:type)) -> Int { x }"), "a.vibe:1:27: (x: Int) -> Int { x }\t$t=Int\n")
}

test "grep: a method call keeps its shape; the pipe form parses to a plain call" {
  let src = "let a = xs.transform(f)\nlet b = xs |> transform(f)\nlet c = transform(xs, f)\n"
  inspect(scan(src, "$(r:exp).transform($(f:exp))"), "a.vibe:1:9: xs.transform(f)\t$r=xs\t$f=f\n")
  inspect(scan(src, "transform($(a:args))"), "a.vibe:2:9: transform(xs, f)\t$a=xs, f\na.vibe:3:9: transform(xs, f)\t$a=xs, f\n")
}

test "grep: nested matches are reported as the separate sites they are" {
  let src = "let a = f(f(1))\n"
  inspect(scan(src, "f($(x:exp))"), "a.vibe:1:9: f(f(1))\t$x=f(1)\na.vibe:1:11: f(1)\t$x=1\n")
}

test "grep: JSON output carries offsets and per-capture spans" {
  let src = "let a = f(1)\n"
  inspect(grep_scan_source("a.vibe", src, "f($(x:const))", no_strings(), no_strings(), "", true), "[\n  {\"path\":\"a.vibe\",\"line\":1,\"col\":9,\"start\":8,\"end\":9,\"synthetic\":false,\"text\":\"f(1)\",\"captures\":{\"x\":{\"text\":\"1\",\"start\":null}}}\n]\n")
}

test "grep: an unlocated match is null + synthetic, and the two modes agree" {
  // #1943: the text lane has always rendered such a match as `<synthetic>`;
  // JSON rendered `-1` in all four position fields. `-1` is a NUMBER, so a
  // consumer slicing `src[start:end]` reads from the end of the file instead
  // of failing. A match is unlocated when its operands are literals, which
  // carry no offset slot.
  let src = "let a = 3 + 4\n"
  let out = grep_scan_source("a.vibe", src, "$(x:exp) + $(y:exp)", no_strings(), no_strings(), "", true)
  assert(String::contains(out, "\"line\":null,\"col\":null,\"start\":null,\"end\":null,\"synthetic\":true"))
  assert(!String::contains(out, "-1"))
  // The text lane's spelling of the same fact.
  assert(String::contains(scan(src, "$(x:exp) + $(y:exp)"), "<synthetic>"))
}

test "grep: no match is empty output, in both text and JSON form" {
  let src = "let a = f(1)\n"
  inspect(scan(src, "zzz(1)"), "")
  inspect(grep_scan_source("a.vibe", src, "zzz(1)", no_strings(), no_strings(), "", true), "[]\n")
}

test "grep --where: filter a capture by its inferred type" {
  let src = "let f = (v: Int) -> Int { v }\nlet g = (v: String) -> String { v }\nlet n = 1\nlet s = \"x\"\nlet a = f(n)\nlet b = g(s)\n"
  inspect(scan_where(src, "$(c:id)($(x:exp))", "$x : Int"), "a.vibe:5:9: f(n)\t$c=f\t$x=n\n")
  inspect(scan_where(src, "$(c:id)($(x:exp))", "$x : String"), "a.vibe:6:9: g(s)\t$c=g\t$x=s\n")
}

test "grep --where: `_` is a wildcard inside the requested type" {
  let src = "let f = (v: Array[Int]) -> Int { 0 }\nlet xs = [\n  1\n]\nlet a = f(xs)\n"
  inspect(scan_where(src, "f($(x:exp))", "$x : Array[_]"), "a.vibe:5:9: f(xs)\t$x=xs\n")
  inspect(scan_where(src, "f($(x:exp))", "$x : Array[String]"), "")
}

test "grep --where: `=` compares the RESOLVED name, seeing through an alias" {
  let src = "import ./dep.vibe {\n  helper as h\n}\nlet other = (v: Int) -> Int { v }\nlet a = h(1)\nlet b = other(1)\n"
  inspect(scan_where(src, "$(f:id)($(_:exp))", "$f = helper"), "a.vibe:5:9: h(1)\t$f=h\n")
  inspect(scan_where(src, "$(f:id)($(_:exp))", "$f = h"), "")
}

test "grep: `exp` declines a labeled argument, `arg` takes one" {
  let src = "let f = (a: Int, b: Int) -> Int { a + b }\nlet x = f(1, b=2)\n"
  inspect(scan(src, "f(1, $(v:exp))"), "")
  inspect(scan(src, "f(1, $(v:arg))"), "a.vibe:2:9: f(1, b=2)\t$v=b=2\n")
}

test "grep --where-row: keep or drop by what a callee's effect row carries" {
  let src = "let readit = (p: String) -> String with Fs {\n  Fs::read_file(p)\n}\nlet plain = (p: String) -> String {\n  p\n}\nlet run = (q: String) -> String with Fs {\n  let a = readit(q)\n  plain(a)\n}\n"
  // A capability builtin carries the row too, so it is a genuine hit here.
  inspect(scan_row(src, "$(f:id)($(x:id))", "$f with Fs"), "a.vibe:2:3: Fs::read_file(p)\t$f=Fs::read_file\t$x=p\na.vibe:8:11: readit(q)\t$f=readit\t$x=q\n")
  inspect(scan_row(src, "$(f:id)($(x:id))", "$f without Fs"), "a.vibe:9:3: plain(a)\t$f=plain\t$x=a\n")
}

test "grep --only-well-typed / --only-ill-typed split a file by its type error" {
  let good = "let f = (x: Int) -> Int { x }\nlet a = f(1)\n"
  inspect(scan_only(good, "f($(x:exp))", "well"), "a.vibe:2:9: f(1)\t$x=1\n")
  inspect(scan_only(good, "f($(x:exp))", "ill"), "")
  let bad = "let f = (x: Int) -> Int { x }\nlet a = f(\"s\")\n"
  inspect(scan_only(bad, "f($(x:exp))", "ill"), "a.vibe:2:9: f(\"s\")\t$x=\"s\"\n")
  inspect(scan_only(bad, "f($(x:exp))", "well"), "")
}

test "grep: a file whose typing failed outright is never reported well-typed" {
  // The FS tier lands here whenever the import graph itself fails to check
  // (grep_fs.vibe). An empty context would call the file clean; this one must
  // not. Typed filters fail closed rather than dropping matches silently.
  let src = "let f = (x: Int) -> Int { x }\nlet a = f(1)\n"
  inspect(grep_scan_source("a.vibe", src, "f($(x:exp))", no_strings(), no_strings(), "well", false), "a.vibe:2:9: f(1)\t$x=1\n")
  inspect(grep_error_scan(src, "f($(x:exp))", "well"), "")
  inspect(grep_error_scan(src, "f($(x:exp))", "ill"), "a.vibe:2:9: f(1)\t$x=1\n")
  // A capture with no identifier-shaped token (a bare literal) carries no
  // source offset, so there is nothing to look the type up BY -- the filter
  // drops it instead of guessing. Same boundary the docs state.
  inspect(scan_where(src, "f($(x:const))", "$x : Int"), "")
}

test "grep --where `=`: a failed typing refuses to answer from the alias table" {
  // The alias table is SYNTACTIC and survives a failed typing, so `$f = helper`
  // could otherwise report a name as RESOLVED that the checker never validated
  // -- a missing module, or a name the dependency does not export (#1533).
  let src = "import ./dep.vibe {\n  helper as h\n}\nlet a = h(1)\n"
  inspect(scan_where(src, "$(f:id)($(_:exp))", "$f = helper"), "a.vibe:4:9: h(1)\t$f=h\n")
  let message = grep_error_scan_where_err(src, "$(f:id)($(_:exp))", one_string("$f = helper"))
  inspect(String::starts_with(message, "grep: cannot apply --where/--where-row to `a.vibe` because it could not be typed"), "1")
  inspect(String::contains(message, "dep.vibe: line 1:1: boom"), "1")
}

test "grep: a filter with nothing after its operator is an error" {
  // Otherwise `--where '$x :'` only misbehaves on a file that happens to match,
  // so a sweep with no hits returns the empty output that means "no match".
  inspect(scan_err("let a = f(1)\n", "f($(x:exp))", one_string("$x :")), "--where: nothing after `:` in `$x`")
  inspect(scan_err("let a = f(1)\n", "f($(x:exp))", one_string("$x =")), "--where: nothing after `=` in `$x`")
  inspect(scan_err("let a = f(1)\n", "f($(x:exp))", one_string("$x with ")), "--where: nothing after `with` in `$x`")
}

test "grep: a malformed pattern says what to write instead of matching nothing" {
  inspect(scan_err("let a = 1\n", "f($x)", no_strings()), "grep pattern: `$` must start a metavariable `$(name:kind)`")
  inspect(scan_err("let a = 1\n", "f($(x))", no_strings()), "grep pattern: expected `$(name:kind)`, e.g. `$(x:exp)`")
}

test "grep: a declaration pattern is rejected by what the user wrote, not by an internal name" {
  // #2122: this used to fail with `fn parameter '__vgm_args__p' requires a
  // type annotation` -- the metavariable's internal encoding, in a checker
  // message, for a pattern the user DID annotate. The good message existed
  // already but the parser rejected the declaration before it could run.
  assert(String::contains(scan_err("fn f() -> Int { 1 }\n", "fn $(n:id)($(p:args)) -> $(r:type) { $(b:exp) }", no_strings()), "starts a DECLARATION"))
  assert(String::contains(scan_err("fn f() -> Int { 1 }\n", "fn $(n:id)($(p:args)) -> $(r:type) { $(b:exp) }", no_strings()), "vibe symbols"))
  assert(!String::contains(scan_err("fn f() -> Int { 1 }\n", "fn $(n:id)($(p:args)) -> $(r:type) { $(b:exp) }", no_strings()), "__vgm"))
  // The partial form is a declaration too, and gets the same answer.
  assert(String::contains(scan_err("fn f() -> Int { 1 }\n", "fn $(n:id)", no_strings()), "starts a DECLARATION"))
  // Other declaration keywords, so the check is about the class not one word.
  assert(String::contains(scan_err("fn f() -> Int { 1 }\n", "enum $(n:id)", no_strings()), "starts a DECLARATION"))
  assert(String::contains(scan_err("fn f() -> Int { 1 }\n", "struct $(n:id)", no_strings()), "starts a DECLARATION"))
}

/// A `handle` whose arms this pattern is not supposed to know about. Two
/// different effects, two different arm shapes, two different binders.
fn handle_src() -> String {
  "effect Ask {\n  Get(Int) -> Int\n}\n\nfn u() -> Int with Ask {\n  perform Ask::Get(1)\n}\n\nfn r() -> Int {\n  handle {\n    u()\n  } with {\n    Ask::Get(n) => resume(n + 1)\n  }\n}\n"
}

test "grep: `$(a:arms)` matches a handler whose arms are not known in advance (#2122)" {
  // The point of the hole. Before it, a `handle` sweep had to spell every arm
  // -- INCLUDING each arm's own binders, so `Get => ..` silently failed to
  // find `Get(n) => ..` and the search came back empty, which is also how the
  // CLI spells "nothing here".
  let hits = scan(handle_src(), "handle { $(b:exp) } with $(e:id) { $(a:arms) }")
  assert(String::contains(hits, "handle {"))
  // The capture reads back as arms you could paste.
  assert(String::contains(hits, "$a=Ask::Get(n) => resume((n + 1))"))
}

/// The same handler shape but a DIFFERENT effect and operation, so a pattern
/// naming one operation must not find the other.
fn handle_other_src() -> String {
  "effect Log {\n  Emit(String) -> Unit\n}\n\nfn r2() -> Int {\n  handle {\n    perform Log::Emit(\"x\")\n    7\n  } with {\n    Log::Emit(m) => resume(())\n  }\n}\n"
}

test "grep: a literal operation in an arm is compared, not swallowed (#2132)" {
  // `with $(e:id) { Get(..) => .. }` reaches the matcher as
  // `__vgm_id__e::Get`, because the parser resolves an arm's operation against
  // the handled effect. `grep_meta_of` decodes the variable as `e::Get`, so
  // `Get` used to become part of the variable NAME and was never compared: the
  // pattern matched `Log::Emit` too, and reported it under the nonsense key
  // `$e::Get`. A search that returns hits you did not ask for is worse than
  // one that errors -- the extra hit looks like an answer.
  let getp = "handle { $(b:exp) } with $(e:id) { Get($(p:pat)) => resume($(v:exp)) }"
  assert(String::contains(scan(handle_src(), getp), "handle {"))
  assert(!String::contains(scan(handle_other_src(), getp), "a.vibe"))
  // ...and the mirror, so this is about comparing the name and not about
  // rejecting the second file for some other reason.
  let emitp = "handle { $(b:exp) } with $(e:id) { Emit($(p:pat)) => resume($(v:exp)) }"
  assert(String::contains(scan(handle_other_src(), emitp), "handle {"))
  assert(!String::contains(scan(handle_src(), emitp), "a.vibe"))
}

test "grep: the qualifier metavariable captures the EFFECT, under its own name" {
  // `$(e:id)` stands for the effect, so it binds `Ask` -- not the whole
  // qualified `Ask::Get`, and not under the key `$e::Get`, which is not a
  // variable anyone wrote.
  let hits = scan(handle_src(), "handle { $(b:exp) } with $(e:id) { Get($(p:pat)) => resume($(v:exp)) }")
  assert(String::contains(hits, "$e=Ask"))
  assert(!String::contains(hits, "$e::Get"))
}

test "grep: `$(a:arms)` needs at least one arm to stand for" {
  // A handler with no arms is not a thing the parser produces, but the hole
  // must not quietly match an empty list either -- that would make the
  // pattern true of expressions that are not handlers.
  assert(!String::contains(scan("let a = f(1)\n", "handle { $(b:exp) } with $(e:id) { $(a:arms) }"), "a.vibe"))
}

test "grep: `arms` is listed as a kind, and only parses where arms go" {
  // The kind is real...
  assert(!String::contains(scan_err(handle_src(), "handle { $(b:exp) } with $(e:id) { $(a:arms) }", no_strings()), "unknown metavariable kind"))
  // ...and the unknown-kind message lists it, so the set is discoverable.
  assert(String::contains(scan_err("let a = 1\n", "f($(x:nope))", no_strings()), "arms"))
  // An arms hole outside arm position is a parse error, not a silent match:
  // `grep_mangle` spells it `_ => __vgm_arms__a`, which only parses in an arm
  // list. The message names the parser's state, which is honest here -- there
  // is no other spelling to point at.
  assert(String::length(scan_err("let a = 1\n", "f($(a:arms))", no_strings())) > 0)
}

test "grep: a handle pattern that will not parse is pointed at the shape that works" {
  // `expected with but got eof` describes the parser's state, not the
  // spelling that succeeds. The message now names BOTH: the arms hole for any
  // handler, and the written-out form for a specific one.
  let msg = scan_err("fn f() -> Int { 1 }\n", "handle { $(b:exp) }", no_strings())
  assert(String::contains(msg, "$(a:arms)"))
  assert(String::contains(msg, "resume($(v:exp))"))
  inspect(scan_err("let a = 1\n", "f($(x:exp", no_strings()), "grep pattern: unterminated metavariable — expected `)` after `$(name:kind)`")
  inspect(scan_err("let a = 1\n", "f($(x:exp)", no_strings()), "grep pattern: expected ) but got eof at #3")
  inspect(scan_err("let a = 1\n", "f($(x:expr))", no_strings()), "grep pattern: unknown metavariable kind `expr` — use one of exp, id, const, arg, args, pat, type, arms")
  inspect(scan_err("let a = 1\n", "f($(a:args), $(b:args))", no_strings()), "grep pattern: at most one `args` metavariable per argument list")
  inspect(scan_err("let a = 1\n", "let x = 1", no_strings()), "grep pattern: must be a single EXPRESSION — declaration patterns (`fn`, top-level `let`, `enum`, ...) are not supported yet; use `vibe symbols` for declarations")
}

test "grep --where: a clause naming an uncaptured metavariable is an error" {
  inspect(scan_err("let a = f(1)\n", "f($(x:exp))", one_string("$y : Int")), "--where: the pattern never captures `$y`")
  // ...even when nothing in the searched source matches the pattern at all.
  // Reporting this only on a matching file would let a typo'd clause come back
  // as the empty output that means "clean".
  inspect(scan_err("let a = 1\n", "f($(x:exp))", one_string("$y : Int")), "--where: the pattern never captures `$y`")
}

test "grep typed filters fail closed when a structurally matching file is ill-typed (#1715)" {
  // A type error ANYWHERE in the file leaves no trustworthy typed table. The
  // parse tier still finds the call, but `--where` and `--where-row` now refuse
  // the file instead of returning the plausible-but-wrong empty result.
  let src = "let bad: String = 42\nlet arr = [\n  1\n]\nlet n = Array::length(arr)\n"
  inspect(scan(src, "Array::length($(x:exp))"), "a.vibe:5:9: Array::length(arr)\t$x=arr\n")
  let exact = scan_err(src, "Array::length($(x:exp))", one_string("$x : Array[Int]"))
  let wildcard = scan_err(src, "Array::length($(x:exp))", one_string("$x : Array[_]"))
  let row = scan_row_err(src, "Array::length($(x:exp))", one_string("$x without Fs"))
  inspect(String::starts_with(exact, "grep: cannot apply --where/--where-row to `a.vibe` because it could not be typed"), "1")
  inspect(String::contains(exact, "expected String, got Int"), "1")
  inspect(String::starts_with(wildcard, "grep: cannot apply --where/--where-row to `a.vibe` because it could not be typed"), "1")
  inspect(String::starts_with(row, "grep: cannot apply --where/--where-row to `a.vibe` because it could not be typed"), "1")
  // JSON mode also throws before any result array can be rendered.
  let json_error = scan_filtered_err(src, "Array::length($(x:exp))", one_string("$x : Array[Int]"), no_strings(), true)
  inspect(String::starts_with(json_error, "grep: cannot apply --where/--where-row to `a.vibe` because it could not be typed"), "1")
  // A structurally hit-free file is not rejected merely because it is broken.
  inspect(scan_err(src, "String::length($(x:exp))", one_string("$x : String")), "")
  // `--only` without typed filters keeps its existing ill/well classification.
  inspect(scan_only(src, "Array::length($(x:exp))", "ill"), "a.vibe:5:9: Array::length(arr)\t$x=arr\n")
  // Remove the unrelated type error and the same typed clause still matches.
  let ok = "let good: Int = 42\nlet arr = [\n  1\n]\nlet n = Array::length(arr)\n"
  inspect(scan_where(ok, "Array::length($(x:exp))", "$x : Array[Int]"), "a.vibe:5:9: Array::length(arr)\t$x=arr\n")
}

// #1943: `throw(x)` parses to the same AST as `perform Exception::Throw(x)`,
// and the printer re-sugars both (plus `Error::Throw`) back to `throw(x)`.
// A pattern that names one keyword must keep only sites that spell that
// keyword; a pattern that names neither still matches both.
fn throw_perform_src() -> String {
  "fn f() -> Int {\n  throw(\"e\")\n}\nfn g() -> Int {\n  perform Exception::Throw(\"e\")\n}\nfn h() -> Int {\n  perform Error::Throw(\"e\")\n}\n"
}

test "grep: `throw` matches only the source `throw` site" {
  inspect(scan(throw_perform_src(), "throw($(x:exp))"), "a.vibe:2:3: throw(\"e\")\t$x=\"e\"\n")
}

test "grep: `perform Exception::Throw` matches only the `perform` site" {
  inspect(scan(throw_perform_src(), "perform Exception::Throw($(x:exp))"), "a.vibe:5:3: throw(\"e\")\t$x=\"e\"\n")
}

test "grep: `perform $(op:exp)` matches `perform`, not `throw`" {
  inspect(scan(throw_perform_src(), "perform $(op:exp)"), "a.vibe:5:3: throw(\"e\")\t$op=Exception::Throw(\"e\")\na.vibe:8:3: throw(\"e\")\t$op=Error::Throw(\"e\")\n")
}

test "grep: `$(x:exp)` still matches both `throw` and `perform`" {
  let out = scan(throw_perform_src(), "$(x:exp)")
  inspect(String::contains(out, "a.vibe:2:3:"), "1")
  inspect(String::contains(out, "a.vibe:5:3:"), "1")
  inspect(String::contains(out, "a.vibe:8:3:"), "1")
}

test "grep: `perform Error::Throw` matches only that perform spelling" {
  inspect(scan(throw_perform_src(), "perform Error::Throw($(x:exp))"), "a.vibe:8:3: throw(\"e\")\t$x=\"e\"\n")
}

fn let_star_src() -> String {
  "fn f(o: Option[Int]) -> Option[Int] {\n  let* x = o\n  Some(x + 1)\n}\n"
}

test "grep: `let*` matches the written railway bind" {
  let out = scan(let_star_src(), "let* $(x:id) = $(e:exp)")
  assert(String::contains(out, "let*"))
  assert(String::contains(out, "$x=x"))
  assert(String::contains(out, "$e=o"))
}

test "grep: `let*` does not match a plain `let`" {
  let src = "fn f(o: Option[Int]) -> Option[Int] {\n  let x = o\n  Some(1)\n}\n"
  inspect(scan(src, "let* $(x:id) = $(e:exp)"), "")
}

test "grep: `let*` matches each written binder in a nested railway" {
  let src = "fn f(o: Option[Option[Int]]) -> Option[Int] {\n  let* outer = o\n  let* inner = outer\n  Some(inner)\n}\n"
  let out = scan(src, "let* $(x:id) = $(e:exp)")
  assert(String::contains(out, "$x=outer"))
  assert(String::contains(out, "$x=inner"))
}

//# Range honesty (#1941 / #1943)

/// Two calls to the same function: one with identifier operands, one with
/// literal operands. The pair is what separates "the span is short" from "the
/// span is the head", and both are the SAME reporting rule.
fn span_src() -> String {
  "fn add(a: Int, b: Int) -> Int {\n  a + b\n}\n\nfn f() -> Int {\n  let one = 1\n  let two = 2\n  add(one, two) + add(1, 2)\n}\n"
}

fn scan_json(source: String, pattern: String) -> String with Exception {
  grep_scan_source("a.vibe", source, pattern, no_strings(), no_strings(), "", true)
}

test "grep: a reported range is a LOWER BOUND, not the match's extent" {
  // `grep_expr_span` takes the min/max over the offsets it can find in the
  // matched subtree, and only identifier-shaped AST nodes carry one -- `EInt`,
  // `EString`, `EBool`, `EUnit` and friends carry none. So the span stops at
  // the last identifier and never reaches the closing `)`.
  //
  // Slicing by it truncates, which is why docs/source-range-contract.md tells
  // a reader to trust `start`, treat `end` as a floor, and read `text` for the
  // description. The exact numbers are pinned so the claim in that document
  // cannot quietly stop being true.
  let src = span_src()
  let out = scan_json(src, "add($(a:args))")
  // `add(one, two)` starts at 89; `two` ends at 101; the `)` is at 101.
  assert(String::contains(out, "\"start\":89,\"end\":101,\"synthetic\":false,\"text\":\"add(one, two)\""))
  assert_eq(String::substring(src, 89, 101), "add(one, two")
  assert_eq(String::substring(src, 89, 102), "add(one, two)")
}

test "grep: a match whose operands are all literals collapses to the head" {
  // The same rule at its most visible: neither `1` nor `2` is in the AST with
  // an offset, so the span has nothing to widen past `add`.
  let src = span_src()
  let out = scan_json(src, "add($(a:args))")
  assert(String::contains(out, "\"start\":105,\"end\":108,\"synthetic\":false,\"text\":\"add(1, 2)\""))
  assert_eq(String::substring(src, 105, 108), "add")
}

test "grep: a capture carries a start and no end, and null when it has neither" {
  // #1943's "captures also lack complete source ranges". `one, two` reports
  // where it begins and nothing about where it stops; `1, 2` cannot even
  // report that.
  //
  // The unlocated case used to render `-1`, chosen over `0` so the output did
  // not invent a plausible offset. Right intent, wrong type: `-1` is still a
  // NUMBER, and a consumer that slices `src[start:]` on it reads from the end
  // of the file instead of failing. `null` carries the same "no offset" and
  // breaks arithmetic loudly.
  let out = scan_json(span_src(), "add($(a:args))")
  assert(String::contains(out, "\"a\":{\"text\":\"one, two\",\"start\":93}"))
  assert(String::contains(out, "\"a\":{\"text\":\"1, 2\",\"start\":null}"))
  assert(!String::contains(out, "\"start\":-1"))
}

test "grep: a capture's text is a PRINTED form, not a source slice" {
  // Measured 2026-08-19 and previously undocumented. `f( a  +  b )` captures
  // as `(a + b)`: parens added, runs of whitespace collapsed. So
  // `src[start : start + length(text)]` is NOT the captured source, and an
  // `end` cannot be derived from the text either -- which is why this reports
  // no end rather than a computed one.
  let src = "fn f(x: Int) -> Int { x }\nfn g(a: Int, b: Int) -> Int { f( a  +  b ) }\n"
  let out = scan_json(src, "f($(x:exp))")
  assert(String::contains(out, "\"text\":\"(a + b)\""))
  assert(!String::contains(out, "\"text\":\"a  +  b\""))
}
