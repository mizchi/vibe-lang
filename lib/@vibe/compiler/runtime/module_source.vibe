//# Imports

import @vibe/compiler/core {
  Expr, Stmt, dce_keep_flags_via
}

import @vibe/compiler/syntax {
  lex_with_offsets, offset_to_line_col, parse_program, parse_program_spans, set_compiler_spelled_type_params
}

//# Module source emission (port of host `emit-module-source`)

/// Reconstruct a flat module source containing only the top-level statements
/// reachable from `entry_name` (via DCE), emitted as their original source text.
///
/// Mirrors the MoonBit host `emit-module-source`
/// (`src/cmd/vibe/cli_module_source.mbt`) but recovers statement source spans
/// from the lexer (`lex_with_offsets`) + parser (`parse_program_spans`)
/// instead of AST node spans, since the AST does not carry offsets.
/// Pure: no filesystem or host calls.
export let build_module_source_from_source: (String, String) -> String with Exception = (source, entry_name) -> {
  let lexed = lex_with_offsets(source)
  let tokens = lexed.0
  let starts = lexed.1
  let ends = lexed.2
  // The input is the merged program the compiler printed itself
  // (scripts/generate_bundle.sh pass 1, `merged_program_source_fs`), so a
  // synthesized `__arr_equals__` helper arrives with the desugar's `__Vfp_`
  // spelling on its formal -- the one binder parse_type_param_kind refuses in
  // authored source (#2141 / #2474). Read it as the compiler's own for these
  // two parses only; a parse that throws switches the refusal back on the
  // way out (#2654).
  set_compiler_spelled_type_params(true)
  let (stmts, span_start, span_end, full_stmts) = handle {
    let parsed = parse_program_spans(tokens, starts, ends)
    // Reachability over the full parse: `stmts` carries one bodyless `SImpl`
    // per impl (so the impl text is emitted once), which hides every call an
    // impl method makes. A helper only a method calls would otherwise be
    // dropped and the flat source would not compile (#2516).
    let full = parse_program(tokens)
    set_compiler_spelled_type_params(false)
    (parsed.0, parsed.1, parsed.2, full)
  } with { Exception::Throw(msg) => {
    set_compiler_spelled_type_params(false)
    throw(msg)
  } }
  let keep = dce_keep_flags_via(stmts, full_stmts, [entry_name])
  let buf = StringBuilder::new()
  let mut i = 0
  while i < Array::length(stmts) {
    if Array::get(keep, i) {
      let s = Array::get(span_start, i)
      let e = Array::get(span_end, i)
      if e > s {
        let snippet = String::substring(source, s, e)
        // The flat source this joins is compiled as authored text, whose
        // parser refuses the compiler's spelling with a "rename it" no author
        // can act on. A helper that kept it and is still reachable is refused
        // here instead, by name (#2654): the four the merged compiler carries
        // today are dead and dropped by the DCE above. The test is on the
        // binder list of the parsed statement, never on its text: this very
        // function's source spells the prefix inside a string literal and is
        // itself a kept statement of the merged compiler.
        if binds_compiler_spelled_type_param(Array::get(stmts, i)) {
          throw(String::concat("module source for `", String::concat(entry_name, String::concat("`: a synthesized comparator whose type parameter keeps the compiler's `__Vfp_` spelling is reachable from the entry, and the flat source cannot carry it (its parser reads authored text): ", snippet_head(snippet)))))
        } else {
          ()
        }
        StringBuilder::push(buf, snippet)
        let n = String::length(snippet)
        if n == 0 || String::char_code_at(snippet, n - 1) != '\n' {
          StringBuilder::push(buf, "\n")
        }
      }
    }
    i = i + 1
  }
  StringBuilder::freeze(buf)
}

/// Does a top-level binding's function carry a type parameter in the
/// desugar's `__Vfp_` spelling? The synthesized comparators are top-level
/// `let` / `fn` bindings of a lambda, so those two shapes are the whole
/// question; a nested lambda cannot carry the spelling (the parser refuses
/// it in authored source, and the desugar synthesizes at the top level).
fn binds_compiler_spelled_type_param(stmt: Stmt) -> Bool {
  match stmt {
    SLet(_, _, _, _, expr) => fn_has_compiler_spelled_type_param(expr),
    SFnDecl(_, _, expr, _, _) => fn_has_compiler_spelled_type_param(expr),
    _ => false
  }
}

fn fn_has_compiler_spelled_type_param(expr: Expr) -> Bool {
  match expr {
    EFn(tps, _, _, _, _, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(tps) {
        if String::starts_with(Array::get(tps, i), "__Vfp_") {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

/// The first 96 bytes of a kept statement, for a message that names it.
fn snippet_head(snippet: String) -> String {
  let n = String::length(snippet)
  let cut = if n > 96 {
    96
  } else {
    n
  }
  String::substring(snippet, 0, cut)
}

/// debugger テーマ3 / M2: build a `.funcmap` sidecar text mapping each ENTRY-file
/// top-level function definition to its 1-based source line, one `name<TAB>line\n`
/// per function. The launcher (`runtime/vibe`) reads this to annotate runtime trap
/// backtrace frames (which name user functions via the wasm "name" section) with
/// `(file:line)`.
///
/// MVP scope: ENTRY-file top-level functions only. Imported-module functions are
/// not yet covered (future work) — they are flattened into the program at compile
/// time but their original source lines are not recovered here.
///
/// Reuses the lexer offsets + parse_program_spans span table (same as
/// build_module_source_from_source) so it needs no checker. A top-level `SLet`
/// whose bound expr is a function (`EFn`) maps `name` -> line of the statement's
/// start offset. All strings via String::concat + __to_string only (never `+`,
/// never "\{}" interpolation): both mis-codegen to NUL here.
export let build_funcmap_from_source: (String) -> String with Exception = (source) -> {
  let lexed = lex_with_offsets(source)
  let tokens = lexed.0
  let starts = lexed.1
  let ends = lexed.2
  let parsed = parse_program_spans(tokens, starts, ends)
  let stmts = parsed.0
  let span_start = parsed.1
  let buf = StringBuilder::new()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    let entry = match stmt {
      SLet(_, _, name, _, expr) => match expr {
        EFn(_, _, _, _, _, _) => {
          let off = Array::get(span_start, i)
          let lc = offset_to_line_col(source, off)
          let line = lc.0
          String::concat(name, String::concat("\t", String::concat(__to_string(line), "\n")))
        },
        _ => ""
      },
      _ => ""
    }
    StringBuilder::push(buf, entry)
    i = i + 1
  }
  StringBuilder::freeze(buf)
}
