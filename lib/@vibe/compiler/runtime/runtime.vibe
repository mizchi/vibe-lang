// Note: `eval_loader/` has its own `index.vibe` and is already its own
// boundary (ADR-0063 applies recursively) — its two external callers
// (`loader/index.vibe`, `loader/header_cache.vibe`) already import it via
// that index, not an internal file, so it needs no re-export here. Routing
// it through this facade instead would also create an import cycle: this
// file already imports `../loader { load_or_parse_module_header_fs }`, so
// `loader/index.vibe` importing back through `runtime/index.vibe` would be
// `loader -> runtime/index.vibe -> loader`.

//# Types

enum StringTriple {
  StringTriple(String, String, String)
}

struct DependencySources {
  entries: Array[(String, String)];
  source_revision: Int
}

enum TypeDbState {
  TypeDbState(RippleDb, Array[(String, TypeEnv)], DependencySources, Array[StringTriple], Array[StringTriple], Array[StringTriple], Int, Int, Int, Int, String)
}

export enum TypeDb {
  TypeDb(TypeDbState)
}

//# Functions

fn unwrap_db(_ db: TypeDb) -> TypeDbState {
  match db {
    TypeDb(state) => state
  }
}

fn wrap_db(_ state: TypeDbState) -> TypeDb {
  TypeDb(state)
}

fn empty_strings() -> Array[String] {
  array_empty()
}

fn empty_env_cache() -> Array[(String, TypeEnv)] {
  array_empty()
}

fn empty_string_pairs() -> Array[(String, String)] {
  array_empty()
}

fn empty_string_triples() -> Array[StringTriple] {
  array_empty()
}

fn empty_stmt_array() -> Array[Stmt] {
  array_empty()
}

export fn db_new() -> TypeDb {
  let deps = DependencySources::{
    entries: empty_string_pairs(),
    source_revision: 0
  }
  wrap_db(TypeDbState(ripple_new(), empty_env_cache(), deps, empty_string_triples(), empty_string_triples(), empty_string_triples(), 0, 0, 0, 0, ""))
}

fn lookup_source_cache(cache: Array[StringTriple], path: String, fingerprint: String) -> Option[String] {
  let len = Array::length(cache)
  let rec go: (Int) -> Option[String] = (i) -> {
    if i >= len {
      None
    } else {
      match Array::get(cache, at = i) {
        StringTriple(p, fp, source) =>
        if p == path && fp == fingerprint {
          Some(source)
        } else {
          go(i + 1)
        }
      }
    }
  }
  go(0)
}

fn upsert_source_cache(cache: Array[StringTriple], path: String, fingerprint: String, source: String) -> Array[StringTriple] {
  // O(N) in-place rebuild: previously each `Array::concat(acc, [x])`
  // copied the entire prefix per iteration → O(N^2) for large source
  // caches.
  let out = empty_string_triples()
  let mut i = 0
  let len = Array::length(cache)
  while i < len {
    match Array::get(cache, at = i) {
      StringTriple(p, fp, existing) =>
      if p == path && fp == fingerprint {
        ()
      } else {
        Array::push(out, value = StringTriple(p, fp, existing))
      }
    }
    i = i + 1
  }
  Array::push(out, value = StringTriple(path, fingerprint, source))
  out
}

fn append_source_cache_entries(cache: Array[StringTriple], entries: Array[StringTriple]) -> Array[StringTriple] {
  if Array::length(entries) == 0 {
    cache
  } else {
    let out = empty_string_triples()
    let mut i = 0
    while i < Array::length(cache) {
      Array::push(out, value = Array::get(cache, at = i))
      i = i + 1
    }
    let mut j = 0
    while j < Array::length(entries) {
      Array::push(out, value = Array::get(entries, at = j))
      j = j + 1
    }
    out
  }
}

export fn db_set_source(db: TypeDb, path: String, source: String) -> TypeDb {
  match unwrap_db(db) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count, cfg_identity) =>
    wrap_db(TypeDbState(ripple_set_source(db = rdb, path = path, source = source), env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count, cfg_identity))
  }
}

fn lookup_env_cache(cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {
  let len = Array::length(cache)
  let rec go: (Int) -> Option[TypeEnv] = (i) -> {
    if i >= len {
      None
    } else {
      let (p, env) = Array::get(cache, at = i)
      if p == path {
        Some(env)
      } else {
        go(i + 1)
      }
    }
  }
  go(0)
}

export fn db_check_env(db: TypeDb, path: String) -> Option[TypeEnv] {
  match unwrap_db(db) {
    TypeDbState(_, cache, _, _, _, _, _, _, _, _, _) => lookup_env_cache(cache = cache, path = path)
  }
}

fn compact_string_fingerprint(_ source: String) -> String {
  let mod1 = 2147483647
  let mod2 = 2147483629
  let step1 = 131
  let step2 = 65599
  let len = String::length(source)
  let mut h1 = 17
  let mut h2 = 29
  let mut i = 0
  while i < len {
    let c = String::char_code_at(source, at = i)
    h1 = (h1 * step1 + c + 1) % mod1
    h2 = (h2 * step2 + c + i + 1) % mod2
    i = i + 1
  }
  String::concat(__to_string(len), String::concat(":", String::concat(__to_string(h1), String::concat(":", __to_string(h2)))))
}

export fn db_typecheck_count(_ db: TypeDb) -> Int {
  match unwrap_db(db) {
    TypeDbState(rdb, _, _, _, _, _, _, _, _, _, _) => ripple_eval_count(rdb)
  }
}

export fn db_parse_count(_ db: TypeDb) -> Int {
  match unwrap_db(db) {
    TypeDbState(_, _, _, _, _, _, parse_count, _, _, _, _) => parse_count
  }
}

export fn db_merge_count(_ db: TypeDb) -> Int {
  match unwrap_db(db) {
    TypeDbState(_, _, _, _, _, _, _, merge_count, _, _, _) => merge_count
  }
}

export fn db_module_source_count(_ db: TypeDb) -> Int {
  match unwrap_db(db) {
    TypeDbState(_, _, _, _, _, _, _, _, module_source_count, _, _) => module_source_count
  }
}

export fn db_codegen_count(_ db: TypeDb) -> Int {
  match unwrap_db(db) {
    TypeDbState(_, _, _, _, _, _, _, _, _, codegen_count, _) => codegen_count
  }
}

// Source stamps are reusable only in the resolution universe that produced
// their dependency paths. The revision lives in RippleDb, so additions through
// FS loading and failed walks invalidate stamps just like db_set_source does.
fn dependency_sources_for_walk(cache: DependencySources, source_revision: Int) -> Array[(String, String)] {
  if cache.source_revision == source_revision {
    cache.entries
  } else {
    empty_string_pairs()
  }
}

export fn db_typecheck(db: TypeDb, path: String) -> TypeDb with Env + Exception {
  db_typecheck_with_config(db = db, path = path, cfg = target_cfg_ambient())
}

/// Check virtual sources with one flag snapshot for planning and checking.
export fn db_typecheck_with_config(db: TypeDb, path: String, cfg: TargetCfg) -> TypeDb with Env + Exception {
  match unwrap_db(db_for_target_cfg(db = db, cfg = cfg)) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count, cfg_identity) => {
      let revision = ripple_source_revision(rdb)
      let entries = dependency_sources_for_walk(cache = dep_source_cache, source_revision = revision)
      let (_, next_rdb, next_env_cache, next_entries, next_parse_count) = ensure_fingerprint_memory_with_config(rdb = rdb, env_cache = env_cache, dep_sources = entries, parse_count = parse_count, path = path, cfg = cfg)
      let next_cache = DependencySources::{
        entries: next_entries,
        source_revision: revision
      }
      wrap_db(TypeDbState(next_rdb, next_env_cache, next_cache, merged_cache, module_source_cache, artifact_cache, next_parse_count, merge_count, module_source_count, codegen_count, cfg_identity))
    }
  }
}

export fn db_typecheck_fs(db: TypeDb, path: String) -> TypeDb with Env + Exception + Fs {
  db_typecheck_fs_with_config(db = db, path = path, cfg = target_cfg_ambient())
}

/// Typecheck with one flag snapshot shared by planning, checking and caches.
export fn db_typecheck_fs_with_config(db: TypeDb, path: String, cfg: TargetCfg) -> TypeDb with Env + Exception + Fs {
  match unwrap_db(db_for_target_cfg(db = db, cfg = cfg)) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count, cfg_identity) => {
      let revision = ripple_source_revision(rdb)
      let entries = dependency_sources_for_walk(cache = dep_source_cache, source_revision = revision)
      let (_, next_rdb, next_env_cache, next_entries, next_parse_count) = ensure_fingerprint_fs_impl_with_config(rdb = rdb, env_cache = env_cache, dep_source_cache = entries, parse_count = parse_count, path = path, cfg = cfg)
      // Keep the entry revision: this FS walk may have loaded new sources
      // after reusing other headers. Those stamps need revalidation next time.
      let next_cache = DependencySources::{
        entries: next_entries,
        source_revision: revision
      }
      wrap_db(TypeDbState(next_rdb, next_env_cache, next_cache, merged_cache, module_source_cache, artifact_cache, next_parse_count, merge_count, module_source_count, codegen_count, cfg_identity))
    }
  }
}

/// Capture invocation flags before any filesystem provider can run.
export fn check_file_fs_configured(_ entry_path: String) -> Unit with Config + Env + Exception + Fs {
  let cfg = target_cfg_capture()
  let sources = collect_all_sources_fs_with_config(entry_path, cfg = cfg)
  let mut db = db_new()
  for entry in sources {
    db = db_set_source(db = db, path = entry.0, source = entry.1)
  }
  let _ = db_typecheck_fs_with_config(db = db, path = entry_path, cfg = cfg)
}

/// Capture flags once and check virtual files without filesystem authority.
/// The entry must be supplied; empty source text is a valid input.
export fn check_sources_memory_configured(_ entry_path: String, sources: Array[(String, String)]) -> Unit with Config + Env + Exception {
  let cfg = target_cfg_capture()
  let mut db = db_new()
  let mut has_entry = false
  for entry in sources {
    db = db_set_source(db = db, path = entry.0, source = entry.1)
    if entry.0 == entry_path {
      has_entry = true
    }
  }
  if !has_entry {
    throw("provide source text for '\{entry_path}' before checking it")
  }
  let _ = db_typecheck_with_config(db = db, path = entry_path, cfg = cfg)
}

export fn db_program_source(db: TypeDb, path: String) -> (String, String, TypeDb) with Env + Exception {
  let checked = db_typecheck(db = db, path = path)
  match unwrap_db(checked) {
    TypeDbState(rdb, _, _, _, _, _, _, _, _, _, _) =>
    match ripple_get_source(db = rdb, path = path) {
      None => throw(String::concat("missing:", path)),
      Some(source) =>
      match ripple_get_fingerprint(db = rdb, path = path) {
        Some(fingerprint) => (source, fingerprint, checked),
        None => (source, source, checked)
      }
    }
  }
}

fn build_merge_fingerprint(entry_path: String, sources: Array[(String, String)]) -> String {
  compilation_input_fingerprint(sources = sources, entry_path = entry_path)
}

fn lookup_source_by_path(sources: Array[(String, String)], target_path: String) -> Option[String] {
  let mut i = 0
  let mut found = None
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, at = i)
    if path == target_path {
      found = Some(source)
      i = Array::length(sources)
    } else {
      i = i + 1
    }
  }
  found
}

/// #716: collision-def fallback (see merge_sources.vibe). `excluded_locals`
/// are the locals the export-rename plan already rewrites; the inline copy gets
/// the target file's export renames applied first.
fn append_import_alias_collision_defs_from_sources(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], sources: Array[(String, String)], plan: ExportRenamePlan, excluded_locals: Array[String]) -> Array[String] with Env + Exception {
  let refs = collect_import_alias_collision_refs(stmts)
  let emitted = array_empty()
  let base_dir = dir_of_path(current_path)
  let mut i = 0
  while i < Array::length(refs) {
    let (raw_path, original, local) = Array::get(refs, at = i)
    if !contains_str(arr = emitted, target = local) && !contains_str(arr = excluded_locals, target = local) {
      let resolved = resolve_import_path(base_dir = base_dir, raw_path = raw_path)
      match lookup_source_by_path(sources = sources, target_path = resolved) {
        Some(source) => {
          let source_stmts = namespace_private_value_stmts_after_renames(path = resolved, stmts = parse_program_with_path(path = resolved, source = source), export_renames = export_plan_renames_for(plan = plan, path = resolved))
          let mut j = 0
          let mut done = false
          while j < Array::length(source_stmts) && !done {
            match rewrite_imported_value_stmt_to_local(stmt = Array::get(source_stmts, at = j), original = original, local = local) {
              Some(local_stmt) => {
                Array::push(merged, value = local_stmt)
                Array::push(emitted, value = local)
                done = true
              },
              None => ()
            }
            j = j + 1
          }
        },
        None => ()
      }
    }
    i = i + 1
  }
  emitted
}

/// #716: parse every source once and expose (paths, stmts) for the export-
/// rename plan; the merge itself reuses the parsed statements.
fn parse_merge_sources(_ sources: Array[(String, String)]) -> (Array[String], Array[Array[Stmt]]) with Env + Exception {
  let file_paths = array_empty()
  let file_stmts = array_empty()
  let mut si = 0
  while si < Array::length(sources) {
    let (path, source) = Array::get(sources, at = si)
    Array::push(file_paths, value = path)
    let stmts = parse_program_with_path(path = path, source = source)
    reject_user_iterator_serialized_boundaries(stmts)
    Array::push(file_stmts, value = stmts)
    si = si + 1
  }
  (file_paths, file_stmts)
}

/// One (sub)list of sources merged under a whole-program rename plan,
/// appended to `merged`, with each file's share recorded in `units` for the
/// impl-overlap check. `collision_sources` spans the whole program so a
/// collision-def import that crosses a group boundary still resolves. The
/// caller runs the check once the WHOLE program is in `merged` (#3544, #3551).
fn append_merged_sources_with_plan(merged: Array[Stmt], units: Array[LinkedUnit], entry_path: String, sources: Array[(String, String)], file_paths: Array[String], file_stmts: Array[Array[Stmt]], plan: ExportRenamePlan, collision_sources: Array[(String, String)]) -> Unit with Env + Exception {
  // #2205: no reset here -- db_grouped_merged_source calls this once per
  // cache-missing GROUP, and a per-call reset would discard the mappings of
  // every earlier group (Codex round 4 on #2213). The whole-merge entry
  // points (build_merged_source, db_grouped_merged_source) reset instead.
  let source_count = Array::length(sources)
  let mut si = 0
  while si < source_count {
    let path = Array::get(file_paths, at = si)
    let stmts = Array::get(file_stmts, at = si)
    let unit_start = Array::length(merged)
    let is_entry_source = if entry_path == "" {
      si == source_count - 1
    } else {
      path == entry_path
    }
    let import_renames = if stmts_have_import_deep(stmts) {
      collect_import_value_renames(plan = plan, path = path, stmts = stmts)
    } else {
      array_empty()
    }
    let (boundary_locals, _) = merged_source_boundary_names(stmts)
    append_builtin_iterator_operation_markers(markers = boundary_locals, renames = import_renames)
    Array::push(merged, value = builtin_iterator_serialized_boundary_from_markers(boundary_locals))
    let collision_renames = if is_entry_source {
      trait_import_local_operation_renames_preserving_exports(stmts = stmts, path = path)
    } else {
      trait_import_local_operation_renames(stmts = stmts, path = path)
    }
    let collision_renamed = apply_export_renames_stmts(stmts = stmts, renames = collision_renames)
    let namespaced_stmts = if is_entry_source {
      namespace_entry_import_shadows(path = path, stmts = collision_renamed)
    } else {
      namespace_private_value_stmts_after_renames(path = path, stmts = collision_renamed, export_renames = export_plan_renames_for(plan = plan, path = path))
    }
    if stmts_have_import_deep(stmts) {
      // #3443: only the locals the fallback cloned stop being rewritten. A
      // collision local with no value to clone (a type, a constructor) keeps
      // its alias: dropping it left `B::plain` unresolved at codegen when `Box`
      // also arrived through a re-export of the same module.
      let skipped_locals = append_import_alias_collision_defs_from_sources(merged = merged, current_path = path, stmts = stmts, sources = collision_sources, plan = plan, excluded_locals = import_value_rename_locals(import_renames))
      append_import_alias_rewritten_non_import_stmts_with_renames(merged = merged, stmts = namespaced_stmts, skipped_locals = skipped_locals, extra_renames = import_renames)
    } else {
      append_non_import_stmts_without_alias_rewrite(merged = merged, stmts = namespaced_stmts)
    }
    let (_, unit_source) = Array::get(sources, at = si)
    Array::push(units, value = linked_unit(path = path, source = unit_source, start = unit_start, end = Array::length(merged)))
    si = si + 1
  }
}

fn build_merged_source(entry_path: String, sources: Array[(String, String)]) -> String with Env + Exception {
  // #2205: the rename table describes ONE merged program.
  namespace_rename_originals_reset()
  let (file_paths, file_stmts) = parse_merge_sources(sources)
  let plan_entry = if entry_path == "" {
    if Array::length(file_paths) > 0 {
      Array::get(file_paths, at = Array::length(file_paths) - 1)
    } else {
      ""
    }
  } else {
    entry_path
  }
  let plan = build_export_rename_plan(paths = file_paths, stmts_list = file_stmts, entry_path = plan_entry)
  let merged = empty_stmt_array()
  let units: Array[LinkedUnit] = []
  append_merged_sources_with_plan(merged = merged, units = units, entry_path = entry_path, sources = sources, file_paths = file_paths, file_stmts = file_stmts, plan = plan, collision_sources = sources)
  // #3544: two modules' impls of one method name would collapse to one here.
  refuse_linked_impl_overlaps(merged = merged, units = units)
  print_program(merged)
}

fn join_group_sources(_ group_sources: Array[String]) -> String {
  let len = Array::length(group_sources)
  // O(N) via StringBuilder; the recursive `String::concat(acc, ...)` was
  // O(N²) over the source-group count.
  let buf = StringBuilder::new()
  let mut i = 0
  while i < len {
    let source = Array::get(group_sources, at = i)
    if i > 0 {
      StringBuilder::push(buf, value = "\n")
    }
    StringBuilder::push(buf, value = source)
    i = i + 1
  }
  StringBuilder::freeze(buf)
}

export fn db_merged_source(db: TypeDb, _entry_path: String, sources: Array[(String, String)]) -> (String, String, TypeDb) with Env + Exception {
  match unwrap_db(db) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count, cfg_identity) => {
      let merge_fingerprint = build_merge_fingerprint(entry_path = _entry_path, sources = sources)
      let merge_cache_key = "merged"
      match lookup_source_cache(cache = merged_cache, path = merge_cache_key, fingerprint = merge_fingerprint) {
        Some(merged_source) => (merged_source, merge_fingerprint, db),
        None => {
          let merged_source = build_merged_source(entry_path = _entry_path, sources = sources)
          let next_merged_cache = upsert_source_cache(cache = merged_cache, path = merge_cache_key, fingerprint = merge_fingerprint, source = merged_source)
          (merged_source, merge_fingerprint, wrap_db(TypeDbState(rdb, env_cache, dep_source_cache, next_merged_cache, module_source_cache, artifact_cache, parse_count, merge_count + 1, module_source_count, codegen_count, cfg_identity)))
        }
      }
    }
  }
}

export fn db_grouped_merged_source(db: TypeDb, groups: Array[(String, Array[(String, String)])]) -> (String, String, TypeDb) with Env + Exception {
  match unwrap_db(db) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count, cfg_identity) => {
      // Keep per-group results in side buffers, then append cache misses
      // once. Rebuilding the full cache on every group miss is O(N^2) for
      // the ~150-group compiler manifest.
      // #2205: one reset for the WHOLE grouped merge (a per-group reset
      // would discard every earlier group's mappings); cache-hit groups
      // replay their metadata below, since the merge that records it does
      // not run for them.
      namespace_rename_originals_reset()
      let group_sources = empty_strings()
      let mut grouped_fingerprint = "merged-groups"
      let new_group_cache_entries = empty_string_triples()
      let mut merge_count_acc = merge_count
      // #716: the export-rename plan spans ALL groups (imports cross group
      // boundaries), so every source is parsed once up front and the plan
      // fingerprint is folded into each group's cache fingerprint — a change
      // to the program's ambiguous-export set invalidates cached group merges
      // even when the group's own sources are unchanged.
      let flat_sources = array_empty()
      let mut fgi = 0
      while fgi < Array::length(groups) {
        let (_, gsources) = Array::get(groups, at = fgi)
        let mut fsi = 0
        while fsi < Array::length(gsources) {
          Array::push(flat_sources, value = Array::get(gsources, at = fsi))
          fsi = fsi + 1
        }
        fgi = fgi + 1
      }
      let (flat_paths, flat_stmts) = parse_merge_sources(flat_sources)
      let plan_entry = if Array::length(flat_paths) > 0 {
        Array::get(flat_paths, at = Array::length(flat_paths) - 1)
      } else {
        ""
      }
      let plan = build_export_rename_plan(paths = flat_paths, stmts_list = flat_stmts, entry_path = plan_entry)
      let plan_fp = compact_string_fingerprint(export_plan_fingerprint_text(plan))
      let group_fingerprints = empty_strings()
      let mut gfi = 0
      while gfi < Array::length(groups) {
        let (group_name, sources) = Array::get(groups, at = gfi)
        let fingerprint = compact_string_fingerprint(String::concat(build_merge_fingerprint(entry_path = plan_entry, sources = sources), String::concat("#", plan_fp)))
        Array::push(group_fingerprints, value = fingerprint)
        let grouped_next = String::concat(grouped_fingerprint, String::concat("|", String::concat(group_name, String::concat("=", fingerprint))))
        grouped_fingerprint = compact_string_fingerprint(grouped_next)
        gfi = gfi + 1
      }
      let grouped_cache_key = "merged-groups"
      // #3544 / #3551 review: two impls of one method in DIFFERENT groups
      // collapse in the joined text exactly as within one group, so the
      // impl-overlap check reads the whole program -- every group's
      // statements laid out in one array -- not each group alone. An earlier
      // call that produced this exact joined program ran the check on it
      // (a refusal caches nothing), so a hit on the whole program skips it;
      // otherwise a group whose text comes from the cache is linked again
      // for the check, since only its text was kept.
      let program_checked = lookup_source_cache(cache = merged_cache, path = grouped_cache_key, fingerprint = grouped_fingerprint) is Some(_)
      let program = empty_stmt_array()
      let units: Array[LinkedUnit] = []
      let linked_groups = empty_string_triples()
      let mut flat_idx = 0
      let mut i = 0
      while i < Array::length(groups) {
        let (group_name, sources) = Array::get(groups, at = i)
        let group_start = flat_idx
        flat_idx = flat_idx + Array::length(sources)
        let fingerprint = Array::get(group_fingerprints, at = i)
        let cache_key = String::concat("merged-group|", group_name)
        match lookup_source_cache(cache = merged_cache, path = cache_key, fingerprint = fingerprint) {
          Some(source) => {
            if !program_checked && lookup_source_cache(cache = linked_groups, path = cache_key, fingerprint = fingerprint) is None {
              // The merge records the rename metadata the replay below would.
              let group_paths = Array::slice(flat_paths, start = group_start, end = group_start + Array::length(sources))
              let group_stmts = Array::slice(flat_stmts, start = group_start, end = group_start + Array::length(sources))
              append_merged_sources_with_plan(merged = program, units = units, entry_path = plan_entry, sources = sources, file_paths = group_paths, file_stmts = group_stmts, plan = plan, collision_sources = flat_sources)
              Array::push(linked_groups, value = StringTriple(cache_key, fingerprint, ""))
            } else {
              // #2205: the cached TEXT already contains the mangled names, but
              // the merge that records (mangled -> original) for derive(Show)
              // never runs on a hit -- replay just the metadata from the
              // already-parsed stmts so rendering matches a cold cache. The
              // entry file keeps its private names in the merge, so it is
              // skipped here too.
              let mut ri = 0
              while ri < Array::length(sources) {
                let rpath = Array::get(flat_paths, at = group_start + ri)
                if rpath == plan_entry {
                  ()
                } else {
                  record_namespace_rename_originals_for_file(path = rpath, stmts = Array::get(flat_stmts, at = group_start + ri))
                }
                ri = ri + 1
              }
            }
            Array::push(group_sources, value = source)
          },
          None =>
          match lookup_source_cache(cache = new_group_cache_entries, path = cache_key, fingerprint = fingerprint) {
            Some(source) => {
              Array::push(group_sources, value = source)
            },
            None => {
              let group_paths = Array::slice(flat_paths, start = group_start, end = group_start + Array::length(sources))
              let group_stmts = Array::slice(flat_stmts, start = group_start, end = group_start + Array::length(sources))
              // #740: pass the WHOLE-merge plan entry, not "" — the empty
              // entry made the merge treat the last file of EVERY GROUP as
              // the entry (exports unrenamed), so group tails (ripple.vibe,
              // desugar_trait_dict.vibe, ...) were missing their `_exp_`
              // defs while callers referenced them.
              let group_start_stmt = Array::length(program)
              append_merged_sources_with_plan(merged = program, units = units, entry_path = plan_entry, sources = sources, file_paths = group_paths, file_stmts = group_stmts, plan = plan, collision_sources = flat_sources)
              let source = print_program(Array::slice(program, start = group_start_stmt, end = Array::length(program)))
              Array::push(new_group_cache_entries, value = StringTriple(cache_key, fingerprint, source))
              merge_count_acc = merge_count_acc + 1
              Array::push(group_sources, value = source)
            }
          }
        }
        i = i + 1
      }
      if program_checked {
        ()
      } else {
        refuse_linked_impl_overlaps(merged = program, units = units)
      }
      let next_merged_cache = append_source_cache_entries(cache = merged_cache, entries = new_group_cache_entries)
      let next_merge_count = merge_count_acc
      match lookup_source_cache(cache = next_merged_cache, path = grouped_cache_key, fingerprint = grouped_fingerprint) {
        Some(source) =>
        (source, grouped_fingerprint, wrap_db(TypeDbState(rdb, env_cache, dep_source_cache, next_merged_cache, module_source_cache, artifact_cache, parse_count, next_merge_count, module_source_count, codegen_count, cfg_identity))),
        None => {
          let source = join_group_sources(group_sources)
          let final_merged_cache = upsert_source_cache(cache = next_merged_cache, path = grouped_cache_key, fingerprint = grouped_fingerprint, source = source)
          (source, grouped_fingerprint, wrap_db(TypeDbState(rdb, env_cache, dep_source_cache, final_merged_cache, module_source_cache, artifact_cache, parse_count, next_merge_count + 1, module_source_count, codegen_count, cfg_identity)))
        }
      }
    }
  }
}

fn build_module_source(_ source: String) -> String with Exception {
  let stmts = parse_program(lex(source))
  let filtered = empty_stmt_array()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    let keep = match stmt {
      SLet(_, _, _, _, expr) => {
        match expr {
          EFn(_, _, _, _, _, _) => true,
          _ => false
        }
      },
      _ => builtin_iterator_serialized_boundary_markers(stmt) is Some(_)
    }
    if keep {
      Array::push(filtered, value = stmt)
    }
    i = i + 1
  }
  print_program(filtered)
}

export fn db_module_source(db: TypeDb, fingerprint: String, source: String) -> (String, TypeDb) with Exception {
  match unwrap_db(db) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count, cfg_identity) => {
      let module_cache_key = "module-source"
      match lookup_source_cache(cache = module_source_cache, path = module_cache_key, fingerprint = fingerprint) {
        Some(module_source) => (module_source, db),
        None => {
          let module_source = build_module_source(source)
          let next_module_source_cache = upsert_source_cache(cache = module_source_cache, path = module_cache_key, fingerprint = fingerprint, source = module_source)
          (module_source, wrap_db(TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, next_module_source_cache, artifact_cache, parse_count, merge_count, module_source_count + 1, codegen_count, cfg_identity)))
        }
      }
    }
  }
}

fn artifact_cache_key(kind: String, entry_name: String) -> String {
  String::concat(typing_semantics_seed(), String::concat("|", String::concat(kind, String::concat("|", entry_name))))
}

fn bytes_to_hex_digit(_ n: Int) -> String {
  if n < 10 {
    __to_string(n)
  } else if n == 10 {
    "a"
  } else if n == 11 {
    "b"
  } else if n == 12 {
    "c"
  } else if n == 13 {
    "d"
  } else if n == 14 {
    "e"
  } else {
    "f"
  }
}

fn nibble_from_hex_char(_ c: Int) -> Int with Exception {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    throw("invalid hex digit")
  }
}

fn bytes_to_hex(_ bytes: Bytes) -> String {
  let len = Bytes::length(bytes)
  let mut i = 0
  // O(N) via StringBuilder; previously each `String::concat(out, ...)`
  // copied the growing buffer, making this O(N²) for the N-byte module
  // hashes this routine serialises.
  let buf = StringBuilder::new()
  while i < len {
    let byte = Bytes::get(bytes, at = i)
    let hi = byte / 16
    let lo = byte % 16
    StringBuilder::push(buf, value = bytes_to_hex_digit(hi))
    StringBuilder::push(buf, value = bytes_to_hex_digit(lo))
    i = i + 1
  }
  StringBuilder::freeze(buf)
}

fn hex_to_bytes(_ hex: String) -> Bytes with Exception {
  let len = String::length(hex)
  if len % 2 != 0 {
    throw("invalid hex length")
  } else {
    let out = Bytes::new()
    let mut i = 0
    while i < len {
      let hi = nibble_from_hex_char(String::char_code_at(hex, at = i))
      let lo = nibble_from_hex_char(String::char_code_at(hex, at = i + 1))
      Bytes::push(out, value = hi * 16 + lo)
      i = i + 2
    }
    out
  }
}

export fn db_load_artifact(db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with Exception {
  match unwrap_db(db) {
    TypeDbState(_, _, _, _, _, artifact_cache, _, _, _, _, _) =>
    match lookup_source_cache(cache = artifact_cache, path = artifact_cache_key(kind = kind, entry_name = entry_name), fingerprint = fingerprint) {
      Some(hex) => Some(hex_to_bytes(hex)),
      None => None
    }
  }
}

export fn db_store_artifact(db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> TypeDb {
  match unwrap_db(db) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count, cfg_identity) =>
    wrap_db(TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, upsert_source_cache(cache = artifact_cache, path = artifact_cache_key(kind = kind, entry_name = entry_name), fingerprint = fingerprint, source = bytes_to_hex(bytes)), parse_count, merge_count, module_source_count, codegen_count + 1, cfg_identity))
  }
}

// Sources are caller-owned inputs. Everything derived from their parse belongs
// to the flags that selected it, including resident dependency edges and merges.
fn db_for_target_cfg(db: TypeDb, cfg: TargetCfg) -> TypeDb {
  let identity = target_cfg_identity(cfg)
  match unwrap_db(db) {
    TypeDbState(rdb, env_cache, dep_sources, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count, previous) => {
      if previous == identity {
        db
      } else {
        let deps = DependencySources::{
          entries: empty_string_pairs(),
          source_revision: ripple_source_revision(rdb)
        }
        wrap_db(TypeDbState(ripple_without_results(rdb), empty_env_cache(), deps, empty_string_triples(), empty_string_triples(), empty_string_triples(), parse_count, merge_count, module_source_count, codegen_count, identity))
      }
    }
  }
}
