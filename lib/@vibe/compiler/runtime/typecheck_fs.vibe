//# Functions

fn empty_stack() -> Array[String] {
  array_empty()
}

fn empty_dep_fps() -> Array[(String, String)] {
  array_empty()
}

fn lookup_env_cache(cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {
  let len = Array::length(cache)
  let mut i = 0
  let mut result = None
  let mut done = false
  while !done {
    if i >= len {
      done = true
    } else {
      let (p, env) = Array::get(cache, i)
      if p == path {
        result = Some(env)
        done = true
      } else {
        i = i + 1
      }
    }
  }
  result
}

fn resolve_cached_import_path(base_dir: String, raw_path: String, cache: Array[(String, TypeEnv)]) -> String {
  let candidates = resolve_import_path_candidates(base_dir, raw_path)
  let mut selected = ""
  let mut i = 0
  while i < Array::length(candidates) && selected == "" {
    let candidate = Array::get(candidates, i)
    match lookup_env_cache(cache, candidate) {
      Some(_) => {
        selected = candidate
      },
      None => ()
    }
    i = i + 1
  }
  if selected == "" {
    resolve_import_path(base_dir, raw_path)
  } else {
    selected
  }
}

fn starts_with_upper(name: String) -> Bool {
  if String::length(name) == 0 {
    false
  } else {
    let c = String::char_code_at(name, 0)
    c >= 65 && c <= 90
  }
}

fn type_returns_name(ty: Type, type_name: String) -> Bool {
  match ty {
    CtEnum(name) => name == type_name,
    CtNamed(name, _) => name == type_name,
    CtFn(_, ret, _) => type_returns_name(ret, type_name),
    CtForAll(_, _, body) => type_returns_name(body, type_name),
    _ => false
  }
}

/// Companions bound alongside an imported type `T`: (a) constructors and
/// constructor-like functions RETURNING T (the original rule -- written
/// for enum constructors, whose type is always `... -> T`), and (b) any
/// export whose NAME is qualified with `T::` (#1080): the #777
/// `Json::string`-style direct-value accessors are exported under the
/// type's qualified namespace but RETURN a different type (String/Int/
/// Bool/...), so rule (a) never bound them -- importing `{ Json }` gave
/// you `Json::parse`/`Json::field` (return Json, matched (a) by
/// coincidence) but "unknown name: Json::string" for the other 8 of the
/// 11 documented accessors. The bundle-merge lane resolves these by name
/// against the merged unit and never had the gap; only this FS lane did.
fn bind_enum_constructor_companions(acc: TypeEnv, dep_bindings: Array[(String, Type)], enum_name: String) -> TypeEnv {
  let qual_prefix = String::concat(enum_name, "::")
  let mut out = acc
  let mut i = 0
  while i < Array::length(dep_bindings) {
    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)
    if candidate_name != enum_name && starts_with_upper(candidate_name) && (type_returns_name(candidate_ty, enum_name) || String::starts_with(candidate_name, qual_prefix)) {
      out = env_bind(out, candidate_name, candidate_ty)
    }
    i = i + 1
  }
  out
}

fn bind_import_names_from_cache(acc: TypeEnv, resolved: String, names: Array[(String, Option[String])], cache: Array[(String, TypeEnv)]) -> TypeEnv {
  let dep_env = match lookup_env_cache(cache, resolved) {
    Some(e) => e,
    None => EnvEmpty
  }
  let dep_bindings = env_flat_bindings(dep_env)
  let nlen = Array::length(names)
  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {
    if j >= nlen {
      nacc
    } else {
      let (name, alias) = Array::get(names, j)
      let bound_name = match alias {
        Some(a) => a,
        None => name
      }
      let ty = match env_lookup_flat(dep_bindings, name) {
        Some(t) => t,
        None => CtUnknown
      }
      let with_name = env_bind(nacc, bound_name, ty)
      let with_companions = match ty {
        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),
        _ => if starts_with_upper(name) {
          bind_enum_constructor_companions(with_name, dep_bindings, name)
        } else {
          with_name
        }
      }
      bind_names(j + 1, with_companions)
    }
  }
  bind_names(0, acc)
}

fn build_import_env(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv {
  let len = Array::length(stmts)
  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {
    if i >= len {
      acc
    } else {
      let next = match Array::get(stmts, i) {
        SImport(raw_path, names) => {
          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)
          bind_import_names_from_cache(acc, resolved, names, cache)
        },
        SReExport(raw_path, names) => {
          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)
          bind_import_names_from_cache(acc, resolved, names, cache)
        },
        _ => acc
      }
      go(i + 1, next)
    }
  }
  go(0, EnvEmpty)
}

fn upsert_env_cache(cache: Array[(String, TypeEnv)], path: String, env: TypeEnv) -> Array[(String, TypeEnv)] {
  let len = Array::length(cache)
  let mut i = 0
  let mut found = false
  while i < len && !found {
    let (p, _) = Array::get(cache, i)
    if p == path {
      Array::set(cache, i, (path, env))
      found = true
    } else {
      i = i + 1
    }
  }
  if !found {
    Array::push(cache, (path, env))
  }
  cache
}

fn ensure_env_cache_for_path(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], path: String) -> Array[(String, TypeEnv)] with { Error, Fs } {
  match lookup_env_cache(env_cache, path) {
    Some(_) => env_cache,
    None =>
    match ripple_get_fingerprint(rdb, path) {
      Some(fingerprint) =>
      match load_persistent_type_env(fingerprint) {
        Some(cached_env) => upsert_env_cache(env_cache, path, cached_env),
        None => env_cache
      },
      None => env_cache
    }
  }
}

fn ensure_env_cache_for_paths(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], paths: Array[String]) -> Array[(String, TypeEnv)] with { Error, Fs } {
  let mut cache = env_cache
  let mut i = 0
  while i < Array::length(paths) {
    cache = ensure_env_cache_for_path(rdb, cache, Array::get(paths, i))
    i = i + 1
  }
  cache
}

fn build_fingerprint(source: String, dep_fps: Array[(String, String)]) -> String {
  let mut acc = compact_string_fingerprint(source)
  let mut i = 0
  while i < Array::length(dep_fps) {
    let dep_pair = Array::get(dep_fps, i)
    let dep_path = dep_pair.0
    let dep_fp = dep_pair.1
    let next = String::concat(acc, String::concat("|", String::concat(dep_path, String::concat("=", dep_fp))))
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

fn copy_string_array(items: Array[String]) -> Array[String] {
  // Iterative push: previous recursive Array::concat(acc, [x]) was
  // O(N^2) — copied the full prefix on each step.
  let out = empty_stack()
  let mut i = 0
  let len = Array::length(items)
  while i < len {
    Array::push(out, Array::get(items, i))
    i = i + 1
  }
  out
}

/// Shallow copy of a (path, source) cache.
///
/// plan_import_graph_fs has to resolve dependencies against its OWN copy:
/// upsert_string_pair below MUTATES the array it is handed and returns that
/// same array, and resolve_deps_for_source_fs upserts on every miss. Planning
/// against the caller's cache therefore marked every module's current source
/// as already-seen before the walk even started -- and the walk reads exactly
/// that to decide whether a module's cached fingerprint is still valid, so an
/// edited source reused its stale type env (caught by
/// type_db_cross_module_test's "source update bypasses current-run cache").
fn copy_string_pairs(pairs: Array[(String, String)]) -> Array[(String, String)] {
  let out = empty_dep_fps()
  let mut i = 0
  let len = Array::length(pairs)
  while i < len {
    Array::push(out, Array::get(pairs, i))
    i = i + 1
  }
  out
}

fn lookup_string_pair(pairs: Array[(String, String)], key: String) -> Option[String] {
  let len = Array::length(pairs)
  let mut i = 0
  let mut result = None
  let mut done = false
  while !done {
    if i >= len {
      done = true
    } else {
      let (k, v) = Array::get(pairs, i)
      if k == key {
        result = Some(v)
        done = true
      } else {
        i = i + 1
      }
    }
  }
  result
}

fn upsert_string_pair(pairs: Array[(String, String)], key: String, value: String) -> Array[(String, String)] {
  let len = Array::length(pairs)
  let mut i = 0
  let mut found = false
  while i < len && !found {
    let (k, _) = Array::get(pairs, i)
    if k == key {
      Array::set(pairs, i, (key, value))
      found = true
    } else {
      i = i + 1
    }
  }
  if !found {
    Array::push(pairs, (key, value))
  }
  pairs
}

/// --- #906 Phase 0: ready-order oracle -----------------------------------
///
/// The import-DAG walk below visits a module's dependencies in DECLARATION
/// order. Phase 2 will hand ready modules to workers, at which point the
/// visit order becomes whatever the scheduler picks -- so the property that
/// has to hold before any of that is built is "the order dependencies are
/// visited cannot change the output". This seed makes that property
/// TESTABLE today, with no real parallelism: a non-zero seed permutes each
/// node's dependency visit order deterministically, and
/// scripts/dep_order_oracle.sh asserts the compiled wasm is byte-identical
/// across seeds.
///
/// The switch rides in a module-level cell rather than a parameter for the
/// same reason set_error_row_checked (checker/checker_effects.vibe) does:
/// the typecheck walk is pure (no Env row) and threading a config value
/// through every frame of a recursion that already carries five accumulators
/// would be far more invasive than the thing being tested.
///
/// Seed 0 (the default, and what every production build uses) is the
/// identity permutation -- byte-for-byte the pre-#906 walk.
let dep_order_seed_cell = array_empty()

export fn set_dep_order_seed(seed: Int) -> Unit {
  Array::truncate(dep_order_seed_cell, 0)
  Array::push(dep_order_seed_cell, seed)
}

fn dep_order_seed() -> Int {
  if Array::length(dep_order_seed_cell) > 0 {
    Array::get(dep_order_seed_cell, 0)
  } else {
    0
  }
}

/// --- #1259: scheduler trace, for the real-path differential oracle -------
///
/// #1239 step 8 asks that the REAL compile path's execution trace be matched
/// against formal/VibeFormal/Compiler/Scheduler.lean. Until now only a
/// synthetic worker was (scripts/parallel_selfhost_checker.mjs), which can
/// only show the model is self-consistent -- never that the compiler is an
/// instance of it.
///
/// When VIBE_SCHEDULER_TRACE names a file, the walk records what the Lean
/// model needs and nothing else. Two row kinds:
///
///   project<TAB><path><TAB><rank>[<TAB><dep>...]   the planned graph
///   step<TAB><path><TAB><fingerprint>              in EXECUTION order
///
/// `project` rows are `Project.dependencies` and `Project.rank`; `step` rows
/// are the `Step.run` sequence, and their order is the interleaving a
/// scheduler chose (VIBE_DEP_ORDER_SEED permutes it within a wave). The
/// fingerprint is the published `JobResult`. scripts/scheduler_trace_oracle.sh
/// checks the four properties that model states -- see it for which row
/// proves which.
///
/// Accumulated in memory and written once, not appended per module: the row
/// order IS the execution order, so a partial file from an aborted run would
/// read as a legitimate shorter schedule rather than as a truncated one.
let scheduler_trace_cell = array_empty()

export fn set_scheduler_trace_path(path: String) -> Unit {
  Array::truncate(scheduler_trace_cell, 0)
  Array::push(scheduler_trace_cell, path)
}

fn scheduler_trace_path() -> String {
  if Array::length(scheduler_trace_cell) > 0 {
    Array::get(scheduler_trace_cell, 0)
  } else {
    ""
  }
}

/// --- #1259: cross-module diagnostic collection ---------------------------
///
/// Whether the import-DAG walk COLLECTS a diagnostic per failing module
/// instead of failing fast on the first one. This is #1239 step 5's missing
/// prerequisite: step 5 asks for diagnostics sorted into a canonical order and
/// compared across `--jobs=1/2/4`, and until now there was never more than one
/// diagnostic to sort -- commit_module_outcome threw on the first.
///
/// OFF by default, and off is byte-for-byte the pre-#1259 walk: the same
/// message, raised for the same module, with the same partial cache state
/// behind it. `VIBE_DIAGNOSTICS_ALL=1` (read in cli_adapter.vibe alongside the
/// other mode switches, so every lane agrees) turns it on.
///
/// Default-off is a deliberate compatibility choice, not indecision. Turning
/// collection on changes two observable things at once -- the error text grows
/// from one diagnostic to N, and modules that a fail-fast walk never reached
/// now get checked and their environments committed to the persistent cache --
/// and flipping the default is a separate decision from having the mechanism
/// and its determinism gate.
///
/// The switch rides in a module-level cell for the same reason
/// dep_order_seed_cell above does.
let collect_diagnostics_cell = array_empty()

export fn set_collect_module_diagnostics(on: Bool) -> Unit {
  Array::truncate(collect_diagnostics_cell, 0)
  Array::push(collect_diagnostics_cell, on)
}

fn collect_module_diagnostics() -> Bool {
  if Array::length(collect_diagnostics_cell) > 0 {
    Array::get(collect_diagnostics_cell, 0)
  } else {
    false
  }
}

/// A permutation of [0, n) as a visit order. Identity when no seed is set.
/// Otherwise a seeded Fisher-Yates using a small LCG -- deterministic for a
/// given (seed, n), so a failing oracle run is exactly reproducible.
fn dep_visit_order(n: Int) -> Array[Int] {
  let order = array_empty()
  let mut i = 0
  while i < n {
    Array::push(order, i)
    i = i + 1
  }
  let seed = dep_order_seed()
  if seed == 0 || n < 2 {
    order
  } else {
    // LCG (Numerical Recipes constants), kept inside 31 bits so the 62-bit
    // Int never overflows and the sequence is identical on every backend.
    let mut state = seed
    let mut j = n - 1
    while j > 0 {
      state = (state * 1664525 + 1013904223)&2147483647
      let k = state % (j + 1)
      let tmp = Array::get(order, j)
      Array::set(order, j, Array::get(order, k))
      Array::set(order, k, tmp)
      j = j - 1
    }
    order
  }
}

/// #1100: process-local parse memo. A cold fs-mode compile parses the SAME
/// source text TWICE -- once here for the typecheck walk (only on a
/// persistent type-env cache MISS, see finish_typecheck_fs_impl) and once
/// again for the merge (parse_sources_for_merge, file_compile.vibe). Both
/// sites ran the identical `lex_with_offsets` + `parse_program_located` pair
/// under the identical `<path>: <msg>` error wrapping, so the second parse
/// was pure waste -- #1100's phase attribution measured the merge parse at
/// 102 MB of a ~850 MB cold selfcompile.
///
/// Keyed by (path, EXACT source text). The source is compared in full rather
/// than fingerprinted: a same-path re-ingest with different text is a real
/// shape (#897's vpkg shared-import prefix marker), and a full compare is
/// far cheaper than the parse it guards.
///
/// The memo hands out a SHALLOW COPY of the top-level statement array, never
/// the stored one. check_program mutates its argument in place --
/// inject_prelude_result APPENDS the Result enum, and
/// inject_trait_method_generics / desugar_railway_binds /
/// desugar_labeled_args each `Array::set(stmts, i, <rewritten>)` -- so
/// handing out the pristine array directly would leak a per-file Result
/// declaration (one per file, all merged together) and pre-desugared
/// statements into the merge. Every one of those mutators writes only at the
/// TOP level (verified: they rebuild each Stmt functionally and write it
/// back by index), so a fresh top-level array is complete isolation; the
/// Stmt values themselves are immutable enum payloads.
///
/// A throwing parse is NOT memoized: the cells stay untouched, so a second
/// caller re-parses and re-throws identically.
let parse_memo_paths: Array[String] = [
]

let parse_memo_sources: Array[String] = [
]

let parse_memo_stmts: Array[Array[Stmt]] = [
]

export fn parse_program_with_path(path: String, source: String) -> Array[Stmt] with { Error } {
  let n = Array::length(parse_memo_paths)
  let mut i = 0
  let mut hit = -1
  while i < n && hit < 0 {
    if Array::get(parse_memo_paths, i) == path && Array::get(parse_memo_sources, i) == source {
      hit = i
    } else {
      ()
    }
    i = i + 1
  }
  if hit >= 0 {
    let cached = Array::get(parse_memo_stmts, hit)
    Array::slice(cached, 0, Array::length(cached))
  } else {
    let parsed = handle {
      // Located lex+parse so EIdent (and other) nodes carry real source char
      // offsets; the checker rides those offsets into type diagnostics via the
      // [@off=N] marker (decoded by locate_type_error). The plain
      // `parse_program(lex(source))` passed an empty starts array, leaving every
      // offset at -1, so located type errors fell back to a first-occurrence scan.
      let (tokens, starts, _ends) = lex_with_offsets(source)
      parse_program_located(tokens, starts, source)
    } with Error {
      Throw(msg) => throw(String::concat(String::concat(path, ": "), msg))
    }
    // Bound the memo. It is process-wide, and `vibe --daemon` (the #906
    // worker transport reuses one) serves many compiles from one process:
    // each edited source is a new (path, source) pair, so an unbounded memo
    // grows monotonically in guest memory -- full source AND AST per entry
    // -- and the linear scan above gets slower with every historical
    // version retained.
    //
    // The win this memo exists for is WITHIN one compile: the typecheck
    // walk parses every module, then the merge parses them all again, so
    // the whole module set has to be resident at once. The cap is
    // therefore set well above a self-compile's module count (264 manifest
    // rows) rather than to some small number. Clearing outright instead of
    // evicting one entry keeps this branch simple; at 1024 vs 264 it can
    // only trigger after hundreds of edits in a single daemon, and it
    // costs one compile's worth of re-parsing when it does.
    if Array::length(parse_memo_paths) >= 1024 {
      Array::truncate(parse_memo_paths, 0)
      Array::truncate(parse_memo_sources, 0)
      Array::truncate(parse_memo_stmts, 0)
    } else {
      ()
    }
    Array::push(parse_memo_paths, path)
    Array::push(parse_memo_sources, source)
    Array::push(parse_memo_stmts, parsed)
    Array::slice(parsed, 0, Array::length(parsed))
  }
}

fn store_persistent_type_env(fingerprint: String, env: TypeEnv) -> Unit with { Error, Fs } {
  Fs::write_file(persistent_type_env_cache_path(fingerprint), persistent_type_env_cache_text(env))
}

fn write_persistent_dep_list_if_missing(path: String, source: String, deps: Array[String]) -> Unit with { Fs } {
  let dep_cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))
  if !(Fs::exists(dep_cache_path)) {
    Fs::write_file(dep_cache_path, persistent_dep_list_text(deps))
  } else {
    ()
  }
}

/// Span of an identifier run starting at `start` (returns the end offset).
fn typecheck_ident_run(s: String, start: Int) -> Int {
  let len = String::length(s)
  let mut e = start
  let mut go = true
  while go && e < len {
    let c = String::char_code_at(s, e)
    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
    if is_id {
      e = e + 1
    } else {
      go = false
    }
  }
  e
}

/// Best-effort `line:col` for a type error: pull the symbol out of
/// `unknown name: X` and locate its first occurrence in the source. Real
/// expression-level spans (AST node positions) remain future work; this gives
/// the common case a line number in both CLI and LSP (which parses the prefix).
/// Built with String::concat only (not `+`) to avoid this NUL fragility.
/// Prefix `msg` with the source `line:col` of the symbol that follows `marker`
/// in `msg` (if both are found); otherwise return `msg` unchanged.
fn locate_by_marker(source: String, msg: String, marker: String) -> String {
  let mi = String::index_of(msg, marker)
  if mi < 0 {
    msg
  } else {
    let sstart = mi + String::length(marker)
    let send = typecheck_ident_run(msg, sstart)
    if send <= sstart {
      msg
    } else {
      let sym = String::substring(msg, sstart, send)
      let off = String::index_of(source, sym)
      if off < 0 {
        msg
      } else {
        let (line, col) = offset_to_line_col(source, off)
        let loc = String::concat("line ", String::concat(__to_string(line), String::concat(":", String::concat(__to_string(col), ": "))))
        String::concat(loc, msg)
      }
    }
  }
}

/// The exact text between `marker` and the NEXT `'` in `msg` -- unlike
/// `locate_by_marker`'s `typecheck_ident_run` (which only captures plain
/// identifier chars), this captures the quoted substring verbatim, so a
/// symbol like `@shell` (not a bare identifier) comes out whole. Returns ""
/// if `marker` or the closing quote isn't found.
fn extract_quoted_after(msg: String, marker: String) -> String {
  let mi = String::index_of(msg, marker)
  if mi < 0 {
    ""
  } else {
    let rest = String::substring(msg, mi + String::length(marker), String::length(msg))
    let rel_end = String::index_of(rest, "'")
    if rel_end < 0 {
      ""
    } else {
      String::substring(rest, 0, rel_end)
    }
  }
}

/// First occurrence of `sym` in `source` at or after char offset `from`
/// (clamped into range), or -1.
fn index_of_after(source: String, sym: String, from: Int) -> Int {
  if String::length(sym) == 0 {
    0 - 1
  } else {
    let start = if from < 0 {
      0
    } else if from > String::length(source) {
      String::length(source)
    } else {
      from
    }
    let rel = String::index_of(String::substring(source, start, String::length(source)), sym)
    if rel < 0 {
      0 - 1
    } else {
      start + rel
    }
  }
}

/// #1205 Codex review: a plain first-occurrence search for the bare
/// name/alias (the #1204 approach) can land on an EARLIER, unrelated
/// occurrence of the same spelling -- a comment or string mentioning the
/// name before the import statement itself, or another import of the same
/// name from a different path. `detect_unused_imports`' own message embeds
/// the import's PATH too (`imported name 'X' from 'PATH' ..` / `import alias
/// '@A' for 'PATH' ..`) -- a path is far less likely to collide with
/// unrelated text than a short bare identifier, so anchor on the path's OWN
/// first occurrence and search for the name/alias only from there forward:
/// the import statement's own occurrence of its item names always comes
/// shortly after its own path in the source. Degrades to an unanchored
/// search (starting from offset 0) if the path itself can't be found, which
/// is no worse than the #1204 behavior this replaces.
fn locate_unused_import_msg(source: String, msg: String) -> String {
  let name_marker = "imported name '"
  let alias_marker = "import alias '"
  let is_alias = String::index_of(msg, alias_marker) >= 0
  if not(is_alias) && String::index_of(msg, name_marker) < 0 {
    msg
  } else {
    let sym = if is_alias {
      extract_quoted_after(msg, alias_marker)
    } else {
      extract_quoted_after(msg, name_marker)
    }
    let path = if is_alias {
      extract_quoted_after(msg, "' for '")
    } else {
      extract_quoted_after(msg, "' from '")
    }
    if sym == "" {
      msg
    } else {
      let anchor = if path == "" {
        0
      } else {
        let p = String::index_of(source, path)
        if p < 0 {
          0
        } else {
          p
        }
      }
      let off = index_of_after(source, sym, anchor)
      if off < 0 {
        msg
      } else {
        String::concat(offset_line_col_prefix(source, off), msg)
      }
    }
  }
}

/// First-occurrence heuristic locator (the original behavior). Kept separate so
/// the offset-marker path can fall through to it on the marker-stripped message.
fn locate_type_error_heuristic(source: String, msg: String) -> String {
  // Already located (e.g. a parse error that bubbled here)? leave it.
  if String::index_of(msg, "line ") == 0 {
    msg
  } else {
    let with_name = locate_by_marker(source, msg, "unknown name: ")
    if with_name != msg {
      with_name
    } else {
      let with_arity = locate_by_marker(source, msg, "function arity mismatch for ")
      if with_arity != msg {
        with_arity
      } else {
        let with_field = locate_by_marker(source, msg, "unknown field ")
        if with_field != msg {
          with_field
        } else {
          let with_ctor = locate_by_marker(source, msg, "unknown constructor ")
          if with_ctor != msg {
            with_ctor
          } else {
            // #1204/#1205: detect_unused_imports' two message shapes (named
            // import / package alias), path-anchored -- see
            // locate_unused_import_msg's own doc comment.
            let with_import = locate_unused_import_msg(source, msg)
            if with_import != msg {
              with_import
            } else {
              // #946(4): inline-wasm codegen errors ("inline wasm (fn
              // <name>): ...") carry no [@off=] marker (the offset they DO
              // carry is a WAT-text offset, not a source char offset) --
              // locate by the enclosing fn's name instead, same
              // first-occurrence heuristic as the other markers.
              locate_by_marker(source, msg, "inline wasm (fn ")
            }
          }
        }
      }
    }
  }
}

/// Build the `line L:col C: ` prefix for a source char offset (same format as
/// locate_by_marker). String::concat only — the `+`/interpolation NUL
/// hazard applies here too.
fn offset_line_col_prefix(source: String, off: Int) -> String {
  let (line, col) = offset_to_line_col(source, off)
  String::concat("line ", String::concat(__to_string(line), String::concat(":", String::concat(__to_string(col), ": "))))
}

/// Build a `line L:colC-E: ` RANGE prefix from a (start, end) char-offset span.
/// When start and end fall on the same source line this carries the exact end
/// column so the LSP can highlight the precise token (incl. qualified names);
/// when end is on a later line (or not greater than start) it degrades to the
/// point prefix. Backward compatible: `line L:` still leads, so existing
/// `grep -F "line N:"` assertions keep matching. String::concat only.
fn offset_line_col_range_prefix(source: String, start: Int, endo: Int) -> String {
  let (l1, c1) = offset_to_line_col(source, start)
  let (l2, c2) = offset_to_line_col(source, endo)
  if l1 == l2 && endo > start {
    String::concat("line ", String::concat(__to_string(l1), String::concat(":", String::concat(__to_string(c1), String::concat("-", String::concat(__to_string(c2), ": "))))))
  } else {
    offset_line_col_prefix(source, start)
  }
}

/// Parse a non-negative decimal integer from msg[start..end). Returns -1 if the
/// span is empty or contains a non-digit (callers then fall through to the text
/// heuristic).
fn parse_offset_digits(msg: String, start: Int, end: Int) -> Int {
  if end <= start {
    -1
  } else {
    let mut i = start
    let mut acc = 0
    let mut ok = true
    while ok && i < end {
      let c = String::char_code_at(msg, i)
      if c >= '0' && c <= '9' {
        acc = acc * 10 + (c - '0')
        i = i + 1
      } else {
        ok = false
      }
    }
    if ok {
      acc
    } else {
      -1
    }
  }
}

/// Decode (and ALWAYS strip) the ` [@off=N]` marker the checker may have
/// appended. If N is a valid in-range offset, prefix the stripped message with
/// its exact `line:col`. Otherwise strip the marker and fall through to the
/// existing first-occurrence heuristics on the cleaned message. If no marker is
/// present, returns msg unchanged.
export fn locate_type_error(source: String, msg: String) -> String {
  let marker = " [@off="
  let mi = String::index_of(msg, marker)
  if mi < 0 {
    locate_type_error_heuristic(source, msg)
  } else {
    let inner_start = mi + String::length(marker)
    let rel_end = String::index_of(String::substring(msg, inner_start, String::length(msg)), "]")
    if rel_end < 0 {
      // Malformed marker (no closing `]`): strip from the marker onward.
      locate_type_error_heuristic(source, String::substring(msg, 0, mi))
    } else {
      let close = inner_start + rel_end
      // inner is `N` (start only) or `N:M` (start:end). Split on `:`.
      let inner = String::substring(msg, inner_start, close)
      let colon = String::index_of(inner, ":")
      let n = if colon < 0 {
        parse_offset_digits(inner, 0, String::length(inner))
      } else {
        parse_offset_digits(inner, 0, colon)
      }
      let m = if colon < 0 {
        -1
      } else {
        parse_offset_digits(inner, colon + 1, String::length(inner))
      }
      // Strip the full ` [@off=...]` segment (marker .. closing `]` inclusive).
      let stripped = String::concat(String::substring(msg, 0, mi), String::substring(msg, close + 1, String::length(msg)))
      let slen = String::length(source)
      if n >= 0 && n < slen {
        if m > n && m <= slen {
          String::concat(offset_line_col_range_prefix(source, n, m), stripped)
        } else {
          String::concat(offset_line_col_prefix(source, n), stripped)
        }
      } else {
        locate_type_error_heuristic(source, stripped)
      }
    }
  }
}

/// --- #906 Phase 1: module job / outcome seam ----------------------------
///
/// Phase 2 hands one module at a time to a worker that cannot touch the
/// filesystem or the driver's accumulators. This splits the existing
/// per-module work along exactly that line, with no parallelism and no
/// change in behaviour:
///
///   driver  resolves dependency environments (the only Fs the work needs)
///           and packs them into a ModuleJob value
///   worker  check_module : ModuleJob -> ModuleOutcome, no Fs row
///   driver  commit_module_outcome performs every write
///
/// check_module still carries `Error` because parse errors are not yet
/// values -- only type errors are. Making parse diagnostics part of
/// ModuleOutcome would change today's messages, so it is left to the phase
/// that also introduces the canonical diagnostic ordering.
/// ModuleJob is defined TRANSPARENTLY in this package's contract
/// (index.vpkg), not here -- the perceus/ PerceusAction precedent. Its field
/// layout is the worker contract itself, so it belongs in the contract
/// rather than being an opaque handle; record literals and field access
/// resolve from impl units against the contract definition.
export enum ModuleOutcome {
  Checked(String, String, TypeEnv);
  Diagnosed(String, Array[String])
}

/// Pure module check. No Fs: the dependency environments it needs are
/// already values inside the job.
export fn check_module(job: ModuleJob) -> ModuleOutcome with { Error } {
  // Parse stays OUTSIDE the handler below: parse errors currently
  // propagate verbatim, while type errors get located and path-prefixed.
  // Folding both into one handler would relabel every parse diagnostic.
  let stmts = parse_program_with_path(job.path, job.source)
  let import_env = build_import_env(stmts, dir_of_path(job.path), job.dep_envs)
  // The CANONICAL fingerprint, computed the same way the serial walk
  // computes it (build_fingerprint, same file) from the same inputs: this
  // module's own source and each dependency's fingerprint in declaration
  // order. A worker that invented its own cache key -- or trusted one
  // handed to it -- could publish a checked environment that the serial
  // driver would never look up, which would make a parallel pre-check pass
  // silently do nothing.
  let fingerprint = build_fingerprint(job.source, job.dep_fps)
  handle {
    let checked_env = match import_env {
      EnvEmpty => check_program(stmts),
      _ => check_program_with_env(stmts, import_env)
    }
    Checked(job.path, fingerprint, checked_env)
  } with Error {
    Throw(msg) => Diagnosed(job.path, [
      String::concat(String::concat(job.path, ": "), locate_type_error(job.source, msg))
    ])
  }
}

/// Coordinator-owned commit. Every filesystem and accumulator write for a
/// module happens here and nowhere else.
fn commit_module_outcome(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, job: ModuleJob, outcome: ModuleOutcome) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {
  match outcome {
    // Diagnostics are values as far as the worker is concerned, but the
    // driver still fails fast on the first one so the observable behaviour
    // is byte-identical to the pre-Phase-1 compiler. Collecting them into
    // a canonical set is Phase 2's job.
    Diagnosed(_, diags) => if Array::length(diags) > 0 {
      throw(Array::get(diags, 0))
    } else {
      throw(String::concat(job.path, ": type error"))
    },
    Checked(path, fingerprint, checked_env) => {
      store_persistent_type_env(fingerprint, checked_env)
      if Array::length(job.deps) == 0 {
        Fs::write_file(persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(job.source)), persistent_leaf_fingerprint_text(fingerprint))
      } else {
        ()
      }
      let next_env_cache = upsert_env_cache(env_cache, path, checked_env)
      let next_db = ripple_record_eval(rdb, path, fingerprint, job.deps)
      (fingerprint, next_db, next_env_cache, dep_source_cache, parse_count)
    }
  }
}

/// --- #906 Phase 2: worker entry ------------------------------------------
///
/// The transport boundary. A worker is handed a JOB DIRECTORY and may touch
/// nothing else -- it is the whole preopen sandbox:
///
///   <dir>/job.txt      version / path / fingerprint / dep rows
///   <dir>/source.vibe  the module source, verbatim
///   <dir>/dep<i>.env   dependency i's serialized public environment
///   <dir>/outcome.txt  written here: "ok" or "diag"
///   <dir>/env.out      written here on ok: the checked environment
///   <dir>/diag.txt     written here on diag: one diagnostic per line
///
/// This is what docs/compiler-parallelism.md calls the missing in-memory
/// ModuleJob -> ModuleArtifact API. Without it a worker could only check
/// leaf modules: the type-env cache is keyed by a fingerprint derived from
/// the whole transitive source snapshot, which is precisely what a worker
/// must not see, so a worker can never look its own dependencies up. Here
/// the driver hands them over as values instead.
///
/// `path` in job.txt is the module's LOGICAL path, not the materialized
/// temp file. It never gets opened -- it is the base directory that
/// build_import_env resolves each import against, so the dep<i>.env entries
/// bind to the same names they would in a serial compile. Getting this
/// wrong does not fail loudly; it silently binds imports to nothing.
fn job_dir_path(dir: String, name: String) -> String {
  String::concat(String::concat(dir, "/"), name)
}

/// `dep` rows carry the dependency's path AND its already-computed
/// fingerprint (`dep\t<path>\t<fingerprint>`) -- three columns, unlike every
/// other row. There is deliberately no `fingerprint` row for the job's OWN
/// identity: that is check_module's output (via build_fingerprint), never
/// an input a caller could get wrong or fail to keep in sync.
fn parse_job_rows(job_text: String) -> (String, Array[String], Array[String]) with { Error } {
  let lines = String::split(normalize_persistent_cache_text(job_text), "\n")
  let len = Array::length(lines)
  let deps = empty_stack()
  let dep_fps = empty_stack()
  let mut path = ""
  let mut version_ok = false
  let mut i = 0
  while i < len {
    let line = Array::get(lines, i)
    if String::length(line) == 0 {
      ()
    } else {
      let parts = String::split(line, "\t")
      let plen = Array::length(parts)
      let key = if plen > 0 {
        Array::get(parts, 0)
      } else {
        ""
      }
      if key == "dep" {
        let dep_path = Array::get(parts, 1)
        let dep_fp = Array::get(parts, 2)
        if plen != 3 {
          throw(String::concat("invalid module job dep row (want path + fingerprint): ", line))
        } else if String::length(dep_path) == 0 || String::length(dep_fp) == 0 {
          // Codex review (#1126): a row with an empty path or fingerprint
          // column (e.g. a trailing tab, `dep\t/dep.vibe\t`) still has 3
          // parts and would otherwise pass the column-count check above.
          // An empty fingerprint folds into build_fingerprint the same way
          // regardless of which dependency revision produced it, so two
          // different revisions would silently collide on one fingerprint
          // instead of the job being rejected as malformed.
          throw(String::concat("invalid module job dep row (empty path or fingerprint): ", line))
        } else {
          Array::push(deps, dep_path)
          Array::push(dep_fps, dep_fp)
        }
      } else if plen != 2 {
        throw(String::concat("invalid module job row: ", line))
      } else {
        let value = Array::get(parts, 1)
        if key == "version" {
          if value == "1" {
            version_ok = true
          } else {
            throw(String::concat("unsupported module job version: ", value))
          }
        } else if key == "path" {
          path = value
        } else {
          throw(String::concat("unknown module job row: ", line))
        }
      }
    }
    i = i + 1
  }
  if !version_ok {
    throw("module job is missing its version row")
  } else if String::length(path) == 0 {
    throw("module job is missing its path row")
  } else {
    (path, deps, dep_fps)
  }
}

export fn run_module_job_dir(dir: String) -> Unit with { Error, Fs } {
  let (path, deps, dep_fps) = parse_job_rows(Fs::read_file(job_dir_path(dir, "job.txt")))
  let source = Fs::read_file(job_dir_path(dir, "source.vibe"))
  let dep_envs = array_empty()
  let job_dep_fps = array_empty()
  let mut i = 0
  let dlen = Array::length(deps)
  while i < dlen {
    let dep_path = Array::get(deps, i)
    Array::push(job_dep_fps, (dep_path, Array::get(dep_fps, i)))
    let env_file = job_dir_path(dir, String::concat(String::concat("dep", __to_string(i)), ".env"))
    if Fs::exists(env_file) {
      match parse_persistent_type_env(Fs::read_file(env_file)) {
        Some(env) => Array::push(dep_envs, (dep_path, env)),
        // A dep<i>.env that exists but does not decode is an
        // INFRASTRUCTURE failure, not "no environment". Skipping it would
        // drop the dependency's interface and make its imports lenient
        // again, so a truncated file would turn real type errors into a
        // clean check -- the silent-success mode this whole transport is
        // built to avoid. (parse_persistent_type_env returns None only for
        // a missing version header, i.e. an empty or truncated file; a
        // malformed row already throws.)
        None => throw(String::concat("module job: unreadable dependency environment: ", env_file))
      }
    } else {
      ()
    }
    i = i + 1
  }
  let job = ModuleJob::{
    path: path,
    source: source,
    deps: deps,
    dep_fps: job_dep_fps,
    dep_envs: dep_envs
  }
  // Parse errors are still an `Error` out of check_module (see the Phase 1
  // note above). At the transport boundary they have to become a value
  // regardless -- a worker that throws is an infrastructure failure, which
  // the coordinator treats as fatal rather than as a compiler diagnostic.
  let outcome = handle {
    check_module(job)
  } with Error {
    Throw(msg) => Diagnosed(path, [
      msg
    ])
  }
  // outcome.txt is written LAST in both arms. It is the commit marker: a
  // coordinator that sees it knows env.out / diag.txt are already complete,
  // so a worker killed mid-write leaves an obviously unfinished job dir
  // rather than a plausible-looking wrong answer.
  match outcome {
    Checked(_, fingerprint, env) => {
      Fs::write_file(job_dir_path(dir, "env.out"), persistent_type_env_cache_text(env))
      // The module's own identity, as check_module computed it -- an
      // OUTPUT of this job, needed by the coordinator to build the NEXT
      // job's `dep\t<path>\t<fingerprint>` row for this module's
      // dependents, and eventually to publish this environment at the
      // real persistent-cache path a serial compile would look under.
      Fs::write_file(job_dir_path(dir, "fingerprint.out"), fingerprint)
      Fs::write_file(job_dir_path(dir, "outcome.txt"), "ok")
    },
    Diagnosed(_, diags) => {
      Fs::write_file(job_dir_path(dir, "diag.txt"), String::join(diags, "\n"))
      Fs::write_file(job_dir_path(dir, "outcome.txt"), "diag")
    }
  }
}

/// #906 Phase 2 (real-build wiring): the batch publish counterpart to
/// run_module_job_dir. `manifest.txt` holds one `<fingerprint>\t<envfile>`
/// row per module a host driver wants published; `<envfile>` is read
/// relative to `dir` and written VERBATIM to the real persistent-cache path
/// -- it is already `persistent_type_env_cache_text`-encoded, because it is
/// literally a copy of some job dir's `env.out` (see run_module_job_dir
/// above), so there is nothing to parse or re-encode here. Two publishers
/// racing on the same fingerprint is a same-value collision, not a
/// conflict: the path is content-addressed, and a checker producing two
/// different envs for one fingerprint would already violate the
/// jobs=1/2/4 byte-identity gate elsewhere.
fn parse_publish_manifest_rows(text: String) -> Array[(String, String)] with { Error } {
  let lines = String::split(normalize_persistent_cache_text(text), "\n")
  let rows = array_empty()
  let mut i = 0
  let len = Array::length(lines)
  while i < len {
    let line = Array::get(lines, i)
    if String::length(line) == 0 {
      ()
    } else {
      let parts = String::split(line, "\t")
      if Array::length(parts) != 2 {
        throw(String::concat("invalid publish manifest row (want fingerprint + envfile): ", line))
      } else {
        let fingerprint = Array::get(parts, 0)
        let env_file = Array::get(parts, 1)
        if String::length(fingerprint) == 0 || String::length(env_file) == 0 {
          throw(String::concat("invalid publish manifest row (empty fingerprint or envfile): ", line))
        } else {
          Array::push(rows, (fingerprint, env_file))
        }
      }
    }
    i = i + 1
  }
  rows
}

export fn run_publish_env_cache_dir(dir: String) -> Unit with { Error, Fs } {
  let rows = parse_publish_manifest_rows(Fs::read_file(job_dir_path(dir, "manifest.txt")))
  let mut i = 0
  let len = Array::length(rows)
  while i < len {
    let (fingerprint, env_file) = Array::get(rows, i)
    let env_text = Fs::read_file(job_dir_path(dir, env_file))
    Fs::write_file(persistent_type_env_cache_path(fingerprint), env_text)
    i = i + 1
  }
}

/// `fingerprint` is the already-folded build_fingerprint(source, dep_fps)
/// every call site computed to decide whether to call this function at all
/// (the Fs::exists / ripple_record_eval fast path below needs that folded
/// value, not the raw pairs). `dep_fps` is the SAME per-dependency pairs
/// that fold produced, passed through unfolded too so the ModuleJob built
/// below carries the real inputs check_module needs to compute (and thereby
/// cross-check) that identical fingerprint itself, the same way a worker
/// would -- one canonical computation, not a value trusted from the caller.
fn finish_typecheck_fs_impl(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, deps: Array[String], dep_fps: Array[(String, String)], fingerprint: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {
  if Fs::exists(persistent_type_env_cache_path(fingerprint)) {
    let next_db = ripple_record_eval(rdb, path, fingerprint, deps)
    (fingerprint, next_db, env_cache, dep_source_cache, parse_count)
  } else {
    let import_env_cache = ensure_env_cache_for_paths(rdb, env_cache, deps)
    let job = ModuleJob::{
      path: path,
      source: source,
      deps: deps,
      dep_fps: dep_fps,
      dep_envs: import_env_cache
    }
    let outcome = check_module(job)
    commit_module_outcome(rdb, import_env_cache, dep_source_cache, parse_count + 1, job, outcome)
  }
}

fn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String) -> Array[String] {
  // Iterative push: previously the recursive `Array::concat(acc, [x])`
  // copied the full prefix on each new dep — O(N^2) for files with
  // many imports.
  let out = empty_stack()
  let mut i = 0
  let len = Array::length(stmts)
  while i < len {
    match Array::get(stmts, i) {
      SImport(raw_path, _) => if String::length(raw_path) > 0 {
        let resolved = resolve_import_path(base_dir, raw_path)
        if !contains_str(out, resolved) {
          Array::push(out, resolved)
        }
      },
      SReExport(raw_path, _) => if String::length(raw_path) > 0 {
        let resolved = resolve_import_path(base_dir, raw_path)
        if !contains_str(out, resolved) {
          Array::push(out, resolved)
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn load_or_parse_deps_for_source_fs(dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {
  match load_persistent_dep_list(path, source) {
    Some(deps) => (deps, upsert_string_pair(dep_source_cache, path, source), parse_count),
    None => {
      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)
      (deps, upsert_string_pair(dep_source_cache, path, source), next_parse_count)
    }
  }
}

fn resolve_deps_for_source_fs(rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {
  match lookup_string_pair(dep_source_cache, path) {
    Some(cached_source) =>
    if cached_source == source {
      match ripple_get_deps(rdb, path) {
        Some(deps) => (deps, dep_source_cache, parse_count),
        None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)
      }
    } else {
      load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)
    },
    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)
  }
}

/// #1239 step 4(A), on the real fs path: the coordinator-side upfront pass.
///
/// Walks the import graph from `root` ONCE and records, per reachable module,
/// either the persistent leaf fingerprint it found or the module's resolved
/// dependency list. The walk that follows looks both up here instead of
/// paying for them a second time, so this is a REPLACEMENT for work
/// the walk used to do inline, not an extra pass.
///
/// The three short-circuits are the same three the walk applies, in the same
/// order -- no source in the db (the `missing:` arm), a reusable cached
/// fingerprint, a persistent leaf fingerprint -- and evaluating them here
/// gives the same answers the walk gets: nothing mutates module M's db or
/// dep-cache entries before M's own first visit, and the walk resolves each
/// module's deps exactly once too (a module reached a second time returns on
/// its now-cached fingerprint). The queue dedupes by path for the same reason.
///
/// A module left OUT of `edges` -- missing, or short-circuited -- is a leaf
/// to plan_module_order (mo_deps_of), which is what makes those arms terminal
/// for scheduling as well as for the walk.
fn plan_import_graph_fs(rdb: RippleDb, dep_source_cache: Array[(String, String)], parse_count: Int, root: String) -> (Array[(String, String)], Array[(String, Array[String])], Int, Array[(String, String)]) with { Error, Fs } {
  let leaf_fps = empty_dep_fps()
  let plan_diags: Array[(String, String)] = [
  ]
  let edges: Array[(String, Array[String])] = [
  ]
  let seen = empty_stack()
  let queue = empty_stack()
  // Private copy -- see copy_string_pairs. The predicates below still read
  // the caller's cache, because what they must reproduce is the state the
  // walk sees on a module's FIRST visit; only the resolver gets the copy.
  let scratch_cache = copy_string_pairs(dep_source_cache)
  let mut pc = parse_count
  Array::push(seen, root)
  Array::push(queue, root)
  let mut qi = 0
  while qi < Array::length(queue) {
    let path = Array::get(queue, qi)
    qi = qi + 1
    match ripple_get_source(rdb, path) {
      None => (),
      Some(source) => {
        let reusable = if dep_source_cache_is_current(dep_source_cache, path, source) {
          match ripple_get_fingerprint(rdb, path) {
            Some(_) => true,
            None => false
          }
        } else {
          false
        }
        if reusable {
          ()
        } else {
          match load_persistent_leaf_fingerprint(path, source) {
            Some(leaf_fingerprint) => Array::push(leaf_fps, (path, leaf_fingerprint)),
            None => {
              // Codex review P2: resolving a module's imports PARSES it, so a
              // syntax error raises here -- during planning, before the walk's
              // per-step handler exists. Left alone that made parse errors
              // fail-fast even while collecting: two malformed leaves reported
              // one diagnostic, because planning aborted on the first.
              //
              // Collected the same way a step's diagnostic is, and with the
              // same two exclusions (fail-fast mode, and `type_db:` internal
              // invariants). A module that fails to plan gets no edge entry and
              // no dependencies explored -- it is a leaf to the schedule, and
              // the caller seeds it into `failed` so its importers are blocked
              // rather than cascading.
              let plan_raised = empty_stack()
              let (deps_raw, _, next_pc) = handle {
                resolve_deps_for_source_fs(rdb, scratch_cache, path, source, pc)
              } with Error {
                Throw(msg) => {
                  Array::push(plan_raised, msg)
                  (empty_stack(), scratch_cache, pc)
                }
              }
              if Array::length(plan_raised) > 0 {
                let msg = Array::get(plan_raised, 0)
                if !collect_module_diagnostics() || String::starts_with(msg, "type_db: ") {
                  throw(msg)
                } else {
                  Array::push(plan_diags, (path, msg))
                }
              } else {
                ()
              }
              let deps = copy_string_array(deps_raw)
              pc = next_pc
              if Array::length(plan_raised) > 0 {
                ()
              } else {
                Array::push(edges, (path, deps))
              }
              let dlen = Array::length(deps)
              let mut i = 0
              while i < dlen {
                let dep = Array::get(deps, i)
                if contains_str(seen, dep) {
                  ()
                } else {
                  Array::push(seen, dep)
                  Array::push(queue, dep)
                }
                i = i + 1
              }
            }
          }
        }
      }
    }
  }
  (leaf_fps, edges, pc, plan_diags)
}

/// The dep list `plan_import_graph_fs` recorded for `path`, or None when it
/// recorded none. Returns a copy for the same reason graph.vibe's mo_deps_of
/// does: the caller takes ownership of the list it folds fingerprints over.
fn plan_deps_of(plan_edges: Array[(String, Array[String])], path: String) -> Option[Array[String]] {
  let n = Array::length(plan_edges)
  let mut i = 0
  let mut found: Option[Array[String]] = None
  while i < n {
    let e = Array::get(plan_edges, i)
    if e.0 == path {
      found = Some(copy_string_array(e.1))
      i = n
    } else {
      i = i + 1
    }
  }
  found
}

/// The leaf-fingerprint arm: a module whose persistent leaf cache is valid is
/// recorded with no deps at all and needs no checking.
fn commit_leaf_fingerprint_fs(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, leaf_fingerprint: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {
  write_persistent_dep_list_if_missing(path, source, empty_stack())
  let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)
  let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())
  (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)
}

/// One module's step, once its dependency list is known and every dependency
/// already has a fingerprint. Folds the dependency fingerprints in
/// DECLARATION order (build_fingerprint folds them as a sequence, not a set),
/// then either reuses the cached fingerprint or checks and commits.
fn commit_with_deps_fs(fps: Array[(String, String)], rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, deps: Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {
  write_persistent_dep_list_if_missing(path, source, deps)
  let dlen = Array::length(deps)
  let dep_fps = empty_dep_fps()
  let mut i = 0
  while i < dlen {
    let dep_path = Array::get(deps, i)
    match lookup_string_pair(fps, dep_path) {
      Some(dep_fp) => Array::push(dep_fps, (dep_path, dep_fp)),
      // Unreachable: rank order guarantees every dependency was stepped
      // before its importer. Loud rather than folding a placeholder into the
      // fingerprint, which would key the persistent cache on a lie.
      None => throw(String::concat("type_db: dependency stepped out of rank order: ", dep_path))
    }
    i = i + 1
  }
  let fingerprint = build_fingerprint(source, dep_fps)
  match ripple_get_fingerprint(rdb, path) {
    Some(cached_fp) =>
    if cached_fp == fingerprint {
      (fingerprint, rdb, env_cache, dep_source_cache, parse_count)
    } else {
      finish_typecheck_fs_impl(rdb, env_cache, dep_source_cache, parse_count, path, source, deps, dep_fps, fingerprint)
    },
    None =>
    finish_typecheck_fs_impl(rdb, env_cache, dep_source_cache, parse_count, path, source, deps, dep_fps, fingerprint)
  }
}

/// True when `path`'s entry in the ripple db can be reused as-is: the source
/// the dep cache was built from still matches the source in the db. The three
/// arms of the old nested match collapsed to this one predicate because two
/// of them (source changed / never seen) did exactly the same thing.
fn dep_source_cache_is_current(dep_source_cache: Array[(String, String)], path: String, source: String) -> Bool {
  match lookup_string_pair(dep_source_cache, path) {
    Some(cached_source) => cached_source == source,
    None => false
  }
}

/// One module of the schedule. The same three short-circuits the plan applied
/// (no source in the db, a reusable cached fingerprint, a persistent leaf
/// fingerprint), in the same order, then the dep fold.
///
/// This is where the walk stopped being a recursion. It reads state and hands
/// back the next state; it never reaches into another module's step. That is
/// the property step 4(D) needs: the old DFS threaded four state values
/// through dependencies IN SEQUENCE (dep[1] received dep[0]'s output
/// RippleDb), so siblings could not be dispatched independently no matter
/// what the host could do.
fn step_module_fs(plan_leaf_fps: Array[(String, String)], plan_edges: Array[(String, Array[String])], fps: Array[(String, String)], rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {
  match ripple_get_source(rdb, path) {
    None => (String::concat("missing:", path), rdb, env_cache, dep_source_cache, parse_count),
    Some(source) => {
      let reusable = if dep_source_cache_is_current(dep_source_cache, path, source) {
        ripple_get_fingerprint(rdb, path)
      } else {
        None
      }
      match reusable {
        // The fingerprint is enough for dependency fingerprint folding.
        // Loading the env here caused shared leaf modules to re-read their
        // persistent leaf cache every time they were reached before a parent
        // needed their bindings.
        Some(cached_fingerprint) => (cached_fingerprint, rdb, env_cache, dep_source_cache, parse_count),
        None =>
        match lookup_string_pair(plan_leaf_fps, path) {
          Some(leaf_fingerprint) =>
          commit_leaf_fingerprint_fs(rdb, env_cache, dep_source_cache, parse_count, path, source, leaf_fingerprint),
          None =>
          match plan_deps_of(plan_edges, path) {
            Some(planned_deps) =>
            commit_with_deps_fs(fps, rdb, env_cache, upsert_string_pair(dep_source_cache, path, source), parse_count, path, source, planned_deps),
            // Unreachable: every path in the schedule was either given an
            // edge entry by the plan or interned as some planned module's
            // dependency, and the three short-circuits above are the plan's
            // own. A module that reaches here has no dependency fingerprints
            // to fold, so there is nothing to fall back TO now that the walk
            // does not recurse -- say so instead of inventing one.
            None => throw(String::concat("type_db: module missing from the import plan: ", path))
          }
        }
      }
    }
  }
}

/// Index of `p` in `items`, or -1. Plain linear scan: the caller runs it once
/// per module over a list of the same length, and a project the size of this
/// compiler's own manifest is ~209 modules.
fn module_plan_index_of(items: Array[String], p: String) -> Int {
  let n = Array::length(items)
  let mut i = 0
  let mut found = 0 - 1
  while found < 0 && i < n {
    if Array::get(items, i) == p {
      found = i
    } else {
      i = i + 1
    }
  }
  found
}

/// #1239 step 4(D) groundwork: discover a project's WHOLE import graph, and
/// its canonical schedule, inside one compiler process.
///
/// VIBE_LIST_DEPS answers "what does this ONE file import", so a host driver
/// building the parallel pre-warm's DAG has to spawn it once per module --
/// and on a project the size of this compiler's own manifest that discovery
/// loop is what dominates the whole parallel path's wall time, independent of
/// how many jobs the later check phase gets (#1168, see discoverProject in
/// scripts/parallel_frontend_warm.mjs). This does the same BFS in-process.
///
/// The order comes from @vibe/graph's plan_module_order -- the same function
/// the serial walk's own upfront plan uses since #1239 step 4(A)
/// (runtime/typecheck_fs.vibe) -- so the host dispatches the schedule the
/// compiler itself planned instead of one it re-derived, and an import cycle
/// is rejected here with the identical diagnostic rather than surfacing later
/// as a driver that never makes progress.
///
/// Returns the manifest text plus, positionally, each module's INGESTED
/// source: `ingest_source_text_fs` can prepend a directory-shared import a
/// raw .vibe file never had, or rewrite a contract into its facade entirely,
/// and check_module parses that text -- never the raw bytes. Deriving deps
/// from one and handing back the other is #1168's exact bug, so both come
/// off the same `ingested` string here.
export fn module_plan_manifest_fs(entry_path: String) -> (String, Array[String]) with { Error, Fs } {
  // `paths` doubles as the BFS queue: discovery pushes to it, `qi` walks it.
  let paths: Array[String] = [
  ]
  let deps_of: Array[Array[String]] = [
  ]
  let sources: Array[String] = [
  ]
  Array::push(paths, entry_path)
  let mut qi = 0
  while qi < Array::length(paths) {
    let p = Array::get(paths, qi)
    qi = qi + 1
    if !Fs::exists(p) {
      throw(String::concat("module plan: cannot read module: ", p))
    } else {
      ()
    }
    let ingested = ingest_source_text_fs(p, Fs::read_file(p))
    let (deps, _exports, _parse_count) = load_or_parse_module_header_fs(p, ingested, 0)
    Array::push(sources, ingested)
    Array::push(deps_of, deps)
    let dlen = Array::length(deps)
    let mut i = 0
    while i < dlen {
      let d = Array::get(deps, i)
      if module_plan_index_of(paths, d) >= 0 {
        ()
      } else {
        Array::push(paths, d)
      }
      i = i + 1
    }
  }
  let edges: Array[(String, Array[String])] = [
  ]
  let mut e = 0
  while e < Array::length(paths) {
    Array::push(edges, (Array::get(paths, e), Array::get(deps_of, e)))
    e = e + 1
  }
  let (order, ranks) = plan_module_order(edges, entry_path)
  let buf = StringBuilder::new()
  StringBuilder::push(buf, "version\t1\n")
  let ordered_sources: Array[String] = [
  ]
  let n = Array::length(order)
  let mut k = 0
  while k < n {
    let p = Array::get(order, k)
    let src_index = module_plan_index_of(paths, p)
    let index_text = __to_string(k)
    StringBuilder::push(buf, "module\t")
    StringBuilder::push(buf, index_text)
    StringBuilder::push(buf, "\t")
    StringBuilder::push(buf, __to_string(Array::get(ranks, k)))
    StringBuilder::push(buf, "\t")
    StringBuilder::push(buf, p)
    StringBuilder::push(buf, "\n")
    Array::push(ordered_sources, Array::get(sources, src_index))
    // Declaration order, duplicates KEPT: the driver derives both its
    // deduped dependency set and its dependencyOccurrences list from this,
    // exactly as it does from VIBE_LIST_DEPS's output today.
    let deps = Array::get(deps_of, src_index)
    let dlen = Array::length(deps)
    let mut i = 0
    while i < dlen {
      StringBuilder::push(buf, "dep\t")
      StringBuilder::push(buf, index_text)
      StringBuilder::push(buf, "\t")
      StringBuilder::push(buf, Array::get(deps, i))
      StringBuilder::push(buf, "\n")
      i = i + 1
    }
    k = k + 1
  }
  (StringBuilder::freeze(buf), ordered_sources)
}

/// True when one of `path`'s planned dependencies is in `failed` -- i.e. was
/// itself diagnosed, or was blocked by this same rule.
///
/// A blocked module cannot be checked at all: its dependency has no
/// fingerprint to fold into its cache key and no environment to import. It
/// therefore contributes NO diagnostic of its own. Reporting one would be a
/// cascade -- "unknown binding x", once per importer -- which is precisely the
/// noise a canonical diagnostic set exists to be free of.
///
/// Transitivity comes from the wave order: blocked modules are pushed onto
/// `failed` too, and every dependency of a module was stepped in a strictly
/// earlier wave, so `failed` is already complete for `path` when this runs.
fn module_is_blocked(plan_edges: Array[(String, Array[String])], failed: Array[String], path: String) -> Bool {
  if Array::length(failed) == 0 {
    false
  } else {
    match plan_deps_of(plan_edges, path) {
      // No edge entry means the plan short-circuited this module (missing
      // source, reusable fingerprint, persistent leaf cache) -- it has no
      // dependencies to be blocked by.
      None => false,
      Some(deps) => {
        let n = Array::length(deps)
        let mut i = 0
        let mut blocked = false
        while i < n && !blocked {
          if contains_str(failed, Array::get(deps, i)) {
            blocked = true
          } else {
            i = i + 1
          }
        }
        blocked
      }
    }
  }
}

/// Canonical order for two collected diagnostics: normalized module path
/// first, then the message.
///
/// #1239 step 5 specifies path -> source start/end -> diagnostic code ->
/// message. Only the first and last of those exist today: check_module emits
/// AT MOST ONE diagnostic per module (its Diagnosed arm builds a one-element
/// array), so within a path there is nothing to break ties between, and there
/// are no diagnostic codes yet. The message tiebreak is here anyway to keep
/// the order TOTAL, so the day a worker returns several diagnostics for one
/// module they sort deterministically instead of silently inheriting
/// collection order.
///
/// str_lt, not `<`: canonical ordering must be true lexicographic. The builtin
/// compares length first, which would make the order depend on path length
/// (CLAUDE.md documents that footgun; @vibe/graph's plan_module_order avoids
/// it the same way).
fn module_diag_lt(a: (String, String), b: (String, String)) -> Bool {
  if a.0 == b.0 {
    str_lt(a.1, b.1)
  } else {
    str_lt(a.0, b.0)
  }
}

/// Insertion sort into canonical order. One diagnostic per failing module, and
/// a build with enough failing modules for O(N^2) to matter has bigger
/// problems than the sort.
fn sort_module_diagnostics(diags: Array[(String, String)]) -> Array[(String, String)] {
  let out: Array[(String, String)] = [
  ]
  let n = Array::length(diags)
  let mut i = 0
  while i < n {
    let entry = Array::get(diags, i)
    Array::push(out, entry)
    let mut j = Array::length(out) - 1
    while j > 0 && module_diag_lt(entry, Array::get(out, j - 1)) {
      Array::set(out, j, Array::get(out, j - 1))
      Array::set(out, j - 1, entry)
      j = j - 1
    }
    i = i + 1
  }
  out
}

/// The collected set as one error string: canonical order, exact duplicates
/// dropped, one diagnostic per line. A single collected diagnostic is
/// therefore byte-identical to what the fail-fast walk would have thrown --
/// which is what makes collection mode a superset of the default rather than
/// a different output format.
/// The `project` half of a scheduler trace: one row per planned module, with
/// its rank and its dependency list. This IS Scheduler.lean's `Project` --
/// `dependencies` and `rank` -- serialized, so the oracle can check
/// `dependencyRankLt` against the same graph the walk actually stepped rather
/// than against one it re-derived.
fn scheduler_trace_project(buf: StringBuilder, order: Array[String], ranks: Array[Int], plan_edges: Array[(String, Array[String])]) -> Unit {
  let n = Array::length(order)
  let mut i = 0
  while i < n {
    let p = Array::get(order, i)
    StringBuilder::push(buf, "project\t")
    StringBuilder::push(buf, p)
    StringBuilder::push(buf, "\t")
    StringBuilder::push(buf, __to_string(Array::get(ranks, i)))
    // A module the plan short-circuited (missing source, reusable
    // fingerprint, persistent leaf cache) has no edge entry and so no
    // dependencies -- which is exactly what it is to the scheduler: a leaf
    // that is Ready from the start.
    match plan_deps_of(plan_edges, p) {
      None => (),
      Some(deps) => {
        let dlen = Array::length(deps)
        let mut d = 0
        while d < dlen {
          StringBuilder::push(buf, "\t")
          StringBuilder::push(buf, Array::get(deps, d))
          d = d + 1
        }
      }
    }
    StringBuilder::push(buf, "\n")
    i = i + 1
  }
}

fn join_module_diagnostics(diags: Array[(String, String)]) -> String {
  let sorted = sort_module_diagnostics(diags)
  let msgs = array_empty()
  let n = Array::length(sorted)
  let mut i = 0
  while i < n {
    let entry = Array::get(sorted, i)
    Array::push(msgs, entry.1)
    i = i + 1
  }
  String::join(dedupe_diagnostics(msgs), "\n")
}

/// The import-DAG walk, as the wave loop a coordinator dispatches from
/// (#1239 step 4(D)).
///
/// plan_import_graph_fs resolves the graph and plan_module_order ranks it
/// (step 4(A), both already in place); this consumes that order instead of
/// re-deriving one by recursive descent. Every module of rank k depends only
/// on modules of rank < k, so a rank is a WAVE: its modules are independent
/// of each other by construction, and each one's dependency fingerprints are
/// already recorded by the time the wave runs.
///
/// What that buys, beyond the recursion going away (this compiler has
/// exhausted the wasm stack on a recursive whole-program walk before -- see
/// analyze_calls's #556 note in perceus/perceus.vibe): the remaining step
/// 4(D) blocker is gone. Dispatching a wave out-of-process is now a change to
/// the inner loop, not a restructuring of the walk.
///
/// #1259: the wave loop is also where diagnostics are COLLECTED rather than
/// fired off one at a time. A wave's modules are independent by construction,
/// so one of them being diagnosed says nothing about its siblings -- they
/// still have every input they need. Collection therefore falls out of the
/// wave structure: diagnose, mark the module failed, keep stepping the rest of
/// the wave, and skip only the modules that actually depend on a failure. See
/// collect_module_diagnostics (off by default).
///
/// dep_visit_order (the #906 Phase 0 nondeterminism probe, seeded by
/// VIBE_DEP_ORDER_SEED) now permutes the order WITHIN a wave rather than a
/// node's dependency visit order. That is the stronger property and the one
/// that matters: it is exactly the choice a parallel coordinator makes
/// differently from run to run, and scripts/dep_order_oracle.sh asserts the
/// compiled output is byte-identical across seeds regardless.
export fn ensure_fingerprint_fs_impl(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {
  let (plan_leaf_fps, plan_edges, planned_parse_count, plan_diags) = plan_import_graph_fs(rdb, dep_source_cache, parse_count, path)
  // #1239 step 4(A): an import cycle is rejected HERE -- before a single
  // module is checked, committed, or written to the persistent cache --
  // instead of incidentally, partway through the walk, on whichever module a
  // DFS happened to re-enter first.
  let (order, ranks) = plan_module_order(plan_edges, path)
  let fps = empty_dep_fps()
  let mut db = rdb
  let mut envc = env_cache
  let mut dsc = dep_source_cache
  let mut pc = planned_parse_count
  // #1259: empty unless collection is on, in which case `failed` holds every
  // module that was diagnosed OR blocked by one, and `diags` the (path,
  // message) pairs to sort at the end.
  let failed = empty_stack()
  let diags: Array[(String, String)] = [
  ]
  // A module that failed to PLAN (a syntax error in its own source -- see
  // plan_import_graph_fs) is already terminal: it has no dependency list, so
  // it is a leaf to the schedule and nothing about it can be checked. Seed it
  // as failed before the loop so the wave skips it and module_is_blocked
  // catches its importers. Always empty when collection is off, since planning
  // rethrows in that mode.
  let mut pdi = 0
  while pdi < Array::length(plan_diags) {
    let entry = Array::get(plan_diags, pdi)
    Array::push(failed, entry.0)
    Array::push(diags, entry)
    pdi = pdi + 1
  }
  // #1259 (#1239 step 8): the scheduler trace. Off unless
  // VIBE_SCHEDULER_TRACE named a file.
  let trace_path = scheduler_trace_path()
  let tracing = String::length(trace_path) > 0
  let trace = StringBuilder::new()
  if tracing {
    scheduler_trace_project(trace, order, ranks, plan_edges)
  } else {
    ()
  }
  let n = Array::length(order)
  let mut i = 0
  while i < n {
    // `order` is sorted by rank, so one wave is a contiguous run.
    let r = Array::get(ranks, i)
    let mut j = i
    while j < n && Array::get(ranks, j) == r {
      j = j + 1
    }
    let wave = j - i
    let visit = dep_visit_order(wave)
    let mut k = 0
    while k < wave {
      let m = Array::get(order, i + Array::get(visit, k))
      // `contains_str(failed, m)` first: a module that failed to plan is
      // already in `failed` and has no edge entry, so module_is_blocked alone
      // would let it through to a step that cannot succeed.
      if contains_str(failed, m) || module_is_blocked(plan_edges, failed, m) {
        Array::push(failed, m)
      } else {
        // Snapshots of the accumulators as of ENTRY to this module's step.
        // The handler needs values it can close over, and they are also the
        // right state to carry forward when the step raises: a module that
        // does not check commits nothing.
        let cur_db = db
        let cur_envc = envc
        let cur_dsc = dsc
        let cur_pc = pc
        let raised = empty_stack()
        let (fp, next_db, next_envc, next_dsc, next_pc) = handle {
          step_module_fs(plan_leaf_fps, plan_edges, fps, cur_db, cur_envc, cur_dsc, cur_pc, m)
        } with Error {
          Throw(msg) => {
            Array::push(raised, msg)
            (String::concat("diagnosed:", m), cur_db, cur_envc, cur_dsc, cur_pc)
          }
        }
        if Array::length(raised) > 0 {
          let msg = Array::get(raised, 0)
          // Re-raised OUTSIDE the handler, so this is ordinary propagation
          // and not a throw from within a handler body. Two cases never
          // become collected diagnostics:
          //
          //   - fail-fast mode, the default: identical message, identical
          //     partial state, raised one frame later than before
          //   - an internal invariant violation (the `type_db:` prefix, the
          //     two unreachable arms in step_module_fs / commit_with_deps_fs)
          //     -- infrastructure failure, not something the user's program
          //     said, so it must stay fatal even while collecting
          if !collect_module_diagnostics() || String::starts_with(msg, "type_db: ") {
            throw(msg)
          } else {
            Array::push(failed, m)
            Array::push(diags, (m, msg))
          }
        } else {
          db = next_db
          envc = next_envc
          dsc = next_dsc
          pc = next_pc
          Array::push(fps, (m, fp))
          // One Step.run, recorded where the result is PUBLISHED -- the same
          // point `BuildState.finish` sits at in the model. Recording it
          // before the step would let a trace claim a module completed that
          // then raised.
          //
          // Codex review P1: the fingerprint alone is NOT the JobResult. It is
          // build_fingerprint(source, dep_fps) -- a pure function of the source
          // graph, computed before the module is even checked -- so comparing
          // fingerprints across schedules compares content-addressed cache KEYS
          // that are schedule-independent by construction, and StoreCorrect
          // would have held even if two schedules produced different TypeEnvs.
          // The env hash is what makes that comparison mean anything: it is the
          // checked environment the module actually published, serialized the
          // same way commit_module_outcome writes it to the persistent cache.
          //
          // "-" is for the arms that publish no environment (a reusable cached
          // fingerprint, or a persistent leaf-fingerprint hit). Both are cache
          // hits, so on the cold cache dir the oracle uses they should be rare
          // -- scheduler_trace_oracle.sh fails if too many steps carry "-",
          // since a trace of all-"-" would be back to comparing keys.
          if tracing {
            let env_hash = match lookup_env_cache(next_envc, m) {
              Some(env) => compact_string_fingerprint(persistent_type_env_cache_text(env)),
              None => "-"
            }
            StringBuilder::push(trace, "step\t")
            StringBuilder::push(trace, m)
            StringBuilder::push(trace, "\t")
            StringBuilder::push(trace, fp)
            StringBuilder::push(trace, "\t")
            StringBuilder::push(trace, env_hash)
            StringBuilder::push(trace, "\n")
          } else {
            ()
          }
        }
      }
      k = k + 1
    }
    i = j
  }
  if tracing {
    Fs::write_file(trace_path, StringBuilder::freeze(trace))
  } else {
    ()
  }
  // Before the root lookup: with the root itself diagnosed or blocked there is
  // no fingerprint and no environment for it, and reporting "missing:" for a
  // module whose real problem is a type error two levels down would bury the
  // diagnostics this whole pass exists to produce.
  if Array::length(diags) > 0 {
    throw(join_module_diagnostics(diags))
  } else {
    ()
  }
  let root_fingerprint = match lookup_string_pair(fps, path) {
    Some(f) => f,
    // The root is always interned by plan_module_order, so it is always
    // stepped; this is the empty-graph shape rather than a miss.
    None => String::concat("missing:", path)
  }
  let final_env_cache = ensure_env_cache_for_path(db, envc, path)
  (root_fingerprint, db, final_env_cache, dsc, pc)
}

/// #946: drop exact duplicates from a diagnostics list, preserving first-seen
/// order. Each entry already embeds its location ("line L:C: msg"), so string
/// equality IS (position, message) identity. O(N^2) — diagnostic lists are tiny.
fn dedupe_diagnostics(diags: Array[String]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(diags) {
    let d = Array::get(diags, i)
    if contains_str(out, d) {
      ()
    } else {
      Array::push(out, d)
    }
    i = i + 1
  }
  out
}

/// #946(4): find every top-level `fn f(..) -> Int = wasm "<WAT>"` definition
/// (parsed as `SLet(_, _, name, _, EFn(_, _, params, _, _, ECall(EIdent("%wasm",
/// _), [EString(wat)], _)))` — see lc_extract_inline_wasm in
/// codegen/wasi/linked_compile.vibe, whose extraction pattern this mirrors
/// read-only (no mutation: diagnostics discards `stmts` after this scan, and
/// running it before codegen would blow away the marker codegen depends on).
/// Returns (fn_name, wat_text, param_names) triples in declaration order.
fn collect_inline_wasm_fns(stmts: Array[Stmt]) -> Array[(String, String, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, iw_name, _, iw_expr) => match iw_expr {
        EFn(_, _, iw_params, _, _, iw_body) => match iw_body {
          ECall(iw_cal, iw_args, _) => match iw_cal {
            EIdent(iw_cn, _) => if iw_cn == "%wasm" && Array::length(iw_args) == 1 {
              match Array::get(iw_args, 0) {
                EString(iw_wat) => {
                  let pnames = array_empty()
                  let mut pi = 0
                  while pi < Array::length(iw_params) {
                    let (pn, _) = Array::get(iw_params, pi)
                    Array::push(pnames, pn)
                    pi = pi + 1
                  }
                  Array::push(out, (iw_name, iw_wat, pnames))
                },
                _ => ()
              }
            } else {
              ()
            },
            _ => ()
          },
          _ => ()
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// #946(4): validate every inline-wasm fn body (compile_inline_wat — the same
/// assembler codegen uses) and return the FIRST located error, or None when
/// every inline-wasm fn assembles cleanly. `compile` surfaced these (e.g. a bad
/// SIMD lane index) as a located error while `vibe diagnostics` reported clean
/// — diagnostics only ran the typechecker, never this codegen-adjacent
/// validation. Stops at the first error (matches collect_all_diagnostics'
/// existing "one located type error" granularity below).
export fn check_inline_wasm_fns(stmts: Array[Stmt]) -> Option[String] {
  let fns = collect_inline_wasm_fns(stmts)
  let n = Array::length(fns)
  let mut i = 0
  let mut result = None
  let mut done = false
  while !done {
    if i >= n {
      done = true
    } else {
      let (fn_name, wat, pnames) = Array::get(fns, i)
      let outcome = handle {
        let _ = compile_inline_wat(fn_name, wat, pnames)
        None
      } with Error {
        Throw(msg) => Some(msg)
      }
      match outcome {
        Some(msg) => {
          result = Some(msg)
          done = true
        },
        None => {
          i = i + 1
        }
      }
    }
  }
  result
}

/// Collect ALL diagnostics for `source` as located (`line:col`) message strings.
/// Lexer errors come first (#946): the recovering lexer records every offending
/// position instead of throwing, so a lex-broken file reports located lexer
/// diagnostics rather than an empty ("clean") result. Only when the lex is clean
/// does the recovering parser gather every top-level syntax error; only if the
/// parse is also clean does it run the type checker and report the (single,
/// located) type error. Identical (position, message) pairs are deduped.
/// Returns [] when the source lexes, parses, and checks cleanly.
/// Foundation for `vibe check` / LSP multi-diagnostic reporting.
export fn collect_all_diagnostics(source: String) -> Array[String] with { Error } {
  let (tokens, starts, _ends, lex_err_offsets, lex_err_msgs) = lex_with_offsets_recovering(source)
  if Array::length(lex_err_msgs) > 0 {
    // Report ONLY the lexer errors: the recovered token stream has holes, so
    // parse/type diagnostics on it would be follow-on noise.
    //
    // #997 review (Codex): a handful of lexer throw sites (the `\(expr)`
    // interpolation-removal message, and #997's own scientific-notation /
    // incomplete-exponent messages) embed their OWN precise `line L:C: `
    // prefix directly in the message, because `lex_err_offsets` here always
    // records the START offset of the enclosing `lex_one_token` call --
    // wrong for a throw raised partway through a multi-char token (at the
    // `e`/`E`, not the token's first digit). Blindly prepending the generic
    // outer `loc` on top of an already-self-located message produced a
    // doubled/conflicting location (`line 1:9: line 1:18: ...`, confirmed
    // empirically via `vibe diagnostics` on `123456789e10`). Skip the outer
    // prefix for messages that already start with "line " -- they're
    // self-located and the outer offset would only be redundant or wrong.
    //
    // This also incidentally collapses a separate pre-existing duplication:
    // a non-quote-delimited lex error (anything but a broken string/char
    // literal) resumes ONE character past the failure and retries, so a
    // multi-digit scientific-notation literal re-throws the SAME underlying
    // error once per remaining digit (9 identical reports for
    // `123456789e10`) -- previously each got a DIFFERENT (wrong) outer
    // offset, defeating `dedupe_diagnostics`'s exact-string dedup below.
    // With the outer prefix suppressed, all 9 become byte-identical and
    // collapse to the single correctly-located report.
    let located = array_empty()
    let mut i = 0
    while i < Array::length(lex_err_msgs) {
      let msg = Array::get(lex_err_msgs, i)
      let entry = if String::starts_with(msg, "line ") {
        msg
      } else {
        let off = Array::get(lex_err_offsets, i)
        let (line, col) = offset_to_line_col(source, off)
        let loc = String::concat("line ", String::concat(__to_string(line), String::concat(":", String::concat(__to_string(col), ": "))))
        String::concat(loc, msg)
      }
      Array::push(located, entry)
      i = i + 1
    }
    dedupe_diagnostics(located)
  } else {
    let (stmts, parse_diags) = parse_program_recovering(tokens, starts, source)
    if Array::length(parse_diags) > 0 {
      dedupe_diagnostics(parse_diags)
    } else {
      handle {
        let _env = check_program(stmts)
        // #946(4): the type checker never touches inline-wasm bodies (they're
        // opaque `%wasm(...)` marker calls until codegen extracts them — see
        // collect_inline_wasm_fns above), so a clean typecheck says nothing
        // about whether e.g. a SIMD lane index is in range. Run that codegen-
        // adjacent validation here too so `compile`'s located inline-wasm
        // errors aren't invisible to diagnostics.
        match check_inline_wasm_fns(stmts) {
          Some(msg) => [
            locate_type_error(source, msg)
          ],
          None => {
            // #1129 + companion "unbound non-Unit return value" request:
            // both are warning-level (never affect exit status -- `vibe
            // diagnostics` "is a report, not a failure", see cli_adapter.vibe),
            // only surfaced once the program is already known to type-check
            // and codegen-validate cleanly.
            let extra = array_empty()
            let import_warns = detect_unused_imports(stmts)
            let mut wi = 0
            while wi < Array::length(import_warns) {
              let (_, _, wmsg) = Array::get(import_warns, wi)
              Array::push(extra, locate_type_error(source, String::concat("warning: ", wmsg)))
              wi = wi + 1
            }
            // #1340 (ADR-0071): the #1302 "generic effect declarations are
            // unchecked" declaration-site warning is retired — generic
            // effects now register their operation signatures (instantiated
            // per perform/handle site), so the hole it flagged no longer
            // exists.
            let (warn_tytab, warn_subst) = check_program_type_table(stmts)
            let return_warns = detect_unbound_nonunit_returns(stmts, warn_tytab, warn_subst)
            let mut ri = 0
            while ri < Array::length(return_warns) {
              Array::push(extra, locate_type_error(source, String::concat("warning: ", Array::get(return_warns, ri))))
              ri = ri + 1
            }
            extra
          }
        }
      } with Error {
        Throw(msg) => [
          locate_type_error(source, msg)
        ]
      }
    }
  }
}
