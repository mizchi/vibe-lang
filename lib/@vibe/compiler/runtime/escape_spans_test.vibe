//# `escape_spans` (#1262): does this `let mut` escape into a closure?
//#
//# The property under test is the one the consolidation design rests on:
//# **`mut` is not what decides the cost or the authority question — capture
//# is.** Two textually near-identical `let mut`s land on opposite sides.

//# Imports

import ./escape_spans.vibe {
  escape_spans, escape_spans_strict
}

//# Functions

fn esc_names(source: String) -> Array[String] with Exception {
  let items = escape_spans(source)
  let out: Array[String] = [
  ]
  let mut i = 0
  while i < Array::length(items) {
    let (name, _, _) = Array::get(items, i)
    Array::push(out, name)
    i = i + 1
  }
  out
}

fn esc_count(source: String) -> Int with Exception {
  Array::length(escape_spans(source))
}

//# Tests

test "escape_spans: a plain loop counter does not escape" {
  let src = "let f = () -> Int {\n  let mut acc = 0\n  let mut i = 0\n  while i < 10 {\n    acc = acc + i\n    i = i + 1\n  }\n  acc\n}"
  assert_eq(esc_count(src), 0)
}

test "escape_spans: a mut captured by a closure escapes" {
  let src = "let f = () -> Int {\n  let mut acc = 0\n  let bump = (v: Int) -> Unit { acc = acc + v }\n  bump(1)\n  acc\n}"
  let names = esc_names(src)
  assert_eq(Array::length(names), 1)
  assert(String::equals(Array::get(names, 0), "acc"))
}

test "escape_spans: only the captured one is reported" {
  // `acc` is captured, `i` is not -- same declaration form, same function.
  let src = "let f = () -> Int {\n  let mut acc = 0\n  let mut i = 0\n  let bump = () -> Unit { acc = acc + 1 }\n  while i < 3 {\n    bump()\n    i = i + 1\n  }\n  acc\n}"
  let names = esc_names(src)
  assert_eq(Array::length(names), 1)
  assert(String::equals(Array::get(names, 0), "acc"))
}

test "escape_spans: the span points at the binding's own name" {
  let src = "let f = () -> Int {\n  let mut acc = 0\n  let g = () -> Int { acc }\n  g()\n}"
  let items = escape_spans(src)
  assert_eq(Array::length(items), 1)
  let (name, s, e) = Array::get(items, 0)
  assert(String::equals(name, "acc"))
  assert_eq(e - s, 3)
  // and that offset really is where `acc` is declared
  assert(String::equals(String::substring(src, s, e), "acc"))
}

test "escape_spans: a mut captured through a nested closure escapes" {
  let src = "let f = () -> Int {\n  let mut acc = 0\n  let outer = () -> Unit {\n    let inner = () -> Unit { acc = acc + 1 }\n    inner()\n  }\n  outer()\n  acc\n}"
  let names = esc_names(src)
  assert_eq(Array::length(names), 1)
  assert(String::equals(Array::get(names, 0), "acc"))
}

test "escape_spans: a mut inside a test block is walked too" {
  let src = "test \"t\" {\n  let mut n = 0\n  let inc = () -> Unit { n = n + 1 }\n  inc()\n}"
  assert_eq(esc_count(src), 1)
}

test "escape_spans: a file with no mut bindings reports nothing" {
  let src = "let f = (x: Int) -> Int {\n  let y = x + 1\n  y * 2\n}"
  assert_eq(esc_count(src), 0)
}

test "escape_spans: a closure that shadows the name as a param does not capture" {
  // `acc` inside the closure is the PARAMETER, not the outer `let mut`.
  let src = "let f = () -> Int {\n  let mut acc = 0\n  let g = (acc: Int) -> Int { acc + 1 }\n  g(2)\n}"
  assert_eq(esc_count(src), 0)
}

//# Tests — the STRICT lane (`vibe escapes --strict`, #1262 / ADR-0100 (1))
//#
//# Same walk, the checker's predicate instead of codegen's. The two agree on
//# every genuine capture and differ ONLY where a binder shadows the name: the
//# default lane answers "does codegen box this?" (yes — it does not subtract
//# `match`-arm / `for-in` shadowing) and the strict lane answers "does the
//# closure really reach THIS binding?" (no). Neither is a bug; see
//# docs/side-effect-consolidation.md 4.5.

fn esc_strict_names(source: String) -> Array[String] with Exception {
  let items = escape_spans_strict(source)
  let out: Array[String] = [
  ]
  let mut i = 0
  while i < Array::length(items) {
    let (name, _, _) = Array::get(items, i)
    Array::push(out, name)
    i = i + 1
  }
  out
}

fn esc_strict_count(source: String) -> Int with Exception {
  Array::length(escape_spans_strict(source))
}

test "escape_spans_strict: a genuine capture is reported by both lanes" {
  let src = "let f = () -> Int {\n  let mut acc = 0\n  let bump = (v: Int) -> Unit { acc = acc + v }\n  bump(1)\n  acc\n}"
  let names = esc_strict_names(src)
  assert_eq(Array::length(names), 1)
  assert(String::equals(Array::get(names, 0), "acc"))
  assert_eq(esc_count(src), 1)
}

test "escape_spans_strict: a plain loop counter escapes in neither lane" {
  let src = "let f = () -> Int {\n  let mut acc = 0\n  let mut i = 0\n  while i < 10 {\n    acc = acc + i\n    i = i + 1\n  }\n  acc\n}"
  assert_eq(esc_strict_count(src), 0)
  assert_eq(esc_count(src), 0)
}

test "escape_spans_strict: a match-arm binder shadowing the name is not a capture" {
  // The closure captures the ARM's `v`, not the outer `let mut v`. The
  // lowering lane still reports it (it boxes on a name match, which only
  // costs speed); the enforcement lane must not, because a diagnostic built
  // on a name collision would be a wrong diagnostic.
  let src = "let f = () -> Int {\n  let mut v = 0\n  let r = match Some(5) {\n    Some(v) => {\n      let c = () -> Int { v }\n      c()\n    },\n    None => 0\n  }\n  v = v + r\n  v\n}"
  assert_eq(esc_strict_count(src), 0)
  assert_eq(esc_count(src), 1)
}

test "escape_spans_strict: a for-in binder shadowing the name is not a capture" {
  let src = "let f = (xs: Array[Int]) -> Int {\n  let mut n = 0\n  for n in xs {\n    let c = () -> Int { n }\n    let _ = c()\n  }\n  n\n}"
  assert_eq(esc_strict_count(src), 0)
  assert_eq(esc_count(src), 1)
}

test "escape_spans_strict: a closure param shadowing the name is not a capture" {
  let src = "let f = () -> Int {\n  let mut acc = 0\n  let g = (acc: Int) -> Int { acc + 1 }\n  g(2)\n}"
  assert_eq(esc_strict_count(src), 0)
}

test "escape_spans_strict: capture through a nested closure is still a capture" {
  let src = "let f = () -> Int {\n  let mut acc = 0\n  let outer = () -> Unit {\n    let inner = () -> Unit { acc = acc + 1 }\n    inner()\n  }\n  outer()\n  acc\n}"
  assert_eq(esc_strict_count(src), 1)
}

test "escape_spans_strict: a mut used only as a call callee still escapes" {
  // `esc_free_in` counts a bare-identifier CALLEE, unlike the Spawnable
  // free-variable collection: a `let mut` really can hold the closure being
  // called, and reading the cell through a call is a read.
  let src = "let f = () -> Int {\n  let mut h = () -> Int { 1 }\n  let g = () -> Int { h() }\n  g()\n}"
  assert_eq(esc_strict_count(src), 1)
}
