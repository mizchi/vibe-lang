/// #2831: one located diagnostic per line of a `\n`-joined message, for the
/// single-file lane (which carries no path prefix of its own).
export fn locate_type_error_lines(source: String, msg: String) -> Array[String] {
  let parts = split_diagnostics(msg)
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(parts) {
    Array::push(out, value = locate_type_error(source = source, msg = Array::get(parts, at = i)))
    i = i + 1
  }
  out
}

/// #3348: `locate_type_error_lines`, except that a diagnostic which already
/// begins with one of `paths` and `": "` is kept as written. Those are a
/// module job's: it located them against their own file, and one it could not
/// locate must stay unlocated. Locating it again against `source` guessed the
/// first textual occurrence of the name, and printed that guess before the
/// path (`line 2:3: path: unknown name: missing`).
export fn locate_type_error_lines_except_paths(source: String, msg: String, paths: Array[String]) -> Array[String] {
  let parts = split_diagnostics(msg)
  let out: Array[String] = []
  for part in parts {
    let mut prefixed = false
    for p in paths {
      if String::length(p) > 0 && String::starts_with(part, prefix = String::concat(p, ": ")) {
        prefixed = true
      }
    }
    if prefixed {
      Array::push(out, value = part)
    } else {
      Array::push(out, value = locate_type_error(source = source, msg = part))
    }
  }
  out
}

/// #2831: a `\n`-joined report split into ONE STRING PER DIAGNOSTIC.
///
/// Not per line. A diagnostic may carry continuation lines -- `hint: ...`, and
/// anything indented -- and `format_check_report` has kept them attached since
/// #1888 so that `grep -c '^error: '` is an exact count. Splitting on every
/// newline instead turned the one-error program
///
///   fn f() -> Unit { println("x") }
///
/// into TWO reported diagnostics, the second being its own hint. Measured; it
/// is what the 1315-file corpus caught and the fixtures did not.
///
/// The continuation rule is a verbatim twin of `is_check_report_continuation`
/// in user_dispatch.vibe. It is duplicated rather than shared because the
/// framing and the locating live on opposite sides of the compiler, and a
/// brand-new cross-file export plus its first caller in one commit is the
/// shape the merge/flatten tool drops.
fn split_diagnostics(_ msg: String) -> Array[String] {
  engine_split_diagnostics(msg)
}

/// A raised check report -- `\n`-joined diagnostics, each with its
/// continuation lines -- as one string per diagnostic, by the rule above. For
/// a reader outside the compiler: the embedded language server publishes the
/// import-resolving lane's report this way (#4013).
export fn split_check_report(_ msg: String) -> Array[String] {
  engine_split_diagnostics(msg)
}

export fn locate_type_error(source: String, msg: String) -> String {
  engine_locate_type_error(source = source, msg = msg)
}
/// --- #906 Phase 1: module job / outcome seam ----------------------------
///
/// Phase 2 hands one module at a time to a worker that cannot touch the
/// filesystem or the driver's accumulators. This splits the existing
/// per-module work along exactly that line, with no parallelism and no
/// change in behaviour:
///
///   driver  resolves dependency environments (the only Fs the work needs)
///           and packs them into a ModuleJob value
///   worker  check_module : ModuleJob -> ModuleOutcome, no Fs row
///   driver  commit_module_outcome performs every write
///
/// check_module still carries `Error` because parse errors are not yet
/// values -- only type errors are. Making parse diagnostics part of
/// ModuleOutcome would change today's messages, so it is left to the phase
/// that also introduces the canonical diagnostic ordering.
/// ModuleJob is defined TRANSPARENTLY in this package's contract
/// (index.vpkg), not here -- the perceus/ PerceusAction precedent. Its field
/// layout is the worker contract itself, so it belongs in the contract
/// rather than being an opaque handle; record literals and field access
/// resolve from impl units against the contract definition.
export ../../../../lib/@vibe/checker/engine {
  ModuleOutcome
}

/// Opaque proof that the exact retained v2 bytes in one successful
/// ModuleOutcome matched one current, already-ingested ModuleJob. The package
/// contract hides this constructor: decoded or caller-authored bytes cannot
/// create an attestation.
export ../../../../lib/@vibe/checker/engine {
  CheckedModuleTypingArtifactFreshnessAttestation
}

/// Test-observation counter. It measures entry into artifact construction, not
/// checker execution: ordinary and diagnosed paths remain zero.
export fn checked_module_typing_artifact_construction_attempt_count() -> Int {
  engine_checked_module_typing_artifact_construction_attempt_count()
}

export fn reset_checked_module_typing_artifact_construction_attempt_count() -> Unit {
  engine_reset_checked_module_typing_artifact_construction_attempt_count()
}

/// Test-only count of entries into the explicit freshness validator.
export fn checked_module_typing_artifact_validation_attempt_count() -> Int {
  engine_checked_module_typing_artifact_validation_attempt_count()
}

export fn reset_checked_module_typing_artifact_validation_attempt_count() -> Unit {
  engine_reset_checked_module_typing_artifact_validation_attempt_count()
}

/// Observe only canonical bytes retained by an opaque successful ModuleOutcome.
/// Diagnosed outcomes have no observation, and callers cannot construct either
/// variant through the runtime package contract. The bytes are not persisted or
/// consulted by planning, cache lookup, TypeEnv assembly, or reuse.
export fn checked_module_typing_artifact_observation(_ outcome: ModuleOutcome) -> Option[String] {
  engine_checked_module_typing_artifact_observation(outcome)
}

/// Validate one opaque successful outcome against one current, already-ingested
/// ModuleJob and bind the authority to the exact retained bytes. Validation is
/// strict v2 decoding plus exact owner, source, implementation, dependency, and
/// singleton-closure matching. Missing, malformed, stale, or diagnosed inputs
/// return None. Nothing is published, persisted, planned, cached, or reused.
export fn checked_module_typing_artifact_freshness_attestation_for_job(job: ModuleJob, outcome: ModuleOutcome) -> Option[CheckedModuleTypingArtifactFreshnessAttestation] with Exception {
  engine_checked_module_typing_artifact_freshness_attestation_for_job(job = checker_engine_job(job), outcome = outcome)
}

/// Return the exact retained bytes that were validated when the opaque
/// attestation was minted. This does not decode or re-encode the artifact.
export fn checked_module_typing_artifact_freshness_attestation_snapshot(_ attestation: CheckedModuleTypingArtifactFreshnessAttestation) -> String {
  engine_checked_module_typing_artifact_freshness_attestation_snapshot(attestation)
}

/// Compatibility observation over the opaque attestation API.
export fn checked_module_typing_artifact_observation_is_fresh_for_job(job: ModuleJob, outcome: ModuleOutcome) -> Bool with Exception {
  engine_checked_module_typing_artifact_observation_is_fresh_for_job(job = checker_engine_job(job), outcome = outcome)
}

/// Pure module check implementation. Artifact observation is explicitly opt-in:
/// the production incremental path must not allocate canonical shadow bytes for
/// every checked module when no observer consumes them.
fn check_module_impl(job: ModuleJob, observe_typing_artifact: Bool, program_transport: Option[Array[Bytes]], artifact_output: Option[(Bytes, Array[CheckedModuleArtifact])], interfaces: Option[DependencyInterfaceSet]) -> ModuleOutcome with Env + Exception {
  check_module_impl_with_config(job = job, observe_typing_artifact = observe_typing_artifact, program_transport = program_transport, artifact_output = artifact_output, interfaces = interfaces, cfg = target_cfg_ambient())
}

/// Use this invocation's target flags for parsing and cache identity.
fn check_module_impl_with_config(job: ModuleJob, observe_typing_artifact: Bool, program_transport: Option[Array[Bytes]], artifact_output: Option[(Bytes, Array[CheckedModuleArtifact])], interfaces: Option[DependencyInterfaceSet], cfg: TargetCfg) -> ModuleOutcome with Env + Exception {
  engine_check_module_impl_with_config(job = checker_engine_job(job), observe_typing_artifact = observe_typing_artifact, program_transport = program_transport, artifact_output = artifact_output, interfaces = interfaces, cfg = cfg)
}

/// Production module check. No Fs: dependency environments are already values
/// inside the job. Shadow artifact observation stays disabled by default.
export fn check_module(_ job: ModuleJob) -> ModuleOutcome with Env + Exception {
  engine_check_module(checker_engine_job(job))
}

/// Opt-in trusted #1550 observation producer. This runs the same complete module
/// checker and retains canonical bytes only in its opaque successful outcome.
export fn check_module_with_typing_artifact_observation(_ job: ModuleJob) -> ModuleOutcome with Env + Exception {
  engine_check_module_with_typing_artifact_observation(checker_engine_job(job))
}

/// Check against the job's actual import environment and retain the complete
/// result from that one successful invocation. Diagnosed modules have no bytes;
/// parse failures propagate exactly as in check_module. This transport has no
/// persistent identity or cache authority until a coordinator binds its inputs.
export fn check_module_with_program_transport(_ job: ModuleJob) -> (ModuleOutcome, Option[Bytes]) with Env + Exception {
  engine_check_module_with_program_transport(checker_engine_job(job))
}

/// Coordinator-owned commit. Every filesystem and accumulator write for a
/// module happens here and nowhere else.
/// #2728 slice 1: `reuse_eligible` and `reuse_input_key` are what the caller
/// already computed for the TDRE10 lookup, threaded in rather than recomputed.
/// `None` for either means the caller did not compute it, and this function
/// falls back to computing it itself -- so the fallback keeps the old
/// behaviour if a second call site ever appears.
fn commit_module_outcome(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, job: ModuleJob, outcome: ModuleOutcome, reuse_eligible: Option[Bool], reuse_input_key: Option[TypingReuseKey], checked_error_row: Bool) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with Env + Exception + Fs {
  commit_module_outcome_with_config(rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, job = job, outcome = outcome, reuse_eligible = reuse_eligible, reuse_input_key = reuse_input_key, cfg = target_cfg_ambient(), checked_error_row = checked_error_row)
}

/// Use this invocation's target flags for parsing and cache identity.
fn commit_module_outcome_with_config(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, job: ModuleJob, outcome: ModuleOutcome, reuse_eligible: Option[Bool], reuse_input_key: Option[TypingReuseKey], cfg: TargetCfg, checked_error_row: Bool) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with Env + Exception + Fs {
  match outcome {
    // Diagnostics are values as far as the worker is concerned, but the
    // driver still fails fast on the first one so the observable behaviour
    // is byte-identical to the pre-Phase-1 compiler. Collecting them into
    // a canonical set is Phase 2's job.
    // #2831 criterion 4: throw ALL of them, `\n`-joined. The comment that
    // stood here said the driver "fails fast on the first one so the
    // observable behaviour is byte-identical to the pre-Phase-1 compiler" --
    // which is exactly the behaviour this criterion asks to change. Each entry
    // is already located and path-prefixed on its own by `locate_each_line`,
    // and `format_check_report` splits on lines and prefixes each with
    // `error: `, so joining them is the whole change on this side.
    Diagnosed(_, diags) => if Array::length(diags) > 0 {
      throw(String::join(diags, sep = "\n"))
    } else {
      throw(String::concat(job.path, ": type error"))
    },
    Checked(path, fingerprint, checked_env, interface_identity, checked_env_identity, persistent_type_env_transport_identity, _) => {
      // Serialize both check outputs once and publish one atomic disk record.
      // TDRE10 binds these exact bytes; worker outcomes without a lowering
      // table explicitly encode its absence and cannot skip a later check.
      let target_text = store_persistent_type_env_in_namespace(fingerprint = fingerprint, env = checked_env, namespace = target_cfg_namespace(cfg))
      // Publish in commit order: canonical target first, bound witness second,
      // alias last. Diagnosed/thrown checks never enter this Checked arm. Keep
      // the extra canonical target text and input serialization wholly inside
      // the enabled, transitively eligible experimental lane.
      let eligible_here = match reuse_eligible {
        Some(known) => known,
        None => experimental_typing_dependency_env_reuse_enabled() && typing_dependency_env_reuse_is_eligible_in_namespace(job.dep_fps, namespace = target_cfg_namespace(cfg))
      }
      if eligible_here {
        let input_key = match reuse_input_key {
          Some(known_key) => known_key,
          None => typing_dependency_transport_input_key_memo_with_config(path = path, source = job.source, semantics_seed = typing_semantics_seed(checked_error_row = checked_error_row), dep_envs = job.dep_envs, dep_fps = job.dep_fps, cfg = cfg)
        }
        publish_typing_dependency_env_reuse_eligibility_in_namespace(input_key = input_key, fingerprint = fingerprint, target_text = target_text, namespace = target_cfg_namespace(cfg))
        write_typing_dependency_env_reuse_sidecar_in_namespace(input_key = input_key, target_fingerprint = fingerprint, namespace = target_cfg_namespace(cfg))
        retire_previous_typing_dependency_env_reuse_in_namespace(input_key = input_key, fingerprint = fingerprint, namespace = target_cfg_namespace(cfg))
      } else {
        ()
      }
      if incremental_interface_trace_enabled() {
        if String::length(interface_identity) == 0 || String::length(checked_env_identity) == 0 || String::length(persistent_type_env_transport_identity) == 0 {
          throw(String::concat("incremental trace observation: missing checked identity for ", path))
        } else {
          incremental_interface_trace_observe(path = path, interface_identity = interface_identity, checked_env_identity = checked_env_identity, persistent_type_env_transport_identity = persistent_type_env_transport_identity)
        }
      } else {
        ()
      }
      if Array::length(job.deps) == 0 {
        Fs::write_file(persistent_leaf_fingerprint_cache_path_in_namespace(path = path, source_fingerprint = compact_source_fingerprint_memo(path = job.path, source = job.source), namespace = target_cfg_namespace(cfg)), contents = persistent_leaf_fingerprint_text(fingerprint = fingerprint, typing_semantics_seed = typing_semantics_seed(checked_error_row = checked_error_row)))
      } else {
        ()
      }
      let next_env_cache = typecheck_fs_upsert_env_cache(cache = env_cache, path = path, env = checked_env)
      let next_db = ripple_record_eval(db = rdb, path = path, fingerprint = fingerprint, deps = job.deps)
      (fingerprint, next_db, next_env_cache, dep_source_cache, parse_count)
    }
  }
}
/// --- #906 Phase 2: worker entry ------------------------------------------
///
/// The transport boundary. A worker is handed a JOB DIRECTORY and may touch
/// nothing else -- it is the whole preopen sandbox:
///
///   <dir>/job.txt      version / path / fingerprint / dep rows
///   <dir>/source.vibe  the module source, verbatim
///   <dir>/dep<i>.env   dependency i's serialized public environment
///   <dir>/outcome.txt  written here: "ok" or "diag"
///   <dir>/env.out      written here on ok: the checked environment
///   <dir>/diag.txt     written here on diag: one diagnostic per line
///
/// This is what docs/internal/design/compiler-parallelism.md calls the missing in-memory
/// ModuleJob -> ModuleArtifact API. Without it a worker could only check
/// leaf modules: the type-env cache is keyed by a fingerprint derived from
/// the whole transitive source snapshot, which is precisely what a worker
/// must not see, so a worker can never look its own dependencies up. Here
/// the driver hands them over as values instead.
///
/// `path` in job.txt is the module's LOGICAL path, not the materialized
/// temp file. It never gets opened -- it is the base directory that
/// build_import_env resolves each import against, so the dep<i>.env entries
/// bind to the same names they would in a serial compile. Getting this
/// wrong does not fail loudly; it silently binds imports to nothing.
fn job_dir_path(dir: String, name: String) -> String {
  engine_job_dir_path(dir = dir, name = name)
}
/// `dep` rows carry the dependency's path AND its already-computed
/// fingerprint (`dep\t<path>\t<fingerprint>`) -- three columns, unlike every
/// other row. There is deliberately no `fingerprint` row for the job's OWN
/// identity: that is check_module's output (via build_fingerprint), never
/// an input a caller could get wrong or fail to keep in sync.
fn parse_job_rows(_ job_text: String) -> (String, Array[String], Array[String]) with Exception {
  engine_parse_job_rows(job_text)
}
export fn run_module_job_dir(_ dir: String, checked_error_row: Bool) -> Unit with Env + Exception + Fs {
  engine_run_module_job_dir(dir, checked_error_row = checked_error_row)
}
/// Batch worker publication. Each manifest row supplies a fingerprint and a
/// relative env.out filename, optionally followed by a checked cache product.
/// Two-column legacy rows retain unavailable lowering. Three-column rows must
/// carry the successful check's actual, fingerprint-bound complete product.
fn parse_publish_manifest_rows(_ text: String) -> Array[(String, String, String)] with Exception {
  let lines = String::split(normalize_persistent_cache_text(text), sep = "\n")
  let rows = array_empty()
  let mut i = 0
  let len = Array::length(lines)
  while i < len {
    let line = Array::get(lines, at = i)
    if String::length(line) == 0 {
      ()
    } else {
      let parts = String::split(line, sep = "\t")
      if Array::length(parts) != 2 && Array::length(parts) != 3 {
        throw(String::concat("invalid publish manifest row (want fingerprint + envfile + optional cachefile): ", line))
      } else {
        let fingerprint = Array::get(parts, at = 0)
        let env_file = Array::get(parts, at = 1)
        let cache_file = if Array::length(parts) == 3 {
          Array::get(parts, at = 2)
        } else {
          ""
        }
        if String::length(fingerprint) == 0 || String::length(env_file) == 0 || (Array::length(parts) == 3 && String::length(cache_file) == 0) {
          throw(String::concat("invalid publish manifest row (empty fingerprint, envfile or cachefile): ", line))
        } else {
          Array::push(rows, value = (fingerprint, env_file, cache_file))
        }
      }
    }
    i = i + 1
  }
  rows
} export fn run_publish_env_cache_dir(_ dir: String) -> Unit with Env + Exception + Fs {
  let rows = parse_publish_manifest_rows(Fs::read_file(job_dir_path(dir = dir, name = "manifest.txt")))
  let mut i = 0
  let len = Array::length(rows)
  while i < len {
    let (fingerprint, env_file, cache_file) = Array::get(rows, at = i)
    let env_text = Fs::read_file(job_dir_path(dir = dir, name = env_file))
    match parse_persistent_type_env(env_text) {
      Some(env) => {
        let canonical = persistent_type_env_cache_text(env)
        if env_text == canonical {
          let cache_text = if String::length(cache_file) == 0 {
            persistent_module_cache_text(env = env, lowering = None)
          } else {
            let product = Fs::read_file(job_dir_path(dir = dir, name = cache_file))
            let header = String::concat(String::concat("checked-worker-cache\t1\t", fingerprint), "\n")
            if !String::starts_with(product, prefix = header) {
              throw("publish manifest: checked cache product fingerprint or version mismatch")
            } else ()
            let record_text = product[String::length(header): String::length(product)]
            // The v10 wire and v11 record carry the exact same length-delimited
            // environment. Compare its already validated canonical bytes rather
            // than decoding and serializing the large TypeEnv a second time.
            let env_prefix = String::concat("version\t11\n", canonical[String::length("version\t10\n"): String::length(canonical)])
            if !String::starts_with(record_text, prefix = env_prefix) {
              throw("publish manifest: checked cache product is non-canonical or disagrees with its environment")
            } else ()
            let lowering_text = record_text[String::length(env_prefix): String::length(record_text)]
            if lowering_text == "lowering\tmissing\n" {
              throw("publish manifest: checked cache product has unavailable lowering")
            } else ()
            match parse_module_typed_lowering_offsets_text(lowering_text) {
              Some((offsets, eq_offs, eq_keys)) => {
                if module_typed_lowering_text(offsets = offsets, eq_offs = eq_offs, eq_keys = eq_keys) != lowering_text {
                  throw("publish manifest: checked cache product has non-canonical lowering")
                } else ()
                record_text
              },
              None => throw("publish manifest: checked cache product is unreadable")
            }
          }
          Fs::write_file(persistent_type_env_cache_path(fingerprint), contents = cache_text)
        } else {
          throw(String::concat("publish manifest has non-canonical v10 environment: ", env_file))
        }
      },
      None => throw(String::concat("publish manifest has unreadable v10 environment: ", env_file))
    }
    i = i + 1
  }
}
/// Recover publication from the same complete checked result. Re-export
/// projection reads the current dependency environments already bound by the
/// exact input identity; it performs no type inference.
fn checked_module_artifact_outcome(job: ModuleJob, artifact: CheckedModuleArtifact, interfaces: Option[DependencyInterfaceSet], checked_error_row: Bool) -> ModuleOutcome with Env + Exception {
  checked_module_artifact_outcome_with_config(job = job, artifact = artifact, interfaces = interfaces, cfg = target_cfg_ambient(), checked_error_row = checked_error_row)
}

/// Use this invocation's target flags for parsing and cache identity.
fn checked_module_artifact_outcome_with_config(job: ModuleJob, artifact: CheckedModuleArtifact, interfaces: Option[DependencyInterfaceSet], cfg: TargetCfg, checked_error_row: Bool) -> ModuleOutcome with Env + Exception {
  let unresolved: Array[String] = []
  let published = match interfaces {
    Some(shared) => shared,
    None => dependency_interface_set_new()
  }
  dependency_interface_set_supply_missing(interfaces = published, envs = job.dep_envs)
  let (_, reexports) = build_import_envs_from_interfaces(stmts = artifact.parsed_stmts, base_dir = dir_of_path(job.path), interfaces = published, dependency_paths = for row in job.dep_envs {
    row.0
  }, unresolved = unresolved, contract_facade = is_contract_ext(job.path))
  if Array::length(unresolved) > 0 {
    throw("checked module: validated imports no longer resolve")
  }
  let fingerprint = typecheck_fs_build_fingerprint_with_config(path = job.path, source = job.source, dep_fps = job.dep_fps, semantics_seed = typing_semantics_seed(checked_error_row = checked_error_row), cfg = cfg)
  let env = checked_module_public_env_for_path(path = job.path, stmts = checked_module_publication_stmts(artifact.parsed_stmts), full_checked_env = artifact.checked_program.final_env, reexport_declarations = reexports)
  module_typed_lowering_memo_put(path = job.path, fingerprint = fingerprint, offsets = artifact.lowering_offsets, eq_offs = artifact.eq_offsets, eq_keys = artifact.eq_keys)
  module_typed_lowering_bind_source_with_config(path = job.path, fingerprint = fingerprint, source = job.source, cfg = cfg, checked_error_row = checked_error_row)
  let tracing = incremental_interface_trace_enabled()
  Checked(job.path, fingerprint, env, if tracing {
    incremental_interface_identity_with_config(source = job.source, env = env, cfg = cfg, checked_error_row = checked_error_row)
  } else {
    ""
  }, if tracing {
    incremental_checked_env_identity(env)
  } else {
    ""
  }, if tracing {
    incremental_persistent_type_env_transport_identity(env)
  } else {
    ""
  }, None)
}

/// #3965: the statements a reused module publishes from. A fresh check
/// publishes from its statements AFTER checking, which by then hold the
/// `Trait::operation` wrappers the checker derives for the module's own traits
/// (`derive_trait_namespace_operations`); the artifact keeps the statements as
/// parsed, before that. Publishing from them dropped `Value::value` from the
/// module's surface, so an importer's `Value::value(note)` was `unknown name`
/// under `VIBE_CHECKED_MODULE_CACHE=on` while `off` and `verify` compiled it.
/// The same derivation on a copy restores the fresh check's surface; the
/// artifact itself is unchanged.
fn checked_module_publication_stmts(_ parsed: Array[Stmt]) -> Array[Stmt] {
  let out = Array::slice(parsed, start = 0, end = Array::length(parsed))
  let _ = derive_trait_namespace_operations(stmts = out, own_end = Array::length(out))
  out
}

/// One accepting edge for complete artifacts. An unchanged public dependency
/// environment preserves this module's input even when its dependency's body
/// changed. The conservative fingerprint remains available to older consumers.
fn finish_checked_module_artifact_fs(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, deps: Array[String], dep_fps: Array[(String, String)], interfaces: Option[DependencyInterfaceSet], checked_error_row: Bool) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with Env + Exception + Fs {
  finish_checked_module_artifact_fs_with_config(rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, source = source, deps = deps, dep_fps = dep_fps, interfaces = interfaces, cfg = target_cfg_ambient(), checked_error_row = checked_error_row)
}

/// Use this invocation's target flags for parsing and cache identity.
fn finish_checked_module_artifact_fs_with_config(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, deps: Array[String], dep_fps: Array[(String, String)], interfaces: Option[DependencyInterfaceSet], cfg: TargetCfg, checked_error_row: Bool) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with Env + Exception + Fs {
  let coordinated = ensure_env_cache_for_paths_with_config(rdb = rdb, env_cache = env_cache, paths = deps, cfg = cfg)
  let projected = project_exact_dependency_envs(deps = deps, full_cache = coordinated)
  let job = ModuleJob::{
    path,
    source,
    deps,
    dep_fps,
    dep_envs: projected,
    ships_owned_heads: is_owned_head_source_location_env_fs(path),
    checked_error_row: checked_error_row
  }
  let input_identity = checked_module_cache_input_identity_in_namespace(path = path, source = source, semantics_seed = typing_semantics_seed(checked_error_row = checked_error_row), deps = projected, namespace = target_cfg_namespace(cfg), checked_error_row = checked_error_row)
  if checked_module_cache_mode() == "on" {
    match load_checked_module_artifact_in_namespace(path = path, input_identity = input_identity, namespace = target_cfg_namespace(cfg), checked_error_row = checked_error_row) {
      Some(artifact) => {
        let outcome = checked_module_artifact_outcome_with_config(job = job, artifact = artifact, interfaces = interfaces, cfg = cfg, checked_error_row = checked_error_row)
        let committed = commit_module_outcome_with_config(rdb = rdb, env_cache = coordinated, dep_source_cache = dep_source_cache, parse_count = parse_count, job = job, outcome = outcome, reuse_eligible = Some(false), reuse_input_key = None, cfg = cfg, checked_error_row = checked_error_row)
        commit_checked_module_artifact_in_namespace(path = path, source = source, artifact = artifact, fresh = false, namespace = target_cfg_namespace(cfg), checked_error_row = checked_error_row)
        incremental_typecheck_telemetry_add(index = 9, amount = 1)
        return committed
      },
      None => ()
    }
  }
  let output: Array[CheckedModuleArtifact] = []
  let outcome = check_module_impl_with_config(job = job, observe_typing_artifact = false, program_transport = None, artifact_output = Some((input_identity, output)), interfaces = interfaces, cfg = cfg)
  if Array::length(output) == 0 {
    // Preserve the existing diagnosed/parse failure behavior and publish nothing.
    return commit_module_outcome_with_config(rdb = rdb, env_cache = coordinated, dep_source_cache = dep_source_cache, parse_count = parse_count + 1, job = job, outcome = outcome, reuse_eligible = Some(false), reuse_input_key = None, cfg = cfg, checked_error_row = checked_error_row)
  }
  let artifact = Array::get(output, at = 0)
  commit_checked_module_artifact_in_namespace(path = path, source = source, artifact = artifact, fresh = true, namespace = target_cfg_namespace(cfg), checked_error_row = checked_error_row)
  commit_module_outcome_with_config(rdb = rdb, env_cache = coordinated, dep_source_cache = dep_source_cache, parse_count = parse_count + 1, job = job, outcome = outcome, reuse_eligible = Some(false), reuse_input_key = None, cfg = cfg, checked_error_row = checked_error_row)
}

/// `fingerprint` is the already-folded build_fingerprint(source, dep_fps)
/// every call site computed to decide whether to call this function at all
/// (the Fs::exists / ripple_record_eval fast path below needs that folded
/// value, not the raw pairs). `dep_fps` is the SAME per-dependency pairs
/// that fold produced, passed through unfolded too so the ModuleJob built
/// below carries the real inputs check_module needs to compute (and thereby
/// cross-check) that identical fingerprint itself, the same way a worker
/// would -- one canonical computation, not a value trusted from the caller.
fn finish_typecheck_fs_impl(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, deps: Array[String], dep_fps: Array[(String, String)], fingerprint: String, interfaces: Option[DependencyInterfaceSet], checked_error_row: Bool) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with Env + Exception + Fs {
  finish_typecheck_fs_impl_with_config(rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, source = source, deps = deps, dep_fps = dep_fps, fingerprint = fingerprint, interfaces = interfaces, cfg = target_cfg_ambient(), checked_error_row = checked_error_row)
}

/// Use this invocation's target flags for parsing and cache identity.
fn finish_typecheck_fs_impl_with_config(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, deps: Array[String], dep_fps: Array[(String, String)], fingerprint: String, interfaces: Option[DependencyInterfaceSet], cfg: TargetCfg, checked_error_row: Bool) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with Env + Exception + Fs {
  // #2391/#2546: reuse requires both outputs in the unified module entry.
  // A missing output forces a real check, which republishes both.
  let reusable_cached_env = match valid_persistent_type_env_in_namespace(path = path, fingerprint = fingerprint, namespace = target_cfg_namespace(cfg)) {
    Some(cached_env) => if ensure_module_typed_lowering_offsets_for_source_with_config(path = path, fingerprint = fingerprint, source = source, cfg = cfg, checked_error_row = checked_error_row) {
      Some(cached_env)
    } else {
      None
    },
    None => None
  }
  match reusable_cached_env {
    Some(cached_env) => {
      if incremental_interface_trace_enabled() {
        incremental_trace_observe_checked_env_with_config(path = path, source = source, env = cached_env, cfg = cfg, checked_error_row = checked_error_row)
      } else {
        ()
      }
      let next_db = ripple_record_eval(db = rdb, path = path, fingerprint = fingerprint, deps = deps)
      incremental_typecheck_telemetry_add(index = 7, amount = 1)
      // A disk hit may replace an older resident product at the same path.
      let next_env_cache = typecheck_fs_upsert_env_cache(cache = env_cache, path = path, env = cached_env)
      (fingerprint, next_db, next_env_cache, dep_source_cache, parse_count)
    },
    None => {
      // Keep the accumulated cache as coordinator state, but expose exactly the
      // resolved dependency sequence to the checker and TDRE10. Construct this
      // once: lookup, check, and publication must describe the same value.
      let coordinated_env_cache = ensure_env_cache_for_paths_with_config(rdb = rdb, env_cache = env_cache, paths = deps, cfg = cfg)
      let projected_dep_envs = project_exact_dependency_envs(deps = deps, full_cache = coordinated_env_cache)
      // #2728 slice 1: the eligibility walk and the input key are computed
      // HERE and threaded to `commit_module_outcome`, which used to recompute
      // both from `job.dep_fps` / `job.source` / `job.dep_envs` and the
      // `Checked`-bound path. Those are the same values by construction -- the
      // `ModuleJob` below is built from exactly these, `commit_module_outcome`
      // has one call site, and `Checked` is constructed only from `job.path`
      // -- so this removes a duplicate, not a difference.
      //
      // Neither is cheap. The walk reads and parses every dependency's
      // canonical target env text, and the key embeds this module's verbatim
      // source plus each dependency's exact env text, so both scale with text
      // and dependency count rather than with anything being reused. Paying
      // them twice per module is a term of the cold regression #2728 measures.
      //
      // Hoisting is also safe in TIME, not only in the values: the second
      // evaluation used to happen after `check_module`, and the walk reads one
      // WITNESS per dependency. A module's dependencies are checked before it
      // -- they have to be, they feed `projected_dep_envs` -- so each of their
      // witnesses is already published or already absent by the time this
      // module is looked at, and nothing between these two points writes one.
      // The later evaluation could therefore never have answered differently.
      let reuse_eligible = if experimental_typing_dependency_env_reuse_enabled() {
        typing_dependency_env_reuse_is_eligible_in_namespace(dep_fps, namespace = target_cfg_namespace(cfg))
      } else {
        false
      }
      let reuse_input_key = if reuse_eligible {
        Some(typing_dependency_transport_input_key_memo_with_config(path = path, source = source, semantics_seed = typing_semantics_seed(checked_error_row = checked_error_row), dep_envs = projected_dep_envs, dep_fps = dep_fps, cfg = cfg))
      } else {
        None
      }
      let reused_env = match reuse_input_key {
        Some(input_key) => {
          match load_typing_dependency_env_reuse_target_in_namespace(path = path, input_key = input_key, namespace = target_cfg_namespace(cfg)) {
            // The bound record hydrates this path's lowering memo from the
            // target fingerprint. Absent tables already declined the reuse.
            Some((target_fingerprint, target_text, target_env)) => if ensure_module_typed_lowering_offsets_for_source_with_config(path = path, fingerprint = target_fingerprint, source = source, cfg = cfg, checked_error_row = checked_error_row) {
              Some((input_key, target_fingerprint, target_text, target_env))
            } else {
              None
            },
            None => None
          }
        },
        None => None
      }
      match reused_env {
        Some((input_key, target_fingerprint, target_text, target_env)) => {
          // Preserve the ordinary conservative fingerprint path for every later
          // consumer. Commit this target first, then its exact bound witness, and
          // only then the alias, so torn publication always fails closed.
          Fs::write_file(persistent_type_env_cache_path_in_namespace(fingerprint, namespace = target_cfg_namespace(cfg)), contents = target_text)
          // The copied record contains both outputs; bind the existing rows
          // in memory to the new conservative fingerprint as well.
          match module_typed_lowering_memo_get_by_fp(target_fingerprint) {
            Some((reused_offsets, reused_eq_offs, reused_eq_keys)) => {
              module_typed_lowering_memo_put(path = path, fingerprint = fingerprint, offsets = reused_offsets, eq_offs = reused_eq_offs, eq_keys = reused_eq_keys)
              module_typed_lowering_bind_source_with_config(path = path, fingerprint = fingerprint, source = source, cfg = cfg, checked_error_row = checked_error_row)
            },
            None => ()
          }
          publish_typing_dependency_env_reuse_eligibility_in_namespace(input_key = input_key, fingerprint = fingerprint, target_text = target_text, namespace = target_cfg_namespace(cfg))
          // The alias is NOT rewritten: it is how this hit was found, so it
          // already binds this input key to a target whose record and witness
          // were just validated, and pointing it at this fingerprint instead
          // would rewrite the same binding text under another name. Retiring
          // the slot's previous publication repoints it if that target goes.
          retire_previous_typing_dependency_env_reuse_in_namespace(input_key = input_key, fingerprint = fingerprint, namespace = target_cfg_namespace(cfg))
          let next_env_cache = typecheck_fs_upsert_env_cache(cache = coordinated_env_cache, path = path, env = target_env)
          let next_db = ripple_record_eval(db = rdb, path = path, fingerprint = fingerprint, deps = deps)
          incremental_typecheck_telemetry_add(index = 8, amount = 1)
          (fingerprint, next_db, next_env_cache, dep_source_cache, parse_count)
        },
        None => {
          let job = ModuleJob::{
            path: path,
            source: source,
            deps: deps,
            dep_fps: dep_fps,
            dep_envs: projected_dep_envs,
            ships_owned_heads: is_owned_head_source_location_env_fs(path),
            checked_error_row: checked_error_row
          }
          let outcome = check_module_impl_with_config(job = job, observe_typing_artifact = false, program_transport = None, artifact_output = None, interfaces = interfaces, cfg = cfg)
          commit_module_outcome_with_config(rdb = rdb, env_cache = coordinated_env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count + 1, job = job, outcome = outcome, reuse_eligible = Some(reuse_eligible), reuse_input_key = reuse_input_key, cfg = cfg, checked_error_row = checked_error_row)
        }
      }
    }
  }
} fn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String) -> Array[String] {
  // Iterative push: previously the recursive `Array::concat(acc, [x])`
  // copied the full prefix on each new dep — O(N^2) for files with
  // many imports.
  let out = empty_stack()
  let mut i = 0
  let len = Array::length(stmts)
  while i < len {
    match Array::get(stmts, at = i) {
      SImport(raw_path, _) => if String::length(raw_path) > 0 && !is_builtin_iterator_serialized_boundary_path(raw_path) {
        let resolved = resolve_import_path(base_dir = base_dir, raw_path = raw_path)
        if !contains_str(arr = out, target = resolved) {
          Array::push(out, value = resolved)
        }
      },
      SReExport(raw_path, _) => if String::length(raw_path) > 0 {
        let resolved = resolve_import_path(base_dir = base_dir, raw_path = raw_path)
        if !contains_str(arr = out, target = resolved) {
          Array::push(out, value = resolved)
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
} fn load_or_parse_deps_for_source_fs(dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int, checked_error_row: Bool) -> (Array[String], Array[(String, String)], Int) with Env + Exception + Fs {
  load_or_parse_deps_for_source_fs_with_config(dep_source_cache = dep_source_cache, path = path, source = source, parse_count = parse_count, cfg = target_cfg_ambient(), checked_error_row = checked_error_row)
}

/// Use this invocation's target flags for parsing and cache identity.
fn load_or_parse_deps_for_source_fs_with_config(dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int, cfg: TargetCfg, checked_error_row: Bool) -> (Array[String], Array[(String, String)], Int) with Env + Exception + Fs {
  match load_persistent_dep_list_in_namespace(path = path, source = source, namespace = target_cfg_namespace(cfg)) {
    Some(deps) => (deps, typecheck_fs_upsert_string_pair(pairs = dep_source_cache, key = path, value = source), parse_count),
    None => {
      let (deps, _, next_parse_count) = load_or_parse_module_header_fs_with_config(path = path, source = source, parse_count = parse_count, cfg = cfg, checked_error_row = checked_error_row)
      (deps, typecheck_fs_upsert_string_pair(pairs = dep_source_cache, key = path, value = source), next_parse_count)
    }
  }
} fn resolve_deps_for_source_fs(rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int, checked_error_row: Bool) -> (Array[String], Array[(String, String)], Int) with Env + Exception + Fs {
  resolve_deps_for_source_fs_with_config(rdb = rdb, dep_source_cache = dep_source_cache, path = path, source = source, parse_count = parse_count, cfg = target_cfg_ambient(), checked_error_row = checked_error_row)
}

/// Use this invocation's target flags for parsing and cache identity.
fn resolve_deps_for_source_fs_with_config(rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int, cfg: TargetCfg, checked_error_row: Bool) -> (Array[String], Array[(String, String)], Int) with Env + Exception + Fs {
  match cached_module_dependencies(rdb = rdb, source_cache = dep_source_cache, path = path, source = source) {
    Some(deps) => (deps, dep_source_cache, parse_count),
    None => load_or_parse_deps_for_source_fs_with_config(dep_source_cache = dep_source_cache, path = path, source = source, parse_count = parse_count, cfg = cfg, checked_error_row = checked_error_row)
  }
}
/// #1239 step 4(A), on the real fs path: the coordinator-side upfront pass.
///
/// Walks the import graph from `root` ONCE and records, per reachable module,
/// either the persistent leaf fingerprint it found or the module's resolved
/// dependency list. The walk that follows looks both up here instead of
/// paying for them a second time, so this is a REPLACEMENT for work
/// the walk used to do inline, not an extra pass.
///
/// An unchanged module still contributes its dependency edges: its own source
/// says nothing about whether one of those dependencies changed. Only a missing
/// source or a validated dependency-free leaf can terminate planning early.
/// Source/header caches avoid reparsing unchanged dependency lists.
export fn plan_import_graph_fs(rdb: RippleDb, dep_source_cache: Array[(String, String)], parse_count: Int, root: String, checked_error_row: Bool) -> (Array[(String, String)], Array[(String, Array[String])], Int, Array[(String, String)]) with Env + Exception + Fs {
  plan_import_graph_fs_with_config(rdb = rdb, dep_source_cache = dep_source_cache, parse_count = parse_count, root = root, cfg = target_cfg_ambient(), checked_error_row = checked_error_row)
}

/// Use this invocation's target flags for parsing and cache identity.
export fn plan_import_graph_fs_with_config(rdb: RippleDb, dep_source_cache: Array[(String, String)], parse_count: Int, root: String, cfg: TargetCfg, checked_error_row: Bool) -> (Array[(String, String)], Array[(String, Array[String])], Int, Array[(String, String)]) with Env + Exception + Fs {
  let leaf_fps = typecheck_fs_empty_dep_fps()
  let plan_diags: Array[(String, String)] = []
  let edges: Array[(String, Array[String])] = []
  let seen = empty_stack()
  let queue = empty_stack()
  // Private copy -- see copy_string_pairs. The predicates below still read
  // the caller's cache, because what they must reproduce is the state the
  // walk sees on a module's FIRST visit; only the resolver gets the copy.
  let scratch_cache = copy_string_pairs(dep_source_cache)
  let mut pc = parse_count
  Array::push(seen, value = root)
  Array::push(queue, value = root)
  let mut qi = 0
  while qi < Array::length(queue) {
    let path = Array::get(queue, at = qi)
    qi = qi + 1
    match ripple_get_source(db = rdb, path = path) {
      None => (),
      Some(source) => {
        // #2767: hand this module its stored AST, if there is one, BEFORE any
        // of the branches below decide it needs no parsing.
        //
        // This is the only point every planned module passes through exactly
        // once. Hung on any of the branches instead, the prefetch misses the
        // others, and there are four ways planning settles a module without
        // parsing: a valid persistent leaf fingerprint (just below), an
        // in-process `reusable` decision, `ripple_get_deps`, and the
        // persistent dep list. It was originally hung on the FIFTH -- the
        // module-header text cache, one level further in -- which a warm
        // build reaches only when the dep list missed, so it fired zero times
        // per warm build and the merge lane re-parsed the whole closure.
        // Measured on the full CLI closure (420 modules, one cache directory
        // per run): a warm build's bump-heap high-water was byte-identical
        // with VIBE_EXPERIMENTAL_AST_CACHE=1 and with it off, while every
        // cold build wrote 42 MB of artifacts nobody read.
        //
        // Then measured again at the dep-list branch alone, which is how this
        // ended up here: 2 of 3 modules prefetched and the third still parsed
        // in the merge, because a LEAF never resolves dependencies at all.
        //
        // This does NOT make the warm build cheaper -- measured N=3 on that
        // closure, it makes it worse. With the prefetch reaching all 420
        // modules a warm build decodes 420 stored ASTs instead of parsing 420
        // sources, and that is +38.7 MiB of heap (+2.1%) and +1.07 s of wall
        // (+12%) against the same build with the cache off: the decode
        // allocates the AST the parse would have allocated and reads 42 MB to
        // do it. The flag stays opt-in and off. What changed is that the
        // question became decidable -- `ast_cache_prefetches` reporting 420
        // means a slower warm build is the cache losing on its merits, not
        // the cache failing to run.
        // Unguarded and uncounted HERE on purpose: `ast_cache_prefetch_fs`
        // owns both. It has a second call site -- the module-header pass,
        // reached from `module_plan_data_fs`'s source-collection walk, which
        // runs before this one -- and a policy or a count written at one call
        // site is simply absent at the other. Both were, until Codex found
        // them on #2771.
        let _ = ast_cache_prefetch_fs_with_config(path = path, source = source, cfg = cfg, checked_error_row = checked_error_row)
        match valid_persistent_leaf_fingerprint_in_namespace(path = path, source = source, namespace = target_cfg_namespace(cfg), checked_error_row = checked_error_row) {
          Some(leaf_fingerprint) => Array::push(leaf_fps, value = (path, leaf_fingerprint)),
          None => {
            // Codex review P2: resolving a module's imports PARSES it, so a
            // syntax error raises here -- during planning, before the walk's
            // per-step handler exists. Left alone that made parse errors
            // fail-fast even while collecting: two malformed leaves reported
            // one diagnostic, because planning aborted on the first.
            //
            // Collected the same way a step's diagnostic is, and with the
            // same two exclusions (fail-fast mode, and `type_db:` internal
            // invariants). A module that fails to plan gets no edge entry and
            // no dependencies explored -- it is a leaf to the schedule, and
            // the caller seeds it into `failed` so its importers are blocked
            // rather than cascading.
            let plan_raised = empty_stack()
            let (deps_raw, _, next_pc) = handle {
              resolve_deps_for_source_fs_with_config(rdb = rdb, dep_source_cache = scratch_cache, path = path, source = source, parse_count = pc, cfg = cfg, checked_error_row = checked_error_row)
            } with { Exception::Throw(msg) => {
              Array::push(plan_raised, value = msg)
              (empty_stack(), scratch_cache, pc)
            } }
            if Array::length(plan_raised) > 0 {
              let msg = Array::get(plan_raised, at = 0)
              if !collect_module_diagnostics() || String::starts_with(msg, prefix = "type_db: ") {
                throw(msg)
              } else {
                Array::push(plan_diags, value = (path, msg))
              }
            } else {
              ()
            }
            let deps = copy_string_array(deps_raw)
            pc = next_pc
            if Array::length(plan_raised) > 0 {
              ()
            } else {
              Array::push(edges, value = (path, deps))
            }
            let dlen = Array::length(deps)
            let mut i = 0
            while i < dlen {
              let dep = Array::get(deps, at = i)
              if contains_str(arr = seen, target = dep) {
                ()
              } else {
                Array::push(seen, value = dep)
                Array::push(queue, value = dep)
              }
              i = i + 1
            }
          }
        }
      }
    }
  }
  (leaf_fps, edges, pc, plan_diags)
}
/// The dep list `plan_import_graph_fs` recorded for `path`, or None when it
/// recorded none. Returns a copy for the same reason graph.vibe's mo_deps_of
/// does: the caller takes ownership of the list it folds fingerprints over.
export fn plan_deps_of(plan_edges: Array[(String, Array[String])], path: String) -> Option[Array[String]] {
  let n = Array::length(plan_edges)
  let mut i = 0
  let mut found: Option[Array[String]] = None
  while i < n {
    let e = Array::get(plan_edges, at = i)
    if e.0 == path {
      found = Some(copy_string_array(e.1))
      i = n
    } else {
      i = i + 1
    }
  }
  found
}
/// The leaf-fingerprint arm: a module whose persistent leaf cache is valid is
/// recorded with no deps at all and needs no checking.
fn commit_leaf_fingerprint_fs(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, leaf_fingerprint: String, interfaces: Option[DependencyInterfaceSet], checked_error_row: Bool) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with Env + Exception + Fs {
  commit_leaf_fingerprint_fs_with_config(rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, source = source, leaf_fingerprint = leaf_fingerprint, interfaces = interfaces, cfg = target_cfg_ambient(), checked_error_row = checked_error_row)
}

/// Use this invocation's target flags for parsing and cache identity.
fn commit_leaf_fingerprint_fs_with_config(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, leaf_fingerprint: String, interfaces: Option[DependencyInterfaceSet], cfg: TargetCfg, checked_error_row: Bool) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with Env + Exception + Fs {
  // The plan read this cache earlier, but recheck at the accepting edge: a
  // stale/malformed leaf pointer must cold-check rather than become authority.
  // #2391: the checked lowering table is part of that acceptance too.
  match valid_persistent_type_env_in_namespace(path = path, fingerprint = leaf_fingerprint, namespace = target_cfg_namespace(cfg)) {
    Some(cached_env) => if ensure_module_typed_lowering_offsets_for_source_with_config(path = path, fingerprint = leaf_fingerprint, source = source, cfg = cfg, checked_error_row = checked_error_row) {
      if incremental_interface_trace_enabled() {
        incremental_trace_observe_checked_env_with_config(path = path, source = source, env = cached_env, cfg = cfg, checked_error_row = checked_error_row)
      } else {
        ()
      }
      write_persistent_dep_list_if_missing_in_namespace(path = path, source = source, deps = empty_stack(), namespace = target_cfg_namespace(cfg))
      let next_dep_source_cache = typecheck_fs_upsert_string_pair(pairs = dep_source_cache, key = path, value = source)
      let next_db = ripple_record_eval(db = rdb, path = path, fingerprint = leaf_fingerprint, deps = empty_stack())
      incremental_typecheck_telemetry_add(index = 7, amount = 1)
      let next_env_cache = typecheck_fs_upsert_env_cache(cache = env_cache, path = path, env = cached_env)
      (leaf_fingerprint, next_db, next_env_cache, next_dep_source_cache, parse_count)
    } else {
      finish_typecheck_fs_impl_with_config(rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, source = source, deps = empty_stack(), dep_fps = typecheck_fs_empty_dep_fps(), fingerprint = typecheck_fs_build_fingerprint_with_config(path = path, source = source, dep_fps = typecheck_fs_empty_dep_fps(), semantics_seed = typing_semantics_seed(checked_error_row = checked_error_row), cfg = cfg), interfaces = interfaces, cfg = cfg, checked_error_row = checked_error_row)
    },
    None => finish_typecheck_fs_impl_with_config(rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, source = source, deps = empty_stack(), dep_fps = typecheck_fs_empty_dep_fps(), fingerprint = typecheck_fs_build_fingerprint_with_config(path = path, source = source, dep_fps = typecheck_fs_empty_dep_fps(), semantics_seed = typing_semantics_seed(checked_error_row = checked_error_row), cfg = cfg), interfaces = interfaces, cfg = cfg, checked_error_row = checked_error_row)
  }
}
/// One module's step, once its dependency list is known and every dependency
/// already has a fingerprint. Folds the dependency fingerprints in
/// DECLARATION order (build_fingerprint folds them as a sequence, not a set),
/// then either reuses the cached fingerprint or checks and commits.
fn commit_with_deps_fs(fps: Array[(String, String)], rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, deps: Array[String], interfaces: Option[DependencyInterfaceSet], checked_error_row: Bool) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with Env + Exception + Fs {
  commit_with_deps_fs_with_config(fps = fps, rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, source = source, deps = deps, interfaces = interfaces, cfg = target_cfg_ambient(), checked_error_row = checked_error_row)
}

/// Use this invocation's target flags for parsing and cache identity.
fn commit_with_deps_fs_with_config(fps: Array[(String, String)], rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, deps: Array[String], interfaces: Option[DependencyInterfaceSet], cfg: TargetCfg, checked_error_row: Bool) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with Env + Exception + Fs {
  write_persistent_dep_list_if_missing_in_namespace(path = path, source = source, deps = deps, namespace = target_cfg_namespace(cfg))
  let dlen = Array::length(deps)
  let dep_fps = typecheck_fs_empty_dep_fps()
  let mut i = 0
  while i < dlen {
    let dep_path = Array::get(deps, at = i)
    match typecheck_fs_lookup_string_pair(pairs = fps, key = dep_path) {
      Some(dep_fp) => Array::push(dep_fps, value = (dep_path, dep_fp)),
      // Unreachable: rank order guarantees every dependency was stepped
      // before its importer. Loud rather than folding a placeholder into the
      // fingerprint, which would key the persistent cache on a lie.
      None => throw(String::concat("type_db: dependency stepped out of rank order: ", dep_path))
    }
    i = i + 1
  }
  let fingerprint = typecheck_fs_build_fingerprint_with_config(path = path, source = source, dep_fps = dep_fps, semantics_seed = typing_semantics_seed(checked_error_row = checked_error_row), cfg = cfg)
  if checked_module_cache_mode() != "off" {
    return finish_checked_module_artifact_fs_with_config(rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, source = source, deps = deps, dep_fps = dep_fps, interfaces = interfaces, cfg = cfg, checked_error_row = checked_error_row)
  }
  match ripple_get_fingerprint(db = rdb, path = path) {
    Some(cached_fp) =>
    if cached_fp == fingerprint {
      match valid_persistent_type_env_in_namespace(path = path, fingerprint = fingerprint, namespace = target_cfg_namespace(cfg)) {
        // #2391: both cache halves, or re-check (which republishes both).
        Some(_) => if ensure_module_typed_lowering_offsets_for_source_with_config(path = path, fingerprint = fingerprint, source = source, cfg = cfg, checked_error_row = checked_error_row) {
          incremental_typecheck_telemetry_add(index = 7, amount = 1)
          (fingerprint, rdb, env_cache, dep_source_cache, parse_count)
        } else {
          finish_typecheck_fs_impl_with_config(rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, source = source, deps = deps, dep_fps = dep_fps, fingerprint = fingerprint, interfaces = interfaces, cfg = cfg, checked_error_row = checked_error_row)
        },
        None => finish_typecheck_fs_impl_with_config(rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, source = source, deps = deps, dep_fps = dep_fps, fingerprint = fingerprint, interfaces = interfaces, cfg = cfg, checked_error_row = checked_error_row)
      }
    } else {
      finish_typecheck_fs_impl_with_config(rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, source = source, deps = deps, dep_fps = dep_fps, fingerprint = fingerprint, interfaces = interfaces, cfg = cfg, checked_error_row = checked_error_row)
    },
    None =>
    finish_typecheck_fs_impl_with_config(rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, source = source, deps = deps, dep_fps = dep_fps, fingerprint = fingerprint, interfaces = interfaces, cfg = cfg, checked_error_row = checked_error_row)
  }
}
/// Step one scheduled module after accepting all dependency fingerprints.
/// A validated leaf needs no dependency fold; every other module folds the
/// current dependency inputs before accepting a resident or disk product.
fn step_module_fs_impl(plan_leaf_fps: Array[(String, String)], plan_edges: Array[(String, Array[String])], fps: Array[(String, String)], rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, interfaces: Option[DependencyInterfaceSet], checked_error_row: Bool) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with Env + Exception + Fs {
  step_module_fs_impl_with_config(plan_leaf_fps = plan_leaf_fps, plan_edges = plan_edges, fps = fps, rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, interfaces = interfaces, cfg = target_cfg_ambient(), checked_error_row = checked_error_row)
}

/// Use this invocation's target flags for parsing and cache identity.
fn step_module_fs_impl_with_config(plan_leaf_fps: Array[(String, String)], plan_edges: Array[(String, Array[String])], fps: Array[(String, String)], rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, interfaces: Option[DependencyInterfaceSet], cfg: TargetCfg, checked_error_row: Bool) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with Env + Exception + Fs {
  let (rdb_loaded, loaded_source) = load_planned_module_source_with_config(rdb = rdb, path = path, cfg = cfg, checked_error_row = checked_error_row)
  match loaded_source {
    None => (String::concat("missing:", path), rdb_loaded, env_cache, dep_source_cache, parse_count),
    Some(source) => {
      if checked_module_cache_mode() != "off" {
        let deps = match plan_deps_of(plan_edges = plan_edges, path = path) {
          Some(planned) => planned,
          None => if (typecheck_fs_lookup_string_pair(pairs = plan_leaf_fps, key = path) is Some(_)) || is_vpkg_types_stub_path(path) {
            empty_stack()
          } else {
            throw(String::concat("type_db: module missing from the import plan: ", path))
          }
        }
        return commit_with_deps_fs_with_config(fps = fps, rdb = rdb_loaded, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, source = source, deps = deps, interfaces = interfaces, cfg = cfg, checked_error_row = checked_error_row)
      }
      match typecheck_fs_lookup_string_pair(pairs = plan_leaf_fps, key = path) {
        Some(leaf_fingerprint) =>
        commit_leaf_fingerprint_fs_with_config(rdb = rdb_loaded, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, source = source, leaf_fingerprint = leaf_fingerprint, interfaces = interfaces, cfg = cfg, checked_error_row = checked_error_row),
        None =>
        match plan_deps_of(plan_edges = plan_edges, path = path) {
          Some(planned_deps) =>
          commit_with_deps_fs_with_config(fps = fps, rdb = rdb_loaded, env_cache = env_cache, dep_source_cache = typecheck_fs_upsert_string_pair(pairs = dep_source_cache, key = path, value = source), parse_count = parse_count, path = path, source = source, deps = planned_deps, interfaces = interfaces, cfg = cfg, checked_error_row = checked_error_row),
          // Types stubs interned only as someone else's dep have no plan
          // edge: plan_import_graph_fs skipped them because they were not
          // in the ripple db. They are leaves (type-family defs only).
          None =>
          if is_vpkg_types_stub_path(path) {
            commit_with_deps_fs_with_config(fps = fps, rdb = rdb_loaded, env_cache = env_cache, dep_source_cache = typecheck_fs_upsert_string_pair(pairs = dep_source_cache, key = path, value = source), parse_count = parse_count, path = path, source = source, deps = empty_stack(), interfaces = interfaces, cfg = cfg, checked_error_row = checked_error_row)
          } else {
            throw(String::concat("type_db: module missing from the import plan: ", path))
          }
        }
      }
    }
  }
}

export fn step_module_fs(plan_leaf_fps: Array[(String, String)], plan_edges: Array[(String, Array[String])], fps: Array[(String, String)], rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, checked_error_row: Bool) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with Env + Exception + Fs {
  step_module_fs_impl(plan_leaf_fps = plan_leaf_fps, plan_edges = plan_edges, fps = fps, rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, interfaces = None, checked_error_row = checked_error_row)
}

export fn step_module_fs_using_interfaces(plan_leaf_fps: Array[(String, String)], plan_edges: Array[(String, Array[String])], fps: Array[(String, String)], rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, interfaces: DependencyInterfaceSet, checked_error_row: Bool) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with Env + Exception + Fs {
  step_module_fs_using_interfaces_with_config(plan_leaf_fps = plan_leaf_fps, plan_edges = plan_edges, fps = fps, rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, interfaces = interfaces, cfg = target_cfg_ambient(), checked_error_row = checked_error_row)
}

/// Use this invocation's target flags for parsing and cache identity.
export fn step_module_fs_using_interfaces_with_config(plan_leaf_fps: Array[(String, String)], plan_edges: Array[(String, Array[String])], fps: Array[(String, String)], rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, interfaces: DependencyInterfaceSet, cfg: TargetCfg, checked_error_row: Bool) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with Env + Exception + Fs {
  step_module_fs_impl_with_config(plan_leaf_fps = plan_leaf_fps, plan_edges = plan_edges, fps = fps, rdb = rdb, env_cache = env_cache, dep_source_cache = dep_source_cache, parse_count = parse_count, path = path, interfaces = Some(interfaces), cfg = cfg, checked_error_row = checked_error_row)
}

/// Preserve the runtime's public input type at the engine boundary. Dependency
/// arrays and environments remain the caller's exact snapshot, in its order.
fn checker_engine_job(_ job: ModuleJob) -> CheckJob {
  CheckJob::{
    path: job.path,
    source: job.source,
    deps: job.deps,
    dep_fps: job.dep_fps,
    dep_envs: job.dep_envs,
    ships_owned_heads: job.ships_owned_heads,
    checked_error_row: job.checked_error_row
  }
}
