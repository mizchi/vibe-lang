//# Imports

// #946: `symbol_spans` used to swallow every failure (a lex/parse error on
// the source) into a bare empty list -- indistinguishable from "this file
// legitimately declares no symbols". It now propagates the Error instead, so
// the CLI adapter's `.diag` sidecar (cli_adapter.vibe's
// VIBE_SYMBOLS handling) can report the real cause instead of a silent empty
// outline.

import ./symbol_spans.vibe {
  symbol_spans, symbol_spans_with_docs
}

//# Functions

fn sym_has(syms: Array[(String, Int, Int, Int)], name: String, kind: Int) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(syms) {
    let (n, k, _, _) = Array::get(syms, i)
    if n == name && k == kind {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn sym_fmt(syms: Array[(String, Int, Int, Int)]) -> String {
  let acc = StringBuilder::new()
  let mut i = 0
  while i < Array::length(syms) {
    let (n, k, _, _) = Array::get(syms, i)
    if i > 0 {
      StringBuilder::push(acc, ", ")
    } else {
      ()
    }
    StringBuilder::push(acc, n)
    StringBuilder::push(acc, " ")
    StringBuilder::push(acc, __to_string(k))
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

//# Misc

/// `NAME=DOC` per symbol that carries one, so a test can assert the pairing
/// without depending on offsets.
fn sym_doc_fmt(syms: Array[(String, Int, Int, Int, String)]) -> String {
  let acc = StringBuilder::new()
  let mut first = true
  let mut i = 0
  while i < Array::length(syms) {
    let (name, _kind, _s, _e, doc) = Array::get(syms, i)
    if String::length(doc) == 0 {
      ()
    } else {
      if first {
        first = false
      } else {
        StringBuilder::push(acc, ", ")
      }
      StringBuilder::push(acc, name)
      StringBuilder::push(acc, "=")
      StringBuilder::push(acc, doc)
    }
    i = i + 1
  }
  StringBuilder::freeze(acc)
}

test "symbol_spans_with_docs: a `///` block attaches to the declaration below it" {
  let src = "/// Doubles it.\nfn twice(x: Int) -> Int { x * 2 }\nfn plain(y: Int) -> Int { y }\n"
  let syms = symbol_spans_with_docs(src)
  // Both declarations are outlined; only the documented one carries text.
  assert(Array::length(syms) == 2)
  inspect(sym_doc_fmt(syms), "twice=Doubles it.")
}

test "symbol_spans_with_docs: a multi-line doc keeps its newlines here" {
  // The CLI escapes them to keep one record on one line; this layer is the
  // structured answer and hands back the real text.
  let src = "/// One.\n/// Two.\nfn f() -> Int { 1 }\n"
  let syms = symbol_spans_with_docs(src)
  let (_n, _k, _s, _e, doc) = Array::get(syms, 0)
  assert(doc == "One.\nTwo.")
}

test "symbol_spans_with_docs: the outline matches symbol_spans exactly" {
  // Both go through symbol_spans_impl, so a doc comment must never add,
  // drop, or move a symbol -- only annotate one.
  let src = "/// Doc.\nfn a() -> Int { 1 }\nstruct P { x: Int }\n/// Doc2.\nfn b() -> Int { 2 }\n"
  let plain = symbol_spans(src)
  let withd = symbol_spans_with_docs(src)
  assert(Array::length(plain) == Array::length(withd))
  let mut i = 0
  while i < Array::length(plain) {
    let (pn, pk, ps, pe) = Array::get(plain, i)
    let (dn, dk, ds, de, _doc) = Array::get(withd, i)
    assert(pn == dn)
    assert(pk == dk)
    assert(ps == ds)
    assert(pe == de)
    i = i + 1
  }
}

test "symbol_spans: a clean file returns its declarations" {
  let syms = symbol_spans("export fn f(x: Int) -> Int { x + 1 }\n")
  assert(Array::length(syms) == 1)
  assert(sym_has(syms, "f", 12))
}

test "symbol_spans: fn, named test, and named bench are outlined (#1944)" {
  let src = "fn add(a: Int, b: Int) -> Int { a + b }\ntest \"adds\" { let _ = add(1, 2) }\nbench \"once\" { let _ = add(1, 1) }\n"
  let syms = symbol_spans(src)
  inspect(sym_fmt(syms), "add 12, adds 12, once 12")
  assert(sym_has(syms, "add", 12))
  assert(sym_has(syms, "adds", 12))
  assert(sym_has(syms, "once", 12))
}

test "symbol_spans: empty test/bench names emit the keyword so outline is not empty (#1944)" {
  // The parser rejects unnamed `test { }` / `bench { }` (needs a string
  // literal). An empty string is the stable stand-in for that missing name.
  let src = "test \"\" { let _ = 1 }\nbench \"\" { let _ = 1 }\n"
  let syms = symbol_spans(src)
  inspect(sym_fmt(syms), "test 12, bench 12")
}

test "symbol_spans: impl is one Method symbol named after the target type (#1944)" {
  let src = "trait Show { }\nstruct Point { x: Int }\nimpl Show for Point { }\n"
  let syms = symbol_spans(src)
  inspect(sym_fmt(syms), "Show 11, Point 23, Point 6")
}

test "symbol_spans: a genuinely empty (comments-only) file returns an empty list, not an error" {
  let syms = symbol_spans("// just a comment\n")
  assert(Array::length(syms) == 0)
}

test "symbol_spans: a lex error propagates instead of silently returning empty (#946)" {
  let msg = handle {
    let _ = symbol_spans("export fn f() -> Int {\n  1 $ 2\n}\n")
    ""
  } with Exception {
    Throw(m) => m
  }
  assert(String::contains(msg, "unexpected character"))
}
