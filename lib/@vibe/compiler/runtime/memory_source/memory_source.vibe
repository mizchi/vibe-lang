import @vibe/compiler/core {
  Source, Stmt, dir_of_path, external_lib_roots, is_owned_head_source_location, normalize_path
}
import @vibe/compiler/incremental {
  RippleDb, ripple_get_source, ripple_source_paths
}
import @vibe/compiler/loader {
  ModuleParse, module_header_source_with_config, parse_program_located_shared_with_config
}
import @vibe/compiler/config {
  TargetCfg, target_cfg_ambient
}
import @vibe/core {
  MutMap, sorted_names_of
}

export enum MemorySources {
  MemorySources(RippleDb, MutMap[String, Array[String]])
}

/// Only the directory index is copied. Source reads use the walk's linear db;
/// providers do not mutate its sources while the walk is running.
export fn memory_sources_new(_ db: RippleDb) -> MemorySources {
  let directories: MutMap[String, Array[String]] = MutMap::new_string()
  for path in ripple_source_paths(db) {
    let raw_dir = dir_of_path(path)
    let dir = if raw_dir == "" {
      "."
    } else {
      raw_dir
    }
    let names = match MutMap::get(directories, k = dir) {
      Some(entries) => entries,
      None => {
        let entries: Array[String] = []
        MutMap::set(directories, k = dir, v = entries)
        entries
      }
    }
    let prefix = String::last_index_of(path, needle = "/") + 1
    Array::push(names, value = path[prefix: String::length(path)])
  }
  MemorySources(db, directories)
}

fn memory_read(sources: MemorySources, path: String) -> String {
  match sources {
    MemorySources(db, _) => match ripple_get_source(db = db, path = path) {
      Some(text) => text,
      None => ""
    }
  }
}

fn memory_exists(sources: MemorySources, path: String) -> Bool {
  match sources {
    MemorySources(db, _) => ripple_get_source(db = db, path = path) is Some(_)
  }
}

fn memory_list(sources: MemorySources, path: String) -> Array[String] {
  match sources {
    MemorySources(_, directories) => match MutMap::get(directories, k = path) {
      Some(names) => sorted_names_of(names),
      None => []
    }
  }
}

fn memory_parse(path: String, source: String, cfg: TargetCfg) -> (Array[Stmt], Option[String]) {
  handle {
    (parse_program_located_shared_with_config(path = path, source = source, cfg = cfg), None)
  } with { Exception::Throw(message) => ([], Some(message)) }
}

/// Header policy belongs to the loader. Every entry here is a regular virtual
/// file, so its metadata token is a non-symlink hint, never a cache identity.
export fn memory_module_header(sources: MemorySources, path: String, source: String, parse_count: Int) -> (Array[String], Array[String], Int) with Env + Exception {
  memory_module_header_with_config(sources = sources, path = path, source = source, parse_count = parse_count, cfg = target_cfg_ambient())
}

/// Resolve virtual dependencies with the same immutable flags as their checker.
export fn memory_module_header_with_config(sources: MemorySources, path: String, source: String, parse_count: Int, cfg: TargetCfg) -> (Array[String], Array[String], Int) with Env + Exception {
  handle {
    module_header_source_with_config(path = path, source = source, parse_count = parse_count, cfg = cfg)
  } with { ModuleParse::Parse(p, text) => resume(memory_parse(path = p, source = text, cfg = cfg)); Source::Read(p) => resume(memory_read(sources = sources, path = p)); Source::Exists(p) => resume(memory_exists(sources = sources, path = p)); Source::List(p) => resume(memory_list(sources = sources, path = p)); Source::StatToken(_) => resume(7) }
}

/// Resolve the shipped owned-head declarations against the same virtual files.
export fn memory_module_ships_owned_heads(sources: MemorySources, path: String) -> Bool with Env {
  if String::ends_with(normalize_path(path), suffix = "@vibe/concurrent/experimental/concurrent.vibe") {
    handle {
      is_owned_head_source_location(path = path, roots = external_lib_roots())
    } with { Source::Read(p) => resume(memory_read(sources = sources, path = p)); Source::Exists(p) => resume(memory_exists(sources = sources, path = p)); Source::List(p) => resume(memory_list(sources = sources, path = p)); Source::StatToken(_) => resume(7) }
  } else {
    false
  }
}
