import ./memory_source.vibe {
  memory_module_header, memory_sources_new
}
import @vibe/compiler/incremental {
  ripple_new, ripple_set_source
}

test "memory headers resolve directory packages and reexports with no Fs" {
  let db = ripple_set_source(ripple_new(), "virtual/main.vibe", "import ./pkg { f }\nexport ./other.vibe { g }\n")
  let db = ripple_set_source(db, "virtual/pkg/index.vpkg", "fn f() -> Int\n")
  let db = ripple_set_source(db, "virtual/other.vibe", "export fn g() -> Int { 1 }\n")
  let (deps, _, count) = memory_module_header(memory_sources_new(db), "virtual/main.vibe", "import ./pkg { f }\nexport ./other.vibe { g }\n", 0)
  inspect(String::join(deps, ","), content = "virtual/pkg/index.vpkg,virtual/other.vibe")
  inspect(count, content = "1")
}

test "memory contract headers discover sorted production siblings only" {
  let db = ripple_set_source(ripple_new(), "virtual/pkg/index.vpkg", "fn f() -> Int\n")
  let db = ripple_set_source(db, "virtual/pkg/z.vibe", "")
  let db = ripple_set_source(db, "virtual/pkg/a.vibe", "")
  let db = ripple_set_source(db, "virtual/pkg/a_test.vibe", "")
  let db = ripple_set_source(db, "virtual/pkg/_private.vibe", "")
  let db = ripple_set_source(db, "virtual/pkg/x.draft.vibe", "")
  let db = ripple_set_source(db, "virtual/pkg/sub/inside.vibe", "")
  let (deps, _, _) = memory_module_header(memory_sources_new(db), "virtual/pkg/index.vpkg", "fn f() -> Int\n", 0)
  inspect(String::join(deps, ","), content = "virtual/pkg/a.vibe,virtual/pkg/z.vibe")
}

test "memory header refuses missing imports without filesystem access" {
  let sources = memory_sources_new(ripple_new())
  let message = handle {
    memory_module_header(sources, "virtual/main.vibe", "import ./missing.vibe { f }\n", 0)
    "accepted"
  } with { Exception::Throw(message) => message }
  inspect(String::contains(message, "missing.vibe"), content = "true")
  inspect(message == "accepted", content = "false")
}
