import ./memory_source.vibe {
  memory_module_header, memory_sources_new
}
import @vibe/compiler/incremental {
  ripple_new, ripple_set_source
}

test "memory headers resolve directory packages and reexports with no Fs" {
  let db = ripple_set_source(db = ripple_new(), path = "virtual/main.vibe", source = "import ./pkg { f }\nexport ./other.vibe { g }\n")
  let db = ripple_set_source(db = db, path = "virtual/pkg/index.vpkg", source = "fn f() -> Int\n")
  let db = ripple_set_source(db = db, path = "virtual/other.vibe", source = "export fn g() -> Int { 1 }\n")
  let (deps, _, count) = memory_module_header(sources = memory_sources_new(db), path = "virtual/main.vibe", source = "import ./pkg { f }\nexport ./other.vibe { g }\n", parse_count = 0)
  inspect(String::join(deps, sep = ","), content = "virtual/pkg/index.vpkg,virtual/other.vibe")
  inspect(count, content = "1")
}

test "memory contract headers discover sorted production siblings only" {
  let db = ripple_set_source(db = ripple_new(), path = "virtual/pkg/index.vpkg", source = "fn f() -> Int\n")
  let db = ripple_set_source(db = db, path = "virtual/pkg/z.vibe", source = "")
  let db = ripple_set_source(db = db, path = "virtual/pkg/a.vibe", source = "")
  let db = ripple_set_source(db = db, path = "virtual/pkg/a_test.vibe", source = "")
  let db = ripple_set_source(db = db, path = "virtual/pkg/_private.vibe", source = "")
  let db = ripple_set_source(db = db, path = "virtual/pkg/x.draft.vibe", source = "")
  let db = ripple_set_source(db = db, path = "virtual/pkg/sub/inside.vibe", source = "")
  let (deps, _, _) = memory_module_header(sources = memory_sources_new(db), path = "virtual/pkg/index.vpkg", source = "fn f() -> Int\n", parse_count = 0)
  inspect(String::join(deps, sep = ","), content = "virtual/pkg/a.vibe,virtual/pkg/z.vibe")
}

test "memory header refuses missing imports without filesystem access" {
  let sources = memory_sources_new(ripple_new())
  let message = handle {
    memory_module_header(sources = sources, path = "virtual/main.vibe", source = "import ./missing.vibe { f }\n", parse_count = 0)
    "accepted"
  } with { Exception::Throw(message) => message }
  inspect(String::contains(message, needle = "missing.vibe"), content = "true")
  inspect(message == "accepted", content = "false")
}
