export fn starts_with_upper(name: String) -> Bool {
  engine_starts_with_upper(name)
}

/// A builtin declaration becomes import authority only when the dependency
/// explicitly publishes it. This predicate is deliberately used solely while
/// constructing that published surface; import validation below never falls
/// back to builtin, registry, or effect-name recognition.
///
/// In a package contract (`strict`, see `checked_module_public_env_for_path`),
/// a type brought in from ANOTHER module (a re-export; the binding's origin
/// names that module) carries its constructors and the names its defining
/// module marked as members -- the methods of its impls and of its derives
/// (`local_type_member_markers`) -- and nothing else that shares its prefix or
/// returns it: those are published by declaring them. A signature is not
/// provenance, so a method is never recognized as derived by its shape.
/// Without this, a contract re-exporting a subset of a package --
/// `@vibe/concurrent` over `@vibe/concurrent/experimental` -- published the
/// rest too: listing `TaskGroup` / `TaskHandle` carried
/// `TaskGroup::spawn_suspend` (by prefix) and `TaskGroup::adopt` (it returns
/// `TaskHandle`) past a contract that declares neither. Every other module,
/// and a type declared in the publishing module, keeps the older rule, which
/// is how derived methods that no export list names reach an importer.
///
/// A member marker itself travels with its type, in every module.
export fn is_selected_type_companion(name: String, binding: EnvValueBinding, type_surface: Array[String], all_defs: Array[TypeDef], members: Array[String], strict: Bool) -> Bool {
  engine_is_selected_type_companion(name, binding, type_surface, all_defs, members, strict)
}

/// The names a module's own impls and derives bind under a type, as markers.
/// An impl method is read from the environment's impl table, following
/// supertraits, since the impl names its trait and the trait its methods. A
/// derived method has no declaration in the source, so it is a qualified
/// binding under a type this module declares WITH a derive list that no
/// statement declares. Anything else under `T::` is a free function.
export fn local_type_member_markers(stmts: Array[Stmt], env: TypeEnv) -> Array[String] {
  engine_local_type_member_markers(stmts, env)
}

export fn bind_type_member_markers(env: TypeEnv, markers: Array[String]) -> TypeEnv {
  engine_bind_type_member_markers(env, markers)
}

/// The `T::m` names the markers in an environment speak for.
export fn env_type_member_names(env: TypeEnv) -> Array[String] {
  engine_env_type_member_names(env)
}

export fn selected_module_binding_origin(dep_env: TypeEnv, resolved: String, source_name: String, reexport_surface_only: Bool) -> BindingOrigin {
  engine_selected_module_binding_origin(dep_env, resolved, source_name, reexport_surface_only)
}

export fn bind_enum_constructor_companions(acc: TypeEnv, dep_env: TypeEnv, resolved: String, dep_bindings: Array[(String, Type)], source_owner: String, local_owner: String, trait_mappings: Array[(String, String)], reexport_surface_only: Bool) -> TypeEnv {
  engine_bind_enum_constructor_companions(acc, dep_env, resolved, dep_bindings, source_owner, local_owner, trait_mappings, reexport_surface_only)
}

/// #1521: an import of a name the dependency does not export binds `CtUnknown`
/// below, which unifies with anything, so every USE of that name typechecks
/// and the program only fails in codegen with `undefined variable (ident): X`
/// -- no file, no line. `unresolved` collects those names so the caller can
/// turn them into a real diagnostic; pass a throwaway array to opt out.
///
/// The `dep_known` guard is load-bearing. A dependency whose environment is
/// not in this cache -- a `@pkg` import, or an entry not computed yet --
/// yields `EnvEmpty`, and then EVERY name looks missing. Reporting those is a
/// false positive on correct code, and it is the failure mode that sank the
/// two earlier attempts at this check (one keyed off the merged environment,
/// one off a lane `vibe check` does not use).
///
/// Only names the dependency's VALUE environment can speak for are reported:
/// `starts_with_upper` names may be a struct or a type alias, and those are
/// not bindings at all -- they live in `defs`, which this cache does not
/// carry -- so "absent here" does not mean "not exported" for them. Enums and
/// their constructors DO appear, but there is no way at this point to tell an
/// unexported `Foo` from a struct-only `Foo`, so the uppercase half of #1521
/// stays open rather than risk rejecting valid code.
///
/// #1533 (closed): this membership test IS the export test for lowercase
/// names, because the environment a dependency publishes is no longer its
/// full checked environment -- check_module restricts it to the module's
/// export surface before it reaches any cache (see
/// restrict_env_to_export_surface). `import ./dep.vibe { private_fn }` is
/// therefore reported here, with the same message as a name that never
/// existed: from the importer's side those are the same fact, "the
/// dependency does not export this name".

//# Trait-aware dependency projection (#1549)

/// Trait declaration/implementation authority is not part of
/// `env_flat_bindings`, so importing a bounded value used to drop the exact
/// declarations needed to check that value at its consumer. This projection is
/// intentionally limited to TypeEnv's trait nodes: typedef and effect
/// declarations have different transport contracts.
export fn trait_projection_mapping(mappings: Array[(String, String)], canonical: String) -> Option[String] {
  engine_trait_projection_mapping(mappings, canonical)
}

/// Project only the trait constructor spelling while preserving its applied
/// arguments. Applied references use an AST key internally, so treating the
/// complete key as an ordinary name loses explicit import aliases.
export fn trait_projection_map_ref(label: String, mappings: Array[(String, String)]) -> String {
  engine_trait_projection_map_ref(label, mappings)
}

export fn trait_projection_add_mapping(mappings: Array[(String, String)], canonical: String, local_name: String) -> Unit {
  engine_trait_projection_add_mapping(mappings, canonical, local_name)
}

export fn trait_projection_claim_mappings(claims: Array[(String, String, Bool, String)], resolved: String, dep_env: TypeEnv, mappings: Array[(String, String)], unresolved: Array[String]) -> Unit {
  engine_trait_projection_claim_mappings(claims, resolved, dep_env, mappings, unresolved)
}

/// `trait_defined(env, name)` against the row env_trait_def_names_into
/// filled from `env` (#2386): the import projection asks it for every
/// imported name, every bound label and every supertrait of an edge, and
/// each answer used to walk the whole chain. The row holds a module's trait
/// names -- tens at most -- so a scan is the cheapest probe. An empty row
/// answers before normalizing the name: trait_ref_name allocates its parsed
/// reference, and most dependencies define no trait at all (the walk never
/// reached a compare there; measured +0.8 MB of cold heap when this
/// normalized unconditionally).
export fn trait_in_list(traits: Array[String], name: String) -> Bool {
  engine_trait_in_list(traits, name)
}

/// Slots of `bindings` whose name starts uppercase, into a caller-owned row:
/// the companions and types the projection's per-name candidate scan can
/// ever select. Filled once per edge so the scan per imported name skips
/// the lowercase majority.
export fn uppercase_binding_slots_into(bindings: Array[(String, Type)], out: Array[Int]) -> Unit {
  engine_uppercase_binding_slots_into(bindings, out)
}

export fn trait_projection_supers(env: TypeEnv, name: String) -> Array[String] {
  engine_trait_projection_supers(env, name)
}

export fn trait_projection_collect_generic_impl_bounds(dep_env: TypeEnv, trait_name: String, mappings: Array[(String, String)], traits: Array[String]) -> Unit {
  engine_trait_projection_collect_generic_impl_bounds(dep_env, trait_name, mappings, traits)
}

export fn trait_projection_collect_type_bounds(ty: Type, mappings: Array[(String, String)], traits: Array[String]) -> Unit {
  engine_trait_projection_collect_type_bounds(ty, mappings, traits)
}

/// Rewrite every reachable Type that crosses the selected import boundary.
/// In particular, a value's `CtForAll` labels must agree with the local alias
/// of the projected trait authority; keeping the dependency spelling makes an
/// otherwise valid alias fail closed as an unknown trait at use sites.
export fn trait_projection_map_type_bounds(ty: Type, mappings: Array[(String, String)]) -> Type {
  engine_trait_projection_map_type_bounds(ty, mappings)
}

/// Explicit trait selections win regardless of their position among selected
/// values. A second pass then imports only traits required by selected value
/// schemes. Conflicting aliases fail closed instead of making import order an
/// unobservable authority choice.
export fn dependency_trait_projection_mappings(dep_env: TypeEnv, dep_bindings: Array[(String, Type)], dep_traits: Array[String], upper_slots: Array[Int], names: Array[ImportItem], unresolved: Array[String]) -> Array[(String, String)] {
  engine_dependency_trait_projection_mappings(dep_env, dep_bindings, dep_traits, upper_slots, names, unresolved)
}

export fn trait_projection_map_method_gens(method_gens: Array[(String, Array[String], Array[(String, Array[String])])], mappings: Array[(String, String)]) -> Array[(String, Array[String], Array[(String, Array[String])])] {
  engine_trait_projection_map_method_gens(method_gens, mappings)
}

export fn trait_projection_map_method_bound_rows(bounds: Array[(String, Array[String])], mappings: Array[(String, String)]) -> Array[(String, Array[String])] {
  engine_trait_projection_map_method_bound_rows(bounds, mappings)
}

