//# Functions

export fn empty_stack() -> Array[String] {
  array_empty()
}

export fn typecheck_fs_empty_dep_fps() -> Array[(String, String)] {
  array_empty()
}

/// Every persistent hit validates both v10 sections before hydrating the
/// lowering memo. Missing tables and malformed entries force a real check.
export fn valid_persistent_type_env(path: String, fingerprint: String) -> Option[TypeEnv] with Env + Exception + Fs {
  match load_persistent_module_cache(fingerprint) {
    Some(record) => match record.lowering {
      Some((offsets, eq_offs, eq_keys)) => {
        module_typed_lowering_memo_put(path, fingerprint, offsets, eq_offs, eq_keys)
        Some(record.env)
      },
      None => None
    },
    None => None
  }
}

export fn valid_persistent_leaf_fingerprint(path: String, source: String) -> Option[String] with Env + Exception + Fs {
  match load_persistent_leaf_fingerprint(path, source, typing_semantics_seed()) {
    Some(fingerprint) => match valid_persistent_type_env(path, fingerprint) {
      Some(_) => Some(fingerprint),
      None => None
    },
    None => None
  }
}

//# #2391: per-module Double call-result offsets (the #2158 channel, modular)
//
// check_module retains, per checked module, the source-located primary call
// results whose checker-confirmed instantiated type is Double -- in the
// module's OWN offset space. The FS compile lanes rebase each file into a
// disjoint offset range and union these tables to feed
// `CompileCtx.float_call_offsets`, so a Double that arrives through a call
// renders correctly on the import-resolving lanes too (the single-source and
// gc lanes already carry the channel; compile_file_fs_mode's #2158 note has
// the measurement for why a whole-program re-check was not the way).
//
// The memo is scoped to ONE typecheck walk: ensure_fingerprint_fs_impl
// resets it up front, every module the walk accepts (checked, reused, or
// TDRE9-transported) binds its own path row before the walk returns, and the
// FS merge unions the rows right after. That lifecycle is what makes the two
// consumer-side hazards structural non-events rather than policies: a row
// can never be STALE (nothing from an earlier compile of a since-edited file
// survives the reset), and nothing EVICTS a row the active compile still
// needs (the memo is bounded by the closure's module count, so a daemon's
// memory is bounded per compile without an eviction cap). The v10 disk record
// holds the TypeEnv and lowering table under their shared module fingerprint.
// Every accepting load validates both sections before populating this memo.
// Missing/corrupt tables force one real check. The #906 worker transport still
// carries only TypeEnv v9, so its disk record marks lowering unavailable and a
// later in-driver compile re-checks instead of silently losing offsets.

// The publication pass owns this scratch row and refills it before use.
// Import projection reads each dependency's immutable interface view instead.
export let ipt_trait_names: Array[String] = []
let module_typed_lowering_memo_paths: Array[String] = []

let module_typed_lowering_memo_fps: Array[String] = []

// Exact source witnesses belong to the same row as its checked fingerprint.
// A path alone must never authorize restoring identities into another text.
let module_typed_lowering_memo_sources: Array[Option[String]] = []

let module_typed_lowering_memo_offsets: Array[Array[Int]] = []

// #2441: the typed-`==` rows ride the same memo lifecycle as the Int table
// above -- same reset, same put/lookup keys -- as two parallel per-module
// arrays: anchor offsets and the impl_target_key of the operand TypeExpr.
let module_typed_lowering_memo_eq_offs: Array[Array[Int]] = []

let module_typed_lowering_memo_eq_keys: Array[Array[String]] = []

export fn module_typed_lowering_memo_reset() -> Unit {
  Array::truncate(module_typed_lowering_memo_paths, 0)
  Array::truncate(module_typed_lowering_memo_fps, 0)
  Array::truncate(module_typed_lowering_memo_sources, 0)
  Array::truncate(module_typed_lowering_memo_offsets, 0)
  Array::truncate(module_typed_lowering_memo_eq_offs, 0)
  Array::truncate(module_typed_lowering_memo_eq_keys, 0)
}

export fn module_typed_lowering_memo_put(path: String, fingerprint: String, offsets: Array[Int], eq_offs: Array[Int], eq_keys: Array[String]) -> Unit {
  let n = Array::length(module_typed_lowering_memo_paths)
  let mut i = 0
  let mut found = false
  while i < n {
    if Array::get(module_typed_lowering_memo_paths, i) == path {
      if Array::get(module_typed_lowering_memo_fps, i) != fingerprint {
        Array::set(module_typed_lowering_memo_sources, i, None)
      }
      Array::set(module_typed_lowering_memo_fps, i, fingerprint)
      Array::set(module_typed_lowering_memo_offsets, i, offsets)
      Array::set(module_typed_lowering_memo_eq_offs, i, eq_offs)
      Array::set(module_typed_lowering_memo_eq_keys, i, eq_keys)
      found = true
      i = n
    } else {
      i = i + 1
    }
  }
  if !found {
    Array::push(module_typed_lowering_memo_paths, path)
    Array::push(module_typed_lowering_memo_fps, fingerprint)
    Array::push(module_typed_lowering_memo_sources, None)
    Array::push(module_typed_lowering_memo_offsets, offsets)
    Array::push(module_typed_lowering_memo_eq_offs, eq_offs)
    Array::push(module_typed_lowering_memo_eq_keys, eq_keys)
  } else {
    ()
  }
}

// Publish only after the checker or cache acceptance validated this source
// against fingerprint. An unbound legacy row cannot restore callee identities.
export fn module_typed_lowering_bind_source(path: String, fingerprint: String, source: String) -> Unit {
  let mut i = 0
  while i < Array::length(module_typed_lowering_memo_paths) {
    if Array::get(module_typed_lowering_memo_paths, i) == path && Array::get(module_typed_lowering_memo_fps, i) == fingerprint {
      Array::set(module_typed_lowering_memo_sources, i, Some(source))
    }
    i = i + 1
  }
}

fn module_typed_lowering_source_for_fp(fingerprint: String) -> Option[String] {
  let mut result: Option[String] = None
  let mut i = 0
  while i < Array::length(module_typed_lowering_memo_fps) {
    if Array::get(module_typed_lowering_memo_fps, i) == fingerprint {
      match Array::get(module_typed_lowering_memo_sources, i) {
        Some(source) => {
          result = Some(source)
          i = Array::length(module_typed_lowering_memo_fps)
        },
        None => i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  result
}

export fn module_typed_lowering_offsets_for_source(path: String, source: String) -> Option[Array[Int]] {
  let mut result: Option[Array[Int]] = None
  let mut i = 0
  while i < Array::length(module_typed_lowering_memo_paths) {
    if Array::get(module_typed_lowering_memo_paths, i) == path {
      if Array::get(module_typed_lowering_memo_sources, i) == Some(source) {
        result = Some(Array::get(module_typed_lowering_memo_offsets, i))
      }
      i = Array::length(module_typed_lowering_memo_paths)
    } else {
      i = i + 1
    }
  }
  result
}

/// #2449: the in-memory module walk's publication point. `ensure_fingerprint`
/// (runtime.vibe) checks each module of the "sources passed in memory" family
/// with the same observation the FS lane uses, and this is where its table
/// reaches the memo the merge consumers read by path.
///
/// It is a thin wrapper rather than an exported `module_typed_lowering_memo_put`
/// so the `None` case -- the parse carried no offsets, which the located-channel
/// refusal reports -- is normalized HERE, in the file that owns the memo, to the
/// empty table that classifies nothing.
export fn publish_module_typed_lowering_offsets(path: String, fingerprint: String, offsets: Option[Array[Int]], eq_offs: Array[Int], eq_keys: Array[String]) -> Unit {
  module_typed_lowering_memo_put(path, fingerprint, match offsets {
    Some(table) => table,
    None => array_empty()
  }, eq_offs, eq_keys)
}

export fn module_typed_lowering_memo_get_by_fp(fingerprint: String) -> Option[(Array[Int], Array[Int], Array[String])] {
  let n = Array::length(module_typed_lowering_memo_fps)
  let mut i = 0
  let mut found: Option[(Array[Int], Array[Int], Array[String])] = None
  while i < n {
    if Array::get(module_typed_lowering_memo_fps, i) == fingerprint {
      found = Some((Array::get(module_typed_lowering_memo_offsets, i), Array::get(module_typed_lowering_memo_eq_offs, i), Array::get(module_typed_lowering_memo_eq_keys, i)))
      i = n
    } else {
      i = i + 1
    }
  }
  found
}

/// The consumer query: this module's Double call-result offsets, in its own
/// offset space, as recorded by the most recent check (or unified-record load) of
/// `path` in this process. `None` means the module was never stepped here --
/// the FS lanes treat that file as contributing no offsets, which degrades
/// that file's calls to the pre-#2158 syntactic classifier rather than to a
/// wrong answer.
export fn module_typed_lowering_offsets_for_path(path: String) -> Option[Array[Int]] {
  let n = Array::length(module_typed_lowering_memo_paths)
  let mut i = 0
  let mut found: Option[Array[Int]] = None
  while i < n {
    if Array::get(module_typed_lowering_memo_paths, i) == path {
      found = Some(Array::get(module_typed_lowering_memo_offsets, i))
      i = n
    } else {
      i = i + 1
    }
  }
  found
}

/// #2441: the typed-`==` sibling of the query above -- this module's
/// `(anchor offset, operand TypeExpr key)` rows, in its own offset space.
/// `None` degrades that file's `==` sites to the syntactic classifiers,
/// exactly like the Int table's consumer.
export fn module_typed_eq_rows_for_path(path: String) -> Option[(Array[Int], Array[String])] {
  let n = Array::length(module_typed_lowering_memo_paths)
  let mut i = 0
  let mut found: Option[(Array[Int], Array[String])] = None
  while i < n {
    if Array::get(module_typed_lowering_memo_paths, i) == path {
      found = Some((Array::get(module_typed_lowering_memo_eq_offs, i), Array::get(module_typed_lowering_memo_eq_keys, i)))
      i = n
    } else {
      i = i + 1
    }
  }
  found
}

/// #2391: shift each file's per-module typed-lowering table (recorded by the
/// modular check in the file's OWN offset space) by that file's base in a
/// disjoint-offset merge, and union them into one table. Rows are tag-encoded
/// (offset * 8 + tag, see typed_lowering_enc in the checker), so the rebase
/// adds base * 8, or base * 64 for callee tag 7, retaining the tag and
/// operation identity bits. A file the modular check
/// never stepped in this process contributes nothing, which degrades ITS
/// sites to the syntactic classifiers -- deterministically, because the reuse
/// arms in typecheck_fs.vibe re-check a module whose checked lowering table is
/// missing rather than reusing half a cache entry.
///
/// #2449: this lives beside the memo it reads rather than in one merge's
/// file, because BOTH merges need it -- the grouped file merge
/// (entry/compiler/file_compile) and the inline-source merge
/// (entry/compiler/fs_compile). A second copy of the decoder below is the
/// shape that goes wrong quietly: a tag added on one side classifies nothing
/// on the other, and an empty channel looks exactly like "nothing to
/// classify".
export fn union_module_typed_lowering_offsets(flat_paths: Array[String], flat_bases: Array[Int]) -> Array[Int] {
  let out: Array[Int] = []
  let mut i = 0
  while i < Array::length(flat_paths) {
    match module_typed_lowering_offsets_for_path(Array::get(flat_paths, i)) {
      Some(offsets) => {
        let base = Array::get(flat_bases, i)
        let mut j = 0
        while j < Array::length(offsets) {
          let row = Array::get(offsets, j)
          let scale = if typed_lowering_enc_tag(row) == 7 {
            64
          } else {
            8
          }
          Array::push(out, row + base * scale)
          j = j + 1
        }
      },
      None => ()
    }
    i = i + 1
  }
  out
}

/// The per-file union plus the alias-collision clones' duplicated entries
/// (already in merge space and encoded, see the clone emission in each merge).
export fn union_module_typed_lowering_with_clones(flat_paths: Array[String], flat_bases: Array[Int], clone_float_offsets: Array[Int]) -> Array[Int] {
  let out = union_module_typed_lowering_offsets(flat_paths, flat_bases)
  let mut ci = 0
  while ci < Array::length(clone_float_offsets) {
    Array::push(out, Array::get(clone_float_offsets, ci))
    ci = ci + 1
  }
  out
}

/// #2441 (Codex round 1 on #2443): a module-PRIVATE nominal type in an eq
/// row must follow the merge's private-type rename, or the row still names
/// the source spelling while the merged declarations name the mangled one.
/// Measured before this mapping: a dependency's private `Point` row, with
/// the ENTRY declaring a different `Point`, dispatched the entry's
/// `Point::equals` on the dependency's values -- `true` for content-unequal
/// pairs. The mapping consults the SAME rename record the merge populated
/// (#2205): a name is rewritten to `namespace_private_name(path, name)`
/// exactly when that mangled spelling is recorded as a rename of this name,
/// so an exported (unrenamed) type, a builtin head, and the entry file's
/// own types all pass through unchanged. `rename` is
/// `namespace_private_renamer_for_path(path)`, built once per file.
fn eq_key_rename_ty(rename: (String) -> String, te: TypeExpr) -> TypeExpr {
  match te {
    TyName(n) => TyName(rename(n)),
    TyApp(n, args) => TyApp(rename(n), for a in args {
      eq_key_rename_ty(rename, a)
    }),
    TyTuple(items) => TyTuple(for a in items {
      eq_key_rename_ty(rename, a)
    }),
    _ => te
  }
}

/// #2441: the typed-`==` union -- the same per-file walk as
/// union_module_typed_lowering_offsets, but the rows are (offset, TypeExpr
/// key) pairs, so the rebase adds the plain byte base (no tag bits to
/// preserve) and each key's nominal names are rebased through the merge's
/// rename record (eq_key_rename_ty above). A key that does not parse is
/// dropped rather than passed through -- fail closed. Alias-collision clone
/// statements contribute no eq rows -- a cloned definition's `==` sites
/// simply degrade to the syntactic classifiers, which is today's behavior
/// for every site, never a wrong comparator.
export fn union_module_typed_eq_rows(flat_paths: Array[String], flat_bases: Array[Int]) -> (Array[Int], Array[String]) {
  let out_offs: Array[Int] = []
  let out_keys: Array[String] = []
  let mut i = 0
  while i < Array::length(flat_paths) {
    match module_typed_eq_rows_for_path(Array::get(flat_paths, i)) {
      Some((eq_offs, eq_keys)) => {
        let rename = namespace_private_renamer_for_path(Array::get(flat_paths, i))
        let base = Array::get(flat_bases, i)
        let mut j = 0
        while j < Array::length(eq_offs) {
          match impl_target_from_key(Array::get(eq_keys, j)) {
            Some(te) => {
              Array::push(out_offs, Array::get(eq_offs, j) + base)
              Array::push(out_keys, impl_target_key(eq_key_rename_ty(rename, te)))
            },
            None => ()
          }
          j = j + 1
        }
      },
      None => ()
    }
    i = i + 1
  }
  (out_offs, out_keys)
}

/// #2391 slice 2: decode one merged typed-lowering table into its channels --
/// Double call-result offsets (tag 0) for `CompileCtx.float_call_offsets`,
/// String relational anchors (tag 1) and String `+` anchors (tag 2) for the
/// rewrite pass, and the render/`eq` argument offsets the checker typed as
/// `Int` (tag 3), `Double` (tag 4) or `Bool` (tag 5). The encoding is the
/// checker's typed_lowering_enc; the enc/dec pair lives on the checker boundary
/// so the two sides cannot drift.
export fn split_typed_lowering_offsets(enc: Array[Int]) -> (Array[Int], Array[Int], Array[Int], Array[Int], Array[Int]) {
  let floats: Array[Int] = []
  let rels: Array[Int] = []
  let pluses: Array[Int] = []
  let int_renders: Array[Int] = []
  let bool_renders: Array[Int] = []
  let mut i = 0
  while i < Array::length(enc) {
    let value = Array::get(enc, i)
    let tag = typed_lowering_enc_tag(value)
    let off = typed_lowering_enc_offset(value)
    if tag == 0 {
      Array::push(floats, off)
    } else if tag == 1 {
      Array::push(rels, off)
    } else if tag == 2 {
      Array::push(pluses, off)
    } else if tag == 3 {
      // #2424: render (`__to_string` / `Int::to_string`) and `eq` ARGUMENT
      // offsets the checker typed as `Int`.
      Array::push(int_renders, off)
    } else if tag == 4 {
      // #2424: the Double half of the same argument set, unioned into the
      // Double channel. The two tags stay distinct through the encoding
      // because their KEYS differ -- tag 0 is a call node's own offset, tag 4
      // is `typed_lowering_arg_offset` (a projection answers with its
      // field-name offset) -- and they can share one array here because the
      // consumers read it with `typed_lowering_arg_offset`, which agrees with
      // the call offset on a call node.
      Array::push(floats, off)
    } else if tag == 5 {
      // #2462/#2464: the Bool half of the same argument set. Its own array
      // rather than unioned into another: the consumers are the
      // `*_expr_is_boolish` predicates, and a Bool offset reaching
      // `ts_known_int` would render `true` as a number -- the exact failure
      // this channel exists to stop.
      Array::push(bool_renders, off)
    } else if tag == 6 {
      // #2987: a render argument the checker typed as a shape the runtime
      // renderer cannot print. It rides the Int array under a NEGATIVE key
      // (`typed_render_refuse_key`), which no Int lookup can ask for, and the
      // `__to_string` lowering refuses the site instead of printing an address.
      Array::push(int_renders, typed_render_refuse_key(off))
    } else {
      // Tag 7 restores resolved callees before merge, outside these channels.
      // Dropping an unknown row degrades its site to
      // the syntactic classifiers rather than misclassifying another offset.
      ()
    }
    i = i + 1
  }
  (floats, rels, pluses, int_renders, bool_renders)
}

/// #2449 (Codex review on #2453): rebind `path`'s typed-lowering rows from the
/// memo BY FINGERPRINT, and report whether it could.
///
/// The in-memory module walk (`ensure_fingerprint`, runtime.vibe) skips the
/// check when the `TypeDb` already holds this module's fingerprint, and a skip
/// publishes nothing -- so the merge downstream reads whatever
/// `module_typed_lowering_offsets_for_path` happens to hold for that path,
/// which another compile in the same process may have overwritten. Measured
/// before this: rows for a path went 1 -> 0 across a warm-db re-prepare.
///
/// `false` means the rows are not available for this fingerprint, and the
/// caller must fall through to a real check rather than proceed -- the same
/// fail-closed rule `ensure_module_typed_lowering_offsets` gives the FS lane.
/// This is the memo-only sibling of that function: the in-memory walk carries
/// no `Fs` effect, so there is no disk record to fall back on.
///
/// Binding the hit to THIS path (not just proving the fingerprint) is the
/// #2425 rule: `build_fingerprint` excludes the module's own path, so two
/// byte-identical modules share a fingerprint and the consumer looks up by
/// path.
export fn rebind_module_typed_lowering_offsets(path: String, fingerprint: String) -> Bool {
  match module_typed_lowering_memo_get_by_fp(fingerprint) {
    Some((offsets, eq_offs, eq_keys)) => {
      let source = module_typed_lowering_source_for_fp(fingerprint)
      module_typed_lowering_memo_put(path, fingerprint, offsets, eq_offs, eq_keys)
      match source {
        Some(text) => module_typed_lowering_bind_source(path, fingerprint, text),
        None => ()
      }
      true
    },
    None => false
  }
}

/// The unified cache loader has already validated and hydrated both outputs.
/// Rebind by fingerprint so byte-identical modules at distinct paths agree.
export fn ensure_module_typed_lowering_offsets(path: String, fingerprint: String) -> Bool {
  rebind_module_typed_lowering_offsets(path, fingerprint)
}

// The accepting caller has validated a persistent/transported fingerprint for
// its current source. Bind that witness before any subsequent merge parse.
export fn ensure_module_typed_lowering_offsets_for_source(path: String, fingerprint: String, source: String) -> Bool {
  if rebind_module_typed_lowering_offsets(path, fingerprint) {
    module_typed_lowering_bind_source(path, fingerprint, source)
    true
  } else {
    false
  }
}

export fn typecheck_fs_lookup_env_cache(cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {
  let len = Array::length(cache)
  let mut i = 0
  let mut result = None
  let mut done = false
  while !done {
    if i >= len {
      done = true
    } else {
      let (p, env) = Array::get(cache, i)
      if p == path {
        result = Some(env)
        done = true
      } else {
        i = i + 1
      }
    }
  }
  result
}

export fn resolve_cached_import_path(base_dir: String, raw_path: String, cache: Array[(String, TypeEnv)]) -> String with Env {
  let candidates = resolve_import_path_candidates(base_dir, raw_path)
  let mut selected = ""
  let mut i = 0
  while i < Array::length(candidates) && selected == "" {
    let candidate = Array::get(candidates, i)
    match typecheck_fs_lookup_env_cache(cache, candidate) {
      Some(_) => {
        selected = candidate
      },
      None => ()
    }
    i = i + 1
  }
  if selected == "" {
    resolve_import_path(base_dir, raw_path)
  } else {
    selected
  }
}

export fn starts_with_upper(name: String) -> Bool {
  if String::length(name) == 0 {
    false
  } else {
    let c = String::char_code_at(name, 0)
    c >= 65 && c <= 90
  }
}

fn type_returns_name(ty: Type, type_name: String) -> Bool {
  match ty {
    CtEnum(name) => name == type_name,
    CtNamed(name, _) => name == type_name,
    CtFn(_, ret, _) => type_returns_name(ret, type_name),
    CtForAll(_, _, body) => type_returns_name(body, type_name),
    _ => false
  }
}

/// A builtin declaration becomes import authority only when the dependency
/// explicitly publishes it. This predicate is deliberately used solely while
/// constructing that published surface; import validation below never falls
/// back to builtin, registry, or effect-name recognition.
///
/// In a package contract (`strict`, see `checked_module_public_env_for_path`),
/// a type brought in from ANOTHER module (a re-export; the binding's origin
/// names that module) carries its constructors and the names its defining
/// module marked as members -- the methods of its impls and of its derives
/// (`local_type_member_markers`) -- and nothing else that shares its prefix or
/// returns it: those are published by declaring them. A signature is not
/// provenance, so a method is never recognized as derived by its shape.
/// Without this, a contract re-exporting a subset of a package --
/// `@vibe/concurrent` over `@vibe/concurrent/experimental` -- published the
/// rest too: listing `TaskGroup` / `TaskHandle` carried
/// `TaskGroup::spawn_suspend` (by prefix) and `TaskGroup::adopt` (it returns
/// `TaskHandle`) past a contract that declares neither. Every other module,
/// and a type declared in the publishing module, keeps the older rule, which
/// is how derived methods that no export list names reach an importer.
///
/// A member marker itself travels with its type, in every module.
export fn is_selected_type_companion(name: String, binding: EnvValueBinding, type_surface: Array[String], all_defs: Array[TypeDef], members: Array[String], strict: Bool) -> Bool {
  let marker_prefix = type_member_marker("")
  if String::starts_with(name, marker_prefix) {
    let member_name = String::substring(name, String::length(marker_prefix), String::length(name))
    let sep = String::index_of(member_name, "::")
    return sep > 0 && contains_str(type_surface, String::substring(member_name, 0, sep))
  }
  let foreign = strict && (match binding.origin {
    BindingOriginUnavailable => false,
    _ => true
  })
  let qualified = String::index_of(name, "::") >= 0
  let mut i = 0
  let mut selected = false
  while i < Array::length(type_surface) && !selected {
    let type_name = Array::get(type_surface, i)
    let own = String::concat(type_name, "::")
    let member = if String::starts_with(name, own) {
      String::substring(name, String::length(own), String::length(name))
    } else {
      ""
    }
    let keep = if name == type_name {
      true
    } else if !foreign {
      String::starts_with(name, own) || type_returns_name(binding.ty, type_name)
    } else if !qualified {
      // An unqualified foreign companion is a bare constructor or nothing:
      // `make_t() -> T` imported beside `T` is not published by listing `T`
      // (Codex on #3172).
      type_returns_name(binding.ty, type_name) && is_enum_variant_of(all_defs, type_name, name)
    } else {
      // A re-export under another name (`struct Ver as PublicVer`) renames the
      // companion and its marker; the source spelling is also accepted, since
      // an alias can reach a module whose markers still name the source.
      let source = alias_source_head(all_defs, type_name)
      let source_name = String::concat(source, String::concat("::", member))
      String::length(member) > 0 && (is_enum_variant_of(all_defs, type_name, member) || contains_str(members, name) || contains_str(members, source_name))
    }
    if keep {
      selected = true
    } else {
      i = i + 1
    }
  }
  selected
}

/// The marker a module publishes beside each qualified binding that belongs to
/// a type rather than being a free function spelled under it: a method of an
/// impl for that type (supertrait methods included) and a method a `derive`
/// binds. `fn T::helper` gets none. The marker travels with the type: the
/// import projection renames it with the companion
/// (`bind_enum_constructor_companions`), and a package contract re-exporting
/// `T` from another module publishes exactly the `T::*` names that carry one.
/// It is computed where the impl and the derive are visible -- the defining
/// module -- because the projection into a facade keeps a trait's definition
/// and impls only when the facade selects that trait, so by the time a
/// contract publishes, the impl table no longer holds them (Codex on #3172).
fn type_member_marker(name: String) -> String {
  String::concat("#type-member:", name)
}

/// The names a module's own impls and derives bind under a type, as markers.
/// An impl method is read from the environment's impl table, following
/// supertraits, since the impl names its trait and the trait its methods. A
/// derived method has no declaration in the source, so it is a qualified
/// binding under a type this module declares WITH a derive list that no
/// statement declares. Anything else under `T::` is a free function.
export fn local_type_member_markers(stmts: Array[Stmt], env: TypeEnv) -> Array[String] {
  let declared = array_empty()
  let deriving = array_empty()
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      SLet(_, _, name, _, _) => Array::push(declared, name),
      SFnDecl(_, name, _, _, _) => Array::push(declared, name),
      SExternLet(name, _) => Array::push(declared, name),
      SStruct(_, name, _, derives, _, _) => if Array::length(derives) > 0 {
        Array::push(deriving, name)
      },
      SEnum(_, name, _, _, derives) => if Array::length(derives) > 0 {
        Array::push(deriving, name)
      },
      _ => ()
    }
    si = si + 1
  }
  let traits = array_empty()
  let impls = array_empty()
  let locals = array_empty()
  let mut cur = env
  let mut going = true
  while going {
    match cur {
      EnvEmpty => going = false,
      EnvBind(name, binding, rest) => {
        match binding.origin {
          BindingOriginUnavailable => Array::push(locals, name),
          _ => ()
        }
        cur = rest
      },
      EnvMutCell(_, _, rest) => cur = rest,
      EnvTraitDef(tname, supers, _, methods, rest, _, _) => {
        Array::push(traits, (trait_ref_name(tname), supers, methods))
        cur = rest
      },
      // An impl of a parameterized trait is keyed by the applied reference
      // (`Value[Int]`); its definition by the bare name.
      EnvTraitImpl(tname, target, rest) => {
        Array::push(impls, (trait_ref_name(tname), type_head_name(target)))
        cur = rest
      },
      EnvTraitImplGen(tname, _, _, target, rest) => {
        Array::push(impls, (trait_ref_name(tname), type_head_name(target)))
        cur = rest
      },
      EnvTypeDefs(_, _, rest) => cur = rest,
      EnvFlat(bindings) => {
        let mut fi = 0
        while fi < Array::length(bindings) {
          let (name, binding) = Array::get(bindings, fi)
          match binding.origin {
            BindingOriginUnavailable => Array::push(locals, name),
            _ => ()
          }
          fi = fi + 1
        }
        going = false
      },
      EnvCached(_, _, rest) => cur = rest
    }
  }
  let out = array_empty()
  let mut i = 0
  while i < Array::length(impls) {
    let (tname, head) = Array::get(impls, i)
    if String::length(head) > 0 {
      // The impl's trait and, transitively, its supertraits: an impl may
      // define an inherited method (`formal_field_access_test.vibe`).
      let pending = array_empty()
      Array::push(pending, tname)
      let visited = array_empty()
      let mut w = 0
      while w < Array::length(pending) {
        let t = Array::get(pending, w)
        w = w + 1
        if !contains_str(visited, t) {
          Array::push(visited, t)
          let mut k = 0
          while k < Array::length(traits) {
            let (dname, supers, methods) = Array::get(traits, k)
            if dname == t {
              let mut m = 0
              while m < Array::length(methods) {
                let (mname, _, _) = Array::get(methods, m)
                let marker = type_member_marker(String::concat(head, String::concat("::", mname)))
                if !contains_str(out, marker) {
                  Array::push(out, marker)
                }
                m = m + 1
              }
              let mut u = 0
              while u < Array::length(supers) {
                Array::push(pending, trait_ref_name(Array::get(supers, u)))
                u = u + 1
              }
            }
            k = k + 1
          }
        }
      }
    }
    i = i + 1
  }
  let mut li = 0
  while li < Array::length(locals) {
    let name = Array::get(locals, li)
    let sep = String::index_of(name, "::")
    if sep > 0 && contains_str(deriving, String::substring(name, 0, sep)) && !contains_str(declared, name) {
      let marker = type_member_marker(name)
      if !contains_str(out, marker) {
        Array::push(out, marker)
      }
    }
    li = li + 1
  }
  out
}

export fn bind_type_member_markers(env: TypeEnv, markers: Array[String]) -> TypeEnv {
  let mut acc = env
  let mut i = 0
  while i < Array::length(markers) {
    acc = env_bind(acc, Array::get(markers, i), CtUnit)
    i = i + 1
  }
  acc
}

/// The `T::m` names the markers in an environment speak for.
export fn env_type_member_names(env: TypeEnv) -> Array[String] {
  let prefix = type_member_marker("")
  let plen = String::length(prefix)
  let out = array_empty()
  let mut cur = env
  let mut going = true
  while going {
    match cur {
      EnvEmpty => going = false,
      EnvBind(name, _, rest) => {
        if String::starts_with(name, prefix) {
          Array::push(out, String::substring(name, plen, String::length(name)))
        }
        cur = rest
      },
      EnvMutCell(_, _, rest) => cur = rest,
      EnvTraitDef(_, _, _, _, rest, _, _) => cur = rest,
      EnvTraitImpl(_, _, rest) => cur = rest,
      EnvTraitImplGen(_, _, _, _, rest) => cur = rest,
      EnvTypeDefs(_, _, rest) => cur = rest,
      EnvFlat(bindings) => {
        let mut fi = 0
        while fi < Array::length(bindings) {
          let (name, _) = Array::get(bindings, fi)
          if String::starts_with(name, prefix) {
            Array::push(out, String::substring(name, plen, String::length(name)))
          }
          fi = fi + 1
        }
        going = false
      },
      EnvCached(_, _, rest) => cur = rest
    }
  }
  out
}

/// The type a name stands for once type aliases are followed (`PublicVer` for
/// `Ver` after `struct Ver as PublicVer`); the name itself when it is no alias.
fn alias_source_head(defs: Array[TypeDef], name: String) -> String {
  let mut target = name
  let mut fuel = 8
  let mut going = true
  while going && fuel > 0 {
    fuel = fuel - 1
    let mut next = ""
    let mut i = 0
    while i < Array::length(defs) {
      match Array::get(defs, i) {
        TDAlias(n, _, body) => if n == target {
          next = type_head_name(body)
        },
        _ => ()
      }
      i = i + 1
    }
    if String::length(next) == 0 || next == target {
      going = false
    } else {
      target = next
    }
  }
  target
}

fn type_head_name(t: Type) -> String {
  match t {
    CtStruct(n) => n,
    CtEnum(n) => n,
    CtNamed(n, _) => n,
    CtForAll(_, _, body) => type_head_name(body),
    _ => ""
  }
}

/// Is `variant` a constructor of the enum `type_name` names? A re-export under
/// another name (`export ./p.vibe { enum Choice as PublicChoice }`) projects
/// `PublicChoice` as an alias of `Choice`, so an alias is followed to the enum
/// it stands for (Codex on #3172).
fn is_enum_variant_of(defs: Array[TypeDef], type_name: String, variant: String) -> Bool {
  let mut target = type_name
  let mut fuel = 8
  let mut found = false
  let mut going = true
  while going && fuel > 0 {
    fuel = fuel - 1
    let mut next = ""
    let mut i = 0
    while i < Array::length(defs) {
      match Array::get(defs, i) {
        TDEnum(n, _, variants) => if n == target {
          let mut k = 0
          while k < Array::length(variants) {
            let (vn, _) = Array::get(variants, k)
            if vn == variant {
              found = true
            }
            k = k + 1
          }
        },
        TDAlias(n, _, body) => if n == target {
          next = match body {
            CtEnum(h) => h,
            CtNamed(h, _) => h,
            _ => ""
          }
        },
        _ => ()
      }
      i = i + 1
    }
    if found || String::length(next) == 0 || next == target {
      going = false
    } else {
      target = next
    }
  }
  found
}

/// Companions bound alongside an imported type `T`: (a) constructors and
/// constructor-like functions RETURNING T (the original rule -- written
/// for enum constructors, whose type is always `... -> T`), and (b) any
/// export whose NAME is qualified with `T::` (#1080): the #777
/// `Json::string`-style direct-value accessors are exported under the
/// type's qualified namespace but RETURN a different type (String/Int/
/// Bool/...), so rule (a) never bound them -- importing `{ Json }` gave
/// you `Json::parse`/`Json::field` (return Json, matched (a) by
/// coincidence) but "unknown name: Json::string" for the other 8 of the
/// 11 documented accessors. The bundle-merge lane resolves these by name
/// against the merged unit and never had the gap; only this FS lane did.
/// Accelerator rows are derived indexes. Provenance comes from the actual
/// published chain, including surface-only entries and EnvFlat's real rows.
fn selected_authoritative_binding_origin(env: TypeEnv, name: String) -> Option[BindingOrigin] {
  let mut cur = env
  let mut result = None
  let mut done = false
  while !done {
    match cur {
      EnvEmpty => done = true,
      EnvBind(n, binding, rest) => if n == name {
        result = Some(binding.origin)
        done = true
      } else {
        cur = rest
      },
      EnvMutCell(_, _, rest) => cur = rest,
      EnvTraitDef(_, _, _, _, rest, _, _) => cur = rest,
      EnvTraitImpl(_, _, rest) => cur = rest,
      EnvTraitImplGen(_, _, _, _, rest) => cur = rest,
      EnvTypeDefs(_, _, rest) => cur = rest,
      EnvCached(_, _, rest) => cur = rest,
      EnvFlat(bindings) => {
        let mut i = 0
        while i < Array::length(bindings) && !done {
          let (n, binding) = Array::get(bindings, i)
          if n == name {
            result = Some(binding.origin); done = true
          } else {
            i = i + 1
          }
        }
        done = true
      }
    }
  }
  result
}

export fn selected_module_binding_origin(dep_env: TypeEnv, resolved: String, source_name: String, reexport_surface_only: Bool) -> BindingOrigin {
  // Preserve an ultimate module origin already carried by a facade binding.
  // Replacing it with `resolved` at every import hop loses semantic provenance
  // such as the canonical @vibe/builtin AsyncIter constructors.
  let (path, original_name) = match selected_authoritative_binding_origin(dep_env, source_name) {
    Some(origin) => match origin {
      BindingOriginModuleExport(origin_path, origin_name) => (origin_path, origin_name),
      BindingOriginReExportSurface(origin_path, origin_name) => (origin_path, origin_name),
      BindingOriginUnavailable => (resolved, source_name)
    },
    None => (resolved, source_name)
  }
  if reexport_surface_only {
    BindingOriginReExportSurface(path, original_name)
  } else {
    BindingOriginModuleExport(path, original_name)
  }
}

export fn bind_enum_constructor_companions(acc: TypeEnv, dep_env: TypeEnv, resolved: String, dep_bindings: Array[(String, Type)], source_owner: String, local_owner: String, trait_mappings: Array[(String, String)], reexport_surface_only: Bool) -> TypeEnv {
  let qual_prefix = String::concat(source_owner, "::")
  let mut out = acc
  let marker_prefix = type_member_marker(qual_prefix)
  let members = array_empty()
  let mut mi = 0
  while mi < Array::length(dep_bindings) {
    let (bname, _) = Array::get(dep_bindings, mi)
    if String::starts_with(bname, marker_prefix) {
      Array::push(members, String::substring(bname, String::length(type_member_marker("")), String::length(bname)))
    }
    mi = mi + 1
  }
  // #1908: the dep's flat bindings can carry a name twice — the authoritative
  // generalized scheme first, then a stale shadowed duplicate from the dep's
  // own checking (e.g. the pre-generalization recursion binding of an `fn
  // T::method`, still an unresolved var). `env_lookup_flat` answers with the
  // FIRST entry, so an explicit `import { T::method }` transported the real
  // scheme — but this loop bound every occurrence, and binds shadow earlier
  // binds, so the LAST (stale, var-typed) duplicate won. The importing
  // checker then typed `T::method(...)` as `?`, which silently disabled
  // method-style dispatch on the result (`T::of(..) |> length` reported
  // `unknown name: length`) and indexed-for classification. Bind each
  // companion once, from its first flat entry, matching env_lookup_flat.
  let seen = array_empty()
  let mut i = 0
  while i < Array::length(dep_bindings) {
    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)
    if candidate_name != source_owner && starts_with_upper(candidate_name) && (type_returns_name(candidate_ty, source_owner) || String::starts_with(candidate_name, qual_prefix)) {
      if contains_str(seen, candidate_name) {
        ()
      } else {
        Array::push(seen, candidate_name)
        let local_name = if source_owner != local_owner && String::starts_with(candidate_name, qual_prefix) {
          String::concat(local_owner, String::substring(candidate_name, String::length(source_owner), String::length(candidate_name)))
        } else {
          candidate_name
        }
        out = env_bind_with_origin(out, local_name, trait_projection_map_type_bounds(candidate_ty, trait_mappings), selected_module_binding_origin(dep_env, resolved, candidate_name, reexport_surface_only))
        // A member marker follows its companion, renamed with it, so a
        // contract further down can tell an impl or derived method from a
        // free function under the same type (`local_type_member_markers`).
        if contains_str(members, candidate_name) {
          out = env_bind(out, type_member_marker(local_name), CtUnit)
        }
      }
    }
    i = i + 1
  }
  out
}

/// #1521: an import of a name the dependency does not export binds `CtUnknown`
/// below, which unifies with anything, so every USE of that name typechecks
/// and the program only fails in codegen with `undefined variable (ident): X`
/// -- no file, no line. `unresolved` collects those names so the caller can
/// turn them into a real diagnostic; pass a throwaway array to opt out.
///
/// The `dep_known` guard is load-bearing. A dependency whose environment is
/// not in this cache -- a `@pkg` import, or an entry not computed yet --
/// yields `EnvEmpty`, and then EVERY name looks missing. Reporting those is a
/// false positive on correct code, and it is the failure mode that sank the
/// two earlier attempts at this check (one keyed off the merged environment,
/// one off a lane `vibe check` does not use).
///
/// Only names the dependency's VALUE environment can speak for are reported:
/// `starts_with_upper` names may be a struct or a type alias, and those are
/// not bindings at all -- they live in `defs`, which this cache does not
/// carry -- so "absent here" does not mean "not exported" for them. Enums and
/// their constructors DO appear, but there is no way at this point to tell an
/// unexported `Foo` from a struct-only `Foo`, so the uppercase half of #1521
/// stays open rather than risk rejecting valid code.
///
/// #1533 (closed): this membership test IS the export test for lowercase
/// names, because the environment a dependency publishes is no longer its
/// full checked environment -- check_module restricts it to the module's
/// export surface before it reaches any cache (see
/// restrict_env_to_export_surface). `import ./dep.vibe { private_fn }` is
/// therefore reported here, with the same message as a name that never
/// existed: from the importer's side those are the same fact, "the
/// dependency does not export this name".

//# Trait-aware dependency projection (#1549)

/// Trait declaration/implementation authority is not part of
/// `env_flat_bindings`, so importing a bounded value used to drop the exact
/// declarations needed to check that value at its consumer. This projection is
/// intentionally limited to TypeEnv's trait nodes: typedef and effect
/// declarations have different transport contracts.
export fn trait_projection_mapping(mappings: Array[(String, String)], canonical: String) -> Option[String] {
  let mut i = 0
  let mut found = None
  while i < Array::length(mappings) && found == None {
    let (source_name, local_name) = Array::get(mappings, i)
    if source_name == canonical {
      found = Some(local_name)
    } else {
      i = i + 1
    }
  }
  found
}

/// Project only the trait constructor spelling while preserving its applied
/// arguments. Applied references use an AST key internally, so treating the
/// complete key as an ordinary name loses explicit import aliases.
export fn trait_projection_map_ref(label: String, mappings: Array[(String, String)]) -> String {
  let source_name = trait_ref_name(label)
  match trait_projection_mapping(mappings, source_name) {
    Some(mapped) => match trait_ref_from_key(label) {
      Some(applied) => match applied {
        TyApp(_, args) => trait_ref_key(TyApp(mapped, args)),
        _ => mapped
      },
      None => mapped
    },
    None => label
  }
}

fn trait_projection_local_owner(mappings: Array[(String, String)], local_name: String) -> Option[String] {
  let mut i = 0
  let mut found = None
  while i < Array::length(mappings) && found == None {
    let (source_name, candidate_local) = Array::get(mappings, i)
    if candidate_local == local_name {
      found = Some(source_name)
    } else {
      i = i + 1
    }
  }
  found
}

export fn trait_projection_add_mapping(mappings: Array[(String, String)], canonical: String, local_name: String) -> Unit {
  if trait_projection_mapping(mappings, canonical) == None {
    Array::push(mappings, (canonical, local_name))
  } else {
    ()
  }
}

/// A local trait spelling owns exactly one dependency-qualified authority.
/// Keep these claims across every import in a module: otherwise two unrelated
/// traits imported as the same local name would leave one definition and the
/// other's impls/methods in the TypeEnv, depending on import order.
fn trait_projection_claim_local(claims: Array[(String, String, Bool, String)], canonical: String) -> Option[String] {
  let mut i = 0
  let mut found = None
  while i < Array::length(claims) && found == None {
    let (candidate_canonical, local_name, _, _) = Array::get(claims, i)
    if candidate_canonical == canonical {
      found = Some(local_name)
    } else {
      i = i + 1
    }
  }
  found
}

fn trait_projection_claim_owner(claims: Array[(String, String, Bool, String)], local_name: String) -> Option[(String, Bool, String)] {
  let mut i = 0
  let mut found = None
  while i < Array::length(claims) && found == None {
    let (canonical, candidate_local, explicit_alias, fingerprint) = Array::get(claims, i)
    if candidate_local == local_name {
      found = Some((canonical, explicit_alias, fingerprint))
    } else {
      i = i + 1
    }
  }
  found
}

/// Serialize a trait's definition shape (auto marker, params, supers, method
/// signatures, per-method generic bounds) so two same-named traits imported
/// from different modules can be compared for identity. Equal fingerprints
/// mean one definition seen through re-export paths; differing fingerprints
/// mean two distinct traits sharing a spelling (#1910), which must not be
/// resolved silently by import order.
fn trait_projection_def_fingerprint(env: TypeEnv, name: String) -> String {
  trait_projection_def_fingerprint_scan(env, env, name, array_empty())
}

/// Referenced trait labels (supers, method-generic bounds) are compared by
/// their own definition shape, not by spelling: a facade that re-exports
/// `Child` while aliasing its supertrait publishes `Child: P`, and that
/// spelling difference must not read as two different `Child` definitions.
/// A label already on the traversal path is emitted as `rec@<position>` so
/// repeated references stay position-stable; a label with no definition in
/// the environment keeps its spelling (`?<label>`), which is canonical
/// exactly because it cannot be projected under an alias.
fn trait_projection_ref_fingerprint(full: TypeEnv, label: String, visited: Array[String]) -> String {
  let mut idx = 0
  let mut found = -1
  while idx < Array::length(visited) {
    if Array::get(visited, idx) == label {
      found = idx
      idx = Array::length(visited)
    } else {
      idx = idx + 1
    }
  }
  if found >= 0 {
    String::concat("rec@", __to_string(found))
  } else {
    let sub = trait_projection_def_fingerprint_scan(full, full, label, visited)
    if sub == "" {
      String::concat("?", label)
    } else {
      String::concat("(", String::concat(sub, ")"))
    }
  }
}

fn trait_projection_def_fingerprint_scan(cur: TypeEnv, full: TypeEnv, name: String, visited: Array[String]) -> String {
  match cur {
    EnvEmpty => "",
    EnvBind(_, _, rest) => trait_projection_def_fingerprint_scan(rest, full, name, visited),
    EnvTraitDef(candidate, supers, is_auto, methods, rest, params, method_gens) => if candidate == name {
      Array::push(visited, name)
      let mut out = if is_auto {
        "auto"
      } else {
        "trait"
      }
      let mut i = 0
      while i < Array::length(params) {
        out = String::concat(out, String::concat(";param=", Array::get(params, i)))
        i = i + 1
      }
      i = 0
      while i < Array::length(supers) {
        out = String::concat(out, String::concat(";super=", trait_projection_ref_fingerprint(full, Array::get(supers, i), visited)))
        i = i + 1
      }
      i = 0
      while i < Array::length(methods) {
        let (mname, args, ret) = Array::get(methods, i)
        out = String::concat(out, String::concat(";method=", mname))
        let mut j = 0
        while j < Array::length(args) {
          out = String::concat(out, String::concat(":", print_type_expr(Array::get(args, j))))
          j = j + 1
        }
        out = String::concat(out, String::concat("->", print_type_expr(ret)))
        i = i + 1
      }
      i = 0
      while i < Array::length(method_gens) {
        let (mname, gparams, bounds) = Array::get(method_gens, i)
        out = String::concat(out, String::concat(";gen=", mname))
        let mut j = 0
        while j < Array::length(gparams) {
          out = String::concat(out, String::concat(":", Array::get(gparams, j)))
          j = j + 1
        }
        j = 0
        while j < Array::length(bounds) {
          let (bparam, labels) = Array::get(bounds, j)
          out = String::concat(out, String::concat(";bound=", bparam))
          let mut k = 0
          while k < Array::length(labels) {
            out = String::concat(out, String::concat(":", trait_projection_ref_fingerprint(full, Array::get(labels, k), visited)))
            k = k + 1
          }
          j = j + 1
        }
        i = i + 1
      }
      out
    } else {
      trait_projection_def_fingerprint_scan(rest, full, name, visited)
    },
    EnvTraitImpl(_, _, rest) => trait_projection_def_fingerprint_scan(rest, full, name, visited),
    EnvMutCell(_, _, rest) => trait_projection_def_fingerprint_scan(rest, full, name, visited),
    EnvTraitImplGen(_, _, _, _, rest) => trait_projection_def_fingerprint_scan(rest, full, name, visited),
    EnvTypeDefs(_, _, rest) => trait_projection_def_fingerprint_scan(rest, full, name, visited),
    EnvFlat(_) => "",
    EnvCached(_, _, rest) => trait_projection_def_fingerprint_scan(rest, full, name, visited)
  }
}

export fn trait_projection_claim_mappings(claims: Array[(String, String, Bool, String)], resolved: String, dep_env: TypeEnv, mappings: Array[(String, String)], unresolved: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(mappings) {
    let (source_name, local_name) = Array::get(mappings, i)
    let canonical = String::concat(String::concat(resolved, "::"), source_name)
    let explicit_alias = source_name != local_name
    let fingerprint = trait_projection_def_fingerprint(dep_env, source_name)
    match (trait_projection_claim_local(claims, canonical), trait_projection_claim_owner(claims, local_name)) {
      (Some(existing), _) => if existing != local_name {
        Array::push(unresolved, String::concat(String::concat(String::concat("ambiguous trait import '", canonical), "': aliases '"), String::concat(existing, String::concat("' and '", String::concat(local_name, "'")))))
      } else {
        ()
      },
      (None, Some((owner, owner_explicit, owner_fingerprint))) => if owner != canonical && (owner_explicit || explicit_alias) {
        // Same-spelled, unaliased traits retain the language's historical
        // name-based identity across re-export modules. An explicit alias is
        // different: merging two canonical names through it would silently
        // mix their impl and method authority.
        Array::push(unresolved, String::concat(String::concat(String::concat("ambiguous trait import alias '", local_name), "': used for '"), String::concat(owner, String::concat("' and '", String::concat(canonical, "'")))))
      } else {
        if owner != canonical && owner_fingerprint != fingerprint {
          // #1910: unaliased name-based identity is only safe when both
          // spellings are the same definition. Two packages defining a
          // same-named trait differently must not be merged by import order.
          Array::push(unresolved, String::concat(String::concat(String::concat("trait '", local_name), "' has two different definitions: '"), String::concat(owner, String::concat("' and '", String::concat(canonical, String::concat("' — alias one with 'trait ", String::concat(local_name, " as <NewName>' or import only one")))))))
        } else {
          Array::push(claims, (canonical, local_name, explicit_alias, fingerprint))
        }
      },
      (None, None) => Array::push(claims, (canonical, local_name, explicit_alias, fingerprint))
    }
    i = i + 1
  }
}

/// `trait_defined(env, name)` against the row env_trait_def_names_into
/// filled from `env` (#2386): the import projection asks it for every
/// imported name, every bound label and every supertrait of an edge, and
/// each answer used to walk the whole chain. The row holds a module's trait
/// names -- tens at most -- so a scan is the cheapest probe. An empty row
/// answers before normalizing the name: trait_ref_name allocates its parsed
/// reference, and most dependencies define no trait at all (the walk never
/// reached a compare there; measured +0.8 MB of cold heap when this
/// normalized unconditionally).
export fn trait_in_list(traits: Array[String], name: String) -> Bool {
  if Array::length(traits) == 0 {
    false
  } else {
    let base = trait_ref_name(name)
    let mut i = 0
    let mut found = false
    while !found && i < Array::length(traits) {
      if Array::get(traits, i) == base {
        found = true
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

/// Slots of `bindings` whose name starts uppercase, into a caller-owned row:
/// the companions and types the projection's per-name candidate scan can
/// ever select. Filled once per edge so the scan per imported name skips
/// the lowercase majority.
export fn uppercase_binding_slots_into(bindings: Array[(String, Type)], out: Array[Int]) -> Unit {
  Array::truncate(out, 0)
  let mut i = 0
  while i < Array::length(bindings) {
    let (name, _) = Array::get(bindings, i)
    if starts_with_upper(name) {
      Array::push(out, i)
    } else {
      ()
    }
    i = i + 1
  }
}

export fn trait_projection_supers(env: TypeEnv, name: String) -> Array[String] {
  match env {
    EnvEmpty => array_empty(),
    EnvBind(_, _, rest) => trait_projection_supers(rest, name),
    EnvTraitDef(candidate, supers, _, _, rest, _, _) => if candidate == name {
      supers
    } else {
      trait_projection_supers(rest, name)
    },
    EnvTraitImpl(_, _, rest) => trait_projection_supers(rest, name),
    EnvMutCell(_, _, rest) => trait_projection_supers(rest, name),
    EnvTraitImplGen(_, _, _, _, rest) => trait_projection_supers(rest, name),
    EnvTypeDefs(_, _, rest) => trait_projection_supers(rest, name),
    EnvFlat(_) => array_empty(),
    EnvCached(_, _, rest) => trait_projection_supers(rest, name)
  }
}

export fn trait_projection_collect_generic_impl_bounds(dep_env: TypeEnv, trait_name: String, mappings: Array[(String, String)], traits: Array[String]) -> Unit {
  match dep_env {
    EnvEmpty => (),
    EnvBind(_, _, rest) => trait_projection_collect_generic_impl_bounds(rest, trait_name, mappings, traits),
    EnvTraitDef(_, _, _, _, rest, _, _) => trait_projection_collect_generic_impl_bounds(rest, trait_name, mappings, traits),
    EnvTraitImpl(_, _, rest) => trait_projection_collect_generic_impl_bounds(rest, trait_name, mappings, traits),
    EnvMutCell(_, _, rest) => trait_projection_collect_generic_impl_bounds(rest, trait_name, mappings, traits),
    EnvTraitImplGen(candidate, _, bounds, _, rest) => {
      if trait_ref_name(candidate) == trait_ref_name(trait_name) {
        let mut i = 0
        while i < Array::length(bounds) {
          let (_, labels) = Array::get(bounds, i)
          let mut j = 0
          while j < Array::length(labels) {
            let label = Array::get(labels, j)
            let base = trait_ref_name(label)
            if trait_in_list(traits, label) {
              trait_projection_add_mapping(mappings, base, base)
            } else {
              ()
            }
            j = j + 1
          }
          i = i + 1
        }
      } else {
        ()
      }
      trait_projection_collect_generic_impl_bounds(rest, trait_name, mappings, traits)
    },
    EnvTypeDefs(_, _, rest) => trait_projection_collect_generic_impl_bounds(rest, trait_name, mappings, traits),
    EnvFlat(_) => (),
    EnvCached(_, _, rest) => trait_projection_collect_generic_impl_bounds(rest, trait_name, mappings, traits)
  }
}

export fn trait_projection_collect_type_bounds(ty: Type, mappings: Array[(String, String)], traits: Array[String]) -> Unit {
  match ty {
    CtForAll(_, bounds, body) => {
      let mut i = 0
      while i < Array::length(bounds) {
        let (_, labels) = Array::get(bounds, i)
        let mut j = 0
        while j < Array::length(labels) {
          let label = Array::get(labels, j)
          let base = trait_ref_name(label)
          if trait_in_list(traits, label) {
            trait_projection_add_mapping(mappings, base, base)
          } else {
            ()
          }
          j = j + 1
        }
        i = i + 1
      }
      trait_projection_collect_type_bounds(body, mappings, traits)
    },
    CtFn(args, ret, _) => {
      let mut i = 0
      while i < Array::length(args) {
        trait_projection_collect_type_bounds(Array::get(args, i), mappings, traits)
        i = i + 1
      }
      trait_projection_collect_type_bounds(ret, mappings, traits)
    },
    CtTuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        trait_projection_collect_type_bounds(Array::get(items, i), mappings, traits)
        i = i + 1
      }
    },
    CtArray(item) => trait_projection_collect_type_bounds(item, mappings, traits),
    CtOption(item) => trait_projection_collect_type_bounds(item, mappings, traits),
    CtNamed(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        trait_projection_collect_type_bounds(Array::get(args, i), mappings, traits)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// Rewrite every reachable Type that crosses the selected import boundary.
/// In particular, a value's `CtForAll` labels must agree with the local alias
/// of the projected trait authority; keeping the dependency spelling makes an
/// otherwise valid alias fail closed as an unknown trait at use sites.
export fn trait_projection_map_type_bounds(ty: Type, mappings: Array[(String, String)]) -> Type {
  match ty {
    CtForAll(vars, bounds, body) => CtForAll(vars, trait_projection_map_bound_rows(bounds, mappings), trait_projection_map_type_bounds(body, mappings)),
    CtFn(args, ret, effects) => {
      let mapped_args = array_empty()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(mapped_args, trait_projection_map_type_bounds(Array::get(args, i), mappings))
        i = i + 1
      }
      CtFn(mapped_args, trait_projection_map_type_bounds(ret, mappings), effects)
    },
    CtTuple(items) => {
      let mapped_items = array_empty()
      let mut i = 0
      while i < Array::length(items) {
        Array::push(mapped_items, trait_projection_map_type_bounds(Array::get(items, i), mappings))
        i = i + 1
      }
      CtTuple(mapped_items)
    },
    CtArray(item) => CtArray(trait_projection_map_type_bounds(item, mappings)),
    CtOption(item) => CtOption(trait_projection_map_type_bounds(item, mappings)),
    CtNamed(name, args) => {
      let mapped_args = array_empty()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(mapped_args, trait_projection_map_type_bounds(Array::get(args, i), mappings))
        i = i + 1
      }
      CtNamed(name, mapped_args)
    },
    _ => ty
  }
}

/// Explicit trait selections win regardless of their position among selected
/// values. A second pass then imports only traits required by selected value
/// schemes. Conflicting aliases fail closed instead of making import order an
/// unobservable authority choice.
export fn dependency_trait_projection_mappings(dep_env: TypeEnv, dep_bindings: Array[(String, Type)], dep_traits: Array[String], upper_slots: Array[Int], names: Array[ImportItem], unresolved: Array[String]) -> Array[(String, String)] {
  let mappings = array_empty()
  let mut i = 0
  // Pass one: reserve explicit trait aliases before inspecting value bounds.
  while i < Array::length(names) {
    let item = Array::get(names, i)
    let name = item.name
    let alias = item.alias
    if trait_in_list(dep_traits, name) {
      let local_name = match alias {
        Some(value) => value,
        None => name
      }
      match (trait_projection_mapping(mappings, name), trait_projection_local_owner(mappings, local_name)) {
        (Some(existing), _) => if existing != local_name {
          Array::push(unresolved, String::concat(String::concat(String::concat("ambiguous trait import '", name), "': aliases '"), String::concat(existing, String::concat("' and '", String::concat(local_name, "'")))))
        } else {
          ()
        },
        (None, Some(owner)) => if owner != name {
          Array::push(unresolved, String::concat(String::concat(String::concat("ambiguous trait import alias '", local_name), "': used for '"), String::concat(owner, String::concat("' and '", String::concat(name, "'")))))
        } else {
          trait_projection_add_mapping(mappings, name, local_name)
        },
        (None, None) => trait_projection_add_mapping(mappings, name, local_name)
      }
    } else {
      ()
    }
    i = i + 1
  }
  // Pass two: values import only the trait labels their reachable Type schemes
  // require. Explicit aliases above therefore always retain their spelling.
  i = 0
  while i < Array::length(names) {
    let name = Array::get(names, i).name
    if !trait_in_list(dep_traits, name) {
      match env_lookup_flat(dep_bindings, name) {
        Some(ty) => trait_projection_collect_type_bounds(ty, mappings, dep_traits),
        None => ()
      }
      // Companions (`Set::add`) carry `[T: Hash]` even when the type `Set`
      // itself does not. Walk them the same way bind_enum_constructor_companions
      // selects them, or importing `{ Set }` drops `impl Hash for Int`.
      let qual_prefix = String::concat(name, "::")
      let mut ui = 0
      while ui < Array::length(upper_slots) {
        let (candidate_name, candidate_ty) = Array::get(dep_bindings, Array::get(upper_slots, ui))
        if candidate_name != name && (String::starts_with(candidate_name, qual_prefix) || type_returns_name(candidate_ty, name)) {
          trait_projection_collect_type_bounds(candidate_ty, mappings, dep_traits)
        } else {
          ()
        }
        ui = ui + 1
      }
    } else {
      ()
    }
    i = i + 1
  }
  // Selected traits bring their supertrait closure. Unselected supers retain
  // their canonical source spelling because they have no explicit local alias.
  let mut cursor = 0
  while cursor < Array::length(mappings) {
    let (canonical, _) = Array::get(mappings, cursor)
    let supers = trait_projection_supers(dep_env, canonical)
    trait_projection_collect_generic_impl_bounds(dep_env, canonical, mappings, dep_traits)
    let mut j = 0
    while j < Array::length(supers) {
      let super_name = Array::get(supers, j)
      if trait_in_list(dep_traits, super_name) {
        let super_base = trait_ref_name(super_name)
        trait_projection_add_mapping(mappings, super_base, super_base)
      } else {
        ()
      }
      j = j + 1
    }
    cursor = cursor + 1
  }
  mappings
}

fn trait_projection_map_bound_rows(bounds: Array[(Int, Array[String])], mappings: Array[(String, String)]) -> Array[(Int, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(bounds) {
    let (param, labels) = Array::get(bounds, i)
    let mapped_labels = array_empty()
    let mut j = 0
    while j < Array::length(labels) {
      let label = Array::get(labels, j)
      Array::push(mapped_labels, trait_projection_map_ref(label, mappings))
      j = j + 1
    }
    Array::push(out, (param, mapped_labels))
    i = i + 1
  }
  out
}

export fn trait_projection_map_method_gens(method_gens: Array[(String, Array[String], Array[(String, Array[String])])], mappings: Array[(String, String)]) -> Array[(String, Array[String], Array[(String, Array[String])])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(method_gens) {
    let (name, params, bounds) = Array::get(method_gens, i)
    Array::push(out, (name, params, trait_projection_map_method_bound_rows(bounds, mappings)))
    i = i + 1
  }
  out
}

export fn trait_projection_map_method_bound_rows(bounds: Array[(String, Array[String])], mappings: Array[(String, String)]) -> Array[(String, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(bounds) {
    let (param, labels) = Array::get(bounds, i)
    let mapped_labels = array_empty()
    let mut j = 0
    while j < Array::length(labels) {
      let label = Array::get(labels, j)
      Array::push(mapped_labels, trait_projection_map_ref(label, mappings))
      j = j + 1
    }
    Array::push(out, (param, mapped_labels))
    i = i + 1
  }
  out
}

export fn typedef_projection_name(def: TypeDef) -> String {
  match def {
    TDEnum(name, _, _) => name,
    TDStruct(name, _, _, _) => name,
    TDAlias(name, _, _) => name,
    TDEffect(name, _, _) => name,
    TDEffectSet(name, _) => name
  }
}

export fn typedef_projection_contains(defs: Array[TypeDef], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(defs) && !found {
    if typedef_projection_name(Array::get(defs, i)) == name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn typedef_projection_add_type_refs(ty: Type, dep_defs: Array[TypeDef], selected: Array[TypeDef]) -> Unit {
  match ty {
    CtEnum(name) => typedef_projection_add_named(name, dep_defs, selected),
    CtStruct(name) => typedef_projection_add_named(name, dep_defs, selected),
    CtNamed(name, args) => {
      typedef_projection_add_named(name, dep_defs, selected)
      let mut i = 0
      while i < Array::length(args) {
        typedef_projection_add_type_refs(Array::get(args, i), dep_defs, selected)
        i = i + 1
      }
    },
    CtFn(args, ret, _) => {
      let mut i = 0
      while i < Array::length(args) {
        typedef_projection_add_type_refs(Array::get(args, i), dep_defs, selected)
        i = i + 1
      }
      typedef_projection_add_type_refs(ret, dep_defs, selected)
    },
    CtTuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        typedef_projection_add_type_refs(Array::get(items, i), dep_defs, selected)
        i = i + 1
      }
    },
    CtArray(item) => typedef_projection_add_type_refs(item, dep_defs, selected),
    CtOption(item) => typedef_projection_add_type_refs(item, dep_defs, selected),
    CtForAll(_, _, body) => typedef_projection_add_type_refs(body, dep_defs, selected),
    _ => ()
  }
}

export fn typedef_projection_add_named(name: String, dep_defs: Array[TypeDef], selected: Array[TypeDef]) -> Unit {
  if typedef_projection_contains(selected, name) {
    ()
  } else {
    let mut i = 0
    let mut found = None
    let mut done = false
    while i < Array::length(dep_defs) && !done {
      let def = Array::get(dep_defs, i)
      if typedef_projection_name(def) == name {
        found = Some(def)
        done = true
      } else {
        i = i + 1
      }
    }
    match found {
      Some(def) => {
        Array::push(selected, def)
        match def {
          TDEnum(_, _, variants) => {
            let mut vi = 0
            while vi < Array::length(variants) {
              let (_, fields) = Array::get(variants, vi)
              let mut fi = 0
              while fi < Array::length(fields) {
                typedef_projection_add_type_refs(Array::get(fields, fi), dep_defs, selected)
                fi = fi + 1
              }
              vi = vi + 1
            }
          },
          TDStruct(_, fields, _, _) => {
            let mut fi = 0
            while fi < Array::length(fields) {
              let (_, ty) = Array::get(fields, fi)
              typedef_projection_add_type_refs(ty, dep_defs, selected)
              fi = fi + 1
            }
          },
          TDAlias(_, _, target) => typedef_projection_add_type_refs(target, dep_defs, selected),
          TDEffect(_, ops, _) => {
            let mut oi = 0
            while oi < Array::length(ops) {
              let (_, params, ret) = Array::get(ops, oi)
              let mut pi = 0
              while pi < Array::length(params) {
                typedef_projection_add_type_refs(Array::get(params, pi), dep_defs, selected)
                pi = pi + 1
              }
              typedef_projection_add_type_refs(ret, dep_defs, selected)
              oi = oi + 1
            }
          },
          TDEffectSet(_, members) => {
            let mut mi = 0
            while mi < Array::length(members) {
              typedef_projection_add_named(Array::get(members, mi), dep_defs, selected)
              mi = mi + 1
            }
          }
        }
      },
      None => ()
    }
  }
}
