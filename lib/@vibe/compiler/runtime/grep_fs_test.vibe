//# Imports

// Filesystem-tier `vibe grep` (#1572 / #1943). Lives next to grep_fs.vibe
// rather than in grep_test.vibe: this file has to import grep_fs, and
// grep_fs imports typecheck_fs, whose `ModuleJob` is declared on the
// package contract. grep_test.vibe stays on the no-Fs seam so it can
// keep driving the pattern language as a plain sibling leaf import.

import ./grep_fs.vibe {
  grep_scan_fs_report, grep_scan_fs_report_limited
}

import @vibe/core {
  array_empty
}

//# Functions

fn no_strings() -> Array[String] {
  array_empty()
}

//# Tests

test "grep_scan_fs_report: unparseable file is skipped with a warning, not an abort (#1943)" {
  // The unparseable file is first in directory order so a silent abort
  // would drop the good file too. Empty stdout still means no matches;
  // the skip itself belongs on the warning sidecar.
  let dir = "_build/vibe_grep_unparsed_sweep"
  let bad = String::concat(dir, "/a_unparsed.vibe")
  let good = String::concat(dir, "/b_good.vibe")
  Fs::mkdir_p(dir)
  Fs::write_file(bad, "fn broken( {\n")
  Fs::write_file(good, "let n = Array::length([1])\n")
  let (hits, warn) = grep_scan_fs_report(dir, "Array::length($(x:exp))", no_strings(), no_strings(), "", false)
  inspect(hits, String::concat(good, ":1:9: Array::length([1])\t$x=[1]\n"))
  inspect(warn, String::concat("warning: grep: skipped `", String::concat(bad, "` because it could not be parsed\n")))
}

test "grep_scan_fs_report: the typed tier refuses with a diagnostic instead of trapping (#2914)" {
  // A tree-wide `--where` sweep dies at wasm32's 4 GiB ceiling, because every
  // matching file re-types its whole dependency closure. It used to surface as
  // `wasm trap: out of bounds memory access` plus a bare backtrace -- naming
  // neither the file nor the stage, and indistinguishable to the runtime from
  // a real pointer bug.
  //
  // Driven through the budget parameter rather than by actually exhausting
  // 3 GiB: a limit of 1 byte is always already exceeded, so the guard fires on
  // the first typed file. That exercises the REAL loop, not just the
  // predicate -- a predicate that is right and a loop that never consults it
  // look the same from outside, which is the proxy AGENTS.md's gate rules
  // warn about.
  let dir = "_build/vibe_grep_heap_guard"
  let f = String::concat(dir, "/a.vibe")
  Fs::mkdir_p(dir)
  Fs::write_file(f, "let n = Array::length([1])\n")
  let wheres = [String::concat("$x", " : Int")]
  let msg = handle {
    let (hits, _) = grep_scan_fs_report_limited(dir, "Array::length($(x:exp))", wheres, no_strings(), "", false, 1)
    String::concat("NO REFUSAL, got: ", hits)
  } with { Exception::Throw(e) => e }
  inspect(String::contains(msg, "ran out of address space"), "true")
  inspect(String::contains(msg, f), "true")
  inspect(String::contains(msg, "#2914"), "true")
}

test "grep_scan_fs_report: a reachable budget does not disturb the answer (#2914)" {
  // The control the refusal needs: with a budget the sweep never approaches,
  // the typed tier answers exactly as before. A guard that fired always would
  // satisfy the test above and break every real query.
  let dir = "_build/vibe_grep_heap_guard_ok"
  let f = String::concat(dir, "/a.vibe")
  Fs::mkdir_p(dir)
  Fs::write_file(f, "let n = Array::length([1])\n")
  let wheres = [String::concat("$x", " : Array[_]")]
  let (hits, warn) = grep_scan_fs_report_limited(dir, "Array::length($(x:exp))", wheres, no_strings(), "", false, 3221225472)
  inspect(hits, String::concat(f, ":1:9: Array::length([1])\t$x=[1]\n"))
  inspect(warn, "")
}
