//# Imports

import ./module_source.vibe {
  build_module_source_from_source
}

//# Misc

test "module source keeps statements reachable from entry and drops unused" {
  let src = "let helper = () -> { 1 }\nlet unused = () -> { 99 }\nlet cli_main = () -> { helper() }\n"
  let out = build_module_source_from_source(src, "cli_main")
  assert(String::contains(out, "cli_main"))
  assert(String::contains(out, "helper"))
  assert(not(String::contains(out, "unused")))
}

test "module source preserves the original text of a kept statement" {
  let src = "let cli_main = () -> { 42 }\n"
  let out = build_module_source_from_source(src, "cli_main")
  assert(String::contains(out, "let cli_main = () -> { 42 }"))
}

test "module source keeps transitively reachable definitions" {
  let src = "let leaf = () -> { 7 }\nlet mid = () -> { leaf() }\nlet dead = () -> { 0 }\nlet cli_main = () -> { mid() }\n"
  let out = build_module_source_from_source(src, "cli_main")
  assert(String::contains(out, "leaf"))
  assert(String::contains(out, "mid"))
  assert(not(String::contains(out, "dead")))
}

test "module source keeps #zero_alloc with its reachable function" {
  let src = "#zero_alloc\nfn cli_main() -> Int { 42 }\n"
  let out = build_module_source_from_source(src, "cli_main")
  assert(String::contains(out, "#zero_alloc\nfn cli_main"))
}
