//# Imports

import @vibe/compiler/cache {
  compact_source_fingerprint_memo,
  compact_string_fingerprint,
  normalize_persistent_cache_text,
  package_index_deps_are_current,
  persistent_dep_list_cache_path,
  persistent_leaf_fingerprint_cache_path,
  persistent_type_env_cache_path
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/core {
  BindingOrigin,
  EnvValueBinding,
  Type,
  TypeDef,
  TypeEnv,
  TypeExpr,
  env_cache,
  env_name_index_at,
  env_name_index_length,
  env_value_binding,
  env_value_binding_with_origin
}

import ./typed_lowering_codec.vibe {
  append_module_typed_lowering_text, parse_module_typed_lowering_offsets_text
}

/// Disk storage combines the outputs of one check. None means no table was
/// transported (e.g. a worker result), not a successfully checked empty table.
export struct PersistentModuleCache {
  env: TypeEnv;
  lowering: Option[(Array[Int], Array[Int], Array[String])]
}

//# Functions

fn parse_int_strict(raw: String) -> Int with Exception {
  let len = String::length(raw)
  if len == 0 {
    throw("invalid persistent type env integer")
  } else {
    let mut i = 0
    if String::char_code_at(raw, 0) == '-' {
      if len == 1 || String::char_code_at(raw, 1) == '0' {
        throw("invalid persistent type env integer")
      } else {
        i = 1
      }
    } else if String::char_code_at(raw, 0) == '0' && len > 1 {
      throw("invalid persistent type env integer")
    } else {
      ()
    }
    while i < len {
      let c = String::char_code_at(raw, i)
      if c < '0' || c > '9' {
        throw("invalid persistent type env integer")
      } else {
        i = i + 1
      }
    }
    match Int::parse(raw) {
      Some(value) => value,
      None => throw("invalid persistent type env integer")
    }
  }
}

/// One compile-owned sequence of pieces. Nested segments reserve a prefix
/// slot, emit their children once, and fill the slot with the measured byte
/// length. No nested payload String or second traversal is needed. The only
/// payload copy is the final join; pieces and prefix slots live until then.
struct CacheTextWriter {
  parts: Array[String];
  mut byte_count: Int
}

fn cache_text_writer() -> CacheTextWriter {
  CacheTextWriter::{ parts: [], byte_count: 0 }
}

fn cache_push(out: CacheTextWriter, text: String) -> Unit {
  Array::push(out.parts, text)
  out.byte_count = out.byte_count + String::length(text)
}

fn cache_segment(out: CacheTextWriter, text: String) -> Unit {
  cache_push(out, __to_string(String::length(text)))
  cache_push(out, ":")
  cache_push(out, text)
}

fn cache_reserve_segment(out: CacheTextWriter) -> Int {
  let slot = Array::length(out.parts)
  Array::push(out.parts, "")
  slot
}

fn cache_finish_segment(out: CacheTextWriter, slot: Int, body_start: Int) -> Unit {
  let prefix = String::concat(__to_string(out.byte_count - body_start), ":")
  Array::set(out.parts, slot, prefix)
  out.byte_count = out.byte_count + String::length(prefix)
}

fn write_count(out: CacheTextWriter, count: Int) -> Unit {
  cache_push(out, __to_string(count))
  cache_push(out, "[")
}

fn write_int_array(out: CacheTextWriter, items: Array[Int]) -> Unit {
  write_count(out, Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    cache_segment(out, __to_string(Array::get(items, i)))
    i = i + 1
  }
  cache_push(out, "]")
}

fn write_string_array(out: CacheTextWriter, items: Array[String]) -> Unit {
  write_count(out, Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    cache_segment(out, Array::get(items, i))
    i = i + 1
  }
  cache_push(out, "]")
}

fn write_bounds_array(out: CacheTextWriter, items: Array[(Int, Array[String])]) -> Unit {
  write_count(out, Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    let (id, bounds) = Array::get(items, i)
    cache_segment(out, __to_string(id))
    write_string_array(out, bounds)
    i = i + 1
  }
  cache_push(out, "]")
}

fn write_type_segment(out: CacheTextWriter, ty: Type) -> Unit {
  let slot = cache_reserve_segment(out)
  let start = out.byte_count
  write_type(out, ty)
  cache_finish_segment(out, slot, start)
}

fn write_type_array(out: CacheTextWriter, items: Array[Type]) -> Unit {
  write_count(out, Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    write_type_segment(out, Array::get(items, i))
    i = i + 1
  }
  cache_push(out, "]")
}

fn write_type(out: CacheTextWriter, ty: Type) -> Unit {
  match ty {
    CtInt => cache_push(out, "I"),
    CtDouble => cache_push(out, "D"),
    CtBool => cache_push(out, "B"),
    CtString => cache_push(out, "G"),
    CtChar => cache_push(out, "H"),
    CtUnit => cache_push(out, "U"),
    CtBytes => cache_push(out, "Y"),
    CtUnknown => cache_push(out, "X"),
    CtVar(id) => {
      cache_push(out, "V")
      cache_segment(out, __to_string(id))
    },
    CtConstructor(name, arity) => {
      cache_push(out, "J")
      cache_segment(out, name)
      cache_segment(out, __to_string(arity))
    },
    CtApplied(head, args) => {
      cache_push(out, "P")
      write_type_segment(out, head)
      write_type_array(out, args)
    },
    CtEnum(name) => {
      cache_push(out, "E"); cache_segment(out, name)
    },
    CtStruct(name) => {
      cache_push(out, "R"); cache_segment(out, name)
    },
    CtArray(elem) => {
      cache_push(out, "A"); write_type(out, elem)
    },
    CtOption(elem) => {
      cache_push(out, "O"); write_type(out, elem)
    },
    CtTuple(elems) => {
      cache_push(out, "T"); write_type_array(out, elems)
    },
    CtFn(params, ret, effect_name) => {
      cache_push(out, "F")
      cache_segment(out, match effect_name {
        Some(name) => name,
        None => ""
      })
      write_type_array(out, params)
      write_type(out, ret)
    },
    CtNamed(name, args) => {
      cache_push(out, "N")
      cache_segment(out, name)
      write_type_array(out, args)
    },
    CtForAll(vars, bounds, body) => {
      cache_push(out, "Q")
      write_int_array(out, vars)
      write_bounds_array(out, bounds)
      write_type(out, body)
    },
    CtRecord(fields) => {
      cache_push(out, "K")
      write_count(out, Array::length(fields))
      let mut i = 0
      while i < Array::length(fields) {
        let (name, field_type) = Array::get(fields, i)
        cache_segment(out, name)
        write_type_segment(out, field_type)
        i = i + 1
      }
      cache_push(out, "]")
    }
  }
}

fn write_type_expr_array(out: CacheTextWriter, items: Array[TypeExpr]) -> Unit {
  write_count(out, Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    let slot = cache_reserve_segment(out)
    let start = out.byte_count
    write_type_expr(out, Array::get(items, i))
    cache_finish_segment(out, slot, start)
    i = i + 1
  }
  cache_push(out, "]")
}

fn write_type_expr(out: CacheTextWriter, ty: TypeExpr) -> Unit {
  match ty {
    TyName(name) => {
      cache_push(out, "n"); cache_segment(out, name)
    },
    TyApp(name, args) => {
      cache_push(out, "a")
      cache_segment(out, name)
      write_type_expr_array(out, args)
    },
    TyFn(params, ret, effect_name) => {
      cache_push(out, "f")
      match effect_name {
        Some(name) => {
          cache_push(out, "1"); cache_segment(out, name)
        },
        None => cache_push(out, "0")
      }
      write_type_expr_array(out, params)
      write_type_expr(out, ret)
    },
    TyTuple(elems) => {
      cache_push(out, "t"); write_type_expr_array(out, elems)
    },
    TyUnit => cache_push(out, "u")
  }
}

fn write_string_bounds(out: CacheTextWriter, items: Array[(String, Array[String])]) -> Unit {
  write_count(out, Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    let (name, bounds) = Array::get(items, i)
    cache_segment(out, name)
    write_string_array(out, bounds)
    i = i + 1
  }
  cache_push(out, "]")
}

fn write_trait_methods(out: CacheTextWriter, items: Array[(String, Array[TypeExpr], TypeExpr)]) -> Unit {
  write_count(out, Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    let (name, params, ret) = Array::get(items, i)
    cache_segment(out, name)
    write_type_expr_array(out, params)
    write_type_expr(out, ret)
    i = i + 1
  }
  cache_push(out, "]")
}

fn write_trait_method_gens(out: CacheTextWriter, items: Array[(String, Array[String], Array[(String, Array[String])])]) -> Unit {
  write_count(out, Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    let (name, params, bounds) = Array::get(items, i)
    cache_segment(out, name)
    write_string_array(out, params)
    write_string_bounds(out, bounds)
    i = i + 1
  }
  cache_push(out, "]")
}

fn write_bindings(out: CacheTextWriter, items: Array[(String, Type)]) -> Unit {
  write_count(out, Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    let (name, ty) = Array::get(items, i)
    cache_segment(out, name)
    write_type(out, ty)
    i = i + 1
  }
  cache_push(out, "]")
}

fn write_type_def(out: CacheTextWriter, def: TypeDef) -> Unit {
  match def {
    TDEnum(name, params, variants) => {
      cache_push(out, "E")
      cache_segment(out, name)
      write_string_array(out, params)
      write_count(out, Array::length(variants))
      let mut i = 0
      while i < Array::length(variants) {
        let (variant, fields) = Array::get(variants, i)
        cache_segment(out, variant)
        write_type_array(out, fields)
        i = i + 1
      }
      cache_push(out, "]")
    },
    TDStruct(name, fields, mut_fields, params) => {
      cache_push(out, "S")
      cache_segment(out, name)
      write_bindings(out, fields)
      write_string_array(out, mut_fields)
      write_string_array(out, params)
    },
    TDAlias(name, params, target) => {
      cache_push(out, "A")
      cache_segment(out, name)
      write_string_array(out, params)
      write_type(out, target)
    },
    TDEffect(name, ops, params) => {
      cache_push(out, "K")
      cache_segment(out, name)
      write_string_array(out, params)
      write_count(out, Array::length(ops))
      let mut i = 0
      while i < Array::length(ops) {
        let (op, args, ret) = Array::get(ops, i)
        cache_segment(out, op)
        write_type_array(out, args)
        write_type(out, ret)
        i = i + 1
      }
      cache_push(out, "]")
    },
    TDEffectSet(name, members) => {
      cache_push(out, "Z")
      cache_segment(out, name)
      write_string_array(out, members)
    }
  }
}

fn write_type_defs(out: CacheTextWriter, defs: Array[TypeDef]) -> Unit {
  write_count(out, Array::length(defs))
  let mut i = 0
  while i < Array::length(defs) {
    let slot = cache_reserve_segment(out)
    let start = out.byte_count
    write_type_def(out, Array::get(defs, i))
    cache_finish_segment(out, slot, start)
    i = i + 1
  }
  cache_push(out, "]")
}

fn write_binding_origin(out: CacheTextWriter, origin: BindingOrigin) -> Unit {
  match origin {
    BindingOriginUnavailable => cache_push(out, "U"),
    BindingOriginModuleExport(path, name) => {
      cache_push(out, "M")
      cache_segment(out, path)
      cache_segment(out, name)
    },
    BindingOriginReExportSurface(path, name) => {
      cache_push(out, "R")
      cache_segment(out, path)
      cache_segment(out, name)
    }
  }
}

fn write_value_bindings(out: CacheTextWriter, items: Array[(String, EnvValueBinding)]) -> Unit {
  write_count(out, Array::length(items))
  let mut i = 0
  while i < Array::length(items) {
    let (name, binding) = Array::get(items, i)
    cache_segment(out, name)
    write_type(out, binding.ty)
    write_binding_origin(out, binding.origin)
    i = i + 1
  }
  cache_push(out, "]")
}

fn write_type_env(out: CacheTextWriter, env: TypeEnv) -> Unit {
  match env {
    EnvEmpty => cache_push(out, "0"),
    EnvBind(name, binding, rest) => {
      cache_push(out, "B")
      cache_segment(out, name)
      write_type(out, binding.ty)
      write_binding_origin(out, binding.origin)
      write_type_env(out, rest)
    },
    EnvMutCell(name, escapes, rest) => {
      cache_push(out, "M")
      cache_segment(out, name)
      cache_push(out, if escapes {
        "1"
      } else {
        "0"
      })
      write_type_env(out, rest)
    },
    EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens) => {
      cache_push(out, "D")
      cache_segment(out, name)
      write_string_array(out, supers)
      cache_push(out, if is_auto {
        "1"
      } else {
        "0"
      })
      write_trait_methods(out, methods)
      write_type_env(out, rest)
      write_string_array(out, params)
      write_trait_method_gens(out, method_gens)
    },
    EnvTraitImpl(name, target, rest) => {
      cache_push(out, "I")
      cache_segment(out, name)
      write_type(out, target)
      write_type_env(out, rest)
    },
    EnvTraitImplGen(name, params, bounds, target, rest) => {
      cache_push(out, "G")
      cache_segment(out, name)
      write_string_array(out, params)
      write_string_bounds(out, bounds)
      write_type(out, target)
      write_type_env(out, rest)
    },
    EnvTypeDefs(defs, selectable, rest) => {
      cache_push(out, "P")
      write_type_defs(out, defs)
      write_string_array(out, selectable)
      write_type_env(out, rest)
    },
    EnvFlat(bindings) => {
      cache_push(out, "L"); write_value_bindings(out, bindings)
    },
    EnvCached(_, _, rest) => {
      // Rebuild from the authoritative chain once. Stale accelerator arrays
      // must never become persisted semantics, including their type rows.
      match env_cache(rest) {
        EnvCached(names, bindings, _) => {
          cache_push(out, "C")
          write_count(out, env_name_index_length(names))
          let mut i = 0
          while i < env_name_index_length(names) {
            cache_segment(out, env_name_index_at(names, i))
            i = i + 1
          }
          cache_push(out, "]")
          write_count(out, Array::length(bindings))
          i = 0
          while i < Array::length(bindings) {
            write_type_segment(out, Array::get(bindings, i).ty)
            i = i + 1
          }
          cache_push(out, "]")
          write_type_env(out, rest)
        },
        _ => write_type_env(out, rest)
      }
    }
  }
}

fn write_type_env_segment(out: CacheTextWriter, env: TypeEnv) -> Unit {
  let slot = cache_reserve_segment(out)
  let start = out.byte_count
  write_type_env(out, env)
  cache_finish_segment(out, slot, start)
}

fn parse_count_header(text: String, pos: Int, terminator: Int) -> (Int, Int) with Exception {
  let len = String::length(text)
  let mut i = pos
  while i < len && String::char_code_at(text, i) != terminator {
    i = i + 1
  }
  if i == pos || i >= len {
    throw("invalid persistent type env payload")
  } else {
    let raw = text[pos: i]
    let count = parse_int_strict(raw)
    if count < 0 {
      throw("invalid persistent type env count")
    } else {
      (count, i + 1)
    }
  }
}

fn parse_segment(text: String, pos: Int) -> (String, Int) with Exception {
  let (seg_len, start) = parse_count_header(text, pos, ':')
  let end = start + seg_len
  if end < start || end > String::length(text) {
    throw("invalid persistent type env segment")
  } else {
    (text[start: end], end)
  }
}

fn parse_int_array(text: String, pos: Int) -> (Array[Int], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, next) = parse_segment(text, cursor)
    Array::push(items, parse_int_strict(raw))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env int array")
  } else {
    (items, cursor + 1)
  }
}

fn parse_string_array(text: String, pos: Int) -> (Array[String], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (item, next) = parse_segment(text, cursor)
    Array::push(items, item)
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env string array")
  } else {
    (items, cursor + 1)
  }
}

fn parse_bounds_array(text: String, pos: Int) -> (Array[(Int, Array[String])], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw_id, after_id) = parse_segment(text, cursor)
    let (bounds, next) = parse_string_array(text, after_id)
    Array::push(items, (parse_int_strict(raw_id), bounds))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env bounds array")
  } else {
    (items, cursor + 1)
  }
}

fn parse_type_array(text: String, pos: Int) -> (Array[Type], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, next) = parse_segment(text, cursor)
    let (item, end) = parse_cached_type(raw, 0)
    if end != String::length(raw) {
      throw("invalid persistent type env nested type")
    } else {
      Array::push(items, item)
      cursor = next
      i = i + 1
    }
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env type array")
  } else {
    (items, cursor + 1)
  }
}

fn parse_cached_type(source: String, pos: Int) -> (Type, Int) with Exception {
  if pos >= String::length(source) {
    throw("invalid persistent type env type")
  } else {
    match String::char_code_at(source, pos) {
      'I' => (CtInt, pos + 1),
      'D' => (CtDouble, pos + 1),
      'B' => (CtBool, pos + 1),
      'G' => (CtString, pos + 1),
      'H' => (CtChar, pos + 1),
      'U' => (CtUnit, pos + 1),
      'Y' => (CtBytes, pos + 1),
      'X' => (CtUnknown, pos + 1),
      'V' => {
        let (raw, next) = parse_segment(source, pos + 1)
        (CtVar(parse_int_strict(raw)), next)
      },
      'J' => {
        let (name, after_name) = parse_segment(source, pos + 1)
        let (raw_arity, next) = parse_segment(source, after_name)
        let arity = parse_int_strict(raw_arity)
        if arity <= 0 {
          throw("invalid persistent type constructor arity")
        } else {
          (CtConstructor(name, arity), next)
        }
      },
      'P' => {
        let (head_raw, after_head) = parse_segment(source, pos + 1)
        let (head, head_end) = parse_cached_type(head_raw, 0)
        if head_end != String::length(head_raw) {
          throw("invalid persistent applied type head")
        } else {
          let (args, next) = parse_type_array(source, after_head)
          if Array::length(args) == 0 {
            throw("invalid persistent applied type arguments")
          } else {
            (CtApplied(head, args), next)
          }
        }
      },
      'E' => {
        let (name, next) = parse_segment(source, pos + 1)
        (CtEnum(name), next)
      },
      'R' => {
        let (name, next) = parse_segment(source, pos + 1)
        (CtStruct(name), next)
      },
      'A' => {
        let (elem, next) = parse_cached_type(source, pos + 1)
        (CtArray(elem), next)
      },
      'O' => {
        let (elem, next) = parse_cached_type(source, pos + 1)
        (CtOption(elem), next)
      },
      'T' => {
        let (elems, next) = parse_type_array(source, pos + 1)
        (CtTuple(elems), next)
      },
      'F' => {
        let (effect, after_effect) = parse_segment(source, pos + 1)
        let (params, after_params) = parse_type_array(source, after_effect)
        let (ret, next) = parse_cached_type(source, after_params)
        let effect_name = if String::length(effect) == 0 {
          None
        } else {
          Some(effect)
        }
        (CtFn(params, ret, effect_name), next)
      },
      'N' => {
        let (name, after_name) = parse_segment(source, pos + 1)
        let (args, next) = parse_type_array(source, after_name)
        (CtNamed(name, args), next)
      },
      'Q' => {
        let (vars, after_vars) = parse_int_array(source, pos + 1)
        let (bounds, after_bounds) = parse_bounds_array(source, after_vars)
        let (body, next) = parse_cached_type(source, after_bounds)
        (CtForAll(vars, bounds, body), next)
      },
      // #1839: anonymous record — count-headed list of (name segment, type
      // segment) pairs, literal field order preserved.
      'K' => {
        let (count, start) = parse_count_header(source, pos + 1, '[')
        let rfields = array_empty()
        let mut ki = 0
        let mut kcursor = start
        while ki < count {
          let (kname, after_name) = parse_segment(source, kcursor)
          let (kraw, after_ty) = parse_segment(source, after_name)
          let (kty, kend) = parse_cached_type(kraw, 0)
          if kend != String::length(kraw) {
            throw("invalid persistent type env record field type")
          } else {
            Array::push(rfields, (kname, kty))
            kcursor = after_ty
            ki = ki + 1
          }
        }
        if kcursor >= String::length(source) || String::char_code_at(source, kcursor) != ']' {
          throw("invalid persistent type env record field list")
        } else {
          (CtRecord(rfields), kcursor + 1)
        }
      },
      _ => throw("invalid persistent type env type tag")
    }
  }
}

fn parse_type_expr_array(text: String, pos: Int) -> (Array[TypeExpr], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, next) = parse_segment(text, cursor)
    let (item, end) = parse_type_expr(raw, 0)
    if end != String::length(raw) {
      throw("invalid persistent type env nested type expr")
    } else {
      Array::push(items, item)
      cursor = next
      i = i + 1
    }
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env type expr array")
  } else {
    (items, cursor + 1)
  }
}

fn parse_type_expr(source: String, pos: Int) -> (TypeExpr, Int) with Exception {
  if pos >= String::length(source) {
    throw("invalid persistent type env type expr")
  } else {
    match String::char_code_at(source, pos) {
      'n' => {
        let (name, next) = parse_segment(source, pos + 1)
        (TyName(name), next)
      },
      'a' => {
        let (name, after_name) = parse_segment(source, pos + 1)
        let (args, next) = parse_type_expr_array(source, after_name)
        (TyApp(name, args), next)
      },
      'f' => {
        let effect_pos = pos + 1
        if effect_pos >= String::length(source) {
          throw("invalid persistent type env function type expr")
        } else {
          let tag = String::char_code_at(source, effect_pos)
          let (effect_name, after_effect) = if tag == '0' {
            (None, effect_pos + 1)
          } else if tag == '1' {
            let (name, next) = parse_segment(source, effect_pos + 1)
            (Some(name), next)
          } else {
            throw("invalid persistent type env function effect")
          }
          let (params, after_params) = parse_type_expr_array(source, after_effect)
          let (ret, next) = parse_type_expr(source, after_params)
          (TyFn(params, ret, effect_name), next)
        }
      },
      't' => {
        let (elems, next) = parse_type_expr_array(source, pos + 1)
        (TyTuple(elems), next)
      },
      'u' => (TyUnit, pos + 1),
      _ => throw("invalid persistent type env type expr tag")
    }
  }
}

fn parse_string_bounds(text: String, pos: Int) -> (Array[(String, Array[String])], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (name, after_name) = parse_segment(text, cursor)
    let (bounds, next) = parse_string_array(text, after_name)
    Array::push(items, (name, bounds))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env generic bounds")
  } else {
    (items, cursor + 1)
  }
}

fn parse_trait_methods(text: String, pos: Int) -> (Array[(String, Array[TypeExpr], TypeExpr)], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (name, after_name) = parse_segment(text, cursor)
    let (params, after_params) = parse_type_expr_array(text, after_name)
    let (ret, next) = parse_type_expr(text, after_params)
    Array::push(items, (name, params, ret))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env trait methods")
  } else {
    (items, cursor + 1)
  }
}

fn parse_trait_method_gens(text: String, pos: Int) -> (Array[(String, Array[String], Array[(String, Array[String])])], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (name, after_name) = parse_segment(text, cursor)
    let (params, after_params) = parse_string_array(text, after_name)
    let (bounds, next) = parse_string_bounds(text, after_params)
    Array::push(items, (name, params, bounds))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env trait method generics")
  } else {
    (items, cursor + 1)
  }
}

fn parse_type_def(text: String, pos: Int) -> (TypeDef, Int) with Exception {
  if pos >= String::length(text) {
    throw("invalid persistent type definition")
  } else {
    match String::char_code_at(text, pos) {
      'E' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (params, after_params) = parse_string_array(text, after_name)
        let (count, start) = parse_count_header(text, after_params, '[')
        let variants = array_empty()
        let mut i = 0
        let mut cursor = start
        while i < count {
          let (variant, after_variant) = parse_segment(text, cursor)
          let (fields, next) = parse_type_array(text, after_variant)
          Array::push(variants, (variant, fields))
          cursor = next
          i = i + 1
        }
        if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
          throw("invalid persistent enum definition")
        } else {
          (TDEnum(name, params, variants), cursor + 1)
        }
      },
      'S' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (fields, after_fields) = parse_bindings(text, after_name)
        let (mut_fields, after_mut_fields) = parse_string_array(text, after_fields)
        let (params, next) = parse_string_array(text, after_mut_fields)
        (TDStruct(name, fields, mut_fields, params), next)
      },
      'A' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (params, after_params) = parse_string_array(text, after_name)
        let (target, next) = parse_cached_type(text, after_params)
        (TDAlias(name, params, target), next)
      },
      'K' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (params, after_params) = parse_string_array(text, after_name)
        let (count, start) = parse_count_header(text, after_params, '[')
        let ops = array_empty()
        let mut i = 0
        let mut cursor = start
        while i < count {
          let (op, after_op) = parse_segment(text, cursor)
          let (args, after_args) = parse_type_array(text, after_op)
          let (ret, next) = parse_cached_type(text, after_args)
          Array::push(ops, (op, args, ret))
          cursor = next
          i = i + 1
        }
        if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
          throw("invalid persistent effect definition")
        } else {
          (TDEffect(name, ops, params), cursor + 1)
        }
      },
      'Z' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (members, next) = parse_string_array(text, after_name)
        (TDEffectSet(name, members), next)
      },
      _ => throw("invalid persistent type definition tag")
    }
  }
}

fn parse_type_defs(text: String, pos: Int) -> (Array[TypeDef], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let defs = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, after_raw) = parse_segment(text, cursor)
    let (def, end) = parse_type_def(raw, 0)
    if end != String::length(raw) {
      throw("invalid persistent type definition payload")
    } else {
      Array::push(defs, def)
      cursor = after_raw
      i = i + 1
    }
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type definitions")
  } else {
    (defs, cursor + 1)
  }
}

fn parse_binding_origin(text: String, pos: Int) -> (BindingOrigin, Int) with Exception {
  if pos >= String::length(text) {
    throw("invalid persistent binding origin")
  } else {
    match String::char_code_at(text, pos) {
      'U' => (BindingOriginUnavailable, pos + 1),
      'M' => {
        let (path, after_path) = parse_segment(text, pos + 1)
        let (name, next) = parse_segment(text, after_path)
        (BindingOriginModuleExport(path, name), next)
      },
      'R' => {
        let (path, after_path) = parse_segment(text, pos + 1)
        let (name, next) = parse_segment(text, after_path)
        (BindingOriginReExportSurface(path, name), next)
      },
      _ => throw("invalid persistent binding origin tag")
    }
  }
}

fn parse_value_bindings(text: String, pos: Int) -> (Array[(String, EnvValueBinding)], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (name, after_name) = parse_segment(text, cursor)
    let (ty, after_ty) = parse_cached_type(text, after_name)
    let (origin, next) = parse_binding_origin(text, after_ty)
    Array::push(items, (name, env_value_binding_with_origin(ty, origin)))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent TypeEnv value bindings")
  } else {
    (items, cursor + 1)
  }
}

fn parse_bindings(text: String, pos: Int) -> (Array[(String, Type)], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (name, after_name) = parse_segment(text, cursor)
    let (ty, next) = parse_cached_type(text, after_name)
    Array::push(items, (name, ty))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env bindings")
  } else {
    (items, cursor + 1)
  }
}

fn parse_persistent_type_env_payload(text: String, pos: Int) -> (TypeEnv, Int) with Exception {
  if pos >= String::length(text) {
    throw("invalid persistent type env")
  } else {
    match String::char_code_at(text, pos) {
      '0' => (EnvEmpty, pos + 1),
      'B' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (ty, after_ty) = parse_cached_type(text, after_name)
        let (origin, after_origin) = parse_binding_origin(text, after_ty)
        let (rest, next) = parse_persistent_type_env_payload(text, after_origin)
        (EnvBind(name, env_value_binding_with_origin(ty, origin), rest), next)
      },
      'M' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        if after_name >= String::length(text) {
          throw("invalid persistent type env mut escape flag")
        } else {
          let esc_tag = String::char_code_at(text, after_name)
          let escapes = if esc_tag == '0' {
            false
          } else if esc_tag == '1' {
            true
          } else {
            throw("invalid persistent type env mut escape flag")
          }
          let (rest, next) = parse_persistent_type_env_payload(text, after_name + 1)
          (EnvMutCell(name, escapes, rest), next)
        }
      },
      'D' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (supers, after_supers) = parse_string_array(text, after_name)
        if after_supers >= String::length(text) {
          throw("invalid persistent type env trait auto flag")
        } else {
          let auto_tag = String::char_code_at(text, after_supers)
          let is_auto = if auto_tag == '0' {
            false
          } else if auto_tag == '1' {
            true
          } else {
            throw("invalid persistent type env trait auto flag")
          }
          let (methods, after_methods) = parse_trait_methods(text, after_supers + 1)
          let (rest, after_rest) = parse_persistent_type_env_payload(text, after_methods)
          let (params, after_params) = parse_string_array(text, after_rest)
          let (method_gens, next) = parse_trait_method_gens(text, after_params)
          (EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens), next)
        }
      },
      'I' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (target, after_target) = parse_cached_type(text, after_name)
        let (rest, next) = parse_persistent_type_env_payload(text, after_target)
        (EnvTraitImpl(name, target, rest), next)
      },
      'G' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (params, after_params) = parse_string_array(text, after_name)
        let (bounds, after_bounds) = parse_string_bounds(text, after_params)
        let (target, after_target) = parse_cached_type(text, after_bounds)
        let (rest, next) = parse_persistent_type_env_payload(text, after_target)
        (EnvTraitImplGen(name, params, bounds, target, rest), next)
      },
      'P' => {
        let (defs, after_defs) = parse_type_defs(text, pos + 1)
        let (selectable, after_selectable) = parse_string_array(text, after_defs)
        let (rest, next) = parse_persistent_type_env_payload(text, after_selectable)
        (EnvTypeDefs(defs, selectable, rest), next)
      },
      'L' => {
        let (bindings, next) = parse_value_bindings(text, pos + 1)
        (EnvFlat(bindings), next)
      },
      'C' => {
        let (names, after_names) = parse_string_array(text, pos + 1)
        let (types, after_types) = parse_type_array(text, after_names)
        if Array::length(names) != Array::length(types) {
          throw("invalid persistent type env cached shape")
        } else {
          let (rest, next) = parse_persistent_type_env_payload(text, after_types)
          // Serialized cached arrays are untrusted acceleration data. Rebuild
          // them from the decoded chain so malformed indexes cannot change
          // lookup semantics.
          (env_cache(rest), next)
        }
      },
      _ => throw("invalid persistent type env tag")
    }
  }
}

export fn persistent_dep_list_text(deps: Array[String]) -> String {
  if Array::length(deps) == 0 {
    ""
  } else if Array::length(deps) == 1 {
    String::concat("version\t3\n", Array::get(deps, 0))
  } else {
    let out = cache_text_writer()
    cache_push(out, "version\t2\n")
    write_string_array(out, deps)
    String::join(out.parts, "")
  }
}

export fn load_persistent_dep_list(path: String, source: String) -> Option[Array[String]] with Env + Exception + Fs {
  let cache_path = persistent_dep_list_cache_path(path, compact_source_fingerprint_memo(path, source))
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))
    if String::length(text) == 0 {
      Some(array_empty())
    } else {
      let v2_prefix = "version\t2\n"
      let v3_prefix = "version\t3\n"
      let text_len = String::length(text)
      let v2_len = String::length(v2_prefix)
      let v3_len = String::length(v3_prefix)
      if text_len >= v2_len &&
      text[0: v2_len] == v2_prefix {
        let body = text[v2_len: text_len]
        let (deps, end_pos) = parse_string_array(body, 0)
        if end_pos == String::length(body) {
          // #801 follow-up: deps are RESOLVED paths — refuse a list whose
          // package-index deps no longer match the current resolution winners
          // (written while a store copy existed, or vice versa).
          if package_index_deps_are_current(deps) {
            Some(deps)
          } else {
            None
          }
        } else {
          throw(String::concat("invalid persistent dep list body: ", cache_path))
        }
      } else if text_len >= v3_len &&
      text[0: v3_len] == v3_prefix {
        let dep = text[v3_len: text_len]
        if String::length(dep) == 0 {
          Some(array_empty())
        } else {
          if package_index_deps_are_current([dep]) {
            Some([dep])
          } else {
            None
          }
        }
      } else {
        throw(String::concat("invalid persistent dep list header: ", cache_path))
      }
    }
  }
}

/// Strict v9 module-interface wire format. It preserves declaration closure,
/// binding provenance,
/// plus the distinct selected declaration surface. Older bytes are rejected
/// rather than being misread as authority.
export fn parse_persistent_type_env(text: String) -> Option[TypeEnv] with Exception {
  let normalized = normalize_persistent_cache_text(text)
  let header = "version\t9\nenv\t"
  let header_len = String::length(header)
  if String::length(normalized) < header_len || normalized[0: header_len] != header {
    None
  } else {
    let (payload, after_payload) = parse_segment(normalized, header_len)
    if after_payload + 1 != String::length(normalized) || String::char_code_at(normalized, after_payload) != '\n' {
      throw("invalid persistent type env v9 envelope")
    } else {
      let (env, end) = parse_persistent_type_env_payload(payload, 0)
      if end != String::length(payload) {
        throw("invalid persistent type env v9 payload")
      } else {
        Some(env)
      }
    }
  }
}

/// Filesystem entries require the complete v10 envelope. The TypeEnv-only
/// v9 codec below remains the worker/dependency transport representation.
export fn load_persistent_type_env(fingerprint: String) -> Option[TypeEnv] with Env + Exception + Fs {
  match load_persistent_module_cache(fingerprint) {
    Some(record) => Some(record.env),
    None => None
  }
}

export fn load_persistent_module_cache(fingerprint: String) -> Option[PersistentModuleCache] with Env + Fs {
  let path = persistent_type_env_cache_path(fingerprint)
  if !Fs::exists(path) {
    None
  } else {
    handle {
      parse_persistent_module_cache(Fs::read_file(path))
    }
    with { Exception::Throw(_) => None }
  }
}

/// A length-delimited TypeEnv payload followed by exactly one lowering
/// section. The v8 lowering codec retains its count/digest/end-marker checks.
export fn persistent_module_cache_text(env: TypeEnv, lowering: Option[(Array[Int], Array[Int], Array[String])]) -> String {
  let out = cache_text_writer()
  cache_push(out, "version\t10\nenv\t")
  write_type_env_segment(out, env)
  cache_push(out, "\n")
  match lowering {
    Some((offsets, eq_offs, eq_keys)) => append_module_typed_lowering_text(out.parts, offsets, eq_offs, eq_keys),
    None => cache_push(out, "lowering\tmissing\n")
  }
  String::join(out.parts, "")
}

/// Reject the whole entry when either section is malformed. In particular a
/// truncated table cannot become an absent or partially accepted table.
export fn parse_persistent_module_cache(text: String) -> Option[PersistentModuleCache] {
  handle {
    let normalized = normalize_persistent_cache_text(text)
    let header = "version\t10\nenv\t"
    if !String::starts_with(normalized, header) {
      None
    } else {
      let (payload, end) = parse_segment(normalized, String::length(header))
      if end >= String::length(normalized) || String::char_code_at(normalized, end) != '\n' {
        None
      } else {
        let (env, consumed) = parse_persistent_type_env_payload(payload, 0)
        if consumed != String::length(payload) {
          None
        } else {
          let section = normalized[end + 1: String::length(normalized)]
          if section == "lowering\tmissing\n" {
            Some(PersistentModuleCache::{ env, lowering: None })
          } else {
            match parse_module_typed_lowering_offsets_text(section) {
              Some(rows) => Some(PersistentModuleCache::{
                env,
                lowering: Some(rows)
              }),
              None => None
            }
          }
        }
      }
    }
  } with { Exception::Throw(_) => None }
}

export fn persistent_type_env_cache_text(env: TypeEnv) -> String {
  let out = cache_text_writer()
  cache_push(out, "version\t9\nenv\t")
  write_type_env_segment(out, env)
  cache_push(out, "\n")
  String::join(out.parts, "")
}

export fn load_persistent_leaf_fingerprint(path: String, source: String, typing_semantics_seed: String) -> Option[String] with Env + Exception + Fs {
  let cache_path = persistent_leaf_fingerprint_cache_path(path, compact_source_fingerprint_memo(path, source))
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))
    let prefix = String::concat("version\t2\ntyping-semantics\t", String::concat(typing_semantics_seed, "\n"))
    if String::length(text) > String::length(prefix) &&
    text[0: String::length(prefix)] == prefix {
      Some(String::substring(text, String::length(prefix), String::length(text) - 1))
    } else {
      None
    }
  }
}

export fn persistent_leaf_fingerprint_text(fingerprint: String, typing_semantics_seed: String) -> String {
  String::concat("version\t2\ntyping-semantics\t", String::concat(typing_semantics_seed, String::concat("\n", String::concat(fingerprint, "\n"))))
}
