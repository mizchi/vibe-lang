//# Imports

import @vibe/compiler/cache {
  compact_string_fingerprint,
  normalize_persistent_cache_text,
  package_index_deps_are_current,
  persistent_dep_list_cache_path,
  persistent_leaf_fingerprint_cache_path,
  persistent_type_env_cache_path
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/core {
  Type, TypeDef, TypeEnv, TypeExpr, env_cache
}

//# Functions

fn parse_int_strict(raw: String) -> Int with Exception {
  let len = String::length(raw)
  if len == 0 {
    throw("invalid persistent type env integer")
  } else {
    let mut i = 0
    if String::char_code_at(raw, 0) == '-' {
      if len == 1 || String::char_code_at(raw, 1) == '0' {
        throw("invalid persistent type env integer")
      } else {
        i = 1
      }
    } else if String::char_code_at(raw, 0) == '0' && len > 1 {
      throw("invalid persistent type env integer")
    } else {
      ()
    }
    while i < len {
      let c = String::char_code_at(raw, i)
      if c < '0' || c > '9' {
        throw("invalid persistent type env integer")
      } else {
        i = i + 1
      }
    }
    match Int::parse(raw) {
      Some(value) => value,
      None => throw("invalid persistent type env integer")
    }
  }
}

fn serialize_segment(text: String) -> String {
  String::concat(__to_string(String::length(text)), String::concat(":", text))
}

fn parse_count_header(text: String, pos: Int, terminator: Int) -> (Int, Int) with Exception {
  let len = String::length(text)
  let mut i = pos
  while i < len && String::char_code_at(text, i) != terminator {
    i = i + 1
  }
  if i == pos || i >= len {
    throw("invalid persistent type env payload")
  } else {
    let raw = text[pos: i]
    let count = parse_int_strict(raw)
    if count < 0 {
      throw("invalid persistent type env count")
    } else {
      (count, i + 1)
    }
  }
}

fn parse_segment(text: String, pos: Int) -> (String, Int) with Exception {
  let (seg_len, start) = parse_count_header(text, pos, ':')
  let end = start + seg_len
  if end < start || end > String::length(text) {
    throw("invalid persistent type env segment")
  } else {
    (text[start: end], end)
  }
}

fn serialize_int_array(items: Array[Int]) -> String {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, __to_string(Array::length(items)))
  StringBuilder::push(buf, "[")
  let mut i = 0
  while i < Array::length(items) {
    StringBuilder::push(buf, serialize_segment(__to_string(Array::get(items, i))))
    i = i + 1
  }
  StringBuilder::push(buf, "]")
  StringBuilder::freeze(buf)
}

fn parse_int_array(text: String, pos: Int) -> (Array[Int], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, next) = parse_segment(text, cursor)
    Array::push(items, parse_int_strict(raw))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env int array")
  } else {
    (items, cursor + 1)
  }
}

fn serialize_string_array(items: Array[String]) -> String {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, __to_string(Array::length(items)))
  StringBuilder::push(buf, "[")
  let mut i = 0
  while i < Array::length(items) {
    StringBuilder::push(buf, serialize_segment(Array::get(items, i)))
    i = i + 1
  }
  StringBuilder::push(buf, "]")
  StringBuilder::freeze(buf)
}

fn parse_string_array(text: String, pos: Int) -> (Array[String], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (item, next) = parse_segment(text, cursor)
    Array::push(items, item)
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env string array")
  } else {
    (items, cursor + 1)
  }
}

fn serialize_bounds_array(items: Array[(Int, Array[String])]) -> String {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, __to_string(Array::length(items)))
  StringBuilder::push(buf, "[")
  let mut i = 0
  while i < Array::length(items) {
    let (id, bounds) = Array::get(items, i)
    StringBuilder::push(buf, serialize_segment(__to_string(id)))
    StringBuilder::push(buf, serialize_string_array(bounds))
    i = i + 1
  }
  StringBuilder::push(buf, "]")
  StringBuilder::freeze(buf)
}

fn parse_bounds_array(text: String, pos: Int) -> (Array[(Int, Array[String])], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw_id, after_id) = parse_segment(text, cursor)
    let (bounds, next) = parse_string_array(text, after_id)
    Array::push(items, (parse_int_strict(raw_id), bounds))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env bounds array")
  } else {
    (items, cursor + 1)
  }
}

fn serialize_type_array(items: Array[Type]) -> String {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, __to_string(Array::length(items)))
  StringBuilder::push(buf, "[")
  let mut i = 0
  while i < Array::length(items) {
    StringBuilder::push(buf, serialize_segment(serialize_type(Array::get(items, i))))
    i = i + 1
  }
  StringBuilder::push(buf, "]")
  StringBuilder::freeze(buf)
}

fn parse_type_array(text: String, pos: Int) -> (Array[Type], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, next) = parse_segment(text, cursor)
    let (item, end) = parse_cached_type(raw, 0)
    if end != String::length(raw) {
      throw("invalid persistent type env nested type")
    } else {
      Array::push(items, item)
      cursor = next
      i = i + 1
    }
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env type array")
  } else {
    (items, cursor + 1)
  }
}

fn parse_cached_type(source: String, pos: Int) -> (Type, Int) with Exception {
  if pos >= String::length(source) {
    throw("invalid persistent type env type")
  } else {
    match String::char_code_at(source, pos) {
      'I' => (CtInt, pos + 1),
      'D' => (CtDouble, pos + 1),
      'B' => (CtBool, pos + 1),
      'G' => (CtString, pos + 1),
      'H' => (CtChar, pos + 1),
      'U' => (CtUnit, pos + 1),
      'Y' => (CtBytes, pos + 1),
      'X' => (CtUnknown, pos + 1),
      'V' => {
        let (raw, next) = parse_segment(source, pos + 1)
        (CtVar(parse_int_strict(raw)), next)
      },
      'E' => {
        let (name, next) = parse_segment(source, pos + 1)
        (CtEnum(name), next)
      },
      'R' => {
        let (name, next) = parse_segment(source, pos + 1)
        (CtStruct(name), next)
      },
      'A' => {
        let (elem, next) = parse_cached_type(source, pos + 1)
        (CtArray(elem), next)
      },
      'O' => {
        let (elem, next) = parse_cached_type(source, pos + 1)
        (CtOption(elem), next)
      },
      'T' => {
        let (elems, next) = parse_type_array(source, pos + 1)
        (CtTuple(elems), next)
      },
      'F' => {
        let (effect, after_effect) = parse_segment(source, pos + 1)
        let (params, after_params) = parse_type_array(source, after_effect)
        let (ret, next) = parse_cached_type(source, after_params)
        let effect_name = if String::length(effect) == 0 {
          None
        } else {
          Some(effect)
        }
        (CtFn(params, ret, effect_name), next)
      },
      'N' => {
        let (name, after_name) = parse_segment(source, pos + 1)
        let (args, next) = parse_type_array(source, after_name)
        (CtNamed(name, args), next)
      },
      'Q' => {
        let (vars, after_vars) = parse_int_array(source, pos + 1)
        let (bounds, after_bounds) = parse_bounds_array(source, after_vars)
        let (body, next) = parse_cached_type(source, after_bounds)
        (CtForAll(vars, bounds, body), next)
      },
      _ => throw("invalid persistent type env type tag")
    }
  }
}

fn serialize_type(ty: Type) -> String {
  match ty {
    CtInt => "I",
    CtDouble => "D",
    CtBool => "B",
    CtString => "G",
    CtChar => "H",
    CtUnit => "U",
    CtBytes => "Y",
    CtUnknown => "X",
    CtVar(id) => String::concat("V", serialize_segment(__to_string(id))),
    CtEnum(name) => String::concat("E", serialize_segment(name)),
    CtStruct(name) => String::concat("R", serialize_segment(name)),
    CtArray(elem) => String::concat("A", serialize_type(elem)),
    CtOption(elem) => String::concat("O", serialize_type(elem)),
    CtTuple(elems) => String::concat("T", serialize_type_array(elems)),
    CtFn(params, ret, effect_name) => {
      let effect = if effect_name is Some(name) {
        name
      } else {
        ""
      }
      String::concat("F", String::concat(serialize_segment(effect), String::concat(serialize_type_array(params), serialize_type(ret))))
    },
    CtNamed(name, args) => String::concat("N", String::concat(serialize_segment(name), serialize_type_array(args))),
    CtForAll(vars, bounds, body) => String::concat("Q", String::concat(serialize_int_array(vars), String::concat(serialize_bounds_array(bounds), serialize_type(body))))
  }
}

fn serialize_type_expr_array(items: Array[TypeExpr]) -> String {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, __to_string(Array::length(items)))
  StringBuilder::push(buf, "[")
  let mut i = 0
  while i < Array::length(items) {
    StringBuilder::push(buf, serialize_segment(serialize_type_expr(Array::get(items, i))))
    i = i + 1
  }
  StringBuilder::push(buf, "]")
  StringBuilder::freeze(buf)
}

fn parse_type_expr_array(text: String, pos: Int) -> (Array[TypeExpr], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, next) = parse_segment(text, cursor)
    let (item, end) = parse_type_expr(raw, 0)
    if end != String::length(raw) {
      throw("invalid persistent type env nested type expr")
    } else {
      Array::push(items, item)
      cursor = next
      i = i + 1
    }
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env type expr array")
  } else {
    (items, cursor + 1)
  }
}

fn serialize_type_expr(ty: TypeExpr) -> String {
  match ty {
    TyName(name) => String::concat("n", serialize_segment(name)),
    TyApp(name, args) => String::concat("a", String::concat(serialize_segment(name), serialize_type_expr_array(args))),
    TyFn(params, ret, effect_name) => {
      let effect = if effect_name is Some(name) {
        String::concat("1", serialize_segment(name))
      } else {
        "0"
      }
      String::concat("f", String::concat(effect, String::concat(serialize_type_expr_array(params), serialize_type_expr(ret))))
    },
    TyTuple(elems) => String::concat("t", serialize_type_expr_array(elems)),
    TyUnit => "u"
  }
}

fn parse_type_expr(source: String, pos: Int) -> (TypeExpr, Int) with Exception {
  if pos >= String::length(source) {
    throw("invalid persistent type env type expr")
  } else {
    match String::char_code_at(source, pos) {
      'n' => {
        let (name, next) = parse_segment(source, pos + 1)
        (TyName(name), next)
      },
      'a' => {
        let (name, after_name) = parse_segment(source, pos + 1)
        let (args, next) = parse_type_expr_array(source, after_name)
        (TyApp(name, args), next)
      },
      'f' => {
        let effect_pos = pos + 1
        if effect_pos >= String::length(source) {
          throw("invalid persistent type env function type expr")
        } else {
          let tag = String::char_code_at(source, effect_pos)
          let (effect_name, after_effect) = if tag == '0' {
            (None, effect_pos + 1)
          } else if tag == '1' {
            let (name, next) = parse_segment(source, effect_pos + 1)
            (Some(name), next)
          } else {
            throw("invalid persistent type env function effect")
          }
          let (params, after_params) = parse_type_expr_array(source, after_effect)
          let (ret, next) = parse_type_expr(source, after_params)
          (TyFn(params, ret, effect_name), next)
        }
      },
      't' => {
        let (elems, next) = parse_type_expr_array(source, pos + 1)
        (TyTuple(elems), next)
      },
      'u' => (TyUnit, pos + 1),
      _ => throw("invalid persistent type env type expr tag")
    }
  }
}

fn serialize_string_bounds(items: Array[(String, Array[String])]) -> String {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, __to_string(Array::length(items)))
  StringBuilder::push(buf, "[")
  let mut i = 0
  while i < Array::length(items) {
    let (name, bounds) = Array::get(items, i)
    StringBuilder::push(buf, serialize_segment(name))
    StringBuilder::push(buf, serialize_string_array(bounds))
    i = i + 1
  }
  StringBuilder::push(buf, "]")
  StringBuilder::freeze(buf)
}

fn parse_string_bounds(text: String, pos: Int) -> (Array[(String, Array[String])], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (name, after_name) = parse_segment(text, cursor)
    let (bounds, next) = parse_string_array(text, after_name)
    Array::push(items, (name, bounds))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env generic bounds")
  } else {
    (items, cursor + 1)
  }
}

fn serialize_trait_methods(items: Array[(String, Array[TypeExpr], TypeExpr)]) -> String {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, __to_string(Array::length(items)))
  StringBuilder::push(buf, "[")
  let mut i = 0
  while i < Array::length(items) {
    let (name, params, ret) = Array::get(items, i)
    StringBuilder::push(buf, serialize_segment(name))
    StringBuilder::push(buf, serialize_type_expr_array(params))
    StringBuilder::push(buf, serialize_type_expr(ret))
    i = i + 1
  }
  StringBuilder::push(buf, "]")
  StringBuilder::freeze(buf)
}

fn parse_trait_methods(text: String, pos: Int) -> (Array[(String, Array[TypeExpr], TypeExpr)], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (name, after_name) = parse_segment(text, cursor)
    let (params, after_params) = parse_type_expr_array(text, after_name)
    let (ret, next) = parse_type_expr(text, after_params)
    Array::push(items, (name, params, ret))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env trait methods")
  } else {
    (items, cursor + 1)
  }
}

fn serialize_trait_method_gens(items: Array[(String, Array[String], Array[(String, Array[String])])]) -> String {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, __to_string(Array::length(items)))
  StringBuilder::push(buf, "[")
  let mut i = 0
  while i < Array::length(items) {
    let (name, params, bounds) = Array::get(items, i)
    StringBuilder::push(buf, serialize_segment(name))
    StringBuilder::push(buf, serialize_string_array(params))
    StringBuilder::push(buf, serialize_string_bounds(bounds))
    i = i + 1
  }
  StringBuilder::push(buf, "]")
  StringBuilder::freeze(buf)
}

fn parse_trait_method_gens(text: String, pos: Int) -> (Array[(String, Array[String], Array[(String, Array[String])])], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (name, after_name) = parse_segment(text, cursor)
    let (params, after_params) = parse_string_array(text, after_name)
    let (bounds, next) = parse_string_bounds(text, after_params)
    Array::push(items, (name, params, bounds))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env trait method generics")
  } else {
    (items, cursor + 1)
  }
}

fn serialize_type_def(def: TypeDef) -> String {
  match def {
    TDEnum(name, params, variants) => {
      let out = StringBuilder::new()
      StringBuilder::push(out, "E")
      StringBuilder::push(out, serialize_segment(name))
      StringBuilder::push(out, serialize_string_array(params))
      StringBuilder::push(out, __to_string(Array::length(variants)))
      StringBuilder::push(out, "[")
      let mut i = 0
      while i < Array::length(variants) {
        let (variant, fields) = Array::get(variants, i)
        StringBuilder::push(out, serialize_segment(variant))
        StringBuilder::push(out, serialize_type_array(fields))
        i = i + 1
      }
      StringBuilder::push(out, "]")
      StringBuilder::freeze(out)
    },
    TDStruct(name, fields, mut_fields, params) => String::concat("S", String::concat(serialize_segment(name), String::concat(serialize_bindings(fields), String::concat(serialize_string_array(mut_fields), serialize_string_array(params))))),
    TDAlias(name, params, target) => String::concat("A", String::concat(serialize_segment(name), String::concat(serialize_string_array(params), serialize_type(target)))),
    TDEffect(name, ops, params) => {
      let out = StringBuilder::new()
      StringBuilder::push(out, "K")
      StringBuilder::push(out, serialize_segment(name))
      StringBuilder::push(out, serialize_string_array(params))
      StringBuilder::push(out, __to_string(Array::length(ops)))
      StringBuilder::push(out, "[")
      let mut i = 0
      while i < Array::length(ops) {
        let (op, args, ret) = Array::get(ops, i)
        StringBuilder::push(out, serialize_segment(op))
        StringBuilder::push(out, serialize_type_array(args))
        StringBuilder::push(out, serialize_type(ret))
        i = i + 1
      }
      StringBuilder::push(out, "]")
      StringBuilder::freeze(out)
    },
    TDEffectSet(name, members) => String::concat("Z", String::concat(serialize_segment(name), serialize_string_array(members)))
  }
}

fn parse_type_def(text: String, pos: Int) -> (TypeDef, Int) with Exception {
  if pos >= String::length(text) {
    throw("invalid persistent type definition")
  } else {
    match String::char_code_at(text, pos) {
      'E' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (params, after_params) = parse_string_array(text, after_name)
        let (count, start) = parse_count_header(text, after_params, '[')
        let variants = array_empty()
        let mut i = 0
        let mut cursor = start
        while i < count {
          let (variant, after_variant) = parse_segment(text, cursor)
          let (fields, next) = parse_type_array(text, after_variant)
          Array::push(variants, (variant, fields))
          cursor = next
          i = i + 1
        }
        if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
          throw("invalid persistent enum definition")
        } else {
          (TDEnum(name, params, variants), cursor + 1)
        }
      },
      'S' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (fields, after_fields) = parse_bindings(text, after_name)
        let (mut_fields, after_mut_fields) = parse_string_array(text, after_fields)
        let (params, next) = parse_string_array(text, after_mut_fields)
        (TDStruct(name, fields, mut_fields, params), next)
      },
      'A' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (params, after_params) = parse_string_array(text, after_name)
        let (target, next) = parse_cached_type(text, after_params)
        (TDAlias(name, params, target), next)
      },
      'K' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (params, after_params) = parse_string_array(text, after_name)
        let (count, start) = parse_count_header(text, after_params, '[')
        let ops = array_empty()
        let mut i = 0
        let mut cursor = start
        while i < count {
          let (op, after_op) = parse_segment(text, cursor)
          let (args, after_args) = parse_type_array(text, after_op)
          let (ret, next) = parse_cached_type(text, after_args)
          Array::push(ops, (op, args, ret))
          cursor = next
          i = i + 1
        }
        if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
          throw("invalid persistent effect definition")
        } else {
          (TDEffect(name, ops, params), cursor + 1)
        }
      },
      'Z' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (members, next) = parse_string_array(text, after_name)
        (TDEffectSet(name, members), next)
      },
      _ => throw("invalid persistent type definition tag")
    }
  }
}

fn serialize_type_defs(defs: Array[TypeDef]) -> String {
  let out = StringBuilder::new()
  StringBuilder::push(out, __to_string(Array::length(defs)))
  StringBuilder::push(out, "[")
  let mut i = 0
  while i < Array::length(defs) {
    StringBuilder::push(out, serialize_segment(serialize_type_def(Array::get(defs, i))))
    i = i + 1
  }
  StringBuilder::push(out, "]")
  StringBuilder::freeze(out)
}

fn parse_type_defs(text: String, pos: Int) -> (Array[TypeDef], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let defs = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, after_raw) = parse_segment(text, cursor)
    let (def, end) = parse_type_def(raw, 0)
    if end != String::length(raw) {
      throw("invalid persistent type definition payload")
    } else {
      Array::push(defs, def)
      cursor = after_raw
      i = i + 1
    }
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type definitions")
  } else {
    (defs, cursor + 1)
  }
}

fn serialize_bindings(items: Array[(String, Type)]) -> String {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, __to_string(Array::length(items)))
  StringBuilder::push(buf, "[")
  let mut i = 0
  while i < Array::length(items) {
    let (name, ty) = Array::get(items, i)
    StringBuilder::push(buf, serialize_segment(name))
    StringBuilder::push(buf, serialize_type(ty))
    i = i + 1
  }
  StringBuilder::push(buf, "]")
  StringBuilder::freeze(buf)
}

fn parse_bindings(text: String, pos: Int) -> (Array[(String, Type)], Int) with Exception {
  let (count, start) = parse_count_header(text, pos, '[')
  let items = array_empty()
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (name, after_name) = parse_segment(text, cursor)
    let (ty, next) = parse_cached_type(text, after_name)
    Array::push(items, (name, ty))
    cursor = next
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != ']' {
    throw("invalid persistent type env bindings")
  } else {
    (items, cursor + 1)
  }
}

fn serialize_type_env_into(buf: StringBuilder, env: TypeEnv) -> Unit {
  match env {
    EnvEmpty => StringBuilder::push(buf, "0"),
    EnvBind(name, ty, rest) => {
      StringBuilder::push(buf, "B")
      StringBuilder::push(buf, serialize_segment(name))
      StringBuilder::push(buf, serialize_type(ty))
      serialize_type_env_into(buf, rest)
    },
    EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens) => {
      StringBuilder::push(buf, "D")
      StringBuilder::push(buf, serialize_segment(name))
      StringBuilder::push(buf, serialize_string_array(supers))
      StringBuilder::push(buf, if is_auto {
        "1"
      } else {
        "0"
      })
      StringBuilder::push(buf, serialize_trait_methods(methods))
      serialize_type_env_into(buf, rest)
      StringBuilder::push(buf, serialize_string_array(params))
      StringBuilder::push(buf, serialize_trait_method_gens(method_gens))
    },
    EnvTraitImpl(name, target, rest) => {
      StringBuilder::push(buf, "I")
      StringBuilder::push(buf, serialize_segment(name))
      StringBuilder::push(buf, serialize_type(target))
      serialize_type_env_into(buf, rest)
    },
    EnvTraitImplGen(name, params, bounds, target, rest) => {
      StringBuilder::push(buf, "G")
      StringBuilder::push(buf, serialize_segment(name))
      StringBuilder::push(buf, serialize_string_array(params))
      StringBuilder::push(buf, serialize_string_bounds(bounds))
      StringBuilder::push(buf, serialize_type(target))
      serialize_type_env_into(buf, rest)
    },
    EnvTypeDefs(defs, selectable, rest) => {
      StringBuilder::push(buf, "P")
      StringBuilder::push(buf, serialize_type_defs(defs))
      StringBuilder::push(buf, serialize_string_array(selectable))
      serialize_type_env_into(buf, rest)
    },
    EnvFlat(bindings) => {
      StringBuilder::push(buf, "L")
      StringBuilder::push(buf, serialize_bindings(bindings))
    },
    EnvCached(_, _, rest) => {
      // Cached arrays are acceleration state, not trusted semantics. Emit the
      // canonical index rebuilt from the chain so cold-store bytes and decoded
      // transport identities agree even if an in-memory cache is stale.
      match env_cache(rest) {
        EnvCached(names, types, _) => {
          StringBuilder::push(buf, "C")
          StringBuilder::push(buf, serialize_string_array(names))
          StringBuilder::push(buf, serialize_type_array(types))
          serialize_type_env_into(buf, rest)
        },
        _ => serialize_type_env_into(buf, rest)
      }
    }
  }
}

fn serialize_type_env(env: TypeEnv) -> String {
  let buf = StringBuilder::new()
  serialize_type_env_into(buf, env)
  StringBuilder::freeze(buf)
}

fn parse_persistent_type_env_payload(text: String, pos: Int) -> (TypeEnv, Int) with Exception {
  if pos >= String::length(text) {
    throw("invalid persistent type env")
  } else {
    match String::char_code_at(text, pos) {
      '0' => (EnvEmpty, pos + 1),
      'B' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (ty, after_ty) = parse_cached_type(text, after_name)
        let (rest, next) = parse_persistent_type_env_payload(text, after_ty)
        (EnvBind(name, ty, rest), next)
      },
      'D' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (supers, after_supers) = parse_string_array(text, after_name)
        if after_supers >= String::length(text) {
          throw("invalid persistent type env trait auto flag")
        } else {
          let auto_tag = String::char_code_at(text, after_supers)
          let is_auto = if auto_tag == '0' {
            false
          } else if auto_tag == '1' {
            true
          } else {
            throw("invalid persistent type env trait auto flag")
          }
          let (methods, after_methods) = parse_trait_methods(text, after_supers + 1)
          let (rest, after_rest) = parse_persistent_type_env_payload(text, after_methods)
          let (params, after_params) = parse_string_array(text, after_rest)
          let (method_gens, next) = parse_trait_method_gens(text, after_params)
          (EnvTraitDef(name, supers, is_auto, methods, rest, params, method_gens), next)
        }
      },
      'I' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (target, after_target) = parse_cached_type(text, after_name)
        let (rest, next) = parse_persistent_type_env_payload(text, after_target)
        (EnvTraitImpl(name, target, rest), next)
      },
      'G' => {
        let (name, after_name) = parse_segment(text, pos + 1)
        let (params, after_params) = parse_string_array(text, after_name)
        let (bounds, after_bounds) = parse_string_bounds(text, after_params)
        let (target, after_target) = parse_cached_type(text, after_bounds)
        let (rest, next) = parse_persistent_type_env_payload(text, after_target)
        (EnvTraitImplGen(name, params, bounds, target, rest), next)
      },
      'P' => {
        let (defs, after_defs) = parse_type_defs(text, pos + 1)
        let (selectable, after_selectable) = parse_string_array(text, after_defs)
        let (rest, next) = parse_persistent_type_env_payload(text, after_selectable)
        (EnvTypeDefs(defs, selectable, rest), next)
      },
      'L' => {
        let (bindings, next) = parse_bindings(text, pos + 1)
        (EnvFlat(bindings), next)
      },
      'C' => {
        let (names, after_names) = parse_string_array(text, pos + 1)
        let (types, after_types) = parse_type_array(text, after_names)
        if Array::length(names) != Array::length(types) {
          throw("invalid persistent type env cached shape")
        } else {
          let (rest, next) = parse_persistent_type_env_payload(text, after_types)
          // Serialized cached arrays are untrusted acceleration data. Rebuild
          // them from the decoded chain so malformed indexes cannot change
          // lookup semantics.
          (env_cache(rest), next)
        }
      },
      _ => throw("invalid persistent type env tag")
    }
  }
}

export fn persistent_dep_list_text(deps: Array[String]) -> String {
  if Array::length(deps) == 0 {
    ""
  } else if Array::length(deps) == 1 {
    String::concat("version\t3\n", Array::get(deps, 0))
  } else {
    String::concat("version\t2\n", serialize_string_array(deps))
  }
}

export fn load_persistent_dep_list(path: String, source: String) -> Option[Array[String]] with Exception + Fs {
  let cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))
    if String::length(text) == 0 {
      Some(array_empty())
    } else {
      let v2_prefix = "version\t2\n"
      let v3_prefix = "version\t3\n"
      let text_len = String::length(text)
      let v2_len = String::length(v2_prefix)
      let v3_len = String::length(v3_prefix)
      if text_len >= v2_len &&
      text[0: v2_len] == v2_prefix {
        let body = text[v2_len: text_len]
        let (deps, end_pos) = parse_string_array(body, 0)
        if end_pos == String::length(body) {
          // #801 follow-up: deps are RESOLVED paths — refuse a list whose
          // package-index deps no longer match the current resolution winners
          // (written while a store copy existed, or vice versa).
          if package_index_deps_are_current(deps) {
            Some(deps)
          } else {
            None
          }
        } else {
          throw(String::concat("invalid persistent dep list body: ", cache_path))
        }
      } else if text_len >= v3_len &&
      text[0: v3_len] == v3_prefix {
        let dep = text[v3_len: text_len]
        if String::length(dep) == 0 {
          Some(array_empty())
        } else {
          if package_index_deps_are_current([
            dep
          ]) {
            Some([
              dep
            ])
          } else {
            None
          }
        }
      } else {
        throw(String::concat("invalid persistent dep list header: ", cache_path))
      }
    }
  }
}

/// Strict v5 module-interface wire format. It preserves declaration closure
/// plus the distinct selected declaration surface. Older bytes are rejected
/// rather than being misread as authority.
export fn parse_persistent_type_env(text: String) -> Option[TypeEnv] with Exception {
  let normalized = normalize_persistent_cache_text(text)
  let header = "version\t5\nenv\t"
  let header_len = String::length(header)
  if String::length(normalized) < header_len || normalized[0: header_len] != header {
    None
  } else {
    let (payload, after_payload) = parse_segment(normalized, header_len)
    if after_payload + 1 != String::length(normalized) || String::char_code_at(normalized, after_payload) != '\n' {
      throw("invalid persistent type env v5 envelope")
    } else {
      let (env, end) = parse_persistent_type_env_payload(payload, 0)
      if end != String::length(payload) {
        throw("invalid persistent type env v5 payload")
      } else {
        Some(env)
      }
    }
  }
}

/// Filesystem cache bytes are untrusted. A malformed or old envelope is a
/// cache miss, never an exception that can turn a cold check into a failure or
/// a partially decoded interface into authority.
export fn load_persistent_type_env(fingerprint: String) -> Option[TypeEnv] with Exception + Fs {
  let path = persistent_type_env_cache_path(fingerprint)
  if !(Fs::exists(path)) {
    None
  } else {
    handle {
      parse_persistent_type_env(Fs::read_file(path))
    } with Exception {
      Throw(_) => None
    }
  }
}

export fn persistent_type_env_cache_text(env: TypeEnv) -> String {
  String::concat("version\t5\nenv\t", String::concat(serialize_segment(serialize_type_env(env)), "\n"))
}

export fn load_persistent_leaf_fingerprint(path: String, source: String, typing_semantics_seed: String) -> Option[String] with Exception + Fs {
  let cache_path = persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source))
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))
    let prefix = String::concat("version\t2\ntyping-semantics\t", String::concat(typing_semantics_seed, "\n"))
    if String::length(text) > String::length(prefix) &&
    text[0: String::length(prefix)] == prefix {
      Some(String::substring(text, String::length(prefix), String::length(text) - 1))
    } else {
      None
    }
  }
}

export fn persistent_leaf_fingerprint_text(fingerprint: String, typing_semantics_seed: String) -> String {
  String::concat("version\t2\ntyping-semantics\t", String::concat(typing_semantics_seed, String::concat("\n", String::concat(fingerprint, "\n"))))
}
