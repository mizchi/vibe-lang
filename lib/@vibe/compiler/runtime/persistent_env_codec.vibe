import @vibe/compiler/cache {
  compact_source_fingerprint_memo,
  normalize_persistent_cache_text,
  package_index_deps_are_current,
  persistent_dep_list_cache_path,
  persistent_leaf_fingerprint_cache_path,
  persistent_type_env_cache_path
}
import @vibe/compiler/core {
  TypeEnv
}
import @vibe/checker/transport/env {
  decode_checked_dependency_paths,
  decode_checked_environment,
  decode_checked_module_product,
  encode_checked_dependency_paths,
  encode_checked_environment,
  encode_checked_module_product
}

/// Disk storage combines the outputs of one check. None means no table was
/// transported (e.g. a worker result), not a successfully checked empty table.
export struct PersistentModuleCache {
  env: TypeEnv;
  lowering: Option[(Array[Int], Array[Int], Array[String])]
}

/// Preserve the dependency-list wire representation through the pure codec.
export fn persistent_dep_list_text(deps: Array[String]) -> String {
  encode_checked_dependency_paths(deps)
}

/// Validate decoded dependency paths against current package resolution.
export fn load_persistent_dep_list(path: String, source: String) -> Option[Array[String]] with Env + Exception + Fs {
  let cache_path = persistent_dep_list_cache_path(path, compact_source_fingerprint_memo(path, source))
  if !Fs::exists(cache_path) {
    None
  } else {
    let deps = decode_checked_dependency_paths(Fs::read_file(cache_path), cache_path)
    if package_index_deps_are_current(deps) {
      Some(deps)
    } else {
      None
    }
  }
}

/// Preserve the strict v10 runtime decoder and its Exception behavior.
export fn parse_persistent_type_env(text: String) -> Option[TypeEnv] with Exception {
  decode_checked_environment(text)
}

export fn load_persistent_type_env(fingerprint: String) -> Option[TypeEnv] with Env + Exception + Fs {
  match load_persistent_module_cache(fingerprint) {
    Some(record) => Some(record.env),
    None => None
  }
}

export fn load_persistent_module_cache(fingerprint: String) -> Option[PersistentModuleCache] with Env + Fs {
  let path = persistent_type_env_cache_path(fingerprint)
  if !Fs::exists(path) {
    None
  } else {
    handle {
      parse_persistent_module_cache(Fs::read_file(path))
    }
    with { Exception::Throw(_) => None }
  }
}

/// Preserve v11 runtime bytes, including unavailable versus empty lowering.
export fn persistent_module_cache_text(env: TypeEnv, lowering: Option[(Array[Int], Array[Int], Array[String])]) -> String {
  encode_checked_module_product(env, lowering)
}

/// Keep the runtime record identity while the pure codec returns its fields.
export fn parse_persistent_module_cache(text: String) -> Option[PersistentModuleCache] {
  match decode_checked_module_product(text) {
    Some((env, lowering)) => Some(PersistentModuleCache::{ env, lowering }),
    None => None
  }
}

/// Preserve the v10 worker/dependency representation.
export fn persistent_type_env_cache_text(env: TypeEnv) -> String {
  encode_checked_environment(env)
}

export fn load_persistent_leaf_fingerprint(path: String, source: String, typing_semantics_seed: String) -> Option[String] with Env + Exception + Fs {
  let cache_path = persistent_leaf_fingerprint_cache_path(path, compact_source_fingerprint_memo(path, source))
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))
    let prefix = String::concat("version\t2\ntyping-semantics\t", String::concat(typing_semantics_seed, "\n"))
    if String::length(text) > String::length(prefix) &&
    text[0: String::length(prefix)] == prefix {
      Some(String::substring(text, String::length(prefix), String::length(text) - 1))
    } else {
      None
    }
  }
}

export fn persistent_leaf_fingerprint_text(fingerprint: String, typing_semantics_seed: String) -> String {
  String::concat("version\t2\ntyping-semantics\t", String::concat(typing_semantics_seed, String::concat("\n", String::concat(fingerprint, "\n"))))
}
