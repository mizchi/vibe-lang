name = @vibe/compiler/runtime/checked_module_cache
version = 0.0.1
description =
  #|Checked module cache policy and per-compilation ownership.
deps = {
  @vibe/compiler/cache : 0.0.1
  @vibe/compiler/checker : 0.0.1
  @vibe/compiler/checker/artifacts/module : 0.0.1
  @vibe/compiler/checker/artifacts/program : 0.0.1
  @vibe/compiler/core : 0.0.1
}

import @vibe/compiler/checker/artifacts/module {
  CheckedModuleArtifact
}
import @vibe/compiler/core {
  Stmt, TypeEnv
}
fn set_checked_module_cache_mode(mode: String) -> Unit with Env + Exception
fn checked_module_cache_mode() -> String
fn checked_module_cache_reset() -> Unit with Env
fn checked_module_cache_stats() -> (Int, Int, Int)
fn checked_module_cache_input_identity(path: String, source: String, semantics_seed: String, deps: Array[(String, TypeEnv)]) -> Bytes with Env
fn load_checked_module_artifact(path: String, input_identity: Bytes) -> Option[CheckedModuleArtifact] with Env + Exception + Fs
fn commit_checked_module_artifact(path: String, source: String, artifact: CheckedModuleArtifact, fresh: Bool) -> Unit with Env + Exception + Fs
fn checked_module_artifact_stmts(path: String, source: String) -> Option[Array[Stmt]] with Env
