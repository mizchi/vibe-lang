//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr, canonical_builtin_name
}

//# Functions

export fn merge_purity(a: Int, b: Int) -> Int {
  if a > b {
    a
  } else {
    b
  }
}

export fn builtin_purity(name: String) -> Int {
  let normalized = canonical_builtin_name(name)
  if normalized == "print"
  || normalized == "println"
  || normalized == "assert"
  || normalized == "throw"
  // #640 Stage 2: `throw(x)` parses to `perform Exception::Throw(x)`, so a
  // perform call must stay as impure as the EThrow node it replaced (any
  // perform unwinds/effects, so this is the honest classification for every
  // effect op, not just Error).
  || normalized == "perform"
  || normalized == "sh"
  || normalized == "sh_lines"
  || normalized == "Fs::read_file"
  || normalized == "Fs::read_bytes"
  || normalized == "Fs::write_file"
  || normalized == "Fs::exists"
  || normalized == "Fs::stat_token"
  || normalized == "Fs::readdir"
  || normalized == "Fs::is_dir"
  || normalized == "Fs::mkdir"
  || normalized == "Fs::mkdir_p"
  || normalized == "Fs::getcwd"
  || normalized == "Fs::chdir"
  || normalized == "Fs::remove"
  || normalized == "Fs::is_file"
  || normalized == "Fs::copy"
  || normalized == "Fs::rename"
  || normalized == "Fs::append"
  || normalized == "Fs::write_bytes"
  || normalized == "Env::get"
  || normalized == "Env::args_len"
  || normalized == "Env::args_get"
  || normalized == "Http::request"
  || normalized == "Http::listen"
  || normalized == "vibe_http_request_raw"
  || normalized == "vibe_http_response_status_raw"
  || normalized == "vibe_http_response_header_raw"
  || normalized == "vibe_http_response_body_raw"
  || normalized == "vibe_http_close_raw"
  || normalized == "vibe_fs_stat_token_raw"
  // #865: structured subprocess result -- runs a real command, so mark
  // impure like sh/sh_lines/http above (keeps the pure-test cache, #634,
  // from wrongly reusing a stale subprocess result).
  || normalized == "vibe_sh_capture_raw"
  || normalized == "vibe_sh_capture_exit_code_raw"
  || normalized == "vibe_sh_capture_stdout_raw"
  || normalized == "vibe_sh_capture_stderr_raw"
  || normalized == "vibe_sh_capture_close_raw"
  // #903: terminates the process -- unambiguously impure/side-effecting.
  || normalized == "vibe_process_exit_raw"
  {
    2
  }
  else if normalized == "Array::push"
  || normalized == "Array::set"
  || normalized == "Bytes::push"
  || normalized == "Bytes::set"
  || normalized == "Bytes::append"
  || normalized == "Bytes::blit"
  || normalized == "Bytes::fill"
  || normalized == "ArrayBuilder::push"
  || normalized == "StringBuilder::push"
  || normalized == "MapBuilder::set"
  {
    1
  }
  else {
    0
  }
}

export fn analyze_purity(expr: Expr) -> Int {
  match expr {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EIdent(_, _) => 0,
    EArray(elems) => {
      let mut result = 0
      let mut i = 0
      while i < Array::length(elems) {
        result = merge_purity(result, analyze_purity(Array::get(elems, i)))
        i = i + 1
      }
      result
    },
    ETuple(elems) => {
      let mut result = 0
      let mut i = 0
      while i < Array::length(elems) {
        result = merge_purity(result, analyze_purity(Array::get(elems, i)))
        i = i + 1
      }
      result
    },
    ERecord(_, fields, _) => {
      let mut result = 0
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        result = merge_purity(result, analyze_purity(fval))
        i = i + 1
      }
      result
    },
    ELet(_, val, body, _) => merge_purity(analyze_purity(val), analyze_purity(body)),
    ELetRec(_, val, body) => merge_purity(analyze_purity(val), analyze_purity(body)),
    ELetMut(_, val, body, _) => merge_purity(1, merge_purity(analyze_purity(val), analyze_purity(body))),
    EAssign(_, val, cont) => merge_purity(1, merge_purity(analyze_purity(val), analyze_purity(cont))),
    EAssignOp(_, _, val, cont) => merge_purity(1, merge_purity(analyze_purity(val), analyze_purity(cont))),
    ESeq(a, b) => merge_purity(analyze_purity(a), analyze_purity(b)),
    EIf(cond, then_e, else_e) => merge_purity(analyze_purity(cond), merge_purity(analyze_purity(then_e), analyze_purity(else_e))),
    EMatch(scrutinee, arms) => {
      let mut result = analyze_purity(scrutinee)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, i)
        result = merge_purity(result, analyze_purity(arm_body))
        i = i + 1
      }
      result
    },
    EHandle(body, arms) => {
      let mut result = analyze_purity(body)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, i)
        result = merge_purity(result, analyze_purity(arm_body))
        i = i + 1
      }
      result
    },
    EWhile(cond, body) => merge_purity(1, merge_purity(analyze_purity(cond), analyze_purity(body))),
    ELoop(params, body) => {
      let mut result = 1
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        result = merge_purity(result, analyze_purity(init))
        i = i + 1
      }
      merge_purity(result, analyze_purity(body))
    },
    EForIn(_, _, iter, body) => merge_purity(1, merge_purity(analyze_purity(iter), analyze_purity(body))),
    EBinOp(_, left, right) => merge_purity(analyze_purity(left), analyze_purity(right)),
    EUnaryOp(_, operand) => analyze_purity(operand),
    EFn(_, _, _, _, _, _) => 0,
    ECall(callee, args, _) => {
      let base = match callee {
        EIdent(name, _) => builtin_purity(name),
        _ => 2
      }
      let mut args_p = 0
      let mut i = 0
      while i < Array::length(args) {
        args_p = merge_purity(args_p, analyze_purity(Array::get(args, i)))
        i = i + 1
      }
      merge_purity(base, args_p)
    },
    EReturn(e) => analyze_purity(e),
    EDot(obj, _, _, _) => analyze_purity(obj),
    EBreak(_) => 1,
    EContinue(_) => 1,
    ELabeledArg(_, _, body) => analyze_purity(body),
    _ => 0
  }
}

export fn is_pure(expr: Expr) -> Bool {
  analyze_purity(expr) == 0
}

export fn is_local(expr: Expr) -> Bool {
  analyze_purity(expr) <= 1
}

export fn analyze_stmt_purity(stmt: Stmt) -> Int {
  match stmt {
    SLet(_, _, _, _, body) => analyze_purity(body),
    SLetMut(_, _, body) => merge_purity(1, analyze_purity(body)),
    STest(_, body) => analyze_purity(body),
    SBench(_, body) => analyze_purity(body),
    SExpr(e) => analyze_purity(e),
    _ => 0
  }
}
