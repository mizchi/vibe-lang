//# Imports

import ./cache_probe_support.vibe {
  selfbuild_probe_type_db_cache_counts
}

//# Functions

fn run_cache_probe() -> Int with Error {
  let encoded_cache = selfbuild_probe_type_db_cache_counts()
  let cache_count1 = encoded_cache / 1000
  let cache_count2 = encoded_cache % 1000
  assert(cache_count1 > 0)
  assert(cache_count2 == cache_count1)
  0
}

/// ADR-0069: top level is declarations only -- keep the probe invocation's
/// result as a named let (was a bare top-level expression statement, never
/// checked before this directory had a real index.vpkg package boundary
/// triggering full-package validation from an external import).
let _cache_probe_run_result = handle {
  run_cache_probe()
} with Error {
  Throw(_) => {
    assert(false)
    1
  }
}
