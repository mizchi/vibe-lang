//# Imports

import ./cache_probe_support.vibe {
  selfbuild_probe_type_db_cache_counts
}

//# Functions

fn run_cache_probe() -> Int with Env + Exception {
  let encoded_cache = selfbuild_probe_type_db_cache_counts()
  let cache_count1 = encoded_cache / 1000
  let cache_count2 = encoded_cache % 1000
  assert(cache_count1 > 0)
  assert(cache_count2 == cache_count1)
  0
}

/// ADR-0069: top level is declarations only -- the probe invocation is a
/// named declaration (it was a bare top-level expression statement, never
/// checked before this directory had a real index.vpkg package boundary
/// triggering full-package validation from an external import). #1962: a
/// function rather than a top-level `let`, because the probe now reads the
/// environment (`VIBE_BUILD_CACHE_DIR`) and a top-level value has no row to
/// carry `Env` on.
fn cache_probe_run_result() -> Int with Env {
  handle {
    run_cache_probe()
  } with { Exception::Throw(_) => {
    assert(false)
    1
  } }
}
