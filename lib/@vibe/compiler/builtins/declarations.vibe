//# Socket
// #1236 review: this file is documentation only (no build step currently
// parses it into builtin_table.bin -- see double_parse_expr.vibe's "dead,
// never-consulted" note on this file's role). The checker-visible names are
// the raw dunder builtins below, NOT a `Socket::`-qualified name -- see
// builtin_registry.vibe's comment on why (structural signature collision
// with lib/@vibe/socket's own in-package `effect TcpSocket`). Call
// lib/@vibe/socket's tcp_connect/tcp_read/tcp_write/tcp_close wrappers,
// not these builtins, directly.
declare vibe_tcp_connect_raw(String, Int) -> Int
declare vibe_tcp_read_raw(Int, Int) -> String
declare vibe_tcp_write_raw(Int, String) -> Unit
declare vibe_tcp_close_raw(Int) -> Unit

