import ./prelude_transport.vibe {
  decode_prelude_module_job, encode_prelude_module_product
}
import @vibe/compiler/codegen/wasi {
  run_prelude_module_job
}
fn main() -> Unit allows Env + Exception + Fs {
  let list = Fs::read_file(Env::get("VIBE_LOWERING_WORKER_LIST"))
  for path in String::split(list, "\n") {
    if path != "" {
      let job = decode_prelude_module_job(Fs::read_bytes(path))
      let product = run_prelude_module_job(job)
      Fs::write_bytes(path + ".product", encode_prelude_module_product(product))
    } else ()
  }
  ()
}
