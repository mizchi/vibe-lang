//# Imports

import ./core {
  Expr,
  Pat,
  TypeExpr
}

//# Functions

let join: (Array[String], String) -> String = (arr, sep) -> {
  let len = Array::length(arr)
  let rec go: (Int, String) -> String = (i, acc) -> {
    if i >= len {
      acc
    }
    else {
      let s = if i > 0 {
        String::concat(String::concat(acc, sep), Array::get(arr, i))
      } else Array::get(arr, i)
      go(i + 1, s)
    }
  }
  go(0, "")
}

let print_pat: (Pat) -> String = (p) -> {
  "pat"
}

let handle_effect_name_from_ctor: (String) -> Option[String] = (name) -> {
  let idx = String::last_index_of(name, "::")
  if idx < 0 {
    None
  } else {
    Some(name[0: idx])
  }
}

let rec infer_handle_effect_name_from_pat: (Pat) -> Option[String] = (pat) -> {
  match pat {
    PCtor(name, _) => handle_effect_name_from_ctor(name),
    POr(left, right) => match infer_handle_effect_name_from_pat(left) {
      Some(name) => Some(name),
      None => infer_handle_effect_name_from_pat(right)
    },
    _ => None
  }
}

let infer_handle_effect_name: (Array[(Pat, Expr)]) -> String = (arms) -> {
  let mut i = 0
  let mut effect_name = "Error"
  let mut found = false
  while i < Array::length(arms) && !found {
    let (pat, _) = Array::get(arms, i)
    match infer_handle_effect_name_from_pat(pat) {
      Some(name) => {
        effect_name = name
        found = true
      },
      None => {
        i = i + 1
      }
    }
  }
  effect_name
}

let strip_handle_effect_ctor: (String, String) -> String = (effect_name, ctor_name) -> {
  let prefix = String::concat(effect_name, "::")
  if String::starts_with(ctor_name, prefix) {
    let prefix_len = String::length(prefix)
    let ctor_len = String::length(ctor_name)
    ctor_name[prefix_len: ctor_len]
  } else {
    ctor_name
  }
}

let rec print_handle_pat: (String, Pat) -> String = (effect_name, pat) -> {
  match pat {
    PCtor(name, args) => {
      let short_name = strip_handle_effect_ctor(effect_name, name)
      if Array::length(args) == 0 {
        short_name
      } else {
        let parts = for arg in args {
          print_pat(arg)
        }
        String::concat(short_name, String::concat("(", String::concat(join(parts, ", "), ")")))
      }
    },
    POr(left, right) => String::concat(print_handle_pat(effect_name, left), String::concat(" | ", print_handle_pat(effect_name, right))),
    _ => print_pat(pat)
  }
}

let map_to_strings: (Array[Expr], (Expr) -> String) -> Array[String] = (exprs, f) -> {
  for expr in exprs {
    f(expr)
  }
}

export let rec print_expr: (Expr) -> String = (e) -> {
  match e {
    EInt(n) => __to_string(n),
    EFloat(n) => __to_string(n),
    EString(s) => String::concat("\"", String::concat(s, "\"")),
    EBool(b) => if b {
      "true"
    } else "false",
    EIdent(name, _) => name,
    EUnit => "()",
    ETuple(elems) => String::concat("(", String::concat(join(map_to_strings(elems, print_expr), ", "), ")")),
    EArray(elems) => String::concat("[", String::concat(join(map_to_strings(elems, print_expr), ", "), "]")),
    ERecord(fields) => {
      let parts = for field in fields {
        let (name, val) = field
        String::concat(name, String::concat(": ", print_expr(val)))
      }
      String::concat("{ ", String::concat(join(parts, ", "), " }"))
    },
    EIf(cond, then_e, else_e) => String::concat("if ", String::concat(print_expr(cond), String::concat(" { ", String::concat(print_expr(then_e), String::concat(" } else { ", String::concat(print_expr(else_e), " }")))))),
    ELet(name, val, body) => String::concat("let ", String::concat(name, String::concat(" = ", String::concat(print_expr(val), String::concat("; ", print_expr(body)))))),
    ELetRec(name, val, body) => String::concat("let rec ", String::concat(name, String::concat(" = ", String::concat(print_expr(val), String::concat("; ", print_expr(body)))))),
    ELetMut(name, val, body) => String::concat("let mut ", String::concat(name, String::concat(" = ", String::concat(print_expr(val), String::concat("; ", print_expr(body)))))),
    EAssign(name, val, body) => String::concat(name, String::concat(" = ", String::concat(print_expr(val), String::concat("; ", print_expr(body))))),
    EAssignOp(name, op, val, body) => String::concat(name, String::concat(" ", String::concat(op, String::concat("= ", String::concat(print_expr(val), String::concat("; ", print_expr(body))))))),
    ESeq(a, b) => String::concat(print_expr(a), String::concat("; ", print_expr(b))),
    EMatch(scrutinee, arms) => {
      let parts = for arm in arms {
        let (pat, expr) = arm
        String::concat(print_pat(pat), String::concat(" => ", print_expr(expr)))
      }
      String::concat("match ", String::concat(print_expr(scrutinee), String::concat(" { ", String::concat(join(parts, ", "), " }"))))
    },
    EHandle(body, arms) => {
      let effect_name = infer_handle_effect_name(arms)
      let parts = for arm in arms {
        let (pat, expr) = arm
        String::concat(print_handle_pat(effect_name, pat), String::concat(" => ", print_expr(expr)))
      }
      String::concat("handle { ", String::concat(print_expr(body), String::concat(" } with ", String::concat(effect_name, String::concat(" { ", String::concat(join(parts, "; "), " }"))))))
    },
    EWhile(cond, body) => String::concat("while ", String::concat(print_expr(cond), String::concat(" { ", String::concat(print_expr(body), " }")))),
    EForIn(name, index_name, iterable, body) => String::concat("for ", String::concat(match index_name {
      Some(index_name) => String::concat(index_name, String::concat(", ", name)),
      None => name
    }, String::concat(" in ", String::concat(print_expr(iterable), String::concat(" { ", String::concat(print_expr(body), " }")))))),
    ECall(callee, args, _) => String::concat(print_expr(callee), String::concat("(", String::concat(join(map_to_strings(args, print_expr), ", "), ")"))),
    EBinOp(op, left, right) => String::concat("(", String::concat(print_expr(left), String::concat(" ", String::concat(op, String::concat(" ", String::concat(print_expr(right), ")")))))),
    EUnaryOp(op, expr) => String::concat("(", String::concat(op, String::concat(print_expr(expr), ")"))),
    EFn(_, _, params, ret_ty, effect, body) => {
      let parts = for param in params {
        let (name, ty_opt) = param
        match ty_opt {
          Some(ty) => String::concat(name, String::concat(": ", __to_string(ty))),
          None => name
        }
      }
      let ret_str = match ret_ty {
        Some(rt) => String::concat(") -> ", String::concat(__to_string(rt), String::concat(" { ", String::concat(print_expr(body), " }")))),
        None => String::concat(") -> ", print_expr(body))
      }
      String::concat("(", String::concat(join(parts, ", "), ret_str))
    },
    EDot(expr, field, _, _) => String::concat(print_expr(expr), String::concat(".", field)),
    ELabeledArg(name, modifier, val) => String::concat(name, String::concat("=", print_expr(val))),
    ELoop(_, _) => "<loop>",
    EThrow(e) => String::concat("throw(", String::concat(print_expr(e), ")")),
    EBreak(_) => "break",
    EContinue(_) => "continue",
    EMap(_) => "map",
    ESpread(e) => String::concat("...", print_expr(e)),
    EStringInterp(_) => "<interp>"
  }
}
