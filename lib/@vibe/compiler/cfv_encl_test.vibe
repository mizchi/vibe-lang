import @vibe/compiler/core {
  Expr, Pat
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/codegen/common_analysis {
  collect_free_vars_indexed_self
}

test "collect_free_vars_indexed_self captures encl-shadowed global-named param" {
  // body: g(f(z))  -- f/g are enclosing-scope (compose's own) params,
  // but a top-level fn ALSO named "f" exists in fn_name_index.
  let body = ECall(EIdent("g", -1), [
    ECall(EIdent("f", -1), [
      EIdent("z", -1)
    ], -1)
  ], -1)
  let fv = collect_free_vars_indexed_self(body, [
    "z"
  ], [
    "f"
  ], "__self__", [
    "f",
    "g"
  ])
  let mut has_f = false
  let mut has_g = false
  let mut i = 0
  while i < Array::length(fv) {
    if Array::get(fv, i) == "f" {
      has_f = true
    };
    if Array::get(fv, i) == "g" {
      has_g = true
    };
    i = i + 1
  }
  if !has_f {
    throw("expected \"f\" captured (shadowed by encl), got fv=\{fv}")
  };
  if !has_g {
    throw("expected \"g\" captured (shadowed by encl), got fv=\{fv}")
  };
  0
}

// #1212 Codex review (P1): EAssign/EAssignOp assignment TARGETS have the
// same fn_name_index-vs-encl precedence, checked separately from the plain
// EIdent case above -- a closure whose only use of an enclosing `let mut f`
// is a write (`f = ...` / `f += ...`, never read as a plain identifier)
// must still capture it even when the linked program also defines an
// unrelated top-level `fn f`.
test "collect_free_vars_indexed_self captures encl-shadowed global-named EAssignOp target" {
  // body: f += 1  (write-only -- no plain EIdent("f") read anywhere)
  let body = EAssignOp("f", "+=", EInt(1), EUnit)
  let fv = collect_free_vars_indexed_self(body, [
  ], [
    "f"
  ], "__self__", [
    "f"
  ])
  let mut has_f = false
  let mut i = 0
  while i < Array::length(fv) {
    if Array::get(fv, i) == "f" {
      has_f = true
    };
    i = i + 1
  }
  if !has_f {
    throw("expected \"f\" captured (shadowed by encl) via EAssignOp target, got fv=\{fv}")
  };
  0
}

test "collect_free_vars_indexed_self captures encl-shadowed global-named EAssign target" {
  // body: f = 5  (write-only)
  let body = EAssign("f", EInt(5), EUnit)
  let fv = collect_free_vars_indexed_self(body, [
  ], [
    "f"
  ], "__self__", [
    "f"
  ])
  let mut has_f = false
  let mut i = 0
  while i < Array::length(fv) {
    if Array::get(fv, i) == "f" {
      has_f = true
    };
    i = i + 1
  }
  if !has_f {
    throw("expected \"f\" captured (shadowed by encl) via EAssign target, got fv=\{fv}")
  };
  0
}
