import @vibe/compiler/core {
  Expr, Pat
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/codegen/common_analysis {
  collect_free_vars_indexed_self
}

test "collect_free_vars_indexed_self captures encl-shadowed global-named param" {
  // body: g(f(z))  -- f/g are enclosing-scope (compose's own) params,
  // but a top-level fn ALSO named "f" exists in fn_name_index.
  let body = ECall(EIdent("g", -1), [
    ECall(EIdent("f", -1), [EIdent("z", -1)], -1)
  ], -1)
  let fv = collect_free_vars_indexed_self(body, ["z"], ["f"], "__self__", ["f", "g"])
  let mut has_f = false
  let mut has_g = false
  let mut i = 0
  while i < Array::length(fv) {
    if Array::get(fv, i) == "f" {
      has_f = true
    };
    if Array::get(fv, i) == "g" {
      has_g = true
    };
    i = i + 1
  }
  if !has_f {
    throw("expected \"f\" captured (shadowed by encl), got fv=\{fv}")
  };
  if !has_g {
    throw("expected \"g\" captured (shadowed by encl), got fv=\{fv}")
  };
  0
}
