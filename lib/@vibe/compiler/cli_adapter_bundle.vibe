"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_gt_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_str_ref,\n  expr_tag,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  is_efn,\n  is_eident,\n  is_etuple,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  lookup_ctor,\n  rc_shadow_base,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile