let cli_adapter_source_43 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_simd.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# Functions\n\n// #536: first-class WebAssembly 128-bit SIMD (V128) intrinsics. The V128 type is\n// represented structurally as CtNamed(\"V128\", []) (no core Type enum variant),\n// exactly like Future/Stream/Task in builtins_async.vibe. Each intrinsic is bound\n// to one or more wasm SIMD instructions; codegen is inline in\n// codegen/expr/compile_call.vibe (non-RC linear backend only). The signatures\n// below mirror declarations.vibe:201-214 and are the source of truth.\n\nfn simd_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn simd_v128_ty() -> Type {\n  CtNamed(\"V128\", simd_no_params())\n}\n\nfn simd_one_param(a: Type) -> Array[Type] {\n  let arr = simd_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nfn simd_two_params(a: Type, b: Type) -> Array[Type] {\n  let arr = simd_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nfn simd_three_params(a: Type, b: Type, c: Type) -> Array[Type] {\n  let arr = simd_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\n// Loads / stores against a Bytes payload.\nfn lookup_simd_mem(name: String) -> Option[Type] {\n  if name == \"v128_load\" {\n    // v128_load(Bytes, Int) -> V128\n    Some(CtFn(simd_two_params(CtBytes, CtInt), simd_v128_ty(), None))\n  } else if name == \"v128_store\" {\n    // v128_store(Bytes, Int, V128) -> Unit\n    Some(CtFn(simd_three_params(CtBytes, CtInt, simd_v128_ty()), CtUnit, None))\n  } else if name == \"simd_skip_ws\" {\n    // #536 P3: simd_skip_ws(Bytes, Int, Int) -> Int — fused whitespace skip.\n    // Returns the first index >= pos that is not ASCII whitespace, or len.\n    // Codegen is a single inline v128 scan loop (no per-op v128 boxing).\n    Some(CtFn(simd_three_params(CtBytes, CtInt, CtInt), CtInt, None))\n  } else {\n    None\n  }\n}\n\n// splat + binary lane ops returning V128.\nfn lookup_simd_lane_a(name: String) -> Option[Type] {\n  if name == \"v128_splat_i8x16\" {\n    // v128_splat_i8x16(Int) -> V128\n    Some(CtFn(simd_one_param(CtInt), simd_v128_ty(), None))\n  } else if name == \"v128_eq_i8x16\" {\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\n  } else if name == \"v128_le_u_i8x16\" {\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\n  } else if name == \"v128_ge_u_i8x16\" {\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\n  } else {\n    None\n  }\n}\n\n// bitwise ops returning V128.\nfn lookup_simd_lane_b(name: String) -> Option[Type] {\n  if name == \"v128_and\" {\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\n  } else if name == \"v128_or\" {\n    Some(CtFn(simd_two_params(simd_v128_ty(), simd_v128_ty()), simd_v128_ty(), None))\n  } else if name == \"v128_not\" {\n    Some(CtFn(simd_one_param(simd_v128_ty()), simd_v128_ty(), None))\n  } else {\n    None\n  }\n}\n\n// reductions returning Int / Bool.\nfn lookup_simd_reduce(name: String) -> Option[Type] {\n  if name == \"v128_bitmask_i8x16\" {\n    // v128_bitmask_i8x16(V128) -> Int\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtInt, None))\n  } else if name == \"v128_any_true\" {\n    // v128_any_true(V128) -> Bool\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtBool, None))\n  } else if name == \"v128_all_true_i8x16\" {\n    // v128_all_true_i8x16(V128) -> Bool\n    Some(CtFn(simd_one_param(simd_v128_ty()), CtBool, None))\n  } else {\n    None\n  }\n}\n\nexport fn lookup_simd(name: String) -> Option[Type] {\n  match lookup_simd_mem(name) {\n    Some(t) => Some(t),\n    None => match lookup_simd_lane_a(name) {\n      Some(t) => Some(t),\n      None => match lookup_simd_lane_b(name) {\n        Some(t) => Some(t),\n        None => lookup_simd_reduce(name)\n      }\n    }\n  }\n}\n")
}

