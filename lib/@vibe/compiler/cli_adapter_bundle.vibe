    else if fname == \"Double::max\" || fname == \"Double::min\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      if ctx.enable_rc {\n        emit_unbox_float(buf)\n      }\n      emit_f64_reinterpret_i64(buf)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      if ctx.enable_rc {\n        emit_unbox_float(buf)\n      }\n      emit_f64_reinterpret_i64(buf)\n      if fname == \"Double::max\" {\n        emit_f64_max(buf)\n      } else {\n        emit_f64_min(buf)\n      }\n      emit_i64_reinterpret_f64(buf)\n      if ctx.enable_rc {\n        Array::push(local_names, \"__fminmax_bits\")\n        Array::push(local_names, \"__fminmax_box\")\n        emit_box_float(buf, ctx, nl, nl + 1)\n        nl + 2\n      } else {\n        nl\n      }\n    }\n    else if fname == \"Char::to_int\" || fname == \"Char::from_int\" {\n      // Char's runtime representation IS the (tagged) code point; both\n      // conversions are identities. Char::from_int used to sneak through a\n      // fallback path while Char::to_int died with \"undefined variable\n      // (local): Char::to_int @call\" (bench/bench_char_conversion.vibe,\n      // vibe/prelude/char.vibe's lower/upper).\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"resume\" {\n      // ADR-0076 追記34 V2: the replay engine (memo region + tag-1 rethrow\n      // this call used to compile to) is gone. Every lowering that keeps\n      // `resume` meaningful rewrites it away before codegen (edp's\n      // tail-resumptive dict members, scps's continuation calls), and\n      // compile_expr_tail6 no longer compiles non-Error handler arms at\n      // all -- so a `resume` reaching this point means an upstream pass\n      // failed to consume its handle. Fail loudly instead of emitting a\n      // write into a region that no longer exists.\n      throw(\"internal: `resume` reached codegen -- its handle was neither migrated (evidence dict) nor CPS-transformed (suspend class), and the replay engine was removed (ADR-0076 追記34 V2)\")\n    }\n    else if fname == \"assert\" {\n      // #1095: no `!prefer_bound_call` guard here (assert_true / assert_eq\n      // below never had one). Inside a lambda, capture analysis lists the\n      // free name `assert` as a capture; the creation site cannot resolve it\n      // and stores 0, so the \"bound call\" dispatched call_indirect through a\n      // ZERO closure — table slot 0, i.e. an arbitrary user function. Before\n      // #1107 Phase 4 that slot always happened to be populated, silently\n      // NO-OPing every assert in a closure (concurrent_test's asserts never\n      // actually asserted); with the minimized funcref table it surfaced as\n      // \"null function\" traps. Builtin statement asserts cannot be shadowed\n      // meaningfully, so always compile the builtin form.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i32_wrap_i64(buf)\n      emit_if_void(buf)\n      emit_else(buf)\n      bytebuf_push(buf, 0)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl\n    }\n    else if fname == \"assert_true\" {\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i32_wrap_i64(buf)\n      emit_if_void(buf)\n      emit_else(buf)\n      bytebuf_push(buf, 0)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl\n    }\n    else if fname == \"assert_eq\" {\n      // #756: lower as `assert(a == b)` — the synthesized `==` rides\n      // emit_eq_value's operand classification (intish fast-path, #724 agg\n      // slots, runtime `eq` fall-back). The old raw i64.eq compared the\n      // (ptr<<32)|len STRING repr by pointer, so a heap string the static\n      // classifier can't see (e.g. a tuple-destructured binding) failed\n      // against an equal-content literal while `a == b` passed.\n      let nl = ce(buf, EBinOp(\"==\", Array: