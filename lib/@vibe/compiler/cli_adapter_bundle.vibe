"//# Imports\n\nexport ./linked_artifacts.vibe {\n  compile_file_wasi_linked, compile_file_wasi_linked_artifacts\n}\n\nexport ./linked_library.vibe {\n  compile_file_wasi_library\n}\n\n//# Misc\n\nexport {\n  compile_file_wasi_linked, compile_file_wasi_library, compile_file_wasi_linked_artifacts\n}\n")
