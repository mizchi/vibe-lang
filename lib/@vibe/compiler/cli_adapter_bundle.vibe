  } else {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nl\n    }\n    else if ctx.enable_rc && (fname == \"vibe_http_response_status_raw\" || fname == \"vibe_http_response_body_raw\" || fname == \"vibe_http_close_raw\") {\n      // #794: same raw-ABI shim as the #705 block above for the HTTP client\n      // host imports. The handle param is a guest-tagged Int (untag it);\n      // response_status returns a raw Int (tag it). response_body returns a\n      // packed string (same in both modes) and close returns nothing --\n      // leaving a raw int result untagged would repeat the #768 Fs::is_dir\n      // odd-raw-value RC-pointer misread (raw handle 1 is odd).\n      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i64_const(buf, 1)\n      emit_i64_shr_s(buf)\n      emit_call(buf, hi_idx)\n      if fname == \"vibe_http_response_status_raw\" {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      } else if fname == \"vibe_http_close_raw\" {\n        // (i64) -> () import: the surrounding expression still expects a\n        // value, so push the Unit 0 the generic returns==0 path would.\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      nl\n    }\n    else if ctx.enable_rc && fname == \"vibe_http_response_header_raw\" {\n      // #794: (handle: Int -> untag, name: String -> pass) -> String (pass).\n      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i64_const(buf, 1)\n      emit_i64_shr_s(buf)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_call(buf, hi_idx)\n      nl\n    }\n    else if ctx.enable_rc && fname == \"vibe_http_request_raw\" {\n      // #794: four packed-string params pass through; the raw Int handle\n      // result must be tagged (it is 1-based, so leaving it raw hands the RC\n      // machinery an odd non-pointer -- the exact #768 failure shape).\n      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)\n      nl = ce(buf, Array::get(args, 3), local_names, nl, ctx, ld)\n      emit_call(buf, hi_idx)\n      emit_i64_const(buf, 1)\n      emit_i64_shl(buf)\n      nl\n    }\n    else if ctx.enable_rc && fname == \"vibe_sh_capture_raw\" {\n      // #865: same raw-ABI shim shape as vibe_http_request_raw above -- one\n      // packed-string param passes through; the raw Int handle result must\n      // be tagged (untagged, it's the same #768 odd-raw-value RC-pointer\n      // misread the http/#705 shims above all guard against).\n      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_call(buf, hi_idx)\n      emit_i64_const(buf, 1)\n      emit_i64_shl(buf)\n      nl\n    }\n    else if ctx.enable_rc && (fname == \"vibe_sh_capture_exit_code_raw\" || fname == \"vibe_sh_capture_stdout_raw\" || fname == \"vibe_sh_capture_stderr_raw\" || fname == \"vibe_sh_capture_close_raw\" || fname == \"vibe_process_exit_raw\") {\n      // #865: same raw-ABI shim shape as the vibe_http_response_status_raw /\n      // vibe_http_response_body_raw / vibe_http_close_raw group above -- the\n      // handle param is a guest-tagged Int (untag it); exit_code returns a\n      // raw Int (tag it), stdout/stderr return packed strings (same in both\n      // modes, pass through), close returns nothing (push Unit 0).\n      // #903: vibe_process_exit_raw takes the same shape as close (one\n      // tagged-Int arg to untag, no meaningful return -- the host runner\n      // traps/exits before ever returning, but codegen still needs SOME\n      // Unit value on the stack for the (never-reached) fallthrough).\n      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i64_const(buf, 1)\n      emit_i64_shr_s(buf)\n      emit_call(buf, hi_idx)\n      if fname == \"vibe_sh_capture_exit_code_raw\" {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      } else if fname == \"vibe_sh_capture_close_raw\" || fname == \"vibe_process_exit_raw\" {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      nl\n    }\n    else if ctx.enable_rc && (fname == \"Stdout::write_char\" || fname == \"Stderr::write_char\" || fname == \"Stdin::read_stream\") {\n      // #930: same raw-ABI shim shape as the #705 Fs::exists family and the\n      // #865 vibe_process_exit_raw case above -- these three were registered\n      // straight into the func table (linked_compile's name->import map) with\n      // NO shim, so the generic call path handed the host a guest-TAGGED int\n      // (write_char(65) wrote byte 130 -- \"42\" printed as \"hd\" -- and\n      // read_stream(n) read 2n bytes). Untag the int param; write_char's\n      // void import pushes Unit 0, read_stream's packed-string result passes\n      // through unchanged (same in both modes).\n      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i64_const(buf, 1)\n      emit_i64_shr_s(buf)\n      emit_call(buf, hi_idx)\n      if fname == \"Stdin::read_stream\" {\n        ()\n      } else {\n        emit_i64_const(buf, 0)\n      }\n      nl\n    }\n    else if (fname == \"println\" || fname == \"print\") && !cc_ft_has(ctx.func_table, fname) {\n      // #929: the println/print checker builtins had NO linear-lane lowering\n      // at all -- builtin_registry marks them in_linear_table=false on the\n      // assumption that \"a real prelude source function\" serves the linear\n      // lane (see the FixedArray comment above), but that function lives in\n      // @vibe/io, so any program that does not import it died at codegen\n      // with \"undefined variable (local): println @call\". When no SOURCE\n      // definition is merged (the cc_ft_has guard keeps @vibe/io's println\n      // and user shadows winning), lower directly onto the Stdout host\n      // imports on BOTH lanes: the packed-string arg passes through to\n      // write_stream unchanged (same in both modes), and println appends a\n      // RAW newline byte via write_char -- a direct emit_call to the import\n      // index bypasses each lane's arg conversion (the RC/raw ABI hands the\n      // host raw ints anyway, and the non-RC lane's untagging lives in the\n      // generic call path we are NOT going through), so the raw byte value\n      // is correct on BOTH lanes. Import gating in linked_compile.vibe\n      // includes println/print for exactly this path.\n      let (ws_idx, _, _) = resolve_func(ctx.func_table, \"Stdout::write_stream\")\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_call(buf, ws_idx)\n      if fname == \"println\" {\n        let (wc_idx, _, _) = resolve_func(ctx.func_table, \"Stdout::write_char\")\n        emit_i64_const(buf, 10)\n        emit_call(buf, wc_idx)\n      } else {\n        ()\n      }\n      emit_i64_const(buf, 0)\n      nl\n    }\n    else if fname == \"__rec_field\" {\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let idx_expr = Array::get(args, 1)\n      let field_idx = get_eint_value(idx_expr)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + field_idx * 8)\n      nl\n    }\n    else if fname == \"__len\" {\n      let (sl_idx, _, _) = resolve_func(ctx.func_table, \"String::length\")\n      let (bl_idx, _, _) = resolve_func(ctx.func_table, \"Bytes::length\")\n      let (al_idx, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n      let obj_local = next_local\n      let ptr_local = next_local + 1\n      let cap_local = next_local + 2\n      Array::push(local_names, \"__len_obj\")\n      Array::push(local_names, \"__len_ptr\")\n      Array::push(local_names, \"__len_cap\")\n      let mut nl = next_local + 3\n      nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)\n      emit_local_set(buf, obj_local)\n      emit_local_get(buf, obj_local)\n      emit_i64_const(buf, 32)\n      emit_i64_shr_s(buf)\n      emit_i64_eqz(buf)\n      emit_if_i64(buf)\n      emit_local_get(buf, obj_local)\n      emit_local_set(buf, ptr_local)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_load(buf, 2, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, cap_local)\n      emit_local_get(buf, cap_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 2147483647)\n      emit_i32_gt_u(buf)\n      emit_if_i64(buf)\n      emit_local_get(buf, obj_local)\n      emit_call(buf, bl_idx)\n      emit_else(buf)\n      emit_local_get(buf, obj_local)\n      emit_call(buf, al_idx)\n      emit_end(buf)\n      emit_else(buf)\n      emit_local_get(buf, obj_local)\n      emit_call(buf, sl_idx)\n      emit_end(buf)\n      nl\n    }\n    else if fname == \"__index\" {\n      let (sg_idx, _, _) = resolve_func(ctx.func_table, \"String::char_code_at\")\n      let (bg_idx, _, _) = resolve_func(ctx.func_table, \"Bytes::get\")\n      let (ag_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n      let obj_local = next_local\n      let idx_local = next_local + 1\n      let ptr_local = next_local + 2\n      let cap_local = next_local + 3\n      Array::push(local_names, \"__index_obj\")\n      Array::push(local_names, \"__index_idx\")\n      Array::push(local_names, \"__index_ptr\")\n      Array::push(local_names, \"__index_cap\")\n      let mut nl = next_local + 4\n      nl = ce(buf, Array::get(args, 0)