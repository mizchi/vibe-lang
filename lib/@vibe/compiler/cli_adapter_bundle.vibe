let cli_adapter_source_152 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_lambda_body.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, TypeExpr\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtxGc\n}\n\nimport ./backend_lambda_collect.vibe {\n  collect_lambda_captures_gc\n}\n\nimport ./backend_lambda_emit.vibe {\n  emit_lambda_closure_gc\n}\n\nimport ./backend_lambda_inner.vibe {\n  compile_lambda_inner_gc\n}\n\nimport ./backend_lambda_record.vibe {\n  record_lambda_meta_gc\n}\n\nimport ./backend_lambda_sig.vibe {\n  CompileLambdaGcFn\n}\n\n//# Functions\n\nexport fn compile_lambda_gc(buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, compile_fn: CompileLambdaGcFn) -> Int with { Error } {\n  let (captures, num_captures, user_params) = collect_lambda_captures_gc(params, fn_body, ctx)\n  let (lam_buf, final_lam_nl) = compile_lambda_inner_gc(params, fn_body, captures, user_params, ctx, compile_fn, ld)\n  let lambda_idx = record_lambda_meta_gc(ctx, lam_buf, user_params, captures, final_lam_nl)\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  Array::push(ctx.table_slots_used, table_slot)\n  emit_lambda_closure_gc(buf, captures, num_captures, local_names, next_local, table_slot)\n}\n")
}

let cli_adapter_source_153 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_lambda_collect.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, TypeExpr\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtxGc, CtorTable, FuncTable\n}\n\n//# Functions\n\nexport fn collect_lambda_captures_gc(params: Array[(String, Option[TypeExpr])], fn_body: Expr, ctx: CompileCtxGc) -> (Array[String], Int, Int) {\n  let param_names_arr = array_empty()\n  let func_table = ctx.func_table\n  let ctor_table = ctx.gc_ctor_table\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, _) = Array::get(params, pi)\n    Array::push(param_names_arr, pname)\n    pi = pi + 1\n  }\n  let mut globals = Array::concat(func_table.names, ctor_table.names)\n  // #538: names that resolve globally must not be captured as env slots --\n  // module-level literal constants and the call-site-only desugar builtins\n  // (handled by name in compile_call_gc, absent from the func table).\n  globals = Array::concat(globals, ctx.gc_const_names)\n  globals = Array::concat(globals, ctx.gc_global_names)\n  globals = Array::concat(globals, [\n    \"__index\",\n    \"__len\",\n    \"__set_field\",\n    \"__set_index\",\n    \"__slice\",\n    \"__rec_field\"\n  ])\n  let captures = collect_free_vars(fn_body, param_names_arr, globals)\n  let num_captures = Array::length(captures)\n  let user_params = Array::length(params)\n  (captures, num_captures, user_params)\n}\n")
}

let cli_adapter_source_154 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_lambda_inner.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, TypeExpr, bytebuf_new\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtxGc, emit_i64_load\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_i32_wrap_i64, emit_local_get, emit_local_set\n}\n\nimport ./backend_lambda_ctx.vibe {\n  make_lambda_ctx_gc\n}\n\nimport ./backend_lambda_sig.vibe {\n  CompileLambdaGcFn\n}\n\n//# Functions\n\nexport fn compile_lambda_inner_gc(params: Array[(String, Option[TypeExpr])], fn_body: Expr, captures: Array[String], user_params: Int, ctx: CompileCtxGc, compile_fn: CompileLambdaGcFn, ld: Int) -> (Bytes, Int) with { Error } {\n  let lam_buf = bytebuf_new()\n  let lam_locals = array_empty()\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname, _) = Array::get(params, lpi)\n    Array::push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  Array::push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n  let lam_ref_cells = array_empty()\n  let lam_ref_local_indices = array_empty()\n  let num_captures = Array::length(captures)\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = Array::get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    emit_local_set(lam_buf, cap_local)\n    Array::push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      Array::push(lam_ref_cells, cap_name)\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n  let lam_ctx = make_lambda_ctx_gc(ctx, lam_ref_cells, lam_ref_local_indices)\n  // #744 (gc mirror of the linear lam_float_slots seeding): annotated\n  // Float/Double params join the fresh scope's float tracking, so closure\n  // bodies get real f64 arithmetic/comparisons and the Double __to_string\n  // formatter instead of raw-bits integer ops.\n  // #1015 (gc mirror of the linear lam_bool_slots seeding): annotated Bool\n  // params join the fresh scope's bool tracking, so `to_string(b)` /\n  // `\"\\{b}\"` on a Bool-typed closure param takes the \"true\"/\"false\"\n  // formatter instead of the generic runtime dispatch (which cannot tell\n  // Bool from Int -- they share the same gc-lane numeric representation).\n  // #1032: both gc_float_locals and gc_bool_locals are slot-indexed --\n  // `lfs_i` IS the param's slot in lam_locals (user params are pushed there\n  // in order starting at 0, in this function's own lam_locals-building loop\n  // above).\n  let mut lfs_i = 0\n  while lfs_i < user_params {\n    let (_, lfs_ann) = Array::get(params, lfs_i)\n    match lfs_ann {\n      Some(lfs_ty) => match lfs_ty {\n        TyName(lfs_tn) => if lfs_tn == \"Float\" || lfs_tn == \"Double\" {\n          Array::push(lam_ctx.gc_float_locals, lfs_i)\n        } else if lfs_tn == \"Bool\" {\n          Array::push(lam_ctx.gc_bool_locals, lfs_i)\n        } else {\n          ()\n        },\n        _ => ()\n      },\n      None => ()\n    }\n    lfs_i = lfs_i + 1\n  }\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, ld)\n  (lam_buf, final_lam_nl)\n}\n")
}

let cli_adapter_source_155 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_lambda_record.vibe",
"//# Imports\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtxGc, LambdaTable\n}\n\n//# Functions\n\nexport fn record_lambda_meta_gc(ctx: CompileCtxGc, lam_buf: Bytes, user_params: Int, captures: Array[String], final_lam_nl: Int) -> Int {\n  let lambda_table = ctx.lambda_table\n  let lambda_idx = Array::length(lambda_table.bodies)\n  Array::push(lambda_table.bodies, lam_buf)\n  Array::push(lambda_table.param_counts, user_params + 1)\n  Array::push(lambda_table.captures, captures)\n  let mut extra_lam = 0\n  let min_lam_nl = user_params + 1\n  if final_lam_nl > min_lam_nl {\n    extra_lam = final_lam_nl - min_lam_nl\n  }\n  Array::push(lambda_table.meta_i32, 0)\n  Array::push(lambda_table.meta_i64, extra_lam)\n  lambda_idx\n}\n")
}

let cli_adapter_source_156 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/index.vpkg",
"name = @vibe/compiler/codegen\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/codegen — ADR-0070 / #897 compiler-internal contract for\ndeps = {\n  @vibe/compiler/codegen/common_base : 0.0.1\n  @vibe/compiler/codegen/expr : 0.0.1\n  @vibe/compiler/codegen/wasi : 0.0.1\n  @vibe/compiler/core : 0.0.1\n}\n\ngenerated_hash =\n\n// @vibe/compiler/codegen — ADR-0070 / #897 compiler-internal contract for\n// this directory's own top-level files ONLY. The 8 subdirectories\n// (builtin_bodies/, common_analysis/, common_base/, common_extractors/,\n// expr/, gc/, wasi/, wasm_emit/) are each already separate, already-migrated\n// index.vpkg packages in their own right (earlier batches of this same\n// #897 series) and are NOT covered by this contract — this package imports\n// them as ordinary sibling packages, same as any other outside consumer.\n//\n// Single-file package: codegen.vibe (the old index.vibe, renamed — see\n// naming note below) is the ENTIRE directory-owned surface. It is a thin\n// public facade, forwarding compile_module/compile_wasi_module* to the\n// expr/ and wasi/ subpackages, and re-exporting a subset of\n// codegen/common_base's surface (lookup_registry_builtin, builtin_registry,\n// verify_lane_builtins, compile_inline_wat) via the `export ./common_base\n// { names }` cross-package SReExport form (#847 Phase C; same shape as\n// syntax/syntax.vibe's re-export of @vibe/parser).\n//\n// Structural wrinkle (found only via the full verification chain, not by\n// static reading — scripts/unit_test_runner.sh, not the earlier build/gate\n// steps, is what caught it): builtin_registry.vibe, double_to_string_expr.\n// vibe, int_parse_expr.vibe and inline_wat.vibe used to live at this\n// directory's top level too (siblings of codegen.vibe). But codegen/'s own\n// subpackages (expr/, gc/, wasi/) need those 4 files directly, while\n// codegen.vibe (this package's facade) ALSO depends downward on expr/ and\n// wasi/ to forward compile_module/compile_wasi_module*. Owning those 4\n// files here therefore made codegen/index.vpkg <-> codegen/expr(gc,wasi)/\n// index.vpkg a genuine two-node import cycle the moment expr/gc/wasi's leaf\n// imports of them were switched from raw file paths (rejected by\n// enforce_incoming_boundary_fs, #729, once this directory became a package\n// boundary) to boundary-legal package imports (`type_db: import cycle\n// detected at codegen/index.vpkg`). Resolved by relocating all 4 files into\n// codegen/common_base/ — see that package's index.vpkg header for the full\n// story — which already plays the \"shared substrate every codegen backend\n// and expr-compile module depends on, with no upward edges of its own\"\n// role. This package therefore ends up back to a single file, same shape as\n// common_base/ was before this same batch added those 4 files to it.\n//\n// Naming note: the established rename convention for this migration batch\n// is `git mv index.vibe <dirname>.vibe` (codegen/expr/expr.vibe,\n// codegen/gc/gc.vibe, syntax/syntax.vibe, checker/checker_facade.vibe when\n// dirname collided). For this directory the dirname is \"codegen\" and no\n// `codegen/codegen.vibe` previously existed, so the plain rename applies\n// with no collision.\n//\n// Compiled into the compiler itself via compiler_sources_manifest.tsv\n// (group `codegen`): the old single `codegen/index.vibe` row becomes a dual\n// row (this contract + codegen.vibe); builtin_registry.vibe /\n// double_to_string_expr.vibe / int_parse_expr.vibe / inline_wat.vibe's rows\n// are repointed to their new codegen/common_base/ paths (see that\n// package's manifest rows) as part of this same batch.\n\n// --- codegen.vibe\nfn compile_module(stmts: Array[Stmt]) -> Bytes with { Error }\nfn compile_wasi_module_with_sources(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error }\nfn compile_wasi_module(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_rc(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_rc_shadow(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_coverage(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_trace(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_break(stmts: Array[Stmt], entry_name: String, prov: DbgProv) -> Bytes with { Error }\n\n// --- re-exported from codegen/common_base (cross-package SReExport, see\n// header note above); NOT declared here: builtin_registry_typed,\n// double_to_string_expr, int_parse_expr, desugar_derives,\n// desugar_hoist_local_lambdas, desugar_array_spread, which codegen.vibe does\n// not re-export (nothing outside codegen/common_base itself consumes them) —\n// see codegen/common_base/index.vpkg for their declarations.\nfn lookup_registry_builtin(name: String) -> Option[Type]\nfn builtin_registry() -> Array[(String, Int, Int, Bool, Bool)]\nfn verify_lane_builtins(lane: String, names: Array[String], param_counts: Array[Int], returns: Array[Int]) -> Unit with { Error }\nfn compile_inline_wat(fn_name: String, wat: String, param_names: Array[String]) -> Bytes with { Error }\n\n// --- builtin_name.vibe / desugar_trait_dict.vibe (relocated into\n// codegen/common_base, #897 batch; see that package's index.vpkg header)\nfn canonical_builtin_name(name: String) -> String\nfn desugar_labeled_args(stmts: Array[Stmt]) -> Unit\nfn desugar_railway_binds(stmts: Array[Stmt]) -> Unit\nfn inject_prelude_result(stmts: Array[Stmt]) -> Unit\nfn inject_trait_method_generics(stmts: Array[Stmt]) -> Unit\nfn desugar_trait_dicts(stmts: Array[Stmt]) -> Unit\n")
}

let cli_adapter_source_157 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/codegen.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Stmt\n}\n\nimport @vibe/compiler/codegen/common_base {\n  DbgProv\n}\n\nimport @vibe/compiler/codegen/expr {\n  compile_module_expr\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_break_impl,\n  compile_wasi_module_coverage_impl,\n  compile_wasi_module_impl,\n  compile_wasi_module_rc_impl,\n  compile_wasi_module_rc_shadow_impl,\n  compile_wasi_module_trace_impl,\n  compile_wasi_module_with_sources_impl\n}\n\n// #847 Phase C: facade re-export so external callers reach builtin_registry's\n// (and, as of #897's codegen/ top-level batch, inline_wat's) surface only\n// through codegen/index.vpkg (this file's contract), not an internal file\n// directly. #897 UPDATE: builtin_registry.vibe / inline_wat.vibe (and their\n// double_to_string_expr.vibe / int_parse_expr.vibe siblings, not re-exported\n// here) moved to codegen/common_base/ to break a codegen/index.vpkg <->\n// codegen/expr(gc,wasi)/index.vpkg import cycle -- see codegen/common_base/\n// index.vpkg's header for the full story. Cross-package SReExport form, same\n// as syntax/syntax.vibe's re-export of @vibe/parser.\nexport ./common_base {\n  builtin_registry,\n  canonical_builtin_name,\n  compile_inline_wat,\n  desugar_labeled_args,\n  desugar_railway_binds,\n  desugar_trait_dicts,\n  inject_prelude_result,\n  inject_trait_method_generics,\n  lookup_registry_builtin,\n  verify_lane_builtins\n}\n\n//# Functions\n\nexport fn compile_module(stmts: Array[Stmt]) -> Bytes with { Error } {\n  compile_module_expr(stmts)\n}\n\nexport fn compile_wasi_module_with_sources(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error } {\n  compile_wasi_module_with_sources_impl(stmts, entry_name, srcs)\n}\n\nexport fn compile_wasi_module(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_impl(stmts, entry_name)\n}\n\n/// #701 RC variant: the Perceus RC codegen path (enable_rc) for the FS-compile\n/// entry, so `vibe run`/import-resolving programs honor VIBE_RC instead of\n/// silently using the bump path. Same merged stmts as compile_wasi_module.\nexport fn compile_wasi_module_rc(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_rc_impl(stmts, entry_name)\n}\n\n/// #715/#768 debug variant: RC codegen + shadow-liveness double-free traps\n/// (VIBE_RC=shadow) for the FS-compile entry, so import-resolving test builds\n/// can be shadow-instrumented too -- previously only the single-source path\n/// (compile_source_wasi_only_rc_shadow) supported shadow, so `vibe test`-shaped\n/// heap corruption could not be pinned to its first bad free.\nexport fn compile_wasi_module_rc_shadow(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_rc_shadow_impl(stmts, entry_name)\n}\n\n/// Coverage variant (#cov): function-level hit instrumentation + `vibe_cov`\n/// custom section. Used by the coverage self-compile entry.\nexport fn compile_wasi_module_coverage(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_coverage_impl(stmts, entry_name)\n}\n\n/// Trace variant (debugger / DAP P1 groundwork): function-call execution-trace\n/// instrumentation + `vibe.trace` custom section. Used by the FS-compile trace\n/// entry under VIBE_DEBUG=1.\nexport fn compile_wasi_module_trace(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_trace_impl(stmts, entry_name)\n}\n\n/// Break variant (debugger / DAP P1): `vibe::dbg_break` host-hook instrumentation\n/// at each user function entry. Used by the FS-compile break entry under\n/// VIBE_DEBUG_BREAK=1.\nexport fn compile_wasi_module_break(stmts: Array[Stmt], entry_name: String, prov: DbgProv) -> Bytes with { Error } {\n  compile_wasi_module_break_impl(stmts, entry_name, prov)\n}\n\n// (A second, identical `compile_wasi_module_rc` definition used to live here —\n// the flat bundle's first-match tolerated it; the #726 merge flatten surfaced\n// it as the last remaining duplicate top-level def.)\n")
}

