let cli_adapter_source_102 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/inline_wat.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  bytebuf_new, bytebuf_push, bytebuf_push_buf, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# Functions\n\n// #805 inline wasm: a small WAT-body assembler for the linear backend's\n// `fn f(a: Int, b: Int) -> Int = wasm \"(i64.add (local.get $a) (local.get $b))\"`\n// form. Compiles the body TEXT of one function to raw instruction bytes\n// (no locals-declaration header, no trailing 0x0B end opcode — exactly the\n// `bodies` convention of linked_compile.vibe's code-section builder, which\n// adds both).\n//\n// Why not reuse lib/@vibex/wasm/wat_encoder? Three reasons, each fatal for\n// this use (see ADR-0072):\n//   1. wat_encoder has NO SIMD (0xFD prefix) support at all — a headline\n//      motivation for inline wasm (roadmap item 7) — so it would need\n//      extension anyway.\n//   2. its body walker emits folded S-expressions in PREFIX order (the\n//      operator before its operands), which mis-orders the canonical\n//      `(i64.add (local.get $a) (local.get $b))` spelling. This assembler\n//      implements real folded-form semantics (operands first).\n//   3. it silently resolves unknown instruction/local names to index 0 with\n//      no error channel; inline wasm needs located compile errors.\n// Pulling the 2.8k-line package into the compiler dependency closure (and\n// its source into the seed-compiled bundle) for a subset we would then have\n// to patch was strictly worse than this ~600-line purpose-built assembler.\n//\n// Supported subset (v0.3 slice, documented in docs/cheatsheet.md):\n//   - folded S-expressions AND flat instruction sequences; structured\n//     control (block/loop/if) is folded-form ONLY\n//   - `(block $l (result i64) ...)`, `(loop $l ...)`,\n//     `(if (result T)? <cond> (then ...) (else ...)?)`, br / br_if with\n//     `$label` or numeric relative depth; return/unreachable/nop/drop/select\n//   - local.get / local.set / local.tee over the fn's own params\n//     (`$paramname` or numeric index); NO `(local ...)` declarations\n//   - i32/i64 const (decimal / hex / `_` separators; vibe Int range only),\n//     full i32/i64 integer arithmetic / compare / shift / rotate /\n//     conversion set, f32/f64 arithmetic + compares (no f32/f64.const)\n//   - memory loads/stores with optional `offset=` / `align=` (align in\n//     bytes, spec-style), memory.size / memory.grow\n//   - SIMD (0xFD): v128.load/store, v128.const, splat / extract_lane /\n//     replace_lane, integer lane arithmetic + compares, bitwise, all_true /\n//     any_true / bitmask, swizzle, shifts\n//   - NOT supported (clear errors): call / call_indirect / br_table /\n//     global.get/set / f32.const / f64.const / (local ...) declarations\n\nfn iw_err(fn_name: String, msg: String, off: Int) -> String {\n  \"inline wasm (fn \\{fn_name}): \\{msg} (WAT offset \\{off})\"\n}\n\nfn iw_fresh_ints() -> Array[Int] {\n  array_empty()\n}\n\nfn iw_fresh_strings() -> Array[String] {\n  array_empty()\n}\n\nfn iw_is_space(c: Int) -> Bool {\n  c == 32 || c == 9 || c == 10 || c == 13\n}\n\n// Token kinds: 1 = '(', 2 = ')', 3 = word. Words end at whitespace, parens\n// or ';'. Comments: `;; ...` to end of line, `(; ... ;)` (non-nested).\nfn iw_tokenize(fn_name: String, src: String) -> (Array[Int], Array[String], Array[Int]) with { Error } {\n  let kinds = iw_fresh_ints()\n  let texts = iw_fresh_strings()\n  let offs = iw_fresh_ints()\n  let n = String::length(src)\n  let mut i = 0\n  while i < n {\n    let c = String::char_code_at(src, i)\n    if iw_is_space(c) {\n      i = i + 1\n    } else if c == 59 {\n      // ';' — only meaningful as ';;' line comment\n      if i + 1 < n && String::char_code_at(src, i + 1) == 59 {\n        while i < n && String::char_code_at(src, i) != 10 {\n          i = i + 1\n        }\n      } else {\n        throw(iw_err(fn_name, \"stray ';' (use ';;' line comments)\", i))\n      }\n    } else if c == 40 {\n      // '(' — possibly a '(;' block comment\n      if i + 1 < n && String::char_code_at(src, i + 1) == 59 {\n        let mut j = i + 2\n        let mut closed = false\n        while j + 1 < n && !closed {\n          if String::char_code_at(src, j) == 59 && String::char_code_at(src, j + 1) == 41 {\n            closed = true\n          } else {\n            j = j + 1\n          }\n        }\n        if !closed {\n          throw(iw_err(fn_name, \"unterminated '(;' block comment\", i))\n        } else {\n          ()\n        }\n        i = j + 2\n      } else {\n        Array::push(kinds, 1)\n        Array::push(texts, \"\")\n        Array::push(offs, i)\n        i = i + 1\n      }\n    } else if c == 41 {\n      Array::push(kinds, 2)\n      Array::push(texts, \"\")\n      Array::push(offs, i)\n      i = i + 1\n    } else {\n      let start = i\n      let mut j = i\n      let mut stop = false\n      while j < n && !stop {\n        let wc = String::char_code_at(src, j)\n        if iw_is_space(wc) || wc == 40 || wc == 41 || wc == 59 {\n          stop = true\n        } else {\n          j = j + 1\n        }\n      }\n      Array::push(kinds, 3)\n      Array::push(texts, String::substring(src, start, j))\n      Array::push(offs, start)\n      i = j\n    }\n  }\n  (kinds, texts, offs)\n}\n\n// Integer immediates: decimal / 0x-hex, optional leading '-', '_' separators.\nfn iw_parse_int(fn_name: String, s: String, off: Int) -> Int with { Error } {\n  let n = String::length(s)\n  let mut i = 0\n  let mut neg = false\n  if i < n && String::char_code_at(s, i) == '-' {\n    neg = true\n    i = i + 1\n  } else {\n    ()\n  }\n  let mut hex = false\n  if i + 1 < n && String::char_code_at(s, i) == '0' {\n    let x = String::char_code_at(s, i + 1)\n    if x == 'x' || x == 'X' {\n      hex = true\n      i = i + 2\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n  let mut v = 0\n  let mut any = false\n  while i < n {\n    let c = String::char_code_at(s, i)\n    if c == '_' {\n      i = i + 1\n    } else if hex {\n      let d = if c >= '0' && c <= '9' {\n        c - '0'\n      } else if c >= 'a' && c <= 'f' {\n        c - 'a' + 10\n      } else if c >= 'A' && c <= 'F' {\n        c - 'A' + 10\n      } else {\n        0 - 1\n      }\n      if d < 0 {\n        throw(iw_err(fn_name, \"invalid integer literal '\\{s}'\", off))\n      } else {\n        ()\n      }\n      v = v * 16 + d\n      any = true\n      i = i + 1\n    } else {\n      if c >= '0' && c <= '9' {\n        v = v * 10 + (c - '0')\n        any = true\n        i = i + 1\n      } else {\n        throw(iw_err(fn_name, \"invalid integer literal '\\{s}'\", off))\n      }\n    }\n  }\n  if !any {\n    throw(iw_err(fn_name, \"invalid integer literal '\\{s}'\", off))\n  } else {\n    ()\n  }\n  if neg {\n    0 - v\n  } else {\n    v\n  }\n}\n\n// Core single-byte opcodes with NO immediates.\nfn iw_core_table() -> Array[(String, Int)] {\n  [\n    (\"unreachable\", 0x00), (\"nop\", 0x01), (\"return\", 0x0F), (\"drop\", 0x1A), (\"select\", 0x1B),\n    (\"i32.eqz\", 0x45), (\"i32.eq\", 0x46), (\"i32.ne\", 0x47), (\"i32.lt_s\", 0x48), (\"i32.lt_u\", 0x49),\n    (\"i32.gt_s\", 0x4A), (\"i32.gt_u\", 0x4B), (\"i32.le_s\", 0x4C), (\"i32.le_u\", 0x4D), (\"i32.ge_s\", 0x4E), (\"i32.ge_u\", 0x4F),\n    (\"i64.eqz\", 0x50), (\"i64.eq\", 0x51), (\"i64.ne\", 0x52), (\"i64.lt_s\", 0x53), (\"i64.lt_u\", 0x54),\n    (\"i64.gt_s\", 0x55), (\"i64.gt_u\", 0x56), (\"i64.le_s\", 0x57), (\"i64.le_u\", 0x58), (\"i64.ge_s\", 0x59), (\"i64.ge_u\", 0x5A),\n    (\"f32.eq\", 0x5B), (\"f32.ne\", 0x5C), (\"f32.lt\", 0x5D), (\"f32.gt\", 0x5E), (\"f32.le\", 0x5F), (\"f32.ge\", 0x60),\n    (\"f64.eq\", 0x61), (\"f64.ne\", 0x62), (\"f64.lt\", 0x63), (\"f64.gt\", 0x64), (\"f64.le\", 0x65), (\"f64.ge\", 0x66),\n    (\"i32.clz\", 0x67), (\"i32.ctz\", 0x68), (\"i32.popcnt\", 0x69),\n    (\"i32.add\", 0x6A), (\"i32.sub\", 0x6B), (\"i32.mul\", 0x6C), (\"i32.div_s\", 0x6D), (\"i32.div_u\", 0x6E),\n    (\"i32.rem_s\", 0x6F), (\"i32.rem_u\", 0x70), (\"i32.and\", 0x71), (\"i32.or\", 0x72), (\"i32.xor\", 0x73),\n    (\"i32.shl\", 0x74), (\"i32.shr_s\", 0x75), (\"i32.shr_u\", 0x76), (\"i32.rotl\", 0x77), (\"i32.rotr\", 0x78),\n    (\"i64.clz\", 0x79), (\"i64.ctz\", 0x7A), (\"i64.popcnt\", 0x7B),\n    (\"i64.add\", 0x7C), (\"i64.sub\", 0x7D), (\"i64.mul\", 0x7E), (\"i64.div_s\", 0x7F), (\"i64.div_u\", 0x80),\n    (\"i64.rem_s\", 0x81), (\"i64.rem_u\", 0x82), (\"i64.and\", 0x83), (\"i64.or\", 0x84), (\"i64.xor\", 0x85),\n    (\"i64.shl\", 0x86), (\"i64.shr_s\", 0x87), (\"i64.shr_u\", 0x88), (\"i64.rotl\", 0x89), (\"i64.rotr\", 0x8A),\n    (\"f32.abs\", 0x8B), (\"f32.neg\", 0x8C), (\"f32.ceil\", 0x8D), (\"f32.floor\", 0x8E), (\"f32.trunc\", 0x8F),\n    (\"f32.nearest\", 0x90), (\"f32.sqrt\", 0x91), (\"f32.add\", 0x92), (\"f32.sub\", 0x93), (\"f32.mul\", 0x94),\n    (\"f32.div\", 0x95), (\"f32.min\", 0x96), (\"f32.max\", 0x97), (\"f32.copysign\", 0x98),\n    (\"f64.abs\", 0x99), (\"f64.neg\", 0x9A), (\"f64.ceil\", 0x9B), (\"f64.floor\", 0x9C), (\"f64.trunc\", 0x9D),\n    (\"f64.nearest\", 0x9E), (\"f64.sqrt\", 0x9F), (\"f64.add\", 0xA0), (\"f64.sub\", 0xA1), (\"f64.mul\", 0xA2),\n    (\"f64.div\", 0xA3), (\"f64.min\", 0xA4), (\"f64.max\", 0xA5), (\"f64.copysign\", 0xA6),\n    (\"i32.wrap_i64\", 0xA7),\n    (\"i32.trunc_f32_s\", 0xA8), (\"i32.trunc_f32_u\", 0xA9), (\"i32.trunc_f64_s\", 0xAA), (\"i32.trunc_f64_u\", 0xAB),\n    (\"i64.extend_i32_s\", 0xAC), (\"i64.extend_i32_u\", 0xAD),\n    (\"i64.trunc_f32_s\", 0xAE), (\"i64.trunc_f32_u\", 0xAF), (\"i64.trunc_f64_s\", 0xB0), (\"i64.trunc_f64_u\", 0xB1),\n    (\"f32.convert_i32_s\", 0xB2), (\"f32.convert_i32_u\", 0xB3), (\"f32.convert_i64_s\", 0xB4), (\"f32.convert_i64_u\", 0xB5),\n    (\"f32.demote_f64\", 0xB6),\n    (\"f64.convert_i32_s\", 0xB7), (\"f64.convert_i32_u\", 0xB8), (\"f64.convert_i64_s\", 0xB9), (\"f64.convert_i64_u\", 0xBA),\n    (\"f64.promote_f32\", 0xBB),\n    (\"i32.reinterpret_f32\", 0xBC), (\"i64.reinterpret_f64\", 0xBD), (\"f32.reinterpret_i32\", 0xBE), (\"f64.reinterpret_i64\", 0xBF),\n    (\"i32.extend8_s\", 0xC0), (\"i32.extend16_s\", 0xC1), (\"i64.extend8_s\", 0xC2), (\"i64.extend16_s\", 0xC3), (\"i64.extend32_s\", 0xC4)\n  ]\n}\n\n// SIMD (0xFD-prefixed) sub-opcodes with NO immediates. Sub-opcode values are\n// the wasm spec's; the handful the codegen already emits (wasm_emit/simd.vibe)\n// agree with these entries.\nfn iw_simd_table() -> Array[(String, Int)] {\n  [\n    (\"i8x16.swizzle\", 14), (\"i8x16.splat\", 15), (\"i16x8.splat\", 16), (\"i32x4.splat\", 17),\n    (\"i64x2.splat\", 18), (\"f32x4.splat\", 19), (\"f64x2.splat\", 20),\n    (\"i8x16.eq\", 35), (\"i8x16.ne\", 36), (\"i8x16.lt_s\", 37), (\"i8x16.lt_u\", 38), (\"i8x16.gt_s\", 39),\n    (\"i8x16.gt_u\", 40), (\"i8x16.le_s\", 41), (\"i8x16.le_u\", 42), (\"i8x16.ge_s\", 43), (\"i8x16.ge_u\", 44),\n    (\"i16x8.eq\", 45), (\"i16x8.ne\", 46), (\"i16x8.lt_s\", 47), (\"i16x8.lt_u\", 48), (\"i16x8.gt_s\", 49),\n    (\"i16x8.gt_u\", 50), (\"i16x8.le_s\", 51), (\"i16x8.le_u\", 52), (\"i16x8.ge_s\", 53), (\"i16x8.ge_u\", 54),\n    (\"i32x4.eq\", 55), (\"i32x4.ne\", 56), (\"i32x4.lt_s\", 57), (\"i32x4.lt_u\", 58), (\"i32x4.gt_s\", 59),\n    (\"i32x4.gt_u\", 60), (\"i32x4.le_s\", 61), (\"i32x4.le_u\", 62), (\"i32x4.ge_s\", 63), (\"i32x4.ge_u\", 64),\n    (\"f32x4.eq\", 65), (\"f32x4.ne\", 66), (\"f32x4.lt\", 67), (\"f32x4.gt\", 68), (\"f32x4.le\", 69), (\"f32x4.ge\", 70),\n    (\"f64x2.eq\", 71), (\"f64x2.ne\", 72), (\"f64x2.lt\", 73), (\"f64x2.gt\", 74), (\"f64x2.le\", 75), (\"f64x2.ge\", 76),\n    (\"v128.not\", 77), (\"v128.and\", 78), (\"v128.andnot\", 79), (\"v128.or\", 80), (\"v128.xor\", 81),\n    (\"v128.bitselect\", 82), (\"v128.any_true\", 83),\n    (\"i8x16.abs\", 96), (\"i8x16.neg\", 97), (\"i8x16.popcnt\", 98), (\"i8x16.all_true\", 99), (\"i8x16.bitmask\", 100),\n    (\"i8x16.shl\", 107), (\"i8x16.shr_s\", 108), (\"i8x16.shr_u\", 109),\n    (\"i8x16.add\", 110), (\"i8x16.add_sat_s\", 111), (\"i8x16.add_sat_u\", 112),\n    (\"i8x16.sub\", 113), (\"i8x16.sub_sat_s\", 114), (\"i8x16.sub_sat_u\", 115),\n    (\"i8x16.min_s\", 118), (\"i8x16.min_u\", 119), (\"i8x16.max_s\", 120), (\"i8x16.max_u\", 121), (\"i8x16.avgr_u\", 123),\n    (\"i16x8.abs\", 128), (\"i16x8.neg\", 129), (\"i16x8.all_true\", 131), (\"i16x8.bitmask\", 132),\n    (\"i16x8.shl\", 139), (\"i16x8.shr_s\", 140), (\"i16x8.shr_u\", 141),\n    (\"i16x8.add\", 142), (\"i16x8.sub\", 145), (\"i16x8.mul\", 149),\n    (\"i16x8.min_s\", 150), (\"i16x8.min_u\", 151), (\"i16x8.max_s\", 152), (\"i16x8.max_u\", 153), (\"i16x8.avgr_u\", 155),\n    (\"i32x4.abs\", 160), (\"i32x4.neg\", 161), (\"i32x4.all_true\", 163), (\"i32x4.bitmask\", 164),\n    (\"i32x4.shl\", 171), (\"i32x4.shr_s\", 172), (\"i32x4.shr_u\", 173),\n    (\"i32x4.add\", 174), (\"i32x4.sub\", 177), (\"i32x4.mul\", 181),\n    (\"i32x4.min_s\", 182), (\"i32x4.min_u\", 183), (\"i32x4.max_s\", 184), (\"i32x4.max_u\", 185),\n    (\"i32x4.dot_i16x8_s\", 186),\n    (\"i64x2.abs\", 192), (\"i64x2.neg\", 193), (\"i64x2.all_true\", 195), (\"i64x2.bitmask\", 196),\n    (\"i64x2.shl\", 203), (\"i64x2.shr_s\", 204), (\"i64x2.shr_u\", 205),\n    (\"i64x2.add\", 206), (\"i64x2.sub\", 209), (\"i64x2.mul\", 213),\n    (\"i64x2.eq\", 214), (\"i64x2.ne\", 215), (\"i64x2.lt_s\", 216), (\"i64x2.gt_s\", 217), (\"i64x2.le_s\", 218), (\"i64x2.ge_s\", 219),\n    (\"f32x4.abs\", 224), (\"f32x4.neg\", 225), (\"f32x4.sqrt\", 227),\n    (\"f32x4.add\", 228), (\"f32x4.sub\", 229), (\"f32x4.mul\", 230), (\"f32x4.div\", 231), (\"f32x4.min\", 232), (\"f32x4.max\", 233),\n    (\"f64x2.abs\", 236), (\"f64x2.neg\", 237), (\"f64x2.sqrt\", 239),\n    (\"f64x2.add\", 240), (\"f64x2.sub\", 241), (\"f64x2.mul\", 242), (\"f64x2.div\", 243), (\"f64x2.min\", 244), (\"f64x2.max\", 245)\n  ]\n}\n\n// SIMD lane-immediate sub-opcodes (0xFD + sub + one lane byte).\n// Lane count of a SIMD lane-immediate op, from its shape prefix\n// (i8x16.* -> 16 lanes, ..., f64x2.* -> 2). Callers only pass names that\n// matched iw_simd_lane_table, so the fallthrough is the two-lane shapes.\nfn iw_lane_count(name: String) -> Int {\n  if String::starts_with(name, \"i8x16.\") {\n    16\n  } else if String::starts_with(name, \"i16x8.\") {\n    8\n  } else if String::starts_with(name, \"i32x4.\") || String::starts_with(name, \"f32x4.\") {\n    4\n  } else {\n    2\n  }\n}\n\nfn iw_simd_lane_table() -> Array[(String, Int)] {\n  [\n    (\"i8x16.extract_lane_s\", 21), (\"i8x16.extract_lane_u\", 22), (\"i8x16.replace_lane\", 23),\n    (\"i16x8.extract_lane_s\", 24), (\"i16x8.extract_lane_u\", 25), (\"i16x8.replace_lane\", 26),\n    (\"i32x4.extract_lane\", 27), (\"i32x4.replace_lane\", 28),\n    (\"i64x2.extract_lane\", 29), (\"i64x2.replace_lane\", 30),\n    (\"f32x4.extract_lane\", 31), (\"f32x4.replace_lane\", 32),\n    (\"f64x2.extract_lane\", 33), (\"f64x2.replace_lane\", 34)\n  ]\n}\n\n// Core memory ops: (name, opcode, default align exponent).\nfn iw_mem_table() -> Array[(String, Int, Int)] {\n  [\n    (\"i32.load\", 0x28, 2), (\"i64.load\", 0x29, 3), (\"f32.load\", 0x2A, 2), (\"f64.load\", 0x2B, 3),\n    (\"i32.load8_s\", 0x2C, 0), (\"i32.load8_u\", 0x2D, 0), (\"i32.load16_s\", 0x2E, 1), (\"i32.load16_u\", 0x2F, 1),\n    (\"i64.load8_s\", 0x30, 0), (\"i64.load8_u\", 0x31, 0), (\"i64.load16_s\", 0x32, 1), (\"i64.load16_u\", 0x33, 1),\n    (\"i64.load32_s\", 0x34, 2), (\"i64.load32_u\", 0x35, 2),\n    (\"i32.store\", 0x36, 2), (\"i64.store\", 0x37, 3), (\"f32.store\", 0x38, 2), (\"f64.store\", 0x39, 3),\n    (\"i32.store8\", 0x3A, 0), (\"i32.store16\", 0x3B, 1),\n    (\"i64.store8\", 0x3C, 0), (\"i64.store16\", 0x3D, 1), (\"i64.store32\", 0x3E, 2)\n  ]\n}\n\nfn iw_lookup(table: Array[(String, Int)], name: String) -> Int {\n  let n = Array::length(table)\n  let mut i = 0\n  let mut found = 0 - 1\n  while i < n {\n    let (tn, tv) = Array::get(table, i)\n    if tn == name {\n      found = tv\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn iw_mem_lookup(name: String) -> (Int, Int) {\n  let table = iw_mem_table()\n  let n = Array::length(table)\n  let mut i = 0\n  let mut op = 0 - 1\n  let mut al = 0\n  while i < n {\n    let (tn, tv, ta) = Array::get(table, i)\n    if tn == name {\n      op = tv\n      al = ta\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  (op, al)\n}\n\n// Local resolution: `$name` against the fn's own params (locals 0..n-1),\n// or a bare numeric index (locals >= param count are the codegen's own —\n// index `param_count` is the closure env slot — so named access is the\n// safe spelling).\nfn iw_local_idx(fn_name: String, params: Array[String], tok: String, off: Int) -> Int with { Error } {\n  if String::length(tok) > 0 && String::char_code_at(tok, 0) == '$' {\n    let want = String::substring(tok, 1, String::length(tok))\n    let n = Array::length(params)\n    let mut i = 0\n    let mut found = 0 - 1\n    while i < n {\n      if Array::get(params, i) == want {\n        found = i\n        i = n\n      } else {\n        i = i + 1\n      }\n    }\n    if found < 0 {\n      throw(iw_err(fn_name, \"unknown local '\\{tok}' — inline wasm locals are the fn's own params\", off))\n    } else {\n      found\n    }\n  } else {\n    iw_parse_int(fn_name, tok, off)\n  }\n}\n\n// Label resolution: `$name` bound by an enclosing block/loop/if (innermost\n// binding wins), or a bare numeric relative depth.\nfn iw_label_rel(fn_name: String, lbl_names: Array[String], lbl_depths: Array[Int], tok: String, depth: Int, off: Int) -> Int with { Error } {\n  if String::length(tok) > 0 && String::char_code_at(tok, 0) == '$' {\n    let n = Array::length(lbl_names)\n    let mut i = n\n    let mut bound = 0 - 1\n    while i > 0 {\n      i = i - 1\n      if Array::get(lbl_names, i) == tok {\n        bound = Array::get(lbl_depths, i)\n        i = 0\n      } else {\n        ()\n      }\n    }\n    if bound < 0 {\n      throw(iw_err(fn_name, \"unknown label '\\{tok}'\", off))\n    } else {\n      depth - bound - 1\n    }\n  } else {\n    iw_parse_int(fn_name, tok, off)\n  }\n}\n\nfn iw_valtype_code(fn_name: String, name: String, off: Int) -> Int with { Error } {\n  match name {\n    \"i32\" => 0x7F,\n    \"i64\" => 0x7E,\n    \"f32\" => 0x7D,\n    \"f64\" => 0x7C,\n    \"v128\" => 0x7B,\n    _ => throw(iw_err(fn_name, \"unknown value type '\\{name}'\", off))\n  }\n}\n\n// Optional `(result T)` clause at `pos`; returns (blocktype byte, next pos).\nfn iw_blocktype(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int) -> (Int, Int) with { Error } {\n  if pos + 1 < end && Array::get(kinds, pos) == 1 && Array::get(kinds, pos + 1) == 3 && Array::get(texts, pos + 1) == \"result\" {\n    if pos + 3 < end && Array::get(kinds, pos + 2) == 3 && Array::get(kinds, pos + 3) == 2 {\n      let vt = iw_valtype_code(fn_name, Array::get(texts, pos + 2), Array::get(offs, pos + 2));\n      (vt, pos + 4)\n    } else {\n      throw(iw_err(fn_name, \"malformed (result T) clause\", Array::get(offs, pos)))\n    }\n  } else {\n    (0x40, pos)\n  }\n}\n\n// Optional `offset=N` / `align=N` immediates (align given in BYTES, encoded\n// as its log2 exponent, spec-style). Returns (align_exp, offset, next pos).\nfn iw_memarg(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, default_align: Int) -> (Int, Int, Int) with { Error } {\n  let mut align = default_align\n  let mut offset = 0\n  let mut p = pos\n  let mut done = false\n  while !done {\n    if p < end && Array::get(kinds, p) == 3 {\n      let t = Array::get(texts, p)\n      if String::starts_with(t, \"offset=\") {\n        offset = iw_parse_int(fn_name, String::substring(t, 7, String::length(t)), Array::get(offs, p))\n        p = p + 1\n      } else if String::starts_with(t, \"align=\") {\n        let a = iw_parse_int(fn_name, String::substring(t, 6, String::length(t)), Array::get(offs, p))\n        // Codex P2 on #933: floor-log2 of an arbitrary int silently\n        // reinterpreted align=3 as align=2, and an over-aligned value\n        // (align=16 on i32.load) survived to fail only in the wasm\n        // validator. Malformed WAT must be rejected HERE with a located\n        // error: a positive power of two, at most the natural alignment.\n        if a <= 0 || (a & (a - 1)) != 0 {\n          throw(iw_err(fn_name, \"align=\\{a} is invalid (must be a positive power of two)\", Array::get(offs, p)))\n        }\n        let mut e = 0\n        let mut av = a\n        while av > 1 {\n          e = e + 1\n          av = av / 2\n        }\n        if e > default_align {\n          throw(iw_err(fn_name, \"align=\\{a} exceeds the instruction's natural alignment (\\{1 << default_align})\", Array::get(offs, p)))\n        }\n        align = e\n        p = p + 1\n      } else {\n        done = true\n      }\n    } else {\n      done = true\n    }\n  }\n  (align, offset, p)\n}\n\n// Require a word token at `pos` (the immediate of the op named `opname`).\nfn iw_want_word(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, opname: String) -> String with { Error } {\n  if pos < end && Array::get(kinds, pos) == 3 {\n    Array::get(texts, pos)\n  } else {\n    let off = if pos < Array::length(offs) {\n      Array::get(offs, pos)\n    } else {\n      0 - 1\n    }\n    throw(iw_err(fn_name, \"'\\{opname}' expects an immediate operand\", off))\n  }\n}\n\n// `v128.const <shape> <lane ints...>` — shape is i8x16/i16x8/i32x4/i64x2;\n// encodes the 16-byte little-endian immediate. Returns next pos.\nfn iw_v128_const(buf: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int) -> Int with { Error } {\n  let shape = iw_want_word(fn_name, kinds, texts, offs, pos, end, \"v128.const\")\n  let (lane_count, lane_bytes) = match shape {\n    \"i8x16\" => (16, 1),\n    \"i16x8\" => (8, 2),\n    \"i32x4\" => (4, 4),\n    \"i64x2\" => (2, 8),\n    _ => throw(iw_err(fn_name, \"v128.const shape must be i8x16/i16x8/i32x4/i64x2, got '\\{shape}'\", Array::get(offs, pos)))\n  }\n  bytebuf_push(buf, 0xFD)\n  leb128_encode_u32(buf, 12)\n  let mut p = pos + 1\n  let mut li = 0\n  while li < lane_count {\n    let t = iw_want_word(fn_name, kinds, texts, offs, p, end, \"v128.const\")\n    let v = iw_parse_int(fn_name, t, Array::get(offs, p))\n    let mut bi = 0\n    while bi < lane_bytes {\n      bytebuf_push(buf, (v >> (bi * 8)) & 255)\n      bi = bi + 1\n    }\n    p = p + 1\n    li = li + 1\n  }\n  p\n}\n\n// Emit ONE plain (non-control) instruction word at `pos` plus its immediates\n// into `buf`. Returns the position after the instruction + immediates.\nfn iw_plain_op(buf: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let name = Array::get(texts, pos)\n  let off = Array::get(offs, pos)\n  if name == \"block\" || name == \"loop\" || name == \"if\" || name == \"else\" || name == \"end\" || name == \"then\" {\n    throw(iw_err(fn_name, \"structured control must use the folded form: (block ...) / (loop ...) / (if <cond> (then ...) (else ...))\", off))\n  } else if name == \"local.get\" || name == \"local.set\" || name == \"local.tee\" {\n    let opc = if name == \"local.get\" {\n      0x20\n    } else if name == \"local.set\" {\n      0x21\n    } else {\n      0x22\n    }\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let idx = iw_local_idx(fn_name, params, t, Array::get(offs, pos + 1))\n    bytebuf_push(buf, opc)\n    leb128_encode_u32(buf, idx)\n    pos + 2\n  } else if name == \"br\" || name == \"br_if\" {\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let rel = iw_label_rel(fn_name, lbl_names, lbl_depths, t, depth, Array::get(offs, pos + 1))\n    if rel < 0 {\n      throw(iw_err(fn_name, \"label '\\{t}' is not visible from this branch\", Array::get(offs, pos + 1)))\n    } else {\n      ()\n    }\n    bytebuf_push(buf, if name == \"br\" {\n      0x0C\n    } else {\n      0x0D\n    })\n    leb128_encode_u32(buf, rel)\n    pos + 2\n  } else if name == \"i32.const\" {\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let v = iw_parse_int(fn_name, t, Array::get(offs, pos + 1))\n    bytebuf_push(buf, 0x41)\n    leb128_encode_s32(buf, v)\n    pos + 2\n  } else if name == \"i64.const\" {\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let v = iw_parse_int(fn_name, t, Array::get(offs, pos + 1))\n    bytebuf_push(buf, 0x42)\n    leb128_encode_s64(buf, v)\n    pos + 2\n  } else if name == \"f32.const\" || name == \"f64.const\" {\n    throw(iw_err(fn_name, \"'\\{name}' is not supported in inline wasm (v0.3 slice); build the bit pattern with i64.const + f64.reinterpret_i64\", off))\n  } else if name == \"memory.size\" || name == \"memory.grow\" {\n    bytebuf_push(buf, if name == \"memory.size\" {\n      0x3F\n    } else {\n      0x40\n    })\n    bytebuf_push(buf, 0x00)\n    pos + 1\n  } else if name == \"v128.const\" {\n    iw_v128_const(buf, fn_name, kinds, texts, offs, pos + 1, end)\n  } else if name == \"v128.load\" || name == \"v128.store\" {\n    let (align, offset, next) = iw_memarg(fn_name, kinds, texts, offs, pos + 1, end, 4)\n    bytebuf_push(buf, 0xFD)\n    leb128_encode_u32(buf, if name == \"v128.load\" {\n      0\n    } else {\n      11\n    })\n    leb128_encode_u32(buf, align)\n    leb128_encode_u32(buf, offset)\n    next\n  } else if name == \"call\" || name == \"call_indirect\" || name == \"return_call\" {\n    throw(iw_err(fn_name, \"'\\{name}' is not supported in inline wasm (v0.3 slice: bodies cannot reference other functions)\", off))\n  } else if name == \"global.get\" || name == \"global.set\" {\n    throw(iw_err(fn_name, \"'\\{name}' is not supported in inline wasm (v0.3 slice: runtime globals are not addressable)\", off))\n  } else if name == \"br_table\" {\n    throw(iw_err(fn_name, \"'br_table' is not supported in inline wasm (v0.3 slice)\", off))\n  } else if name == \"local\" {\n    throw(iw_err(fn_name, \"'(local ...)' declarations are not supported in inline wasm (v0.3 slice); use the fn's params as scratch locals\", off))\n  } else {\n    let core_opc = iw_lookup(iw_core_table(), name)\n    if core_opc >= 0 {\n      bytebuf_push(buf, core_opc)\n      pos + 1\n    } else {\n      let lane_sub = iw_lookup(iw_simd_lane_table(), name)\n      if lane_sub >= 0 {\n        let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n        let lane = iw_parse_int(fn_name, t, Array::get(offs, pos + 1))\n        // Codex P2 on #933: `lane & 255` truncated out-of-range lane\n        // indices (i8x16.extract_lane_s 16, replace_lane -1) into a wasm\n        // file that only the validator rejects. Bound-check against the\n        // shape's lane count for the promised located error.\n        let lane_cnt = iw_lane_count(name)\n        if lane < 0 || lane >= lane_cnt {\n          throw(iw_err(fn_name, \"lane index \\{lane} is out of range for '\\{name}' (0..\\{lane_cnt - 1})\", Array::get(offs, pos + 1)))\n        }\n        bytebuf_push(buf, 0xFD)\n        leb128_encode_u32(buf, lane_sub)\n        bytebuf_push(buf, lane & 255)\n        pos + 2\n      } else {\n        let (mem_opc, mem_align) = iw_mem_lookup(name)\n        if mem_opc >= 0 {\n          let (align, offset, next) = iw_memarg(fn_name, kinds, texts, offs, pos + 1, end, mem_align)\n          bytebuf_push(buf, mem_opc)\n          leb128_encode_u32(buf, align)\n          leb128_encode_u32(buf, offset)\n          next\n        } else {\n          let simd_sub = iw_lookup(iw_simd_table(), name)\n          if simd_sub >= 0 {\n            bytebuf_push(buf, 0xFD)\n            leb128_encode_u32(buf, simd_sub)\n            pos + 1\n          } else {\n            throw(iw_err(fn_name, \"unknown or unsupported instruction '\\{name}'\", off))\n          }\n        }\n      }\n    }\n  }\n}\n\n// One sequence item at `pos`: either a folded `(...)` expression or a plain\n// instruction word. Returns the position after the item.\nfn iw_item(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let k = Array::get(kinds, pos)\n  if k == 3 {\n    iw_plain_op(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\n  } else if k == 1 {\n    if pos + 1 >= end || Array::get(kinds, pos + 1) != 3 {\n      throw(iw_err(fn_name, \"expected an instruction name after '('\", Array::get(offs, pos)))\n    } else {\n      ()\n    }\n    let head = Array::get(texts, pos + 1)\n    if head == \"block\" || head == \"loop\" {\n      iw_folded_block(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\n    } else if head == \"if\" {\n      iw_folded_if(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\n    } else if head == \"then\" || head == \"else\" || head == \"result\" {\n      throw(iw_err(fn_name, \"misplaced '(\\{head} ...)' clause\", Array::get(offs, pos)))\n    } else {\n      iw_folded_op(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\n    }\n  } else {\n    throw(iw_err(fn_name, \"unexpected ')'\", Array::get(offs, pos)))\n  }\n}\n\n// A sequence of items up to (not consuming) a closing ')' or the end.\nfn iw_seq(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let mut p = pos\n  let mut done = false\n  while !done {\n    if p >= end {\n      done = true\n    } else if Array::get(kinds, p) == 2 {\n      done = true\n    } else {\n      p = iw_item(out, fn_name, kinds, texts, offs, p, end, params, lbl_names, lbl_depths, depth)\n    }\n  }\n  p\n}\n\n// Folded `(op <immediates> <operand exprs...>)`: real folded-form semantics —\n// the operand expressions are emitted FIRST, then the op itself.\nfn iw_folded_op(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let opb = bytebuf_new()\n  let after_imm = iw_plain_op(opb, fn_name, kinds, texts, offs, pos + 1, end, params, lbl_names, lbl_depths, depth)\n  let mut p = after_imm\n  let mut done = false\n  while !done {\n    if p >= end {\n      throw(iw_err(fn_name, \"missing ')' closing folded '\\{Array::get(texts, pos + 1)}'\", Array::get(offs, pos)))\n    } else if Array::get(kinds, p) == 2 {\n      done = true\n    } else if Array::get(kinds, p) == 1 {\n      p = iw_item(out, fn_name, kinds, texts, offs, p, end, params, lbl_names, lbl_depths, depth)\n    } else {\n      throw(iw_err(fn_name, \"unexpected '\\{Array::get(texts, p)}' inside folded '\\{Array::get(texts, pos + 1)}' — operands must be parenthesized\", Array::get(offs, p)))\n    }\n  }\n  bytebuf_push_buf(out, opb)\n  p + 1\n}\n\n// Folded `(block $l? (result T)? ...)` / `(loop $l? (result T)? ...)`.\nfn iw_folded_block(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let head = Array::get(texts, pos + 1)\n  bytebuf_push(out, if head == \"loop\" {\n    0x03\n  } else {\n    0x02\n  })\n  let lbl_mark = Array::length(lbl_names)\n  let mut q = pos + 2\n  if q < end && Array::get(kinds, q) == 3 && String::length(Array::get(texts, q)) > 0 && String::char_code_at(Array::get(texts, q), 0) == '$' {\n    Array::push(lbl_names, Array::get(texts, q))\n    Array::push(lbl_depths, depth)\n    q = q + 1\n  } else {\n    ()\n  }\n  let (bt, after_bt) = iw_blocktype(fn_name, kinds, texts, offs, q, end)\n  bytebuf_push(out, bt)\n  let bq = iw_seq(out, fn_name, kinds, texts, offs, after_bt, end, params, lbl_names, lbl_depths, depth + 1)\n  if bq >= end || Array::get(kinds, bq) != 2 {\n    throw(iw_err(fn_name, \"missing ')' closing '\\{head}'\", Array::get(offs, pos)))\n  } else {\n    ()\n  }\n  bytebuf_push(out, 0x0B)\n  Array::truncate(lbl_names, lbl_mark)\n  Array::truncate(lbl_depths, lbl_mark)\n  bq + 1\n}\n\n// Folded `(if $l? (result T)? <cond exprs...> (then ...) (else ...)?)`.\n// The condition is emitted first, then 0x04 + blocktype, then the branches.\nfn iw_folded_if(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let lbl_mark = Array::length(lbl_names)\n  let mut q = pos + 2\n  if q < end && Array::get(kinds, q) == 3 && String::length(Array::get(texts, q)) > 0 && String::char_code_at(Array::get(texts, q), 0) == '$' {\n    Array::push(lbl_names, Array::get(texts, q))\n    Array::push(lbl_depths, depth)\n    q = q + 1\n  } else {\n    ()\n  }\n  let (bt, after_bt) = iw_blocktype(fn_name, kinds, texts, offs, q, end)\n  // condition: folded expressions until the '(then ...)' clause\n  let mut p = after_bt\n  let mut cond_done = false\n  while !cond_done {\n    if p >= end {\n      throw(iw_err(fn_name, \"missing '(then ...)' clause in folded 'if'\", Array::get(offs, pos)))\n    } else if Array::get(kinds, p) == 1 && p + 1 < end && Array::get(kinds, p + 1) == 3 && Array::get(texts, p + 1) == \"then\" {\n      cond_done = true\n    } else if Array::get(kinds, p) == 1 {\n      p = iw_item(out, fn_name, kinds, texts, offs, p, end, params, lbl_names, lbl_depths, depth)\n    } else {\n      throw(iw_err(fn_name, \"unexpected token in folded 'if' condition (condition operands must be parenthesized)\", Array::get(offs, p)))\n    }\n  }\n  bytebuf_push(out, 0x04)\n  bytebuf_push(out, bt)\n  // then branch: p is at '(' of (then ...)\n  let tq = iw_seq(out, fn_name, kinds, texts, offs, p + 2, end, params, lbl_names, lbl_depths, depth + 1)\n  if tq >= end || Array::get(kinds, tq) != 2 {\n    throw(iw_err(fn_name, \"missing ')' closing '(then ...)'\", Array::get(offs, p)))\n  } else {\n    ()\n  }\n  let mut r = tq + 1\n  if r + 1 < end && Array::get(kinds, r) == 1 && Array::get(kinds, r + 1) == 3 && Array::get(texts, r + 1) == \"else\" {\n    bytebuf_push(out, 0x05)\n    let eq = iw_seq(out, fn_name, kinds, texts, offs, r + 2, end, params, lbl_names, lbl_depths, depth + 1)\n    if eq >= end || Array::get(kinds, eq) != 2 {\n      throw(iw_err(fn_name, \"missing ')' closing '(else ...)'\", Array::get(offs, r)))\n    } else {\n      ()\n    }\n    r = eq + 1\n  } else {\n    ()\n  }\n  if r >= end || Array::get(kinds, r) != 2 {\n    throw(iw_err(fn_name, \"missing ')' closing folded 'if'\", Array::get(offs, pos)))\n  } else {\n    ()\n  }\n  bytebuf_push(out, 0x0B)\n  Array::truncate(lbl_names, lbl_mark)\n  Array::truncate(lbl_depths, lbl_mark)\n  r + 1\n}\n\n// Entry: compile one inline-wasm fn body's WAT text to raw instruction bytes.\n// `param_names` are the fn's declared params in order (wasm locals 0..n-1 on\n// the linear backend; every param and the result are RAW 62-bit tagged i64\n// values — ADR-0055/ADR-0072 — the WAT author untags/retags explicitly).\nexport fn compile_inline_wat(fn_name: String, wat: String, param_names: Array[String]) -> Bytes with { Error } {\n  let (kinds, texts, offs) = iw_tokenize(fn_name, wat)\n  let out = bytebuf_new()\n  let lbl_names = iw_fresh_strings()\n  let lbl_depths = iw_fresh_ints()\n  let end = Array::length(kinds)\n  if end == 0 {\n    throw(iw_err(fn_name, \"empty inline wasm body\", 0))\n  } else {\n    ()\n  }\n  let final_pos = iw_seq(out, fn_name, kinds, texts, offs, 0, end, param_names, lbl_names, lbl_depths, 0)\n  if final_pos != end {\n    throw(iw_err(fn_name, \"unbalanced ')'\", Array::get(offs, final_pos)))\n  } else {\n    ()\n  }\n  out\n}\n\n//# Misc\n\nexport {\n  compile_inline_wat\n}\n")
}

let cli_adapter_source_103 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasi/linked_helpers.vibe",
"//# Imports\n\nimport @vibe/compiler/codegen/common_base {\n  canonical_builtin_name\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  Expr, Stmt,\n  sorted_names_of\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_free_vars_indexed\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str\n}\n\n//# Functions\n\nfn expr_uses_builtin(expr: Expr, fn_names: Array[String], target: String) -> Bool {\n  let free_vars = collect_free_vars(expr, array_empty(), fn_names)\n  let normalized_target = canonical_builtin_name(target)\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(free_vars) && !found {\n    found = canonical_builtin_name(Array::get(free_vars, i)) == normalized_target\n    i = i + 1\n  }\n  found\n}\n\nexport fn stmts_use_builtin(stmts: Array[Stmt], fn_names: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) && !found {\n    found = match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      SLetMut(_, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      STest(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SBench(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SExpr(expr) => expr_uses_builtin(expr, fn_names, target),\n      SModule(_, _, inner) => stmts_use_builtin(inner, fn_names, target),\n      _ => false\n    }\n    i = i + 1\n  }\n  found\n}\n\n// #799 perf: ONE walk over the whole program collecting every free name's\n// canonical builtin form into a set. linked_compile's ~40 need_<builtin>\n// flags used to each call stmts_use_builtin -- a full-AST walk per flag,\n// with a linear fn_names scan per ident inside -- which was a top entry in\n// compiler-closure compile profiles. Same semantics: a name counts as \"used\"\n// only where it is FREE (not a user fn, not locally bound), and the flag\n// reads compare canonical names exactly like expr_uses_builtin did.\nfn push_free_canonical(expr: Expr, fn_name_index: Array[String], sink: Array[(String, Bool)]) -> Unit {\n  let fvs = collect_free_vars_indexed(expr, array_empty(), fn_name_index)\n  let mut j = 0\n  while j < Array::length(fvs) {\n    Array::push(sink, (canonical_builtin_name(Array::get(fvs, j)), true))\n    j = j + 1\n  }\n}\n\nexport fn collect_used_builtin_names_into(stmts: Array[Stmt], fn_names: Array[String], fn_name_index: Array[String], sink: Array[(String, Bool)]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => push_free_canonical(expr, fn_name_index, sink),\n      SLetMut(_, _, expr) => push_free_canonical(expr, fn_name_index, sink),\n      STest(_, expr) => push_free_canonical(expr, fn_name_index, sink),\n      SBench(_, expr) => push_free_canonical(expr, fn_name_index, sink),\n      SExpr(expr) => push_free_canonical(expr, fn_name_index, sink),\n      SModule(_, _, inner) => collect_used_builtin_names_into(inner, fn_names, fn_name_index, sink),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\n\nexport fn collect_used_builtin_names(stmts: Array[Stmt], fn_names: Array[String]) -> Map[String, Bool] {\n  // Sorted membership index (see core/sorted_index.vibe) -- the MapBuilder\n  // version was O(N^2) to build and O(N) per lookup.\n  let fn_name_index = sorted_names_of(fn_names)\n  let sink = array_empty()\n  collect_used_builtin_names_into(stmts, fn_names, fn_name_index, sink)\n  let set_b = MapBuilder::new()\n  let mut k = 0\n  while k < Array::length(sink) {\n    let (nm, _) = Array::get(sink, k)\n    MapBuilder::set(set_b, nm, true)\n    k = k + 1\n  }\n  MapBuilder::freeze(set_b)\n}\n")
}

let cli_adapter_source_104 = () -> (String, String) {
