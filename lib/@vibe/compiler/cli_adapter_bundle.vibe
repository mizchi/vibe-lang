"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/perceus {\n  build_perceus_plan_with_params, pa_is_alias_dup, pa_is_drop, pa_is_dup, param_is_heap_in_body\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars,\n  collect_free_vars_indexed,\n  collect_free_vars_indexed_self,\n  collect_strings_stmts,\n  emit_closure_call_tail,\n  emit_closure_resolve,\n  emit_i64_extend_i32_u,\n  is_mut_captured_in,\n  md_consume_count,\n  scope_tail_proj_root\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  emit_binop_op,\n  emit_heap_grow_after_heap_set,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_rc_dup_guarded,\n  emit_rc_word_inc_saturating,\n  emit_str_ref,\n  expr_tag,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  is_efn,\n  is_eident,\n  is_etuple,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  linemap_disabled,\n  lookup_ctor,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\n//# Functions\n\nexport fn compile_lambda(buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let param_names_arr = array_empty()\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, _) = Array::get(params, pi)\n    Array::push(param_names_arr, pname)\n    pi = pi + 1\n  }\n  // #875 fix 2: consume the \"currently-compiling let-rec closure's own name\"\n  // hint (set by compile_expr_tail.vibe's ELetRec handler immediately before\n  // it calls compile_expr on this exact EFn value -- see\n  // CompileCtx.pending_letrec_self_name's doc comment). Read + clear it right\n  // away (before computing captures, and well before any recursive call that\n  // could set it again for a nested let-rec) so it never leaks past this one\n  // lambda. Any EFn that is NOT a let-rec's own value (anonymous lambda,\n  // non-rec `let`) finds this empty and behaves exactly as before.\n  let self_name = if Array::length(ctx.pending_letrec_self_name) > 0 {\n    let sn = Array::get(ctx.pending_letrec_self_name, 0)\n    Array::truncate(ctx.pending_letrec_self_name, 0)\n    sn\n  } else {\n    \"\"\n  }\n  // #1114: `local_names` is the ENCLOSING scope's locals. A bare\n  // inlined-builtin call callee (`not`/`add`/`assert`/...) that one of\n  // them shadows must be captured from here, not inline-lowered to the\n  // builtin -- see collect_free_vars_expr's doc comment.\n  let captures = collect_free_vars_indexed_self(fn_body, param_names_arr, ctx.capture_name_index, self_name, local_names)\n  let num_captures = Array::length(captures)\n  let user_params = Array::length(params)\n  let lam_buf = bytebuf_new()\n  let lam_locals = array_empty()\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname_raw, _) = Array::get(params, lpi)\n    let lpnlen = String::length(lpname_raw)\n    let lpname = if lpnlen > 0 {\n      let lpc = String::char_code_at(lpname_raw, lpnlen - 1)\n      if lpc == '~' {\n        lpname_raw[0: lpnlen - 1]\n      } else if lpc == '?' {\n        lpname_raw[0: lpnlen - 1]\n      } else {\n        lpname_raw\n      }\n    } else lpname_raw\n    Array::push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  Array::push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n  let lam_ref_cells = array_empty()\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = Array::get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    // #699: a captured RC ref cell is stored odd-tagged in the env (so the\n    // closure's class-7 drop classifies and frees it). The inner body uses the\n    // cell as an even vptr (load/store at +0), so untag on load back.\n    if ctx.enable_rc && array_contains_str(ctx.ref_cell_names, cap_name) {\n      emit_i64_const(lam_buf, -2)\n      emit_i64_and(lam_buf)\n    }\n    emit_local_set(lam_buf, cap_local)\n    Array::push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      Array::push(lam_ref_cells, cap_name)\n    } else {\n      ()\n    }\n    // #705: a captured non-refcell heap var is a BORROWED view of the defining\n    // scope's binding — the env store (below) does NOT bump its rc, and the\n    // body's perceus plan never tracks a free var, so any owning consume inside\n    // the closure decrements a refcount the closure does not own. Left unbalanced\n    // that frees the defining scope's value early (double free / heap cycle when\n    // a recursive closure consumes a captured list each iteration — e.g. a set\n    // op's `contains(b, head)` over a borrowed `b`). Dup the capture once per\n    // owning consume here in the prologue: it runs per invocation, so a recursive\n    // closure consuming the capture each call stays balanced (defining scope\n    // still drops it exactly once). Ref-cell captures (#699) own their cell via\n    // the env store and are reclaimed by the closure's class-7 drop; skip them.\n    if ctx.enable_rc && !array_contains_str(ctx.ref_cell_names, cap_name) {\n      let cap_consumes = md_consume_count(fn_body, cap_name)\n      let mut cdup = 0\n      while cdup < cap_consumes {\n        emit_rc_dup_guarded(lam_buf, cap_local, ctx.rc_shadow)\n        cdup = cdup + 1\n      }\n    } else {\n      ()\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n  let norm_params = Array::slice(params, 0, 0)\n  let mut npi = 0\n  while npi < Array::length(params) {\n    let (rawn, pty) = Array::get(params, npi)\n    let rnlen = String::length(rawn)\n    let sn = if rnlen > 0 {\n      let lc = String::char_code_at(rawn, rnlen - 1)\n      if lc == '~' || lc == '?' {\n        rawn[0: rnlen - 1]\n      } else {\n        rawn\n      }\n    } else {\n      rawn\n    }\n    Array::push(norm_params, (sn, pty))\n    npi = npi + 1\n  }\n  let lam_drops = array_empty()\n  let lam_alias_dups = array_empty()\n  let lam_dups = array_empty()\n  let lam_heap_params = array_empty()\n  if ctx.enable_rc {\n    let lam_plan = build_perceus_plan_with_params(norm_params, fn_body, ctx.borrow_ret_names, ctx.borrow_arg0_user, ctx.borrow_view_ret)\n    let mut ldi = 0\n    while ldi < Array::length(lam_plan) {\n      let lpa = Array::get(lam_plan, ldi)\n      if pa_is_drop(lpa) {\n        Array::push(lam_drops, lpa.name)\n      } else if pa_is_alias_dup(lpa) {\n        Array::push(lam_alias_dups, lpa.name)\n      } else if pa_is_dup(lpa) {\n        Array::push(lam_dups, lpa.name)\n      } else {\n        ()\n      }\n      ldi = ldi + 1\n    }\n    let mut hpi = 0\n    while hpi < Array::length(norm_params) {\n      let (hpn, hpt) = Array::get(norm_params, hpi)\n      if param_is_heap_in_body(hpn, hpt, fn_body) {\n        Array::push(lam_heap_params, hpn)\n      } else {\n        ()\n      }\n      hpi = hpi + 1\n    }\n  }\n  // #744: annotated Float/Double LAMBDA params seed float_local_slots exactly\n  // like top-level fn params do (linked_compile's psi loop) — without this a\n  // local `(v: Double, by: Double) -> Double { v * by }` compiled `v * by` as\n  // an INTEGER multiply of the f64 bits (and under RC compared/box-leaked\n  // pointers), so closure float math was silently garbage.\n  let lam_float_slots = array_empty()\n  // #1015: annotated Bool LAMBDA params seed int_local_slots (kind 3 =\n  // boolish, #769 encoding slot*4+kind) exactly like top-level fn params do\n  // (linked_compile's psi loop) — without this a Bool-typed lambda param\n  // passed to `to_string(b)` (or interpolated as `\"\\{b}\"`) is an untracked\n  // bare EIdent and falls through to the generic runtime bit-pattern\n  // heuristic, mis-rendering `true` as `\"1\"`.\n  let lam_bool_slots = array_empty()\n  let mut lfs_i = 0\n  while lfs_i < user_params {\n    let (_, lfs_ann) = Array::get(norm_params, lfs_i)\n    match lfs_ann {\n      Some(lfs_ty) => match lfs_ty {\n        TyName(lfs_tn) => if lfs_tn == \"Float\" || lfs_tn == \"Double\" {\n          Array::push(lam_float_slots, lfs_i * 2 + 1)\n        } else if lfs_tn == \"Bool\" {\n          Array::push(lam_bool_slots, lfs_i * 4 + 3)\n        } else {\n          ()\n        },\n        _ => ()\n      },\n      None => ()\n    }\n    lfs_i = lfs_i + 1\n  }\n  let lam_ctx = CompileCtx::{\n    func_table: ctx.func_table, str_table: ctx.str_table,\n    lambda_table: ctx.lambda_table,\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\n    ref_cell_names: lam_ref_cells, ctor_table: ctx.ctor_table,\n    ctor_float_fields: ctx.ctor_float_fields,\n    thunk_names: ctx.thunk_names,\n    const_int_names: ctx.const_int_names,\n    const_int_values: ctx.const_int_values,\n    enable_rc: ctx.enable_rc,\n    rc_shadow: ctx.rc_shadow,\n    rc_drop_names: lam_drops,\n    rc_alias_dup_names: lam_alias_dups,\n    heap_binding_names: lam_heap_params,\n    rc_drop_func_idx: ctx.rc_drop_func_idx,\n    rc_alloc_func_idx: ctx.rc_alloc_func_idx,\n    heap_grow_check_func_idx: ctx.heap_grow_check_func_idx,\n    map_hash_func_idx: ctx.map_hash_func_idx,\n    map_cap_func_idx: ctx.map_cap_func_idx,\n    map_build_index_func_idx: ctx.map_build_index_func_idx,\n    map_probe_func_idx: ctx.map_probe_func_idx,\n    rc_dup_names: lam_dups,\n    capture_name_index: ctx.capture_name_index,\n    float_local_slots: lam_float_slots,\n    int_local_slots: lam_bool_slots,\n    agg_local_slots: array_empty(),\n    agg_local_exprs: array_empty(),\n    agg_ret_names: ctx.agg_ret_names,\n    agg_ret_infos: ctx.agg_ret_infos,\n    heap_ret_names: ctx.heap_ret_names,\n    effect_names: ctx.effect_names,\n    effect_op_keys: ctx.effect_op_keys,\n    effect_op_arities: ctx.effect_op_arities,\n    cov: ctx.cov,\n    dbg_line_idx: ctx.dbg_line_idx,\n    dbg_line_nl: ctx.dbg_line_nl,\n    dbg_line_file_id: ctx.dbg_line_file_id,\n    loop_borrowed_names: array_empty(),\n    loop_consumed_names: array_empty(),\n    reuse_scrutinee_names: array_empty(),\n    reuse_flag_locals: array_empty(),\n    borrow_ret_names: ctx.borrow_ret_names,\n    borrow_arg0_user: ctx.borrow_arg0_user,\n    borrow_view_ret: ctx.borrow_view_ret,\n    scalar_ret_names: ctx.scalar_ret_names,\n    // #875 fix 2: a nested `let rec` inside THIS lambda's own body must not\n    // see a stale hint left over from compiling this lambda's own value (that\n    // hint was already read+cleared on `ctx`, above, before we got here --\n    // this is an independent, freshly-derived ctx for the body, so start it\n    // empty too rather than aliasing ctx's now-cleared array).\n    pending_letrec_self_name: array_empty(),\n    table_slots_used: ctx.table_slots_used,\n    // Shared BY REFERENCE, like table_slots_used above: a nested lambda\n    // advances the same counter its enclosing function does.\n    lambda_plan_next: ctx.lambda_plan_next,\n    // #644: lambda bodies compile into their OWN wasm function + body_buf,\n    // not the enclosing top-level function's -- a linemap entry recorded\n    // here would carry the WRONG owning function index and an offset into\n    // the wrong buffer. Force disabled rather than propagating ctx.linemap\n    // (documented gap: lambda-body statements are absent from the static\n    // linemap; their live `--break`/dbg_line hooks are unaffected).\n    linemap: linemap_disabled()\n  }\n  if ctx.enable_rc {\n    let mut dpi = 0\n    while dpi < Array::length(norm_params) {\n      let (dpn, dpt) = Array::get(norm_params, dpi)\n      if param_is_heap_in_body(dpn, dpt, fn_body) {\n        let mut dcount = 0\n        let mut dqi = 0\n        while dqi < Array::length(lam_dups) {\n          if Array::get(lam_dups, dqi) == dpn {\n            dcount = dcount + 1\n          } else {\n            ()\n          }\n          dqi = dqi + 1\n        }\n        let mut de = 0\n        while de < dcount {\n          emit_rc_dup_guarded(lam_buf, dpi, ctx.rc_shadow)\n          de = de + 1\n        }\n      } else {\n        ()\n      }\n      dpi = dpi + 1\n    }\n  } else {\n    ()\n  }\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, -1)\n  let mut tail_lam_nl = final_lam_nl\n  if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {\n    let tail_root = scope_tail_proj_root(fn_body)\n    let mut need_dup = false\n    let mut ti = 0\n    while ti < Array::length(norm_params) {\n      let (tpn, tpt) = Array::get(norm_params, ti)\n      if param_is_heap_in_body(tpn, tpt, fn_body) && array_contains_str(lam_drops, tpn) && tpn == tail_root {\n        need_dup = true\n      } else {\n        ()\n      }\n      ti = ti + 1\n    }\n    let rtemp = final_lam_nl\n    if need_dup {\n      emit_local_set(lam_buf, rtemp)\n      emit_rc_dup_guarded(lam_buf, rtemp, ctx.rc_shadow)\n      tail_lam_nl = final_lam_nl + 1\n    } else {\n      ()\n    }\n    let mut tj = 0\n    while tj < Array::length(norm_params) {\n      let (dpn2, dpt2) = Array::get(norm_params, tj)\n      if param_is_heap_in_body(dpn2, dpt2, fn_body) && array_contains_str(lam_drops, dpn2) {\n        emit_local_get(lam_buf, tj)\n        emit_call(lam_buf, ctx.rc_drop_func_idx)\n      } else {\n        ()\n      }\n      tj = tj + 1\n    }\n    if need_dup {\n      emit_local_get(lam_buf, rtemp)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n  // #1259 step 7. The function index this lambda gets -- and, a few lines\n  // down, the `table_slot` immediate baked into the emitted body.\n  //\n  // It USED to be `Array::length(ctx.lambda_table.bodies)`: the live length of\n  // a shared, growing table. That made a function's output bytes depend on how\n  // many lambdas every function compiled before it produced, which is the one\n  // thing that stopped a worker from ever compiling a body on its own, and\n  // exactly what docs/compiler-parallelism.md forbids (\"may not append to a\n  // shared LambdaTable, allocate global ids\").\n  //\n  // It now comes from the PLAN: count_lambda_sites_expr counts the EFn nodes\n  // in each user function's body and linked_compile prefix-sums those into a\n  // per-function base, all without compiling anything. The live length is\n  // still computed and still compared, as an invariant rather than as the\n  // source of truth -- the two agreeing everywhere is what made this swap a\n  // no-op on the emitted bytes, and a future divergence would mean the count\n  // and the walk disagree about which EFn nodes get compiled. Keying a body's\n  // constants to a table slot nothing installs is precisely the silent\n  // corruption the plan exists to prevent, so it stays fatal.\n  //\n  // No plan (an empty cell) means this ctx was built outside the planned body\n  // loop; the live length is then the only answer available and still the\n  // right one, since nothing else is allocating into the table concurrently.\n  let live_idx = Array::length(ctx.lambda_table.bodies)\n  let lambda_idx = if Array::length(ctx.lambda_plan_next) > 0 {\n    let planned = Array::get(ctx.lambda_plan_next, 0)\n    if planned != live_idx {\n      throw(String::concat(\"lambda plan mismatch: planned index \", String::concat(__to_string(planned), String::concat(\", walk allocated \", __to_string(live_idx)))))\n    } else {\n      ()\n    }\n    Array::set(ctx.lambda_plan_next, 0, planned + 1)\n    planned\n  } else {\n    live_idx\n  }\n  Array::push(ctx.lambda_table.bodies, lam_buf)\n  Array::push(ctx.lambda_table.param_counts, user_params + 1)\n  Array::push(ctx.lambda_table.captures, captures)\n  let mut extra_lam = 0\n  let min_lam_nl = user_params + 1\n  if tail_lam_nl > min_lam_nl {\n    extra_lam = tail_lam_nl - min_lam_nl\n  }\n  Array::push(ctx.lambda_table.meta_i32, 0)\n  Array::push(ctx.lambda_table.meta_i64, extra_lam)\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  Array::push(ctx.table_slots_used, table_slot)\n  if num_captures == 0 {\n    emit_i64_const(buf, (table_slot<<2)|2)\n    next_local\n  } else {\n    let ptr_local = next_local\n    let nl2 = next_local + 1\n    Array::push(local_names, \"__closure_ptr\")\n    let cap_off = if ctx.enable_rc {\n      16\n    } else {\n      8\n    }\n    if ctx.enable_rc {\n      let total = 16 + num_captures * 8\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 7)\n      emit_i32_store8(buf, 0, 7)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, table_slot)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, num_captures)\n      emit_i32_store(buf, 2, 12)\n    } else {\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 8 + num_captures * 8)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, table_slot)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, num_captures)\n      emit_i32_store(buf, 2, 4)\n    }\n    let mut csi = 0\n    while csi < num_captures {\n      let cap_name = Array::get(captures, csi)\n      let mut __cap_resolve = -1\n      let mut __cri = Array::length(local_names) - 1\n      while __cri >= 0 {\n        if Array::get(local_names, __cri) == cap_name {\n          __cap_resolve = __cri\n          __cri = -1\n        } else {\n          __cri = __cri - 1\n        }\n      }\n      if __cap_resolve >= 0 {\n        if ctx.enable_rc && array_contains_str(ctx.ref_cell_names, cap_name) {\n          // #699: own the captured RC ref cell. Store it odd-tagged so the\n          // closure's class-7 drop (gen_rc_drop_body) recognises it as an owned\n          // heap value, and bump its refcount (unguarded — a ref cell is always\n          // heap) so the shared cell survives until BOTH the defining scope and\n          // this closure have dropped it.\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, __cap_resolve)\n          emit_i64_const(buf, 1)\n          emit_i64_or(buf)\n          emit_i64_store(buf, 3, cap_off + csi * 8)\n          emit_rc_word_inc_saturating(buf, () -> {\n            emit_local_get(buf, __cap_resolve)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 4)\n            emit_i32_sub(buf)\n          })\n        } else {\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, __cap_resolve)\n          emit_i64_store(buf, 3, cap_off + csi * 8)\n          // owned-captures ABI (ADR-0076 追記31 Vertical A): the env OWNS\n          // every heap capture — dup at creation, released by the closure's\n          // class-7 recursive drop. Scalars and string/bytes fat pointers are\n          // no-ops on BOTH sides (guarded dup mirrors gen_rc_drop_body's\n          // entry checks), so the pair stays balanced across all shapes.\n          // The let-rec SELF capture stays weak (no dup; the binder patches\n          // the slot after creation and the drop loop skips self-pointing\n          // slots) — dup'ing here would (a) leak one stale closure per loop\n          // iteration when the letrec local is re-bound, and (b) make the\n          // self-cycle unreclaimable.\n          if ctx.enable_rc && cap_name != self_name {\n            emit_rc_dup_guarded(buf, __cap_resolve, ctx.rc_shadow)\n          } else {\n            ()\n          }\n        }\n      } else {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_i64_store(buf, 3, cap_off + csi * 8)\n      }\n      csi = csi + 1\n    }\n    if ctx.enable_rc {\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n    } else {\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n    }\n    nl2\n  }\n}\n")
}

let cli_adapter_source_88 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/builtin_registry.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# Functions\n\n// #415: the central declarative registry of func-table builtins across\n// both backends. Row: (name, param_count, returns_value 0|1,\n// in_linear_table, in_gc_table).\n//\n// B-1: this registry DRIVES both lanes' registration. The linear builder\n// (wasi/linked_compile.vibe) and the gc builder (gc/backend_body.vibe) each\n// loop over these rows (filtered by their lane flag) and only resolve the\n// lane-local function/body INDEX via a per-lane match — names, param counts\n// and returns exist ONLY here. Adding a builtin = one row here + one index\n// match arm in each claiming lane (+ the import/body wiring). A row claiming\n// a lane whose index match has no arm fails every build by name; the\n// remaining verify_lane_builtins pass (below) guards any future hand-edited\n// registration path against drifting from this table (the wasm-gc HOF-gap\n// class of regression this issue exists to prevent).\n//\n// Lane semantics:\n// - in_linear_table / in_gc_table refer to the lane's FUNC-TABLE registration\n//   only. A name absent from a lane's table may still be served there by a\n//   callsite lowering (expr/compile_call.vibe, gc/backend_call.vibe) or by\n//   prelude vibe source — B-1 will classify those; B-0 pins what exists.\n// - Host imports (Fs::/Env::/sleep/...) are linear-only by design: the gc\n//   lane is the pure-test lane and gates host builtins out as a group.\n// B-2: rows now carry the CHECKER TYPE as the single source of truth.\n// param_count / returns for the lanes are DERIVED from that type\n// (builtin_registry() below); the checker resolves these names through\n// lookup_registry_builtin FIRST, so the per-namespace checker lookup files\n// no longer need (and must not re-add) arms for registry names.\n// checker_visible=false rows are codegen-internal (desugar/compile_call\n// artifacts, RC runtime hooks, canonical-name aliases) -- the checker never\n// sees those names, and their synthesized types only feed the derived\n// param/returns view.\n\nfn reg_p0() -> Array[Type] {\n  array_empty()\n}\n\nfn reg_p1(a: Type) -> Array[Type] {\n  let arr = reg_p0()\n  Array::push(arr, a)\n  arr\n}\n\nfn reg_p2(a: Type, b: Type) -> Array[Type] {\n  let arr = reg_p1(a)\n  Array::push(arr, b)\n  arr\n}\n\nfn reg_p3(a: Type, b: Type, c: Type) -> Array[Type] {\n  let arr = reg_p2(a, b)\n  Array::push(arr, c)\n  arr\n}\n\nfn reg_p4(a: Type, b: Type, c: Type, d: Type) -> Array[Type] {\n  let arr = reg_p3(a, b, c)\n  Array::push(arr, d)\n  arr\n}\n\nfn reg_p5(a: Type, b: Type, c: Type, d: Type, e: Type) -> Array[Type] {\n  let arr = reg_p4(a, b, c, d)\n  Array::push(arr, e)\n  arr\n}\n\n/// typed row: (name, checker signature, in_linear_table, in_gc_table,\n/// checker_visible). Module-level `let`: initialized ONCE (see\n/// fixtures/module_let_memo_test.vibe) -- lookup_registry_builtin runs on\n/// every unresolved-name lookup in the checker, and rebuilding 116 rows of\n/// nested CtFn/Array values per call was allocation churn heavy enough to\n/// crash the RC-mode in-process compiler tests.\nlet registry_typed_rows: Array[(String, Type, Bool, Bool, Bool)] = [\n  (\"Env::get\", CtFn(reg_p1(CtString), CtString, Some(\"Env\")), true, false, true),\n  (\"Env::args_len\", CtFn(reg_p0(), CtInt, Some(\"Env\")), true, false, true),\n  (\"Env::args_get\", CtFn(reg_p1(CtInt), CtString, Some(\"Env\")), true, false, true),\n  (\"Fs::read_file\", CtFn(reg_p1(CtString), CtString, Some(\"Fs\")), true, false, true),\n  (\"Fs::exists\", CtFn(reg_p1(CtString), CtBool, Some(\"Fs\")), true, false, true),\n  (\"Fs::stat_token\", CtFn(reg_p1(CtString), CtInt, Some(\"Fs\")), true, false, true),\n  // #795: alias-collision-proof surface for the same import.\n  (\"vibe_fs_stat_token_raw\", CtFn(reg_p1(CtString), CtInt, Some(\"Fs\")), true, false, true),\n  (\"Fs::write_file\", CtFn(reg_p2(CtString, CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::write_bytes\", CtFn(reg_p2(CtString, CtBytes), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::read_bytes\", CtFn(reg_p1(CtString), CtBytes, Some(\"Fs\")), true, false, true),\n  (\"vibe_fs_read_dir_raw\", CtFn(reg_p1(CtString), CtString, Some(\"Fs\")), true, false, false),\n  (\"sh\", CtFn(reg_p1(CtString), CtString, Some(\"Process\")), true, false, true),\n  (\"vibe_sh_lines_raw\", CtFn(reg_p1(CtString), CtString, Some(\"Process\")), true, false, false),\n  // #865: structured subprocess result. `vibe_sh_capture_raw` runs the\n  // command ONCE (unlike a naive 3-accessor design that would re-run it)\n  // and parks {exit_code, stdout, stderr} behind a handle -- same\n  // handle+accessor shape as the #794 HTTP client imports below, chosen so\n  // a structured result doesn't require struct-returning host ABI work.\n  // checker_visible=true (unlike vibe_sh_lines_raw's raw half) because these\n  // are plain qualified names (no bare \"sh\"/\"sh_lines\" collision risk), so\n  // ordinary vibe source (lib/@vibe/process/process.vibe) calls them\n  // directly, mirroring lib/@vibe/http/http.vibe's `vibe_http_*_raw`\n  // direct-call convention -- no compile_call.vibe special-casing needed.\n  (\"vibe_sh_capture_raw\", CtFn(reg_p1(CtString), CtInt, Some(\"Process\")), true, false, true),\n  (\"vibe_sh_capture_exit_code_raw\", CtFn(reg_p1(CtInt), CtInt, Some(\"Process\")), true, false, true),\n  (\"vibe_sh_capture_stdout_raw\", CtFn(reg_p1(CtInt), CtString, Some(\"Process\")), true, false, true),\n  (\"vibe_sh_capture_stderr_raw\", CtFn(reg_p1(CtInt), CtString, Some(\"Process\")), true, false, true),\n  (\"vibe_sh_capture_close_raw\", CtFn(reg_p1(CtInt), CtUnit, Some(\"Process\")), true, false, true),\n  // #903/#865: propagate a guest-chosen exit code to the real OS process\n  // exit status (unlike a `main() -> Int` return, which `_start` only\n  // PRINTS -- see ADR-0069's entry_returns_unit comment in\n  // codegen/wasi/linked_compile.vibe). Traps via the host runner's\n  // existing exit-trap mechanism (Rust `viberun`: reuses ExitTrap, the\n  // same trap the legacy `__moonbit_sys_unstable::exit` import already\n  // used; JS runner: `process.exit(code)` directly) -- never returns.\n  (\"vibe_process_exit_raw\", CtFn(reg_p1(CtInt), CtUnit, Some(\"Process\")), true, false, true),\n  (\"Stdin::read_stream\", CtFn(reg_p1(CtInt), CtString, Some(\"Stdin\")), true, false, true),\n  (\"Stdout::write_stream\", CtFn(reg_p1(CtString), CtUnit, Some(\"Stdout\")), true, false, true),\n  (\"Stdout::write_char\", CtFn(reg_p1(CtInt), CtUnit, Some(\"Stdout\")), true, false, true),\n  // #865: Stderr, mirroring Stdout::write_stream / Stdout::write_char exactly\n  // (own host effect name \"Stderr\" so a function using only stderr does not\n  // need to declare `with { Stdout }`).\n  (\"Stderr::write_stream\", CtFn(reg_p1(CtString), CtUnit, Some(\"Stderr\")), true, false, true),\n  (\"Stderr::write_char\", CtFn(reg_p1(CtInt), CtUnit, Some(\"Stderr\")), true, false, true),\n  (\"resolve_path\", CtFn(reg_p1(CtString), CtString, None), true, false, false),\n  (\"Fs::remove\", CtFn(reg_p1(CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::mkdir_p\", CtFn(reg_p1(CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::mkdir\", CtFn(reg_p1(CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::chdir\", CtFn(reg_p1(CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::copy\", CtFn(reg_p2(CtString, CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::append\", CtFn(reg_p2(CtString, CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::rename\", CtFn(reg_p2(CtString, CtString), CtUnit, Some(\"Fs\")), true, false, true),\n  (\"Fs::is_dir\", CtFn(reg_p1(CtString), CtBool, Some(\"Fs\")), true, false, true),\n  (\"Fs::is_file\", CtFn(reg_p1(CtString), CtBool, Some(\"Fs\")), true, false, true),\n  (\"Fs::getcwd\", CtFn(reg_p0(), CtString, Some(\"Fs\")), true, false, true),\n  // Socket client host imports (vibe.tcp_*) -- same \"checker-legal (see\n  // builtins/declarations.vibe), zero codegen wiring\" gap the Fs::* rows\n  // above closed. #1232 review: raw dunder names, NOT `Socket::tcp_connect`\n  // -- lib/@vibe/socket's package index.vpkg ALSO declares `effect\n  // TcpSocket { Connect(String,Int)->Int; Read(Int,Int)->String;\n  // Write(Int,String)->Unit; Close(Int)->Unit }` for its in-package\n  // mock-handler tests, and that effect's operations are STRUCTURALLY\n  // IDENTICAL in signature to these builtins -- a qualified call under the\n  // `Socket::` name let the checker's effect-row resolution match BOTH the\n  // builtin's own row and TcpSocket's, unioning a spurious `{ TcpSocket }`\n  // requirement onto every caller. Same collision class Http's client-side\n  // functions (lib/@vibe/http/http.vibe) already document and avoid via\n  // `vibe_http_*_raw` naming -- follow that precedent here too.\n  // checker_visible=true: no bare-name collision risk, so ordinary vibe\n  // source (lib/@vibe/socket/tcp.vibe's low-level layer) calls them\n  // directly, same convention as Fs::*/Http's client raw calls -- no\n  // compile_call.vibe special-casing needed. Supersedes the now-dead\n  // Socket::tcp_* arms in checker/builtins_net.vibe (lookup_registry_builtin\n  // runs first; this file's file-header comment: per-namespace checker\n  // lookup files \"must not re-add\" arms for registry names).\n  (\"vibe_tcp_connect_raw\", CtFn(reg_p2(CtString, CtInt), CtInt, Some(\"Socket\")), true, false, true),\n  (\"vibe_tcp_read_raw\", CtFn(reg_p2(CtInt, CtInt), CtString, Some(\"Socket\")), true, false, true),\n  (\"vibe_tcp_write_raw\", CtFn(reg_p2(CtInt, CtString), CtUnit, Some(\"Socket\")), true, false, true),\n  (\"vibe_tcp_close_raw\", CtFn(reg_p1(CtInt), CtUnit, Some(\"Socket\")), true, false, true),\n  // #794: HTTP client host imports (vibe.http_*) -- host builtins are\n  // linear-only by design (the gc lane is the pure-test lane).\n  (\"vibe_http_request_raw\", CtFn(reg_p4(CtString, CtString, CtString, CtString), CtInt, Some(\"Http\")), true, false, true),\n  (\"vibe_http_response_status_raw\", CtFn(reg_p1(CtInt), CtInt, Some(\"Http\")), true, false, true),\n  (\"vibe_http_response_header_raw\", CtFn(reg_p2(CtInt, CtString), CtString, Some(\"Http\")), true, false, true),\n  (\"vibe_http_response_body_raw\", CtFn(reg_p1(CtInt), CtString, Some(\"Http\")), true, false, true),\n  (\"vibe_http_close_raw\", CtFn(reg_p1(CtInt), CtUnit, Some(\"Http\")), true, false, true),\n  (\"Profiler::now_us\", CtFn(reg_p0(), CtInt, Some(\"Profiler\")), true, false, true),\n  (\"Profiler::NowUs\", CtFn(reg_p0(), CtInt, None), true, false, false),\n  // Current bump-heap pointer (bytes) — the allocation analog of now_us,\n  // for per-phase memory attribution in profiles/benches.\n  (\"Profiler::heap_bytes\", CtFn(reg_p0(), CtInt, Some(\"Profiler\")), true, false, true),\n  (\"Profiler::HeapBytes\", CtFn(reg_p0(), CtInt, None), true, false, false),\n  (\"sleep\", CtFn(reg_p1(CtInt), CtUnit, Some(\"Async\")), true, false, true),\n  // #1227: same host import as `sleep`, but row-free -- see\n  // checker/builtins_system.vibe for why the row cannot be discharged.\n  (\"sleep_blocking\", CtFn(reg_p1(CtInt), CtUnit, None), true, false, true),\n  (\"Stdin::read_char\", CtFn(reg_p0(), CtInt, Some(\"Stdin\")), true, false, true),\n  (\"simd_skip_ws\", CtFn(reg_p3(CtBytes, CtInt, CtInt), CtInt, None), true, false, true),\n  (\"simd_scan_alnum\", CtFn(reg_p3(CtBytes, CtInt, CtInt), CtInt, None), true, false, true),\n  (\"simd_scan_alnum_str\", CtFn(reg_p3(CtString, CtInt, CtInt), CtInt, None), true, false, true),\n  (\"str_lex_diff\", CtFn(reg_p2(CtString, CtString), CtInt, None), true, true, false),\n  // #973: erased-generic `[T: Ord]`/`[T: Add]` runtime dispatch for `<` `>`\n  // `<=` `>=` `+` (desugar_trait_dict.vibe rewrites the binop when the\n  // operand's static type is the bare, unresolved type parameter itself --\n  // see the doc comment on gen_generic_rel_diff_body). Linear-lane only:\n  // desugar_trait_dicts (the pass that emits these call sites) is invoked\n  // solely from wasi/linked_compile.vibe, so the gc lane never references\n  // these names and does not need a func-table row for them.\n  (\"__generic_rel_diff\", CtFn(reg_p2(CtInt, CtInt), CtInt, None), true, false, false),\n  (\"__generic_add\", CtFn(reg_p2(CtInt, CtInt), CtInt, None), true, false, false),\n  (\"print_int\", CtFn(reg_p1(CtInt), CtUnit, None), true, true, false),\n  (\"print_str\", CtFn(reg_p1(CtString), CtUnit, None), true, true, false),\n  (\"String::length\", CtFn(reg_p1(CtString), CtInt, None), true, true, true),\n  (\"String::equals\", CtFn(reg_p2(CtString, CtString), CtBool, None), true, true, true),\n  (\"String::concat\", CtFn(reg_p2(CtString, CtString), CtString, None), true, true, true),\n  (\"array_new\", CtFn(reg_p0(), CtArray(CtUnknown), None), true, true, true),\n  (\"Array::length\", CtFn(reg_p1(CtArray(CtUnknown)), CtInt, None), true, true, true),\n  (\"Array::get\", CtFn(reg_p2(CtArray(CtUnknown), CtInt), CtUnknown, None), true, true, true),\n  (\"Array::push\", CtFn(reg_p2(CtArray(CtUnknown), CtUnknown), CtUnit, None), true, true, true),\n  (\"Array::push_all\", CtFn(reg_p2(CtArray(CtUnknown), CtArray(CtUnknown)), CtUnit, None), true, true, true),\n  (\"Array::set\", CtFn(reg_p3(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None), true, true, true),\n  (\"Double::to_int\", CtFn(reg_p1(CtDouble), CtInt, None), true, true, true),\n  (\"Int::to_double\", CtFn(reg_p1(CtInt), CtDouble, None), true, true, true),\n  (\"String::char_code_at\", CtFn(reg_p2(CtString, CtInt), CtInt, None), true, true, true),\n  (\"String::from_char_code\", CtFn(reg_p1(CtInt), CtString, None), true, true, true),\n  (\"String::substring\", CtFn(reg_p3(CtString, CtInt, CtInt), CtString, None), true, true, true),\n  (\"Array::truncate\", CtFn(reg_p2(CtArray(CtUnknown), CtInt), CtUnit, None), true, true, true),\n  (\"String::join\", CtFn(reg_p2(CtArray(CtString), CtString), CtString, None), true, true, true),\n  (\"eq\", CtFn(reg_p2(CtInt, CtInt), CtBool, None), true, true, true),\n  (\"String::ends_with\", CtFn(reg_p2(CtString, CtString), CtBool, None), true, true, true),\n  (\"String::last_index_of\", CtFn(reg_p2(CtString, CtString), CtInt, None), true, true, true),\n  (\"String::index_of\", CtFn(reg_p2(CtString, CtString), CtInt, None), true, true, true),\n  (\"String::contains\", CtFn(reg_p2(CtString, CtString), CtBool, None), true, true, true),\n  (\"String::starts_with\", CtFn(reg_p2(CtString, CtString), CtBool, None), true, true, true),\n  (\"String::split\", CtFn(reg_p2(CtString, CtString), CtArray(CtString), None), true, true, true),\n  (\"String::trim\", CtFn(reg_p1(CtString), CtString, None), true, true, true),\n  (\"compiler_sources\", CtFn(reg_p0(), CtString, None), true, false, false),\n  (\"ArrayBuilder::new\", CtFn(reg_p0(), CtUnknown, None), true, true, true),\n  (\"ArrayBuilder::push\", CtFn(reg_p2(CtUnknown, CtUnknown), CtUnit, None), true, true, true),\n  (\"ArrayBuilder::freeze\", CtFn(reg_p1(CtUnknown), CtArray(CtUnknown), None), true, true, true),\n  // #906: FrozenArray[T] -- a checker-only phantom-type wrapper over\n  // Array[T]'s exact same runtime layout (same technique as ArrayBuilder\n  // just above: from_array/to_array are pure identity casts, get/length\n  // alias Array::get/Array::length's own bodies -- see\n  // gc/backend_body.vibe and wasi/linked_compile.vibe). checker.vibe's\n  // FrozenArray::* ECall branches refine these CtUnknown-shaped rows with\n  // the real per-call-site element type; these rows exist so both codegen\n  // lanes' func-table registration (which is DRIVEN by this registry, #415\n  // B-1) has a row to loop over and so a bare reference to the name (not a\n  // direct call) still resolves to a sane function type.\n  (\"FrozenArray::from_array\", CtFn(reg_p1(CtArray(CtUnknown)), CtNamed(\"FrozenArray\", reg_p1(CtUnknown)), None), true, true, true),\n  (\"FrozenArray::get\", CtFn(reg_p2(CtNamed(\"FrozenArray\", reg_p1(CtUnknown)), CtInt), CtUnknown, None), true, true, true),\n  (\"FrozenArray::length\", CtFn(reg_p1(CtNamed(\"FrozenArray\", reg_p1(CtUnknown))), CtInt, None), true, true, true),\n  (\"FrozenArray::to_array\", CtFn(reg_p1(CtNamed(\"FrozenArray\", reg_p1(CtUnknown))), CtArray(CtUnknown), None), true, true, true),\n  (\"Array::slice\", CtFn(reg_p3(CtArray(CtUnknown), CtInt, CtInt), CtArray(CtUnknown), None), true, true, true),\n  (\"Array::concat\", CtFn(reg_p2(CtArray(CtUnknown), CtArray(CtUnknown)), CtArray(CtUnknown), None), true, true, true),\n  (\"Bytes::new\", CtFn(reg_p0(), CtBytes, None), true, true, true),\n  (\"Bytes::from_array\", CtFn(reg_p1(CtArray(CtInt)), CtBytes, None), true, true, true),\n  (\"Bytes::to_array\", CtFn(reg_p1(CtBytes), CtArray(CtInt), None), true, true, true),\n  (\"Bytes::length\", CtFn(reg_p1(CtBytes), CtInt, None), true, true, true),\n  (\"Bytes::get\", CtFn(reg_p2(CtBytes, CtInt), CtInt, None), true, true, true),\n  (\"Bytes::set\", CtFn(reg_p3(CtBytes, CtInt, CtInt), CtUnit, None), true, true, true),\n  (\"Bytes::push\", CtFn(reg_p2(CtBytes, CtInt), CtUnit, None), true, true, true),\n  (\"Bytes::append\", CtFn(reg_p2(CtBytes, CtBytes), CtUnit, None), true, true, true),\n  (\"Bytes::concat\", CtFn(reg_p2(CtBytes, CtBytes), CtBytes, None), true, true, true),\n  (\"Bytes::slice\", CtFn(reg_p3(CtBytes, CtInt, CtInt), CtBytes, None), true, true, true),\n  (\"Double::to_i64_bits\", CtFn(reg_p1(CtDouble), CtInt, None), true, true, true),\n  (\"__to_string\", CtFn(reg_p1(CtUnknown), CtString, None), true, true, true),\n  (\"vibe_rc_drop\", CtFn(reg_p1(CtUnknown), CtUnit, None), true, false, false),\n  (\"vibe_rc_alloc\", CtFn(reg_p1(CtInt), CtInt, None), true, false, false),\n  (\"vibe_heap_grow_check\", CtFn(reg_p0(), CtUnit, None), true, false, false),\n  (\"not\", CtFn(reg_p1(CtBool), CtBool, None), false, true, true),\n  (\"Bytes::blit\", CtFn(reg_p4(CtBytes, CtBytes, CtInt, CtInt), CtUnit, None), false, true, true),\n  (\"Bytes::fill\", CtFn(reg_p3(CtBytes, CtInt, CtInt), CtUnit, None), false, true, true),\n  (\"Double::from_i64_bits\", CtFn(reg_p1(CtInt), CtDouble, None), false, true, true),\n  (\"Double::to_float\", CtFn(reg_p1(CtDouble), CtDouble, None), false, true, false),\n  (\"Float::to_double\", CtFn(reg_p1(CtDouble), CtDouble, None), false, true, false),\n  (\"Char::to_int\", CtFn(reg_p1(CtChar), CtInt, None), false, true, true),\n  (\"Char::from_int\", CtFn(reg_p1(CtInt), CtChar, None), false, true, true),\n  (\"Int::to_float\", CtFn(reg_p1(CtInt), CtDouble, None), false, true, true),\n  (\"FixedArray::make\", CtFn(reg_p2(CtInt, CtUnknown), CtArray(CtUnknown), None), false, true, true),\n  (\"FixedArray::length\", CtFn(reg_p1(CtArray(CtUnknown)), CtInt, None), false, true, true),\n  (\"FixedArray::get\", CtFn(reg_p2(CtArray(CtUnknown), CtInt), CtUnknown, None), false, true, true),\n  (\"FixedArray::set\", CtFn(reg_p3(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None), false, true, true),\n  (\"FixedArray::unsafe_set\", CtFn(reg_p3(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None), false, true, true),\n  (\"FixedArray::blit\", CtFn(reg_p5(CtArray(CtUnknown), CtInt, CtArray(CtUnknown), CtInt, CtInt), CtUnit, None), false, true, true),\n  // #835: Int64Array rides on the same linear-memory Array representation\n  // as FixedArray (Array[Int] already stores the full 62-bit tagged Int\n  // per cell, no i32-cell truncation in these backends — unlike the\n  // retired MoonBit host, which needed a distinct i64-cell object layout).\n  // So this is a pure name-level alias onto Array::make/length/get/set,\n  // just typed concretely as Array[Int] instead of FixedArray's generic\n  // Array[Unknown] (cheatsheet documents it strictly for Int word buffers).\n  (\"Int64Array::make\", CtFn(reg_p2(CtInt, CtInt), CtArray(CtInt), None), false, true, true),\n  (\"Int64Array::length\", CtFn(reg_p1(CtArray(CtInt)), CtInt, None), false, true, true),\n  (\"Int64Array::get\", CtFn(reg_p2(CtArray(CtInt), CtInt), CtInt, None), false, true, true),\n  (\"Int64Array::set\", CtFn(reg_p3(CtArray(CtInt), CtInt, CtInt), CtUnit, None), false, true, true),\n  (\"StringBuilder::new\", CtFn(reg_p0(), CtUnknown, None), false, true, true),\n  (\"StringBuilder::push\", CtFn(reg_p2(CtUnknown, CtString), CtUnit, None), false, true, true),\n  (\"StringBuilder::freeze\", CtFn(reg_p1(CtUnknown), CtString, None), false, true, true),\n  (\"Map::get\", CtFn(reg_p2(CtUnknown, CtString), CtUnknown, None), false, true, true),\n  (\"Map::keys\", CtFn(reg_p1(CtUnknown), CtArray(CtString), None), false, true, true),\n  (\"MapBuilder::new\", CtFn(reg_p0(), CtUnknown, None), false, true, true),\n  (\"MapBuilder::set\", CtFn(reg_p3(CtUnknown, CtString, CtUnknown), CtUnit, None), false, true, true),\n  (\"MapBuilder::freeze\", CtFn(reg_p1(CtUnknown), CtUnknown, None), false, true, true),\n  (\"assert\", CtFn(reg_p1(CtBool), CtUnit, None), false, true, true),\n  (\"assert_true\", CtFn(reg_p1(CtBool), CtUnit, None), false, true, true),\n  (\"assert_eq\", CtFn(reg_p2(CtUnknown, CtUnknown), CtUnit, None), false, true, true),\n  (\"println\", CtFn(reg_p1(CtString), CtUnit, None), false, true, true),\n  (\"print\", CtFn(reg_p1(CtString), CtUnit, None), false, true, true),\n  (\"map_has\", CtFn(reg_p2(CtUnknown, CtString), CtBool, None), false, true, true)\n]\n\nexport fn builtin_registry_typed() -> Array[(String, Type, Bool, Bool, Bool)] {\n  registry_typed_rows\n}\n\n/// Derived 5-tuple view for the two codegen lanes -- SAME shape as the B-0/B-1\n/// table so wasi/linked_compile.vibe and gc/backend_body.vibe are unchanged:\n/// param_count = the type's parameter count, returns = 0 iff the return type\n/// is CtUnit.\nexport fn builtin_registry() -> Array[(String, Int, Int, Bool, Bool)] {\n  let rows = builtin_registry_typed()\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (name, ty, in_linear, in_gc, _) = Array::get(rows, i)\n    let (pc, ret) = match ty {\n      CtFn(params, ret_ty, _) => {\n        let r = match ret_ty {\n          CtUnit => 0,\n          _ => 1\n        }\n        (Array::length(params), r)\n      },\n      _ => (0, 1)\n    }\n    Array::push(out, (name, pc, ret, in_linear, in_gc))\n    i = i + 1\n  }\n  out\n}\n\n/// B-2: the checker-facing lookup, consulted FIRST by\n/// checker/builtins.vibe::lookup_builtin. Only checker_visible rows resolve;\n/// codegen-internal names stay invisible to user code.\nexport fn lookup_registry_builtin(name: String) -> Option[Type] {\n  let rows = builtin_registry_typed()\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(rows) {\n    let (rname, ty, _, _, visible) = Array::get(rows, i)\n    if rname == name && visible {\n      found = Some(ty)\n      i = Array::length(rows)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// #415 B-0: assert one lane's registered (names, param_counts, returns)\n/// arrays agree with the registry. Called by each backend builder right after\n/// it finishes its registration pushes; throws with a named diff on any\n/// drift. O(n^2) over ~100 entries at compile start — noise next to a parse.\nexport fn verify_lane_builtins(lane: String, names: Array[String], param_counts: Array[Int], returns: Array[Int]) -> Unit with { Error } {\n  let is_gc = lane == \"gc\"\n  let reg = builtin_registry()\n  // 1. every registered name must have a matching registry row\n  let mut i = 0\n  while i < Array::length(names) {\n    let n = Array::get(names, i)\n    let mut found = false\n    let mut ri = 0\n    while ri < Array::length(reg) {\n      let (rn, rp, rr, rlin, rgc) = Array::get(reg, ri)\n      if rn == n {\n        found = true\n        let claimed = if is_gc {\n          rgc\n        } else {\n          rlin\n        }\n        if claimed {\n          ()\n        } else {\n          throw(\"builtin registry drift: '\\{n}' is registered by the \\{lane} lane but the registry says it is not in that lane's table (lib/@vibe/compiler/codegen/builtin_registry.vibe, #415)\")\n        }\n        if rp == Array::get(param_counts, i) && rr == Array::get(returns, i) {\n          ()\n        } else {\n          throw(\"builtin registry drift: '\\{n}' signature mismatch in the \\{lane} lane — registry says (params=\\{rp}, returns=\\{rr}), lane registered (params=\\{Array::get(param_counts, i)}, returns=\\{Array::get(returns, i)}) (#415)\")\n        }\n        ri = Array::length(reg)\n      } else {\n        ri = ri + 1\n      }\n    }\n    if found {\n      ()\n    } else {\n      throw(\"builtin registry drift: '\\{n}' is registered by the \\{lane} lane but has no row in lib/@vibe/compiler/codegen/builtin_registry.vibe (#415) — add one (and decide the other lane explicitly)\")\n    }\n    i = i + 1\n  }\n  // 2. every registry row claiming this lane must actually be registered.\n  // Exemption: the linear lane registers vibe_rc_drop/vibe_rc_alloc only when RC is\n  // enabled (VIBE_RC), so their absence in a bump-mode build is not drift —\n  // they stay direction-1 verified (if registered, the signature must match).\n  let mut ri2 = 0\n  while ri2 < Array::length(reg) {\n    let (rn2, _, _, rlin2, rgc2) = Array::get(reg, ri2)\n    let claimed2 = (if is_gc {\n      rgc2\n    } else {\n      rlin2\n    }) && not(String::starts_with(rn2, \"vibe_rc_\"))\n    if claimed2 {\n      let mut found2 = false\n      let mut i2 = 0\n      while i2 < Array::length(names) {\n        if Array::get(names, i2) == rn2 {\n          found2 = true\n          i2 = Array::length(names)\n        } else {\n          i2 = i2 + 1\n        }\n      }\n      if found2 {\n        ()\n      } else {\n        throw(\"builtin registry drift: registry claims '\\{rn2}' is in the \\{lane} lane's table but the lane did not register it (#415)\")\n      }\n    } else {\n      ()\n    }\n    ri2 = ri2 + 1\n  }\n}\n")
}

