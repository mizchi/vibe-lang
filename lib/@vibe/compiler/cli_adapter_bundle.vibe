) -> Bytes {\n  let b = bytebuf_new()\n  // #811: bounds check — an out-of-range (or negative) index silently read\n  // adjacent memory ([1,2,3][5] returned garbage). One UNSIGNED compare\n  // catches both directions (idx as u32 >= len rejects negatives too) and\n  // traps via `unreachable`.\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 0)\n  if enable_rc {\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)\n  emit_i32_ge_u(b)\n  emit_if_void(b)\n  bytebuf_push(b, 0)\n  emit_end(b)\n  emit_local_get(b, 0)\n  // ADR-0055 Stage 2b: array value is an odd pointer; untag before use.\n  if enable_rc {\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  // ADR-0055 Stage 1: the index arrives tagged (n<<1); untag before use.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)\n  emit_i32_add(b)\n  emit_i64_load(b, 3, 0)\n  b\n}\n\nexport fn gen_arr_len_body(enable_rc: Bool) -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  // ADR-0055 Stage 2b: array value is an odd pointer; untag before use.\n  if enable_rc {\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: length is a count entering the value world; tag it.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  b\n}\n\nexport fn gen_arr_new_body(enable_rc: Bool, rc_alloc_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  if enable_rc {\n    // ADR-0055 Stage 2c: give array_new the same RC block header as literal\n    // arrays ([alloc_size@0][rc_count@4][class@7]), value = block+8, so EVERY\n    // odd array pointer is self-describing and the recursive rc_drop can reach\n    // it safely. capacity 8, length 0, data_ptr = value+12 (block+20), inline\n    // buffer 8 slots → total 84 (== a cap-8 literal, so the free-list reuses it).\n    // ADR-0055 Stage 4: allocate via the free-list search helper (vibe_rc_alloc) so\n    // a freed array block is reused — a raw bump leaks one block per array_new in\n    // a build-and-discard loop.\n    emit_i64_const(b, 84)\n    emit_call(b, rc_alloc_idx)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 0)\n    emit_local_get(b, 0)\n    emit_i32_const(b, 84)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 0)\n    emit_i32_const(b, 1)\n    emit_i32_store(b, 2, 4)\n    emit_local_get(b, 0)\n    emit_i32_const(b, 5)\n    emit_i32_store8(b, 0, 7)\n    emit_local_get(b, 0)\n    emit_i32_const(b, 8)\n    emit_i32_store(b, 2, 8)\n    emit_local_get(b, 0)\n    emit_i32_const(b, 0)\n    emit_i32_store(b, 2, 12)\n    emit_local_get(b, 0)\n    emit_local_get(b, 0)\n    emit_i32_const(b, 20)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 16)\n    emit_local_get(b, 0)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i64_extend_i32_u(b)\n    emit_i64_const(b, 1)\n    emit_i64_or(b)\n  } else {\n    emit_global_get(b, 0)\n    emit_local_tee(b, 0)\n    emit_i32_const(b, 76)\n    emit_i32_add(b)\n    emit_global_set(b, 0)\n    emit_heap_memory_grow_check(b)\n    emit_local_get(b, 0)\n    emit_i32_const(b, 8)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 0)\n    emit_i32_const(b, 0)\n    emit_i32_store(b, 2, 4)\n    emit_local_get(b, 0)\n    emit_local_get(b, 0)\n    emit_i32_const(b, 12)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 8)\n    emit_local_get(b, 0)\n    emit_i64_extend_i32_u(b)\n  }\n  b\n}\n\nexport fn gen_arr_set_body(enable_rc: Bool) -> Bytes {\n  let b = bytebuf_new()\n  // #811: same unsigned bounds check as gen_arr_get_body — an OOB set\n  // silently corrupted adjacent memory.\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 0)\n  if enable_rc {\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)\n  emit_i32_ge_u(b)\n  emit_if_void(b)\n  bytebuf_push(b, 0)\n  emit_end(b)\n  emit_local_get(b, 0)\n  // ADR-0055 Stage 2b: array value is an odd pointer; untag before use.\n  if enable_rc {\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 3)\n  emit_local_get(b, 3)\n  emit_local_get(b, 1)\n  // ADR-0055 Stage 1: the index arrives tagged (n<<1); untag before use.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)\n  emit_i32_add(b)\n  emit_local_get(b, 2)\n  emit_i64_store(b, 3, 0)\n  b\n}\n\n/// Push the bin-head address for `ptr_local`'s block size:\n/// bins_base + (((size - 16) >> 3) << 2). Pure push.\nfn emit_rc_bin_addr(b: Bytes, ptr_local: Int, bins_base: Int) -> Unit {\n  emit_local_get(b, ptr_local)\n  emit_i32_const(b, 8)\n  emit_i32_sub(b)\n  emit_i32_load(b, 2, 0)\n  emit_i32_const(b, 16)\n  emit_i32_sub(b)\n  emit_i32_const(b, 3)\n  // i32.shr_u (0x76)\n  bytebuf_push(b, 118)\n  emit_i32_const(b, 2)\n  // i32.shl (0x74)\n  bytebuf_push(b, 116)\n  emit_i32_const(b, bins_base)\n  emit_i32_add(b)\n}\n\n/// Legacy LIFO free push onto global 2, linking through the rc word.\nfn emit_rc_legacy_free_push(b: Bytes, ptr_local: Int) -> Unit {\n  emit_local_get(b, ptr_local)\n  emit_i32_const(b, 4)\n  emit_i32_sub(b)\n  emit_global_get(b, 2)\n  emit_i32_store(b, 2, 0)\n  emit_local_get(b, ptr_local)\n  emit_global_set(b, 2)\n}\n\n/// ADR-0092 (#1262) size-segregated free-list bins: push the freed block in\n/// `ptr_local` (a value pointer; header at ptr-8) onto its exact-size bin\n/// when the block is small (size 16..264, 8-aligned -- 32 bins of 4 bytes\n/// at `bins_base`, bin index (size-16)>>3), else onto the legacy global-2\n/// list. The bin link reuses the rc word at ptr-4, same as the legacy list.\n/// Pure emission; recomputes size/bin address instead of taking a scratch\n/// local so callers' local layouts stay untouched.\nfn emit_rc_free_push(b: Bytes, ptr_local: Int, bins_base: Int) -> Unit {\n  // (size & 7) == 0 ?\n  emit_local_get(b, ptr_local)\n  emit_i32_const(b, 8)\n  emit_i32_sub(b)\n  emit_i32_load(b, 2, 0)\n  emit_i32_const(b, 7)\n  // i32.and (0x71)\n  bytebuf_push(b, 113)\n  emit_i32_eqz(b)\n  emit_if_void(b)\n  // (size - 16) <u 249 ?  [i.e. 16 <= size <= 264]\n  emit_local_get(b, ptr_local)\n  emit_i32_const(b, 8)\n  emit_i32_sub(b)\n  emit_i32_load(b, 2, 0)\n  emit_i32_const(b, 16)\n  emit_i32_sub(b)\n  emit_i32_const(b, 249)\n  // i32.lt_u (0x49)\n  bytebuf_push(b, 73)\n  emit_if_void(b)\n  // store(ptr-4, load(binaddr)); store(binaddr, ptr)\n  emit_local_get(b, ptr_local)\n  emit_i32_const(b, 4)\n  emit_i32_sub(b)\n  emit_rc_bin_addr(b, ptr_local, bins_base)\n  emit_i32_load(b, 2, 0)\n  emit_i32_store(b, 2, 0)\n  emit_rc_bin_addr(b, ptr_local, bins_base)\n  emit_local_get(b, ptr_local)\n  emit_i32_store(b, 2, 0)\n  emit_else(b)\n  emit_rc_legacy_free_push(b, ptr_local)\n  emit_end(b)\n  emit_else(b)\n  emit_rc_legacy_free_push(b, ptr_local)\n  emit_end(b)\n}\n\n/// ADR-0055 Stage 3: the generic recursive rc_drop helper (linear RC backend).\n/// Signature (i64 value) -> (): decrement the value's reference count and, at\n/// zero, recursively drop its heap fields before pushing the block onto the\n/// free-list (global 2). `self_idx` is this function's own wasm index so it can\n/// recurse into fields to arbitrary depth.\n///\n/// Value representation (ADR-0055): a heap pointer is odd (`(block+8)|1`); an\n/// int/bool is even (`n<<1`). The block header is\n///   [alloc_size@block+0][rc_count@block+4 (class id in high byte)] and\n///   value = block+8 → live header at value-8 / value-4, payload at value+8.\n/// The drop-class byte (value-1) is: 1 = field-vector (tuple/record/ctor/\n/// closure: [_@value+0][count@value+4][fields@value+8+i*8]); 5 = array\n/// (length@value+4, data_ptr@value+8, elements at data_ptr+i*8). Anything else\n/// (leaf: int/bool/string/float/bare-fn, or an unheadered pointer) is freed\n/// without following fields.\n///\n/// Locals: 0 = i64 v (param); 1 vptr, 2 class, 3 cnt, 4 idx, 5 dptr (i32);\n/// 6 = i64 field value.\nexport fn gen_rc_drop_body(self_idx: Int, rc_shadow: Bool, bins_base: Int) -> Bytes {\n  let b = bytebuf_new()\n  // not a heap pointer (even) → nothing to do\n  emit_local_get(b, 0)\n  emit_i64_const(b, 1)\n  emit_i64_and(b)\n  emit_i64_eqz(b)\n  emit_if_void(b)\n  emit_return(b)\n  emit_end(b)\n  // string/bytes fat pointer ((offset<<32)|length): the data offset (>= 64)\n  // lives in the high 32 bits, whereas every heap block address is < 2^32\n  // (high 32 bits == 0). So if (v >> 32) != 0 it is a leaf fat pointer, not an\n  // RC block → skip. (Values here are positive, so shr_s == shr_u.)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i64_eqz(b)\n  emit_i32_eqz(b)\n  emit_if_void(b)\n  emit_return(b)\n  emit_end(b)\n  // vptr = (v & -2) as i32  (untag the odd pointer to the value pointer)\n  emit_local_get(b, 0)\n  emit_i64_const(b, -2)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 1)\n  // #715 recurrence guard (VIBE_RC=shadow): trap BEFORE the rc-- below if the\n  // shadow byte says this block is already freed. For a freed block, vptr-4\n  // is the free-list NEXT link, so a drop-of-freed would silently corrupt the\n  // list (decrement the link) and usually return without reaching zero --\n  // the entry check is the only reliable place to catch it.\n  if rc_shadow {\n    emit_local_get(b, 1)\n    emit_i32_const(b, rc_shadow_base())\n    emit_i32_add(b)\n    emit_i32_load8_u(b, 0, 0)\n    emit_if_void(b)\n    bytebuf_push(b, 0)\n    emit_end(b)\n  } else {\n    ()\n  }\n  // #720: a saturated rc (low 24 bits == 0xFFFFFF) marks an immortal block\n  // (see emit_rc_word_inc_saturating) -- never decrement, never free.\n  emit_local_get(b, 1)\n  emit_i32_const(b, 4)\n  emit_i32_sub(b)\n  emit_i32_load(b, 2, 0)\n  emit_i32_const(b, 16777215)\n  bytebuf_push(b, 113)\n  emit_i32_const(b, 16777215)\n  emit_i32_eq(b)\n  emit_if_void(b)\n  emit_return(b)\n  emit_end(b)\n  // rc_count-- : store(vptr-4, load(vptr-4) - 1). The class byte is the high\n  // byte of the same word; subtracting 1 from a non-zero rc never borrows into\n  // it, so it is preserved.\n  emit_local_get(b, 1)\n  emit_i32_const(b, 4)\n  emit_i32_sub(b)\n  emit_local_get(b, 1)\n  emit_i32_const(b, 4)\n  emit_i32_sub(b)\n  emit_i32_load(b, 2, 0)\n  emit_i32_const(b, 1)\n  emit_i32_sub(b)\n  emit_i32_store(b, 2, 0)\n  // if rc (low 24 bits) != 0 → still referenced → return. `* 256` shifts the\n  // class byte out of the 32-bit word so only rc is tested.\n  emit_local_get(b, 1)\n  emit_i32_const(b, 4)\n  emit_i32_sub(b)\n  emit_i32_load(b, 2, 0)\n  emit_i32_const(b, 256)\n  emit_i32_mul(b)\n  emit_i32_eqz(b)\n  emit_i32_eqz(b)\n  emit_if_void(b)\n  emit_return(b)\n  emit_end(b)\n  // class = load8u(vptr-1)\n  emit_local_get(b, 1)\n  emit_i32_const(b, 1)\n  emit_i32_sub(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_local_set(b, 2)\n  // field-vector (class 1): for idx in 0..count: rc_drop(load_i64(vptr+8+idx*8))\n  emit_local_get(b, 2)\n  emit_i32_const(b, 1)\n  emit_i32_eq(b)\n  emit_if_void(b)\n  emit_local_get(b, 1)\n  emit_i32_load(b, 2, 4)\n  emit_local_set(b, 3)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 4)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 4)\n  emit_local_get(b, 3)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 1)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 8)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_i64_load(b, 3, 8)\n  emit_local_set(b, 6)\n  emit_local_get(b, 6)\n  emit_call(b, self_idx)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_end(b)\n  // array (class 5): for idx in 0..length: rc_drop(load_i64(data_ptr+idx*8))\n  emit_local_get(b, 2)\n  emit_i32_const(b, 5)\n  emit_i32_eq(b)\n  emit_if_void(b)\n  emit_local_get(b, 1)\n  emit_i32_load(b, 2, 4)\n  emit_local_set(b, 3)\n  emit_local_get(b, 1)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 5)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 4)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 4)\n  emit_local_get(b, 3)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 5)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 8)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_i64_load(b, 3, 0)\n  emit_local_set(b, 6)\n  emit_local_get(b, 6)\n  emit_call(b, self_idx)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  // ADR-0055 Stage 4: free a grown (separate) data buffer. An inline buffer sits\n  // at value+12 (vptr+12) and is freed with the block; a buffer grown by\n  // Array::push is a headered block of its own (data_ptr = its value pointer, so\n  // size@data_ptr-8, next@data_ptr-4) — push onto the free-list head when\n  // data_ptr != vptr+12. Elements were already dropped by the loop above.\n  emit_local_get(b, 5)\n  emit_local_get(b, 1)\n  emit_i32_const(b, 12)\n  emit_i32_add(b)\n  emit_i32_ne(b)\n  emit_if_void(b)\n  // #715 recurrence guard (VIBE_RC=shadow): double-free check for the\n  // grown buffer -- a second free-list push of the same buffer makes two\n  // later allocations return overlapping memory (type confusion), which\n  // plain marking cannot catch. Works under quarantine too (marks are\n  // permanent).\n  if rc_shadow {\n    emit_local_get(b, 5)\n    emit_i32_const(b, rc_shadow_base())\n    emit_i32_add(b)\n    emit_i32_load8_u(b, 0, 0)\n    emit_if_void(b)\n    bytebuf_push(b, 0)\n    emit_end(b)\n  } else {\n    ()\n  }\n  // #715 recurrence guard (VIBE_RC=shadow): mark the grown buffer freed.\n  if rc_shadow {\n    emit_local_get(b, 5)\n    emit_i32_const(b, rc_shadow_base())\n    emit_i32_add(b)\n    emit_i32_const(b, 1)\n    emit_i32_store8(b, 0, 0)\n  } else {\n    ()\n  }\n  emit_rc_free_push(b, 5, bins_base)\n  emit_end(b)\n  emit_end(b)\n  // map (class 6): count@value+0, then `count` entries of (key@+8, val@+16) on a\n  // 16-byte stride (MapBuilder layout). Recursively drop each key and val, then\n  // fall through to the common block free. (cnt = local 3, idx = local 4.)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 6)\n  emit_i32_eq(b)\n  emit_if_void(b)\n  emit_local_get(b, 1)\n  emit_i32_load(b, 2, 0)\n  emit_local_set(b, 3)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 4)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 4)\n  emit_local_get(b, 3)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 1)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 16)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_i64_load(b, 3, 8)\n  emit_local_set(b, 6)\n  emit_local_get(b, 6)\n  emit_call(b, self_idx)\n  emit_local_get(b, 1)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 16)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_i64_load(b, 3, 16)\n  emit_local_set(b, 6)\n  emit_local_get(b, 6)\n  emit_call(b, self_idx)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_end(b)\n  // #699 ref cell (class 8): a heap-boxed `let mut` holds a single value at\n  // vptr+0. Drop it recursively (scalar payloads are a no-op via the odd-check),\n  // then fall through to the common free.\n  emit_local_get(b, 2)\n  emit_i32_const(b, 8)\n  emit_i32_eq(b)\n  emit_if_void(b)\n  emit_local_get(b, 1)\n  emit_i64_load(b, 3, 0)\n  emit_local_set(b, 6)\n  emit_local_get(b, 6)\n  emit_call(b, self_idx)\n  emit_end(b)\n  // closure (class 7): the env at vptr+8 holds `count`(@vptr+4) captures.\n  // owned-captures ABI (ADR-0076 追記31 Vertical A): every capture is OWNED —\n  // compile_lambda dups plain heap captures at creation and #699 ref cells\n  // keep their odd-tagged unguarded inc — so drop each slot recursively,\n  // exactly like the class-1 field-vector loop (the recursive call's own\n  // entry checks skip scalars and string/bytes fat pointers, which received\n  // no dup; that includes the old #769 hazard, since the probe that trapped\n  // on odd-length captured strings is gone). The ONE exception is the\n  // let-rec SELF capture: the binder patches the closure into its own env\n  // without a dup (a dup would make the self-cycle unreclaimable), so skip\n  // any slot whose untagged pointer is this block's own vptr. Then fall\n  // through to the common free.\n  emit_local_get(b, 2)\n  emit_i32_const(b, 7)\n  emit_i32_eq(b)\n  emit_if_void(b)\n  emit_local_get(b, 1)\n  emit_i32_load(b, 2, 4)\n  emit_local_set(b, 3)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 4)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 4)\n  emit_local_get(b, 3)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 1)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 8)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_i64_load(b, 3, 8)\n  emit_local_set(b, 6)\n  emit_local_get(b, 6)\n  emit_i64_const(b, -2)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 1)\n  emit_i32_ne(b)\n  emit_if_void(b)\n  emit_local_get(b, 6)\n  emit_call(b, self_idx)\n  emit_end(b)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_end(b)\n  // #715 recurrence guard (VIBE_RC=shadow): mark this block freed so a later\n  // dup-of-freed (emit_rc_dup_guarded) or drop-of-freed (entry check above)\n  // traps deterministically at the faulting operation.\n  if rc_shadow {\n    emit_local_get(b, 1)\n    emit_i32_const(b, rc_shadow_base())\n    emit_i32_add(b)\n    emit_i32_const(b, 1)\n    emit_i32_store8(b, 0, 0)\n  } else {\n    ()\n  }\n  // free: push the block onto its size bin (small) or the legacy global-2\n  // list, reusing the rc slot (vptr-4) as the next pointer.\n  emit_rc_free_push(b, 1, bins_base)\n  b\n}\n\n/// ADR-0055 Stage 4: generic free-list allocator. Param 0 (i64) = block size in\n/// bytes; returns the i64 block_start of a reusable block. The single LIFO\n/// free-list (global 2) holds value pointers linked through the rc_count word\n/// (cur-4) with the alloc_size at cur-8. A head-only size check (the previous\n/// inline allocator) misses a matching block whenever it is not at the head — so\n/// allocating sizes A,B,A,B... while freeing them recursively (which reverses the\n/// order on the LIFO) bump-allocates every other block even though a perfectly\n/// sized free block exists deeper in the list (a fragmentation \"leak\"). This\n/// Push the bin-head address for the requested size in local 3:\n/// bins_base + (((sz - 16) >> 3) << 2). Pure push (alloc-side sibling of\n/// emit_rc_bin_addr, which reads the size from a block header instead).\nfn emit_rc_alloc_bin_addr(b: Bytes, bins_base: Int) -> Unit {\n  emit_local_get(b, 3)\n  emit_i32_const(b, 16)\n  emit_i32_sub(b)\n  emit_i32_const(b, 3)\n  // i32.shr_u (0x76)\n  bytebuf_push(b, 118)\n  emit_i32_const(b, 2)\n  // i32.shl (0x74)\n  bytebuf_push(b, 116)\n  emit_i32_const(b, bins_base)\n  emit_i32_add(b)\n}\n\n/// helper instead WALKS the list for an exact-fit block and unlinks it, falling\n/// back to a bump only when none exists. Exact-fit only (no splitting), so it is\n/// drop-in compatible with the recursive rc_drop free path.\n///\n/// ADR-0092 (#1262) KPI follow-up: the walk is BOUNDED to the first 16\n/// nodes. The unbounded walk made every miss O(free-list length) -- on the\n/// selfcompile workload the list grows to thousands of mixed-size nodes and\n/// vibe_rc_alloc alone measured 44% of the whole compile's CPU (profile of\n/// the RC-built stage2, 2026-07-31). A LIFO head keeps the most recent\n/// frees first, so same-size churn (the common alloc/free loop pattern)\n/// still hits within a few nodes; a deeper exact fit is abandoned in favor\n/// of a bump, trading bounded fragmentation for O(1) allocation.\n/// Locals: 0=size(i64 param) 1=cur 2=prev 3=sz(i32) 4=result 5=budget.\nexport fn gen_rc_alloc_body(rc_shadow: Bool, bins_base: Int) -> Bytes {\n  let b = bytebuf_new()\n  // sz = (i32) size\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  // ADR-0092 (#1262) size-segregated bins: a small aligned size (16..264,\n  // 8-aligned) checks its exact-size bin first -- O(1) exact fit for the\n  // dominant ctor-block traffic (matching gen_rc_drop_body's bin push).\n  // Bin miss falls through to the bounded legacy walk below (which still\n  // recycles blocks freed by the array/bytes grow paths onto global 2).\n  emit_local_get(b, 3)\n  emit_i32_const(b, 7)\n  // i32.and (0x71)\n  bytebuf_push(b, 113)\n  emit_i32_eqz(b)\n  emit_if_void(b)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 16)\n  emit_i32_sub(b)\n  emit_i32_const(b, 249)\n  // i32.lt_u (0x49)\n  bytebuf_push(b, 73)\n  emit_if_void(b)\n  // result(4) = load(binaddr); if nonzero: unlink + return result-8\n  emit_rc_alloc_bin_addr(b, bins_base)\n  emit_i32_load(b, 2, 0)\n  emit_local_set(b, 4)\n  emit_local_get(b, 4)\n  emit_if_void(b)\n  emit_rc_alloc_bin_addr(b, bins_base)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 4)\n  emit_i32_sub(b)\n  emit_i32_load(b, 2, 0)\n  emit_i32_store(b, 2, 0)\n  if rc_shadow {\n    emit_local_get(b, 4)\n    emit_i32_const(b, rc_shadow_base())\n    emit_i32_add(b)\n    emit_i32_const(b, 0)\n    emit_i32_store8(b, 0, 0)\n  } else {\n    ()\n  }\n  emit_local_get(b, 4)\n  emit_i32_const(b, 8)\n  emit_i32_sub(b)\n  emit_i64_extend_i32_u(b)\n  emit_return(b)\n  emit_end(b)\n  emit_end(b)\n  emit_end(b)\n  // cur = free-list head (global 2); prev = 0; budget = 16\n  emit_global_get(b, 2)\n  emit_local_set(b, 1)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 2)\n  emit_i32_const(b, 16)\n  emit_local_set(b, 5)\n  emit_block_void(b)\n  emit_loop_void(b)\n  // cur == 0 → not found, break to the bump path\n  emit_local_get(b, 1)\n  emit_i32_eqz(b)\n  emit_br_if(b, 1)\n  // budget == 0 → give up the walk, break to the bump path\n  emit_local_get(b, 5)\n  emit_i32_eqz(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 5)\n  emit_i32_const(b, 1)\n  emit_i32_sub(b)\n  emit_local_set(b, 5)\n  // load(cur-8) == sz → exact-fit block found\n  emit_local_get(b, 1)\n  emit_i32_const(b, 8)\n  emit_i32_sub(b)\n  emit_i32_load(b, 2, 0)\n  emit_local_get(b, 3)\n  emit_i32_eq(b)\n  emit_if_void(b)\n  // unlink cur: prev == 0 ? global2 = load(cur-4) : store(prev-4, load(cur-4))\n  emit_local_get(b, 2)\n  emit_i32_eqz(b)\n  emit_if_void(b)\n  emit_local_get(b, 1)\n  emit_i32_const(b, 4)\n  emit_i32_sub(b)\n  emit_i32_load(b, 2, 0)\n  emit_global_set(b, 2)\n  emit_else(b)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 4)\n  emit_i32_sub(b)\n  emit_local_get(b, 1)\n  emit_i32_const(b, 4)\n  emit_i32_sub(b)\n  emit_i32_load(b, 2, 0)\n  emit_i32_store(b, 2, 0)\n  emit_end(b)\n  // #715 recurrence guard (VIBE_RC=shadow): the block is live again -- clear\n  // its freed-marker byte so later dups/drops of the reused block are legal.\n  if rc_shadow {\n    emit_local_get(b, 1)\n    emit_i32_const(b, rc_shadow_base())\n    emit_i32_add(b)\n    emit_i32_const(b, 0)\n    emit_i32_store8(b, 0, 0)\n  } else {\n    ()\n  }\n  // return block_start = cur - 8\n  emit_local_get(b, 1)\n  emit_i32_const(b, 8)\n  emit_i32_sub(b)\n  emit_i64_extend_i32_u(b)\n  emit_return(b)\n  emit_end(b)\n  // prev = cur; cur = load(cur-4); continue\n  emit_local_get(b, 1)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_i32_const(b, 4)\n  emit_i32_sub(b)\n  emit_i32_load(b, 2, 0)\n  emit_local_set(b, 1)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  // bump: result = global0; global0 += sz; return (i64) result\n  emit_global_get(b, 0)\n  emit_local_set(b, 4)\n  emit_global_get(b, 0)\n  emit_local_get(b, 3)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  emit_heap_memory_grow_check(b)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\nexport fn gen_str_len_body(enable_rc: Bool) -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  // ADR-0055 Stage 1: the length is a count entering the value world; tag it\n  // (n<<1) under RC so the uniform caller-side untag recovers the true length.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  b\n}\n")
}

