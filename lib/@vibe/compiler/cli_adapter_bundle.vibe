}

let cli_adapter_source_66 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/header_type_sections.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# Functions\n\nexport fn emit_func_type(buf: Bytes, param_count: Int, result_count: Int) -> Unit {\n  bytebuf_push(buf, 96)\n  leb128_encode_u32(buf, param_count)\n  let mut i = 0\n  while i < param_count {\n    bytebuf_push(buf, 126)\n    i = i + 1\n  }\n  leb128_encode_u32(buf, result_count)\n  let mut j = 0\n  while j < result_count {\n    bytebuf_push(buf, 126)\n    j = j + 1\n  }\n}\n\nexport fn emit_type_section_multi(out: Bytes, type_defs: Array[Int]) -> Unit {\n  let count = Array::length(type_defs) / 2\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    emit_func_type(content, Array::get(type_defs, i * 2), Array::get(type_defs, (i * 2) + 1))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 1, content)\n}\n\nexport fn emit_type_section(out: Bytes, param_count: Int, result_count: Int) -> Unit {\n  let type_defs = array_empty()\n  Array::push(type_defs, param_count)\n  Array::push(type_defs, result_count)\n  emit_type_section_multi(out, type_defs)\n}\n")
}

