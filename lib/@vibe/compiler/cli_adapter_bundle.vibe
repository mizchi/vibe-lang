it_i64_const(b, 46)\n  emit_local_get(b, 2)\n  emit_i64_sub(b)\n  emit_local_set(b, 5)\n  // Bump + grow check BEFORE the memory.copy into the fresh allocation —\n  // same ordering fix as the linear inline `__to_string` handler\n  // (compile_call.vibe): copying first traps when the previous allocation\n  // left global 0 within `len` bytes of the memory end.\n  emit_local_get(b, 4)\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 5)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 7)\n  emit_i32_add(b)\n  emit_i32_const(b, -8)\n  bytebuf_push(b, 113)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  emit_heap_memory_grow_check(b)\n  emit_local_get(b, 4)\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 2)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 5)\n  emit_i32_wrap_i64(b)\n  emit_memory_copy(b)\n  emit_local_get(b, 4)\n  emit_i64_const(b, 32)\n  emit_i64_shl(b)\n  emit_local_get(b, 5)\n  emit_i64_or(b)\n  emit_end(b)\n  b\n}\n\n// #997: see the identical guard + rationale on `gen_double_to_int_body` in\n// codegen/builtin_bodies/bodies_core_b.vibe -- `i64.trunc_f64_s` traps on\n// NaN/out-of-range, and this backend doesn't target the\n// nontrapping-float-to-int-conversions proposal either, so NaN and\n// out-of-i64-range doubles saturate to 0 instead of trunc'ing.\nexport fn gc_gen_double_to_int_body() -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_f64_reinterpret_i64(b)\n  emit_local_get(b, 0)\n  emit_f64_reinterpret_i64(b)\n  emit_f64_ne(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 0)\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_f64_reinterpret_i64(b)\n  emit_f64_const_lohi(b, 0, 1138753536)\n  emit_f64_lt(b)\n  emit_if_i64(b)\n  emit_local_get(b, 0)\n  emit_f64_reinterpret_i64(b)\n  emit_f64_const_lohi(b, 0, 3286237184)\n  emit_f64_ge(b)\n  emit_if_i64(b)\n  emit_local_get(b, 0)\n  emit_f64_reinterpret_i64(b)\n  emit_i64_trunc_f64_s(b)\n  emit_else(b)\n  emit_i64_const(b, 0)\n  emit_end(b)\n  emit_else(b)\n  