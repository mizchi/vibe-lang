t(buf, 0)\n        nl\n      }\n      else if fname == \"perform\" {\n        // #538: performs of host-capability effects (Fs::ReadFile,\n        // Profiler::NowUs, ...) lower to their canonical builtin, exactly like\n        // the linear backend's builtin fast path. Algebraic (user-effect)\n        // performs need the replay-memo machinery and are not ported yet.\n        let op_expr = Array::get(args, 0)\n        let op_head = if is_eident(op_expr) {\n          get_eident_name(op_expr)\n        } else if expr_tag(op_expr) == 8 {\n          let op_callee = get_ecall_callee(op_expr)\n          if is_eident(op_callee) {\n            get_eident_name(op_callee)\n          } else {\n            \"\"\n          }\n        } else {\n          \"\"\n        }\n        // #640: `perform Error::Throw(x)` IS `throw(x)` — route it to the same\n        // wasm exception the EThrow arm emits (tag 0 on the gc backend, see\n        // backend_expr.vibe), so a `with Error` handler catches both spellings.\n        if op_head == \"Error::Throw\" {\n          let mut enl = next_local\n          if expr_tag(op_expr) == 8 && Array::length(get_ecall_args(op_expr)) > 0 {\n            enl = ce(buf, Array::get(get_ecall_args(op_expr), 0), local_names, enl, ld)\n          } else {\n            emit_i64_const(buf, 0)\n          }\n          bytebuf_push(buf, 8)\n          leb128_encode_u32(buf, 0)\n          return enl\n        }\n        if String::index_of(op_head, \"Error::\") == 0 {\n          throw(String::concat(\"perform \", String::concat(op_head, \": the builtin Error effect has a single operation, Throw (#640)\")))\n        }\n        let op_canon = canonical_builtin_name(op_head)\n        let __pf_len = Array::length(ctx.func_table.names)\n        let mut pf_i = -1\n        let mut __pf = 0\n        while __pf < __pf_len {\n          if Array::get(ctx.func_table.names, __pf) == op_canon {\n            pf_i = __pf\n            __pf = __pf_len\n          } else {\n            __p