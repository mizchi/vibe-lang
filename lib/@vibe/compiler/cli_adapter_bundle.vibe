"//# Imports\n\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# Functions\n\nfn system_no_params() -> Array[Type] {\n  array_empty()\n}\n\n/// NOTE: these use `if name == ...` chains, NOT `match name { \"lit\" => }`.\n/// String-literal patterns in `match` do not match at runtime in the compiled\n/// output (codegen gap), so the original `match`-based lookups silently\n/// returned None for every entry — that is why Stdin/Stdout/Env/sh builtins (and\n/// thus io.vibe/markdown/rlm) failed to resolve. `==` comparison works.\nfn lookup_io_a(name: String) -> Option[Type] {\n  if name == \"sh\" {\n    Some(CtFn([\n      CtString\n    ], CtString, Some(\"Process\")))\n  } else if name == \"sh_lines\" {\n    Some(CtFn([\n      CtString\n    ], CtArray(CtString), Some(\"Process\")))\n  } else if name == \"path\" {\n    Some(CtFn([\n      CtString\n    ], CtUnknown, None))\n  } else if name == \"Path::ref\" {\n    // #762: a trusted path LITERAL reference. Resolved to an absolute path\n    // against the process CWD by the `resolve_path` host import (compile_call\n    // lowering), but typed PURE — a `Path::ref` in source is a static reference,\n    // so from_literal need not carry `Env`. Path::resolve is the effect-tracked\n    // dynamic counterpart (same host op, `with { Env }`).\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else if name == \"Path::to_string\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, None))\n  } else if name == \"Path::is_absolute\" {\n    Some(CtFn([\n      CtString\n    ], CtBool, None))\n  } else if name == \"PromptText::new\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else if name == \"Stdin::read_char\" {\n    Some(CtFn(system_no_params(), CtInt, Some(\"Stdin\")))\n  } else if name == \"Stdin::read_stream\" {\n    Some(CtFn([\n      CtInt\n    ], CtString, Some(\"Stdin\")))\n  } else {\n    None\n  }\n}\n\nfn lookup_io_b(name: String) -> Option[Type] {\n  if name == \"Stdout::write_char\" {\n    Some(CtFn([\n      CtInt\n    ], CtUnit, Some(\"Stdout\")))\n  } else if name == \"Stdout::write_stream\" {\n    Some(CtFn([\n      CtString\n    ], CtUnit, Some(\"Stdout\")))\n  } else if name == \"Env::get\" {\n    Some(CtFn([\n      CtString\n    ], CtString, Some(\"Env\")))\n  } else if name == \"Env::args_len\" {\n    Some(CtFn(system_no_params(), CtInt, Some(\"Env\")))\n  } else if name == \"Env::args_get\" {\n    Some(CtFn([\n      CtInt\n    ], CtString, Some(\"Env\")))\n  } else if name == \"Profiler::now_us\" {\n    Some(CtFn(system_no_params(), CtInt, Some(\"Profiler\")))\n  } else if name == \"sleep\" {\n    Some(CtFn([\n      CtInt\n    ], CtUnit, Some(\"Async\")))\n  } else if name == \"sleep_blocking\" {\n    // #1227: the same host suspend as `sleep`, but WITHOUT the nominal\n    // `Async` row, for the one caller that must block while holding a\n    // row-free signature: @vibex/concurrent's pump settling sleep debts.\n    //\n    // The row on `sleep` cannot be discharged locally (a handler cannot\n    // discharge a builtin's nominal row -- it is not a `perform`), and\n    // propagating it makes the pump a \"needing\" function that the ADR-0076\n    // suspend pass must CPS-clone, which its `while`/`let mut` shape makes\n    // ineligible. Both were measured, see #1227.\n    //\n    // This is NOT a general-purpose blocking sleep: it is only sound where\n    // the caller knows nothing else is runnable. `sleep` remains the right\n    // spelling everywhere else, and `sleep_wait` the one inside a task.\n    Some(CtFn([\n      CtInt\n    ], CtUnit, None))\n  } else if name == \"Path::resolve\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else {\n    None\n  }\n}\n\n/// Lines / Llm / Rlm builtins (host: src/checker builtin_declared_names +\n/// core_io / json_and_fallback handlers). Added to match host behavior.\nfn lookup_io_c(name: String) -> Option[Type] {\n  if name == \"Lines::parse\" {\n    Some(CtFn([\n      CtString\n    ], CtArray(CtString), None))\n  } else if name == \"Lines::stringify\" {\n    Some(CtFn([\n      CtArray(CtString)\n    ], CtString, None))\n  } else if name == \"Llm::complete\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtString, Some(\"Llm\")))\n  } else if name == \"Rlm::run\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtString, Some(\"Llm\")))\n  } else if name == \"Rlm::finalize\" {\n    Some(CtFn([\n      CtString\n    ], CtString, None))\n  } else {\n    None\n  }\n}\n\nexport fn lookup_io(name: String) -> Option[Type] {\n  match lookup_io_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_io_b(name) {\n      Some(t) => Some(t),\n      None => lookup_io_c(name)\n    }\n  }\n}\n")
}

