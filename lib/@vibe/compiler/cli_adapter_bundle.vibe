let cli_adapter_source_245 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/merge_sources.vibe",
"//# Imports\n\nimport @vibe/compiler/checker {\n  check_program\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_impl\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program, print_program\n}\n\nimport @vibe/compiler/core {\n  ExportRenamePlan,\n  Expr,\n  Stmt,\n  append_import_alias_rewritten_non_import_stmts_with_renames,\n  append_non_import_stmts_without_alias_rewrite,\n  apply_export_renames_stmts,\n  build_export_rename_plan,\n  collect_import_alias_collision_locals,\n  collect_import_alias_collision_refs,\n  collect_import_value_renames,\n  dir_of_path,\n  export_plan_renames_for,\n  import_value_rename_locals,\n  namespace_private_value_stmts,\n  path_set_add,\n  path_set_contains,\n  path_set_new,\n  resolve_import_path,\n  resolve_import_path_candidates,\n  rewrite_imported_value_stmt_to_local,\n  stmts_have_import_deep\n}\n\nimport ./path_utils.vibe {\n  empty_stmt_array\n}\n\nimport ./preprocess.vibe {\n  expand_interp_stmts, strip_generic_type_params\n}\n\nimport @vibe/compiler/loader {\n  ingest_source_text_fs\n}\n\n//# Functions\n\nfn string_array_contains_local(items: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// #726: directory-style imports (`import ../core { .. }` -> core/index.vibe)\n/// need the CANDIDATE list + existence probe; the single-candidate\n/// resolve_import_path returns `core.vibe`, which does not exist. Falls back\n/// to the first candidate so a genuinely missing import still reports its\n/// plain-file path.\nfn resolve_existing_import_path(base_dir: String, raw_path: String, self_path: String) -> String with { Fs } {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = \"\"\n  let mut fallback = \"\"\n  while i < Array::length(candidates) {\n    let candidate = Array::get(candidates, i)\n    // Skip a candidate that IS the importing file: `export ./codegen` inside\n    // codegen.vibe means the codegen/ directory, never a self-import (which\n    // would only recurse/cycle). Mirrors loader/header_cache.resolve_path_fs.\n    if candidate == self_path {\n      i = i + 1\n    } else if Fs::exists(candidate) {\n      found = candidate\n      i = Array::length(candidates)\n    } else {\n      if fallback == \"\" {\n        fallback = candidate\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n  }\n  if found == \"\" {\n    if fallback == \"\" {\n      Array::get(candidates, 0)\n    } else {\n      fallback\n    }\n  } else {\n    found\n  }\n}\n\n/// #716: collision-def fallback. `excluded_locals` are the import locals the\n/// export-rename plan already rewrites — emitting an inline copy for those too\n/// would double-bind the local. The copy gets the target file's export renames\n/// applied first, so its body's references to renamed sibling exports stay\n/// consistent with the merged program.\nfn append_fs_import_alias_collision_defs(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], plan: ExportRenamePlan, excluded_locals: Array[String]) -> Unit with { Error, Fs } {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = array_empty()\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !string_array_contains_local(emitted, local) && !string_array_contains_local(excluded_locals, local) {\n      let resolved = resolve_existing_import_path(base_dir, raw_path, current_path)\n      // Builtin read + ingest, same as collect_parsed_sources_recursive\n      // (flatten-lane wiring constraint / #741).\n      let source = ingest_source_text_fs(resolved, Fs::read_file(resolved))\n      let source_stmts = namespace_private_value_stmts(resolved, apply_export_renames_stmts(parse_program(lex(source)), export_plan_renames_for(plan, resolved)))\n      let mut j = 0\n      let mut done = false\n      while j < Array::length(source_stmts) && !done {\n        match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n          Some(local_stmt) => {\n            Array::push(merged, local_stmt)\n            Array::push(emitted, local)\n            done = true\n          },\n          None => ()\n        }\n        j = j + 1\n      }\n    }\n    i = i + 1\n  }\n}\n\n/// `visited` is a `path_set` (#533): this recursion runs once per import\n/// EDGE, so a linear `contains_path` scan against a visited list that\n/// grows to every module of the program was O(edges × modules). The set\n/// is membership-only here — file order comes from the recursion itself\n/// (dependencies first), so no ordering constraint is lost.\n///\n/// #716: the recursion only PARSES and orders the files; appending happens in\n/// a second pass once the whole program is known, because the export-rename\n/// plan (ambiguous exported names + re-export facades) needs every file's\n/// export surface before any file can be rewritten.\nfn collect_parsed_sources_recursive(path: String, file_paths: Array[String], file_stmts: Array[Array[Stmt]], visited: Array[Array[String]]) -> Unit with { Error, Fs } {\n  if path_set_contains(visited, path) {\n    ()\n  }\n  else {\n    path_set_add(visited, path)\n    // Builtin read, NOT `perform Fs::ReadFile`. The original reason (#737's\n    // deep-continuation resume corruption) no longer reproduces — the\n    // compiler gate keeps a recursive-perform + in-language-handler canary —\n    // but the FLATTEN lane (the adapter binary run with\n    // VIBE_EMIT_MERGED_SOURCE=1) installs no Fs handler and does not wire\n    // this path's performs to host imports, so a perform here throws an\n    // unhandled effect at flatten time. Mockable reads need that lane's\n    // effect wiring first.\n    // #741: ingestion (require-pin blanking + .vibei contract desugar) applies\n    // in THIS lane too, so a contract package in the graph resolves to its\n    // conformance-checked facade instead of a parse error on bodyless decls.\n    let source = ingest_source_text_fs(path, Fs::read_file(path))\n    let stmts = parse_program(lex(source))\n    let base_dir = dir_of_path(path)\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SImport(raw_path, _) => {\n          let resolved = resolve_existing_import_path(base_dir, raw_path, path)\n          collect_parsed_sources_recursive(resolved, file_paths, file_stmts, visited)\n        },\n        SReExport(raw_path, _) => {\n          let resolved = resolve_existing_import_path(base_dir, raw_path, path)\n          collect_parsed_sources_recursive(resolved, file_paths, file_stmts, visited)\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n    Array::push(file_paths, path)\n    Array::push(file_stmts, stmts)\n  }\n}\n\nfn collect_merged_stmts_recursive(entry_path: String, merged: Array[Stmt], visited: Array[Array[String]]) -> Unit with { Error, Fs } {\n  let file_paths = array_empty()\n  let file_stmts = array_empty()\n  collect_parsed_sources_recursive(entry_path, file_paths, file_stmts, visited)\n  let plan = build_export_rename_plan(file_paths, file_stmts, entry_path)\n  let mut fi = 0\n  while fi < Array::length(file_paths) {\n    let path = Array::get(file_paths, fi)\n    let stmts = Array::get(file_stmts, fi)\n    let export_renamed = if path == entry_path {\n      stmts\n    } else {\n      apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))\n    }\n    let namespaced_stmts = if path == entry_path {\n      export_renamed\n    } else {\n      namespace_private_value_stmts(path, export_renamed)\n    }\n    if stmts_have_import_deep(stmts) {\n      let import_renames = collect_import_value_renames(plan, path, stmts)\n      let skipped_locals = collect_import_alias_collision_locals(stmts)\n      append_fs_import_alias_collision_defs(merged, path, stmts, plan, import_value_rename_locals(import_renames))\n      append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)\n    } else {\n      append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\n    }\n    fi = fi + 1\n  }\n}\n\n/// #726: the merged whole program AS SOURCE TEXT. Resolves imports from the\n/// FS, runs the full merge machinery (export-rename plan, private\n/// namespacing, import-alias rewriting — the same pipeline the FS compile\n/// uses), and prints the merged statements. This replaces the Python\n/// flattener that used to live in scripts/generate_bundle.sh: the old flattener\n/// stripped import/export lines and concatenated files verbatim, leaving\n/// duplicate top-level defs resolved by fn-table first-match roulette; the\n/// merge machinery renames them so the flat source has ZERO duplicates and\n/// carries the #716 visibility guarantees. Comments are dropped (printer\n/// output) — acceptable for a generated bundle artifact.\nexport fn merged_program_source_fs(entry_path: String) -> String with { Error, Fs } {\n  let stmts = empty_stmt_array()\n  let visited = path_set_new()\n  collect_merged_stmts_recursive(entry_path, stmts, visited)\n  print_program(stmts)\n}\n\nexport fn compile_file_wasi_only(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let stmts = empty_stmt_array()\n  let visited = path_set_new()\n  collect_merged_stmts_recursive(entry_path, stmts, visited)\n  expand_interp_stmts(stmts)\n  // Type-check BEFORE stripping generic type params: a generic function like\n  // `[T: Ord](a: T, b: T) -> T { a < b }` only checks if `T` is a bound type\n  // variable. Stripping first leaves `T` a concrete `CtNamed(\"T\")`, so the\n  // Ord-constrained `<` fails to resolve. Stripping happens after the check,\n  // for monomorphic codegen.\n  let _ = check_program(stmts)\n  strip_generic_type_params(stmts)\n  compile_wasi_module_impl(stmts, entry_name)\n}\n\n//# Misc\n\nexport {\n  collect_merged_stmts_recursive\n}\n\nexport {\n  collect_merged_stmts_recursive, compile_file_wasi_only\n}\n")
}

let cli_adapter_source_246 = () -> (String, String) {
