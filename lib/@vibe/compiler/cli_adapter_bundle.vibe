"//# Imports\n\nimport @vibe/compiler/checker {\n  check_program\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_linked_impl\n}\n\nimport @vibe/compiler/codegen/common_base {\n  empty_dbg_prov\n}\n\nimport @vibe/compiler/core {\n  Expr, Stmt,\n  path_set_new\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program\n}\n\nimport ./merge_sources.vibe {\n  collect_merged_stmts_recursive\n}\n\nimport ./path_utils.vibe {\n  empty_stmt_array\n}\n\nimport ./preprocess.vibe {\n  expand_interp_stmts, strip_generic_type_params\n}\n\n//# Functions\n\nexport fn compile_file_wasi_library(dep_path: String) -> Bytes with { Error, Fs } {\n  let stmts = empty_stmt_array()\n  let visited = path_set_new()\n  collect_merged_stmts_recursive(dep_path, stmts, visited)\n  expand_interp_stmts(stmts)\n  // Check before stripping generic type params (see merge_sources.vibe).\n  let _ = check_program(stmts)\n  strip_generic_type_params(stmts)\n  compile_wasi_module_linked_impl(stmts, \"_start\", array_empty(), array_empty(), true, false, false, false, false, false, empty_dbg_prov())\n}\n")
