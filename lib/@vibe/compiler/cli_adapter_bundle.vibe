let cli_adapter_source_48 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/builtins_async.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# Functions\n\n// WASI 0.3 async front-end (M1a/M2/M-conc). See docs/spec/wasi-p3-async.md,\n// ADR-0012.\n//\n// These are type-level / front-end only (no codegen yet): `Future[T]`,\n// `Stream[T]`, `Task[T]` are represented structurally as CtNamed(name, _) so no\n// core `Type` enum change is needed, and element/result types use CtUnknown\n// (gradual), consistent with the rest of the builtin table. Operations that\n// suspend or touch the async runtime carry the open-string `Async` effect, so\n// the existing effect-escape check (checker_effects.vibe) requires them to be\n// used inside `with { Async }` (or a handle body) — exactly like `throw`/`Error`.\n\nfn async_no_params() -> Array[Type] {\n  array_empty()\n}\n\n/// Future[T] + await (M1a).\nfn lookup_future(name: String) -> Option[Type] {\n  if name == \"await\" {\n    // await: (Future[T]) -> T with { Async }\n    Some(CtFn([\n      CtNamed(\"Future\", [\n        CtUnknown\n      ])\n    ], CtUnknown, Some(\"Async\")))\n  } else if name == \"Future::ready\" {\n    // Future::ready: (T) -> Future[T]   (pure; an already-resolved future)\n    Some(CtFn([\n      CtUnknown\n    ], CtNamed(\"Future\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Future::pending\" {\n    // Future::pending: () -> Future[T]   (pure; an UNRESOLVED future)\n    //\n    // #1230, the producer half. `await` on this suspends\n    // (`perform Async::Suspend(1)`, the poll-wait reason) and re-checks after\n    // every resume, so whoever holds the future decides when it completes by\n    // calling Future::resolve on it. Creating one is pure -- it is an empty\n    // cell, not an operation -- and only AWAITING it carries `Async`.\n    Some(CtFn(async_no_params(), CtNamed(\"Future\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Future::resolve\" {\n    // Future::resolve: (Future[T], T) -> Unit   (completes a pending future in\n    // place, so every awaiter of THAT future observes it)\n    Some(CtFn([\n      CtNamed(\"Future\", [\n        CtUnknown\n      ]),\n      CtUnknown\n    ], CtUnit, None))\n  } else {\n    None\n  }\n}\n\n/// Stream[T] — a pull-based async iterator (WASI 0.3 stream<T>), the async\n/// sibling of Iterator (ADR-0044): the same combinator shape (map/filter/fold)\n/// as the sync Iterator, but `next` yields a Future and `fold` is Async.\nfn lookup_stream(name: String) -> Option[Type] {\n  if name == \"Stream::empty\" {\n    // Stream::empty: () -> Stream[T]   (pure)\n    Some(CtFn(async_no_params(), CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::once\" {\n    // Stream::once: (T) -> Stream[T]   (pure; single-element stream)\n    Some(CtFn([\n      CtUnknown\n    ], CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::next\" {\n    // Stream::next: (Stream[T]) -> Future[Option[T]] with { Async }\n    // None terminates the stream.\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ])\n    ], CtNamed(\"Future\", [\n      CtOption(CtUnknown)\n    ]), Some(\"Async\")))\n  } else if name == \"Stream::map\" {\n    // Stream::map: (Stream[T], (T) -> U) -> Stream[U]   (lazy)\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ]),\n      CtUnknown\n    ], CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::filter\" {\n    // Stream::filter: (Stream[T], (T) -> Bool) -> Stream[T]   (lazy)\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ]),\n      CtUnknown\n    ], CtNamed(\"Stream\", [\n      CtUnknown\n    ]), None))\n  } else if name == \"Stream::fold\" {\n    // Stream::fold: (Stream[T], A, (A, T) -> A) -> Future[A] with { Async }\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtUnknown\n      ]),\n      CtUnknown,\n      CtUnknown\n    ], CtNamed(\"Future\", [\n      CtUnknown\n    ]), Some(\"Async\")))\n  } else {\n    None\n  }\n}\n\n/// `Task[T]` (the M-conc-1 eager prototype: `Task::spawn`/`join`/`cancel`/\n/// `race`/`timeout`) was RETIRED in #1227. It compiled `spawn` to an immediate\n/// `call_indirect` of the thunk, so `spawn(f); spawn(g)` always finished `f`\n/// before starting `g` -- concurrency that silently serialized, with `join` as\n/// identity and `cancel` a no-op. Its only callers in this repo were two\n/// coverage probes; nothing used it to actually run work concurrently.\n///\n/// The working surface is `@vibex/concurrent`: `TaskGroup::spawn_suspend` for a\n/// suspendable task, `TaskHandle::join`, and `sleep_wait` (#1253) for a sleep\n/// that overlaps instead of blocking. Real subtask spawn over waitable-set /\n/// `future.cancel-*` remains M-conc-2 (ADR-0068, spec §2.5).\nfn lookup_concurrency(name: String) -> Option[Type] {\n  let _ = name\n  None\n}\n\n/// ByteStream = Stream[Int] — WASI 0.3 stream<u8> / HTTP body bridge (M2c).\n/// `String::to_bytes` exposes a String's bytes as a ByteStream so request/response\n/// bodies can be consumed with the Stream combinators (map/filter/fold/next). It\n/// is pure & eager on the linear backend (the bytes are already in memory).\nfn lookup_bytestream(name: String) -> Option[Type] {\n  if name == \"String::to_bytes\" {\n    // String::to_bytes: (String) -> Stream[Int]   (ByteStream)\n    Some(CtFn([\n      CtString\n    ], CtNamed(\"Stream\", [\n      CtInt\n    ]), None))\n  } else if name == \"Stream::to_string\" {\n    // Stream::to_string: (Stream[Int]) -> String   (ByteStream -> String;\n    // collect a byte stream into a response body)\n    Some(CtFn([\n      CtNamed(\"Stream\", [\n        CtInt\n      ])\n    ], CtString, None))\n  } else {\n    None\n  }\n}\n\nexport fn lookup_async(name: String) -> Option[Type] {\n  match lookup_future(name) {\n    Some(t) => Some(t),\n    None => match lookup_stream(name) {\n      Some(t) => Some(t),\n      None => match lookup_concurrency(name) {\n        Some(t) => Some(t),\n        None => lookup_bytestream(name)\n      }\n    }\n  }\n}\n")
}

let cli_adapter_source_49 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_resolve.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Type, TypeDef, TypeExpr, find_typedef, resolve_builtin\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# Functions\n\n/// Substitute a parameterized type alias's formal params with actual type args.\n/// The alias body was resolved with its params as free `CtNamed(<param>, _)`\n/// names; replace each by the corresponding actual argument (recursively).\nexport fn subst_type_params(ty: Type, params: Array[String], args: Array[Type]) -> Type {\n  match ty {\n    CtNamed(name, targs) => {\n      let mut idx = 0 - 1\n      let mut i = 0\n      while i < Array::length(params) {\n        if Array::get(params, i) == name {\n          idx = i\n        }\n        i = i + 1\n      }\n      if idx >= 0 && idx < Array::length(args) {\n        Array::get(args, idx)\n      } else {\n        CtNamed(name, for a in targs {\n          subst_type_params(a, params, args)\n        })\n      }\n    },\n    CtArray(e) => CtArray(subst_type_params(e, params, args)),\n    CtOption(e) => CtOption(subst_type_params(e, params, args)),\n    CtTuple(es) => CtTuple(for e in es {\n      subst_type_params(e, params, args)\n    }),\n    CtFn(ps, ret, eff) => {\n      let subst_params: (Array[Type]) -> Array[Type] = (types) -> {\n        let out = array_empty()\n        let mut i = 0\n        while i < Array::length(types) {\n          Array::push(out, subst_type_params(Array::get(types, i), params, args))\n          i = i + 1\n        }\n        out\n      }\n      CtFn(subst_params(ps), subst_type_params(ret, params, args), eff)\n    },\n    _ => ty\n  }\n}\n\nexport fn resolve_type_expr(te: TypeExpr, defs: Array[TypeDef]) -> Type {\n  match te {\n    TyUnit => CtUnit,\n    TyName(name) => match resolve_builtin(name) {\n      Some(t) => t,\n      None => match find_typedef(defs, name) {\n        Some(td) => match td {\n          TDEnum(n, _, _) => CtEnum(n),\n          TDStruct(n, _, _, _) => CtStruct(n),\n          TDAlias(_, _, t) => t,\n          TDEffect(_, _) => CtNamed(name, array_empty())\n        },\n        None => CtNamed(name, array_empty())\n      }\n    },\n    TyApp(name, args) => {\n      let ra = for a in args {\n        resolve_type_expr(a, defs)\n      }\n      if name == \"Array\" {\n        if Array::length(ra) == 1 {\n          CtArray(Array::get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else if name == \"Option\" {\n        if Array::length(ra) == 1 {\n          CtOption(Array::get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else {\n        // Expand a parameterized type alias `Foo[A] = Body` applied as `Foo[X]`\n        // by substituting its formal params; otherwise it stays nominal.\n        match find_typedef(defs, name) {\n          Some(td) => match td {\n            TDAlias(_, params, body) => subst_type_params(body, params, ra),\n            _ => CtNamed(name, ra)\n          },\n          None => CtNamed(name, ra)\n        }\n      }\n    },\n    TyTuple(elems) => {\n      let r = for e in elems {\n        resolve_type_expr(e, defs)\n      }\n      CtTuple(r)\n    },\n    TyFn(params, ret, effect_name) => {\n      let ret_box = Array::slice([\n        ret\n      ], 0, 1)\n      let rp = for p in params {\n        resolve_type_expr(p, defs)\n      }\n      CtFn(rp, resolve_type_expr(Array::get(ret_box, 0), defs), effect_name)\n    }\n  }\n}\n")
}

let cli_adapter_source_50 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_pattern.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Pat, Type, TypeDef, TypeEnv, env_bind, env_lookup\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport ./checker_trait.vibe {\n  send_subst_vars\n}\n\n//# Functions\n\nfn find_ctor_in_defs(defs: Array[TypeDef], ctor_name: String) -> Option[(String, Array[Type])] {\n  let dlen = Array::length(defs)\n  let rec go_defs: (Int) -> Option[(String, Array[Type])] = (di) -> {\n    if di >= dlen {\n      None\n    } else {\n      let d = Array::get(defs, di)\n      match d {\n        TDEnum(enum_name, _, variants) => {\n          let vlen = Array::length(variants)\n          let rec go_variants: (Int) -> Option[(String, Array[Type])] = (vi) -> {\n            if vi >= vlen {\n              go_defs(di + 1)\n            } else {\n              let (vname, vtypes) = Array::get(variants, vi)\n              if vname == ctor_name {\n                Some((enum_name, vtypes))\n              } else {\n                go_variants(vi + 1)\n              }\n            }\n          }\n          go_variants(0)\n        },\n        _ => go_defs(di + 1)\n      }\n    }\n  }\n  go_defs(0)\n}\n\n/// True if `pat` binds at least one variable, at any nesting depth (through\n/// PCtor/PTuple/PStruct/POr).\nfn pat_binds_any(pat: Pat) -> Bool {\n  match pat {\n    PBind(_) => true,\n    PCtor(_, pats) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(pats) {\n        if pat_binds_any(Array::get(pats, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(pats) {\n        if pat_binds_any(Array::get(pats, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    POr(a, b) => pat_binds_any(a) || pat_binds_any(b),\n    PStruct(_, fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fpat) = Array::get(fields, i)\n        if pat_binds_any(fpat) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    _ => false\n  }\n}\n\n/// #951: codegen's or-pattern lowering (`emit_or_check` in\n/// codegen/expr/compile_match.vibe) only emits the tag/literal DISCRIMINATION\n/// test for an or-pattern (`A(v) | B(v) => ..`); it never emits a binding\n/// EXTRACTION for either branch, since which branch actually matched is not\n/// known at the point the arm body binds its locals. A binding or-pattern\n/// (even one where both branches use the same name/type, e.g. `A(v) | B(v)`)\n/// therefore passes `check_pattern` below — which only walks the LEFT branch —\n/// and then crashes codegen with an unlocated \"undefined variable\" internal\n/// error when the arm body reads the binding. Detect ANY or-pattern that binds\n/// a variable in either branch, at any nesting depth, so the checker can\n/// reject it with a normal, located diagnostic instead of letting it reach\n/// codegen at all.\nexport fn pat_has_unsupported_or_binding(pat: Pat) -> Bool {\n  match pat {\n    POr(a, b) => pat_binds_any(a) || pat_binds_any(b) || pat_has_unsupported_or_binding(a) || pat_has_unsupported_or_binding(b),\n    PCtor(_, pats) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(pats) {\n        if pat_has_unsupported_or_binding(Array::get(pats, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(pats) {\n        if pat_has_unsupported_or_binding(Array::get(pats, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fpat) = Array::get(fields, i)\n        if pat_has_unsupported_or_binding(fpat) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    _ => false\n  }\n}\n\nexport fn check_pattern(pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef], errors: Array[String]) -> TypeEnv {\n  match pat {\n    PWild => env,\n    PBind(name) => env_bind(env, name, scrutinee_ty),\n    // A literal pattern can only match a scrutinee of its own type. When the\n    // scrutinee resolves to a concrete type that is NOT that literal's type\n    // (`match 5 { \"x\" => .. }`, or a nested `Some(true)` over `Option[Int]`),\n    // it is a type error. Type variables / unknown / named (generic) scrutinees\n    // are tolerated.\n    PInt(_) => {\n      match scrutinee_ty {\n        CtInt => (),\n        // Char is a transparent alias of Int (char literals lex to TInt), so an\n        // integer/char literal pattern matches a Char scrutinee too (char_test).\n        CtChar => (),\n        CtVar(_) => (),\n        CtUnknown => (),\n        CtNamed(_, _) => (),\n        _ => Array::push(errors, \"integer literal pattern cannot match a non-Int scrutinee\")\n      }\n      env\n    },\n    PFloat(_) => {\n      match scrutinee_ty {\n        CtDouble => (),\n        CtVar(_) => (),\n        CtUnknown => (),\n        CtNamed(_, _) => (),\n        _ => Array::push(errors, \"float literal pattern cannot match a non-Double scrutinee\")\n      }\n      env\n    },\n    PString(_) => {\n      match scrutinee_ty {\n        CtString => (),\n        CtVar(_) => (),\n        CtUnknown => (),\n        CtNamed(_, _) => (),\n        _ => Array::push(errors, \"string literal pattern cannot match a non-String scrutinee\")\n      }\n      env\n    },\n    PBool(_) => {\n      match scrutinee_ty {\n        CtBool => (),\n        CtVar(_) => (),\n        CtUnknown => (),\n        CtNamed(_, _) => (),\n        _ => Array::push(errors, \"boolean literal pattern cannot match a non-Bool scrutinee\")\n      }\n      env\n    },\n    PCtor(name, sub_pats) => {\n      let builtin_payload = match scrutinee_ty {\n        CtOption(elem) => if name == \"Some\" {\n          Some([\n            elem\n          ])\n        } else if name == \"None\" {\n          Some(array_empty())\n        } else {\n          None\n        },\n        _ => None\n      }\n      let ctor_payload = match builtin_payload {\n        Some(types) => Some((\"Option\", types)),\n        None => find_ctor_in_defs(defs, name)\n      }\n      match ctor_payload {\n        Some(info) => {\n          let (enum_name, raw_payload) = info\n          // Instantiate the variant's field types for a parameterized enum:\n          // substitute the enum's formal params with the scrutinee's actual\n          // type args (e.g. matching `Ok(inner)` on `Result[Result[T,E], E]`\n          // types `inner` as `Result[T,E]`, not the bare enum param).\n          //\n          // #1081 step 3 Phase B investigation: `raw_payload` (from\n          // `find_ctor_in_defs`/`defs`'s `TDEnum`) is NOT name-parameterized\n          // -- `checker_stmt.vibe`'s `SEnum` processing already substitutes\n          // the enum's declared param NAMES with FRESH, fixed declaration-\n          // time `CtVar` ids before storing a variant's field types (see its\n          // `param_var_types`/`resolved_variants`). A name-based\n          // `subst_type_params(pt, eparams_names, sargs)` against that\n          // already-var-id-substituted payload can never match anything (no\n          // `CtNamed(paramname, [])` node survives that first substitution),\n          // so it silently no-ops -- `Ok(a)` on a generic `Result[Int,\n          // String]` bound `a` to the enum's raw, disconnected declaration-\n          // time var instead of `Int` for every parameterized enum ctor\n          // (reproduces with a plain `enum Result[T,E]{Ok(T);Err(E)}`,\n          // nothing region- or Sender-specific -- found chasing why a\n          // same-region `Sender` capture through `Channel::bounded`'s\n          // `Ok((s,rx))` pattern lost `s`'s type entirely).\n          //\n          // The fix mirrors `checker_trait.vibe`'s `send_ok_named` (the\n          // `Send` judgment's generic-enum case), which already solves this\n          // correctly for that other consumer: recover the SAME fixed var\n          // ids via the constructor's own `env`-bound scheme --\n          // `CtForAll(param_var_ids, _, CtFn(payload_types_with_var_ids,\n          // ret, _))` -- and substitute THOSE ids (not names) with the\n          // scrutinee's actual type args.\n          let payload_types = match scrutinee_ty {\n            CtNamed(_, sargs) => if Array::length(sargs) > 0 {\n              match env_lookup(env, name) {\n                Some(scheme) => match scheme {\n                  CtForAll(param_var_ids, _, inner) => if Array::length(param_var_ids) == Array::length(sargs) {\n                    match inner {\n                      CtFn(fn_payload_tys, _, _) => for pt in fn_payload_tys {\n                        send_subst_vars(pt, param_var_ids, sargs)\n                      },\n                      _ => raw_payload\n                    }\n                  } else {\n                    raw_payload\n                  },\n                  _ => raw_payload\n                },\n                None => raw_payload\n              }\n            } else {\n              raw_payload\n            },\n            _ => raw_payload\n          }\n          let splen = Array::length(sub_pats)\n          let ptlen = Array::length(payload_types)\n          // A constructor pattern can only match a value whose type is the\n          // corresponding enum (or builtin Option). A concrete NON-enum type —\n          // a scalar (`match 5 { Red => .. }`), a function (`match N { N(a) =>\n          // .. }` where the bare ctor `N` is the `(Int) -> E` partial\n          // application), an Array or a Tuple — can never be that enum.\n          // Type vars / unknown / named / enum / option scrutinees are tolerated.\n          let non_enum_scrutinee = match scrutinee_ty {\n            CtInt => true,\n            CtDouble => true,\n            CtBool => true,\n            CtString => true,\n            CtChar => true,\n            CtUnit => true,\n            CtBytes => true,\n            CtFn(_, _, _) => true,\n            CtArray(_) => true,\n            CtTuple(_) => true,\n            _ => false\n          }\n          if non_enum_scrutinee {\n            Array::push(errors, String::concat(\"constructor pattern `\", String::concat(name, String::concat(\"` (of \", String::concat(enum_name, \") cannot match this scrutinee type\")))))\n          } else {\n            ()\n          }\n          // The pattern must bind exactly the variant's payload arity —\n          // `Pair(a)` for `Pair(Int, Int)` binds a garbage/oob 2nd field, and\n          // binding MORE than exists is likewise wrong. Skip the builtin\n          // `Option` (its `None` carries a synthetic 1-element payload).\n          if enum_name != \"Option\" && splen != ptlen {\n            Array::push(errors, String::concat(\"constructor pattern `\", String::concat(name, String::concat(\"` expects \", String::concat(__to_string(ptlen), String::concat(\" field(s) but binds \", __to_string(splen)))))))\n          } else {\n            ()\n          }\n          let rec bind_subs: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= splen {\n              acc_env\n            } else {\n              let sub_ty = if i < ptlen {\n                Array::get(payload_types, i)\n              } else {\n                CtUnknown\n              }\n              let next_env = check_pattern(Array::get(sub_pats, i), sub_ty, acc_env, defs, errors)\n              bind_subs(i + 1, next_env)\n            }\n          }\n          bind_subs(0, env)\n        },\n        None => {\n          let splen = Array::length(sub_pats)\n          let rec bind_unknown: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= splen {\n              acc_env\n            } else {\n              let next_env = check_pattern(Array::get(sub_pats, i), CtUnknown, acc_env, defs, errors)\n              bind_unknown(i + 1, next_env)\n            }\n          }\n          bind_unknown(0, env)\n        }\n      }\n    },\n    PTuple(pats) => {\n      let plen = Array::length(pats)\n      match scrutinee_ty {\n        CtTuple(elem_tys) => {\n          let elen = Array::length(elem_tys)\n          // A tuple pattern must bind exactly the scrutinee tuple's arity —\n          // `let (a, b, c) = (1, 2)` was accepted and would read past the\n          // tuple (binding `c` to garbage). Tuples have a fixed, fully known\n          // arity, so this is always a real error.\n          if plen != elen {\n            Array::push(errors, String::concat(\"tuple pattern binds \", String::concat(__to_string(plen), String::concat(\" elements but the value is a \", String::concat(__to_string(elen), \"-tuple\")))))\n          } else {\n            ()\n          }\n          let rec bind_tuple: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= plen {\n              acc_env\n            } else {\n              let et = if i < elen {\n                Array::get(elem_tys, i)\n              } else {\n                CtUnknown\n              }\n              let next_env = check_pattern(Array::get(pats, i), et, acc_env, defs, errors)\n              bind_tuple(i + 1, next_env)\n            }\n          }\n          bind_tuple(0, env)\n        },\n        _ => {\n          // A tuple pattern can only match a tuple value. `let (a, b) = 5`\n          // (desugared to `match 5 { (a, b) => .. }`) was accepted and bound\n          // `a`/`b` to garbage. When the scrutinee resolves to a concrete\n          // NON-tuple type (a scalar, array, option, fn, struct, enum), this is\n          // a real error. Type vars / unknown / named (generic) scrutinees stay\n          // tolerated.\n          let concrete_non_tuple = match scrutinee_ty {\n            CtInt => true,\n            CtDouble => true,\n            CtBool => true,\n            CtString => true,\n            CtChar => true,\n            CtUnit => true,\n            CtBytes => true,\n            CtArray(_) => true,\n            CtOption(_) => true,\n            CtFn(_, _, _) => true,\n            CtStruct(_) => true,\n            CtEnum(_) => true,\n            _ => false\n          }\n          if concrete_non_tuple {\n            Array::push(errors, String::concat(\"tuple pattern binds \", String::concat(__to_string(plen), \" elements but the value is not a tuple\")))\n          } else {\n            ()\n          }\n          let rec bind_unk: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= plen {\n              acc_env\n            } else {\n              let next_env = check_pattern(Array::get(pats, i), CtUnknown, acc_env, defs, errors)\n              bind_unk(i + 1, next_env)\n            }\n          }\n          bind_unk(0, env)\n        }\n      }\n    },\n    POr(left, _right) => check_pattern(left, scrutinee_ty, env, defs, errors),\n    PStruct(_, fields) => {\n      let flen = Array::length(fields)\n      let rec bind_fields: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n        if i >= flen {\n          acc_env\n        } else {\n          let (_, fpat) = Array::get(fields, i)\n          let next_env = check_pattern(fpat, CtUnknown, acc_env, defs, errors)\n          bind_fields(i + 1, next_env)\n        }\n      }\n      bind_fields(0, env)\n    }\n  }\n}\n")
}

let cli_adapter_source_51 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_exhaustive.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Pat, Type, TypeDef, find_typedef\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport ./checker_resolve.vibe {\n  subst_type_params\n}\n\n//# Functions\n\n// #940 Phase 2: Maranget-style usefulness check for NESTED match\n// exhaustiveness. Phase 1 (checker.vibe) only covers the FLAT ctor layer\n// (user enums, builtin Option, Bool); nested tuples, ctor payloads and\n// literal patterns compiled clean and trapped on codegen's terminal\n// `unreachable`. This module answers one question: is the all-wildcard row\n// USEFUL w.r.t. the pattern matrix built from the match arms? If it is,\n// the match is non-exhaustive and a concrete uncovered witness pattern is\n// reconstructed for the diagnostic.\n//\n// Deliberate conservatisms (accept = stay silent), all to avoid false\n// positives on the compiler's own ~3,400 match sites:\n//   - ground gate: only a fully concrete scrutinee type is checked\n//     (type vars / unresolved named params are tolerated);\n//   - open scalars (Int / Char / String / Double): literals alone never\n//     count as covering — but a column full of wildcards is fine;\n//   - opaque columns (structs, arrays, fns, unknown): only accepted head\n//     patterns are irrefutable ones; any refutable head makes the whole\n//     check abstain;\n//   - budget cap: the recursion pays rows*cols per call from a fixed\n//     budget; running out silently accepts (no witness).\n\n/// #799/perf: these used to build a throwaway one-element array literal and\n/// immediately `Array::slice(..., 0, 0)` it away -- two heap allocations\n/// (the literal, then the slice's own cap-8 copy) to produce an empty\n/// array. `ArrayBuilder::new()` (frozen with the zero-cost `identity`\n/// codegen, checker.vibe #938) is the SAME runtime representation with one\n/// allocation. exh_find recurses per matrix cell (rows*cols budgeted calls),\n/// so these are on the hottest path in the module.\nfn exh_empty_pats() -> Array[Pat] {\n  array_empty()\n}\n\nfn exh_empty_strs() -> Array[String] {\n  array_empty()\n}\n\nfn exh_empty_tys() -> Array[Type] {\n  array_empty()\n}\n\nfn exh_empty_ctors() -> Array[(String, Array[Type], Int)] {\n  array_empty()\n}\n\nfn exh_empty_rows() -> Array[Array[Pat]] {\n  array_empty()\n}\n\nfn exh_names_contain(names: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(names) && !found {\n    if Array::get(names, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// Top-level catch-all: `_` / a bare binding, or an or-pattern with a\n/// catch-all side.\nfn exh_pat_catchall(p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    PBind(_) => true,\n    POr(l, r) => exh_pat_catchall(l) || exh_pat_catchall(r),\n    _ => false\n  }\n}\n\n/// Wildcard HEAD for the matrix operations (matches every ctor of the column).\nfn exh_pat_is_wild(p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    PBind(_) => true,\n    _ => false\n  }\n}\n\n/// Irrefutable at every depth: matches ANY well-typed value of the column.\n/// PCtor stays refutable (a single-variant enum would be irrefutable, but\n/// abstaining is the safe direction here).\nfn exh_pat_irrefutable(p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    PBind(_) => true,\n    PTuple(subs) => {\n      let mut ok = true\n      let mut i = 0\n      while i < Array::length(subs) {\n        if !exh_pat_irrefutable(Array::get(subs, i)) {\n          ok = false\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      ok\n    },\n    PStruct(_, fields) => {\n      let mut ok = true\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        if !exh_pat_irrefutable(fp) {\n          ok = false\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      ok\n    },\n    POr(l, r) => exh_pat_irrefutable(l) || exh_pat_irrefutable(r),\n    _ => false\n  }\n}\n\n/// Or-pattern expansion: POr rows are duplicated per branch (binding\n/// or-patterns are already rejected by #951, so no binding is lost).\nfn exh_flatten_or(p: Pat, out: Array[Pat]) -> Unit {\n  match p {\n    POr(l, r) => {\n      exh_flatten_or(l, out)\n      exh_flatten_or(r, out)\n    },\n    _ => Array::push(out, p)\n  }\n}\n\nfn exh_all_ground(ts: Array[Type], defs: Array[TypeDef]) -> Bool {\n  let mut ok = true\n  let mut i = 0\n  while i < Array::length(ts) {\n    if !exh_type_ground(Array::get(ts, i), defs) {\n      ok = false\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  ok\n}\n\n/// Ground gate: no inference variable / rigid param anywhere. `CtNamed` is\n/// only accepted as a REAL instantiated generic (all args concrete) or as a\n/// bare reference that resolves to a known zero-param enum; the resolver's\n/// unresolved sentinel `CtNamed(name, [CtUnknown])` and a bare unknown name\n/// both fail the gate (see type_fully_concrete in checker.vibe, #844).\nfn exh_type_ground(t: Type, defs: Array[TypeDef]) -> Bool {\n  match t {\n    CtVar(_) => false,\n    CtUnknown => false,\n    CtForAll(_, _, _) => false,\n    CtNamed(n, args) => {\n      if Array::length(args) == 0 {\n        match find_typedef(defs, n) {\n          Some(TDEnum(_, eparams, _)) => Array::length(eparams) == 0,\n          _ => false\n        }\n      } else {\n        exh_all_ground(args, defs)\n      }\n    },\n    CtTuple(items) => exh_all_ground(items, defs),\n    CtArray(e) => exh_type_ground(e, defs),\n    CtOption(e) => exh_type_ground(e, defs),\n    CtFn(ps, r, _) => exh_all_ground(ps, defs) && exh_type_ground(r, defs),\n    _ => true\n  }\n}\n\n/// Collect the distinct CtVar ids occurring anywhere in `t` into `acc`.\nfn exh_collect_vids(t: Type, acc: Array[Int]) -> Unit {\n  match t {\n    CtVar(v) => {\n      let mut i = 0\n      let mut seen = false\n      while i < Array::length(acc) {\n        if Array::get(acc, i) == v {\n          seen = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      if seen {\n        ()\n      } else {\n        Array::push(acc, v)\n      }\n    },\n    CtTuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        exh_collect_vids(Array::get(items, i), acc)\n        i = i + 1\n      }\n    },\n    CtArray(e) => exh_collect_vids(e, acc),\n    CtOption(e) => exh_collect_vids(e, acc),\n    CtNamed(_, nargs) => {\n      let mut i = 0\n      while i < Array::length(nargs) {\n        exh_collect_vids(Array::get(nargs, i), acc)\n        i = i + 1\n      }\n    },\n    CtFn(ps, r, _) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        exh_collect_vids(Array::get(ps, i), acc)\n        i = i + 1\n      }\n      exh_collect_vids(r, acc)\n    },\n    _ => ()\n  }\n}\n\n/// Replace CtVar(vids[i]) by args[i] (positional), recursively.\nfn exh_subst_vids(t: Type, vids: Array[Int], args: Array[Type]) -> Type {\n  match t {\n    CtVar(v) => {\n      let mut idx = 0 - 1\n      let mut i = 0\n      while i < Array::length(vids) {\n        if Array::get(vids, i) == v {\n          idx = i\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      if idx >= 0 && idx < Array::length(args) {\n        Array::get(args, idx)\n      } else {\n        t\n      }\n    },\n    CtTuple(items) => {\n      let acc = exh_empty_tys()\n      let mut i = 0\n      while i < Array::length(items) {\n        Array::push(acc, exh_subst_vids(Array::get(items, i), vids, args))\n        i = i + 1\n      }\n      CtTuple(acc)\n    },\n    CtArray(e) => CtArray(exh_subst_vids(e, vids, args)),\n    CtOption(e) => CtOption(exh_subst_vids(e, vids, args)),\n    CtNamed(n, nargs) => {\n      let acc = exh_empty_tys()\n      let mut i = 0\n      while i < Array::length(nargs) {\n        Array::push(acc, exh_subst_vids(Array::get(nargs, i), vids, args))\n        i = i + 1\n      }\n      CtNamed(n, acc)\n    },\n    CtFn(ps, r, eff) => {\n      let acc = exh_empty_tys()\n      let mut i = 0\n      while i < Array::length(ps) {\n        Array::push(acc, exh_subst_vids(Array::get(ps, i), vids, args))\n        i = i + 1\n      }\n      CtFn(acc, exh_subst_vids(r, vids, args), eff)\n    },\n    _ => t\n  }\n}\n\n/// Ctor universe of a user enum column: variant payload types instantiated\n/// against the scrutinee's actual type args. A non-enum name classifies the\n/// column opaque (kind 2).\n///\n/// TDEnum stores a generic enum's payload types with the declared params\n/// ALREADY substituted to fresh `CtVar(vid)`s (checker_stmt.vibe, SEnum) —\n/// the name-based subst_type_params never fires on them. Those vids are\n/// CONSECUTIVE per declaration (vid = c + param_index), so when the payloads\n/// mention exactly `param_len` distinct vids, the sorted vids are provably\n/// the full c..c+n-1 range in declaration order and can be mapped\n/// positionally onto the scrutinee's actual args. When some param never\n/// occurs in any payload the offset is ambiguous — the CtVars are left in\n/// place and those columns abstain (opaque) downstream.\nfn exh_enum_ctors(en: String, args: Array[Type], defs: Array[TypeDef]) -> (Int, Array[(String, Array[Type], Int)]) {\n  match find_typedef(defs, en) {\n    Some(TDEnum(_, eparams, variants)) => {\n      let can_subst = Array::length(eparams) > 0 && Array::length(args) == Array::length(eparams)\n      let vids = array_empty()\n      if can_subst {\n        let mut ci = 0\n        while ci < Array::length(variants) {\n          let (_, cptys) = Array::get(variants, ci)\n          let mut cj = 0\n          while cj < Array::length(cptys) {\n            exh_collect_vids(Array::get(cptys, cj), vids)\n            cj = cj + 1\n          }\n          ci = ci + 1\n        }\n        // insertion sort (ascending) — tiny arrays\n        let mut si = 1\n        while si < Array::length(vids) {\n          let v = Array::get(vids, si)\n          let mut sj = si\n          let mut moving = true\n          while sj > 0 && moving {\n            if Array::get(vids, sj - 1) > v {\n              Array::set(vids, sj, Array::get(vids, sj - 1))\n              sj = sj - 1\n            } else {\n              moving = false\n            }\n          }\n          Array::set(vids, sj, v)\n          si = si + 1\n        }\n      } else {\n        ()\n      }\n      let vid_subst = can_subst && Array::length(vids) == Array::length(eparams)\n      let out = exh_empty_ctors()\n      let mut i = 0\n      while i < Array::length(variants) {\n        let (vn, ptys) = Array::get(variants, i)\n        let inst = if can_subst {\n          let acc = exh_empty_tys()\n          let mut j = 0\n          while j < Array::length(ptys) {\n            let named_done = subst_type_params(Array::get(ptys, j), eparams, args)\n            let vt = if vid_subst {\n              exh_subst_vids(named_done, vids, args)\n            } else {\n              named_done\n            }\n            Array::push(acc, vt)\n            j = j + 1\n          }\n          acc\n        } else {\n          ptys\n        }\n        Array::push(out, (vn, inst, 0))\n        i = i + 1\n      }\n      (0, out)\n    },\n    _ => (2, exh_empty_ctors())\n  }\n}\n\n/// Column classification.\n/// kind 0 = closed universe (ctors listed), kind 1 = open scalar\n/// (Int/Char/String/Double — literals never cover), kind 2 = opaque.\n/// Ctor entry = (name, payload types, ctor kind: 0 enum-like ctor /\n/// 1 tuple / 2 bool literal).\nfn exh_column_ctors(t: Type, defs: Array[TypeDef]) -> (Int, Array[(String, Array[Type], Int)]) {\n  match t {\n    CtBool => (0, [\n      (\"true\", exh_empty_tys(), 2),\n      (\"false\", exh_empty_tys(), 2)\n    ]),\n    CtOption(e) => (0, [\n      (\"Some\", [\n        e\n      ], 0),\n      (\"None\", exh_empty_tys(), 0)\n    ]),\n    CtTuple(items) => (0, [\n      (\"\", items, 1)\n    ]),\n    CtEnum(en) => exh_enum_ctors(en, exh_empty_tys(), defs),\n    CtNamed(en, args) => exh_enum_ctors(en, args, defs),\n    CtInt => (1, exh_empty_ctors()),\n    CtChar => (1, exh_empty_ctors()),\n    CtString => (1, exh_empty_ctors()),\n    CtDouble => (1, exh_empty_ctors()),\n    _ => (2, exh_empty_ctors())\n  }\n}\n\n/// Does this head pattern match ctor `cname` of kind `ckind`? Returns its\n/// sub-patterns when it does (wildcard heads are handled by the caller).\nfn exh_head_subpats(p: Pat, cname: String, ckind: Int) -> Option[Array[Pat]] {\n  match p {\n    PCtor(n, subs) => if ckind == 0 && n == cname {\n      Some(subs)\n    } else {\n      None\n    },\n    PTuple(subs) => if ckind == 1 {\n      Some(subs)\n    } else {\n      None\n    },\n    PBool(b) => if ckind == 2 {\n      let bn = if b {\n        \"true\"\n      } else {\n        \"false\"\n      }\n      if bn == cname {\n        Some(exh_empty_pats())\n      } else {\n        None\n      }\n    } else {\n      None\n    },\n    _ => None\n  }\n}\n\n/// Pad / truncate sub-patterns to the ctor's declared arity (arity errors are\n/// reported by check_pattern; here we just stay well-formed).\nfn exh_pad_subs(subs: Array[Pat], arity: Int) -> Array[Pat] {\n  let out = exh_empty_pats()\n  let mut i = 0\n  while i < arity {\n    if i < Array::length(subs) {\n      Array::push(out, Array::get(subs, i))\n    } else {\n      Array::push(out, PWild)\n    }\n    i = i + 1\n  }\n  out\n}\n\n/// New row = prefix pats ++ old row's columns 1.. (drop the head).\nfn exh_row_with_tail(prefix: Array[Pat], row: Array[Pat]) -> Array[Pat] {\n  let out = exh_empty_pats()\n  let mut i = 0\n  while i < Array::length(prefix) {\n    Array::push(out, Array::get(prefix, i))\n    i = i + 1\n  }\n  let mut j = 1\n  while j < Array::length(row) {\n    Array::push(out, Array::get(row, j))\n    j = j + 1\n  }\n  out\n}\n\n/// Default matrix D(P): tails of the wildcard-headed rows.\nfn exh_default_rows(xrows: Array[Array[Pat]]) -> Array[Array[Pat]] {\n  let out = exh_empty_rows()\n  let mut i = 0\n  while i < Array::length(xrows) {\n    let row = Array::get(xrows, i)\n    if exh_pat_is_wild(Array::get(row, 0)) {\n      Array::push(out, exh_row_with_tail(exh_empty_pats(), row))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n/// Tails of ALL rows (used for opaque columns whose heads are all\n/// irrefutable — every head matches, so no row is dropped).\nfn exh_tail_rows(xrows: Array[Array[Pat]]) -> Array[Array[Pat]] {\n  let out = exh_empty_rows()\n  let mut i = 0\n  while i < Array::length(xrows) {\n    Array::push(out, exh_row_with_tail(exh_empty_pats(), Array::get(xrows, i)))\n    i = i + 1\n  }\n  out\n}\n\nfn exh_prepend(head: String, rest: Array[String]) -> Array[String] {\n  let out = exh_empty_strs()\n  Array::push(out, head)\n  let mut i = 0\n  while i < Array::length(rest) {\n    Array::push(out, Array::get(rest, i))\n    i = i + 1\n  }\n  out\n}\n\nfn exh_join(parts: Array[String], sep: String) -> String {\n  let mut out = \"\"\n  let mut i = 0\n  while i < Array::length(parts) {\n    if i > 0 {\n      out = String::concat(out, sep)\n    } else {\n      ()\n    }\n    out = String::concat(out, Array::get(parts, i))\n    i = i + 1\n  }\n  out\n}\n\nfn exh_format_ctor(cname: String, ckind: Int, args: Array[String]) -> String {\n  if ckind == 1 {\n    String::concat(\"(\", String::concat(exh_join(args, \", \"), \")\"))\n  } else if Array::length(args) == 0 {\n    cname\n  } else {\n    String::concat(cname, String::concat(\"(\", String::concat(exh_join(args, \", \"), \")\")))\n  }\n}\n\nfn exh_wild_strs(arity: Int) -> Array[String] {\n  let out = exh_empty_strs()\n  let mut i = 0\n  while i < arity {\n    Array::push(out, \"_\")\n    i = i + 1\n  }\n  out\n}\n\n/// Usefulness of the all-wildcard row w.r.t. `rows` over column types `tys`.\n/// Some(witness-per-column) = an uncovered value shape exists (non-exhaustive);\n/// None = covered (or the check abstained / ran out of budget).\nfn exh_find(rows: Array[Array[Pat]], tys: Array[Type], defs: Array[TypeDef], budget: Array[Int]) -> Option[Array[String]] {\n  let ncols = Array::length(tys)\n  if ncols == 0 {\n    if Array::length(rows) == 0 {\n      Some(exh_empty_strs())\n    } else {\n      None\n    }\n  } else {\n    let cost = Array::length(rows) * ncols + 1\n    let remaining = Array::get(budget, 0)\n    if remaining < cost {\n      None\n    } else {\n      Array::set(budget, 0, remaining - cost)\n      let xrows = exh_empty_rows()\n      let mut ri = 0\n      while ri < Array::length(rows) {\n        let row = Array::get(rows, ri)\n        let heads = exh_empty_pats()\n        exh_flatten_or(Array::get(row, 0), heads)\n        let mut hi = 0\n        while hi < Array::length(heads) {\n          let pref = exh_empty_pats()\n          Array::push(pref, Array::get(heads, hi))\n          Array::push(xrows, exh_row_with_tail(pref, row))\n          hi = hi + 1\n        }\n        ri = ri + 1\n      }\n      let rest_tys = Array::slice(tys, 1, ncols)\n      let (kind, ctors) = exh_column_ctors(Array::get(tys, 0), defs)\n      if kind == 0 {\n        // Head ctor names actually used in this column.\n        let used = exh_empty_strs()\n        let mut ui = 0\n        while ui < Array::length(xrows) {\n          match Array::get(Array::get(xrows, ui), 0) {\n            PCtor(n, _) => Array::push(used, n),\n            PBool(b) => if b {\n              Array::push(used, \"true\")\n            } else {\n              Array::push(used, \"false\")\n            },\n            PTuple(_) => Array::push(used, \"\"),\n            _ => ()\n          }\n          ui = ui + 1\n        }\n        let mut complete = true\n        let mut ki = 0\n        while ki < Array::length(ctors) {\n          let (cn0, _, _) = Array::get(ctors, ki)\n          if !exh_names_contain(used, cn0) {\n            complete = false\n          } else {\n            ()\n          }\n          ki = ki + 1\n        }\n        if complete {\n          // Complete signature: specialize on every ctor; the first one with\n          // an uncovered sub-shape yields the witness.\n          let mut result: Option[Array[String]] = None\n          let mut done = false\n          let mut ci = 0\n          while ci < Array::length(ctors) && !done {\n            let (cn, ptys, ck) = Array::get(ctors, ci)\n            let arity = Array::length(ptys)\n            let srows = exh_empty_rows()\n            let mut si = 0\n            while si < Array::length(xrows) {\n              let srow = Array::get(xrows, si)\n              let head = Array::get(srow, 0)\n              if exh_pat_is_wild(head) {\n                Array::push(srows, exh_row_with_tail(exh_pad_subs(exh_empty_pats(), arity), srow))\n              } else {\n                match exh_head_subpats(head, cn, ck) {\n                  Some(subs) => Array::push(srows, exh_row_with_tail(exh_pad_subs(subs, arity), srow)),\n                  None => ()\n                }\n              }\n              si = si + 1\n            }\n            let stys = exh_empty_tys()\n            let mut ti = 0\n            while ti < arity {\n              Array::push(stys, Array::get(ptys, ti))\n              ti = ti + 1\n            }\n            let mut ti2 = 0\n            while ti2 < Array::length(rest_tys) {\n              Array::push(stys, Array::get(rest_tys, ti2))\n              ti2 = ti2 + 1\n            }\n            match exh_find(srows, stys, defs, budget) {\n              Some(w) => {\n                let args = Array::slice(w, 0, arity)\n                let restw = Array::slice(w, arity, Array::length(w))\n                result = Some(exh_prepend(exh_format_ctor(cn, ck, args), restw))\n                done = true\n              },\n              None => ()\n            }\n            ci = ci + 1\n          }\n          result\n        } else {\n          // Incomplete signature: a missing ctor is the witness head when the\n          // tails are (or become) uncovered.\n          match exh_find(exh_default_rows(xrows), rest_tys, defs, budget) {\n            Some(w) => {\n              let mut head_str = \"_\"\n              let mut found_missing = false\n              let mut mi = 0\n              while mi < Array::length(ctors) && !found_missing {\n                let (mn, mptys, mk) = Array::get(ctors, mi)\n                if !exh_names_contain(used, mn) {\n                  head_str = exh_format_ctor(mn, mk, exh_wild_strs(Array::length(mptys)))\n                  found_missing = true\n                } else {\n                  mi = mi + 1\n                }\n              }\n              Some(exh_prepend(head_str, w))\n            },\n            None => None\n          }\n        }\n      } else if kind == 1 {\n        // Open scalar: literal heads never complete the column, so only the\n        // wildcard-headed rows can cover the rest.\n        match exh_find(exh_default_rows(xrows), rest_tys, defs, budget) {\n          Some(w) => Some(exh_prepend(\"_\", w)),\n          None => None\n        }\n      } else {\n        // Opaque: safe only when every head always matches; a refutable head\n        // over a type we cannot enumerate makes the whole check abstain.\n        let mut all_irr = true\n        let mut oi = 0\n        while oi < Array::length(xrows) {\n          if !exh_pat_irrefutable(Array::get(Array::get(xrows, oi), 0)) {\n            all_irr = false\n          } else {\n            ()\n          }\n          oi = oi + 1\n        }\n        if all_irr {\n          match exh_find(exh_tail_rows(xrows), rest_tys, defs, budget) {\n            Some(w) => Some(exh_prepend(\"_\", w)),\n            None => None\n          }\n        } else {\n          None\n        }\n      }\n    }\n  }\n}\n\n/// #940 Phase 2 entry. Some(witness) = the arms do not cover every value of\n/// `scr_ty` and `witness` is one uncovered pattern; None = covered, or the\n/// check abstained (catch-all arm / non-ground scrutinee / budget).\nexport fn match_nonexhaustive_witness(scr_ty: Type, pats: Array[Pat], defs: Array[TypeDef]) -> Option[String] {\n  let mut has_catchall = false\n  let mut i = 0\n  while i < Array::length(pats) {\n    if exh_pat_catchall(Array::get(pats, i)) {\n      has_catchall = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  if has_catchall {\n    None\n  } else if !exh_type_ground(scr_ty, defs) {\n    None\n  } else {\n    let rows = exh_empty_rows()\n    let mut j = 0\n    while j < Array::length(pats) {\n      let row = exh_empty_pats()\n      Array::push(row, Array::get(pats, j))\n      Array::push(rows, row)\n      j = j + 1\n    }\n    let budget = [\n      4096\n    ]\n    match exh_find(rows, [\n      scr_ty\n    ], defs, budget) {\n      Some(w) => if Array::length(w) > 0 {\n        Some(Array::get(w, 0))\n      } else {\n        None\n      },\n      None => None\n    }\n  }\n}\n")
}

let cli_adapter_source_52 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_trait.vibe",
"//# Imports\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  Subst,\n  Type,\n  TypeDef,\n  TypeEnv,\n  TypeExpr,\n  env_lookup,\n  find_typedef,\n  impls_overlap_for,\n  subst_apply,\n  trait_defined,\n  type_implements_trait,\n  type_to_string\n}\n\nimport ./checker_resolve.vibe {\n  subst_type_params\n}\n\n//# Functions\n\nfn one_super(name: String) -> Array[String] {\n  [\n    name\n  ]\n}\n\nfn no_trait_methods() -> Array[(String, Array[TypeExpr], TypeExpr)] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn no_type_args() -> Array[Type] {\n  array_empty()\n}\n\nfn empty_strings() -> Array[String] {\n  array_empty()\n}\n\nexport fn satisfies_bound(env: TypeEnv, s: Subst, ty: Type, bound: String) -> Bool {\n  type_implements_trait(env, s, ty, bound)\n}\n\n/// ADR-0068: `Send` is a compiler-judged structural marker, not a user\n/// trait (docs/concurrency.md \"`Send` と capture safety\"). A type is Send\n/// when a value can cross a task/channel boundary as a deep-copy\n/// snapshot. Initial allowlist, conservative:\n///   Send    — Unit/Bool/Int/Double/String/Char; tuples, Option, and\n///             user structs/enums (incl. Result) whose components are all\n///             Send and which have no `mut` field.\n///   not Send — Array/Bytes (mutable interior), closures, mut-field\n///             structs, effects, unresolved vars/unknowns, and any named\n///             type without a visible definition (host resources etc.).\n/// Recursive types are handled coinductively: a recursive occurrence of a\n/// type already being checked does not fail the check on its own.\nexport fn type_send_ok(env: TypeEnv, s: Subst, defs: Array[TypeDef], ty: Type) -> Bool {\n  send_ok_rec(env, s, defs, ty, empty_strings())\n}\n\nfn send_seen_has(seen: Array[String], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(seen) {\n    if Array::get(seen, i) == name {\n      found = true\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn send_seen_with(seen: Array[String], name: String) -> Array[String] {\n  let b = ArrayBuilder::new()\n  let mut i = 0\n  while i < Array::length(seen) {\n    ArrayBuilder::push(b, Array::get(seen, i))\n    i = i + 1\n  }\n  ArrayBuilder::push(b, name)\n  ArrayBuilder::freeze(b)\n}\n\nfn send_ok_all(env: TypeEnv, s: Subst, defs: Array[TypeDef], tys: Array[Type], seen: Array[String]) -> Bool {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(tys) {\n    if not(send_ok_rec(env, s, defs, Array::get(tys, i), seen)) {\n      ok = false\n    }\n    i = i + 1\n  }\n  ok\n}\n\n/// Render the coinductive-guard key for a named type INCLUDING its type\n/// arguments (#1090 review): keying on the constructor name alone let a\n/// recursive occurrence with DIFFERENT arguments (e.g. `Loop[Array[Int]]`\n/// inside `Loop[Int]`) be treated as already-proven, skipping the check\n/// of the new arguments entirely.\nfn send_seen_key(s: Subst, name: String, targs: Array[Type]) -> String {\n  let mut key = name\n  let mut i = 0\n  while i < Array::length(targs) {\n    key = String::concat(key, String::concat(\"|\", type_to_string(subst_apply(s, Array::get(targs, i)))))\n    i = i + 1\n  }\n  key\n}\n\nfn send_ok_named(env: TypeEnv, s: Subst, defs: Array[TypeDef], name: String, targs: Array[Type], seen: Array[String]) -> Bool {\n  let key = send_seen_key(s, name, targs)\n  if send_seen_has(seen, key) {\n    true\n  } else if Array::length(seen) >= 32 {\n    // Non-regular recursion (each level instantiating a NEW key, e.g.\n    // W[T] containing W[Array[T]]) never revisits a key — cap the descent\n    // and reject conservatively instead of diverging.\n    false\n  } else {\n    match find_typedef(defs, name) {\n      Some(td) => match td {\n        TDStruct(_, fields, mut_fields, tparams) => {\n          if Array::length(mut_fields) > 0 {\n            false\n          } else if Array::length(tparams) != Array::length(targs) {\n            false\n          } else {\n            let inner = send_seen_with(seen, key)\n            let mut i = 0\n            let mut ok = true\n            while i < Array::length(fields) {\n              let (_, ft) = Array::get(fields, i)\n              let inst = subst_type_params(ft, tparams, targs)\n              if not(send_ok_rec(env, s, defs, inst, inner)) {\n                ok = false\n              }\n              i = i + 1\n            }\n            ok\n          }\n        },\n        TDEnum(_, tparams, variants) => {\n          if Array::length(tparams) != Array::length(targs) {\n            false\n          } else if Array::length(tparams) == 0 {\n            // Monomorphic enum: TDEnum payloads are stored as resolved\n            // concrete/named types — recurse directly.\n            let inner = send_seen_with(seen, key)\n            let mut vi = 0\n            let mut ok = true\n            while vi < Array::length(variants) {\n              let (_, payloads) = Array::get(variants, vi)\n              let mut pi = 0\n              while pi < Array::length(payloads) {\n                if not(send_ok_rec(env, s, defs, Array::get(payloads, pi), inner)) {\n                  ok = false\n                }\n                pi = pi + 1\n              }\n              vi = vi + 1\n            }\n            ok\n          } else {\n            // Generic enum: the SEnum handler stores payload types with the\n            // declaration's FRESH CtVar ids (not the param names), so\n            // name-based substitution cannot instantiate them. Recover the\n            // var ids from the constructor's env binding —\n            // `CtForAll(param_var_ids, _, CtFn(payloads, _))` — and\n            // substitute those ids with targs.\n            let inner = send_seen_with(seen, key)\n            let mut vi = 0\n            let mut ok = true\n            while vi < Array::length(variants) {\n              let (vname, payloads) = Array::get(variants, vi)\n              if Array::length(payloads) > 0 {\n                match env_lookup(env, vname) {\n                  Some(cty) => match cty {\n                    CtForAll(vids, _, inner_ty) => match inner_ty {\n                      CtFn(args, _, _) => {\n                        let mut pi = 0\n                        while pi < Array::length(args) {\n                          let inst = send_subst_vars(Array::get(args, pi), vids, targs)\n                          if not(send_ok_rec(env, s, defs, inst, inner)) {\n                            ok = false\n                          }\n                          pi = pi + 1\n                        }\n                      },\n                      _ => {\n                        ok = false\n                      }\n                    },\n                    _ => {\n                      ok = false\n                    }\n                  },\n                  None => {\n                    ok = false\n                  }\n                }\n              } else {\n                ()\n              }\n              vi = vi + 1\n            }\n            ok\n          }\n        },\n        TDAlias(_, params, body) => {\n          if Array::length(params) != Array::length(targs) {\n            false\n          } else {\n            send_ok_rec(env, s, defs, subst_type_params(body, params, targs), send_seen_with(seen, key))\n          }\n        },\n        TDEffect(_, _) => false\n      },\n      None => false\n    }\n  }\n}\n\n/// Substitute declaration-scoped CtVar ids (a generic enum ctor's\n/// CtForAll binder list) with concrete type arguments, positionally.\n/// Exported for checker_pattern.vibe's PCtor arm (#1081 step 3 Phase B\n/// investigation): see its call site for why pattern-matching a generic\n/// enum ctor needs THIS var-id substitution, not checker_resolve.vibe's\n/// name-based `subst_type_params`.\nexport fn send_subst_vars(ty: Type, vids: Array[Int], args: Array[Type]) -> Type {\n  match ty {\n    CtVar(v) => {\n      let mut idx = 0 - 1\n      let mut i = 0\n      while i < Array::length(vids) {\n        if Array::get(vids, i) == v {\n          idx = i\n        }\n        i = i + 1\n      }\n      if idx >= 0 && idx < Array::length(args) {\n        Array::get(args, idx)\n      } else {\n        ty\n      }\n    },\n    CtArray(e) => CtArray(send_subst_vars(e, vids, args)),\n    CtOption(e) => CtOption(send_subst_vars(e, vids, args)),\n    CtTuple(es) => CtTuple(for e in es {\n      send_subst_vars(e, vids, args)\n    }),\n    CtNamed(nm, targs) => CtNamed(nm, for a in targs {\n      send_subst_vars(a, vids, args)\n    }),\n    CtFn(ps, ret, eff) => {\n      let rp = for p in ps {\n        send_subst_vars(p, vids, args)\n      }\n      CtFn(rp, send_subst_vars(ret, vids, args), eff)\n    },\n    _ => ty\n  }\n}\n\nfn send_ok_rec(env: TypeEnv, s: Subst, defs: Array[TypeDef], ty: Type, seen: Array[String]) -> Bool {\n  match subst_apply(s, ty) {\n    CtInt => true,\n    CtDouble => true,\n    CtBool => true,\n    CtString => true,\n    CtChar => true,\n    CtUnit => true,\n    CtTuple(ts) => send_ok_all(env, s, defs, ts, seen),\n    CtOption(e) => send_ok_rec(env, s, defs, e, seen),\n    CtArray(_) => false,\n    CtBytes => false,\n    CtFn(_, _, _) => false,\n    CtEnum(name) => send_ok_named(env, s, defs, name, no_type_args(), seen),\n    CtStruct(name) => send_ok_named(env, s, defs, name, no_type_args(), seen),\n    // #906: FrozenArray[T] is a checker-only phantom-type wrapper over\n    // Array[T]'s exact same (mutable-looking, but never mutated through this\n    // type) runtime layout -- see checker.vibe's FrozenArray::* ECall\n    // branches and codegen/gc/backend_body.vibe's identity-cast aliasing.\n    // Unlike Array[T] (always rejected, CtArray(_) => false above), a\n    // FrozenArray is Send exactly when its element type is, since nothing\n    // reachable through it can mutate after capture. Must be checked before\n    // the generic CtNamed(...) fallback below, which only resolves\n    // user-defined struct/enum typedefs and would reject FrozenArray as an\n    // unknown name.\n    CtNamed(name, targs) => if name == \"FrozenArray\" && Array::length(targs) == 1 {\n      send_ok_rec(env, s, defs, Array::get(targs, 0), seen)\n    } else {\n      send_ok_named(env, s, defs, name, targs, seen)\n    },\n    CtVar(_) => false,\n    CtForAll(_, _, _) => false,\n    CtUnknown => false\n  }\n}\n\nexport fn check_bounds_satisfied(env: TypeEnv, s: Subst, ty: Type, bounds: Array[String]) -> Array[String] {\n  let result = empty_strings()\n  let len = Array::length(bounds)\n  let rec go: (Int) -> Int = (i) -> {\n    if i >= len {\n      0\n    } else {\n      let bound = Array::get(bounds, i)\n      if not(satisfies_bound(env, s, ty, bound)) {\n        Array::push(result, bound)\n      }\n      go(i + 1)\n    }\n  }\n  let _ = go(0)\n  result\n}\n\nexport fn register_builtin_traits(env: TypeEnv) -> TypeEnv {\n  let no_supers = empty_strings()\n  let eq_supers = one_super(\"Eq\")\n  let i64_type = CtNamed(\"i64\", no_type_args())\n  let u8_type = CtNamed(\"u8\", no_type_args())\n  let u16_type = CtNamed(\"u16\", no_type_args())\n  let u32_type = CtNamed(\"u32\", no_type_args())\n  let u64_type = CtNamed(\"u64\", no_type_args())\n  let i16_type = CtNamed(\"i16\", no_type_args())\n  let nm = no_trait_methods()\n  let e1 = EnvTraitDef(\"Eq\", no_supers, false, nm, env)\n  let e2 = EnvTraitDef(\"Ord\", eq_supers, false, nm, e1)\n  let e3 = EnvTraitDef(\"Add\", no_supers, false, nm, e2)\n  let e4 = EnvTraitDef(\"Sub\", no_supers, false, nm, e3)\n  let e5 = EnvTraitDef(\"Mul\", no_supers, false, nm, e4)\n  let e6 = EnvTraitDef(\"Div\", no_supers, false, nm, e5)\n  let e7 = EnvTraitImpl(\"Eq\", CtInt, e6)\n  let e8 = EnvTraitImpl(\"Eq\", CtDouble, e7)\n  let e9 = EnvTraitImpl(\"Eq\", CtString, e8)\n  let e10 = EnvTraitImpl(\"Eq\", CtBool, e9)\n  let e11 = EnvTraitImpl(\"Ord\", CtInt, e10)\n  let e12 = EnvTraitImpl(\"Ord\", CtDouble, e11)\n  let e13 = EnvTraitImpl(\"Ord\", CtString, e12)\n  let e14 = EnvTraitImpl(\"Add\", CtInt, e13)\n  let e15 = EnvTraitImpl(\"Add\", CtDouble, e14)\n  let e16 = EnvTraitImpl(\"Sub\", CtInt, e15)\n  let e17 = EnvTraitImpl(\"Sub\", CtDouble, e16)\n  let e18 = EnvTraitImpl(\"Mul\", CtInt, e17)\n  let e19 = EnvTraitImpl(\"Mul\", CtDouble, e18)\n  let e20 = EnvTraitImpl(\"Div\", CtInt, e19)\n  let e21 = EnvTraitImpl(\"Div\", CtDouble, e20)\n  let e22 = EnvTraitImpl(\"Eq\", i64_type, e21)\n  let e23 = EnvTraitImpl(\"Eq\", u8_type, e22)\n  let e24 = EnvTraitImpl(\"Eq\", u16_type, e23)\n  let e25 = EnvTraitImpl(\"Eq\", u32_type, e24)\n  let e26 = EnvTraitImpl(\"Eq\", u64_type, e25)\n  let e27 = EnvTraitImpl(\"Eq\", i16_type, e26)\n  let e28 = EnvTraitImpl(\"Ord\", i64_type, e27)\n  let e29 = EnvTraitImpl(\"Ord\", u8_type, e28)\n  let e30 = EnvTraitImpl(\"Ord\", u16_type, e29)\n  let e31 = EnvTraitImpl(\"Ord\", u32_type, e30)\n  let e32 = EnvTraitImpl(\"Ord\", u64_type, e31)\n  let e33 = EnvTraitImpl(\"Ord\", i16_type, e32)\n  let e34 = EnvTraitImpl(\"Add\", i64_type, e33)\n  let e35 = EnvTraitImpl(\"Add\", u8_type, e34)\n  let e36 = EnvTraitImpl(\"Add\", u16_type, e35)\n  let e37 = EnvTraitImpl(\"Add\", u32_type, e36)\n  let e38 = EnvTraitImpl(\"Add\", u64_type, e37)\n  let e39 = EnvTraitImpl(\"Add\", i16_type, e38)\n  let e40 = EnvTraitImpl(\"Sub\", i64_type, e39)\n  let e41 = EnvTraitImpl(\"Sub\", u8_type, e40)\n  let e42 = EnvTraitImpl(\"Sub\", u16_type, e41)\n  let e43 = EnvTraitImpl(\"Sub\", u32_type, e42)\n  let e44 = EnvTraitImpl(\"Sub\", u64_type, e43)\n  let e45 = EnvTraitImpl(\"Sub\", i16_type, e44)\n  let e46 = EnvTraitImpl(\"Mul\", i64_type, e45)\n  let e47 = EnvTraitImpl(\"Mul\", u8_type, e46)\n  let e48 = EnvTraitImpl(\"Mul\", u16_type, e47)\n  let e49 = EnvTraitImpl(\"Mul\", u32_type, e48)\n  let e50 = EnvTraitImpl(\"Mul\", u64_type, e49)\n  let e51 = EnvTraitImpl(\"Mul\", i16_type, e50)\n  let e52 = EnvTraitImpl(\"Div\", i64_type, e51)\n  let e53 = EnvTraitImpl(\"Div\", u8_type, e52)\n  let e54 = EnvTraitImpl(\"Div\", u16_type, e53)\n  let e55 = EnvTraitImpl(\"Div\", u32_type, e54)\n  let e56 = EnvTraitImpl(\"Div\", u64_type, e55)\n  let e57 = EnvTraitImpl(\"Div\", i16_type, e56)\n  // ADR-0068 `Send`: register the trait def (so `[T: Send]` bounds are\n  // known) plus nominal impls for the sendable primitives, which keeps\n  // the non-structural resolution paths (generic-impl bounds, UFCS\n  // helpers) working for primitive instantiations. Composite structural\n  // judgment lives in type_send_ok; user `impl Send` is rejected in the\n  // SImpl handler.\n  let e58 = EnvTraitDef(\"Send\", no_supers, false, nm, e57)\n  let e59 = EnvTraitImpl(\"Send\", CtInt, e58)\n  let e60 = EnvTraitImpl(\"Send\", CtDouble, e59)\n  let e61 = EnvTraitImpl(\"Send\", CtString, e60)\n  let e62 = EnvTraitImpl(\"Send\", CtBool, e61)\n  let e63 = EnvTraitImpl(\"Send\", CtUnit, e62)\n  let e64 = EnvTraitImpl(\"Send\", CtChar, e63)\n  e64\n}\n\nexport fn validate_supers_defined(env: TypeEnv, supers: Array[String]) -> Array[String] {\n  let result = empty_strings()\n  let len = Array::length(supers)\n  let rec go: (Int) -> Int = (i) -> {\n    if i >= len {\n      0\n    } else {\n      let name = Array::get(supers, i)\n      if not(trait_defined(env, name)) {\n        Array::push(result, name)\n      }\n      go(i + 1)\n    }\n  }\n  let _ = go(0)\n  result\n}\n\nexport fn validate_impl_no_overlap(env: TypeEnv, trait_name: String, target: Type) -> Bool {\n  not(impls_overlap_for(env, trait_name, target))\n}\n")
}

let cli_adapter_source_53 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_spawnable.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, Subst, Type, TypeDef, TypeEnv, env_lookup, subst_apply, type_to_string\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport ./checker_trait.vibe {\n  type_send_ok\n}\n\n//# Functions\n\n// #1081 step 3 Phase B: `Spawnable[r]` capture check for `TaskGroup::spawn` /\n// `TaskGroup::spawn_suspend`. Free-variable collection duplicated here\n// (rather than shared with checker_capture.vibe or codegen's own copy) —\n// this package cannot import the root `@vibe/compiler` package (it is\n// itself a dependency of the root package; importing back would be a\n// package cycle), and codegen's copy lives in yet another separate\n// package for its own ABI purpose. Per-package duplication of this exact\n// analysis is already the established pattern in this codebase (compare\n// codegen/common_analysis/common_analysis.vibe's `collect_free_vars_expr`).\n\nfn sp_empty_strings() -> Array[String] {\n  array_empty()\n}\n\nfn sp_array_contains_str(arr: Array[String], v: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == v {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn sp_add_unique(arr: Array[String], v: String) -> Unit {\n  if sp_array_contains_str(arr, v) {\n    ()\n  } else {\n    Array::push(arr, v)\n  }\n}\n\nfn sp_append_all(dst: Array[String], src: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\nfn sp_clone_strings(items: Array[String]) -> Array[String] {\n  let out = sp_empty_strings()\n  sp_append_all(out, items)\n  out\n}\n\nfn sp_bound_with(bound: Array[String], extras: Array[String]) -> Array[String] {\n  let out = sp_clone_strings(bound)\n  sp_append_all(out, extras)\n  out\n}\n\nfn sp_bound_with_one(bound: Array[String], name: String) -> Array[String] {\n  let out = sp_clone_strings(bound)\n  Array::push(out, name)\n  out\n}\n\nfn sp_collect_pat_bindings(pat: Pat, out: Array[String]) -> Unit {\n  match pat {\n    PBind(name) => Array::push(out, name),\n    PCtor(_, pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        sp_collect_pat_bindings(Array::get(pats, i), out)\n        i = i + 1\n      }\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        sp_collect_pat_bindings(Array::get(pats, i), out)\n        i = i + 1\n      }\n    },\n    POr(a, b) => {\n      sp_collect_pat_bindings(a, out)\n      sp_collect_pat_bindings(b, out)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fpat) = Array::get(fields, i)\n        sp_collect_pat_bindings(fpat, out)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\n/// Free variables of `expr`, given the names already `bound` by enclosing\n/// closure params / lets / match arms. A call's CALLEE, when it is a bare\n/// identifier, is NOT counted as a capture: it is either a compiler\n/// builtin (`Array::set`), a top-level function (`helper()`), or a\n/// constructor (`Some(x)`) -- none of these need an environment slot\n/// captured at runtime. This intentionally also excludes a directly-called\n/// LOCAL closure variable (`let cb = ...; TaskGroup::spawn(n, () -> {\n/// cb() })`) from capture analysis -- a documented, accepted gap (this\n/// checker has no indirect-call capture analysis yet), matching the\n/// project's existing precedent for this class of limitation (see\n/// TaskGroup::run's alias-bypass gap, checker.vibe). A callee that is NOT a\n/// bare identifier (`EDot` receiver, `ECall` result, ...) is walked\n/// normally -- `sender.send_wait(v)` still captures `sender` via the EDot\n/// arm below.\nfn sp_collect_free_vars(expr: Expr, bound: Array[String]) -> Array[String] {\n  let result = sp_empty_strings()\n  match expr {\n    EIdent(name, _) => {\n      if sp_array_contains_str(bound, name) {\n        ()\n      } else {\n        sp_add_unique(result, name)\n      }\n      result\n    },\n    EInt(_) => result,\n    EFloat(_) => result,\n    EString(_) => result,\n    EBool(_) => result,\n    EUnit => result,\n    ELet(name, val, body, _) => {\n      sp_append_all(result, sp_collect_free_vars(val, bound))\n      sp_append_all(result, sp_collect_free_vars(body, sp_bound_with_one(bound, name)))\n      result\n    },\n    ELetRec(name, val, body) => {\n      let nb = sp_bound_with_one(bound, name)\n      sp_append_all(result, sp_collect_free_vars(val, nb))\n      sp_append_all(result, sp_collect_free_vars(body, nb))\n      result\n    },\n    ELetMut(name, val, body, _) => {\n      sp_append_all(result, sp_collect_free_vars(val, bound))\n      sp_append_all(result, sp_collect_free_vars(body, sp_bound_with_one(bound, name)))\n      result\n    },\n    EAssign(name, val, cont) => {\n      if sp_array_contains_str(bound, name) {\n        ()\n      } else {\n        sp_add_unique(result, name)\n      }\n      sp_append_all(result, sp_collect_free_vars(val, bound))\n      sp_append_all(result, sp_collect_free_vars(cont, bound))\n      result\n    },\n    EAssignOp(name, _, val, cont) => {\n      if sp_array_contains_str(bound, name) {\n        ()\n      } else {\n        sp_add_unique(result, name)\n      }\n      sp_append_all(result, sp_collect_free_vars(val, bound))\n      sp_append_all(result, sp_collect_free_vars(cont, bound))\n      result\n    },\n    EFn(_, _, params, _, _, body) => {\n      let pnames = sp_empty_strings()\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        Array::push(pnames, pname)\n        i = i + 1\n      }\n      sp_append_all(result, sp_collect_free_vars(body, sp_bound_with(bound, pnames)))\n      result\n    },\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(_, _) => (),\n        _ => sp_append_all(result, sp_collect_free_vars(callee, bound))\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        sp_append_all(result, sp_collect_free_vars(Array::get(args, i), bound))\n        i = i + 1\n      }\n      result\n    },\n    EIf(cond, then_e, else_e) => {\n      sp_append_all(result, sp_collect_free_vars(cond, bound))\n      sp_append_all(result, sp_collect_free_vars(then_e, bound))\n      sp_append_all(result, sp_collect_free_vars(else_e, bound))\n      result\n    },\n    ESeq(a, b) => {\n      sp_append_all(result, sp_collect_free_vars(a, bound))\n      sp_append_all(result, sp_collect_free_vars(b, bound))\n      result\n    },\n    EBinOp(_, left, right) => {\n      sp_append_all(result, sp_collect_free_vars(left, bound))\n      sp_append_all(result, sp_collect_free_vars(right, bound))\n      result\n    },\n    EUnaryOp(_, operand) => {\n      sp_append_all(result, sp_collect_free_vars(operand, bound))\n      result\n    },\n    EWhile(cond, body) => {\n      sp_append_all(result, sp_collect_free_vars(cond, bound))\n      sp_append_all(result, sp_collect_free_vars(body, bound))\n      result\n    },\n    ELoop(params, body) => {\n      let mut b2 = sp_clone_strings(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        sp_append_all(result, sp_collect_free_vars(init, b2))\n        b2 = sp_bound_with_one(b2, name)\n        i = i + 1\n      }\n      sp_append_all(result, sp_collect_free_vars(body, b2))\n      result\n    },\n    EForIn(name, index_name, iter, body) => {\n      sp_append_all(result, sp_collect_free_vars(iter, bound))\n      let b2 = sp_bound_with_one(bound, name)\n      let b3 = match index_name {\n        Some(ixn) => sp_bound_with_one(b2, ixn),\n        None => b2\n      }\n      sp_append_all(result, sp_collect_free_vars(body, b3))\n      result\n    },\n    EMatch(scrut, arms) => {\n      sp_append_all(result, sp_collect_free_vars(scrut, bound))\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, ai)\n        let pat_binds = sp_empty_strings()\n        sp_collect_pat_bindings(pat, pat_binds)\n        sp_append_all(result, sp_collect_free_vars(arm_body, sp_bound_with(bound, pat_binds)))\n        ai = ai + 1\n      }\n      result\n    },\n    EHandle(body, arms) => {\n      sp_append_all(result, sp_collect_free_vars(body, bound))\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, ai)\n        let pat_binds = sp_empty_strings()\n        sp_collect_pat_bindings(pat, pat_binds)\n        sp_append_all(result, sp_collect_free_vars(arm_body, sp_bound_with(bound, pat_binds)))\n        ai = ai + 1\n      }\n      result\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        sp_append_all(result, sp_collect_free_vars(Array::get(elems, i), bound))\n        i = i + 1\n      }\n      result\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        sp_append_all(result, sp_collect_free_vars(Array::get(elems, i), bound))\n        i = i + 1\n      }\n      result\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        sp_append_all(result, sp_collect_free_vars(fval, bound))\n        i = i + 1\n      }\n      result\n    },\n    EDot(obj, _, _, _) => {\n      sp_append_all(result, sp_collect_free_vars(obj, bound))\n      result\n    },\n    EReturn(e) => {\n      sp_append_all(result, sp_collect_free_vars(e, bound))\n      result\n    },\n    ELabeledArg(_, _, e) => {\n      sp_append_all(result, sp_collect_free_vars(e, bound))\n      result\n    },\n    EBreak(opt) => {\n      match opt {\n        Some(e) => sp_append_all(result, sp_collect_free_vars(e, bound)),\n        None => ()\n      }\n      result\n    },\n    EContinue(exprs) => {\n      let mut i = 0\n      while i < Array::length(exprs) {\n        sp_append_all(result, sp_collect_free_vars(Array::get(exprs, i), bound))\n        i = i + 1\n      }\n      result\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        sp_append_all(result, sp_collect_free_vars(fval, bound))\n        i = i + 1\n      }\n      result\n    },\n    ESpread(e) => {\n      sp_append_all(result, sp_collect_free_vars(e, bound))\n      result\n    },\n    EStringInterp(_) => result\n  }\n}\n\n/// A same-region endpoint. Two shapes both count: both sides are the SAME\n/// `CtNamed` region skolem (compared by name -- the skolem `#region_<n>` is\n/// a plain string, see checker.vibe's `type_mentions_named`); OR both sides\n/// are still the SAME unresolved `CtVar` id. The second shape is not a\n/// fallback for \"unknown, so assume equal\" -- it is REQUIRED for\n/// correctness: `TaskGroup::spawn`/`TaskGroup::spawn_suspend` are checked\n/// WHILE still inside the enclosing `TaskGroup::run` body, before that\n/// body's own closure has been unified against its `TaskGroup[r]` skolem\n/// parameter (checker.vibe's escape check runs its `unify(CtFn(body_params,\n/// ...), ...)` only AFTER the whole body is checked) -- so at spawn-check\n/// time `n`'s own region is still whatever fresh var the body's untyped\n/// closure parameter got, not yet the skolem itself. Two endpoints that\n/// share that SAME not-yet-resolved var (both zonked through the identical\n/// running Subst) are still provably the same nursery: nothing outside this\n/// one `TaskGroup::run` call could have produced or observed that var, and\n/// a DIFFERENT nursery's endpoint would carry a DIFFERENT var (its own\n/// `TaskGroup::run` call mints its own fresh closure parameter and its own\n/// skolem) or, if already resolved, a different skolem name.\nfn sp_same_region(a: Type, b: Type) -> Bool {\n  match (a, b) {\n    (CtNamed(n1, _), CtNamed(n2, _)) => n1 == n2,\n    (CtVar(v1), CtVar(v2)) => v1 == v2,\n    _ => false\n  }\n}\n\n/// A capture is Spawnable-legal when it is structurally `Send`, or when it\n/// is a `TaskGroup[r]` / `TaskHandle[r,_]` / `Sender[r,_]` / `Receiver[r,_]`\n/// tagged with THIS spawn call's own region (`r_here`) -- an endpoint from\n/// a DIFFERENT nursery is rejected exactly like any other non-Send value.\nfn sp_spawnable_ok(env: TypeEnv, s: Subst, defs: Array[TypeDef], ty: Type, r_here: Type) -> Bool {\n  if type_send_ok(env, s, defs, ty) {\n    true\n  } else {\n    match ty {\n      CtNamed(n, targs) => if n == \"TaskGroup\" && Array::length(targs) == 2 {\n        sp_same_region(Array::get(targs, 0), r_here)\n      } else if (n == \"TaskHandle\" || n == \"Sender\" || n == \"Receiver\") && Array::length(targs) == 3 {\n        sp_same_region(Array::get(targs, 0), r_here)\n      } else {\n        false\n      },\n      _ => false\n    }\n  }\n}\n\n/// Entry point: given the closure literal passed as the second argument to\n/// `TaskGroup::spawn`/`TaskGroup::spawn_suspend` and the ALREADY-ZONKED\n/// region argument of the `n: TaskGroup[r_here]` passed as the first, check\n/// every captured free variable and return one error message per violation\n/// (empty when the check passes). A non-literal closure argument (`let f =\n/// ...; TaskGroup::spawn(n, f)`) is opaque to this analysis and tolerated --\n/// same documented-gap shape as the region-escape check's alias bypass.\nexport fn check_spawnable_captures(env: TypeEnv, s: Subst, defs: Array[TypeDef], f_expr: Expr, r_here: Type) -> Array[String] {\n  match f_expr {\n    EFn(_, _, params, _, _, body) => {\n      let pnames = sp_empty_strings()\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        Array::push(pnames, pname)\n        i = i + 1\n      }\n      let free = sp_collect_free_vars(body, pnames)\n      let out = sp_empty_strings()\n      let mut fi = 0\n      while fi < Array::length(free) {\n        let vname = Array::get(free, fi)\n        match env_lookup(env, vname) {\n          Some(vty) => {\n            let resolved = subst_apply(s, vty)\n            if sp_spawnable_ok(env, s, defs, resolved, r_here) {\n              ()\n            } else {\n              Array::push(out, String::concat(\"no impl `Spawnable` for `\", String::concat(type_to_string(resolved), String::concat(\"`: capture `\", String::concat(vname, \"` is neither Send nor a same-nursery endpoint\")))))\n            }\n          },\n          // Not a real value binding in scope (shouldn't happen for a\n          // genuine capture -- e.g. a name resolved only via a builtin\n          // table or trait-method dispatch, which sp_collect_free_vars's\n          // callee-position exclusion should already keep out). Tolerate.\n          None => ()\n        }\n        fi = fi + 1\n      }\n      out\n    },\n    _ => sp_empty_strings()\n  }\n}\n\n// Codex review (PR #1150, P1): `type_send_ok` judges structural TYPE alone\n// -- `let mut counter = 0; TaskGroup::spawn(n, () -> { counter += 1; 0 })`\n// captures a `CtInt` (Send) with no record that its BINDING is mutable, so\n// `check_spawnable_captures` above accepts it even though\n// docs/concurrency.md explicitly lists \"captured `let mut`\" as never Send,\n// independent of the captured value's type -- sharing a mutable cell\n// across the spawn boundary is exactly what `Spawnable[r]` exists to\n// forbid. `TypeEnv` (core/types.vibe) carries no mutability flag at all\n// (`EnvBind(String, Type, TypeEnv)`), and `check_mut_capture`/\n// `collect_mut_bindings` (root `@vibe/compiler` package's\n// checker_capture.vibe) already exist for a mutable-capture judgment but\n// are (a) unreachable from this package (see the file-header note above)\n// and (b) never actually wired into any real check today -- exported and\n// unit-tested only. Mutability is a purely SYNTACTIC property of the\n// SOURCE, though, so no env/Subst lookup is needed at all: walk the raw\n// AST, threading the set of `let mut` names actually VISIBLE at each\n// point (below), and at every nested `TaskGroup::spawn`/`spawn_suspend`\n// call flag any free variable of that call's closure argument that is\n// still a live `let mut` name at that exact point -- independent of, and\n// in addition to, `check_spawnable_captures`'s Send/same-region judgment\n// above.\n//\n// Codex review (PR #1151, P1): the first version of this check anchored\n// on the `TaskGroup::run` call's OWN closure argument, so a `let mut\n// counter = 0` declared in the ENCLOSING function BEFORE calling\n// `TaskGroup::run` (rather than inside the run body itself) was invisible.\n// Fixed by anchoring on the WHOLE enclosing top-level declaration's body\n// instead (`check_spawnable_mut_captures_stmts` below calls\n// `check_spawnable_mut_captures_scope` once per top-level `fn`/`let`/\n// `test`/`bench`, not once per `TaskGroup::run` call).\n//\n// Codex review (PR #1152, P1): that second version collected EVERY `let\n// mut` name reachable ANYWHERE in the declaration into one flat,\n// scope-blind list (deliberately no scope-exit removal), then\n// cross-matched a spawn closure's free variables against that flat list\n// by NAME ALONE. This produced false positives: an unrelated `let mut x`\n// in a sibling closure (e.g. a separate `let helper = () -> { let mut x =\n// 0; ... }` defined later in the same top-level declaration) made every\n// OTHER, lexically-unrelated and genuinely-immutable `x` in that same\n// declaration look mutable too. Fixed below by replacing the two-pass\n// flat-collect-then-cross-match with a SINGLE recursive walker\n// (`sp_walk_spawnable_mut`) that threads a properly SCOPED `mut_names`\n// list: `ELetMut` EXTENDS it for its body; `ELet`/`ELetRec`, `EFn`\n// params, `ELoop`/`EForIn` bound names, and `EMatch`/`EHandle` arm\n// pattern bindings all REMOVE the shadowed name(s) for their own\n// body/arm (an immutable binding that merely reuses a mutable outer name\n// is not itself mutable). Each spawn call is checked against the\n// `mut_names` actually visible at that exact call site, not a flattened\n// whole-declaration set.\n//\n// Codex review (PR #1152, P2): the whole-program-pass version of this\n// check also lost the `[@off=...]` source-offset marker the ORIGINAL\n// per-call check (still visible in checker.vibe's `TaskGroup::spawn`\n// branch, for the Send/region violations) attached via\n// `off_marker_len(callee_off, ...)` -- degrading `vibe diagnostics`/LSP to\n// an unlocated error for this diagnostic class. Fixed by capturing each\n// spawn `ECall`'s own callee offset while walking (see\n// `sp_check_spawn_mut_capture` below) and appending the same marker shape\n// via a local `sp_off_marker_len` (duplicated from checker.vibe's private\n// `off_marker`/`off_marker_len` -- not exported there, and importing it\n// back across these two mutually-importing sibling files would be a\n// needless coupling for two small pure string-formatting helpers; same\n// per-file duplication convention already used above for free-variable\n// collection).\n//\n// Still-accepted gap (not attempted): a mutable binding captured by a\n// HELPER FUNCTION that itself calls `TaskGroup::spawn` -- e.g. passing\n// `counter` into a separate top-level `fn helper(c) { TaskGroup::spawn(n,\n// () -> { c += 1 }) }` -- is interprocedural (would need call-graph /\n// alias tracking across separate top-level declarations) and out of\n// scope for this purely per-declaration AST sweep.\n\nfn sp_remove_name(names: Array[String], name: String) -> Array[String] {\n  let out = sp_empty_strings()\n  let mut i = 0\n  while i < Array::length(names) {\n    let n = Array::get(names, i)\n    if n == name {\n      ()\n    } else {\n      Array::push(out, n)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn sp_remove_names(names: Array[String], to_remove: Array[String]) -> Array[String] {\n  let mut cur = names\n  let mut i = 0\n  while i < Array::length(to_remove) {\n    cur = sp_remove_name(cur, Array::get(to_remove, i))\n    i = i + 1\n  }\n  cur\n}\n\nfn sp_off_marker_len(off: Int, len: Int) -> String {\n  if off >= 0 && len > 0 {\n    String::concat(\" [@off=\", String::concat(__to_string(off), String::concat(\":\", String::concat(__to_string(off + len), \"]\"))))\n  } else if off >= 0 {\n    String::concat(\" [@off=\", String::concat(__to_string(off), \"]\"))\n  } else {\n    \"\"\n  }\n}\n\n/// Check one `TaskGroup::spawn`/`spawn_suspend` call's closure argument\n/// against the `let mut` names actually visible (properly scoped) at this\n/// exact call site, appending a located violation message per offender.\nfn sp_check_spawn_mut_capture(closure_expr: Expr, mut_names: Array[String], call_off: Int, name_len: Int, out: Array[String]) -> Unit {\n  match closure_expr {\n    EFn(_, _, params, _, _, body) => {\n      let pnames = sp_empty_strings()\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        Array::push(pnames, pname)\n        i = i + 1\n      }\n      let free = sp_collect_free_vars(body, pnames)\n      let mut fi = 0\n      while fi < Array::length(free) {\n        let vname = Array::get(free, fi)\n        if sp_array_contains_str(mut_names, vname) {\n          Array::push(out, String::concat(\"no impl `Spawnable` for a `let mut` binding: capture `\", String::concat(vname, String::concat(\"` shares a mutable cell across the spawn boundary\", sp_off_marker_len(call_off, name_len)))))\n        } else {\n          ()\n        }\n        fi = fi + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn sp_walk_spawnable_mut_binary(a: Expr, b: Expr, mut_names: Array[String], out: Array[String]) -> Unit {\n  sp_walk_spawnable_mut(a, mut_names, out)\n  sp_walk_spawnable_mut(b, mut_names, out)\n}\n\nfn sp_walk_spawnable_mut_list(items: Array[Expr], mut_names: Array[String], out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(items) {\n    sp_walk_spawnable_mut(Array::get(items, i), mut_names, out)\n    i = i + 1\n  }\n}\n\nfn sp_walk_spawnable_mut_fields(fields: Array[(String, Expr)], mut_names: Array[String], out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, fval) = Array::get(fields, i)\n    sp_walk_spawnable_mut(fval, mut_names, out)\n    i = i + 1\n  }\n}\n\n/// The combined, scope-aware walk: `mut_names` always reflects exactly the\n/// `let mut` bindings actually visible (not shadowed) at the current\n/// position -- threaded the same way `sp_collect_free_vars` threads\n/// `bound`, except `ELet`/`ELetRec`/`EFn` params/pattern bindings REMOVE a\n/// name (shadowing hides mutability) while `ELetMut` EXTENDS it.\nfn sp_walk_spawnable_mut(expr: Expr, mut_names: Array[String], out: Array[String]) -> Unit {\n  match expr {\n    ELetMut(name, val, body, _) => {\n      sp_walk_spawnable_mut(val, mut_names, out)\n      sp_walk_spawnable_mut(body, sp_bound_with_one(mut_names, name), out)\n    },\n    ELet(name, val, body, _) => {\n      sp_walk_spawnable_mut(val, mut_names, out)\n      sp_walk_spawnable_mut(body, sp_remove_name(mut_names, name), out)\n    },\n    ELetRec(name, val, body) => {\n      let nm = sp_remove_name(mut_names, name)\n      sp_walk_spawnable_mut(val, nm, out)\n      sp_walk_spawnable_mut(body, nm, out)\n    },\n    EAssign(_, val, cont) => sp_walk_spawnable_mut_binary(val, cont, mut_names, out),\n    EAssignOp(_, _, val, cont) => sp_walk_spawnable_mut_binary(val, cont, mut_names, out),\n    EFn(_, _, params, _, _, body) => {\n      let mut cur = mut_names\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        cur = sp_remove_name(cur, pname)\n        i = i + 1\n      }\n      sp_walk_spawnable_mut(body, cur, out)\n    },\n    ECall(callee, args, _) => {\n      let spawn_info = match callee {\n        EIdent(name, coff) => if (name == \"TaskGroup::spawn\" || name == \"TaskGroup::spawn_suspend\") && Array::length(args) == 2 {\n          Some((coff, String::length(name)))\n        } else {\n          None\n        },\n        _ => None\n      }\n      match spawn_info {\n        Some((coff, nlen)) => sp_check_spawn_mut_capture(Array::get(args, 1), mut_names, coff, nlen, out),\n        None => ()\n      }\n      match callee {\n        EIdent(_, _) => (),\n        _ => sp_walk_spawnable_mut(callee, mut_names, out)\n      }\n      sp_walk_spawnable_mut_list(args, mut_names, out)\n    },\n    EIf(c, t, e) => {\n      sp_walk_spawnable_mut(c, mut_names, out)\n      sp_walk_spawnable_mut_binary(t, e, mut_names, out)\n    },\n    ESeq(a, b) => sp_walk_spawnable_mut_binary(a, b, mut_names, out),\n    EBinOp(_, l, r) => sp_walk_spawnable_mut_binary(l, r, mut_names, out),\n    EUnaryOp(_, e) => sp_walk_spawnable_mut(e, mut_names, out),\n    EWhile(c, b) => sp_walk_spawnable_mut_binary(c, b, mut_names, out),\n    ELoop(params, body) => {\n      let mut cur = mut_names\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        sp_walk_spawnable_mut(init, cur, out)\n        cur = sp_remove_name(cur, name)\n        i = i + 1\n      }\n      sp_walk_spawnable_mut(body, cur, out)\n    },\n    EForIn(name, index_name, iter, body) => {\n      sp_walk_spawnable_mut(iter, mut_names, out)\n      let m2 = sp_remove_name(mut_names, name)\n      let m3 = match index_name {\n        Some(ixn) => sp_remove_name(m2, ixn),\n        None => m2\n      }\n      sp_walk_spawnable_mut(body, m3, out)\n    },\n    EMatch(scrut, arms) => {\n      sp_walk_spawnable_mut(scrut, mut_names, out)\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, ai)\n        let pat_binds = sp_empty_strings()\n        sp_collect_pat_bindings(pat, pat_binds)\n        sp_walk_spawnable_mut(arm_body, sp_remove_names(mut_names, pat_binds), out)\n        ai = ai + 1\n      }\n    },\n    EHandle(body, arms) => {\n      sp_walk_spawnable_mut(body, mut_names, out)\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, ai)\n        let pat_binds = sp_empty_strings()\n        sp_collect_pat_bindings(pat, pat_binds)\n        sp_walk_spawnable_mut(arm_body, sp_remove_names(mut_names, pat_binds), out)\n        ai = ai + 1\n      }\n    },\n    ETuple(elems) => sp_walk_spawnable_mut_list(elems, mut_names, out),\n    EArray(elems) => sp_walk_spawnable_mut_list(elems, mut_names, out),\n    ERecord(_, fields, _) => sp_walk_spawnable_mut_fields(fields, mut_names, out),\n    EDot(obj, _, _, _) => sp_walk_spawnable_mut(obj, mut_names, out),\n    EReturn(e) => sp_walk_spawnable_mut(e, mut_names, out),\n    ELabeledArg(_, _, e) => sp_walk_spawnable_mut(e, mut_names, out),\n    EBreak(opt) => match opt {\n      Some(e) => sp_walk_spawnable_mut(e, mut_names, out),\n      None => ()\n    },\n    EContinue(exprs) => sp_walk_spawnable_mut_list(exprs, mut_names, out),\n    EMap(fields) => sp_walk_spawnable_mut_fields(fields, mut_names, out),\n    ESpread(e) => sp_walk_spawnable_mut(e, mut_names, out),\n    _ => ()\n  }\n}\n\n/// Entry point (per lexical scope): walk `scope_body` once from an empty\n/// `mut_names` set, threading scope-aware `let mut` visibility per the\n/// walker above.\nfn check_spawnable_mut_captures_scope(scope_body: Expr) -> Array[String] {\n  let out = sp_empty_strings()\n  sp_walk_spawnable_mut(scope_body, sp_empty_strings(), out)\n  out\n}\n\n/// Entry point: run `check_spawnable_mut_captures_scope` once per\n/// top-level declaration with a body (function/`let`/`test`/`bench`/bare\n/// top-level expression), recursing into `SModule` blocks. Called once\n/// per program (checker_stmt.vibe's `check_program`/\n/// `check_program_with_env`), not per `TaskGroup::run`/spawn call site.\nexport fn check_spawnable_mut_captures_stmts(stmts: Array[Stmt]) -> Array[String] {\n  let out = sp_empty_strings()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, body) => sp_append_all(out, check_spawnable_mut_captures_scope(body)),\n      SLetMut(_, _, body) => sp_append_all(out, check_spawnable_mut_captures_scope(body)),\n      STest(_, body) => sp_append_all(out, check_spawnable_mut_captures_scope(body)),\n      SBench(_, body) => sp_append_all(out, check_spawnable_mut_captures_scope(body)),\n      SExpr(body) => sp_append_all(out, check_spawnable_mut_captures_scope(body)),\n      SModule(_, _, inner) => sp_append_all(out, check_spawnable_mut_captures_stmts(inner)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n")
}

let cli_adapter_source_54 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_effects.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, Type, TypeEnv, TypeExpr, env_lookup\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen {\n  canonical_builtin_name\n}\n\n// #897 (ADR-0070 Phase 3): this file was moved from\n// lib/@vibe/compiler/checker_effects.vibe into checker/ itself specifically\n// so this import stays a plain SAME-PACKAGE sibling reference. Before the\n// move it was a `#847 Phase C exception` — a deliberate direct leaf import\n// of the internal `checker/builtins.vibe` file, bypassing the (then-plain)\n// facade, because `checker/checker_stmt.vibe` imports this file and the\n// facade re-exports `checker_stmt.vibe`'s surface: routing through the\n// facade would have closed a real cycle (checker package -> checker_stmt.vibe\n// -> checker_effects.vibe -> checker package). Once checker/ became a real\n// `index.vpkg` package boundary (#729's enforce_incoming_boundary_fs), an\n// outside file could no longer reach `checker/builtins.vibe` directly at\n// all (only through the package), so the old workaround stopped compiling.\n// Moving this file INTO checker/ resolves both problems at once: this\n// import is now an ordinary directory-shared-scope sibling reference (no\n// facade indirection, so no cycle), and every OTHER consumer of this file's\n// own exports (check_effects_stmt, check_perform_effects_stmts_env, etc.)\n// now reaches them through the checker package's index.vpkg like any other\n// checker export.\nimport ./builtins.vibe {\n  lookup_builtin\n}\n\n//# Types\n\nexport enum EffectError {\n  EEEffectfulCallOutsideEffect(String);\n  EEPerformUndeclaredEffect(String, String);\n  // #639: effect-row mismatch with the EXPECTED vs ACTUAL rows rendered as a\n  // set difference plus a fix-it hint for the `with { ... }` annotation.\n  // Fields (all pre-rendered \", \"-joined label lists, deterministic order):\n  // (enclosing fn name or \"\" when unnamed, missing labels (sorted),\n  //  declared row (source order, \"\" when no row), required row (sorted union)).\n  EEEffectRowMismatch(String, String, String, String);\n  EEAssignImmutable(String)\n}\n\n//# Functions\n\n// #944 follow-up: the general `check_effects_expr`/`check_effects_stmt`/\n// `check_effects_stmts` walk (the pre-#933 `in_effect: Bool` discipline that\n// produced EEThrowOutsideEffect / EEEffectfulCallOutsideEffect for ANY\n// effectful call outside an effectful context) was retired here. It had no\n// live-pipeline caller -- `check_program` wires check_perform_effects_* (the\n// row-based discipline below, which since #944 also checks the Error row by\n// default) plus the Async-scoped check_async_effects_* pass further down --\n// and was only reachable from two unit-test harnesses, which now exercise the\n// live entry points instead. EEThrowOutsideEffect went with it (its only\n// constructor was that walk's EThrow arm, dead since #640 Stage 2 desugared\n// `throw` to `perform Error::Throw`); EEEffectfulCallOutsideEffect stays --\n// check_async_effects_expr still reports it for async primitives.\n\nexport fn effect_error_to_string(err: EffectError) -> String {\n  match err {\n    EEEffectfulCallOutsideEffect(name) => String::concat(\"effectful call outside effectful context: \", name),\n    EEPerformUndeclaredEffect(op, eff) => String::concat(\"use of undeclared effect `\", String::concat(eff, String::concat(\"` (\", String::concat(op, \"); add it to the function's `with { ... }` or wrap in a `handle`\")))),\n    // #639: expected-vs-actual effect rows as a set difference, then ONE\n    // deterministic fix-it hint line targeting the enclosing declaration\n    // (for a call-site leak that is the CALLER, not the callee).\n    EEEffectRowMismatch(fname, missing, declared, required) => {\n      let head = if String::length(fname) > 0 {\n        String::concat(\"effect row mismatch for '\", String::concat(fname, \"'\"))\n      } else {\n        \"effect row mismatch\"\n      }\n      let detail = if String::length(declared) > 0 {\n        String::concat(\" (declared with { \", String::concat(declared, String::concat(\" }, requires { \", String::concat(required, \" })\"))))\n      } else {\n        String::concat(\" (no 'with' clause, requires { \", String::concat(required, \" })\"))\n      }\n      let hint = if String::length(fname) == 0 {\n        String::concat(\"\\nhint: add 'with { \", String::concat(required, \" }' to the enclosing function\"))\n      } else if String::length(declared) == 0 {\n        String::concat(\"\\nhint: declare 'fn \", String::concat(fname, String::concat(\"(...) -> T with { \", String::concat(required, \" }'\"))))\n      } else {\n        String::concat(\"\\nhint: add 'with { \", String::concat(required, String::concat(\" }' to '\", String::concat(fname, \"'\"))))\n      }\n      String::concat(head, String::concat(\": missing { \", String::concat(missing, String::concat(\" }\", String::concat(detail, hint)))))\n    },\n    EEAssignImmutable(name) => String::concat(\"cannot assign to immutable binding `\", String::concat(name, \"` (declare it with `let mut`)\"))\n  }\n}\n\n//# Async-scoped effect enforcement (the pass wired into `check_program`)\n//\n// This pass enforces ONLY the `Async` effect, and only\n// for async PRIMITIVES — the builtins `await(..)` / `sleep(..)` / `Stream::next`\n// whose type carries `with { Async }`, including the `await(..)` the `for await`\n// desugar injects over a Future-returning iterator. A primitive must appear\n// inside a function/lambda annotated `with { Async }`.\n//\n// Crucially it does NOT propagate to user functions that merely COMPOSE async\n// work: calling a `with { Async }` helper (e.g. `async_iter_collect`) from a\n// sync context is allowed (await is the identity on the synchronous backend,\n// and on a real async backend the value/Future mismatch is a separate type\n// error). Only env-absent BUILTIN primitives are checked, so the compiler /\n// prelude — which use `Async` only in the disciplined async_iter terminals —\n// stay green while `for await` over an async stream becomes sound (#2+#3).\n\nfn effect_opt_is_async(eff: Option[String]) -> Bool {\n  match eff {\n    Some(s) => String::contains(s, \"Async\"),\n    None => false\n  }\n}\n\n/// True only for async-effect BUILTIN primitives (await/sleep/Stream::next/...).\n/// A name bound in `env` (a user/prelude function) is intentionally NOT treated\n/// as a primitive even if its type is `with { Async }`.\nfn is_async_primitive(name: String, env: TypeEnv) -> Bool {\n  match env_lookup(env, name) {\n    Some(_) => false,\n    None => {\n      let normalized = canonical_builtin_name(name)\n      match lookup_builtin(normalized) {\n        Some(ty) => match ty {\n          CtFn(_, _, eff) => effect_opt_is_async(eff),\n          _ => false\n        },\n        None => false\n      }\n    }\n  }\n}\n\nfn append_eff_errs(dst: Array[EffectError], src: Array[EffectError]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\nexport fn check_async_effects_expr(expr: Expr, env: TypeEnv, in_async: Bool) -> Array[EffectError] {\n  let errors = array_empty()\n  match expr {\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(name, _) => if !in_async && is_async_primitive(name, env) {\n          Array::push(errors, EEEffectfulCallOutsideEffect(name))\n        }\n        ,\n        _ => ()\n      }\n      append_eff_errs(errors, check_async_effects_expr(callee, env, in_async))\n      let mut ai = 0\n      while ai < Array::length(args) {\n        append_eff_errs(errors, check_async_effects_expr(Array::get(args, ai), env, in_async))\n        ai = ai + 1\n      }\n      errors\n    },\n    EFn(_, _, _, _, effect, body) => {\n      append_eff_errs(errors, check_async_effects_expr(body, env, effect_opt_is_async(effect)))\n      errors\n    },\n    EHandle(body, arms) => {\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, ai)\n        append_eff_errs(errors, check_async_effects_expr(arm_body, env, in_async))\n        ai = ai + 1\n      }\n      errors\n    },\n    ELet(_, val, body, _) => {\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\n      errors\n    },\n    ELetRec(_, val, body) => {\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\n      errors\n    },\n    ELetMut(_, val, body, _) => {\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\n      errors\n    },\n    ESeq(a, b) => {\n      append_eff_errs(errors, check_async_effects_expr(a, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(b, env, in_async))\n      errors\n    },\n    EIf(cond, then_e, else_e) => {\n      append_eff_errs(errors, check_async_effects_expr(cond, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(then_e, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(else_e, env, in_async))\n      errors\n    },\n    EMatch(scrutinee, arms) => {\n      append_eff_errs(errors, check_async_effects_expr(scrutinee, env, in_async))\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, ai)\n        append_eff_errs(errors, check_async_effects_expr(arm_body, env, in_async))\n        ai = ai + 1\n      }\n      errors\n    },\n    EWhile(cond, body) => {\n      append_eff_errs(errors, check_async_effects_expr(cond, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\n      errors\n    },\n    ELoop(params, body) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        append_eff_errs(errors, check_async_effects_expr(init, env, in_async))\n        i = i + 1\n      }\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\n      errors\n    },\n    EForIn(_, _, iter, body) => {\n      append_eff_errs(errors, check_async_effects_expr(iter, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\n      errors\n    },\n    EBinOp(_, left, right) => {\n      append_eff_errs(errors, check_async_effects_expr(left, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(right, env, in_async))\n      errors\n    },\n    EReturn(e) => check_async_effects_expr(e, env, in_async),\n    EUnaryOp(_, operand) => check_async_effects_expr(operand, env, in_async),\n    EAssign(_, val, cont) => {\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(cont, env, in_async))\n      errors\n    },\n    EAssignOp(_, _, val, cont) => {\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\n      append_eff_errs(errors, check_async_effects_expr(cont, env, in_async))\n      errors\n    },\n    EDot(obj, _, _, _) => check_async_effects_expr(obj, env, in_async),\n    ETuple(elems) => {\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        append_eff_errs(errors, check_async_effects_expr(Array::get(elems, ei), env, in_async))\n        ei = ei + 1\n      }\n      errors\n    },\n    EArray(elems) => {\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        append_eff_errs(errors, check_async_effects_expr(Array::get(elems, ei), env, in_async))\n        ei = ei + 1\n      }\n      errors\n    },\n    ERecord(_, fields, _) => {\n      let mut fi = 0\n      while fi < Array::length(fields) {\n        let (_, fval) = Array::get(fields, fi)\n        append_eff_errs(errors, check_async_effects_expr(fval, env, in_async))\n        fi = fi + 1\n      }\n      errors\n    },\n    _ => errors\n  }\n}\n\n/// A function body runs in an `{Async}` context if EITHER the lambda's inline\n/// effect OR the binding's declared signature type carries `Async`.\nfn sig_type_is_async(topt: Option[TypeExpr]) -> Bool {\n  match topt {\n    Some(TyFn(_, _, eff)) => effect_opt_is_async(eff),\n    _ => false\n  }\n}\n\nfn check_async_effects_binding(ty: Option[TypeExpr], body: Expr, env: TypeEnv) -> Array[EffectError] {\n  let sig_async = sig_type_is_async(ty)\n  match body {\n    EFn(_, _, _, _, eff, fbody) => check_async_effects_expr(fbody, env, sig_async || effect_opt_is_async(eff)),\n    _ => check_async_effects_expr(body, env, sig_async)\n  }\n}\n\nexport fn check_async_effects_stmt(stmt: Stmt, env: TypeEnv) -> Array[EffectError] {\n  match stmt {\n    SLet(_, _, _, ty, body) => check_async_effects_binding(ty, body, env),\n    SLetMut(_, ty, body) => check_async_effects_binding(ty, body, env),\n    STest(_, body) => check_async_effects_expr(body, env, false),\n    SBench(_, body) => check_async_effects_expr(body, env, false),\n    SExpr(e) => check_async_effects_expr(e, env, false),\n    _ => array_empty()\n  }\n}\n\nexport fn check_async_effects_stmts(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError] {\n  let errors = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    append_eff_errs(errors, check_async_effects_stmt(Array::get(stmts, i), env))\n    i = i + 1\n  }\n  errors\n}\n\n//# perform-discipline enforcement (#626 criterion 1)\n//\n// `perform EffName::Op(..)` may only occur where `EffName` is in scope: either\n// the enclosing function/lambda declares it in `with { ... }`, or the perform\n// is inside a `handle` (which discharges it). Otherwise it is a type error —\n// \"performing an undeclared effect\". This realizes the first acceptance\n// criterion of #626 (the checker formerly accepted undeclared performs because\n// it never resolved which effect an op belongs to).\n//\n// A `handle` is treated CONSERVATIVELY as discharging any effect for its body\n// (we do not yet read which specific effect its arms handle), so a perform\n// inside any handle is allowed — this never rejects a valid program; it only\n// declines to flag the (rarer) perform-of-a-different-effect-inside-a-handle\n// case, which full row tracking (#626 criteria 2/4) will cover.\n\n/// Split a `with { A, B }` annotation into trimmed, deduped effect labels.\nfn effect_decl_labels(eff: Option[String]) -> Array[String] {\n  let out = array_empty()\n  match eff {\n    None => out,\n    Some(s) => {\n      let raw = String::split(s, \",\")\n      let mut i = 0\n      while i < Array::length(raw) {\n        let label = String::trim(Array::get(raw, i))\n        if String::length(label) > 0 {\n          let mut seen = false\n          let mut j = 0\n          while j < Array::length(out) {\n            if Array::get(out, j) == label {\n              seen = true\n            }\n            j = j + 1\n          }\n          if !seen {\n            Array::push(out, label)\n          }\n        }\n        i = i + 1\n      }\n      out\n    }\n  }\n}\n\n/// A single lowercase letter is an effect VARIABLE (polymorphic row tail in the\n/// current representation): a function declaring `with { e }` may perform any\n/// effect, so treat such a declaration as authorizing everything.\nfn label_is_effect_var(name: String) -> Bool {\n  String::length(name) == 1 && String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122\n}\n\nfn decl_authorizes_effect(labels: Array[String], eff_name: String) -> Bool {\n  let mut i = 0\n  let mut ok = false\n  while i < Array::length(labels) {\n    let l = Array::get(labels, i)\n    if l == eff_name {\n      ok = true\n    } else if label_is_effect_var(l) {\n      ok = true\n    }\n    i = i + 1\n  }\n  ok\n}\n\n/// A DIRECT `perform EffName::Op` is authorized if the declared row names\n/// either the whole effect (`EffName`) or, per ADR-0071's operation-level row\n/// items, the exact operation (`EffName::Op`) itself -- e.g. `with { Ask::Get\n/// }` must authorize a bare `perform Ask::Get` in the same function, exactly\n/// as it already authorizes a transitive call to a callee declaring `{\n/// Ask::Get }` (that check compares the full qualified label directly,\n/// without stripping to the base effect name).\nfn decl_authorizes_op(labels: Array[String], op_name: String) -> Bool {\n  decl_authorizes_effect(labels, effect_name_of_op(op_name)) || decl_authorizes_effect(labels, op_name)\n}\n\n/// `perform EffName::Op` — the op identifier is `EffName::Op`; the effect is the\n/// segment before `::`.\nfn effect_name_of_op(op_name: String) -> String {\n  let idx = String::index_of(op_name, \"::\")\n  if idx > 0 {\n    op_name[0: idx]\n  } else {\n    op_name\n  }\n}\n\n/// #626 criterion 3 (call-site propagation, builtin slice): calling an effectful\n/// BUILTIN (e.g. `Fs::read_file`, `Env::args_len`) requires the enclosing\n/// function to declare that effect, exactly like `perform`. Returns the required\n/// effect, or None for pure builtins / non-builtins. `Error` (the 441-site throw\n/// discipline) and `Async` (composition-allowed; handled by the async pass) are\n/// deliberately excluded from this slice.\nfn builtin_call_effect(name: String) -> Option[String] {\n  // `sh`/`sh_lines` and the checker_visible `vibe_*_raw` dunder builtins\n  // (Codex review, PR #909) are the only UNQUALIFIED effectful builtins:\n  // they lower to real `vibe.*` host imports that execute shell commands or\n  // terminate the process, so calling them directly must require\n  // `{ Process }` just like a qualified builtin -- otherwise they could run\n  // from a pure function or a bare top-level expression undeclared. Every\n  // name here is checker_visible=true in builtin_registry.vibe (directly\n  // callable from source); vibe_sh_lines_raw is checker_visible=false (only\n  // synthesized internally, never typed by user source) so it needs no\n  // entry. Checked before the `::` fast path below.\n  if name == \"sh\" || name == \"sh_lines\"\n  || name == \"vibe_sh_capture_raw\"\n  || name == \"vibe_sh_capture_exit_code_raw\"\n  || name == \"vibe_sh_capture_stdout_raw\"\n  || name == \"vibe_sh_capture_stderr_raw\"\n  || name == \"vibe_sh_capture_close_raw\"\n  || name == \"vibe_process_exit_raw\" {\n    Some(\"Process\")\n  } else if String::index_of(name, \"::\") < 0 {\n    // Fast path: every OTHER effectful builtin in this slice is a QUALIFIED name\n    // (`Fs::read_file`, `Env::args_len`, `Stdin::...`, `Stdout::...`, ...), so a\n    // callee with no `::` can never be one. Skipping `lookup_builtin` for the\n    // (vastly more common) unqualified calls keeps the pass cheap enough to run\n    // over the whole compiler source within the seed's heap during self-build.\n    None\n  } else {\n    let normalized = canonical_builtin_name(name)\n    match lookup_builtin(normalized) {\n      Some(ty) => match ty {\n        CtFn(_, _, Some(eff)) => if eff == \"Error\" {\n          None\n        } else if eff == \"Async\" {\n          None\n        } else {\n          Some(eff)\n        },\n        _ => None\n      },\n      None => None\n    }\n  }\n}\n\nfn labels_union(a: Array[String], b: Array[String]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(a) {\n    Array::push(out, Array::get(a, i))\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(b) {\n    let l = Array::get(b, j)\n    let mut seen = false\n    let mut k = 0\n    while k < Array::length(out) {\n      if Array::get(out, k) == l {\n        seen = true\n      }\n      k = k + 1\n    }\n    if !seen {\n      Array::push(out, l)\n    }\n    j = j + 1\n  }\n  out\n}\n\n/// #639: deterministic label ordering for effect-row diagnostics. Char-by-char\n/// lexicographic compare, shorter-prefix-first on a tie — written out by hand\n/// (see CLAUDE.md's length-first `String <` gotcha) so `{ Env, Fs }` always\n/// renders in the same order.\nfn label_lt(a: String, b: String) -> Bool {\n  let la = String::length(a)\n  let lb = String::length(b)\n  let n = if la < lb {\n    la\n  } else {\n    lb\n  }\n  let mut i = 0\n  let mut decided = 0\n  while i < n && decided == 0 {\n    let ca = String::char_code_at(a, i)\n    let cb = String::char_code_at(b, i)\n    if ca < cb {\n      decided = 1\n    } else if ca > cb {\n      decided = 2\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  if decided == 1 {\n    true\n  } else if decided == 2 {\n    false\n  } else {\n    la < lb\n  }\n}\n\n/// Copying insertion sort (rows are tiny — a handful of labels at most).\nfn sort_labels(xs: Array[String]) -> Array[String] {\n  let out = Array::slice(xs, 0, Array::length(xs))\n  let mut i = 1\n  while i < Array::length(out) {\n    let key = Array::get(out, i)\n    let mut j = i\n    while j > 0 && label_lt(key, Array::get(out, j - 1)) {\n      Array::set(out, j, Array::get(out, j - 1))\n      j = j - 1\n    }\n    Array::set(out, j, key)\n    i = i + 1\n  }\n  out\n}\n\nfn join_labels(xs: Array[String]) -> String {\n  let mut out = \"\"\n  let mut i = 0\n  while i < Array::length(xs) {\n    if i == 0 {\n      out = Array::get(xs, i)\n    } else {\n      out = String::concat(out, String::concat(\", \", Array::get(xs, i)))\n    }\n    i = i + 1\n  }\n  out\n}\n\n/// #639: build the effect-row mismatch diagnostic for a perform/call whose\n/// required effects are absent from the enclosing declaration's row. `missing`\n/// is the set difference (callee requires minus caller declares), rendered\n/// sorted; `required` is the sorted union the fix-it hint suggests declaring.\nfn make_row_mismatch(fn_name: String, declared: Array[String], missing: Array[String]) -> EffectError {\n  let missing_sorted = sort_labels(labels_union(no_str_labels(), missing))\n  let required = sort_labels(labels_union(declared, missing))\n  EEEffectRowMismatch(fn_name, join_labels(missing_sorted), join_labels(declared), join_labels(required))\n}\n\n/// #626 criterion 2: a `handle ... with E` DISCHARGES E for its body — after\n/// handling E the body need not declare it. The parser qualifies each handler\n/// arm pattern as `E::Op`, so the discharged effect names are recoverable as the\n/// `::`-prefixes of the arm constructor patterns. Returns the distinct effects a\n/// handle discharges (empty if none could be determined — then the body stays\n/// conservatively permissive, never over-strict).\n///\n/// ADR-0071 (#755) step 4: ALSO push each arm's own fully-qualified operation\n/// name (`Ask::Get`, not just the bare `Ask` prefix). `handle ... with Ask\n/// {...}` is exhaustive over every operation of Ask (ADR-0050 -- a handler\n/// can't discharge only some operations), so discharging the bare effect\n/// name is semantically equivalent to discharging every one of its qualified\n/// operation names. But the DOWNSTREAM containment check\n/// (decl_authorizes_effect) does exact string-label matching: a handled\n/// body that transitively calls a function declaring `with { Ask::Get }`\n/// (operation-level, not the bare effect) previously reported that specific\n/// requirement as still missing even though the handle plainly covers it --\n/// \"Ask\" != \"Ask::Get\" as strings, and the discharge list only ever\n/// contained the bare form. Pushing the qualified name too is a pure\n/// widening (nothing that was authorized before stops being authorized; the\n/// bare-effect-name discharge and its blanket effect_name_of_op-based\n/// authorization inside the body are both untouched), so it only fixes this\n/// gap without changing any other observable behavior.\nfn collect_handle_effects(arms: Array[(Pat, Expr)]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (pat, _) = Array::get(arms, i)\n    match pat {\n      PCtor(name, _) => {\n        let idx = String::index_of(name, \"::\")\n        if idx > 0 {\n          let eff = name[0: idx]\n          let mut seen = false\n          let mut j = 0\n          while j < Array::length(out) {\n            if Array::get(out, j) == eff {\n              seen = true\n            }\n            j = j + 1\n          }\n          if !seen {\n            Array::push(out, eff)\n          }\n          let mut qseen = false\n          let mut k = 0\n          while k < Array::length(out) {\n            if Array::get(out, k) == name {\n              qseen = true\n            }\n            k = k + 1\n          }\n          if !qseen {\n            Array::push(out, name)\n          }\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n/// Walk an expression's effect discipline with an EXPLICIT WORK STACK instead of\n/// recursion, so the pass never exhausts the wasm call stack however deeply the\n/// compiler's own source nests (long `let`/`seq` spines AND nested\n/// if/match/call forms). Each stack item carries its (expr, declared, in_handle)\n/// context: `EFn` resets `declared` to its own effect row, `EHandle` augments it\n/// with the discharged effects (criterion 2). Order of traversal differs from a\n/// recursive pre-order walk, but the SET of effect errors found is identical, so\n/// the accept/reject decision is unchanged.\n/// The declared effect row of a top-level binding: the signature's `with { ... }`\n/// unioned with an EFn body's own effect annotation (`let f = (x) -> { .. } with\n/// { E }`). Used to build the call-graph effect map for transitive enforcement.\nfn fn_binding_effects(ty: Option[TypeExpr], body: Expr) -> Array[String] {\n  let sig = sig_type_effect_labels(ty)\n  match body {\n    EFn(_, _, _, _, eff, _) => labels_union(sig, effect_decl_labels(eff)),\n    _ => sig\n  }\n}\n\n/// Look up a called function's declared effect row by linear scan over PARALLEL\n/// arrays (names[i] <-> effs[i]). A `Map` here allocates per lookup and, across\n/// the compiler's tens of thousands of call sites, exhausts the GC-less bump heap\n/// (#626 OOM); the linear scan allocates nothing.\nfn lookup_fn_effs(names: Array[String], effs: Array[Array[String]], name: String) -> Option[Array[String]] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(names) {\n    match found {\n      None => if Array::get(names, i) == name {\n        found = Some(Array::get(effs, i))\n      } else {\n        ()\n      },\n      Some(_) => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n/// #885 review (Codex): a `let`/`let rec`/`let mut` binding can reuse the NAME\n/// of an in-scope callback-parameter overlay entry (e.g. rebinding `f` to an\n/// unrelated local pure closure). Without this, `lookup_fn_effs`'s first-match\n/// scan would still find the SHADOWED outer entry and reject a call to the\n/// new, unrelated binding as if it were the original effectful callback --\n/// a false positive on valid shadowing. Removes every overlay entry matching\n/// `name` before the shadowing binding's scope is pushed onto the stack.\n/// #885 review (Codex): shadow the overlay by EVERY name in `params`, in one\n/// pass — used at an EFn boundary where all of the lambda's own parameter\n/// names (not just the ones that become new overlay entries) must block a\n/// same-named inherited entry.\nfn shadow_overlay_names(names: Array[String], effs: Array[Array[String]], params: Array[(String, Option[TypeExpr])]) -> (Array[String], Array[Array[String]]) {\n  let mut cur_names = names\n  let mut cur_effs = effs\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, _) = Array::get(params, i)\n    let shadowed = shadow_overlay(cur_names, cur_effs, pname)\n    cur_names = shadowed.0\n    cur_effs = shadowed.1\n    i = i + 1\n  }\n  (cur_names, cur_effs)\n}\n\nfn shadow_overlay(names: Array[String], effs: Array[Array[String]], name: String) -> (Array[String], Array[Array[String]]) {\n  let out_names = array_empty()\n  let out_effs = array_empty()\n  let mut i = 0\n  while i < Array::length(names) {\n    if Array::get(names, i) != name {\n      Array::push(out_names, Array::get(names, i))\n      Array::push(out_effs, Array::get(effs, i))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  (out_names, out_effs)\n}\n\n/// #885 (split off from #838, originally scoped out at #626): a function-typed\n/// PARAMETER (a callback, e.g. `f: (T) -> T with { e }`) is a call-graph leaf\n/// exactly like a named top-level function, but `fn_names`/`fn_effs` above is\n/// built ONLY from top-level `SLet`/`SLetMut` bindings, so invoking a callback\n/// PARAMETER directly (`f(x)` inside the wrapper that owns `f`) was invisible to\n/// the transitive check — no lookup ever matched `f`'s name, so nothing was\n/// required. This is a SEPARATE parallel-array \"overlay\" (ov_names/ov_effs),\n/// scoped to the function body currently being walked (extended when the walk\n/// descends into an `EFn`, carried unchanged through every other node), that\n/// records each in-scope function-typed parameter's declared effect labels.\n///\n/// Deliberately narrower than the general transitive check: callback-parameter\n/// labels are checked via `decl_authorizes_effect` WITHOUT the\n/// `label_is_effect_var` exemption used below for calls to NAMED top-level\n/// functions. That exemption exists to prevent a real unsoundness of its own —\n/// naively requiring the LITERAL row-variable token (e.g. `\"e\"`) to appear in\n/// the CALLER's declared row at a call site like `apply(inc, 41)` — since the\n/// caller has no way to know the row variable resolves to nothing without\n/// call-site effect-row UNIFICATION (matching the argument actually passed\n/// against the callee's parameter type), which this pass does not perform. This\n/// is exactly the naive fix rejected during #885's investigation: dropping the\n/// exemption globally broke `generic_effect_matrix_ok_passthrough_pure.vibe`.\n/// The callback-parameter case is different in kind: the row variable and the\n/// declared effect being compared live in the SAME function signature (the\n/// parameter's `with { e }` and the enclosing function's own `with { e }` are\n/// the identical token by construction — no cross-call-site instantiation is\n/// involved), so a literal-name check here is sound, not a naive shortcut.\nfn build_param_overlay(params: Array[(String, Option[TypeExpr])]) -> (Array[String], Array[Array[String]]) {\n  let names = array_empty()\n  let effs = array_empty()\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, ptype) = Array::get(params, i)\n    match ptype {\n      Some(TyFn(_, _, eff)) => {\n        let labels = effect_decl_labels(eff)\n        if Array::length(labels) > 0 {\n          Array::push(names, pname)\n          Array::push(effs, labels)\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  (names, effs)\n}\n\n/// A `let apply: [T](f: (T) -> T with { e }, x: T) -> T = (f, x) -> { f(x) }`\n/// binding (separate top-level type annotation + untyped lambda) parses to an\n/// `EFn` whose OWN `params` carry no per-parameter `TypeExpr` at all (the types\n/// live only on the `SLet`'s `ty` field). `build_param_overlay` needs real\n/// per-parameter types to find a callback parameter's declared effect, so this\n/// fills in each untyped `EFn` parameter from `ty`'s `TyFn` parameter list at\n/// the SAME position — the two lists describe the same signature, so positional\n/// pairing is exact. An `EFn` parameter that already carries its own inline\n/// type (the `[T](f: (T) -> T with { e }, ...)` generic-literal spelling used\n/// elsewhere in this file) is left untouched; `ty` is consulted only to fill\n/// gaps, never to override.\nfn merge_param_types_with_sig(ty: Option[TypeExpr], params: Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] {\n  match ty {\n    Some(TyFn(sig_params, _, _)) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, ptype) = Array::get(params, i)\n        let effective = match ptype {\n          Some(_) => ptype,\n          None => if i < Array::length(sig_params) {\n            Some(Array::get(sig_params, i))\n          } else {\n            None\n          }\n        }\n        Array::push(out, (pname, effective))\n        i = i + 1\n      }\n      out\n    },\n    _ => params\n  }\n}\n\n/// Transitive effect enforcement (#626): a call to a user function `G` that\n/// declares `with { E }` leaks E into the caller unless the caller declares E or\n/// the call is under a `handle ... with E`. Combined with the DIRECT discipline\n/// (every function that itself performs/invokes an effectful builtin must declare\n/// it — already enforced), this propagates effect requirements up the call graph\n/// level by level: every effectful leaf is annotated, so a one-level check at\n/// each call site is complete. `fn_names`/`fn_effs` is the call-graph map (empty\n/// => transitive check disabled, preserving the direct-only behavior).\n///\n/// `ov_names`/`ov_effs` (#885) is the SEPARATE callback-parameter overlay\n/// described above, scoped to the function body currently in view (empty at the\n/// program's top level and at any call site with no enclosing function-typed\n/// parameters in scope).\nexport fn check_perform_effects_expr_tx(root: Expr, root_declared: Array[String], root_in_handle: Bool, fn_names: Array[String], fn_effs: Array[Array[String]], root_ov_names: Array[String], root_ov_effs: Array[Array[String]]) -> Array[EffectError] {\n  check_perform_effects_expr_tx_in(\"\", root, root_declared, root_in_handle, fn_names, fn_effs, root_ov_names, root_ov_effs)\n}\n\n/// #639: the same walk with the enclosing top-level binding's NAME threaded in\n/// so row-mismatch diagnostics can blame the caller's declaration in the fix-it\n/// hint. The name is constant per walk (lambdas are anonymous), so it rides as\n/// a plain parameter, not on the work stack.\nfn check_perform_effects_expr_tx_in(fn_name: String, root: Expr, root_declared: Array[String], root_in_handle: Bool, fn_names: Array[String], fn_effs: Array[Array[String]], root_ov_names: Array[String], root_ov_effs: Array[Array[String]]) -> Array[EffectError] {\n  let errors = array_empty()\n  let stack = Array::slice([\n    (root, root_declared, root_in_handle, root_ov_names, root_ov_effs)\n  ], 0, 1)\n  while Array::length(stack) > 0 {\n    let n = Array::length(stack)\n    let (expr, declared, in_handle, ov_names, ov_effs) = Array::get(stack, n - 1)\n    Array::truncate(stack, n - 1)\n    match expr {\n      ECall(callee, args, _) => {\n        match callee {\n          EIdent(name, _) => {\n            if name == \"perform\" && Array::length(args) == 1 {\n              match Array::get(args, 0) {\n                ECall(op_callee, _, _) => match op_callee {\n                  EIdent(op_name, _) => {\n                    let eff = effect_name_of_op(op_name)\n                    // #640 Stage 2: `Error` is exempt from the DIRECT\n                    // discipline, exactly like the transitive slice below\n                    // (`teff != \"Error\"`) and builtin_call_effect's Error\n                    // carve-out — the throw row is pervasive (~970\n                    // un-annotated throw sites). `throw(x)` now parses to\n                    // `perform Error::Throw(x)`, so without this exemption\n                    // every one of those sites would newly require\n                    // `with { Error }`.\n                    // Codex review (PR #1161): report the qualified\n                    // operation (`op_name`, e.g. \"Ask::Get\"), not the\n                    // stripped base effect name -- per docs/effectset.md's\n                    // operation-level diagnostic contract, a fix-it should\n                    // grant only the specific missing operation, not widen\n                    // to the whole effect (which would over-grant when a\n                    // sibling operation of the same effect is already\n                    // authorized at operation granularity, e.g. `with {\n                    // Ask::Other }` + a bare `perform Ask::Get`).\n                    if (eff != \"Error\" || error_row_checked()) && !in_handle && !decl_authorizes_op(declared, op_name) {\n                      Array::push(errors, make_row_mismatch(fn_name, declared, [\n                        op_name\n                      ]))\n                    } else {\n                      ()\n                    }\n                  },\n                  _ => ()\n                },\n                // #1157: a zero-arg operation (`Op -> T`, no parens) parses\n                // its `perform` argument as a bare `EIdent`, not an `ECall`\n                // — same direct-discipline check as the parenthesized form\n                // above, just without an args list to look past.\n                EIdent(op_name, _) => {\n                  let eff = effect_name_of_op(op_name)\n                  if (eff != \"Error\" || error_row_checked()) && !in_handle && !decl_authorizes_op(declared, op_name) {\n                    Array::push(errors, make_row_mismatch(fn_name, declared, [\n                      op_name\n                    ]))\n                  } else {\n                    ()\n                  }\n                },\n                _ => ()\n              }\n            } else {\n              match builtin_call_effect(name) {\n                Some(eff) => if !in_handle && !decl_authorizes_effect(declared, eff) {\n                  Array::push(errors, make_row_mismatch(fn_name, declared, [\n                    eff\n                  ]))\n                } else {\n                  ()\n                },\n                None => ()\n              }\n            }\n            // Transitive (#626): calling a user function leaks its declared\n            // effects into this context unless declared here or under a handle.\n            // Scope = concrete RESOURCE effects (Fs/Env/Stdin/Stdout/...): the\n            // DIRECT discipline already excludes `Error` (the throw row is\n            // pervasive — nearly every function can throw) and `Async`\n            // (composition is allowed; the async pass governs it), so the\n            // transitive pass mirrors that exclusion. Effect-variable rows\n            // (polymorphic) impose nothing HERE — call-site resolution of what\n            // a row variable is instantiated to would need real effect-row\n            // unification (#885 tracks that separately); naively requiring the\n            // row-variable TOKEN itself in the caller's declared row produces\n            // false positives (see `generic_effect_matrix_ok_passthrough_pure`).\n            match lookup_fn_effs(fn_names, fn_effs, name) {\n              Some(callee_effs) => {\n                // #639: aggregate every effect this call site leaks into ONE\n                // set-difference diagnostic (\"missing { Env, Fs }\") instead of\n                // one error per label.\n                let missing = no_str_labels()\n                let mut ti = 0\n                while ti < Array::length(callee_effs) {\n                  let teff = Array::get(callee_effs, ti)\n                  if String::length(teff) > 0 && (teff != \"Error\" || error_row_checked()) && teff != \"Async\" && !label_is_effect_var(teff) && !in_handle && !decl_authorizes_effect(declared, teff) {\n                    Array::push(missing, teff)\n                  } else {\n                    ()\n                  }\n                  ti = ti + 1\n                }\n                if Array::length(missing) > 0 {\n                  Array::push(errors, make_row_mismatch(fn_name, declared, missing))\n                } else {\n                  ()\n                }\n              },\n              None => ()\n            }\n            // #885: calling a function-typed PARAMETER (a callback) directly —\n            // e.g. `f(x)` inside the wrapper that declares `f: (T) -> T with\n            // { e }` — leaks `f`'s declared row into this context exactly like\n            // a named function call above, but UNLIKE that case a row-variable\n            // label here is NOT exempted: the parameter's `with { e }` and the\n            // enclosing function's own declared row live in the SAME\n            // signature, so the token `e` denotes the identical variable in\n            // both places (no cross-call-site instantiation to resolve), and\n            // literal-name membership is a sound check.\n            match lookup_fn_effs(ov_names, ov_effs, name) {\n              Some(param_effs) => {\n                // #639: aggregated exactly like the named-callee case above.\n                let missing = no_str_labels()\n                let mut pi = 0\n                while pi < Array::length(param_effs) {\n                  let peff = Array::get(param_effs, pi)\n                  if String::length(peff) > 0 && (peff != \"Error\" || error_row_checked()) && peff != \"Async\" && !in_handle && !decl_authorizes_effect(declared, peff) {\n                    Array::push(missing, peff)\n                  } else {\n                    ()\n                  }\n                  pi = pi + 1\n                }\n                if Array::length(missing) > 0 {\n                  Array::push(errors, make_row_mismatch(fn_name, declared, missing))\n                } else {\n                  ()\n                }\n              },\n              None => ()\n            }\n          },\n          _ => ()\n        }\n        Array::push(stack, (callee, declared, in_handle, ov_names, ov_effs))\n        let mut ai = 0\n        while ai < Array::length(args) {\n          Array::push(stack, (Array::get(args, ai), declared, in_handle, ov_names, ov_effs))\n          ai = ai + 1\n        }\n      },\n      EFn(_, _, params, _, effect, body) => {\n        // #761: an EXPLICITLY-annotated lambda (`(x) -> { .. } with { E }`) is\n        // checked against its own row E. An UN-annotated lambda's effect row is\n        // INFERRED, not declared, so checking its body against an empty row is\n        // wrong — it wrongly rejected an inline effectful lambda passed to a HOF\n        // param whose type declares the effect (bidirectional effect checking,\n        // e.g. `call_twice((c) -> { write_char(c) })`). Inherit the enclosing\n        // declared context instead: the lambda may use any effect available\n        // where it is written (its inferred row is surfaced in its type and\n        // re-checked at the call/handle site). Conservative — like the\n        // mutability pass, this can only miss errors, never invent them.\n        let lam_labels = effect_decl_labels(effect)\n        let body_declared = if Array::length(lam_labels) == 0 {\n          declared\n        } else {\n          lam_labels\n        }\n        // #885: extend the callback-parameter overlay with THIS function's own\n        // function-typed parameters (if any carry a declared effect), scoped to\n        // its body. New entries are appended AHEAD of the inherited overlay so\n        // `lookup_fn_effs` (first-match) has a same-named inner parameter\n        // shadow an outer one.\n        //\n        // #885 review (Codex): shadowing must apply to EVERY one of this\n        // lambda's own parameter names, not just the ones that end up in\n        // local_names/local_effs (function-typed with a declared effect) --\n        // a parameter reusing an outer callback's name with a DIFFERENT type\n        // (e.g. plain `Int`, or a function type with no declared effect) must\n        // still block the inherited entry, or a call to the new, unrelated\n        // parameter is wrongly checked against the shadowed outer callback's\n        // effect row.\n        let shadowed = shadow_overlay_names(ov_names, ov_effs, params)\n        let (shadowed_ov_names, shadowed_ov_effs) = shadowed\n        let (local_names, local_effs) = build_param_overlay(params)\n        let body_ov_names = if Array::length(local_names) == 0 {\n          shadowed_ov_names\n        } else {\n          let merged = Array::slice(local_names, 0, Array::length(local_names))\n          let mut oi = 0\n          while oi < Array::length(shadowed_ov_names) {\n            Array::push(merged, Array::get(shadowed_ov_names, oi))\n            oi = oi + 1\n          }\n          merged\n        }\n        let body_ov_effs = if Array::length(local_effs) == 0 {\n          shadowed_ov_effs\n        } else {\n          let merged = Array::slice(local_effs, 0, Array::length(local_effs))\n          let mut oi = 0\n          while oi < Array::length(shadowed_ov_effs) {\n            Array::push(merged, Array::get(shadowed_ov_effs, oi))\n            oi = oi + 1\n          }\n          merged\n        }\n        Array::push(stack, (body, body_declared, in_handle, body_ov_names, body_ov_effs))\n      },\n      EHandle(body, arms) => {\n        let discharged = collect_handle_effects(arms)\n        let body_declared = labels_union(declared, discharged)\n        let body_in_handle = if Array::length(discharged) == 0 {\n          true\n        } else {\n          in_handle\n        }\n        Array::push(stack, (body, body_declared, body_in_handle, ov_names, ov_effs))\n        let mut ai = 0\n        while ai < Array::length(arms) {\n          let (_, arm_body) = Array::get(arms, ai)\n          Array::push(stack, (arm_body, declared, in_handle, ov_names, ov_effs))\n          ai = ai + 1\n        }\n      },\n      ELet(name, val, body, _) => {\n        // #885 review (Codex): `val` is evaluated in the OUTER scope (ELet is\n        // non-recursive), so only the body's overlay needs the new binding\n        // shadowed out.\n        let (body_ov_names, body_ov_effs) = shadow_overlay(ov_names, ov_effs, name)\n        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs))\n        Array::push(stack, (body, declared, in_handle, body_ov_names, body_ov_effs))\n      },\n      ELetRec(name, val, body) => {\n        // #885 review (Codex): unlike ELet, `let rec` allows `val` itself to\n        // reference `name` (self-recursion), so both val and body need the\n        // shadow applied.\n        let (rec_ov_names, rec_ov_effs) = shadow_overlay(ov_names, ov_effs, name)\n        Array::push(stack, (val, declared, in_handle, rec_ov_names, rec_ov_effs))\n        Array::push(stack, (body, declared, in_handle, rec_ov_names, rec_ov_effs))\n      },\n      ELetMut(name, val, body, _) => {\n        // #885 review (Codex): same as ELet -- non-recursive, only body shadows.\n        let (body_ov_names, body_ov_effs) = shadow_overlay(ov_names, ov_effs, name)\n        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs))\n        Array::push(stack, (body, declared, in_handle, body_ov_names, body_ov_effs))\n      },\n      ESeq(a, b) => {\n        Array::push(stack, (a, declared, in_handle, ov_names, ov_effs))\n        Array::push(stack, (b, declared, in_handle, ov_names, ov_effs))\n      },\n      EIf(cond, then_e, else_e) => {\n        Array::push(stack, (cond, declared, in_handle, ov_names, ov_effs))\n        Array::push(stack, (then_e, declared, in_handle, ov_names, ov_effs))\n        Array::push(stack, (else_e, declared, in_handle, ov_names, ov_effs))\n      },\n      EMatch(scrutinee, arms) => {\n        Array::push(stack, (scrutinee, declared, in_handle, ov_names, ov_effs))\n        let mut ai = 0\n        while ai < Array::length(arms) {\n          let (_, arm_body) = Array::get(arms, ai)\n          Array::push(stack, (arm_body, declared, in_handle, ov_names, ov_effs))\n          ai = ai + 1\n        }\n      },\n      EWhile(cond, body) => {\n        Array::push(stack, (cond, declared, in_handle, ov_names, ov_effs))\n        Array::push(stack, (body, declared, in_handle, ov_names, ov_effs))\n      },\n      ELoop(params, body) => {\n        let mut i = 0\n        while i < Array::length(params) {\n          let (_, init) = Array::get(params, i)\n          Array::push(stack, (init, declared, in_handle, ov_names, ov_effs))\n          i = i + 1\n        }\n        Array::push(stack, (body, declared, in_handle, ov_names, ov_effs))\n      },\n      EForIn(_, _, iter, body) => {\n        Array::push(stack, (iter, declared, in_handle, ov_names, ov_effs))\n        Array::push(stack, (body, declared, in_handle, ov_names, ov_effs))\n      },\n      EBinOp(_, left, right) => {\n        Array::push(stack, (left, declared, in_handle, ov_names, ov_effs))\n        Array::push(stack, (right, declared, in_handle, ov_names, ov_effs))\n      },\n      EReturn(e) => Array::push(stack, (e, declared, in_handle, ov_names, ov_effs)),\n      EUnaryOp(_, operand) => Array::push(stack, (operand, declared, in_handle, ov_names, ov_effs)),\n      EAssign(_, val, cont) => {\n        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs))\n        Array::push(stack, (cont, declared, in_handle, ov_names, ov_effs))\n      },\n      EAssignOp(_, _, val, cont) => {\n        Array::push(stack, (val, declared, in_handle, ov_names, ov_effs))\n        Array::push(stack, (cont, declared, in_handle, ov_names, ov_effs))\n      },\n      EDot(obj, _, _, _) => Array::push(stack, (obj, declared, in_handle, ov_names, ov_effs)),\n      ETuple(elems) => {\n        let mut ei = 0\n        while ei < Array::length(elems) {\n          Array::push(stack, (Array::get(elems, ei), declared, in_handle, ov_names, ov_effs))\n          ei = ei + 1\n        }\n      },\n      EArray(elems) => {\n        let mut ei = 0\n        while ei < Array::length(elems) {\n          Array::push(stack, (Array::get(elems, ei), declared, in_handle, ov_names, ov_effs))\n          ei = ei + 1\n        }\n      },\n      ERecord(_, fields, _) => {\n        let mut fi = 0\n        while fi < Array::length(fields) {\n          let (_, fval) = Array::get(fields, fi)\n          Array::push(stack, (fval, declared, in_handle, ov_names, ov_effs))\n          fi = fi + 1\n        }\n      },\n      _ => ()\n    }\n  }\n  errors\n}\n\nfn sig_type_effect_labels(topt: Option[TypeExpr]) -> Array[String] {\n  match topt {\n    Some(TyFn(_, _, eff)) => effect_decl_labels(eff),\n    _ => effect_decl_labels(None)\n  }\n}\n\nfn no_str_labels() -> Array[String] {\n  array_empty()\n}\n\nfn no_ov_effs() -> Array[Array[String]] {\n  array_empty()\n}\n\n/// Public 3-arg entry: the direct-only check (no call-graph map), preserving the\n/// pre-transitive behavior for unit tests and any non-stmts caller.\nexport fn check_perform_effects_expr(root: Expr, root_declared: Array[String], root_in_handle: Bool) -> Array[EffectError] {\n  check_perform_effects_expr_tx(root, root_declared, root_in_handle, no_str_labels(), no_ov_effs(), no_str_labels(), no_ov_effs())\n}\n\nfn check_perform_effects_binding_tx(fn_name: String, ty: Option[TypeExpr], body: Expr, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Array[EffectError] {\n  let sig_labels = sig_type_effect_labels(ty)\n  match body {\n    // #885: build the callback-parameter overlay for THIS binding's own\n    // function value from its (possibly untyped, see merge_param_types_with_sig)\n    // parameters, so a direct call to one of them inside the body is checked\n    // from the very first stack frame — not just once the walk happens to\n    // redescend through a nested `EFn` node.\n    EFn(_, _, params, _, eff, fbody) => {\n      let (ov_names, ov_effs) = build_param_overlay(merge_param_types_with_sig(ty, params))\n      check_perform_effects_expr_tx_in(fn_name, fbody, labels_union(sig_labels, effect_decl_labels(eff)), false, fn_names, fn_effs, ov_names, ov_effs)\n    },\n    _ => check_perform_effects_expr_tx_in(fn_name, body, sig_labels, false, fn_names, fn_effs, no_str_labels(), no_ov_effs())\n  }\n}\n\n/// #761: a `test {}` / `bench {}` block is a program entry point — it runs under\n/// the runtime host, which is the ambient handler for the HOST resource effects\n/// (Fs/Env/Stdin/Stdout/Process/Profiler). So a test may invoke a host-effectful\n/// function (directly, transitively, or as an unqualified builtin) without a\n/// `handle`, exactly as `main` does. This grant was already de-facto true for\n/// IMPORTED effectful functions (they are absent from the transitive fn_effs map,\n/// so calling them never flagged), but LOCALLY-defined ones (in fn_effs) and\n/// direct builtin/perform host effects were wrongly rejected — an asymmetry.\n/// Seeding the test/bench declared row with the host set removes it. NON-host\n/// (user-defined) effects still require a handler: performing one at runtime with\n/// no host handler would trap, so leaving it flagged is correct. Purity/caching\n/// is judged separately by file_tests_cacheable (empty declared row), so a test\n/// that reaches a host effect still correctly counts as impure/non-cacheable.\n/// #944 (ADR-0073 implementation bridge): checked-Error mode. The accepted\n/// owner decision makes `Error::Throw` a fully checked semantic operation\n/// (direct throw and `with { Error }` callees propagate to the caller's\n/// row; discharge via `handle ... with Error`). Stage A landed this\n/// opt-in (`VIBE_CHECK_ERROR_ROW=1`, default off, preserving the old\n/// exemption byte-for-byte) while the tree still carried hundreds of\n/// row-less throw sites (#640 measured ~970); stage B annotated those and\n/// flipped the DEFAULT to checked, leaving `VIBE_CHECK_ERROR_ROW=0` as a\n/// temporary opt-OUT escape hatch (wired in cli_adapter.vibe) for any\n/// downstream code that hasn't annotated yet. The switch rides in a\n/// module-level memo cell (fixtures/module_let_memo_test.vibe pattern)\n/// because the effect discipline has no configuration threading and the\n/// checker itself is pure (no Env row).\n///\n/// Scope note: builtin_call_effect's own Error carve-out (a BUILTIN whose\n/// declared row is Error) is deliberately NOT flipped by this switch --\n/// which builtins should carry a semantic Error row is a separate\n/// sub-decision tracked on #944.\nlet error_row_mode_cell = array_empty()\n\nexport fn set_error_row_checked(on: Bool) -> Unit {\n  Array::truncate(error_row_mode_cell, 0)\n  Array::push(error_row_mode_cell, if on {\n    1\n  } else {\n    0\n  })\n}\n\nfn error_row_checked() -> Bool {\n  Array::length(error_row_mode_cell) > 0 && Array::get(error_row_mode_cell, 0) == 1\n}\n\nfn test_bench_ambient_effects() -> Array[String] {\n  [\n    // #865: \"Stderr\" added alongside \"Stdout\" -- same ambient-host-handler\n    // reasoning (a test/bench block runs under the runtime host, which\n    // implements Stderr::write_stream/write_char just like Stdout's).\n    //\n    // #944 (checked-Error stage B): \"Error\" is ambient in test/bench\n    // blocks by the same boundary reasoning -- `assert` itself is\n    // implemented as a throw, and a failing test IS an escaping Error the\n    // test runner catches and reports (the block is an entry-like\n    // boundary, exactly ADR-0073's entry-boundary-A shape). Requiring\n    // every test block to spell `with { Error }` would annotate the\n    // mechanism the runner already owns.\n    \"Fs\",\n    \"Env\",\n    \"Stdin\",\n    \"Stdout\",\n    \"Stderr\",\n    \"Process\",\n    \"Profiler\",\n    \"Error\"\n  ]\n}\n\nfn check_perform_effects_stmt_tx(stmt: Stmt, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Array[EffectError] {\n  match stmt {\n    SLet(_, _, name, ty, body) => check_perform_effects_binding_tx(name, ty, body, fn_names, fn_effs),\n    SLetMut(name, ty, body) => check_perform_effects_binding_tx(name, ty, body, fn_names, fn_effs),\n    STest(_, body) => check_perform_effects_expr_tx(body, test_bench_ambient_effects(), false, fn_names, fn_effs, no_str_labels(), no_ov_effs()),\n    SBench(_, body) => check_perform_effects_expr_tx(body, test_bench_ambient_effects(), false, fn_names, fn_effs, no_str_labels(), no_ov_effs()),\n    SExpr(e) => check_perform_effects_expr_tx(e, effect_decl_labels(None), false, fn_names, fn_effs, no_str_labels(), no_ov_effs()),\n    _ => array_empty()\n  }\n}\n\n/// Public 1-arg entry: direct-only (empty map). Kept for unit tests.\nexport fn check_perform_effects_stmt(stmt: Stmt) -> Array[EffectError] {\n  check_perform_effects_stmt_tx(stmt, no_str_labels(), no_ov_effs())\n}\n\n/// #812: seed the transitive call-graph map with the checker ENV's bindings.\n/// fn_names/fn_effs was built from the CURRENT module's top-level statements\n/// only, so a caller could invoke an IMPORTED `with { Fs }` function without\n/// declaring Fs and reach the filesystem at runtime — while the identical\n/// shape with a local callee was rejected. An imported binding's CtFn carries\n/// its declared effect row in the env; add every effect-bearing env binding\n/// AFTER the local rows (lookup_fn_effs is first-match, so a same-name local\n/// row still shadows the env row). Effect-free bindings are skipped — an\n/// absent row and an empty row enforce the same (nothing).\nfn push_env_fn_eff(name: String, ty: Type, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Unit {\n  let fnty = match ty {\n    CtForAll(_, _, body) => body,\n    _ => ty\n  }\n  match fnty {\n    CtFn(_, _, eff) => {\n      let labels = effect_decl_labels(eff)\n      if Array::length(labels) > 0 {\n        Array::push(fn_names, name)\n        Array::push(fn_effs, labels)\n      } else {\n        ()\n      }\n    },\n    _ => ()\n  }\n}\n\nfn seed_env_fn_effs(env: TypeEnv, fn_names: Array[String], fn_effs: Array[Array[String]]) -> Unit {\n  let mut cur = env\n  let mut looping = true\n  while looping {\n    match cur {\n      EnvBind(name, ty, rest) => {\n        push_env_fn_eff(name, ty, fn_names, fn_effs)\n        cur = rest\n      },\n      EnvTraitDef(_, _, _, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImpl(_, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImplGen(_, _, _, _, rest) => {\n        cur = rest\n      },\n      EnvCached(_, _, rest) => {\n        cur = rest\n      },\n      EnvFlat(entries) => {\n        let mut ei = 0\n        while ei < Array::length(entries) {\n          let (ename, ety) = Array::get(entries, ei)\n          push_env_fn_eff(ename, ety, fn_names, fn_effs)\n          ei = ei + 1\n        }\n        looping = false\n      },\n      EnvEmpty => {\n        looping = false\n      }\n    }\n  }\n}\n\nfn build_perform_fn_effs(stmts: Array[Stmt], fn_names: Array[String], fn_effs: Array[Array[String]]) -> Unit {\n  let mut m = 0\n  while m < Array::length(stmts) {\n    match Array::get(stmts, m) {\n      SLet(_, _, name, ty, body) => {\n        Array::push(fn_names, name)\n        Array::push(fn_effs, fn_binding_effects(ty, body))\n      },\n      SLetMut(name, ty, body) => {\n        Array::push(fn_names, name)\n        Array::push(fn_effs, fn_binding_effects(ty, body))\n      },\n      _ => ()\n    }\n    m = m + 1\n  }\n}\n\nexport fn check_perform_effects_stmts(stmts: Array[Stmt]) -> Array[EffectError] {\n  check_perform_effects_stmts_env(stmts, EnvEmpty)\n}\n\nexport fn check_perform_effects_stmts_env(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError] {\n  // Build the call-graph effect map (parallel arrays) from every top-level\n  // binding's declared row — locals first, then the env's (imported)\n  // bindings (#812) — then run the per-stmt check WITH transitive\n  // enforcement so a caller must declare (or handle) the effects of the\n  // functions it invokes.\n  let fn_names = array_empty()\n  let fn_effs = array_empty()\n  build_perform_fn_effs(stmts, fn_names, fn_effs)\n  seed_env_fn_effs(env, fn_names, fn_effs)\n  let errors = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    append_eff_errs(errors, check_perform_effects_stmt_tx(Array::get(stmts, i), fn_names, fn_effs))\n    i = i + 1\n  }\n  errors\n}\n\n/// #634 (ADR-0026): pure-test result cache verdict. A `test {}` block's result\n/// is safe to cache/skip only when running it depends on nothing external — no\n/// I/O, no non-determinism — so it is a deterministic function of source + deps +\n/// compiler version. file_tests_cacheable is true iff the file has at least one\n/// `test {}` block and EVERY test block is transitively effect-free.\n///\n/// Reuses the transitive effect walk: a test body checked with an EMPTY declared\n/// row reports an error for ANY effect it reaches that a `handle` does not\n/// discharge — Fs/Http/Env/custom effects and `perform`, propagated through the\n/// call-graph effect map (fn_names/fn_effs). `Error` (assert/throw) and `Async`\n/// are excluded by that pass, so they stay cacheable; a `handle` that fully\n/// discharges its effects (e.g. a fixed-seed Rng handler) also stays cacheable.\n/// Zero errors => cacheable.\n///\n/// A direct `sh`/`sh_lines` call IS surfaced: builtin_call_effect special-cases\n/// these two unqualified builtins to `Process` (they lower to real host imports),\n/// so a test that shells out is correctly treated as impure/non-cacheable, the\n/// same as `sh` reached through a user function declaring `with { Process }`.\n/// Conservative otherwise: an effect the type system does not surface here stays\n/// invisible, but it never marks a genuinely-impure test cacheable.\nexport fn file_tests_cacheable(stmts: Array[Stmt]) -> Bool {\n  let fn_names = array_empty()\n  let fn_effs = array_empty()\n  let mut m = 0\n  while m < Array::length(stmts) {\n    match Array::get(stmts, m) {\n      SLet(_, _, name, ty, body) => {\n        Array::push(fn_names, name)\n        Array::push(fn_effs, fn_binding_effects(ty, body))\n      },\n      SLetMut(name, ty, body) => {\n        Array::push(fn_names, name)\n        Array::push(fn_effs, fn_binding_effects(ty, body))\n      },\n      _ => ()\n    }\n    m = m + 1\n  }\n  let empty_decl = array_empty()\n  let mut any_test = false\n  let mut all_ok = true\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STest(_, body) => {\n        any_test = true\n        let errs = check_perform_effects_expr_tx(body, empty_decl, false, fn_names, fn_effs, no_str_labels(), no_ov_effs())\n        if Array::length(errs) != 0 {\n          all_ok = false\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  any_test && all_ok\n}\n\n/// #819 (Codex review, PR #1214): entry-function counterpart of\n/// file_tests_cacheable above, for a program compiled with a normal ENTRY\n/// function (e.g. `fn main`) instead of `test {}` blocks -- used by\n/// scripts/vibe_md.vibex's ```vibe run block execute-cache. Unlike a test's\n/// empty declared row, `Stdout` is declared-safe here: it is the block's\n/// PRODUCED, CAPTURED value (the exact thing the cache stores and compares\n/// against the doc's ```output block), not a hidden nondeterminism source.\n/// `Error`/`Async` are exempt for the same reason file_tests_cacheable\n/// leaves them out -- a throwing entry never reaches the caller's cache-write\n/// path anyway (run_one_block only caches on a successful `_start`), and\n/// Async is composition, not itself a host nondeterminism source. Any OTHER\n/// reachable effect (Fs/Env/Http/Process/Socket/custom/...) means the\n/// entry's stdout can vary between runs of byte-identical compiled wasm, so\n/// it must NOT be treated as cacheable -- returns false if `entry_name` is\n/// not found among the file's top-level bindings.\nexport fn file_entry_cacheable(stmts: Array[Stmt], entry_name: String) -> Bool {\n  let fn_names = array_empty()\n  let fn_effs = array_empty()\n  let mut entry_body = None\n  let mut entry_declared = None\n  let mut m = 0\n  while m < Array::length(stmts) {\n    match Array::get(stmts, m) {\n      SLet(_, _, name, ty, body) => {\n        let effs = fn_binding_effects(ty, body)\n        Array::push(fn_names, name)\n        Array::push(fn_effs, effs)\n        if name == entry_name {\n          entry_body = Some(body)\n          entry_declared = Some(effs)\n        } else {\n          ()\n        }\n      },\n      SLetMut(name, ty, body) => {\n        let effs = fn_binding_effects(ty, body)\n        Array::push(fn_names, name)\n        Array::push(fn_effs, effs)\n        if name == entry_name {\n          entry_body = Some(body)\n          entry_declared = Some(effs)\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    m = m + 1\n  }\n  match entry_body {\n    None => false,\n    Some(body) => {\n      let cache_safe_row = [\n        \"Stdout\",\n        \"Error\",\n        \"Async\"\n      ]\n      // Codex review, PR #1215: belt-and-suspenders on top of the\n      // reachable-effects walk below. That walk shares check_perform_\n      // effects_expr_tx's own limitation (also present, unchanged, in the\n      // established `vibe test` cache via file_tests_cacheable above): a\n      // LOCAL closure defined inside the body is checked under its OWN\n      // declared row (so an inner `with { Env }` satisfies itself and never\n      // surfaces as an error at this call site), and a row-POLYMORPHIC\n      // callee's effect-VARIABLE labels are deliberately treated as \"leaks\n      // nothing\" here (real call-site row-variable instantiation tracking\n      // is #885, not implemented by this pass -- see the \"Effect-variable\n      // rows (polymorphic) impose nothing HERE\" comment near\n      // check_perform_effects_expr_tx_in's transitive-leak check above).\n      // Neither gap is new to this PR. Closing it outright would need #885-\n      // class compiler work, out of proportion for a doctest-cache\n      // hardening -- instead, conservatively reject up front whenever the\n      // entry's OWN declared row names anything outside the safe set. A\n      // real top-level `main` is never itself row-polymorphic, so this is a\n      // cheap, purely-additive net that catches the common/direct case\n      // (`fn main with { Stdout, Env } { ... }`) even in scenarios the\n      // deeper walk alone would miss.\n      let declared_ok = match entry_declared {\n        None => true,\n        Some(row) => array_is_subset_of_str(row, cache_safe_row)\n      }\n      if !declared_ok {\n        false\n      } else {\n        // `body` (from SLet/SLetMut) is the closure VALUE bound to\n        // entry_name, e.g. `EFn(type_params, bounds, params, ret_ty,\n        // effect, fn_body)` for `fn main with { ... } { ... }` -- checking\n        // the EFn NODE itself would trivially find zero reachable effects\n        // (defining a closure performs nothing; only CALLING it would),\n        // silently marking every entry cacheable regardless of what it\n        // does. The walk needs `fn_body`, the 6th field, not the literal.\n        let exec_body = match body {\n          EFn(_, _, _, _, _, fn_body) => fn_body,\n          _ => body\n        }\n        let errs = check_perform_effects_expr_tx(exec_body, cache_safe_row, false, fn_names, fn_effs, no_str_labels(), no_ov_effs())\n        Array::length(errs) == 0\n      }\n    }\n  }\n}\n\n/// Every label in `row` must appear in `safe` -- unlike decl_authorizes_\n/// effect above (used the OPPOSITE direction: \"does this declared row\n/// authorize performing effect X\", where an effect-VARIABLE label\n/// conservatively authorizes anything), this is used to conservatively\n/// REJECT: an unrecognized label (including a row-variable letter, which a\n/// real top-level `main` should never carry) is NOT treated as safe.\nfn array_is_subset_of_str(row: Array[String], safe: Array[String]) -> Bool {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(row) {\n    let eff = Array::get(row, i)\n    let mut j = 0\n    let mut found = false\n    while j < Array::length(safe) {\n      if Array::get(safe, j) == eff {\n        found = true\n      } else {\n        ()\n      }\n      j = j + 1\n    }\n    if !found {\n      ok = false\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  ok\n}\n\n//# Mutability discipline: reassignment requires a `let mut` binding.\n//\n// `let x = ...` is immutable (docs/cheatsheet.md); only `let mut x` may be\n// reassigned. The checker previously accepted `let x = 1; x = 2`. This pass\n// walks expressions carrying the SET of names that are reassignable in scope\n// and reports an `x = e` / `x op= e` whose target is not in that set.\n//\n// The set only ever GROWS down a scope (never shrinks), so the pass can only\n// produce false NEGATIVES, never false positives: every form that introduces a\n// reassignable or freshly-rebindable name — `let mut`, function parameters,\n// loop accumulators, `for` variables, and pattern binds — is added, so the\n// only thing flagged is reassignment of a plain immutable `let`. Nested\n// functions INHERIT the outer set (a closure may mutate a captured `let mut`).\n\nfn mut_has(xs: Array[String], n: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(xs) {\n    if Array::get(xs, i) == n {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn mut_with(base: Array[String], name: String) -> Array[String] {\n  let out = Array::slice(base, 0, Array::length(base))\n  Array::push(out, name)\n  out\n}\n\nfn collect_pat_binds_into(pat: Pat, acc: Array[String]) -> Unit {\n  match pat {\n    PBind(name) => Array::push(acc, name),\n    PCtor(_, subs) => {\n      let mut i = 0\n      while i < Array::length(subs) {\n        collect_pat_binds_into(Array::get(subs, i), acc)\n        i = i + 1\n      }\n    },\n    PTuple(subs) => {\n      let mut i = 0\n      while i < Array::length(subs) {\n        collect_pat_binds_into(Array::get(subs, i), acc)\n        i = i + 1\n      }\n    },\n    POr(l, r) => {\n      collect_pat_binds_into(l, acc)\n      collect_pat_binds_into(r, acc)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        collect_pat_binds_into(fp, acc)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn mut_with_pat(base: Array[String], pat: Pat) -> Array[String] {\n  let out = Array::slice(base, 0, Array::length(base))\n  collect_pat_binds_into(pat, out)\n  out\n}\n\nfn mut_with_params(base: Array[String], params: Array[(String, Option[TypeExpr])]) -> Array[String] {\n  let out = Array::slice(base, 0, Array::length(base))\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, _) = Array::get(params, i)\n    Array::push(out, pname)\n    i = i + 1\n  }\n  out\n}\n\nexport fn check_mutability_expr(expr: Expr, mutable: Array[String]) -> Array[EffectError] {\n  let errors = array_empty()\n  match expr {\n    ECall(callee, args, _) => {\n      append_eff_errs(errors, check_mutability_expr(callee, mutable))\n      let mut ai = 0\n      while ai < Array::length(args) {\n        append_eff_errs(errors, check_mutability_expr(Array::get(args, ai), mutable))\n        ai = ai + 1\n      }\n      errors\n    },\n    EFn(_, _, params, _, _, body) => {\n      append_eff_errs(errors, check_mutability_expr(body, mut_with_params(mutable, params)))\n      errors\n    },\n    EHandle(body, arms) => {\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, ai)\n        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))\n        ai = ai + 1\n      }\n      errors\n    },\n    ELet(_, val, body, _) => {\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\n      errors\n    },\n    ELetRec(_, val, body) => {\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\n      errors\n    },\n    ELetMut(name, val, body, _) => {\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\n      append_eff_errs(errors, check_mutability_expr(body, mut_with(mutable, name)))\n      errors\n    },\n    ESeq(a, b) => {\n      append_eff_errs(errors, check_mutability_expr(a, mutable))\n      append_eff_errs(errors, check_mutability_expr(b, mutable))\n      errors\n    },\n    EIf(cond, then_e, else_e) => {\n      append_eff_errs(errors, check_mutability_expr(cond, mutable))\n      append_eff_errs(errors, check_mutability_expr(then_e, mutable))\n      append_eff_errs(errors, check_mutability_expr(else_e, mutable))\n      errors\n    },\n    EMatch(scrutinee, arms) => {\n      append_eff_errs(errors, check_mutability_expr(scrutinee, mutable))\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, ai)\n        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))\n        ai = ai + 1\n      }\n      errors\n    },\n    EWhile(cond, body) => {\n      append_eff_errs(errors, check_mutability_expr(cond, mutable))\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\n      errors\n    },\n    ELoop(params, body) => {\n      let loopmut = Array::slice(mutable, 0, Array::length(mutable))\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, init) = Array::get(params, i)\n        append_eff_errs(errors, check_mutability_expr(init, mutable))\n        Array::push(loopmut, pname)\n        i = i + 1\n      }\n      append_eff_errs(errors, check_mutability_expr(body, loopmut))\n      errors\n    },\n    EForIn(name, index_name, iter, body) => {\n      append_eff_errs(errors, check_mutability_expr(iter, mutable))\n      let base = mut_with(mutable, name)\n      let formut = match index_name {\n        Some(idx) => mut_with(base, idx),\n        None => base\n      }\n      append_eff_errs(errors, check_mutability_expr(body, formut))\n      errors\n    },\n    EBinOp(_, left, right) => {\n      append_eff_errs(errors, check_mutability_expr(left, mutable))\n      append_eff_errs(errors, check_mutability_expr(right, mutable))\n      errors\n    },\n    EReturn(e) => check_mutability_expr(e, mutable),\n    EUnaryOp(_, operand) => check_mutability_expr(operand, mutable),\n    EAssign(name, val, cont) => {\n      if !mut_has(mutable, name) {\n        Array::push(errors, EEAssignImmutable(name))\n      } else {\n        ()\n      }\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\n      append_eff_errs(errors, check_mutability_expr(cont, mutable))\n      errors\n    },\n    EAssignOp(name, _, val, cont) => {\n      if !mut_has(mutable, name) {\n        Array::push(errors, EEAssignImmutable(name))\n      } else {\n        ()\n      }\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\n      append_eff_errs(errors, check_mutability_expr(cont, mutable))\n      errors\n    },\n    EDot(obj, _, _, _) => check_mutability_expr(obj, mutable),\n    ETuple(elems) => {\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))\n        ei = ei + 1\n      }\n      errors\n    },\n    EArray(elems) => {\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))\n        ei = ei + 1\n      }\n      errors\n    },\n    ERecord(_, fields, _) => {\n      let mut fi = 0\n      while fi < Array::length(fields) {\n        let (_, fval) = Array::get(fields, fi)\n        append_eff_errs(errors, check_mutability_expr(fval, mutable))\n        fi = fi + 1\n      }\n      errors\n    },\n    // #629 step 3-2: forms previously dropped to `_ => errors`, so an illegal\n    // reassignment (`x = e` where x is an immutable `let`) sitting inside a map\n    // literal, labeled argument, spread, break value, or continue argument went\n    // unflagged. Recurse with the SAME mutable set (these forms introduce no new\n    // bindings), keeping the pass sound: still no false positives, just fewer\n    // false negatives.\n    EMap(entries) => {\n      let mut mi = 0\n      while mi < Array::length(entries) {\n        let (_, mval) = Array::get(entries, mi)\n        append_eff_errs(errors, check_mutability_expr(mval, mutable))\n        mi = mi + 1\n      }\n      errors\n    },\n    ELabeledArg(_, _, inner) => check_mutability_expr(inner, mutable),\n    ESpread(inner) => check_mutability_expr(inner, mutable),\n    EBreak(opt) => match opt {\n      Some(e) => check_mutability_expr(e, mutable),\n      None => errors\n    },\n    EContinue(cargs) => {\n      let mut ci = 0\n      while ci < Array::length(cargs) {\n        append_eff_errs(errors, check_mutability_expr(Array::get(cargs, ci), mutable))\n        ci = ci + 1\n      }\n      errors\n    },\n    _ => errors\n  }\n}\n\n/// #770: `outer` carries the top-level `let mut` names already in scope from\n/// earlier sibling statements (see check_mutability_stmts below) so a later\n/// top-level statement's assignment to an earlier top-level `mut` binding\n/// (directly, or via a closure capturing it) is recognized as mutable instead\n/// of being misreported as `cannot assign to immutable binding`.\nfn check_mutability_binding(body: Expr, outer: Array[String]) -> Array[EffectError] {\n  match body {\n    EFn(_, _, params, _, _, fbody) => check_mutability_expr(fbody, mut_with_params(outer, params)),\n    _ => check_mutability_expr(body, outer)\n  }\n}\n\n/// #770: top-level program statements are a flat `Array[Stmt]` sequence (not\n/// nested `ELetMut` continuations like a function/test body), so a top-level\n/// `let mut x = ...` must thread `x` forward into the mutability check of\n/// every later sibling statement by accumulating `mutable` across the loop —\n/// mirroring how `check_stmts` threads `env` across the same array. Before\n/// this fix each statement was checked in isolation starting from an empty\n/// mutable set, so any top-level `let mut` followed by an assignment in a\n/// later top-level statement (e.g. a top-level `while` loop mutating a\n/// counter) was rejected with a bogus `cannot assign to immutable binding`\n/// error even though the program is valid.\nexport fn check_mutability_stmts(stmts: Array[Stmt]) -> Array[EffectError] {\n  let errors = array_empty()\n  let mut mutable = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, body) => append_eff_errs(errors, check_mutability_binding(body, mutable)),\n      SLetMut(name, _, body) => {\n        append_eff_errs(errors, check_mutability_binding(body, mutable))\n        mutable = mut_with(mutable, name)\n      },\n      STest(_, body) => append_eff_errs(errors, check_mutability_expr(body, array_empty())),\n      SBench(_, body) => append_eff_errs(errors, check_mutability_expr(body, array_empty())),\n      SExpr(e) => append_eff_errs(errors, check_mutability_expr(e, mutable)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  errors\n}\n")
}

let cli_adapter_source_55 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Subst,\n  Type,\n  TypeDef,\n  TypeEnv,\n  TypeExpr,\n  env_bind,\n  env_lookup,\n  find_typedef,\n  fresh_var,\n  generalize,\n  instantiate,\n  resolve_builtin,\n  subst_add_bound,\n  subst_apply,\n  subst_bounds_for,\n  trait_method_sig_deep,\n  type_implements_trait,\n  type_name_has_iterator_impl,\n  type_to_string,\n  unify\n}\n\nimport ./builtins.vibe {\n  lookup_builtin\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport ./checker_exhaustive.vibe {\n  match_nonexhaustive_witness\n}\n\nimport ./checker_pattern.vibe {\n  check_pattern, pat_has_unsupported_or_binding\n}\n\nimport ./checker_resolve.vibe {\n  resolve_type_expr, subst_type_params\n}\n\nimport ./checker_spawnable.vibe {\n  check_spawnable_captures\n}\n\n//# Functions\n\nfn min_int(a: Int, b: Int) -> Int {\n  if a < b {\n    a\n  } else {\n    b\n  }\n}\n\n/// Encode a real AST char offset into a strippable diagnostic marker so the\n/// located-diagnostics layer (typecheck_fs.vibe::locate_type_error) can decode\n/// the exact line:col instead of falling back to a first-occurrence text scan.\n/// String::concat only (never `+` / interpolation — both mis-codegen to NUL\n/// here). off < 0 => no marker (heuristic fallback retained).\nfn off_marker(off: Int) -> String {\n  if off >= 0 {\n    String::concat(\" [@off=\", String::concat(__to_string(off), \"]\"))\n  } else {\n    \"\"\n  }\n}\n\n/// Like off_marker but also encodes the offending token's END offset as\n/// `[@off=N:M]` (M = off + len), so the located-diagnostics layer can emit an\n/// EXACT source range (line:colC-E) instead of the LSP guessing the token end\n/// with a word-scan — which mis-handles qualified names like `Mod.foo` (the scan\n/// stops at the dot). Falls back to the start-only marker when len <= 0. Use this\n/// where `off` is the START of a known-length named token (the symbol whose\n/// length matches the source span); keep plain off_marker where the offset is an\n/// anchor rather than the token start (e.g. a field error whose offset is the\n/// base expr). String::concat only (NUL-miscodegen hazard for `+`/interpolation).\nfn off_marker_len(off: Int, len: Int) -> String {\n  if off >= 0 && len > 0 {\n    String::concat(\" [@off=\", String::concat(__to_string(off), String::concat(\":\", String::concat(__to_string(off + len), \"]\"))))\n  } else {\n    off_marker(off)\n  }\n}\n\nfn prepend_expr(first: Expr, rest: Array[Expr]) -> Array[Expr] {\n  let out = array_empty()\n  Array::push(out, first)\n  let mut i = 0\n  while i < Array::length(rest) {\n    Array::push(out, Array::get(rest, i))\n    i = i + 1\n  }\n  out\n}\n\n/// Replace the abstract `Self` type (resolved as `CtNamed(\"Self\", _)`) inside a\n/// trait-method signature with the concrete receiver type, when typing a\n/// `T::method` call against a bounded generic parameter T.\nfn subst_self_in_type(ty: Type, self_ty: Type) -> Type {\n  match ty {\n    CtNamed(n, args) => if n == \"Self\" {\n      self_ty\n    } else {\n      let ra = for a in args {\n        subst_self_in_type(a, self_ty)\n      }\n      CtNamed(n, ra)\n    },\n    CtArray(e) => CtArray(subst_self_in_type(e, self_ty)),\n    CtOption(e) => CtOption(subst_self_in_type(e, self_ty)),\n    CtTuple(elems) => CtTuple(for e in elems {\n      subst_self_in_type(e, self_ty)\n    }),\n    CtFn(ps, ret, eff) => CtFn(for p in ps {\n      subst_self_in_type(p, self_ty)\n    }, subst_self_in_type(ret, self_ty), eff),\n    _ => ty\n  }\n}\n\n/// Relax a trait type parameter (e.g. the `T` in `Iterator[T] { next(Self) ->\n/// Option[T] }`) to `CtUnknown` so it unifies at the call site. A name that\n/// resolves to a real type (primitive or declared) is kept; only truly-unknown\n/// named types — the trait's own element type params, which the uniform\n/// representation erases — are relaxed. (#636.)\nfn relax_unknown_named(ty: Type, defs: Array[TypeDef]) -> Type {\n  match ty {\n    CtNamed(n, args) => {\n      let known = match find_typedef(defs, n) {\n        Some(_) => true,\n        None => match resolve_builtin(n) {\n          Some(_) => true,\n          None => false\n        }\n      }\n      if known {\n        CtNamed(n, for a in args {\n          relax_unknown_named(a, defs)\n        })\n      } else {\n        CtUnknown\n      }\n    },\n    CtArray(e) => CtArray(relax_unknown_named(e, defs)),\n    CtOption(e) => CtOption(relax_unknown_named(e, defs)),\n    CtTuple(es) => CtTuple(for e in es {\n      relax_unknown_named(e, defs)\n    }),\n    CtFn(ps, r, eff) => CtFn(for p in ps {\n      relax_unknown_named(p, defs)\n    }, relax_unknown_named(r, defs), eff),\n    _ => ty\n  }\n}\n\n/// Resolve a qualified identifier `T::method` where `T` is a bounded generic\n/// type parameter (`[T: Trait]`). If the head resolves to a type variable whose\n/// recorded bounds include a trait declaring `method`, return that method's\n/// signature with `Self` substituted by T. Returns None for any other qualified\n/// name (concrete `Type::method`, module-qualified names, etc.) so the existing\n/// resolution paths are untouched. (PR-3 component 2.)\nfn resolve_trait_method_ident(name: String, env: TypeEnv, defs: Array[TypeDef], s: Subst) -> Option[Type] {\n  let idx = String::index_of(name, \"::\")\n  if idx < 0 {\n    None\n  } else {\n    let head = String::substring(name, 0, idx)\n    let method = String::substring(name, idx + 2, String::length(name))\n    match env_lookup(env, head) {\n      Some(head_ty) => match head_ty {\n        CtVar(vid) => {\n          let bounds = subst_bounds_for(s, vid)\n          let self_ty = CtVar(vid)\n          let mut result = None\n          let mut bi = 0\n          while bi < Array::length(bounds) {\n            let pending = match result {\n              None => true,\n              _ => false\n            }\n            if pending {\n              let trait_name = Array::get(bounds, bi)\n              match trait_method_sig_deep(env, trait_name, method) {\n                Some(sig) => {\n                  let (params_te, ret_te) = sig\n                  let resolved_params = for pte in params_te {\n                    relax_unknown_named(subst_self_in_type(resolve_type_expr(pte, defs), self_ty), defs)\n                  }\n                  let resolved_ret = relax_unknown_named(subst_self_in_type(resolve_type_expr(ret_te, defs), self_ty), defs)\n                  result = Some(CtFn(resolved_params, resolved_ret, None))\n                },\n                None => ()\n              }\n            } else {\n              ()\n            }\n            bi = bi + 1\n          }\n          result\n        },\n        _ => None\n      },\n      None => None\n    }\n  }\n}\n\n/// Resolve a qualified constructor reference `Enum::Variant` (e.g. `Color::Red`,\n/// `Sh::Circle`) to the bare variant's constructor type. The bare variant name\n/// is already bound in `env` by the SEnum case; we only confirm `head` names a\n/// known enum that actually owns `member` (so unrelated `T::method` names fall\n/// through to the `unknown name` path). Returns the polymorphic env type as-is;\n/// callers instantiate it exactly like a bare ident. (#672 qualified ctors.)\nfn resolve_qualified_ctor_ident(name: String, env: TypeEnv, defs: Array[TypeDef]) -> Option[Type] {\n  let idx = String::index_of(name, \"::\")\n  if idx < 0 {\n    None\n  } else {\n    let head = String::substring(name, 0, idx)\n    let member = String::substring(name, idx + 2, String::length(name))\n    match find_typedef(defs, head) {\n      Some(TDEnum(_, _, variants)) => {\n        let mut found = false\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, _) = Array::get(variants, vi)\n          if vname == member {\n            found = true\n          } else {\n            ()\n          }\n          vi = vi + 1\n        }\n        if found {\n          env_lookup(env, member)\n        } else {\n          None\n        }\n      },\n      _ => None\n    }\n  }\n}\n\nfn expr_ident_name_or_empty(expr: Expr) -> String {\n  match expr {\n    EIdent(name, _) => name,\n    _ => \"\"\n  }\n}\n\n/// Erase every effect annotation in a type (recursively), so an argument can be\n/// checked for STRUCTURAL compatibility independent of effects. Effects on\n/// function VALUES are inferred imprecisely (a `with { Error }` callback often\n/// arrives typed with no effect), so an effect-only difference must not be\n/// reported as a type error — only the structural shape is enforced here.\nfn strip_effects(ty: Type) -> Type {\n  match ty {\n    CtFn(params, ret, _) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(params) {\n        Array::push(out, strip_effects(Array::get(params, i)))\n        i = i + 1\n      }\n      CtFn(out, strip_effects(ret), None)\n    },\n    CtArray(elem) => CtArray(strip_effects(elem)),\n    CtOption(elem) => CtOption(strip_effects(elem)),\n    CtTuple(elems) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(elems) {\n        Array::push(out, strip_effects(Array::get(elems, i)))\n        i = i + 1\n      }\n      CtTuple(out)\n    },\n    CtNamed(name, args) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(out, strip_effects(Array::get(args, i)))\n        i = i + 1\n      }\n      CtNamed(name, out)\n    },\n    _ => ty\n  }\n}\n\n/// True when a type is fully ground (mentions no type parameter / type\n/// variable). An unresolved type name resolves to `CtNamed(_, _)` (see\n/// resolve_type_expr), which for a struct field or function parameter means a\n/// generic parameter like `T`; `CtVar`/`CtForAll` are likewise non-ground. Used\n/// both to restrict record struct-identity recovery to MONOMORPHIC structs (a\n/// bare `CtStruct(LazyIter)` would erase the element type that `for x in it`\n/// relies on) and to gate structural-mismatch reporting to concrete types.\n/// #635: does a match-arm body DIVERGE (early-`return`), yielding no value to the\n/// match? The `?`-operator desugar lowers `val?` to\n///   match val { Some(v) => v, None => return None }\n/// whose `None` arm is `return None` — it must not force the match's result type\n/// (else `T` vs `Option[T]` clashes). A diverging arm is a bare `return`, or a\n/// block (`ESeq`) whose final expr diverges.\nfn arm_body_diverges(body: Expr) -> Bool {\n  match body {\n    EReturn(_) => true,\n    ESeq(_, rest) => arm_body_diverges(rest),\n    _ => false\n  }\n}\n\n/// #941: the railway monad HEAD of a type — 1 for Option, 2 for Result, 0 for\n/// anything else. `Option[T]` is the builtin `CtOption`; the prelude `Result`\n/// is an injected user-level enum, so a constructed value surfaces as\n/// `CtNamed(\"Result\", args)` (or bare `CtEnum(\"Result\")`). Mixing the two\n/// monads on one railway (`?` / `let*` — docs/cheatsheet.md #635) is documented\n/// as a type error, but `check_assignable` tolerates the pair silently: a\n/// `CtNamed` head is kind 0 in `head_kind` (it may be a rigid type parameter)\n/// and makes `type_no_named` false, so NEITHER report gate fires and the\n/// mismatch sailed through to a runtime `unreachable` trap. The name-based\n/// check below is safe precisely because \"Result\"/\"Option\" as heads are the\n/// prelude monads — a rigid type parameter never carries those names.\nfn railway_head(t: Type) -> Int {\n  match t {\n    CtOption(_) => 1,\n    CtEnum(n) => if n == \"Result\" {\n      2\n    } else if n == \"Option\" {\n      1\n    } else {\n      0\n    },\n    CtNamed(n, _) => if n == \"Result\" {\n      2\n    } else if n == \"Option\" {\n      1\n    } else {\n      0\n    },\n    _ => 0\n  }\n}\n\n/// #941: true when `expected` and `actual` sit on DIFFERENT railway monads\n/// (one Option-headed, the other Result-headed). No instantiation of inner\n/// type parameters can ever reconcile the two heads, so this is a genuine\n/// mismatch even though both types mention type variables / named params.\nfn railway_heads_conflict(expected: Type, actual: Type) -> Bool {\n  let he = railway_head(expected)\n  let ha = railway_head(actual)\n  he != 0 && ha != 0 && he != ha\n}\n\n/// #941: best-effort source anchor for a (possibly desugar-generated) expr —\n/// the first real char offset found walking into the value position, or -1.\n/// The railway desugar (#635) threads the `?`/`let*` operand's offset into its\n/// generated `Err(..)`/`None` failure-track nodes, so the mixing diagnostics\n/// below locate at the offending operand.\nfn railway_expr_off(e: Expr) -> Int {\n  match e {\n    EIdent(_, off) => off,\n    ECall(callee, _, off) => if off >= 0 {\n      off\n    } else {\n      railway_expr_off(callee)\n    },\n    EDot(base, _, off, _) => if off >= 0 {\n      off\n    } else {\n      railway_expr_off(base)\n    },\n    EBinOp(_, lhs, _) => railway_expr_off(lhs),\n    EMatch(scrut, _) => railway_expr_off(scrut),\n    ESeq(first, _) => railway_expr_off(first),\n    _ => 0 - 1\n  }\n}\n\nfn type_is_ground(t: Type) -> Bool {\n  match t {\n    CtNamed(_, _) => false,\n    CtVar(_) => false,\n    CtForAll(_, _, _) => false,\n    CtTuple(items) => {\n      let mut ok = true\n      let mut i = 0\n      while i < Array::length(items) {\n        if !type_is_ground(Array::get(items, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    CtArray(e) => type_is_ground(e),\n    CtOption(e) => type_is_ground(e),\n    CtFn(ps, r, _) => {\n      let mut ok = type_is_ground(r)\n      let mut i = 0\n      while i < Array::length(ps) {\n        if !type_is_ground(Array::get(ps, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    _ => true\n  }\n}\n\n/// #1081 step 3: does a FULLY-ZONKED type contain a `CtNamed` with exactly\n/// this name anywhere in its structure? Used to detect a region skolem\n/// (`\"#region_<n>\"`, unforgeable by parsed source) escaping its\n/// `TaskGroup::run` call. The caller must `subst_apply` before calling this\n/// — an un-zonked `CtVar` cannot be inspected here (deliberately no\n/// substitution lookup: this function has no `Subst` to chase, and the two\n/// call sites both already pass zonked input).\nfn type_mentions_named(ty: Type, name: String) -> Bool {\n  match ty {\n    CtNamed(n, targs) => if n == name {\n      true\n    } else {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(targs) {\n        if type_mentions_named(Array::get(targs, i), name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    CtTuple(items) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(items) {\n        if type_mentions_named(Array::get(items, i), name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    CtArray(e) => type_mentions_named(e, name),\n    CtOption(e) => type_mentions_named(e, name),\n    CtFn(ps, ret, _) => {\n      let mut found = type_mentions_named(ret, name)\n      let mut i = 0\n      while i < Array::length(ps) {\n        if type_mentions_named(Array::get(ps, i), name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    CtForAll(_, _, body) => type_mentions_named(body, name),\n    _ => false\n  }\n}\n\n/// #1081 step 3: every (name, type) binding currently visible in `env`,\n/// walking the same cons-chain shape `env_cache` (core/types.vibe) already\n/// walks — trait-def/impl layers carry no ordinary value binding and are\n/// skipped, matching that traversal. Used by the `TaskGroup::run` escape\n/// check to scan every OUTER binding (never a binding local to the nursery\n/// body itself, since those live in a DERIVED env built while checking the\n/// body, not in the `env` captured at the call site) for a leaked region\n/// skolem after the body has been checked.\nfn collect_env_bindings(env: TypeEnv, acc: Array[(String, Type)]) -> Unit {\n  match env {\n    EnvEmpty => (),\n    EnvBind(n, ty, rest) => {\n      Array::push(acc, (n, ty))\n      collect_env_bindings(rest, acc)\n    },\n    EnvTraitDef(_, _, _, _, rest) => collect_env_bindings(rest, acc),\n    EnvTraitImpl(_, _, rest) => collect_env_bindings(rest, acc),\n    EnvTraitImplGen(_, _, _, _, rest) => collect_env_bindings(rest, acc),\n    EnvFlat(bindings) => {\n      let mut i = 0\n      while i < Array::length(bindings) {\n        Array::push(acc, Array::get(bindings, i))\n        i = i + 1\n      }\n    },\n    EnvCached(names, types, rest) => {\n      let mut i = 0\n      while i < Array::length(names) {\n        Array::push(acc, (Array::get(names, i), Array::get(types, i)))\n        i = i + 1\n      }\n      collect_env_bindings(rest, acc)\n    }\n  }\n}\n\n/// True when a type mentions no RIGID type parameter (`CtNamed` / `CtForAll`) but\n/// MAY contain inference variables (`CtVar`). Used to recognise an `actual` type\n/// whose only flexibility is unification variables: if such a type fails to unify\n/// against a fully GROUND expected type, no instantiation of its variables can\n/// make it match, so the mismatch is real (unlike an un-instantiated generic\n/// param `CtNamed(T)`, which the checker simply has not substituted yet).\nfn type_no_named(t: Type) -> Bool {\n  match t {\n    CtNamed(_, _) => false,\n    CtForAll(_, _, _) => false,\n    CtTuple(items) => {\n      let mut ok = true\n      let mut i = 0\n      while i < Array::length(items) {\n        if !type_no_named(Array::get(items, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    CtArray(e) => type_no_named(e),\n    CtOption(e) => type_no_named(e),\n    CtFn(ps, r, _) => {\n      let mut ok = type_no_named(r)\n      let mut i = 0\n      while i < Array::length(ps) {\n        if !type_no_named(Array::get(ps, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    _ => true\n  }\n}\n\n/// A small tag for a type's TOP-LEVEL constructor, or 0 for a type whose head is\n/// not concrete (a type variable / unresolved named param / unknown / forall).\n/// Two types with DIFFERENT non-zero heads can never be made equal by any\n/// instantiation of their inner type parameters (an `Int` is never an `Array[T]`\n/// for any `T`), so such a unify failure is a real mismatch even when the inner\n/// parts are generic — which the whole-type groundness gate misses.\nfn head_kind(t: Type) -> Int {\n  match t {\n    CtInt => 1,\n    CtDouble => 2,\n    CtBool => 3,\n    CtString => 4,\n    CtChar => 5,\n    CtUnit => 6,\n    CtBytes => 7,\n    CtTuple(_) => 8,\n    CtArray(_) => 9,\n    CtOption(_) => 10,\n    CtStruct(_) => 11,\n    CtEnum(_) => 12,\n    CtFn(_, _, _) => 13,\n    _ => 0\n  }\n}\n\n/// #827: `Stream[T]` is `CtNamed` (head_kind 0 = tolerated), so the Array\n/// builtins' receiver head check let `Array::length(stream)` / `Array::get(s,\n/// 0)` through — observably leaking the eager Array-backed representation\n/// (ADR-0012) into user programs. Recognise a Stream receiver so the Array\n/// head-check sites can reject it explicitly; head_kind itself is unchanged\n/// (other CtNamed heads stay tolerated, the #826 discipline).\nfn is_stream_named_type(t: Type) -> Bool {\n  match t {\n    CtNamed(n, _) => n == \"Stream\",\n    _ => false\n  }\n}\n\n/// True when every declared field type of a struct is ground (the struct is not\n/// generic). `S::{ ... }` for such a struct can safely be typed `CtStruct(S)`.\nfn struct_fields_ground(dfields: Array[(String, Type)]) -> Bool {\n  let mut ok = true\n  let mut i = 0\n  while i < Array::length(dfields) {\n    let (_, ft) = Array::get(dfields, i)\n    if !type_is_ground(ft) {\n      ok = false\n    }\n    i = i + 1\n  }\n  ok\n}\n\n/// #939 helpers: detect a function VALUE laundering a concrete effect row away\n/// through a pure-typed slot (HOF argument, let/struct-field/array annotation).\n/// The strip_effects fallback below deliberately tolerates effect-only\n/// differences — but for CONCRETE, non-exempt labels flowing in a COVARIANT\n/// position that tolerance is the #939 soundness hole: the value's perform\n/// executes with no handler and the program dies with an unhandled wasm\n/// exception at runtime. Exemptions mirror checker_effects' transitive pass:\n/// `Error` (pervasive un-annotated throw sites, #640), `Async`\n/// (composition-allowed), and effect VARIABLES (single lowercase letter /\n/// `$N` fresh vars — not decidable without call-site row unification, #885).\nfn effect_label_is_exempt(lbl: String) -> Bool {\n  let len = String::length(lbl)\n  if lbl == \"Error\" || lbl == \"Async\" {\n    true\n  } else if len == 1 {\n    String::char_code_at(lbl, 0) >= 97 && String::char_code_at(lbl, 0) <= 122\n  } else if len >= 2 {\n    String::char_code_at(lbl, 0) == 36\n  } else {\n    true\n  }\n}\n\nfn row_labels(row: Option[String]) -> Array[String] {\n  match row {\n    Some(r) => {\n      let parts = String::split(r, \",\")\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(parts) {\n        let t = String::trim(Array::get(parts, i))\n        if String::length(t) > 0 {\n          Array::push(out, t)\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      out\n    },\n    None => array_empty()\n  }\n}\n\nfn row_contains_label(row: Option[String], lbl: String) -> Bool {\n  let labels = row_labels(row)\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(labels) && !found {\n    if Array::get(labels, i) == lbl {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// First concrete, non-exempt effect label whose drop would let a perform run\n/// with no handler. At each CtFn the ACTUAL side's own row must not carry a\n/// label the EXPECTED side's row lacks; the return type recurses covariantly;\n/// PARAMETER positions recurse with expected/actual SWAPPED (contravariance —\n/// Codex P1 on #978: an `((Int) -> Int with { Logger }, Int) -> Int` slot\n/// holding a pure-callback fn lets `h(eff, 1)` type-check while the callee\n/// invokes the effectful callback with no handler, so at parameter positions\n/// it is the EXPECTED param's concrete labels that must be tolerated by the\n/// ACTUAL param). pure→effectful still passes in both directions by\n/// construction, and an effectful parameter slot accepting a pure function\n/// stays legal (the swap makes that the label-free side).\nfn effect_row_dropped(expected: Type, actual: Type) -> Option[String] {\n  match expected {\n    CtFn(eparams, eret, eeff) => match actual {\n      CtFn(aparams, aret, aeff) => {\n        let alabels = row_labels(aeff)\n        let mut i = 0\n        let mut dropped = None\n        let mut done = false\n        while i < Array::length(alabels) && !done {\n          let lbl = Array::get(alabels, i)\n          if !effect_label_is_exempt(lbl) && !row_contains_label(eeff, lbl) {\n            dropped = Some(lbl)\n            done = true\n          } else {\n            ()\n          }\n          i = i + 1\n        }\n        if !done && Array::length(eparams) == Array::length(aparams) {\n          let mut pi = 0\n          while pi < Array::length(eparams) && !done {\n            match effect_row_dropped(Array::get(aparams, pi), Array::get(eparams, pi)) {\n              Some(pl) => {\n                dropped = Some(pl)\n                done = true\n              },\n              None => ()\n            }\n            pi = pi + 1\n          }\n        } else {\n          ()\n        }\n        match dropped {\n          Some(l) => Some(l),\n          None => effect_row_dropped(eret, aret)\n        }\n      },\n      _ => None\n    },\n    CtArray(ee) => match actual {\n      CtArray(ae) => effect_row_dropped(ee, ae),\n      _ => None\n    },\n    CtOption(ee) => match actual {\n      CtOption(ae) => effect_row_dropped(ee, ae),\n      _ => None\n    },\n    CtTuple(ees) => match actual {\n      CtTuple(aes) => if Array::length(ees) == Array::length(aes) {\n        let mut i = 0\n        let mut dropped = None\n        let mut done = false\n        while i < Array::length(ees) && !done {\n          match effect_row_dropped(Array::get(ees, i), Array::get(aes, i)) {\n            Some(d) => {\n              dropped = Some(d)\n              done = true\n            },\n            None => ()\n          }\n          i = i + 1\n        }\n        dropped\n      } else {\n        None\n      },\n      _ => None\n    },\n    CtNamed(en, eargs) => match actual {\n      CtNamed(an, aargs) => if en == an && Array::length(eargs) == Array::length(aargs) {\n        let mut i = 0\n        let mut dropped = None\n        let mut done = false\n        while i < Array::length(eargs) && !done {\n          match effect_row_dropped(Array::get(eargs, i), Array::get(aargs, i)) {\n            Some(d) => {\n              dropped = Some(d)\n              done = true\n            },\n            None => ()\n          }\n          i = i + 1\n        }\n        dropped\n      } else {\n        None\n      },\n      _ => None\n    },\n    _ => None\n  }\n}\n\n/// Unify `expected` with `actual`, REPORTING only a genuine STRUCTURAL mismatch\n/// (the checker historically swallowed these, accepting ill-typed programs).\n/// `unify` already accepts `CtUnknown`/`CtVar` freely; on failure we retry with\n/// effects erased, and tolerate the difference if the structure matches — effect\n/// inference on function values is imprecise, so effect-only differences must not\n/// be reported here (EXCEPT a concrete covariant row drop — see\n/// `effect_row_dropped` above, #939). Returns the (possibly extended)\n/// substitution.\nexport fn check_assignable(expected: Type, actual: Type, s: Subst, errors: Array[String], what: String, off: Int) -> Subst {\n  match unify(expected, actual, s) {\n    Some(su) => su,\n    None => {\n      let structural = match unify(strip_effects(expected), strip_effects(actual), s) {\n        Some(_) => true,\n        None => false\n      }\n      // Only report when BOTH sides are fully ground (mention no type parameter\n      // / type variable). The checker does not instantiate a generic\n      // struct field's or function parameter's type params — they surface as\n      // rigid `CtNamed(T, _)` — so a unify failure against a concrete\n      // instantiation there is NOT a real mismatch (e.g. a `pull: (Int) ->\n      // Option[(T, Int)]` field vs a concrete closure). Reporting only on\n      // ground/ground keeps the genuine concrete-type mismatches (Int vs\n      // String, struct field of the wrong concrete type) while not\n      // over-rejecting polymorphic code.\n      // Report when the EXPECTED type is fully ground and the ACTUAL type\n      // mentions no rigid type parameter (inference variables are fine). A\n      // unify failure under those conditions is genuine: no instantiation of\n      // the actual's variables can satisfy the concrete expected type (this is\n      // what catches `let g: (Int) -> String = (n) -> { n }`). A non-ground\n      // expected, or an actual carrying an un-instantiated generic `CtNamed`,\n      // is still tolerated to avoid over-rejecting polymorphic code.\n      let reportable = type_is_ground(subst_apply(s, expected)) && type_no_named(subst_apply(s, actual))\n      // Also report when the two types have DIFFERENT concrete top-level\n      // constructors (e.g. `Array[T]` vs `Int` from `Array::length(5)`): no\n      // instantiation of inner type parameters can reconcile them, so it is a\n      // real mismatch even though the expected type is non-ground. A\n      // var/named/unknown head (kind 0) on either side stays tolerated.\n      let eh = head_kind(subst_apply(s, expected))\n      let ah = head_kind(subst_apply(s, actual))\n      let head_differ = eh != 0 && ah != 0 && eh != ah\n      // #1001: a `CtNamed` head is kind 0 in `head_kind` (may be a rigid type\n      // parameter), so `Result[Int,String]` vs `Option[Int]` — or the same\n      // pair nested inside `Array[_]`/`Option[_]`/a tuple/a fn signature —\n      // sails past `head_differ` untouched, and `detect_narrowed_generic_mismatch`\n      // below only fires on a SAME-name pair, so a genuinely DIFFERENT nominal\n      // head was never reported at all. Check that ahead of the existing\n      // gates; internally gated on `type_fully_concrete` so a still-rigid\n      // type parameter never triggers it.\n      let nominal_conflict = nominal_head_conflict(subst_apply(s, expected), subst_apply(s, actual))\n      if nominal_conflict {\n        Array::push(errors, String::concat(what, String::concat(\": expected \", String::concat(type_to_string(subst_apply(s, expected)), String::concat(\", got \", String::concat(type_to_string(subst_apply(s, actual)), off_marker(off)))))))\n        s\n      } else if structural {\n        // #939: the structural retry tolerated EVERY effect-only difference,\n        // including a function value whose CONCRETE row silently vanishes\n        // into a pure-typed slot (HOF argument, let / struct field / array\n        // annotation) — the perform then runs with no handler and dies as an\n        // unhandled wasm exception at runtime. Report exactly that shape;\n        // pure→effectful subsumption and Error/Async/effect-var differences\n        // stay tolerated (see effect_row_dropped).\n        match effect_row_dropped(subst_apply(s, expected), subst_apply(s, actual)) {\n          Some(lbl) => {\n            Array::push(errors, String::concat(what, String::concat(\": effect row mismatch: a value of type \", String::concat(type_to_string(subst_apply(s, actual)), String::concat(\" cannot be used where \", String::concat(type_to_string(subst_apply(s, expected)), String::concat(\" is expected (the { \", String::concat(lbl, String::concat(\" } effect would be dropped — no handler could ever run)\", off_marker(off))))))))))\n            s\n          },\n          None => s\n        }\n      } else if !(reportable || head_differ) {\n        // #981: a user generic type's ARGUMENTS were never compared here — a\n        // `CtNamed` head is kind 0 (tolerated by `head_differ`) and makes\n        // `type_no_named(actual)` false, so `get_int(b)` with\n        // `b: Box[String]` against `Box[Int]` sailed through this branch\n        // silently (compile clean, heap-pointer garbage at runtime), while\n        // the symmetric builtin (`Array[String]` vs `Array[Int]`) and the\n        // RETURN position were both rejected. Close exactly that hole with\n        // the proven #844 predicate (`detect_narrowed_generic_mismatch`):\n        // report ONLY a same-name, same-arity (> 0), fully-concrete `CtNamed`\n        // pair whose arguments fail to unify — a rigid/uninstantiated type\n        // parameter surfaces as `CtNamed(T, [])` / the `[CtUnknown]` sentinel\n        // and stays tolerated, so polymorphic code is not over-rejected.\n        // Additionally gate on the RAW expected type (BEFORE subst) being\n        // fully concrete: an expected that only became concrete through this\n        // call's own unification is not trustworthy — an IMPORTED generic\n        // fn's signature can cross-talk its type params through the flat\n        // import env (measured: `list_zip[A, B]` imported from\n        // lib/@vibe/core/list.vibe reported `expected List[String], got\n        // List[Int]` on its second argument — A's binding leaked into B's\n        // slot), and reporting that shape would reject valid polymorphic\n        // calls. A monomorphic signature (the #981 hole) is concrete without\n        // any substitution, so the genuine cases all keep reporting.\n        if type_fully_concrete(expected) {\n          detect_narrowed_generic_mismatch(expected, actual, s, errors, what, off)\n        } else {\n          s\n        }\n      } else {\n        Array::push(errors, String::concat(what, String::concat(\": expected \", String::concat(type_to_string(subst_apply(s, expected)), String::concat(\", got \", String::concat(type_to_string(subst_apply(s, actual)), off_marker(off)))))))\n        s\n      }\n    }\n  }\n}\n\n/// #1001: the type's outer constructor's nominal name, when it is one that can\n/// NEVER be a placeholder for a still-unresolved rigid type parameter --\n/// `CtOption` (the builtin `Option[T]`; `Option` written as an annotation\n/// resolves to this, not `CtNamed(\"Option\", _)` -- see `railway_head` above)\n/// and `CtEnum`/`CtStruct` (a RESOLVED reference to a declared enum/struct,\n/// always concrete) are unconditionally trustworthy. A bare `CtNamed(n, _)`\n/// is ambiguous -- it is ALSO how an uninstantiated generic type parameter\n/// surfaces (`CtNamed(\"T\", [])`) -- so it only counts when\n/// `type_fully_concrete` confirms this occurrence is not that sentinel shape.\n/// `None` means \"nothing nominal to compare\" (a type variable, a builtin\n/// scalar, a container whose own head isn't itself nominal, etc).\nfn nominal_name_of(t: Type) -> Option[String] {\n  match t {\n    CtOption(_) => Some(\"Option\"),\n    CtEnum(n) => Some(n),\n    CtStruct(n) => Some(n),\n    CtNamed(n, _) => if type_fully_concrete(t) {\n      Some(n)\n    } else {\n      None\n    },\n    _ => None\n  }\n}\n\n/// #1001: true when `expected` and `actual` carry a corresponding pair of\n/// nominal names that DIFFER, anywhere in their structure -- e.g.\n/// `Result[Int,String]` (`CtNamed`) vs `Option[Int]` (the builtin `CtOption`),\n/// or the same pair nested inside `Array[_]`/`Option[_]`/a tuple/a fn\n/// signature/a same-named `CtNamed`'s own type arguments (mirroring\n/// `effect_row_dropped`'s traversal above). No instantiation of type\n/// PARAMETERS can ever reconcile two DIFFERENT nominal names, so this is a\n/// genuine mismatch regardless of arity or which concrete `Type` shape either\n/// side happens to be represented as -- unlike `detect_narrowed_generic_mismatch`\n/// below, which only catches a SAME-name `CtNamed`/`CtNamed` mismatch (e.g.\n/// `Box[Int]` vs `Box[String]`, #981) and never even inspects a\n/// `CtArray[Option[Int]]` vs `CtArray[Result[Int,String]]` pair's nested heads,\n/// nor a builtin `CtOption` against a `CtNamed`/`CtEnum` nominal type, at all.\nfn nominal_head_conflict(expected: Type, actual: Type) -> Bool {\n  let direct_conflict = match nominal_name_of(expected) {\n    Some(en) => match nominal_name_of(actual) {\n      Some(an) => en != an,\n      None => false\n    },\n    None => false\n  }\n  if direct_conflict {\n    true\n  } else {\n    match expected {\n      CtNamed(_, eargs) => match actual {\n        CtNamed(_, aargs) => if Array::length(eargs) == Array::length(aargs) {\n          let mut i = 0\n          let mut conflict = false\n          while i < Array::length(eargs) && !conflict {\n            if nominal_head_conflict(Array::get(eargs, i), Array::get(aargs, i)) {\n              conflict = true\n            } else {\n              ()\n            }\n            i = i + 1\n          }\n          conflict\n        } else {\n          false\n        },\n        _ => false\n      },\n      CtArray(ee) => match actual {\n        CtArray(ae) => nominal_head_conflict(ee, ae),\n        _ => false\n      },\n      CtOption(ee) => match actual {\n        CtOption(ae) => nominal_head_conflict(ee, ae),\n        _ => false\n      },\n      CtTuple(ees) => match actual {\n        CtTuple(aes) => if Array::length(ees) == Array::length(aes) {\n          let mut i = 0\n          let mut conflict = false\n          while i < Array::length(ees) && !conflict {\n            if nominal_head_conflict(Array::get(ees, i), Array::get(aes, i)) {\n              conflict = true\n            } else {\n              ()\n            }\n            i = i + 1\n          }\n          conflict\n        } else {\n          false\n        },\n        _ => false\n      },\n      CtFn(eps, er, _) => match actual {\n        CtFn(aps, ar, _) => if Array::length(eps) == Array::length(aps) {\n          let mut i = 0\n          let mut conflict = nominal_head_conflict(er, ar)\n          while i < Array::length(eps) && !conflict {\n            if nominal_head_conflict(Array::get(eps, i), Array::get(aps, i)) {\n              conflict = true\n            } else {\n              ()\n            }\n            i = i + 1\n          }\n          conflict\n        } else {\n          false\n        },\n        _ => false\n      },\n      _ => false\n    }\n  }\n}\n\n/// #844: true when `t` mentions no unresolved/rigid type-parameter placeholder\n/// and no unbound unification variable ANYWHERE in its structure -- i.e. it is\n/// a genuinely CONCRETE type. Unlike the more conservative shared\n/// `type_is_ground` (which treats EVERY `CtNamed` as non-ground, to stay safe\n/// for the many call sites that must still tolerate a rigid/uninstantiated\n/// type parameter such as a trait method's `CtNamed(\"T\", _)` field type), this\n/// recurses into `CtNamed`'s own type arguments. Used ONLY by\n/// `detect_narrowed_generic_mismatch` below (a narrowly-scoped, additive check\n/// for the `let`-annotation erasure hole -- see #844) so this refinement's\n/// blast radius stays contained to that one new check instead of the many\n/// existing `type_is_ground` call sites.\n///\n/// The sentinel shape `CtNamed(name, [CtUnknown])` is what `resolve_type_expr`\n/// (checker_resolve.vibe) emits for an unresolved rigid single-name type\n/// parameter reference AND for an unresolved/unknown type name alike -- treat\n/// that shape as non-concrete. A REAL instantiated generic type (e.g. #829's\n/// `Box::{v:1}` -> `CtNamed(\"Box\", [CtInt])`) never carries the bare\n/// `CtUnknown` sentinel as its own argument.\nfn type_fully_concrete(t: Type) -> Bool {\n  match t {\n    CtVar(_) => false,\n    CtForAll(_, _, _) => false,\n    CtUnknown => false,\n    // A `CtNamed` with an EMPTY argument list is ALSO treated as non-concrete\n    // (not just the `[CtUnknown]` singlet sentinel above): a rigid/uninstantiated\n    // generic function's own type parameter can leak through, unsubstituted,\n    // as a bare `CtNamed(pname, [])` when it only appears NESTED inside another\n    // type's argument list (e.g. `HashMap::new_int[V]() -> HashMap[Int, V]`\n    // called as `HashMap::new_int()` -- `instantiate` does not always rewrite\n    // an occurrence of `V` buried inside a struct's own field/return-type\n    // representation to a fresh `CtVar`, so it can surface literally as\n    // `CtNamed(\"V\", [])` instead -- lib/@vibe/core/hashmap_test.vibe\n    // hit exactly this via `let m: HashMap[Int, String] = HashMap::new_int()`\n    // during development of this check). Both shapes are the SAME underlying\n    // ambiguity (a name with no way to tell \"resolved zero-arg nominal type\"\n    // from \"unresolved rigid reference\" apart) that the shared `type_is_ground`\n    // sidesteps by always tolerating `CtNamed`; treat both as non-concrete here\n    // too so this narrowly-scoped check only ever fires when it is SURE both\n    // sides are fully resolved.\n    CtNamed(_, args) => {\n      let is_sentinel = Array::length(args) == 0 || (Array::length(args) == 1 && match Array::get(args, 0) {\n        CtUnknown => true,\n        _ => false\n      })\n      if is_sentinel {\n        false\n      } else {\n        let mut ok = true\n        let mut i = 0\n        while i < Array::length(args) {\n          if !type_fully_concrete(Array::get(args, i)) {\n            ok = false\n          }\n          i = i + 1\n        }\n        ok\n      }\n    },\n    CtTuple(items) => {\n      let mut ok = true\n      let mut i = 0\n      while i < Array::length(items) {\n        if !type_fully_concrete(Array::get(items, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    CtArray(e) => type_fully_concrete(e),\n    CtOption(e) => type_fully_concrete(e),\n    CtFn(ps, r, _) => {\n      let mut ok = type_fully_concrete(r)\n      let mut i = 0\n      while i < Array::length(ps) {\n        if !type_fully_concrete(Array::get(ps, i)) {\n          ok = false\n        }\n        i = i + 1\n      }\n      ok\n    },\n    _ => true\n  }\n}\n\n/// #844: `resolve_type_expr` types a BARE (unparameterized) reference to a\n/// generic struct annotation (`let x: Box = ...`) as bare `CtStruct(\"Box\")`,\n/// discarding the struct's real type arguments -- and `unify`'s\n/// `CtStruct`/`CtNamed` bridge (core/types.vibe, #829/#843) then lets that bare\n/// annotation re-unify by NAME ALONE with any later, unrelated instantiation\n/// (`let y: Box[String] = x`), silently re-narrowing a laundered value. Fixing\n/// that erasure at its source (threading fresh type variables through\n/// `resolve_type_expr`) touches its ~20 call sites across the whole checker\n/// and was judged too wide-blast-radius to land in one pass (#844); this is\n/// the narrower, additive half of the fix that IS safe to land: when BOTH the\n/// expected annotation and the actual value are already a fully concrete,\n/// SAME-NAME `CtNamed` instantiation (arity > 0) and their arguments do not\n/// unify, report the mismatch directly -- bypassing `check_assignable`'s\n/// `type_is_ground` gate, which (deliberately, to stay lenient for genuinely\n/// rigid/uninstantiated type parameters elsewhere) treats every `CtNamed` as\n/// non-ground and so never reports this shape at all. Gated on\n/// `type_fully_concrete` on BOTH sides so a still-polymorphic case (either\n/// side embedding an unresolved rigid parameter or unbound type variable, e.g.\n/// a trait-generic `LazyIter[T]` return before `T` is resolved) is never\n/// flagged -- only a same-name mismatch where both sides are already fully\n/// resolved concrete types.\nexport fn detect_narrowed_generic_mismatch(expected: Type, actual: Type, s: Subst, errors: Array[String], what: String, off: Int) -> Subst {\n  let e2 = subst_apply(s, expected)\n  let a2 = subst_apply(s, actual)\n  match e2 {\n    CtNamed(ename, eargs) => match a2 {\n      CtNamed(aname, aargs) => if ename == aname && Array::length(eargs) == Array::length(aargs) && Array::length(eargs) > 0 && type_fully_concrete(e2) && type_fully_concrete(a2) {\n        match unify(e2, a2, s) {\n          Some(_) => s,\n          None => {\n            Array::push(errors, String::concat(what, String::concat(\": expected \", String::concat(type_to_string(e2), String::concat(\", got \", String::concat(type_to_string(a2), off_marker(off)))))))\n            s\n          }\n        }\n      } else s,\n      _ => s\n    },\n    _ => s\n  }\n}\n\n/// #844: when a `let`-style annotation is a BARE (unparameterized) reference to\n/// a generic struct (`resolve_type_expr` resolves it to bare `CtStruct(name)`,\n/// discarding type args) and the RHS's ACTUAL inferred type is already a\n/// concrete instantiation of that SAME struct (`CtNamed(name, args)`, arity >\n/// 0, from #829's struct-literal instantiation), prefer recording the RHS's\n/// real instantiated type for the binding instead of the erasing bare\n/// annotation. This does not change what the CURRENT statement accepts (the\n/// bare annotation already tolerates any instantiation via the unify bridge,\n/// unchanged here) -- it only changes what a LATER statement observes when it\n/// looks the binding up, so a subsequent re-narrowing annotation\n/// (`detect_narrowed_generic_mismatch` above) has real type information to\n/// compare against instead of an erased placeholder.\nexport fn preserve_generic_instantiation(resolved: Type, actual: Type) -> Type {\n  match resolved {\n    CtStruct(rname) => match actual {\n      CtNamed(aname, aargs) => if rname == aname && Array::length(aargs) > 0 {\n        actual\n      } else {\n        resolved\n      },\n      _ => resolved\n    },\n    _ => resolved\n  }\n}\n\n/// Struct construction `S::{ ... }` drops the name `S` at parse time (becomes a\n/// bare ERecord), so the struct is resolved by matching the field-name SET. True\n/// when `declared` and `actual` have the same field names.\nfn struct_field_names_match(declared: Array[(String, Type)], actual: Array[(String, Type)]) -> Bool {\n  if Array::length(declared) != Array::length(actual) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(declared) {\n      let (dn, _) = Array::get(declared, i)\n      let mut found = false\n      let mut j = 0\n      while j < Array::length(actual) {\n        let (an, _) = Array::get(actual, j)\n        if an == dn {\n          found = true\n        }\n        j = j + 1\n      }\n      if !found {\n        ok = false\n      }\n      i = i + 1\n    }\n    ok\n  }\n}\n\n/// #813: look up a qualified operation name (\"Eff::Op\") in the declared-effect\n/// registry (TDEffect defs). None when the name is unqualified, the effect is\n/// undeclared/builtin/generic, or the op is unknown WITHIN a declared effect is\n/// reported separately by the callers — this returns None only when there is\n/// nothing to validate against (pre-#813 behavior).\nfn effect_op_sig(defs: Array[TypeDef], qname: String) -> Option[(Array[Type], Type)] {\n  let ci = String::index_of(qname, \"::\")\n  if ci < 0 {\n    None\n  } else {\n    let eff = String::substring(qname, 0, ci)\n    let op = String::substring(qname, ci + 2, String::length(qname))\n    match find_typedef(defs, eff) {\n      Some(td) => match td {\n        TDEffect(_, ops) => {\n          let mut oi = 0\n          let mut found = None\n          while oi < Array::length(ops) {\n            let (oname, oparams, oret) = Array::get(ops, oi)\n            if oname == op {\n              found = Some((oparams, oret))\n            } else {\n              ()\n            }\n            oi = oi + 1\n          }\n          found\n        },\n        _ => None\n      },\n      None => None\n    }\n  }\n}\n\n/// #813: is `eff` a DECLARED effect (TDEffect) in this module? Distinguishes\n/// \"unknown op of a declared effect\" (reportable) from builtin/imported\n/// effects the registry cannot see (skip).\nfn effect_is_declared(defs: Array[TypeDef], eff: String) -> Bool {\n  match find_typedef(defs, eff) {\n    Some(td) => match td {\n      TDEffect(_, _) => true,\n      _ => false\n    },\n    None => false\n  }\n}\n\nfn lookup_actual_field_ty(actual: Array[(String, Type)], name: String) -> Option[Type] {\n  let mut i = 0\n  let mut out = None\n  while i < Array::length(actual) {\n    let (an, at) = Array::get(actual, i)\n    if an == name {\n      out = Some(at)\n    }\n    i = i + 1\n  }\n  out\n}\n\n/// True when `dfields` (a struct's declared fields) is a STRICT superset of the\n/// record literal's `actual` fields: every provided field name appears in the\n/// struct, and the struct declares strictly more fields. Used to flag a record\n/// that omits required fields.\nfn struct_is_strict_superset(dfields: Array[(String, Type)], actual: Array[(String, Type)]) -> Bool {\n  if Array::length(dfields) <= Array::length(actual) {\n    false\n  } else {\n    let mut i = 0\n    let mut all_in = true\n    while i < Array::length(actual) {\n      let (an, _) = Array::get(actual, i)\n      let mut found = false\n      let mut j = 0\n      while j < Array::length(dfields) {\n        let (dn, _) = Array::get(dfields, j)\n        if dn == an {\n          found = true\n        } else {\n          ()\n        }\n        j = j + 1\n      }\n      if !found {\n        all_in = false\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    all_in\n  }\n}\n\n/// Check a record literal's field VALUES against the declared field types of the\n/// (uniquely) matching struct definition — previously unchecked, so\n/// `S::{ x: \"oops\" }` for `struct S { x: Int }` was accepted. Conservative: if 0\n/// or >1 structs share the field-name set, skip (no struct could be determined).\nfn check_record_fields(defs: Array[TypeDef], actual: Array[(String, Type)], s: Subst, errors: Array[String]) -> Subst {\n  let mut matchct = 0\n  let mut matched_fields = array_empty()\n  let mut di = 0\n  while di < Array::length(defs) {\n    match Array::get(defs, di) {\n      TDStruct(_, dfields, _, _) => if struct_field_names_match(dfields, actual) {\n        matchct = matchct + 1\n        matched_fields = dfields\n      },\n      _ => ()\n    }\n    di = di + 1\n  }\n  if matchct == 1 {\n    let mut out = s\n    let mut i = 0\n    while i < Array::length(matched_fields) {\n      let (fname, declared_ty) = Array::get(matched_fields, i)\n      match lookup_actual_field_ty(actual, fname) {\n        Some(actual_ty) => {\n          out = check_assignable(declared_ty, subst_apply(out, actual_ty), out, errors, String::concat(\"struct field type mismatch for \", fname), 0 - 1)\n        },\n        None => ()\n      }\n      i = i + 1\n    }\n    out\n  } else if matchct > 1 {\n    // Ambiguous: MORE than one struct declares exactly this field-name set\n    // (e.g. `S2 { name: Int; y: String }` vs `S3 { y: String; name: String }`).\n    // The literal is a valid construction of one of them, we just cannot tell\n    // which — skip value checking, and in particular do NOT fall through to\n    // the missing-field superset heuristic below: it used to fire here and\n    // report a bogus \"missing field\" against some unrelated superset struct\n    // (found by fuzz/run_fuzz.sh, seeds 68/282).\n    s\n  } else {\n    // No struct has EXACTLY this field set. If exactly one struct is a strict\n    // SUPERSET (contains every provided field and at least one more), the record\n    // is that struct with fields MISSING — a real soundness hole, since the\n    // omitted fields would be left uninitialized. Reported only when the\n    // superset is unique (otherwise the intended struct is ambiguous → skip).\n    let mut supct = 0\n    let mut sup_name = \"\"\n    let mut sup_fields = array_empty()\n    let mut dj = 0\n    while dj < Array::length(defs) {\n      match Array::get(defs, dj) {\n        TDStruct(sname, dfields, _, _) => if struct_is_strict_superset(dfields, actual) {\n          supct = supct + 1\n          sup_name = sname\n          sup_fields = dfields\n        },\n        _ => ()\n      }\n      dj = dj + 1\n    }\n    if supct == 1 {\n      let mut fi = 0\n      while fi < Array::length(sup_fields) {\n        let (dn, _) = Array::get(sup_fields, fi)\n        match lookup_actual_field_ty(actual, dn) {\n          Some(_) => (),\n          None => Array::push(errors, String::concat(\"missing field `\", String::concat(dn, String::concat(\"` in construction of struct \", sup_name))))\n        }\n        fi = fi + 1\n      }\n      s\n    } else {\n      s\n    }\n  }\n}\n\n/// Resolve the (uniquely) matching struct name for a record literal's field-name\n/// set. Returns None when 0 or >1 structs share that field set (ambiguous), or\n/// when the matching struct is GENERIC (non-ground fields) — so a record's\n/// struct identity is only recovered for an unambiguous MONOMORPHIC struct. Used\n/// to give a bare `S::{ ... }` literal the type `CtStruct(S)` instead of\n/// CtUnknown, which in turn lets `mut`-field write checking see the struct\n/// without disturbing generic-struct inference.\nfn resolve_record_struct_name(defs: Array[TypeDef], actual: Array[(String, Type)]) -> Option[String] {\n  let mut matchct = 0\n  let mut out = None\n  let mut ground = false\n  let mut di = 0\n  while di < Array::length(defs) {\n    match Array::get(defs, di) {\n      TDStruct(sname, dfields, _, _) => if struct_field_names_match(dfields, actual) {\n        matchct = matchct + 1\n        out = Some(sname)\n        ground = struct_fields_ground(dfields)\n      },\n      _ => ()\n    }\n    di = di + 1\n  }\n  if matchct == 1 && ground {\n    out\n  } else {\n    None\n  }\n}\n\n/// Unify each argument against its parameter, REPORTING a type mismatch instead\n/// of silently swallowing it. `__to_string` (the polymorphic interpolation\n/// stringifier: `\"\\{x}\"` -> `__to_string(x)` wraps values of any type, but the\n/// polyfill annotates it `(Int) -> String`) is exempt.\nfn unify_call_args(param_tys: Array[Type], arg_tys: Array[Type], s: Subst, errors: Array[String], label: String, off: Int) -> Subst {\n  let mut out = s\n  let mut ui = 0\n  let ul = min_int(Array::length(arg_tys), Array::length(param_tys))\n  while ui < ul {\n    let pty = Array::get(param_tys, ui)\n    let aty = Array::get(arg_tys, ui)\n    out = if label == \"__to_string\" {\n      match unify(pty, aty, out) {\n        Some(su) => su,\n        None => out\n      }\n    } else {\n      check_assignable(pty, aty, out, errors, String::concat(\"argument type mismatch for \", label), off)\n    }\n    ui = ui + 1\n  }\n  out\n}\n\n/// #844: recognize the EXACT synthetic call shape `parser_expr_dispatch.vibe`'s\n/// `ascribe_wrap` builds for a LOCAL `let x: T = val` --\n/// `((__asc: T) -> __asc)(val)` -- and return its annotation `T`. `\"__asc\"` is\n/// a dedicated internal marker name (parallel to `\"__return__\"` /\n/// `\"__in_loop__\"` used elsewhere in this file), never written by real user\n/// code, so this match is precise: an ordinary lambda call (a real user IIFE)\n/// will not have a single param literally named `__asc` whose body is exactly\n/// `EIdent(\"__asc\", _)`. Used to run a dedicated, narrowly-scoped check for\n/// this one call shape (see the `ECall` fallback arm below) instead of\n/// changing the general call-argument checking (`unify_call_args`) that every\n/// other call in the language goes through.\nfn ascription_lambda_ann(callee: Expr) -> Option[TypeExpr] {\n  match callee {\n    EFn(tparams, _tbounds, params, ret_ty, effect, body) => if Array::length(tparams) == 0 && Array::length(params) == 1 {\n      match ret_ty {\n        Some(_) => None,\n        None => match effect {\n          Some(_) => None,\n          None => {\n            let (pname, pann) = Array::get(params, 0)\n            if pname == \"__asc\" {\n              match body {\n                EIdent(bname, _) => if bname == \"__asc\" {\n                  pann\n                } else {\n                  None\n                },\n                _ => None\n              }\n            } else {\n              None\n            }\n          }\n        }\n      }\n    } else {\n      None\n    },\n    _ => None\n  }\n}\n\nexport fn fn_return_env_name(name: String) -> String {\n  String::concat(\"__fn_ret__:\", name)\n}\n\n/// #938: the ArrayBuilder container type — `CtNamed(\"ArrayBuilder\", [elem])`,\n/// the same shape `b: ArrayBuilder[T]` annotations resolve to. Used by the\n/// builder call branches below. #983/#996 (Codex P2): `Map` is deliberately\n/// NOT listed here — `Map::set` is a FUNCTIONAL update (the linear codegen\n/// allocates a fresh count+1 map and leaves the receiver untouched; measured:\n/// `Map::has_key(m, \"a\")` is false after `let m2 = Map::set(m, \"a\", 1)`), so\n/// aliases of one empty `Map::new()` binding do NOT share a live value slot.\n/// Value-restricting Map would mis-reject\n/// `let e = Map::new(); Map::set(e, \"i\", 1); Map::set(e, \"s\", \"x\")` (two\n/// independent derived maps). Generalizing the empty literal's fresh slot is\n/// therefore sound; maps whose slot is already CONCRETE (from_pairs values,\n/// annotations, a set-chain's returned type) keep the #983 value check.\nfn is_array_builder_head(t: Type) -> Bool {\n  match t {\n    CtNamed(n, targs) => n == \"ArrayBuilder\" && Array::length(targs) == 1,\n    _ => false\n  }\n}\n\n/// #1081 step 3 Phase B: true when a `TaskGroup[r]` / `TaskHandle[r,_]` /\n/// `Sender[r,_]` / `Receiver[r,_]` region-tagged endpoint occurs anywhere in\n/// the value's type. Generalizing a `let`-bound endpoint (ordinary\n/// Hindley-Milner let-polymorphism, `generalize`) would sever its region\n/// argument from the skolem `TaskGroup::run` minted -- EVERY later reference\n/// re-instantiates a FRESH, unconnected region var, so `check_spawnable_\n/// captures`'s same-region comparison (checker_spawnable.vibe) could never\n/// see two endpoints from the same nursery as equal. Same value-restriction\n/// shape as `is_array_builder_ty` right below (a mutable container has the\n/// identical \"generalizing loses the identity a later use needs\" problem);\n/// bind the monotype instead.\nexport fn is_region_tagged_ty(t: Type) -> Bool {\n  match t {\n    CtNamed(n, targs) => if n == \"TaskGroup\" && Array::length(targs) == 2 {\n      true\n    } else if (n == \"TaskHandle\" || n == \"Sender\" || n == \"Receiver\") && Array::length(targs) == 3 {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(targs) && !found {\n        found = is_region_tagged_ty(Array::get(targs, i))\n        i = i + 1\n      }\n      found\n    },\n    CtArray(e) => is_region_tagged_ty(e),\n    CtOption(e) => is_region_tagged_ty(e),\n    CtTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) && !found {\n        found = is_region_tagged_ty(Array::get(elems, i))\n        i = i + 1\n      }\n      found\n    },\n    _ => false\n  }\n}\n\n/// #938 value-restriction predicate (Codex P1 on #977): true when a builder\n/// occurs ANYWHERE in the value's type reachable without crossing a function\n/// boundary — `(ArrayBuilder::new(), 0)`, `[ArrayBuilder::new()]`,\n/// `Some(ArrayBuilder::new())` all alias ONE live builder, so their element\n/// vars must stay un-quantified exactly like a bare builder's (a root-only\n/// check let each lookup of the tuple re-instantiate a fresh element slot and\n/// mixed pushes type-checked again). CtFn is deliberately NOT descended:\n/// a function value creates a NEW builder per call, so generalizing\n/// `() -> ArrayBuilder[v]` is sound and useful.\nexport fn is_array_builder_ty(t: Type) -> Bool {\n  if is_array_builder_head(t) {\n    true\n  } else {\n    match t {\n      CtArray(e) => is_array_builder_ty(e),\n      CtOption(e) => is_array_builder_ty(e),\n      CtTuple(elems) => {\n        let mut i = 0\n        let mut found = false\n        while i < Array::length(elems) && !found {\n          found = is_array_builder_ty(Array::get(elems, i))\n          i = i + 1\n        }\n        found\n      },\n      CtNamed(_, targs) => {\n        let mut i = 0\n        let mut found = false\n        while i < Array::length(targs) && !found {\n          found = is_array_builder_ty(Array::get(targs, i))\n          i = i + 1\n        }\n        found\n      },\n      _ => false\n    }\n  }\n}\n\nfn direct_builtin_return(name: String) -> Option[Type] {\n  if name == \"Bytes::length\" {\n    Some(CtInt)\n  }\n  else if name == \"iter_length\" || name == \"String::iter_length\" || name == \"Map::iter_length\" {\n    Some(CtInt)\n  }\n  else if name == \"Array::length\" {\n    Some(CtInt)\n  }\n  else if name == \"FixedArray::length\" || name == \"Int64Array::length\" {\n    Some(CtInt)\n  }\n  else if name == \"String::length\" {\n    Some(CtInt)\n  }\n  else if name == \"Bytes::get\" || name == \"String::index_of\" || name == \"String::char_code_at\" || name == \"String::last_index_of\" || name == \"Char::to_int\" || name == \"Double::to_int\" || name == \"Double::to_i64_bits\" || name == \"Double::to_i64_bits_lo\" || name == \"Double::to_i64_bits_hi\" || name == \"Env::args_len\" || name == \"Stdin::read_char\" || name == \"Int64Array::get\" {\n    Some(CtInt)\n  }\n  else if name == \"String::equals\" || name == \"String::contains\" || name == \"String::starts_with\" || name == \"String::ends_with\" || name == \"Array::any\" || name == \"Array::all\" || name == \"Array::contains\" || name == \"Map::has_key\" || name == \"map_has\" || name == \"Path::is_absolute\" || name == \"Fs::exists\" || name == \"Fs::is_dir\" || name == \"Fs::is_file\" || name == \"eq\" || name == \"not\" {\n    Some(CtBool)\n  }\n  else if name == \"String::concat\" || name == \"String::substring\" || name == \"String::trim\" || name == \"String::to_lower\" || name == \"String::to_upper\" || name == \"String::from_char_code\" || name == \"String::join\" || name == \"Array::join\" || name == \"Path::to_string\" || name == \"Path::resolve\" || name == \"PromptText::new\" || name == \"Stdin::read_stream\" || name == \"Env::get\" || name == \"Env::args_get\" || name == \"Fs::read_file\" || name == \"Fs::getcwd\" || name == \"sh\" || name == \"Lines::stringify\" || name == \"Llm::complete\" || name == \"Rlm::run\" || name == \"Rlm::finalize\" || name == \"__to_string\" {\n    Some(CtString)\n  }\n  else if name == \"__len\" {\n    Some(CtInt)\n  }\n  else if name == \"String::iter_get\" {\n    Some(CtInt)\n  }\n  else if name == \"iter_get\" || name == \"Map::iter_get\" || name == \"iter_require\" || name == \"__neg\" {\n    Some(CtUnknown)\n  }\n  else if name == \"Bytes::new\" || name == \"Bytes::concat\" || name == \"Bytes::slice\" || name == \"Bytes::from_array\" || name == \"Fs::read_bytes\" {\n    Some(CtBytes)\n  }\n  else if name == \"Array::set\" || name == \"Array::push\" || name == \"Array::push_all\" || name == \"Array::truncate\" || name == \"Array::foreach\" || name == \"FixedArray::set\" || name == \"FixedArray::blit\" || name == \"FixedArray::unsafe_set\" || name == \"Int64Array::set\" || name == \"Bytes::set\" || name == \"Bytes::push\" || name == \"Bytes::append\" || name == \"Bytes::blit\" || name == \"Bytes::fill\" || name == \"MapBuilder::set\" || name == \"Stdout::write_char\" || name == \"Stdout::write_stream\" || name == \"sleep\" || name == \"Fs::copy\" || name == \"Fs::chdir\" || name == \"Fs::mkdir\" || name == \"Fs::mkdir_p\" || name == \"Fs::append\" || name == \"Fs::remove\" || name == \"Fs::rename\" || name == \"Fs::write_file\" || name == \"Fs::write_bytes\" || name == \"print\" || name == \"println\" || name == \"assert\" || name == \"assert_true\" || name == \"assert_eq\" || name == \"__set_field\" {\n    Some(CtUnit)\n  }\n  else if name == \"Double::from_i64_bits\" || name == \"Int::to_double\" || name == \"Double::to_float\" || name == \"Float::to_double\" {\n    Some(CtDouble)\n  }\n  else if name == \"Char::from_int\" {\n    Some(CtChar)\n  }\n  else if name == \"Bytes::to_array\" || name == \"Int64Array::make\" {\n    Some(CtArray(CtInt))\n  }\n  else if name == \"Map::keys\" || name == \"sh_lines\" || name == \"Lines::parse\" {\n    Some(CtArray(CtString))\n  }\n  else if name == \"Array::slice\" || name == \"Array::concat\" || name == \"Array::filter\" || name == \"Array::reverse\" || name == \"Array::sort\" || name == \"FixedArray::make\" {\n    Some(CtArray(CtUnknown))\n  }\n  else if name == \"Some\" || name == \"Array::find\" {\n    Some(CtOption(CtUnknown))\n  }\n  else {\n    None\n  }\n}\n\nfn direct_call_return(env: TypeEnv, name: String) -> Option[Type] {\n  match env_lookup(env, name) {\n    Some(_) => None,\n    None => direct_builtin_return(name)\n  }\n}\n\n/// Expected TOP-LEVEL head-kind (see `head_kind`) of a builtin's FIRST argument,\n/// for the container/string builtins whose receiver head is unambiguous. 0 means\n/// \"unchecked\". Used to catch `Array::length(5)` / `String::length(5)` etc. on\n/// the direct-call fast path WITHOUT a per-call `lookup_builtin` (the #626\n/// seed-heap OOM constraint). Only entries whose first-arg head is certain are\n/// listed; anything else returns 0 (tolerated).\nfn builtin_first_arg_head(name: String) -> Int {\n  if name == \"Array::length\" || name == \"Array::get\" || name == \"Array::set\" || name == \"Array::push\" || name == \"Array::push_all\" || name == \"Array::slice\" || name == \"Array::concat\" || name == \"Array::reverse\" || name == \"Array::truncate\" || name == \"Array::foreach\" || name == \"Array::contains\" || name == \"Array::any\" || name == \"Array::all\" || name == \"Array::find\" || name == \"Array::filter\" {\n    9\n  } else if name == \"String::length\" || name == \"String::substring\" || name == \"String::trim\" || name == \"String::to_lower\" || name == \"String::to_upper\" || name == \"String::index_of\" || name == \"String::last_index_of\" || name == \"String::char_code_at\" || name == \"String::contains\" || name == \"String::starts_with\" || name == \"String::ends_with\" || name == \"String::split\" || name == \"String::concat\" {\n    4\n  } else if name == \"Bytes::length\" || name == \"Bytes::get\" || name == \"Bytes::set\" || name == \"Bytes::slice\" || name == \"Bytes::to_array\" || name == \"Bytes::push\" || name == \"Bytes::append\" || name == \"Bytes::blit\" || name == \"Bytes::fill\" {\n    7\n  } else if name == \"Int64Array::make\" || name == \"FixedArray::make\" {\n    // #989 review: the make length is arg 0, so the rest-position table\n    // never sees it — `Int64Array::make(\"4\", 0)` compiled with the String\n    // as the loop bound. Both makes take a certain Int first.\n    1\n  } else {\n    0\n  }\n}\n\n/// Expected head-kind for argument position `i` (i >= 1) of fixed-signature\n/// builtins, mirroring `builtin_first_arg_head` for the non-receiver args.\n/// `direct_call_return` types these polymorphically, so passing e.g. an Int as\n/// the second arg of `String::concat`, or a String as the index of\n/// `String::substring`, slipped through. 0 = tolerate (no certain head). Only\n/// monomorphic, non-callback positions are listed (so HOF args like Array::map's\n/// function stay untouched — those need real signature inference, not a head).\nfn builtin_arg_head_rest(name: String, i: Int) -> Int {\n  // String head = 4, Int head = 1, Bytes head = 7 (see head_kind).\n  if name == \"String::concat\" {\n    if i == 1 {\n      4\n    } else {\n      0\n    }\n  } else if name == \"String::index_of\" || name == \"String::last_index_of\" || name == \"String::contains\" || name == \"String::starts_with\" || name == \"String::ends_with\" || name == \"String::split\" {\n    if i == 1 {\n      4\n    } else {\n      0\n    }\n  } else if name == \"String::substring\" {\n    if i == 1 || i == 2 {\n      1\n    } else {\n      0\n    }\n  } else if name == \"String::char_code_at\" {\n    if i == 1 {\n      1\n    } else {\n      0\n    }\n  } else if name == \"Bytes::get\" || name == \"Bytes::push\" {\n    // #985: Bytes::push's pushed byte (Int) was unlisted, so\n    // `Bytes::push(b, \"hello\")` compiled clean and wrote a garbage byte.\n    if i == 1 {\n      1\n    } else {\n      0\n    }\n  } else if name == \"Bytes::set\" || name == \"Bytes::slice\" || name == \"Bytes::fill\" {\n    if i == 1 || i == 2 {\n      1\n    } else {\n      0\n    }\n  } else if name == \"Bytes::blit\" {\n    // blit(dst: Bytes, src: Bytes, src_off: Int, len: Int)\n    if i == 1 {\n      7\n    } else if i == 2 || i == 3 {\n      1\n    } else {\n      0\n    }\n  } else if name == \"Int64Array::get\" {\n    // #985: the Int64Array positions were never listed —\n    // `Int64Array::set(w, 0, \"hi\")` wrote a String pointer into an i64 slot.\n    if i == 1 {\n      1\n    } else {\n      0\n    }\n  } else if name == \"Int64Array::set\" {\n    if i == 1 || i == 2 {\n      1\n    } else {\n      0\n    }\n  } else if name == \"Int64Array::make\" {\n    if i == 1 {\n      1\n    } else {\n      0\n    }\n  } else {\n    0\n  }\n}\n\n/// Fixed argument COUNT for direct-path builtins (-1 = unchecked). The direct\n/// fast path types the call by name alone (the #626 seed-heap constraint rules\n/// out a per-call `lookup_builtin`), so a wrong argument count was silently\n/// accepted — and the linear backend then emitted the surplus operands straight\n/// into the wasm body (`Bytes::new(3)` left a value stranded on the stack and\n/// the module failed validation only at instantiation). Only builtins whose\n/// arity is certain are listed; anything variadic-ish or unsure stays -1.\n/// `Bytes::new` is handled separately (0 or 1 capacity arg).\nfn builtin_fixed_arity(name: String) -> Int {\n  if name == \"Array::length\" || name == \"Array::reverse\" || name == \"String::length\" || name == \"String::trim\" || name == \"String::to_lower\" || name == \"String::to_upper\" || name == \"String::from_char_code\" || name == \"String::iter_length\" || name == \"Bytes::length\" || name == \"Bytes::to_array\" || name == \"Bytes::from_array\" || name == \"Map::keys\" || name == \"Map::iter_length\" || name == \"Char::to_int\" || name == \"Char::from_int\" || name == \"Double::to_int\" || name == \"Double::to_i64_bits\" || name == \"Double::from_i64_bits\" || name == \"Int::to_double\" || name == \"not\" || name == \"print\" || name == \"println\" || name == \"assert\" || name == \"assert_true\" || name == \"__to_string\" || name == \"FixedArray::length\" || name == \"Int64Array::length\" {\n    1\n  } else if name == \"Array::get\" || name == \"Array::push\" || name == \"Array::push_all\" || name == \"Array::truncate\" || name == \"Array::concat\" || name == \"Array::contains\" || name == \"Array::any\" || name == \"Array::all\" || name == \"Array::find\" || name == \"Array::filter\" || name == \"Array::join\" || name == \"Array::foreach\" || name == \"String::equals\" || name == \"String::concat\" || name == \"String::char_code_at\" || name == \"String::index_of\" || name == \"String::last_index_of\" || name == \"String::contains\" || name == \"String::starts_with\" || name == \"String::ends_with\" || name == \"String::split\" || name == \"String::join\" || name == \"String::iter_get\" || name == \"Bytes::get\" || name == \"Bytes::push\" || name == \"Bytes::append\" || name == \"Bytes::concat\" || name == \"Map::has_key\" || name == \"map_has\" || name == \"eq\" || name == \"assert_eq\" || name == \"FixedArray::get\" || name == \"FixedArray::make\" || name == \"Int64Array::get\" || name == \"Int64Array::make\" {\n    2\n  } else if name == \"Array::set\" || name == \"Array::slice\" || name == \"String::substring\" || name == \"Bytes::set\" || name == \"Bytes::slice\" || name == \"Bytes::fill\" || name == \"MapBuilder::set\" || name == \"FixedArray::set\" || name == \"FixedArray::unsafe_set\" || name == \"Int64Array::set\" {\n    3\n  } else if name == \"Bytes::blit\" {\n    4\n  } else if name == \"FixedArray::blit\" {\n    5\n  } else {\n    0 - 1\n  }\n}\n\n/// Check a higher-order builtin's callback parameter against the type it will be\n/// fed. `recv_ty` / `fn_ty` are already subst-applied; when the receiver is a\n/// concrete `CtArray(elem)` and the callback is a `CtFn` with a parameter at\n/// `pidx`, require `elem` to be assignable to that parameter type. Ground-gated\n/// via check_assignable, so an unannotated callback param (a fresh CtVar that\n/// the body never pins to a concrete type) stays tolerant — only an explicit\n/// wrong annotation (or a body that pins the param to a mismatching concrete\n/// type) is rejected. `expected_ty` is the param (the slot), `elem` the value.\nfn check_hof_param_vs_elem(recv_ty: Type, fn_ty: Type, pidx: Int, s: Subst, errors: Array[String], msg: String) -> Subst {\n  match recv_ty {\n    CtArray(elem) => match fn_ty {\n      CtFn(ptys, _, _) => if Array::length(ptys) > pidx {\n        check_assignable(subst_apply(s, Array::get(ptys, pidx)), subst_apply(s, elem), s, errors, msg, 0 - 1)\n      } else {\n        s\n      },\n      _ => s\n    },\n    _ => s\n  }\n}\n\n/// Require two array operands to share an element type (Array::concat /\n/// Array::push_all). `a_app` / `b_app` are already subst-applied; when both are\n/// concrete `CtArray`, ground-gated check_assignable compares their element\n/// types (generic / var operands stay tolerant).\nfn check_two_array_elems(a_app: Type, b_app: Type, s: Subst, errors: Array[String], msg: String) -> Subst {\n  match a_app {\n    CtArray(ea) => match b_app {\n      CtArray(eb) => check_assignable(subst_apply(s, ea), subst_apply(s, eb), s, errors, msg, 0 - 1),\n      _ => s\n    },\n    _ => s\n  }\n}\n\n/// Declared type of a (monomorphic) struct field by name, or None if the struct\n/// or field is unknown. Used to recognise a field-stored-function call\n/// `b.f(args)` when no method/builtin `T::f` exists.\nfn struct_field_type(defs: Array[TypeDef], sname: String, field: String) -> Option[Type] {\n  match find_typedef(defs, sname) {\n    Some(td) => match td {\n      TDStruct(_, fields, _, _) => {\n        let rec go: (Int) -> Option[Type] = (i) -> {\n          if i >= Array::length(fields) {\n            None\n          } else {\n            let (fname, ftype) = Array::get(fields, i)\n            if fname == field {\n              Some(ftype)\n            } else {\n              go(i + 1)\n            }\n          }\n        }\n        go(0)\n      },\n      _ => None\n    },\n    None => None\n  }\n}\n\n/// #829: instantiate a declared field type against the receiver's actual type\n/// arguments (`CtNamed(S, targs)`). Substitutes only when the declared param\n/// list and the argument list line up; otherwise the raw (rigid) type is kept,\n/// which downstream checks tolerate exactly as before.\nfn inst_struct_field_ty(ft: Type, tparams: Array[String], targs: Array[Type]) -> Type {\n  if Array::length(tparams) > 0 && Array::length(tparams) == Array::length(targs) {\n    subst_type_params(ft, tparams, targs)\n  } else {\n    ft\n  }\n}\n\n/// #829: field type of a struct-typed receiver, instantiated when the receiver\n/// is an applied generic struct. `CtStruct` receivers keep the raw field type\n/// (monomorphic structs have no params to substitute). None when the receiver\n/// is not a known struct or the field does not exist.\nfn receiver_struct_field_type(defs: Array[TypeDef], recv: Type, field: String) -> Option[Type] {\n  match recv {\n    CtStruct(sname) => struct_field_type(defs, sname, field),\n    CtNamed(sname, targs) => match find_typedef(defs, sname) {\n      Some(td) => match td {\n        TDStruct(_, _, _, tparams) => match struct_field_type(defs, sname, field) {\n          Some(ft) => Some(inst_struct_field_ty(ft, tparams, targs)),\n          None => None\n        },\n        _ => None\n      },\n      None => None\n    },\n    _ => None\n  }\n}\n\nfn is_logic_binop(op: String) -> Bool {\n  op == \"&&\"\n  || op == \"||\"\n}\n\nfn is_order_binop(op: String) -> Bool {\n  op == \"<\"\n  || op == \">\"\n  || op == \"<=\"\n  || op == \">=\"\n}\n\nfn type_name_prefix(ty: Type) -> String {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"Unit\",\n    CtBytes => \"Bytes\",\n    CtArray(_) => \"Array\",\n    CtOption(_) => \"Option\",\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, _) => name,\n    _ => \"\"\n  }\n}\n\n/// #994: builtin data types that can appear as a dot-call RECEIVER's checked\n/// type (via `type_name_prefix` or a `CtNamed` head). An unresolved method on\n/// one of these is definitely bogus -- there is no \"it might be an imported\n/// user type with the method defined elsewhere\" escape hatch for a builtin.\n/// Deliberately excludes namespace-only builtins (Fs, Http, Socket, Stdout,\n/// ...) that are never a receiver VALUE's type, only ever called by\n/// `Module::fn` name -- including them here would risk false positives on\n/// legitimate qualified-import shortcut calls that happen to share a method\n/// name.\n/// #994 review: `Bool`/`Option`/`Result` are excluded even though they are\n/// builtin heads. lib/@vibe/prelude/{bool,option,result}.vibe extend them\n/// with real top-level `fn Bool::to_int` etc., and the *_type_import_test.vibe\n/// fixtures use the \"import just the type, dot-call resolves the method via\n/// the merged program\" idiom the #953 comment documents -- in an isolated\n/// per-file check (as these unit tests exercise) the extension fn isn't in\n/// `env` yet, so gating on this prefix here regressed 4 passing tests\n/// (`no method ... on Bool/Option/Result`) that only compile correctly once\n/// merged. No equivalent extension-via-type-import convention exists for the\n/// container types below (grep confirms no prelude file extends Array/Bytes/\n/// Map/...), so they keep the stricter check.\n/// #994 follow-up (Codex P1): `Int`/`Double`/`Char` were missing here even\n/// though `lib/@vibe/prelude/{int,double}.vibe` extend them with real fns\n/// (`Int::abs`, `Double::ceil`, ...) the same way Bool/Option/Result do.\n/// Unlike Bool/Option/Result, no test anywhere dot-calls one of those\n/// extension fns (grep across the repo for `.abs(`/`.gcd(`/`.ceil(`/... on a\n/// bare int/double/char value found zero hits), so there is no \"import type\n/// only, resolve via merge\" idiom to protect for these three -- adding them\n/// carries none of the regression risk that excluded Bool/Option/Result.\n/// Confirmed the gap empirically: `n.to_string()` for `n: Int` checks and\n/// \"succeeds\" (no parsed `fn Int::to_string` exists anywhere, only a\n/// checker-only `lookup_builtin` signature), then codegen dies with\n/// \"unknown struct field: to_string\" -- the exact class of bug #994 exists\n/// to catch.\nfn is_known_builtin_receiver_prefix(prefix: String) -> Bool {\n  prefix == \"String\"\n  || prefix == \"Bytes\"\n  || prefix == \"Array\"\n  || prefix == \"Map\"\n  || prefix == \"MapBuilder\"\n  || prefix == \"Int64Array\"\n  || prefix == \"FixedArray\"\n  || prefix == \"ArrayBuilder\"\n  || prefix == \"StringBuilder\"\n  || prefix == \"Int\"\n  || prefix == \"Double\"\n  || prefix == \"Char\"\n}\n\nfn is_equality_binop(op: String) -> Bool {\n  op == \"==\"\n  || op == \"!=\"\n}\n\nfn unify_binop_candidate(left_ty: Type, right_ty: Type, target_ty: Type, s: Subst) -> Option[Subst] {\n  match unify(left_ty, target_ty, s) {\n    Some(s1) => unify(right_ty, target_ty, s1),\n    None => None\n  }\n}\n\nfn unify_same_binop_operands(left_ty: Type, right_ty: Type, s: Subst) -> Option[(Type, Subst)] {\n  match unify(left_ty, right_ty, s) {\n    Some(s1) => Some((subst_apply(s1, left_ty), s1)),\n    None => None\n  }\n}\n\nfn infer_named_trait_binop(env: TypeEnv, left_ty: Type, right_ty: Type, trait_name: String, s: Subst) -> Option[(Type, Subst)] {\n  match unify_same_binop_operands(left_ty, right_ty, s) {\n    Some((resolved, s1)) => if type_implements_trait(env, s1, resolved, trait_name) {\n      Some((resolved, s1))\n    } else {\n      None\n    },\n    None => None\n  }\n}\n\nfn binop_str_arr_contains(arr: Array[String], val: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == val {\n      found = true\n      i = Array::length(arr)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// #952: a bound generic type parameter (`[T: Ord]` / `[T: Add]`) is checked\n/// as a plain `CtVar(id)` carrying its trait bounds in the current `Subst`\n/// (recorded by `subst_add_bound` when the `EFn` type-param header is\n/// processed, read back via `subst_bounds_for`). The order/`+` binop paths\n/// below try `unify_binop_candidate(_, _, CtInt, s)` FIRST as a fast path for\n/// ordinary (unbound) local-var inference -- but `unify` treats ANY unbound\n/// `CtVar` as freely unifiable with `CtInt` (no bound check), so that fast\n/// path silently binds T := Int the first time `<`/`>`/`+` appears in a bound\n/// generic function's OWN body, before any call site is even seen. That\n/// poisons the substitution used to `generalize` the function's signature,\n/// turning `fn my_lt[T: Ord](a: T, b: T) -> Bool { a < b }` into a\n/// monomorphic `(Int, Int) -> Bool` -- so calling it with String args later\n/// fails with \"expected Int, got String\" even though `impl Ord for String`\n/// exists. `==`/`!=` never hit this because `is_equality_binop` only unifies\n/// the two operands against EACH OTHER (never against a concrete target\n/// type), so a bound CtVar is never concretized there.\n///\n/// Fix: when either operand resolves (post-subst) to a CtVar whose recorded\n/// bounds already include the needed trait, dispatch directly here -- unify\n/// the operands against EACH OTHER only (mirroring the Eq path) and skip the\n/// CtInt/CtDouble fast paths entirely, so the type parameter stays\n/// rigid/polymorphic through the rest of the definition check. An ordinary\n/// unbound CtVar (no recorded bounds -- the common unannotated-local-var\n/// inference case, e.g. `fn f(x) { x < 5 }`) is untouched: `rigid_bound_operand`\n/// returns false for it, so it still takes the existing\n/// CtInt/CtDouble/struct-Ord(Add) fast path exactly as before.\nfn rigid_bound_operand(ty: Type, s: Subst, trait_name: String) -> Bool {\n  match subst_apply(s, ty) {\n    CtVar(id) => binop_str_arr_contains(subst_bounds_for(s, id), trait_name),\n    _ => false\n  }\n}\n\n/// Bounds recorded on a var the operand-vs-operand unify just eliminated\n/// (post-subst it is no longer a CtVar) would otherwise be dropped: in\n/// `fn bad[T: Ord, U](a: T, b: U) { a < b }` unify may bind T := U, leaving\n/// the surviving U with NO recorded Ord bound, so generalize exports an\n/// unbounded (U, U) -> Bool and `bad(true, false)` sails through the\n/// call-site bound check. Collect each operand's pre-unify var bounds so\n/// they can be re-recorded on whatever survives.\nfn operand_var_bounds(ty: Type, s: Subst) -> Array[String] {\n  match subst_apply(s, ty) {\n    CtVar(id) => subst_bounds_for(s, id),\n    _ => array_empty()\n  }\n}\n\nfn rigid_trait_bound_binop(env: TypeEnv, left_ty: Type, right_ty: Type, trait_name: String, s: Subst) -> Option[(Type, Subst)] {\n  if rigid_bound_operand(left_ty, s, trait_name) || rigid_bound_operand(right_ty, s, trait_name) {\n    let lb = operand_var_bounds(left_ty, s)\n    let rb = operand_var_bounds(right_ty, s)\n    match unify_same_binop_operands(left_ty, right_ty, s) {\n      Some((resolved, s1)) => match subst_apply(s1, resolved) {\n        CtVar(id) => {\n          // Var survivor: transfer every bound either operand carried that\n          // the survivor does not already record, so generalize keeps them.\n          let have = subst_bounds_for(s1, id)\n          let missing = ArrayBuilder::new()\n          let mut i = 0\n          while i < Array::length(lb) + Array::length(rb) {\n            let cand = if i < Array::length(lb) {\n              Array::get(lb, i)\n            } else {\n              Array::get(rb, i - Array::length(lb))\n            }\n            if !binop_str_arr_contains(have, cand) {\n              // (duplicates between lb and rb are harmless -- bound lookups\n              // only ever ask \"contains\", never count)\n              ArrayBuilder::push(missing, cand)\n            } else {\n              ()\n            }\n            i = i + 1\n          }\n          let missing_arr = ArrayBuilder::freeze(missing)\n          if Array::length(missing_arr) > 0 {\n            Some((resolved, subst_add_bound(s1, id, missing_arr)))\n          } else {\n            Some((resolved, s1))\n          }\n        },\n        other => if type_implements_trait(env, s1, other, trait_name) {\n          // Concrete survivor (e.g. `a < \"x\"` forcing T := String): only\n          // accept when it actually implements the required trait --\n          // mirroring infer_named_trait_binop, which handled this shape\n          // before the rigid pre-step existed.\n          Some((resolved, s1))\n        } else {\n          None\n        }\n      },\n      None => None\n    }\n  } else {\n    None\n  }\n}\n\nfn infer_binop_type(op: String, left_ty: Type, right_ty: Type, env: TypeEnv, s: Subst, errors: Array[String], tytab: Array[(Int, Type)]) -> (Type, Subst) {\n  if is_logic_binop(op) {\n    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {\n      Some(s1) => (CtBool, s1),\n      None => {\n        Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Bool\")))\n        (CtUnknown, s)\n      }\n    }\n  }\n  else if is_equality_binop(op) {\n    match unify(left_ty, right_ty, s) {\n      Some(s1) => (CtBool, s1),\n      None => {\n        // Tolerate unresolved NOMINAL operands: a generic `[T]` callee's\n        // result reaches here as a rigid CtNamed type param when call-site\n        // instantiation can't ground it (#829) — e.g.\n        // `Array::get(ArrayView::to_array(v), 0) == 20`. Pre-fn-migration\n        // these positions were CtUnknown, so erroring regressed working\n        // code. Fully concrete mismatches still error.\n        let eq_l = subst_apply(s, left_ty)\n        let eq_r = subst_apply(s, right_ty)\n        let eq_has_named = match eq_l {\n          CtNamed(_, _) => true,\n          _ => match eq_r {\n            CtNamed(_, _) => true,\n            _ => false\n          }\n        }\n        if eq_has_named {\n          (CtBool, s)\n        } else {\n          Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must have same type\")))\n          (CtUnknown, s)\n        }\n      }\n    }\n  }\n  else if is_order_binop(op) {\n    match rigid_trait_bound_binop(env, left_ty, right_ty, \"Ord\", s) {\n      Some((_, s1)) => (CtBool, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n        Some(s1) => (CtBool, s1),\n        None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n          Some(s1) => (CtBool, s1),\n          None => match infer_named_trait_binop(env, left_ty, right_ty, \"Ord\", s) {\n            Some((_, s1)) => (CtBool, s1),\n            None => {\n              Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Int or Double\")))\n              (CtUnknown, s)\n            }\n          }\n        }\n      }\n    }\n  }\n  else if op == \"+\" {\n    match rigid_trait_bound_binop(env, left_ty, right_ty, \"Add\", s) {\n      Some((resolved, s1)) => (resolved, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n        Some(s1) => (CtInt, s1),\n        None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n          Some(s1) => (CtDouble, s1),\n          None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {\n            Some(s1) => (CtString, s1),\n            None => match infer_named_trait_binop(env, left_ty, right_ty, \"Add\", s) {\n              Some((resolved, s1)) => (resolved, s1),\n              None => {\n                Array::push(errors, \"type mismatch in '+': operands must be Int, Double, or String\")\n                (CtUnknown, s)\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n  else if op == \"-\"\n  || op == \"*\"\n  || op == \"/\" {\n    let trait_name = if op == \"-\" {\n      \"Sub\"\n    } else if op == \"*\" {\n      \"Mul\"\n    } else {\n      \"Div\"\n    }\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtDouble, s1),\n        None => match infer_named_trait_binop(env, left_ty, right_ty, trait_name, s) {\n          Some((resolved, s1)) => (resolved, s1),\n          None => {\n            Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Int or Double\")))\n            (CtUnknown, s)\n          }\n        }\n      }\n    }\n  }\n  else if op == \"%\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => {\n        Array::push(errors, \"type mismatch in '%': operands must be Int\")\n        (CtUnknown, s)\n      }\n    }\n  }\n  else if op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => {\n        Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Int\")))\n        (CtUnknown, s)\n      }\n    }\n  }\n  else {\n    Array::push(errors, String::concat(\"unknown operator: \", op))\n    (CtUnknown, s)\n  }\n}\n\n/// Recursively replace type-parameter names (those bound to a CtVar in `env`)\n/// with that CtVar, including ones nested inside Array/Option/Tuple/Fn/Named type\n/// args. Type constructors (enum/struct names, not bound to a CtVar) are kept and\n/// their args recursed. This lets a generic annotation like `Map[String, V]`\n/// resolve its inner `V` to the function's quantified var, so call sites can\n/// instantiate it (the previous shallow lookup only handled the outermost name).\nfn resolve_tparams_in(ty: Type, env: TypeEnv) -> Type {\n  match ty {\n    CtNamed(name, args) => {\n      let ra = for a in args {\n        resolve_tparams_in(a, env)\n      }\n      match env_lookup(env, name) {\n        Some(t) => match t {\n          CtVar(_) => t,\n          _ => CtNamed(name, ra)\n        },\n        None => CtNamed(name, ra)\n      }\n    },\n    CtArray(e) => CtArray(resolve_tparams_in(e, env)),\n    CtOption(e) => CtOption(resolve_tparams_in(e, env)),\n    CtTuple(es) => CtTuple(for e in es {\n      resolve_tparams_in(e, env)\n    }),\n    CtFn(ps, ret, eff) => {\n      let resolve_params: (Array[Type]) -> Array[Type] = (types) -> {\n        let out = array_empty()\n        let mut i = 0\n        while i < Array::length(types) {\n          Array::push(out, resolve_tparams_in(Array::get(types, i), env))\n          i = i + 1\n        }\n        out\n      }\n      CtFn(resolve_params(ps), resolve_tparams_in(ret, env), eff)\n    },\n    _ => ty\n  }\n}\n\n/// Record a call-site node's (raw, pre-final-subst) result type `ty` keyed by\n/// its real source char offset `call_off`, for typed-hover (vibe type-at) on\n/// `foo(x)` / `obj.method(x)`, then return `ty` unchanged so it can be dropped\n/// into the call-result tuple in place. Synthetic calls (call_off < 0) skip the\n/// push. Used at the ECall result sites (NOT by wrapping the giant ECall match,\n/// which the bootstrap seed parser cannot reparse when that match is nested one\n/// level deeper — only the interior result types are tagged).\nfn tab_call_ty(tytab: Array[(Int, Type)], call_off: Int, ty: Type) -> Type {\n  if call_off >= 0 {\n    Array::push(tytab, (call_off, ty))\n  } else {\n    ()\n  }\n  ty\n}\n\n/// Iteratively check a sequence/let SPINE (`ESeq` and `ELet`/`ELetMut`/`ELetRec`\n/// chains) instead of recursing into each `body`, so a long function body — a\n/// deep right-nested `let` chain — does not exhaust the wasm call stack during\n/// self-compile. `ce` is `check_expr` itself (threaded as a value to avoid a\n/// forward reference). Semantics are identical to the recursive arms: each `let`\n/// binds its (generalized, or raw for `mut`) value type into the env seen by the\n/// rest of the spine, and the final non-spine expression's result is returned.\nfn check_seq_spine(expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)], ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> (Type, Subst, Int) {\n  let mut cur = expr\n  let mut cenv = env\n  let mut s1 = s\n  let mut c1 = c\n  let mut done = false\n  let mut result = (CtUnit, s, c)\n  while !done {\n    match cur {\n      ESeq(left, right) => {\n        let (_, ns, nc) = ce(left, cenv, defs, s1, c1, errors, tytab)\n        s1 = ns\n        c1 = nc\n        cur = right\n      },\n      ELet(name, val, body, _) => {\n        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)\n        // #938 value restriction: a builder is a MUTABLE container, so its\n        // element var must stay un-quantified — generalizing\n        // `CtNamed(\"ArrayBuilder\", [v])` would re-instantiate a fresh v at\n        // every use and pushes could never constrain each other (the exact\n        // hole this issue is about). Bind the monotype instead.\n        let vt_resolved = subst_apply(ns, vt)\n        let gen = if is_array_builder_ty(vt_resolved) || is_region_tagged_ty(vt_resolved) {\n          vt\n        } else {\n          generalize(ns, vt)\n        }\n        cenv = env_bind(cenv, name, gen)\n        s1 = ns\n        c1 = nc\n        cur = body\n      },\n      ELetMut(name, val, body, _) => {\n        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)\n        // `loop` desugars to `let mut __loop_result = 0; while true { ...\n        // __loop_result = <break value> ... }` (parser_expr_primary.vibe) —\n        // the 0 is only a slot placeholder, but binding its CtInt here pinned\n        // every loop's result to Int, so `break((a, b))` / `break(acc)` with a\n        // tuple/String errored \"assignment type mismatch for __loop_result\".\n        // Bind the marker to a fresh var instead; the first assignment (break)\n        // instantiates it via check_assignable's unify.\n        if name == \"__loop_result\" {\n          let (lr_tv, nc2) = fresh_var(nc)\n          cenv = env_bind(cenv, name, lr_tv)\n          c1 = nc2\n        } else {\n          cenv = env_bind(cenv, name, vt)\n          c1 = nc\n        }\n        s1 = ns\n        cur = body\n      },\n      ELetRec(name, val, body) => {\n        let (tv, c1b) = fresh_var(c1)\n        let (vt, ns, nc) = ce(val, env_bind(cenv, name, tv), defs, s1, c1b, errors, tytab)\n        let s2 = match unify(tv, vt, ns) {\n          Some(su) => su,\n          None => ns\n        }\n        let gen = generalize(s2, tv)\n        cenv = env_bind(cenv, name, gen)\n        s1 = s2\n        c1 = nc\n        cur = body\n      },\n      _ => {\n        result = ce(cur, cenv, defs, s1, c1, errors, tytab)\n        done = true\n      }\n    }\n  }\n  result\n}\n\n/// #418: enforce that `obj.field = x` (which desugars to\n/// `__set_field(obj, \"field\", x)`) only targets a `mut`-declared struct field.\n/// Runs as a pure side-effect over a *throwaway* errors/tytab so it never\n/// perturbs the main type/subst flow — it only type-checks `obj` to learn its\n/// struct name, looks up that struct's `mut` field set, and pushes a single\n/// diagnostic to the real `errors` when the written field is not `mut`.\nfn field_write_mut_check(name: String, args: Array[Expr], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)], ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit {\n  if name == \"__set_field\" && Array::length(args) == 3 {\n    match Array::get(args, 1) {\n      EString(field) => {\n        let throwaway = array_empty()\n        let throwtab = array_empty()\n        let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)\n        // #829: also recognise an INSTANTIATED generic struct receiver\n        // (`CtNamed(S, targs)`), so `mut`-field enforcement and the written-\n        // value type check cover generic structs too.\n        let recv_struct = match subst_apply(s, obj_ty) {\n          CtStruct(sn) => Some((sn, array_empty())),\n          CtNamed(sn, sargs) => Some((sn, sargs)),\n          _ => None\n        }\n        match recv_struct {\n          Some(recv_info) => {\n            let (sname, recv_targs) = recv_info\n            match find_typedef(defs, sname) {\n              Some(TDStruct(_, dfields, mut_names, s_tparams)) => {\n                let mut found = false\n                let mut i = 0\n                while i < Array::length(mut_names) {\n                  if Array::get(mut_names, i) == field {\n                    found = true\n                  } else {\n                    ()\n                  }\n                  i = i + 1\n                }\n                if found {\n                  ()\n                } else {\n                  Array::push(errors, String::concat(\"cannot assign to non-`mut` field `\", String::concat(field, String::concat(\"` of struct \", sname))))\n                }\n                // The written value must match the field's declared type\n                // (`p.x = \"s\"` for `x: Int` was accepted). Ground-gated via\n                // check_assignable so a generic field type is not over-rejected.\n                let mut fty = CtUnknown\n                let mut has_field = false\n                let mut fi = 0\n                while fi < Array::length(dfields) {\n                  let (fn2, ft) = Array::get(dfields, fi)\n                  if fn2 == field {\n                    fty = ft\n                    has_field = true\n                  } else {\n                    ()\n                  }\n                  fi = fi + 1\n                }\n                if has_field {\n                  let (val_ty, _, _) = ce(Array::get(args, 2), env, defs, s, c, throwaway, throwtab)\n                  // #829: instantiate a generic field's declared type from the\n                  // receiver's type args so the written value is checked against\n                  // the CONCRETE field type; a non-applied receiver keeps the\n                  // raw (rigid) type, which check_assignable tolerates.\n                  let inst_fty = inst_struct_field_ty(fty, s_tparams, recv_targs)\n                  let _ = check_assignable(subst_apply(s, inst_fty), subst_apply(s, val_ty), s, errors, String::concat(\"type mismatch writing field `\", String::concat(field, \"`\")), 0 - 1)\n                  ()\n                } else {\n                  ()\n                }\n              },\n              _ => ()\n            }\n          },\n          None => ()\n        }\n      },\n      _ => ()\n    }\n  } else {\n    ()\n  }\n}\n\n/// `obj[i]` desugars to `__index(obj, i)`, typed fully polymorphically, so\n/// indexing a non-indexable scalar (`let n = 5; n[0]`) was accepted silently.\n/// Report when `obj` resolves to a concrete scalar that cannot be indexed\n/// (Array/String/Bytes ARE indexable; type vars / unknown / named stay\n/// tolerated). Pure side-effect over a throwaway error/type table.\nfn index_target_check(name: String, args: Array[Expr], env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], ce: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit {\n  if name == \"__index\" && Array::length(args) == 2 {\n    let throwaway = array_empty()\n    let throwtab = array_empty()\n    let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)\n    let resolved_obj = subst_apply(s, obj_ty)\n    let not_indexable = match resolved_obj {\n      CtInt => true,\n      CtDouble => true,\n      CtBool => true,\n      CtChar => true,\n      CtUnit => true,\n      _ => false\n    }\n    if not_indexable {\n      Array::push(errors, \"cannot index a non-indexable value (expected Array, String, or Bytes)\")\n    } else {\n      // For an indexable receiver (Array/String/Bytes), the subscript must be an\n      // Int — `a[\"x\"]` was accepted silently. Only flag a concrete non-Int index;\n      // type vars / unknown / named stay tolerated.\n      let indexable = match resolved_obj {\n        CtArray(_) => true,\n        CtString => true,\n        CtBytes => true,\n        _ => false\n      }\n      if indexable {\n        let throwaway2 = array_empty()\n        let throwtab2 = array_empty()\n        let (idx_ty, _, _) = ce(Array::get(args, 1), env, defs, s, c, throwaway2, throwtab2)\n        let bad_index = match subst_apply(s, idx_ty) {\n          CtInt => false,\n          _ => type_is_ground(subst_apply(s, idx_ty))\n        }\n        if bad_index {\n          Array::push(errors, \"index must be an Int\")\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n    }\n  } else {\n    ()\n  }\n}\n\n/// An arm pattern is a CATCH-ALL (makes a match exhaustive regardless of which\n/// constructors precede it) when it is a wildcard or a bare binding. `POr` is a\n/// catch-all if either side is.\nfn pat_is_catchall(pat: Pat) -> Bool {\n  match pat {\n    PWild => true,\n    PBind(_) => true,\n    POr(l, r) => pat_is_catchall(l) || pat_is_catchall(r),\n    _ => false\n  }\n}\n\n/// Collect the constructor names a pattern matches at the TOP level (for enum\n/// exhaustiveness). `POr` contributes from both sides; other patterns none.\n/// #940 Phase 1: Bool-literal coverage names (`\"true\"` / `\"false\"`) for the\n/// flat Bool exhaustiveness check, walking or-patterns like\n/// collect_ctor_names_into does for ctor names.\nfn collect_bool_pats_into(pat: Pat, acc: Array[String]) -> Unit {\n  match pat {\n    PBool(b) => if b {\n      Array::push(acc, \"true\")\n    } else {\n      Array::push(acc, \"false\")\n    },\n    POr(l, r) => {\n      collect_bool_pats_into(l, acc)\n      collect_bool_pats_into(r, acc)\n    },\n    _ => ()\n  }\n}\n\nfn flat_names_contain(names: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(names) && !found {\n    if Array::get(names, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn collect_ctor_names_into(pat: Pat, acc: Array[String]) -> Unit {\n  match pat {\n    PCtor(name, _) => Array::push(acc, name),\n    POr(l, r) => {\n      collect_ctor_names_into(l, acc)\n      collect_ctor_names_into(r, acc)\n    },\n    _ => ()\n  }\n}\n\n/// Parse a tuple projection field (`t.0`, `t.5`) — the field is the all-digit\n/// index string. Returns None for a non-numeric field (a real `.method`/.field)\n/// so only genuine tuple projections are bounds-checked.\nfn parse_tuple_index(s: String) -> Option[Int] {\n  let len = String::length(s)\n  if len == 0 {\n    None\n  } else {\n    let mut i = 0\n    let mut val = 0\n    let mut ok = true\n    while i < len {\n      let cc = String::char_code_at(s, i)\n      if cc >= 48 && cc <= 57 {\n        val = val * 10 + (cc - 48)\n      } else {\n        ok = false\n      }\n      i = i + 1\n    }\n    if ok {\n      Some(val)\n    } else {\n      None\n    }\n  }\n}\n\n/// #813: bind a pattern's binders to CtUnknown for the resume-value walk —\n/// the walker re-checks resume arguments outside the main inference flow, so\n/// locally-bound names (match arms, lets) must be in scope or a legitimate\n/// `Read() => { let v = ...; resume(v) }` reports a false `unknown name: v`.\n/// CtUnknown keeps the value check ground-gated (tolerant) for such names.\nfn resume_walk_bind_pat(p: Pat, env: TypeEnv) -> TypeEnv {\n  match p {\n    PBind(n) => env_bind(env, n, CtUnknown),\n    PCtor(_, ps) => {\n      let mut env1 = env\n      let mut pi = 0\n      while pi < Array::length(ps) {\n        env1 = resume_walk_bind_pat(Array::get(ps, pi), env1)\n        pi = pi + 1\n      }\n      env1\n    },\n    PTuple(ps) => {\n      let mut env1 = env\n      let mut pi = 0\n      while pi < Array::length(ps) {\n        env1 = resume_walk_bind_pat(Array::get(ps, pi), env1)\n        pi = pi + 1\n      }\n      env1\n    },\n    POr(a, b) => resume_walk_bind_pat(b, resume_walk_bind_pat(a, env)),\n    PStruct(_, fields) => {\n      let mut env1 = env\n      let mut pi = 0\n      while pi < Array::length(fields) {\n        let (_, fp) = Array::get(fields, pi)\n        env1 = resume_walk_bind_pat(fp, env1)\n        pi = pi + 1\n      }\n      env1\n    },\n    _ => env\n  }\n}\n\n/// #813: walk a handler arm body for `resume(x)` calls and check x against the\n/// op's declared return type (ground-gated via check_assignable). Nested\n/// EHandle subtrees are skipped entirely — their resumes belong to the inner\n/// handler's own arms. Runs on a throwaway lane after the arm body was checked,\n/// so it only ADDS diagnostics (main inference flow untouched). Local binders\n/// (let / let mut / let rec / match arms / for-in vars) are bound to CtUnknown\n/// while descending so resume(local) doesn't report a false `unknown name`.\n/// #640: walk a `with Error` handler arm body and reject any `resume(...)`\n/// call. `Error` is non-resumable — `throw` / `perform Error::Throw` unwind\n/// the stack for good (no perform-counter/memo replay machinery runs for tag\n/// 2), so a resume in an Error arm never resumed anything; it was silently\n/// meaningless. Nested EHandle subtrees are skipped (their resumes belong to\n/// the inner handler's own arms, which may be resumable effects).\nfn reject_resume_in_error_arm(e: Expr, errors: Array[String]) -> Unit {\n  match e {\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(nm, off) => if nm == \"resume\" {\n          Array::push(errors, String::concat(\"Error is a non-resumable effect (#640); an Error arm's value IS the handle result — remove resume(...)\", off_marker(off)))\n        } else {\n          ()\n        },\n        _ => reject_resume_in_error_arm(callee, errors)\n      }\n      let mut ri = 0\n      while ri < Array::length(args) {\n        reject_resume_in_error_arm(Array::get(args, ri), errors)\n        ri = ri + 1\n      }\n    },\n    EHandle(_, _) => (),\n    ELet(_, v, b, _) => {\n      reject_resume_in_error_arm(v, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    ELetMut(_, v, b, _) => {\n      reject_resume_in_error_arm(v, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    ELetRec(_, v, b) => {\n      reject_resume_in_error_arm(v, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    ESeq(a, b) => {\n      reject_resume_in_error_arm(a, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    EIf(cnd, t, el) => {\n      reject_resume_in_error_arm(cnd, errors)\n      reject_resume_in_error_arm(t, errors)\n      reject_resume_in_error_arm(el, errors)\n    },\n    EMatch(scr, marms) => {\n      reject_resume_in_error_arm(scr, errors)\n      let mut mi = 0\n      while mi < Array::length(marms) {\n        let (_, mb) = Array::get(marms, mi)\n        reject_resume_in_error_arm(mb, errors)\n        mi = mi + 1\n      }\n    },\n    EWhile(cnd, b) => {\n      reject_resume_in_error_arm(cnd, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    EForIn(_, _, it, b) => {\n      reject_resume_in_error_arm(it, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    EBinOp(_, l, r) => {\n      reject_resume_in_error_arm(l, errors)\n      reject_resume_in_error_arm(r, errors)\n    },\n    EUnaryOp(_, inner) => reject_resume_in_error_arm(inner, errors),\n    EAssign(_, v, b) => {\n      reject_resume_in_error_arm(v, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    EAssignOp(_, _, v, b) => {\n      reject_resume_in_error_arm(v, errors)\n      reject_resume_in_error_arm(b, errors)\n    },\n    EFn(_, _, _, _, _, fb) => reject_resume_in_error_arm(fb, errors),\n    EReturn(inner) => reject_resume_in_error_arm(inner, errors),\n    EDot(obj, _, _, _) => reject_resume_in_error_arm(obj, errors),\n    ETuple(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        reject_resume_in_error_arm(Array::get(items, ti), errors)\n        ti = ti + 1\n      }\n    },\n    EArray(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        reject_resume_in_error_arm(Array::get(items, ti), errors)\n        ti = ti + 1\n      }\n    },\n    // Codex P2 on #933: the catch-all silently ended the walk for these\n    // recursive forms, so e.g. `Throw(_) => loop { break resume(0) }` or a\n    // resume tucked into a record/map literal escaped the non-resumable\n    // rejection and reached codegen's meaningless tag-1 path.\n    ERecord(_, fields, _) => {\n      let mut ti = 0\n      while ti < Array::length(fields) {\n        let (_, fe) = Array::get(fields, ti)\n        reject_resume_in_error_arm(fe, errors)\n        ti = ti + 1\n      }\n    },\n    ELoop(binds, b) => {\n      let mut ti = 0\n      while ti < Array::length(binds) {\n        let (_, be) = Array::get(binds, ti)\n        reject_resume_in_error_arm(be, errors)\n        ti = ti + 1\n      }\n      reject_resume_in_error_arm(b, errors)\n    },\n    ELabeledArg(_, _, inner) => reject_resume_in_error_arm(inner, errors),\n    EBreak(opt) => match opt {\n      Some(inner) => reject_resume_in_error_arm(inner, errors),\n      None => ()\n    },\n    EContinue(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        reject_resume_in_error_arm(Array::get(items, ti), errors)\n        ti = ti + 1\n      }\n    },\n    EMap(pairs) => {\n      let mut ti = 0\n      while ti < Array::length(pairs) {\n        let (_, pe) = Array::get(pairs, ti)\n        reject_resume_in_error_arm(pe, errors)\n        ti = ti + 1\n      }\n    },\n    ESpread(inner) => reject_resume_in_error_arm(inner, errors),\n    _ => ()\n  }\n}\n\n/// #942 (ADR-0050): is this handler-arm pattern an `Error` arm? Error arms are\n/// owned by reject_resume_in_error_arm (#640), so the general resume-misuse\n/// walks below leave them alone (no double report).\nfn handler_arm_pat_is_error(p: Pat) -> Bool {\n  match p {\n    PCtor(q, _) => {\n      let ci = String::index_of(q, \"::\")\n      ci > 0 && String::substring(q, 0, ci) == \"Error\"\n    },\n    _ => false\n  }\n}\n\n/// #942 (Codex P2 on #969): does this pattern bind the name `resume`? Codegen's\n/// prefer_bound_call (codegen/expr/compile_call.vibe) sends `resume(x)` to the\n/// BOUND function whenever any top-level fn / local binding / binder named\n/// `resume` is in scope — such calls never touch the continuation machinery,\n/// so the #942 misuse walks must skip them (they ran fine pre-#942).\nexport fn pat_binds_resume(p: Pat) -> Bool {\n  match p {\n    PBind(n) => n == \"resume\",\n    PCtor(_, ps) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(ps) {\n        if pat_binds_resume(Array::get(ps, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    PTuple(ps) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(ps) {\n        if pat_binds_resume(Array::get(ps, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    POr(a, b) => pat_binds_resume(a) || pat_binds_resume(b),\n    PStruct(_, fps) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fps) {\n        let (_, fp) = Array::get(fps, i)\n        if pat_binds_resume(fp) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    _ => false\n  }\n}\n\n/// #942 (Codex P2): does an EFn's parameter list bind `resume`? Labeled/\n/// optional params keep a trailing `~`/`?` in the raw AST name (stripped by\n/// the checker/codegen before binding, same as the labeled-param handling in\n/// check_expr's EFn arm above) — strip it here too so `fn f(resume~: ...)`\n/// is recognized as shadowing.\nfn param_base_name(raw_name: String) -> String {\n  let nlen = String::length(raw_name)\n  if nlen > 0 {\n    let lc = String::char_code_at(raw_name, nlen - 1)\n    if lc == '~' || lc == '?' {\n      raw_name[0: nlen - 1]\n    } else raw_name\n  } else raw_name\n}\n\nfn fn_params_bind_resume(params: Array[(String, Option[TypeExpr])]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(params) {\n    let (pn, _) = Array::get(params, i)\n    if param_base_name(pn) == \"resume\" {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n/// #942 (ADR-0050): inside a handler arm, `resume(...)` is one-shot and must be\n/// the LAST thing the arm does. Codegen compiles resume as a continuation\n/// throw, so any code after it silently never runs — `let a = resume(1);\n/// resume(2)` returned the first resume's flow and dropped the second on the\n/// floor. Reject non-tail resume calls, mirroring the #814 rejection of the\n/// k-convention non-tail continuation binder. Tail position distributes\n/// through let/seq continuations and if/match branches (only one branch runs),\n/// so `if c { resume(1) } else { resume(2) }` and multi-statement arms ending\n/// in resume stay legal. `return resume(v)` inherits the tail flag (Codex P2\n/// on #969 — return exits before anything else runs; pre-#942 it behaved\n/// exactly like a plain tail resume at runtime). Loop bodies are never tail\n/// (a resume there would run per iteration). EFn subtrees are skipped\n/// wholesale — a resume inside a nested lambda keeps its pre-#942 acceptance.\n/// A nested EHandle's handled body inherits the current tail flag (its value\n/// IS the handle's value, and a lexical resume there still targets THIS arm's\n/// continuation); its non-Error arms restart a fresh tail walk of their own.\n/// `sh` = `resume` is shadowed by an enclosing binder (top-level fn/let,\n/// local let/let-mut/let-rec, match/for/loop binders, arm payload binders):\n/// codegen's prefer_bound_call routes such calls to the bound function, so\n/// the tail discipline does not apply to them (Codex P2 on #969).\nfn check_arm_resume_tail(e: Expr, tail: Bool, sh: Bool, errors: Array[String]) -> Unit {\n  match e {\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(nm, off) => if nm == \"resume\" && !tail && !sh {\n          Array::push(errors, String::concat(\"resume(...) must be the last expression of the handler arm (tail position) — code after a resume never runs, so a bound or repeated resume is silently dropped (#942, ADR-0050)\", off_marker(off)))\n        } else {\n          ()\n        },\n        _ => check_arm_resume_tail(callee, false, sh, errors)\n      }\n      let mut ri = 0\n      while ri < Array::length(args) {\n        check_arm_resume_tail(Array::get(args, ri), false, sh, errors)\n        ri = ri + 1\n      }\n    },\n    EHandle(body, harms) => {\n      check_arm_resume_tail(body, tail, sh, errors)\n      let mut hi = 0\n      while hi < Array::length(harms) {\n        let (hpat, hbody) = Array::get(harms, hi)\n        if handler_arm_pat_is_error(hpat) {\n          ()\n        } else {\n          check_arm_resume_tail(hbody, true, sh || pat_binds_resume(hpat), errors)\n        }\n        hi = hi + 1\n      }\n    },\n    ELet(ln, v, b, _) => {\n      check_arm_resume_tail(v, false, sh, errors)\n      check_arm_resume_tail(b, tail, sh || ln == \"resume\", errors)\n    },\n    ELetMut(ln, v, b, _) => {\n      check_arm_resume_tail(v, false, sh, errors)\n      check_arm_resume_tail(b, tail, sh || ln == \"resume\", errors)\n    },\n    ELetRec(ln, v, b) => {\n      check_arm_resume_tail(v, false, sh || ln == \"resume\", errors)\n      check_arm_resume_tail(b, tail, sh || ln == \"resume\", errors)\n    },\n    ESeq(a, b) => {\n      check_arm_resume_tail(a, false, sh, errors)\n      check_arm_resume_tail(b, tail, sh, errors)\n    },\n    EIf(cnd, t, el) => {\n      check_arm_resume_tail(cnd, false, sh, errors)\n      check_arm_resume_tail(t, tail, sh, errors)\n      check_arm_resume_tail(el, tail, sh, errors)\n    },\n    EMatch(scr, marms) => {\n      check_arm_resume_tail(scr, false, sh, errors)\n      let mut mi = 0\n      while mi < Array::length(marms) {\n        let (mp, mb) = Array::get(marms, mi)\n        check_arm_resume_tail(mb, tail, sh || pat_binds_resume(mp), errors)\n        mi = mi + 1\n      }\n    },\n    EWhile(cnd, b) => {\n      check_arm_resume_tail(cnd, false, sh, errors)\n      check_arm_resume_tail(b, false, sh, errors)\n    },\n    EForIn(v1, v2, it, b) => {\n      check_arm_resume_tail(it, false, sh, errors)\n      let for_sh = v1 == \"resume\" || (match v2 {\n        Some(v2n) => v2n == \"resume\",\n        None => false\n      })\n      check_arm_resume_tail(b, false, sh || for_sh, errors)\n    },\n    EBinOp(_, l, r) => {\n      check_arm_resume_tail(l, false, sh, errors)\n      check_arm_resume_tail(r, false, sh, errors)\n    },\n    EUnaryOp(_, inner) => check_arm_resume_tail(inner, false, sh, errors),\n    EAssign(_, v, b) => {\n      check_arm_resume_tail(v, false, sh, errors)\n      check_arm_resume_tail(b, tail, sh, errors)\n    },\n    EAssignOp(_, _, v, b) => {\n      check_arm_resume_tail(v, false, sh, errors)\n      check_arm_resume_tail(b, tail, sh, errors)\n    },\n    EFn(_, _, _, _, _, _) => (),\n    EReturn(inner) => check_arm_resume_tail(inner, tail, sh, errors),\n    EDot(obj, _, _, _) => check_arm_resume_tail(obj, false, sh, errors),\n    ETuple(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        check_arm_resume_tail(Array::get(items, ti), false, sh, errors)\n        ti = ti + 1\n      }\n    },\n    EArray(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        check_arm_resume_tail(Array::get(items, ti), false, sh, errors)\n        ti = ti + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let mut ti = 0\n      while ti < Array::length(fields) {\n        let (_, fe) = Array::get(fields, ti)\n        check_arm_resume_tail(fe, false, sh, errors)\n        ti = ti + 1\n      }\n    },\n    ELoop(binds, b) => {\n      let mut ti = 0\n      let mut loop_sh = false\n      while ti < Array::length(binds) {\n        let (bn, be) = Array::get(binds, ti)\n        if bn == \"resume\" {\n          loop_sh = true\n        } else {\n          ()\n        }\n        check_arm_resume_tail(be, false, sh, errors)\n        ti = ti + 1\n      }\n      check_arm_resume_tail(b, false, sh || loop_sh, errors)\n    },\n    ELabeledArg(_, _, inner) => check_arm_resume_tail(inner, false, sh, errors),\n    EBreak(opt) => match opt {\n      Some(inner) => check_arm_resume_tail(inner, false, sh, errors),\n      None => ()\n    },\n    EContinue(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        check_arm_resume_tail(Array::get(items, ti), false, sh, errors)\n        ti = ti + 1\n      }\n    },\n    EMap(pairs) => {\n      let mut ti = 0\n      while ti < Array::length(pairs) {\n        let (_, pe) = Array::get(pairs, ti)\n        check_arm_resume_tail(pe, false, sh, errors)\n        ti = ti + 1\n      }\n    },\n    ESpread(inner) => check_arm_resume_tail(inner, false, sh, errors),\n    _ => ()\n  }\n}\n\n/// #942 (ADR-0050): a call-position `resume(...)` OUTSIDE any handler arm has\n/// no continuation to resume. Codegen emits the tag-1 continuation throw\n/// unconditionally (see codegen/common_analysis — the module must stay valid),\n/// so `fn f() -> Int { resume(1); 2 }` compiled and then died at runtime with\n/// an unhandled wasm exception. Walk every top-level statement expression and\n/// reject it in the checker instead. Only CALLS are rejected — `resume` as an\n/// ordinary binding name (e.g. lib/@vibe/parser/lexer.vibe's `let resume =\n/// ...`, which is passed around but never called) stays legal. On reaching an\n/// EHandle, the handled body is still \"outside\" (a resume there is not in any\n/// arm); non-Error arm bodies switch to the check_arm_resume_tail walk above,\n/// and Error arms are left to reject_resume_in_error_arm (#640).\n/// `sh` = `resume` is shadowed by an enclosing binder (Codex P2 on #969):\n/// codegen's prefer_bound_call routes `resume(x)` to the BOUND function\n/// whenever a top-level fn/let named resume, a local binding, a lambda param,\n/// or a match/for/loop binder named resume is in scope — such calls ran fine\n/// pre-#942 and must stay accepted. check_stmts seeds `sh` from the top-level\n/// declarations (fn resume / let resume / extern / imports).\nexport fn reject_resume_outside_handler(e: Expr, sh: Bool, errors: Array[String]) -> Unit {\n  match e {\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(nm, off) => if nm == \"resume\" && !sh {\n          Array::push(errors, String::concat(\"resume(...) is only valid inside a handler arm of `handle ... with` — outside one there is no continuation to resume (#942, ADR-0050)\", off_marker(off)))\n        } else {\n          ()\n        },\n        _ => reject_resume_outside_handler(callee, sh, errors)\n      }\n      let mut ri = 0\n      while ri < Array::length(args) {\n        reject_resume_outside_handler(Array::get(args, ri), sh, errors)\n        ri = ri + 1\n      }\n    },\n    EHandle(body, harms) => {\n      reject_resume_outside_handler(body, sh, errors)\n      let mut hi = 0\n      while hi < Array::length(harms) {\n        let (hpat, hbody) = Array::get(harms, hi)\n        if handler_arm_pat_is_error(hpat) {\n          ()\n        } else {\n          check_arm_resume_tail(hbody, true, sh || pat_binds_resume(hpat), errors)\n        }\n        hi = hi + 1\n      }\n    },\n    ELet(ln, v, b, _) => {\n      reject_resume_outside_handler(v, sh, errors)\n      reject_resume_outside_handler(b, sh || ln == \"resume\", errors)\n    },\n    ELetMut(ln, v, b, _) => {\n      reject_resume_outside_handler(v, sh, errors)\n      reject_resume_outside_handler(b, sh || ln == \"resume\", errors)\n    },\n    ELetRec(ln, v, b) => {\n      reject_resume_outside_handler(v, sh || ln == \"resume\", errors)\n      reject_resume_outside_handler(b, sh || ln == \"resume\", errors)\n    },\n    ESeq(a, b) => {\n      reject_resume_outside_handler(a, sh, errors)\n      reject_resume_outside_handler(b, sh, errors)\n    },\n    EIf(cnd, t, el) => {\n      reject_resume_outside_handler(cnd, sh, errors)\n      reject_resume_outside_handler(t, sh, errors)\n      reject_resume_outside_handler(el, sh, errors)\n    },\n    EMatch(scr, marms) => {\n      reject_resume_outside_handler(scr, sh, errors)\n      let mut mi = 0\n      while mi < Array::length(marms) {\n        let (mp, mb) = Array::get(marms, mi)\n        reject_resume_outside_handler(mb, sh || pat_binds_resume(mp), errors)\n        mi = mi + 1\n      }\n    },\n    EWhile(cnd, b) => {\n      reject_resume_outside_handler(cnd, sh, errors)\n      reject_resume_outside_handler(b, sh, errors)\n    },\n    EForIn(v1, v2, it, b) => {\n      reject_resume_outside_handler(it, sh, errors)\n      let for_sh = v1 == \"resume\" || (match v2 {\n        Some(v2n) => v2n == \"resume\",\n        None => false\n      })\n      reject_resume_outside_handler(b, sh || for_sh, errors)\n    },\n    EBinOp(_, l, r) => {\n      reject_resume_outside_handler(l, sh, errors)\n      reject_resume_outside_handler(r, sh, errors)\n    },\n    EUnaryOp(_, inner) => reject_resume_outside_handler(inner, sh, errors),\n    EAssign(_, v, b) => {\n      reject_resume_outside_handler(v, sh, errors)\n      reject_resume_outside_handler(b, sh, errors)\n    },\n    EAssignOp(_, _, v, b) => {\n      reject_resume_outside_handler(v, sh, errors)\n      reject_resume_outside_handler(b, sh, errors)\n    },\n    EFn(_, _, fparams, _, _, fb) => reject_resume_outside_handler(fb, sh || fn_params_bind_resume(fparams), errors),\n    EReturn(inner) => reject_resume_outside_handler(inner, sh, errors),\n    EDot(obj, _, _, _) => reject_resume_outside_handler(obj, sh, errors),\n    ETuple(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        reject_resume_outside_handler(Array::get(items, ti), sh, errors)\n        ti = ti + 1\n      }\n    },\n    EArray(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        reject_resume_outside_handler(Array::get(items, ti), sh, errors)\n        ti = ti + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let mut ti = 0\n      while ti < Array::length(fields) {\n        let (_, fe) = Array::get(fields, ti)\n        reject_resume_outside_handler(fe, sh, errors)\n        ti = ti + 1\n      }\n    },\n    ELoop(binds, b) => {\n      let mut ti = 0\n      let mut loop_sh = false\n      while ti < Array::length(binds) {\n        let (bn, be) = Array::get(binds, ti)\n        if bn == \"resume\" {\n          loop_sh = true\n        } else {\n          ()\n        }\n        reject_resume_outside_handler(be, sh, errors)\n        ti = ti + 1\n      }\n      reject_resume_outside_handler(b, sh || loop_sh, errors)\n    },\n    ELabeledArg(_, _, inner) => reject_resume_outside_handler(inner, sh, errors),\n    EBreak(opt) => match opt {\n      Some(inner) => reject_resume_outside_handler(inner, sh, errors),\n      None => ()\n    },\n    EContinue(items) => {\n      let mut ti = 0\n      while ti < Array::length(items) {\n        reject_resume_outside_handler(Array::get(items, ti), sh, errors)\n        ti = ti + 1\n      }\n    },\n    EMap(pairs) => {\n      let mut ti = 0\n      while ti < Array::length(pairs) {\n        let (_, pe) = Array::get(pairs, ti)\n        reject_resume_outside_handler(pe, sh, errors)\n        ti = ti + 1\n      }\n    },\n    ESpread(inner) => reject_resume_outside_handler(inner, sh, errors),\n    _ => ()\n  }\n}\n\nfn check_resume_values(e: Expr, ret_ty: Type, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> Subst {\n  match e {\n    ECall(callee, args, _) => {\n      let mut s1 = s\n      // #942 (Codex P2 on #970): `env` is the normal lexical TypeEnv threaded\n      // through check_expr, already containing every enclosing binder (the\n      // top-level fn/let hoist, the arm's own payload binders via henv, and\n      // any local let/let-mut/let-rec/match-arm binder this walk itself adds\n      // below) — so a `resume` name already bound here is a real callable\n      // binding codegen's prefer_bound_call routes to, not the builtin.\n      let resume_shadowed = env_lookup(env, \"resume\") is Some(_)\n      match callee {\n        EIdent(nm, _) => {\n          // A Unit-returning op discards the resumed value at the perform\n          // site, so any resume argument is tolerated there (mirrors the\n          // statement-position Unit tolerance elsewhere; the existing idiom\n          // `Print(s) => resume(0)` for `Print(String) -> Unit` stays legal).\n          if nm == \"resume\" && !resume_shadowed && Array::length(args) == 1 && !(ret_ty is CtUnit) {\n            let (aty, ns, _) = check_expr(Array::get(args, 0), env, defs, s1, c, errors, tytab)\n            s1 = check_assignable(ret_ty, subst_apply(ns, aty), ns, errors, \"resume value type mismatch\", 0 - 1)\n          } else if nm == \"resume\" && !resume_shadowed && Array::length(args) == 0 && !(ret_ty is CtUnit) {\n            // #828: `resume()` on a value-returning op used to reach codegen,\n            // which indexes resume args[0] unconditionally — a compiler ICE\n            // with no diagnostic. Reject it here instead.\n            Array::push(errors, \"resume expects a value (the operation returns a non-Unit type); resume() with no argument is only valid for Unit-returning operations\")\n          } else {\n            ()\n          }\n        },\n        _ => {\n          s1 = check_resume_values(callee, ret_ty, env, defs, s1, c, errors, tytab)\n        }\n      }\n      let mut ri = 0\n      while ri < Array::length(args) {\n        s1 = check_resume_values(Array::get(args, ri), ret_ty, env, defs, s1, c, errors, tytab)\n        ri = ri + 1\n      }\n      s1\n    },\n    EHandle(_, _) => s,\n    ELet(ln, v, b, _) => check_resume_values(b, ret_ty, env_bind(env, ln, CtUnknown), defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    ELetMut(ln, v, b, _) => check_resume_values(b, ret_ty, env_bind(env, ln, CtUnknown), defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    ELetRec(ln, v, b) => check_resume_values(b, ret_ty, env_bind(env, ln, CtUnknown), defs, check_resume_values(v, ret_ty, env_bind(env, ln, CtUnknown), defs, s, c, errors, tytab), c, errors, tytab),\n    ESeq(a, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(a, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EIf(cnd, t, el) => check_resume_values(el, ret_ty, env, defs, check_resume_values(t, ret_ty, env, defs, check_resume_values(cnd, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab), c, errors, tytab),\n    EMatch(scr, marms) => {\n      let mut s1 = check_resume_values(scr, ret_ty, env, defs, s, c, errors, tytab)\n      let mut mi = 0\n      while mi < Array::length(marms) {\n        let (mp, mb) = Array::get(marms, mi)\n        s1 = check_resume_values(mb, ret_ty, resume_walk_bind_pat(mp, env), defs, s1, c, errors, tytab)\n        mi = mi + 1\n      }\n      s1\n    },\n    EWhile(cnd, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(cnd, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EForIn(fname, fidx, it, b) => {\n      let fenv = match fidx {\n        Some(fi) => env_bind(env_bind(env, fname, CtUnknown), fi, CtUnknown),\n        None => env_bind(env, fname, CtUnknown)\n      }\n      check_resume_values(b, ret_ty, fenv, defs, check_resume_values(it, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab)\n    },\n    EBinOp(_, l, r) => check_resume_values(r, ret_ty, env, defs, check_resume_values(l, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EUnaryOp(_, inner) => check_resume_values(inner, ret_ty, env, defs, s, c, errors, tytab),\n    EAssign(_, v, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EAssignOp(_, _, v, b) => check_resume_values(b, ret_ty, env, defs, check_resume_values(v, ret_ty, env, defs, s, c, errors, tytab), c, errors, tytab),\n    EFn(_, _, _, _, _, fb) => check_resume_values(fb, ret_ty, env, defs, s, c, errors, tytab),\n    EReturn(inner) => check_resume_values(inner, ret_ty, env, defs, s, c, errors, tytab),\n    EDot(obj, _, _, _) => check_resume_values(obj, ret_ty, env, defs, s, c, errors, tytab),\n    ETuple(items) => {\n      let mut s1 = s\n      let mut ti = 0\n      while ti < Array::length(items) {\n        s1 = check_resume_values(Array::get(items, ti), ret_ty, env, defs, s1, c, errors, tytab)\n        ti = ti + 1\n      }\n      s1\n    },\n    EArray(items) => {\n      let mut s1 = s\n      let mut ti = 0\n      while ti < Array::length(items) {\n        s1 = check_resume_values(Array::get(items, ti), ret_ty, env, defs, s1, c, errors, tytab)\n        ti = ti + 1\n      }\n      s1\n    },\n    _ => s\n  }\n}\n\nexport fn check_expr(expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> (Type, Subst, Int) {\n  match expr {\n    EInt(_) => (CtInt, s, c),\n    EFloat(_) => (CtDouble, s, c),\n    EString(_) => (CtString, s, c),\n    EBool(_) => (CtBool, s, c),\n    EUnit => (CtUnit, s, c),\n    EIdent(name, ident_off) => match env_lookup(env, name) {\n      Some(t) => {\n        let (ti, c1, new_bounds) = instantiate(t, c)\n        let nblen = Array::length(new_bounds)\n        let mut s1 = s\n        let mut bi = 0\n        while bi < nblen {\n          let (vid, bounds) = Array::get(new_bounds, bi)\n          if Array::length(bounds) != 0 {\n            s1 = subst_add_bound(s1, vid, bounds)\n          }\n          bi = bi + 1\n        }\n        // Record this user identifier's inferred (raw, pre-final-subst) type\n        // keyed by its real source offset, for typed-hover (vibe type-at) on\n        // locals and parameters. Synthetic idents (off < 0) are skipped.\n        if ident_off >= 0 {\n          Array::push(tytab, (ident_off, ti))\n        } else {\n          ()\n        }\n        (ti, s1, c1)\n      },\n      None => match lookup_builtin(name) {\n        Some(t) => {\n          if ident_off >= 0 {\n            Array::push(tytab, (ident_off, t))\n          } else {\n            ()\n          }\n          (t, s, c)\n        },\n        None => match resolve_trait_method_ident(name, env, defs, s) {\n          Some(mty) => {\n            if ident_off >= 0 {\n              Array::push(tytab, (ident_off, mty))\n            } else {\n              ()\n            }\n            (mty, s, c)\n          },\n          None => match resolve_qualified_ctor_ident(name, env, defs) {\n            Some(ct) => {\n              let (ti, c1, new_bounds) = instantiate(ct, c)\n              let nblen = Array::length(new_bounds)\n              let mut s1 = s\n              let mut bi = 0\n              while bi < nblen {\n                let (vid, bounds) = Array::get(new_bounds, bi)\n                if Array::length(bounds) != 0 {\n                  s1 = subst_add_bound(s1, vid, bounds)\n                } else {\n                  ()\n                }\n                bi = bi + 1\n              }\n              if ident_off >= 0 {\n                Array::push(tytab, (ident_off, ti))\n              } else {\n                ()\n              }\n              (ti, s1, c1)\n            },\n            None => {\n              Array::push(errors, String::concat(String::concat(\"unknown name: \", name), off_marker_len(ident_off, String::length(name))))\n              (CtUnknown, s, c)\n            }\n          }\n        }\n      }\n    },\n    ESeq(_, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\n    ELet(_, _, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\n    ELetRec(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\n    ELetMut(_, _, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\n    EIf(cond, then_e, else_e) => {\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)\n      let resolved_ct = subst_apply(s1, ct)\n      match resolved_ct {\n        CtBool => (),\n        CtUnknown => (),\n        CtVar(_) => (),\n        _ => Array::push(errors, \"if condition must be Bool\")\n      }\n      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1, errors, tytab)\n      let (et, s3, c3) = check_expr(else_e, env, defs, s2, c2, errors, tytab)\n      // The two branches must agree when both yield a real value (previously\n      // unchecked — `if c { 1 } else { \"x\" }` was accepted). A `CtUnit` branch\n      // is tolerated: `if c { stmt }` desugars to an `else ()` whose value is\n      // discarded, and a statement-position `if` need not have matching arms.\n      let rtt = subst_apply(s3, tt)\n      let ret = subst_apply(s3, et)\n      // When one branch yields Unit (an else-less `if`, whose missing else is\n      // `()`, or an explicit `()` branch), the branches need not agree and the\n      // expression yields Unit as a VALUE — so `let x: Int = if c { 1 }` is\n      // rejected (it returns Unit when c is false) while a statement-position\n      // `if` is harmless (its value is discarded). Only when BOTH branches yield\n      // a real (non-Unit) value must they agree, and the result is that type.\n      let (s3b, if_ty) = match rtt {\n        CtUnit => (s3, CtUnit),\n        _ => match ret {\n          CtUnit => (s3, CtUnit),\n          _ => (check_assignable(rtt, ret, s3, errors, \"if branches have incompatible types\", 0 - 1), tt)\n        }\n      }\n      (if_ty, s3b, c3)\n    },\n    ECall(callee, args, call_off) => match callee {\n      // `perform EffName::Op(opargs)` parses as ECall(EIdent(\"perform\"),\n      // [ECall(EIdent(\"EffName::Op\"), opargs)]). The op name may be a builtin\n      // effect (Stdin/Stdout/...) not registered in the checker env, so check\n      // only the op ARGUMENTS (not the op callee) and yield a fresh result type.\n      // `resume(v)` likewise yields the continuation result (a fresh var;\n      // handler arms are otherwise unchecked).\n      EIdent(name, callee_off) => {\n        field_write_mut_check(name, args, env, defs, s, c, errors, tytab, check_expr)\n        index_target_check(name, args, env, defs, s, c, errors, check_expr)\n        if name == \"perform\" {\n          if Array::length(args) == 1 {\n            match Array::get(args, 0) {\n              ECall(op_callee, opargs, _) => {\n                // #640 Stage 2: `throw(x)` now parses to this exact shape\n                // (perform Error::Throw(x)). Preserve EThrow's historical\n                // typing verbatim: the payload is NOT type-checked (EThrow fell\n                // to check_expr's catch-all) and the value is CtUnknown (a\n                // wildcard — `throw` sits in any expression position). Running\n                // the generic perform path instead would newly check the ~970\n                // existing throw payloads and yield a fresh var, changing\n                // pinned checker behavior.\n                let is_error_throw = match op_callee {\n                  EIdent(op_qname0, _) => op_qname0 == \"Error::Throw\",\n                  _ => false\n                }\n                if is_error_throw {\n                  (CtUnknown, s, c)\n                } else {\n                  let oalen = Array::length(opargs)\n                  let mut s1 = s\n                  let mut c1 = c\n                  let oparg_tys = array_empty()\n                  let mut ai = 0\n                  while ai < oalen {\n                    let (oat, ns, nc) = check_expr(Array::get(opargs, ai), env, defs, s1, c1, errors, tytab)\n                    Array::push(oparg_tys, oat)\n                    s1 = ns\n                    c1 = nc\n                    ai = ai + 1\n                  }\n                  // #813: when the op belongs to a DECLARED effect, validate the\n                  // perform against its signature — arity and (ground-gated)\n                  // argument types were previously unchecked, so\n                  // `perform R::Take(\"str\")` against `Take(Int)` compiled and\n                  // produced garbage. Builtin/imported effects (no TDEffect) skip.\n                  match op_callee {\n                    EIdent(op_qname, op_off) => match effect_op_sig(defs, op_qname) {\n                      Some(sig) => {\n                        let (sig_params, sig_ret) = sig\n                        if Array::length(sig_params) != oalen {\n                          Array::push(errors, String::concat(\"perform \", String::concat(op_qname, String::concat(\" expects \", String::concat(__to_string(Array::length(sig_params)), String::concat(\" argument(s), got \", String::concat(__to_string(oalen), off_marker(op_off))))))))\n                        } else {\n                          let mut vi = 0\n                          while vi < oalen {\n                            s1 = check_assignable(Array::get(sig_params, vi), subst_apply(s1, Array::get(oparg_tys, vi)), s1, errors, String::concat(\"perform argument type mismatch for \", op_qname), op_off)\n                            vi = vi + 1\n                          }\n                        }\n                        // The perform's value is the op's declared return type —\n                        // typing it (instead of a fresh var) also lets resume/arm\n                        // consumers see the concrete type. Non-ground returns keep\n                        // the fresh var (generic inference untouched).\n                        if type_is_ground(sig_ret) {\n                          (sig_ret, s1, c1)\n                        } else {\n                          let (tv, c2) = fresh_var(c1)\n                          (tv, s1, c2)\n                        }\n                      },\n                      None => {\n                        // Unknown op of a DECLARED effect: the typo'd op would\n                        // never be matched by any handler arm — report it.\n                        let ci2 = String::index_of(op_qname, \"::\")\n                        if ci2 > 0 && effect_is_declared(defs, String::substring(op_qname, 0, ci2)) {\n                          Array::push(errors, String::concat(\"unknown operation `\", String::concat(String::substring(op_qname, ci2 + 2, String::length(op_qname)), String::concat(\"` of effect \", String::concat(String::substring(op_qname, 0, ci2), off_marker(op_off))))))\n                        } else {\n                          ()\n                        }\n                        let (tv, c2) = fresh_var(c1)\n                        (tv, s1, c2)\n                      }\n                    },\n                    _ => {\n                      let (tv, c2) = fresh_var(c1)\n                      (tv, s1, c2)\n                    }\n                  }\n                }\n              },\n              EIdent(_, _) => {\n                let (tv, c2) = fresh_var(c)\n                (tv, s, c2)\n              },\n              other => check_expr(other, env, defs, s, c, errors, tytab)\n            }\n          } else {\n            (CtUnknown, s, c)\n          }\n        } else if name == \"resume\" {\n          let alen = Array::length(args)\n          let mut s1 = s\n          let mut c1 = c\n          let mut ai = 0\n          while ai < alen {\n            let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)\n            s1 = ns\n            c1 = nc\n            ai = ai + 1\n          }\n          let (tv, c2) = fresh_var(c1)\n          (tv, s1, c2)\n        } else if name == \"%wasm\" {\n          // #805 (ADR-0072) inline wasm marker: only producible by the parser's\n          // `fn f(a: Int, ..) -> Int = wasm \"...\"` form (a `%`-ident cannot be\n          // parsed in expression position, so user source cannot forge it).\n          // The declared signature is trusted extern-let style; the call's\n          // value is a fresh var that unifies with the declared Int return.\n          // The single arg is the WAT text literal — shape-checked here\n          // defensively, never evaluated.\n          let wasm_shape_ok = if Array::length(args) == 1 {\n            match Array::get(args, 0) {\n              EString(_) => true,\n              _ => false\n            }\n          } else {\n            false\n          }\n          if !wasm_shape_ok {\n            Array::push(errors, \"malformed inline wasm marker (expected a single WAT string literal)\")\n          } else {\n            ()\n          }\n          let (tv, c2) = fresh_var(c)\n          (tv, s, c2)\n        } else if name == \"Some\" {\n          if Array::length(args) == 1 {\n            let (at, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n            (tab_call_ty(tytab, call_off, CtOption(subst_apply(s1, at))), s1, c1)\n          } else {\n            // `Some` takes exactly one payload — `Some(1, 2)` was accepted.\n            Array::push(errors, String::concat(String::concat(\"Some expects 1 argument, got \", __to_string(Array::length(args))), off_marker_len(callee_off, 4)))\n            (tab_call_ty(tytab, call_off, CtOption(CtUnknown)), s, c)\n          }\n        } else if name == \"__index\" && Array::length(args) == 2 {\n          // `obj[i]` (`__index(obj, i)`) is typed polymorphically by the builtin\n          // table, losing the result type — `let s: String = a[0]` over an\n          // `Array[Int]` slipped through. When the receiver resolves to\n          // `CtArray(elem)`, refine the result to `elem`; String/Bytes indexing\n          // yields the char/byte code (`Int`) so `let s: String = \"abc\"[0]`\n          // (which returns 97) must be rejected. Var / unknown / named receivers\n          // keep the conservative CtUnknown. (index_target_check above still\n          // validates the receiver/subscript shapes on a throwaway channel.)\n          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let result = match subst_apply(s2, obj_ty) {\n            CtArray(elem) => elem,\n            CtString => CtInt,\n            CtBytes => CtInt,\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, result), s2, c2)\n        } else if name == \"ArrayBuilder::new\" && Array::length(args) == 0 {\n          // #938: the builder ops were typed all-CtUnknown, so\n          // `ArrayBuilder::push(b, 1); ArrayBuilder::push(b, \"two\")` compiled\n          // clean and the frozen array leaked a raw String pointer through an\n          // `Array[Int]` annotation. Give the builder a REAL element slot:\n          // `CtNamed(\"ArrayBuilder\", [fresh])` — the same shape an explicit\n          // `b: ArrayBuilder[String]` annotation already resolves to\n          // (checker_resolve TyApp fallback), so annotated params get checked\n          // by the same push/freeze rules for free. The fresh var is bound by\n          // the FIRST push and every later push must unify with it. (ELet's\n          // generalize deliberately skips this shape — see the value-restriction\n          // note at the ELet arm — or each use would re-instantiate the var and\n          // the pushes could never disagree.)\n          let (ev, c1) = fresh_var(c)\n          (tab_call_ty(tytab, call_off, CtNamed(\"ArrayBuilder\", Array::slice([\n            ev\n          ], 0, 1))), s, c1)\n        } else if name == \"ArrayBuilder::push\" && Array::length(args) == 2 {\n          // #938: unify the pushed value with the builder's element slot. A\n          // builder that reaches here untyped (CtUnknown / var receiver from an\n          // un-annotated param) stays tolerant, exactly like Array::push's\n          // ground gate.\n          let (b_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (v_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s3 = match subst_apply(s2, b_ty) {\n            CtNamed(bn, bargs) => if bn == \"ArrayBuilder\" && Array::length(bargs) == 1 {\n              match unify(Array::get(bargs, 0), v_ty, s2) {\n                Some(su) => su,\n                None => {\n                  Array::push(errors, String::concat(\"ArrayBuilder::push element type mismatch: builder holds \", String::concat(type_to_string(subst_apply(s2, Array::get(bargs, 0))), String::concat(\", got \", String::concat(type_to_string(subst_apply(s2, v_ty)), off_marker_len(callee_off, String::length(name)))))))\n                  s2\n                }\n              }\n            } else {\n              s2\n            },\n            _ => s2\n          }\n          (tab_call_ty(tytab, call_off, CtUnit), s3, c2)\n        } else if name == \"ArrayBuilder::freeze\" && Array::length(args) == 1 {\n          // #938: freeze returns an array of the builder's (now tracked) element\n          // type, so a wrong return/let annotation is caught by the ordinary\n          // unify instead of vanishing into CtArray(CtUnknown).\n          let (b_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let result = match subst_apply(s1, b_ty) {\n            CtNamed(bn, bargs) => if bn == \"ArrayBuilder\" && Array::length(bargs) == 1 {\n              CtArray(subst_apply(s1, Array::get(bargs, 0)))\n            } else {\n              CtArray(CtUnknown)\n            },\n            _ => CtArray(CtUnknown)\n          }\n          (tab_call_ty(tytab, call_off, result), s1, c1)\n        } else if name == \"FrozenArray::from_array\" && Array::length(args) == 1 {\n          // #906: FrozenArray[T] is a checker-only phantom-type distinction over\n          // Array[T]'s exact same runtime layout -- same technique as\n          // ArrayBuilder above (freeze is a pure identity cast; here from_array\n          // is too). Capture the argument's element type into\n          // CtNamed(\"FrozenArray\", [elem]) so get/to_array recover a real type\n          // instead of CtUnknown. A non-concrete argument (var/unknown\n          // receiver) stays tolerant, matching Array::reverse's own fallback.\n          let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let elem = match subst_apply(s1, a_ty) {\n            CtArray(e) => e,\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, CtNamed(\"FrozenArray\", Array::slice([\n            elem\n          ], 0, 1))), s1, c1)\n        } else if name == \"FrozenArray::to_array\" && Array::length(args) == 1 {\n          // #906: the reverse of from_array -- unwraps a tracked FrozenArray\n          // element type back into an ordinary Array[T], same shape as\n          // ArrayBuilder::freeze above.\n          let (fa_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let result = match subst_apply(s1, fa_ty) {\n            CtNamed(fn0, fargs) => if fn0 == \"FrozenArray\" && Array::length(fargs) == 1 {\n              CtArray(subst_apply(s1, Array::get(fargs, 0)))\n            } else {\n              CtArray(CtUnknown)\n            },\n            _ => CtArray(CtUnknown)\n          }\n          (tab_call_ty(tytab, call_off, result), s1, c1)\n        } else if name == \"FrozenArray::get\" && Array::length(args) == 2 {\n          // #906: same element-type extraction as Array::get, over a tracked\n          // FrozenArray receiver instead of CtArray.\n          let (fa_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let result = match subst_apply(s2, fa_ty) {\n            CtNamed(fn1, fargs1) => if fn1 == \"FrozenArray\" && Array::length(fargs1) == 1 {\n              subst_apply(s2, Array::get(fargs1, 0))\n            } else {\n              CtUnknown\n            },\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, result), s2, c2)\n        } else if name == \"FrozenArray::length\" && Array::length(args) == 1 {\n          // #906: length is not element-type-dependent -- always Int, but the\n          // receiver still needs checking (consistent with every other builtin\n          // branch here checking all of its arguments).\n          let (_, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          (tab_call_ty(tytab, call_off, CtInt), s1, c1)\n        } else if name == \"MutList::empty\" && Array::length(args) == 1 {\n          // ADR-0090 Phase 1: MutList[T, r] is a checker-only phantom over\n          // Array[T]'s runtime layout (same technique as FrozenArray above).\n          // The region argument's type -- inside `region r { .. }` a type\n          // variable that `__region_run` later pins to its rigid skolem --\n          // is captured as the SECOND type argument, so the escape scan in\n          // the `__region_run` branch below can see region-tainted values in\n          // fully-zonked types. The element type stays tolerant (CtUnknown),\n          // matching FrozenArray's rows.\n          let (r_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let zoned_r = subst_apply(s1, r_ty)\n          // #1274 Codex P1: the token must be the unforgeable `#region_N`\n          // skolem the `region` binder carries. Any other argument type\n          // (e.g. `MutList::empty(0)`) would install a skolem-free phantom\n          // that the `__region_run` escape scan can never see, making the\n          // region-bound collection freely constructible and escapable.\n          // Second-class by design: the token cannot pass through function\n          // parameters in this slice (a param's type is a fresh var, not\n          // the skolem), matching the ADR's escape rules.\n          let is_region_token = match zoned_r {\n            CtNamed(zr_name, _) => String::length(zr_name) >= 8 && String::substring(zr_name, 0, 8) == \"#region_\",\n            _ => false\n          }\n          if is_region_token {\n            ()\n          } else {\n            Array::push(errors, String::concat(\"MutList::empty requires the region token bound by `region r { ... }` (the token is second-class and cannot be forged or passed through function parameters)\", off_marker_len(callee_off, String::length(name))))\n          }\n          (tab_call_ty(tytab, call_off, CtNamed(\"MutList\", Array::slice([\n            CtUnknown,\n            zoned_r\n          ], 0, 2))), s1, c1)\n        } else if name == \"MutList::push\" && Array::length(args) == 2 {\n          // ADR-0090 Phase 1: borrows the list (arg0), consumes the element.\n          // The tolerant CtUnknown element type means no per-push element\n          // unification yet -- the checker slice keeps FrozenArray's\n          // tolerance until MutList grows real element inference.\n          let (_, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          (tab_call_ty(tytab, call_off, CtUnit), s2, c2)\n        } else if name == \"MutList::freeze\" && Array::length(args) == 1 {\n          // ADR-0090 Phase 1: the sanctioned region exit -- drops the region\n          // type argument, so the frozen result passes the `__region_run`\n          // escape scan (runtime identity cast, like ArrayBuilder::freeze).\n          let (ml_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let elem = match subst_apply(s1, ml_ty) {\n            CtNamed(ml_name, ml_args) => if ml_name == \"MutList\" && Array::length(ml_args) == 2 {\n              subst_apply(s1, Array::get(ml_args, 0))\n            } else {\n              CtUnknown\n            },\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, CtNamed(\"FrozenArray\", Array::slice([\n            elem\n          ], 0, 1))), s1, c1)\n        } else if name == \"MutList::to_array\" && Array::length(args) == 1 {\n          // ADR-0090 Phase 1: like freeze but exits to a plain Array[T].\n          let (ml_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let elem = match subst_apply(s1, ml_ty) {\n            CtNamed(ml_name, ml_args) => if ml_name == \"MutList\" && Array::length(ml_args) == 2 {\n              subst_apply(s1, Array::get(ml_args, 0))\n            } else {\n              CtUnknown\n            },\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, CtArray(elem)), s1, c1)\n        } else if name == \"FixedArray::make\" && Array::length(args) == 2 {\n          // #1140: FixedArray[T] is a checker-only phantom-type distinction\n          // over Array[T]'s exact same runtime layout, same technique as\n          // FrozenArray above (codegen already treats FixedArray::make/get/\n          // set/length as their own opcodes -- see codegen/gc/backend_call.vibe\n          // and codegen/expr/compile_call.vibe -- only the checker-level type\n          // tracking was missing, degrading every FixedArray value to\n          // CtArray(CtUnknown)/CtUnknown). Capture the init value's type into\n          // CtNamed(\"FixedArray\", [elem]) so get/set/length recover a real\n          // element type. The length (arg 0) must still be checked against\n          // Int here -- #985's builtin_first_arg_head table already enforced\n          // this via the fallback path, and this ECall branch pre-empts that\n          // fallback, so skipping the check here would silently regress\n          // `FixedArray::make(\"4\", 0)` back to compiling clean (caught by\n          // checker_builtin_arg_head_test.vibe's #985 review case).\n          let (len_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let s1b = check_assignable(CtInt, subst_apply(s1, len_ty), s1, errors, \"FixedArray::make length must be Int\", call_off)\n          let (init_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1b, c1, errors, tytab)\n          let elem = subst_apply(s2, init_ty)\n          (tab_call_ty(tytab, call_off, CtNamed(\"FixedArray\", Array::slice([\n            elem\n          ], 0, 1))), s2, c2)\n        } else if name == \"FixedArray::get\" && Array::length(args) == 2 {\n          // #1140: same element-type extraction as FrozenArray::get, over a\n          // tracked FixedArray receiver. Index (arg 1) checked against Int,\n          // same discipline #985's builtin_first_arg_head table enforced for\n          // Int64Array::get before this ECall branch pre-empted the fallback.\n          let (fa_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (idx_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s2b = check_assignable(CtInt, subst_apply(s2, idx_ty), s2, errors, \"FixedArray::get index must be Int\", call_off)\n          let result = match subst_apply(s2b, fa_ty) {\n            CtNamed(fan, faargs) => if fan == \"FixedArray\" && Array::length(faargs) == 1 {\n              subst_apply(s2b, Array::get(faargs, 0))\n            } else {\n              CtUnknown\n            },\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, result), s2b, c2)\n        } else if (name == \"FixedArray::set\" || name == \"FixedArray::unsafe_set\") && Array::length(args) == 3 {\n          // #1140: writing a value not assignable to the tracked element type\n          // is now a located type error instead of silently compiling through\n          // CtUnknown (same discipline as Map::set below). `unsafe_set` only\n          // skips the runtime bounds check (codegen concern) -- the static\n          // element-type contract is identical to `set`. Index (arg 1)\n          // checked against Int, same #985 discipline as FixedArray::get above.\n          let (fa_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (idx_ty2, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s2b = check_assignable(CtInt, subst_apply(s2, idx_ty2), s2, errors, String::concat(\"index must be Int for \", name), call_off)\n          let (v_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2b, c2, errors, tytab)\n          let s4 = match subst_apply(s3, fa_ty) {\n            CtNamed(fan2, faargs2) => if fan2 == \"FixedArray\" && Array::length(faargs2) == 1 {\n              check_assignable(subst_apply(s3, Array::get(faargs2, 0)), subst_apply(s3, v_ty), s3, errors, String::concat(\"value type mismatch for \", name), call_off)\n            } else {\n              s3\n            },\n            _ => s3\n          }\n          (tab_call_ty(tytab, call_off, CtUnit), s4, c3)\n        } else if name == \"FixedArray::length\" && Array::length(args) == 1 {\n          // #1140: same as FrozenArray::length -- always Int, receiver still checked.\n          let (_, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          (tab_call_ty(tytab, call_off, CtInt), s1, c1)\n        } else if name == \"FixedArray::blit\" && Array::length(args) == 5 {\n          // #1140: dst/dst_off/src/src_off/len -- dst_off/src_off/len (1, 3, 4)\n          // checked against Int, matching the Int positions the pre-existing\n          // fallback signature (fixed_array_five_params(.., CtInt, .., CtInt,\n          // CtInt)) enforced before this ECall branch pre-empted it. No\n          // cross-checking that dst's and src's tracked element types match\n          // (kept tolerant, same spirit as that same fallback signature's\n          // CtArray(CtUnknown) receiver positions).\n          let (_, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (dst_off_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s2b = check_assignable(CtInt, subst_apply(s2, dst_off_ty), s2, errors, \"FixedArray::blit dst_off must be Int\", call_off)\n          let (_, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2b, c2, errors, tytab)\n          let (src_off_ty, s4, c4) = check_expr(Array::get(args, 3), env, defs, s3, c3, errors, tytab)\n          let s4b = check_assignable(CtInt, subst_apply(s4, src_off_ty), s4, errors, \"FixedArray::blit src_off must be Int\", call_off)\n          let (len_ty2, s5, c5) = check_expr(Array::get(args, 4), env, defs, s4b, c4, errors, tytab)\n          let s5b = check_assignable(CtInt, subst_apply(s5, len_ty2), s5, errors, \"FixedArray::blit len must be Int\", call_off)\n          (tab_call_ty(tytab, call_off, CtUnit), s5b, c5)\n        } else if name == \"Map::set\" && Array::length(args) == 3 {\n          // #983: every Map API's VALUE position was `CtUnknown` (the static\n          // builtin table cannot mint per-call vars), so\n          // `Map::set(m, \"b\", \"str\")` into a `Map[String, Int]` compiled clean\n          // and trapped at the consumer. Map literals now carry a real value\n          // slot (`CtNamed(\"Map\", [CtString, v])` — the shape a\n          // `Map[String, V]` annotation already resolves to), and set checks\n          // the written value against it, ground-gated via `check_assignable`\n          // (same tolerate discipline as Array::push — untyped/var receivers\n          // stay tolerant). The key check replicates the CtString param the\n          // bypassed table signature enforced.\n          let (m_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (k_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let (v_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\n          let s4 = check_assignable(CtString, subst_apply(s3, k_ty), s3, errors, \"argument type mismatch for Map::set\", call_off)\n          let s5 = match subst_apply(s4, m_ty) {\n            CtNamed(mn, margs) => if mn == \"Map\" && Array::length(margs) == 2 {\n              check_assignable(subst_apply(s4, Array::get(margs, 1)), subst_apply(s4, v_ty), s4, errors, \"Map::set value type mismatch\", call_off)\n            } else {\n              s4\n            },\n            _ => s4\n          }\n          let mret = match subst_apply(s5, m_ty) {\n            CtNamed(mn2, margs2) => if mn2 == \"Map\" && Array::length(margs2) == 2 {\n              subst_apply(s5, m_ty)\n            } else {\n              CtNamed(\"Map\", [\n                CtString,\n                CtUnknown\n              ])\n            },\n            _ => CtNamed(\"Map\", [\n              CtString,\n              CtUnknown\n            ])\n          }\n          (tab_call_ty(tytab, call_off, mret), s5, c3)\n        } else if name == \"Map::get\" && Array::length(args) == 2 {\n          // #983: refine the result from bare CtUnknown to the receiver's value\n          // slot, so a wrongly-typed consume of the looked-up value is caught\n          // by the ordinary unify. NOTE: `Map::get` returns the RAW stored\n          // value (0 on a miss) — `declare Map::get(Map[T, U], T) -> U` in\n          // builtins/declarations.vibe and the linear codegen agree — NOT an\n          // Option. Untyped receivers keep the conservative CtUnknown.\n          let (m_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (k_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s3 = check_assignable(CtString, subst_apply(s2, k_ty), s2, errors, \"argument type mismatch for Map::get\", call_off)\n          let result = match subst_apply(s3, m_ty) {\n            CtNamed(mn, margs) => if mn == \"Map\" && Array::length(margs) == 2 {\n              subst_apply(s3, Array::get(margs, 1))\n            } else {\n              CtUnknown\n            },\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, result), s3, c2)\n        } else if name == \"Map::values\" && Array::length(args) == 1 {\n          // #983: values() of a value-slotted map is `Array[v]`, not\n          // `Array[CtUnknown]`.\n          let (m_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let result = match subst_apply(s1, m_ty) {\n            CtNamed(mn, margs) => if mn == \"Map\" && Array::length(margs) == 2 {\n              CtArray(subst_apply(s1, Array::get(margs, 1)))\n            } else {\n              CtArray(CtUnknown)\n            },\n            _ => CtArray(CtUnknown)\n          }\n          (tab_call_ty(tytab, call_off, result), s1, c1)\n        } else if name == \"Map::delete\" && Array::length(args) == 2 {\n          // #983: delete preserves the receiver's map type (value slot\n          // included) instead of collapsing it to `Map[String, CtUnknown]`.\n          let (m_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (k_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s3 = check_assignable(CtString, subst_apply(s2, k_ty), s2, errors, \"argument type mismatch for Map::delete\", call_off)\n          let mret = match subst_apply(s3, m_ty) {\n            CtNamed(mn, margs) => if mn == \"Map\" && Array::length(margs) == 2 {\n              subst_apply(s3, m_ty)\n            } else {\n              CtNamed(\"Map\", [\n                CtString,\n                CtUnknown\n              ])\n            },\n            _ => CtNamed(\"Map\", [\n              CtString,\n              CtUnknown\n            ])\n          }\n          (tab_call_ty(tytab, call_off, mret), s3, c2)\n        } else if name == \"Array::push\" && Array::length(args) == 2 {\n          // `Array::push(a, v)` requires `v` to match `a`'s element type — pushing\n          // a String into an `Array[Int]` was accepted (direct_call_return only\n          // checks arg-0 head). Check the value against a concrete element type;\n          // generic / var element types stay tolerant (check_assignable is ground-\n          // gated).\n          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (val_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s3 = match subst_apply(s2, obj_ty) {\n            CtArray(elem) => check_assignable(subst_apply(s2, elem), subst_apply(s2, val_ty), s2, errors, \"Array::push value type mismatch\", 0 - 1),\n            _ => s2\n          }\n          (tab_call_ty(tytab, call_off, CtUnit), s3, c2)\n        } else if name == \"Array::set\" && Array::length(args) == 3 {\n          // `Array::set(a, i, v)` requires `v` to match `a`'s element type (the 3rd\n          // arg was unchecked). Same ground-gated discipline as Array::push.\n          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (set_idx_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let (val_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\n          // #826: same head checks as Array::get (this branch also bypasses the\n          // direct fast path).\n          let as_recv_head = head_kind(subst_apply(s3, obj_ty))\n          if as_recv_head != 0 && as_recv_head != 9 {\n            Array::push(errors, String::concat(\"argument type mismatch for Array::set: receiver type \", String::concat(type_to_string(subst_apply(s3, obj_ty)), off_marker_len(callee_off, String::length(name)))))\n          } else if is_stream_named_type(subst_apply(s3, obj_ty)) {\n            // #827: Stream is CtNamed (head 0 = tolerated) but is NOT an Array.\n            Array::push(errors, String::concat(\"argument type mismatch for Array::set: receiver type \", String::concat(type_to_string(subst_apply(s3, obj_ty)), String::concat(\" is a Stream, not an Array (use `for await` / Stream::*)\", off_marker_len(callee_off, String::length(name))))))\n          } else {\n            ()\n          }\n          let as_idx_head = head_kind(subst_apply(s3, set_idx_ty))\n          if as_idx_head != 0 && as_idx_head != 1 {\n            Array::push(errors, String::concat(\"argument type mismatch for Array::set (arg 1): \", String::concat(type_to_string(subst_apply(s3, set_idx_ty)), off_marker_len(callee_off, String::length(name)))))\n          } else {\n            ()\n          }\n          let s4 = match subst_apply(s3, obj_ty) {\n            CtArray(elem) => check_assignable(subst_apply(s3, elem), subst_apply(s3, val_ty), s3, errors, \"Array::set value type mismatch\", 0 - 1),\n            _ => s3\n          }\n          (tab_call_ty(tytab, call_off, CtUnit), s4, c3)\n        } else if name == \"Array::push_all\" && Array::length(args) == 2 {\n          // `Array::push_all(a, b)` appends every element of `b` into `a`, so the\n          // two arrays must share an element type — `Array::push_all([1], [\"x\"])`\n          // merged Int and String elements and slipped through (push_all had no\n          // value/element check, only the arg-0 head). Same ground-gated discipline\n          // as Array::concat.\n          let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (b_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s3 = check_two_array_elems(subst_apply(s2, a_ty), subst_apply(s2, b_ty), s2, errors, \"Array::push_all element type mismatch\")\n          (tab_call_ty(tytab, call_off, CtUnit), s3, c2)\n        } else if name == \"Array::get\" && Array::length(args) == 2 {\n          // `Array::get(a, i)` returns the element type, but `direct_call_return`\n          // types it CtUnknown — `let s: String = Array::get(intArr, 0)` slipped\n          // through. Refine the result to the element type from a concrete\n          // `CtArray(elem)` receiver (var / generic receivers stay CtUnknown).\n          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (idx_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          // #826: this special branch bypasses the direct fast path, so the\n          // head checks never ran — `Array::get(\"str\", 0)` trapped at runtime\n          // and `Array::get(a, \"x\")` returned silent garbage. Same ground-gated\n          // discipline as builtin_first_arg_head (0 = tolerate).\n          let ag_recv_head = head_kind(subst_apply(s2, obj_ty))\n          if ag_recv_head != 0 && ag_recv_head != 9 {\n            Array::push(errors, String::concat(\"argument type mismatch for Array::get: receiver type \", String::concat(type_to_string(subst_apply(s2, obj_ty)), off_marker_len(callee_off, String::length(name)))))\n          } else if is_stream_named_type(subst_apply(s2, obj_ty)) {\n            // #827: Stream is CtNamed (head 0 = tolerated) but is NOT an Array.\n            Array::push(errors, String::concat(\"argument type mismatch for Array::get: receiver type \", String::concat(type_to_string(subst_apply(s2, obj_ty)), String::concat(\" is a Stream, not an Array (use `for await` / Stream::*)\", off_marker_len(callee_off, String::length(name))))))\n          } else {\n            ()\n          }\n          let ag_idx_head = head_kind(subst_apply(s2, idx_ty))\n          if ag_idx_head != 0 && ag_idx_head != 1 {\n            Array::push(errors, String::concat(\"argument type mismatch for Array::get (arg 1): \", String::concat(type_to_string(subst_apply(s2, idx_ty)), off_marker_len(callee_off, String::length(name)))))\n          } else {\n            ()\n          }\n          let result = match subst_apply(s2, obj_ty) {\n            CtArray(elem) => elem,\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, result), s2, c2)\n        } else if name == \"Array::reverse\" && Array::length(args) == 1 {\n          // Returns an array of the same element type (was CtUnknown).\n          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let result = match subst_apply(s1, obj_ty) {\n            CtArray(elem) => CtArray(elem),\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, result), s1, c1)\n        } else if name == \"Array::concat\" && Array::length(args) == 2 {\n          // Returns an array of the receivers' element type (was CtUnknown). Refine\n          // from the first concrete `CtArray(elem)` operand, and require the two\n          // operands' element types to agree — `Array::concat([1], [\"x\"])` mixed\n          // `Array[Int]` with `Array[String]` and slipped through (the result was\n          // refined to the first operand but the second was never checked).\n          let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (b_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let a_app = subst_apply(s2, a_ty)\n          let b_app = subst_apply(s2, b_ty)\n          let s3 = check_two_array_elems(a_app, b_app, s2, errors, \"Array::concat element type mismatch\")\n          let result = match a_app {\n            CtArray(elem) => CtArray(elem),\n            _ => match b_app {\n              CtArray(elem) => CtArray(elem),\n              _ => CtUnknown\n            }\n          }\n          (tab_call_ty(tytab, call_off, result), s3, c2)\n        } else if name == \"Array::slice\" && Array::length(args) == 3 {\n          // `Array::slice(a, lo, hi)` returns an array of the SAME element type,\n          // typed CtUnknown by the builtin table (`let s: String =\n          // Array::get(Array::slice(ints, 0, 1), 0)` slipped through). Refine to\n          // `CtArray(elem)` from a concrete receiver.\n          let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let (_, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\n          let result = match subst_apply(s3, obj_ty) {\n            CtArray(elem) => CtArray(elem),\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, result), s3, c3)\n        } else if name == \"Array::fold\" && Array::length(args) == 3 {\n          // `Array::fold(a, init, f)` returns the accumulator type — i.e. `init`'s\n          // type — but was typed CtUnknown, so `let s: String = Array::fold(ints,\n          // 0, add)` slipped through. Refine the result to the init value's type.\n          // Also check the callback `(acc, x)` params: `acc` against `init`'s type\n          // and `x` against the array element type (`Array::fold([1,2], 0, (acc:\n          // String, x) -> ...)` slipped through). Ground-gated.\n          let (recv_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (init_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let (fn_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\n          let s4 = match subst_apply(s3, fn_ty) {\n            CtFn(ptys, _, _) => if Array::length(ptys) >= 1 {\n              check_assignable(subst_apply(s3, Array::get(ptys, 0)), subst_apply(s3, init_ty), s3, errors, \"Array::fold accumulator type mismatch\", 0 - 1)\n            } else {\n              s3\n            },\n            _ => s3\n          }\n          let s5 = check_hof_param_vs_elem(subst_apply(s4, recv_ty), subst_apply(s4, fn_ty), 1, s4, errors, \"Array::fold element parameter type mismatch\")\n          (tab_call_ty(tytab, call_off, subst_apply(s5, init_ty)), s5, c3)\n        } else if name == \"Array::map\" && Array::length(args) == 2 {\n          // `Array::map(a, f)` returns `Array[R]` where R is f's return type —\n          // typed CtUnknown by the builtin table, so the mapped element type was\n          // lost (`let s: String = Array::get(Array::map(ints, inc), 0)`). Refine\n          // the result element to the mapping function's concrete return type; a\n          // non-function / var f stays CtUnknown. Also check the callback's first\n          // parameter type against the array element type — `Array::map([1,2],\n          // (s: String) -> ...)` applied a `(String)->_` over `Array[Int]` and\n          // slipped through. Ground-gated, so an unannotated `(x) -> ...` param\n          // (CtVar) stays tolerant.\n          let (recv_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n          let (fn_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\n          let s3 = check_hof_param_vs_elem(subst_apply(s2, recv_ty), subst_apply(s2, fn_ty), 0, s2, errors, \"Array::map function parameter type mismatch\")\n          let result = match subst_apply(s3, fn_ty) {\n            CtFn(_, ret, _) => CtArray(ret),\n            _ => CtUnknown\n          }\n          (tab_call_ty(tytab, call_off, result), s3, c2)\n        } else if name == \"TaskGroup::run\" && Array::length(args) == 1 {\n          // #1081 step 3: `TaskGroup::run` mints a fresh generative region.\n          // There is no general rank-2/`Region`-bound mechanism in this\n          // checker (see docs/concurrency.md's dated 実装ノート) — this\n          // qualified name is special-cased exactly like `resume`/`perform`/\n          // `Some` above, matched by its LITERAL spelling. (Codex review, PR\n          // #1135, P1: an attempted fix that matched by the callee's\n          // structural shape instead — so a first-class alias like `let run\n          // = TaskGroup::run; run(...)` would also get this treatment — was\n          // tried and reverted: it false-matched unrelated single-argument\n          // calls elsewhere in the compiler's own source, regressing 20\n          // unit-test files with runtime traps. The alias/import-rename/\n          // higher-order-wrapper bypass this literal-name match cannot close\n          // is therefore a documented, accepted gap for this slice — see\n          // docs/concurrency.md's dated 実装ノート.) The scheme's `r` type\n          // parameter is instantiated to a fresh RIGID skolem (a `CtNamed`\n          // name no parsed source can ever spell — the lexer rejects `#` in\n          // identifiers) instead of an ordinary unifiable `CtVar`, so nothing\n          // outside this call can be coerced into it by accident; only a\n          // real escape reaches it, which the two checks below catch by\n          // scanning fully-zonked types for the skolem's name.\n          match env_lookup(env, \"TaskGroup::run\") {\n            Some(scheme) => {\n              let (ti, c1, new_bounds) = instantiate(scheme, c)\n              let mut s0 = s\n              let mut bi = 0\n              while bi < Array::length(new_bounds) {\n                let (vid, bounds) = Array::get(new_bounds, bi)\n                if Array::length(bounds) != 0 {\n                  s0 = subst_add_bound(s0, vid, bounds)\n                } else {\n                  ()\n                }\n                bi = bi + 1\n              }\n              match ti {\n                CtFn(run_params, run_ret, _) => match Array::get(run_params, 0) {\n                  CtFn(body_params, body_ret, body_eff) => match Array::get(body_params, 0) {\n                    CtNamed(tg_name, tg_args) => if tg_name == \"TaskGroup\" && Array::length(tg_args) == 2 {\n                      match Array::get(tg_args, 0) {\n                        CtVar(rv_id) => {\n                          let skolem_name = String::concat(\"#region_\", __to_string(c1))\n                          let s_skolem = SubstBind(rv_id, CtNamed(skolem_name, [\n                          ]), s0)\n                          let (bt, s_body, c_body) = check_expr(Array::get(args, 0), env, defs, s_skolem, c1 + 1, errors, tytab)\n                          match unify(CtFn(body_params, body_ret, body_eff), bt, s_body) {\n                            Some(s_unified) => {\n                              let zonked_ret = subst_apply(s_unified, body_ret)\n                              if type_mentions_named(zonked_ret, skolem_name) {\n                                Array::push(errors, String::concat(\"region escapes its nursery scope: the value returned from this TaskGroup::run body still depends on its own Nursery/Task/Sender/Receiver token\", off_marker_len(callee_off, String::length(name))))\n                              } else {\n                                ()\n                              }\n                              let outer_bindings = array_empty()\n                              collect_env_bindings(env, outer_bindings)\n                              let mut oi = 0\n                              let mut leaked = false\n                              while oi < Array::length(outer_bindings) {\n                                let (_, oty) = Array::get(outer_bindings, oi)\n                                if !leaked && type_mentions_named(subst_apply(s_unified, oty), skolem_name) {\n                                  leaked = true\n                                } else {\n                                  ()\n                                }\n                                oi = oi + 1\n                              }\n                              if leaked {\n                                Array::push(errors, String::concat(\"region escapes its nursery scope: an outer binding now depends on this TaskGroup::run call's own Nursery/Task/Sender/Receiver token\", off_marker_len(callee_off, String::length(name))))\n                              } else {\n                                ()\n                              }\n                              // #1081 step 3 Phase B: the `let mut` capture\n                              // check (Codex review, PR #1150/#1151) runs as\n                              // a SEPARATE whole-program pass\n                              // (check_spawnable_mut_captures_stmts, wired\n                              // into check_program/check_program_with_env in\n                              // checker_stmt.vibe), not per `TaskGroup::run`\n                              // call -- it needs to see `let mut` bindings\n                              // declared in the ENCLOSING scope, outside this\n                              // call's own body, which this call site alone\n                              // cannot observe.\n                              (tab_call_ty(tytab, call_off, subst_apply(s_unified, run_ret)), s_unified, c_body)\n                            },\n                            None => {\n                              Array::push(errors, String::concat(\"argument type mismatch for TaskGroup::run\", off_marker_len(callee_off, String::length(name))))\n                              (tab_call_ty(tytab, call_off, CtUnknown), s_body, c_body)\n                            }\n                          }\n                        },\n                        _ => (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)\n                      }\n                    } else {\n                      (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)\n                    },\n                    _ => (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)\n                  },\n                  _ => (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)\n                },\n                _ => (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)\n              }\n            },\n            // Reachable: the outer condition only matches the literal name\n            // `\"TaskGroup::run\"`, not that it actually resolves in `env`\n            // (e.g. the package isn't imported here at all).\n            None => {\n              Array::push(errors, String::concat(\"unknown name: \", name))\n              (tab_call_ty(tytab, call_off, CtUnknown), s, c)\n            }\n          }\n        } else if name == \"__region_run\" && Array::length(args) == 1 {\n          // ADR-0090 Phase 1: `region r { body }` -- parser-lowered to\n          // `__region_run((r) -> { body })` -- mints a fresh generative\n          // region, cloned from the TaskGroup::run branch above. Two\n          // differences: `__region_run` is a reserved internal ABI name that\n          // only the `region` syntax emits (a direct call spelled by hand\n          // gets the same semantics, so the TaskGroup::run alias-bypass hole\n          // does not exist here -- there is no scheme to alias), and there\n          // is no env scheme to instantiate: the argument is by construction\n          // a literal lambda, so its binder is bound DIRECTLY to the rigid\n          // skolem (a CtNamed name no parsed source can spell -- `#` is\n          // rejected in identifiers) before the body is checked. Binding\n          // before checking matters: region-tainted `let` bindings then\n          // carry the concrete skolem in their types, so this checker's\n          // let-generalization cannot quantify the taint away (the\n          // check-first-unify-later order would leave a free var at `let`\n          // time and reopen exactly the generalize hole the ADR-0068\n          // section documents). Known Phase 1 gap: the body is checked as a\n          // plain expression here, but the separate effect-row pass still\n          // sees the lambda wrapper, so effects performed inside a region\n          // body are not attributed to the enclosing fn by that pass.\n          let skolem_name = String::concat(\"#region_\", __to_string(c))\n          match Array::get(args, 0) {\n            EFn(_, _, fn_params, _, _, fn_body) => if Array::length(fn_params) == 1 {\n              let (binder_name, _) = Array::get(fn_params, 0)\n              let env_body = env_bind(env, binder_name, CtNamed(skolem_name, [\n              ]))\n              let (body_ty, s1, c1) = check_expr(fn_body, env_body, defs, s, c + 1, errors, tytab)\n              let zonked_ret = subst_apply(s1, body_ty)\n              if type_mentions_named(zonked_ret, skolem_name) {\n                Array::push(errors, String::concat(\"region escapes its scope: the value returned from this region body still depends on the region's own token\", off_marker_len(callee_off, String::length(name))))\n              } else {\n                ()\n              }\n              let outer_bindings = array_empty()\n              collect_env_bindings(env, outer_bindings)\n              let mut oi = 0\n              let mut leaked = false\n              while oi < Array::length(outer_bindings) {\n                let (_, oty) = Array::get(outer_bindings, oi)\n                if !leaked && type_mentions_named(subst_apply(s1, oty), skolem_name) {\n                  leaked = true\n                } else {\n                  ()\n                }\n                oi = oi + 1\n              }\n              if leaked {\n                Array::push(errors, String::concat(\"region escapes its scope: an outer binding now depends on this region's own token\", off_marker_len(callee_off, String::length(name))))\n              } else {\n                ()\n              }\n              (tab_call_ty(tytab, call_off, zonked_ret), s1, c1)\n            } else {\n              (tab_call_ty(tytab, call_off, CtUnknown), s, c + 1)\n            },\n            // A hand-written `__region_run(f)` with a non-literal callee:\n            // check it as an ordinary 1-arg closure call and pin its\n            // parameter to the skolem afterwards. Direct return-position\n            // escapes are still caught through the final zonk; taint that\n            // detoured through a generalized `let` inside `f` is not (the\n            // documented generalize gap -- only the literal-lambda form the\n            // parser emits gets the stronger bind-first treatment above).\n            _ => {\n              let (bt, s_body, c_body) = check_expr(Array::get(args, 0), env, defs, s, c + 1, errors, tytab)\n              match subst_apply(s_body, bt) {\n                CtFn(body_params, body_ret, _) => if Array::length(body_params) == 1 {\n                  match unify(Array::get(body_params, 0), CtNamed(skolem_name, [\n                  ]), s_body) {\n                    Some(s_unified) => {\n                      let zonked_ret = subst_apply(s_unified, body_ret)\n                      if type_mentions_named(zonked_ret, skolem_name) {\n                        Array::push(errors, String::concat(\"region escapes its scope: the value returned from this region body still depends on the region's own token\", off_marker_len(callee_off, String::length(name))))\n                      } else {\n                        ()\n                      }\n                      (tab_call_ty(tytab, call_off, zonked_ret), s_unified, c_body)\n                    },\n                    None => {\n                      Array::push(errors, String::concat(\"region body parameter type mismatch for __region_run\", off_marker_len(callee_off, String::length(name))))\n                      (tab_call_ty(tytab, call_off, CtUnknown), s_body, c_body)\n                    }\n                  }\n                } else {\n                  (tab_call_ty(tytab, call_off, CtUnknown), s_body, c_body)\n                },\n                _ => (tab_call_ty(tytab, call_off, CtUnknown), s_body, c_body)\n              }\n            }\n          }\n        } else if (name == \"TaskGroup::spawn\" || name == \"TaskGroup::spawn_suspend\") && Array::length(args) == 2 {\n          // #1081 step 3 Phase B: `Spawnable[r]` capture check. Like\n          // `TaskGroup::run` above, there is no general `Spawnable`\n          // trait/bound in this checker -- these two qualified names are\n          // special-cased by literal spelling (same alias/rename bypass\n          // caveat as TaskGroup::run, documented in docs/concurrency.md).\n          // This branch does exactly the SAME instantiate + check-args +\n          // unify work the generic call-checking fallback below would (so\n          // ordinary type errors on `n`/`f` are unaffected), then additionally\n          // zonks `n`'s region argument and walks the closure literal's\n          // captured free variables against `check_spawnable_captures`.\n          match env_lookup(env, name) {\n            Some(scheme) => {\n              let (ti, c1, new_bounds) = instantiate(scheme, c)\n              let mut s0 = s\n              let mut bi = 0\n              while bi < Array::length(new_bounds) {\n                let (vid, bounds) = Array::get(new_bounds, bi)\n                if Array::length(bounds) != 0 {\n                  s0 = subst_add_bound(s0, vid, bounds)\n                } else {\n                  ()\n                }\n                bi = bi + 1\n              }\n              match ti {\n                CtFn(param_tys, ret_ty, _) => {\n                  let (a0_ty, s1, c2) = check_expr(Array::get(args, 0), env, defs, s0, c1, errors, tytab)\n                  let (a1_ty, s2, c3) = check_expr(Array::get(args, 1), env, defs, s1, c2, errors, tytab)\n                  let arg_tys = [\n                    a0_ty,\n                    a1_ty\n                  ]\n                  let s3 = unify_call_args(param_tys, arg_tys, s2, errors, name, callee_off)\n                  match subst_apply(s3, a0_ty) {\n                    CtNamed(tg_name, tg_args) => if tg_name == \"TaskGroup\" && Array::length(tg_args) == 2 {\n                      let violations = check_spawnable_captures(env, s3, defs, Array::get(args, 1), Array::get(tg_args, 0))\n                      let mut vi = 0\n                      while vi < Array::length(violations) {\n                        Array::push(errors, String::concat(Array::get(violations, vi), off_marker_len(callee_off, String::length(name))))\n                        vi = vi + 1\n                      }\n                    } else {\n                      ()\n                    },\n                    _ => ()\n                  }\n                  (tab_call_ty(tytab, call_off, subst_apply(s3, ret_ty)), s3, c3)\n                },\n                _ => (tab_call_ty(tytab, call_off, CtUnknown), s0, c1)\n              }\n            },\n            None => {\n              Array::push(errors, String::concat(\"unknown name: \", name))\n              (tab_call_ty(tytab, call_off, CtUnknown), s, c)\n            }\n          }\n        } else {\n          match direct_call_return(env, name) {\n            Some(ret_ty) => {\n              let alen = Array::length(args)\n              let want_head = builtin_first_arg_head(name)\n              // Argument-count check (see `builtin_fixed_arity`). `Bytes::new`\n              // is special-cased: 0 args = empty growable buffer, 1 arg =\n              // length-n zero-filled (MoonBit semantics, linear backend synth).\n              if name == \"Bytes::new\" {\n                if alen > 1 {\n                  Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(name, String::concat(\": expected 0 or 1 args, got \", __to_string(alen)))), off_marker_len(callee_off, String::length(name))))\n                } else {\n                  ()\n                }\n              } else {\n                let want_arity = builtin_fixed_arity(name)\n                if want_arity >= 0 && alen != want_arity {\n                  Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(name, String::concat(\": expected \", String::concat(__to_string(want_arity), String::concat(\" args, got \", __to_string(alen)))))), off_marker_len(callee_off, String::length(name))))\n                } else {\n                  ()\n                }\n              }\n              let mut ai = 0\n              let mut s2 = s\n              let mut c2 = c\n              while ai < alen {\n                let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n                // First-argument head check for container/string builtins: the\n                // receiver's top-level constructor must match (`Array::length(5)`\n                // passes an Int where an Array is required). A non-concrete head\n                // (var / generic / unknown) is tolerated.\n                if ai == 0 && want_head != 0 {\n                  let got_head = head_kind(subst_apply(s2, at))\n                  if got_head != 0 && got_head != want_head {\n                    Array::push(errors, String::concat(String::concat(\"argument type mismatch for \", String::concat(name, \": receiver type \")), String::concat(type_to_string(subst_apply(s2, at)), off_marker_len(callee_off, String::length(name)))))\n                  } else if want_head == 9 && is_stream_named_type(subst_apply(s2, at)) {\n                    // #827: Stream is CtNamed (head 0 = tolerated), so the eager\n                    // Array-backed representation leaked through every Array\n                    // builtin (`Array::length(stream)` compiled and ran).\n                    Array::push(errors, String::concat(String::concat(\"argument type mismatch for \", String::concat(name, \": receiver type \")), String::concat(type_to_string(subst_apply(s2, at)), String::concat(\" is a Stream, not an Array (use `for await` / Stream::*)\", off_marker_len(callee_off, String::length(name))))))\n                  } else {\n                    ()\n                  }\n                } else if ai >= 1 {\n                  // Non-receiver argument head check for fixed-signature builtins\n                  // (`String::concat(\"a\", 1)`, `String::substring(s, \"x\", 2)`).\n                  let want_rest = builtin_arg_head_rest(name, ai)\n                  if want_rest != 0 {\n                    let got_head = head_kind(subst_apply(s2, at))\n                    if got_head != 0 && got_head != want_rest {\n                      Array::push(errors, String::concat(String::concat(\"argument type mismatch for \", String::concat(name, String::concat(\" (arg \", String::concat(__to_string(ai), \"): \")))), String::concat(type_to_string(subst_apply(s2, at)), off_marker_len(callee_off, String::length(name)))))\n                    } else {\n                      ()\n                    }\n                  } else {\n                    ()\n                  }\n                } else {\n                  ()\n                }\n                s2 = ns\n                c2 = nc\n                ai = ai + 1\n              }\n              (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)\n            },\n            None => {\n              // #736 residual: method-style call with a bare UNRESOLVED callee —\n              // `xs |> length` is `length(xs)`, and with only the receiver TYPE\n              // imported there is no lexical `length`. Retry as\n              // `<type-of-arg0>::length`, the same resolution as `xs.length()`\n              // (the EDot arm below), by re-checking in EDot form. Gated on the\n              // bare name resolving to nothing (env/builtin) AND the qualified\n              // name actually resolving, so a genuinely unknown callee still\n              // reports `unknown name` from the normal path below.\n              let method_form = if String::index_of(name, \"::\") < 0 && Array::length(args) >= 1 {\n                match env_lookup(env, name) {\n                  Some(_) => false,\n                  None => match lookup_builtin(name) {\n                    Some(_) => false,\n                    None => true\n                  }\n                }\n              } else {\n                false\n              }\n              let recv_method = if method_form {\n                let (a0_ty, sa, ca) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n                let recv_ty = subst_apply(sa, a0_ty)\n                let qual = String::concat(type_name_prefix(recv_ty), String::concat(\"::\", name))\n                let has_qual = match env_lookup(env, qual) {\n                  Some(_) => true,\n                  None => match lookup_builtin(qual) {\n                    Some(_) => true,\n                    None => false\n                  }\n                }\n                // A USER-typed receiver takes the (tolerant) EDot path even when\n                // the qualified method is not in THIS module's env: with only the\n                // type imported (`import ./list.vibe { List }`), `List::length`\n                // lives in the imported module and is resolved by the merged\n                // codegen — the per-module checker can't see it, exactly like\n                // `xs.length()` (EDot), which types such calls CtUnknown. A\n                // non-user receiver (Int/String/...) keeps the strict path so a\n                // typo'd `foo(42)` still reports `unknown name`.\n                let user_recv = match recv_ty {\n                  CtEnum(_) => true,\n                  CtStruct(_) => true,\n                  CtNamed(_, _) => true,\n                  _ => false\n                }\n                if has_qual || user_recv {\n                  Some(check_expr(ECall(EDot(Array::get(args, 0), name, callee_off, callee_off), Array::slice(args, 1, Array::length(args)), call_off), env, defs, sa, ca, errors, tytab))\n                } else {\n                  None\n                }\n              } else {\n                None\n              }\n              match recv_method {\n                Some(rm) => rm,\n                None => {\n                  let (ct, s1, c1) = check_expr(EIdent(name, -1), env, defs, s, c, errors, tytab)\n                  let alen = Array::length(args)\n                  let arg_tys = array_empty()\n                  let mut ai = 0\n                  let mut s2 = s1\n                  let mut c2 = c1\n                  while ai < alen {\n                    let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n                    Array::push(arg_tys, at)\n                    s2 = ns\n                    c2 = nc\n                    ai = ai + 1\n                  }\n                  let applied_callee_ty = match ct {\n                    CtFn(_, _, _) => ct,\n                    _ => subst_apply(s2, ct)\n                  }\n                  match applied_callee_ty {\n                    CtFn(param_tys, ret, _) => {\n                      let ret_box = Array::slice([\n                        ret\n                      ], 0, 1)\n                      let call_param_tys = param_tys\n                      let plen2 = Array::length(param_tys)\n                      let alen3 = Array::length(arg_tys)\n                      if alen3 != plen2 {\n                        Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(name, String::concat(\": expected \", String::concat(__to_string(plen2), String::concat(\" args, got \", __to_string(alen3)))))), off_marker_len(callee_off, String::length(name))))\n                      }\n                      let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, name, callee_off)\n                      let call_ret = Array::get(ret_box, 0)\n                      (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\n                    },\n                    CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\n                    other => {\n                      // Calling a value whose type is a concrete NON-callable scalar /\n                      // aggregate (e.g. `let x = 5; x(3)`) was previously accepted\n                      // silently. A type variable / unknown / named (generic) callee\n                      // is tolerated — it may yet resolve to a function.\n                      let not_callable = match other {\n                        CtInt => true,\n                        CtDouble => true,\n                        CtBool => true,\n                        CtString => true,\n                        CtChar => true,\n                        CtUnit => true,\n                        CtBytes => true,\n                        CtTuple(_) => true,\n                        CtArray(_) => true,\n                        // A constructed `Option`/enum value (`let o = Some(1); o(2)`)\n                        // is not callable — constructors themselves are typed `CtFn`,\n                        // so a `CtOption`/`CtEnum` callee is always a built value.\n                        CtOption(_) => true,\n                        CtEnum(_) => true,\n                        _ => false\n                      }\n                      if not_callable {\n                        Array::push(errors, String::concat(String::concat(\"calling a non-function value: \", name), off_marker_len(callee_off, String::length(name))))\n                      } else {\n                        ()\n                      }\n                      (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      },\n      // #897: `mod.x(args)` through a qualified-import namespace parses as\n      // ECall(EDot(EIdent(mod), x), args) -- a call whose callee is EDot goes\n      // through THIS UFCS/method-call arm, not the standalone EDot arm below,\n      // so the same qualified-namespace shortcut is needed here too (see the\n      // comment on the standalone `EDot` check_expr arm for the full\n      // rationale).\n      EDot(obj, method, _, qcall_field_off) => {\n        // #897/Codex P2: only take the qualified-import shortcut when `ns`\n        // is NOT independently bound -- a real local/param named the same\n        // as a qualified-import namespace must shadow it (normal field\n        // access on that local's own value), matching how import_alias_\n        // rewrite.vibe's alias map is pruned at every binder.\n        let qualified_key = match obj {\n          EIdent(ns, _) => match env_lookup(env, ns) {\n            Some(_) => None,\n            None => Some(String::concat(ns, String::concat(\".\", method)))\n          },\n          _ => None\n        }\n        let qualified_hit = match qualified_key {\n          Some(k) => env_lookup(env, k),\n          None => None\n        }\n        match qualified_hit {\n          Some(_) => match qualified_key {\n            Some(k) => check_expr(ECall(EIdent(k, qcall_field_off), args, call_off), env, defs, s, c, errors, tytab),\n            None => (CtUnknown, s, c)\n          },\n          None => {\n            let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)\n            let resolved = subst_apply(s1, obj_ty)\n            let type_prefix = type_name_prefix(resolved)\n            let qualified = String::concat(type_prefix, String::concat(\"::\", method))\n            let has_real_fn_binding = match env_lookup(env, qualified) {\n              Some(_) => true,\n              None => false\n            }\n            // #994: `desugar_trait_dict.vibe`'s dot-call lowering (the\n            // `EDot(obj, m, ...)` arm, `as_recv_method`) only rewrites a\n            // `.method(...)` call into a working `Type::method(...)` call when\n            // `fn_exists(fn_returns, qual)` -- i.e. `qual` is a REAL parsed\n            // top-level `fn` declaration. `env_lookup` reflects that exact same\n            // set of declarations. A `lookup_builtin` hit with NO `env_lookup`\n            // hit is a checker-only hardcoded signature (`Array::set`,\n            // `String::length`, ...) that has no corresponding parsed fn --\n            // codegen's EDot fallback then compiles the call as a struct-field\n            // READ and dies with an unlocated \"unknown struct field: <method>\"\n            // regardless of argument types (confirmed by probing EVERY builtin\n            // dot-call, well-typed or not: `a.set(0, 42)` fails identically to\n            // `a.set(0, \"bad\")`). Reject these HERE instead of silently\n            // accepting a call that can never compile.\n            if !has_real_fn_binding && is_known_builtin_receiver_prefix(type_prefix) {\n              match lookup_builtin(qualified) {\n                Some(_) => {\n                  Array::push(errors, String::concat(\"dot-call syntax is not supported for the builtin method `\", String::concat(qualified, String::concat(\"` -- call it as `\", String::concat(qualified, String::concat(\"(...)`\", off_marker_len(qcall_field_off, String::length(method))))))))\n                  (tab_call_ty(tytab, call_off, CtUnknown), s1, c1)\n                },\n                None => {\n                  let bare_hint = match env_lookup(env, method) {\n                    Some(_) => String::concat(String::concat(\"(...)` (a bare `fn \", method), String::concat(\"` is only callable as `\", String::concat(method, String::concat(\"(x)` or `x |> \", String::concat(method, \"`)\"))))),\n                    None => \"(...)`\"\n                  }\n                  Array::push(errors, String::concat(String::concat(\"no method `\", String::concat(method, String::concat(\"` on `\", String::concat(type_prefix, \"`: declare a top-level `fn \")))), String::concat(qualified, String::concat(bare_hint, off_marker_len(qcall_field_off, String::length(method))))))\n                  (tab_call_ty(tytab, call_off, CtUnknown), s1, c1)\n                }\n              }\n            } else {\n              let direct_ret = direct_call_return(env, qualified)\n              let method_ty = match env_lookup(env, qualified) {\n                Some(t) => {\n                  let (ti, c2, _) = instantiate(t, c1)\n                  (ti, s1, c2)\n                },\n                None => match lookup_builtin(qualified) {\n                  Some(t) => (t, s1, c1),\n                  None => (CtUnknown, s1, c1)\n                }\n              }\n              let (mt, s2, c2) = method_ty\n              let all_args = prepend_expr(obj, args)\n              let alen = Array::length(all_args)\n              let arg_tys = array_empty()\n              Array::push(arg_tys, obj_ty)\n              let mut ai = 1\n              let mut s3 = s2\n              let mut c3 = c2\n              while ai < alen {\n                let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3, errors, tytab)\n                Array::push(arg_tys, at)\n                s3 = ns\n                c3 = nc\n                ai = ai + 1\n              }\n              let applied_method_ty = match mt {\n                CtFn(_, _, _) => mt,\n                _ => subst_apply(s3, mt)\n              }\n              match applied_method_ty {\n                CtFn(param_tys, ret, _) => {\n                  let ret_box = Array::slice([\n                    ret\n                  ], 0, 1)\n                  let call_param_tys = param_tys\n                  let plen = Array::length(param_tys)\n                  let alen2 = Array::length(arg_tys)\n                  if alen2 != plen {\n                    Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(qualified, String::concat(\": expected \", String::concat(__to_string(plen), String::concat(\" args, got \", __to_string(alen2)))))), off_marker_len(call_off, String::length(qualified))))\n                  }\n                  let s4 = unify_call_args(call_param_tys, arg_tys, s3, errors, qualified, call_off)\n                  let call_ret = Array::get(ret_box, 0)\n                  let selected_ret = match direct_ret {\n                    Some(t) => t,\n                    None => call_ret\n                  }\n                  (tab_call_ty(tytab, call_off, subst_apply(s4, selected_ret)), s4, c3)\n                },\n                _ => {\n                  // No method/builtin `T::method` resolved. If the receiver is a\n                  // concrete struct whose field `method` holds a FUNCTION, this is a\n                  // field-stored-function call `b.f(args)` (the receiver is NOT an\n                  // argument). Arg-check the explicit args against the field's\n                  // parameter types and use its return type — `(b.f)(\"s\")` with `f:\n                  // (Int) -> Int` was otherwise unchecked. Ground-gated via\n                  // unify_call_args; generic-struct receivers stay CtUnknown so no\n                  // over-rejection.\n                  // #829: also resolve the field through an INSTANTIATED generic\n                  // struct receiver (`CtNamed(S, targs)`), so `it.pull(x)` on\n                  // `LazyIter[Int]` checks against the concrete field signature.\n                  let field_fn = receiver_struct_field_type(defs, subst_apply(s3, obj_ty), method)\n                  match field_fn {\n                    Some(CtFn(fpts, fret, _)) => {\n                      let explicit = Array::slice(arg_tys, 1, Array::length(arg_tys))\n                      if Array::length(fpts) != Array::length(explicit) {\n                        Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(qualified, String::concat(\": expected \", String::concat(__to_string(Array::length(fpts)), String::concat(\" args, got \", __to_string(Array::length(explicit))))))), off_marker_len(call_off, String::length(qualified))))\n                      }\n                      let s4 = unify_call_args(fpts, explicit, s3, errors, qualified, call_off)\n                      (tab_call_ty(tytab, call_off, subst_apply(s4, fret)), s4, c3)\n                    },\n                    _ => match direct_ret {\n                      Some(t) => (tab_call_ty(tytab, call_off, t), s3, c3),\n                      None => {\n                        // #953: method-style call `x.m()` on a receiver whose checked\n                        // type is a USER type DECLARED IN THIS CHECK'S defs, with no\n                        // `T::m` binding anywhere (env covers the whole program on the\n                        // merged FS-compile path, and check_stmts hoists every\n                        // top-level SLet — including `fn T::m` declared later — so an\n                        // absent binding means the method truly does not exist), no\n                        // builtin, and no struct field `m`. Codegen compiles a called\n                        // EDot as a struct-field read, so this previously escaped the\n                        // checker and died in codegen with an unlocated \"unknown\n                        // struct field: m\". Report it HERE, located at the method\n                        // token, with the #736 contract spelled out: dot-calls\n                        // resolve `T::m` top-level fns (a BARE `fn m(x: T)` is only\n                        // callable as `m(x)` / `x |> m`). Receivers of IMPORTED types\n                        // (no local typedef) keep the tolerant CtUnknown path — with\n                        // only the type imported, the method lives in the source\n                        // module and is resolved by the merged codegen (see the #736\n                        // comment on the bare-callee arm above).\n                        let no_field = match field_fn {\n                          None => true,\n                          _ => false\n                        }\n                        let local_user_ty = if type_prefix == \"\" {\n                          false\n                        } else {\n                          match find_typedef(defs, type_prefix) {\n                            Some(_) => true,\n                            None => false\n                          }\n                        }\n                        let has_method_binding = match env_lookup(env, qualified) {\n                          Some(_) => true,\n                          None => match lookup_builtin(qualified) {\n                            Some(_) => true,\n                            None => false\n                          }\n                        }\n                        // #994: known builtin receiver prefixes (String/Array/...)\n                        // never reach this branch anymore -- they're intercepted\n                        // earlier (before `direct_ret`/`method_ty` are computed) so\n                        // codegen-unlowerable builtin dot-calls get a located error\n                        // instead of silently unifying against a tolerant\n                        // `CtUnknown` builtin signature. This diagnostic now only\n                        // covers genuinely LOCAL user types.\n                        if no_field && local_user_ty && !has_method_binding {\n                          let bare_hint = match env_lookup(env, method) {\n                            Some(_) => String::concat(String::concat(\"(...)` (a bare `fn \", method), String::concat(\"` is only callable as `\", String::concat(method, String::concat(\"(x)` or `x |> \", String::concat(method, \"`)\"))))),\n                            // Codex P2 on #961: with no bare binding of this name,\n                            // suggesting `x |> method` re-enters the same fallback\n                            // and reproduces this diagnostic — only suggest the\n                            // Type::method declaration.\n                            None => \"(...)`\"\n                          }\n                          Array::push(errors, String::concat(String::concat(\"no method `\", String::concat(method, String::concat(\"` on `\", String::concat(type_prefix, \"`: declare a top-level `fn \")))), String::concat(qualified, String::concat(bare_hint, off_marker_len(qcall_field_off, String::length(method))))))\n                        } else {\n                          ()\n                        }\n                        (tab_call_ty(tytab, call_off, CtUnknown), s3, c3)\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      },\n      _ => {\n        // #844: intercept the synthetic ascription-lambda call shape\n        // `((__asc: T) -> __asc)(val)` that a LOCAL `let x: T = val` desugars\n        // to (parser_expr_dispatch.vibe's ascribe_wrap) BEFORE the general\n        // callee-dispatch logic below, so its annotation-vs-value check can\n        // additionally run `detect_narrowed_generic_mismatch` (closing the\n        // #844 same-name generic-struct re-narrowing hole) and\n        // `preserve_generic_instantiation` (so the bound local variable keeps\n        // its real instantiated type instead of an erased bare one) without\n        // touching `unify_call_args` / `check_assignable`, which every OTHER\n        // call in the language also goes through.\n        let asc_ann = if Array::length(args) == 1 {\n          ascription_lambda_ann(callee)\n        } else {\n          None\n        }\n        match asc_ann {\n          Some(ann_te) => {\n            let (at, ns0, nc0) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\n            let resolved = resolve_type_expr(ann_te, defs)\n            let actual = subst_apply(ns0, at)\n            // #981: `check_assignable` now runs the #844 same-name concrete\n            // `CtNamed` check itself (its tolerate branch calls\n            // `detect_narrowed_generic_mismatch`), so the explicit second\n            // call this site used to make would double-report — dropped.\n            let ns2 = check_assignable(resolved, actual, ns0, errors, \"binding type mismatch for a local let\", call_off)\n            let bound_ty = preserve_generic_instantiation(resolved, subst_apply(ns2, actual))\n            (tab_call_ty(tytab, call_off, bound_ty), ns2, nc0)\n          },\n          None => {\n            let callee_name0 = expr_ident_name_or_empty(callee)\n            if callee_name0 != \"\" {\n              match direct_call_return(env, callee_name0) {\n                Some(ret_ty) => {\n                  let alen = Array::length(args)\n                  let mut ai = 0\n                  let mut s2 = s\n                  let mut c2 = c\n                  while ai < alen {\n                    let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n                    s2 = ns\n                    c2 = nc\n                    ai = ai + 1\n                  }\n                  (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)\n                },\n                None => {\n                  let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)\n                  let alen = Array::length(args)\n                  let arg_tys = array_empty()\n                  let mut ai = 0\n                  let mut s2 = s1\n                  let mut c2 = c1\n                  while ai < alen {\n                    let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n                    Array::push(arg_tys, at)\n                    s2 = ns\n                    c2 = nc\n                    ai = ai + 1\n                  }\n                  let applied_callee_ty = match ct {\n                    CtFn(_, _, _) => ct,\n                    _ => subst_apply(s2, ct)\n                  }\n                  match applied_callee_ty {\n                    CtFn(param_tys, ret, _) => {\n                      let ret_box = Array::slice([\n                        ret\n                      ], 0, 1)\n                      let call_param_tys = param_tys\n                      let plen2 = Array::length(param_tys)\n                      let alen3 = Array::length(arg_tys)\n                      if alen3 != plen2 {\n                        Array::push(errors, String::concat(String::concat(\"function arity mismatch for \", String::concat(callee_name0, String::concat(\": expected \", String::concat(__to_string(plen2), String::concat(\" args, got \", __to_string(alen3)))))), off_marker_len(call_off, String::length(callee_name0))))\n                      }\n                      let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, callee_name0, call_off)\n                      let call_ret = Array::get(ret_box, 0)\n                      (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\n                    },\n                    CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\n                    _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\n                  }\n                }\n              }\n            } else {\n              let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)\n              let alen = Array::length(args)\n              let arg_tys = array_empty()\n              let mut ai = 0\n              let mut s2 = s1\n              let mut c2 = c1\n              while ai < alen {\n                let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\n                Array::push(arg_tys, at)\n                s2 = ns\n                c2 = nc\n                ai = ai + 1\n              }\n              let applied_callee_ty = match ct {\n                CtFn(_, _, _) => ct,\n                _ => subst_apply(s2, ct)\n              }\n              match applied_callee_ty {\n                CtFn(param_tys, ret, _) => {\n                  let ret_box = Array::slice([\n                    ret\n                  ], 0, 1)\n                  let call_param_tys = param_tys\n                  let plen2 = Array::length(param_tys)\n                  let alen3 = Array::length(arg_tys)\n                  if alen3 != plen2 {\n                    Array::push(errors, String::concat(String::concat(\"function arity mismatch for <expr>: expected \", String::concat(__to_string(plen2), String::concat(\" args, got \", __to_string(alen3)))), off_marker(call_off)))\n                  }\n                  let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, \"<expr>\", call_off)\n                  let call_ret = Array::get(ret_box, 0)\n                  (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\n                },\n                CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\n                _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\n              }\n            }\n          }\n        }\n      }\n    },\n    EBinOp(op, left, right) => {\n      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c, errors, tytab)\n      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1, errors, tytab)\n      let (result_ty, s3) = infer_binop_type(op, subst_apply(s2, left_ty), subst_apply(s2, right_ty), env, s2, errors, tytab)\n      (subst_apply(s3, result_ty), s3, c2)\n    },\n    EUnaryOp(op, operand) => {\n      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c, errors, tytab)\n      if op == \"!\" {\n        match subst_apply(s1, operand_ty) {\n          CtBool => (CtBool, s1, c1),\n          CtVar(_) => match unify(operand_ty, CtBool, s1) {\n            Some(s2) => (CtBool, s2, c1),\n            None => (CtUnknown, s1, c1)\n          },\n          other => {\n            // `!x` on a concrete non-Bool operand (`!5`) was accepted silently.\n            // A non-ground/Unknown operand is tolerated (may resolve to Bool).\n            let flag = match other {\n              CtUnknown => false,\n              _ => type_is_ground(other)\n            }\n            if flag {\n              Array::push(errors, \"operand of `!` must be Bool\")\n            } else {\n              ()\n            }\n            (CtUnknown, s1, c1)\n          }\n        }\n      } else if op == \"-\" {\n        match subst_apply(s1, operand_ty) {\n          CtDouble => (CtDouble, s1, c1),\n          CtInt => (CtInt, s1, c1),\n          CtVar(_) => match unify(operand_ty, CtInt, s1) {\n            Some(s2) => (CtInt, s2, c1),\n            None => (CtUnknown, s1, c1)\n          },\n          other => {\n            // Unary `-` on a concrete non-numeric operand (`-\"hi\"`) was accepted\n            // silently. A non-ground / Unknown operand is tolerated.\n            let flag = match other {\n              CtUnknown => false,\n              _ => type_is_ground(other)\n            }\n            if flag {\n              Array::push(errors, \"operand of unary `-` must be Int or Double\")\n            } else {\n              ()\n            }\n            (CtUnknown, s1, c1)\n          }\n        }\n      } else (CtUnknown, s1, c1)\n    },\n    EAssign(name, val, body) => {\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)\n      // The assigned value must be assignable to the variable's type\n      // (previously unchecked — `y = \"s\"` for `let mut y = 1` was accepted).\n      let s1b = match env_lookup(env, name) {\n        Some(var_ty) => check_assignable(var_ty, subst_apply(s1, vt), s1, errors, String::concat(\"assignment type mismatch for \", name), 0 - 1),\n        None => s1\n      }\n      check_expr(body, env, defs, s1b, c1, errors, tytab)\n    },\n    EAssignOp(_, _, val, body) => {\n      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)\n      check_expr(body, env, defs, s1, c1, errors, tytab)\n    },\n    EMatch(scrutinee, arms) => {\n      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c, errors, tytab)\n      let alen = Array::length(arms)\n      if alen == 0 {\n        // #809: a match with ZERO arms is only produced by the guard desugar\n        // (#666) — `pat if g => body` chains end in `match __mg { }` when NO\n        // unguarded arm exists — or by a literal empty `match x { }`. Both\n        // reach codegen as an unconditional `unreachable`: every guard failing\n        // at runtime trapped with no source location. Reject at compile time.\n        Array::push(errors, \"non-exhaustive match: no unguarded arm covers the scrutinee (all guards may fail — add an unguarded arm or `_`)\")\n        (CtUnknown, s1, c1)\n      }\n      else {\n        // #940 Phase 2 baseline: the nested usefulness check below only runs\n        // when THIS match produced no other diagnostics (pattern shape / arm\n        // type / flat exhaustiveness errors all suppress it — an ill-typed\n        // matrix would only yield a garbage witness on top of the real error).\n        let exh_base = Array::length(errors)\n        let mut result_ty = CtUnknown\n        // Whether to cross-check arm types. Enabled only when the first arm's\n        // type resolves to a SIMPLE scalar (Int/Double/Bool/String/Char) — that\n        // covers the real bug (`match x { 0 => 1, _ => \"s\" }`) while skipping\n        // the per-arm `subst_apply` for matches whose arms yield large tuple /\n        // struct / function types (e.g. the compiler's own `(Type, Subst, Int)`\n        // returning matches), which would otherwise balloon the self-compile\n        // heap. CtUnknown/CtVar/aggregate first arms are left unchecked.\n        let mut check_arms = false\n        // #941: cross-check arms for Option⇔Result railway-head conflicts\n        // when the first arm's type is railway-headed. The full aggregate\n        // cross-check stays off (heap cost, see `check_arms` above), but this\n        // one conflict is both cheap (head-only) and always genuine — it is\n        // exactly the `let*` desugar's failure track (`Err(e)` / `None`)\n        // yielding the WRONG monad into a match whose other arms yield the\n        // function's annotated one (docs/cheatsheet.md #635).\n        let mut railway_arms = false\n        let mut si = s1\n        let mut ci = c1\n        let mut ai = 0\n        while ai < alen {\n          let (pat, body) = Array::get(arms, ai)\n          // #951: `A(v) | B(v) => v` (or any or-pattern binding a variable in\n          // either branch) passes `check_pattern` (which only walks the LEFT\n          // branch) but codegen has no per-branch binding-extraction path for\n          // or-patterns and crashes with an unlocated internal error. Reject\n          // it here instead, as a normal located diagnostic.\n          if pat_has_unsupported_or_binding(pat) {\n            // Anchor on the arm body when it has a usable offset; block /\n            // let / literal bodies have none (railway_expr_off => -1), so\n            // fall back to the match scrutinee — patterns carry no offsets,\n            // and an unlocated reject would defeat the point of this check.\n            let body_off = railway_expr_off(body)\n            let or_off = if body_off >= 0 {\n              body_off\n            } else {\n              railway_expr_off(scrutinee)\n            }\n            Array::push(errors, String::concat(\"or-pattern bindings are not supported yet: `A(v) | B(v)`-style patterns cannot bind variables in an or-branch (rewrite without a shared binding, e.g. separate arms with the same body, or bind after matching)\", off_marker(or_off)))\n          } else {\n            ()\n          }\n          let arm_env = check_pattern(pat, scr_ty, env, defs, errors)\n          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci, errors, tytab)\n          si = ns\n          ci = nc\n          if ai == 0 {\n            result_ty = arm_ty\n            let r0 = subst_apply(si, arm_ty)\n            check_arms = match r0 {\n              CtInt => true,\n              CtDouble => true,\n              CtBool => true,\n              CtString => true,\n              CtChar => true,\n              _ => false\n            }\n            railway_arms = railway_head(r0) != 0\n          } else {\n            if check_arms {\n              // Tolerate a `CtUnit` arm (statement-position match); rely on\n              // check_assignable's ground/ground gate otherwise. Also tolerate a\n              // DIVERGING arm whose body is an early `return` (#635): `val?`\n              // lowers to `match val { Some(v) => v, None => return None }` — the\n              // `return` arm yields no value to the match, so it must not force\n              // the match's result type (it would clash `T` vs `Option[T]`).\n              let r2 = subst_apply(si, arm_ty)\n              si = if arm_body_diverges(body) {\n                si\n              } else {\n                match r2 {\n                  CtUnit => si,\n                  _ => check_assignable(result_ty, r2, si, errors, \"match arms have incompatible types\", 0 - 1)\n                }\n              }\n            } else if railway_arms {\n              // #941: report ONLY the Option⇔Result head conflict; every\n              // other shape keeps the historical no-cross-check tolerance.\n              // Diverging (early-`return`) arms yield no value to the match\n              // and are checked at their own EReturn instead.\n              if arm_body_diverges(body) {\n                ()\n              } else {\n                let rr0 = subst_apply(si, result_ty)\n                let rr2 = subst_apply(si, arm_ty)\n                if railway_heads_conflict(rr0, rr2) {\n                  Array::push(errors, String::concat(\"match arms have incompatible types\", String::concat(\": expected \", String::concat(type_to_string(rr0), String::concat(\", got \", String::concat(type_to_string(rr2), off_marker(railway_expr_off(scrutinee))))))))\n                } else {\n                  ()\n                }\n              }\n            } else {\n              ()\n            }\n          }\n          ai = ai + 1\n        }\n        // Exhaustiveness: when the scrutinee is a concrete user enum, the arms\n        // must either include a catch-all (`_` / bind) or cover EVERY variant —\n        // otherwise an unhandled variant traps at runtime. Conservative: only a\n        // concrete enum whose definition is known is checked; anything else\n        // (builtin Option/bool, type vars, non-enum) is left alone.\n        let enum_name_opt = match subst_apply(si, scr_ty) {\n          CtEnum(en) => Some(en),\n          CtNamed(en, _) => Some(en),\n          _ => None\n        }\n        match enum_name_opt {\n          Some(en) => match find_typedef(defs, en) {\n            Some(TDEnum(_, _, variants)) => {\n              let mut has_catchall = false\n              let covered = array_empty()\n              let mut ax = 0\n              while ax < Array::length(arms) {\n                let (apat, _) = Array::get(arms, ax)\n                if pat_is_catchall(apat) {\n                  has_catchall = true\n                } else {\n                  ()\n                }\n                collect_ctor_names_into(apat, covered)\n                ax = ax + 1\n              }\n              if has_catchall {\n                ()\n              } else {\n                let mut vi = 0\n                while vi < Array::length(variants) {\n                  let (vname, _) = Array::get(variants, vi)\n                  let mut found = false\n                  let mut ci2 = 0\n                  while ci2 < Array::length(covered) {\n                    if Array::get(covered, ci2) == vname {\n                      found = true\n                    } else {\n                      ()\n                    }\n                    ci2 = ci2 + 1\n                  }\n                  if found {\n                    ()\n                  } else {\n                    Array::push(errors, String::concat(\"non-exhaustive match: variant `\", String::concat(vname, String::concat(\"` of enum \", String::concat(en, \" is not handled (add it or a `_` arm)\")))))\n                  }\n                  vi = vi + 1\n                }\n              }\n            },\n            _ => ()\n          },\n          None => ()\n        }\n        // #940 Phase 1: builtin `Option` and `Bool` scrutinees were not\n        // covered by the flat exhaustiveness check AT ALL (the comment above\n        // even said so) — `match o { Some(v) => v, Some-only arms }` or a\n        // Bool match missing `false` compiled clean and trapped at runtime\n        // (codegen's test chain ends in `unreachable`). Checked for\n        // MULTI-arm matches, plus (Codex P2 on #980) for ANY match whose\n        // scrutinee is the guard desugar's synthesized `__mg` temp: a failed\n        // guard falls through to `EMatch(__mg, rest)` (#666), and that\n        // residual can have a single arm (`match b { true if g => 1,\n        // false => 0 }` leaves `match __mg { false => 0 }` — `b == true &&\n        // !g` trapped). A single-arm match over anything else stays\n        // tolerated: it is syntactically indistinguishable from the\n        // partial-let desugar (`let Some(v) = o`, the cheatsheet's\n        // documented idiom), whose scrutinee is the user's own expression,\n        // never `__mg`. Nested-pattern completeness (tuples, ctor payloads,\n        // literals) is the Phase 2 usefulness algorithm — this closes only\n        // the flat gap.\n        let flat_guard_residual = match scrutinee {\n          EIdent(sn, _) => sn == \"__mg\",\n          _ => false\n        }\n        if alen >= 2 || flat_guard_residual {\n          match subst_apply(si, scr_ty) {\n            CtOption(_) => {\n              let mut opt_catchall = false\n              let opt_covered = array_empty()\n              let mut oax = 0\n              while oax < Array::length(arms) {\n                let (oapat, _) = Array::get(arms, oax)\n                if pat_is_catchall(oapat) {\n                  opt_catchall = true\n                } else {\n                  ()\n                }\n                collect_ctor_names_into(oapat, opt_covered)\n                oax = oax + 1\n              }\n              if opt_catchall {\n                ()\n              } else {\n                if !flat_names_contain(opt_covered, \"Some\") {\n                  Array::push(errors, \"non-exhaustive match: variant `Some` of Option is not handled (add it or a `_` arm)\")\n                } else {\n                  ()\n                }\n                if !flat_names_contain(opt_covered, \"None\") {\n                  Array::push(errors, \"non-exhaustive match: variant `None` of Option is not handled (add it or a `_` arm)\")\n                } else {\n                  ()\n                }\n              }\n            },\n            CtBool => {\n              let mut bool_catchall = false\n              let bool_covered = array_empty()\n              let mut bax = 0\n              while bax < Array::length(arms) {\n                let (bapat, _) = Array::get(arms, bax)\n                if pat_is_catchall(bapat) {\n                  bool_catchall = true\n                } else {\n                  ()\n                }\n                collect_bool_pats_into(bapat, bool_covered)\n                bax = bax + 1\n              }\n              if bool_catchall {\n                ()\n              } else {\n                if !flat_names_contain(bool_covered, \"true\") {\n                  Array::push(errors, \"non-exhaustive match: `true` is not handled for a Bool scrutinee (add it or a `_` arm)\")\n                } else {\n                  ()\n                }\n                if !flat_names_contain(bool_covered, \"false\") {\n                  Array::push(errors, \"non-exhaustive match: `false` is not handled for a Bool scrutinee (add it or a `_` arm)\")\n                } else {\n                  ()\n                }\n              }\n            },\n            _ => ()\n          }\n        } else {\n          ()\n        }\n        // #940 Phase 2: nested usefulness (Maranget). Same arity gate as the\n        // flat checks above; additionally skipped when this match already has\n        // any diagnostic (no duplicate/garbage reports on top of a flat\n        // non-exhaustiveness or an ill-typed pattern). The ground gate,\n        // catch-all fast path and budget cap live inside\n        // match_nonexhaustive_witness (checker_exhaustive.vibe).\n        if (alen >= 2 || flat_guard_residual) && Array::length(errors) == exh_base {\n          let exh_pats = array_empty()\n          let mut exh_i = 0\n          while exh_i < alen {\n            let (exh_p, _) = Array::get(arms, exh_i)\n            Array::push(exh_pats, exh_p)\n            exh_i = exh_i + 1\n          }\n          match match_nonexhaustive_witness(subst_apply(si, scr_ty), exh_pats, defs) {\n            Some(exh_wit) => Array::push(errors, String::concat(\"non-exhaustive match: pattern `\", String::concat(exh_wit, String::concat(\"` is not handled (add it or a `_` arm)\", off_marker(railway_expr_off(scrutinee)))))),\n            None => ()\n          }\n        } else {\n          ()\n        }\n        (result_ty, si, ci)\n      }\n    },\n    EHandle(body, harms) => {\n      let (hty, hs, hc) = check_expr(body, env, defs, s, c, errors, tytab)\n      // #813: validate handler arms against DECLARED effects (TDEffect).\n      // Previously arms were never checked at all: a typo'd op name silently\n      // handled a different op, payload binds carried garbage types, and\n      // `resume(\"oops\")` into an Int-returning op compiled. Scope is limited\n      // to declared effects — arms for builtin/imported effects (Error etc.)\n      // keep the pre-#813 behavior (unchecked) so the compiler's ~4k\n      // `with Error` arms are untouched.\n      let mut hs1 = hs\n      let mut hc1 = hc\n      // #954 (Codex P1): when the body's type is unknown (e.g. a bare\n      // `throw`), adopt the first ground arm value type as the handle\n      // result instead of staying CtUnknown — otherwise\n      // `let n: Int = handle { throw(\"x\") } with Error { Throw(_) => \"s\" }`\n      // sailed through and did Int arithmetic on a String.\n      let mut hres: Type = hty\n      let mut hai = 0\n      while hai < Array::length(harms) {\n        let (hpat, hbody) = Array::get(harms, hai)\n        match hpat {\n          PCtor(hqname, hbinds) => {\n            let hci = String::index_of(hqname, \"::\")\n            if hci > 0 && effect_is_declared(defs, String::substring(hqname, 0, hci)) {\n              match effect_op_sig(defs, hqname) {\n                Some(hsig) => {\n                  let (hparams, hret) = hsig\n                  let hplen = Array::length(hparams)\n                  let hblen = Array::length(hbinds)\n                  // The op's declared arity, plus optionally one trailing\n                  // continuation binder (`Op(v, k)` — the #627 k-convention).\n                  // #814: the k-convention only ever ran on the retired\n                  // MoonBit fixture runner; this build path compiles\n                  // the binder but codegen dies with an internal `undefined\n                  // variable (local): k`. Reject it HERE with a located\n                  // message until evidence-passing handlers (#817) land.\n                  if hblen == hplen + 1 {\n                    // #828: this shape is EITHER a payload-arity typo or an\n                    // intended k-convention continuation — say both, since a\n                    // plain extra binder was misdiagnosed as k-convention.\n                    Array::push(errors, String::concat(\"handler arm \", String::concat(hqname, String::concat(String::concat(\" expects \", String::concat(__to_string(hplen), \" payload binding(s), got \")), String::concat(__to_string(hblen), \" — either drop the extra binder, or if it was meant as a non-tail continuation (k-convention): that is not supported by the build path; use resume(v) (#814, evidence-passing handlers #817)\")))))\n                  } else if hblen != hplen {\n                    Array::push(errors, String::concat(\"handler arm \", String::concat(hqname, String::concat(\" expects \", String::concat(__to_string(hplen), \" payload binding(s)\")))))\n                  } else {\n                    ()\n                  }\n                  // Bind payload names to the op's param types and check the\n                  // arm body (the trailing k binder stays CtUnknown).\n                  let mut henv = env\n                  let mut hbi = 0\n                  let mut hbinds_shadow_resume = false\n                  while hbi < hblen {\n                    match Array::get(hbinds, hbi) {\n                      PBind(hbname) => {\n                        if hbname == \"resume\" {\n                          hbinds_shadow_resume = true\n                        } else {\n                          ()\n                        }\n                        henv = env_bind(henv, hbname, if hbi < hplen {\n                          Array::get(hparams, hbi)\n                        } else {\n                          CtUnknown\n                        })\n                      },\n                      _ => ()\n                    }\n                    hbi = hbi + 1\n                  }\n                  // ADR-0076 Phase 3a (#817): `resume` is a first-class\n                  // one-shot value inside a declared-effect handler arm —\n                  // bind it as (op return type) -> (handle result type) so\n                  // an arm can STORE it and call it later (the suspend\n                  // class, ADR-0068's Async::suspend). Only check_expr gets\n                  // this binding: check_resume_values below keeps the\n                  // pre-binding henv so its resume_shadowed detection and\n                  // direct-call argument checks are unchanged, and #942's\n                  // tail constraint on the DIRECT call form stays in force\n                  // (check_arm_resume_tail is a separate syntactic walk that\n                  // only looks at call sites — a bare value reference never\n                  // trips it). A payload binder literally named `resume`\n                  // keeps shadowing (no extra binding on top of it).\n                  let henv_arm = if hbinds_shadow_resume {\n                    henv\n                  } else {\n                    env_bind(henv, \"resume\", CtFn([\n                      hret\n                    ], subst_apply(hs1, hres), None))\n                  }\n                  let (harm_ty, hns, hnc) = check_expr(hbody, henv_arm, defs, hs1, hc1, errors, tytab)\n                  hs1 = hns\n                  hc1 = hnc\n                  // #938: a non-resuming arm's value IS the handle result, so\n                  // it must unify with the body's type. Resume-tailed arms\n                  // type as CtUnknown (builtin resume), which the ground gate\n                  // in check_assignable waves through, so only arms returning\n                  // a concrete mismatching value are rejected.\n                  let hres_now = subst_apply(hs1, hres)\n                  let harm_now = subst_apply(hs1, harm_ty)\n                  if hres_now is CtUnknown {\n                    hres = harm_now\n                  } else {\n                    hs1 = check_assignable(hres_now, harm_now, hs1, errors, \"handler arm value type mismatch with the handle body's type\", 0 - 1)\n                  }\n                  // resume(x): x must be assignable to the op's declared\n                  // return type (ground-gated). Throwaway walk — nested\n                  // handles are skipped (their resumes belong to inner arms).\n                  hs1 = check_resume_values(hbody, hret, henv, defs, hs1, hc1, errors, tytab)\n                },\n                None => Array::push(errors, String::concat(\"handler arm `\", String::concat(String::substring(hqname, hci + 2, String::length(hqname)), String::concat(\"` is not an operation of effect \", String::substring(hqname, 0, hci)))))\n              }\n            } else if hci > 0 && String::substring(hqname, 0, hci) == \"Error\" {\n              // #640 Stage 1: Error arms stay OUT of the #813 arm validation\n              // above (payload/arity/exhaustiveness unchanged), but a\n              // resume(...) inside one is rejected — Error is non-resumable\n              // (`throw` / `perform Error::Throw` unwind for good; the arm's\n              // value IS the handle result, so the resume never ran).\n              reject_resume_in_error_arm(hbody, errors)\n              // #938: an Error arm never resumes, so its value IS the handle\n              // result — type the body (Throw's payload binds as String) and\n              // unify with the handle body's type. Ground-gated, so arms\n              // whose value involves unknowns (throw/rethrow etc.) pass.\n              let mut eaenv = env\n              if Array::length(hbinds) == 1 {\n                match Array::get(hbinds, 0) {\n                  PBind(eabname) => {\n                    // The payload stays CtUnknown: `throw` accepts any value\n                    // (#786 — suberror payloads like `throw(AppError(\"x\"))`\n                    // are legal), so pinning String would newly reject valid\n                    // `Throw(e) => inspect(e)` handlers (Codex P1 on #954).\n                    eaenv = env_bind(eaenv, eabname, CtUnknown)\n                  },\n                  _ => ()\n                }\n              } else {\n                ()\n              }\n              let (earm_ty, eans, eanc) = check_expr(hbody, eaenv, defs, hs1, hc1, errors, tytab)\n              hs1 = eans\n              hc1 = eanc\n              let eres_now = subst_apply(hs1, hres)\n              let earm_now = subst_apply(hs1, earm_ty)\n              if eres_now is CtUnknown {\n                hres = earm_now\n              } else {\n                hs1 = check_assignable(eres_now, earm_now, hs1, errors, \"handler arm value type mismatch with the handle body's type\", 0 - 1)\n              }\n            } else {\n              ()\n            }\n          },\n          _ => ()\n        }\n        hai = hai + 1\n      }\n      // #828: op-arm exhaustiveness for DECLARED effects — a handler covering\n      // only some ops compiled and the unhandled perform trapped unreachable\n      // at runtime with no message. The checker knows the op set (it already\n      // rejects unknown arm names), so require every op to have an arm.\n      let hx_eff = array_empty()\n      let hx_ops = array_empty()\n      let mut hxi = 0\n      while hxi < Array::length(harms) {\n        let (hxpat, _) = Array::get(harms, hxi)\n        match hxpat {\n          PCtor(hxq, _) => {\n            let hxci = String::index_of(hxq, \"::\")\n            if hxci > 0 && effect_is_declared(defs, String::substring(hxq, 0, hxci)) {\n              Array::push(hx_eff, String::substring(hxq, 0, hxci))\n              Array::push(hx_ops, String::substring(hxq, hxci + 2, String::length(hxq)))\n            } else {\n              ()\n            }\n          },\n          _ => ()\n        }\n        hxi = hxi + 1\n      }\n      if Array::length(hx_eff) > 0 {\n        match find_typedef(defs, Array::get(hx_eff, 0)) {\n          Some(TDEffect(_, hx_decl_ops)) => {\n            let mut hoi = 0\n            while hoi < Array::length(hx_decl_ops) {\n              let (hx_op_name, _, _) = Array::get(hx_decl_ops, hoi)\n              let mut hx_found = false\n              let mut hoj = 0\n              while hoj < Array::length(hx_ops) {\n                if Array::get(hx_ops, hoj) == hx_op_name {\n                  hx_found = true\n                } else {\n                  ()\n                }\n                hoj = hoj + 1\n              }\n              if hx_found {\n                ()\n              } else {\n                Array::push(errors, String::concat(\"non-exhaustive handler: operation `\", String::concat(hx_op_name, String::concat(\"` of effect \", String::concat(Array::get(hx_eff, 0), \" has no arm — performing it would trap at runtime; add an arm for it\")))))\n              }\n              hoi = hoi + 1\n            }\n          },\n          _ => ()\n        }\n      } else {\n        ()\n      }\n      (hres, hs1, hc1)\n    },\n    EWhile(cond, body) => {\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)\n      let resolved_ct = subst_apply(s1, ct)\n      match resolved_ct {\n        CtBool => (),\n        CtUnknown => (),\n        CtVar(_) => (),\n        _ => Array::push(errors, \"while condition must be Bool\")\n      }\n      let (_, s2, c2) = check_expr(body, env_bind(env, \"__in_loop__\", CtUnit), defs, s1, c1, errors, tytab)\n      (CtUnit, s2, c2)\n    },\n    ELoop(params, body) => {\n      let mut env1 = env\n      let mut s1 = s\n      let mut c1 = c\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1, errors, tytab)\n        env1 = env_bind(env1, name, pt)\n        s1 = ns\n        c1 = nc\n        i = i + 1\n      }\n      let (_, s2, c2) = check_expr(body, env_bind(env1, \"__in_loop__\", CtUnit), defs, s1, c1, errors, tytab)\n      (CtUnit, s2, c2)\n    },\n    EForIn(name, index_name, iterable, body) => {\n      // `for await x in s` reaches the checker as `for x in __await_iter(s)`\n      // (the parser's marker; the dict-passing desugar strips it for codegen).\n      // The marker is not a real function, so check the inner iterable directly.\n      let real_iterable = match iterable {\n        ECall(callee, args, _) => match callee {\n          EIdent(nm, _) => if nm == \"__await_iter\" && Array::length(args) == 1 {\n            Array::get(args, 0)\n          } else iterable,\n          _ => iterable\n        },\n        _ => iterable\n      }\n      let (it, s1, c1) = check_expr(real_iterable, env, defs, s, c, errors, tytab)\n      // Element type bound by `for x in it`:\n      //   - `Array[T]`                       -> T\n      //   - a parameterized iterator type\n      //     `C[T, ..]` (`LazyIter[T]`, async `Stream[T]`, `for await`'s\n      //     desugared iterator, …) -> its FIRST type argument `T`. By the\n      //     iterator convention `next(Self) -> Option[(T, Self)]` the element is\n      //     the struct's first type parameter, so it is recoverable from the\n      //     iterable's type alone — which matters across modules, where the\n      //     `impl Iterator for C` lives in a dependency and is not in this file's\n      //     import env (the dict-passing desugar drives codegen off the merged\n      //     sources separately). Only `for` loops over a real iterable reach\n      //     codegen, so a non-iterator never lands here in a valid program.\n      //   - an iterator type with NO type argument (a bare struct value, or\n      //     `Stream` in the eager Array-backed model, docs/spec §M2c-3) -> a\n      //     fresh unification var, so the loop body's usage constrains the\n      //     element instead of `CtUnknown` silently accepting any element use and\n      //     dropping element-type safety.\n      let it_resolved = subst_apply(s1, it)\n      let (et, c1b) = match it_resolved {\n        CtArray(elem) => (elem, c1),\n        CtNamed(nm, args) => if Array::length(args) > 0 {\n          (Array::get(args, 0), c1)\n        } else if nm == \"Stream\" || type_name_has_iterator_impl(env, nm) {\n          fresh_var(c1)\n        } else (CtUnknown, c1),\n        CtStruct(nm) => if type_name_has_iterator_impl(env, nm) {\n          fresh_var(c1)\n        } else (CtUnknown, c1),\n        other => {\n          // `for x in 5` over a primitive scalar can never be an iterable and\n          // was accepted silently. Only flag the unambiguously non-iterable\n          // primitives — a struct/named type may have an Iterator impl in\n          // another module (see above), so those stay tolerated.\n          let flag = match other {\n            CtInt => true,\n            CtDouble => true,\n            CtBool => true,\n            CtUnit => true,\n            CtChar => true,\n            _ => false\n          }\n          if flag {\n            Array::push(errors, \"for loop requires an iterable (Array or iterator)\")\n          } else {\n            ()\n          }\n          (CtUnknown, c1)\n        }\n      }\n      let env2 = env_bind(env, name, et)\n      let env3 = match index_name {\n        Some(index_name) => env_bind(env2, index_name, CtInt),\n        None => env2\n      }\n      let (bt, s2, c2) = check_expr(body, env_bind(env3, \"__in_loop__\", CtUnit), defs, s1, c1b, errors, tytab)\n      (CtArray(bt), s2, c2)\n    },\n    // #897: `mod.x` against a qualified-import namespace (`import ... as mod\n    // only { x }`) is bound directly as \"mod.x\" in env (see\n    // qualify_import_items in lib/@vibe/parser/parser.vibe -- bare `mod` is\n    // deliberately never bound, so a real identifier can never collide with\n    // this key). Whole-program merge later rewrites `EDot(EIdent(mod), x)`\n    // straight to the merged/renamed `x` (import_alias_rewrite.vibe), but\n    // some lanes (incremental fs_compile) type-check per-file BEFORE that\n    // merge runs, so this same shortcut is needed here too: resolve through\n    // the qualified binding directly instead of ever checking `mod` alone.\n    EDot(obj, field, dot_off, field_off) => {\n      // #897/Codex P2: only take the qualified-import shortcut when `ns` is\n      // NOT independently bound -- see the matching comment on the ECall\n      // callee-is-EDot arm above for the full rationale.\n      let qualified_key = match obj {\n        EIdent(ns, _) => match env_lookup(env, ns) {\n          Some(_) => None,\n          None => Some(String::concat(ns, String::concat(\".\", field)))\n        },\n        _ => None\n      }\n      let qualified_hit = match qualified_key {\n        Some(k) => env_lookup(env, k),\n        None => None\n      }\n      match qualified_hit {\n        Some(_) => match qualified_key {\n          Some(k) => check_expr(EIdent(k, field_off), env, defs, s, c, errors, tytab),\n          None => (CtUnknown, s, c)\n        },\n        None => {\n          let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)\n          let resolved = subst_apply(s1, obj_ty)\n          let field_ty = match resolved {\n            CtStruct(sname) => match find_typedef(defs, sname) {\n              Some(td) => match td {\n                TDStruct(_, fields, _, _) => {\n                  let rec find_field: (Int) -> Option[Type] = (i) -> {\n                    if i >= Array::length(fields) {\n                      None\n                    } else {\n                      let (fname, ftype) = Array::get(fields, i)\n                      if fname == field {\n                        Some(ftype)\n                      } else find_field(i + 1)\n                    }\n                  }\n                  match find_field(0) {\n                    Some(ft) => ft,\n                    None => {\n                      Array::push(errors, String::concat(String::concat(\"unknown field '\", String::concat(field, String::concat(\"' on struct \", sname))), if field_off >= 0 {\n                        off_marker_len(field_off, String::length(field))\n                      } else {\n                        off_marker(dot_off)\n                      }))\n                      CtUnknown\n                    }\n                  }\n                },\n                _ => CtUnknown\n              },\n              None => CtUnknown\n            },\n            // #829: field read through an INSTANTIATED generic struct value —\n            // substitute the declared type params with the receiver's type args so\n            // `b.v` on `Box[Int]` is `Int` (previously the whole read was\n            // CtUnknown, letting `String::length(b.v)` compile to silent garbage).\n            // A CtNamed head that is not a known struct (Stream/i64/unresolved\n            // type params, cross-module names) stays tolerated as before.\n            CtNamed(gname, gargs) => match find_typedef(defs, gname) {\n              Some(td) => match td {\n                TDStruct(_, gfields, _, gtparams) => {\n                  let rec find_field_g: (Int) -> Option[Type] = (i) -> {\n                    if i >= Array::length(gfields) {\n                      None\n                    } else {\n                      let (fname, ftype) = Array::get(gfields, i)\n                      if fname == field {\n                        Some(ftype)\n                      } else find_field_g(i + 1)\n                    }\n                  }\n                  match find_field_g(0) {\n                    Some(ft) => inst_struct_field_ty(ft, gtparams, gargs),\n                    None => {\n                      Array::push(errors, String::concat(String::concat(\"unknown field '\", String::concat(field, String::concat(\"' on struct \", gname))), if field_off >= 0 {\n                        off_marker_len(field_off, String::length(field))\n                      } else {\n                        off_marker(dot_off)\n                      }))\n                      CtUnknown\n                    }\n                  }\n                },\n                _ => CtUnknown\n              },\n              None => CtUnknown\n            },\n            // `t.N` tuple projection: the index must be in range, else it reads an\n            // out-of-bounds slot (`(1, 2).5` was accepted). When `field` is a\n            // numeric index and the tuple arity is known, bounds-check it.\n            CtTuple(elems) => match parse_tuple_index(field) {\n              Some(idx) => if idx >= 0 && idx < Array::length(elems) {\n                Array::get(elems, idx)\n              } else {\n                Array::push(errors, String::concat(String::concat(\"tuple index \", String::concat(field, String::concat(\" out of range for a \", String::concat(__to_string(Array::length(elems)), \"-tuple\")))), if field_off >= 0 {\n                  off_marker_len(field_off, String::length(field))\n                } else {\n                  off_marker(dot_off)\n                }))\n                CtUnknown\n              },\n              None => CtUnknown\n            },\n            // Field access on a concrete NON-struct value (`o.x` where `o :\n            // Option[P]`, or a scalar / function) is a type error — only structs\n            // (and tuple `.N`) have fields. Type vars / unknown / named scrutinees\n            // are tolerated; CtString/CtBytes/CtArray are NOT flagged because `.m`\n            // on them parses as a method call elsewhere, not a value-position EDot.\n            other => {\n              let not_struct = match other {\n                CtInt => true,\n                CtDouble => true,\n                CtBool => true,\n                CtChar => true,\n                CtUnit => true,\n                CtOption(_) => true,\n                CtFn(_, _, _) => true,\n                _ => false\n              }\n              if not_struct {\n                Array::push(errors, String::concat(String::concat(\"field access `.\", String::concat(field, \"` on a non-struct value\")), if field_off >= 0 {\n                  off_marker_len(field_off, String::length(field))\n                } else {\n                  off_marker(dot_off)\n                }))\n              } else {\n                ()\n              }\n              CtUnknown\n            }\n          }\n          // Record this field-access node's (raw, pre-final-subst) projection type\n          // keyed by its real source offset, for typed-hover on `obj.field`.\n          // Synthetic accesses (dot_off < 0) are skipped. #645: the field token's\n          // own offset gets the same entry, so hovering the field NAME (not just\n          // the base) resolves the projection type.\n          if dot_off >= 0 {\n            Array::push(tytab, (dot_off, field_ty))\n          } else {\n            ()\n          }\n          if field_off >= 0 && field_off != dot_off {\n            Array::push(tytab, (field_off, field_ty))\n          } else {\n            ()\n          }\n          (field_ty, s1, c1)\n        }\n      }\n    },\n    EFn(tparams, tbounds, params, ret_ty, effect, body) => {\n      let tplen = Array::length(tparams)\n      let mut tp_env = env\n      let mut s0 = s\n      let mut c0 = c\n      let mut tpi = 0\n      while tpi < tplen {\n        let tpname = Array::get(tparams, tpi)\n        match fresh_var(c0) {\n          (tv, nc) => {\n            let vid = nc - 1\n            let tblen = Array::length(tbounds)\n            let mut bounds = array_empty()\n            let mut tbi = 0\n            let mut found_bounds = false\n            while tbi < tblen {\n              let (bname, blist) = Array::get(tbounds, tbi)\n              if !found_bounds && bname == tpname {\n                bounds = blist\n                found_bounds = true\n              }\n              tbi = tbi + 1\n            }\n            s0 = if Array::length(bounds) == 0 {\n              s0\n            } else subst_add_bound(s0, vid, bounds)\n            tp_env = env_bind(tp_env, tpname, tv)\n            c0 = nc\n          },\n          _ => ()\n        }\n        tpi = tpi + 1\n      }\n      let plen = Array::length(params)\n      let mut fn_env = tp_env\n      let mut s1 = s0\n      let mut c1 = c0\n      let param_types = array_empty()\n      let mut pi = 0\n      while pi < plen {\n        let (raw_name, ann) = Array::get(params, pi)\n        let nlen = String::length(raw_name)\n        let name = if nlen > 0 {\n          let lc = String::char_code_at(raw_name, nlen - 1)\n          if lc == '~' || lc == '?' {\n            raw_name[0: nlen - 1]\n          } else raw_name\n        } else raw_name\n        let (pt, ns, nc) = match ann {\n          Some(te) => {\n            let resolved = resolve_type_expr(te, defs)\n            let pt2 = resolve_tparams_in(resolved, fn_env)\n            (pt2, s1, c1)\n          },\n          None => {\n            let (tv, nc2) = fresh_var(c1)\n            (tv, s1, nc2)\n          }\n        }\n        fn_env = env_bind(fn_env, name, pt)\n        Array::push(param_types, pt)\n        s1 = ns\n        c1 = nc\n        pi = pi + 1\n      }\n      // Bind the function's annotated return type under a sentinel so an\n      // explicit `return e` inside the body can be checked against it (the body\n      // value is checked below, but `return` short-circuits and was otherwise\n      // unchecked — `() -> Int { return \"x\" }` was accepted). Nested functions\n      // rebind the sentinel, so `return` always targets the nearest enclosing\n      // function's type.\n      // #964 (Codex P2 on #941): an UNANNOTATED function must SHADOW the\n      // sentinel too (bind CtUnknown), not inherit the enclosing function's.\n      // `return` targets the nearest enclosing function, so a `return Ok(1)`\n      // inside an unannotated lambda nested in a `-> Option[Int]` fn belongs\n      // to the LAMBDA — checking it against the OUTER annotation wrongly\n      // rejected it once the #941 railway-conflict report landed. CtUnknown\n      // unifies with anything, so the EReturn check is inert for it.\n      let body_env = match ret_ty {\n        Some(rte) => env_bind(fn_env, \"__return__\", resolve_tparams_in(resolve_type_expr(rte, defs), fn_env)),\n        None => env_bind(fn_env, \"__return__\", CtUnknown)\n      }\n      let (bt, s2, c2) = check_expr(body, body_env, defs, s1, c1, errors, tytab)\n      let (final_ret, s3) = match ret_ty {\n        Some(te) => {\n          let resolved = resolve_type_expr(te, defs)\n          let resolved_ret = resolve_tparams_in(resolved, fn_env)\n          match unify(bt, resolved_ret, s2) {\n            Some(ns) => (subst_apply(ns, resolved_ret), ns),\n            None => {\n              Array::push(errors, String::concat(\"return type mismatch: expected \", String::concat(type_to_string(resolved_ret), String::concat(\", got \", type_to_string(bt)))))\n              (CtUnknown, s2)\n            }\n          }\n        },\n        None => (subst_apply(s2, bt), s2)\n      }\n      (CtFn(param_types, final_ret, effect), s3, c2)\n    },\n    EBreak(opt) => {\n      // `break` is only meaningful inside a loop. Loop bodies bind the\n      // `__in_loop__` sentinel; its absence means this `break` is outside any\n      // loop (`() -> { break }`). Threaded through env, so if/match/let/seq\n      // inside a loop still see it; a nested function does not introduce one, so\n      // a `break` there is (conservatively) left unchecked rather than flagged.\n      match env_lookup(env, \"__in_loop__\") {\n        Some(_) => (),\n        None => Array::push(errors, \"`break` outside a loop\")\n      }\n      match opt {\n        Some(e) => {\n          let (_, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)\n          (CtUnit, s1, c1)\n        },\n        None => (CtUnit, s, c)\n      }\n    },\n    EContinue(args) => {\n      match env_lookup(env, \"__in_loop__\") {\n        Some(_) => (),\n        None => Array::push(errors, \"`continue` outside a loop\")\n      }\n      let alen = Array::length(args)\n      let mut s1 = s\n      let mut c1 = c\n      let mut ai = 0\n      while ai < alen {\n        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)\n        s1 = ns\n        c1 = nc\n        ai = ai + 1\n      }\n      (CtUnit, s1, c1)\n    },\n    ERecord(rn, fields, targs) => {\n      let flen = Array::length(fields)\n      let mut s1 = s\n      let mut c1 = c\n      let field_tys = array_empty()\n      let mut fi = 0\n      while fi < flen {\n        let (fname, fval) = Array::get(fields, fi)\n        // A field may be given only once in a record literal (`P::{ x: 1, x: 2 }`\n        // silently kept the last). Report a duplicate by scanning the names\n        // already collected.\n        let mut dj = 0\n        let mut dup = false\n        while dj < Array::length(field_tys) {\n          let (pn, _) = Array::get(field_tys, dj)\n          if pn == fname {\n            dup = true\n          } else {\n            ()\n          }\n          dj = dj + 1\n        }\n        if dup {\n          Array::push(errors, String::concat(\"duplicate field `\", String::concat(fname, \"` in record literal\")))\n        } else {\n          ()\n        }\n        let (ft, ns, nc) = check_expr(fval, env, defs, s1, c1, errors, tytab)\n        Array::push(field_tys, (fname, ft))\n        s1 = ns\n        c1 = nc\n        fi = fi + 1\n      }\n      // #810: a NAMED struct literal `S::{ ... }` (rn carries the parsed\n      // struct name since the ERecord arity bump) is validated against S's\n      // declaration by NAME — the field-set heuristics below cannot tell a\n      // typo'd `Point::{ x, z }` from an intentional anonymous\n      // `record { x, z }`, so before this check a same-count wrong-name\n      // field silently landed in another field's slot. Anonymous literals\n      // (rn == \"\") keep the field-set path unchanged.\n      if rn != \"\" {\n        match find_typedef(defs, rn) {\n          Some(td) => match td {\n            TDStruct(_, dfields, _, s_tparams) => {\n              // Unknown literal fields (present in the literal, absent from\n              // the declaration).\n              let mut ui = 0\n              while ui < Array::length(field_tys) {\n                let (an, _) = Array::get(field_tys, ui)\n                let mut known = false\n                let mut uj = 0\n                while uj < Array::length(dfields) {\n                  let (dn, _) = Array::get(dfields, uj)\n                  if dn == an {\n                    known = true\n                  } else {\n                    ()\n                  }\n                  uj = uj + 1\n                }\n                if !known {\n                  Array::push(errors, String::concat(\"unknown field `\", String::concat(an, String::concat(\"` for struct \", rn))))\n                } else {\n                  ()\n                }\n                ui = ui + 1\n              }\n              // #829: instantiate a GENERIC struct's declared type params with\n              // fresh inference vars, so the field values determine the\n              // construction's concrete type arguments (`Box::{ v: 1 }` is\n              // `Box[Int]`, not CtUnknown → its field reads become checkable).\n              //\n              // #886: EXPLICIT type arguments (`Pair[Int]::{ .. }`) pin the\n              // instantiation instead: each declared param is substituted by\n              // the resolved explicit argument (no fresh var), so field values\n              // are checked against the pinned types (mismatches surface as\n              // `struct field type mismatch for <f>`) and the construction's\n              // type is exactly `CtNamed(rn, <explicit args>)` even when the\n              // field values alone could not determine a param (e.g. an\n              // empty-array field). An arity mismatch reports an error and\n              // falls back to #829's inference to avoid cascading errors.\n              let tplen = Array::length(s_tparams)\n              let ntargs = Array::length(targs)\n              if ntargs > 0 && ntargs != tplen {\n                Array::push(errors, \"struct \\{rn} expects \\{tplen} type argument(s), got \\{ntargs} in `\\{rn}[...]::{ ... }` (#886 explicit struct type arguments)\")\n              }\n              let use_explicit = ntargs > 0 && ntargs == tplen\n              let fresh_targs = array_empty()\n              let mut c2 = c1\n              let mut tpi = 0\n              while tpi < tplen {\n                if use_explicit {\n                  // Resolve through the generic environment (same as param /\n                  // return annotations, ~line 3252): an explicit argument\n                  // naming an ENCLOSING fn's type parameter (`fn make[T](x:\n                  // T) -> Box[T] { Box[T]::{ v: x } }`) must become the\n                  // env-bound CtVar, not a rigid CtNamed(\"T\") — otherwise the\n                  // construction's type loses its link to the quantified\n                  // param and `make(42).v` fails as `expected Int, got T`\n                  // (Codex review, PR #926).\n                  Array::push(fresh_targs, resolve_tparams_in(resolve_type_expr(Array::get(targs, tpi), defs), env))\n                } else {\n                  match fresh_var(c2) {\n                    (tv, nc) => {\n                      Array::push(fresh_targs, tv)\n                      c2 = nc\n                    },\n                    _ => ()\n                  }\n                }\n                tpi = tpi + 1\n              }\n              // Missing declared fields (absent from the literal).\n              let mut mi = 0\n              while mi < Array::length(dfields) {\n                let (dn, dty0) = Array::get(dfields, mi)\n                // Check field values against the INSTANTIATED declared type\n                // (rigid params substituted by the fresh vars above); a\n                // non-generic struct keeps the raw declared type as before.\n                let dty = if tplen > 0 {\n                  subst_type_params(dty0, s_tparams, fresh_targs)\n                } else {\n                  dty0\n                }\n                match lookup_actual_field_ty(field_tys, dn) {\n                  Some(aty) => {\n                    // Value type check (ground-gated like check_record_fields).\n                    s1 = check_assignable(dty, subst_apply(s1, aty), s1, errors, String::concat(\"struct field type mismatch for \", dn), 0 - 1)\n                  },\n                  None => Array::push(errors, String::concat(\"missing field `\", String::concat(dn, String::concat(\"` in construction of struct \", rn))))\n                }\n                mi = mi + 1\n              }\n              // Struct identity: a monomorphic struct keeps `CtStruct(rn)`;\n              // a GENERIC struct now gets its instantiated nominal type\n              // `CtNamed(rn, args)` (#829 — previously CtUnknown, which made\n              // every downstream use of the value unchecked). A non-ground\n              // struct WITHOUT declared params (unresolved field type names)\n              // keeps the old CtUnknown tolerance.\n              if struct_fields_ground(dfields) {\n                (CtStruct(rn), s1, c2)\n              } else if tplen > 0 {\n                let inst_targs = for ta in fresh_targs {\n                  subst_apply(s1, ta)\n                }\n                (CtNamed(rn, inst_targs), s1, c2)\n              } else {\n                (CtUnknown, s1, c2)\n              }\n            },\n            _ => {\n              Array::push(errors, String::concat(\"`\", String::concat(rn, \"` is not a struct (struct literal)\")))\n              (CtUnknown, s1, c1)\n            }\n          },\n          // Unknown name: fall back to the anonymous field-set path instead\n          // of erroring — the merge layer's private-struct rename and alias\n          // imports can leave rn referring to a pre-rename spelling that the\n          // merged defs no longer contain. The typo detection above still\n          // fires for the common case (the struct EXISTS and a field name is\n          // wrong).\n          None => {\n            let s2f = check_record_fields(defs, field_tys, s1, errors)\n            let rec_tyf = match resolve_record_struct_name(defs, field_tys) {\n              Some(sname) => CtStruct(sname),\n              None => CtUnknown\n            }\n            (rec_tyf, s2f, c1)\n          }\n        }\n      } else {\n        // Check the field values against the matching struct's declared types.\n        let s2 = check_record_fields(defs, field_tys, s1, errors)\n        // Recover the struct identity (when unambiguous) so downstream uses — in\n        // particular `mut`-field write checking — see a concrete `CtStruct`.\n        let rec_ty = match resolve_record_struct_name(defs, field_tys) {\n          Some(sname) => CtStruct(sname),\n          None => CtUnknown\n        }\n        (rec_ty, s2, c1)\n      }\n    },\n    ETuple(items) => {\n      let ilen = Array::length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let tys = array_empty()\n      let mut ti = 0\n      while ti < ilen {\n        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1, errors, tytab)\n        Array::push(tys, it)\n        s1 = ns\n        c1 = nc\n        ti = ti + 1\n      }\n      (CtTuple(tys), s1, c1)\n    },\n    EArray(items) => {\n      let ilen = Array::length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let mut elem_ty = CtUnknown\n      // Cross-check elements only when the first element is a simple scalar, or\n      // a one-level array of scalars (`[[1], [\"x\"]]` — `Array[Int]` vs\n      // `Array[String]`) — see EMatch: this catches the cheap, bounded cases\n      // while skipping the per-element `subst_apply` for arrays of large\n      // struct/tuple values that pressure the self-compile heap.\n      let mut check_elems = false\n      let mut ai = 0\n      while ai < ilen {\n        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1, errors, tytab)\n        s1 = ns\n        c1 = nc\n        if ai == 0 {\n          elem_ty = it\n          check_elems = match subst_apply(s1, it) {\n            CtInt => true,\n            CtDouble => true,\n            CtBool => true,\n            CtString => true,\n            CtChar => true,\n            CtArray(inner) => match inner {\n              CtInt => true,\n              CtDouble => true,\n              CtBool => true,\n              CtString => true,\n              CtChar => true,\n              _ => false\n            },\n            _ => false\n          }\n        } else {\n          if check_elems {\n            s1 = check_assignable(elem_ty, subst_apply(s1, it), s1, errors, \"array elements have incompatible types\", 0 - 1)\n          } else {\n            ()\n          }\n        }\n        ai = ai + 1\n      }\n      (CtArray(elem_ty), s1, c1)\n    },\n    EReturn(e) => {\n      let (et, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)\n      // Check the returned value against the enclosing function's annotated\n      // return type (bound as `__return__` by the EFn arm). Ground-gated via\n      // check_assignable, so a generic return type is not over-rejected.\n      match env_lookup(env, \"__return__\") {\n        Some(rt) => {\n          let rte = subst_apply(s1, rt)\n          let ate = subst_apply(s1, et)\n          // #941: an Option⇔Result railway-head conflict is a genuine\n          // mismatch, but check_assignable tolerates it (a `CtNamed` head is\n          // neither reportable nor a differing head_kind). Report it directly\n          // — this is exactly the `?`-desugar's early `return Err(e)` /\n          // `return None` escaping a function annotated with the OTHER monad\n          // (docs/cheatsheet.md #635: mixing is a type error).\n          if railway_heads_conflict(rte, ate) {\n            Array::push(errors, String::concat(\"return type mismatch\", String::concat(\": expected \", String::concat(type_to_string(rte), String::concat(\", got \", String::concat(type_to_string(ate), off_marker(railway_expr_off(e))))))))\n          } else {\n            let _ = check_assignable(rte, ate, s1, errors, \"return type mismatch\", 0 - 1)\n            ()\n          }\n        },\n        None => ()\n      }\n      // The expression value of `return e` is `e`'s type, not CtUnknown. A lambda\n      // whose body is a bare `return e` (`(n) -> { return n }`) otherwise inferred\n      // a CtUnknown return type, so when its type came from OUTER unification\n      // (`let g: (Int) -> String = (n) -> { return n }`) the return/result\n      // mismatch was hidden — the no-`return` form `(n) -> { n }` is rejected, so\n      // the `return` form must be too. Propagating `et` makes them identical.\n      (et, s1, c1)\n    },\n    EMap(mpairs) => {\n      // #938: map literals were entirely untyped (fell through to CtUnknown),\n      // so `map { \"a\": 1, \"b\": \"two\" }` compiled and the stray String read\n      // back as a garbage Int. Check each entry and require pairwise\n      // homogeneous keys/values, ground-gated exactly like array literals\n      // (only when the first key/value type is a simple ground type).\n      let mut ms1 = s\n      let mut mc1 = c\n      let mut mvty: Type = CtUnknown\n      let mut mchk_v = false\n      let mut mi = 0\n      while mi < Array::length(mpairs) {\n        let (_, mve) = Array::get(mpairs, mi)\n        let (mvt, mvs, mvc) = check_expr(mve, env, defs, ms1, mc1, errors, tytab)\n        ms1 = mvs\n        mc1 = mvc\n        if mi == 0 {\n          mvty = mvt\n          mchk_v = map_literal_ground(subst_apply(ms1, mvt))\n        } else {\n          if mchk_v {\n            ms1 = check_assignable(mvty, subst_apply(ms1, mvt), ms1, errors, \"map literal values have incompatible types\", 0 - 1)\n          } else {\n            ()\n          }\n        }\n        mi = mi + 1\n      }\n      // #983: surface the literal's value type as a REAL slot —\n      // `CtNamed(\"Map\", [CtString, v])`, the exact shape a `Map[String, V]`\n      // annotation resolves to (checker_resolve's TyApp fallback) — so\n      // `Map::set`/`Map::get` can check against it. An empty literal\n      // (`Map::new()`) gets a fresh var; a let-bound empty map GENERALIZES\n      // (#996 Codex P2: `Map::set` is a functional update, so aliases of the\n      // empty binding build independent maps — no value restriction; each\n      // use re-instantiates a fresh slot, bound by that use's own flow).\n      if Array::length(mpairs) == 0 {\n        let (mv0, mc2) = fresh_var(mc1)\n        (CtNamed(\"Map\", [\n          CtString,\n          mv0\n        ]), ms1, mc2)\n      } else {\n        (CtNamed(\"Map\", [\n          CtString,\n          subst_apply(ms1, mvty)\n        ]), ms1, mc1)\n      }\n    },\n    ELabeledArg(_, _, la_val) => {\n      // #986: desugar_labeled_args (run before checking — see check_program)\n      // RESOLVES labeled args whose callee's parameter names are known in this\n      // module: it reorders fully-labeled calls into declared order and strips\n      // the ELabeledArg wrappers, so those values reach the strict positional\n      // unification as plain args. An ELabeledArg that SURVIVES to this arm\n      // therefore has no label→position resolution available here — the\n      // callee is import-resolved (its param names live in another module,\n      // Codex P2-1 on #993), locally shadowed, a builtin with decorative flag\n      // labels (`sh_lines(\"ls\", a = true)`), or an erroneous local shape that\n      // check_labeled_arg_names_stmts reports by name. Check the value for\n      // nested diagnostics but type the arg CtUnknown, so an unresolvable\n      // label is never falsely rejected by position.\n      let (_, la_s, la_c) = check_expr(la_val, env, defs, s, c, errors, tytab)\n      (CtUnknown, la_s, la_c)\n    },\n    _ => (CtUnknown, s, c)\n  }\n}\n\nfn map_literal_ground(t: Type) -> Bool {\n  match t {\n    CtInt => true,\n    CtDouble => true,\n    CtBool => true,\n    CtString => true,\n    CtChar => true,\n    _ => false\n  }\n}\n")
}

let cli_adapter_source_56 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_stmt.vibe",
"//# Imports\n\nimport ./checker_trait.vibe {\n  register_builtin_traits, type_send_ok\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport ./checker_effects.vibe {\n  check_async_effects_stmts, check_mutability_stmts, check_perform_effects_stmts_env, effect_error_to_string\n}\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  Subst,\n  Type,\n  TypeDef,\n  TypeEnv,\n  TypeExpr,\n  collect_subst_bounds_pairs,\n  env_bind,\n  env_cache,\n  env_flat_bindings,\n  env_lookup_flat,\n  generalize,\n  resolve_builtin,\n  subst_apply,\n  trait_defined,\n  type_implements_trait,\n  type_to_string\n}\n\nimport ./checker.vibe {\n  check_assignable,\n  check_expr,\n  fn_return_env_name,\n  is_array_builder_ty,\n  is_region_tagged_ty,\n  pat_binds_resume,\n  preserve_generic_instantiation,\n  reject_resume_outside_handler\n}\n\nimport ./checker_spawnable.vibe {\n  check_spawnable_mut_captures_stmts\n}\n\nimport ./checker_resolve.vibe {\n  resolve_type_expr, subst_type_params\n}\n\nimport @vibe/compiler/codegen {\n  desugar_labeled_args, desugar_railway_binds, inject_prelude_result, inject_trait_method_generics\n}\n\n//# Functions\n\n/// ADR-0069 Phase 1: locate a top-level statement for the reject diagnostics\n/// below — first available source char-offset of the statement's value\n/// expression (same walk as codegen's first_offset; duplicated locally to keep\n/// checker → codegen imports out). -1 when no offset-carrying node exists; the\n/// `[@off=N]` marker convention (see checker.vibe off_marker) then simply\n/// stays off the message.\nfn top_stmt_expr_off(e: Expr) -> Int {\n  match e {\n    EIdent(_, off) => off,\n    ECall(callee, _, off) => if off >= 0 {\n      off\n    } else {\n      top_stmt_expr_off(callee)\n    },\n    EDot(base, _, off, _) => if off >= 0 {\n      off\n    } else {\n      top_stmt_expr_off(base)\n    },\n    EBinOp(_, lhs, _) => top_stmt_expr_off(lhs),\n    EUnaryOp(_, inner) => top_stmt_expr_off(inner),\n    ELet(_, val, _, _) => top_stmt_expr_off(val),\n    ELetRec(_, val, _) => top_stmt_expr_off(val),\n    ELetMut(_, val, _, _) => top_stmt_expr_off(val),\n    EAssign(_, val, _) => top_stmt_expr_off(val),\n    EAssignOp(_, _, val, _) => top_stmt_expr_off(val),\n    ESeq(first, _) => top_stmt_expr_off(first),\n    EIf(cond, _, _) => top_stmt_expr_off(cond),\n    EMatch(scrut, _) => top_stmt_expr_off(scrut),\n    EReturn(inner) => top_stmt_expr_off(inner),\n    _ => 0 - 1\n  }\n}\n\n// ADR-0071 step 2 (#755) resolver core: effectset member-expansion cycle\n// detection and qualified-name/operation collision detection, kept local to\n// this file (no new cross-file function -- see docs/effectset.md's\n// \"Bootstrap gotcha\" note on why introducing a brand new cross-file\n// function+its first caller in the same change once broke\n// generate_bundle.sh's flatten step). Full resolution (actually authorizing\n// `with { EffectsetName }`) is still step 3; this only powers the two\n// specific checks the ADR's Decision section calls out by name (cycle\n// rejection, operation/effectset member-namespace collision) so the\n// checker's current blanket \"not yet supported\" rejection at least\n// distinguishes a genuinely invalid definition from one that is merely\n// unresolved.\n\nfn es_index_of(names: Array[String], name: String) -> Int {\n  let mut i = 0\n  let mut found = -1\n  while i < Array::length(names) {\n    if Array::get(names, i) == name {\n      found = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn es_string_array_contains(arr: Array[String], v: String) -> Bool {\n  es_index_of(arr, v) >= 0\n}\n\n/// \"Effect::Name\" -> (Some(\"Effect\"), \"Name\"); unqualified -> (None, name).\nfn es_split_qualified(name: String) -> (Option[String], String) {\n  let idx = String::index_of(name, \"::\")\n  if idx > 0 {\n    (Some(String::substring(name, 0, idx)), String::substring(name, idx + 2, String::length(name)))\n  } else {\n    (None, name)\n  }\n}\n\nfn es_join_arrow(names: Array[String]) -> String {\n  let mut result = \"\"\n  let mut i = 0\n  while i < Array::length(names) {\n    if i == 0 {\n      result = Array::get(names, i)\n    } else {\n      result = String::concat(result, String::concat(\" -> \", Array::get(names, i)))\n    }\n    i = i + 1\n  }\n  result\n}\n\n/// DFS over effectset member references. `path` is the chain of effectset\n/// names visited in the CURRENT recursion (not a global visited set) so two\n/// independent effectsets sharing a common, acyclic member is fine -- only\n/// re-visiting a name already on the current path is a genuine cycle.\n/// Members that are not themselves a known effectset name (an ordinary\n/// effect name or a qualified operation) are leaves -- es_index_of returns\n/// -1 for them, ending that branch.\nfn es_detect_cycle(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String]) -> Option[String] {\n  if es_string_array_contains(path, name) {\n    Some(String::concat(\"effectset cycle: \", String::concat(es_join_arrow(path), String::concat(\" -> \", name))))\n  } else {\n    let idx = es_index_of(es_names, name)\n    if idx < 0 {\n      None\n    } else {\n      let members = Array::get(es_members_list, idx)\n      Array::push(path, name)\n      let mut mi = 0\n      let mut result = None\n      while mi < Array::length(members) {\n        match result {\n          None => {\n            result = es_detect_cycle(es_names, es_members_list, Array::get(members, mi), path)\n          },\n          Some(_) => ()\n        }\n        mi = mi + 1\n      }\n      Array::truncate(path, Array::length(path) - 1)\n      result\n    }\n  }\n}\n\n/// `Env::Read` collides with `Env` if `Env` separately declares an operation\n/// named `Read` -- the ADR's Decision section calls this out explicitly:\n/// operation and effectset names share the effect-row member namespace, so a\n/// reference to `Env::Read` would be ambiguous between the two.\nfn es_qualified_collision(ed_names: Array[String], ed_ops_list: Array[Array[String]], qualified_name: String) -> Bool {\n  let (eff_opt, member_name) = es_split_qualified(qualified_name)\n  match eff_opt {\n    Some(eff) => {\n      let idx = es_index_of(ed_names, eff)\n      if idx < 0 {\n        false\n      } else {\n        es_string_array_contains(Array::get(ed_ops_list, idx), member_name)\n      }\n    },\n    None => false\n  }\n}\n\n/// Collect every effectset (name -> raw member list) and effect (name ->\n/// operation names) declared at or after `from_idx` in `stmts`, in one pass.\n/// Shared by check_stmts' own pre-pass (order-independent cycle/collision\n/// checking) and collect_async_effect_errors' row-expansion pass below (step\n/// 3) so both walks agree on exactly the same tables.\nfn es_collect_tables(stmts: Array[Stmt], from_idx: Int) -> (Array[String], Array[Array[String]], Array[String], Array[Array[String]]) {\n  let es_names = array_empty()\n  let es_members_list = array_empty()\n  let ed_names = array_empty()\n  let ed_ops_list = array_empty()\n  let mut i = from_idx\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectSet(_, esname, esmembers) => {\n        Array::push(es_names, esname)\n        Array::push(es_members_list, esmembers)\n      },\n      SEffectDef(_, edname, _, edops) => {\n        let opnames = for op in edops {\n          let (opname, _, _) = op\n          opname\n        }\n        Array::push(ed_names, edname)\n        Array::push(ed_ops_list, opnames)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  (es_names, es_members_list, ed_names, ed_ops_list)\n}\n\n/// ADR-0071 step 3 (#755) row expansion: recursively expand `name` into leaf\n/// labels (ordinary effect/operation names -- not further-expandable\n/// effectset names) via es_names/es_members_list, appending each freshly\n/// seen leaf into `out` (deduped). `path` guards against cycles the SAME way\n/// es_detect_cycle does (a name already on the current recursion path is\n/// skipped, not re-expanded) so a cyclic definition -- already flagged as an\n/// error by es_detect_cycle elsewhere in the SAME check_stmts pass -- cannot\n/// hang this walk even though this function does not itself re-validate\n/// acyclicity.\nfn es_expand_into(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String], out: Array[String]) -> Unit {\n  if es_string_array_contains(path, name) {\n    ()\n  } else {\n    let idx = es_index_of(es_names, name)\n    if idx < 0 {\n      if es_string_array_contains(out, name) {\n        ()\n      } else {\n        Array::push(out, name)\n      }\n    } else {\n      Array::push(path, name)\n      let members = Array::get(es_members_list, idx)\n      let mut mi = 0\n      while mi < Array::length(members) {\n        es_expand_into(es_names, es_members_list, Array::get(members, mi), path, out)\n        mi = mi + 1\n      }\n      Array::truncate(path, Array::length(path) - 1)\n    }\n  }\n}\n\nfn es_expand_label(es_names: Array[String], es_members_list: Array[Array[String]], name: String) -> Array[String] {\n  let out = array_empty()\n  es_expand_into(es_names, es_members_list, name, array_empty(), out)\n  out\n}\n\nfn es_join_comma(names: Array[String]) -> String {\n  let mut result = \"\"\n  let mut i = 0\n  while i < Array::length(names) {\n    if i == 0 {\n      result = Array::get(names, i)\n    } else {\n      result = String::concat(result, String::concat(\", \", Array::get(names, i)))\n    }\n    i = i + 1\n  }\n  result\n}\n\n/// Expand every effectset-name token in a raw comma-joined effect row\n/// (TyFn/EFn's `Option[String]` field) into its flat leaf-label expansion,\n/// leaving ordinary effect/operation labels and row variables untouched\n/// (es_expand_label is a no-op passthrough for any name that isn't a known\n/// effectset). `with { AskAll, Fs }` where `effectset AskAll = { Ask }`\n/// becomes `\"Ask, Fs\"` -- from that point on, the EXISTING string-label-based\n/// containment machinery (decl_authorizes_effect et al., unmodified) sees\n/// only base labels, so `AskAll` now genuinely authorizes what it expands to\n/// instead of needing to be literally re-declared verbatim by every caller.\nfn es_expand_row_string(row: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> String {\n  if Array::length(es_names) == 0 {\n    row\n  } else {\n    let raw = String::split(row, \", \")\n    let out = array_empty()\n    let mut i = 0\n    while i < Array::length(raw) {\n      let expanded = es_expand_label(es_names, es_members_list, Array::get(raw, i))\n      let mut j = 0\n      while j < Array::length(expanded) {\n        let e = Array::get(expanded, j)\n        if es_string_array_contains(out, e) {\n          ()\n        } else {\n          Array::push(out, e)\n        }\n        j = j + 1\n      }\n      i = i + 1\n    }\n    es_join_comma(out)\n  }\n}\n\nfn es_expand_opt_row(eff: Option[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Option[String] {\n  match eff {\n    Some(row) => Some(es_expand_row_string(row, es_names, es_members_list)),\n    None => None\n  }\n}\n\nfn es_expand_texpr(te: TypeExpr, es_names: Array[String], es_members_list: Array[Array[String]]) -> TypeExpr {\n  match te {\n    TyFn(params, ret, eff) => TyFn(params, ret, es_expand_opt_row(eff, es_names, es_members_list)),\n    _ => te\n  }\n}\n\nfn es_expand_opt_texpr(ty: Option[TypeExpr], es_names: Array[String], es_members_list: Array[Array[String]]) -> Option[TypeExpr] {\n  match ty {\n    Some(te) => Some(es_expand_texpr(te, es_names, es_members_list)),\n    None => None\n  }\n}\n\n/// Also expands a PARAMETER's own function-typed annotation (the #885\n/// callback-overlay case, e.g. `run(f: () -> Int with { AskAll }) -> Int`) --\n/// es_expand_opt_texpr already handles any TypeExpr generically (it only\n/// touches TyFn's effect slot, passing every other shape through unchanged),\n/// so reusing it here for each param needs no new logic.\nfn es_expand_top_value(e: Expr, es_names: Array[String], es_members_list: Array[Array[String]]) -> Expr {\n  match e {\n    EFn(tps, tbs, params, ret, eff, body) => {\n      let expanded_params = for p in params {\n        let (pname, pty) = p\n        (pname, es_expand_opt_texpr(pty, es_names, es_members_list))\n      }\n      EFn(tps, tbs, expanded_params, ret, es_expand_opt_row(eff, es_names, es_members_list), body)\n    },\n    _ => e\n  }\n}\n\n/// Rewrite a top-level binding's OWN declared effect row(s) -- the `ty`\n/// annotation (`let f: () -> T with { Es } = ...`), the EFn value's own\n/// inline row (`let f = () -> T with { Es } { ... }`), and every\n/// PARAMETER's own function-typed row -- expanding any effectset-name token\n/// before check_perform_effects_stmts_env (unmodified) sees it. A parameter\n/// nested more than one level deep (a function-typed field inside a struct\n/// parameter, for instance) is not covered -- a further, smaller follow-up.\nfn es_expand_stmt_effect_rows(stmt: Stmt, es_names: Array[String], es_members_list: Array[Array[String]]) -> Stmt {\n  match stmt {\n    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, name, es_expand_opt_texpr(ty, es_names, es_members_list), es_expand_top_value(body, es_names, es_members_list)),\n    SLetMut(name, ty, body) => SLetMut(name, es_expand_opt_texpr(ty, es_names, es_members_list), es_expand_top_value(body, es_names, es_members_list)),\n    _ => stmt\n  }\n}\n\nfn es_expand_stmts_effect_rows(stmts: Array[Stmt], es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[Stmt] {\n  if Array::length(es_names) == 0 {\n    stmts\n  } else {\n    for s in stmts {\n      es_expand_stmt_effect_rows(s, es_names, es_members_list)\n    }\n  }\n}\n\n/// String::concat only (never `+` / interpolation — NUL-miscodegen hazard\n/// here, same rule as checker.vibe off_marker).\nfn top_level_reject_msg(what: String, e: Expr) -> String {\n  let base = String::concat(what, \" (ADR-0069)\")\n  let off = top_stmt_expr_off(e)\n  if off >= 0 {\n    String::concat(base, String::concat(\" [@off=\", String::concat(__to_string(off), \"]\")))\n  } else {\n    base\n  }\n}\n\nfn import_cache_lookup(cache: Array[(String, Type)], name: String, i: Int) -> Option[Type] {\n  if i >= Array::length(cache) {\n    None\n  }\n  else {\n    let (cached_name, cached_ty) = Array::get(cache, i)\n    if cached_name == name {\n      Some(cached_ty)\n    }\n    else import_cache_lookup(cache, name, i + 1)\n  }\n}\n\nfn bind_stmt_imports(env: TypeEnv, names: Array[(String, Option[String])]) -> TypeEnv {\n  let env_bindings = env_flat_bindings(env)\n  let import_cache = array_empty()\n  let nlen = Array::length(names)\n  let mut i = 0\n  let mut acc = env\n  while i < nlen {\n    let (name, alias) = Array::get(names, i)\n    let bound_name = match alias {\n      Some(a) => a,\n      None => name\n    }\n    let ty = match import_cache_lookup(import_cache, name, 0) {\n      Some(t) => t,\n      None => {\n        let resolved = match env_lookup_flat(env_bindings, name) {\n          Some(t) => t,\n          None => CtUnknown\n        }\n        Array::push(import_cache, (name, resolved))\n        resolved\n      }\n    }\n    let acc_with_name = env_bind(acc, bound_name, ty)\n    acc = match env_lookup_flat(env_bindings, fn_return_env_name(name)) {\n      Some(ret_ty) => env_bind(acc_with_name, fn_return_env_name(bound_name), ret_ty),\n      None => acc_with_name\n    }\n    i = i + 1\n  }\n  acc\n}\n\nfn annotation_return_type(ann: Option[TypeExpr], defs: Array[TypeDef]) -> Option[Type] {\n  match ann {\n    Some(te) => match te {\n      TyFn(params, ret, _) => {\n        let ret_box = Array::slice([\n          ret\n        ], 0, 1)\n        let _ = Array::length(params)\n        Some(resolve_type_expr(Array::get(ret_box, 0), defs))\n      },\n      _ => None\n    },\n    None => None\n  }\n}\n\nfn fn_expr_return_type(expr: Expr, defs: Array[TypeDef]) -> Option[Type] {\n  match expr {\n    EFn(_, _, _, ret_ty, _, _) => match ret_ty {\n      Some(te) => Some(resolve_type_expr(te, defs)),\n      None => None\n    },\n    _ => None\n  }\n}\n\nfn bind_fn_return(env: TypeEnv, name: String, ret_ty: Type) -> TypeEnv {\n  env_bind(env, fn_return_env_name(name), ret_ty)\n}\n\nfn bind_annotation_return(env: TypeEnv, name: String, ann: Option[TypeExpr], defs: Array[TypeDef]) -> TypeEnv {\n  match annotation_return_type(ann, defs) {\n    Some(ret_ty) => bind_fn_return(env, name, ret_ty),\n    None => env\n  }\n}\n\nfn bind_value_or_annotation_return(env: TypeEnv, name: String, val: Expr, ann: Option[TypeExpr], defs: Array[TypeDef]) -> TypeEnv {\n  match fn_expr_return_type(val, defs) {\n    Some(ret_ty) => bind_fn_return(env, name, ret_ty),\n    None => bind_annotation_return(env, name, ann, defs)\n  }\n}\n\nfn struct_derives_has(derives: Array[String], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(derives) {\n    if Array::get(derives, i) == name {\n      found = true\n      i = Array::length(derives)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// The derivable traits the structural `derive(...)` desugar understands. Any\n/// other name in a `derive(...)` clause is rejected with `unknown trait: <name>`\n/// (#638) so a typo / unsupported trait fails the compile instead of silently\n/// generating nothing.\nfn derive_name_is_known(name: String) -> Bool {\n  name == \"Eq\" || name == \"Ord\" || name == \"Show\" || name == \"Hash\" || name == \"Default\"\n}\n\n/// #1078: the name of a DIFFERENT enum (already registered in `defs`) that\n/// declares a variant named `vname`, or None. Used to reject bare-name\n/// constructor collisions at declaration time -- see the SEnum arm's\n/// comment for why last-registered-wins shadowing makes these silently\n/// wrong rather than merely ambiguous.\nfn find_other_enum_declaring_variant(defs: Array[TypeDef], enum_name: String, vname: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(defs) {\n    match Array::get(defs, i) {\n      TDEnum(other_name, _, other_variants) => if other_name != enum_name {\n        let mut vi = 0\n        while vi < Array::length(other_variants) {\n          let (ovn, _) = Array::get(other_variants, vi)\n          if ovn == vname {\n            found = Some(other_name)\n          } else {\n            ()\n          }\n          vi = vi + 1\n        }\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn validate_derives(derives: Array[String], errors: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(derives) {\n    let name = Array::get(derives, i)\n    if name != \"\" && !derive_name_is_known(name) {\n      Array::push(errors, String::concat(\"unknown trait: \", name))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n}\n\nfn stmt_is_type_decl(stmt: Stmt) -> Bool {\n  match stmt {\n    SEnum(_, _, _, _, _) => true,\n    SSuberror(_, _, _) => true,\n    SStruct(_, _, _, _, _, _) => true,\n    STypeAlias(_, _, _, _) => true,\n    _ => false\n  }\n}\n\n/// #613: process type declarations (enum / struct / type-alias / suberror) before\n/// value definitions so a `let` may construct or reference a type or constructor\n/// declared LATER in the same statement list (a forward reference). check_stmts\n/// records each type into `defs` and binds its constructors into `env` only when\n/// the declaration statement is reached, so without this a value defined before\n/// its enum saw neither the type nor its constructors and aborted the compile\n/// with an opaque trap (e.g. an imported module whose function constructs an enum\n/// value lands before the enum in the merged statement list). Codegen is already\n/// order-independent (the ctor table scans every statement up front), so this\n/// check-side reorder is sufficient. The partition is STABLE, so already-ordered\n/// (type-before-value) code is processed exactly as before, and relative order\n/// within each group is preserved.\nfn reorder_type_decls_first(stmts: Array[Stmt], start: Int) -> Array[Stmt] {\n  let out = Array::slice(stmts, 0, start)\n  let n = Array::length(stmts)\n  let mut i = start\n  while i < n {\n    let st = Array::get(stmts, i)\n    if stmt_is_type_decl(st) {\n      Array::push(out, st)\n    }\n    i = i + 1\n  }\n  let mut j = start\n  while j < n {\n    let st = Array::get(stmts, j)\n    if !stmt_is_type_decl(st) {\n      Array::push(out, st)\n    }\n    j = j + 1\n  }\n  out\n}\n\nexport fn check_stmts(raw_stmts: Array[Stmt], i: Int, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> (TypeEnv, Subst, Int) {\n  let stmts = reorder_type_decls_first(raw_stmts, i)\n  let mut idx = i\n  let mut cur_env = env\n  let mut cur_s = s\n  let mut cur_c = c\n  // #602: hoist top-level binding signatures so a `let` may reference another\n  // top-level `let` defined later in the same statement list (a forward\n  // reference). Without this, checking the earlier binding's body raised\n  // \"unknown name\" and aborted the whole compile with an opaque trap.\n  // check_stmts is only used for program / module statement lists — local\n  // `let`s are ELet expressions checked in check_expr — so this does not affect\n  // block scoping. An annotated binding hoists its declared type; an\n  // un-annotated one hoists as CtUnknown (its precise type is filled in when its\n  // own statement is reached, which shadows this pre-binding). Pre-binding only\n  // adds names, and a later real binding shadows it, so ordered\n  // (backward-reference) code is checked exactly as before.\n  let mut hoist_i = idx\n  while hoist_i < Array::length(stmts) {\n    match Array::get(stmts, hoist_i) {\n      SLet(_, _, hname, hann, _) => {\n        let ht = match hann {\n          Some(hte) => resolve_type_expr(hte, defs),\n          None => CtUnknown\n        }\n        cur_env = env_bind(cur_env, hname, ht)\n      },\n      _ => ()\n    }\n    hoist_i = hoist_i + 1\n  }\n  // ADR-0071 step 2 (#755): collect every effectset (name -> raw member\n  // list) and effect (name -> operation names) declared in THIS statement\n  // list up front, mirroring the hoist_i pre-pass above, so a later\n  // SEffectSet arm below can run es_detect_cycle/es_qualified_collision\n  // regardless of declaration order (an effectset may reference another one\n  // defined later in the same file, exactly like the SLet forward-reference\n  // case this hoist mirrors). Shared with collect_async_effect_errors below\n  // (step 3's row-expansion pass) via es_collect_tables so both walks stay\n  // in sync from one implementation.\n  let (es_names, es_members_list, ed_names, ed_ops_list) = es_collect_tables(stmts, idx)\n  // #942 (Codex P2 on #969): if any top-level declaration in this statement\n  // list binds the name `resume` (fn/let — fn decls are lowered to SLet\n  // before the checker — let-pattern, extern let, or an import), codegen's\n  // prefer_bound_call routes every `resume(x)` in the file to that BOUND\n  // function (a global name match, see codegen/expr/compile_call.vibe), so\n  // the #942 misuse walks must stand down for the whole list.\n  let mut resume_shadowed_top = false\n  let mut rst_i = idx\n  while rst_i < Array::length(stmts) {\n    match Array::get(stmts, rst_i) {\n      SLet(_, _, rstname, _, _) => if rstname == \"resume\" {\n        resume_shadowed_top = true\n      } else {\n        ()\n      },\n      SLetMut(rstname, _, _) => if rstname == \"resume\" {\n        resume_shadowed_top = true\n      } else {\n        ()\n      },\n      SExternLet(rstname, _) => if rstname == \"resume\" {\n        resume_shadowed_top = true\n      } else {\n        ()\n      },\n      SLetPat(rstpat, _) => if pat_binds_resume(rstpat) {\n        resume_shadowed_top = true\n      } else {\n        ()\n      },\n      SImport(_, rstnames) => {\n        let mut rn_i = 0\n        while rn_i < Array::length(rstnames) {\n          let (rn_name, rn_alias) = Array::get(rstnames, rn_i)\n          let rn_bound = match rn_alias {\n            Some(a) => a,\n            None => rn_name\n          }\n          if rn_bound == \"resume\" {\n            resume_shadowed_top = true\n          } else {\n            ()\n          }\n          rn_i = rn_i + 1\n        }\n      },\n      SReExport(_, rstnames) => {\n        let mut rn_i = 0\n        while rn_i < Array::length(rstnames) {\n          let (rn_name, rn_alias) = Array::get(rstnames, rn_i)\n          let rn_bound = match rn_alias {\n            Some(a) => a,\n            None => rn_name\n          }\n          if rn_bound == \"resume\" {\n            resume_shadowed_top = true\n          } else {\n            ()\n          }\n          rn_i = rn_i + 1\n        }\n      },\n      _ => ()\n    }\n    rst_i = rst_i + 1\n  }\n  while idx < Array::length(stmts) {\n    let env = cur_env\n    let s = cur_s\n    let c = cur_c\n    let stmt = Array::get(stmts, idx)\n    // #942 (ADR-0050): resume-misuse walk — a call-position `resume(...)`\n    // outside any handler arm is rejected, and inside a (non-Error) arm it\n    // must sit in tail position. Runs on a throwaway lane per statement\n    // (only ADDS diagnostics; inference flow untouched). SModule bodies are\n    // covered by the recursive check_stmts call below. `resume_shadowed_top`\n    // (computed above): when a top-level declaration binds the name `resume`,\n    // codegen's prefer_bound_call routes every `resume(x)` to the bound\n    // function, so the misuse walk stands down (Codex P2 on #969).\n    match stmt {\n      SLet(_, _, _, _, rv) => reject_resume_outside_handler(rv, resume_shadowed_top, errors),\n      SLetMut(_, _, rv) => reject_resume_outside_handler(rv, resume_shadowed_top, errors),\n      SLetPat(_, rv) => reject_resume_outside_handler(rv, resume_shadowed_top, errors),\n      STest(_, rb) => reject_resume_outside_handler(rb, resume_shadowed_top, errors),\n      SBench(_, rb) => reject_resume_outside_handler(rb, resume_shadowed_top, errors),\n      SExpr(re) => reject_resume_outside_handler(re, resume_shadowed_top, errors),\n      _ => ()\n    }\n    let (new_env, s1, c1) = match stmt {\n      SLet(_, is_rec, name, ann, val) => {\n        let (vt, ns0, nc) = if is_rec {\n          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c, errors, tytab)\n        } else {\n          check_expr(val, env, defs, s, c, errors, tytab)\n        }\n        // The value must be assignable to a declared annotation (previously\n        // unchecked — `let x: Int = \"s\"` was accepted).\n        let (ns, t) = match ann {\n          Some(te) => {\n            let resolved_te = resolve_type_expr(te, defs)\n            let actual_v = subst_apply(ns0, vt)\n            // #844/#981: `check_assignable` itself now reports the same-name\n            // concrete generic instantiation mismatch (its tolerate branch\n            // calls `detect_narrowed_generic_mismatch` — see checker.vibe),\n            // so the explicit second call this site used to make would\n            // double-report the same diagnostic — dropped.\n            let ns_b = check_assignable(resolved_te, actual_v, ns0, errors, String::concat(\"binding type mismatch for \", name), 0 - 1)\n            // Prefer the RHS's real instantiated type over the erasing bare\n            // annotation when `resolved_te` is a bare generic-struct\n            // reference that `actual_v` already concretely instantiates, so a\n            // LATER statement's lookup of this binding sees real type args\n            // instead of an erased placeholder (see\n            // `preserve_generic_instantiation`'s doc comment in checker.vibe).\n            (ns_b, preserve_generic_instantiation(resolved_te, subst_apply(ns_b, vt)))\n          },\n          None => {\n            let vt_resolved = subst_apply(ns0, vt)\n            if is_array_builder_ty(vt_resolved) || is_region_tagged_ty(vt_resolved) {\n              // #938 value restriction: keep a builder's element var\n              // un-quantified so pushes constrain each other (see the ELet\n              // arm in checker.vibe). #1081 step 3 Phase B: a region-tagged\n              // endpoint needs the identical treatment (see\n              // is_region_tagged_ty's doc comment in checker.vibe).\n              (ns0, vt)\n            } else {\n              (ns0, generalize(ns0, vt))\n            }\n          }\n        }\n        let env1 = env_bind(env, name, t)\n        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)\n      },\n      SLetMut(name, ann, val) => {\n        // ADR-0069 Phase 1: top level is declarations only. A top-level\n        // `let mut` was never soundly implemented (the linear backend\n        // miscompiles cross-function references); reject it, but keep\n        // checking/binding below for error recovery.\n        Array::push(errors, top_level_reject_msg(\"top-level `let mut` bindings are not allowed; move it into fn main\", val))\n        let (vt, ns0, nc) = check_expr(val, env, defs, s, c, errors, tytab)\n        let ns = match ann {\n          Some(te) => check_assignable(resolve_type_expr(te, defs), subst_apply(ns0, vt), ns0, errors, String::concat(\"binding type mismatch for \", name), 0 - 1),\n          None => ns0\n        }\n        let t = match ann {\n          Some(te) => resolve_type_expr(te, defs),\n          None => vt\n        }\n        let env1 = env_bind(env, name, t)\n        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)\n      },\n      SLetPat(pat, val) => {\n        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors, tytab)\n        let new_env = match pat {\n          PTuple(pats) => match vt {\n            CtTuple(types) => {\n              let mut e = env\n              let mut pi = 0\n              while pi < Array::length(pats) {\n                match Array::get(pats, pi) {\n                  PBind(name) => if pi < Array::length(types) {\n                    e = env_bind(e, name, Array::get(types, pi))\n                  } else {\n                    e = env_bind(e, name, CtUnknown)\n                  },\n                  _ => ()\n                }\n                pi = pi + 1\n              }\n              e\n            },\n            _ => {\n              // A tuple pattern can only destructure a tuple value. `let (a, b) =\n              // 5` was accepted and bound `a`/`b` to garbage. When the value\n              // resolves to a concrete NON-tuple type (a scalar, array, option,\n              // fn, struct, enum), this is a real error. Type vars / unknown /\n              // named (generic) values stay tolerated.\n              let concrete_non_tuple = match subst_apply(ns, vt) {\n                CtInt => true,\n                CtDouble => true,\n                CtBool => true,\n                CtString => true,\n                CtChar => true,\n                CtUnit => true,\n                CtBytes => true,\n                CtArray(_) => true,\n                CtOption(_) => true,\n                CtFn(_, _, _) => true,\n                CtStruct(_) => true,\n                CtEnum(_) => true,\n                _ => false\n              }\n              if concrete_non_tuple {\n                Array::push(errors, \"tuple pattern cannot destructure a non-tuple value\")\n              } else {\n                ()\n              }\n              let mut e = env\n              let mut pi = 0\n              while pi < Array::length(pats) {\n                match Array::get(pats, pi) {\n                  PBind(name) => {\n                    e = env_bind(e, name, CtUnknown)\n                  },\n                  _ => ()\n                }\n                pi = pi + 1\n              }\n              e\n            }\n          },\n          PBind(name) => env_bind(env, name, vt),\n          PStruct(_, fields) => {\n            let mut e = env\n            let mut fi = 0\n            while fi < Array::length(fields) {\n              let (_, fpat) = Array::get(fields, fi)\n              match fpat {\n                PBind(name) => {\n                  e = env_bind(e, name, CtUnknown)\n                },\n                _ => ()\n              }\n              fi = fi + 1\n            }\n            e\n          },\n          _ => env\n        }\n        (new_env, ns, nc)\n      },\n      SEnum(_, name, params, variants, enum_derives) => {\n        validate_derives(enum_derives, errors)\n        let param_len = Array::length(params)\n        let param_var_ids = array_empty()\n        let param_var_types = array_empty()\n        let mut pi = 0\n        while pi < param_len {\n          let vid = c + pi\n          Array::push(param_var_ids, vid)\n          Array::push(param_var_types, CtVar(vid))\n          pi = pi + 1\n        }\n        let ctor_result_type = if param_len == 0 {\n          CtEnum(name)\n        } else {\n          CtNamed(name, param_var_types)\n        }\n        let ctor_bounds = array_empty()\n        let resolved_variants = array_empty()\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, vi)\n          let resolved_vtypes = array_empty()\n          let mut ti = 0\n          while ti < Array::length(vtypes) {\n            let vt = subst_type_params(resolve_type_expr(Array::get(vtypes, ti), defs), params, param_var_types)\n            Array::push(resolved_vtypes, vt)\n            ti = ti + 1\n          }\n          Array::push(resolved_variants, (vname, resolved_vtypes))\n          vi = vi + 1\n        }\n        Array::push(defs, TDEnum(name, params, resolved_variants))\n        let mut env1 = env_bind(env, name, CtEnum(name))\n        let mut ci2 = 0\n        while ci2 < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, ci2)\n          // #1078: a variant name already declared by a DIFFERENT enum in\n          // this (possibly whole-program-merged) unit is a hard error.\n          // The checker env is flat and name-keyed with last-registered-\n          // wins shadowing, and qualified CONSTRUCTION is not supported\n          // syntax -- so a bare `Mk(..)` in code written against the\n          // earlier enum silently resolves to this one's signature,\n          // producing an arity/argument-type mismatch pointing at the\n          // WRONG declaration (or, same-signature, a silent wrong-tag\n          // miscompile). Two unrelated packages only meet in one unit via\n          // the merge/flatten lane, which is exactly how #1078 was hit\n          // (@vibe/json's RpcMessage vs another merged package).\n          match find_other_enum_declaring_variant(defs, name, vname) {\n            Some(other) => Array::push(errors, String::concat(String::concat(String::concat(String::concat(\"constructor name collision: \", vname), \" is declared by both \"), other), String::concat(\" and \", String::concat(name, \" in the same compiled unit; bare constructor references are ambiguous (qualified construction is not supported) -- rename one variant\")))),\n            None => ()\n          }\n          let ctor_ty = if Array::length(vtypes) == 0 {\n            ctor_result_type\n          } else {\n            let resolved_args = array_empty()\n            let mut ai = 0\n            while ai < Array::length(vtypes) {\n              let arg_ty = subst_type_params(resolve_type_expr(Array::get(vtypes, ai), defs), params, param_var_types)\n              Array::push(resolved_args, arg_ty)\n              ai = ai + 1\n            }\n            CtFn(resolved_args, ctor_result_type, None)\n          }\n          let exported_ctor_ty = if param_len == 0 {\n            ctor_ty\n          } else {\n            CtForAll(param_var_ids, ctor_bounds, ctor_ty)\n          }\n          env1 = env_bind(env1, vname, exported_ctor_ty)\n          match ctor_ty {\n            CtFn(_, ret, _) => {\n              let exported_ret_ty = if param_len == 0 {\n                ret\n              } else {\n                CtForAll(param_var_ids, ctor_bounds, ret)\n              }\n              env1 = bind_fn_return(env1, vname, exported_ret_ty)\n            },\n            _ => ()\n          }\n          ci2 = ci2 + 1\n        }\n        // #672: pre-bind the generated structural `E::equals` (every enum gets\n        // one) so `==` dispatch call sites resolve at check time.\n        let env_eq = env_bind(env1, String::concat(name, \"::equals\"), CtFn([\n          ctor_result_type,\n          ctor_result_type\n        ], CtBool, None))\n        // #638: pre-bind the signatures the enum-derive desugar will generate, so\n        // `E::compare` / `E::to_string` / `E::default` resolve at check time (the\n        // FS-compile path checks before the codegen-time desugar runs).\n        let env_ord = if struct_derives_has(enum_derives, \"Ord\") {\n          env_bind(env_eq, String::concat(name, \"::compare\"), CtFn([\n            ctor_result_type,\n            ctor_result_type\n          ], CtInt, None))\n        } else {\n          env_eq\n        }\n        let env_show = if struct_derives_has(enum_derives, \"Show\") || struct_derives_has(enum_derives, \"Hash\") {\n          env_bind(env_ord, String::concat(name, \"::to_string\"), CtFn([\n            ctor_result_type\n          ], CtString, None))\n        } else {\n          env_ord\n        }\n        // #694: `derive(Hash)` generates `E::hash_key(Self) -> String` (the\n        // structural Map key), so pre-bind its signature at check time too, AND\n        // register `impl Hash for E` so a `[K: Hash]` bound is satisfied by the\n        // derived enum.\n        let env_hash = if struct_derives_has(enum_derives, \"Hash\") {\n          let env_h = EnvTraitImpl(\"Hash\", ctor_result_type, env_show)\n          env_bind(env_h, String::concat(name, \"::hash_key\"), CtFn([\n            ctor_result_type\n          ], CtString, None))\n        } else {\n          env_show\n        }\n        let env_default = if struct_derives_has(enum_derives, \"Default\") {\n          env_bind(env_hash, String::concat(name, \"::default\"), CtFn(array_empty(), ctor_result_type, None))\n        } else {\n          env_hash\n        }\n        (env_default, s, c + param_len)\n      },\n      SSuberror(_, name, variants) => {\n        // #786: a `suberror Name(payload...)` declaration is structurally a\n        // single-typed enum whose constructors produce a throwable value. It\n        // was parsed (SSuberror) but never bound, so `KeyInvalid(\"x\")` was an\n        // \"unknown name\". Register it exactly like a no-type-param enum: record\n        // a TDEnum def (so `match` + type resolution work) and bind each\n        // constructor name as `CtFn(payload, CtEnum(name))`. `throw` accepts the\n        // resulting value (its param is CtUnknown, see builtins_misc).\n        let ctor_result_type = CtEnum(name)\n        let resolved_variants = array_empty()\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, vi)\n          let resolved_vtypes = array_empty()\n          let mut ti = 0\n          while ti < Array::length(vtypes) {\n            Array::push(resolved_vtypes, resolve_type_expr(Array::get(vtypes, ti), defs))\n            ti = ti + 1\n          }\n          Array::push(resolved_variants, (vname, resolved_vtypes))\n          vi = vi + 1\n        }\n        Array::push(defs, TDEnum(name, array_empty(), resolved_variants))\n        let mut env1 = env_bind(env, name, CtEnum(name))\n        let mut ci2 = 0\n        while ci2 < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, ci2)\n          let ctor_ty = if Array::length(vtypes) == 0 {\n            ctor_result_type\n          } else {\n            let resolved_args = array_empty()\n            let mut ai = 0\n            while ai < Array::length(vtypes) {\n              Array::push(resolved_args, resolve_type_expr(Array::get(vtypes, ai), defs))\n              ai = ai + 1\n            }\n            CtFn(resolved_args, ctor_result_type, None)\n          }\n          env1 = env_bind(env1, vname, ctor_ty)\n          match ctor_ty {\n            CtFn(_, ret, _) => {\n              env1 = bind_fn_return(env1, vname, ret)\n            },\n            _ => ()\n          }\n          ci2 = ci2 + 1\n        }\n        let env_eq = env_bind(env1, String::concat(name, \"::equals\"), CtFn([\n          ctor_result_type,\n          ctor_result_type\n        ], CtBool, None))\n        (env_eq, s, c)\n      },\n      SStruct(_, name, field_defs, derives, mut_fields, tparams) => {\n        validate_derives(derives, errors)\n        let resolved_fields = array_empty()\n        let mut fi = 0\n        while fi < Array::length(field_defs) {\n          let (fname, ftype_expr) = Array::get(field_defs, fi)\n          let ftype = resolve_type_expr(ftype_expr, defs)\n          Array::push(resolved_fields, (fname, ftype))\n          fi = fi + 1\n        }\n        // #829: record the declared type params — a param name resolves above\n        // to a rigid `CtNamed(param, [])` (no such typedef/builtin), which is\n        // exactly what the checker's literal instantiation substitutes.\n        Array::push(defs, TDStruct(name, resolved_fields, mut_fields, tparams))\n        let field_types = array_empty()\n        let mut fj = 0\n        while fj < Array::length(resolved_fields) {\n          let (_, fty) = Array::get(resolved_fields, fj)\n          Array::push(field_types, fty)\n          fj = fj + 1\n        }\n        let env1 = env_bind(env, name, CtFn(field_types, CtStruct(name), None))\n        // #638: pre-bind the signatures of the structural functions that the\n        // derive desugar will generate, so `Type::compare` / `Type::to_string`\n        // resolve at check time (the FS-compile path checks before the\n        // codegen-time desugar runs).\n        let env2 = if struct_derives_has(derives, \"Ord\") {\n          env_bind(env1, String::concat(name, \"::compare\"), CtFn([\n            CtStruct(name),\n            CtStruct(name)\n          ], CtInt, None))\n        } else {\n          env1\n        }\n        let env3 = if struct_derives_has(derives, \"Show\") || struct_derives_has(derives, \"Hash\") {\n          env_bind(env2, String::concat(name, \"::to_string\"), CtFn([\n            CtStruct(name)\n          ], CtString, None))\n        } else {\n          env2\n        }\n        // #672: every struct gets a generated structural `T::equals` (the `==`\n        // dispatch relies on it), so pre-bind its signature unconditionally.\n        let env4 = env_bind(env3, String::concat(name, \"::equals\"), CtFn([\n          CtStruct(name),\n          CtStruct(name)\n        ], CtBool, None))\n        // #694: `derive(Hash)` generates `T::hash_key(Self) -> String` (the\n        // structural Map key), so pre-bind its signature at check time too, AND\n        // register `impl Hash for T` so a `[K: Hash]` bound (e.g. `get_by`) is\n        // satisfied by the derived type.\n        let env_hash = if struct_derives_has(derives, \"Hash\") {\n          let env_h = EnvTraitImpl(\"Hash\", CtStruct(name), env4)\n          env_bind(env_h, String::concat(name, \"::hash_key\"), CtFn([\n            CtStruct(name)\n          ], CtString, None))\n        } else {\n          env4\n        }\n        // #638: `derive(Default)` generates `T::default() -> T` (a zero-arg fn,\n        // so the CtFn parameter list is empty).\n        let env5 = if struct_derives_has(derives, \"Default\") {\n          env_bind(env_hash, String::concat(name, \"::default\"), CtFn(array_empty(), CtStruct(name), None))\n        } else {\n          env_hash\n        }\n        (bind_fn_return(env5, name, CtStruct(name)), s, c)\n      },\n      STypeAlias(_, name, params, te) => {\n        let t = resolve_type_expr(te, defs)\n        // Record the alias (with its formal params) so an applied use\n        // `Name[Arg]` expands via subst in resolve_type_expr's TyApp case.\n        Array::push(defs, TDAlias(name, params, t))\n        (env_bind(env, name, t), s, c)\n      },\n      SExternLet(name, te) => {\n        let t = resolve_type_expr(te, defs)\n        let env1 = env_bind(env, name, t)\n        (bind_annotation_return(env1, name, Some(te), defs), s, c)\n      },\n      STest(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)\n        (env, ns, nc)\n      },\n      SBench(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)\n        (env, ns, nc)\n      },\n      SExpr(expr) => {\n        // ADR-0091 Phase 1: `@zero_alloc` lexes as a single ident token and\n        // lands here as a top-level expression statement. It is an attribute\n        // marker for the following fn declaration, consumed by the\n        // codegen-stage allocation check (common_analysis.vibe's\n        // zero_alloc_check) -- skip both the ADR-0069 reject below and name\n        // resolution (the `@`-spelled ident resolves nowhere).\n        let is_zero_alloc_marker = match expr {\n          EIdent(id_name, _) => id_name == \"@zero_alloc\",\n          _ => false\n        }\n        if is_zero_alloc_marker {\n          (env, s, c)\n        } else {\n          // ADR-0069 Phase 1: top level is declarations only. A top-level\n          // expression statement was silently DROPPED by the linear backend;\n          // reject it (still type-check the expression for error recovery).\n          Array::push(errors, top_level_reject_msg(\"top-level expressions are not allowed; move it into fn main\", expr))\n          let (_, ns, nc) = check_expr(expr, env, defs, s, c, errors, tytab)\n          (env, ns, nc)\n        }\n      },\n      SModule(_, _, body) => {\n        let _ = check_stmts(body, 0, env, defs, s, c, errors, tytab)\n        (env, s, c)\n      },\n      SImport(_, names) => (bind_stmt_imports(env, names), s, c)\n      ,\n      SReExport(_, names) => (bind_stmt_imports(env, names), s, c)\n      ,\n      SAliasDecl(_, _) => (env, s, c)\n      ,\n      STrait(_, name, supers, methods, _) => {\n        let is_open = false\n        (EnvTraitDef(name, supers, is_open, methods, env), s, c)\n      },\n      SImpl(tparams, tbounds, trait_name, type_name) => {\n        // ADR-0068: `Send` is compiler-judged (structural); user impls\n        // would let a non-sendable type cross task/channel boundaries.\n        if trait_name == \"Send\" {\n          Array::push(errors, \"`Send` is a compiler-judged structural marker and cannot be implemented; remove `impl Send`\")\n        } else {\n          ()\n        }\n        let target = match resolve_builtin(type_name) {\n          Some(t) => t,\n          None => CtNamed(type_name, array_empty())\n        }\n        // A generic impl `impl [T] Trait for C` (type parameters present) is\n        // registered as `EnvTraitImplGen` so trait resolution can match the\n        // family `C[..]` against a concrete `C[K]` by constructor (the target's\n        // type args are erased). A plain `impl Trait for C` stays a nominal\n        // `EnvTraitImpl`. (#5 generic impls, Increment A.)\n        let new_env = if Array::length(tparams) > 0 {\n          EnvTraitImplGen(trait_name, tparams, tbounds, target, env)\n        } else {\n          EnvTraitImpl(trait_name, target, env)\n        }\n        (new_env, s, c)\n      },\n      SEffectDef(_, ename, eparams, ops) => {\n        // #813: register the effect's operation signatures (resolved to\n        // checker Types) so perform arguments, handler arm names/arity/\n        // payload binds, and resume values can be validated. Generic effects\n        // (type params) are not registered — every consumer ground-gates on\n        // the registry, so an absent entry means \"no signature checking\",\n        // exactly the pre-#813 behavior.\n        if Array::length(eparams) == 0 {\n          let resolved_ops = array_empty()\n          let mut oi = 0\n          while oi < Array::length(ops) {\n            let (opname, opparams, opret) = Array::get(ops, oi)\n            let rp = array_empty()\n            let mut pi = 0\n            while pi < Array::length(opparams) {\n              Array::push(rp, resolve_type_expr(Array::get(opparams, pi), defs))\n              pi = pi + 1\n            }\n            Array::push(resolved_ops, (opname, rp, resolve_type_expr(opret, defs)))\n            oi = oi + 1\n          }\n          Array::push(defs, TDEffect(ename, resolved_ops))\n        } else {\n          ()\n        }\n        (env, s, c)\n      },\n      SEffectSet(_, esname, _) => {\n        // ADR-0071 (#755): the ADR's Decision section calls out two specific\n        // invalid-definition cases by name -- a cycle through member\n        // references, and a qualified name colliding with an operation of\n        // the same effect (shared member namespace) -- rejected here with\n        // their own specific diagnostics via the resolver-core helpers\n        // above (using the whole-list pre-pass tables, order-independent).\n        // A definition that is neither is now ACCEPTED (step 3): its\n        // members are used to expand any `with { EffectsetName }` row item\n        // that references it, via es_expand_stmts_effect_rows in\n        // collect_async_effect_errors below -- an accepted effectset\n        // genuinely has capability now, unlike step 2's placeholder\n        // \"not yet supported\" rejection for every definition regardless of\n        // validity. What full resolution does NOT yet cover: handler-level\n        // operation-level discharge (step 4), contract/WIT operation-level\n        // surface (step 5), and expanding a row inside a function\n        // PARAMETER's own type (the #885 callback-overlay case) -- those\n        // remain unimplemented, not silently wrong, since nothing consumes\n        // an effectset there yet.\n        if es_qualified_collision(ed_names, ed_ops_list, esname) {\n          Array::push(errors, String::concat(\"effectset '\", String::concat(esname, \"' collides with an operation of the same name declared on its effect (operations and effectsets share the effect-row member namespace) -- rename the effectset or the operation\")))\n        } else {\n          match es_detect_cycle(es_names, es_members_list, esname, array_empty()) {\n            Some(msg) => Array::push(errors, msg),\n            None => ()\n          }\n        }\n        (env, s, c)\n      },\n      _ => (env, s, c)\n    }\n    cur_env = new_env\n    cur_s = s1\n    cur_c = c1\n    idx = idx + 1\n  }\n  (cur_env, cur_s, cur_c)\n}\n\n/// #641 PR-2: enforce trait bounds. After inference, every bounded type variable\n/// recorded in the final substitution that resolved to a CONCRETE type must\n/// satisfy its bounds. Unresolved (still-polymorphic) vars are inherited by the\n/// caller, not violated, so they are skipped. One `no impl `Trait` for `Type``\n/// error per unsatisfied bound (matches fixtures/err_type_trait_*bound* messages).\nfn check_program_bounds(env: TypeEnv, s: Subst, defs: Array[TypeDef], errors: Array[String]) -> Unit {\n  check_program_bounds_impl(env, s, defs, errors, false)\n}\n\n/// send_only: the FS/import path (check_program_with_env) checks ONLY the\n/// compiler-judged `Send` bound. User-trait bounds cannot be enforced there\n/// yet: imported files' `impl` declarations are not propagated into the\n/// entry file's TypeEnv, so a cross-module `impl Hash for String` would be\n/// invisible and every such bound would false-positive (found empirically:\n/// builtin_traits_test / iterator_test / to_string_bool_param_test).\n/// `Send` needs no user impls — its structural judgment plus the seeded\n/// primitive impls are complete in any env — so it is safe to enforce\n/// everywhere.\nfn check_program_bounds_impl(env: TypeEnv, s: Subst, defs: Array[TypeDef], errors: Array[String], send_only: Bool) -> Unit {\n  let pairs = collect_subst_bounds_pairs(s)\n  let n = Array::length(pairs)\n  let mut i = 0\n  while i < n {\n    let (vid, bounds) = Array::get(pairs, i)\n    let resolved = subst_apply(s, CtVar(vid))\n    match resolved {\n      CtVar(_) => (),\n      CtUnknown => (),\n      _ => {\n        let bn = Array::length(bounds)\n        let mut bi = 0\n        while bi < bn {\n          let b = Array::get(bounds, bi)\n          // ADR-0068: `Send` is judged structurally from the type\n          // definitions (type_send_ok), not from user impls.\n          let sat = if b == \"\" {\n            true\n          } else if b == \"Send\" {\n            type_send_ok(env, s, defs, resolved)\n          } else if send_only {\n            true\n          } else {\n            type_implements_trait(env, s, resolved, b)\n          }\n          if b != \"\" && not(sat) {\n            Array::push(errors, String::concat(\"no impl `\", String::concat(b, String::concat(\"` for `\", String::concat(type_to_string(resolved), \"`\")))))\n          }\n          bi = bi + 1\n        }\n      }\n    }\n    i = i + 1\n  }\n}\n\n/// Append `Async`-escape diagnostics (an async primitive used outside an\n/// `{Async}` context) to the type-error list, but only when type checking is\n/// otherwise clean so we surface the real error first.\nfn collect_async_effect_errors(stmts: Array[Stmt], env: TypeEnv, frozen_errors: Array[String]) -> Unit {\n  if Array::length(frozen_errors) == 0 {\n    let eff_errs = check_async_effects_stmts(stmts, env)\n    let mut i = 0\n    while i < Array::length(eff_errs) {\n      Array::push(frozen_errors, effect_error_to_string(Array::get(eff_errs, i)))\n      i = i + 1\n    }\n    if Array::length(frozen_errors) == 0 {\n      // ADR-0071 step 3 (#755): expand any effectset-name token in a\n      // top-level binding's OWN declared effect row into its flat\n      // leaf-label set BEFORE the (otherwise unmodified)\n      // check_perform_effects_stmts_env sees it -- `with { AskAll }`\n      // becomes e.g. `with { Ask }`, so the existing string-label\n      // containment machinery authorizes what AskAll actually expands to\n      // instead of requiring callers to re-declare it verbatim. Pure AST\n      // rewrite local to this file (see es_expand_stmts_effect_rows);\n      // check_perform_effects_stmts_env itself is untouched.\n      let (perform_es_names, perform_es_members_list, _, _) = es_collect_tables(stmts, 0)\n      let expanded_stmts = es_expand_stmts_effect_rows(stmts, perform_es_names, perform_es_members_list)\n      let perform_errs = check_perform_effects_stmts_env(expanded_stmts, env)\n      let mut j = 0\n      while j < Array::length(perform_errs) {\n        Array::push(frozen_errors, effect_error_to_string(Array::get(perform_errs, j)))\n        j = j + 1\n      }\n    }\n    if Array::length(frozen_errors) == 0 {\n      let mut_errs = check_mutability_stmts(stmts)\n      let mut k = 0\n      while k < Array::length(mut_errs) {\n        Array::push(frozen_errors, effect_error_to_string(Array::get(mut_errs, k)))\n        k = k + 1\n      }\n    }\n  }\n}\n\n/// #986: labeled-argument NAME validation. Codegen binds call arguments\n/// positionally after desugar_labeled_args has reordered fully-labeled calls\n/// into declared parameter order, so any labeled argument that survives to a\n/// position whose parameter has a DIFFERENT base name would silently bind the\n/// wrong parameter (or, for a label naming no parameter at all, is a typo the\n/// user meant to be caught). This walk runs AFTER desugar_labeled_args (see\n/// check_program) and rejects both shapes with a located error. Resolution\n/// scope deliberately mirrors collect_fn_param_labels / relabel_expr in\n/// desugar_trait_dict.vibe: only calls whose callee is an EIdent naming a\n/// top-level `let`-bound function are validated — builtins with decorative\n/// flag labels (`sh_lines(\"ls\", a = true)`), local closures, and method calls\n/// are left untouched, exactly like the reorder pass leaves them untouched.\nfn labeled_name_marker(off: Int, len: Int) -> String {\n  if off >= 0 && len > 0 {\n    String::concat(\" [@off=\", String::concat(__to_string(off), String::concat(\":\", String::concat(__to_string(off + len), \"]\"))))\n  } else if off >= 0 {\n    String::concat(\" [@off=\", String::concat(__to_string(off), \"]\"))\n  } else {\n    \"\"\n  }\n}\n\n/// Strip a trailing `~` (labeled) / `?` (optional) marker off a raw parameter\n/// name — same convention as the EFn arm in checker.vibe.\nfn labeled_param_base_name(n: String) -> String {\n  let ln = String::length(n)\n  if ln > 0 {\n    let last = n[ln - 1: ln]\n    if last == \"~\" || last == \"?\" {\n      n[0: ln - 1]\n    } else {\n      n\n    }\n  } else {\n    n\n  }\n}\n\n/// fname -> ordered parameter base names for EVERY top-level `let f = (..) -> ..`\n/// (labeled or not — a labeled call against an unlabeled fn still binds\n/// positionally, so its labels must line up too).\nfn collect_labeled_check_fns(stmts: Array[Stmt]) -> Array[(String, Array[String])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, _, body) => match body {\n        EFn(_, _, params, _, _, _) => {\n          let names = array_empty()\n          let mut pi = 0\n          while pi < Array::length(params) {\n            let (pn, _) = Array::get(params, pi)\n            Array::push(names, labeled_param_base_name(pn))\n            pi = pi + 1\n          }\n          Array::push(out, (fname, names))\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_labeled_check_fn(tbl: Array[(String, Array[String])], fname: String) -> Option[Array[String]] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(tbl) {\n    let (n, names) = Array::get(tbl, i)\n    if n == fname {\n      found = Some(names)\n      i = Array::length(tbl)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// #1001: the Oracle (formal/VibeFormal/Typing/Call.lean's `resolveArguments`)\n/// rejects a call whose arguments mix `ELabeledArg` (`x=1`) and plain\n/// positional (`\"ok\"`) forms UNCONDITIONALLY -- a call must be either\n/// uniformly positional or uniformly labeled, regardless of whether a label\n/// happens to already sit at its own declared parameter position. This check\n/// MUST run on the ORIGINAL, pre-desugar argument list (see the `pre_desugar`\n/// branch in `labeled_name_check_expr` above): `desugar_labeled_args`'s\n/// `strip_in_position_labels` (desugar_trait_dict.vibe) silently unwraps any\n/// label that already matches its own position, on the theory that it is a\n/// harmless \"decorative\" label on an otherwise-fully-positional call -- so\n/// `f(x=1, \"ok\")` desugars to the ordinary positional `f(1, \"ok\")`,\n/// indistinguishable by the time codegen or a post-desugar checker pass would\n/// see it from a call that was never labeled at all. Checking here, before\n/// that stripping runs, is the only point where the genuine mix is still\n/// observable.\nfn check_mixed_argument_modes(fname: String, fname_off: Int, args: Array[Expr], errors: Array[String]) -> Unit {\n  let mut has_labeled = false\n  let mut has_plain = false\n  let mut i = 0\n  while i < Array::length(args) {\n    match Array::get(args, i) {\n      ELabeledArg(_, _, _) => {\n        has_labeled = true\n      },\n      _ => {\n        has_plain = true\n      }\n    }\n    i = i + 1\n  }\n  if has_labeled && has_plain {\n    let marker = labeled_name_marker(fname_off, String::length(fname))\n    Array::push(errors, String::concat(\"call to \", String::concat(fname, String::concat(\" mixes positional and labeled arguments — use either all positional or all labeled arguments\", marker))))\n  } else {\n    ()\n  }\n}\n\nfn labeled_name_check_call(fname: String, fname_off: Int, args: Array[Expr], pnames: Array[String], errors: Array[String]) -> Unit {\n  let mut ai = 0\n  while ai < Array::length(args) {\n    match Array::get(args, ai) {\n      ELabeledArg(lbl, _, _) => {\n        let in_position = if ai < Array::length(pnames) {\n          Array::get(pnames, ai) == lbl\n        } else {\n          false\n        }\n        if in_position {\n          ()\n        } else {\n          let mut known = false\n          let mut pi = 0\n          while pi < Array::length(pnames) {\n            if Array::get(pnames, pi) == lbl {\n              known = true\n            } else {\n              ()\n            }\n            pi = pi + 1\n          }\n          let marker = labeled_name_marker(fname_off, String::length(fname))\n          if known {\n            Array::push(errors, String::concat(\"labeled argument `\", String::concat(lbl, String::concat(\"` for \", String::concat(fname, String::concat(\" is out of declared parameter order\", marker))))))\n          } else {\n            Array::push(errors, String::concat(\"unknown labeled argument `\", String::concat(lbl, String::concat(\"` for \", String::concat(fname, marker)))))\n          }\n        }\n      },\n      _ => ()\n    }\n    ai = ai + 1\n  }\n}\n\n/// #986 (Codex P2-2 on #993): the walk tracks lexical shadowing — a local\n/// binding (`let f = ..`, fn param, pattern bind, loop var) of a table name\n/// suppresses validation for calls in its scope, since those calls resolve to\n/// the local value whose parameter names the top-level table does not describe.\n/// Same discipline as relabel_expr's `shadows` stack in desugar_trait_dict.vibe.\nfn labeled_walk_shadowed(shadows: Array[String], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(shadows) {\n    if Array::get(shadows, i) == name {\n      found = true\n      i = Array::length(shadows)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn labeled_walk_pat_binds(pat: Pat, shadows: Array[String]) -> Unit {\n  match pat {\n    PBind(n) => Array::push(shadows, n),\n    PCtor(_, ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        labeled_walk_pat_binds(Array::get(ps, i), shadows)\n        i = i + 1\n      }\n    },\n    PTuple(ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        labeled_walk_pat_binds(Array::get(ps, i), shadows)\n        i = i + 1\n      }\n    },\n    POr(a, b) => {\n      labeled_walk_pat_binds(a, shadows)\n      labeled_walk_pat_binds(b, shadows)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        labeled_walk_pat_binds(fp, shadows)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn labeled_name_check_expr(e: Expr, tbl: Array[(String, Array[String])], shadows: Array[String], errors: Array[String], pre_desugar: Bool) -> Unit {\n  match e {\n    ECall(callee, args, _) => {\n      labeled_name_check_expr(callee, tbl, shadows, errors, pre_desugar)\n      let mut i = 0\n      while i < Array::length(args) {\n        labeled_name_check_expr(Array::get(args, i), tbl, shadows, errors, pre_desugar)\n        i = i + 1\n      }\n      match callee {\n        EIdent(fname, fname_off) => {\n          let mut has_labeled = false\n          let mut li = 0\n          while li < Array::length(args) {\n            match Array::get(args, li) {\n              ELabeledArg(_, _, _) => {\n                has_labeled = true\n              },\n              _ => ()\n            }\n            li = li + 1\n          }\n          if has_labeled {\n            if pre_desugar {\n              // #1001 review (Codex P2): mixed-mode is a purely syntactic\n              // call-shape check that needs no parameter-name resolution at\n              // all, so it must NOT be gated behind the same\n              // tbl-membership + not-shadowed lookup the position/unknown-\n              // label checks need (those genuinely require knowing the\n              // callee's real param names). Gating it that way let a call to\n              // any LOCAL closure with labeled params bypass the check\n              // entirely: `labeled_walk_shadowed` returns true for such a\n              // callee (it tracks every local let/param binding in scope,\n              // not just names that collide with a top-level table entry),\n              // so the check never ran. Run it whenever the callee resolves\n              // to a genuine user-level closure -- a local binding OR a\n              // known top-level fn -- either of which can legitimately\n              // declare labeled params. A callee that is neither (a genuine\n              // BUILTIN, some of which use a deliberate decorative\n              // flag-label convention -- `sh_lines(\"ls\", a = true)` -- or an\n              // import/erroneous reference) stays tolerated, exactly like\n              // the post-desugar branch below already tolerates those\n              // shapes.\n              if labeled_walk_shadowed(shadows, fname) {\n                check_mixed_argument_modes(fname, fname_off, args, errors)\n              } else {\n                match lookup_labeled_check_fn(tbl, fname) {\n                  Some(_) => check_mixed_argument_modes(fname, fname_off, args, errors),\n                  None => ()\n                }\n              }\n            } else if !labeled_walk_shadowed(shadows, fname) {\n              match lookup_labeled_check_fn(tbl, fname) {\n                Some(pnames) => labeled_name_check_call(fname, fname_off, args, pnames, errors),\n                None => ()\n              }\n            } else {\n              ()\n            }\n          } else {\n            ()\n          }\n        },\n        _ => ()\n      }\n    },\n    ELabeledArg(_, _, v) => labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar),\n    EBinOp(_, l, r) => {\n      labeled_name_check_expr(l, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(r, tbl, shadows, errors, pre_desugar)\n    },\n    EUnaryOp(_, inner) => labeled_name_check_expr(inner, tbl, shadows, errors, pre_desugar),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        labeled_name_check_expr(Array::get(items, i), tbl, shadows, errors, pre_desugar)\n        i = i + 1\n      }\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        labeled_name_check_expr(Array::get(items, i), tbl, shadows, errors, pre_desugar)\n        i = i + 1\n      }\n    },\n    ESpread(inner) => labeled_name_check_expr(inner, tbl, shadows, errors, pre_desugar),\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fv) = Array::get(fields, i)\n        labeled_name_check_expr(fv, tbl, shadows, errors, pre_desugar)\n        i = i + 1\n      }\n    },\n    EMap(pairs) => {\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (_, pv) = Array::get(pairs, i)\n        labeled_name_check_expr(pv, tbl, shadows, errors, pre_desugar)\n        i = i + 1\n      }\n    },\n    EIf(cnd, thn, els) => {\n      labeled_name_check_expr(cnd, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(thn, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(els, tbl, shadows, errors, pre_desugar)\n    },\n    ELet(name, v, b, _) => {\n      labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar)\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      labeled_name_check_expr(b, tbl, shadows, errors, pre_desugar)\n      Array::truncate(shadows, mark)\n    },\n    ELetRec(name, v, b) => {\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(b, tbl, shadows, errors, pre_desugar)\n      Array::truncate(shadows, mark)\n    },\n    ELetMut(name, v, b, _) => {\n      labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar)\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      labeled_name_check_expr(b, tbl, shadows, errors, pre_desugar)\n      Array::truncate(shadows, mark)\n    },\n    EAssign(_, v, k) => {\n      labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(k, tbl, shadows, errors, pre_desugar)\n    },\n    EAssignOp(_, _, v, k) => {\n      labeled_name_check_expr(v, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(k, tbl, shadows, errors, pre_desugar)\n    },\n    ESeq(a, b) => {\n      labeled_name_check_expr(a, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(b, tbl, shadows, errors, pre_desugar)\n    },\n    EMatch(scrut, arms) => {\n      labeled_name_check_expr(scrut, tbl, shadows, errors, pre_desugar)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (ap, ab) = Array::get(arms, i)\n        let mark = Array::length(shadows)\n        labeled_walk_pat_binds(ap, shadows)\n        labeled_name_check_expr(ab, tbl, shadows, errors, pre_desugar)\n        Array::truncate(shadows, mark)\n        i = i + 1\n      }\n    },\n    EHandle(scrut, arms) => {\n      labeled_name_check_expr(scrut, tbl, shadows, errors, pre_desugar)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (ap, ab) = Array::get(arms, i)\n        let mark = Array::length(shadows)\n        labeled_walk_pat_binds(ap, shadows)\n        labeled_name_check_expr(ab, tbl, shadows, errors, pre_desugar)\n        Array::truncate(shadows, mark)\n        i = i + 1\n      }\n    },\n    EWhile(cnd, body) => {\n      labeled_name_check_expr(cnd, tbl, shadows, errors, pre_desugar)\n      labeled_name_check_expr(body, tbl, shadows, errors, pre_desugar)\n    },\n    ELoop(inits, body) => {\n      let mut i = 0\n      while i < Array::length(inits) {\n        let (_, iv) = Array::get(inits, i)\n        labeled_name_check_expr(iv, tbl, shadows, errors, pre_desugar)\n        i = i + 1\n      }\n      let mark = Array::length(shadows)\n      let mut pi = 0\n      while pi < Array::length(inits) {\n        let (pname, _) = Array::get(inits, pi)\n        Array::push(shadows, pname)\n        pi = pi + 1\n      }\n      labeled_name_check_expr(body, tbl, shadows, errors, pre_desugar)\n      Array::truncate(shadows, mark)\n    },\n    EForIn(name, idx, iter, body) => {\n      labeled_name_check_expr(iter, tbl, shadows, errors, pre_desugar)\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      match idx {\n        Some(ix) => Array::push(shadows, ix),\n        None => ()\n      }\n      labeled_name_check_expr(body, tbl, shadows, errors, pre_desugar)\n      Array::truncate(shadows, mark)\n    },\n    EFn(_, _, fparams, _, _, body) => {\n      let mark = Array::length(shadows)\n      let mut pi = 0\n      while pi < Array::length(fparams) {\n        let (pn, _) = Array::get(fparams, pi)\n        Array::push(shadows, labeled_param_base_name(pn))\n        pi = pi + 1\n      }\n      labeled_name_check_expr(body, tbl, shadows, errors, pre_desugar)\n      Array::truncate(shadows, mark)\n    },\n    EDot(obj, _, _, _) => labeled_name_check_expr(obj, tbl, shadows, errors, pre_desugar),\n    EReturn(inner) => labeled_name_check_expr(inner, tbl, shadows, errors, pre_desugar),\n    EBreak(opt) => match opt {\n      Some(inner) => labeled_name_check_expr(inner, tbl, shadows, errors, pre_desugar),\n      None => ()\n    },\n    EContinue(exprs) => {\n      let mut i = 0\n      while i < Array::length(exprs) {\n        labeled_name_check_expr(Array::get(exprs, i), tbl, shadows, errors, pre_desugar)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn labeled_name_check_stmt(stmt: Stmt, tbl: Array[(String, Array[String])], errors: Array[String], pre_desugar: Bool) -> Unit {\n  match stmt {\n    SLet(_, _, _, _, body) => labeled_name_check_expr(body, tbl, array_empty(), errors, pre_desugar),\n    SLetMut(_, _, body) => labeled_name_check_expr(body, tbl, array_empty(), errors, pre_desugar),\n    STest(_, body) => labeled_name_check_expr(body, tbl, array_empty(), errors, pre_desugar),\n    SBench(_, body) => labeled_name_check_expr(body, tbl, array_empty(), errors, pre_desugar),\n    SExpr(e) => labeled_name_check_expr(e, tbl, array_empty(), errors, pre_desugar),\n    SLetPat(_, e) => labeled_name_check_expr(e, tbl, array_empty(), errors, pre_desugar),\n    SModule(_, _, ms) => {\n      let mut i = 0\n      while i < Array::length(ms) {\n        labeled_name_check_stmt(Array::get(ms, i), tbl, errors, pre_desugar)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\n/// #1001: `pre_desugar` selects which of the two labeled-call checks runs (see\n/// `labeled_name_check_expr`'s `pre_desugar` branch): `true` for the mixed-\n/// argument-modes check, called BEFORE `desugar_labeled_args` in\n/// `check_program`/`check_program_with_env` so it still sees each call's\n/// original argument list; `false` (the pre-existing behavior) for the\n/// unknown/out-of-order label checks, which must run AFTER desugar so a\n/// validly-reordered fully-labeled call is not misjudged against its\n/// original call-site order.\nfn check_labeled_arg_names_stmts(stmts: Array[Stmt], errors: Array[String], pre_desugar: Bool) -> Unit {\n  let tbl = collect_labeled_check_fns(stmts)\n  if Array::length(tbl) == 0 {\n    ()\n  } else {\n    let mut i = 0\n    while i < Array::length(stmts) {\n      labeled_name_check_stmt(Array::get(stmts, i), tbl, errors, pre_desugar)\n      i = i + 1\n    }\n  }\n}\n\nexport fn check_program(stmts: Array[Stmt]) -> TypeEnv with { Error } {\n  // #760(2): make `Result` (Ok/Err) resolvable standalone — append its enum\n  // declaration unless already declared/imported. Must run before checking so\n  // `Result::Ok` / bare `Ok` / `Result[T, E]` annotations resolve on the\n  // FS-compile path (which type-checks before the codegen desugar runs).\n  inject_prelude_result(stmts)\n  // Rank-1 method generics (#684): re-attach trait-method `[X: Bound]` binders\n  // to impl free functions before checking, so `X::method` in an impl body\n  // resolves on every path (the FS-compile path type-checks before the codegen\n  // desugar runs). In-place + idempotent + inert without a method-level binder.\n  inject_trait_method_generics(stmts)\n  // #635: lower `let*`/`?` railway sentinels (`__try_bind`/`__try_op`) by the\n  // operand's head type BEFORE checking, so the checker never sees the\n  // sentinels (the codegen-time desugar runs later, but the FS-compile path\n  // type-checks first). In-place, idempotent, inert without `let*`/`?`.\n  desugar_railway_binds(stmts)\n  let errors = ArrayBuilder::new()\n  let frozen_errors = ArrayBuilder::freeze(errors)\n  // #1001: mixed positional/labeled argument-mode validation. Must run BEFORE\n  // desugar_labeled_args below — it silently strips a label that already\n  // matches its own declared position, which erases the only evidence that a\n  // call genuinely mixed argument modes (see check_mixed_argument_modes).\n  check_labeled_arg_names_stmts(stmts, frozen_errors, true)\n  // #986: reorder fully-labeled calls into declared parameter order BEFORE\n  // checking, so the checker unifies each labeled argument against the same\n  // parameter position codegen will bind it to (the codegen-time desugar runs\n  // this pass again later — it is in-place and idempotent). Without this the\n  // checker would see `add(y=2, x=1)` in call order while codegen binds the\n  // reordered form.\n  desugar_labeled_args(stmts)\n  let empty_defs = array_empty()\n  let seeded_raw_env = if trait_defined(EnvEmpty, \"Eq\") {\n    EnvEmpty\n  } else {\n    register_builtin_traits(EnvEmpty)\n  }\n  let seeded_env = env_cache(seeded_raw_env)\n  let tytab = array_empty()\n  // #986: labeled-argument name validation (unknown / out-of-order labels).\n  // Must run after desugar_labeled_args above.\n  check_labeled_arg_names_stmts(stmts, frozen_errors, false)\n  // ADR-0071 step 3 (#755): expand any effectset-name token in EVERY\n  // declared effect row (function signatures AND parameter types) into its\n  // flat leaf-label set ONCE here, before type-checking -- not just before\n  // collect_async_effect_errors below. Argument-compatibility checking\n  // (check_assignable's effect-row subtyping, checker.vibe) runs as part of\n  // check_stmts and independently compares raw row strings; feeding it an\n  // unexpanded \"AskAll\" against an already-expanded \"Ask::Get\" callee would\n  // report a false \"effect would be dropped\" mismatch even though the\n  // effectset actually covers it. A non-mutating copy (stmts itself, and\n  // whatever the caller does with it after check_program returns, are\n  // unaffected) is enough: codegen never reads the row's text content.\n  let expanded_stmts = {\n    let (top_es_names, top_es_members_list, _, _) = es_collect_tables(stmts, 0)\n    es_expand_stmts_effect_rows(stmts, top_es_names, top_es_members_list)\n  }\n  let (env, final_s, _) = check_stmts(expanded_stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\n  check_program_bounds(env, final_s, empty_defs, frozen_errors)\n  collect_async_effect_errors(expanded_stmts, env, frozen_errors)\n  // #1081 step 3 Phase B (Codex review, PR #1151): `let mut` capture\n  // rejection is purely syntactic (no env/Subst needed) and must see the\n  // WHOLE program, not just one `TaskGroup::run` call's own body -- a\n  // `let mut` declared in the enclosing top-level function before calling\n  // `TaskGroup::run` is invisible to a per-call check. Run once per\n  // top-level declaration (checker_spawnable.vibe).\n  let spawnable_mut_errors = check_spawnable_mut_captures_stmts(stmts)\n  let mut smi = 0\n  while smi < Array::length(spawnable_mut_errors) {\n    Array::push(frozen_errors, Array::get(spawnable_mut_errors, smi))\n    smi = smi + 1\n  }\n  if Array::length(frozen_errors) > 0 {\n    throw(Array::get(frozen_errors, 0))\n  }\n  env\n}\n\n/// Collecting variant of check_program for typed hover (vibe type-at): runs the\n/// same inference but RETURNS the recorded (offset, Type) table plus the FINAL\n/// substitution (check_stmts' 2nd value), instead of the TypeEnv. It degrades\n/// gracefully: any type error is swallowed and whatever table was collected so\n/// far is returned, so hovering inside a partially-bad file still resolves the\n/// names that were checked before the error. The table holds RAW (pre-final\n/// subst) types; callers resolve via subst_apply(finalSubst, ty).\nexport fn check_program_type_table(stmts: Array[Stmt]) -> (Array[(Int, Type)], Subst) with { Error } {\n  let empty_defs = array_empty()\n  let seeded_raw_env = if trait_defined(EnvEmpty, \"Eq\") {\n    EnvEmpty\n  } else {\n    register_builtin_traits(EnvEmpty)\n  }\n  let seeded_env = env_cache(seeded_raw_env)\n  let errors = ArrayBuilder::new()\n  let frozen_errors = ArrayBuilder::freeze(errors)\n  let tytab = array_empty()\n  handle {\n    let (_, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\n    (tytab, final_s)\n  } with Error {\n    Throw(_) => (tytab, SubstEmpty)\n  }\n}\n\nexport fn check_program_with_env(stmts: Array[Stmt], initial_env: TypeEnv) -> TypeEnv with { Error } {\n  match initial_env {\n    EnvEmpty => check_program(stmts),\n    _ => {\n      inject_prelude_result(stmts)\n      inject_trait_method_generics(stmts)\n      // #635: lower `let*`/`?` railway sentinels before checking (see\n      // check_program). This path checks each imported/entry file pre-codegen.\n      desugar_railway_binds(stmts)\n      let errors = ArrayBuilder::new()\n      let frozen_errors = ArrayBuilder::freeze(errors)\n      // #1001: mixed argument-mode validation before desugar (see check_program).\n      check_labeled_arg_names_stmts(stmts, frozen_errors, true)\n      // #986: reorder fully-labeled calls before checking (see check_program).\n      desugar_labeled_args(stmts)\n      let empty_defs = array_empty()\n      let cached_env = env_cache(initial_env)\n      let seeded_raw_env = if trait_defined(cached_env, \"Eq\") {\n        cached_env\n      } else {\n        register_builtin_traits(cached_env)\n      }\n      let seeded_env = env_cache(seeded_raw_env)\n      let tytab = array_empty()\n      // #986: labeled-argument name validation (see check_program).\n      check_labeled_arg_names_stmts(stmts, frozen_errors, false)\n      let (env, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\n      // #1090 review: the FS typecheck path (every file with imports) went\n      // through here and never enforced trait bounds, so `[T: Send]` on an\n      // imported generic fn was silently bypassed. Enforce the Send bound\n      // here (send_only — see check_program_bounds_impl for why user-trait\n      // bounds cannot be enforced on this path yet).\n      check_program_bounds_impl(env, final_s, empty_defs, frozen_errors, true)\n      collect_async_effect_errors(stmts, env, frozen_errors)\n      // #1081 step 3 Phase B (Codex review, PR #1151): see check_program's\n      // matching call for why this runs whole-program rather than per\n      // `TaskGroup::run` call.\n      let spawnable_mut_errors = check_spawnable_mut_captures_stmts(stmts)\n      let mut smi = 0\n      while smi < Array::length(spawnable_mut_errors) {\n        Array::push(frozen_errors, Array::get(spawnable_mut_errors, smi))\n        smi = smi + 1\n      }\n      if Array::length(frozen_errors) > 0 {\n        throw(Array::get(frozen_errors, 0))\n      }\n      env\n    }\n  }\n}\n\n//# Import-usage / discarded-value diagnostics (#1129, and the companion\n// \"unbound non-Unit return value\" request from the same batch). Both are\n// syntactic-plus-type-table post-passes over an already-parsed/checked\n// program, kept in THIS file (not checker_warning.vibe, which lives in the\n// top-level @vibe/compiler package) so `collect_all_diagnostics`\n// (runtime/typecheck_fs.vibe, already a `@vibe/compiler/checker` consumer\n// via check_program/check_program_type_table) can reach them without\n// introducing a cross-package import back from a subpackage into the\n// top-level package (the direction checker_trait.vibe's relocation into\n// this package, noted above, was moved to avoid).\n\nfn warning_names_contains(arr: Array[String], s: String) -> Bool {\n  let len = Array::length(arr)\n  let mut i = 0\n  let mut found = false\n  while i < len {\n    if Array::get(arr, i) == s {\n      found = true\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn push_ref_name(out: Array[String], name: String) -> Unit {\n  if warning_names_contains(out, name) {\n    ()\n  } else {\n    Array::push(out, name)\n  }\n}\n\n/// Every name referenced in `te`'s type positions (`TyName`/`TyApp`'s own\n/// name, plus recursively into `TyApp` args, `TyFn` params/return, and\n/// `TyTuple` members) -- so an imported `type X` counted \"used\" only via a\n/// type ANNOTATION (e.g. `fn f(x: X) -> Unit`) is not misreported as unused\n/// just because it never appears as a value-position `EIdent`.\nfn collect_texpr_ref_names(te: TypeExpr, out: Array[String]) -> Unit {\n  match te {\n    TyName(name) => push_ref_name(out, name),\n    TyApp(name, args) => {\n      push_ref_name(out, name)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_texpr_ref_names(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    TyFn(params, ret, _) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        collect_texpr_ref_names(Array::get(params, i), out)\n        i = i + 1\n      }\n      collect_texpr_ref_names(ret, out)\n    },\n    TyTuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_texpr_ref_names(Array::get(items, i), out)\n        i = i + 1\n      }\n    },\n    TyUnit => ()\n  }\n}\n\nfn collect_opt_texpr_ref_names(ty: Option[TypeExpr], out: Array[String]) -> Unit {\n  match ty {\n    Some(te) => collect_texpr_ref_names(te, out),\n    None => ()\n  }\n}\n\n/// Every `EIdent` name reachable from `expr` (value-position references,\n/// including qualified `Type::method` spellings -- the parser already folds\n/// those into a single `EIdent(\"Type::method\", off)`, see\n/// parser_expr_primary.vibe), PLUS every type name reachable through an\n/// `EFn`'s own parameter/return annotations, an `ERecord`'s own type name\n/// and explicit type-argument list -- both otherwise invisible to a\n/// value-only walk. `bound` is the stack of names currently shadowed by an\n/// enclosing binder (function param, `let`/`let rec`/`let mut`, `for`/`loop`\n/// var, or match/handle pattern bind) -- an `EIdent` matching one of these is\n/// a reference to the LOCAL binding, never the import, so it must not count\n/// (Codex review on #1204: a param named the same as an imported value used\n/// to suppress that import's own unused warning). Each scope-introducing\n/// case pushes its bound name(s) before recursing into the scope they cover\n/// and truncates back to the saved length afterward, so a name is only\n/// shadowed for the span of code it actually covers.\nfn collect_referenced_names_expr(expr: Expr, bound: Array[String], out: Array[String]) -> Unit {\n  match expr {\n    EIdent(name, _) => if labeled_walk_shadowed(bound, name) {\n      ()\n    } else {\n      push_ref_name(out, name)\n    },\n    EInt(_) => (),\n    EFloat(_) => (),\n    EString(_) => (),\n    EBool(_) => (),\n    EUnit => (),\n    EBreak(opt) => match opt {\n      Some(e) => collect_referenced_names_expr(e, bound, out),\n      None => ()\n    },\n    EContinue(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_referenced_names_expr(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n    },\n    EReturn(e) => collect_referenced_names_expr(e, bound, out),\n    EUnaryOp(_, e) => collect_referenced_names_expr(e, bound, out),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_referenced_names_expr(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_referenced_names_expr(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n    },\n    ERecord(name, fields, targs) => {\n      // #1204 Codex review: the record's OWN name (`Type::{ .. }`) is a real\n      // reference to `Type` -- struct/enum names are top-level-only (never\n      // locally bound), so no `bound` check applies here.\n      push_ref_name(out, name)\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_referenced_names_expr(val, bound, out)\n        i = i + 1\n      }\n      let mut ti = 0\n      while ti < Array::length(targs) {\n        collect_texpr_ref_names(Array::get(targs, ti), out)\n        ti = ti + 1\n      }\n    },\n    EBinOp(_, l, r) => {\n      collect_referenced_names_expr(l, bound, out)\n      collect_referenced_names_expr(r, bound, out)\n    },\n    ECall(callee, args, _) => {\n      collect_referenced_names_expr(callee, bound, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_referenced_names_expr(Array::get(args, i), bound, out)\n        i = i + 1\n      }\n    },\n    EIf(cond, then_e, else_e) => {\n      collect_referenced_names_expr(cond, bound, out)\n      collect_referenced_names_expr(then_e, bound, out)\n      collect_referenced_names_expr(else_e, bound, out)\n    },\n    ELet(name, val, body, _) => {\n      // `val` is evaluated BEFORE `name` is bound (not visible to itself).\n      collect_referenced_names_expr(val, bound, out)\n      let mark = Array::length(bound)\n      Array::push(bound, name)\n      collect_referenced_names_expr(body, bound, out)\n      Array::truncate(bound, mark)\n    },\n    ELetRec(name, val, body) => {\n      // Recursive: `name` is visible in its OWN value too.\n      let mark = Array::length(bound)\n      Array::push(bound, name)\n      collect_referenced_names_expr(val, bound, out)\n      collect_referenced_names_expr(body, bound, out)\n      Array::truncate(bound, mark)\n    },\n    ELetMut(name, val, body, _) => {\n      collect_referenced_names_expr(val, bound, out)\n      let mark = Array::length(bound)\n      Array::push(bound, name)\n      collect_referenced_names_expr(body, bound, out)\n      Array::truncate(bound, mark)\n    },\n    EAssign(_, val, body) => {\n      collect_referenced_names_expr(val, bound, out)\n      collect_referenced_names_expr(body, bound, out)\n    },\n    EAssignOp(_, _, val, body) => {\n      collect_referenced_names_expr(val, bound, out)\n      collect_referenced_names_expr(body, bound, out)\n    },\n    ESeq(l, r) => {\n      collect_referenced_names_expr(l, bound, out)\n      collect_referenced_names_expr(r, bound, out)\n    },\n    EMatch(scr, arms) => {\n      collect_referenced_names_expr(scr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, body) = Array::get(arms, i)\n        let mark = Array::length(bound)\n        labeled_walk_pat_binds(pat, bound)\n        collect_referenced_names_expr(body, bound, out)\n        Array::truncate(bound, mark)\n        i = i + 1\n      }\n    },\n    EHandle(body_expr, arms) => {\n      collect_referenced_names_expr(body_expr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, i)\n        let mark = Array::length(bound)\n        labeled_walk_pat_binds(pat, bound)\n        collect_referenced_names_expr(arm_body, bound, out)\n        Array::truncate(bound, mark)\n        i = i + 1\n      }\n    },\n    EWhile(cond, body) => {\n      collect_referenced_names_expr(cond, bound, out)\n      collect_referenced_names_expr(body, bound, out)\n    },\n    ELoop(params, body) => {\n      // Every init is evaluated against the OUTER scope (no loop var is\n      // visible to any init, including its own), then all loop vars come\n      // into scope together for `body`.\n      let mark = Array::length(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        collect_referenced_names_expr(init, bound, out)\n        i = i + 1\n      }\n      let mut j = 0\n      while j < Array::length(params) {\n        let (pname, _) = Array::get(params, j)\n        Array::push(bound, pname)\n        j = j + 1\n      }\n      collect_referenced_names_expr(body, bound, out)\n      Array::truncate(bound, mark)\n    },\n    EForIn(name, idx_opt, iter, body) => {\n      // #1205 Codex review: `for x, i in items { .. }` binds BOTH the item\n      // name and the optional index name as loop locals -- only pushing\n      // `name` let an import shadowed solely by the index (`i` above) keep\n      // reading as \"used\" via the body's own reference to its own index var.\n      collect_referenced_names_expr(iter, bound, out)\n      let mark = Array::length(bound)\n      Array::push(bound, name)\n      match idx_opt {\n        Some(idx) => Array::push(bound, idx),\n        None => ()\n      }\n      collect_referenced_names_expr(body, bound, out)\n      Array::truncate(bound, mark)\n    },\n    EFn(_, _, params, ret, _, body) => {\n      let mark = Array::length(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, pty) = Array::get(params, i)\n        collect_opt_texpr_ref_names(pty, out)\n        Array::push(bound, labeled_param_base_name(pname))\n        i = i + 1\n      }\n      collect_opt_texpr_ref_names(ret, out)\n      collect_referenced_names_expr(body, bound, out)\n      Array::truncate(bound, mark)\n    },\n    EDot(obj, _, _, _) => collect_referenced_names_expr(obj, bound, out),\n    ELabeledArg(_, _, e) => collect_referenced_names_expr(e, bound, out),\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_referenced_names_expr(val, bound, out)\n        i = i + 1\n      }\n    },\n    ESpread(e) => collect_referenced_names_expr(e, bound, out),\n    EStringInterp(_) => ()\n  }\n}\n\nfn collect_referenced_names_expr_top(expr: Expr, out: Array[String]) -> Unit {\n  collect_referenced_names_expr(expr, array_empty(), out)\n}\n\n/// Broader than check_stmts' own local hoist walks: every place a name from\n/// an `import`/`import @pkg @alias` could legitimately be referenced --\n/// value positions in every statement kind that carries an `Expr`, PLUS type\n/// positions in struct/enum/suberror field types, a type alias's own\n/// target, trait method signatures, extern-let/effect-op types, and\n/// (recursively) nested `SModule` bodies.\nfn collect_referenced_names_stmts(stmts: Array[Stmt], out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, ann, val) => {\n        collect_opt_texpr_ref_names(ann, out)\n        collect_referenced_names_expr_top(val, out)\n      },\n      SLetMut(_, ann, val) => {\n        collect_opt_texpr_ref_names(ann, out)\n        collect_referenced_names_expr_top(val, out)\n      },\n      SLetPat(_, val) => collect_referenced_names_expr_top(val, out),\n      SEnum(_, _, _, variants, _) => {\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (_, vtypes) = Array::get(variants, vi)\n          let mut ti = 0\n          while ti < Array::length(vtypes) {\n            collect_texpr_ref_names(Array::get(vtypes, ti), out)\n            ti = ti + 1\n          }\n          vi = vi + 1\n        }\n      },\n      SSuberror(_, _, variants) => {\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (_, vtypes) = Array::get(variants, vi)\n          let mut ti = 0\n          while ti < Array::length(vtypes) {\n            collect_texpr_ref_names(Array::get(vtypes, ti), out)\n            ti = ti + 1\n          }\n          vi = vi + 1\n        }\n      },\n      SStruct(_, _, fields, _, _, _) => {\n        let mut fi = 0\n        while fi < Array::length(fields) {\n          let (_, fty) = Array::get(fields, fi)\n          collect_texpr_ref_names(fty, out)\n          fi = fi + 1\n        }\n      },\n      STypeAlias(_, _, _, te) => collect_texpr_ref_names(te, out),\n      STrait(_, _, _, methods, _) => {\n        let mut mi = 0\n        while mi < Array::length(methods) {\n          let (_, ptypes, rty) = Array::get(methods, mi)\n          let mut pi = 0\n          while pi < Array::length(ptypes) {\n            collect_texpr_ref_names(Array::get(ptypes, pi), out)\n            pi = pi + 1\n          }\n          collect_texpr_ref_names(rty, out)\n          mi = mi + 1\n        }\n      },\n      SExternLet(_, te) => collect_texpr_ref_names(te, out),\n      SEffectDef(_, _, _, ops) => {\n        let mut oi = 0\n        while oi < Array::length(ops) {\n          let (_, ptypes, rty) = Array::get(ops, oi)\n          let mut pi = 0\n          while pi < Array::length(ptypes) {\n            collect_texpr_ref_names(Array::get(ptypes, pi), out)\n            pi = pi + 1\n          }\n          collect_texpr_ref_names(rty, out)\n          oi = oi + 1\n        }\n      },\n      STest(_, val) => collect_referenced_names_expr_top(val, out),\n      SBench(_, val) => collect_referenced_names_expr_top(val, out),\n      SExpr(val) => collect_referenced_names_expr_top(val, out),\n      SModule(_, _, body) => collect_referenced_names_stmts(body, out),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn unused_alias_referenced(used: Array[String], bare: String, qualified_prefix: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(used) {\n    let name = Array::get(used, i)\n    if name == bare || String::starts_with(name, qualified_prefix) {\n      found = true\n      i = Array::length(used)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// #1129: an `import ./f.vibe { a, b }` name (its local alias, or the\n/// original if unaliased) that is never referenced anywhere else in the\n/// SAME file, or an `import @pkg @alias` whose alias is never referenced\n/// (as `@alias`, or qualified `@alias::member`). Both are WARNING-level (not\n/// hard errors -- see the issue's own caution about the \"merge a package's\n/// exports whole-program with no local call site\" pattern): this only flags\n/// what is invisible to THIS file, and a caller relying on the\n/// whole-program merge lane is expected to judge each hit, not have the\n/// compile fail. Only reached after a clean type-check\n/// (collect_all_diagnostics only calls this on the success path), so the\n/// AST it sees already has #1001/#986's labeled-arg desugars and #760's\n/// Result-prelude injection applied -- neither touches import/alias\n/// statements, so this is inert either way.\nexport fn detect_unused_imports(stmts: Array[Stmt]) -> Array[(String, String, String)] {\n  let used = array_empty()\n  collect_referenced_names_stmts(stmts, used)\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(path, items) => {\n        let mut j = 0\n        while j < Array::length(items) {\n          let (orig, alias) = Array::get(items, j)\n          let local = match alias {\n            Some(a) => a,\n            None => orig\n          }\n          if warning_names_contains(used, local) {\n            ()\n          } else {\n            let msg = String::concat(\"imported name '\", String::concat(local, String::concat(\"' from '\", String::concat(path, \"' is never used in this file\"))))\n            Array::push(out, (\"unused_import\", local, msg))\n          }\n          j = j + 1\n        }\n      },\n      SAliasDecl(alias, path) => {\n        let qualified_prefix = String::concat(\"@\", String::concat(alias, \"::\"))\n        let bare = String::concat(\"@\", alias)\n        if unused_alias_referenced(used, bare, qualified_prefix) {\n          ()\n        } else {\n          let msg = String::concat(\"import alias '\", String::concat(bare, String::concat(\"' for '\", String::concat(path, \"' is never used in this file (referenced elsewhere in a whole-program merge? consider a named import instead)\"))))\n          Array::push(out, (\"unused_import\", alias, msg))\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n/// The offset of every `ESeq(left, _)` where `left` is itself an `ECall` --\n/// a bare call statement in the middle of a block whose result is thrown\n/// away. Recurses into every other expression shape so a discard nested\n/// inside an `if`/`match`/`while`/closure body etc. is still found; the\n/// match only special-cases `ESeq` because that is the ONLY shape where a\n/// value is silently dropped (a `let`/`let mut`/assignment BINDS its value\n/// by construction, so is never a discard site).\nfn collect_discard_call_offsets_expr(expr: Expr, out: Array[Int]) -> Unit {\n  match expr {\n    ESeq(left, right) => {\n      match left {\n        ECall(_, _, call_off) => if call_off >= 0 {\n          Array::push(out, call_off)\n        } else {\n          ()\n        },\n        _ => ()\n      }\n      collect_discard_call_offsets_expr(left, out)\n      collect_discard_call_offsets_expr(right, out)\n    },\n    EIf(cond, then_e, else_e) => {\n      collect_discard_call_offsets_expr(cond, out)\n      collect_discard_call_offsets_expr(then_e, out)\n      collect_discard_call_offsets_expr(else_e, out)\n    },\n    ELet(_, val, body, _) => {\n      collect_discard_call_offsets_expr(val, out)\n      collect_discard_call_offsets_expr(body, out)\n    },\n    ELetRec(_, val, body) => {\n      collect_discard_call_offsets_expr(val, out)\n      collect_discard_call_offsets_expr(body, out)\n    },\n    ELetMut(_, val, body, _) => {\n      collect_discard_call_offsets_expr(val, out)\n      collect_discard_call_offsets_expr(body, out)\n    },\n    EAssign(_, val, body) => {\n      collect_discard_call_offsets_expr(val, out)\n      collect_discard_call_offsets_expr(body, out)\n    },\n    EAssignOp(_, _, val, body) => {\n      collect_discard_call_offsets_expr(val, out)\n      collect_discard_call_offsets_expr(body, out)\n    },\n    EMatch(scr, arms) => {\n      collect_discard_call_offsets_expr(scr, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, body) = Array::get(arms, i)\n        collect_discard_call_offsets_expr(body, out)\n        i = i + 1\n      }\n    },\n    EHandle(body_expr, arms) => {\n      collect_discard_call_offsets_expr(body_expr, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, i)\n        collect_discard_call_offsets_expr(arm_body, out)\n        i = i + 1\n      }\n    },\n    EWhile(cond, body) => {\n      collect_discard_call_offsets_expr(cond, out)\n      collect_discard_call_offsets_expr(body, out)\n    },\n    ELoop(params, body) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        collect_discard_call_offsets_expr(init, out)\n        i = i + 1\n      }\n      collect_discard_call_offsets_expr(body, out)\n    },\n    EForIn(_, _, iter, body) => {\n      collect_discard_call_offsets_expr(iter, out)\n      collect_discard_call_offsets_expr(body, out)\n    },\n    ECall(callee, args, _) => {\n      collect_discard_call_offsets_expr(callee, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_discard_call_offsets_expr(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    EBinOp(_, l, r) => {\n      collect_discard_call_offsets_expr(l, out)\n      collect_discard_call_offsets_expr(r, out)\n    },\n    EUnaryOp(_, e) => collect_discard_call_offsets_expr(e, out),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_discard_call_offsets_expr(Array::get(items, i), out)\n        i = i + 1\n      }\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_discard_call_offsets_expr(Array::get(items, i), out)\n        i = i + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_discard_call_offsets_expr(val, out)\n        i = i + 1\n      }\n    },\n    EFn(_, _, _, _, _, body) => collect_discard_call_offsets_expr(body, out),\n    EDot(obj, _, _, _) => collect_discard_call_offsets_expr(obj, out),\n    ELabeledArg(_, _, e) => collect_discard_call_offsets_expr(e, out),\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_discard_call_offsets_expr(val, out)\n        i = i + 1\n      }\n    },\n    ESpread(e) => collect_discard_call_offsets_expr(e, out),\n    EReturn(e) => collect_discard_call_offsets_expr(e, out),\n    EBreak(opt) => match opt {\n      Some(e) => collect_discard_call_offsets_expr(e, out),\n      None => ()\n    },\n    EContinue(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_discard_call_offsets_expr(Array::get(items, i), out)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nfn collect_discard_call_offsets_stmts(stmts: Array[Stmt], out: Array[Int]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, val) => collect_discard_call_offsets_expr(val, out),\n      SLetMut(_, _, val) => collect_discard_call_offsets_expr(val, out),\n      SLetPat(_, val) => collect_discard_call_offsets_expr(val, out),\n      STest(_, val) => collect_discard_call_offsets_expr(val, out),\n      SBench(_, val) => collect_discard_call_offsets_expr(val, out),\n      SExpr(val) => collect_discard_call_offsets_expr(val, out),\n      SModule(_, _, body) => collect_discard_call_offsets_stmts(body, out),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn lookup_tytab_offset(tytab: Array[(Int, Type)], off: Int) -> Option[Type] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(tytab) {\n    let (o, t) = Array::get(tytab, i)\n    if o == off {\n      found = Some(t)\n      i = Array::length(tytab)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn discard_type_worth_warning(ty: Type) -> Bool {\n  match ty {\n    CtUnit => false,\n    CtUnknown => false,\n    CtVar(_) => false,\n    _ => true\n  }\n}\n\n/// The companion \"unbound non-Unit return value\" request: a bare call\n/// statement (`foo();` mid-block, not bound via `let`/`let _`) whose\n/// resolved return type is neither `Unit` nor still-polymorphic/unresolved.\n/// Scoped to CALL expressions specifically (not `if`/`match`/`while` used as\n/// a statement) because only `ECall` nodes get a `tytab` entry keyed by\n/// their own offset (checker.vibe's `tab_call_ty`) -- an `if`/`match` used\n/// for its side effects has no such entry to look up, so it is silently\n/// skipped rather than false-positiving. `let _ = foo()` is already how\n/// this codebase spells \"discard intentionally\" (see e.g.\n/// `annotation_return_type` above) and is unaffected: it is an `ELet`\n/// binding, never the left side of an `ESeq`, so it is never a candidate.\nexport fn detect_unbound_nonunit_returns(stmts: Array[Stmt], tytab: Array[(Int, Type)], final_s: Subst) -> Array[String] {\n  let offsets = array_empty()\n  collect_discard_call_offsets_stmts(stmts, offsets)\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(offsets) {\n    let off = Array::get(offsets, i)\n    match lookup_tytab_offset(tytab, off) {\n      Some(ty) => {\n        let resolved = subst_apply(final_s, ty)\n        if discard_type_worth_warning(resolved) {\n          let marker = labeled_name_marker(off, 0)\n          Array::push(out, String::concat(\"expression result of type `\", String::concat(type_to_string(resolved), String::concat(\"` is unused -- bind it (e.g. `let _ = ...`) if this is intentional\", marker))))\n        } else {\n          ()\n        }\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  out\n}\n")
}

let cli_adapter_source_57 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/index.vpkg",
"name = @vibe/compiler/checker\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/checker — ADR-0070 / #897 compiler-internal contract.\ndeps = {\n  @vibe/compiler/codegen : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/checker — ADR-0070 / #897 compiler-internal contract.\n// Directory-shared-scope package (20 files): the type checker's builtin\n// signature tables (builtins.vibe + 13 builtins_*.vibe lookup_* modules),\n// the core expression/statement checker (checker.vibe, checker_stmt.vibe),\n// pattern checking + exhaustiveness (checker_pattern.vibe,\n// checker_exhaustive.vibe), type-expr resolution (checker_resolve.vibe), and\n// the effect/mutability discipline passes (checker_effects.vibe — see\n// relocation note below). checker_facade.vibe (see naming note below)\n// re-exports a SUBSET of the surface (lookup_builtin, check_expr,\n// check_pattern, pat_has_unsupported_or_binding, resolve_type_expr,\n// check_program, check_program_type_table, check_program_with_env,\n// check_stmts) via the `export ./file.vibe { names }` SReExport form (#726);\n// every other name below is defined directly (`export fn`) in its own\n// sibling file and reaches outside importers purely through this package's\n// directory-shared scope + the facade generated from THIS contract (not\n// from checker_facade.vibe's own hand-written re-export list, which the\n// generated facade supersedes at ingestion time) — same shape as\n// codegen/expr's expr.vibe/core.vibe/support.vibe split.\n//\n// Naming-collision note: the established rename convention for this\n// migration batch is `git mv index.vibe <dirname>.vibe` (see\n// codegen/expr/expr.vibe, codegen/gc/gc.vibe, syntax/syntax.vibe). For this\n// directory the dirname is \"checker\", but `checker/checker.vibe` already\n// exists as a substantial (5.3k line) real implementation file — the core\n// expression checker, not a facade — so `git mv index.vibe checker.vibe`\n// would silently clobber it. `validate_index_layout_fs` also forbids\n// index.vibe and index.vpkg coexisting in the same directory (\"a boundary\n// has exactly one index\"), so leaving index.vibe in place unrenamed was not\n// an option either (loader/index.vibe::desugar_contract_source_fs). The old\n// index.vibe was therefore renamed to `checker_facade.vibe` instead —\n// non-colliding, and its content did not need any other change: directory\n// auto-discovery (`contract_sibling_impl_raws`) already reaches every other\n// sibling file regardless of what checker_facade.vibe itself re-exports, so\n// the facade file's existing partial re-export list stays correct as-is.\n//\n// checker_effects.vibe relocation note: this file used to live at\n// lib/@vibe/compiler/checker_effects.vibe (a sibling of the checker/\n// directory, not inside it) specifically so `checker/checker_stmt.vibe`\n// (which needs check_perform_effects_stmts_env etc. from it) could import it\n// as a \"#847 Phase C exception\" direct leaf import, deliberately bypassing\n// checker's own facade — routing that import through the facade would close\n// a real cycle (checker package -> checker_stmt.vibe -> checker_effects.vibe\n// -> checker package). Once checker/ became a real `index.vpkg` package\n// boundary, `enforce_incoming_boundary_fs` (#729) rejected that same direct\n// leaf import from OUTSIDE the package (\"cannot import ... across a package\n// boundary\"), since checker_effects.vibe itself was not a checker/ member —\n// and routing it through the package (the boundary-legal alternative)\n// reintroduced the exact cycle the leaf import had been added to avoid\n// (confirmed empirically: `type_db: import cycle detected at\n// checker/index.vpkg`). Moving checker_effects.vibe INTO checker/ resolves\n// both constraints at once: checker_stmt.vibe's own need for it becomes an\n// ordinary same-package sibling import (no facade indirection, no cycle),\n// and every outside consumer (entry/compiler/file_compile/file_compile.vibe,\n// several tests) now reaches its surface through this contract like any\n// other checker export. EffectError is declared transparently (bodyless,\n// no `opaque` keyword) rather than opaque, matching common_base's structs:\n// several tests pattern-match its constructors directly (e.g.\n// `EEEffectfulCallOutsideEffect(_) => true`), so the declaration only\n// attests name + arity while checker_effects.vibe's real enum definition\n// stays the single source of truth callers actually see.\n//\n// Compiled into the compiler itself via compiler_sources_manifest.tsv\n// (group `checker`): the old single `checker/index.vibe` row becomes a\n// dual row (this contract + checker_facade.vibe); the former top-level\n// `checker_effects.vibe` row is repointed to `checker/checker_effects.vibe`;\n// every other impl file in this directory already had its own manifest row\n// before this migration and is unchanged.\n\n// --- builtins.vibe\nfn lookup_builtin(name: String) -> Option[Type]\n\n// --- builtins_array.vibe\nfn lookup_array(name: String) -> Option[Type]\n\n// --- builtins_async.vibe\nfn lookup_async(name: String) -> Option[Type]\n\n// --- builtins_builders.vibe\nfn lookup_array_builder(name: String) -> Option[Type]\nfn lookup_string_builder(name: String) -> Option[Type]\n\n// --- builtins_bytes.vibe\nfn lookup_bytes(name: String) -> Option[Type]\n\n// --- builtins_fixed_array.vibe\nfn lookup_fixed_array(name: String) -> Option[Type]\n\n// --- builtins_frozen_array.vibe\nfn lookup_frozen_array(name: String) -> Option[Type]\n\n// --- builtins_fs.vibe\nfn lookup_fs(name: String) -> Option[Type]\n\n// --- builtins_map.vibe\nfn lookup_map(name: String) -> Option[Type]\n\n// --- builtins_misc.vibe\nfn lookup_misc(name: String) -> Option[Type]\n\n// --- builtins_net.vibe\nfn lookup_net(name: String) -> Option[Type]\n\n// --- builtins_simd.vibe\nfn lookup_simd(name: String) -> Option[Type]\n\n// --- builtins_string1.vibe\nfn lookup_string1(name: String) -> Option[Type]\n\n// --- builtins_string2.vibe\nfn lookup_string2(name: String) -> Option[Type]\n\n// --- builtins_system.vibe\nfn lookup_io(name: String) -> Option[Type]\n\n// --- checker.vibe\nfn check_assignable(expected: Type, actual: Type, s: Subst, errors: Array[String], what: String, off: Int) -> Subst\nfn detect_narrowed_generic_mismatch(expected: Type, actual: Type, s: Subst, errors: Array[String], what: String, off: Int) -> Subst\nfn preserve_generic_instantiation(resolved: Type, actual: Type) -> Type\nfn fn_return_env_name(name: String) -> String\nfn is_array_builder_ty(t: Type) -> Bool\nfn is_region_tagged_ty(t: Type) -> Bool\nfn pat_binds_resume(p: Pat) -> Bool\nfn reject_resume_outside_handler(e: Expr, sh: Bool, errors: Array[String]) -> Unit\nfn check_expr(expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> (Type, Subst, Int)\n\n// --- checker_exhaustive.vibe\nfn match_nonexhaustive_witness(scr_ty: Type, pats: Array[Pat], defs: Array[TypeDef]) -> Option[String]\n\n// --- checker_pattern.vibe\nfn pat_has_unsupported_or_binding(pat: Pat) -> Bool\nfn check_pattern(pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef], errors: Array[String]) -> TypeEnv\n\n// --- checker_resolve.vibe\nfn subst_type_params(ty: Type, params: Array[String], args: Array[Type]) -> Type\nfn resolve_type_expr(te: TypeExpr, defs: Array[TypeDef]) -> Type\n\n// --- checker_spawnable.vibe (#1081 step 3 Phase B)\nfn check_spawnable_captures(env: TypeEnv, s: Subst, defs: Array[TypeDef], f_expr: Expr, r_here: Type) -> Array[String]\nfn check_spawnable_mut_captures_stmts(stmts: Array[Stmt]) -> Array[String]\n\n// --- checker_stmt.vibe\nfn check_stmts(raw_stmts: Array[Stmt], i: Int, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String], tytab: Array[(Int, Type)]) -> (TypeEnv, Subst, Int)\nfn check_program(stmts: Array[Stmt]) -> TypeEnv with { Error }\nfn check_program_type_table(stmts: Array[Stmt]) -> (Array[(Int, Type)], Subst) with { Error }\nfn check_program_with_env(stmts: Array[Stmt], initial_env: TypeEnv) -> TypeEnv with { Error }\nfn detect_unused_imports(stmts: Array[Stmt]) -> Array[(String, String, String)]\nfn detect_unbound_nonunit_returns(stmts: Array[Stmt], tytab: Array[(Int, Type)], final_s: Subst) -> Array[String]\n\n// --- checker_trait.vibe (relocated here from compiler/ top level, #897\n// batch; used to live outside checker/ so checker_stmt.vibe's need for\n// register_builtin_traits was a #847-style direct leaf import bypassing the\n// facade -- once checker/ became a real index.vpkg package boundary,\n// enforce_incoming_boundary_fs rejected that leaf import from outside the\n// package, same class of fix as checker_effects.vibe's relocation above.\n// Its own former `./types.vibe` import (a top-level re-export shim of\n// core/'s own types, deleted in this same batch -- see core/'s Subst,\n// Type, TypeEnv, impls_overlap_for, trait_defined, type_implements_trait)\n// is now a direct `../core` import.\nfn satisfies_bound(env: TypeEnv, s: Subst, ty: Type, bound: String) -> Bool\nfn send_subst_vars(ty: Type, vids: Array[Int], args: Array[Type]) -> Type\nfn type_send_ok(env: TypeEnv, s: Subst, defs: Array[TypeDef], ty: Type) -> Bool\nfn check_bounds_satisfied(env: TypeEnv, s: Subst, ty: Type, bounds: Array[String]) -> Array[String]\nfn register_builtin_traits(env: TypeEnv) -> TypeEnv\nfn validate_supers_defined(env: TypeEnv, supers: Array[String]) -> Array[String]\nfn validate_impl_no_overlap(env: TypeEnv, trait_name: String, target: Type) -> Bool\n\n// --- checker_effects.vibe (relocated here, see header note above)\ntype EffectError\nfn set_error_row_checked(on: Bool) -> Unit\nfn effect_error_to_string(err: EffectError) -> String\nfn check_async_effects_expr(expr: Expr, env: TypeEnv, in_async: Bool) -> Array[EffectError]\nfn check_async_effects_stmt(stmt: Stmt, env: TypeEnv) -> Array[EffectError]\nfn check_async_effects_stmts(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError]\nfn check_perform_effects_expr_tx(root: Expr, root_declared: Array[String], root_in_handle: Bool, fn_names: Array[String], fn_effs: Array[Array[String]], root_ov_names: Array[String], root_ov_effs: Array[Array[String]]) -> Array[EffectError]\nfn check_perform_effects_expr(root: Expr, root_declared: Array[String], root_in_handle: Bool) -> Array[EffectError]\nfn check_perform_effects_stmt(stmt: Stmt) -> Array[EffectError]\nfn check_perform_effects_stmts(stmts: Array[Stmt]) -> Array[EffectError]\nfn check_perform_effects_stmts_env(stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError]\nfn file_tests_cacheable(stmts: Array[Stmt]) -> Bool\nfn file_entry_cacheable(stmts: Array[Stmt], entry_name: String) -> Bool\nfn check_mutability_expr(expr: Expr, mutable: Array[String]) -> Array[EffectError]\nfn check_mutability_stmts(stmts: Array[Stmt]) -> Array[EffectError]\n")
}

let cli_adapter_source_58 = () -> (String, String) {
  ("lib/@vibe/compiler/checker/checker_facade.vibe",
"//# Imports\n\n// Pure re-export facade. (This file used to ALSO import check_* and then\n// re-declare everything in bare `export { ... }` blocks; a bare export of a\n// name with no local def resolves to \"undefined variable (local)\" under the\n// FS merge — the flat bundle's first-match hid it. #726.)\n\nexport ./builtins.vibe {\n  lookup_builtin\n}\n\nexport ./checker.vibe {\n  check_expr\n}\n\nexport ./checker_pattern.vibe {\n  check_pattern, pat_has_unsupported_or_binding\n}\n\nexport ./checker_resolve.vibe {\n  resolve_type_expr\n}\n\nexport ./checker_stmt.vibe {\n  check_program, check_program_type_table, check_program_with_env, check_stmts\n}\n")
}

let cli_adapter_source_59 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/builtin_name.vibe",
"//# Functions\n\nexport fn canonical_builtin_name(name: String) -> String {\n  match name {\n    \"Fs::ReadFile\" => \"Fs::read_file\",\n    \"Fs::WriteFile\" => \"Fs::write_file\",\n    \"Fs::ReadBytes\" => \"Fs::read_bytes\",\n    \"Fs::WriteBytes\" => \"Fs::write_bytes\",\n    \"Fs::Exists\" => \"Fs::exists\",\n    \"Fs::StatToken\" => \"Fs::stat_token\",\n    \"Fs::ReadDir\" => \"Fs::readdir\",\n    \"Fs::IsDir\" => \"Fs::is_dir\",\n    \"Fs::IsFile\" => \"Fs::is_file\",\n    \"Fs::Mkdir\" => \"Fs::mkdir\",\n    \"Fs::MkdirP\" => \"Fs::mkdir_p\",\n    \"Fs::Getcwd\" => \"Fs::getcwd\",\n    \"Fs::Chdir\" => \"Fs::chdir\",\n    \"Fs::Remove\" => \"Fs::remove\",\n    \"Fs::Copy\" => \"Fs::copy\",\n    \"Fs::Append\" => \"Fs::append\",\n    \"Fs::Rename\" => \"Fs::rename\",\n    \"Env::Get\" => \"Env::get\",\n    \"Env::ArgsLen\" => \"Env::args_len\",\n    \"Env::ArgsGet\" => \"Env::args_get\",\n    \"Profiler::NowUs\" => \"Profiler::now_us\",\n    \"Profiler::HeapBytes\" => \"Profiler::heap_bytes\",\n    _ => name\n  }\n}\n")
}

let cli_adapter_source_60 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/index.vpkg",
"name = @vibe/compiler/codegen/wasm_emit\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/codegen/wasm_emit — ADR-0070 / #897 compiler-internal contract.\ndeps = {\n  @vibe/compiler/core : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/codegen/wasm_emit — ADR-0070 / #897 compiler-internal contract.\n// Directory-shared-scope package: wasm_emit.vibe (facade, re-exports the bulk\n// of the surface via sections.vibe/instructions.vibe/builders.vibe/simd.vibe/\n// simd_patterns.vibe) plus the directory's other members that the facade\n// re-export chain passes through or that carry their own top-level exports\n// not surfaced by the facade: sections.vibe -> base.vibe -> {code_helpers.vibe,\n// header_types.vibe -> {header_core.vibe -> {header_magic.vibe,\n// header_type_sections.vibe}, header_exports.vibe}} (pure re-export shims,\n// no signatures of their own) and extra.vibe / metadata.vibe (leaf\n// definitions reached only via the sections.vibe re-export chain). Every\n// top-level `export fn` across every file in this directory is declared\n// below, per the directory-membership rule (not just wasm_emit.vibe's own\n// re-exports) — including emit_simd_skip_whitespace_16 /\n// emit_simd_is_identifier_char_16 in simd_patterns.vibe, which are directory\n// members but are NOT re-exported through the facade.\n\n// -- code_helpers.vibe (via base.vibe <- sections.vibe) --\nfn emit_end(buf: Bytes) -> Unit\nfn emit_i32_const(buf: Bytes, value: Int) -> Unit\nfn emit_code_section(out: Bytes, bodies: Array[Bytes]) -> Unit\nfn emit_memory_section(out: Bytes, min_pages: Int) -> Unit\nfn emit_code_section_with_locals(out: Bytes, bodies: Array[Bytes], local_counts: Array[Int]) -> Unit\n\n// -- header_magic.vibe (via header_core.vibe <- header_types.vibe <- base.vibe <- sections.vibe) --\nfn emit_header(buf: Bytes) -> Unit\n\n// -- header_type_sections.vibe (via header_core.vibe <- header_types.vibe <- base.vibe <- sections.vibe) --\nfn emit_func_type(buf: Bytes, param_count: Int, result_count: Int) -> Unit\nfn emit_type_section_multi(out: Bytes, type_defs: Array[Int]) -> Unit\nfn emit_type_section(out: Bytes, param_count: Int, result_count: Int) -> Unit\n\n// -- header_exports.vibe (via header_types.vibe <- base.vibe <- sections.vibe) --\nfn emit_name(buf: Bytes, name: String) -> Unit\nfn emit_function_section(out: Bytes, type_indices: Array[Int]) -> Unit\nfn emit_export_section_multi(out: Bytes, names: Array[String], func_indices: Array[Int]) -> Unit\nfn emit_export_section(out: Bytes, name: String, func_idx: Int) -> Unit\n\n// -- extra.vibe (via sections.vibe) --\nfn emit_global_get(buf: Bytes, idx: Int) -> Unit\nfn emit_heap_memory_grow_check(buf: Bytes) -> Unit\nfn emit_global_set(buf: Bytes, idx: Int) -> Unit\nfn emit_data_section(out: Bytes, offset: Int, data: Bytes) -> Unit\nfn emit_exports_full(out: Bytes, fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int, global_names: Array[String], global_indices: Array[Int]) -> Unit\nfn emit_export_memory(out: Bytes, name: String, mem_idx: Int) -> Unit\nfn emit_func_type_raw(buf: Bytes, param_types: Array[Int], result_types: Array[Int]) -> Unit\nfn emit_exports_with_memory(out: Bytes, fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int) -> Unit\nfn emit_import_section_func(out: Bytes, module_name: String, field_name: String, type_idx: Int) -> Unit\nfn emit_global_section_i32_mut(out: Bytes, init_value: Int) -> Unit\n\n// -- metadata.vibe (via sections.vibe) --\nfn emit_function_name_section(out: Bytes, names: Array[String], base_index: Int) -> Unit\nfn emit_vibe_abi_custom_section(out: Bytes, host_import_abi: String) -> Unit\n\n// -- instructions.vibe (direct facade re-export) --\nfn emit_local_get(buf: Bytes, idx: Int) -> Unit\nfn emit_local_set(buf: Bytes, idx: Int) -> Unit\nfn emit_local_tee(buf: Bytes, idx: Int) -> Unit\nfn emit_i64_const(buf: Bytes, value: Int) -> Unit\nfn emit_i64_add(buf: Bytes) -> Unit\nfn emit_i64_sub(buf: Bytes) -> Unit\nfn emit_i64_mul(buf: Bytes) -> Unit\nfn emit_i64_div_s(buf: Bytes) -> Unit\nfn emit_i64_rem_s(buf: Bytes) -> Unit\nfn emit_i64_and(buf: Bytes) -> Unit\nfn emit_i64_or(buf: Bytes) -> Unit\nfn emit_i64_xor(buf: Bytes) -> Unit\nfn emit_i64_shl(buf: Bytes) -> Unit\nfn emit_i64_shr_s(buf: Bytes) -> Unit\nfn emit_i64_eq(buf: Bytes) -> Unit\nfn emit_i64_ne(buf: Bytes) -> Unit\nfn emit_i64_lt_s(buf: Bytes) -> Unit\nfn emit_i64_gt_s(buf: Bytes) -> Unit\nfn emit_i64_le_s(buf: Bytes) -> Unit\nfn emit_i64_ge_s(buf: Bytes) -> Unit\nfn emit_i64_eqz(buf: Bytes) -> Unit\nfn emit_call(buf: Bytes, func_idx: Int) -> Unit\nfn emit_drop(buf: Bytes) -> Unit\nfn emit_return(buf: Bytes) -> Unit\nfn emit_block_void(buf: Bytes) -> Unit\nfn emit_block_i64(buf: Bytes) -> Unit\nfn emit_loop_void(buf: Bytes) -> Unit\nfn emit_if_void(buf: Bytes) -> Unit\nfn emit_if_i64(buf: Bytes) -> Unit\nfn emit_else(buf: Bytes) -> Unit\nfn emit_br(buf: Bytes, label: Int) -> Unit\nfn emit_br_if(buf: Bytes, label: Int) -> Unit\nfn emit_i64_extend_i32_s(buf: Bytes) -> Unit\nfn emit_i32_wrap_i64(buf: Bytes) -> Unit\nfn emit_i32_add(buf: Bytes) -> Unit\nfn emit_i32_and(buf: Bytes) -> Unit\nfn emit_i32_eq(buf: Bytes) -> Unit\nfn emit_i32_ne(buf: Bytes) -> Unit\nfn emit_i32_sub(buf: Bytes) -> Unit\nfn emit_i32_gt_u(buf: Bytes) -> Unit\nfn emit_i32_eqz(buf: Bytes) -> Unit\nfn emit_i32_shr_u(buf: Bytes) -> Unit\nfn emit_i32_store(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_i64_store(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_i32_load(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_i32_store8(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_i32_load8_u(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_f64_const_bits(buf: Bytes, bits: Int) -> Unit\nfn emit_f64_const_lohi(buf: Bytes, lo: Int, hi: Int) -> Unit\nfn emit_f64_add(buf: Bytes) -> Unit\nfn emit_f64_sub(buf: Bytes) -> Unit\nfn emit_f64_mul(buf: Bytes) -> Unit\nfn emit_f64_div(buf: Bytes) -> Unit\nfn emit_f64_eq(buf: Bytes) -> Unit\nfn emit_f64_ne(buf: Bytes) -> Unit\nfn emit_f64_lt(buf: Bytes) -> Unit\nfn emit_f64_gt(buf: Bytes) -> Unit\nfn emit_f64_le(buf: Bytes) -> Unit\nfn emit_f64_ge(buf: Bytes) -> Unit\nfn emit_f64_neg(buf: Bytes) -> Unit\nfn emit_f64_abs(buf: Bytes) -> Unit\nfn emit_f64_ceil(buf: Bytes) -> Unit\nfn emit_f64_floor(buf: Bytes) -> Unit\nfn emit_f64_max(buf: Bytes) -> Unit\nfn emit_f64_min(buf: Bytes) -> Unit\nfn emit_i64_reinterpret_f64(buf: Bytes) -> Unit\nfn emit_f64_reinterpret_i64(buf: Bytes) -> Unit\nfn emit_i64_trunc_f64_s(buf: Bytes) -> Unit\nfn emit_f64_convert_i64_s(buf: Bytes) -> Unit\nfn emit_call_indirect(buf: Bytes, type_idx: Int) -> Unit\nfn emit_table_section_funcref(out: Bytes, num_entries: Int) -> Unit\nfn emit_element_section_active(out: Bytes, func_indices: Array[Int]) -> Unit\nfn emit_element_section_active_runs(out: Bytes, slots: Array[Int], func_indices: Array[Int]) -> Unit\nfn emit_struct_type_raw(buf: Bytes, field_types: Array[Int], field_muts: Array[Int]) -> Unit\nfn emit_struct_new(buf: Bytes, type_idx: Int) -> Unit\nfn emit_struct_get(buf: Bytes, type_idx: Int, field_idx: Int) -> Unit\nfn emit_struct_set(buf: Bytes, type_idx: Int, field_idx: Int) -> Unit\nfn emit_ref_func(buf: Bytes, func_idx: Int) -> Unit\nfn emit_call_ref(buf: Bytes, type_idx: Int) -> Unit\nfn emit_ref_null(buf: Bytes, heap_type_byte: Int) -> Unit\n\n// -- builders.vibe (direct facade re-export) --\nfn build_add_module() -> Bytes\nfn build_call_module() -> Bytes\nfn build_arithmetic_module() -> Bytes\nfn build_fibonacci_module() -> Bytes\nfn build_factorial_module() -> Bytes\nfn build_hello_module() -> Bytes\nfn string_to_data(s: String) -> Bytes\nfn emit_data_section_multi(out: Bytes, offsets: Array[Int], datas: Array[Bytes]) -> Unit\nfn build_print_string_module(msg: String) -> Bytes\n\n// -- simd.vibe (direct facade re-export) --\nfn emit_v128_load(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_v128_store(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_i8x16_splat(buf: Bytes) -> Unit\nfn emit_i8x16_eq(buf: Bytes) -> Unit\nfn emit_i8x16_le_u(buf: Bytes) -> Unit\nfn emit_i8x16_ge_u(buf: Bytes) -> Unit\nfn emit_i8x16_swizzle(buf: Bytes) -> Unit\nfn emit_i8x16_sub(buf: Bytes) -> Unit\nfn emit_i8x16_min_u(buf: Bytes) -> Unit\nfn emit_v128_any_true(buf: Bytes) -> Unit\nfn emit_i8x16_all_true(buf: Bytes) -> Unit\nfn emit_i8x16_bitmask(buf: Bytes) -> Unit\nfn emit_v128_and(buf: Bytes) -> Unit\nfn emit_v128_or(buf: Bytes) -> Unit\nfn emit_v128_not(buf: Bytes) -> Unit\nfn emit_v128_const(buf: Bytes, lanes: Array[Int]) -> Unit\nfn emit_v128_const_zero(buf: Bytes) -> Unit\nfn emit_v128_const_splat_byte(buf: Bytes, byte_val: Int) -> Unit\n\n// -- simd_patterns.vibe (facade re-export: emit_simd_memcmp_16,\n// emit_simd_find_byte_16, emit_scalar_memcmp_16_unrolled,\n// emit_scalar_find_byte_16_unrolled; directory-member-only, NOT re-exported\n// through wasm_emit.vibe: emit_simd_skip_whitespace_16,\n// emit_simd_is_identifier_char_16) --\nfn emit_simd_memcmp_16(buf: Bytes) -> Unit\nfn emit_simd_find_byte_16(buf: Bytes) -> Unit\nfn emit_simd_skip_whitespace_16(buf: Bytes) -> Unit\nfn emit_simd_is_identifier_char_16(buf: Bytes) -> Unit\nfn emit_scalar_memcmp_16_unrolled(buf: Bytes) -> Unit\nfn emit_scalar_find_byte_16_unrolled(buf: Bytes) -> Unit\n")
