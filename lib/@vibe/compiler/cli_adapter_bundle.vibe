let cli_adapter_source_61 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/metadata.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_string, leb128_encode_u32\n}\n\n//# Functions\n\n// Emit the standard WebAssembly \"name\" custom section with a function-names\n// subsection (id 1) naming `count` consecutive functions starting at\n// `base_index`. Custom sections are ignored at execution time, so this only\n// improves tooling/trace readability (e.g. wasm backtraces show `main` instead\n// of `<wasm function N>`). This is debugger P0 groundwork (ADR-0035 /\n// docs/release-roadmap.md テーマ3): a source-line map can be layered on later.\nexport fn emit_function_name_section(out: Bytes, names: Array[String], base_index: Int) -> Unit {\n  let count = Array::length(names)\n  if count == 0 {\n    ()\n  } else {\n    let content = bytebuf_new()\n    bytebuf_push_string(content, \"name\")\n    // function-names subsection: vec of (funcidx, name), funcidx ascending.\n    let namemap = bytebuf_new()\n    leb128_encode_u32(namemap, count)\n    let mut i = 0\n    while i < count {\n      leb128_encode_u32(namemap, base_index + i)\n      bytebuf_push_string(namemap, Array::get(names, i))\n      i = i + 1\n    }\n    bytebuf_push_section(content, 1, namemap)\n    bytebuf_push_section(out, 0, content)\n  }\n}\n\nfn emit_ascii_payload(buf: Bytes, text: String) -> Unit {\n  let len = String::length(text)\n  let mut i = 0\n  while i < len {\n    bytebuf_push(buf, String::char_code_at(text, i))\n    i = i + 1\n  }\n}\n\nexport fn emit_vibe_abi_custom_section(out: Bytes, host_import_abi: String) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_string(content, \"vibe.abi\")\n  emit_ascii_payload(content, \"version=1\\n\")\n  emit_ascii_payload(content, String::concat(\"host_import_abi=\", host_import_abi))\n  emit_ascii_payload(content, \"\\n\")\n  bytebuf_push_section(out, 0, content)\n}\n")
}

