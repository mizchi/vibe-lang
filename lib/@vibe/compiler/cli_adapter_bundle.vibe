let cli_adapter_source_104 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/inline_wat.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  bytebuf_new, bytebuf_push, bytebuf_push_buf, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# Functions\n\n// #805 inline wasm: a small WAT-body assembler for the linear backend's\n// `fn f(a: Int, b: Int) -> Int = wasm \"(i64.add (local.get $a) (local.get $b))\"`\n// form. Compiles the body TEXT of one function to raw instruction bytes\n// (no locals-declaration header, no trailing 0x0B end opcode — exactly the\n// `bodies` convention of linked_compile.vibe's code-section builder, which\n// adds both).\n//\n// Why not reuse lib/@vibex/wasm/wat_encoder? Three reasons, each fatal for\n// this use (see ADR-0072):\n//   1. wat_encoder has NO SIMD (0xFD prefix) support at all — a headline\n//      motivation for inline wasm (roadmap item 7) — so it would need\n//      extension anyway.\n//   2. its body walker emits folded S-expressions in PREFIX order (the\n//      operator before its operands), which mis-orders the canonical\n//      `(i64.add (local.get $a) (local.get $b))` spelling. This assembler\n//      implements real folded-form semantics (operands first).\n//   3. it silently resolves unknown instruction/local names to index 0 with\n//      no error channel; inline wasm needs located compile errors.\n// Pulling the 2.8k-line package into the compiler dependency closure (and\n// its source into the seed-compiled bundle) for a subset we would then have\n// to patch was strictly worse than this ~600-line purpose-built assembler.\n//\n// Supported subset (v0.3 slice, documented in docs/cheatsheet.md):\n//   - folded S-expressions AND flat instruction sequences; structured\n//     control (block/loop/if) is folded-form ONLY\n//   - `(block $l (result i64) ...)`, `(loop $l ...)`,\n//     `(if (result T)? <cond> (then ...) (else ...)?)`, br / br_if with\n//     `$label` or numeric relative depth; return/unreachable/nop/drop/select\n//   - local.get / local.set / local.tee over the fn's own params\n//     (`$paramname` or numeric index); NO `(local ...)` declarations\n//   - i32/i64 const (decimal / hex / `_` separators; vibe Int range only),\n//     full i32/i64 integer arithmetic / compare / shift / rotate /\n//     conversion set, f32/f64 arithmetic + compares (no f32/f64.const)\n//   - memory loads/stores with optional `offset=` / `align=` (align in\n//     bytes, spec-style), memory.size / memory.grow\n//   - SIMD (0xFD): v128.load/store, v128.const, splat / extract_lane /\n//     replace_lane, integer lane arithmetic + compares, bitwise, all_true /\n//     any_true / bitmask, swizzle, shifts\n//   - NOT supported (clear errors): call / call_indirect / br_table /\n//     global.get/set / f32.const / f64.const / (local ...) declarations\n\nfn iw_err(fn_name: String, msg: String, off: Int) -> String {\n  \"inline wasm (fn \\{fn_name}): \\{msg} (WAT offset \\{off})\"\n}\n\nfn iw_fresh_ints() -> Array[Int] {\n  array_empty()\n}\n\nfn iw_fresh_strings() -> Array[String] {\n  array_empty()\n}\n\nfn iw_is_space(c: Int) -> Bool {\n  c == 32 || c == 9 || c == 10 || c == 13\n}\n\n/// Token kinds: 1 = '(', 2 = ')', 3 = word. Words end at whitespace, parens\n/// or ';'. Comments: `;; ...` to end of line, `(; ... ;)` (non-nested).\nfn iw_tokenize(fn_name: String, src: String) -> (Array[Int], Array[String], Array[Int]) with { Error } {\n  let kinds = iw_fresh_ints()\n  let texts = iw_fresh_strings()\n  let offs = iw_fresh_ints()\n  let n = String::length(src)\n  let mut i = 0\n  while i < n {\n    let c = String::char_code_at(src, i)\n    if iw_is_space(c) {\n      i = i + 1\n    } else if c == 59 {\n      // ';' — only meaningful as ';;' line comment\n      if i + 1 < n && String::char_code_at(src, i + 1) == 59 {\n        while i < n && String::char_code_at(src, i) != 10 {\n          i = i + 1\n        }\n      } else {\n        throw(iw_err(fn_name, \"stray ';' (use ';;' line comments)\", i))\n      }\n    } else if c == 40 {\n      // '(' — possibly a '(;' block comment\n      if i + 1 < n && String::char_code_at(src, i + 1) == 59 {\n        let mut j = i + 2\n        let mut closed = false\n        while j + 1 < n && !closed {\n          if String::char_code_at(src, j) == 59 && String::char_code_at(src, j + 1) == 41 {\n            closed = true\n          } else {\n            j = j + 1\n          }\n        }\n        if !closed {\n          throw(iw_err(fn_name, \"unterminated '(;' block comment\", i))\n        } else {\n          ()\n        }\n        i = j + 2\n      } else {\n        Array::push(kinds, 1)\n        Array::push(texts, \"\")\n        Array::push(offs, i)\n        i = i + 1\n      }\n    } else if c == 41 {\n      Array::push(kinds, 2)\n      Array::push(texts, \"\")\n      Array::push(offs, i)\n      i = i + 1\n    } else {\n      let start = i\n      let mut j = i\n      let mut stop = false\n      while j < n && !stop {\n        let wc = String::char_code_at(src, j)\n        if iw_is_space(wc) || wc == 40 || wc == 41 || wc == 59 {\n          stop = true\n        } else {\n          j = j + 1\n        }\n      }\n      Array::push(kinds, 3)\n      Array::push(texts, String::substring(src, start, j))\n      Array::push(offs, start)\n      i = j\n    }\n  }\n  (kinds, texts, offs)\n}\n\n/// Integer immediates: decimal / 0x-hex, optional leading '-', '_' separators.\nfn iw_parse_int(fn_name: String, s: String, off: Int) -> Int with { Error } {\n  let n = String::length(s)\n  let mut i = 0\n  let mut neg = false\n  if i < n && String::char_code_at(s, i) == '-' {\n    neg = true\n    i = i + 1\n  } else {\n    ()\n  }\n  let mut hex = false\n  if i + 1 < n && String::char_code_at(s, i) == '0' {\n    let x = String::char_code_at(s, i + 1)\n    if x == 'x' || x == 'X' {\n      hex = true\n      i = i + 2\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n  let mut v = 0\n  let mut any = false\n  while i < n {\n    let c = String::char_code_at(s, i)\n    if c == '_' {\n      i = i + 1\n    } else if hex {\n      let d = if c >= '0' && c <= '9' {\n        c - '0'\n      } else if c >= 'a' && c <= 'f' {\n        c - 'a' + 10\n      } else if c >= 'A' && c <= 'F' {\n        c - 'A' + 10\n      } else {\n        0 - 1\n      }\n      if d < 0 {\n        throw(iw_err(fn_name, \"invalid integer literal '\\{s}'\", off))\n      } else {\n        ()\n      }\n      v = v * 16 + d\n      any = true\n      i = i + 1\n    } else {\n      if c >= '0' && c <= '9' {\n        v = v * 10 + (c - '0')\n        any = true\n        i = i + 1\n      } else {\n        throw(iw_err(fn_name, \"invalid integer literal '\\{s}'\", off))\n      }\n    }\n  }\n  if !any {\n    throw(iw_err(fn_name, \"invalid integer literal '\\{s}'\", off))\n  } else {\n    ()\n  }\n  if neg {\n    0 - v\n  } else {\n    v\n  }\n}\n\n/// Core single-byte opcodes with NO immediates.\nfn iw_core_table() -> Array[(String, Int)] {\n  [\n    (\"unreachable\", 0x00),\n    (\"nop\", 0x01),\n    (\"return\", 0x0F),\n    (\"drop\", 0x1A),\n    (\"select\", 0x1B),\n    (\"i32.eqz\", 0x45),\n    (\"i32.eq\", 0x46),\n    (\"i32.ne\", 0x47),\n    (\"i32.lt_s\", 0x48),\n    (\"i32.lt_u\", 0x49),\n    (\"i32.gt_s\", 0x4A),\n    (\"i32.gt_u\", 0x4B),\n    (\"i32.le_s\", 0x4C),\n    (\"i32.le_u\", 0x4D),\n    (\"i32.ge_s\", 0x4E),\n    (\"i32.ge_u\", 0x4F),\n    (\"i64.eqz\", 0x50),\n    (\"i64.eq\", 0x51),\n    (\"i64.ne\", 0x52),\n    (\"i64.lt_s\", 0x53),\n    (\"i64.lt_u\", 0x54),\n    (\"i64.gt_s\", 0x55),\n    (\"i64.gt_u\", 0x56),\n    (\"i64.le_s\", 0x57),\n    (\"i64.le_u\", 0x58),\n    (\"i64.ge_s\", 0x59),\n    (\"i64.ge_u\", 0x5A),\n    (\"f32.eq\", 0x5B),\n    (\"f32.ne\", 0x5C),\n    (\"f32.lt\", 0x5D),\n    (\"f32.gt\", 0x5E),\n    (\"f32.le\", 0x5F),\n    (\"f32.ge\", 0x60),\n    (\"f64.eq\", 0x61),\n    (\"f64.ne\", 0x62),\n    (\"f64.lt\", 0x63),\n    (\"f64.gt\", 0x64),\n    (\"f64.le\", 0x65),\n    (\"f64.ge\", 0x66),\n    (\"i32.clz\", 0x67),\n    (\"i32.ctz\", 0x68),\n    (\"i32.popcnt\", 0x69),\n    (\"i32.add\", 0x6A),\n    (\"i32.sub\", 0x6B),\n    (\"i32.mul\", 0x6C),\n    (\"i32.div_s\", 0x6D),\n    (\"i32.div_u\", 0x6E),\n    (\"i32.rem_s\", 0x6F),\n    (\"i32.rem_u\", 0x70),\n    (\"i32.and\", 0x71),\n    (\"i32.or\", 0x72),\n    (\"i32.xor\", 0x73),\n    (\"i32.shl\", 0x74),\n    (\"i32.shr_s\", 0x75),\n    (\"i32.shr_u\", 0x76),\n    (\"i32.rotl\", 0x77),\n    (\"i32.rotr\", 0x78),\n    (\"i64.clz\", 0x79),\n    (\"i64.ctz\", 0x7A),\n    (\"i64.popcnt\", 0x7B),\n    (\"i64.add\", 0x7C),\n    (\"i64.sub\", 0x7D),\n    (\"i64.mul\", 0x7E),\n    (\"i64.div_s\", 0x7F),\n    (\"i64.div_u\", 0x80),\n    (\"i64.rem_s\", 0x81),\n    (\"i64.rem_u\", 0x82),\n    (\"i64.and\", 0x83),\n    (\"i64.or\", 0x84),\n    (\"i64.xor\", 0x85),\n    (\"i64.shl\", 0x86),\n    (\"i64.shr_s\", 0x87),\n    (\"i64.shr_u\", 0x88),\n    (\"i64.rotl\", 0x89),\n    (\"i64.rotr\", 0x8A),\n    (\"f32.abs\", 0x8B),\n    (\"f32.neg\", 0x8C),\n    (\"f32.ceil\", 0x8D),\n    (\"f32.floor\", 0x8E),\n    (\"f32.trunc\", 0x8F),\n    (\"f32.nearest\", 0x90),\n    (\"f32.sqrt\", 0x91),\n    (\"f32.add\", 0x92),\n    (\"f32.sub\", 0x93),\n    (\"f32.mul\", 0x94),\n    (\"f32.div\", 0x95),\n    (\"f32.min\", 0x96),\n    (\"f32.max\", 0x97),\n    (\"f32.copysign\", 0x98),\n    (\"f64.abs\", 0x99),\n    (\"f64.neg\", 0x9A),\n    (\"f64.ceil\", 0x9B),\n    (\"f64.floor\", 0x9C),\n    (\"f64.trunc\", 0x9D),\n    (\"f64.nearest\", 0x9E),\n    (\"f64.sqrt\", 0x9F),\n    (\"f64.add\", 0xA0),\n    (\"f64.sub\", 0xA1),\n    (\"f64.mul\", 0xA2),\n    (\"f64.div\", 0xA3),\n    (\"f64.min\", 0xA4),\n    (\"f64.max\", 0xA5),\n    (\"f64.copysign\", 0xA6),\n    (\"i32.wrap_i64\", 0xA7),\n    (\"i32.trunc_f32_s\", 0xA8),\n    (\"i32.trunc_f32_u\", 0xA9),\n    (\"i32.trunc_f64_s\", 0xAA),\n    (\"i32.trunc_f64_u\", 0xAB),\n    (\"i64.extend_i32_s\", 0xAC),\n    (\"i64.extend_i32_u\", 0xAD),\n    (\"i64.trunc_f32_s\", 0xAE),\n    (\"i64.trunc_f32_u\", 0xAF),\n    (\"i64.trunc_f64_s\", 0xB0),\n    (\"i64.trunc_f64_u\", 0xB1),\n    (\"f32.convert_i32_s\", 0xB2),\n    (\"f32.convert_i32_u\", 0xB3),\n    (\"f32.convert_i64_s\", 0xB4),\n    (\"f32.convert_i64_u\", 0xB5),\n    (\"f32.demote_f64\", 0xB6),\n    (\"f64.convert_i32_s\", 0xB7),\n    (\"f64.convert_i32_u\", 0xB8),\n    (\"f64.convert_i64_s\", 0xB9),\n    (\"f64.convert_i64_u\", 0xBA),\n    (\"f64.promote_f32\", 0xBB),\n    (\"i32.reinterpret_f32\", 0xBC),\n    (\"i64.reinterpret_f64\", 0xBD),\n    (\"f32.reinterpret_i32\", 0xBE),\n    (\"f64.reinterpret_i64\", 0xBF),\n    (\"i32.extend8_s\", 0xC0),\n    (\"i32.extend16_s\", 0xC1),\n    (\"i64.extend8_s\", 0xC2),\n    (\"i64.extend16_s\", 0xC3),\n    (\"i64.extend32_s\", 0xC4)\n  ]\n}\n\n/// SIMD (0xFD-prefixed) sub-opcodes with NO immediates. Sub-opcode values are\n/// the wasm spec's; the handful the codegen already emits (wasm_emit/simd.vibe)\n/// agree with these entries.\nfn iw_simd_table() -> Array[(String, Int)] {\n  [\n    (\"i8x16.swizzle\", 14),\n    (\"i8x16.splat\", 15),\n    (\"i16x8.splat\", 16),\n    (\"i32x4.splat\", 17),\n    (\"i64x2.splat\", 18),\n    (\"f32x4.splat\", 19),\n    (\"f64x2.splat\", 20),\n    (\"i8x16.eq\", 35),\n    (\"i8x16.ne\", 36),\n    (\"i8x16.lt_s\", 37),\n    (\"i8x16.lt_u\", 38),\n    (\"i8x16.gt_s\", 39),\n    (\"i8x16.gt_u\", 40),\n    (\"i8x16.le_s\", 41),\n    (\"i8x16.le_u\", 42),\n    (\"i8x16.ge_s\", 43),\n    (\"i8x16.ge_u\", 44),\n    (\"i16x8.eq\", 45),\n    (\"i16x8.ne\", 46),\n    (\"i16x8.lt_s\", 47),\n    (\"i16x8.lt_u\", 48),\n    (\"i16x8.gt_s\", 49),\n    (\"i16x8.gt_u\", 50),\n    (\"i16x8.le_s\", 51),\n    (\"i16x8.le_u\", 52),\n    (\"i16x8.ge_s\", 53),\n    (\"i16x8.ge_u\", 54),\n    (\"i32x4.eq\", 55),\n    (\"i32x4.ne\", 56),\n    (\"i32x4.lt_s\", 57),\n    (\"i32x4.lt_u\", 58),\n    (\"i32x4.gt_s\", 59),\n    (\"i32x4.gt_u\", 60),\n    (\"i32x4.le_s\", 61),\n    (\"i32x4.le_u\", 62),\n    (\"i32x4.ge_s\", 63),\n    (\"i32x4.ge_u\", 64),\n    (\"f32x4.eq\", 65),\n    (\"f32x4.ne\", 66),\n    (\"f32x4.lt\", 67),\n    (\"f32x4.gt\", 68),\n    (\"f32x4.le\", 69),\n    (\"f32x4.ge\", 70),\n    (\"f64x2.eq\", 71),\n    (\"f64x2.ne\", 72),\n    (\"f64x2.lt\", 73),\n    (\"f64x2.gt\", 74),\n    (\"f64x2.le\", 75),\n    (\"f64x2.ge\", 76),\n    (\"v128.not\", 77),\n    (\"v128.and\", 78),\n    (\"v128.andnot\", 79),\n    (\"v128.or\", 80),\n    (\"v128.xor\", 81),\n    (\"v128.bitselect\", 82),\n    (\"v128.any_true\", 83),\n    (\"i8x16.abs\", 96),\n    (\"i8x16.neg\", 97),\n    (\"i8x16.popcnt\", 98),\n    (\"i8x16.all_true\", 99),\n    (\"i8x16.bitmask\", 100),\n    (\"i8x16.shl\", 107),\n    (\"i8x16.shr_s\", 108),\n    (\"i8x16.shr_u\", 109),\n    (\"i8x16.add\", 110),\n    (\"i8x16.add_sat_s\", 111),\n    (\"i8x16.add_sat_u\", 112),\n    (\"i8x16.sub\", 113),\n    (\"i8x16.sub_sat_s\", 114),\n    (\"i8x16.sub_sat_u\", 115),\n    (\"i8x16.min_s\", 118),\n    (\"i8x16.min_u\", 119),\n    (\"i8x16.max_s\", 120),\n    (\"i8x16.max_u\", 121),\n    (\"i8x16.avgr_u\", 123),\n    (\"i16x8.abs\", 128),\n    (\"i16x8.neg\", 129),\n    (\"i16x8.all_true\", 131),\n    (\"i16x8.bitmask\", 132),\n    (\"i16x8.shl\", 139),\n    (\"i16x8.shr_s\", 140),\n    (\"i16x8.shr_u\", 141),\n    (\"i16x8.add\", 142),\n    (\"i16x8.sub\", 145),\n    (\"i16x8.mul\", 149),\n    (\"i16x8.min_s\", 150),\n    (\"i16x8.min_u\", 151),\n    (\"i16x8.max_s\", 152),\n    (\"i16x8.max_u\", 153),\n    (\"i16x8.avgr_u\", 155),\n    (\"i32x4.abs\", 160),\n    (\"i32x4.neg\", 161),\n    (\"i32x4.all_true\", 163),\n    (\"i32x4.bitmask\", 164),\n    (\"i32x4.shl\", 171),\n    (\"i32x4.shr_s\", 172),\n    (\"i32x4.shr_u\", 173),\n    (\"i32x4.add\", 174),\n    (\"i32x4.sub\", 177),\n    (\"i32x4.mul\", 181),\n    (\"i32x4.min_s\", 182),\n    (\"i32x4.min_u\", 183),\n    (\"i32x4.max_s\", 184),\n    (\"i32x4.max_u\", 185),\n    (\"i32x4.dot_i16x8_s\", 186),\n    (\"i64x2.abs\", 192),\n    (\"i64x2.neg\", 193),\n    (\"i64x2.all_true\", 195),\n    (\"i64x2.bitmask\", 196),\n    (\"i64x2.shl\", 203),\n    (\"i64x2.shr_s\", 204),\n    (\"i64x2.shr_u\", 205),\n    (\"i64x2.add\", 206),\n    (\"i64x2.sub\", 209),\n    (\"i64x2.mul\", 213),\n    (\"i64x2.eq\", 214),\n    (\"i64x2.ne\", 215),\n    (\"i64x2.lt_s\", 216),\n    (\"i64x2.gt_s\", 217),\n    (\"i64x2.le_s\", 218),\n    (\"i64x2.ge_s\", 219),\n    (\"f32x4.abs\", 224),\n    (\"f32x4.neg\", 225),\n    (\"f32x4.sqrt\", 227),\n    (\"f32x4.add\", 228),\n    (\"f32x4.sub\", 229),\n    (\"f32x4.mul\", 230),\n    (\"f32x4.div\", 231),\n    (\"f32x4.min\", 232),\n    (\"f32x4.max\", 233),\n    (\"f64x2.abs\", 236),\n    (\"f64x2.neg\", 237),\n    (\"f64x2.sqrt\", 239),\n    (\"f64x2.add\", 240),\n    (\"f64x2.sub\", 241),\n    (\"f64x2.mul\", 242),\n    (\"f64x2.div\", 243),\n    (\"f64x2.min\", 244),\n    (\"f64x2.max\", 245)\n  ]\n}\n\n/// SIMD lane-immediate sub-opcodes (0xFD + sub + one lane byte).\n/// Lane count of a SIMD lane-immediate op, from its shape prefix\n/// (i8x16.* -> 16 lanes, ..., f64x2.* -> 2). Callers only pass names that\n/// matched iw_simd_lane_table, so the fallthrough is the two-lane shapes.\nfn iw_lane_count(name: String) -> Int {\n  if String::starts_with(name, \"i8x16.\") {\n    16\n  } else if String::starts_with(name, \"i16x8.\") {\n    8\n  } else if String::starts_with(name, \"i32x4.\") || String::starts_with(name, \"f32x4.\") {\n    4\n  } else {\n    2\n  }\n}\n\nfn iw_simd_lane_table() -> Array[(String, Int)] {\n  [\n    (\"i8x16.extract_lane_s\", 21),\n    (\"i8x16.extract_lane_u\", 22),\n    (\"i8x16.replace_lane\", 23),\n    (\"i16x8.extract_lane_s\", 24),\n    (\"i16x8.extract_lane_u\", 25),\n    (\"i16x8.replace_lane\", 26),\n    (\"i32x4.extract_lane\", 27),\n    (\"i32x4.replace_lane\", 28),\n    (\"i64x2.extract_lane\", 29),\n    (\"i64x2.replace_lane\", 30),\n    (\"f32x4.extract_lane\", 31),\n    (\"f32x4.replace_lane\", 32),\n    (\"f64x2.extract_lane\", 33),\n    (\"f64x2.replace_lane\", 34)\n  ]\n}\n\n/// Core memory ops: (name, opcode, default align exponent).\nfn iw_mem_table() -> Array[(String, Int, Int)] {\n  [\n    (\"i32.load\", 0x28, 2),\n    (\"i64.load\", 0x29, 3),\n    (\"f32.load\", 0x2A, 2),\n    (\"f64.load\", 0x2B, 3),\n    (\"i32.load8_s\", 0x2C, 0),\n    (\"i32.load8_u\", 0x2D, 0),\n    (\"i32.load16_s\", 0x2E, 1),\n    (\"i32.load16_u\", 0x2F, 1),\n    (\"i64.load8_s\", 0x30, 0),\n    (\"i64.load8_u\", 0x31, 0),\n    (\"i64.load16_s\", 0x32, 1),\n    (\"i64.load16_u\", 0x33, 1),\n    (\"i64.load32_s\", 0x34, 2),\n    (\"i64.load32_u\", 0x35, 2),\n    (\"i32.store\", 0x36, 2),\n    (\"i64.store\", 0x37, 3),\n    (\"f32.store\", 0x38, 2),\n    (\"f64.store\", 0x39, 3),\n    (\"i32.store8\", 0x3A, 0),\n    (\"i32.store16\", 0x3B, 1),\n    (\"i64.store8\", 0x3C, 0),\n    (\"i64.store16\", 0x3D, 1),\n    (\"i64.store32\", 0x3E, 2)\n  ]\n}\n\nfn iw_lookup(table: Array[(String, Int)], name: String) -> Int {\n  let n = Array::length(table)\n  let mut i = 0\n  let mut found = 0 - 1\n  while i < n {\n    let (tn, tv) = Array::get(table, i)\n    if tn == name {\n      found = tv\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn iw_mem_lookup(name: String) -> (Int, Int) {\n  let table = iw_mem_table()\n  let n = Array::length(table)\n  let mut i = 0\n  let mut op = 0 - 1\n  let mut al = 0\n  while i < n {\n    let (tn, tv, ta) = Array::get(table, i)\n    if tn == name {\n      op = tv\n      al = ta\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  (op, al)\n}\n\n/// Local resolution: `$name` against the fn's own params (locals 0..n-1),\n/// or a bare numeric index (locals >= param count are the codegen's own —\n/// index `param_count` is the closure env slot — so named access is the\n/// safe spelling).\nfn iw_local_idx(fn_name: String, params: Array[String], tok: String, off: Int) -> Int with { Error } {\n  if String::length(tok) > 0 && String::char_code_at(tok, 0) == '$' {\n    let want = String::substring(tok, 1, String::length(tok))\n    let n = Array::length(params)\n    let mut i = 0\n    let mut found = 0 - 1\n    while i < n {\n      if Array::get(params, i) == want {\n        found = i\n        i = n\n      } else {\n        i = i + 1\n      }\n    }\n    if found < 0 {\n      throw(iw_err(fn_name, \"unknown local '\\{tok}' — inline wasm locals are the fn's own params\", off))\n    } else {\n      found\n    }\n  } else {\n    iw_parse_int(fn_name, tok, off)\n  }\n}\n\n/// Label resolution: `$name` bound by an enclosing block/loop/if (innermost\n/// binding wins), or a bare numeric relative depth.\nfn iw_label_rel(fn_name: String, lbl_names: Array[String], lbl_depths: Array[Int], tok: String, depth: Int, off: Int) -> Int with { Error } {\n  if String::length(tok) > 0 && String::char_code_at(tok, 0) == '$' {\n    let n = Array::length(lbl_names)\n    let mut i = n\n    let mut bound = 0 - 1\n    while i > 0 {\n      i = i - 1\n      if Array::get(lbl_names, i) == tok {\n        bound = Array::get(lbl_depths, i)\n        i = 0\n      } else {\n        ()\n      }\n    }\n    if bound < 0 {\n      throw(iw_err(fn_name, \"unknown label '\\{tok}'\", off))\n    } else {\n      depth - bound - 1\n    }\n  } else {\n    iw_parse_int(fn_name, tok, off)\n  }\n}\n\nfn iw_valtype_code(fn_name: String, name: String, off: Int) -> Int with { Error } {\n  match name {\n    \"i32\" => 0x7F,\n    \"i64\" => 0x7E,\n    \"f32\" => 0x7D,\n    \"f64\" => 0x7C,\n    \"v128\" => 0x7B,\n    _ => throw(iw_err(fn_name, \"unknown value type '\\{name}'\", off))\n  }\n}\n\n/// Optional `(result T)` clause at `pos`; returns (blocktype byte, next pos).\nfn iw_blocktype(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int) -> (Int, Int) with { Error } {\n  if pos + 1 < end && Array::get(kinds, pos) == 1 && Array::get(kinds, pos + 1) == 3 && Array::get(texts, pos + 1) == \"result\" {\n    if pos + 3 < end && Array::get(kinds, pos + 2) == 3 && Array::get(kinds, pos + 3) == 2 {\n      let vt = iw_valtype_code(fn_name, Array::get(texts, pos + 2), Array::get(offs, pos + 2));\n      (vt, pos + 4)\n    } else {\n      throw(iw_err(fn_name, \"malformed (result T) clause\", Array::get(offs, pos)))\n    }\n  } else {\n    (0x40, pos)\n  }\n}\n\n/// Optional `offset=N` / `align=N` immediates (align given in BYTES, encoded\n/// as its log2 exponent, spec-style). Returns (align_exp, offset, next pos).\nfn iw_memarg(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, default_align: Int) -> (Int, Int, Int) with { Error } {\n  let mut align = default_align\n  let mut offset = 0\n  let mut p = pos\n  let mut done = false\n  while !done {\n    if p < end && Array::get(kinds, p) == 3 {\n      let t = Array::get(texts, p)\n      if String::starts_with(t, \"offset=\") {\n        offset = iw_parse_int(fn_name, String::substring(t, 7, String::length(t)), Array::get(offs, p))\n        p = p + 1\n      } else if String::starts_with(t, \"align=\") {\n        let a = iw_parse_int(fn_name, String::substring(t, 6, String::length(t)), Array::get(offs, p))\n        // Codex P2 on #933: floor-log2 of an arbitrary int silently\n        // reinterpreted align=3 as align=2, and an over-aligned value\n        // (align=16 on i32.load) survived to fail only in the wasm\n        // validator. Malformed WAT must be rejected HERE with a located\n        // error: a positive power of two, at most the natural alignment.\n        if a <= 0 || (a&(a - 1)) != 0 {\n          throw(iw_err(fn_name, \"align=\\{a} is invalid (must be a positive power of two)\", Array::get(offs, p)))\n        }\n        let mut e = 0\n        let mut av = a\n        while av > 1 {\n          e = e + 1\n          av = av / 2\n        }\n        if e > default_align {\n          throw(iw_err(fn_name, \"align=\\{a} exceeds the instruction's natural alignment (\\{1 << default_align})\", Array::get(offs, p)))\n        }\n        align = e\n        p = p + 1\n      } else {\n        done = true\n      }\n    } else {\n      done = true\n    }\n  }\n  (align, offset, p)\n}\n\n/// Require a word token at `pos` (the immediate of the op named `opname`).\nfn iw_want_word(fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, opname: String) -> String with { Error } {\n  if pos < end && Array::get(kinds, pos) == 3 {\n    Array::get(texts, pos)\n  } else {\n    let off = if pos < Array::length(offs) {\n      Array::get(offs, pos)\n    } else {\n      0 - 1\n    }\n    throw(iw_err(fn_name, \"'\\{opname}' expects an immediate operand\", off))\n  }\n}\n\n/// `v128.const <shape> <lane ints...>` — shape is i8x16/i16x8/i32x4/i64x2;\n/// encodes the 16-byte little-endian immediate. Returns next pos.\nfn iw_v128_const(buf: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int) -> Int with { Error } {\n  let shape = iw_want_word(fn_name, kinds, texts, offs, pos, end, \"v128.const\")\n  let (lane_count, lane_bytes) = match shape {\n    \"i8x16\" => (16, 1),\n    \"i16x8\" => (8, 2),\n    \"i32x4\" => (4, 4),\n    \"i64x2\" => (2, 8),\n    _ => throw(iw_err(fn_name, \"v128.const shape must be i8x16/i16x8/i32x4/i64x2, got '\\{shape}'\", Array::get(offs, pos)))\n  }\n  bytebuf_push(buf, 0xFD)\n  leb128_encode_u32(buf, 12)\n  let mut p = pos + 1\n  let mut li = 0\n  while li < lane_count {\n    let t = iw_want_word(fn_name, kinds, texts, offs, p, end, \"v128.const\")\n    let v = iw_parse_int(fn_name, t, Array::get(offs, p))\n    let mut bi = 0\n    while bi < lane_bytes {\n      bytebuf_push(buf, (v>>(bi * 8))&255)\n      bi = bi + 1\n    }\n    p = p + 1\n    li = li + 1\n  }\n  p\n}\n\n/// Emit ONE plain (non-control) instruction word at `pos` plus its immediates\n/// into `buf`. Returns the position after the instruction + immediates.\nfn iw_plain_op(buf: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let name = Array::get(texts, pos)\n  let off = Array::get(offs, pos)\n  if name == \"block\" || name == \"loop\" || name == \"if\" || name == \"else\" || name == \"end\" || name == \"then\" {\n    throw(iw_err(fn_name, \"structured control must use the folded form: (block ...) / (loop ...) / (if <cond> (then ...) (else ...))\", off))\n  } else if name == \"local.get\" || name == \"local.set\" || name == \"local.tee\" {\n    let opc = if name == \"local.get\" {\n      0x20\n    } else if name == \"local.set\" {\n      0x21\n    } else {\n      0x22\n    }\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let idx = iw_local_idx(fn_name, params, t, Array::get(offs, pos + 1))\n    bytebuf_push(buf, opc)\n    leb128_encode_u32(buf, idx)\n    pos + 2\n  } else if name == \"br\" || name == \"br_if\" {\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let rel = iw_label_rel(fn_name, lbl_names, lbl_depths, t, depth, Array::get(offs, pos + 1))\n    if rel < 0 {\n      throw(iw_err(fn_name, \"label '\\{t}' is not visible from this branch\", Array::get(offs, pos + 1)))\n    } else {\n      ()\n    }\n    bytebuf_push(buf, if name == \"br\" {\n      0x0C\n    } else {\n      0x0D\n    })\n    leb128_encode_u32(buf, rel)\n    pos + 2\n  } else if name == \"i32.const\" {\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let v = iw_parse_int(fn_name, t, Array::get(offs, pos + 1))\n    bytebuf_push(buf, 0x41)\n    leb128_encode_s32(buf, v)\n    pos + 2\n  } else if name == \"i64.const\" {\n    let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n    let v = iw_parse_int(fn_name, t, Array::get(offs, pos + 1))\n    bytebuf_push(buf, 0x42)\n    leb128_encode_s64(buf, v)\n    pos + 2\n  } else if name == \"f32.const\" || name == \"f64.const\" {\n    throw(iw_err(fn_name, \"'\\{name}' is not supported in inline wasm (v0.3 slice); build the bit pattern with i64.const + f64.reinterpret_i64\", off))\n  } else if name == \"memory.size\" || name == \"memory.grow\" {\n    bytebuf_push(buf, if name == \"memory.size\" {\n      0x3F\n    } else {\n      0x40\n    })\n    bytebuf_push(buf, 0x00)\n    pos + 1\n  } else if name == \"v128.const\" {\n    iw_v128_const(buf, fn_name, kinds, texts, offs, pos + 1, end)\n  } else if name == \"v128.load\" || name == \"v128.store\" {\n    let (align, offset, next) = iw_memarg(fn_name, kinds, texts, offs, pos + 1, end, 4)\n    bytebuf_push(buf, 0xFD)\n    leb128_encode_u32(buf, if name == \"v128.load\" {\n      0\n    } else {\n      11\n    })\n    leb128_encode_u32(buf, align)\n    leb128_encode_u32(buf, offset)\n    next\n  } else if name == \"call\" || name == \"call_indirect\" || name == \"return_call\" {\n    throw(iw_err(fn_name, \"'\\{name}' is not supported in inline wasm (v0.3 slice: bodies cannot reference other functions)\", off))\n  } else if name == \"global.get\" || name == \"global.set\" {\n    throw(iw_err(fn_name, \"'\\{name}' is not supported in inline wasm (v0.3 slice: runtime globals are not addressable)\", off))\n  } else if name == \"br_table\" {\n    throw(iw_err(fn_name, \"'br_table' is not supported in inline wasm (v0.3 slice)\", off))\n  } else if name == \"local\" {\n    throw(iw_err(fn_name, \"'(local ...)' declarations are not supported in inline wasm (v0.3 slice); use the fn's params as scratch locals\", off))\n  } else {\n    let core_opc = iw_lookup(iw_core_table(), name)\n    if core_opc >= 0 {\n      bytebuf_push(buf, core_opc)\n      pos + 1\n    } else {\n      let lane_sub = iw_lookup(iw_simd_lane_table(), name)\n      if lane_sub >= 0 {\n        let t = iw_want_word(fn_name, kinds, texts, offs, pos + 1, end, name)\n        let lane = iw_parse_int(fn_name, t, Array::get(offs, pos + 1))\n        // Codex P2 on #933: `lane & 255` truncated out-of-range lane\n        // indices (i8x16.extract_lane_s 16, replace_lane -1) into a wasm\n        // file that only the validator rejects. Bound-check against the\n        // shape's lane count for the promised located error.\n        let lane_cnt = iw_lane_count(name)\n        if lane < 0 || lane >= lane_cnt {\n          throw(iw_err(fn_name, \"lane index \\{lane} is out of range for '\\{name}' (0..\\{lane_cnt - 1})\", Array::get(offs, pos + 1)))\n        }\n        bytebuf_push(buf, 0xFD)\n        leb128_encode_u32(buf, lane_sub)\n        bytebuf_push(buf, lane&255)\n        pos + 2\n      } else {\n        let (mem_opc, mem_align) = iw_mem_lookup(name)\n        if mem_opc >= 0 {\n          let (align, offset, next) = iw_memarg(fn_name, kinds, texts, offs, pos + 1, end, mem_align)\n          bytebuf_push(buf, mem_opc)\n          leb128_encode_u32(buf, align)\n          leb128_encode_u32(buf, offset)\n          next\n        } else {\n          let simd_sub = iw_lookup(iw_simd_table(), name)\n          if simd_sub >= 0 {\n            bytebuf_push(buf, 0xFD)\n            leb128_encode_u32(buf, simd_sub)\n            pos + 1\n          } else {\n            throw(iw_err(fn_name, \"unknown or unsupported instruction '\\{name}'\", off))\n          }\n        }\n      }\n    }\n  }\n}\n\n/// One sequence item at `pos`: either a folded `(...)` expression or a plain\n/// instruction word. Returns the position after the item.\nfn iw_item(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let k = Array::get(kinds, pos)\n  if k == 3 {\n    iw_plain_op(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\n  } else if k == 1 {\n    if pos + 1 >= end || Array::get(kinds, pos + 1) != 3 {\n      throw(iw_err(fn_name, \"expected an instruction name after '('\", Array::get(offs, pos)))\n    } else {\n      ()\n    }\n    let head = Array::get(texts, pos + 1)\n    if head == \"block\" || head == \"loop\" {\n      iw_folded_block(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\n    } else if head == \"if\" {\n      iw_folded_if(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\n    } else if head == \"then\" || head == \"else\" || head == \"result\" {\n      throw(iw_err(fn_name, \"misplaced '(\\{head} ...)' clause\", Array::get(offs, pos)))\n    } else {\n      iw_folded_op(out, fn_name, kinds, texts, offs, pos, end, params, lbl_names, lbl_depths, depth)\n    }\n  } else {\n    throw(iw_err(fn_name, \"unexpected ')'\", Array::get(offs, pos)))\n  }\n}\n\n/// A sequence of items up to (not consuming) a closing ')' or the end.\nfn iw_seq(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let mut p = pos\n  let mut done = false\n  while !done {\n    if p >= end {\n      done = true\n    } else if Array::get(kinds, p) == 2 {\n      done = true\n    } else {\n      p = iw_item(out, fn_name, kinds, texts, offs, p, end, params, lbl_names, lbl_depths, depth)\n    }\n  }\n  p\n}\n\n/// Folded `(op <immediates> <operand exprs...>)`: real folded-form semantics —\n/// the operand expressions are emitted FIRST, then the op itself.\nfn iw_folded_op(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let opb = bytebuf_new()\n  let after_imm = iw_plain_op(opb, fn_name, kinds, texts, offs, pos + 1, end, params, lbl_names, lbl_depths, depth)\n  let mut p = after_imm\n  let mut done = false\n  while !done {\n    if p >= end {\n      throw(iw_err(fn_name, \"missing ')' closing folded '\\{Array::get(texts, pos + 1)}'\", Array::get(offs, pos)))\n    } else if Array::get(kinds, p) == 2 {\n      done = true\n    } else if Array::get(kinds, p) == 1 {\n      p = iw_item(out, fn_name, kinds, texts, offs, p, end, params, lbl_names, lbl_depths, depth)\n    } else {\n      throw(iw_err(fn_name, \"unexpected '\\{Array::get(texts, p)}' inside folded '\\{Array::get(texts, pos + 1)}' — operands must be parenthesized\", Array::get(offs, p)))\n    }\n  }\n  bytebuf_push_buf(out, opb)\n  p + 1\n}\n\n/// Folded `(block $l? (result T)? ...)` / `(loop $l? (result T)? ...)`.\nfn iw_folded_block(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let head = Array::get(texts, pos + 1)\n  bytebuf_push(out, if head == \"loop\" {\n    0x03\n  } else {\n    0x02\n  })\n  let lbl_mark = Array::length(lbl_names)\n  let mut q = pos + 2\n  if q < end && Array::get(kinds, q) == 3 && String::length(Array::get(texts, q)) > 0 && String::char_code_at(Array::get(texts, q), 0) == '$' {\n    Array::push(lbl_names, Array::get(texts, q))\n    Array::push(lbl_depths, depth)\n    q = q + 1\n  } else {\n    ()\n  }\n  let (bt, after_bt) = iw_blocktype(fn_name, kinds, texts, offs, q, end)\n  bytebuf_push(out, bt)\n  let bq = iw_seq(out, fn_name, kinds, texts, offs, after_bt, end, params, lbl_names, lbl_depths, depth + 1)\n  if bq >= end || Array::get(kinds, bq) != 2 {\n    throw(iw_err(fn_name, \"missing ')' closing '\\{head}'\", Array::get(offs, pos)))\n  } else {\n    ()\n  }\n  bytebuf_push(out, 0x0B)\n  Array::truncate(lbl_names, lbl_mark)\n  Array::truncate(lbl_depths, lbl_mark)\n  bq + 1\n}\n\n/// Folded `(if $l? (result T)? <cond exprs...> (then ...) (else ...)?)`.\n/// The condition is emitted first, then 0x04 + blocktype, then the branches.\nfn iw_folded_if(out: Bytes, fn_name: String, kinds: Array[Int], texts: Array[String], offs: Array[Int], pos: Int, end: Int, params: Array[String], lbl_names: Array[String], lbl_depths: Array[Int], depth: Int) -> Int with { Error } {\n  let lbl_mark = Array::length(lbl_names)\n  let mut q = pos + 2\n  if q < end && Array::get(kinds, q) == 3 && String::length(Array::get(texts, q)) > 0 && String::char_code_at(Array::get(texts, q), 0) == '$' {\n    Array::push(lbl_names, Array::get(texts, q))\n    Array::push(lbl_depths, depth)\n    q = q + 1\n  } else {\n    ()\n  }\n  let (bt, after_bt) = iw_blocktype(fn_name, kinds, texts, offs, q, end)\n  // condition: folded expressions until the '(then ...)' clause\n  let mut p = after_bt\n  let mut cond_done = false\n  while !cond_done {\n    if p >= end {\n      throw(iw_err(fn_name, \"missing '(then ...)' clause in folded 'if'\", Array::get(offs, pos)))\n    } else if Array::get(kinds, p) == 1 && p + 1 < end && Array::get(kinds, p + 1) == 3 && Array::get(texts, p + 1) == \"then\" {\n      cond_done = true\n    } else if Array::get(kinds, p) == 1 {\n      p = iw_item(out, fn_name, kinds, texts, offs, p, end, params, lbl_names, lbl_depths, depth)\n    } else {\n      throw(iw_err(fn_name, \"unexpected token in folded 'if' condition (condition operands must be parenthesized)\", Array::get(offs, p)))\n    }\n  }\n  bytebuf_push(out, 0x04)\n  bytebuf_push(out, bt)\n  // then branch: p is at '(' of (then ...)\n  let tq = iw_seq(out, fn_name, kinds, texts, offs, p + 2, end, params, lbl_names, lbl_depths, depth + 1)\n  if tq >= end || Array::get(kinds, tq) != 2 {\n    throw(iw_err(fn_name, \"missing ')' closing '(then ...)'\", Array::get(offs, p)))\n  } else {\n    ()\n  }\n  let mut r = tq + 1\n  if r + 1 < end && Array::get(kinds, r) == 1 && Array::get(kinds, r + 1) == 3 && Array::get(texts, r + 1) == \"else\" {\n    bytebuf_push(out, 0x05)\n    let eq = iw_seq(out, fn_name, kinds, texts, offs, r + 2, end, params, lbl_names, lbl_depths, depth + 1)\n    if eq >= end || Array::get(kinds, eq) != 2 {\n      throw(iw_err(fn_name, \"missing ')' closing '(else ...)'\", Array::get(offs, r)))\n    } else {\n      ()\n    }\n    r = eq + 1\n  } else {\n    ()\n  }\n  if r >= end || Array::get(kinds, r) != 2 {\n    throw(iw_err(fn_name, \"missing ')' closing folded 'if'\", Array::get(offs, pos)))\n  } else {\n    ()\n  }\n  bytebuf_push(out, 0x0B)\n  Array::truncate(lbl_names, lbl_mark)\n  Array::truncate(lbl_depths, lbl_mark)\n  r + 1\n}\n\n/// Entry: compile one inline-wasm fn body's WAT text to raw instruction bytes.\n/// `param_names` are the fn's declared params in order (wasm locals 0..n-1 on\n/// the linear backend; every param and the result are RAW 62-bit tagged i64\n/// values — ADR-0055/ADR-0072 — the WAT author untags/retags explicitly).\nexport fn compile_inline_wat(fn_name: String, wat: String, param_names: Array[String]) -> Bytes with { Error } {\n  let (kinds, texts, offs) = iw_tokenize(fn_name, wat)\n  let out = bytebuf_new()\n  let lbl_names = iw_fresh_strings()\n  let lbl_depths = iw_fresh_ints()\n  let end = Array::length(kinds)\n  if end == 0 {\n    throw(iw_err(fn_name, \"empty inline wasm body\", 0))\n  } else {\n    ()\n  }\n  let final_pos = iw_seq(out, fn_name, kinds, texts, offs, 0, end, param_names, lbl_names, lbl_depths, 0)\n  if final_pos != end {\n    throw(iw_err(fn_name, \"unbalanced ')'\", Array::get(offs, final_pos)))\n  } else {\n    ()\n  }\n  out\n}\n\n//# Misc\n\nexport {\n  compile_inline_wat\n}\n")
}

let cli_adapter_source_105 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasi/linked_helpers.vibe",
"//# Imports\n\nimport @vibe/compiler/codegen/common_base {\n  canonical_builtin_name\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  Expr, Stmt, sorted_names_of\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_free_vars_indexed\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str\n}\n\n//# Functions\n\nfn expr_uses_builtin(expr: Expr, fn_names: Array[String], target: String) -> Bool {\n  let free_vars = collect_free_vars(expr, array_empty(), fn_names)\n  let normalized_target = canonical_builtin_name(target)\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(free_vars) && !found {\n    found = canonical_builtin_name(Array::get(free_vars, i)) == normalized_target\n    i = i + 1\n  }\n  found\n}\n\nexport fn stmts_use_builtin(stmts: Array[Stmt], fn_names: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) && !found {\n    found = match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      SLetMut(_, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      STest(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SBench(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SExpr(expr) => expr_uses_builtin(expr, fn_names, target),\n      SModule(_, _, inner) => stmts_use_builtin(inner, fn_names, target),\n      _ => false\n    }\n    i = i + 1\n  }\n  found\n}\n\n/// #799 perf: ONE walk over the whole program collecting every free name's\n/// canonical builtin form into a set. linked_compile's ~40 need_<builtin>\n/// flags used to each call stmts_use_builtin -- a full-AST walk per flag,\n/// with a linear fn_names scan per ident inside -- which was a top entry in\n/// compiler-closure compile profiles. Same semantics: a name counts as \"used\"\n/// only where it is FREE (not a user fn, not locally bound), and the flag\n/// reads compare canonical names exactly like expr_uses_builtin did.\nfn push_free_canonical(expr: Expr, fn_name_index: Array[String], sink: Array[(String, Bool)]) -> Unit {\n  let fvs = collect_free_vars_indexed(expr, array_empty(), fn_name_index)\n  let mut j = 0\n  while j < Array::length(fvs) {\n    Array::push(sink, (canonical_builtin_name(Array::get(fvs, j)), true))\n    j = j + 1\n  }\n}\n\nexport fn collect_used_builtin_names_into(stmts: Array[Stmt], fn_names: Array[String], fn_name_index: Array[String], sink: Array[(String, Bool)]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => push_free_canonical(expr, fn_name_index, sink),\n      SLetMut(_, _, expr) => push_free_canonical(expr, fn_name_index, sink),\n      STest(_, expr) => push_free_canonical(expr, fn_name_index, sink),\n      SBench(_, expr) => push_free_canonical(expr, fn_name_index, sink),\n      SExpr(expr) => push_free_canonical(expr, fn_name_index, sink),\n      SModule(_, _, inner) => collect_used_builtin_names_into(inner, fn_names, fn_name_index, sink),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nexport fn collect_used_builtin_names(stmts: Array[Stmt], fn_names: Array[String]) -> Map[String, Bool] {\n  // Sorted membership index (see core/sorted_index.vibe) -- the MapBuilder\n  // version was O(N^2) to build and O(N) per lookup.\n  let fn_name_index = sorted_names_of(fn_names)\n  let sink = array_empty()\n  collect_used_builtin_names_into(stmts, fn_names, fn_name_index, sink)\n  let set_b = MapBuilder::new()\n  let mut k = 0\n  while k < Array::length(sink) {\n    let (nm, _) = Array::get(sink, k)\n    MapBuilder::set(set_b, nm, true)\n    k = k + 1\n  }\n  MapBuilder::freeze(set_b)\n}\n")
}

let cli_adapter_source_106 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasi/linked_compile.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_buf,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32,\n  rewrite_top_level_fn_alias_refs,\n  sorted_names_of\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/normalize {\n  lift_match_scrutinees, uniquify_shadowed_bindings\n}\n\nimport @vibe/compiler/perceus {\n  PerceusAction,\n  build_perceus_plan,\n  build_perceus_plan_with_params,\n  compute_borrow_returning_names,\n  compute_heap_returning,\n  compute_scalar_returning_names,\n  elaborate_heap_params,\n  pa_is_alias_dup,\n  pa_is_drop,\n  pa_is_dup,\n  param_is_heap_in_body\n}\n\nimport @vibe/compiler/codegen/builtin_bodies {\n  gen_arr_concat_body,\n  gen_arr_get_body,\n  gen_arr_len_body,\n  gen_arr_new_body,\n  gen_arr_push_all_body,\n  gen_arr_push_body,\n  gen_arr_set_body,\n  gen_arr_slice_body,\n  gen_arr_truncate_body,\n  gen_bytes_append_body,\n  gen_bytes_concat_body,\n  gen_bytes_from_array_body,\n  gen_bytes_get_body,\n  gen_bytes_len_body,\n  gen_bytes_new_body,\n  gen_bytes_push_body,\n  gen_bytes_set_body,\n  gen_bytes_slice_body,\n  gen_bytes_to_array_body,\n  gen_eq_body,\n  gen_generic_add_body,\n  gen_generic_rel_diff_body,\n  gen_map_build_index_body,\n  gen_map_cap_body,\n  gen_map_hash_body,\n  gen_map_index_insert_body,\n  gen_map_probe_index_body,\n  gen_rc_alloc_body,\n  gen_rc_drop_body,\n  gen_simd_scan_alnum_body,\n  gen_simd_skip_ws_body,\n  gen_sources_proper_body,\n  gen_sources_stub_body,\n  gen_str_char_code_at_body,\n  gen_str_concat_body,\n  gen_str_eq_body,\n  gen_str_from_char_code_body,\n  gen_str_len_body,\n  gen_str_lex_diff_body,\n  gen_str_substring_body,\n  gen_string_contains_body,\n  gen_string_ends_with_body,\n  gen_string_index_of_body,\n  gen_string_join_body,\n  gen_string_last_index_of_body,\n  gen_string_split_body,\n  gen_string_starts_with_body,\n  gen_string_trim_body,\n  static_arr_get_body,\n  static_arr_len_body,\n  static_arr_set_body,\n  static_arr_truncate_body,\n  static_double_to_int_body,\n  static_fs_stub_body,\n  static_fs_write_bytes_stub_body,\n  static_identity_body,\n  static_int_to_double_body,\n  static_print_i64_body,\n  static_print_str_body,\n  static_str_char_code_at_body,\n  static_str_eq_body,\n  static_str_len_body\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars,\n  collect_strings_stmts,\n  compute_borrow_arg0_user_fns,\n  compute_may_return_view_fns,\n  count_lambda_sites_expr,\n  emit_closure_call_tail,\n  emit_closure_resolve,\n  emit_i64_extend_i32_u,\n  is_mut_captured_in,\n  scope_tail_proj_root,\n  stmts_contain_exceptions,\n  zero_alloc_check\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CovState,\n  CtorTable,\n  DbgProv,\n  FuncTable,\n  LambdaTable,\n  LineMapState,\n  StrTable,\n  agg_info_of_type_expr,\n  await_poll_pass,\n  builtin_registry,\n  compile_inline_wat,\n  compute_agg_returning,\n  ctor_sorted_index,\n  desugar_trait_dicts,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_rc_dup_guarded,\n  emit_str_ref,\n  empty_dbg_prov,\n  evidence_dict_pass,\n  expr_tag,\n  fn_type_param_types,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  get_slet_type,\n  inline_direct_performs,\n  is_efn,\n  is_eident,\n  is_etuple,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  lookup_ctor,\n  rc_shadow_reserve,\n  resolve_func,\n  resolve_local,\n  rewrite_self_tail_calls,\n  suspend_cps_pass,\n  verify_lane_builtins\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  build_newline_offsets,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/expr {\n  compile_expr\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_element_section_active_runs,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_name_section,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_heap_memory_grow_check,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_store,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  emit_vibe_abi_custom_section,\n  string_to_data\n}\n\nimport ./linked_helpers.vibe {\n  collect_used_builtin_names, stmts_use_builtin\n}\n\n//# Functions\n\nlet wasm_page_size = 65536\n\nfn lc_fresh_int_array() -> Array[Int] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_bool_array() -> Array[Bool] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_bytes_array() -> Array[Bytes] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_string_array() -> Array[String] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_expr_array() -> Array[Expr] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_type_expr_array() -> Array[TypeExpr] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\n/// #644: an Int array of exactly `n` entries, all initialized to `fill`, so\n/// callers can index-assign (`Array::set`) into it before the real value at\n/// each index is known (linemap_hdrlen_by_bi below: one entry per user\n/// function, filled in `ci` order as each function's locals header is\n/// assembled).\nfn lc_fresh_int_array_of_len(n: Int, fill: Int) -> Array[Int] {\n  let arr = lc_fresh_int_array()\n  let mut i = 0\n  while i < n {\n    Array::push(arr, fill)\n    i = i + 1\n  }\n  arr\n}\n\n/// #644: append a little-endian 4-byte encoding of `v` to `buf`. Used by the\n/// `vibe.linemap` custom section (see below), one of a family of ad hoc\n/// raw-int encodings this file already uses for debug sections (compare\n/// `vibe.dbgargs`'s address fields a few hundred lines up).\nfn bytebuf_push_i32le(buf: Bytes, v: Int) -> Unit {\n  bytebuf_push(buf, v&255)\n  bytebuf_push(buf, (v>>8)&255)\n  bytebuf_push(buf, (v>>16)&255)\n  bytebuf_push(buf, (v>>24)&255)\n}\n\n/// #1085: builtins whose arg0 is BORROWED (kept in sync with\n/// cc_is_borrow_arg0_call in codegen/expr/compile_call.vibe and\n/// is_borrow_arg0_call in perceus/perceus.vibe).\nfn lc_is_borrow_arg0_call(f: String) -> Bool {\n  f == \"__index\" || f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Array::push\" || f == \"ArrayBuilder::push\" || f == \"StringBuilder::push\" || f == \"MapBuilder::set\" || f == \"Map::get\" || f == \"Map::keys\" || f == \"Map::has_key\" || f == \"Map::has\" || f == \"Map::set\" || f == \"Map::size\" || f == \"Map::values\" || f == \"Map::delete\" || f == \"Bytes::push\" || f == \"Bytes::set\" || f == \"Bytes::get\" || f == \"Bytes::length\" || f == \"FrozenArray::get\" || f == \"FrozenArray::length\" || f == \"__rec_field\"\n}\n\n/// #1085: does `name` have a consuming occurrence OUTSIDE any loop body?\n/// The #725 single unconditional epilogue drop for a loop-consumed param\n/// is only sound when EVERY consuming occurrence is a loop-borrow site\n/// (per-iteration protective dup makes those net-zero, so the param's own\n/// reference always survives to the epilogue). A consuming occurrence\n/// outside a loop (e.g. `Array::set(buf, i, v)` in a sibling branch of\n/// the loop) transfers the own reference on the paths that execute it,\n/// and the unconditional drop then over-releases the stored value —\n/// use-after-free (issue #1085's minimal repro; the else arm does not\n/// even need to run). Occurrence rules mirror consume_count\n/// (common_analysis/perceus): borrow-arg0 idents, match/handle\n/// scrutinee idents, and call-callee idents do not consume. Loop bodies\n/// (EWhile / ELoop / EForIn) are skipped — occurrences there are the\n/// loop-borrow sites themselves. Branches use OR (existence), which\n/// over-approximates toward suppressing the epilogue drop: the loop-only\n/// path then leaks one reference, the safe direction.\nfn lc_has_nonloop_consume(e: Expr, name: String) -> Bool {\n  match e {\n    EIdent(n, _) => n == name,\n    ETuple(items) => lc_hnc_any(items, name),\n    EArray(items) => lc_hnc_any(items, name),\n    ERecord(_, fields, _) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        if lc_has_nonloop_consume(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fields) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        if lc_has_nonloop_consume(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EIf(c, t, el) => lc_has_nonloop_consume(c, name) || lc_has_nonloop_consume(t, name) || lc_has_nonloop_consume(el, name),\n    ELet(_, v, b, _) => lc_has_nonloop_consume(v, name) || lc_has_nonloop_consume(b, name),\n    ELetRec(_, v, b) => lc_has_nonloop_consume(v, name) || lc_has_nonloop_consume(b, name),\n    ELetMut(_, v, b, _) => lc_has_nonloop_consume(v, name) || lc_has_nonloop_consume(b, name),\n    EAssign(_, v, b) => lc_has_nonloop_consume(v, name) || lc_has_nonloop_consume(b, name),\n    EAssignOp(_, _, v, b) => lc_has_nonloop_consume(v, name) || lc_has_nonloop_consume(b, name),\n    ESeq(a, b) => lc_has_nonloop_consume(a, name) || lc_has_nonloop_consume(b, name),\n    EMatch(s, arms) => {\n      let scr = match s {\n        EIdent(_, _) => false,\n        _ => lc_has_nonloop_consume(s, name)\n      }\n      let mut found = scr\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ab) = Array::get(arms, i)\n        if lc_has_nonloop_consume(ab, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EHandle(s, arms) => {\n      let scr = match s {\n        EIdent(_, _) => false,\n        _ => lc_has_nonloop_consume(s, name)\n      }\n      let mut found = scr\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, ab) = Array::get(arms, i)\n        if lc_has_nonloop_consume(ab, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EWhile(c, _) => lc_has_nonloop_consume(c, name),\n    ELoop(params, _) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, v) = Array::get(params, i)\n        if lc_has_nonloop_consume(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EForIn(_, _, it, _) => lc_has_nonloop_consume(it, name),\n    ECall(callee, args, _) => {\n      let borrow0 = match callee {\n        EIdent(f, _) => lc_is_borrow_arg0_call(f),\n        _ => false\n      }\n      let callee_c = match callee {\n        EIdent(_, _) => false,\n        _ => lc_has_nonloop_consume(callee, name)\n      }\n      let mut found = callee_c\n      let mut i = 0\n      while i < Array::length(args) {\n        let skip_borrowed_head = borrow0 && i == 0 && (match Array::get(args, i) {\n          EIdent(_, _) => true,\n          _ => false\n        })\n        if skip_borrowed_head {\n          ()\n        } else if lc_has_nonloop_consume(Array::get(args, i), name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EBinOp(_, l, r) => lc_has_nonloop_consume(l, name) || lc_has_nonloop_consume(r, name),\n    EUnaryOp(_, x) => lc_has_nonloop_consume(x, name),\n    EFn(_, _, _, _, _, fb) => lc_has_nonloop_consume(fb, name),\n    EDot(x, _, _, _) => lc_has_nonloop_consume(x, name),\n    ELabeledArg(_, _, v) => lc_has_nonloop_consume(v, name),\n    EReturn(x) => lc_has_nonloop_consume(x, name),\n    EBreak(opt) => match opt {\n      Some(v) => lc_has_nonloop_consume(v, name),\n      None => false\n    },\n    EContinue(args) => lc_hnc_any(args, name),\n    ESpread(x) => lc_has_nonloop_consume(x, name),\n    _ => false\n  }\n}\n\nfn lc_hnc_any(items: Array[Expr], name: String) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(items) {\n    if lc_has_nonloop_consume(Array::get(items, i), name) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n/// #1062: positional field types for a struct declaration's field list,\n/// dropping the names -- SEnum/SSuberror variants are already unnamed\n/// (Array[TypeExpr]), but SStruct fields carry (name, type) pairs.\nfn struct_field_types(sfields: Array[(String, TypeExpr)]) -> Array[TypeExpr] {\n  let out = lc_fresh_type_expr_array()\n  let mut i = 0\n  while i < Array::length(sfields) {\n    let (_, ft) = Array::get(sfields, i)\n    Array::push(out, ft)\n    i = i + 1\n  }\n  out\n}\n\n/// #1062: append `ctor_idx * 64 + field_idx` to `out` for every positional\n/// field in `field_types` whose declared type is Double/Float (same TyName\n/// check as the annotated-Float/Double-param seeding below). See\n/// CompileCtx.ctor_float_fields.\nfn push_ctor_float_fields(out: Array[Int], ctor_idx: Int, field_types: Array[TypeExpr]) -> Unit {\n  let mut fi = 0\n  while fi < Array::length(field_types) {\n    match Array::get(field_types, fi) {\n      TyName(ftn) => if ftn == \"Float\" || ftn == \"Double\" {\n        Array::push(out, ctor_idx * 64 + fi)\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    fi = fi + 1\n  }\n}\n\nfn lc_fresh_string_matrix() -> Array[Array[String]] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn gen_heap_grow_check_body() -> Bytes {\n  let b = bytebuf_new()\n  emit_heap_memory_grow_check(b)\n  b\n}\n\n/// #805 (ADR-0072): collect the inline-wasm fns (`fn f(..) -> Int = wasm\n/// \"...\"`, carried as the parser-internal `%wasm(\"<WAT>\")` marker body) into\n/// parallel name/WAT-text arrays and REPLACE each marker body with a neutral\n/// EInt(0) IN PLACE — so every downstream analysis (Perceus plans, borrow/\n/// scalar-return classification, string-table collection, coverage) sees an\n/// ordinary trivial body and the WAT text never leaks into the data section.\n/// The per-fn codegen loop then splices the assembled instruction bytes\n/// (compile_inline_wat) instead of running compile_expr for these names.\nfn lc_extract_inline_wasm(stmts: Array[Stmt], names: Array[String], wats: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(iw_exp, iw_rec, iw_name, iw_ann, iw_expr) => match iw_expr {\n        EFn(iw_tps, iw_tbs, iw_params, iw_ret, iw_eff, iw_body) => match iw_body {\n          ECall(iw_cal, iw_args, _) => match iw_cal {\n            EIdent(iw_cn, _) => if iw_cn == \"%wasm\" && Array::length(iw_args) == 1 {\n              match Array::get(iw_args, 0) {\n                EString(iw_wat) => {\n                  Array::push(names, iw_name)\n                  Array::push(wats, iw_wat)\n                  Array::set(stmts, i, SLet(iw_exp, iw_rec, iw_name, iw_ann, EFn(iw_tps, iw_tbs, iw_params, iw_ret, iw_eff, EInt(0))))\n                },\n                _ => ()\n              }\n            } else {\n              ()\n            },\n            _ => ()\n          },\n          _ => ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nlet default_wasi_memory_min_pages = 64\n\nexport fn wasi_memory_min_pages_for_heap(heap_start: Int) -> Int {\n  let needed_pages = (heap_start + wasm_page_size - 1) / wasm_page_size\n  if needed_pages > default_wasi_memory_min_pages {\n    needed_pages\n  } else {\n    default_wasi_memory_min_pages\n  }\n}\n\n/// ADR-0069: `Unit` in a declared return position — either the canonical\n/// TyUnit (`-> ()`) or the named spelling (`-> Unit`, what parse_type produces\n/// and what the `fn main {}` desugar emits).\nfn linked_type_expr_is_unit(t: TypeExpr) -> Bool {\n  match t {\n    TyUnit => true,\n    TyName(n) => n == \"Unit\",\n    _ => false\n  }\n}\n\n/// #944 (ADR-0073 stage C, \"entry boundary A\"): does a declared row text\n/// contain the literal effect label \"Error\" as a whole token? Row text is a\n/// comma-separated label list (\"Error\", \"Error, Fs\", \"Stdout, Error\", ...);\n/// substring matching alone would false-positive on a user effect named\n/// e.g. \"ErrorLog\", so each comma-separated piece is trimmed and compared\n/// exactly.\nfn lc_row_has_error(eff: Option[String]) -> Bool {\n  match eff {\n    Some(row) => {\n      let mut found = false\n      let mut start = 0\n      let n = String::length(row)\n      let mut i = 0\n      while i <= n {\n        let at_sep = if i == n {\n          true\n        } else {\n          String::char_code_at(row, i) == 44\n        }\n        if at_sep {\n          if String::trim(String::substring(row, start, i)) == \"Error\" {\n            found = true\n          } else {\n            ()\n          }\n          start = i + 1\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    None => false\n  }\n}\n\n/// #944 (ADR-0073 stage C): the runtime outermost Error handler. When the\n/// ENTRY function's own declared row carries `Error` (`fn main with\n/// { Error }` is allowed under checked-Error), an escaping `Error::Throw`\n/// must become a diagnosed, unsuccessful process outcome -- not a raw\n/// `WebAssembly.Exception` leaking past the entry into the host. Rewrites\n/// the entry function's body, post-check/pre-codegen, into\n///\n///   handle { <body> } with Error {\n///     Throw(msg) => { Stderr::...(diagnostic); 1 }\n///   }\n///\n/// so the existing (well-exercised) `with Error` handle lowering does all\n/// the work -- no new codegen. The arm never resumes (Error is\n/// non-resumable, #640), so replay semantics are irrelevant here. Entries\n/// with no `Error` in their row are untouched: under default-on checked\n/// Error (stage B) they cannot leak a Throw in the first place. The\n/// `__no_entry__` test-runner lane never matches an SLet by this name, so\n/// test `_start` synthesis (whose trap-on-assert semantics the unit-test\n/// runner depends on) is untouched.\nfn lc_wrap_entry_error_boundary(stmts: Array[Stmt], entry_name: String) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, body)) => if name == entry_name && lc_row_has_error(eff) {\n        let diag = ESeq(ECall(EIdent(\"Stderr::write_stream\", -1), [\n          EString(\"vibe: uncaught error: \")\n        ], -1), ESeq(ECall(EIdent(\"Stderr::write_stream\", -1), [\n          EIdent(\"__entry_err_msg\", -1)\n        ], -1), ESeq(ECall(EIdent(\"Stderr::write_stream\", -1), [\n          EString(\"\\n\")\n        ], -1), EInt(1))))\n        let wrapped = EHandle(body, [\n          (PCtor(\"Error::Throw\", [\n            PBind(\"__entry_err_msg\")\n          ]), diag)\n        ])\n        Array::set(stmts, i, SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, wrapped)))\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nexport fn compile_wasi_module_linked_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool, enable_rc: Bool, coverage: Bool, debug_trace: Bool, debug_break: Bool, rc_shadow: Bool, prov: DbgProv) -> Bytes with { Error } {\n  // ADR-0091 Phase 1: enforce `@zero_alloc` markers before any lowering\n  // rewrites the marked bodies. No-op when no marker is present.\n  let za_msg = zero_alloc_check(stmts)\n  if za_msg != \"\" {\n    throw(za_msg)\n  } else {\n    ()\n  }\n  // Method-bearing-trait dictionary passing (#641 PR-3). Universal codegen\n  // convergence point — runs here on the fully merged program before generic\n  // type params are stripped (just below). No-op unless a method-bearing trait\n  // is declared, and idempotent if an earlier pipeline stage already desugared.\n  desugar_trait_dicts(stmts)\n  // Top-level `let f = g` function aliases: retarget references to the final\n  // EFn def so calls do not route through the 0-param thunk registration\n  // below (invalid wasm for any call arity). See import_alias_rewrite.vibe.\n  rewrite_top_level_fn_alias_refs(stmts)\n  // #805: inline-wasm fns — extract WAT texts + neutralize marker bodies\n  // BEFORE any analysis below (see lc_extract_inline_wasm's doc comment).\n  let iw_names = lc_fresh_string_array()\n  let iw_wats = lc_fresh_string_array()\n  lc_extract_inline_wasm(stmts, iw_names, iw_wats)\n  // #tco: rewrite a top-level function's self-tail-recursive calls into the\n  // same ELetMut/EWhile/EBreak/EContinue shape `loop (...) { continue(...) }`\n  // already lowers to (see self_tail_call.vibe) -- zero wasm call-stack\n  // growth per recursive step instead of an unbounded `call`. No-op unless a\n  // function is directly self-tail-recursive; runs before the borrow/scalar-\n  // return analyses below so they see the rewritten (loop-shaped) body.\n  // #1230 (docs/spec/wasi-p3-async.md M1b-3c): expand `await(f)` into the\n  // suspend-and-retry loop a PENDING future needs. Runs right after\n  // desugar_trait_dicts (which is what produces the `await(..)` call of a\n  // `for await` loop) and BEFORE every effect pass below, so the\n  // `perform Async::Suspend(1)` it synthesizes is seen by them exactly like a\n  // hand-written one -- lowering `await` inside compile_call, where it used to\n  // live, is past the point where a perform can still be handled.\n  await_poll_pass(stmts)\n  rewrite_self_tail_calls(stmts)\n  // #944 (ADR-0073 stage C): entry-boundary Error handler -- see\n  // lc_wrap_entry_error_boundary's doc comment. Runs BEFORE the effect\n  // passes below so the synthesized handle is visible to them like any\n  // hand-written one, and before collect_used_builtin_names so the\n  // diagnostic's Stderr host import is collected.\n  lc_wrap_entry_error_boundary(stmts, entry_name)\n  // ADR-0076 (#817) Phase 2: inline `perform` calls that are structurally\n  // reachable-only-via-tail-resumptive-handler-arms directly into their\n  // handler arm body (single-shot fast path). Conservative: bails out\n  // per-handle whenever the handled body contains anything (nested\n  // `handle`, closures, or calls to named functions) that could hide a\n  // perform outside this direct scan, leaving those to evidence_dict_pass\n  // below (which, since 追記34 V2 removed the replay engine, hard-errors on\n  // any live non-Error handle it cannot migrate).\n  // ADR-0076 Phase 3a (#817, docs/effect-evidence-passing.md 追記27):\n  // depth-0 suspend CPS for handle sites whose arms capture `resume` as a\n  // first-class value (the suspend class -- ADR-0068's Async::suspend\n  // shape). Runs BEFORE the Phase 2 / evidence passes below so they only\n  // ever see the sites this pass left alone (a transformed site has no\n  // EHandle left at all). A triggered-but-ineligible site is a hard\n  // compile error -- a value-referencing arm cannot compile on the replay\n  // path, so silent fallback is not an option.\n  let scps_errs = suspend_cps_pass(stmts)\n  if Array::length(scps_errs) > 0 {\n    throw(Array::get(scps_errs, 0))\n  } else {\n    ()\n  }\n  inline_direct_performs(stmts)\n  // ADR-0076 (#817) Phase 3, first slice: evidence-dict threading for the\n  // narrow case Phase 2 above cannot reach on its own -- a handle body that\n  // calls a named top-level function which itself performs the handled\n  // effect (docs/effect-evidence-passing.md \"追記 2\", evidence_dict_pass's\n  // own doc comment in common_base/inline_direct_perform.vibe -- appended to\n  // that existing cross-file-registered file rather than a new one, to\n  // avoid the bootstrap flatten gotcha documented in docs/effectset.md).\n  // Runs after Phase 2 so it only sees the handles Phase 2 did\n  // not already fully inline; whole-program-conservative and strictly\n  // additive (per-effect all-or-nothing), so it never touches a handle or\n  // function Phase 2 already resolved or that this pass cannot prove safe.\n  let edp_errs = evidence_dict_pass(stmts, entry_name)\n  if Array::length(edp_errs) > 0 {\n    throw(Array::get(edp_errs, 0))\n  } else {\n    ()\n  }\n  // #707: functions whose entire body is transitively a tail-call to a\n  // borrow-returning builtin (Array::get/Map::get/__index) -- e.g. a thin\n  // `peek(toks, pos) -> Array::get(toks, pos)` wrapper. Computed once over the\n  // whole merged program and threaded into every function's Perceus plan so a\n  // `let v = peek(...)` binding (including the match-scrutinee-lift's\n  // `let __m_scrut = peek(...)`, see normalize/index.vibe) is recognized the\n  // same as a direct `let v = Array::get(...)` one.\n  // Sorted immediately (membership-only from here on: cc_is_borrow_ret_call /\n  // classify_let_value_heap query it once per call site across the whole\n  // program) so those lookups are bsearch_leftmost instead of a linear scan\n  // -- same rationale as ctor_table.names_sorted above.\n  let lc_borrow_ret_names = sorted_names_of(compute_borrow_returning_names(stmts))\n  // ADR-0092 borrow-inference slice 1: user fns whose arg0 ABI is borrowed\n  // program-wide (read-only first param, never valued/aliased -- see\n  // compute_borrow_arg0_user_fns). The entry fn and the conventional entry\n  // names are excluded: the host invokes them without consulting the set.\n  // ADR-0092 borrow-inference slice 1 -- DEFAULT OFF pending the\n  // per-use-paired planner vocabulary. Four failure classes have been\n  // isolated so far, each with its mechanism landed (all provably inert\n  // while this is false, since the borrow set is then empty):\n  // (1) over-release: a let-binding holding an UNOWNED interior view\n  // (value = call to a fn like agg_expr_lookup that returns a borrow-ret\n  // builtin result raw) whose uses all flip to borrows loses its entry\n  // dup while the retention-driven scope-end drop stays -- fixed by the\n  // planner's view-call drop suppression (PCtx.owned_uses/view_call_let).\n  // (2) fresh-result leak: suppressing that drop for EVERY borrow-arg0\n  // callee also cancels the release of FRESH results -- fixed by\n  // restricting the marking to callees that MAY RETURN a view\n  // (compute_may_return_view_fns, intersected into lc_borrow_view_ret).\n  // (3) temp-arg0 leak: a fresh temporary passed directly at a borrowed\n  // arg0 has no owner left to release it (the callee's epilogue drop is\n  // filtered program-wide) -- fixed by disqualifying fns ever called\n  // with a non-ident arg0 (ca_collect_nonident_arg0).\n  // (4) UNRESOLVED: with (1)-(3) combined, codegen_heap_e2e_test traps\n  // again and the RC reclamation guard still leaks 1.9MB -- changing the\n  // set's membership shuffles which latent per-binding imbalances are\n  // exercised (same fragility the original N=494/495 set bisection\n  // showed), so point-wise repairs do not converge. The sound endpoint\n  // is explicit per-use pairing in the plan (each dup tied to the\n  // consume it funds -- the ADR-0092 PaReuseToken/PaReuseAlloc planner\n  // vocabulary phase). Measured potential while enabled: RC selfcompile\n  // ratio 1.951 -> 1.71-1.80.\n  let lc_borrow_arg0_enabled = false\n  let lc_borrow_arg0_user_all = if lc_borrow_arg0_enabled {\n    compute_borrow_arg0_user_fns(stmts)\n  } else {\n    lc_fresh_string_array()\n  }\n  let lc_borrow_arg0_user = lc_fresh_string_array()\n  let mut lba_i = 0\n  while lba_i < Array::length(lc_borrow_arg0_user_all) {\n    let lba_n = Array::get(lc_borrow_arg0_user_all, lba_i)\n    if lba_n != entry_name && lba_n != \"main\" && lba_n != \"_start\" && lba_n != \"cli_main\" {\n      Array::push(lc_borrow_arg0_user, lba_n)\n    } else {\n      ()\n    }\n    lba_i = lba_i + 1\n  }\n  // The borrow-arg0 fns whose RETURN may be an unowned interior view: only\n  // these mark view_call_let in the planner (see PCtx.view_ret_user and the\n  // gate comment above). Intersection keeps the planner's marking check to\n  // one membership test.\n  let lc_borrow_view_all = if lc_borrow_arg0_enabled {\n    compute_may_return_view_fns(stmts)\n  } else {\n    lc_fresh_string_array()\n  }\n  let lc_borrow_view_ret = lc_fresh_string_array()\n  let mut lbv_i = 0\n  while lbv_i < Array::length(lc_borrow_view_all) {\n    let lbv_n = Array::get(lc_borrow_view_all, lbv_i)\n    if array_contains_str(lc_borrow_arg0_user, lbv_n) {\n      Array::push(lc_borrow_view_ret, lbv_n)\n    } else {\n      ()\n    }\n    lbv_i = lbv_i + 1\n  }\n  // #710: see CompileCtx.scalar_ret_names' doc comment (common_base/common_base.vibe).\n  let lc_scalar_ret_names = sorted_names_of(compute_scalar_returning_names(stmts))\n  let fn_names_list = lc_fresh_string_array()\n  let fn_param_counts = lc_fresh_int_array()\n  let fn_needs_env_list = lc_fresh_bool_array()\n  let fn_stmt_indices = lc_fresh_int_array()\n  let thunk_names_list = lc_fresh_string_array()\n  let const_int_names_list = lc_fresh_string_array()\n  let const_int_values_list = lc_fresh_int_array()\n  let export_fn_names = lc_fresh_string_array()\n  let export_fn_user_indices = lc_fresh_int_array()\n  let test_fn_names = lc_fresh_string_array()\n  let empty_tp = array_empty()\n  let empty_bounds = array_empty()\n  let empty_params = array_empty()\n  let mut pi = 0\n  while pi < Array::length(stmts) {\n    match Array::get(stmts, pi) {\n      STest(tname, tbody) => {\n        let test_fn = String::concat(\"__test_\", tname)\n        Array::push(test_fn_names, test_fn)\n        Array::set(stmts, pi, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))\n      },\n      SBench(bname, bbody) => {\n        let bench_fn = String::concat(\"__bench_\", bname)\n        Array::push(test_fn_names, bench_fn)\n        Array::set(stmts, pi, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))\n      },\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\n          Array::set(stmts, pi, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\n        }\n        ,\n        _ => ()\n      },\n      _ => ()\n    }\n    pi = pi + 1\n  }\n  if Array::length(test_fn_names) > 0 {\n    let mut has_entry = false\n    let mut ei = 0\n    while ei < Array::length(stmts) {\n      match Array::get(stmts, ei) {\n        SLet(is_exp, _, name, _, _) => if is_exp && name == entry_name {\n          has_entry = true\n        },\n        _ => ()\n      }\n      ei = ei + 1\n    }\n    if !has_entry {\n      ()\n    }\n  }\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if is_slet(stmt) {\n      let name = get_slet_name(stmt)\n      let expr = get_slet_expr(stmt)\n      let is_export = get_slet_export(stmt)\n      let user_idx = Array::length(fn_names_list)\n      // #715: `expr_tag(expr)` hoisted out of the `else` branch below and\n      // computed here, unconditionally -- so it (like `is_efn(expr)` above)\n      // contributes to `expr`'s always-consumed prefix instead of only being\n      // paid for on the `else` path. This alone still leaves the `else`\n      // branch's own nested if asymmetric (`get_eint_value`=1 use vs the\n      // thunk fallback's 0), so the thunk fallback below also aliases `expr`\n      // once (`let __sf_thunk_expr = expr`) to match. With both asymmetries\n      // resolved, `then` and `else` each consume `expr` the same number of\n      // times, so pc_emit's EIf MIN-merge (#705) lands on the SAME remaining\n      // count regardless of which branch a given statement actually takes --\n      // previously the merge could permanently assume more consumption than\n      // a commonly-taken branch (int-constant or thunk statements, which are\n      // NOT rare like a false `is_efn` check on a real function body) really\n      // performed, skipping the loop-body scope-end drop and leaking `expr`\n      // (a heap Expr node) on every such statement.\n      let __sf_etag = expr_tag(expr)\n      if is_efn(expr) {\n        let params = get_efn_params(expr)\n        Array::push(fn_names_list, name)\n        Array::push(fn_param_counts, Array::length(params))\n        Array::push(fn_needs_env_list, true)\n        Array::push(fn_stmt_indices, i)\n      } else {\n        if (__sf_etag == 0) && !is_export {\n          Array::push(const_int_names_list, name)\n          Array::push(const_int_values_list, get_eint_value(expr))\n        } else {\n          let __sf_thunk_expr = expr\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, 0)\n          Array::push(fn_needs_env_list, true)\n          Array::push(fn_stmt_indices, i)\n          Array::push(thunk_names_list, name)\n        }\n      }\n      if is_export || library_mode {\n        Array::push(export_fn_names, name)\n        Array::push(export_fn_user_indices, user_idx)\n      }\n    }\n    i = i + 1\n  }\n  let ctor_names_list = lc_fresh_string_array()\n  Array::push(ctor_names_list, \"None\")\n  Array::push(ctor_names_list, \"Some\")\n  let ctor_tags_list = lc_fresh_int_array()\n  Array::push(ctor_tags_list, 0)\n  Array::push(ctor_tags_list, 1)\n  let ctor_field_counts_list = lc_fresh_int_array()\n  Array::push(ctor_field_counts_list, 0)\n  Array::push(ctor_field_counts_list, 1)\n  let ctor_type_names_list = lc_fresh_string_array()\n  Array::push(ctor_type_names_list, \"Option\")\n  Array::push(ctor_type_names_list, \"Option\")\n  // #1062: sparse `ctor_idx * 64 + field_idx` entries for Double/Float-typed\n  // positional constructor fields (see CompileCtx.ctor_float_fields). Built\n  // alongside ctor_names_list/ctor_field_counts_list above so ctor_idx here\n  // always matches ctor_table_index_of's result for the same name.\n  let ctor_float_fields_list = lc_fresh_int_array()\n  let mut type_index = 1\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, _, variants, _) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          push_ctor_float_fields(ctor_float_fields_list, Array::length(ctor_names_list) - 1, vfields)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields, _, _, _) => {\n        type_index = type_index + 1\n        Array::push(ctor_names_list, sname)\n        Array::push(ctor_tags_list, type_index<<16)\n        Array::push(ctor_field_counts_list, Array::length(sfields))\n        Array::push(ctor_type_names_list, sname)\n        push_ctor_float_fields(ctor_float_fields_list, Array::length(ctor_names_list) - 1, struct_field_types(sfields))\n        0\n      },\n      SSuberror(_, ename, variants) => {\n        // #786: a suberror is a single-typed enum whose constructors produce a\n        // throwable value; register its ctors in the ctor table like an enum's\n        // so `KeyInvalid(\"x\")` allocates a tagged value instead of resolving to\n        // an undefined name at codegen.\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          push_ctor_float_fields(ctor_float_fields_list, Array::length(ctor_names_list) - 1, vfields)\n          vi = vi + 1\n        }\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n  let struct_names = lc_fresh_string_array()\n  let struct_field_names = lc_fresh_string_matrix()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, sname, sfields, _, _, _) => {\n        Array::push(struct_names, sname)\n        let fnames = lc_fresh_string_array()\n        let mut sfi = 0\n        while sfi < Array::length(sfields) {\n          let (fname, _) = Array::get(sfields, sfi)\n          Array::push(fnames, fname)\n          sfi = sfi + 1\n        }\n        Array::push(struct_field_names, fnames)\n        ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  // Sorted ctor-name index (see CtorTable.names_sorted): built once here,\n  // shared by this table literal and every per-function ctor_table below.\n  let (lc_ctor_names_sorted, lc_ctor_names_sorted_pos) = ctor_sorted_index(ctor_names_list)\n  // #724 round 2: (fn name -> declared aggregate return shape) table so\n  // `let a = f(..)` bindings participate in structural `==` (see\n  // compute_agg_returning in common_base).\n  let lc_agg_ret_names = lc_fresh_string_array()\n  let lc_agg_ret_infos = lc_fresh_int_array()\n  compute_agg_returning(stmts, CtorTable::{\n    names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: lc_ctor_names_sorted, names_sorted_pos: lc_ctor_names_sorted_pos\n  }, lc_agg_ret_names, lc_agg_ret_infos)\n  // #791: program-wide (fn name) set for declared-heap-returning top-level\n  // functions (see compute_heap_returning in perceus/index.vibe). Consulted\n  // by classify_let_value_heap (compile_expr_tail.vibe) to classify\n  // `let`/`let mut` bindings whose value is a call by the CALLEE's own\n  // declared signature, instead of always over-approximating every call as\n  // heap.\n  // Sorted for bsearch_leftmost membership at the classify_let_value_heap call\n  // site (compile_expr_tail.vibe) -- same rationale as lc_borrow_ret_names above.\n  let lc_heap_ret_names = sorted_names_of(compute_heap_returning(stmts))\n  let num_user_funcs = Array::length(fn_names_list)\n  if num_user_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n  let mut entry_user_idx = -1\n  let mut ei = 0\n  while ei < num_user_funcs {\n    if Array::get(fn_names_list, ei) == entry_name {\n      entry_user_idx = ei\n    }\n    ei = ei + 1\n  }\n  // ADR-0069 Phase 1: a missing entry is a compile error. Historically ANY\n  // unknown entry name fell through to the test-runner `_start` synthesis, so\n  // an entry typo silently produced a no-op module. Only the explicit\n  // `__no_entry__` sentinel (vibe test / bench) may synthesize the test runner\n  // now. Library mode passes a synthetic entry name it never calls, so it is\n  // exempt.\n  if entry_user_idx < 0 && !library_mode && entry_name != \"__no_entry__\" {\n    throw(\"entry `\\{entry_name}` not found: no exported function named `\\{entry_name}` (use __no_entry__ to build a test runner)\")\n  }\n  let str_strs = collect_strings_stmts(stmts)\n  let rec add_map_keys_expr: (Expr) -> Unit = (e) -> {\n    match e {\n      EMap(fields) => {\n        let mut mi = 0\n        while mi < Array::length(fields) {\n          let (key, val) = Array::get(fields, mi)\n          if !array_contains_str(str_strs, key) {\n            Array::push(str_strs, key)\n          }\n          add_map_keys_expr(val)\n          mi = mi + 1\n        }\n      },\n      EStringInterp(parts) => {\n        let mut pi3 = 0\n        while pi3 < Array::length(parts) {\n          if pi3 % 2 == 0 {\n            let part = Array::get(parts, pi3)\n            if String::length(part) > 0 && !array_contains_str(str_strs, part) {\n              Array::push(str_strs, part)\n            }\n          }\n          pi3 = pi3 + 1\n        }\n      },\n      ELet(_, val, body, _) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ELetMut(_, val, body, _) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ELetRec(_, val, body) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ESeq(a, b) => {\n        add_map_keys_expr(a); add_map_keys_expr(b)\n      },\n      EIf(c, t, e) => {\n        add_map_keys_expr(c); add_map_keys_expr(t); add_map_keys_expr(e)\n      },\n      EFn(_, _, _, _, _, body) => add_map_keys_expr(body),\n      EHandle(body, _) => add_map_keys_expr(body),\n      ECall(callee, args, _) => {\n        add_map_keys_expr(callee)\n        let mut ai = 0\n        while ai < Array::length(args) {\n          add_map_keys_expr(Array::get(args, ai))\n          ai = ai + 1\n        }\n      },\n      _ => ()\n    }\n  }\n  let mut __mk = 0\n  while __mk < Array::length(stmts) {\n    match Array::get(stmts, __mk) {\n      SLet(_, _, _, _, expr) => add_map_keys_expr(expr),\n      STest(_, expr) => add_map_keys_expr(expr),\n      SBench(_, expr) => add_map_keys_expr(expr),\n      _ => ()\n    }\n    __mk = __mk + 1\n  }\n  // Always seed the empty string so codegen that materialises \"\" (e.g.\n  // StringBuilder::freeze's join separator, Stream::to_string's accumulator)\n  // can rely on str_table_lookup(\"\") succeeding even when the source never\n  // mentions \"\" literally.\n  if !array_contains_str(str_strs, \"\") {\n    Array::push(str_strs, \"\")\n  }\n  let src_str_base = Array::length(str_strs)\n  let num_src_pairs = Array::length(srcs)\n  let mut __src_i = 0\n  while __src_i < num_src_pairs {\n    let (__src_path, __src_content) = Array::get(srcs, __src_i)\n    Array::push(str_strs, __src_path)\n    Array::push(str_strs, __src_content)\n    __src_i = __src_i + 1\n  }\n  let num_strings = Array::length(str_strs)\n  let data_base = 64\n  let str_offsets = lc_fresh_int_array()\n  let str_lengths = lc_fresh_int_array()\n  let mut str_pos = data_base\n  let mut si = 0\n  while si < num_strings {\n    let s = Array::get(str_strs, si)\n    let slen = String::length(s)\n    Array::push(str_offsets, str_pos)\n    Array::push(str_lengths, slen)\n    str_pos = str_pos + slen\n    si = si + 1\n  }\n  let heap_start = ((str_pos + 7) / 8) * 8\n  let effect_names_list = lc_fresh_string_array()\n  let effect_op_keys_list = lc_fresh_string_array()\n  let effect_op_arities_list = array_empty()\n  let mut eff_collect_i = 0\n  while eff_collect_i < Array::length(stmts) {\n    match Array::get(stmts, eff_collect_i) {\n      SEffectDef(_, eff_name, _, ops) => {\n        if eff_name != \"Error\" && !array_contains_str(effect_names_list, eff_name) {\n          Array::push(effect_names_list, eff_name)\n        } else {\n          ()\n        }\n        let mut op_i = 0\n        while op_i < Array::length(ops) {\n          let (op_name, op_params, _) = Array::get(ops, op_i)\n          Array::push(effect_op_keys_list, String::concat(String::concat(eff_name, \"::\"), op_name))\n          Array::push(effect_op_arities_list, Array::length(op_params))\n          op_i = op_i + 1\n        }\n      },\n      _ => ()\n    }\n    eff_collect_i = eff_collect_i + 1\n  }\n  // ADR-0076 追記34 V2: the per-effect replay regions (#553 -- perform\n  // counter / resume-memo control words + memo array, 131072 B per effect\n  // tag) are gone with the replay engine itself. Nothing reads or writes\n  // below-frontier effect words anymore (perform lowers to a direct\n  // builtin call or a bare throw; `resume` never reaches codegen), so the\n  // reserve is zero and the heap frontier moves down by (n_effects+1) *\n  // 128 KiB per module.\n  let eff_reserve = 0\n  // Function-level coverage (gated by `coverage`): a 1-byte-per-user-function\n  // hit bitmap placed in a dedicated reserve ABOVE the effect regions and BELOW\n  // the heap frontier, so it never collides with effect words or the live heap.\n  // `cov_base` is a compile-time-constant address baked into each function's\n  // prologue store. When coverage is off, cov_reserve is 0 and codegen output is\n  // byte-identical to the normal build (the self-host fixpoint is unaffected).\n  let cov_count = num_user_funcs\n  let cov_base = heap_start + eff_reserve\n  let cov_reserve = if coverage {\n    ((cov_count + 7) / 8) * 8\n  } else {\n    0\n  }\n  // #cov branch coverage: a second 1-byte-per-branch hit region directly above\n  // the function-hit region. Branch ids are assigned sequentially during codegen\n  // (CovState.next), so the count is not known up front — reserve a fixed cap.\n  // 65536 branches is generous headroom (the whole compiler has a few thousand).\n  // Off => branch_reserve is 0 and the layout/codegen is byte-identical.\n  let cov_branch_cap = 65536\n  let cov_branch_base = cov_base + cov_reserve\n  let cov_branch_reserve = if coverage {\n    cov_branch_cap\n  } else {\n    0\n  }\n  // Function-call execution trace (debugger / DAP P1 groundwork, gated by\n  // `debug_trace`). A dedicated region directly above the coverage regions and\n  // below the heap frontier holds a 4-byte counter cell followed by a fixed-cap\n  // log of i32 slots. Each user function's entry, in debug mode, appends its\n  // own user index to the log (counter-bounded). A `vibe.trace` custom section\n  // records the layout + function names so the runner can dump the entry\n  // sequence. Off => trace_reserve is 0 and the layout/codegen is byte-identical\n  // to a normal build (the self-host fixpoint is unaffected).\n  let trace_cap = 4096\n  let trace_counter_addr = cov_branch_base + cov_branch_reserve\n  let trace_log_base = trace_counter_addr + 4\n  let trace_reserve = if debug_trace {\n    4 + trace_cap * 4\n  } else {\n    0\n  }\n  // debugger argument inspection (DAP P2, gated by `debug_break`). A dedicated\n  // region directly above the trace region holds a 4-byte count cell followed by\n  // a fixed-cap array of i64 slots. At each user function entry, in break mode,\n  // the function's i64 parameters are spilled here (capped at dbgargs_cap) and\n  // the count cell is set, BEFORE calling the `vibe::dbg_break` host hook. The\n  // hook reads them out of guest memory and prints `args: [...]`. A\n  // `vibe.dbgargs` custom section publishes the two addresses to the runner.\n  // Off => dbgargs_reserve is 0 and the layout/codegen is byte-identical to a\n  // normal build (the self-host fixpoint is unaffected).\n  let dbgargs_cap = 16\n  let dbgargs_count_addr = trace_counter_addr + trace_reserve\n  let dbgargs_base = dbgargs_count_addr + 8\n  let dbgargs_reserve = if debug_break {\n    8 + dbgargs_cap * 8\n  } else {\n    0\n  }\n  // ADR-0092 (#1262) KPI follow-up 2: size-segregated free-list bins for\n  // small RC blocks. 32 bin heads (4 bytes each, sizes 16..264 step 8) live\n  // just below the bump base; the bump base moves up by the 128-byte table\n  // (rounded to 256 for alignment headroom). Linear memory is zero-page\n  // initialized and the data segments end below heap_start, so the bins\n  // start empty without an explicit memset. gen_rc_drop_body pushes\n  // small freed blocks onto their exact-size bin (O(1) exact fit on the\n  // alloc side); everything else stays on the legacy global-2 list with\n  // the bounded walk.\n  let rc_bins_base = heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve\n  let rc_bins_reserve = if enable_rc {\n    256\n  } else {\n    0\n  }\n  let cov_state = CovState::{\n    enabled: coverage,\n    base: cov_branch_base,\n    cap: cov_branch_cap,\n    next: [\n      0\n    ],\n    cur_fn: [\n      0\n    ],\n    owners: ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  // #799 perf: ONE program walk collecting the canonical free-name set,\n  // then every need_<builtin> flag below is a map lookup. Previously each\n  // flag re-walked the whole AST (~40 walks) with a linear fn_names scan per\n  // ident inside.\n  let used_builtin_names = collect_used_builtin_names(stmts, fn_names_list)\n  let need_env_get_builtin = Map::has_key(used_builtin_names, \"Env::get\")\n  let need_env_args_len_builtin = Map::has_key(used_builtin_names, \"Env::args_len\")\n  let need_env_args_get_builtin = Map::has_key(used_builtin_names, \"Env::args_get\")\n  let need_fs_read_file_builtin = Map::has_key(used_builtin_names, \"Fs::read_file\")\n  let need_fs_exists_builtin = Map::has_key(used_builtin_names, \"Fs::exists\")\n  // #795: vibe_fs_stat_token_raw is the alias-collision-proof surface for the\n  // same import (lib/@vibe/fs/fs.vibe calls it; see checker/builtins_fs.vibe).\n  let need_fs_stat_token_builtin = Map::has_key(used_builtin_names, \"Fs::stat_token\") || Map::has_key(used_builtin_names, \"vibe_fs_stat_token_raw\")\n  let need_fs_write_file_builtin = Map::has_key(used_builtin_names, \"Fs::write_file\")\n  let need_fs_write_bytes_builtin = Map::has_key(used_builtin_names, \"Fs::write_bytes\")\n  // #632: `Fs::read_bytes(path) -> Bytes` — the binary-exact read counterpart of\n  // Fs::write_bytes, a `vibe.fs_read_bytes (i64) -> i64` host import (type 3,\n  // same shape as fs_read_file). Gated on use so non-users reserve no import\n  // (fixpoint-safe). Lets the persistent artifact cache store/load wasm raw.\n  let need_fs_read_bytes_builtin = Map::has_key(used_builtin_names, \"Fs::read_bytes\")\n  // #729/#730: `Fs::readdir(path) -> Array[String]` — a `vibe.fs_read_dir\n  // (i64) -> i64` host import (type 3, same packed-string shape as\n  // fs_read_file: the host returns the byte-sorted entry NAMES \"\\n\"-joined as\n  // ONE string, no host-side array building). compile_call lowers the\n  // Array[String] surface to `String::split` over that string. Gated on use\n  // (fixpoint-safe). Unblocks contract-package sibling auto-discovery and the\n  // global store walk.\n  let need_fs_readdir_builtin = Map::has_key(used_builtin_names, \"Fs::readdir\")\n  let need_profiler_now_us_builtin = Map::has_key(used_builtin_names, \"Profiler::now_us\")\n  // `Profiler::heap_bytes() -> Int`: a `vibe.profile-heap-bytes () -> i64`\n  // host import (type 5, same shape as profile-now-us). Returns the guest's\n  // current bump-heap pointer (`__heap_ptr`) so vibe code can attribute its\n  // own allocation growth per phase, mirroring how now_us attributes time.\n  // Gated on use so non-users reserve no import (fixpoint-safe).\n  let need_profiler_heap_bytes_builtin = Map::has_key(used_builtin_names, \"Profiler::heap_bytes\")\n  // `sleep(ms)` (Async): a `vibe.sleep (i64) -> ()` host import. The host\n  // implements it as an async function so the guest fiber genuinely\n  // suspends/resumes (docs/spec/wasi-p3-async.md §2.3, examples/async_host).\n  // Gated on use, so programs without `sleep` reserve no import (fixpoint-safe).\n  let need_sleep_builtin = Map::has_key(used_builtin_names, \"sleep\") || Map::has_key(used_builtin_names, \"sleep_blocking\")\n  // `Stdin::read_char() -> Int`: a value-returning `vibe.stdin_read_char () ->\n  // i64` host import. Implemented async by the host (it can suspend the guest\n  // until a char is available), so this is the data-consuming analog of `sleep`\n  // — the shape of a host async source (HTTP body byte, stdin char). Gated on\n  // use (fixpoint-safe).\n  let need_stdin_read_char_builtin = Map::has_key(used_builtin_names, \"Stdin::read_char\")\n  // Process effect host imports: `sh(cmd)` runs a shell command (returns 0) and\n  // `sh_lines(cmd)` returns its stdout \"\\n\"-joined as ONE string (same packed\n  // ABI as fs_read_dir; compile_call lowers the Array[String] surface to a\n  // String::split). Both `vibe.sh` / `vibe.sh_lines (i64) -> i64` host imports,\n  // gated on use so non-users reserve no import (fixpoint-safe). Revives the\n  // process/time/shell stdlib whose functions call these.\n  let need_sh_builtin = Map::has_key(used_builtin_names, \"sh\")\n  let need_sh_lines_builtin = Map::has_key(used_builtin_names, \"sh_lines\")\n  // #865: structured subprocess result host imports -- `vibe_sh_capture_raw`\n  // runs the command once (handle), the three accessors read the cached\n  // {exit_code, stdout, stderr}, `vibe_sh_capture_close_raw` frees it. Same\n  // handle+accessor shape as the #794 HTTP client imports below. Gated on\n  // use, same fixpoint-safety discipline as sh/sh_lines above.\n  let need_sh_capture_builtin = Map::has_key(used_builtin_names, \"vibe_sh_capture_raw\")\n  let need_sh_capture_exit_code_builtin = Map::has_key(used_builtin_names, \"vibe_sh_capture_exit_code_raw\")\n  let need_sh_capture_stdout_builtin = Map::has_key(used_builtin_names, \"vibe_sh_capture_stdout_raw\")\n  let need_sh_capture_stderr_builtin = Map::has_key(used_builtin_names, \"vibe_sh_capture_stderr_raw\")\n  let need_sh_capture_close_builtin = Map::has_key(used_builtin_names, \"vibe_sh_capture_close_raw\")\n  // #903/#865: `Process::exit(code) -> Unit` -- propagates the guest's exit\n  // code to the real OS process exit status via the host runner's\n  // exit-trap mechanism (never returns in practice, but is typed Unit --\n  // there's no `Never` type). `vibe.process_exit (i64) -> ()` host import,\n  // void like Fs::remove/sh_capture_close, gated on use (fixpoint-safe).\n  let need_process_exit_builtin = Map::has_key(used_builtin_names, \"vibe_process_exit_raw\")\n  // Stdin/Stdout host effects for vibe/io: `Stdin::read_stream(n) -> String`\n  // (`vibe.stdin_read_stream (i64) -> i64`, value-returning like fs_read_file),\n  // `Stdout::write_stream(s) -> Unit` and `Stdout::write_char(c) -> Unit`\n  // (`vibe.stdout_write_stream` / `vibe.stdout_write_char (i64) -> ()`, void like\n  // sleep). All gated on use so non-users reserve no import (fixpoint-safe) —\n  // the compiler's own build uses none, so its bytes are unchanged. Revives the\n  // io stdlib whose read/print/println/write_char helpers call these builtins.\n  let need_stdin_read_stream_builtin = Map::has_key(used_builtin_names, \"Stdin::read_stream\")\n  // #929: the println/print BUILTIN lowering (compile_call.vibe) synthesizes\n  // calls onto these two imports when no source-provided println/print is\n  // merged, so their use also gates the imports in. collect_used_builtin_names\n  // only counts FREE names -- a program using @vibe/io's (or its own) println\n  // fn does not trip this, exactly matching the lowering's cc_ft_has guard.\n  let used_print_builtin = Map::has_key(used_builtin_names, \"println\") || Map::has_key(used_builtin_names, \"print\")\n  let need_stdout_write_stream_builtin = Map::has_key(used_builtin_names, \"Stdout::write_stream\") || used_print_builtin\n  let need_stdout_write_char_builtin = Map::has_key(used_builtin_names, \"Stdout::write_char\") || used_print_builtin\n  // #865: `Stderr::write_stream(s) -> Unit` / `Stderr::write_char(c) -> Unit`\n  // (`vibe.stderr_write_stream` / `vibe.stderr_write_char (i64) -> ()`, void\n  // like stdout's), same shapes/gating as the Stdout pair above.\n  let need_stderr_write_stream_builtin = Map::has_key(used_builtin_names, \"Stderr::write_stream\")\n  let need_stderr_write_char_builtin = Map::has_key(used_builtin_names, \"Stderr::write_char\")\n  // #762: `Path::ref` / `Path::resolve` both lower (compile_call) to the\n  // `resolve_path` host import — resolve a path to absolute against the process\n  // CWD. `vibe.resolve_path (i64) -> i64`, value-returning like fs_read_file,\n  // gated on either surface name so non-users reserve no import (fixpoint-safe).\n  let need_resolve_path_builtin = Map::has_key(used_builtin_names, \"Path::ref\") || Map::has_key(used_builtin_names, \"Path::resolve\")\n  // #768: `Fs::remove(path) -> Unit` — a `vibe.fs_remove (i64) -> ()` host\n  // import (type 1, like sleep/stdout_write_char). Checker-recognized since\n  // `builtins_fs.vibe`'s `lookup_fs_remove` but never wired to codegen, so any\n  // caller hit \"undefined variable (local): Fs::remove @call\". Gated on use so\n  // non-users reserve no import (fixpoint-safe).\n  let need_fs_remove_builtin = Map::has_key(used_builtin_names, \"Fs::remove\")\n  // #768: `Fs::mkdir_p(path) -> Unit` (recursive mkdir) — same shape/import\n  // type as Fs::remove. Same gap: checker-recognized (builtins_fs.vibe's\n  // lookup_fs_mkdir_p) but had no codegen wiring at all.\n  let need_fs_mkdir_p_builtin = Map::has_key(used_builtin_names, \"Fs::mkdir_p\")\n  // #768: the rest of lib/@vibe/shell/commands.vibe's Fs surface — same\n  // \"checker-legal (or newly made so), zero codegen wiring\" gap as\n  // Fs::remove/Fs::mkdir_p, and the JS host runner already implements all of\n  // fs_mkdir/fs_chdir/fs_copy/fs_append/fs_rename/fs_is_dir/fs_is_file/\n  // fs_getcwd. Fs::mkdir (non-recursive, distinct from Fs::mkdir_p) was\n  // likewise checker-legal but had no codegen wiring at all.\n  let need_fs_mkdir_builtin = Map::has_key(used_builtin_names, \"Fs::mkdir\")\n  let need_fs_chdir_builtin = Map::has_key(used_builtin_names, \"Fs::chdir\")\n  let need_fs_copy_builtin = Map::has_key(used_builtin_names, \"Fs::copy\")\n  let need_fs_append_builtin = Map::has_key(used_builtin_names, \"Fs::append\")\n  let need_fs_rename_builtin = Map::has_key(used_builtin_names, \"Fs::rename\")\n  let need_fs_is_dir_builtin = Map::has_key(used_builtin_names, \"Fs::is_dir\")\n  let need_fs_is_file_builtin = Map::has_key(used_builtin_names, \"Fs::is_file\")\n  let need_fs_getcwd_builtin = Map::has_key(used_builtin_names, \"Fs::getcwd\")\n  // Socket::tcp_connect/tcp_read/tcp_write/tcp_close -- same \"checker-legal\n  // (builtins/declarations.vibe + builtin_registry.vibe), zero codegen\n  // wiring\" gap as the Fs::* additions above: the checker accepts these\n  // calls (lib/@vibe/socket/tcp.vibe's low-level layer), but linked_compile\n  // never emitted the host imports, so any real caller hit \"undefined\n  // variable (local): Socket::tcp_connect @call\". Gated on use so non-users\n  // reserve no import (fixpoint-safe).\n  let need_tcp_connect_builtin = Map::has_key(used_builtin_names, \"vibe_tcp_connect_raw\")\n  let need_tcp_read_builtin = Map::has_key(used_builtin_names, \"vibe_tcp_read_raw\")\n  let need_tcp_write_builtin = Map::has_key(used_builtin_names, \"vibe_tcp_write_raw\")\n  let need_tcp_close_builtin = Map::has_key(used_builtin_names, \"vibe_tcp_close_raw\")\n  // #794: HTTP client host imports. lib/@vibe/http's client functions call\n  // the `__http_*_raw` builtins (dunder names so units bundling the package's\n  // index.vibe -- which exports alias functions literally named\n  // `Http::request` etc. -- cannot capture the ident, see #795). Each lowers\n  // to a `vibe.http_*` host import, gated on use (fixpoint-safe: the compiler\n  // itself uses none, so its bytes are unchanged).\n  let need_http_request_builtin = Map::has_key(used_builtin_names, \"vibe_http_request_raw\")\n  let need_http_response_status_builtin = Map::has_key(used_builtin_names, \"vibe_http_response_status_raw\")\n  let need_http_response_header_builtin = Map::has_key(used_builtin_names, \"vibe_http_response_header_raw\")\n  let need_http_response_body_builtin = Map::has_key(used_builtin_names, \"vibe_http_response_body_raw\")\n  let need_http_close_builtin = Map::has_key(used_builtin_names, \"vibe_http_close_raw\")\n  let mut next_import_idx = 1\n  let env_get_import_idx = if need_env_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_len_import_idx = if need_env_args_len_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_get_import_idx = if need_env_args_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_read_file_import_idx = if need_fs_read_file_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_exists_import_idx = if need_fs_exists_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_stat_token_import_idx = if need_fs_stat_token_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_write_file_import_idx = if need_fs_write_file_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_write_bytes_import_idx = if need_fs_write_bytes_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #632: reserved immediately after fs_write_bytes; the import emission below\n  // must stay in this same order so the index matches the descriptor.\n  let fs_read_bytes_import_idx = if need_fs_read_bytes_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #729/#730: reserved immediately after fs_read_bytes; the import emission\n  // below must stay in this same order so the index matches the descriptor.\n  let fs_read_dir_import_idx = if need_fs_readdir_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let profiler_now_us_import_idx = if need_profiler_now_us_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // reserved immediately after profile-now-us; the import emission below must\n  // stay in this same order so the index matches the descriptor.\n  let profiler_heap_bytes_import_idx = if need_profiler_heap_bytes_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let sleep_import_idx = if need_sleep_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let stdin_read_char_import_idx = if need_stdin_read_char_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // reserved immediately after stdin_read_char; the import emission below must\n  // stay in this same order so the index matches the descriptor.\n  let sh_import_idx = if need_sh_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let sh_lines_import_idx = if need_sh_lines_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // reserved immediately after sh_lines; the import emission below must stay in\n  // this same order so the index matches the descriptor.\n  let stdin_read_stream_import_idx = if need_stdin_read_stream_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let stdout_write_stream_import_idx = if need_stdout_write_stream_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let stdout_write_char_import_idx = if need_stdout_write_char_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // reserved immediately after stdout_write_char; the import emission below must\n  // stay in this same order so the index matches the descriptor.\n  let resolve_path_import_idx = if need_resolve_path_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #768: reserved immediately after resolve_path; the import emission below\n  // must stay in this same order so the index matches the descriptor.\n  let fs_remove_import_idx = if need_fs_remove_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #768: reserved immediately after fs_remove; the import emission below must\n  // stay in this same order so the index matches the descriptor.\n  let fs_mkdir_p_import_idx = if need_fs_mkdir_p_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #768: reserved immediately after fs_mkdir_p, in this fixed order; the\n  // import emission below must match.\n  let fs_mkdir_import_idx = if need_fs_mkdir_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_chdir_import_idx = if need_fs_chdir_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_copy_import_idx = if need_fs_copy_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_append_import_idx = if need_fs_append_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_rename_import_idx = if need_fs_rename_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_is_dir_import_idx = if need_fs_is_dir_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_is_file_import_idx = if need_fs_is_file_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_getcwd_import_idx = if need_fs_getcwd_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // Socket imports -- reserved after fs_getcwd (before HTTP), in the same\n  // order as their emission below.\n  let tcp_connect_import_idx = if need_tcp_connect_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let tcp_read_import_idx = if need_tcp_read_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let tcp_write_import_idx = if need_tcp_write_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let tcp_close_import_idx = if need_tcp_close_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #794: HTTP client imports -- reserved after fs_getcwd (before dbg_break),\n  // in the same order as their emission below.\n  let http_request_import_idx = if need_http_request_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let http_response_status_import_idx = if need_http_response_status_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let http_response_header_import_idx = if need_http_response_header_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let http_response_body_import_idx = if need_http_response_body_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let http_close_import_idx = if need_http_close_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #865: `Process::capture` host imports -- reserved after http_close\n  // (before dbg_break), in the same order as their emission below. All five\n  // reuse EXISTING base func types (3 = `(i64)->i64`, 1 = `(i64)->()`), so no\n  // new type-section entry is needed (unlike #794's http_request).\n  let sh_capture_import_idx = if need_sh_capture_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let sh_capture_exit_code_import_idx = if need_sh_capture_exit_code_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let sh_capture_stdout_import_idx = if need_sh_capture_stdout_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let sh_capture_stderr_import_idx = if need_sh_capture_stderr_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let sh_capture_close_import_idx = if need_sh_capture_close_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #903/#865: `Process::exit(code)` host import -- void like Fs::remove\n  // (type 1), reserved after sh_capture_close, before Stderr.\n  let process_exit_import_idx = if need_process_exit_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #865: `Stderr::write_stream` / `Stderr::write_char` host imports --\n  // reserved after sh_capture_close (before dbg_break), same shapes as the\n  // Stdout pair (type 3 value-returning is N/A here; both are void type 1).\n  let stderr_write_stream_import_idx = if need_stderr_write_stream_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let stderr_write_char_import_idx = if need_stderr_write_char_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // debugger breakpoint (DAP P1): in break mode emit a conditional `vibe::dbg_break`\n  // host import (() -> ()) called at each user-function entry. Default OFF, so\n  // num_imported_funcs / func_offset are unchanged for normal builds (fixpoint).\n  let dbg_break_import_idx = if debug_break {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // Interior-line breakpoints (span-arc step5): in break mode with per-file\n  // provenance, reserve a `vibe::dbg_line (i32 file_id, i32 line) -> ()` host\n  // import called at each statement boundary. Each function's line is mapped\n  // against ITS OWN source file (prov.file_nls[file_id]) so multi-file entries\n  // work. Gated on `debug_break && prov has files`, so default builds reserve\n  // nothing and stay byte-identical.\n  let dbg_line_on = debug_break && Array::length(prov.files) > 0\n  let dbg_line_import_idx = if dbg_line_on {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let linked_import_indices = lc_fresh_int_array()\n  let linked_import_names = lc_fresh_string_array()\n  let mut li_i = 0\n  while li_i < Array::length(linked_imports) {\n    let (_, lfn_name, _, _) = Array::get(linked_imports, li_i)\n    Array::push(linked_import_indices, next_import_idx)\n    Array::push(linked_import_names, lfn_name)\n    next_import_idx = next_import_idx + 1\n    li_i = li_i + 1\n  }\n  let num_imported_funcs = next_import_idx\n  // #644: static (wasm code offset -> file/line) recorder for the\n  // `vibe.linemap` custom section, shared by reference across every\n  // top-level function's CompileCtx (mirrors cov_state above). Enabled\n  // exactly when interior-line probes are (dbg_line_on): the linemap\n  // records the SAME probe sites the live `--break`/dbg_line hook uses.\n  let linemap_state = LineMapState::{\n    enabled: dbg_line_on,\n    cur_fn: [\n      0\n    ],\n    funcs: lc_fresh_int_array(),\n    offsets: lc_fresh_int_array(),\n    file_ids: lc_fresh_int_array(),\n    lines: lc_fresh_int_array()\n  }\n  let print_int_idx = num_imported_funcs\n  let print_str_idx = print_int_idx + 1\n  let str_len_idx = print_str_idx + 1\n  let str_eq_idx = str_len_idx + 1\n  let str_concat_idx = str_eq_idx + 1\n  let arr_new_idx = str_concat_idx + 1\n  let arr_len_idx = arr_new_idx + 1\n  let arr_get_idx = arr_len_idx + 1\n  let arr_push_idx = arr_get_idx + 1\n  let arr_set_idx = arr_push_idx + 1\n  let double_to_int_idx = arr_set_idx + 1\n  let int_to_double_idx = double_to_int_idx + 1\n  let str_char_code_at_idx = int_to_double_idx + 1\n  let str_from_char_code_idx = str_char_code_at_idx + 1\n  let str_substring_idx = str_from_char_code_idx + 1\n  let identity_idx = str_substring_idx + 1\n  let arr_slice_idx = identity_idx + 1\n  let arr_concat_idx = arr_slice_idx + 1\n  let arr_truncate_idx = arr_concat_idx + 1\n  let string_join_idx = arr_truncate_idx + 1\n  let fs_read_file_stub_idx = string_join_idx + 1\n  let fs_exists_stub_idx = fs_read_file_stub_idx + 1\n  let fs_stat_token_stub_idx = fs_exists_stub_idx + 1\n  let fs_write_file_stub_idx = fs_stat_token_stub_idx + 1\n  let fs_write_bytes_stub_idx = fs_write_file_stub_idx + 1\n  let eq_idx = fs_write_bytes_stub_idx + 1\n  let string_ends_with_idx = eq_idx + 1\n  let string_last_index_of_idx = string_ends_with_idx + 1\n  let arr_push_all_idx = string_last_index_of_idx + 1\n  let string_index_of_idx = arr_push_all_idx + 1\n  let string_contains_idx = string_index_of_idx + 1\n  let string_starts_with_idx = string_contains_idx + 1\n  let string_split_idx = string_starts_with_idx + 1\n  let string_trim_idx = string_split_idx + 1\n  let sources_idx = string_trim_idx + 1\n  let bytes_new_idx = sources_idx + 1\n  let bytes_len_idx = bytes_new_idx + 1\n  let bytes_get_idx = bytes_len_idx + 1\n  let bytes_set_idx = bytes_get_idx + 1\n  let bytes_push_idx = bytes_set_idx + 1\n  let bytes_append_idx = bytes_push_idx + 1\n  let bytes_concat_idx = bytes_append_idx + 1\n  let bytes_slice_idx = bytes_concat_idx + 1\n  let bytes_from_array_idx = bytes_slice_idx + 1\n  let bytes_to_array_idx = bytes_from_array_idx + 1\n  let rc_drop_idx = bytes_to_array_idx + 1\n  let rc_alloc_idx = rc_drop_idx + 1\n  let heap_grow_check_idx = if enable_rc {\n    rc_alloc_idx + 1\n  } else {\n    bytes_to_array_idx + 1\n  }\n  let simd_skip_ws_idx = heap_grow_check_idx + 1\n  let simd_scan_alnum_idx = simd_skip_ws_idx + 1\n  let simd_scan_alnum_str_idx = simd_scan_alnum_idx + 1\n  let str_lex_diff_idx = simd_scan_alnum_str_idx + 1\n  // #973: erased-generic `[T: Ord]`/`[T: Add]` runtime dispatch (see the doc\n  // comment on gen_generic_rel_diff_body). Linear lane only -- desugar_trait_dicts\n  // is only invoked from this file, so no gc-lane index is needed.\n  let generic_rel_diff_idx = str_lex_diff_idx + 1\n  let generic_add_idx = generic_rel_diff_idx + 1\n  // Map[String,V] O(1)-average get/has_key (side hash index, see the doc\n  // comment on gen_map_hash_body in builtin_bodies/bodies_core_b.vibe).\n  // Linear lane only -- gc lane's Map stays the existing O(n) scan.\n  let map_hash_idx = generic_add_idx + 1\n  let map_cap_idx = map_hash_idx + 1\n  let map_index_insert_idx = map_cap_idx + 1\n  let map_build_index_idx = map_index_insert_idx + 1\n  let map_probe_index_idx = map_build_index_idx + 1\n  let env_get_idx = if env_get_import_idx >= 0 {\n    env_get_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let env_args_len_idx = if env_args_len_import_idx >= 0 {\n    env_args_len_import_idx\n  } else {\n    fs_exists_stub_idx\n  }\n  let env_args_get_idx = if env_args_get_import_idx >= 0 {\n    env_args_get_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let fs_read_file_idx = if fs_read_file_import_idx >= 0 {\n    fs_read_file_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let fs_exists_idx = if fs_exists_import_idx >= 0 {\n    fs_exists_import_idx\n  } else {\n    fs_exists_stub_idx\n  }\n  let fs_stat_token_idx = if fs_stat_token_import_idx >= 0 {\n    fs_stat_token_import_idx\n  } else {\n    fs_stat_token_stub_idx\n  }\n  let fs_write_file_idx = if fs_write_file_import_idx >= 0 {\n    fs_write_file_import_idx\n  } else {\n    fs_write_file_stub_idx\n  }\n  let fs_write_bytes_idx = if fs_write_bytes_import_idx >= 0 {\n    fs_write_bytes_import_idx\n  } else {\n    fs_write_bytes_stub_idx\n  }\n  // #632: no dedicated stub — when read_bytes is unused the builtin index just\n  // needs SOME valid never-called slot, so reuse the fs_read_file stub (a\n  // `(i64)->i64` placeholder). The real call site only exists when the import is\n  // reserved.\n  let fs_read_bytes_idx = if fs_read_bytes_import_idx >= 0 {\n    fs_read_bytes_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  // #729/#730: like read_bytes, no dedicated stub — unused readdir reuses the\n  // fs_read_file stub (a `(i64)->i64` never-called placeholder).\n  let fs_read_dir_idx = if fs_read_dir_import_idx >= 0 {\n    fs_read_dir_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let profiler_now_us_idx = if profiler_now_us_import_idx >= 0 {\n    profiler_now_us_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // Profiler::heap_bytes call target: the import when reserved, else a\n  // never-called `() -> i64` stub (mirrors now_us's fallback).\n  let profiler_heap_bytes_idx = if profiler_heap_bytes_import_idx >= 0 {\n    profiler_heap_bytes_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // `sleep` call target: the import when reserved, else a never-called stub\n  // (the builtin is only emitted as a call when the program uses `sleep`, which\n  // is exactly when the import is reserved).\n  let sleep_idx = if sleep_import_idx >= 0 {\n    sleep_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let stdin_read_char_idx = if stdin_read_char_import_idx >= 0 {\n    stdin_read_char_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // sh / sh_lines call targets: the import when reserved, else the fs_read_file\n  // stub (a `(i64)->i64` never-called placeholder) — the real call site only\n  // exists when the import is reserved (i.e. when the program uses sh/sh_lines).\n  let sh_idx = if sh_import_idx >= 0 {\n    sh_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let sh_lines_idx = if sh_lines_import_idx >= 0 {\n    sh_lines_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  // Stdin::read_stream / Stdout::write_stream / Stdout::write_char call targets:\n  // the import when reserved, else a never-called stub (read_stream is\n  // value-returning like sh -> fs_read_file stub; the void write ops mirror\n  // sleep's fallback to env_args_len). The real call site only exists when the\n  // matching import is reserved (i.e. when the program uses io).\n  let stdin_read_stream_idx = if stdin_read_stream_import_idx >= 0 {\n    stdin_read_stream_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let stdout_write_stream_idx = if stdout_write_stream_import_idx >= 0 {\n    stdout_write_stream_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let stdout_write_char_idx = if stdout_write_char_import_idx >= 0 {\n    stdout_write_char_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // resolve_path call target: the import when reserved, else the fs_read_file\n  // stub (a `(i64)->i64` never-called placeholder — same shape).\n  let resolve_path_idx = if resolve_path_import_idx >= 0 {\n    resolve_path_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  // #768: Fs::remove call target — the import when reserved, else a\n  // never-called stub (void return, so mirrors sleep_idx/stdout_write_char_idx's\n  // fallback to env_args_len_idx).\n  let fs_remove_idx = if fs_remove_import_idx >= 0 {\n    fs_remove_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // #768: Fs::mkdir_p call target — same fallback shape as fs_remove_idx.\n  let fs_mkdir_p_idx = if fs_mkdir_p_import_idx >= 0 {\n    fs_mkdir_p_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // #768: void Fs ops (mkdir/chdir/copy/append/rename) — same fallback shape\n  // as fs_remove_idx/fs_mkdir_p_idx.\n  let fs_mkdir_idx = if fs_mkdir_import_idx >= 0 {\n    fs_mkdir_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let fs_chdir_idx = if fs_chdir_import_idx >= 0 {\n    fs_chdir_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let fs_copy_idx = if fs_copy_import_idx >= 0 {\n    fs_copy_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let fs_append_idx = if fs_append_import_idx >= 0 {\n    fs_append_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let fs_rename_idx = if fs_rename_import_idx >= 0 {\n    fs_rename_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // #768: value-returning Fs ops (is_dir/is_file bool, getcwd string) —\n  // fallback to the fs_read_file stub (an `(i64)->i64`-shaped never-called\n  // placeholder), same as other value-returning fallbacks above.\n  let fs_is_dir_idx = if fs_is_dir_import_idx >= 0 {\n    fs_is_dir_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let fs_is_file_idx = if fs_is_file_import_idx >= 0 {\n    fs_is_file_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let fs_getcwd_idx = if fs_getcwd_import_idx >= 0 {\n    fs_getcwd_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // Socket: never-called placeholders when unused, like the Fs fallbacks\n  // above -- tcp_connect/tcp_read return a value (Int handle / String),\n  // tcp_write/tcp_close are void (Unit).\n  let tcp_connect_idx = if tcp_connect_import_idx >= 0 {\n    tcp_connect_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let tcp_read_idx = if tcp_read_import_idx >= 0 {\n    tcp_read_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let tcp_write_idx = if tcp_write_import_idx >= 0 {\n    tcp_write_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let tcp_close_idx = if tcp_close_import_idx >= 0 {\n    tcp_close_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // #794: never-called placeholders when unused, like the Fs fallbacks above.\n  let http_request_idx = if http_request_import_idx >= 0 {\n    http_request_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let http_response_status_idx = if http_response_status_import_idx >= 0 {\n    http_response_status_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let http_response_header_idx = if http_response_header_import_idx >= 0 {\n    http_response_header_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let http_response_body_idx = if http_response_body_import_idx >= 0 {\n    http_response_body_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let http_close_idx = if http_close_import_idx >= 0 {\n    http_close_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  // #865: never-called placeholders when unused, like the http fallbacks\n  // above. The four value-returning ops fall back to the fs_read_file stub\n  // (a `(i64)->i64` never-called placeholder); the void close op falls back\n  // to env_args_len_idx, mirroring fs_remove_idx/http_close_idx's own choice.\n  let sh_capture_idx = if sh_capture_import_idx >= 0 {\n    sh_capture_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let sh_capture_exit_code_idx = if sh_capture_exit_code_import_idx >= 0 {\n    sh_capture_exit_code_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let sh_capture_stdout_idx = if sh_capture_stdout_import_idx >= 0 {\n    sh_capture_stdout_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let sh_capture_stderr_idx = if sh_capture_stderr_import_idx >= 0 {\n    sh_capture_stderr_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let sh_capture_close_idx = if sh_capture_close_import_idx >= 0 {\n    sh_capture_close_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // #903/#865: Process::exit call target -- void op, same fallback shape as\n  // fs_remove_idx/sh_capture_close_idx.\n  let process_exit_idx = if process_exit_import_idx >= 0 {\n    process_exit_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // #865: Stderr::write_stream / Stderr::write_char call targets -- void ops,\n  // same fallback shape as stdout_write_stream_idx/stdout_write_char_idx.\n  let stderr_write_stream_idx = if stderr_write_stream_import_idx >= 0 {\n    stderr_write_stream_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let stderr_write_char_idx = if stderr_write_char_import_idx >= 0 {\n    stderr_write_char_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // Map hash-index builtins (map_hash_idx..map_probe_index_idx) are the new\n  // last-registered builtins -- this MUST track whatever push_builtin call\n  // is last, independently of the bodies/meta_i32/meta_i64/builtin_type_idxs\n  // array bookkeeping above (num_generated/func_offset below are derived\n  // from THIS constant, not from Array::length(bodies), so adding builtins\n  // without updating this stale-by-construction line silently shifts every\n  // user-function call target in the module by the number of builtins added).\n  let max_builtin_func_idx = map_probe_index_idx\n  let num_generated = (max_builtin_func_idx - num_imported_funcs) + 1\n  let func_offset = num_imported_funcs + num_generated\n  let fn_indices_list = lc_fresh_int_array()\n  let fn_returns_list = lc_fresh_int_array()\n  let mut fi = 0\n  while fi < num_user_funcs {\n    Array::push(fn_indices_list, fi + func_offset)\n    Array::push(fn_returns_list, 1)\n    fi = fi + 1\n  }\n  let builtin_names_list = lc_fresh_string_array()\n  let builtin_param_counts = lc_fresh_int_array()\n  let builtin_needs_env_list = lc_fresh_bool_array()\n  let builtin_indices_list = lc_fresh_int_array()\n  let builtin_returns_list = lc_fresh_int_array()\n  // #415 B-1: the central registry DRIVES the linear lane's registration.\n  // Names, param counts, and returns come straight from builtin_registry()\n  // rows with in_linear = true; only the function INDEX is lane-local (the\n  // idx bindings computed above), resolved by the match below. Adding a\n  // linear builtin = one registry row + one match arm here (+ the import /\n  // body wiring); param-count and returns live ONLY in the registry.\n  // needs_env is false for every static builtin -- only the linked-import\n  // bridges appended after verify carry an env. vibe_rc_drop/vibe_rc_alloc\n  // register under RC builds only (mirrored by verify_lane_builtins'\n  // vibe_rc_ exemption).\n  let registry_rows = builtin_registry()\n  let mut reg_i = 0\n  while reg_i < Array::length(registry_rows) {\n    let (reg_name, reg_params, reg_returns, reg_linear, _) = Array::get(registry_rows, reg_i)\n    let reg_include = reg_linear && (enable_rc || !String::starts_with(reg_name, \"vibe_rc_\"))\n    if reg_include {\n      let reg_idx = match reg_name {\n        \"Env::get\" => env_get_idx,\n        \"Env::args_len\" => env_args_len_idx,\n        \"Env::args_get\" => env_args_get_idx,\n        \"Fs::read_file\" => fs_read_file_idx,\n        \"Fs::exists\" => fs_exists_idx,\n        \"Fs::stat_token\" => fs_stat_token_idx,\n        // #795: alias-collision-proof name, same import index as Fs::stat_token.\n        \"vibe_fs_stat_token_raw\" => fs_stat_token_idx,\n        \"Fs::write_file\" => fs_write_file_idx,\n        \"Fs::write_bytes\" => fs_write_bytes_idx,\n        \"Fs::read_bytes\" => fs_read_bytes_idx,\n        // #729/#730: RAW half of Fs::readdir -- compile_call lowers the surface.\n        \"vibe_fs_read_dir_raw\" => fs_read_dir_idx,\n        \"Fs::remove\" => fs_remove_idx,\n        \"Fs::mkdir_p\" => fs_mkdir_p_idx,\n        \"Fs::mkdir\" => fs_mkdir_idx,\n        \"Fs::chdir\" => fs_chdir_idx,\n        \"Fs::copy\" => fs_copy_idx,\n        \"Fs::append\" => fs_append_idx,\n        \"Fs::rename\" => fs_rename_idx,\n        \"Fs::is_dir\" => fs_is_dir_idx,\n        \"Fs::is_file\" => fs_is_file_idx,\n        \"Fs::getcwd\" => fs_getcwd_idx,\n        \"vibe_tcp_connect_raw\" => tcp_connect_idx,\n        \"vibe_tcp_read_raw\" => tcp_read_idx,\n        \"vibe_tcp_write_raw\" => tcp_write_idx,\n        \"vibe_tcp_close_raw\" => tcp_close_idx,\n        // #794: HTTP client host ops (raw dunder surface names, see checker/builtins_net.vibe).\n        \"vibe_http_request_raw\" => http_request_idx,\n        \"vibe_http_response_status_raw\" => http_response_status_idx,\n        \"vibe_http_response_header_raw\" => http_response_header_idx,\n        \"vibe_http_response_body_raw\" => http_response_body_idx,\n        \"vibe_http_close_raw\" => http_close_idx,\n        \"sh\" => sh_idx,\n        // RAW half of sh_lines -- compile_call lowers the Array[String] surface.\n        \"vibe_sh_lines_raw\" => sh_lines_idx,\n        // #865: structured subprocess result (raw dunder names -- called\n        // directly from lib/@vibe/process/process.vibe, same convention as\n        // the vibe_http_*_raw names above).\n        \"vibe_sh_capture_raw\" => sh_capture_idx,\n        \"vibe_sh_capture_exit_code_raw\" => sh_capture_exit_code_idx,\n        \"vibe_sh_capture_stdout_raw\" => sh_capture_stdout_idx,\n        \"vibe_sh_capture_stderr_raw\" => sh_capture_stderr_idx,\n        \"vibe_sh_capture_close_raw\" => sh_capture_close_idx,\n        \"vibe_process_exit_raw\" => process_exit_idx,\n        \"Stdin::read_stream\" => stdin_read_stream_idx,\n        \"Stdout::write_stream\" => stdout_write_stream_idx,\n        \"Stdout::write_char\" => stdout_write_char_idx,\n        // #865: Stderr, same shapes as the Stdout pair above.\n        \"Stderr::write_stream\" => stderr_write_stream_idx,\n        \"Stderr::write_char\" => stderr_write_char_idx,\n        // #762: RAW host op behind Path::ref / Path::resolve.\n        \"resolve_path\" => resolve_path_idx,\n        \"Profiler::now_us\" => profiler_now_us_idx,\n        \"Profiler::NowUs\" => profiler_now_us_idx,\n        \"Profiler::heap_bytes\" => profiler_heap_bytes_idx,\n        \"Profiler::HeapBytes\" => profiler_heap_bytes_idx,\n        \"sleep\" => sleep_idx,\n        // #1227: row-free sibling, same host import.\n        \"sleep_blocking\" => sleep_idx,\n        \"Stdin::read_char\" => stdin_read_char_idx,\n        \"simd_skip_ws\" => simd_skip_ws_idx,\n        \"simd_scan_alnum\" => simd_scan_alnum_idx,\n        \"simd_scan_alnum_str\" => simd_scan_alnum_str_idx,\n        // #746: backs String < > <= >= (desugar rewrites to str_lex_diff(a,b) <op> 0).\n        \"str_lex_diff\" => str_lex_diff_idx,\n        // #973: backs `<`/`>`/`<=`/`>=`/`+` on an erased `[T: Ord]`/`[T: Add]`\n        // generic operand (desugar_trait_dict.vibe rewrites the binop when the\n        // operand's static type is the bare unresolved type parameter).\n        \"__generic_rel_diff\" => generic_rel_diff_idx,\n        \"__generic_add\" => generic_add_idx,\n        \"print_int\" => print_int_idx,\n        \"print_str\" => print_str_idx,\n        \"String::length\" => str_len_idx,\n        \"String::equals\" => str_eq_idx,\n        \"String::concat\" => str_concat_idx,\n        \"array_new\" => arr_new_idx,\n        \"Array::length\" => arr_len_idx,\n        \"Array::get\" => arr_get_idx,\n        \"Array::push\" => arr_push_idx,\n        \"Array::push_all\" => arr_push_all_idx,\n        \"Array::set\" => arr_set_idx,\n        \"Double::to_int\" => double_to_int_idx,\n        \"Int::to_double\" => int_to_double_idx,\n        \"String::char_code_at\" => str_char_code_at_idx,\n        \"String::from_char_code\" => str_from_char_code_idx,\n        \"String::substring\" => str_substring_idx,\n        \"Array::truncate\" => arr_truncate_idx,\n        \"String::join\" => string_join_idx,\n        \"eq\" => eq_idx,\n        \"String::ends_with\" => string_ends_with_idx,\n        \"String::last_index_of\" => string_last_index_of_idx,\n        \"String::index_of\" => string_index_of_idx,\n        \"String::contains\" => string_contains_idx,\n        \"String::starts_with\" => string_starts_with_idx,\n        \"String::split\" => string_split_idx,\n        \"String::trim\" => string_trim_idx,\n        \"compiler_sources\" => sources_idx,\n        \"ArrayBuilder::new\" => arr_new_idx,\n        \"ArrayBuilder::push\" => arr_push_idx,\n        \"ArrayBuilder::freeze\" => identity_idx,\n        // #906: FrozenArray[T] -- from_array/to_array are pure identity\n        // casts (same runtime layout as Array[T]); get/length alias\n        // Array::get/Array::length's own bodies.\n        \"FrozenArray::from_array\" => identity_idx,\n        \"FrozenArray::to_array\" => identity_idx,\n        \"FrozenArray::get\" => arr_get_idx,\n        \"FrozenArray::length\" => arr_len_idx,\n        \"Array::slice\" => arr_slice_idx,\n        \"Array::concat\" => arr_concat_idx,\n        \"Bytes::new\" => bytes_new_idx,\n        \"Bytes::from_array\" => bytes_from_array_idx,\n        \"Bytes::to_array\" => bytes_to_array_idx,\n        \"Bytes::length\" => bytes_len_idx,\n        \"Bytes::get\" => bytes_get_idx,\n        \"Bytes::set\" => bytes_set_idx,\n        \"Bytes::push\" => bytes_push_idx,\n        \"Bytes::append\" => bytes_append_idx,\n        \"Bytes::concat\" => bytes_concat_idx,\n        \"Bytes::slice\" => bytes_slice_idx,\n        \"Double::to_i64_bits\" => identity_idx,\n        \"__to_string\" => identity_idx,\n        \"vibe_rc_drop\" => rc_drop_idx,\n        \"vibe_rc_alloc\" => rc_alloc_idx,\n        \"vibe_heap_grow_check\" => heap_grow_check_idx,\n        _ => 0 - 1\n      }\n      if reg_idx < 0 {\n        throw(\"builtin registry drift: no linear function-index mapping for builtin '\\{reg_name}' (add a match arm in linked_compile.vibe, #415)\")\n      } else {\n        ()\n      }\n      Array::push(builtin_names_list, reg_name)\n      Array::push(builtin_param_counts, reg_params)\n      Array::push(builtin_needs_env_list, false)\n      Array::push(builtin_indices_list, reg_idx)\n      Array::push(builtin_returns_list, reg_returns)\n    } else {\n      ()\n    }\n    reg_i = reg_i + 1\n  }\n  // #415 B-0: the static registration above must agree with the central\n  // registry (name set + params + returns, both directions). Placed BEFORE\n  // the linked_imports loop — those are user-declared effect bridges with\n  // dynamic names, not builtins.\n  verify_lane_builtins(\"linear\", builtin_names_list, builtin_param_counts, builtin_returns_list)\n  let mut li_reg = 0\n  while li_reg < Array::length(linked_imports) {\n    let (_, lfn_name, lparams, lreturns) = Array::get(linked_imports, li_reg)\n    Array::push(builtin_names_list, lfn_name)\n    Array::push(builtin_param_counts, lparams)\n    Array::push(builtin_needs_env_list, true)\n    Array::push(builtin_indices_list, Array::get(linked_import_indices, li_reg))\n    Array::push(builtin_returns_list, lreturns)\n    li_reg = li_reg + 1\n  }\n  let mut all_fn_i = 0\n  while all_fn_i < Array::length(builtin_names_list) {\n    Array::push(fn_names_list, Array::get(builtin_names_list, all_fn_i))\n    Array::push(fn_param_counts, Array::get(builtin_param_counts, all_fn_i))\n    Array::push(fn_needs_env_list, Array::get(builtin_needs_env_list, all_fn_i))\n    Array::push(fn_indices_list, Array::get(builtin_indices_list, all_fn_i))\n    Array::push(fn_returns_list, Array::get(builtin_returns_list, all_fn_i))\n    all_fn_i = all_fn_i + 1\n  }\n  let all_fn_names_list = fn_names_list\n  let all_fn_param_counts = fn_param_counts\n  let all_fn_needs_env_list = fn_needs_env_list\n  let all_fn_indices_list = fn_indices_list\n  let all_fn_returns_list = fn_returns_list\n  // #1100: sorted once here (not inside the per-function loop below, which\n  // would re-sort this same, unchanging array on every iteration) for\n  // func_table_index_of's O(log N) lookups.\n  let (all_fn_names_sorted, all_fn_names_sorted_pos) = ctor_sorted_index(all_fn_names_list)\n  let num_base_types = 9\n  let lt_w = LambdaTable::{\n    bodies: lc_fresh_bytes_array(),\n    param_counts: lc_fresh_int_array(),\n    captures: lc_fresh_string_matrix(),\n    meta_i32: lc_fresh_int_array(),\n    meta_i64: lc_fresh_int_array()\n  }\n  // #1107 Phase 4: module-wide recorder of funcref-table slots that codegen\n  // materializes as closure values (see CompileCtx.table_slots_used). Created\n  // once here — the per-body CompileCtx constructions below all share this\n  // array by reference — and consumed by the element-section emission, which\n  // registers only the recorded slots.\n  let table_slots_used = lc_fresh_int_array()\n  let bodies = lc_fresh_bytes_array()\n  let meta_i32 = lc_fresh_int_array()\n  let meta_i64 = lc_fresh_int_array()\n  let builtin_type_idxs = lc_fresh_int_array()\n  // #415 B-1: one call = one builtin body. The body bytes, its extra local\n  // counts (meta_i32/meta_i64), and its function-section type index are\n  // pushed TOGETHER, killing the four-way positional alignment this block\n  // used to share with a bare number list ~1,400 lines below (the function\n  // section splices builtin_type_idxs in this same order; a count mismatch\n  // still throws there).\n  let push_builtin: (Bytes, Int, Int, Int) -> Unit = (body, m32, m64, type_idx) -> {\n    Array::push(bodies, body)\n    Array::push(meta_i32, m32)\n    Array::push(meta_i64, m64)\n    Array::push(builtin_type_idxs, type_idx)\n  }\n  push_builtin(static_print_i64_body(), 3, 1, 1)\n  push_builtin(static_print_str_body(), 2, 0, 1)\n  push_builtin(if enable_rc {\n    gen_str_len_body(true)\n  } else {\n    static_str_len_body()\n  }, 0, 0, 3)\n  // #748: SIMD chunk compare needs the extra chunk_limit local (meta_i32 6).\n  push_builtin(gen_str_eq_body(), 6, 0, 4)\n  push_builtin(gen_str_concat_body(), 6, 0, 4)\n  if enable_rc {\n    push_builtin(gen_arr_new_body(true, rc_alloc_idx), 1, 0, 5)\n    push_builtin(gen_arr_len_body(true), 0, 0, 3)\n    push_builtin(gen_arr_get_body(true), 1, 0, 4)\n    push_builtin(gen_arr_push_body(true, rc_alloc_idx, rc_shadow), 6, 0, 6)\n    push_builtin(gen_arr_set_body(true), 1, 0, 7)\n  } else {\n    push_builtin(gen_arr_new_body(false, rc_alloc_idx), 1, 0, 5)\n    push_builtin(static_arr_len_body(), 0, 0, 3)\n    push_builtin(static_arr_get_body(), 1, 0, 4)\n    push_builtin(gen_arr_push_body(false, rc_alloc_idx, rc_shadow), 6, 0, 6)\n    push_builtin(static_arr_set_body(), 1, 0, 7)\n  }\n  push_builtin(static_double_to_int_body(), 0, 0, 3)\n  push_builtin(static_int_to_double_body(), 0, 0, 3)\n  push_builtin(if enable_rc {\n    gen_str_char_code_at_body(true)\n  } else {\n    static_str_char_code_at_body()\n  }, 1, 0, 4)\n  push_builtin(gen_str_from_char_code_body(enable_rc), 1, 0, 3)\n  // #982: substring's clamp prologue needs one i64 scratch (len) — meta 2/1.\n  push_builtin(gen_str_substring_body(enable_rc), 2, 1, 8)\n  push_builtin(static_identity_body(), 0, 0, 3)\n  if enable_rc {\n    push_builtin(gen_arr_slice_body(true, rc_alloc_idx, rc_shadow), 7, 1, 8)\n  } else {\n    // #982: the clamp prologue's i64 len scratch (RC reuses local 10 = elem).\n    push_builtin(gen_arr_slice_body(false, rc_alloc_idx, rc_shadow), 6, 1, 8)\n  }\n  push_builtin(gen_arr_concat_body(), 9, 0, 4)\n  push_builtin(if enable_rc {\n    gen_arr_truncate_body(true)\n  } else {\n    static_arr_truncate_body()\n  }, 0, 0, 6)\n  push_builtin(gen_string_join_body(enable_rc, arr_len_idx, arr_get_idx, str_concat_idx), 9, 1, 4)\n  push_builtin(static_fs_stub_body(), 0, 0, 3)\n  push_builtin(static_fs_stub_body(), 0, 0, 3)\n  push_builtin(static_fs_stub_body(), 0, 0, 3)\n  push_builtin(static_fs_write_bytes_stub_body(), 0, 0, 6)\n  push_builtin(static_fs_write_bytes_stub_body(), 0, 0, 6)\n  push_builtin(gen_eq_body(str_eq_idx), 0, 0, 4)\n  push_builtin(gen_string_ends_with_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 2, 1, 4)\n  push_builtin(gen_string_last_index_of_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 3, 1, 4)\n  if enable_rc {\n    push_builtin(gen_arr_push_all_body(true, rc_alloc_idx, rc_shadow), 10, 1, 6)\n  } else {\n    push_builtin(gen_arr_push_all_body(false, rc_alloc_idx, rc_shadow), 9, 0, 6)\n  }\n  // #748 memchr rewrite: 8 i32 locals, the i64 substring scratch is gone.\n  push_builtin(gen_string_index_of_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 8, 0, 4)\n  push_builtin(gen_string_contains_body(enable_rc, string_index_of_idx), 0, 0, 4)\n  push_builtin(gen_string_starts_with_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 2, 1, 4)\n  push_builtin(gen_string_split_body(enable_rc, arr_new_idx, arr_push_idx, str_len_idx, str_substring_idx, string_index_of_idx), 4, 1, 4)\n  push_builtin(gen_string_trim_body(enable_rc, str_len_idx, str_char_code_at_idx, str_substring_idx), 4, 0, 3)\n  if num_src_pairs > 0 {\n    push_builtin(gen_sources_proper_body(num_src_pairs, str_offsets, str_lengths, src_str_base, arr_new_idx, arr_push_idx), 1, 1, 5)\n  } else {\n    push_builtin(gen_sources_stub_body(arr_new_idx), 0, 0, 5)\n  }\n  push_builtin(gen_bytes_new_body(), 1, 0, 5)\n  push_builtin(gen_bytes_len_body(enable_rc), 0, 0, 3)\n  push_builtin(gen_bytes_get_body(enable_rc), 1, 0, 4)\n  push_builtin(gen_bytes_set_body(enable_rc), 1, 0, 7)\n  push_builtin(gen_bytes_push_body(enable_rc), 6, 0, 6)\n  push_builtin(gen_bytes_append_body(), 8, 0, 6)\n  push_builtin(gen_bytes_concat_body(bytes_new_idx, bytes_append_idx), 0, 1, 4)\n  push_builtin(gen_bytes_slice_body(enable_rc, bytes_new_idx, bytes_get_idx, bytes_push_idx), 2, 1, 8)\n  push_builtin(gen_bytes_from_array_body(enable_rc, arr_len_idx, arr_get_idx, bytes_new_idx, bytes_push_idx), 2, 1, 3)\n  push_builtin(gen_bytes_to_array_body(enable_rc, arr_new_idx, arr_push_idx, bytes_len_idx, bytes_get_idx), 2, 1, 3)\n  if enable_rc {\n    push_builtin(gen_rc_drop_body(rc_drop_idx, rc_shadow, rc_bins_base), 5, 1, 1)\n    push_builtin(gen_rc_alloc_body(rc_shadow, rc_bins_base), 5, 0, 3)\n  } else {\n    ()\n  }\n  push_builtin(gen_heap_grow_check_body(), 0, 0, 2)\n  push_builtin(gen_simd_skip_ws_body(enable_rc), 2, 2, 8)\n  push_builtin(gen_simd_scan_alnum_body(enable_rc, false), 1, 3, 8)\n  push_builtin(gen_simd_scan_alnum_body(enable_rc, true), 1, 3, 8)\n  push_builtin(gen_str_lex_diff_body(enable_rc), 7, 0, 4)\n  push_builtin(gen_generic_rel_diff_body(enable_rc, str_lex_diff_idx), 0, 0, 4)\n  push_builtin(gen_generic_add_body(str_concat_idx), 0, 0, 4)\n  push_builtin(gen_map_hash_body(), 3, 2, 3)\n  push_builtin(gen_map_cap_body(), 0, 1, 3)\n  push_builtin(gen_map_index_insert_body(), 1, 4, 7)\n  push_builtin(gen_map_build_index_body(map_hash_idx, map_cap_idx, map_index_insert_idx, heap_grow_check_idx), 0, 7, 4)\n  push_builtin(gen_map_probe_index_body(map_hash_idx, eq_idx), 1, 8, 8)\n  // #708: one counter cell shared across every function's lift pass, so each\n  // lift site gets a distinct `__m_scrut_N` name (see lift_match_scrutinees).\n  let m_scrut_counter = [\n    0\n  ]\n  // #712: one counter cell shared across every function's uniquify pass, so\n  // every renamed shadow gets a distinct `__shadow_N_<name>` (see\n  // uniquify_shadowed_bindings).\n  let uq_shadow_counter = [\n    0\n  ]\n  // #799 perf: ONE membership index over the flat fn + ctor name tables,\n  // shared by every per-function CompileCtx below. collect_free_vars_indexed\n  // consults it per ident instead of linearly scanning ~thousands of names\n  // (which dominated compiler-closure compile profiles).\n  // Round 2: a SORTED array + binary search -- the previous MapBuilder index\n  // was O(N^2) to build (set scans for duplicates) and O(N) per has_key.\n  let capture_index_names = lc_fresh_string_array()\n  let mut cib_i = 0\n  while cib_i < Array::length(all_fn_names_list) {\n    Array::push(capture_index_names, Array::get(all_fn_names_list, cib_i))\n    cib_i = cib_i + 1\n  }\n  let mut cib_j = 0\n  while cib_j < Array::length(ctor_names_list) {\n    Array::push(capture_index_names, Array::get(ctor_names_list, cib_j))\n    cib_j = cib_j + 1\n  }\n  let capture_name_index_shared = sorted_names_of(capture_index_names)\n  // Codex review on #1186: this was computed inside the `bi < num_user_funcs`\n  // loop below, re-sorting the same thunk_names_list once per function\n  // instead of once per compile -- hoist it out, same fix shape as\n  // capture_name_index_shared above.\n  let thunk_names_sorted_shared = sorted_names_of(thunk_names_list)\n  // #1259 step 7 groundwork: the lambda index plan.\n  //\n  // count_lambda_sites_expr predicts how many table entries a function's body\n  // will allocate WITHOUT compiling the functions before it -- which is the\n  // whole point, since compile_lambda currently takes that index from the live\n  // length of a shared growing table and emits it into the body. The running\n  // total below is that prediction's prefix sum: function bi's range starts\n  // where bi-1's ended.\n  //\n  // Seeded into the ctx and checked at every allocation (compile_lambda), not\n  // used: while plan and walk agree, swapping compile_lambda over to the\n  // planned value cannot change a byte. This is the evidence for that swap.\n  let lambda_plan_cell = lc_fresh_int_array()\n  Array::push(lambda_plan_cell, 0)\n  // #1259 step 7: the frozen plan, built BEFORE any body is emitted.\n  //\n  // Each function's body is transformed here (scrutinee lift + shadow\n  // uniquify under RC) rather than inside the body loop, because the count\n  // has to see the same expression codegen will walk. The two counters those\n  // transforms draw fresh names from are shared across functions, so this\n  // loop must visit them in the same order the body loop does -- it does,\n  // both are bi = 0..num_user_funcs, which is why hoisting the transform out\n  // cannot change a name.\n  //\n  // What this buys over counting inside the loop: every function's lambda\n  // base is now known before the first body is compiled, so a body no longer\n  // depends on its predecessors having been compiled. That is the property\n  // step 7's WholeProgramPlan needs.\n  let planned_bodies: Array[Expr] = [\n  ]\n  let lambda_bases = lc_fresh_int_array()\n  let mut lambda_base_acc = 0\n  let mut pbi = 0\n  while pbi < num_user_funcs {\n    let pb_stmt = Array::get(stmts, Array::get(fn_stmt_indices, pbi))\n    let pb_expr = if enable_rc {\n      let pb_seen: Array[String] = [\n      ]\n      lift_match_scrutinees(uniquify_shadowed_bindings(get_slet_expr(pb_stmt), Map::new(), uq_shadow_counter, pb_seen), m_scrut_counter)\n    } else {\n      get_slet_expr(pb_stmt)\n    }\n    Array::push(planned_bodies, pb_expr)\n    Array::push(lambda_bases, lambda_base_acc)\n    // A function DEFINITION is itself an EFn, and that outer EFn is the\n    // function -- codegen takes its params and compiles its body, it never\n    // routes it through compile_lambda. Counting it would reserve a dead slot\n    // per user function.\n    lambda_base_acc = lambda_base_acc + (if is_efn(pb_expr) {\n      count_lambda_sites_expr(get_efn_body(pb_expr))\n    } else {\n      count_lambda_sites_expr(pb_expr)\n    })\n    pbi = pbi + 1\n  }\n  let mut bi = 0\n  while bi < num_user_funcs {\n    let __bi_stmt = Array::get(stmts, Array::get(fn_stmt_indices, bi))\n    // #703 follow-up: under RC, lift temporary match scrutinees into lets so the\n    // Perceus pass (which drops named bindings) reclaims them. Applied here, the\n    // SAME transformed body feeds both build_perceus_plan (below) and the body\n    // compilation, keeping the plan and codegen consistent. Non-RC is unchanged.\n    //\n    // #712: before lifting scrutinees, alpha-rename any binding that shadows an\n    // enclosing one (within this same function) to a fresh unique name, so RC\n    // codegen's name-keyed bookkeeping (heap_binding_names, rc_drop_names,\n    // rc_alias_dup_names, rc_dup_names, loop_borrowed_names, and the Perceus\n    // plan itself) can never confuse two distinct bindings that happen to share\n    // a name. See uniquify_shadowed_bindings's doc comment (normalize/index.vibe).\n    // #1259 step 7: transformed once, up in the planning loop. Re-running the\n    // transform here would draw a second set of fresh names from the shared\n    // counters and diverge from what the plan counted.\n    let __bi_expr = Array::get(planned_bodies, bi)\n    let body_buf = bytebuf_new()\n    // #644: tell the linemap recorder which user function `body_buf`'s\n    // offsets belong to (mirrors cov_state.cur_fn below). Set unconditionally\n    // -- linemap_record itself is a no-op unless dbg_line_on, so this costs\n    // nothing on a normal build.\n    Array::set(linemap_state.cur_fn, 0, bi)\n    // #cov: mark this user function as executed (store 1 at cov_base + bi).\n    // Stack-neutral and local-free, so prepending it to the body is safe.\n    if coverage {\n      emit_i32_const(body_buf, cov_base + bi)\n      emit_i32_const(body_buf, 1)\n      emit_i32_store8(body_buf, 0, 0)\n      // #cov branch: tell branch instrumentation which function owns the branches\n      // emitted while compiling this body.\n      Array::set(cov_state.cur_fn, 0, bi)\n    } else {\n      ()\n    }\n    // debugger trace (DAP P1 groundwork): in debug mode, append this user\n    // function's index `bi` to the in-memory trace log when there is still room.\n    // Stack-neutral and local-free, so prepending it to the body is safe:\n    //   if load[counter_addr] < cap {\n    //     store[log_base + load[counter_addr]*4] = bi\n    //     store[counter_addr] = load[counter_addr] + 1\n    //   }\n    // `counter` is reloaded from memory each time (idempotent), avoiding locals.\n    if debug_trace {\n      emit_i32_const(body_buf, trace_counter_addr)\n      emit_i32_load(body_buf, 2, 0)\n      emit_i32_const(body_buf, trace_cap)\n      emit_i32_ge_u(body_buf)\n      emit_i32_eqz(body_buf)\n      emit_if_void(body_buf)\n      // store[log_base + counter*4] = bi\n      emit_i32_const(body_buf, trace_log_base)\n      emit_i32_const(body_buf, trace_counter_addr)\n      emit_i32_load(body_buf, 2, 0)\n      emit_i32_const(body_buf, 4)\n      emit_i32_mul(body_buf)\n      emit_i32_add(body_buf)\n      emit_i32_const(body_buf, bi)\n      emit_i32_store(body_buf, 2, 0)\n      // store[counter_addr] = counter + 1\n      emit_i32_const(body_buf, trace_counter_addr)\n      emit_i32_const(body_buf, trace_counter_addr)\n      emit_i32_load(body_buf, 2, 0)\n      emit_i32_const(body_buf, 1)\n      emit_i32_add(body_buf)\n      emit_i32_store(body_buf, 2, 0)\n      emit_end(body_buf)\n    } else {\n      ()\n    }\n    // #715: computed here, BEFORE the `debug_break` block below, and reused by\n    // it via `Array::length(lc_norm_params)` instead of a second independent\n    // `is_efn(__bi_expr)`/`get_efn_params(__bi_expr)` call. Both accessors\n    // unconditionally rc_drop their argument, so each call is a real \"use\" of\n    // `__bi_expr` for Perceus's purposes; having it called from BOTH branches\n    // of the (usually-false) `if debug_break` AND unconditionally right after\n    // made the `if debug_break {...} else {...}` construct's `then` branch\n    // statically \"consume\" 2 extra units of `__bi_expr`'s remaining-use budget\n    // that, in the overwhelmingly common `debug_break == false` case, never\n    // actually execute. perceus/index.vibe's `pc_emit` EIf handling takes the\n    // MIN of the two branches' resulting `remaining` and carries it forward\n    // (see the #705 comment there) to avoid double-freeing a value fully\n    // consumed on the taken branch -- but that also means the *lower* (more-\n    // consuming) branch's count wins even when it is the branch that is\n    // essentially never taken, permanently starving the dup budget needed by\n    // `__bi_expr`'s later, always-executed uses below (`lc_norm_params` itself\n    // was one of them) and eventually causing a use of an already-freed\n    // pointer (#715's free-list corruption during RC self-hosting). Hoisting\n    // this computation out from under `debug_break` removes the only\n    // asymmetric-branch use of `__bi_expr` in this function (the other\n    // `is_efn(__bi_expr)`-gated branches all have `is_efn(__bi_expr)` true on\n    // effectively every real program, so their MIN-selected branch already\n    // matches the branch actually taken).\n    // #715: `get_slet_type(__bi_stmt)` hoisted out of the `is_efn(__bi_expr)`\n    // `then` branch and computed here, unconditionally -- previously it was\n    // the ONLY use of `__bi_stmt` inside this specific `if`'s `then` branch\n    // (the `else` branch, `array_empty()`, never touches\n    // `__bi_stmt`), and `__bi_expr` is NOT an EFn for every `bi` iteration:\n    // `fn_names_list`/`fn_stmt_indices` also carry thunk entries (see the\n    // classification loop above), so the `else` path here is a real, common\n    // occurrence, not a rare edge case. Same leak mechanism as the\n    // `lc_norm_params`/`__bi_body`/`dn_expr`/classification-loop fixes above\n    // -- `pc_emit`'s EIf MIN-merge (#705) otherwise permanently assumes the\n    // `then`-branch's higher `__bi_stmt` consumption even on thunk (`else`)\n    // iterations, leaking `__bi_stmt` (a heap Stmt node) on each one.\n    let __sf_slet_type = get_slet_type(__bi_stmt)\n    let lc_norm_params = if is_efn(__bi_expr) {\n      let ps = get_efn_params(__bi_expr)\n      let sig_args_raw = fn_type_param_types(__sf_slet_type)\n      let single_tuple_param = match sig_args_raw {\n        Some(a) => Array::length(ps) == 1 && Array::length(a) > 1,\n        None => false\n      }\n      let np = Array::slice(ps, 0, 0)\n      let mut spi = 0\n      while spi < Array::length(ps) {\n        let (sraw, sty) = Array::get(ps, spi)\n        let slen = String::length(sraw)\n        let ssn = if slen > 0 {\n          let slc = String::char_code_at(sraw, slen - 1)\n          if slc == '~' || slc == '?' {\n            sraw[0: slen - 1]\n          } else {\n            sraw\n          }\n        } else {\n          sraw\n        }\n        let resolved_ty = match sty {\n          Some(_) => sty,\n          None =>\n          match sig_args_raw {\n            Some(args) =>\n            if single_tuple_param {\n              Some(TyTuple(args))\n            } else if Array::length(args) == Array::length(ps) {\n              Some(Array::get(args, spi))\n            } else {\n              None\n            },\n            None => None\n          }\n        }\n        Array::push(np, (ssn, resolved_ty))\n        spi = spi + 1\n      }\n      np\n    } else {\n      // #715: alias `__sf_slet_type` once here too, matching `then`'s single\n      // use (via `fn_type_param_types`) now that it is hoisted above -- see\n      // that binding's doc comment.\n      let __sf_lnp_ty = __sf_slet_type\n      array_empty()\n    }\n    // debugger breakpoint (DAP P1): in break mode, call the host hook\n    // `vibe::dbg_break` at this user function's entry. The hook inspects the\n    // wasm backtrace to name the entering function and pauses when it is in the\n    // breakpoint set. Stack-neutral (() -> ()), so prepending is safe.\n    if debug_break {\n      // DAP P2: spill this function's i64 parameters into the dbgargs region so\n      // the host hook can read and print them. All user-function wasm params are\n      // i64 (vibe value ABI); locals 0..nparams-1 hold the params at entry.\n      let dbg_nparams = Array::length(lc_norm_params)\n      let dbg_n = if dbg_nparams > dbgargs_cap {\n        dbgargs_cap\n      } else {\n        dbg_nparams\n      }\n      let mut dbg_pi = 0\n      while dbg_pi < dbg_n {\n        emit_i32_const(body_buf, dbgargs_base + dbg_pi * 8)\n        emit_local_get(body_buf, dbg_pi)\n        emit_i64_store(body_buf, 3, 0)\n        dbg_pi = dbg_pi + 1\n      }\n      emit_i32_const(body_buf, dbgargs_count_addr)\n      emit_i32_const(body_buf, dbg_n)\n      emit_i32_store(body_buf, 2, 0)\n      emit_call(body_buf, dbg_break_import_idx)\n    } else {\n      ()\n    }\n    let local_names = lc_fresh_string_array()\n    let fn_name_dbg = Array::get(fn_names_list, bi)\n    let rc_drops = array_empty()\n    let rc_alias_dups = array_empty()\n    let rc_dups = array_empty()\n    let lc_heap_params = lc_fresh_string_array()\n    // #715: computed once, unconditionally (regardless of `enable_rc`), and\n    // reused below both for the Perceus plan and for the actual codegen call\n    // to `compile_expr` -- instead of a separate `get_efn_body(__bi_expr)`\n    // call under `enable_rc` (as `fbody`) AND another one further down (as\n    // `body`, inside the `is_efn(__bi_expr)` block). Each independent\n    // `get_efn_body(__bi_expr)`/`get_efn_params(__bi_expr)` call is a real\n    // additional owning \"use\" of `__bi_expr` for Perceus's purposes (neither\n    // is registered in `is_borrow_arg0_call`), inflating the dup budget\n    // `__bi_expr` statically needs. See the `lc_norm_params` doc comment\n    // above (the same redundant-call pattern, already fixed once for\n    // `get_efn_params`) for the full double-free mechanism this avoids.\n    let __bi_body = if is_efn(__bi_expr) {\n      get_efn_body(__bi_expr)\n    } else {\n      __bi_expr\n    }\n    if enable_rc {\n      let plan = build_perceus_plan_with_params(lc_norm_params, __bi_body, lc_borrow_ret_names, lc_borrow_arg0_user, lc_borrow_view_ret)\n      let mut lhpi = 0\n      while lhpi < Array::length(lc_norm_params) {\n        let (lhpn, lhpt) = Array::get(lc_norm_params, lhpi)\n        if param_is_heap_in_body(lhpn, lhpt, __bi_body) {\n          Array::push(lc_heap_params, lhpn)\n        } else {\n          ()\n        }\n        lhpi = lhpi + 1\n      }\n      // ADR-0092 borrow-inference slice 1: when THIS fn's arg0 ABI is\n      // borrowed, the caller keeps ownership -- the plan's scope-end drop\n      // (and any entry dup) for param0 must not be emitted here.\n      let bfn_p0 = if array_contains_str(lc_borrow_arg0_user, fn_name_dbg) && Array::length(lc_norm_params) >= 1 {\n        let (bfn_p0n, _) = Array::get(lc_norm_params, 0)\n        bfn_p0n\n      } else {\n        \"\"\n      }\n      let mut di = 0\n      while di < Array::length(plan) {\n        let pa = Array::get(plan, di)\n        if pa_is_drop(pa) {\n          // Skip ONLY the drop for the borrowed param -- the plan is\n          // name-keyed, so a shadowing local sharing param0's name can\n          // carry dup/alias-dup actions of its own, and filtering those\n          // out under-counts references (use-after-free that only\n          // surfaces under allocation churn -- codegen_heap_e2e_test\n          // caught it after ~90 compiles). A same-named shadow's own\n          // scope-end drop is also skipped here (a bounded leak, safe\n          // direction); eligibility makes that rare since a bare read of\n          // the shadow disqualifies the fn.\n          if pa.name == bfn_p0 && bfn_p0 != \"\" {\n            ()\n          } else {\n            Array::push(rc_drops, pa.name)\n          }\n        } else if pa_is_alias_dup(pa) {\n          Array::push(rc_alias_dups, pa.name)\n        } else if pa_is_dup(pa) {\n          Array::push(rc_dups, pa.name)\n        } else {\n          ()\n        }\n        di = di + 1\n      }\n    }\n    // Interior-line breakpoints: this function's source file id + that file's\n    // newline index (for mapping its statement offsets to lines). Off => 0/empty.\n    let dbg_fid = if dbg_line_on {\n      Array::get(prov.stmt_file_id, Array::get(fn_stmt_indices, bi))\n    } else {\n      0\n    }\n    let dbg_nls = if dbg_line_on {\n      Array::get(prov.file_nls, dbg_fid)\n    } else {\n      lc_fresh_int_array()\n    }\n    // #1259 step 7: this function's preassigned range, straight out of the\n    // frozen plan -- no counting happens here any more.\n    Array::set(lambda_plan_cell, 0, Array::get(lambda_bases, bi))\n    let lambda_planned_end = if bi + 1 < num_user_funcs {\n      Array::get(lambda_bases, bi + 1)\n    } else {\n      lambda_base_acc\n    }\n    let compile_ctx = CompileCtx::{\n      func_table: FuncTable::{\n        names: all_fn_names_list,\n        indices: all_fn_indices_list,\n        params: all_fn_param_counts,\n        returns: all_fn_returns_list,\n        needs_env: all_fn_needs_env_list,\n        names_sorted: all_fn_names_sorted,\n        names_sorted_pos: all_fn_names_sorted_pos\n      },\n      str_table: StrTable::{\n        strs: str_strs, offsets: str_offsets, lengths: str_lengths\n      },\n      lambda_table: lt_w,\n      num_user_funcs: num_user_funcs, func_offset: func_offset,\n      ref_cell_names: lc_fresh_string_array(),\n      ctor_table: CtorTable::{\n        names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: lc_ctor_names_sorted, names_sorted_pos: lc_ctor_names_sorted_pos\n      },\n      ctor_float_fields: ctor_float_fields_list,\n      // Sorted copy for compile_expr.vibe's per-identifier membership check\n      // (bsearch_leftmost) -- keep `thunk_names_list` itself unsorted, its\n      // POSITION is load-bearing for the per-thunk global-slot index lookup\n      // a few hundred lines below (tg_k / tg_value_g). Computed once above\n      // (thunk_names_sorted_shared), not per-function.\n      thunk_names: thunk_names_sorted_shared,\n      const_int_names: const_int_names_list,\n      const_int_values: const_int_values_list,\n      enable_rc: enable_rc,\n      rc_shadow: rc_shadow,\n      rc_drop_names: rc_drops,\n      rc_alias_dup_names: rc_alias_dups,\n      heap_binding_names: lc_heap_params,\n      rc_drop_func_idx: if enable_rc {\n        rc_drop_idx\n      } else {\n        -1\n      },\n      rc_alloc_func_idx: if enable_rc {\n        rc_alloc_idx\n      } else {\n        -1\n      },\n      heap_grow_check_func_idx: heap_grow_check_idx,\n      map_hash_func_idx: map_hash_idx,\n      map_cap_func_idx: map_cap_idx,\n      map_build_index_func_idx: map_build_index_idx,\n      map_probe_func_idx: map_probe_index_idx,\n      rc_dup_names: rc_dups,\n      capture_name_index: capture_name_index_shared,\n      float_local_slots: lc_fresh_int_array(),\n      int_local_slots: lc_fresh_int_array(),\n      agg_local_slots: lc_fresh_int_array(),\n      agg_local_exprs: lc_fresh_expr_array(),\n      agg_ret_names: lc_agg_ret_names,\n      agg_ret_infos: lc_agg_ret_infos,\n      heap_ret_names: lc_heap_ret_names,\n      effect_names: effect_names_list,\n      effect_op_keys: effect_op_keys_list,\n      effect_op_arities: effect_op_arities_list,\n      cov: cov_state,\n      dbg_line_idx: dbg_line_import_idx,\n      dbg_line_nl: dbg_nls,\n      dbg_line_file_id: dbg_fid,\n      loop_borrowed_names: lc_fresh_string_array(),\n      loop_consumed_names: lc_fresh_string_array(),\n      reuse_scrutinee_names: lc_fresh_string_array(),\n      reuse_flag_locals: lc_fresh_int_array(),\n      borrow_ret_names: lc_borrow_ret_names,\n      borrow_arg0_user: lc_borrow_arg0_user,\n      borrow_view_ret: lc_borrow_view_ret,\n      scalar_ret_names: lc_scalar_ret_names,\n      pending_letrec_self_name: lc_fresh_string_array(),\n      table_slots_used: table_slots_used,\n      lambda_plan_next: lambda_plan_cell,\n      linemap: linemap_state\n    }\n    if is_efn(__bi_expr) {\n      // #715: `lc_norm_params` (built above from `get_efn_params(__bi_expr)`)\n      // already carries each parameter's `~`/`?`-stripped name in `.0` --\n      // reuse it instead of a second `get_efn_params(__bi_expr)` call plus a\n      // duplicate stripping pass (see the `__bi_body` doc comment above).\n      let body = __bi_body\n      let mut pi = 0\n      while pi < Array::length(lc_norm_params) {\n        let (pname, _) = Array::get(lc_norm_params, pi)\n        Array::push(local_names, pname)\n        pi = pi + 1\n      }\n      // #724 round 2: seed the aggregate-shape log from ANNOTATED params\n      // (param slot i = local i), so `p == q` on tuple/struct/enum-typed\n      // params compares structurally.\n      let sig_ptypes = fn_type_param_types(__sf_slet_type)\n      let mut psi = 0\n      while psi < Array::length(lc_norm_params) {\n        // Prefer the SLet signature's param types (`let f: (P2) -> ..`);\n        // fall back to a per-param annotation (`(p: P2) -> ..`).\n        let pann = match sig_ptypes {\n          Some(pts) => if Array::length(pts) == Array::length(lc_norm_params) {\n            Some(Array::get(pts, psi))\n          } else {\n            let (_, pa) = Array::get(lc_norm_params, psi)\n            pa\n          },\n          None => {\n            let (_, pa) = Array::get(lc_norm_params, psi)\n            pa\n          }\n        }\n        match pann {\n          Some(pte) => {\n            let pinfo = agg_info_of_type_expr(compile_ctx.ctor_table, pte)\n            if pinfo > 0 {\n              Array::push(compile_ctx.agg_local_slots, psi * 256 + pinfo)\n              // #811: agg_local_exprs is the index-aligned PARALLEL of\n              // agg_local_slots (agg_log_reset_above2 prunes both in\n              // lockstep, reading exprs[i] for every slots[i]). This param\n              // seed pushed only to slots, leaving exprs one entry short —\n              // every later reset then read exprs out of bounds and\n              // compacted the garbage back in. Push the same \"no shape\n              // expr\" placeholder the let-binding site uses.\n              Array::push(compile_ctx.agg_local_exprs, EInt(0))\n            } else {\n              ()\n            }\n            // Float/Double-typed params feed expr_is_floatish the same way\n            // let-bound floats do; without this, `a == b` on annotated float\n            // params misses the f64 path and (under RC, where floats are\n            // boxed) compares heap pointers — `1.5 == 1.5` came out false.\n            //\n            // #1015: Bool-typed params feed expr_is_boolish the same way\n            // (int_local_slots kind 3, #769 encoding slot*4+kind) let-bound\n            // bools do -- without this a Bool-typed param `b` passed straight\n            // to `to_string(b)` (e.g. `fn render(b: Bool) -> String {\n            // to_string(b) }`) is just a bare EIdent with no tracked slot\n            // info, so neither the call-site fast path in\n            // codegen/expr/compile_call.vibe nor `\"\\{b}\"` interpolation can\n            // recognize it as Bool -- both fall through to the generic\n            // runtime bit-pattern heuristic and mis-render `true` as `\"1\"`.\n            match pte {\n              TyName(ptn) => if ptn == \"Float\" || ptn == \"Double\" {\n                Array::push(compile_ctx.float_local_slots, psi * 2 + 1)\n              } else if ptn == \"Bool\" {\n                Array::push(compile_ctx.int_local_slots, psi * 4 + 3)\n              } else {\n                ()\n              },\n              _ => ()\n            }\n          },\n          None => ()\n        }\n        psi = psi + 1\n      }\n      Array::push(local_names, \"__env\")\n      let param_count = Array::length(lc_norm_params) + 1\n      if enable_rc {\n        let mut edi = 0\n        while edi < Array::length(lc_norm_params) {\n          let (edn, _edt) = Array::get(lc_norm_params, edi)\n          if array_contains_str(lc_heap_params, edn) {\n            let mut edc = 0\n            let mut edj = 0\n            while edj < Array::length(rc_dups) {\n              if Array::get(rc_dups, edj) == edn {\n                edc = edc + 1\n              } else {\n                ()\n              }\n              edj = edj + 1\n            }\n            let mut ede = 0\n            while ede < edc {\n              emit_rc_dup_guarded(body_buf, edi, rc_shadow)\n              ede = ede + 1\n            }\n          } else {\n            ()\n          }\n          edi = edi + 1\n        }\n      } else {\n        ()\n      }\n      // #805: an inline-wasm fn's instruction bytes come from the WAT\n      // assembler, not compile_expr (its AST body is a neutral EInt(0) after\n      // lc_extract_inline_wasm). Params are Int-only (parser-enforced), so\n      // no RC/Perceus bookkeeping applies; no extra locals are introduced\n      // (final_nl == param_count => meta extra 0).\n      let mut iw_found = -1\n      let mut iw_scan = 0\n      while iw_scan < Array::length(iw_names) {\n        if Array::get(iw_names, iw_scan) == fn_name_dbg {\n          iw_found = iw_scan\n          iw_scan = Array::length(iw_names)\n        } else {\n          iw_scan = iw_scan + 1\n        }\n      }\n      // ADR-0092 Phase 1 widening: a function whose body is EXACTLY\n      // `match p { ... }` over one of its own heap params (the dominant\n      // shape of the compiler's AST-rebuild loops) stages the same reuse\n      // fusion the ELet form gets in compile_expr_tail — flag local first,\n      // (name, flag) pushed for compile_match, and the param's #725\n      // epilogue drop below guarded on the flag.\n      let pfuse_name = if enable_rc && rc_drop_idx >= 0 && iw_found < 0 && expr_tag(body) == 16 && is_eident(get_match_scrutinee(body)) {\n        get_eident_name(get_match_scrutinee(body))\n      } else {\n        \"\"\n      }\n      let pfuse = pfuse_name != \"\" && array_contains_str(rc_drops, pfuse_name) && array_contains_str(lc_heap_params, pfuse_name)\n      let pfuse_flag = if pfuse {\n        Array::push(local_names, \"__reuse_flag\")\n        emit_i64_const(body_buf, 0)\n        emit_local_set(body_buf, param_count)\n        Array::push(compile_ctx.reuse_scrutinee_names, pfuse_name)\n        Array::push(compile_ctx.reuse_flag_locals, param_count)\n        param_count\n      } else {\n        0 - 1\n      }\n      let final_nl = if iw_found >= 0 {\n        let iw_param_names = lc_fresh_string_array()\n        let mut iw_pi = 0\n        while iw_pi < Array::length(lc_norm_params) {\n          let (iw_pn, _) = Array::get(lc_norm_params, iw_pi)\n          Array::push(iw_param_names, iw_pn)\n          iw_pi = iw_pi + 1\n        }\n        bytebuf_push_buf(body_buf, compile_inline_wat(fn_name_dbg, Array::get(iw_wats, iw_found), iw_param_names))\n        param_count\n      } else {\n        compile_expr(body_buf, body, local_names, if pfuse {\n          param_count + 1\n        } else {\n          param_count\n        }, compile_ctx, -1)\n      }\n      if pfuse {\n        Array::truncate(compile_ctx.reuse_scrutinee_names, Array::length(compile_ctx.reuse_scrutinee_names) - 1)\n        Array::truncate(compile_ctx.reuse_flag_locals, Array::length(compile_ctx.reuse_flag_locals) - 1)\n      } else {\n        ()\n      }\n      let mut tail_nl = final_nl\n      if enable_rc && rc_drop_idx >= 0 {\n        let tail_root = scope_tail_proj_root(body)\n        // #706 leak follow-up: a loop-borrowed param's protective rc_dup (see\n        // compile_call.vibe's cc_is_loop_borrowed_ident sites) is matched by the\n        // callee's OWN internal drop each iteration — it never touches this\n        // function's own slot-held reference. The Perceus plan still counts that\n        // textual occurrence as \"one real consume\" (so `remaining` hits 0 and no\n        // PaDrop is emitted), leaking the binding's own reference once per such\n        // occurrence. Count each param's occurrences in loop_consumed_names and\n        // emit that many EXTRA rc_drop calls here — purely additive to the\n        // existing rc_drops accounting, so it cannot perturb any decision the\n        // plan and codegen already agree on elsewhere.\n        let mut need_dup = false\n        let mut tci = 0\n        while tci < Array::length(lc_norm_params) {\n          let (tcn, _tct) = Array::get(lc_norm_params, tci)\n          let mut tcn_loop_extra = 0\n          let mut tcle = 0\n          while tcle < Array::length(compile_ctx.loop_consumed_names) {\n            if Array::get(compile_ctx.loop_consumed_names, tcle) == tcn {\n              tcn_loop_extra = tcn_loop_extra + 1\n            } else {\n              ()\n            }\n            tcle = tcle + 1\n          }\n          // #1085: the loop-count clause only applies when every consuming\n          // occurrence is a loop site (see lc_has_nonloop_consume).\n          let tcn_loop_drop = tcn_loop_extra > 0 && !lc_has_nonloop_consume(body, tcn)\n          if array_contains_str(lc_heap_params, tcn) && (array_contains_str(rc_drops, tcn) || tcn_loop_drop) && tcn == tail_root {\n            need_dup = true\n          } else {\n            ()\n          }\n          tci = tci + 1\n        }\n        let rtemp = final_nl\n        if need_dup {\n          emit_local_set(body_buf, rtemp)\n          emit_rc_dup_guarded(body_buf, rtemp, rc_shadow)\n          tail_nl = final_nl + 1\n        } else {\n          ()\n        }\n        let mut tdj = 0\n        while tdj < Array::length(lc_norm_params) {\n          let (tdn, _tdt) = Array::get(lc_norm_params, tdj)\n          if array_contains_str(lc_heap_params, tdn) {\n            // #725: a loop-protected consume (per-iteration dup at the call\n            // site, #706 above) is NET-ZERO at runtime — the dup is matched by\n            // the callee's own drop each execution and never touches the\n            // param's single owned reference. So the epilogue owes EXACTLY ONE\n            // drop for that reference, regardless of how many textual\n            // loop-consumed SITES exist: a second site in a sibling match arm\n            // (even one that never executes — its protective dup is emitted\n            // but never runs) previously got its own per-occurrence drop,\n            // over-releasing the CALLER's value and poisoning the RC free\n            // list (fuzz/findings/issue725/). When a loop site exists it also\n            // absorbs the plan's PaDrop (the textual counts ate the budget the\n            // plan would otherwise drop), so emit one drop total either way.\n            let mut tdn_loop_count = 0\n            let mut tdle = 0\n            while tdle < Array::length(compile_ctx.loop_consumed_names) {\n              if Array::get(compile_ctx.loop_consumed_names, tdle) == tdn {\n                tdn_loop_count = tdn_loop_count + 1\n              } else {\n                ()\n              }\n              tdle = tdle + 1\n            }\n            // #1085: the \"one epilogue drop when loop sites exist\" rule\n            // (#725) assumed every textual consume is a net-zero loop site.\n            // When a NON-loop consuming occurrence also exists (e.g.\n            // `Array::set(buf, i, v)` in a sibling branch of the loop), the\n            // path through that real consume transfers the param's own\n            // reference and the unconditional drop over-releases the stored\n            // value (use-after-free — the loop arm does not even need to\n            // execute). Suppress the loop-count drop in that mixed case;\n            // the loop-only path then leaks one reference per call, which\n            // is the safe direction until path-sensitive accounting lands\n            // (fixtures/rc_branch_loop_mixed_consume_test.vibe).\n            let tdn_loop_drop = tdn_loop_count > 0 && !lc_has_nonloop_consume(body, tdn)\n            if array_contains_str(rc_drops, tdn) || tdn_loop_drop {\n              if pfuse_flag >= 0 && tdn == pfuse_name {\n                // ADR-0092: a reuse arm consumed this param's reference —\n                // drop only on the paths that did not (flag still 0).\n                emit_local_get(body_buf, pfuse_flag)\n                emit_i64_eqz(body_buf)\n                emit_if_void(body_buf)\n                emit_local_get(body_buf, tdj)\n                emit_call(body_buf, rc_drop_idx)\n                emit_end(body_buf)\n              } else {\n                emit_local_get(body_buf, tdj)\n                emit_call(body_buf, rc_drop_idx)\n              }\n            } else {\n              ()\n            }\n          } else {\n            ()\n          }\n          tdj = tdj + 1\n        }\n        if need_dup {\n          emit_local_get(body_buf, rtemp)\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n      if enable_rc && fn_name_dbg == entry_name {\n        emit_i64_const(body_buf, 1)\n        emit_i64_shr_s(body_buf)\n      }\n      Array::push(bodies, body_buf)\n      // #1259: the walk allocated exactly as many lambdas as the plan said.\n      // The per-allocation check in compile_lambda catches an UNDER-count (the\n      // walk runs past the planned range); this catches an OVER-count, where\n      // the plan reserved slots for EFn nodes codegen never reached.\n      if Array::get(lambda_plan_cell, 0) != lambda_planned_end {\n        throw(String::concat(\"lambda plan over-count: planned through \", String::concat(__to_string(lambda_planned_end), String::concat(\", walk stopped at \", __to_string(Array::get(lambda_plan_cell, 0))))))\n      } else {\n        ()\n      }\n      let extra = if tail_nl > param_count {\n        tail_nl - param_count\n      } else {\n        0\n      }\n      Array::push(meta_i32, 0)\n      Array::push(meta_i64, extra)\n    } else {\n      // Module-level non-function `let` (a THUNK): previously the initializer\n      // re-ran on EVERY reference, so a 16-entry lookup table cost an O(size)\n      // allocation per access (~148 B/call in bench/_probe_sb_phases.vibe)\n      // and, worse, each access saw a FRESH value while the gc backend\n      // initializes module globals ONCE — a cross-backend semantics split\n      // (mutations visible there, lost here). Memoize: two appended i64\n      // globals per thunk (value + init flag; base index rc?7:6, after\n      // g_op_index). First call computes and caches, later calls reload.\n      // Under RC the cache holds one permanent reference and every return\n      // (both paths) hands the caller a guarded-dup'd reference, so consumer\n      // drops balance exactly like the old fresh-value contract.\n      Array::push(local_names, \"__env\")\n      let param_count = 1\n      let mut tg_k = -1\n      let mut tg_i = 0\n      while tg_i < Array::length(thunk_names_list) {\n        if Array::get(thunk_names_list, tg_i) == fn_name_dbg {\n          tg_k = tg_i\n          tg_i = Array::length(thunk_names_list)\n        } else {\n          tg_i = tg_i + 1\n        }\n      }\n      let tg_base = if enable_rc {\n        7\n      } else {\n        6\n      }\n      let tg_value_g = tg_base + tg_k * 2\n      let tg_flag_g = tg_value_g + 1\n      emit_global_get(body_buf, tg_flag_g)\n      emit_i32_wrap_i64(body_buf)\n      emit_if_i64(body_buf)\n      emit_global_get(body_buf, tg_value_g)\n      emit_local_tee(body_buf, 1)\n      if enable_rc {\n        emit_rc_dup_guarded(body_buf, 1, rc_shadow)\n      } else {\n        ()\n      }\n      emit_else(body_buf)\n      Array::push(local_names, \"__thunk_memo\")\n      let final_nl = compile_expr(body_buf, __bi_expr, local_names, 2, compile_ctx, -1)\n      emit_local_tee(body_buf, 1)\n      emit_global_set(body_buf, tg_value_g)\n      if enable_rc {\n        emit_rc_dup_guarded(body_buf, 1, rc_shadow)\n      } else {\n        ()\n      }\n      emit_i64_const(body_buf, 1)\n      emit_global_set(body_buf, tg_flag_g)\n      emit_local_get(body_buf, 1)\n      emit_end(body_buf)\n      if enable_rc && fn_name_dbg == entry_name {\n        emit_i64_const(body_buf, 1)\n        emit_i64_shr_s(body_buf)\n      }\n      Array::push(bodies, body_buf)\n      // #1259: the walk allocated exactly as many lambdas as the plan said.\n      // The per-allocation check in compile_lambda catches an UNDER-count (the\n      // walk runs past the planned range); this catches an OVER-count, where\n      // the plan reserved slots for EFn nodes codegen never reached.\n      if Array::get(lambda_plan_cell, 0) != lambda_planned_end {\n        throw(String::concat(\"lambda plan over-count: planned through \", String::concat(__to_string(lambda_planned_end), String::concat(\", walk stopped at \", __to_string(Array::get(lambda_plan_cell, 0))))))\n      } else {\n        ()\n      }\n      let extra = if final_nl > param_count {\n        final_nl - param_count\n      } else {\n        0\n      }\n      Array::push(meta_i32, 0)\n      Array::push(meta_i64, extra)\n    }\n    bi = bi + 1\n  }\n  let num_lambdas = Array::length(lt_w.bodies)\n  let start_body = bytebuf_new()\n  let entry_func_idx = if entry_user_idx >= 0 {\n    entry_user_idx + func_offset\n  } else {\n    -1\n  }\n  // ADR-0069: the synthesized `_start` prints the entry's Int return via\n  // print_int (the historical `let main: () -> Int` convention), but a\n  // Unit-returning entry (`fn main {}` desugars to `() -> Unit`, and any\n  // explicit `let main: () -> Unit`) must NOT print — the old behavior\n  // appended a stray `0` line after the program's own output. Detect Unit\n  // from the entry's declared return type: the EFn return annotation or the\n  // binding's `: (..) -> Unit` type annotation.\n  let mut entry_returns_unit = false\n  if entry_user_idx >= 0 {\n    let mut eri = 0\n    while eri < Array::length(stmts) {\n      match Array::get(stmts, eri) {\n        SLet(_, _, ename, eann, eval) => if ename == entry_name {\n          let ann_unit = match eann {\n            Some(TyFn(_, ann_ret, _)) => linked_type_expr_is_unit(ann_ret),\n            _ => false\n          }\n          let ret_unit = match eval {\n            EFn(_, _, _, efn_ret, _, _) => match efn_ret {\n              Some(rt) => linked_type_expr_is_unit(rt),\n              None => false\n            },\n            _ => false\n          }\n          if ann_unit || ret_unit {\n            entry_returns_unit = true\n          }\n        },\n        _ => ()\n      }\n      eri = eri + 1\n    }\n  }\n  if entry_user_idx >= 0 {\n    let entry_params = Array::get(fn_param_counts, entry_user_idx)\n    if entry_params != 0 {\n      throw(\"WASI entry function must take 0 parameters\")\n    }\n    emit_i64_const(start_body, 0)\n    emit_call(start_body, entry_func_idx)\n    if entry_returns_unit {\n      emit_drop(start_body)\n    } else {\n      emit_call(start_body, print_int_idx)\n    }\n  } else {\n    let mut sti = 0\n    while sti < Array::length(test_fn_names) {\n      let stname = Array::get(test_fn_names, sti)\n      let mut __stj = 0\n      let mut __stf = -1\n      while __stj < Array::length(fn_names_list) {\n        if Array::get(fn_names_list, __stj) == stname {\n          __stf = __stj\n        }\n        __stj = __stj + 1\n      }\n      if __stf >= 0 {\n        emit_i64_const(start_body, 0)\n        emit_call(start_body, func_offset + __stf)\n        emit_drop(start_body)\n      }\n      sti = sti + 1\n    }\n  }\n  Array::push(bodies, start_body)\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  let run_body = bytebuf_new()\n  if entry_func_idx >= 0 {\n    emit_i64_const(run_body, 0)\n    emit_call(run_body, entry_func_idx)\n  } else {\n    let mut rti = 0\n    while rti < Array::length(test_fn_names) {\n      let tname = Array::get(test_fn_names, rti)\n      let mut __rtj = 0\n      let mut __rtf = -1\n      while __rtj < Array::length(fn_names_list) {\n        if Array::get(fn_names_list, __rtj) == tname {\n          __rtf = __rtj\n        }\n        __rtj = __rtj + 1\n      }\n      if __rtf >= 0 {\n        emit_i64_const(run_body, 0)\n        emit_call(run_body, func_offset + __rtf)\n        emit_drop(run_body)\n      }\n      rti = rti + 1\n    }\n    emit_i64_const(run_body, 0)\n  }\n  Array::push(bodies, run_body)\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  let mut li = 0\n  while li < num_lambdas {\n    Array::push(bodies, Array::get(lt_w.bodies, li))\n    Array::push(meta_i32, Array::get(lt_w.meta_i32, li))\n    Array::push(meta_i64, Array::get(lt_w.meta_i64, li))\n    li = li + 1\n  }\n  let mut max_closure_arity = -1\n  let mut lai = 0\n  while lai < num_lambdas {\n    let lpc = Array::get(lt_w.param_counts, lai) - 1\n    if lpc > max_closure_arity {\n      max_closure_arity = lpc\n    }\n    lai = lai + 1\n  }\n  let mut uai = 0\n  while uai < num_user_funcs {\n    let upc = Array::get(fn_param_counts, uai)\n    if upc > max_closure_arity {\n      max_closure_arity = upc\n    }\n    uai = uai + 1\n  }\n  let mut iai = 0\n  while iai < Array::length(linked_imports) {\n    let (_, _, ipc, _) = Array::get(linked_imports, iai)\n    if ipc > max_closure_arity {\n      max_closure_arity = ipc\n    }\n    iai = iai + 1\n  }\n  let num_closure_types = if max_closure_arity >= 0 {\n    max_closure_arity + 1\n  } else {\n    0\n  }\n  // Interior-line breakpoints (span-arc step5): when active, the `vibe::dbg_line`\n  // import needs an `(i32) -> ()` func type. No existing base type is `(i32)->()`\n  // (type 1 is `(i64)->()`), so append one new type AFTER all base + closure\n  // types at index `num_base_types + num_closure_types`. This is strictly beyond\n  // every linked-import type index (which use `num_base_types + lparams`, bounded\n  // by num_closure_types), so existing indices are unshifted. -1 when off.\n  let dbg_line_type_idx = if dbg_line_on {\n    num_base_types + num_closure_types\n  } else {\n    -1\n  }\n  let extra_dbg_types = if dbg_line_on {\n    1\n  } else {\n    0\n  }\n  // #794: `vibe.http_request` needs an `(i64,i64,i64,i64) -> i64` func type.\n  // No base type has 4 i64 params, and closure types are data-dependent (only\n  // present up to the max closure arity in the unit), so append one dedicated\n  // type AFTER base + closure + dbg types when the import is live. Off =>\n  // byte-identical type section (fixpoint-safe).\n  let http_request_type_idx = if need_http_request_builtin {\n    num_base_types + num_closure_types + extra_dbg_types\n  } else {\n    -1\n  }\n  let extra_http_types = if need_http_request_builtin {\n    1\n  } else {\n    0\n  }\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types + extra_dbg_types + extra_http_types)\n  emit_func_type_raw(type_content, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  emit_func_type_raw(type_content, [\n    126\n  ], array_empty())\n  emit_func_type_raw(type_content, array_empty(), array_empty())\n  emit_func_type_raw(type_content, [\n    126\n  ], [\n    126\n  ])\n  emit_func_type_raw(type_content, [\n    126,\n    126\n  ], [\n    126\n  ])\n  emit_func_type_raw(type_content, array_empty(), [\n    126\n  ])\n  emit_func_type_raw(type_content, [\n    126,\n    126\n  ], array_empty())\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126\n  ], array_empty())\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126\n  ], [\n    126\n  ])\n  let mut cti = 0\n  while cti < num_closure_types {\n    let num_params = cti + 1\n    let ct_params = lc_fresh_int_array()\n    let mut cpti = 0\n    while cpti < num_params {\n      Array::push(ct_params, 126)\n      cpti = cpti + 1\n    }\n    emit_func_type_raw(type_content, ct_params, [\n      126\n    ])\n    cti = cti + 1\n  }\n  // Interior-line breakpoints: append the `(i32, i32) -> ()` type for\n  // `vibe::dbg_line` (127 = i32; params = file_id, line). Only when active, so the\n  // type section is byte-identical off.\n  if dbg_line_on {\n    emit_func_type_raw(type_content, [\n      127,\n      127\n    ], array_empty())\n  } else {\n    ()\n  }\n  // #794: the `(i64,i64,i64,i64) -> i64` type for vibe.http_request, appended\n  // last so every other type index is unshifted.\n  if need_http_request_builtin {\n    emit_func_type_raw(type_content, [\n      126,\n      126,\n      126,\n      126\n    ], [\n      126\n    ])\n  } else {\n    ()\n  }\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_vibe_abi_custom_section(out, \"raw\")\n  // #cov: emit a `vibe_cov` custom section describing the function-hit bitmap.\n  // Layout of the payload: i32 LE cov_base, i32 LE cov_count, then the\n  // user-function names (one per line, in bitmap-index order). The consumer\n  // reads memory[cov_base .. cov_base+cov_count] after running and maps each\n  // hit byte back to a name. Only present in coverage builds.\n  if coverage {\n    let cov_content = bytebuf_new()\n    let cov_name = \"vibe_cov\"\n    leb128_encode_u32(cov_content, String::length(cov_name))\n    let mut cni = 0\n    while cni < String::length(cov_name) {\n      bytebuf_push(cov_content, String::char_code_at(cov_name, cni))\n      cni = cni + 1\n    }\n    bytebuf_push(cov_content, cov_base&255)\n    bytebuf_push(cov_content, (cov_base>>8)&255)\n    bytebuf_push(cov_content, (cov_base>>16)&255)\n    bytebuf_push(cov_content, (cov_base>>24)&255)\n    bytebuf_push(cov_content, cov_count&255)\n    bytebuf_push(cov_content, (cov_count>>8)&255)\n    bytebuf_push(cov_content, (cov_count>>16)&255)\n    bytebuf_push(cov_content, (cov_count>>24)&255)\n    let mut covni = 0\n    while covni < num_user_funcs {\n      let covnm = Array::get(fn_names_list, covni)\n      let covnml = String::length(covnm)\n      let mut covci = 0\n      while covci < covnml {\n        bytebuf_push(cov_content, String::char_code_at(covnm, covci))\n        covci = covci + 1\n      }\n      bytebuf_push(cov_content, 10)\n      covni = covni + 1\n    }\n    bytebuf_push_section(out, 0, cov_content)\n    // #cov branch: a `vibe_cov_branch` custom section describing the branch-hit\n    // bitmap. Payload: i32 LE branch_base, i32 LE branch_count, then\n    // branch_count i32 LE entries giving the owning user-function index per\n    // branch id (in id order). The consumer reads memory[base .. base+count]\n    // after running and attributes each hit branch to its function (names from\n    // the `vibe_cov` section), so it can report per-function branch coverage.\n    let covb_content = bytebuf_new()\n    let covb_name = \"vibe_cov_branch\"\n    leb128_encode_u32(covb_content, String::length(covb_name))\n    let mut covbni = 0\n    while covbni < String::length(covb_name) {\n      bytebuf_push(covb_content, String::char_code_at(covb_name, covbni))\n      covbni = covbni + 1\n    }\n    let covb_count = Array::get(cov_state.next, 0)\n    bytebuf_push(covb_content, cov_branch_base&255)\n    bytebuf_push(covb_content, (cov_branch_base>>8)&255)\n    bytebuf_push(covb_content, (cov_branch_base>>16)&255)\n    bytebuf_push(covb_content, (cov_branch_base>>24)&255)\n    bytebuf_push(covb_content, covb_count&255)\n    bytebuf_push(covb_content, (covb_count>>8)&255)\n    bytebuf_push(covb_content, (covb_count>>16)&255)\n    bytebuf_push(covb_content, (covb_count>>24)&255)\n    let mut covbi = 0\n    while covbi < covb_count {\n      let owner = Array::get(cov_state.owners, covbi)\n      bytebuf_push(covb_content, owner&255)\n      bytebuf_push(covb_content, (owner>>8)&255)\n      bytebuf_push(covb_content, (owner>>16)&255)\n      bytebuf_push(covb_content, (owner>>24)&255)\n      covbi = covbi + 1\n    }\n    bytebuf_push_section(out, 0, covb_content)\n  } else {\n    ()\n  }\n  // debugger trace (DAP P1 groundwork): emit a `vibe.trace` custom section\n  // describing the in-memory trace log. Payload layout: i32 LE counter_addr,\n  // i32 LE log_base, i32 LE cap, then the user-function names (one per line, in\n  // user-index order — the same list the name section uses). The runner reads\n  // memory[counter_addr] for the count, then `count` i32 entries from log_base,\n  // and maps each index to a name. Only present in debug-trace builds.\n  if debug_trace {\n    let tr_content = bytebuf_new()\n    let tr_name = \"vibe.trace\"\n    leb128_encode_u32(tr_content, String::length(tr_name))\n    let mut trni = 0\n    while trni < String::length(tr_name) {\n      bytebuf_push(tr_content, String::char_code_at(tr_name, trni))\n      trni = trni + 1\n    }\n    bytebuf_push(tr_content, trace_counter_addr&255)\n    bytebuf_push(tr_content, (trace_counter_addr>>8)&255)\n    bytebuf_push(tr_content, (trace_counter_addr>>16)&255)\n    bytebuf_push(tr_content, (trace_counter_addr>>24)&255)\n    bytebuf_push(tr_content, trace_log_base&255)\n    bytebuf_push(tr_content, (trace_log_base>>8)&255)\n    bytebuf_push(tr_content, (trace_log_base>>16)&255)\n    bytebuf_push(tr_content, (trace_log_base>>24)&255)\n    bytebuf_push(tr_content, trace_cap&255)\n    bytebuf_push(tr_content, (trace_cap>>8)&255)\n    bytebuf_push(tr_content, (trace_cap>>16)&255)\n    bytebuf_push(tr_content, (trace_cap>>24)&255)\n    let mut trni2 = 0\n    while trni2 < num_user_funcs {\n      let trnm = Array::get(fn_names_list, trni2)\n      let trnml = String::length(trnm)\n      let mut trci = 0\n      while trci < trnml {\n        bytebuf_push(tr_content, String::char_code_at(trnm, trci))\n        trci = trci + 1\n      }\n      bytebuf_push(tr_content, 10)\n      trni2 = trni2 + 1\n    }\n    bytebuf_push_section(out, 0, tr_content)\n  } else {\n    ()\n  }\n  // debugger argument inspection (DAP P2): emit a `vibe.dbgargs` custom section\n  // publishing the addresses + value ABI the runner reads. Payload layout:\n  // i32 LE dbgargs_count_addr, i32 LE dbgargs_base, i32 LE tag_mode. At a\n  // breakpoint the runner reads memory[count_addr] (i32) for the arg count, then\n  // that many i64 values from dbgargs_base, decoding each per tag_mode:\n  //   tag_mode 0 (enable_rc off): values are plain untagged i64 ints.\n  //   tag_mode 1 (enable_rc on):  values are 1-bit tagged — low bit 0 => int\n  //                               (raw >> 1), low bit 1 => heap pointer (hex).\n  // Only present in break builds.\n  if debug_break {\n    let da_content = bytebuf_new()\n    let da_name = \"vibe.dbgargs\"\n    leb128_encode_u32(da_content, String::length(da_name))\n    let mut dani = 0\n    while dani < String::length(da_name) {\n      bytebuf_push(da_content, String::char_code_at(da_name, dani))\n      dani = dani + 1\n    }\n    bytebuf_push(da_content, dbgargs_count_addr&255)\n    bytebuf_push(da_content, (dbgargs_count_addr>>8)&255)\n    bytebuf_push(da_content, (dbgargs_count_addr>>16)&255)\n    bytebuf_push(da_content, (dbgargs_count_addr>>24)&255)\n    bytebuf_push(da_content, dbgargs_base&255)\n    bytebuf_push(da_content, (dbgargs_base>>8)&255)\n    bytebuf_push(da_content, (dbgargs_base>>16)&255)\n    bytebuf_push(da_content, (dbgargs_base>>24)&255)\n    let da_tag_mode = if enable_rc {\n      1\n    } else {\n      0\n    }\n    bytebuf_push(da_content, da_tag_mode&255)\n    bytebuf_push(da_content, (da_tag_mode>>8)&255)\n    bytebuf_push(da_content, (da_tag_mode>>16)&255)\n    bytebuf_push(da_content, (da_tag_mode>>24)&255)\n    bytebuf_push_section(out, 0, da_content)\n  } else {\n    ()\n  }\n  // debugger named-parameter inspection (DAP P4): emit a `vibe.dbgnames` custom\n  // section listing, per user function (in user-index order — the same order as\n  // the name section / fn_names_list / vibe.dbgargs spill), that function's name\n  // followed by its parameter names. One record per function, terminated by\n  // newline (10); within a record fields are tab-delimited (9): the first field\n  // is the function name, the remaining fields are the parameter names. A\n  // function with no params emits just its name + newline. Names are capped at\n  // dbgargs_cap to match the spilled value count. The runner keys a map by\n  // function name so entering-function F's names can be paired with F's spilled\n  // values to print `args: [name=value]`. Only present in break builds; off =>\n  // byte-identical to a normal build (fixpoint preserved).\n  if debug_break {\n    let dn_content = bytebuf_new()\n    let dn_name = \"vibe.dbgnames\"\n    leb128_encode_u32(dn_content, String::length(dn_name))\n    let mut dnni = 0\n    while dnni < String::length(dn_name) {\n      bytebuf_push(dn_content, String::char_code_at(dn_name, dnni))\n      dnni = dnni + 1\n    }\n    let mut dnfi = 0\n    while dnfi < num_user_funcs {\n      let dn_fnname = Array::get(fn_names_list, dnfi)\n      let mut dn_fci = 0\n      while dn_fci < String::length(dn_fnname) {\n        bytebuf_push(dn_content, String::char_code_at(dn_fnname, dn_fci))\n        dn_fci = dn_fci + 1\n      }\n      let dn_stmt = Array::get(stmts, Array::get(fn_stmt_indices, dnfi))\n      let dn_expr = get_slet_expr(dn_stmt)\n      if is_efn(dn_expr) {\n        let dn_params = get_efn_params(dn_expr)\n        let dn_np = Array::length(dn_params)\n        let dn_n = if dn_np > dbgargs_cap {\n          dbgargs_cap\n        } else {\n          dn_np\n        }\n        let mut dn_pi = 0\n        while dn_pi < dn_n {\n          let (dn_pname_raw, _) = Array::get(dn_params, dn_pi)\n          let dn_pnl = String::length(dn_pname_raw)\n          let dn_pname = if dn_pnl > 0 {\n            let dn_plc = String::char_code_at(dn_pname_raw, dn_pnl - 1)\n            if dn_plc == '~' || dn_plc == '?' {\n              dn_pname_raw[0: dn_pnl - 1]\n            } else {\n              dn_pname_raw\n            }\n          } else {\n            dn_pname_raw\n          }\n          bytebuf_push(dn_content, 9)\n          let mut dn_ci = 0\n          while dn_ci < String::length(dn_pname) {\n            bytebuf_push(dn_content, String::char_code_at(dn_pname, dn_ci))\n            dn_ci = dn_ci + 1\n          }\n          dn_pi = dn_pi + 1\n        }\n      } else {\n        // #715: `dn_expr` is a fresh per-iteration owned binding (like\n        // `__bi_expr` in the main codegen loop above), and -- unlike\n        // `__bi_expr` -- `is_efn(dn_expr)` is NOT overwhelmingly true here:\n        // `fn_stmt_indices` legitimately mixes real functions with non-\n        // function \"thunk\" entries (constant initializers), so this `else`\n        // is a common, not rare, runtime path. An empty `else { () }` uses\n        // `dn_expr` zero times while `then` uses it once (via\n        // `get_efn_params`), so `pc_emit`'s EIf MIN-merge (#705) permanently\n        // carries the `then`-consumed (lower) remaining forward even on the\n        // iterations that really take this branch -- the loop-body scope-end\n        // drop for `dn_expr` is then skipped based on that borrowed count,\n        // leaking `dn_expr` on every thunk entry. Call `is_efn` again here,\n        // discarding the result, purely to consume `dn_expr` exactly once --\n        // matching `then`'s single consuming use so both branches leave the\n        // same remaining count and the plan's assumption holds either way.\n        is_efn(dn_expr)\n      }\n      bytebuf_push(dn_content, 10)\n      dnfi = dnfi + 1\n    }\n    bytebuf_push_section(out, 0, dn_content)\n  } else {\n    ()\n  }\n  // Interior-line breakpoints (span-arc step5, multi-file): emit a `vibe.dbgfiles`\n  // custom section listing the source-file basenames in file-id order, one per\n  // line (terminated by newline 10). `vibe::dbg_line(file_id, line)` passes the\n  // file id; the runner indexes this table to recover the basename and match a\n  // `--break <file>:<line>` spec. Only present when dbg_line is active, so off =>\n  // byte-identical (fixpoint preserved).\n  if dbg_line_on {\n    let df_content = bytebuf_new()\n    let df_name = \"vibe.dbgfiles\"\n    leb128_encode_u32(df_content, String::length(df_name))\n    let mut dfni = 0\n    while dfni < String::length(df_name) {\n      bytebuf_push(df_content, String::char_code_at(df_name, dfni))\n      dfni = dfni + 1\n    }\n    let mut dffi = 0\n    while dffi < Array::length(prov.files) {\n      let df_base = Array::get(prov.files, dffi)\n      let mut df_ci = 0\n      while df_ci < String::length(df_base) {\n        bytebuf_push(df_content, String::char_code_at(df_base, df_ci))\n        df_ci = df_ci + 1\n      }\n      bytebuf_push(df_content, 10)\n      dffi = dffi + 1\n    }\n    bytebuf_push_section(out, 0, df_content)\n  } else {\n    ()\n  }\n  bytebuf_push_section(out, 1, type_content)\n  let import_content = bytebuf_new()\n  bytebuf_push_vec_header(import_content, num_imported_funcs)\n  emit_name(import_content, \"wasi_snapshot_preview1\")\n  emit_name(import_content, \"fd_write\")\n  bytebuf_push(import_content, 0)\n  leb128_encode_u32(import_content, 0)\n  if env_get_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"env-get\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if env_args_len_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"args-len\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 5)\n  }\n  if env_args_get_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"args-get\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_read_file_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_read_file\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_exists_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_exists\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_stat_token_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_stat_token\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_write_file_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_write_file\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 6)\n  }\n  if fs_write_bytes_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_write_bytes\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 6)\n  }\n  // #632: fs_read_bytes — emitted right after fs_write_bytes to match its\n  // reserved index. Type 3 is `(i64) -> i64` (same as fs_read_file).\n  if fs_read_bytes_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_read_bytes\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  // #729/#730: fs_read_dir — emitted right after fs_read_bytes to match its\n  // reserved index. Type 3 is `(i64) -> i64` (same as fs_read_file).\n  if fs_read_dir_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_read_dir\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if profiler_now_us_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"profile-now-us\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 5)\n  }\n  // `vibe.profile-heap-bytes () -> i64` — emitted right after profile-now-us\n  // to match its reserved index. Type 5 is `() -> i64` (same as now-us).\n  if profiler_heap_bytes_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"profile-heap-bytes\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 5)\n  }\n  // `vibe.sleep (i64) -> ()` — reserved index after profiler, matching the\n  // allocation order above. Type 1 is `(i64) -> ()`.\n  if sleep_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"sleep\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // `vibe.stdin_read_char () -> i64` — after sleep, matching allocation order.\n  // Type 5 is `() -> i64` (same as profile-now-us).\n  if stdin_read_char_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"stdin_read_char\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 5)\n  } else {\n    ()\n  }\n  // `vibe.sh (i64) -> i64` and `vibe.sh_lines (i64) -> i64` — reserved after\n  // stdin_read_char (before dbg_break), matching allocation order. Type 3 is\n  // `(i64) -> i64` (same as fs_read_file / fs_read_dir).\n  if sh_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"sh\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  if sh_lines_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"sh_lines\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  // `vibe.stdin_read_stream (i64) -> i64` (type 3, like fs_read_file), then the\n  // two void `vibe.stdout_write_stream` / `vibe.stdout_write_char (i64) -> ()`\n  // (type 1, like sleep) — reserved after sh_lines (before dbg_break), matching\n  // allocation order.\n  if stdin_read_stream_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"stdin_read_stream\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  if stdout_write_stream_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"stdout_write_stream\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  if stdout_write_char_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"stdout_write_char\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // `vibe.resolve_path (i64) -> i64` (type 3, like fs_read_file) — reserved after\n  // stdout_write_char (before dbg_break), matching allocation order.\n  if resolve_path_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"resolve_path\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  // #768: `vibe.fs_remove (i64) -> ()` (type 1, like sleep) — reserved after\n  // resolve_path (before dbg_break), matching allocation order.\n  if fs_remove_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_remove\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // #768: `vibe.fs_mkdir_p (i64) -> ()` (type 1, like fs_remove) — reserved\n  // after fs_remove (before dbg_break), matching allocation order.\n  if fs_mkdir_p_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_mkdir_p\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // #768: `vibe.fs_mkdir (i64) -> ()` (type 1, like fs_remove) — reserved\n  // after fs_mkdir_p, matching allocation order.\n  if fs_mkdir_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_mkdir\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // #768: `vibe.fs_chdir (i64) -> ()` (type 1, like fs_remove) — reserved\n  // after fs_mkdir, matching allocation order.\n  if fs_chdir_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_chdir\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  /