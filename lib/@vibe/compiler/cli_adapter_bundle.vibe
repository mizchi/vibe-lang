let cli_adapter_source_216 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/gc_only/gc_only.vibe",
"//# Imports\n\nimport @vibe/compiler/syntax {\n  lex, parse_program, parse_stmt, Token\n}\n\nimport @vibe/core {\n  array_empty\n}\nimport @vibe/compiler/checker {\n  check_program\n}\n\nimport @vibe/compiler/codegen {\n  desugar_trait_dicts\n}\n\nimport @vibe/compiler/codegen/gc {\n  compile_wasi_module_gc, gc_to_string_resolves_to_show_wrapper\n}\n\n// #847 Phase C exception: this file drives the wasm-gc backend\n// (codegen/gc, imported above), which still has its own, unpatched\n// capture-analysis path (codegen/gc/backend_lambda_collect.vibe,\n// codegen/gc/backend_expr.vibe) mirroring the two #875 miscompile bugs\n// already fixed for the linear/RC backends (compile_call.vibe,\n// common_analysis/common_analysis.vibe + compile_lambda.vibe + compile_expr_tail.vibe).\n// Routing this leaf import through core/index.vibe (now core/'s index.vpkg,\n// #897) would grow this file's whole-program-merge graph the same way the\n// fixed #875 cases did; until the gc-backend capture-analysis path gets its\n// own fix (or a dedicated gc-selfbuild regression gate exists --\n// scripts/test_gc_selfbuild.sh is not part of compiler_gate.sh today), avoid\n// core/'s directory-shared-scope package entirely. #897: core/ast.vibe is\n// itself now only a re-export shim of @vibe/ast (`export\n// ../../../../lib/@vibe/ast { Expr, Pat, Stmt, TypeExpr }`), and importing a\n// non-facade leaf inside a `.vpkg`-owned directory from OUTSIDE that\n// directory is rejected by loader.vibe's package-boundary enforcement\n// (enforce_incoming_boundary_fs) now that core/ has an index.vpkg -- so this\n// import is redirected straight to @vibe/ast, core/ast.vibe's own real\n// source, bypassing core/ (and its boundary) altogether. Same merge-graph\n// weight as before (core/ast.vibe added no real code of its own), still\n// skips types.vibe/import_alias_rewrite.vibe/dce.vibe/... entirely.\nimport @vibe/ast {\n  Expr, Stmt\n}\n\n//# Functions\n\n// #897: gc_only/wasi_only are SIBLING packages under entry/source_compile/,\n// each with its own index.vpkg. This file used to leaf-import\n// wasi_only/preprocess_interp.vibe + preprocess_strip.vibe directly (a\n// pre-existing #729 boundary violation that predates this migration batch,\n// simply never exercised because nothing previously validated\n// lib/@vibe/compiler/'s top-level directory as a real package -- cli_adapter.vibe,\n// a member of that new package, needs compile_source_gc_only from HERE,\n// so this file's own imports are now part of that package's validation\n// closure). Routing through `import ../wasi_only { .. }` (the boundary-\n// legal fix used for wasi_only's OTHER external callers, see that\n// package's index.vpkg header) instead produces a genuine `type_db: import\n// cycle detected at lib/@vibe/compiler/index.vpkg`: compiler.vibe (a\n// sibling of cli_adapter.vibe in that same top-level package) already\n// depends on wasi_only directly, and cli_adapter.vibe -> gc_only ->\n// wasi_only is a second, simultaneous path to the same package from\n// within the same top-level package's dependency-cycle-detection stack.\n// Neither the leaf import nor the package import works from inside that\n// closure. expand_interp_stmts/strip_generic_type_params (and the small\n// interpolation-rewrite chain expand_interp_stmts needs) are pure,\n// self-contained AST-rewrite helpers with no state and no interesting\n// external dependents beyond wasi_only's own preprocess_compile.vibe/\n// preprocess.vibe, so they are inlined here as private `gc_`-prefixed\n// duplicates rather than moved to a shared ancestor package (that would\n// mean relocating wasi_only's whole ~14-file preprocess_interp_*.vibe\n// cluster, real behavior-preserving but far larger surface than this\n// PR's scope) or left broken (blocking every external consumer of the\n// new lib/@vibe/compiler/index.vpkg package, which is the whole point of\n// this migration). If wasi_only's copies change, keep these in sync by\n// hand -- same tradeoff as gc_only's other #847-Phase-C direct-dependency\n// exceptions documented on the @vibe/ast import below.\n\nfn gc_concat_exprs(lhs: Expr, rhs: Expr) -> Expr {\n  let b = ArrayBuilder::new()\n  ArrayBuilder::push(b, lhs)\n  ArrayBuilder::push(b, rhs)\n  let args = ArrayBuilder::freeze(b)\n  ECall(EIdent(\"String::concat\", -1), args, -1)\n}\n\nfn gc_fold_interp_exprs_loop(result_arr: Array[Expr], result_len: Int, result0: Expr, j0: Int) -> Expr {\n  let mut result = result0\n  let mut j = j0\n  while j < result_len {\n    let rhs = Array::get(result_arr, j)\n    result = gc_concat_exprs(result, rhs)\n    j = j + 1\n  }\n  result\n}\n\nfn gc_fold_interp_exprs_nonempty(result_arr: Array[Expr], result_len: Int) -> Expr {\n  let first = Array::get(result_arr, 0)\n  gc_fold_interp_exprs_loop(result_arr, result_len, first, 1)\n}\n\nfn gc_fold_interp_exprs(result_arr: Array[Expr]) -> Expr {\n  let result_len = Array::length(result_arr)\n  if result_len == 0 {\n    EString(\"\")\n  } else {\n    gc_fold_interp_exprs_nonempty(result_arr, result_len)\n  }\n}\n\nfn gc_parse_interp_expr(tokens: Array[Token]) -> Expr with { Error } {\n  let (stmt, _) = parse_stmt(tokens, [], 0)\n  match stmt {\n    SExpr(expr) => expr,\n    _ => throw(\"expected interpolation expression\")\n  }\n}\n\nfn gc_collect_interp_exprs(parts: Array[String]) -> Array[Expr] with { Error } {\n  let plen = Array::length(parts)\n  let exprs = ArrayBuilder::new()\n  let mut i = 0\n  while i < plen {\n    let lit = Array::get(parts, i)\n    if String::length(lit) > 0 {\n      ArrayBuilder::push(exprs, EString(lit))\n    }\n    if i + 1 < plen {\n      let expr_src = Array::get(parts, i + 1)\n      let part_tokens = lex(expr_src)\n      let part_expr = gc_parse_interp_expr(part_tokens)\n      ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\", -1), [\n        part_expr\n      ], -1))\n    }\n    i = i + 2\n  }\n  ArrayBuilder::freeze(exprs)\n}\n\nfn gc_rewrite_interp_string(parts: Array[String]) -> Expr with { Error } {\n  let result_arr = gc_collect_interp_exprs(parts)\n  gc_fold_interp_exprs(result_arr)\n}\n\nfn gc_rewrite_interp(e: Expr) -> Expr with { Error } {\n  match e {\n    EStringInterp(parts) => gc_rewrite_interp_string(parts),\n    ELet(name, val, body, soff) => ELet(name, gc_rewrite_interp(val), gc_rewrite_interp(body), soff),\n    ELetMut(name, val, body, soff) => ELetMut(name, gc_rewrite_interp(val), gc_rewrite_interp(body), soff),\n    ELetRec(name, val, body) => ELetRec(name, gc_rewrite_interp(val), gc_rewrite_interp(body)),\n    ESeq(a, b) => ESeq(gc_rewrite_interp(a), gc_rewrite_interp(b)),\n    ECall(callee, args, off) => ECall(gc_rewrite_interp(callee), for arg in args {\n      gc_rewrite_interp(arg)\n    }, off),\n    EIf(c, t, e2) => EIf(gc_rewrite_interp(c), gc_rewrite_interp(t), gc_rewrite_interp(e2)),\n    EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, gc_rewrite_interp(body)),\n    EMatch(scrut, arms) => EMatch(gc_rewrite_interp(scrut), for arm in arms {\n      let (pat, body) = arm; (pat, gc_rewrite_interp(body))\n    }),\n    _ => e\n  }\n}\n\nfn expand_interp_stmts(stmts: Array[Stmt]) -> Unit with { Error } {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, is_rec, name, ann, expr) => Array::set(stmts, i, SLet(exp, is_rec, name, ann, gc_rewrite_interp(expr)))\n      ,\n      STest(name, expr) => Array::set(stmts, i, STest(name, gc_rewrite_interp(expr)))\n      ,\n      SBench(name, expr) => Array::set(stmts, i, SBench(name, gc_rewrite_interp(expr)))\n      ,\n      _ => ()\n    }\n    i = i + 1\n  }\n  // Method-bearing-trait dictionary passing (#641 PR-3). No-op unless the\n  // program declares a trait with method signatures.\n  desugar_trait_dicts(stmts)\n}\n\nfn strip_generic_type_params(stmts: Array[Stmt]) -> Unit {\n  let empty_tp = array_empty()\n  let empty_bounds = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\n          Array::set(stmts, i, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\n        }\n        ,\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\n// #683: test/bench-block lowering for the gc lane, mirroring the linear\n// backend's in-codegen rewrite (codegen/wasi/linked_compile.vibe): each\n// `test \"name\" { body }` becomes `let __test_name = () -> { body; 0 }`,\n// and when the requested entry does not exist (the `vibe test` sentinel\n// path) a `_start` running every test/bench function in order is\n// synthesized at the AST level. Returns the effective entry name. This is\n// what lets `VIBE_TEST_BACKEND=gc bash scripts/vibe_test.sh file` run a\n// *_test.vibe on the wasm-gc backend under wasmtime.\nfn lower_test_blocks_gc(stmts: Array[Stmt], entry_name: String) -> String with { Error } {\n  let empty_tp = array_empty()\n  let empty_bounds = array_empty()\n  let empty_params = array_empty()\n  let test_fn_names = array_empty()\n  let mut has_entry = false\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STest(tname, tbody) => {\n        let test_fn = String::concat(\"__test_\", tname)\n        Array::push(test_fn_names, test_fn)\n        Array::set(stmts, i, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))\n      },\n      SBench(bname, bbody) => {\n        let bench_fn = String::concat(\"__bench_\", bname)\n        Array::push(test_fn_names, bench_fn)\n        Array::set(stmts, i, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))\n      },\n      SLet(_, _, name, _, _) => if name == entry_name {\n        has_entry = true\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  if has_entry || Array::length(test_fn_names) == 0 {\n    entry_name\n  } else {\n    // Synthesize `_start` calling each test/bench fn in declaration order.\n    let mut body = EInt(0)\n    let mut ti = Array::length(test_fn_names) - 1\n    while ti >= 0 {\n      body = ESeq(ECall(EIdent(Array::get(test_fn_names, ti), 0 - 1), array_empty(), 0 - 1), body)\n      ti = ti - 1\n    }\n    Array::push(stmts, SLet(true, false, \"_start\", None, EFn(empty_tp, empty_bounds, empty_params, None, None, body)))\n    \"_start\"\n  }\n}\n\n// #538 P4.5: the SAME source pipeline as compile_source_wasi_only — interp\n// expansion, check, trait-dict desugar, generic-param strip — in front of the\n// gc backend. The trait-dict desugar is what expands `a == b` on enum/struct\n// operands into the derived structural Eq walk (and Show's Int::to_string\n// etc.); without it the gc lane compared ctor POINTERS, so the gc-compiled\n// checker's Option/effect-row comparisons were silently wrong.\nexport fn compile_source_gc_only(source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  // #683: lower test/bench blocks BEFORE the check so the synthesized\n  // `__test_*` lets and the no-entry `_start` runner are type-checked like\n  // ordinary functions (the linear lane checks STest bodies directly and\n  // rewrites inside codegen; pre-check rewriting is equivalent here).\n  let effective_entry = lower_test_blocks_gc(stmts, entry_name)\n  let _ = check_program(stmts)\n  // #1015: MUST run before strip_generic_type_params below -- that pass\n  // unconditionally zeroes every top-level generic fn's type_params/bounds\n  // (erasure, not specific to `to_string`), so checking the Show-bounded\n  // generic-wrapper shape after stripping would always see 0 type params\n  // and always return false, permanently disabling the gc-lane\n  // to_string(Bool) call-site fast path (codegen/gc/backend_call.vibe).\n  // See the doc comment on gc_to_string_resolves_to_show_wrapper.\n  let gc_to_string_is_wrapper = gc_to_string_resolves_to_show_wrapper(stmts)\n  // Same effective order as the linear lane: strip source-level generic\n  // params, then the trait-dict desugar (compile_wasi_module_linked_impl\n  // runs it as its first step).\n  strip_generic_type_params(stmts)\n  desugar_trait_dicts(stmts)\n  compile_wasi_module_gc(stmts, effective_entry, gc_to_string_is_wrapper)\n}\n")
}

