let cli_adapter_source_114 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/builtin_bodies/bodies_core_a2.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  emit_rc_word_inc_saturating, rc_shadow_base, CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_heap_memory_grow_check, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_v128_load, emit_i8x16_splat, emit_i8x16_eq, emit_i8x16_le_u, emit_i8x16_sub, emit_v128_or, emit_v128_not, emit_i8x16_bitmask, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\nexport fn gen_identity_body() -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  b\n}\n\nexport fn gen_arr_slice_body(enable_rc: Bool, rc_alloc_idx: Int, rc_shadow: Bool) -> Bytes {\n  let b = bytebuf_new()\n  // #982: slice had ZERO bounds checks — `Array::slice([1,2,3], 1, 10)`\n  // memory_copy'd 9 elements of raw adjacent heap into the result and\n  // `Array::slice(a, 2, 0)` computed a negative count that trapped inside the\n  // copy (while Bytes::slice is bounds-checked, #811 — non-uniform). Clamp\n  // start into [0, len] and end into [start', len] up front, so an\n  // out-of-range slice tolerantly truncates and an inverted range yields [].\n  // Scratch i64 local for len: RC reuses existing local 10 (elem, set later\n  // before its own use); non-RC adds local 9 (meta bumped 6/0 -> 6/1 at the\n  // linked_compile push_builtin site).\n  let len_local = if enable_rc {\n    10\n  } else {\n    9\n  }\n  // len = value[4] (i64, untagged element count)\n  emit_local_get(b, 0)\n  if enable_rc {\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n  } else {\n    ()\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)\n  emit_i64_extend_i32_u(b)\n  emit_local_set(b, len_local)\n  // param1 (start) := retag(clamp(untag(start), 0, len))\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_i64_const(b, 0)\n  emit_i64_lt_s(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 0)\n  emit_else(b)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_local_get(b, len_local)\n  emit_i64_gt_s(b)\n  emit_if_i64(b)\n  emit_local_get(b, len_local)\n  emit_else(b)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_end(b)\n  emit_end(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  } else {\n    ()\n  }\n  emit_local_set(b, 1)\n  // param2 (end) := retag(clamp(untag(end), untag(start'), len))\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_i64_lt_s(b)\n  emit_if_i64(b)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_else(b)\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_local_get(b, len_local)\n  emit_i64_gt_s(b)\n  emit_if_i64(b)\n  emit_local_get(b, len_local)\n  emit_else(b)\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_end(b)\n  emit_end(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  } else {\n    ()\n  }\n  emit_local_set(b, 2)\n  if enable_rc {\n    // ADR-0055 Stage 4: build the slice as a self-describing RC block, the same\n    // shape as gen_arr_new / a literal array, so the recursive rc_drop and the\n    // free-list can reach it. Layout: [alloc_size@0][rc_count@4][class=5@7],\n    // value = block+8, value[0]=cap value[4]=len value[8]=data_ptr=block+20.\n    // The copied elements are shared with the source, so each RC-managed element\n    // is dup'd (guarded) — without this the source drop frees them while the\n    // slice still references them (use-after-free / trap, issue #500).\n    // locals: 3=src_val 4=src_data 5=count 6=block 7=data_ptr 8=cap 9=i (i32),\n    //         10=elem (i64).\n    // src_val = wrap(arr & -2)  (untag the odd source pointer)\n    emit_local_get(b, 0)\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 3)\n    // src_data = src_val[8]\n    emit_local_get(b, 3)\n    emit_i32_load(b, 2, 8)\n    emit_local_set(b, 4)\n    // count = untag(end) - untag(start)\n    emit_local_get(b, 2)\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n    emit_i32_wrap_i64(b)\n    emit_local_get(b, 1)\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n    emit_i32_wrap_i64(b)\n    emit_i32_sub(b)\n    emit_local_set(b, 5)\n    // cap = count + 8\n    emit_local_get(b, 5)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_local_set(b, 8)\n    // block = wrap(vibe_rc_alloc(20 + cap*8))\n    emit_i32_const(b, 20)\n    emit_local_get(b, 8)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_i64_extend_i32_u(b)\n    emit_call(b, rc_alloc_idx)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 6)\n    // block[0] = alloc_size = 20 + cap*8\n    emit_local_get(b, 6)\n    emit_i32_const(b, 20)\n    emit_local_get(b, 8)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 0)\n    // block[4] = rc_count = 1\n    emit_local_get(b, 6)\n    emit_i32_const(b, 1)\n    emit_i32_store(b, 2, 4)\n    // block[7] = class = 5 (array); high byte of the rc_count word\n    emit_local_get(b, 6)\n    emit_i32_const(b, 5)\n    emit_i32_store8(b, 0, 7)\n    // value[0] (block+8) = cap\n    emit_local_get(b, 6)\n    emit_local_get(b, 8)\n    emit_i32_store(b, 2, 8)\n    // value[4] (block+12) = len = count\n    emit_local_get(b, 6)\n    emit_local_get(b, 5)\n    emit_i32_store(b, 2, 12)\n    // data_ptr = block+20\n    emit_local_get(b, 6)\n    emit_i32_const(b, 20)\n    emit_i32_add(b)\n    emit_local_set(b, 7)\n    // value[8] (block+16) = data_ptr\n    emit_local_get(b, 6)\n    emit_local_get(b, 7)\n    emit_i32_store(b, 2, 16)\n    // memory_copy: dst=data_ptr, src=src_data + untag(start)*8, len=count*8\n    emit_local_get(b, 7)\n    emit_local_get(b, 4)\n    emit_local_get(b, 1)\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n    emit_i32_wrap_i64(b)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_local_get(b, 5)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_memory_copy(b)\n    // dup each copied RC-managed element (guarded: odd && high32==0)\n    emit_i32_const(b, 0)\n    emit_local_set(b, 9)\n    emit_block_void(b)\n    emit_loop_void(b)\n    emit_local_get(b, 9)\n    emit_local_get(b, 5)\n    emit_i32_ge_u(b)\n    emit_br_if(b, 1)\n    // elem = load_i64(data_ptr + i*8)\n    emit_local_get(b, 7)\n    emit_local_get(b, 9)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_i64_load(b, 3, 0)\n    emit_local_set(b, 10)\n    // if (elem & 1) — odd heap pointer\n    emit_local_get(b, 10)\n    emit_i64_const(b, 1)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_if_void(b)\n    // if (elem >> 32) == 0 — not a string/bytes fat pointer\n    emit_local_get(b, 10)\n    emit_i64_const(b, 32)\n    emit_i64_shr_s(b)\n    emit_i64_eqz(b)\n    emit_if_void(b)\n    // #715 recurrence guard (VIBE_RC=shadow): trap on dup-of-freed element.\n    if rc_shadow {\n      emit_local_get(b, 10)\n      emit_i64_const(b, -2)\n      emit_i64_and(b)\n      emit_i32_wrap_i64(b)\n      emit_i32_const(b, rc_shadow_base())\n      emit_i32_add(b)\n      emit_i32_load8_u(b, 0, 0)\n      emit_if_void(b)\n      bytebuf_push(b, 0)\n      emit_end(b)\n    } else {\n      ()\n    }\n    // rc_count++ at (elem & -2) - 4\n    emit_rc_word_inc_saturating(b, () -> {\n      emit_local_get(b, 10)\n      emit_i64_const(b, -2)\n      emit_i64_and(b)\n      emit_i32_wrap_i64(b)\n      emit_i32_const(b, 4)\n      emit_i32_sub(b)\n    })\n    emit_end(b)\n    emit_end(b)\n    // i++\n    emit_local_get(b, 9)\n    emit_i32_const(b, 1)\n    emit_i32_add(b)\n    emit_local_set(b, 9)\n    emit_br(b, 0)\n    emit_end(b)\n    emit_end(b)\n    // return (block+8) | 1  (odd-tagged value pointer)\n    emit_local_get(b, 6)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i64_extend_i32_u(b)\n    emit_i64_const(b, 1)\n    emit_i64_or(b)\n  } else {\n    emit_local_get(b, 0)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 3)\n    emit_local_get(b, 3)\n    emit_i32_load(b, 2, 8)\n    emit_local_set(b, 4)\n    emit_local_get(b, 2)\n    emit_i32_wrap_i64(b)\n    emit_local_get(b, 1)\n    emit_i32_wrap_i64(b)\n    emit_i32_sub(b)\n    emit_local_set(b, 5)\n    emit_local_get(b, 5)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_local_set(b, 8)\n    emit_global_get(b, 0)\n    emit_local_tee(b, 6)\n    emit_i32_const(b, 12)\n    emit_local_get(b, 8)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_i32_add(b)\n    emit_global_set(b, 0)\n    emit_heap_memory_grow_check(b)\n    emit_local_get(b, 6)\n    emit_local_get(b, 8)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 6)\n    emit_local_get(b, 5)\n    emit_i32_store(b, 2, 4)\n    emit_local_get(b, 6)\n    emit_i32_const(b, 12)\n    emit_i32_add(b)\n    emit_local_set(b, 7)\n    emit_local_get(b, 6)\n    emit_local_get(b, 7)\n    emit_i32_store(b, 2, 8)\n    emit_local_get(b, 7)\n    emit_local_get(b, 4)\n    emit_local_get(b, 1)\n    emit_i32_wrap_i64(b)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_local_get(b, 5)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_memory_copy(b)\n    emit_local_get(b, 6)\n    emit_i64_extend_i32_u(b)\n  }\n  b\n}\n\nexport fn gen_bytes_get_body(enable_rc: Bool) -> Bytes {\n  let b = bytebuf_new()\n  // #811: unsigned bounds check (idx as u32 >= len traps; negatives too).\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)\n  emit_i32_ge_u(b)\n  emit_if_void(b)\n  bytebuf_push(b, 0)\n  emit_end(b)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  // ADR-0055 Stage 1: the index arrives tagged (n<<1); untag before use.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: the byte is a count entering the value world; tag it.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  b\n}\n\nexport fn gen_bytes_len_body(enable_rc: Bool) -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: the length is a count entering the value world; tag it.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  b\n}\n\n// simd_skip_ws(buf: Bytes, pos: Int, len: Int) -> Int\n// Returns the smallest index i in [pos, len) such that buf[i] is not an ASCII\n// whitespace byte (space/tab/LF/CR); returns len if every byte in the range is\n// whitespace. A SIMD fast path skips whole 16-byte chunks that are entirely\n// whitespace; a scalar tail handles the final partial chunk and the chunk that\n// first contains a non-whitespace byte. The v128 values stay on the operand\n// stack (no v128 local), so the function declares only i32/i64 locals.\n//   locals: i32 { 3: addr (data ptr), 4: byte } ; i64 { 5: p, 6: n }\nexport fn gen_simd_skip_ws_body(enable_rc: Bool) -> Bytes {\n  let b = bytebuf_new()\n  // addr = data pointer of the Bytes object (payload pointer at obj+8)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 3)\n  // p = untag(pos)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_local_set(b, 5)\n  // n = untag(len)\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_local_set(b, 6)\n  // --- SIMD fast path: skip 16-byte chunks that are entirely whitespace ---\n  emit_block_void(b)\n  emit_loop_void(b)\n  // if p + 16 > n: leave the fast path\n  emit_local_get(b, 5)\n  emit_i64_const(b, 16)\n  emit_i64_add(b)\n  emit_local_get(b, 6)\n  emit_i64_gt_s(b)\n  emit_br_if(b, 1)\n  // is_space (0x20)\n  emit_local_get(b, 3)\n  emit_local_get(b, 5)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_v128_load(b, 0, 0)\n  emit_i64_const(b, 32)\n  emit_i32_wrap_i64(b)\n  emit_i8x16_splat(b)\n  emit_i8x16_eq(b)\n  // is_tab (0x09)\n  emit_local_get(b, 3)\n  emit_local_get(b, 5)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_v128_load(b, 0, 0)\n  emit_i64_const(b, 9