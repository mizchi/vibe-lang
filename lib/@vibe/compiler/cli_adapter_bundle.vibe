"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Stmt\n}\n\nimport @vibe/compiler/syntax {\n  parse_stmt, Token\n}\n//# Functions\n\nexport fn parse_interp_expr(tokens: Array[Token]) -> Expr with { Error } {\n  let (stmt, _) = parse_stmt(tokens, [], 0)\n  match stmt {\n    SExpr(expr) => expr,\n    _ => throw(\"expected interpolation expression\")\n  }\n}\n")
}

