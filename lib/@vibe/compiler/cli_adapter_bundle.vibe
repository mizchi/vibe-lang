t_idx: Int) -> Bytes {\n  let _ = str_concat_idx\n  let b = bytebuf_new()\n  // n = arr_len(arr). Under RC `arr_len` returns the length TAGGED (len<<1) and\n  // `arr_get` expects the index TAGGED (#705) — this body otherwise uses the raw\n  // untagged convention, so untag the count here and tag each index below, or\n  // the loop runs 2*len times (OOB) and reads element i/2.\n  emit_local_get(b, 0)\n  emit_call(b, arr_len_idx)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  // empty array -> empty string (0)\n  emit_local_get(b, 2)\n  emit_i32_eqz(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 0)\n  emit_else(b)\n  // sep_len = lo32(sep); sep_ptr = hi32(sep)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 5)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 6)\n  // pass 1: total = sum of len(arr[i])\n  emit_i32_const(b, 0)\n  emit_local_set(b, 4)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 3)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 2)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 3)\n  emit_i64_extend_i32_u(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  } else {\n    ()\n  }\n  emit_call(b, arr_get_idx)\n  emit_local_set(b, 11)\n  emit_local_get(b, 4)\n  emit_local_get(b, 11)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  // total += sep_len * (n - 1)\n  emit_local_get(b, 4)\n  emit_local_get(b, 5)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 1)\n  emit_i32_sub(b)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_local_set(b, 4)\n  // base = bump(total); pos = base\n  emit_global_get(b, 0)\n  emit_local_tee(b, 7)\n  emit_local_get(b, 4)\n  emit_i32_add(b)\n  emit_i32_const(b, 7)\n  emit_i32_add(b)\n  emit_i32_const(b, -8)\n  bytebuf_push(b, 113)\n  emit_global_set(b, 0)\n  emit_heap_memory_grow_check(b)\n  emit_local_get(b, 7)\n  emit_local_set(b, 8)\n  // pass 2: copy sep (when i>0) then arr[i] bytes\n  emit_i32_const(b, 0)\n  emit_local_set(b, 3)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 2)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  // if i != 0: memcpy(pos, sep_ptr, sep_len); pos += sep_len\n  emit_local_get(b, 3)\n  emit_i32_const(b, 0)\n  emit_i32_ne(b)\n  emit_if_void(b)\n  emit_local_get(b, 8)\n  emit_local_get(b, 6)\n  emit_local_get(b, 5)\n  emit_memory_copy(b)\n  emit_local_get(b, 8)\n  emit_local_get(b, 5)\n  emit_i32_add(b)\n  emit_local_set(b, 8)\n  emit_end(b)\n  // cur = arr[i]; cur_ptr = hi32(cur); cur_len = lo32(cur)\n  emit_local_get(b, 0)\n  emit_local_get(b, 3)\n  emit_i64_extend_i32_u(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  } else {\n    ()\n  }\n  emit_call(b, arr_get_idx)\n  emit_local_set(b, 11)\n  emit_local_get(b, 11)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 9)\n  emit_local_get(b, 11)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 10)\n  // memcpy(pos, cur_ptr, cur_len); pos += cur_len\n  emit_local_get(b, 8)\n  emit_local_get(b, 9)\n  emit_local_get(b, 10)\n  emit_memory_copy(b)\n  emit_local_get(b, 8)\n  emit_local_get(b, 10)\n  emit_i32_add(b)\n  emit_local_set(b, 8)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  // result = (base << 32) | total\n  emit_local_get(b, 7)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 32)\n  emit_i64_shl(b)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  emit_i64_or(b)\n  emit_end(b)\n  b\n}\n\nexport fn gen_string_trim_body(enable_rc: Bool, str_len_idx: Int, str_char_code_at_idx: Int, str_substring_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_call(b, str_len_idx)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 1)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_local_set(b, 3)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 2)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055: char_code_at is value-world under RC — tag the index it consumes.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, str_char_code_at_idx)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_tee(b, 4)\n  emit_i32_const(b, 32)\n  emit_i32_eq(b)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 9)\n  emit_i32_eq(b)\n  bytebuf_push(b, 114)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 10)\n  emit_i32_eq(b)\n  bytebuf_push(b, 114)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 13)\n  emit_i32_eq(b)\n  bytebuf_push(b, 114)\n  emit_i32_eqz(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 2)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 2)\n  bytebuf_push(b, 76)\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 1)\n  emit_i32_sub(b)\n  emit_i64_extend_i32_u(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, str_char_code_at_idx)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_tee(b, 4)\n  emit_i32_const(b, 32)\n  emit_i32_eq(b)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 9)\n  emit_i32_eq(b)\n  bytebuf_push(b, 114)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 10)\n  emit_i32_eq(b)\n  bytebuf_push(b, 114)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 13)\n  emit_i32_eq(b)\n  bytebuf_push(b, 114)\n  emit_i32_eqz(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 1)\n  emit_i32_sub(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 2)\n  emit_i64_extend_i32_u(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_local_get(b, 3)\n  emit_i64_extend_i32_u(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, str_substring_idx)\n  b\n}\n\nlet static_eq_body_bytes = Bytes::from_array([\n  32,\n  0,\n  32,\n  1,\n  81,\n  173\n])\n\nexport fn static_eq_body() -> Bytes {\n  static_eq_body_bytes\n}\n\nexport fn gen_arr_truncate_body(enable_rc: Bool) -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  // ADR-0055: untag the odd array pointer under RC.\n  if enable_rc {\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 1)\n  // ADR-0055: the new length arrives tagged; untag before storing.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_store(b, 2, 4)\n  b\n}\n\nexport fn gen_string_split_body(enable_rc: Bool, arr_new_idx: Int, arr_push_idx: Int, str_len_idx: Int, str_substring_idx: Int, string_index_of_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_call(b, arr_new_idx)\n  emit_local_set(b, 6)\n  emit_local_get(b, 0)\n  emit_call(b, str_len_idx)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_call(b, str_len_idx)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 4)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_local_get(b, 2)\n  emit_i64_extend_i32_u(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, str_substring_idx)\n  emit_local_get(b, 1)\n  emit_call(b, string_index_of_idx)\n  // ADR-0055: String::index_of returns a tagged index under RC; untag for use.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 5)\n  emit_local_get(b, 5)\n  emit_i32_const(b, 0)\n  bytebuf_push(b, 72)\n  emit_br_if(b, 1)\n  emit_local_get(b, 6)\n  emit_local_get(b, 0)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_local_get(b, 4)\n  emit_local_get(b, 5)\n  emit_i32_add(b)\n  emit_i64_extend_i32_u(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, str_substring_idx)\n  emit_call(b, arr_push_idx)\n  emit_local_get(b, 4)\n  emit_local_get(b, 5)\n  emit_i32_add(b)\n  emit_local_get(b, 3)\n  emit_i32_add(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 6)\n  emit_local_get(b, 0)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_local_get(b, 2)\n  emit_i64_extend_i32_u(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, str_substring_idx)\n  emit_call(b, arr_push_idx)\n  emit_local_get(b, 6)\n  b\n}\n\n// #997: `i64.trunc_f64_s` TRAPS (an unhandled wasm `unreachable`-style trap,\n// not a catchable vibe error) on NaN, +-Infinity, or any magnitude outside\n// the i64 range -- so `Double::to_int(0.0 / 0.0)` used to abort the whole\n// program instead of returning a value. This was