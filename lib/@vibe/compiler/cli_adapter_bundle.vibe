op_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\nimport ./compile_call.vibe {\n  cc_is_borrow_ret_call, cc_is_loop_borrowed_ident, compile_call\n}\n\nimport ./compile_expr_tail3.vibe {\n  compile_expr_tail3\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\nexport fn compile_expr_tail2(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let __tag = expr_tag(expr)\n  if __tag == 15 {\n    let __tuple_elems = get_etuple_elems(expr)\n    let num_elems = Array::length(__tuple_elems)\n    let ptr_local = next_local\n    Array::push(local_names, \"__tuple_ptr\")\n    let mut nl = next_local + 1\n    if ctx.enable_rc {\n      // RC layout (docs/spec/selfhost-rc-port.md):\n      //   block_start: [alloc_size@0][rc_count@4][type_id@8][length@12][payload@16...]\n      // The tuple value is block_start+8 (points at type_id), so the live header\n      // is [alloc_size@ptr-8][rc_count@ptr-4][type_id@ptr+0][length@ptr+4] and the\n      // payload stays at ptr+8 (field access is unchanged). ptr_local holds\n      // block_start. type_id 3 = tuple.\n      let total = 16 + num_elems * 8\n      // ADR-0055 Stage 4: allocate via the free-list search helper (vibe_rc_alloc) —\n      // exact-fit reuse anywhere in the list, else bump. Replaces the inline\n      // head-only check, which fragmented when interleaved sizes were freed.\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      // header words at block_start\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      // ADR-0055 Stage 2c/3: uniform drop-class byte in the rc_count word's high\n      // byte (block+7 = value-1). rc stays in the low 24 bits, so dec (full-word\n      // -1) and the `*256 == 0` zero-test ignore this byte. 1 = field-vector\n      // ([?@value+0][count@value+4][fields@value+8+i*8]) — the generic recursive\n      // rc_drop loops `count` fields. (docs/spec/uniform-value-repr.md)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store8(buf, 0, 7)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 3)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, num_elems)\n      emit_i32_store(buf, 2, 12)\n      let mut tri = 0\n      while tri < num_elems {\n        let __tup_elem = Array::get(__tuple_elems, tri)\n        nl = compile_expr(buf, __tup_elem, local_names, nl, ctx, ld)\n        let __tup_val_local = nl\n        Array::push(local_names, \"__tup_val\")\n        emit_local_set(buf, __tup_val_local)\n        nl = nl + 1\n        // #715: a tuple element sourced from a field projection (`a.f`) or a\n        // borrow-returning call (Array::get/Map::get/__rec_field/a user\n        // wrapper) is a BORROWED view of its source, exactly like the same\n        // case already handled for ERecord fields above (#704/#708) --\n        // without this retain, dropping the source after storing its\n        // element into this owning tuple leaves the tuple holding a\n        // dangling reference once the source is freed.\n        //\n        // The same applies to a BARE IDENT element whose binding is itself\n        // borrow-bound (`let pt2 = f(resolved, env)` where `f` returns its\n        // own argument -- the #708 is_borrow_ret_ext piggyback marks such a\n        // name loop-borrowed for the let's body) or live-in to an enclosing\n        // loop (#706): compile_call already dups these at call-argument\n        // positions via cc_is_loop_borrowed_ident, but a tuple literal\n        // stored the bare borrowed ref undup'd, so the true owner's\n        // scope-end drop freed the block the escaping tuple still pointed\n        // at (checker.vibe's `(pt2, s1, c1)` in check_expr's EFn param loop\n        // -- the `enum Shape { Circle }` / `(Int) -> Int` one-line repros'\n        // confirmed UAF site).\n        let __tup_is_proj = match __tup_elem {\n          EDot(_, _, _, _) => true,\n          _ => false\n        }\n        if ctx.enable_rc && (__tup_is_proj || cc_is_borrow_ret_call(__tup_elem, ctx) || cc_is_loop_borrowed_ident(__tup_elem, ctx)) {\n          emit_rc_dup_guarded(buf, __tup_val_local, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, __tup_val_local)\n        emit_i64_store(buf, 3, 16 + tri * 8)\n        tri = tri + 1\n      }\n      // tuple value = (block_start + 8) | 1 (ADR-0055 Stage 2: all heap pointers\n      // are odd so a generic recursive rc_drop can classify fields by `& 1`).\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl\n    } else {\n      let alloc_size = num_elems * 8\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, alloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      let mut ti = 0\n      while ti < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = compile_expr(buf, Array::get(__tuple_elems, ti), local_names, nl, ctx, ld)\n        emit_i64_store(buf, 3, ti * 8)\n        ti = ti + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl\n    }\n  } else if __tag == 16 {\n    compile_match(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  } else if __tag == 17 {\n    let elems = get_earray_elems(expr)\n    let n_elems = Array::length(elems)\n    if ctx.enable_rc {\n      // RC array literal: inline-allocate the array object with the tuple-style\n      // RC layout so it drops like a tuple (value = block+8, untagged). Object\n      // layout at the value pointer matches the array runtime\n      // (`[capacity@0][length@4][data_ptr@8][inline_data@12...]`); data_ptr points\n      // at the inline buffer (value+12). capacity defaults to 8 (as array_new)\n      // but is sized up for larger literals so all elements fit inline.\n      // The header behind is [alloc_size@-8][rc_count@-4]; the array runtime\n      // (Array::get / length / push) reads value+0/+4/+8, unchanged.\n      // (docs/spec/selfhost-rc-port.md)\n      let cap = if n_elems > 8 {\n        n_elems\n      } else {\n        8\n      }\n      let total = 20 + cap * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__arr_ptr\")\n      let mut nl = next_local + 1\n      // ADR-0055 Stage 4: allocate via the free-list search helper (vibe_rc_alloc).\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      // header at block_start\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      // ADR-0055 Stage 2c/3: drop-class byte (block+7). 5 = array — value+0 is\n      // capacity (not a count) and elements live behind data_ptr@value+8, so the\n      // recursive rc_drop must use the array path, not the field-vector loop.\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 5)\n      emit_i32_store8(buf, 0, 7)\n      // array object at block_start+8 = value: capacity, length, data_ptr\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, cap)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, n_elems)\n      emit_i32_store(buf, 2, 12)\n      // data_ptr = value + 12 = block_start + 20 (inline buffer)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 20)\n      emit_i32_add(buf)\n      emit_i32_store(buf, 2, 16)\n      // store elements at block_start + 20 + i*8\n      let mut ai = 0\n      while ai < n_elems {\n        let __arr_elem = Array::get(elems, ai)\n        nl = compile_expr(buf, __arr_elem, local_names, nl, ctx, ld)\n        let __arr_val_local = nl\n        Array::push(local_names, \"__arr_val\")\n        emit_local_set(buf, __arr_val_local)\n        nl = nl + 1\n        // #715: an array-literal element sourced from a projection, a\n        // borrow-returning call, or a borrow-bound/loop-borrowed bare ident\n        // is a BORROWED view of its source; the array OWNS its elements\n        // (drop class 5 recurses), so retain it or the source's drop frees\n        // the block this array still points at. Same gap/fix as the ETuple\n        // case above (see its comment).\n        let __arr_is_proj = match __arr_elem {\n          EDot(_, _, _, _) => true,\n          _ => false\n        }\n        if __arr_is_proj || cc_is_borrow_ret_call(__arr_elem, ctx) || cc_is_loop_borrowed_ident(__arr_elem, ctx) {\n          emit_rc_dup_guarded(buf, __arr_val_local, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, __arr_val_local)\n        emit_i64_store(buf, 3, 20 + ai * 8)\n        ai = ai + 1\n      }\n      // array value = (block_start + 8) | 1 (ADR-0055 Stage 2b: odd heap pointer)\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl\n    } else {\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let arr_local = next_local\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, arr_local)\n      Array::push(local_names, \"__arr_lit\")\n      let mut nl = next_local + 1\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        emit_local_get(buf, arr_local)\n        nl = compile_expr(buf, Array::get(elems, ei), local_names, nl, ctx, ld)\n        emit_call(buf, arr_push_idx)\n        ei = ei + 1\n      }\n      emit_local_get(buf, arr_local)\n      nl\n    }\n  } else if __tag == 18 {\n    let names_len_at_forin = Array::length(local_names)\n    let var_name = get_eforin_name(expr)\n    let iter_expr = get_eforin_iter(expr)\n    let body = get_eforin_body(expr)\n    // #715: mirror EWhile's (#706) loop-borrowed-names protection. The outer\n    // locals live at loop entry are re-consumed on every iteration via the\n    // back-edge (`br 0`), so a consuming use of one inside the body must dup\n    // to survive past the first iteration. Names declared inside the body\n    // (var_name, index_name, __forin_* temps) are appended past lb_base and\n    // never added here, matching EWhile.\n    let lb_base = Array::length(ctx.loop_borrowed_names)\n    if ctx.enable_rc {\n      let mut lbi = 0\n      while lbi < names_len_at_forin {\n        Array::push(ctx.loop_borrowed_names, Array::get(local_names, lbi))\n        lbi = lbi + 1\n      }\n    } else {\n      ()\n    }\n    let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \"array_new\")\n    let (arr_len_fi, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n    let (arr_get_fi, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n    let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n    let result_local = next_local\n    let arr_local = next_local + 1\n    let i_local = next_local + 2\n    Array::push(local_names, \"__forin_res\")\n    Array::push(local_names, \"__forin_arr\")\n    Array::push(local_names, \"__forin_i\")\n    emit_call(buf, arr_new_fi)\n    emit_local_set(buf, result_local)\n    let nl1pre = compile_expr(buf, iter_expr, local_names, next_local + 3, ctx, ld)\n    emit_local_set(buf, arr_local)\n    // #807: for-in over a String silently iterated zero times — the loop\n    // below reads `Array::length` from the value, but a String is an\n    // `(offset << 32) | length` fat pointer, not an array pointer. Array\n    // values (rc-tagged or not) are 32-bit heap pointers whose high 32 bits\n    // are zero, so dispatch on the high bits at runtime (same fat-pointer\n    // discrimination family as `__to_string`, ADR-0058) and materialize the\n    // string's bytes into a fresh Array[Int] of char codes before the shared\n    // array loop. The offset-0 interned string (\"\") misclassifies as an\n    // array whose length load reads zeroed memory — 0 iterations either way,\n    // so it stays correct. String offsets are < 2^31, so the arithmetic\n    // shift never sign-extends. Under RC the materialized array is not\n    // dropped at loop exit (same as the iterated value today).\n    let (str_len_fi, _, _) = resolve_func(ctx.func_table, \"String::length\")\n    let (str_ccat_fi, _, _) = resolve_func(ctx.func_table, \"String::char_code_at\")\n    let conv_local = nl1pre\n    let j_local = nl1pre + 1\n    Array::push(local_names, \"__forin_conv\")\n    Array::push(local_names, \"__forin_j\")\n    let nl1 = nl1pre + 2\n    emit_local_get(buf, arr_local)\n    emit_i64_const(buf, 32)\n    emit_i64_shr_s(buf)\n    emit_i64_eqz(buf)\n    emit_if_void(buf)\n    emit_else(buf)\n    emit_call(buf, arr_new_fi)\n    emit_local_set(buf, conv_local)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, j_local)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    emit_local_get(buf, j_local)\n    emit_local_get(buf, arr_local)\n    emit_call(buf, str_len_fi)\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shr_s(buf)\n    } else {\n      ()\n    }\n    emit_i64_ge_s(buf)\n    emit_br_if(buf, 1)\n    emit_local_get(buf, conv_local)\n    emit_local_get(buf, arr_local)\n    emit_local_get(buf, j_local)\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shl(buf)\n    } else {\n      ()\n    }\n    emit_call(buf, str_ccat_fi)\n    emit_call(buf, arr_push_fi)\n    emit_local_get(buf, j_local)\n    emit_i64_const(buf, 1)\n    emit_i64_add(buf)\n    emit_local_set(buf, j_local)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    emit_local_get(buf, conv_local)\n    emit_local_set(buf, arr_local)\n    emit_end(buf)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, i_local)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    emit_local_get(buf, i_local)\n    emit_local_get(buf, arr_local)\n    emit_call(buf, arr_len_fi)\n    // `i_local` is a raw counter (init 0, step 1). Under RC `Array::length`\n    // returns a tagged Int (`len << 1`), so untag it to compare against the raw\n    // counter — otherwise the loop runs twice per element (#704). The index is\n    // re-tagged at the `Array::get` site below.\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shr_s(buf)\n    }\n    emit_i64_ge_s(buf)\n    emit_br_if(buf, 1)\n    // Indexed `for i, x in arr`: bind the loop counter to the user index name\n    // before the value var (gc backend parity — backend_expr.vibe). The counter\n    // `i_local` is a raw i64; under RC ints are `value << 1`, so shift to match\n    // the user-visible Int representation (same as EInt codegen).\n    let index_name = get_eforin_index(expr)\n    let var_local = match index_name {\n      Some(idx_name) => {\n        emit_local_get(buf, i_local)\n        if ctx.enable_rc {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        }\n        emit_local_set(buf, nl1)\n        Array::push(local_names, idx_name)\n        nl1 + 1\n      },\n      None => nl1\n    }\n    emit_local_get(buf, arr_local)\n    emit_local_get(buf, i_local)\n    // Re-tag the raw counter to a vibe Int (`i << 1`) so `Array::get` (which\n    // untags its index under RC) reads the correct element (#704).\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shl(buf)\n    }\n    emit_call(buf, arr_get_fi)\n    emit_local_set(buf, var_local)\n    Array::push(local_names, var_name)\n    // #715: `var_name` is bound to `Array::get(arr, i)`'s result every\n    // iteration -- a BORROWED view into `arr_local`, exactly like a\n    // hand-written `let var_name = Array::get(arr, i)` (compile_expr_tail.vibe's\n    // is_borrow_ret handling, which deliberately leaves such a let untracked\n    // and instead dups at each owning consuming use via the loop_borrowed_names\n    // piggyback -- see its #708-follow-up comment). EForIn's implicit bind\n    // skipped that registration entirely, so a body that passes `var_name` to a\n    // function taking ownership of its argument (e.g. a self-recursive call\n    // like `resolve_type_expr(p, defs)`) let the callee drop a reference the\n    // array still owns -- a same-address free while `arr_local` still points at\n    // it, corrupting the free list once `arr_local` is later dropped or reread.\n    // Reuse the same ctx.loop_borrowed_names mechanism (cc_is_loop_borrowed_ident\n    // in compile_call.vibe) so owning uses of `var_name` inside `body` get the\n    // missing dup; the existing `Array::truncate(ctx.loop_borrowed_names, lb_base)`\n    // below already restores the outer state since this push lands after lb_base.\n    if ctx.enable_rc {\n      Array::push(ctx.loop_borrowed_names, var_name)\n    } else {\n      ()\n    }\n    let nl2 = var_local + 1\n    // Same innermost-loop ld reset as EWhile (see compile_expr_tail3).\n    let nl3 = compile_expr(buf, body, local_names, nl2, ctx, 0)\n    let body_val = nl3\n    Array::push(local_names, \"__forin_val\")\n    emit_local_set(buf, body_val)\n    emit_local_get(buf, result_local)\n    emit_local_get(buf, body_val)\n    emit_call(buf, arr_push_fi)\n    emit_local_get(buf, i_local)\n    emit_i64_const(buf, 1)\n    emit_i64_add(buf)\n    emit_local_set(buf, i_local)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    Array::truncate(ctx.loop_borrowed_names, lb_base)\n    emit_local_get(buf, result_local)\n    // Restore the outer scope. The loop's internal bindings (result/arr/i, the\n    // optional index name, the value name, and the body temp) must not leak into\n    // later identifier lookups, which scan local_names from the end and would\n    // otherwise resolve a shadowed outer var to a stale loop slot. Mirror\n    // compile_match: truncate back to the entry length, then pad with placeholders\n    // up to the high-water local count so slot numbering is preserved.\n    let final_nl = nl3 + 1\n    Array::truncate(local_names, names_len_at_forin)\n    while Array::length(local_names) < final_nl {\n      Array::push(local_names, \"\")\n    }\n    final_nl\n  } else {\n    compile_expr_tail3(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

let cli_adapter_source_99 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/compile_expr_tail.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bsearch_leftmost,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars,\n  collect_free_vars_indexed,\n  collect_free_vars_indexed_self,\n  collect_strings_stmts,\n  emit_closure_call_tail,\n  emit_closure_resolve,\n  emit_i64_extend_i32_u,\n  mut_needs_ref_cell,\n  proj_root_ident,\n  scope_tail_proj_root\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  LineMapState,\n  StrTable,\n  agg_expr_lookup,\n  agg_ret_lookup,\n  agg_slot_lookup,\n  emit_binop_op,\n  emit_heap_grow_after_heap_set,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_rc_dup_guarded,\n  emit_str_ref,\n  expr_tag,\n  find_local_slot,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_off,\n  get_elet_val,\n  get_eletmut_off,\n  get_slet_expr,\n  get_slet_name,\n  is_ctor_call,\n  is_earray,\n  is_efn,\n  is_eident,\n  is_erecord,\n  is_etuple,\n  is_nullary_ctor_ident,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  lookup_ctor,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  first_offset,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  offset_to_line,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\nimport ./compile_call.vibe {\n  cc_builtin_call_ret_kind, cc_expr_is_stringish, compile_call\n}\n\nimport ./compile_expr_tail2.vibe {\n  compile_expr_tail2\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\n/// ADR-0055 tag repair for compound assignment: under RC both operands are\n/// tagged (n<<1), so `+`, `-`, `%` preserve the tag for free, but `*` yields\n/// ab<<2 (shift right once) and `/` yields a/b untagged (shift left once).\n/// The raw emit_assignop_op alone silently doubled `x *= 2` results under RC.\nfn emit_assignop_rc_tag_fix(buf: Bytes, enable_rc: Bool, op: String) -> Unit {\n  if enable_rc && op == \"*\" {\n    emit_i64_const(buf, 1)\n    emit_i64_shr_s(buf)\n  } else if enable_rc && op == \"/\" {\n    emit_i64_const(buf, 1)\n    emit_i64_shl(buf)\n  } else {\n    ()\n  }\n}\n\n/// Interior-line breakpoints (span-arc step5): when break-mode line instrumentation\n/// is active (ctx.dbg_line_idx >= 0), emit `i32.const <line>` + `call dbg_line` for\n/// the statement whose value subexpression is `value`, deriving the 1-based source\n/// line from the value's first offset. No-op when off or when no offset is found,\n/// so the default codegen path is byte-identical. Stack-neutral: dbg_line is\n/// `(i32) -> ()`, the i32 const it consumes leaves the stack unchanged.\nfn emit_dbg_line_for(buf: Bytes, value: Expr, ctx: CompileCtx) -> Unit {\n  emit_dbg_line_stmt(buf, value, -1, ctx)\n}\n\n/// #644: append one (owning function, body-relative byte offset, file id,\n/// line) entry to `lm` for the `vibe.linemap` custom section -- called right\n/// before emit_dbg_line_stmt writes the runtime dbg_line probe, so the\n/// recorded offset is exactly where that probe's instructions begin (the\n/// static table and the live `--break` hook agree on where each source line\n/// starts). No-op when `lm` is disabled (non-debug-break builds, and every\n/// lambda-derived ctx -- see LineMapState's doc comment).\nfn linemap_record(lm: LineMapState, buf: Bytes, file_id: Int, line: Int) -> Unit {\n  if lm.enabled {\n    Array::push(lm.funcs, Array::get(lm.cur_fn, 0))\n    Array::push(lm.offsets, bytebuf_length(buf))\n    Array::push(lm.file_ids, file_id)\n    Array::push(lm.lines, line)\n  } else {\n    ()\n  }\n}\n\n/// #644: like emit_dbg_line_for, but with the STATEMENT's own source offset as\n/// the fallback anchor. `let a = 1` binds a bare literal whose subexpression\n/// carries no offset (first_offset = -1) -- the ELet/ELetMut node's stmt offset\n/// (the `let` keyword token) still locates the line, so the probe is emitted\n/// and the line is breakpoint-able.\nfn emit_dbg_line_stmt(buf: Bytes, value: Expr, stmt_off: Int, ctx: CompileCtx) -> Unit {\n  if ctx.dbg_line_idx >= 0 {\n    let voff = first_offset(value)\n    let off = if voff >= 0 {\n      voff\n    } else {\n      stmt_off\n    }\n    if off >= 0 {\n      let line = offset_to_line(ctx.dbg_line_nl, off)\n      linemap_record(ctx.linemap, buf, ctx.dbg_line_file_id, line)\n      emit_i32_const(buf, ctx.dbg_line_file_id)\n      emit_i32_const(buf, line)\n      emit_call(buf, ctx.dbg_line_idx)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\nfn is_edot(e: Expr) -> Bool {\n  match e {\n    EDot(_, _, _, _) => true,\n    _ => false\n  }\n}\n\nfn efn_is_capturing(value: Expr, ctx: CompileCtx) -> Bool with { Error } {\n  let params = get_efn_params(value)\n  let pnames = array_empty()\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pn, _) = Array::get(params, pi)\n    Array::push(pnames, pn)\n    pi = pi + 1\n  }\n  let caps = collect_free_vars_indexed(get_efn_body(value), pnames, ctx.capture_name_index)\n  Array::length(caps) > 0\n}\n\nfn slot_is_floatish(ctx: CompileCtx, slot: Int) -> Bool {\n  let arr = ctx.float_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 2 == slot {\n      result = (entry % 2) == 1\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\n/// #678: is the local in `slot` known to hold an Int/Bool? Mirrors\n/// slot_is_floatish over ctx.int_local_slots. #769 encoding: `slot*4 + kind`,\n/// kind 0 = cleared (reclassifying rebind of a reused slot), 1 = Int, 2 =\n/// String (#950), 3 = Bool -- bit 0 still means \"intish\" (both 1 and 3), so\n/// every pre-existing intish consumer is unchanged, while kind 3 additionally\n/// lets `__to_string` format a bool-bound IDENT as \"true\"/\"false\" (the\n/// #784/#785-P2 gap: `let b = true; \"\\{b}\"` printed the raw integer) and kind\n/// 2 routes a string-bound IDENT down `__to_string`'s identity path (the #950\n/// gap: `let j = String::join([], \"-\"); \"\\{j}\"` printed \"0\", the packed\n/// empty-string encoding misread as an Int). Most-recent entry wins; the log\n/// is pruned at branch/arm boundaries (int_log_reset_above) so a slot reused\n/// by a non-`let` binder reads false here rather than a stale entry.\nfn slot_is_intish(ctx: CompileCtx, slot: Int) -> Bool {\n  let arr = ctx.int_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 4 == slot {\n      result = (entry % 2) == 1\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\n/// #769: is the local in `slot` known to hold specifically a Bool (kind 3)?\nfn slot_is_boolish(ctx: CompileCtx, slot: Int) -> Bool {\n  let arr = ctx.int_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 4 == slot {\n      result = (entry % 4) == 3\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\n/// #950: is the local in `slot` known to hold specifically a String (kind 2)?\n/// Consulted only by the rebind-clear logic at the `let`/`let mut` logging\n/// sites (a non-string rebind of a previously-stringish slot must log a\n/// kind-0 override, or a later bare-ident read would see the stale kind-2\n/// entry and take __to_string's identity path on a non-string value).\nfn slot_is_stringish(ctx: CompileCtx, slot: Int) -> Bool {\n  let arr = ctx.int_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 4 == slot {\n      result = (entry % 4) == 2\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\n/// #769: does `e` statically evaluate to a Bool? Bool literals, comparison /\n/// logical operators, `!`, and -- via the kind-3 slot log above -- a bare ident\n/// `let`-bound to a boolish value. Syntactic over-approximation like\n/// expr_is_intish; consumers use it only to pick \"true\"/\"false\" formatting.\nexport fn expr_is_boolish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\n  let tag = expr_tag(e)\n  if tag == 1 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let mut i = Array::length(local_names) - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      slot_is_boolish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    op == \"==\" || op == \"!=\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"&&\" || op == \"||\"\n  } else if tag == 6 {\n    get_eunaryop_op(e) == \"!\"\n  } else if tag == 16 {\n    // #815: an `is` expression desugars at parse time to a match whose arms\n    // all return Bool literals — classify such a match as boolish so\n    // `\"\\{opt is None}\"` prints true/false instead of the raw 0/1.\n    // #825: arm bodies recurse through expr_is_boolish (not just Bool\n    // literals), because the structural `==` dispatch on Option/Result/tuple\n    // lowers to nested matches whose leaf arms are `==`/`&&` chains and Bool\n    // literals — so `\"\\{Some(1) == Some(1)}\"` prints true, not 1.\n    let arms = get_match_arms(e)\n    let alen2 = Array::length(arms)\n    if alen2 == 0 {\n      false\n    } else {\n      let mut all_bool = true\n      let mut bi2 = 0\n      while bi2 < alen2 {\n        if !expr_is_boolish(get_arm_body(Array::get(arms, bi2)), local_names, ctx) {\n          all_bool = false\n        } else {\n          ()\n        }\n        bi2 = bi2 + 1\n      }\n      all_bool\n    }\n  } else if tag == 9 {\n    // #825: the normalize pass lifts a non-ident match scrutinee into\n    // `let __m_scrut_N = <e> in match ...` (lift_match_scrutinees), so a\n    // boolish match arrives here wrapped in a let — classify by the BODY.\n    // Same for the other body-position wrappers below.\n    expr_is_boolish(get_elet_body(e), local_names, ctx)\n  } else if tag == 10 {\n    expr_is_boolish(get_eletrec_body(e), local_names, ctx)\n  } else if tag == 11 {\n    expr_is_boolish(get_eletmut_body(e), local_names, ctx)\n  } else if tag == 14 {\n    expr_is_boolish(get_eseq_second(e), local_names, ctx)\n  } else if tag == 7 {\n    // An if-expression is boolish when BOTH branches are.\n    expr_is_boolish(get_eif_then(e), local_names, ctx) && expr_is_boolish(get_eif_else(e), local_names, ctx)\n  } else if tag == 8 {\n    // #815: the `==` desugar rewrites array equality to the compiler-emitted\n    // `__arr_equals__<key>` helper and struct/enum equality to `T::equals`\n    // (both Bool-returning), so the EBinOp shape above is gone by codegen.\n    // `__arr_equals__` is a reserved compiler prefix; `::equals` (2 args) is\n    // the == rewrite's exact output shape. A `not(...)` wrap (the `!=`\n    // rewrite's output) is classified only when its single argument is itself\n    // boolish AND `not` is not locally shadowed — a user global `not` taking\n    // a boolish arg but returning non-Bool could still misformat, but that is\n    // display-only and vanishingly rare (relaxes the #785-P2 caution).\n    let bcallee = get_ecall_callee(e)\n    if is_eident(bcallee) {\n      let bcn = get_eident_name(bcallee)\n      String::starts_with(bcn, \"__arr_equals__\") || (String::ends_with(bcn, \"::equals\") && Array::length(get_ecall_args(e)) == 2) || (bcn == \"not\" && Array::length(get_ecall_args(e)) == 1 && find_local_slot(local_names, \"not\") < 0 && expr_is_boolish(Array::get(get_ecall_args(e), 0), local_names, ctx)) || cc_builtin_call_ret_kind(e, local_names, ctx) == 1\n    } else if is_efn(bcallee) && Array::length(get_ecall_args(e)) == 1 {\n      // #815: `let x: Bool = e` parses to the ascription marker\n      // `((__asc: Bool) -> __asc)(e)` (ELet carries no type field, see\n      // parser_expr_dispatch's ascribe_wrap) — honor the annotation so the\n      // binding's slot is logged boolish even when `e` itself is opaque.\n      // The SECOND and later ascriptions in one function arrive with the\n      // param renamed to `__shadow_<n>___asc` (normalize's\n      // uniquify_shadowed_bindings; per-function `seen` de-dup), so match\n      // that renamed form too — otherwise only the first annotated let per\n      // function was classified (#825 follow-up).\n      let fparams = get_efn_params(bcallee)\n      if Array::length(fparams) == 1 {\n        let (asc_name, asc_ty) = Array::get(fparams, 0)\n        (asc_name == \"__asc\" || (String::starts_with(asc_name, \"__shadow_\") && String::ends_with(asc_name, \"___asc\"))) && (match asc_ty {\n          Some(TyName(tn)) => tn == \"Bool\",\n          _ => false\n        })\n      } else {\n        false\n      }\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\n/// Blocker-3 (ADR-0055): does `e` statically evaluate to an f64 bit pattern?\n/// Syntactic over-approximation (the AST is untyped): float literals, float\n/// arithmetic / comparison over floatish operands, float-producing conversions,\n/// and — crucially — a *variable* bound to a floatish value (tracked in\n/// ctx.float_local_slots as `let`s compile). This lets `let x = 1.5; x + y`\n/// take the f64 path. Shared by compile_expr (binop/unary instruction choice)\n/// and the `let` handler below (which populates float_local_slots).\nexport fn expr_is_floatish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\n  // fbox (#797): `t.N` tuple projection survives to codegen as EDot (expr_tag\n  // -1), NOT as __rec_field (that lowering is only produced for tuple\n  // DESTRUCTURING and record-pattern desugars). Heap fields store floats as\n  // raw f64 bits (boxed under RC), so the reader must recover float-ness\n  // statically -- without this, `let t = (1.5, 2.5); t.0 + t.1` integer-adds\n  // two bit patterns into NaN and Double::to_int traps. The #724 agg log\n  // keeps the backing ETuple expression per slot; recurse into the projected\n  // element. Untracked bindings stay false (same over-approximation as the\n  // rest of this predicate).\n  let dot_float = match e {\n    EDot(dobj, dfield, _, _) => {\n      let fc = String::char_code_at(dfield, 0)\n      if fc >= 48 && fc <= 57 && is_eident(dobj) {\n        let slot = find_local_slot(local_names, get_eident_name(dobj))\n        if slot >= 0 {\n          let info = agg_slot_lookup(ctx.agg_local_slots, slot)\n          if info >= 0 && info / 64 == 1 {\n            let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\n            if is_etuple(backing) {\n              let elems = get_etuple_elems(backing)\n              let mut k = 0\n              let mut fp = 0\n              while fp < String::length(dfield) {\n                k = k * 10 + (String::char_code_at(dfield, fp) - 48)\n                fp = fp + 1\n              }\n              if k >= 0 && k < Array::length(elems) {\n                expr_is_floatish(Array::get(elems, k), local_names, ctx)\n              } else {\n                false\n              }\n            } else {\n              false\n            }\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      } else {\n        false\n      }\n    },\n    _ => false\n  }\n  let tag = expr_tag(e)\n  if dot_float {\n    true\n  } else if tag == 2 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let len = Array::length(local_names)\n    let mut i = len - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      slot_is_floatish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    // #744: arithmetic only. A float COMPARISON (`n < 0.0`) yields a Bool —\n    // including `<`/`>`/`<=`/`>=` here marked a let-bound comparison result\n    // as floatish, and a later `neg && ...` on that Bool took the float binop\n    // path and threw \"unsupported float binop: &&\".\n    if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n      expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 6 {\n    let op = get_eunaryop_op(e)\n    if op == \"-\" {\n      expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 8 {\n    let callee = get_ecall_callee(e)\n    if is_eident(callee) {\n      let fname = get_eident_name(callee)\n      if fname == \"Int::to_double\" || fname == \"Int::to_float\" || fname == \"Float::to_double\" || fname == \"Double::to_float\" || fname == \"Double::from_i64_bits\" {\n        true\n      } else if fname == \"__rec_field\" {\n        // fbox (#797): `t.0` on a TRACKED tuple-literal binding (`let t =\n        // (1.5, 2.5)`). Heap fields store floats as RAW f64 bits, so the\n        // reader must recover float-ness statically -- without this, `t.0 +\n        // t.1` integer-adds two bit patterns into NaN and `Double::to_int`\n        // traps (\"invalid conversion to integer\"). The #724 agg log already\n        // keeps the backing ETuple expression per slot; recurse into the\n        // projected element. Non-literal / untracked bindings stay false\n        // (same over-approximation as the rest of this predicate).\n        let args = get_ecall_args(e)\n        if Array::length(args) == 2 && is_eident(Array::get(args, 0)) && expr_tag(Array::get(args, 1)) == 0 {\n          let slot = find_local_slot(local_names, get_eident_name(Array::get(args, 0)))\n          if slot >= 0 {\n            let info = agg_slot_lookup(ctx.agg_local_slots, slot)\n            if info >= 0 && info / 64 == 1 {\n              let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\n              if is_etuple(backing) {\n                let elems = get_etuple_elems(backing)\n                let k = get_eint_value(Array::get(args, 1))\n                if k >= 0 && k < Array::length(elems) {\n                  expr_is_floatish(Array::get(elems, k), local_names, ctx)\n                } else {\n                  false\n                }\n              } else {\n                false\n              }\n            } else {\n              false\n            }\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      } else {\n        false\n      }\n    } else if is_efn(callee) && Array::length(get_ecall_args(e)) == 1 {\n      // #1153/#1185 (+ #1207 Codex review P2): `let x: Double = e` / `let x:\n      // Float = e` parses to the ascription marker `((__asc: Double) ->\n      // __asc)(e)` (parser_expr_dispatch's ascribe_wrap) -- mirrors\n      // expr_is_boolish's identical `is_efn(callee)` case for `Bool` (#815),\n      // just never extended to Float/Double. Without this, an explicitly-\n      // annotated Double/Float `let` is invisible to float_local_slots:\n      // under RC a float is a BOXED heap value (#704), so a `==`/`!=`\n      // between two such misclassified slots falls through emit_eq_value's\n      // generic `eq` fallback, which compares the two DISTINCT boxes by\n      // pointer rather than unboxing and comparing values -- silently\n      // `false` for equal doubles. The same misclassification also feeds\n      // `__to_string`/string interpolation, which then reads the boxed\n      // pointer as if it were a plain Int (#1153: garbage output).\n      // Matches the COMPLETE synthetic identity-lambda shape (no type\n      // params, no declared return type, no effect row, body exactly\n      // `EIdent(<the param's own name>, _)`) -- the same precision\n      // checker.vibe's `ascription_lambda_ann` uses for this identical\n      // marker -- so a hand-written IIFE that merely happens to name its\n      // param `__asc`/`__shadow_*___asc` (e.g. `((__asc: Double) -> String\n      // { \"hello\" })(1.0)`) isn't misread as this marker.\n      match callee {\n        EFn(tparams, _, params, ret_ty, effect, body) => if Array::length(tparams) == 0 && Array::length(params) == 1 && (match ret_ty {\n          None => true,\n          Some(_) => false\n        }) && (match effect {\n          None => true,\n          Some(_) => false\n        }) {\n          let (asc_name, asc_ty) = Array::get(params, 0)\n          if asc_name == \"__asc\" || (String::starts_with(asc_name, \"__shadow_\") && String::ends_with(asc_name, \"___asc\")) {\n            match body {\n              EIdent(bname, _) => if bname == asc_name {\n                match asc_ty {\n                  Some(TyName(tn)) => tn == \"Double\" || tn == \"Float\",\n                  _ => false\n                }\n              } else {\n                false\n              },\n              _ => false\n            }\n          } else {\n            false\n          }\n        } else {\n          false\n        },\n        _ => false\n      }\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\n/// #678: is `e` unambiguously an integer/bool scalar — never a string or float?\n/// Such an operand makes `==`/`!=` a direct i64.eq instead of the polymorphic\n/// `eq` builtin, whose string fall-back misreads a large integer as a string\n/// fat-pointer `(ptr<<32)|len` (two unequal ints with a zero low word compare\n/// EQUAL). Integral by SHAPE: literals, bitwise/comparison/logical operators,\n/// non-float arithmetic. A bare identifier is integral when its slot was bound\n/// to a definitely-integral value (ctx.int_local_slots, the dual of\n/// expr_is_floatish) — sound because that log is pruned at every branch/arm\n/// boundary (int_log_reset_above), so a slot reused by a non-`let` binder\n/// holding a string is never read as int. Unclassified operands (a call return,\n/// an untracked param/capture) stay false and fall back to the bounds-guarded\n/// `eq` — the narrow remaining residual.\nexport fn expr_is_intish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\n  let tag = expr_tag(e)\n  if tag == 0 {\n    true\n  } else if tag == 1 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let len = Array::length(local_names)\n    let mut i = len - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      slot_is_intish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    if op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"==\" || op == \"!=\" || op == \"&&\" || op == \"||\" {\n      true\n    } else if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n      !expr_is_floatish(e, local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 6 {\n    let op = get_eunaryop_op(e)\n    op == \"!\"\n  } else {\n    false\n  }\n}\n\nfn assign_value_mentions(value: Expr, name: String) -> Bool {\n  let empty1 = array_empty()\n  let empty2 = array_empty()\n  array_contains_str(collect_free_vars(value, empty1, empty2), name)\n}\n\nfn reassign_carry_safe(e: Expr, name: String) -> Bool {\n  if !assign_value_mentions(e, name) {\n    true\n  } else {\n    match e {\n      EIdent(_, _) => true,\n      EDot(_, _, _, _) => proj_root_ident(e) == name,\n      EBinOp(_, l, r) => reassign_carry_safe(l, name) && reassign_carry_safe(r, name),\n      EUnaryOp(_, x) => reassign_carry_safe(x, name),\n      _ => false\n    }\n  }\n}\n\nfn emit_rc_value_ptr_i32(buf: Bytes, local_idx: Int, tagged: Bool) -> Unit {\n  emit_local_get(buf, local_idx)\n  if tagged {\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n  } else {\n    ()\n  }\n  emit_i32_wrap_i64(buf)\n}\n\nfn emit_rc_drop_local(buf: Bytes, local_idx: Int, tagged: Bool) -> Unit {\n  // #720: a saturated rc (low 24 bits == 0xFFFFFF) marks an immortal block\n  // (see emit_rc_word_inc_saturating) -- never decrement, never free.\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 16777215)\n  bytebuf_push(buf, 113)\n  emit_i32_const(buf, 16777215)\n  emit_i32_ne(buf)\n  emit_if_void(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_sub(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 256)\n  emit_i32_mul(buf)\n  emit_i32_eqz(buf)\n  emit_if_void(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_global_get(buf, 2)\n  emit_i32_store(buf, 2, 0)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_global_set(buf, 2)\n  emit_end(buf)\n  emit_end(buf)\n}\n\nfn reassign_self_reusable(value: Expr, name: String) -> Bool with { Error } {\n  if is_etuple(value) {\n    let elems = get_etuple_elems(value)\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(elems) {\n      if !reassign_carry_safe(Array::get(elems, i), name) {\n        ok = false\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    ok\n  } else {\n    false\n  }\n}\n\n/// #791: shared RC heap-classification for a `let`/`let mut` binding's INITIAL\n/// value, extracted so ELet (tag 9) and ELetMut (tag 11) can never drift apart\n/// again -- the entire #715/#791 bug family was ELetMut silently missing shape\n/// coverage (EIf/EMatch/ELet/ESeq/EDot/EFn/generic-ECall) that ELet already\n/// had, one shape re-discovered and patched at a time without ever being\n/// ported to the sibling form. Requires `value` to already be compiled and\n/// stored into `local_idx` (so the is_edot/is_eident-alias branches' immediate\n/// `emit_rc_dup_guarded(buf, local_idx, ...)` targets the right local) --\n/// call this AFTER `compile_expr(buf, value, ...)` + the corresponding\n/// `emit_local_set`/`emit_local_tee`, never before. Pushes `name` into\n/// `ctx.heap_binding_names` whenever the value's shape can't be proven scalar;\n/// over-classifying is a leak/no-op at worst (guarded dup/drop no-ops on a\n/// tagged-even scalar), under-classifying is the corruption class both issues\n/// hit. Returns (rc_kind, is_borrow_ret_ext) exactly as the original inline\n/// ELet chain did, for callers that still need those (loop_borrowed_names\n/// scoping for a borrow-returning call's alias).\nfn classify_let_value_heap(buf: Bytes, value: Expr, name: String, local_idx: Int, local_names: Array[String], ctx: CompileCtx) -> (Int, Bool) with { Error } {\n  let mut rc_kind = 0\n  let mut is_borrow_ret_ext = false\n  if ctx.enable_rc {\n    if expr_is_floatish(value, local_names, ctx) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_etuple(value) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_earray(value) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_erecord(value) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_ctor_call(value, ctx.ctor_table) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if is_eident(value) {\n      let src = get_eident_name(value)\n      if array_contains_str(ctx.heap_binding_names, src) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n        if array_contains_str(ctx.rc_alias_dup_names, name) {\n          emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n    } else if expr_tag(value) == 8 {\n      let callee = get_ecall_callee(value)\n      let is_borrow_ret = if is_eident(callee) {\n        let cn = get_eident_name(callee)\n        cn == \"Array::get\" || cn == \"__index\" || cn == \"Map::get\" || cn == \"__rec_field\" || bsearch_leftmost(ctx.borrow_ret_names, cn) >= 0\n      } else {\n        false\n      }\n      // #791: consult the DECLARED return-type table (compute_heap_returning,\n      // built once from a syntactic scan of top-level signatures -- see its\n      // doc comment) before falling back to the blanket \"any ECall is heap\"\n      // default. This makes the common `let mut s = Set::new()` case\n      // precise (uses the function's OWN declared `-> Set[T]` signature)\n      // instead of over-approximating every call, without needing full\n      // checker-inferred types threaded through codegen.\n      let is_declared_heap_ret = if is_eident(callee) {\n        bsearch_leftmost(ctx.heap_ret_names, get_eident_name(callee)) >= 0\n      } else {\n        false\n      }\n      let is_builtin_scalar_ret = if is_eident(callee) {\n        let cn = get_eident_name(callee)\n        let is_always_registered = cn == \"Array::length\" || cn == \"Bytes::length\" || cn == \"String::length\" || cn == \"eq\"\n        let is_user_shadowed = !is_always_registered && array_contains_str(ctx.func_table.names, cn)\n        !is_user_shadowed && (cn == \"Array::length\" || cn == \"Bytes::length\" || cn == \"String::length\" || cn == \"Map::has_key\" || cn == \"Array::contains\" || cn == \"eq\" || cn == \"not\" || cn == \"add\" || cn == \"sub\" || cn == \"mul\" || cn == \"lt\")\n      } else {\n        false\n      }\n      let is_scalar_ret = if is_eident(callee) {\n        bsearch_leftmost(ctx.scalar_ret_names, get_eident_name(callee)) >= 0 || is_builtin_scalar_ret\n      } else {\n        false\n      }\n      if is_borrow_ret || is_scalar_ret {\n        ()\n      } else if is_declared_heap_ret {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else {\n        // No declared signature resolved either way (unannotated callee, a\n        // local closure, or a shadowed/unresolved name) -- default to heap,\n        // same \"leak/no-op at worst\" over-approximation the rest of this\n        // chain already relies on.\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      }\n      is_borrow_ret_ext = is_borrow_ret\n    } else if is_edot(value) {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n      emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n    } else if is_efn(value) {\n      if efn_is_capturing(value, ctx) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else {\n        ()\n      }\n    } else if expr_tag(value) == 7 {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if expr_tag(value) == 16 {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else if expr_tag(value) == 9 || expr_tag(value) == 14 {\n      rc_kind = 2\n      Array::push(ctx.heap_binding_names, name)\n    } else {\n      let __sf_tag = expr_tag(value)\n      if is_eident(value) || __sf_tag == 0 || __sf_tag == 1 || __sf_tag == 2 || __sf_tag == 3 || __sf_tag == 22 {\n        ()\n      } else {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      }\n    }\n  } else {\n    ()\n  }\n  (rc_kind, is_borrow_ret_ext)\n}\n\n/// #768 (heap-corruption root cause): a `let` whose value is an if/match and\n/// whose scope-end drop is planned (rc_drop_names) consumes ONE reference per\n/// EXECUTION -- but a branch tail that is a bare loop-borrowed ident (or a\n/// projection off one) is a BORROWED read of a loop-carried binding, and the\n/// static Perceus dup budget cannot cover per-iteration reads (same class as\n/// #706's call-arg case, which dups at consuming call sites). Without a dup the\n/// per-iteration drop eats the loop-carried reference itself: refcount reaches\n/// 0 while the outer structure still points at the block, the free-list reuses\n/// it, and the next allocation aliases live data (use-after-free observed as\n/// the ensure_grouped_source_bucket / loader_manifest_sources_test corruption:\n/// `let bucket = if cached { last } else { ensure(...) }` inside `while`).\n/// This rewrite wraps exactly those branch tails in a codegen-internal\n/// `__loop_tail_retain(x)` marker (compile_call emits value + guarded rc_dup),\n/// so the drop consumes the dup instead. Tails bound INSIDE the branch (fresh\n/// call results like the `ensure(...)` arm) are not loop-borrowed and stay\n/// unwrapped -- no new retention on the owned path. Guarded dup no-ops on\n/// scalars/non-RC values; worst case is the codebase-wide \"leak, never corrupt\"\n/// trade.\nfn retain_wrap_branch_tails(e: Expr, ctx: CompileCtx) -> Expr with { Error } {\n  match e {\n    EIdent(x, p) => if array_contains_str(ctx.loop_borrowed_names, x) && !array_contains_str(ctx.ref_cell_names, x) {\n      ECall(EIdent(\"__loop_tail_retain\", -1), [\n        EIdent(x, p)\n      ], -1)\n    } else {\n      e\n    },\n    EDot(_, _, _, _) => {\n      let root = proj_root_ident(e)\n      if String::length(root) > 0 && array_contains_str(ctx.loop_borrowed_names, root) && !array_contains_str(ctx.ref_cell_names, root) {\n        ECall(EIdent(\"__loop_tail_retain\", -1), [\n          e\n        ], -1)\n      } else {\n        e\n      }\n    },\n    EIf(c, t, el) => EIf(c, retain_wrap_branch_tails(t, ctx), retain_wrap_branch_tails(el, ctx)),\n    EMatch(scrut, arms) => {\n      if Array::length(arms) == 0 {\n        e\n      } else {\n        let out = array_empty()\n        let mut ai = 0\n        while ai < Array::length(arms) {\n          let (apat, abody) = Array::get(arms, ai)\n          Array::push(out, (apat, retain_wrap_branch_tails(abody, ctx)))\n          ai = ai + 1\n        }\n        EMatch(scrut, out)\n      }\n    },\n    ELet(n, v, b, soff) => ELet(n, v, retain_wrap_branch_tails(b, ctx), soff),\n    ELetMut(n, v, b, soff) => ELetMut(n, v, retain_wrap_branch_tails(b, ctx), soff),\n    ESeq(a, b) => ESeq(a, retain_wrap_branch_tails(b, ctx)),\n    EAssign(n, v, b) => EAssign(n, v, retain_wrap_branch_tails(b, ctx)),\n    EAssignOp(o, n, v, b) => EAssignOp(o, n, v, retain_wrap_branch_tails(b, ctx)),\n    _ => e\n  }\n}\n\n/// #768 (companion to retain_wrap_branch_tails): true when an if/match VALUE\n/// has at least one branch tail that is a BORROWED read -- a loop-borrowed /\n/// borrow-bound bare ident, a projection, or a borrow-returning call. A `let`\n/// bound to such a value is itself a (conditional) borrowed view, so it must be\n/// marked borrow-bound for its body scope exactly like #708 marks a direct\n/// `let x = Array::get(..)`: otherwise the borrow is laundered through the\n/// alias chain and a consuming call's #706/#708 arg dup never fires (observed:\n/// build_merged_stmts_inline's `let namespaced_stmts = if entry {\n/// export_renamed } else { namespace(...) }` passed to an owning callee, whose\n/// param drop freed the block `file_stmts` still owned -- the function-exit\n/// recursive drop then double-freed it, shadow-trapped at that exact site).\n/// The owned branch (fresh call result) sees at most an extra guarded dup at\n/// consuming sites -- the codebase-wide \"leak, never corrupt\" trade.\nfn value_has_borrowed_branch_tail(e: Expr, ctx: CompileCtx) -> Bool {\n  match e {\n    EIdent(x, _) => array_contains_str(ctx.loop_borrowed_names, x) && !array_contains_str(ctx.ref_cell_names, x),\n    EDot(_, _, _, _) => true,\n    ECall(callee, _, _) => match callee {\n      EIdent(cn, _) => cn == \"Array::get\" || cn == \"__index\" || cn == \"Map::get\" || cn == \"__rec_field\" || bsearch_leftmost(ctx.borrow_ret_names, cn) >= 0,\n      _ => false\n    },\n    EIf(_, t, el) => value_has_borrowed_branch_tail(t, ctx) || value_has_borrowed_branch_tail(el, ctx),\n    EMatch(_, arms) => {\n      let mut found = false\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, abody) = Array::get(arms, ai)\n        if value_has_borrowed_branch_tail(abody, ctx) {\n          found = true\n          ai = Array::length(arms)\n        } else {\n          ai = ai + 1\n        }\n      }\n      found\n    },\n    ELet(_, _, b, _) => value_has_borrowed_branch_tail(b, ctx),\n    ELetMut(_, _, b, _) => value_has_borrowed_branch_tail(b, ctx),\n    ESeq(_, b) => value_has_borrowed_branch_tail(b, ctx),\n    EAssign(_, _, b) => value_has_borrowed_branch_tail(b, ctx),\n    EAssignOp(_, _, _, b) => value_has_borrowed_branch_tail(b, ctx),\n    _ => false\n  }\n}\n\n/// #768: apply the branch-tail retain rewrite (see retain_wrap_branch_tails)\n/// when this binding's scope-end drop is planned AND we are inside a loop\n/// (loop_borrowed_names non-empty -- empty outside loops and under bump, so\n/// codegen elsewhere is byte-identical). Only if/match values are rewritten;\n/// the top-level node kind is preserved, so classification of the ORIGINAL\n/// `value` below stays valid.\nfn retain_wrap_let_value(value: Expr, name: String, ctx: CompileCtx) -> Expr with { Error } {\n  if ctx.enable_rc && (expr_tag(value) == 7 || expr_tag(value) == 16) && Array::length(ctx.loop_borrowed_names) > 0 && array_contains_str(ctx.rc_drop_names, name) {\n    retain_wrap_branch_tails(value, ctx)\n  } else {\n    value\n  }\n}\n\nexport fn compile_expr_tail(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let __tag = expr_tag(expr)\n  if __tag == 9 {\n    let name = get_elet_name(expr)\n    let value = get_elet_val(expr)\n    let body = get_elet_body(expr)\n    let local_idx = next_local\n    emit_dbg_line_stmt(buf, value, get_elet_off(expr), ctx)\n    // #1120 Codex review (P1): the slot is pushed BEFORE the value compiles\n    // (its index must be reserved), but a NON-RECURSIVE `let` binder is not\n    // in scope inside its own initializer -- `let add = (x, y) -> Int {\n    // add(x, y) }` deliberately means the BUILTIN add. Mask the name for the\n    // duration of the value so nothing resolves to (or, since #1114, treats\n    // as an enclosing shadow and captures) the not-yet-initialized slot; the\n    // INDEX stays allocated, only the name is hidden, and it is restored\n    // before the body compiles. `let rec` keeps its name visible -- that is\n    // what makes self-reference work (see ctx.pending_letrec_self_name).\n    Array::push(local_names, name)\n    Array::set(local_names, local_idx, \"\")\n    let nl = compile_expr(buf, retain_wrap_let_value(value, name, ctx), local_names, next_local + 1, ctx, ld)\n    Array::set(local_names, local_idx, name)\n    emit_local_set(buf, local_idx)\n    let val_is_float = expr_is_floatish(value, local_names, ctx)\n    if val_is_float {\n      Array::push(ctx.float_local_slots, local_idx * 2 + 1)\n    } else if slot_is_floatish(ctx, local_idx) {\n      Array::push(ctx.float_local_slots, local_idx * 2)\n    }\n    // #678: log whether this binding holds a definitely-integral value, so a\n    // later bare-ident `==` on it bypasses the string-pointer-misreading `eq`.\n    // Always (re)log when the slot was previously classified, so a rebind of a\n    // reused slot overrides the earlier entry. #769/#950 encoding: slot*4 +\n    // kind (0 clear / 1 int / 2 string / 3 bool) -- see slot_is_intish.\n    if expr_is_boolish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 3)\n    } else if expr_is_intish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 1)\n    } else if cc_expr_is_stringish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 2)\n    } else if slot_is_intish(ctx, local_idx) || slot_is_stringish(ctx, local_idx) {\n      Array::push(ctx.int_local_slots, local_idx * 4)\n    }\n    // #724: log this binding's AGGREGATE shape (tuple arity / ctor-record\n    // field count) so `a == b` with both sides bound takes the structural\n    // comparators. kind*64+n; 0 overrides a reused slot. See\n    // CompileCtx.agg_local_slots.\n    let agg_entry = if is_etuple(value) {\n      64 + Array::length(get_etuple_elems(value))\n    } else if is_ctor_call(value, ctx.ctor_table) {\n      let cargs = get_ecall_args(value)\n      // `S::{ ... }` sugar arrives as ECall(S, [ERecord]) — the runtime\n      // field count is the record's, not the call arity.\n      let fcnt = if Array::length(cargs) == 1 {\n        match Array::get(cargs, 0) {\n          ERecord(_, rfields, _) => Array::length(rfields),\n          _ => Array::length(cargs)\n        }\n      } else {\n        Array::length(cargs)\n      }\n      128 + fcnt\n    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {\n      128\n    } else if is_erecord(value) {\n      // Records are [tag@0][len@4][fields@8+] since #722, walkable like ctors.\n      match value {\n        ERecord(_, rfields, _) => 128 + Array::length(rfields),\n        _ => 0\n      }\n    } else if expr_tag(value) == 8 {\n      // #724 round 2: `let a = f(..)` — classify by f's DECLARED return type\n      // (agg_ret table). Only for a global fn name (a local shadowing `f`\n      // makes this a closure call of unknown type).\n      match get_ecall_callee(value) {\n        EIdent(cfn, _) => if find_local_slot(local_names, cfn) < 0 {\n          let rinfo = agg_ret_lookup(ctx.agg_ret_names, ctx.agg_ret_infos, cfn)\n          if rinfo > 0 {\n            rinfo\n          } else {\n            0\n          }\n        } else {\n          0\n        },\n        _ => 0\n      }\n    } else if is_eident(value) {\n      // Alias of a tracked binding: propagate its shape.\n      let src_slot = find_local_slot(local_names, get_eident_name(value))\n      if src_slot >= 0 {\n        let src_info = agg_slot_lookup(ctx.agg_local_slots, src_slot)\n        if src_info > 0 {\n          src_info\n        } else {\n          0\n        }\n      } else {\n        0\n      }\n    } else {\n      0\n    }\n    // #672 (post-#724): the shape LITERAL backing `agg_entry`, kept in\n    // lockstep with agg_local_slots (see CompileCtx.agg_local_exprs) so a\n    // both-sides-tracked `a == b` can recurse into NESTED aggregate elements\n    // (e.g. `let a = ((1,2),3)`) instead of only comparing the top-level\n    // shape. An alias propagates its SOURCE's shape expr (not just the\n    // kind+n int); everything else that isn't a literal (call-result via\n    // agg_ret, round-2 param/return tracking) has no literal to recurse\n    // into, so it stores the inert EInt(0) placeholder — those tracked\n    // slots still get correct TOP-level structural comparison (unchanged\n    // from before this change) but nested elements under them keep the\n    // pre-existing generic-eq fallback.\n    let agg_shape_expr = if is_etuple(value) {\n      value\n    } else if is_ctor_call(value, ctx.ctor_table) {\n      value\n    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {\n      value\n    } else if is_erecord(value) {\n      value\n    } else if is_eident(value) {\n      let src_slot = find_local_slot(local_names, get_eident_name(value))\n      if src_slot >= 0 {\n        agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, src_slot)\n      } else {\n        EInt(0)\n      }\n    } else {\n      EInt(0)\n    }\n    Array::push(ctx.agg_local_slots, local_idx * 256 + agg_entry)\n    Array::push(ctx.agg_local_exprs, agg_shape_expr)\n    let (rc_kind, is_borrow_ret_ext) = classify_let_value_heap(buf, value, name, local_idx, local_names, ctx)\n    if ctx.enable_rc && rc_kind > 0 {\n      let mut dbi = 0\n      while dbi < Array::length(ctx.rc_dup_names) {\n        if Array::get(ctx.rc_dup_names, dbi) == name {\n          emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        dbi = dbi + 1\n      }\n    } else {\n      ()\n    }\n    // #712: this `let` may SHADOW an outer loop-borrowed identifier of the same\n    // name (e.g. `while ... { let x = ...; f(x) }` rebinding `x` inside a loop\n    // whose header already loop-borrowed an outer `x`, #706). cc_is_loop_borrowed_ident\n    // (compile_call.vibe) matches by NAME ONLY, so without this an owning call on\n    // the INNER `x` would be mistaken for a reference to the OUTER loop-carried\n    // one -- a spurious rc_dup now, and (via loop_consumed_names) a spurious extra\n    // epilogue rc_drop for a parameter this `let` never touches. Mask every\n    // existing occurrence of `name` out of loop_borrowed_names for exactly the\n    // scope of `body`, then restore the same count after; membership is all\n    // `array_contains_str` ever tests, so compacting out of order is safe.\n    let mut lb_shadow_removed = 0\n    if ctx.enable_rc {\n      let lb_arr = ctx.loop_borrowed_names\n      let lb_n = Array::length(lb_arr)\n      let mut lb_w = 0\n      let mut lb_i = 0\n      while lb_i < lb_n {\n        let e = Array::get(lb_arr, lb_i)\n        if e == name {\n          lb_shadow_removed = lb_shadow_removed + 1\n        } else {\n          Array::set(lb_arr, lb_w, e)\n          lb_w = lb_w + 1\n        }\n        lb_i = lb_i + 1\n      }\n      Array::truncate(lb_arr, lb_w)\n    } else {\n      ()\n    }\n    // #708 follow-up: scope `name` into loop_borrowed_names for exactly the\n    // extent of `body`'s compilation (push before, truncate after), so a bare\n    // later reference to a borrow-bound name gets the same retain-before-\n    // owning-call treatment a loop-carried parameter already gets. Safe to do\n    // even outside a loop (loop_borrowed_names is otherwise empty there, and\n    // this push/truncate pair never leaks past this let's own body).\n    let lb_mark = Array::length(ctx.loop_borrowed_names)\n    // #768: an if/match value with a borrowed branch tail makes this binding a\n    // (conditional) borrowed view too -- mark it borrow-bound for the body\n    // scope so consuming calls dup it (see value_has_borrowed_branch_tail).\n    let value_borrow_like = ctx.enable_rc && (expr_tag(value) == 7 || expr_tag(value) == 16) && value_has_borrowed_branch_tail(value, ctx)\n    if ctx.enable_rc && (is_borrow_ret_ext || value_borrow_like) {\n      Array::push(ctx.loop_borrowed_names, name)\n    } else {\n      ()\n    }\n    // ADR-0092 Phase 1 (drop-guided reuse): when this binding's planned\n    // scope-end drop can move to last use inside a body that is EXACTLY\n    // `match name { ... }`, stage the fusion — allocate a flag local\n    // (0 = not reused on the taken path) and expose (name, flag) to\n    // compile_match via the ctx stacks (push/truncate, loop_borrowed_names\n    // discipline). An arm that consumes the unique block in place sets the\n    // flag; the scope-end drop below is then guarded on it, so every path\n    // still consumes exactly one reference.\n    let reuse_fusion = ctx.enable_rc && rc_kind > 0 && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.rc_drop_names, name) && expr_tag(body) == 16 && is_eident(get_match_scrutinee(body)) && get_eident_name(get_match_scrutinee(body)) == name\n    let reuse_flag_l = if reuse_fusion {\n      Array::push(local_names, \"__reuse_flag\")\n      emit_i64_const(buf, 0)\n      emit_local_set(buf, nl)\n      Array::push(ctx.reuse_scrutinee_names, name)\n      Array::push(ctx.reuse_flag_locals, nl)\n      nl\n    } else {\n      0 - 1\n    }\n    let nl_body = if reuse_fusion {\n      nl + 1\n    } else {\n      nl\n    }\n    let nl2 = compile_expr(buf, body, local_names, nl_body, ctx, ld)\n    if reuse_fusion {\n      Array::truncate(ctx.reuse_scrutinee_names, Array::length(ctx.reuse_scrutinee_names) - 1)\n      Array::truncate(ctx.reuse_flag_locals, Array::length(ctx.reuse_flag_locals) - 1)\n    } else {\n      ()\n    }\n    if ctx.enable_rc && (is_borrow_ret_ext || value_borrow_like) {\n      Array::truncate(ctx.loop_borrowed_names, lb_mark)\n    } else {\n      ()\n    }\n    // #712: restore the shadow-masked occurrences now that `body` (the only\n    // scope where `name` shadows the outer loop-borrowed binding) is compiled.\n    let mut lb_restore_i = 0\n    while lb_restore_i < lb_shadow_removed {\n      Array::push(ctx.loop_borrowed_names, name)\n      lb_restore_i = lb_restore_i + 1\n    }\n    if ctx.enable_rc && rc_kind > 0 && array_contains_str(ctx.rc_drop_names, name) {\n      if reuse_fusion {\n        // ADR-0092: drop only when no arm consumed the block via reuse.\n        emit_local_get(buf, reuse_flag_l)\n        emit_i64_eqz(buf)\n        emit_if_void(buf)\n        emit_local_get(buf, local_idx)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        emit_end(buf)\n        nl2\n      } else if ctx.rc_drop_func_idx >= 0 && scope_tail_proj_root(body) == name {\n        emit_local_set(buf, nl2)\n        emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow)\n        emit_local_get(buf, local_idx)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        emit_local_get(buf, nl2)\n        nl2 + 1\n      } else {\n        if ctx.rc_drop_func_idx >= 0 {\n          // ADR-0092 note: an inline shared-decrement drop fast path was\n          // tried here and at the fn epilogues (PR #1274) -- it measured\n          // FLAT on the selfcompile KPI (the allocator, not drop call\n          // overhead, dominated) while growing every drop site ~5B -> ~70B,\n          // which failed the output-size ratchet (+14% closure_indirect).\n          // Reverted to the plain runtime call; the allocator-side wins\n          // (bounded walk + size bins) carry the measured improvement.\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n        } else if rc_kind == 1 {\n          emit_rc_drop_local(buf, local_idx, false)\n        } else {\n          emit_rc_drop_local(buf, local_idx, true)\n        }\n        nl2\n      }\n    } else {\n      nl2\n    }\n  } else if __tag == 10 {\n    let name = get_eletrec_name(expr)\n    let value = get_eletrec_val(expr)\n    let body = get_eletrec_body(expr)\n    let local_idx = next_local\n    Array::push(local_names, name)\n    // #875 fix 2: hint compile_lambda (the immediate, sole callee that\n    // compiling an EFn value dispatches to) that NAME is this closure's own\n    // let-rec binding, so its capture computation force-includes NAME even if\n    // NAME collides with an unrelated entry in ctx.capture_name_index. Only\n    // set when `value` is actually an EFn (a non-lambda let-rec value, e.g.\n    // `let rec x = some_expr`, has no self-capture concept); compile_lambda\n    // consumes and clears this immediately, so it cannot leak to any other\n    // lambda compiled afterward. See CompileCtx.pending_letrec_self_name.\n    if is_efn(value) {\n      Array::truncate(ctx.pending_letrec_self_name, 0)\n      Array::push(ctx.pending_letrec_self_name, name)\n    } else {\n      ()\n    }\n    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n    emit_local_set(buf, local_idx)\n    if is_efn(value) {\n      let params = get_efn_params(value)\n      let fn_body = get_efn_body(value)\n      let param_names_bp = array_empty()\n      let mut bpi = 0\n      while bpi < Array::length(params) {\n        let (pn, _) = Array::get(params, bpi)\n        Array::push(param_names_bp, pn)\n        bpi = bpi + 1\n      }\n      // #875 fix 2: same force-include as compile_lambda's own capture\n      // computation above -- this is a REDUNDANT recomputation (must match\n      // compile_lambda's `captures` exactly to find the right self_cap_idx\n      // slot), so it needs the same self_name override, passed directly\n      // since `name` is already in scope here (no ctx hint needed at this\n      // call site).\n      // #1114: `local_names` (the enclosing scope) must be passed here too --\n      // this recomputation has to match compile_lambda's `captures` EXACTLY\n      // or self_cap_idx points at the wrong slot.\n      let caps = collect_free_vars_indexed_self(fn_body, param_names_bp, ctx.capture_name_index, name, local_names)\n      let mut self_cap_idx = -1\n      let mut bci = 0\n      while bci < Array::length(caps) {\n        if Array::get(caps, bci) == name {\n          self_cap_idx = bci\n        }\n        bci = bci + 1\n      }\n      if self_cap_idx >= 0 {\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, -4)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, local_idx)\n        emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\n      }\n      0\n    } else {\n      0\n    }\n    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n    nl2\n  } else if __tag == 11 {\n    let name = get_eletmut_name(expr)\n    let value = get_eletmut_val(expr)\n    let body = get_eletmut_body(expr)\n    let local_idx = next_local\n    emit_dbg_line_stmt(buf, value, get_eletmut_off(expr), ctx)\n    Array::push(local_names, name)\n    // #1120 Codex review (P1): same non-recursive-binder masking as ELet\n    // above -- `let mut add = (x, y) -> Int { add(x, y) }` means the BUILTIN\n    // add. Restored right after each branch compiles the value, before the\n    // body (where the binder IS in scope).\n    Array::set(local_names, local_idx, \"\")\n    if expr_is_floatish(value, local_names, ctx) {\n      Array::push(ctx.float_local_slots, local_idx * 2 + 1)\n    } else if slot_is_floatish(ctx, local_idx) {\n      Array::push(ctx.float_local_slots, local_idx * 2)\n    }\n    // #678: track integral mutable bindings too (an Int local stays Int across\n    // reassignments — the checker forbids changing its type), so a bare-ident\n    // `==` on it uses the direct i64 path. #769/#950: slot*4 + kind encoding,\n    // bool tracked as kind 3, string as kind 2 (a mut Bool/String stays that\n    // type across reassignments too).\n    if expr_is_boolish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 3)\n    } else if expr_is_intish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 1)\n    } else if cc_expr_is_stringish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 4 + 2)\n    } else if slot_is_intish(ctx, local_idx) || slot_is_stringish(ctx, local_idx) {\n      Array::push(ctx.int_local_slots, local_idx * 4)\n    }\n    if mut_needs_ref_cell(body, name) {\n      Array::push(ctx.ref_cell_names, name)\n      if ctx.enable_rc && ctx.rc_alloc_func_idx >= 0 && ctx.rc_drop_func_idx >= 0 && expr_is_intish(value, local_names, ctx) {\n        // #699 RC-managed ref cell: a captured `let mut` is heap-boxed for\n        // by-reference sharing; under RC make that box an RC object so it is\n        // reclaimed instead of leaking. Layout [alloc_size@0][rc_count@4 +\n        // class8@7][payload@8]; the cell local holds vptr=block+8 (even) so the\n        // read/write/assign-op sites are byte-identical to the raw-box path. The\n        // capturing closure dups it (compile_lambda.vibe) and drops it via the\n        // class-7 owned-capture recursion (gen_rc_drop_body); the defining scope\n        // drops it inline below. Restricted to intish (scalar) values so the\n        // payload is never a heap object that the body could return (no\n        // use-after-free): class-8 payload-drop then stays a no-op.\n        emit_i64_const(buf, 16)\n        emit_call(buf, ctx.rc_alloc_func_idx)\n        emit_local_set(buf, local_idx)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 16)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store(buf, 2, 4)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 8)\n        emit_i32_store8(buf, 0, 7)\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, 8)\n        emit_i64_add(buf)\n        emit_local_set(buf, local_idx)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n        Array::set(local_names, local_idx, name)\n        emit_i64_store(buf, 3, 0)\n        let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        nl2\n      } else {\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_tee(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 8)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_heap_grow_after_heap_set(buf, ctx)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n        Array::set(local_names, local_idx, name)\n        emit_i64_store(buf, 3, 0)\n        let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n        nl2\n      }\n    } else {\n      // #768: same branch-tail retain rewrite as ELet (see retain_wrap_let_value).\n      let nl = compile_expr(buf, retain_wrap_let_value(value, name, ctx), local_names, next_local + 1, ctx, ld)\n      Array::set(local_names, local_idx, name)\n      emit_local_set(buf, local_idx)\n      // #791: classify AFTER the value is compiled + stored (local_idx now\n      // holds it), matching ELet's ordering -- classify_let_value_heap's\n      // is_edot/is_eident-alias branches emit an immediate guarded dup\n      // against local_idx, which only makes sense once it holds the fresh\n      // value. See classify_let_value_heap's doc comment for why ELetMut\n      // needs the identical (not just overlapping) classification ELet\n      // uses -- this used to be a narrower, hand-duplicated condition list\n      // that repeatedly drifted out of sync with ELet's (the #715/#791 bug\n      // family); sharing one function makes that drift impossible.\n      let (_mut_rc_kind, _mut_is_borrow_ret_ext) = classify_let_value_heap(buf, value, name, local_idx, local_names, ctx)\n      // #715: the ELet path (tag 9) emits every dup the Perceus plan budgeted\n      // for a binding (ctx.rc_dup_names) at its declaration site -- this\n      // ELetMut path never did, while the matching scope-end drop below DID\n      // fire. A `let mut found = None; while .. { match found { .. } }; found`\n      // accumulator (checker_effects.vibe's lookup_fn_effs) gets a planned\n      // dup from the #706 borrow-retention bump (the bare `match found`\n      // borrow) plus a planned scope-end drop; with the dup silently skipped,\n      // the tail-returned Option's only reference was consumed by the return\n      // AND by the drop -- the caller's lifted `__m_scrut_N` scrutinee then\n      // recursively re-dropped the freed block (byte-exact double-free\n      // confirmed by the drop-site-stamped shadow diagnostic: first free at\n      // this branch's scope-end drop, second inside\n      // check_perform_effects_expr_tx). The guarded dup no-ops on scalars, so\n      // over-emission for a scalar-planned name is harmless.\n      if ctx.enable_rc {\n        let mut mdbi = 0\n        while mdbi < Array::length(ctx.rc_dup_names) {\n          if Array::get(ctx.rc_dup_names, mdbi) == name {\n            emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n          } else {\n            ()\n          }\n          mdbi = mdbi + 1\n        }\n      } else {\n        ()\n      }\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n      if ctx.enable_rc && array_contains_str(ctx.heap_binding_names, name) && array_contains_str(ctx.rc_drop_names, name) && ctx.rc_drop_func_idx >= 0 {\n        if scope_tail_proj_root(body) == name {\n          emit_local_set(buf, nl2)\n          emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow)\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n          emit_local_get(buf, nl2)\n          nl2 + 1\n        } else {\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n          nl2\n        }\n      } else {\n        nl2\n      }\n    }\n  } else if __tag == 12 {\n    let name = get_eassign_name(expr)\n    let value = get_eassign_val(expr)\n    let body = get_eassign_body(expr)\n    let idx = resolve_local(local_names, name, \"assign\")\n    if array_contains_str(ctx.ref_cell_names, name) {\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_i64_store(buf, 3, 0)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    } else {\n      let is_heap_mut = ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.heap_binding_names, name)\n      let is_self = assign_value_mentions(value, name)\n      if is_heap_mut && is_self && reassign_self_reusable(value, name) {\n        let old_temp = next_local\n        let scratch = next_local + 1\n        let base = next_local + 2\n        emit_local_get(buf, idx)\n        emit_local_set(buf, old_temp)\n        let elems = get_etuple_elems(value)\n        let mut ei = 0\n        while ei < Array::length(elems) {\n          let elem = Array::get(elems, ei)\n          if (is_eident(elem) && get_eident_name(elem) == name) || (is_edot(elem) && proj_root_ident(elem) == name) {\n            let _ = compile_expr(buf, elem, local_names, base, ctx, ld)\n            emit_local_set(buf, scratch)\n            emit_rc_dup_guarded(buf, scratch, ctx.rc_shadow)\n          } else {\n            ()\n          }\n          ei = ei + 1\n        }\n        let nl = compile_expr(buf, value, local_names, base, ctx, ld)\n        emit_local_set(buf, idx)\n        emit_local_get(buf, old_temp)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        compile_expr(buf, body, local_names, nl, ctx, ld)\n      } else {\n        if is_heap_mut && !is_self {\n          emit_local_get(buf, idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n        } else {\n          ()\n        }\n        let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n        emit_local_set(buf, idx)\n        if is_heap_mut && !is_self && is_edot(value) {\n          emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        // #715/#791: the Perceus plan's dup budget for a `let mut` binding\n        // (ctx.rc_dup_names occurrences) is applied ONCE, to the INITIAL value\n        // at the declaration site -- but the scope-end drop and every\n        // remaining owning use consume the binding's CURRENT value. After a\n        // reassignment, the freshly stored value carries only its own single\n        // reference; without re-applying the budget here, the tail use plus\n        // the scope-end drop over-consume it by exactly the planned dup count\n        // (checker_effects.vibe's lookup_fn_effs: `let mut found = None;\n        // ... found = Some(..) ...; found` -- the returned Some was freed by\n        // the binding's scope-end drop while the caller still held it; the\n        // #706 borrow-retention bump from the bare `match found` is what put\n        // the +1 in the budget). Worst case this over-retains (a leak) when\n        // part of the budget was already spent before the reassign -- the\n        // codebase-wide \"leak/no-op at worst, never corrupt\" trade.\n        //\n        // #791: this budget reapplication was gated on `!is_self`, so a\n        // SELF-referential reassignment (`s = f(s, ...)`, e.g. a loop\n        // accumulator `s = Set::add(s, i)`) never got it -- only the narrow\n        // `reassign_self_reusable` tuple-element branch above has its own\n        // protection, and non-tuple self-reassignment (an ECall RHS, the\n        // common accumulator shape) falls through to this same `else` with\n        // no compensating dup at all. The freshly stored value then carries\n        // only the single reference `f` returned, so the FIRST subsequent\n        // owning use of `s` (which internally drops its param) frees it\n        // prematurely; later uses read/reuse the freed block, corrupting\n        // memory once an intervening allocation reuses it (2+ further uses\n        // needed to observe it -- 1 further use still \"works\" because\n        // nothing has overwritten the freed-but-untouched memory yet).\n        // Reproduced/diagnosed via #791 (examples/set_test.vibe \"multiple\n        // adds\"): `let mut s = Set::new(); while ... { s = Set::add(s, i) };\n        // assert(Set::size(s)==20); assert(Set::contains(s,0));\n        // assert(Set::contains(s,19))` traps under RC1 -- `Set::size`/\n        // `Set::contains` take `s` by projection only (`s.items`), which\n        // Perceus's use-counting doesn't count as an owning use, so both\n        // functions unconditionally drop `s` in their epilogue; the caller\n        // must dup before every non-last such call, exactly like the\n        // `!is_self` case already handles. Applying the same budget here\n        // (mirroring the `!is_self` path) fixes it: at worst an extra dup on\n        // an already-dead reference (a leak, per the trade-off above), never\n        // a missing one.\n        if ctx.enable_rc && is_heap_mut {\n          let mut adbi = 0\n          while adbi < Array::length(ctx.rc_dup_names) {\n            if Array::get(ctx.rc_dup_names, adbi) == name {\n              emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)\n            } else {\n              ()\n            }\n            adbi = adbi + 1\n          }\n        } else {\n          ()\n        }\n        compile_expr(buf, body, local_names, nl, ctx, ld)\n      }\n    }\n  } else if __tag == 13 {\n    let name = get_eassignop_name(expr)\n    let op = get_eassignop_op(expr)\n    let value = get_eassignop_val(expr)\n    let body = get_eassignop_body(expr)\n    let idx = resolve_local(local_names, name, \"assignop\")\n    if array_contains_str(ctx.ref_cell_names, name) {\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 0)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_assignop_op(buf, op)\n      emit_assignop_rc_tag_fix(buf, ctx.enable_rc, op)\n      emit_i64_store(buf, 3, 0)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    } else {\n      emit_local_get(buf, idx)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_assignop_op(buf, op)\n      emit_assignop_rc_tag_fix(buf, ctx.enable_rc, op)\n      emit_local_set(buf, idx)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    }\n  } else if __tag == 14 {\n    let first = get_eseq_first(expr)\n    let second = get_eseq_second(expr)\n    emit_dbg_line_for(buf, first, ctx)\n    let nl = compile_expr(buf, first, local_names, next_local, ctx, ld)\n    emit_drop(buf)\n    compile_expr(buf, second, local_names, nl, ctx, ld)\n  } else {\n    compile_expr_tail2(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

let cli_adapter_source_100 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/compile_expr.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bsearch_leftmost,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  agg_expr_of_ident,\n  agg_info_of_ident,\n  agg_log_reset_above2,\n  cov_emit_branch,\n  ctor_table_index_of,\n  emit_binop_op,\n  emit_box_float,\n  emit_heap_grow_after_heap_set,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_str_ref,\n  emit_unbox_float,\n  expr_tag,\n  float_log_reset_above,\n  func_table_index_of,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  int_log_reset_above,\n  is_ctor_call,\n  is_efn,\n  is_eident,\n  is_erecord,\n  is_etuple,\n  is_nullary_ctor_ident,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_const_lohi,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\nimport ./compile_call.vibe {\n  compile_call\n}\n\nimport ./compile_expr_tail.vibe {\n  compile_expr_tail, expr_is_floatish, expr_is_intish\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\n/// #672: emit structural equality for two tuples (non-rc layout: element i at\n/// ptr+i*8, value = raw pointer). The arity comes from whichever operand is a\n/// tuple literal (the checker guarantees same-arity tuples on both sides).\n/// Evaluates each operand to a pointer in a temp local, then ANDs an element-wise\n/// generic `eq` over all elements. Produces a raw i64 0/1. `compile_expr_fn` is\n/// the main expression compiler, threaded to avoid a forward reference.\nfn emit_tuple_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, num: Int, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let aptr = next_local\n  Array::push(local_names, \"__eqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__eqb\")\n  let nl1 = compile_expr_fn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  // RC tuples are tagged (`value = (block_start+8)|1`) and carry an 8-byte\n  // header (type_id/length) before the fields, unlike the bare `i*8`-packed\n  // non-RC layout — untag and skip the header so field reads land on the\n  // actual elements instead of the header words (previously read as if they\n  // were fields 0/1, making equal-valued tuples at different addresses\n  // compare unequal; this is also why the RC path was disabled entirely\n  // before this fix).\n  if ctx.enable_rc {\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n  } else {\n    ()\n  }\n  emit_local_set(buf, aptr)\n  let nl2 = compile_expr_fn(buf, rhs, local_names, nl1, ctx, ld)\n  if ctx.enable_rc {\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n  } else {\n    ()\n  }\n  emit_local_set(buf, bptr)\n  let field_off = if ctx.enable_rc {\n    8\n  } else {\n    0\n  }\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  emit_i64_const(buf, 1)\n  let mut i = 0\n  while i < num {\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, field_off + i * 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, field_off + i * 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    i = i + 1\n  }\n  nl2\n}\n\n/// #672: structural equality for two enum constructor values (non-rc layout:\n/// value = ptr|1, tag i32 at ptr+0, field i at ptr+8+i*8). One operand is a ctor\n/// literal so the field count `fc` is statically known. Compares the runtime\n/// tags first (different variants => not equal, e.g. `Circle(5) != Point`), then\n/// — when tags match — ANDs an element-wise generic `eq` over the `fc` fields.\n/// Flat ctors (Int/String/Bool fields) are correct; nested-ctor fields fall back\n/// to `eq` (so recursive types stay non-structural — tracked in #672).\nfn emit_ctor_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, fc: Int, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let aptr = next_local\n  Array::push(local_names, \"__ceqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__ceqb\")\n  let nl1 = compile_expr_fn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, aptr)\n  let nl2 = compile_expr_fn(buf, rhs, local_names, nl1, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, bptr)\n  emit_local_get(buf, aptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_local_get(buf, bptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_eq(buf)\n  emit_if_i64(buf)\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  if fc == 63 {\n    // #724 round 2: DYNAMIC field count — fc 63 marks an enum-typed value\n    // whose variant (hence argc) is only known at runtime. Equal tags imply\n    // equal argc, so loop over argc@4 read from the value itself.\n    let res_l = nl2\n    let cnt_l = nl2 + 1\n    let ii_l = nl2 + 2\n    Array::push(local_names, \"__ceq_res\")\n    Array::push(local_names, \"__ceq_cnt\")\n    Array::push(local_names, \"__ceq_i\")\n    emit_i64_const(buf, 1)\n    emit_local_set(buf, res_l)\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i32_load(buf, 2, 4)\n    emit_i64_extend_i32_u(buf)\n    emit_local_set(buf, cnt_l)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, ii_l)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    emit_local_get(buf, ii_l)\n    emit_local_get(buf, cnt_l)\n    emit_i64_ge_s(buf)\n    emit_br_if(buf, 1)\n    emit_local_get(buf, res_l)\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, ii_l)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 8)\n    emit_i32_mul(buf)\n    emit_i32_add(buf)\n    emit_i64_load(buf, 3, 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, ii_l)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 8)\n    emit_i32_mul(buf)\n    emit_i32_add(buf)\n    emit_i64_load(buf, 3, 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    emit_local_set(buf, res_l)\n    emit_local_get(buf, ii_l)\n    emit_i64_const(buf, 1)\n    emit_i64_add(buf)\n    emit_local_set(buf, ii_l)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    emit_local_get(buf, res_l)\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl2 + 3\n  } else {\n    emit_i64_const(buf, 1)\n    let mut i = 0\n    while i < fc {\n      emit_local_get(buf, aptr)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + i * 8)\n      emit_local_get(buf, bptr)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + i * 8)\n      emit_call(buf, eq_fidx)\n      emit_i64_and(buf)\n      i = i + 1\n    }\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl2\n  }\n}\n\n/// #672 (post-#724): true when `e` is a shape AST node the recursive\n/// structural comparator below can walk directly — a tuple literal, a\n/// payload-ctor call, a nullary-ctor ident, or a record literal (records and\n/// ctors share the runtime [tag@0][argc@4][fields@8+] layout since #722).\nfn is_agg_shape(e: Expr, ct: CtorTable) -> Bool {\n  is_etuple(e) || is_ctor_call(e, ct) || is_nullary_ctor_ident(e, ct) || is_erecord(e)\n}\n\n/// #672 (post-#724): the shape literal for a FIELD sub-expression `el` inside\n/// an enclosing tuple/ctor/record shape, resolving one level further than\n/// is_agg_shape alone — `el` may itself be a tracked-variable ident (e.g. the\n/// `a` in `(a, 3)` where `let a = (1, 2)` earlier) rather than a literal\n/// written inline. Returns `el` itself when it is already a literal shape, the\n/// ident's tracked agg_local_exprs shape when it resolves to one, or EInt(0)\n/// (not an aggregate shape — a plain leaf, gated by is_agg_shape at the call\n/// site) otherwise. This is what lets `(a, 3) == (b, 3)` recurse into `a`/`b`'s\n/// OWN tracked nested shape instead of only comparing the outer pair.\nfn resolved_element_shape(el: Expr, ctx: CompileCtx, local_names: Array[String]) -> Expr {\n  if is_agg_shape(el, ctx.ctor_table) {\n    el\n  } else if is_eident(el) {\n    let s = agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, el, local_names)\n    if is_agg_shape(s, ctx.ctor_table) {\n      s\n    } else {\n      EInt(0)\n    }\n  } else {\n    EInt(0)\n  }\n}\n\n/// #672 (post-#724): the field VALUE expressions of a ctor/record shape, in\n/// runtime field order — `Array::length` of the result is the field count.\n/// Mirrors the `S::{ .. }` ECall-sugar unwrap the existing (flat, #724)\n/// cfc computation used, so a defensively-parsed record-sugar ctor call\n/// (single ERecord arg) reports its RECORD's field count/exprs, not the\n/// call's own 1-arg arity.\nfn ctor_shape_field_exprs(shape: Expr, ct: CtorTable) -> Array[Expr] with { Error } {\n  if is_ctor_call(shape, ct) {\n    let cargs = get_ecall_args(shape)\n    if Array::length(cargs) == 1 {\n      match Array::get(cargs, 0) {\n        ERecord(_, rfields, _) => {\n          let out = array_empty()\n          let mut i = 0\n          while i < Array::length(rfields) {\n            let (_, fv) = Array::get(rfields, i)\n            Array::push(out, fv)\n            i = i + 1\n          }\n          out\n        },\n        _ => cargs\n      }\n    } else {\n      cargs\n    }\n  } else {\n    match shape {\n      ERecord(_, rfields, _) => {\n        let out = array_empty()\n        let mut i = 0\n        while i < Array::length(rfields) {\n          let (_, fv) = Array::get(rfields, i)\n          Array::push(out, fv)\n          i = i + 1\n        }\n        out\n      },\n      _ => array_empty()\n    }\n  }\n}\n\n/// #672 (post-#724): RECURSIVE structural equality driven by a shape AST node\n/// (a tuple / ctor / record literal — see is_agg_shape). The two values under\n/// comparison are already evaluated into local slots `asl`/`bsl` (raw i64:\n/// pointer for aggregates, scalar otherwise — the same representation\n/// compile_expr leaves on the stack, whether freshly evaluated or loaded back\n/// out of a parent aggregate's field). Leaves a single i64 0/1 on the stack.\n///\n/// For each field: when the shape says the field is ITSELF an aggregate\n/// (nested tuple/ctor/record), the field's raw i64 is loaded into fresh locals\n/// and this function RECURSES on that field's own shape sub-expression —\n/// fixing the residual #672 gap (nested aggregates compared elementwise via\n/// the type-blind generic `eq`, which pointer-compares two structurally-equal\n/// but distinctly-allocated nested aggregates as unequal). A field whose shape\n/// is not statically an aggregate (scalar, or an opaque call-result / bound\n/// name we cannot see the literal shape of) keeps the old generic-`eq` leaf\n/// comparison — same residual as before, just one level shallower.\nfn emit_eq_shape_slots(buf: Bytes, shape: Expr, asl: Int, bsl: Int, local_names: Array[String], nl0: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  if is_etuple(shape) {\n    let elems = get_etuple_elems(shape)\n    let num = Array::length(elems)\n    let ap = nl0\n    Array::push(local_names, \"__seqta\")\n    let bp = nl0 + 1\n    Array::push(local_names, \"__seqtb\")\n    emit_local_get(buf, asl)\n    if ctx.enable_rc {\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n    } else {\n      ()\n    }\n    emit_local_set(buf, ap)\n    emit_local_get(buf, bsl)\n    if ctx.enable_rc {\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n    } else {\n      ()\n    }\n    emit_local_set(buf, bp)\n    let field_off = if ctx.enable_rc {\n      8\n    } else {\n      0\n    }\n    emit_i64_const(buf, 1)\n    let mut nl = nl0 + 2\n    let mut i = 0\n    while i < num {\n      let el = Array::get(elems, i)\n      let el_shape = resolved_element_shape(el, ctx, local_names)\n      if is_agg_shape(el_shape, ctx.ctor_table) {\n        let na = nl\n        Array::push(local_names, \"__seqea\")\n        let nb = nl + 1\n        Array::push(local_names, \"__seqeb\")\n        emit_local_get(buf, ap)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, field_off + i * 8)\n        emit_local_set(buf, na)\n        emit_local_get(buf, bp)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, field_off + i * 8)\n        emit_local_set(buf, nb)\n        nl = emit_eq_shape_slots(buf, el_shape, na, nb, local_names, nl + 2, ctx, ld, ce)\n        emit_i64_and(buf)\n      } else {\n        emit_local_get(buf, ap)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, field_off + i * 8)\n        emit_local_get(buf, bp)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, field_off + i * 8)\n        emit_call(buf, eq_fidx)\n        emit_i64_and(buf)\n      }\n      i = i + 1\n    }\n    nl\n  } else if is_ctor_call(shape, ctx.ctor_table) || is_nullary_ctor_ident(shape, ctx.ctor_table) || is_erecord(shape) {\n    let field_exprs = ctor_shape_field_exprs(shape, ctx.ctor_table)\n    let fc = Array::length(field_exprs)\n    let ap = nl0\n    Array::push(local_names, \"__seqca\")\n    let bp = nl0 + 1\n    Array::push(local_names, \"__seqcb\")\n    emit_local_get(buf, asl)\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n    emit_local_set(buf, ap)\n    emit_local_get(buf, bsl)\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n    emit_local_set(buf, bp)\n    emit_local_get(buf, ap)\n    emit_i32_wrap_i64(buf)\n    emit_i32_load(buf, 2, 0)\n    emit_local_get(buf, bp)\n    emit_i32_wrap_i64(buf)\n    emit_i32_load(buf, 2, 0)\n    emit_i32_eq(buf)\n    emit_if_i64(buf)\n    emit_i64_const(buf, 1)\n    let mut nl = nl0 + 2\n    let mut i = 0\n    while i < fc {\n      let el = Array::get(field_exprs, i)\n      let el_shape = resolved_element_shape(el, ctx, local_names)\n      if is_agg_shape(el_shape, ctx.ctor_table) {\n        let na = nl\n        Array::push(local_names, \"__seqfa\")\n        let nb = nl + 1\n        Array::push(local_names, \"__seqfb\")\n        emit_local_get(buf, ap)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + i * 8)\n        emit_local_set(buf, na)\n        emit_local_get(buf, bp)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + i * 8)\n        emit_local_set(buf, nb)\n        nl = emit_eq_shape_slots(buf, el_shape, na, nb, local_names, nl + 2, ctx, ld, ce)\n        emit_i64_and(buf)\n      } else {\n        emit_local_get(buf, ap)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + i * 8)\n        emit_local_get(buf, bp)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + i * 8)\n        emit_call(buf, eq_fidx)\n        emit_i64_and(buf)\n      }\n      i = i + 1\n    }\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl\n  } else {\n    // Not a statically-known aggregate shape (scalar leaf, or an opaque\n    // sub-value whose shape this pass cannot see) — the pre-#672-nested\n    // generic-eq comparison, unchanged.\n    emit_local_get(buf, asl)\n    emit_local_get(buf, bsl)\n    emit_call(buf, eq_fidx)\n    nl0\n  }\n}\n\n/// #672 (post-#724): top-level wrapper — evaluate `lhs`/`rhs` (via `ce`, the\n/// main expression compiler) into fresh raw-value locals, then drive the\n/// RECURSIVE structural walk from `shape` (a tuple/ctor/record literal AST —\n/// either operand's literal, or a tracked variable's recorded shape literal,\n/// see CompileCtx.agg_local_exprs). Supersedes the flat emit_tuple_struct_eq /\n/// emit_ctor_struct_eq for every case where an actual shape LITERAL is known\n/// (nested elements now recurse instead of falling back to generic `eq`);\n/// callers fall back to the old flat comparators when only a shallow kind+n\n/// is known (no literal in scope — e.g. a round-2 declared-return-type or\n/// dynamic-argc tracked binding), which is unchanged from before this change.\nfn emit_eq_shape_top(buf: Bytes, shape: Expr, lhs: Expr, rhs: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let aptr = next_local\n  Array::push(local_names, \"__seqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__seqb\")\n  let nl1 = ce(buf, lhs, local_names, next_local + 2, ctx, ld)\n  emit_local_set(buf, aptr)\n  let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)\n  emit_local_set(buf, bptr)\n  emit_eq_shape_slots(buf, shape, aptr, bptr, local_names, nl2, ctx, ld, ce)\n}\n\n/// #672: emit the equality test for `lhs == rhs`, leaving a raw i64 0/1 on the\n/// stack (1 = equal). Routes through the structural comparators when an operand\n/// is a tuple / ctor literal (non-rc), else the generic runtime `eq`. Every `==`\n/// / `!=` codegen site — the general expression form AND the if / `!`-if / while\n/// condition fast-paths — calls this, so structural equality is consistent\n/// across all of them (the post-processing each site applies to the 0/1 result —\n/// `i32_wrap`/`i32_eqz`/rc-shift — is unchanged).\nfn emit_eq_value(buf: Bytes, lhs: Expr, rhs: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  // #724: aggregate shape of a bare-ident operand whose `let` value was a\n  // tuple/ctor/record literal (kind*64+n, or -1) — extends the structural\n  // comparators below to both-sides-bound comparisons.\n  let lhs_agg = agg_info_of_ident(ctx.agg_local_slots, lhs, local_names)\n  let rhs_agg = agg_info_of_ident(ctx.agg_local_slots, rhs, local_names)\n  if is_etuple(lhs) || is_etuple(rhs) {\n    // #672: a tuple LITERAL operand always carries its own shape — always\n    // safe (and correct for nesting) to drive the recursive comparator.\n    let lit = if is_etuple(lhs) {\n      lhs\n    } else {\n      rhs\n    }\n    emit_eq_shape_top(buf, lit, lhs, rhs, local_names, next_local, ctx, ld, ce)\n  } else if lhs_agg / 64 == 1 || rhs_agg / 64 == 1 {\n    // Tracked tuple binding on at least one side; the checker guarantees the\n    // other side is the same tuple type, so its arity matches. #672: when the\n    // tracked slot's recorded shape is an actual tuple LITERAL (agg_local_exprs\n    // — a direct `let a = (..)` or an alias of one), recurse through it so\n    // nested elements compare structurally too; otherwise (no literal in\n    // scope, e.g. a round-2 declared-return-type tuple) fall back to the flat,\n    // depth-1 comparator exactly as before this change.\n    let tshape = if lhs_agg / 64 == 1 {\n      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, lhs, local_names)\n    } else {\n      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, rhs, local_names)\n    }\n    if is_etuple(tshape) {\n      emit_eq_shape_top(buf, tshape, lhs, rhs, local_names, next_local, ctx, ld, ce)\n    } else {\n      let tn = if lhs_agg / 64 == 1 {\n        lhs_agg % 64\n      } else {\n        rhs_agg % 64\n      }\n      emit_tuple_struct_eq(buf, lhs, rhs, tn, local_names, next_local, ctx, ld, ce)\n    }\n  } else if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) || is_ctor_call(rhs, ctx.ctor_table) || is_nullary_ctor_ident(rhs, ctx.ctor_table) {\n    // #672: a payload/nullary ctor LITERAL operand always carries its own\n    // shape — always safe to drive the recursive comparator.\n    let clit = if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) {\n      lhs\n    } else {\n      rhs\n    }\n    emit_eq_shape_top(buf, clit, lhs, rhs, local_names, next_local, ctx, ld, ce)\n  } else if lhs_agg / 64 == 2 || rhs_agg / 64 == 2 {\n    // Tracked ctor/record binding: values carry [tag@0][argc@4][fields@8+],\n    // so the tag-comparing structural walk applies. #672: recurse through the\n    // tracked slot's recorded shape LITERAL when one is on file (a direct\n    // `let`/alias of a ctor/record literal); otherwise (round-2\n    // declared-type or dynamic-argc tracking, no literal in scope) fall back\n    // to the flat, depth-1 comparator exactly as before this change — when\n    // BOTH sides are tracked as DIFFERENT variants the field counts can\n    // differ, so that fallback walks the larger count (the tag comparison\n    // short-circuits unequal variants before any field read).\n    let cshape = if lhs_agg / 64 == 2 {\n      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, lhs, local_names)\n    } else {\n      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, rhs, local_names)\n    }\n    if is_agg_shape(cshape, ctx.ctor_table) {\n      emit_eq_shape_top(buf, cshape, lhs, rhs, local_names, next_local, ctx, ld, ce)\n    } else {\n      let lfc = if lhs_agg / 64 == 2 {\n        lhs_agg % 64\n      } else {\n        0\n      }\n      let rfc = if rhs_agg / 64 == 2 {\n        rhs_agg % 64\n      } else {\n        0\n      }\n      let cfc = if lfc > rfc {\n        lfc\n      } else {\n        rfc\n      }\n      emit_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, ce)\n    }\n  } else if expr_is_intish(lhs, local_names, ctx) || expr_is_intish(rhs, local_names, ctx) {\n    // A definitely-integer comparison: a direct i64.eq is both faster and\n    // CORRECT for the full value range, sidestepping the `eq` builtin's\n    // string-pointer fall-back. The type checker guarantees the other operand\n    // is the same scalar type, so one intish side is enough.\n    let nl1 = ce(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)\n    emit_i64_eq(buf)\n    emit_i64_extend_i32_s(buf)\n    nl2\n  } else {\n    let nl1 = ce(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)\n    let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n    emit_call(buf, eq_fidx)\n    nl2\n  }\n}\n\nexport fn compile_expr(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int) -> Int with { Error } {\n  let __tag = expr_tag(expr)\n  if __tag == 0 {\n    let n = get_eint_value(expr)\n    emit_i64_const(buf, n)\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shl(buf)\n    }\n    next_local\n  } else if __tag == 1 {\n    let b_val = get_ebool_value(expr)\n    emit_i64_const(buf, if b_val {\n      if ctx.enable_rc {\n        2\n      } else {\n        1\n      }\n    } else {\n      0\n    })\n    next_local\n  } else if __tag == 2 {\n    let v = get_efloat_value(expr)\n    let lo = Double::to_i64_bits_lo(v)\n    let hi = Double::to_i64_bits_hi(v)\n    emit_f64_const_lohi(buf, lo, hi)\n    emit_i64_reinterpret_f64(buf)\n    if ctx.enable_rc {\n      Array::push(local_names, \"__fbits\")\n      Array::push(local_names, \"__fbox\")\n      emit_box_float(buf, ctx, next_local, next_local + 1)\n      next_local + 2\n    } else {\n      next_local\n    }\n  } else if __tag == 3 {\n    let s = get_estring_value(expr)\n    let idx = str_table_lookup(ctx.str_table.strs, s)\n    emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\n    next_local\n  } else if __tag == 4 {\n    let name = get_eident_name(expr)\n    let len = Array::length(local_names)\n    let mut __tl_i = len - 1\n    let mut __tl_result = -1\n    while __tl_i >= 0 {\n      if Array::get(local_names, __tl_i) == name {\n        __tl_result = __tl_i\n        __tl_i = -1\n      } else {\n        __tl_i = __tl_i - 1\n      }\n    }\n    let local_idx = __tl_result\n    if local_idx >= 0 {\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 0)\n      } else {\n        emit_local_get(buf, local_idx)\n      }\n      next_local\n    } else {\n      let mut __ci_idx = -1\n      let __ci_len = Array::length(ctx.const_int_names)\n      let mut __ci_j = 0\n      while __ci_j < __ci_len {\n        if Array::get(ctx.const_int_names, __ci_j) == name {\n          __ci_idx = __ci_j\n          __ci_j = __ci_len\n        } else {\n          __ci_j = __ci_j + 1\n        }\n      }\n      if __ci_idx >= 0 {\n        emit_i64_const(buf, Array::get(ctx.const_int_values, __ci_idx))\n        if ctx.enable_rc {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        }\n        next_local\n      } else {\n        let ctor_idx = ctor_table_index_of(ctx.ctor_table, name)\n        if ctor_idx >= 0 {\n          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)\n          let ptr_l = next_local\n          Array::push(local_names, \"__ctor_ptr\")\n          if ctx.enable_rc {\n            emit_i64_const(buf, 16)\n            emit_call(buf, ctx.rc_alloc_func_idx)\n            emit_local_set(buf, ptr_l)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 16)\n            emit_i32_store(buf, 2, 0)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 1)\n            emit_i32_store(buf, 2, 4)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 1)\n            emit_i32_store8(buf, 0, 7)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, tag_c)\n            emit_i32_store(buf, 2, 8)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 0)\n            emit_i32_store(buf, 2, 12)\n            emit_local_get(buf, ptr_l)\n            emit_i64_const(buf, 8)\n            emit_i64_add(buf)\n            emit_i64_const(buf, 1)\n            emit_i64_or(buf)\n            next_local + 1\n          } else {\n            emit_global_get(buf, 0)\n            emit_i64_extend_i32_u(buf)\n            emit_local_set(buf, ptr_l)\n            emit_global_get(buf, 0)\n            emit_i32_const(buf, 8)\n            emit_i32_add(buf)\n            emit_global_set(buf, 0)\n            emit_heap_grow_after_heap_set(buf, ctx)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, tag_c)\n            emit_i32_store(buf, 2, 0)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 0)\n            emit_i32_store(buf, 2, 4)\n            emit_local_get(buf, ptr_l)\n            emit_i64_const(buf, 1)\n            emit_i64_or(buf)\n            next_local + 1\n          }\n        } else {\n          let __tf_result = func_table_index_of(ctx.func_table, name)\n          if __tf_result < 0 {\n            let mut diag = String::concat(\"undefined variable (ident): \", name)\n            diag = String::concat(diag, \" | locals=[\")\n            let mut di = 0\n            while di < len {\n              if di > 0 {\n                diag = String::concat(diag, \",\")\n              }\n              diag = String::concat(diag, Array::get(local_names, di))\n              di = di + 1\n            }\n            diag = String::concat(diag, \"]\")\n            throw(diag)\n          }\n          let fni = __tf_result\n          let fidx = Array::get(ctx.func_table.indices, fni)\n          if bsearch_leftmost(ctx.thunk_names, name) >= 0 {\n            emit_i64_const(buf, 0)\n            emit_call(buf, fidx)\n            next_local\n          } else {\n            let table_slot = fidx - ctx.func_offset\n            Array::push(ctx.table_slots_used, table_slot)\n            emit_i64_const(buf, (table_slot<<2)|2)\n            next_local\n          }\n        }\n      }\n    }\n  } else if __tag == 5 {\n    let op = get_ebinop_op(expr)\n    let lhs = get_ebinop_lhs(expr)\n    let rhs = get_ebinop_rhs(expr)\n    if op == \"&&\" || op == \"||\" {\n      // Short-circuit lowering. The old eager `i64.and`/`i64.or` (still what\n      // emit_binop_op does) evaluated BOTH operands, so `false && inc()` ran\n      // inc()'s side effects. Bool reprs: false = 0 in both lanes, true = 2\n      // (tagged) under RC / 1 otherwise; eqz treats any non-zero as true.\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      if op == \"&&\" {\n        emit_if_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_else(buf)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_end(buf)\n        nl2\n      } else {\n        emit_if_i64(buf)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_else(buf)\n        emit_i64_const(buf, if ctx.enable_rc {\n          2\n        } else {\n          1\n        })\n        emit_end(buf)\n        nl2\n      }\n    } else if op == \"==\" && !(ctx.enable_rc && (expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx))) {\n      // #704: float `==`/`!=` under RC must NOT go through emit_eq_value — under\n      // RC a float is a BOXED heap value, so the generic eq compares box\n      // pointers (always unequal for two distinct boxes), making `0.0 == 0.0`\n      // false. Divert floatish RC `==`/`!=` to the float branch below, which\n      // unboxes and compares values with f64_eq/f64_ne. (Non-RC keeps the raw\n      // i64-bits compare here, so the default path is byte-identical.)\n      let nle = emit_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nle\n    } else if op == \"!=\" && !(ctx.enable_rc && (expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx))) {\n      let nle = emit_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nle\n    } else if expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx) {\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      if ctx.enable_rc {\n        emit_unbox_float(buf)\n      }\n      emit_f64_reinterpret_i64(buf)\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n      if ctx.enable_rc {\n        emit_unbox_float(buf)\n      }\n      emit_f64_reinterpret_i64(buf)\n      if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n        if op == \"+\" {\n          emit_f64_add(buf)\n        } else if op == \"-\" {\n          emit_f64_sub(buf)\n        } else if op == \"*\" {\n          emit_f64_mul(buf)\n        } else {\n          emit_f64_div(buf)\n        }\n        emit_i64_reinterpret_f64(buf)\n        if ctx.enable_rc {\n          Array::push(local_names, \"__fbits\")\n          Array::push(local_names, \"__fbox\")\n          emit_box_float(buf, ctx, nl2, nl2 + 1)\n          nl2 + 2\n        } else {\n          nl2\n        }\n      } else {\n        if op == \"==\" {\n          emit_f64_eq(buf)\n        } else if op == \"!=\" {\n          emit_f64_ne(buf)\n        } else if op == \"<\" {\n          emit_f64_lt(buf)\n        } else if op == \">\" {\n          emit_f64_gt(buf)\n        } else if op == \"<=\" {\n          emit_f64_le(buf)\n        } else if op == \">=\" {\n          emit_f64_ge(buf)\n        } else {\n          throw(String::concat(\"unsupported float binop: \", op))\n        }\n        emit_i64_extend_i32_s(buf)\n        if ctx.enable_rc {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        }\n        nl2\n      }\n    } else if ctx.enable_rc {\n      if op == \"<<\" {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        emit_i64_shl(buf)\n        nl2\n      } else if op == \">>\" {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        emit_i64_shr_s(buf)\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n        nl2\n      } else {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_binop_op(buf, op)\n        if op == \"*\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shr_s(buf)\n        } else if op == \"/\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        } else if op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        } else {\n          ()\n        }\n        nl2\n      }\n    } else {\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n      emit_binop_op(buf, op)\n      nl2\n    }\n  } else if __tag == 6 {\n    let op = get_eunaryop_op(expr)\n    let operand = get_eunaryop_expr(expr)\n    if op == \"-\" {\n      if expr_is_floatish(operand, local_names, ctx) {\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n        // #745: under RC the operand is a BOXED float — unbox before the\n        // f64.neg and rebox the result, exactly like the float binop path.\n        // Without this, `-1.0` negated the box POINTER and the \"float\" that\n        // escaped was garbage bits.\n        if ctx.enable_rc {\n          emit_unbox_float(buf)\n        }\n        emit_f64_reinterpret_i64(buf)\n        emit_f64_neg(buf)\n        emit_i64_reinterpret_f64(buf)\n        if ctx.enable_rc {\n          Array::push(local_names, \"__fbits\")\n          Array::push(local_names, \"__fbox\")\n          emit_box_float(buf, ctx, nl, nl + 1)\n          nl + 2\n        } else {\n          nl\n        }\n      } else {\n        emit_i64_const(buf, 0)\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n        emit_i64_sub(buf)\n        nl\n      }\n    } else if op == \"!\" {\n      let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nl\n    } else {\n      throw(String::concat(\"unsupported unary op: \", op))\n    }\n  } else if __tag == 7 {\n    let cond = get_eif_cond(expr)\n    let then_e = get_eif_then(expr)\n    let else_e = get_eif_else(expr)\n    let cond_tag = expr_tag(cond)\n    let nl1 = if cond_tag == 5 {\n      let cop = get_ebinop_op(cond)\n      if cop == \"==\" || cop == \"!=\" || cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\" {\n        let clhs = get_ebinop_lhs(cond)\n        let crhs = get_ebinop_rhs(cond)\n        if cop == \"==\" && !(ctx.enable_rc && (expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx))) {\n          let cnl2 = emit_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr)\n          emit_i32_wrap_i64(buf)\n          cnl2\n        } else if cop == \"!=\" && !(ctx.enable_rc && (expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx))) {\n          let cnl2 = emit_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr)\n          emit_i32_wrap_i64(buf)\n          emit_i32_eqz(buf)\n          cnl2\n        } else if expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx) {\n          // #704: unbox boxed floats under RC before reinterpreting as f64, and\n          // handle ==/!= here (f64_eq/f64_ne) so float equality in an if/while\n          // condition compares values, not box pointers.\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          if ctx.enable_rc {\n            emit_unbox_float(buf)\n          } else {\n            ()\n          }\n          emit_f64_reinterpret_i64(buf)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          if ctx.enable_rc {\n            emit_unbox_float(buf)\n          } else {\n            ()\n          }\n          emit_f64_reinterpret_i64(buf)\n          if cop == \"==\" {\n            emit_f64_eq(buf)\n          }\n          else if cop == \"!=\" {\n            emit_f64_ne(buf)\n          }\n          else if cop == \"<\" {\n            emit_f64_lt(buf)\n          }\n          else if cop == \">\" {\n            emit_f64_gt(buf)\n          }\n          else if cop == \"<=\" {\n            emit_f64_le(buf)\n          }\n          else {\n            emit_f64_ge(buf)\n          }\n          cnl2\n        } else {\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          if cop == \"<\" {\n            emit_i64_lt_s(buf)\n          }\n          else if cop == \">\" {\n            emit_i64_gt_s(buf)\n          }\n          else if cop == \"<=\" {\n            emit_i64_le_s(buf)\n          }\n          else {\n            emit_i64_ge_s(buf)\n          }\n          cnl2\n        }\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else if cond_tag == 1 {\n      let b_val = get_ebool_value(cond)\n      emit_i32_const(buf, if b_val {\n        1\n      } else {\n        0\n      })\n      next_local\n    } else if cond_tag == 6 {\n      let uop = get_eunaryop_op(cond)\n      let uoperand = get_eunaryop_expr(cond)\n      if uop == \"!\" {\n        let inner_tag = expr_tag(uoperand)\n        if inner_tag == 5 {\n          let iop = get_ebinop_op(uoperand)\n          if iop == \"==\" || iop == \"!=\" || iop == \"<\" || iop == \">\" || iop == \"<=\" || iop == \">=\" {\n            let ilhs = get_ebinop_lhs(uoperand)\n            let irhs = get_ebinop_rhs(uoperand)\n            if iop == \"==\" && !(ctx.enable_rc && (expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx))) {\n              let inl2 = emit_eq_value(buf, ilhs, irhs, local_names, next_local, ctx, ld, compile_expr)\n              emit_i32_wrap_i64(buf)\n              emit_i32_eqz(buf)\n              inl2\n            } else if iop == \"!=\" && !(ctx.enable_rc && (expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx))) {\n              let inl2 = emit_eq_value(buf, ilhs, irhs, local_names, next_local, ctx, ld, compile_expr)\n              emit_i32_wrap_i64(buf)\n              emit_i32_eqz(buf)\n              emit_i32_eqz(buf)\n              inl2\n            } else if expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx) {\n              // #704: unbox boxed floats under RC; handle ==/!= via f64_eq/f64_ne.\n              // This arm is `!(ilhs iop irhs)`, so the trailing eqz negates.\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              if ctx.enable_rc {\n                emit_unbox_float(buf)\n              } else {\n                ()\n              }\n              emit_f64_reinterpret_i64(buf)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              if ctx.enable_rc {\n                emit_unbox_float(buf)\n              } else {\n                ()\n              }\n              emit_f64_reinterpret_i64(buf)\n              if iop == \"==\" {\n                emit_f64_eq(buf)\n              }\n              else if iop == \"!=\" {\n                emit_f64_ne(buf)\n              }\n              else if iop == \"<\" {\n                emit_f64_lt(buf)\n              }\n              else if iop == \">\" {\n                emit_f64_gt(buf)\n              }\n              else if iop == \"<=\" {\n                emit_f64_le(buf)\n              }\n              else {\n                emit_f64_ge(buf)\n              }\n              emit_i32_eqz(buf)\n              inl2\n            } else {\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              if iop == \"<\" {\n                emit_i64_lt_s(buf)\n              }\n              else if iop == \">\" {\n                emit_i64_gt_s(buf)\n              }\n              else if iop == \"<=\" {\n                emit_i64_le_s(buf)\n              }\n              else {\n                emit_i64_ge_s(buf)\n              }\n              emit_i32_eqz(buf)\n              inl2\n            }\n          } else {\n            let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n            emit_i32_wrap_i64(buf)\n            cnl\n          }\n        } else {\n          let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        }\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else {\n      let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n      emit_i32_wrap_i64(buf)\n      cnl\n    }\n    emit_if_i64(buf)\n    let ld_inner = if ld >= 0 {\n      ld + 1\n    } else {\n      -1\n    }\n    let names_len_before = Array::length(local_names)\n    // #cov branch: the then-branch was taken.\n    cov_emit_branch(buf, ctx.cov)\n    let nl2 = compile_expr(buf, then_e, local_names, nl1, ctx, ld_inner)\n    emit_else(buf)\n    Array::truncate(local_names, names_len_before)\n    // #678: the then-branch may have logged integral slots >= names_len_before\n    // that the else-branch is about to reuse; drop them so a non-`let` rebind\n    // there is not misread as int.\n    int_log_reset_above(ctx, names_len_before)\n    agg_log_reset_above2(ctx.agg_local_slots, ctx.agg_local_exprs, names_len_before)\n    // #1062 follow-up: same prune for the float log -- the then-branch may\n    // contain a nested match whose ctor-field bind (bind_match_pat) logged a\n    // slot >= names_len_before as floatish; the else-branch reusing that slot\n    // for a non-float value must not inherit the stale mark.\n    float_log_reset_above(ctx, names_len_before)\n    // #cov branch: the else-branch was taken.\n    cov_emit_branch(buf, ctx.cov)\n    let nl3 = compile_expr(buf, else_e, local_names, nl1, ctx, ld_inner)\n    emit_end(buf)\n    let max_nl_if = if nl2 > nl3 {\n      nl2\n    } else {\n      nl3\n    }\n    while Array::length(local_names) < max_nl_if {\n      Array::push(local_names, \"\")\n    }\n    max_nl_if\n  } else if __tag == 8 {\n    compile_call(buf, get_ecall_callee(expr), get_ecall_args(expr), local_names, next_local, ctx, ld, compile_expr)\n  } else {\n    compile_expr_tail(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

let cli_adapter_source_101 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/compile_module_expr.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Stmt, bytebuf_new, bytebuf_to_bytes, sorted_names_of\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, cov_disabled, linemap_disabled\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_code_section_with_locals, emit_export_section_multi, emit_function_section, emit_header, emit_type_section_multi\n}\n\nimport ./compile_expr.vibe {\n  compile_expr\n}\n\n//# Functions\n\nexport fn compile_module_expr(stmts: Array[Stmt]) -> Bytes with { Error } {\n  let fresh_int_array: () -> Array[Int] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_string_array: () -> Array[String] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_expr_array: () -> Array[Expr] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_bytes_matrix: () -> Array[Bytes] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_string_matrix: () -> Array[Array[String]] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fn_names_list = fresh_string_array()\n  let fn_param_counts = fresh_int_array()\n  let export_names = fresh_string_array()\n  let export_indices = fresh_int_array()\n  let fn_bodies_list = fresh_expr_array()\n  let fn_param_names_list = fresh_string_matrix()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(is_export, _, name, _, expr) => match expr {\n        EFn(_, _, params, _, _, body) => {\n          let cur_idx = Array::length(fn_names_list)\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, Array::length(params))\n          Array::push(fn_bodies_list, body)\n          let pnames = fresh_string_array()\n          let mut pi = 0\n          while pi < Array::length(params) {\n            let (pname, _) = Array::get(params, pi)\n            Array::push(pnames, pname)\n            pi = pi + 1\n          }\n          Array::push(fn_param_names_list, pnames)\n          if is_export {\n            Array::push(export_names, name)\n            Array::push(export_indices, cur_idx)\n          }\n          0\n        },\n        _ => 0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  let num_funcs = Array::length(fn_names_list)\n  if num_funcs == 0 {\n    let out = bytebuf_new()\n    let empty_type_defs = fresh_int_array()\n    let empty_type_indices = fresh_int_array()\n    let empty_body = bytebuf_new()\n    let empty_bodies = fresh_bytes_matrix()\n    Array::push(empty_bodies, empty_body)\n    let empty_local_counts = fresh_int_array()\n    Array::push(empty_local_counts, 0)\n    emit_header(out)\n    emit_type_section_multi(out, empty_type_defs)\n    emit_function_section(out, empty_type_indices)\n    emit_code_section_with_locals(out, empty_bodies, empty_local_counts)\n    bytebuf_to_bytes(out)\n  } else {\n    let fn_indices_list = fresh_int_array()\n    let fn_returns_list = fresh_int_array()\n    let fn_needs_env_list = ArrayBuilder::freeze(ArrayBuilder::new())\n    let mut fi = 0\n    while fi < num_funcs {\n      Array::push(fn_indices_list, fi)\n      Array::push(fn_returns_list, 1)\n      Array::push(fn_needs_env_list, false)\n      fi = fi + 1\n    }\n    let type_defs = fresh_int_array()\n    let mut ti = 0\n    while ti < num_funcs {\n      Array::push(type_defs, Array::get(fn_param_counts, ti))\n      Array::push(type_defs, 1)\n      ti = ti + 1\n    }\n    let type_indices = fresh_int_array()\n    let mut tii = 0\n    while tii < num_funcs {\n      Array::push(type_indices, tii)\n      tii = tii + 1\n    }\n    let lt_m = LambdaTable::{\n      bodies: fresh_bytes_matrix(),\n      param_counts: fresh_int_array(),\n      captures: fresh_string_matrix(),\n      meta_i32: fresh_int_array(),\n      meta_i64: fresh_int_array()\n    }\n    let empty_str_table = StrTable::{\n      strs: fresh_string_array(),\n      offsets: fresh_int_array(),\n      lengths: fresh_int_array()\n    }\n    let empty_ctor_table = CtorTable::{\n      names: fresh_string_array(),\n      tags: fresh_int_array(),\n      field_counts: fresh_int_array(),\n      type_names: fresh_string_array(),\n      struct_names: fresh_string_array(),\n      struct_field_names: fresh_string_matrix(),\n      names_sorted: fresh_string_array(),\n      names_sorted_pos: fresh_int_array()\n    }\n    let empty_thunk_names = fresh_string_array()\n    let empty_const_int_names = fresh_string_array()\n    let empty_const_int_values = fresh_int_array()\n    let empty_rc_drop_names = fresh_string_array()\n    let empty_rc_alias_dup_names = fresh_string_array()\n    let empty_rc_dup_names = fresh_string_array()\n    let bodies = fresh_bytes_matrix()\n    let local_counts = fresh_int_array()\n    // Sorted capture index (see CompileCtx.capture_name_index): built once,\n    // shared by every per-function ctx below.\n    let cni_sorted = sorted_names_of(fn_names_list)\n    let mut bi = 0\n    while bi < num_funcs {\n      let body = Array::get(fn_bodies_list, bi)\n      let param_names = Array::get(fn_param_names_list, bi)\n      let body_buf = bytebuf_new()\n      let local_names = fresh_string_array()\n      let mut pi = 0\n      while pi < Array::length(param_names) {\n        Array::push(local_names, Array::get(param_names, pi))\n        pi = pi + 1\n      }\n      let param_count = Array::length(param_names)\n      let empty_ref_cells = fresh_string_array()\n      let compile_ctx = CompileCtx::{\n        func_table: FuncTable::{\n          names: fn_names_list,\n          indices: fn_indices_list,\n          params: fn_param_counts,\n          returns: fn_returns_list,\n          needs_env: fn_needs_env_list,\n          // #1100: lite path (small module bodies), same as CtorTable above\n          // in this file -- func_table_index_of falls back to a linear scan\n          // when names_sorted's length doesn't match names'.\n          names_sorted: fresh_string_array(),\n          names_sorted_pos: fresh_int_array()\n        },\n        str_table: empty_str_table,\n        lambda_table: lt_m,\n        num_user_funcs: num_funcs, func_offset: 0,\n        ref_cell_names: empty_ref_cells,\n        ctor_table: empty_ctor_table,\n        ctor_float_fields: fresh_int_array(),\n        thunk_names: empty_thunk_names,\n        const_int_names: empty_const_int_names,\n        const_int_values: empty_const_int_values,\n        enable_rc: false,\n        rc_shadow: false,\n        rc_drop_names: empty_rc_drop_names,\n        rc_alias_dup_names: empty_rc_alias_dup_names,\n        heap_binding_names: fresh_string_array(),\n        rc_drop_func_idx: -1,\n        rc_alloc_func_idx: -1,\n        heap_grow_check_func_idx: -1,\n        map_hash_func_idx: -1,\n        map_cap_func_idx: -1,\n        map_build_index_func_idx: -1,\n        map_probe_func_idx: -1,\n        rc_dup_names: empty_rc_dup_names,\n        capture_name_index: cni_sorted,\n        float_local_slots: fresh_int_array(),\n        int_local_slots: fresh_int_array(),\n        agg_local_slots: fresh_int_array(),\n        agg_local_exprs: fresh_expr_array(),\n        agg_ret_names: fresh_string_array(),\n        agg_ret_infos: fresh_int_array(),\n        heap_ret_names: fresh_string_array(),\n        effect_names: fresh_string_array(),\n        effect_op_keys: fresh_string_array(),\n        effect_op_arities: fresh_int_array(),\n        cov: cov_disabled(),\n        dbg_line_idx: -1,\n        dbg_line_nl: fresh_int_array(),\n        dbg_line_file_id: 0,\n        loop_borrowed_names: fresh_string_array(),\n        loop_consumed_names: fresh_string_array(),\n        reuse_scrutinee_names: fresh_string_array(),\n        reuse_flag_locals: fresh_int_array(),\n        borrow_ret_names: fresh_string_array(),\n        borrow_arg0_user: fresh_string_array(),\n        borrow_view_ret: fresh_string_array(),\n        scalar_ret_names: fresh_string_array(),\n        pending_letrec_self_name: fresh_string_array(),\n        table_slots_used: fresh_int_array(),\n        // Empty: this ctx is built outside the planned body loop, so there is\n        // no preassigned lambda range to check against (#1259).\n        lambda_plan_next: fresh_int_array(),\n        linemap: linemap_disabled()\n      }\n      let final_nl = compile_expr(body_buf, body, local_names, param_count, compile_ctx, -1)\n      Array::push(bodies, body_buf)\n      let extra = if final_nl > param_count {\n        final_nl - param_count\n      } else {\n        0\n      }\n      Array::push(local_counts, extra)\n      bi = bi + 1\n    }\n    let out = bytebuf_new()\n    emit_header(out)\n    emit_type_section_multi(out, type_defs)\n    emit_function_section(out, type_indices)\n    if Array::length(export_names) > 0 {\n      emit_export_section_multi(out, export_names, export_indices)\n    }\n    emit_code_section_with_locals(out, bodies, local_counts)\n    bytebuf_to_bytes(out)\n  }\n}\n")
}

