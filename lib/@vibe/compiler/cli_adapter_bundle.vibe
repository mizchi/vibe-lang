"name = @vibe/compiler/codegen/common_extractors\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/codegen/common_extractors — bodyless AST field extractors\ndeps = {\n  @vibe/compiler/codegen/wasm_emit : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/codegen/common_extractors — bodyless AST field extractors\n// (get_e*/get_p* accessors) plus a handful of small string/offset/array\n// helpers shared across codegen (ADR-0070 Phase 3, #897, compiler-internal\n// batch). Compiled into the compiler itself via\n// compiler_sources_manifest.tsv (group `codegen`, dual-row: this contract +\n// common_extractors.vibe).\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package is single-file), so it moved verbatim to common_extractors.vibe.\n// No exported types: every struct/enum this package touches (Expr/Pat/Stmt/\n// TypeExpr from ../../core) is structural signature text resolved against\n// the implementation import when the facade is merged in (normalize/perceus\n// precedent — no re-import needed here). No `version` binding existed\n// (compiler-internal package).\n\nfn first_offset(e: Expr) -> Int\nfn offset_to_line(nl: Array[Int], off: Int) -> Int\nfn build_newline_offsets(src: String) -> Array[Int]\nfn get_ebinop_lhs(expr: Expr) -> Expr with { Error }\nfn get_ebinop_rhs(expr: Expr) -> Expr with { Error }\nfn get_ecall_args(expr: Expr) -> Array[Expr] with { Error }\nfn get_efn_params(expr: Expr) -> Array[(String, Option[TypeExpr])] with { Error }\nfn get_eint_value(expr: Expr) -> Int with { Error }\nfn get_eseq_first(expr: Expr) -> Expr with { Error }\nfn get_match_arms(expr: Expr) -> Array[(Pat, Expr)] with { Error }\nfn get_pbind_name(p: Pat) -> String with { Error }\nfn get_pctor_args(p: Pat) -> Array[Pat] with { Error }\nfn get_pctor_name(p: Pat) -> String with { Error }\nfn get_pint_value(p: Pat) -> Int with { Error }\nfn get_pfloat_value(p: Pat) -> Double with { Error }\nfn get_eassign_val(expr: Expr) -> Expr with { Error }\nfn get_ebool_value(expr: Expr) -> Bool with { Error }\nfn get_eforin_body(expr: Expr) -> Expr with { Error }\nfn get_eforin_iter(expr: Expr) -> Expr with { Error }\nfn get_eforin_name(expr: Expr) -> String with { Error }\nfn get_eforin_index(expr: Expr) -> Option[String] with { Error }\nfn get_eident_name(expr: Expr) -> String with { Error }\nfn get_eletmut_val(expr: Expr) -> Expr with { Error }\nfn get_eletrec_val(expr: Expr) -> Expr with { Error }\nfn get_eseq_second(expr: Expr) -> Expr with { Error }\nfn get_ereturn_expr(expr: Expr) -> Expr with { Error }\nfn get_eunaryop_op(expr: Expr) -> String with { Error }\nfn get_ewhile_body(expr: Expr) -> Expr with { Error }\nfn get_ewhile_cond(expr: Expr) -> Expr with { Error }\nfn get_pbool_value(p: Pat) -> Bool with { Error }\nfn get_ptuple_pats(p: Pat) -> Array[Pat] with { Error }\nfn get_slet_export(stmt: Stmt) -> Bool with { Error }\nfn is_catchall_pat(p: Pat) -> Bool\nfn emit_assignop_op(buf: Bytes, op: String) -> Unit with { Error }\nfn emit_memory_copy(buf: Bytes) -> Unit\nfn emit_memory_fill(buf: Bytes) -> Unit\nfn get_earray_elems(expr: Expr) -> Array[Expr] with { Error }\nfn get_eassign_body(expr: Expr) -> Expr with { Error }\nfn get_eassign_name(expr: Expr) -> String with { Error }\nfn get_eassignop_op(expr: Expr) -> String with { Error }\nfn get_ecall_callee(expr: Expr) -> Expr with { Error }\nfn get_efloat_value(expr: Expr) -> Double with { Error }\nfn get_eletmut_body(expr: Expr) -> Expr with { Error }\nfn get_eletmut_name(expr: Expr) -> String with { Error }\nfn get_eletrec_body(expr: Expr) -> Expr with { Error }\nfn get_eletrec_name(expr: Expr) -> String with { Error }\nfn get_etuple_elems(expr: Expr) -> Array[Expr] with { Error }\nfn str_table_lookup(strs: Array[String], s: String) -> Int with { Error }\nfn find_catchall_idx(arms: Array[(Pat, Expr)]) -> Int\nfn get_eassignop_val(expr: Expr) -> Expr with { Error }\nfn get_estring_value(expr: Expr) -> String with { Error }\nfn get_eunaryop_expr(expr: Expr) -> Expr with { Error }\nfn get_pstring_value(p: Pat) -> String with { Error }\nfn array_contains_str(arr: Array[String], s: String) -> Bool\nfn array_contains_int(arr: Array[Int], v: Int) -> Bool\nfn get_eassignop_body(expr: Expr) -> Expr with { Error }\nfn get_eassignop_name(expr: Expr) -> String with { Error }\nfn get_match_scrutinee(expr: Expr) -> Expr with { Error }\n")
