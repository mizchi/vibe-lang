ytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 4)\n  } else {\n    ()\n  }\n  // `vibe.tcp_read (i64,i64) -> i64` (type 4, like http_response_header).\n  if tcp_read_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"tcp_read\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 4)\n  } else {\n    ()\n  }\n  // `vibe.tcp_write (i64,i64) -> ()` (type 6, like fs_write_file).\n  if tcp_write_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"tcp_write\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 6)\n  } else {\n    ()\n  }\n  // `vibe.tcp_close (i64) -> ()` (type 1, like fs_remove).\n  if tcp_close_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"tcp_close\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // #794: `vibe.http_request (i64,i64,i64,i64) -> i64` — the dedicated type\n  // appended after base/closure/dbg types (http_request_type_idx).\n  if http_request_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"http_request\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, http_request_type_idx)\n  } else {\n    ()\n  }\n  // #794: `vibe.http_response_status (i64) -> i64` (type 3, like fs_exists).\n  if http_response_status_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"http_response_status\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  // #794: `vibe.http_response_header (i64, i64) -> i64` (type 4).\n  if http_response_header_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"http_response_header\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 4)\n  } else