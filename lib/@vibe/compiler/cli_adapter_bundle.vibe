"//# Imports\n\nimport @vibe/compiler/core {\n  Type\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# Functions\n\nfn map_no_params() -> Array[Type] {\n  array_empty()\n}\n\nfn map_one_param(a: Type) -> Array[Type] {\n  let arr = map_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nfn map_two_params(a: Type, b: Type) -> Array[Type] {\n  let arr = map_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nfn map_three_params(a: Type, b: Type, c: Type) -> Array[Type] {\n  let arr = map_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\nfn lookup_map_get(name: String) -> Option[Type] {\n  if name == \"Map::get\" {\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_map_has(name: String) -> Option[Type] {\n  if name == \"map_has\" {\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtBool, None))\n  }\n  else None\n}\n\nfn lookup_map_set(name: String) -> Option[Type] {\n  if name == \"Map::set\" {\n    // Functional update: returns the (new) map, matching the host checker\n    // (src/checker typecheck_call_builtin \"Map::set\"), not Unit.\n    Some(CtFn(map_three_params(CtUnknown, CtString, CtUnknown), CtNamed(\"Map\", [\n      CtString,\n      CtUnknown\n    ]), None))\n  }\n  else None\n}\n\nfn lookup_map_keys(name: String) -> Option[Type] {\n  if name == \"Map::keys\" {\n    Some(CtFn(map_one_param(CtUnknown), CtArray(CtString), None))\n  }\n  else None\n}\n\nfn lookup_map_has_key(name: String) -> Option[Type] {\n  if name == \"Map::has_key\" || name == \"Map::has\" {\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtBool, None))\n  }\n  else None\n}\n\nfn lookup_map_size(name: String) -> Option[Type] {\n  if name == \"Map::size\" {\n    Some(CtFn(map_one_param(CtUnknown), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_map_values(name: String) -> Option[Type] {\n  if name == \"Map::values\" {\n    Some(CtFn(map_one_param(CtUnknown), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nfn lookup_map_delete(name: String) -> Option[Type] {\n  if name == \"Map::delete\" {\n    Some(CtFn(map_two_params(CtUnknown, CtString), CtNamed(\"Map\", [\n      CtString,\n      CtUnknown\n    ]), None))\n  }\n  else None\n}\n\nfn lookup_map_group_c(name: String) -> Option[Type] {\n  match lookup_map_size(name) {\n    Some(t) => Some(t),\n    None => match lookup_map_values(name) {\n      Some(t) => Some(t),\n      None => lookup_map_delete(name)\n    }\n  }\n}\n\nfn lookup_map_group_b(name: String) -> Option[Type] {\n  match lookup_map_has(name) {\n    Some(t) => Some(t),\n    None => match lookup_map_keys(name) {\n      Some(t) => Some(t),\n      None => match lookup_map_has_key(name) {\n        Some(t) => Some(t),\n        None => match lookup_map_set(name) {\n          Some(t) => Some(t),\n          None => lookup_map_group_c(name)\n        }\n      }\n    }\n  }\n}\n\nfn lookup_mapbuilder_new(name: String) -> Option[Type] {\n  if name == \"MapBuilder::new\" {\n    Some(CtFn(map_no_params(), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_mapbuilder_set(name: String) -> Option[Type] {\n  if name == \"MapBuilder::set\" {\n    Some(CtFn(map_three_params(CtUnknown, CtString, CtUnknown), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_mapbuilder_freeze(name: String) -> Option[Type] {\n  if name == \"MapBuilder::freeze\" {\n    Some(CtFn(map_one_param(CtUnknown), CtUnknown, None))\n  }\n  else None\n}\n\nfn lookup_map_group_a(name: String) -> Option[Type] {\n  match lookup_mapbuilder_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_mapbuilder_set(name) {\n      Some(t) => Some(t),\n      None => match lookup_mapbuilder_freeze(name) {\n        Some(t) => Some(t),\n        None => lookup_map_get(name)\n      }\n    }\n  }\n}\n\nexport fn lookup_map(name: String) -> Option[Type] {\n  match lookup_map_group_a(name) {\n    Some(t) => Some(t),\n    None => lookup_map_group_b(name)\n  }\n}\n")
}

