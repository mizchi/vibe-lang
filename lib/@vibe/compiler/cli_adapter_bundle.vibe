mpile_expr_tail6(buf, body, arms, local_names, next_local, ctx, ld, compile_expr)\n    ,\n    EStringInterp(parts) => compile_expr_tail7(buf, parts, local_names, next_local, ctx, ld, compile_expr)\n    ,\n    ELabeledArg(_, _, val) => compile_expr(buf, val, local_names, next_local, ctx, ld)\n    ,\n    _ => throw(\"unsupported expression in codegen: unknown\")\n  }\n}\n")
