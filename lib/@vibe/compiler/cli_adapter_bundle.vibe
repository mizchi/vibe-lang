 emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_l)\n          emit_i64_store(buf, 3, 8 + idx0 * 8)\n          let mut de = 0\n          while de < Array::length(dispatch) {\n            emit_end(buf)\n            de = de + 1\n          }\n          emit_i64_const(buf, 0)\n          nl + 1\n        }\n      }\n    }\n    // #775: FixedArray rides on the linear-memory Array exactly like the gc\n    // backend does (gc/backend_call.vibe's FixedArray::* cases) — these were\n    // registered in builtin_registry with in_linear_table=false, in_gc_table=\n    // true, but (unlike println/map_has/etc, whose linear lane is served by a\n    // real prelude source function) no linear codegen case existed at all, so\n    // any linear-backend caller of FixedArray::make/length/get/set/\n    // unsafe_set/blit fell through to the generic call path, which treated\n    // the qualified name as a local variable and threw \"undefined variable\n    // (local): FixedArray::make @call\" (5 optimizer/zlib test files, #775).\n    // length/get/set/unsafe_set are pure renames onto the existing\n    // Array::length/get/set builtins (identical arity), re-lowered through\n    // `ce` so they get the same RC/perceus treatment as ordinary source.\n    // make/blit are synthesized as source-shaped `let`/`while` ASTs (mirrors\n    // String::to_bytes / Stream::to_string above) rather than hand-emitted\n    // wasm, so the perceus loop-borrow dup logic (EWhile's population of\n    // ctx.loop_borrowed_names, compile_expr_tail2.vibe:287) correctly dups\n    // the repeatedly-pushed `init` value across FixedArray::make's loop\n    // iterations under RC — a hand-emitted raw loop here would silently\n    // double-free `init` on the second push.\n    // #835: Int64Array::make/length/get/set piggyback on the exact same\n    // Array aliasing (Array[Int] already stores the full tagged Int per cell\n    // in both backends, so there is no truncation to work around here the\n    // way the retired MoonBit host needed a dedicated i64-cell object).\n    else if fname == \"FixedArray::length\" || fname == \"Int64Array::length\" {\n      ce(buf, ECall(EIdent(\"Array::length\", -1), args, -1), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"FixedArray::get\" || fname == \"Int64Array::get\" {\n      ce(buf, ECall(EIdent(\"Array::get\", -1), args, -1), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"FixedArray::set\" || fname == \"FixedArray::unsafe_set\" || fname == \"Int64Array::set\" {\n      ce(buf, ECall(EIdent(\"Array::set\", -1), args, -1), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"FixedArray::make\" || fname == \"Int64Array::make\" {\n      let n_expr = Array::get(args, 0)\n      let init_expr = Array::get(args, 1)\n      let loop_body = ESeq(ECall(EIdent(\"Array::push\", -1), [\n        EIdent(\"__fam_arr\", -1),\n        EIdent(\"__fam_init\", -1)\n      ], -1), EAssign(\"__fam_i\", EBinOp(\"+\", EIdent(\"__fam_i\", -1), EInt(1)), EUnit))\n      let synth = ELet(\"__fam_n\", n_expr, ELet(\"__fam_init\", init_expr, ELetMut(\"__fam_arr\", EArray(array_empty()), ELetMut(\"__fam_i\", EInt(0), ESeq(EWhile(EBinOp(\"<\", EIdent(\"__fam_i\", -1), EIdent(\"__fam_n\", -1)), loop_body), EIdent(\"__fam_arr\", -1)), -1), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if fname == \"FixedArray::blit\" {\n      // blit(dst, dst_off, src, src_off, len): element-by-element copy, same\n      // semantics as gc/backend_call.vibe's FixedArray::blit.\n      let dst_expr = Array::get(args, 0)\n      let doff_expr = Array::get(args, 1)\n      let src_expr = Array::get(args, 2)\n      let soff_expr = Array::get(args, 3)\n      let len_expr = Array::get(args, 4)\n      let loop_body = ESeq(ECall(EIdent(\"Array::set\", -1), [\n        EIdent(\"__fb_dst\", -1),\n        EBinOp(\"+\", EIdent(\"__fb_doff\", -1), EIdent(\"__fb_i\", -1)),\n        ECall(EIdent(\"Array::get\", -1), [\n          EIdent(\"__fb_src\", -1),\n          EBinOp(\"+\", EIdent(\"__fb_soff\", -1), EIdent(\"__fb_i\", -1))\n        ], -1)\n      ], -1), EAssign(\"__fb_i\", EBinOp(\"+\", EIdent(\"__fb_i\", -1), EInt(1)), EUnit))\n      let synth = ELet(\"__fb_dst\", dst_expr, ELet(\"__fb_doff\", doff_expr, ELet(\"__fb_src\", src_expr, ELet(\"__fb_soff\", soff_expr, ELet(\"__fb_len\", len_expr, ELetMut(\"__fb_i\", EInt(0), ESeq(EWhile(EBinOp(\"<\", EIdent(\"__fb_i\", -1), EIdent(\"__fb_len\", -1)), loop_body), EUnit), -1), -1), -1), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Bytes::blit\" {\n      // blit(dst, src, start, end): append src[start..end) to dst (half-open\n      // range), matching lib/@vibe/prelude/bytes_test.vibe's expectation and the\n      // gc backend's gen_bytes_blit_body. gc-only in the builtin registry; this\n      // synthesizes the loop for the linear backend (same technique as\n      // FixedArray::make/blit above) so `Bytes::push` handles the buffer growth\n      // and RC bookkeeping instead of hand-emitted wasm.\n      let dst_expr = Array::get(args, 0)\n      let src_expr = Array::get(args, 1)\n      let start_expr = Array::get(args, 2)\n      let end_expr = Array::get(args, 3)\n      let loop_body = ESeq(ECall(EIdent(\"Bytes::push\", -1), [\n        EIdent(\"__bb_dst\", -1),\n        ECall(EIdent(\"Bytes::get\", -1), [\n          EIdent(\"__bb_src\", -1),\n          EIdent(\"__bb_i\", -1)\n        ], -1)\n      ], -1), EAssign(\"__bb_i\", EBinOp(\"+\", EIdent(\"__bb_i\", -1), EInt(1)), EUnit))\n      let synth = ELet(\"__bb_dst\", dst_expr, ELet(\"__bb_src\", src_expr, ELet(\"__bb_start\", start_expr, ELet(\"__bb_end\", end_expr, ELetMut(\"__bb_i\", EIdent(\"__bb_start\", -1), ESeq(EWhile(EBinOp(\"<\", EIdent(\"__bb_i\", -1), EIdent(\"__bb_end\", -1)), loop_body), EUnit), -1), -1), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Bytes::fill\" {\n      // fill(dst, value, count): append `count` copies of `value` to dst.\n      // gc-only in the builtin registry; synthesized for the linear backend\n      // via Bytes::push (same technique as Bytes::blit / FixedArray::make).\n      let dst_expr = Array::get(args, 0)\n      let val_expr = Array::get(args, 1)\n      let count_expr = Array::get(args, 2)\n      let loop_body = ESeq(ECall(EIdent(\"Bytes::push\", -1), [\n        EIdent(\"__bf2_dst\", -1),\n        EIdent(\"__bf2_val\", -1)\n      ], -1), EAssign(\"__bf2_i\", EBinOp(\"+\", EIdent(\"__bf2_i\", -1), EInt(1)), EUnit))\n      let synth = ELet(\"__bf2_dst\", dst_expr, ELet(\"__bf2_val\", val_expr, ELet(\"__bf2_count\", count_expr, ELetMut(\"__bf2_i\", EInt(0), ESeq(EWhile(EBinOp(\"<\", EIdent(\"__bf2_i\", -1), EIdent(\"__bf2_count\", -1)), loop_body), EUnit), -1), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Bytes::new\" && Array::length(args) == 1 {\n      // Bytes::new(n): length-n zero-filled buffer (MoonBit semantics). The\n      // runtime bytes_new takes no operands, so the generic path used to emit\n      // the argument and then call it anyway — the operand stayed stranded on\n      // the value stack and the whole module failed validation at\n      // instantiation time. Synthesize new() + a zero-push loop instead.\n      let n_expr = Array::get(args, 0)\n      let loop_body = ESeq(ECall(EIdent(\"Bytes::push\", -1), [\n        EIdent(\"__bn_b\", -1),\n        EInt(0)\n      ], -1), EAssign(\"__bn_i\", EBinOp(\"+\", EIdent(\"__bn_i\", -1), EInt(1)), EUnit))\n      let synth = ELet(\"__bn_n\", n_expr, ELet(\"__bn_b\", ECall(EIdent(\"Bytes::new\", -1), array_empty(), -1), ELetMut(\"__bn_i\", EInt(0), ESeq(EWhile(EBinOp(\"<\", EIdent(\"__bn_i\", -1), EIdent(\"__bn_n\", -1)), loop_body), EIdent(\"__bn_b\", -1)), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else {\n      // #875: a name that is BOTH a func_table entry (some unrelated\n      // top-level/entry-file function reachable in this merged program) AND a\n      // properly in-scope LOCAL binding (e.g. a nested `let rec NAME = ...`\n      // closure) must resolve to the LOCAL — lexical scoping always wins.\n      // Before this guard, `fn_idx_in_list >= 0` alone gated the direct-call\n      // path below, so a local closure whose bare name happened to collide\n      // with some other reachable function (most commonly the compile\n      // entry file's own top-level helpers, which build_export_rename_plan\n      // deliberately leaves unqualified) was miscompiled into a direct call\n      // to that unrelated function instead of a closure_resolve/call_indirect\n      // to the actual in-scope value — a wasm-validation-time arity mismatch\n      // with no compile-time diagnostic. See #875.\n      if fn_idx_in_list >= 0 && local_idx_hint < 0 {\n        let fidx = Array::get(ctx.func_table.indices, fn_idx_in_list)\n        let has_ret = Array::get(ctx.func_table.returns, fn_idx_in_list)\n        let needs_env = Array::get(ctx.func_table.needs_env, fn_idx_in_list)\n        let mut nl = next_local\n        let mut ci = 0\n        while ci < Array::length(args) {\n          let carg = Array::get(args, ci)\n          nl = ce(buf, carg, local_names, nl, ctx, ld)\n          // Retain a heap projection passed to an OWNING parameter (the callee\n          // drops its params). Skip arg0 of a borrow-arg0 builtin (Array::get /\n          // length / push / set, etc.): it does NOT drop that argument, so a dup\n          // there would never be matched and would leak one reference per call\n          // (#704). Mirrors `is_borrow_arg0_call` in perceus/index.vibe.\n          let borrows_this = ci == 0 && cc_is_borrow_arg0_call(fname)\n          let is_loop_borrow1 = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx) && !borrows_this\n          if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow1) && !borrows_this {\n            // #706 leak follow-up: this dup's matching consume is INSIDE the loop\n            // (the callee drops its own copy each iteration) and never touches\n            // the binding's own slot-held reference, so the function epilogue\n            // must emit one extra compensating drop for it. Log only the\n            // loop-borrow trigger — the projection/borrow-ret-call cases already\n            // have correct accounting via the existing rc_drops mechanism.\n            if is_loop_borrow1 {\n              Array::push(ctx.loop_consumed_names, get_eident_name(carg))\n            } else {\n              ()\n            }\n            Array::push(local_names, \"__argdup\")\n            emit_local_tee(buf, nl)\n            emit_rc_dup_guarded(buf, nl, ctx.rc_shadow)\n            nl = nl + 1\n          } else {\n            ()\n          }\n          ci = ci + 1\n        }\n        if needs_env {\n          emit_i64_const(buf, 0)\n        }\n        emit_call(buf, fidx)\n        if has_ret == 0 {\n          emit_i64_const(buf, 0)\n        }\n        nl\n      } else {\n        let local_idx2 = if local_idx_hint >= 0 {\n          local_idx_hint\n        } else {\n          resolve_local(local_names, fname, \"call\")\n        }\n        let num_args = Array::length(args)\n        let fn_val_local = next_local\n        let slot_local = next_local + 1\n        let env_local = next_local + 2\n        let mut nl = next_local + 3\n        Array::push(local_names, \"__fn_val\")\n        Array::push(local_names, \"__slot\")\n        Array::push(local_names, \"__env\")\n        emit_local_get(buf, local_idx2)\n        emit_local_set(buf, fn_val_local)\n        emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n        let mut ci = 0\n        while ci < num_args {\n          let carg = Array::get(args, ci)\n          nl = ce(buf, carg, local_names, nl, ctx, ld)\n          // #706: a closure consumes its args; dup a loop-borrowed owning arg so\n          // it survives the back-edge (mirrors the direct-call path above).\n          // #708: also retain a projection / borrow-returning-call arg here, same\n          // as the direct-call path (line ~2607) already does -- a closure param\n          // is dropped by the callee's own exit epilogue exactly like a direct\n          // call's owning param, so a bare borrowed view passed through (e.g. the\n          // recursive-descent parser's `parse_recur(tokens, ...)` family calling\n          // through a `let rec`-captured closure value) was double-freed the same\n          // way #704/#706's direct-call cases were, just one call-shape over.\n          let is_loop_borrow2 = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx)\n          if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow2) {\n            // #706 leak follow-up: log so the epilogue compensates (see above).\n            if is_loop_borrow2 {\n              Array::push(ctx.loop_consumed_names, get_eident_name(carg))\n            } else {\n              ()\n            }\n            Array::push(local_names, \"__argdup\")\n            emit_local_tee(buf, nl)\n            emit_rc_dup_guarded(buf, nl, ctx.rc_shadow)\n            nl = nl + 1\n          } else {\n            ()\n          }\n          ci = ci + 1\n        }\n        emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)\n        nl\n      }\n    }\n  } else {\n    let num_args = Array::length(args)\n    let fn_val_local = next_local\n    let slot_local = next_local + 1\n    let env_local = next_local + 2\n    let mut nl = next_local + 3\n    Array::push(local_names, \"__fn_val\")\n    Array::push(local_names, \"__slot\")\n    Array::push(local_names, \"__env\")\n    nl = ce(buf, callee, local_names, nl, ctx, ld)\n    emit_local_set(buf, fn_val_local)\n    emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n    let mut ci = 0\n    while ci < num_args {\n      let carg = Array::get(args, ci)\n      nl = ce(buf, carg, local_names, nl, ctx, ld)\n      // #706: dup a loop-borrowed owning arg passed to a closure call.\n      // #708: also retain a projection / borrow-returning-call arg (see the\n      // matching comment on the other closure-call path above).\n      let is_loop_borrow3 = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx)\n      if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow3) {\n        // #706 leak follow-up: log so the epilogue compensates (see above).\n        if is_loop_borrow3 {\n          Array::push(ctx.loop_consumed_names, get_eident_name(carg))\n        } else {\n          ()\n        }\n        Array::push(local_names, \"__argdup\")\n        emit_local_tee(buf, nl)\n        emit_rc_dup_guarded(buf, nl, ctx.rc_shadow)\n        nl = nl + 1\n      } else {\n        ()\n      }\n      ci = ci + 1\n    }\n    emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)\n    nl\n  }\n}\n")
}

