mit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport @vibe/compiler/codegen/builtin_bodies {\n  gen_str_eq_body, gen_str_lex_diff_body, gen_bytes_append_body, gen_bytes_blit_body, gen_bytes_concat_body, gen_bytes_fill_body, gen_bytes_from_array_body, gen_bytes_get_body, gen_bytes_new_body, gen_bytes_push_body, gen_bytes_set_body, gen_bytes_slice_body, gen_bytes_to_array_body, gen_eq_body, gen_string_contains_body, gen_string_ends_with_body, gen_string_index_of_body, gen_string_join_body, gen_string_last_index_of_body, gen_string_split_body, gen_string_starts_with_body, gen_string_trim_body\n}\n\nimport ./backend_builtins_array_alloc.vibe {\n  gc_gen_arr_concat_body, gc_gen_arr_len_body, gc_gen_arr_new_body, gc_gen_arr_push_all_body, gc_gen_arr_slice_body, gc_gen_arr_truncate_body\n}\n\nimport ./backend_builtins_array_get.vibe {\n  gc_gen_arr_get_body\n}\n\nimport ./backend_builtins_array_push.vibe {\n  gc_gen_arr_push_body\n}\n\nimport ./backend_builtins_array_set.vibe {\n  gc_gen_arr_set_body\n}\n\nimport ./backend_builtins_numeric.vibe {\n  gc_gen_double_to_int_body, gc_gen_identity_body, gc_gen_int_to_double_body, gc_gen_to_string_body\n}\n\nimport ./backend_builtins_print.vibe {\n  gc_gen_print_i64_body, gc_gen_print_str_body\n}\n\nimport ./backend_builtins_string.vibe {\n  gc_gen_str_concat_body, gc_gen_str_eq_body, gc_gen_str_len_body\n}\n\nimport ./backend_builtins_string_extra.vibe {\n  gc_gen_str_char_code_at_body, gc_gen_str_from_char_code_body, gc_gen_str_substring_body\n}\n\nimport ./backend_expr.vibe {\n  compile_expr_gc\n}\n\nimport @vibe/compiler/codegen/wasi {\n  stmts_use_builtin\n}\n\n\n//# Functions\n\n// #805 (ADR-0072): inline wasm (`fn f(..) -> Int = wasm \"...\"`, carried as\n// the parser-internal `%wasm(\"<WAT>\")` marker body) is LINEAR-BACKEND ONLY —\n// the WAT text is written against the linear backend's raw 62-bit tagged i64\n// ABI, which the wasm-gc backend does not share. Reject loudly instead of\n// letting the marker fall through to an opaque unknown-function error.\nfn gc_reject_inline_wasm(stmts: Array[Stmt]) -> Unit with { Error } {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, iw_name, _, iw_expr) => match iw_expr {\n        EFn(_, _, _, _, _, iw_body) => match iw_body {\n          ECall(iw_cal, iw_args, _) => match iw_cal {\n            EIdent(iw_cn, _) => if iw_cn == \"%wasm\" && Array::length(iw_args) == 1 {\n              throw(\"inline wasm fn '\\{iw_name}' (= wasm \\\"...\\\") is linear-backend only; the wasm-gc backend does not support it (#805)\")\n            } else {\n              ()\n            },\n            _ => ()\n          },\n          _ => ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\n// #1015: does this program's own top-level `to_string` (if it has one)\n// structurally match the Show-bounded generic forwarding wrapper\n// `to_string[T: Show](x: T) -> String { __to_string(x) }` -- exactly ONE\n// type param bounded by \"Show\", exactly one param whose annotation IS that\n// type param, and a body that's nothing but `__to_string(<that param>)`?\n//\n// This gates backend_call.vibe's \"to_string\" call-site fast path (bypassing\n// the wrapper call and inlining `__to_string(arg)` directly with the\n// original, statically classifiable argument expression). Code review\n// (#1015) correctly flagged that the gc lane's single-file compile model\n// rules out CROSS-file shadowing (mangled-name matching, as the linear lane\n// does, is unnecessary here) but NOT a SAME-file user function of the same\n// name: `fn to_string(x: Bool) -> String { \"custom\" }` is a real, different\n// function that must keep running when called, not be silently replaced by\n// the Bool/Float formatter. That user function fails this structural check\n// (no type params, a concrete Bool param, a body that isn't a bare\n// `__to_string` forward) and so is correctly left alone; only a body that\n// is ACTUALLY just forwarding to `__to_string` -- which can only ever\n// render the same \"true\"/\"false\"/digits output the fast path itself\n// produces -- passes.\n//\n// MUST be called on `stmts` BEFORE strip_generic_type_params runs (see\n// entry/source_compile/wasi_only/preprocess_strip.vibe): that pass\n// unconditionally zeroes EVERY top-level generic fn's type_params AND\n// bounds arrays (an erasure step, not specific to `to_string`), so by the\n// time compile_wasi_module_gc's own stmts are inspected, `to_string[T:\n// Show]`'s `type_params`/`bounds` are already `[]` and this check would\n// always see 0 type params -- always returning false, permanently\n// disabling the fast path (found via throw()-based instrumentation: the\n// first version of this check ran too late, inside compile_wasi_module_gc,\n// and never once returned true even for the genuine wrapper). Exported so\n// entry/source_compile/gc_only/gc_only.vibe (and the two other real\n// callers of compile_wasi_module_gc -- _cli_gc_entry.vibe,\n// tests/codegen_test_support.vibe, neither of which strip at all) can call\n// it on their own pre-strip `stmts` and pass the result in.\nexport fn gc_to_string_resolves_to_show_wrapper(stmts: Array[Stmt]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  let mut found_value = EUnit\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, tsw_name, _, tsw_value) => if tsw_name == \"to_string\" {\n        found = true\n        found_value = tsw_value\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  if found {\n    gc_efn_is_show_to_string_wrapper(found_value)\n  } else {\n    false\n  }\n}\n\nfn gc_efn_is_show_to_string_wrapper(value: Expr) -> Bool {\n  match value {\n    EFn(tsw_tparams, tsw_bounds, tsw_params, _, _, tsw_body) => if Array::length(tsw_tparams) == 1 && Array::length(tsw_params) == 1 {\n      let tsw_tparam = Array::get(tsw_tparams, 0)\n      let (tsw_pname, tsw_pty) = Array::get(tsw_params, 0)\n      let tsw_ty_matches = match tsw_pty {\n        Some(TyName(tsw_ptn)) => tsw_ptn == tsw_tparam,\n        _ => false\n      }\n      tsw_ty_matches && gc_bounds_has_show(tsw_bounds, tsw_tparam) && gc_body_is_to_string_forward(tsw_body, tsw_pname)\n    } else {\n      false\n    },\n    _ => false\n  }\n}\n\nfn gc_bounds_has_show(bounds: Array[(String, Array[String])], tparam: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(bounds) {\n    let (bname, btraits) = Array::get(bounds, i)\n    if bname == tparam {\n      let mut j = 0\n      while j < Array::length(btraits) {\n        if Array::get(btraits, j) == \"Show\" {\n          found = true\n        } else {\n          ()\n        }\n        j = j + 1\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// Is `body` exactly `__to_string(<pname>)` -- a bare one-arg forward of the\n// wrapper's own sole param to the `__to_string` builtin, nothing else?\nfn gc_body_is_to_string_forward(body: Expr, pname: String) -> Bool {\n  match body {\n    ECall(tsf_callee, tsf_args, _) => match tsf_callee {\n      EIdent(tsf_cn, _) => tsf_cn == \"__to_string\" && Array::length(tsf_args) == 1 && (match Array::get(tsf_args, 0) {\n        EIdent(tsf_an, _) => tsf_an == pname,\n        _ => false\n      }),\n      _ => false\n    },\n    _ => false\n  }\n}\n\nexport fn compile_wasi_module_gc(stmts: Array[Stmt], entry_name: String, gc_to_string_is_wrapper: Bool) -> Bytes with { Error } {\n  // #805: inline-wasm fns are linear-backend only — reject before any work.\n  gc_reject_inline_wasm(stmts)\n  // #1015: `gc_to_string_is_wrapper` is a PARAMETER, not computed here --\n  // see the doc comment on gc_to_string_resolves_to_show_wrapper (which\n  // MUST run before strip_generic_type_params, and this function's own\n  // `stmts` have typically already been stripped by the time callers reach\n  // here).\n  // Top-level `let f = g` function aliases: retarget references to the final\n  // EFn def so calls do not route through a 0-param thunk registration\n  // (invalid wasm for any call arity). See import_alias_rewrite.vibe.\n  rewrite_top_level_fn_alias_refs(stmts)\n  // #tco: see codegen/common_base/self_tail_call.vibe's doc comment (same\n  // rewrite as the linear backend's call site in codegen/wasi/linked_compile.vibe).\n  rewrite_self_tail_calls(stmts)\n  // ADR-0076 Phase 2/3 (#817), 段階導入計画 step 6: same evidence-dict AST\n  // rewrite as the linear backend's call site in\n  // codegen/wasi/linked_compile.vibe -- both passes only ever rewrite\n  // EHandle/perform into ordinary ERecord/EFn/EDot/ECall nodes (a plain\n  // closure-record dict threaded as an extra parameter), never touching\n  // linear-memory pointers/offsets, so the rewritten AST is exactly as\n  // backend-agnostic as any other desugaring here. A handle/perform this\n  // pass cannot prove eligible (row-polymorphic helper, non-tail-resumptive\n  // arm, etc.) is left untouched and still hits backend_expr.vibe's/\n  // backend_call.vibe's existing \"only `with Error`/known builtins\"\n  // fallback exactly as before -- this only shrinks what falls through to\n  // that fallback, it does not change the fallback itself. No-op on\n  // programs with no eligible handle (identical to the linear backend's\n  // unconditional call site), so this is strictly additive for gc codegen.\n  inline_direct_performs(stmts)\n  evidence_dict_pass(stmts, entry_name)\n  let fn_names_list = array_empty()\n  let fn_param_counts = array_empty()\n  let fn_needs_env_list = array_empty()\n  let user_func_stmts = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(_, _, name, _, expr) => match expr {\n        EFn(_, _, params, _, _, _) => {\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, Array::length(params))\n          Array::push(fn_needs_env_list, true)\n          Array::push(user_func_stmts, stmt)\n          0\n        },\n        _ => 0\n      }\n      ,\n      _ => 0\n    }\n    i = i + 1\n  }\n  let ctor_names_list = Array::slice([\n    \"None\",\n    \"Some\"\n  ], 0, 2)\n  let ctor_tags_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_field_counts_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_type_names_list = Array::slice([\n    \"Option\",\n    \"Option\"\n  ], 0, 2)\n  let mut type_index = 1\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, _, variants, _) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields, _, _, _) => {\n        type_index = type_index + 1\n        Array::push(ctor_names_list, sname)\n        Array::push(ctor_tags_list, type_index<<16)\n        Array::push(ctor_field_counts_list, Array::length(sfields))\n        Array::push(ctor_type_names_list, sname)\n        0\n      },\n      // #817 gc-backend follow-up (2026-07-23): mirrors linked_compile.vibe's\n      // own SSuberror case exactly -- a suberror is a single-typed enum\n      // whose constructors produce a throwable value; register its ctors in\n      // the ctor table like an enum's so `KeyInvalid(\"x\")` allocates a\n      // tagged value instead of hitting backend_call.vibe's \"unknown\n      // constructor or function\" error. This case was simply never added\n      // when the gc backend's own ctor-registration loop was written\n      // (SEnum/SStruct only) -- found via gc-backend coverage testing.\n      SSuberror(_, ename, variants) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n  // Sorted ctor-name index (see CtorTable.names_sorted): built once here,\n  // shared by every CtorTable literal below.\n  let (gc_ctor_names_sorted, gc_ctor_names_sorted_pos) = ctor_sorted_index(ctor_names_list)\n  // #538: module-level literal constants (Int / Bool / String). The user-func\n  // walk keeps only EFn lets; scalar lets like `let op_call = 16` previously\n  // vanished and every reference threw \"undefined variable\".\n  let gc_const_names_l = array_empty()\n  let gc_const_kinds_l = array_empty()\n  let gc_const_ivals_l = array_empty()\n  let gc_const_svals_l = array_empty()\n  let gc_global_names_l = array_empty()\n  let gc_global_exprs_l = array_empty()\n  let mut gci = 0\n  while gci < Array::length(stmts) {\n    match Array::get(stmts, gci) {\n      SLet(_, _, cname, _, cval) => match cval {\n        EInt(iv) => {\n          Array::push(gc_const_names_l, cname)\n          Array::push(gc_const_kinds_l, 0)\n          Array::push(gc_const_ivals_l, iv)\n          Array::push(gc_const_svals_l, \"\")\n        },\n        EBool(bv) => {\n          Array::push(gc_const_names_l, cname)\n          Array::push(gc_const_kinds_l, 0)\n          Array::push(gc_const_ivals_l, if bv {\n            1\n          } else {\n            0\n          })\n          Array::push(gc_const_svals_l, \"\")\n        },\n        EString(sv) => {\n          Array::push(gc_const_names_l, cname)\n          Array::push(gc_const_kinds_l, 1)\n          Array::push(gc_const_ivals_l, 0)\n          Array::push(gc_const_svals_l, sv)\n        },\n        EFn(_, _, _, _, _, _) => (),\n        _ => {\n          // Computed module-level value: a mutable i64 global initialized at\n          // the top of _start (B12 port).\n          Array::push(gc_global_names_l, cname)\n          Array::push(gc_global_exprs_l, cval)\n        }\n      },\n      _ => ()\n    }\n    gci = gci + 1\n  }\n  let struct_names = array_empty()\n  let struct_field_names = array_empty()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, sname, sfields, _, _, _) => {\n        Array::push(struct_names, sname)\n        let fnames = array_empty()\n        let mut sfi = 0\n        while sfi < Array::length(sfields) {\n          let (fname, _) = Array::get(sfields, sfi)\n          Array::push(fnames, fname)\n          sfi = sfi + 1\n        }\n        Array::push(struct_field_names, fnames)\n        ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  let num_user_funcs = Array::length(fn_names_list)\n  if num_user_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n  let mut entry_user_idx = -1\n  let mut ei = 0\n  while ei < num_user_funcs {\n    if Array::get(fn_names_list, ei) == entry_name {\n      entry_user_idx = ei\n    }\n    ei = ei + 1\n  }\n  if entry_user_idx < 0 {\n    throw(String::concat(\"entry function not found: \", entry_name))\n  }\n  let str_strs = collect_strings_stmts(stmts)\n  // #538: StringBuilder::freeze joins with \"\" and println appends \"\\n\"; both\n  // must exist in the string table even when the program has no such literal.\n  if !array_contains_str(str_strs, \"\") {\n    Array::push(str_strs, \"\")\n  }\n  if !array_contains_str(str_strs, \"\\n\") {\n    Array::push(str_strs, \"\\n\")\n  }\n  let num_strings = Array::length(str_strs)\n  let data_base = 64\n  let str_offsets = array_empty()\n  let str_lengths = array_empty()\n  let mut str_pos = data_base\n  let mut si = 0\n  while si < num_strings {\n    let s = Array::get(str_strs, si)\n    let slen = String::length(s)\n    Array::push(str_offsets, str_pos)\n    Array::push(str_lengths, slen)\n    str_pos = str_pos + slen\n    si = si + 1\n  }\n  let heap_start = ((str_pos + 7) / 8) * 8\n  let num_generated = 42\n  // #538: host imports (module \"vibe\", tagged-i64 ABI -- the same raw ABI the\n  // linear backend and the node host runner speak). Gated as a GROUP: pure\n  // modules stay import-free (runnable on bare wasmtime); a module touching\n  // any Env::/Fs:: builtin imports all nine at indices 1..9, shifting every\n  // generated-body index by 9 (hbo).\n  let use_host = stmts_use_builtin(stmts, fn_names_list, \"Env::get\") || stmts_use_builtin(stmts, fn_names_list, \"Env::args_len\") || stmts_use_builtin(stmts, fn_names_list, \"Env::args_get\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::read_file\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::exists\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::stat_token\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::write_file\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::write_bytes\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::read_bytes\") || stmts_use_builtin(stmts, fn_names_list, \"Profiler::now_us\")\n  let hbo = if use_host {\n    10\n  } else {\n    0\n  }\n  let func_offset = 1 + hbo + num_generated\n  // #415 B-1: the central registry DRIVES the gc lane's registration too.\n  // (name, params, returns) come from builtin_registry() rows with in_gc =\n  // true; only the gc GENERATED-BODY INDEX is lane-local, resolved by the\n  // match below. Adding a gc builtin = one registry row + one match arm (+\n  // its generated body); param-count and returns live ONLY in the registry.\n  let builtin_defs = array_empty()\n  let gc_registry_rows = builtin_registry()\n  let mut gc_reg_i = 0\n  while gc_reg_i < Array::length(gc_registry_rows) {\n    let (gc_name, gc_params, gc_returns, _, gc_in_gc) = Array::get(gc_registry_rows, gc_reg_i)\n    if gc_in_gc {\n      let gc_body_idx = match gc_name {\n        \"print_int\" => 1,\n        \"print_str\" => 2,\n        \"String::length\" => 3,\n        \"String::equals\" => 4,\n        \"String::concat\" => 5,\n        \"array_new\" => 6,\n        \"Array::length\" => 7,\n        \"Array::get\" => 8,\n        \"Array::push\" => 9,\n        \"Array::set\" => 10,\n        \"Double::to_int\" => 11,\n        \"Int::to_double\" => 12,\n        \"String::char_code_at\" => 13,\n        \"String::from_char_code\" => 14,\n        \"String::substring\" => 15,\n        \"ArrayBuilder::new\" => 6,\n        \"ArrayBuilder::push\" => 9,\n        \"ArrayBuilder::freeze\" => 16,\n        \"Array::slice\" => 38,\n        \"Array::concat\" => 39,\n        \"Array::truncate\" => 40,\n        \"Array::push_all\" => 41,\n        \"str_lex_diff\" => 42,\n        \"eq\" => 29,\n        \"not\" => 6,\n        \"String::join\" => 35,\n        \"String::ends_with\" => 33,\n        \"String::last_index_of\" => 34,\n        \"String::starts_with\" => 32,\n        \"String::contains\" => 31,\n        \"String::index_of\" => 30,\n        \"String::split\" => 36,\n        \"String::trim\" => 37,\n        \"Bytes::new\" => 18,\n        \"Bytes::length\" => 7,\n        \"Bytes::get\" => 19,\n        \"Bytes::set\" => 20,\n        \"Bytes::push\" => 21,\n        \"Bytes::append\" => 22,\n        \"Bytes::concat\" => 23,\n        \"Bytes::slice\" => 24,\n        \"Bytes::from_array\" => 25,\n        \"Bytes::to_array\" => 26,\n        \"Bytes::blit\" => 27,\n        \"Bytes::fill\" => 28,\n        \"Double::to_i64_bits\" => 16,\n        \"Double::from_i64_bits\" => 16,\n        // #538 P4.5: identity wraps the trait-dict desugar emits around float\n        // `==` operands (and int->float widening); all no-ops in the raw-bits\n        // i64 world, same as the linear lane's compile_call identity handling.\n        \"Double::to_float\" => 16,\n        \"Float::to_double\" => 16,\n        \"Char::to_int\" => 16,\n        \"Char::from_int\" => 16,\n        \"Int::to_float\" => 12,\n        \"FixedArray::make\" => 6,\n        \"FixedArray::length\" => 6,\n        \"FixedArray::get\" => 6,\n        \"FixedArray::set\" => 6,\n        \"FixedArray::unsafe_set\" => 6,\n        \"FixedArray::blit\" => 6,\n        \"Int64Array::make\" => 6,\n        \"Int64Array::length\" => 6,\n        \"Int64Array::get\" => 6,\n        \"Int64Array::set\" => 6,\n        \"StringBuilder::new\" => 6,\n        \"StringBuilder::push\" => 6,\n        \"StringBuilder::freeze\" => 6,\n        \"Map::get\" => 6,\n        \"Map::keys\" => 6,\n        \"MapBuilder::new\" => 6,\n        \"MapBuilder::set\" => 6,\n        \"MapBuilder::freeze\" => 6,\n        \"__to_string\" => 17,\n        \"assert\" => 6,\n        \"assert_true\" => 6,\n        \"assert_eq\" => 6,\n        \"println\" => 6,\n        \"print\" => 6,\n        \"map_has\" => 6,\n        _ => 0 - 1\n      }\n      if gc_body_idx < 0 {\n        throw(\"builtin registry drift: no gc body-index mapping for builtin '\\{gc_name}' (add a match arm in backend_body.vibe, #415)\")\n      } else {\n        ()\n      }\n      Array::push(builtin_defs, (gc_name, gc_params, gc_body_idx, gc_returns))\n    } else {\n      ()\n    }\n    gc_reg_i = gc_reg_i + 1\n  }\n  // #415 B-0: builtin_defs must agree with the central registry (name set +\n  // params + returns, both directions). The table is static, so this is a\n  // full bidirectional check — a builtin added to the linear lane without an\n  // explicit gc decision (or vice versa) fails every gc build by name.\n  let __reg_names = array_empty()\n  let __reg_params = array_empty()\n  let __reg_returns = array_empty()\n  let mut __ri = 0\n  while __ri < Array::length(builtin_defs) {\n    let (rbname, rbparams, _, rbreturns) = Array::get(builtin_defs, __ri)\n    Array::push(__reg_names, rbname)\n    Array::push(__reg_params, rbparams)\n    Array::push(__reg_returns, rbreturns)\n    __ri = __ri + 1\n  }\n  verify_lane_builtins(\"gc\", __reg_names, __reg_params, __reg_returns)\n  let mut __bi = 0\n  while __bi < Array::length(builtin_defs) {\n    let (bname, bparams, _, _) = Array::get(builtin_defs, __bi)\n    Array::push(fn_names_list, bname)\n    Array::push(fn_param_counts, bparams)\n    Array::push(fn_needs_env_list, false)\n    __bi = __bi + 1\n  }\n  let fn_indices_list = array_empty()\n  let fn_returns_list = array_empty()\n  let mut fi = 0\n  while fi < num_user_funcs {\n    Array::push(fn_indices_list, fi + func_offset)\n    Array::push(fn_returns_list, 1)\n    fi = fi + 1\n  }\n  let mut __bi2 = 0\n  while __bi2 < Array::length(builtin_defs) {\n    let (_, _, bwasm_idx, breturns) = Array::get(builtin_defs, __bi2)\n    Array::push(fn_indices_list, bwasm_idx + hbo)\n    Array::push(fn_returns_list, breturns)\n    __bi2 = __bi2 + 1\n  }\n  // #538: host-import builtins at absolute import indices 1..9.\n  if use_host {\n    let host_defs = [\n      (\"Env::get\", 1, 1, 1),\n      (\"Env::args_len\", 0, 2, 1),\n      (\"Env::args_get\", 1, 3, 1),\n      (\"Fs::read_file\", 1, 4, 1),\n      (\"Fs::exists\", 1, 5, 1),\n      (\"Fs::stat_token\", 1, 6, 1),\n      (\"Fs::write_file\", 2, 7, 0),\n      (\"Fs::write_bytes\", 2, 8, 0),\n      (\"Fs::read_bytes\", 1, 9, 1),\n      (\"Profiler::now_us\", 0, 10, 1)\n    ]\n    let mut __hd = 0\n    while __hd < Array::length(host_defs) {\n      let (hname, hparams, hidx, hret) = Array::get(host_defs, __hd)\n      Array::push(fn_names_list, hname)\n      Array::push(fn_param_counts, hparams)\n      Array::push(fn_needs_env_list, false)\n      Array::push(fn_indices_list, hidx)\n      Array::push(fn_returns_list, hret)\n      __hd = __hd + 1\n    }\n  } else {\n    ()\n  }\n  let ft_names = array_empty()\n  let ft_indices = array_empty()\n  // #724 round 2: (fn name -> declared aggregate return shape) table for\n  // `let a = f(..)` structural `==` (see compute_agg_returning).\n  let gc_agg_ret_names_l = array_empty()\n  let gc_agg_ret_infos_l = array_empty()\n  compute_agg_returning(stmts, CtorTable::{\n    names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: gc_ctor_names_sorted, names_sorted_pos: gc_ctor_names_sorted_pos\n  }, gc_agg_ret_names_l, gc_agg_ret_infos_l)\n  let ft_params = array_empty()\n  let ft_returns = array_empty()\n  let ft_needs_env = array_empty()\n  let mut ft_copy_i = 0\n  while ft_copy_i < Array::length(fn_names_list) {\n    Array::push(ft_names, Array::get(fn_names_list, ft_copy_i))\n    Array::push(ft_indices, Array::get(fn_indices_list, ft_copy_i))\n    Array::push(ft_params, Array::get(fn_param_counts, ft_copy_i))\n    Array::push(ft_returns, Array::get(fn_returns_list, ft_copy_i))\n    Array::push(ft_needs_env, Array::get(fn_needs_env_list, ft_copy_i))\n    ft_copy_i = ft_copy_i + 1\n  }\n  let refcell_type_idx = 10\n  let closure_type_base = 11\n  let fresh_bytes_array: () -> Array[Bytes] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let lt_w = LambdaTable::{\n    bodies: fresh_bytes_array(),\n    param_counts: array_empty(),\n    captures: array_empty(),\n    meta_i32: array_empty(),\n    meta_i64: array_empty()\n  }\n  let bodies = fresh_bytes_array()\n  let meta_i32 = array_empty()\n  let meta_i64 = array_empty()\n  let user_ref_local_indices_all = array_empty()\n  // #415 B-1: one call = one gc builtin body — body bytes, extra local\n  // counts, the (always empty here) user-ref locals row, and the\n  // function-section type index together. The function section splices\n  // gc_builtin_type_idxs in this same order; the count mismatch guard below\n  // still applies.\n  let gc_builtin_type_idxs = array_empty()\n  let push_gc_builtin: (Bytes, Int, Int, Int) -> Unit = (body, m32, m64, type_idx) -> {\n    Array::push(bodies, body)\n    Array::push(meta_i32, m32)\n    Array::push(meta_i64, m64)\n    Array::push(user_ref_local_indices_all, array_empty())\n    Array::push(gc_builtin_type_idxs, type_idx)\n  }\n  push_gc_builtin(gc_gen_print_i64_body(), 3, 1, 1)\n  push_gc_builtin(gc_gen_print_str_body(), 2, 0, 1)\n  push_gc_builtin(gc_gen_str_len_body(), 0, 0, 3)\n  // #748: strings live in linear memory with the same packed layout in the\n  // gc lane, so the SIMD chunk-compare generator is shared verbatim\n  // (chunk_limit local -> meta_i32 6).\n  push_gc_builtin(gen_str_eq_body(), 6, 0, 4)\n  push_gc_builtin(gc_gen_str_concat_body(), 6, 0, 4)\n  push_gc_builtin(gc_gen_arr_new_body(), 1, 0, 5)\n  push_gc_builtin(gc_gen_arr_len_body(), 0, 0, 3)\n  push_gc_builtin(gc_gen_arr_get_body(), 1, 0, 4)\n  push_gc_builtin(gc_gen_arr_push_body(), 6, 0, 6)\n  push_gc_builtin(gc_gen_arr_set_body(), 1, 0, 7)\n  push_gc_builtin(gc_gen_double_to_int_body(), 0, 0, 3)\n  push_gc_builtin(gc_gen_int_to_double_body(), 0, 0, 3)\n  push_gc_builtin(gc_gen_str_char_code_at_body(), 1, 0, 4)\n  push_gc_builtin(gc_gen_str_from_char_code_body(), 1, 0, 3)\n  push_gc_builtin(gc_gen_str_substring_body(), 2, 0, 8)\n  push_gc_builtin(gc_gen_identity_body(), 0, 0, 3)\n  // Body 17 (__to_string): runtime string-vs-int dispatch, NOT identity —\n  // interpolation routes every `\\{x}` here (see gc_gen_to_string_body).\n  push_gc_builtin(gc_gen_to_string_body(), 0, 5, 3)\n  push_gc_builtin(gen_bytes_new_body(), 1, 0, 5)\n  push_gc_builtin(gen_bytes_get_body(false), 1, 0, 4)\n  push_gc_builtin(gen_bytes_set_body(false), 1, 0, 7)\n  push_gc_builtin(gen_bytes_push_body(false), 6, 0, 6)\n  push_gc_builtin(gen_bytes_append_body(false, hbo + 7, hbo + 19, hbo + 21), 2, 0, 6)\n  push_gc_builtin(gen_bytes_concat_body(hbo + 18, hbo + 22), 0, 1, 4)\n  push_gc_builtin(gen_bytes_slice_body(false, hbo + 18, hbo + 19, hbo + 21), 2, 1, 8)\n  push_gc_builtin(gen_bytes_from_array_body(false, hbo + 7, hbo + 8, hbo + 18, hbo + 21), 2, 1, 3)\n  push_gc_builtin(gen_bytes_to_array_body(false, hbo + 6, hbo + 9, hbo + 7, hbo + 19), 2, 1, 3)\n  push_gc_builtin(gen_bytes_blit_body(false, hbo + 19, hbo + 21), 2, 0, 9)\n  push_gc_builtin(gen_bytes_fill_body(false, hbo + 21), 2, 0, 7)\n  // #538: generic eq (i64 fast path + looks-like-string guarded content eq)\n  // -- Map::get/has_key/MapBuilder::set resolve \"eq\" from the func table, and\n  // before this existed the placeholder index called array_new, which returns\n  // a fresh non-zero pointer: every key comparison was TRUE (silent wrong Map\n  // results). The gc string repr is the same packed (offset<<32)|len as the\n  // linear backend, so the linear bodies are reused verbatim below.\n  push_gc_builtin(gen_eq_body(hbo + 4), 0, 0, 4)\n  push_gc_builtin(gen_string_index_of_body(false, hbo + 3, hbo + 15, hbo + 4), 8, 0, 4)\n  push_gc_builtin(gen_string_contains_body(false, hbo + 30), 0, 0, 4)\n  push_gc_builtin(gen_string_starts_with_body(false, hbo + 3, hbo + 15, hbo + 4), 2, 1, 4)\n  push_gc_builtin(gen_string_ends_with_body(false, hbo + 3, hbo + 15, hbo + 4), 2, 1, 4)\n  push_gc_builtin(gen_string_last_index_of_body(false, hbo + 3, hbo + 15, hbo + 4), 3, 1, 4)\n  push_gc_builtin(gen_string_join_body(false, hbo + 7, hbo + 8, hbo + 5), 9, 1, 4)\n  push_gc_builtin(gen_string_split_body(false, hbo + 6, hbo + 9, hbo + 3, hbo + 15, hbo + 30), 4, 1, 4)\n  push_gc_builtin(gen_string_trim_body(false, hbo + 3, hbo + 13, hbo + 15), 4, 0, 3)\n  push_gc_builtin(gc_gen_arr_slice_body(hbo + 6, hbo + 8, hbo + 9), 0, 2, 8)\n  push_gc_builtin(gc_gen_arr_concat_body(hbo + 6, hbo + 7, hbo + 8, hbo + 9), 0, 3, 4)\n  push_gc_builtin(gc_gen_arr_truncate_body(), 0, 0, 6)\n  push_gc_builtin(gc_gen_arr_push_all_body(hbo + 7, hbo + 8, hbo + 9), 0, 2, 6)\n  // #746: same packed-string layout as the linear lane, generator shared\n  // verbatim (untagged ints in the gc lane -> enable_rc=false).\n  push_gc_builtin(gen_str_lex_diff_body(false), 7, 0, 4)\n  let mut bi = 0\n  while bi < num_user_funcs {\n    let stmt = Array::get(user_func_stmts, bi)\n    match stmt {\n      SLet(_, _, _, gc_fn_ann, expr) => match expr {\n        EFn(_, _, params, _, _, body) => {\n          let body_buf = bytebuf_new()\n          let local_names = array_empty()\n          let gc_agg_slots_f = array_empty()\n          let mut ppi = 0\n          while ppi < Array::length(params) {\n            let (pname, _) = Array::get(params, ppi)\n            Array::push(local_names, pname)\n            ppi = ppi + 1\n          }\n          Array::push(local_names, \"__env\")\n          let param_count = Array::length(params) + 1\n          // #724 round 2: seed the aggregate-shape log from annotated params.\n          // #744 gc mirror: seed float tracking from annotated Float/Double\n          // params in the same walk (linear tracks these via float_local_slots).\n          // #1015 gc mirror: seed bool tracking from annotated Bool params in\n          // the same walk (linear tracks these via int_local_slots kind 3) --\n          // without this a Bool-typed top-level fn param passed to\n          // `to_string(b)` is an untracked bare EIdent and mis-renders `true`\n          // as `\"1\"` through the generic runtime dispatch (Bool and Int share\n          // the same gc-lane numeric representation, no distinguishing tag).\n          // #1032: gc_float_slots_f/gc_bool_slots_f are both tracked by SLOT\n          // INDEX (not name) -- `psi` IS the param's slot in local_names\n          // (params are pushed there in order starting at 0, just above this\n          // loop).\n          let gc_float_slots_f = array_empty()\n          let gc_bool_slots_f = array_empty()\n          let gc_sig_ptypes = fn_type_param_types(gc_fn_ann)\n          let mut psi = 0\n          while psi < Array::length(params) {\n            let pann = match gc_sig_ptypes {\n              Some(pts) => if Array::length(pts) == Array::length(params) {\n                Some(Array::get(pts, psi))\n              } else {\n                let (_, pa) = Array::get(params, psi)\n                pa\n              },\n              None => {\n                let (_, pa) = Array::get(params, psi)\n                pa\n              }\n            }\n            match pann {\n              Some(pte) => {\n                let pinfo = agg_info_of_type_expr(CtorTable::{\n                  names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: gc_ctor_names_sorted, names_sorted_pos: gc_ctor_names_sorted_pos\n                }, pte)\n                if pinfo > 0 {\n                  Array::push(gc_agg_slots_f, psi * 256 + pinfo)\n                } else {\n                  ()\n                }\n                match pte {\n                  TyName(ptn) => if ptn == \"Float\" || ptn == \"Double\" {\n                    Array::push(gc_float_slots_f, psi)\n                  } else if ptn == \"Bool\" {\n                    Array::push(gc_bool_slots_f, psi)\n                  } else {\n                    ()\n                  },\n                  _ => ()\n                }\n              },\n              None => ()\n            }\n            psi = psi + 1\n          }\n          let ref_cell_names_f = array_empty()\n          let ref_local_indices_f = array_empty()\n          let ft = FuncTable::{\n            names: ft_names,\n            indices: ft_indices,\n            params: ft_params,\n            returns: ft_returns,\n            needs_env: ft_needs_env\n          }\n          let st = StrTable::{\n            strs: str_strs, offsets: str_offsets, lengths: str_lengths\n          }\n          let ct = CtorTable::{\n            names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: gc_ctor_names_sorted, names_sorted_pos: gc_ctor_names_sorted_pos\n          }\n          let func_ctx = CompileCtxGc::{\n            func_table: ft, str_table: st, lambda_table: lt_w,\n            num_user_funcs: num_user_funcs, func_offset: func_offset,\n            ref_cell_names: ref_cell_names_f, ref_local_indices: ref_local_indices_f,\n            refcell_type_idx: refcell_type_idx, closure_type_base: closure_type_base,\n            gc_ctor_table: ct,\n            gc_const_names: gc_const_names_l, gc_const_kinds: gc_const_kinds_l,\n            gc_const_ivals: gc_const_ivals_l, gc_const_svals: gc_const_svals_l,\n            gc_global_names: gc_global_names_l,\n            gc_float_locals: gc_float_slots_f,\n            gc_bool_locals: gc_bool_slots_f,\n            gc_to_string_is_show_wrapper: gc_to_string_is_wrapper,\n            gc_agg_local_slots: gc_agg_slots_f,\n            gc_agg_ret_names: gc_agg_ret_names_l,\n            gc_agg_ret_infos: gc_agg_ret_infos_l\n          }\n          let final_nl = compile_expr_gc(body_buf, body, local_names, param_count, func_ctx, -1)\n          Array::push(bodies, body_buf)\n          let extra = if final_nl > param_count {\n            final_nl - param_count\n          } else {\n            0\n          }\n          Array::push(meta_i32, 0)\n          Array::push(meta_i64, extra)\n          Array::push(user_ref_local_indices_all, ref_local_indices_f)\n        },\n        _ => throw(\"expected function\")\n      }\n      ,\n      _ => throw(\"expected let statement\")\n    }\n    bi = bi + 1\n  }\n  let start_body = bytebuf_new()\n  let entry_func_idx = entry_user_idx + func_offset\n  let entry_params = Array::get(ft_params, entry_user_idx)\n  if entry_params != 0 {\n    throw(\"WASI entry function must take 0 parameters\")\n  }\n  // #538: initialize computed module-level globals (statement order) before\n  // the entry runs. Compiled with a fresh local frame; lambdas created here\n  // land in lt_w like any other (num_lambdas is computed AFTER this).\n  let mut start_extra_locals = 0\n  if Array::length(gc_global_names_l) > 0 {\n    let init_ref_cells = array_empty()\n    let init_ref_idx = array_empty()\n    let init_ctx = CompileCtxGc::{\n      func_table: FuncTable::{\n        names: ft_names, indices: ft_indices, params: ft_params,\n        returns: ft_returns, needs_env: ft_needs_env\n      },\n      str_table: StrTable::{\n        strs: str_strs, offsets: str_offsets, lengths: str_lengths\n      },\n      lambda_table: lt_w,\n      num_user_funcs: num_user_funcs, func_offset: func_offset,\n      ref_cell_names: init_ref_cells, ref_local_indices: init_ref_idx,\n      refcell_type_idx: refcell_type_idx, closure_type_base: closure_type_base,\n      gc_ctor_table: CtorTable::{\n        names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list,\n        type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names,\n        names_sorted: gc_ctor_names_sorted, names_sorted_pos: gc_ctor_names_sorted_pos\n      },\n      gc_const_names: gc_const_names_l, gc_const_kinds: gc_const_kinds_l,\n      gc_const_ivals: gc_const_ivals_l, gc_const_svals: gc_const_svals_l,\n      gc_global_names: gc_global_names_l,\n      gc_float_locals: array_empty(),\n      gc_bool_locals: array_empty(),\n      gc_to_string_is_show_wrapper: gc_to_string_is_wrapper,\n      gc_agg_local_slots: array_empty(),\n      gc_agg_ret_names: gc_agg_ret_names_l,\n      gc_agg_ret_infos: gc_agg_ret_infos_l\n    }\n    let init_locals = array_empty()\n    let mut ginit = 0\n    while ginit < Array::length(gc_global_names_l) {\n      let gexpr = Array::get(gc_global_exprs_l, ginit)\n      let g_nl = compile_expr_gc(start_body, gexpr, init_locals, Array::length(init_locals), init_ctx, -1)\n      emit_global_set(start_body, 1 + ginit)\n      if g_nl > start_extra_locals {\n        start_extra_locals = g_nl\n      }\n      if Array::length(init_locals) > start_extra_locals {\n        start_extra_locals = Array::length(init_locals)\n      }\n      ginit = ginit + 1\n    }\n  }\n  emit_i64_const(start_body, 0)\n  emit_call(start_body, entry_func_idx)\n  emit_call(start_body, 1 + hbo)\n  let num_lambdas = Array::length(lt_w.bodies)\n  Array::push(bodies, start_body)\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, start_extra_locals)\n  Array::push(user_ref_local_indices_all, array_empty())\n  let mut li = 0\n  while li < num_lambdas {\n    Array::push(bodies, Array::get(lt_w.bodies, li))\n    Array::push(meta_i32, Array::get(lt_w.meta_i32, li))\n    Array::push(meta_i64, Array::get(lt_w.meta_i64, li))\n    Array::push(user_ref_local_indices_all, array_empty())\n    li = li + 1\n  }\n  let mut max_closure_arity = -1\n  let mut lai = 0\n  while lai < num_lambdas {\n    let lpc = Array::get(lt_w.param_counts, lai) - 1\n    if lpc > max_closure_arity {\n      max_closure_arity = lpc\n    }\n    lai = lai + 1\n  }\n  let mut uai2 = 0\n  while uai2 < num_user_funcs {\n    let upc = Array::get(ft_params, uai2)\n    if upc > max_closure_arity {\n      max_closure_arity = upc\n    }\n    uai2 = uai2 + 1\n  }\n  let num_closure_types = if max_closure_arity >= 0 {\n    max_closure_arity + 1\n  } else {\n    0\n  }\n  let num_base_types = 11\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types)\n  emit_func_type_raw(type_content, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  emit_func_type_raw(type_content, [\n    126\n  ], array_empty())\n  emit_func_type_raw(type_content, array_empty(), array_empty())\n  emit_func_type_raw(type_content, [\n    126\n  ], [\n    126\n  ])\n  emit_func_type_raw(type_content, [\n    126,\n    126\n  ], [\n    126\n  ])\n  emit_func_type_raw(type_content, array_empty(), [\n    126\n  ])\n  emit_func_type_raw(type_content, [\n    126,\n    126\n  ], array_empty())\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126\n  ], array_empty())\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126\n  ], [\n    126\n  ])\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126,\n    126\n  ], array_empty())\n  emit_struct_type_raw(type_content, [\n    126\n  ], [\n    1\n  ])\n  let mut cti = 0\n  while cti < num_closure_types {\n    let num_params = cti + 1\n    let ct_params = array_empty()\n    let mut cpti = 0\n    while cpti < num_params {\n      Array::push(ct_params, 126)\n      cpti = cpti + 1\n    }\n    emit_func_type_raw(type_content, ct_params, [\n      126\n    ])\n    cti = cti + 1\n  }\n  let out = bytebuf_new()\n  emit_header(out)\n  bytebuf_push_section(out, 1, type_content)\n  if use_host {\n    // fd_write + the nine \"vibe\" host imports (types: 3=(i64)->i64,\n    // 5=()->i64, 6=(i64,i64)->()) -- the linear backend's raw tagged ABI.\n    let imp_content = bytebuf_new()\n    bytebuf_push_vec_header(imp_content, 11)\n    emit_name(imp_content, \"wasi_snapshot_preview1\")\n    emit_name(imp_content, \"fd_write\")\n    bytebuf_push(imp_content, 0)\n    leb128_encode_u32(imp_content, 0)\n    let host_imports = [\n      (\"env-get\", 3),\n      (\"args-len\", 5),\n      (\"args-get\", 3),\n      (\"fs_read_file\", 3),\n      (\"fs_exists\", 3),\n      (\"fs_stat_token\", 3),\n      (\"fs_write_file\", 6),\n      (\"fs_write_bytes\", 6),\n      (\"fs_read_bytes\", 3),\n      (\"profile-now-us\", 5)\n    ]\n    let mut __hi = 0\n    while __hi < Array::length(host_imports) {\n      let (hin, hit) = Array::get(host_imports, __hi)\n      emit_name(imp_content, \"vibe\")\n      emit_name(imp_content, hin)\n      bytebuf_push(imp_content, 0)\n      leb128_encode_u32(imp_content, hit)\n      __hi = __hi + 1\n    }\n    bytebuf_push_section(out, 2, imp_content)\n  } else {\n    emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  }\n  let func_type_indices = array_empty()\n  // #415 B-1: builtin type indices are declared next to each body push\n  // (push_gc_builtin above) — splice them here in the same order.\n  let mut gbti = 0\n  while gbti < Array::length(gc_builtin_type_idxs) {\n    Array::push(func_type_indices, Array::get(gc_builtin_type_idxs, gbti))\n    gbti = gbti + 1\n  }\n  let mut fti = 0\n  while fti < num_user_funcs {\n    let upc = Array::get(ft_params, fti)\n    Array::push(func_type_indices, closure_type_base + upc)\n    fti = fti + 1\n  }\n  Array::push(func_type_indices, 2)\n  let mut lfi = 0\n  while lfi < num_lambdas {\n    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1\n    Array::push(func_type_indices, closure_type_base + lam_user_params)\n    lfi = lfi + 1\n  }\n  if Array::length(func_type_indices) != Array::length(bodies) {\n    throw(\"gc codegen internal error: function section and code section count mismatch\")\n  } else {\n    ()\n  }\n  emit_function_section(out, func_type_indices)\n  let total_table_entries = num_user_funcs + num_lambdas\n  if total_table_entries > 0 {\n    emit_table_section_funcref(out, total_table_entries)\n  }\n  emit_memory_section(out, 1)\n  // #538: exception tag (id 13 section sits between memory and global).\n  // #721-style gating: throw-free modules stay tag-free and run on engines\n  // without the exceptions proposal.\n  if stmts_contain_exceptions(stmts) {\n    let tag_content = bytebuf_new()\n    leb128_encode_u32(tag_content, 1)\n    bytebuf_push(tag_content, 0)\n    leb128_encode_u32(tag_content, 1)\n    bytebuf_push_section(out, 13, tag_content)\n  } else {\n    ()\n  }\n  if Array::length(gc_global_names_l) == 0 {\n    emit_global_section_i32_mut(out, heap_start)\n  } else {\n    // global 0: i32 mut heap pointer; globals 1..N: i64 mut computed values.\n    let g_content = bytebuf_new()\n    bytebuf_push_vec_header(g_content, 1 + Array::length(gc_global_names_l))\n    bytebuf_push(g_content, 127)\n    bytebuf_push(g_content, 1)\n    emit_i32_const(g_content, heap_start)\n    emit_end(g_content)\n    let mut ggi = 0\n    while ggi < Array::length(gc_global_names_l) {\n      bytebuf_push(g_content, 126)\n      bytebuf_push(g_content, 1)\n      emit_i64_const(g_content, 0)\n      emit_end(g_content)\n      ggi = ggi + 1\n    }\n    bytebuf_push_section(out, 6, g_content)\n  }\n  let start_func_idx = func_offset + num_user_funcs\n  // #538 P4.5: export the entry function and __heap_ptr alongside _start.\n  // The host runner's raw-ABI string allocation (args-get / env-get /\n  // fs_read_file results) heap-bumps through the exported __heap_ptr global;\n  // without it the runner falls back to an end-of-memory arena that the\n  // guest's own bump allocator grows into and clobbers mid-compile.\n  let export_content = bytebuf_new()\n  let export_entry_too = entry_name != \"_start\"\n  bytebuf_push_vec_header(export_content, if export_entry_too {\n    4\n  } else {\n    3\n  })\n  emit_name(export_content, \"_start\")\n  bytebuf_push(export_content, 0)\n  leb128_encode_u32(export_content, start_func_idx)\n  if export_entry_too {\n    emit_name(export_content, entry_name)\n    bytebuf_push(export_content, 0)\n    leb128_encode_u32(export_content, entry_func_idx)\n  } else {\n    ()\n  }\n  emit_name(export_content, \"memory\")\n  bytebuf_push(export_content, 2)\n  leb128_encode_u32(export_content, 0)\n  emit_name(export_content, \"__heap_ptr\")\n  bytebuf_push(export_content, 3)\n  leb128_encode_u32(export_content, 0)\n  bytebuf_push_section(out, 7, export_content)\n  if total_table_entries > 0 {\n    let table_func_indices = array_empty()\n    let mut tei = 0\n    while tei < num_user_funcs {\n      Array::push(table_func_indices, func_offset + tei)\n      tei = tei + 1\n    }\n    let mut tej = 0\n    while tej < num_lambdas {\n      Array::push(table_func_indices, start_func_idx + 1 + tej)\n      tej = tej + 1\n    }\n    emit_element_section_active(out, table_func_indices)\n  }\n  let code_content = bytebuf_new()\n  bytebuf_push_vec_header(code_content, Array::length(bodies))\n  let mut ci = 0\n  while ci < Array::length(bodies) {\n    let body = Array::get(bodies, ci)\n    let func_buf = bytebuf_new()\n    let ni32 = Array::get(meta_i32, ci)\n    let ni64 = Array::get(meta_i64, ci)\n    let ref_indices = Array::get(user_ref_local_indices_all, ci)\n    let num_ref_locals = Array::length(ref_indices)\n    if num_ref_locals == 0 {\n      if ni32 == 0 {\n        if ni64 == 0 {\n          leb128_encode_u32(func_buf, 0)\n        } else {\n          leb128_encode_u32(func_buf, 1)\n          leb128_encode_u32(func_buf, ni64)\n          bytebuf_push(func_buf, 126)\n        }\n      } else {\n        if ni64 == 0 {\n          leb128_encode_u32(func_buf, 1)\n          leb128_encode_u32(func_buf, ni32)\n          bytebuf_push(func_buf, 127)\n        } else {\n          leb128_encode_u32(func_buf, 2)\n          leb128_encode_u32(func_buf, ni32)\n          bytebuf_push(func_buf, 127)\n          leb128_encode_u32(func_buf, ni64)\n          bytebuf_push(func_buf, 126)\n        }\n      }\n    } else {\n      let body_idx_in_user = ci - num_generated\n      let param_count_for_body = Array::get(ft_params, body_idx_in_user) + 1\n      let num_extra = ni64\n      leb128_encode_u32(func_buf, num_extra)\n      let mut rli = 0\n      while rli < num_extra {\n        let actual_local_idx = param_count_for_body + rli\n        let mut is_ref = false\n        let mut ri = 0\n        while ri < num_ref_locals {\n          if Array::get(ref_indices, ri) == actual_local_idx {\n            is_ref = true\n          }\n          ri = ri + 1\n        }\n        leb128_encode_u32(func_buf, 1)\n        // #538: ref cells are linear-memory cells now; every local is i64.\n        let _ = is_ref\n        bytebuf_push(func_buf, 126)\n        rli = rli + 1\n      }\n    }\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\n    bytebuf_push_buf(code_content, func_buf)\n    ci = ci + 1\n  }\n  bytebuf_push_section(out, 10, code_content)\n  if num_strings > 0 {\n    let data_offsets = array_empty()\n    let data_bufs = fresh_bytes_array()\n    let mut di = 0\n    while di < num_strings {\n      Array::push(data_offsets, Array::get(str_offsets, di))\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\n      di = di + 1\n    }\n    emit_data_section_multi(out, data_offsets, data_bufs)\n  }\n  bytebuf_to_bytes(out)\n}\n")
}

let cli_adapter_source_142 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_expr.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, mut_needs_ref_cell\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtxGc, CtorTable, FuncTable, LambdaTable, StrTable, expr_tag, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, find_func_stmt, ctor_table_index_of, resolve_func, resolve_local, agg_info_of_ident, agg_log_reset_above, agg_ret_lookup, agg_slot_lookup, find_local_slot, gc_slot_log_reset_above, struct_field_candidates, struct_field_dispatch_cases, struct_index_by_field_set, struct_tag_by_index\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_int, array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_heap_memory_grow_check, emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./backend_builtins_array_alloc.vibe {\n  gc_gen_arr_len_body, gc_gen_arr_new_body\n}\n\nimport ./backend_builtins_array_get.vibe {\n  gc_gen_arr_get_body\n}\n\nimport ./backend_builtins_array_push.vibe {\n  gc_gen_arr_push_body\n}\n\nimport ./backend_builtins_array_set.vibe {\n  gc_gen_arr_set_body\n}\n\nimport ./backend_builtins_numeric.vibe {\n  gc_gen_double_to_int_body, gc_gen_identity_body, gc_gen_int_to_double_body\n}\n\nimport ./backend_builtins_print.vibe {\n  gc_gen_print_i64_body, gc_gen_print_str_body\n}\n\nimport ./backend_builtins_string.vibe {\n  gc_gen_str_concat_body, gc_gen_str_eq_body, gc_gen_str_len_body\n}\n\nimport ./backend_builtins_string_extra.vibe {\n  gc_gen_str_char_code_at_body, gc_gen_str_from_char_code_body, gc_gen_str_substring_body\n}\n\nimport ./backend_call.vibe {\n  compile_call_gc\n}\n\nimport ./backend_lambda_body.vibe {\n  compile_lambda_gc\n}\n\nimport ./backend_match.vibe {\n  compile_match_gc\n}\n\n//# Functions\n\n// #538 P4.5: shape-based \"definitely scalar\" test for `==`/`!=` operands,\n// mirroring the linear lane's expr_is_intish literal/operator cases (the gc\n// lane has no checker types or local-type tracking, so only shapes count).\n// Anything else routes through the `eq` builtin, whose fall-back compares\n// packed (ptr<<32)|len strings by CONTENT — raw i64.eq made every\n// string-vs-string `==` a pointer compare, so the gc-compiled compiler failed\n// its own types_equal with \"return type mismatch: expected Int, got Int\".\nfn gc_expr_is_intish(e: Expr) -> Bool {\n  match e {\n    EInt(_) => true,\n    EBool(_) => true,\n    EBinOp(op, _, _) => op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"==\" || op == \"!=\" || op == \"&&\" || op == \"||\" || op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\",\n    EUnaryOp(op, _) => op == \"!\",\n    _ => false\n  }\n}\n\n// #538 P4.5: shape-based \"holds f64 raw bits\" test. Float literals,\n// int->float conversions, arithmetic over a floatish operand, and let-bound\n// locals recorded in ctx.gc_float_locals count; anything else (annotated\n// Double params, tuple-destructured floats) is best-effort untracked.\n// #1032: a bare ident resolves to its CURRENT slot (find_local_slot) before\n// checking ctx.gc_float_locals -- mirrors gc_expr_is_boolish below, so a\n// name reused with a non-float binding in a sibling scope is not\n// misclassified via its old, now-stale slot entry.\nfn gc_expr_is_floatish(e: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {\n  match e {\n    EFloat(_) => true,\n    EIdent(fname, _) => {\n      let slot = find_local_slot(local_names, fname)\n      slot >= 0 && array_contains_int(ctx.gc_float_locals, slot)\n    },\n    EBinOp(op, l, r) => (op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\") && (gc_expr_is_floatish(l, local_names, ctx) || gc_expr_is_floatish(r, local_names, ctx)),\n    EUnaryOp(op, x) => op == \"-\" && gc_expr_is_floatish(x, local_names, ctx),\n    ECall(fcallee, _, _) => match fcallee {\n      EIdent(cn, _) => cn == \"Int::to_double\" || cn == \"Double::from_i64_bits\" || cn == \"Float::to_double\" || cn == \"Double::to_float\" || cn == \"Int::to_float\",\n      _ => false\n    },\n    _ => false\n  }\n}\n\n// #1015: gc mirror of the linear lane's expr_is_boolish -- shape-based \"is\n// this statically a Bool\" test. Bool literals, comparison/logical operators,\n// unary `!`, and -- via ctx.gc_bool_locals -- a bare ident CURRENTLY bound\n// (via find_local_slot) to a slot tracked as boolish. Bool and Int share the\n// same gc-lane numeric representation (no distinguishing runtime type tag),\n// so this static classification is the only way to route a Bool argument to\n// the \"true\"/\"false\" formatter instead of the generic runtime `__to_string`\n// dispatch, which cannot tell them apart.\nfn gc_expr_is_boolish(e: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {\n  match e {\n    EBool(_) => true,\n    EIdent(fname, _) => {\n      let slot = find_local_slot(local_names, fname)\n      slot >= 0 && array_contains_int(ctx.gc_bool_locals, slot)\n    },\n    EBinOp(op, _, _) => op == \"==\" || op == \"!=\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"&&\" || op == \"||\",\n    EUnaryOp(op, _) => op == \"!\",\n    _ => false\n  }\n}\n\n// #538 P4.5: is `e` syntactically a constructor value (ctor call or nullary\n// ctor ident)? Runtime values carry no type info, so — exactly like the\n// linear lane's emit_eq_value — the SHAPE of a literal operand decides the\n// structural comparison path for `==`/`!=`.\nfn gc_is_ctor_expr(e: Expr, ctx: CompileCtxGc) -> Bool {\n  match e {\n    ECall(callee, _, _) => match callee {\n      EIdent(cname, _) => ctor_table_index_of(ctx.gc_ctor_table, cname) >= 0,\n      _ => false\n    },\n    EIdent(iname, _) => ctor_table_index_of(ctx.gc_ctor_table, iname) >= 0,\n    _ => false\n  }\n}\n\n// Structural equality for two tuples (gc layout: raw even ptr, element i at\n// ptr+i*8, no header). Ported from the linear emit_tuple_struct_eq; leaves a\n// raw i64 0/1. `cefn` is compile_expr_gc, threaded to avoid a forward ref.\nfn emit_gc_tuple_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, num: Int, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, cefn: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }) -> Int with { Error } {\n  let aptr = next_local\n  Array::push(local_names, \"__gceqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__gceqb\")\n  let nl1 = cefn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  emit_local_set(buf, aptr)\n  let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n  emit_local_set(buf, bptr)\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  emit_i64_const(buf, 1)\n  let mut i = 0\n  while i < num {\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, i * 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, i * 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    i = i + 1\n  }\n  nl2\n}\n\n// Structural equality for two ctor values (gc layout: value = ptr|1, tag i32\n// at +0, field i at +8+i*8): tags first, then field-wise `eq` (strings compare\n// by content there). The generic `eq` builtin compares ctor POINTERS — fresh\n// allocations are never bit-equal, which made the gc-compiled checker's\n// `Some(av) == rb` effect-row comparison (unify_effects) always false.\nfn emit_gc_ctor_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, fc: Int, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, cefn: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }) -> Int with { Error } {\n  let aptr = next_local\n  Array::push(local_names, \"__gcceqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__gcceqb\")\n  let nl1 = cefn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, aptr)\n  let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, bptr)\n  emit_local_get(buf, aptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_local_get(buf, bptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_eq(buf)\n  emit_if_i64(buf)\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  if fc == 63 {\n    // #724 round 2: DYNAMIC field count (fc 63 sentinel) — see the linear\n    // emit_ctor_struct_eq: equal tags imply equal argc, loop over argc@4.\n    let res_l = nl2\n    let cnt_l = nl2 + 1\n    let ii_l = nl2 + 2\n    Array::push(local_names, \"__gcceq_res\")\n    Array::push(local_names, \"__gcceq_cnt\")\n    Array::push(local_names, \"__gcceq_i\")\n    emit_i64_const(buf, 1)\n    emit_local_set(buf, res_l)\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i32_load(buf, 2, 4)\n    emit_i64_extend_i32_u(buf)\n    emit_local_set(buf, cnt_l)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, ii_l)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    emit_local_get(buf, ii_l)\n    emit_local_get(buf, cnt_l)\n    emit_i64_ge_s(buf)\n    emit_br_if(buf, 1)\n    emit_local_get(buf, res_l)\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, ii_l)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 8)\n    emit_i32_mul(buf)\n    emit_i32_add(buf)\n    emit_i64_load(buf, 3, 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, ii_l)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 8)\n    emit_i32_mul(buf)\n    emit_i32_add(buf)\n    emit_i64_load(buf, 3, 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    emit_local_set(buf, res_l)\n    emit_local_get(buf, ii_l)\n    emit_i64_const(buf, 1)\n    emit_i64_add(buf)\n    emit_local_set(buf, ii_l)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    emit_local_get(buf, res_l)\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl2 + 3\n  } else {\n    emit_i64_const(buf, 1)\n    let mut i = 0\n    while i < fc {\n      emit_local_get(buf, aptr)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + i * 8)\n      emit_local_get(buf, bptr)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + i * 8)\n      emit_call(buf, eq_fidx)\n      emit_i64_and(buf)\n      i = i + 1\n    }\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl2\n  }\n}\n\n// The equality value for `lhs == rhs` (raw i64 0/1 on the stack): tuple / ctor\n// literals get structural comparison, provably-scalar operands a raw i64.eq,\n// everything else the generic `eq` builtin (bit-equal fast path + string\n// content fall-back). Mirrors the linear lane's emit_eq_value routing.\nfn emit_gc_eq_value(buf: Bytes, lhs: Expr, rhs: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, cefn: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }) -> Int with { Error } {\n  let lhs_is_tuple = match lhs {\n    ETuple(_) => true,\n    _ => false\n  }\n  let rhs_is_tuple = match rhs {\n    ETuple(_) => true,\n    _ => false\n  }\n  // #724: aggregate shape of a bare-ident operand tracked at its `let`\n  // (kind*64+n, or -1) — mirrors the linear backend's emit_eq_value.\n  let lhs_agg = agg_info_of_ident(ctx.gc_agg_local_slots, lhs, local_names)\n  let rhs_agg = agg_info_of_ident(ctx.gc_agg_local_slots, rhs, local_names)\n  if lhs_is_tuple || rhs_is_tuple {\n    let num = match lhs {\n      ETuple(les) => Array::length(les),\n      _ => match rhs {\n        ETuple(res) => Array::length(res),\n        _ => 0\n      }\n    }\n    emit_gc_tuple_struct_eq(buf, lhs, rhs, num, local_names, next_local, ctx, ld, cefn)\n  } else if lhs_agg / 64 == 1 || rhs_agg / 64 == 1 {\n    let tn = if lhs_agg / 64 == 1 {\n      lhs_agg % 64\n    } else {\n      rhs_agg % 64\n    }\n    emit_gc_tuple_struct_eq(buf, lhs, rhs, tn, local_names, next_local, ctx, ld, cefn)\n  } else if gc_is_ctor_expr(lhs, ctx) || gc_is_ctor_expr(rhs, ctx) {\n    let clit = if gc_is_ctor_expr(lhs, ctx) {\n      lhs\n    } else {\n      rhs\n    }\n    let cfc = match clit {\n      ECall(_, cargs, _) => Array::length(cargs),\n      _ => 0\n    }\n    emit_gc_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, cefn)\n  } else if lhs_agg / 64 == 2 || rhs_agg / 64 == 2 {\n    // Tag comparison short-circuits unequal variants before any field read,\n    // so walking the larger tracked field count is safe (see the linear\n    // emit_eq_value for the argument).\n    let lfc = if lhs_agg / 64 == 2 {\n      lhs_agg % 64\n    } else {\n      0\n    }\n    let rfc = if rhs_agg / 64 == 2 {\n      rhs_agg % 64\n    } else {\n      0\n    }\n    let cfc = if lfc > rfc {\n      lfc\n    } else {\n      rfc\n    }\n    emit_gc_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, cefn)\n  } else if gc_expr_is_intish(lhs) || gc_expr_is_intish(rhs) {\n    let nl1 = cefn(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n    emit_i64_eq(buf)\n    emit_i64_extend_i32_s(buf)\n    nl2\n  } else {\n    let nl1 = cefn(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n    let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n    emit_call(buf, eq_fidx)\n    nl2\n  }\n}\n\nfn compile_expr_gc(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int) -> Int with { Error } {\n  let ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error } = (b, e, ln, nl, d) -> {\n    compile_expr_gc(b, e, ln, nl, ctx, d)\n  }\n  match expr {\n    EInt(n) => {\n      emit_i64_const(buf, n)\n      next_local\n    },\n    EBool(b_val) => {\n      emit_i64_const(buf, if b_val {\n        1\n      } else {\n        0\n      })\n      next_local\n    },\n    EFloat(v) => {\n      let bits = Double::to_i64_bits(v)\n      emit_f64_const_bits(buf, bits)\n      emit_i64_reinterpret_f64(buf)\n      next_local\n    },\n    EString(s) => {\n      let idx = str_table_lookup(ctx.str_table.strs, s)\n      emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\n      next_local\n    },\n    EIdent(name, _) => {\n      let len = Array::length(local_names)\n      let rec try_local: (Int) -> Int = (i) -> {\n        if i < 0 {\n          -1\n        }\n        else if Array::get(local_names, i) == name {\n          i\n        }\n        else try_local(i - 1)\n      }\n      let local_idx = try_local(len - 1)\n      if local_idx >= 0 {\n        if array_contains_str(ctx.ref_cell_names, name) {\n          // #538: ref cells are 8-byte linear-memory cells (NOT wasm-gc\n          // structs): a (ref $t) value cannot cross the i64 world -- storing\n          // a captured cell into a closure env emitted invalid wasm.\n          emit_local_get(buf, local_idx)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 0)\n        } else {\n          emit_local_get(buf, local_idx)\n        }\n        next_local\n      } else {\n        let ctor_idx = ctor_table_index_of(ctx.gc_ctor_table, name)\n        if ctor_idx >= 0 {\n          let tag_c = Array::get(ctx.gc_ctor_table.tags, ctor_idx)\n          let ptr_l = next_local\n          Array::push(local_names, \"__ctor_ptr\")\n          emit_global_get(buf, 0)\n          emit_i64_extend_i32_u(buf)\n          emit_local_set(buf, ptr_l)\n          emit_global_get(buf, 0)\n          emit_i32_const(buf, 8)\n          emit_i32_add(buf)\n          emit_global_set(buf, 0)\n          // #415: gc-lane heap bump must grow linear memory like the linear\n          // backend does -- without this any allocation past the initial page\n          // traps OOB (the gc smoke fixture only ever allocated a few bytes).\n          emit_heap_memory_grow_check(buf)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, tag_c)\n          emit_i32_store(buf, 2, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, 0)\n          emit_i32_store(buf, 2, 4)\n          emit_local_get(buf, ptr_l)\n          emit_i64_const(buf, 1)\n          emit_i64_or(buf)\n          next_local + 1\n        } else {\n          // #538: module-level literal constants (`let op_call = 16`).\n          let mut const_i = -1\n          let mut __gc = 0\n          while __gc < Array::length(ctx.gc_const_names) {\n            if Array::get(ctx.gc_const_names, __gc) == name {\n              const_i = __gc\n              __gc = Array::length(ctx.gc_const_names)\n            } else {\n              __gc = __gc + 1\n            }\n          }\n          if const_i >= 0 {\n            if Array::get(ctx.gc_const_kinds, const_i) == 1 {\n              let cs = Array::get(ctx.gc_const_svals, const_i)\n              let csi = str_table_lookup(ctx.str_table.strs, cs)\n              emit_str_ref(buf, Array::get(ctx.str_table.offsets, csi), Array::get(ctx.str_table.lengths, csi))\n            } else {\n              emit_i64_const(buf, Array::get(ctx.gc_const_ivals, const_i))\n            }\n            return next_local\n          }\n          // #538: computed module-level global (mutable i64, init in _start).\n          let mut glob_i = -1\n          let mut __gg = 0\n          while __gg < Array::length(ctx.gc_global_names) {\n            if Array::get(ctx.gc_global_names, __gg) == name {\n              glob_i = __gg\n              __gg = Array::length(ctx.gc_global_names)\n            } else {\n              __gg = __gg + 1\n            }\n          }\n          if glob_i >= 0 {\n            emit_global_get(buf, 1 + glob_i)\n            return next_local\n          }\n          let fn_len = Array::length(ctx.func_table.names)\n          let mut fni = -1\n          let mut __fj = 0\n          while __fj < fn_len {\n            if Array::get(ctx.func_table.names, __fj) == name {\n              fni = __fj\n              __fj = fn_len\n            } else {\n              __fj = __fj + 1\n            }\n          }\n          if fni < 0 {\n            throw(String::concat(\"undefined variable: \", name))\n          }\n          let fidx = Array::get(ctx.func_table.indices, fni)\n          let table_slot = fidx - ctx.func_offset\n          emit_i64_const(buf, (table_slot<<2)|2)\n          next_local\n        }\n      }\n    },\n    EBinOp(op, lhs, rhs) => if op == \"&&\" || op == \"||\" {\n      // Short-circuit lowering (mirrors the linear lane): the emit_binop_op\n      // fallthrough's eager `i64.and`/`i64.or` evaluated BOTH operands, so\n      // `false && inc()` ran inc()'s side effects. gc-lane bools are raw\n      // 1/0 i64s; eqz treats any non-zero as true.\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      emit_i64_eqz(buf)\n      if op == \"&&\" {\n        emit_if_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_else(buf)\n        let nl2 = ce(buf, rhs, local_names, nl1, ld)\n        emit_end(buf)\n        nl2\n      } else {\n        emit_if_i64(buf)\n        let nl2 = ce(buf, rhs, local_names, nl1, ld)\n        emit_else(buf)\n        emit_i64_const(buf, 1)\n        emit_end(buf)\n        nl2\n      }\n    } else if op == \"==\" {\n      emit_gc_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr_gc)\n    } else if op == \"!=\" {\n      let nle = emit_gc_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr_gc)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      nle\n    } else if (op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\") && (gc_expr_is_floatish(lhs, local_names, ctx) || gc_expr_is_floatish(rhs, local_names, ctx)) {\n      // Float arithmetic: locals hold raw f64 bits in i64; reinterpret both\n      // sides, run the f64 op, reinterpret back. The unconditional i64 ops\n      // below compute garbage on float bits (linear routes these through\n      // expr_is_floatish the same way).\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      emit_f64_reinterpret_i64(buf)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_f64_reinterpret_i64(buf)\n      if op == \"+\" {\n        emit_f64_add(buf)\n      } else if op == \"-\" {\n        emit_f64_sub(buf)\n      } else if op == \"*\" {\n        emit_f64_mul(buf)\n      } else {\n        emit_f64_div(buf)\n      }\n      emit_i64_reinterpret_f64(buf)\n      nl2\n    } else if (op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\") && (gc_expr_is_floatish(lhs, local_names, ctx) || gc_expr_is_floatish(rhs, local_names, ctx)) {\n      // Float ordering: signed-i64 compare of raw f64 bits inverts the order\n      // whenever both sides are negative (and misranks mixed signs vs -0.0),\n      // so route through real f64 comparisons (mirrors the linear lane).\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      emit_f64_reinterpret_i64(buf)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_f64_reinterpret_i64(buf)\n      if op == \"<\" {\n        emit_f64_lt(buf)\n      } else if op == \">\" {\n        emit_f64_gt(buf)\n      } else if op == \"<=\" {\n        emit_f64_le(buf)\n      } else {\n        emit_f64_ge(buf)\n      }\n      emit_i64_extend_i32_s(buf)\n      nl2\n    } else {\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_binop_op(buf, op)\n      nl2\n    },\n    EUnaryOp(op, operand) => if op == \"-\" && gc_expr_is_floatish(operand, local_names, ctx) {\n      // `0 - bits` integer-negates the f64 bit pattern; use f64.neg instead.\n      let nl = ce(buf, operand, local_names, next_local, ld)\n      emit_f64_reinterpret_i64(buf)\n      emit_f64_neg(buf)\n      emit_i64_reinterpret_f64(buf)\n      nl\n    } else if op == \"-\" {\n      emit_i64_const(buf, 0)\n      let nl = ce(buf, operand, local_names, next_local, ld)\n      emit_i64_sub(buf)\n      nl\n    } else if op == \"!\" {\n      let nl = ce(buf, operand, local_names, next_local, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    } else {\n      throw(String::concat(\"unsupported unary op: \", op))\n    }\n    ,\n    EIf(cond, then_e, else_e) => {\n      let nl1 = match cond {\n        EBinOp(cop, clhs, crhs) => if cop == \"==\" {\n          // #538 P4.5: `==`/`!=` route through emit_gc_eq_value (structural\n          // tuple/ctor compare, string content via the `eq` builtin); the\n          // result is shaped back into the raw comparison's i32 0/1.\n          let cnl = emit_gc_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr_gc)\n          emit_i32_wrap_i64(buf)\n          cnl\n        } else if cop == \"!=\" {\n          let cnl = emit_gc_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr_gc)\n          emit_i64_eqz(buf)\n          cnl\n        } else if (cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\") && (gc_expr_is_floatish(clhs, local_names, ctx) || gc_expr_is_floatish(crhs, local_names, ctx)) {\n          // Same f64-vs-raw-bits ordering fix as the EBinOp float comparison\n          // branch; the fast path leaves the comparison's i32 for the `if`.\n          let cnl1 = ce(buf, clhs, local_names, next_local, ld)\n          emit_f64_reinterpret_i64(buf)\n          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)\n          emit_f64_reinterpret_i64(buf)\n          if cop == \"<\" {\n            emit_f64_lt(buf)\n          }\n          else if cop == \">\" {\n            emit_f64_gt(buf)\n          }\n          else if cop == \"<=\" {\n            emit_f64_le(buf)\n          }\n          else {\n            emit_f64_ge(buf)\n          }\n          cnl2\n        } else if cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\" {\n          let cnl1 = ce(buf, clhs, local_names, next_local, ld)\n          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)\n          if cop == \"<\" {\n            emit_i64_lt_s(buf)\n          }\n          else if cop == \">\" {\n            emit_i64_gt_s(buf)\n          }\n          else if cop == \"<=\" {\n            emit_i64_le_s(buf)\n          }\n          else {\n            emit_i64_ge_s(buf)\n          }\n          cnl2\n        } else {\n          let cnl = ce(buf, cond, local_names, next_local, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        },\n        EBool(b_val) => {\n          emit_i32_const(buf, if b_val {\n            1\n          } else {\n            0\n          })\n          next_local\n        },\n        _ => {\n          let cnl = ce(buf, cond, local_names, next_local, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        }\n      }\n      emit_if_i64(buf)\n      let ld_inner = if ld >= 0 {\n        ld + 1\n      } else {\n        -1\n      }\n      let names_len_before = Array::length(local_names)\n      let nl_then = ce(buf, then_e, local_names, nl1, ld_inner)\n      emit_else(buf)\n      Array::truncate(local_names, names_len_before)\n      agg_log_reset_above(ctx.gc_agg_local_slots, names_len_before)\n      gc_slot_log_reset_above(ctx.gc_bool_locals, names_len_before)\n      gc_slot_log_reset_above(ctx.gc_float_locals, names_len_before)\n      let nl_else = ce(buf, else_e, local_names, nl1, ld_inner)\n      emit_end(buf)\n      Array::truncate(local_names, names_len_before)\n      agg_log_reset_above(ctx.gc_agg_local_slots, names_len_before)\n      gc_slot_log_reset_above(ctx.gc_bool_locals, names_len_before)\n      gc_slot_log_reset_above(ctx.gc_float_locals, names_len_before)\n      let max_nl = if nl_then > nl_else {\n        nl_then\n      } else {\n        nl_else\n      }\n      while Array::length(local_names) < max_nl {\n        Array::push(local_names, \"\")\n      }\n      max_nl\n    },\n    ECall(callee, args, _) => compile_call_gc(buf, callee, args, local_names, next_local, ctx, ld, ce),\n    ELet(name, value, body, _) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      if gc_expr_is_floatish(value, local_names, ctx) {\n        // #1032: logged by SLOT (local_idx), not name -- see\n        // gc_float_locals' doc comment on CompileCtxGc.\n        Array::push(ctx.gc_float_locals, local_idx)\n      } else if gc_expr_is_boolish(value, local_names, ctx) {\n        // #1015: mirrors the float branch above (and the linear ELet's\n        // kind-3 boolish log in compile_expr_tail.vibe) -- a `let`-bound\n        // boolish value lets a later `to_string(b)` / `\"\\{b}\"` on the bare\n        // ident take the \"true\"/\"false\" formatter. Logged by SLOT (local_idx),\n        // not name -- see gc_bool_locals' doc comment on CompileCtxGc.\n        Array::push(ctx.gc_bool_locals, local_idx)\n      } else {\n        ()\n      }\n      // #724: log this binding's aggregate shape for the structural `==`\n      // comparators — mirrors the linear ELet (compile_expr_tail.vibe).\n      let agg_entry = match value {\n        ETuple(tels) => 64 + Array::length(tels),\n        ERecord(_, rfields, _) => 128 + Array::length(rfields),\n        _ => if gc_is_ctor_expr(value, ctx) {\n          match value {\n            ECall(_, cargs, _) => {\n              let fcnt = if Array::length(cargs) == 1 {\n                match Array::get(cargs, 0) {\n                  ERecord(_, crf, _) => Array::length(crf),\n                  _ => Array::length(cargs)\n                }\n              } else {\n                Array::length(cargs)\n              }\n              128 + fcnt\n            },\n            _ => 128\n          }\n        } else {\n          match value {\n            EIdent(src_nm, _) => {\n              let src_slot = find_local_slot(local_names, src_nm)\n              if src_slot >= 0 {\n                let src_info = agg_slot_lookup(ctx.gc_agg_local_slots, src_slot)\n                if src_info > 0 {\n                  src_info\n                } else {\n                  0\n                }\n              } else {\n                0\n              }\n            },\n            ECall(vcal, _, _) => match vcal {\n              // #724 round 2: `let a = f(..)` — classify by f's DECLARED\n              // return type. Only for a global fn name (a local shadowing\n              // `f` makes this a closure call of unknown type).\n              EIdent(cfn, _) => if find_local_slot(local_names, cfn) < 0 {\n                let rinfo = agg_ret_lookup(ctx.gc_agg_ret_names, ctx.gc_agg_ret_infos, cfn)\n                if rinfo > 0 {\n                  rinfo\n                } else {\n                  0\n                }\n              } else {\n                0\n              },\n              _ => 0\n            },\n            _ => 0\n          }\n        }\n      }\n      Array::push(ctx.gc_agg_local_slots, local_idx * 256 + agg_entry)\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\n      emit_local_set(buf, local_idx)\n      ce(buf, body, local_names, nl, ld)\n    },\n    ELetRec(name, value, body) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\n      emit_local_set(buf, local_idx)\n      match value {\n        EFn(_, _, params, _, _, fn_body) => {\n          let param_names_bp = array_empty()\n          let mut bpi = 0\n          while bpi < Array::length(params) {\n            let (pn, _) = Array::get(params, bpi)\n            Array::push(param_names_bp, pn)\n            bpi = bpi + 1\n          }\n          let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.gc_ctor_table.names))\n          let mut self_cap_idx = -1\n          let mut bci = 0\n          while bci < Array::length(caps) {\n            if Array::get(caps, bci) == name {\n              self_cap_idx = bci\n            }\n            bci = bci + 1\n          }\n          if self_cap_idx >= 0 {\n            emit_local_get(buf, local_idx)\n            emit_i64_const(buf, -4)\n            emit_i64_and(buf)\n            emit_i32_wrap_i64(buf)\n            emit_local_get(buf, local_idx)\n            emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\n          }\n          0\n        },\n        _ => 0\n      }\n      ce(buf, body, local_names, nl, ld)\n    },\n    ELetMut(name, value, body, _) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      if mut_needs_ref_cell(body, name) {\n        Array::push(ctx.ref_cell_names, name)\n        // Linear-memory cell: local = cell address (i64), value stored at +0.\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, local_idx)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, 8)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_heap_memory_grow_check(buf)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\n        emit_i64_store(buf, 3, 0)\n        Array::push(ctx.ref_local_indices, local_idx)\n        let nl2 = ce(buf, body, local_names, nl, ld)\n        nl2\n      } else {\n        if gc_expr_is_floatish(value, local_names, ctx) {\n          // #1032: logged by SLOT (local_idx), not name -- see\n          // gc_float_locals' doc comment on CompileCtxGc.\n          Array::push(ctx.gc_float_locals, local_idx)\n        } else if gc_expr_is_boolish(value, local_names, ctx) {\n          // #1015: logged by SLOT (local_idx), not name -- see\n          // gc_bool_locals' doc comment on CompileCtxGc.\n          Array::push(ctx.gc_bool_locals, local_idx)\n        } else {\n          ()\n        }\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\n        emit_local_set(buf, local_idx)\n        let nl2 = ce(buf, body, local_names, nl, ld)\n        nl2\n      }\n    },\n    EAssign(name, value, body) => {\n      let idx = resolve_local(local_names, name, \"gc_var\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, idx)\n        emit_i32_wrap_i64(buf)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_i64_store(buf, 3, 0)\n        ce(buf, body, local_names, nl, ld)\n      } else {\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_local_set(buf, idx)\n        ce(buf, body, local_names, nl, ld)\n      }\n    },\n    EAssignOp(name, op, value, body) => {\n      let idx = resolve_local(local_names, name, \"gc_var\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, idx)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, idx)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 0)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_assignop_op(buf, op)\n        emit_i64_store(buf, 3, 0)\n        ce(buf, body, local_names, nl, ld)\n      } else {\n        emit_local_get(buf, idx)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_assignop_op(buf, op)\n        emit_local_set(buf, idx)\n        ce(buf, body, local_names, nl, ld)\n      }\n    },\n    ESeq(first, second) => {\n      let nl_s = ce(buf, first, local_names, next_local, ld)\n      emit_drop(buf)\n      ce(buf, second, local_names, nl_s, ld)\n    },\n    ETuple(elems) => {\n      let num_elems = Array::length(elems)\n      let alloc_size = num_elems * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__tuple_ptr\")\n      let mut nl = next_local + 1\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, alloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      // #415: gc-lane heap bump must grow linear memory like the linear\n      // backend does -- without this any allocation past the initial page\n      // traps OOB (the gc smoke fixture only ever allocated a few bytes).\n      emit_heap_memory_grow_check(buf)\n      let mut ti = 0\n      while ti < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = ce(buf, Array::get(elems, ti), local_names, nl, ld)\n        emit_i64_store(buf, 3, ti * 8)\n        ti = ti + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl\n    },\n    EMatch(scrutinee, arms) => compile_match_gc(buf, scrutinee, arms, local_names, next_local, ctx, ld, ce),\n    EArray(elems) => {\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let arr_local = next_local\n      if ctx.func_offset > 0 && arr_new_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, arr_local)\n      Array::push(local_names, \"__arr_lit\")\n      let mut nl = next_local + 1\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        emit_local_get(buf, arr_local)\n        nl = ce(buf, Array::get(elems, ei), local_names, nl, ld)\n        if ctx.func_offset > 0 && arr_push_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_push_idx)\n        ei = ei + 1\n      }\n      emit_local_get(buf, arr_local)\n      nl\n    },\n    EForIn(var_name, index_name, iter_expr, body) => {\n      // #538 P4.5: `for x in xs { ... }` is an EXPRESSION (comprehension) —\n      // collect each body value into a fresh result array, exactly like the\n      // linear lane (compile_expr_tail2). The old statement-shaped loop\n      // DROPPED body values and yielded 0, so comprehension mappings like\n      // type_to_string's `let parts = for p in params { type_to_string(p) }`\n      // (and subst_apply's CtFn param map) produced EMPTY arrays when the\n      // gc-compiled compiler ran — every 1+-param function type resolved and\n      // printed as `()`, failing unify with \"expected X, got X\" diagnostics.\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_len_idx, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n      let (arr_get_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let names_len_at_forin = Array::length(local_names)\n      let result_local = next_local\n      let arr_local = next_local + 1\n      let i_local = next_local + 2\n      Array::push(local_names, \"__forin_res\")\n      Array::push(local_names, \"__forin_arr\")\n      Array::push(local_names, \"__forin_i\")\n      if ctx.func_offset > 0 && arr_new_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, result_local)\n      let nl1 = ce(buf, iter_expr, local_names, next_local + 3, ld)\n      emit_local_set(buf, arr_local)\n      emit_i64_const(buf, 0)\n      emit_local_set(buf, i_local)\n      emit_block_void(buf)\n      emit_loop_void(buf)\n      emit_local_get(buf, i_local)\n      emit_local_get(buf, arr_local)\n      if ctx.func_offset > 0 && arr_len_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_len_idx)\n      emit_i64_ge_s(buf)\n      emit_br_if(buf, 1)\n      let var_local = match index_name {\n        Some(idx_name) => {\n          emit_local_get(buf, i_local)\n          emit_local_set(buf, nl1)\n          Array::push(local_names, idx_name)\n          nl1 + 1\n        },\n        None => nl1\n      }\n      emit_local_get(buf, arr_local)\n      emit_local_get(buf, i_local)\n      if ctx.func_offset > 0 && arr_get_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_get_idx)\n      emit_local_set(buf, var_local)\n      Array::push(local_names, var_name)\n      let nl3 = var_local + 1\n      // Same innermost-loop ld reset as EWhile.\n      let nl4 = ce(buf, body, local_names, nl3, 0)\n      let body_val = nl4\n      Array::push(local_names, \"__forin_val\")\n      emit_local_set(buf, body_val)\n      emit_local_get(buf, result_local)\n      emit_local_get(buf, body_val)\n      if ctx.func_offset > 0 && arr_push_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_push_idx)\n      emit_local_get(buf, i_local)\n      emit_i64_const(buf, 1)\n      emit_i64_add(buf)\n      emit_local_set(buf, i_local)\n      emit_br(buf, 0)\n      emit_end(buf)\n      emit_end(buf)\n      emit_local_get(buf, result_local)\n      // Restore the outer name scope (loop-internal binds must not shadow\n      // later lookups) while preserving slot numbering — linear parity.\n      let final_nl = nl4 + 1\n      Array::truncate(local_names, names_len_at_forin)\n      agg_log_reset_above(ctx.gc_agg_local_slots, names_len_at_forin)\n      gc_slot_log_reset_above(ctx.gc_bool_locals, names_len_at_forin)\n      gc_slot_log_reset_above(ctx.gc_float_locals, names_len_at_forin)\n      while Array::length(local_names) < final_nl {\n        Array::push(local_names, \"\")\n      }\n      final_nl\n    },\n    EWhile(cond, body) => {\n      // ld reset: a new loop is the new INNERMOST loop, so break/continue\n      // distances restart at 0 (mirrors the linear EWhile fix — the old\n      // `ld + 1` made an inner `break` jump to the OUTER loop header).\n      emit_block_void(buf)\n      emit_loop_void(buf)\n      let nl1 = match cond {\n        EBinOp(wcop, wlhs, wrhs) => if wcop == \"==\" {\n          // #538 P4.5: same emit_gc_eq_value routing as the EIf fast path;\n          // each branch leaves the raw comparison's i32 0/1 shape so the\n          // shared i32_eqz inversion below applies uniformly.\n          let wnl = emit_gc_eq_value(buf, wlhs, wrhs, local_names, next_local, ctx, 0, compile_expr_gc)\n          emit_i32_wrap_i64(buf)\n          emit_i32_eqz(buf)\n          wnl\n        } else if wcop == \"!=\" {\n          let wnl = emit_gc_eq_value(buf, wlhs, wrhs, local_names, next_local, ctx, 0, compile_expr_gc)\n          emit_i64_eqz(buf)\n          emit_i32_eqz(buf)\n          wnl\n        } else if (wcop == \"<\" || wcop == \">\" || wcop == \"<=\" || wcop == \">=\") && (gc_expr_is_floatish(wlhs, local_names, ctx) || gc_expr_is_floatish(wrhs, local_names, ctx)) {\n          // Same f64-vs-raw-bits ordering fix as the EBinOp/EIf float\n          // comparison branches; leaves the i32 for the shared eqz below.\n          let wnl1 = ce(buf, wlhs, local_names, next_local, 0)\n          emit_f64_reinterpret_i64(buf)\n          let wnl2 = ce(buf, wrhs, local_names, wnl1, 0)\n          emit_f64_reinterpret_i64(buf)\n          if wcop == \"<\" {\n            emit_f64_lt(buf)\n          }\n          else if wcop == \">\" {\n            emit_f64_gt(buf)\n          }\n          else if wcop == \"<=\" {\n            emit_f64_le(buf)\n          }\n          else {\n            emit_f64_ge(buf)\n          }\n          emit_i32_eqz(buf)\n          wnl2\n        } else if wcop == \"<\" || wcop == \">\" || wcop == \"<=\" || wcop == \">=\" {\n          let wnl1 = ce(buf, wlhs, local_names, next_local, 0)\n          let wnl2 = ce(buf, wrhs, local_names, wnl1, 0)\n          if wcop == \"<\" {\n            emit_i64_lt_s(buf)\n          }\n          else if wcop == \">\" {\n            emit_i64_gt_s(buf)\n          }\n          else if wcop == \"<=\" {\n            emit_i64_le_s(buf)\n          }\n          else {\n            emit_i64_ge_s(buf)\n          }\n          emit_i32_eqz(buf)\n          wnl2\n        } else {\n          let wnl = ce(buf, cond, local_names, next_local, 0)\n          emit_i64_eqz(buf)\n          wnl\n        },\n        _ => {\n          let wnl = ce(buf, cond, local_names, next_local, 0)\n          emit_i64_eqz(buf)\n          wnl\n        }\n      }\n      emit_br_if(buf, 1)\n      let nl2 = ce(buf, body, local_names, nl1, 0)\n      emit_drop(buf)\n      emit_br(buf, 0)\n      emit_end(buf)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl2\n    },\n    EBreak(_) => {\n      emit_br(buf, ld + 1)\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EContinue(_) => {\n      emit_br(buf, ld)\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EUnit => {\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EReturn(ret_expr) => {\n      let nl = ce(buf, ret_expr, local_names, next_local, ld)\n      emit_return(buf)\n      nl\n    },\n    EFn(_, _, params, _, _, fn_body) =>\n    compile_lambda_gc(buf, params, fn_body, local_names, next_local, ctx, ld, compile_expr_gc),\n    EDot(obj, field, _, _) => {\n      // #538: numeric field = tuple index (`t.0`). gc tuples are raw untagged\n      // pointers with elements at i*8 (no header) -- see ETuple above.\n      let fc0 = String::char_code_at(field, 0)\n      if fc0 >= 48 && fc0 <= 57 {\n        let mut tidx = 0\n        let mut tp = 0\n        while tp < String::length(field) {\n          tidx = tidx * 10 + (String::char_code_at(field, tp) - 48)\n          tp = tp + 1\n        }\n        let nl_t = ce(buf, obj, local_names, next_local, ld)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, tidx * 8)\n        return nl_t\n      }\n      // #722: same struct-tag dispatch as the linear EDot path\n      // (compile_expr_tail4.vibe) — static load when every declaring struct\n      // agrees on the slot, runtime dispatch on the value's ctor tag when\n      // they disagree, first candidate as the untagged/legacy fallback.\n      let cands = struct_field_candidates(ctx.gc_ctor_table, field)\n      if Array::length(cands) == 0 {\n        throw(String::concat(\"unknown struct field: \", field))\n      }\n      let (_, idx0) = Array::get(cands, 0)\n      let dispatch = struct_field_dispatch_cases(cands)\n      let nl1 = ce(buf, obj, local_names, next_local, ld)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      if Array::length(dispatch) == 0 {\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + idx0 * 8)\n        nl1\n      } else {\n        let obj_l = nl1\n        Array::push(local_names, \"__dot_obj\")\n        emit_local_set(buf, obj_l)\n        let mut di = 0\n        while di < Array::length(dispatch) {\n          let (dtag, didx) = Array::get(dispatch, di)\n          emit_local_get(buf, obj_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, dtag)\n          emit_i32_eq(buf)\n          emit_if_i64(buf)\n          emit_local_get(buf, obj_l)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + didx * 8)\n          emit_else(buf)\n          di = di + 1\n        }\n        emit_local_get(buf, obj_l)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + idx0 * 8)\n        let mut de = 0\n        while de < Array::length(dispatch) {\n          emit_end(buf)\n          de = de + 1\n        }\n        nl1 + 1\n      }\n    },\n    ERecord(_, fields, _) => {\n      let flen = Array::length(fields)\n      // #722: resolve to a struct by exact field-name set; on a match, lay\n      // out in DECLARED field order and stamp the struct's ctor tag at\n      // value+0 (mirrors the linear backend and the `S::{...}` ctor path) so\n      // the tag-dispatching field access above stays type-correct.\n      let lit_names = array_empty()\n      let mut lni = 0\n      while lni < flen {\n        let (lfn, _) = Array::get(fields, lni)\n        Array::push(lit_names, lfn)\n        lni = lni + 1\n      }\n      let rec_si = struct_index_by_field_set(ctx.gc_ctor_table, lit_names)\n      let rec_tag = if rec_si >= 0 {\n        struct_tag_by_index(ctx.gc_ctor_table, rec_si)\n      } else {\n        0\n      }\n      let rec_fields = if rec_si >= 0 {\n        let def_fnames = Array::get(ctx.gc_ctor_table.struct_field_names, rec_si)\n        let ordered = array_empty()\n        let mut oi = 0\n        while oi < Array::length(def_fnames) {\n          let target_name = Array::get(def_fnames, oi)\n          let mut ri2 = 0\n          while ri2 < flen {\n            let (rfn, rfv) = Array::get(fields, ri2)\n            if rfn == target_name {\n              Array::push(ordered, (rfn, rfv))\n              ri2 = flen\n            } else {\n              ri2 = ri2 + 1\n            }\n          }\n          oi = oi + 1\n        }\n        ordered\n      } else {\n        fields\n      }\n      let obj_size = 8 + flen * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__rec_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, ptr_local)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, obj_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      // #415: gc-lane heap bump must grow linear memory like the linear\n      // backend does -- without this any allocation past the initial page\n      // traps OOB (the gc smoke fixture only ever allocated a few bytes).\n      emit_heap_memory_grow_check(buf)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, rec_tag)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, flen)\n      emit_i32_store(buf, 2, 4)\n      let mut nl_r = next_local + 1\n      let mut ri = 0\n      while ri < flen {\n        let (_, fexpr) = Array::get(rec_fields, ri)\n        nl_r = ce(buf, fexpr, local_names, nl_r, ld)\n        let val_local = nl_r\n        Array::push(local_names, \"__rec_val\")\n        emit_local_set(buf, val_local)\n        nl_r = nl_r + 1\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, val_local)\n        emit_i64_store(buf, 3, 8 + ri * 8)\n        ri = ri + 1\n      }\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl_r\n    },\n    EHandle(body, harms) => {\n      // #538: Error-effect handler via try_table (no resume/replay: algebraic\n      // user effects still need the linear backend's memo machinery).\n      //   block (result i64)            ;; B_outer: success value\n      //     block (result i64)          ;; B_catch: thrown payload\n      //       try_table (result i64) [catch tag0 -> label 0]\n      //         <body>\n      //       end\n      //       br 1                       ;; success\n      //     end\n      //     <bind Throw(msg); handler>   ;; payload -> handler value\n      //   end\n      if Array::length(harms) == 0 {\n        ce(buf, body, local_names, next_local, ld)\n      } else {\n        let (hpat, hexpr) = Array::get(harms, 0)\n        let mut hpat_ok = false\n        match hpat {\n          PCtor(hname, _) => {\n            if hname == \"Error::Throw\" || hname == \"Throw\" {\n              hpat_ok = true\n            }\n          },\n          _ => ()\n        }\n        if !hpat_ok {\n          throw(\"GC codegen: only `with Error { Throw(..) => .. }` handlers are supported (algebraic effect handlers need the linear backend)\")\n        }\n        emit_block_i64(buf)\n        emit_block_i64(buf)\n        bytebuf_push(buf, 31)\n        bytebuf_push(buf, 126)\n        leb128_encode_u32(buf, 1)\n        bytebuf_push(buf, 0)\n        leb128_encode_u32(buf, 0)\n        leb128_encode_u32(buf, 0)\n        let body_ld = if ld >= 0 {\n          ld + 3\n        } else {\n          -1\n        }\n        let nl_b = ce(buf, body, local_names, next_local, body_ld)\n        emit_end(buf)\n        emit_br(buf, 1)\n        emit_end(buf)\n        // payload (i64) on stack: bind the Throw arg if the pattern names it.\n        let names_before_h = Array::length(local_names)\n        let mut nl_h = nl_b\n        match hpat {\n          PCtor(_, hargs) => {\n            if Array::length(hargs) > 0 {\n              match Array::get(hargs, 0) {\n                PBind(hbname) => {\n                  let hb_l = Array::length(local_names)\n                  emit_local_set(buf, hb_l)\n                  Array::push(local_names, hbname)\n                  if hb_l + 1 > nl_h {\n                    nl_h = hb_l + 1\n                  }\n                },\n                _ => emit_drop(buf)\n              }\n            } else {\n              emit_drop(buf)\n            }\n          },\n          _ => emit_drop(buf)\n        }\n        let harm_ld = if ld >= 0 {\n          ld + 1\n        } else {\n          -1\n        }\n        let nl_h2 = ce(buf, hexpr, local_names, Array::length(local_names), harm_ld)\n        emit_end(buf)\n        Array::truncate(local_names, names_before_h)\n        agg_log_reset_above(ctx.gc_agg_local_slots, names_before_h)\n        gc_slot_log_reset_above(ctx.gc_bool_locals, names_before_h)\n        gc_slot_log_reset_above(ctx.gc_float_locals, names_before_h)\n        if nl_h2 > nl_h {\n          nl_h = nl_h2\n        }\n        nl_h\n      }\n    },\n    ELabeledArg(_, _, lval) => ce(buf, lval, local_names, next_local, ld),\n    EMap(mfields) => {\n      // #538: map literal -> the gc Map block layout used by MapBuilder/Map::*\n      // ([count@0][cap@4][key@8+i*16][val@16+i*16]); keys are string literals.\n      let mflen = Array::length(mfields)\n      let mcap = if mflen > 32 {\n        mflen\n      } else {\n        32\n      }\n      let malloc_size = 8 + mcap * 16\n      let mptr = next_local\n      Array::push(local_names, \"__maplit_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, mptr)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, malloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_memory_grow_check(buf)\n      emit_local_get(buf, mptr)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, mflen)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, mptr)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, mcap)\n      emit_i32_store(buf, 2, 4)\n      let mut mnl = next_local + 1\n      let mut mi = 0\n      while mi < mflen {\n        let (mkey, mval) = Array::get(mfields, mi)\n        let mk_idx = str_table_lookup(ctx.str_table.strs, mkey)\n        emit_local_get(buf, mptr)\n        emit_i32_wrap_i64(buf)\n        emit_str_ref(buf, Array::get(ctx.str_table.offsets, mk_idx), Array::get(ctx.str_table.lengths, mk_idx))\n        emit_i64_store(buf, 3, 8 + mi * 16)\n        emit_local_get(buf, mptr)\n        emit_i32_wrap_i64(buf)\n        mnl = ce(buf, mval, local_names, mnl, ld)\n        emit_i64_store(buf, 3, 16 + mi * 16)\n        mi = mi + 1\n      }\n      emit_local_get(buf, mptr)\n      mnl\n    },\n    EStringInterp(_) => throw(\"GC codegen: EStringInterp must be resolved before codegen (call resolve_interp_stmts first)\"),\n    _ => throw(String::concat(\"unsupported expression in gc codegen: tag \", __to_string(expr_tag(expr))))\n  }\n}\n\n//# Misc\n\nexport {\n  compile_expr_gc\n}\n")
}

let cli_adapter_source_143 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_call.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  canonical_builtin_name,\n  CompileCtxGc, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, find_func_stmt, find_local_slot, is_eident, ctor_table_index_of, resolve_func, resolve_local, struct_field_candidates, struct_field_dispatch_cases, double_to_string_expr\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_int, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_ecall_args, get_ecall_callee, get_eident_name, get_estring_value, str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_heap_memory_grow_check, emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./backend_builtins_array_alloc.vibe {\n  gc_gen_arr_len_body, gc_gen_arr_new_body\n}\n\nimport ./backend_builtins_array_get.vibe {\n  gc_gen_arr_get_body\n}\n\nimport ./backend_builtins_array_push.vibe {\n  gc_gen_arr_push_body\n}\n\nimport ./backend_builtins_array_set.vibe {\n  gc_gen_arr_set_body\n}\n\nimport ./backend_builtins_numeric.vibe {\n  gc_gen_double_to_int_body, gc_gen_identity_body, gc_gen_int_to_double_body\n}\n\nimport ./backend_builtins_print.vibe {\n  gc_gen_print_i64_body, gc_gen_print_str_body\n}\n\nimport ./backend_builtins_string.vibe {\n  gc_gen_str_concat_body, gc_gen_str_eq_body, gc_gen_str_len_body\n}\n\nimport ./backend_builtins_string_extra.vibe {\n  gc_gen_str_char_code_at_body, gc_gen_str_from_char_code_body, gc_gen_str_substring_body\n}\n\n//# Functions\n\n// #538: call a func-table-RESOLVED index. User functions (>= func_offset)\n// take a trailing closure-env i64 (callers pass 0); builtins/imports do not.\n// The flat bundle defines its own __to_string / String::join / eq etc., so a\n// resolve_func hit is NOT guaranteed to be a builtin -- every resolved call\n// must go through here or a user-shadowed builtin miscompiles with a missing\n// env argument (invalid wasm, \"expected i64 but nothing on stack\").\nfn emit_call_resolved(buf: Bytes, ctx: CompileCtxGc, fidx: Int) -> Unit {\n  if ctx.func_offset > 0 && fidx >= ctx.func_offset {\n    emit_i64_const(buf, 0)\n  } else {\n    ()\n  }\n  emit_call(buf, fidx)\n}\n\n// #538 P4.5: resolve to the BUILTIN entry even when the compiled program\n// defines a top-level function of the same name (the compiler bundle has its\n// own `__to_string(Int)`). Builtins are appended AFTER user functions in the\n// func table, so the LAST match is the builtin. Interpolation's `__to_string`\n// must always hit the runtime string-vs-int dispatch body — routing it to the\n// program's decimal-only version rendered interpolated Strings as numbers.\nfn gc_resolve_builtin_last(ft: FuncTable, name: String) -> Int {\n  let mut i = Array::length(ft.names) - 1\n  let mut found = -1\n  while i >= 0 {\n    if found < 0 && Array::get(ft.names, i) == name {\n      found = Array::get(ft.indices, i)\n      i = -1\n    } else {\n      i = i - 1\n    }\n  }\n  found\n}\n\n// Local mirror of backend_expr's gc_expr_is_floatish (backend_expr imports\n// this file, so importing it back would cycle — same precedent as the linear\n// lane's cc_expr_is_floatish mirror in expr/compile_call.vibe).\n// #1032: a bare ident resolves to its CURRENT slot (find_local_slot) before\n// checking ctx.gc_float_locals -- mirrors bc_expr_is_boolish below, so a\n// name reused with a non-float binding in a sibling scope is not\n// misclassified via its old, now-stale slot entry.\nfn bc_expr_is_floatish(e: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {\n  match e {\n    EFloat(_) => true,\n    EIdent(fname, _) => {\n      let slot = find_local_slot(local_names, fname)\n      slot >= 0 && array_contains_int(ctx.gc_float_locals, slot)\n    },\n    EBinOp(op, l, r) => (op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\") && (bc_expr_is_floatish(l, local_names, ctx) || bc_expr_is_floatish(r, local_names, ctx)),\n    EUnaryOp(op, x) => op == \"-\" && bc_expr_is_floatish(x, local_names, ctx),\n    ECall(fcallee, _, _) => match fcallee {\n      EIdent(cn, _) => cn == \"Int::to_double\" || cn == \"Double::from_i64_bits\" || cn == \"Float::to_double\" || cn == \"Double::to_float\" || cn == \"Int::to_float\",\n      _ => false\n    },\n    _ => false\n  }\n}\n\n// #1015: local mirror of backend_expr's gc_expr_is_boolish (same cycle\n// precedent as bc_expr_is_floatish above). Bool and Int share the same\n// gc-lane numeric representation, so this static shape-based classification\n// is the only way the `__to_string` dispatch below can route a Bool\n// argument to the \"true\"/\"false\" formatter instead of the generic runtime\n// dispatch (which would mis-render `true` as `\"1\"`).\nfn bc_expr_is_boolish(e: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {\n  match e {\n    EBool(_) => true,\n    EIdent(fname, _) => {\n      let slot = find_local_slot(local_names, fname)\n      slot >= 0 && array_contains_int(ctx.gc_bool_locals, slot)\n    },\n    EBinOp(op, _, _) => op == \"==\" || op == \"!=\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"&&\" || op == \"||\",\n    EUnaryOp(op, _) => op == \"!\",\n    _ => false\n  }\n}\n\nfn compile_call_gc(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } {\n  match callee {\n    EIdent(fname, _) => {\n      let ctor_lookup_idx = ctor_table_index_of(ctx.gc_ctor_table, fname)\n      if ctor_lookup_idx >= 0 {\n        let tag = Array::get(ctx.gc_ctor_table.tags, ctor_lookup_idx)\n        let fc = Array::get(ctx.gc_ctor_table.field_counts, ctor_lookup_idx)\n        let obj_size = 8 + fc * 8\n        let ptr_local = next_local\n        Array::push(local_names, \"__ctor_ptr\")\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        // #415: gc-lane heap bump must grow linear memory like the linear\n        // backend does -- without this any allocation past the initial page\n        // traps OOB (the gc smoke fixture only ever allocated a few bytes).\n        emit_heap_memory_grow_check(buf)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, fc)\n        emit_i32_store(buf, 2, 4)\n        let actual_args = if Array::length(args) == 1 {\n          match Array::get(args, 0) {\n            ERecord(_, rec_fields, _) => {\n              let rec find_sn: (Int) -> Int = (sni) -> {\n                if sni >= Array::length(ctx.gc_ctor_table.struct_names) {\n                  -1\n                }\n                else if Array::get(ctx.gc_ctor_table.struct_names, sni) == fname {\n                  sni\n                }\n                else find_sn(sni + 1)\n              }\n              let sn_idx = find_sn(0)\n              if sn_idx >= 0 {\n                let def_fnames = Array::get(ctx.gc_ctor_table.struct_field_names, sn_idx)\n                let ordered = array_empty()\n                let mut oi = 0\n                while oi < Array::length(def_fnames) {\n                  let target_name = Array::get(def_fnames, oi)\n                  let rec find_rf: (Int) -> Expr = (ri) -> {\n                    if ri >= Array::length(rec_fields) {\n                      EUnit\n                    }\n                    else {\n                      let (rfn, rfv) = Array::get(rec_fields, ri)\n                      if rfn == target_name {\n                        rfv\n                      }\n                      else find_rf(ri + 1)\n                    }\n                  }\n                  Array::push(ordered, find_rf(0))\n                  oi = oi + 1\n                }\n                ordered\n              } else {\n                args\n              }\n            },\n            _ => args\n          }\n        } else {\n          args\n        }\n        let mut nl_c = next_local + 1\n        let mut fi_c = 0\n        while fi_c < Array::length(actual_args) {\n          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ld)\n          let val_local = nl_c\n          Array::push(local_names, \"__ctor_val\")\n          emit_local_set(buf, val_local)\n          nl_c = nl_c + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + fi_c * 8)\n          fi_c = fi_c + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_c\n      }\n      else if fname == \"__slice\" {\n        let (ss_idx, _, _) = resolve_func(ctx.func_table, \"String::substring\")\n        let (bs_idx, _, _) = resolve_func(ctx.func_table, \"Bytes::slice\")\n        let (as_idx, _, _) = resolve_func(ctx.func_table, \"Array::slice\")\n        let obj_local = next_local\n        let start_local = next_local + 1\n        let end_local = next_local + 2\n        let ptr_local = next_local + 3\n        let cap_local = next_local + 4\n        Array::push(local_names, \"__slice_obj\")\n        Array::push(local_names, \"__slice_start\")\n        Array::push(local_names, \"__slice_end\")\n        Array::push(local_names, \"__slice_ptr\")\n        Array::push(local_names, \"__slice_cap\")\n        let mut nl = next_local + 5\n        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n        emit_local_set(buf, obj_local)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        emit_local_set(buf, start_local)\n        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\n        emit_local_set(buf, end_local)\n        emit_local_get(buf, obj_local)\n        emit_i64_const(buf, 32)\n        emit_i64_shr_s(buf)\n        emit_i64_eqz(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_load(buf, 2, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, cap_local)\n        emit_local_get(buf, cap_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 2147483647)\n        emit_i32_gt_u(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, start_local)\n        emit_local_get(buf, end_local)\n        emit_call_resolved(buf, ctx, bs_idx)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, start_local)\n        emit_local_get(buf, end_local)\n        emit_call_resolved(buf, ctx, as_idx)\n        emit_end(buf)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, start_local)\n        emit_local_get(buf, end_local)\n        emit_call_resolved(buf, ctx, ss_idx)\n        emit_end(buf)\n        nl\n      }\n      else if fname == \"__index\" {\n        let (sg_idx, _, _) = resolve_func(ctx.func_table, \"String::char_code_at\")\n        let (bg_idx, _, _) = resolve_func(ctx.func_table, \"Bytes::get\")\n        let (ag_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n        let obj_local = next_local\n        let idx_local = next_local + 1\n        let ptr_local = next_local + 2\n        let cap_local = next_local + 3\n        Array::push(local_names, \"__index_obj\")\n        Array::push(local_names, \"__index_idx\")\n        Array::push(local_names, \"__index_ptr\")\n        Array::push(local_names, \"__index_cap\")\n        let mut nl = next_local + 4\n        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n        emit_local_set(buf, obj_local)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        emit_local_set(buf, idx_local)\n        emit_local_get(buf, obj_local)\n        emit_i64_const(buf, 32)\n        emit_i64_shr_s(buf)\n        emit_i64_eqz(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_load(buf, 2, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, cap_local)\n        emit_local_get(buf, cap_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 2147483647)\n        emit_i32_gt_u(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, idx_local)\n        emit_call_resolved(buf, ctx, bg_idx)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, idx_local)\n        emit_call_resolved(buf, ctx, ag_idx)\n        emit_end(buf)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, idx_local)\n        emit_call_resolved(buf, ctx, sg_idx)\n        emit_end(buf)\n        nl\n      }\n      else if fname == \"__set_field\" {\n        let field = get_estring_value(Array::get(args, 1))\n        let fc = String::char_code_at(field, 0)\n        let is_numeric = fc >= 48 && fc <= 57\n        if is_numeric {\n          let mut vi = 0\n          let mut vp = 0\n          while vp < String::length(field) {\n            vi = vi * 10 + (String::char_code_at(field, vp) - 48)\n            vp = vp + 1\n          }\n          let mut nl = next_local\n          nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\n          emit_i64_store(buf, 3, vi * 8)\n          emit_i64_const(buf, 1)\n          nl\n        } else {\n          // #722: same struct-tag dispatch as the linear __set_field — a\n          // same-named `mut` field can live at a different slot in another\n          // struct, and the static first-match store would corrupt it.\n          let cands = struct_field_candidates(ctx.gc_ctor_table, field)\n          if Array::length(cands) == 0 {\n            throw(String::concat(\"unknown struct field: \", field))\n          }\n          let (_, idx0) = Array::get(cands, 0)\n          let dispatch = struct_field_dispatch_cases(cands)\n          if Array::length(dispatch) == 0 {\n            let mut nl = next_local\n            nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n            emit_i64_const(buf, -2)\n            emit_i64_and(buf)\n            emit_i32_wrap_i64(buf)\n            nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\n            emit_i64_store(buf, 3, 8 + idx0 * 8)\n            emit_i64_const(buf, 1)\n            nl\n          } else {\n            let mut nl = next_local\n            nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n            emit_i64_const(buf, -2)\n            emit_i64_and(buf)\n            let obj_l = nl\n            Array::push(local_names, \"__setf_obj\")\n            emit_local_set(buf, obj_l)\n            nl = ce(buf, Array::get(args, 2), local_names, nl + 1, ld)\n            let val_l = nl\n            Array::push(local_names, \"__setf_val\")\n            emit_local_set(buf, val_l)\n            let mut di = 0\n            while di < Array::length(dispatch) {\n              let (dtag, didx) = Array::get(dispatch, di)\n              emit_local_get(buf, obj_l)\n              emit_i32_wrap_i64(buf)\n              emit_i32_load(buf, 2, 0)\n              emit_i32_const(buf, dtag)\n              emit_i32_eq(buf)\n              emit_if_void(buf)\n              emit_local_get(buf, obj_l)\n              emit_i32_wrap_i64(buf)\n              emit_local_get(buf, val_l)\n              emit_i64_store(buf, 3, 8 + didx * 8)\n              emit_else(buf)\n              di = di + 1\n            }\n            emit_local_get(buf, obj_l)\n            emit_i32_wrap_i64(buf)\n            emit_local_get(buf, val_l)\n            emit_i64_store(buf, 3, 8 + idx0 * 8)\n            let mut de = 0\n            while de < Array::length(dispatch) {\n              emit_end(buf)\n              de = de + 1\n            }\n            emit_i64_const(buf, 1)\n            nl + 1\n          }\n        }\n      }\n      else if fname == \"__rec_field\" {\n        // #760(4): positional record field read `__rec_field(rec, i)` — emitted\n        // by the record-pattern destructure (parser) and the anonymous-record\n        // dot-access lowering (desugar_trait_dict). gc records are\n        // [tag@0][len@4][fields@8+i*8], the same shape as the linear backend, so\n        // the field load is `8 + i*8` after untagging the pointer. Mirrors the\n        // linear __rec_field in compile_call.vibe.\n        let field_idx = match Array::get(args, 1) {\n          EInt(n) => n,\n          _ => throw(\"__rec_field: index must be an int literal\")\n        }\n        let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + field_idx * 8)\n        nl\n      }\n      else if fname == \"__len\" {\n        let (sl_idx, _, _) = resolve_func(ctx.func_table, \"String::length\")\n        let (bl_idx, _, _) = resolve_func(ctx.func_table, \"Bytes::length\")\n        let (al_idx, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n        let obj_local = next_local\n        let ptr_local = next_local + 1\n        let cap_local = next_local + 2\n        Array::push(local_names, \"__len_obj\")\n        Array::push(local_names, \"__len_ptr\")\n        Array::push(local_names, \"__len_cap\")\n        let mut nl = next_local + 3\n        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n        emit_local_set(buf, obj_local)\n        emit_local_get(buf, obj_local)\n        emit_i64_const(buf, 32)\n        emit_i64_shr_s(buf)\n        emit_i64_eqz(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_load(buf, 2, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, cap_local)\n        emit_local_get(buf, cap_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 2147483647)\n        emit_i32_gt_u(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_call_resolved(buf, ctx, bl_idx)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_call_resolved(buf, ctx, al_idx)\n        emit_end(buf)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_call_resolved(buf, ctx, sl_idx)\n        emit_end(buf)\n        nl\n      }\n      else if fname == \"Array::slice\" {\n        let (an_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n        let (ap_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n        let (ag_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n        let arr_local = next_local\n        let start_local = next_local + 1\n        let end_local = next_local + 2\n        let new_arr_local = next_local + 3\n        let i_local = next_local + 4\n        Array::push(local_names, \"__slice_arr\")\n        Array::push(local_names, \"__slice_start\")\n        Array::push(local_names, \"__slice_end\")\n        Array::push(local_names, \"__slice_new\")\n        Array::push(local_names, \"__slice_i\")\n        let mut nl = next_local + 5\n        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n        emit_local_set(buf, arr_local)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        emit_local_set(buf, start_local)\n        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\n        emit_local_set(buf, end_local)\n        emit_call_resolved(buf,