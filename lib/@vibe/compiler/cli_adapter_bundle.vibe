me: String) -> Option[Type] {\n  match lookup_http_request_header(name) {\n    Some(t) => Some(t),\n    None => lookup_http_respond(name)\n  }\n}\n\nfn lookup_http_request_method(name: String) -> Option[Type] {\n  if name == \"Http::request_method\" {\n    Some(CtFn(net_one_param(CtUnknown), CtString, Some(\"HttpIncoming\")))\n  }\n  else None\n}\n\nfn lookup_net_group_c(name: String) -> Option[Type] {\n  match lookup_http_close(name) {\n    Some(t) => Some(t),\n    None => match lookup_http_listen(name) {\n      Some(t) => Some(t),\n      None => match lookup_http_accept(name) {\n        Some(t) => Some(t),\n        None => lookup_http_request_method(name)\n      }\n    }\n  }\n}\n\nfn lookup_http_response_header(name: String) -> Option[Type] {\n  if name == \"Http::response_header\" {\n    Some(CtFn(net_two_params(CtUnknown, CtString), CtString, Some(\"HttpClient\")))\n  }\n  else None\n}\n\nfn lookup_http_response_status(name: String) -> Option[Type] {\n  if name == \"Http::response_status\" {\n    Some(CtFn(net_one_param(CtUnknown), CtInt, Some(\"HttpClient\")))\n  }\n  else None\n}\n\nfn lookup_net_group_b(name: String) -> Option[Type] {\n  match lookup_http_request(name) {\n    Some(t) => Some(t),\n    None => match lookup_http_response_status(name) {\n      Some(t) => Some(t),\n      None => match lookup_http_response_header(name) {\n        Some(t) => Some(t),\n        None => lookup_http_response_body(name)\n      }\n    }\n  }\n}\n\n// Socket::tcp_connect/tcp_read/tcp_write/tcp_close used to be declared here\n// (as lookup_net_group_a) but now live in builtin_registry.vibe, which\n// lookup_registry_builtin (checker/builtins.vibe) consults before this\n// function is ever reached -- see that registry's row-header comment.\nexport fn lookup_net(name: String) -> Option[Type] {\n  match lookup_net_group_b(name) {\n    Some(t) => Some(t),\n    None => match lookup_net_group_c(name) {\n      Some(t) => Some(t),\n      None => lookup_net_group_d(name)\n    }\n  