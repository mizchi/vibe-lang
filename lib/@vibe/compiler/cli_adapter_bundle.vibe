 at codegen\n      // with \"undefined variable (local): println @call\". When no SOURCE\n      // definition is merged (the cc_ft_has guard keeps @vibe/io's println\n      // and user shadows winning), lower directly onto the Stdout host\n      // imports on BOTH lanes: the packed-string arg passes through to\n      // write_stream unchanged (same in both modes), and println appends a\n      // RAW newline byte via write_char -- a direct emit_call to the import\n      // index bypasses each lane's arg conversion (the RC/raw ABI hands the\n      // host raw ints anyway, and the non-RC lane's untagging lives in the\n      // generic call path we are NOT going through), so the raw byte value\n      // is correct on BOTH lanes. Import gating in linked_compile.vibe\n      // includes println/print for exactly this path.\n      let (ws_idx, _, _) = resolve_func(ctx.func_table, \"Stdout::write_stream\")\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_call(buf, ws_idx)\n      if fname == \"println\" {\n        let (wc_idx, _, _) = resolve_func(ctx.func_table, \"Stdout::write_char\")\n        emit_i64_const(buf, 10)\n        emit_call(buf, wc_idx)\n      } else {\n        ()\n      }\n      emit_i64_const(buf, 0)\n      nl\n    }\n    else if fname == \"__rec_field\" {\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let idx_expr = Array::get(args, 1)\n      let field_idx = get_eint_value(idx_expr)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + field_idx * 8)\n      nl\n    }\n    else if fname == \"__len\" {\n      let (sl_idx, _, _) = resolve_func(ctx.func_table, \"String::length\")\n      let (bl_idx, _, _) = resolve_func(ctx.func_table, \"Bytes::length\")\n      let (al_idx, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n      let obj_local = next_local\n      let ptr_local = next_local + 1\n      let cap_local = next_local + 2\n      Array::push(local_names, \"__len_obj\")\n      Array::push(local_names, \"__len_ptr\")\n      Array::push(local_names, \"__len_cap\")\n      let mut nl = next_local + 3\n      nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)\n      emit_local_set(buf, obj_local)\n      emit_local_get(buf, obj_local)\n      emit_i64_const(buf, 32)\n      emit_i64_shr_s(buf)\n      emit_i64_eqz(buf)\n      emit_if_i64(buf)\n      emit_local_get(buf, obj_local)\n      emit_local_set(buf, ptr_local)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_load(buf, 2, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, cap_local)\n      emit_local_get(buf, cap_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 2147483647)\n      emit_i32_gt_u(buf)\n      emit_if_i64(buf)\n      emit_local_get(buf, obj_local)\n      emit_call(buf, bl_idx)\n      emit_else(buf)\n      emit_local_get(buf, obj_local)\n      emit_call(buf, al_idx)\n      emit_end(buf)\n      emit_else(buf)\n      emit_local_get(buf, obj_local)\n      emit_call(buf, sl_idx)\n      emit_end(buf)\n      nl\n    }\n    else if fname == \"__index\" {\n      let (sg_idx, _, _) = resolve_func(ctx.func_table, \"String::char_code_at\")\n      let (bg_idx, _, _) = resolve_func(ctx.func_table, \"Bytes::get\")\n      let (ag_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n      let obj_local = next_local\n      let idx_local = next_local + 1\n      let ptr_local = next_local + 2\n      let cap_local = next_local + 3\n      Array::push(local_names, \"__index_obj\")\n      Array::push(local_names, \"__index_idx\")\n      Array::push(local_names, \"__index_ptr\")\n      Array::push(local_names, \"__index_cap\")\n      let mut nl = next_local + 4\n      nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)\n      emit_local_set(buf, obj_local)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_local_set(buf, idx_local)\n      emit_local_get(buf, obj_local)\n      emit_i64_const(buf, 32)\n      emit_i64_shr_s(buf)\n      emit_i64_eqz(buf)\n      emit_if_i64(buf)\n      emit_local_get(buf, obj_local)\n      emit_local_set(buf, ptr_local)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_load(buf, 2, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, cap_local)\n      emit_local_get(buf, cap_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 2147483647)\n      emit_i32_gt_u(buf)\n      emit_if_i64(buf)\n      emit_local_get(buf, obj_local)\n      emit_local_get(buf, idx_local)\n      emit_call(buf, bg_idx)\n      emit_else(buf)\n      emit_local_get(buf, obj_local)\n      emit_local_get(buf, idx_local)\n      emit_call(buf, ag_idx)\n      emit_end(buf)\n      emit_else(buf)\n      emit_local_get(buf, obj_local)\n      emit_local_get(buf, idx_local)\n      emit_call(buf, sg_idx)\n      emit_end(buf)\n      nl\n    }\n    else if fname == \"__set_field\" {\n      let field = get_estring_value(Array::get(args, 1))\n      let fc = String::char_code_at(field, 0)\n      let is_numeric = fc >= 48 && fc <= 57\n      if is_numeric {\n        let mut vi = 0\n        let mut vp = 0\n        while vp < String::length(field) {\n          vi = vi * 10 + (String::char_code_at(field, vp) - 48)\n          vp = vp + 1\n        }\n        let mut nl = next_local\n        nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)\n        emit_i64_store(buf, 3, vi * 8)\n        emit_i64_const(buf, 0)\n        nl\n      } else {\n        // #722: same struct-tag dispatch as the EDot read path\n        // (compile_expr_tail4.vibe) — a same-named `mut` field can live at a\n        // different slot in another struct, and the static first-match store\n        // would corrupt the wrong slot.\n        let cands = struct_field_candidates(ctx.ctor_table, field)\n        if Array::length(cands) == 0 {\n          throw(String::concat(\"unknown struct field: \", field))\n        }\n        let (_, idx0) = Array::get(cands, 0)\n        let dispatch = struct_field_dispatch_cases(cands)\n        if Array::length(dispatch) == 0 {\n          let mut nl = next_local\n          nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)\n          emit_i64_store(buf, 3, 8 + idx0 * 8)\n          emit_i64_const(buf, 0)\n          nl\n        } else {\n          let mut nl = next_local\n          nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          let obj_l = nl\n          Array::push(local_names, \"__setf_obj\")\n          emit_local_set(buf, obj_l)\n          nl = ce(buf, Array::get(args, 2), local_names, nl + 1, ctx, ld)\n          let val_l = nl\n          Array::push(local_names, \"__setf_val\")\n          emit_local_set(buf, val_l)\n          let mut di = 0\n          while di < Array::length(dispatch) {\n            let (dtag, didx) = Array::get(dispatch, di)\n            emit_local_get(buf, obj_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_load(buf, 2, 0)\n            emit_i32_const(buf, dtag)\n            emit_i32_eq(buf)\n            emit_if_void(buf)\n            emit_local_get(buf, obj_l)\n            emit_i32_wrap_i64(buf)\n            emit_local_get(buf, val_l)\n            emit_i64_store(buf, 3, 8 + didx * 8)\n            emit_else(buf)\n            di = di + 1\n          }\n          emit_local_get(buf, obj_l)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_l)\n          emit_i64_store(buf, 3, 8 + idx0 * 8)\n          let mut de = 0\n          while de < Array::length(dispatch) {\n            emit_end(buf)\n            de = de + 1\n          }\n          emit_i64_const(buf, 0)\n          nl + 1\n        }\n      }\n    }\n    // #775: FixedArray rides on the linear-memory Array exactly like the gc\n    // backend does (gc/backend_call.vibe's FixedArray::* cases) — these were\n    // registered in builtin_registry with in_linear_table=false, in_gc_table=\n    // true, but (unlike println/map_has/etc, whose linear lane is served by a\n    // real prelude source function) no linear codegen case existed at all, so\n    // any linear-backend caller of FixedArray::make/length/get/set/\n    // unsafe_set/blit fell through to the generic call path, which treated\n    // the qualified name as a local variable and threw \"undefined variable\n    // (local): FixedArray::make @call\" (5 optimizer/zlib test files, #775).\n    // length/get/set/unsafe_set are pure renames onto the existing\n    // Array::length/get/set builtins (identical arity), re-lowered through\n    // `ce` so they get the same RC/perceus treatment as ordinary source.\n    // make/blit are synthesized as source-shaped `let`/`while` ASTs (mirrors\n    // String::to_bytes / Stream::to_string above) rather than hand-emitted\n    // wasm, so the perceus loop-borrow dup logic (EWhile's population of\n    // ctx.loop_borrowed_names, compile_expr_tail2.vibe:287) correctly dups\n    // the repeatedly-pushed `init` value across FixedArray::make's loop\n    // iterations under RC — a hand-emitted raw loop here would silently\n    // double-free `init` on the second push.\n    // #835: Int64Array::make/length/get/set piggyback on the exact same\n    // Array aliasing (Array[Int] already stores the full tagged Int per cell\n    // in both backends, so there is no truncation to work around here the\n    // way the retired MoonBit host needed a dedicated i64-cell object).\n    else if fname == \"FixedArray::length\" || fname == \"Int64Array::length\" {\n      ce(buf, ECall(EIdent(\"Array::length\", -1), args, -1), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"FixedArray::get\" || fname == \"Int64Array::get\" {\n      ce(buf, ECall(EIdent(\"Array::get\", -1), args, -1), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"FixedArray::set\" || fname == \"FixedArray::unsafe_set\" || fname == \"Int64Array::set\" {\n      ce(buf, ECall(EIdent(\"Array::set\", -1), args, -1), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"FixedArray::make\" || fname == \"Int64Array::make\" {\n      let n_expr = Array::get(args, 0)\n      let init_expr = Array::get(args, 1)\n      let loop_body = ESeq(ECall(EIdent(\"Array::push\", -1), [\n        EIdent(\"__fam_arr\", -1),\n        EIdent(\"__fam_init\", -1)\n      ], -1), EAssign(\"__fam_i\", EBinOp(\"+\", EIdent(\"__fam_i\", -1), EInt(1)), EUnit))\n      let synth = ELet(\"__fam_n\", n_expr, ELet(\"__fam_init\", init_expr, ELetMut(\"__fam_arr\", EArray(array_empty()), ELetMut(\"__fam_i\", EInt(0), ESeq(EWhile(EBinOp(\"<\", EIdent(\"__fam_i\", -1), EIdent(\"__fam_n\", -1)), loop_body), EIdent(\"__fam_arr\", -1)), -1), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if fname == \"FixedArray::blit\" {\n      // blit(dst, dst_off, src, src_off, len): element-by-element copy, same\n      // semantics as gc/backend_call.vibe's FixedArray::blit.\n      let dst_expr = Array::get(args, 0)\n      let doff_expr = Array::get(args, 1)\n      let src_expr = Array::get(args, 2)\n      let soff_expr = Array::get(args, 3)\n      let len_expr = Array::get(args, 4)\n      let loop_body = ESeq(ECall(EIdent(\"Array::set\", -1), [\n        EIdent(\"__fb_dst\", -1),\n        EBinOp(\"+\", EIdent(\"__fb_doff\", -1), EIdent(\"__fb_i\", -1)),\n        ECall(EIdent(\"Array::get\", -1), [\n          EIdent(\"__fb_src\", -1),\n          EBinOp(\"+\", EIdent(\"__fb_soff\", -1), EIdent(\"__fb_i\", -1))\n        ], -1)\n      ], -1), EAssign(\"__fb_i\", EBinOp(\"+\", EIdent(\"__fb_i\", -1), EInt(1)), EUnit))\n      let synth = ELet(\"__fb_dst\", dst_expr, ELet(\"__fb_doff\", doff_expr, ELet(\"__fb_src\", src_expr, ELet(\"__fb_soff\", soff_expr, ELet(\"__fb_len\", len_expr, ELetMut(\"__fb_i\", EInt(0), ESeq(EWhile(EBinOp(\"<\", EIdent(\"__fb_i\", -1), EIdent(\"__fb_len\", -1)), loop_body), EUnit), -1), -1), -1), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Bytes::blit\" {\n      // blit(dst, src, start, end): append src[start..end) to dst (half-open\n      // range), matching lib/@vibe/prelude/bytes_test.vibe's expectation and the\n      // gc backend's gen_bytes_blit_body. gc-only in the builtin registry; this\n      // synthesizes the loop for the linear backend (same technique as\n      // FixedArray::make/blit above) so `Bytes::push` handles the buffer growth\n      // and RC bookkeeping instead of hand-emitted wasm.\n      let dst_expr = Array::get(args, 0)\n      let src_expr = Array::get(args, 1)\n      let start_expr = Array::get(args, 2)\n      let end_expr = Array::get(args, 3)\n      let loop_body = ESeq(ECall(EIdent(\"Bytes::push\", -1), [\n        EIdent(\"__bb_dst\", -1),\n        ECall(EIdent(\"Bytes::get\", -1), [\n          EIdent(\"__bb_src\", -1),\n          EIdent(\"__bb_i\", -1)\n        ], -1)\n      ], -1), EAssign(\"__bb_i\", EBinOp(\"+\", EIdent(\"__bb_i\", -1), EInt(1)), EUnit))\n      let synth = ELet(\"__bb_dst\", dst_expr, ELet(\"__bb_src\", src_expr, ELet(\"__bb_start\", start_expr, ELet(\"__bb_end\", end_expr, ELetMut(\"__bb_i\", EIdent(\"__bb_start\", -1), ESeq(EWhile(EBinOp(\"<\", EIdent(\"__bb_i\", -1), EIdent(\"__bb_end\", -1)), loop_body), EUnit), -1), -1), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Bytes::fill\" {\n      // fill(dst, value, count): append `count` copies of `value` to dst.\n      // gc-only in the builtin registry; synthesized for the linear backend\n      // via Bytes::push (same technique as Bytes::blit / FixedArray::make).\n      let dst_expr = Array::get(args, 0)\n      let val_expr = Array::get(args, 1)\n      let count_expr = Array::get(args, 2)\n      let loop_body = ESeq(ECall(EIdent(\"Bytes::push\", -1), [\n        EIdent(\"__bf2_dst\", -1),\n        EIdent(\"__bf2_val\", -1)\n      ], -1), EAssign(\"__bf2_i\", EBinOp(\"+\", EIdent(\"__bf2_i\", -1), EInt(1)), EUnit))\n      let synth = ELet(\"__bf2_dst\", dst_expr, ELet(\"__bf2_val\", val_expr, ELet(\"__bf2_count\", count_expr, ELetMut(\"__bf2_i\", EInt(0), ESeq(EWhile(EBinOp(\"<\", EIdent(\"__bf2_i\", -1), EIdent(\"__bf2_count\", -1)), loop_body), EUnit), -1), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Bytes::new\" && Array::length(args) == 1 {\n      // Bytes::new(n): length-n zero-filled buffer (MoonBit semantics). The\n      // runtime bytes_new takes no operands, so the generic path used to emit\n      // the argument and then call it anyway — the operand stayed stranded on\n      // the value stack and the whole module failed validation at\n      // instantiation time. Synthesize new() + a zero-push loop instead.\n      let n_expr = Array::get(args, 0)\n      let loop_body = ESeq(ECall(EIdent(\"Bytes::push\", -1), [\n        EIdent(\"__bn_b\", -1),\n        EInt(0)\n      ], -1), EAssign(\"__bn_i\", EBinOp(\"+\", EIdent(\"__bn_i\", -1), EInt(1)), EUnit))\n      let synth = ELet(\"__bn_n\", n_expr, ELet(\"__bn_b\", ECall(EIdent(\"Bytes::new\", -1), array_empty(), -1), ELetMut(\"__bn_i\", EInt(0), ESeq(EWhile(EBinOp(\"<\", EIdent(\"__bn_i\", -1), EIdent(\"__bn_n\", -1)), loop_body), EIdent(\"__bn_b\", -1)), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else {\n      // #875: a name that is BOTH a func_table entry (some unrelated\n      // top-level/entry-file function reachable in this merged program) AND a\n      // properly in-scope LOCAL binding (e.g. a nested `let rec NAME = ...`\n      // closure) must resolve to the LOCAL — lexical scoping always wins.\n      // Before this guard, `fn_idx_in_list >= 0` alone gated the direct-call\n      // path below, so a local closure whose bare name happened to collide\n      // with some other reachable function (most commonly the compile\n      // entry file's own top-level helpers, which build_export_rename_plan\n      // deliberately leaves unqualified) was miscompiled into a direct call\n      // to that unrelated function instead of a closure_resolve/call_indirect\n      // to the actual in-scope value — a wasm-validation-time arity mismatch\n      // with no compile-time diagnostic. See #875.\n      if fn_idx_in_list >= 0 && local_idx_hint < 0 {\n        let fidx = Array::get(ctx.func_table.indices, fn_idx_in_list)\n        let has_ret = Array::get(ctx.func_table.returns, fn_idx_in_list)\n        let needs_env = Array::get(ctx.func_table.needs_env, fn_idx_in_list)\n        let mut nl = next_local\n        let mut ci = 0\n        while ci < Array::length(args) {\n          let carg = Array::get(args, ci)\n          nl = ce(buf, carg, local_names, nl, ctx, ld)\n          // Retain a heap projection passed to an OWNING parameter (the callee\n          // drops its params). Skip arg0 of a borrow-arg0 builtin (Array::get /\n          // length / push / set, etc.): it does NOT drop that argument, so a dup\n          // there would never be matched and would leak one reference per call\n          // (#704). Mirrors `is_borrow_arg0_call` in perceus/index.vibe.\n          // ADR-0092 borrow-inference slice 1: user fns with a borrowed\n          // arg0 ABI get the same call-site treatment as the builtin list.\n          let borrows_this = ci == 0 && (cc_is_borrow_arg0_call(fname) || array_contains_str(ctx.borrow_arg0_user, fname))\n          let is_loop_borrow1 = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx) && !borrows_this\n          if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow1) && !borrows_this {\n            // #706 leak follow-up: this dup's matching consume is INSIDE the loop\n            // (the callee drops its own copy each iteration) and never touches\n            // the binding's own slot-held reference, so the function epilogue\n            // must emit one extra compensating drop for it. Log only the\n            // loop-borrow trigger — the projection/borrow-ret-call cases already\n            // have correct accounting via the existing rc_drops mechanism.\n            if is_loop_borrow1 {\n              Array::push(ctx.loop_consumed_names, get_eident_name(carg))\n            } else {\n              ()\n            }\n            Array::push(local_names, \"__argdup\")\n            emit_local_tee(buf, nl)\n            emit_rc_dup_guarded(buf, nl, ctx.rc_shadow)\n            nl = nl + 1\n          } else {\n            ()\n          }\n          ci = ci + 1\n        }\n        if needs_env {\n          emit_i64_const(buf, 0)\n        }\n        emit_call(buf, fidx)\n        if has_ret == 0 {\n          emit_i64_const(buf, 0)\n        }\n        nl\n      } else {\n        let local_idx2 = if local_idx_hint >= 0 {\n          local_idx_hint\n        } else {\n          resolve_local(local_names, fname, \"call\")\n        }\n        let num_args = Array::length(args)\n        let fn_val_local = next_local\n        let slot_local = next_local + 1\n        let env_local = next_local + 2\n        let mut nl = next_local + 3\n        Array::push(local_names, \"__fn_val\")\n        Array::push(local_names, \"__slot\")\n        Array::push(local_names, \"__env\")\n        emit_local_get(buf, local_idx2)\n        emit_local_set(buf, fn_val_local)\n        emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n        let mut ci = 0\n        while ci < num_args {\n          let carg = Array::get(args, ci)\n          nl = ce(buf, carg, local_names, nl, ctx, ld)\n          // #706: a closure consumes its args; dup a loop-borrowed owning arg so\n          // it survives the back-edge (mirrors the direct-call path above).\n          // #708: also retain a projection / borrow-returning-call arg here, same\n          // as the direct-call path (line ~2607) already does -- a closure param\n          // is dropped by the callee's own exit epilogue exactly like a direct\n          // call's owning param, so a bare borrowed view passed through (e.g. the\n          // recursive-descent parser's `parse_recur(tokens, ...)` family calling\n          // through a `let rec`-captured closure value) was double-freed the same\n          // way #704/#706's direct-call cases were, just one call-shape over.\n          let is_loop_borrow2 = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx)\n          if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow2) {\n            // #706 leak follow-up: log so the epilogue compensates (see above).\n            if is_loop_borrow2 {\n              Array::push(ctx.loop_consumed_names, get_eident_name(carg))\n            } else {\n              ()\n            }\n            Array::push(local_names, \"__argdup\")\n            emit_local_tee(buf, nl)\n            emit_rc_dup_guarded(buf, nl, ctx.rc_shadow)\n            nl = nl + 1\n          } else {\n            ()\n          }\n          ci = ci + 1\n        }\n        emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)\n        nl\n      }\n    }\n  } else {\n    let num_args = Array::length(args)\n    let fn_val_local = next_local\n    let slot_local = next_local + 1\n    let env_local = next_local + 2\n    let mut nl = next_local + 3\n    Array::push(local_names, \"__fn_val\")\n    Array::push(local_names, \"__slot\")\n    Array::push(local_names, \"__env\")\n    nl = ce(buf, callee, local_names, nl, ctx, ld)\n    emit_local_set(buf, fn_val_local)\n    emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n    let mut ci = 0\n    while ci < num_args {\n      let carg = Array::get(args, ci)\n      nl = ce(buf, carg, local_names, nl, ctx, ld)\n      // #706: dup a loop-borrowed owning arg passed to a closure call.\n      // #708: also retain a projection / borrow-returning-call arg (see the\n      // matching comment on the other closure-call path above).\n      let is_loop_borrow3 = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx)\n      if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow3) {\n        // #706 leak follow-up: log so the epilogue compensates (see above).\n        if is_loop_borrow3 {\n          Array::push(ctx.loop_consumed_names, get_eident_name(carg))\n        } else {\n          ()\n        }\n        Array::push(local_names, \"__argdup\")\n        emit_local_tee(buf, nl)\n        emit_rc_dup_guarded(buf, nl, ctx.rc_shadow)\n        nl = nl + 1\n      } else {\n        ()\n      }\n      ci = ci + 1\n    }\n    emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)\n    nl\n  }\n}\n")
}

let cli_adapter_source_93 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/compile_expr_tail7.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_str_ref,\n  expr_tag,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  is_efn,\n  is_eident,\n  is_etuple,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  lookup_ctor,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\nimport ./compile_call.vibe {\n  compile_call\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\nexport fn compile_expr_tail7(buf: Bytes, parts: Array[String], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let make_concat_expr: (Expr, Expr) -> Expr = (lhs, rhs) -> {\n    let args = ArrayBuilder::freeze(ArrayBuilder::new())\n    Array::push(args, lhs)\n    Array::push(args, rhs)\n    ECall(EIdent(\"String::concat\", -1), args, -1)\n  }\n  let make_to_string_expr: (String) -> Expr = (name) -> {\n    let args = ArrayBuilder::freeze(ArrayBuilder::new())\n    Array::push(args, EIdent(name, -1))\n    ECall(EIdent(\"__to_string\", -1), args, -1)\n  }\n  let plen = Array::length(parts)\n  let mut result = EString(\"\")\n  let mut has_val = false\n  let mut si2 = 0\n  while si2 < plen {\n    let part = Array::get(parts, si2)\n    if si2 % 2 == 0 {\n      if String::length(part) > 0 {\n        if has_val {\n          result = make_concat_expr(result, EString(part))\n        } else {\n          result = EString(part)\n          has_val = true\n        }\n      }\n    } else {\n      let ep = make_to_string_expr(part)\n      if has_val {\n        result = make_concat_expr(result, ep)\n      } else {\n        result = ep\n        has_val = true\n      }\n    }\n    si2 = si2 + 1\n  }\n  compile_expr(buf, result, local_names, next_local, ctx, ld)\n}\n")
}

let cli_adapter_source_94 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/compile_expr_tail6.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  effect_name_to_tag,\n  effect_op_declared_arity,\n  effect_op_index,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_rc_dup_guarded,\n  emit_str_ref,\n  expr_tag,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  is_efn,\n  is_eident,\n  is_etuple,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  lookup_ctor,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\nimport ./compile_call.vibe {\n  compile_call\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\nexport fn compile_expr_tail6(buf: Bytes, body: Expr, arms: Array[(Pat, Expr)], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  if Array::length(arms) > 0 {\n    let (catch_pat, fallback_expr) = Array::get(arms, 0)\n    let is_error = is_pctor(catch_pat) && get_pctor_name(catch_pat) == \"Error::Throw\"\n    // ADR-0076 追記34 V2: the replay frontier is gone, so this function\n    // lowers ONLY `with Error` handles. Every reachable non-Error handle\n    // has already been consumed upstream (inline_direct_performs, scps,\n    // evidence_dict_pass -- whose live-handle check hard-errors on any\n    // survivor); the only non-Error handle that can still get here sits in\n    // a provably-DEAD function (dce keep flag false) that codegen must\n    // still emit, so it lowers to a single `unreachable` (valid in an i64\n    // expression position via stack polymorphism, and by construction\n    // never executed).\n    if !is_error {\n      bytebuf_push(buf, 0)\n      next_local\n    } else {\n      let catch_tag = 2\n      emit_block_i64(buf)\n      emit_loop_void(buf)\n      emit_block_i64(buf)\n      bytebuf_push(buf, 31)\n      bytebuf_push(buf, 126)\n      bytebuf_push(buf, 1)\n      bytebuf_push(buf, 0)\n      bytebuf_push(buf, catch_tag)\n      bytebuf_push(buf, 0)\n      // #965: names the handled BODY binds must not stay resolvable while the\n      // HANDLER arms compile below. resolve_local matches last-wins, so a body\n      // `let n = ...` shadowing an outer `n` made an arm's `n` read the body's\n      // (never-assigned-on-throw) wasm local — parse_program_recovering's\n      // resync scan read tokens-total `n` as the parse_stmt tuple's inner `n`\n      // (always 0 on the throw path) and went inert. match arms already\n      // restore scope (compile_match truncates); handle alone leaked. The RC\n      // lane never hit this because uniquify_shadowed_bindings (#712) α-renames\n      // shadows first — the bump lane (VIBE_RC=0, which builds the compiler\n      // itself) does not run it. MASK the body's names to an unresolvable\n      // sentinel instead of truncating: the wasm local INDICES must stay\n      // allocated (#665 — truncation would let sibling arms reuse live slots).\n      // ref_cell_names is name-keyed too: a captured `let mut n` in the body\n      // pushes \"n\" there, and with the names masked below an arm's `n` would\n      // resolve to the OUTER scalar slot while still being loaded through the\n      // ref-cell path (garbage). Unlike local slots, these entries carry no\n      // index, so plain truncation is the correct scope restore.\n      let body_names_start = Array::length(local_names)\n      let body_ref_cells_start = Array::length(ctx.ref_cell_names)\n      let _nl1 = compile_expr(buf, body, local_names, next_local, ctx, ld)\n      let mut mask_i = body_names_start\n      while mask_i < Array::length(local_names) {\n        Array::set(local_names, mask_i, \"\")\n        mask_i = mask_i + 1\n      }\n      Array::truncate(ctx.ref_cell_names, body_ref_cells_start)\n      emit_end(buf)\n      emit_br(buf, 2)\n      emit_end(buf)\n      if is_pctor(catch_pat) {\n        let cargs = get_pctor_args(catch_pat)\n        let decl_arity = effect_op_declared_arity(ctx.effect_op_keys, ctx.effect_op_arities, get_pctor_name(catch_pat))\n        if decl_arity > 1 {\n          let ptr_l = Array::length(local_names)\n          emit_local_set(buf, ptr_l)\n          Array::push(local_names, \"__eff_payload\")\n          let ncargs = Array::length(cargs)\n          let mut ci = 0\n          while ci < decl_arity {\n            if ci < ncargs {\n              let cp = Array::get(cargs, ci)\n              if is_pbind(cp) {\n                let pname = get_pbind_name(cp)\n                let fl = Array::length(local_names)\n                emit_local_get(buf, ptr_l)\n                if ctx.enable_rc {\n                  emit_i64_const(buf, -2)\n                  emit_i64_and(buf)\n                } else {\n                  ()\n                }\n                emit_i32_wrap_i64(buf)\n                emit_i64_load(buf, 3, if ctx.enable_rc {\n                  8 + ci * 8\n                } else {\n                  ci * 8\n                })\n                emit_local_set(buf, fl)\n                Array::push(local_names, pname)\n                if ctx.enable_rc {\n                  emit_rc_dup_guarded(buf, fl, ctx.rc_shadow)\n                } else {\n                  ()\n                }\n              } else if is_pwild(cp) {\n                ()\n              } else {\n                throw(\"handle: only simple bindings or '_' are supported in multi-argument effect op patterns (see #548)\")\n              }\n            } else {\n              ()\n            }\n            ci = ci + 1\n          }\n          if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {\n            emit_local_get(buf, ptr_l)\n            emit_call(buf, ctx.rc_drop_func_idx)\n          } else {\n            ()\n          }\n        } else if Array::length(cargs) > 0 && is_pbind(Array::get(cargs, 0)) {\n          let pname = get_pbind_name(Array::get(cargs, 0))\n          let bl = Array::length(local_names)\n          emit_local_set(buf, bl)\n          Array::push(local_names, pname)\n        } else {\n          emit_drop(buf)\n        }\n      } else if is_pbind(catch_pat) {\n        let pname = get_pbind_name(catch_pat)\n        let bl = Array::length(local_names)\n        emit_local_set(buf, bl)\n        Array::push(local_names, pname)\n      } else {\n        emit_drop(buf)\n      }\n      emit_block_i64(buf)\n      bytebuf_push(buf, 31)\n      bytebuf_push(buf, 126)\n      bytebuf_push(buf, 1)\n      bytebuf_push(buf, 0)\n      bytebuf_push(buf, 1)\n      bytebuf_push(buf, 0)\n      let nl2 = compile_expr(buf, fallback_expr, local_names, Array::length(local_names), ctx, ld)\n      emit_end(buf)\n      emit_br(buf, 2)\n      emit_end(buf)\n      emit_drop(buf)\n      emit_br(buf, 0)\n      emit_end(buf)\n      bytebuf_push(buf, 0)\n      emit_end(buf)\n      // #965: retire everything this handle introduced (payload binds,\n      // __eff_payload temps, arm-body lets) before compilation continues\n      // past the handle expression — same last-wins leak one level out.\n      // Indices stay allocated (no truncate, #665).\n      let mut post_mask_i = body_names_start\n      while post_mask_i < Array::length(local_names) {\n        Array::set(local_names, post_mask_i, \"\")\n        post_mask_i = post_mask_i + 1\n      }\n      Array::truncate(ctx.ref_cell_names, body_ref_cells_start)\n      nl2\n    }\n  } else {\n    compile_expr(buf, body, local_names, next_local, ctx, ld)\n  }\n}\n")
}

