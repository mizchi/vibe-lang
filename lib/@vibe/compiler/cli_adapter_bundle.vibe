"//# Imports\n\nimport @vibe/compiler/core {\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push2,\n  bytebuf_push9,\n  bytebuf_push_opcode_s64,\n  bytebuf_push_opcode_u32,\n  bytebuf_push_opcode_u32_u32,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  leb128_encode_u32\n}\n\nimport ./sections.vibe {\n  emit_end, emit_i32_const\n}\n\n//# Functions\n\nlet op_br = 12\n\nlet op_if = 4\n\nlet bt_i64 = 126\n\nlet bt_void = 64\n\nexport fn emit_br(buf: Bytes, label: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_br, label)\n}\n\nlet op_call = 16\n\nlet op_drop = 26\n\nlet op_else = 5\n\nlet op_loop = 3\n\nlet op_block = 2\n\nlet op_br_if = 13\n\nexport fn emit_call(buf: Bytes, func_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_call, func_idx)\n}\n\nexport fn emit_drop(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_drop)\n}\n\nexport fn emit_else(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_else)\n}\n\nlet op_f64_eq = 97\n\nlet op_f64_ge = 102\n\nlet op_f64_gt = 100\n\nlet op_f64_le = 101\n\nlet op_f64_lt = 99\n\nlet op_f64_ne = 98\n\nlet op_i64_eq = 81\n\nlet op_i64_ne = 82\n\nlet op_i64_or = 132\n\nlet op_return = 15\n\nlet sec_table = 4\n\nexport fn emit_br_if(buf: Bytes, label: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_br_if, label)\n}\n\nlet op_f64_abs = 153\n\nlet op_f64_ceil = 155\n\nlet op_f64_floor = 156\n\nlet op_f64_add = 160\n\nlet op_f64_div = 163\n\nlet op_f64_max = 165\n\nlet op_f64_min = 164\n\nlet op_f64_mul = 162\n\nlet op_f64_neg = 154\n\nlet op_f64_sub = 161\n\nlet op_i32_add = 106\n\nlet op_i32_and = 113\n\nlet op_i32_eq = 70\n\nlet op_i32_eqz = 69\n\nlet op_i32_gt_u = 75\n\nlet op_i32_ne = 71\n\nlet op_i32_shr_u = 118\n\nlet op_i32_sub = 107\n\nlet op_i64_add = 124\n\nlet op_i64_and = 131\n\nlet op_i64_eqz = 80\n\nlet op_i64_mul = 126\n\nlet op_i64_shl = 134\n\nlet op_i64_sub = 125\n\nlet op_i64_xor = 133\n\nexport fn emit_f64_eq(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_eq)\n}\n\nexport fn emit_f64_ge(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_ge)\n}\n\nexport fn emit_f64_gt(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_gt)\n}\n\nexport fn emit_f64_le(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_le)\n}\n\nexport fn emit_f64_lt(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_lt)\n}\n\nexport fn emit_f64_ne(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_ne)\n}\n\nexport fn emit_i64_eq(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_eq)\n}\n\nexport fn emit_i64_ne(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_ne)\n}\n\nexport fn emit_i64_or(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_or)\n}\n\nexport fn emit_if_i64(buf: Bytes) -> Unit {\n  bytebuf_push2(buf, op_if, bt_i64)\n}\n\nexport fn emit_return(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_return)\n}\n\nlet op_i32_load = 40\n\nlet op_i64_ge_s = 89\n\nlet op_i64_gt_s = 85\n\nlet op_i64_le_s = 87\n\nlet op_i64_lt_s = 83\n\nlet sec_element = 9\n\nexport fn emit_f64_add(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_add)\n}\n\nexport fn emit_f64_div(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_div)\n}\n\nexport fn emit_f64_mul(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_mul)\n}\n\nexport fn emit_f64_neg(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_neg)\n}\n\nexport fn emit_f64_sub(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_sub)\n}\n\nexport fn emit_f64_abs(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_abs)\n}\n\nexport fn emit_f64_ceil(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_ceil)\n}\n\nexport fn emit_f64_floor(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_floor)\n}\n\nexport fn emit_f64_max(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_max)\n}\n\nexport fn emit_f64_min(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_min)\n}\n\nexport fn emit_i32_add(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_add)\n}\n\nexport fn emit_i32_and(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_and)\n}\n\nexport fn emit_i32_eq(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_eq)\n}\n\nexport fn emit_i32_shr_u(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_shr_u)\n}\n\n/// #1230 M1b-3c-3: the concurrent-awaits emitter needs these four to count\n/// down a \"how many subtasks are still pending\" local and branch on it.\nexport fn emit_i32_ne(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_ne)\n}\n\nexport fn emit_i32_sub(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_sub)\n}\n\nexport fn emit_i32_gt_u(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_gt_u)\n}\n\nexport fn emit_i32_eqz(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_eqz)\n}\n\nexport fn emit_i64_add(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_add)\n}\n\nexport fn emit_i64_and(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_and)\n}\n\nexport fn emit_i64_eqz(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_eqz)\n}\n\nexport fn emit_i64_mul(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_mul)\n}\n\nexport fn emit_i64_shl(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_shl)\n}\n\nexport fn emit_i64_sub(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_sub)\n}\n\nexport fn emit_i64_xor(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_xor)\n}\n\nexport fn emit_if_void(buf: Bytes) -> Unit {\n  bytebuf_push2(buf, op_if, bt_void)\n}\n\nlet op_i32_store = 54\n\nlet op_i64_const = 66\n\nlet op_i64_div_s = 127\n\nlet op_i64_rem_s = 129\n\nlet op_i64_shr_s = 135\n\nlet op_local_get = 32\n\nlet op_local_set = 33\n\nlet op_local_tee = 34\n\nlet type_funcref = 112\n\nexport fn emit_call_ref(buf: Bytes, type_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 20, type_idx)\n}\n\nexport fn emit_i32_load(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_load, align, offset)\n}\n\nexport fn emit_i64_ge_s(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_ge_s)\n}\n\nexport fn emit_i64_gt_s(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_gt_s)\n}\n\nexport fn emit_i64_le_s(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_le_s)\n}\n\nexport fn emit_i64_lt_s(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_lt_s)\n}\n\nexport fn emit_ref_func(buf: Bytes, func_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 210, func_idx)\n}\n\nexport fn emit_ref_null(buf: Bytes, heap_type_byte: Int) -> Unit {\n  bytebuf_push2(buf, 208, heap_type_byte)\n}\n\nlet op_i32_store8 = 58\n\nexport fn emit_block_i64(buf: Bytes) -> Unit {\n  bytebuf_push2(buf, op_block, bt_i64)\n}\n\nexport fn emit_i32_store(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_store, align, offset)\n}\n\nexport fn emit_i64_store(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 55, align, offset)\n}\n\nexport fn emit_i64_const(buf: Bytes, value: Int) -> Unit {\n  bytebuf_push_opcode_s64(buf, op_i64_const, value)\n}\n\nexport fn emit_i64_div_s(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_div_s)\n}\n\nexport fn emit_i64_rem_s(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_rem_s)\n}\n\nexport fn emit_i64_shr_s(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_shr_s)\n}\n\nexport fn emit_local_get(buf: Bytes, idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_local_get, idx)\n}\n\nexport fn emit_local_set(buf: Bytes, idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_local_set, idx)\n}\n\nexport fn emit_local_tee(buf: Bytes, idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_local_tee, idx)\n}\n\nexport fn emit_loop_void(buf: Bytes) -> Unit {\n  bytebuf_push2(buf, op_loop, bt_void)\n}\n\nlet op_i32_load8_u = 45\n\nexport fn emit_block_void(buf: Bytes) -> Unit {\n  bytebuf_push2(buf, op_block, bt_void)\n}\n\nexport fn emit_i32_store8(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_store8, align, offset)\n}\n\nexport fn emit_struct_get(buf: Bytes, type_idx: Int, field_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 251, 2, type_idx)\n  leb128_encode_u32(buf, field_idx)\n}\n\nexport fn emit_struct_new(buf: Bytes, type_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 251, 0, type_idx)\n}\n\nexport fn emit_struct_set(buf: Bytes, type_idx: Int, field_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 251, 5, type_idx)\n  leb128_encode_u32(buf, field_idx)\n}\n\nlet op_i32_wrap_i64 = 167\n\nexport fn emit_i32_load8_u(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_load8_u, align, offset)\n}\n\nlet op_call_indirect = 17\n\nexport fn emit_i32_wrap_i64(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_wrap_i64)\n}\n\nexport fn emit_call_indirect(buf: Bytes, type_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_call_indirect, type_idx)\n  bytebuf_push(buf, 0)\n}\n\nlet op_i64_trunc_f64_s = 176\n\nexport fn emit_f64_const_bits(buf: Bytes, bits: Int) -> Unit {\n  bytebuf_push9(buf, 68, bits&255, (bits>>8)&255, (bits>>16)&255, (bits>>24)&255, (bits>>32)&255, (bits>>40)&255, (bits>>48)&255, (bits>>56)&255)\n}\n\n/// Emit f64.const from the f64 pattern split into its low / high 32 bits\n/// (little-endian: 4 bytes of lo, then 4 bytes of hi). Each half is 0..2^32-1,\n/// so it fits the 62-bit Int — unlike the full pattern, which overflows it\n/// (Blocker-2, ADR-0055). Callers obtain lo/hi via Double::to_i64_bits_lo/_hi.\nexport fn emit_f64_const_lohi(buf: Bytes, lo: Int, hi: Int) -> Unit {\n  bytebuf_push9(buf, 68, lo&255, (lo>>8)&255, (lo>>16)&255, (lo>>24)&255, hi&255, (hi>>8)&255, (hi>>16)&255, (hi>>24)&255)\n}\n\nlet op_i64_extend_i32_s = 172\n\nexport fn emit_i64_trunc_f64_s(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_trunc_f64_s)\n}\n\nexport fn emit_struct_type_raw(buf: Bytes, field_types: Array[Int], field_muts: Array[Int]) -> Unit {\n  bytebuf_push_opcode_u32(buf, 95, Array::length(field_types))\n  let mut i = 0\n  while i < Array::length(field_types) {\n    bytebuf_push2(buf, Array::get(field_types, i), Array::get(field_muts, i))\n    i = i + 1\n  }\n}\n\nlet op_f64_convert_i64_s = 185\n\nexport fn emit_i64_extend_i32_s(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_extend_i32_s)\n}\n\nexport fn emit_f64_convert_i64_s(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_convert_i64_s)\n}\n\nlet op_f64_reinterpret_i64 = 191\n\nlet op_i64_reinterpret_f64 = 189\n\nexport fn emit_f64_reinterpret_i64(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_reinterpret_i64)\n}\n\nexport fn emit_i64_reinterpret_f64(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_reinterpret_f64)\n}\n\nexport fn emit_table_section_funcref(out: Bytes, num_entries: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push2(content, type_funcref, 0)\n  leb128_encode_u32(content, num_entries)\n  bytebuf_push_section(out, sec_table, content)\n}\n\n/// #1107 Phase 4: like emit_element_section_active, but takes PARALLEL arrays\n/// of (table slot, function index), sorted ascending by slot, and emits one\n/// active segment (flag 0, table 0, i32.const offset) per RUN of consecutive\n/// slots — so slots between runs stay ref.null without padding entries. Used\n/// by the linear backend to register only the closure-materialized slots\n/// recorded in CompileCtx.table_slots_used.\nexport fn emit_element_section_active_runs(out: Bytes, slots: Array[Int], func_indices: Array[Int]) -> Unit {\n  let n = Array::length(slots)\n  let mut runs = 0\n  let mut i = 0\n  while i < n {\n    if i == 0 || Array::get(slots, i) != Array::get(slots, i - 1) + 1 {\n      runs = runs + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, runs)\n  let mut s = 0\n  while s < n {\n    let mut e = s + 1\n    while e < n && Array::get(slots, e) == Array::get(slots, e - 1) + 1 {\n      e = e + 1\n    }\n    bytebuf_push(content, 0)\n    emit_i32_const(content, Array::get(slots, s))\n    emit_end(content)\n    leb128_encode_u32(content, e - s)\n    let mut k = s\n    while k < e {\n      leb128_encode_u32(content, Array::get(func_indices, k))\n      k = k + 1\n    }\n    s = e\n  }\n  bytebuf_push_section(out, sec_element, content)\n}\n\nexport fn emit_element_section_active(out: Bytes, func_indices: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push(content, 0)\n  emit_i32_const(content, 0)\n  emit_end(content)\n  leb128_encode_u32(content, Array::length(func_indices))\n  let mut i = 0\n  while i < Array::length(func_indices) {\n    leb128_encode_u32(content, Array::get(func_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, sec_element, content)\n}\n")
}

let cli_adapter_source_73 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/builders.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport ./instructions.vibe {\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_drop,\n  emit_i32_store,\n  emit_i64_add,\n  emit_i64_const,\n  emit_i64_le_s,\n  emit_i64_mul,\n  emit_i64_sub,\n  emit_local_get,\n  emit_local_set,\n  emit_loop_void\n}\n\nimport ./sections.vibe {\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_with_memory,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_header,\n  emit_i32_const,\n  emit_import_section_func,\n  emit_memory_section,\n  emit_type_section,\n  emit_type_section_multi\n}\n\n//# Functions\n\nlet builders_vt_i32 = 127\n\nlet builders_sec_data = 11\n\nlet sec_type = 1\n\nexport fn string_to_data(s: String) -> Bytes {\n  let buf = bytebuf_new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    bytebuf_push(buf, String::char_code_at(s, i))\n    i = i + 1\n  }\n  buf\n}\n\nfn empty_int_array() -> Array[Int] {\n  array_empty()\n}\n\nfn pair_int_array(v0: Int, v1: Int) -> Array[Int] {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  values\n}\n\nfn quad_int_array(v0: Int, v1: Int, v2: Int, v3: Int) -> Array[Int] {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  Array::push(values, v3)\n  values\n}\n\nfn triple_int_array(v0: Int, v1: Int, v2: Int) -> Array[Int] {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  values\n}\n\nfn empty_bytes_array() -> Array[Bytes] {\n  array_empty()\n}\n\nfn pair_bytes_array(v0: Bytes, v1: Bytes) -> Array[Bytes] {\n  let values = empty_bytes_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  values\n}\n\nfn builders_empty_string_array() -> Array[String] {\n  array_empty()\n}\n\nfn pair_string_array(v0: String, v1: String) -> Array[String] {\n  let values = builders_empty_string_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  values\n}\n\nexport fn build_call_module() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section_multi(out, quad_int_array(1, 1, 2, 1))\n  emit_function_section(out, pair_int_array(0, 1))\n  emit_export_section_multi(out, pair_string_array(\"square\", \"sum_sq\"), pair_int_array(0, 1))\n  let sq_body = bytebuf_new()\n  emit_local_get(sq_body, 0)\n  emit_local_get(sq_body, 0)\n  emit_i64_mul(sq_body)\n  let ss_body = bytebuf_new()\n  emit_local_get(ss_body, 0)\n  emit_call(ss_body, 0)\n  emit_local_get(ss_body, 1)\n  emit_call(ss_body, 0)\n  emit_i64_add(ss_body)\n  emit_code_section(out, pair_bytes_array(sq_body, ss_body))\n  bytebuf_to_bytes(out)\n}\n\nfn triple_bytes_array(v0: Bytes, v1: Bytes, v2: Bytes) -> Array[Bytes] {\n  let values = empty_bytes_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  values\n}\n\nfn singleton_int_array(v0: Int) -> Array[Int] {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  values\n}\n\nfn triple_string_array(v0: String, v1: String, v2: String) -> Array[String] {\n  let values = builders_empty_string_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  values\n}\n\nfn singleton_bytes_array(v0: Bytes) -> Array[Bytes] {\n  let values = empty_bytes_array()\n  Array::push(values, v0)\n  values\n}\n\nexport fn build_add_module() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 2, 1)\n  emit_function_section(out, singleton_int_array(0))\n  emit_export_section(out, \"add\", 0)\n  let body = bytebuf_new()\n  emit_local_get(body, 0)\n  emit_local_get(body, 1)\n  emit_i64_add(body)\n  emit_code_section(out, singleton_bytes_array(body))\n  bytebuf_to_bytes(out)\n}\n\nexport fn build_factorial_module() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, singleton_int_array(0))\n  emit_export_section(out, \"fact\", 0)\n  let b = bytebuf_new()\n  emit_i64_const(b, 1)\n  emit_local_set(b, 1)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 1)\n  emit_i64_le_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 1)\n  emit_local_get(b, 0)\n  emit_i64_mul(b)\n  emit_local_set(b, 1)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 1)\n  emit_i64_sub(b)\n  emit_local_set(b, 0)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 1)\n  emit_code_section_with_locals(out, singleton_bytes_array(b), singleton_int_array(1))\n  bytebuf_to_bytes(out)\n}\n\nexport fn build_fibonacci_module() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, singleton_int_array(0))\n  emit_export_section(out, \"fib\", 0)\n  let b = bytebuf_new()\n  emit_i64_const(b, 0)\n  emit_local_set(b, 1)\n  emit_i64_const(b, 1)\n  emit_local_set(b, 2)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 0)\n  emit_i64_le_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 1)\n  emit_local_get(b, 2)\n  emit_i64_add(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_local_set(b, 1)\n  emit_local_get(b, 3)\n  emit_local_set(b, 2)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 1)\n  emit_i64_sub(b)\n  emit_local_set(b, 0)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 1)\n  emit_code_section_with_locals(out, singleton_bytes_array(b), singleton_int_array(3))\n  bytebuf_to_bytes(out)\n}\n\nfn singleton_string_array(v0: String) -> Array[String] {\n  let values = builders_empty_string_array()\n  Array::push(values, v0)\n  values\n}\n\nexport fn build_hello_module() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, quad_int_array(builders_vt_i32, builders_vt_i32, builders_vt_i32, builders_vt_i32), singleton_int_array(builders_vt_i32))\n  emit_func_type_raw(type_content, array_empty(), array_empty())\n  bytebuf_push_section(out, sec_type, type_content)\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  emit_function_section(out, singleton_int_array(1))\n  emit_memory_section(out, 1)\n  emit_exports_with_memory(out, singleton_string_array(\"_start\"), singleton_int_array(1), \"memory\", 0)\n  let b = bytebuf_new()\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 8)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 4)\n  emit_i32_const(b, 12)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 100)\n  emit_call(b, 0)\n  emit_drop(b)\n  emit_code_section(out, singleton_bytes_array(b))\n  let hello_data = bytebuf_new()\n  bytebuf_push(hello_data, 104)\n  bytebuf_push(hello_data, 101)\n  bytebuf_push(hello_data, 108)\n  bytebuf_push(hello_data, 108)\n  bytebuf_push(hello_data, 111)\n  bytebuf_push(hello_data, 32)\n  bytebuf_push(hello_data, 119)\n  bytebuf_push(hello_data, 111)\n  bytebuf_push(hello_data, 114)\n  bytebuf_push(hello_data, 108)\n  bytebuf_push(hello_data, 100)\n  bytebuf_push(hello_data, 10)\n  emit_data_section(out, 8, hello_data)\n  bytebuf_to_bytes(out)\n}\n\nexport fn build_arithmetic_module() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 2, 1)\n  emit_function_section(out, triple_int_array(0, 0, 0))\n  emit_export_section_multi(out, triple_string_array(\"add\", \"sub\", \"mul\"), triple_int_array(0, 1, 2))\n  let add_body = bytebuf_new()\n  emit_local_get(add_body, 0)\n  emit_local_get(add_body, 1)\n  emit_i64_add(add_body)\n  let sub_body = bytebuf_new()\n  emit_local_get(sub_body, 0)\n  emit_local_get(sub_body, 1)\n  emit_i64_sub(sub_body)\n  let mul_body = bytebuf_new()\n  emit_local_get(mul_body, 0)\n  emit_local_get(mul_body, 1)\n  emit_i64_mul(mul_body)\n  emit_code_section(out, triple_bytes_array(add_body, sub_body, mul_body))\n  bytebuf_to_bytes(out)\n}\n\nexport fn emit_data_section_multi(out: Bytes, offsets: Array[Int], datas: Array[Bytes]) -> Unit {\n  let count = Array::length(offsets)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    bytebuf_push(content, 0)\n    emit_i32_const(content, Array::get(offsets, i))\n    emit_end(content)\n    let data = Array::get(datas, i)\n    leb128_encode_u32(content, Bytes::length(data))\n    bytebuf_push_buf(content, data)\n    i = i + 1\n  }\n  bytebuf_push_section(out, builders_sec_data, content)\n}\n\nexport fn build_print_string_module(msg: String) -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, quad_int_array(builders_vt_i32, builders_vt_i32, builders_vt_i32, builders_vt_i32), singleton_int_array(builders_vt_i32))\n  emit_func_type_raw(type_content, array_empty(), array_empty())\n  bytebuf_push_section(out, sec_type, type_content)\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  emit_function_section(out, singleton_int_array(1))\n  emit_memory_section(out, 1)\n  emit_exports_with_memory(out, singleton_string_array(\"_start\"), singleton_int_array(1), \"memory\", 0)\n  let str_data = string_to_data(msg)\n  let str_len = Bytes::length(str_data)\n  let b = bytebuf_new()\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 16)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 4)\n  emit_i32_const(b, str_len)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 8)\n  emit_call(b, 0)\n  emit_drop(b)\n  emit_code_section(out, singleton_bytes_array(b))\n  emit_data_section(out, 16, str_data)\n  bytebuf_to_bytes(out)\n}\n")
}

let cli_adapter_source_74 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/simd.vibe",
"//# WASM SIMD Instruction Emitters\n//\n// WASM SIMD (128-bit) instructions for v128 operations.\n// Prefix: 0xFD (253) followed by LEB128-encoded sub-opcode.\n//\n// Reference: https://webassembly.github.io/spec/core/binary/instructions.html#simd-instructions\n\nimport @vibe/compiler/core {\n  bytebuf_push, leb128_encode_u32\n}\n\n//# Constants\n\nlet simd_prefix = 253\n\n/// Memory ops (prefix + LEB128 opcode + memarg)\nlet simd_v128_load = 0\nlet simd_v128_store = 11\n\n/// Splat ops\nlet simd_i8x16_splat = 15\n\n/// Shuffle / swizzle (i8x16.swizzle = 0x0E)\nlet simd_i8x16_swizzle = 14\n\n/// Comparison ops (spec sub-opcodes, see binary/instructions SIMD table)\nlet simd_i8x16_eq = 35\n/// i8x16.le_u = 0x2A, i8x16.ge_u = 0x2C. NB: 38/40 are lt_u/gt_u, not le/ge.\nlet simd_i8x16_le_u = 42\nlet simd_i8x16_ge_u = 44\n\n/// i8x16 arithmetic\nlet simd_i8x16_sub = 113\nlet simd_i8x16_min_u = 119\n\n/// Boolean reduction\nlet simd_v128_any_true = 83\n\n/// Bitwise\nlet simd_v128_and = 78\nlet simd_v128_not = 77\n\n/// i8x16 specific\nlet simd_i8x16_all_true = 99\nlet simd_i8x16_bitmask = 100\n\n/// v128.const (opcode 12, followed by 16 immediate bytes)\nlet simd_v128_const = 12\n\n//# Memory Instructions\n\n/// v128.load memarg  -- load 128 bits from memory\nexport fn emit_v128_load(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_load)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\n/// v128.store memarg  -- store 128 bits to memory\nexport fn emit_v128_store(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_store)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\n//# Splat Instructions\n\n/// i8x16.splat  -- broadcast i32 to all 16 lanes\nexport fn emit_i8x16_splat(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_splat)\n}\n\n//# Comparison Instructions\n\n/// i8x16.eq  -- lane-wise equality, result: 0xFF or 0x00 per lane\nexport fn emit_i8x16_eq(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_eq)\n}\n\n/// i8x16.le_u  -- lane-wise unsigned less-or-equal (0xFD 0x2A)\nexport fn emit_i8x16_le_u(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_le_u)\n}\n\n/// i8x16.ge_u  -- lane-wise unsigned greater-or-equal (0xFD 0x2C)\nexport fn emit_i8x16_ge_u(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_ge_u)\n}\n\n/// i8x16.swizzle  -- byte shuffle of first operand by indices in second (0xFD 0x0E)\nexport fn emit_i8x16_swizzle(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_swizzle)\n}\n\n/// i8x16.sub  -- lane-wise wrapping subtraction (0xFD 0x71)\nexport fn emit_i8x16_sub(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_sub)\n}\n\n/// i8x16.min_u  -- lane-wise unsigned minimum (0xFD 0x77)\nexport fn emit_i8x16_min_u(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_min_u)\n}\n\n//# Boolean Reduction\n\n/// v128.any_true  -- 1 if any bit is non-zero\nexport fn emit_v128_any_true(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_any_true)\n}\n\n/// i8x16.all_true  -- 1 if all lanes are non-zero\nexport fn emit_i8x16_all_true(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_all_true)\n}\n\n/// i8x16.bitmask  -- extract MSB of each lane into i32 bitmask\nexport fn emit_i8x16_bitmask(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_bitmask)\n}\n\n//# Bitwise Instructions\n\n/// v128.and\nexport fn emit_v128_and(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_and)\n}\n\n/// v128.or  (sub-opcode 0x50 = 80; 0x4F/79 is v128.andnot — see #536)\nexport fn emit_v128_or(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, 80)\n}\n\n/// v128.not\nexport fn emit_v128_not(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_not)\n}\n\n//# v128.const\n\n/// v128.const with an explicit 16-byte little-endian immediate (0xFD 0x0C).\n/// Shorter arrays are zero-padded; longer arrays are truncated to 16 lanes.\nexport fn emit_v128_const(buf: Bytes, lanes: Array[Int]) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_const)\n  let n = Array::length(lanes)\n  let mut i = 0\n  while i < 16 {\n    let b = if i < n {\n      Array::get(lanes, i)\n    } else {\n      0\n    }\n    bytebuf_push(buf, b&255)\n    i = i + 1\n  }\n}\n\n/// v128.const -- push 16-byte immediate constant onto stack\n/// The 16 bytes are written directly after the opcode.\nexport fn emit_v128_const_zero(buf: Bytes) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_const)\n  // 16 zero bytes\n  let mut i = 0\n  while i < 16 {\n    bytebuf_push(buf, 0)\n    i = i + 1\n  }\n}\n\n/// v128.const with all lanes set to the same byte value\nexport fn emit_v128_const_splat_byte(buf: Bytes, byte_val: Int) -> Unit {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_const)\n  let mut i = 0\n  while i < 16 {\n    bytebuf_push(buf, byte_val&255)\n    i = i + 1\n  }\n}\n")
}

let cli_adapter_source_75 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/simd_patterns.vibe",
"//# SIMD Higher-Level Patterns\n//\n// Composable SIMD instruction sequences for common compiler operations.\n// Each pattern emits a WASM function body into a bytebuf.\n//\n// Convention: all functions use i64 params/results (vibe's tagged int ABI).\n// Memory addresses are passed as i64 and wrapped to i32 for memory ops.\n\nimport @vibe/compiler/core {\n  bytebuf_push, leb128_encode_u32\n}\n\nimport ./simd.vibe {\n  emit_i8x16_all_true, emit_i8x16_bitmask, emit_i8x16_eq, emit_i8x16_splat, emit_v128_and, emit_v128_load, emit_v128_not, emit_v128_or\n}\n\nimport ./instructions.vibe {\n  emit_else,\n  emit_i32_load8_u,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_const,\n  emit_i64_eq,\n  emit_i64_extend_i32_s,\n  emit_if_i64,\n  emit_local_get,\n  emit_local_set,\n  emit_return\n}\n\nimport ./code_helpers.vibe {\n  emit_end\n}\n\n//# Pattern: SIMD memcmp_16\n//\n// Compare 16 bytes at two memory addresses using SIMD.\n// Params: local0=addr_a:i64, local1=addr_b:i64\n// Returns: i64 (1 if all 16 bytes equal, 0 otherwise)\n//\n// Instructions (7 total):\n//   local.get 0 / i32.wrap_i64 / v128.load\n//   local.get 1 / i32.wrap_i64 / v128.load\n//   i8x16.eq / i8x16.all_true / i64.extend_i32_s\n\nexport fn emit_simd_memcmp_16(buf: Bytes) -> Unit {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n  emit_local_get(buf, 1)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n  emit_i8x16_eq(buf)\n  emit_i8x16_all_true(buf)\n  emit_i64_extend_i32_s(buf)\n}\n\n//# Pattern: SIMD find_byte_16\n//\n// Find a byte in a 16-byte memory chunk using SIMD.\n// Params: local0=addr:i64, local1=target_byte:i64\n// Returns: i64 bitmask (bit N set if byte at offset N matches)\n//\n// Instructions (7 total):\n//   local.get 0 / i32.wrap_i64 / v128.load\n//   local.get 1 / i32.wrap_i64 / i8x16.splat\n//   i8x16.eq / i8x16.bitmask / i64.extend_i32_s\n\nexport fn emit_simd_find_byte_16(buf: Bytes) -> Unit {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n  emit_local_get(buf, 1)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  emit_i8x16_bitmask(buf)\n  emit_i64_extend_i32_s(buf)\n}\n\n//# Pattern: SIMD skip_whitespace_16\n//\n// Check a 16-byte chunk for whitespace characters (' ', '\\t', '\\n', '\\r').\n// Params: local0=addr:i64\n// Returns: i64 bitmask of NON-whitespace positions (bit set = not whitespace)\n//\n// Strategy: compare chunk against each whitespace byte, OR the masks,\n// then NOT to get non-whitespace positions, then bitmask.\n//\n// Instructions:\n//   v128.load chunk\n//   4x (i8x16.splat + i8x16.eq) for ' ', '\\t', '\\n', '\\r'\n//   3x v128.or to combine\n//   v128.not → non-whitespace mask\n//   i8x16.bitmask → i32 → i64\n\nexport fn emit_simd_skip_whitespace_16(buf: Bytes) -> Unit {\n  // Load chunk: local.get 0 / i32.wrap / v128.load\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n  emit_local_set(buf, 2)\n  // local2 = chunk\n  // is_space = i8x16.eq(chunk, splat(0x20))\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x20)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  // stack: is_space\n  // is_tab = i8x16.eq(chunk, splat(0x09))\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x09)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  // stack: is_space, is_tab\n  emit_v128_or(buf)\n  // stack: is_space|is_tab\n  // is_nl = i8x16.eq(chunk, splat(0x0A))\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x0A)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  // stack: (is_space|is_tab), is_nl\n  emit_v128_or(buf)\n  // stack: is_space|is_tab|is_nl\n  // is_cr = i8x16.eq(chunk, splat(0x0D))\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x0D)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  // stack: (is_space|is_tab|is_nl), is_cr\n  emit_v128_or(buf)\n  // stack: is_ws (all whitespace positions)\n  // NOT → non-whitespace, then bitmask\n  emit_v128_not(buf)\n  emit_i8x16_bitmask(buf)\n  emit_i64_extend_i32_s(buf)\n  // result: bitmask where bit N set = byte N is NOT whitespace\n  // caller uses ctz to find first non-whitespace position\n}\n\n//# Pattern: SIMD in_range_16\n//\n// Check if each byte in a 16-byte chunk is within [low, high] range.\n// Params: local0=addr:i64, local1=low:i64, local2=high:i64\n// Returns: i64 bitmask of bytes OUTSIDE range (bit set = out of range)\n//\n// Uses: v128_le_u_i8x16 is not yet in our emit set, so we use\n// a subtraction trick: (byte - low) <= (high - low) using unsigned comparison.\n// For simplicity, we use splat + eq for exact byte matching instead.\n//\n// Actually: since we don't have le_u yet, provide an alternative pattern\n// that checks membership in a character set via multiple eq + or.\n\nexport fn emit_simd_is_identifier_char_16(buf: Bytes) -> Unit {\n  // Load chunk\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n  emit_local_set(buf, 1)\n  // local1 = chunk\n  // Check '_' (0x5F)\n  emit_local_get(buf, 1)\n  emit_i64_const(buf, 0x5F)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  // stack: is_underscore\n  // For [a-z], [A-Z], [0-9] we'd need le_u.\n  // Emit the underscore check as a starting point; full range check\n  // requires adding emit_i8x16_le_u to simd.vibe (opcode 0xFD 0x26).\n  // For now, bitmask the underscore-only result as a prototype\n  emit_i8x16_bitmask(buf)\n  emit_i64_extend_i32_s(buf)\n}\n\n//# Scalar baselines (for code size comparison)\n\n/// i64.load instruction (opcode 0x29 = 41, followed by memarg)\nfn emit_i64_load(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, 41)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\n//# Scalar memcmp_16 (unrolled, 2x i64.load)\n//\n// Compare 16 bytes as two 8-byte i64 loads.\n// Params: local0=addr_a:i64, local1=addr_b:i64\n// Returns: i64 (1 if equal, 0 otherwise)\n//\n// This is the realistic scalar baseline -- compilers unroll small memcmp\n// into word-sized loads. Still more instructions than SIMD.\n\nexport fn emit_scalar_memcmp_16_unrolled(buf: Bytes) -> Unit {\n  // Compare first 8 bytes\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 0, 0)\n  emit_local_get(buf, 1)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 0, 0)\n  emit_i64_eq(buf)\n  // if first 8 bytes equal, check second 8 bytes\n  emit_if_i64(buf)\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 0, 8)\n  emit_local_get(buf, 1)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 0, 8)\n  emit_i64_eq(buf)\n  emit_i64_extend_i32_s(buf)\n  emit_else(buf)\n  emit_i64_const(buf, 0)\n  emit_end(buf)\n}\n\n//# Scalar find_byte_16 (unrolled, 4 bytes checked)\n//\n// Check bytes one by one with conditional branches.\n// Params: local0=addr:i64, local1=target_byte:i64\n// Returns: i64 bitmask (1<<pos for first match, 0 if not found)\n//\n// Only checks first 4 bytes for code brevity. A full 16-byte unroll\n// would be 4x larger, making the SIMD advantage even more dramatic.\n\nexport fn emit_scalar_find_byte_16_unrolled(buf: Bytes) -> Unit {\n  // Byte 0\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load8_u(buf, 0, 0)\n  emit_i64_extend_i32_s(buf)\n  emit_local_get(buf, 1)\n  emit_i64_eq(buf)\n  emit_if_i64(buf)\n  emit_i64_const(buf, 1)\n  emit_return(buf)\n  emit_else(buf)\n  // Byte 1\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load8_u(buf, 0, 1)\n  emit_i64_extend_i32_s(buf)\n  emit_local_get(buf, 1)\n  emit_i64_eq(buf)\n  emit_if_i64(buf)\n  emit_i64_const(buf, 2)\n  emit_return(buf)\n  emit_else(buf)\n  // Byte 2\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load8_u(buf, 0, 2)\n  emit_i64_extend_i32_s(buf)\n  emit_local_get(buf, 1)\n  emit_i64_eq(buf)\n  emit_if_i64(buf)\n  emit_i64_const(buf, 4)\n  emit_return(buf)\n  emit_else(buf)\n  // Byte 3\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load8_u(buf, 0, 3)\n  emit_i64_extend_i32_s(buf)\n  emit_local_get(buf, 1)\n  emit_i64_eq(buf)\n  emit_if_i64(buf)\n  emit_i64_const(buf, 8)\n  emit_return(buf)\n  emit_else(buf)\n  emit_i64_const(buf, 0)\n  emit_end(buf)\n  emit_end(buf)\n  emit_end(buf)\n  emit_end(buf)\n}\n")
}

let cli_adapter_source_76 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/index.vpkg",
"name = @vibe/compiler/codegen/common_base\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/codegen/common_base — the shared codegen substrate: the\ndeps = {\n  @vibe/compiler/codegen/wasm_emit : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/codegen/common_base — the shared codegen substrate: the\n// linear-backend CompileCtx / wasm-gc-backend CompileCtxGc compile-context\n// structs plus the func/str/lambda/ctor lookup tables they carry, the branch-\n// coverage CovState, the interior-line-breakpoint DbgProv, and ~80 low-level\n// AST-shape predicates / wasm instruction emit helpers / ctor-table and\n// effect-tag lookups shared across every codegen backend and expr-compile\n// module (ADR-0070 Phase 3, #897, compiler-internal batch). Compiled into\n// the compiler itself via compiler_sources_manifest.tsv (group `codegen`,\n// dual-row: this contract + common_base.vibe).\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package was originally single-file: no sibling files in this directory),\n// so it moved verbatim to common_base.vibe. Unlike normalize/perceus/\n// common_analysis, this package DOES export real struct types (FuncTable,\n// StrTable, LambdaTable, CtorTable, CovState, LineMapState, CompileCtx,\n// DbgProv, CompileCtxGc) that other codegen packages construct/pattern-match/access\n// fields on directly. Per contract/contract.vibe's conformance checker, a\n// package-owned struct like this is declared as a bodyless (opaque-arity,\n// TRANSPARENT — no `opaque` keyword) `type Name` line: the real field list\n// stays the single source of truth in common_base.vibe, and check_contract\n// only verifies the name + arity match an exported top-level type def\n// there. This is DIFFERENT from @vibe/ast's index.vpkg, where the enums are\n// the only definition (the impl stub never redefines them) so the FULL body\n// lives in the contract; common_base's structs are the opposite shape\n// (impl-owned, contract just attests they exist), so only the bodyless form\n// belongs here. Expr/Pat/Stmt/TypeExpr (../../core) are plain structural\n// signature text, not declared at all (normalize/perceus precedent).\n//\n// Three external files previously imported this package by literal\n// `common_base/index.vibe` path instead of the bare directory form every\n// other consumer already used (`import ../common_base { .. }`):\n// entry/compiler/file_compile/file_compile.vibe, codegen/index.vibe, and\n// codegen/wasi/wasi.vibe. All three were switched to the bare form so every\n// consumer now reaches this package only through its index.vpkg.\n//\n// #897 codegen/ top-level batch UPDATE: this package gained 4 new sibling\n// files -- builtin_registry.vibe, double_to_string_expr.vibe,\n// int_parse_expr.vibe, inline_wat.vibe -- relocated here FROM codegen/'s own\n// top level while migrating codegen/'s own index.vibe to index.vpkg.\n// Reason: codegen/'s subpackages (expr/, gc/, wasi/ -- each already its own\n// index.vpkg from earlier #897 batches) need these 4 files directly\n// (builtin_registry for the func-table registry, double_to_string_expr /\n// int_parse_expr for synthesized-AST builtin lowering, inline_wat for\n// `= wasm \"...\"` bodies), while codegen/codegen.vibe (the top facade) ALSO\n// depends downward on expr/ and wasi/ to forward compile_module/\n// compile_wasi_module*. Leaving these 4 files owned by codegen/index.vpkg\n// itself therefore made codegen/index.vpkg <-> codegen/expr(gc,wasi)/\n// index.vpkg a genuine two-node import cycle the moment expr/gc/wasi's leaf\n// imports of them were switched to boundary-legal package imports\n// (confirmed empirically: `type_db: import cycle detected at\n// codegen/index.vpkg`, only surfaced by scripts/unit_test_runner.sh, not by\n// the build/gate steps that ran earlier in the same verification chain).\n// common_base already plays exactly this \"shared substrate every codegen\n// backend and expr-compile module depends on, with no upward edges of its\n// own\" role, so moving these 4 files here breaks the cycle cleanly: expr/\n// gc/wasi now reach them via an ordinary downward `import ../common_base`,\n// and codegen.vibe re-exports the externally-relevant subset\n// (lookup_registry_builtin, builtin_registry, verify_lane_builtins,\n// compile_inline_wat) via `export ./common_base { .. }` (cross-package\n// SReExport, same form as syntax/syntax.vibe's re-export of @vibe/parser) so\n// codegen/index.vpkg's own external facade surface is unchanged.\n// builtin_registry_typed, double_to_string_expr and int_parse_expr are NOT\n// re-exported by codegen.vibe (nothing outside codegen/expr and codegen/gc\n// consumes them), so they are declared here but not in codegen/index.vpkg.\n\n// Func/string/lambda-table lookups threaded through CompileCtx/CompileCtxGc.\ntype FuncTable\ntype StrTable\ntype LambdaTable\n\n// Constructor/struct dispatch table threaded through CompileCtx/CompileCtxGc.\ntype CtorTable\n\n// #cov branch coverage state (linear backend only). cov_disabled() when off.\ntype CovState\n\n// #644: static (wasm code offset -> source file/line) recorder for the\n// `vibe.linemap` custom section, threaded through CompileCtx.linemap.\n// linemap_disabled() outside debug-break builds and on every lambda-derived\n// ctx (see common_base.vibe's field doc comment).\ntype LineMapState\n\n// The linear-backend compile context: func/str/lambda/ctor tables, RC\n// (Perceus) bookkeeping, branch-coverage and interior-line-breakpoint state,\n// and per-function shape-tracking logs. See common_base.vibe for the full\n// field list and their extensive per-field doc comments.\ntype CompileCtx\n\n// Interior-line breakpoints (span-arc step5, multi-file): per-file\n// provenance the break codegen needs to emit `vibe::dbg_line(<file_id>,\n// <line>)` and a `vibe.dbgfiles` section. empty_dbg_prov() on non-break\n// builds.\ntype DbgProv\n\n// The wasm-gc-backend twin of CompileCtx (gc_-prefixed fields where a name\n// would otherwise collide with CompileCtx's own field at a different slot\n// index — see common_base.vibe's field-collision comment on gc_ctor_table).\ntype CompileCtxGc\n\nfn cov_disabled() -> CovState\nfn cov_emit_branch(buf: Bytes, cov: CovState) -> Unit\nfn empty_dbg_prov() -> DbgProv\nfn linemap_disabled() -> LineMapState\nfn int_log_reset_above(ctx: CompileCtx, floor: Int) -> Unit\nfn float_log_reset_above(ctx: CompileCtx, floor: Int) -> Unit\nfn gc_slot_log_reset_above(arr: Array[Int], floor: Int) -> Unit\nfn agg_log_reset_above(arr: Array[Int], floor: Int) -> Unit\nfn agg_log_reset_above2(arr: Array[Int], exprs: Array[Expr], floor: Int) -> Unit\nfn agg_slot_lookup(arr: Array[Int], slot: Int) -> Int\nfn agg_expr_lookup(arr: Array[Int], exprs: Array[Expr], slot: Int) -> Expr\nfn agg_info_of_type_name(ct: CtorTable, tname: String) -> Int\nfn agg_info_of_type_expr(ct: CtorTable, te: TypeExpr) -> Int\nfn compute_agg_returning(stmts: Array[Stmt], ct: CtorTable, out_names: Array[String], out_infos: Array[Int]) -> Unit\nfn agg_ret_lookup(names: Array[String], infos: Array[Int], fname: String) -> Int\nfn find_local_slot(names: Array[String], name: String) -> Int\nfn agg_info_of_ident(arr: Array[Int], e: Expr, local_names: Array[String]) -> Int\nfn agg_expr_of_ident(arr: Array[Int], exprs: Array[Expr], e: Expr, local_names: Array[String]) -> Expr\nfn is_efn(expr: Expr) -> Bool\nfn is_pint(p: Pat) -> Bool\nfn is_pfloat(p: Pat) -> Bool\nfn is_slet(stmt: Stmt) -> Bool\nfn expr_tag(expr: Expr) -> Int\nfn is_pbind(p: Pat) -> Bool\nfn is_pbool(p: Pat) -> Bool\nfn is_pctor(p: Pat) -> Bool\nfn is_pwild(p: Pat) -> Bool\nfn is_earray(expr: Expr) -> Bool\nfn is_eident(expr: Expr) -> Bool\nfn is_etuple(expr: Expr) -> Bool\nfn is_ptuple(p: Pat) -> Bool\nfn is_erecord(expr: Expr) -> Bool\nfn is_pstring(p: Pat) -> Bool\nfn emit_i32_eq(buf: Bytes) -> Unit\nfn emit_i32_ne(buf: Bytes) -> Unit\nfn get_arm_pat(arm: (Pat, Expr)) -> Pat\nfn lookup_ctor(ctor_names: Array[String], name: String, i: Int) -> Int\nfn ctor_sorted_index(names: Array[String]) -> (Array[String], Array[Int])\nfn ctor_table_index_of(ct: CtorTable, name: String) -> Int\nfn ctor_field_is_float(ctx: CompileCtx, ctor_idx: Int, field_idx: Int) -> Bool\nfn struct_field_candidates(ct: CtorTable, field: String) -> Array[(Int, Int)]\nfn struct_field_dispatch_cases(cands: Array[(Int, Int)]) -> Array[(Int, Int)]\nfn struct_index_by_field_set(ct: CtorTable, lit_names: Array[String]) -> Int\nfn struct_tag_by_index(ct: CtorTable, si: Int) -> Int\nfn emit_i32_eqz(buf: Bytes) -> Unit\nfn emit_i32_mul(buf: Bytes) -> Unit\nfn emit_i32_sub(buf: Bytes) -> Unit\nfn emit_str_ref(buf: Bytes, offset: Int, length: Int) -> Unit\nfn get_arm_body(arm: (Pat, Expr)) -> Expr\nfn get_efn_body(expr: Expr) -> Expr with { Error }\nfn get_eif_cond(expr: Expr) -> Expr with { Error }\nfn get_eif_else(expr: Expr) -> Expr with { Error }\nfn get_eif_then(expr: Expr) -> Expr with { Error }\nfn get_elet_val(expr: Expr) -> Expr with { Error }\nfn is_ctor_call(value: Expr, ct: CtorTable) -> Bool\nfn resolve_func(ft: FuncTable, name: String) -> (Int, Int, Int) with { Error }\nfn func_table_index_of(ft: FuncTable, name: String) -> Int\nfn emit_binop_op(buf: Bytes, op: String) -> Unit with { Error }\nfn emit_i32_ge_u(buf: Bytes) -> Unit\nfn emit_i32_gt_u(buf: Bytes) -> Unit\nfn emit_i64_load(buf: Bytes, align: Int, offset: Int) -> Unit\nfn get_ebinop_op(expr: Expr) -> String with { Error }\nfn get_elet_body(expr: Expr) -> Expr with { Error }\nfn get_elet_off(expr: Expr) -> Int with { Error }\nfn get_eletmut_off(expr: Expr) -> Int with { Error }\nfn get_elet_name(expr: Expr) -> String with { Error }\nfn get_func_body(stmt: Stmt) -> Expr with { Error }\nfn get_slet_expr(stmt: Stmt) -> Expr with { Error }\nfn get_slet_name(stmt: Stmt) -> String with { Error }\nfn get_slet_type(stmt: Stmt) -> Option[TypeExpr]\nfn resolve_local(names: Array[String], name: String, tag: String) -> Int with { Error }\nfn emit_i64_store(buf: Bytes, align: Int, offset: Int) -> Unit\nfn emit_box_float(buf: Bytes, ctx: CompileCtx, bits_local: Int, box_local: Int) -> Unit\nfn find_func_stmt(stmts: Array[Stmt], name: String) -> Stmt with { Error }\nfn emit_unbox_float(buf: Bytes) -> Unit\nfn emit_index_one(buf: Bytes, ctx: CompileCtx) -> Unit\nfn rc_shadow_base() -> Int\nfn rc_shadow_reserve() -> Int\nfn emit_rc_word_inc_saturating(buf: Bytes, push_addr: () -> Unit) -> Unit\nfn emit_rc_dup_guarded(buf: Bytes, local_idx: Int, rc_shadow: Bool) -> Unit\nfn fn_type_param_types(ty: Option[TypeExpr]) -> Option[Array[TypeExpr]]\nfn is_nullary_ctor_ident(value: Expr, ct: CtorTable) -> Bool\nfn name_has_effect_prefix(full: String, eff: String) -> Bool\nfn effect_name_to_tag(effect_names: Array[String], full: String) -> Int\nfn effect_op_declared_arity(keys: Array[String], arities: Array[Int], full: String) -> Int\nfn effect_op_index(keys: Array[String], full: String) -> Int\nfn emit_heap_grow_after_heap_set(buf: Bytes, ctx: CompileCtx) -> Unit\n\n// --- builtin_registry.vibe (relocated here, see #897 header note above)\nfn builtin_registry_typed() -> Array[(String, Type, Bool, Bool, Bool)]\nfn builtin_registry() -> Array[(String, Int, Int, Bool, Bool)]\nfn lookup_registry_builtin(name: String) -> Option[Type]\nfn verify_lane_builtins(lane: String, names: Array[String], param_counts: Array[Int], returns: Array[Int]) -> Unit with { Error }\n\n// --- double_to_string_expr.vibe (relocated here, see #897 header note above)\nfn double_to_string_expr(arg: Expr) -> Expr\n\n// --- int_parse_expr.vibe (relocated here, see #897 header note above)\nfn int_parse_expr(arg: Expr) -> Expr\n\n// --- double_parse_expr.vibe (#841 item E1)\nfn double_parse_expr(arg: Expr) -> Expr\n\n// --- inline_wat.vibe (relocated here, see #897 header note above)\nfn compile_inline_wat(fn_name: String, wat: String, param_names: Array[String]) -> Bytes with { Error }\n\n// --- builtin_name.vibe (relocated here from compiler/ top level, #897 batch;\n// same rationale as the 4 files above: needed leaf-directly by checker/ and\n// by multiple codegen/ subpackages -- see codegen/index.vpkg for the\n// re-export)\nfn canonical_builtin_name(name: String) -> String\n\n// --- desugar_trait_dict.vibe (relocated here from compiler/ top level,\n// #897 batch; needed leaf-directly by checker/, codegen/wasi/, and entry/ --\n// see codegen/index.vpkg for the subset re-exported further up)\nfn inject_trait_method_generics(stmts: Array[Stmt]) -> Unit\nfn inject_prelude_result(stmts: Array[Stmt]) -> Unit\nfn desugar_railway_binds(stmts: Array[Stmt]) -> Unit\nfn desugar_derives(stmts: Array[Stmt]) -> Unit\nfn desugar_hoist_local_lambdas(stmts: Array[Stmt]) -> Unit\nfn desugar_labeled_args(stmts: Array[Stmt]) -> Unit\nfn desugar_array_spread(stmts: Array[Stmt]) -> Unit\nfn desugar_trait_dicts(stmts: Array[Stmt]) -> Unit with { Error }\n// --- self_tail_call\nfn rewrite_self_tail_calls(stmts: Array[Stmt]) -> Unit\n\n// --- inline_direct_perform\nfn inline_direct_performs(stmts: Array[Stmt]) -> Unit\n\n// --- evidence_dict_pass\nfn evidence_dict_pass(stmts: Array[Stmt], entry_name: String) -> Array[String]\n\n// --- suspend_cps_pass (ADR-0076 Phase 3a, #817)\nfn suspend_cps_pass(stmts: Array[Stmt]) -> Array[String]\n\n// --- await_poll_pass (#1230, docs/spec/wasi-p3-async.md M1b-3c)\nfn await_poll_pass(stmts: Array[Stmt]) -> Unit\n")
}

let cli_adapter_source_77 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/common_base.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, __to_string, apply_perm_strings, bsearch_leftmost, bytebuf_push, leb128_encode_u32, sort_perm_by_names\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_call,\n  emit_call_indirect,\n  emit_else,\n  emit_end,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_store,\n  emit_i64_sub,\n  emit_i64_xor,\n  emit_if_void,\n  emit_local_get,\n  emit_local_set\n}\n\n//# Types\n\nexport struct FuncTable {\n  names: Array[String];\n  indices: Array[Int];\n  params: Array[Int];\n  returns: Array[Int];\n  needs_env: Array[Bool];\n  // #1100: sorted-name index (see ctor_sorted_index/ctor_table_index_of,\n  // this file) for func_table_index_of's O(log N) bsearch_leftmost lookup --\n  // built ONCE per compile from `names` via ctor_sorted_index, same as\n  // CtorTable.names_sorted/names_sorted_pos. `names` itself stays in its\n  // original (declaration) order; only this sorted VIEW is new.\n  names_sorted: Array[String];\n  names_sorted_pos: Array[Int]\n}\n\nexport struct StrTable {\n  strs: Array[String];\n  offsets: Array[Int];\n  lengths: Array[Int]\n}\n\nexport struct LambdaTable {\n  bodies: Array[Bytes];\n  param_counts: Array[Int];\n  captures: Array[Array[String]];\n  meta_i32: Array[Int];\n  meta_i64: Array[Int]\n}\n\nexport struct CtorTable {\n  names: Array[String];\n  tags: Array[Int];\n  field_counts: Array[Int];\n  type_names: Array[String];\n  struct_names: Array[String];\n  struct_field_names: Array[Array[String]];\n  // Sorted view of `names` + original-position payload (ctor_sorted_index).\n  // ctor_table_index_of binary-searches these instead of linearly scanning\n  // `names` per constructor reference -- lookup_ctor was a top-10 self-time\n  // entry in compiler-closure compile profiles. Keep in sync with `names`\n  // (same length); ctor_table_index_of falls back to the linear scan when a\n  // hand-built table skips them.\n  names_sorted: Array[String];\n  names_sorted_pos: Array[Int]\n}\n\n/// #cov branch coverage state, threaded via CompileCtx. Linear-backend only;\n/// active only when `enabled` (VIBE_COVERAGE=1 build). `base`/`cap` bound a fixed\n/// reserved memory region (1 byte per branch id). `next` is a 1-element mutable\n/// counter cell assigning sequential branch ids in codegen-traversal order;\n/// `cur_fn` is a 1-element cell holding the index of the function currently being\n/// compiled (set before each top-level body). `owners` accumulates, per branch\n/// id in id order, the owning function index so the report attributes branches to\n/// functions (reusing the `vibe_cov` function-name table). When disabled all of\n/// this is inert and codegen output is byte-identical to a normal build.\nexport struct CovState {\n  enabled: Bool;\n  base: Int;\n  cap: Int;\n  next: Array[Int];\n  cur_fn: Array[Int];\n  owners: Array[Int]\n}\n\n/// A disabled CovState (coverage off): inert, used by the normal compile path and\n/// the non-WASI module entry. Fresh 1-element cells keep Array::get safe.\nexport fn cov_disabled() -> CovState {\n  CovState::{\n    enabled: false,\n    base: 0,\n    cap: 0,\n    next: [\n      0\n    ],\n    cur_fn: [\n      0\n    ],\n    owners: ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n}\n\n/// #cov: emit a stack-neutral hit store for one branch target and assign it the\n/// next sequential branch id, recording the owning function index. No-op when\n/// coverage is off or the fixed-cap region is full. Called at the start of each\n/// branch arm's instruction sequence (if/else, match arm), so the store runs\n/// only when that branch is actually taken at run time.\nexport fn cov_emit_branch(buf: Bytes, cov: CovState) -> Unit {\n  if cov.enabled {\n    let id = Array::get(cov.next, 0)\n    if id < cov.cap {\n      Array::set(cov.next, 0, id + 1)\n      Array::push(cov.owners, Array::get(cov.cur_fn, 0))\n      emit_i32_const(buf, cov.base + id)\n      emit_i32_const(buf, 1)\n      emit_i32_store8(buf, 0, 0)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\nexport struct CompileCtx {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ctor_table: CtorTable;\n  // #1062: sparse `ctor_idx * 64 + field_idx` entries for constructor (enum\n  // variant / struct) fields whose DECLARED type is Double/Float, keyed by\n  // position in ctor_table.names (see ctor_table_index_of) and positional\n  // field index (see ctor_table's field_counts). Built once from the\n  // program's SEnum/SSuberror/SStruct declarations (the only place a\n  // constructor field's static type is available -- codegen itself is\n  // otherwise untyped, see float_local_slots below). Consulted by\n  // bind_match_pat (compile_match.vibe) so a pattern-bound field like `r` in\n  // `Circle(r) => r * r` gets registered into float_local_slots exactly like\n  // a `let`-bound float, instead of falling through to the integer-multiply\n  // path and treating a boxed-float pointer as a scalar (OOB trap under RC).\n  ctor_float_fields: Array[Int];\n  thunk_names: Array[String];\n  const_int_names: Array[String];\n  const_int_values: Array[Int];\n  // Perceus RC mode (docs/spec/selfhost-rc-port.md). When true, heap objects\n  // carry a uniform `[type_id@0][length@4][payload@8...]` header so the (future)\n  // RC drop helper can dispatch and recurse. Default false: layout unchanged.\n  // Threaded as a parameter on the WASI compile path (a module-level flag is\n  // not usable: a getter capturing it is `missing closure env` in the native\n  // CLI codegen, and a cross-module `let` reference is `unknown name`).\n  enable_rc: Bool;\n  // #715 recurrence guard (VIBE_RC=shadow): emit shadow-liveness traps -- a\n  // byte per heap address marks freed blocks; the FIRST dup-of-freed or\n  // drop-of-freed executes `unreachable` instead of silently corrupting the\n  // free list. Debug-only; false (byte-identical output) on normal builds.\n  rc_shadow: Bool;\n  // RC: names of `let` bindings whose value the Perceus analysis says to drop\n  // at scope end (computed per function from build_perceus_plan). compile_expr\n  // emits an rc_drop for a tuple binding whose name appears here.\n  rc_drop_names: Array[String];\n  // RC: alias bindings (`let a = t`) whose source `t` is multiply-used, so the\n  // alias takes a duplicated reference — compile_expr emits an rc_dup of the\n  // source at the alias `let`. (PaAliasDup from the Perceus plan.)\n  rc_alias_dup_names: Array[String];\n  // RC: bindings known at codegen time to hold a heap object (bound to a\n  // tuple/record/enum literal, or an alias of such). Built as `let`s compile.\n  // Gates rc_dup / rc_drop so we never touch a non-heap (e.g. Int-returning\n  // call) binding the static Perceus `scalar` flag over-approximates as heap.\n  heap_binding_names: Array[String];\n  // RC: wasm function index of the generic recursive `vibe_rc_drop` helper\n  // (ADR-0055 Stage 3), or -1 when unavailable (non-RC, or the legacy inline\n  // drop). When >= 0, scope-end drops emit a `call` to it so nested heap is\n  // reclaimed to arbitrary depth.\n  rc_drop_func_idx: Int;\n  // RC: wasm function index of the free-list search allocator `vibe_rc_alloc`\n  // (ADR-0055 Stage 4), or -1 when unavailable (non-RC). When >= 0, heap-object\n  // construction calls it with the block size so an exact-fit free block is found\n  // anywhere in the free-list (not just the head), eliminating the size-ordering\n  // fragmentation a head-only check leaves when interleaved sizes are freed.\n  rc_alloc_func_idx: Int;\n  // Linear-memory backend: wasm function index of `vibe_heap_grow_check`, or -1\n  // when the surrounding module does not define the helper. Bump allocations\n  // call it after updating global 0 so low initial memory can grow on demand.\n  heap_grow_check_func_idx: Int;\n  // Map[String,V] O(1)-average get/has_key side hash index (see the doc\n  // comment on gen_map_hash_body, builtin_bodies/bodies_core_b.vibe). -1 in\n  // any CompileCtx that doesn't wire these (e.g. compile_module_expr.vibe's\n  // non-linked lite path) -- Map::get/has_key/set/delete/MapBuilder::freeze\n  // all fall back to the untouched linear-scan/no-index codegen whenever\n  // map_probe_func_idx / map_build_index_func_idx is negative.\n  map_hash_func_idx: Int;\n  map_cap_func_idx: Int;\n  map_build_index_func_idx: Int;\n  map_probe_func_idx: Int;\n  // RC: names of `let` bindings the Perceus plan marks with a non-alias `PaDup`\n  // (a heap value used in more than one *owning* position, e.g. `let u = (t, t)`\n  // dups `t`). One entry per dup (so a name's multiplicity = its dup budget).\n  // compile_expr emits that many guarded rc_dups at the binding site, giving the\n  // block the extra references its container/owning uses consume — without this\n  // the recursive drop visits the shared child more times than it has refs.\n  // (ADR-0055 Stage 4.)\n  rc_dup_names: Array[String];\n  // Blocker-3 (ADR-0055): append-only log of `slot*2 + flag` entries (flag 1 =\n  // a `let`/`let mut` binding whose value is statically floatish; flag 0 = a\n  // non-float rebind overriding a previously-float slot). The MOST RECENT entry\n  // for a local slot wins, so `expr_is_floatish` can recognise a *variable*\n  // holding a float (`let x = 1.5; x + y` takes the f64 path) while a shadowing\n  // rebind of another type — nested block or if/match branch reusing the slot —\n  // is classified by its own binding. Append-only (not truncated) because the\n  // wasm-gc backend cannot truncate a struct-field array; the log only grows for\n  // float-related bindings, which are rare. Still a syntactic over-\n  // approximation (the AST is untyped): float function params / lambda-captured\n  // floats are not tracked.\n  // #799 perf: membership index over func_table.names + ctor_table.names,\n  // built ONCE per compile. collect_free_vars_indexed consults it per ident\n  // instead of linearly scanning the flat name arrays (which was ~70% of a\n  // compiler-closure compile's profile).\n  // Round 2: the Map representation was itself a linear assoc scan per\n  // lookup (Map::has_key is O(entries)); now a SORTED name array consulted\n  // via binary search (core/sorted_index.vibe).\n  capture_name_index: Array[String];\n  float_local_slots: Array[Int];\n  // #678: append-only log of `slot*2 + flag` entries, the integer dual of\n  // float_local_slots. flag 1 marks a `let`/`let mut` slot whose value is\n  // statically integral (Int/Bool); flag 0 a non-int rebind overriding a\n  // previously-int slot. Most-recent entry per slot wins, so a bare integer\n  // variable in `==`/`!=` takes the direct `i64.eq` path instead of the\n  // polymorphic `eq` whose string fall-back misreads a large int as a string\n  // fat-pointer (two unequal ints with a zero low word compare EQUAL). UNLIKE\n  // the float log this one IS pruned: `int_log_reset_above` drops entries for\n  // slots a branch/arm is about to reuse, so a slot rebound by a NON-`let`\n  // binder (match-arm / for-in / catch-all pattern var) — which never logs an\n  // entry — is never read as a stale int. Without that pruning a reused slot\n  // holding a string would be misclassified and string `==` would break.\n  int_local_slots: Array[Int];\n  // #724: append-only log of `slot*256 + kind*64 + n` entries tracking\n  // let-bound AGGREGATE literals, so `a == b` with BOTH sides non-literal\n  // bindings can still take the structural comparators (the generic runtime\n  // `eq` pointer-compares tuples, which carry no runtime header to walk).\n  // kind 1 = tuple literal (n = arity), kind 2 = ctor / record literal\n  // (n = field count), kind 0 = non-aggregate rebind overriding a reused\n  // slot. Most-recent entry per slot wins; pruned at the same branch/arm\n  // boundaries as int_local_slots (agg_log_reset_above) so a slot reused by\n  // a non-`let` binder is never read as a stale aggregate. Bindings whose\n  // value shape is not statically known (params, call results, match binds)\n  // are NOT tracked and keep the generic-eq fallback.\n  agg_local_slots: Array[Int];\n  // #672 (post-#724): parallel array to agg_local_slots, SAME length and\n  // index correspondence (every push to agg_local_slots pushes exactly one\n  // entry here too, in the same call). Holds the actual shape LITERAL\n  // expression (ETuple / ctor ECall / nullary-ctor EIdent) backing a kind-1\n  // (tuple) or kind-2 (ctor/record) entry, or an inert EInt(0) placeholder\n  // for kind-0 / untracked entries (never consulted — callers only read this\n  // after confirming kind via agg_slot_lookup). This lets `a == b` on a\n  // TRACKED variable recurse into NESTED aggregate elements (e.g. `let a =\n  // ((1,2),3)`) the same way a literal operand does, instead of only\n  // comparing the top-level shape and falling back to pointer `eq` for any\n  // element that is itself an aggregate. See agg_expr_lookup / emit_eq_shape_slots\n  // (compile_expr.vibe).\n  agg_local_exprs: Array[Expr];\n  // #724 round 2: program-wide (fn name -> declared aggregate return shape)\n  // parallel arrays (see compute_agg_returning). Shared across functions —\n  // NOT per-function like agg_local_slots.\n  agg_ret_names: Array[String];\n  agg_ret_infos: Array[Int];\n  // #791: program-wide (fn name) set for top-level functions whose DECLARED\n  // return type is heap (see compute_heap_returning / type_expr_is_heap).\n  // Consulted by classify_let_value_heap so `let mut s = Set::new()` reads\n  // Set::new's own `-> Set[T]` signature instead of over-approximating every\n  // ECall-valued let/let-mut as heap. Shared across functions, like\n  // agg_ret_names.\n  heap_ret_names: Array[String];\n  // #545 nesting: declared effect names (excluding `Error`), in tag-assignment\n  // order. Effect `effect_names[i]` is routed through wasm exception tag `3 + i`\n  // with its own resume frontier; `perform` and `handle` both derive the tag\n  // from this list so a perform reaches its own handler through an unrelated\n  // inner handle (which catches a different tag) and uses an independent\n  // frontier. See effect_name_to_tag.\n  effect_names: Array[String];\n  // #548 multi-value payloads: parallel arrays keyed by full op name\n  // (\"Effect::Op\") giving each effect op's DECLARED parameter count. The handle\n  // arm uses the declared arity (not the pattern arity) to decide whether the\n  // thrown payload is a packed tuple to destructure (arity > 1) or a single\n  // value — so an extra continuation-slot bind like `Question(q, k)` on a\n  // 1-arg op is not mistaken for a 2-tuple. See effect_op_declared_arity.\n  effect_op_keys: Array[String];\n  effect_op_arities: Array[Int];\n  // #cov branch coverage state (linear backend). cov_disabled() when off.\n  cov: CovState;\n  // Interior-line breakpoints (span-arc step5): wasm function index of the\n  // `vibe::dbg_line` host import, or -1 when off (default / non-break /\n  // multi-file). When >= 0, the ELet/ELetMut/ESeq handlers emit\n  // `i32.const <line>` + `call dbg_line_idx` at each statement boundary so the\n  // runner can pause at interior source lines. Default -1: codegen unchanged.\n  dbg_line_idx: Int;\n  // Interior-line breakpoints: sorted newline char-offsets of THIS function's\n  // source file, used to map a statement's char-offset to a 1-based line. Empty\n  // when off.\n  dbg_line_nl: Array[Int];\n  // Interior-line breakpoints (multi-file): the file id of THIS function's source\n  // file (index into `vibe.dbgfiles`), emitted alongside the line so the runner\n  // matches `--break <file>:<line>` against the right file. 0 when off.\n  dbg_line_file_id: Int;\n  // #706 (RC): names live-in to the innermost enclosing `while` loop. A loop body\n  // re-executes, so passing such an owned heap value to a consuming call frees it\n  // on iteration 1 and dangles on the next (use-after-free). compile_call emits a\n  // guarded rc_dup for a bare-ident owning arg whose name is in this set, so each\n  // iteration's consume is balanced and the loop-carried reference survives. The\n  // EWhile codegen sets this to the live-in locals around the body and restores\n  // it after (a shared mutable array; bindings declared inside the body are never\n  // added). Empty outside any loop; rc_dup is a no-op under bump, so the\n  // bump-built compiler is unaffected.\n  loop_borrowed_names: Array[String];\n  // #706 leak follow-up: append-only per-function log — one entry per loop-\n  // borrowed identifier name each time compile_call emits the protective\n  // rc_dup (see loop_borrowed_names above). That dup+the callee's own internal\n  // drop cancel out across the loop, so the textual occurrence the Perceus plan\n  // treated as \"one real consume\" of the binding actually consumes NOTHING from\n  // it — the plan's `remaining` count is therefore one too low per occurrence,\n  // and it omits the function-exit drop the binding still needs. The function\n  // epilogue (linked_compile.vibe) counts each function param's occurrences in\n  // this log and emits that many EXTRA rc_drop calls, exactly compensating\n  // without touching the plan's borrow/consume decisions anywhere else (so it\n  // cannot perturb a path the plan and codegen already agree on).\n  loop_consumed_names: Array[String];\n  // ADR-0092 Phase 1 (drop-guided reuse, narrow fusion): parallel stacks\n  // scoped by an ELet whose planned scope-end drop can be moved to last use.\n  // compile_expr_tail pushes (name, flag_local) before compiling a let body\n  // that is exactly `match <name> { ... }` and truncates after; compile_match,\n  // on a PCtor arm whose payload arity equals its tail constructor's field\n  // count (same block size by layout), consumes the unique scrutinee block in\n  // place and sets the flag local to 1. The ELet guards its scope-end drop on\n  // the flag (0 = not reused on the taken path, drop exactly as before).\n  // Same push/truncate discipline as loop_borrowed_names above.\n  reuse_scrutinee_names: Array[String];\n  reuse_flag_locals: Array[Int];\n  // #707: names of user-defined `let`s whose body provably tail-reaches only\n  // `Array::get`/`Map::get`/`__index` (transitively, through if/match/wrapper\n  // calls to other names already in this list) — computed once per compile via\n  // `compute_borrow_returning_names` over the merged program. compile_call's\n  // `cc_is_borrow_ret_call` treats a call to one of these exactly like a direct\n  // `Array::get`/`Map::get`/`__index` call: its result is a borrowed view of a\n  // heap element (no refcount bump), so passing it into an OWNING position\n  // (ctor field / consuming call arg) needs the same guarded rc_dup or the\n  // element is double-freed when its container is later dropped (e.g. a\n  // `peek(tokens, pos)` wrapper around `Array::get`). Empty outside RC.\n  borrow_ret_names: Array[String];\n  // ADR-0092 borrow-inference slice 1: whole-program set of user fns whose\n  // arg0 ABI is borrowed (compute_borrow_arg0_user_fns). The call-emission\n  // borrow check (compile_call.vibe) and the plan builder both consult it;\n  // the callee-side epilogue drop for that param is filtered at the\n  // linked_compile plan site. Empty outside the linked RC path.\n  borrow_arg0_user: Array[String];\n  // The subset of borrow_arg0_user that may RETURN an unowned interior view\n  // (compute_may_return_view_fns, intersected in linked_compile). The plan\n  // builder marks view-call let-bindings from it (PCtx.view_ret_user).\n  // Empty outside the linked RC path.\n  borrow_view_ret: Array[String];\n  // #710: names of top-level functions whose DECLARED return type (from\n  // their `let f: (...) -> R = ...` signature) is provably scalar (Int/Bool/\n  // Unit) — computed once via `compute_scalar_returning_names` over the\n  // merged program. The ELet ECall branch (compile_expr_tail.vibe) consults\n  // this to skip `heap_binding_names` for `let n = f(...)` when `f` is one of\n  // these: without it, ANY non-borrow-ret call result defaults to heap, so a\n  // binding that is really a plain Int (e.g. `build_import_plan(...) -> Int`)\n  // gets treated as a tagged pointer. If that binding is later aliased more\n  // than once, the Perceus plan schedules a PaAliasDup for it, and\n  // `emit_rc_dup_local` untags-and-derefs the \"pointer\" — for a small int\n  // like 0 that reads/writes near address -4, a `memory access out of\n  // bounds` trap, not a leak. Empty outside RC.\n  scalar_ret_names: Array[String];\n  // #875 fix 2: single-slot mutable hint (0 = unset, 1 entry = pending name),\n  // set by the ELetRec codegen handler (compile_expr_tail.vibe, `__tag == 10`)\n  // immediately before compiling a `let rec NAME = (...) -> { ... }` closure's\n  // OWN value, and consumed (read + cleared) as the very first action of\n  // compile_lambda -- the sole, immediate callee that dispatch to an EFn value\n  // reaches (compile_expr -> compile_expr_tail chain -> compile_expr_tail3\n  // `__tag == 24`), so the window between set and consume contains no\n  // throwable code and no other codegen call. Lets compile_lambda force NAME\n  // into its own capture list (collect_free_vars_indexed_self) even when NAME\n  // collides by bare string equality with an unrelated entry already in\n  // capture_name_index (see collect_free_vars_indexed_self's doc comment in\n  // common_analysis/common_analysis.vibe) -- without this, a colliding let-rec closure's\n  // self-reference is wrongly treated as \"resolves globally\" and never\n  // captured, so it has no way to call itself (#875). Any OTHER EFn value\n  // (anonymous lambda, non-rec `let`) leaves this empty, so capture\n  // computation is byte-identical to before. Reset to empty in every\n  // freshly-derived per-lambda CompileCtx (see compile_lambda.vibe's\n  // `lam_ctx`) so a nested let-rec inside a closure body starts with no\n  // stale hint from its enclosing scope.\n  pending_letrec_self_name: Array[String];\n  // #1107 Phase 4: append-only recorder of every funcref-table slot codegen\n  // actually materializes as a closure value — the `(table_slot<<2)|2`\n  // constant in compile_expr's named-function-as-value branch and the\n  // single `table_slot` computation in compile_lambda (which feeds both the\n  // captureless i64-const form and the closure-header i32.store forms).\n  // The linear backend's element section is then built from exactly this\n  // set (run-compressed active segments, emit_element_section_active_runs)\n  // instead of registering every user function + lambda: a slot no closure\n  // value ever carries can never reach call_indirect, so it stays ref.null.\n  // Slot NUMBERING and the declared table size are unchanged. Shared BY\n  // REFERENCE into per-lambda derived ctxs (like the other append-only logs\n  // above) so nested-lambda recordings land in the module-level array.\n  table_slots_used: Array[Int];\n  // #1259 step 7 groundwork: the lambda index this function's NEXT lambda\n  // must receive, preassigned before any body is emitted.\n  //\n  // compile_lambda takes a lambda's function index from the live length of\n  // the shared LambdaTable, and emits it into the body as a table_slot\n  // immediate -- so a function's output bytes depend on how many lambdas\n  // every function compiled before it produced. That is what stops a worker\n  // from ever compiling a body on its own, and it is the thing a frozen\n  // WholeProgramPlan has to remove (docs/compiler-parallelism.md).\n  //\n  // A one-element mutable cell, shared BY REFERENCE into per-lambda derived\n  // ctxs exactly like table_slots_used above, so a nested lambda advances the\n  // same counter its enclosing function does. Seeded per user function from\n  // the counting pass (plan_lambda_bases) and checked against the live length\n  // at every allocation: while the two agree, the plan is a faithful\n  // prediction of what the sequential walk does, which is what makes flipping\n  // compile_lambda over to it a no-op on the emitted bytes.\n  //\n  // Empty disables the check entirely (the gc lane and any ctx built outside\n  // the planned body loop).\n  lambda_plan_next: Array[Int];\n  // #644: static (wasm code offset -> source file/line) recorder for the\n  // `vibe.linemap` custom section. Shared by reference across every\n  // TOP-LEVEL function's CompileCtx (like `cov` above); `linemap.cur_fn`\n  // holds the user-function index (`bi`) currently being compiled, set by\n  // linked_compile.vibe's main function loop before each body. Every\n  // emit_dbg_line_stmt call (compile_expr_tail.vibe) appends the body-buffer-\n  // relative byte offset of its probe alongside `linemap.cur_fn`'s current\n  // value, the file id and the line. Disabled (linemap_disabled()) outside\n  // debug-break builds, and ALSO forced disabled on every lambda-derived\n  // ctx (compile_lambda.vibe) -- a lambda compiles into its OWN separate\n  // wasm function body buffer, so an offset recorded against `cur_fn`'s\n  // enclosing top-level index would point at the wrong function entirely.\n  // That is a known, documented gap (like the funcmap's entry-file-only\n  // scope): lambda-body statements are simply absent from the linemap.\n  linemap: LineMapState\n}\n\n/// Interior-line breakpoints (span-arc step5, multi-file): per-file provenance the\n/// break codegen needs to emit `vibe::dbg_line(<file_id>, <line>)` and a\n/// `vibe.dbgfiles` section. `files[k]` is the basename of source file id k;\n/// `file_nls[k]` its newline char-offsets; `stmt_file_id[s]` the file id of merged\n/// top-level statement s. Empty (via empty_dbg_prov) on non-break builds.\nexport struct DbgProv {\n  files: Array[String];\n  file_nls: Array[Array[Int]];\n  stmt_file_id: Array[Int]\n}\n\nexport fn empty_dbg_prov() -> DbgProv {\n  DbgProv::{\n    files: array_empty(),\n    file_nls: array_empty(),\n    stmt_file_id: array_empty()\n  }\n}\n\n/// #644: static line-map recorder threaded via CompileCtx.linemap. Mirrors\n/// CovState's cur_fn/append-only-log shape: `cur_fn` is a 1-element mutable\n/// cell holding the top-level user-function index (`bi`) currently being\n/// compiled (set once per function by linked_compile.vibe's main loop,\n/// BEFORE that function's body_buf is compiled); `funcs`/`offsets`/\n/// `file_ids`/`lines` are parallel append-only logs, one entry per\n/// emit_dbg_line_stmt probe, recording (that probe's owning `bi`, the\n/// probe's body_buf-relative byte offset, the file id, the 1-based line).\n/// `offsets` are relative to the START of the function's own instruction\n/// buffer (body_buf) -- NOT yet shifted by that function's locals-\n/// declaration header length, since body_buf is compiled before the\n/// final per-function locals header is known. linked_compile.vibe adds\n/// each function's header length (computed while assembling the code\n/// section) before emitting the final `vibe.linemap` custom section, so\n/// the section's offsets land exactly where wasmtime's own\n/// `FrameInfo::func_offset()` measures from (the first byte of the code\n/// entry, i.e. including the locals declaration -- verified empirically\n/// against wasmtime 45's WasmBacktrace).\nexport struct LineMapState {\n  enabled: Bool;\n  cur_fn: Array[Int];\n  funcs: Array[Int];\n  offsets: Array[Int];\n  file_ids: Array[Int];\n  lines: Array[Int]\n}\n\n/// A disabled LineMapState (non-debug-break builds, and every lambda-derived\n/// CompileCtx): `record` is a no-op, so codegen output is byte-identical.\nexport fn linemap_disabled() -> LineMapState {\n  LineMapState::{\n    enabled: false,\n    cur_fn: [\n      0\n    ],\n    funcs: array_empty(),\n    offsets: array_empty(),\n    file_ids: array_empty(),\n    lines: array_empty()\n  }\n}\n\nexport struct CompileCtxGc {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ref_local_indices: Array[Int];\n  refcell_type_idx: Int;\n  closure_type_base: Int;\n  // Named gc_ctor_table, NOT ctor_table: codegen resolves record fields by\n  // name-first-match across ALL struct declarations (compile_expr_tail4 EDot),\n  // so a field name shared with CompileCtx at a DIFFERENT position reads the\n  // wrong slot. CompileCtx.ctor_table sits at index 6; this one is index 9 --\n  // sharing the name made every gc-lane ctor lookup read ref_local_indices\n  // (empty) instead of the table. See the field-collision issue for the\n  // root-cause fix direction.\n  gc_ctor_table: CtorTable;\n  // #538: module-level literal constants (`let op_call = 16` etc.). Kind 0 =\n  // Int/Bool (value in gc_const_ivals), kind 1 = String (value in\n  // gc_const_svals, rendered via the string table). All fields gc_-prefixed\n  // for the same collision reason as gc_ctor_table (CompileCtx carries\n  // const_int_names/const_int_values at different slots).\n  gc_const_names: Array[String];\n  gc_const_kinds: Array[Int];\n  gc_const_ivals: Array[Int];\n  gc_const_svals: Array[String];\n  // #538: module-level COMPUTED values (`let t = Bytes::from_array([..])`):\n  // one mutable i64 wasm global each (index 1 + position; global 0 is the\n  // heap pointer), initialized at the top of _start in statement order.\n  gc_global_names: Array[String];\n  // #538 P4.5: locals KNOWN to hold f64 raw bits (shape-tracked at let-bind:\n  // float literal / Int::to_double / float arithmetic). Fresh per function\n  // (like ref_cell_names). Arithmetic on a floatish operand emits real f64\n  // ops — the unconditional i64 ops silently zeroed float-literal parsing\n  // (lexer parse_frac_digits) when the gc-compiled compiler ran. Best-effort:\n  // annotated Double params and tuple-destructured floats are NOT tracked.\n  //\n  // #1032: tracked by local SLOT INDEX (not name -- this used to be\n  // Array[String], name-keyed and unpruned, which let a name reused with a\n  // different type across sibling branches keep its stale classification;\n  // see gc_bool_locals below, which had and fixed the identical bug for\n  // #1015). Entries are pruned at every branch/match-arm/for-in scope-exit\n  // boundary via gc_slot_log_reset_above(ctx.gc_float_locals, floor), the\n  // same discipline gc_bool_locals and gc_agg_local_slots already follow at\n  // those same boundaries (see backend_expr.vibe's EIf/for-in/handle and\n  // backend_match.vibe's match-arm truncation sites). Without this, `if c {\n  // let x = 1.5; .. } else { let x = 1; f(x) }` would misclassify the else\n  // branch's `x` (a DIFFERENT binding that happens to reuse the same\n  // now-freed slot) as floatish too.\n  gc_float_locals: Array[Int];\n  // #1015: gc twin of the linear lane's int_local_slots kind-3 (boolish)\n  // tracking -- locals (params/lets) KNOWN to hold a Bool. Bool and Int\n  // share the same gc-lane numeric representation (no distinguishing\n  // runtime type tag between them, mirroring the linear backend), so the\n  // generic runtime `__to_string` dispatch cannot tell them apart; this\n  // set lets `bc_expr_is_boolish`/`gc_expr_is_boolish` recognize a\n  // Bool-typed identifier statically instead, the same way `gc_float_locals`\n  // lets floatish idents take the f64 path.\n  //\n  // Tracked by local SLOT INDEX (not name; see gc_float_locals above, which\n  // follows the same design): entries are pruned at every\n  // branch/match-arm/for-in scope-exit boundary via\n  // gc_slot_log_reset_above(ctx.gc_bool_locals, floor), the exact same\n  // \"slot >= floor is about to be reused by a sibling scope, drop stale\n  // entries\" discipline agg_log_reset_above already applies to\n  // gc_agg_local_slots at those same boundaries (see backend_expr.vibe's\n  // EIf/for-in/handle and backend_match.vibe's match-arm truncation sites).\n  // Without this, `if c { let b = true; to_string(b) } else { let b = 1;\n  // to_string(b) }` would misclassify the else branch's `b` (a DIFFERENT\n  // binding that happens to reuse the same now-freed slot) as boolish too.\n  gc_bool_locals: Array[Int];\n  // #1015: computed ONCE per compile (backend_body.vibe's\n  // gc_to_string_resolves_to_show_wrapper, before any CompileCtxGc is\n  // constructed) and copied unchanged into every ctx thereafter (including\n  // lambda ctxs, backend_lambda_ctx.vibe). True iff this program's own\n  // top-level `to_string` (if any) structurally matches the Show-bounded\n  // generic forwarding wrapper `to_string[T: Show](x: T) -> String {\n  // __to_string(x) }`. Gates backend_call.vibe's \"to_string\" call-site fast\n  // path -- required so a SAME-file user-defined `fn to_string(x: Bool) ->\n  // String { \"custom\" }` (a real, different function) is not silently\n  // replaced by the Bool/Float formatter (code review, #1015): the gc\n  // lane's single-file compile model rules out cross-file name collisions\n  // (unlike linear, which needs a mangled-name match), but not this\n  // same-file case.\n  gc_to_string_is_show_wrapper: Bool;\n  // #724: gc twin of CompileCtx.agg_local_slots (same encoding + pruning\n  // discipline) so the gc lane's structural ==/!= also covers non-literal\n  // aggregate bindings. gc_-prefixed per the #722 field-collision convention.\n  gc_agg_local_slots: Array[Int];\n  // #724 round 2: gc twins of agg_ret_names/agg_ret_infos.\n  gc_agg_ret_names: Array[String];\n  gc_agg_ret_infos: Array[Int];\n  // #1109 gc parity: gc twin of CompileCtx.table_slots_used (see that\n  // field's doc comment for the full rationale) -- append-only recorder of\n  // every funcref-table slot the gc lane's own closure codegen\n  // (backend_expr.vibe's named-fn-as-value branch, backend_lambda_body.vibe's\n  // closure construction) actually materializes as a closure value. The gc\n  // lane uses the SAME tagged-i64 funcref-table + heap-allocated\n  // closure-header scheme as linear (backend_lambda_emit.vibe), so the same\n  // \"record used slots, rebuild the element section from exactly that set\"\n  // approach applies unchanged.\n  table_slots_used: Array[Int]\n}\n\n//# Functions\n\n/// #678: prune the integer-slot log so it carries NO entry for any slot index\n/// >= `floor`. Called right after `local_names` is truncated to `floor` at a\n/// branch / match-arm / for-in boundary, where those high slots are about to be\n/// reused by the sibling scope. A `let`/`let mut` reusing a slot re-logs its own\n/// int-ness, but a NON-`let` binder (match-arm / catch-all / for-in pattern var)\n/// logs nothing — so without this prune its slot would still read the previous\n/// sibling's stale `int=1` and a string bound there would wrongly take the\n/// `i64.eq` path. Compacts the array IN PLACE (entries are unordered, so a plain\n/// truncate-by-count will not do): keep entries for slots < floor, then truncate.\n/// No temporary allocation — this runs at every branch / arm boundary while\n/// compiling, and a fresh array per call piles up on the bump/RC heap during one\n/// big function and can trip a heap-marginal compile.\nexport fn int_log_reset_above(ctx: CompileCtx, floor: Int) -> Unit {\n  let arr = ctx.int_local_slots\n  let n = Array::length(arr)\n  let mut w = 0\n  let mut i = 0\n  while i < n {\n    let e = Array::get(arr, i)\n    // #769: entries are slot*4 + kind now (see slot_is_intish).\n    if e / 4 < floor {\n      Array::set(arr, w, e)\n      w = w + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  Array::truncate(arr, w)\n}\n\n/// #1062 follow-up: the float-log twin of `int_log_reset_above`, for exactly\n/// the same reason. `bind_match_pat` now logs a pattern-bound constructor\n/// field into `float_local_slots` when its declared type is Double/Float (see\n/// CompileCtx.ctor_float_fields), but a NON-float field bound at the SAME\n/// local slot by a SIBLING match arm (arms share slot numbers -- `local_names`\n/// is truncated back to `names_len_at_match` before every arm, see the call\n/// sites in compile_match.vibe) never logs anything to override a stale\n/// float=1 entry a PRIOR arm left at that slot. Left unpruned, that stale\n/// entry survives via float_local_slots' normal \"most recent entry per slot\n/// wins\" lookup (slot_is_floatish) and makes the later arm's plain Int/String\n/// field take the f64 reinterpret-bits arithmetic path -- silently corrupting\n/// ordinary integer arithmetic (discovered when re-enabling the ctor-float\n/// check caused ~37 unrelated selfhost unit-test regressions: the compiler's\n/// own AST enums, e.g. Expr/Pat/Token, mix a Double-carrying variant\n/// (EFloat/PFloat/TFloat) with many non-float siblings matched in the same\n/// `match`, at the same rotating slot numbers). Same compaction discipline as\n/// int_log_reset_above: keep entries for slots < floor, truncate the rest.\nexport fn float_log_reset_above(ctx: CompileCtx, floor: Int) -> Unit {\n  let arr = ctx.float_local_slots\n  let n = Array::length(arr)\n  let mut w = 0\n  let mut i = 0\n  while i < n {\n    let e = Array::get(arr, i)\n    // Entries are slot*2 + flag (see slot_is_floatish).\n    if e / 2 < floor {\n      Array::set(arr, w, e)\n      w = w + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  Array::truncate(arr, w)\n}\n\n/// #724: prune the aggregate-shape log (see CompileCtx.agg_local_slots) at the\n/// same branch/arm boundaries as int_log_reset_above — a slot reused by a\n/// non-`let` binder must not be read as a stale tuple/ctor, or the structural\n/// comparator would walk a non-aggregate value.\nexport fn agg_log_reset_above(arr: Array[Int], floor: Int) -> Unit {\n  let n = Array::length(arr)\n  let mut w = 0\n  let mut i = 0\n  while i < n {\n    let e = Array::get(arr, i)\n    if e / 256 < floor {\n      Array::set(arr, w, e)\n      w = w + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  Array::truncate(arr, w)\n}\n\n/// #1015: gc-lane twin of int_log_reset_above, for a PLAIN slot-indexed array\n/// (no packed kind -- e.g. CompileCtxGc.gc_bool_locals, which unlike\n/// CompileCtx.int_local_slots tracks exactly one thing, so entries are raw\n/// slot ints rather than slot*4+kind). Same discipline: called right after\n/// `local_names` is truncated to `floor` at a branch/match-arm/for-in\n/// boundary, so a stale entry for a slot about to be reused by a sibling\n/// scope does not leak into that sibling's classification of an unrelated\n/// binding landing on the same freed slot.\nexport fn gc_slot_log_reset_above(arr: Array[Int], floor: Int) -> Unit {\n  let n = Array::length(arr)\n  let mut w = 0\n  let mut i = 0\n  while i < n {\n    let e = Array::get(arr, i)\n    if e < floor {\n      Array::set(arr, w, e)\n      w = w + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  Array::truncate(arr, w)\n}\n\n/// #672 (post-#724): dual-array twin of agg_log_reset_above — prunes\n/// agg_local_slots AND its parallel agg_local_exprs in lockstep (same\n/// keep/drop decision, driven by the slots array, applied to both), so the\n/// two arrays stay the same length / index-aligned after a branch/arm\n/// boundary prunes stale entries. See CompileCtx.agg_local_exprs.\nexport fn agg_log_reset_above2(arr: Array[Int], exprs: Array[Expr], floor: Int) -> Unit {\n  let n = Array::length(arr)\n  let mut w = 0\n  let mut i = 0\n  while i < n {\n    let e = Array::get(arr, i)\n    if e / 256 < floor {\n      Array::set(arr, w, e)\n      Array::set(exprs, w, Array::get(exprs, i))\n      w = w + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  Array::truncate(arr, w)\n  Array::truncate(exprs, w)\n}\n\n/// #724: most-recent aggregate-shape entry for `slot` — `kind*64 + n`\n/// (kind 1 = tuple/arity, 2 = ctor/field count), or -1 when untracked /\n/// overridden by a non-aggregate rebind.\nexport fn agg_slot_lookup(arr: Array[Int], slot: Int) -> Int {\n  let mut i = Array::length(arr) - 1\n  let mut out = 0 - 1\n  while i >= 0 {\n    let e = Array::get(arr, i)\n    if e / 256 == slot {\n      out = e % 256\n      i = 0 - 1\n    } else {\n      i = i - 1\n    }\n  }\n  if out == 0 {\n    0 - 1\n  } else {\n    out\n  }\n}\n\n/// #672 (post-#724): companion to agg_slot_lookup — the shape-literal Expr\n/// paired with the most-recent tracked entry for `slot` (same rightmost-match\n/// scan), or EInt(0) when the slot has no entry at all. Callers only read the\n/// result after agg_slot_lookup has confirmed a kind 1 (tuple) or kind 2\n/// (ctor/record) entry exists for the slot, so the EInt(0) fallback is never\n/// actually consulted as a shape in practice — it just keeps this total.\nexport fn agg_expr_lookup(arr: Array[Int], exprs: Array[Expr], slot: Int) -> Expr {\n  let mut i = Array::length(arr) - 1\n  let mut out = EInt(0)\n  while i >= 0 {\n    let e = Array::get(arr, i)\n    if e / 256 == slot {\n      out = Array::get(exprs, i)\n      i = 0 - 1\n    } else {\n      i = i - 1\n    }\n  }\n  out\n}\n\n/// #724 round 2: aggregate-shape classification from a DECLARED TypeExpr —\n/// the static dual of the shape log below, used for function RETURN types\n/// (`let a = mk_pt(...)` — the value shape is invisible at the ELet, but the\n/// callee's signature names it) and annotated params. Same `kind*64 + n`\n/// encoding; n = 63 is the \"dynamic field count\" sentinel: enum-typed values\n/// have a variant-dependent argc, so the comparator reads argc@4 from the\n/// value at runtime instead of unrolling a static count.\nexport fn agg_info_of_type_name(ct: CtorTable, tname: String) -> Int {\n  let mut si = 0\n  let mut out = 0\n  while si < Array::length(ct.struct_names) {\n    if Array::get(ct.struct_names, si) == tname {\n      out = 128 + Array::length(Array::get(ct.struct_field_names, si))\n      si = Array::length(ct.struct_names)\n    } else {\n      si = si + 1\n    }\n  }\n  if out > 0 {\n    out\n  } else {\n    let mut ti = 0\n    let mut is_enum = false\n    while ti < Array::length(ct.type_names) {\n      if Array::get(ct.type_names, ti) == tname {\n        is_enum = true\n        ti = Array::length(ct.type_names)\n      } else {\n        ti = ti + 1\n      }\n    }\n    if is_enum {\n      128 + 63\n    } else {\n      0\n    }\n  }\n}\n\nexport fn agg_info_of_type_expr(ct: CtorTable, te: TypeExpr) -> Int {\n  match te {\n    TyTuple(tels) => 64 + Array::length(tels),\n    TyName(tname) => agg_info_of_type_name(ct, tname),\n    TyApp(tname, _) => agg_info_of_type_name(ct, tname),\n    _ => 0\n  }\n}\n\n/// #724 round 2: program-wide (fn name -> aggregate return shape) table,\n/// filled from each top-level `let f: (..) -> R = (..) -> {..}`'s declared\n/// return type (the SLet annotation's TyFn ret, falling back to the EFn's\n/// own return annotation). The `==` codegen consults it for `let a = f(..)`\n/// bindings. Structural, all-lane-safe knowledge — unannotated returns stay\n/// untracked (generic-eq fallback), preserving backend parity.\nexport fn compute_agg_returning(stmts: Array[Stmt], ct: CtorTable, out_names: Array[String], out_infos: Array[Int]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, ann, value) => match value {\n        EFn(_, _, _, fn_ret, _, _) => {\n          let ret = match ann {\n            Some(at) => match at {\n              TyFn(_, r, _) => Some(r),\n              _ => fn_ret\n            },\n            None => fn_ret\n          }\n          match ret {\n            Some(rte) => {\n              let info = agg_info_of_type_expr(ct, rte)\n              if info > 0 {\n                Array::push(out_names, name)\n                Array::push(out_infos, info)\n              } else {\n                ()\n              }\n            },\n            None => ()\n          }\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nexport fn agg_ret_lookup(names: Array[String], infos: Array[Int], fname: String) -> Int {\n  let mut i = 0\n  let mut out = 0 - 1\n  while i < Array::length(names) {\n    if Array::get(names, i) == fname {\n      out = Array::get(infos, i)\n      i = Array::length(names)\n    } else {\n      i = i + 1\n    }\n  }\n  out\n}\n\n/// #724: non-throwing last-match local lookup (resolve_local throws on a\n/// missing name, which is wrong for OPTIONAL classification — a bare ident\n/// can name a global function or ctor instead of a local).\nexport fn find_local_slot(names: Array[String], name: String) -> Int {\n  let mut i = Array::length(names) - 1\n  let mut result = 0 - 1\n  while i >= 0 {\n    if Array::get(names, i) == name {\n      result = i\n      i = 0 - 1\n    } else {\n      i = i - 1\n    }\n  }\n  result\n}\n\n/// #724: aggregate-shape info for a bare-ident operand of `==`/`!=`:\n/// resolves the ident's CURRENT slot and returns its latest log entry\n/// (`kind*64 + n`), or -1 for non-idents / untracked slots.\nexport fn agg_info_of_ident(arr: Array[Int], e: Expr, local_names: Array[String]) -> Int {\n  match e {\n    EIdent(nm, _) => {\n      let slot = find_local_slot(local_names, nm)\n      if slot >= 0 {\n        agg_slot_lookup(arr, slot)\n      } else {\n        0 - 1\n      }\n    },\n    _ => 0 - 1\n  }\n}\n\n/// #672 (post-#724): companion to agg_info_of_ident — the tracked shape-\n/// literal Expr for a bare-ident operand (same ident -> slot resolution), or\n/// EInt(0) when the ident is not a tracked slot. Callers gate on\n/// agg_info_of_ident's kind first, same discipline as agg_expr_lookup.\nexport fn agg_expr_of_ident(arr: Array[Int], exprs: Array[Expr], e: Expr, local_names: Array[String]) -> Expr {\n  match e {\n    EIdent(nm, _) => {\n      let slot = find_local_slot(local_names, nm)\n      if slot >= 0 {\n        agg_expr_lookup(arr, exprs, slot)\n      } else {\n        EInt(0)\n      }\n    },\n    _ => EInt(0)\n  }\n}\n\nexport fn is_efn(expr: Expr) -> Bool {\n  match expr {\n    EFn(_, _, _, _, _, _) => true,\n    _ => false\n  }\n}\n\nexport fn is_pint(p: Pat) -> Bool {\n  match p {\n    PInt(_) => true,\n    _ => false\n  }\n}\n\nexport fn is_pfloat(p: Pat) -> Bool {\n  match p {\n    PFloat(_) => true,\n    _ => false\n  }\n}\n\nexport fn is_slet(stmt: Stmt) -> Bool {\n  match stmt {\n    SLet(_, _, _, _, _) => true,\n    _ => false\n  }\n}\n\nexport fn expr_tag(expr: Expr) -> Int {\n  match expr {\n    EInt(_) => 0,\n    EBool(_) => 1,\n    EFloat(_) => 2,\n    EString(_) => 3,\n    EIdent(_, _) => 4,\n    EBinOp(_, _, _) => 5,\n    EUnaryOp(_, _) => 6,\n    EIf(_, _, _) => 7,\n    ECall(_, _, _) => 8,\n    ELet(_, _, _, _) => 9,\n    ELetRec(_, _, _) => 10,\n    ELetMut(_, _, _, _) => 11,\n    EAssign(_, _, _) => 12,\n    EAssignOp(_, _, _, _) => 13,\n    ESeq(_, _) => 14,\n    ETuple(_) => 15,\n    EMatch(_, _) => 16,\n    EArray(_) => 17,\n    EForIn(_, _, _, _) => 18,\n    EWhile(_, _) => 19,\n    EBreak(_) => 20,\n    EContinue(_) => 21,\n    EUnit => 22,\n    EFn(_, _, _, _, _, _) => 24,\n    ELoop(_, _) => 25,\n    EReturn(_) => 26,\n    _ => -1\n  }\n}\n\nexport fn is_pbind(p: Pat) -> Bool {\n  match p {\n    PBind(_) => true,\n    _ => false\n  }\n}\n\nexport fn is_pbool(p: Pat) -> Bool {\n  match p {\n    PBool(_) => true,\n    _ => false\n  }\n}\n\nexport fn is_pctor(p: Pat) -> Bool {\n  match p {\n    PCtor(_, _) => true,\n    _ => false\n  }\n}\n\nexport fn is_pwild(p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    _ => false\n  }\n}\n\nexport fn is_earray(expr: Expr) -> Bool {\n  match expr {\n    EArray(_) => true,\n    _ => false\n  }\n}\n\nexport fn is_eident(expr: Expr) -> Bool {\n  match expr {\n    EIdent(_, _) => true,\n    _ => false\n  }\n}\n\nexport fn is_etuple(expr: Expr) -> Bool {\n  match expr {\n    ETuple(_) => true,\n    _ => false\n  }\n}\n\nexport fn is_ptuple(p: Pat) -> Bool {\n  match p {\n    PTuple(_) => true,\n    _ => false\n  }\n}\n\nlet op_i32_eq = 70\n\nlet op_i32_ne = 71\n\nexport fn is_erecord(expr: Expr) -> Bool {\n  match expr {\n    ERecord(_, _, _) => true,\n    _ => false\n  }\n}\n\nexport fn is_pstring(p: Pat) -> Bool {\n  match p {\n    PString(_) => true,\n    _ => false\n  }\n}\n\nlet op_i32_eqz = 69\n\nlet op_i32_mul = 108\n\nlet op_i32_sub = 107\n\nexport fn emit_i32_eq(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_eq)\n}\n\nexport fn emit_i32_ne(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_ne)\n}\n\nexport fn get_arm_pat(arm: (Pat, Expr)) -> Pat {\n  let (p, _) = arm\n  p\n}\n\nexport fn lookup_ctor(ctor_names: Array[String], name: String, i: Int) -> Int {\n  if i >= Array::length(ctor_names) {\n    -1\n  }\n  else if Array::get(ctor_names, i) == name {\n    i\n  }\n  else lookup_ctor(ctor_names, name, i + 1)\n}\n\n/// Build CtorTable.names_sorted / names_sorted_pos from the name list: a\n/// stable sort permutation, so equal names keep insertion order and the\n/// leftmost binary-search hit maps to the same index the linear scan found.\nexport fn ctor_sorted_index(names: Array[String]) -> (Array[String], Array[Int]) {\n  let perm = sort_perm_by_names(names)\n  (apply_perm_strings(names, perm), perm)\n}\n\n/// O(log N) replacement for `lookup_ctor(ct.names, name, 0)` at CtorTable\n/// call sites. Falls back to the linear scan when the sorted view is absent\n/// (defensive: a table built without ctor_sorted_index stays correct).\nexport fn ctor_table_index_of(ct: CtorTable, name: String) -> Int {\n  if Array::length(ct.names_sorted) != Array::length(ct.names) {\n    lookup_ctor(ct.names, name, 0)\n  } else {\n    let slot = bsearch_leftmost(ct.names_sorted, name)\n    if slot < 0 {\n      -1\n    } else {\n      Array::get(ct.names_sorted_pos, slot)\n    }\n  }\n}\n\n/// #1062: is constructor `ctor_idx`'s positional field `field_idx` declared\n/// Double/Float? See CompileCtx.ctor_float_fields for the encoding.\nexport fn ctor_field_is_float(ctx: CompileCtx, ctor_idx: Int, field_idx: Int) -> Bool {\n  let arr = ctx.ctor_float_fields\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    let e = Array::get(arr, i)\n    if e / 64 == ctor_idx && e % 64 == field_idx {\n      found = true\n      i = Array::length(arr)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// #722: candidates for a NAME-based struct field access. Returns\n/// (ctor_tag, field_idx) for every struct whose field list contains `field`,\n/// in struct-declaration order. Field resolution used to take the FIRST\n/// struct containing the name (type-blind), so a same-named field living at\n/// a DIFFERENT slot in a later struct silently read the wrong slot — which\n/// program shapes hit this depended on the declaration set/order, i.e. the\n/// flat-bundle vs FS-linked lane divergence observed in #722. Callers keep\n/// the first candidate as the static fast path when every candidate agrees\n/// on the slot, and otherwise dispatch at runtime on the value's ctor tag\n/// (struct construction — both the `S::{...}` ctor path and the set-matched\n/// bare-record path — stamps the struct's unique tag at value+0).\nexport fn struct_field_candidates(ct: CtorTable, field: String) -> Array[(Int, Int)] {\n  let out = array_empty()\n  let mut si = 0\n  while si < Array::length(ct.struct_names) {\n    let fnames = Array::get(ct.struct_field_names, si)\n    let mut fi = 0\n    while fi < Array::length(fnames) {\n      if Array::get(fnames, fi) == field {\n        let ci = ctor_table_index_of(ct, Array::get(ct.struct_names, si))\n        let tag = if ci >= 0 {\n          Array::get(ct.tags, ci)\n        } else {\n          -1\n        }\n        Array::push(out, (tag, fi))\n        fi = Array::length(fnames)\n      } else {\n        fi = fi + 1\n      }\n    }\n    si = si + 1\n  }\n  out\n}\n\n/// #722: the subset of `candidates` (beyond the first) whose slot index\n/// DISAGREES with the first candidate's — exactly the cases the static\n/// first-match resolution used to miscompile. Empty result = the static\n/// fast path is sound; non-empty = the caller must emit a runtime tag\n/// dispatch over these, with candidate 0 as the untagged/legacy fallback.\nexport fn struct_field_dispatch_cases(cands: Array[(Int, Int)]) -> Array[(Int, Int)] {\n  let (_, idx0) = Array::get(cands, 0)\n  let out = array_empty()\n  let mut i = 1\n  while i < Array::length(cands) {\n    let (tag_i, idx_i) = Array::get(cands, i)\n    if idx_i != idx0 && tag_i >= 0 {\n      Array::push(out, (tag_i, idx_i))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n/// #722: resolve a bare record literal to a struct by exact field-name-set\n/// match (the same rule the checker uses — `S::{...}` drops the name at\n/// parse time in some construction paths, and hand-built ASTs build ERecord\n/// directly). Returns the struct index or -1. Callers use it to lay the\n/// record out in the struct's DECLARED field order and stamp the struct's\n/// ctor tag, making bare records byte-compatible with `S::{...}` ctor-path\n/// construction (which already reorders to declared order).\nexport fn struct_index_by_field_set(ct: CtorTable, lit_names: Array[String]) -> Int {\n  let mut si = 0\n  let mut found = -1\n  while si < Array::length(ct.struct_names) {\n    let fnames = Array::get(ct.struct_field_names, si)\n    if Array::length(fnames) == Array::length(lit_names) {\n      let mut all = true\n      let mut fi = 0\n      while fi < Array::length(fnames) {\n        let dn = Array::get(fnames, fi)\n        let mut present = false\n        let mut li = 0\n        while li < Array::length(lit_names) {\n          if Array::get(lit_names, li) == dn {\n            present = true\n            li = Array::length(lit_names)\n          } else {\n            li = li + 1\n          }\n        }\n        if present {\n          fi = fi + 1\n        } else {\n          all = false\n          fi = Array::length(fnames)\n        }\n      }\n      if all {\n        found = si\n        si = Array::length(ct.struct_names)\n      } else {\n        si = si + 1\n      }\n    } else {\n      si = si + 1\n    }\n  }\n  found\n}\n\n/// #722: ctor tag for struct index `si`, or 0 (the legacy anonymous-record\n/// type id) when the struct is not in the ctor table.\nexport fn struct_tag_by_index(ct: CtorTable, si: Int) -> Int {\n  let ci = ctor_table_index_of(ct, Array::get(ct.struct_names, si))\n  if ci >= 0 {\n    Array::get(ct.tags, ci)\n  } else {\n    0\n  }\n}\n\nlet op_i32_ge_u = 79\n\nlet op_i32_gt_u = 75\n\nlet op_i64_load = 41\n\nexport fn emit_i32_eqz(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_eqz)\n}\n\nexport fn emit_i32_mul(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_mul)\n}\n\nexport fn emit_i32_sub(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_sub)\n}\n\nexport fn emit_str_ref(buf: Bytes, offset: Int, length: Int) -> Unit {\n  emit_i64_const(buf, offset)\n  emit_i64_const(buf, 32)\n  emit_i64_shl(buf)\n  emit_i64_const(buf, length)\n  emit_i64_or(buf)\n}\n\nexport fn get_arm_body(arm: (Pat, Expr)) -> Expr {\n  let (_, b) = arm\n  b\n}\n\nexport fn get_efn_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EFn(_, _, _, _, _, body) => body,\n    _ => throw(\"not EFn\")\n  }\n}\n\nexport fn get_eif_cond(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EIf(c, _, _) => c,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport fn get_eif_else(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EIf(_, _, e) => e,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport fn get_eif_then(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EIf(_, t, _) => t,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport fn get_elet_val(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELet(_, val, _, _) => val,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport fn is_ctor_call(value: Expr, ct: CtorTable) -> Bool {\n  match value {\n    ECall(callee, _, _) => match callee {\n      EIdent(nm, _) => ctor_table_index_of(ct, nm) >= 0,\n      _ => false\n    },\n    _ => false\n  }\n}\n\nlet op_i64_store = 55\n\n/// #1100: O(log N) replacement for the linear scan over `ft.names` this and\n/// several other call sites (compile_call.vibe's cc_ft_has/cc_ft_first_idx/\n/// fn_idx_in_list/op_is_builtin, compile_expr.vibe's ident-not-local fallback)\n/// used to each do independently -- func_table.names commonly holds several\n/// hundred entries (every builtin plus every user/linked function) and these\n/// scans run once per identifier/call resolved during codegen, the single\n/// largest attributed self-time bucket in a full-closure compile's\n/// --cpu-prof (see .claude/skills/compiler-perf-profiling). Mirrors\n/// ctor_table_index_of exactly, including its defensive linear-scan fallback\n/// for a table built without the sorted view. FIRST-match semantics are\n/// preserved exactly: bsearch_leftmost returns the leftmost slot of an equal\n/// run in the STABLE sort, which is the same entry a forward linear scan\n/// would stop at first (see sorted_index.vibe's stability contract).\nexport fn func_table_index_of(ft: FuncTable, name: String) -> Int {\n  if Array::length(ft.names_sorted) != Array::length(ft.names) {\n    let len = Array::length(ft.names)\n    let mut i = 0\n    let mut found = -1\n    while i < len {\n      if Array::get(ft.names, i) == name {\n        found = i\n        i = len\n      } else {\n        i = i + 1\n      }\n    }\n    found\n  } else {\n    let slot = bsearch_leftmost(ft.names_sorted, name)\n    if slot < 0 {\n      -1\n    } else {\n      Array::get(ft.names_sorted_pos, slot)\n    }\n  }\n}\n\nexport fn resolve_func(ft: FuncTable, name: String) -> (Int, Int, Int) with { Error } {\n  let found = func_table_index_of(ft, name)\n  if found < 0 {\n    throw(String::concat(\"undefined function: \", name))\n  };\n  (Array::get(ft.indices, found), Array::get(ft.params, found), Array::get(ft.returns, found))\n}\n\nexport fn emit_binop_op(buf: Bytes, op: String) -> Unit with { Error } {\n  if op == \"+\" {\n    emit_i64_add(buf)\n  }\n  else if op == \"-\" {\n    emit_i64_sub(buf)\n  }\n  else if op == \"*\" {\n    emit_i64_mul(buf)\n  }\n  else if op == \"/\" {\n    emit_i64_div_s(buf)\n  }\n  else if op == \"%\" {\n    emit_i64_rem_s(buf)\n  }\n  else if op == \"&\" {\n    emit_i64_and(buf)\n  }\n  else if op == \"|\" {\n    emit_i64_or(buf)\n  }\n  else if op == \"^\" {\n    emit_i64_xor(buf)\n  }\n  else if op == \"<<\" {\n    emit_i64_shl(buf)\n  }\n  else if op == \">>\" {\n    emit_i64_shr_s(buf)\n  }\n  else if op == \"==\" {\n    emit_i64_eq(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"!=\" {\n    emit_i64_ne(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"<\" {\n    emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \">\" {\n    emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"<=\" {\n    emit_i64_le_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \">=\" {\n    emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"&&\" {\n    emit_i64_and(buf)\n  }\n  else if op == \"||\" {\n    emit_i64_or(buf)\n  }\n  else {\n    throw(String::concat(\"unsupported binop: \", op))\n  }\n}\n\nexport fn emit_i32_ge_u(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_ge_u)\n}\n\nexport fn emit_i32_gt_u(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_gt_u)\n}\n\nexport fn emit_i64_load(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, op_i64_load)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport fn get_ebinop_op(expr: Expr) -> String with { Error } {\n  match expr {\n    EBinOp(op, _, _) => op,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport fn get_elet_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELet(_, _, body, _) => body,\n    _ => throw(\"not ELet\")\n  }\n}\n\n/// #644: the let-statement's source offset (the `let` keyword token), -1 for\n/// synthesized lets. Break-mode codegen uses it as the dbg_line fallback when\n/// the bound value is a bare literal that carries no offset of its own.\nexport fn get_elet_off(expr: Expr) -> Int with { Error } {\n  match expr {\n    ELet(_, _, _, soff) => soff,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport fn get_eletmut_off(expr: Expr) -> Int with { Error } {\n  match expr {\n    ELetMut(_, _, _, soff) => soff,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport fn get_elet_name(expr: Expr) -> String with { Error } {\n  match expr {\n    ELet(name, _, _, _) => name,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport fn get_func_body(stmt: Stmt) -> Expr with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, _, _, _, body) => body,\n      _ => throw(\"get_func_body: not a function\")\n    },\n    _ => throw(\"get_func_body: not a let statement\")\n  }\n}\n\nexport fn get_slet_expr(stmt: Stmt) -> Expr with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => expr,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport fn get_slet_name(stmt: Stmt) -> String with { Error } {\n  match stmt {\n    SLet(_, _, name, _, _) => name,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport fn get_slet_type(stmt: Stmt) -> Option[TypeExpr] {\n  match stmt {\n    SLet(_, _, _, ty, _) => ty,\n    _ => None\n  }\n}\n\nexport fn resolve_local(names: Array[String], name: String, tag: String) -> Int with { Error } {\n  let mut i = Array::length(names) - 1\n  let mut result = -1\n  while i >= 0 {\n    if Array::get(names, i) == name {\n      result = i\n      i = -1\n    } else {\n      i = i - 1\n    }\n  }\n  if result < 0 {\n    throw(String::concat(String::concat(\"undefined variable (local): \", name), String::concat(\" @\", tag)))\n  }\n  result\n}\n\nexport fn emit_i64_store(buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, op_i64_store)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport fn emit_box_float(buf: Bytes, ctx: CompileCtx, bits_local: Int, box_local: Int) -> Unit {\n  emit_local_set(buf, bits_local)\n  emit_i64_const(buf, 16)\n  emit_call(buf, ctx.rc_alloc_func_idx)\n  emit_local_set(buf, box_local)\n  emit_local_get(buf, box_local)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 16)\n  emit_i32_store(buf, 2, 0)\n  emit_local_get(buf, box_local)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 1)\n  emit_i32_store(buf, 2, 4)\n  emit_local_get(buf, box_local)\n  emit_i32_wrap_i64(buf)\n  emit_local_get(buf, bits_local)\n  emit_i64_store(buf, 3, 8)\n  emit_local_get(buf, box_local)\n  emit_i64_const(buf, 8)\n  emit_i64_add(buf)\n  emit_i64_const(buf, 1)\n  emit_i64_or(buf)\n}\n\nexport fn find_func_stmt(stmts: Array[Stmt], name: String) -> Stmt with { Error } {\n  let len = Array::length(stmts)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(_, _, sname, _, _) => if sname == name {\n        found = i\n        i = len\n      },\n      _ => ()\n    }\n    if found < 0 {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"function not found: \", name))\n  }\n  Array::get(stmts, found)\n}\n\nexport fn emit_unbox_float(buf: Bytes) -> Unit {\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 3, 0)\n}\n\n/// Push the i64 increment that advances an array INDEX counter by ONE LOGICAL\n/// element. Under RC a scalar Int is tagged `n << 1`, and the inline array loops\n/// compare their counter against `Array::length` (which returns a tagged length)\n/// and feed it to `Array::get` (which untags the index). So the counter must\n/// live in tagged space too — stepping by raw 2 (= logical 1). Without RC the\n/// counter is a raw index and steps by 1. Using a raw 1 under RC makes the loop\n/// run twice per element (each read/processed twice; #704).\nexport fn emit_index_one(buf: Bytes, ctx: CompileCtx) -> Unit {\n  if ctx.enable_rc {\n    emit_i64_const(buf, 2)\n  } else {\n    emit_i64_const(buf, 1)\n  }\n}\n\n/// Guarded rc_dup of the heap value in `local_idx` (no-op for scalars/strings):\n/// if it is odd (a heap pointer) with a zero high word (not a string fat\n/// pointer), increment its rc_count at block-4. The single canonical copy — the\n/// codegen files (compile_expr_tail / _tail4 / _tail6 / compile_match /\n/// compile_lambda / compile_call / linked_compile) call this instead of keeping\n/// per-file duplicates.\n/// #715 recurrence guard: base address of the shadow-liveness byte table\n/// (1 byte per heap address at base+vptr) and the reservation pad that keeps\n/// it inside linear memory. Only referenced when compiling with rc_shadow.\nexport fn rc_shadow_base() -> Int {\n  268435456\n}\n\nexport fn rc_shadow_reserve() -> Int {\n  536870912\n}\n\n/// #720: the rc field is the LOW 24 BITS of the rc word (the class id lives in\n/// the high byte of the same word at vptr-1). A raw `store(load(addr)+1)` at\n/// rc == 0xFFFFFF carries into the class byte and wraps rc to 0 -- a couple of\n/// rc ops later the block frees itself with millions of references still\n/// outstanding. Hot shared structures (func/ctor tables, analysis accumulator\n/// arrays) cross 2^24 refs only on large compiles (the entry-dup budgets leak\n/// by design), which made the corruption look layout- and size-dependent.\n/// Saturate instead: once rc hits 0xFFFFFF the block is immortal (never\n/// incremented, never decremented, never freed -- see gen_rc_drop_body's\n/// matching skip). `push_addr` emits the i32 address of the rc word; it is\n/// invoked up to three times, so it must be a pure push.\nexport fn emit_rc_word_inc_saturating(buf: Bytes, push_addr: () -> Unit) -> Unit {\n  push_addr()\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 16777215)\n  // i32.and (0x71) -- no emit_i32_and helper exists\n  bytebuf_push(buf, 113)\n  emit_i32_const(buf, 16777215)\n  emit_i32_ne(buf)\n  emit_if_void(buf)\n  push_addr()\n  push_addr()\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_add(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_end(buf)\n}\n\nexport fn emit_rc_dup_guarded(buf: Bytes, local_idx: Int, rc_shadow: Bool) -> Unit {\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 1)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 32)\n  emit_i64_shr_s(buf)\n  emit_i64_eqz(buf)\n  emit_if_void(buf)\n  // #715 recurrence guard (VIBE_RC=shadow): trap via `unreachable` if the\n  // shadow byte at RC_SHADOW_BASE+vptr says this block was already freed --\n  // a dup-of-freed would otherwise increment the free-list NEXT link.\n  if rc_shadow {\n    emit_local_get(buf, local_idx)\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, rc_shadow_base())\n    emit_i32_add(buf)\n    emit_i32_load8_u(buf, 0, 0)\n    emit_if_void(buf)\n    bytebuf_push(buf, 0)\n    emit_end(buf)\n  } else {\n    ()\n  }\n  emit_rc_word_inc_saturating(buf, () -> {\n    emit_local_get(buf, local_idx)\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 4)\n    emit_i32_sub(buf)\n  })\n  emit_end(buf)\n  emit_end(buf)\n}\n\nexport fn fn_type_param_types(ty: Option[TypeExpr]) -> Option[Array[TypeExpr]] {\n  match ty {\n    Some(t) =>\n    match t {\n      TyFn(args, _, _) => Some(args),\n      _ => None\n    },\n    None => None\n  }\n}\n\nexport fn is_nullary_ctor_ident(value: Expr, ct: CtorTable) -> Bool {\n  match value {\n    EIdent(nm, _) => ctor_table_index_of(ct, nm) >= 0,\n    _ => false\n  }\n}\n\nexport fn name_has_effect_prefix(full: String, eff: String) -> Bool {\n  let el = String::length(eff)\n  let fl = String::length(full)\n  if fl < el + 2 {\n    false\n  } else {\n    let mut ok = true\n    let mut j = 0\n    while j < el {\n      if String::char_code_at(full, j) != String::char_code_at(eff, j) {\n        ok = false\n        j = el\n      } else {\n        j = j + 1\n      }\n    }\n    ok && String::char_code_at(full, el) == 58 && String::char_code_at(full, el + 1) == 58\n  }\n}\n\nexport fn effect_name_to_tag(effect_names: Array[String], full: String) -> Int {\n  let n = Array::length(effect_names)\n  let mut result = 3 + n\n  let mut i = 0\n  while i < n {\n    if name_has_effect_prefix(full, Array::get(effect_names, i)) {\n      result = 3 + i\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nexport fn effect_op_declared_arity(keys: Array[String], arities: Array[Int], full: String) -> Int {\n  let n = Array::length(keys)\n  let mut result = -1\n  let mut i = 0\n  while i < n {\n    if Array::get(keys, i) == full {\n      result = Array::get(arities, i)\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n/// #665: index of a qualified op key (`Eff::Op`) in the global effect_op_keys\n/// table — the operation discriminant for multi-operation handler dispatch.\nexport fn effect_op_index(keys: Array[String], full: String) -> Int {\n  let n = Array::length(keys)\n  let mut result = 0 - 1\n  let mut i = 0\n  while i < n {\n    if Array::get(keys, i) == full {\n      result = i\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nexport fn emit_heap_grow_after_heap_set(buf: Bytes, ctx: CompileCtx) -> Unit {\n  if ctx.heap_grow_check_func_idx >= 0 {\n    emit_call(buf, ctx.heap_grow_check_func_idx)\n  } else {\n    ()\n  }\n}\n")
}

