"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtxGc,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_str_ref,\n  find_func_stmt,\n  lookup_ctor,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_heap_memory_grow_check,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_struct_get,\n  emit_struct_new,\n  emit_struct_set,\n  emit_struct_type_raw,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\n//# Functions\n\nexport fn gc_gen_arr_len_body() -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\nexport fn gc_gen_arr_new_body() -> Bytes {\n  let b = bytebuf_new()\n  emit_global_get(b, 0)\n  emit_local_tee(b, 0)\n  emit_i32_const(b, 76)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  // #415: gc-lane heap bump must grow linear memory like the linear\n  // backend does -- without this any allocation past the initial page\n  // traps OOB (the gc smoke fixture only ever allocated a few bytes).\n  emit_heap_memory_grow_check(b)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 8)\n  emit_i32_store(b, 2, 0)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 0)\n  emit_i32_store(b, 2, 4)\n  emit_local_get(b, 0)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 12)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 8)\n  emit_local_get(b, 0)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\n// #538: real function bodies for Array::slice/concat/truncate/push_all. They\n// previously carried the placeholder table index (= arr_new), so any lookup\n// through the func table (e.g. the __slice container dispatch) called a\n// 0-arg allocator with values still on the stack -- invalid wasm. Built on\n// arr_new/arr_get/arr_push calls so they stay layout-agnostic.\n\n/// (arr, start, end) -> new array of arr[start..end)\nexport fn gc_gen_arr_slice_body(arr_new_idx: Int, arr_get_idx: Int, arr_push_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_call(b, arr_new_idx)\n  emit_local_set(b, 3)\n  emit_local_get(b, 1)\n  emit_local_set(b, 4)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 4)\n  emit_local_get(b, 2)\n  emit_i64_ge_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 3)\n  emit_local_get(b, 0)\n  emit_local_get(b, 4)\n  emit_call(b, arr_get_idx)\n  emit_call(b, arr_push_idx)\n  emit_local_get(b, 4)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 3)\n  b\n}\n\n/// (a, b) -> new array of a's elements then b's\nexport fn gc_gen_arr_concat_body(arr_new_idx: Int, arr_len_idx: Int, arr_get_idx: Int, arr_push_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_call(b, arr_new_idx)\n  emit_local_set(b, 2)\n  emit_i64_const(b, 0)\n  emit_local_set(b, 3)\n  emit_local_get(b, 0)\n  emit_call(b, arr_len_idx)\n  emit_local_set(b, 4)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 4)\n  emit_i64_ge_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 2)\n  emit_local_get(b, 0)\n  emit_local_get(b, 3)\n  emit_call(b, arr_get_idx)\n  emit_call(b, arr_push_idx)\n  emit_local_get(b, 3)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_i64_const(b, 0)\n  emit_local_set(b, 3)\n  emit_local_get(b, 1)\n  emit_call(b, arr_len_idx)\n  emit_local_set(b, 4)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 4)\n  emit_i64_ge_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_local_get(b, 3)\n  emit_call(b, arr_get_idx)\n  emit_call(b, arr_push_idx)\n  emit_local_get(b, 3)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 2)\n  b\n}\n\n/// (arr, n): shrink in place (len@4 of the gc array header)\nexport fn gc_gen_arr_truncate_body() -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_store(b, 2, 4)\n  b\n}\n\n/// (dst, src): append all of src to dst\nexport fn gc_gen_arr_push_all_body(arr_len_idx: Int, arr_get_idx: Int, arr_push_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_i64_const(b, 0)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_call(b, arr_len_idx)\n  emit_local_set(b, 3)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 2)\n  emit_local_get(b, 3)\n  emit_i64_ge_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_local_get(b, 2)\n  emit_call(b, arr_get_idx)\n  emit_call(b, arr_push_idx)\n  emit_local_get(b, 2)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_set(b, 2)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n")
}

