let cli_adapter_source_240 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/compiler/file_compile/file_compile.vibe",
"//# Imports\n\nimport @vibe/compiler/syntax {\n  lex, lex_with_offsets, parse_program, parse_program_located\n}\n\n// #897: this used to also import `empty_stmt_array` via a leaf path into\n// ../../source_compile/wasi_only/path_utils.vibe -- now that wasi_only/ is\n// an index.vpkg boundary, that leaf import is rejected\n// (enforce_incoming_boundary_fs, #729), and `empty_stmt_array` is one of\n// wasi_only/index.vpkg's deliberately undeclared private helpers (see that\n// contract's header). Its body is a one-line forward to this same\n// `array_empty[T]()`, already imported below, so the three call sites that\n// used `empty_stmt_array()` (building an empty Array[Stmt] accumulator) now\n// call `array_empty()` directly instead -- same fix cli_support.vibe needed\n// for the same reason.\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  ExportRenamePlan,\n  append_import_alias_rewritten_non_import_stmts_with_renames,\n  append_non_import_stmts_without_alias_rewrite,\n  apply_export_renames_stmts,\n  build_export_rename_plan,\n  collect_import_alias_collision_locals,\n  collect_import_alias_collision_refs,\n  collect_import_value_renames,\n  export_plan_renames_for,\n  import_value_rename_locals,\n  namespace_private_value_stmts,\n  rewrite_imported_value_stmt_to_local,\n  stmts_have_import_deep,\n  dce_stmts,\n  dir_of_path, resolve_import_path\n}\n\nimport @vibe/compiler/codegen {\n  compile_module, compile_wasi_module, compile_wasi_module_rc, compile_wasi_module_rc_shadow, compile_wasi_module_coverage, compile_wasi_module_trace, compile_wasi_module_break\n}\n\nimport @vibe/compiler/codegen/common_base {\n  DbgProv\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_impl\n}\n\nimport @vibe/compiler/loader {\n  collect_source_groups_fs, load_persistent_source_group_fingerprint_if_valid\n}\n\nimport @vibe/compiler/checker {\n  file_tests_cacheable\n}\n\nimport @vibe/compiler/runtime {\n  TypeDb, db_new, db_set_source, db_typecheck, db_grouped_merged_source,\n  db_typecheck_fs, db_module_source, db_load_artifact, db_store_artifact\n}\n\nimport @vibe/compiler/cache {\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint,\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint,\n  build_file_compile_module_artifact_fingerprint,\n  build_file_compile_wasi_artifact_fingerprint,\n  build_source_groups_fingerprint,\n  load_persistent_artifact,\n  store_persistent_artifact\n}\n\n//# Types\n\nexport effect Profiler {\n  NowUs -> Int\n}\n\n//# Functions\n\nfn profiler_now_us() -> Int with { Profiler } {\n  perform Profiler::NowUs\n}\n\nfn elapsed_us_since(start_us: Int) -> Int with { Profiler } {\n  let elapsed = profiler_now_us() - start_us\n  if elapsed < 0 {\n    0\n  } else {\n    elapsed\n  }\n}\n\nfn artifact_fingerprint_from_source(source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nfn seed_type_db_from_source_groups(db: TypeDb, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb {\n  let mut seeded = db\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      seeded = db_set_source(seeded, path, source)\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  seeded\n}\n\nfn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\nfn flatten_source_groups_local(source_groups: Array[(String, Array[(String, String)])]) -> Array[(String, String)] {\n  let flat = array_empty()\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      Array::push(flat, Array::get(sources, si))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  flat\n}\n\nfn string_array_contains(items: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn lookup_source_by_path(sources: Array[(String, String)], target_path: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    if path == target_path {\n      found = Some(source)\n      i = Array::length(sources)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn parse_program_for_path(path: String, source: String) -> Array[Stmt] with { Error } {\n  handle {\n    // Interior-line breakpoints (span-arc step5): parse via the span-aware\n    // `parse_program_located` so EIdent nodes carry real source char-offsets\n    // (offset_to_line then maps them to lines for `vibe::dbg_line`). Offsets are\n    // inert for normal codegen (no codegen path reads them), so the default\n    // wasm output is unchanged — only the gated break path consumes them.\n    let (tokens, starts, _ends) = lex_with_offsets(source)\n    parse_program_located(tokens, starts, source)\n  } with Error {\n    Throw(msg) => throw(String::concat(String::concat(path, \": \"), msg))\n  }\n}\n\n// #716: collision-def fallback (see merge_sources.vibe). `excluded_locals`\n// are the locals the export-rename plan already rewrites; the inline copy gets\n// the target file's export renames applied first.\nfn append_import_alias_collision_defs_from_sources(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], sources: Array[(String, String)], plan: ExportRenamePlan, excluded_locals: Array[String]) -> Unit with { Error } {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = array_empty()\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !string_array_contains(emitted, local) && !string_array_contains(excluded_locals, local) {\n      let resolved = resolve_import_path(base_dir, raw_path)\n      match lookup_source_by_path(sources, resolved) {\n        Some(source) => {\n          let source_stmts = namespace_private_value_stmts(\n            resolved,\n            apply_export_renames_stmts(\n              parse_program_for_path(resolved, source),\n              export_plan_renames_for(plan, resolved)\n            )\n          )\n          let mut j = 0\n          let mut done = false\n          while j < Array::length(source_stmts) && !done {\n            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n              Some(local_stmt) => {\n                Array::push(merged, local_stmt)\n                Array::push(emitted, local)\n                done = true\n              },\n              None => ()\n            }\n            j = j + 1\n          }\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n}\n\n// #716: parse every source once and build the export-rename plan for the whole\n// program (the merge output of one file depends on the export surfaces of ALL\n// files: ambiguous exported names are renamed at their defs and at importing\n// files' references).\nfn parse_sources_for_merge(sources: Array[(String, String)]) -> (Array[String], Array[Array[Stmt]]) with { Error } {\n  let file_paths = array_empty()\n  let file_stmts = array_empty()\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (path, source) = Array::get(sources, si)\n    Array::push(file_paths, path)\n    Array::push(file_stmts, parse_program_for_path(path, source))\n    si = si + 1\n  }\n  (file_paths, file_stmts)\n}\n\n// One file's contribution to the merged program. `stmts` are the file's parsed\n// statements, `is_entry_source` mirrors the pre-#716 per-group entry rule\n// (entry keeps its private names), and `plan`/`sources` drive the export-name\n// rewriting and the collision-def fallback.\nfn append_merged_stmts_for_file(merged: Array[Stmt], path: String, stmts: Array[Stmt], is_entry_source: Bool, plan: ExportRenamePlan, sources: Array[(String, String)]) -> Unit with { Error } {\n  let export_renamed = if is_entry_source {\n    stmts\n  } else {\n    apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))\n  }\n  let namespaced_stmts = if is_entry_source {\n    export_renamed\n  } else {\n    namespace_private_value_stmts(path, export_renamed)\n  }\n  if stmts_have_import_deep(stmts) {\n    let import_renames = collect_import_value_renames(plan, path, stmts)\n    let skipped_locals = collect_import_alias_collision_locals(stmts)\n    append_import_alias_collision_defs_from_sources(merged, path, stmts, sources, plan, import_value_rename_locals(import_renames))\n    append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)\n  } else {\n    append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\n  }\n}\n\nfn build_merged_stmts_from_sources(entry_path: String, sources: Array[(String, String)]) -> Array[Stmt] with { Error } {\n  let merged = array_empty()\n  let source_count = Array::length(sources)\n  let (file_paths, file_stmts) = parse_sources_for_merge(sources)\n  let plan_entry = if entry_path == \"\" {\n    if source_count > 0 {\n      Array::get(file_paths, source_count - 1)\n    } else {\n      \"\"\n    }\n  } else {\n    entry_path\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  let mut si = 0\n  while si < source_count {\n    let path = Array::get(file_paths, si)\n    let is_entry_source = if entry_path == \"\" {\n      si == source_count - 1\n    } else {\n      path == entry_path\n    }\n    append_merged_stmts_for_file(merged, path, Array::get(file_stmts, si), is_entry_source, plan, sources)\n    si = si + 1\n  }\n  merged\n}\n\nfn build_grouped_merged_stmts(source_groups: Array[(String, Array[(String, String)])]) -> Array[Stmt] with { Error } {\n  let merged = array_empty()\n  // #716: the plan spans ALL groups (imports cross group boundaries), so the\n  // flat source list is parsed once here and reused per group.\n  let flat_sources = flatten_source_groups_local(source_groups)\n  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)\n  let plan_entry = if Array::length(file_paths) > 0 {\n    Array::get(file_paths, Array::length(file_paths) - 1)\n  } else {\n    \"\"\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  // #740: the is-entry flag must mean \"the LAST file of the WHOLE merge\"\n  // (the plan entry, whose exports stay unrenamed). It was `si ==\n  // source_count - 1` — the last file of EVERY GROUP — so every group\n  // tail (ripple/ripple.vibe, desugar_trait_dict.vibe, ...) skipped its\n  // export renames while callers were rewritten to the renamed names:\n  // \"undefined variable (local): <name>_exp_<path>\" at codegen.\n  let flat_total = Array::length(file_paths)\n  let mut flat_idx = 0\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let source_count = Array::length(sources)\n    let mut si = 0\n    while si < source_count {\n      let path = Array::get(file_paths, flat_idx)\n      let stmts = Array::get(file_stmts, flat_idx)\n      append_merged_stmts_for_file(merged, path, stmts, flat_idx == flat_total - 1, plan, flat_sources)\n      flat_idx = flat_idx + 1\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  merged\n}\n\n// Interior-line breakpoints (span-arc step5): the basename of a file path (text\n// after the last '/'). Used as the `vibe.dbgfiles` key the runner matches a\n// `--break <file>:<line>` spec against. String::concat-free (substring only).\nfn path_basename(p: String) -> String {\n  let n = String::length(p)\n  let mut last = 0 - 1\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(p, i) == 47 {\n      last = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  String::substring(p, last + 1, n)\n}\n\n// Interior-line breakpoints: sorted char-offsets of each '\\n' in `src` (local\n// copy of the codegen helper, to avoid an entry->codegen import).\nfn file_newline_offsets(src: String) -> Array[Int] {\n  let arr = array_empty()\n  let n = String::length(src)\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(src, i) == 10 {\n      Array::push(arr, i)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  arr\n}\n\n// Interior-line breakpoints (span-arc step5, multi-file): like\n// build_grouped_merged_stmts but ALSO records, per merged top-level statement,\n// which SOURCE FILE it came from — so codegen can map each statement's char\n// offset to a line IN ITS OWN FILE (offsets from different files collide after\n// the merge). Returns (merged, file_basenames, file_newlines, stmt_file_id):\n//   file_basenames[k] / file_newlines[k]  — the k-th distinct source file\n//   stmt_file_id[s]                        — file id of merged top-level stmt s\n// Provenance is captured by measuring the merged-array length delta around each\n// source's append, so it stays aligned no matter how many statements a source\n// contributes; the append calls themselves mirror build_merged_stmts_from_sources\n// exactly, so `merged` is identical to the normal path.\nfn build_grouped_merged_stmts_prov(source_groups: Array[(String, Array[(String, String)])]) -> (Array[Stmt], Array[String], Array[Array[Int]], Array[Int]) with { Error } {\n  let merged = array_empty()\n  let files = array_empty()\n  let file_nls = array_empty()\n  let stmt_file_id = array_empty()\n  // #716: same whole-program plan as build_grouped_merged_stmts, so `merged`\n  // stays identical to the normal (non-break) merge.\n  let flat_sources = flatten_source_groups_local(source_groups)\n  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)\n  let plan_entry = if Array::length(file_paths) > 0 {\n    Array::get(file_paths, Array::length(file_paths) - 1)\n  } else {\n    \"\"\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  let mut flat_idx = 0\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let source_count = Array::length(sources)\n    let mut si = 0\n    while si < source_count {\n      let (path, source) = Array::get(sources, si)\n      let file_id = Array::length(files)\n      Array::push(files, path_basename(path))\n      Array::push(file_nls, file_newline_offsets(source))\n      let before = Array::length(merged)\n      // #740: last-of-WHOLE-merge, not last-of-group (see the note in\n      // build_grouped_merged_stmts).\n      append_merged_stmts_for_file(merged, path, Array::get(file_stmts, flat_idx), flat_idx == Array::length(file_paths) - 1, plan, flat_sources)\n      let after = Array::length(merged)\n      let mut k = before\n      while k < after {\n        Array::push(stmt_file_id, file_id)\n        k = k + 1\n      }\n      flat_idx = flat_idx + 1\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  (merged, files, file_nls, stmt_file_id)\n}\n\nfn prepare_file_fs_from_source_groups_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with { Error } {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck(seeded, entry_path)\n}\n\nfn prepare_file_fs_from_source_groups_persistent_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with { Error, Fs } {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck_fs(seeded, entry_path)\n}\n\nexport fn prepare_file_fs_cached(db: TypeDb, entry_path: String) -> TypeDb with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n}\n\n// #946 P1 (Codex, PR #1006): `vibe check`'s \"linked\" dep collection\n// (collect_linked_dep_inputs_for_stmts, in linked_artifacts.vibe) exists to\n// feed the wasm import-linking codegen boundary -- it copies a dependency's\n// SEnum/struct declarations into the checked stmts but never a `let rec fn`\n// signature, so check_program never learned an imported function's real\n// type and a wrong-typed call site (e.g. `f(\"x\")` against `fn f(x: Int)`)\n// typechecked cleanly no matter what was passed. Reuse prepare_file_fs_cached's\n// fs-mode source-group + db_typecheck_fs pipeline instead -- the same one\n// compile_file_fs_mode already relies on for a real compile's (working)\n// typecheck pass -- and stop before build_grouped_merged_stmts/codegen.\nexport fn check_file_fs_mode(entry_path: String) -> Int with { Error, Fs } {\n  let _ = prepare_file_fs_cached(db_new(), entry_path)\n  0\n}\n\nexport fn compile_file_fs_mode(entry_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n}\n\n// #701 RC variant: same load/merge as compile_file_fs_mode \"no-dce\" but routes\n// through the Perceus RC codegen (compile_wasi_module_rc_impl, enable_rc) so an\n// import-resolving / `vibe run` program actually honors VIBE_RC. Without this\n// the FS-compile path silently used the bump allocator regardless of VIBE_RC.\nexport fn compile_file_fs_mode_rc(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_rc(merged_stmts, entry_name)\n}\n\n// #715/#768 debug variant (VIBE_RC=shadow): same load/merge as\n// compile_file_fs_mode_rc but with shadow-liveness double-free traps, so an\n// import-resolving test build's \"moving target\" free-list corruption becomes a\n// deterministic trap at the first bad dup/drop.\nexport fn compile_file_fs_mode_rc_shadow(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_rc_shadow(merged_stmts, entry_name)\n}\n\n// #634 (ADR-0026): same as compile_file_fs_mode, but ALSO writes the pure-test\n// cache verdict to `meta_out` (when non-empty) before codegen — computed on the\n// MERGED stmts, so transitive imported-function effect rows are visible. \"1\" =\n// every test block is transitively effect-free → `vibe test` may cache/skip it.\n// Reached only on a successful compile (the program type-checks), so reading the\n// declared effect rows is sound. Env is read by the caller (the CLI adapter),\n// keeping this layer free of the Env effect.\nexport fn compile_file_fs_mode_testmeta(entry_path: String, entry_name: String, mode: String, meta_out: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  // Compute the cacheability verdict BEFORE codegen (it only needs the stmts)\n  // but write it only AFTER codegen succeeds, so a failed compile leaves no\n  // stale sidecar.\n  let cacheable = if meta_out != \"\" {\n    file_tests_cacheable(merged_stmts)\n  } else {\n    false\n  }\n  let bytes = if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  if meta_out != \"\" {\n    Fs::write_file(meta_out, if cacheable {\n      \"1\"\n    } else {\n      \"0\"\n    })\n  } else {\n    ()\n  }\n  bytes\n}\n\n// Coverage (#cov): FS-mode compile with function-level hit instrumentation.\n// Same load/merge as compile_file_fs_mode \"no-dce\" but routes through the\n// coverage codegen so the output wasm carries the hit bitmap + `vibe_cov`\n// section. Used by `cli_main` under VIBE_COVERAGE=1.\nexport fn compile_file_fs_mode_coverage(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_coverage(merged_stmts, entry_name)\n}\n\n// Trace (debugger / DAP P1 groundwork): FS-mode compile with function-call\n// execution-trace instrumentation. Same load/merge as compile_file_fs_mode\n// \"no-dce\" but routes through the trace codegen so the output wasm carries the\n// in-memory trace log + `vibe.trace` custom section. Used by `cli_main` under\n// VIBE_DEBUG=1.\nexport fn compile_file_fs_mode_trace(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_trace(merged_stmts, entry_name)\n}\n\n// Break (debugger / DAP P1): FS-mode compile with `vibe::dbg_break` host-hook\n// instrumentation at each user function entry. Same load/merge as\n// compile_file_fs_mode \"no-dce\" but routes through the break codegen so the\n// output wasm imports + calls `vibe::dbg_break`. Used by `cli_main` under\n// VIBE_DEBUG_BREAK=1.\nexport fn compile_file_fs_mode_break(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  // Interior-line breakpoints (span-arc step5): merge WITH per-file provenance so\n  // the break codegen can emit `vibe::dbg_line(<file_id>, <line>)` at every\n  // statement boundary, mapping each statement's char offset to a line in its OWN\n  // source file (multi-file: offsets from different files collide). `merged` is\n  // identical to the non-break merge.\n  let (merged_stmts, dbg_files, dbg_file_nls, dbg_stmt_file_id) = build_grouped_merged_stmts_prov(source_groups)\n  compile_wasi_module_break(merged_stmts, entry_name, DbgProv::{\n    files: dbg_files,\n    file_nls: dbg_file_nls,\n    stmt_file_id: dbg_stmt_file_id\n  })\n}\n\nexport fn compile_file_fs_mode_profiled(entry_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let total_start = profiler_now_us()\n  let load_start = profiler_now_us()\n  let source_groups = collect_source_groups_fs(entry_path)\n  let load_us = elapsed_us_since(load_start)\n  let type_start = profiler_now_us()\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let type_us = elapsed_us_since(type_start)\n  let bundle_start = profiler_now_us()\n  let _ = build_source_groups_fingerprint(source_groups)\n  let bundle_us = elapsed_us_since(bundle_start)\n  let parse_start = profiler_now_us()\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  let parse_us = elapsed_us_since(parse_start)\n  let compile_start = profiler_now_us()\n  let bytes = if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let compile_us = elapsed_us_since(compile_start)\n  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n}\n\nfn compile_file_fs_mode_cached_slow_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String, persistent_artifact_kind: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let load_start = profiler_now_us()\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint(\n    source_groups,\n    entry_name,\n    mode\n  )\n  match load_persistent_artifact(\n    persistent_artifact_kind,\n    entry_name,\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0),\n    None => {\n      let load_us = elapsed_us_since(load_start)\n      let type_start = profiler_now_us()\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let type_us = elapsed_us_since(type_start)\n      let bundle_start = profiler_now_us()\n      let merge_fingerprint = build_source_groups_fingerprint(source_groups)\n      let bundle_us = elapsed_us_since(bundle_start)\n      let artifact_fingerprint = merge_fingerprint\n      let artifact_kind = if mode == \"mvp\" {\n        \"wasi-mvp\"\n      } else if mode == \"no-dce\" {\n        \"wasi\"\n      } else {\n        throw(String::concat(\"unsupported compile mode: \", mode))\n      }\n      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, next_db, load_us, type_us, bundle_us, 0, 0),\n        None => {\n          let parse_start = profiler_now_us()\n          let merged_stmts = build_grouped_merged_stmts(source_groups)\n          let parse_us = elapsed_us_since(parse_start)\n          let compile_start = profiler_now_us()\n          let bytes = if mode == \"mvp\" {\n            let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n            compile_wasi_module_impl(pruned_stmts, entry_name)\n          } else {\n            compile_wasi_module(merged_stmts, entry_name)\n          }\n          store_persistent_artifact(\n            persistent_artifact_kind,\n            entry_name,\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          let compile_us = elapsed_us_since(compile_start)\n          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes), load_us, type_us, bundle_us, parse_us, compile_us)\n        }\n      }\n    }\n  }\n}\n\nfn compile_file_fs_mode_cached_slow(db: TypeDb, entry_path: String, entry_name: String, mode: String, persistent_artifact_kind: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint(\n    source_groups,\n    entry_name,\n    mode\n  )\n  match load_persistent_artifact(\n    persistent_artifact_kind,\n    entry_name,\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let merge_fingerprint = build_source_groups_fingerprint(source_groups)\n      let artifact_fingerprint = merge_fingerprint\n      let artifact_kind = if mode == \"mvp\" {\n        \"wasi-mvp\"\n      } else if mode == \"no-dce\" {\n        \"wasi\"\n      } else {\n        throw(String::concat(\"unsupported compile mode: \", mode))\n      }\n      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, next_db),\n        None => {\n          let merged_stmts = build_grouped_merged_stmts(source_groups)\n          let bytes = if mode == \"mvp\" {\n            let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n            compile_wasi_module_impl(pruned_stmts, entry_name)\n          } else {\n            compile_wasi_module(merged_stmts, entry_name)\n          }\n          store_persistent_artifact(\n            persistent_artifact_kind,\n            entry_name,\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport fn compile_file_fs_mode_cached(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  let persistent_artifact_kind = if mode == \"mvp\" {\n    \"file-compile-wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"file-compile-wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        persistent_artifact_kind,\n        entry_name,\n        build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint,\n          entry_name,\n          mode\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_mode_cached_slow(db, entry_path, entry_name, mode, persistent_artifact_kind)\n      },\n    None => compile_file_fs_mode_cached_slow(db, entry_path, entry_name, mode, persistent_artifact_kind)\n  }\n}\n\nexport fn compile_file_fs_cached(db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  compile_file_fs_mode_cached(db, entry_path, entry_name, \"no-dce\")\n}\n\nexport fn compile_file_fs(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)\n  bytes\n}\n\nexport fn compile_file_fs_mode_cached_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let total_start = profiler_now_us()\n  let persistent_artifact_kind = if mode == \"mvp\" {\n    \"file-compile-wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"file-compile-wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let load_start = profiler_now_us()\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        persistent_artifact_kind,\n        entry_name,\n        build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint,\n          entry_name,\n          mode\n        )\n      ) {\n        Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0, elapsed_us_since(total_start)),\n        None => {\n          let prefix_load_us = elapsed_us_since(load_start)\n          let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)\n          (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n        }\n      },\n    None => {\n      let prefix_load_us = elapsed_us_since(load_start)\n      let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)\n      (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n    }\n  }\n}\n\nfn compile_file_fs_module_cached_slow(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_module_artifact_fingerprint(\n    source_groups\n  )\n  match load_persistent_artifact(\n    \"file-compile-module\",\n    \"\",\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(next_db, source_groups)\n      let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n      let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n      match db_load_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(module_source))\n          let bytes = compile_module(merged_stmts)\n          store_persistent_artifact(\n            \"file-compile-module\",\n            \"\",\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport fn compile_file_fs_module_cached(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        \"file-compile-module\",\n        \"\",\n        build_file_compile_module_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_module_cached_slow(db, entry_path)\n      },\n    None => compile_file_fs_module_cached_slow(db, entry_path)\n  }\n}\n\nexport fn compile_file_fs_module(entry_path: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)\n  bytes\n}\n")
}

let cli_adapter_source_241 = () -> (String, String) {
  ("lib/@vibe/compiler/cli_support.vibe",
"//# Imports\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_linked_impl\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_base {\n  empty_dbg_prov\n}\n\nimport @vibe/compiler/core {\n  Stmt\n}\n\nimport @vibe/compiler/entry/compiler/file_compile {\n  check_file_fs_mode, compile_file_fs_mode, compile_file_fs_mode_cached, compile_file_fs_mode_cached_profiled,\n  compile_file_fs_mode_profiled\n}\n\n// #897: package-form import (wasi_only/ is now an index.vpkg boundary) --\n// these used to be three separate leaf imports (linked_artifacts.vibe,\n// preprocess_interp.vibe, linked_library.vibe), now merged into one. A\n// fourth leaf import (path_utils.vibe's `empty_stmt_array`) is dropped\n// entirely: it is a private helper only promoted to sibling-file visibility\n// within wasi_only/ (not part of this package's declared contract surface,\n// see wasi_only/index.vpkg's header), and its body is a one-line forward to\n// `@vibe/core`'s generic `array_empty[T]()` -- already imported below under\n// its own name, so the two call sites that used `empty_stmt_array()` now\n// call `array_empty()` directly instead.\nimport @vibe/compiler/entry/source_compile/wasi_only {\n  collect_linked_compile_inputs, collect_linked_dep_inputs_for_stmts,\n  expand_interp_stmts,\n  compile_file_wasi_library\n}\n\nimport ./type_db.vibe {\n  db_new\n}\n\n// #946(3,4): `vibe check` runs this same inline-wasm codegen validation (lane\n// index / align / etc.) as `vibe diagnostics` — see check_inline_wasm_fns'\n// doc comment in typecheck_fs.vibe. Without this, making `check` genuinely\n// codegen-free (Gate v2 #492, wired to the CLI by #946(3)) would have made it\n// blind to inline-wasm errors that used to be caught by the old full-compile\n// `check` — a regression trade for fixing the empty-file false-positive.\n// `locate_type_error` recovers the `line:col` prefix the OLD full-compile\n// `check` got for free via typecheck_fs.vibe's own db_typecheck_fs path\n// (finish_typecheck_fs_impl wraps every Throw with it) — without rewrapping\n// here, check_linked_file's raw check_file_fs_mode/check_program message\n// would regress every located-diagnostic case check has (scripts/\n// test_located_diagnostics.sh).\nimport @vibe/compiler/runtime {\n  check_inline_wasm_fns, locate_type_error\n}\n\n// #946(3): re-parse the entry file WITH real char offsets for check_linked_file\n// (see its doc comment) — collect_linked_compile_inputs's own entry_stmts come\n// from linked_artifacts.vibe's read_program, which parses via the PLAIN\n// `parse_program(lex(source))` (no starts array => every node's offset is -1,\n// same pitfall parse_program_with_path's doc comment describes for\n// finish_typecheck_fs_impl). Re-parsing just the entry file is self-contained\n// (no shared-helper edit, so compile/build/debug paths that also flow through\n// read_program are untouched). Uses the RECOVERING parser (not\n// parse_program_located): every diagnostic parse_program_recovering emits is\n// ALREADY a full `line L:col C: msg` string (extract_err_token_pos +\n// offset_to_line_col at the point of the throw, in parser.vibe) — the same\n// robust locating parse_program_located does only for its own top-level\n// throws, missing errors that bubble up from nested expr-parsing helpers\n// (e.g. `export let bad = = 5`'s \"unexpected token at #9: ...\" came back\n// unlocated through parse_program_located but located through the recovering\n// parser). check_linked_file only wants the single FIRST parse error (`check`\n// is one-error-at-a-time; `vibe diagnostics` is the multi-diagnostic surface\n// — collect_all_diagnostics already uses this same recovering parser).\nimport @vibe/compiler/syntax {\n  lex_with_offsets, parse_program_recovering\n}\n\n//# Functions\n\nfn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\nfn linked_output_dir(output_path: String) -> String {\n  let len = String::length(output_path)\n  if len >= 5 && output_path[len - 5: len] == \".wasm\" {\n    String::concat(output_path[0: len - 5], \".debug\")\n  } else {\n    String::concat(output_path, \".debug\")\n  }\n}\n\nfn empty_source_pairs() -> Array[(String, String)] {\n  array_empty()\n}\n\nfn normalize_release_mode(mode: String) -> String with { Error } {\n  if mode == \"\" || mode == \"release\" || mode == \"no-dce\" {\n    \"no-dce\"\n  } else if mode == \"mvp\" {\n    \"mvp\"\n  } else {\n    throw(String::concat(\"unsupported release mode: \", mode))\n  }\n}\n\nexport fn compile_release_file_mode(input_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs } {\n  let compile_mode = normalize_release_mode(mode)\n  let (bytes, _) = compile_file_fs_mode_cached(db_new(), input_path, entry_name, compile_mode)\n  bytes\n}\n\nexport fn compile_release_file_mode_uncached(input_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs } {\n  let compile_mode = normalize_release_mode(mode)\n  compile_file_fs_mode(input_path, entry_name, compile_mode)\n}\n\nexport fn compile_release_file_mode_profiled(input_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let compile_mode = normalize_release_mode(mode)\n  let (bytes, _, load_us, type_us, bundle_us, parse_us, compile_us, total_us) = compile_file_fs_mode_cached_profiled(db_new(), input_path, entry_name, compile_mode)\n  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, total_us)\n}\n\nexport fn compile_release_file_mode_uncached_profiled(input_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let compile_mode = normalize_release_mode(mode)\n  compile_file_fs_mode_profiled(input_path, entry_name, compile_mode)\n}\n\nexport fn compile_release_file(input_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  compile_release_file_mode(input_path, entry_name, \"no-dce\")\n}\n\nexport fn compile_debug_library(dep_path: String) -> Bytes with { Error, Fs } {\n  compile_file_wasi_library(dep_path)\n}\n\nfn append_non_import_stmts(dst: Array[Stmt], src: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    match Array::get(src, i) {\n      SImport(_, _) => (),\n      SReExport(_, _) => (),\n      SAliasDecl(_, _) => (),\n      _ => Array::push(dst, Array::get(src, i))\n    }\n    i = i + 1\n  }\n}\n\nexport fn build_linked_debug_entry(input_path: String, entry_name: String) -> (Bytes, Array[(String, String)]) with { Error, Fs } {\n  let (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_compile_inputs(input_path)\n  let main_stmts = array_empty()\n  append_stmt_array(main_stmts, resolved_type_stmts)\n  append_non_import_stmts(main_stmts, entry_stmts)\n  let bytes = compile_wasi_module_linked_impl(main_stmts, entry_name, empty_source_pairs(), linked_imports, false, false, false, false, false, false, empty_dbg_prov())\n  (bytes, linked_dep_specs)\n}\n\n// Gate v2 (#492): parse + typecheck only, with imports linked. The checker\n// knows builtin signatures, so this surfaces REAL language/checker\n// expressiveness gaps (parse errors, type errors, genuine unknown names)\n// WITHOUT the codegen builtin-body-linking confounder that makes the `debug`\n// mode emit spurious `undefined variable: Ns::method`. No wasm is produced.\nexport fn check_linked_file(input_path: String) -> Int with { Error, Fs } {\n  // #946(3): parse the entry file OURSELVES first (located + recovering —\n  // see the import comment above) so a parse error is reported with an exact\n  // `line:col` before any other check runs.\n  let entry_source = Fs::read_file(input_path)\n  let (tokens, starts, _ends) = lex_with_offsets(entry_source)\n  let (entry_stmts, parse_diags) = parse_program_recovering(tokens, starts, entry_source)\n  if Array::length(parse_diags) > 0 {\n    // Already a full `line L:col C: msg` string (see the import comment\n    // above) -- report just the first, matching check's one-error-at-a-time\n    // convention (vibe diagnostics is the multi-diagnostic surface).\n    throw(Array::get(parse_diags, 0))\n  } else {\n    ()\n  }\n  // #946 P1 (Codex, PR #1006): the type-check itself must go through\n  // check_file_fs_mode (the fs-mode source-group + db_typecheck_fs pipeline\n  // compile_file_fs_mode already relies on for a real compile), NOT\n  // collect_linked_dep_inputs_for_stmts + check_program. That \"linked\"\n  // mechanism exists to feed the wasm import-linking codegen boundary: it\n  // copies a dependency's SEnum/struct declarations into the checked stmts\n  // but never a `let rec fn` signature, so check_program never learned an\n  // imported function's real type and a wrong-typed call site (e.g.\n  // `f(\"x\")` against `fn f(x: Int)`) typechecked cleanly no matter what was\n  // passed — confirmed via a live two-file repro before this fix.\n  //\n  // collect_linked_dep_inputs_for_stmts is still used below, ONLY to build\n  // the merged stmts check_inline_wasm_fns scans (inline-wasm fns can live in\n  // an imported file too) — that scan is independent of type information.\n  handle {\n    let _ = check_file_fs_mode(input_path)\n    let (resolved_type_stmts, _linked_imports, _linked_dep_specs) = collect_linked_dep_inputs_for_stmts(input_path, entry_stmts)\n    let stmts = array_empty()\n    append_stmt_array(stmts, resolved_type_stmts)\n    append_stmt_array(stmts, entry_stmts)\n    expand_interp_stmts(stmts)\n    // #946(3): locate errors against the ENTRY file's own source text. `stmts`\n    // is the MERGED entry+deps statement list, so a [@off=N]/by-name location\n    // is only exact for errors whose blame is in the entry file itself (the\n    // common case, and the one every located-diagnostic regression test\n    // exercises); an error rooted in an imported dependency degrades to the\n    // unlocated message, same as before this fix, rather than mis-locating it\n    // against the wrong file's text.\n    match check_inline_wasm_fns(stmts) {\n      Some(msg) => throw(locate_type_error(entry_source, msg)),\n      None => ()\n    }\n  } with Error {\n    Throw(msg) => throw(locate_type_error(entry_source, msg))\n  }\n  0\n}\n\nexport fn write_linked_debug_build(input_path: String, output_path: String, entry_name: String) -> Unit with { Error, Fs } {\n  let (entry_bytes, linked_dep_specs) = build_linked_debug_entry(input_path, entry_name)\n  Fs::write_bytes(output_path, entry_bytes)\n  let output_dir = linked_output_dir(output_path)\n  let mut i = 0\n  while i < Array::length(linked_dep_specs) {\n    let (module_name, dep_path) = Array::get(linked_dep_specs, i)\n    let lib_output_path = String::concat(output_dir, String::concat(\"/\", String::concat(module_name, \".wasm\")))\n    let lib_bytes = compile_debug_library(dep_path)\n    Fs::write_bytes(lib_output_path, lib_bytes)\n    i = i + 1\n  }\n}\n")
}

let cli_adapter_source_242 = () -> (String, String) {
  ("lib/@vibe/compiler/lsp_server.vibe",
"// Self-hosted `vibe lsp` (docs/editor-and-debugging.md). Replaces the\n// Node.js `clients/js/lsp_server.js` shim, which shelled out to a fresh\n// `vibe` subprocess (a full wasm re-instantiation) for every single\n// hover/definition/rename/etc. request. The compiler-internal query\n// primitives it shelled out to (`@vibe/compiler/runtime`'s\n// `type_at_source`/`binding_occurrences`/`symbol_spans`/\n// `collect_all_diagnostics`) are ordinary in-process functions operating on\n// an in-memory source string, so this server calls them directly instead --\n// no subprocess, no temp files, no per-request wasm reload.\n//\n// Also serves as a real (non-toy) exercise of the effect system: the\n// JSON-RPC transport/dispatch layer below never calls into the compiler\n// itself -- `lsp_dispatch_request` only decides WHICH `Lsp` operation a\n// request needs and hands off to `lsp_run_with_handler`, which is the only\n// place any of them is `perform`ed or its real implementation lives. This\n// is capability injection via algebraic effects, not effect theater: the\n// dispatch code is written against the ABSTRACT `Lsp` interface only, and a\n// different handler (a mock for protocol-layer testing, a future handler\n// backed by a persistent incremental TypeDb instead of one-shot re-parses)\n// could be substituted without touching the transport or routing code.\n//\n// Effect-safety notes:\n// - (docs/cheatsheet.md's replay-handler rule: \"handle body must stay pure\n//   until the final perform, or side effects before it re-run on every\n//   resume\") `lsp_run_with_handler`'s handle body is an `if`/`else` chain\n//   whose every branch is EXACTLY one bare `perform`, nothing before or\n//   after -- safe under replay semantics regardless of which branch runs:\n//   there is no earlier side effect to duplicate, and re-executing the\n//   branch on `resume` re-evaluates the same deterministic condition and\n//   re-reaches the same (memoized) perform. Reading the next request, and\n//   writing the response, both happen OUTSIDE any handle, in the ordinary\n//   (non-effectful) main loop.\n// - `perform` and `handle` for `Lsp` are always textually co-located in\n//   `lsp_run_with_handler` itself, on purpose -- an earlier revision\n//   dispatched via a `body: () -> Json with { Lsp }` closure PARAMETER\n//   instead (built once per call site, passed in to be perform'd here).\n//   That compiled cleanly and even ran fine under this repo's Node.js dev/\n//   test runner, but trapped (\"indirect call type mismatch\") the moment it\n//   actually executed under real wasmtime: an effectful closure captured\n//   BY VALUE and invoked through an opaque higher-order-function parameter\n//   is exactly the still-open GENERAL case issue #1070 documents (this is\n//   NOT the same shape as this session's own #1070 fix, which covers a\n//   NEEDING function calling its own closure-typed parameter --\n//   `lsp_run_with_handler` isn't \"needing\" anything itself, since it fully\n//   discharges `Lsp` right there). See `lsp_run_with_handler`'s own doc\n//   comment for the restructured (closure-free, Int-tag-dispatched) shape\n//   that avoids it -- verified working end-to-end under real vibewt with\n//   genuinely piped stdin, not just this repo's own dev-runner test\n//   harness.\n//\n// Scope (v1): initialize/initialized/shutdown/exit, full-sync document\n// store (didOpen/didChange/didClose), hover, definition, references,\n// rename, documentSymbol, and diagnostics (published on every didOpen/\n// didChange/didSave -- there is no timer/debounce primitive available yet,\n// see docs/concurrency.md's \"proposed, not implemented\" status, so this\n// runs synchronously per edit rather than the JS server's 150ms debounce).\n// Deliberately deferred: workspace/symbol, callHierarchy, the `vibe/graph`\n// visualizer, and completion/signatureHelp -- these are backed by\n// clients/js/symbol_index.js's regex-based whole-workspace index and\n// clients/js/graph_query.js in the JS server, not by any compiler-internal\n// primitive; porting that indexing layer to vibe is a separate, larger\n// follow-up. `clients/js/lsp_server.js` remains available (see\n// runtime/vibe's `lsp` case) for workspace-wide features until then.\n\n//# Imports\n\nimport @vibe/compiler/runtime {\n  type_at_source, binding_occurrences, symbol_spans, collect_all_diagnostics\n}\n\nimport @vibe/parser {\n  offset_to_line_col\n}\n\n// Deliberately NOT using @vibe/json/jsonrpc.vibe's RpcMessage/RpcId/\n// parse_message/stringify_response/stringify_notification/stringify_error,\n// even though they're a ready-made JSON-RPC 2.0 codec: @vibe/http's `Http`\n// effect separately declares a same-named `Request` operation\n// (http_effect.vibe), and the whole-program merge/flatten this compiler's\n// own build goes through (needed to ship `vibe lsp` as part of the\n// distributed CLI) resolves same-named constructors across UNRELATED\n// packages by bare name once the referencing code is actually reachable\n// from an exported entry point -- confirmed empirically (not\n// hypothetical): `RpcMessage::Request(...)`, even explicitly qualified,\n// typechecks fine as dead code but fails (\"argument type mismatch for\n// Request: expected RpcId, got Map[String, Json]\" -- Http::Request's own\n// 4-String signature) the moment `lsp_main` actually calls into it, and the\n// same failure persists even routed through jsonrpc.vibe's own\n// PACKAGE-LOCAL (unqualified) constructor use once genuinely reachable --\n// i.e. this is not a scoping/qualification bug so much as a whole-program\n// reachability-sensitive name resolution bug in the bundle merge tool\n// itself (same underlying class as #1062's ctor_table_index_of, a\n// DIFFERENT consumer, not yet root-caused/fixed at the source). Sidestepped\n// by building the JSON-RPC envelope directly on `Json`/`Json::field`\n// (json_convenience.vibe's accessors, no colliding constructor names)\n// instead.\n// The bare `{ Json }` type import is all that's needed: the FS lane's\n// bind_enum_constructor_companions (runtime/typecheck_fs.vibe) binds the\n// package's whole `Json::`-qualified export surface alongside the type.\n// This file previously carried local json_string/json_number/... helper\n// copies of the accessors as a workaround for #1080 (the FS lane only\n// bound companions whose RETURN type was Json, so Json::string et al --\n// which return String/Int/Bool -- didn't resolve); fixed at the source,\n// so the accessors are used directly again.\nimport @vibe/json {\n  Json\n}\n\n//# Effects\n\neffect Lsp {\n  Hover(String, Int, Int) -> Json\n  Definition(String, Int, Int) -> Json\n  References(String, Int, Int) -> Json\n  Rename(String, Int, Int, String) -> Json\n  DocumentSymbol(String) -> Json\n  Diagnostics(String) -> Json\n}\n\n//# Content-Length transport (LSP over stdio)\n\nfn lsp_read_header_line() -> String with { Stdin } {\n  let mut acc = \"\"\n  let mut done = false\n  while not(done) {\n    let c = Stdin::read_char()\n    if c < 0 {\n      done = true\n    } else if c == 10 {\n      done = true\n    } else if c == 13 {\n      ()\n    } else {\n      acc = String::concat(acc, String::from_char_code(c))\n    }\n  }\n  acc\n}\n\nfn lsp_parse_uint_or(s: String, default: Int) -> Int {\n  let len = String::length(s)\n  if len == 0 {\n    default\n  } else {\n    let mut i = 0\n    let mut acc = 0\n    let mut ok = true\n    while ok && i < len {\n      let c = String::char_code_at(s, i)\n      if c >= '0' && c <= '9' {\n        acc = acc * 10 + (c - '0')\n        i = i + 1\n      } else {\n        ok = false\n      }\n    }\n    if ok { acc } else { default }\n  }\n}\n\n// Reads headers up to the blank line, returns the declared Content-Length\n// (-1 if the stream closed before any bytes arrived at all -- the \"no more\n// messages\" signal the main loop stops on; -1 with headers seen but no\n// Content-Length line is also treated as fatal for this message, since LSP\n// framing requires it).\nfn lsp_read_content_length() -> Int with { Stdin } {\n  let mut content_length = -1\n  let mut done = false\n  let mut saw_any = false\n  while not(done) {\n    let line = lsp_read_header_line()\n    if String::length(line) == 0 {\n      done = true\n    } else {\n      saw_any = true\n      if String::starts_with(line, \"Content-Length:\") {\n        let rest = String::trim(line[16: String::length(line)])\n        content_length = lsp_parse_uint_or(rest, -1)\n      } else {\n        ()\n      }\n    }\n  }\n  if saw_any {\n    content_length\n  } else {\n    -1\n  }\n}\n\nfn lsp_read_body(n: Int) -> String with { Stdin } {\n  let sb = StringBuilder::new()\n  let mut remaining = n\n  let mut eof = false\n  while remaining > 0 && not(eof) {\n    let chunk = Stdin::read_stream(remaining)\n    if String::length(chunk) == 0 {\n      eof = true\n    } else {\n      StringBuilder::push(sb, chunk)\n      remaining = remaining - String::length(chunk)\n    }\n  }\n  StringBuilder::freeze(sb)\n}\n\n// One full LSP message body, or None once the client closes stdin (normal\n// shutdown path when a client exits without sending `exit`, or after we\n// stop reading post-`exit`).\nfn lsp_read_message() -> Option[String] with { Stdin } {\n  let content_length = lsp_read_content_length()\n  if content_length < 0 {\n    None\n  } else {\n    Some(lsp_read_body(content_length))\n  }\n}\n\nfn lsp_write_message(body: String) -> Unit with { Stdout } {\n  let len = String::length(body)\n  Stdout::write_stream(\"Content-Length: \")\n  Stdout::write_stream(Int::to_string(len))\n  Stdout::write_stream(\"\\r\\n\\r\\n\")\n  Stdout::write_stream(body)\n}\n\n//# JSON helpers\n\nfn jnum_int(n: Int) -> Json {\n  JNum(Int::to_double(n))\n}\n\nfn jpos(line: Int, character: Int) -> Json {\n  JObj(Map::from_pairs([\n    (\"line\", jnum_int(line)),\n    (\"character\", jnum_int(character))\n  ]))\n}\n\nfn jrange(start_line: Int, start_char: Int, end_line: Int, end_char: Int) -> Json {\n  JObj(Map::from_pairs([\n    (\"start\", jpos(start_line, start_char)),\n    (\"end\", jpos(end_line, end_char))\n  ]))\n}\n\nfn jrange_pos(p1: (Int, Int), p2: (Int, Int)) -> Json {\n  let (l1, c1) = p1\n  let (l2, c2) = p2\n  jrange(l1, c1, l2, c2)\n}\n\nfn jlocation(uri: String, r: Json) -> Json {\n  JObj(Map::from_pairs([\n    (\"uri\", JStr(uri)),\n    (\"range\", r)\n  ]))\n}\n\n// Extracts `params.textDocument.uri`; \"\" if absent/malformed.\nfn jparam_uri(params: Json) -> String {\n  Json::string(Json::field(Json::field(params, \"textDocument\"), \"uri\"))\n}\n\nfn jparam_line0(params: Json) -> Int {\n  Double::to_int(Json::number(Json::field(Json::field(params, \"position\"), \"line\")))\n}\n\nfn jparam_char0(params: Json) -> Int {\n  Double::to_int(Json::number(Json::field(Json::field(params, \"position\"), \"character\")))\n}\n\n//# UTF-16 <-> byte offset bridging (LSP positions are UTF-16 code units;\n//# the compiler's own query primitives -- offset_to_line_col, and every\n//# byte offset symbol_spans/binding_occurrences returns -- are byte-\n//# indexed, matching @vibe/parser/lexer.vibe's own \"byte-indexed, not\n//# codepoint-indexed\" convention (see its String::char_code_at usage).\n//# Forwarding an LSP `character` straight into a byte-indexed query, or a\n//# byte column straight into an LSP response, silently misplaces every\n//# hover/definition/references/rename/documentSymbol touching non-ASCII\n//# text before the cursor on its line. `lsp_utf8_seq_len` is a copy of\n//# @vibe/parser/lexer.vibe's own (package-private, so not importable)\n//# helper of the same name.\n\nfn lsp_utf8_seq_len(b0: Int) -> Int {\n  if b0 >= 0xF0 && b0 <= 0xF7 {\n    4\n  } else if b0 >= 0xE0 && b0 <= 0xEF {\n    3\n  } else if b0 >= 0xC2 && b0 <= 0xDF {\n    2\n  } else {\n    1\n  }\n}\n\n// Decodes the Unicode scalar value of the (already-length-known) UTF-8\n// sequence starting at byte `pos`. A malformed/truncated sequence (should\n// not occur in valid document text, but LSP clients are untrusted input)\n// just decodes to whatever the available continuation bytes give --\n// `lsp_utf8_seq_len` already falls back to single-byte granularity for any\n// non-lead byte, so this never reads past what the caller determined.\nfn lsp_utf8_decode(source: String, pos: Int, seq_len: Int) -> Int {\n  if seq_len == 1 {\n    String::char_code_at(source, pos)\n  } else if seq_len == 2 {\n    let b0 = String::char_code_at(source, pos) & 0x1F\n    let b1 = String::char_code_at(source, pos + 1) & 0x3F\n    (b0 << 6) | b1\n  } else if seq_len == 3 {\n    let b0 = String::char_code_at(source, pos) & 0x0F\n    let b1 = String::char_code_at(source, pos + 1) & 0x3F\n    let b2 = String::char_code_at(source, pos + 2) & 0x3F\n    (b0 << 12) | (b1 << 6) | b2\n  } else {\n    let b0 = String::char_code_at(source, pos) & 0x07\n    let b1 = String::char_code_at(source, pos + 1) & 0x3F\n    let b2 = String::char_code_at(source, pos + 2) & 0x3F\n    let b3 = String::char_code_at(source, pos + 3) & 0x3F\n    (b0 << 18) | (b1 << 12) | (b2 << 6) | b3\n  }\n}\n\n// Byte offset where 0-based line `line0` starts in `source` (0 for line0\n// <= 0, else the byte right after that line's '\\n'). A single linear scan\n// from the start; LSP requests are per-edit and this file has no\n// persistent line-offset index to consult instead.\nfn lsp_line_start_offset(source: String, line0: Int) -> Int {\n  if line0 <= 0 {\n    0\n  } else {\n    let len = String::length(source)\n    let mut pos = 0\n    let mut line = 0\n    let mut found = -1\n    while pos < len && found < 0 {\n      if String::char_code_at(source, pos) == 10 {\n        line = line + 1\n        if line == line0 {\n          found = pos + 1\n        }\n      }\n      pos = pos + 1\n    }\n    if found >= 0 {\n      found\n    } else {\n      len\n    }\n  }\n}\n\n// Byte offset of the end of the line starting at `line_start` (exclusive of\n// its trailing '\\n', if any; end of string otherwise).\nfn lsp_line_end_offset(source: String, line_start: Int) -> Int {\n  let len = String::length(source)\n  let mut pos = line_start\n  while pos < len && String::char_code_at(source, pos) != 10 {\n    pos = pos + 1\n  }\n  pos\n}\n\n// LSP `character` (0-based UTF-16 code units into the line starting at\n// `line_start`, ending before `line_end`) -> 0-based BYTE offset from\n// `line_start`. A surrogate pair (astral codepoint, > U+FFFF) counts as 2\n// UTF-16 units but decodes from one 4-byte UTF-8 sequence.\nfn lsp_utf16_to_byte_col(source: String, line_start: Int, line_end: Int, utf16_target: Int) -> Int {\n  let mut pos = line_start\n  let mut units = 0\n  while pos < line_end && units < utf16_target {\n    let b0 = String::char_code_at(source, pos)\n    let seq_len = lsp_utf8_seq_len(b0)\n    let cp = lsp_utf8_decode(source, pos, seq_len)\n    let width = if cp > 0xFFFF {\n      2\n    } else {\n      1\n    }\n    pos = pos + seq_len\n    units = units + width\n  }\n  pos - line_start\n}\n\n// Reverse of lsp_utf16_to_byte_col: 0-based BYTE offset from `line_start`\n// -> 0-based UTF-16 code-unit count.\nfn lsp_byte_col_to_utf16(source: String, line_start: Int, byte_col: Int) -> Int {\n  let mut pos = line_start\n  let target = line_start + byte_col\n  let mut units = 0\n  while pos < target {\n    let b0 = String::char_code_at(source, pos)\n    let seq_len = lsp_utf8_seq_len(b0)\n    let cp = lsp_utf8_decode(source, pos, seq_len)\n    let width = if cp > 0xFFFF {\n      2\n    } else {\n      1\n    }\n    pos = pos + seq_len\n    units = units + width\n  }\n  units\n}\n\n// LSP 0-based (line, UTF-16 character) -> 0-based (line, BYTE column),\n// matching what type_at_source/binding_occurrences expect.\nfn lsp_pos_to_byte_col(source: String, line0: Int, utf16_char0: Int) -> Int {\n  let line_start = lsp_line_start_offset(source, line0)\n  let line_end = lsp_line_end_offset(source, line_start)\n  lsp_utf16_to_byte_col(source, line_start, line_end, utf16_char0)\n}\n\n// Char-offset (as returned by symbol_spans/binding_occurrences) -> LSP\n// 0-based (line, UTF-16 character), via the parser's own offset_to_line_col\n// (which returns 1-based (line, BYTE column), matching the compiler's\n// diagnostic convention) followed by the byte->UTF-16 bridge above.\nfn lsp_offset_to_pos(source: String, offset: Int) -> (Int, Int) {\n  let (line1, col1) = offset_to_line_col(source, offset)\n  let line0 = line1 - 1\n  let byte_col0 = col1 - 1\n  let line_start = lsp_line_start_offset(source, line0)\n  (line0, lsp_byte_col_to_utf16(source, line_start, byte_col0))\n}\n\n//# Diagnostics: parsing \"line L:C: message\" into an LSP Diagnostic\n\nfn lsp_parse_diag_line(msg: String) -> Json {\n  if String::starts_with(msg, \"line \") {\n    let after = msg[5: String::length(msg)]\n    let colon1 = String::index_of(after, \":\")\n    if colon1 < 0 {\n      lsp_diag_fallback(msg)\n    } else {\n      let line_str = after[0: colon1]\n      let rest1 = after[colon1 + 1: String::length(after)]\n      let colon2 = String::index_of(rest1, \":\")\n      if colon2 < 0 {\n        lsp_diag_fallback(msg)\n      } else {\n        let col_str = rest1[0: colon2]\n        let text = String::trim(rest1[colon2 + 1: String::length(rest1)])\n        let line1 = lsp_parse_uint_or(line_str, 1)\n        let col1 = lsp_parse_uint_or(col_str, 1)\n        let line0 = if line1 > 0 { line1 - 1 } else { 0 }\n        let col0 = if col1 > 0 { col1 - 1 } else { 0 }\n        JObj(Map::from_pairs([\n          (\"range\", jrange(line0, col0, line0, col0 + 1)),\n          (\"severity\", jnum_int(1)),\n          (\"source\", JStr(\"vibe\")),\n          (\"message\", JStr(text))\n        ]))\n      }\n    }\n  } else {\n    lsp_diag_fallback(msg)\n  }\n}\n\nfn lsp_diag_fallback(msg: String) -> Json {\n  JObj(Map::from_pairs([\n    (\"range\", jrange(0, 0, 0, 1)),\n    (\"severity\", jnum_int(1)),\n    (\"source\", JStr(\"vibe\")),\n    (\"message\", JStr(msg))\n  ]))\n}\n\n//# Lsp effect handler -- the real implementation, calling straight into\n//# @vibe/compiler/runtime (single-file scope, matching `vibe type-at` /\n//# `vibe binding-at` / `vibe symbols` / `vibe diagnostics` today; imports\n//# are not resolved, same limitation those CLI subcommands already have).\n\nfn lsp_handle_hover(source: String, line0: Int, char0: Int) -> Json {\n  let ty = type_at_source(source, line0 + 1, char0 + 1)\n  if String::length(ty) == 0 {\n    JNull\n  } else {\n    JObj(Map::from_pairs([\n      (\"contents\", JObj(Map::from_pairs([\n        (\"kind\", JStr(\"markdown\")),\n        (\"value\", JStr(String::concat(\"```vibe\\n\", String::concat(ty, \"\\n```\"))))\n      ])))\n    ]))\n  }\n}\n\nfn lsp_handle_definition(source: String, uri: String, line0: Int, char0: Int) -> Json {\n  let occ = binding_occurrences(source, line0 + 1, char0 + 1)\n  if Array::length(occ) == 0 {\n    JNull\n  } else {\n    let (start_off, _end_off) = Array::get(occ, 0)\n    let p = lsp_offset_to_pos(source, start_off)\n    let (l, c) = p\n    jlocation(uri, jrange(l, c, l, c))\n  }\n}\n\nfn lsp_handle_references(source: String, uri: String, line0: Int, char0: Int) -> Json {\n  let occ = binding_occurrences(source, line0 + 1, char0 + 1)\n  JArr(for pair in occ {\n    let (start_off, end_off) = pair\n    let ps = lsp_offset_to_pos(source, start_off)\n    let pe = lsp_offset_to_pos(source, end_off)\n    jlocation(uri, jrange_pos(ps, pe))\n  })\n}\n\nfn lsp_handle_rename(source: String, uri: String, line0: Int, char0: Int, new_name: String) -> Json {\n  let occ = binding_occurrences(source, line0 + 1, char0 + 1)\n  if Array::length(occ) == 0 {\n    JNull\n  } else {\n    let edits = for pair in occ {\n      let (start_off, end_off) = pair\n      let ps = lsp_offset_to_pos(source, start_off)\n      let pe = lsp_offset_to_pos(source, end_off)\n      JObj(Map::from_pairs([\n        (\"range\", jrange_pos(ps, pe)),\n        (\"newText\", JStr(new_name))\n      ]))\n    }\n    let changes = Map::set(Map::new(), uri, JArr(edits))\n    JObj(Map::from_pairs([\n      (\"changes\", JObj(changes))\n    ]))\n  }\n}\n\nfn lsp_handle_document_symbol(source: String) -> Json with { Error } {\n  let syms = symbol_spans(source)\n  JArr(for entry in syms {\n    let (name, kind, start_off, end_off) = entry\n    let ps = lsp_offset_to_pos(source, start_off)\n    let pe = lsp_offset_to_pos(source, end_off)\n    let r = jrange_pos(ps, pe)\n    JObj(Map::from_pairs([\n      (\"name\", JStr(name)),\n      (\"kind\", jnum_int(kind)),\n      (\"range\", r),\n      (\"selectionRange\", r)\n    ]))\n  })\n}\n\nfn lsp_handle_diagnostics(source: String) -> Json with { Error } {\n  let diags = collect_all_diagnostics(source)\n  JArr(for msg in diags {\n    lsp_parse_diag_line(msg)\n  })\n}\n\n// `document_symbol`/`diagnostics` declare `with { Error }` (symbol_spans/\n// collect_all_diagnostics can throw on a genuine internal failure, not just\n// \"no symbols\" -- see cli_adapter.vibe's own VIBE_SYMBOLS branch, which\n// routes a caught Throw to a `.diag` sidecar rather than treating it the\n// same as an empty result). Swallow to an empty array here: an LSP response\n// must always be well-formed JSON, and \"no symbols/diagnostics found\" and\n// \"the query itself failed\" both degrade to the same safe empty response --\n// there is no sidecar channel to report the latter differently over\n// JSON-RPC.\nfn lsp_document_symbol_safe(source: String) -> Json {\n  handle {\n    lsp_handle_document_symbol(source)\n  } with Error {\n    Throw(_) => JArr([])\n  }\n}\n\nfn lsp_diagnostics_safe(source: String) -> Json {\n  handle {\n    lsp_handle_diagnostics(source)\n  } with Error {\n    Throw(_) => JArr([])\n  }\n}\n\n// Which `Lsp` operation a given dispatch should perform -- see\n// lsp_run_with_handler's own doc comment for why this is a plain Int tag\n// rather than a closure value.\nfn lsp_op_hover() -> Int { 0 }\nfn lsp_op_definition() -> Int { 1 }\nfn lsp_op_references() -> Int { 2 }\nfn lsp_op_rename() -> Int { 3 }\nfn lsp_op_document_symbol() -> Int { 4 }\nfn lsp_op_diagnostics() -> Int { 5 }\n\n// The one place all six `Lsp` operations are actually implemented, and the\n// only place any of them is `perform`ed. `docs` is threaded in by\n// reference (an ordinary mutable-variable capture from the caller's scope,\n// per this file's own doc comment: document state is plain mutable state,\n// not itself effect-modeled -- the `Lsp` effect models the COMPILER-QUERY\n// capability, not the document store).\n//\n// Earlier revision dispatched via a `body: () -> Json with { Lsp }`\n// closure PARAMETER (`lsp_dispatch_request` built a one-line closure\n// literal per call site and passed it in here to be perform'd) -- this\n// compiled but trapped (\"indirect call type mismatch\") at runtime the\n// moment it actually ran under real wasmtime (via vibewt; confirmed\n// empirically, not caught by the Node dev-runner's own separate test\n// harness). Root cause: an effectful closure captured BY VALUE and invoked\n// through an opaque higher-order-function parameter is exactly the still-\n// open GENERAL case issue #1070 documents (distinct from, and not covered\n// by, this session's earlier #1070 fix for a NEEDING function calling its\n// own closure-typed parameter -- lsp_run_with_handler isn't itself\n// \"needing\" anything, since it fully discharges `Lsp` right here; nothing\n// downstream of it needs an evidence dict at all). Restructured so\n// `perform` and `handle` are always textually co-located in the SAME\n// function body (an `if`/`else` chain choosing which bare `perform`\n// executes, driven by `op` -- an ordinary Int, never a closure) --\n// precisely the \"handle site sees the perform directly, no function-call\n// boundary in between\" case ADR-0076 (docs/effect-evidence-passing.md)\n// documents as never needing an evidence dict or any closure-value\n// machinery at all, and the only shape actually exercised (transitively,\n// via #1069/#1070/#1074's whole regression corpus) under real wasmtime so\n// far. Each `if` branch's body is EXACTLY one bare perform -- replay-safe\n// by the same reasoning as every other handle in this file (see the\n// header comment): re-executing the branch on `resume` re-evaluates the\n// same deterministic `op` comparison and re-reaches the same (memoized)\n// perform, nothing else.\nfn lsp_run_with_handler(op: Int, uri: String, l: Int, c: Int, new_name: String, docs: Map[String, String]) -> Json {\n  handle {\n    if op == lsp_op_hover() {\n      perform Lsp::Hover(uri, l, c)\n    } else if op == lsp_op_definition() {\n      perform Lsp::Definition(uri, l, c)\n    } else if op == lsp_op_references() {\n      perform Lsp::References(uri, l, c)\n    } else if op == lsp_op_rename() {\n      perform Lsp::Rename(uri, l, c, new_name)\n    } else if op == lsp_op_document_symbol() {\n      perform Lsp::DocumentSymbol(uri)\n    } else {\n      perform Lsp::Diagnostics(uri)\n    }\n  } with Lsp {\n    Hover(u2, l2, c2) => resume({\n      let src = lsp_doc_text(docs, u2)\n      lsp_handle_hover(src, l2, lsp_pos_to_byte_col(src, l2, c2))\n    });\n    Definition(u2, l2, c2) => resume({\n      let src = lsp_doc_text(docs, u2)\n      lsp_handle_definition(src, u2, l2, lsp_pos_to_byte_col(src, l2, c2))\n    });\n    References(u2, l2, c2) => resume({\n      let src = lsp_doc_text(docs, u2)\n      lsp_handle_references(src, u2, l2, lsp_pos_to_byte_col(src, l2, c2))\n    });\n    Rename(u2, l2, c2, nn) => resume({\n      let src = lsp_doc_text(docs, u2)\n      lsp_handle_rename(src, u2, l2, lsp_pos_to_byte_col(src, l2, c2), nn)\n    });\n    DocumentSymbol(u2) => resume(lsp_document_symbol_safe(lsp_doc_text(docs, u2)));\n    Diagnostics(u2) => resume(lsp_diagnostics_safe(lsp_doc_text(docs, u2)))\n  }\n}\n\nfn lsp_doc_text(docs: Map[String, String], uri: String) -> String {\n  if Map::has_key(docs, uri) {\n    Map::get(docs, uri)\n  } else {\n    \"\"\n  }\n}\n\n//# Method dispatch: JSON-RPC method name -> Lsp effect operation\n\nfn lsp_capabilities() -> Json {\n  JObj(Map::from_pairs([\n    (\"textDocumentSync\", jnum_int(1)),\n    (\"hoverProvider\", JBool(true)),\n    (\"definitionProvider\", JBool(true)),\n    (\"referencesProvider\", JBool(true)),\n    (\"renameProvider\", JBool(true)),\n    (\"documentSymbolProvider\", JBool(true))\n  ]))\n}\n\nfn lsp_initialize_result() -> Json {\n  JObj(Map::from_pairs([\n    (\"capabilities\", lsp_capabilities()),\n    (\"serverInfo\", JObj(Map::from_pairs([\n      (\"name\", JStr(\"vibe-lsp-selfhost\")),\n      (\"version\", JStr(\"0.1.0\"))\n    ])))\n  ]))\n}\n\n// Handles one Request (has an `id`, needs a response) or Notification (no\n// response). Returns Some(result_json) for a request, None for a\n// notification or an unrecognized method the caller already replied `null`\n// to.\nfn lsp_dispatch_request(method: String, params: Json, docs: Map[String, String]) -> Json {\n  if method == \"initialize\" {\n    lsp_initialize_result()\n  } else if method == \"textDocument/hover\" {\n    let uri = jparam_uri(params)\n    let l = jparam_line0(params)\n    let c = jparam_char0(params)\n    lsp_run_with_handler(lsp_op_hover(), uri, l, c, \"\", docs)\n  } else if method == \"textDocument/definition\" {\n    let uri = jparam_uri(params)\n    let l = jparam_line0(params)\n    let c = jparam_char0(params)\n    lsp_run_with_handler(lsp_op_definition(), uri, l, c, \"\", docs)\n  } else if method == \"textDocument/references\" {\n    let uri = jparam_uri(params)\n    let l = jparam_line0(params)\n    let c = jparam_char0(params)\n    lsp_run_with_handler(lsp_op_references(), uri, l, c, \"\", docs)\n  } else if method == \"textDocument/rename\" {\n    let uri = jparam_uri(params)\n    let l = jparam_line0(params)\n    let c = jparam_char0(params)\n    let new_name = Json::string(Json::field(params, \"newName\"))\n    lsp_run_with_handler(lsp_op_rename(), uri, l, c, new_name, docs)\n  } else if method == \"textDocument/documentSymbol\" {\n    let uri = jparam_uri(params)\n    lsp_run_with_handler(lsp_op_document_symbol(), uri, 0, 0, \"\", docs)\n  } else if method == \"shutdown\" {\n    JNull\n  } else {\n    JNull\n  }\n}\n\nfn lsp_diagnostics_for(uri: String, docs: Map[String, String]) -> Json {\n  lsp_run_with_handler(lsp_op_diagnostics(), uri, 0, 0, \"\", docs)\n}\n\n//# Document store (plain mutable state -- see the effect handler's own doc\n//# comment for why this is deliberately NOT effect-modeled)\n\nfn lsp_apply_did_open(docs: Map[String, String], params: Json) -> Map[String, String] {\n  let uri = jparam_uri(params)\n  let text = Json::string(Json::field(Json::field(params, \"textDocument\"), \"text\"))\n  Map::set(docs, uri, text)\n}\n\nfn lsp_apply_did_change(docs: Map[String, String], params: Json) -> Map[String, String] {\n  let uri = jparam_uri(params)\n  let changes = Json::field(params, \"contentChanges\")\n  if Json::length(changes) == 0 {\n    docs\n  } else {\n    // Full-document sync (declared capability): the last change entry's\n    // `text` is the WHOLE new document, matching textDocumentSync=1.\n    let last = Json::index(changes, Json::length(changes) - 1)\n    let text = Json::string(Json::field(last, \"text\"))\n    Map::set(docs, uri, text)\n  }\n}\n\nfn lsp_apply_did_close(docs: Map[String, String], params: Json) -> Map[String, String] {\n  let uri = jparam_uri(params)\n  Map::delete(docs, uri)\n}\n\n//# JSON-RPC envelope (built directly on Json/Json::field -- see this\n//# file's import comment for why @vibe/json/jsonrpc.vibe's own RpcMessage/\n//# RpcId codec is deliberately not used here)\n\n// JNull on malformed JSON (Json::parse's own contract) -- lsp_env_method\n// below then reads as \"\" for such a message, which lsp_step's dispatch\n// already treats as a no-op.\nfn lsp_parse_envelope(body: String) -> Json {\n  Json::parse(body)\n}\n\nfn lsp_env_method(j: Json) -> String {\n  Json::string(Json::field(j, \"method\"))\n}\n\nfn lsp_env_params(j: Json) -> Json {\n  Json::field(j, \"params\")\n}\n\n// The raw `id` value (JNum/JStr), passed straight back into the response\n// envelope -- LSP/JSON-RPC ids round-trip opaquely, no need to model RpcId.\nfn lsp_env_id(j: Json) -> Json {\n  Json::field(j, \"id\")\n}\n\n// A message with a non-null `id` is a request (expects a response); one\n// with no/null `id` is a notification. (JSON-RPC technically allows a null\n// `id` ON a request too, an edge case no real LSP client sends -- treating\n// it as a notification here just means we silently skip replying to a\n// message that, practically, never occurs.)\nfn lsp_env_is_request(j: Json) -> Bool {\n  String::length(lsp_env_method(j)) > 0 && !Json::is_null(lsp_env_id(j))\n}\n\nfn lsp_env_is_notification(j: Json) -> Bool {\n  String::length(lsp_env_method(j)) > 0 && Json::is_null(lsp_env_id(j))\n}\n\nfn lsp_stringify_response(id: Json, result: Json) -> String {\n  Json::stringify(JObj(Map::from_pairs([\n    (\"jsonrpc\", JStr(\"2.0\")),\n    (\"id\", id),\n    (\"result\", result)\n  ])))\n}\n\nfn lsp_stringify_notification(method: String, params: Json) -> String {\n  Json::stringify(JObj(Map::from_pairs([\n    (\"jsonrpc\", JStr(\"2.0\")),\n    (\"method\", JStr(method)),\n    (\"params\", params)\n  ])))\n}\n\n//# Main loop\n\nfn lsp_send_response(id: Json, result: Json) -> Unit with { Stdout } {\n  lsp_write_message(lsp_stringify_response(id, result))\n}\n\nfn lsp_send_diagnostics_notification(uri: String, diags: Json) -> Unit with { Stdout } {\n  let params = JObj(Map::from_pairs([\n    (\"uri\", JStr(uri)),\n    (\"diagnostics\", diags)\n  ]))\n  lsp_write_message(lsp_stringify_notification(\"textDocument/publishDiagnostics\", params))\n}\n\n// One iteration: read a message, act on it, write a response if needed.\n// Returns (new_docs, should_exit).\nfn lsp_step(docs: Map[String, String]) -> (Map[String, String], Bool) with { Stdin, Stdout } {\n  match lsp_read_message() {\n    None => (docs, true),\n    Some(body) => {\n      let msg = lsp_parse_envelope(body)\n      if lsp_env_is_request(msg) {\n        let method = lsp_env_method(msg)\n        let params = lsp_env_params(msg)\n        let id = lsp_env_id(msg)\n        let result = lsp_dispatch_request(method, params, docs)\n        lsp_send_response(id, result)\n        // Per the LSP spec's shutdown sequence: reply to `shutdown`, then\n        // keep serving (a well-behaved client sends nothing further, but\n        // MUST NOT see the connection close before its own `exit`\n        // notification arrives) until `exit` actually terminates the loop\n        // below. Terminating right here used to close stdout mid-teardown\n        // from the client's point of view.\n        (docs, false)\n      } else if lsp_env_is_notification(msg) {\n        let method = lsp_env_method(msg)\n        let params = lsp_env_params(msg)\n        if method == \"exit\" {\n          (docs, true)\n        } else if method == \"initialized\" {\n          (docs, false)\n        } else if method == \"textDocument/didOpen\" {\n          let new_docs = lsp_apply_did_open(docs, params)\n          let uri = jparam_uri(params)\n          lsp_send_diagnostics_notification(uri, lsp_diagnostics_for(uri, new_docs))\n          (new_docs, false)\n        } else if method == \"textDocument/didChange\" {\n          let new_docs = lsp_apply_did_change(docs, params)\n          let uri = jparam_uri(params)\n          lsp_send_diagnostics_notification(uri, lsp_diagnostics_for(uri, new_docs))\n          (new_docs, false)\n        } else if method == \"textDocument/didSave\" {\n          let uri = jparam_uri(params)\n          lsp_send_diagnostics_notification(uri, lsp_diagnostics_for(uri, docs))\n          (docs, false)\n        } else if method == \"textDocument/didClose\" {\n          let new_docs = lsp_apply_did_close(docs, params)\n          let uri = jparam_uri(params)\n          lsp_send_diagnostics_notification(uri, JArr([]))\n          (new_docs, false)\n        } else {\n          (docs, false)\n        }\n      } else {\n        // No method (a response to a request WE sent, or malformed JSON) --\n        // this server issues no client-bound requests in v1, so there is\n        // nothing to correlate a reply against; nothing to do.\n        (docs, false)\n      }\n    }\n  }\n}\n\nexport fn lsp_main() -> Int with { Stdin, Stdout } {\n  let mut docs = Map::new()\n  let mut running = true\n  while running {\n    let (new_docs, should_exit) = lsp_step(docs)\n    docs = new_docs\n    running = not(should_exit)\n  }\n  0\n}\n")
}

let cli_adapter_source_243 = () -> (String, String) {
  ("lib/@vibe/compiler/cli_adapter.vibe",
"//# Imports\n\n// #897: package-form import (wasi_only/ is now an index.vpkg boundary) --\n// these used to be two separate leaf imports (preprocess.vibe,\n// merge_sources.vibe), now merged into one.\nimport @vibe/compiler/entry/source_compile/wasi_only {\n  compile_source_wasi_only, compile_source_wasi_only_coverage, compile_source_wasi_only_rc, compile_source_wasi_only_rc_shadow,\n  merged_program_source_fs,\n  comp_emit_component_wasm_string_handler\n}\n\nimport @vibe/compiler/entry/source_compile/gc_only {\n  compile_source_gc_only\n}\n\nimport @vibe/compiler/runtime {\n  build_module_source_from_source, build_funcmap_from_source,\n  type_at_source, binding_occurrences, symbol_spans, collect_all_diagnostics\n}\n\nimport @vibe/compiler/loader {\n  contract_package_hashes_fs, fill_require_pins_fs_mode, find_missing_vpkg_dirs, publish_check_fs\n}\n\nimport @vibe/compiler/entry/compiler/file_compile {\n  compile_file_fs_mode, compile_file_fs_mode_rc, compile_file_fs_mode_rc_shadow, compile_file_fs_mode_coverage, compile_file_fs_mode_trace, compile_file_fs_mode_break, compile_file_fs_mode_testmeta\n}\n\nimport @vibe/compiler/normalize {\n  normalize_source\n}\n\nimport ./wit_gen.vibe {\n  serve_handler_param_names, validate_serve_handler, wit_from_program\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program\n}\n\nimport ./cli_support.vibe {\n  check_linked_file\n}\n\nimport ./lsp_server.vibe {\n  lsp_main\n}\n\n//# Functions\n\n// Basename of a path without its `.vibe` suffix — the default WIT world name\n// for #537 (`foo/bar_server.vibe` -> `bar_server`, kebab-cased by wit_gen).\nfn adapter_basename_no_vibe(path: String) -> String {\n  let len = String::length(path)\n  let mut last_slash = 0 - 1\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(path, i) == 47 {\n      last_slash = i\n    }\n    i = i + 1\n  }\n  let base = path[last_slash + 1: len]\n  let blen = String::length(base)\n  if blen >= 5 && base[blen - 5: blen] == \".vibe\" {\n    base[0: blen - 5]\n  } else {\n    base\n  }\n}\n\n// Join `items` with \"\\n\" using String::concat only (no `+`/interpolation, which\n// can miscodegen NUL here). Empty array -> \"\".\nfn join_lines(items: Array[String]) -> String {\n  let n = Array::length(items)\n  if n == 0 {\n    \"\"\n  } else {\n    // O(N) join via StringBuilder; per-item String::concat was O(N²) (issue #366).\n    let acc = StringBuilder::new()\n    StringBuilder::push(acc, Array::get(items, 0))\n    let mut i = 1\n    while i < n {\n      StringBuilder::push(acc, \"\\n\")\n      StringBuilder::push(acc, Array::get(items, i))\n      i = i + 1\n    }\n    StringBuilder::freeze(acc)\n  }\n}\n\n// Render `vibe symbols` records as one `NAME KIND START END` line per declared\n// symbol (space-separated; KIND/START/END are ints), joined by \"\\n\". Records\n// with an empty name (unrecoverable offset placeholder) are skipped.\n// String::concat + __to_string only (never `+`/interpolation -> NUL miscodegen).\n// Empty -> \"\".\nfn join_symbol_spans(syms: Array[(String, Int, Int, Int)]) -> String {\n  let n = Array::length(syms)\n  // O(N) join via StringBuilder; per-record String::concat was O(N²) (issue #366).\n  let acc = StringBuilder::new()\n  let mut first = true\n  let mut i = 0\n  while i < n {\n    let (name, kind, s, e) = Array::get(syms, i)\n    if String::length(name) == 0 {\n      ()\n    } else {\n      let line = String::concat(name, String::concat(\" \", String::concat(__to_string(kind), String::concat(\" \", String::concat(__to_string(s), String::concat(\" \", __to_string(e)))))))\n      if first {\n        StringBuilder::push(acc, line)\n        first = false\n      } else {\n        StringBuilder::push(acc, \"\\n\")\n        StringBuilder::push(acc, line)\n      }\n    }\n    i = i + 1\n  }\n  StringBuilder::freeze(acc)\n}\n\n// Render `vibe binding-at` occurrences as one `START END` line per span (two\n// space-separated ints), joined by \"\\n\". String::concat + __to_string only\n// (never `+`/interpolation, which miscodegen NUL here). Empty -> \"\".\nfn join_binding_occurrences(occ: Array[(Int, Int)]) -> String {\n  let n = Array::length(occ)\n  if n == 0 {\n    \"\"\n  } else {\n    let (s0, e0) = Array::get(occ, 0)\n    // O(N) join via StringBuilder; per-occurrence String::concat was O(N²) (issue #366).\n    let acc = StringBuilder::new()\n    StringBuilder::push(acc, String::concat(__to_string(s0), String::concat(\" \", __to_string(e0))))\n    let mut i = 1\n    while i < n {\n      let (s, e) = Array::get(occ, i)\n      let line = String::concat(__to_string(s), String::concat(\" \", __to_string(e)))\n      StringBuilder::push(acc, \"\\n\")\n      StringBuilder::push(acc, line)\n      i = i + 1\n    }\n    StringBuilder::freeze(acc)\n  }\n}\n\n// Parse a non-negative decimal int from `s`; on any non-digit (or empty) return\n// `default`. String::concat-safe (no `+`/interpolation): folds digits via\n// `acc * 10 + (c - '0')`.\nfn parse_int_or(s: String, default: Int) -> Int {\n  let len = String::length(s)\n  if len == 0 {\n    default\n  } else {\n    let mut i = 0\n    let mut acc = 0\n    let mut ok = true\n    while ok && i < len {\n      let c = String::char_code_at(s, i)\n      if c >= '0' && c <= '9' {\n        acc = acc * 10 + (c - '0')\n        i = i + 1\n      } else {\n        ok = false\n      }\n    }\n    if ok {\n      acc\n    } else {\n      default\n    }\n  }\n}\n\nfn adapter_string_to_bytes(s: String) -> Bytes {\n  let out = Array::slice([\n    0\n  ], 0, 0)\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Array::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  Bytes::from_array(out)\n}\n\nfn read_arg_or_env(index: Int, env_name: String) -> String with { Env } {\n  let value = Env::args_get(index)\n  if value != \"\" {\n    value\n  } else {\n    Env::get(env_name)\n  }\n}\n\nfn own_host_string(value: String) -> String {\n  String::concat(\"\", value)\n}\n\nfn profile_memory_mark(enabled: Bool) -> Unit with { Env } {\n  if enabled {\n    let _ = Env::get(\"VIBE_PROFILE_MEMORY_MARK\")\n    ()\n  } else {\n    ()\n  }\n}\n\n// #cfg activation: VIBE_CFG=flag1,flag2 appends `#cfg_enable(flag)` directive\n// lines to the source (appending at the END keeps every original byte offset,\n// so diagnostics/spans are unaffected). parse_program pre-scans for these and\n// keeps the matching `#cfg(flag)` statements; with VIBE_CFG unset, every\n// #cfg-guarded statement is parsed-and-dropped -- zero bytes in the output.\nfn apply_cfg_env(source: String, cfg_csv: String) -> String {\n  if cfg_csv == \"\" {\n    source\n  } else {\n    let parts = String::split(cfg_csv, \",\")\n    let mut out = source\n    let mut i = 0\n    while i < Array::length(parts) {\n      let flag = String::trim(Array::get(parts, i))\n      if String::length(flag) > 0 {\n        out = String::concat(out, String::concat(\"\\n#cfg_enable(\", String::concat(flag, \")\")))\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    out\n  }\n}\n\nfn compile_source_for_rc_flag(source: String, entry_name: String, rc_flag: String) -> Bytes with { Error } {\n  // ADR-0055 #493 cutover: the Perceus RC codegen (memory-reclaiming linear\n  // backend) is the DEFAULT; set VIBE_RC=0 to opt back into the legacy bump\n  // path. The compiler self-build, bootstrap, and bump-baseline gates pin\n  // VIBE_RC=0 (see scripts/*.sh) so they stay byte-identical on bump.\n  if rc_flag == \"shadow\" {\n    // #715 recurrence guard: RC codegen + shadow-liveness traps (debug builds).\n    compile_source_wasi_only_rc_shadow(source, entry_name)\n  } else if rc_flag != \"0\" {\n    compile_source_wasi_only_rc(source, entry_name)\n  } else {\n    compile_source_wasi_only(source, entry_name)\n  }\n}\n\n// On a parse/type/codegen error the checker throws a formatted diagnostic\n// String. Surface it to tooling by writing it to an `<output>.diag` sidecar so\n// the `vibe` launcher can print a real message instead of an opaque wasm trap.\n// Returns a non-zero exit code. (#594 usability / docs/release-roadmap.md.)\nfn emit_compile_diag(output_path: String, msg: String) -> Int with { Fs } {\n  Fs::write_file(String::concat(output_path, \".diag\"), msg)\n  1\n}\n\n// debugger テーマ3 / M2: best-effort `.funcmap` sidecar beside the compiled wasm.\n// Maps each ENTRY-file top-level function to its 1-based source line so the\n// `vibe run` launcher can annotate trap backtrace frames with (file:line). The\n// wasm \"name\" section (debugger P0) already names the frames; this adds lines.\n//\n// Best-effort: a failure to build/write the funcmap must NOT fail the compile —\n// the wasm write already returned 0. So we wrap the work in its own handler and\n// swallow any Error::Throw. Entry-file functions only (imported modules: future\n// work).\n// Returns 0 (the value is consumed at the call site so the call is never DCE'd:\n// it is a discarded `Unit` side-effect otherwise, which aggressive DCE in the\n// seed compiler may drop).\nfn write_funcmap_sidecar(input_path: String, output_path: String) -> Int with { Fs, Error } {\n  let src = Fs::read_file(input_path)\n  let text = build_funcmap_from_source(src)\n  Fs::write_bytes(String::concat(output_path, \".funcmap\"), adapter_string_to_bytes(text))\n  0\n}\n\n// #537 `vibe compile --wit`: emit the WIT world for the file's effect surface\n// (exported functions -> world exports; their `with { E }` rows -> world\n// imports). Imports resolved from FS. Contract: docs/effect-wit-mapping.md.\n// The Error handle is this function's tail (the proven adapter shape) rather\n// than a `return handle` inside cli_main's dispatch chain.\n// Entry-file-only surface scan (v1): exports and effect declarations are read\n// from the entry file itself; effects declared only in imported modules render\n// as host-capability comments (documented in docs/effect-wit-mapping.md).\nfn adapter_emit_wit(input_path: String, output_path: String) -> Int with { Fs, Env } {\n  handle {\n    let entry_stmts = parse_program(lex(Fs::read_file(input_path)))\n    let wit = wit_from_program(entry_stmts, entry_stmts, adapter_basename_no_vibe(input_path))\n    Fs::write_bytes(output_path, adapter_string_to_bytes(wit))\n    0\n  } with Error {\n    Throw(msg) => emit_compile_diag(output_path, msg)\n  }\n}\n\n// #537 `vibe serve` artifact step: validate the wasi-http P3 handler contract,\n// compile the file, and wrap it into a component exporting\n//   handler: func(method, url, headers, body: string) -> string\n// The runner layer (runtime/vibe serve) composes the result with the P3 HTTP\n// adapter and launches `wasmtime serve` — artifact generation stays in the\n// compiler, serving stays in the runner. VIBE_SERVE_WIT_OUT optionally writes\n// the WIT world sidecar.\nfn adapter_serve_component(input_path: String, output_path: String) -> Int with { Fs, Env } {\n  handle {\n    let entry_stmts = parse_program(lex(Fs::read_file(input_path)))\n    validate_serve_handler(entry_stmts)\n    // No command entry: the component surface is `handler`. `__no_entry__`\n    // is the explicit sentinel — any other unknown entry name is a compile\n    // error since ADR-0069.\n    let core = compile_file_fs_mode(input_path, \"__no_entry__\", \"no-dce\")\n    let component = comp_emit_component_wasm_string_handler(core, \"handler\", \"handler\", serve_handler_param_names())\n    Fs::write_bytes(output_path, component)\n    let wit_out = Env::get(\"VIBE_SERVE_WIT_OUT\")\n    if wit_out != \"\" {\n      Fs::write_bytes(wit_out, adapter_string_to_bytes(wit_from_program(entry_stmts, entry_stmts, adapter_basename_no_vibe(input_path))))\n    } else {\n      ()\n    }\n    0\n  } with Error {\n    Throw(msg) => emit_compile_diag(output_path, msg)\n  }\n}\n\nexport fn cli_main() -> Int with { Error, Fs, Env, Stdin, Stdout } {\n  // `vibe lsp` (self-hosted, #lsp-selfhost): takes over stdin/stdout\n  // directly as a long-running JSON-RPC server -- unlike every other mode\n  // below, it never reads VIBE_INPUT/VIBE_OUTPUT or writes to output_path.\n  // Checked first so it never touches the one-shot input/output-file\n  // machinery the rest of this function assumes.\n  if Env::get(\"VIBE_LSP\") == \"1\" {\n    return lsp_main()\n  }\n  let input_path = own_host_string(read_arg_or_env(0, \"VIBE_INPUT\"))\n  let output_path = own_host_string(read_arg_or_env(1, \"VIBE_OUTPUT\"))\n  let entry_name = own_host_string(read_arg_or_env(2, \"VIBE_ENTRY\"))\n  let mark_memory = Env::get(\"VIBE_PROFILE_MEMORY_MARKS\") == \"1\"\n  // #730 (D-2): `vibe hash` — print a contract package's content-addressing\n  // hashes. Input is the package's index.vibei; the output file receives\n  // \"package #pkg:sha1:<hex>\" and \"contract ct:sha1:<hex>\" lines. The\n  // package line is copy-pasteable as a require pin.\n  if Env::get(\"VIBE_HASH\") == \"1\" {\n    return handle {\n      let (pkg_hash, ct_hash) = contract_package_hashes_fs(input_path)\n      Fs::write_file(output_path, \"package #\\{pkg_hash}\\ncontract \\{ct_hash}\\n\")\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #897 (ADR-0070): `vibe check --missing-vpkg <root>` -- recursively scan\n  // `input_path` (a directory) for every boundary directory still on the\n  // old `index.vibei`/bare `index.vibe` spelling. Writes \"ok: none missing\"\n  // on a clean tree, or the newline-joined list of directories on the same\n  // diag sidecar every other check diagnostic uses, matching VIBE_HASH's\n  // shape immediately above.\n  if Env::get(\"VIBE_MISSING_VPKG_SCAN\") == \"1\" {\n    return handle {\n      let missing = find_missing_vpkg_dirs(input_path)\n      if Array::length(missing) == 0 {\n        Fs::write_file(output_path, \"ok: no directories missing index.vpkg under \\{input_path}\\n\")\n      } else {\n        Fs::write_file(output_path, String::concat(String::join(missing, \"\\n\"), \"\\n\"))\n      }\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #730 (D-3): `vibe fmt` pin insertion — fill unpinned require lines\n  // OFFLINE from the workspace store and write the completed source to the\n  // output path. Idempotent; pinned form is the canonical form.\n  if Env::get(\"VIBE_FILL_PINS\") == \"1\" {\n    return handle {\n      let filled = fill_require_pins_fs_mode(Fs::read_file(input_path), Env::get(\"VIBE_REPIN\") == \"1\")\n      Fs::write_file(output_path, filled)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #732 (Phase F): `vibe publish` semver gate. input = the NEXT contract;\n  // VIBE_PUBLISH_PREV / _PREV_VERSION / _VERSION describe the previous\n  // release. Writes \"ok\" on an honest bump; a dishonest claim is a diag.\n  if Env::get(\"VIBE_PUBLISH_CHECK\") == \"1\" {\n    return handle {\n      let perrors = publish_check_fs(\n        Env::get(\"VIBE_PUBLISH_PREV\"),\n        input_path,\n        Env::get(\"VIBE_PUBLISH_PREV_VERSION\"),\n        Env::get(\"VIBE_PUBLISH_VERSION\")\n      )\n      if Array::length(perrors) > 0 {\n        throw(String::join(perrors, \"; \"))\n      } else ()\n      Fs::write_file(output_path, \"ok\\n\")\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #946(3): `vibe check` — parse + typecheck ONLY (imports resolved from the\n  // FS, same as VIBE_FS_COMPILE below), no codegen and no entry-function\n  // requirement. Before this, `vibe check` reused the full VIBE_FS_COMPILE\n  // (build) path, so an empty-or-comments-only file failed check with\n  // \"no functions found to compile\" (a real build/codegen constraint — you\n  // cannot emit a runnable wasm module with zero functions) while `vibe\n  // diagnostics` reported the SAME file clean: two contradictory judgments on\n  // one input. check_linked_file (Gate v2 #492) already implements the\n  // correct check-only semantics (it stops before codegen, so it has no\n  // notion of \"no functions\" or \"missing entry\" — both are build-only\n  // concerns) but was never wired to this CLI verb. Writes \"ok\\n\" on a clean\n  // parse+typecheck; a parse/type error goes to the `.diag` sidecar, same\n  // convention as every other adapter mode.\n  if Env::get(\"VIBE_CHECK_ONLY\") == \"1\" {\n    return handle {\n      let _ = check_linked_file(input_path)\n      Fs::write_file(output_path, \"ok\\n\")\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #594 Stage 3 (debug): file-mode compile resolving imports from the FS.\n  if Env::get(\"VIBE_FS_COMPILE\") == \"1\" {\n    // #cov: `vibe test/run --coverage` sets VIBE_COVERAGE=1 so the user file (and\n    // its imports) is compiled with function/branch hit instrumentation; running\n    // the produced wasm fills the bitmap that the runner reads via VIBE_COV_OUT.\n    return handle {\n      // debugger trace (DAP P1 groundwork): `vibe run --trace` sets VIBE_DEBUG=1\n      // so the user file (and its imports) is compiled with function-call\n      // execution-trace instrumentation; running the produced wasm fills the\n      // in-memory trace log that the runner dumps via VIBE_TRACE_OUT.\n      // The special compile MODES (coverage / debugger break / trace) are\n      // checked first; they are mutually exclusive instrumentation builds and\n      // are unaffected by the RC cutover. The normal compile then defaults to\n      // the Perceus RC backend (#493 cutover, #705 parity) unless VIBE_RC=0\n      // selects the legacy bump path (which carries the #634 testmeta variant).\n      let bytes = if Env::get(\"VIBE_COVERAGE\") == \"1\" {\n        compile_file_fs_mode_coverage(input_path, entry_name)\n      } else if Env::get(\"VIBE_DEBUG_BREAK\") == \"1\" {\n        // debugger breakpoint (DAP P1): `vibe run --break` sets VIBE_DEBUG_BREAK=1\n        // so the user file is compiled with `vibe::dbg_break` host-hook calls at\n        // each user function entry; the runner pauses on the named breakpoints.\n        compile_file_fs_mode_break(input_path, entry_name)\n      } else if Env::get(\"VIBE_DEBUG\") == \"1\" {\n        compile_file_fs_mode_trace(input_path, entry_name)\n      } else if Env::get(\"VIBE_RC\") == \"shadow\" {\n        // #715/#768: shadow-liveness double-free traps for import-resolving\n        // builds (previously only the single-source path honored \"shadow\";\n        // this path silently compiled plain RC).\n        compile_file_fs_mode_rc_shadow(input_path, entry_name)\n      } else if Env::get(\"VIBE_RC\") != \"0\" {\n        // ADR-0055 #493 cutover DEFAULT: RC reclaims memory each iteration; the\n        // legacy bump path leaks until exit. Opt back into bump with VIBE_RC=0.\n        compile_file_fs_mode_rc(input_path, entry_name)\n      } else {\n        // Legacy bump path (VIBE_RC=0). #634 (ADR-0026): only when `vibe test`\n        // requests the pure-test cache verdict (VIBE_TESTMETA_OUT set) do we\n        // route through the variant that ALSO emits the `.testmeta` sidecar\n        // (riding the merged stmts this compile already builds — no extra\n        // parse). Env is read here (this layer has it), keeping the file_compile\n        // layer Env-free.\n        let testmeta_out = Env::get(\"VIBE_TESTMETA_OUT\")\n        if testmeta_out != \"\" {\n          compile_file_fs_mode_testmeta(input_path, entry_name, \"no-dce\", testmeta_out)\n        } else {\n          compile_file_fs_mode(input_path, entry_name, \"no-dce\")\n        }\n      }\n      Fs::write_bytes(output_path, bytes)\n      // Best-effort `.funcmap` sidecar (entry-file top-level funcs -> line). A\n      // failure to build/write it must NOT fail the compile (the wasm is already\n      // written), so swallow any Error::Throw here. The discarded result is bound\n      // so the call is not DCE'd as a dead Unit side-effect.\n      let _funcmap_rc = handle {\n        write_funcmap_sidecar(input_path, output_path)\n      } with Error {\n        Throw(_) => 0\n      }\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n  // #594 `vibe normalize`: canonicalize a source file (module flatten + DCE +\n  // section layout) and write the result. Same (input, output) interface.\n  if Env::get(\"VIBE_NORMALIZE\") == \"1\" {\n    let normalized = normalize_source(Fs::read_file(input_path))\n    Fs::write_bytes(output_path, adapter_string_to_bytes(normalized))\n    return 0\n  }\n  // `vibe type-at`: typed hover (first LSP consumer of real EIdent offsets).\n  // VIBE_TYPE_LINE/COL are 1-based (matching offset_to_line_col). Writes the\n  // inferred type string of the identifier at that position, or empty when there\n  // is no env-visible ident there (see type_at.vibe LIMITATION note).\n  if Env::get(\"VIBE_TYPE_AT\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let line = parse_int_or(Env::get(\"VIBE_TYPE_LINE\"), 1)\n    let col = parse_int_or(Env::get(\"VIBE_TYPE_COL\"), 1)\n    let ty = type_at_source(src, line, col)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(ty))\n    return 0\n  }\n  // `vibe binding-at`: AST-accurate binding occurrences (scope-precision rename /\n  // references groundwork). VIBE_TYPE_LINE/COL are 1-based. Writes one `START END`\n  // line per source span of the identifier under the cursor, or empty when there\n  // is no identifier there (see binding_at.vibe LIMITATION: name-based, no\n  // shadowing analysis yet).\n  if Env::get(\"VIBE_BINDING_AT\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let line = parse_int_or(Env::get(\"VIBE_TYPE_LINE\"), 1)\n    let col = parse_int_or(Env::get(\"VIBE_TYPE_COL\"), 1)\n    let occ = binding_occurrences(src, line, col)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(join_binding_occurrences(occ)))\n    return 0\n  }\n  // `vibe symbols`: AST-accurate declaration outline. Writes one\n  // `NAME KIND START END` line per declared symbol (KIND = LSP SymbolKind int,\n  // START/END = char offsets of the name), or empty when the file declares none.\n  // Powers document-outline / go-to-definition without a text-regex scan.\n  //\n  // #946: `symbol_spans` throws (e.g. a lexer error on an unsupported\n  // character) was never caught here, so a genuine crash and \"file declares\n  // no symbols\" both produced the exact same empty `output_path` — the CLI\n  // launcher had no way to tell an editor \"the outline failed\" from \"there's\n  // nothing to show\". Route a thrown Error to the same `.diag` sidecar\n  // convention as VIBE_CHECK_ONLY below: `output_path` itself (the outline\n  // wire format LSP clients parse) is untouched on failure, so this can't\n  // emit a \"plausible but wrong\" symbol list.\n  if Env::get(\"VIBE_SYMBOLS\") == \"1\" {\n    return handle {\n      let src = Fs::read_file(input_path)\n      let syms = symbol_spans(src)\n      Fs::write_bytes(output_path, adapter_string_to_bytes(join_symbol_spans(syms)))\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n  // `vibe diagnostics`: collect ALL syntax errors (recovering parser) or the\n  // single located type error, one per line. A report, not a failure — always\n  // returns 0 (empty output means clean).\n  if Env::get(\"VIBE_DIAGNOSTICS\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let diags = collect_all_diagnostics(src)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(join_lines(diags)))\n    return 0\n  }\n  // #726: emit the MERGED whole program as source text. `input_path` is an\n  // entry file whose imports resolve from the FS; the output is the flat\n  // source produced by the real merge machinery (export-rename plan +\n  // private namespacing), replacing the Python flattener in\n  // scripts/generate_bundle.sh. The flatten step compiles the\n  // COMMITTED flat module source with the seed (the same robust single-file\n  // lane as stage1) and runs this mode on it — the previous standalone-tool\n  // approach FS-compiled the whole 200-file graph with the seed, which hits\n  // a deterministic cold-cache OOB inside the FIXED seed binary\n  // (build_persistent_sources_cache_text; unreachable in this lane).\n  // Adding this adapter -> merge_sources import edge is safe now that the\n  // committed bundle is itself merge-built (zero duplicate defs, no\n  // first-match roulette to reshuffle).\n  if Env::get(\"VIBE_EMIT_MERGED_SOURCE\") == \"1\" {\n    return handle {\n      let merged_src = merged_program_source_fs(input_path)\n      Fs::write_file(output_path, merged_src)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n  // #537 `vibe compile --wit`: emit the WIT world for the file's effect\n  // surface (exported functions -> world exports; their `with { E }` rows ->\n  // world imports). Same (input, output) interface; imports resolved from FS.\n  // Contract: docs/effect-wit-mapping.md.\n  if Env::get(\"VIBE_EMIT_WIT\") == \"1\" {\n    return adapter_emit_wit(input_path, output_path)\n  }\n  // #537 `vibe serve` artifact step: validate the wasi-http P3 handler\n  // contract, compile the file, and wrap it into a component exporting\n  //   handler: func(method, url, headers, body: string) -> string\n  // The runner layer (runtime/vibe serve / scripts) composes the result with\n  // the P3 HTTP adapter and launches `wasmtime serve` — artifact generation\n  // stays in the compiler, serving stays in the runner.\n  if Env::get(\"VIBE_SERVE_COMPONENT\") == \"1\" {\n    return adapter_serve_component(input_path, output_path)\n  }\n  let source = Fs::read_file(input_path)\n  profile_memory_mark(mark_memory)\n  // #594 Stage 1b: emit-module-source mode. VIBE_EMIT_MODULE_SOURCE=1 reuses the\n  // same (input, output, entry) interface but, instead of compiling, writes the\n  // flat module source for `entry_name` (DCE from the entry, surviving statements\n  // emitted as their original source text). This is the replacement for\n  // the MoonBit host `emit-module-source`, so the flat-source step needs no host.\n  if Env::get(\"VIBE_EMIT_MODULE_SOURCE\") == \"1\" {\n    let module_source = build_module_source_from_source(source, entry_name)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(module_source))\n    profile_memory_mark(mark_memory)\n    0\n  } else {\n    // ADR-0055 #493 cutover toggle: VIBE_RC=1 compiles on the Perceus RC codegen\n    // path (Env::get returns \"\" when unset, so default stays the bump path). Lets\n    // the selfbuild/bootstrap/e2e gates exercise the whole compiler under RC.\n    handle {\n      let rc_flag = Env::get(\"VIBE_RC\")\n      // #cfg: activate compile-time flags from VIBE_CFG (see apply_cfg_env).\n      let source_cfg = apply_cfg_env(source, Env::get(\"VIBE_CFG\"))\n      // #cov: function-level coverage build (same source pipeline, instrumented\n      // codegen). Running the produced wasm records which compiler functions ran.\n      let bytes = if Env::get(\"VIBE_COVERAGE\") == \"1\" {\n        compile_source_wasi_only_coverage(source_cfg, entry_name)\n      } else if Env::get(\"VIBE_BACKEND\") == \"gc\" {\n        // wasm-gc backend lane (parity checks / #415). Direct source compile\n        // only; FS-import mode and the special instrumentation modes stay\n        // linear-backend-only.\n        compile_source_gc_only(source_cfg, entry_name)\n      } else {\n        compile_source_for_rc_flag(source_cfg, entry_name, rc_flag)\n      }\n      profile_memory_mark(mark_memory)\n      Fs::write_bytes(output_path, bytes)\n      profile_memory_mark(mark_memory)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n}\n")
}

