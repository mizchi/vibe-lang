let cli_adapter_source_68 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/header_type_sections.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# Functions\n\nexport fn emit_func_type(buf: Bytes, param_count: Int, result_count: Int) -> Unit {\n  bytebuf_push(buf, 96)\n  leb128_encode_u32(buf, param_count)\n  let mut i = 0\n  while i < param_count {\n    bytebuf_push(buf, 126)\n    i = i + 1\n  }\n  leb128_encode_u32(buf, result_count)\n  let mut j = 0\n  while j < result_count {\n    bytebuf_push(buf, 126)\n    j = j + 1\n  }\n}\n\nexport fn emit_type_section_multi(out: Bytes, type_defs: Array[Int]) -> Unit {\n  let count = Array::length(type_defs) / 2\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    emit_func_type(content, Array::get(type_defs, i * 2), Array::get(type_defs, (i * 2) + 1))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 1, content)\n}\n\nexport fn emit_type_section(out: Bytes, param_count: Int, result_count: Int) -> Unit {\n  let type_defs = array_empty()\n  Array::push(type_defs, param_count)\n  Array::push(type_defs, result_count)\n  emit_type_section_multi(out, type_defs)\n}\n")
}

let cli_adapter_source_69 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/header_exports.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_string, bytebuf_push_vec_header, leb128_encode_u32\n}\n\n//# Functions\n\nexport fn emit_name(buf: Bytes, name: String) -> Unit {\n  bytebuf_push_string(buf, name)\n}\n\nexport fn emit_function_section(out: Bytes, type_indices: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(type_indices))\n  let mut i = 0\n  while i < Array::length(type_indices) {\n    leb128_encode_u32(content, Array::get(type_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 3, content)\n}\n\nexport fn emit_export_section_multi(out: Bytes, names: Array[String], func_indices: Array[Int]) -> Unit {\n  let count = Array::length(names)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    emit_name(content, Array::get(names, i))\n    bytebuf_push(content, 0)\n    leb128_encode_u32(content, Array::get(func_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, 7, content)\n}\n\nexport fn emit_export_section(out: Bytes, name: String, func_idx: Int) -> Unit {\n  emit_export_section_multi(out, [\n    name\n  ], [\n    func_idx\n  ])\n}\n")
}

let cli_adapter_source_70 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/code_helpers.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_buf,\n  bytebuf_push_opcode_s64,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  leb128_encode_u32\n}\n\n//# Functions\n\nexport fn emit_end(buf: Bytes) -> Unit {\n  bytebuf_push(buf, 11)\n}\n\nexport fn emit_i32_const(buf: Bytes, value: Int) -> Unit {\n  bytebuf_push_opcode_s64(buf, 65, value)\n}\n\nexport fn emit_code_section(out: Bytes, bodies: Array[Bytes]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(bodies))\n  let mut i = 0\n  while i < Array::length(bodies) {\n    let body = Array::get(bodies, i)\n    let func_buf = bytebuf_new()\n    leb128_encode_u32(func_buf, 0)\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_buf(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 10, content)\n}\n\nexport fn emit_memory_section(out: Bytes, min_pages: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, min_pages)\n  bytebuf_push_section(out, 5, content)\n}\n\nexport fn emit_code_section_with_locals(out: Bytes, bodies: Array[Bytes], local_counts: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(bodies))\n  let mut i = 0\n  while i < Array::length(bodies) {\n    let body = Array::get(bodies, i)\n    let num_locals = Array::get(local_counts, i)\n    let func_buf = bytebuf_new()\n    if num_locals == 0 {\n      leb128_encode_u32(func_buf, 0)\n    } else {\n      leb128_encode_u32(func_buf, 1)\n      leb128_encode_u32(func_buf, num_locals)\n      bytebuf_push(func_buf, 126)\n    }\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_buf(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 10, content)\n}\n")
}

let cli_adapter_source_71 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/wasm_emit/extra.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push2,\n  bytebuf_push_buf,\n  bytebuf_push_opcode_u32,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  leb128_encode_u32\n}\n\nimport ./base.vibe {\n  emit_end, emit_i32_const, emit_name\n}\n\n//# Functions\n\nlet vt_i32 = 127\n\nlet sec_data = 11\n\nlet type_func = 96\n\nlet sec_export = 7\n\nlet sec_global = 6\n\nlet sec_import = 2\n\nlet export_func = 0\n\nlet export_memory = 2\n\nlet op_global_get = 35\n\nlet op_global_set = 36\n\nlet op_i32_add = 106\n\nlet op_i32_sub = 107\n\nlet op_i32_shr_u = 118\n\nlet op_i32_gt_u = 75\n\nlet op_memory_size = 63\n\nlet op_memory_grow = 64\n\nlet op_drop = 26\n\nlet op_select = 27\n\nlet op_i32_eq = 70\n\nlet op_if = 4\n\nlet bt_void = 64\n\nexport fn emit_global_get(buf: Bytes, idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_global_get, idx)\n}\n\n/// pushes `needed_pages - memory_size` (the exact page deficit) on the stack.\nfn emit_heap_page_deficit(buf: Bytes) -> Unit {\n  emit_global_get(buf, 0)\n  emit_i32_const(buf, 65536)\n  bytebuf_push(buf, op_i32_add)\n  emit_i32_const(buf, 16)\n  bytebuf_push(buf, op_i32_shr_u)\n  bytebuf_push2(buf, op_memory_size, 0)\n  bytebuf_push(buf, op_i32_sub)\n}\n\n/// pushes `memory_size / 2` on the stack.\nfn emit_heap_half_current(buf: Bytes) -> Unit {\n  bytebuf_push2(buf, op_memory_size, 0)\n  emit_i32_const(buf, 1)\n  bytebuf_push(buf, op_i32_shr_u)\n}\n\nexport fn emit_heap_memory_grow_check(buf: Bytes) -> Unit {\n  // Grow memory when `(heap_ptr + 65536) >> 16` pages exceed `memory_size` —\n  // i.e. ALWAYS keep at least one page past `heap_ptr`. The `+ 65536` (not\n  // `+ 65535`) reserves a guard page so `heap_ptr` itself (the next slot the\n  // bump allocator hands out) is always addressable even when it lands\n  // exactly on a page boundary. Monotonic: never grows LESS than before.\n  //\n  // Growth POLICY (2026-07 perf): grow by `max(deficit, memory_size / 2)`\n  // instead of the exact deficit. The exact-deficit policy grew a large\n  // compile's heap in thousands of 1-2 page steps; on the node host every\n  // `memory.grow` invalidates the cached typed-array views and stampedes\n  // V8's external-memory GC accounting — profiling the selfcompile KPI\n  // showed 38% of CPU inside V8's GC and pre-growing the memory up front\n  // halved wall time (14.1s -> 6.4s). Exponential growth caps the number of\n  // grows at O(log heap) with at most 50% address-space overshoot; untouched\n  // tail pages are never written by the bump allocator, so RSS barely moves.\n  // If the 1.5x request fails (memory.grow == -1: the module declares no\n  // max, so only near the wasm32 4GB ceiling), RETRY with the exact deficit\n  // — the old policy's request — so a large-but-satisfiable allocation near\n  // the ceiling still succeeds exactly as before.\n  emit_global_get(buf, 0)\n  emit_i32_const(buf, 65536)\n  bytebuf_push(buf, op_i32_add)\n  emit_i32_const(buf, 16)\n  bytebuf_push(buf, op_i32_shr_u)\n  bytebuf_push2(buf, op_memory_size, 0)\n  bytebuf_push(buf, op_i32_gt_u)\n  bytebuf_push2(buf, op_if, bt_void)\n  // grow_by = max(deficit, memory_size/2)  (select re-derives both operands:\n  // this body has no locals, and it runs O(log heap) times, so the few extra\n  // instructions are irrelevant)\n  emit_heap_page_deficit(buf)\n  emit_heap_half_current(buf)\n  emit_heap_page_deficit(buf)\n  emit_heap_half_current(buf)\n  bytebuf_push(buf, op_i32_gt_u)\n  bytebuf_push(buf, op_select)\n  bytebuf_push2(buf, op_memory_grow, 0)\n  // -1 = the oversized request failed; retry with the exact deficit.\n  emit_i32_const(buf, -1)\n  bytebuf_push(buf, op_i32_eq)\n  bytebuf_push2(buf, op_if, bt_void)\n  emit_heap_page_deficit(buf)\n  bytebuf_push2(buf, op_memory_grow, 0)\n  bytebuf_push(buf, op_drop)\n  emit_end(buf)\n  emit_end(buf)\n}\n\nexport fn emit_global_set(buf: Bytes, idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_global_set, idx)\n}\n\nexport fn emit_data_section(out: Bytes, offset: Int, data: Bytes) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push(content, 0)\n  emit_i32_const(content, offset)\n  emit_end(content)\n  leb128_encode_u32(content, Bytes::length(data))\n  bytebuf_push_buf(content, data)\n  bytebuf_push_section(out, sec_data, content)\n}\n\nexport fn emit_exports_full(out: Bytes, fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int, global_names: Array[String], global_indices: Array[Int]) -> Unit {\n  let count = Array::length(fn_names) + 1 + Array::length(global_names)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < Array::length(fn_names) {\n    emit_name(content, Array::get(fn_names, i))\n    bytebuf_push(content, export_func)\n    leb128_encode_u32(content, Array::get(fn_indices, i))\n    i = i + 1\n  }\n  emit_name(content, mem_name)\n  bytebuf_push(content, export_memory)\n  leb128_encode_u32(content, mem_idx)\n  let mut gi = 0\n  while gi < Array::length(global_names) {\n    emit_name(content, Array::get(global_names, gi))\n    bytebuf_push(content, 3)\n    leb128_encode_u32(content, Array::get(global_indices, gi))\n    gi = gi + 1\n  }\n  bytebuf_push_section(out, sec_export, content)\n}\n\nexport fn emit_export_memory(out: Bytes, name: String, mem_idx: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  emit_name(content, name)\n  bytebuf_push(content, export_memory)\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, sec_export, content)\n}\n\nexport fn emit_func_type_raw(buf: Bytes, param_types: Array[Int], result_types: Array[Int]) -> Unit {\n  bytebuf_push(buf, type_func)\n  leb128_encode_u32(buf, Array::length(param_types))\n  let mut i = 0\n  while i < Array::length(param_types) {\n    bytebuf_push(buf, Array::get(param_types, i))\n    i = i + 1\n  }\n  leb128_encode_u32(buf, Array::length(result_types))\n  let mut j = 0\n  while j < Array::length(result_types) {\n    bytebuf_push(buf, Array::get(result_types, j))\n    j = j + 1\n  }\n}\n\nexport fn emit_exports_with_memory(out: Bytes, fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int) -> Unit {\n  let count = Array::length(fn_names) + 1\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < Array::length(fn_names) {\n    emit_name(content, Array::get(fn_names, i))\n    bytebuf_push(content, export_func)\n    leb128_encode_u32(content, Array::get(fn_indices, i))\n    i = i + 1\n  }\n  emit_name(content, mem_name)\n  bytebuf_push(content, export_memory)\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, sec_export, content)\n}\n\nexport fn emit_import_section_func(out: Bytes, module_name: String, field_name: String, type_idx: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  emit_name(content, module_name)\n  emit_name(content, field_name)\n  bytebuf_push(content, export_func)\n  leb128_encode_u32(content, type_idx)\n  bytebuf_push_section(out, sec_import, content)\n}\n\nexport fn emit_global_section_i32_mut(out: Bytes, init_value: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push2(content, vt_i32, 1)\n  emit_i32_const(content, init_value)\n  emit_end(content)\n  bytebuf_push_section(out, sec_global, content)\n}\n")
}

