n        emit_local_get(buf, i_l)\n        emit_i64_const(buf, 1)\n        emit_i64_add(buf)\n        emit_local_set(buf, i_l)\n        emit_br(buf, 0)\n        emit_end(buf)\n        emit_end(buf)\n        emit_local_get(buf, res_l)\n        nl + 4\n      }\n      else if fname == \"StringBuilder::new\" {\n        // #538: same lowering as the linear backend -- a StringBuilder IS an\n        // Array[String]; freeze joins with \"\".\n        let (arr_new_idx2, _, _) = resolve_func(ctx.func_table, \"array_new\")\n        emit_call_resolved(buf, ctx, arr_new_idx2)\n        next_local\n      }\n      else if fname == \"StringBuilder::push\" {\n        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        let (arr_push_idx2, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n        emit_call_resolved(buf, ctx, arr_push_idx2)\n        emit_i64_const(buf, 0)\n        nl\n      }\n      else if fname == \"StringBuilder::freeze\" {\n        let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)\n        let empty_idx = str_table_lookup(ctx.str_table.strs, \"\")\n        emit_str_ref(buf, Array::get(ctx.str_table.offsets, empty_idx), Array::get(ctx.str_table.lengths, empty_idx))\n        let (join_idx, _, _) = resolve_func(ctx.func_table, \"String::join\")\n        emit_call_resolved(buf, ctx, join_idx)\n        nl\n      }\n      else if fname == \"print\" || fname == \"println\" {\n        // print(x) = print_str(__to_string(x)); println appends \"\\n\".\n        let ts_idx = gc_resolve_builtin_last(ctx.func_table, \"__to_string\")\n        let (ps_idx, _, _) = resolve_func(ctx.func_table, \"print_str\")\n        let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)\n        emit_call_resolved(buf, ctx, ts_idx)\n        if fname == \"println\" {\n          let nl_idx = str_table_lookup(ctx.str_table.strs, \"\\n\")\n          emit_str_ref(buf, Array::get(ctx.str_table.offsets, nl_idx), Array::get(ctx.str_table.lengths, nl_idx))\n          let (cat_idx, _, _) = resolve_func(ctx.func_table, \"String::concat\")\n          emit_call_resolved(buf, ctx, cat_idx)\n        } else {\n          ()\n        }\n        emit_call_resolved(buf, ctx, ps_idx)\n        emit_i64_const(buf, 0)\n        nl\n      }\n      else if fname == \"assert\" || fname == \"assert_true\" {\n        // Trap (unreachable) on a false condition, like the linear backend.\n        let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)\n        emit_i64_eqz(buf)\n        emit_if_void(buf)\n        bytebuf_push(buf, 0)\n        emit_end(buf)\n        emit_i64_const(buf, 0)\n        nl\n      }\n      else if fname == \"assert_eq\" {\n        let (eq_idx2, _, _) = resolve_func(ctx.func_table, \"eq\")\n        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        emit_call_resolved(buf, ctx, eq_idx2)\n        emit_i64_eqz(buf)\n        emit_if_void(buf)\n        bytebuf_push(buf, 0)\n        emit_end(buf)\n        emit_i64_const(buf, 0)\n        nl\n      }\n      else if fname == \"FixedArray::make\" || fname == \"Int64Array::make\" {\n        // FixedArray rides on the gc array: make(n, init) = n pushes of init.\n        // #835: Int64Array::* is the same alias (Array already stores full\n        // tagged Int elements — no separate i64-cell layout needed).\n        let (fa_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n        let (fa_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        let fam_n = nl\n        let fam_init = nl + 1\n        let fam_arr = nl + 2\n        let fam_i = nl + 3\n        Array::push(local_names, \"__fam_n\")\n        Array::push(local_names, \"__fam_init\")\n        Array::push(local_names, \"__fam_arr\")\n        Array::push(local_names, \"__fam_i\")\n        emit_local_set(buf, fam_init)\n        emit_local_set(buf, fam_n)\n        emit_call_resolved(buf, ctx, fa_new_idx)\n        emit_local_set(buf, fam_arr)\n        emit_i64_const(buf, 0)\n        emit_local_set(buf, fam_i)\n        emit_block_void(buf)\n        emit_loop_void(buf)\n        emit_local_get(buf, fam_i)\n        emit_local_get(buf, fam_n)\n        emit_i64_ge_s(buf)\n        emit_br_if(buf, 1)\n        emit_local_get(buf, fam_arr)\n        emit_local_get(buf, fam_init)\n        emit_call_resolved(buf, ctx, fa_push_idx)\n        emit_local_get(buf, fam_i)\n        emit_i64_const(buf, 1)\n        emit_i64_add(buf)\n        emit_local_set(buf, fam_i)\n        emit_br(buf, 0)\n        emit_end(buf)\n        emit_end(buf)\n        emit_local_get(buf, fam_arr)\n        nl + 4\n      }\n      else if fname == \"FixedArray::length\" || fname == \"Int64Array::length\" {\n        let (fa_len_idx, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n        let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)\n        emit_call_resolved(buf, ctx, fa_len_idx)\n        nl\n      }\n      else if fname == \"FixedArray::get\" || fname == \"Int64Array::get\" {\n        let (fa_get_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        emit_call_resolved(buf, ctx, fa_get_idx)\n        nl\n      }\n      else if fname == \"FixedArray::set\" || fname == \"FixedArray::unsafe_set\" || fname == \"Int64Array::set\" {\n        let (fa_set_idx, _, _) = resolve_func(ctx.func_table, \"Array::set\")\n        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\n        emit_call_resolved(buf, ctx, fa_set_idx)\n        emit_i64_const(buf, 0)\n        nl\n      }\n      else if fname == \"FixedArray::blit\" {\n        // blit(dst, dst_off, src, src_off, len): element-by-element copy.\n        let (fb_get_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n        let (fb_set_idx, _, _) = resolve_func(ctx.func_table, \"Array::set\")\n        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\n        nl = ce(buf, Array::get(args, 3), local_names, nl, ld)\n        nl = ce(buf, Array::get(args, 4), local_names, nl, ld)\n        let fb_dst = nl\n        let fb_doff = nl + 1\n        let fb_src = nl + 2\n        let fb_soff = nl + 3\n        let fb_len = nl + 4\n        let fb_i = nl + 5\n        Array::push(local_names, \"__fb_dst\")\n        Array::push(local_names, \"__fb_doff\")\n        Array::push(local_names, \"__fb_src\")\n        Array::push(local_names, \"__fb_soff\")\n        Array::push(local_names, \"__fb_len\")\n        Array::push(local_names, \"__fb_i\")\n        emit_local_set(buf, fb_len)\n        emit_local_set(buf, fb_soff)\n        emit_local_set(buf, fb_src)\n        emit_local_set(buf, fb_doff)\n        emit_local_set(buf, fb_dst)\n        emit_i64_const(buf, 0)\n        emit_local_set(buf, fb_i)\n        emit_block_void(buf)\n        emit_loop_void(buf)\n        emit_local_get(buf, fb_i)\n        emit_local_get(buf, fb_len)\n        emit_i64_ge_s(buf)\n        emit_br_if(buf, 1)\n        emit_local_get(buf, fb_dst)\n        emit_local_get(buf, fb_doff)\n        emit_local_get(buf, fb_i)\n        emit_i64_add(buf)\n        emit_local_get(buf, fb_src)\n        emit_local_get(buf, fb_soff)\n        emit_local_get(buf, fb_i)\n        emit_i64_add(buf)\n        emit_call_resolved(buf, ctx, fb_get_idx)\n        emit_call_resolved(buf, ctx, fb_set_idx)\n        emit_local_get(buf, fb_i)\n        emit_i64_const(buf, 1)\n        emit_i64_add(buf)\n        emit_local_set(buf, fb_i)\n        emit_br(buf, 0)\n        emit_end(buf)\n        emit_end(buf)\n        emit_i64_const(buf, 0)\n        nl + 6\n      }\n      else if fname == \"v128_load\" || fname == \"v128_store\" || fname == \"v128_splat_i8x16\" || fname == \"v128_eq_i8x16\" || fname == \"v128_le_u_i8x16\" || fname == \"v128_ge_u_i8x16\" || fname == \"v128_and\" || fname == \"v128_or\" || fname == \"v128_not\" || fname == \"v128_bitmask_i8x16\" || fname == \"v128_any_true\" || fname == \"v128_all_true_i8x16\" {\n        // #536: V128 SIMD intrinsics are implemented only on the non-RC linear\n        // backend. Fail loudly here rather than silently miscompiling.\n        throw(String::concat(\"v128 intrinsics: \", String::concat(fname, \" unsupported on gc backend\")))\n      }\n      else {\n        let fn_len2 = Array::length(ctx.func_table.names)\n        let mut fn_idx_in_list = -1\n        let mut __fi = 0\n        while __fi < fn_len2 {\n          if Array::get(ctx.func_table.names, __fi) == fname {\n            fn_idx_in_list = __fi\n            __fi = fn_len2\n          } else {\n            __fi = __fi + 1\n          }\n        }\n        if fn_idx_in_list >= 0 {\n          let fidx = Array::get(ctx.func_table.indices, fn_idx_in_list)\n          let has_ret = Array::get(ctx.func_table.returns, fn_idx_in_list)\n          let mut nl = next_local\n          let mut ci = 0\n          while ci < Array::length(args) {\n            nl = ce(buf, Array::get(args, ci), local_names, nl, ld)\n            ci = ci + 1\n          }\n          if ctx.func_offset > 0 {\n            if fidx >= ctx.func_offset {\n              emit_i64_const(buf, 0)\n            }\n          }\n          emit_call(buf, fidx)\n          if has_ret == 0 {\n            emit_i64_const(buf, 0)\n          }\n          nl\n        } else {\n          // An uppercase-initial callee that missed the ctor table is an\n          // unknown constructor, not a local closure -- fail with a clear\n          // message instead of resolve_local's \"undefined variable\".\n          let c0 = String::char_code_at(fname, 0)\n          if c0 >= 65 && c0 <= 90 {\n            throw(\"GC codegen: unknown constructor or function: \\{fname}\")\n          }\n          let local_idx2 = resolve_local(local_names, fname, \"gc_call\")\n          let num_args = Array::length(args)\n          let fn_val_local = next_local\n          let slot_local = next_local + 1\n          let env_local = next_local + 2\n          let mut nl = next_local + 3\n          Array::push(local_names, \"__fn_val\")\n          Array::push(local_names, \"__slot\")\n          Array::push(local_names, \"__env\")\n          emit_local_get(buf, local_idx2)\n          emit_local_set(buf, fn_val_local)\n          emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n          let mut ci = 0\n          while ci < num_args {\n            nl = ce(buf, Array::get(args, ci), local_names, nl, ld)\n            ci = ci + 1\n          }\n          emit_closure_call_tail(buf, env_local, slot_local, ctx.closure_type_base, num_args)\n          nl\n        }\n      }\n    },\n    _ => {\n      let num_args = Array::length(args)\n      let fn_val_local = next_local\n      let slot_local = next_local + 1\n      let env_local = next_local + 2\n      let mut nl = next_local + 3\n      Array::push(local_names, \"__fn_val\")\n      Array::push(local_names, \"__slot\")\n      Array::push(local_names, \"__env\")\n      nl = ce(buf, callee, local_names, nl, ld)\n      emit_local_set(buf, fn_val_local)\n      emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n      let mut ci = 0\n      while ci < num_args {\n        nl = ce(buf, Array::get(args, ci), local_names, nl, ld)\n        ci = ci + 1\n      }\n      emit_closure_call_tail(buf, env_local, slot_local, ctx.closure_type_base, num_args)\n      nl\n    }\n  }\n}\n\n//# Misc\n\nexport {\n  compile_call_gc\n}\n")
}

let cli_adapter_source_144 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_match.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtxGc, CtorTable, FuncTable, LambdaTable, StrTable, agg_log_reset_above, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, find_func_stmt, gc_slot_log_reset_above, ctor_table_index_of, resolve_func, resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_const_lohi, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./backend_builtins_array_alloc.vibe {\n  gc_gen_arr_len_body, gc_gen_arr_new_body\n}\n\nimport ./backend_builtins_array_get.vibe {\n  gc_gen_arr_get_body\n}\n\nimport ./backend_builtins_array_push.vibe {\n  gc_gen_arr_push_body\n}\n\nimport ./backend_builtins_array_set.vibe {\n  gc_gen_arr_set_body\n}\n\nimport ./backend_builtins_numeric.vibe {\n  gc_gen_double_to_int_body, gc_gen_identity_body, gc_gen_int_to_double_body\n}\n\nimport ./backend_builtins_print.vibe {\n  gc_gen_print_i64_body, gc_gen_print_str_body\n}\n\nimport ./backend_builtins_string.vibe {\n  gc_gen_str_concat_body, gc_gen_str_eq_body, gc_gen_str_len_body\n}\n\nimport ./backend_builtins_string_extra.vibe {\n  gc_gen_str_char_code_at_body, gc_gen_str_from_char_code_body, gc_gen_str_substring_body\n}\n\n//# Functions\n\n// The storage index of struct field `field`, mirroring the field-access lookup\n// in backend_expr (search the struct-field-name matrix; first struct that\n// declares the field wins). A struct lays its fields out like a constructor —\n// field i at `8 + i*8`, pointer tag-cleared — so the offset is `8 + index*8`,\n// identical to what `obj.field` reads.\nfn field_index_in_gc(fnames: Array[String], field: String) -> Int {\n  let mut fi = 0\n  let mut found = -1\n  while fi < Array::length(fnames) {\n    if Array::get(fnames, fi) == field {\n      found = fi\n      fi = Array::length(fnames)\n    } else {\n      fi = fi + 1\n    }\n  }\n  found\n}\n\n// The index of `field` WITHIN the struct named `sname`. The matched struct name\n// MUST drive the lookup: two structs can share a field name at different\n// positions (`A { x; y }` vs `B { y; x }`), so a name-agnostic scan binds the\n// wrong offset. Falls back to a global first-match scan only when `sname` is\n// absent from the table.\nfn struct_field_index_gc(ctx: CompileCtxGc, sname: String, field: String) -> Int with { Error } {\n  let names = ctx.gc_ctor_table.struct_names\n  let mut si = 0\n  let mut sidx = -1\n  while si < Array::length(names) {\n    if Array::get(names, si) == sname {\n      sidx = si\n      si = Array::length(names)\n    } else {\n      si = si + 1\n    }\n  }\n  if sidx >= 0 {\n    let found = field_index_in_gc(Array::get(ctx.gc_ctor_table.struct_field_names, sidx), field)\n    if found < 0 {\n      throw(String::concat(String::concat(String::concat(\"unknown field `\", field), \"` in struct \"), sname))\n    } else {\n      found\n    }\n  } else {\n    let mut gsi = 0\n    let mut gfound = -1\n    while gsi < Array::length(names) {\n      let f = field_index_in_gc(Array::get(ctx.gc_ctor_table.struct_field_names, gsi), field)\n      if f >= 0 {\n        gfound = f\n        gsi = Array::length(names)\n      } else {\n        gsi = gsi + 1\n      }\n    }\n    if gfound < 0 {\n      throw(String::concat(\"unknown struct field in pattern: \", field))\n    } else {\n      gfound\n    }\n  }\n}\n\n\n// #538 recursive pattern support. The old cond-arm compiler tested only the\n// TOP-LEVEL tag and bound only top-level PBind args: a nested ctor pattern\n// (`Node(Leaf(a), r)`) neither narrowed the match (wrong arm taken) nor bound\n// its variables (\"undefined variable: a\"). The helpers below mirror the\n// linear backend's #705 short-circuit shape: a test leaves exactly one i32 on\n// the stack, nested payload tests run INSIDE `if (result i32)` blocks guarded\n// by the parent tag test, and binds recurse through fresh temp locals.\n\n// Does `pat` constrain the value at all (vs matching anything)?\nfn gc_pat_needs_test(p: Pat) -> Bool {\n  match p {\n    PBind(_) => false,\n    PWild => false,\n    PTuple(ps) => {\n      let mut any = false\n      let mut i = 0\n      while i < Array::length(ps) {\n        if gc_pat_needs_test(Array::get(ps, i)) {\n          any = true\n        }\n        i = i + 1\n      }\n      any\n    },\n    PStruct(_, fields) => {\n      let mut any = false\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, sub) = Array::get(fields, i)\n        if gc_pat_needs_test(sub) {\n          any = true\n        }\n        i = i + 1\n      }\n      any\n    },\n    _ => true\n  }\n}\n\n// Does `pat` bind any variables?\nfn gc_pat_has_binds(p: Pat) -> Bool {\n  match p {\n    PBind(_) => true,\n    PCtor(_, args) => {\n      let mut any = false\n      let mut i = 0\n      while i < Array::length(args) {\n        if gc_pat_has_binds(Array::get(args, i)) {\n          any = true\n        }\n        i = i + 1\n      }\n      any\n    },\n    PTuple(ps) => {\n      let mut any = false\n      let mut i = 0\n      while i < Array::length(ps) {\n        if gc_pat_has_binds(Array::get(ps, i)) {\n          any = true\n        }\n        i = i + 1\n      }\n      any\n    },\n    PStruct(_, fields) => {\n      let mut any = false\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, sub) = Array::get(fields, i)\n        if gc_pat_has_binds(sub) {\n          any = true\n        }\n        i = i + 1\n      }\n      any\n    },\n    POr(l, r) => gc_pat_has_binds(l) || gc_pat_has_binds(r),\n    _ => false\n  }\n}\n\n// Load ctor payload `idx` of the tagged ctor value in `vloc` into a fresh\n// local (ctor layout: value|1 -> [tag@0][argc@4][payload@8+i*8]).\nfn gc_extract_ctor_payload(buf: Bytes, local_names: Array[String], vloc: Int, idx: Int) -> Int {\n  let tl = Array::length(local_names)\n  emit_local_get(buf, vloc)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 3, 8 + idx * 8)\n  emit_local_set(buf, tl)\n  Array::push(local_names, \"__pat_tmp\")\n  tl\n}\n\n// Load tuple element `idx` of the untagged tuple pointer in `vloc` (tuple\n// layout: raw even pointer, elements at i*8, no header).\nfn gc_extract_tuple_elem(buf: Bytes, local_names: Array[String], vloc: Int, idx: Int) -> Int {\n  let tl = Array::length(local_names)\n  emit_local_get(buf, vloc)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 3, idx * 8)\n  emit_local_set(buf, tl)\n  Array::push(local_names, \"__pat_tmp\")\n  tl\n}\n\n// Emit the truth test for `pat` against the value in `vloc`: pushes exactly\n// one i32 (1 = matched). Sub-tests short-circuit behind the parent test via\n// `if (result i32)` (bytes 4, 127) so payload loads never run on a value of\n// the wrong shape.\nfn emit_gc_pat_test(buf: Bytes, local_names: Array[String], vloc: Int, pat: Pat, ctx: CompileCtxGc) -> Unit with { Error } {\n  match pat {\n    PInt(n) => {\n      emit_local_get(buf, vloc)\n      emit_i64_const(buf, n)\n      emit_i64_eq(buf)\n    },\n    PFloat(fv) => {\n      // gc lane holds raw f64 bits in i64 locals; f64.eq gives `==` semantics.\n      emit_local_get(buf, vloc)\n      emit_f64_reinterpret_i64(buf)\n      emit_f64_const_lohi(buf, Double::to_i64_bits_lo(fv), Double::to_i64_bits_hi(fv))\n      emit_f64_eq(buf)\n    },\n    PBool(bv) => {\n      emit_local_get(buf, vloc)\n      emit_i64_const(buf, if bv {\n        1\n      } else {\n        0\n      })\n      emit_i64_eq(buf)\n    },\n    PString(sval) => {\n      let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n      if str_idx >= 0 {\n        let (streq_idx, _, _) = resolve_func(ctx.func_table, \"String::equals\")\n        emit_local_get(buf, vloc)\n        emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\n        // A user-shadowed String::equals would need a trailing env; the\n        // builtin does not (idx < func_offset).\n        if ctx.func_offset > 0 && streq_idx >= ctx.func_offset {\n          emit_i64_const(buf, 0)\n        } else {\n          ()\n        }\n        emit_call(buf, streq_idx)\n        emit_i64_const(buf, 1)\n        emit_i64_eq(buf)\n      } else {\n        emit_i32_const(buf, 0)\n      }\n    },\n    PBind(_) => emit_i32_const(buf, 1),\n    PWild => emit_i32_const(buf, 1),\n    POr(l, r) => {\n      emit_gc_pat_test(buf, local_names, vloc, l, ctx)\n      bytebuf_push(buf, 4)\n      bytebuf_push(buf, 127)\n      emit_i32_const(buf, 1)\n      emit_else(buf)\n      emit_gc_pat_test(buf, local_names, vloc, r, ctx)\n      emit_end(buf)\n    },\n    PCtor(cname, cargs) => {\n      let ctor_ci = ctor_table_index_of(ctx.gc_ctor_table, cname)\n      let expected_tag = if ctor_ci >= 0 {\n        Array::get(ctx.gc_ctor_table.tags, ctor_ci)\n      } else {\n        -1\n      }\n      emit_local_get(buf, vloc)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i32_load(buf, 2, 0)\n      emit_i32_const(buf, expected_tag)\n      emit_i32_eq(buf)\n      let mut any_sub = false\n      let mut ci = 0\n      while ci < Array::length(cargs) {\n        if gc_pat_needs_test(Array::get(cargs, ci)) {\n          any_sub = true\n        }\n        ci = ci + 1\n      }\n      if any_sub {\n        bytebuf_push(buf, 4)\n        bytebuf_push(buf, 127)\n        emit_i32_const(buf, 1)\n        let mut si = 0\n        while si < Array::length(cargs) {\n          let sub = Array::get(cargs, si)\n          if gc_pat_needs_test(sub) {\n            bytebuf_push(buf, 4)\n            bytebuf_push(buf, 127)\n            let tl = gc_extract_ctor_payload(buf, local_names, vloc, si)\n            emit_gc_pat_test(buf, local_names, tl, sub, ctx)\n            emit_else(buf)\n            emit_i32_const(buf, 0)\n            emit_end(buf)\n          } else {\n            ()\n          }\n          si = si + 1\n        }\n        emit_else(buf)\n        emit_i32_const(buf, 0)\n        emit_end(buf)\n      } else {\n        ()\n      }\n    },\n    PTuple(ps) => {\n      emit_i32_const(buf, 1)\n      let mut ti = 0\n      while ti < Array::length(ps) {\n        let sub = Array::get(ps, ti)\n        if gc_pat_needs_test(sub) {\n          bytebuf_push(buf, 4)\n          bytebuf_push(buf, 127)\n          let tl = gc_extract_tuple_elem(buf, local_names, vloc, ti)\n          emit_gc_pat_test(buf, local_names, tl, sub, ctx)\n          emit_else(buf)\n          emit_i32_const(buf, 0)\n          emit_end(buf)\n        } else {\n          ()\n        }\n        ti = ti + 1\n      }\n    },\n    PStruct(sname, fields) => {\n      emit_i32_const(buf, 1)\n      let mut fi = 0\n      while fi < Array::length(fields) {\n        let (fname, sub) = Array::get(fields, fi)\n        if gc_pat_needs_test(sub) {\n          bytebuf_push(buf, 4)\n          bytebuf_push(buf, 127)\n          let off_idx = struct_field_index_gc(ctx, sname, fname)\n          let tl = gc_extract_ctor_payload(buf, local_names, vloc, off_idx)\n          emit_gc_pat_test(buf, local_names, tl, sub, ctx)\n          emit_else(buf)\n          emit_i32_const(buf, 0)\n          emit_end(buf)\n        } else {\n          ()\n        }\n        fi = fi + 1\n      }\n    }\n  }\n}\n\n// Bind every variable under `pat` from the value in `vloc` (recursing through\n// payload extraction). Or-patterns that bind are rejected: the two sides may\n// bind from different shapes and this backend has no phi for that yet.\nfn emit_gc_pat_binds(buf: Bytes, local_names: Array[String], vloc: Int, pat: Pat, ctx: CompileCtxGc) -> Unit with { Error } {\n  match pat {\n    PBind(name) => {\n      let bl = Array::length(local_names)\n      emit_local_get(buf, vloc)\n      emit_local_set(buf, bl)\n      Array::push(local_names, name)\n    },\n    PCtor(_, cargs) => {\n      let mut i = 0\n      while i < Array::length(cargs) {\n        let sub = Array::get(cargs, i)\n        if gc_pat_has_binds(sub) {\n          let tl = gc_extract_ctor_payload(buf, local_names, vloc, i)\n          emit_gc_pat_binds(buf, local_names, tl, sub, ctx)\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n    },\n    PTuple(ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        let sub = Array::get(ps, i)\n        if gc_pat_has_binds(sub) {\n          let tl = gc_extract_tuple_elem(buf, local_names, vloc, i)\n          emit_gc_pat_binds(buf, local_names, tl, sub, ctx)\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n    },\n    PStruct(sname, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, sub) = Array::get(fields, i)\n        if gc_pat_has_binds(sub) {\n          let off_idx = struct_field_index_gc(ctx, sname, fname)\n          let tl = gc_extract_ctor_payload(buf, local_names, vloc, off_idx)\n          emit_gc_pat_binds(buf, local_names, tl, sub, ctx)\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n    },\n    POr(l, r) => {\n      if gc_pat_has_binds(l) || gc_pat_has_binds(r) {\n        throw(\"GC codegen: or-pattern with variable binds is unsupported\")\n      } else {\n        ()\n      }\n    },\n    _ => ()\n  }\n}\n\nfn compile_match_gc(buf: Bytes, scrutinee: Expr, arms: Array[(Pat, Expr)], local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } {\n  let scrut_local = next_local\n  Array::push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, scrutinee, local_names, next_local + 1, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = Array::length(arms)\n  let catchall_idx = find_catchall_idx(arms)\n  let num_cond_arms = catchall_idx\n  let mut max_nl = nl1\n  let mut ai = 0\n  while ai < num_cond_arms {\n    let names_len_at_arm = Array::length(local_names)\n    let (p, arm_body) = Array::get(arms, ai)\n    let ld_arm = if ld >= 0 {\n      ld + ai + 1\n    } else {\n      -1\n    }\n    // Recursive test (nested payload sub-tests narrow the arm correctly)...\n    emit_gc_pat_test(buf, local_names, scrut_local, p, ctx)\n    emit_if_i64(buf)\n    // ...then recursive binds (nested PBinds included).\n    emit_gc_pat_binds(buf, local_names, scrut_local, p, ctx)\n    let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\n    if arm_nl > max_nl {\n      max_nl = arm_nl\n    }\n    if Array::length(local_names) > max_nl {\n      max_nl = Array::length(local_names)\n    }\n    emit_else(buf)\n    Array::truncate(local_names, names_len_at_arm)\n    agg_log_reset_above(ctx.gc_agg_local_slots, names_len_at_arm)\n    gc_slot_log_reset_above(ctx.gc_bool_locals, names_len_at_arm)\n    gc_slot_log_reset_above(ctx.gc_float_locals, names_len_at_arm)\n    ai = ai + 1\n  }\n  let ld_catch = if ld >= 0 {\n    ld + num_cond_arms\n  } else {\n    -1\n  }\n  let _names_len_at_catch = Array::length(local_names)\n  if catchall_idx < num_arms {\n    let (cp, cbody) = Array::get(arms, catchall_idx)\n    // Catch-all arm: recursive binds handle PBind / PCtor / PTuple / PStruct\n    // uniformly, including nested payload binds (and fix the old tuple-bind\n    // offset bug: tuples have no header, elements sit at i*8).\n    emit_gc_pat_binds(buf, local_names, scrut_local, cp, ctx)\n    let catch_nl = ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n    if catch_nl > max_nl {\n      max_nl = catch_nl\n    }\n    0\n  } else {\n    bytebuf_push(buf, 0)\n    0\n  }\n  let mut ci2 = 0\n  while ci2 < num_cond_arms {\n    emit_end(buf)\n    ci2 = ci2 + 1\n  }\n  while Array::length(local_names) < max_nl {\n    Array::push(local_names, \"\")\n  }\n  max_nl\n}\n\n//# Misc\n\nexport {\n  compile_match_gc\n}\n")
}

