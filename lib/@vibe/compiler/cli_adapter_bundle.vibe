"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_gt_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_rc_word_inc_saturating,\n  emit_str_ref,\n  expr_tag,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  is_efn,\n  is_eident,\n  is_etuple,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  lookup_ctor,\n  rc_shadow_base,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_heap_memory_grow_check,\n  emit_i32_add,\n  emit_i32_and,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_i8x16_bitmask,\n  emit_i8x16_eq,\n  emit_i8x16_le_u,\n  emit_i8x16_splat,\n  emit_i8x16_sub,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  emit_v128_load,\n  emit_v128_not,\n  emit_v128_or,\n  string_to_data\n}\n\n//# Functions\n\nexport fn gen_identity_body() -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  b\n}\n\nexport fn gen_arr_slice_body(enable_rc: Bool, rc_alloc_idx: Int, rc_shadow: Bool) -> Bytes {\n  let b = bytebuf_new()\n  // #982: slice had ZERO bounds checks — `Array::slice([1,2,3], 1, 10)`\n  // memory_copy'd 9 elements of raw adjacent heap into the result and\n  // `Array::slice(a, 2, 0)` computed a negative count that trapped inside the\n  // copy (while Bytes::slice is bounds-checked, #811 — non-uniform). Clamp\n  // start into [0, len] and end into [start', len] up front, so an\n  // out-of-range slice tolerantly truncates and an inverted range yields [].\n  // Scratch i64 local for len: RC reuses existing local 10 (elem, set later\n  // before its own use); non-RC adds local 9 (meta bumped 6/0 -> 6/1 at the\n  // linked_compile push_builtin site).\n  let len_local = if enable_rc {\n    10\n  } else {\n    9\n  }\n  // len = value[4] (i64, untagged element count)\n  emit_local_get(b, 0)\n  if enable_rc {\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n  } else {\n    ()\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)\n  emit_i64_extend_i32_u(b)\n  emit_local_set(b, len_local)\n  // param1 (start) := retag(clamp(untag(start), 0, len))\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_i64_const(b, 0)\n  emit_i64_lt_s(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 0)\n  emit_else(b)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_local_get(b, len_local)\n  emit_i64_gt_s(b)\n  emit_if_i64(b)\n  emit_local_get(b, len_local)\n  emit_else(b)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_end(b)\n  emit_end(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  } else {\n    ()\n  }\n  emit_local_set(b, 1)\n  // param2 (end) := retag(clamp(untag(end), untag(start'), len))\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_i64_lt_s(b)\n  emit_if_i64(b)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_else(b)\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_local_get(b, len_local)\n  emit_i64_gt_s(b)\n  emit_if_i64(b)\n  emit_local_get(b, len_local)\n  emit_else(b)\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_end(b)\n  emit_end(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  } else {\n    ()\n  }\n  emit_local_set(b, 2)\n  if enable_rc {\n    // ADR-0055 Stage 4: build the slice as a self-describing RC block, the same\n    // shape as gen_arr_new / a literal array, so the recursive rc_drop and the\n    // free-list can reach it. Layout: [alloc_size@0][rc_count@4][class=5@7],\n    // value = block+8, value[0]=cap value[4]=len value[8]=data_ptr=block+20.\n    // The copied elements are shared with the source, so each RC-managed element\n    // is dup'd (guarded) — without this the source drop frees them while the\n    // slice still references them (use-after-free / trap, issue #500).\n    // locals: 3=src_val 4=src_data 5=count 6=block 7=data_ptr 8=cap 9=i (i32),\n    //         10=elem (i64).\n    // src_val = wrap(arr & -2)  (untag the odd source pointer)\n    emit_local_get(b, 0)\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 3)\n    // src_data = src_val[8]\n    emit_local_get(b, 3)\n    emit_i32_load(b, 2, 8)\n    emit_local_set(b, 4)\n    // count = untag(end) - untag(start)\n    emit_local_get(b, 2)\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n    emit_i32_wrap_i64(b)\n    emit_local_get(b, 1)\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n    emit_i32_wrap_i64(b)\n    emit_i32_sub(b)\n    emit_local_set(b, 5)\n    // cap = count + 8\n    emit_local_get(b, 5)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_local_set(b, 8)\n    // block = wrap(vibe_rc_alloc(20 + cap*8))\n    emit_i32_const(b, 20)\n    emit_local_get(b, 8)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_i64_extend_i32_u(b)\n    emit_call(b, rc_alloc_idx)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 6)\n    // block[0] = alloc_size = 20 + cap*8\n    emit_local_get(b, 6)\n    emit_i32_const(b, 20)\n    emit_local_get(b, 8)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 0)\n    // block[4] = rc_count = 1\n    emit_local_get(b, 6)\n    emit_i32_const(b, 1)\n    emit_i32_store(b, 2, 4)\n    // block[7] = class = 5 (array); high byte of the rc_count word\n    emit_local_get(b, 6)\n    emit_i32_const(b, 5)\n    emit_i32_store8(b, 0, 7)\n    // value[0] (block+8) = cap\n    emit_local_get(b, 6)\n    emit_local_get(b, 8)\n    emit_i32_store(b, 2, 8)\n    // value[4] (block+12) = len = count\n    emit_local_get(b, 6)\n    emit_local_get(b, 5)\n    emit_i32_store(b, 2, 12)\n    // data_ptr = block+20\n    emit_local_get(b, 6)\n    emit_i32_const(b, 20)\n    emit_i32_add(b)\n    emit_local_set(b, 7)\n    // value[8] (block+16) = data_ptr\n    emit_local_get(b, 6)\n    emit_local_get(b, 7)\n    emit_i32_store(b, 2, 16)\n    // memory_copy: dst=data_ptr, src=src_data + untag(start)*8, len=count*8\n    emit_local_get(b, 7)\n    emit_local_get(b, 4)\n    emit_local_get(b, 1)\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n    emit_i32_wrap_i64(b)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_local_get(b, 5)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_memory_copy(b)\n    // dup each copied RC-managed element (guarded: odd && high32==0)\n    emit_i32_const(b, 0)\n    emit_local_set(b, 9)\n    emit_block_void(b)\n    emit_loop_void(b)\n    emit_local_get(b, 9)\n    emit_local_get(b, 5)\n    emit_i32_ge_u(b)\n    emit_br_if(b, 1)\n    // elem = load_i64(data_ptr + i*8)\n    emit_local_get(b, 7)\n    emit_local_get(b, 9)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_i64_load(b, 3, 0)\n    emit_local_set(b, 10)\n    // if (elem & 1) — odd heap pointer\n    emit_local_get(b, 10)\n    emit_i64_const(b, 1)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_if_void(b)\n    // if (elem >> 32) == 0 — not a string/bytes fat pointer\n    emit_local_get(b, 10)\n    emit_i64_const(b, 32)\n    emit_i64_shr_s(b)\n    emit_i64_eqz(b)\n    emit_if_void(b)\n    // #715 recurrence guard (VIBE_RC=shadow): trap on dup-of-freed element.\n    if rc_shadow {\n      emit_local_get(b, 10)\n      emit_i64_const(b, -2)\n      emit_i64_and(b)\n      emit_i32_wrap_i64(b)\n      emit_i32_const(b, rc_shadow_base())\n      emit_i32_add(b)\n      emit_i32_load8_u(b, 0, 0)\n      emit_if_void(b)\n      bytebuf_push(b, 0)\n      emit_end(b)\n    } else {\n      ()\n    }\n    // rc_count++ at (elem & -2) - 4\n    emit_rc_word_inc_saturating(b, () -> {\n      emit_local_get(b, 10)\n      emit_i64_const(b, -2)\n      emit_i64_and(b)\n      emit_i32_wrap_i64(b)\n      emit_i32_const(b, 4)\n      emit_i32_sub(b)\n    })\n    emit_end(b)\n    emit_end(b)\n    // i++\n    emit_local_get(b, 9)\n    emit_i32_const(b, 1)\n    emit_i32_add(b)\n    emit_local_set(b, 9)\n    emit_br(b, 0)\n    emit_end(b)\n    emit_end(b)\n    // return (block+8) | 1  (odd-tagged value pointer)\n    emit_local_get(b, 6)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i64_extend_i32_u(b)\n    emit_i64_const(b, 1)\n    emit_i64_or(b)\n  } else {\n    emit_local_get(b, 0)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 3)\n    emit_local_get(b, 3)\n    emit_i32_load(b, 2, 8)\n    emit_local_set(b, 4)\n    emit_local_get(b, 2)\n    emit_i32_wrap_i64(b)\n    emit_local_get(b, 1)\n    emit_i32_wrap_i64(b)\n    emit_i32_sub(b)\n    emit_local_set(b, 5)\n    emit_local_get(b, 5)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_local_set(b, 8)\n    emit_global_get(b, 0)\n    emit_local_tee(b, 6)\n    emit_i32_const(b, 12)\n    emit_local_get(b, 8)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_i32_add(b)\n    emit_global_set(b, 0)\n    emit_heap_memory_grow_check(b)\n    emit_local_get(b, 6)\n    emit_local_get(b, 8)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 6)\n    emit_local_get(b, 5)\n    emit_i32_store(b, 2, 4)\n    emit_local_get(b, 6)\n    emit_i32_const(b, 12)\n    emit_i32_add(b)\n    emit_local_set(b, 7)\n    emit_local_get(b, 6)\n    emit_local_get(b, 7)\n    emit_i32_store(b, 2, 8)\n    emit_local_get(b, 7)\n    emit_local_get(b, 4)\n    emit_local_get(b, 1)\n    emit_i32_wrap_i64(b)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_local_get(b, 5)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_memory_copy(b)\n    emit_local_get(b, 6)\n    emit_i64_extend_i32_u(b)\n  }\n  b\n}\n\nexport fn gen_bytes_get_body(enable_rc: Bool) -> Bytes {\n  let b = bytebuf_new()\n  // #811: unsigned bounds check (idx as u32 >= len traps; negatives too).\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)\n  emit_i32_ge_u(b)\n  emit_if_void(b)\n  bytebuf_push(b, 0)\n  emit_end(b)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  // ADR-0055 Stage 1: the index arrives tagged (n<<1); untag before use.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: the byte is a count entering the value world; tag it.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  b\n}\n\nexport fn gen_bytes_len_body(enable_rc: Bool) -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: the length is a count entering the value world; tag it.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  b\n}\n\n/// simd_skip_ws(buf: Bytes, pos: Int, len: Int) -> Int\n/// Returns the smallest index i in [pos, len) such that buf[i] is not an ASCII\n/// whitespace byte (space/tab/LF/CR); returns len if every byte in the range is\n/// whitespace. A SIMD fast path skips whole 16-byte chunks that are entirely\n/// whitespace; a scalar tail handles the final partial chunk and the chunk that\n/// first contains a non-whitespace byte. The v128 values stay on the operand\n/// stack (no v128 local), so the function declares only i32/i64 locals.\n///   locals: i32 { 3: addr (data ptr), 4: byte } ; i64 { 5: p, 6: n }\nexport fn gen_simd_skip_ws_body(enable_rc: Bool) -> Bytes {\n  let b = bytebuf_new()\n  // addr = data pointer of the Bytes object (payload pointer at obj+8)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 3)\n  // p = untag(pos)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_local_set(b, 5)\n  // n = untag(len)\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_local_set(b, 6)\n  // --- SIMD fast path: skip 16-byte chunks that are entirely whitespace ---\n  emit_bl