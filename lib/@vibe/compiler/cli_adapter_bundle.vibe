let cli_adapter_source_79 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_extractors/common_extractors.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_push, leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_i64_add, emit_i64_div_s, emit_i64_mul, emit_i64_rem_s, emit_i64_sub\n}\n\nlet op_prefix = 252\n\n//# Functions\n\n/// Interior-line breakpoints (span-arc step5): return the first available source\n/// char-offset for `e`, walking into the most-representative child until an\n/// offset-carrying node is found, or -1 if none. EIdent/ECall/EDot carry real\n/// char-offsets; for ECall/EDot prefer the node's own offset, else recurse into\n/// the callee/base. A statement's offset is thus derived from its VALUE\n/// subexpression. Flat single match, tail-recursive into one child per arm.\nexport fn first_offset(e: Expr) -> Int {\n  match e {\n    EIdent(_, off) => off,\n    ECall(callee, _, off) => if off >= 0 {\n      off\n    } else {\n      first_offset(callee)\n    },\n    EDot(base, _, off, _) => if off >= 0 {\n      off\n    } else {\n      first_offset(base)\n    },\n    EBinOp(_, lhs, _) => first_offset(lhs),\n    EUnaryOp(_, inner) => first_offset(inner),\n    ELet(_, val, _, _) => first_offset(val),\n    ELetRec(_, val, _) => first_offset(val),\n    ELetMut(_, val, _, _) => first_offset(val),\n    EAssign(_, val, _) => first_offset(val),\n    EAssignOp(_, _, val, _) => first_offset(val),\n    ESeq(first, _) => first_offset(first),\n    EIf(cond, _, _) => first_offset(cond),\n    EMatch(scrut, _) => first_offset(scrut),\n    EReturn(inner) => first_offset(inner),\n    _ => -1\n  }\n}\n\n/// Interior-line breakpoints: convert a 0-based source char-offset to a 1-based\n/// line number using a sorted array of newline char-offsets: line = 1 + (count of\n/// newline offsets strictly less than `off`). Linear scan (programs are small).\nexport fn offset_to_line(nl: Array[Int], off: Int) -> Int {\n  let n = Array::length(nl)\n  let mut i = 0\n  let mut count = 0\n  while i < n {\n    if Array::get(nl, i) < off {\n      count = count + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  count + 1\n}\n\n/// Interior-line breakpoints: build a sorted array of the char-offsets of each\n/// '\\n' in `src`. Empty when `src` is empty.\nexport fn build_newline_offsets(src: String) -> Array[Int] {\n  let arr = array_empty()\n  let n = String::length(src)\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(src, i) == 10 {\n      Array::push(arr, i)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  arr\n}\n\nexport fn get_ebinop_lhs(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EBinOp(_, lhs, _) => lhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport fn get_ebinop_rhs(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EBinOp(_, _, rhs) => rhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport fn get_ecall_args(expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    ECall(_, args, _) => args,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport fn get_efn_params(expr: Expr) -> Array[(String, Option[TypeExpr])] with { Error } {\n  match expr {\n    EFn(_, _, params, _, _, _) => params,\n    _ => throw(\"not EFn\")\n  }\n}\n\nexport fn get_eint_value(expr: Expr) -> Int with { Error } {\n  match expr {\n    EInt(n) => n,\n    _ => throw(\"not EInt\")\n  }\n}\n\nexport fn get_eseq_first(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ESeq(first, _) => first,\n    _ => throw(\"not ESeq\")\n  }\n}\n\n/// Extract arms from EMatch (non-recursive to avoid stale binding bug in let rec)\nexport fn get_match_arms(expr: Expr) -> Array[(Pat, Expr)] with { Error } {\n  match expr {\n    EMatch(_, arms) => arms,\n    _ => throw(\"get_match_arms: not an EMatch\")\n  }\n}\n\n/// Extract name from PBind\nexport fn get_pbind_name(p: Pat) -> String with { Error } {\n  match p {\n    PBind(name) => name,\n    _ => throw(\"get_pbind_name: not a PBind\")\n  }\n}\n\nexport fn get_pctor_args(p: Pat) -> Array[Pat] with { Error } {\n  match p {\n    PCtor(_, args) => args,\n    _ => throw(\"get_pctor_args: not a PCtor\")\n  }\n}\n\n/// Extract PCtor name and args\nexport fn get_pctor_name(p: Pat) -> String with { Error } {\n  match p {\n    PCtor(name, _) => name,\n    _ => throw(\"get_pctor_name: not a PCtor\")\n  }\n}\n\n/// Extract PInt value\nexport fn get_pint_value(p: Pat) -> Int with { Error } {\n  match p {\n    PInt(n) => n,\n    _ => throw(\"get_pint_value: not a PInt\")\n  }\n}\n\nexport fn get_pfloat_value(p: Pat) -> Double with { Error } {\n  match p {\n    PFloat(v) => v,\n    _ => throw(\"get_pfloat_value: not a PFloat\")\n  }\n}\n\nexport fn get_eassign_val(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssign(_, val, _) => val,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport fn get_ebool_value(expr: Expr) -> Bool with { Error } {\n  match expr {\n    EBool(b) => b,\n    _ => throw(\"not EBool\")\n  }\n}\n\nexport fn get_eforin_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EForIn(_, _, _, body) => body,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport fn get_eforin_iter(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EForIn(_, _, iter, _) => iter,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport fn get_eforin_name(expr: Expr) -> String with { Error } {\n  match expr {\n    EForIn(name, _, _, _) => name,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport fn get_eforin_index(expr: Expr) -> Option[String] with { Error } {\n  match expr {\n    EForIn(_, index_name, _, _) => index_name,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport fn get_eident_name(expr: Expr) -> String with { Error } {\n  match expr {\n    EIdent(name, _) => name,\n    _ => throw(\"not EIdent\")\n  }\n}\n\nexport fn get_eletmut_val(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetMut(_, val, _, _) => val,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport fn get_eletrec_val(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetRec(_, val, _) => val,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport fn get_eseq_second(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ESeq(_, second) => second,\n    _ => throw(\"not ESeq\")\n  }\n}\n\nexport fn get_ereturn_expr(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EReturn(e) => e,\n    _ => throw(\"not EReturn\")\n  }\n}\n\nexport fn get_eunaryop_op(expr: Expr) -> String with { Error } {\n  match expr {\n    EUnaryOp(op, _) => op,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\nexport fn get_ewhile_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EWhile(_, body) => body,\n    _ => throw(\"not EWhile\")\n  }\n}\n\nexport fn get_ewhile_cond(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EWhile(cond, _) => cond,\n    _ => throw(\"not EWhile\")\n  }\n}\n\n/// Extract PBool value\nexport fn get_pbool_value(p: Pat) -> Bool with { Error } {\n  match p {\n    PBool(v) => v,\n    _ => throw(\"get_pbool_value: not a PBool\")\n  }\n}\n\n/// Extract sub-patterns from PTuple\nexport fn get_ptuple_pats(p: Pat) -> Array[Pat] with { Error } {\n  match p {\n    PTuple(pats) => pats,\n    _ => throw(\"get_ptuple_pats: not a PTuple\")\n  }\n}\n\nexport fn get_slet_export(stmt: Stmt) -> Bool with { Error } {\n  match stmt {\n    SLet(is_export, _, _, _, _) => is_export,\n    _ => throw(\"not SLet\")\n  }\n}\n\n/// Check if a pattern is unconditionally matching (catch-all)\nexport fn is_catchall_pat(p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    PBind(_) => true,\n    PTuple(pats) => {\n      // PTuple is catch-all only if ALL sub-patterns are catch-all\n      let mut i = 0\n      let mut all_catch = true\n      while i < Array::length(pats) {\n        if !is_catchall_pat(Array::get(pats, i)) {\n          all_catch = false\n        }\n        i = i + 1\n      }\n      all_catch\n    },\n    PStruct(_, fields) => {\n      // A struct pattern is irrefutable (catch-all) exactly when every field\n      // sub-pattern is — a struct has a single shape, so the only thing that can\n      // make it refutable is a literal field sub-pattern. (`S::{ x, y }` binds;\n      // `S::{ x: 5 }` is refutable and needs a discriminating test instead.)\n      let mut i = 0\n      let mut all_catch = true\n      while i < Array::length(fields) {\n        let (_, sp) = Array::get(fields, i)\n        if !is_catchall_pat(sp) {\n          all_catch = false\n        }\n        i = i + 1\n      }\n      all_catch\n    },\n    _ => false\n  }\n}\n\n/// Emit WASM instruction for an assign operator (+=, -=, etc.)\nexport fn emit_assignop_op(buf: Bytes, op: String) -> Unit with { Error } {\n  if op == \"+\" {\n    emit_i64_add(buf)\n  }\n  else if op == \"-\" {\n    emit_i64_sub(buf)\n  }\n  else if op == \"*\" {\n    emit_i64_mul(buf)\n  }\n  else if op == \"/\" {\n    emit_i64_div_s(buf)\n  }\n  else if op == \"%\" {\n    emit_i64_rem_s(buf)\n  }\n  else {\n    throw(String::concat(\"unsupported assign op: \", op))\n  }\n}\n\nexport fn emit_memory_copy(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_prefix)\n  leb128_encode_u32(buf, 10)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n}\n\n/// memory.fill: stack operands (dest, value, size) -> fills `size` bytes at\n/// `dest` with the low byte of `value`. Bulk-memory op 11 (same 0xFC prefix\n/// family as memory.copy above). Used to zero-init (or 0xFF-sentinel-init) a\n/// fresh hash-index table in one instruction instead of a store loop.\nexport fn emit_memory_fill(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_prefix)\n  leb128_encode_u32(buf, 11)\n  bytebuf_push(buf, 0)\n}\n\nexport fn get_earray_elems(expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    EArray(elems) => elems,\n    _ => throw(\"not EArray\")\n  }\n}\n\nexport fn get_eassign_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssign(_, _, body) => body,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport fn get_eassign_name(expr: Expr) -> String with { Error } {\n  match expr {\n    EAssign(name, _, _) => name,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport fn get_eassignop_op(expr: Expr) -> String with { Error } {\n  match expr {\n    EAssignOp(_, op, _, _) => op,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport fn get_ecall_callee(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ECall(callee, _, _) => callee,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport fn get_efloat_value(expr: Expr) -> Double with { Error } {\n  match expr {\n    EFloat(v) => v,\n    _ => throw(\"not EFloat\")\n  }\n}\n\nexport fn get_eletmut_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetMut(_, _, body, _) => body,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport fn get_eletmut_name(expr: Expr) -> String with { Error } {\n  match expr {\n    ELetMut(name, _, _, _) => name,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport fn get_eletrec_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetRec(_, _, body) => body,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport fn get_eletrec_name(expr: Expr) -> String with { Error } {\n  match expr {\n    ELetRec(name, _, _) => name,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\n/// Extract elements from ETuple\nexport fn get_etuple_elems(expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    ETuple(elems) => elems,\n    _ => throw(\"get_etuple_elems: not an ETuple\")\n  }\n}\n\nexport fn str_table_lookup(strs: Array[String], s: String) -> Int with { Error } {\n  let len = Array::length(strs)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if Array::get(strs, i) == s {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"string not in table: \", s))\n  }\n  found\n}\n\n/// Find the index of the first catch-all pattern in match arms\n/// Returns num_arms if no catch-all found\nexport fn find_catchall_idx(arms: Array[(Pat, Expr)]) -> Int {\n  let num = Array::length(arms)\n  let mut idx = 0\n  let mut result = num\n  while idx < num {\n    let (p, _) = Array::get(arms, idx)\n    if is_catchall_pat(p) {\n      result = idx\n      idx = num\n    } else {\n      idx = idx + 1\n    }\n  }\n  result\n}\n\nexport fn get_eassignop_val(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssignOp(_, _, val, _) => val,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport fn get_estring_value(expr: Expr) -> String with { Error } {\n  match expr {\n    EString(s) => s,\n    _ => throw(\"not EString\")\n  }\n}\n\nexport fn get_eunaryop_expr(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EUnaryOp(_, e) => e,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\n/// Extract PString value\nexport fn get_pstring_value(p: Pat) -> String with { Error } {\n  match p {\n    PString(s) => s,\n    _ => throw(\"get_pstring_value: not a PString\")\n  }\n}\n\nexport fn array_contains_str(arr: Array[String], s: String) -> Bool {\n  let len = Array::length(arr)\n  let mut i = 0\n  let mut found = false\n  while i < len {\n    if Array::get(arr, i) == s {\n      found = true\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// #1015: Int twin of array_contains_str, for slot-indexed tracking arrays\n/// (CompileCtxGc.gc_bool_locals and its local_names-derived lookups in\n/// codegen/gc/backend_expr.vibe and codegen/gc/backend_call.vibe). Plain\n/// membership, no encoding -- see gc_bool_locals' doc comment on\n/// CompileCtxGc for why no encoding is needed.\nexport fn array_contains_int(arr: Array[Int], v: Int) -> Bool {\n  let len = Array::length(arr)\n  let mut i = 0\n  let mut found = false\n  while i < len {\n    if Array::get(arr, i) == v {\n      found = true\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport fn get_eassignop_body(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssignOp(_, _, _, body) => body,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport fn get_eassignop_name(expr: Expr) -> String with { Error } {\n  match expr {\n    EAssignOp(name, _, _, _) => name,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\n/// Extract scrutinee from EMatch (non-recursive to avoid stale binding bug in let rec)\nexport fn get_match_scrutinee(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EMatch(scrutinee, _) => scrutinee,\n    _ => throw(\"get_match_scrutinee: not an EMatch\")\n  }\n}\n")
}

let cli_adapter_source_80 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_analysis/index.vpkg",
"name = @vibe/compiler/codegen/common_analysis\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/codegen/common_analysis — free-variable / string-literal /\ndeps = {\n  @vibe/compiler/codegen/common_extractors : 0.0.1\n  @vibe/compiler/codegen/wasm_emit : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/codegen/common_analysis — free-variable / string-literal /\n// exception-reachability AST analyses shared across codegen, plus a few\n// low-level Perceus-adjacent codegen emit helpers (ADR-0070 Phase 3, #897,\n// compiler-internal batch). Compiled into the compiler itself via\n// compiler_sources_manifest.tsv (group `codegen`, dual-row: this contract +\n// common_analysis.vibe).\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package is single-file), so it moved verbatim to common_analysis.vibe. No\n// exported types: every struct/enum this package touches (Expr/Pat/Stmt from\n// ../../core) is structural signature text resolved against the\n// implementation import when the facade is merged in (normalize/perceus\n// precedent — no re-import needed here). No `version` binding existed\n// (compiler-internal package).\n\nfn collect_strings_expr(expr: Expr, out: Array[String]) -> Int\nfn get_func_param_names(stmt: Stmt) -> Array[String] with { Error }\nfn expr_contains_exceptions(expr: Expr) -> Bool\nfn stmts_contain_exceptions(stmts: Array[Stmt]) -> Bool\nfn collect_strings_stmts(stmts: Array[Stmt]) -> Array[String]\nfn emit_i64_extend_i32_u(buf: Bytes) -> Unit\nfn emit_closure_resolve(buf: Bytes, fn_val_local: Int, slot_local: Int, env_local: Int) -> Unit\nfn emit_closure_call_tail(buf: Bytes, env_local: Int, slot_local: Int, closure_type_base: Int, num_args: Int) -> Unit\nfn collect_free_vars_expr(expr: Expr, bound: Array[String], fn_names: Array[String], out: Array[String]) -> Int\nfn collect_free_vars(body: Expr, param_names: Array[String], fn_names: Array[String]) -> Array[String]\nfn collect_free_vars_indexed(body: Expr, param_names: Array[String], fn_name_index: Array[String]) -> Array[String]\nfn collect_free_vars_indexed_self(body: Expr, param_names: Array[String], fn_name_index: Array[String], self_name: String, encl: Array[String]) -> Array[String]\nfn proj_root_ident(e: Expr) -> String\nfn scope_tail_proj_root(e: Expr) -> String\nfn is_mut_captured_in(expr: Expr, name: String) -> Bool\nfn mut_needs_ref_cell(body: Expr, name: String) -> Bool\nfn md_is_borrow_arg0_call(f: String) -> Bool\nfn md_consume_count(e: Expr, name: String) -> Int\nfn zero_alloc_check(stmts: Array[Stmt]) -> String\nfn compute_borrow_arg0_user_fns(stmts: Array[Stmt]) -> Array[String]\nfn compute_may_return_view_fns(stmts: Array[Stmt]) -> Array[String]\nfn count_lambda_sites_expr(expr: Expr) -> Int\n")
}

let cli_adapter_source_81 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_analysis/common_analysis.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, bsearch_leftmost, bytebuf_push, sorted_names_of\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_call_indirect,\n  emit_else,\n  emit_end,\n  emit_i32_load,\n  emit_i32_wrap_i64,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_eq,\n  emit_i64_or,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_if_void,\n  emit_local_get,\n  emit_local_set\n}\n\nlet op_i64_extend_i32_u = 173\n\n//# Functions\n\nfn common_analysis_fresh_string_array() -> Array[String] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\n/// Collect string literals appearing anywhere in a pattern, including inside\n/// constructor / tuple / or / struct sub-patterns. #603: codegen now tests a\n/// `PString` sub-pattern of a `PCtor`, so its literal must be registered in the\n/// string table (previously only top-level `PString` arms were collected).\nfn collect_strings_pat(pat: Pat, out: Array[String]) -> Int {\n  match pat {\n    PString(s) => {\n      let mut pf = false\n      let mut pi = 0\n      while pi < Array::length(out) {\n        if Array::get(out, pi) == s {\n          pf = true\n        }\n        pi = pi + 1\n      }\n      if !pf {\n        Array::push(out, s)\n      }\n      0\n    },\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        let _ = collect_strings_pat(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        let _ = collect_strings_pat(Array::get(pats, i), out)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, r) => {\n      let _ = collect_strings_pat(l, out)\n      let _ = collect_strings_pat(r, out)\n      0\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        let _ = collect_strings_pat(fp, out)\n        i = i + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nexport fn collect_strings_expr(expr: Expr, out: Array[String]) -> Int {\n  match expr {\n    EString(s) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(out) {\n        if Array::get(out, i) == s {\n          found = true\n        }\n        i = i + 1\n      }\n      if !found {\n        Array::push(out, s)\n      }\n      0\n    },\n    EBinOp(_, lhs, rhs) => {\n      collect_strings_expr(lhs, out)\n      collect_strings_expr(rhs, out)\n    },\n    EUnaryOp(_, operand) => collect_strings_expr(operand, out),\n    EIf(cond, then_e, else_e) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(then_e, out)\n      collect_strings_expr(else_e, out)\n    },\n    ECall(callee, args, _) => {\n      collect_strings_expr(callee, out)\n      // #784: the bool→string codegen path (compile_call.vibe) synthesizes\n      // `if b { \"true\" } else { \"false\" }` for a statically-boolean `__to_string`\n      // arg. Those EString nodes are created during codegen — AFTER this\n      // collection pass — so their literals are otherwise absent from the string\n      // table (`string not in table: true`, Codex #785 review, P1). Seed them\n      // whenever `__to_string` is called. Over-approximates (also seeds for a\n      // purely-integer `__to_string`), which is harmless: two small interned\n      // strings.\n      match callee {\n        EIdent(nm, _) => if nm == \"__to_string\" {\n          collect_strings_expr(EString(\"true\"), out)\n          collect_strings_expr(EString(\"false\"), out)\n        } else {\n          0\n        },\n        _ => 0\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_strings_expr(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(_, value, body, _) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetRec(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetMut(_, value, body, _) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssign(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssignOp(_, _, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ESeq(first, second) => {\n      collect_strings_expr(first, out)\n      collect_strings_expr(second, out)\n    },\n    EWhile(cond, body) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(body, out)\n    },\n    EForIn(_, _, iter_e, body) => {\n      collect_strings_expr(iter_e, out)\n      collect_strings_expr(body, out)\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_strings_expr(scrutinee, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_expr) = Array::get(arms, i)\n        let _ = collect_strings_pat(pat, out)\n        collect_strings_expr(arm_expr, out)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),\n    EReturn(msg) => collect_strings_expr(msg, out),\n    EStringInterp(parts) => {\n      let mut si_p = 0\n      while si_p < Array::length(parts) {\n        if si_p % 2 == 0 {\n          let part = Array::get(parts, si_p)\n          if String::length(part) > 0 {\n            let mut found = false\n            let mut fi2 = 0\n            while fi2 < Array::length(out) {\n              if Array::get(out, fi2) == part {\n                found = true\n              }\n              fi2 = fi2 + 1\n            }\n            if !found {\n              Array::push(out, part)\n            }\n          }\n        }\n        si_p = si_p + 1\n      }\n      0\n    },\n    EHandle(body, arms) => {\n      collect_strings_expr(body, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_strings_expr(arm_expr, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut mi = 0\n      while mi < Array::length(fields) {\n        let (key, val) = Array::get(fields, mi)\n        let mut kf = false\n        let mut ki = 0\n        while ki < Array::length(out) {\n          if Array::get(out, ki) == key {\n            kf = true\n          }\n          ki = ki + 1\n        }\n        if !kf {\n          Array::push(out, key)\n        }\n        collect_strings_expr(val, out)\n        mi = mi + 1\n      }\n      0\n    },\n    ERecord(_, fields, _) => {\n      let mut ri = 0\n      while ri < Array::length(fields) {\n        let (_, fval) = Array::get(fields, ri)\n        collect_strings_expr(fval, out)\n        ri = ri + 1\n      }\n      0\n    },\n    EDot(obj, _, _, _) => collect_strings_expr(obj, out),\n    ELabeledArg(_, _, val) => collect_strings_expr(val, out),\n    _ => 0\n  }\n}\n\n/// Extract function param names from SLet(_, _, _, _, EFn(_, _, params, _, _, _))\nexport fn get_func_param_names(stmt: Stmt) -> Array[String] with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, params, _, _, _) => {\n        let names = common_analysis_fresh_string_array()\n        let mut i = 0\n        while i < Array::length(params) {\n          let (pname, _) = Array::get(params, i)\n          // Strip labeled/optional markers from param names\n          let plen2 = String::length(pname)\n          let clean_name = if plen2 > 0 {\n            let last_char = String::char_code_at(pname, plen2 - 1)\n            if last_char == '~' || last_char == '?' {\n              pname[0: plen2 - 1]\n            } else pname\n          } else pname\n          Array::push(names, clean_name)\n          i = i + 1\n        }\n        names\n      },\n      _ => throw(\"get_func_param_names: not a function\")\n    },\n    _ => throw(\"get_func_param_names: not a let statement\")\n  }\n}\n\n/// #721: does the program reference the exception machinery anywhere? EThrow\n/// compiles to `throw 2`, EHandle to try_table over tags 0-3, and effect op\n/// performs to `throw <eff_tag>` (guarded separately by the effect declaration\n/// list). When NONE of these appear, the tag section and the \"error\" tag\n/// export can be omitted entirely -- V8 runs exnref-bearing modules on a\n/// slower path, costing pure-compute code ~35% (fib(38): 0.32s with tags vs\n/// 0.20s without; wasmtime shows parity, so it is engine behavior, not\n/// codegen). Conservative: any EThrow/EHandle at ANY nesting depth counts.\nexport fn expr_contains_exceptions(expr: Expr) -> Bool {\n  match expr {\n    EHandle(_, _) => true,\n    EBinOp(_, lhs, rhs) => expr_contains_exceptions(lhs) || expr_contains_exceptions(rhs),\n    EUnaryOp(_, operand) => expr_contains_exceptions(operand),\n    EIf(cond, then_e, else_e) =>\n    expr_contains_exceptions(cond) || expr_contains_exceptions(then_e) || expr_contains_exceptions(else_e),\n    ECall(callee, args, _) => {\n      // A bare `resume(..)` call compiles to `throw 1` (continuation resume)\n      // even without a surrounding EHandle in this expression -- a resume\n      // misused outside a handler must still produce a VALID module. A user\n      // function actually named `resume` merely keeps the tags (harmless\n      // over-approximation).\n      //\n      // #774: `perform Eff::Op(..)` compiles to `throw <eff_tag>`\n      // (compile_call.vibe) EVEN WHEN the enclosing file declares no\n      // `effect Eff { .. }` of its own (e.g. lib/@vibe/http/http.vibe /\n      // lib/@vibe/socket/tcp.vibe perform `Http::*`/`Socket::*` ops whose\n      // names never appear as an `SEffectDef` in the compiled unit) --\n      // `effect_name_to_tag` falls back to a sentinel tag index in that\n      // case. Missing \"perform\" here (like \"resume\") made `uses_exceptions`\n      // false whenever a compiled unit's ONLY exception-shaped construct was\n      // an un-declared-effect `perform` with no `handle`/`throw` anywhere\n      // else, so the tag section was omitted -- and the emitted `throw\n      // <eff_tag>` then referenced a tag index that plain does not exist,\n      // failing wasm validation (\"Invalid tag index: N\") the moment the\n      // function's body is compiled, whether or not it is ever called.\n      let mut found = match callee {\n        EIdent(cname, _) => cname == \"resume\" || cname == \"perform\",\n        _ => expr_contains_exceptions(callee)\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        if expr_contains_exceptions(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELet(_, value, body, _) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    ELetRec(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    ELetMut(_, value, body, _) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    EAssign(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    EAssignOp(_, _, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    ESeq(first, second) => expr_contains_exceptions(first) || expr_contains_exceptions(second),\n    EWhile(cond, body) => expr_contains_exceptions(cond) || expr_contains_exceptions(body),\n    EForIn(_, _, iter_e, body) => expr_contains_exceptions(iter_e) || expr_contains_exceptions(body),\n    ELoop(params, body) => {\n      let mut i = 0\n      let mut found = expr_contains_exceptions(body)\n      while i < Array::length(params) {\n        let (_, iv) = Array::get(params, i)\n        if expr_contains_exceptions(iv) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMatch(scrut, arms) => {\n      let mut i = 0\n      let mut found = expr_contains_exceptions(scrut)\n      while i < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, i)\n        if expr_contains_exceptions(arm_body) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EFn(_, _, _, _, _, body) => expr_contains_exceptions(body),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_contains_exceptions(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_contains_exceptions(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_contains_exceptions(fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_contains_exceptions(fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EDot(obj, _, _, _) => expr_contains_exceptions(obj),\n    ELabeledArg(_, _, inner) => expr_contains_exceptions(inner),\n    EReturn(inner) => expr_contains_exceptions(inner),\n    ESpread(inner) => expr_contains_exceptions(inner),\n    EBreak(opt) => match opt {\n      Some(inner) => expr_contains_exceptions(inner),\n      None => false\n    },\n    EContinue(args) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if expr_contains_exceptions(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EInt(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EBool(_) => false,\n    EIdent(_, _) => false,\n    EStringInterp(_) => false,\n    EUnit => false\n  }\n}\n\nexport fn stmts_contain_exceptions(stmts: Array[Stmt]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SLetMut(_, _, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SLetPat(_, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SExpr(expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      STest(_, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SBench(_, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SModule(_, _, inner) => if stmts_contain_exceptions(inner) {\n        found = true\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nexport fn collect_strings_stmts(stmts: Array[Stmt]) -> Array[String] {\n  let out = common_analysis_fresh_string_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),\n      _ => 0\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn emit_i64_extend_i32_u(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_extend_i32_u)\n}\n\n/// Resolve closure/fn value tag and fill slot_local/env_local\n/// After this: slot_local = table slot index, env_local = env pointer (0 for bare fn)\nexport fn emit_closure_resolve(buf: Bytes, fn_val_local: Int, slot_local: Int, env_local: Int) -> Unit {\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 3)\n  emit_i64_and(buf)\n  emit_i64_const(buf, 2)\n  emit_i64_eq(buf)\n  emit_if_void(buf)\n  // Bare fn: table_slot = fn_val >> 2, env = 0\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 2)\n  emit_i64_shr_s(buf)\n  emit_local_set(buf, slot_local)\n  emit_i64_const(buf, 0)\n  emit_local_set(buf, env_local)\n  emit_else(buf)\n  // Closure: env = fn_val & ~3, slot = i32.load(env, 0)\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, -4)\n  emit_i64_and(buf)\n  emit_local_set(buf, env_local)\n  emit_local_get(buf, env_local)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i64_extend_i32_u(buf)\n  emit_local_set(buf, slot_local)\n  emit_end(buf)\n}\n\n/// Emit the tail of an indirect closure call (push env, push slot, call_indirect)\nexport fn emit_closure_call_tail(buf: Bytes, env_local: Int, slot_local: Int, closure_type_base: Int, num_args: Int) -> Unit {\n  emit_local_get(buf, env_local)\n  emit_local_get(buf, slot_local)\n  emit_i32_wrap_i64(buf)\n  emit_call_indirect(buf, closure_type_base + num_args)\n}\n\nfn collect_pattern_bindings(pat: Pat, bindings: Array[String]) -> Int {\n  match pat {\n    PBind(name) => {\n      Array::push(bindings, name); 0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pattern_bindings(Array::get(pats, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_pattern_bindings(Array::get(args, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, r) => {\n      collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fpat) = Array::get(fields, i)\n        collect_pattern_bindings(fpat, bindings)\n        i = i + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\n/// Inlined async builtins (docs/spec/wasi-p3-async.md) are lowered directly by\n/// compile_call rather than living in the func table, so — like operators — they\n/// must never be treated as free variables when they appear inside a nested\n/// lambda body. Otherwise a thunk such as `() -> { Task::join(t) }` would capture\n/// `Task::join` as a closure value and mis-lower the call as an indirect apply.\nfn is_inlined_async_builtin(name: String) -> Bool {\n  name == \"await\" || name == \"Future::ready\" || name == \"Stream::empty\" || name == \"Stream::once\" || name == \"Stream::map\" || name == \"Stream::filter\" || name == \"Stream::fold\" || name == \"Stream::next\" || name == \"String::to_bytes\" || name == \"Stream::to_string\"\n}\n\n/// #773: the scalar arithmetic/logic intrinsics (\"not\"/\"add\"/\"sub\"/\"mul\"/\"lt\")\n/// are, like the async builtins above, lowered INLINE by compile_call.vibe\n/// (`!prefer_bound_call && fname == \"not\"` etc.) rather than living in the func\n/// table -- UNLESS a user top-level function of the same bare name shadows them,\n/// in which case they're already present in `fn_names` (ctx.func_table.names)\n/// and excluded by the check above. (\"eq\"/\"Array::length\"/\"Bytes::length\"/\n/// \"String::length\" are unconditionally registered in the func table for every\n/// compile, so they never reach this fallback and need no entry here.)\n///\n/// Before this fix, a closure/lambda literal that referenced one of these bare\n/// names as a call callee (e.g. `(b: Bool) -> Bool { not(b) }`) — and did NOT\n/// shadow it with a same-named top-level function — fell through to the `else`\n/// branch below and was wrongly recorded as a FREE VARIABLE to capture from the\n/// enclosing scope. compile_lambda.vibe then allocated a captured-env slot named\n/// \"not\" and, back in compile_call.vibe, `local_idx_hint` found \"not\" among the\n/// closure's own `local_names` (the just-added capture), forcing\n/// `prefer_bound_call = true` -- i.e. treating the wrongly captured (and\n/// nonexistent-in-the-enclosing-scope) \"not\" value as a closure to invoke via\n/// `call_indirect`. That corrupted the closure's environment and crashed with\n/// \"unreachable\" / \"null function or function signature mismatch\" at runtime\n/// (reported against @vibex/quickcheck's check_int/check_bool + is_ok, whose\n/// property closures call `not(...)`).\n///\n/// #1095: \"assert\" has the identical `!prefer_bound_call && fname == \"assert\"`\n/// inline-lowering gate in compile_call.vibe, and hit the same bug: a closure\n/// body calling bare `assert(...)` got it wrongly captured as a free variable,\n/// so `assert(false)` inside a lambda crashed with \"null function or function\n/// signature mismatch\" instead of the expected \"unreachable\" trap that the\n/// same code produces at top level.\nfn is_inlined_scalar_builtin(name: String) -> Bool {\n  name == \"not\" || name == \"add\" || name == \"sub\" || name == \"mul\" || name == \"lt\" || name == \"assert\"\n}\n\n/// Stack-based free variable analysis: uses in-place push/truncate on bound array\n/// to avoid O(n) array copies at every scope boundary. This dramatically reduces\n/// heap allocation during meta-circular self-compilation.\n/// #799 perf: `fn_names` is a MEMBERSHIP INDEX (Map), not an array. The flat\n/// fn+ctor name table is thousands of entries in a compiler-closure compile,\n/// and this walker consulted it linearly PER IDENT -- ~70% of a full compile's\n/// profile was string-equality scans under this function. Callers with a hot\n/// loop pass a prebuilt index (ctx.capture_name_index); the Array-taking\n/// wrapper below builds one per call for small/cold callers.\n/// #640 Stage 2: recognize the parse-time desugar of `throw(x)` —\n/// `ECall(EIdent(\"perform\"), [ECall(EIdent(\"Error::Throw\"), payload_args)])`\n/// — and return its payload args. None for every other perform (or shape).\nfn ca_perform_error_throw_op_args(args: Array[Expr]) -> Option[Array[Expr]] {\n  if Array::length(args) == 1 {\n    match Array::get(args, 0) {\n      ECall(op_callee, op_args, _) => match op_callee {\n        EIdent(op_name, _) => if op_name == \"Error::Throw\" {\n          Some(op_args)\n        } else {\n          None\n        },\n        _ => None\n      },\n      _ => None\n    }\n  } else {\n    None\n  }\n}\n\n/// #1114: the inlined-builtin skip below must also yield to a LOCAL binding\n/// in an ENCLOSING scope. `bound` only ever holds the innermost lambda's own\n/// binders (it is re-seeded per lambda from that lambda's parameters -- see\n/// collect_free_vars_indexed), and `fn_names` only holds TOP-LEVEL names, so\n/// neither can see that e.g. `fn outer(not: (Bool) -> Bool)` binds `not` for\n/// a nested `() -> { not(true) }`. Without `encl` the skip fired, `not` was\n/// never captured, and the call silently lowered to the BUILTIN logical-not\n/// instead of invoking the parameter -- a wrong VALUE, not a crash.\n/// `encl` is the enclosing compile scope's local names, threaded from\n/// compile_lambda; the public wrapper passes an empty array, which reproduces\n/// the previous behavior exactly for every other caller.\nexport fn collect_free_vars_expr(expr: Expr, bound: Array[String], fn_names: Array[String], out: Array[String]) -> Int {\n  collect_free_vars_expr_sc(expr, bound, fn_names, common_analysis_fresh_string_array(), out)\n}\n\nfn collect_free_vars_expr_sc(expr: Expr, bound: Array[String], fn_names: Array[String], encl: Array[String], out: Array[String]) -> Int {\n  match expr {\n    // #1203: `encl` (the enclosing scope's own locals, e.g. an outer\n    // function's parameters) must be checked BEFORE `fn_names` (top-level\n    // globals). Checking `fn_names` first meant a plain identifier reference\n    // that is actually shadowed by an enclosing-scope local (e.g.\n    // `compose(f, g) = (z) -> g(f(z))`, where `f`/`g` are compose's OWN\n    // parameters) was wrongly treated as \"already global, no capture needed\"\n    // whenever the merged program happened to also define a top-level\n    // function of the same bare name (`fn f() { .. }` anywhere in the\n    // linked program) -- silently dropping a real capture and corrupting\n    // the closure's environment layout (wrong field count / call arity)\n    // rather than raising any diagnostic.\n    EIdent(name, _) => if array_contains_str(bound, name) {\n      0\n    }\n    else if array_contains_str(encl, name) {\n      if array_contains_str(out, name) {\n        0\n      } else {\n        Array::push(out, name)\n        0\n      }\n    }\n    else if bsearch_leftmost(fn_names, name) >= 0 {\n      0\n    }\n    else if array_contains_str(out, name) {\n      0\n    }\n    else {\n      Array::push(out, name)\n      0\n    },\n    EInt(_) => 0,\n    EBool(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EUnit => 0,\n    EBinOp(_, lhs, rhs) => {\n      collect_free_vars_expr_sc(lhs, bound, fn_names, encl, out); collect_free_vars_expr_sc(rhs, bound, fn_names, encl, out)\n    },\n    EUnaryOp(_, operand) => collect_free_vars_expr_sc(operand, bound, fn_names, encl, out),\n    EIf(cond, then_e, else_e) => {\n      collect_free_vars_expr_sc(cond, bound, fn_names, encl, out); collect_free_vars_expr_sc(then_e, bound, fn_names, encl, out); collect_free_vars_expr_sc(else_e, bound, fn_names, encl, out)\n    },\n    // #773/regression fix: the inlined-builtin skip only applies to a bare\n    // name used as a CALL CALLEE (`sub(a, b)`), never to a plain identifier\n    // reference. Checking it in the generic EIdent branch above would also\n    // swallow a real bound-elsewhere variable that merely happens to share\n    // one of these short names (e.g. a `sub: String` parameter in\n    // lib/@vibe/prelude/string.vibe's string_index_of_from), wrongly\n    // skipping its capture into a nested closure and crashing with\n    // \"undefined variable (ident)\" at runtime.\n    ECall(EIdent(cname, _), args, _) => if cname == \"perform\" {\n      // #640 Stage 2: `throw(x)` parses to `perform Error::Throw(x)`. The\n      // magic `perform` callee and the `Error::Throw` op name are keywords,\n      // not capturable values — collecting them as free vars made every\n      // throw-bearing LOCAL closure capture a garbage \"perform\" slot and\n      // call through it (null call_indirect / signature mismatch at\n      // runtime; the #786 perform-in-closure shape, which throw never had\n      // as EThrow). Skip both and recurse into the payload only. A real\n      // `perform Eff::Op(..)` keeps the historical collection verbatim\n      // (those lambdas are dlh-hoisted before this analysis runs).\n      match ca_perform_error_throw_op_args(args) {\n        Some(op_args) => {\n          let mut i = 0\n          while i < Array::length(op_args) {\n            collect_free_vars_expr_sc(Array::get(op_args, i), bound, fn_names, encl, out)\n            i = i + 1\n          }\n          0\n        },\n        None => {\n          collect_free_vars_expr_sc(EIdent(cname, 0), bound, fn_names, encl, out)\n          let mut i = 0\n          while i < Array::length(args) {\n            collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, out)\n            i = i + 1\n          }\n          0\n        }\n      }\n    } else if !array_contains_str(bound, cname) && !(bsearch_leftmost(fn_names, cname) >= 0) && !array_contains_str(encl, cname) && (is_inlined_async_builtin(cname) || is_inlined_scalar_builtin(cname)) {\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, out)\n        i = i + 1\n      }\n      0\n    } else {\n      collect_free_vars_expr_sc(EIdent(cname, 0), bound, fn_names, encl, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, out)\n        i = i + 1\n      }\n      0\n    },\n    ECall(callee, args, _) => {\n      collect_free_vars_expr_sc(callee, bound, fn_names, encl, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(name, value, body, _) => {\n      collect_free_vars_expr_sc(value, bound, fn_names, encl, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr_sc(body, bound, fn_names, encl, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetRec(name, value, body) => {\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr_sc(value, bound, fn_names, encl, out)\n      collect_free_vars_expr_sc(body, bound, fn_names, encl, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetMut(name, value, body, _) => {\n      collect_free_vars_expr_sc(value, bound, fn_names, encl, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr_sc(body, bound, fn_names, encl, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EAssign(name, value, body) => {\n      // The assignment TARGET is a variable reference too: a lambda whose only\n      // use of an outer `let mut` is `x = 1` (no read) must still capture it —\n      // previously only value/body mentions were collected, so `count += 1` /\n      // write-only assigns in closures failed codegen with\n      // \"undefined variable (local): count\" (and is_mut_captured_in, which\n      // rides this collector, never promoted the cell).\n      // #1203 Codex review (P1): same encl-before-fn_names precedence as the\n      // plain EIdent case above -- an enclosing `let mut f` reassigned only\n      // via `f = ...`/`f += ...` inside the closure must still be captured\n      // even when the linked program also defines an unrelated top-level\n      // `fn f`.\n      if array_contains_str(bound, name) {\n        0\n      } else if array_contains_str(encl, name) {\n        if array_contains_str(out, name) {\n          0\n        } else {\n          Array::push(out, name)\n          0\n        }\n      } else if bsearch_leftmost(fn_names, name) >= 0 || array_contains_str(out, name) {\n        0\n      } else {\n        Array::push(out, name)\n        0\n      }\n      collect_free_vars_expr_sc(value, bound, fn_names, encl, out); collect_free_vars_expr_sc(body, bound, fn_names, encl, out)\n    },\n    EAssignOp(name, _, value, body) => {\n      if array_contains_str(bound, name) {\n        0\n      } else if array_contains_str(encl, name) {\n        if array_contains_str(out, name) {\n          0\n        } else {\n          Array::push(out, name)\n          0\n        }\n      } else if bsearch_leftmost(fn_names, name) >= 0 || array_contains_str(out, name) {\n        0\n      } else {\n        Array::push(out, name)\n        0\n      }\n      collect_free_vars_expr_sc(value, bound, fn_names, encl, out); collect_free_vars_expr_sc(body, bound, fn_names, encl, out)\n    },\n    ESeq(first, second) => {\n      collect_free_vars_expr_sc(first, bound, fn_names, encl, out); collect_free_vars_expr_sc(second, bound, fn_names, encl, out)\n    },\n    EWhile(cond, body) => {\n      collect_free_vars_expr_sc(cond, bound, fn_names, encl, out); collect_free_vars_expr_sc(body, bound, fn_names, encl, out)\n    },\n    EForIn(var_name, index_name, iter_e, body) => {\n      collect_free_vars_expr_sc(iter_e, bound, fn_names, encl, out)\n      let saved = Array::length(bound)\n      Array::push(bound, var_name)\n      match index_name {\n        Some(index_name) => Array::push(bound, index_name),\n        None => ()\n      }\n      collect_free_vars_expr_sc(body, bound, fn_names, encl, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr_sc(Array::get(elems, i), bound, fn_names, encl, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr_sc(Array::get(elems, i), bound, fn_names, encl, out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_free_vars_expr_sc(scrutinee, bound, fn_names, encl, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (arm_pat, arm_expr) = Array::get(arms, i)\n        let saved = Array::length(bound)\n        collect_pattern_bindings(arm_pat, bound)\n        collect_free_vars_expr_sc(arm_expr, bound, fn_names, encl, out)\n        Array::truncate(bound, saved)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let saved = Array::length(bound)\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname_raw, _) = Array::get(params, pi)\n        let pnl = String::length(pname_raw)\n        let pname = if pnl > 0 {\n          let plc = String::char_code_at(pname_raw, pnl - 1)\n          if plc == '~' || plc == '?' {\n            pname_raw[0: pnl - 1]\n          } else pname_raw\n        } else pname_raw\n        Array::push(bound, pname)\n        pi = pi + 1\n      }\n      collect_free_vars_expr_sc(body, bound, fn_names, encl, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EReturn(msg) => collect_free_vars_expr_sc(msg, bound, fn_names, encl, out),\n    EHandle(body, arms) => {\n      collect_free_vars_expr_sc(body, bound, fn_names, encl, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_free_vars_expr_sc(arm_expr, bound, fn_names, encl, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EDot(obj, _, _, _) => collect_free_vars_expr_sc(obj, bound, fn_names, encl, out),\n    ERecord(_, fields, _) => {\n      let mut ri = 0\n      while ri < Array::length(fields) {\n        let (_, fval) = Array::get(fields, ri)\n        collect_free_vars_expr_sc(fval, bound, fn_names, encl, out)\n        ri = ri + 1\n      }\n      0\n    },\n    ELabeledArg(_, _, arg_expr) => collect_free_vars_expr_sc(arg_expr, bound, fn_names, encl, out),\n    _ => 0\n  }\n}\n\n/// Array-taking compatibility entry: builds the membership index per call.\n/// Fine for small fn_names (tests, perceus probes); HOT loops over the full\n/// fn+ctor table must use collect_free_vars_indexed with a prebuilt index.\nexport fn collect_free_vars(body: Expr, param_names: Array[String], fn_names: Array[String]) -> Array[String] {\n  collect_free_vars_indexed(body, param_names, sorted_names_of(fn_names))\n}\n\n/// #799 perf: index-taking entry -- the index is built ONCE per compile\n/// (linked_compile) and reused for every lambda.\nexport fn collect_free_vars_indexed(body: Expr, param_names: Array[String], fn_name_index: Array[String]) -> Array[String] {\n  collect_free_vars_indexed_sc(body, param_names, fn_name_index, common_analysis_fresh_string_array())\n}\n\n/// #1114: same, plus the ENCLOSING compile scope's local names -- a bare\n/// inlined-builtin call callee that one of those shadows must be captured,\n/// not inline-lowered. See collect_free_vars_expr's doc comment.\nfn collect_free_vars_indexed_sc(body: Expr, param_names: Array[String], fn_name_index: Array[String], encl: Array[String]) -> Array[String] {\n  let out = common_analysis_fresh_string_array()\n  // Make a mutable copy of param_names for stack-based push/truncate\n  let bound = Array::slice(param_names, 0, Array::length(param_names))\n  collect_free_vars_expr_sc(body, bound, fn_name_index, encl, out)\n  out\n}\n\n/// #875 fix 2: like collect_free_vars_indexed, but forces `self_name` (the\n/// closure's OWN `let rec NAME = (...) -> { ... }` binding name, or \"\" for\n/// \"no self-reference to force\") into the result when `body` genuinely\n/// references it as a free (lexically unshadowed) identifier -- even if\n/// `self_name` ALSO happens to collide, by bare string equality, with an\n/// unrelated entry already present in `fn_name_index` (ctx.capture_name_index,\n/// a shared whole-program name index used to skip capturing bona fide global\n/// func/ctor references).\n///\n/// Why this is needed: collect_free_vars_expr's EIdent case treats ANY name\n/// found in fn_name_index as \"resolves globally, no capture needed\" --\n/// correct when the name really is only reachable as a global, but wrong when\n/// it is ALSO the closure's own let-rec name. A `let rec check = (i) -> Bool\n/// { ... check(i + 1) ... }` closure normally captures \"check\" as a free\n/// variable precisely BECAUSE \"check\" is otherwise unknown to fn_name_index;\n/// the failure mode only appears once some unrelated top-level function\n/// (reachable via a widened whole-program-merge import graph, e.g. the\n/// compile entry file's own unqualified top-level names) happens to share the\n/// bare name \"check\". When that happens, compile_lambda's capture list\n/// silently omits the self-reference, self_cap_idx (compile_expr_tail.vibe)\n/// never fires, and the closure's own recursive call site falls through to\n/// compile_call's func-table direct-call path -- calling the unrelated global\n/// instead of itself (#875).\n///\n/// Implementation: re-run the SAME free-var walk with an EMPTY fn_name_index\n/// (so nothing is excluded as \"a global\") whenever the normal result doesn't\n/// already contain self_name -- this reuses collect_free_vars_expr's existing,\n/// well-tested lexical-shadowing logic (bound push/truncate per scope) exactly\n/// as-is, so a self_name that IS legitimately shadowed by an inner binding of\n/// the same name (e.g. a nested lambda parameter also named \"check\") is still\n/// correctly excluded, matching normal shadowing semantics. Only runs the\n/// second walk in the (rare) collision case, so the common case -- no\n/// collision, self_name already present -- costs one array-membership check.\n/// `encl` (#1114): the enclosing compile scope's local names, so a bare\n/// inlined-builtin call callee shadowed by one of them is captured instead\n/// of inline-lowered. Pass an empty array for \"no enclosing locals\".\nexport fn collect_free_vars_indexed_self(body: Expr, param_names: Array[String], fn_name_index: Array[String], self_name: String, encl: Array[String]) -> Array[String] {\n  let captures = collect_free_vars_indexed_sc(body, param_names, fn_name_index, encl)\n  if self_name == \"\" || array_contains_str(captures, self_name) {\n    captures\n  } else {\n    let no_globals = common_analysis_fresh_string_array()\n    let unfiltered = collect_free_vars_indexed_sc(body, param_names, no_globals, encl)\n    if array_contains_str(unfiltered, self_name) {\n      Array::push(captures, self_name)\n      captures\n    } else {\n      captures\n    }\n  }\n}\n\n/// The root identifier of a projection chain (EDot(...EDot(EIdent(root))...)), or\n/// \"\" if `e` is not a projection. (ADR-0055 Stage 4: shared with compile_expr_tail\n/// so function-tail param drops can detect an escaping projection of a param.)\nexport fn proj_root_ident(e: Expr) -> String {\n  match e {\n    EDot(obj, _, _, _) => proj_root_ident(obj),\n    EIdent(nm, _) => nm,\n    _ => \"\"\n  }\n}\n\n/// #1272: the borrow-returning builtins -- each hands back an INTERIOR\n/// reference into its first argument rather than a fresh value, so a scope\n/// whose tail is one of these is escaping a pointer into the container, just\n/// like `.field` does. Kept in sync with classify_let_value_heap's own\n/// hardcoded list (codegen/expr/compile_expr_tail.vibe).\nfn borrow_ret_builtin_name(nm: String) -> Bool {\n  nm == \"Array::get\" || nm == \"__index\" || nm == \"Map::get\" || nm == \"__rec_field\"\n}\n\n/// The container a borrow-returning tail reads from: an identifier, a\n/// projection chain rooted at one, or a nested borrow-returning read (an\n/// element of an element is still interior to the same root).\nfn borrow_tail_root(e: Expr) -> String {\n  match e {\n    EIdent(nm, _) => nm,\n    EDot(obj, _, _, _) => borrow_tail_root(obj),\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if Array::length(args) >= 1 && borrow_ret_builtin_name(nm) {\n        borrow_tail_root(Array::get(args, 0))\n      } else {\n        \"\"\n      },\n      _ => \"\"\n    },\n    _ => \"\"\n  }\n}\n\n/// #1272: the bare identifier a scope's tail evaluates to, or \"\". Lets\n/// scope_tail_proj_root see through a borrow that was bound to a local name\n/// and then returned (`let r = Array::get(f, 1); r`) -- the same escape as\n/// returning the read directly, just spelled with one more binding.\nfn scope_tail_ident(e: Expr) -> String {\n  match e {\n    ELet(_, _, b, _) => scope_tail_ident(b),\n    ELetMut(_, _, b, _) => scope_tail_ident(b),\n    ELetRec(_, _, b) => scope_tail_ident(b),\n    ESeq(_, b) => scope_tail_ident(b),\n    EAssign(_, _, b) => scope_tail_ident(b),\n    EAssignOp(_, _, _, b) => scope_tail_ident(b),\n    EIdent(nm, _) => nm,\n    _ => \"\"\n  }\n}\n\n/// The container root of a borrow-returning CALL, and only a call: an alias is\n/// interior to a container exactly when the value it was bound to is a\n/// borrowing read.\nfn borrow_call_root(e: Expr) -> String {\n  match e {\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if Array::length(args) >= 1 && borrow_ret_builtin_name(nm) {\n        borrow_tail_root(Array::get(args, 0))\n      } else {\n        \"\"\n      },\n      _ => \"\"\n    },\n    _ => \"\"\n  }\n}\n\n/// If the *tail* (result) expression of a scope is a projection chain, return its\n/// root identifier; otherwise \"\". Follows let/seq/assign wrappers to the tail.\n///\n/// #1272: an element read through a borrow-returning builtin counts as a\n/// projection too. Only `EDot` used to, so a scope whose tail read an element\n/// out of a container it OWNS -- `let f = [..]; Array::get(f, 1)`, or the same\n/// shape at a function tail over a heap parameter -- dropped that container\n/// without first retaining the value it was handing back. The caller received\n/// a pointer into freed memory; nothing failed until a later allocation reused\n/// the cell, so a single call looked correct and two calls returned garbage.\n/// Callers use this exclusively to decide \"dup the result before dropping the\n/// owner\", where over-reporting costs a retain (a leak at worst) and\n/// under-reporting is the use-after-free above.\nexport fn scope_tail_proj_root(e: Expr) -> String {\n  match e {\n    // #1272: `let r = <borrowing read>; .. ; r` escapes the same interior\n    // pointer as returning the read itself, so resolve the alias when the\n    // scope's tail is exactly this binding and nothing nearer matched.\n    ELet(n, v, b, _) => {\n      let inner = scope_tail_proj_root(b)\n      if inner == \"\" && scope_tail_ident(b) == n {\n        borrow_call_root(v)\n      } else {\n        inner\n      }\n    },\n    ELetMut(_, _, b, _) => scope_tail_proj_root(b),\n    ELetRec(_, _, b) => scope_tail_proj_root(b),\n    ESeq(_, b) => scope_tail_proj_root(b),\n    EAssign(_, _, b) => scope_tail_proj_root(b),\n    EAssignOp(_, _, _, b) => scope_tail_proj_root(b),\n    EDot(obj, _, _, _) => proj_root_ident(obj),\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if Array::length(args) >= 1 && borrow_ret_builtin_name(nm) {\n        borrow_tail_root(Array::get(args, 0))\n      } else {\n        \"\"\n      },\n      _ => \"\"\n    },\n    _ => \"\"\n  }\n}\n\n/// Check if a mutable variable is captured by any nested EFn in the given expression\nexport fn is_mut_captured_in(expr: Expr, name: String) -> Bool {\n  match expr {\n    EIdent(_, _) => false,\n    EInt(_) => false,\n    EBool(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EUnit => false,\n    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),\n    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),\n    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),\n    ECall(callee, args, _) => if is_mut_captured_in(callee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if is_mut_captured_in(Array::get(args, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELet(n, value, body, _) => if n == name {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    },\n    ELetRec(n, value, body) => if n == name {\n      false\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    },\n    ELetMut(n, value, body, _) => if n == name {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    },\n    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),\n    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),\n    EForIn(_, _, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMatch(scrutinee, arms) => if is_mut_captured_in(scrutinee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, i)\n        if is_mut_captured_in(arm_expr, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EFn(_, _, params, _, _, fn_body) => {\n      // Check if name is shadowed by params\n      let mut shadowed = false\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname, _) = Array::get(params, pi)\n        if pname == name {\n          shadowed = true\n        }\n        pi = pi + 1\n      }\n      if shadowed {\n        false\n      }\n      else {\n        // Check if name is free in this EFn\n        let param_names = array_empty()\n        let mut pi2 = 0\n        while pi2 < Array::length(params) {\n          let (pname2, _) = Array::get(params, pi2)\n          Array::push(param_names, pname2)\n          pi2 = pi2 + 1\n        }\n        let fv = collect_free_vars(fn_body, param_names, array_empty())\n        if array_contains_str(fv, name) {\n          true\n        }\n        else {\n          // Also check recursively for deeper nesting\n          is_mut_captured_in(fn_body, name)\n        }\n      }\n    },\n    EBreak(_) => false,\n    EContinue(_) => false,\n    EReturn(msg) => is_mut_captured_in(msg, name),\n    // #629 step 2: forms that carry sub-expressions which may hold a capturing\n    // closure. Previously these fell through to `_ => false`, so a mut captured\n    // by a closure INSIDE a struct/record literal, handler, loop, projection,\n    // labeled argument, map literal, or spread was not detected — the cell was\n    // left a stack-local and the closure captured it by value (snapshot),\n    // silently losing the shared mutation. Recursing here is always sound\n    // (over-detection only boxes more).\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if is_mut_captured_in(fval, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(entries) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(entries) {\n        let (_, mval) = Array::get(entries, i)\n        if is_mut_captured_in(mval, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EHandle(body, arms) => if is_mut_captured_in(body, name) {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, i)\n        if is_mut_captured_in(arm_expr, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELoop(params, body) => if is_mut_captured_in(body, name) {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        if is_mut_captured_in(init, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EDot(obj, _, _, _) => is_mut_captured_in(obj, name),\n    ELabeledArg(_, _, inner) => is_mut_captured_in(inner, name),\n    ESpread(inner) => is_mut_captured_in(inner, name),\n    _ => false\n  }\n}\n\n/// Region-lifetime decision for a `let mut name` cell (#629 region inference).\n/// Returns true when the cell must be heap-boxed because its region lifetime can\n/// extend beyond the binding block (a capturing closure may escape); false keeps\n/// it a plain stack-local (region = lexical block). Both backends gate boxing on\n/// this single predicate (linear compile_expr_tail / wasm-gc backend_expr).\n///\n/// Step 1 baseline: a mut captured by ANY nested closure is conservatively\n/// treated as escaping — identical to the prior `is_mut_captured_in` gate, so\n/// behavior is unchanged. Later steps refine this into a real escape analysis\n/// (a capture whose closure provably cannot escape its binding scope stays\n/// stack-local). The predicate stays conservative: when escape cannot be ruled\n/// out it returns true (box), which is always sound.\nexport fn mut_needs_ref_cell(body: Expr, name: String) -> Bool {\n  is_mut_captured_in(body, name)\n}\n\n/// Builtins whose arg0 is BORROWED (read in place, not consumed/dropped). Kept\n/// in sync with is_borrow_arg0_call in perceus/index.vibe.\nexport fn md_is_borrow_arg0_call(f: String) -> Bool {\n  f == \"__index\" || f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Array::push\" || f == \"Array::push_all\" || f == \"ArrayBuilder::push\" || f == \"MutList::push\" || f == \"StringBuilder::push\" || f == \"MapBuilder::set\" || f == \"Map::get\" || f == \"Map::keys\" || f == \"Map::has_key\" || f == \"Map::set\" || f == \"Bytes::push\" || f == \"Bytes::set\" || f == \"Bytes::get\" || f == \"Bytes::length\" || f == \"FrozenArray::get\" || f == \"FrozenArray::length\" || f == \"FixedArray::get\" || f == \"FixedArray::set\" || f == \"FixedArray::length\" || f == \"String::join\" || f == \"eq\" || f == \"__rec_field\"\n}\n\nfn md_max(a: Int, b: Int) -> Int {\n  if a > b {\n    a\n  } else {\n    b\n  }\n}\n\n/// How many times is `name` consumed (owning position) along the LONGEST control\n/// path of `e`? Used to balance the rc of a value that is referenced but NOT\n/// owned at its definition site — a matched ctor field (a borrowed view sharing\n/// the scrutinee's refcount; compile_match) or a captured free variable (a\n/// borrowed view of the defining scope's binding; compile_lambda). Each owning\n/// consume of such a value decrements a refcount it does not own, so the value\n/// must be dup'd once PER consume or it is freed more times than dup'd -> double\n/// free. Sequential children SUM; alternative children (if-branches, match/handle\n/// arms) take the MAX, so the count is an upper bound on the consumes of any\n/// executed path (>= actual everywhere -> never under-dup -> no double free;\n/// tight on straight-line code -> no over-dup leak). MUST enumerate every Expr\n/// variant (modeled on fold_expr): skipping recursion into a child could miss a\n/// real consume and wrongly suppress the dup. A bare `EIdent(name)` passed as\n/// arg0 of a borrow-arg0 builtin does not consume (it is read in place).\nexport fn md_consume_count(e: Expr, name: String) -> Int {\n  match e {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(n, _) => if n == name {\n      1\n    } else {\n      0\n    },\n    ETuple(items) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(items) {\n        acc = acc + md_consume_count(Array::get(items, i), name)\n        i = i + 1\n      }\n      acc\n    },\n    EArray(items) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(items) {\n        acc = acc + md_consume_count(Array::get(items, i), name)\n        i = i + 1\n      }\n      acc\n    },\n    ERecord(_, fields, _) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        acc = acc + md_consume_count(v, name)\n        i = i + 1\n      }\n      acc\n    },\n    EMap(fields) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        acc = acc + md_consume_count(v, name)\n        i = i + 1\n      }\n      acc\n    },\n    EIf(c, t, el) =>\n    md_consume_count(c, name) + md_max(md_consume_count(t, name), md_consume_count(el, name)),\n    ELet(_, v, b, _) => md_consume_count(v, name) + md_consume_count(b, name),\n    ELetRec(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\n    ELetMut(_, v, b, _) => md_consume_count(v, name) + md_consume_count(b, name),\n    EAssign(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\n    EAssignOp(_, _, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\n    ESeq(a, b) => md_consume_count(a, name) + md_consume_count(b, name),\n    EMatch(s, arms) => {\n      let mut mx = 0\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, v) = Array::get(arms, i)\n        mx = md_max(mx, md_consume_count(v, name))\n        i = i + 1\n      }\n      // A bare `match name { .. }` BORROWS the scrutinee (its fields become\n      // borrowed views reclaimed by the owner's recursive drop); it does not\n      // consume `name`. Counting it as a consume would over-dup a re-matched\n      // borrowed tail (e.g. deeply-nested `match restN`), leaking/corrupting\n      // the chain. A non-ident scrutinee may still consume `name` in a\n      // sub-expression, so recurse there.\n      let scr = match s {\n        EIdent(_, _) => 0,\n        _ => md_consume_count(s, name)\n      }\n      scr + mx\n    },\n    EHandle(s, arms) => {\n      let mut mx = 0\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, v) = Array::get(arms, i)\n        mx = md_max(mx, md_consume_count(v, name))\n        i = i + 1\n      }\n      let scr = match s {\n        EIdent(_, _) => 0,\n        _ => md_consume_count(s, name)\n      }\n      scr + mx\n    },\n    EWhile(c, b) => md_consume_count(c, name) + md_consume_count(b, name),\n    ELoop(params, b) => {\n      let mut acc = md_consume_count(b, name)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, v) = Array::get(params, i)\n        acc = acc + md_consume_count(v, name)\n        i = i + 1\n      }\n      acc\n    },\n    EForIn(_, _, it, b) => md_consume_count(it, name) + md_consume_count(b, name),\n    ECall(callee, args, _) => {\n      let borrow0 = match callee {\n        EIdent(f, _) => md_is_borrow_arg0_call(f),\n        _ => false\n      }\n      let start = if borrow0 && Array::length(args) >= 1 {\n        1\n      } else {\n        0\n      }\n      let head = if start == 1 {\n        match Array::get(args, 0) {\n          EIdent(_, _) => 0,\n          _ => md_consume_count(Array::get(args, 0), name)\n        }\n      } else {\n        0\n      }\n      // A bare-ident CALLEE is invoked, not consumed — calling a function or a\n      // captured closure (incl. a recursive closure's own self-reference) does\n      // not drop it. Counting `f(..)` as a consume of `f` over-dups the captured\n      // closure once per call (#705: a nested self-recursive closure's self-\n      // capture corrupted under RC). Only a non-ident callee can consume `name`\n      // in a sub-expression.\n      let callee_c = match callee {\n        EIdent(_, _) => 0,\n        _ => md_consume_count(callee, name)\n      }\n      let mut acc = callee_c + head\n      let mut ri = start\n      while ri < Array::length(args) {\n        acc = acc + md_consume_count(Array::get(args, ri), name)\n        ri = ri + 1\n      }\n      acc\n    },\n    EBinOp(_, l, r) => md_consume_count(l, name) + md_consume_count(r, name),\n    EUnaryOp(_, x) => md_consume_count(x, name),\n    EFn(_, _, _, _, _, body) => md_consume_count(body, name),\n    EDot(x, _, _, _) => md_consume_count(x, name),\n    ELabeledArg(_, _, v) => md_consume_count(v, name),\n    EReturn(x) => md_consume_count(x, name),\n    EBreak(opt) => match opt {\n      Some(v) => md_consume_count(v, name),\n      None => 0\n    },\n    EContinue(args) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(args) {\n        acc = acc + md_consume_count(Array::get(args, i), name)\n        i = i + 1\n      }\n      acc\n    },\n    ESpread(x) => md_consume_count(x, name)\n  }\n}\n\n//# ADR-0091 zero_alloc (Phase 1)\n\n/// Builtins allowed inside a `@zero_alloc` fn: reads and in-place writes\n/// that never touch the allocator. Everything else callable is treated as\n/// potentially allocating (conservative Phase 1 default).\nfn za_safe_builtin(f: String) -> Bool {\n  f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Bytes::get\" || f == \"Bytes::set\" || f == \"Bytes::length\" || f == \"String::length\" || f == \"String::char_code_at\" || f == \"FrozenArray::get\" || f == \"FrozenArray::length\" || f == \"FixedArray::get\" || f == \"FixedArray::set\" || f == \"FixedArray::length\" || f == \"assert\" || f == \"not\"\n}\n\nfn za_first(a: String, b: String) -> String {\n  if a != \"\" {\n    a\n  } else {\n    b\n  }\n}\n\n/// Extract plain binder names from an EFn parameter list, stripping the\n/// `~`/`?` label-sugar suffix (the call-site spelling binds the bare name).\nfn za_param_names(ps: Array[(String, Option[TypeExpr])]) -> Array[String] {\n  let out = array_empty()\n  let mut pi = 0\n  while pi < Array::length(ps) {\n    let (raw, _) = Array::get(ps, pi)\n    let rl = String::length(raw)\n    let stripped = if rl > 0 {\n      let lc = String::char_code_at(raw, rl - 1)\n      if lc == '~' || lc == '?' {\n        raw[0: rl - 1]\n      } else {\n        raw\n      }\n    } else {\n      raw\n    }\n    Array::push(out, stripped)\n    pi = pi + 1\n  }\n  out\n}\n\n/// Walk an expression under `@zero_alloc` and return \"\" when it is proven\n/// allocation-free, else a description of the first allocation site found.\n/// Conservative Phase 1 (ADR-0091): constructors, container/closure/string\n/// literals, float literals (heap-boxed on the linear backend), effect\n/// handlers, and any call not on the safe-builtin list or resolvable to a\n/// proven-clean top-level fn are all rejected. Known accepted gap: binary\n/// operators are type-blind here, so `+` on String/Double-typed VARIABLES\n/// (which lowers to an allocating concat / a boxing op) is not caught --\n/// only literal operands are.\nfn za_walk(e: Expr, ctors: Array[String], fn_names: Array[String], fn_bodies: Array[Expr], fn_params: Array[Array[String]], visited: Array[String], bound: Array[String]) -> String {\n  match e {\n    EInt(_) => \"\",\n    EFloat(_) => \"float literal (heap-boxed on the linear backend)\",\n    EString(_) => \"\",\n    EBool(_) => \"\",\n    EIdent(id, _) => if array_contains_str(bound, id) {\n      \"\"\n    } else if array_contains_str(ctors, id) {\n      String::concat(\"constructor '\", String::concat(id, \"'\"))\n    } else {\n      \"\"\n    },\n    ETuple(items) => {\n      let _ = items\n      \"tuple literal\"\n    },\n    EArray(_) => \"array literal\",\n    ERecord(_, _, _) => \"record/struct literal\",\n    EMap(_) => \"map literal\",\n    EStringInterp(_) => \"string interpolation\",\n    EFn(_, _, _, _, _, _) => \"closure literal (allocates its environment)\",\n    EIf(zc, zt, zf) => za_first(za_walk(zc, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_first(za_walk(zt, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zf, ctors, fn_names, fn_bodies, fn_params, visited, bound))),\n    ELet(zl_name, zv, zb, _) => {\n      Array::push(bound, zl_name)\n      za_first(za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound))\n    },\n    ELetRec(zlr_name, zv, zb) => {\n      Array::push(bound, zlr_name)\n      za_first(za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound))\n    },\n    ELetMut(zlm_name, zv, zb, _) => {\n      Array::push(bound, zlm_name)\n      za_first(za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound))\n    },\n    EAssign(_, zv, zb) => za_first(za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound)),\n    EAssignOp(_, _, zv, zb) => za_first(za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound)),\n    ESeq(za, zb) => za_first(za_walk(za, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound)),\n    EMatch(scr, arms) => {\n      let mut r = za_walk(scr, ctors, fn_names, fn_bodies, fn_params, visited, bound)\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (arm_pat, arm_body) = Array::get(arms, ai)\n        let _ = collect_pattern_bindings(arm_pat, bound)\n        if r == \"\" {\n          r = za_walk(arm_body, ctors, fn_names, fn_bodies, fn_params, visited, bound)\n        } else {\n          ()\n        }\n        ai = ai + 1\n      }\n      r\n    },\n    EHandle(_, _) => \"effect handler (allocates evidence)\",\n    EWhile(zc, zb) => za_first(za_walk(zc, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound)),\n    ELoop(inits, zb) => {\n      let mut r = \"\"\n      let mut li = 0\n      while li < Array::length(inits) {\n        let (zloop_name, init_e) = Array::get(inits, li)\n        Array::push(bound, zloop_name)\n        if r == \"\" {\n          r = za_walk(init_e, ctors, fn_names, fn_bodies, fn_params, visited, bound)\n        } else {\n          ()\n        }\n        li = li + 1\n      }\n      za_first(r, za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound))\n    },\n    EForIn(zfi_name, zfi_snd, zsrc, zb) => {\n      Array::push(bound, zfi_name)\n      match zfi_snd {\n        Some(zfi_n2) => Array::push(bound, zfi_n2),\n        None => ()\n      }\n      za_first(za_walk(zsrc, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound))\n    },\n    ECall(callee, cargs, _) => {\n      let mut r = \"\"\n      let mut ci = 0\n      while ci < Array::length(cargs) {\n        if r == \"\" {\n          r = za_walk(Array::get(cargs, ci), ctors, fn_names, fn_bodies, fn_params, visited, bound)\n        } else {\n          ()\n        }\n        ci = ci + 1\n      }\n      if r != \"\" {\n        r\n      } else {\n        match callee {\n          // #1274 Codex P1: a param or local shadowing a top-level fn is an\n          // INDIRECT callee -- the supplied implementation may allocate, so\n          // name-only fn_names resolution must not see it.\n          EIdent(cname, _) => if array_contains_str(bound, cname) {\n            String::concat(\"call through local binding '\", String::concat(cname, \"' (not proven allocation-free)\"))\n          } else if array_contains_str(ctors, cname) {\n            String::concat(\"constructor '\", String::concat(cname, \"'\"))\n          } else if za_safe_builtin(cname) {\n            \"\"\n          } else {\n            let mut fi = 0\n            let mut fidx = 0 - 1\n            while fi < Array::length(fn_names) {\n              if Array::get(fn_names, fi) == cname {\n                fidx = fi\n                fi = Array::length(fn_names)\n              } else {\n                fi = fi + 1\n              }\n            }\n            if fidx >= 0 {\n              if array_contains_str(visited, cname) {\n                \"\"\n              } else {\n                Array::push(visited, cname)\n                // Fresh scope for the callee: its own params are its only\n                // lexical bindings (the caller's do not leak in).\n                let callee_bound = array_empty()\n                let callee_ps = Array::get(fn_params, fidx)\n                let mut cbi = 0\n                while cbi < Array::length(callee_ps) {\n                  Array::push(callee_bound, Array::get(callee_ps, cbi))\n                  cbi = cbi + 1\n                }\n                let inner = za_walk(Array::get(fn_bodies, fidx), ctors, fn_names, fn_bodies, fn_params, visited, callee_bound)\n                if inner == \"\" {\n                  \"\"\n                } else {\n                  String::concat(\"call to '\", String::concat(cname, String::concat(\"' which may allocate: \", inner)))\n                }\n              }\n            } else {\n              String::concat(\"call to '\", String::concat(cname, \"' (not proven allocation-free)\"))\n            }\n          },\n          _ => \"indirect call (not proven allocation-free)\"\n        }\n      }\n    },\n    EBinOp(_, za, zb) => za_first(za_walk(za, ctors, fn_names, fn_bodies, fn_params, visited, bound), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound)),\n    EUnaryOp(_, za) => za_walk(za, ctors, fn_names, fn_bodies, fn_params, visited, bound),\n    EDot(zobj, _, _, _) => za_walk(zobj, ctors, fn_names, fn_bodies, fn_params, visited, bound),\n    ELabeledArg(_, _, zv) => za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound),\n    EReturn(zv) => za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound),\n    EBreak(zo) => match zo {\n      Some(zv) => za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound),\n      None => \"\"\n    },\n    EContinue(zvs) => {\n      let mut r = \"\"\n      let mut vi = 0\n      while vi < Array::length(zvs) {\n        if r == \"\" {\n          r = za_walk(Array::get(zvs, vi), ctors, fn_names, fn_bodies, fn_params, visited, bound)\n        } else {\n          ()\n        }\n        vi = vi + 1\n      }\n      r\n    },\n    ESpread(zv) => za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound),\n    EUnit => \"\"\n  }\n}\n\n/// ADR-0091 Phase 1: enforce `@zero_alloc` markers. The attribute lexes as\n/// the single ident token `@zero_alloc`, parses as a top-level `SExpr`\n/// statement (which the linear backend drops), and must IMMEDIATELY precede\n/// the `fn` declaration it marks (lowered form: `SLet(_, _, name, _,\n/// EFn(..))`). Returns \"\" when every marked fn is proven allocation-free,\n/// else a `zero_alloc:`-prefixed diagnostic. Top-level fns only (module\n/// bodies are out of scope for this slice); linear backend only.\nexport fn zero_alloc_check(stmts: Array[Stmt]) -> String {\n  let fn_names = array_empty()\n  let fn_bodies = array_empty()\n  let fn_params = array_empty()\n  let ctors = array_empty()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SLet(_, _, lname, _, lval) => match lval {\n        EFn(_, _, efn_params, _, _, fb) => {\n          Array::push(fn_names, lname)\n          Array::push(fn_bodies, fb)\n          Array::push(fn_params, za_param_names(efn_params))\n        },\n        _ => ()\n      },\n      SEnum(_, _, _, variants, _) => {\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, _) = Array::get(variants, vi)\n          Array::push(ctors, vname)\n          vi = vi + 1\n        }\n      },\n      SSuberror(_, _, sub_variants) => {\n        let mut vi2 = 0\n        while vi2 < Array::length(sub_variants) {\n          let (vname2, _) = Array::get(sub_variants, vi2)\n          Array::push(ctors, vname2)\n          vi2 = vi2 + 1\n        }\n      },\n      SStruct(_, sname, _, _, _, _) => Array::push(ctors, sname),\n      _ => ()\n    }\n    si = si + 1\n  }\n  let mut msg = \"\"\n  let mut mi = 0\n  while mi < Array::length(stmts) {\n    let is_marker = match Array::get(stmts, mi) {\n      SExpr(me) => match me {\n        EIdent(mname, _) => mname == \"@zero_alloc\",\n        _ => false\n      },\n      _ => false\n    }\n    if is_marker && msg == \"\" {\n      let target_name = if mi + 1 < Array::length(stmts) {\n        match Array::get(stmts, mi + 1) {\n          SLet(_, _, tname, _, tval) => match tval {\n            EFn(_, _, _, _, _, _) => tname,\n            _ => \"\"\n          },\n          _ => \"\"\n        }\n      } else {\n        \"\"\n      }\n      if target_name == \"\" {\n        msg = \"zero_alloc: '@zero_alloc' must immediately precede a fn declaration\"\n      } else {\n        let mut fi2 = 0\n        let mut fidx2 = 0 - 1\n        while fi2 < Array::length(fn_names) {\n          if Array::get(fn_names, fi2) == target_name {\n            fidx2 = fi2\n            fi2 = Array::length(fn_names)\n          } else {\n            fi2 = fi2 + 1\n          }\n        }\n        if fidx2 >= 0 {\n          let visited = array_empty()\n          Array::push(visited, target_name)\n          let seed_bound = array_empty()\n          let seed_ps = Array::get(fn_params, fidx2)\n          let mut sbi = 0\n          while sbi < Array::length(seed_ps) {\n            Array::push(seed_bound, Array::get(seed_ps, sbi))\n            sbi = sbi + 1\n          }\n          let r = za_walk(Array::get(fn_bodies, fidx2), ctors, fn_names, fn_bodies, fn_params, visited, seed_bound)\n          if r != \"\" {\n            msg = String::concat(\"zero_alloc: fn '\", String::concat(target_name, String::concat(\"' may allocate: \", r)))\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n      }\n    } else {\n      ()\n    }\n    mi = mi + 1\n  }\n  msg\n}\n\n//# ADR-0092 borrow-inference slice 1: per-fn borrowed arg0\n\n/// Collect every top-level-fn name used as a VALUE (a bare ident in any\n/// non-callee position) anywhere under `e`. A fn that only ever appears as\n/// the direct callee of a call can safely change its arg0 ABI; one that is\n/// aliased, passed, stored, captured, or returned cannot (indirect call\n/// sites cannot consult the borrow set).\nfn ca_collect_valued_idents(e: Expr, out: Array[String]) -> Int {\n  match e {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(vn, _) => {\n      Array::push(out, vn)\n      0\n    },\n    ECall(callee, cargs, _) => {\n      match callee {\n        EIdent(_, _) => 0,\n        _ => ca_collect_valued_idents(callee, out)\n      }\n      let mut ci = 0\n      while ci < Array::length(cargs) {\n        let _ = ca_collect_valued_idents(Array::get(cargs, ci), out)\n        ci = ci + 1\n      }\n      0\n    },\n    ETuple(items) => ca_collect_valued_list(items, out),\n    EArray(items) => ca_collect_valued_list(items, out),\n    ERecord(_, rfields, _) => {\n      let mut ri = 0\n      while ri < Array::length(rfields) {\n        let (_, rv) = Array::get(rfields, ri)\n        let _ = ca_collect_valued_idents(rv, out)\n        ri = ri + 1\n      }\n      0\n    },\n    EMap(mfields) => {\n      let mut mi = 0\n      while mi < Array::length(mfields) {\n        let (_, mv) = Array::get(mfields, mi)\n        let _ = ca_collect_valued_idents(mv, out)\n        mi = mi + 1\n      }\n      0\n    },\n    EIf(c0, t0, f0) => {\n      let _ = ca_collect_valued_idents(c0, out)\n      let _ = ca_collect_valued_idents(t0, out)\n      ca_collect_valued_idents(f0, out)\n    },\n    ELet(_, v0, b0, _) => {\n      let _ = ca_collect_valued_idents(v0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    ELetRec(_, v0, b0) => {\n      let _ = ca_collect_valued_idents(v0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    ELetMut(_, v0, b0, _) => {\n      let _ = ca_collect_valued_idents(v0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    EAssign(_, v0, b0) => {\n      let _ = ca_collect_valued_idents(v0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    EAssignOp(_, _, v0, b0) => {\n      let _ = ca_collect_valued_idents(v0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    ESeq(a0, b0) => {\n      let _ = ca_collect_valued_idents(a0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    EMatch(scr, arms) => {\n      let _ = ca_collect_valued_idents(scr, out)\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, ab) = Array::get(arms, ai)\n        let _ = ca_collect_valued_idents(ab, out)\n        ai = ai + 1\n      }\n      0\n    },\n    EHandle(hb, harms) => {\n      let _ = ca_collect_valued_idents(hb, out)\n      let mut hi = 0\n      while hi < Array::length(harms) {\n        let (_, hab) = Array::get(harms, hi)\n        let _ = ca_collect_valued_idents(hab, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EWhile(c0, b0) => {\n      let _ = ca_collect_valued_idents(c0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    ELoop(inits, b0) => {\n      let mut li = 0\n      while li < Array::length(inits) {\n        let (_, iv) = Array::get(inits, li)\n        let _ = ca_collect_valued_idents(iv, out)\n        li = li + 1\n      }\n      ca_collect_valued_idents(b0, out)\n    },\n    EForIn(_, _, s0, b0) => {\n      let _ = ca_collect_valued_idents(s0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    EBinOp(_, a0, b0) => {\n      let _ = ca_collect_valued_idents(a0, out)\n      ca_collect_valued_idents(b0, out)\n    },\n    EUnaryOp(_, a0) => ca_collect_valued_idents(a0, out),\n    EFn(_, _, _, _, _, fb) => ca_collect_valued_idents(fb, out),\n    EDot(o0, _, _, _) => ca_collect_valued_idents(o0, out),\n    ELabeledArg(_, _, v0) => ca_collect_valued_idents(v0, out),\n    EReturn(v0) => ca_collect_valued_idents(v0, out),\n    EBreak(bo) => match bo {\n      Some(bv) => ca_collect_valued_idents(bv, out),\n      None => 0\n    },\n    EContinue(cvs) => ca_collect_valued_list(cvs, out),\n    ESpread(sv) => ca_collect_valued_idents(sv, out)\n  }\n}\n\nfn ca_collect_valued_list(items: Array[Expr], out: Array[String]) -> Int {\n  let mut i = 0\n  while i < Array::length(items) {\n    let _ = ca_collect_valued_idents(Array::get(items, i), out)\n    i = i + 1\n  }\n  0\n}\n\nfn ca_walk_stmts_valued(stmts: Array[Stmt], out: Array[String]) -> Int {\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SLet(_, _, _, _, lv) => {\n        let _ = ca_collect_valued_idents(lv, out)\n        0\n      },\n      SLetMut(_, _, lv) => {\n        let _ = ca_collect_valued_idents(lv, out)\n        0\n      },\n      SLetPat(_, lv) => {\n        let _ = ca_collect_valued_idents(lv, out)\n        0\n      },\n      SExpr(se) => {\n        let _ = ca_collect_valued_idents(se, out)\n        0\n      },\n      STest(_, tb) => {\n        let _ = ca_collect_valued_idents(tb, out)\n        0\n      },\n      SBench(_, bb) => {\n        let _ = ca_collect_valued_idents(bb, out)\n        0\n      },\n      SModule(_, _, mb) => ca_walk_stmts_valued(mb, out),\n      _ => 0\n    }\n    si = si + 1\n  }\n  0\n}\n\n/// Callee names that somewhere receive a NON-IDENT first argument. A\n/// borrow-arg0 callee never drops its param0 (the epilogue drop is\n/// filtered program-wide in linked_compile), and the call-emission borrow\n/// check is shape-independent, so a fresh temporary passed directly at\n/// arg0 -- `ignore_children(Node(Leaf(i), Leaf(j)))` in the RC\n/// reclamation gate fixture -- would be released by NOBODY: the caller\n/// has no binding to scope-drop and the callee's drop is gone (one leak\n/// per call; compiler-gate 40d catches it at N=20000). Such fns must\n/// keep the owned ABI, so collect every callee name with a non-ident\n/// arg0 anywhere and disqualify it.\nfn ca_collect_nonident_arg0(e: Expr, out: Array[String]) -> Int {\n  match e {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(_, _) => 0,\n    ECall(callee, cargs, _) => {\n      match callee {\n        EIdent(cf, _) => if Array::length(cargs) >= 1 {\n          match Array::get(cargs, 0) {\n            EIdent(_, _) => (),\n            _ => Array::push(out, cf)\n          }\n        } else {\n          ()\n        },\n        _ => {\n          let _ = ca_collect_nonident_arg0(callee, out)\n          ()\n        }\n      }\n      let mut ci = 0\n      while ci < Array::length(cargs) {\n        let _ = ca_collect_nonident_arg0(Array::get(cargs, ci), out)\n        ci = ci + 1\n      }\n      0\n    },\n    ETuple(items) => ca_collect_nonident_arg0_list(items, out),\n    EArray(items) => ca_collect_nonident_arg0_list(items, out),\n    ERecord(_, rfields, _) => {\n      let mut ri = 0\n      while ri < Array::length(rfields) {\n        let (_, rv) = Array::get(rfields, ri)\n        let _ = ca_collect_nonident_arg0(rv, out)\n        ri = ri + 1\n      }\n      0\n    },\n    EMap(mfields) => {\n      let mut mi = 0\n      while mi < Array::length(mfields) {\n        let (_, mv) = Array::get(mfields, mi)\n        let _ = ca_collect_nonident_arg0(mv, out)\n        mi = mi + 1\n      }\n      0\n    },\n    EIf(c0, t0, f0) => {\n      let _ = ca_collect_nonident_arg0(c0, out)\n      let _ = ca_collect_nonident_arg0(t0, out)\n      ca_collect_nonident_arg0(f0, out)\n    },\n    ELet(_, v0, b0, _) => {\n      let _ = ca_collect_nonident_arg0(v0, out)\n      ca_collect_nonident_arg0(b0, out)\n    },\n    ELetRec(_, v0, b0) => {\n      let _ = ca_collect_nonident_arg0(v0, out)\n      ca_collect_nonident_arg0(b0, out)\n    },\n    ELetMut(_, v0, b0, _) => {\n      let _ = ca_collect_nonident_arg0(v0, out)\n      ca_collect_nonident_arg0(b0, out)\n    },\n    EAssign(_, v0, b0) => {\n      let _ = ca_collect_nonident_arg0(v0, out)\n      ca_collect_nonident_arg0(b0, out)\n    },\n    EAssignOp(_, _, v0, b0) => {\n      let _ = ca_collect_nonident_arg0(v0, out)\n      ca_collect_nonident_arg0(b0, out)\n    },\n    ESeq(a0, b0) => {\n      let _ = ca_collect_nonident_arg0(a0, out)\n      ca_collect_nonident_arg0(b0, out)\n    },\n    EMatch(scr, arms) => {\n      let _ = ca_collect_nonident_arg0(scr, out)\n      let mut ai = 0\n      while ai < Array::length(arms) {\n        let (_, ab) = Array::get(arms, ai)\n        let _ = ca_collect_nonident_arg0(ab, out)\n        ai = ai + 1\n      }\n      0\n    },\n    EHandle(hb, harms) => {\n      let _ = ca_collect_nonident_arg0(hb, out)\n      let mut hi = 0\n      while hi < Array::length(harms) {\n        let (_, hab) = Array::get(harms, hi)\n        let _ = ca_collect_nonident_arg0(hab, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EWhile(c0, b0) => {\n      let _ = ca_collect_nonident_arg0(c0, out)\n      ca_collect_nonident_arg0(b0, out)\n    },\n    ELoop(inits, b0) => {\n      let mut li = 0\n      while li < Array::length(inits) {\n        let (_, iv) = Array::get(inits, li)\n        let _ = ca_collect_nonident_arg0(iv, out)\n        li = li + 1\n      }\n      ca_collect_nonident_arg0(b0, out)\n    },\n    EForIn(_, _, s0, b0) => {\n      let _ = ca_collect_nonident_arg0(s0, out)\n      ca_collect_nonident_arg0(b0, out)\n    },\n    EBinOp(_, a0, b0) => {\n      let _ = ca_collect_nonident_arg0(a0, out)\n      ca_collect_nonident_arg0(b0, out)\n    },\n    EUnaryOp(_, a0) => ca_collect_nonident_arg0(a0, out),\n    EFn(_, _, _, _, _, fb) => ca_collect_nonident_arg0(fb, out),\n    EDot(o0, _, _, _) => ca_collect_nonident_arg0(o0, out),\n    ELabeledArg(_, _, v0) => ca_collect_nonident_arg0(v0, out),\n    EReturn(v0) => ca_collect_nonident_arg0(v0, out),\n    EBreak(bo) => match bo {\n      Some(bv) => ca_collect_nonident_arg0(bv, out),\n      None => 0\n    },\n    EContinue(cvs) => ca_collect_nonident_arg0_list(cvs, out),\n    ESpread(sv) => ca_collect_nonident_arg0(sv, out)\n  }\n}\n\nfn ca_collect_nonident_arg0_list(items: Array[Expr], out: Array[String]) -> Int {\n  let mut i = 0\n  while i < Array::length(items) {\n    let _ = ca_collect_nonident_arg0(Array::get(items, i), out)\n    i = i + 1\n  }\n  0\n}\n\nfn ca_walk_stmts_nonident_arg0(stmts: Array[Stmt], out: Array[String]) -> Int {\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SLet(_, _, _, _, lv) => {\n        let _ = ca_collect_nonident_arg0(lv, out)\n        0\n      },\n      SLetMut(_, _, lv) => {\n        let _ = ca_collect_nonident_arg0(lv, out)\n        0\n      },\n      SLetPat(_, lv) => {\n        let _ = ca_collect_nonident_arg0(lv, out)\n        0\n      },\n      SExpr(se) => {\n        let _ = ca_collect_nonident_arg0(se, out)\n        0\n      },\n      STest(_, tb) => {\n        let _ = ca_collect_nonident_arg0(tb, out)\n        0\n      },\n      SBench(_, bb) => {\n        let _ = ca_collect_nonident_arg0(bb, out)\n        0\n      },\n      SModule(_, _, mb) => ca_walk_stmts_nonident_arg0(mb, out),\n      _ => 0\n    }\n    si = si + 1\n  }\n  0\n}\n\n/// ADR-0092 borrow-inference slice 1: top-level fns whose FIRST param is\n/// only ever read. For such a fn the arg0 ABI flips to borrowed, program-\n/// wide and in lockstep: the caller's plan counts an ident arg0 as a free\n/// borrow (no transfer dup) and the callee's plan-site drop for that param\n/// is skipped (linked_compile). Eligibility, all conservative:\n///   - the fn is a top-level `SLet` + `EFn` with >= 1 param\n///   - param0's consume count in the body is 0 (only borrow-position uses:\n///     projections, borrow-arg0 builtin calls -- md_consume_count)\n///   - param0 is not mut-captured by an inner closure\n///   - the fn body does not shadow param0 (a rebinding would make the\n///     consume count unreliable) -- approximated by md_consume_count only,\n///     which counts ANY bare mention; a shadowed rebind's value read would\n///     count as a consume and disqualify the fn\n///   - the fn name is never used as a value anywhere in the program\n///     (indirect call sites cannot consult this set)\n///   - the fn is never called with a NON-IDENT first argument anywhere\n///     (ca_collect_nonident_arg0 -- a fresh temp at a borrowed arg0 has\n///     no owner left to release it)\n/// The caller must additionally exclude the program entry (invoked by the\n/// host, which cannot consult the set either).\nexport fn compute_borrow_arg0_user_fns(stmts: Array[Stmt]) -> Array[String] {\n  let valued = array_empty()\n  let _ = ca_walk_stmts_valued(stmts, valued)\n  let nonident0 = array_empty()\n  let _ = ca_walk_stmts_nonident_arg0(stmts, nonident0)\n  let out = array_empty()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SLet(_, _, fname, _, fval) => match fval {\n        EFn(_, _, fps, _, _, fbody) => if Array::length(fps) >= 1 {\n          let (p0_raw, _) = Array::get(fps, 0)\n          let p0l = String::length(p0_raw)\n          let p0 = if p0l > 0 {\n            let p0c = String::char_code_at(p0_raw, p0l - 1)\n            if p0c == '~' || p0c == '?' {\n              p0_raw[0: p0l - 1]\n            } else {\n              p0_raw\n            }\n          } else {\n            p0_raw\n          }\n          if p0 != \"\" && md_consume_count(fbody, p0) == 0 && !is_mut_captured_in(fbody, p0) && !array_contains_str(valued, fname) && !array_contains_str(nonident0, fname) {\n            Array::push(out, fname)\n          } else {\n            ()\n          }\n        } else {\n          ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  out\n}\n\n//# ADR-0092 borrow-inference: may-return-view analysis\n\n/// True when `name` is provably bound to a FRESH (owned) value: it was\n/// classified fresh at its binding and no assignment tainted it since.\nfn mrv_is_fresh_name(fresh_names: Array[String], tainted: Array[String], name: String) -> Bool {\n  array_contains_str(fresh_names, name) && !array_contains_str(tainted, name)\n}\n\n/// Value classification for compute_may_return_view_fns: does `e` evaluate\n/// to a provably FRESH/owned value (true), or might it be an unowned\n/// interior view (false)? Conservative toward view: only literals, ctor\n/// calls, container/closure literals, operators, and calls to\n/// known-fresh-returning functions classify fresh; identifiers resolve\n/// fresh only through let-chains of fresh values (params, globals, match\n/// payload bindings, and borrow-returning builtin results never do).\n///\n/// The walk doubles as the taint collector, so it MUST recurse into every\n/// child (modeled on md_consume_count's completeness): let/letmut bindings\n/// record their freshness in `fresh_names`, mut assignments with a\n/// non-fresh RHS push the target onto `tainted`, every binder (params are\n/// pushed by the caller) lands in `bound` so a call through a local\n/// closure is never mistaken for a fresh builtin call, and `EReturn` of a\n/// non-fresh value sets `ret_view[0]` (an early return is a tail).\n/// Bindings are recorded flat (no scope popping): a name REBOUND to a\n/// non-fresh value taints itself, so collisions only ever push toward\n/// view -- the safe direction.\nfn mrv_fresh(e: Expr, fresh_names: Array[String], tainted: Array[String], bound: Array[String], user_fns: Array[String], view_set: Array[String], ret_view: Array[Int]) -> Bool {\n  match e {\n    EInt(_) => true,\n    EFloat(_) => true,\n    EString(_) => true,\n    EBool(_) => true,\n    EUnit => true,\n    EStringInterp(_) => true,\n    EIdent(n, _) => mrv_is_fresh_name(fresh_names, tainted, n),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        let _ = mrv_fresh(Array::get(items, i), fresh_names, tainted, bound, user_fns, view_set, ret_view)\n        i = i + 1\n      }\n      true\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        let _ = mrv_fresh(Array::get(items, i), fresh_names, tainted, bound, user_fns, view_set, ret_view)\n        i = i + 1\n      }\n      true\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        let _ = mrv_fresh(v, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n        i = i + 1\n      }\n      true\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        let _ = mrv_fresh(v, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n        i = i + 1\n      }\n      true\n    },\n    EIf(c, t, el) => {\n      let _ = mrv_fresh(c, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      let tf = mrv_fresh(t, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      let ef = mrv_fresh(el, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      tf && ef\n    },\n    ELet(n, v, b, _) => {\n      let vf = mrv_fresh(v, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      Array::push(bound, n)\n      if vf {\n        Array::push(fresh_names, n)\n      } else {\n        Array::push(tainted, n)\n      }\n      mrv_fresh(b, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n    },\n    ELetMut(n, v, b, _) => {\n      let vf = mrv_fresh(v, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      Array::push(bound, n)\n      if vf {\n        Array::push(fresh_names, n)\n      } else {\n        Array::push(tainted, n)\n      }\n      mrv_fresh(b, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n    },\n    ELetRec(n, v, b) => {\n      let _ = mrv_fresh(v, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      Array::push(bound, n)\n      Array::push(fresh_names, n)\n      mrv_fresh(b, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n    },\n    EAssign(n, v, b) => {\n      let vf = mrv_fresh(v, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      if vf {\n        ()\n      } else {\n        Array::push(tainted, n)\n      }\n      mrv_fresh(b, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n    },\n    EAssignOp(_, _, v, b) => {\n      let _ = mrv_fresh(v, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      mrv_fresh(b, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n    },\n    ESeq(a, b) => {\n      let _ = mrv_fresh(a, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      mrv_fresh(b, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n    },\n    EMatch(s, arms) => {\n      let _ = mrv_fresh(s, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      let mut all = true\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, v) = Array::get(arms, i)\n        // Pattern payloads are interior views of the scrutinee: bound but\n        // never fresh.\n        let _ = collect_pattern_bindings(p, bound)\n        if mrv_fresh(v, fresh_names, tainted, bound, user_fns, view_set, ret_view) {\n          ()\n        } else {\n          all = false\n        }\n        i = i + 1\n      }\n      all\n    },\n    EHandle(s, arms) => {\n      let _ = mrv_fresh(s, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      let mut all = true\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, v) = Array::get(arms, i)\n        let _ = collect_pattern_bindings(p, bound)\n        if mrv_fresh(v, fresh_names, tainted, bound, user_fns, view_set, ret_view) {\n          ()\n        } else {\n          all = false\n        }\n        i = i + 1\n      }\n      all\n    },\n    EWhile(c, b) => {\n      let _ = mrv_fresh(c, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      let _ = mrv_fresh(b, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      true\n    },\n    ELoop(params, b) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, pv) = Array::get(params, i)\n        let _ = mrv_fresh(pv, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n        Array::push(bound, pn)\n        i = i + 1\n      }\n      let _ = mrv_fresh(b, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      // A loop's value flows out of `break v` sites we do not track: view.\n      false\n    },\n    EForIn(n1, n2, it, b) => {\n      let _ = mrv_fresh(it, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      Array::push(bound, n1)\n      match n2 {\n        Some(n2s) => Array::push(bound, n2s),\n        None => ()\n      }\n      let _ = mrv_fresh(b, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      true\n    },\n    ECall(callee, args, _) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        let _ = mrv_fresh(Array::get(args, i), fresh_names, tainted, bound, user_fns, view_set, ret_view)\n        i = i + 1\n      }\n      match callee {\n        EIdent(f, _) => if array_contains_str(bound, f) {\n          // A locally-bound closure: its return is untrackable.\n          false\n        } else if array_contains_str(user_fns, f) {\n          !array_contains_str(view_set, f)\n        } else if borrow_ret_builtin_name(f) {\n          false\n        } else {\n          // Ctor application or a fresh-returning builtin. (A ctor name is\n          // uppercase, but a non-view builtin returns fresh too, so the\n          // distinction does not matter here.)\n          true\n        },\n        _ => {\n          let _ = mrv_fresh(callee, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n          false\n        }\n      }\n    },\n    EBinOp(_, l, r) => {\n      let _ = mrv_fresh(l, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      let _ = mrv_fresh(r, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      true\n    },\n    EUnaryOp(_, x) => {\n      let _ = mrv_fresh(x, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      true\n    },\n    EFn(_, _, fps, _, _, body) => {\n      // A closure literal is a fresh value; its body can still taint\n      // captured muts, so walk it -- but ITS early returns are not the\n      // enclosing function's (dummy ret cell).\n      let mut i = 0\n      while i < Array::length(fps) {\n        let (pn, _) = Array::get(fps, i)\n        Array::push(bound, pn)\n        i = i + 1\n      }\n      let dummy_ret = [\n        0\n      ]\n      let _ = mrv_fresh(body, fresh_names, tainted, bound, user_fns, view_set, dummy_ret)\n      true\n    },\n    EDot(x, _, _, _) => {\n      let _ = mrv_fresh(x, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n      false\n    },\n    ELabeledArg(_, _, v) => mrv_fresh(v, fresh_names, tainted, bound, user_fns, view_set, ret_view),\n    EReturn(x) => {\n      if mrv_fresh(x, fresh_names, tainted, bound, user_fns, view_set, ret_view) {\n        ()\n      } else {\n        Array::set(ret_view, 0, 1)\n      }\n      true\n    },\n    EBreak(opt) => {\n      let _ = match opt {\n        Some(v) => mrv_fresh(v, fresh_names, tainted, bound, user_fns, view_set, ret_view),\n        None => true\n      }\n      true\n    },\n    EContinue(args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        let _ = mrv_fresh(Array::get(args, i), fresh_names, tainted, bound, user_fns, view_set, ret_view)\n        i = i + 1\n      }\n      true\n    },\n    ESpread(x) => mrv_fresh(x, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n  }\n}\n\n/// ADR-0092 borrow-inference: top-level functions whose RETURN VALUE may be\n/// an unowned interior view (a borrow-returning builtin result, a match\n/// payload, a global, a parameter, or anything reaching a return position\n/// that mrv_fresh cannot prove fresh -- e.g. `let mut out = EInt(0); ...\n/// out = Array::get(exprs, i) ...; out`). The planner suppresses the\n/// retention-driven scope-end drop ONLY for let-bindings calling functions\n/// in this set (intersected with the borrow-arg0 set): suppressing for a\n/// fresh-returning callee instead leaks its result (caught by the\n/// compiler-gate RC reclamation guard), and NOT suppressing for a\n/// view-returning one releases a reference the binding never acquired\n/// (the codegen_heap_e2e_test over-release). Iterated to a fixpoint so a\n/// view propagates through wrapper functions whose tail is a call.\nexport fn compute_may_return_view_fns(stmts: Array[Stmt]) -> Array[String] {\n  let user_fns = array_empty()\n  let mut ci = 0\n  while ci < Array::length(stmts) {\n    match Array::get(stmts, ci) {\n      SLet(_, _, fname, _, fval) => match fval {\n        EFn(_, _, _, _, _, _) => Array::push(user_fns, fname),\n        _ => ()\n      },\n      _ => ()\n    }\n    ci = ci + 1\n  }\n  let view_set = array_empty()\n  let mut changed = true\n  let mut rounds = 0\n  while changed && rounds < 10 {\n    changed = false\n    let mut si = 0\n    while si < Array::length(stmts) {\n      match Array::get(stmts, si) {\n        SLet(_, _, fname, _, fval) => match fval {\n          EFn(_, _, fps, _, _, fbody) => if array_contains_str(view_set, fname) {\n            ()\n          } else {\n            let fresh_names = array_empty()\n            let tainted = array_empty()\n            let bound = array_empty()\n            let mut pi = 0\n            while pi < Array::length(fps) {\n              let (pn, _) = Array::get(fps, pi)\n              Array::push(bound, pn)\n              pi = pi + 1\n            }\n            let ret_view = [\n              0\n            ]\n            let tail_fresh = mrv_fresh(fbody, fresh_names, tainted, bound, user_fns, view_set, ret_view)\n            if !tail_fresh || Array::get(ret_view, 0) == 1 {\n              Array::push(view_set, fname)\n              changed = true\n            } else {\n              ()\n            }\n          },\n          _ => ()\n        },\n        _ => ()\n      }\n      si = si + 1\n    }\n    rounds = rounds + 1\n  }\n  view_set\n}\n\n//# #1259 step 7 groundwork: lambda-site counting\n\n/// How many lambda table entries compiling `expr` will allocate.\n///\n/// compile_lambda takes a lambda's function index from the LIVE length of the\n/// shared LambdaTable and emits it into the body as a `table_slot` immediate,\n/// so a function's output bytes depend on how many lambdas every function\n/// compiled before it produced. That is what stops a worker from compiling a\n/// body on its own, and removing it is what a frozen WholeProgramPlan means\n/// (docs/compiler-parallelism.md).\n///\n/// Counting is exact rather than an estimate: compile_expr dispatches EFn\n/// (tag 24) to compile_lambda unconditionally (compile_expr_tail3.vibe), and\n/// compile_lambda's push is unconditional, so one table entry per EFn node\n/// reachable in the body -- nested lambdas included, since compile_lambda\n/// compiles its own body through the same dispatch.\n///\n/// The traversal mirrors dce.vibe's collect_refs_into arm for arm. Binding\n/// structure is irrelevant here (a count, not a scope analysis), so the arms\n/// that clone a bound set there simply recurse.\n///\n/// It is a PREDICTION of what the sequential walk does, and it is checked\n/// against the live length at every allocation rather than trusted -- see\n/// CompileCtx.lambda_plan_next. A silent mismatch would key a body's emitted\n/// constants to a table slot nothing installs.\nexport fn count_lambda_sites_expr(expr: Expr) -> Int {\n  match expr {\n    EIdent(_, _) => 0,\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EReturn(e) => count_lambda_sites_expr(e),\n    EUnaryOp(_, e) => count_lambda_sites_expr(e),\n    ESpread(e) => count_lambda_sites_expr(e),\n    EDot(obj, _, _, _) => count_lambda_sites_expr(obj),\n    ELabeledArg(_, _, e) => count_lambda_sites_expr(e),\n    ETuple(items) => count_lambda_sites_exprs(items),\n    EArray(items) => count_lambda_sites_exprs(items),\n    ERecord(_, fields, _) => count_lambda_sites_fields(fields),\n    EMap(fields) => count_lambda_sites_fields(fields),\n    EBinOp(_, l, r) => count_lambda_sites_expr(l) + count_lambda_sites_expr(r),\n    ESeq(l, r) => count_lambda_sites_expr(l) + count_lambda_sites_expr(r),\n    ECall(callee, args, _) => count_lambda_sites_expr(callee) + count_lambda_sites_exprs(args),\n    EIf(cond, then_e, else_e) =>\n    count_lambda_sites_expr(cond) + count_lambda_sites_expr(then_e) + count_lambda_sites_expr(else_e),\n    ELet(_, val, body, _) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),\n    ELetRec(_, val, body) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),\n    ELetMut(_, val, body, _) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),\n    EAssign(_, val, body) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),\n    EAssignOp(_, _, val, body) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),\n    EWhile(cond, body) => count_lambda_sites_expr(cond) + count_lambda_sites_expr(body),\n    EForIn(_, _, iter, body) => count_lambda_sites_expr(iter) + count_lambda_sites_expr(body),\n    ELoop(params, body) => count_lambda_sites_fields(params) + count_lambda_sites_expr(body),\n    EMatch(scr, arms) => count_lambda_sites_expr(scr) + count_lambda_sites_arms(arms),\n    EHandle(body_expr, arms) => count_lambda_sites_expr(body_expr) + count_lambda_sites_arms(arms),\n    // The one arm that counts: this node IS a table entry, and its body may\n    // hold more.\n    EFn(_, _, _, _, _, body) => 1 + count_lambda_sites_expr(body)\n  }\n}\n\nfn count_lambda_sites_exprs(items: Array[Expr]) -> Int {\n  let n = Array::length(items)\n  let mut i = 0\n  let mut total = 0\n  while i < n {\n    total = total + count_lambda_sites_expr(Array::get(items, i))\n    i = i + 1\n  }\n  total\n}\n\nfn count_lambda_sites_fields(fields: Array[(String, Expr)]) -> Int {\n  let n = Array::length(fields)\n  let mut i = 0\n  let mut total = 0\n  while i < n {\n    let (_, val) = Array::get(fields, i)\n    total = total + count_lambda_sites_expr(val)\n    i = i + 1\n  }\n  total\n}\n\nfn count_lambda_sites_arms(arms: Array[(Pat, Expr)]) -> Int {\n  let n = Array::length(arms)\n  let mut i = 0\n  let mut total = 0\n  while i < n {\n    let (_, body) = Array::get(arms, i)\n    total = total + count_lambda_sites_expr(body)\n    i = i + 1\n  }\n  total\n}\n")
}

let cli_adapter_source_82 = () -> (String, String) {
  ("lib/@vibe/compiler/perceus/index.vpkg",
"name = @vibe/compiler/perceus\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/perceus — the RC backend's Perceus dup/drop planner\ndeps = {\n  @vibe/compiler/codegen/common_analysis : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/perceus — the RC backend's Perceus dup/drop planner\n// (count + emit passes over a function body), the program-wide\n// borrow-return / scalar-return / heap-return name scans, and the\n// heap-param elaboration rewrite (ADR-0055/#702..#715 lineage). First\n// COMPILER-INTERNAL contract batch (ADR-0070 Phase 3, #897) — compiled\n// into the compiler itself via compiler_sources_manifest.tsv (group\n// `codegen`, dual-row: this contract + perceus.vibe).\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package is single-file), so it moved verbatim to perceus.vibe.\n//\n// `PerceusAction` is declared TRANSPARENT (defined verbatim here, deleted\n// from the impl): tests/perceus_rc_test.vibe reads `.kind`/`.name`\n// directly, so the field layout is real public API surface (@vibe/process\n// ShResult precedent, PR #920). `PerceusActionKind` stays `opaque` with\n// its `export enum` kept in perceus.vibe: the impl file itself constructs\n// and pattern-matches PaDup/PaDrop/PaAliasDup, and enum VARIANTS do not\n// resolve across units from a facade-only definition (@vibe/json\n// precedent — \"unknown name: JNull\"). Consumers keep full variant\n// visibility through the same #716 re-export machinery as before.\n//\n// `PCtx` (the planner's mutable count/emit state, parameter of\n// pc_emit/pc_count) is intentionally NOT declared: it was never exported\n// by the old index.vibe either — the exported pc_emit/pc_count signatures\n// name it as structural signature text only, and conformance compares\n// signatures textually, so declaring it `opaque` would have forced a new\n// `export struct PCtx` (a surface WIDENING this migration must not make).\n// No `version` binding existed (compiler-internal package).\n\nopaque type PerceusActionKind\n\nstruct PerceusAction {\n  kind: PerceusActionKind;\n  name: String\n}\n\n// --- plan-action predicates\nfn pa_is_dup(a: PerceusAction) -> Bool\nfn pa_is_drop(a: PerceusAction) -> Bool\nfn pa_is_alias_dup(a: PerceusAction) -> Bool\n\n// --- program-wide name scans (threaded into every function's plan)\nfn compute_borrow_returning_names(stmts: Array[Stmt]) -> Array[String]\nfn compute_scalar_returning_names(stmts: Array[Stmt]) -> Array[String]\nfn compute_heap_returning(stmts: Array[Stmt]) -> Array[String]\n\n// --- heap-ness classification\nfn type_expr_is_heap(ot: Option[TypeExpr]) -> Bool\nfn param_is_heap_in_body(name: String, otype: Option[TypeExpr], body: Expr) -> Bool\n\n// --- planner passes and entry points\nfn pc_count(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int\nfn pc_emit(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int\nfn build_perceus_plan(body: Expr) -> Array[PerceusAction]\nfn build_perceus_plan_with_params(params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_arg0_fns: Array[String], view_ret_fns: Array[String]) -> Array[PerceusAction]\n\n// --- heap-param elaboration (run at the head of the RC pipeline)\nfn elaborate_heap_params(stmts: Array[Stmt]) -> Array[Stmt]\n")
}

let cli_adapter_source_83 = () -> (String, String) {
  ("lib/@vibe/compiler/perceus/perceus.vibe",
"//# Imports\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n//# Types\n\nexport enum PerceusActionKind {\n  PaDup;\n  PaDrop;\n  // A `dup` attributed to an *alias* binding `let a = t`: the source `t` is\n  // used in more than one owning position, so this alias takes a duplicated\n  // reference. Keyed by the ALIAS name `a` (not the source), which makes it\n  // occurrence-precise without tree-order bookkeeping: the codegen dups the\n  // source exactly at `let a = …`. (docs/spec/selfhost-rc-port.md)\n  PaAliasDup\n}\n\n// PerceusAction is defined transparently in this package's contract\n// (index.vpkg): its field layout (.kind/.name) is real public API surface\n// read directly by tests/perceus_rc_test.vibe. Struct record literals and\n// field access resolve fine from impl units against the facade definition\n// (@vibe/process ShResult precedent, PR #920), so no local def is kept.\n\nstruct PCtx {\n  mut next_id: Int;\n  mut seq_id: Int;\n  pctx_names: Array[String];\n  // ADR-0092 borrow-inference slice 1: whole-program set of user fns with a\n  // borrowed arg0 ABI (compute_borrow_arg0_user_fns, common_analysis.vibe).\n  // Same COPY discipline as pctx_names -- see pctx_new's doc comment.\n  borrow_arg0_user: Array[String];\n  // The subset of borrow_arg0_user whose RETURN may be an unowned interior\n  // view (compute_may_return_view_fns intersected in linked_compile). Only\n  // calls to THESE mark view_call_let: suppressing the scope-end drop for a\n  // fresh-returning callee's binding leaks its result (compiler-gate RC\n  // reclamation guard), while a view-returning callee's binding must not\n  // release a reference it never acquired. Same COPY discipline.\n  view_ret_user: Array[String];\n  uses: Array[Int];\n  borrows: Array[Int];\n  scalar: Array[Bool];\n  remaining: Array[Int];\n  // ADR-0092 per-use pairing (the borrowed-arg0 over-release fix): uses as\n  // counted BEFORE pctx_apply_borrow_retention's +1 (i.e. owned consumes\n  // only), snapshotted by that pass in id order.\n  owned_uses: Array[Int];\n  // True for a let-binding whose VALUE is a call to a borrow-arg0 fn (user\n  // set or builtin list) -- the class whose result may be an unowned\n  // interior view. With the borrow set empty this is never set, so the fix\n  // is inert while lc_borrow_arg0_enabled is off.\n  view_call_let: Array[Bool];\n  actions: Array[PerceusAction]\n}\n\nstruct HeapInferCtx {\n  ctors: Array[String];\n  heap_fns: Array[String]\n}\n\n//# Functions\n\nfn zeros(n: Int) -> Array[Int] {\n  let out: Array[Int] = [\n  ]\n  let mut i = 0\n  while i < n {\n    Array::push(out, 0)\n    i = i + 1\n  }\n  out\n}\n\nfn int_max(a: Int, b: Int) -> Int {\n  if a > b {\n    a\n  } else {\n    b\n  }\n}\n\nfn name_in(arr: Array[String], s: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == s {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn pe_push(ctx: PCtx, kind: PerceusActionKind, name: String) -> Int {\n  Array::push(ctx.actions, PerceusAction::{\n    kind: kind, name: name\n  })\n  0\n}\n\nfn pe_use(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {\n  if Map::has_key(scope, name) {\n    let id = Map::get(scope, name)\n    let rem = Array::get(ctx.remaining, id)\n    if rem > 1 && !Array::get(ctx.scalar, id) {\n      pe_push(ctx, PaDup, name)\n    } else {\n      0\n    }\n    if rem > 0 {\n      Array::set(ctx.remaining, id, rem - 1)\n    }\n  }\n  0\n}\n\n/// `borrow_ret_names` is the whole-program borrow-returning-function-name set\n/// (see is_borrow_ret_fname), computed ONCE per compile and identical across\n/// every function's plan build. COPIED (not aliased) so PCtx solely owns\n/// `pctx_names`: the caller's array reaches here through a borrowed struct\n/// field read (CompileCtx.borrow_ret_names, see compile_lambda.vibe), so\n/// storing it directly would let PCtx's structural drop decrement a refcount\n/// this plan never owned -- the #707/#715 double-free shape. One\n/// Array::slice is a single allocation + memory.copy of the name pointers.\nfn pctx_new(borrow_ret_names: Array[String], borrow_arg0_fns: Array[String], view_ret_fns: Array[String]) -> PCtx {\n  PCtx::{\n    next_id: 0,\n    seq_id: 0,\n    pctx_names: Array::slice(borrow_ret_names, 0, Array::length(borrow_ret_names)),\n    borrow_arg0_user: Array::slice(borrow_arg0_fns, 0, Array::length(borrow_arg0_fns)),\n    view_ret_user: Array::slice(view_ret_fns, 0, Array::length(view_ret_fns)),\n    uses: [\n    ],\n    borrows: [\n    ],\n    scalar: [\n    ],\n    remaining: [\n    ],\n    owned_uses: [\n    ],\n    view_call_let: [\n    ],\n    actions: [\n    ],\n  }\n}\n\n/// Perf: this snapshot runs in every branch/match arm of the perceus plan --\n/// the push-per-element version was the single largest __rt_arr_push caller in\n/// a full-closure compile profile (253ms of 439ms). Array::slice is one\n/// allocation + one memory.copy and yields an equally independent buffer.\nfn copy_ints(src: Array[Int]) -> Array[Int] {\n  Array::slice(src, 0, Array::length(src))\n}\n\nexport fn pa_is_dup(a: PerceusAction) -> Bool {\n  match a.kind {\n    PaDup => true,\n    PaDrop => false,\n    PaAliasDup => false\n  }\n}\n\nfn pat_names(pat: Pat, out: Array[String]) -> Int {\n  match pat {\n    PBind(name) => {\n      Array::push(out, name)\n      0\n    },\n    PCtor(_n, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        pat_names(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        pat_names(Array::get(pats, i), out)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, _r) => pat_names(l, out),\n    PStruct(_n, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pat_names((Array::get(fields, i)).1, out)\n        i = i + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nexport fn pa_is_drop(a: PerceusAction) -> Bool {\n  match a.kind {\n    PaDrop => true,\n    PaDup => false,\n    PaAliasDup => false\n  }\n}\n\nfn pc_declare(ctx: PCtx, _name: String, scalar: Bool) -> Int {\n  let id = ctx.next_id\n  Array::push(ctx.uses, 0)\n  Array::push(ctx.borrows, 0)\n  Array::push(ctx.scalar, scalar)\n  Array::push(ctx.view_call_let, false)\n  ctx.next_id = id + 1\n  id\n}\n\n/// ADR-0092 per-use pairing: mark `id` as a view-call let-binding when its\n/// value is a call to a borrow-arg0 fn that may RETURN an unowned view\n/// (see PCtx.view_ret_user -- fresh-returning borrow-arg0 callees must\n/// keep their binding's scope-end drop or the result leaks).\nfn pctx_mark_view_call(ctx: PCtx, id: Int, value: Expr) -> Int {\n  match value {\n    ECall(vc, _, _) => match vc {\n      EIdent(vf, _) => if array_contains_str_pctx(ctx.view_ret_user, vf) {\n        Array::set(ctx.view_call_let, id, true)\n      } else {\n        ()\n      },\n      _ => ()\n    },\n    _ => ()\n  }\n  0\n}\n\nfn pe_declare(ctx: PCtx, _name: String) -> Int {\n  let id = ctx.next_id\n  let owning = Array::get(ctx.uses, id)\n  let init = if owning == 0 {\n    1\n  } else {\n    owning\n  }\n  Array::push(ctx.remaining, init)\n  ctx.next_id = id + 1\n  id\n}\n\nfn pc_count_use(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {\n  if Map::has_key(scope, name) {\n    let id = Map::get(scope, name)\n    Array::set(ctx.uses, id, Array::get(ctx.uses, id) + 1)\n  }\n  0\n}\n\nfn pe_scope_end(ctx: PCtx, id: Int, name: String) -> Int {\n  if Array::get(ctx.remaining, id) > 0 && !Array::get(ctx.scalar, id) {\n    // ADR-0092 per-use pairing: a view-call let-binding whose uses are ALL\n    // borrows acquired no ownership -- its plan has no dup and its value\n    // may be an unowned interior view, so the retention-driven scope-end\n    // drop would release a reference it never held (the over-release that\n    // trapped codegen_heap_e2e_test under the borrowed-arg0 ABI). Suppress\n    // the drop for exactly that class; a fresh-owned value from a\n    // borrow-arg0 callee then leaks (bounded, safe direction). Params are\n    // never in the class (view_call_let is set only from ELet values).\n    if Array::get(ctx.view_call_let, id) && Array::get(ctx.owned_uses, id) == 0 && Array::get(ctx.borrows, id) > 0 {\n      ()\n    } else {\n      pe_push(ctx, PaDrop, name)\n    }\n    Array::set(ctx.remaining, id, 0)\n  }\n  0\n}\n\nfn next_seq_name(ctx: PCtx) -> String {\n  let nm = \"__seq\" + __to_string(ctx.seq_id)\n  ctx.seq_id = ctx.seq_id + 1\n  nm\n}\n\nfn fn_param_names(params: Array[(String, Option[TypeExpr])]) -> Array[String] {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(params) {\n    Array::push(out, (Array::get(params, i)).0)\n    i = i + 1\n  }\n  out\n}\n\nfn is_v128_box_call(fname: String) -> Bool {\n  fname == \"v128_load\" || fname == \"v128_splat_i8x16\" || fname == \"v128_eq_i8x16\" || fname == \"v128_le_u_i8x16\" || fname == \"v128_ge_u_i8x16\" || fname == \"v128_and\" || fname == \"v128_or\" || fname == \"v128_not\"\n}\n\nfn array_contains_str_pctx(arr: Array[String], s: String) -> Bool {\n  // #1100: early-exit — this membership scan is one of the plan's hottest\n  // loops and used to keep scanning the whole array after a hit.\n  let n = Array::length(arr)\n  let mut i = 0\n  let mut found = false\n  while !found && i < n {\n    if Array::get(arr, i) == s {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// #707: is `fname` a call whose return value is a BORROWED VIEW sharing a\n/// call argument's refcount, rather than a fresh owned reference -- either one\n/// of the 3 builtins that read an element in place, or a user function whose\n/// own body is (transitively) nothing but a tail-call to one of those (see\n/// compute_borrow_returning_names). Bindings holding such a value must never\n/// be dup/drop'd themselves: the compiler-self-hosted-under-RC crash (#707)\n/// was exactly this -- `let peek = (toks, pos) -> Array::get(toks, pos)` was\n/// NOT recognized as borrow-returning (only a literal `Array::get` callee\n/// was), so `let __m_scrut = peek(toks, pos) in match __m_scrut { ... }`\n/// (the match-scrutinee-lift's desugaring, see normalize/index.vibe\n/// lift_match_scrutinees) planned a drop for `__m_scrut` as if it independently\n/// owned a reference -- double-freeing the array element peek merely borrowed.\n///\n/// #1237 perf: `ctx.pctx_names` holds exactly the whole-program\n/// borrow-returning-name set (see pctx_new). A genuine dedicated PCtx field\n/// for that set was tried once and hit an unexplained \"memory access out of\n/// bounds\" reading it back specifically when the whole compiler self-compiles\n/// under RC (see #707), so pctx_names remains the known-safe field to read it\n/// from. What changed is that pc_declare used to ALSO append every declared\n/// binding name to this same array, so the set had to be stored with a\n/// control-char prefix to stay distinguishable -- making each lookup here pay\n/// a String::concat and, on a miss (the common case), rescan every binding\n/// declared so far in the current function. pc_declare no longer touches\n/// pctx_names, so the names sit here unprefixed and a miss costs only the\n/// fixed set.\nfn is_borrow_ret_fname(ctx: PCtx, fname: String) -> Bool {\n  fname == \"Array::get\" || fname == \"Map::get\" || fname == \"__index\" || fname == \"__rec_field\" || array_contains_str_pctx(ctx.pctx_names, fname)\n}\n\n/// #707: fixed-point closure over top-level function definitions, starting\n/// from the 3 borrow-returning builtins: a function whose entire body is\n/// (after stripping let/seq/assign wrappers) a single tail-call to an\n/// already-known borrow-returning name is itself borrow-returning. Handles\n/// arbitrarily deep wrapper chains (`peek` -> `Array::get`,\n/// `peek2` -> `peek` -> `Array::get`, ...). Computed once over the whole\n/// merged program (see linked_compile.vibe) and threaded into every\n/// function's Perceus plan via build_perceus_plan_with_params.\n/// #707: does every value `e` can tail-produce come from a known\n/// borrow-returning name, or a \"safe to never drop\" fallback? Recurses through\n/// let/seq/assign wrappers and BOTH sides of if/match (a bare tail call alone\n/// missed `peek`'s actual shape: `if pos < len { Array::get(tokens, pos) }\n/// else TEof` -- a bounds-check guard around the real access, with a bare\n/// nullary-ctor-ish identifier as the out-of-range fallback). A bare EIdent\n/// tail (e.g. a sentinel like TEof) is accepted as safe even though it isn't\n/// proven borrow-returning: marking its binding \"never dup/drop\" can at worst\n/// leak that one value (the existing runtime dup/drop guards already no-op on\n/// non-heap-tagged values), never corrupt -- the failure mode this whole fix\n/// targets is a double-free from treating a genuinely-borrowed value as owned,\n/// not a leak from treating a small/rare owned value as borrowed.\n/// Iterative (NOT self-recursive) worklist walk over child expressions, rather\n/// than a `let rec` recursive-descent function. Also: the `ECall` case matches\n/// its callee via a NESTED constructor pattern one step at a time (`ECall(e,\n/// _, _)` then a separate `match e { EIdent(callee, _) => ... }`), never\n/// `ECall(EIdent(callee, _), _, _)` in one pattern. Both of these are\n/// load-bearing workarounds, not style: a `let rec` self-recursive version of\n/// this walk, AND a single-arm version using the nested `ECall(EIdent(...),\n/// _, _)` pattern, each independently reproduce a \"memory access out of\n/// bounds\" trap (reproducible under bump too -- not RC-specific) that is only\n/// exposed when this function runs over a derive(Ord)-generated `T::compare`\n/// body (a chain of `EIf(cmp, EInt(-1/1), ...)` with no further wrapper/call\n/// -- e.g. `struct P { x: Int; y: Int } derive(Ord)`). An equivalent shape\n/// recursing into an `Array::get` call / `EIdent` sentinel branch (`peek`'s\n/// actual body) does not crash either broken variant, and the crash persists\n/// even when the offending match arm is never reached at runtime for the\n/// crashing input -- so this is a codegen bug in this compiler triggered by\n/// those two source *shapes*, not a logic bug in this function's checks.\n/// True root cause not isolated; swap either workaround for the \"more natural\"\n/// form only after confirming compute_borrow_returning_names_test.vibe (or an\n/// equivalent derive(Ord) regression) still passes.\nfn tail_is_borrow_ret_safe(known: Array[String], e0: Expr) -> Bool {\n  let worklist = [\n    e0\n  ]\n  let mut all_safe = true\n  let mut i = 0\n  while i < Array::length(worklist) {\n    match Array::get(worklist, i) {\n      ELet(_, _, b, _) => Array::push(worklist, b),\n      ELetMut(_, _, b, _) => Array::push(worklist, b),\n      ELetRec(_, _, b) => Array::push(worklist, b),\n      ESeq(_, b) => Array::push(worklist, b),\n      EAssign(_, _, b) => Array::push(worklist, b),\n      EAssignOp(_, _, _, b) => Array::push(worklist, b),\n      EIf(_, t, el) => {\n        Array::push(worklist, t)\n        Array::push(worklist, el)\n      },\n      EMatch(_, arms) => {\n        let mut ai = 0\n        while ai < Array::length(arms) {\n          let (_p, ae) = Array::get(arms, ai)\n          Array::push(worklist, ae)\n          ai = ai + 1\n        }\n      },\n      ECall(callee_e, cargs, _) =>\n      match callee_e {\n        EIdent(callee, _) =>\n        if callee == \"perform\" && Array::length(cargs) == 1 {\n          // #640 Stage 2: `throw(x)` now parses to `perform Error::Throw(x)`,\n          // so the #715 throwing-tail exemption below (EThrow) must also\n          // recognize this shape — a throwing tail never produces a value, so\n          // it cannot violate the borrow-returning invariant. Without this,\n          // every `match x { Ctor(..) => field, _ => throw(..) }` accessor is\n          // again rejected as borrow-returning and the #715 same-address\n          // double-free returns. Matched step-by-step (NOT one nested\n          // ECall(EIdent(..)) pattern) per the workaround note above.\n          let mut op_is_throw = false\n          match Array::get(cargs, 0) {\n            ECall(op_e, _, _) =>\n            match op_e {\n              EIdent(op_n, _) => if op_n == \"Error::Throw\" {\n                op_is_throw = true\n              } else {\n                ()\n              },\n              _ => ()\n            },\n            _ => ()\n          }\n          if op_is_throw {\n            ()\n          } else if !array_contains_str_pctx(known, callee) {\n            all_safe = false\n          } else {\n            ()\n          }\n        } else if !array_contains_str_pctx(known, callee) {\n          all_safe = false\n        } else {\n          ()\n        },\n        _ => {\n          all_safe = false\n        }\n      },\n      EIdent(_, _) => (),\n      // #715: a throwing tail (the ubiquitous `match x { Ctor(..) => field, _\n      // => throw(\"not X\") }` shape used by every common_extractors.vibe\n      // accessor) never actually produces a value along that path, so it\n      // cannot violate the borrow-returning invariant -- there is nothing to\n      // mismanage. Without this, EVERY such accessor (get_efn_params,\n      // get_efn_body, get_ecall_args, ...) fell through to the catch-all\n      // below and was rejected solely because of its own error arm, even\n      // though its real (non-throwing) arm is a plain borrowed field\n      // projection. That misclassification made the caller treat the\n      // extracted field as an independently owned value while the\n      // scrutinee's own later structural drop also reclaims it -- a\n      // same-address double-free (the #715 self-hosting free-list\n      // corruption).\n      _ => {\n        all_safe = false\n      }\n    }\n    i = i + 1\n  }\n  all_safe\n}\n\n/// Strip let/seq/assign wrappers, same as tail_is_borrow_ret_safe, to find the\n/// expression whose SHAPE decides eligibility at the top level.\nfn strip_wrappers_for_borrow_ret(e: Expr) -> Expr {\n  match e {\n    ELet(_, _, b, _) => strip_wrappers_for_borrow_ret(b),\n    ELetMut(_, _, b, _) => strip_wrappers_for_borrow_ret(b),\n    ELetRec(_, _, b) => strip_wrappers_for_borrow_ret(b),\n    ESeq(_, b) => strip_wrappers_for_borrow_ret(b),\n    EAssign(_, _, b) => strip_wrappers_for_borrow_ret(b),\n    EAssignOp(_, _, _, b) => strip_wrappers_for_borrow_ret(b),\n    _ => e\n  }\n}\n\nexport fn compute_borrow_returning_names(stmts: Array[Stmt]) -> Array[String] {\n  let known: Array[String] = [\n    \"Array::get\",\n    \"Map::get\",\n    \"__index\",\n    \"__rec_field\"\n  ]\n  let mut changed = true\n  while changed {\n    changed = false\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SLet(_, _, name, _, value) =>\n        if !array_contains_str_pctx(known, name) {\n          match value {\n            EFn(_, _, _, _, _, body) => {\n              // A function is borrow-returning only if its (wrapper-stripped)\n              // top-level shape is itself a call/if/match reaching a known\n              // borrow-return name on every branch -- a BARE identifier tail\n              // at the *top level* (an identity-like function) is NOT eligible\n              // here even though tail_is_borrow_ret_safe accepts a bare ident\n              // as a safe fallback *inside* an if/match branch (e.g. peek's\n              // `else TEof`). This keeps `let f = (x) -> T { x }` (a genuine\n              // passthrough of a normally-owned argument) from being\n              // misclassified as a Array::get-style borrowed view.\n              let top = strip_wrappers_for_borrow_ret(body)\n              let eligible_shape = match top {\n                ECall(_, _, _) => true,\n                EIf(_, _, _) => true,\n                EMatch(_, _) => true,\n                _ => false\n              }\n              if eligible_shape && tail_is_borrow_ret_safe(known, top) {\n                Array::push(known, name)\n                changed = true\n              } else {\n                ()\n              }\n            },\n            _ => ()\n          }\n        } else {\n          ()\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n  }\n  known\n}\n\n/// A top-level function's declared return type, from its `let f: (T1,...) ->\n/// R = ...` signature -- `None` when untyped (no signature to consult).\nfn fn_sig_return_type(ty: Option[TypeExpr]) -> Option[TypeExpr] {\n  match ty {\n    Some(t) =>\n    match t {\n      TyFn(_, ret, _) => Some(ret),\n      _ => None\n    },\n    None => None\n  }\n}\n\n/// #710 out-param crash: `let n = f(...)` for a user function `f` whose body\n/// is not one of the 3 hardcoded borrow-returning builtins falls through to\n/// `heap_binding_names`'s default -- \"any non-borrow-ret call result is heap\"\n/// (compile_expr_tail.vibe's ELet ECall branch; see that struct field's own\n/// doc comment, which already promises \"we never touch a non-heap (e.g.\n/// Int-returning call) binding\"). When `f` actually returns a scalar (Int/\n/// Bool/Unit) -- e.g. `build_import_plan(...) -> Int` -- the binding is a\n/// plain integer, not a tagged heap pointer. If that binding is later\n/// ALIASED more than once (`let a = n; let b = n`), the Perceus plan schedules\n/// a PaAliasDup for the 2nd+ alias, and compile_expr_tail.vibe's `is_eident`\n/// branch used to call the unguarded `emit_rc_dup_local` on it: untag (AND -2)\n/// then read/write 4 bytes before the \"pointer\". For a small scalar like 0\n/// that computes a near-null address -- `RuntimeError: memory access out of\n/// bounds`, not a leak (component_codegen_test.vibe's \"component async: sync\n/// lift\" hit this via `import_func_count` aliased into run_core_func_idx/\n/// run_type_idx/run_func_idx). That call site now uses the runtime-tag-checked\n/// `emit_rc_dup_guarded` instead (a misclassified scalar is a silent no-op\n/// there rather than a wild write) -- this was the one remaining unguarded RC\n/// increment anywhere in codegen, so it is now fixed on general principle even\n/// though it was empirically NOT the cause of the *other* still-open #709\n/// self-hosting crash (a free-list node with corrupted size/next fields,\n/// surfacing later inside `fn_type_param_types`'s `vibe_rc_alloc`; confirmed via a\n/// differential rebuild that the crash persists byte-for-byte unchanged with\n/// this fix in place). Names collected here still matter for perf/precision\n/// (avoiding unnecessary heap_binding_names churn) and let the ELet ECall\n/// branch skip `heap_binding_names` for a call whose declared return type is\n/// provably scalar, matching the exemption the field's own doc comment already\n/// describes. Untyped functions are conservatively left out (stay in the\n/// existing heap over-approximation) since there is no signature to consult --\n/// no longer a correctness cliff-edge now that the alias-dup site is guarded,\n/// only a missed optimization.\nexport fn compute_scalar_returning_names(stmts: Array[Stmt]) -> Array[String] {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, ty, value) =>\n      match value {\n        EFn(_, _, _, _, _, _) =>\n        match fn_sig_return_type(ty) {\n          Some(ret) =>\n          if !type_expr_is_heap(Some(ret)) {\n            Array::push(out, name)\n          } else {\n            ()\n          },\n          None => ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn is_scalar_expr(ctx: PCtx, e: Expr) -> Bool {\n  match e {\n    EInt(_) => true,\n    EBool(_) => true,\n    EFloat(_) => true,\n    EUnit => true,\n    // #705: v128_load/splat/binary-op/not return a tagged pointer to a 16-byte\n    // box with NO rc header (type_id/refcount) -- see compile_call.vibe. The\n    // tag makes it look like a heap pointer to the runtime dup/drop guards\n    // (odd low bit), so planning a PaDup/PaDrop for a binding holding one would\n    // make those guards misread the v128 payload bytes as a refcount and\n    // corrupt it (or an adjacent allocation). Treat the binding as scalar\n    // (never dup/drop'd), matching the box's actual bump-only, never-freed\n    // lifetime under both backends.\n    ECall(EIdent(fname, _), _, _) => is_v128_box_call(fname) || is_borrow_ret_fname(ctx, fname),\n    _ => false\n  }\n}\n\nfn pat_shadow_env(pat: Pat, env: Map[String, Bool]) -> Map[String, Bool] {\n  let names: Array[String] = [\n  ]\n  pat_names(pat, names)\n  let mut env2 = env\n  let mut j = 0\n  while j < Array::length(names) {\n    env2 = Map::set(env2, Array::get(names, j), false)\n    j = j + 1\n  }\n  env2\n}\n\nfn restore_prefix(dst: Array[Int], src: Array[Int]) -> Int {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::set(dst, i, Array::get(src, i))\n    i = i + 1\n  }\n  0\n}\n\nfn is_heap_literal(e: Expr) -> Bool {\n  match e {\n    ETuple(_) => true,\n    EArray(_) => true,\n    ERecord(_, _, _) => true,\n    _ => false\n  }\n}\n\nfn is_heap_value(e: Expr, env: Map[String, Bool], hctx: HeapInferCtx) -> Bool {\n  if is_heap_literal(e) {\n    true\n  } else {\n    match e {\n      ECall(callee, args, _) =>\n      match callee {\n        EIdent(c, _) =>\n        if Map::has_key(env, c) {\n          false\n        } else {\n          (Array::length(args) > 0 && name_in(hctx.ctors, c)) ||\n          name_in(hctx.heap_fns, c)\n        },\n        _ => false\n      },\n      _ => false\n    }\n  }\n}\n\nfn arg_class(arg: Expr, env: Map[String, Bool], hctx: HeapInferCtx) -> Bool {\n  if is_heap_value(arg, env, hctx) {\n    true\n  } else {\n    match arg {\n      EIdent(n, _) => if Map::has_key(env, n) {\n        Map::get(env, n)\n      } else {\n        false\n      },\n      _ => false\n    }\n  }\n}\n\nfn analyze_calls(name: String, e_in: Expr, env_in: Map[String, Bool], calls: Array[Array[Bool]], esc: Array[Bool], hctx: HeapInferCtx) -> Int {\n  // #556: iterate the let / seq / assign \"spine\" instead of recursing on its\n  // tail, so a deeply-nested (flattened) expression — e.g. the whole compiler\n  // compiled as a single unit under RC — no longer exhausts the wasm stack in\n  // this pass. The shallow side of each spine node is still analyzed\n  // recursively; the visit order and env threading are identical to the former\n  // pure recursion (fixpoint-verified), so the RC analysis result is unchanged.\n  let mut e = e_in\n  let mut env = env_in\n  let mut looping = true\n  while looping {\n    looping = false\n    match e {\n      EIdent(n, _) => {\n        if n == name {\n          Array::set(esc, 0, true)\n        } else {\n          ()\n        }\n        0\n      },\n      ECall(callee, args, _) => {\n        let is_self = match callee {\n          EIdent(cn, _) => cn == name,\n          _ => false\n        }\n        if is_self {\n          let cls: Array[Bool] = [\n          ]\n          let mut k = 0\n          while k < Array::length(args) {\n            Array::push(cls, arg_class(Array::get(args, k), env, hctx))\n            k = k + 1\n          }\n          Array::push(calls, cls)\n        } else {\n          let _ = analyze_calls(name, callee, env, calls, esc, hctx)\n          ()\n        }\n        let mut i = 0\n        while i < Array::length(args) {\n          analyze_calls(name, Array::get(args, i), env, calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      EDot(obj, _, _, _) => analyze_calls(name, obj, env, calls, esc, hctx),\n      ELet(n, v, b, _) => {\n        analyze_calls(name, v, env, calls, esc, hctx)\n        env = Map::set(env, n, is_heap_value(v, env, hctx))\n        e = b\n        looping = true\n      },\n      ELetRec(n, v, b) => {\n        env = Map::set(env, n, false)\n        analyze_calls(name, v, env, calls, esc, hctx)\n        e = b\n        looping = true\n      },\n      ELetMut(n, v, b, _) => {\n        analyze_calls(name, v, env, calls, esc, hctx)\n        env = Map::set(env, n, false)\n        e = b\n        looping = true\n      },\n      EAssign(_, v, c) => {\n        analyze_calls(name, v, env, calls, esc, hctx)\n        e = c\n        looping = true\n      },\n      EAssignOp(_, _, v, c) => {\n        analyze_calls(name, v, env, calls, esc, hctx)\n        e = c\n        looping = true\n      },\n      ESeq(a, b) => {\n        analyze_calls(name, a, env, calls, esc, hctx)\n        e = b\n        looping = true\n      },\n      EIf(c, t, el) => {\n        analyze_calls(name, c, env, calls, esc, hctx)\n        analyze_calls(name, t, env, calls, esc, hctx)\n        analyze_calls(name, el, env, calls, esc, hctx)\n        0\n      },\n      EWhile(c, b) => {\n        analyze_calls(name, c, env, calls, esc, hctx)\n        analyze_calls(name, b, env, calls, esc, hctx)\n        0\n      },\n      EForIn(v0, ix, it, b) => {\n        analyze_calls(name, it, env, calls, esc, hctx)\n        let env1 = Map::set(env, v0, false)\n        let env2 = match ix {\n          Some(ixn) => Map::set(env1, ixn, false),\n          None => env1\n        }\n        analyze_calls(name, b, env2, calls, esc, hctx)\n        0\n      },\n      EBinOp(_, l, r) => {\n        analyze_calls(name, l, env, calls, esc, hctx)\n        analyze_calls(name, r, env, calls, esc, hctx)\n        0\n      },\n      EUnaryOp(_, o) => analyze_calls(name, o, env, calls, esc, hctx),\n      EFn(_, _, params, _, _, b) => {\n        let mut env2 = env\n        let mut pi = 0\n        while pi < Array::length(params) {\n          let (pn, _) = Array::get(params, pi)\n          env2 = Map::set(env2, pn, false)\n          pi = pi + 1\n        }\n        analyze_calls(name, b, env2, calls, esc, hctx)\n        0\n      },\n      ETuple(xs) => {\n        let mut i = 0\n        while i < Array::length(xs) {\n          analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      EArray(xs) => {\n        let mut i = 0\n        while i < Array::length(xs) {\n          analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      EMatch(s, arms) => {\n        analyze_calls(name, s, env, calls, esc, hctx)\n        let mut i = 0\n        while i < Array::length(arms) {\n          let (pat, ab) = Array::get(arms, i)\n          analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      EHandle(b, arms) => {\n        analyze_calls(name, b, env, calls, esc, hctx)\n        let mut i = 0\n        while i < Array::length(arms) {\n          let (pat, ab) = Array::get(arms, i)\n          analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      ELoop(ps, b) => {\n        let mut env2 = env\n        let mut i = 0\n        while i < Array::length(ps) {\n          let (pn, iv) = Array::get(ps, i)\n          analyze_calls(name, iv, env2, calls, esc, hctx)\n          env2 = Map::set(env2, pn, false)\n          i = i + 1\n        }\n        analyze_calls(name, b, env2, calls, esc, hctx)\n        0\n      },\n      ERecord(_, fs, _) => {\n        let mut i = 0\n        while i < Array::length(fs) {\n          let (_, fv) = Array::get(fs, i)\n          analyze_calls(name, fv, env, calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      EMap(fs) => {\n        let mut i = 0\n        while i < Array::length(fs) {\n          let (_, fv) = Array::get(fs, i)\n          analyze_calls(name, fv, env, calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      ELabeledArg(_, _, x) => analyze_calls(name, x, env, calls, esc, hctx),\n      EReturn(x) => analyze_calls(name, x, env, calls, esc, hctx),\n      ESpread(x) => analyze_calls(name, x, env, calls, esc, hctx),\n      EBreak(o) =>\n      match o {\n        Some(x) => analyze_calls(name, x, env, calls, esc, hctx),\n        None => 0\n      },\n      EContinue(xs) => {\n        let mut i = 0\n        while i < Array::length(xs) {\n          analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\n          i = i + 1\n        }\n        0\n      },\n      EInt(_) => 0,\n      EFloat(_) => 0,\n      EString(_) => 0,\n      EBool(_) => 0,\n      EStringInterp(_) => 0,\n      EUnit => 0\n    }\n  }\n  0\n}\n\n/// An alias-attributed dup: `let a = t` where `t` is multiply-used and owned.\n/// Keyed by the alias name.\nexport fn pa_is_alias_dup(a: PerceusAction) -> Bool {\n  match a.kind {\n    PaAliasDup => true,\n    PaDup => false,\n    PaDrop => false\n  }\n}\n\nfn pc_count_borrow(ctx: PCtx, scope: Map[String, Int], name: String) -> Int {\n  if Map::has_key(scope, name) {\n    let id = Map::get(scope, name)\n    Array::set(ctx.borrows, id, Array::get(ctx.borrows, id) + 1)\n  }\n  0\n}\n\nfn type_contains_fn(t: TypeExpr) -> Bool {\n  match t {\n    TyFn(_, _, _) => true,\n    TyTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if type_contains_fn(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyApp(_, args) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if type_contains_fn(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyName(_) => false,\n    TyUnit => false\n  }\n}\n\nfn all_calls_heap_at(idx: Int, calls: Array[Array[Bool]]) -> Bool {\n  let mut ci = 0\n  let mut all_heap = true\n  while ci < Array::length(calls) {\n    let cls = Array::get(calls, ci)\n    if idx >= Array::length(cls) {\n      all_heap = false\n    } else if !Array::get(cls, idx) {\n      all_heap = false\n    } else {\n      ()\n    }\n    ci = ci + 1\n  }\n  all_heap\n}\n\nfn type_name_is_heap(n: String) -> Bool {\n  if String::length(n) == 0 {\n    false\n  } else {\n    let c0 = String::char_code_at(n, 0)\n    if c0 < 'A' || c0 > 'Z' {\n      false\n    } else if n == \"Int\" || n == \"Bool\" || n == \"Double\" || n == \"Float\" || n == \"String\" || n == \"Bytes\" || n == \"Char\" || n == \"Unit\" || n == \"V128\" {\n      // #705: V128 is a tagged pointer to a 16-byte box (see compile_call.vibe\n      // v128_load/v128_splat_i8x16/etc), but the box has NO rc header\n      // (type_id/refcount) -- it's a bare payload written directly by\n      // v128.store. Treating it as heap would make Perceus emit __rc_dup /\n      // vibe_rc_drop calls that misread the v128 payload bytes as a type_id and\n      // refcount, corrupting the box (or freeing arbitrary memory at the\n      // implied \"next\"/size fields). Excluding it here keeps V128 boxes exactly\n      // as they behave under the bump backend: forward-only bump allocations\n      // that are simply never reclaimed, not memory-unsafe ones.\n      false\n    } else {\n      true\n    }\n  }\n}\n\nexport fn type_expr_is_heap(ot: Option[TypeExpr]) -> Bool {\n  match ot {\n    None => false,\n    Some(t) =>\n    match t {\n      // #702: a bare function-typed binding/param is a closure — heap when it\n      // captures (an odd RC block), a scalar constant when it doesn't. Treating\n      // it as heap lets the owning function drop it (vibe_rc_drop's odd-check makes\n      // the non-capturing constant a no-op), reclaiming capturing closures passed\n      // as arguments to higher-order fns instead of leaking them.\n      TyFn(_, _, _) => true,\n      _ =>\n      if type_contains_fn(t) {\n        false\n      } else {\n        match t {\n          TyTuple(_) => true,\n          TyApp(_, _) => true,\n          TyName(n) => type_name_is_heap(n),\n          TyFn(_, _, _) => false,\n          TyUnit => false\n        }\n      }\n    }\n  }\n}\n\n/// #791: program-wide (name of every top-level function whose DECLARED return\n/// type is heap), mirroring compute_agg_returning's scan but reading\n/// type_expr_is_heap instead of agg_info_of_type_expr. This is the \"read the\n/// declared signature\" alternative to threading checker-inferred types\n/// through codegen: `let mut s = Set::new()` can be classified correctly by\n/// looking up `Set::new`'s OWN `-> Set[T]` annotation (already sitting on the\n/// AST, no unification/inference needed) instead of guessing from the RHS\n/// expression's shape. Only covers named, annotated top-level functions --\n/// classify_let_value_heap (compile_expr_tail.vibe) falls back to its\n/// existing \"any ECall is heap by default\" over-approximation when a callee\n/// isn't found here (unannotated function, local closure, shadowed name),\n/// so this is a precision refinement, not a completeness requirement.\nexport fn compute_heap_returning(stmts: Array[Stmt]) -> Array[String] {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, ann, value) => match value {\n        EFn(_, _, _, fn_ret, _, _) => {\n          let ret = match ann {\n            Some(at) => match at {\n              TyFn(_, r, _) => Some(r),\n              _ => fn_ret\n            },\n            None => fn_ret\n          }\n          if type_expr_is_heap(ret) {\n            Array::push(out, name)\n          } else {\n            ()\n          }\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn collect_ctor_names(stmts: Array[Stmt]) -> Array[String] {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEnum(_, _, _, variants, _) => {\n        let mut j = 0\n        while j < Array::length(variants) {\n          let (vn, _) = Array::get(variants, j)\n          Array::push(out, vn)\n          j = j + 1\n        }\n      },\n      SSuberror(_, _, variants) => {\n        let mut j = 0\n        while j < Array::length(variants) {\n          let (vn, _) = Array::get(variants, j)\n          Array::push(out, vn)\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn inferred_heap_type() -> TypeExpr {\n  TyTuple(array_empty())\n}\n\nfn fill_lambda_params(name: String, efn: Expr, body: Expr, hctx: HeapInferCtx) -> Expr {\n  match efn {\n    EFn(tps, bounds, params, ret, eff, fnbody) => {\n      let calls: Array[Array[Bool]] = [\n      ]\n      let esc = [\n        false\n      ]\n      let env0: Map[String, Bool] = Map::new()\n      analyze_calls(name, body, env0, calls, esc, hctx)\n      if Array::get(esc, 0) || Array::length(calls) == 0 {\n        efn\n      } else {\n        let new_params = Array::slice(params, 0, 0)\n        let mut pi = 0\n        while pi < Array::length(params) {\n          let (pname, pty) = Array::get(params, pi)\n          let filled = match pty {\n            Some(_) => (pname, pty),\n            None =>\n            if all_calls_heap_at(pi, calls) {\n              (pname, Some(inferred_heap_type()))\n            } else {\n              (pname, pty)\n            }\n          }\n          Array::push(new_params, filled)\n          pi = pi + 1\n        }\n        EFn(tps, bounds, new_params, ret, eff, fnbody)\n      }\n    },\n    _ => efn\n  }\n}\n\nfn elaborate_rw(e: Expr, hctx: HeapInferCtx) -> Expr {\n  match e {\n    ELet(n, v, b, soff) => {\n      let v2 = elaborate_rw(v, hctx)\n      let v3 = fill_lambda_params(n, v2, b, hctx)\n      ELet(n, v3, elaborate_rw(b, hctx), soff)\n    },\n    ELetRec(n, v, b) => {\n      let v2 = elaborate_rw(v, hctx)\n      let v3 = fill_lambda_params(n, v2, b, hctx)\n      ELetRec(n, v3, elaborate_rw(b, hctx))\n    },\n    ELetMut(n, v, b, soff) => ELetMut(n, elaborate_rw(v, hctx), elaborate_rw(b, hctx), soff),\n    EAssign(n, v, c) => EAssign(n, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),\n    ESeq(a, b) => ESeq(elaborate_rw(a, hctx), elaborate_rw(b, hctx)),\n    EIf(c, t, el) => EIf(elaborate_rw(c, hctx), elaborate_rw(t, hctx), elaborate_rw(el, hctx)),\n    EWhile(c, b) => EWhile(elaborate_rw(c, hctx), elaborate_rw(b, hctx)),\n    EForIn(n, ix, it, b) => EForIn(n, ix, elaborate_rw(it, hctx), elaborate_rw(b, hctx)),\n    EFn(tps, bounds, params, ret, eff, fb) =>\n    EFn(tps, bounds, params, ret, eff, elaborate_rw(fb, hctx)),\n    ECall(callee, args, off) => {\n      let new_args = Array::slice(args, 0, 0)\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(new_args, elaborate_rw(Array::get(args, i), hctx))\n        i = i + 1\n      }\n      ECall(elaborate_rw(callee, hctx), new_args, off)\n    },\n    EBinOp(op, l, r) => EBinOp(op, elaborate_rw(l, hctx), elaborate_rw(r, hctx)),\n    EUnaryOp(op, o) => EUnaryOp(op, elaborate_rw(o, hctx)),\n    EDot(o, f, off, fdoff) => EDot(elaborate_rw(o, hctx), f, off, fdoff),\n    ETuple(xs) => {\n      let ys = Array::slice(xs, 0, 0)\n      let mut i = 0\n      while i < Array::length(xs) {\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\n        i = i + 1\n      }\n      ETuple(ys)\n    },\n    EArray(xs) => {\n      let ys = Array::slice(xs, 0, 0)\n      let mut i = 0\n      while i < Array::length(xs) {\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\n        i = i + 1\n      }\n      EArray(ys)\n    },\n    EMatch(s, arms) => {\n      let new_arms = Array::slice(arms, 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ab) = Array::get(arms, i)\n        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))\n        i = i + 1\n      }\n      EMatch(elaborate_rw(s, hctx), new_arms)\n    },\n    EHandle(b, arms) => {\n      let new_arms = Array::slice(arms, 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ab) = Array::get(arms, i)\n        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))\n        i = i + 1\n      }\n      EHandle(elaborate_rw(b, hctx), new_arms)\n    },\n    ELoop(ps, b) => {\n      let new_ps = Array::slice(ps, 0, 0)\n      let mut i = 0\n      while i < Array::length(ps) {\n        let (pn, iv) = Array::get(ps, i)\n        Array::push(new_ps, (pn, elaborate_rw(iv, hctx)))\n        i = i + 1\n      }\n      ELoop(new_ps, elaborate_rw(b, hctx))\n    },\n    ERecord(rn, fs, targs) => {\n      let new_fs = Array::slice(fs, 0, 0)\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (fn0, fv) = Array::get(fs, i)\n        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))\n        i = i + 1\n      }\n      ERecord(rn, new_fs, targs)\n    },\n    EMap(fs) => {\n      let new_fs = Array::slice(fs, 0, 0)\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (fn0, fv) = Array::get(fs, i)\n        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))\n        i = i + 1\n      }\n      EMap(new_fs)\n    },\n    ELabeledArg(l, k, x) => ELabeledArg(l, k, elaborate_rw(x, hctx)),\n    EReturn(x) => EReturn(elaborate_rw(x, hctx)),\n    ESpread(x) => ESpread(elaborate_rw(x, hctx)),\n    EBreak(o) =>\n    match o {\n      Some(x) => EBreak(Some(elaborate_rw(x, hctx))),\n      None => EBreak(None)\n    },\n    EContinue(xs) => {\n      let ys = Array::slice(xs, 0, 0)\n      let mut i = 0\n      while i < Array::length(xs) {\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\n        i = i + 1\n      }\n      EContinue(ys)\n    },\n    EInt(_) => e,\n    EFloat(_) => e,\n    EString(_) => e,\n    EBool(_) => e,\n    EIdent(_, _) => e,\n    EStringInterp(_) => e,\n    EUnit => e\n  }\n}\n\nfn is_borrow_arg0_call(f: String) -> Bool {\n  f == \"__index\" || f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Array::push\" || f == \"Array::push_all\" || f == \"ArrayBuilder::push\" || f == \"MutList::push\" || f == \"StringBuilder::push\" || f == \"MapBuilder::set\" || f == \"Map::get\" || f == \"Map::keys\" || f == \"Map::has_key\" || f == \"Map::has\" || f == \"Map::set\" || f == \"Map::size\" || f == \"Map::values\" || f == \"Map::delete\" || f == \"Bytes::push\" || f == \"Bytes::set\" || f == \"Bytes::get\" || f == \"Bytes::length\" || f == \"FrozenArray::get\" || f == \"FrozenArray::length\" || f == \"FixedArray::get\" || f == \"FixedArray::set\" || f == \"FixedArray::length\" || f == \"String::join\" || f == \"eq\" || f == \"__rec_field\"\n}\n\nexport fn pc_emit(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int {\n  match expr {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(x, _) => pe_use(ctx, scope, x),\n    ECall(callee, args, _) => {\n      let is_index = match callee {\n        EIdent(f, _) => is_borrow_arg0_call(f) || array_contains_str_pctx(ctx.borrow_arg0_user, f),\n        _ => false\n      }\n      match callee {\n        EIdent(_, _) => 0,\n        _ => pc_emit(ctx, scope, callee)\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        let arg = Array::get(args, i)\n        if is_index && i == 0 {\n          match arg {\n            EIdent(_, _) => 0,\n            _ => pc_emit(ctx, scope, arg)\n          }\n        } else {\n          pc_emit(ctx, scope, arg)\n        }\n        i = i + 1\n      }\n      0\n    },\n    EDot(obj, _field, _, _) => match obj {\n      EIdent(_, _) => 0,\n      _ => pc_emit(ctx, scope, obj)\n    }\n    ,\n    ELet(name, value, body, _) => {\n      let mut elide_dead_alias = false\n      match value {\n        EIdent(src, _) => {\n          if Map::has_key(scope, src) {\n            let sid = Map::get(scope, src)\n            let rem = Array::get(ctx.remaining, sid)\n            if rem > 1 && !Array::get(ctx.scalar, sid) {\n              // #1056 (almide `alias_safety.rs` comparison, rc check\n              // elision): this occurrence of `let name = src` would dup\n              // src's reference into `name`'s own slot. `ctx.next_id` is\n              // about to become `name`'s id (pe_declare below); `ctx.uses`\n              // at that id already holds `name`'s FINAL use count from the\n              // pc_count pass (borrow occurrences folded in by\n              // pctx_apply_borrow_retention, which runs before pc_emit\n              // starts) -- ids are assigned in identical tree order across\n              // both passes (see build_perceus_plan), so this id is exactly\n              // the one pc_count computed uses for. If that count is zero,\n              // `name` has NO occurrence anywhere in `body` (no owning use,\n              // no borrow): the dup this occurrence would emit and the\n              // unconditional scope-end drop `name` would otherwise get\n              // (pe_scope_end -- an unused non-scalar binding always keeps\n              // its one owned reference) are a pure no-op pair on the SAME\n              // memory with no intervening read -- increment then\n              // decrement, nothing observes the difference. Skipping both\n              // (no PaAliasDup here; `name`'s own `remaining` is zeroed\n              // right after pe_declare below so pe_scope_end's `remaining >\n              // 0` check does not fire) removes one dup + one drop of\n              // runtime rc traffic with no change in observable behavior.\n              // `src`'s own remaining-use bookkeeping is untouched (still\n              // decremented below exactly as without this elision) -- this\n              // occurrence still \"spends\" one of src's owning uses,\n              // precisely as if the dup had fired, so src's later\n              // occurrences / scope-end drop are unaffected.\n              if Array::get(ctx.uses, ctx.next_id) == 0 {\n                elide_dead_alias = true\n                0\n              } else {\n                pe_push(ctx, PaAliasDup, name)\n              }\n            } else {\n              0\n            }\n            if rem > 0 {\n              Array::set(ctx.remaining, sid, rem - 1)\n            }\n          } else {\n            ()\n          }\n          0\n        },\n        _ => pc_emit(ctx, scope, value)\n      }\n      let id = pe_declare(ctx, name)\n      if elide_dead_alias {\n        Array::set(ctx.remaining, id, 0)\n      }\n      pc_emit(ctx, Map::set(scope, name, id), body)\n      pe_scope_end(ctx, id, name)\n    },\n    ELetMut(name, value, body, _) => {\n      pc_emit(ctx, scope, value)\n      let id = pe_declare(ctx, name)\n      pc_emit(ctx, Map::set(scope, name, id), body)\n      pe_scope_end(ctx, id, name)\n    },\n    ELetRec(name, value, body) => {\n      let id = pe_declare(ctx, name)\n      let s2 = Map::set(scope, name, id)\n      pc_emit(ctx, s2, value)\n      pc_emit(ctx, s2, body)\n      pe_scope_end(ctx, id, name)\n    },\n    EAssign(_name, value, body) => {\n      pc_emit(ctx, scope, value)\n      pc_emit(ctx, scope, body)\n    },\n    EAssignOp(_op, _name, value, body) => {\n      pc_emit(ctx, scope, value)\n      pc_emit(ctx, scope, body)\n    },\n    ESeq(a, b) => {\n      pc_emit(ctx, scope, a)\n      let nm = next_seq_name(ctx)\n      let id = pe_declare(ctx, nm)\n      pc_emit(ctx, scope, b)\n      pe_scope_end(ctx, id, nm)\n    },\n    EBinOp(_op, l, r) => {\n      pc_emit(ctx, scope, l)\n      pc_emit(ctx, scope, r)\n    },\n    EUnaryOp(_op, e) => pc_emit(ctx, scope, e),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_emit(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_emit(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_emit(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_emit(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      pc_emit(ctx, scope, cond)\n      let snap = copy_ints(ctx.remaining)\n      pc_emit(ctx, scope, then_e)\n      // #1100 alloc cut: swap the prefix instead of taking a SECOND copy —\n      // one pass both restores `remaining` to the pre-branch values (what\n      // restore_prefix did) and captures the then-branch's values into\n      // `snap`'s buffer (what the `then_rem` copy was for). Same values in\n      // the same places, one allocation instead of two per `if`; the\n      // branch-snapshot copies were the plan's largest allocation source\n      // on a full-closure compile.\n      let mut sw = 0\n      while sw < Array::length(snap) {\n        let then_v = Array::get(ctx.remaining, sw)\n        Array::set(ctx.remaining, sw, Array::get(snap, sw))\n        Array::set(snap, sw, then_v)\n        sw = sw + 1\n      }\n      pc_emit(ctx, scope, else_e)\n      // #705: leave the MIN remaining over both branches. A binding consumed in\n      // one branch (e.g. a param threaded into a ctor in the `then`) but not the\n      // other was previously left at the `else` branch's (higher) remaining, so\n      // the scope-end drop fired on a value the taken branch already moved out —\n      // a double free. Min means a binding consumed on ANY path is not\n      // re-dropped (the non-consuming path leaks one ref, which is safe) instead\n      // of the consuming path double-freeing (crash). Prefix-only (outer ids).\n      // (`snap` holds the THEN branch's values after the swap above.)\n      let mut i = 0\n      while i < Array::length(snap) {\n        if Array::get(snap, i) < Array::get(ctx.remaining, i) {\n          Array::set(ctx.remaining, i, Array::get(snap, i))\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      pc_emit(ctx, scope, cond)\n      pc_emit(ctx, scope, body)\n    },\n    EReturn(e) => pc_emit(ctx, scope, e),\n    ESpread(e) => pc_emit(ctx, scope, e),\n    ELabeledArg(_l, _n, e) => pc_emit(ctx, scope, e),\n    EBreak(opt) => match opt {\n      Some(e) => pc_emit(ctx, scope, e),\n      None => 0\n    }\n    ,\n    EFn(_tp, _tb, params, _ret, _eff, fbody) => {\n      let caps = collect_free_vars(fbody, fn_param_names(params), [\n      ])\n      let mut i = 0\n      while i < Array::length(caps) {\n        pe_use(ctx, scope, Array::get(caps, i))\n        i = i + 1\n      }\n      0\n    },\n    EForIn(value_name, index_opt, iterable, fbody) => {\n      pc_emit(ctx, scope, iterable)\n      let idv = pe_declare(ctx, value_name)\n      let s2 = Map::set(scope, value_name, idv)\n      let s3 = match index_opt {\n        Some(idx) => {\n          let idi = pe_declare(ctx, idx)\n          Map::set(s2, idx, idi)\n        },\n        None => s2\n      }\n      pc_emit(ctx, s3, fbody)\n      pe_scope_end(ctx, idv, value_name)\n    },\n    ELoop(params, lbody) => {\n      let mut s = scope\n      let pids: Array[Int] = [\n      ]\n      let pnames: Array[String] = [\n      ]\n      let mut i = 0\n      while i < Array::length(params) {\n        let p = Array::get(params, i)\n        pc_emit(ctx, scope, p.1)\n        let pid = pe_declare(ctx, p.0)\n        s = Map::set(s, p.0, pid)\n        Array::push(pids, pid)\n        Array::push(pnames, p.0)\n        i = i + 1\n      }\n      pc_emit(ctx, s, lbody)\n      let mut j = 0\n      while j < Array::length(pids) {\n        pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\n        j = j + 1\n      }\n      0\n    },\n    EMatch(scrut, arms) => {\n      match scrut {\n        EIdent(_, _) => 0,\n        _ => pc_emit(ctx, scope, scrut)\n      }\n      let snap = copy_ints(ctx.remaining)\n      // #705: track the MIN remaining over all arms (see EIf). An arm that\n      // consumes an outer binding (e.g. a param re-stored into a ctor) leaves it\n      // at a lower remaining; leaving the LAST arm's (higher) value made the\n      // scope-end drop double-free that binding on the arm that consumed it.\n      let minrem = copy_ints(snap)\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.remaining, snap)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let pids: Array[Int] = [\n        ]\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pe_declare(ctx, nm)\n          s = Map::set(s, nm, pid)\n          Array::push(pids, pid)\n          k = k + 1\n        }\n        pc_emit(ctx, s, arm.1)\n        let mut j = 0\n        while j < Array::length(pids) {\n          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\n          j = j + 1\n        }\n        let mut mi = 0\n        while mi < Array::length(snap) {\n          if Array::get(ctx.remaining, mi) < Array::get(minrem, mi) {\n            Array::set(minrem, mi, Array::get(ctx.remaining, mi))\n          } else {\n            ()\n          }\n          mi = mi + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.remaining, minrem)\n      0\n    },\n    EHandle(hbody, arms) => {\n      let snap = copy_ints(ctx.remaining)\n      pc_emit(ctx, scope, hbody)\n      let minrem = copy_ints(ctx.remaining)\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.remaining, snap)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let pids: Array[Int] = [\n        ]\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pe_declare(ctx, nm)\n          s = Map::set(s, nm, pid)\n          Array::push(pids, pid)\n          k = k + 1\n        }\n        pc_emit(ctx, s, arm.1)\n        let mut j = 0\n        while j < Array::length(pids) {\n          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\n          j = j + 1\n        }\n        let mut mi = 0\n        while mi < Array::length(snap) {\n          if Array::get(ctx.remaining, mi) < Array::get(minrem, mi) {\n            Array::set(minrem, mi, Array::get(ctx.remaining, mi))\n          } else {\n            ()\n          }\n          mi = mi + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.remaining, minrem)\n      0\n    },\n    _ => 0\n  }\n}\n\nexport fn pc_count(ctx: PCtx, scope: Map[String, Int], expr: Expr) -> Int {\n  match expr {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(x, _) => pc_count_use(ctx, scope, x),\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(f, _) => if is_borrow_arg0_call(f) || array_contains_str_pctx(ctx.borrow_arg0_user, f) {\n          0\n        } else {\n          pc_count_borrow(ctx, scope, f)\n        }\n        ,\n        _ => pc_count(ctx, scope, callee)\n      }\n      let is_index = match callee {\n        EIdent(f, _) => is_borrow_arg0_call(f) || array_contains_str_pctx(ctx.borrow_arg0_user, f),\n        _ => false\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        let arg = Array::get(args, i)\n        if is_index && i == 0 {\n          match arg {\n            EIdent(obj, _) => pc_count_borrow(ctx, scope, obj),\n            _ => pc_count(ctx, scope, arg)\n          }\n        } else {\n          pc_count(ctx, scope, arg)\n        }\n        i = i + 1\n      }\n      0\n    },\n    EDot(obj, _field, _, _) => match obj {\n      EIdent(x, _) => pc_count_borrow(ctx, scope, x),\n      _ => pc_count(ctx, scope, obj)\n    }\n    ,\n    ELet(name, value, body, _) => {\n      pc_count(ctx, scope, value)\n      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))\n      let _ = pctx_mark_view_call(ctx, id, value)\n      pc_count(ctx, Map::set(scope, name, id), body)\n    },\n    ELetMut(name, value, body, _) => {\n      pc_count(ctx, scope, value)\n      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))\n      let _ = pctx_mark_view_call(ctx, id, value)\n      pc_count(ctx, Map::set(scope, name, id), body)\n    },\n    ELetRec(name, value, body) => {\n      let id = pc_declare(ctx, name, false)\n      let s2 = Map::set(scope, name, id)\n      pc_count(ctx, s2, value)\n      pc_count(ctx, s2, body)\n    },\n    EAssign(_name, value, body) => {\n      pc_count(ctx, scope, value)\n      pc_count(ctx, scope, body)\n    },\n    EAssignOp(_op, _name, value, body) => {\n      pc_count(ctx, scope, value)\n      pc_count(ctx, scope, body)\n    },\n    ESeq(a, b) => {\n      pc_count(ctx, scope, a)\n      let nm = next_seq_name(ctx)\n      let _id = pc_declare(ctx, nm, is_scalar_expr(ctx, a))\n      pc_count(ctx, scope, b)\n    },\n    EBinOp(_op, l, r) => {\n      pc_count(ctx, scope, l)\n      pc_count(ctx, scope, r)\n    },\n    EUnaryOp(_op, e) => pc_count(ctx, scope, e),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_count(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_count(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_count(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_count(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      pc_count(ctx, scope, cond)\n      let snap_u = copy_ints(ctx.uses)\n      let snap_b = copy_ints(ctx.borrows)\n      pc_count(ctx, scope, then_e)\n      // #1100 alloc cut: swap the prefixes instead of taking SECOND copies\n      // (`then_u`/`then_b`) — one pass restores uses/borrows to the\n      // pre-branch values and captures the then-branch's values into the\n      // snap buffers. 2 allocations per `if` instead of 4.\n      let mut sw = 0\n      while sw < Array::length(snap_u) {\n        let tu = Array::get(ctx.uses, sw)\n        Array::set(ctx.uses, sw, Array::get(snap_u, sw))\n        Array::set(snap_u, sw, tu)\n        let tb = Array::get(ctx.borrows, sw)\n        Array::set(ctx.borrows, sw, Array::get(snap_b, sw))\n        Array::set(snap_b, sw, tb)\n        sw = sw + 1\n      }\n      pc_count(ctx, scope, else_e)\n      // Merge = per-id MAX over the two branches. The previous delta form\n      // (`base + max(then - base, else - base)`) is algebraically the same\n      // number — the base cancels — so dropping it changes no plan. After\n      // the swap above, snap_u/snap_b hold the THEN branch's values and\n      // ctx.uses/ctx.borrows hold the ELSE branch's.\n      let mut id = 0\n      while id < Array::length(snap_u) {\n        Array::set(ctx.uses, id, int_max(Array::get(snap_u, id), Array::get(ctx.uses, id)))\n        Array::set(ctx.borrows, id, int_max(Array::get(snap_b, id), Array::get(ctx.borrows, id)))\n        id = id + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      pc_count(ctx, scope, cond)\n      pc_count(ctx, scope, body)\n    },\n    EReturn(e) => pc_count(ctx, scope, e),\n    ESpread(e) => pc_count(ctx, scope, e),\n    ELabeledArg(_l, _n, e) => pc_count(ctx, scope, e),\n    EBreak(opt) => match opt {\n      Some(e) => pc_count(ctx, scope, e),\n      None => 0\n    }\n    ,\n    EFn(_tp, _tb, params, _ret, _eff, fbody) => {\n      let caps = collect_free_vars(fbody, fn_param_names(params), [\n      ])\n      let mut i = 0\n      while i < Array::length(caps) {\n        pc_count_use(ctx, scope, Array::get(caps, i))\n        i = i + 1\n      }\n      0\n    },\n    EForIn(value_name, index_opt, iterable, fbody) => {\n      pc_count(ctx, scope, iterable)\n      let idv = pc_declare(ctx, value_name, false)\n      let s2 = Map::set(scope, value_name, idv)\n      let s3 = match index_opt {\n        Some(idx) => {\n          let idi = pc_declare(ctx, idx, true)\n          Map::set(s2, idx, idi)\n        },\n        None => s2\n      }\n      pc_count(ctx, s3, fbody)\n    },\n    ELoop(params, lbody) => {\n      let mut s = scope\n      let mut i = 0\n      while i < Array::length(params) {\n        let p = Array::get(params, i)\n        pc_count(ctx, scope, p.1)\n        let pid = pc_declare(ctx, p.0, is_scalar_expr(ctx, p.1))\n        s = Map::set(s, p.0, pid)\n        i = i + 1\n      }\n      pc_count(ctx, s, lbody)\n    },\n    EMatch(scrut, arms) => {\n      match scrut {\n        EIdent(sx, _) => pc_count_borrow(ctx, scope, sx),\n        _ => pc_count(ctx, scope, scrut)\n      }\n      let snap_u = copy_ints(ctx.uses)\n      let snap_b = copy_ints(ctx.borrows)\n      let max_u = zeros(Array::length(snap_u))\n      let max_b = zeros(Array::length(snap_b))\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.uses, snap_u)\n        restore_prefix(ctx.borrows, snap_b)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pc_declare(ctx, nm, false)\n          s = Map::set(s, nm, pid)\n          k = k + 1\n        }\n        pc_count(ctx, s, arm.1)\n        let mut id = 0\n        while id < Array::length(snap_u) {\n          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)\n          if du > Array::get(max_u, id) {\n            Array::set(max_u, id, du)\n          }\n          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)\n          if db > Array::get(max_b, id) {\n            Array::set(max_b, id, db)\n          }\n          id = id + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.uses, snap_u)\n      restore_prefix(ctx.borrows, snap_b)\n      let mut id2 = 0\n      while id2 < Array::length(snap_u) {\n        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))\n        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))\n        id2 = id2 + 1\n      }\n      0\n    },\n    EHandle(hbody, arms) => {\n      let snap_u = copy_ints(ctx.uses)\n      let snap_b = copy_ints(ctx.borrows)\n      let max_u = zeros(Array::length(snap_u))\n      let max_b = zeros(Array::length(snap_b))\n      pc_count(ctx, scope, hbody)\n      let mut id0 = 0\n      while id0 < Array::length(snap_u) {\n        let du = Array::get(ctx.uses, id0) - Array::get(snap_u, id0)\n        if du > Array::get(max_u, id0) {\n          Array::set(max_u, id0, du)\n        }\n        let db = Array::get(ctx.borrows, id0) - Array::get(snap_b, id0)\n        if db > Array::get(max_b, id0) {\n          Array::set(max_b, id0, db)\n        }\n        id0 = id0 + 1\n      }\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.uses, snap_u)\n        restore_prefix(ctx.borrows, snap_b)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pc_declare(ctx, nm, false)\n          s = Map::set(s, nm, pid)\n          k = k + 1\n        }\n        pc_count(ctx, s, arm.1)\n        let mut id = 0\n        while id < Array::length(snap_u) {\n          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)\n          if du > Array::get(max_u, id) {\n            Array::set(max_u, id, du)\n          }\n          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)\n          if db > Array::get(max_b, id) {\n            Array::set(max_b, id, db)\n          }\n          id = id + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.uses, snap_u)\n      restore_prefix(ctx.borrows, snap_b)\n      let mut id2 = 0\n      while id2 < Array::length(snap_u) {\n        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))\n        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))\n        id2 = id2 + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\n/// #706 follow-up (borrow-after-move): a binding with any BORROW occurrence\n/// (ctx.borrows[id] > 0 — computed branch-aware, max-across-if/match-arms,\n/// alongside ctx.uses above) must stay alive through that borrow, regardless of\n/// whether the borrow comes BEFORE or AFTER the binding's owning (consuming)\n/// occurrences. `pc_emit`/`pe_use` only track OWNING occurrences (ctx.uses) when\n/// deciding dup vs. free-transfer — borrows are invisible to that decision. If a\n/// binding's textually LAST owning occurrence is treated as \"the final, free\n/// consume\" (no dup; ownership transfers to the callee) and a borrow occurs\n/// AFTER that point, the borrow reads through a reference the callee may already\n/// have dropped — a silent use-after-free. This was masked in practice by other\n/// RC leaks (loop-consume before #706's core fix; the loop-consume LEAK before\n/// its own follow-up fix) that happened to keep the value alive by accident; see\n/// #706 for the wat_exports/parse_module_sections repro that exposed it once\n/// those leaks were tightened.\n///\n/// Fix: bump the binding's counted `uses` by exactly one whenever it has ANY\n/// borrow occurrence. This is a pure post-processing step over the FINAL,\n/// branch-merge-complete `uses`/`borrows` arrays (called after `pc_count`\n/// finishes, before the emission pass begins), so it does not interact with the\n/// max-across-branches counting logic itself — it only adjusts the total input\n/// the REST of the system (pe_declare's `remaining` init, pc_emit's sequential\n/// dup decisions, pe_scope_end's drop decision) already handles correctly for \"K\n/// owning occurrences\": with K bumped to K+1, the occurrence that used to be a\n/// free-transfer gets a dup like any other, and the binding's normal scope-end\n/// drop (already emitted whenever `remaining` ends > 0 — e.g. the existing\n/// borrow-only / K=0 baseline) picks up the now-nonzero leftover. No new\n/// PerceusAction kind, no change to pc_emit or the codegen dup/drop realization.\n/// For a binding with ZERO owning occurrences (pure borrow — the already-correct\n/// baseline), this is a no-op: pe_declare already treats uses==0 like uses==1.\nfn pctx_apply_borrow_retention(ctx: PCtx) -> Int {\n  let mut bid = 0\n  while bid < ctx.next_id {\n    Array::push(ctx.owned_uses, Array::get(ctx.uses, bid))\n    if Array::get(ctx.borrows, bid) > 0 {\n      Array::set(ctx.uses, bid, Array::get(ctx.uses, bid) + 1)\n    } else {\n      ()\n    }\n    bid = bid + 1\n  }\n  0\n}\n\n/// Build the dup/drop plan for a function body expression.\nexport fn build_perceus_plan(body: Expr) -> Array[PerceusAction] {\n  let ctx = pctx_new([\n  ], [\n  ], [\n  ])\n  let empty: Map[String, Int] = Map::new()\n  pc_count(ctx, empty, body)\n  pctx_apply_borrow_retention(ctx)\n  ctx.next_id = 0\n  ctx.seq_id = 0\n  pc_emit(ctx, empty, body)\n  ctx.actions\n}\n\nfn collect_heap_ret_fns(stmts: Array[Stmt]) -> Array[String] {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, oty, _) =>\n      match oty {\n        Some(ty) =>\n        match ty {\n          TyFn(_, ret, _) =>\n          if type_expr_is_heap(Some(ret)) {\n            Array::push(out, fname)\n          } else {\n            ()\n          },\n          _ => ()\n        },\n        None => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn elaborate_heap_params(stmts: Array[Stmt]) -> Array[Stmt] {\n  let hctx = HeapInferCtx::{\n    ctors: collect_ctor_names(stmts),\n    heap_fns: collect_heap_ret_fns(stmts),\n  }\n  let out = Array::slice(stmts, 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let s = Array::get(stmts, i)\n    let s2 = match s {\n      SLet(a, b, n, t, e) => SLet(a, b, n, t, elaborate_rw(e, hctx)),\n      SExpr(e) => SExpr(elaborate_rw(e, hctx)),\n      _ => s\n    }\n    Array::push(out, s2)\n    i = i + 1\n  }\n  out\n}\n\nfn expr_projects_or_matches(name: String, e: Expr) -> Bool {\n  match e {\n    EDot(obj, _, _, _) =>\n    match obj {\n      EIdent(n, _) => n == name,\n      _ => expr_projects_or_matches(name, obj)\n    },\n    EMatch(scrut, arms) => {\n      let hit = match scrut {\n        EIdent(n, _) => n == name,\n        _ => expr_projects_or_matches(name, scrut)\n      }\n      if hit {\n        true\n      } else {\n        let mut i = 0\n        let mut found = false\n        while i < Array::length(arms) {\n          let (_, arm_body) = Array::get(arms, i)\n          if expr_projects_or_matches(name, arm_body) {\n            found = true\n          } else {\n            ()\n          }\n          i = i + 1\n        }\n        found\n      }\n    },\n    EHandle(body, arms) => {\n      let mut i = 0\n      let mut found = expr_projects_or_matches(name, body)\n      while i < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, i)\n        if expr_projects_or_matches(name, arm_body) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELet(_, val, body, _) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\n    ELetRec(_, val, body) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\n    ELetMut(_, val, body, _) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\n    EAssign(_, val, cont) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),\n    EAssignOp(_, _, val, cont) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),\n    ESeq(a, b) =>\n    expr_projects_or_matches(name, a) || expr_projects_or_matches(name, b),\n    EIf(c, t, el) =>\n    expr_projects_or_matches(name, c) ||\n    expr_projects_or_matches(name, t) ||\n    expr_projects_or_matches(name, el),\n    EWhile(c, b) =>\n    expr_projects_or_matches(name, c) || expr_projects_or_matches(name, b),\n    EForIn(_, _, iter, body) =>\n    expr_projects_or_matches(name, iter) || expr_projects_or_matches(name, body),\n    ECall(callee, args, _) => {\n      let mut i = 0\n      let mut found = expr_projects_or_matches(name, callee)\n      while i < Array::length(args) {\n        if expr_projects_or_matches(name, Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EBinOp(_, l, r) =>\n    expr_projects_or_matches(name, l) || expr_projects_or_matches(name, r),\n    EUnaryOp(_, o) => expr_projects_or_matches(name, o),\n    EFn(_, _, _, _, _, body) => expr_projects_or_matches(name, body),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_projects_or_matches(name, Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_projects_or_matches(name, Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELoop(params, body) => {\n      let mut i = 0\n      let mut found = expr_projects_or_matches(name, body)\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        if expr_projects_or_matches(name, init) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_projects_or_matches(name, fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_projects_or_matches(name, fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELabeledArg(_, _, inner) => expr_projects_or_matches(name, inner),\n    EReturn(inner) => expr_projects_or_matches(name, inner),\n    ESpread(inner) => expr_projects_or_matches(name, inner),\n    EBreak(opt) =>\n    match opt {\n      Some(inner) => expr_projects_or_matches(name, inner),\n      None => false\n    },\n    EContinue(args) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if expr_projects_or_matches(name, Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EInt(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EBool(_) => false,\n    EIdent(_, _) => false,\n    EStringInterp(_) => false,\n    EUnit => false\n  }\n}\n\n/// Heap-ness decision for an owned parameter: the type annotation says heap, or\n/// (when unannotated) the body proves it via projection/match. Used by the\n/// Perceus plan and codegen so an unannotated nested-closure param that is\n/// projected no longer leaks its owned argument (ADR-0055 Stage 4).\nexport fn param_is_heap_in_body(name: String, otype: Option[TypeExpr], body: Expr) -> Bool {\n  if type_expr_is_heap(otype) {\n    true\n  } else {\n    match otype {\n      None => expr_projects_or_matches(name, body),\n      Some(_) => false\n    }\n  }\n}\n\n/// Build the plan for a function whose parameters are owned heap values. Params\n/// are declared as bindings (in count + emit lockstep, same ids) so the existing\n/// machinery emits a PaDrop for a borrowed-only/unused heap param and a PaDup for\n/// one used in multiple owning positions. Heap-ness comes from the param's type\n/// annotation (scalar params get scalar=true so they are never dropped).\nexport fn build_perceus_plan_with_params(params: Array[(String, Option[TypeExpr])], body: Expr, borrow_ret_names: Array[String], borrow_arg0_fns: Array[String], view_ret_fns: Array[String]) -> Array[PerceusAction] {\n  let ctx = pctx_new(borrow_ret_names, borrow_arg0_fns, view_ret_fns)\n  let mut scope: Map[String, Int] = Map::new()\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, ptype) = Array::get(params, pi)\n    let id = pc_declare(ctx, pname, !param_is_heap_in_body(pname, ptype, body))\n    scope = Map::set(scope, pname, id)\n    pi = pi + 1\n  }\n  pc_count(ctx, scope, body)\n  pctx_apply_borrow_retention(ctx)\n  ctx.next_id = 0\n  ctx.seq_id = 0\n  let mut scope2: Map[String, Int] = Map::new()\n  let param_ids = array_empty()\n  let mut pj = 0\n  while pj < Array::length(params) {\n    let (pname, _) = Array::get(params, pj)\n    let id = pe_declare(ctx, pname)\n    scope2 = Map::set(scope2, pname, id)\n    Array::push(param_ids, id)\n    pj = pj + 1\n  }\n  pc_emit(ctx, scope2, body)\n  let mut pk = 0\n  while pk < Array::length(params) {\n    let (pname, _) = Array::get(params, pk)\n    pe_scope_end(ctx, Array::get(param_ids, pk), pname)\n    pk = pk + 1\n  }\n  ctx.actions\n}\n")
}

