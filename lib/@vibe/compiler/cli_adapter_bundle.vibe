Array[String]) -> Map[String, Bool]\nfn compile_wasi_module_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_coverage_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_trace_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_break_impl(stmts: Array[Stmt], entry_name: String, prov: DbgProv) -> Bytes with { Error }\nfn compile_wasi_module_with_sources_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error }\nfn compile_wasi_module_with_sources_coverage_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error }\nfn compile_wasi_module_with_sources_trace_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error }\nfn compile_wasi_module_with_sources_break_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], prov: DbgProv) -> Bytes with { Error }\nfn compile_wasi_module_linked_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool, enable_rc: Bool, coverage: Bool, debug_trace: Bool, debug_break: Bool, rc_shadow: Bool, prov: DbgProv) -> Bytes with { Error }\nfn compile_wasi_module_rc_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with { Error }\nfn compile_wasi_module_rc_shadow_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with { Error }\n")
