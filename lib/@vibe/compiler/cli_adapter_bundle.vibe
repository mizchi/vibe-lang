emit_i64_extend_i32_u(b)\n  emit_local_set(b, 6)\n  // is_id = digit + upper + lower + underscore (mutually exclusive => 0 or 1).\n  // each range is (byte >= lo) * (byte <= hi) via i64 compares + i32.mul.\n  emit_local_get(b, 6)\n  emit_i64_const(b, 48)\n  emit_i64_ge_s(b)\n  emit_local_get(b, 6)\n  emit_i64_const(b, 57)\n  emit_i64_le_s(b)\n  emit_i32_mul(b)\n  emit_local_get(b, 6)\n  emit_i64_const(b, 65)\n  emit_i64_ge_s(b)\n  emit_local_get(b, 6)\n  emit_i64_const(b, 90)\n  emit_i64_le_s(b)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_local_get(b, 6)\n  emit_i64_const(b, 97)\n  emit_i64_ge_s(b)\n  emit_local_get(b, 6)\n  emit_i64_const(b, 122)\n  emit_i64_le_s(b)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_local_get(b, 6)\n  emit_i64_const(b, 95)\n  emit_i64_eq(b)\n  emit_i32_add(b)\n  // if NOT an identifier byte, stop\n  emit_i32_eqz(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 4)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  // return tag(p)\n  emit_local_get(b, 4)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  b\n}\n\nexport fn gen_bytes_new_body() -> Bytes {\n  let b = bytebuf_new()\n  emit_global_get(b, 0)\n  emit_local_tee(b, 0)\n  emit_i32_const(b, 76)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  emit_heap_memory_grow_check(b)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 0 - 64)\n  emit_i32_store(b, 2, 0)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 0)\n  emit_i32_store(b, 2, 4)\n  emit_local_get(b, 0)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 12)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 8)\n  emit_local_get(b, 0)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\nexport fn gen_bytes_set_body(enable_rc: Bool) -> Bytes {\n  let b = bytebuf_new()\n  // #811: unsigned bounds check (idx as u32 >= len traps; negatives too).\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)\n  emit_i32_ge_u(b)\n  emit_if_void(b)\n  bytebuf_push(b, 0)\n  emit_end(b)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 3)\n  emit_local_get(b, 3)\n  emit_local_get(b, 1)\n  // ADR-0055 Stage 1: index arrives tagged; untag before use.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_local_get(b, 2)\n  // ADR-0055 Stage 1: byte value arrives tagged; untag before storing.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_store8(b, 0, 0)\n  b\n}\n\nexport fn gen_bytes_blit_body(enable_rc: Bool, bytes_get_idx: Int, bytes_push_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 2)\n  // ADR-0055 Stage 1: start/end indices arrive tagged; untag for loop bounds.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 3)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 5)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 4)\n  emit_local_get(b, 5)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: tag the index passed to the value-world bytes_get.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, bytes_get_idx)\n  emit_call(b, bytes_push_idx)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\nexport fn gen_bytes_fill_body(enable_rc: Bool, bytes_push_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_i32_const(b, 0)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  // ADR-0055 Stage 1: count arrives tagged; untag for the loop bound. The byte\n  // value (local 1) is passed straight to the value-world bytes_push, which\n  // untags it itself.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 4)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, bytes_push_idx)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\nexport fn gen_bytes_push_body(enable_rc: Bool) -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 0)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 4)\n  emit_local_set(b, 4)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 5)\n  emit_i32_const(b, 0)\n  emit_local_get(b, 3)\n  emit_i32_sub(b)\n  emit_local_set(b, 7)\n  emit_local_get(b, 4)\n  emit_local_get(b, 7)\n  emit_i32_ge_u(b)\n  emit_if_void(b)\n  emit_local_get(b, 7)\n  emit_i32_const(b, 2)\n  emit_i32_mul(b)\n  emit_local_set(b, 7)\n  emit_global_get(b, 0)\n  emit_local_tee(b, 6)\n  emit_local_get(b, 7)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  emit_heap_memory_grow_check(b)\n  emit_local_get(b, 6)\n  emit_local_get(b, 5)\n  emit_local_get(b, 4)\n  emit_memory_copy(b)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 0)\n  emit_local_get(b, 7)\n  emit_i32_sub(b)\n  emit_i32_store(b, 2, 0)\n  emit_local_get(b, 2)\n  emit_local_get(b, 6)\n  emit_i32_store(b, 2, 8)\n  emit_local_get(b, 6)\n  emit_local_set(b, 5)\n  emit_end(b)\n  emit_local_get(b, 5)\n  emit_local_get(b, 4)\n  emit_i32_add(b)\n  emit_local_get(b, 1)\n  // ADR-0055 Stage 1: byte value arrives tagged; untag before storing.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_store8(b, 0, 0)\n  emit_local_get(b, 2)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 4)\n  b\n}\n\nexport fn gen_bytes_slice_body(enable_rc: Bool, bytes_new_idx: Int, bytes_get_idx: Int, bytes_push_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_call(b, bytes_new_idx)\n  emit_local_set(b, 5)\n  emit_local_get(b, 1)\n  // ADR-0055 Stage 1: start/end indices arrive tagged; untag for loop bounds.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 4)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 5)\n  emit_local_get(b, 0)\n  emit_local_get(b, 3)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: tag the index passed to the value-world bytes_get.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, bytes_get_idx)\n  emit_call(b, bytes_push_idx)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 5)\n  b\n}\n\nexport fn gen_arr_push_all_body(enable_rc: Bool, rc_alloc_idx: Int, rc_shadow: Bool) -> Bytes {\n  let b = bytebuf_new()\n  if enable_rc {\n    // ADR-0055 Stage 4: in-place append that keeps `a` a valid RC array. Untag\n    // both pointers; grow via vibe_rc_alloc into a headered data block (freeing the\n    // old grown buffer to the free-list, mirroring gen_arr_push); and guard-dup\n    // each appended element from `b` so both `a` and `b` can be dropped safely.\n    // locals: 2=a_val 3=b_val 4=len_a 5=len_b 6=data_a 7=data_b 8=cap_a\n    //         9=newcap 10=block 11=i (i32), 12=elem (i64).\n    emit_local_get(b, 0)\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 2)\n    emit_local_get(b, 1)\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 3)\n    emit_local_get(b, 2)\n    emit_i32_load(b, 2, 4)\n    emit_local_set(b, 4)\n    emit_local_get(b, 3)\n    emit_i32_load(b, 2, 4)\n    emit_local_set(b, 5)\n    emit_local_get(b, 2)\n    emit_i32_load(b, 2, 8)\n    emit_local_set(b, 6)\n    emit_local_get(b, 3)\n    emit_i32_load(b, 2, 8)\n    emit_local_set(b, 7)\n    emit_local_get(b, 2)\n    emit_i32_load(b, 2, 0)\n    emit_local_set(b, 8)\n    // if (len_a + len_b > cap_a): grow\n    emit_local_get(b, 4)\n    emit_local_get(b, 5)\n    emit_i32_add(b)\n    emit_local_get(b, 8)\n    emit_i32_gt_u(b)\n    emit_if_void(b)\n    // newcap = (len_a+len_b)*2\n    emit_local_get(b, 4)\n    emit_local_get(b, 5)\n    emit_i32_add(b)\n    emit_i32_const(b, 2)\n    emit_i32_mul(b)\n    emit_local_set(b, 9)\n    // block = wrap(vibe_rc_alloc(newcap*8 + 8)); data lives at block+8\n    emit_local_get(b, 9)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i64_extend_i32_u(b)\n    emit_call(b, rc_alloc_idx)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 10)\n    emit_local_get(b, 10)\n    emit_local_get(b, 9)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 0)\n    // copy old elements into block+8\n    emit_local_get(b, 10)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_local_get(b, 6)\n    emit_local_get(b, 4)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_memory_copy(b)\n    // free old buffer if it was a separate grown block (data_a != a_val+12)\n    emit_local_get(b, 6)\n    emit_local_get(b, 2)\n    emit_i32_const(b, 12)\n    emit_i32_add(b)\n    emit_i32_ne(b)\n    emit_if_void(b)\n    // #715 recurrence guard (VIBE_RC=shadow): double-free check for the\n    // grown buffer -- a second free-list push of the same buffer makes two\n    // later allocations return overlapping memory (type confusion), which\n    // plain marking cannot catch. Works under quarantine too (marks are\n    // permanent).\n    if rc_shadow {\n      emit_local_get(b, 6)\n      emit_i32_const(b, rc_shadow_base())\n      emit_i32_add(b)\n      emit_i32_load8_u(b, 0, 0)\n      emit_if_void(b)\n      bytebuf_push(b, 0)\n      emit_end(b)\n    } else {\n      ()\n    }\n    // #715 recurrence guard (VIBE_RC=shadow): mark the old grown buffer freed.\n    if rc_shadow {\n      emit_local_get(b, 6)\n      emit_i32_const(b, rc_shadow_base())\n      emit_i32_add(b)\n      emit_i32_const(b, 1)\n      emit_i32_store8(b, 0, 0)\n    } else {\n      ()\n    }\n    emit_local_get(b, 6)\n    emit_i32_const(b, 4)\n    emit_i32_sub(b)\n    emit_global_get(b, 2)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 6)\n    emit_global_set(b, 2)\n    emit_end(b)\n    // cap = newcap; data_ptr = block+8; data_a = block+8\n    emit_local_get(b, 2)\n    emit_local_get(b, 9)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 2)\n    emit_local_get(b, 10)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 8)\n    emit_local_get(b, 10)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_local_set(b, 6)\n    emit_end(b)\n    // copy b's elements into data_a + len_a*8\n    emit_local_get(b, 6)\n    emit_local_get(b, 4)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_local_get(b, 7)\n    emit_local_get(b, 5)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_memory_copy(b)\n    // len = len_a + len_b\n    emit_local_get(b, 2)\n    emit_local_get(b, 4)\n    emit_local_get(b, 5)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 4)\n    // dup each appended element from b (guarded: odd && high32==0)\n    emit_i32_const(b, 0)\n    emit_local_set(b, 11)\n    emit_block_void(b)\n    emit_loop_void(b)\n    emit_local_get(b, 11)\n    emit_local_get(b, 5)\n    emit_i32_ge_u(b)\n    emit_br_if(b, 1)\n    emit_local_get(b, 7)\n    emit_local_get(b, 11)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_i64_load(b, 3, 0)\n    emit_local_set(b, 12)\n    emit_local_get(b, 12)\n    emit_i64_const(b, 1)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_if_void(b)\n    emit_local_get(b, 12)\n    emit_i64_const(b, 32)\n    emit_i64_shr_s(b)\n    emit_i64_eqz(b)\n    emit_if_void(b)\n    // #715 recurrence guard (VIBE_RC=shadow): trap on dup-of-freed element.\n    if rc_shadow {\n      emit_local_get(b, 12)\n      emit_i64_const(b, -2)\n      emit_i64_and(b)\n      emit_i32_wrap_i64(b)\n      emit_i32_const(b, rc_shadow_base())\n      emit_i32_add(b)\n      emit_i32_load8_u(b, 0, 0)\n      emit_if_void(b)\n      bytebuf_push(b, 0)\n      emit_end(b)\n    } else {\n      ()\n    }\n    emit_rc_word_inc_saturating(b, () -> {\n      emit_local_get(b, 12)\n      emit_i64_const(b, -2)\n      emit_i64_and(b)\n      emit_i32_wrap_i64(b)\n      emit_i32_const(b, 4)\n      emit_i32_sub(b)\n    })\n    emit_end(b)\n    emit_end(b)\n    emit_local_get(b, 11)\n    emit_i32_const(b, 1)\n    emit_i32_add(b)\n    emit_local_set(b, 11)\n    emit_br(b, 0)\n    emit_end(b)\n    emit_end(b)\n  } else {\n    emit_local_get(b, 0)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 2)\n    emit_local_get(b, 1)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 3)\n    emit_local_get(b, 2)\n    emit_i32_load(b, 2, 4)\n    emit_local_set(b, 4)\n    emit_local_get(b, 3)\n    emit_i32_load(b, 2, 4)\n    emit_local_set(b, 5)\n    emit_local_get(b, 2)\n    emit_i32_load(b, 2, 8)\n    emit_local_set(b, 6)\n    emit_local_get(b, 3)\n    emit_i32_load(b, 2, 8)\n    emit_local_set(b, 7)\n    emit_local_get(b, 2)\n    emit_i32_load(b, 2, 0)\n    emit_local_set(b, 8)\n    emit_local_get(b, 4)\n    emit_local_get(b, 5)\n    emit_i32_add(b)\n    emit_local_get(b, 8)\n    emit_i32_gt_u(b)\n    emit_if_void(b)\n    emit_local_get(b, 4)\n    emit_local_get(b, 5)\n    emit_i32_add(b)\n    emit_i32_const(b, 2)\n    emit_i32_mul(b)\n    emit_local_set(b, 9)\n    emit_global_get(b, 0)\n    emit_local_tee(b, 10)\n    emit_local_get(b, 9)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_i32_add(b)\n    emit_global_set(b, 0)\n    emit_heap_memory_grow_check(b)\n    emit_local_get(b, 10)\n    emit_local_get(b, 6)\n    emit_local_get(b, 4)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_memory_copy(b)\n    emit_local_get(b, 2)\n    emit_local_get(b, 9)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 2)\n    emit_local_get(b, 10)\n    emit_i32_store(b, 2, 8)\n    emit_local_get(b, 10)\n    emit_local_set(b, 6)\n    emit_end(b)\n    emit_local_get(b, 6)\n    emit_local_get(b, 4)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_local_get(b, 7)\n    emit_local_get(b, 5)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_memory_copy(b)\n    emit_local_get(b, 2)\n    emit_local_get(b, 4)\n    emit_local_get(b, 5)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 4)\n  }\n  b\n}\n\nexport fn gen_bytes_append_body(enable_rc: Bool, bytes_len_idx: Int, bytes_get_idx: Int, bytes_push_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 1)\n  emit_call(b, bytes_len_idx)\n  // ADR-0055 Stage 1: bytes_len now returns a tagged count; untag for the bound.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 3)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 2)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_local_get(b, 3)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: tag the index passed to the value-world bytes_get.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, bytes_get_idx)\n  emit_call(b, bytes_push_idx)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\nexport fn gen_bytes_concat_body(bytes_new_idx: Int, bytes_append_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_call(b, bytes_new_idx)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_local_get(b, 0)\n  emit_call(b, bytes_append_idx)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_call(b, bytes_append_idx)\n  emit_local_get(b, 2)\n  b\n}\n\nexport fn gen_bytes_to_array_body(enable_rc: Bool, arr_new_idx: Int, arr_push_idx: Int, bytes_len_idx: Int, bytes_get_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_call(b, arr_new_idx)\n  emit_local_set(b, 3)\n  emit_local_get(b, 0)\n  emit_call(b, bytes_len_idx)\n  // ADR-0055 Stage 1: bytes_len now returns a tagged count; untag for the bound.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 1)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 2)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 3)\n  emit_local_get(b, 0)\n  emit_local_get(b, 2)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: tag the index passed to value-world bytes_get. The byte\n  // it returns is tagged, which is exactly what arr_push stores.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, bytes_get_idx)\n  emit_call(b, arr_push_idx)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 2)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 3)\n  b\n}\n\nexport fn gen_bytes_from_array_body(enable_rc: Bool, arr_len_idx: Int, arr_get_idx: Int, bytes_new_idx: Int, bytes_push_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_call(b, bytes_new_idx)\n  emit_local_set(b, 3)\n  emit_local_get(b, 0)\n  emit_call(b, arr_len_idx)\n  // ADR-0055 Stage 1: arr_len now returns a tagged count; untag for the bound.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 1)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 2)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 3)\n  emit_local_get(b, 0)\n  emit_local_get(b, 2)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: tag the index passed to value-world arr_get. The value it\n  // returns is tagged, which is exactly what the value-world bytes_push untags.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, arr_get_idx)\n  emit_call(b, bytes_push_idx)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 2)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 3)\n  b\n}\n")
}

