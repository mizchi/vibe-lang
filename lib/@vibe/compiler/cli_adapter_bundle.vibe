"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_str_ref,\n  expr_tag,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  is_efn,\n  is_eident,\n  is_etuple,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  lookup_ctor,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\nimport ./compile_call.vibe {\n  compile_call\n}\n\nimport ./compile_expr_tail6.vibe {\n  compile_expr_tail6\n}\n\nimport ./compile_expr_tail7.vibe {\n  compile_expr_tail7\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\nexport fn compile_expr_tail5(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  match expr {\n    EForIn(_, _, _, _) => throw(\"unsupported expression in codegen: EForIn\"),\n    EHandle(body, arms) => compile_expr_tail6(buf, body, arms, local_names, next_local, ctx, ld, compile_expr)\n    ,\n    EStringInterp(parts) => compile_expr_tail7(buf, parts, local_names, next_local, ctx, ld, compile_expr)\n    ,\n    ELabeledArg(_, _, val) => compile_expr(buf, val, local_names, next_local, ctx, ld)\n    ,\n    _ => throw(\"unsupported expression in codegen: unknown\")\n  }\n}\n")
}

let cli_adapter_source_96 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/compile_expr_tail4.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  emit_binop_op,\n  emit_heap_grow_after_heap_set,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_rc_dup_guarded,\n  emit_str_ref,\n  expr_tag,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  is_efn,\n  is_eident,\n  is_etuple,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  lookup_ctor,\n  resolve_func,\n  resolve_local,\n  struct_field_candidates,\n  struct_field_dispatch_cases,\n  struct_index_by_field_set,\n  struct_tag_by_index\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\nimport ./compile_call.vibe {\n  cc_is_borrow_ret_call, cc_is_loop_borrowed_ident, compile_call\n}\n\nimport ./compile_expr_tail5.vibe {\n  compile_expr_tail5\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\n/// A field projection `a.f` (EDot) read as a record-field value is a BORROW of\n/// the source aggregate. The constructed record OWNS its fields (its drop class\n/// recursively drops them), so the borrowed projection must be retained (#704)\n/// — otherwise dropping the source frees the value while the new record still\n/// points at it. Perceus tracks named bindings but emits no action for bare\n/// projections, so this guarded dup is the only owner-increment and does not\n/// double-count. Lambda literals (EFn) and other fresh values are already owned.\nfn expr_is_projection(e: Expr) -> Bool {\n  match e {\n    EDot(_, _, _, _) => true,\n    _ => false\n  }\n}\n\nexport fn compile_expr_tail4(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  match expr {\n    EDot(obj, field, _, _) => {\n      let fc = String::char_code_at(field, 0)\n      if fc >= 48 && fc <= 57 {\n        // `t.N` tuple projection: purely positional.\n        let mut vi = 0\n        let mut vp = 0\n        while vp < String::length(field) {\n          vi = vi * 10 + (String::char_code_at(field, vp) - 48)\n          vp = vp + 1\n        }\n        let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)\n        // RC mode: the tuple value is an odd pointer (Stage 2); untag before use.\n        if ctx.enable_rc {\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n        }\n        emit_i32_wrap_i64(buf)\n        // RC mode: tuples carry an 8-byte header, so the payload starts at +8.\n        let toff = if ctx.enable_rc {\n          8 + vi * 8\n        } else {\n          vi * 8\n        }\n        emit_i64_load(buf, 3, toff)\n        nl1\n      } else {\n        // #722: name-based struct field access. The slot index depends on\n        // WHICH struct the value is — a same-named field can live at a\n        // different slot in another struct. When every declaring struct\n        // agrees on the slot, load it statically (the common case). When\n        // they disagree, dispatch at runtime on the value's ctor tag\n        // (value+0), falling back to the first-declared struct's slot for\n        // legacy untagged records.\n        let cands = struct_field_candidates(ctx.ctor_table, field)\n        if Array::length(cands) == 0 {\n          throw(String::concat(\"unknown struct field: \", field))\n        }\n        let (_, idx0) = Array::get(cands, 0)\n        let dispatch = struct_field_dispatch_cases(cands)\n        let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n        if Array::length(dispatch) == 0 {\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + idx0 * 8)\n          nl1\n        } else {\n          let obj_l = nl1\n          Array::push(local_names, \"__dot_obj\")\n          emit_local_set(buf, obj_l)\n          let mut di = 0\n          while di < Array::length(dispatch) {\n            let (dtag, didx) = Array::get(dispatch, di)\n            emit_local_get(buf, obj_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_load(buf, 2, 0)\n            emit_i32_const(buf, dtag)\n            emit_i32_eq(buf)\n            emit_if_i64(buf)\n            emit_local_get(buf, obj_l)\n            emit_i32_wrap_i64(buf)\n            emit_i64_load(buf, 3, 8 + didx * 8)\n            emit_else(buf)\n            di = di + 1\n          }\n          emit_local_get(buf, obj_l)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + idx0 * 8)\n          let mut de = 0\n          while de < Array::length(dispatch) {\n            emit_end(buf)\n            de = de + 1\n          }\n          nl1 + 1\n        }\n      }\n    },\n    ERecord(_, fields, _) => {\n      let flen = Array::length(fields)\n      // #722: resolve the record to a struct by exact field-name set and, on a\n      // match, lay it out in the struct's DECLARED field order with the\n      // struct's ctor tag stamped at value+0 — byte-compatible with the\n      // `S::{...}` ctor construction path (which already reorders). This is\n      // what makes the tag-dispatching field access above type-correct for\n      // bare-record construction (hand-built ASTs, name-dropped literals).\n      // Unmatched (anonymous) records keep the legacy literal order + tag 0.\n      let lit_names = array_empty()\n      let mut lni = 0\n      while lni < flen {\n        let (lfn, _) = Array::get(fields, lni)\n        Array::push(lit_names, lfn)\n        lni = lni + 1\n      }\n      let rec_si = struct_index_by_field_set(ctx.ctor_table, lit_names)\n      let rec_tag = if rec_si >= 0 {\n        struct_tag_by_index(ctx.ctor_table, rec_si)\n      } else {\n        0\n      }\n      let rec_fields = if rec_si >= 0 {\n        let def_fnames = Array::get(ctx.ctor_table.struct_field_names, rec_si)\n        let ordered = array_empty()\n        let mut oi = 0\n        while oi < Array::length(def_fnames) {\n          let target_name = Array::get(def_fnames, oi)\n          let mut ri2 = 0\n          while ri2 < flen {\n            let (rfn, rfv) = Array::get(fields, ri2)\n            if rfn == target_name {\n              Array::push(ordered, (rfn, rfv))\n              ri2 = flen\n            } else {\n              ri2 = ri2 + 1\n            }\n          }\n          oi = oi + 1\n        }\n        ordered\n      } else {\n        fields\n      }\n      let ptr_local = next_local\n      Array::push(local_names, \"__rec_ptr\")\n      if ctx.enable_rc {\n        // RC layout (mirrors the tuple in compile_expr_tail2.vibe):\n        //   block_start: [alloc_size@0][rc_count@4][type_id@8][length@12][payload@16...]\n        // The record value is (block_start+8) | 1 (records stay tagged), so the\n        // live header is [alloc_size@ptr-8][rc_count@ptr-4][type_id@ptr+0]\n        // [length@ptr+4] and field access stays at +8 (untag cancels the +8\n        // pointer shift). type_id 0 preserves the existing record read semantics.\n        let total = 16 + flen * 8\n        // ADR-0055 Stage 4: allocate via the free-list search helper (vibe_rc_alloc).\n        emit_i64_const(buf, total)\n        emit_call(buf, ctx.rc_alloc_func_idx)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, total)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store(buf, 2, 4)\n        // ADR-0055 Stage 2c/3: drop-class byte (block+7) = 1 (field-vector); a\n        // record is [type_id@value+0][len@value+4][fields@value+8+i*8], the same\n        // shape the recursive rc_drop loops.\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store8(buf, 0, 7)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, rec_tag)\n        emit_i32_store(buf, 2, 8)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, flen)\n        emit_i32_store(buf, 2, 12)\n        let mut nl_r = next_local + 1\n        let mut ri = 0\n        while ri < flen {\n          let (_, fexpr) = Array::get(rec_fields, ri)\n          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\n          let val_local = nl_r\n          Array::push(local_names, \"__rec_val\")\n          emit_local_set(buf, val_local)\n          nl_r = nl_r + 1\n          // #708 follow-up (Codex review): a record field sourced from a\n          // borrow-returning call (Array::get/Map::get/__rec_field/a user\n          // wrapper) is exactly as much a borrow as a bare projection `a.f`\n          // (see the comment above) -- without this retain, dropping the\n          // source container after storing its element into an owning\n          // record double-frees the element once the record is later\n          // dropped too.\n          // #715: also retain a bare-ident field whose binding is borrow-bound\n          // or loop-borrowed (cc_is_loop_borrowed_ident) -- same gap as the\n          // ETuple case in compile_expr_tail2.vibe (see the comment there).\n          if ctx.enable_rc && (expr_is_projection(fexpr) || cc_is_borrow_ret_call(fexpr, ctx) || cc_is_loop_borrowed_ident(fexpr, ctx)) {\n            emit_rc_dup_guarded(buf, val_local, ctx.rc_shadow)\n          } else {\n            ()\n          }\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 16 + ri * 8)\n          ri = ri + 1\n        }\n        // record value = (block_start + 8) | 1\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 8)\n        emit_i64_add(buf)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_r\n      } else {\n        let obj_size = 8 + flen * 8\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_heap_grow_after_heap_set(buf, ctx)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, rec_tag)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, flen)\n        emit_i32_store(buf, 2, 4)\n        let mut nl_r = next_local + 1\n        let mut ri = 0\n        while ri < flen {\n          let (_, fexpr) = Array::get(rec_fields, ri)\n          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\n          let val_local = nl_r\n          Array::push(local_names, \"__rec_val\")\n          emit_local_set(buf, val_local)\n          nl_r = nl_r + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + ri * 8)\n          ri = ri + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_r\n      }\n    },\n    EMap(fields) => {\n      let flen = Array::length(fields)\n      let obj_size = 8 + flen * 2 * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__map_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, ptr_local)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, obj_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, flen)\n      emit_i32_store(buf, 2, 0)\n      let mut nl_m = next_local + 1\n      let mut mi = 0\n      while mi < flen {\n        let (key, val_expr) = Array::get(fields, mi)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        let key_idx = str_table_lookup(ctx.str_table.strs, key)\n        if key_idx >= 0 {\n          emit_str_ref(buf, Array::get(ctx.str_table.offsets, key_idx), Array::get(ctx.str_table.lengths, key_idx))\n        } else {\n          emit_i64_const(buf, 0)\n        }\n        emit_i64_store(buf, 3, 8 + mi * 16)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl_m = compile_expr(buf, val_expr, local_names, nl_m, ctx, ld)\n        let val_local = nl_m\n        Array::push(local_names, \"__map_val\")\n        emit_local_set(buf, val_local)\n        nl_m = nl_m + 1\n        emit_local_get(buf, val_local)\n        emit_i64_store(buf, 3, 8 + mi * 16 + 8)\n        mi = mi + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl_m\n    },\n    _ => compile_expr_tail5(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

let cli_adapter_source_97 = () -> (String, String) {
