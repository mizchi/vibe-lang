e\n// tolerate-not-trap choice as Array::slice below), so every downstream packed\n// view stays inside the source string and `end < start` yields \"\". Locals:\n// 3/4 = existing i32 scratch, 5 = NEW i64 scratch holding len (meta bumped\n// 2/0 -> 2/1 at the linked_compile push_builtin site).\nexport fn gen_str_substring_body(enable_rc: Bool) -> Bytes {\n  let b = bytebuf_new()\n  // local5 = len (i64, untagged): the packed string's low 32 bits.\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i64_extend_i32_u(b)\n  emit_local_set(b, 5)\n  // param1 (start) := retag(clamp(untag(start), 0, len))\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i64_const(b, 0)\n  emit_i64_lt_s(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 0)\n  emit_else(b)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_local_get(b, 5)\n  emit_i64_gt_s(b)\n  emit_if_i64(b)\n  emit_local_get(b, 5)\n  emit_else(b)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_end(b)\n  emit_end(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_local_set(b, 1)\n  // param2 (end) := retag(clamp(untag(end), untag(start'), len))\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i64_lt_s(b)\n  emit_if_i64(b)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_else(b)\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_local_get(b, 5)\n  emit_i64_gt_s(b)\n  emit_if_i64(b)\n  emit_local_get(b, 5)\n  emit_else(b)\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_end(b)\n  emit_end(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_local_set(b, 2)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  // ADR-0055: start/end arrive tagged (n<<1) under RC; untag for raw arithmetic.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i64_sub(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 3)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 32)\n  emit_i64_shl(b)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  emit_i64_or(b)\n  b\n}\n\nexport fn gen_fs_exists_stub_body() -> Bytes {\n  let b = bytebuf_new()\n  emit_i64_const(b, 0)\n  b\n}\n\nexport fn gen_string_contains_body(enable_rc: Bool, string_index_of_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, string_index_of_idx)\n  // index_of returns a tagged index (-2 for \"not found\") under RC; `>= 0` still\n  // holds since the tag preserves sign. Tag the resulting Bool into the value\n  // world (true=2/false=0).\n  emit_i64_const(b, 0)\n  emit_i64_ge_s(b)\n  emit_i64_extend_i32_u(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  b\n}\n\n// #748 (ADR-0054 step 3): SIMD memchr substring search. The old body called\n// str_substring + str_eq PER POSITION (two function calls each, ~5.6ns/byte).\n// Now: the needle's first byte is splatted and 16-byte haystack windows with\n// no occurrence are skipped via v128.load + i8x16.eq + v128.any_true; a\n// first-byte hit verifies with ONE str_eq call on a zero-copy packed view\n// ((hp+i)<<32 | ndl_len) — no substring allocation, and the verify rides\n// str_eq's own SIMD chunk path for long needles. Params