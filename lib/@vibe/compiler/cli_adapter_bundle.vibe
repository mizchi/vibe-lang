"name = @vibe/compiler/codegen/expr\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/codegen/expr — ADR-0070 / #897 compiler-internal contract.\ndeps = {\n  @vibe/compiler/codegen/common_analysis : 0.0.1\n  @vibe/compiler/codegen/common_base : 0.0.1\n  @vibe/compiler/codegen/common_extractors : 0.0.1\n  @vibe/compiler/codegen/wasm_emit : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/compiler/perceus : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/codegen/expr — ADR-0070 / #897 compiler-internal contract.\n// Directory-shared-scope package: expr.vibe (facade), core.vibe/support.vibe\n// (re-export shims), compile_call.vibe, compile_expr.vibe,\n// compile_expr_tail{,2..7}.vibe, compile_lambda.vibe, compile_match.vibe,\n// compile_module_expr.vibe.\n\nfn compile_expr(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int) -> Int with { Error }\nfn compile_module_expr(stmts: Array[Stmt]) -> Bytes with { Error }\nfn compile_call(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn cc_is_borrow_ret_call(e: Expr, ctx: CompileCtx) -> Bool\nfn cc_builtin_call_ret_kind(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Int with { Error }\nfn cc_expr_is_stringish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error }\nfn cc_is_loop_borrowed_ident(e: Expr, ctx: CompileCtx) -> Bool\nfn expr_is_boolish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error }\nfn expr_is_floatish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error }\nfn expr_is_intish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error }\nfn compile_expr_tail(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_expr_tail2(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_expr_tail3(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_expr_tail4(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_expr_tail5(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_expr_tail6(buf: Bytes, body: Expr, arms: Array[(Pat, Expr)], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_expr_tail7(buf: Bytes, parts: Array[String], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_lambda(buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\nfn compile_match(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }\n")
