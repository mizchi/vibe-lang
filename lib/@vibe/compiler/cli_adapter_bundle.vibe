let cli_adapter_source_236 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/linked_helpers.vibe",
"//# Imports\n\nimport @vibe/compiler/checker {\n  check_program\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_linked_impl\n}\n\nimport @vibe/compiler/core {\n  Expr, Stmt,\n  contains_name, dir_of_path, get_export_name, path_to_module_name, resolve_import_path\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program\n}\nimport ./preprocess.vibe {\n  expand_interp_stmts, strip_generic_type_params\n}\n\n//# Functions\n\nfn efn_param_count(expr: Expr) -> Int {\n  match expr {\n    EFn(_, _, params, _, _, _) => Array::length(params),\n    _ => -1\n  }\n}\n\nfn resolve_reexport_chain(source_path: String, items: Array[(String, Option[String])], module_name: String, linked_imports: Array[(String, String, Int, Int)], type_stmts: Array[Stmt], depth: Int) -> Unit with { Error, Fs } {\n  if depth > 10 {\n    ()\n  }\n  else {\n    // #768/#778: direct-call form, not `perform Fs::ReadFile` -- the\n    // perform/effect-op codegen path for magic host effects can crash with an\n    // uncaught wasm exception in a small/narrow-effect-surface compiled unit\n    // (see #778's fix + notes). No mock-handler test exercises this function\n    // through `handle ... with Fs { ... }`, so direct-call is safe here.\n    let source = Fs::read_file(source_path)\n    let stmts = parse_program(lex(source))\n    let source_dir = dir_of_path(source_path)\n    let wanted_names = array_empty()\n    let mut wi = 0\n    while wi < Array::length(items) {\n      let (name, _) = Array::get(items, wi)\n      Array::push(wanted_names, name)\n      wi = wi + 1\n    }\n    let mut si = 0\n    while si < Array::length(stmts) {\n      match Array::get(stmts, si) {\n        SLet(true, _, name, _, expr) => if contains_name(wanted_names, name) {\n          let param_count = efn_param_count(expr)\n          if param_count >= 0 {\n            let export_name = get_export_name(items, name)\n            Array::push(linked_imports, (module_name, export_name, param_count, 1))\n          }\n        }\n        ,\n        SEnum(true, name, _, _, _) => if contains_name(wanted_names, name) {\n          Array::push(type_stmts, Array::get(stmts, si))\n        }\n        ,\n        SReExport(raw_path, inner_items) => {\n          let filtered = array_empty()\n          let mut fi = 0\n          while fi < Array::length(inner_items) {\n            let (iname, irename) = Array::get(inner_items, fi)\n            if contains_name(wanted_names, iname) {\n              Array::push(filtered, (iname, irename))\n            }\n            fi = fi + 1\n          }\n          if Array::length(filtered) > 0 {\n            let resolved = resolve_import_path(source_dir, raw_path)\n            resolve_reexport_chain(resolved, filtered, module_name, linked_imports, type_stmts, depth + 1)\n          }\n        },\n        _ => ()\n      }\n      si = si + 1\n    }\n  }\n}\n\n//# Misc\n\nexport {\n  path_to_module_name, resolve_reexport_chain\n}\n")
}

let cli_adapter_source_237 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/linked_artifacts.vibe",
"//# Imports\n\nimport @vibe/compiler/checker {\n  check_program\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_linked_impl\n}\n\nimport @vibe/compiler/codegen/common_base {\n  empty_dbg_prov\n}\n\nimport @vibe/compiler/core {\n  Expr, Stmt,\n  contains_name, dir_of_path, path_to_module_name, resolve_import_path\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program\n}\nimport ./linked_helpers.vibe {\n  resolve_reexport_chain\n}\n\nimport ./path_utils.vibe {\n  empty_stmt_array\n}\n\nimport ./preprocess.vibe {\n  expand_interp_stmts, strip_generic_type_params\n}\n\n//# Functions\n\nfn efn_param_count(expr: Expr) -> Int {\n  match expr {\n    EFn(_, _, params, _, _, _) => Array::length(params),\n    _ => -1\n  }\n}\n\n// #778: use the direct-call builtin form, not `perform Fs::ReadFile`. The\n// perform/effect-op path for host effects (Fs) computes a handler-stack\n// region via `effect_name_to_tag`/`ctx.effect_names` that is only reliably\n// sized when the compiled unit declares other real user effects; a small\n// compiled unit whose only effect surface is the magic `Fs` name (no handler\n// installed, few/no other declared effects) can get a bogus tag/offset and\n// crash with an uncaught wasm exception before ever reaching the \"no\n// handler -> call the builtin directly\" fallback. `check_linked_file` (used\n// standalone by `vibe check`, without the rest of the compiler's effect\n// surface pulled in) hit exactly this. Direct calls skip that machinery\n// entirely and go straight through the safe compile_call builtin dispatch.\nfn read_program(path: String) -> Array[Stmt] with { Error, Fs } {\n  let source = Fs::read_file(path)\n  parse_program(lex(source))\n}\n\nfn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\n// Dedup is via a linear scan (`dep_path_names_for` below). The\n// dedup MUST preserve first-occurrence order: `dep_paths` order flows\n// into `linked_imports` and then into wasm import-section indices, so a\n// sort/reorder here would change the emitted binary. D (a single entry's\n// unique imports) is small, so the O(D^2) scan is bounded (#533, #366).\n//\n// #711: also returns, per unique dep path (same order/index as `dep_paths`),\n// the union of names the entry file actually imports/re-exports from that\n// path (`dep_wanted_names[i]`). Without this, `collect_linked_dep_artifacts`\n// registered EVERY exported top-level function of a linked file into\n// `linked_imports` -- not just the ones this entry file references -- so an\n// unrelated same-named function anywhere in the dependency graph (`eq`,\n// `add`, `not`, ...) polluted the flat `func_table.names` this entry's\n// codegen scans, making `prefer_bound_call` a global-namespace check instead\n// of a caller-scoped one (false-positive shadowing, e.g. leb128's bare\n// scalar `eq` mistakenly routed to a bound-call fallback).\nfn collect_direct_dep_paths(entry_stmts: Array[Stmt], entry_dir: String) -> (Array[String], Array[Array[String]]) {\n  let dep_paths = array_empty()\n  let dep_wanted_names = array_empty()\n  let dep_path_names_for: (String) -> Array[String] = (resolved) -> {\n    let mut fi = 0\n    let mut idx = -1\n    while fi < Array::length(dep_paths) {\n      if Array::get(dep_paths, fi) == resolved {\n        idx = fi\n        fi = Array::length(dep_paths)\n      } else {\n        fi = fi + 1\n      }\n    }\n    if idx < 0 {\n      let fresh = array_empty()\n      Array::push(dep_paths, resolved)\n      Array::push(dep_wanted_names, fresh)\n      fresh\n    } else {\n      Array::get(dep_wanted_names, idx)\n    }\n  }\n  let mut ei = 0\n  while ei < Array::length(entry_stmts) {\n    match Array::get(entry_stmts, ei) {\n      SImport(raw_path, items) => if Array::length(items) > 0 {\n        let resolved = resolve_import_path(entry_dir, raw_path)\n        let names = dep_path_names_for(resolved)\n        let mut ii = 0\n        while ii < Array::length(items) {\n          let (iname, _) = Array::get(items, ii)\n          Array::push(names, iname)\n          ii = ii + 1\n        }\n      }\n      ,\n      SReExport(raw_path, items) => {\n        let resolved = resolve_import_path(entry_dir, raw_path)\n        let names = dep_path_names_for(resolved)\n        let mut ii = 0\n        while ii < Array::length(items) {\n          let (iname, _) = Array::get(items, ii)\n          Array::push(names, iname)\n          ii = ii + 1\n        }\n      },\n      _ => ()\n    }\n    ei = ei + 1\n  }\n  (dep_paths, dep_wanted_names)\n}\n\n// #711: `wanted_names[i]` (parallel to `dep_paths[i]`) restricts which of\n// `dep_paths[i]`'s own exported top-level names get registered into\n// `linked_imports` -- only the names the ENTRY file actually imports/\n// re-exports from that path, not every export the file happens to have.\n// A `SReExport` found INSIDE a dep file (that file itself re-exporting a\n// third file) is filtered the same way before recursing, so a transitive\n// re-export chain cannot re-introduce an unwanted name either.\nfn collect_linked_dep_artifacts(dep_paths: Array[String], wanted_names: Array[Array[String]]) -> (Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs } {\n  let linked_imports = array_empty()\n  let linked_dep_specs = array_empty()\n  let resolved_type_stmts = array_empty()\n  let mut di = 0\n  while di < Array::length(dep_paths) {\n    let dep_path = Array::get(dep_paths, di)\n    let dep_stmts = read_program(dep_path)\n    let module_name = path_to_module_name(dep_path)\n    let dep_dir = dir_of_path(dep_path)\n    let wanted = Array::get(wanted_names, di)\n    let mut has_linked = false\n    let mut dsi = 0\n    while dsi < Array::length(dep_stmts) {\n      match Array::get(dep_stmts, dsi) {\n        SLet(true, _, name, _, expr) => {\n          let param_count = efn_param_count(expr)\n          if param_count >= 0 && contains_name(wanted, name) {\n            Array::push(linked_imports, (module_name, name, param_count, 1))\n            has_linked = true\n          }\n        },\n        SReExport(raw_path, items) => {\n          let filtered = array_empty()\n          let mut fi2 = 0\n          while fi2 < Array::length(items) {\n            let (iname, irename) = Array::get(items, fi2)\n            // #711 regression (Codex review on #718): `wanted` holds the\n            // names the ENTRY imports, i.e. the PUBLIC alias this dep_path\n            // exposes (`export ./inner.vibe { foo as bar }` makes `bar` the\n            // public name) -- not `iname`, which is the name as declared in\n            // the re-exported file. Filtering on `iname` alone silently drops\n            // every aliased re-export before `resolve_reexport_chain` gets a\n            // chance to translate it via `irename`.\n            let public_name = match irename {\n              Some(alias) => alias,\n              None => iname\n            }\n            if contains_name(wanted, public_name) {\n              Array::push(filtered, (iname, irename))\n            }\n            fi2 = fi2 + 1\n          }\n          if Array::length(filtered) > 0 {\n            let resolved = resolve_import_path(dep_dir, raw_path)\n            resolve_reexport_chain(resolved, filtered, module_name, linked_imports, resolved_type_stmts, 0)\n            has_linked = true\n          }\n        },\n        SEnum(true, _, _, _, _) => Array::push(resolved_type_stmts, Array::get(dep_stmts, dsi))\n        ,\n        _ => ()\n      }\n      dsi = dsi + 1\n    }\n    if has_linked {\n      Array::push(linked_dep_specs, (module_name, dep_path))\n    }\n    di = di + 1\n  }\n  (resolved_type_stmts, linked_imports, linked_dep_specs)\n}\n\n// #946(3): dep-collection half of collect_linked_compile_inputs, factored out\n// so a caller that already has its OWN entry_stmts (e.g. cli_support.vibe's\n// check_linked_file, which needs a LOCATED parse for diagnostics — see its\n// doc comment) can reuse the dep-resolution logic without re-parsing the\n// entry file via this module's plain (unlocated, non-recovering) read_program.\nexport fn collect_linked_dep_inputs_for_stmts(entry_path: String, entry_stmts: Array[Stmt]) -> (Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs } {\n  let (dep_paths, dep_wanted_names) = collect_direct_dep_paths(entry_stmts, dir_of_path(entry_path))\n  collect_linked_dep_artifacts(dep_paths, dep_wanted_names)\n}\n\nexport fn collect_linked_compile_inputs(entry_path: String) -> (Array[Stmt], Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs } {\n  let entry_stmts = read_program(entry_path)\n  let (resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_dep_inputs_for_stmts(entry_path, entry_stmts)\n  (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs)\n}\n\nexport fn compile_file_wasi_linked_artifacts(entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs } {\n  let (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_compile_inputs(entry_path)\n  let stmts = empty_stmt_array()\n  append_stmt_array(stmts, resolved_type_stmts)\n  append_stmt_array(stmts, entry_stmts)\n  expand_interp_stmts(stmts)\n  // Check before stripping generic type params so Ord/Add/... constrained\n  // bodies (`[T: Ord](a, b) { a < b }`) resolve `T` as a bound type variable.\n  let _ = check_program(stmts)\n  strip_generic_type_params(stmts)\n  let wasm = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), linked_imports, false, false, false, false, false, false, empty_dbg_prov())\n  (wasm, linked_imports, linked_dep_specs)\n}\n\nexport fn compile_file_wasi_linked(entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)]) with { Error, Fs } {\n  let (wasm, linked_imports, _) = compile_file_wasi_linked_artifacts(entry_path, entry_name)\n  (wasm, linked_imports)\n}\n")
}

let cli_adapter_source_238 = () -> (String, String) {
