let cli_adapter_source_242 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_rewrite_impl.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr\n}\n\nimport ./preprocess_interp_string.vibe {\n  rewrite_interp_string\n}\n\n//# Functions\n\nexport fn rewrite_interp(e: Expr) -> Expr with { Error } {\n  match e {\n    EStringInterp(parts) => rewrite_interp_string(parts),\n    ELet(name, val, body, soff) => ELet(name, rewrite_interp(val), rewrite_interp(body), soff),\n    ELetMut(name, val, body, soff) => ELetMut(name, rewrite_interp(val), rewrite_interp(body), soff),\n    ELetRec(name, val, body) => ELetRec(name, rewrite_interp(val), rewrite_interp(body)),\n    ESeq(a, b) => ESeq(rewrite_interp(a), rewrite_interp(b)),\n    ECall(callee, args, off) => ECall(rewrite_interp(callee), for arg in args {\n      rewrite_interp(arg)\n    }, off),\n    EIf(c, t, e2) => EIf(rewrite_interp(c), rewrite_interp(t), rewrite_interp(e2)),\n    EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, rewrite_interp(body)),\n    EMatch(scrut, arms) => EMatch(rewrite_interp(scrut), for arm in arms {\n      let (pat, body) = arm; (pat, rewrite_interp(body))\n    }),\n    _ => e\n  }\n}\n")
}

let cli_adapter_source_243 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/preprocess_compile.vibe",
"//# Imports\n\nimport @vibe/compiler/checker {\n  check_program\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_coverage_impl, compile_wasi_module_impl, compile_wasi_module_rc_impl, compile_wasi_module_rc_shadow_impl\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program\n}\nimport ./preprocess_interp.vibe {\n  expand_interp_stmts\n}\n\nimport ./preprocess_strip.vibe {\n  strip_generic_type_params\n}\n\nimport @vibe/compiler/core {\n  Stmt, TypeExpr\n}\n\nimport ./component_codegen.vibe {\n  comp_emit_component_wasm_async_trampolined_p1\n}\n\n//# Functions\n\n/// M1b-2c (docs/spec/wasi-p3-async.md): does the entry declare\n/// `() -> Int with { Async }` (no params)? If so its compiled core wasm should be\n/// wrapped into an async-lifted WASM component. Detected from the declared TyFn\n/// effect annotation (before generic-param stripping).\nfn entry_declares_async_int(stmts: Array[Stmt], entry_name: String) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, opt_ty, _) => if name == entry_name {\n        // Flattened patterns: the pinned selfhost seed does not bind variables\n        // inside nested constructor patterns (e.g. `Some(ty)` as a sub-pattern),\n        // so match each Option level separately to stay seed-buildable\n        // (docs/selfhost-bootstrap.md, new-feature rule).\n        match opt_ty {\n          Some(ty) => match ty {\n            TyFn(params, ret, opt_eff) => match opt_eff {\n              Some(eff) => if String::contains(eff, \"Async\") && Array::length(params) == 0 {\n                match ret {\n                  TyName(rn) => if rn == \"Int\" {\n                    found = true\n                  } else {\n                    ()\n                  },\n                  _ => ()\n                }\n              } else {\n                ()\n              },\n              None => ()\n            },\n            _ => ()\n          },\n          None => ()\n        }\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n/// Wrap the core wasm into an async component when the entry is async. The\n/// trampoline imports/aliases the main export by name \"run\", so this narrow PoC\n/// only triggers for an entry named \"run\".\nfn maybe_wrap_async_component(bytes: Bytes, wrap_async: Bool) -> Bytes {\n  if wrap_async {\n    comp_emit_component_wasm_async_trampolined_p1(bytes, \"run\", 120)\n  } else {\n    bytes\n  }\n}\n\nexport fn compile_source_wasi_only(source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  // Check before stripping generic type params (see merge_sources.vibe).\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_impl(stmts, entry_name), wrap_async)\n}\n\n/// Coverage (#cov): same source pipeline as compile_source_wasi_only but routes\n/// through the coverage codegen, so compiling the flat compiler source under\n/// VIBE_COVERAGE=1 yields an instrumented compiler (per-function hit bitmap +\n/// `vibe_cov` section).\nexport fn compile_source_wasi_only_coverage(source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  strip_generic_type_params(stmts)\n  compile_wasi_module_coverage_impl(stmts, entry_name)\n}\n\n/// ADR-0055 #493 cutover: same pipeline on the Perceus RC codegen path. Lets the\n/// selfbuild / bootstrap / e2e gates compile real programs (incl. the whole\n/// compiler) under RC via an env toggle in cli_main — the full-scale validity +\n/// correctness signal the memory-limited test probes cannot produce.\nexport fn compile_source_wasi_only_rc(source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_rc_impl(stmts, entry_name), wrap_async)\n}\n\n/// #715 recurrence guard: same RC pipeline, but the produced module carries\n/// shadow-liveness instrumentation -- a byte per heap address marking freed\n/// blocks, with an `unreachable` trap on the FIRST dup-of-freed or\n/// drop-of-freed operation. Turns \"moving target\" free-list corruption into a\n/// deterministic trap at the faulting operation. Debug-only (VIBE_RC=shadow):\n/// adds a memory-reservation pad and per-dup/drop checks, so never the default.\nexport fn compile_source_wasi_only_rc_shadow(source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_rc_shadow_impl(stmts, entry_name), wrap_async)\n}\n")
}

