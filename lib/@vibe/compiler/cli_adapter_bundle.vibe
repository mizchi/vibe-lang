let cli_adapter_source_247 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/linked_helpers.vibe",
"//# Imports\n\nimport @vibe/compiler/checker {\n  check_program\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_linked_impl\n}\n\nimport @vibe/compiler/core {\n  Expr, Stmt, contains_name, dir_of_path, get_export_name, path_to_module_name, resolve_import_path\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program\n}\nimport ./preprocess.vibe {\n  expand_interp_stmts, strip_generic_type_params\n}\n\n//# Functions\n\nfn efn_param_count(expr: Expr) -> Int {\n  match expr {\n    EFn(_, _, params, _, _, _) => Array::length(params),\n    _ => -1\n  }\n}\n\nfn resolve_reexport_chain(source_path: String, items: Array[(String, Option[String])], module_name: String, linked_imports: Array[(String, String, Int, Int)], type_stmts: Array[Stmt], depth: Int) -> Unit with { Error, Fs } {\n  if depth > 10 {\n    ()\n  }\n  else {\n    // #768/#778: direct-call form, not `perform Fs::ReadFile` -- the\n    // perform/effect-op codegen path for magic host effects can crash with an\n    // uncaught wasm exception in a small/narrow-effect-surface compiled unit\n    // (see #778's fix + notes). No mock-handler test exercises this function\n    // through `handle ... with Fs { ... }`, so direct-call is safe here.\n    let source = Fs::read_file(source_path)\n    let stmts = parse_program(lex(source))\n    let source_dir = dir_of_path(source_path)\n    let wanted_names = array_empty()\n    let mut wi = 0\n    while wi < Array::length(items) {\n      let (name, _) = Array::get(items, wi)\n      Array::push(wanted_names, name)\n      wi = wi + 1\n    }\n    let mut si = 0\n    while si < Array::length(stmts) {\n      match Array::get(stmts, si) {\n        SLet(true, _, name, _, expr) => if contains_name(wanted_names, name) {\n          let param_count = efn_param_count(expr)\n          if param_count >= 0 {\n            let export_name = get_export_name(items, name)\n            Array::push(linked_imports, (module_name, export_name, param_count, 1))\n          }\n        }\n        ,\n        SEnum(true, name, _, _, _) => if contains_name(wanted_names, name) {\n          Array::push(type_stmts, Array::get(stmts, si))\n        }\n        ,\n        SReExport(raw_path, inner_items) => {\n          let filtered = array_empty()\n          let mut fi = 0\n          while fi < Array::length(inner_items) {\n            let (iname, irename) = Array::get(inner_items, fi)\n            if contains_name(wanted_names, iname) {\n              Array::push(filtered, (iname, irename))\n            }\n            fi = fi + 1\n          }\n          if Array::length(filtered) > 0 {\n            let resolved = resolve_import_path(source_dir, raw_path)\n            resolve_reexport_chain(resolved, filtered, module_name, linked_imports, type_stmts, depth + 1)\n          }\n        },\n        _ => ()\n      }\n      si = si + 1\n    }\n  }\n}\n\n//# Misc\n\nexport {\n  path_to_module_name, resolve_reexport_chain\n}\n")
}

let cli_adapter_source_248 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/linked_artifacts.vibe",
"//# Imports\n\nimport @vibe/compiler/checker {\n  check_program\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_linked_impl\n}\n\nimport @vibe/compiler/codegen/common_base {\n  empty_dbg_prov\n}\n\nimport @vibe/compiler/core {\n  Expr, Stmt, contains_name, dir_of_path, path_to_module_name, resolve_import_path\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program\n}\nimport ./linked_helpers.vibe {\n  resolve_reexport_chain\n}\n\nimport ./path_utils.vibe {\n  empty_stmt_array\n}\n\nimport ./preprocess.vibe {\n  expand_interp_stmts, strip_generic_type_params\n}\n\n//# Functions\n\nfn efn_param_count(expr: Expr) -> Int {\n  match expr {\n    EFn(_, _, params, _, _, _) => Array::length(params),\n    _ => -1\n  }\n}\n\n/// #778: use the direct-call builtin form, not `perform Fs::ReadFile`. The\n/// perform/effect-op path for host effects (Fs) computes a handler-stack\n/// region via `effect_name_to_tag`/`ctx.effect_names` that is only reliably\n/// sized when the compiled unit declares other real user effects; a small\n/// compiled unit whose only effect surface is the magic `Fs` name (no handler\n/// installed, few/no other declared effects) can get a bogus tag/offset and\n/// crash with an uncaught wasm exception before ever reaching the \"no\n/// handler -> call the builtin directly\" fallback. `check_linked_file` (used\n/// standalone by `vibe check`, without the rest of the compiler's effect\n/// surface pulled in) hit exactly this. Direct calls skip that machinery\n/// entirely and go straight through the safe compile_call builtin dispatch.\nfn read_program(path: String) -> Array[Stmt] with { Error, Fs } {\n  let source = Fs::read_file(path)\n  parse_program(lex(source))\n}\n\nfn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\n/// Dedup is via a linear scan (`dep_path_names_for` below). The\n/// dedup MUST preserve first-occurrence order: `dep_paths` order flows\n/// into `linked_imports` and then into wasm import-section indices, so a\n/// sort/reorder here would change the emitted binary. D (a single entry's\n/// unique imports) is small, so the O(D^2) scan is bounded (#533, #366).\n///\n/// #711: also returns, per unique dep path (same order/index as `dep_paths`),\n/// the union of names the entry file actually imports/re-exports from that\n/// path (`dep_wanted_names[i]`). Without this, `collect_linked_dep_artifacts`\n/// registered EVERY exported top-level function of a linked file into\n/// `linked_imports` -- not just the ones this entry file references -- so an\n/// unrelated same-named function anywhere in the dependency graph (`eq`,\n/// `add`, `not`, ...) polluted the flat `func_table.names` this entry's\n/// codegen scans, making `prefer_bound_call` a global-namespace check instead\n/// of a caller-scoped one (false-positive shadowing, e.g. leb128's bare\n/// scalar `eq` mistakenly routed to a bound-call fallback).\nfn collect_direct_dep_paths(entry_stmts: Array[Stmt], entry_dir: String) -> (Array[String], Array[Array[String]]) {\n  let dep_paths = array_empty()\n  let dep_wanted_names = array_empty()\n  let dep_path_names_for: (String) -> Array[String] = (resolved) -> {\n    let mut fi = 0\n    let mut idx = -1\n    while fi < Array::length(dep_paths) {\n      if Array::get(dep_paths, fi) == resolved {\n        idx = fi\n        fi = Array::length(dep_paths)\n      } else {\n        fi = fi + 1\n      }\n    }\n    if idx < 0 {\n      let fresh = array_empty()\n      Array::push(dep_paths, resolved)\n      Array::push(dep_wanted_names, fresh)\n      fresh\n    } else {\n      Array::get(dep_wanted_names, idx)\n    }\n  }\n  let mut ei = 0\n  while ei < Array::length(entry_stmts) {\n    match Array::get(entry_stmts, ei) {\n      SImport(raw_path, items) => if Array::length(items) > 0 {\n        let resolved = resolve_import_path(entry_dir, raw_path)\n        let names = dep_path_names_for(resolved)\n        let mut ii = 0\n        while ii < Array::length(items) {\n          let (iname, _) = Array::get(items, ii)\n          Array::push(names, iname)\n          ii = ii + 1\n        }\n      }\n      ,\n      SReExport(raw_path, items) => {\n        let resolved = resolve_import_path(entry_dir, raw_path)\n        let names = dep_path_names_for(resolved)\n        let mut ii = 0\n        while ii < Array::length(items) {\n          let (iname, _) = Array::get(items, ii)\n          Array::push(names, iname)\n          ii = ii + 1\n        }\n      },\n      _ => ()\n    }\n    ei = ei + 1\n  }\n  (dep_paths, dep_wanted_names)\n}\n\n/// #711: `wanted_names[i]` (parallel to `dep_paths[i]`) restricts which of\n/// `dep_paths[i]`'s own exported top-level names get registered into\n/// `linked_imports` -- only the names the ENTRY file actually imports/\n/// re-exports from that path, not every export the file happens to have.\n/// A `SReExport` found INSIDE a dep file (that file itself re-exporting a\n/// third file) is filtered the same way before recursing, so a transitive\n/// re-export chain cannot re-introduce an unwanted name either.\nfn collect_linked_dep_artifacts(dep_paths: Array[String], wanted_names: Array[Array[String]]) -> (Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs } {\n  let linked_imports = array_empty()\n  let linked_dep_specs = array_empty()\n  let resolved_type_stmts = array_empty()\n  let mut di = 0\n  while di < Array::length(dep_paths) {\n    let dep_path = Array::get(dep_paths, di)\n    let dep_stmts = read_program(dep_path)\n    let module_name = path_to_module_name(dep_path)\n    let dep_dir = dir_of_path(dep_path)\n    let wanted = Array::get(wanted_names, di)\n    let mut has_linked = false\n    let mut dsi = 0\n    while dsi < Array::length(dep_stmts) {\n      match Array::get(dep_stmts, dsi) {\n        SLet(true, _, name, _, expr) => {\n          let param_count = efn_param_count(expr)\n          if param_count >= 0 && contains_name(wanted, name) {\n            Array::push(linked_imports, (module_name, name, param_count, 1))\n            has_linked = true\n          }\n        },\n        SReExport(raw_path, items) => {\n          let filtered = array_empty()\n          let mut fi2 = 0\n          while fi2 < Array::length(items) {\n            let (iname, irename) = Array::get(items, fi2)\n            // #711 regression (Codex review on #718): `wanted` holds the\n            // names the ENTRY imports, i.e. the PUBLIC alias this dep_path\n            // exposes (`export ./inner.vibe { foo as bar }` makes `bar` the\n            // public name) -- not `iname`, which is the name as declared in\n            // the re-exported file. Filtering on `iname` alone silently drops\n            // every aliased re-export before `resolve_reexport_chain` gets a\n            // chance to translate it via `irename`.\n            let public_name = match irename {\n              Some(alias) => alias,\n              None => iname\n            }\n            if contains_name(wanted, public_name) {\n              Array::push(filtered, (iname, irename))\n            }\n            fi2 = fi2 + 1\n          }\n          if Array::length(filtered) > 0 {\n            let resolved = resolve_import_path(dep_dir, raw_path)\n            resolve_reexport_chain(resolved, filtered, module_name, linked_imports, resolved_type_stmts, 0)\n            has_linked = true\n          }\n        },\n        SEnum(true, _, _, _, _) => Array::push(resolved_type_stmts, Array::get(dep_stmts, dsi))\n        ,\n        _ => ()\n      }\n      dsi = dsi + 1\n    }\n    if has_linked {\n      Array::push(linked_dep_specs, (module_name, dep_path))\n    }\n    di = di + 1\n  }\n  (resolved_type_stmts, linked_imports, linked_dep_specs)\n}\n\n/// #946(3): dep-collection half of collect_linked_compile_inputs, factored out\n/// so a caller that already has its OWN entry_stmts (e.g. cli_support.vibe's\n/// check_linked_file, which needs a LOCATED parse for diagnostics — see its\n/// doc comment) can reuse the dep-resolution logic without re-parsing the\n/// entry file via this module's plain (unlocated, non-recovering) read_program.\nexport fn collect_linked_dep_inputs_for_stmts(entry_path: String, entry_stmts: Array[Stmt]) -> (Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs } {\n  let (dep_paths, dep_wanted_names) = collect_direct_dep_paths(entry_stmts, dir_of_path(entry_path))\n  collect_linked_dep_artifacts(dep_paths, dep_wanted_names)\n}\n\nexport fn collect_linked_compile_inputs(entry_path: String) -> (Array[Stmt], Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs } {\n  let entry_stmts = read_program(entry_path)\n  let (resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_dep_inputs_for_stmts(entry_path, entry_stmts)\n  (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs)\n}\n\nexport fn compile_file_wasi_linked_artifacts(entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs } {\n  let (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_compile_inputs(entry_path)\n  let stmts = empty_stmt_array()\n  append_stmt_array(stmts, resolved_type_stmts)\n  append_stmt_array(stmts, entry_stmts)\n  expand_interp_stmts(stmts)\n  // Check before stripping generic type params so Ord/Add/... constrained\n  // bodies (`[T: Ord](a, b) { a < b }`) resolve `T` as a bound type variable.\n  let _ = check_program(stmts)\n  strip_generic_type_params(stmts)\n  let wasm = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), linked_imports, false, false, false, false, false, false, empty_dbg_prov())\n  (wasm, linked_imports, linked_dep_specs)\n}\n\nexport fn compile_file_wasi_linked(entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)]) with { Error, Fs } {\n  let (wasm, linked_imports, _) = compile_file_wasi_linked_artifacts(entry_path, entry_name)\n  (wasm, linked_imports)\n}\n")
}

let cli_adapter_source_249 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/linked_library.vibe",
"//# Imports\n\nimport @vibe/compiler/checker {\n  check_program\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_linked_impl\n}\n\nimport @vibe/compiler/codegen/common_base {\n  empty_dbg_prov\n}\n\nimport @vibe/compiler/core {\n  Expr, Stmt, path_set_new\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program\n}\n\nimport ./merge_sources.vibe {\n  collect_merged_stmts_recursive\n}\n\nimport ./path_utils.vibe {\n  empty_stmt_array\n}\n\nimport ./preprocess.vibe {\n  expand_interp_stmts, strip_generic_type_params\n}\n\n//# Functions\n\nexport fn compile_file_wasi_library(dep_path: String) -> Bytes with { Error, Fs } {\n  let stmts = empty_stmt_array()\n  let visited = path_set_new()\n  collect_merged_stmts_recursive(dep_path, stmts, visited)\n  expand_interp_stmts(stmts)\n  // Check before stripping generic type params (see merge_sources.vibe).\n  let _ = check_program(stmts)\n  strip_generic_type_params(stmts)\n  compile_wasi_module_linked_impl(stmts, \"_start\", array_empty(), array_empty(), true, false, false, false, false, false, empty_dbg_prov())\n}\n")
}

let cli_adapter_source_250 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/compiler/file_compile/index.vpkg",
"name = @vibe/compiler/entry/compiler/file_compile\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/entry/compiler/file_compile — the single-file (fs-rooted,\ndeps = {\n  @vibe/compiler/cache : 0.0.1\n  @vibe/compiler/checker : 0.0.1\n  @vibe/compiler/codegen : 0.0.1\n  @vibe/compiler/codegen/common_base : 0.0.1\n  @vibe/compiler/codegen/wasi : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/compiler/loader : 0.0.1\n  @vibe/compiler/runtime : 0.0.1\n  @vibe/compiler/syntax : 0.0.1\n  @vibe/core : 0.2.0\n}\n\ngenerated_hash =\n\n// @vibe/compiler/entry/compiler/file_compile — the single-file (fs-rooted,\n// no external module closure) compile drivers: every `compile_file_fs_*`\n// mode variant (mvp/rc/coverage/trace/break/profiled) plus their cached\n// twins threaded through a TypeDb (ADR-0070 Phase 3, #897, compiler-internal\n// batch). Compiled into the compiler itself via compiler_sources_manifest.tsv\n// (group `entry`, dual-row: this contract + file_compile.vibe).\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package is single-file), so it moved verbatim to file_compile.vibe. No\n// exported types: `TypeDb` (from ../../../runtime) arrives as structural\n// signature text resolved against the implementation import when the facade\n// is merged in (normalize/perceus precedent — no re-import needed here). No\n// `version` binding existed (compiler-internal package).\n\nfn prepare_file_fs_cached(db: TypeDb, entry_path: String) -> TypeDb with { Error, Fs }\nfn check_file_fs_mode(entry_path: String) -> Int with { Error, Fs }\nfn compile_file_fs_mode(entry_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs }\nfn compile_file_fs_mode_rc(entry_path: String, entry_name: String) -> Bytes with { Error, Fs }\nfn compile_file_fs_mode_rc_shadow(entry_path: String, entry_name: String) -> Bytes with { Error, Fs }\nfn compile_file_fs_mode_testmeta(entry_path: String, entry_name: String, mode: String, meta_out: String) -> Bytes with { Error, Fs }\nfn entry_cacheable_for_fs(entry_path: String, entry_name: String) -> Bool with { Error, Fs }\nfn compile_file_fs_mode_coverage(entry_path: String, entry_name: String) -> Bytes with { Error, Fs }\nfn compile_file_fs_mode_trace(entry_path: String, entry_name: String) -> Bytes with { Error, Fs }\nfn compile_file_fs_mode_break(entry_path: String, entry_name: String) -> Bytes with { Error, Fs }\nfn compile_file_fs_mode_profiled(entry_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler }\nfn compile_file_fs_mode_cached(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb) with { Error, Fs }\nfn compile_file_fs_cached(db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with { Error, Fs }\nfn compile_file_fs(entry_path: String, entry_name: String) -> Bytes with { Error, Fs }\nfn compile_file_fs_mode_cached_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler }\nfn compile_file_fs_module_cached(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs }\nfn compile_file_fs_module(entry_path: String) -> Bytes with { Error, Fs }\n")
}

let cli_adapter_source_251 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/compiler/file_compile/file_compile.vibe",
"//# Imports\n\nimport @vibe/compiler/syntax {\n  lex, lex_with_offsets, parse_program, parse_program_located\n}\n\n// #897: this used to also import `empty_stmt_array` via a leaf path into\n// ../../source_compile/wasi_only/path_utils.vibe -- now that wasi_only/ is\n// an index.vpkg boundary, that leaf import is rejected\n// (enforce_incoming_boundary_fs, #729), and `empty_stmt_array` is one of\n// wasi_only/index.vpkg's deliberately undeclared private helpers (see that\n// contract's header). Its body is a one-line forward to this same\n// `array_empty[T]()`, already imported below, so the three call sites that\n// used `empty_stmt_array()` (building an empty Array[Stmt] accumulator) now\n// call `array_empty()` directly instead -- same fix cli_support.vibe needed\n// for the same reason.\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  ExportRenamePlan,\n  append_import_alias_rewritten_non_import_stmts_with_renames,\n  append_non_import_stmts_without_alias_rewrite,\n  apply_export_renames_stmts,\n  build_export_rename_plan,\n  collect_import_alias_collision_locals,\n  collect_import_alias_collision_refs,\n  collect_import_value_renames,\n  dce_stmts,\n  dir_of_path,\n  export_plan_renames_for,\n  import_value_rename_locals,\n  namespace_private_value_stmts,\n  resolve_import_path,\n  rewrite_imported_value_stmt_to_local,\n  stmts_have_import_deep\n}\n\nimport @vibe/compiler/codegen {\n  compile_module,\n  compile_wasi_module,\n  compile_wasi_module_break,\n  compile_wasi_module_coverage,\n  compile_wasi_module_rc,\n  compile_wasi_module_rc_shadow,\n  compile_wasi_module_trace\n}\n\nimport @vibe/compiler/codegen/common_base {\n  DbgProv\n}\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_impl\n}\n\nimport @vibe/compiler/loader {\n  collect_source_groups_fs, load_persistent_source_group_fingerprint_if_valid\n}\n\nimport @vibe/compiler/checker {\n  file_entry_cacheable, file_tests_cacheable\n}\n\nimport @vibe/compiler/runtime {\n  TypeDb,\n  db_grouped_merged_source,\n  db_load_artifact,\n  db_module_source,\n  db_new,\n  db_set_source,\n  db_store_artifact,\n  db_typecheck,\n  db_typecheck_fs,\n  parse_program_with_path\n}\n\nimport @vibe/compiler/cache {\n  build_file_compile_module_artifact_fingerprint,\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint,\n  build_file_compile_wasi_artifact_fingerprint,\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint,\n  build_source_groups_fingerprint,\n  load_persistent_artifact,\n  store_persistent_artifact\n}\n\n//# Types\n\nexport effect Profiler {\n  NowUs -> Int\n}\n\n//# Functions\n\n/// Direct builtin call (ADR-0076 追記31 Vertical C) — see\n/// lib/@vibe/cli/dispatch.vibe::profiler_now_us for why the perform form\n/// was retired (replay re-execution + memoized resume(0) zeros).\nfn profiler_now_us() -> Int with { Profiler } {\n  Profiler::now_us()\n}\n\nfn elapsed_us_since(start_us: Int) -> Int with { Profiler } {\n  let elapsed = profiler_now_us() - start_us\n  if elapsed < 0 {\n    0\n  } else {\n    elapsed\n  }\n}\n\nfn artifact_fingerprint_from_source(source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(__to_string(len), String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2)))))\n}\n\nfn seed_type_db_from_source_groups(db: TypeDb, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb {\n  let mut seeded = db\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      seeded = db_set_source(seeded, path, source)\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  seeded\n}\n\nfn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\nfn flatten_source_groups_local(source_groups: Array[(String, Array[(String, String)])]) -> Array[(String, String)] {\n  let flat = array_empty()\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      Array::push(flat, Array::get(sources, si))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  flat\n}\n\nfn string_array_contains(items: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn lookup_source_by_path(sources: Array[(String, String)], target_path: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    if path == target_path {\n      found = Some(source)\n      i = Array::length(sources)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// #1100: was a byte-for-byte duplicate of runtime's parse_program_with_path\n/// (same located lex+parse, same `<path>: <msg>` wrapping), so a cold compile\n/// parsed every source twice -- once for the typecheck walk and once here for\n/// the merge. Route both through the memoized one; it hands back a fresh\n/// top-level array each call, which is what the in-place desugars downstream\n/// require. Interior-line breakpoints (span-arc step5) still get their real\n/// EIdent char-offsets: the memoized parse is the same located one.\nfn parse_program_for_path(path: String, source: String) -> Array[Stmt] with { Error } {\n  parse_program_with_path(path, source)\n}\n\n/// #716: collision-def fallback (see merge_sources.vibe). `excluded_locals`\n/// are the locals the export-rename plan already rewrites; the inline copy gets\n/// the target file's export renames applied first.\nfn append_import_alias_collision_defs_from_sources(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], sources: Array[(String, String)], plan: ExportRenamePlan, excluded_locals: Array[String]) -> Unit with { Error } {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = array_empty()\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !string_array_contains(emitted, local) && !string_array_contains(excluded_locals, local) {\n      let resolved = resolve_import_path(base_dir, raw_path)\n      match lookup_source_by_path(sources, resolved) {\n        Some(source) => {\n          let source_stmts = namespace_private_value_stmts(resolved, apply_export_renames_stmts(parse_program_for_path(resolved, source), export_plan_renames_for(plan, resolved)))\n          let mut j = 0\n          let mut done = false\n          while j < Array::length(source_stmts) && !done {\n            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n              Some(local_stmt) => {\n                Array::push(merged, local_stmt)\n                Array::push(emitted, local)\n                done = true\n              },\n              None => ()\n            }\n            j = j + 1\n          }\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n}\n\n/// #716: parse every source once and build the export-rename plan for the whole\n/// program (the merge output of one file depends on the export surfaces of ALL\n/// files: ambiguous exported names are renamed at their defs and at importing\n/// files' references).\nfn parse_sources_for_merge(sources: Array[(String, String)]) -> (Array[String], Array[Array[Stmt]]) with { Error } {\n  let file_paths = array_empty()\n  let file_stmts = array_empty()\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (path, source) = Array::get(sources, si)\n    Array::push(file_paths, path)\n    Array::push(file_stmts, parse_program_for_path(path, source))\n    si = si + 1\n  }\n  (file_paths, file_stmts)\n}\n\n/// One file's contribution to the merged program. `stmts` are the file's parsed\n/// statements, `is_entry_source` mirrors the pre-#716 per-group entry rule\n/// (entry keeps its private names), and `plan`/`sources` drive the export-name\n/// rewriting and the collision-def fallback.\nfn append_merged_stmts_for_file(merged: Array[Stmt], path: String, stmts: Array[Stmt], is_entry_source: Bool, plan: ExportRenamePlan, sources: Array[(String, String)]) -> Unit with { Error } {\n  let export_renamed = if is_entry_source {\n    stmts\n  } else {\n    apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))\n  }\n  let namespaced_stmts = if is_entry_source {\n    export_renamed\n  } else {\n    namespace_private_value_stmts(path, export_renamed)\n  }\n  if stmts_have_import_deep(stmts) {\n    let import_renames = collect_import_value_renames(plan, path, stmts)\n    let skipped_locals = collect_import_alias_collision_locals(stmts)\n    append_import_alias_collision_defs_from_sources(merged, path, stmts, sources, plan, import_value_rename_locals(import_renames))\n    append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)\n  } else {\n    append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\n  }\n}\n\nfn build_merged_stmts_from_sources(entry_path: String, sources: Array[(String, String)]) -> Array[Stmt] with { Error } {\n  let merged = array_empty()\n  let source_count = Array::length(sources)\n  let (file_paths, file_stmts) = parse_sources_for_merge(sources)\n  let plan_entry = if entry_path == \"\" {\n    if source_count > 0 {\n      Array::get(file_paths, source_count - 1)\n    } else {\n      \"\"\n    }\n  } else {\n    entry_path\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  let mut si = 0\n  while si < source_count {\n    let path = Array::get(file_paths, si)\n    let is_entry_source = if entry_path == \"\" {\n      si == source_count - 1\n    } else {\n      path == entry_path\n    }\n    append_merged_stmts_for_file(merged, path, Array::get(file_stmts, si), is_entry_source, plan, sources)\n    si = si + 1\n  }\n  merged\n}\n\nfn build_grouped_merged_stmts(source_groups: Array[(String, Array[(String, String)])]) -> Array[Stmt] with { Error } {\n  let merged = array_empty()\n  // #716: the plan spans ALL groups (imports cross group boundaries), so the\n  // flat source list is parsed once here and reused per group.\n  let flat_sources = flatten_source_groups_local(source_groups)\n  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)\n  let plan_entry = if Array::length(file_paths) > 0 {\n    Array::get(file_paths, Array::length(file_paths) - 1)\n  } else {\n    \"\"\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  // #740: the is-entry flag must mean \"the LAST file of the WHOLE merge\"\n  // (the plan entry, whose exports stay unrenamed). It was `si ==\n  // source_count - 1` — the last file of EVERY GROUP — so every group\n  // tail (ripple/ripple.vibe, desugar_trait_dict.vibe, ...) skipped its\n  // export renames while callers were rewritten to the renamed names:\n  // \"undefined variable (local): <name>_exp_<path>\" at codegen.\n  let flat_total = Array::length(file_paths)\n  let mut flat_idx = 0\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let source_count = Array::length(sources)\n    let mut si = 0\n    while si < source_count {\n      let path = Array::get(file_paths, flat_idx)\n      let stmts = Array::get(file_stmts, flat_idx)\n      append_merged_stmts_for_file(merged, path, stmts, flat_idx == flat_total - 1, plan, flat_sources)\n      flat_idx = flat_idx + 1\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  merged\n}\n\n/// Interior-line breakpoints (span-arc step5): the basename of a file path (text\n/// after the last '/'). Used as the `vibe.dbgfiles` key the runner matches a\n/// `--break <file>:<line>` spec against. String::concat-free (substring only).\nfn path_basename(p: String) -> String {\n  let n = String::length(p)\n  let mut last = 0 - 1\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(p, i) == 47 {\n      last = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  String::substring(p, last + 1, n)\n}\n\n/// Interior-line breakpoints: sorted char-offsets of each '\\n' in `src` (local\n/// copy of the codegen helper, to avoid an entry->codegen import).\nfn file_newline_offsets(src: String) -> Array[Int] {\n  let arr = array_empty()\n  let n = String::length(src)\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(src, i) == 10 {\n      Array::push(arr, i)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  arr\n}\n\n/// Interior-line breakpoints (span-arc step5, multi-file): like\n/// build_grouped_merged_stmts but ALSO records, per merged top-level statement,\n/// which SOURCE FILE it came from — so codegen can map each statement's char\n/// offset to a line IN ITS OWN FILE (offsets from different files collide after\n/// the merge). Returns (merged, file_basenames, file_newlines, stmt_file_id):\n///   file_basenames[k] / file_newlines[k]  — the k-th distinct source file\n///   stmt_file_id[s]                        — file id of merged top-level stmt s\n/// Provenance is captured by measuring the merged-array length delta around each\n/// source's append, so it stays aligned no matter how many statements a source\n/// contributes; the append calls themselves mirror build_merged_stmts_from_sources\n/// exactly, so `merged` is identical to the normal path.\nfn build_grouped_merged_stmts_prov(source_groups: Array[(String, Array[(String, String)])]) -> (Array[Stmt], Array[String], Array[Array[Int]], Array[Int]) with { Error } {\n  let merged = array_empty()\n  let files = array_empty()\n  let file_nls = array_empty()\n  let stmt_file_id = array_empty()\n  // #716: same whole-program plan as build_grouped_merged_stmts, so `merged`\n  // stays identical to the normal (non-break) merge.\n  let flat_sources = flatten_source_groups_local(source_groups)\n  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)\n  let plan_entry = if Array::length(file_paths) > 0 {\n    Array::get(file_paths, Array::length(file_paths) - 1)\n  } else {\n    \"\"\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  let mut flat_idx = 0\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let source_count = Array::length(sources)\n    let mut si = 0\n    while si < source_count {\n      let (path, source) = Array::get(sources, si)\n      let file_id = Array::length(files)\n      Array::push(files, path_basename(path))\n      Array::push(file_nls, file_newline_offsets(source))\n      let before = Array::length(merged)\n      // #740: last-of-WHOLE-merge, not last-of-group (see the note in\n      // build_grouped_merged_stmts).\n      append_merged_stmts_for_file(merged, path, Array::get(file_stmts, flat_idx), flat_idx == Array::length(file_paths) - 1, plan, flat_sources)\n      let after = Array::length(merged)\n      let mut k = before\n      while k < after {\n        Array::push(stmt_file_id, file_id)\n        k = k + 1\n      }\n      flat_idx = flat_idx + 1\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  (merged, files, file_nls, stmt_file_id)\n}\n\nfn prepare_file_fs_from_source_groups_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with { Error } {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck(seeded, entry_path)\n}\n\nfn prepare_file_fs_from_source_groups_persistent_cached(db: TypeDb, entry_path: String, source_groups: Array[(String, Array[(String, String)])]) -> TypeDb with { Error, Fs } {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck_fs(seeded, entry_path)\n}\n\nexport fn prepare_file_fs_cached(db: TypeDb, entry_path: String) -> TypeDb with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n}\n\n/// #946 P1 (Codex, PR #1006): `vibe check`'s \"linked\" dep collection\n/// (collect_linked_dep_inputs_for_stmts, in linked_artifacts.vibe) exists to\n/// feed the wasm import-linking codegen boundary -- it copies a dependency's\n/// SEnum/struct declarations into the checked stmts but never a `let rec fn`\n/// signature, so check_program never learned an imported function's real\n/// type and a wrong-typed call site (e.g. `f(\"x\")` against `fn f(x: Int)`)\n/// typechecked cleanly no matter what was passed. Reuse prepare_file_fs_cached's\n/// fs-mode source-group + db_typecheck_fs pipeline instead -- the same one\n/// compile_file_fs_mode already relies on for a real compile's (working)\n/// typecheck pass -- and stop before build_grouped_merged_stmts/codegen.\nexport fn check_file_fs_mode(entry_path: String) -> Int with { Error, Fs } {\n  let _ = prepare_file_fs_cached(db_new(), entry_path)\n  0\n}\n\nexport fn compile_file_fs_mode(entry_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [\n      entry_name\n    ])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n}\n\n/// #701 RC variant: same load/merge as compile_file_fs_mode \"no-dce\" but routes\n/// through the Perceus RC codegen (compile_wasi_module_rc_impl, enable_rc) so an\n/// import-resolving / `vibe run` program actually honors VIBE_RC. Without this\n/// the FS-compile path silently used the bump allocator regardless of VIBE_RC.\nexport fn compile_file_fs_mode_rc(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_rc(merged_stmts, entry_name)\n}\n\n/// #715/#768 debug variant (VIBE_RC=shadow): same load/merge as\n/// compile_file_fs_mode_rc but with shadow-liveness double-free traps, so an\n/// import-resolving test build's \"moving target\" free-list corruption becomes a\n/// deterministic trap at the first bad dup/drop.\nexport fn compile_file_fs_mode_rc_shadow(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_rc_shadow(merged_stmts, entry_name)\n}\n\n/// #634 (ADR-0026): same as compile_file_fs_mode, but ALSO writes the pure-test\n/// cache verdict to `meta_out` (when non-empty) before codegen — computed on the\n/// MERGED stmts, so transitive imported-function effect rows are visible. \"1\" =\n/// every test block is transitively effect-free → `vibe test` may cache/skip it.\n/// Reached only on a successful compile (the program type-checks), so reading the\n/// declared effect rows is sound. Env is read by the caller (the CLI adapter),\n/// keeping this layer free of the Env effect.\nexport fn compile_file_fs_mode_testmeta(entry_path: String, entry_name: String, mode: String, meta_out: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  // Compute the cacheability verdict BEFORE codegen (it only needs the stmts)\n  // but write it only AFTER codegen succeeds, so a failed compile leaves no\n  // stale sidecar.\n  let cacheable = if meta_out != \"\" {\n    file_tests_cacheable(merged_stmts)\n  } else {\n    false\n  }\n  let bytes = if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [\n      entry_name\n    ])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  if meta_out != \"\" {\n    Fs::write_file(meta_out, if cacheable {\n      \"1\"\n    } else {\n      \"0\"\n    })\n  } else {\n    ()\n  }\n  bytes\n}\n\n/// #819 (Codex review, PR #1214): standalone cacheability query for an\n/// ENTRY-function compile (e.g. `fn main`), used by scripts/vibe_md.vibex's\n/// ```vibe run block execute-cache. Deliberately its OWN parse/merge pass\n/// rather than threading a value through cli_adapter.vibe's existing\n/// backend-selection branch (coverage/break/trace/rc/rc-shadow/bump) --\n/// this can never affect which bytes an actual compile emits, at the cost\n/// of a redundant frontend pass (negligible next to the child-process\n/// compile/execute round trips vibe_md.vibex already pays per block).\nexport fn entry_cacheable_for_fs(entry_path: String, entry_name: String) -> Bool with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  file_entry_cacheable(merged_stmts, entry_name)\n}\n\n/// Coverage (#cov): FS-mode compile with function-level hit instrumentation.\n/// Same load/merge as compile_file_fs_mode \"no-dce\" but routes through the\n/// coverage codegen so the output wasm carries the hit bitmap + `vibe_cov`\n/// section. Used by `cli_main` under VIBE_COVERAGE=1.\nexport fn compile_file_fs_mode_coverage(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_coverage(merged_stmts, entry_name)\n}\n\n/// Trace (debugger / DAP P1 groundwork): FS-mode compile with function-call\n/// execution-trace instrumentation. Same load/merge as compile_file_fs_mode\n/// \"no-dce\" but routes through the trace codegen so the output wasm carries the\n/// in-memory trace log + `vibe.trace` custom section. Used by `cli_main` under\n/// VIBE_DEBUG=1.\nexport fn compile_file_fs_mode_trace(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_trace(merged_stmts, entry_name)\n}\n\n/// Break (debugger / DAP P1): FS-mode compile with `vibe::dbg_break` host-hook\n/// instrumentation at each user function entry. Same load/merge as\n/// compile_file_fs_mode \"no-dce\" but routes through the break codegen so the\n/// output wasm imports + calls `vibe::dbg_break`. Used by `cli_main` under\n/// VIBE_DEBUG_BREAK=1.\nexport fn compile_file_fs_mode_break(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  // Interior-line breakpoints (span-arc step5): merge WITH per-file provenance so\n  // the break codegen can emit `vibe::dbg_line(<file_id>, <line>)` at every\n  // statement boundary, mapping each statement's char offset to a line in its OWN\n  // source file (multi-file: offsets from different files collide). `merged` is\n  // identical to the non-break merge.\n  let (merged_stmts, dbg_files, dbg_file_nls, dbg_stmt_file_id) = build_grouped_merged_stmts_prov(source_groups)\n  compile_wasi_module_break(merged_stmts, entry_name, DbgProv::{\n    files: dbg_files,\n    file_nls: dbg_file_nls,\n    stmt_file_id: dbg_stmt_file_id\n  })\n}\n\nexport fn compile_file_fs_mode_profiled(entry_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let total_start = profiler_now_us()\n  let load_start = profiler_now_us()\n  let source_groups = collect_source_groups_fs(entry_path)\n  let load_us = elapsed_us_since(load_start)\n  let type_start = profiler_now_us()\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let type_us = elapsed_us_since(type_start)\n  let bundle_start = profiler_now_us()\n  let _ = build_source_groups_fingerprint(source_groups)\n  let bundle_us = elapsed_us_since(bundle_start)\n  let parse_start = profiler_now_us()\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  let parse_us = elapsed_us_since(parse_start)\n  let compile_start = profiler_now_us()\n  let bytes = if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [\n      entry_name\n    ])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let compile_us = elapsed_us_since(compile_start)\n  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n}\n\nfn compile_file_fs_mode_cached_slow_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String, persistent_artifact_kind: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let load_start = profiler_now_us()\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint(source_groups, entry_name, mode)\n  match load_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint) {\n    Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0),\n    None => {\n      let load_us = elapsed_us_since(load_start)\n      let type_start = profiler_now_us()\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let type_us = elapsed_us_since(type_start)\n      let bundle_start = profiler_now_us()\n      let merge_fingerprint = build_source_groups_fingerprint(source_groups)\n      let bundle_us = elapsed_us_since(bundle_start)\n      let artifact_fingerprint = merge_fingerprint\n      let artifact_kind = if mode == \"mvp\" {\n        \"wasi-mvp\"\n      } else if mode == \"no-dce\" {\n        \"wasi\"\n      } else {\n        throw(String::concat(\"unsupported compile mode: \", mode))\n      }\n      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, next_db, load_us, type_us, bundle_us, 0, 0),\n        None => {\n          let parse_start = profiler_now_us()\n          let merged_stmts = build_grouped_merged_stmts(source_groups)\n          let parse_us = elapsed_us_since(parse_start)\n          let compile_start = profiler_now_us()\n          let bytes = if mode == \"mvp\" {\n            let pruned_stmts = dce_stmts(merged_stmts, [\n              entry_name\n            ])\n            compile_wasi_module_impl(pruned_stmts, entry_name)\n          } else {\n            compile_wasi_module(merged_stmts, entry_name)\n          }\n          store_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint, bytes)\n          let compile_us = elapsed_us_since(compile_start)\n          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes), load_us, type_us, bundle_us, parse_us, compile_us)\n        }\n      }\n    }\n  }\n}\n\nfn compile_file_fs_mode_cached_slow(db: TypeDb, entry_path: String, entry_name: String, mode: String, persistent_artifact_kind: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint(source_groups, entry_name, mode)\n  match load_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let merge_fingerprint = build_source_groups_fingerprint(source_groups)\n      let artifact_fingerprint = merge_fingerprint\n      let artifact_kind = if mode == \"mvp\" {\n        \"wasi-mvp\"\n      } else if mode == \"no-dce\" {\n        \"wasi\"\n      } else {\n        throw(String::concat(\"unsupported compile mode: \", mode))\n      }\n      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, next_db),\n        None => {\n          let merged_stmts = build_grouped_merged_stmts(source_groups)\n          let bytes = if mode == \"mvp\" {\n            let pruned_stmts = dce_stmts(merged_stmts, [\n              entry_name\n            ])\n            compile_wasi_module_impl(pruned_stmts, entry_name)\n          } else {\n            compile_wasi_module(merged_stmts, entry_name)\n          }\n          store_persistent_artifact(persistent_artifact_kind, entry_name, persistent_artifact_fingerprint, bytes)\n          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport fn compile_file_fs_mode_cached(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  let persistent_artifact_kind = if mode == \"mvp\" {\n    \"file-compile-wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"file-compile-wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n    match load_persistent_artifact(persistent_artifact_kind, entry_name, build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint, entry_name, mode)) {\n      Some(bytes) => (bytes, db),\n      None => compile_file_fs_mode_cached_slow(db, entry_path, entry_name, mode, persistent_artifact_kind)\n    },\n    None => compile_file_fs_mode_cached_slow(db, entry_path, entry_name, mode, persistent_artifact_kind)\n  }\n}\n\nexport fn compile_file_fs_cached(db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  compile_file_fs_mode_cached(db, entry_path, entry_name, \"no-dce\")\n}\n\nexport fn compile_file_fs(entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)\n  bytes\n}\n\nexport fn compile_file_fs_mode_cached_profiled(db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let total_start = profiler_now_us()\n  let persistent_artifact_kind = if mode == \"mvp\" {\n    \"file-compile-wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"file-compile-wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let load_start = profiler_now_us()\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n    match load_persistent_artifact(persistent_artifact_kind, entry_name, build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint, entry_name, mode)) {\n      Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0, elapsed_us_since(total_start)),\n      None => {\n        let prefix_load_us = elapsed_us_since(load_start)\n        let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)\n        (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n      }\n    },\n    None => {\n      let prefix_load_us = elapsed_us_since(load_start)\n      let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)\n      (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n    }\n  }\n}\n\nfn compile_file_fs_module_cached_slow(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_module_artifact_fingerprint(source_groups)\n  match load_persistent_artifact(\"file-compile-module\", \"\", persistent_artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(next_db, source_groups)\n      let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n      let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n      match db_load_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(module_source))\n          let bytes = compile_module(merged_stmts)\n          store_persistent_artifact(\"file-compile-module\", \"\", persistent_artifact_fingerprint, bytes)\n          (bytes, db_store_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport fn compile_file_fs_module_cached(db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n    match load_persistent_artifact(\"file-compile-module\", \"\", build_file_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint)) {\n      Some(bytes) => (bytes, db),\n      None => compile_file_fs_module_cached_slow(db, entry_path)\n    },\n    None => compile_file_fs_module_cached_slow(db, entry_path)\n  }\n}\n\nexport fn compile_file_fs_module(entry_path: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)\n  bytes\n}\n")
}

let cli_adapter_source_252 = () -> (String, String) {
  ("lib/@vibe/compiler/cli_support.vibe",
"//# Imports\n\nimport @vibe/compiler/codegen/wasi {\n  compile_wasi_module_linked_impl\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/common_base {\n  empty_dbg_prov\n}\n\nimport @vibe/compiler/core {\n  Stmt\n}\n\nimport @vibe/compiler/entry/compiler/file_compile {\n  check_file_fs_mode, compile_file_fs_mode, compile_file_fs_mode_cached, compile_file_fs_mode_cached_profiled, compile_file_fs_mode_profiled\n}\n\n// #897: package-form import (wasi_only/ is now an index.vpkg boundary) --\n// these used to be three separate leaf imports (linked_artifacts.vibe,\n// preprocess_interp.vibe, linked_library.vibe), now merged into one. A\n// fourth leaf import (path_utils.vibe's `empty_stmt_array`) is dropped\n// entirely: it is a private helper only promoted to sibling-file visibility\n// within wasi_only/ (not part of this package's declared contract surface,\n// see wasi_only/index.vpkg's header), and its body is a one-line forward to\n// `@vibe/core`'s generic `array_empty[T]()` -- already imported below under\n// its own name, so the two call sites that used `empty_stmt_array()` now\n// call `array_empty()` directly instead.\nimport @vibe/compiler/entry/source_compile/wasi_only {\n  collect_linked_compile_inputs, collect_linked_dep_inputs_for_stmts, compile_file_wasi_library, expand_interp_stmts\n}\n\nimport ./type_db.vibe {\n  db_new\n}\n\n// #946(3,4): `vibe check` runs this same inline-wasm codegen validation (lane\n// index / align / etc.) as `vibe diagnostics` — see check_inline_wasm_fns'\n// doc comment in typecheck_fs.vibe. Without this, making `check` genuinely\n// codegen-free (Gate v2 #492, wired to the CLI by #946(3)) would have made it\n// blind to inline-wasm errors that used to be caught by the old full-compile\n// `check` — a regression trade for fixing the empty-file false-positive.\n// `locate_type_error` recovers the `line:col` prefix the OLD full-compile\n// `check` got for free via typecheck_fs.vibe's own db_typecheck_fs path\n// (finish_typecheck_fs_impl wraps every Throw with it) — without rewrapping\n// here, check_linked_file's raw check_file_fs_mode/check_program message\n// would regress every located-diagnostic case check has (scripts/\n// test_located_diagnostics.sh).\nimport @vibe/compiler/runtime {\n  check_inline_wasm_fns, locate_type_error\n}\n\n// #946(3): re-parse the entry file WITH real char offsets for check_linked_file\n// (see its doc comment) — collect_linked_compile_inputs's own entry_stmts come\n// from linked_artifacts.vibe's read_program, which parses via the PLAIN\n// `parse_program(lex(source))` (no starts array => every node's offset is -1,\n// same pitfall parse_program_with_path's doc comment describes for\n// finish_typecheck_fs_impl). Re-parsing just the entry file is self-contained\n// (no shared-helper edit, so compile/build/debug paths that also flow through\n// read_program are untouched). Uses the RECOVERING parser (not\n// parse_program_located): every diagnostic parse_program_recovering emits is\n// ALREADY a full `line L:col C: msg` string (extract_err_token_pos +\n// offset_to_line_col at the point of the throw, in parser.vibe) — the same\n// robust locating parse_program_located does only for its own top-level\n// throws, missing errors that bubble up from nested expr-parsing helpers\n// (e.g. `export let bad = = 5`'s \"unexpected token at #9: ...\" came back\n// unlocated through parse_program_located but located through the recovering\n// parser). check_linked_file only wants the single FIRST parse error (`check`\n// is one-error-at-a-time; `vibe diagnostics` is the multi-diagnostic surface\n// — collect_all_diagnostics already uses this same recovering parser).\nimport @vibe/compiler/syntax {\n  lex_with_offsets, parse_program_recovering\n}\n\n//# Functions\n\nfn append_stmt_array(dst: Array[Stmt], src: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\nfn linked_output_dir(output_path: String) -> String {\n  let len = String::length(output_path)\n  if len >= 5 && output_path[len - 5: len] == \".wasm\" {\n    String::concat(output_path[0: len - 5], \".debug\")\n  } else {\n    String::concat(output_path, \".debug\")\n  }\n}\n\nfn empty_source_pairs() -> Array[(String, String)] {\n  array_empty()\n}\n\nfn normalize_release_mode(mode: String) -> String with { Error } {\n  if mode == \"\" || mode == \"release\" || mode == \"no-dce\" {\n    \"no-dce\"\n  } else if mode == \"mvp\" {\n    \"mvp\"\n  } else {\n    throw(String::concat(\"unsupported release mode: \", mode))\n  }\n}\n\nexport fn compile_release_file_mode(input_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs } {\n  let compile_mode = normalize_release_mode(mode)\n  let (bytes, _) = compile_file_fs_mode_cached(db_new(), input_path, entry_name, compile_mode)\n  bytes\n}\n\nexport fn compile_release_file_mode_uncached(input_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs } {\n  let compile_mode = normalize_release_mode(mode)\n  compile_file_fs_mode(input_path, entry_name, compile_mode)\n}\n\nexport fn compile_release_file_mode_profiled(input_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let compile_mode = normalize_release_mode(mode)\n  let (bytes, _, load_us, type_us, bundle_us, parse_us, compile_us, total_us) = compile_file_fs_mode_cached_profiled(db_new(), input_path, entry_name, compile_mode)\n  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, total_us)\n}\n\nexport fn compile_release_file_mode_uncached_profiled(input_path: String, entry_name: String, mode: String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } {\n  let compile_mode = normalize_release_mode(mode)\n  compile_file_fs_mode_profiled(input_path, entry_name, compile_mode)\n}\n\nexport fn compile_release_file(input_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  compile_release_file_mode(input_path, entry_name, \"no-dce\")\n}\n\nexport fn compile_debug_library(dep_path: String) -> Bytes with { Error, Fs } {\n  compile_file_wasi_library(dep_path)\n}\n\nfn append_non_import_stmts(dst: Array[Stmt], src: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(src) {\n    match Array::get(src, i) {\n      SImport(_, _) => (),\n      SReExport(_, _) => (),\n      SAliasDecl(_, _) => (),\n      _ => Array::push(dst, Array::get(src, i))\n    }\n    i = i + 1\n  }\n}\n\nexport fn build_linked_debug_entry(input_path: String, entry_name: String) -> (Bytes, Array[(String, String)]) with { Error, Fs } {\n  let (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_compile_inputs(input_path)\n  let main_stmts = array_empty()\n  append_stmt_array(main_stmts, resolved_type_stmts)\n  append_non_import_stmts(main_stmts, entry_stmts)\n  let bytes = compile_wasi_module_linked_impl(main_stmts, entry_name, empty_source_pairs(), linked_imports, false, false, false, false, false, false, empty_dbg_prov())\n  (bytes, linked_dep_specs)\n}\n\n/// Gate v2 (#492): parse + typecheck only, with imports linked. The checker\n/// knows builtin signatures, so this surfaces REAL language/checker\n/// expressiveness gaps (parse errors, type errors, genuine unknown names)\n/// WITHOUT the codegen builtin-body-linking confounder that makes the `debug`\n/// mode emit spurious `undefined variable: Ns::method`. No wasm is produced.\nexport fn check_linked_file(input_path: String) -> Int with { Error, Fs } {\n  // #946(3): parse the entry file OURSELVES first (located + recovering —\n  // see the import comment above) so a parse error is reported with an exact\n  // `line:col` before any other check runs.\n  let entry_source = Fs::read_file(input_path)\n  let (tokens, starts, _ends) = lex_with_offsets(entry_source)\n  let (entry_stmts, parse_diags) = parse_program_recovering(tokens, starts, entry_source)\n  if Array::length(parse_diags) > 0 {\n    // Already a full `line L:col C: msg` string (see the import comment\n    // above) -- report just the first, matching check's one-error-at-a-time\n    // convention (vibe diagnostics is the multi-diagnostic surface).\n    throw(Array::get(parse_diags, 0))\n  } else {\n    ()\n  }\n  // #946 P1 (Codex, PR #1006): the type-check itself must go through\n  // check_file_fs_mode (the fs-mode source-group + db_typecheck_fs pipeline\n  // compile_file_fs_mode already relies on for a real compile), NOT\n  // collect_linked_dep_inputs_for_stmts + check_program. That \"linked\"\n  // mechanism exists to feed the wasm import-linking codegen boundary: it\n  // copies a dependency's SEnum/struct declarations into the checked stmts\n  // but never a `let rec fn` signature, so check_program never learned an\n  // imported function's real type and a wrong-typed call site (e.g.\n  // `f(\"x\")` against `fn f(x: Int)`) typechecked cleanly no matter what was\n  // passed — confirmed via a live two-file repro before this fix.\n  //\n  // collect_linked_dep_inputs_for_stmts is still used below, ONLY to build\n  // the merged stmts check_inline_wasm_fns scans (inline-wasm fns can live in\n  // an imported file too) — that scan is independent of type information.\n  handle {\n    let _ = check_file_fs_mode(input_path)\n    let (resolved_type_stmts, _linked_imports, _linked_dep_specs) = collect_linked_dep_inputs_for_stmts(input_path, entry_stmts)\n    let stmts = array_empty()\n    append_stmt_array(stmts, resolved_type_stmts)\n    append_stmt_array(stmts, entry_stmts)\n    expand_interp_stmts(stmts)\n    // #946(3): locate errors against the ENTRY file's own source text. `stmts`\n    // is the MERGED entry+deps statement list, so a [@off=N]/by-name location\n    // is only exact for errors whose blame is in the entry file itself (the\n    // common case, and the one every located-diagnostic regression test\n    // exercises); an error rooted in an imported dependency degrades to the\n    // unlocated message, same as before this fix, rather than mis-locating it\n    // against the wrong file's text.\n    match check_inline_wasm_fns(stmts) {\n      Some(msg) => throw(locate_type_error(entry_source, msg)),\n      None => ()\n    }\n  } with Error {\n    Throw(msg) => throw(locate_type_error(entry_source, msg))\n  }\n  0\n}\n\n//# Release wasm stripping (#1100 size)\n\n/// Read one unsigned LEB128 at `i`; returns (value, next_index) or (-1, end)\n/// when malformed/truncated so callers can bail out to the untouched input.\nfn strip_read_uleb(wasm: Bytes, start: Int, end: Int) -> (Int, Int) {\n  let mut i = start\n  let mut v = 0\n  let mut shift = 0\n  while i < end && shift < 35 {\n    let b = Bytes::get(wasm, i)\n    v = v|((b&127)<<shift)\n    i = i + 1\n    if (b&128) == 0 {\n      return (v, i)\n    } else {\n      shift = shift + 7\n    }\n  }\n  (0 - 1, end)\n}\n\nfn strip_bytes_range_eq_str(wasm: Bytes, start: Int, n: Int, s: String) -> Bool {\n  if n != String::length(s) {\n    false\n  } else {\n    let mut i = 0\n    let mut same = true\n    while same && i < n {\n      if Bytes::get(wasm, start + i) != String::char_code_at(s, i) {\n        same = false\n      } else {\n        i = i + 1\n      }\n    }\n    same\n  }\n}\n\nfn strip_bytes_range_starts_with(wasm: Bytes, start: Int, n: Int, prefix: String) -> Bool {\n  let plen = String::length(prefix)\n  if n < plen {\n    false\n  } else {\n    strip_bytes_range_eq_str(wasm, start, plen, prefix)\n  }\n}\n\nfn strip_push_range(out: Bytes, wasm: Bytes, start: Int, end: Int) -> Unit {\n  let mut i = start\n  while i < end {\n    Bytes::push(out, Bytes::get(wasm, i))\n    i = i + 1\n  }\n}\n\nfn strip_push_uleb(out: Bytes, value: Int) -> Unit {\n  let mut v = value\n  let mut more = true\n  while more {\n    let b = v&127\n    v = v>>7\n    if v == 0 {\n      Bytes::push(out, b)\n      more = false\n    } else {\n      Bytes::push(out, b|128)\n    }\n  }\n}\n\n/// Executable-output post-pass: drop the `name` custom section (debug info)\n/// and/or filter the export section down to the entries an executable's\n/// runners actually address by name — the entry function, `_start`,\n/// `cli_main`, per-block `__bench_*`/`__test_*` exports, and every non-function\n/// export (memory / `__heap_ptr` global / `error` tag). Everything else is a\n/// module-linking artifact (`*_exp_lib__*` mangled names from the flat module\n/// source) that nothing external can reasonably call. Section-level surgery\n/// only: removing a custom section or export ENTRIES never renumbers any\n/// index, so the code/table/elem sections are byte-identical. Any parse\n/// anomaly returns the input untouched. Component/library/test paths must NOT\n/// come through here — components lift core exports by name and `vibe test`\n/// tooling reads `__test_*` frames from the name section (callers gate on\n/// entry_name/env, see strip_executable_wasm_env).\nexport fn strip_executable_wasm(wasm: Bytes, entry_name: String, strip_names: Bool, filter_exports: Bool) -> Bytes {\n  if !strip_names && !filter_exports {\n    return wasm\n  } else {\n    ()\n  }\n  let len = Bytes::length(wasm)\n  if len < 8 {\n    return wasm\n  } else {\n    ()\n  }\n  let out = Bytes::new()\n  strip_push_range(out, wasm, 0, 8)\n  let mut i = 8\n  let mut ok = true\n  while ok && i < len {\n    let sid = Bytes::get(wasm, i)\n    let (ssz, payload_start) = strip_read_uleb(wasm, i + 1, len)\n    if ssz < 0 || payload_start + ssz > len {\n      ok = false\n    } else {\n      let payload_end = payload_start + ssz\n      let mut handled = false\n      if sid == 0 && strip_names {\n        // custom section: drop iff its name is exactly \"name\"\n        let (cn_len, cn_start) = strip_read_uleb(wasm, payload_start, payload_end)\n        if cn_len >= 0 && cn_start + cn_len <= payload_end {\n          if strip_bytes_range_eq_str(wasm, cn_start, cn_len, \"name\") {\n            handled = true\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n      if !handled && sid == 7 && filter_exports {\n        let (exp_count, cur0) = strip_read_uleb(wasm, payload_start, payload_end)\n        if exp_count >= 0 {\n          let kept = Bytes::new()\n          let mut kept_count = 0\n          let mut cur = cur0\n          let mut ei = 0\n          let mut parse_ok = true\n          while parse_ok && ei < exp_count {\n            let entry_start = cur\n            let (nlen, nstart) = strip_read_uleb(wasm, cur, payload_end)\n            if nlen < 0 || nstart + nlen + 1 > payload_end {\n              parse_ok = false\n            } else {\n              let kind = Bytes::get(wasm, nstart + nlen)\n              let (_eidx, entry_end) = strip_read_uleb(wasm, nstart + nlen + 1, payload_end)\n              if entry_end > payload_end {\n                parse_ok = false\n              } else {\n                let keep = kind != 0 || strip_bytes_range_eq_str(wasm, nstart, nlen, entry_name) || strip_bytes_range_eq_str(wasm, nstart, nlen, \"_start\") || strip_bytes_range_eq_str(wasm, nstart, nlen, \"cli_main\") || strip_bytes_range_starts_with(wasm, nstart, nlen, \"__bench_\") || strip_bytes_range_starts_with(wasm, nstart, nlen, \"__test_\")\n                if keep {\n                  strip_push_range(kept, wasm, entry_start, entry_end)\n                  kept_count = kept_count + 1\n                } else {\n                  ()\n                }\n                cur = entry_end\n                ei = ei + 1\n              }\n            }\n          }\n          if parse_ok {\n            Bytes::push(out, 7)\n            let sec_content = Bytes::new()\n            strip_push_uleb(sec_content, kept_count)\n            Bytes::append(sec_content, kept)\n            strip_push_uleb(out, Bytes::length(sec_content))\n            Bytes::append(out, sec_content)\n            handled = true\n          } else {\n            ok = false\n          }\n        } else {\n          ok = false\n        }\n      } else {\n        ()\n      }\n      if ok && !handled {\n        strip_push_range(out, wasm, i, payload_end)\n      } else {\n        ()\n      }\n      i = payload_end\n    }\n  }\n  if ok {\n    out\n  } else {\n    wasm\n  }\n}\n\n/// Env-gated policy wrapper shared by the CLI adapter (env-mode interface) and\n/// the command dispatch layer: executables (a real entry name) are stripped by\n/// default; `__no_entry__` builds (test/bench/serve cores) are left untouched\n/// because their tooling reads `__test_*` name-section frames, greps the\n/// binary for `__test_`, enumerates `__bench_*` exports, or lifts component\n/// exports by name. VIBE_WASM_NAMES=1 keeps the name section (profiling /\n/// trap-backtrace workflows); VIBE_WASM_KEEP_EXPORTS=1 keeps every export.\nexport fn strip_executable_wasm_env(wasm: Bytes, entry_name: String) -> Bytes with { Env } {\n  if entry_name == \"__no_entry__\" {\n    wasm\n  } else {\n    strip_executable_wasm(wasm, entry_name, Env::get(\"VIBE_WASM_NAMES\") != \"1\", Env::get(\"VIBE_WASM_KEEP_EXPORTS\") != \"1\")\n  }\n}\n\nexport fn write_linked_debug_build(input_path: String, output_path: String, entry_name: String) -> Unit with { Error, Fs } {\n  let (entry_bytes, linked_dep_specs) = build_linked_debug_entry(input_path, entry_name)\n  Fs::write_bytes(output_path, entry_bytes)\n  let output_dir = linked_output_dir(output_path)\n  let mut i = 0\n  while i < Array::length(linked_dep_specs) {\n    let (module_name, dep_path) = Array::get(linked_dep_specs, i)\n    let lib_output_path = String::concat(output_dir, String::concat(\"/\", String::concat(module_name, \".wasm\")))\n    let lib_bytes = compile_debug_library(dep_path)\n    Fs::write_bytes(lib_output_path, lib_bytes)\n    i = i + 1\n  }\n}\n")
}

let cli_adapter_source_253 = () -> (String, String) {
  ("lib/@vibe/compiler/inspect_update.vibe",
"//# `vibe test --update` snapshot patcher (#1061 follow-up, #1235 review).\n//#\n//# lib/@vibe/core/assert.vibe's `inspect(value, content)` prints\n//#   inspect mismatch:\n//#     actual:   <ACTUAL>\n//#     expected: <EXPECTED>\n//# and traps on a mismatch. This module is the pure string-processing core\n//# of the auto-update workflow: given a test file's source and a failing\n//# run's captured stdout, compute the source with the stale `content`\n//# literal rewritten to the actual value -- or None if nothing recognizable\n//# was found. inspect() itself is unchanged.\n//#\n//# Lives in lib/@vibe/compiler/ (not lib/@vibe/cli/) and is wired into\n//# cli_adapter.vibe's `cli_main` as a VIBE_INSPECT_UPDATE=1 low-level mode,\n//# the same (input_path, output_path) + extra-env-var-for-a-second-path\n//# convention as VIBE_NORMALIZE/VIBE_TYPE_AT/etc right above it in that\n//# file. This keeps `vibe test --update` install-safe: cli_adapter.vibe's\n//# `cli_main` IS the production `vibe-cli.wasm` runtime/vibe already ships\n//# and invokes for every other subcommand, unlike a separate small entry\n//# file (lib/@vibe/cli/fmt_entry.vibe's approach) which only works from a\n//# full dev-repo checkout that can compile that extra source file on\n//# demand -- `vibe fmt` is dev-only for exactly that reason, but `vibe\n//# test` is a real end-user command (runtime/vibe's `test)` case, smoke-\n//# tested in CI) and must work from an installed vibe-cli.wasm alone.\n//#\n//# File I/O for this mode is the CLASSIC Fs effect (Fs::read_file via\n//# cli_adapter.vibe's existing input_path/output_path plumbing), not\n//# wasi-p3: @vibe/wasi/p3 (lib/@vibe/wasi/p3/) only implements the HTTP\n//# world today (handler.vibe/http_effect.vibe) -- its world.wit imports no\n//# filesystem interface at all, so there is nothing p3-side to call yet.\n//# Wiring a real p3 fs effect (new host imports on every runner, WIT world\n//# surface, effect-row plumbing) is a separate, much larger feature than\n//# this tool needs; the classic Fs effect is what every other cli_adapter\n//# mode already uses for exactly this kind of read-a-file/write-a-file work.\n//#\n//# The patch is scoped to actual `inspect(...)` call sites (not any string\n//# literal in the file): find_content_arg_span below walks the source\n//# looking for `inspect(` calls, and for each one determines whether the\n//# LAST argument (content) is exactly the stale literal, using a small\n//# string-literal-aware paren scanner rather than real AST/CST span\n//# tracking (EString carries no byte offset today). Two DISTINCT inspect()\n//# calls with byte-identical `content` still can't be told apart by text\n//# alone -- the first one (in file order) is patched; the caller\n//# (runtime/vibe's `test --update` loop) re-converges across iterations\n//# since each run's trap surfaces the next distinct mismatch. An <ACTUAL>\n//# value containing the literal substring \"\\n  expected: \" defeats\n//# parse_inspect_mismatch below.\n\n//# Escaping (mirrors lib/@vibe/compiler/fmt/format.vibe's write_escaped_char\n//# / quote_string_literal -- private to that package, so duplicated here at\n//# this tool's small scope rather than exporting a formatter-internal).\n\nfn escape_inspect_char(c: Int) -> String {\n  if c == '\\n' {\n    \"\\\\n\"\n  } else if c == '\\t' {\n    \"\\\\t\"\n  } else if c == '\\r' {\n    \"\\\\r\"\n  } else if c == '\\\\' {\n    \"\\\\\\\\\"\n  } else if c == '\"' {\n    \"\\\\\\\"\"\n  } else {\n    String::from_char_code(c)\n  }\n}\n\nfn quote_inspect_literal(text: String) -> String {\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, \"\\\"\")\n  let n = String::length(text)\n  let mut i = 0\n  while i < n {\n    StringBuilder::push(sb, escape_inspect_char(String::char_code_at(text, i)))\n    i = i + 1\n  }\n  StringBuilder::push(sb, \"\\\"\")\n  StringBuilder::freeze(sb)\n}\n\n//# Mismatch diagnostic parsing\n\nfn strip_one_trailing_newline(s: String) -> String {\n  let n = String::length(s)\n  if n > 0 && s[n - 1: n] == \"\\n\" {\n    s[0: n - 1]\n  } else {\n    s\n  }\n}\n\n/// Returns (actual, expected) from the FIRST \"inspect mismatch:\\n  actual:\n/// ...\\n  expected: ...\" block in `captured_in`, or None. println() appends\n/// exactly one trailing \"\\n\" terminator after the whole diagnostic (#1235\n/// review, P2) -- strip only that one so a snapshot value that itself\n/// legitimately ends in \"\\n\" isn't truncated; `expected` runs to the true\n/// end of the (trimmed) captured text.\nfn parse_inspect_mismatch(captured_in: String) -> Option[(String, String)] {\n  let captured = strip_one_trailing_newline(captured_in)\n  let marker = \"inspect mismatch:\\n  actual:   \"\n  let start = String::index_of(captured, marker)\n  if start < 0 {\n    None\n  } else {\n    let after_marker = start + String::length(marker)\n    let sep = \"\\n  expected: \"\n    let tail = captured[after_marker: String::length(captured)]\n    let sep_idx = String::index_of(tail, sep)\n    if sep_idx < 0 {\n      None\n    } else {\n      let actual_end = after_marker + sep_idx\n      let actual = captured[after_marker: actual_end]\n      let expected_start = actual_end + String::length(sep)\n      let expected = captured[expected_start: String::length(captured)]\n      Some((actual, expected))\n    }\n  }\n}\n\n//# inspect(...) call-scoped literal search\n\nfn is_ident_char(c: Int) -> Bool {\n  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n}\n\n/// Given the index of an `inspect(`'s opening `(`, return the index just\n/// past its matching `)`, skipping over paren/quote characters that appear\n/// inside nested string literals (backslash-escaped quotes included). -1 if\n/// unbalanced (unterminated call/string -- caller treats it as no-match).\nfn find_matching_close_paren(src: String, open_idx: Int) -> Int {\n  let n = String::length(src)\n  let mut i = open_idx\n  let mut depth = 0\n  let mut result = -1\n  while result < 0 && i < n {\n    let c = String::char_code_at(src, i)\n    if c == '\"' {\n      i = i + 1\n      let mut in_str = true\n      while in_str && i < n {\n        let sc = String::char_code_at(src, i)\n        if sc == '\\\\' {\n          i = i + 2\n        } else if sc == '\"' {\n          i = i + 1\n          in_str = false\n        } else {\n          i = i + 1\n        }\n      }\n    } else if c == '(' {\n      depth = depth + 1\n      i = i + 1\n    } else if c == ')' {\n      depth = depth - 1\n      if depth == 0 {\n        result = i + 1\n      } else {\n        i = i + 1\n      }\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n/// True iff `s` is zero or more whitespace characters followed by exactly\n/// one \")\" as its last character -- i.e. `old_lit` sits immediately before\n/// the call's closing paren (mod trailing whitespace/newlines), meaning it\n/// really is the LAST (content) argument, not a substring of an earlier one.\nfn is_whitespace_then_close_paren(s: String) -> Bool {\n  let n = String::length(s)\n  if n == 0 {\n    false\n  } else if s[n - 1: n] != \")\" {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while ok && i < n - 1 {\n      let c = String::char_code_at(s, i)\n      if c == ' ' || c == '\\t' || c == '\\n' || c == '\\r' {\n        i = i + 1\n      } else {\n        ok = false\n      }\n    }\n    ok\n  }\n}\n\n/// Scan `src` for the FIRST `inspect(...)` call (in file order, word-boundary\n/// checked so \"reinspect(\" doesn't false-match) whose content argument is\n/// exactly `old_lit` (already quoted/escaped). Returns the absolute\n/// (start, end) byte span of that literal within `src`, or None.\nfn find_content_arg_span(src: String, old_lit: String) -> Option[(Int, Int)] {\n  let n = String::length(src)\n  let needle = \"inspect(\"\n  let needle_len = String::length(needle)\n  let old_len = String::length(old_lit)\n  let mut from = 0\n  let mut result: Option[(Int, Int)] = None\n  let mut done = false\n  while !done {\n    if from > n - needle_len {\n      done = true\n    } else {\n      let rel = String::index_of(src[from: n], needle)\n      if rel < 0 {\n        done = true\n      } else {\n        let m_start = from + rel\n        let boundary_ok = m_start == 0 || !is_ident_char(String::char_code_at(src, m_start - 1))\n        if !boundary_ok {\n          from = m_start + 1\n        } else {\n          let open_idx = m_start + needle_len - 1\n          let call_end = find_matching_close_paren(src, open_idx)\n          if call_end < 0 {\n            from = m_start + 1\n          } else {\n            let call_text = src[open_idx: call_end]\n            let pos = String::last_index_of(call_text, old_lit)\n            if pos >= 0 && is_whitespace_then_close_paren(call_text[pos + old_len: String::length(call_text)]) {\n              let abs_start = open_idx + pos\n              result = Some((abs_start, abs_start + old_len))\n              done = true\n            } else {\n              from = m_start + 1\n            }\n          }\n        }\n      }\n    }\n  }\n  result\n}\n\n//# Orchestration\n\n/// Compute the patched source for one convergence step, or None if the\n/// captured output has no recognizable inspect() mismatch, or no\n/// inspect(...) call's content argument matches the diagnosed expected\n/// text verbatim.\nexport fn compute_updated_source(src: String, captured: String) -> Option[String] {\n  match parse_inspect_mismatch(captured) {\n    None => None,\n    Some((actual, expected)) => {\n      let old_lit = quote_inspect_literal(expected)\n      match find_content_arg_span(src, old_lit) {\n        None => None,\n        Some((start, end)) => {\n          let new_lit = quote_inspect_literal(actual)\n          Some(String::concat(src[0: start], String::concat(new_lit, src[end: String::length(src)])))\n        }\n      }\n    }\n  }\n}\n")
}

let cli_adapter_source_254 = () -> (String, String) {
  ("lib/@vibe/compiler/cli_adapter.vibe",
"//# Imports\n\n// #897: package-form import (wasi_only/ is now an index.vpkg boundary) --\n// these used to be two separate leaf imports (preprocess.vibe,\n// merge_sources.vibe), now merged into one.\nimport @vibe/compiler/entry/source_compile/wasi_only {\n  comp_emit_component_wasm_string_handler,\n  compile_source_wasi_only,\n  compile_source_wasi_only_coverage,\n  compile_source_wasi_only_rc,\n  compile_source_wasi_only_rc_shadow,\n  merged_program_source_fs\n}\n\nimport @vibe/compiler/entry/source_compile/gc_only {\n  compile_source_gc_only\n}\n\nimport @vibe/compiler/runtime {\n  binding_occurrences,\n  build_funcmap_from_source,\n  build_module_source_from_source,\n  collect_all_diagnostics,\n  doc_at_source,\n  module_plan_manifest_fs,\n  run_module_job_dir,\n  run_publish_env_cache_dir,\n  set_collect_module_diagnostics,\n  set_dep_order_seed,\n  set_scheduler_trace_path,\n  symbol_spans,\n  type_at_source\n}\n\nimport @vibe/compiler/loader {\n  contract_package_hashes_fs,\n  fill_require_pins_fs_mode,\n  find_deps_missing,\n  find_missing_vpkg_dirs,\n  ingest_source_text_fs,\n  load_or_parse_module_header_fs,\n  publish_check_fs,\n  write_generated_hash_fs\n}\n\nimport @vibe/compiler/entry/compiler/file_compile {\n  compile_file_fs_mode,\n  compile_file_fs_mode_break,\n  compile_file_fs_mode_coverage,\n  compile_file_fs_mode_rc,\n  compile_file_fs_mode_rc_shadow,\n  compile_file_fs_mode_testmeta,\n  compile_file_fs_mode_trace,\n  entry_cacheable_for_fs\n}\n\nimport @vibe/compiler/normalize {\n  normalize_source\n}\n\nimport ./inspect_update.vibe {\n  compute_updated_source\n}\n\nimport ./wit_gen.vibe {\n  serve_handler_param_names, validate_serve_handler, wit_from_program\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program\n}\n\nimport ./cli_support.vibe {\n  check_linked_file, strip_executable_wasm_env\n}\n\nimport @vibe/lsp {\n  lsp_diagnostics_json_string, lsp_main\n}\n\nimport @vibe/compiler/checker {\n  set_error_row_checked\n}\n\n//# Functions\n\n/// Basename of a path without its `.vibe` suffix — the default WIT world name\n/// for #537 (`foo/bar_server.vibe` -> `bar_server`, kebab-cased by wit_gen).\nfn adapter_basename_no_vibe(path: String) -> String {\n  let len = String::length(path)\n  let mut last_slash = 0 - 1\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(path, i) == 47 {\n      last_slash = i\n    }\n    i = i + 1\n  }\n  let base = path[last_slash + 1: len]\n  let blen = String::length(base)\n  if blen >= 5 && base[blen - 5: blen] == \".vibe\" {\n    base[0: blen - 5]\n  } else {\n    base\n  }\n}\n\n/// Join `items` with \"\\n\" using String::concat only (no `+`/interpolation, which\n/// can miscodegen NUL here). Empty array -> \"\".\nfn join_lines(items: Array[String]) -> String {\n  let n = Array::length(items)\n  if n == 0 {\n    \"\"\n  } else {\n    // O(N) join via StringBuilder; per-item String::concat was O(N²) (issue #366).\n    let acc = StringBuilder::new()\n    StringBuilder::push(acc, Array::get(items, 0))\n    let mut i = 1\n    while i < n {\n      StringBuilder::push(acc, \"\\n\")\n      StringBuilder::push(acc, Array::get(items, i))\n      i = i + 1\n    }\n    StringBuilder::freeze(acc)\n  }\n}\n\n/// Render `vibe symbols` records as one `NAME KIND START END` line per declared\n/// symbol (space-separated; KIND/START/END are ints), joined by \"\\n\". Records\n/// with an empty name (unrecoverable offset placeholder) are skipped.\n/// String::concat + __to_string only (never `+`/interpolation -> NUL miscodegen).\n/// Empty -> \"\".\nfn join_symbol_spans(syms: Array[(String, Int, Int, Int)]) -> String {\n  let n = Array::length(syms)\n  // O(N) join via StringBuilder; per-record String::concat was O(N²) (issue #366).\n  let acc = StringBuilder::new()\n  let mut first = true\n  let mut i = 0\n  while i < n {\n    let (name, kind, s, e) = Array::get(syms, i)\n    if String::length(name) == 0 {\n      ()\n    } else {\n      let line = String::concat(name, String::concat(\" \", String::concat(__to_string(kind), String::concat(\" \", String::concat(__to_string(s), String::concat(\" \", __to_string(e)))))))\n      if first {\n        StringBuilder::push(acc, line)\n        first = false\n      } else {\n        StringBuilder::push(acc, \"\\n\")\n        StringBuilder::push(acc, line)\n      }\n    }\n    i = i + 1\n  }\n  StringBuilder::freeze(acc)\n}\n\n/// Render `vibe binding-at` occurrences as one `START END` line per span (two\n/// space-separated ints), joined by \"\\n\". String::concat + __to_string only\n/// (never `+`/interpolation, which miscodegen NUL here). Empty -> \"\".\nfn join_binding_occurrences(occ: Array[(Int, Int)]) -> String {\n  let n = Array::length(occ)\n  if n == 0 {\n    \"\"\n  } else {\n    let (s0, e0) = Array::get(occ, 0)\n    // O(N) join via StringBuilder; per-occurrence String::concat was O(N²) (issue #366).\n    let acc = StringBuilder::new()\n    StringBuilder::push(acc, String::concat(__to_string(s0), String::concat(\" \", __to_string(e0))))\n    let mut i = 1\n    while i < n {\n      let (s, e) = Array::get(occ, i)\n      let line = String::concat(__to_string(s), String::concat(\" \", __to_string(e)))\n      StringBuilder::push(acc, \"\\n\")\n      StringBuilder::push(acc, line)\n      i = i + 1\n    }\n    StringBuilder::freeze(acc)\n  }\n}\n\n/// Parse a non-negative decimal int from `s`; on any non-digit (or empty) return\n/// `default`. String::concat-safe (no `+`/interpolation): folds digits via\n/// `acc * 10 + (c - '0')`.\nfn parse_int_or(s: String, default: Int) -> Int {\n  let len = String::length(s)\n  if len == 0 {\n    default\n  } else {\n    let mut i = 0\n    let mut acc = 0\n    let mut ok = true\n    while ok && i < len {\n      let c = String::char_code_at(s, i)\n      if c >= '0' && c <= '9' {\n        acc = acc * 10 + (c - '0')\n        i = i + 1\n      } else {\n        ok = false\n      }\n    }\n    if ok {\n      acc\n    } else {\n      default\n    }\n  }\n}\n\nfn adapter_string_to_bytes(s: String) -> Bytes {\n  let out = Array::slice([\n    0\n  ], 0, 0)\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Array::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  Bytes::from_array(out)\n}\n\nfn read_arg_or_env(index: Int, env_name: String) -> String with { Env } {\n  let value = Env::args_get(index)\n  if value != \"\" {\n    value\n  } else {\n    Env::get(env_name)\n  }\n}\n\nfn own_host_string(value: String) -> String {\n  String::concat(\"\", value)\n}\n\nfn profile_memory_mark(enabled: Bool) -> Unit with { Env } {\n  if enabled {\n    let _ = Env::get(\"VIBE_PROFILE_MEMORY_MARK\")\n    ()\n  } else {\n    ()\n  }\n}\n\n/// #cfg activation: VIBE_CFG=flag1,flag2 appends `#cfg_enable(flag)` directive\n/// lines to the source (appending at the END keeps every original byte offset,\n/// so diagnostics/spans are unaffected). parse_program pre-scans for these and\n/// keeps the matching `#cfg(flag)` statements; with VIBE_CFG unset, every\n/// #cfg-guarded statement is parsed-and-dropped -- zero bytes in the output.\nfn apply_cfg_env(source: String, cfg_csv: String) -> String {\n  if cfg_csv == \"\" {\n    source\n  } else {\n    let parts = String::split(cfg_csv, \",\")\n    let mut out = source\n    let mut i = 0\n    while i < Array::length(parts) {\n      let flag = String::trim(Array::get(parts, i))\n      if String::length(flag) > 0 {\n        out = String::concat(out, String::concat(\"\\n#cfg_enable(\", String::concat(flag, \")\")))\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    out\n  }\n}\n\nfn compile_source_for_rc_flag(source: String, entry_name: String, rc_flag: String) -> Bytes with { Error } {\n  // ADR-0055 #493 cutover: the Perceus RC codegen (memory-reclaiming linear\n  // backend) is the DEFAULT; set VIBE_RC=0 to opt back into the legacy bump\n  // path. The compiler self-build, bootstrap, and bump-baseline gates pin\n  // VIBE_RC=0 (see scripts/*.sh) so they stay byte-identical on bump.\n  if rc_flag == \"shadow\" {\n    // #715 recurrence guard: RC codegen + shadow-liveness traps (debug builds).\n    compile_source_wasi_only_rc_shadow(source, entry_name)\n  } else if rc_flag != \"0\" {\n    compile_source_wasi_only_rc(source, entry_name)\n  } else {\n    compile_source_wasi_only(source, entry_name)\n  }\n}\n\n/// On a parse/type/codegen error the checker throws a formatted diagnostic\n/// String. Surface it to tooling by writing it to an `<output>.diag` sidecar so\n/// the `vibe` launcher can print a real message instead of an opaque wasm trap.\n/// Returns a non-zero exit code. (#594 usability / docs/release-roadmap.md.)\nfn emit_compile_diag(output_path: String, msg: String) -> Int with { Fs } {\n  Fs::write_file(String::concat(output_path, \".diag\"), msg)\n  1\n}\n\n/// debugger テーマ3 / M2: best-effort `.funcmap` sidecar beside the compiled wasm.\n/// Maps each ENTRY-file top-level function to its 1-based source line so the\n/// `vibe run` launcher can annotate trap backtrace frames with (file:line). The\n/// wasm \"name\" section (debugger P0) already names the frames; this adds lines.\n///\n/// Best-effort: a failure to build/write the funcmap must NOT fail the compile —\n/// the wasm write already returned 0. So we wrap the work in its own handler and\n/// swallow any Error::Throw. Entry-file functions only (imported modules: future\n/// work).\n/// Returns 0 (the value is consumed at the call site so the call is never DCE'd:\n/// it is a discarded `Unit` side-effect otherwise, which aggressive DCE in the\n/// seed compiler may drop).\nfn write_funcmap_sidecar(input_path: String, output_path: String) -> Int with { Fs, Error } {\n  let src = Fs::read_file(input_path)\n  let text = build_funcmap_from_source(src)\n  Fs::write_bytes(String::concat(output_path, \".funcmap\"), adapter_string_to_bytes(text))\n  0\n}\n\n/// #537 `vibe compile --wit`: emit the WIT world for the file's effect surface\n/// (exported functions -> world exports; their `with { E }` rows -> world\n/// imports). Imports resolved from FS. Contract: docs/effect-wit-mapping.md.\n/// The Error handle is this function's tail (the proven adapter shape) rather\n/// than a `return handle` inside cli_main's dispatch chain.\n/// Entry-file-only surface scan (v1): exports and effect declarations are read\n/// from the entry file itself; effects declared only in imported modules render\n/// as host-capability comments (documented in docs/effect-wit-mapping.md).\nfn adapter_emit_wit(input_path: String, output_path: String) -> Int with { Fs, Env } {\n  handle {\n    let entry_stmts = parse_program(lex(Fs::read_file(input_path)))\n    let wit = wit_from_program(entry_stmts, entry_stmts, adapter_basename_no_vibe(input_path))\n    Fs::write_bytes(output_path, adapter_string_to_bytes(wit))\n    0\n  } with Error {\n    Throw(msg) => emit_compile_diag(output_path, msg)\n  }\n}\n\n/// #537 `vibe serve` artifact step: validate the wasi-http P3 handler contract,\n/// compile the file, and wrap it into a component exporting\n///   handler: func(method, url, headers, body: string) -> string\n/// The runner layer (runtime/vibe serve) composes the result with the P3 HTTP\n/// adapter and launches `wasmtime serve` — artifact generation stays in the\n/// compiler, serving stays in the runner. VIBE_SERVE_WIT_OUT optionally writes\n/// the WIT world sidecar.\nfn adapter_serve_component(input_path: String, output_path: String) -> Int with { Fs, Env } {\n  handle {\n    let entry_stmts = parse_program(lex(Fs::read_file(input_path)))\n    validate_serve_handler(entry_stmts)\n    // No command entry: the component surface is `handler`. `__no_entry__`\n    // is the explicit sentinel — any other unknown entry name is a compile\n    // error since ADR-0069.\n    let core = compile_file_fs_mode(input_path, \"__no_entry__\", \"no-dce\")\n    let component = comp_emit_component_wasm_string_handler(core, \"handler\", \"handler\", serve_handler_param_names())\n    Fs::write_bytes(output_path, component)\n    let wit_out = Env::get(\"VIBE_SERVE_WIT_OUT\")\n    if wit_out != \"\" {\n      Fs::write_bytes(wit_out, adapter_string_to_bytes(wit_from_program(entry_stmts, entry_stmts, adapter_basename_no_vibe(input_path))))\n    } else {\n      ()\n    }\n    0\n  } with Error {\n    Throw(msg) => emit_compile_diag(output_path, msg)\n  }\n}\n\nexport fn cli_main() -> Int with { Error, Fs, Env, Stdin, Stdout } {\n  // #944 (ADR-0073 stage B): checked-Error row discipline is ON by\n  // default -- `Error::Throw` propagates to the caller's row like any\n  // other effect, dischargeable via `handle .. with Error`.\n  // `VIBE_CHECK_ERROR_ROW=0` is the temporary opt-out escape hatch for\n  // downstream code that hasn't annotated yet. Set before ANY compile\n  // path runs so every lane (file compile, FS compile, diagnostics, lsp)\n  // sees the same mode.\n  if Env::get(\"VIBE_CHECK_ERROR_ROW\") == \"0\" {\n    ()\n  } else {\n    set_error_row_checked(true)\n  }\n  // #906 Phase 0: dependency-visit-order oracle. A non-zero seed permutes\n  // each node's dep visit order (set_dep_order_seed, runtime/typecheck_fs.vibe);\n  // the compiled output must stay byte-identical across seeds, which is what\n  // scripts/dep_order_oracle.sh asserts. Unset (or 0) is the identity\n  // permutation -- the production walk -- so this is inert unless a test\n  // sets it. Read here with the other mode switches so every lane (file\n  // compile, FS compile, diagnostics) sees the same order.\n  let dep_seed_text = Env::get(\"VIBE_DEP_ORDER_SEED\")\n  if dep_seed_text == \"\" {\n    ()\n  } else {\n    match Int::parse(dep_seed_text) {\n      Some(dep_seed) => set_dep_order_seed(dep_seed),\n      None => ()\n    }\n  }\n  // #1259: report EVERY module's diagnostic, in canonical order, instead of\n  // stopping at the first. Read here with the other mode switches so the fs\n  // compile and `vibe check` lanes agree -- check_linked_file routes its\n  // typecheck through check_file_fs_mode / db_typecheck_fs (#946 P1), so both\n  // reach the collecting walk. Off (the default) is byte-for-byte the previous\n  // walk -- see set_collect_module_diagnostics in runtime/typecheck_fs.vibe\n  // for why flipping the default is a separate decision from having the\n  // mechanism.\n  //\n  // SCOPE (Codex review of PR #1264): this collects what the WALK sees, which\n  // is every module's type error and, since that review, its own syntax error\n  // too. It is not yet every diagnostic a build can produce: both CLI lanes\n  // run collect_source_groups_fs first, which parses every reachable file\n  // before db_typecheck_fs is called, so a syntax error still fails the build\n  // at that earlier point and only the first one is reported. Collecting\n  // there is a loader change, not a walk change.\n  if Env::get(\"VIBE_DIAGNOSTICS_ALL\") == \"1\" {\n    set_collect_module_diagnostics(true)\n  } else {\n    ()\n  }\n  // #1259 (#1239 step 8): dump the walk's planned graph and its actual step\n  // sequence for scripts/scheduler_trace_oracle.sh, which checks them against\n  // Scheduler.lean's Project / Ready / StoreCorrect / Complete. Read with the\n  // other mode switches so it covers the fs compile lane, which is the one\n  // that walks an import graph at all.\n  let scheduler_trace = Env::get(\"VIBE_SCHEDULER_TRACE\")\n  if scheduler_trace == \"\" {\n    ()\n  } else {\n    set_scheduler_trace_path(scheduler_trace)\n  }\n  // `vibe lsp` (self-hosted, #lsp-selfhost): takes over stdin/stdout\n  // directly as a long-running JSON-RPC server -- unlike every other mode\n  // below, it never reads VIBE_INPUT/VIBE_OUTPUT or writes to output_path.\n  // Checked first so it never touches the one-shot input/output-file\n  // machinery the rest of this function assumes.\n  if Env::get(\"VIBE_LSP\") == \"1\" {\n    return lsp_main()\n  }\n  let input_path = own_host_string(read_arg_or_env(0, \"VIBE_INPUT\"))\n  let output_path = own_host_string(read_arg_or_env(1, \"VIBE_OUTPUT\"))\n  let entry_name = own_host_string(read_arg_or_env(2, \"VIBE_ENTRY\"))\n  let mark_memory = Env::get(\"VIBE_PROFILE_MEMORY_MARKS\") == \"1\"\n  // #730 (D-2): `vibe hash` — print a contract package's content-addressing\n  // hashes. Input is the package's index.vibei; the output file receives\n  // \"package #pkg:sha1:<hex>\" and \"contract ct:sha1:<hex>\" lines. The\n  // package line is copy-pasteable as a require pin.\n  if Env::get(\"VIBE_HASH\") == \"1\" {\n    return handle {\n      let (pkg_hash, ct_hash) = contract_package_hashes_fs(input_path)\n      Fs::write_file(output_path, \"package #\\{pkg_hash}\\ncontract \\{ct_hash}\\n\")\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #1145 follow-up 3: `vibe hash --write <index.vpkg>` -- computes the\n  // same package content hash as VIBE_HASH above and writes the file's full\n  // text, with `generated_hash = ` rewritten to the computed pin, to the\n  // output path. input_path itself is left untouched (same read-only\n  // convention as VIBE_FILL_PINS above); the launcher copies output_path\n  // over the real target in place.\n  if Env::get(\"VIBE_HASH_WRITE\") == \"1\" {\n    return handle {\n      let rewritten = write_generated_hash_fs(input_path)\n      Fs::write_file(output_path, rewritten)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #897 (ADR-0070): `vibe check --missing-vpkg <root>` -- recursively scan\n  // `input_path` (a directory) for every boundary directory still on the\n  // old `index.vibei`/bare `index.vibe` spelling. Writes \"ok: none missing\"\n  // on a clean tree, or the newline-joined list of directories on the same\n  // diag sidecar every other check diagnostic uses, matching VIBE_HASH's\n  // shape immediately above.\n  if Env::get(\"VIBE_MISSING_VPKG_SCAN\") == \"1\" {\n    return handle {\n      let missing = find_missing_vpkg_dirs(input_path)\n      if Array::length(missing) == 0 {\n        Fs::write_file(output_path, \"ok: no directories missing index.vpkg under \\{input_path}\\n\")\n      } else {\n        Fs::write_file(output_path, String::concat(String::join(missing, \"\\n\"), \"\\n\"))\n      }\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #1145 follow-up 2: `vibe check --deps-missing <root>` -- recursively\n  // scan `input_path` for #1128-migrated `index.vpkg` files (ones with a\n  // `name = ` directive) whose own production imports reference an\n  // external package absent from their `deps` block. Same \"ok: none\" /\n  // newline-joined-list shape as VIBE_MISSING_VPKG_SCAN immediately above.\n  if Env::get(\"VIBE_DEPS_MISSING_SCAN\") == \"1\" {\n    return handle {\n      let missing = find_deps_missing(input_path)\n      if Array::length(missing) == 0 {\n        Fs::write_file(output_path, \"ok: no missing deps declarations under \\{input_path}\\n\")\n      } else {\n        Fs::write_file(output_path, String::concat(String::join(missing, \"\\n\"), \"\\n\"))\n      }\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #730 (D-3): `vibe fmt` pin insertion — fill unpinned require lines\n  // OFFLINE from the workspace store and write the completed source to the\n  // output path. Idempotent; pinned form is the canonical form.\n  if Env::get(\"VIBE_FILL_PINS\") == \"1\" {\n    return handle {\n      let filled = fill_require_pins_fs_mode(Fs::read_file(input_path), Env::get(\"VIBE_REPIN\") == \"1\")\n      Fs::write_file(output_path, filled)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #732 (Phase F): `vibe publish` semver gate. input = the NEXT contract;\n  // VIBE_PUBLISH_PREV / _PREV_VERSION / _VERSION describe the previous\n  // release. Writes \"ok\" on an honest bump; a dishonest claim is a diag.\n  if Env::get(\"VIBE_PUBLISH_CHECK\") == \"1\" {\n    return handle {\n      let perrors = publish_check_fs(Env::get(\"VIBE_PUBLISH_PREV\"), input_path, Env::get(\"VIBE_PUBLISH_PREV_VERSION\"), Env::get(\"VIBE_PUBLISH_VERSION\"))\n      if Array::length(perrors) > 0 {\n        throw(String::join(perrors, \"; \"))\n      } else ()\n      Fs::write_file(output_path, \"ok\\n\")\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #946(3): `vibe check` — parse + typecheck ONLY (imports resolved from the\n  // FS, same as VIBE_FS_COMPILE below), no codegen and no entry-function\n  // requirement. Before this, `vibe check` reused the full VIBE_FS_COMPILE\n  // (build) path, so an empty-or-comments-only file failed check with\n  // \"no functions found to compile\" (a real build/codegen constraint — you\n  // cannot emit a runnable wasm module with zero functions) while `vibe\n  // diagnostics` reported the SAME file clean: two contradictory judgments on\n  // one input. check_linked_file (Gate v2 #492) already implements the\n  // correct check-only semantics (it stops before codegen, so it has no\n  // notion of \"no functions\" or \"missing entry\" — both are build-only\n  // concerns) but was never wired to this CLI verb. Writes \"ok\\n\" on a clean\n  // parse+typecheck; a parse/type error goes to the `.diag` sidecar, same\n  // convention as every other adapter mode.\n  // #906 Phase 2: worker mode. `input_path` is a JOB DIRECTORY, not a\n  // source file, and it is the worker's entire filesystem sandbox --\n  // see run_module_job_dir (runtime/typecheck_fs.vibe) for its layout.\n  //\n  // This is checked BEFORE VIBE_CHECK_ONLY because the two answer different\n  // questions: check-only resolves a module's imports off the real\n  // filesystem, which is precisely what a worker must not do. A worker\n  // receives its dependencies' environments as values in the job.\n  if Env::get(\"VIBE_MODULE_JOB_DIR\") == \"1\" {\n    return handle {\n      run_module_job_dir(input_path)\n      0\n    } with Error {\n      // A throw here is an infrastructure failure (unreadable or malformed\n      // job dir), NOT a compiler diagnostic -- run_module_job_dir already\n      // turned every diagnostic into a value in the job dir. The\n      // coordinator must be able to tell those apart, so this goes to the\n      // .diag sidecar and a nonzero exit, leaving no outcome.txt behind.\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #906 Phase 2 (real-build wiring): batch publish for a host-side\n  // parallel pre-warm driver. `input_path` is a directory holding\n  // `manifest.txt` plus each row's env file -- see run_publish_env_cache_dir\n  // (runtime/typecheck_fs.vibe) for the exact layout and why the driver\n  // hands this off instead of writing the real cache path itself.\n  if Env::get(\"VIBE_PUBLISH_ENV_CACHE\") == \"1\" {\n    return handle {\n      run_publish_env_cache_dir(input_path)\n      Fs::write_file(output_path, \"ok\\n\")\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #906: resolved-dependency discovery for a HOST-SIDE project DAG walker.\n  // A host driver building ModuleJob values for the worker transport needs\n  // each file's direct dependencies as RESOLVED paths, in the same\n  // declaration order ensure_fingerprint_fs_go itself would see them --\n  // getting either wrong doesn't fail loudly, it silently walks the wrong\n  // graph. This calls load_or_parse_module_header_fs, the exact primitive\n  // resolve_deps_for_source_fs (runtime/typecheck_fs.vibe) uses, rather\n  // than re-deriving import resolution on the host: a second\n  // implementation of \"how an import path resolves\" is exactly the drift\n  // risk the #906 fingerprint fix (ModuleJob.dep_fps) closed for cache\n  // keys, and the same risk here would silently walk the wrong graph\n  // instead. One resolved path per line; empty for a leaf module.\n  if Env::get(\"VIBE_LIST_DEPS\") == \"1\" {\n    return handle {\n      let source = Fs::read_file(input_path)\n      // #1168 (Codex review, PR #1171): deps AND the hand-back source below\n      // must both derive from the INGESTED text, not the raw file bytes --\n      // ingest_source_text_fs can PREPEND imports a raw .vibe file never\n      // had (apply_vpkg_directory_shared_imports_fs, a directory-shared\n      // import inherited from an enclosing index.vpkg) or rewrite a\n      // contract's raw grammar into its desugared facade entirely. Deriving\n      // deps from raw source while handing back ingested source (as an\n      // earlier version of this fix did) would silently drop such an\n      // inherited import from the dependency graph: the worker gets a\n      // source that references it but no environment to resolve it\n      // against. ensure_fingerprint_fs_go's serial recursion never has this\n      // split -- resolve_deps_for_source_fs and check_module both operate\n      // on the SAME already-ingested `source` (ripple_get_source) -- so\n      // matching that here is what keeps this host-side path equivalent to\n      // the serial walk instead of an approximation of it.\n      let ingested = ingest_source_text_fs(input_path, source)\n      let (deps, _exports, _parse_count) = load_or_parse_module_header_fs(input_path, ingested, 0)\n      Fs::write_file(output_path, String::concat(String::join(deps, \"\\n\"), \"\\n\"))\n      // Hand back the SAME ingested source a parallel host driver must use\n      // to build this module's ModuleJob for the job-dir worker: check_module\n      // parses source with the ordinary module grammar, which a raw .vpkg\n      // contract (its own bodyless-decl/`export` grammar) is never valid\n      // input for. Piggybacking on the existing VIBE_LIST_DEPS spawn (rather\n      // than a second subprocess call per file) keeps #1170's discovery-loop\n      // parallelization win intact.\n      Fs::write_file(String::concat(output_path, \".src\"), ingested)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #1239 step 4(D): discovery AND ordering in ONE call.\n  //\n  // What this replaced split the work a coordinator needs -- resolve each\n  // module's imports, then rank the resulting graph -- across one spawn per\n  // module plus one more for the ordering (VIBE_LIST_DEPS above, once per\n  // module, then an ordering-only `VIBE_PLAN_MODULE_ORDER` mode over the\n  // collected edges). That per-module spawn is what dominated the whole\n  // path: on this repo's codegen_lexer_test.vibe graph (166 modules) the\n  // discovery loop measured 17.4s serially and 5.1s at 4-way concurrency,\n  // against 0.8s for this mode. Same graph, same canonical order -- the\n  // ordering still comes from plan_module_order, so there is still exactly\n  // one implementation of the rule.\n  //\n  // #1259 removed the ordering-only mode outright. It took resolved edges as\n  // TSV and emitted `<rank>\\t<path>`, which was the right shape while\n  // discovery lived in the driver; once discovery moved in here it had no\n  // caller left but its own gate. The rule it exposed is covered in-process\n  // by lib/@vibe/graph/module_order_test.vibe (11 cases: diamond, longest\n  // path, strict rank descent, visit-order invariance, cycles, self-import,\n  // unreachable modules), so deleting the mode cost no coverage -- only a\n  // supported env-var surface that nothing called.\n  //\n  // The whole-graph counterpart to VIBE_LIST_DEPS above --\n  // one call instead of one per module, and already in the canonical rank\n  // order a coordinator dispatches from. See module_plan_manifest_fs\n  // (compiler/runtime/typecheck_fs.vibe) for why the order comes from the\n  // compiler rather than the driver.\n  //\n  //   <output_path>            version / module / dep rows (manifest)\n  //   <output_path>.<i>.src    module i's ingested source\n  //\n  // `i` is the module's index in the manifest's canonical order, so a driver\n  // that reads the manifest already knows every source file's name without\n  // sanitizing paths -- which is what VIBE_LIST_DEPS's per-file `.src`\n  // companion needs a collision-proof unique id for (#1170).\n  if Env::get(\"VIBE_MODULE_PLAN\") == \"1\" {\n    return handle {\n      let (manifest, sources) = module_plan_manifest_fs(input_path)\n      let mut i = 0\n      while i < Array::length(sources) {\n        Fs::write_file(String::concat(output_path, String::concat(\".\", String::concat(__to_string(i), \".src\"))), Array::get(sources, i))\n        i = i + 1\n      }\n      // The manifest is written LAST, same commit-marker discipline as the\n      // job dir's outcome.txt: a driver that sees it knows every .src it\n      // names is already complete.\n      Fs::write_file(output_path, manifest)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  if Env::get(\"VIBE_CHECK_ONLY\") == \"1\" {\n    return handle {\n      let _ = check_linked_file(input_path)\n      Fs::write_file(output_path, \"ok\\n\")\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #594 Stage 3 (debug): file-mode compile resolving imports from the FS.\n  if Env::get(\"VIBE_FS_COMPILE\") == \"1\" {\n    // #cov: `vibe test/run --coverage` sets VIBE_COVERAGE=1 so the user file (and\n    // its imports) is compiled with function/branch hit instrumentation; running\n    // the produced wasm fills the bitmap that the runner reads via VIBE_COV_OUT.\n    return handle {\n      // debugger trace (DAP P1 groundwork): `vibe run --trace` sets VIBE_DEBUG=1\n      // so the user file (and its imports) is compiled with function-call\n      // execution-trace instrumentation; running the produced wasm fills the\n      // in-memory trace log that the runner dumps via VIBE_TRACE_OUT.\n      // The special compile MODES (coverage / debugger break / trace) are\n      // checked first; they are mutually exclusive instrumentation builds and\n      // are unaffected by the RC cutover. The normal compile then defaults to\n      // the Perceus RC backend (#493 cutover, #705 parity) unless VIBE_RC=0\n      // selects the legacy bump path (which carries the #634 testmeta variant).\n      let bytes = if Env::get(\"VIBE_COVERAGE\") == \"1\" {\n        compile_file_fs_mode_coverage(input_path, entry_name)\n      } else if Env::get(\"VIBE_DEBUG_BREAK\") == \"1\" {\n        // debugger breakpoint (DAP P1): `vibe run --break` sets VIBE_DEBUG_BREAK=1\n        // so the user file is compiled with `vibe::dbg_break` host-hook calls at\n        // each user function entry; the runner pauses on the named breakpoints.\n        compile_file_fs_mode_break(input_path, entry_name)\n      } else if Env::get(\"VIBE_DEBUG\") == \"1\" {\n        compile_file_fs_mode_trace(input_path, entry_name)\n      } else if Env::get(\"VIBE_RC\") == \"shadow\" {\n        // #715/#768: shadow-liveness double-free traps for import-resolving\n        // builds (previously only the single-source path honored \"shadow\";\n        // this path silently compiled plain RC).\n        compile_file_fs_mode_rc_shadow(input_path, entry_name)\n      } else if Env::get(\"VIBE_RC\") != \"0\" {\n        // ADR-0055 #493 cutover DEFAULT: RC reclaims memory each iteration; the\n        // legacy bump path leaks until exit. Opt back into bump with VIBE_RC=0.\n        compile_file_fs_mode_rc(input_path, entry_name)\n      } else {\n        // Legacy bump path (VIBE_RC=0). #634 (ADR-0026): only when `vibe test`\n        // requests the pure-test cache verdict (VIBE_TESTMETA_OUT set) do we\n        // route through the variant that ALSO emits the `.testmeta` sidecar\n        // (riding the merged stmts this compile already builds — no extra\n        // parse). Env is read here (this layer has it), keeping the file_compile\n        // layer Env-free.\n        let testmeta_out = Env::get(\"VIBE_TESTMETA_OUT\")\n        if testmeta_out != \"\" {\n          compile_file_fs_mode_testmeta(input_path, entry_name, \"no-dce\", testmeta_out)\n        } else {\n          compile_file_fs_mode(input_path, entry_name, \"no-dce\")\n        }\n      }\n      // Binary-size (#1100): release executables ship without the name\n      // section / module-linking exports. Instrumented builds (coverage /\n      // trace / break / rc-shadow) are debug artifacts whose tooling reads\n      // both, so they stay untouched; so do `__no_entry__` test/bench builds\n      // (gated inside strip_executable_wasm_env).\n      let fs_instrumented = Env::get(\"VIBE_COVERAGE\") == \"1\" || Env::get(\"VIBE_DEBUG_BREAK\") == \"1\" || Env::get(\"VIBE_DEBUG\") == \"1\" || Env::get(\"VIBE_RC\") == \"shadow\"\n      let out_bytes = if fs_instrumented {\n        bytes\n      } else {\n        strip_executable_wasm_env(bytes, entry_name)\n      }\n      Fs::write_bytes(output_path, out_bytes)\n      // Best-effort `.funcmap` sidecar (entry-file top-level funcs -> line). A\n      // failure to build/write it must NOT fail the compile (the wasm is already\n      // written), so swallow any Error::Throw here. The discarded result is bound\n      // so the call is not DCE'd as a dead Unit side-effect.\n      let _funcmap_rc = handle {\n        write_funcmap_sidecar(input_path, output_path)\n      } with Error {\n        Throw(_) => 0\n      }\n      // #819 (Codex review, PR #1214): entry-function cacheability sidecar\n      // for scripts/vibe_md.vibex's doctest execute-cache -- same\n      // best-effort shape as the funcmap sidecar just above (a failure here\n      // must not fail an otherwise-successful compile). Written only when\n      // requested, so unrelated compiles (vibe test/run/build without this\n      // env var) pay no extra parse.\n      let entry_testmeta_out = Env::get(\"VIBE_ENTRY_TESTMETA_OUT\")\n      let _entry_meta_rc = if entry_testmeta_out != \"\" {\n        handle {\n          let cacheable = entry_cacheable_for_fs(input_path, entry_name)\n          Fs::write_file(entry_testmeta_out, if cacheable {\n            \"1\"\n          } else {\n            \"0\"\n          })\n          0\n        } with Error {\n          Throw(_) => 0\n        }\n      } else {\n        0\n      }\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n  // #594 `vibe normalize`: canonicalize a source file (module flatten + DCE +\n  // section layout) and write the result. Same (input, output) interface.\n  if Env::get(\"VIBE_NORMALIZE\") == \"1\" {\n    let normalized = normalize_source(Fs::read_file(input_path))\n    Fs::write_bytes(output_path, adapter_string_to_bytes(normalized))\n    return 0\n  }\n  // `vibe test --update` (#1061 follow-up, #1235 review): patch a failing\n  // inspect() call's stale `content` literal to the actual value diagnosed\n  // by a prior run of the SAME test file. VIBE_INSPECT_UPDATE_STDOUT names\n  // the file holding that prior run's captured stdout (println's mismatch\n  // diagnostic, \"inspect mismatch:\\n  actual: ...\\n  expected: ...\"). Writes\n  // the ORIGINAL source back unchanged when no recognizable mismatch\n  // matches an actual inspect(...) call's content argument -- the caller\n  // (runtime/vibe's `test --update` loop) detects \"nothing to do\" by\n  // comparing output_path against input_path, same as VIBE_NORMALIZE's\n  // --check above.\n  if Env::get(\"VIBE_INSPECT_UPDATE\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let captured = Fs::read_file(Env::get(\"VIBE_INSPECT_UPDATE_STDOUT\"))\n    let patched = match compute_updated_source(src, captured) {\n      Some(new_src) => new_src,\n      None => src\n    }\n    Fs::write_bytes(output_path, adapter_string_to_bytes(patched))\n    return 0\n  }\n  // `vibe type-at`: typed hover (first LSP consumer of real EIdent offsets).\n  // VIBE_TYPE_LINE/COL are 1-based (matching offset_to_line_col). Writes the\n  // inferred type string of the identifier at that position, or empty when there\n  // is no env-visible ident there (see type_at.vibe LIMITATION note).\n  if Env::get(\"VIBE_TYPE_AT\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let line = parse_int_or(Env::get(\"VIBE_TYPE_LINE\"), 1)\n    let col = parse_int_or(Env::get(\"VIBE_TYPE_COL\"), 1)\n    let ty = type_at_source(src, line, col)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(ty))\n    return 0\n  }\n  // `vibe doc-at`: Rust-`///`-style doc comment lookup (#854), same\n  // VIBE_TYPE_LINE/COL 1-based position convention as VIBE_TYPE_AT. Writes the\n  // `///` doc text attached to the identifier's declaration, or empty when\n  // there is none (see doc_at.vibe LIMITATION: single-file scope, same as\n  // type_at_source/binding_occurrences).\n  if Env::get(\"VIBE_DOC_AT\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let line = parse_int_or(Env::get(\"VIBE_TYPE_LINE\"), 1)\n    let col = parse_int_or(Env::get(\"VIBE_TYPE_COL\"), 1)\n    let doc = doc_at_source(src, line, col)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(doc))\n    return 0\n  }\n  // `vibe binding-at`: AST-accurate binding occurrences (scope-precision rename /\n  // references groundwork). VIBE_TYPE_LINE/COL are 1-based. Writes one `START END`\n  // line per source span of the identifier under the cursor, or empty when there\n  // is no identifier there (see binding_at.vibe LIMITATION: name-based, no\n  // shadowing analysis yet).\n  if Env::get(\"VIBE_BINDING_AT\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let line = parse_int_or(Env::get(\"VIBE_TYPE_LINE\"), 1)\n    let col = parse_int_or(Env::get(\"VIBE_TYPE_COL\"), 1)\n    let occ = binding_occurrences(src, line, col)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(join_binding_occurrences(occ)))\n    return 0\n  }\n  // `vibe symbols`: AST-accurate declaration outline. Writes one\n  // `NAME KIND START END` line per declared symbol (KIND = LSP SymbolKind int,\n  // START/END = char offsets of the name), or empty when the file declares none.\n  // Powers document-outline / go-to-definition without a text-regex scan.\n  //\n  // #946: `symbol_spans` throws (e.g. a lexer error on an unsupported\n  // character) was never caught here, so a genuine crash and \"file declares\n  // no symbols\" both produced the exact same empty `output_path` — the CLI\n  // launcher had no way to tell an editor \"the outline failed\" from \"there's\n  // nothing to show\". Route a thrown Error to the same `.diag` sidecar\n  // convention as VIBE_CHECK_ONLY below: `output_path` itself (the outline\n  // wire format LSP clients parse) is untouched on failure, so this can't\n  // emit a \"plausible but wrong\" symbol list.\n  if Env::get(\"VIBE_SYMBOLS\") == \"1\" {\n    return handle {\n      let src = Fs::read_file(input_path)\n      let syms = symbol_spans(src)\n      Fs::write_bytes(output_path, adapter_string_to_bytes(join_symbol_spans(syms)))\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n  // `vibe diagnostics`: collect ALL syntax errors (recovering parser) or the\n  // single located type error, one per line. A report, not a failure — always\n  // returns 0 (empty output means clean).\n  // #820 sub-item 1: `VIBE_DIAGNOSTICS_JSON=1` (`vibe diagnostics --json`)\n  // emits the same diagnostics as a JSON array instead, reusing the LSP\n  // server's existing \"line L:C: message\" -> Diagnostic parser\n  // (lsp_diagnostics_json_string) so there is exactly one structured\n  // diagnostic shape shared by the editor protocol and the CLI.\n  if Env::get(\"VIBE_DIAGNOSTICS\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    if Env::get(\"VIBE_DIAGNOSTICS_JSON\") == \"1\" {\n      Fs::write_bytes(output_path, adapter_string_to_bytes(lsp_diagnostics_json_string(src)))\n    } else {\n      let diags = collect_all_diagnostics(src)\n      Fs::write_bytes(output_path, adapter_string_to_bytes(join_lines(diags)))\n    }\n    return 0\n  }\n  // #726: emit the MERGED whole program as source text. `input_path` is an\n  // entry file whose imports resolve from the FS; the output is the flat\n  // source produced by the real merge machinery (export-rename plan +\n  // private namespacing), replacing the Python flattener in\n  // scripts/generate_bundle.sh. The flatten step compiles the\n  // COMMITTED flat module source with the seed (the same robust single-file\n  // lane as stage1) and runs this mode on it — the previous standalone-tool\n  // approach FS-compiled the whole 200-file graph with the seed, which hits\n  // a deterministic cold-cache OOB inside the FIXED seed binary\n  // (build_persistent_sources_cache_text; unreachable in this lane).\n  // Adding this adapter -> merge_sources import edge is safe now that the\n  // committed bundle is itself merge-built (zero duplicate defs, no\n  // first-match roulette to reshuffle).\n  if Env::get(\"VIBE_EMIT_MERGED_SOURCE\") == \"1\" {\n    return handle {\n      let merged_src = merged_program_source_fs(input_path)\n      Fs::write_file(output_path, merged_src)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n  // #537 `vibe compile --wit`: emit the WIT world for the file's effect\n  // surface (exported functions -> world exports; their `with { E }` rows ->\n  // world imports). Same (input, output) interface; imports resolved from FS.\n  // Contract: docs/effect-wit-mapping.md.\n  if Env::get(\"VIBE_EMIT_WIT\") == \"1\" {\n    return adapter_emit_wit(input_path, output_path)\n  }\n  // #537 `vibe serve` artifact step: validate the wasi-http P3 handler\n  // contract, compile the file, and wrap it into a component exporting\n  //   handler: func(method, url, headers, body: string) -> string\n  // The runner layer (runtime/vibe serve / scripts) composes the result with\n  // the P3 HTTP adapter and launches `wasmtime serve` — artifact generation\n  // stays in the compiler, serving stays in the runner.\n  if Env::get(\"VIBE_SERVE_COMPONENT\") == \"1\" {\n    return adapter_serve_component(input_path, output_path)\n  }\n  let source = Fs::read_file(input_path)\n  profile_memory_mark(mark_memory)\n  // #594 Stage 1b: emit-module-source mode. VIBE_EMIT_MODULE_SOURCE=1 reuses the\n  // same (input, output, entry) interface but, instead of compiling, writes the\n  // flat module source for `entry_name` (DCE from the entry, surviving statements\n  // emitted as their original source text). This is the replacement for\n  // the MoonBit host `emit-module-source`, so the flat-source step needs no host.\n  if Env::get(\"VIBE_EMIT_MODULE_SOURCE\") == \"1\" {\n    let module_source = build_module_source_from_source(source, entry_name)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(module_source))\n    profile_memory_mark(mark_memory)\n    0\n  } else {\n    // ADR-0055 #493 cutover toggle: VIBE_RC=1 compiles on the Perceus RC codegen\n    // path (Env::get returns \"\" when unset, so default stays the bump path). Lets\n    // the selfbuild/bootstrap/e2e gates exercise the whole compiler under RC.\n    handle {\n      let rc_flag = Env::get(\"VIBE_RC\")\n      // #cfg: activate compile-time flags from VIBE_CFG (see apply_cfg_env).\n      let source_cfg = apply_cfg_env(source, Env::get(\"VIBE_CFG\"))\n      // #cov: function-level coverage build (same source pipeline, instrumented\n      // codegen). Running the produced wasm records which compiler functions ran.\n      let bytes = if Env::get(\"VIBE_COVERAGE\") == \"1\" {\n        compile_source_wasi_only_coverage(source_cfg, entry_name)\n      } else if Env::get(\"VIBE_BACKEND\") == \"gc\" {\n        // wasm-gc backend lane (parity checks / #415). Direct source compile\n        // only; FS-import mode and the special instrumentation modes stay\n        // linear-backend-only.\n        compile_source_gc_only(source_cfg, entry_name)\n      } else {\n        compile_source_for_rc_flag(source_cfg, entry_name, rc_flag)\n      }\n      profile_memory_mark(mark_memory)\n      // Binary-size (#1100): same release strip as the FS-compile lane above.\n      // This single-source lane builds the compiler's own stage wasm\n      // (generations.sh), so the dist CLI sheds its name section and the\n      // 700+ `*_exp_lib__*` module-linking exports here. gc / coverage /\n      // rc-shadow lanes stay untouched (parity and debug tooling).\n      let ss_instrumented = Env::get(\"VIBE_COVERAGE\") == \"1\" || Env::get(\"VIBE_BACKEND\") == \"gc\" || rc_flag == \"shadow\"\n      let ss_out_bytes = if ss_instrumented {\n        bytes\n      } else {\n        strip_executable_wasm_env(bytes, entry_name)\n      }\n      Fs::write_bytes(output_path, ss_out_bytes)\n      profile_memory_mark(mark_memory)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n}\n\n/// #1137: run the production CLI via a real `fn main -> Unit` (ADR-0075's\n/// convention every other tool uses) instead of the raw `cli_main` ABI, so\n/// `runtime/vibe`'s default `_start` invocation gets a genuine process exit\n/// code -- `cli_main`'s own `Int` return would only be PRINTED by the\n/// auto-synthesized `_start` (ADR-0069), same gap `lib/@vibe/cli/main.vibex`\n/// (PR #1217) closed for the OTHER, unrelated same-named `cli_main`.\n///\n/// Deliberately declared HERE, alongside `cli_main` in this same file\n/// (cli_adapter.vibe is the merge/flatten tool's designated entry, #726's\n/// `VIBE_EMIT_MERGED_SOURCE` mode keeps only the entry file's OWN top-level\n/// exports publicly named -- everything else gets private-namespace-mangled\n/// into `*_exp_lib__*` names). A separate file that imports `cli_main` would\n/// make `cli_adapter.vibe` a mere dependency of whatever new file became the\n/// entry instead, and `cli_main` -- the self-hosting bootstrap's own\n/// `--invoke cli_main` build-tool ABI (ADR-0069) -- would be silently\n/// renamed out of existence in the flattened source. Keeping both exports in\n/// the entry file itself avoids the whole reachability-root problem: no\n/// bundle-manifest changes, no bootstrap bump, no seed-entry change needed.\n///\n/// Ordinary `export fn` form, NOT the `fn main { ... }` parser sugar:\n/// compiler source itself must stay compilable by the currently-pinned\n/// seed, and ADR-0069 notes `fn main` sugar in compiler source needs a seed\n/// bump first. `_start` synthesis (linked_compile.vibe) detects a\n/// Unit-returning entry from the plain declared return type -- sugar\n/// agnostic -- so this gets the same no-print / real-exit-code `_start`\n/// without needing the sugar or a seed bump.\nexport fn main() -> Unit with { Error, Fs, Env, Stdin, Stdout, Process } {\n  let code = cli_main()\n  if code != 0 {\n    vibe_process_exit_raw(code)\n  } else {\n    ()\n  }\n}\n")
}

