it_i64_const(b, 0)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\nexport fn gen_int_to_double_body() -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_f64_convert_i64_s(b)\n  emit_i64_reinterpret_f64(b)\n  b\n}\n\n/// #982: substring had ZERO bounds checks — the packed `(ptr+start)<<32 |\n/// (end-start)` view silently read adjacent heap for `end > len`, produced a\n/// u32-wrapped length ~4294967294 for `end < start` (i64_extend_i32_u on the\n/// negative difference), and read BEFORE the string for a negative `start`.\n/// Clamp start into [0, len] and end into [start', len] up front (the same\n/// tolerate-not-trap choice as Array::slice below), so every downstream packed\n/// view stays inside the source string and `end < start` yields \"\". Locals:\n/// 3/4 = existing i32 scratch, 5 = NEW i64 scratch holding len (meta bumped\n/// 2/0 -> 2/1 at the linked_compile push_builtin site).\nexport fn gen_str_substring_body(enable_rc: Bool) -> Bytes {\n  let b = bytebuf_new()\n  // local5 = len (i64, untagged): the packed string's low 32 bits.\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i64_extend_i32_u(b)\n  emit_local_set(b, 5)\n  // param1 (start) := retag(clamp(untag(start), 0, len))\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i64_const(b, 0)\n  emit_i64_lt_s(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 0)\n  emit_else(b)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_local_get(b, 5)\n  emit_i64_gt_s(b)\n  emit_if_i64(b)\n  emit_local_get(b, 5)\n  emit_else(b)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_end(b)\n  emit_end(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_local_set(b, 1)\n  // param2 (end) := retag(clamp(untag(end), untag(start'), len))\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\