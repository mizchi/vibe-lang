let cli_adapter_source_146 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_lambda_ctx.vibe",
"//# Imports\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtxGc\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# Functions\n\nfn make_lambda_ctx_gc(ctx: CompileCtxGc, ref_cell_names: Array[String], ref_local_indices: Array[Int]) -> CompileCtxGc {\n  CompileCtxGc::{\n    func_table: ctx.func_table, str_table: ctx.str_table,\n    lambda_table: ctx.lambda_table,\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\n    ref_cell_names: ref_cell_names, ref_local_indices: ref_local_indices,\n    refcell_type_idx: ctx.refcell_type_idx, closure_type_base: ctx.closure_type_base,\n    gc_ctor_table: ctx.gc_ctor_table,\n    gc_const_names: ctx.gc_const_names, gc_const_kinds: ctx.gc_const_kinds,\n    gc_const_ivals: ctx.gc_const_ivals, gc_const_svals: ctx.gc_const_svals,\n    gc_global_names: ctx.gc_global_names,\n    // Fresh per lambda: float/bool tracking is scope-local (captured\n    // floats/bools are not tracked — best-effort, same as annotated\n    // Double/Bool params, seeded separately after this call returns).\n    gc_float_locals: array_empty(),\n    gc_bool_locals: array_empty(),\n    // #1015: computed once per compile, never per-scope -- pass through\n    // unchanged (see the doc comment on CompileCtxGc.gc_to_string_is_show_wrapper).\n    gc_to_string_is_show_wrapper: ctx.gc_to_string_is_show_wrapper,\n    gc_agg_local_slots: array_empty(),\n    gc_agg_ret_names: ctx.gc_agg_ret_names,\n    gc_agg_ret_infos: ctx.gc_agg_ret_infos\n  }\n}\n\n//# Misc\n\nexport {\n  make_lambda_ctx_gc\n}\n")
}

let cli_adapter_source_147 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/gc/backend_lambda_emit.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  bytebuf_new\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  emit_i64_extend_i32_u\n}\n\nimport @vibe/compiler/codegen/common_base {\n  emit_i64_store, resolve_local\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_global_get, emit_global_set, emit_heap_memory_grow_check, emit_i32_add, emit_i32_const, emit_i32_store, emit_i32_wrap_i64, emit_i64_const, emit_i64_or, emit_local_get, emit_local_tee\n}\n\n//# Functions\n\nfn emit_lambda_closure_gc(buf: Bytes, captures: Array[String], num_captures: Int, local_names: Array[String], next_local: Int, table_slot: Int) -> Int with { Error } {\n  if num_captures == 0 {\n    emit_i64_const(buf, (table_slot<<2)|2)\n    next_local\n  } else {\n    let alloc_size = 8 + num_captures * 8\n    let ptr_local = next_local\n    let nl2 = next_local + 1\n    Array::push(local_names, \"__closure_ptr\")\n    emit_global_get(buf, 0)\n    emit_i64_extend_i32_u(buf)\n    emit_local_tee(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, alloc_size)\n    emit_i32_add(buf)\n    emit_global_set(buf, 0)\n    // #415: gc-lane heap bump must grow linear memory like the linear\n    // backend does -- without this any allocation past the initial page\n    // traps OOB (the gc smoke fixture only ever allocated a few bytes).\n    emit_heap_memory_grow_check(buf)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, table_slot)\n    emit_i32_store(buf, 2, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, num_captures)\n    emit_i32_store(buf, 2, 4)\n    let mut csi = 0\n    while csi < num_captures {\n      let cap_name = Array::get(captures, csi)\n      let cap_idx = resolve_local(local_names, cap_name, \"gc_cap\")\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, cap_idx)\n      emit_i64_store(buf, 3, 8 + csi * 8)\n      csi = csi + 1\n    }\n    emit_local_get(buf, ptr_local)\n    emit_i64_const(buf, 1)\n    emit_i64_or(buf)\n    nl2\n  }\n}\n\n//# Misc\n\nexport {\n  emit_lambda_closure_gc\n}\n")
}

