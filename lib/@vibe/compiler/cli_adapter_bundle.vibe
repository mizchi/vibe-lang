)\n  emit_local_get(b, key_l)\n  emit_call(b, hash_fn_idx)\n  emit_local_set(b, h_l)\n  emit_local_get(b, h_l)\n  emit_local_get(b, mask_l)\n  emit_i64_and(b)\n  emit_local_set(b, slot_l)\n  emit_i64_const(b, 0)\n  emit_local_set(b, i_l)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, i_l)\n  emit_local_get(b, mask_l)\n  emit_i64_gt_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, idxptr_l)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 8)\n  emit_i32_add(b)\n  emit_local_get(b, slot_l)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 8)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_local_set(b, addr_l)\n  emit_local_get(b, addr_l)\n  emit_i32_load(b, 2, 4)\n  emit_i64_extend_i32_s(b)\n  emit_local_set(b, cur_entry_l)\n  emit_local_get(b, cur_entry_l)\n  emit_i64_const(b, -1)\n  emit_i64_eq(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, addr_l)\n  emit_i32_load(b, 2, 0)\n  emit_i64_extend_i32_u(b)\n  emit_local_set(b, cur_psl_l)\n  emit_local_get(b, i_l)\n  emit_local_get(b, cur_psl_l)\n  emit_i64_gt_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, base_l)\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, cur_entry_l)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 16)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_i64_load(b, 3, 8)\n  emit_local_set(b, cand_key_l)\n  emit_local_get(b, cand_key_l)\n  emit_local_get(b, key_l)\n  emit_call(b, eq_fn_idx)\n  emit_i32_wrap_i64(b)\n  emit_if_void(b)\n  emit_local_get(b, cur_entry_l)\n  emit_return(b)\n  emit_end(b)\n  emit_local_get(b, i_l)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_set(b, i_l)\n  emit_local_get(b, slot_l)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_get(b, mask_l)\n  emit_i64_and(b)\n  emit_local_set(b, slot_l)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_i64_const(b, -1)\n  b\n}\n")
