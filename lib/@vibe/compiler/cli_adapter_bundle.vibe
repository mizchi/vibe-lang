ock_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_heap_memory_grow_check, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\nexport fn gen_arr_push_body(enable_rc: Bool, rc_alloc_idx: Int, rc_shadow: Bool) -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  // ADR-0055 Stage 2b: array value is an odd pointer; untag once at the top\n  // (everything downstream uses local 2 = the wrapped address).\n  if enable_rc {\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 0)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 4)\n  emit_local_set(b, 4)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 5)\n  emit_local_get(b, 4)\n  emit_local_get(b, 3)\n  emit_i32_ge_u(b)\n  emit_if_void(b)\n  // newcap = cap * 2 (local 7)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 2)\n  emit_i32_mul(b)\n  emit_local_set(b, 7)\n  if enable_rc {\n    // ADR-0055 Stage 4: allocate the grown buffer as a HEADERED, reusable block\n    // ([alloc_size@block+0], data_ptr = block+8) via vibe_rc_alloc, so it can be\n    // freed/reused like any block. A raw-bump buffer has no header and leaks both\n    // on every regrow and when the array is dropped.\n    // block_start (local 6) = wrap(vibe_rc_alloc(newcap*8 + 8))\n    emit_local_get(b, 7)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i64_extend_i32_u(b)\n    emit_call(b, rc_alloc_idx)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 6)\n    // alloc_size header at block_start+0 (= newcap*8 + 8)\n    emit_local_get(b, 6)\n    emit_local_get(b, 7)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 0)\n    // copy old elements into the new buffer's data area (block_start+8)\n    emit_local_get(b, 6)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_local_get(b, 5)\n    emit_local_get(b, 4)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_memory_copy(b)\n    // free the OLD buffer if it was a separate (grown) block, i.e. data_ptr\n    // (local 5) != value+12 (the inline buffer at vptr+12). Push its value\n    // pointer onto the free-list head (size@-8, next@-4 are already in place).\n    emit_local_get(b, 5)\n    emit_local_get(b, 2)\n    emit_i32_const(b, 12)\n    emit_i32_add(b)\n    emit_i32_ne(b)\n    emit_if_void(b)\n    // #715 recurrence guard (VIBE_RC=shadow): double-free check for the\n    // grown buffer -- a second free-list push of the same buffer makes two\n    // later allocations return overlapping memory (type confusion), which\n    // plain marking cannot catch. Works under quarantine too (marks are\n    // permanent).\n    if rc_shadow {\n      emit_local_get(b, 5)\n      emit_i32_const(b, rc_shadow_base())\n      emit_i32_add(b)\n      emit_i32_load8_u(b, 0, 0)\n      emit_if_void(b)\n      bytebuf_push(b, 0)\n      emit_end(b)\n    } else {\n      ()\n    }\n    // #715 recurrence guard (VIBE_RC=shadow): mark the old grown buffer freed.\n    if rc_shadow {\n      emit_local_get(b, 5)\n      emit_i32_const(b, rc_shadow_base())\n      emit_i32_add(b)\n      emit_i32_const(b, 1)\n      emit_i32_store8(b, 0, 0)\n    } else {\n      ()\n    }\n    emit_local_get(b, 5)\n    emit_i32_const(b, 4)\n    emit_i32_sub(b)\n    emit_global_get(b, 2)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 5)\n    emit_global_set(b, 2)\n    emit_end(b)\n    // capacity = newcap; data_ptr = block_start+8; local5 = block_start+8\n    emit_local_get(b, 2)\n    emit_local_get(b, 7)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 2)\n    emit_local_get(b, 6)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 8)\n    emit_local_get(b, 6)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_local_set(b, 5)\n  } else {\n    // non-RC: raw-bump a headerless buffer (never freed — the default path does\n    // not reclaim).\n    emit_global_get(b, 0)\n    emit_local_tee(b, 6)\n    emit_local_get(b, 7)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_i32_add(b)\n    emit_global_set(b, 0)\n    emit_heap_memory_grow_check(b)\n    emit_local_get(b, 6)\n    emit_local_get(b, 5)\n    emit_local_get(b, 4)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_memory_copy(b)\n    emit_local_get(b, 2)\n    emit_local_get(b, 7)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 2)\n    emit_local_get(b, 6)\n    emit_i32_store(b, 2, 8)\n    emit_local_get(b, 6)\n    emit_local_set(b, 5)\n  }\n  emit_end(b)\n  emit_local_get(b, 5)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)\n  emit_i32_add(b)\n  emit_local_get(b, 1)\n  emit_i64_store(b, 3, 0)\n  emit_local_get(b, 2)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 4)\n  b\n}\n")
