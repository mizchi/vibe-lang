_local_get(b, 4)\n  emit_local_get(b, 3)\n  emit_i32_add(b)\n  emit_i64_extend_i32_u(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, str_substring_idx)\n  emit_local_set(b, 5)\n  emit_local_get(b, 5)\n  emit_local_get(b, 1)\n  emit_call(b, str_eq_idx)\n  emit_i32_wrap_i64(b)\n  emit_if_void(b)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_br(b, 3)\n  emit_end(b)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_sub(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_i64_const(b, -1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\nexport fn gen_sources_stub_body(arr_new_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_call(b, arr_new_idx)\n  b\n}\n\nlet static_arr_push_all_body_bytes = Bytes::from_array([\n  32,\n  0,\n  167,\n  33,\n  2,\n  32,\n  1,\n  167,\n  33,\n  3,\n  32,\n  2,\n  40,\n  2,\n  4,\n  33,\n  4,\n  32,\n  3,\n  40,\n  2,\n  4,\n  33,\n  5,\n  32,\n  2,\n  40,\n  2,\n  8,\n  33,\n  6,\n  32,\n  3,\n  40,\n  2,\n  8,\n  33,\n  7,\n  32,\n  2,\n  40,\n  2,\n  0,\n  33,\n  8,\n  32,\n  4,\n  32,\n  5,\n  106,\n  32,\n  8,\n  75,\n  4,\n  64,\n  32,\n  4,\n  32,\n  5,\n  106,\n  65,\n  2,\n  108,\n  33,\n  9,\n  35,\n  0,\n  34,\n  10,\n  32,\n  9,\n  65,\n  8,\n  108,\n  106,\n  36,\n  0,\n  32,\n  10,\n  32,\n  6,\n  32,\n  4,\n  65,\n  8,\n  108,\n  252,\n  10,\n  0,\n  0,\n  32,\n  2,\n  32,\n  9,\n  54,\n  2,\n  0,\n  32,\n  2,\n  32,\n  10,\n  54,\n  2,\n  8,\n  32,\n  10,\n  33,\n  6,\n  11,\n  32,\n  6,\n  32,\n  4,\n  65,\n  3,\n  116,\n  106,\n  32,\n  7,\n  32,\n  5,\n  65,\n  3,\n  116,\n  252,\n  10,\n  0,\n  0,\n  32,\n  2,\n  32,\n  4,\n  32,\n  5,\n  106,\n  54,\n  2,\n  4\n])\n\nexport fn static_arr_push_all_body() -> Bytes {\n  static_arr_push_all_body_bytes\n}\n\nlet static_arr_truncate_body_bytes = Bytes::from_array([\n  32,\n  0,\n  167,\n  32,\n  1,\n  167,\n  54,\n  2,\n  4\n])\n\nexport fn static_arr_truncate_body() -> Bytes {\n  static_arr_truncate_body_bytes\n}\n\n/// #997: this used to be a precomputed constant (`local.get 0; f64.reinterpret_i64;\n/// i64.trunc_f64_s`, byte-for-byte identical to the pre-fix `gen_double_to_int_body`)\n/// -- now that the body needs to guard against the NaN/out-of-range trap, it\n/// delegates to `gen_double_to_int_body` instead of hand-encoding the longer\n/// branchy byte sequence twice.\nexport fn static_double_to_int_body() -> Bytes {\n  gen_double_to_int_body()\n}\n\nlet static_int_to_double_body_bytes = Bytes::from_array([\n  32,\n  0,\n  185,\n  189\n])\n\nexport fn static_int_to_double_body() -> Bytes {\n  static_int_to_double_body_bytes\n}\n\nlet static_str_substring_body_bytes = Bytes::from_array([\n  32,\n  0,\n  66,\n  32,\n  135,\n  167,\n  33,\n  3,\n  32,\n  2,\n  32,\n  1,\n  125,\n  167,\n  33,\n  4,\n  32,\n  3,\n  32,\n  1,\n  167,\n  106,\n  173,\n  66,\n  32,\n  134,\n  32,\n  4,\n  173,\n  132\n])\n\nexport fn static_str_substring_body() -> Bytes {\n  static_str_substring_body_bytes\n}\n\nexport fn gen_sources_proper_body(num_sources: Int, str_offsets: Array[Int], str_lengths: Array[Int], src_str_base: Int, arr_new_idx: Int, arr_push_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_call(b, arr_new_idx)\n  emit_local_set(b, 1)\n  let mut si = 0\n  while si < num_sources {\n    let path_idx = src_str_base + si * 2\n    let content_idx = src_str_base + si * 2 + 1\n    let path_off = Array::get(str_offsets, path_idx)\n    let path_len = Array::get(str_lengths, path_idx)\n    let content_off = Array::get(str_offsets, content_idx)\n    let content_len = Array::get(str_lengths, content_idx)\n    emit_global_get(b, 0)\n    emit_local_tee(b, 0)\n    emit_i32_const(b, 16)\n    emit_i32_add(b)\n    emit_global_set(b, 0)\n    emit_heap_memory_grow_check(b)\n    emit_local_get(b, 0)\n    let path_ref = (path_off<<32)|path_len\n    emit_i64_const(b, path_ref)\n    emit_i64_store(b, 3, 0)\n    emit_local_get(b, 0)\n    let content_ref = (content_off<<32)|content_len\n    emit_i64_const(b, content_ref)\n    emit_i64_store(b, 3, 8)\n    emit_local_get(b, 1)\n    emit_local_get(b, 0)\n    emit_i64_extend_i32_u(b)\n    emit_call(b, arr_push_idx)\n    si = si + 1\n  }\n  emit_local_get(b, 1)\n  b\n}\n\nlet static_str_char_code_at_body_bytes = Bytes::from_array([\n  // #811 bounds-check prefix: local.get 1; i32.wrap; local.get 0; i32.wrap\n  // (low word = length); i32.ge_u; if; unreachable; end\n  32,\n  1,\n  167,\n  32,\n  0,\n  167,\n  79,\n  4,\n  64,\n  0,\n  11,\n  32,\n  0,\n  66,\n  32,\n  135,\n  167,\n  33,\n  2,\n  32,\n  2,\n  32,\n  1,\n  167,\n  106,\n  45,\n  0,\n  0,\n  173\n])\n\nexport fn static_str_char_code_at_body() -> Bytes {\n  static_str_char_code_at_body_bytes\n}\n\nlet static_str_from_char_code_body_bytes = Bytes::from_array([\n  35,\n  0,\n  34,\n  1,\n  65,\n  1,\n  106,\n  36,\n  0,\n  32,\n  1,\n  32,\n  0,\n  167,\n  58,\n  0,\n  0,\n  32,\n  1,\n  173,\n  66,\n  32,\n  134,\n  66,\n  1,\n  132\n])\n\nexport fn static_str_from_char_code_body() -> Bytes {\n  static_str_from_char_code_body_bytes\n}\n\nlet static_fs_write_bytes_stub_body_bytes = Bytes::new()\n\nexport fn static_fs_write_bytes_stub_body() -> Bytes {\n  static_fs_write_bytes_stub_body_bytes\n}\n\n//# Map hash index (O(1)-average Map::get/has_key)\n//\n// Map[K,V] keys are always String (checker/builtins_map.vibe hardcodes\n// CtString for every Map:: op's key param). The existing Map runtime layout\n// ([count:i32 @0][{key:i64,value:i64} entries @8...], insertion order) is\n// unchanged -- Map::keys/values must keep insertion order (json_stringify.vibe\n// depends on it for stable key order). This adds a side hash index, built\n// fresh whenever the entries array is finalized (Map::set/delete,\n// MapBuilder::freeze already do an O(n) copy for persistence, so building an\n// index alongside costs no new asymptotic complexity on writes) and consulted\n// by Map::get/has_key for O(1)-average lookups instead of the O(n) scan.\n// Open addressing + Robin Hood displacement, modeled directly on\n// moonbitlang/core's hashmap.mbt (the user's own reference: PSL-tracked\n// entries, early-exit on `probe_distance > entry.psl`, grow-free here since\n// capacity is sized upfront from the final count). Index slots are 8 bytes:\n// [psl:i32 @0][entry_idx:i32 @4], entry_idx==-1 = empty. Stored at the Map's\n// header offset+4 (confirmed always-zero padding on every existing Map --\n// nothing reads/writes it today), so index_ptr==0 unambiguously means \"no\n// index\" and callers fall back to the untouched linear scan.\n//\n// Hash: an xxHash32-style accumulator, same algorithm as moonbitlang/core's\n// builtin/hasher.mbt (GPRIME1..5, consume4/consume1, avalanche finalize) --\n// vibe strings are raw bytes (gen_str_char_code_at_body loads i32.load8_u),\n// so this processes the string's bytes directly (moonbit's `combine_bytes`\n// shape) rather than per-codepoint. The accumulator is kept masked to 32\n// bits (always non-negative as an i64), so `i64.shr_s` is safe to use in\n// place of a native unsigned shift throughout.\n\n/// acc := (acc + val*prime) & 0xFFFFFFFF, stored back into local `acc_l`.\nfn mh_add_mul(b: Bytes, acc_l: Int, val_l: Int, prime: Int) -> Unit {\n  emit_local_get(b, acc_l)\n  emit_local_get(b, val_l)\n  emit_i64_const(b, prime)\n  emit_i64_mul(b)\n  emit_i64_add(b)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_local_set(b, acc_l)\n}\n\n/// acc := rotl32(acc, r) & 0xFFFFFFFF, stored back into local `acc_l`.\nfn mh_rotl(b: Bytes, acc_l: Int, r: Int) -> Unit {\n  emit_local_get(b, acc_l)\n  emit_i64_const(b, r)\n  emit_i64_shl(b)\n  emit_local_get(b, acc_l)\n  emit_i64_const(b, 32 - r)\n  emit_i64_shr_s(b)\n  emit_i64_or(b)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_local_set(b, acc_l)\n}\n\n/// acc := (acc * prime) & 0xFFFFFFFF, stored back into local `acc_l`.\nfn mh_mul_prime(b: Bytes, acc_l: Int, prime: Int) -> Unit {\n  emit_local_get(b, acc_l)\n  emit_i64_const(b, prime)\n  emit_i64_mul(b)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_local_set(b, acc_l)\n}\n\n/// acc := (acc ^ (acc >>> r)) & 0xFFFFFFFF, stored back into local `acc_l`.\nfn mh_xor_shr(b: Bytes, acc_l: Int, r: Int) -> Unit {\n  emit_local_get(b, acc_l)\n  emit_local_get(b, acc_l)\n  emit_i64_const(b, r)\n  emit_i64_shr_s(b)\n  emit_i64_xor(b)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_local_set(b, acc_l)\n}\n\n/// __rt_map_hash(s: String) -> Int  [type 3: (i64) -> i64]\n/// local0 = s (param). Extra i32: local1=base_ptr, local2=len, local3=cur.\n/// Extra i64: local4=acc, local5=chunk/byte scratch. meta=(3,2).\nexport fn gen_map_hash_body() -> Bytes {\n  let b = bytebuf_new()\n  let base_l = 1\n  let len_l = 2\n  let cur_l = 3\n  let acc_l = 4\n  let val_l = 5\n  // base_ptr = high32(s), len = low32(s) -- same unpack as gen_str_len_body /\n  // gen_str_char_code_at_body.\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, base_l)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, len_l)\n  emit_i32_const(b, 0)\n  emit_local_set(b, cur_l)\n  emit_i64_const(b, 0x165667B1)\n  emit_local_set(b, acc_l)\n  // 4-byte chunk loop: while cur+4 <= len\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, cur_l)\n  emit_i32_const(b, 4)\n  emit_i32_add(b)\n  emit_local_get(b, len_l)\n  emit_i32_gt_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, base_l)\n  emit_local_get(b, cur_l)\n  emit_i32_add(b)\n  emit_i32_load(b, 0, 0)\n  emit_i64_extend_i32_u(b)\n  emit_local_set(b, val_l)\n  mh_add_mul(b, acc_l, val_l, 0xC2B2AE3D)\n  mh_rotl(b, acc_l, 17)\n  mh_mul_prime(b, acc_l, 0x27D4EB2F)\n  emit_local_get(b, cur_l)\n  emit_i32_const(b, 4)\n  emit_i32_add(b)\n  emit_local_set(b, cur_l)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  // remainder loop: while cur < len (one byte at a time)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, cur_l)\n  emit_local_get(b, len_l)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, base_l)\n  emit_local_get(b, cur_l)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i64_extend_i32_u(b)\n  emit_local_set(b, val_l)\n  mh_add_mul(b, acc_l, val_l, 0x165667B1)\n  mh_rotl(b, acc_l, 11)\n  mh_mul_prime(b, acc_l, 0x9E3779B1)\n  emit_local_get(b, cur_l)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, cur_l)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  // avalanche finalize\n  mh_xor_shr(b, acc_l, 15)\n  mh_mul_prime(b, acc_l, 0x85EBCA77)\n  mh_xor_shr(b, acc_l, 13)\n  mh_mul_prime(b, acc_l, 0xC2B2AE3D)\n  emit_local_get(b, acc_l)\n  emit_local_get(b, acc_l)\n  emit_i64_const(b, 16)\n  emit_i64_shr_s(b)\n  emit_i64_xor(b)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  b\n}\n\n/// __rt_map_cap_for(count: Int) -> Int  [type 3: (i64) -> i64]\n/// capacity = next_pow2(max(8, count*2)) -- keeps the index table at <=50%\n/// load factor (same policy as moonbitlang/core's default_init_capacity=8 /\n/// grow-at-half). local0 = count (param). Extra i64: local1 = working n.\nexport fn gen_map_cap_body() -> Bytes {\n  let b = bytebuf_new()\n  let n_l = 1\n  emit_local_get(b, 0)\n  emit_i64_const(b, 2)\n  emit_i64_mul(b)\n  emit_local_set(b, n_l)\n  emit_local_get(b, n_l)\n  emit_i64_const(b, 8)\n  emit_i64_lt_s(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 8)\n  emit_else(b)\n  emit_local_get(b, n_l)\n  emit_end(b)\n  emit_local_set(b, n_l)\n  emit_local_get(b, n_l)\n  emit_i64_const(b, 1)\n  emit_i64_sub(b)\n  emit_local_set(b, n_l)\n  emit_local_get(b, n_l)\n  emit_local_get(b, n_l)\n  emit_i64_const(b, 1)\n  emit_i64_shr_s(b)\n  emit_i64_or(b)\n  emit_local_set(b, n_l)\n  emit_local_get(b, n_l)\n  emit_local_get(b, n_l)\n  emit_i64_const(b, 2)\n  emit_i64_shr_s(b)\n  emit_i64_or(b)\n  emit_local_set(b, n_l)\n  emit_local_get(b, n_l)\n  emit_local_get(b, n_l)\n  emit_i64_const(b, 4)\n  emit_i64_shr_s(b)\n  emit_i64_or(b)\n  emit_local_set(b, n_l)\n  emit_local_get(b, n_l)\n  emit_local_get(b, n_l)\n  emit_i64_const(b, 8)\n  emit_i64_shr_s(b)\n  emit_i64_or(b)\n  emit_local_set(b, n_l)\n  emit_local_get(b, n_l)\n  emit_local_get(b, n_l)\n  emit_i64_const(b, 16)\n  emit_i64_shr_s(b)\n  emit_i64_or(b)\n  emit_local_set(b, n_l)\n  emit_local_get(b, n_l)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  b\n}\n\n/// __rt_map_index_insert(index_ptr, initial_slot, entry_idx) -> Unit\n/// [type 7: (i64,i64,i64) -> ()]\n/// Index table layout: [mask:i64 @+0][slots: {psl:i32,entry_idx:i32} @+8...]\n/// -- the mask lives in an 8-byte header so this (and probe, below) can take\n/// one fewer param and reuse an existing type shape instead of needing a new\n/// one. Robin Hood insertion of ONE (entry_idx, psl=0) pair, starting the\n/// probe at `initial_slot`. Displaces (and continues inserting) whichever\n/// existing entry has a smaller psl, exactly mirroring moonbitlang/core's\n/// HashMap::push_away. Always terminates via `return` (the caller sizes the\n/// table so an empty slot is always reachable within `mask+1` probes).\n/// local0=index_ptr, local1=slot, local2=entry_idx (params). Extra i32:\n/// local3=slot_addr. Extra i64: local4=mask, local5=psl, local6=cur_psl,\n/// local7=cur_entry_idx. meta=(1,4).\nexport fn gen_map_index_insert_body() -> Bytes {\n  let b = bytebuf_new()\n  let idxptr_l = 0\n  let slot_l = 1\n  let entry_l = 2\n  let addr_l = 3\n  let mask_l = 4\n  let psl_l = 5\n  let cur_psl_l = 6\n  let cur_entry_l = 7\n  emit_local_get(b, idxptr_l)\n  emit_i32_wrap_i64(b)\n  emit_i64_load(b, 3, 0)\n  emit_local_set(b, mask_l)\n  emit_i64_const(b, 0)\n  emit_local_set(b, psl_l)\n  emit_loop_void(b)\n  emit_local_get(b, idxptr_l)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 8)\n  emit_i32_add(b)\n  emit_local_get(b, slot_l)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 8)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_local_set(b, addr_l)\n  emit_local_get(b, addr_l)\n  emit_i32_load(b, 2, 4)\n  emit_i64_extend_i32_s(b)\n  emit_local_set(b, cur_entry_l)\n  emit_local_get(b, cur_entry_l)\n  emit_i64_const(b, -1)\n  emit_i64_eq(b)\n  emit_if_void(b)\n  emit_local_get(b, addr_l)\n  emit_local_get(b, psl_l)\n  emit_i32_wrap_i64(b)\n  emit_i32_store(b, 2, 0)\n  emit_local_get(b, addr_l)\n  emit_local_get(b, entry_l)\n  emit_i32_wrap_i64(b)\n  emit_i32_store(b, 2, 4)\n  emit_return(b)\n  emit_end(b)\n  emit_local_get(b, addr_l)\n  emit_i32_load(b, 2, 0)\n  emit_i64_extend_i32_u(b)\n  emit_local_set(b, cur_psl_l)\n  emit_local_get(b, psl_l)\n  emit_local_get(b, cur_psl_l)\n  emit_i64_gt_s(b)\n  emit_if_void(b)\n  emit_local_get(b, addr_l)\n  emit_local_get(b, psl_l)\n  emit_i32_wrap_i64(b)\n  emit_i32_store(b, 2, 0)\n  emit_local_get(b, addr_l)\n  emit_local_get(b, entry_l)\n  emit_i32_wrap_i64(b)\n  emit_i32_store(b, 2, 4)\n  emit_local_get(b, cur_psl_l)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_set(b, psl_l)\n  emit_local_get(b, cur_entry_l)\n  emit_local_set(b, entry_l)\n  emit_else(b)\n  emit_local_get(b, psl_l)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_set(b, psl_l)\n  emit_end(b)\n  emit_local_get(b, slot_l)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_get(b, mask_l)\n  emit_i64_and(b)\n  emit_local_set(b, slot_l)\n  emit_br(b, 0)\n  emit_end(b)\n  b\n}\n\n/// __rt_map_build_index(base, count) -> Int  [type 4: (i64,i64) -> i64]\n/// Bump-allocates a fresh (capacity*8 + 8)-byte index table: an 8-byte\n/// [mask:i64] header (see gen_map_index_insert_body's layout comment)\n/// followed by capacity 0xFF-filled slots (every slot's entry_idx reads as\n/// -1/empty). Inserts every existing entry (base+8..) into it via\n/// __rt_map_index_insert. Called after Map::set/Map::delete/\n/// MapBuilder::freeze finalize the (insertion-o