each piece (and the\n/// separator) into place — O(n). This also speeds up StringBuilder::freeze,\n/// which lowers to String::join(parts, \"\").\n///\n/// Locals (params 0=arr, 1=sep are i64): i32 group [2..10] = n, i, total,\n/// sep_len, sep_ptr, base, pos, cur_ptr, cur_len; i64 group [11] = cur. Keep\n/// meta_i32=9 / meta_i64=1 in linked_compile in sync. arr_len/arr_get use the\n/// untagged convention (matching the prior body); ptr/len are extracted exactly\n/// as gen_str_concat_body does.\nexport fn gen_string_join_body(enable_rc: Bool, arr_len_idx: Int, arr_get_idx: Int, str_concat_idx: Int) -> Bytes {\n  let _ = str_concat_idx\n  let b = bytebuf_new()\n  // n = arr_len(arr). Under RC `arr_len` returns the length TAGGED (len<<1) and\n  // `arr_get` expects the index TAGGED (#705) — this body otherwise uses the raw\n  // untagged convention, so untag the count here and tag each index below, or\n  // the loop runs 2*len times (OOB) and reads element i/2.\n  emit_local_get(b, 0)\n  emit_call(b, arr_len_idx)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  } else {\n    ()\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  // empty array -> empty string (0)\n  emit_local_get(b, 2)\n  emit_i32_eqz(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 0)\n  emit_else(b)\n  // sep_len = lo32(sep); sep_ptr = hi32(sep)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 5)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 6)\n  // pass 1: total = sum of len(arr[i])\n  emit_i32_const(b, 0)\n  emit_local_set(b, 4)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 3)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 2)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 3)\n  emit_i64_extend_i32_u(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_s