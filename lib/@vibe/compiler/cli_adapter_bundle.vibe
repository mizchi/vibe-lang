"//# Imports\n\nimport @vibe/compiler/core {\n  bytebuf_new, bytebuf_push, bytebuf_push2, bytebuf_push9, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32, bytebuf_push_opcode_u32_u32, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\n}\n\nimport ./sections.vibe {\n  emit_end, emit_i32_const\n}\n\n//# Functions\n\nlet op_br = 12\n\nlet op_if = 4\n\nlet bt_i64 = 126\n\nlet bt_void = 64\n\nexport fn emit_br(buf: Bytes, label: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_br, label)\n}\n\nlet op_call = 16\n\nlet op_drop = 26\n\nlet op_else = 5\n\nlet op_loop = 3\n\nlet op_block = 2\n\nlet op_br_if = 13\n\nexport fn emit_call(buf: Bytes, func_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_call, func_idx)\n}\n\nexport fn emit_drop(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_drop)\n}\n\nexport fn emit_else(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_else)\n}\n\nlet op_f64_eq = 97\n\nlet op_f64_ge = 102\n\nlet op_f64_gt = 100\n\nlet op_f64_le = 101\n\nlet op_f64_lt = 99\n\nlet op_f64_ne = 98\n\nlet op_i64_eq = 81\n\nlet op_i64_ne = 82\n\nlet op_i64_or = 132\n\nlet op_return = 15\n\nlet sec_table = 4\n\nexport fn emit_br_if(buf: Bytes, label: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_br_if, label)\n}\n\nlet op_f64_abs = 153\n\nlet op_f64_ceil = 155\n\nlet op_f64_floor = 156\n\nlet op_f64_add = 160\n\nlet op_f64_div = 163\n\nlet op_f64_max = 165\n\nlet op_f64_min = 164\n\nlet op_f64_mul = 162\n\nlet op_f64_neg = 154\n\nlet op_f64_sub = 161\n\nlet op_i32_add = 106\n\nlet op_i64_add = 124\n\nlet op_i64_and = 131\n\nlet op_i64_eqz = 80\n\nlet op_i64_mul = 126\n\nlet op_i64_shl = 134\n\nlet op_i64_sub = 125\n\nlet op_i64_xor = 133\n\nexport fn emit_f64_eq(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_eq)\n}\n\nexport fn emit_f64_ge(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_ge)\n}\n\nexport fn emit_f64_gt(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_gt)\n}\n\nexport fn emit_f64_le(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_le)\n}\n\nexport fn emit_f64_lt(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_lt)\n}\n\nexport fn emit_f64_ne(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_ne)\n}\n\nexport fn emit_i64_eq(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_eq)\n}\n\nexport fn emit_i64_ne(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_ne)\n}\n\nexport fn emit_i64_or(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_or)\n}\n\nexport fn emit_if_i64(buf: Bytes) -> Unit {\n  bytebuf_push2(buf, op_if, bt_i64)\n}\n\nexport fn emit_return(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_return)\n}\n\nlet op_i32_load = 40\n\nlet op_i64_ge_s = 89\n\nlet op_i64_gt_s = 85\n\nlet op_i64_le_s = 87\n\nlet op_i64_lt_s = 83\n\nlet sec_element = 9\n\nexport fn emit_f64_add(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_add)\n}\n\nexport fn emit_f64_div(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_div)\n}\n\nexport fn emit_f64_mul(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_mul)\n}\n\nexport fn emit_f64_neg(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_neg)\n}\n\nexport fn emit_f64_sub(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_sub)\n}\n\nexport fn emit_f64_abs(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_abs)\n}\n\nexport fn emit_f64_ceil(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_ceil)\n}\n\nexport fn emit_f64_floor(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_floor)\n}\n\nexport fn emit_f64_max(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_max)\n}\n\nexport fn emit_f64_min(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_f64_min)\n}\n\nexport fn emit_i32_add(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i32_add)\n}\n\nexport fn emit_i64_add(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_add)\n}\n\nexport fn emit_i64_and(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_and)\n}\n\nexport fn emit_i64_eqz(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_eqz)\n}\n\nexport fn emit_i64_mul(buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_mul)\n}