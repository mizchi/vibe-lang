let cli_adapter_source_159 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/eval_loader/eval_loader.vibe",
"//# Imports\n\nimport @vibe/compiler/syntax {\n  lex, parse, parse_program\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n//# Functions\n\nfn resolve_interp_expr(expr: Expr) -> Expr with { Error } {\n  match expr {\n    EStringInterp(parts) => {\n      let plen = Array::length(parts)\n      let exprs = ArrayBuilder::new()\n      let mut i = 0\n      while i < plen {\n        let lit = Array::get(parts, i)\n        if String::length(lit) > 0 {\n          ArrayBuilder::push(exprs, EString(lit))\n        }\n        if i + 1 < plen {\n          let expr_src = Array::get(parts, i + 1)\n          let resolved = resolve_interp_expr(parse(lex(expr_src)))\n          ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\", -1), [\n            resolved\n          ], -1))\n        }\n        i = i + 2\n      }\n      let out = ArrayBuilder::freeze(exprs)\n      let len = Array::length(out)\n      if len == 0 {\n        EString(\"\")\n      }\n      else {\n        let mut acc = Array::get(out, 0)\n        let mut j = 1\n        while j < len {\n          acc = ECall(EIdent(\"String::concat\", -1), [\n            acc,\n            Array::get(out, j)\n          ], -1)\n          j = j + 1\n        }\n        acc\n      }\n    },\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EUnit => expr,\n    EIdent(_, _) => expr,\n    ETuple(elems) => ETuple(for elem in elems {\n      resolve_interp_expr(elem)\n    }),\n    EArray(elems) => EArray(for elem in elems {\n      resolve_interp_expr(elem)\n    }),\n    ERecord(rn, fields, targs) => ERecord(rn, for field in fields {\n      let (name, value) = field; (name, resolve_interp_expr(value))\n    }, targs),\n    EMap(fields) => EMap(for field in fields {\n      let (name, value) = field; (name, resolve_interp_expr(value))\n    }),\n    EIf(cond, then_expr, else_expr) => EIf(resolve_interp_expr(cond), resolve_interp_expr(then_expr), resolve_interp_expr(else_expr)),\n    ELet(name, value, body, soff) => ELet(name, resolve_interp_expr(value), resolve_interp_expr(body), soff),\n    ELetRec(name, value, body) => ELetRec(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    ELetMut(name, value, body, soff) => ELetMut(name, resolve_interp_expr(value), resolve_interp_expr(body), soff),\n    EAssign(name, value, body) => EAssign(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    EAssignOp(name, op, value, body) => EAssignOp(name, op, resolve_interp_expr(value), resolve_interp_expr(body)),\n    ESeq(left, right) => ESeq(resolve_interp_expr(left), resolve_interp_expr(right)),\n    EMatch(scrutinee, arms) => EMatch(resolve_interp_expr(scrutinee), for arm in arms {\n      let (pat, body) = arm; (pat, resolve_interp_expr(body))\n    }),\n    EHandle(scrutinee, arms) => EHandle(resolve_interp_expr(scrutinee), for arm in arms {\n      let (pat, body) = arm; (pat, resolve_interp_expr(body))\n    }),\n    EWhile(cond, body) => EWhile(resolve_interp_expr(cond), resolve_interp_expr(body)),\n    ELoop(params, body) => ELoop(for param in params {\n      let (name, init) = param; (name, resolve_interp_expr(init))\n    }, resolve_interp_expr(body)),\n    EForIn(name, index_name, iter, body) => EForIn(name, index_name, resolve_interp_expr(iter), resolve_interp_expr(body)),\n    ECall(callee, args, off) => ECall(resolve_interp_expr(callee), for arg in args {\n      resolve_interp_expr(arg)\n    }, off),\n    EBinOp(op, left, right) => EBinOp(op, resolve_interp_expr(left), resolve_interp_expr(right)),\n    EUnaryOp(op, inner) => EUnaryOp(op, resolve_interp_expr(inner)),\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(type_params, bounds, params, ret_ty, effect, resolve_interp_expr(body)),\n    EDot(inner, field, off, fdoff) => EDot(resolve_interp_expr(inner), field, off, fdoff),\n    EReturn(inner) => EReturn(resolve_interp_expr(inner)),\n    EBreak(opt) => match opt {\n      None => expr,\n      Some(value) => EBreak(Some(resolve_interp_expr(value)))\n    },\n    EContinue(args) => EContinue(for arg in args {\n      resolve_interp_expr(arg)\n    }),\n    ELabeledArg(label, name, value) => ELabeledArg(label, name, resolve_interp_expr(value)),\n    ESpread(inner) => ESpread(resolve_interp_expr(inner))\n  }\n}\n\nfn resolve_interp_stmt(stmt: Stmt) -> Stmt with { Error } {\n  match stmt {\n    SLet(exported, is_rec, name, ty, value) => SLet(exported, is_rec, name, ty, resolve_interp_expr(value)),\n    SLetMut(name, ty, value) => SLetMut(name, ty, resolve_interp_expr(value)),\n    STest(name, body) => STest(name, resolve_interp_expr(body)),\n    SBench(name, body) => SBench(name, resolve_interp_expr(body)),\n    SExpr(expr) => SExpr(resolve_interp_expr(expr)),\n    _ => stmt\n  }\n}\n\nexport fn contains_str(arr: Array[String], target: String) -> Bool {\n  let rec go: (Int) -> Bool = (i) -> {\n    if i >= Array::length(arr) {\n      false\n    }\n    else {\n      if Array::get(arr, i) == target {\n        true\n      }\n      else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport fn source_lookup(sources: Array[(String, String)], path_key: String) -> Option[String] {\n  let rec go: (Int) -> Option[String] = (i) -> {\n    if i >= Array::length(sources) {\n      None\n    }\n    else {\n      let (p, src) = Array::get(sources, i)\n      if p == path_key {\n        Some(src)\n      }\n      else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport fn load_and_parse(source: String) -> Array[Stmt] with { Error } {\n  let tokens = lex(source)\n  for stmt in parse_program(tokens) {\n    resolve_interp_stmt(stmt)\n  }\n}\n\nexport fn collect_exports(stmts: Array[Stmt]) -> Array[String] {\n  // Out-param accumulation: each match arm pushes directly into `out`.\n  // Previously each `Array::concat(acc, [x])` allocated and copied the\n  // entire growing prefix — total O(N^2) for N exports across the file.\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(true, _, name, _, _) => Array::push(out, name),\n      SEnum(true, _, _, variants, _) => {\n        let mut j = 0\n        while j < Array::length(variants) {\n          let (cname, _) = Array::get(variants, j)\n          Array::push(out, cname)\n          j = j + 1\n        }\n      },\n      SExport(names) => {\n        let mut j = 0\n        while j < Array::length(names) {\n          Array::push(out, Array::get(names, j))\n          j = j + 1\n        }\n      },\n      SReExport(_, names) => {\n        let mut j = 0\n        while j < Array::length(names) {\n          let (name, _) = Array::get(names, j)\n          Array::push(out, name)\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n")
}

let cli_adapter_source_160 = () -> (String, String) {
  ("lib/@vibe/graph/index.vpkg",
"name = @vibe/graph\nversion = 0.0.1\ndescription =\n  #|@vibe/graph — the selfhost compiler's incremental module DB (ADR-0070\ndeps = {}\n\ngenerated_hash =\n\n// @vibe/graph — the selfhost compiler's incremental module DB (ADR-0070\n// Phase 3, #897): maps module path -> source, path -> fingerprint, path ->\n// dependency list, plus an eval counter, as one fixed-bucket hash-map-backed\n// linear value (callers must thread the returned db, not reuse a stale one\n// -- see graph.vibe's header comment). `RippleDb` is declared `opaque`: no\n// consumer (in-repo, including the compiler's own runtime/index.vibe,\n// confirmed via repo-wide grep) ever constructs or pattern-matches it\n// directly, only through ripple_new/ripple_get_*/ripple_set_source/\n// ripple_record_eval. `StrMap`/`DepsMap` (graph.vibe's internal bucket-map\n// representation, used only inside RippleDb's own variant payload) are\n// likewise never referenced outside graph.vibe -- but `check_contract`\n// still requires every exported type declared regardless of external\n// usage (same rule as fns; confirmed by a real conformance-check failure\n// when they were first left undeclared), so they're declared `opaque`\n// here too. `version` was `export let\n// version = \"0.0.1\"` directly in the old index.vibe facade -- a real\n// importable binding, not just contract metadata -- so it is preserved\n// verbatim as an implementation-file value (graph.vibe) with a matching\n// bodyless declaration here (Codex review precedent, PR #914).\n\nopaque type StrMap\nopaque type DepsMap\nopaque type RippleDb\n\nfn ripple_new() -> RippleDb\nfn ripple_set_source(db: RippleDb, path: String, source: String) -> RippleDb\nfn ripple_get_source(db: RippleDb, path: String) -> Option[String]\nfn ripple_get_fingerprint(db: RippleDb, path: String) -> Option[String]\nfn ripple_get_deps(db: RippleDb, path: String) -> Option[Array[String]]\nfn ripple_record_eval(db: RippleDb, path: String, fingerprint: String, deps: Array[String]) -> RippleDb\nfn ripple_eval_count(db: RippleDb) -> Int\n\n// #1239 step 4A: the coordinator-side upfront import-DAG pass (cycle\n// rejection + rank/topological order). Pure apart from `Error` -- dependency\n// resolution needs `Fs`, ordering does not -- so it is testable, and Lean-\n// modellable, without a filesystem. See graph.vibe for why the split matters\n// and what stays blocked on #906 step 4(D).\nfn plan_module_order(edges: Array[(String, Array[String])], root: String) -> (Array[String], Array[Int]) with { Error }\n")
}

let cli_adapter_source_161 = () -> (String, String) {
  ("lib/@vibe/graph/graph.vibe",
"//# Types\n\n// RippleDb is the selfhost compiler's incremental module DB: it maps module\n// path -> source, path -> fingerprint, and path -> dependency list.\n//\n// Previously each map was a flat association array (`Array[(String, _)]`):\n// every lookup was O(n) and every upsert rebuilt the whole array O(n), so\n// threading the DB through N modules was O(N^2) time AND allocations (matching\n// the alloc-bound compile profile from moon-pprof). This replaces them with\n// fixed-bucket hash maps: hash the path to one of NBUCKETS buckets and scan\n// only that (small) bucket. Lookup/insert are O(1) amortized, so a full\n// N-module compile is O(N).\n//\n// The maps mutate their buckets in place, so the DB is *linear*: callers must\n// use the returned db and discard the old one. The selfhost compiler always\n// threads `next_db`, so this is safe. eval_count lives in a 1-element array so\n// it is bumped without rebuilding the enum payload.\n\n//# Values\n\n//# Types\n\nexport enum StrMap {\n  StrMap(Array[Array[(String, String)]])\n}\n\nexport enum DepsMap {\n  DepsMap(Array[Array[(String, Array[String])]])\n}\n\nexport enum RippleDb {\n  RippleDb(StrMap, StrMap, DepsMap, Array[Int])\n}\n\n//# Functions\n\nfn nbuckets() -> Int {\n  256\n}\n\nfn bucket_mask() -> Int {\n  255\n}\n\n/// FNV-1a-style string hash, masked to a non-negative bucket index. NBUCKETS is\n/// a power of two so we mask with `& 255` instead of `%`. Intermediate values\n/// are kept within 30 bits so the multiply stays well under the 2^61 tag limit.\nfn hash_bucket(key: String) -> Int {\n  let len = String::length(key)\n  let rec go: (Int, Int) -> Int = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let c = String::char_code_at(key, i)\n      let mixed = (acc^c) * 16777619\n      let bounded = mixed&1073741823\n      go(i + 1, bounded)\n    }\n  }\n  let h = go(0, 2166136261&1073741823)\n  h&bucket_mask()\n}\n\nfn empty_strings() -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nfn empty_string_pairs() -> Array[(String, String)] {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nfn empty_deps_pairs() -> Array[(String, Array[String])] {\n  Array::slice([\n    (\"\", empty_strings())\n  ], 0, 0)\n}\n\n/// Build a bucket array of NBUCKETS DISTINCT empty assoc arrays. (Array::make\n/// would alias one array across every slot, so push fresh empties instead.)\nfn new_string_buckets() -> Array[Array[(String, String)]] {\n  let n = nbuckets()\n  let b = ArrayBuilder::new()\n  let rec go: (Int) -> Unit = (i) -> {\n    if i >= n {\n      ()\n    } else {\n      ArrayBuilder::push(b, empty_string_pairs())\n      go(i + 1)\n    }\n  }\n  go(0)\n  ArrayBuilder::freeze(b)\n}\n\nfn new_deps_buckets() -> Array[Array[(String, Array[String])]] {\n  let n = nbuckets()\n  let b = ArrayBuilder::new()\n  let rec go: (Int) -> Unit = (i) -> {\n    if i >= n {\n      ()\n    } else {\n      ArrayBuilder::push(b, empty_deps_pairs())\n      go(i + 1)\n    }\n  }\n  go(0)\n  ArrayBuilder::freeze(b)\n}\n\nfn strmap_new() -> StrMap {\n  StrMap(new_string_buckets())\n}\n\nfn assoc_get_string(bucket: Array[(String, String)], key: String, i: Int) -> Option[String] {\n  if i >= Array::length(bucket) {\n    None\n  } else {\n    let (k, v) = Array::get(bucket, i)\n    if k == key {\n      Some(v)\n    } else {\n      assoc_get_string(bucket, key, i + 1)\n    }\n  }\n}\n\nfn strmap_get(m: StrMap, key: String) -> Option[String] {\n  match m {\n    StrMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      assoc_get_string(bucket, key, 0)\n    }\n  }\n}\n\n/// In-place upsert into the bucket for `key`.\nfn strmap_set(m: StrMap, key: String, value: String) -> Unit {\n  match m {\n    StrMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      let len = Array::length(bucket)\n      let rec go: (Int) -> Unit = (i) -> {\n        if i >= len {\n          Array::push(bucket, (key, value))\n        } else {\n          let (k, _) = Array::get(bucket, i)\n          if k == key {\n            Array::set(bucket, i, (key, value))\n          } else {\n            go(i + 1)\n          }\n        }\n      }\n      go(0)\n    }\n  }\n}\n\nfn depsmap_new() -> DepsMap {\n  DepsMap(new_deps_buckets())\n}\n\nfn assoc_get_deps(bucket: Array[(String, Array[String])], key: String, i: Int) -> Option[Array[String]] {\n  if i >= Array::length(bucket) {\n    None\n  } else {\n    let (k, v) = Array::get(bucket, i)\n    if k == key {\n      Some(v)\n    } else {\n      assoc_get_deps(bucket, key, i + 1)\n    }\n  }\n}\n\nfn depsmap_get(m: DepsMap, key: String) -> Option[Array[String]] {\n  match m {\n    DepsMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      assoc_get_deps(bucket, key, 0)\n    }\n  }\n}\n\nfn depsmap_set(m: DepsMap, key: String, deps: Array[String]) -> Unit {\n  match m {\n    DepsMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      let len = Array::length(bucket)\n      let rec go: (Int) -> Unit = (i) -> {\n        if i >= len {\n          Array::push(bucket, (key, deps))\n        } else {\n          let (k, _) = Array::get(bucket, i)\n          if k == key {\n            Array::set(bucket, i, (key, deps))\n          } else {\n            go(i + 1)\n          }\n        }\n      }\n      go(0)\n    }\n  }\n}\n\nexport fn ripple_new() -> RippleDb {\n  let count = ArrayBuilder::new()\n  ArrayBuilder::push(count, 0)\n  RippleDb(strmap_new(), strmap_new(), depsmap_new(), ArrayBuilder::freeze(count))\n}\n\nexport fn ripple_get_source(db: RippleDb, path: String) -> Option[String] {\n  match db {\n    RippleDb(sources, _, _, _) => strmap_get(sources, path)\n  }\n}\n\nexport fn ripple_get_fingerprint(db: RippleDb, path: String) -> Option[String] {\n  match db {\n    RippleDb(_, fingerprints, _, _) => strmap_get(fingerprints, path)\n  }\n}\n\nexport fn ripple_get_deps(db: RippleDb, path: String) -> Option[Array[String]] {\n  match db {\n    RippleDb(_, _, deps_map, _) => depsmap_get(deps_map, path)\n  }\n}\n\nexport fn ripple_eval_count(db: RippleDb) -> Int {\n  match db {\n    RippleDb(_, _, _, count) => Array::get(count, 0)\n  }\n}\n\nexport fn ripple_set_source(db: RippleDb, path: String, source: String) -> RippleDb {\n  match db {\n    RippleDb(sources, _, _, _) => {\n      strmap_set(sources, path, source)\n      db\n    }\n  }\n}\n\nexport fn ripple_record_eval(db: RippleDb, path: String, fingerprint: String, deps: Array[String]) -> RippleDb {\n  match db {\n    RippleDb(_, fingerprints, deps_map, count) => match strmap_get(fingerprints, path) {\n      Some(prev_fp) => if prev_fp == fingerprint {\n        db\n      } else {\n        strmap_set(fingerprints, path, fingerprint)\n        depsmap_set(deps_map, path, deps)\n        Array::set(count, 0, Array::get(count, 0) + 1)\n        db\n      },\n      None => {\n        strmap_set(fingerprints, path, fingerprint)\n        depsmap_set(deps_map, path, deps)\n        Array::set(count, 0, Array::get(count, 0) + 1)\n        db\n      }\n    }\n  }\n}\n\n//# Module order planning (#1239 step 4A / #906 step 4)\n\n/// Lexicographic (char-by-char) string ordering. Deliberately NOT a builtin\n/// `<`: canonical ordering must be true lexicographic, and a length-first\n/// comparison would make the plan's \"canonical\" order depend on path length\n/// (CLAUDE.md documents that exact footgun). Mirrors\n/// compiler/core/sorted_index.vibe's str_lt, duplicated rather than imported\n/// because @vibe/graph must not depend on the compiler package.\nfn mo_str_lt(a: String, b: String) -> Bool {\n  let la = String::length(a)\n  let lb = String::length(b)\n  let lim = if la < lb {\n    la\n  } else {\n    lb\n  }\n  let mut i = 0\n  let mut res = la < lb\n  let mut done = false\n  while i < lim && !done {\n    let ca = String::char_code_at(a, i)\n    let cb = String::char_code_at(b, i)\n    if ca < cb {\n      res = true\n      done = true\n    } else if ca > cb {\n      res = false\n      done = true\n    } else {\n      i = i + 1\n    }\n  }\n  res\n}\n\n/// Index of `p` in `names`, or -1. Linear: this pass runs once per compile\n/// over the module count (hundreds), not per AST node, so the O(N^2) worst\n/// case is not on any hot path -- unlike the maps above, which are indexed\n/// precisely because they ARE.\nfn mo_index_of(names: Array[String], p: String) -> Int {\n  let n = Array::length(names)\n  let mut i = 0\n  let mut found = -1\n  while found < 0 && i < n {\n    if Array::get(names, i) == p {\n      found = i\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// Declared dependencies of `p`. A module with no entry in `edges` is a leaf\n/// (rank 0) -- this is how unresolvable/missing imports stay terminal instead\n/// of aborting the plan, matching ensure_fingerprint_fs_go's `missing:` arm.\nfn mo_deps_of(edges: Array[(String, Array[String])], p: String) -> Array[String] {\n  let n = Array::length(edges)\n  let mut i = 0\n  let out: Array[String] = [\n  ]\n  let mut done = false\n  while !done && i < n {\n    let e = Array::get(edges, i)\n    if e.0 == p {\n      let deps = e.1\n      let dn = Array::length(deps)\n      let mut j = 0\n      while j < dn {\n        Array::push(out, Array::get(deps, j))\n        j = j + 1\n      }\n      done = true\n    } else {\n      i = i + 1\n    }\n  }\n  out\n}\n\n/// Intern `p` into the node table, returning its id.\nfn mo_intern(names: Array[String], color: Array[Int], rank: Array[Int], p: String) -> Int {\n  let existing = mo_index_of(names, p)\n  if existing >= 0 {\n    existing\n  } else {\n    Array::push(names, p)\n    Array::push(color, 0)\n    Array::push(rank, 0)\n    Array::length(names) - 1\n  }\n}\n\n/// #1239 step 4A (docs/compiler-parallelism.md \"Scheduling and commit\" 1-2):\n/// the coordinator-side upfront pass over the import DAG. Given the resolved\n/// import edges and a root, it rejects import cycles and assigns every\n/// reachable module a RANK -- `rank(m) = 1 + max(rank of m's dependencies)`,\n/// 0 for a leaf -- then returns the modules in CANONICAL order (rank\n/// ascending, then module path ascending) alongside their ranks.\n///\n/// Why this is the extraction #906 step 4 asked for: today\n/// ensure_fingerprint_fs_go (compiler/runtime/typecheck_fs.vibe) discovers\n/// cycles incidentally, mid-recursion, via the \"currently visiting\" stack --\n/// so the cycle check, the incremental-cache short-circuits and the single\n/// commit_module_outcome call site are all tangled into one sequential walk.\n/// A coordinator cannot schedule from that: it needs the order BEFORE it\n/// dispatches anything. This function is that \"before\".\n///\n/// Two properties make the result usable as a parallel schedule:\n///\n///  - **rank is a wave number**: every module of rank k depends only on\n///    modules of rank < k, so an entire rank can be dispatched concurrently\n///    and ranks are joined in ascending order. (It is the longest path to a\n///    leaf, not the shortest -- taking the max is what makes the guarantee\n///    hold transitively.)\n///  - **the order is visit-order independent**: ranks come from the DAG\n///    itself and the final sort breaks ties by path, so permuting dependency\n///    traversal order (compiler/runtime/typecheck_fs.vibe's dep_visit_order\n///    seed, the existing #906 Phase 0 nondeterminism probe) cannot change\n///    this output. That is exactly the determinism the Acceptance Criteria\n///    ask of `--jobs=1/2/4`, established here without needing parallelism to\n///    exist yet.\n///\n/// Pure by construction (`Error` only, for the cycle rejection): dependency\n/// RESOLUTION needs `Fs`, ordering does not. Keeping the split means the\n/// ordering rule can be tested -- and modelled against\n/// formal/VibeFormal/Compiler/Scheduler.lean's acyclicity and `Ready`\n/// premises (#906 step 8) -- without a filesystem in the loop.\n///\n/// Consumed on BOTH sides of the compile now.\n///\n/// Out-of-process, via cli_adapter.vibe's `VIBE_MODULE_PLAN` mode, which\n/// discovers the graph and ranks it in one call: the job-dir worker takes\n/// each dependency's environment as a value (`dep<i>.env`), so a coordinator\n/// must know the waves before it dispatches anything. (An ordering-only\n/// `VIBE_PLAN_MODULE_ORDER` mode taking resolved edges existed until #1259;\n/// once discovery moved into the compiler it had no caller left.)\n///\n/// In-process, via compiler/runtime/typecheck_fs.vibe's\n/// ensure_fingerprint_fs_impl, which builds the edges upfront\n/// (plan_import_graph_fs) and calls this before the walk -- so a cyclic\n/// import graph is rejected before any module is checked, committed, or\n/// written to the persistent cache, rather than partway through the walk on\n/// whichever module a DFS happened to re-enter first. Since #1239 step 4(D)\n/// that path consumes the ORDER as well: the walk is a wave loop over these\n/// ranks, not a recursive descent, so it no longer threads four state values\n/// through a node's dependencies in sequence and siblings are independent.\n/// It still runs one module at a time -- dispatching a wave out-of-process is\n/// a change to that inner loop now, not a restructuring of the walk.\n///\n/// The earlier note here said this was blocked on a Wasmtime multi-instance\n/// host, because such a host \"shares one Engine and compiled Module\". That\n/// premise was wrong and #1248 measured it: `viberun --precompile` already\n/// pays for that sharing (AOT `.cwasm` ~8ms/job vs ~485ms JIT), so an\n/// ordinary PROCESS pool over the existing image scales -- 3.37x on 4 cores,\n/// with byte-identical results at -P 1/2/4/8\n/// (scripts/bench_module_job_pool.sh).\nexport fn plan_module_order(edges: Array[(String, Array[String])], root: String) -> (Array[String], Array[Int]) with { Error } {\n  let names: Array[String] = [\n  ]\n  // 0 = unvisited, 1 = on the current DFS path, 2 = finished (rank final)\n  let color: Array[Int] = [\n  ]\n  let rank: Array[Int] = [\n  ]\n  // Explicit stacks instead of recursion: the import DAG is as deep as the\n  // deepest import chain, and this compiler has already hit wasm stack\n  // exhaustion from a recursive whole-program walk (see analyze_calls's #556\n  // note in compiler/perceus/perceus.vibe).\n  let st_node: Array[Int] = [\n  ]\n  let st_cursor: Array[Int] = [\n  ]\n  let root_id = mo_intern(names, color, rank, root)\n  Array::set(color, root_id, 1)\n  Array::push(st_node, root_id)\n  Array::push(st_cursor, 0)\n  while Array::length(st_node) > 0 {\n    let top = Array::length(st_node) - 1\n    let nid = Array::get(st_node, top)\n    let cursor = Array::get(st_cursor, top)\n    let deps = mo_deps_of(edges, Array::get(names, nid))\n    if cursor < Array::length(deps) {\n      Array::set(st_cursor, top, cursor + 1)\n      let dep = Array::get(deps, cursor)\n      let did = mo_intern(names, color, rank, dep)\n      let dcolor = Array::get(color, did)\n      if dcolor == 1 {\n        // Same wording as ensure_fingerprint_fs_go's inline check, so moving\n        // the rejection upfront does not change the user-visible diagnostic.\n        throw(String::concat(\"type_db: import cycle detected at \", dep))\n      } else if dcolor == 0 {\n        Array::set(color, did, 1)\n        Array::push(st_node, did)\n        Array::push(st_cursor, 0)\n      } else {\n        ()\n      }\n    } else {\n      let mut r = 0\n      let mut i = 0\n      while i < Array::length(deps) {\n        let did = mo_index_of(names, Array::get(deps, i))\n        if did >= 0 {\n          let dr = Array::get(rank, did) + 1\n          if dr > r {\n            r = dr\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      Array::set(rank, nid, r)\n      Array::set(color, nid, 2)\n      Array::truncate(st_node, top)\n      Array::truncate(st_cursor, top)\n    }\n  }\n  // Canonical order: rank ascending, then path ascending. Insertion sort --\n  // the module count is small and this keeps the ordering rule obvious enough\n  // to check by eye against the doc's \"canonical module-path/topological\n  // order\" wording.\n  let out_paths: Array[String] = [\n  ]\n  let out_ranks: Array[Int] = [\n  ]\n  let total = Array::length(names)\n  let mut k = 0\n  while k < total {\n    let nm = Array::get(names, k)\n    let rk = Array::get(rank, k)\n    let placed = Array::length(out_paths)\n    let mut pos = 0\n    let mut settled = false\n    while !settled && pos < placed {\n      let ork = Array::get(out_ranks, pos)\n      if rk < ork || (rk == ork && mo_str_lt(nm, Array::get(out_paths, pos))) {\n        settled = true\n      } else {\n        pos = pos + 1\n      }\n    }\n    Array::push(out_paths, \"\")\n    Array::push(out_ranks, 0)\n    let mut shift = Array::length(out_paths) - 1\n    while shift > pos {\n      Array::set(out_paths, shift, Array::get(out_paths, shift - 1))\n      Array::set(out_ranks, shift, Array::get(out_ranks, shift - 1))\n      shift = shift - 1\n    }\n    Array::set(out_paths, pos, nm)\n    Array::set(out_ranks, pos, rk)\n    k = k + 1\n  }\n  (out_paths, out_ranks)\n}\n")
}

let cli_adapter_source_162 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/typecheck_fs.vibe",
"//# Imports\n\nimport @vibe/compiler/cache {\n  compact_string_fingerprint,\n  normalize_persistent_cache_text,\n  persistent_dep_list_cache_path,\n  persistent_leaf_fingerprint_cache_path,\n  persistent_type_env_cache_path\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/checker {\n  check_program, check_program_type_table, check_program_with_env, detect_unbound_nonunit_returns, detect_unused_imports\n}\n\nimport @vibe/compiler/core {\n  Expr,\n  Stmt,\n  Type,\n  TypeEnv,\n  dir_of_path,\n  env_bind,\n  env_flat_bindings,\n  env_lookup_flat,\n  resolve_import_path,\n  resolve_import_path_candidates,\n  str_lt\n}\n\n// #946(4): inline-wasm codegen validation (lane/align/etc. errors) runs as\n// part of `collect_all_diagnostics` too — see check_inline_wasm_fns below.\nimport @vibe/compiler/codegen {\n  compile_inline_wat\n}\n\nimport @vibe/compiler/loader {\n  ingest_source_text_fs, load_or_parse_module_header_fs\n}\n\nimport @vibe/graph {\n  RippleDb, plan_module_order, ripple_get_deps, ripple_get_fingerprint, ripple_get_source, ripple_record_eval\n}\n\nimport @vibe/compiler/syntax {\n  lex_with_offsets, lex_with_offsets_recovering, offset_to_line_col, parse_program_located, parse_program_recovering\n}\n\nimport @vibe/compiler/runtime/eval_loader {\n  contains_str\n}\n\nexport ./persistent_env_codec.vibe {\n  load_persistent_dep_list,\n  load_persistent_leaf_fingerprint,\n  load_persistent_type_env,\n  parse_persistent_type_env,\n  persistent_dep_list_text,\n  persistent_leaf_fingerprint_text,\n  persistent_type_env_cache_text\n}\n\n//# Functions\n\nfn empty_stack() -> Array[String] {\n  array_empty()\n}\n\nfn empty_dep_fps() -> Array[(String, String)] {\n  array_empty()\n}\n\nfn lookup_env_cache(cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\n  let len = Array::length(cache)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let (p, env) = Array::get(cache, i)\n      if p == path {\n        result = Some(env)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nfn resolve_cached_import_path(base_dir: String, raw_path: String, cache: Array[(String, TypeEnv)]) -> String {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut selected = \"\"\n  let mut i = 0\n  while i < Array::length(candidates) && selected == \"\" {\n    let candidate = Array::get(candidates, i)\n    match lookup_env_cache(cache, candidate) {\n      Some(_) => {\n        selected = candidate\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  if selected == \"\" {\n    resolve_import_path(base_dir, raw_path)\n  } else {\n    selected\n  }\n}\n\nfn starts_with_upper(name: String) -> Bool {\n  if String::length(name) == 0 {\n    false\n  } else {\n    let c = String::char_code_at(name, 0)\n    c >= 65 && c <= 90\n  }\n}\n\nfn type_returns_name(ty: Type, type_name: String) -> Bool {\n  match ty {\n    CtEnum(name) => name == type_name,\n    CtNamed(name, _) => name == type_name,\n    CtFn(_, ret, _) => type_returns_name(ret, type_name),\n    CtForAll(_, _, body) => type_returns_name(body, type_name),\n    _ => false\n  }\n}\n\n/// Companions bound alongside an imported type `T`: (a) constructors and\n/// constructor-like functions RETURNING T (the original rule -- written\n/// for enum constructors, whose type is always `... -> T`), and (b) any\n/// export whose NAME is qualified with `T::` (#1080): the #777\n/// `Json::string`-style direct-value accessors are exported under the\n/// type's qualified namespace but RETURN a different type (String/Int/\n/// Bool/...), so rule (a) never bound them -- importing `{ Json }` gave\n/// you `Json::parse`/`Json::field` (return Json, matched (a) by\n/// coincidence) but \"unknown name: Json::string\" for the other 8 of the\n/// 11 documented accessors. The bundle-merge lane resolves these by name\n/// against the merged unit and never had the gap; only this FS lane did.\nfn bind_enum_constructor_companions(acc: TypeEnv, dep_bindings: Array[(String, Type)], enum_name: String) -> TypeEnv {\n  let qual_prefix = String::concat(enum_name, \"::\")\n  let mut out = acc\n  let mut i = 0\n  while i < Array::length(dep_bindings) {\n    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)\n    if candidate_name != enum_name && starts_with_upper(candidate_name) && (type_returns_name(candidate_ty, enum_name) || String::starts_with(candidate_name, qual_prefix)) {\n      out = env_bind(out, candidate_name, candidate_ty)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn bind_import_names_from_cache(acc: TypeEnv, resolved: String, names: Array[(String, Option[String])], cache: Array[(String, TypeEnv)]) -> TypeEnv {\n  let dep_env = match lookup_env_cache(cache, resolved) {\n    Some(e) => e,\n    None => EnvEmpty\n  }\n  let dep_bindings = env_flat_bindings(dep_env)\n  let nlen = Array::length(names)\n  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {\n    if j >= nlen {\n      nacc\n    } else {\n      let (name, alias) = Array::get(names, j)\n      let bound_name = match alias {\n        Some(a) => a,\n        None => name\n      }\n      let ty = match env_lookup_flat(dep_bindings, name) {\n        Some(t) => t,\n        None => CtUnknown\n      }\n      let with_name = env_bind(nacc, bound_name, ty)\n      let with_companions = match ty {\n        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),\n        _ => if starts_with_upper(name) {\n          bind_enum_constructor_companions(with_name, dep_bindings, name)\n        } else {\n          with_name\n        }\n      }\n      bind_names(j + 1, with_companions)\n    }\n  }\n  bind_names(0, acc)\n}\n\nfn build_import_env(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv {\n  let len = Array::length(stmts)\n  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        SReExport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, EnvEmpty)\n}\n\nfn upsert_env_cache(cache: Array[(String, TypeEnv)], path: String, env: TypeEnv) -> Array[(String, TypeEnv)] {\n  let len = Array::length(cache)\n  let mut i = 0\n  let mut found = false\n  while i < len && !found {\n    let (p, _) = Array::get(cache, i)\n    if p == path {\n      Array::set(cache, i, (path, env))\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  if !found {\n    Array::push(cache, (path, env))\n  }\n  cache\n}\n\nfn ensure_env_cache_for_path(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], path: String) -> Array[(String, TypeEnv)] with { Error, Fs } {\n  match lookup_env_cache(env_cache, path) {\n    Some(_) => env_cache,\n    None =>\n    match ripple_get_fingerprint(rdb, path) {\n      Some(fingerprint) =>\n      match load_persistent_type_env(fingerprint) {\n        Some(cached_env) => upsert_env_cache(env_cache, path, cached_env),\n        None => env_cache\n      },\n      None => env_cache\n    }\n  }\n}\n\nfn ensure_env_cache_for_paths(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], paths: Array[String]) -> Array[(String, TypeEnv)] with { Error, Fs } {\n  let mut cache = env_cache\n  let mut i = 0\n  while i < Array::length(paths) {\n    cache = ensure_env_cache_for_path(rdb, cache, Array::get(paths, i))\n    i = i + 1\n  }\n  cache\n}\n\nfn build_fingerprint(source: String, dep_fps: Array[(String, String)]) -> String {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let dep_pair = Array::get(dep_fps, i)\n    let dep_path = dep_pair.0\n    let dep_fp = dep_pair.1\n    let next = String::concat(acc, String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp))))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nfn copy_string_array(items: Array[String]) -> Array[String] {\n  // Iterative push: previous recursive Array::concat(acc, [x]) was\n  // O(N^2) — copied the full prefix on each step.\n  let out = empty_stack()\n  let mut i = 0\n  let len = Array::length(items)\n  while i < len {\n    Array::push(out, Array::get(items, i))\n    i = i + 1\n  }\n  out\n}\n\n/// Shallow copy of a (path, source) cache.\n///\n/// plan_import_graph_fs has to resolve dependencies against its OWN copy:\n/// upsert_string_pair below MUTATES the array it is handed and returns that\n/// same array, and resolve_deps_for_source_fs upserts on every miss. Planning\n/// against the caller's cache therefore marked every module's current source\n/// as already-seen before the walk even started -- and the walk reads exactly\n/// that to decide whether a module's cached fingerprint is still valid, so an\n/// edited source reused its stale type env (caught by\n/// type_db_cross_module_test's \"source update bypasses current-run cache\").\nfn copy_string_pairs(pairs: Array[(String, String)]) -> Array[(String, String)] {\n  let out = empty_dep_fps()\n  let mut i = 0\n  let len = Array::length(pairs)\n  while i < len {\n    Array::push(out, Array::get(pairs, i))\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_string_pair(pairs: Array[(String, String)], key: String) -> Option[String] {\n  let len = Array::length(pairs)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        result = Some(v)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nfn upsert_string_pair(pairs: Array[(String, String)], key: String, value: String) -> Array[(String, String)] {\n  let len = Array::length(pairs)\n  let mut i = 0\n  let mut found = false\n  while i < len && !found {\n    let (k, _) = Array::get(pairs, i)\n    if k == key {\n      Array::set(pairs, i, (key, value))\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  if !found {\n    Array::push(pairs, (key, value))\n  }\n  pairs\n}\n\n/// --- #906 Phase 0: ready-order oracle -----------------------------------\n///\n/// The import-DAG walk below visits a module's dependencies in DECLARATION\n/// order. Phase 2 will hand ready modules to workers, at which point the\n/// visit order becomes whatever the scheduler picks -- so the property that\n/// has to hold before any of that is built is \"the order dependencies are\n/// visited cannot change the output\". This seed makes that property\n/// TESTABLE today, with no real parallelism: a non-zero seed permutes each\n/// node's dependency visit order deterministically, and\n/// scripts/dep_order_oracle.sh asserts the compiled wasm is byte-identical\n/// across seeds.\n///\n/// The switch rides in a module-level cell rather than a parameter for the\n/// same reason set_error_row_checked (checker/checker_effects.vibe) does:\n/// the typecheck walk is pure (no Env row) and threading a config value\n/// through every frame of a recursion that already carries five accumulators\n/// would be far more invasive than the thing being tested.\n///\n/// Seed 0 (the default, and what every production build uses) is the\n/// identity permutation -- byte-for-byte the pre-#906 walk.\nlet dep_order_seed_cell = array_empty()\n\nexport fn set_dep_order_seed(seed: Int) -> Unit {\n  Array::truncate(dep_order_seed_cell, 0)\n  Array::push(dep_order_seed_cell, seed)\n}\n\nfn dep_order_seed() -> Int {\n  if Array::length(dep_order_seed_cell) > 0 {\n    Array::get(dep_order_seed_cell, 0)\n  } else {\n    0\n  }\n}\n\n/// --- #1259: scheduler trace, for the real-path differential oracle -------\n///\n/// #1239 step 8 asks that the REAL compile path's execution trace be matched\n/// against formal/VibeFormal/Compiler/Scheduler.lean. Until now only a\n/// synthetic worker was (scripts/parallel_selfhost_checker.mjs), which can\n/// only show the model is self-consistent -- never that the compiler is an\n/// instance of it.\n///\n/// When VIBE_SCHEDULER_TRACE names a file, the walk records what the Lean\n/// model needs and nothing else. Two row kinds:\n///\n///   project<TAB><path><TAB><rank>[<TAB><dep>...]   the planned graph\n///   step<TAB><path><TAB><fingerprint>              in EXECUTION order\n///\n/// `project` rows are `Project.dependencies` and `Project.rank`; `step` rows\n/// are the `Step.run` sequence, and their order is the interleaving a\n/// scheduler chose (VIBE_DEP_ORDER_SEED permutes it within a wave). The\n/// fingerprint is the published `JobResult`. scripts/scheduler_trace_oracle.sh\n/// checks the four properties that model states -- see it for which row\n/// proves which.\n///\n/// Accumulated in memory and written once, not appended per module: the row\n/// order IS the execution order, so a partial file from an aborted run would\n/// read as a legitimate shorter schedule rather than as a truncated one.\nlet scheduler_trace_cell = array_empty()\n\nexport fn set_scheduler_trace_path(path: String) -> Unit {\n  Array::truncate(scheduler_trace_cell, 0)\n  Array::push(scheduler_trace_cell, path)\n}\n\nfn scheduler_trace_path() -> String {\n  if Array::length(scheduler_trace_cell) > 0 {\n    Array::get(scheduler_trace_cell, 0)\n  } else {\n    \"\"\n  }\n}\n\n/// --- #1259: cross-module diagnostic collection ---------------------------\n///\n/// Whether the import-DAG walk COLLECTS a diagnostic per failing module\n/// instead of failing fast on the first one. This is #1239 step 5's missing\n/// prerequisite: step 5 asks for diagnostics sorted into a canonical order and\n/// compared across `--jobs=1/2/4`, and until now there was never more than one\n/// diagnostic to sort -- commit_module_outcome threw on the first.\n///\n/// OFF by default, and off is byte-for-byte the pre-#1259 walk: the same\n/// message, raised for the same module, with the same partial cache state\n/// behind it. `VIBE_DIAGNOSTICS_ALL=1` (read in cli_adapter.vibe alongside the\n/// other mode switches, so every lane agrees) turns it on.\n///\n/// Default-off is a deliberate compatibility choice, not indecision. Turning\n/// collection on changes two observable things at once -- the error text grows\n/// from one diagnostic to N, and modules that a fail-fast walk never reached\n/// now get checked and their environments committed to the persistent cache --\n/// and flipping the default is a separate decision from having the mechanism\n/// and its determinism gate.\n///\n/// The switch rides in a module-level cell for the same reason\n/// dep_order_seed_cell above does.\nlet collect_diagnostics_cell = array_empty()\n\nexport fn set_collect_module_diagnostics(on: Bool) -> Unit {\n  Array::truncate(collect_diagnostics_cell, 0)\n  Array::push(collect_diagnostics_cell, on)\n}\n\nfn collect_module_diagnostics() -> Bool {\n  if Array::length(collect_diagnostics_cell) > 0 {\n    Array::get(collect_diagnostics_cell, 0)\n  } else {\n    false\n  }\n}\n\n/// A permutation of [0, n) as a visit order. Identity when no seed is set.\n/// Otherwise a seeded Fisher-Yates using a small LCG -- deterministic for a\n/// given (seed, n), so a failing oracle run is exactly reproducible.\nfn dep_visit_order(n: Int) -> Array[Int] {\n  let order = array_empty()\n  let mut i = 0\n  while i < n {\n    Array::push(order, i)\n    i = i + 1\n  }\n  let seed = dep_order_seed()\n  if seed == 0 || n < 2 {\n    order\n  } else {\n    // LCG (Numerical Recipes constants), kept inside 31 bits so the 62-bit\n    // Int never overflows and the sequence is identical on every backend.\n    let mut state = seed\n    let mut j = n - 1\n    while j > 0 {\n      state = (state * 1664525 + 1013904223)&2147483647\n      let k = state % (j + 1)\n      let tmp = Array::get(order, j)\n      Array::set(order, j, Array::get(order, k))\n      Array::set(order, k, tmp)\n      j = j - 1\n    }\n    order\n  }\n}\n\n/// #1100: process-local parse memo. A cold fs-mode compile parses the SAME\n/// source text TWICE -- once here for the typecheck walk (only on a\n/// persistent type-env cache MISS, see finish_typecheck_fs_impl) and once\n/// again for the merge (parse_sources_for_merge, file_compile.vibe). Both\n/// sites ran the identical `lex_with_offsets` + `parse_program_located` pair\n/// under the identical `<path>: <msg>` error wrapping, so the second parse\n/// was pure waste -- #1100's phase attribution measured the merge parse at\n/// 102 MB of a ~850 MB cold selfcompile.\n///\n/// Keyed by (path, EXACT source text). The source is compared in full rather\n/// than fingerprinted: a same-path re-ingest with different text is a real\n/// shape (#897's vpkg shared-import prefix marker), and a full compare is\n/// far cheaper than the parse it guards.\n///\n/// The memo hands out a SHALLOW COPY of the top-level statement array, never\n/// the stored one. check_program mutates its argument in place --\n/// inject_prelude_result APPENDS the Result enum, and\n/// inject_trait_method_generics / desugar_railway_binds /\n/// desugar_labeled_args each `Array::set(stmts, i, <rewritten>)` -- so\n/// handing out the pristine array directly would leak a per-file Result\n/// declaration (one per file, all merged together) and pre-desugared\n/// statements into the merge. Every one of those mutators writes only at the\n/// TOP level (verified: they rebuild each Stmt functionally and write it\n/// back by index), so a fresh top-level array is complete isolation; the\n/// Stmt values themselves are immutable enum payloads.\n///\n/// A throwing parse is NOT memoized: the cells stay untouched, so a second\n/// caller re-parses and re-throws identically.\nlet parse_memo_paths: Array[String] = [\n]\n\nlet parse_memo_sources: Array[String] = [\n]\n\nlet parse_memo_stmts: Array[Array[Stmt]] = [\n]\n\nexport fn parse_program_with_path(path: String, source: String) -> Array[Stmt] with { Error } {\n  let n = Array::length(parse_memo_paths)\n  let mut i = 0\n  let mut hit = -1\n  while i < n && hit < 0 {\n    if Array::get(parse_memo_paths, i) == path && Array::get(parse_memo_sources, i) == source {\n      hit = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  if hit >= 0 {\n    let cached = Array::get(parse_memo_stmts, hit)\n    Array::slice(cached, 0, Array::length(cached))\n  } else {\n    let parsed = handle {\n      // Located lex+parse so EIdent (and other) nodes carry real source char\n      // offsets; the checker rides those offsets into type diagnostics via the\n      // [@off=N] marker (decoded by locate_type_error). The plain\n      // `parse_program(lex(source))` passed an empty starts array, leaving every\n      // offset at -1, so located type errors fell back to a first-occurrence scan.\n      let (tokens, starts, _ends) = lex_with_offsets(source)\n      parse_program_located(tokens, starts, source)\n    } with Error {\n      Throw(msg) => throw(String::concat(String::concat(path, \": \"), msg))\n    }\n    // Bound the memo. It is process-wide, and `vibe --daemon` (the #906\n    // worker transport reuses one) serves many compiles from one process:\n    // each edited source is a new (path, source) pair, so an unbounded memo\n    // grows monotonically in guest memory -- full source AND AST per entry\n    // -- and the linear scan above gets slower with every historical\n    // version retained.\n    //\n    // The win this memo exists for is WITHIN one compile: the typecheck\n    // walk parses every module, then the merge parses them all again, so\n    // the whole module set has to be resident at once. The cap is\n    // therefore set well above a self-compile's module count (264 manifest\n    // rows) rather than to some small number. Clearing outright instead of\n    // evicting one entry keeps this branch simple; at 1024 vs 264 it can\n    // only trigger after hundreds of edits in a single daemon, and it\n    // costs one compile's worth of re-parsing when it does.\n    if Array::length(parse_memo_paths) >= 1024 {\n      Array::truncate(parse_memo_paths, 0)\n      Array::truncate(parse_memo_sources, 0)\n      Array::truncate(parse_memo_stmts, 0)\n    } else {\n      ()\n    }\n    Array::push(parse_memo_paths, path)\n    Array::push(parse_memo_sources, source)\n    Array::push(parse_memo_stmts, parsed)\n    Array::slice(parsed, 0, Array::length(parsed))\n  }\n}\n\nfn store_persistent_type_env(fingerprint: String, env: TypeEnv) -> Unit with { Error, Fs } {\n  Fs::write_file(persistent_type_env_cache_path(fingerprint), persistent_type_env_cache_text(env))\n}\n\nfn write_persistent_dep_list_if_missing(path: String, source: String, deps: Array[String]) -> Unit with { Fs } {\n  let dep_cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\n  if !(Fs::exists(dep_cache_path)) {\n    Fs::write_file(dep_cache_path, persistent_dep_list_text(deps))\n  } else {\n    ()\n  }\n}\n\n/// Span of an identifier run starting at `start` (returns the end offset).\nfn typecheck_ident_run(s: String, start: Int) -> Int {\n  let len = String::length(s)\n  let mut e = start\n  let mut go = true\n  while go && e < len {\n    let c = String::char_code_at(s, e)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    if is_id {\n      e = e + 1\n    } else {\n      go = false\n    }\n  }\n  e\n}\n\n/// Best-effort `line:col` for a type error: pull the symbol out of\n/// `unknown name: X` and locate its first occurrence in the source. Real\n/// expression-level spans (AST node positions) remain future work; this gives\n/// the common case a line number in both CLI and LSP (which parses the prefix).\n/// Built with String::concat only (not `+`) to avoid this NUL fragility.\n/// Prefix `msg` with the source `line:col` of the symbol that follows `marker`\n/// in `msg` (if both are found); otherwise return `msg` unchanged.\nfn locate_by_marker(source: String, msg: String, marker: String) -> String {\n  let mi = String::index_of(msg, marker)\n  if mi < 0 {\n    msg\n  } else {\n    let sstart = mi + String::length(marker)\n    let send = typecheck_ident_run(msg, sstart)\n    if send <= sstart {\n      msg\n    } else {\n      let sym = String::substring(msg, sstart, send)\n      let off = String::index_of(source, sym)\n      if off < 0 {\n        msg\n      } else {\n        let (line, col) = offset_to_line_col(source, off)\n        let loc = String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n        String::concat(loc, msg)\n      }\n    }\n  }\n}\n\n/// The exact text between `marker` and the NEXT `'` in `msg` -- unlike\n/// `locate_by_marker`'s `typecheck_ident_run` (which only captures plain\n/// identifier chars), this captures the quoted substring verbatim, so a\n/// symbol like `@shell` (not a bare identifier) comes out whole. Returns \"\"\n/// if `marker` or the closing quote isn't found.\nfn extract_quoted_after(msg: String, marker: String) -> String {\n  let mi = String::index_of(msg, marker)\n  if mi < 0 {\n    \"\"\n  } else {\n    let rest = String::substring(msg, mi + String::length(marker), String::length(msg))\n    let rel_end = String::index_of(rest, \"'\")\n    if rel_end < 0 {\n      \"\"\n    } else {\n      String::substring(rest, 0, rel_end)\n    }\n  }\n}\n\n/// First occurrence of `sym` in `source` at or after char offset `from`\n/// (clamped into range), or -1.\nfn index_of_after(source: String, sym: String, from: Int) -> Int {\n  if String::length(sym) == 0 {\n    0 - 1\n  } else {\n    let start = if from < 0 {\n      0\n    } else if from > String::length(source) {\n      String::length(source)\n    } else {\n      from\n    }\n    let rel = String::index_of(String::substring(source, start, String::length(source)), sym)\n    if rel < 0 {\n      0 - 1\n    } else {\n      start + rel\n    }\n  }\n}\n\n/// #1205 Codex review: a plain first-occurrence search for the bare\n/// name/alias (the #1204 approach) can land on an EARLIER, unrelated\n/// occurrence of the same spelling -- a comment or string mentioning the\n/// name before the import statement itself, or another import of the same\n/// name from a different path. `detect_unused_imports`' own message embeds\n/// the import's PATH too (`imported name 'X' from 'PATH' ..` / `import alias\n/// '@A' for 'PATH' ..`) -- a path is far less likely to collide with\n/// unrelated text than a short bare identifier, so anchor on the path's OWN\n/// first occurrence and search for the name/alias only from there forward:\n/// the import statement's own occurrence of its item names always comes\n/// shortly after its own path in the source. Degrades to an unanchored\n/// search (starting from offset 0) if the path itself can't be found, which\n/// is no worse than the #1204 behavior this replaces.\nfn locate_unused_import_msg(source: String, msg: String) -> String {\n  let name_marker = \"imported name '\"\n  let alias_marker = \"import alias '\"\n  let is_alias = String::index_of(msg, alias_marker) >= 0\n  if not(is_alias) && String::index_of(msg, name_marker) < 0 {\n    msg\n  } else {\n    let sym = if is_alias {\n      extract_quoted_after(msg, alias_marker)\n    } else {\n      extract_quoted_after(msg, name_marker)\n    }\n    let path = if is_alias {\n      extract_quoted_after(msg, \"' for '\")\n    } else {\n      extract_quoted_after(msg, \"' from '\")\n    }\n    if sym == \"\" {\n      msg\n    } else {\n      let anchor = if path == \"\" {\n        0\n      } else {\n        let p = String::index_of(source, path)\n        if p < 0 {\n          0\n        } else {\n          p\n        }\n      }\n      let off = index_of_after(source, sym, anchor)\n      if off < 0 {\n        msg\n      } else {\n        String::concat(offset_line_col_prefix(source, off), msg)\n      }\n    }\n  }\n}\n\n/// First-occurrence heuristic locator (the original behavior). Kept separate so\n/// the offset-marker path can fall through to it on the marker-stripped message.\nfn locate_type_error_heuristic(source: String, msg: String) -> String {\n  // Already located (e.g. a parse error that bubbled here)? leave it.\n  if String::index_of(msg, \"line \") == 0 {\n    msg\n  } else {\n    let with_name = locate_by_marker(source, msg, \"unknown name: \")\n    if with_name != msg {\n      with_name\n    } else {\n      let with_arity = locate_by_marker(source, msg, \"function arity mismatch for \")\n      if with_arity != msg {\n        with_arity\n      } else {\n        let with_field = locate_by_marker(source, msg, \"unknown field \")\n        if with_field != msg {\n          with_field\n        } else {\n          let with_ctor = locate_by_marker(source, msg, \"unknown constructor \")\n          if with_ctor != msg {\n            with_ctor\n          } else {\n            // #1204/#1205: detect_unused_imports' two message shapes (named\n            // import / package alias), path-anchored -- see\n            // locate_unused_import_msg's own doc comment.\n            let with_import = locate_unused_import_msg(source, msg)\n            if with_import != msg {\n              with_import\n            } else {\n              // #946(4): inline-wasm codegen errors (\"inline wasm (fn\n              // <name>): ...\") carry no [@off=] marker (the offset they DO\n              // carry is a WAT-text offset, not a source char offset) --\n              // locate by the enclosing fn's name instead, same\n              // first-occurrence heuristic as the other markers.\n              locate_by_marker(source, msg, \"inline wasm (fn \")\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\n/// Build the `line L:col C: ` prefix for a source char offset (same format as\n/// locate_by_marker). String::concat only — the `+`/interpolation NUL\n/// hazard applies here too.\nfn offset_line_col_prefix(source: String, off: Int) -> String {\n  let (line, col) = offset_to_line_col(source, off)\n  String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n}\n\n/// Build a `line L:colC-E: ` RANGE prefix from a (start, end) char-offset span.\n/// When start and end fall on the same source line this carries the exact end\n/// column so the LSP can highlight the precise token (incl. qualified names);\n/// when end is on a later line (or not greater than start) it degrades to the\n/// point prefix. Backward compatible: `line L:` still leads, so existing\n/// `grep -F \"line N:\"` assertions keep matching. String::concat only.\nfn offset_line_col_range_prefix(source: String, start: Int, endo: Int) -> String {\n  let (l1, c1) = offset_to_line_col(source, start)\n  let (l2, c2) = offset_to_line_col(source, endo)\n  if l1 == l2 && endo > start {\n    String::concat(\"line \", String::concat(__to_string(l1), String::concat(\":\", String::concat(__to_string(c1), String::concat(\"-\", String::concat(__to_string(c2), \": \"))))))\n  } else {\n    offset_line_col_prefix(source, start)\n  }\n}\n\n/// Parse a non-negative decimal integer from msg[start..end). Returns -1 if the\n/// span is empty or contains a non-digit (callers then fall through to the text\n/// heuristic).\nfn parse_offset_digits(msg: String, start: Int, end: Int) -> Int {\n  if end <= start {\n    -1\n  } else {\n    let mut i = start\n    let mut acc = 0\n    let mut ok = true\n    while ok && i < end {\n      let c = String::char_code_at(msg, i)\n      if c >= '0' && c <= '9' {\n        acc = acc * 10 + (c - '0')\n        i = i + 1\n      } else {\n        ok = false\n      }\n    }\n    if ok {\n      acc\n    } else {\n      -1\n    }\n  }\n}\n\n/// Decode (and ALWAYS strip) the ` [@off=N]` marker the checker may have\n/// appended. If N is a valid in-range offset, prefix the stripped message with\n/// its exact `line:col`. Otherwise strip the marker and fall through to the\n/// existing first-occurrence heuristics on the cleaned message. If no marker is\n/// present, returns msg unchanged.\nexport fn locate_type_error(source: String, msg: String) -> String {\n  let marker = \" [@off=\"\n  let mi = String::index_of(msg, marker)\n  if mi < 0 {\n    locate_type_error_heuristic(source, msg)\n  } else {\n    let inner_start = mi + String::length(marker)\n    let rel_end = String::index_of(String::substring(msg, inner_start, String::length(msg)), \"]\")\n    if rel_end < 0 {\n      // Malformed marker (no closing `]`): strip from the marker onward.\n      locate_type_error_heuristic(source, String::substring(msg, 0, mi))\n    } else {\n      let close = inner_start + rel_end\n      // inner is `N` (start only) or `N:M` (start:end). Split on `:`.\n      let inner = String::substring(msg, inner_start, close)\n      let colon = String::index_of(inner, \":\")\n      let n = if colon < 0 {\n        parse_offset_digits(inner, 0, String::length(inner))\n      } else {\n        parse_offset_digits(inner, 0, colon)\n      }\n      let m = if colon < 0 {\n        -1\n      } else {\n        parse_offset_digits(inner, colon + 1, String::length(inner))\n      }\n      // Strip the full ` [@off=...]` segment (marker .. closing `]` inclusive).\n      let stripped = String::concat(String::substring(msg, 0, mi), String::substring(msg, close + 1, String::length(msg)))\n      let slen = String::length(source)\n      if n >= 0 && n < slen {\n        if m > n && m <= slen {\n          String::concat(offset_line_col_range_prefix(source, n, m), stripped)\n        } else {\n          String::concat(offset_line_col_prefix(source, n), stripped)\n        }\n      } else {\n        locate_type_error_heuristic(source, stripped)\n      }\n    }\n  }\n}\n\n/// --- #906 Phase 1: module job / outcome seam ----------------------------\n///\n/// Phase 2 hands one module at a time to a worker that cannot touch the\n/// filesystem or the driver's accumulators. This splits the existing\n/// per-module work along exactly that line, with no parallelism and no\n/// change in behaviour:\n///\n///   driver  resolves dependency environments (the only Fs the work needs)\n///           and packs them into a ModuleJob value\n///   worker  check_module : ModuleJob -> ModuleOutcome, no Fs row\n///   driver  commit_module_outcome performs every write\n///\n/// check_module still carries `Error` because parse errors are not yet\n/// values -- only type errors are. Making parse diagnostics part of\n/// ModuleOutcome would change today's messages, so it is left to the phase\n/// that also introduces the canonical diagnostic ordering.\n/// ModuleJob is defined TRANSPARENTLY in this package's contract\n/// (index.vpkg), not here -- the perceus/ PerceusAction precedent. Its field\n/// layout is the worker contract itself, so it belongs in the contract\n/// rather than being an opaque handle; record literals and field access\n/// resolve from impl units against the contract definition.\nexport enum ModuleOutcome {\n  Checked(String, String, TypeEnv);\n  Diagnosed(String, Array[String])\n}\n\n/// Pure module check. No Fs: the dependency environments it needs are\n/// already values inside the job.\nexport fn check_module(job: ModuleJob) -> ModuleOutcome with { Error } {\n  // Parse stays OUTSIDE the handler below: parse errors currently\n  // propagate verbatim, while type errors get located and path-prefixed.\n  // Folding both into one handler would relabel every parse diagnostic.\n  let stmts = parse_program_with_path(job.path, job.source)\n  let import_env = build_import_env(stmts, dir_of_path(job.path), job.dep_envs)\n  // The CANONICAL fingerprint, computed the same way the serial walk\n  // computes it (build_fingerprint, same file) from the same inputs: this\n  // module's own source and each dependency's fingerprint in declaration\n  // order. A worker that invented its own cache key -- or trusted one\n  // handed to it -- could publish a checked environment that the serial\n  // driver would never look up, which would make a parallel pre-check pass\n  // silently do nothing.\n  let fingerprint = build_fingerprint(job.source, job.dep_fps)\n  handle {\n    let checked_env = match import_env {\n      EnvEmpty => check_program(stmts),\n      _ => check_program_with_env(stmts, import_env)\n    }\n    Checked(job.path, fingerprint, checked_env)\n  } with Error {\n    Throw(msg) => Diagnosed(job.path, [\n      String::concat(String::concat(job.path, \": \"), locate_type_error(job.source, msg))\n    ])\n  }\n}\n\n/// Coordinator-owned commit. Every filesystem and accumulator write for a\n/// module happens here and nowhere else.\nfn commit_module_outcome(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, job: ModuleJob, outcome: ModuleOutcome) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  match outcome {\n    // Diagnostics are values as far as the worker is concerned, but the\n    // driver still fails fast on the first one so the observable behaviour\n    // is byte-identical to the pre-Phase-1 compiler. Collecting them into\n    // a canonical set is Phase 2's job.\n    Diagnosed(_, diags) => if Array::length(diags) > 0 {\n      throw(Array::get(diags, 0))\n    } else {\n      throw(String::concat(job.path, \": type error\"))\n    },\n    Checked(path, fingerprint, checked_env) => {\n      store_persistent_type_env(fingerprint, checked_env)\n      if Array::length(job.deps) == 0 {\n        Fs::write_file(persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(job.source)), persistent_leaf_fingerprint_text(fingerprint))\n      } else {\n        ()\n      }\n      let next_env_cache = upsert_env_cache(env_cache, path, checked_env)\n      let next_db = ripple_record_eval(rdb, path, fingerprint, job.deps)\n      (fingerprint, next_db, next_env_cache, dep_source_cache, parse_count)\n    }\n  }\n}\n\n/// --- #906 Phase 2: worker entry ------------------------------------------\n///\n/// The transport boundary. A worker is handed a JOB DIRECTORY and may touch\n/// nothing else -- it is the whole preopen sandbox:\n///\n///   <dir>/job.txt      version / path / fingerprint / dep rows\n///   <dir>/source.vibe  the module source, verbatim\n///   <dir>/dep<i>.env   dependency i's serialized public environment\n///   <dir>/outcome.txt  written here: \"ok\" or \"diag\"\n///   <dir>/env.out      written here on ok: the checked environment\n///   <dir>/diag.txt     written here on diag: one diagnostic per line\n///\n/// This is what docs/compiler-parallelism.md calls the missing in-memory\n/// ModuleJob -> ModuleArtifact API. Without it a worker could only check\n/// leaf modules: the type-env cache is keyed by a fingerprint derived from\n/// the whole transitive source snapshot, which is precisely what a worker\n/// must not see, so a worker can never look its own dependencies up. Here\n/// the driver hands them over as values instead.\n///\n/// `path` in job.txt is the module's LOGICAL path, not the materialized\n/// temp file. It never gets opened -- it is the base directory that\n/// build_import_env resolves each import against, so the dep<i>.env entries\n/// bind to the same names they would in a serial compile. Getting this\n/// wrong does not fail loudly; it silently binds imports to nothing.\nfn job_dir_path(dir: String, name: String) -> String {\n  String::concat(String::concat(dir, \"/\"), name)\n}\n\n/// `dep` rows carry the dependency's path AND its already-computed\n/// fingerprint (`dep\\t<path>\\t<fingerprint>`) -- three columns, unlike every\n/// other row. There is deliberately no `fingerprint` row for the job's OWN\n/// identity: that is check_module's output (via build_fingerprint), never\n/// an input a caller could get wrong or fail to keep in sync.\nfn parse_job_rows(job_text: String) -> (String, Array[String], Array[String]) with { Error } {\n  let lines = String::split(normalize_persistent_cache_text(job_text), \"\\n\")\n  let len = Array::length(lines)\n  let deps = empty_stack()\n  let dep_fps = empty_stack()\n  let mut path = \"\"\n  let mut version_ok = false\n  let mut i = 0\n  while i < len {\n    let line = Array::get(lines, i)\n    if String::length(line) == 0 {\n      ()\n    } else {\n      let parts = String::split(line, \"\\t\")\n      let plen = Array::length(parts)\n      let key = if plen > 0 {\n        Array::get(parts, 0)\n      } else {\n        \"\"\n      }\n      if key == \"dep\" {\n        let dep_path = Array::get(parts, 1)\n        let dep_fp = Array::get(parts, 2)\n        if plen != 3 {\n          throw(String::concat(\"invalid module job dep row (want path + fingerprint): \", line))\n        } else if String::length(dep_path) == 0 || String::length(dep_fp) == 0 {\n          // Codex review (#1126): a row with an empty path or fingerprint\n          // column (e.g. a trailing tab, `dep\\t/dep.vibe\\t`) still has 3\n          // parts and would otherwise pass the column-count check above.\n          // An empty fingerprint folds into build_fingerprint the same way\n          // regardless of which dependency revision produced it, so two\n          // different revisions would silently collide on one fingerprint\n          // instead of the job being rejected as malformed.\n          throw(String::concat(\"invalid module job dep row (empty path or fingerprint): \", line))\n        } else {\n          Array::push(deps, dep_path)\n          Array::push(dep_fps, dep_fp)\n        }\n      } else if plen != 2 {\n        throw(String::concat(\"invalid module job row: \", line))\n      } else {\n        let value = Array::get(parts, 1)\n        if key == \"version\" {\n          if value == \"1\" {\n            version_ok = true\n          } else {\n            throw(String::concat(\"unsupported module job version: \", value))\n          }\n        } else if key == \"path\" {\n          path = value\n        } else {\n          throw(String::concat(\"unknown module job row: \", line))\n        }\n      }\n    }\n    i = i + 1\n  }\n  if !version_ok {\n    throw(\"module job is missing its version row\")\n  } else if String::length(path) == 0 {\n    throw(\"module job is missing its path row\")\n  } else {\n    (path, deps, dep_fps)\n  }\n}\n\nexport fn run_module_job_dir(dir: String) -> Unit with { Error, Fs } {\n  let (path, deps, dep_fps) = parse_job_rows(Fs::read_file(job_dir_path(dir, \"job.txt\")))\n  let source = Fs::read_file(job_dir_path(dir, \"source.vibe\"))\n  let dep_envs = array_empty()\n  let job_dep_fps = array_empty()\n  let mut i = 0\n  let dlen = Array::length(deps)\n  while i < dlen {\n    let dep_path = Array::get(deps, i)\n    Array::push(job_dep_fps, (dep_path, Array::get(dep_fps, i)))\n    let env_file = job_dir_path(dir, String::concat(String::concat(\"dep\", __to_string(i)), \".env\"))\n    if Fs::exists(env_file) {\n      match parse_persistent_type_env(Fs::read_file(env_file)) {\n        Some(env) => Array::push(dep_envs, (dep_path, env)),\n        // A dep<i>.env that exists but does not decode is an\n        // INFRASTRUCTURE failure, not \"no environment\". Skipping it would\n        // drop the dependency's interface and make its imports lenient\n        // again, so a truncated file would turn real type errors into a\n        // clean check -- the silent-success mode this whole transport is\n        // built to avoid. (parse_persistent_type_env returns None only for\n        // a missing version header, i.e. an empty or truncated file; a\n        // malformed row already throws.)\n        None => throw(String::concat(\"module job: unreadable dependency environment: \", env_file))\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  let job = ModuleJob::{\n    path: path,\n    source: source,\n    deps: deps,\n    dep_fps: job_dep_fps,\n    dep_envs: dep_envs\n  }\n  // Parse errors are still an `Error` out of check_module (see the Phase 1\n  // note above). At the transport boundary they have to become a value\n  // regardless -- a worker that throws is an infrastructure failure, which\n  // the coordinator treats as fatal rather than as a compiler diagnostic.\n  let outcome = handle {\n    check_module(job)\n  } with Error {\n    Throw(msg) => Diagnosed(path, [\n      msg\n    ])\n  }\n  // outcome.txt is written LAST in both arms. It is the commit marker: a\n  // coordinator that sees it knows env.out / diag.txt are already complete,\n  // so a worker killed mid-write leaves an obviously unfinished job dir\n  // rather than a plausible-looking wrong answer.\n  match outcome {\n    Checked(_, fingerprint, env) => {\n      Fs::write_file(job_dir_path(dir, \"env.out\"), persistent_type_env_cache_text(env))\n      // The module's own identity, as check_module computed it -- an\n      // OUTPUT of this job, needed by the coordinator to build the NEXT\n      // job's `dep\\t<path>\\t<fingerprint>` row for this module's\n      // dependents, and eventually to publish this environment at the\n      // real persistent-cache path a serial compile would look under.\n      Fs::write_file(job_dir_path(dir, \"fingerprint.out\"), fingerprint)\n      Fs::write_file(job_dir_path(dir, \"outcome.txt\"), \"ok\")\n    },\n    Diagnosed(_, diags) => {\n      Fs::write_file(job_dir_path(dir, \"diag.txt\"), String::join(diags, \"\\n\"))\n      Fs::write_file(job_dir_path(dir, \"outcome.txt\"), \"diag\")\n    }\n  }\n}\n\n/// #906 Phase 2 (real-build wiring): the batch publish counterpart to\n/// run_module_job_dir. `manifest.txt` holds one `<fingerprint>\\t<envfile>`\n/// row per module a host driver wants published; `<envfile>` is read\n/// relative to `dir` and written VERBATIM to the real persistent-cache path\n/// -- it is already `persistent_type_env_cache_text`-encoded, because it is\n/// literally a copy of some job dir's `env.out` (see run_module_job_dir\n/// above), so there is nothing to parse or re-encode here. Two publishers\n/// racing on the same fingerprint is a same-value collision, not a\n/// conflict: the path is content-addressed, and a checker producing two\n/// different envs for one fingerprint would already violate the\n/// jobs=1/2/4 byte-identity gate elsewhere.\nfn parse_publish_manifest_rows(text: String) -> Array[(String, String)] with { Error } {\n  let lines = String::split(normalize_persistent_cache_text(text), \"\\n\")\n  let rows = array_empty()\n  let mut i = 0\n  let len = Array::length(lines)\n  while i < len {\n    let line = Array::get(lines, i)\n    if String::length(line) == 0 {\n      ()\n    } else {\n      let parts = String::split(line, \"\\t\")\n      if Array::length(parts) != 2 {\n        throw(String::concat(\"invalid publish manifest row (want fingerprint + envfile): \", line))\n      } else {\n        let fingerprint = Array::get(parts, 0)\n        let env_file = Array::get(parts, 1)\n        if String::length(fingerprint) == 0 || String::length(env_file) == 0 {\n          throw(String::concat(\"invalid publish manifest row (empty fingerprint or envfile): \", line))\n        } else {\n          Array::push(rows, (fingerprint, env_file))\n        }\n      }\n    }\n    i = i + 1\n  }\n  rows\n}\n\nexport fn run_publish_env_cache_dir(dir: String) -> Unit with { Error, Fs } {\n  let rows = parse_publish_manifest_rows(Fs::read_file(job_dir_path(dir, \"manifest.txt\")))\n  let mut i = 0\n  let len = Array::length(rows)\n  while i < len {\n    let (fingerprint, env_file) = Array::get(rows, i)\n    let env_text = Fs::read_file(job_dir_path(dir, env_file))\n    Fs::write_file(persistent_type_env_cache_path(fingerprint), env_text)\n    i = i + 1\n  }\n}\n\n/// `fingerprint` is the already-folded build_fingerprint(source, dep_fps)\n/// every call site computed to decide whether to call this function at all\n/// (the Fs::exists / ripple_record_eval fast path below needs that folded\n/// value, not the raw pairs). `dep_fps` is the SAME per-dependency pairs\n/// that fold produced, passed through unfolded too so the ModuleJob built\n/// below carries the real inputs check_module needs to compute (and thereby\n/// cross-check) that identical fingerprint itself, the same way a worker\n/// would -- one canonical computation, not a value trusted from the caller.\nfn finish_typecheck_fs_impl(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, deps: Array[String], dep_fps: Array[(String, String)], fingerprint: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  if Fs::exists(persistent_type_env_cache_path(fingerprint)) {\n    let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\n    (fingerprint, next_db, env_cache, dep_source_cache, parse_count)\n  } else {\n    let import_env_cache = ensure_env_cache_for_paths(rdb, env_cache, deps)\n    let job = ModuleJob::{\n      path: path,\n      source: source,\n      deps: deps,\n      dep_fps: dep_fps,\n      dep_envs: import_env_cache\n    }\n    let outcome = check_module(job)\n    commit_module_outcome(rdb, import_env_cache, dep_source_cache, parse_count + 1, job, outcome)\n  }\n}\n\nfn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String) -> Array[String] {\n  // Iterative push: previously the recursive `Array::concat(acc, [x])`\n  // copied the full prefix on each new dep — O(N^2) for files with\n  // many imports.\n  let out = empty_stack()\n  let mut i = 0\n  let len = Array::length(stmts)\n  while i < len {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => if String::length(raw_path) > 0 {\n        let resolved = resolve_import_path(base_dir, raw_path)\n        if !contains_str(out, resolved) {\n          Array::push(out, resolved)\n        }\n      },\n      SReExport(raw_path, _) => if String::length(raw_path) > 0 {\n        let resolved = resolve_import_path(base_dir, raw_path)\n        if !contains_str(out, resolved) {\n          Array::push(out, resolved)\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn load_or_parse_deps_for_source_fs(dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\n  match load_persistent_dep_list(path, source) {\n    Some(deps) => (deps, upsert_string_pair(dep_source_cache, path, source), parse_count),\n    None => {\n      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\n      (deps, upsert_string_pair(dep_source_cache, path, source), next_parse_count)\n    }\n  }\n}\n\nfn resolve_deps_for_source_fs(rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n    if cached_source == source {\n      match ripple_get_deps(rdb, path) {\n        Some(deps) => (deps, dep_source_cache, parse_count),\n        None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n      }\n    } else {\n      load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n    },\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n  }\n}\n\n/// #1239 step 4(A), on the real fs path: the coordinator-side upfront pass.\n///\n/// Walks the import graph from `root` ONCE and records, per reachable module,\n/// either the persistent leaf fingerprint it found or the module's resolved\n/// dependency list. The walk that follows looks both up here instead of\n/// paying for them a second time, so this is a REPLACEMENT for work\n/// the walk used to do inline, not an extra pass.\n///\n/// The three short-circuits are the same three the walk applies, in the same\n/// order -- no source in the db (the `missing:` arm), a reusable cached\n/// fingerprint, a persistent leaf fingerprint -- and evaluating them here\n/// gives the same answers the walk gets: nothing mutates module M's db or\n/// dep-cache entries before M's own first visit, and the walk resolves each\n/// module's deps exactly once too (a module reached a second time returns on\n/// its now-cached fingerprint). The queue dedupes by path for the same reason.\n///\n/// A module left OUT of `edges` -- missing, or short-circuited -- is a leaf\n/// to plan_module_order (mo_deps_of), which is what makes those arms terminal\n/// for scheduling as well as for the walk.\nfn plan_import_graph_fs(rdb: RippleDb, dep_source_cache: Array[(String, String)], parse_count: Int, root: String) -> (Array[(String, String)], Array[(String, Array[String])], Int, Array[(String, String)]) with { Error, Fs } {\n  let leaf_fps = empty_dep_fps()\n  let plan_diags: Array[(String, String)] = [\n  ]\n  let edges: Array[(String, Array[String])] = [\n  ]\n  let seen = empty_stack()\n  let queue = empty_stack()\n  // Private copy -- see copy_string_pairs. The predicates below still read\n  // the caller's cache, because what they must reproduce is the state the\n  // walk sees on a module's FIRST visit; only the resolver gets the copy.\n  let scratch_cache = copy_string_pairs(dep_source_cache)\n  let mut pc = parse_count\n  Array::push(seen, root)\n  Array::push(queue, root)\n  let mut qi = 0\n  while qi < Array::length(queue) {\n    let path = Array::get(queue, qi)\n    qi = qi + 1\n    match ripple_get_source(rdb, path) {\n      None => (),\n      Some(source) => {\n        let reusable = if dep_source_cache_is_current(dep_source_cache, path, source) {\n          match ripple_get_fingerprint(rdb, path) {\n            Some(_) => true,\n            None => false\n          }\n        } else {\n          false\n        }\n        if reusable {\n          ()\n        } else {\n          match load_persistent_leaf_fingerprint(path, source) {\n            Some(leaf_fingerprint) => Array::push(leaf_fps, (path, leaf_fingerprint)),\n            None => {\n              // Codex review P2: resolving a module's imports PARSES it, so a\n              // syntax error raises here -- during planning, before the walk's\n              // per-step handler exists. Left alone that made parse errors\n              // fail-fast even while collecting: two malformed leaves reported\n              // one diagnostic, because planning aborted on the first.\n              //\n              // Collected the same way a step's diagnostic is, and with the\n              // same two exclusions (fail-fast mode, and `type_db:` internal\n              // invariants). A module that fails to plan gets no edge entry and\n              // no dependencies explored -- it is a leaf to the schedule, and\n              // the caller seeds it into `failed` so its importers are blocked\n              // rather than cascading.\n              let plan_raised = empty_stack()\n              let (deps_raw, _, next_pc) = handle {\n                resolve_deps_for_source_fs(rdb, scratch_cache, path, source, pc)\n              } with Error {\n                Throw(msg) => {\n                  Array::push(plan_raised, msg)\n                  (empty_stack(), scratch_cache, pc)\n                }\n              }\n              if Array::length(plan_raised) > 0 {\n                let msg = Array::get(plan_raised, 0)\n                if !collect_module_diagnostics() || String::starts_with(msg, \"type_db: \") {\n                  throw(msg)\n                } else {\n                  Array::push(plan_diags, (path, msg))\n                }\n              } else {\n                ()\n              }\n              let deps = copy_string_array(deps_raw)\n              pc = next_pc\n              if Array::length(plan_raised) > 0 {\n                ()\n              } else {\n                Array::push(edges, (path, deps))\n              }\n              let dlen = Array::length(deps)\n              let mut i = 0\n              while i < dlen {\n                let dep = Array::get(deps, i)\n                if contains_str(seen, dep) {\n                  ()\n                } else {\n                  Array::push(seen, dep)\n                  Array::push(queue, dep)\n                }\n                i = i + 1\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n  (leaf_fps, edges, pc, plan_diags)\n}\n\n/// The dep list `plan_import_graph_fs` recorded for `path`, or None when it\n/// recorded none. Returns a copy for the same reason graph.vibe's mo_deps_of\n/// does: the caller takes ownership of the list it folds fingerprints over.\nfn plan_deps_of(plan_edges: Array[(String, Array[String])], path: String) -> Option[Array[String]] {\n  let n = Array::length(plan_edges)\n  let mut i = 0\n  let mut found: Option[Array[String]] = None\n  while i < n {\n    let e = Array::get(plan_edges, i)\n    if e.0 == path {\n      found = Some(copy_string_array(e.1))\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// The leaf-fingerprint arm: a module whose persistent leaf cache is valid is\n/// recorded with no deps at all and needs no checking.\nfn commit_leaf_fingerprint_fs(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, leaf_fingerprint: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  write_persistent_dep_list_if_missing(path, source, empty_stack())\n  let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\n  let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\n  (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\n}\n\n/// One module's step, once its dependency list is known and every dependency\n/// already has a fingerprint. Folds the dependency fingerprints in\n/// DECLARATION order (build_fingerprint folds them as a sequence, not a set),\n/// then either reuses the cached fingerprint or checks and commits.\nfn commit_with_deps_fs(fps: Array[(String, String)], rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, deps: Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  write_persistent_dep_list_if_missing(path, source, deps)\n  let dlen = Array::length(deps)\n  let dep_fps = empty_dep_fps()\n  let mut i = 0\n  while i < dlen {\n    let dep_path = Array::get(deps, i)\n    match lookup_string_pair(fps, dep_path) {\n      Some(dep_fp) => Array::push(dep_fps, (dep_path, dep_fp)),\n      // Unreachable: rank order guarantees every dependency was stepped\n      // before its importer. Loud rather than folding a placeholder into the\n      // fingerprint, which would key the persistent cache on a lie.\n      None => throw(String::concat(\"type_db: dependency stepped out of rank order: \", dep_path))\n    }\n    i = i + 1\n  }\n  let fingerprint = build_fingerprint(source, dep_fps)\n  match ripple_get_fingerprint(rdb, path) {\n    Some(cached_fp) =>\n    if cached_fp == fingerprint {\n      (fingerprint, rdb, env_cache, dep_source_cache, parse_count)\n    } else {\n      finish_typecheck_fs_impl(rdb, env_cache, dep_source_cache, parse_count, path, source, deps, dep_fps, fingerprint)\n    },\n    None =>\n    finish_typecheck_fs_impl(rdb, env_cache, dep_source_cache, parse_count, path, source, deps, dep_fps, fingerprint)\n  }\n}\n\n/// True when `path`'s entry in the ripple db can be reused as-is: the source\n/// the dep cache was built from still matches the source in the db. The three\n/// arms of the old nested match collapsed to this one predicate because two\n/// of them (source changed / never seen) did exactly the same thing.\nfn dep_source_cache_is_current(dep_source_cache: Array[(String, String)], path: String, source: String) -> Bool {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) => cached_source == source,\n    None => false\n  }\n}\n\n/// One module of the schedule. The same three short-circuits the plan applied\n/// (no source in the db, a reusable cached fingerprint, a persistent leaf\n/// fingerprint), in the same order, then the dep fold.\n///\n/// This is where the walk stopped being a recursion. It reads state and hands\n/// back the next state; it never reaches into another module's step. That is\n/// the property step 4(D) needs: the old DFS threaded four state values\n/// through dependencies IN SEQUENCE (dep[1] received dep[0]'s output\n/// RippleDb), so siblings could not be dispatched independently no matter\n/// what the host could do.\nfn step_module_fs(plan_leaf_fps: Array[(String, String)], plan_edges: Array[(String, Array[String])], fps: Array[(String, String)], rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  match ripple_get_source(rdb, path) {\n    None => (String::concat(\"missing:\", path), rdb, env_cache, dep_source_cache, parse_count),\n    Some(source) => {\n      let reusable = if dep_source_cache_is_current(dep_source_cache, path, source) {\n        ripple_get_fingerprint(rdb, path)\n      } else {\n        None\n      }\n      match reusable {\n        // The fingerprint is enough for dependency fingerprint folding.\n        // Loading the env here caused shared leaf modules to re-read their\n        // persistent leaf cache every time they were reached before a parent\n        // needed their bindings.\n        Some(cached_fingerprint) => (cached_fingerprint, rdb, env_cache, dep_source_cache, parse_count),\n        None =>\n        match lookup_string_pair(plan_leaf_fps, path) {\n          Some(leaf_fingerprint) =>\n          commit_leaf_fingerprint_fs(rdb, env_cache, dep_source_cache, parse_count, path, source, leaf_fingerprint),\n          None =>\n          match plan_deps_of(plan_edges, path) {\n            Some(planned_deps) =>\n            commit_with_deps_fs(fps, rdb, env_cache, upsert_string_pair(dep_source_cache, path, source), parse_count, path, source, planned_deps),\n            // Unreachable: every path in the schedule was either given an\n            // edge entry by the plan or interned as some planned module's\n            // dependency, and the three short-circuits above are the plan's\n            // own. A module that reaches here has no dependency fingerprints\n            // to fold, so there is nothing to fall back TO now that the walk\n            // does not recurse -- say so instead of inventing one.\n            None => throw(String::concat(\"type_db: module missing from the import plan: \", path))\n          }\n        }\n      }\n    }\n  }\n}\n\n/// Index of `p` in `items`, or -1. Plain linear scan: the caller runs it once\n/// per module over a list of the same length, and a project the size of this\n/// compiler's own manifest is ~209 modules.\nfn module_plan_index_of(items: Array[String], p: String) -> Int {\n  let n = Array::length(items)\n  let mut i = 0\n  let mut found = 0 - 1\n  while found < 0 && i < n {\n    if Array::get(items, i) == p {\n      found = i\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// #1239 step 4(D) groundwork: discover a project's WHOLE import graph, and\n/// its canonical schedule, inside one compiler process.\n///\n/// VIBE_LIST_DEPS answers \"what does this ONE file import\", so a host driver\n/// building the parallel pre-warm's DAG has to spawn it once per module --\n/// and on a project the size of this compiler's own manifest that discovery\n/// loop is what dominates the whole parallel path's wall time, independent of\n/// how many jobs the later check phase gets (#1168, see discoverProject in\n/// scripts/parallel_frontend_warm.mjs). This does the same BFS in-process.\n///\n/// The order comes from @vibe/graph's plan_module_order -- the same function\n/// the serial walk's own upfront plan uses since #1239 step 4(A)\n/// (runtime/typecheck_fs.vibe) -- so the host dispatches the schedule the\n/// compiler itself planned instead of one it re-derived, and an import cycle\n/// is rejected here with the identical diagnostic rather than surfacing later\n/// as a driver that never makes progress.\n///\n/// Returns the manifest text plus, positionally, each module's INGESTED\n/// source: `ingest_source_text_fs` can prepend a directory-shared import a\n/// raw .vibe file never had, or rewrite a contract into its facade entirely,\n/// and check_module parses that text -- never the raw bytes. Deriving deps\n/// from one and handing back the other is #1168's exact bug, so both come\n/// off the same `ingested` string here.\nexport fn module_plan_manifest_fs(entry_path: String) -> (String, Array[String]) with { Error, Fs } {\n  // `paths` doubles as the BFS queue: discovery pushes to it, `qi` walks it.\n  let paths: Array[String] = [\n  ]\n  let deps_of: Array[Array[String]] = [\n  ]\n  let sources: Array[String] = [\n  ]\n  Array::push(paths, entry_path)\n  let mut qi = 0\n  while qi < Array::length(paths) {\n    let p = Array::get(paths, qi)\n    qi = qi + 1\n    if !Fs::exists(p) {\n      throw(String::concat(\"module plan: cannot read module: \", p))\n    } else {\n      ()\n    }\n    let ingested = ingest_source_text_fs(p, Fs::read_file(p))\n    let (deps, _exports, _parse_count) = load_or_parse_module_header_fs(p, ingested, 0)\n    Array::push(sources, ingested)\n    Array::push(deps_of, deps)\n    let dlen = Array::length(deps)\n    let mut i = 0\n    while i < dlen {\n      let d = Array::get(deps, i)\n      if module_plan_index_of(paths, d) >= 0 {\n        ()\n      } else {\n        Array::push(paths, d)\n      }\n      i = i + 1\n    }\n  }\n  let edges: Array[(String, Array[String])] = [\n  ]\n  let mut e = 0\n  while e < Array::length(paths) {\n    Array::push(edges, (Array::get(paths, e), Array::get(deps_of, e)))\n    e = e + 1\n  }\n  let (order, ranks) = plan_module_order(edges, entry_path)\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, \"version\\t1\\n\")\n  let ordered_sources: Array[String] = [\n  ]\n  let n = Array::length(order)\n  let mut k = 0\n  while k < n {\n    let p = Array::get(order, k)\n    let src_index = module_plan_index_of(paths, p)\n    let index_text = __to_string(k)\n    StringBuilder::push(buf, \"module\\t\")\n    StringBuilder::push(buf, index_text)\n    StringBuilder::push(buf, \"\\t\")\n    StringBuilder::push(buf, __to_string(Array::get(ranks, k)))\n    StringBuilder::push(buf, \"\\t\")\n    StringBuilder::push(buf, p)\n    StringBuilder::push(buf, \"\\n\")\n    Array::push(ordered_sources, Array::get(sources, src_index))\n    // Declaration order, duplicates KEPT: the driver derives both its\n    // deduped dependency set and its dependencyOccurrences list from this,\n    // exactly as it does from VIBE_LIST_DEPS's output today.\n    let deps = Array::get(deps_of, src_index)\n    let dlen = Array::length(deps)\n    let mut i = 0\n    while i < dlen {\n      StringBuilder::push(buf, \"dep\\t\")\n      StringBuilder::push(buf, index_text)\n      StringBuilder::push(buf, \"\\t\")\n      StringBuilder::push(buf, Array::get(deps, i))\n      StringBuilder::push(buf, \"\\n\")\n      i = i + 1\n    }\n    k = k + 1\n  }\n  (StringBuilder::freeze(buf), ordered_sources)\n}\n\n/// True when one of `path`'s planned dependencies is in `failed` -- i.e. was\n/// itself diagnosed, or was blocked by this same rule.\n///\n/// A blocked module cannot be checked at all: its dependency has no\n/// fingerprint to fold into its cache key and no environment to import. It\n/// therefore contributes NO diagnostic of its own. Reporting one would be a\n/// cascade -- \"unknown binding x\", once per importer -- which is precisely the\n/// noise a canonical diagnostic set exists to be free of.\n///\n/// Transitivity comes from the wave order: blocked modules are pushed onto\n/// `failed` too, and every dependency of a module was stepped in a strictly\n/// earlier wave, so `failed` is already complete for `path` when this runs.\nfn module_is_blocked(plan_edges: Array[(String, Array[String])], failed: Array[String], path: String) -> Bool {\n  if Array::length(failed) == 0 {\n    false\n  } else {\n    match plan_deps_of(plan_edges, path) {\n      // No edge entry means the plan short-circuited this module (missing\n      // source, reusable fingerprint, persistent leaf cache) -- it has no\n      // dependencies to be blocked by.\n      None => false,\n      Some(deps) => {\n        let n = Array::length(deps)\n        let mut i = 0\n        let mut blocked = false\n        while i < n && !blocked {\n          if contains_str(failed, Array::get(deps, i)) {\n            blocked = true\n          } else {\n            i = i + 1\n          }\n        }\n        blocked\n      }\n    }\n  }\n}\n\n/// Canonical order for two collected diagnostics: normalized module path\n/// first, then the message.\n///\n/// #1239 step 5 specifies path -> source start/end -> diagnostic code ->\n/// message. Only the first and last of those exist today: check_module emits\n/// AT MOST ONE diagnostic per module (its Diagnosed arm builds a one-element\n/// array), so within a path there is nothing to break ties between, and there\n/// are no diagnostic codes yet. The message tiebreak is here anyway to keep\n/// the order TOTAL, so the day a worker returns several diagnostics for one\n/// module they sort deterministically instead of silently inheriting\n/// collection order.\n///\n/// str_lt, not `<`: canonical ordering must be true lexicographic. The builtin\n/// compares length first, which would make the order depend on path length\n/// (CLAUDE.md documents that footgun; @vibe/graph's plan_module_order avoids\n/// it the same way).\nfn module_diag_lt(a: (String, String), b: (String, String)) -> Bool {\n  if a.0 == b.0 {\n    str_lt(a.1, b.1)\n  } else {\n    str_lt(a.0, b.0)\n  }\n}\n\n/// Insertion sort into canonical order. One diagnostic per failing module, and\n/// a build with enough failing modules for O(N^2) to matter has bigger\n/// problems than the sort.\nfn sort_module_diagnostics(diags: Array[(String, String)]) -> Array[(String, String)] {\n  let out: Array[(String, String)] = [\n  ]\n  let n = Array::length(diags)\n  let mut i = 0\n  while i < n {\n    let entry = Array::get(diags, i)\n    Array::push(out, entry)\n    let mut j = Array::length(out) - 1\n    while j > 0 && module_diag_lt(entry, Array::get(out, j - 1)) {\n      Array::set(out, j, Array::get(out, j - 1))\n      Array::set(out, j - 1, entry)\n      j = j - 1\n    }\n    i = i + 1\n  }\n  out\n}\n\n/// The collected set as one error string: canonical order, exact duplicates\n/// dropped, one diagnostic per line. A single collected diagnostic is\n/// therefore byte-identical to what the fail-fast walk would have thrown --\n/// which is what makes collection mode a superset of the default rather than\n/// a different output format.\n/// The `project` half of a scheduler trace: one row per planned module, with\n/// its rank and its dependency list. This IS Scheduler.lean's `Project` --\n/// `dependencies` and `rank` -- serialized, so the oracle can check\n/// `dependencyRankLt` against the same graph the walk actually stepped rather\n/// than against one it re-derived.\nfn scheduler_trace_project(buf: StringBuilder, order: Array[String], ranks: Array[Int], plan_edges: Array[(String, Array[String])]) -> Unit {\n  let n = Array::length(order)\n  let mut i = 0\n  while i < n {\n    let p = Array::get(order, i)\n    StringBuilder::push(buf, \"project\\t\")\n    StringBuilder::push(buf, p)\n    StringBuilder::push(buf, \"\\t\")\n    StringBuilder::push(buf, __to_string(Array::get(ranks, i)))\n    // A module the plan short-circuited (missing source, reusable\n    // fingerprint, persistent leaf cache) has no edge entry and so no\n    // dependencies -- which is exactly what it is to the scheduler: a leaf\n    // that is Ready from the start.\n    match plan_deps_of(plan_edges, p) {\n      None => (),\n      Some(deps) => {\n        let dlen = Array::length(deps)\n        let mut d = 0\n        while d < dlen {\n          StringBuilder::push(buf, \"\\t\")\n          StringBuilder::push(buf, Array::get(deps, d))\n          d = d + 1\n        }\n      }\n    }\n    StringBuilder::push(buf, \"\\n\")\n    i = i + 1\n  }\n}\n\nfn join_module_diagnostics(diags: Array[(String, String)]) -> String {\n  let sorted = sort_module_diagnostics(diags)\n  let msgs = array_empty()\n  let n = Array::length(sorted)\n  let mut i = 0\n  while i < n {\n    let entry = Array::get(sorted, i)\n    Array::push(msgs, entry.1)\n    i = i + 1\n  }\n  String::join(dedupe_diagnostics(msgs), \"\\n\")\n}\n\n/// The import-DAG walk, as the wave loop a coordinator dispatches from\n/// (#1239 step 4(D)).\n///\n/// plan_import_graph_fs resolves the graph and plan_module_order ranks it\n/// (step 4(A), both already in place); this consumes that order instead of\n/// re-deriving one by recursive descent. Every module of rank k depends only\n/// on modules of rank < k, so a rank is a WAVE: its modules are independent\n/// of each other by construction, and each one's dependency fingerprints are\n/// already recorded by the time the wave runs.\n///\n/// What that buys, beyond the recursion going away (this compiler has\n/// exhausted the wasm stack on a recursive whole-program walk before -- see\n/// analyze_calls's #556 note in perceus/perceus.vibe): the remaining step\n/// 4(D) blocker is gone. Dispatching a wave out-of-process is now a change to\n/// the inner loop, not a restructuring of the walk.\n///\n/// #1259: the wave loop is also where diagnostics are COLLECTED rather than\n/// fired off one at a time. A wave's modules are independent by construction,\n/// so one of them being diagnosed says nothing about its siblings -- they\n/// still have every input they need. Collection therefore falls out of the\n/// wave structure: diagnose, mark the module failed, keep stepping the rest of\n/// the wave, and skip only the modules that actually depend on a failure. See\n/// collect_module_diagnostics (off by default).\n///\n/// dep_visit_order (the #906 Phase 0 nondeterminism probe, seeded by\n/// VIBE_DEP_ORDER_SEED) now permutes the order WITHIN a wave rather than a\n/// node's dependency visit order. That is the stronger property and the one\n/// that matters: it is exactly the choice a parallel coordinator makes\n/// differently from run to run, and scripts/dep_order_oracle.sh asserts the\n/// compiled output is byte-identical across seeds regardless.\nexport fn ensure_fingerprint_fs_impl(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  let (plan_leaf_fps, plan_edges, planned_parse_count, plan_diags) = plan_import_graph_fs(rdb, dep_source_cache, parse_count, path)\n  // #1239 step 4(A): an import cycle is rejected HERE -- before a single\n  // module is checked, committed, or written to the persistent cache --\n  // instead of incidentally, partway through the walk, on whichever module a\n  // DFS happened to re-enter first.\n  let (order, ranks) = plan_module_order(plan_edges, path)\n  let fps = empty_dep_fps()\n  let mut db = rdb\n  let mut envc = env_cache\n  let mut dsc = dep_source_cache\n  let mut pc = planned_parse_count\n  // #1259: empty unless collection is on, in which case `failed` holds every\n  // module that was diagnosed OR blocked by one, and `diags` the (path,\n  // message) pairs to sort at the end.\n  let failed = empty_stack()\n  let diags: Array[(String, String)] = [\n  ]\n  // A module that failed to PLAN (a syntax error in its own source -- see\n  // plan_import_graph_fs) is already terminal: it has no dependency list, so\n  // it is a leaf to the schedule and nothing about it can be checked. Seed it\n  // as failed before the loop so the wave skips it and module_is_blocked\n  // catches its importers. Always empty when collection is off, since planning\n  // rethrows in that mode.\n  let mut pdi = 0\n  while pdi < Array::length(plan_diags) {\n    let entry = Array::get(plan_diags, pdi)\n    Array::push(failed, entry.0)\n    Array::push(diags, entry)\n    pdi = pdi + 1\n  }\n  // #1259 (#1239 step 8): the scheduler trace. Off unless\n  // VIBE_SCHEDULER_TRACE named a file.\n  let trace_path = scheduler_trace_path()\n  let tracing = String::length(trace_path) > 0\n  let trace = StringBuilder::new()\n  if tracing {\n    scheduler_trace_project(trace, order, ranks, plan_edges)\n  } else {\n    ()\n  }\n  let n = Array::length(order)\n  let mut i = 0\n  while i < n {\n    // `order` is sorted by rank, so one wave is a contiguous run.\n    let r = Array::get(ranks, i)\n    let mut j = i\n    while j < n && Array::get(ranks, j) == r {\n      j = j + 1\n    }\n    let wave = j - i\n    let visit = dep_visit_order(wave)\n    let mut k = 0\n    while k < wave {\n      let m = Array::get(order, i + Array::get(visit, k))\n      // `contains_str(failed, m)` first: a module that failed to plan is\n      // already in `failed` and has no edge entry, so module_is_blocked alone\n      // would let it through to a step that cannot succeed.\n      if contains_str(failed, m) || module_is_blocked(plan_edges, failed, m) {\n        Array::push(failed, m)\n      } else {\n        // Snapshots of the accumulators as of ENTRY to this module's step.\n        // The handler needs values it can close over, and they are also the\n        // right state to carry forward when the step raises: a module that\n        // does not check commits nothing.\n        let cur_db = db\n        let cur_envc = envc\n        let cur_dsc = dsc\n        let cur_pc = pc\n        let raised = empty_stack()\n        let (fp, next_db, next_envc, next_dsc, next_pc) = handle {\n          step_module_fs(plan_leaf_fps, plan_edges, fps, cur_db, cur_envc, cur_dsc, cur_pc, m)\n        } with Error {\n          Throw(msg) => {\n            Array::push(raised, msg)\n            (String::concat(\"diagnosed:\", m), cur_db, cur_envc, cur_dsc, cur_pc)\n          }\n        }\n        if Array::length(raised) > 0 {\n          let msg = Array::get(raised, 0)\n          // Re-raised OUTSIDE the handler, so this is ordinary propagation\n          // and not a throw from within a handler body. Two cases never\n          // become collected diagnostics:\n          //\n          //   - fail-fast mode, the default: identical message, identical\n          //     partial state, raised one frame later than before\n          //   - an internal invariant violation (the `type_db:` prefix, the\n          //     two unreachable arms in step_module_fs / commit_with_deps_fs)\n          //     -- infrastructure failure, not something the user's program\n          //     said, so it must stay fatal even while collecting\n          if !collect_module_diagnostics() || String::starts_with(msg, \"type_db: \") {\n            throw(msg)\n          } else {\n            Array::push(failed, m)\n            Array::push(diags, (m, msg))\n          }\n        } else {\n          db = next_db\n          envc = next_envc\n          dsc = next_dsc\n          pc = next_pc\n          Array::push(fps, (m, fp))\n          // One Step.run, recorded where the result is PUBLISHED -- the same\n          // point `BuildState.finish` sits at in the model. Recording it\n          // before the step would let a trace claim a module completed that\n          // then raised.\n          //\n          // Codex review P1: the fingerprint alone is NOT the JobResult. It is\n          // build_fingerprint(source, dep_fps) -- a pure function of the source\n          // graph, computed before the module is even checked -- so comparing\n          // fingerprints across schedules compares content-addressed cache KEYS\n          // that are schedule-independent by construction, and StoreCorrect\n          // would have held even if two schedules produced different TypeEnvs.\n          // The env hash is what makes that comparison mean anything: it is the\n          // checked environment the module actually published, serialized the\n          // same way commit_module_outcome writes it to the persistent cache.\n          //\n          // \"-\" is for the arms that publish no environment (a reusable cached\n          // fingerprint, or a persistent leaf-fingerprint hit). Both are cache\n          // hits, so on the cold cache dir the oracle uses they should be rare\n          // -- scheduler_trace_oracle.sh fails if too many steps carry \"-\",\n          // since a trace of all-\"-\" would be back to comparing keys.\n          if tracing {\n            let env_hash = match lookup_env_cache(next_envc, m) {\n              Some(env) => compact_string_fingerprint(persistent_type_env_cache_text(env)),\n              None => \"-\"\n            }\n            StringBuilder::push(trace, \"step\\t\")\n            StringBuilder::push(trace, m)\n            StringBuilder::push(trace, \"\\t\")\n            StringBuilder::push(trace, fp)\n            StringBuilder::push(trace, \"\\t\")\n            StringBuilder::push(trace, env_hash)\n            StringBuilder::push(trace, \"\\n\")\n          } else {\n            ()\n          }\n        }\n      }\n      k = k + 1\n    }\n    i = j\n  }\n  if tracing {\n    Fs::write_file(trace_path, StringBuilder::freeze(trace))\n  } else {\n    ()\n  }\n  // Before the root lookup: with the root itself diagnosed or blocked there is\n  // no fingerprint and no environment for it, and reporting \"missing:\" for a\n  // module whose real problem is a type error two levels down would bury the\n  // diagnostics this whole pass exists to produce.\n  if Array::length(diags) > 0 {\n    throw(join_module_diagnostics(diags))\n  } else {\n    ()\n  }\n  let root_fingerprint = match lookup_string_pair(fps, path) {\n    Some(f) => f,\n    // The root is always interned by plan_module_order, so it is always\n    // stepped; this is the empty-graph shape rather than a miss.\n    None => String::concat(\"missing:\", path)\n  }\n  let final_env_cache = ensure_env_cache_for_path(db, envc, path)\n  (root_fingerprint, db, final_env_cache, dsc, pc)\n}\n\n/// #946: drop exact duplicates from a diagnostics list, preserving first-seen\n/// order. Each entry already embeds its location (\"line L:C: msg\"), so string\n/// equality IS (position, message) identity. O(N^2) — diagnostic lists are tiny.\nfn dedupe_diagnostics(diags: Array[String]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(diags) {\n    let d = Array::get(diags, i)\n    if contains_str(out, d) {\n      ()\n    } else {\n      Array::push(out, d)\n    }\n    i = i + 1\n  }\n  out\n}\n\n/// #946(4): find every top-level `fn f(..) -> Int = wasm \"<WAT>\"` definition\n/// (parsed as `SLet(_, _, name, _, EFn(_, _, params, _, _, ECall(EIdent(\"%wasm\",\n/// _), [EString(wat)], _)))` — see lc_extract_inline_wasm in\n/// codegen/wasi/linked_compile.vibe, whose extraction pattern this mirrors\n/// read-only (no mutation: diagnostics discards `stmts` after this scan, and\n/// running it before codegen would blow away the marker codegen depends on).\n/// Returns (fn_name, wat_text, param_names) triples in declaration order.\nfn collect_inline_wasm_fns(stmts: Array[Stmt]) -> Array[(String, String, Array[String])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, iw_name, _, iw_expr) => match iw_expr {\n        EFn(_, _, iw_params, _, _, iw_body) => match iw_body {\n          ECall(iw_cal, iw_args, _) => match iw_cal {\n            EIdent(iw_cn, _) => if iw_cn == \"%wasm\" && Array::length(iw_args) == 1 {\n              match Array::get(iw_args, 0) {\n                EString(iw_wat) => {\n                  let pnames = array_empty()\n                  let mut pi = 0\n                  while pi < Array::length(iw_params) {\n                    let (pn, _) = Array::get(iw_params, pi)\n                    Array::push(pnames, pn)\n                    pi = pi + 1\n                  }\n                  Array::push(out, (iw_name, iw_wat, pnames))\n                },\n                _ => ()\n              }\n            } else {\n              ()\n            },\n            _ => ()\n          },\n          _ => ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n/// #946(4): validate every inline-wasm fn body (compile_inline_wat — the same\n/// assembler codegen uses) and return the FIRST located error, or None when\n/// every inline-wasm fn assembles cleanly. `compile` surfaced these (e.g. a bad\n/// SIMD lane index) as a located error while `vibe diagnostics` reported clean\n/// — diagnostics only ran the typechecker, never this codegen-adjacent\n/// validation. Stops at the first error (matches collect_all_diagnostics'\n/// existing \"one located type error\" granularity below).\nexport fn check_inline_wasm_fns(stmts: Array[Stmt]) -> Option[String] {\n  let fns = collect_inline_wasm_fns(stmts)\n  let n = Array::length(fns)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= n {\n      done = true\n    } else {\n      let (fn_name, wat, pnames) = Array::get(fns, i)\n      let outcome = handle {\n        let _ = compile_inline_wat(fn_name, wat, pnames)\n        None\n      } with Error {\n        Throw(msg) => Some(msg)\n      }\n      match outcome {\n        Some(msg) => {\n          result = Some(msg)\n          done = true\n        },\n        None => {\n          i = i + 1\n        }\n      }\n    }\n  }\n  result\n}\n\n/// Collect ALL diagnostics for `source` as located (`line:col`) message strings.\n/// Lexer errors come first (#946): the recovering lexer records every offending\n/// position instead of throwing, so a lex-broken file reports located lexer\n/// diagnostics rather than an empty (\"clean\") result. Only when the lex is clean\n/// does the recovering parser gather every top-level syntax error; only if the\n/// parse is also clean does it run the type checker and report the (single,\n/// located) type error. Identical (position, message) pairs are deduped.\n/// Returns [] when the source lexes, parses, and checks cleanly.\n/// Foundation for `vibe check` / LSP multi-diagnostic reporting.\nexport fn collect_all_diagnostics(source: String) -> Array[String] with { Error } {\n  let (tokens, starts, _ends, lex_err_offsets, lex_err_msgs) = lex_with_offsets_recovering(source)\n  if Array::length(lex_err_msgs) > 0 {\n    // Report ONLY the lexer errors: the recovered token stream has holes, so\n    // parse/type diagnostics on it would be follow-on noise.\n    //\n    // #997 review (Codex): a handful of lexer throw sites (the `\\(expr)`\n    // interpolation-removal message, and #997's own scientific-notation /\n    // incomplete-exponent messages) embed their OWN precise `line L:C: `\n    // prefix directly in the message, because `lex_err_offsets` here always\n    // records the START offset of the enclosing `lex_one_token` call --\n    // wrong for a throw raised partway through a multi-char token (at the\n    // `e`/`E`, not the token's first digit). Blindly prepending the generic\n    // outer `loc` on top of an already-self-located message produced a\n    // doubled/conflicting location (`line 1:9: line 1:18: ...`, confirmed\n    // empirically via `vibe diagnostics` on `123456789e10`). Skip the outer\n    // prefix for messages that already start with \"line \" -- they're\n    // self-located and the outer offset would only be redundant or wrong.\n    //\n    // This also incidentally collapses a separate pre-existing duplication:\n    // a non-quote-delimited lex error (anything but a broken string/char\n    // literal) resumes ONE character past the failure and retries, so a\n    // multi-digit scientific-notation literal re-throws the SAME underlying\n    // error once per remaining digit (9 identical reports for\n    // `123456789e10`) -- previously each got a DIFFERENT (wrong) outer\n    // offset, defeating `dedupe_diagnostics`'s exact-string dedup below.\n    // With the outer prefix suppressed, all 9 become byte-identical and\n    // collapse to the single correctly-located report.\n    let located = array_empty()\n    let mut i = 0\n    while i < Array::length(lex_err_msgs) {\n      let msg = Array::get(lex_err_msgs, i)\n      let entry = if String::starts_with(msg, \"line \") {\n        msg\n      } else {\n        let off = Array::get(lex_err_offsets, i)\n        let (line, col) = offset_to_line_col(source, off)\n        let loc = String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n        String::concat(loc, msg)\n      }\n      Array::push(located, entry)\n      i = i + 1\n    }\n    dedupe_diagnostics(located)\n  } else {\n    let (stmts, parse_diags) = parse_program_recovering(tokens, starts, source)\n    if Array::length(parse_diags) > 0 {\n      dedupe_diagnostics(parse_diags)\n    } else {\n      handle {\n        let _env = check_program(stmts)\n        // #946(4): the type checker never touches inline-wasm bodies (they're\n        // opaque `%wasm(...)` marker calls until codegen extracts them — see\n        // collect_inline_wasm_fns above), so a clean typecheck says nothing\n        // about whether e.g. a SIMD lane index is in range. Run that codegen-\n        // adjacent validation here too so `compile`'s located inline-wasm\n        // errors aren't invisible to diagnostics.\n        match check_inline_wasm_fns(stmts) {\n          Some(msg) => [\n            locate_type_error(source, msg)\n          ],\n          None => {\n            // #1129 + companion \"unbound non-Unit return value\" request:\n            // both are warning-level (never affect exit status -- `vibe\n            // diagnostics` \"is a report, not a failure\", see cli_adapter.vibe),\n            // only surfaced once the program is already known to type-check\n            // and codegen-validate cleanly.\n            let extra = array_empty()\n            let import_warns = detect_unused_imports(stmts)\n            let mut wi = 0\n            while wi < Array::length(import_warns) {\n              let (_, _, wmsg) = Array::get(import_warns, wi)\n              Array::push(extra, locate_type_error(source, String::concat(\"warning: \", wmsg)))\n              wi = wi + 1\n            }\n            let (warn_tytab, warn_subst) = check_program_type_table(stmts)\n            let return_warns = detect_unbound_nonunit_returns(stmts, warn_tytab, warn_subst)\n            let mut ri = 0\n            while ri < Array::length(return_warns) {\n              Array::push(extra, locate_type_error(source, String::concat(\"warning: \", Array::get(return_warns, ri))))\n              ri = ri + 1\n            }\n            extra\n          }\n        }\n      } with Error {\n        Throw(msg) => [\n          locate_type_error(source, msg)\n        ]\n      }\n    }\n  }\n}\n")
}

let cli_adapter_source_163 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/type_at.vibe",
"//# Imports\n\n// `vibe type-at` — first typed-hover (LSP) consumer of the real EIdent source\n// offsets. Given a (line, col), locate the identifier node whose source span\n// covers that position, typecheck the program, and return the inferred type of\n// that name via env_lookup + type_to_string.\n//\n// MVP scope / LIMITATION: only env-visible names resolve — top-level bindings\n// and imported names that the checker records in the returned TypeEnv. Locals\n// and function parameters are NOT in that env (they live in nested scopes during\n// inference and are gone by the time check_program returns), so hovering one\n// yields \"\". A future per-node type table would lift this restriction.\n//\n// All strings are built with String::concat only (never `+`, never \"\\{x}\"\n// interpolation): both mis-codegen to NUL here. Ints stringify via\n// __to_string.\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, Subst, Type, TypeEnv, env_lookup, subst_apply, type_to_string\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/checker {\n  check_program, check_program_type_table\n}\n\nimport @vibe/compiler/syntax {\n  lex_with_offsets, offset_to_line_col, parse_program_located, parse_program_spans\n}\n\n//# Functions\n\n/// 1-based (line, col) -> 0-based char offset, the inverse of offset_to_line_col.\n/// `col` is the position WITHIN a line (col 1 = first char of the line, col\n/// length+1 = just past the last char — a valid cursor position). We count\n/// newlines: the offset of the start of line L is just past the (L-1)th\n/// newline, then add (col - 1).\n///\n/// Returns -1 (invalid / no position) for anything out of range, rather than\n/// silently clamping (#947):\n///   - `line < 1` or `col < 1`: never valid (1-based).\n///   - `line` beyond the last line in `source`.\n///   - `col` past the END of that line's content — previously this fell\n///     through to `linestart + col - 1` unclamped, which for a large enough\n///     `col` landed on/inside the NEXT line (a col-past-EOL query silently\n///     resolved to an unrelated identifier a line down).\n/// CRLF (#947): a line's addressable content excludes a trailing '\\r' before\n/// the '\\n' — otherwise every query position (and reported span) on a CRLF\n/// file drifts by one byte per preceding CRLF line, since the line's `\\r` was\n/// being counted as ordinary content here but not consistently elsewhere.\nfn line_col_to_offset(source: String, line: Int, col: Int) -> Int {\n  if line < 1 || col < 1 {\n    -1\n  } else {\n    let len = String::length(source)\n    let mut i = 0\n    let mut cur_line = 1\n    // Advance to the first char of the target line.\n    while cur_line < line && i < len {\n      if String::char_code_at(source, i) == 10 {\n        cur_line = cur_line + 1\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    if cur_line < line {\n      // `line` is past the last line in `source`.\n      -1\n    } else {\n      // i is the start of line `line`. Find the end of its content: the\n      // offset of the terminating '\\n' (or `len` for the final line), then\n      // exclude a preceding '\\r' (CRLF) so it isn't counted as content.\n      let mut line_end = i\n      while line_end < len && String::char_code_at(source, line_end) != 10 {\n        line_end = line_end + 1\n      }\n      let content_end = if line_end > i && String::char_code_at(source, line_end - 1) == 13 {\n        line_end - 1\n      } else {\n        line_end\n      }\n      let off = i + (col - 1)\n      if off > content_end {\n        -1\n      } else {\n        off\n      }\n    }\n  }\n}\n\n/// A located EIdent hit: name + source span [off, off + length(name)). `off` is\n/// -1 for synthetic / non-located idents (those are ignored by the search).\nenum IdentHit {\n  IdentHit(String, Int)\n}\n\nfn empty_hits() -> Array[IdentHit] {\n  array_empty()\n}\n\n/// Read-only walker over the Expr structure (templated on normalize/index.vibe's\n/// `fold_expr`, but it only COLLECTS located EIdent nodes — it never rebuilds the\n/// tree). Every variant is enumerated so a new Expr arm is a compile error here,\n/// keeping the collector in sync with the AST.\nfn collect_expr(expr: Expr, acc: Array[IdentHit]) -> Unit {\n  match expr {\n    EInt(_) => (),\n    EFloat(_) => (),\n    EString(_) => (),\n    EBool(_) => (),\n    EIdent(name, off) => {\n      if off >= 0 {\n        Array::push(acc, IdentHit(name, off))\n      } else {\n        ()\n      }\n    },\n    EUnit => (),\n    EStringInterp(_) => (),\n    ETuple(items) => collect_exprs(items, acc),\n    EArray(items) => collect_exprs(items, acc),\n    ERecord(_, fields, _) => collect_field_exprs(fields, acc),\n    EIf(c, t, e) => {\n      collect_expr(c, acc)\n      collect_expr(t, acc)\n      collect_expr(e, acc)\n    },\n    ELet(_, v, b, _) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    ELetRec(_, v, b) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    ELetMut(_, v, b, _) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    EAssign(_, v, b) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    EAssignOp(_, _, v, b) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    ESeq(a, b) => {\n      collect_expr(a, acc)\n      collect_expr(b, acc)\n    },\n    EMatch(s, arms) => {\n      collect_expr(s, acc)\n      collect_arm_exprs(arms, acc)\n    },\n    EHandle(s, arms) => {\n      collect_expr(s, acc)\n      collect_arm_exprs(arms, acc)\n    },\n    EWhile(c, b) => {\n      collect_expr(c, acc)\n      collect_expr(b, acc)\n    },\n    ELoop(params, b) => {\n      collect_loop_param_exprs(params, acc)\n      collect_expr(b, acc)\n    },\n    EForIn(_, _, it, b) => {\n      collect_expr(it, acc)\n      collect_expr(b, acc)\n    },\n    ECall(callee, args, _) => {\n      collect_expr(callee, acc)\n      collect_exprs(args, acc)\n    },\n    EBinOp(_, l, r) => {\n      collect_expr(l, acc)\n      collect_expr(r, acc)\n    },\n    EUnaryOp(_, e) => collect_expr(e, acc),\n    EFn(_, _, _, _, _, body) => collect_expr(body, acc),\n    EDot(e, field, _, field_off) => {\n      // #645: the field name is hoverable — EDot carries the field token's\n      // offset, and the checker records the projection type at that offset.\n      if field_off >= 0 {\n        Array::push(acc, IdentHit(field, field_off))\n      } else {\n        ()\n      }\n      collect_expr(e, acc)\n    },\n    ELabeledArg(_, _, v) => collect_expr(v, acc),\n    EReturn(e) => collect_expr(e, acc),\n    EBreak(opt) => match opt {\n      Some(v) => collect_expr(v, acc),\n      None => ()\n    },\n    EContinue(args) => collect_exprs(args, acc),\n    EMap(fields) => collect_field_exprs(fields, acc),\n    ESpread(e) => collect_expr(e, acc)\n  }\n}\n\nfn collect_exprs(items: Array[Expr], acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(items) {\n    collect_expr(Array::get(items, i), acc)\n    i = i + 1\n  }\n}\n\nfn collect_field_exprs(fields: Array[(String, Expr)], acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    collect_expr(v, acc)\n    i = i + 1\n  }\n}\n\nfn collect_arm_exprs(arms: Array[(Pat, Expr)], acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, e) = Array::get(arms, i)\n    collect_expr(e, acc)\n    i = i + 1\n  }\n}\n\nfn collect_loop_param_exprs(params: Array[(String, Expr)], acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(params) {\n    let (_, init) = Array::get(params, i)\n    collect_expr(init, acc)\n    i = i + 1\n  }\n}\n\nfn collect_stmt(stmt: Stmt, acc: Array[IdentHit]) -> Unit {\n  match stmt {\n    SLet(_, _, _, _, body) => collect_expr(body, acc),\n    SLetMut(_, _, body) => collect_expr(body, acc),\n    STest(_, body) => collect_expr(body, acc),\n    SBench(_, body) => collect_expr(body, acc),\n    SExpr(e) => collect_expr(e, acc),\n    SLetPat(_, body) => collect_expr(body, acc),\n    SModule(_, _, body) => collect_stmts(body, acc),\n    _ => ()\n  }\n}\n\nfn collect_stmts(stmts: Array[Stmt], acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    collect_stmt(Array::get(stmts, i), acc)\n    i = i + 1\n  }\n}\n\n/// True when `source[off]` is NOT an identifier char (or off is out of range) —\n/// i.e. a valid word boundary. Used to match a binding name as a whole word.\nfn is_boundary_at(source: String, off: Int) -> Bool {\n  if off < 0 || off >= String::length(source) {\n    true\n  } else {\n    let c = String::char_code_at(source, off)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    !is_id\n  }\n}\n\n/// Find the first whole-word occurrence of `name` in `source[start..end)` and, if\n/// found, push a located IdentHit for it. This recovers a source offset for a\n/// let-binding NAME, which the parser stores only as a String on the Stmt (it is\n/// not an EIdent and so carries no offset). Binding names are exactly the\n/// env-visible top-level names, so making their definition site hoverable is the\n/// useful case for this MVP.\nfn push_binding_name_hit(source: String, start: Int, end: Int, name: String, acc: Array[IdentHit]) -> Unit {\n  let nlen = String::length(name)\n  if nlen == 0 {\n    ()\n  } else {\n    let limit = if end > String::length(source) {\n      String::length(source)\n    } else {\n      end\n    }\n    let mut i = if start < 0 {\n      0\n    } else {\n      start\n    }\n    let mut found = false\n    while !found && i + nlen <= limit {\n      if String::substring(source, i, i + nlen) == name && is_boundary_at(source, i - 1) && is_boundary_at(source, i + nlen) {\n        Array::push(acc, IdentHit(name, i))\n        found = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n}\n\n/// Add located hits for the NAMES of top-level (and module-body) value bindings,\n/// using each statement's source span (from parse_program_spans) to scope the\n/// whole-word search. Only SLet/SLetMut names are env-visible value bindings.\nfn collect_binding_name_hits(stmts: Array[Stmt], span_start: Array[Int], span_end: Array[Int], source: String, acc: Array[IdentHit]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let start = if i < Array::length(span_start) {\n      Array::get(span_start, i)\n    } else {\n      0\n    }\n    let end = if i < Array::length(span_end) {\n      Array::get(span_end, i)\n    } else {\n      String::length(source)\n    }\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, _) => push_binding_name_hit(source, start, end, name, acc),\n      SLetMut(name, _, _) => push_binding_name_hit(source, start, end, name, acc),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\n/// Among all collected idents whose span [off, off+len(name)) contains `tgt`,\n/// pick the one with the largest `off` (innermost / closest start). Returns \"\"\n/// when no ident covers the position.\nfn pick_ident_at(hits: Array[IdentHit], tgt: Int) -> String {\n  let mut best_name = \"\"\n  let mut best_off = -1\n  let mut i = 0\n  while i < Array::length(hits) {\n    match Array::get(hits, i) {\n      IdentHit(name, off) => {\n        let span_end = off + String::length(name)\n        if off <= tgt && tgt < span_end && off > best_off {\n          best_name = name\n          best_off = off\n        } else {\n          ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  best_name\n}\n\n/// Same selection as pick_ident_at, but returns the chosen ident's source\n/// `off` (the innermost / largest-off hit covering `tgt`), or -1 when none.\n/// Used to query the per-node type table by the hovered EIdent's offset.\nfn pick_ident_off(hits: Array[IdentHit], tgt: Int) -> Int {\n  let mut best_off = -1\n  let mut i = 0\n  while i < Array::length(hits) {\n    match Array::get(hits, i) {\n      IdentHit(name, off) => {\n        let span_end = off + String::length(name)\n        if off <= tgt && tgt < span_end && off > best_off {\n          best_off = off\n        } else {\n          ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  best_off\n}\n\n/// Look up the recorded type for source offset `off` in the per-node type table\n/// produced by check_program_type_table. Returns None when no node recorded that\n/// exact offset. When multiple entries share an offset (re-checked node), the\n/// last recorded one wins (closest to the final inference state).\nfn tytab_lookup(table: Array[(Int, Type)], off: Int) -> Option[Type] {\n  let mut found = None\n  let mut i = 0\n  while i < Array::length(table) {\n    let (toff, tty) = Array::get(table, i)\n    if toff == off {\n      found = Some(tty)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n/// Locate the identifier at (line, col), typecheck the program, and return its\n/// inferred type as a string. Resolution order:\n///   1. per-node type table (covers LOCALS and PARAMETERS — names that live in\n///      nested inference scopes and are gone from the returned TypeEnv);\n///   2. fall back to the top-level TypeEnv lookup (top-level / imported names,\n///      and let-binding definition sites whose offset is not an EIdent node).\n/// Returns \"\" when the position is not over a located identifier, or the name\n/// resolves nowhere. Any failure is swallowed and yields \"\".\nexport fn type_at_source(source: String, line: Int, col: Int) -> String {\n  handle {\n    let tgt = line_col_to_offset(source, line, col)\n    if tgt < 0 {\n      // Out-of-range (line, col): invalid `line`/`col` (< 1), `line` beyond\n      // EOF, or `col` past the end of that line's content (#947). No position\n      // to resolve, so no hover — matches the \"position not over a located\n      // identifier\" empty-result convention below.\n      \"\"\n    } else {\n      let (tokens, starts, ends) = lex_with_offsets(source)\n      let stmts = parse_program_located(tokens, starts, source)\n      let hits = empty_hits()\n      // Identifier USES carry real offsets on their EIdent nodes.\n      collect_stmts(stmts, hits)\n      // Identifier DEFINITIONS (let-binding names) carry none, so recover their\n      // source offset from each statement's span and the source text.\n      let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)\n      collect_binding_name_hits(span_stmts, span_start, span_end, source, hits)\n      let name = pick_ident_at(hits, tgt)\n      if name == \"\" {\n        \"\"\n      } else {\n        let chosen_off = pick_ident_off(hits, tgt)\n        // 1. per-node type table (locals + parameters).\n        let (table, final_s) = check_program_type_table(stmts)\n        let table_hit = if chosen_off >= 0 {\n          tytab_lookup(table, chosen_off)\n        } else {\n          None\n        }\n        match table_hit {\n          Some(rec_ty) => type_to_string(subst_apply(final_s, rec_ty)),\n          None => {\n            // 2. fall back to the top-level env (top-level / imported names).\n            let env = check_program(stmts)\n            match env_lookup(env, name) {\n              Some(t) => type_to_string(t),\n              None => \"\"\n            }\n          }\n        }\n      }\n    }\n  } with Error {\n    Throw(_) => \"\"\n  }\n}\n")
}

let cli_adapter_source_164 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/binding_at.vibe",
"//# Imports\n\n// `vibe binding-at` — AST-accurate, scope-aware binding occurrences: the\n// foundation for scope-precision rename / references (テーマ4). Given a\n// (line, col), locate the identifier under the cursor and return the source\n// spans of every occurrence that resolves to the SAME binding — not merely the\n// same NAME.\n//\n// Why this is better than a text scan: occurrences are taken from the real\n// parsed AST, so there are NO false matches inside string literals, comments, or\n// as substrings of a longer word — only actual identifier nodes count.\n//\n// SCOPE AWARENESS (テーマ4): a scope-stack walk resolves every `EIdent(name,off)`\n// REFERENCE to the nearest enclosing introduction of `name` — a `let` / `let mut`\n// local, a function/lambda parameter, a `for` binder, a `loop` parameter, or a\n// match/handle pattern binder. Each introduction gets a unique binding id;\n// references that resolve to the same introduction share it, so two distinct\n// same-named locals (e.g. `x` in one function vs `x` in another, or a shadowing\n// inner `let x`) are NOT conflated. A reference that resolves to no local\n// introduction is treated as a module-level / free name and grouped FILE-WIDE by\n// name (canonical key 0), so top-level `export let f` references across the file\n// still resolve together.\n//\n// BINDER OFFSET RECOVERY: the AST stores binder NAMES as plain Strings without\n// offsets (only `EIdent` carries an offset). We recover a binder's source span by\n// scanning the source for the next whole-word occurrence of the name from a\n// monotonically-advancing floor, walking constructs in source order. This is the\n// same whole-word-scan machinery the previous name-wide implementation used for\n// top-level binding names, generalized to nested binders.\n//\n// FALLBACK (honest): for `match`/`handle` arms whose patterns introduce nested\n// sub-binders (ctor / tuple / struct / or patterns) the names ARE introduced into\n// scope so references resolve correctly, but if a particular binder's source\n// offset cannot be recovered from the floor its own occurrence span is omitted\n// (the rename set may miss the binder site itself, never a crash). Resolution\n// never crashes: any failure is swallowed and yields an empty list.\n//\n// All strings are built with String::concat only (never `+`, never \"\\{x}\"\n// interpolation): both mis-codegen to NUL here.\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/syntax {\n  lex_with_offsets, parse_program_located\n}\n\n//# Functions\n\n/// 1-based (line, col) -> 0-based char offset. Mirror of type_at.vibe's\n/// line_col_to_offset (kept in sync — see its comment for the full rationale):\n/// count newlines to reach the target line, add (col - 1). Returns -1\n/// (invalid / no position) rather than clamping (#947) for `line`/`col` < 1,\n/// `line` beyond EOF, or `col` past the end of that line's content (previously\n/// unclamped, so a large `col` silently resolved into the NEXT line's\n/// identifier). CRLF: a line's addressable content excludes a trailing '\\r'\n/// before the '\\n', so query positions on CRLF files don't drift.\nfn bind_line_col_to_offset(source: String, line: Int, col: Int) -> Int {\n  if line < 1 || col < 1 {\n    -1\n  } else {\n    let len = String::length(source)\n    let mut i = 0\n    let mut cur_line = 1\n    while cur_line < line && i < len {\n      if String::char_code_at(source, i) == 10 {\n        cur_line = cur_line + 1\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    if cur_line < line {\n      -1\n    } else {\n      let mut line_end = i\n      while line_end < len && String::char_code_at(source, line_end) != 10 {\n        line_end = line_end + 1\n      }\n      let content_end = if line_end > i && String::char_code_at(source, line_end - 1) == 13 {\n        line_end - 1\n      } else {\n        line_end\n      }\n      let off = i + (col - 1)\n      if off > content_end {\n        -1\n      } else {\n        off\n      }\n    }\n  }\n}\n\n/// A located occurrence resolved to a binding:\n///   BindHit(name, off, key)\n/// where `off` is the start source offset (its span is [off, off+length(name)))\n/// and `key` is the canonical binding id this occurrence resolves to. key 0 means\n/// \"module-level / free name, grouped file-wide by name\". `off` is -1 for\n/// synthetic / non-located nodes, which the search ignores.\nenum BindHit {\n  BindHit(String, Int, Int)\n}\n\nfn bind_empty_hits() -> Array[BindHit] {\n  array_empty()\n}\n\n/// True when `source[off]` is NOT an identifier char (or off out of range) — a\n/// word boundary. Used to match a binding name as a whole word.\nfn bind_is_boundary_at(source: String, off: Int) -> Bool {\n  if off < 0 || off >= String::length(source) {\n    true\n  } else {\n    let c = String::char_code_at(source, off)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    !is_id\n  }\n}\n\n/// Find the start offset of the first whole-word occurrence of `name` in\n/// `source` at or after `from`. Returns -1 when not found. Recovers a source\n/// offset for a binder NAME, which the parser stores only as a String.\nfn bind_find_word(source: String, name: String, from: Int) -> Int {\n  let nlen = String::length(name)\n  if nlen == 0 {\n    -1\n  } else {\n    let limit = String::length(source)\n    let mut i = if from < 0 {\n      0\n    } else {\n      from\n    }\n    let mut found = -1\n    while found < 0 && i + nlen <= limit {\n      if String::substring(source, i, i + nlen) == name && bind_is_boundary_at(source, i - 1) && bind_is_boundary_at(source, i + nlen) {\n        found = i\n      } else {\n        i = i + 1\n      }\n    }\n    found\n  }\n}\n\n/// Mutable walk state threaded through the AST traversal:\n///   hits        — collected occurrences (references + recovered binders)\n///   scope_names — scope-stack of in-scope binder names (parallel to scope_ids)\n///   scope_ids   — scope-stack of binder ids (parallel to scope_names)\n///   floor       — boxed monotonically-advancing scan floor for binder recovery\n///   source      — the program text\n///\n/// Binding ids are NOT a separate counter: each binder's canonical id is its\n/// recovered source offset + 1 (unique per binder, and >= 1 so it never collides\n/// with the module/free key 0). This avoids a separate mutable id-counter field.\nstruct BindState {\n  hits: Array[BindHit];\n  scope_names: Array[String];\n  scope_ids: Array[Int];\n  floor: Array[Int];\n  source: String\n}\n\n/// A fresh single-cell mutable Int array holding `v` (a poor-man's mutable box).\n/// Built via the slice+push idiom so the cell is a heap array supporting\n/// Array::set, not a static read-only literal.\nfn bind_box_int(v: Int) -> Array[Int] {\n  let arr = array_empty()\n  Array::push(arr, v)\n  arr\n}\n\nfn bind_new_state(source: String) -> BindState {\n  BindState::{\n    hits: bind_empty_hits(),\n    scope_names: array_empty(),\n    scope_ids: array_empty(),\n    floor: bind_box_int(0),\n    source: source\n  }\n}\n\n/// Resolve `name` to the nearest enclosing scope id, scanning the scope stack from\n/// the top (end) down. Returns 0 (module-level / free, grouped file-wide) when no\n/// local introduction is in scope.\nfn bind_resolve(st: BindState, name: String) -> Int {\n  let n = Array::length(st.scope_names)\n  let mut i = n - 1\n  let mut found = 0\n  while i >= 0 && found == 0 {\n    if Array::get(st.scope_names, i) == name {\n      found = Array::get(st.scope_ids, i)\n    } else {\n      ()\n    }\n    i = i - 1\n  }\n  found\n}\n\n/// Pop the scope stack back down to `mark` entries.\nfn bind_pop_scope(st: BindState, mark: Int) -> Unit {\n  Array::truncate(st.scope_names, mark)\n  Array::truncate(st.scope_ids, mark)\n}\n\n/// Recover a binder's source offset (from the scan floor forward), record it as an\n/// occurrence, advance the floor past it, and return its unique binding id (off+1,\n/// always >= 1; or 0 when the offset cannot be recovered — see file header\n/// FALLBACK note). Does NOT push to scope — callers control when the binder enters\n/// scope (e.g. a non-recursive `let x = v` must recover x's offset textually\n/// before v, yet not have x in scope while walking v).\nfn bind_recover_binder(st: BindState, name: String) -> Int {\n  let from = Array::get(st.floor, 0)\n  let off = bind_find_word(st.source, name, from)\n  let id = if off >= 0 {\n    off + 1\n  } else {\n    0\n  }\n  if off >= 0 {\n    Array::push(st.hits, BindHit(name, off, id))\n    Array::set(st.floor, 0, off + String::length(name))\n  } else {\n    ()\n  }\n  id\n}\n\n/// Push a binder (name, id) onto the current scope.\nfn bind_push_binder(st: BindState, name: String, id: Int) -> Unit {\n  Array::push(st.scope_names, name)\n  Array::push(st.scope_ids, id)\n}\n\n/// Introduce a binder: recover its offset/id then immediately push it into scope.\n/// Used where the binder's scope begins right at the binder site (params, for /\n/// loop binders, match-pattern binders).\nfn bind_introduce(st: BindState, name: String) -> Unit {\n  let id = bind_recover_binder(st, name)\n  bind_push_binder(st, name, id)\n}\n\n/// Record a reference `EIdent(name, off)`: resolve it to the nearest enclosing\n/// binding (or 0 = module-level/free) and store its located span. Advance the\n/// floor past it so later binder recovery does not re-find an earlier position.\nfn bind_record_ref(st: BindState, name: String, off: Int) -> Unit {\n  if off >= 0 {\n    let key = bind_resolve(st, name)\n    Array::push(st.hits, BindHit(name, off, key))\n    if off >= Array::get(st.floor, 0) {\n      Array::set(st.floor, 0, off + String::length(name))\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\n/// Record an assignment target `name = ...` / `name op= ...`. Resolve to the\n/// enclosing binding and recover the name's source offset from the floor (the\n/// target name has no stored offset).\nfn bind_record_assign_target(st: BindState, name: String) -> Unit {\n  let key = bind_resolve(st, name)\n  let from = Array::get(st.floor, 0)\n  let off = bind_find_word(st.source, name, from)\n  if off >= 0 {\n    Array::push(st.hits, BindHit(name, off, key))\n    Array::set(st.floor, 0, off + String::length(name))\n  } else {\n    ()\n  }\n}\n\n/// Introduce the names bound by a pattern (PBind directly; nested binders in\n/// ctor / tuple / struct / or patterns recursively). Each is introduced into the\n/// current scope.\nfn bind_introduce_pat(st: BindState, pat: Pat) -> Unit {\n  match pat {\n    PWild => (),\n    PBind(name) => bind_introduce(st, name),\n    PInt(_) => (),\n    PFloat(_) => (),\n    PString(_) => (),\n    PBool(_) => (),\n    PCtor(_, sub) => bind_introduce_pats(st, sub),\n    PTuple(sub) => bind_introduce_pats(st, sub),\n    POr(a, b) => {\n      bind_introduce_pat(st, a)\n      bind_introduce_pat(st, b)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        bind_introduce_pat(st, fp)\n        i = i + 1\n      }\n    }\n  }\n}\n\nfn bind_introduce_pats(st: BindState, sub: Array[Pat]) -> Unit {\n  let mut i = 0\n  while i < Array::length(sub) {\n    bind_introduce_pat(st, Array::get(sub, i))\n    i = i + 1\n  }\n}\n\n/// Scope-aware walker. `st.hits` accumulates references (resolved to a binding id)\n/// and recovered binders. Every Expr arm is enumerated so a new variant is a\n/// compile error here, keeping the collector in sync with the AST.\nfn bind_walk_expr(st: BindState, expr: Expr) -> Unit {\n  match expr {\n    EInt(_) => (),\n    EFloat(_) => (),\n    EString(_) => (),\n    EBool(_) => (),\n    EIdent(name, off) => bind_record_ref(st, name, off),\n    EUnit => (),\n    EStringInterp(_) => (),\n    ETuple(items) => bind_walk_exprs(st, items),\n    EArray(items) => bind_walk_exprs(st, items),\n    ERecord(_, fields, _) => bind_walk_field_exprs(st, fields),\n    EIf(c, t, e) => {\n      bind_walk_expr(st, c)\n      bind_walk_expr(st, t)\n      bind_walk_expr(st, e)\n    },\n    ELet(name, v, b, _) => {\n      // `let name = v; b`: the binder is textually BEFORE v, so recover its\n      // offset first (advancing the floor past it), but keep it OUT of scope while\n      // walking v — a non-recursive `let x = x + 1` references the OUTER x. Then\n      // push it into scope for b only.\n      let id = bind_recover_binder(st, name)\n      bind_walk_expr(st, v)\n      let mark = Array::length(st.scope_names)\n      bind_push_binder(st, name, id)\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    ELetRec(name, v, b) => {\n      // recursive let: name is in scope for both v and b.\n      let mark = Array::length(st.scope_names)\n      bind_introduce(st, name)\n      bind_walk_expr(st, v)\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    ELetMut(name, v, b, _) => {\n      // same binder-before-value ordering as ELet.\n      let id = bind_recover_binder(st, name)\n      bind_walk_expr(st, v)\n      let mark = Array::length(st.scope_names)\n      bind_push_binder(st, name, id)\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    EAssign(name, v, b) => {\n      // assignment target is a reference to an in-scope binding.\n      bind_record_assign_target(st, name)\n      bind_walk_expr(st, v)\n      bind_walk_expr(st, b)\n    },\n    EAssignOp(name, _, v, b) => {\n      bind_record_assign_target(st, name)\n      bind_walk_expr(st, v)\n      bind_walk_expr(st, b)\n    },\n    ESeq(a, b) => {\n      bind_walk_expr(st, a)\n      bind_walk_expr(st, b)\n    },\n    EMatch(s, arms) => {\n      bind_walk_expr(st, s)\n      bind_walk_arms(st, arms)\n    },\n    EHandle(s, arms) => {\n      bind_walk_expr(st, s)\n      bind_walk_arms(st, arms)\n    },\n    EWhile(c, b) => {\n      bind_walk_expr(st, c)\n      bind_walk_expr(st, b)\n    },\n    ELoop(params, b) => {\n      // loop params introduce names scoped to b; init exprs are outside scope.\n      let mark = Array::length(st.scope_names)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, init) = Array::get(params, i)\n        bind_walk_expr(st, init)\n        bind_introduce(st, pname)\n        i = i + 1\n      }\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    EForIn(name, idx_opt, it, b) => {\n      bind_walk_expr(st, it)\n      let mark = Array::length(st.scope_names)\n      bind_introduce(st, name)\n      match idx_opt {\n        Some(idx) => bind_introduce(st, idx),\n        None => ()\n      }\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    ECall(callee, args, _) => {\n      bind_walk_expr(st, callee)\n      bind_walk_exprs(st, args)\n    },\n    EBinOp(_, l, r) => {\n      bind_walk_expr(st, l)\n      bind_walk_expr(st, r)\n    },\n    EUnaryOp(_, e) => bind_walk_expr(st, e),\n    EFn(_, _, params, _, _, body) => {\n      // function / lambda parameters are scoped to body.\n      let mark = Array::length(st.scope_names)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        bind_introduce(st, pname)\n        i = i + 1\n      }\n      bind_walk_expr(st, body)\n      bind_pop_scope(st, mark)\n    },\n    EDot(e, _, _, _) => bind_walk_expr(st, e),\n    ELabeledArg(_, _, v) => bind_walk_expr(st, v),\n    EReturn(e) => bind_walk_expr(st, e),\n    EBreak(opt) => match opt {\n      Some(v) => bind_walk_expr(st, v),\n      None => ()\n    },\n    EContinue(args) => bind_walk_exprs(st, args),\n    EMap(fields) => bind_walk_field_exprs(st, fields),\n    ESpread(e) => bind_walk_expr(st, e)\n  }\n}\n\nfn bind_walk_exprs(st: BindState, items: Array[Expr]) -> Unit {\n  let mut i = 0\n  while i < Array::length(items) {\n    bind_walk_expr(st, Array::get(items, i))\n    i = i + 1\n  }\n}\n\nfn bind_walk_field_exprs(st: BindState, fields: Array[(String, Expr)]) -> Unit {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    bind_walk_expr(st, v)\n    i = i + 1\n  }\n}\n\n/// A match/handle arm: the pattern binders are scoped to the arm body only.\nfn bind_walk_arms(st: BindState, arms: Array[(Pat, Expr)]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (pat, e) = Array::get(arms, i)\n    let mark = Array::length(st.scope_names)\n    bind_introduce_pat(st, pat)\n    bind_walk_expr(st, e)\n    bind_pop_scope(st, mark)\n    i = i + 1\n  }\n}\n\n/// Record a top-level / module-level binder NAME. These group file-wide (key 0),\n/// so all references to the same module name resolve together. We recover the\n/// binder's offset from the floor.\nfn bind_record_module_binder(st: BindState, name: String) -> Unit {\n  let from = Array::get(st.floor, 0)\n  let off = bind_find_word(st.source, name, from)\n  if off >= 0 {\n    Array::push(st.hits, BindHit(name, off, 0))\n    Array::set(st.floor, 0, off + String::length(name))\n  } else {\n    ()\n  }\n}\n\n/// Walk a statement. Top-level value bindings (SLet/SLetMut) introduce a\n/// module-level name (key 0 => grouped file-wide); we record the binder's located\n/// NAME and walk the body. SModule recurses.\nfn bind_walk_stmt(st: BindState, stmt: Stmt) -> Unit {\n  match stmt {\n    SLet(_, _, name, _, body) => {\n      bind_record_module_binder(st, name)\n      bind_walk_expr(st, body)\n    },\n    SLetMut(name, _, body) => {\n      bind_record_module_binder(st, name)\n      bind_walk_expr(st, body)\n    },\n    STest(_, body) => bind_walk_expr(st, body),\n    SBench(_, body) => bind_walk_expr(st, body),\n    SExpr(e) => bind_walk_expr(st, e),\n    SLetPat(_, body) => bind_walk_expr(st, body),\n    SModule(_, _, body) => bind_walk_stmts(st, body),\n    _ => ()\n  }\n}\n\nfn bind_walk_stmts(st: BindState, stmts: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    bind_walk_stmt(st, Array::get(stmts, i))\n    i = i + 1\n  }\n}\n\n/// Among all hits whose span [off, off+len(name)) contains `tgt`, pick the one\n/// with the largest `off` (innermost / closest start). Returns the (name, key) of\n/// that hit, or (\"\", 0) when none.\nfn bind_pick_at(hits: Array[BindHit], tgt: Int) -> (String, Int) {\n  let mut best_name = \"\"\n  let mut best_key = 0\n  let mut best_off = -1\n  let mut i = 0\n  while i < Array::length(hits) {\n    match Array::get(hits, i) {\n      BindHit(name, off, key) => {\n        let span_end = off + String::length(name)\n        if off >= 0 && off <= tgt && tgt < span_end && off > best_off {\n          best_name = name\n          best_key = key\n          best_off = off\n        } else {\n          ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  (best_name, best_key)\n}\n\n/// Insert (start, end) into `out` keeping it sorted by start ascending and\n/// de-duplicated (skip when an identical start is already present — equal starts\n/// imply equal spans because the name length is fixed).\nfn bind_insert_sorted_unique(out: Array[(Int, Int)], start: Int, end: Int) -> Unit {\n  let n = Array::length(out)\n  let mut dup = false\n  let mut idx = n\n  let mut j = 0\n  while j < n {\n    let (s, _) = Array::get(out, j)\n    if s == start {\n      dup = true\n    } else {\n      ()\n    }\n    if s > start && idx == n {\n      idx = j\n    } else {\n      ()\n    }\n    j = j + 1\n  }\n  if dup {\n    ()\n  } else if idx == n {\n    Array::push(out, (start, end))\n  } else {\n    Array::push(out, Array::get(out, n - 1))\n    let mut k = n - 1\n    while k > idx {\n      Array::set(out, k, Array::get(out, k - 1))\n      k = k - 1\n    }\n    Array::set(out, idx, (start, end))\n  }\n}\n\n/// Collect the (start, end) source spans of every occurrence that resolves to the\n/// SAME binding as the identifier under the cursor at 1-based (line, col). Steps:\n///   1. lex + parse located; scope-aware walk collecting located references\n///      (resolved to a binding id) plus recovered binders.\n///   2. find the (name, key) covering the cursor offset; \"\" -> no occurrences.\n///   3. emit a span for every hit with the same name AND key (key 0 = module /\n///      free name grouped file-wide), de-duplicated and sorted by start.\n/// AST-accurate and scope-aware (see file header). Any failure is swallowed and\n/// yields an empty list.\nfn binding_occurrences_impl(source: String, line: Int, col: Int) -> Array[(Int, Int)] with { Error } {\n  {\n    let tgt = bind_line_col_to_offset(source, line, col)\n    let empty_out = array_empty()\n    if tgt < 0 {\n      // Out-of-range (line, col) — see bind_line_col_to_offset (#947): no\n      // position to resolve, so no occurrences.\n      empty_out\n    } else {\n      let (tokens, starts, _ends) = lex_with_offsets(source)\n      let stmts = parse_program_located(tokens, starts, source)\n      let st = bind_new_state(source)\n      bind_walk_stmts(st, stmts)\n      let hits = st.hits\n      let (name, key) = bind_pick_at(hits, tgt)\n      let out = array_empty()\n      if name == \"\" {\n        out\n      } else {\n        let mut i = 0\n        while i < Array::length(hits) {\n          match Array::get(hits, i) {\n            BindHit(hname, hoff, hkey) => {\n              if hname == name && hkey == key && hoff >= 0 {\n                bind_insert_sorted_unique(out, hoff, hoff + String::length(hname))\n              } else {\n                ()\n              }\n            }\n          }\n          i = i + 1\n        }\n        out\n      }\n    }\n  }\n}\n\nexport fn binding_occurrences(source: String, line: Int, col: Int) -> Array[(Int, Int)] {\n  handle {\n    binding_occurrences_impl(source, line, col)\n  } with Error {\n    Throw(_) => array_empty()\n  }\n}\n")
}

let cli_adapter_source_165 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/doc_at.vibe",
"//# Imports\n\n// `vibe doc-at` — Rust-`///`-style doc comment lookup for hover (#854).\n// Given a (line, col), resolve the identifier under the cursor to its\n// declaring binding (reusing binding_at.vibe's scope-aware occurrence\n// search — the smallest-offset occurrence is the declaration site) and\n// return the `///` doc comment text immediately preceding that\n// declaration's line, or \"\" when there is none. Same single-file scope\n// limitation as type_at.vibe / binding_at.vibe: imports are not resolved,\n// so only same-file declarations are covered.\n\nimport @vibe/compiler/syntax {\n  collect_doc_comments, offset_to_line_col\n}\n\nimport ./binding_at.vibe {\n  binding_occurrences\n}\n\n//# Functions\n\nfn doc_lookup(docs: Array[(Int, String)], line: Int) -> String {\n  let mut i = 0\n  let mut found = \"\"\n  while i < Array::length(docs) {\n    let (doc_line, text) = Array::get(docs, i)\n    if doc_line == line {\n      found = text\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nexport fn doc_at_source(source: String, line: Int, col: Int) -> String {\n  let occ = binding_occurrences(source, line, col)\n  if Array::length(occ) == 0 {\n    \"\"\n  } else {\n    // binding_occurrences returns spans sorted by start ascending (#635\n    // bind_insert_sorted_unique) -- the first entry is the smallest source\n    // offset, i.e. the declaration site for ordinary (non-recursive-forward)\n    // top-level/local bindings.\n    let (def_off, _def_end) = Array::get(occ, 0)\n    let (def_line, _def_col) = offset_to_line_col(source, def_off)\n    let docs = collect_doc_comments(source)\n    doc_lookup(docs, def_line)\n  }\n}\n")
}

let cli_adapter_source_166 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/symbol_spans.vibe",
"//# Imports\n\n// `vibe symbols` — AST-accurate top-level (and module-nested) declaration spans:\n// the foundation for scope-precision document outline / go-to-definition\n// (テーマ4 LSP). Given a source string, return one record per declared symbol:\n//   (name, kind, start, end)\n// where `kind` is an LSP SymbolKind number and [start, end) is the source span\n// of the declaration NAME (char offsets).\n//\n// Why this beats the LSP server's previous line-regex scan: declarations are\n// taken from the real parsed AST, so multi-line declarations, declarations not\n// starting at column 0, and names that merely look like keywords inside strings\n// or comments are handled correctly — only actual declaration nodes count. The\n// name's source offset is recovered by a whole-word scan SCOPED to that\n// statement's parse span (from parse_program_spans), so a name that also appears\n// elsewhere in the statement body cannot be mis-located.\n//\n// FALLBACK (honest): a name whose offset cannot be recovered within its span is\n// simply omitted (never a crash). A genuine lex/parse failure on the source\n// itself, though, is NOT swallowed here (#946) -- it propagates as an Error so\n// the caller can tell \"this file has no symbols\" apart from \"resolution\n// failed\"; see cli_adapter.vibe's VIBE_SYMBOLS handling.\n//\n// All strings are built with String::concat only (never `+`, never \"\\{x}\"\n// interpolation): both mis-codegen to NUL here.\n\nimport @vibe/compiler/core {\n  Expr, Stmt\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/syntax {\n  lex_with_offsets, parse_program_spans\n}\n\n//# Functions\n\n/// True when `source[off]` is NOT an identifier char (or off out of range) — a\n/// word boundary. Used to match a declaration name as a whole word.\nfn sym_is_boundary_at(source: String, off: Int) -> Bool {\n  if off < 0 || off >= String::length(source) {\n    true\n  } else {\n    let c = String::char_code_at(source, off)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    !is_id\n  }\n}\n\n/// A fresh single-cell mutable Int array holding `v` (a poor-man's mutable box),\n/// built via slice+push so the cell is a heap array supporting Array::set.\nfn sym_box_int(v: Int) -> Array[Int] {\n  let arr = array_empty()\n  Array::push(arr, v)\n  arr\n}\n\nfn sym_empty_items() -> Array[(String, Int, Int, Int)] {\n  array_empty()\n}\n\n/// Find the first whole-word occurrence of `name` in `source[from..hi)` and, when\n/// found, push `(name, kind, off, off+len)` and advance `floor` past it (so a\n/// later sibling declaration in the same window keeps scanning forward). No-op\n/// when the name cannot be located in the window.\nfn sym_emit(out: Array[(String, Int, Int, Int)], source: String, name: String, kind: Int, floor: Array[Int], hi: Int) -> Unit {\n  let nlen = String::length(name)\n  if nlen == 0 {\n    ()\n  } else {\n    let limit = if hi > String::length(source) {\n      String::length(source)\n    } else {\n      hi\n    }\n    let mut i = Array::get(floor, 0)\n    if i < 0 {\n      i = 0\n    } else {\n      ()\n    }\n    let mut found = false\n    while !found && i + nlen <= limit {\n      if String::substring(source, i, i + nlen) == name && sym_is_boundary_at(source, i - 1) && sym_is_boundary_at(source, i + nlen) {\n        Array::push(out, (name, kind, i, i + nlen))\n        Array::set(floor, 0, i + nlen)\n        found = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n}\n\n/// LSP SymbolKind for a top-level value binding: Function (12) when its body is a\n/// lambda, else Variable (13).\nfn sym_let_kind(body: Expr) -> Int {\n  match body {\n    EFn(_, _, _, _, _, _) => 12,\n    _ => 13\n  }\n}\n\n/// Emit the symbol for one statement within the window [floor, hi). SModule emits\n/// the module name (kind 2 = Module) then recurses into its body, threading the\n/// SAME advancing floor so nested declarations are located in source order.\nfn sym_walk_stmt(out: Array[(String, Int, Int, Int)], source: String, stmt: Stmt, floor: Array[Int], hi: Int) -> Unit {\n  match stmt {\n    SLet(_, _, name, _, body) => sym_emit(out, source, name, sym_let_kind(body), floor, hi),\n    SLetMut(name, _, _) => sym_emit(out, source, name, 13, floor, hi),\n    SEnum(_, name, _, _, _) => sym_emit(out, source, name, 10, floor, hi),\n    SSuberror(_, name, _) => sym_emit(out, source, name, 10, floor, hi),\n    SStruct(_, name, _, _, _, _) => sym_emit(out, source, name, 23, floor, hi),\n    STypeAlias(_, name, _, _) => sym_emit(out, source, name, 26, floor, hi),\n    STrait(_, name, _, _, _) => sym_emit(out, source, name, 11, floor, hi),\n    SEffectDef(_, name, _, _) => sym_emit(out, source, name, 24, floor, hi),\n    SModule(_, name, body) => {\n      sym_emit(out, source, name, 2, floor, hi)\n      let mut j = 0\n      while j < Array::length(body) {\n        sym_walk_stmt(out, source, Array::get(body, j), floor, hi)\n        j = j + 1\n      }\n    },\n    _ => ()\n  }\n}\n\n/// Collect declaration symbols. Steps:\n///   1. lex + parse with per-statement spans (parse_program_spans).\n///   2. for each top-level statement, scan its own [start, end) span for the\n///      declaration name and emit (name, kind, start, end); SModule recurses.\n/// AST-accurate (see file header).\nfn symbol_spans_impl(source: String) -> Array[(String, Int, Int, Int)] with { Error } {\n  {\n    let (tokens, starts, ends) = lex_with_offsets(source)\n    let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)\n    let out = sym_empty_items()\n    let mut i = 0\n    while i < Array::length(span_stmts) {\n      let lo = if i < Array::length(span_start) {\n        Array::get(span_start, i)\n      } else {\n        0\n      }\n      let hi = if i < Array::length(span_end) {\n        Array::get(span_end, i)\n      } else {\n        String::length(source)\n      }\n      let floor = sym_box_int(lo)\n      sym_walk_stmt(out, source, Array::get(span_stmts, i), floor, hi)\n      i = i + 1\n    }\n    out\n  }\n}\n\n/// #946: this used to swallow every failure (lex error, parse error) into a\n/// bare empty list, making a genuine failure indistinguishable from \"the file\n/// legitimately declares no symbols\" — the CLI adapter's `.diag` sidecar\n/// convention (VIBE_SYMBOLS in cli_adapter.vibe) can only report the\n/// difference if the Error actually reaches it. Propagate instead of\n/// catching; the sole caller now routes it to that sidecar.\nexport fn symbol_spans(source: String) -> Array[(String, Int, Int, Int)] with { Error } {\n  symbol_spans_impl(source)\n}\n")
}

let cli_adapter_source_167 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/persistent_env_codec.vibe",
"//# Imports\n\nimport @vibe/compiler/cache {\n  compact_string_fingerprint,\n  normalize_persistent_cache_text,\n  package_index_deps_are_current,\n  persistent_dep_list_cache_path,\n  persistent_leaf_fingerprint_cache_path,\n  persistent_type_env_cache_path\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  Type, TypeEnv, env_flat_bindings\n}\n\n//# Functions\n\nfn parse_int_unwrap(raw: String, fallback: Int) -> Int {\n  let len = String::length(raw)\n  let mut result = 0\n  let mut i = 0\n  let mut neg = false\n  let mut valid = true\n  if len == 0 {\n    valid = false\n  }\n  if valid {\n    if String::char_code_at(raw, 0) == 45 {\n      neg = true; i = 1\n    }\n  }\n  while valid {\n    if i >= len {\n      break\n    }\n    let c = String::char_code_at(raw, i)\n    if c < 48 {\n      valid = false\n    }\n    else if c > 57 {\n      valid = false\n    }\n    else {\n      result = result * 10 + (c - 48)\n      i = i + 1\n    }\n  }\n  if valid {\n    if neg {\n      0 - result\n    } else result\n  } else fallback\n}\n\nfn serialize_segment(text: String) -> String {\n  let len = String::length(text)\n  let len_str = __to_string(len)\n  let colon_text = String::concat(\":\", text)\n  String::concat(len_str, colon_text)\n}\n\nfn decode_effect_name(raw: String) -> String {\n  if raw == \"\" || raw == \"0\" {\n    \"\"\n  } else if raw == \"1\" {\n    \"Error\"\n  } else {\n    raw\n  }\n}\n\nfn parse_count_header(text: String, pos: Int, terminator: Int) -> (Int, Int) with { Error } {\n  let len = String::length(text)\n  let mut i = pos\n  while i < len && String::char_code_at(text, i) != terminator {\n    i = i + 1\n  }\n  if i >= len {\n    throw(\"invalid persistent type env payload\")\n  } else {\n    let parsed = parse_int_unwrap(text[pos: i], 0)\n    (parsed, i + 1)\n  }\n}\n\nfn parse_segment(text: String, pos: Int) -> (String, Int) with { Error } {\n  let (seg_len, start) = parse_count_header(text, pos, 58)\n  let end = start + seg_len\n  if end > String::length(text) {\n    throw(\"invalid persistent type env segment\")\n  } else {\n    (text[start: end], end)\n  }\n}\n\nfn parse_int_array(text: String, pos: Int) -> (Array[Int], Int) with { Error } {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = array_empty()\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (raw, next_cursor) = parse_segment(text, cursor)\n    let parsed_val = parse_int_unwrap(raw, 0)\n    Array::push(items, parsed_val)\n    cursor = next_cursor\n    i = i + 1\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env int array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nfn parse_string_array(text: String, pos: Int) -> (Array[String], Int) with { Error } {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = array_empty()\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (item, next_cursor) = parse_segment(text, cursor)\n    Array::push(items, item)\n    cursor = next_cursor\n    i = i + 1\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env string array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nfn parse_bounds_array(text: String, pos: Int) -> (Array[(Int, Array[String])], Int) with { Error } {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = array_empty()\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (raw_id, next_cursor) = parse_segment(text, cursor)\n    let (bounds, next_cursor2) = parse_string_array(text, next_cursor)\n    let parsed_id = parse_int_unwrap(raw_id, 0)\n    Array::push(items, (parsed_id, bounds))\n    cursor = next_cursor2\n    i = i + 1\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env bounds array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nfn parse_cached_type(source: String, pos: Int) -> (Type, Int) with { Error } {\n  let rec parse_type_array: (String, Int) -> (Array[Type], Int) with { Error } = (text, pos) -> {\n    let (count, start) = parse_count_header(text, pos, 91)\n    let items = array_empty()\n    let mut i = 0\n    let mut cursor = start\n    while i < count {\n      let (raw, next_cursor) = parse_segment(text, cursor)\n      let (item, end_cursor) = parse_cached_type(raw, 0)\n      if end_cursor != String::length(raw) {\n        throw(\"invalid persistent type env nested type\")\n      } else {\n        Array::push(items, item)\n        cursor = next_cursor\n        i = i + 1\n      }\n    }\n    if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n      throw(\"invalid persistent type env type array\")\n    } else {\n      (items, cursor + 1)\n    }\n  }\n  if pos >= String::length(source) {\n    throw(\"invalid persistent type env type\")\n  } else {\n    let tag = String::char_code_at(source, pos)\n    match tag {\n      73 => (CtInt, pos + 1),\n      68 => (CtDouble, pos + 1),\n      66 => (CtBool, pos + 1),\n      71 => (CtString, pos + 1),\n      72 => (CtChar, pos + 1),\n      85 => (CtUnit, pos + 1),\n      89 => (CtBytes, pos + 1),\n      88 => (CtUnknown, pos + 1),\n      86 => {\n        let (raw, next_pos) = parse_segment(source, pos + 1)\n        let var_id = parse_int_unwrap(raw, 0)\n        (CtVar(var_id), next_pos)\n      },\n      69 => {\n        let (name, next_pos) = parse_segment(source, pos + 1)\n        (CtEnum(name), next_pos)\n      },\n      82 => {\n        let (name, next_pos) = parse_segment(source, pos + 1)\n        (CtStruct(name), next_pos)\n      },\n      65 => {\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\n        (CtArray(elem), next_pos)\n      },\n      79 => {\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\n        (CtOption(elem), next_pos)\n      },\n      84 => {\n        let (elems, next_pos) = parse_type_array(source, pos + 1)\n        (CtTuple(elems), next_pos)\n      },\n      70 => {\n        let (raw_effect, next_pos1) = parse_segment(source, pos + 1)\n        let (params, next_pos2) = parse_type_array(source, next_pos1)\n        let (ret, next_pos3) = parse_cached_type(source, next_pos2)\n        let eff_raw = decode_effect_name(raw_effect)\n        let eff_name = if String::length(eff_raw) > 0 {\n          Some(eff_raw)\n        } else {\n          None\n        }\n        (CtFn(params, ret, eff_name), next_pos3)\n      },\n      78 => {\n        let (name, next_pos1) = parse_segment(source, pos + 1)\n        let (args, next_pos2) = parse_type_array(source, next_pos1)\n        (CtNamed(name, args), next_pos2)\n      },\n      81 => {\n        let (vars, next_pos1) = parse_int_array(source, pos + 1)\n        let (bounds, next_pos2) = parse_bounds_array(source, next_pos1)\n        let (body, next_pos3) = parse_cached_type(source, next_pos2)\n        (CtForAll(vars, bounds, body), next_pos3)\n      },\n      _ => throw(\"invalid persistent type env type tag\")\n    }\n  }\n}\n\n/// All `serialize_*_array` helpers below used a `String::concat(out, ...)`\n/// accumulator that was O(N²) over the array length. Cache-serialisation\n/// runs them on every TypeEnv save, and large modules hit thousands of\n/// bindings — the cumulative cost shows up in `vibe check` cold runs.\n/// StringBuilder collapses each one to O(N).\nfn serialize_int_array(items: Array[Int]) -> String {\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, __to_string(Array::length(items)))\n  StringBuilder::push(buf, \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    StringBuilder::push(buf, serialize_segment(__to_string(Array::get(items, i))))\n    i = i + 1\n  }\n  StringBuilder::push(buf, \"]\")\n  StringBuilder::freeze(buf)\n}\n\nfn serialize_effect_name_str(effect_name: String) -> String {\n  effect_name\n}\n\nfn serialize_string_array(items: Array[String]) -> String {\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, __to_string(Array::length(items)))\n  StringBuilder::push(buf, \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    StringBuilder::push(buf, serialize_segment(Array::get(items, i)))\n    i = i + 1\n  }\n  StringBuilder::push(buf, \"]\")\n  StringBuilder::freeze(buf)\n}\n\nfn serialize_bounds_array(items: Array[(Int, Array[String])]) -> String {\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, __to_string(Array::length(items)))\n  StringBuilder::push(buf, \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    let (id, bounds) = Array::get(items, i)\n    StringBuilder::push(buf, serialize_segment(__to_string(id)))\n    StringBuilder::push(buf, serialize_string_array(bounds))\n    i = i + 1\n  }\n  StringBuilder::push(buf, \"]\")\n  StringBuilder::freeze(buf)\n}\n\nfn serialize_type(ty: Type) -> String {\n  let rec serialize_type_array: (Array[Type]) -> String = (items) -> {\n    let buf = StringBuilder::new()\n    StringBuilder::push(buf, __to_string(Array::length(items)))\n    StringBuilder::push(buf, \"[\")\n    let mut i = 0\n    while i < Array::length(items) {\n      StringBuilder::push(buf, serialize_segment(serialize_type(Array::get(items, i))))\n      i = i + 1\n    }\n    StringBuilder::push(buf, \"]\")\n    StringBuilder::freeze(buf)\n  }\n  match ty {\n    CtInt => \"I\",\n    CtDouble => \"D\",\n    CtBool => \"B\",\n    CtString => \"G\",\n    CtChar => \"H\",\n    CtUnit => \"U\",\n    CtBytes => \"Y\",\n    CtUnknown => \"X\",\n    CtVar(id) => String::concat(\"V\", serialize_segment(__to_string(id))),\n    CtEnum(name) => String::concat(\"E\", serialize_segment(name)),\n    CtStruct(name) => String::concat(\"R\", serialize_segment(name)),\n    CtArray(elem) => String::concat(\"A\", serialize_type(elem)),\n    CtOption(elem) => String::concat(\"O\", serialize_type(elem)),\n    CtTuple(elems) => String::concat(\"T\", serialize_type_array(elems)),\n    CtFn(params, ret, effect_name) => {\n      let eff_str = if effect_name is Some(n) {\n        n\n      } else {\n        \"\"\n      }\n      String::concat(\"F\", String::concat(serialize_segment(eff_str), String::concat(serialize_type_array(params), serialize_type(ret))))\n    },\n    CtNamed(name, args) =>\n    String::concat(\"N\", String::concat(serialize_segment(name), serialize_type_array(args))),\n    CtForAll(vars, bounds, body) =>\n    String::concat(\"Q\", String::concat(serialize_int_array(vars), String::concat(serialize_bounds_array(bounds), serialize_type(body))))\n  }\n}\n\nexport fn persistent_dep_list_text(deps: Array[String]) -> String {\n  if Array::length(deps) == 0 {\n    \"\"\n  } else if Array::length(deps) == 1 {\n    String::concat(\"version\\t3\\n\", Array::get(deps, 0))\n  } else {\n    String::concat(\"version\\t2\\n\", serialize_string_array(deps))\n  }\n}\n\nexport fn load_persistent_dep_list(path: String, source: String) -> Option[Array[String]] with { Error, Fs } {\n  let cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\n    if String::length(text) == 0 {\n      Some(array_empty())\n    } else {\n      let v2_prefix = \"version\\t2\\n\"\n      let v3_prefix = \"version\\t3\\n\"\n      let text_len = String::length(text)\n      let v2_len = String::length(v2_prefix)\n      let v3_len = String::length(v3_prefix)\n      if text_len >= v2_len &&\n      text[0: v2_len] == v2_prefix {\n        let body = text[v2_len: text_len]\n        let (deps, end_pos) = parse_string_array(body, 0)\n        if end_pos == String::length(body) {\n          // #801 follow-up: deps are RESOLVED paths — refuse a list whose\n          // package-index deps no longer match the current resolution winners\n          // (written while a store copy existed, or vice versa).\n          if package_index_deps_are_current(deps) {\n            Some(deps)\n          } else {\n            None\n          }\n        } else {\n          throw(String::concat(\"invalid persistent dep list body: \", cache_path))\n        }\n      } else if text_len >= v3_len &&\n      text[0: v3_len] == v3_prefix {\n        let dep = text[v3_len: text_len]\n        if String::length(dep) == 0 {\n          Some(array_empty())\n        } else {\n          if package_index_deps_are_current([\n            dep\n          ]) {\n            Some([\n              dep\n            ])\n          } else {\n            None\n          }\n        }\n      } else {\n        throw(String::concat(\"invalid persistent dep list header: \", cache_path))\n      }\n    }\n  }\n}\n\nfn rebuild_persistent_type_env(bindings: Array[(String, Type)]) -> TypeEnv {\n  EnvFlat(bindings)\n}\n\n/// #906 Phase 2: the decode half of the type-env cache, split out of\n/// load_persistent_type_env so a value can be reconstituted from TEXT rather\n/// than only from a file at a fingerprint-derived path.\n///\n/// A worker checking a module with imports has to be handed its\n/// dependencies' public environments. It cannot go find them: the cache key\n/// is derived from the whole transitive source snapshot, which is exactly\n/// what a worker is not allowed to see. So the driver serializes each\n/// dependency env with persistent_type_env_cache_text and the worker decodes\n/// it here -- the same bytes the on-disk cache holds, moved as a value.\nexport fn parse_persistent_type_env(text: String) -> Option[TypeEnv] with { Error } {\n  let lines = String::split(normalize_persistent_cache_text(text), \"\\n\")\n  let len = Array::length(lines)\n  let rec go: (Int, Bool, Array[(String, Type)]) -> Option[TypeEnv] with { Error } = (index, version_ok, bindings) -> {\n    if index >= len {\n      if version_ok {\n        Some(rebuild_persistent_type_env(bindings))\n      } else {\n        None\n      }\n    } else {\n      let line = Array::get(lines, index)\n      if String::length(line) == 0 {\n        go(index + 1, version_ok, bindings)\n      } else {\n        let parts = String::split(line, \"\\t\")\n        if !version_ok {\n          if Array::length(parts) == 2 &&\n          Array::get(parts, 0) == \"version\" &&\n          Array::get(parts, 1) == \"1\" {\n            go(index + 1, true, bindings)\n          } else {\n            throw(String::concat(\"invalid persistent type env header: \", line))\n          }\n        } else if Array::length(parts) == 3 && Array::get(parts, 0) == \"bind\" {\n          let raw_type = Array::get(parts, 2)\n          let (ty, end_pos) = parse_cached_type(raw_type, 0)\n          if end_pos != String::length(raw_type) {\n            throw(String::concat(\"invalid persistent type env bind row: \", line))\n          } else {\n            Array::push(bindings, (Array::get(parts, 1), ty))\n            go(index + 1, true, bindings)\n          }\n        } else {\n          throw(String::concat(\"invalid persistent type env row: \", line))\n        }\n      }\n    }\n  }\n  go(0, false, array_empty())\n}\n\nexport fn load_persistent_type_env(fingerprint: String) -> Option[TypeEnv] with { Error, Fs } {\n  let path = persistent_type_env_cache_path(fingerprint)\n  if !(Fs::exists(path)) {\n    None\n  } else {\n    parse_persistent_type_env(Fs::read_file(path))\n  }\n}\n\nexport fn persistent_type_env_cache_text(env: TypeEnv) -> String {\n  let bindings = env_flat_bindings(env)\n  // StringBuilder over the bindings list — was O(N²) via `out =\n  // String::concat(out, ...)` for N bindings.\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, \"version\\t1\\n\")\n  let mut i = 0\n  while i < Array::length(bindings) {\n    let (name, ty) = Array::get(bindings, i)\n    StringBuilder::push(buf, \"bind\\t\")\n    StringBuilder::push(buf, name)\n    StringBuilder::push(buf, \"\\t\")\n    StringBuilder::push(buf, serialize_type(ty))\n    StringBuilder::push(buf, \"\\n\")\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport fn load_persistent_leaf_fingerprint(path: String, source: String) -> Option[String] with { Error, Fs } {\n  let cache_path = persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source))\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\n    let prefix = \"version\\t1\\n\"\n    if String::length(text) > String::length(prefix) &&\n    text[0: String::length(prefix)] == prefix {\n      Some(String::substring(text, String::length(prefix), String::length(text) - 1))\n    } else {\n      None\n    }\n  }\n}\n\nexport fn persistent_leaf_fingerprint_text(fingerprint: String) -> String {\n  String::concat(\"version\\t1\\n\", String::concat(fingerprint, \"\\n\"))\n}\n")
}

let cli_adapter_source_168 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/module_source.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Stmt, dce_keep_flags\n}\n\nimport @vibe/compiler/syntax {\n  lex_with_offsets, offset_to_line_col, parse_program_spans\n}\n\n//# Module source emission (port of host `emit-module-source`)\n\n/// Reconstruct a flat module source containing only the top-level statements\n/// reachable from `entry_name` (via DCE), emitted as their original source text.\n///\n/// Mirrors the MoonBit host `emit-module-source`\n/// (`src/cmd/vibe/cli_module_source.mbt`) but recovers statement source spans\n/// from the lexer (`lex_with_offsets`) + parser (`parse_program_spans`)\n/// instead of AST node spans, since the AST does not carry offsets.\n/// Pure: no filesystem or host calls.\nexport let build_module_source_from_source: (String, String) -> String with { Error } = (source, entry_name) -> {\n  let lexed = lex_with_offsets(source)\n  let tokens = lexed.0\n  let starts = lexed.1\n  let ends = lexed.2\n  let parsed = parse_program_spans(tokens, starts, ends)\n  let stmts = parsed.0\n  let span_start = parsed.1\n  let span_end = parsed.2\n  let keep = dce_keep_flags(stmts, [\n    entry_name\n  ])\n  let buf = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    if Array::get(keep, i) {\n      let s = Array::get(span_start, i)\n      let e = Array::get(span_end, i)\n      if e > s {\n        let snippet = String::substring(source, s, e)\n        StringBuilder::push(buf, snippet)\n        let n = String::length(snippet)\n        if n == 0 || String::char_code_at(snippet, n - 1) != '\\n' {\n          StringBuilder::push(buf, \"\\n\")\n        }\n      }\n    }\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\n/// debugger テーマ3 / M2: build a `.funcmap` sidecar text mapping each ENTRY-file\n/// top-level function definition to its 1-based source line, one `name<TAB>line\\n`\n/// per function. The launcher (`runtime/vibe`) reads this to annotate runtime trap\n/// backtrace frames (which name user functions via the wasm \"name\" section) with\n/// `(file:line)`.\n///\n/// MVP scope: ENTRY-file top-level functions only. Imported-module functions are\n/// not yet covered (future work) — they are flattened into the program at compile\n/// time but their original source lines are not recovered here.\n///\n/// Reuses the lexer offsets + parse_program_spans span table (same as\n/// build_module_source_from_source) so it needs no checker. A top-level `SLet`\n/// whose bound expr is a function (`EFn`) maps `name` -> line of the statement's\n/// start offset. All strings via String::concat + __to_string only (never `+`,\n/// never \"\\{}\" interpolation): both mis-codegen to NUL here.\nexport let build_funcmap_from_source: (String) -> String with { Error } = (source) -> {\n  let lexed = lex_with_offsets(source)\n  let tokens = lexed.0\n  let starts = lexed.1\n  let ends = lexed.2\n  let parsed = parse_program_spans(tokens, starts, ends)\n  let stmts = parsed.0\n  let span_start = parsed.1\n  let buf = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    let entry = match stmt {\n      SLet(_, _, name, _, expr) => match expr {\n        EFn(_, _, _, _, _, _) => {\n          let off = Array::get(span_start, i)\n          let lc = offset_to_line_col(source, off)\n          let line = lc.0\n          String::concat(name, String::concat(\"\\t\", String::concat(__to_string(line), \"\\n\")))\n        },\n        _ => \"\"\n      },\n      _ => \"\"\n    }\n    StringBuilder::push(buf, entry)\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n")
}

let cli_adapter_source_169 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/index.vpkg",
"name = @vibe/compiler/runtime\nversion = 0.0.1\ndescription =\n  #|@vibe/compiler/runtime — ADR-0070 / #897 compiler-internal contract,\ndeps = {\n  @vibe/compiler/cache : 0.0.1\n  @vibe/compiler/checker : 0.0.1\n  @vibe/compiler/codegen : 0.0.1\n  @vibe/compiler/core : 0.0.1\n  @vibe/compiler/loader : 0.0.1\n  @vibe/compiler/runtime/eval_loader : 0.0.1\n  @vibe/compiler/syntax : 0.0.1\n  @vibe/core : 0.2.0\n  @vibe/graph : 0.0.1\n}\n\ngenerated_hash =\n\n// @vibe/compiler/runtime — ADR-0070 / #897 compiler-internal contract,\n// compiler-internal batch 8. Directory-shared-scope package (originally 7\n// impl files, ~4275 lines; doc_at.vibe added under #854): the incremental\n// type-check database (`TypeDb` + the\n// db_new/db_set_source/db_check_env/db_typecheck*/db_merged_source/\n// db_module_source/db_load_artifact/db_store_artifact family, runtime.vibe),\n// module-source reconstruction for the debugger funcmap sidecar\n// (module_source.vibe), editor-query primitives backing `vibe type-at` /\n// `vibe binding-at` / `vibe symbols` / `vibe doc-at` (type_at.vibe,\n// binding_at.vibe, symbol_spans.vibe, doc_at.vibe), filesystem-driven\n// typecheck + diagnostics collection (typecheck_fs.vibe), and the\n// persistent dep-list / type-env / leaf-fingerprint cache codec\n// (persistent_env_codec.vibe).\n//\n// Naming: no collision on the established `git mv index.vibe <dirname>.vibe`\n// convention (runtime/runtime.vibe didn't exist), same as loader/'s batch —\n// the old index.vibe moved verbatim to runtime.vibe.\n//\n// runtime.vibe is NOT a pure facade — like loader.vibe's and\n// checker_facade.vibe's siblings, it carries substantial real implementation\n// of its own (the whole `TypeDb` incremental-cache state machine) in\n// addition to importing and re-exporting a hand-picked subset of its\n// siblings' surfaces via existing `export ./file.vibe { .. }` SReExport\n// blocks (module_source.vibe, type_at.vibe, binding_at.vibe,\n// symbol_spans.vibe, typecheck_fs.vibe — added under #847). Those blocks\n// stay untouched: this contract is now the actual source of truth for the\n// package's full export surface (all names below, across all 7 files), so\n// runtime.vibe's partial, hand-picked re-export list is no longer\n// load-bearing for outside callers — they reach every name here through\n// this contract regardless of what runtime.vibe itself re-exports, exactly\n// like checker_facade.vibe's and loader.vibe's partial lists after their\n// own batches.\n//\n// Two-level SReExport nesting wrinkle: typecheck_fs.vibe is itself a\n// substantial-impl file (933 lines: locate_type_error,\n// ensure_fingerprint_fs_impl, check_inline_wasm_fns,\n// collect_all_diagnostics) carrying its OWN `export ./persistent_env_codec.vibe\n// { .. }` SReExport block — one level deeper than loader/'s shape, where\n// only the top-level facade had the SReExport pattern, not a sibling too.\n// This turned out not to matter for the contract: `contract_sibling_impl_raws`\n// directory auto-discovery reaches persistent_env_codec.vibe directly\n// regardless of what re-exports what, so its 6 exports below are declared\n// straight from its own file grouping, exactly as if typecheck_fs.vibe's\n// SReExport didn't exist. Verified empirically via\n// scripts/unit_test_runner.sh (full run), not just assumed.\n//\n// `export let`-bound functions: module_source.vibe's two exports are\n// `export let name: (Params) -> Ret with { Error } = (params) -> { .. }`\n// bindings, not `export fn`. No other already-migrated vpkg contract had\n// this exact shape (checked via `grep -rn '^export let .*-> .* with {'`\n// across every migrated directory — no hits besides this one). Confirmed\n// this still fingerprints as an ordinary fn signature for\n// `collect_impl_fn_defs`/`check_contract`: the parser's\n// `apply_generic_fn_annotation` (lib/@vibe/parser/parser_expr.vibe) injects\n// the let annotation's declared return type and effect row into the\n// lambda's own `EFn` node when the lambda itself doesn't specify them, so\n// the contract can declare both plain `fn name(params) -> Ret with { Error }`\n// below exactly like every `export fn` — no special contract syntax needed.\n//\n// No exported types besides `TypeDb`: TypeEnv/Stmt/Type/Expr (../core) are\n// plain structural signature text here, not declared at all (checker/\n// loader/ precedent — ../core itself is not yet migrated to vpkg, out of\n// scope for this batch); RippleDb (../../../../lib/@vibe/graph) is likewise\n// left undeclared, already covered by graph's own contract. `TypeDb` itself\n// is declared `opaque`: its real definition wraps a private `TypeDbState`\n// payload (itself wrapping private `StringTriple` — neither is `export`ed\n// in runtime.vibe, so neither needs a contract entry at all), and no\n// consumer (in-repo, confirmed via repo-wide grep) ever constructs or\n// pattern-matches a `TypeDb` directly, only through db_new/db_set_source/\n// db_check_env/... — same precedent as graph.vpkg's opaque `RippleDb`.\n//\n// External-caller fixes (literal `runtime/index.vibe` /\n// `runtime/typecheck_fs.vibe` paths → bare `../runtime` / `./runtime`\n// package form, now that leaf-file imports from outside the package are\n// rejected by enforce_incoming_boundary_fs): cli_adapter.vibe,\n// cli_support.vibe (was importing check_inline_wasm_fns/locate_type_error\n// straight from typecheck_fs.vibe — neither is re-exported by runtime.vibe's\n// own facade block, but both are covered here so the package-form import\n// still resolves), entry/compiler/fs_compile/index.vibe,\n// entry/compiler/file_compile/file_compile.vibe,\n// entry/cli_cache/cli_cache.vibe. No import cycle found: none of runtime/'s\n// own dependencies (checker/, codegen/, loader/, syntax/, cache/\n// persistent_cache.vibe, ../../../../lib/@vibe/graph — all already vpkg or\n// plain leaf imports of non-vpkg directories) import back into runtime/;\n// loader/ imports `../runtime/eval_loader` (a distinct, already-migrated\n// subpackage), never this directory's own index.vpkg/runtime.vibe.\n//\n// Compiled into the compiler itself via compiler_sources_manifest.tsv\n// (group `runtime`): the old single `runtime/index.vibe` row becomes a\n// dual row (this contract + runtime/runtime.vibe); typecheck_fs.vibe,\n// type_at.vibe, binding_at.vibe, symbol_spans.vibe,\n// persistent_env_codec.vibe, module_source.vibe already had their own rows\n// and are unchanged.\n\n// --- runtime.vibe\nopaque type TypeDb\n\nfn db_new() -> TypeDb\nfn db_set_source(db: TypeDb, path: String, source: String) -> TypeDb\nfn db_check_env(db: TypeDb, path: String) -> Option[TypeEnv]\nfn db_typecheck_count(db: TypeDb) -> Int\nfn db_parse_count(db: TypeDb) -> Int\nfn db_merge_count(db: TypeDb) -> Int\nfn db_module_source_count(db: TypeDb) -> Int\nfn db_codegen_count(db: TypeDb) -> Int\nfn db_typecheck(db: TypeDb, path: String) -> TypeDb with { Error }\nfn db_typecheck_fs(db: TypeDb, path: String) -> TypeDb with { Error, Fs }\nfn db_program_source(db: TypeDb, path: String) -> (String, String, TypeDb) with { Error }\nfn db_merged_source(db: TypeDb, _entry_path: String, sources: Array[(String, String)]) -> (String, String, TypeDb) with { Error }\nfn db_grouped_merged_source(db: TypeDb, groups: Array[(String, Array[(String, String)])]) -> (String, String, TypeDb) with { Error }\nfn db_module_source(db: TypeDb, fingerprint: String, source: String) -> (String, TypeDb) with { Error }\nfn db_load_artifact(db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error }\nfn db_store_artifact(db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> TypeDb\n\n// --- module_source.vibe\nfn build_module_source_from_source(source: String, entry_name: String) -> String with { Error }\nfn build_funcmap_from_source(source: String) -> String with { Error }\n\n// --- type_at.vibe\nfn type_at_source(source: String, line: Int, col: Int) -> String\n\n// --- binding_at.vibe\nfn binding_occurrences(source: String, line: Int, col: Int) -> Array[(Int, Int)]\n\n// --- doc_at.vibe (#854): `///` doc comment lookup, same single-file-scope\n// limitation as type_at.vibe/binding_at.vibe above.\nfn doc_at_source(source: String, line: Int, col: Int) -> String\n\n// --- symbol_spans.vibe\nfn symbol_spans(source: String) -> Array[(String, Int, Int, Int)] with { Error }\n\n// --- typecheck_fs.vibe\nfn locate_type_error(source: String, msg: String) -> String\nfn ensure_fingerprint_fs_impl(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs }\n// #1100: memoized located lex+parse shared by the typecheck walk and the\n// merge (see typecheck_fs.vibe). Returns a fresh top-level statement array\n// on every call -- check_program mutates its argument in place.\nfn parse_program_with_path(path: String, source: String) -> Array[Stmt] with { Error }\n// #1239 step 4(D): the whole import graph, and its canonical rank order,\n// from ONE compiler process -- the host-side parallel pre-warm used to spawn\n// a VIBE_LIST_DEPS call per module to build the same DAG. Returns the\n// manifest text plus each planned module's INGESTED source, positionally in\n// the manifest's order. See typecheck_fs.vibe for the format and for why\n// both come off the same ingest step.\nfn module_plan_manifest_fs(entry_path: String) -> (String, Array[String]) with { Error, Fs }\n// #906 Phase 0: permute each node's dependency VISIT order (0 = identity,\n// the production default). Makes \"visit order cannot change the output\"\n// testable before any real parallelism exists -- see typecheck_fs.vibe.\nfn set_dep_order_seed(seed: Int) -> Unit\n// #1259 (#1239 step 5's prerequisite): collect one diagnostic per failing\n// module and raise them together in canonical order, instead of failing fast\n// on the first. Off by default -- off is byte-for-byte the previous walk.\n// See typecheck_fs.vibe for why the default stays off.\nfn set_collect_module_diagnostics(on: Bool) -> Unit\n// #1259 (#1239 step 8): record the walk's planned graph and its actual step\n// sequence to `path`, so the REAL compile path can be checked against\n// formal/VibeFormal/Compiler/Scheduler.lean instead of only a synthetic\n// worker. \"\" (the default) disables it entirely. See typecheck_fs.vibe for\n// the row format and scripts/scheduler_trace_oracle.sh for the checks.\nfn set_scheduler_trace_path(path: String) -> Unit\n// #906 Phase 1: the module job / outcome seam. `check_module` is the unit a\n// Phase 2 worker will receive; it takes no `Fs` row because every\n// dependency environment it needs is already a value inside the job, and\n// the driver performs all writes (commit_module_outcome, private). These\n// are exported with no cross-file caller yet on purpose -- the bootstrap\n// flatten drops a brand-new cross-file export and its first cross-file\n// caller when they land in the same commit.\n// Defined transparently here rather than as an opaque handle (perceus/\n// PerceusAction precedent): the field layout IS the worker contract.\n// dep_envs is the driver's resolved environment table -- the doc's\n// contract is \"ordered direct-dependency interfaces\", and this is a\n// superset (the whole cache), because build_import_env resolves import\n// paths against it and narrowing changes which entry an import binds to.\n// Narrowing to the direct deps is a prerequisite for real worker\n// isolation, not for this seam.\n// `fingerprint` is deliberately NOT a field here. An earlier cut had the\n// caller supply one, which check_module simply echoed back into `Checked`\n// without ever consulting it -- a purely decorative field that made every\n// worker-computed cache key caller-chosen rather than derived, so nothing\n// a worker published could ever land at the same persistent-cache path the\n// serial walk (build_fingerprint in typecheck_fs.vibe) would look under.\n// `dep_fps` carries each dependency's OWN correctly-computed fingerprint,\n// in the same declaration order as `deps`/`dep_envs` (build_fingerprint\n// folds it as an ordered sequence, not a set), so check_module can compute\n// the canonical fingerprint itself via build_fingerprint(source, dep_fps)\n// -- an OUTPUT of the job, not an input to it.\nstruct ModuleJob {\n  path: String;\n  source: String;\n  deps: Array[String];\n  dep_fps: Array[(String, String)];\n  dep_envs: Array[(String, TypeEnv)]\n}\n// Declared opaque like graph's RippleDb / json's RpcMessage: nothing\n// outside the package inspects it yet. Phase 2's driver will need either\n// accessors or a real variant declaration here.\nopaque type ModuleOutcome\nfn check_module(job: ModuleJob) -> ModuleOutcome with { Error }\n// #906 Phase 2: the worker transport entry. `dir` is a job directory and\n// is the worker's ENTIRE filesystem sandbox -- see typecheck_fs.vibe for\n// its layout and for why the job's `path` row must be the module's logical\n// path rather than the materialized temp file.\nfn run_module_job_dir(dir: String) -> Unit with { Error, Fs }\n// #906 Phase 2 (real-build wiring): the batch counterpart to\n// run_module_job_dir. A host-side parallel pre-warm driver runs many workers\n// against private job-dir sandboxes, then makes ONE call here with a\n// directory holding `manifest.txt` (one `<fingerprint>\\t<envfile>` row per\n// successfully-checked module) plus each row's env file, verbatim from that\n// job's `env.out`. This writes each env to the REAL persistent-cache path\n// a serial compile would look under -- not the job-dir sandbox -- so the\n// driver never re-derives persistent_type_env_cache_path itself (that path\n// folds in this build's own codegen_fingerprint, which a host process has\n// no way to reproduce without risking the exact drift #906's dep_fps fix\n// closed for cache keys, applied to paths instead). Diagnosed modules are\n// simply absent from the manifest; the always-run serial fallback rechecks\n// them and produces the identical diagnostic, so correctness never depends\n// on this call succeeding.\nfn run_publish_env_cache_dir(dir: String) -> Unit with { Error, Fs }\nfn check_inline_wasm_fns(stmts: Array[Stmt]) -> Option[String]\nfn collect_all_diagnostics(source: String) -> Array[String] with { Error }\n\n// --- persistent_env_codec.vibe\nfn persistent_dep_list_text(deps: Array[String]) -> String\nfn load_persistent_dep_list(path: String, source: String) -> Option[Array[String]] with { Error, Fs }\nfn load_persistent_type_env(fingerprint: String) -> Option[TypeEnv] with { Error, Fs }\n// #906 Phase 2: the decode half of the above, split out so a dependency's\n// environment can be reconstituted from TEXT. A worker cannot look its own\n// dependencies up in the cache -- the key derives from the whole\n// transitive source snapshot -- so the driver hands them over as values.\nfn parse_persistent_type_env(text: String) -> Option[TypeEnv] with { Error }\nfn persistent_type_env_cache_text(env: TypeEnv) -> String\nfn load_persistent_leaf_fingerprint(path: String, source: String) -> Option[String] with { Error, Fs }\nfn persistent_leaf_fingerprint_text(fingerprint: String) -> String\n")
}

let cli_adapter_source_170 = () -> (String, String) {
  ("lib/@vibe/compiler/runtime/runtime.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  ExportRenamePlan,\n  Stmt,\n  Type,\n  TypeEnv,\n  append_import_alias_rewritten_non_import_stmts_with_renames,\n  append_non_import_stmts_without_alias_rewrite,\n  apply_export_renames_stmts,\n  build_export_rename_plan,\n  collect_import_alias_collision_locals,\n  collect_import_alias_collision_refs,\n  collect_import_value_renames,\n  dir_of_path,\n  env_bind,\n  env_flat_bindings,\n  env_lookup_flat,\n  export_plan_fingerprint_text,\n  export_plan_renames_for,\n  import_value_rename_locals,\n  namespace_private_value_stmts,\n  resolve_import_path,\n  resolve_import_path_candidates,\n  rewrite_imported_value_stmt_to_local,\n  stmts_have_import_deep\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/checker {\n  check_program_with_env\n}\n\nimport @vibe/compiler/runtime/eval_loader {\n  contains_str\n}\n\nimport ./typecheck_fs.vibe {\n  ensure_fingerprint_fs_impl,\n  load_persistent_dep_list,\n  load_persistent_leaf_fingerprint,\n  load_persistent_type_env,\n  persistent_dep_list_text,\n  persistent_leaf_fingerprint_text,\n  persistent_type_env_cache_text\n}\n\nimport @vibe/compiler/syntax {\n  lex, parse_program, print_program\n}\n\nimport @vibe/compiler/loader {\n  load_or_parse_module_header_fs\n}\n\nimport @vibe/compiler/cache {\n  persistent_dep_list_cache_path, persistent_leaf_fingerprint_cache_path, persistent_type_env_cache_path\n}\n\nimport @vibe/graph {\n  RippleDb, ripple_eval_count, ripple_get_deps, ripple_get_fingerprint, ripple_get_source, ripple_new, ripple_record_eval, ripple_set_source\n}\n\n// #847 Phase C: facade re-exports so external callers reach this directory\n// only through runtime/index.vibe, not its internal files directly.\nexport ./module_source.vibe {\n  build_funcmap_from_source, build_module_source_from_source\n}\n\nexport ./type_at.vibe {\n  type_at_source\n}\n\nexport ./binding_at.vibe {\n  binding_occurrences\n}\n\nexport ./symbol_spans.vibe {\n  symbol_spans\n}\n\nexport ./typecheck_fs.vibe {\n  collect_all_diagnostics, module_plan_manifest_fs\n}\n\n// Note: `eval_loader/` has its own `index.vibe` and is already its own\n// boundary (ADR-0063 applies recursively) — its two external callers\n// (`loader/index.vibe`, `loader/header_cache.vibe`) already import it via\n// that index, not an internal file, so it needs no re-export here. Routing\n// it through this facade instead would also create an import cycle: this\n// file already imports `../loader { load_or_parse_module_header_fs }`, so\n// `loader/index.vibe` importing back through `runtime/index.vibe` would be\n// `loader -> runtime/index.vibe -> loader`.\n\n//# Types\n\nenum StringTriple {\n  StringTriple(String, String, String)\n}\n\nenum TypeDbState {\n  TypeDbState(RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Array[StringTriple], Array[StringTriple], Array[StringTriple], Int, Int, Int, Int)\n}\n\nexport enum TypeDb {\n  TypeDb(TypeDbState)\n}\n\n//# Functions\n\nfn unwrap_db(db: TypeDb) -> TypeDbState {\n  match db {\n    TypeDb(state) => state\n  }\n}\n\nfn wrap_db(state: TypeDbState) -> TypeDb {\n  TypeDb(state)\n}\n\nfn parse_program_with_path(path: String, source: String) -> Array[Stmt] with { Error } {\n  handle {\n    parse_program(lex(source))\n  } with Error {\n    Throw(msg) => throw(String::concat(String::concat(path, \": \"), msg))\n  }\n}\n\nfn add_dep(acc: Array[String], raw_path: String, base_dir: String) -> Array[String] {\n  // Mutates `acc` in place. Caller pattern is `acc = add_dep(acc, ...)`\n  // so the same reference is returned either way.\n  if String::length(raw_path) == 0 {\n    acc\n  } else {\n    let resolved = resolve_import_path(base_dir, raw_path)\n    if contains_str(acc, resolved) {\n      acc\n    } else {\n      Array::push(acc, resolved)\n      acc\n    }\n  }\n}\n\nfn empty_strings() -> Array[String] {\n  array_empty()\n}\n\nfn empty_dep_fps() -> Array[(String, String)] {\n  array_empty()\n}\n\nfn empty_env_cache() -> Array[(String, TypeEnv)] {\n  array_empty()\n}\n\nfn empty_string_pairs() -> Array[(String, String)] {\n  array_empty()\n}\n\nfn empty_string_triples() -> Array[StringTriple] {\n  array_empty()\n}\n\nfn empty_stmt_array() -> Array[Stmt] {\n  array_empty()\n}\n\nexport fn db_new() -> TypeDb {\n  wrap_db(TypeDbState(ripple_new(), empty_env_cache(), empty_string_pairs(), empty_string_triples(), empty_string_triples(), empty_string_triples(), 0, 0, 0, 0))\n}\n\nfn lookup_string_pair(pairs: Array[(String, String)], key: String) -> Option[String] {\n  let len = Array::length(pairs)\n  let rec go: (Int) -> Option[String] = (i) -> {\n    if i >= len {\n      None\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        Some(v)\n      } else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nfn upsert_string_pair(pairs: Array[(String, String)], key: String, value: String) -> Array[(String, String)] {\n  let len = Array::length(pairs)\n  let b = ArrayBuilder::new()\n  let rec build: (Int) -> Array[(String, String)] = (i) -> {\n    if i >= len {\n      ArrayBuilder::push(b, (key, value))\n      ArrayBuilder::freeze(b)\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        build(i + 1)\n      } else {\n        ArrayBuilder::push(b, (k, v))\n        build(i + 1)\n      }\n    }\n  }\n  build(0)\n}\n\nfn lookup_source_cache(cache: Array[StringTriple], path: String, fingerprint: String) -> Option[String] {\n  let len = Array::length(cache)\n  let rec go: (Int) -> Option[String] = (i) -> {\n    if i >= len {\n      None\n    } else {\n      match Array::get(cache, i) {\n        StringTriple(p, fp, source) =>\n        if p == path && fp == fingerprint {\n          Some(source)\n        } else {\n          go(i + 1)\n        }\n      }\n    }\n  }\n  go(0)\n}\n\nfn upsert_source_cache(cache: Array[StringTriple], path: String, fingerprint: String, source: String) -> Array[StringTriple] {\n  // O(N) in-place rebuild: previously each `Array::concat(acc, [x])`\n  // copied the entire prefix per iteration → O(N^2) for large source\n  // caches.\n  let out = empty_string_triples()\n  let mut i = 0\n  let len = Array::length(cache)\n  while i < len {\n    match Array::get(cache, i) {\n      StringTriple(p, fp, existing) =>\n      if p == path && fp == fingerprint {\n        ()\n      } else {\n        Array::push(out, StringTriple(p, fp, existing))\n      }\n    }\n    i = i + 1\n  }\n  Array::push(out, StringTriple(path, fingerprint, source))\n  out\n}\n\nfn append_source_cache_entries(cache: Array[StringTriple], entries: Array[StringTriple]) -> Array[StringTriple] {\n  if Array::length(entries) == 0 {\n    cache\n  } else {\n    let out = empty_string_triples()\n    let mut i = 0\n    while i < Array::length(cache) {\n      Array::push(out, Array::get(cache, i))\n      i = i + 1\n    }\n    let mut j = 0\n    while j < Array::length(entries) {\n      Array::push(out, Array::get(entries, j))\n      j = j + 1\n    }\n    out\n  }\n}\n\nexport fn db_set_source(db: TypeDb, path: String, source: String) -> TypeDb {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\n    wrap_db(TypeDbState(ripple_set_source(rdb, path, source), env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count))\n  }\n}\n\nfn lookup_env_cache(cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\n  let len = Array::length(cache)\n  let rec go: (Int) -> Option[TypeEnv] = (i) -> {\n    if i >= len {\n      None\n    } else {\n      let (p, env) = Array::get(cache, i)\n      if p == path {\n        Some(env)\n      } else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nfn resolve_cached_import_path(base_dir: String, raw_path: String, cache: Array[(String, TypeEnv)]) -> String {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut selected = \"\"\n  let mut i = 0\n  while i < Array::length(candidates) && selected == \"\" {\n    let candidate = Array::get(candidates, i)\n    match lookup_env_cache(cache, candidate) {\n      Some(_) => {\n        selected = candidate\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  if selected == \"\" {\n    resolve_import_path(base_dir, raw_path)\n  } else {\n    selected\n  }\n}\n\nexport fn db_check_env(db: TypeDb, path: String) -> Option[TypeEnv] {\n  match unwrap_db(db) {\n    TypeDbState(_, cache, _, _, _, _, _, _, _, _) => lookup_env_cache(cache, path)\n  }\n}\n\nfn starts_with_upper(name: String) -> Bool {\n  if String::length(name) == 0 {\n    false\n  } else {\n    let c = String::char_code_at(name, 0)\n    c >= 65 && c <= 90\n  }\n}\n\nfn type_returns_name(ty: Type, type_name: String) -> Bool {\n  match ty {\n    CtEnum(name) => name == type_name,\n    CtNamed(name, _) => name == type_name,\n    CtFn(_, ret, _) => type_returns_name(ret, type_name),\n    CtForAll(_, _, body) => type_returns_name(body, type_name),\n    _ => false\n  }\n}\n\nfn bind_enum_constructor_companions(acc: TypeEnv, dep_bindings: Array[(String, Type)], enum_name: String) -> TypeEnv {\n  let mut out = acc\n  let mut i = 0\n  while i < Array::length(dep_bindings) {\n    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)\n    if candidate_name != enum_name && starts_with_upper(candidate_name) && type_returns_name(candidate_ty, enum_name) {\n      out = env_bind(out, candidate_name, candidate_ty)\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn bind_import_names_from_cache(acc: TypeEnv, resolved: String, names: Array[(String, Option[String])], cache: Array[(String, TypeEnv)]) -> TypeEnv {\n  let dep_env = match lookup_env_cache(cache, resolved) {\n    Some(e) => e,\n    None => EnvEmpty\n  }\n  let dep_bindings = env_flat_bindings(dep_env)\n  let nlen = Array::length(names)\n  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {\n    if j >= nlen {\n      nacc\n    } else {\n      let (name, alias) = Array::get(names, j)\n      let bound_name = match alias {\n        Some(a) => a,\n        None => name\n      }\n      let ty = match env_lookup_flat(dep_bindings, name) {\n        Some(t) => t,\n        None => CtUnknown\n      }\n      let with_name = env_bind(nacc, bound_name, ty)\n      let with_companions = match ty {\n        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),\n        _ => if starts_with_upper(name) {\n          bind_enum_constructor_companions(with_name, dep_bindings, name)\n        } else {\n          with_name\n        }\n      }\n      bind_names(j + 1, with_companions)\n    }\n  }\n  bind_names(0, acc)\n}\n\nfn build_import_env(stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv {\n  let len = Array::length(stmts)\n  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        SReExport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, EnvEmpty)\n}\n\nfn upsert_env_cache(cache: Array[(String, TypeEnv)], path: String, env: TypeEnv) -> Array[(String, TypeEnv)] {\n  let len = Array::length(cache)\n  let b = ArrayBuilder::new()\n  let rec build: (Int) -> Array[(String, TypeEnv)] = (i) -> {\n    if i >= len {\n      ArrayBuilder::push(b, (path, env))\n      ArrayBuilder::freeze(b)\n    } else {\n      let (p, e) = Array::get(cache, i)\n      if p == path {\n        build(i + 1)\n      } else {\n        ArrayBuilder::push(b, (p, e))\n        build(i + 1)\n      }\n    }\n  }\n  build(0)\n}\n\nfn compact_string_fingerprint(source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(__to_string(len), String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2)))))\n}\n\nfn store_persistent_type_env(fingerprint: String, env: TypeEnv) -> Unit with { Error, Fs } {\n  Fs::write_file(persistent_type_env_cache_path(fingerprint), persistent_type_env_cache_text(env))\n}\n\nfn build_fingerprint(source: String, dep_fps: Array[(String, String)]) -> String {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let dep_pair = Array::get(dep_fps, i)\n    let dep_path = dep_pair.0\n    let dep_fp = dep_pair.1\n    let next = String::concat(acc, String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp))))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport fn db_typecheck_count(db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) => ripple_eval_count(rdb)\n  }\n}\n\nexport fn db_parse_count(db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, parse_count, _, _, _) => parse_count\n  }\n}\n\nexport fn db_merge_count(db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, merge_count, _, _) => merge_count\n  }\n}\n\nexport fn db_module_source_count(db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, _, module_source_count, _) => module_source_count\n  }\n}\n\nexport fn db_codegen_count(db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, _, _, codegen_count) => codegen_count\n  }\n}\n\nfn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String) -> Array[String] {\n  let len = Array::length(stmts)\n  let rec go: (Int, Array[String]) -> Array[String] = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, _) => add_dep(acc, raw_path, base_dir),\n        SReExport(raw_path, _) => add_dep(acc, raw_path, base_dir),\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, empty_strings())\n}\n\nfn resolve_deps_for_source(rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error } {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n    if cached_source == source {\n      match ripple_get_deps(rdb, path) {\n        Some(deps) => (deps, dep_source_cache, parse_count),\n        None => {\n          let stmts = parse_program_with_path(path, source)\n          let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\n          (deps, upsert_string_pair(dep_source_cache, path, source), parse_count + 1)\n        }\n      }\n    } else {\n      let stmts = parse_program_with_path(path, source)\n      let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\n      (deps, upsert_string_pair(dep_source_cache, path, source), parse_count + 1)\n    },\n    None => {\n      let stmts = parse_program_with_path(path, source)\n      let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\n      (deps, upsert_string_pair(dep_source_cache, path, source), parse_count + 1)\n    }\n  }\n}\n\nfn load_or_parse_deps_for_source_fs(dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\n  match load_persistent_dep_list(path, source) {\n    Some(deps) => (deps, upsert_string_pair(dep_source_cache, path, source), parse_count),\n    None => {\n      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\n      (deps, upsert_string_pair(dep_source_cache, path, source), next_parse_count)\n    }\n  }\n}\n\nfn resolve_deps_for_source_fs(rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n    if cached_source == source {\n      match ripple_get_deps(rdb, path) {\n        Some(deps) => (deps, dep_source_cache, parse_count),\n        None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n      }\n    } else {\n      load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n    },\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n  }\n}\n\nfn ensure_fingerprint(rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, stack: Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } {\n  if contains_str(stack, path) {\n    throw(String::concat(\"type_db: import cycle detected at \", path))\n  } else {\n    match ripple_get_source(rdb, path) {\n      None => (String::concat(\"missing:\", path), rdb, env_cache, dep_source_cache, parse_count),\n      Some(source) => {\n        let (deps, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source(rdb, dep_source_cache, path, source, parse_count)\n        let dlen = Array::length(deps)\n        // Cycle-detection stack: push self before recursing, truncate back after.\n        // O(1) per frame vs. previous Array::concat(stack, [path]) which was O(depth) per frame.\n        let saved_stack_len = Array::length(stack)\n        Array::push(stack, path)\n        // Tail-recursive over `deps`, accumulating (dep_path, dep_fp)\n        // pairs into `dep_acc`. Previously each recursion did\n        // `Array::concat(dep_acc, [tuple])` — O(N) copy per step,\n        // O(N²) over the deps list. Mutating in place is safe because\n        // `dep_acc` flows linearly down the recursion (one path, no\n        // sibling branches that need the old prefix).\n        let rec resolve_nested: (Int, Array[(String, String)], RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) -> (Array[(String, String)], RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } = (i, dep_acc, dep_db, dep_env_cache, dep_source_cache2, dep_parse_count) -> {\n          if i >= dlen {\n            (dep_acc, dep_db, dep_env_cache, dep_source_cache2, dep_parse_count)\n          } else {\n            let dep_path = Array::get(deps, i)\n            let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint(dep_db, dep_env_cache, dep_source_cache2, dep_parse_count, dep_path, stack)\n            Array::push(dep_acc, (dep_path, dep_fp))\n            resolve_nested(i + 1, dep_acc, next_db, next_env_cache, next_dep_source_cache2, next_parse_count)\n          }\n        }\n        let resolved_nested = resolve_nested(0, empty_dep_fps(), rdb, env_cache, next_dep_source_cache, initial_parse_count)\n        Array::truncate(stack, saved_stack_len)\n        let dep_fps = resolved_nested.0\n        let db_after_deps = resolved_nested.1\n        let env_cache_after_deps = resolved_nested.2\n        let dep_source_cache_after_deps = resolved_nested.3\n        let parse_count_after_deps = resolved_nested.4\n        let fingerprint = build_fingerprint(source, dep_fps)\n        match ripple_get_fingerprint(db_after_deps, path) {\n          Some(cached_fp) =>\n          if cached_fp == fingerprint {\n            (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\n          } else {\n            let stmts = parse_program_with_path(path, source)\n            let final_parse_count = parse_count_after_deps + 1\n            let import_env = build_import_env(stmts, dir_of_path(path), env_cache_after_deps)\n            let checked_env = check_program_with_env(stmts, import_env)\n            let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\n            let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\n            (fingerprint, next_db, next_env_cache, dep_source_cache_after_deps, final_parse_count)\n          },\n          None => {\n            let stmts = parse_program_with_path(path, source)\n            let final_parse_count = parse_count_after_deps + 1\n            let import_env = build_import_env(stmts, dir_of_path(path), env_cache_after_deps)\n            let checked_env = check_program_with_env(stmts, import_env)\n            let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\n            let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\n            (fingerprint, next_db, next_env_cache, dep_source_cache_after_deps, final_parse_count)\n          }\n        }\n      }\n    }\n  }\n}\n\nexport fn db_typecheck(db: TypeDb, path: String) -> TypeDb with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let (_, next_rdb, next_env_cache, next_dep_source_cache, next_parse_count) = ensure_fingerprint(rdb, env_cache, dep_source_cache, parse_count, path, empty_strings())\n      wrap_db(TypeDbState(next_rdb, next_env_cache, next_dep_source_cache, merged_cache, module_source_cache, artifact_cache, next_parse_count, merge_count, module_source_count, codegen_count))\n    }\n  }\n}\n\nexport fn db_typecheck_fs(db: TypeDb, path: String) -> TypeDb with { Error, Fs } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let (_, next_rdb, next_env_cache, next_dep_source_cache, next_parse_count) = ensure_fingerprint_fs_impl(rdb, env_cache, dep_source_cache, parse_count, path)\n      wrap_db(TypeDbState(next_rdb, next_env_cache, next_dep_source_cache, merged_cache, module_source_cache, artifact_cache, next_parse_count, merge_count, module_source_count, codegen_count))\n    }\n  }\n}\n\nexport fn db_program_source(db: TypeDb, path: String) -> (String, String, TypeDb) with { Error } {\n  let checked = db_typecheck(db, path)\n  match unwrap_db(checked) {\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) =>\n    match ripple_get_source(rdb, path) {\n      None => throw(String::concat(\"missing:\", path)),\n      Some(source) =>\n      match ripple_get_fingerprint(rdb, path) {\n        Some(fingerprint) => (source, fingerprint, checked),\n        None => (source, source, checked)\n      }\n    }\n  }\n}\n\nfn build_merge_fingerprint(sources: Array[(String, String)]) -> String {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (_, source) = Array::get(sources, i)\n    let next = String::concat(acc, String::concat(\"|\", compact_string_fingerprint(source)))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nfn lookup_source_by_path(sources: Array[(String, String)], target_path: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    if path == target_path {\n      found = Some(source)\n      i = Array::length(sources)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n/// #716: collision-def fallback (see merge_sources.vibe). `excluded_locals`\n/// are the locals the export-rename plan already rewrites; the inline copy gets\n/// the target file's export renames applied first.\nfn append_import_alias_collision_defs_from_sources(merged: Array[Stmt], current_path: String, stmts: Array[Stmt], sources: Array[(String, String)], plan: ExportRenamePlan, excluded_locals: Array[String]) -> Unit with { Error } {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = array_empty()\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !contains_str(emitted, local) && !contains_str(excluded_locals, local) {\n      let resolved = resolve_import_path(base_dir, raw_path)\n      match lookup_source_by_path(sources, resolved) {\n        Some(source) => {\n          let source_stmts = namespace_private_value_stmts(resolved, apply_export_renames_stmts(parse_program_with_path(resolved, source), export_plan_renames_for(plan, resolved)))\n          let mut j = 0\n          let mut done = false\n          while j < Array::length(source_stmts) && !done {\n            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n              Some(local_stmt) => {\n                Array::push(merged, local_stmt)\n                Array::push(emitted, local)\n                done = true\n              },\n              None => ()\n            }\n            j = j + 1\n          }\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n}\n\n/// #716: parse every source once and expose (paths, stmts) for the export-\n/// rename plan; the merge itself reuses the parsed statements.\nfn parse_merge_sources(sources: Array[(String, String)]) -> (Array[String], Array[Array[Stmt]]) with { Error } {\n  let file_paths = array_empty()\n  let file_stmts = array_empty()\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (path, source) = Array::get(sources, si)\n    Array::push(file_paths, path)\n    Array::push(file_stmts, parse_program_with_path(path, source))\n    si = si + 1\n  }\n  (file_paths, file_stmts)\n}\n\n/// One (sub)list of sources merged under a whole-program rename plan.\n/// `collision_sources` spans the whole program so a collision-def import that\n/// crosses a group boundary still resolves.\nfn build_merged_source_with_plan(entry_path: String, sources: Array[(String, String)], file_paths: Array[String], file_stmts: Array[Array[Stmt]], plan: ExportRenamePlan, collision_sources: Array[(String, String)]) -> String with { Error } {\n  let merged = empty_stmt_array()\n  let source_count = Array::length(sources)\n  let mut si = 0\n  while si < source_count {\n    let path = Array::get(file_paths, si)\n    let stmts = Array::get(file_stmts, si)\n    let is_entry_source = if entry_path == \"\" {\n      si == source_count - 1\n    } else {\n      path == entry_path\n    }\n    let export_renamed = if is_entry_source {\n      stmts\n    } else {\n      apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))\n    }\n    let namespaced_stmts = if is_entry_source {\n      export_renamed\n    } else {\n      namespace_private_value_stmts(path, export_renamed)\n    }\n    if stmts_have_import_deep(stmts) {\n      let import_renames = collect_import_value_renames(plan, path, stmts)\n      let skipped_locals = collect_import_alias_collision_locals(stmts)\n      append_import_alias_collision_defs_from_sources(merged, path, stmts, collision_sources, plan, import_value_rename_locals(import_renames))\n      append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)\n    } else {\n      append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\n    }\n    si = si + 1\n  }\n  print_program(merged)\n}\n\nfn build_merged_source(entry_path: String, sources: Array[(String, String)]) -> String with { Error } {\n  let (file_paths, file_stmts) = parse_merge_sources(sources)\n  let plan_entry = if entry_path == \"\" {\n    if Array::length(file_paths) > 0 {\n      Array::get(file_paths, Array::length(file_paths) - 1)\n    } else {\n      \"\"\n    }\n  } else {\n    entry_path\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  build_merged_source_with_plan(entry_path, sources, file_paths, file_stmts, plan, sources)\n}\n\nfn join_group_sources(group_sources: Array[String]) -> String {\n  let len = Array::length(group_sources)\n  // O(N) via StringBuilder; the recursive `String::concat(acc, ...)` was\n  // O(N²) over the source-group count.\n  let buf = StringBuilder::new()\n  let mut i = 0\n  while i < len {\n    let source = Array::get(group_sources, i)\n    if i > 0 {\n      StringBuilder::push(buf, \"\\n\")\n    }\n    StringBuilder::push(buf, source)\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport fn db_merged_source(db: TypeDb, _entry_path: String, sources: Array[(String, String)]) -> (String, String, TypeDb) with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let merge_fingerprint = build_merge_fingerprint(sources)\n      let merge_cache_key = \"merged\"\n      match lookup_source_cache(merged_cache, merge_cache_key, merge_fingerprint) {\n        Some(merged_source) => (merged_source, merge_fingerprint, db),\n        None => {\n          let merged_source = build_merged_source(_entry_path, sources)\n          let next_merged_cache = upsert_source_cache(merged_cache, merge_cache_key, merge_fingerprint, merged_source)\n          (merged_source, merge_fingerprint, wrap_db(TypeDbState(rdb, env_cache, dep_source_cache, next_merged_cache, module_source_cache, artifact_cache, parse_count, merge_count + 1, module_source_count, codegen_count)))\n        }\n      }\n    }\n  }\n}\n\nexport fn db_grouped_merged_source(db: TypeDb, groups: Array[(String, Array[(String, String)])]) -> (String, String, TypeDb) with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      // Keep per-group results in side buffers, then append cache misses\n      // once. Rebuilding the full cache on every group miss is O(N^2) for\n      // the ~150-group compiler manifest.\n      let group_sources = empty_strings()\n      let mut grouped_fingerprint = \"merged-groups\"\n      let new_group_cache_entries = empty_string_triples()\n      let mut merge_count_acc = merge_count\n      // #716: the export-rename plan spans ALL groups (imports cross group\n      // boundaries), so every source is parsed once up front and the plan\n      // fingerprint is folded into each group's cache fingerprint — a change\n      // to the program's ambiguous-export set invalidates cached group merges\n      // even when the group's own sources are unchanged.\n      let flat_sources = array_empty()\n      let mut fgi = 0\n      while fgi < Array::length(groups) {\n        let (_, gsources) = Array::get(groups, fgi)\n        let mut fsi = 0\n        while fsi < Array::length(gsources) {\n          Array::push(flat_sources, Array::get(gsources, fsi))\n          fsi = fsi + 1\n        }\n        fgi = fgi + 1\n      }\n      let (flat_paths, flat_stmts) = parse_merge_sources(flat_sources)\n      let plan_entry = if Array::length(flat_paths) > 0 {\n        Array::get(flat_paths, Array::length(flat_paths) - 1)\n      } else {\n        \"\"\n      }\n      let plan = build_export_rename_plan(flat_paths, flat_stmts, plan_entry)\n      let plan_fp = compact_string_fingerprint(export_plan_fingerprint_text(plan))\n      let mut flat_idx = 0\n      let mut i = 0\n      while i < Array::length(groups) {\n        let (group_name, sources) = Array::get(groups, i)\n        let group_start = flat_idx\n        flat_idx = flat_idx + Array::length(sources)\n        let fingerprint = compact_string_fingerprint(String::concat(build_merge_fingerprint(sources), String::concat(\"#\", plan_fp)))\n        let grouped_next = String::concat(grouped_fingerprint, String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint))))\n        grouped_fingerprint = compact_string_fingerprint(grouped_next)\n        let cache_key = String::concat(\"merged-group|\", group_name)\n        match lookup_source_cache(merged_cache, cache_key, fingerprint) {\n          Some(source) => {\n            Array::push(group_sources, source)\n          },\n          None =>\n          match lookup_source_cache(new_group_cache_entries, cache_key, fingerprint) {\n            Some(source) => {\n              Array::push(group_sources, source)\n            },\n            None => {\n              let group_paths = Array::slice(flat_paths, group_start, group_start + Array::length(sources))\n              let group_stmts = Array::slice(flat_stmts, group_start, group_start + Array::length(sources))\n              // #740: pass the WHOLE-merge plan entry, not \"\" — the empty\n              // entry made build_merged_source_with_plan treat the last\n              // file of EVERY GROUP as the entry (exports unrenamed), so\n              // group tails (ripple.vibe, desugar_trait_dict.vibe, ...)\n              // were missing their `_exp_` defs while callers referenced\n              // them.\n              let source = build_merged_source_with_plan(plan_entry, sources, group_paths, group_stmts, plan, flat_sources)\n              Array::push(new_group_cache_entries, StringTriple(cache_key, fingerprint, source))\n              merge_count_acc = merge_count_acc + 1\n              Array::push(group_sources, source)\n            }\n          }\n        }\n        i = i + 1\n      }\n      let next_merged_cache = append_source_cache_entries(merged_cache, new_group_cache_entries)\n      let next_merge_count = merge_count_acc\n      let grouped_cache_key = \"merged-groups\"\n      match lookup_source_cache(next_merged_cache, grouped_cache_key, grouped_fingerprint) {\n        Some(source) =>\n        (source, grouped_fingerprint, wrap_db(TypeDbState(rdb, env_cache, dep_source_cache, next_merged_cache, module_source_cache, artifact_cache, parse_count, next_merge_count, module_source_count, codegen_count))),\n        None => {\n          let source = join_group_sources(group_sources)\n          let final_merged_cache = upsert_source_cache(next_merged_cache, grouped_cache_key, grouped_fingerprint, source)\n          (source, grouped_fingerprint, wrap_db(TypeDbState(rdb, env_cache, dep_source_cache, final_merged_cache, module_source_cache, artifact_cache, parse_count, next_merge_count + 1, module_source_count, codegen_count)))\n        }\n      }\n    }\n  }\n}\n\nfn build_module_source(source: String) -> String with { Error } {\n  let stmts = parse_program(lex(source))\n  let filtered = empty_stmt_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    let keep = match stmt {\n      SLet(_, _, _, _, expr) => {\n        match expr {\n          EFn(_, _, _, _, _, _) => true,\n          _ => false\n        }\n      },\n      _ => false\n    }\n    if keep {\n      Array::push(filtered, stmt)\n    }\n    i = i + 1\n  }\n  print_program(filtered)\n}\n\nexport fn db_module_source(db: TypeDb, fingerprint: String, source: String) -> (String, TypeDb) with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let module_cache_key = \"module-source\"\n      match lookup_source_cache(module_source_cache, module_cache_key, fingerprint) {\n        Some(module_source) => (module_source, db),\n        None => {\n          let module_source = build_module_source(source)\n          let next_module_source_cache = upsert_source_cache(module_source_cache, module_cache_key, fingerprint, module_source)\n          (module_source, wrap_db(TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, next_module_source_cache, artifact_cache, parse_count, merge_count, module_source_count + 1, codegen_count)))\n        }\n      }\n    }\n  }\n}\n\nfn artifact_cache_key(kind: String, entry_name: String) -> String {\n  String::concat(kind, String::concat(\"|\", entry_name))\n}\n\nfn bytes_to_hex_digit(n: Int) -> String {\n  if n < 10 {\n    __to_string(n)\n  } else if n == 10 {\n    \"a\"\n  } else if n == 11 {\n    \"b\"\n  } else if n == 12 {\n    \"c\"\n  } else if n == 13 {\n    \"d\"\n  } else if n == 14 {\n    \"e\"\n  } else {\n    \"f\"\n  }\n}\n\nfn nibble_from_hex_char(c: Int) -> Int with { Error } {\n  if c >= 48 && c <= 57 {\n    c - 48\n  } else if c >= 97 && c <= 102 {\n    c - 87\n  } else if c >= 65 && c <= 70 {\n    c - 55\n  } else {\n    throw(\"invalid hex digit\")\n  }\n}\n\nfn bytes_to_hex(bytes: Bytes) -> String {\n  let len = Bytes::length(bytes)\n  let mut i = 0\n  // O(N) via StringBuilder; previously each `String::concat(out, ...)`\n  // copied the growing buffer, making this O(N²) for the N-byte module\n  // hashes this routine serialises.\n  let buf = StringBuilder::new()\n  while i < len {\n    let byte = Bytes::get(bytes, i)\n    let hi = byte / 16\n    let lo = byte % 16\n    StringBuilder::push(buf, bytes_to_hex_digit(hi))\n    StringBuilder::push(buf, bytes_to_hex_digit(lo))\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nfn hex_to_bytes(hex: String) -> Bytes with { Error } {\n  let len = String::length(hex)\n  if len % 2 != 0 {\n    throw(\"invalid hex length\")\n  } else {\n    let out = Bytes::new()\n    let mut i = 0\n    while i < len {\n      let hi = nibble_from_hex_char(String::char_code_at(hex, i))\n      let lo = nibble_from_hex_char(String::char_code_at(hex, i + 1))\n      Bytes::push(out, hi * 16 + lo)\n      i = i + 2\n    }\n    out\n  }\n}\n\nexport fn db_load_artifact(db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, artifact_cache, _, _, _, _) =>\n    match lookup_source_cache(artifact_cache, artifact_cache_key(kind, entry_name), fingerprint) {\n      Some(hex) => Some(hex_to_bytes(hex)),\n      None => None\n    }\n  }\n}\n\nexport fn db_store_artifact(db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> TypeDb {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\n    wrap_db(TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, upsert_source_cache(artifact_cache, artifact_cache_key(kind, entry_name), fingerprint, bytes_to_hex(bytes)), parse_count, merge_count, module_source_count, codegen_count + 1))\n  }\n}\n")
}

