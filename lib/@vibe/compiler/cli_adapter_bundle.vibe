type 1, like fs_remove).\n  if sh_capture_close_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"sh_capture_close\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // #903/#865: `vibe.process_exit (i64) -> ()` (type 1, like fs_remove).\n  if process_exit_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"process_exit\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // #865: `vibe.stderr_write_stream (i64) -> ()` / `vibe.stderr_write_char\n  // (i64) -> ()` (type 1, like Stdout's pair).\n  if stderr_write_stream_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"stderr_write_stream\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  if stderr_write_char_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"stderr_write_char\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  if dbg_break_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"dbg_break\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 2)\n  }\n  // Interior-line breakpoints (span-arc step5): emit the `vibe::dbg_line` import\n  // descriptor here, AFTER dbg_break and BEFORE the linked imports, matching its\n  // reserved import index order. Type index is the appended `(i32) -> ()` type.\n  if dbg_line_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"dbg_line\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, dbg_line_type_idx)\n  } else {\n    ()\n  }\n  let mut li_emit = 0\n  while li_emit < Array::length(linked_imports) {\n    let (lmod, lfn, lparams, _) = Array::get(linked_imports, li_emit)\n    emit_name(import_content, lmod)\n    emit_name(import_content, lfn)\n    bytebuf_push(import_content, 0)\n    let type_idx = num_base_types + lparams\n    leb128_encode_u32(import_content, type_idx)\n    li_emit = li_emit + 1\n  }\n  bytebuf_push_section(out, 2, import_content)\n  let func_type_indices = lc_fresh_int_array()\n  // #415 B-1: the builtin type indices are declared next to each body push\n  // (push_builtin above), in the exact bodies order — splice them here where\n  // a hand-maintained bare number list used to mirror that order from ~1,400\n  // lines away.\n  let mut bti = 0\n  while bti < Array::length(builtin_type_idxs) {\n    Array::push(func_type_indices, Array::get(builtin_type_idxs, bti))\n    bti = bti + 1\n  }\n  let mut fti = 0\n  while fti < num_user_funcs {\n    let upc = Array::get(fn_param_counts, fti)\n    Array::push(func_type_indices, num_base_types + upc)\n    fti = fti + 1\n  }\n  Array::push(func_type_indices, 2)\n  Array::push(func_type_indices, 5)\n  let mut lfi = 0\n  while lfi < num_lambdas {\n    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1\n    Array::push(func_type_indices, num_base_types + lam_user_params)\n    lfi = lfi + 1\n  }\n  if Array::length(func_type_indices) != Array::length(bodies) {\n    throw(\"WASI codegen internal error: function section and code section count mismatch\")\n  }\n  emit_function_section(out, func_type_indices)\n  let total_table_entries = num_user_funcs + num_lambdas\n  if total_table_entries > 0 {\n    emit_table_section_funcref(out, total_table_entries)\n  }\n  emit_memory_section(out, wasi_memory_min_pages_for_heap(heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve + rc_bins_reserve + (if rc_shadow {\n    rc_shadow_reserve()\n  } else {\n    0\n  })))\n  // #721: emit the tag section only when something can reference a tag --\n  // EThrow (`throw 2`), EHandle (try_table over tags 0-3), or a declared\n  // effect (per-effect tags at index 4+). Pure-compute modules then carry no\n  // exceptions machinery at all, which keeps V8 off its slower exnref module\n  // path (~35% wall on call-heavy code; wasmtime is indifferent).\n  let uses_exceptions = Array::length(effect_names_list) > 0 || stmts_contain_exceptions(stmts)\n  if uses_exceptions {\n    let tag_content = bytebuf_new()\n    let num_tags = Array::length(effect_names_list) + 4\n    bytebuf_push_vec_header(tag_content, num_tags)\n    let mut tag_emit_i = 0\n    while tag_emit_i < num_tags {\n      bytebuf_push(tag_content, 0)\n      leb128_encode_u32(tag_content, 1)\n      tag_emit_i = tag_emit_i + 1\n    }\n    bytebuf_push_section(out, 13, tag_content)\n  } else {\n    ()\n  }\n  let global_content = bytebuf_new()\n  // Base globals (bump ptr, effect state, ..., g_op_index) plus two i64\n  // globals per module-level thunk (memo value + init flag) appended last —\n  // see the thunk-body memoization above for the index formula.\n  let tg_num_thunks = Array::length(thunk_names_list)\n  if enable_rc {\n    bytebuf_push_vec_header(global_content, 7 + tg_num_thunks * 2)\n  } else {\n    bytebuf_push_vec_header(global_content, 6 + tg_num_thunks * 2)\n  }\n  bytebuf_push(global_content, 127)\n  bytebuf_push(global_content, 1)\n  emit_i32_const(global_content, heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve + rc_bins_reserve)\n  emit_end(global_content)\n  bytebuf_push(global_content, 126)\n  bytebuf_push(global_content, 1)\n  emit_i64_const(global_content, 0)\n  emit_end(global_content)\n  if enable_rc {\n    bytebuf_push(global_content, 127)\n    bytebuf_push(global_content, 1)\n    emit_i32_const(global_content, 0)\n    emit_end(global_content)\n  }\n  bytebuf_push(global_content, 126)\n  bytebuf_push(global_content, 1)\n  emit_i64_const(global_content, 0)\n  emit_end(global_content)\n  bytebuf_push(global_content, 126)\n  bytebuf_push(global_content, 1)\n  emit_i64_const(global_content, 0)\n  emit_end(global_content)\n  bytebuf_push(global_content, 127)\n  bytebuf_push(global_content, 1)\n  emit_i32_const(global_content, heap_start)\n  emit_end(global_content)\n  // #665: g_op_index (i64, mut) — operation index of the perform unwinding to a\n  // handler, for multi-operation dispatch. Appended last; index = rc ? 6 : 5.\n  bytebuf_push(global_content, 126)\n  bytebuf_push(global_content, 1)\n  emit_i64_const(global_content, 0)\n  emit_end(global_content)\n  let mut tg_gi = 0\n  while tg_gi < tg_num_thunks * 2 {\n    bytebuf_push(global_content, 126)\n    bytebuf_push(global_content, 1)\n    emit_i64_const(global_content, 0)\n    emit_end(global_content)\n    tg_gi = tg_gi + 1\n  }\n  bytebuf_push_section(out, 6, global_content)\n  let start_func_idx = func_offset + num_user_funcs\n  let run_func_idx = start_func_idx + 1\n  let all_export_names = lc_fresh_string_array()\n  let all_export_indices = lc_fresh_int_array()\n  if !library_mode {\n    Array::push(all_export_names, \"_start\")\n    Array::push(all_export_indices, start_func_idx)\n  }\n  if !library_mode && entry_func_idx >= 0 && !array_contains_str(all_export_names, entry_name) {\n    Array::push(all_export_names, entry_name)\n    Array::push(all_export_indices, entry_func_idx)\n  }\n  let mut exi = 0\n  while exi < Array::length(export_fn_names) {\n    let ename = Array::get(export_fn_names, exi)\n    let skip_export = library_mode && ename == entry_name\n    if !skip_export && !array_contains_str(all_export_names, ename) {\n      Array::push(all_export_names, ename)\n      Array::push(all_export_indices, Array::get(export_fn_user_indices, exi) + func_offset)\n    }\n    exi = exi + 1\n  }\n  // Per-block bench: export each `__bench_<name>` function so the runner's\n  // `--bench` mode can time benchmark blocks individually (instead of running the\n  // whole `_start`). Only `__no_entry__` test/bench builds populate test_fn_names,\n  // so normal builds (incl. the compiler self-compile) are byte-identical. The\n  // wasm index of a user function at user-index `j` is `j + func_offset`.\n  let mut bxi = 0\n  while bxi < Array::length(test_fn_names) {\n    let bname = Array::get(test_fn_names, bxi)\n    if String::starts_with(bname, \"__bench_\") && !array_contains_str(all_export_names, bname) {\n      let mut bj = 0\n      let mut bfound = 0 - 1\n      while bj < num_user_funcs {\n        if Array::get(fn_names_list, bj) == bname {\n          bfound = bj\n          bj = num_user_funcs\n        } else {\n          bj = bj + 1\n        }\n      }\n      if bfound >= 0 {\n        Array::push(all_export_names, bname)\n        Array::push(all_export_indices, bfound + func_offset)\n      }\n    }\n    bxi = bxi + 1\n  }\n  let export_content = bytebuf_new()\n  // #721: the \"error\" tag export exists only when the tag section does.\n  let export_count = Array::length(all_export_names) + 1 +\n  (if library_mode {\n    0\n  } else {\n    1 + (if uses_exceptions {\n      1\n    } else {\n      0\n    })\n  })\n  bytebuf_push_vec_header(export_content, export_count)\n  let mut efi = 0\n  while efi < Array::length(all_export_names) {\n    emit_name(export_content, Array::get(all_export_names, efi))\n    bytebuf_push(export_content, 0)\n    leb128_encode_u32(export_content, Array::get(all_export_indices, efi))\n    efi = efi + 1\n  }\n  emit_name(export_content, \"memory\")\n  bytebuf_push(export_content, 2)\n  leb128_encode_u32(export_content, 0)\n  if !library_mode {\n    emit_name(export_content, \"__heap_ptr\")\n    bytebuf_push(export_content, 3)\n    leb128_encode_u32(export_content, 0)\n    if uses_exceptions {\n      emit_name(export_content, \"error\")\n      bytebuf_push(export_content, 4)\n      leb128_encode_u32(export_content, 0)\n    } else {\n      ()\n    }\n  }\n  bytebuf_push_section(out, 7, export_content)\n  if total_table_entries > 0 {\n    // #1107 Phase 4: register ONLY the slots codegen recorded a closure value\n    // for (table_slots_used — see CompileCtx). A slot no closure carries can\n    // never be call_indirect'ed, so it stays ref.null; slot numbering and the\n    // declared table size are untouched. Run-compressed active segments skip\n    // the gaps (emit_element_section_active_runs). This also shrinks the DCE\n    // root set a downstream optimizer (vibe-opt, wasm-opt) must respect —\n    // previously every user function + lambda was elem-rooted.\n    let slot_used_flags = lc_fresh_bool_array()\n    let mut sfi = 0\n    while sfi < total_table_entries {\n      Array::push(slot_used_flags, false)\n      sfi = sfi + 1\n    }\n    let mut tsu = 0\n    while tsu < Array::length(table_slots_used) {\n      let ts = Array::get(table_slots_used, tsu)\n      if ts >= 0 && ts < total_table_entries {\n        Array::set(slot_used_flags, ts, true)\n      } else {\n        ()\n      }\n      tsu = tsu + 1\n    }\n    let table_slots = lc_fresh_int_array()\n    let table_func_indices = lc_fresh_int_array()\n    let mut tei = 0\n    while tei < total_table_entries {\n      if Array::get(slot_used_flags, tei) {\n        Array::push(table_slots, tei)\n        Array::push(table_func_indices, if tei < num_user_funcs {\n          func_offset + tei\n        } else {\n          run_func_idx + 1 + (tei - num_user_funcs)\n        })\n      } else {\n        ()\n      }\n      tei = tei + 1\n    }\n    if Array::length(table_slots) > 0 {\n      emit_element_section_active_runs(out, table_slots, table_func_indices)\n    } else {\n      ()\n    }\n  }\n  // Binary-size: replace the bodies of generated runtime helpers that no\n  // reachable body ever calls with a 1-instruction `unreachable` stub. The\n  // helper index block [num_imported_funcs, func_offset) is emitted\n  // unconditionally (every call site references FIXED indices computed above),\n  // so helpers cannot simply be omitted — but an unreferenced body can shrink\n  // to `unreachable` without moving any index. Reachability is a worklist\n  // byte-scan over final body bytes for `call`(0x10)/`ref.func`(0xd2)\n  // immediates that decode into the helper range, seeded from every\n  // non-helper body (user fns + entry glue + lambdas; the funcref table only\n  // holds user/lambda indices). A stray 0x10 inside some other immediate can\n  // only FALSE-POSITIVE (keeps an unused helper) — never drops a used one,\n  // since every real call's opcode byte is also visited. Skipped for\n  // instrumentation builds so debug tooling sees unmodified bodies.\n  if !coverage && !debug_trace && !debug_break && !rc_shadow {\n    let builtin_used = lc_fresh_bool_array()\n    let mut sbu_i = 0\n    while sbu_i < num_generated {\n      Array::push(builtin_used, false)\n      sbu_i = sbu_i + 1\n    }\n    let scan_queue = lc_fresh_int_array()\n    let mut sbr = num_generated\n    while sbr < Array::length(bodies) {\n      Array::push(scan_queue, sbr)\n      sbr = sbr + 1\n    }\n    let mut sq_i = 0\n    while sq_i < Array::length(scan_queue) {\n      let sb_body = Array::get(bodies, Array::get(scan_queue, sq_i))\n      sq_i = sq_i + 1\n      let sb_len = Bytes::length(sb_body)\n      let mut sb_p = 0\n      while sb_p < sb_len {\n        let sb_op = Bytes::get(sb_body, sb_p)\n        if sb_op == 16 || sb_op == 210 {\n          let mut sb_q = sb_p + 1\n          let mut sb_v = 0\n          let mut sb_shift = 0\n          let mut sb_more = true\n          let mut sb_valid = false\n          while sb_more && sb_q < sb_len && sb_shift < 35 {\n            let sb_byte = Bytes::get(sb_body, sb_q)\n            sb_v = sb_v|((sb_byte&127)<<sb_shift)\n            sb_q = sb_q + 1\n            if (sb_byte&128) == 0 {\n              sb_more = false\n              sb_valid = true\n            } else {\n              sb_shift = sb_shift + 7\n            }\n          }\n          if sb_valid && sb_v >= num_imported_funcs && sb_v < func_offset {\n            let sb_pos = sb_v - num_imported_funcs\n            if !Array::get(builtin_used, sb_pos) {\n              Array::set(builtin_used, sb_pos, true)\n              Array::push(scan_queue, sb_pos)\n            } else {\n              ()\n            }\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n        sb_p = sb_p + 1\n      }\n    }\n    let mut sb_k = 0\n    while sb_k < num_generated {\n      if !Array::get(builtin_used, sb_k) {\n        let sb_stub = bytebuf_new()\n        bytebuf_push(sb_stub, 0)\n        Array::set(bodies, sb_k, sb_stub)\n        Array::set(meta_i32, sb_k, 0)\n        Array::set(meta_i64, sb_k, 0)\n      } else {\n        ()\n      }\n      sb_k = sb_k + 1\n    }\n  } else {\n    ()\n  }\n  let code_content = bytebuf_new()\n  bytebuf_push_vec_header(code_content, Array::length(bodies))\n  // #644: per-user-function locals-declaration header length, in `bodies`\n  // ci-order (`bi = ci - num_generated`, the same relationship `func_offset`\n  // encodes for the final wasm function index). Captured below as each\n  // func_buf's locals header is assembled, BEFORE `body` (the raw\n  // instruction stream body_buf compiled with linemap_state) is appended --\n  // this is exactly the byte count linked_compile needs to add to a\n  // body_buf-relative linemap offset to match wasmtime's\n  // `FrameInfo::func_offset()`, which measures from the first byte of the\n  // code entry (the locals header), not the first instruction.\n  let linemap_hdrlen_by_bi = if linemap_state.enabled {\n    lc_fresh_int_array_of_len(num_user_funcs, 0)\n  } else {\n    lc_fresh_int_array()\n  }\n  let mut ci = 0\n  while ci < Array::length(bodies) {\n    let body = Array::get(bodies, ci)\n    let func_buf = bytebuf_new()\n    let ni32 = Array::get(meta_i32, ci)\n    let ni64 = Array::get(meta_i64, ci)\n    if ni32 == 0 {\n      if ni64 == 0 {\n        leb128_encode_u32(func_buf, 0)\n      } else {\n        leb128_encode_u32(func_buf, 1)\n        leb128_encode_u32(func_buf, ni64)\n        bytebuf_push(func_buf, 126)\n      }\n    } else {\n      if ni64 == 0 {\n        leb128_encode_u32(func_buf, 1)\n        leb128_encode_u32(func_buf, ni32)\n        bytebuf_push(func_buf, 127)\n      } else {\n        leb128_encode_u32(func_buf, 2)\n        leb128_encode_u32(func_buf, ni32)\n        bytebuf_push(func_buf, 127)\n        leb128_encode_u32(func_buf, ni64)\n        bytebuf_push(func_buf, 126)\n      }\n    }\n    if linemap_state.enabled {\n      let lm_bi = ci - num_generated\n      if lm_bi >= 0 && lm_bi < num_user_funcs {\n        Array::set(linemap_hdrlen_by_bi, lm_bi, bytebuf_length(func_buf))\n      } else {\n        ()\n      }\n    } else {\n      ()\n    }\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\n    bytebuf_push_buf(code_content, func_buf)\n    ci = ci + 1\n  }\n  bytebuf_push_section(out, 10, code_content)\n  // #644: `vibe.linemap` custom section -- one 16-byte little-endian record\n  // per recorded probe: `<wasm func index i32> <code offset i32>\n  // <file id i32> <line i32>`, back-to-back (record count = content length /\n  // 16). Binary rather than text so the runner never needs to parse decimal\n  // ASCII for what can be thousands of entries (same rationale as\n  // `vibe.dbgargs`'s raw-int encoding above). The offset is shifted by that\n  // function's locals-header length (linemap_hdrlen_by_bi) so it lands\n  // exactly where wasmtime's FrameInfo::func_offset() measures from. Emitted\n  // only when linemap_state is enabled (debug-break builds with interior-\n  // line probes); off => no section, byte-identical output.\n  if linemap_state.enabled {\n    let lm_content = bytebuf_new()\n    let lm_name = \"vibe.linemap\"\n    leb128_encode_u32(lm_content, String::length(lm_name))\n    let mut lmni = 0\n    while lmni < String::length(lm_name) {\n      bytebuf_push(lm_content, String::char_code_at(lm_name, lmni))\n      lmni = lmni + 1\n    }\n    let mut lm_k = 0\n    while lm_k < Array::length(linemap_state.offsets) {\n      let lm_bi = Array::get(linemap_state.funcs, lm_k)\n      let lm_func_idx = func_offset + lm_bi\n      let lm_off = Array::get(linemap_state.offsets, lm_k) + Array::get(linemap_hdrlen_by_bi, lm_bi)\n      let lm_file_id = Array::get(linemap_state.file_ids, lm_k)\n      let lm_line = Array::get(linemap_state.lines, lm_k)\n      bytebuf_push_i32le(lm_content, lm_func_idx)\n      bytebuf_push_i32le(lm_content, lm_off)\n      bytebuf_push_i32le(lm_content, lm_file_id)\n      bytebuf_push_i32le(lm_content, lm_line)\n      lm_k = lm_k + 1\n    }\n    bytebuf_push_section(out, 0, lm_content)\n  } else {\n    ()\n  }\n  if num_strings > 0 {\n    let data_offsets = lc_fresh_int_array()\n    let data_bufs = lc_fresh_bytes_array()\n    let mut di = 0\n    while di < num_strings {\n      Array::push(data_offsets, Array::get(str_offsets, di))\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\n      di = di + 1\n    }\n    emit_data_section_multi(out, data_offsets, data_bufs)\n  }\n  // Name section (debugger P0 / ADR-0035): name the user functions so wasm\n  // backtraces and tooling show `main` etc. instead of `<wasm function N>`.\n  // User functions occupy consecutive indices starting at `func_offset`.\n  // #768: emit ONLY the first num_user_funcs entries -- fn_names_list also\n  // carries the builtin/runtime names appended for call resolution (Env::get,\n  // Fs::read_file, ...), but those bodies live at LOW indices (below\n  // func_offset). Emitting the whole list consecutively shifted every\n  // post-user name: `_start` was labeled `Env::get` in crash stacks, which\n  // repeatedly sent debugging to functions the trace never touched. `_start`\n  // and `run` sit right after the user block, so name them explicitly.\n  // #799: name the GENERATED runtime helpers too. Profilers (node --cpu-prof)\n  // attributed the hottest samples to anonymous wasm-function[N] frames\n  // because only user functions carried name-section entries; the generated\n  // string/array/bytes helpers occupy the consecutive index range\n  // [num_imported_funcs, func_offset). Unassigned slots (lambda-arity pads\n  // etc.) keep the generic \"__rt_gen\" label.\n  let gen_sec_names = lc_fresh_string_array()\n  let mut gsn_i = 0\n  while gsn_i < num_generated {\n    Array::push(gen_sec_names, \"__rt_gen\")\n    gsn_i = gsn_i + 1\n  }\n  Array::set(gen_sec_names, print_int_idx - num_imported_funcs, \"__rt_print_int\")\n  Array::set(gen_sec_names, print_str_idx - num_imported_funcs, \"__rt_print_str\")\n  Array::set(gen_sec_names, str_len_idx - num_imported_funcs, \"__rt_str_len\")\n  Array::set(gen_sec_names, str_eq_idx - num_imported_funcs, \"__rt_str_eq\")\n  Array::set(gen_sec_names, str_concat_idx - num_imported_funcs, \"__rt_str_concat\")\n  Array::set(gen_sec_names, arr_new_idx - num_imported_funcs, \"__rt_arr_new\")\n  Array::set(gen_sec_names, arr_len_idx - num_imported_funcs, \"__rt_arr_len\")\n  Array::set(gen_sec_names, arr_get_idx - num_imported_funcs, \"__rt_arr_get\")\n  Array::set(gen_sec_names, arr_push_idx - num_imported_funcs, \"__rt_arr_push\")\n  Array::set(gen_sec_names, arr_set_idx - num_imported_funcs, \"__rt_arr_set\")\n  Array::set(gen_sec_names, double_to_int_idx - num_imported_funcs, \"__rt_double_to_int\")\n  Array::set(gen_sec_names, int_to_double_idx - num_imported_funcs, \"__rt_int_to_double\")\n  Array::set(gen_sec_names, str_char_code_at_idx - num_imported_funcs, \"__rt_str_char_code_at\")\n  Array::set(gen_sec_names, str_from_char_code_idx - num_imported_funcs, \"__rt_str_from_char_code\")\n  Array::set(gen_sec_names, str_substring_idx - num_imported_funcs, \"__rt_str_substring\")\n  Array::set(gen_sec_names, identity_idx - num_imported_funcs, \"__rt_identity\")\n  Array::set(gen_sec_names, arr_slice_idx - num_imported_funcs, \"__rt_arr_slice\")\n  Array::set(gen_sec_names, arr_concat_idx - num_imported_funcs, \"__rt_arr_concat\")\n  Array::set(gen_sec_names, arr_truncate_idx - num_imported_funcs, \"__rt_arr_truncate\")\n  Array::set(gen_sec_names, string_join_idx - num_imported_funcs, \"__rt_string_join\")\n  Array::set(gen_sec_names, fs_read_file_stub_idx - num_imported_funcs, \"__rt_stub_a\")\n  Array::set(gen_sec_names, fs_exists_stub_idx - num_imported_funcs, \"__rt_stub_b\")\n  Array::set(gen_sec_names, fs_stat_token_stub_idx - num_imported_funcs, \"__rt_stub_c\")\n  Array::set(gen_sec_names, fs_write_file_stub_idx - num_imported_funcs, \"__rt_stub_d\")\n  Array::set(gen_sec_names, fs_write_bytes_stub_idx - num_imported_funcs, \"__rt_stub_e\")\n  Array::set(gen_sec_names, eq_idx - num_imported_funcs, \"__rt_eq\")\n  Array::set(gen_sec_names, string_ends_with_idx - num_imported_funcs, \"__rt_string_ends_with\")\n  Array::set(gen_sec_names, string_last_index_of_idx - num_imported_funcs, \"__rt_string_last_index_of\")\n  Array::set(gen_sec_names, arr_push_all_idx - num_imported_funcs, \"__rt_arr_push_all\")\n  Array::set(gen_sec_names, string_index_of_idx - num_imported_funcs, \"__rt_string_index_of\")\n  Array::set(gen_sec_names, string_contains_idx - num_imported_funcs, \"__rt_string_contains\")\n  Array::set(gen_sec_names, string_starts_with_idx - num_imported_funcs, \"__rt_string_starts_with\")\n  Array::set(gen_sec_names, string_split_idx - num_imported_funcs, \"__rt_string_split\")\n  Array::set(gen_sec_names, string_trim_idx - num_imported_funcs, \"__rt_string_trim\")\n  Array::set(gen_sec_names, sources_idx - num_imported_funcs, \"__rt_sources\")\n  Array::set(gen_sec_names, bytes_new_idx - num_imported_funcs, \"__rt_bytes_new\")\n  Array::set(gen_sec_names, bytes_len_idx - num_imported_funcs, \"__rt_bytes_len\")\n  Array::set(gen_sec_names, bytes_get_idx - num_imported_funcs, \"__rt_bytes_get\")\n  Array::set(gen_sec_names, bytes_set_idx - num_imported_funcs, \"__rt_bytes_set\")\n  Array::set(gen_sec_names, bytes_push_idx - num_imported_funcs, \"__rt_bytes_push\")\n  Array::set(gen_sec_names, bytes_append_idx - num_imported_funcs, \"__rt_bytes_append\")\n  Array::set(gen_sec_names, bytes_concat_idx - num_imported_funcs, \"__rt_bytes_concat\")\n  Array::set(gen_sec_names, bytes_slice_idx - num_imported_funcs, \"__rt_bytes_slice\")\n  Array::set(gen_sec_names, bytes_from_array_idx - num_imported_funcs, \"__rt_bytes_from_array\")\n  Array::set(gen_sec_names, bytes_to_array_idx - num_imported_funcs, \"__rt_bytes_to_array\")\n  if enable_rc {\n    Array::set(gen_sec_names, rc_drop_idx - num_imported_funcs, \"__rt_rc_drop\")\n    Array::set(gen_sec_names, rc_alloc_idx - num_imported_funcs, \"__rt_rc_alloc\")\n  } else {\n    ()\n  }\n  Array::set(gen_sec_names, heap_grow_check_idx - num_imported_funcs, \"__rt_heap_grow_check\")\n  Array::set(gen_sec_names, simd_skip_ws_idx - num_imported_funcs, \"__rt_simd_skip_ws\")\n  Array::set(gen_sec_names, simd_scan_alnum_idx - num_imported_funcs, \"__rt_simd_scan_alnum\")\n  Array::set(gen_sec_names, simd_scan_alnum_str_idx - num_imported_funcs, \"__rt_simd_scan_alnum_str\")\n  Array::set(gen_sec_names, str_lex_diff_idx - num_imported_funcs, \"__rt_str_lex_diff\")\n  Array::set(gen_sec_names, generic_rel_diff_idx - num_imported_funcs, \"__rt_generic_rel_diff\")\n  Array::set(gen_sec_names, generic_add_idx - num_imported_funcs, \"__rt_generic_add\")\n  let name_sec_names = gen_sec_names\n  let mut usn_i = 0\n  while usn_i < num_user_funcs {\n    Array::push(name_sec_names, Array::get(fn_names_list, usn_i))\n    usn_i = usn_i + 1\n  }\n  Array::push(name_sec_names, \"_start\")\n  Array::push(name_sec_names, \"run\")\n  emit_function_name_section(out, name_sec_names, num_imported_funcs)\n  bytebuf_to_bytes(out)\n}\n\nexport fn compile_wasi_module_rc_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  let stmts = elaborate_heap_params(stmts_in)\n  compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, true, false, false, false, false, empty_dbg_prov())\n}\n\n/// #715 recurrence guard: RC + shadow-liveness instrumentation (VIBE_RC=shadow).\nexport fn compile_wasi_module_rc_shadow_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  let stmts = elaborate_heap_params(stmts_in)\n  compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, true, false, false, false, true, empty_dbg_prov())\n}\n\nexport fn compile_wasi_module_with_sources_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error } {\n  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, false, false, false, false, false, empty_dbg_prov())\n}\n\n/// Coverage build (#cov): compile with function-level hit instrumentation +\n/// `vibe_cov` custom section. Same as compile_wasi_module_with_sources_impl but\n/// with coverage enabled.\nexport fn compile_wasi_module_with_sources_coverage_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error } {\n  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, true, true, false, false, false, empty_dbg_prov())\n}\n\n/// Trace build (debugger / DAP P1 groundwork): compile with function-call\n/// execution-trace instrumentation + `vibe.trace` custom section. Same as\n/// compile_wasi_module_with_sources_impl but with debug_trace enabled.\nexport fn compile_wasi_module_with_sources_trace_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error } {\n  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, true, false, true, false, false, empty_dbg_prov())\n}\n\n/// Break build (debugger / DAP P1): compile with `vibe::dbg_break` host-hook\n/// instrumentation at each user function entry. Same as\n/// compile_wasi_module_with_sources_impl but with debug_break enabled.\nexport fn compile_wasi_module_with_sources_break_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], prov: DbgProv) -> Bytes with { Error } {\n  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, true, false, false, true, false, prov)\n}\n")
}

let cli_adapter_source_107 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/component_codegen.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_buf,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_code_section,\n  emit_end,\n  emit_export_memory,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_header,\n  emit_i32_add,\n  emit_i32_and,\n  emit_i32_const,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_gt_u,\n  emit_i32_load,\n  emit_i32_ne,\n  emit_i32_shr_u,\n  emit_i32_store,\n  emit_i32_sub,\n  emit_i64_const,\n  emit_if_void,\n  emit_local_get,\n  emit_local_set,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name\n}\n\n//# Functions\n\nfn read_uleb(bytes: Bytes, start: Int) -> (Int, Int) {\n  let mut value = 0\n  let mut shift = 0\n  let mut i = start\n  let len = Bytes::length(bytes)\n  let mut done = false\n  while (i < len) && (done == false) {\n    let b = Bytes::get(bytes, i)\n    value = value|((b&127)<<shift)\n    i = i + 1\n    if (b&128) == 0 {\n      done = true\n    } else {\n      shift = shift + 7\n    }\n  }\n  (value, i)\n}\n\nlet section_type = 7\n\nlet core_sort_mem = 2\n\nfn new_int_array() -> Array[Int] {\n  array_empty()\n}\n\nlet section_alias = 6\n\nlet section_canon = 8\n\nlet core_sort_func = 0\n\nfn read_name_info(bytes: Bytes, start: Int) -> (Int, Int) {\n  read_uleb(bytes, start)\n}\n\nfn skip_name(bytes: Bytes, start: Int) -> Int {\n  let (name_len, after_len) = read_name_info(bytes, start)\n  after_len + name_len\n}\n\nlet section_export = 11\n\nlet section_import = 10\n\nlet section_module = 1\n\nfn parse_type_sigs(bytes: Bytes, sec_start: Int, sec_end: Int, out_sigs: Array[Array[Int]]) -> Unit {\n  let mut j = sec_start\n  let (type_count, next_j) = read_uleb(bytes, j)\n  j = next_j\n  let mut t = 0\n  while t < type_count {\n    if j >= sec_end {\n      t = type_count\n    }\n    else {\n      let form = Bytes::get(bytes, j)\n      j = j + 1\n      if form != 96 {\n        t = type_count\n      }\n      else {\n        let sig = new_int_array()\n        let (param_count, next_j2) = read_uleb(bytes, j)\n        j = next_j2\n        Array::push(sig, param_count)\n        let mut p = 0\n        while p < param_count {\n          if j >= sec_end {\n            p = param_count\n          }\n          else {\n            Array::push(sig, Bytes::get(bytes, j))\n            j = j + 1\n            p = p + 1\n          }\n        }\n        let (result_count, next_j3) = read_uleb(bytes, j)\n        j = next_j3\n        Array::push(sig, result_count)\n        let mut rv = 0\n        while rv < result_count {\n          if j >= sec_end {\n            rv = result_count\n          }\n          else {\n            Array::push(sig, Bytes::get(bytes, j))\n            j = j + 1\n            rv = rv + 1\n          }\n        }\n        Array::push(out_sigs, sig)\n        t = t + 1\n      }\n    }\n  }\n}\n\nlet comp_extern_func = 1\n\nlet comp_valtype_f32 = 118\n\nlet comp_valtype_f64 = 117\n\nlet comp_valtype_s32 = 122\n\nlet comp_valtype_s64 = 120\n\nfn emit_raw_content(buf: Bytes, content: Bytes) -> Unit {\n  leb128_encode_u32(buf, Bytes::length(content))\n  bytebuf_push_buf(buf, content)\n}\n\nfn read_name_string(bytes: Bytes, start: Int) -> String {\n  let (name_len, after_len) = read_name_info(bytes, start)\n  // Char-by-char: was `s = String::concat(s, char)` per byte, O(N²) on\n  // the name length (which can be hundreds of chars for mangled\n  // identifiers).\n  let buf = StringBuilder::new()\n  let mut i = 0\n  while i < name_len {\n    StringBuilder::push(buf, String::from_char_code(Bytes::get(bytes, after_len + i)))\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nfn skip_wasm_limits(bytes: Bytes, start: Int, end_pos: Int) -> Int {\n  let mut i = start\n  if i >= end_pos {\n    end_pos\n  }\n  else {\n    let flags = Bytes::get(bytes, i)\n    i = i + 1\n    let (min_limit, next_i1) = read_uleb(bytes, i)\n    let _ = min_limit\n    i = next_i1\n    if (flags&1) != 0 {\n      let (max_limit, next_i2) = read_uleb(bytes, i)\n      let _ = max_limit\n      i = next_i2\n    }\n    if (flags&4) != 0 {\n      let (page_size, next_i3) = read_uleb(bytes, i)\n      let _ = page_size\n      i = next_i3\n    }\n    if i > end_pos {\n      end_pos\n    } else {\n      i\n    }\n  }\n}\n\nlet component_magic_0 = 0\n\nlet component_magic_1 = 97\n\nlet component_magic_2 = 115\n\nlet component_magic_3 = 109\n\nfn emit_alias_section(buf: Bytes, core_instance_idx: Int, names: Array[String], sorts: Array[Int]) -> Unit {\n  let count = Array::length(names)\n  if count == 0 {\n    ()\n  }\n  else {\n    bytebuf_push(buf, section_alias)\n    let content = bytebuf_new()\n    leb128_encode_u32(content, count)\n    let mut i = 0\n    while i < count {\n      bytebuf_push(content, 0)\n      bytebuf_push(content, Array::get(sorts, i))\n      bytebuf_push(content, 1)\n      leb128_encode_u32(content, core_instance_idx)\n      emit_name(content, Array::get(names, i))\n      i = i + 1\n    }\n    emit_raw_content(buf, content)\n  }\n}\n\nlet comp_valtype_string = 115\n\nlet comp_valtype_bool = 127\n\nlet component_version_0 = 13\n\nlet component_version_1 = 0\n\nlet component_version_2 = 1\n\nlet component_version_3 = 0\n\nfn core_to_comp_valtype(v: Int) -> Int {\n  if v == 127 {\n    comp_valtype_s32\n  }\n  else {\n    if v == 126 {\n      comp_valtype_s64\n    }\n    else {\n      if v == 125 {\n        comp_valtype_f32\n      }\n      else {\n        if v == 124 {\n          comp_valtype_f64\n        }\n        else {\n          0 - 1\n        }\n      }\n    }\n  }\n}\n\nfn emit_canon_lift_func(content: Bytes, core_func_idx: Int, type_idx: Int, need_string: Int, memory_idx: Int, realloc_idx: Int) -> Unit {\n  bytebuf_push(content, 0)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, core_func_idx)\n  if need_string != 0 {\n    leb128_encode_u32(content, 3)\n    bytebuf_push(content, 0)\n    bytebuf_push(content, 3)\n    leb128_encode_u32(content, memory_idx)\n    bytebuf_push(content, 4)\n    leb128_encode_u32(content, realloc_idx)\n  } else {\n    leb128_encode_u32(content, 0)\n  }\n  leb128_encode_u32(content, type_idx)\n}\n\nfn emit_component_header(buf: Bytes) -> Unit {\n  bytebuf_push(buf, component_magic_0)\n  bytebuf_push(buf, component_magic_1)\n  bytebuf_push(buf, component_magic_2)\n  bytebuf_push(buf, component_magic_3)\n  bytebuf_push(buf, component_version_0)\n  bytebuf_push(buf, component_version_1)\n  bytebuf_push(buf, component_version_2)\n  bytebuf_push(buf, component_version_3)\n}\n\nlet section_core_instance = 2\n\nfn skip_core_import_desc(bytes: Bytes, start: Int, kind: Int, end_pos: Int) -> Int {\n  let mut i = start\n  if kind == 1 {\n    if i < end_pos {\n      i = i + 1\n    }\n    i = skip_wasm_limits(bytes, i, end_pos)\n  } else {\n    if kind == 2 {\n      i = skip_wasm_limits(bytes, i, end_pos)\n    } else {\n      if kind == 3 {\n        if (i + 2) <= end_pos {\n          i = i + 2\n        } else {\n          i = end_pos\n        }\n      } else {\n        if kind == 4 {\n          if i < end_pos {\n            i = i + 1\n          }\n          let (type_idx, next_i) = read_uleb(bytes, i)\n          let _ = type_idx\n          i = next_i\n        } else {\n          i = end_pos\n        }\n      }\n    }\n  }\n  if i > end_pos {\n    end_pos\n  } else {\n    i\n  }\n}\n\nfn parse_core_exports(core_wasm: Bytes, out_names: Array[String], out_func_indices: Array[Int], out_type_sigs: Array[Array[Int]]) -> Int {\n  let len = Bytes::length(core_wasm)\n  if len < 8 {\n    0\n  }\n  else {\n    let type_sigs = array_empty()\n    let func_type_indices = new_int_array()\n    let mut import_func_count = 0\n    let mut i = 8\n    let mut export_count = 0\n    while i < len {\n      let sec_id = Bytes::get(core_wasm, i)\n      i = i + 1\n      let (sec_size, next_i) = read_uleb(core_wasm, i)\n      i = next_i\n      let sec_end = i + sec_size\n      if sec_end > len {\n        i = len\n      }\n      else {\n        if sec_id == 1 {\n          parse_type_sigs(core_wasm, i, sec_end, type_sigs)\n        } else {\n          if sec_id == 2 {\n            let mut j = i\n            let (imp_count, next_j) = read_uleb(core_wasm, j)\n            j = next_j\n            let mut imp = 0\n            while imp < imp_count {\n              if j >= sec_end {\n                imp = imp_count\n              }\n              else {\n                j = skip_name(core_wasm, j)\n                j = skip_name(core_wasm, j)\n                if j >= sec_end {\n                  imp = imp_count\n                }\n                else {\n                  let kind = Bytes::get(core_wasm, j)\n                  j = j + 1\n                  if kind == 0 {\n                    let (type_idx, next_j2) = read_uleb(core_wasm, j)\n                    let _ = type_idx\n                    j = next_j2\n                    import_func_count = import_func_count + 1\n                  } else {\n                    j = skip_core_import_desc(core_wasm, j, kind, sec_end)\n                  }\n                  imp = imp + 1\n                }\n              }\n            }\n          } else {\n            if sec_id == 3 {\n              let mut j = i\n              let (func_count, next_j) = read_uleb(core_wasm, j)\n              j = next_j\n              let mut f = 0\n              while f < func_count {\n                if j >= sec_end {\n                  f = func_count\n                }\n                else {\n                  let (type_idx, next_j2) = read_uleb(core_wasm, j)\n                  Array::push(func_type_indices, type_idx)\n                  j = next_j2\n                  f = f + 1\n                }\n              }\n            } else {\n              if sec_id == 7 {\n                let mut j = i\n                let (exp_count, next_j) = read_uleb(core_wasm, j)\n                j = next_j\n                let mut e = 0\n                while e < exp_count {\n                  if j >= sec_end {\n                    e = exp_count\n                  }\n                  else {\n                    let name = read_name_string(core_wasm, j)\n                    j = skip_name(core_wasm, j)\n                    if j >= sec_end {\n                      e = exp_count\n                    }\n                    else {\n                      let kind = Bytes::get(core_wasm, j)\n                      j = j + 1\n                      let (index, next_j2) = read_uleb(core_wasm, j)\n                      j = next_j2\n                      if kind == 0 {\n                        let type_idx = if index < import_func_count {\n                          0 - 1\n                        }\n                        else {\n                          let local_idx = index - import_func_count\n                          if local_idx < Array::length(func_type_indices) {\n                            Array::get(func_type_indices, local_idx)\n                          } else {\n                            0 - 1\n                          }\n                        }\n                        if (type_idx >= 0) && (type_idx < Array::length(type_sigs)) {\n                          Array::push(out_names, name)\n                          Array::push(out_func_indices, index)\n                          Array::push(out_type_sigs, Array::get(type_sigs, type_idx))\n                          export_count = export_count + 1\n                        }\n                      }\n                      e = e + 1\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n        i = sec_end\n      }\n    }\n    export_count\n  }\n}\n\nfn parse_core_imports(core_wasm: Bytes, out_module_names: Array[String], out_func_names: Array[String], out_type_indices: Array[Int], out_type_sigs: Array[Array[Int]]) -> Int {\n  let len = Bytes::length(core_wasm)\n  if len < 8 {\n    0\n  }\n  else {\n    let mut i = 8\n    let mut import_count = 0\n    while i < len {\n      let sec_id = Bytes::get(core_wasm, i)\n      i = i + 1\n      let (sec_size, next_i) = read_uleb(core_wasm, i)\n      i = next_i\n      let sec_end = i + sec_size\n      if sec_end > len {\n        i = len\n      }\n      else {\n        if sec_id == 1 {\n          parse_type_sigs(core_wasm, i, sec_end, out_type_sigs)\n        } else {\n          if sec_id == 2 {\n            let mut j = i\n            let (imp_count, next_j) = read_uleb(core_wasm, j)\n            j = next_j\n            let mut imp = 0\n            while imp < imp_count {\n              if j >= sec_end {\n                imp = imp_count\n              }\n              else {\n                let mod_name = read_name_string(core_wasm, j)\n                j = skip_name(core_wasm, j)\n                let fn_name = read_name_string(core_wasm, j)\n                j = skip_name(core_wasm, j)\n                if j >= sec_end {\n                  imp = imp_count\n                }\n                else {\n                  let kind = Bytes::get(core_wasm, j)\n                  j = j + 1\n                  if kind == 0 {\n                    let (type_idx, next_j2) = read_uleb(core_wasm, j)\n                    j = next_j2\n                    Array::push(out_module_names, mod_name)\n                    Array::push(out_func_names, fn_name)\n                    Array::push(out_type_indices, type_idx)\n                    import_count = import_count + 1\n                  } else {\n                    j = skip_core_import_desc(core_wasm, j, kind, sec_end)\n                  }\n                  imp = imp + 1\n                }\n              }\n            }\n          }\n        }\n        i = sec_end\n      }\n    }\n    import_count\n  }\n}\n\nfn build_import_plan(core_wasm: Bytes, out_import_names: Array[String], out_binding_func_names: Array[String], out_binding_func_indices: Array[Int], out_unique_module_names: Array[String], out_module_binding_counts: Array[Int], out_comp_params: Array[Array[Int]], out_comp_param_names: Array[Array[String]], out_comp_results: Array[Array[Int]]) -> Int {\n  let imp_module_names = array_empty()\n  let imp_func_names = array_empty()\n  let imp_type_indices = new_int_array()\n  let type_sigs = array_empty()\n  let _ = parse_core_imports(core_wasm, imp_module_names, imp_func_names, imp_type_indices, type_sigs)\n  let seen_keys = array_empty()\n  let module_idx_map_keys = array_empty()\n  let module_idx_map_vals = new_int_array()\n  let mut binding_count = 0\n  let mut i = 0\n  while i < Array::length(imp_module_names) {\n    let mod_name = Array::get(imp_module_names, i)\n    let fn_name = Array::get(imp_func_names, i)\n    let key = \"\\{mod_name}||\\{fn_name}\"\n    let mut already = false\n    let mut s = 0\n    while s < Array::length(seen_keys) {\n      if Array::get(seen_keys, s) == key {\n        already = true\n      }\n      s = s + 1\n    }\n    if already == false {\n      Array::push(seen_keys, key)\n      let type_idx = Array::get(imp_type_indices, i)\n      if type_idx < Array::length(type_sigs) {\n        let sig = Array::get(type_sigs, type_idx)\n        let param_count = Array::get(sig, 0)\n        let result_count_index = 1 + param_count\n        let result_count = Array::get(sig, result_count_index)\n        let comp_params = new_int_array()\n        let mut valid = true\n        let mut p = 0\n        while p < param_count {\n          let cv = core_to_comp_valtype(Array::get(sig, 1 + p))\n          if cv < 0 {\n            valid = false\n          }\n          else {\n            Array::push(comp_params, cv)\n          }\n          p = p + 1\n        }\n        let comp_results = new_int_array()\n        let mut r = 0\n        while r < result_count {\n          let cv = core_to_comp_valtype(Array::get(sig, result_count_index + 1 + r))\n          if cv < 0 {\n            valid = false\n          }\n          else {\n            Array::push(comp_results, cv)\n          }\n          r = r + 1\n        }\n        if valid {\n          let mut mod_idx = 0 - 1\n          let mut mi = 0\n          while mi < Array::length(module_idx_map_keys) {\n            if Array::get(module_idx_map_keys, mi) == mod_name {\n              mod_idx = Array::get(module_idx_map_vals, mi)\n            }\n            mi = mi + 1\n          }\n          if mod_idx < 0 {\n            mod_idx = Array::length(out_unique_module_names)\n            Array::push(out_unique_module_names, mod_name)\n            Array::push(out_module_binding_counts, 0)\n            Array::push(module_idx_map_keys, mod_name)\n            Array::push(module_idx_map_vals, mod_idx)\n          }\n          let import_name = \"import-\\{binding_count}\"\n          Array::push(out_import_names, import_name)\n          Array::push(out_binding_func_names, fn_name)\n          Array::push(out_binding_func_indices, binding_count)\n          Array::push(out_comp_params, comp_params)\n          let empty_names = array_empty()\n          Array::push(out_comp_param_names, empty_names)\n          Array::push(out_comp_results, comp_results)\n          let cur = Array::get(out_module_binding_counts, mod_idx)\n          Array::set(out_module_binding_counts, mod_idx, cur + 1)\n          binding_count = binding_count + 1\n        }\n      }\n    }\n    i = i + 1\n  }\n  binding_count\n}\n\nlet comp_inst_arg_instance = 18\n\nfn emit_canon_lift_section(buf: Bytes, core_func_idx: Int, type_idx: Int) -> Unit {\n  bytebuf_push(buf, section_canon)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  emit_canon_lift_func(content, core_func_idx, type_idx, 0, 0, 0)\n  emit_raw_content(buf, content)\n}\n\nfn emit_canon_lower_section(buf: Bytes, count: Int) -> Unit {\n  if count == 0 {\n    ()\n  }\n  else {\n    bytebuf_push(buf, section_canon)\n    let content = bytebuf_new()\n    leb128_encode_u32(content, count)\n    let mut i = 0\n    while i < count {\n      bytebuf_push(content, 1)\n      bytebuf_push(content, 0)\n      leb128_encode_u32(content, i)\n      leb128_encode_u32(content, 0)\n      i = i + 1\n    }\n    emit_raw_content(buf, content)\n  }\n}\n\nfn emit_comp_import_section(buf: Bytes, import_names: Array[String], count: Int) -> Unit {\n  if count == 0 {\n    ()\n  }\n  else {\n    bytebuf_push(buf, section_import)\n    let content = bytebuf_new()\n    leb128_encode_u32(content, count)\n    let mut i = 0\n    while i < count {\n      bytebuf_push(content, 0)\n      emit_name(content, Array::get(import_names, i))\n      bytebuf_push(content, comp_extern_func)\n      leb128_encode_u32(content, i)\n      i = i + 1\n    }\n    emit_raw_content(buf, content)\n  }\n}\n\nfn emit_core_module_section(buf: Bytes, core_wasm: Bytes) -> Unit {\n  bytebuf_push(buf, section_module)\n  let wasm_len = Bytes::length(core_wasm)\n  leb128_encode_u32(buf, wasm_len)\n  bytebuf_push_buf(buf, core_wasm)\n}\n\nfn emit_alias_run_and_memory(buf: Bytes, core_instance_idx: Int) -> Unit {\n  emit_alias_section(buf, core_instance_idx, [\n    \"_start\",\n    \"memory\"\n  ], [\n    core_sort_func,\n    core_sort_mem\n  ])\n}\n\n/// Seed-compatible `_` -> `-` rewrite. `String::replace_all` is newer than the\n/// pinned selfhost seed's frozen prelude, so a manual char loop keeps this file\n/// buildable from the fixed seed (docs/selfhost-bootstrap.md, new-feature rule).\nfn comp_underscores_to_dashes(name: String) -> String {\n  let len = String::length(name)\n  let mut out = \"\"\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(name, i)\n    if c == 95 {\n      out = String::concat(out, \"-\")\n    } else {\n      out = String::concat(out, String::from_char_code(c))\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn normalize_comp_param_name(name: String) -> String {\n  comp_underscores_to_dashes(name)\n}\n\nfn emit_comp_func_type(content: Bytes, param_types: Array[Int], param_names: Array[String], result_types: Array[Int], is_async: Int) -> Unit {\n  if is_async != 0 {\n    bytebuf_push(content, 67)\n  } else {\n    bytebuf_push(content, 64)\n  }\n  leb128_encode_u32(content, Array::length(param_types))\n  let mut i = 0\n  while i < Array::length(param_types) {\n    let name = if i < Array::length(param_names) {\n      normalize_comp_param_name(Array::get(param_names, i))\n    }\n    else {\n      \"p\\{i}\"\n    }\n    emit_name(content, name)\n    bytebuf_push(content, Array::get(param_types, i))\n    i = i + 1\n  }\n  if Array::length(result_types) == 0 {\n    bytebuf_push(content, 1)\n    leb128_encode_u32(content, 0)\n  } else {\n    if Array::length(result_types) == 1 {\n      bytebuf_push(content, 0)\n      bytebuf_push(content, Array::get(result_types, 0))\n    } else {\n      bytebuf_push(content, 1)\n      leb128_encode_u32(content, Array::length(result_types))\n      let mut r = 0\n      while r < Array::length(result_types) {\n        emit_name(content, \"r\\{r}\")\n        bytebuf_push(content, Array::get(result_types, r))\n        r = r + 1\n      }\n    }\n  }\n}\n\nfn emit_comp_type_section(buf: Bytes, sigs_params: Array[Array[Int]], sigs_param_names: Array[Array[String]], sigs_results: Array[Array[Int]], sigs_async: Array[Int]) -> Unit {\n  let count = Array::length(sigs_params)\n  if count == 0 {\n    ()\n  }\n  else {\n    bytebuf_push(buf, section_type)\n    let content = bytebuf_new()\n    leb128_encode_u32(content, count)\n    let mut i = 0\n    while i < count {\n      emit_comp_func_type(content, Array::get(sigs_params, i), Array::get(sigs_param_names, i), Array::get(sigs_results, i), Array::get(sigs_async, i))\n      i = i + 1\n    }\n    emit_raw_content(buf, content)\n  }\n}\n\nfn emit_comp_type_section_run(buf: Bytes) -> Unit {\n  bytebuf_push(buf, section_type)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  emit_comp_func_type(content, array_empty(), array_empty(), [\n    comp_valtype_s64\n  ], 0)\n  emit_raw_content(buf, content)\n}\n\nfn normalize_comp_export_name(name: String) -> String {\n  comp_underscores_to_dashes(name)\n}\n\nfn emit_comp_export_section(buf: Bytes, name: String, func_idx: Int) -> Unit {\n  let export_name = normalize_comp_export_name(name)\n  bytebuf_push(buf, section_export)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 0)\n  emit_name(content, export_name)\n  bytebuf_push(content, comp_extern_func)\n  leb128_encode_u32(content, func_idx)\n  leb128_encode_u32(content, 0)\n  emit_raw_content(buf, content)\n}\n\nexport fn comp_generate_string_trampoline(string_param_count: Int, call_run_init: Int) -> Bytes {\n  let buf = bytebuf_new()\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 97)\n  bytebuf_push(buf, 115)\n  bytebuf_push(buf, 109)\n  bytebuf_push(buf, 1)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n  let body = bytebuf_new()\n  let type_sec = bytebuf_new()\n  leb128_encode_u32(type_sec, if call_run_init != 0 {\n    4\n  } else {\n    3\n  })\n  bytebuf_push(type_sec, 96)\n  leb128_encode_u32(type_sec, string_param_count + 1)\n  let mut ti = 0\n  while ti < string_param_count {\n    bytebuf_push(type_sec, 126)\n    ti = ti + 1\n  }\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 1)\n  bytebuf_push(type_sec, 126)\n  bytebuf_push(type_sec, 96)\n  bytebuf_push(type_sec, 4)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 1)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 96)\n  leb128_encode_u32(type_sec, string_param_count * 2)\n  let mut ci = 0\n  while ci < (string_param_count * 2) {\n    bytebuf_push(type_sec, 127)\n    ci = ci + 1\n  }\n  bytebuf_push(type_sec, 1)\n  bytebuf_push(type_sec, 126)\n  if call_run_init != 0 {\n    bytebuf_push(type_sec, 96)\n    leb128_encode_u32(type_sec, 0)\n    bytebuf_push(type_sec, 1)\n    bytebuf_push(type_sec, 126)\n  }\n  bytebuf_push_section(body, 1, type_sec)\n  let import_sec = bytebuf_new()\n  leb128_encode_u32(import_sec, if call_run_init != 0 {\n    4\n  } else {\n    3\n  })\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"target_func\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"cabi_realloc\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 1)\n  if call_run_init != 0 {\n    emit_name(import_sec, \"env\")\n    emit_name(import_sec, \"run_init\")\n    bytebuf_push(import_sec, 0)\n    leb128_encode_u32(import_sec, 3)\n  }\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"memory\")\n  bytebuf_push(import_sec, 2)\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  bytebuf_push_section(body, 2, import_sec)\n  let func_sec = bytebuf_new()\n  leb128_encode_u32(func_sec, 1)\n  leb128_encode_u32(func_sec, 2)\n  bytebuf_push_section(body, 3, func_sec)\n  let export_sec = bytebuf_new()\n  leb128_encode_u32(export_sec, 1)\n  emit_name(export_sec, \"canon_func\")\n  bytebuf_push(export_sec, 0)\n  leb128_encode_u32(export_sec, if call_run_init != 0 {\n    3\n  } else {\n    2\n  })\n  bytebuf_push_section(body, 7, export_sec)\n  let code_sec = bytebuf_new()\n  leb128_encode_u32(code_sec, 1)\n  let func_body = bytebuf_new()\n  leb128_encode_u32(func_body, 2)\n  leb128_encode_u32(func_body, string_param_count)\n  bytebuf_push(func_body, 126)\n  leb128_encode_u32(func_body, string_param_count)\n  bytebuf_push(func_body, 127)\n  if call_run_init != 0 {\n    bytebuf_push(func_body, 16)\n    leb128_encode_u32(func_body, 2)\n    bytebuf_push(func_body, 26)\n  }\n  let tagged_base = string_param_count * 2\n  let obj_base = tagged_base + string_param_count\n  let mut si = 0\n  while si < string_param_count {\n    let ptr_local = si * 2\n    let len_local = (si * 2) + 1\n    let tagged_local = tagged_base + si\n    let obj_local = obj_base + si\n    emit_i32_const(func_body, 0)\n    emit_i32_const(func_body, 0)\n    emit_i32_const(func_body, 4)\n    emit_local_get(func_body, len_local)\n    emit_i32_const(func_body, 8)\n    emit_i32_add(func_body)\n    bytebuf_push(func_body, 16)\n    leb128_encode_u32(func_body, 1)\n    emit_local_set(func_body, obj_local)\n    emit_local_get(func_body, obj_local)\n    emit_i32_const(func_body, 1)\n    emit_i32_store(func_body, 0, 0)\n    emit_local_get(func_body, obj_local)\n    emit_local_get(func_body, len_local)\n    emit_i32_store(func_body, 0, 4)\n    emit_local_get(func_body, obj_local)\n    emit_i32_const(func_body, 8)\n    emit_i32_add(func_body)\n    emit_local_get(func_body, ptr_local)\n    emit_local_get(func_body, len_local)\n    bytebuf_push(func_body, 252)\n    leb128_encode_u32(func_body, 10)\n    bytebuf_push(func_body, 0)\n    bytebuf_push(func_body, 0)\n    emit_local_get(func_body, obj_local)\n    bytebuf_push(func_body, 173)\n    bytebuf_push(func_body, 66)\n    leb128_encode_s64(func_body, 1)\n    bytebuf_push(func_body, 132)\n    emit_local_set(func_body, tagged_local)\n    si = si + 1\n  }\n  let mut ci2 = 0\n  while ci2 < string_param_count {\n    emit_local_get(func_body, tagged_base + ci2)\n    ci2 = ci2 + 1\n  }\n  emit_i32_const(func_body, 0)\n  bytebuf_push(func_body, 16)\n  leb128_encode_u32(func_body, 0)\n  bytebuf_push(func_body, 11)\n  leb128_encode_u32(code_sec, Bytes::length(func_body))\n  bytebuf_push_buf(code_sec, func_body)\n  bytebuf_push_section(body, 10, code_sec)\n  bytebuf_push_buf(buf, body)\n  bytebuf_to_bytes(buf)\n}\n\nfn emit_core_instance_from_exports(buf: Bytes, num_modules: Int, module_binding_counts: Array[Int], binding_func_names: Array[String], binding_func_indices: Array[Int]) -> Unit {\n  if num_modules == 0 {\n    ()\n  }\n  else {\n    bytebuf_push(buf, section_core_instance)\n    let content = bytebuf_new()\n    leb128_encode_u32(content, num_modules)\n    let mut offset = 0\n    let mut m = 0\n    while m < num_modules {\n      let count = Array::get(module_binding_counts, m)\n      bytebuf_push(content, 1)\n      leb128_encode_u32(content, count)\n      let mut b = 0\n      while b < count {\n        emit_name(content, Array::get(binding_func_names, offset + b))\n        bytebuf_push(content, core_sort_func)\n        leb128_encode_u32(content, Array::get(binding_func_indices, offset + b))\n        b = b + 1\n      }\n      offset = offset + count\n      m = m + 1\n    }\n    emit_raw_content(buf, content)\n  }\n}\n\nfn emit_core_instance_instantiate_section(buf: Bytes, module_index: Int, module_names: Array[String]) -> Unit {\n  bytebuf_push(buf, section_core_instance)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, module_index)\n  leb128_encode_u32(content, Array::length(module_names))\n  let mut i = 0\n  while i < Array::length(module_names) {\n    emit_name(content, Array::get(module_names, i))\n    bytebuf_push(content, comp_inst_arg_instance)\n    leb128_encode_u32(content, i)\n    i = i + 1\n  }\n  emit_raw_content(buf, content)\n}\n\nexport fn comp_emit_component_wasm(core_wasm: Bytes) -> Bytes {\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, core_wasm)\n  emit_core_instance_instantiate_section(buf, 0, array_empty())\n  emit_alias_run_and_memory(buf, 0)\n  bytebuf_to_bytes(buf)\n}\n\nexport fn comp_emit_component_wasm_with_lift(core_wasm: Bytes, export_name: String) -> Bytes {\n  let import_names = array_empty()\n  let binding_func_names = array_empty()\n  let binding_func_indices = new_int_array()\n  let unique_module_names = array_empty()\n  let module_binding_counts = new_int_array()\n  let comp_params = array_empty()\n  let comp_param_names = array_empty()\n  let comp_results = array_empty()\n  let import_func_count = build_import_plan(core_wasm, import_names, binding_func_names, binding_func_indices, unique_module_names, module_binding_counts, comp_params, comp_param_names, comp_results)\n  let main_instance_idx = Array::length(unique_module_names)\n  let run_core_func_idx = import_func_count\n  let run_type_idx = import_func_count\n  let run_func_idx = import_func_count\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, core_wasm)\n  let async_flags = new_int_array()\n  let mut af = 0\n  while af < import_func_count {\n    Array::push(async_flags, 0)\n    af = af + 1\n  }\n  emit_comp_type_section(buf, comp_params, comp_param_names, comp_results, async_flags)\n  emit_comp_import_section(buf, import_names, import_func_count)\n  emit_canon_lower_section(buf, import_func_count)\n  emit_core_instance_from_exports(buf, Array::length(unique_module_names), module_binding_counts, binding_func_names, binding_func_indices)\n  emit_core_instance_instantiate_section(buf, 0, unique_module_names)\n  emit_alias_run_and_memory(buf, main_instance_idx)\n  emit_comp_type_section_run(buf)\n  emit_canon_lift_section(buf, run_core_func_idx, run_type_idx)\n  emit_comp_export_section(buf, export_name, run_func_idx)\n  bytebuf_to_bytes(buf)\n}\n\nexport fn comp_emit_component_wasm_with_string_lift(core_wasm: Bytes, target_func_name: String, export_name: String, string_param_count: Int, param_names: Array[String], is_async: Int) -> Bytes {\n  let import_names = array_empty()\n  let binding_func_names = array_empty()\n  let binding_func_indices = new_int_array()\n  let unique_module_names = array_empty()\n  let module_binding_counts = new_int_array()\n  let comp_params = array_empty()\n  let comp_param_names = array_empty()\n  let comp_results = array_empty()\n  let export_names = array_empty()\n  let export_func_indices = new_int_array()\n  let export_type_sigs = array_empty()\n  let import_func_count = build_import_plan(core_wasm, import_names, binding_func_names, binding_func_indices, unique_module_names, module_binding_counts, comp_params, comp_param_names, comp_results)\n  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)\n  let mut call_run_init = 0\n  let mut ei = 0\n  while ei < Array::length(export_names) {\n    if Array::get(export_names, ei) == \"_start\" {\n      call_run_init = 1\n      ei = Array::length(export_names)\n    } else {\n      ei = ei + 1\n    }\n  }\n  let has_distinct_run_alias =\n  if (call_run_init != 0) && (target_func_name != \"_start\") {\n    1\n  } else {\n    0\n  }\n  let main_instance_idx = Array::length(unique_module_names)\n  let trampoline_wasm = comp_generate_string_trampoline(string_param_count, call_run_init)\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, core_wasm)\n  emit_core_module_section(buf, trampoline_wasm)\n  let async_flags = new_int_array()\n  let mut af = 0\n  while af < import_func_count {\n    Array::push(async_flags, 0)\n    af = af + 1\n  }\n  emit_comp_type_section(buf, comp_params, comp_param_names, comp_results, async_flags)\n  emit_comp_import_section(buf, import_names, import_func_count)\n  emit_canon_lower_section(buf, import_func_count)\n  emit_core_instance_from_exports(buf, Array::length(unique_module_names), module_binding_counts, binding_func_names, binding_func_indices)\n  emit_core_instance_instantiate_section(buf, 0, unique_module_names)\n  let alias_names = array_empty()\n  let alias_sorts = new_int_array()\n  Array::push(alias_names, target_func_name)\n  Array::push(alias_sorts, core_sort_func)\n  Array::push(alias_names, \"cabi_realloc\")\n  Array::push(alias_sorts, core_sort_func)\n  if has_distinct_run_alias != 0 {\n    Array::push(alias_names, \"_start\")\n    Array::push(alias_sorts, core_sort_func)\n  }\n  Array::push(alias_names, \"memory\")\n  Array::push(alias_sorts, core_sort_mem)\n  emit_alias_section(buf, main_instance_idx, alias_names, alias_sorts)\n  let target_func_core_idx = import_func_count\n  let cabi_realloc_core_idx = import_func_count + 1\n  let run_init_core_idx =\n  if call_run_init != 0 {\n    if has_distinct_run_alias != 0 {\n      import_func_count + 2\n    } else {\n      target_func_core_idx\n    }\n  } else {\n    0 - 1\n  }\n  bytebuf_push(buf, section_core_instance)\n  let tramp_env = bytebuf_new()\n  leb128_encode_u32(tramp_env, 1)\n  bytebuf_push(tramp_env, 1)\n  leb128_encode_u32(tramp_env, if call_run_init != 0 {\n    4\n  } else {\n    3\n  })\n  emit_name(tramp_env, \"target_func\")\n  bytebuf_push(tramp_env, core_sort_func)\n  leb128_encode_u32(tramp_env, target_func_core_idx)\n  emit_name(tramp_env, \"cabi_realloc\")\n  bytebuf_push(tramp_env, core_sort_func)\n  leb128_encode_u32(tramp_env, cabi_realloc_core_idx)\n  if call_run_init != 0 {\n    emit_name(tramp_env, \"run_init\")\n    bytebuf_push(tramp_env, core_sort_func)\n    leb128_encode_u32(tramp_env, run_init_core_idx)\n  }\n  emit_name(tramp_env, \"memory\")\n  bytebuf_push(tramp_env, core_sort_mem)\n  leb128_encode_u32(tramp_env, 0)\n  emit_raw_content(buf, tramp_env)\n  let env_instance_idx = main_instance_idx + 1\n  bytebuf_push(buf, section_core_instance)\n  let tramp_inst = bytebuf_new()\n  leb128_encode_u32(tramp_inst, 1)\n  bytebuf_push(tramp_inst, 0)\n  leb128_encode_u32(tramp_inst, 1)\n  leb128_encode_u32(tramp_inst, 1)\n  emit_name(tramp_inst, \"env\")\n  bytebuf_push(tramp_inst, comp_inst_arg_instance)\n  leb128_encode_u32(tramp_inst, env_instance_idx)\n  emit_raw_content(buf, tramp_inst)\n  let trampoline_instance_idx = env_instance_idx + 1\n  emit_alias_section(buf, trampoline_instance_idx, [\n    \"canon_func\"\n  ], [\n    core_sort_func\n  ])\n  let alias_func_count = if has_distinct_run_alias != 0 {\n    3\n  } else {\n    2\n  }\n  let canon_func_core_idx = import_func_count + alias_func_count\n  bytebuf_push(buf, section_type)\n  let type_content = bytebuf_new()\n  leb128_encode_u32(type_content, 1)\n  if is_async != 0 {\n    bytebuf_push(type_content, 67)\n  } else {\n    bytebuf_push(type_content, 64)\n  }\n  leb128_encode_u32(type_content, string_param_count)\n  let mut pi = 0\n  while pi < string_param_count {\n    let pname = if pi < Array::length(param_names) {\n      normalize_comp_param_name(Array::get(param_names, pi))\n    }\n    else {\n      \"p\\{pi}\"\n    }\n    emit_name(type_content, pname)\n    bytebuf_push(type_content, comp_valtype_string)\n    pi = pi + 1\n  }\n  bytebuf_push(type_content, 0)\n  bytebuf_push(type_content, comp_valtype_s64)\n  emit_raw_content(buf, type_content)\n  let component_type_idx = import_func_count\n  bytebuf_push(buf, section_canon)\n  let canon_content = bytebuf_new()\n  leb128_encode_u32(canon_content, 1)\n  emit_canon_lift_func(canon_content, canon_func_core_idx, component_type_idx, 1, 0, cabi_realloc_core_idx)\n  emit_raw_content(buf, canon_content)\n  let lifted_func_idx = import_func_count\n  emit_comp_export_section(buf, export_name, lifted_func_idx)\n  bytebuf_to_bytes(buf)\n}\n\n/// WASI 0.3 async (M1b, docs/spec/wasi-p3-async.md §3.2). The `task.return`\n/// canonical built-in lowers to a core func `(param <result>) -> ()` that\n/// delivers an async-lifted export's result. Encoding verified byte-for-byte\n/// against src/x/cm_async/cm_async_lift_probe.wat (runs on wasmtime 45):\n/// section 0x08, body `01 09 00 <valtype> 00` (count=1; opcode 0x09; result\n/// Some(valtype); empty options).\nfn emit_canon_task_return(buf: Bytes, result_valtype: Int) -> Unit {\n  bytebuf_push(buf, section_canon)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 9)\n  bytebuf_push(content, 0)\n  bytebuf_push(content, result_valtype)\n  bytebuf_push(content, 0)\n  emit_raw_content(buf, content)\n}\n\n/// Async (callback-less / stackful) `canon lift`. Unlike emit_canon_lift_func it\n/// carries the async canonopt (0x06). Verified body: `01 00 00 <core_func_idx>\n/// 01 06 <type_idx>` (count=1; lift; core-func sort; idx; 1 option = async).\nfn emit_canon_lift_async_section(buf: Bytes, core_func_idx: Int, type_idx: Int) -> Unit {\n  bytebuf_push(buf, section_canon)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 0)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, core_func_idx)\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 6)\n  leb128_encode_u32(content, type_idx)\n  emit_raw_content(buf, content)\n}\n\n/// Component type section with a single async func type `() -> <result>`.\n/// Verified body: `01 43 00 00 <valtype>` (count=1; async functype opcode 0x43;\n/// 0 params; result-form 0x00 + valtype).\nfn emit_comp_async_functype_section(buf: Bytes, result_valtype: Int) -> Unit {\n  bytebuf_push(buf, section_type)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 67)\n  bytebuf_push(content, 0)\n  bytebuf_push(content, 0)\n  bytebuf_push(content, result_valtype)\n  emit_raw_content(buf, content)\n}\n\n/// Wrap a core module that imports (\"cm\",\"task-return\") and exports a void `run`\n/// into an async-lifted component export. Section order mirrors\n/// cm_async_lift_probe.wat (verified to run on wasmtime 45 with\n/// -W concurrency-support=y component-model-async=y component-model-async-stackful=y).\n/// `result_valtype` is the component valtype of the lifted result (e.g.\n/// comp_valtype_s64 for vibe Int).\nexport fn comp_emit_component_wasm_async(core_wasm: Bytes, export_name: String, result_valtype: Int) -> Bytes {\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, core_wasm)\n  emit_canon_task_return(buf, result_valtype)\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"task-return\"\n  ], [\n    0\n  ])\n  emit_core_instance_instantiate_section(buf, 0, [\n    \"cm\"\n  ])\n  emit_comp_async_functype_section(buf, result_valtype)\n  emit_alias_section(buf, 1, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_canon_lift_async_section(buf, 1, 0)\n  emit_comp_export_section(buf, export_name, 0)\n  bytebuf_to_bytes(buf)\n}\n\n/// Map a component valtype to the core valtype it lowers from (inverse of\n/// core_to_comp_valtype). Used to type the trampoline module's entry/task-return.\nfn comp_valtype_to_core(v: Int) -> Int {\n  if v == comp_valtype_s64 {\n    126\n  }\n  else {\n    if v == comp_valtype_s32 {\n      127\n    }\n    else {\n      if v == comp_valtype_f32 {\n        125\n      }\n      else {\n        if v == comp_valtype_f64 {\n          124\n        }\n        else {\n          127\n        }\n      }\n    }\n  }\n}\n\n/// M1b-2 (docs/spec/wasi-p3-async.md §3.4). Async trampoline core module: imports\n/// the normally-compiled entry (\"main\",\"run\" : () -> <core_valtype>) and\n/// (\"cm\",\"task-return\" : (<core_valtype>) -> ()), and exports a void `run` that\n/// calls the entry and forwards its result to task.return. Byte template verified\n/// against src/x/cm_async/cm_async_trampoline_probe.wat (runs on wasmtime 45).\nfn comp_generate_async_trampoline(core_valtype: Int) -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  let tc = bytebuf_new()\n  bytebuf_push_vec_header(tc, 3)\n  // type0: the entry `run` — a nullary vibe fn compiles to (param i64) -> result\n  // (the i64 is the unit argument), so the trampoline passes a dummy i64.\n  emit_func_type_raw(tc, [\n    126\n  ], [\n    core_valtype\n  ])\n  emit_func_type_raw(tc, [\n    core_valtype\n  ], array_empty())\n  emit_func_type_raw(tc, array_empty(), array_empty())\n  bytebuf_push_section(out, 1, tc)\n  let ic = bytebuf_new()\n  bytebuf_push_vec_header(ic, 2)\n  emit_name(ic, \"main\")\n  emit_name(ic, \"run\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 0)\n  emit_name(ic, \"cm\")\n  emit_name(ic, \"task-return\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 1)\n  bytebuf_push_section(out, 2, ic)\n  emit_function_section(out, [\n    2\n  ])\n  emit_export_section(out, \"run\", 2)\n  let body = bytebuf_new()\n  emit_i64_const(body, 0)\n  bytebuf_push(body, 16)\n  leb128_encode_u32(body, 0)\n  bytebuf_push(body, 16)\n  leb128_encode_u32(body, 1)\n  emit_code_section(out, [\n    body\n  ])\n  bytebuf_to_bytes(out)\n}\n\n/// Instantiate a core module with explicit (arg-name -> core-instance-index) args.\n/// Unlike emit_core_instance_instantiate_section, the arg instance indices need\n/// not be sequential.\nfn emit_core_instance_instantiate_args(buf: Bytes, module_index: Int, arg_names: Array[String], arg_instance_indices: Array[Int]) -> Unit {\n  bytebuf_push(buf, section_core_instance)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, module_index)\n  leb128_encode_u32(content, Array::length(arg_names))\n  let mut i = 0\n  while i < Array::length(arg_names) {\n    emit_name(content, Array::get(arg_names, i))\n    bytebuf_push(content, comp_inst_arg_instance)\n    leb128_encode_u32(content, Array::get(arg_instance_indices, i))\n    i = i + 1\n  }\n  emit_raw_content(buf, content)\n}\n\n/// Wrap a normally-compiled core module (exporting `run : () -> <core>`, value\n/// returned directly) into an async-lifted component export via the trampoline\n/// (two-module) approach — no change to the core module / linked_compile needed.\n/// `comp_result_valtype` is the component valtype of the lifted result\n/// (comp_valtype_s64 for vibe Int). Section order mirrors\n/// cm_async_trampoline_probe.wat (verified to run on wasmtime 45).\nexport fn comp_emit_component_wasm_async_trampolined(main_core_wasm: Bytes, export_name: String, comp_result_valtype: Int) -> Bytes {\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, main_core_wasm)\n  emit_core_module_section(buf, comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))\n  emit_core_instance_instantiate_section(buf, 0, array_empty())\n  emit_canon_task_return(buf, comp_result_valtype)\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"task-return\"\n  ], [\n    0\n  ])\n  emit_alias_section(buf, 0, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"run\"\n  ], [\n    1\n  ])\n  emit_core_instance_instantiate_args(buf, 1, [\n    \"main\",\n    \"cm\"\n  ], [\n    2,\n    1\n  ])\n  emit_comp_async_functype_section(buf, comp_result_valtype)\n  emit_alias_section(buf, 3, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_canon_lift_async_section(buf, 2, 0)\n  emit_comp_export_section(buf, export_name, 0)\n  bytebuf_to_bytes(buf)\n}\n\n/// M1b-2d: a no-op `wasi_snapshot_preview1.fd_write` stub core module\n/// (`(i32,i32,i32,i32) -> i32` returning 0). Compiled core modules\n/// import fd_write from wasi_snapshot_preview1 for their runtime preamble; the\n/// stub satisfies that import so the async component is self-contained and\n/// instantiable without an external preview1 adapter.\nfn comp_generate_wasi_fd_write_stub() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  let tc = bytebuf_new()\n  bytebuf_push_vec_header(tc, 1)\n  emit_func_type_raw(tc, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  bytebuf_push_section(out, 1, tc)\n  emit_function_section(out, [\n    0\n  ])\n  emit_export_section(out, \"fd_write\", 0)\n  let body = bytebuf_new()\n  emit_i32_const(body, 0)\n  emit_code_section(out, [\n    body\n  ])\n  bytebuf_to_bytes(out)\n}\n\n/// Like comp_emit_component_wasm_async_trampolined, but for a main core module\n/// that imports `wasi_snapshot_preview1.fd_write` (every compiled core does). A\n/// fd_write stub module is instantiated first and supplied to the main module's\n/// instantiation, making the async component fully self-contained / runnable.\n/// core instances: 0=wasi-stub, 1=main(+wasi), 2=cm(task-return), 3=env(run),\n/// 4=trampoline. core funcs: 0=task.return, 1=main.run, 2=trampoline.run.\nexport fn comp_emit_component_wasm_async_trampolined_p1(main_core_wasm: Bytes, export_name: String, comp_result_valtype: Int) -> Bytes {\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, main_core_wasm)\n  emit_core_module_section(buf, comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))\n  emit_core_module_section(buf, comp_generate_wasi_fd_write_stub())\n  emit_core_instance_instantiate_section(buf, 2, array_empty())\n  emit_core_instance_instantiate_args(buf, 0, [\n    \"wasi_snapshot_preview1\"\n  ], [\n    0\n  ])\n  emit_canon_task_return(buf, comp_result_valtype)\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"task-return\"\n  ], [\n    0\n  ])\n  emit_alias_section(buf, 1, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"run\"\n  ], [\n    1\n  ])\n  emit_core_instance_instantiate_args(buf, 1, [\n    \"main\",\n    \"cm\"\n  ], [\n    3,\n    2\n  ])\n  emit_comp_async_functype_section(buf, comp_result_valtype)\n  emit_alias_section(buf, 4, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_canon_lift_async_section(buf, 2, 0)\n  emit_comp_export_section(buf, export_name, 0)\n  bytebuf_to_bytes(buf)\n}\n\n/// #1230 M1b-3c-1b: component valtype for u32, matching the\n/// wasip3_component_probe's own result type (see spawned_future/ below).\nlet comp_valtype_u32 = 121\n\n/// #1230 M1b-3c-1b: canon `lower <f> async (memory M)` -- the async\n/// counterpart to emit_canon_lower_section above (which only ever emits the\n/// sync, zero-canonopt form). Byte shape recovered from a validated,\n/// actually-running component via `wasm-tools dump` against\n/// tools/wasip3_component_probe/spawned_future/component.wat's compiled\n/// output (not hand-derived from the spec): `01 00 <funcidx> 02 06 03\n/// <memidx>` -- opcode=lower(1), reserved byte(0), funcidx, canonopt-count=2,\n/// async tag(6), memory tag(3)+core-memory-idx.\nfn emit_canon_lower_async_section(buf: Bytes, comp_func_idx: Int, memory_core_idx: Int) -> Unit {\n  bytebuf_push(buf, section_canon)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 1)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, comp_func_idx)\n  leb128_encode_u32(content, 2)\n  bytebuf_push(content, 6)\n  bytebuf_push(content, 3)\n  leb128_encode_u32(content, memory_core_idx)\n  emit_raw_content(buf, content)\n}\n\n/// #1230 M1b-3c-1b: canon waitable-set.new -- single-byte opcode 0x1f (31),\n/// verified via wasm-tools dump against spawned_future/component.wat.\nfn emit_canon_waitable_set_new(buf: Bytes) -> Unit {\n  bytebuf_push(buf, section_canon)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 31)\n  emit_raw_content(buf, content)\n}\n\n/// #1230 M1b-3c-1b: canon waitable.join -- single-byte opcode 0x23 (35).\nfn emit_canon_waitable_join(buf: Bytes) -> Unit {\n  bytebuf_push(buf, section_canon)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 35)\n  emit_raw_content(buf, content)\n}\n\n/// #1230 M1b-3c-1b: canon waitable-set.wait (memory M) -- opcode 0x20 (32),\n/// a cancellable flag byte (0 = not cancellable, matching the probe), then\n/// the memory core index.\nfn emit_canon_waitable_set_wait(buf: Bytes, memory_core_idx: Int) -> Unit {\n  bytebuf_push(buf, section_canon)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 32)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, memory_core_idx)\n  emit_raw_content(buf, content)\n}\n\n/// #1230 M1b-3c-1b: canon waitable-set.drop -- single-byte opcode 0x22 (34).\nfn emit_canon_waitable_set_drop(buf: Bytes) -> Unit {\n  bytebuf_push(buf, section_canon)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 34)\n  emit_raw_content(buf, content)\n}\n\n/// #1230 M1b-3c-1b: canon subtask.drop -- single-byte opcode 0x0d (13).\nfn emit_canon_subtask_drop(buf: Bytes) -> Unit {\n  bytebuf_push(buf, section_canon)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 13)\n  emit_raw_content(buf, content)\n}\n\n/// #1230 M1b-3c-1b: standalone memory-hosting core module (mirrors\n/// spawned_future/component.wat's `$memhost`) -- exists purely so a\n/// concrete memory instance is available to hand to every async canon\n/// built-in's `(memory ...)` option (and to the guest module's own memory\n/// IMPORT, see comp_generate_spawned_future_guest_core_module) before the\n/// guest module itself is instantiated, breaking the \"canon options need\n/// memory before the guest/memory exists\" circularity documented in\n/// tools/wasip3_component_probe/stackful/README.md bug #2.\nfn comp_generate_memhost_module() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_memory_section(out, 1)\n  emit_export_memory(out, \"memory\", 0)\n  bytebuf_to_bytes(out)\n}\n\n/// #1230 M1b-3c-1b: blocking-await guest core module with the wait loop\n/// factored into its own function -- a direct translation of\n/// tools/wasip3_component_probe/spawned_future/component.wat's `$guest`\n/// module. `$writer` performs the async-lowered host call + waitable-set\n/// retry loop; `$run` calls it and forwards the result to task.return.\n///\n/// SCOPE / WHAT THIS DOES AND DOES NOT PROVE (#1240 review). `$writer` is\n/// an ORDINARY internal wasm function that `$run` calls synchronously --\n/// NOT a second Component-Model task. So this shape only models\n/// `spawn(f); await(t)` in the degenerate case where nothing observable\n/// happens in the parent between the spawn and the join: the \"spawn\" is\n/// then semantically a no-op and compiles away to a direct call, and the\n/// canon set needed is exactly the simpler stackful/ probe's\n/// (task.return, async-lowered host import, waitable-set.new/.wait/.drop,\n/// waitable.join, subtask.drop) -- which the probe verifies end-to-end\n/// against a genuinely blocking host import.\n///\n/// It does NOT establish that a REAL spawn -- a second guest computation\n/// that interleaves with parent work before the join -- needs no extra\n/// machinery. It cannot: one stackful fiber runs one call chain, so\n/// concurrent guest work requires either another task or a guest-side\n/// poll executor. The Phase A probe's evidence points the other way: a\n/// genuine `wit_bindgen::spawn_local` pulls in a FuturesUnordered\n/// executor plus `context.get/set` and `waitable-set.poll`. Any\n/// parent/child handshake, or observable work between spawn and join,\n/// would therefore reorder or deadlock under this lowering -- the same\n/// limitation the linear backend's eager `Task::spawn` already carries\n/// (docs/spec/wasi-p3-async.md §2.5). Real interleaving spawn stays open\n/// (M-conc-2 / the M1b-3c-2 follow-up).\n///\n/// Local func indices: 7 = $writer (type1: () -> i32; performs the\n/// async-lowered host call + waitable-set retry loop and returns the\n/// resolved value like an ordinary helper function), 8 = $run\n/// (type5: () -> (); exported \"run\"; calls $writer and forwards its result\n/// to task.return). Import func indices 0-6 occupy the func index space\n/// before them (0=[async-lower]get-async, 1=[waitable-set-new],\n/// 2=[waitable-join], 3=[waitable-set-wait], 4=[waitable-set-drop],\n/// 5=[subtask-drop], 6=[task-return]run).\nfn comp_generate_spawned_future_guest_core_module() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  // types: 0 (i32)->(i32) get_async; 1 ()->(i32) ws_new & $writer;\n  // 2 (i32,i32)->() waitable_join; 3 (i32,i32)->(i32) ws_wait;\n  // 4 (i32)->() ws_drop/subtask_drop/task_return; 5 ()->() $run.\n  let tc = bytebuf_new()\n  bytebuf_push_vec_header(tc, 6)\n  emit_func_type_raw(tc, [\n    127\n  ], [\n    127\n  ])\n  emit_func_type_raw(tc, array_empty(), [\n    127\n  ])\n  emit_func_type_raw(tc, [\n    127,\n    127\n  ], array_empty())\n  emit_func_type_raw(tc, [\n    127,\n    127\n  ], [\n    127\n  ])\n  emit_func_type_raw(tc, [\n    127\n  ], array_empty())\n  emit_func_type_raw(tc, array_empty(), array_empty())\n  bytebuf_push_section(out, 1, tc)\n  // imports: 7 core funcs (indices 0-6) + memory (module \"env\", IMPORTED\n  // rather than declared/exported -- probe bug #2: every async canon\n  // built-in's (memory ...) option must reference the SAME memory instance\n  // the guest's own code reads/writes through).\n  let ic = bytebuf_new()\n  bytebuf_push_vec_header(ic, 8)\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[async-lower]get-async\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 0)\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[waitable-set-new]\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 1)\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[waitable-join]\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 2)\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[waitable-set-wait]\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 3)\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[waitable-set-drop]\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 4)\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[subtask-drop]\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 4)\n  emit_name(ic, \"[export]$root\")\n  emit_name(ic, \"[task-return]run\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 4)\n  emit_name(ic, \"env\")\n  emit_name(ic, \"memory\")\n  bytebuf_push(ic, 2)\n  bytebuf_push(ic, 0)\n  leb128_encode_u32(ic, 1)\n  bytebuf_push_section(out, 2, ic)\n  emit_function_section(out, [\n    1,\n    5\n  ])\n  emit_export_section(out, \"run\", 8)\n  // Code section built by hand (not via emit_code_section/\n  // emit_code_section_with_locals -- neither supports declaring i32-typed\n  // locals): $writer needs 5 i32 locals, matching the string-trampoline\n  // functions above's own manual code-section convention.\n  let code_sec = bytebuf_new()\n  leb128_encode_u32(code_sec, 2)\n  // $writer (func idx 7). locals: 0=packed, 1=code, 2=subtask, 3=ws,\n  // 4=event0, 5=has_ws (all i32). Direct translation of component.wat's\n  // $writer body. `has_ws` (zero-initialized like every wasm local) records\n  // whether the BLOCKED path actually allocated a waitable set, so the\n  // epilogue can drop it -- #1240 review: without it every blocking call\n  // leaks one canonical waitable-set handle, eventually exhausting the\n  // instance's handle space. (The stackful/ probe has the same latent leak;\n  // it imports [waitable-set-drop] and never calls it. Harmless there --\n  // one-shot probe -- but not in emitted code.)\n  let writer_body = bytebuf_new()\n  leb128_encode_u32(writer_body, 1)\n  leb128_encode_u32(writer_body, 6)\n  bytebuf_push(writer_body, 127)\n  emit_i32_const(writer_body, 0)\n  emit_call(writer_body, 0)\n  emit_local_set(writer_body, 0)\n  emit_local_get(writer_body, 0)\n  emit_i32_const(writer_body, 15)\n  emit_i32_and(writer_body)\n  emit_local_set(writer_body, 1)\n  emit_local_get(writer_body, 0)\n  emit_i32_const(writer_body, 4)\n  emit_i32_shr_u(writer_body)\n  emit_local_set(writer_body, 2)\n  emit_block_void(writer_body)\n  emit_local_get(writer_body, 1)\n  emit_i32_const(writer_body, 2)\n  emit_i32_eq(writer_body)\n  emit_br_if(writer_body, 0)\n  emit_call(writer_body, 1)\n  emit_local_set(writer_body, 3)\n  emit_i32_const(writer_body, 1)\n  emit_local_set(writer_body, 5)\n  emit_local_get(writer_body, 2)\n  emit_local_get(writer_body, 3)\n  emit_call(writer_body, 2)\n  emit_loop_void(writer_body)\n  emit_local_get(writer_body, 3)\n  emit_i32_const(writer_body, 8)\n  emit_call(writer_body, 3)\n  emit_local_set(writer_body, 4)\n  emit_local_get(writer_body, 4)\n  emit_i32_const(writer_body, 1)\n  emit_i32_eq(writer_body)\n  emit_if_void(writer_body)\n  emit_i32_const(writer_body, 12)\n  emit_i32_load(writer_body, 2, 0)\n  emit_local_set(writer_body, 1)\n  emit_local_get(writer_body, 1)\n  emit_i32_const(writer_body, 2)\n  emit_i32_eq(writer_body)\n  emit_br_if(writer_body, 2)\n  emit_end(writer_body)\n  emit_br(writer_body, 0)\n  emit_end(writer_body)\n  emit_end(writer_body)\n  // epilogue: on the BLOCKED path only, drop the subtask FIRST and then the\n  // waitable set; then load the host's result from the results area.\n  //\n  // Both drops are guarded by the same flag (local 5) because both resources\n  // come into existence together, in the same straight-line blocked-path\n  // sequence: an async-lowered call that completes EAGERLY (status RETURNED\n  // straight out of the call, the `br_if $done` above) creates NO subtask --\n  // the handle bits of the packed result are 0 -- and allocates no waitable\n  // set. #1230 M1b-3c-2: dropping unconditionally therefore traps with\n  // \"unknown handle index 0\" the moment a host import resolves without\n  // suspending, which is an entirely ordinary thing for a real host to do\n  // (a cached value, a zero timeout, a socket read whose data already\n  // arrived). Found live by driving this component through runtime/viberun\n  // with a zero-delay host import; the probe's own host always slept 300ms,\n  // so it only ever exercised the blocked path.\n  //\n  // Order matters within the guard: the subtask was `waitable.join`ed into\n  // the set, so dropping the set while it still holds the subtask traps with\n  // \"resource has children\" (observed live on wasmtime 47).\n  emit_local_get(writer_body, 5)\n  emit_if_void(writer_body)\n  emit_local_get(writer_body, 2)\n  emit_call(writer_body, 5)\n  emit_local_get(writer_body, 3)\n  emit_call(writer_body, 4)\n  emit_end(writer_body)\n  emit_i32_const(writer_body, 0)\n  emit_i32_load(writer_body, 2, 0)\n  bytebuf_push(writer_body, 11)\n  leb128_encode_u32(code_sec, Bytes::length(writer_body))\n  bytebuf_push_buf(code_sec, writer_body)\n  // $run (func idx 8): call $writer, forward its result to task_return.\n  let run_body = bytebuf_new()\n  leb128_encode_u32(run_body, 0)\n  emit_call(run_body, 7)\n  emit_call(run_body, 6)\n  bytebuf_push(run_body, 11)\n  leb128_encode_u32(code_sec, Bytes::length(run_body))\n  bytebuf_push_buf(code_sec, run_body)\n  bytebuf_push_section(out, 10, code_sec)\n  bytebuf_to_bytes(out)\n}\n\n/// #1230 M1b-3c-3: guest core module for \"two host operations genuinely in\n/// flight at the same time\" -- a byte-level port of\n/// tools/wasip3_component_probe/concurrent_awaits/component.wat.\n///\n/// Same imports, same types, same canon set as the spawned-future module\n/// above; only $both's body differs. That is the finding this milestone\n/// records: real concurrency needs NO canon built-in beyond the ones\n/// M1b-3c-1b already proved. What produces it is purely the ORDER of\n/// operations -- issue both async-lowered calls BEFORE waiting on either.\n/// A \"start A, wait A, start B, wait B\" body emits the identical\n/// instructions and returns the identical value, and takes twice as long.\n///\n/// Note this is NOT M1b-3c-1c (\"interleaving spawn\"). Here one guest\n/// computation waits on several host operations, which a waitable set with\n/// several joined subtasks expresses directly. Two concurrent GUEST\n/// computations still need a second task or a guest-side poll executor and\n/// remain open.\n///\n/// Memory layout (the shared memhost page):\n///    0  result slot for call A       16  waitable-set.wait payload[0]\n///    4  result slot for call B            = which waitable fired\n///                                    20  payload[1] = its status code\n///\n/// $both's locals (all i32): 0=packed_a 1=packed_b 2=code_a 3=code_b\n/// 4=sub_a 5=sub_b 6=ws 7=pending 8=event0 9=handle 10=status 11=has_ws.\nfn comp_generate_concurrent_awaits_guest_core_module() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  let tc = bytebuf_new()\n  bytebuf_push_vec_header(tc, 6)\n  emit_func_type_raw(tc, [\n    127\n  ], [\n    127\n  ])\n  emit_func_type_raw(tc, array_empty(), [\n    127\n  ])\n  emit_func_type_raw(tc, [\n    127,\n    127\n  ], array_empty())\n  emit_func_type_raw(tc, [\n    127,\n    127\n  ], [\n    127\n  ])\n  emit_func_type_raw(tc, [\n    127\n  ], array_empty())\n  emit_func_type_raw(tc, array_empty(), array_empty())\n  bytebuf_push_section(out, 1, tc)\n  let ic = bytebuf_new()\n  bytebuf_push_vec_header(ic, 8)\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[async-lower]get-async\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 0)\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[waitable-set-new]\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 1)\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[waitable-join]\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 2)\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[waitable-set-wait]\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 3)\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[waitable-set-drop]\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 4)\n  emit_name(ic, \"$root\")\n  emit_name(ic, \"[subtask-drop]\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 4)\n  emit_name(ic, \"[export]$root\")\n  emit_name(ic, \"[task-return]run\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 4)\n  emit_name(ic, \"env\")\n  emit_name(ic, \"memory\")\n  bytebuf_push(ic, 2)\n  bytebuf_push(ic, 0)\n  leb128_encode_u32(ic, 1)\n  bytebuf_push_section(out, 2, ic)\n  emit_function_section(out, [\n    1,\n    5\n  ])\n  emit_export_section(out, \"run\", 8)\n  let code_sec = bytebuf_new()\n  leb128_encode_u32(code_sec, 2)\n  let b = bytebuf_new()\n  leb128_encode_u32(b, 1)\n  leb128_encode_u32(b, 12)\n  bytebuf_push(b, 127)\n  // --- start BOTH calls before waiting on either ---------------------------\n  emit_i32_const(b, 0)\n  emit_call(b, 0)\n  emit_local_set(b, 0)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 15)\n  emit_i32_and(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 4)\n  emit_i32_shr_u(b)\n  emit_local_set(b, 4)\n  emit_i32_const(b, 4)\n  emit_call(b, 0)\n  emit_local_set(b, 1)\n  emit_local_get(b, 1)\n  emit_i32_const(b, 15)\n  emit_i32_and(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 1)\n  emit_i32_const(b, 4)\n  emit_i32_shr_u(b)\n  emit_local_set(b, 5)\n  // --- count how many actually blocked -------------------------------------\n  // A call that completed eagerly (status RETURNED, code 2) created no\n  // subtask, so it is neither joined nor dropped -- the eager path the\n  // spawned-future shape got wrong before M1b-3c-2.\n  emit_i32_const(b, 0)\n  emit_local_set(b, 7)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 2)\n  emit_i32_ne(b)\n  emit_if_void(b)\n  emit_local_get(b, 7)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 7)\n  emit_end(b)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 2)\n  emit_i32_ne(b)\n  emit_if_void(b)\n  emit_local_get(b, 7)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 7)\n  emit_end(b)\n  // --- join the pending ones into one set and drain it ---------------------\n  emit_local_get(b, 7)\n  emit_i32_const(b, 0)\n  emit_i32_gt_u(b)\n  emit_if_void(b)\n  emit_call(b, 1)\n  emit_local_set(b, 6)\n  emit_i32_const(b, 1)\n  emit_local_set(b, 11)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 2)\n  emit_i32_ne(b)\n  emit_if_void(b)\n  emit_local_get(b, 4)\n  emit_local_get(b, 6)\n  emit_call(b, 2)\n  emit_end(b)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 2)\n  emit_i32_ne(b)\n  emit_if_void(b)\n  emit_local_get(b, 5)\n  emit_local_get(b, 6)\n  emit_call(b, 2)\n  emit_end(b)\n  // One wait loop retires BOTH subtasks. payload[0] (addr 16) names the\n  // waitable that fired, so either completion order works.\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 6)\n  emit_i32_const(b, 16)\n  emit_call(b, 3)\n  emit_local_set(b, 8)\n  emit_local_get(b, 8)\n  emit_i32_const(b, 1)\n  emit_i32_eq(b)\n  emit_if_void(b)\n  emit_i32_const(b, 16)\n  emit_i32_load(b, 2, 0)\n  emit_local_set(b, 9)\n  emit_i32_const(b, 20)\n  emit_i32_load(b, 2, 0)\n  emit_local_set(b, 10)\n  emit_local_get(b, 10)\n  emit_i32_const(b, 2)\n  emit_i32_eq(b)\n  emit_if_void(b)\n  emit_local_get(b, 9)\n  emit_call(b, 5)\n  emit_local_get(b, 7)\n  emit_i32_const(b, 1)\n  emit_i32_sub(b)\n  emit_local_set(b, 7)\n  emit_local_get(b, 7)\n  emit_i32_eqz(b)\n  // depth 3 = the enclosing `block`: 0 = this if(status==2),\n  // 1 = if(event0==1), 2 = loop, 3 = block. (The spawned-future module's\n  // equivalent branch is depth 2 because it has one fewer nested if.)\n  emit_br_if(b, 3)\n  emit_end(b)\n  emit_end(b)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 6)\n  emit_call(b, 4)\n  emit_end(b)\n  // --- both results are in memory now; return their sum --------------------\n  emit_i32_const(b, 0)\n  emit_i32_load(b, 2, 0)\n  emit_i32_const(b, 4)\n  emit_i32_load(b, 2, 0)\n  emit_i32_add(b)\n  bytebuf_push(b, 11)\n  leb128_encode_u32(code_sec, Bytes::length(b))\n  bytebuf_push_buf(code_sec, b)\n  let run_body = bytebuf_new()\n  leb128_encode_u32(run_body, 0)\n  emit_call(run_body, 7)\n  emit_call(run_body, 6)\n  bytebuf_push(run_body, 11)\n  leb128_encode_u32(code_sec, Bytes::length(run_body))\n  bytebuf_push_buf(code_sec, run_body)\n  bytebuf_push_section(out, 10, code_sec)\n  bytebuf_to_bytes(out)\n}\n\n/// #1230 M1b-3c-1b: wrap the fixed-shape blocking-await guest module\n/// (above) into a fully self-contained async component -- a byte-exact port\n/// of tools/wasip3_component_probe/spawned_future/component.wat, verified\n/// via `wasm-tools dump`/`wasm-tools validate` and the probe's Rust host\n/// driver (genuinely non-ready wait, resolves to the host import's value).\n/// Unlike comp_emit_component_wasm_async_trampolined_p1 this does not wrap\n/// an arbitrary compiled `.vibe` core module -- it is the M1b-1-shaped half\n/// of this milestone (emitter, byte-exact verified), not the M1b-2c-shaped\n/// half (wiring into real `.vibe` source), which is left to a follow-up\n/// once vibe-source-level spawn/future syntax exists. See the guest\n/// module's own doc comment for what the \"spawn\" framing does and does NOT\n/// cover -- notably, real interleaving spawn is still open.\n/// `comp_result_valtype` must be comp_valtype_u32 (the probe-verified\n/// shape); anything else throws, see the guard in the body.\n///\n/// Core instance indices (in emission order): 0=memhost, 1=root ($root\n/// bindings), 2=export-root ([export]$root binding), 3=env (memory\n/// binding), 4=guest. Core func indices: 0=lower(get-async),\n/// 1=task-return, 2=waitable-set.new, 3=waitable.join, 4=waitable-set.wait,\n/// 5=waitable-set.drop, 6=subtask.drop, 7=alias(guest-inst, \"run\"). Core\n/// memory alias index: 0 (memhost's \"memory\" export, reused for every\n/// canon (memory ...) option and for the \"env\" instantiation arg). Component\n/// func indices: 0=the \"get-async\" import, 1=the lifted \"run\" export.\n/// Component type indices: 0=the import's async functype, 1=the export's.\n/// #1230 M1b-3c-3: the composition shared by the two fixed-shape\n/// self-contained async components (spawned-future and concurrent-awaits).\n/// They differ ONLY in the guest core module -- same imports, same canon\n/// set, same instance/index layout -- so the wrapper lives here once and\n/// each public emitter supplies its own guest bytes plus a `shape` label\n/// for the diagnostic.\nfn comp_emit_self_contained_async_component(export_name: String, comp_result_valtype: Int, guest_module: Bytes, shape: String) -> Bytes with { Error } {\n  // #1240 review: the guest core modules are hard-coded to an i32-shaped\n  // result (an `(i32) -> ()` [task-return] import, an i32-returning body,\n  // and `i32.load` of the results area), so a caller asking for any other\n  // lowering -- notably the project's ordinary `Int` = s64 -- would get a\n  // component whose task.return canon disagrees with the guest's own import\n  // type and fail validation. Reject that up front rather than emit an\n  // invalid component. Parameterizing the guest core types off\n  // comp_result_valtype is possible but unverified, so it waits for a real\n  // caller (the M1b-2c-shaped follow-up) to pin it against a probe.\n  if comp_result_valtype != comp_valtype_u32 {\n    throw(\"component(\\{shape}): only comp_valtype_u32 (\\{comp_valtype_u32}) is supported, got \\{comp_result_valtype} -- the guest core module is hard-coded to an i32-shaped result\")\n  }\n  else {\n    ()\n  }\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_comp_async_functype_section(buf, comp_result_valtype)\n  emit_comp_import_section(buf, [\n    \"get-async\"\n  ], 1)\n  emit_core_module_section(buf, guest_module)\n  emit_core_module_section(buf, comp_generate_memhost_module())\n  let memhost_inst = 0\n  emit_core_instance_instantiate_section(buf, 1, array_empty())\n  let mem_alias_idx = 0\n  emit_alias_section(buf, memhost_inst, [\n    \"memory\"\n  ], [\n    core_sort_mem\n  ])\n  emit_canon_lower_async_section(buf, 0, mem_alias_idx)\n  emit_canon_task_return(buf, comp_result_valtype)\n  emit_canon_waitable_set_new(buf)\n  emit_canon_waitable_join(buf)\n  emit_canon_waitable_set_wait(buf, mem_alias_idx)\n  emit_canon_waitable_set_drop(buf)\n  emit_canon_subtask_drop(buf)\n  let root_inst = 1\n  emit_core_instance_from_exports(buf, 1, [\n    6\n  ], [\n    \"[async-lower]get-async\",\n    \"[waitable-set-new]\",\n    \"[waitable-join]\",\n    \"[waitable-set-wait]\",\n    \"[waitable-set-drop]\",\n    \"[subtask-drop]\"\n  ], [\n    0,\n    2,\n    3,\n    4,\n    5,\n    6\n  ])\n  let export_root_inst = 2\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"[task-return]run\"\n  ], [\n    1\n  ])\n  emit_core_instance_from_exports_sorted(buf, [\n    \"memory\"\n  ], [\n    core_sort_mem\n  ], [\n    mem_alias_idx\n  ])\n  let env_inst = 3\n  let guest_inst = 4\n  emit_core_instance_instantiate_args(buf, 0, [\n    \"$root\",\n    \"[export]$root\",\n    \"env\"\n  ], [\n    root_inst,\n    export_root_inst,\n    env_inst\n  ])\n  emit_comp_async_functype_section(buf, comp_result_valtype)\n  let run_func_alias_idx = 7\n  emit_alias_section(buf, guest_inst, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_canon_lift_async_section(buf, run_func_alias_idx, 1)\n  emit_comp_export_section(buf, export_name, 1)\n  bytebuf_to_bytes(buf)\n}\n\nexport fn comp_emit_component_wasm_async_spawned_future(export_name: String, comp_result_valtype: Int) -> Bytes with { Error } {\n  comp_emit_self_contained_async_component(export_name, comp_result_valtype, comp_generate_spawned_future_guest_core_module(), \"spawned-future\")\n}\n\n/// #1230 M1b-3c-3: the same self-contained component shape, but with the\n/// guest that starts BOTH host calls before waiting on either -- so the two\n/// host operations are genuinely in flight at the same time.\n///\n/// The emitted component imports and exports exactly what the\n/// spawned-future one does; the entire difference is the order of\n/// operations inside the guest. Verified against\n/// tools/wasip3_component_probe/concurrent_awaits/component.wat and, at\n/// runtime, by scripts/test_concurrent_awaits_component_gate.sh: with a\n/// host that suspends 300ms per call, `run` returns 84 (= 42 + 42, so both\n/// calls really completed and each result slot was really written) in\n/// ~300ms rather than ~600ms.\n///\n/// `comp_result_valtype` must be comp_valtype_u32; anything else throws.\nexport fn comp_emit_component_wasm_async_concurrent_awaits(export_name: String, comp_result_valtype: Int) -> Bytes with { Error } {\n  comp_emit_self_contained_async_component(export_name, comp_result_valtype, comp_generate_concurrent_awaits_guest_core_module(), \"concurrent-awaits\")\n}\n\n/// #537: core:sort for globals (func=0, table=1, mem=2, global=3).\nlet core_sort_global = 3\n\n/// #537: from-exports core instance with per-item sorts (the older\n/// emit_core_instance_from_exports hardcodes core_sort_func; the packed-string\n/// env instance also carries the main memory and the __heap_ptr global).\nfn emit_core_instance_from_exports_sorted(buf: Bytes, names: Array[String], sorts: Array[Int], indices: Array[Int]) -> Unit {\n  bytebuf_push(buf, section_core_instance)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 1)\n  leb128_encode_u32(content, Array::length(names))\n  let mut i = 0\n  while i < Array::length(names) {\n    emit_name(content, Array::get(names, i))\n    bytebuf_push(content, Array::get(sorts, i))\n    leb128_encode_u32(content, Array::get(indices, i))\n    i = i + 1\n  }\n  emit_raw_content(buf, content)\n}\n\n/// #537: string trampoline for the CURRENT wasi linear backend ABI.\n/// A vibe string value is the packed i64 `(byte_offset << 32) | byte_len`\n/// (mode-invariant: identical under bump and RC; see gen_str_len_body /\n/// gen_str_char_code_at_body). The legacy comp_generate_string_trampoline\n/// predates this and builds retired-host heap-object strings, so it cannot\n/// call today's core modules.\n///\n/// Imports (module \"env\", all supplied from the main core instance):\n///   target_func : (i64 x N) -> i64      the exported vibe handler\n///   memory      : the main linear memory\n///   __heap_ptr  : mut i32 global        the main module's bump frontier\n/// Exports:\n///   cabi_realloc : (i32,i32,i32,i32) -> i32\n///     Canonical-ABI allocator used by the host to lower string params into\n///     the main memory (and by canon_func for the string-result ret area).\n///     Bumps __heap_ptr (align-adjusted) and memory.grows as needed. Fresh\n///     allocations only (old_ptr is ignored) — the canonical lowering of\n///     bare string params/results never reallocates.\n///   canon_func : (i32 x 2N) -> i32\n///     Canonical-ABI core shape of `(string x N) -> string`: N (ptr,len)\n///     pairs in, retptr out. Packs each pair into a vibe string value, calls\n///     target_func, unpacks the returned value into an 8-byte (ptr,len)\n///     return area allocated via cabi_realloc.\nexport fn comp_generate_string_trampoline_packed(string_param_count: Int) -> Bytes {\n  let buf = bytebuf_new()\n  emit_header(buf)\n  // types: 0 = target_func (i64 x N) -> i64; 1 = canon_func (i32 x 2N) -> i32;\n  // 2 = cabi_realloc (i32,i32,i32,i32) -> i32\n  let type_sec = bytebuf_new()\n  bytebuf_push_vec_header(type_sec, 3)\n  bytebuf_push(type_sec, 96)\n  // +1: top-level vibe functions carry a trailing closure-env i64 param\n  // (callers pass 0); see linked_compile's entry invocation.\n  leb128_encode_u32(type_sec, string_param_count + 1)\n  let mut ti = 0\n  while ti < (string_param_count + 1) {\n    bytebuf_push(type_sec, 126)\n    ti = ti + 1\n  }\n  bytebuf_push(type_sec, 1)\n  bytebuf_push(type_sec, 126)\n  bytebuf_push(type_sec, 96)\n  leb128_encode_u32(type_sec, string_param_count * 2)\n  let mut ci = 0\n  while ci < (string_param_count * 2) {\n    bytebuf_push(type_sec, 127)\n    ci = ci + 1\n  }\n  bytebuf_push(type_sec, 1)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 96)\n  leb128_encode_u32(type_sec, 4)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 1)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push_section(buf, 1, type_sec)\n  // imports: env.target_func (func 0), env.__heap_ptr (mut i32 global), env.memory\n  let import_sec = bytebuf_new()\n  leb128_encode_u32(import_sec, 3)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"target_func\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"__heap_ptr\")\n  bytebuf_push(import_sec, 3)\n  bytebuf_push(import_sec, 127)\n  bytebuf_push(import_sec, 1)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"memory\")\n  bytebuf_push(import_sec, 2)\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  bytebuf_push_section(buf, 2, import_sec)\n  // funcs: 1 = canon_func (type 1), 2 = cabi_realloc (type 2)\n  let func_sec = bytebuf_new()\n  leb128_encode_u32(func_sec, 2)\n  leb128_encode_u32(func_sec, 1)\n  leb128_encode_u32(func_sec, 2)\n  bytebuf_push_section(buf, 3, func_sec)\n  let export_sec = bytebuf_new()\n  leb128_encode_u32(export_sec, 2)\n  emit_name(export_sec, \"canon_func\")\n  bytebuf_push(export_sec, 0)\n  leb128_encode_u32(export_sec, 1)\n  emit_name(export_sec, \"cabi_realloc\")\n  bytebuf_push(export_sec, 0)\n  leb128_encode_u32(export_sec, 2)\n  bytebuf_push_section(buf, 7, export_sec)\n  let code_sec = bytebuf_new()\n  leb128_encode_u32(code_sec, 2)\n  // canon_func body. locals: params 0..2N-1 (i32); 2N = result i64; 2N+1 = retptr i32\n  let canon_body = bytebuf_new()\n  leb128_encode_u32(canon_body, 2)\n  leb128_encode_u32(canon_body, 1)\n  bytebuf_push(canon_body, 126)\n  leb128_encode_u32(canon_body, 1)\n  bytebuf_push(canon_body, 127)\n  let result_local = string_param_count * 2\n  let retptr_local = result_local + 1\n  let mut si = 0\n  while si < string_param_count {\n    // (extend_u(ptr) << 32) | extend_u(len)\n    emit_local_get(canon_body, si * 2)\n    bytebuf_push(canon_body, 173)\n    emit_i64_const(canon_body, 32)\n    bytebuf_push(canon_body, 134)\n    emit_local_get(canon_body, (si * 2) + 1)\n    bytebuf_push(canon_body, 173)\n    bytebuf_push(canon_body, 132)\n    si = si + 1\n  }\n  // Trailing closure-env argument (0 for a top-level function).\n  emit_i64_const(canon_body, 0)\n  bytebuf_push(canon_body, 16)\n  leb128_encode_u32(canon_body, 0)\n  emit_local_set(canon_body, result_local)\n  // retptr = cabi_realloc(0, 0, 4, 8)\n  emit_i32_const(canon_body, 0)\n  emit_i32_const(canon_body, 0)\n  emit_i32_const(canon_body, 4)\n  emit_i32_const(canon_body, 8)\n  bytebuf_push(canon_body, 16)\n  leb128_encode_u32(canon_body, 2)\n  emit_local_set(canon_body, retptr_local)\n  // [retptr] = wrap(result >> 32); [retptr+4] = wrap(result & 0xFFFFFFFF)\n  emit_local_get(canon_body, retptr_local)\n  emit_local_get(canon_body, result_local)\n  emit_i64_const(canon_body, 32)\n  bytebuf_push(canon_body, 136)\n  bytebuf_push(canon_body, 167)\n  emit_i32_store(canon_body, 2, 0)\n  emit_local_get(canon_body, retptr_local)\n  emit_local_get(canon_body, result_local)\n  bytebuf_push(canon_body, 167)\n  emit_i32_store(canon_body, 2, 4)\n  emit_local_get(canon_body, retptr_local)\n  bytebuf_push(canon_body, 11)\n  leb128_encode_u32(code_sec, Bytes::length(canon_body))\n  bytebuf_push_buf(code_sec, canon_body)\n  // cabi_realloc body. params: 0=old_ptr 1=old_size 2=align 3=new_size;\n  // local 4 = aligned ptr.\n  let realloc_body = bytebuf_new()\n  leb128_encode_u32(realloc_body, 1)\n  leb128_encode_u32(realloc_body, 1)\n  bytebuf_push(realloc_body, 127)\n  // p = (heap + align - 1) & (0 - align)\n  bytebuf_push(realloc_body, 35)\n  leb128_encode_u32(realloc_body, 0)\n  emit_local_get(realloc_body, 2)\n  emit_i32_add(realloc_body)\n  emit_i32_const(realloc_body, 1)\n  bytebuf_push(realloc_body, 107)\n  emit_i32_const(realloc_body, 0)\n  emit_local_get(realloc_body, 2)\n  bytebuf_push(realloc_body, 107)\n  bytebuf_push(realloc_body, 113)\n  emit_local_set(realloc_body, 4)\n  // __heap_ptr = p + new_size\n  emit_local_get(realloc_body, 4)\n  emit_local_get(realloc_body, 3)\n  emit_i32_add(realloc_body)\n  bytebuf_push(realloc_body, 36)\n  leb128_encode_u32(realloc_body, 0)\n  // if (__heap_ptr > memory.size << 16) memory.grow(pages needed)\n  bytebuf_push(realloc_body, 35)\n  leb128_encode_u32(realloc_body, 0)\n  bytebuf_push(realloc_body, 63)\n  bytebuf_push(realloc_body, 0)\n  emit_i32_const(realloc_body, 16)\n  bytebuf_push(realloc_body, 116)\n  bytebuf_push(realloc_body, 75)\n  bytebuf_push(realloc_body, 4)\n  bytebuf_push(realloc_body, 64)\n  bytebuf_push(realloc_body, 35)\n  leb128_encode_u32(realloc_body, 0)\n  emit_i32_const(realloc_body, 65535)\n  emit_i32_add(realloc_body)\n  emit_i32_const(realloc_body, 16)\n  bytebuf_push(realloc_body, 118)\n  bytebuf_push(realloc_body, 63)\n  bytebuf_push(realloc_body, 0)\n  bytebuf_push(realloc_body, 107)\n  bytebuf_push(realloc_body, 64)\n  bytebuf_push(realloc_body, 0)\n  bytebuf_push(realloc_body, 26)\n  bytebuf_push(realloc_body, 11)\n  emit_local_get(realloc_body, 4)\n  bytebuf_push(realloc_body, 11)\n  leb128_encode_u32(code_sec, Bytes::length(realloc_body))\n  bytebuf_push_buf(code_sec, realloc_body)\n  bytebuf_push_section(buf, 10, code_sec)\n  bytebuf_to_bytes(buf)\n}\n\n/// #537: wrap a compiled core module into a component exporting\n///   <export_name> : func(<param_names>: string, ...) -> string\n/// via the packed-string trampoline above. This is the replacement\n/// for the retired host's `--compose-p3` handler-side componentization: the\n/// result plugs into the P3 HTTP adapter's `import handler: func(method, url,\n/// headers, body) -> string` (scripts/build_wasi_http_p3_full_adapter.sh).\n///\n/// The core module must export `target_func_name` with signature\n/// (i64 x N) -> i64 (N = param count, all vibe String), plus `memory` and\n/// `__heap_ptr` (any normal non-library compile does). Host imports\n/// other than wasi_snapshot_preview1.fd_write (stubbed to a no-op) are\n/// rejected: a serve handler must be a pure function of its request params.\nexport fn comp_emit_component_wasm_string_handler(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with { Error } {\n  comp_emit_string_handler_impl(core_wasm, target_func_name, export_name, param_names, false)\n}\n\n/// #1107 Phase 5 (vibec, the implementation shape of #857): like\n/// comp_emit_component_wasm_string_handler, but SATISFIES the core's `vibe.*`\n/// host imports with local stubs instead of rejecting them — `env-get` returns\n/// the raw-ABI empty string (i64 0 = ptr 0 / len 0, i.e. \"unset\", the same\n/// value an unset variable yields on a real host) and every other `vibe.*`\n/// import traps (`unreachable`). Intended for cores whose lifted entry's\n/// effect row proves those imports dynamically unreachable: the vibec core's\n/// `compile_cli_request` carries no Env/Fs row (sources arrive inline, output\n/// leaves as hex chunks), so its `vibe.env-get`/`vibe.fs_*` imports exist only\n/// because SIBLING exports of the library build reference them. The serve\n/// path stays on the strict-reject variant above so an impure handler still\n/// fails at componentize time, not at runtime.\nexport fn comp_emit_component_wasm_string_handler_stubbed(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with { Error } {\n  comp_emit_string_handler_impl(core_wasm, target_func_name, export_name, param_names, true)\n}\n\n/// One stub core module exporting `fd_write` plus a same-signature stub for\n/// each requested `vibe.*` import (see comp_emit_component_wasm_string_handler_stubbed).\n/// With empty inputs it degenerates to the fd_write-only stub.\nfn comp_generate_host_stub_module(vibe_names: Array[String], vibe_sigs: Array[Array[Int]]) -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  let n = Array::length(vibe_names)\n  let tc = bytebuf_new()\n  bytebuf_push_vec_header(tc, n + 1)\n  emit_func_type_raw(tc, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  let mut ti = 0\n  while ti < n {\n    let sig = Array::get(vibe_sigs, ti)\n    let pc = Array::get(sig, 0)\n    let params = new_int_array()\n    let mut pi = 0\n    while pi < pc {\n      Array::push(params, Array::get(sig, 1 + pi))\n      pi = pi + 1\n    }\n    let rc = Array::get(sig, 1 + pc)\n    let results = new_int_array()\n    let mut ri = 0\n    while ri < rc {\n      Array::push(results, Array::get(sig, 2 + pc + ri))\n      ri = ri + 1\n    }\n    emit_func_type_raw(tc, params, results)\n    ti = ti + 1\n  }\n  bytebuf_push_section(out, 1, tc)\n  let ftypes = new_int_array()\n  Array::push(ftypes, 0)\n  let mut fsi = 0\n  while fsi < n {\n    Array::push(ftypes, fsi + 1)\n    fsi = fsi + 1\n  }\n  emit_function_section(out, ftypes)\n  let exp_names = array_empty()\n  let exp_idxs = new_int_array()\n  Array::push(exp_names, \"fd_write\")\n  Array::push(exp_idxs, 0)\n  let mut ei = 0\n  while ei < n {\n    Array::push(exp_names, Array::get(vibe_names, ei))\n    Array::push(exp_idxs, ei + 1)\n    ei = ei + 1\n  }\n  emit_export_section_multi(out, exp_names, exp_idxs)\n  let bodies = Array::slice([\n    (bytebuf_new())\n  ], 0, 0)\n  let fd_body = bytebuf_new()\n  emit_i32_const(fd_body, 0)\n  Array::push(bodies, fd_body)\n  let mut bi = 0\n  while bi < n {\n    let body = bytebuf_new()\n    let sn = Array::get(vibe_names, bi)\n    // Zero-stubs: env-get -> raw-ABI empty string (\"unset\"); the fs WRITE\n    // pair -> silently dropped (the only writer on the compile path is the\n    // persistent header/artifact cache, and dropping a cache write is\n    // semantically a cache miss); profile-now-us -> 0 (no clock). Everything\n    // else traps (`unreachable`) — those imports are dynamically dead per\n    // the lifted entry's effect row, and trapping (instead of fabricating a\n    // value) surfaces any violation of that proof immediately.\n    if sn == \"env-get\" || sn == \"fs_write_file\" || sn == \"fs_write_bytes\" || sn == \"profile-now-us\" {\n      // Match the import's declared result shape: nothing for void, a typed\n      // zero otherwise (i64 for the raw ABI, i32 defensively).\n      let sig = Array::get(vibe_sigs, bi)\n      let pc = Array::get(sig, 0)\n      let rc = Array::get(sig, 1 + pc)\n      if rc >= 1 {\n        if Array::get(sig, 2 + pc) == 127 {\n          emit_i32_const(body, 0)\n        } else {\n          emit_i64_const(body, 0)\n        }\n      } else {\n        ()\n      }\n    } else {\n      bytebuf_push(body, 0)\n    }\n    Array::push(bodies, body)\n    bi = bi + 1\n  }\n  emit_code_section(out, bodies)\n  bytebuf_to_bytes(out)\n}\n\nfn comp_emit_string_handler_impl(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String], stub_vibe: Bool) -> Bytes with { Error } {\n  let string_param_count = Array::length(param_names)\n  // Validate the target export exists with the packed-string core signature.\n  let export_names = array_empty()\n  let export_func_indices = new_int_array()\n  let export_type_sigs = array_empty()\n  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)\n  let mut target_sig_ok = false\n  let mut target_found = false\n  let mut ei = 0\n  while ei < Array::length(export_names) {\n    if Array::get(export_names, ei) == target_func_name {\n      target_found = true\n      let sig = Array::get(export_type_sigs, ei)\n      // sig = [param_count, params..., result_count, results...]. Core shape\n      // is (i64 x N+1) -> i64: leading closure-env param + one i64 per String.\n      let core_param_count = string_param_count + 1\n      if Array::length(sig) == (core_param_count + 3) {\n        let mut ok = Array::get(sig, 0) == core_param_count\n        let mut pi = 0\n        while pi < core_param_count {\n          if Array::get(sig, 1 + pi) != 126 {\n            ok = false\n          }\n          pi = pi + 1\n        }\n        if Array::get(sig, 1 + core_param_count) != 1 {\n          ok = false\n        }\n        if Array::get(sig, 2 + core_param_count) != 126 {\n          ok = false\n        }\n        target_sig_ok = ok\n      }\n      ei = Array::length(export_names)\n    } else {\n      ei = ei + 1\n    }\n  }\n  if !target_found {\n    throw(\"component: core module does not export '\\{target_func_name}'\")\n  }\n  if !target_sig_ok {\n    throw(\"component: '\\{target_func_name}' must take \\{string_param_count} String params and return String\")\n  }\n  // Reject host imports the stub cannot satisfy (stub_vibe additionally\n  // hosts `vibe.*` imports with local stubs — see the _stubbed wrapper).\n  let imp_modules = array_empty()\n  let imp_names = array_empty()\n  let imp_type_indices = new_int_array()\n  let imp_type_sigs = array_empty()\n  let import_count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)\n  let vibe_stub_names = array_empty()\n  let vibe_stub_sigs = array_empty()\n  let mut ii = 0\n  while ii < import_count {\n    let im = Array::get(imp_modules, ii)\n    let ifn = Array::get(imp_names, ii)\n    if im == \"wasi_snapshot_preview1\" && ifn == \"fd_write\" {\n      ()\n    } else if stub_vibe && im == \"vibe\" {\n      Array::push(vibe_stub_names, ifn)\n      Array::push(vibe_stub_sigs, Array::get(imp_type_sigs, Array::get(imp_type_indices, ii)))\n    } else {\n      throw(\"component: handler uses host import '\\{im}.\\{ifn}' (a serve handler must be pure; only stdout via fd_write is stubbed)\")\n    }\n    ii = ii + 1\n  }\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, core_wasm)\n  emit_core_module_section(buf, comp_generate_string_trampoline_packed(string_param_count))\n  emit_core_module_section(buf, comp_generate_host_stub_module(vibe_stub_names, vibe_stub_sigs))\n  // core instance 0: host stub (module 2): fd_write (+ vibe.* stubs when\n  // stub_vibe collected any)\n  emit_core_instance_instantiate_section(buf, 2, array_empty())\n  // core instance 1: main (module 0), wasi_snapshot_preview1 / vibe satisfied\n  // by the stub instance when the core imports them (an argument for an\n  // import the module does not declare is legal and ignored).\n  emit_core_instance_instantiate_args(buf, 0, [\n    \"wasi_snapshot_preview1\",\n    \"vibe\"\n  ], [\n    0,\n    0\n  ])\n  // core func 0 = target, core mem 0 = main memory, core global 0 = __heap_ptr\n  emit_alias_section(buf, 1, [\n    target_func_name\n  ], [\n    core_sort_func\n  ])\n  emit_alias_section(buf, 1, [\n    \"memory\"\n  ], [\n    core_sort_mem\n  ])\n  emit_alias_section(buf, 1, [\n    \"__heap_ptr\"\n  ], [\n    core_sort_global\n  ])\n  // core instance 2: env = {target_func, __heap_ptr, memory} from the aliases\n  emit_core_instance_from_exports_sorted(buf, [\n    \"target_func\",\n    \"__heap_ptr\",\n    \"memory\"\n  ], [\n    core_sort_func,\n    core_sort_global,\n    core_sort_mem\n  ], [\n    0,\n    0,\n    0\n  ])\n  // core instance 3: trampoline (module 1) with env\n  emit_core_instance_instantiate_args(buf, 1, [\n    \"env\"\n  ], [\n    2\n  ])\n  // core func 1 = canon_func, core func 2 = cabi_realloc\n  emit_alias_section(buf, 3, [\n    \"canon_func\",\n    \"cabi_realloc\"\n  ], [\n    core_sort_func,\n    core_sort_func\n  ])\n  // component type 0: (param_names: string...) -> string\n  bytebuf_push(buf, section_type)\n  let type_content = bytebuf_new()\n  leb128_encode_u32(type_content, 1)\n  let comp_param_types = new_int_array()\n  let mut pt = 0\n  while pt < string_param_count {\n    Array::push(comp_param_types, comp_valtype_string)\n    pt = pt + 1\n  }\n  emit_comp_func_type(type_content, comp_param_types, param_names, [\n    comp_valtype_string\n  ], 0)\n  emit_raw_content(buf, type_content)\n  // canon lift canon_func (core func 1) with memory 0 + realloc (core func 2)\n  bytebuf_push(buf, section_canon)\n  let canon_content = bytebuf_new()\n  leb128_encode_u32(canon_content, 1)\n  emit_canon_lift_func(canon_content, 1, 0, 1, 0, 2)\n  emit_raw_content(buf, canon_content)\n  emit_comp_export_section(buf, export_name, 0)\n  bytebuf_to_bytes(buf)\n}\n\n// ============================================================================\n// #1109-2 (vibec-hosted, the vfs face of #857): component whose FILESYSTEM\n// comes from a WIT-imported vfs interface. The core's `vibe.fs_*` host\n// imports are routed to canon-LOWERED component imports:\n//\n//   import read-file:  func(path: string) -> string\n//   import exists:     func(path: string) -> bool\n//   import read-dir:   func(path: string) -> string   (newline-joined names)\n//   import stat-token: func(path: string) -> s64      (-1 = non-regular)\n//\n// Instantiation is circular on paper (main imports vfs; lowering vfs needs\n// main's memory), so we break it with wit-component's shim/fixup dance:\n//   shim (table + raw-sig forwarders) -> main(vibe=shim+stubs) -> alias\n//   memory/__heap_ptr -> realloc module -> canon lower (memory+realloc) ->\n//   adapter module (raw i64 <-> canonical ptr/len trampolines) whose ACTIVE\n//   ELEMENT segment plants its impls into the shim's table.\n// The compile-face export is lifted exactly like the string handler.\n// ============================================================================\n\n/// Raw-sig forwarder module: table 4 funcref (exported \"t\") + one (i64)->i64\n/// forwarder per vfs function, each `call_indirect` through its fixed slot\n/// (0 read_file, 1 exists, 2 read_dir, 3 stat_token). Slots are planted later\n/// by the adapter module's active element segment.\nfn comp_generate_vfs_shim() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  let tc = bytebuf_new()\n  bytebuf_push_vec_header(tc, 1)\n  emit_func_type_raw(tc, [\n    126\n  ], [\n    126\n  ])\n  bytebuf_push_section(out, 1, tc)\n  emit_function_section(out, [\n    0,\n    0,\n    0,\n    0\n  ])\n  let table_sec = bytebuf_new()\n  leb128_encode_u32(table_sec, 1)\n  bytebuf_push(table_sec, 112)\n  bytebuf_push(table_sec, 0)\n  leb128_encode_u32(table_sec, 4)\n  bytebuf_push_section(out, 4, table_sec)\n  let export_sec = bytebuf_new()\n  leb128_encode_u32(export_sec, 5)\n  emit_name(export_sec, \"fs_read_file\")\n  bytebuf_push(export_sec, 0)\n  leb128_encode_u32(export_sec, 0)\n  emit_name(export_sec, \"fs_exists\")\n  bytebuf_push(export_sec, 0)\n  leb128_encode_u32(export_sec, 1)\n  emit_name(export_sec, \"fs_read_dir\")\n  bytebuf_push(export_sec, 0)\n  leb128_encode_u32(export_sec, 2)\n  emit_name(export_sec, \"fs_stat_token\")\n  bytebuf_push(export_sec, 0)\n  leb128_encode_u32(export_sec, 3)\n  emit_name(export_sec, \"t\")\n  bytebuf_push(export_sec, 1)\n  leb128_encode_u32(export_sec, 0)\n  bytebuf_push_section(out, 7, export_sec)\n  let code_sec = bytebuf_new()\n  leb128_encode_u32(code_sec, 4)\n  let mut slot = 0\n  while slot < 4 {\n    let body = bytebuf_new()\n    leb128_encode_u32(body, 0)\n    emit_local_get(body, 0)\n    emit_i32_const(body, slot)\n    bytebuf_push(body, 17)\n    leb128_encode_u32(body, 0)\n    leb128_encode_u32(body, 0)\n    bytebuf_push(body, 11)\n    leb128_encode_u32(code_sec, Bytes::length(body))\n    bytebuf_push_buf(code_sec, body)\n    slot = slot + 1\n  }\n  bytebuf_push_section(out, 10, code_sec)\n  bytebuf_to_bytes(out)\n}\n\n/// Standalone bump cabi_realloc over the MAIN module's memory + __heap_ptr\n/// (imported as env.*) — the same body comp_generate_string_trampoline_packed\n/// embeds, needed here BEFORE the trampoline exists because the canon-lowered\n/// vfs imports allocate their result strings through it.\nfn comp_generate_vfs_realloc() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  let tc = bytebuf_new()\n  bytebuf_push_vec_header(tc, 1)\n  emit_func_type_raw(tc, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  bytebuf_push_section(out, 1, tc)\n  let import_sec = bytebuf_new()\n  leb128_encode_u32(import_sec, 2)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"__heap_ptr\")\n  bytebuf_push(import_sec, 3)\n  bytebuf_push(import_sec, 127)\n  bytebuf_push(import_sec, 1)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"memory\")\n  bytebuf_push(import_sec, 2)\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  bytebuf_push_section(out, 2, import_sec)\n  emit_function_section(out, [\n    0\n  ])\n  emit_export_section(out, \"cabi_realloc\", 0)\n  let code_sec = bytebuf_new()\n  leb128_encode_u32(code_sec, 1)\n  let realloc_body = bytebuf_new()\n  leb128_encode_u32(realloc_body, 1)\n  leb128_encode_u32(realloc_body, 1)\n  bytebuf_push(realloc_body, 127)\n  // Unlike the trampoline's realloc (which only ever serves its own 8-byte\n  // retptr), THIS one is the canonical-lowering allocator for vfs result\n  // strings, which request align=1/exact length — and the raw ABI requires\n  // __heap_ptr to STAY 8-aligned (heap pointers carry low-bit tags; an\n  // unaligned bump poisons every later allocation into \"tagged\" garbage).\n  // So: p = (heap + 7) & ~7; heap = p + ((new_size + 7) & ~7).\n  bytebuf_push(realloc_body, 35)\n  leb128_encode_u32(realloc_body, 0)\n  emit_i32_const(realloc_body, 7)\n  emit_i32_add(realloc_body)\n  emit_i32_const(realloc_body, -8)\n  bytebuf_push(realloc_body, 113)\n  emit_local_set(realloc_body, 4)\n  emit_local_get(realloc_body, 4)\n  emit_local_get(realloc_body, 3)\n  emit_i32_const(realloc_body, 7)\n  emit_i32_add(realloc_body)\n  emit_i32_const(realloc_body, -8)\n  bytebuf_push(realloc_body, 113)\n  emit_i32_add(realloc_body)\n  bytebuf_push(realloc_body, 36)\n  leb128_encode_u32(realloc_body, 0)\n  bytebuf_push(realloc_body, 35)\n  leb128_encode_u32(realloc_body, 0)\n  bytebuf_push(realloc_body, 63)\n  bytebuf_push(realloc_body, 0)\n  emit_i32_const(realloc_body, 16)\n  bytebuf_push(realloc_body, 116)\n  bytebuf_push(realloc_body, 75)\n  bytebuf_push(realloc_body, 4)\n  bytebuf_push(realloc_body, 64)\n  bytebuf_push(realloc_body, 35)\n  leb128_encode_u32(realloc_body, 0)\n  emit_i32_const(realloc_body, 65535)\n  emit_i32_add(realloc_body)\n  emit_i32_const(realloc_body, 16)\n  bytebuf_push(realloc_body, 118)\n  bytebuf_push(realloc_body, 63)\n  bytebuf_push(realloc_body, 0)\n  bytebuf_push(realloc_body, 107)\n  bytebuf_push(realloc_body, 64)\n  bytebuf_push(realloc_body, 0)\n  bytebuf_push(realloc_body, 26)\n  bytebuf_push(realloc_body, 11)\n  emit_local_get(realloc_body, 4)\n  bytebuf_push(realloc_body, 11)\n  leb128_encode_u32(code_sec, Bytes::length(realloc_body))\n  bytebuf_push_buf(code_sec, realloc_body)\n  bytebuf_push_section(out, 10, code_sec)\n  bytebuf_to_bytes(out)\n}\n\n/// Adapter/fixup module: converts the raw ABI ((ptr<<32)|len i64 strings) to\n/// the canonical lowered signatures and plants its impls into the shim's\n/// table via an active element segment at instantiation time.\nfn comp_generate_vfs_adapter() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  // types: 0 = (i32,i32,i32)->() lowered string->string\n  //        1 = (i32,i32)->i32   lowered string->bool\n  //        2 = (i32,i32)->i64   lowered string->s64\n  //        3 = (i64)->i64       raw impls\n  //        4 = (i32 x4)->i32    cabi_realloc\n  let tc = bytebuf_new()\n  bytebuf_push_vec_header(tc, 5)\n  emit_func_type_raw(tc, [\n    127,\n    127,\n    127\n  ], array_empty())\n  emit_func_type_raw(tc, [\n    127,\n    127\n  ], [\n    127\n  ])\n  emit_func_type_raw(tc, [\n    127,\n    127\n  ], [\n    126\n  ])\n  emit_func_type_raw(tc, [\n    126\n  ], [\n    126\n  ])\n  emit_func_type_raw(tc, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  bytebuf_push_section(out, 1, tc)\n  // imports: vfs.read-file f0 t0, vfs.exists f1 t1, vfs.read-dir f2 t0,\n  // vfs.stat-token f3 t2, env.cabi_realloc f4 t4, env.memory, env.t (table)\n  let import_sec = bytebuf_new()\n  leb128_encode_u32(import_sec, 7)\n  emit_name(import_sec, \"vfs\")\n  emit_name(import_sec, \"read-file\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  emit_name(import_sec, \"vfs\")\n  emit_name(import_sec, \"exists\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 1)\n  emit_name(import_sec, \"vfs\")\n  emit_name(import_sec, \"read-dir\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  emit_name(import_sec, \"vfs\")\n  emit_name(import_sec, \"stat-token\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 2)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"cabi_realloc\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 4)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"memory\")\n  bytebuf_push(import_sec, 2)\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"t\")\n  bytebuf_push(import_sec, 1)\n  bytebuf_push(import_sec, 112)\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 4)\n  bytebuf_push_section(out, 2, import_sec)\n  // funcs: f5 impl_read_file, f6 impl_exists, f7 impl_read_dir, f8 impl_stat\n  emit_function_section(out, [\n    3,\n    3,\n    3,\n    3\n  ])\n  // active elem: table 0 offset 0 -> [f5, f6, f7, f8]\n  let elem_sec = bytebuf_new()\n  leb128_encode_u32(elem_sec, 1)\n  bytebuf_push(elem_sec, 0)\n  emit_i32_const(elem_sec, 0)\n  bytebuf_push(elem_sec, 11)\n  leb128_encode_u32(elem_sec, 4)\n  leb128_encode_u32(elem_sec, 5)\n  leb128_encode_u32(elem_sec, 6)\n  leb128_encode_u32(elem_sec, 7)\n  leb128_encode_u32(elem_sec, 8)\n  bytebuf_push_section(out, 9, elem_sec)\n  let code_sec = bytebuf_new()\n  leb128_encode_u32(code_sec, 4)\n  // impl_read_file / impl_read_dir (string result via retptr)\n  let mut sri = 0\n  while sri < 2 {\n    let body = bytebuf_new()\n    leb128_encode_u32(body, 1)\n    leb128_encode_u32(body, 1)\n    bytebuf_push(body, 127)\n    // retptr = cabi_realloc(0,0,4,8)\n    emit_i32_const(body, 0)\n    emit_i32_const(body, 0)\n    emit_i32_const(body, 4)\n    emit_i32_const(body, 8)\n    bytebuf_push(body, 16)\n    leb128_encode_u32(body, 4)\n    emit_local_set(body, 1)\n    // ptr = wrap(arg >> 32); len = wrap(arg)\n    emit_local_get(body, 0)\n    emit_i64_const(body, 32)\n    bytebuf_push(body, 136)\n    bytebuf_push(body, 167)\n    emit_local_get(body, 0)\n    bytebuf_push(body, 167)\n    emit_local_get(body, 1)\n    bytebuf_push(body, 16)\n    leb128_encode_u32(body, if sri == 0 {\n      0\n    } else {\n      2\n    })\n    // (extend_u([retptr]) << 32) | extend_u([retptr+4])\n    emit_local_get(body, 1)\n    bytebuf_push(body, 40)\n    leb128_encode_u32(body, 2)\n    leb128_encode_u32(body, 0)\n    bytebuf_push(body, 173)\n    emit_i64_const(body, 32)\n    bytebuf_push(body, 134)\n    emit_local_get(body, 1)\n    bytebuf_push(body, 40)\n    leb128_encode_u32(body, 2)\n    leb128_encode_u32(body, 4)\n    bytebuf_push(body, 173)\n    bytebuf_push(body, 132)\n    bytebuf_push(body, 11)\n    // impl order in the code section is f5(read_file), f6(exists),\n    // f7(read_dir), f8(stat) — emit exists between the two string impls.\n    if sri == 0 {\n      leb128_encode_u32(code_sec, Bytes::length(body))\n      bytebuf_push_buf(code_sec, body)\n      let exists_body = bytebuf_new()\n      leb128_encode_u32(exists_body, 0)\n      emit_local_get(exists_body, 0)\n      emit_i64_const(exists_body, 32)\n      bytebuf_push(exists_body, 136)\n      bytebuf_push(exists_body, 167)\n      emit_local_get(exists_body, 0)\n      bytebuf_push(exists_body, 167)\n      bytebuf_push(exists_body, 16)\n      leb128_encode_u32(exists_body, 1)\n      bytebuf_push(exists_body, 173)\n      bytebuf_push(exists_body, 11)\n      leb128_encode_u32(code_sec, Bytes::length(exists_body))\n      bytebuf_push_buf(code_sec, exists_body)\n    } else {\n      leb128_encode_u32(code_sec, Bytes::length(body))\n      bytebuf_push_buf(code_sec, body)\n      let stat_body = bytebuf_new()\n      leb128_encode_u32(stat_body, 0)\n      emit_local_get(stat_body, 0)\n      emit_i64_const(stat_body, 32)\n      bytebuf_push(stat_body, 136)\n      bytebuf_push(stat_body, 167)\n      emit_local_get(stat_body, 0)\n      bytebuf_push(stat_body, 167)\n      bytebuf_push(stat_body, 16)\n      leb128_encode_u32(stat_body, 3)\n      bytebuf_push(stat_body, 11)\n      leb128_encode_u32(code_sec, Bytes::length(stat_body))\n      bytebuf_push_buf(code_sec, stat_body)\n    }\n    sri = sri + 1\n  }\n  bytebuf_push_section(out, 10, code_sec)\n  bytebuf_to_bytes(out)\n}\n\nexport fn comp_emit_component_wasm_string_handler_vfs(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with { Error } {\n  let string_param_count = Array::length(param_names)\n  // Validate the target export exists with the packed-string core signature\n  // (same contract as comp_emit_string_handler_impl).\n  let export_names = array_empty()\n  let export_func_indices = new_int_array()\n  let export_type_sigs = array_empty()\n  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)\n  let mut target_sig_ok = false\n  let mut target_found = false\n  let mut ei = 0\n  while ei < Array::length(export_names) {\n    if Array::get(export_names, ei) == target_func_name {\n      target_found = true\n      let sig = Array::get(export_type_sigs, ei)\n      let core_param_count = string_param_count + 1\n      if Array::length(sig) == (core_param_count + 3) {\n        let mut ok = Array::get(sig, 0) == core_param_count\n        let mut pi = 0\n        while pi < core_param_count {\n          if Array::get(sig, 1 + pi) != 126 {\n            ok = false\n          }\n          pi = pi + 1\n        }\n        if Array::get(sig, 1 + core_param_count) != 1 {\n          ok = false\n        }\n        if Array::get(sig, 2 + core_param_count) != 126 {\n          ok = false\n        }\n        target_sig_ok = ok\n      }\n      ei = Array::length(export_names)\n    } else {\n      ei = ei + 1\n    }\n  }\n  if !target_found {\n    throw(\"component(vfs): core module does not export '\\{target_func_name}'\")\n  }\n  if !target_sig_ok {\n    throw(\"component(vfs): '\\{target_func_name}' must take \\{string_param_count} String params and return String\")\n  }\n  // Classify the core's imports: the four fs_* vfs functions route to the\n  // shim, every other vibe.* import gets a local stub, fd_write is the\n  // usual wasi stub, anything else is rejected.\n  let imp_modules = array_empty()\n  let imp_names = array_empty()\n  let imp_type_indices = new_int_array()\n  let imp_type_sigs = array_empty()\n  let import_count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)\n  let vibe_import_names = array_empty()\n  let stub_names = array_empty()\n  let stub_sigs = array_empty()\n  let mut ii = 0\n  while ii < import_count {\n    let im = Array::get(imp_modules, ii)\n    let ifn = Array::get(imp_names, ii)\n    if im == \"wasi_snapshot_preview1\" && ifn == \"fd_write\" {\n      ()\n    } else if im == \"vibe\" {\n      Array::push(vibe_import_names, ifn)\n      if ifn == \"fs_read_file\" || ifn == \"fs_exists\" || ifn == \"fs_read_dir\" || ifn == \"fs_stat_token\" {\n        ()\n      } else {\n        Array::push(stub_names, ifn)\n        Array::push(stub_sigs, Array::get(imp_type_sigs, Array::get(imp_type_indices, ii)))\n      }\n    } else {\n      throw(\"component(vfs): unsupported host import '\\{im}.\\{ifn}'\")\n    }\n    ii = ii + 1\n  }\n  let stub_count = Array::length(stub_names)\n  // Core func index plan (aliases + lowers appear in emission order):\n  //   0..3            shim forwarders (fs_read_file/exists/read_dir/stat_token)\n  //   4..3+S          stub funcs\n  //   4+S             target func (from main)\n  //   5+S             vfs cabi_realloc (realloc module)\n  //   6+S..9+S        canon-lowered vfs imports\n  //   10+S, 11+S      trampoline canon_func + trampoline cabi_realloc\n  let f_target = 4 + stub_count\n  let f_realloc = 5 + stub_count\n  let f_lower0 = 6 + stub_count\n  let f_canon = 10 + stub_count\n  let f_tramp_realloc = 11 + stub_count\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  // S1: component types 0-3 for the vfs imports.\n  bytebuf_push(buf, section_type)\n  let vfs_types = bytebuf_new()\n  leb128_encode_u32(vfs_types, 4)\n  let path_param = array_empty()\n  Array::push(path_param, \"path\")\n  emit_comp_func_type(vfs_types, [\n    comp_valtype_string\n  ], path_param, [\n    comp_valtype_string\n  ], 0)\n  emit_comp_func_type(vfs_types, [\n    comp_valtype_string\n  ], path_param, [\n    comp_valtype_bool\n  ], 0)\n  emit_comp_func_type(vfs_types, [\n    comp_valtype_string\n  ], path_param, [\n    comp_valtype_string\n  ], 0)\n  emit_comp_func_type(vfs_types, [\n    comp_valtype_string\n  ], path_param, [\n    comp_valtype_s64\n  ], 0)\n  emit_raw_content(buf, vfs_types)\n  // S2: component imports read-file/exists/read-dir/stat-token -> funcs 0-3.\n  let vfs_import_names = array_empty()\n  Array::push(vfs_import_names, \"read-file\")\n  Array::push(vfs_import_names, \"exists\")\n  Array::push(vfs_import_names, \"read-dir\")\n  Array::push(vfs_import_names, \"stat-token\")\n  emit_comp_import_section(buf, vfs_import_names, 4)\n  // S3-S8: core modules 0..5.\n  emit_core_module_section(buf, core_wasm)\n  emit_core_module_section(buf, comp_generate_string_trampoline_packed(string_param_count))\n  emit_core_module_section(buf, comp_generate_host_stub_module(stub_names, stub_sigs))\n  emit_core_module_section(buf, comp_generate_vfs_shim())\n  emit_core_module_section(buf, comp_generate_vfs_realloc())\n  emit_core_module_section(buf, comp_generate_vfs_adapter())\n  // S9: instance 0 = stub, S10: instance 1 = shim.\n  emit_core_instance_instantiate_section(buf, 2, array_empty())\n  emit_core_instance_instantiate_section(buf, 3, array_empty())\n  // S11: alias the shim forwarders (core funcs 0-3).\n  let shim_fn_names = array_empty()\n  Array::push(shim_fn_names, \"fs_read_file\")\n  Array::push(shim_fn_names, \"fs_exists\")\n  Array::push(shim_fn_names, \"fs_read_dir\")\n  Array::push(shim_fn_names, \"fs_stat_token\")\n  emit_alias_section(buf, 1, shim_fn_names, [\n    core_sort_func,\n    core_sort_func,\n    core_sort_func,\n    core_sort_func\n  ])\n  // S12: alias the stub funcs (core funcs 4..3+S).\n  let stub_sorts = new_int_array()\n  let mut ssi = 0\n  while ssi < stub_count {\n    Array::push(stub_sorts, core_sort_func)\n    ssi = ssi + 1\n  }\n  emit_alias_section(buf, 0, stub_names, stub_sorts)\n  // S13: synthetic \"vibe\" instance covering every vibe.* import of the core.\n  let vibe_inst_names = array_empty()\n  let vibe_inst_sorts = new_int_array()\n  let vibe_inst_indices = new_int_array()\n  let mut vi = 0\n  while vi < Array::length(vibe_import_names) {\n    let vn = Array::get(vibe_import_names, vi)\n    Array::push(vibe_inst_names, vn)\n    Array::push(vibe_inst_sorts, core_sort_func)\n    if vn == \"fs_read_file\" {\n      Array::push(vibe_inst_indices, 0)\n    } else if vn == \"fs_exists\" {\n      Array::push(vibe_inst_indices, 1)\n    } else if vn == \"fs_read_dir\" {\n      Array::push(vibe_inst_indices, 2)\n    } else if vn == \"fs_stat_token\" {\n      Array::push(vibe_inst_indices, 3)\n    } else {\n      let mut sj = 0\n      let mut found_at = -1\n      while sj < stub_count {\n        if Array::get(stub_names, sj) == vn && found_at == -1 {\n          found_at = sj\n        }\n        sj = sj + 1\n      }\n      Array::push(vibe_inst_indices, 4 + found_at)\n    }\n    vi = vi + 1\n  }\n  emit_core_instance_from_exports_sorted(buf, vibe_inst_names, vibe_inst_sorts, vibe_inst_indices)\n  // S14: instance 3 = main, wasi from the stub instance, vibe from instance 2.\n  emit_core_instance_instantiate_args(buf, 0, [\n    \"wasi_snapshot_preview1\",\n    \"vibe\"\n  ], [\n    0,\n    2\n  ])\n  // S15: alias target func + memory + __heap_ptr from main (instance 3).\n  let main_alias_names = array_empty()\n  Array::push(main_alias_names, target_func_name)\n  Array::push(main_alias_names, \"memory\")\n  Array::push(main_alias_names, \"__heap_ptr\")\n  emit_alias_section(buf, 3, main_alias_names, [\n    core_sort_func,\n    core_sort_mem,\n    core_sort_global\n  ])\n  // S16/S17: realloc env (instance 4) + realloc module (instance 5).\n  let renv_names = array_empty()\n  Array::push(renv_names, \"__heap_ptr\")\n  Array::push(renv_names, \"memory\")\n  emit_core_instance_from_exports_sorted(buf, renv_names, [\n    core_sort_global,\n    core_sort_mem\n  ], [\n    0,\n    0\n  ])\n  emit_core_instance_instantiate_args(buf, 4, [\n    \"env\"\n  ], [\n    4\n  ])\n  // S18: alias cabi_realloc (core func 5+S) from instance 5.\n  let realloc_names = array_empty()\n  Array::push(realloc_names, \"cabi_realloc\")\n  emit_alias_section(buf, 5, realloc_names, [\n    core_sort_func\n  ])\n  // S19: canon lower the four vfs imports (core funcs 6+S..9+S). String\n  // results (read-file/read-dir) need memory + realloc; the scalar-result\n  // ones need memory only (their string PARAM is read out of core memory).\n  bytebuf_push(buf, section_canon)\n  let lower_content = bytebuf_new()\n  leb128_encode_u32(lower_content, 4)\n  let mut li = 0\n  while li < 4 {\n    bytebuf_push(lower_content, 1)\n    bytebuf_push(lower_content, 0)\n    leb128_encode_u32(lower_content, li)\n    if li == 0 || li == 2 {\n      leb128_encode_u32(lower_content, 3)\n      bytebuf_push(lower_content, 0)\n      bytebuf_push(lower_content, 3)\n      leb128_encode_u32(lower_content, 0)\n      bytebuf_push(lower_content, 4)\n      leb128_encode_u32(lower_content, f_realloc)\n    } else {\n      leb128_encode_u32(lower_content, 2)\n      bytebuf_push(lower_content, 0)\n      bytebuf_push(lower_content, 3)\n      leb128_encode_u32(lower_content, 0)\n    }\n    li = li + 1\n  }\n  emit_raw_content(buf, lower_content)\n  // S20: alias the shim's table (table 0).\n  let table_names = array_empty()\n  Array::push(table_names, \"t\")\n  emit_alias_section(buf, 1, table_names, [\n    1\n  ])\n  // S21: synthetic \"vfs\" instance of the lowered funcs (instance 6).\n  let vfs_inst_names = array_empty()\n  Array::push(vfs_inst_names, \"read-file\")\n  Array::push(vfs_inst_names, \"exists\")\n  Array::push(vfs_inst_names, \"read-dir\")\n  Array::push(vfs_inst_names, \"stat-token\")\n  emit_core_instance_from_exports_sorted(buf, vfs_inst_names, [\n    core_sort_func,\n    core_sort_func,\n    core_sort_func,\n    core_sort_func\n  ], [\n    f_lower0,\n    f_lower0 + 1,\n    f_lower0 + 2,\n    f_lower0 + 3\n  ])\n  // S22: synthetic adapter env {cabi_realloc, memory, t} (instance 7).\n  let aenv_names = array_empty()\n  Array::push(aenv_names, \"cabi_realloc\")\n  Array::push(aenv_names, \"memory\")\n  Array::push(aenv_names, \"t\")\n  emit_core_instance_from_exports_sorted(buf, aenv_names, [\n    core_sort_func,\n    core_sort_mem,\n    1\n  ], [\n    f_realloc,\n    0,\n    0\n  ])\n  // S23: instance 8 = adapter (fixup: its active elem plants the impls).\n  emit_core_instance_instantiate_args(buf, 5, [\n    \"vfs\",\n    \"env\"\n  ], [\n    6,\n    7\n  ])\n  // S24: synthetic trampoline env (instance 9).\n  let tenv_names = array_empty()\n  Array::push(tenv_names, \"target_func\")\n  Array::push(tenv_names, \"__heap_ptr\")\n  Array::push(tenv_names, \"memory\")\n  emit_core_instance_from_exports_sorted(buf, tenv_names, [\n    core_sort_func,\n    core_sort_global,\n    core_sort_mem\n  ], [\n    f_target,\n    0,\n    0\n  ])\n  // S25: instance 10 = trampoline; S26: alias canon_func + its realloc.\n  emit_core_instance_instantiate_args(buf, 1, [\n    \"env\"\n  ], [\n    9\n  ])\n  let tramp_names = array_empty()\n  Array::push(tramp_names, \"canon_func\")\n  Array::push(tramp_names, \"cabi_realloc\")\n  emit_alias_section(buf, 10, tramp_names, [\n    core_sort_func,\n    core_sort_func\n  ])\n  // S27: component type 4 = the export's (string...) -> string.\n  bytebuf_push(buf, section_type)\n  let export_type = bytebuf_new()\n  leb128_encode_u32(export_type, 1)\n  let comp_param_types = new_int_array()\n  let mut pt = 0\n  while pt < string_param_count {\n    Array::push(comp_param_types, comp_valtype_string)\n    pt = pt + 1\n  }\n  emit_comp_func_type(export_type, comp_param_types, param_names, [\n    comp_valtype_string\n  ], 0)\n  emit_raw_content(buf, export_type)\n  // S28: canon lift (memory 0 + trampoline realloc); S29: export (comp func 4).\n  bytebuf_push(buf, section_canon)\n  let lift_content = bytebuf_new()\n  leb128_encode_u32(lift_content, 1)\n  emit_canon_lift_func(lift_content, f_canon, 4, 1, 0, f_tramp_realloc)\n  emit_raw_content(buf, lift_content)\n  emit_comp_export_section(buf, export_name, 4)\n  bytebuf_to_bytes(buf)\n}\n")
}

let cli_adapter_source_108 = () -> (String, String) {
  ("lib/@vibe/compiler/wit_gen.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Stmt, TypeExpr\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# WIT text generation (#537)\n//\n// Maps a vibe program's EFFECT SURFACE to a WIT world:\n//\n//   - Each *exported* top-level function with a full type annotation becomes a\n//     world `export <kebab-name>: func(...)`.\n//   - The union of the effects named in those exported signatures' `with { E }`\n//     rows becomes the world's imports. An effect declared in the program via\n//     `effect E { Op(Args) -> Ret; ... }` is emitted as an inline interface\n//     import: `import <kebab-E>: interface { <kebab-op>: func(...) -> ...; }`.\n//   - `Error` never surfaces (it is vibe-internal control flow: an escaping\n//     throw is a component trap, not a capability).\n//   - Effect names WITHOUT a matching `effect` declaration (host capabilities\n//     such as Fs / Env / Async) get a comment marker: they are provided by the\n//     vibe runtime's host imports and have no WIT mapping yet.\n//\n// Type mapping (vibe -> WIT): Int -> s64, Double -> f64, Bool -> bool,\n// String -> string, Char -> char, Unit -> (no result), Bytes -> list<u8>,\n// Array[T] -> list<T>, Option[T] -> option<T>, Result[T, E] -> result<T, E>,\n// Map[K, V] -> list<tuple<K, V>>, tuples -> tuple<...>. Anything else\n// (named user types, function types) is rejected with a clear error — the\n// golden output never silently mis-declares a boundary type.\n//\n// The full contract lives in docs/effect-wit-mapping.md; the generated text is\n// pinned by fixtures/wit_gen_http.golden.wit (gate step) and round-trips\n// through vibe/wasm/wit_parser (wit_gen_test.vibe).\n\n/// Lowercase a single ASCII char code, else identity.\nfn wit_lower_char(c: Int) -> Int {\n  if c >= 65 && c <= 90 {\n    c + 32\n  } else {\n    c\n  }\n}\n\n/// vibe identifier (CamelCase / snake_case) -> WIT kebab-case word list.\n/// `HttpReq` -> `http-req`, `now_us` -> `now-us`, `Fs` -> `fs`. Consecutive\n/// uppercase letters split per letter (`URL` -> `u-r-l`) — vibe convention is\n/// strict CamelCase, so this stays predictable.\nexport fn wit_kebab_ident(name: String) -> String {\n  let sb = StringBuilder::new()\n  let len = String::length(name)\n  let mut i = 0\n  let mut prev_dash = true\n  while i < len {\n    let c = String::char_code_at(name, i)\n    if c == 95 {\n      if !prev_dash {\n        StringBuilder::push(sb, \"-\")\n      }\n      prev_dash = true\n    } else if c >= 65 && c <= 90 {\n      if !prev_dash {\n        StringBuilder::push(sb, \"-\")\n      }\n      StringBuilder::push(sb, String::from_char_code(wit_lower_char(c)))\n      prev_dash = false\n    } else {\n      StringBuilder::push(sb, String::from_char_code(c))\n      prev_dash = false\n    }\n    i = i + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\nfn wit_is_unit_type(ty: TypeExpr) -> Bool {\n  match ty {\n    TyUnit => true,\n    TyName(name) => name == \"Unit\",\n    _ => false\n  }\n}\n\n/// vibe TypeExpr -> WIT type text. Throws on types with no WIT mapping.\nexport fn wit_type_text(ty: TypeExpr) -> String with { Error } {\n  match ty {\n    TyName(name) => {\n      if name == \"Int\" {\n        \"s64\"\n      } else if name == \"Double\" {\n        \"f64\"\n      } else if name == \"Bool\" {\n        \"bool\"\n      } else if name == \"String\" {\n        \"string\"\n      } else if name == \"Char\" {\n        \"char\"\n      } else if name == \"Bytes\" {\n        \"list<u8>\"\n      } else {\n        throw(\"wit: no WIT mapping for type '\\{name}' (supported: Int, Double, Bool, String, Char, Bytes, Unit, Array, Option, Result, Map, tuples)\")\n      }\n    },\n    TyApp(head, args) => {\n      if head == \"Array\" && Array::length(args) == 1 {\n        \"list<\\{wit_type_text(Array::get(args, 0))}>\"\n      } else if head == \"Option\" && Array::length(args) == 1 {\n        \"option<\\{wit_type_text(Array::get(args, 0))}>\"\n      } else if head == \"Result\" && Array::length(args) == 2 {\n        \"result<\\{wit_type_text(Array::get(args, 0))}, \\{wit_type_text(Array::get(args, 1))}>\"\n      } else if head == \"Map\" && Array::length(args) == 2 {\n        \"list<tuple<\\{wit_type_text(Array::get(args, 0))}, \\{wit_type_text(Array::get(args, 1))}>>\"\n      } else {\n        throw(\"wit: no WIT mapping for type '\\{head}[..]'\")\n      }\n    },\n    TyTuple(items) => {\n      let sb = StringBuilder::new()\n      StringBuilder::push(sb, \"tuple<\")\n      let mut i = 0\n      while i < Array::length(items) {\n        if i > 0 {\n          StringBuilder::push(sb, \", \")\n        }\n        StringBuilder::push(sb, wit_type_text(Array::get(items, i)))\n        i = i + 1\n      }\n      StringBuilder::push(sb, \">\")\n      StringBuilder::freeze(sb)\n    },\n    TyFn(_, _, _) => throw(\"wit: function types cannot cross the WIT boundary\"),\n    TyUnit => throw(\"wit: Unit is only valid as a return type\")\n  }\n}\n\n/// `func(name: ty, ...) -> ret` text for a signature. Unit return omits `->`.\nfn wit_func_text(param_names: Array[String], param_types: Array[TypeExpr], ret: TypeExpr) -> String with { Error } {\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, \"func(\")\n  let mut i = 0\n  while i < Array::length(param_types) {\n    if i > 0 {\n      StringBuilder::push(sb, \", \")\n    }\n    let pname = if i < Array::length(param_names) {\n      wit_kebab_ident(Array::get(param_names, i))\n    } else {\n      \"arg\\{i}\"\n    }\n    StringBuilder::push(sb, pname)\n    StringBuilder::push(sb, \": \")\n    StringBuilder::push(sb, wit_type_text(Array::get(param_types, i)))\n    i = i + 1\n  }\n  StringBuilder::push(sb, \")\")\n  if !wit_is_unit_type(ret) {\n    StringBuilder::push(sb, \" -> \")\n    StringBuilder::push(sb, wit_type_text(ret))\n  }\n  StringBuilder::freeze(sb)\n}\n\n/// Split a parsed effect row (\"A, B\") into names. The parser joins the\n/// `with { A, B }` list with \", \" (parser_base.vibe collect_effect_names).\nfn wit_split_effect_row(row: String) -> Array[String] {\n  let out = array_empty()\n  let len = String::length(row)\n  let mut piece = \"\"\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(row, i)\n    if c == 44 {\n      if String::length(piece) > 0 {\n        Array::push(out, piece)\n      }\n      piece = \"\"\n    } else if c == 32 {\n      ()\n    } else {\n      piece = String::concat(piece, String::from_char_code(c))\n    }\n    i = i + 1\n  }\n  if String::length(piece) > 0 {\n    Array::push(out, piece)\n  }\n  out\n}\n\nfn wit_array_contains(items: Array[String], needle: String) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(items) {\n    if Array::get(items, i) == needle {\n      found = true\n    }\n    i = i + 1\n  }\n  found\n}\n\n// One exported function surface as a tuple:\n//   (name, param_names, param_types, ret, effects)\n// A plain tuple, not a struct: struct values crossing function boundaries\n// miscompile in the flat-bundle lane today (#537 follow-up filed), while\n// tuples are battle-tested everywhere in the compiler.\n\n/// Extract the boundary signature of `SLet(true, _, name, ann, body)`.\n/// Priority: TyFn annotation (param names from the EFn body when available),\n/// else fully-annotated EFn params/ret. Non-function exports and unannotated\n/// functions return None (they have no declarable WIT surface).\nfn wit_export_of_slet(name: String, ann: Option[TypeExpr], body: Expr) -> Option[(String, Array[String], Array[TypeExpr], TypeExpr, Array[String])] {\n  let efn_param_names = array_empty()\n  let efn_param_types = array_empty()\n  let mut efn_params_ok = true\n  let mut efn_ret = None\n  let mut efn_eff = None\n  match body {\n    EFn(_, _, params, ret_opt, eff_opt, _) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, pty_opt) = Array::get(params, i)\n        Array::push(efn_param_names, pname)\n        match pty_opt {\n          Some(pty) => Array::push(efn_param_types, pty),\n          None => {\n            efn_params_ok = false\n          }\n        }\n        i = i + 1\n      }\n      efn_ret = ret_opt\n      efn_eff = eff_opt\n    },\n    _ => {\n      efn_params_ok = false\n    }\n  }\n  let mut ann_fn = None\n  match ann {\n    Some(ty) => match ty {\n      TyFn(ptys, rty, eff) => {\n        ann_fn = Some((ptys, rty, eff))\n      },\n      _ => ()\n    },\n    None => ()\n  }\n  match ann_fn {\n    Some(fn_parts) => {\n      let (ptys, rty, eff) = fn_parts\n      let effects = match eff {\n        Some(row) => wit_split_effect_row(row),\n        None => array_empty()\n      }\n      Some((name, efn_param_names, ptys, rty, effects))\n    },\n    None => {\n      if efn_params_ok {\n        match efn_ret {\n          Some(rty) => {\n            let effects = match efn_eff {\n              Some(row) => wit_split_effect_row(row),\n              None => array_empty()\n            }\n            Some((name, efn_param_names, Array::slice(efn_param_types, 0, Array::length(efn_param_types)), rty, effects))\n          },\n          None => None\n        }\n      } else {\n        None\n      }\n    }\n  }\n}\n\n//# vibe serve handler contract (#537)\n\n/// The wasi-http P3 full-adapter handler contract\n/// (scripts/build_wasi_http_p3_full_adapter.sh):\n///   export let handler = (method: String, url: String, headers: String, body: String) -> String\n/// returning \"STATUS\\n<Header: value lines>\\n\\n<body>\".\nexport fn serve_handler_param_names() -> Array[String] {\n  [\n    \"method\",\n    \"url\",\n    \"headers\",\n    \"body\"\n  ]\n}\n\nfn wit_type_is_string(ty: TypeExpr) -> Bool {\n  match ty {\n    TyName(name) => name == \"String\",\n    _ => false\n  }\n}\n\n/// Validate the entry file's `handler` export against the serve contract,\n/// with a teaching error when it does not fit.\nexport fn validate_serve_handler(entry_stmts: Array[Stmt]) -> Unit with { Error } {\n  let contract = \"serve: expected `export let handler = (method: String, url: String, headers: String, body: String) -> String`\"\n  match wit_boundary_signature(entry_stmts, \"handler\") {\n    None => throw(String::concat(contract, \" (no exported `handler` with a full type annotation found)\")),\n    Some(sig) => {\n      let (_sname, _spnames, sig_param_types, sig_ret, sig_effects) = sig\n      if Array::length(sig_param_types) != 4 {\n        throw(String::concat(contract, \" (found \\{Array::length(sig_param_types)} params)\"))\n      }\n      let mut pi = 0\n      while pi < Array::length(sig_param_types) {\n        if !wit_type_is_string(Array::get(sig_param_types, pi)) {\n          throw(String::concat(contract, \" (param \\{pi} is not String)\"))\n        }\n        pi = pi + 1\n      }\n      if !wit_type_is_string(sig_ret) {\n        throw(String::concat(contract, \" (return type is not String)\"))\n      }\n      let mut ei = 0\n      while ei < Array::length(sig_effects) {\n        let ename = Array::get(sig_effects, ei)\n        if ename != \"Error\" {\n          throw(\"serve: handler requires capability effect '\\{ename}'; a serve handler must be a pure function of its request params (discharge the effect with `handle` inside the file)\")\n        }\n        ei = ei + 1\n      }\n    }\n  }\n}\n\n/// Boundary signature of one exported top-level function, by name. Used by\n/// `vibe serve` to validate the handler contract before componentizing.\nexport fn wit_boundary_signature(stmts: Array[Stmt], name: String) -> Option[(String, Array[String], Array[TypeExpr], TypeExpr, Array[String])] {\n  let mut found = None\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, _, sname, ann, body) => {\n        if exported && sname == name {\n          found = wit_export_of_slet(sname, ann, body)\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n/// Collect `effect` declarations (recursing into module blocks) as parallel\n/// name/ops arrays.\nfn wit_collect_effect_defs(stmts: Array[Stmt], out_names: Array[String], out_ops: Array[Array[(String, Array[TypeExpr], TypeExpr)]]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectDef(_, name, _, ops) => {\n        if !wit_array_contains(out_names, name) {\n          Array::push(out_names, name)\n          Array::push(out_ops, ops)\n        }\n      },\n      SModule(_, _, inner) => wit_collect_effect_defs(inner, out_names, out_ops),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\n/// Generate the WIT world text for a program.\n///   export_stmts: statements scanned for *exported* function surfaces\n///                 (normally the entry file's own statements).\n///   effect_stmts: statements scanned for `effect` declarations (may be the\n///                 same array, or entry + resolved import type decls).\n///   world_name:   raw name; kebab-cased into the world header.\n/// ADR-0071 (#755) step 5: a row item collected by wit_split_effect_row can\n/// now be a qualified operation (`Ask::Get`, step 1) or an effectset name\n/// (`AskAll`, step 2+) instead of only a bare effect name -- WITHOUT this,\n/// either shape falls through to the \"host capability effect ... no WIT\n/// mapping yet\" branch below, which is wrong (it's neither a host effect\n/// nor unmappable, just spelled differently than wit_collect_effect_defs'\n/// bare-name lookup expects). Local to this file (no new cross-file\n/// reference -- see docs/effectset.md's bootstrap gotcha); duplicates the\n/// same small ES-table/cycle-safe-expansion shape already used in\n/// checker_stmt.vibe and contract.vibe for the same reason.\nfn wit_es_collect_into(stmts: Array[Stmt], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectSet(_, esname, esmembers) => {\n        Array::push(es_names, esname)\n        Array::push(es_members_list, esmembers)\n      },\n      SModule(_, _, inner) => wit_es_collect_into(inner, es_names, es_members_list),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn wit_es_expand_into(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String], out: Array[String]) -> Unit {\n  if wit_array_contains(path, name) {\n    ()\n  } else {\n    let idx_of = {\n      let mut i = 0\n      let mut found = -1\n      while i < Array::length(es_names) {\n        if Array::get(es_names, i) == name {\n          found = i\n        }\n        i = i + 1\n      }\n      found\n    }\n    if idx_of < 0 {\n      if wit_array_contains(out, name) {\n        ()\n      } else {\n        Array::push(out, name)\n      }\n    } else {\n      Array::push(path, name)\n      let members = Array::get(es_members_list, idx_of)\n      let mut mi = 0\n      while mi < Array::length(members) {\n        wit_es_expand_into(es_names, es_members_list, Array::get(members, mi), path, out)\n        mi = mi + 1\n      }\n      Array::truncate(path, Array::length(path) - 1)\n    }\n  }\n}\n\n/// Strip a qualified operation name (`Ask::Get`) down to its effect prefix\n/// (`Ask`); a bare name (already an effect name, or an unresolvable label)\n/// passes through unchanged.\nfn wit_effect_name_of(label: String) -> String {\n  let idx = String::index_of(label, \"::\")\n  if idx > 0 {\n    String::substring(label, 0, idx)\n  } else {\n    label\n  }\n}\n\n/// Resolve one raw row-item label to the underlying effect NAME(s) it\n/// requires: expand it if it's a known effectset (pushing each expanded\n/// leaf's effect prefix), or just push its own effect prefix directly\n/// otherwise. Appends into `out` (deduped by the caller).\nfn wit_resolve_effect_names_into(label: String, es_names: Array[String], es_members_list: Array[Array[String]], out: Array[String]) -> Unit {\n  let is_effectset = {\n    let mut i = 0\n    let mut found = false\n    while i < Array::length(es_names) {\n      if Array::get(es_names, i) == label {\n        found = true\n      }\n      i = i + 1\n    }\n    found\n  }\n  if is_effectset {\n    let leaves = array_empty()\n    wit_es_expand_into(es_names, es_members_list, label, array_empty(), leaves)\n    let mut li = 0\n    while li < Array::length(leaves) {\n      let ename = wit_effect_name_of(Array::get(leaves, li))\n      if wit_array_contains(out, ename) {\n        ()\n      } else {\n        Array::push(out, ename)\n      }\n      li = li + 1\n    }\n  } else {\n    let ename = wit_effect_name_of(label)\n    if wit_array_contains(out, ename) {\n      ()\n    } else {\n      Array::push(out, ename)\n    }\n  }\n}\n\nexport fn wit_from_program(export_stmts: Array[Stmt], effect_stmts: Array[Stmt], world_name: String) -> String with { Error } {\n  let eff_names = array_empty()\n  let eff_ops = array_empty()\n  wit_collect_effect_defs(effect_stmts, eff_names, eff_ops)\n  wit_collect_effect_defs(export_stmts, eff_names, eff_ops)\n  let wit_es_names = array_empty()\n  let wit_es_members_list = array_empty()\n  wit_es_collect_into(effect_stmts, wit_es_names, wit_es_members_list)\n  wit_es_collect_into(export_stmts, wit_es_names, wit_es_members_list)\n  let exports = array_empty()\n  let mut i = 0\n  while i < Array::length(export_stmts) {\n    match Array::get(export_stmts, i) {\n      SLet(exported, _, name, ann, body) => {\n        if exported {\n          match wit_export_of_slet(name, ann, body) {\n            Some(ex) => Array::push(exports, ex),\n            None => ()\n          }\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  // Imports: effects referenced by exported signatures, in first-use order.\n  // ADR-0071 (#755) step 5: each raw row-item label is resolved through\n  // wit_resolve_effect_names_into first -- a qualified operation\n  // (`Ask::Get`) or effectset name (`AskAll`) maps to its underlying real\n  // effect name(s) instead of being pushed verbatim (which would never\n  // match eff_names below and misreport as an unmappable host capability).\n  let used_effects = array_empty()\n  let mut xi = 0\n  while xi < Array::length(exports) {\n    let (_xn, _xp, _xt, _xr, ex_effects) = Array::get(exports, xi)\n    let mut ei = 0\n    while ei < Array::length(ex_effects) {\n      let ename = Array::get(ex_effects, ei)\n      if ename != \"Error\" {\n        let resolved = array_empty()\n        wit_resolve_effect_names_into(ename, wit_es_names, wit_es_members_list, resolved)\n        let mut ri = 0\n        while ri < Array::length(resolved) {\n          let rname = Array::get(resolved, ri)\n          if rname != \"Error\" && !wit_array_contains(used_effects, rname) {\n            Array::push(used_effects, rname)\n          }\n          ri = ri + 1\n        }\n      } else {\n        ()\n      }\n      ei = ei + 1\n    }\n    xi = xi + 1\n  }\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, \"package vibe:app;\\n\\nworld \")\n  StringBuilder::push(sb, wit_kebab_ident(world_name))\n  StringBuilder::push(sb, \" {\\n\")\n  let mut ui = 0\n  while ui < Array::length(used_effects) {\n    let ename = Array::get(used_effects, ui)\n    let mut def_idx = 0 - 1\n    let mut di = 0\n    while di < Array::length(eff_names) {\n      if Array::get(eff_names, di) == ename {\n        def_idx = di\n      }\n      di = di + 1\n    }\n    if def_idx >= 0 {\n      StringBuilder::push(sb, \"  import \")\n      StringBuilder::push(sb, wit_kebab_ident(ename))\n      StringBuilder::push(sb, \": interface {\\n\")\n      let ops = Array::get(eff_ops, def_idx)\n      let mut oi = 0\n      while oi < Array::length(ops) {\n        let (op_name, op_args, op_ret) = Array::get(ops, oi)\n        StringBuilder::push(sb, \"    \")\n        StringBuilder::push(sb, wit_kebab_ident(op_name))\n        StringBuilder::push(sb, \": \")\n        StringBuilder::push(sb, wit_func_text(array_empty(), op_args, op_ret))\n        StringBuilder::push(sb, \";\\n\")\n        oi = oi + 1\n      }\n      StringBuilder::push(sb, \"  }\\n\")\n    } else {\n      // Host capability effect (Fs / Env / Async / ...): provided by the vibe\n      // runtime's host imports; no declared operations to surface.\n      StringBuilder::push(sb, \"  // host capability effect '\")\n      StringBuilder::push(sb, ename)\n      StringBuilder::push(sb, \"' (provided by the vibe runtime; no WIT mapping yet)\\n\")\n    }\n    ui = ui + 1\n  }\n  let mut xo = 0\n  while xo < Array::length(exports) {\n    let (ex_name, ex_param_names, ex_param_types, ex_ret, _ex_effects) = Array::get(exports, xo)\n    StringBuilder::push(sb, \"  export \")\n    StringBuilder::push(sb, wit_kebab_ident(ex_name))\n    StringBuilder::push(sb, \": \")\n    StringBuilder::push(sb, wit_func_text(ex_param_names, ex_param_types, ex_ret))\n    StringBuilder::push(sb, \";\\n\")\n    xo = xo + 1\n  }\n  StringBuilder::push(sb, \"}\\n\")\n  StringBuilder::freeze(sb)\n}\n")
}

let cli_adapter_source_109 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/builtin_bodies/bodies_core_a1a1_eq.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_gt_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_str_ref,\n  expr_tag,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  is_efn,\n  is_eident,\n  is_etuple,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  lookup_ctor,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\n//# Functions\n\n/// Push `memory.size * 65536` (linear memory size in BYTES) as an i64.\nfn emit_mem_size_bytes(b: Bytes) -> Unit {\n  bytebuf_push(b, 63)\n  bytebuf_push(b, 0)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 65536)\n  emit_i64_mul(b)\n}\n\n/// Push an i32 bool: could `v` (the i64 in local `slot`) be safely byte-compared\n/// as a string fat-pointer `(ptr << 32) | len` WITHOUT reading out of bounds —\n/// i.e. `ptr + len <= memory_size`, where ptr is the UNSIGNED high word (a value\n/// whose high bit is set yields a huge ptr that exceeds memory_size, so it is\n/// rejected rather than wrapping to a low in-bounds address). This is the OOB\n/// guard from #664; it deliberately does NOT require `ptr >= 64`, because a\n/// genuine empty string can have a low pointer (e.g. a 0-length name read from a\n/// custom section) and must still compare equal — requiring `ptr >= 64` regressed\n/// such comparisons to \"not equal\". The residual it gives up on (two distinct\n/// integers with equal low words comparing equal) is the accepted #678 hole.\nfn emit_looks_like_string(b: Bytes, slot: Int) -> Unit {\n  emit_local_get(b, slot)\n  emit_i64_const(b, 32)\n  bytebuf_push(b, 136)\n  emit_local_get(b, slot)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i64_add(b)\n  emit_mem_size_bytes(b)\n  emit_i64_le_s(b)\n}\n\nexport fn gen_eq_body(str_eq_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_eq(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 1)\n  emit_else(b)\n  // The operands are bit-different. Falling back to `str_eq` here is only valid\n  // when both are genuine string fat-pointers; a raw integer (e.g. a 61-bit\n  // value) whose bits resemble `(ptr << 32) | len` would otherwise be misread —\n  // a low word of 0 makes two unequal ints compare EQUAL, and a large low word\n  // makes `str_eq`'s byte loop read out of bounds (the #664 class of bug, here\n  // surfacing for `==`/`!=` on Int >= 2^32). Gate the fallback on both operands\n  // looking like real strings; otherwise the values are simply not equal.\n  emit_looks_like_string(b, 0)\n  emit_looks_like_string(b, 1)\n  bytebuf_push(b, 113)\n  emit_if_i64(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, str_eq_idx)\n  emit_else(b)\n  emit_i64_const(b, 0)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\n/// #973 review: `emit_looks_like_string` alone is too permissive for the\n/// erased-generic dispatch below. ANY ordinary non-negative Int under 2^32\n/// (i.e. essentially every everyday int -- 3, 4, 10, ...) has ptr==0 (its high\n/// 32 bits are zero), and ptr(0) + len(anything up to memory_size) <=\n/// memory_size is trivially true -- so `emit_looks_like_string` answers \"yes\"\n/// for nearly all small ints, not just genuine strings. For `gen_eq_body`'s\n/// `==`/`!=` that false positive is harmless: two DIFFERENT ints almost always\n/// decode to different fake \"lengths\", so `str_eq`'s own length check still\n/// answers \"not equal\" -- the same answer a raw compare would give (the only\n/// accepted residual is #678's narrow \"equal low words\" coincidence). It is\n/// NOT harmless for `+`: concatenating two int-reinterpreted-as-strings\n/// produces a garbage packed value, not their sum -- confirmed empirically,\n/// `my_add_gen(3, 4)` trapped instead of returning 7 with the plain heuristic.\n/// Requiring `ptr >= 64` (the ORIGINAL pre-#664 bound) excludes every ordinary\n/// small Int (whose implied ptr is 0..63) while a genuine String's\n/// data-section/heap address in this codegen is always >= 64 -- INCLUDING\n/// empty strings: `data_base` (the fixed start of the string data section,\n/// `linked_compile.vibe`/`gc/backend_body.vibe`) is 64, so there is no\n/// legitimate empty-string case with ptr < 64 to carve out here, unlike the\n/// #664 residual this borrows its bound from.\n///\n/// #973 P1 fix (Codex review on PR #1005): an EARLIER version of this\n/// function additionally treated `len == 0` alone as \"looks like a string\"\n/// (reasoning, incorrectly, that a real empty string might have ptr < 64).\n/// That let (ptr=0, len=0) -- i.e. the packed representation of plain integer\n/// `0` -- satisfy the strict check via the `len == 0` branch even though\n/// `ptr >= 64` was false, so `num_add[T: Add](0, 0)` matched as \"both look\n/// like strings\" and called `str_concat` instead of `i64.add`, returning a\n/// garbage heap pointer instead of `0` -- confirmed empirically. Dropping the\n/// `len == 0` disjunct (requiring `ptr >= 64` unconditionally) fixes this\n/// while still accepting every genuine string, empty or not, per the\n/// `data_base = 64` invariant above. The residual this narrows down to -- a\n/// very large Int (implied ptr >= 64, i.e. the value is >= 64 * 2^32)\n/// mistaken for a string -- is the same CLASS of accepted large-int residual\n/// #664/#678 already carry for `eq`/`str_lex_diff`, just with a much smaller\n/// trigger window than the plain heuristic's \"any small int\".\nfn emit_looks_like_string_strict(b: Bytes, slot: Int) -> Unit {\n  emit_looks_like_string(b, slot)\n  emit_local_get(b, slot)\n  emit_i64_const(b, 32)\n  bytebuf_push(b, 136)\n  emit_i64_const(b, 64)\n  emit_i64_ge_s(b)\n  bytebuf_push(b, 113)\n}\n\n/// #973: runtime dispatch for `<`/`>`/`<=`/`>=` on an ERASED generic type\n/// parameter (`[T: Ord]`). #952 keeps such a `T` rigid/polymorphic all the way\n/// through the checker (no forced monomorphization to Int/Double/String), but\n/// `Ord`/`Add` are method-less MARKER traits (declared with an empty body --\n/// see `builtin_traits.vibe`), so `build_gens` never threads them a witness\n/// dict (only method-bearing bounds get one). That leaves the desugar rewrite\n/// in `desugar_trait_dict.vibe` with a STATIC type name of the bare type\n/// parameter itself (e.g. \"T\", from `seed_var_types`'s generic `EFn` seeding)\n/// at the `<`/`>`/`+` site -- nothing concrete to key a `String`-vs-`Int`\n/// rewrite off, so it fell through to a raw signed i64 compare, which orders a\n/// heap String operand's packed `(ptr<<32)|len` representation by POINTER, not\n/// content (the `ord_clamp(\"m\",\"a\",\"z\")` repro in #973).\n///\n/// Uses `emit_looks_like_string_strict` (see above), NOT the plain\n/// `emit_looks_like_string` `gen_eq_body` uses -- see that function's doc\n/// comment for why the plain heuristic is unsafe here. The non-string fallback\n/// is the EXACT signed i64 compare `emit_binop_op` already emits for the\n/// monomorphic case, so Int operands (and Double bit patterns, already broken\n/// independently of this fix -- the default linear/non-RC backend has no tag\n/// distinguishing an Int from an f64 bit pattern, so that residual is a\n/// separate, harder problem left untouched) behave identically to before this\n/// function existed. Returns a sign value consumed the same way `str_lex_diff`\n/// is: desugar rewrites `a <op> b` to `__generic_rel_diff(a, b) <op> 0`. Under\n/// RC, scalar Int is tagged `n << 1` (see `str_lex_diff`'s own tagging\n/// comment) -- doubling preserves sign so `< 0` would stay correct either way,\n/// but the numeric-fallback branch tags its own -1/0/1 literals to match\n/// convention; the string branch already returns a `str_lex_diff` result that\n/// tags itself internally, so it is NOT re-tagged here (that would\n/// double-shift it).\nexport fn gen_generic_rel_diff_body(enable_rc: Bool, str_lex_diff_idx: Int) -> Bytes {\n  let neg1 = if enable_rc {\n    0 - 2\n  } else {\n    0 - 1\n  }\n  let pos1 = if enable_rc {\n    2\n  } else {\n    1\n  }\n  let b = bytebuf_new()\n  emit_looks_like_string_strict(b, 0)\n  emit_looks_like_string_strict(b, 1)\n  bytebuf_push(b, 113)\n  emit_if_i64(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, str_lex_diff_idx)\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_lt_s(b)\n  emit_if_i64(b)\n  emit_i64_const(b, neg1)\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_gt_s(b)\n  emit_if_i64(b)\n  emit_i64_const(b, pos1)\n  emit_else(b)\n  emit_i64_const(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\n/// #973: runtime dispatch for `+` on an erased generic type parameter\n/// (`[T: Add]`). Mirrors `gen_generic_rel_diff_body`'s string/numeric split\n/// and ALSO uses `emit_looks_like_string_strict`, not the plain heuristic --\n/// this one is not optional here (see that function's doc comment): the plain\n/// heuristic answers \"looks like a string\" for nearly every ordinary small\n/// Int, and concatenating two int-reinterpreted-as-strings produces a garbage\n/// packed value, not their sum, with no rescue analogous to `str_eq`'s length\n/// check or `str_lex_diff`'s tiebreak. String operands concat via\n/// `str_concat_idx` (whose result is already the correctly-shaped packed\n/// representation for its return type -- no extra tagging needed here),\n/// non-string operands take the exact `emit_i64_add` the monomorphic Int path\n/// already uses. Under RC, `tagged_a + tagged_b` already equals\n/// `tagged(a + b)` (doubling is linear), matching `compile_expr.vibe`'s\n/// existing RC `\"+\"` case, which likewise applies no post-add shift -- so this\n/// needs no `enable_rc` parameter at all.\nexport fn gen_generic_add_body(str_concat_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_looks_like_string_strict(b, 0)\n  emit_looks_like_string_strict(b, 1)\n  bytebuf_push(b, 113)\n  emit_if_i64(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, str_concat_idx)\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_add(b)\n  emit_end(b)\n  b\n}\n")
}

