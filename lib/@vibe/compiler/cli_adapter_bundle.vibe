ytes, CtInt, CtInt), CtBytes, None))\n  }\n  else None\n}\n\nfn lookup_bytes_append(name: String) -> Option[Type] {\n  if name == \"Bytes::append\" {\n    Some(CtFn(bytes_two_params(CtBytes, CtBytes), CtUnit, None))\n  }\n  else None\n}\n\nfn lookup_bytes_concat(name: String) -> Option[Type] {\n  if name == \"Bytes::concat\" {\n    Some(CtFn(bytes_two_params(CtBytes, CtBytes), CtBytes, None))\n  }\n  else None\n}\n\nfn lookup_bytes_length(name: String) -> Option[Type] {\n  if name == \"Bytes::length\" {\n    Some(CtFn(bytes_one_param(CtBytes), CtInt, None))\n  }\n  else None\n}\n\nfn lookup_bytes_group_a(name: String) -> Option[Type] {\n  match lookup_bytes_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_bytes_length(name) {\n      Some(t) => Some(t),\n      None => match lookup_bytes_get(name) {\n        Some(t) => Some(t),\n        None => lookup_bytes_set(name)\n      }\n    }\n  }\n}\n\nfn lookup_bytes_group_b(name: String) -> Option[Type] {\n  match lookup_bytes_push(name) {\n    Some(t) => Some(t),\n    None => match lookup_bytes_concat(name) {\n      Some(t) => Some(t),\n      None => match lookup_bytes_slice(name) {\n        Some(t) => Some(t),\n        None => lookup_bytes_append(name)\n      }\n    }\n  }\n}\n\nfn lookup_bytes_to_array(name: String) -> Option[Type] {\n  if name == \"Bytes::to_array\" {\n    Some(CtFn(bytes_one_param(CtBytes), CtArray(CtInt), None))\n  }\n  else None\n}\n\nfn lookup_bytes_from_array(name: String) -> Option[Type] {\n  if name == \"Bytes::from_array\" {\n    Some(CtFn(bytes_one_param(CtArray(CtInt)), CtBytes, None))\n  }\n  else None\n}\n\nfn lookup_bytes_group_c(name: String) -> Option[Type] {\n  match lookup_bytes_blit(name) {\n    Some(t) => Some(t),\n    None => match lookup_bytes_fill(name) {\n      Some(t) => Some(t),\n      None => match lookup_bytes_from_array(name) {\n        Some(t) => Some(t),\n        None => lookup_bytes_to_array(name)\n      }\n    }\n  }\n}\n\n/// simd_skip_ws(buf, pos, len): SIMD-accelerated whitespace scan over a byte\n/// buffer; returns the first non-whitespace index in [pos, len), or len.\nfn lookup_simd_skip_ws(name: String) -> Option[Type] {\n  if name == \"simd_skip_ws\" {\n    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtInt, None))\n  }\n  else None\n}\n\n/// simd_scan_alnum(buf, pos, len): SIMD-accelerated identifier-byte scan; returns\n/// the first non-[A-Za-z0-9_] index in [pos, len), or len.\nfn lookup_simd_scan_alnum(name: String) -> Option[Type] {\n  if name == \"simd_scan_alnum\" {\n    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtInt, None))\n  }\n  else None\n}\n\n/// simd_scan_alnum_str: same scan over a String source (lexer-facing variant);\n/// (source, pos, len) -> first non-identifier index in [pos, len), or len.\nfn lookup_simd_scan_alnum_str(name: String) -> Option[Type] {\n  if name == \"simd_scan_alnum_str\" {\n    Some(CtFn(bytes_three_params(CtString, CtInt, CtInt), CtInt, None))\n  }\n  else None\n}\n\nexport fn lookup_bytes(name: String) -> Option[Type] {\n  match lookup_bytes_group_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_bytes_group_b(name) {\n      Some(t) => Some(t),\n      None => match lookup_bytes_group_c(name) {\n        Some(t) => Some(t),\n        None => match lookup_simd_skip_ws(name) {\n          Some(t) => Some(t),\n          None => match lookup_simd_scan_alnum(name) {\n            Some(t) => Some(t),\n            None => lookup_simd_scan_alnum_str(name)\n          }\n        }\n      }\n    }\n  }\n}\n")
