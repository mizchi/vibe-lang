code_at_body, static_str_eq_body, static_str_len_body\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in, scope_tail_proj_root, stmts_contain_exceptions\n}\n\nimport @vibe/compiler/codegen/common_base {\n  desugar_trait_dicts,\n  rewrite_self_tail_calls,\n  inline_direct_performs,\n  evidence_dict_pass,\n  rc_shadow_reserve,\n  CompileCtx, CovState, CtorTable, DbgProv, FuncTable, LambdaTable, StrTable, agg_info_of_type_expr, compute_agg_returning, ctor_sorted_index, emit_rc_dup_guarded, empty_dbg_prov, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, fn_type_param_types, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, get_slet_type, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local, builtin_registry, verify_lane_builtins, compile_inline_wat\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str, build_newline_offsets, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport @vibe/compiler/codegen/expr {\n  compile_expr\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_heap_memory_grow_check, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i64_store, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, emit_vibe_abi_custom_section, emit_function_name_section, string_to_data\n}\n\nimport ./linked_helpers.vibe {\n  stmts_use_builtin, collect_used_builtin_names\n}\n\n//# Functions\n\nlet wasm_page_size = 65536\n\nfn lc_fresh_int_array() -> Array[Int] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_bool_array() -> Array[Bool] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_bytes_array() -> Array[Bytes] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_string_array() -> Array[String] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_expr_array() -> Array[Expr] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn lc_fresh_type_expr_array() -> Array[TypeExpr] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\n// #1062: positional field types for a struct declaration's field list,\n// dropping the names -- SEnum/SSuberror variants are already unnamed\n// (Array[TypeExpr]), but SStruct fields carry (name, type) pairs.\nfn struct_field_types(sfields: Array[(String, TypeExpr)]) -> Array[TypeExpr] {\n  let out = lc_fresh_type_expr_array()\n  let mut i = 0\n  while i < Array::length(sfields) {\n    let (_, ft) = Array::get(sfields, i)\n    Array::push(out, ft)\n    i = i + 1\n  }\n  out\n}\n\n// #1062: append `ctor_idx * 64 + field_idx` to `out` for every positional\n// field in `field_types` whose declared type is Double/Float (same TyName\n// check as the annotated-Float/Double-param seeding below). See\n// CompileCtx.ctor_float_fields.\nfn push_ctor_float_fields(out: Array[Int], ctor_idx: Int, field_types: Array[TypeExpr]) -> Unit {\n  let mut fi = 0\n  while fi < Array::length(field_types) {\n    match Array::get(field_types, fi) {\n      TyName(ftn) => if ftn == \"Float\" || ftn == \"Double\" {\n        Array::push(out, ctor_idx * 64 + fi)\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    fi = fi + 1\n  }\n}\n\n\nfn lc_fresh_string_matrix() -> Array[Array[String]] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nfn gen_heap_grow_check_body() -> Bytes {\n  let b = bytebuf_new()\n  emit_heap_memory_grow_check(b)\n  b\n}\n\n// #805 (ADR-0072): collect the inline-wasm fns (`fn f(..) -> Int = wasm\n// \"...\"`, carried as the parser-internal `%wasm(\"<WAT>\")` marker body) into\n// parallel name/WAT-text arrays and REPLACE each marker body with a neutral\n// EInt(0) IN PLACE — so every downstream analysis (Perceus plans, borrow/\n// scalar-return classification, string-table collection, coverage) sees an\n// ordinary trivial body and the WAT text never leaks into the data section.\n// The per-fn codegen loop then splices the assembled instruction bytes\n// (compile_inline_wat) instead of running compile_expr for these names.\nfn lc_extract_inline_wasm(stmts: Array[Stmt], names: Array[String], wats: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(iw_exp, iw_rec, iw_name, iw_ann, iw_expr) => match iw_expr {\n        EFn(iw_tps, iw_tbs, iw_params, iw_ret, iw_eff, iw_body) => match iw_body {\n          ECall(iw_cal, iw_args, _) => match iw_cal {\n            EIdent(iw_cn, _) => if iw_cn == \"%wasm\" && Array::length(iw_args) == 1 {\n              match Array::get(iw_args, 0) {\n                EString(iw_wat) => {\n                  Array::push(names, iw_name)\n                  Array::push(wats, iw_wat)\n                  Array::set(stmts, i, SLet(iw_exp, iw_rec, iw_name, iw_ann, EFn(iw_tps, iw_tbs, iw_params, iw_ret, iw_eff, EInt(0))))\n                },\n                _ => ()\n              }\n            } else {\n              ()\n            },\n            _ => ()\n          },\n          _ => ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nlet default_wasi_memory_min_pages = 64\n\nexport fn wasi_memory_min_pages_for_heap(heap_start: Int) -> Int {\n  let needed_pages = (heap_start + wasm_page_size - 1) / wasm_page_size\n  if needed_pages > default_wasi_memory_min_pages {\n    needed_pages\n  } else {\n    default_wasi_memory_min_pages\n  }\n}\n\n// ADR-0069: `Unit` in a declared return position — either the canonical\n// TyUnit (`-> ()`) or the named spelling (`-> Unit`, what parse_type produces\n// and what the `fn main {}` desugar emits).\nfn linked_type_expr_is_unit(t: TypeExpr) -> Bool {\n  match t {\n    TyUnit => true,\n    TyName(n) => n == \"Unit\",\n    _ => false\n  }\n}\n\nexport fn compile_wasi_module_linked_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool, enable_rc: Bool, coverage: Bool, debug_trace: Bool, debug_break: Bool, rc_shadow: Bool, prov: DbgProv) -> Bytes with { Error } {\n  // Method-bearing-trait dictionary passing (#641 PR-3). Universal codegen\n  // convergence point — runs here on the fully merged program before generic\n  // type params are stripped (just below). No-op unless a method-bearing trait\n  // is declared, and idempotent if an earlier pipeline stage already desugared.\n  desugar_trait_dicts(stmts)\n  // Top-level `let f = g` function aliases: retarget references to the final\n  // EFn def so calls do not route through the 0-param thunk registration\n  // below (invalid wasm for any call arity). See import_alias_rewrite.vibe.\n  rewrite_top_level_fn_alias_refs(stmts)\n  // #805: inline-wasm fns — extract WAT texts + neutralize marker bodies\n  // BEFORE any analysis below (see lc_extract_inline_wasm's doc comment).\n  let iw_names = lc_fresh_string_array()\n  let iw_wats = lc_fresh_string_array()\n  lc_extract_inline_wasm(stmts, iw_names, iw_wats)\n  // #tco: rewrite a top-level function's self-tail-recursive calls into the\n  // same ELetMut/EWhile/EBreak/EContinue shape `loop (...) { continue(...) }`\n  // already lowers to (see self_tail_call.vibe) -- zero wasm call-stack\n  // growth per recursive step instead of an unbounded `call`. No-op unless a\n  // function is directly self-tail-recursive; runs before the borrow/scalar-\n  // return analyses below so they see the rewritten (loop-shaped) body.\n  rewrite_self_tail_calls(stmts)\n  // ADR-0076 (#817) Phase 2: inline `perform` calls that are structurally\n  // reachable-only-via-tail-resumptive-handler-arms directly into their\n  // handler arm body (single-shot fast path -- no replay loop, no memoized\n  // perform-return-value table). Conservative: bails out per-handle whenever\n  // the handled body contains anything (nested `handle`, closures, or calls\n  // to named functions) that could hide a perform outside this direct scan,\n  // leaving those handled by the existing replay-based lowering below.\n  inline_direct_performs(stmts)\n  // ADR-0076 (#817) Phase 3, first slice: evidence-dict threading for the\n  // narrow case Phase 2 above cannot reach on its own -- a handle body that\n  // calls a named top-level function which itself performs the handled\n  // effect (docs/effect-evidence-passing.md \"追記 2\", evidence_dict_pass's\n  // own doc comment in common_base/inline_direct_perform.vibe -- appended to\n  // that existing cross-file-registered file rather than a new one, to\n  // avoid the bootstrap flatten gotcha documented in docs/effectset.md).\n  // Runs after Phase 2 so it only sees the handles Phase 2 did\n  // not already fully inline; whole-program-conservative and strictly\n  // additive (per-effect all-or-nothing), so it never touches a handle or\n  // function Phase 2 already resolved or that this pass cannot prove safe.\n  evidence_dict_pass(stmts, entry_name)\n  // #707: functions whose entire body is transitively a tail-call to a\n  // borrow-returning builtin (Array::get/Map::get/__index) -- e.g. a thin\n  // `peek(toks, pos) -> Array::get(toks, pos)` wrapper. Computed once over the\n  // whole merged program and threaded into every function's Perceus plan so a\n  // `let v = peek(...)` binding (including the match-scrutinee-lift's\n  // `let __m_scrut = peek(...)`, see normalize/index.vibe) is recognized the\n  // same as a direct `let v = Array::get(...)` one.\n  let lc_borrow_ret_names = compute_borrow_returning_names(stmts)\n  // #710: see CompileCtx.scalar_ret_names' doc comment (common_base/common_base.vibe).\n  let lc_scalar_ret_names = compute_scalar_returning_names(stmts)\n  let fn_names_list = lc_fresh_string_array()\n  let fn_param_counts = lc_fresh_int_array()\n  let fn_needs_env_list = lc_fresh_bool_array()\n  let fn_stmt_indices = lc_fresh_int_array()\n  let thunk_names_list = lc_fresh_string_array()\n  let const_int_names_list = lc_fresh_string_array()\n  let const_int_values_list = lc_fresh_int_array()\n  let export_fn_names = lc_fresh_string_array()\n  let export_fn_user_indices = lc_fresh_int_array()\n  let test_fn_names = lc_fresh_string_array()\n  let empty_tp = array_empty()\n  let empty_bounds = array_empty()\n  let empty_params = array_empty()\n  let mut pi = 0\n  while pi < Array::length(stmts) {\n    match Array::get(stmts, pi) {\n      STest(tname, tbody) => {\n        let test_fn = String::concat(\"__test_\", tname)\n        Array::push(test_fn_names, test_fn)\n        Array::set(stmts, pi, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))\n      },\n      SBench(bname, bbody) => {\n        let bench_fn = String::concat(\"__bench_\", bname)\n        Array::push(test_fn_names, bench_fn)\n        Array::set(stmts, pi, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))\n      },\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\n          Array::set(stmts, pi, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\n        }\n        ,\n        _ => ()\n      },\n      _ => ()\n    }\n    pi = pi + 1\n  }\n  if Array::length(test_fn_names) > 0 {\n    let mut has_entry = false\n    let mut ei = 0\n    while ei < Array::length(stmts) {\n      match Array::get(stmts, ei) {\n        SLet(is_exp, _, name, _, _) => if is_exp && name == entry_name {\n          has_entry = true\n        },\n        _ => ()\n      }\n      ei = ei + 1\n    }\n    if !has_entry {\n      ()\n    }\n  }\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if is_slet(stmt) {\n      let name = get_slet_name(stmt)\n      let expr = get_slet_expr(stmt)\n      let is_export = get_slet_export(stmt)\n      let user_idx = Array::length(fn_names_list)\n      // #715: `expr_tag(expr)` hoisted out of the `else` branch below and\n      // computed here, unconditionally -- so it (like `is_efn(expr)` above)\n      // contributes to `expr`'s always-consumed prefix instead of only being\n      // paid for on the `else` path. This alone still leaves the `else`\n      // branch's own nested if asymmetric (`get_eint_value`=1 use vs the\n      // thunk fallback's 0), so the thunk fallback below also aliases `expr`\n      // once (`let __sf_thunk_expr = expr`) to match. With both asymmetries\n      // resolved, `then` and `else` each consume `expr` the same number of\n      // times, so pc_emit's EIf MIN-merge (#705) lands on the SAME remaining\n      // count regardless of which branch a given statement actually takes --\n      // previously the merge could permanently assume more consumption than\n      // a commonly-taken branch (int-constant or thunk statements, which are\n      // NOT rare like a false `is_efn` check on a real function body) really\n      // performed, skipping the loop-body scope-end drop and leaking `expr`\n      // (a heap Expr node) on every such statement.\n      let __sf_etag = expr_tag(expr)\n      if is_efn(expr) {\n        let params = get_efn_params(expr)\n        Array::push(fn_names_list, name)\n        Array::push(fn_param_counts, Array::length(params))\n        Array::push(fn_needs_env_list, true)\n        Array::push(fn_stmt_indices, i)\n      } else {\n        if (__sf_etag == 0) && !is_export {\n          Array::push(const_int_names_list, name)\n          Array::push(const_int_values_list, get_eint_value(expr))\n        } else {\n          let __sf_thunk_expr = expr\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, 0)\n          Array::push(fn_needs_env_list, true)\n          Array::push(fn_stmt_indices, i)\n          Array::push(thunk_names_list, name)\n        }\n      }\n      if is_export || library_mode {\n        Array::push(export_fn_names, name)\n        Array::push(export_fn_user_indices, user_idx)\n      }\n    }\n    i = i + 1\n  }\n  let ctor_names_list = lc_fresh_string_array()\n  Array::push(ctor_names_list, \"None\")\n  Array::push(ctor_names_list, \"Some\")\n  let ctor_tags_list = lc_fresh_int_array()\n  Array::push(ctor_tags_list, 0)\n  Array::push(ctor_tags_list, 1)\n  let ctor_field_counts_list = lc_fresh_int_array()\n  Array::push(ctor_field_counts_list, 0)\n  Array::push(ctor_field_counts_list, 1)\n  let ctor_type_names_list = lc_fresh_string_array()\n  Array::push(ctor_type_names_list, \"Option\")\n  Array::push(ctor_type_names_list, \"Option\")\n  // #1062: sparse `ctor_idx * 64 + field_idx` entries for Double/Float-typed\n  // positional constructor fields (see CompileCtx.ctor_float_fields). Built\n  // alongside ctor_names_list/ctor_field_counts_list above so ctor_idx here\n  // always matches ctor_table_index_of's result for the same name.\n  let ctor_float_fields_list = lc_fresh_int_array()\n  let mut type_index = 1\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, _, variants, _) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          push_ctor_float_fields(ctor_float_fields_list, Array::length(ctor_names_list) - 1, vfields)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields, _, _, _) => {\n        type_index = type_index + 1\n        Array::push(ctor_names_list, sname)\n        Array::push(ctor_tags_list, type_index<<16)\n        Array::push(ctor_field_counts_list, Array::length(sfields))\n        Array::push(ctor_type_names_list, sname)\n        push_ctor_float_fields(ctor_float_fields_list, Array::length(ctor_names_list) - 1, struct_field_types(sfields))\n        0\n      },\n      SSuberror(_, ename, variants) => {\n        // #786: a suberror is a single-typed enum whose constructors produce a\n        // throwable value; register its ctors in the ctor table like an enum's\n        // so `KeyInvalid(\"x\")` allocates a tagged value instead of resolving to\n        // an undefined name at codegen.\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          push_ctor_float_fields(ctor_float_fields_list, Array::length(ctor_names_list) - 1, vfields)\n          vi = vi + 1\n        }\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n  let struct_names = lc_fresh_string_array()\n  let struct_field_names = lc_fresh_string_matrix()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, sname, sfields, _, _, _) => {\n        Array::push(struct_names, sname)\n        let fnames = lc_fresh_string_array()\n        let mut sfi = 0\n        while sfi < Array::length(sfields) {\n          let (fname, _) = Array::get(sfields, sfi)\n          Array::push(fnames, fname)\n          sfi = sfi + 1\n        }\n        Array::push(struct_field_names, fnames)\n        ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  // Sorted ctor-name index (see CtorTable.names_sorted): built once here,\n  // shared by this table literal and every per-function ctor_table below.\n  let (lc_ctor_names_sorted, lc_ctor_names_sorted_pos) = ctor_sorted_index(ctor_names_list)\n  // #724 round 2: (fn name -> declared aggregate return shape) table so\n  // `let a = f(..)` bindings participate in structural `==` (see\n  // compute_agg_returning in common_base).\n  let lc_agg_ret_names = lc_fresh_string_array()\n  let lc_agg_ret_infos = lc_fresh_int_array()\n  compute_agg_returning(stmts, CtorTable::{\n    names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: lc_ctor_names_sorted, names_sorted_pos: lc_ctor_names_sorted_pos\n  }, lc_agg_ret_names, lc_agg_ret_infos)\n  // #791: program-wide (fn name) set for declared-heap-returning top-level\n  // functions (see compute_heap_returning in perceus/index.vibe). Consulted\n  // by classify_let_value_heap (compile_expr_tail.vibe) to classify\n  // `let`/`let mut` bindings whose value is a call by the CALLEE's own\n  // declared signature, instead of always over-approximating every call as\n  // heap.\n  let lc_heap_ret_names = compute_heap_returning(stmts)\n  let num_user_funcs = Array::length(fn_names_list)\n  if num_user_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n  let mut entry_user_idx = -1\n  let mut ei = 0\n  while ei < num_user_funcs {\n    if Array::get(fn_names_list, ei) == entry_name {\n      entry_user_idx = ei\n    }\n    ei = ei + 1\n  }\n  // ADR-0069 Phase 1: a missing entry is a compile error. Historically ANY\n  // unknown entry name fell through to the test-runner `_start` synthesis, so\n  // an entry typo silently produced a no-op module. Only the explicit\n  // `__no_entry__` sentinel (vibe test / bench) may synthesize the test runner\n  // now. Library mode passes a synthetic entry name it never calls, so it is\n  // exempt.\n  if entry_user_idx < 0 && !library_mode && entry_name != \"__no_entry__\" {\n    throw(\"entry `\\{entry_name}` not found: no exported function named `\\{entry_name}` (use __no_entry__ to build a test runner)\")\n  }\n  let str_strs = collect_strings_stmts(stmts)\n  let rec add_map_keys_expr: (Expr) -> Unit = (e) -> {\n    match e {\n      EMap(fields) => {\n        let mut mi = 0\n        while mi < Array::length(fields) {\n          let (key, val) = Array::get(fields, mi)\n          if !array_contains_str(str_strs, key) {\n            Array::push(str_strs, key)\n          }\n          add_map_keys_expr(val)\n          mi = mi + 1\n        }\n      },\n      EStringInterp(parts) => {\n        let mut pi3 = 0\n        while pi3 < Array::length(parts) {\n          if pi3 % 2 == 0 {\n            let part = Array::get(parts, pi3)\n            if String::length(part) > 0 && !array_contains_str(str_strs, part) {\n              Array::push(str_strs, part)\n            }\n          }\n          pi3 = pi3 + 1\n        }\n      },\n      ELet(_, val, body, _) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ELetMut(_, val, body, _) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ELetRec(_, val, body) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ESeq(a, b) => {\n        add_map_keys_expr(a); add_map_keys_expr(b)\n      },\n      EIf(c, t, e) => {\n        add_map_keys_expr(c); add_map_keys_expr(t); add_map_keys_expr(e)\n      },\n      EFn(_, _, _, _, _, body) => add_map_keys_expr(body),\n      EHandle(body, _) => add_map_keys_expr(body),\n      ECall(callee, args, _) => {\n        add_map_keys_expr(callee)\n        let mut ai = 0\n        while ai < Array::length(args) {\n          add_map_keys_expr(Array::get(args, ai))\n          ai = ai + 1\n        }\n      },\n      _ => ()\n    }\n  }\n  let mut __mk = 0\n  while __mk < Array::length(stmts) {\n    match Array::get(stmts, __mk) {\n      SLet(_, _, _, _, expr) => add_map_keys_expr(expr),\n      STest(_, expr) => add_map_keys_expr(expr),\n      SBench(_, expr) => add_map_keys_expr(expr),\n      _ => ()\n    }\n    __mk = __mk + 1\n  }\n  // Always seed the empty string so codegen that materialises \"\" (e.g.\n  // StringBuilder::freeze's join separator, Stream::to_string's accumulator)\n  // can rely on str_table_lookup(\"\") succeeding even when the source never\n  // mentions \"\" literally.\n  if !array_contains_str(str_strs, \"\") {\n    Array::push(str_strs, \"\")\n  }\n  let src_str_base = Array::length(str_strs)\n  let num_src_pairs = Array::length(srcs)\n  let mut __src_i = 0\n  while __src_i < num_src_pairs {\n    let (__src_path, __src_content) = Array::get(srcs, __src_i)\n    Array::push(str_strs, __src_path)\n    Array::push(str_strs, __src_content)\n    __src_i = __src_i + 1\n  }\n  let num_strings = Array::length(str_strs)\n  let data_base = 64\n  let str_offsets = lc_fresh_int_array()\n  let str_lengths = lc_fresh_int_array()\n  let mut str_pos = data_base\n  let mut si = 0\n  while si < num_strings {\n    let s = Array::get(str_strs, si)\n    let slen = String::length(s)\n    Array::push(str_offsets, str_pos)\n    Array::push(str_lengths, slen)\n    str_pos = str_pos + slen\n    si = si + 1\n  }\n  let heap_start = ((str_pos + 7) / 8) * 8\n  let effect_names_list = lc_fresh_string_array()\n  let effect_op_keys_list = lc_fresh_string_array()\n  let effect_op_arities_list = array_empty()\n  let mut eff_collect_i = 0\n  while eff_collect_i < Array::length(stmts) {\n    match Array::get(stmts, eff_collect_i) {\n      SEffectDef(_, eff_name, _, ops) => {\n        if eff_name != \"Error\" && !array_contains_str(effect_names_list, eff_name) {\n          Array::push(effect_names_list, eff_name)\n        } else {\n          ()\n        }\n        let mut op_i = 0\n        while op_i < Array::length(ops) {\n          let (op_name, op_params, _) = Array::get(ops, op_i)\n          Array::push(effect_op_keys_list, String::concat(String::concat(eff_name, \"::\"), op_name))\n          Array::push(effect_op_arities_list, Array::length(op_params))\n          op_i = op_i + 1\n        }\n      },\n      _ => ()\n    }\n    eff_collect_i = eff_collect_i + 1\n  }\n  // Per-effect region stride (#553). Each effect tag gets a reserved region\n  // below the heap frontier holding the replay-handler control words (+0\n  // perform counter, +8 resume-memo count) and the resume-memo array (+16 +\n  // k*8). The replay model stores one i64 per `perform` resolved within a\n  // `handle`, so the region is O(performs). At 8192 B (1022 entries) a loop\n  // performing more than ~1022-2046 times overflowed the region into the live\n  // heap, where the growing memo chased and clobbered the reused payload-tuple\n  // free block (~8 B/iter past the threshold, ADR-0055). 131072 B (16382\n  // entries) covers the full verify regime (N2=11000) with headroom; programs\n  // performing more than ~16K times within one handle still spill (a hard\n  // bound of the replay-based handler — unbounded performs need a\n  // continuation-based handler). MUST stay in sync with the `* 131072` strides\n  // in compile_call.vibe (perform) and compile_expr_tail6.vibe (handler arm).\n  let eff_reserve = (Array::length(effect_names_list) + 1) * 131072\n  // Function-level coverage (gated by `coverage`): a 1-byte-per-user-function\n  // hit bitmap placed in a dedicated reserve ABOVE the effect regions and BELOW\n  // the heap frontier, so it never collides with effect words or the live heap.\n  // `cov_base` is a compile-time-constant address baked into each function's\n  // prologue store. When coverage is off, cov_reserve is 0 and codegen output is\n  // byte-identical to the normal build (the self-host fixpoint is unaffected).\n  let cov_count = num_user_funcs\n  let cov_base = heap_start + eff_reserve\n  let cov_reserve = if coverage {\n    ((cov_count + 7) / 8) * 8\n  } else {\n    0\n  }\n  // #cov branch coverage: a second 1-byte-per-branch hit region directly above\n  // the function-hit region. Branch ids are assigned sequentially during codegen\n  // (CovState.next), so the count is not known up front — reserve a fixed cap.\n  // 65536 branches is generous headroom (the whole compiler has a few thousand).\n  // Off => branch_reserve is 0 and the layout/codegen is byte-identical.\n  let cov_branch_cap = 65536\n  let cov_branch_base = cov_base + cov_reserve\n  let cov_branch_reserve = if coverage {\n    cov_branch_cap\n  } else {\n    0\n  }\n  // Function-call execution trace (debugger / DAP P1 groundwork, gated by\n  // `debug_trace`). A dedicated region directly above the coverage regions and\n  // below the heap frontier holds a 4-byte counter cell followed by a fixed-cap\n  // log of i32 slots. Each user function's entry, in debug mode, appends its\n  // own user index to the log (counter-bounded). A `vibe.trace` custom section\n  // records the layout + function names so the runner can dump the entry\n  // sequence. Off => trace_reserve is 0 and the layout/codegen is byte-identical\n  // to a normal build (the self-host fixpoint is unaffected).\n  let trace_cap = 4096\n  let trace_counter_addr = cov_branch_base + cov_branch_reserve\n  let trace_log_base = trace_counter_addr + 4\n  let trace_reserve = if debug_trace {\n    4 + trace_cap * 4\n  } else {\n    0\n  }\n  // debugger argument inspection (DAP P2, gated by `debug_break`). A dedicated\n  // region directly above the trace region holds a 4-byte count cell followed by\n  // a fixed-cap array of i64 slots. At each user function entry, in break mode,\n  // the function's i64 parameters are spilled here (capped at dbgargs_cap) and\n  // the count cell is set, BEFORE calling the `vibe::dbg_break` host hook. The\n  // hook reads them out of guest memory and prints `args: [...]`. A\n  // `vibe.dbgargs` custom section publishes the two addresses to the runner.\n  // Off => dbgargs_reserve is 0 and the layout/codegen is byte-identical to a\n  // normal build (the self-host fixpoint is unaffected).\n  let dbgargs_cap = 16\n  let dbgargs_count_addr = trace_counter_addr + trace_reserve\n  let dbgargs_base = dbgargs_count_addr + 8\n  let dbgargs_reserve = if debug_break {\n    8 + dbgargs_cap * 8\n  } else {\n    0\n  }\n  let cov_state = CovState::{\n    enabled: coverage,\n    base: cov_branch_base,\n    cap: cov_branch_cap,\n    next: [\n      0\n    ],\n    cur_fn: [\n      0\n    ],\n    owners: ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  // #799 perf: ONE program walk collecting the canonical free-name set,\n  // then every need_<builtin> flag below is a map lookup. Previously each\n  // flag re-walked the whole AST (~40 walks) with a linear fn_names scan per\n  // ident inside.\n  let used_builtin_names = collect_used_builtin_names(stmts, fn_names_list)\n  let need_env_get_builtin = Map::has_key(used_builtin_names, \"Env::get\")\n  let need_env_args_len_builtin = Map::has_key(used_builtin_names, \"Env::args_len\")\n  let need_env_args_get_builtin = Map::has_key(used_builtin_names, \"Env::args_get\")\n  let need_fs_read_file_builtin = Map::has_key(used_builtin_names, \"Fs::read_file\")\n  let need_fs_exists_builtin = Map::has_key(used_builtin_names, \"Fs::exists\")\n  // #795: vibe_fs_stat_token_raw is the alias-collision-proof surface for the\n  // same import (lib/@vibe/fs/fs.vibe calls it; see checker/builtins_fs.vibe).\n  let need_fs_stat_token_builtin = Map::has_key(used_builtin_names, \"Fs::stat_token\") || Map::has_key(used_builtin_names, \"vibe_fs_stat_token_raw\")\n  let need_fs_write_file_builtin = Map::has_key(used_builtin_names, \"Fs::write_file\")\n  let need_fs_write_bytes_builtin = Map::has_key(used_builtin_names, \"Fs::write_bytes\")\n  // #632: `Fs::read_bytes(path) -> Bytes` — the binary-exact read counterpart of\n  // Fs::write_bytes, a `vibe.fs_read_bytes (i64) -> i64` host import (type 3,\n  // same shape as fs_read_file). Gated on use so non-users reserve no import\n  // (fixpoint-safe). Lets the persistent artifact cache store/load wasm raw.\n  let need_fs_read_bytes_builtin = Map::has_key(used_builtin_names, \"Fs::read_bytes\")\n  // #729/#730: `Fs::readdir(path) -> Array[String]` — a `vibe.fs_read_dir\n  // (i64) -> i64` host import (type 3, same packed-string shape as\n  // fs_read_file: the host returns the byte-sorted entry NAMES \"\\n\"-joined as\n  // ONE string, no host-side array building). compile_call lowers the\n  // Array[String] surface to `String::split` over that string. Gated on use\n  // (fixpoint-safe). Unblocks contract-package sibling auto-discovery and the\n  // global store walk.\n  let need_fs_readdir_builtin = Map::has_key(used_builtin_names, \"Fs::readdir\")\n  let need_profiler_now_us_builtin = Map::has_key(used_builtin_names, \"Profiler::now_us\")\n  // `Profiler::heap_bytes() -> Int`: a `vibe.profile-heap-bytes () -> i64`\n  // host import (type 5, same shape as profile-now-us). Returns the guest's\n  // current bump-heap pointer (`__heap_ptr`) so vibe code can attribute its\n  // own allocation growth per phase, mirroring how now_us attributes time.\n  // Gated on use so non-users reserve no import (fixpoint-safe).\n  let need_profiler_heap_bytes_builtin = Map::has_key(used_builtin_names, \"Profiler::heap_bytes\")\n  // `sleep(ms)` (Async): a `vibe.sleep (i64) -> ()` host import. The host\n  // implements it as an async function so the guest fiber genuinely\n  // suspends/resumes (docs/spec/wasi-p3-async.md §2.3, examples/async_host).\n  // Gated on use, so programs without `sleep` reserve no import (fixpoint-safe).\n  let need_sleep_builtin = Map::has_key(used_builtin_names, \"sleep\")\n  // `Stdin::read_char() -> Int`: a value-returning `vibe.stdin_read_char () ->\n  // i64` host import. Implemented async by the host (it can suspend the guest\n  // until a char is available), so this is the data-consuming analog of `sleep`\n  // — the shape of a host async source (HTTP body byte, stdin char). Gated on\n  // use (fixpoint-safe).\n  let need_stdin_read_char_builtin = Map::has_key(used_builtin_names, \"Stdin::read_char\")\n  // Process effect host imports: `sh(cmd)` runs a shell command (returns 0) and\n  // `sh_lines(cmd)` returns its stdout \"\\n\"-joined as ONE string (same packed\n  // ABI as fs_read_dir; compile_call lowers the Array[String] surface to a\n  // String::split). Both `vibe.sh` / `vibe.sh_lines (i64) -> i64` host imports,\n  // gated on use so non-users reserve no import (fixpoint-safe). Revives the\n  // process/time/shell stdlib whose functions call these.\n  let need_sh_builtin = Map::has_key(used_builtin_names, \"sh\")\n  let need_sh_lines_builtin = Map::has_key(used_builtin_names, \"sh_lines\")\n  // #865: structured subprocess result host imports -- `vibe_sh_capture_raw`\n  // runs the command once (handle), the three accessors read the cached\n  // {exit_code, stdout, stderr}, `vibe_sh_capture_close_raw` frees it. Same\n  // handle+accessor shape as the #794 HTTP client imports below. Gated on\n  // use, same fixpoint-safety discipline as sh/sh_lines above.\n  let need_sh_capture_builtin = Map::has_key(used_builtin_names, \"vibe_sh_capture_raw\")\n  let need_sh_capture_exit_code_builtin = Map::has_key(used_builtin_names, \"vibe_sh_capture_exit_code_raw\")\n  let need_sh_capture_stdout_builtin = Map::has_key(used_builtin_names, \"vibe_sh_capture_stdout_raw\")\n  let need_sh_capture_stderr_builtin = Map::has_key(used_builtin_names, \"vibe_sh_capture_stderr_raw\")\n  let need_sh_capture_close_builtin = Map::has_key(used_builtin_names, \"vibe_sh_capture_close_raw\")\n  // #903/#865: `Process::exit(code) -> Unit` -- propagates the guest's exit\n  // code to the real OS process exit status via the host runner's\n  // exit-trap mechanism (never returns in practice, but is typed Unit --\n  // there's no `Never` type). `vibe.process_exit (i64) -> ()` host import,\n  // void like Fs::remove/sh_capture_close, gated on use (fixpoint-safe).\n  let need_process_exit_builtin = Map::has_key(used_builtin_names, \"vibe_process_exit_raw\")\n  // Stdin/Stdout host effects for vibe/io: `Stdin::read_stream(n) -> String`\n  // (`vibe.stdin_read_stream (i64) -> i64`, value-returning like fs_read_file),\n  // `Stdout::write_stream(s) -> Unit` and `Stdout::write_char(c) -> Unit`\n  // (`vibe.stdout_write_stream` / `vibe.stdout_write_char (i64) -> ()`, void like\n  // sleep). All gated on use so non-users reserve no import (fixpoint-safe) —\n  // the compiler's own build uses none, so its bytes are unchanged. Revives the\n  // io stdlib whose read/print/println/write_char helpers call these builtins.\n  let need_stdin_read_stream_builtin = Map::has_key(used_builtin_names, \"Stdin::read_stream\")\n  // #929: the println/print BUILTIN lowering (compile_call.vibe) synthesizes\n  // calls onto these two imports when no source-provided println/print is\n  // merged, so their use also gates the imports in. collect_used_builtin_names\n  // only counts FREE names -- a program using @vibe/io's (or its own) println\n  // fn does not trip this, exactly matching the lowering's cc_ft_has guard.\n  let used_print_builtin = Map::has_key(used_builtin_names, \"println\") || Map::has_key(used_builtin_names, \"print\")\n  let need_stdout_write_stream_builtin = Map::has_key(used_builtin_names, \"Stdout::write_stream\") || used_print_builtin\n  let need_stdout_write_char_builtin = Map::has_key(used_builtin_names, \"Stdout::write_char\") || used_print_builtin\n  // #865: `Stderr::write_stream(s) -> Unit` / `Stderr::write_char(c) -> Unit`\n  // (`vibe.stderr_write_stream` / `vibe.stderr_write_char (i64) -> ()`, void\n  // like stdout's), same shapes/gating as the Stdout pair above.\n  let need_stderr_write_stream_builtin = Map::has_key(used_builtin_names, \"Stderr::write_stream\")\n  let need_stderr_write_char_builtin = Map::has_key(used_builtin_names, \"Stderr::write_char\")\n  // #762: `Path::ref` / `Path::resolve` both lower (compile_call) to the\n  // `resolve_path` host import — resolve a path to absolute against the process\n  // CWD. `vibe.resolve_path (i64) -> i64`, value-returning like fs_read_file,\n  // gated on either surface name so non-users reserve no import (fixpoint-safe).\n  let need_resolve_path_builtin = Map::has_key(used_builtin_names, \"Path::ref\") || Map::has_key(used_builtin_names, \"Path::resolve\")\n  // #768: `Fs::remove(path) -> Unit` — a `vibe.fs_remove (i64) -> ()` host\n  // import (type 1, like sleep/stdout_write_char). Checker-recognized since\n  // `builtins_fs.vibe`'s `lookup_fs_remove` but never wired to codegen, so any\n  // caller hit \"undefined variable (local): Fs::remove @call\". Gated on use so\n  // non-users reserve no import (fixpoint-safe).\n  let need_fs_remove_builtin = Map::has_key(used_builtin_names, \"Fs::remove\")\n  // #768: `Fs::mkdir_p(path) -> Unit` (recursive mkdir) — same shape/import\n  // type as Fs::remove. Same gap: checker-recognized (builtins_fs.vibe's\n  // lookup_fs_mkdir_p) but had no codegen wiring at all.\n  let need_fs_mkdir_p_builtin = Map::has_key(used_builtin_names, \"Fs::mkdir_p\")\n  // #768: the rest of lib/@vibe/shell/commands.vibe's Fs surface — same\n  // \"checker-legal (or newly made so), zero codegen wiring\" gap as\n  // Fs::remove/Fs::mkdir_p, and the JS host runner already implements all of\n  // fs_mkdir/fs_chdir/fs_copy/fs_append/fs_rename/fs_is_dir/fs_is_file/\n  // fs_getcwd. Fs::mkdir (non-recursive, distinct from Fs::mkdir_p) was\n  // likewise checker-legal but had no codegen wiring at all.\n  let need_fs_mkdir_builtin = Map::has_key(used_builtin_names, \"Fs::mkdir\")\n  let need_fs_chdir_builtin = Map::has_key(used_builtin_names, \"Fs::chdir\")\n  let need_fs_copy_builtin = Map::has_key(used_builtin_names, \"Fs::copy\")\n  let need_fs_append_builtin = Map::has_key(used_builtin_names, \"Fs::append\")\n  let need_fs_rename_builtin = Map::has_key(used_builtin_names, \"Fs::rename\")\n  let need_fs_is_dir_builtin = Map::has_key(used_builtin_names, \"Fs::is_dir\")\n  let need_fs_is_file_builtin = Map::has_key(used_builtin_names, \"Fs::is_file\")\n  let need_fs_getcwd_builtin = Map::has_key(used_builtin_names, \"Fs::getcwd\")\n  // #794: HTTP client host imports. lib/@vibe/http's client functions call\n  // the `__http_*_raw` builtins (dunder names so units bundling the package's\n  // index.vibe -- which exports alias functions literally named\n  // `Http::request` etc. -- cannot capture the ident, see #795). Each lowers\n  // to a `vibe.http_*` host import, gated on use (fixpoint-safe: the compiler\n  // itself uses none, so its bytes are unchanged).\n  let need_http_request_builtin = Map::has_key(used_builtin_names, \"vibe_http_request_raw\")\n  let need_http_response_status_builtin = Map::has_key(used_builtin_names, \"vibe_http_response_status_raw\")\n  let need_http_response_header_builtin = Map::has_key(used_builtin_names, \"vibe_http_response_header_raw\")\n  let need_http_response_body_builtin = Map::has_key(used_builtin_names, \"vibe_http_response_body_raw\")\n  let need_http_close_builtin = Map::has_key(used_builtin_names, \"vibe_http_close_raw\")\n  let mut next_import_idx = 1\n  let env_get_import_idx = if need_env_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_len_import_idx = if need_env_args_len_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_get_import_idx = if need_env_args_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_read_file_import_idx = if need_fs_read_file_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_exists_import_idx = if need_fs_exists_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_stat_token_import_idx = if need_fs_stat_token_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_write_file_import_idx = if need_fs_write_file_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_write_bytes_import_idx = if need_fs_write_bytes_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #632: reserved immediately after fs_write_bytes; the import emission below\n  // must stay in this same order so the index matches the descriptor.\n  let fs_read_bytes_import_idx = if need_fs_read_bytes_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #729/#730: reserved immediately after fs_read_bytes; the import emission\n  // below must stay in this same order so the index matches the descriptor.\n  let fs_read_dir_import_idx = if need_fs_readdir_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let profiler_now_us_import_idx = if need_profiler_now_us_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // reserved immediately after profile-now-us; the import emission below must\n  // stay in this same order so the index matches the descriptor.\n  let profiler_heap_bytes_import_idx = if need_profiler_heap_bytes_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let sleep_import_idx = if need_sleep_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let stdin_read_char_import_idx = if need_stdin_read_char_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // reserved immediately after stdin_read_char; the import emission below must\n  // stay in this same order so the index matches the descriptor.\n  let sh_import_idx = if need_sh_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let sh_lines_import_idx = if need_sh_lines_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // reserved immediately after sh_lines; the import emission below must stay in\n  // this same order so the index matches the descriptor.\n  let stdin_read_stream_import_idx = if need_stdin_read_stream_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let stdout_write_stream_import_idx = if need_stdout_write_stream_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let stdout_write_char_import_idx = if need_stdout_write_char_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // reserved immediately after stdout_write_char; the import emission below must\n  // stay in this same order so the index matches the descriptor.\n  let resolve_path_import_idx = if need_resolve_path_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #768: reserved immediately after resolve_path; the import emission below\n  // must stay in this same order so the index matches the descriptor.\n  let fs_remove_import_idx = if need_fs_remove_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #768: reserved immediately after fs_remove; the import emission below must\n  // stay in this same order so the index matches the descriptor.\n  let fs_mkdir_p_import_idx = if need_fs_mkdir_p_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #768: reserved immediately after fs_mkdir_p, in this fixed order; the\n  // import emission below must match.\n  let fs_mkdir_import_idx = if need_fs_mkdir_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_chdir_import_idx = if need_fs_chdir_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_copy_import_idx = if need_fs_copy_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_append_import_idx = if need_fs_append_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_rename_import_idx = if need_fs_rename_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_is_dir_import_idx = if need_fs_is_dir_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_is_file_import_idx = if need_fs_is_file_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_getcwd_import_idx = if need_fs_getcwd_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #794: HTTP client imports -- reserved after fs_getcwd (before dbg_break),\n  // in the same order as their emission below.\n  let http_request_import_idx = if need_http_request_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let http_response_status_import_idx = if need_http_response_status_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let http_response_header_import_idx = if need_http_response_header_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let http_response_body_import_idx = if need_http_response_body_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let http_close_import_idx = if need_http_close_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #865: `Process::capture` host imports -- reserved after http_close\n  // (before dbg_break), in the same order as their emission below. All five\n  // reuse EXISTING base func types (3 = `(i64)->i64`, 1 = `(i64)->()`), so no\n  // new type-section entry is needed (unlike #794's http_request).\n  let sh_capture_import_idx = if need_sh_capture_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let sh_capture_exit_code_import_idx = if need_sh_capture_exit_code_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let sh_capture_stdout_import_idx = if need_sh_capture_stdout_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let sh_capture_stderr_import_idx = if need_sh_capture_stderr_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let sh_capture_close_import_idx = if need_sh_capture_close_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #903/#865: `Process::exit(code)` host import -- void like Fs::remove\n  // (type 1), reserved after sh_capture_close, before Stderr.\n  let process_exit_import_idx = if need_process_exit_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #865: `Stderr::write_stream` / `Stderr::write_char` host imports --\n  // reserved after sh_capture_close (before dbg_break), same shapes as the\n  // Stdout pair (type 3 value-returning is N/A here; both are void type 1).\n  let stderr_write_stream_import_idx = if need_stderr_write_stream_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let stderr_write_char_import_idx = if need_stderr_write_char_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // debugger breakpoint (DAP P1): in break mode emit a conditional `vibe::dbg_break`\n  // host import (() -> ()) called at each user-function entry. Default OFF, so\n  // num_imported_funcs / func_offset are unchanged for normal builds (fixpoint).\n  let dbg_break_import_idx = if debug_break {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // Interior-line breakpoints (span-arc step5): in break mode with per-file\n  // provenance, reserve a `vibe::dbg_line (i32 file_id, i32 line) -> ()` host\n  // import called at each statement boundary. Each function's line is mapped\n  // against ITS OWN source file (prov.file_nls[file_id]) so multi-file entries\n  // work. Gated on `debug_break && prov has files`, so default builds reserve\n  // nothing and stay byte-identical.\n  let dbg_line_on = debug_break && Array::length(prov.files) > 0\n  let dbg_line_import_idx = if dbg_line_on {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let linked_import_indices = lc_fresh_int_array()\n  let linked_import_names = lc_fresh_string_array()\n  let mut li_i = 0\n  while li_i < Array::length(linked_imports) {\n    let (_, lfn_name, _, _) = Array::get(linked_imports, li_i)\n    Array::push(linked_import_indices, next_import_idx)\n    Array::push(linked_import_names, lfn_name)\n    next_import_idx = next_import_idx + 1\n    li_i = li_i + 1\n  }\n  let num_imported_funcs = next_import_idx\n  let print_int_idx = num_imported_funcs\n  let print_str_idx = print_int_idx + 1\n  let str_len_idx = print_str_idx + 1\n  let str_eq_idx = str_len_idx + 1\n  let str_concat_idx = str_eq_idx + 1\n  let arr_new_idx = str_concat_idx + 1\n  let arr_len_idx = arr_new_idx + 1\n  let arr_get_idx = arr_len_idx + 1\n  let arr_push_idx = arr_get_idx + 1\n  let arr_set_idx = arr_push_idx + 1\n  let double_to_int_idx = arr_set_idx + 1\n  let int_to_double_idx = double_to_int_idx + 1\n  let str_char_code_at_idx = int_to_double_idx + 1\n  let str_from_char_code_idx = str_char_code_at_idx + 1\n  let str_substring_idx = str_from_char_code_idx + 1\n  let identity_idx = str_substring_idx + 1\n  let arr_slice_idx = identity_idx + 1\n  let arr_concat_idx = arr_slice_idx + 1\n  let arr_truncate_idx = arr_concat_idx + 1\n  let string_join_idx = arr_truncate_idx + 1\n  let fs_read_file_stub_idx = string_join_idx + 1\n  let fs_exists_stub_idx = fs_read_file_stub_idx + 1\n  let fs_stat_token_stub_idx = fs_exists_stub_idx + 1\n  let fs_write_file_stub_idx = fs_stat_token_stub_idx + 1\n  let fs_write_bytes_stub_idx = fs_write_file_stub_idx + 1\n  let eq_idx = fs_write_bytes_stub_idx + 1\n  let string_ends_with_idx = eq_idx + 1\n  let string_last_index_of_idx = string_ends_with_idx + 1\n  let arr_push_all_idx = string_last_index_of_idx + 1\n  let string_index_of_idx = arr_push_all_idx + 1\n  let string_contains_idx = string_index_of_idx + 1\n  let string_starts_with_idx = string_contains_idx + 1\n  let string_split_idx = string_starts_with_idx + 1\n  let string_trim_idx = string_split_idx + 1\n  let sources_idx = string_trim_idx + 1\n  let bytes_new_idx = sources_idx + 1\n  let bytes_len_idx = bytes_new_idx + 1\n  let bytes_get_idx = bytes_len_idx + 1\n  let bytes_set_idx = bytes_get_idx + 1\n  let bytes_push_idx = bytes_set_idx + 1\n  let bytes_append_idx = bytes_push_idx + 1\n  let bytes_concat_idx = bytes_append_idx + 1\n  let bytes_slice_idx = bytes_concat_idx + 1\n  let bytes_from_array_idx = bytes_slice_idx + 1\n  let bytes_to_array_idx = bytes_from_array_idx + 1\n  let rc_drop_idx = bytes_to_array_idx + 1\n  let rc_alloc_idx = rc_drop_idx + 1\n  let heap_grow_check_idx = if enable_rc {\n    rc_alloc_idx + 1\n  } else {\n    bytes_to_array_idx + 1\n  }\n  let simd_skip_ws_idx = heap_grow_check_idx + 1\n  let simd_scan_alnum_idx = simd_skip_ws_idx + 1\n  let simd_scan_alnum_str_idx = simd_scan_alnum_idx + 1\n  let str_lex_diff_idx = simd_scan_alnum_str_idx + 1\n  // #973: erased-generic `[T: Ord]`/`[T: Add]` runtime dispatch (see the doc\n  // comment on gen_generic_rel_diff_body). Linear lane only -- desugar_trait_dicts\n  // is only invoked from this file, so no gc-lane index is needed.\n  let generic_rel_diff_idx = str_lex_diff_idx + 1\n  let generic_add_idx = generic_rel_diff_idx + 1\n  let env_get_idx = if env_get_import_idx >= 0 {\n    env_get_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let env_args_len_idx = if env_args_len_import_idx >= 0 {\n    env_args_len_import_idx\n  } else {\n    fs_exists_stub_idx\n  }\n  let env_args_get_idx = if env_args_get_import_idx >= 0 {\n    env_args_get_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let fs_read_file_idx = if fs_read_file_import_idx >= 0 {\n    fs_read_file_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let fs_exists_idx = if fs_exists_import_idx >= 0 {\n    fs_exists_import_idx\n  } else {\n    fs_exists_stub_idx\n  }\n  let fs_stat_token_idx = if fs_stat_token_import_idx >= 0 {\n    fs_stat_token_import_idx\n  } else {\n    fs_stat_token_stub_idx\n  }\n  let fs_write_file_idx = if fs_write_file_import_idx >= 0 {\n    fs_write_file_import_idx\n  } else {\n    fs_write_file_stub_idx\n  }\n  let fs_write_bytes_idx = if fs_write_bytes_import_idx >= 0 {\n    fs_write_bytes_import_idx\n  } else {\n    fs_write_bytes_stub_idx\n  }\n  // #632: no dedicated stub — when read_bytes is unused the builtin index just\n  // needs SOME valid never-called slot, so reuse the fs_read_file stub (a\n  // `(i64)->i64` placeholder). The real call site only exists when the import is\n  // reserved.\n  let fs_read_bytes_idx = if fs_read_bytes_import_idx >= 0 {\n    fs_read_bytes_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  // #729/#730: like read_bytes, no dedicated stub — unused readdir reuses the\n  // fs_read_file stub (a `(i64)->i64` never-called placeholder).\n  let fs_read_dir_idx = if fs_read_dir_import_idx >= 0 {\n    fs_read_dir_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let profiler_now_us_idx = if profiler_now_us_import_idx >= 0 {\n    profiler_now_us_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // Profiler::heap_bytes call target: the import when reserved, else a\n  // never-called `() -> i64` stub (mirrors now_us's fallback).\n  let profiler_heap_bytes_idx = if profiler_heap_bytes_import_idx >= 0 {\n    profiler_heap_bytes_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // `sleep` call target: the import when reserved, else a never-called stub\n  // (the builtin is only emitted as a call when the program uses `sleep`, which\n  // is exactly when the import is reserved).\n  let sleep_idx = if sleep_import_idx >= 0 {\n    sleep_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let stdin_read_char_idx = if stdin_read_char_import_idx >= 0 {\n    stdin_read_char_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // sh / sh_lines call targets: the import when reserved, else the fs_read_file\n  // stub (a `(i64)->i64` never-called placeholder) — the real call site only\n  // exists when the import is reserved (i.e. when the program uses sh/sh_lines).\n  let sh_idx = if sh_import_idx >= 0 {\n    sh_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let sh_lines_idx = if sh_lines_import_idx >= 0 {\n    sh_lines_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  // Stdin::read_stream / Stdout::write_stream / Stdout::write_char call targets:\n  // the import when reserved, else a never-called stub (read_stream is\n  // value-returning like sh -> fs_read_file stub; the void write ops mirror\n  // sleep's fallback to env_args_len). The real call site only exists when the\n  // matching import is reserved (i.e. when the program uses io).\n  let stdin_read_stream_idx = if stdin_read_stream_import_idx >= 0 {\n    stdin_read_stream_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let stdout_write_stream_idx = if stdout_write_stream_import_idx >= 0 {\n    stdout_write_stream_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let stdout_write_char_idx = if stdout_write_char_import_idx >= 0 {\n    stdout_write_char_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // resolve_path call target: the import when reserved, else the fs_read_file\n  // stub (a `(i64)->i64` never-called placeholder — same shape).\n  let resolve_path_idx = if resolve_path_import_idx >= 0 {\n    resolve_path_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  // #768: Fs::remove call target — the import when reserved, else a\n  // never-called stub (void return, so mirrors sleep_idx/stdout_write_char_idx's\n  // fallback to env_args_len_idx).\n  let fs_remove_idx = if fs_remove_import_idx >= 0 {\n    fs_remove_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // #768: Fs::mkdir_p call target — same fallback shape as fs_remove_idx.\n  let fs_mkdir_p_idx = if fs_mkdir_p_import_idx >= 0 {\n    fs_mkdir_p_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // #768: void Fs ops (mkdir/chdir/copy/append/rename) — same fallback shape\n  // as fs_remove_idx/fs_mkdir_p_idx.\n  let fs_mkdir_idx = if fs_mkdir_import_idx >= 0 {\n    fs_mkdir_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let fs_chdir_idx = if fs_chdir_import_idx >= 0 {\n    fs_chdir_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let fs_copy_idx = if fs_copy_import_idx >= 0 {\n    fs_copy_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let fs_append_idx = if fs_append_import_idx >= 0 {\n    fs_append_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let fs_rename_idx = if fs_rename_import_idx >= 0 {\n    fs_rename_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // #768: value-returning Fs ops (is_dir/is_file bool, getcwd string) —\n  // fallback to the fs_read_file stub (an `(i64)->i64`-shaped never-called\n  // placeholder), same as other value-returning fallbacks above.\n  let fs_is_dir_idx = if fs_is_dir_import_idx >= 0 {\n    fs_is_dir_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let fs_is_file_idx = if fs_is_file_import_idx >= 0 {\n    fs_is_file_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let fs_getcwd_idx = if fs_getcwd_import_idx >= 0 {\n    fs_getcwd_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // #794: never-called placeholders when unused, like the Fs fallbacks above.\n  let http_request_idx = if http_request_import_idx >= 0 {\n    http_request_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let http_response_status_idx = if http_response_status_import_idx >= 0 {\n    http_response_status_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let http_response_header_idx = if http_response_header_import_idx >= 0 {\n    http_response_header_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let http_response_body_idx = if http_response_body_import_idx >= 0 {\n    http_response_body_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let http_close_idx = if http_close_import_idx >= 0 {\n    http_close_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  // #865: never-called placeholders when unused, like the http fallbacks\n  // above. The four value-returning ops fall back to the fs_read_file stub\n  // (a `(i64)->i64` never-called placeholder); the void close op falls back\n  // to env_args_len_idx, mirroring fs_remove_idx/http_close_idx's own choice.\n  let sh_capture_idx = if sh_capture_import_idx >= 0 {\n    sh_capture_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let sh_capture_exit_code_idx = if sh_capture_exit_code_import_idx >= 0 {\n    sh_capture_exit_code_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let sh_capture_stdout_idx = if sh_capture_stdout_import_idx >= 0 {\n    sh_capture_stdout_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let sh_capture_stderr_idx = if sh_capture_stderr_import_idx >= 0 {\n    sh_capture_stderr_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let sh_capture_close_idx = if sh_capture_close_import_idx >= 0 {\n    sh_capture_close_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // #903/#865: Process::exit call target -- void op, same fallback shape as\n  // fs_remove_idx/sh_capture_close_idx.\n  let process_exit_idx = if process_exit_import_idx >= 0 {\n    process_exit_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // #865: Stderr::write_stream / Stderr::write_char call targets -- void ops,\n  // same fallback shape as stdout_write_stream_idx/stdout_write_char_idx.\n  let stderr_write_stream_idx = if stderr_write_stream_import_idx >= 0 {\n    stderr_write_stream_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let stderr_write_char_idx = if stderr_write_char_import_idx >= 0 {\n    stderr_write_char_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let max_builtin_func_idx = generic_add_idx\n  let num_generated = (max_builtin_func_idx - num_imported_funcs) + 1\n  let func_offset = num_imported_funcs + num_generated\n  let fn_indices_list = lc_fresh_int_array()\n  let fn_returns_list = lc_fresh_int_array()\n  let mut fi = 0\n  while fi < num_user_funcs {\n    Array::push(fn_indices_list, fi + func_offset)\n    Array::push(fn_returns_list, 1)\n    fi = fi + 1\n  }\n  let builtin_names_list = lc_fresh_string_array()\n  let builtin_param_counts = lc_fresh_int_array()\n  let builtin_needs_env_list = lc_fresh_bool_array()\n  let builtin_indices_list = lc_fresh_int_array()\n  let builtin_returns_list = lc_fresh_int_array()\n  // #415 B-1: the central registry DRIVES the linear lane's registration.\n  // Names, param counts, and returns come straight from builtin_registry()\n  // rows with in_linear = true; only the function INDEX is lane-local (the\n  // idx bindings computed above), resolved by the match below. Adding a\n  // linear builtin = one registry row + one match arm here (+ the import /\n  // body wiring); param-count and returns live ONLY in the registry.\n  // needs_env is false for every static builtin -- only the linked-import\n  // bridges appended after verify carry an env. vibe_rc_drop/vibe_rc_alloc\n  // register under RC builds only (mirrored by verify_lane_builtins'\n  // vibe_rc_ exemption).\n  let registry_rows = builtin_registry()\n  let mut reg_i = 0\n  while reg_i < Array::length(registry_rows) {\n    let (reg_name, reg_params, reg_returns, reg_linear, _) = Array::get(registry_rows, reg_i)\n    let reg_include = reg_linear && (enable_rc || !String::starts_with(reg_name, \"vibe_rc_\"))\n    if reg_include {\n      let reg_idx = match reg_name {\n        \"Env::get\" => env_get_idx,\n        \"Env::args_len\" => env_args_len_idx,\n        \"Env::args_get\" => env_args_get_idx,\n        \"Fs::read_file\" => fs_read_file_idx,\n        \"Fs::exists\" => fs_exists_idx,\n        \"Fs::stat_token\" => fs_stat_token_idx,\n        // #795: alias-collision-proof name, same import index as Fs::stat_token.\n        \"vibe_fs_stat_token_raw\" => fs_stat_token_idx,\n        \"Fs::write_file\" => fs_write_file_idx,\n        \"Fs::write_bytes\" => fs_write_bytes_idx,\n        \"Fs::read_bytes\" => fs_read_bytes_idx,\n        // #729/#730: RAW half of Fs::readdir -- compile_call lowers the surface.\n        \"vibe_fs_read_dir_raw\" => fs_read_dir_idx,\n        \"Fs::remove\" => fs_remove_idx,\n        \"Fs::mkdir_p\" => fs_mkdir_p_idx,\n        \"Fs::mkdir\" => fs_mkdir_idx,\n        \"Fs::chdir\" => fs_chdir_idx,\n        \"Fs::copy\" => fs_copy_idx,\n        \"Fs::append\" => fs_append_idx,\n        \"Fs::rename\" => fs_rename_idx,\n        \"Fs::is_dir\" => fs_is_dir_idx,\n        \"Fs::is_file\" => fs_is_file_idx,\n        \"Fs::getcwd\" => fs_getcwd_idx,\n        // #794: HTTP client host ops (raw dunder surface names, see checker/builtins_net.vibe).\n        \"vibe_http_request_raw\" => http_request_idx,\n        \"vibe_http_response_status_raw\" => http_response_status_idx,\n        \"vibe_http_response_header_raw\" => http_response_header_idx,\n        \"vibe_http_response_body_raw\" => http_response_body_idx,\n        \"vibe_http_close_raw\" => http_close_idx,\n        \"sh\" => sh_idx,\n        // RAW half of sh_lines -- compile_call lowers the Array[String] surface.\n        \"vibe_sh_lines_raw\" => sh_lines_idx,\n        // #865: structured subprocess result (raw dunder names -- called\n        // directly from lib/@vibe/process/process.vibe, same convention as\n        // the vibe_http_*_raw names above).\n        \"vibe_sh_capture_raw\" => sh_capture_idx,\n        \"vibe_sh_capture_exit_code_raw\" => sh_capture_exit_code_idx,\n        \"vibe_sh_capture_stdout_raw\" => sh_capture_stdout_idx,\n        \"vibe_sh_capture_stderr_raw\" => sh_capture_stderr_idx,\n        \"vibe_sh_capture_close_raw\" => sh_capture_close_idx,\n        \"vibe_process_exit_raw\" => process_exit_idx,\n        \"Stdin::read_stream\" => stdin_read_stream_idx,\n        \"Stdout::write_stream\" => stdout_write_stream_idx,\n        \"Stdout::write_char\" => stdout_write_char_idx,\n        // #865: Stderr, same shapes as the Stdout pair above.\n        \"Stderr::write_stream\" => stderr_write_stream_idx,\n        \"Stderr::write_char\" => stderr_write_char_idx,\n        // #762: RAW host op behind Path::ref / Path::resolve.\n        \"resolve_path\" => resolve_path_idx,\n        \"Profiler::now_us\" => profiler_now_us_idx,\n        \"Profiler::NowUs\" => profiler_now_us_idx,\n        \"Profiler::heap_bytes\" => profiler_heap_bytes_idx,\n        \"Profiler::HeapBytes\" => profiler_heap_bytes_idx,\n        \"sleep\" => sleep_idx,\n        \"Stdin::read_char\" => stdin_read_char_idx,\n        \"simd_skip_ws\" => simd_skip_ws_idx,\n        \"simd_scan_alnum\" => simd_scan_alnum_idx,\n        \"simd_scan_alnum_str\" => simd_scan_alnum_str_idx,\n        // #746: backs String < > <= >= (desugar rewrites to str_lex_diff(a,b) <op> 0).\n        \"str_lex_diff\" => str_lex_diff_idx,\n        // #973: backs `<`/`>`/`<=`/`>=`/`+` on an erased `[T: Ord]`/`[T: Add]`\n        // generic operand (desugar_trait_dict.vibe rewrites the binop when the\n        // operand's static type is the bare unresolved type parameter).\n        \"__generic_rel_diff\" => generic_rel_diff_idx,\n        \"__generic_add\" => generic_add_idx,\n        \"print_int\" => print_int_idx,\n        \"print_str\" => print_str_idx,\n        \"String::length\" => str_len_idx,\n        \"String::equals\" => str_eq_idx,\n        \"String::concat\" => str_concat_idx,\n        \"array_new\" => arr_new_idx,\n        \"Array::length\" => arr_len_idx,\n        \"Array::get\" => arr_get_idx,\n        \"Array::push\" => arr_push_idx,\n        \"Array::push_all\" => arr_push_all_idx,\n        \"Array::set\" => arr_set_idx,\n        \"Double::to_int\" => double_to_int_idx,\n        \"Int::to_double\" => int_to_double_idx,\n        \"String::char_code_at\" => str_char_code_at_idx,\n        \"String::from_char_code\" => str_from_char_code_idx,\n        \"String::substring\" => str_substring_idx,\n        \"Array::truncate\" => arr_truncate_idx,\n        \"String::join\" => string_join_idx,\n        \"eq\" => eq_idx,\n        \"String::ends_with\" => string_ends_with_idx,\n        \"String::last_index_of\" => string_last_index_of_idx,\n        \"String::index_of\" => string_index_of_idx,\n        \"String::contains\" => string_contains_idx,\n        \"String::starts_with\" => string_starts_with_idx,\n        \"String::split\" => string_split_idx,\n        \"String::trim\" => string_trim_idx,\n        \"compiler_sources\" => sources_idx,\n        \"ArrayBuilder::new\" => arr_new_idx,\n        \"ArrayBuilder::push\" => arr_push_idx,\n        \"ArrayBuilder::freeze\" => identity_idx,\n        \"Array::slice\" => arr_slice_idx,\n        \"Array::concat\" => arr_concat_idx,\n        \"Bytes::new\" => bytes_new_idx,\n        \"Bytes::from_array\" => bytes_from_array_idx,\n        \"Bytes::to_array\" => bytes_to_array_idx,\n        \"Bytes::length\" => bytes_len_idx,\n        \"Bytes::get\" => bytes_get_idx,\n        \"Bytes::set\" => bytes_set_idx,\n        \"Bytes::push\" => bytes_push_idx,\n        \"Bytes::append\" => bytes_append_idx,\n        \"Bytes::concat\" => bytes_concat_idx,\n        \"Bytes::slice\" => bytes_slice_idx,\n        \"Double::to_i64_bits\" => identity_idx,\n        \"__to_string\" => identity_idx,\n        \"vibe_rc_drop\" => rc_drop_idx,\n        \"vibe_rc_alloc\" => rc_alloc_idx,\n        \"vibe_heap_grow_check\" => heap_grow_check_idx,\n        _ => 0 - 1\n      }\n      if reg_idx < 0 {\n        throw(\"builtin registry drift: no linear function-index mapping for builtin '\\{reg_name}' (add a match arm in linked_compile.vibe, #415)\")\n      } else {\n        ()\n      }\n      Array::push(builtin_names_list, reg_name)\n      Array::push(builtin_param_counts, reg_params)\n      Array::push(builtin_needs_env_list, false)\n      Array::push(builtin_indices_list, reg_idx)\n      Array::push(builtin_returns_list, reg_returns)\n    } else {\n      ()\n    }\n    reg_i = reg_i + 1\n  }\n  // #415 B-0: the static registration above must agree with the central\n  // registry (name set + params + returns, both directions). Placed BEFORE\n  // the linked_imports loop — those are user-declared effect bridges with\n  // dynamic names, not builtins.\n  verify_lane_builtins(\"linear\", builtin_names_list, builtin_param_counts, builtin_returns_list)\n  let mut li_reg = 0\n  while li_reg < Array::length(linked_imports) {\n    let (_, lfn_name, lparams, lreturns) = Array::get(linked_imports, li_reg)\n    Array::push(builtin_names_list, lfn_name)\n    Array::push(builtin_param_counts, lparams)\n    Array::push(builtin_needs_env_list, true)\n    Array::push(builtin_indices_list, Array::get(linked_import_indices, li_reg))\n    Array::push(builtin_returns_list, lreturns)\n    li_reg = li_reg + 1\n  }\n  let mut all_fn_i = 0\n  while all_fn_i < Array::length(builtin_names_list) {\n    Array::push(fn_names_list, Array::get(builtin_names_list, all_fn_i))\n    Array::push(fn_param_counts, Array::get(builtin_param_counts, all_fn_i))\n    Array::push(fn_needs_env_list, Array::get(builtin_needs_env_list, all_fn_i))\n    Array::push(fn_indices_list, Array::get(builtin_indices_list, all_fn_i))\n    Array::push(fn_returns_list, Array::get(builtin_returns_list, all_fn_i))\n    all_fn_i = all_fn_i + 1\n  }\n  let all_fn_names_list = fn_names_list\n  let all_fn_param_counts = fn_param_counts\n  let all_fn_needs_env_list = fn_needs_env_list\n  let all_fn_indices_list = fn_indices_list\n  let all_fn_returns_list = fn_returns_list\n  let num_base_types = 9\n  let lt_w = LambdaTable::{\n    bodies: lc_fresh_bytes_array(),\n    param_counts: lc_fresh_int_array(),\n    captures: lc_fresh_string_matrix(),\n    meta_i32: lc_fresh_int_array(),\n    meta_i64: lc_fresh_int_array()\n  }\n  let bodies = lc_fresh_bytes_array()\n  let meta_i32 = lc_fresh_int_array()\n  let meta_i64 = lc_fresh_int_array()\n  let builtin_type_idxs = lc_fresh_int_array()\n  // #415 B-1: one call = one builtin body. The body bytes, its extra local\n  // counts (meta_i32/meta_i64), and its function-section type index are\n  // pushed TOGETHER, killing the four-way positional alignment this block\n  // used to share with a bare number list ~1,400 lines below (the function\n  // section splices builtin_type_idxs in this same order; a count mismatch\n  // still throws there).\n  let push_builtin: (Bytes, Int, Int, Int) -> Unit = (body, m32, m64, type_idx) -> {\n    Array::push(bodies, body)\n    Array::push(meta_i32, m32)\n    Array::push(meta_i64, m64)\n    Array::push(builtin_type_idxs, type_idx)\n  }\n  push_builtin(static_print_i64_body(), 3, 1, 1)\n  push_builtin(static_print_str_body(), 2, 0, 1)\n  push_builtin(if enable_rc {\n    gen_str_len_body(true)\n  } else {\n    static_str_len_body()\n  }, 0, 0, 3)\n  // #748: SIMD chunk compare needs the extra chunk_limit local (meta_i32 6).\n  push_builtin(gen_str_eq_body(), 6, 0, 4)\n  push_builtin(gen_str_concat_body(), 6, 0, 4)\n  if enable_rc {\n    push_builtin(gen_arr_new_body(true, rc_alloc_idx), 1, 0, 5)\n    push_builtin(gen_arr_len_body(true), 0, 0, 3)\n    push_builtin(gen_arr_get_body(true), 1, 0, 4)\n    push_builtin(gen_arr_push_body(true, rc_alloc_idx, rc_shadow), 6, 0, 6)\n    push_builtin(gen_arr_set_body(true), 1, 0, 7)\n  } else {\n    push_builtin(gen_arr_new_body(false, rc_alloc_idx), 1, 0, 5)\n    push_builtin(static_arr_len_body(), 0, 0, 3)\n    push_builtin(static_arr_get_body(), 1, 0, 4)\n    push_builtin(gen_arr_push_body(false, rc_alloc_idx, rc_shadow), 6, 0, 6)\n    push_builtin(static_arr_set_body(), 1, 0, 7)\n  }\n  push_builtin(static_double_to_int_body(), 0, 0, 3)\n  push_builtin(static_int_to_double_body(), 0, 0, 3)\n  push_builtin(if enable_rc {\n    gen_str_char_code_at_body(true)\n  } else {\n    static_str_char_code_at_body()\n  }, 1, 0, 4)\n  push_builtin(gen_str_from_char_code_body(enable_rc), 1, 0, 3)\n  // #982: substring's clamp prologue needs one i64 scratch (len) — meta 2/1.\n  push_builtin(gen_str_substring_body(enable_rc), 2, 1, 8)\n  push_builtin(static_identity_body(), 0, 0, 3)\n  if enable_rc {\n    push_builtin(gen_arr_slice_body(true, rc_alloc_idx, rc_shadow), 7, 1, 8)\n  } else {\n    // #982: the clamp prologue's i64 len scratch (RC reuses local 10 = elem).\n    push_builtin(gen_arr_slice_body(false, rc_alloc_idx, rc_shadow), 6, 1, 8)\n  }\n  push_builtin(gen_arr_concat_body(), 9, 0, 4)\n  push_builtin(if enable_rc {\n    gen_arr_truncate_body(true)\n  } else {\n    static_arr_truncate_body()\n  }, 0, 0, 6)\n  push_builtin(gen_string_join_body(enable_rc, arr_len_idx, arr_get_idx, str_concat_idx), 9, 1, 4)\n  push_builtin(static_fs_stub_body(), 0, 0, 3)\n  push_builtin(static_fs_stub_body(), 0, 0, 3)\n  push_builtin(static_fs_stub_body(), 0, 0, 3)\n  push_builtin(static_fs_write_bytes_stub_body(), 0, 0, 6)\n  push_builtin(static_fs_write_bytes_stub_body(), 0, 0, 6)\n  push_builtin(gen_eq_body(str_eq_idx), 0, 0, 4)\n  push_builtin(gen_string_ends_with_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 2, 1, 4)\n  push_builtin(gen_string_last_index_of_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 3, 1, 4)\n  if enable_rc {\n    push_builtin(gen_arr_push_all_body(true, rc_alloc_idx, rc_shadow), 10, 1, 6)\n  } else {\n    push_builtin(gen_arr_push_all_body(false, rc_alloc_idx, rc_shadow), 9, 0, 6)\n  }\n  // #748 memchr rewrite: 8 i32 locals, the i64 substring scratch is gone.\n  push_builtin(gen_string_index_of_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 8, 0, 4)\n  push_builtin(gen_string_contains_body(enable_rc, string_index_of_idx), 0, 0, 4)\n  push_builtin(gen_string_starts_with_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 2, 1, 4)\n  push_builtin(gen_string_split_body(enable_rc, arr_new_idx, arr_push_idx, str_len_idx, str_substring_idx, string_index_of_idx), 4, 1, 4)\n  push_builtin(gen_string_trim_body(enable_rc, str_len_idx, str_char_code_at_idx, str_substring_idx), 4, 0, 3)\n  if num_src_pairs > 0 {\n    push_builtin(gen_sources_proper_body(num_src_pairs, str_offsets, str_lengths, src_str_base, arr_new_idx, arr_push_idx), 1, 1, 5)\n  } else {\n    push_builtin(gen_sources_stub_body(arr_new_idx), 0, 0, 5)\n  }\n  push_builtin(gen_bytes_new_body(), 1, 0, 5)\n  push_builtin(gen_bytes_len_body(enable_rc), 0, 0, 3)\n  push_builtin(gen_bytes_get_body(enable_rc), 1, 0, 4)\n  push_builtin(gen_bytes_set_body(enable_rc), 1, 0, 7)\n  push_builtin(gen_bytes_push_body(enable_rc), 6, 0, 6)\n  push_builtin(gen_bytes_append_body(enable_rc, bytes_len_idx, bytes_get_idx, bytes_push_idx), 2, 0, 6)\n  push_builtin(gen_bytes_concat_body(bytes_new_idx, bytes_append_idx), 0, 1, 4)\n  push_builtin(gen_bytes_slice_body(enable_rc, bytes_new_idx, bytes_get_idx, bytes_push_idx), 2, 1, 8)\n  push_builtin(gen_bytes_from_array_body(enable_rc, arr_len_idx, arr_get_idx, bytes_new_idx, bytes_push_idx), 2, 1, 3)\n  push_builtin(gen_bytes_to_array_body(enable_rc, arr_new_idx, arr_push_idx, bytes_len_idx, bytes_get_idx), 2, 1, 3)\n  if enable_rc {\n    push_builtin(gen_rc_drop_body(rc_drop_idx, rc_shadow), 5, 1, 1)\n    push_builtin(gen_rc_alloc_body(rc_shadow), 4, 0, 3)\n  } else {\n    ()\n  }\n  push_builtin(gen_heap_grow_check_body(), 0, 0, 2)\n  push_builtin(gen_simd_skip_ws_body(enable_rc), 2, 2, 8)\n  push_builtin(gen_simd_scan_alnum_body(enable_rc, false), 1, 3, 8)\n  push_builtin(gen_simd_scan_alnum_body(enable_rc, true), 1, 3, 8)\n  push_builtin(gen_str_lex_diff_body(enable_rc), 7, 0, 4)\n  push_builtin(gen_generic_rel_diff_body(enable_rc, str_lex_diff_idx), 0, 0, 4)\n  push_builtin(gen_generic_add_body(str_concat_idx), 0, 0, 4)\n  // #708: one counter cell shared across every function's lift pass, so each\n  // lift site gets a distinct `__m_scrut_N` name (see lift_match_scrutinees).\n  let m_scrut_counter = [0]\n  // #712: one counter cell shared across every function's uniquify pass, so\n  // every renamed shadow gets a distinct `__shadow_N_<name>` (see\n  // uniquify_shadowed_bindings).\n  let uq_shadow_counter = [0]\n  // #799 perf: ONE membership index over the flat fn + ctor name tables,\n  // shared by every per-function CompileCtx below. collect_free_vars_indexed\n  // consults it per ident instead of linearly scanning ~thousands of names\n  // (which dominated compiler-closure compile profiles).\n  // Round 2: a SORTED array + binary search -- the previous MapBuilder index\n  // was O(N^2) to build (set scans for duplicates) and O(N) per has_key.\n  let capture_index_names = lc_fresh_string_array()\n  let mut cib_i = 0\n  while cib_i < Array::length(all_fn_names_list) {\n    Array::push(capture_index_names, Array::get(all_fn_names_list, cib_i))\n    cib_i = cib_i + 1\n  }\n  let mut cib_j = 0\n  while cib_j < Array::length(ctor_names_list) {\n    Array::push(capture_index_names, Array::get(ctor_names_list, cib_j))\n    cib_j = cib_j + 1\n  }\n  let capture_name_index_shared = sorted_names_of(capture_index_names)\n  let mut bi = 0\n  while bi < num_user_funcs {\n    let __bi_stmt = Array::get(stmts, Array::get(fn_stmt_indices, bi))\n    // #703 follow-up: under RC, lift temporary match scrutinees into lets so the\n    // Perceus pass (which drops named bindings) reclaims them. Applied here, the\n    // SAME transformed body feeds both build_perceus_plan (below) and the body\n    // compilation, keeping the plan and codegen consistent. Non-RC is unchanged.\n    //\n    // #712: before lifting scrutinees, alpha-rename any binding that shadows an\n    // enclosing one (within this same function) to a fresh unique name, so RC\n    // codegen's name-keyed bookkeeping (heap_binding_names, rc_drop_names,\n    // rc_alias_dup_names, rc_dup_names, loop_borrowed_names, and the Perceus\n    // plan itself) can never confuse two distinct bindings that happen to share\n    // a name. See uniquify_shadowed_bindings's doc comment (normalize/index.vibe).\n    let __bi_expr = if enable_rc {\n      // #715: fresh per-function seen-set -- name uniqueness is only required\n      // within one function (Perceus plans and codegen bookkeeping are\n      // per-function), and per-function reset keeps first binders unrenamed.\n      let uq_seen: Array[String] = [\n      ]\n      lift_match_scrutinees(uniquify_shadowed_bindings(get_slet_expr(__bi_stmt), Map::new(), uq_shadow_counter, uq_seen), m_scrut_counter)\n    } else {\n      get_slet_expr(__bi_stmt)\n    }\n    let body_buf = bytebuf_new()\n    // #cov: mark this user function as executed (store 1 at cov_base + bi).\n    // Stack-neutral and local-free, so prepending it to the body is safe.\n    if coverage {\n      emit_i32_const(body_buf, cov_base + bi)\n      emit_i32_const(body_buf, 1)\n      emit_i32_store8(body_buf, 0, 0)\n      // #cov branch: tell branch instrumentation which function owns the branches\n      // emitted while compiling this body.\n      Array::set(cov_state.cur_fn, 0, bi)\n    } else {\n      ()\n    }\n    // debugger trace (DAP P1 groundwork): in debug mode, append this user\n    // function's index `bi` to the in-memory trace log when there is still room.\n    // Stack-neutral and local-free, so prepending it to the body is safe:\n    //   if load[counter_addr] < cap {\n    //     store[log_base + load[counter_addr]*4] = bi\n    //     store[counter_addr] = load[counter_addr] + 1\n    //   }\n    // `counter` is reloaded from memory each time (idempotent), avoiding locals.\n    if debug_trace {\n      emit_i32_const(body_buf, trace_counter_addr)\n      emit_i32_load(body_buf, 2, 0)\n      emit_i32_const(body_buf, trace_cap)\n      emit_i32_ge_u(body_buf)\n      emit_i32_eqz(body_buf)\n      emit_if_void(body_buf)\n      // store[log_base + counter*4] = bi\n      emit_i32_const(body_buf, trace_log_base)\n      emit_i32_const(body_buf, trace_counter_addr)\n      emit_i32_load(body_buf, 2, 0)\n      emit_i32_const(body_buf, 4)\n      emit_i32_mul(body_buf)\n      emit_i32_add(body_buf)\n      emit_i32_const(body_buf, bi)\n      emit_i32_store(body_buf, 2, 0)\n      // store[counter_addr] = counter + 1\n      emit_i32_const(body_buf, trace_counter_addr)\n      emit_i32_const(body_buf, trace_counter_addr)\n      emit_i32_load(body_buf, 2, 0)\n      emit_i32_const(body_buf, 1)\n      emit_i32_add(body_buf)\n      emit_i32_store(body_buf, 2, 0)\n      emit_end(body_buf)\n    } else {\n      ()\n    }\n    // #715: computed here, BEFORE the `debug_break` block below, and reused by\n    // it via `Array::length(lc_norm_params)` instead of a second independent\n    // `is_efn(__bi_expr)`/`get_efn_params(__bi_expr)` call. Both accessors\n    // unconditionally rc_drop their argument, so each call is a real \"use\" of\n    // `__bi_expr` for Perceus's purposes; having it called from BOTH branches\n    // of the (usually-false) `if debug_break` AND unconditionally right after\n    // made the `if debug_break {...} else {...}` construct's `then` branch\n    // statically \"consume\" 2 extra units of `__bi_expr`'s remaining-use budget\n    // that, in the overwhelmingly common `debug_break == false` case, never\n    // actually execute. perceus/index.vibe's `pc_emit` EIf handling takes the\n    // MIN of the two branches' resulting `remaining` and carries it forward\n    // (see the #705 comment there) to avoid double-freeing a value fully\n    // consumed on the taken branch -- but that also means the *lower* (more-\n    // consuming) branch's count wins even when it is the branch that is\n    // essentially never taken, permanently starving the dup budget needed by\n    // `__bi_expr`'s later, always-executed uses below (`lc_norm_params` itself\n    // was one of them) and eventually causing a use of an already-freed\n    // pointer (#715's free-list corruption during RC self-hosting). Hoisting\n    // this computation out from under `debug_break` removes the only\n    // asymmetric-branch use of `__bi_expr` in this function (the other\n    // `is_efn(__bi_expr)`-gated branches all have `is_efn(__bi_expr)` true on\n    // effectively every real program, so their MIN-selected branch already\n    // matches the branch actually taken).\n    // #715: `get_slet_type(__bi_stmt)` hoisted out of the `is_efn(__bi_expr)`\n    // `then` branch and computed here, unconditionally -- previously it was\n    // the ONLY use of `__bi_stmt` inside this specific `if`'s `then` branch\n    // (the `else` branch, `array_empty()`, never touches\n    // `__bi_stmt`), and `__bi_expr` is NOT an EFn for every `bi` iteration:\n    // `fn_names_list`/`fn_stmt_indices` also carry thunk entries (see the\n    // classification loop above), so the `else` path here is a real, common\n    // occurrence, not a rare edge case. Same leak mechanism as the\n    // `lc_norm_params`/`__bi_body`/`dn_expr`/classification-loop fixes above\n    // -- `pc_emit`'s EIf MIN-merge (#705) otherwise permanently assumes the\n    // `then`-branch's higher `__bi_stmt` consumption even on thunk (`else`)\n    // iterations, leaking `__bi_stmt` (a heap Stmt node) on each one.\n    let __sf_slet_type = get_slet_type(__bi_stmt)\n    let lc_norm_params = if is_efn(__bi_expr) {\n      let ps = get_efn_params(__bi_expr)\n      let sig_args_raw = fn_type_param_types(__sf_slet_type)\n      let single_tuple_param = match sig_args_raw {\n        Some(a) => Array::length(ps) == 1 && Array::length(a) > 1,\n        None => false\n      }\n      let np = Array::slice(ps, 0, 0)\n      let mut spi = 0\n      while spi < Array::length(ps) {\n        let (sraw, sty) = Array::get(ps, spi)\n        let slen = String::length(sraw)\n        let ssn = if slen > 0 {\n          let slc = String::char_code_at(sraw, slen - 1)\n          if slc == '~' || slc == '?' {\n            sraw[0: slen - 1]\n          } else {\n            sraw\n          }\n        } else {\n          sraw\n        }\n        let resolved_ty = match sty {\n          Some(_) => sty,\n          None =>\n          match sig_args_raw {\n            Some(args) =>\n            if single_tuple_param {\n              Some(TyTuple(args))\n            } else if Array::length(args) == Array::length(ps) {\n              Some(Array::get(args, spi))\n            } else {\n              None\n            },\n            None => None\n          }\n        }\n        Array::push(np, (ssn, resolved_ty))\n        spi = spi + 1\n      }\n      np\n    } else {\n      // #715: alias `__sf_slet_type` once here too, matching `then`'s single\n      // use (via `fn_type_param_types`) now that it is hoisted above -- see\n      // that binding's doc comment.\n      let __sf_lnp_ty = __sf_slet_type\n      array_empty()\n    }\n    // debugger breakpoint (DAP P1): in break mode, call the host hook\n    // `vibe::dbg_break` at this user function's entry. The hook inspects the\n    // wasm backtrace to name the entering function and pauses when it is in the\n    // breakpoint set. Stack-neutral (() -> ()), so prepending is safe.\n    if debug_break {\n      // DAP P2: spill this function's i64 parameters into the dbgargs region so\n      // the host hook can read and print them. All user-function wasm params are\n      // i64 (vibe value ABI); locals 0..nparams-1 hold the params at entry.\n      let dbg_nparams = Array::length(lc_norm_params)\n      let dbg_n = if dbg_nparams > dbgargs_cap {\n        dbgargs_cap\n      } else {\n        dbg_nparams\n      }\n      let mut dbg_pi = 0\n      while dbg_pi < dbg_n {\n        emit_i32_const(body_buf, dbgargs_base + dbg_pi * 8)\n        emit_local_get(body_buf, dbg_pi)\n        emit_i64_store(body_buf, 3, 0)\n        dbg_pi = dbg_pi + 1\n      }\n      emit_i32_const(body_buf, dbgargs_count_addr)\n      emit_i32_const(body_buf, dbg_n)\n      emit_i32_store(body_buf, 2, 0)\n      emit_call(body_buf, dbg_break_import_idx)\n    } else {\n      ()\n    }\n    let local_names = lc_fresh_string_array()\n    let fn_name_dbg = Array::get(fn_names_list, bi)\n    let rc_drops = array_empty()\n    let rc_alias_dups = array_empty()\n    let rc_dups = array_empty()\n    let lc_heap_params = lc_fresh_string_array()\n    // #715: computed once, unconditionally (regardless of `enable_rc`), and\n    // reused below both for the Perceus plan and for the actual codegen call\n    // to `compile_expr` -- instead of a separate `get_efn_body(__bi_expr)`\n    // call under `enable_rc` (as `fbody`) AND another one further down (as\n    // `body`, inside the `is_efn(__bi_expr)` block). Each independent\n    // `get_efn_body(__bi_expr)`/`get_efn_params(__bi_expr)` call is a real\n    // additional owning \"use\" of `__bi_expr` for Perceus's purposes (neither\n    // is registered in `is_borrow_arg0_call`), inflating the dup budget\n    // `__bi_expr` statically needs. See the `lc_norm_params` doc comment\n    // above (the same redundant-call pattern, already fixed once for\n    // `get_efn_params`) for the full double-free mechanism this avoids.\n    let __bi_body = if is_efn(__bi_expr) {\n      get_efn_body(__bi_expr)\n    } else {\n      __bi_expr\n    }\n    if enable_rc {\n      let plan = build_perceus_plan_with_params(lc_norm_params, __bi_body, lc_borrow_ret_names)\n      let mut lhpi = 0\n      while lhpi < Array::length(lc_norm_params) {\n        let (lhpn, lhpt) = Array::get(lc_norm_params, lhpi)\n        if param_is_heap_in_body(lhpn, lhpt, __bi_body) {\n          Array::push(lc_heap_params, lhpn)\n        } else {\n          ()\n        }\n        lhpi = lhpi + 1\n      }\n      let mut di = 0\n      while di < Array::length(plan) {\n        let pa = Array::get(plan, di)\n        if pa_is_drop(pa) {\n          Array::push(rc_drops, pa.name)\n        } else if pa_is_alias_dup(pa) {\n          Array::push(rc_alias_dups, pa.name)\n        } else if pa_is_dup(pa) {\n          Array::push(rc_dups, pa.name)\n        } else {\n          ()\n        }\n        di = di + 1\n      }\n    }\n    // Interior-line breakpoints: this function's source file id + that file's\n    // newline index (for mapping its statement offsets to lines). Off => 0/empty.\n    let dbg_fid = if dbg_line_on {\n      Array::get(prov.stmt_file_id, Array::get(fn_stmt_indices, bi))\n    } else {\n      0\n    }\n    let dbg_nls = if dbg_line_on {\n      Array::get(prov.file_nls, dbg_fid)\n    } else {\n      lc_fresh_int_array()\n    }\n    let compile_ctx = CompileCtx::{\n      func_table: FuncTable::{\n        names: all_fn_names_list,\n        indices: all_fn_indices_list,\n        params: all_fn_param_counts,\n        returns: all_fn_returns_list,\n        needs_env: all_fn_needs_env_list\n      },\n      str_table: StrTable::{\n        strs: str_strs, offsets: str_offsets, lengths: str_lengths\n      },\n      lambda_table: lt_w,\n      num_user_funcs: num_user_funcs, func_offset: func_offset,\n      ref_cell_names: lc_fresh_string_array(),\n      ctor_table: CtorTable::{\n        names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: lc_ctor_names_sorted, names_sorted_pos: lc_ctor_names_sorted_pos\n      },\n      ctor_float_fields: ctor_float_fields_list,\n      thunk_names: thunk_names_list,\n      const_int_names: const_int_names_list,\n      const_int_values: const_int_values_list,\n      enable_rc: enable_rc,\n      rc_shadow: rc_shadow,\n      rc_drop_names: rc_drops,\n      rc_alias_dup_names: rc_alias_dups,\n      heap_binding_names: lc_heap_params,\n      rc_drop_func_idx: if enable_rc {\n        rc_drop_idx\n      } else {\n        -1\n      },\n      rc_alloc_func_idx: if enable_rc {\n        rc_alloc_idx\n      } else {\n        -1\n      },\n      heap_grow_check_func_idx: heap_grow_check_idx,\n      rc_dup_names: rc_dups,\n      capture_name_index: capture_name_index_shared,\n      float_local_slots: lc_fresh_int_array(),\n      int_local_slots: lc_fresh_int_array(),\n      agg_local_slots: lc_fresh_int_array(),\n      agg_local_exprs: lc_fresh_expr_array(),\n      agg_ret_names: lc_agg_ret_names,\n      agg_ret_infos: lc_agg_ret_infos,\n      heap_ret_names: lc_heap_ret_names,\n      effect_names: effect_names_list,\n      effect_op_keys: effect_op_keys_list,\n      effect_op_arities: effect_op_arities_list,\n      cov: cov_state,\n      dbg_line_idx: dbg_line_import_idx,\n      dbg_line_nl: dbg_nls,\n      dbg_line_file_id: dbg_fid,\n      loop_borrowed_names: lc_fresh_string_array(),\n      loop_consumed_names: lc_fresh_string_array(),\n      borrow_ret_names: lc_borrow_ret_names,\n      scalar_ret_names: lc_scalar_ret_names,\n      pending_letrec_self_name: lc_fresh_string_array()\n    }\n    if is_efn(__bi_expr) {\n      // #715: `lc_norm_params` (built above from `get_efn_params(__bi_expr)`)\n      // already carries each parameter's `~`/`?`-stripped name in `.0` --\n      // reuse it instead of a second `get_efn_params(__bi_expr)` call plus a\n      // duplicate stripping pass (see the `__bi_body` doc comment above).\n      let body = __bi_body\n      let mut pi = 0\n      while pi < Array::length(lc_norm_params) {\n        let (pname, _) = Array::get(lc_norm_params, pi)\n        Array::push(local_names, pname)\n        pi = pi + 1\n      }\n      // #724 round 2: seed the aggregate-shape log from ANNOTATED params\n      // (param slot i = local i), so `p == q` on tuple/struct/enum-typed\n      // params compares structurally.\n      let sig_ptypes = fn_type_param_types(__sf_slet_type)\n      let mut psi = 0\n      while psi < Array::length(lc_norm_params) {\n        // Prefer the SLet signature's param types (`let f: (P2) -> ..`);\n        // fall back to a per-param annotation (`(p: P2) -> ..`).\n        let pann = match sig_ptypes {\n          Some(pts) => if Array::length(pts) == Array::length(lc_norm_params) {\n            Some(Array::get(pts, psi))\n          } else {\n            let (_, pa) = Array::get(lc_norm_params, psi)\n            pa\n          },\n          None => {\n            let (_, pa) = Array::get(lc_norm_params, psi)\n            pa\n          }\n        }\n        match pann {\n          Some(pte) => {\n            let pinfo = agg_info_of_type_expr(compile_ctx.ctor_table, pte)\n            if pinfo > 0 {\n              Array::push(compile_ctx.agg_local_slots, psi * 256 + pinfo)\n              // #811: agg_local_exprs is the index-aligned PARALLEL of\n              // agg_local_slots (agg_log_reset_above2 prunes both in\n              // lockstep, reading exprs[i] for every slots[i]). This param\n              // seed pushed only to slots, leaving exprs one entry short —\n              // every later reset then read exprs out of bounds and\n              // compacted the garbage back in. Push the same \"no shape\n              // expr\" placeholder the let-binding site uses.\n              Array::push(compile_ctx.agg_local_exprs, EInt(0))\n            } else {\n              ()\n            }\n            // Float/Double-typed params feed expr_is_floatish the same way\n            // let-bound floats do; without this, `a == b` on annotated float\n            // params misses the f64 path and (under RC, where floats are\n            // boxed) compares heap pointers — `1.5 == 1.5` came out false.\n            //\n            // #1015: Bool-typed params feed expr_is_boolish the same way\n            // (int_local_slots kind 3, #769 encoding slot*4+kind) let-bound\n            // bools do -- without this a Bool-typed param `b` passed straight\n            // to `to_string(b)` (e.g. `fn render(b: Bool) -> String {\n            // to_string(b) }`) is just a bare EIdent with no tracked slot\n            // info, so neither the call-site fast path in\n            // codegen/expr/compile_call.vibe nor `\"\\{b}\"` interpolation can\n            // recognize it as Bool -- both fall through to the generic\n            // runtime bit-pattern heuristic and mis-render `true` as `\"1\"`.\n            match pte {\n              TyName(ptn) => if ptn == \"Float\" || ptn == \"Double\" {\n                Array::push(compile_ctx.float_local_slots, psi * 2 + 1)\n              } else if ptn == \"Bool\" {\n                Array::push(compile_ctx.int_local_slots, psi * 4 + 3)\n              } else {\n                ()\n              },\n              _ => ()\n            }\n          },\n          None => ()\n        }\n        psi = psi + 1\n      }\n      Array::push(local_names, \"__env\")\n      let param_count = Array::length(lc_norm_params) + 1\n      if enable_rc {\n        let mut edi = 0\n        while edi < Array::length(lc_norm_params) {\n          let (edn, _edt) = Array::get(lc_norm_params, edi)\n          if array_contains_str(lc_heap_params, edn) {\n            let mut edc = 0\n            let mut edj = 0\n            while edj < Array::length(rc_dups) {\n              if Array::get(rc_dups, edj) == edn {\n                edc = edc + 1\n              } else {\n                ()\n              }\n              edj = edj + 1\n            }\n            let mut ede = 0\n            while ede < edc {\n              emit_rc_dup_guarded(body_buf, edi, rc_shadow)\n              ede = ede + 1\n            }\n          } else {\n            ()\n          }\n          edi = edi + 1\n        }\n      } else {\n        ()\n      }\n      // #805: an inline-wasm fn's instruction bytes come from the WAT\n      // assembler, not compile_expr (its AST body is a neutral EInt(0) after\n      // lc_extract_inline_wasm). Params are Int-only (parser-enforced), so\n      // no RC/Perceus bookkeeping applies; no extra locals are introduced\n      // (final_nl == param_count => meta extra 0).\n      let mut iw_found = -1\n      let mut iw_scan = 0\n      while iw_scan < Array::length(iw_names) {\n        if Array::get(iw_names, iw_scan) == fn_name_dbg {\n          iw_found = iw_scan\n          iw_scan = Array::length(iw_names)\n        } else {\n          iw_scan = iw_scan + 1\n        }\n      }\n      let final_nl = if iw_found >= 0 {\n        let iw_param_names = lc_fresh_string_array()\n        let mut iw_pi = 0\n        while iw_pi < Array::length(lc_norm_params) {\n          let (iw_pn, _) = Array::get(lc_norm_params, iw_pi)\n          Array::push(iw_param_names, iw_pn)\n          iw_pi = iw_pi + 1\n        }\n        bytebuf_push_buf(body_buf, compile_inline_wat(fn_name_dbg, Array::get(iw_wats, iw_found), iw_param_names))\n        param_count\n      } else {\n        compile_expr(body_buf, body, local_names, param_count, compile_ctx, -1)\n      }\n      let mut tail_nl = final_nl\n      if enable_rc && rc_drop_idx >= 0 {\n        let tail_root = scope_tail_proj_root(body)\n        // #706 leak follow-up: a loop-borrowed param's protective rc_dup (see\n        // compile_call.vibe's cc_is_loop_borrowed_ident sites) is matched by the\n        // callee's OWN internal drop each iteration — it never touches this\n        // function's own slot-held reference. The Perceus plan still counts that\n        // textual occurrence as \"one real consume\" (so `remaining` hits 0 and no\n        // PaDrop is emitted), leaking the binding's own reference once per such\n        // occurrence. Count each param's occurrences in loop_consumed_names and\n        // emit that many EXTRA rc_drop calls here — purely additive to the\n        // existing rc_drops accounting, so it cannot perturb any decision the\n        // plan and codegen already agree on elsewhere.\n        let mut need_dup = false\n        let mut tci = 0\n        while tci < Array::length(lc_norm_params) {\n          let (tcn, _tct) = Array::get(lc_norm_params, tci)\n          let mut tcn_loop_extra = 0\n          let mut tcle = 0\n          while tcle < Array::length(compile_ctx.loop_consumed_names) {\n            if Array::get(compile_ctx.loop_consumed_names, tcle) == tcn {\n              tcn_loop_extra = tcn_loop_extra + 1\n            } else {\n              ()\n            }\n            tcle = tcle + 1\n          }\n          if array_contains_str(lc_heap_params, tcn) && (array_contains_str(rc_drops, tcn) || tcn_loop_extra > 0) && tcn == tail_root {\n            need_dup = true\n          } else {\n            ()\n          }\n          tci = tci + 1\n        }\n        let rtemp = final_nl\n        if need_dup {\n          emit_local_set(body_buf, rtemp)\n          emit_rc_dup_guarded(body_buf, rtemp, rc_shadow)\n          tail_nl = final_nl + 1\n        } else {\n          ()\n        }\n        let mut tdj = 0\n        while tdj < Array::length(lc_norm_params) {\n          let (tdn, _tdt) = Array::get(lc_norm_params, tdj)\n          if array_contains_str(lc_heap_params, tdn) {\n            // #725: a loop-protected consume (per-iteration dup at the call\n            // site, #706 above) is NET-ZERO at runtime — the dup is matched by\n            // the callee's own drop each execution and never touches the\n            // param's single owned reference. So the epilogue owes EXACTLY ONE\n            // drop for that reference, regardless of how many textual\n            // loop-consumed SITES exist: a second site in a sibling match arm\n            // (even one that never executes — its protective dup is emitted\n            // but never runs) previously got its own per-occurrence drop,\n            // over-releasing the CALLER's value and poisoning the RC free\n            // list (fuzz/findings/issue725/). When a loop site exists it also\n            // absorbs the plan's PaDrop (the textual counts ate the budget the\n            // plan would otherwise drop), so emit one drop total either way.\n            let mut tdn_loop_count = 0\n            let mut tdle = 0\n            while tdle < Array::length(compile_ctx.loop_consumed_names) {\n              if Array::get(compile_ctx.loop_consumed_names, tdle) == tdn {\n                tdn_loop_count = tdn_loop_count + 1\n              } else {\n                ()\n              }\n              tdle = tdle + 1\n            }\n            if array_contains_str(rc_drops, tdn) || tdn_loop_count > 0 {\n              emit_local_get(body_buf, tdj)\n              emit_call(body_buf, rc_drop_idx)\n            } else {\n              ()\n            }\n          } else {\n            ()\n          }\n          tdj = tdj + 1\n        }\n        if need_dup {\n          emit_local_get(body_buf, rtemp)\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n      if enable_rc && fn_name_dbg == entry_name {\n        emit_i64_const(body_buf, 1)\n        emit_i64_shr_s(body_buf)\n      }\n      Array::push(bodies, body_buf)\n      let extra = if tail_nl > param_count {\n        tail_nl - param_count\n      } else {\n        0\n      }\n      Array::push(meta_i32, 0)\n      Array::push(meta_i64, extra)\n    } else {\n      // Module-level non-function `let` (a THUNK): previously the initializer\n      // re-ran on EVERY reference, so a 16-entry lookup table cost an O(size)\n      // allocation per access (~148 B/call in bench/_probe_sb_phases.vibe)\n      // and, worse, each access saw a FRESH value while the gc backend\n      // initializes module globals ONCE — a cross-backend semantics split\n      // (mutations visible there, lost here). Memoize: two appended i64\n      // globals per thunk (value + init flag; base index rc?7:6, after\n      // g_op_index). First call computes and caches, later calls reload.\n      // Under RC the cache holds one permanent reference and every return\n      // (both paths) hands the caller a guarded-dup'd reference, so consumer\n      // drops balance exactly like the old fresh-value contract.\n      Array::push(local_names, \"__env\")\n      let param_count = 1\n      let mut tg_k = -1\n      let mut tg_i = 0\n      while tg_i < Array::length(thunk_names_list) {\n        if Array::get(thunk_names_list, tg_i) == fn_name_dbg {\n          tg_k = tg_i\n          tg_i = Array::length(thunk_names_list)\n        } else {\n          tg_i = tg_i + 1\n        }\n      }\n      let tg_base = if enable_rc {\n        7\n      } else {\n        6\n      }\n      let tg_value_g = tg_base + tg_k * 2\n      let tg_flag_g = tg_value_g + 1\n      emit_global_get(body_buf, tg_flag_g)\n      emit_i32_wrap_i64(body_buf)\n      emit_if_i64(body_buf)\n      emit_global_get(body_buf, tg_value_g)\n      emit_local_tee(body_buf, 1)\n      if enable_rc {\n        emit_rc_dup_guarded(body_buf, 1, rc_shadow)\n      } else {\n        ()\n      }\n      emit_else(body_buf)\n      Array::push(local_names, \"__thunk_memo\")\n      let final_nl = compile_expr(body_buf, __bi_expr, local_names, 2, compile_ctx, -1)\n      emit_local_tee(body_buf, 1)\n      emit_global_set(body_buf, tg_value_g)\n      if enable_rc {\n        emit_rc_dup_guarded(body_buf, 1, rc_shadow)\n      } else {\n        ()\n      }\n      emit_i64_const(body_buf, 1)\n      emit_global_set(body_buf, tg_flag_g)\n      emit_local_get(body_buf, 1)\n      emit_end(body_buf)\n      if enable_rc && fn_name_dbg == entry_name {\n        emit_i64_const(body_buf, 1)\n        emit_i64_shr_s(body_buf)\n      }\n      Array::push(bodies, body_buf)\n      let extra = if final_nl > param_count {\n        final_nl - param_count\n      } else {\n        0\n      }\n      Array::push(meta_i32, 0)\n      Array::push(meta_i64, extra)\n    }\n    bi = bi + 1\n  }\n  let num_lambdas = Array::length(lt_w.bodies)\n  let start_body = bytebuf_new()\n  let entry_func_idx = if entry_user_idx >= 0 {\n    entry_user_idx + func_offset\n  } else {\n    -1\n  }\n  // ADR-0069: the synthesized `_start` prints the entry's Int return via\n  // print_int (the historical `let main: () -> Int` convention), but a\n  // Unit-returning entry (`fn main {}` desugars to `() -> Unit`, and any\n  // explicit `let main: () -> Unit`) must NOT print — the old behavior\n  // appended a stray `0` line after the program's own output. Detect Unit\n  // from the entry's declared return type: the EFn return annotation or the\n  // binding's `: (..) -> Unit` type annotation.\n  let mut entry_returns_unit = false\n  if entry_user_idx >= 0 {\n    let mut eri = 0\n    while eri < Array::length(stmts) {\n      match Array::get(stmts, eri) {\n        SLet(_, _, ename, eann, eval) => if ename == entry_name {\n          let ann_unit = match eann {\n            Some(TyFn(_, ann_ret, _)) => linked_type_expr_is_unit(ann_ret),\n            _ => false\n          }\n          let ret_unit = match eval {\n            EFn(_, _, _, efn_ret, _, _) => match efn_ret {\n              Some(rt) => linked_type_expr_is_unit(rt),\n              None => false\n            },\n            _ => false\n          }\n          if ann_unit || ret_unit {\n            entry_returns_unit = true\n          }\n        },\n        _ => ()\n      }\n      eri = eri + 1\n    }\n  }\n  if entry_user_idx >= 0 {\n    let entry_params = Array::get(fn_param_counts, entry_user_idx)\n    if entry_params != 0 {\n      throw(\"WASI entry function must take 0 parameters\")\n    }\n    emit_i64_const(start_body, 0)\n    emit_call(start_body, entry_func_idx)\n    if entry_returns_unit {\n      emit_drop(start_body)\n    } else {\n      emit_call(start_body, print_int_idx)\n    }\n  } else {\n    let mut sti = 0\n    while sti < Array::length(test_fn_names) {\n      let stname = Array::get(test_fn_names, sti)\n      let mut __stj = 0\n      let mut __stf = -1\n      while __stj < Array::length(fn_names_list) {\n        if Array::get(fn_names_list, __stj) == stname {\n          __stf = __stj\n        }\n        __stj = __stj + 1\n      }\n      if __stf >= 0 {\n        emit_i64_const(start_body, 0)\n        emit_call(start_body, func_offset + __stf)\n        emit_drop(start_body)\n      }\n      sti = sti + 1\n    }\n  }\n  Array::push(bodies, start_body)\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  let run_body = bytebuf_new()\n  if entry_func_idx >= 0 {\n    emit_i64_const(run_body, 0)\n    emit_call(run_body, entry_func_idx)\n  } else {\n    let mut rti = 0\n    while rti < Array::length(test_fn_names) {\n      let tname = Array::get(test_fn_names, rti)\n      let mut __rtj = 0\n      let mut __rtf = -1\n      while __rtj < Array::length(fn_names_list) {\n        if Array::get(fn_names_list, __rtj) == tname {\n          __rtf = __rtj\n        }\n        __rtj = __rtj + 1\n      }\n      if __rtf >= 0 {\n        emit_i64_const(run_body, 0)\n        emit_call(run_body, func_offset + __rtf)\n        emit_drop(run_body)\n      }\n      rti = rti + 1\n    }\n    emit_i64_const(run_body, 0)\n  }\n  Array::push(bodies, run_body)\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  let mut li = 0\n  while li < num_lambdas {\n    Array::push(bodies, Array::get(lt_w.bodies, li))\n    Array::push(meta_i32, Array::get(lt_w.meta_i32, li))\n    Array::push(meta_i64, Array::get(lt_w.meta_i64, li))\n    li = li + 1\n  }\n  let mut max_closure_arity = -1\n  let mut lai = 0\n  while lai < num_lambdas {\n    let lpc = Array::get(lt_w.param_counts, lai) - 1\n    if lpc > max_closure_arity {\n      max_closure_arity = lpc\n    }\n    lai = lai + 1\n  }\n  let mut uai = 0\n  while uai < num_user_funcs {\n    let upc = Array::get(fn_param_counts, uai)\n    if upc > max_closure_arity {\n      max_closure_arity = upc\n    }\n    uai = uai + 1\n  }\n  let mut iai = 0\n  while iai < Array::length(linked_imports) {\n    let (_, _, ipc, _) = Array::get(linked_imports, iai)\n    if ipc > max_closure_arity {\n      max_closure_arity = ipc\n    }\n    iai = iai + 1\n  }\n  let num_closure_types = if max_closure_arity >= 0 {\n    max_closure_arity + 1\n  } else {\n    0\n  }\n  // Interior-line breakpoints (span-arc step5): when active, the `vibe::dbg_line`\n  // import needs an `(i32) -> ()` func type. No existing base type is `(i32)->()`\n  // (type 1 is `(i64)->()`), so append one new type AFTER all base + closure\n  // types at index `num_base_types + num_closure_types`. This is strictly beyond\n  // every linked-import type index (which use `num_base_types + lparams`, bounded\n  // by num_closure_types), so existing indices are unshifted. -1 when off.\n  let dbg_line_type_idx = if dbg_line_on {\n    num_base_types + num_closure_types\n  } else {\n    -1\n  }\n  let extra_dbg_types = if dbg_line_on {\n    1\n  } else {\n    0\n  }\n  // #794: `vibe.http_request` needs an `(i64,i64,i64,i64) -> i64` func type.\n  // No base type has 4 i64 params, and closure types are data-dependent (only\n  // present up to the max closure arity in the unit), so append one dedicated\n  // type AFTER base + closure + dbg types when the import is live. Off =>\n  // byte-identical type section (fixpoint-safe).\n  let http_request_type_idx = if need_http_request_builtin {\n    num_base_types + num_closure_types + extra_dbg_types\n  } else {\n    -1\n  }\n  let extra_http_types = if need_http_request_builtin {\n    1\n  } else {\n    0\n  }\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types + extra_dbg_types + extra_http_types)\n  emit_func_type_raw(type_content, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  emit_func_type_raw(type_content, [\n    126\n  ], array_empty())\n  emit_func_type_raw(type_content, array_empty(), array_empty())\n  emit_func_type_raw(type_content, [\n    126\n  ], [\n    126\n  ])\n  emit_func_type_raw(type_content, [\n    126,\n    126\n  ], [\n    126\n  ])\n  emit_func_type_raw(type_content, array_empty(), [\n    126\n  ])\n  emit_func_type_raw(type_content, [\n    126,\n    126\n  ], array_empty())\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126\n  ], array_empty())\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126\n  ], [\n    126\n  ])\n  let mut cti = 0\n  while cti < num_closure_types {\n    let num_params = cti + 1\n    let ct_params = lc_fresh_int_array()\n    let mut cpti = 0\n    while cpti < num_params {\n      Array::push(ct_params, 126)\n      cpti = cpti + 1\n    }\n    emit_func_type_raw(type_content, ct_params, [\n      126\n    ])\n    cti = cti + 1\n  }\n  // Interior-line breakpoints: append the `(i32, i32) -> ()` type for\n  // `vibe::dbg_line` (127 = i32; params = file_id, line). Only when active, so the\n  // type section is byte-identical off.\n  if dbg_line_on {\n    emit_func_type_raw(type_content, [\n      127,\n      127\n    ], array_empty())\n  } else {\n    ()\n  }\n  // #794: the `(i64,i64,i64,i64) -> i64` type for vibe.http_request, appended\n  // last so every other type index is unshifted.\n  if need_http_request_builtin {\n    emit_func_type_raw(type_content, [\n      126,\n      126,\n      126,\n      126\n    ], [\n      126\n    ])\n  } else {\n    ()\n  }\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_vibe_abi_custom_section(out, \"raw\")\n  // #cov: emit a `vibe_cov` custom section describing the function-hit bitmap.\n  // Layout of the payload: i32 LE cov_base, i32 LE cov_count, then the\n  // user-function names (one per line, in bitmap-index order). The consumer\n  // reads memory[cov_base .. cov_base+cov_count] after running and maps each\n  // hit byte back to a name. Only present in coverage builds.\n  if coverage {\n    let cov_content = bytebuf_new()\n    let cov_name = \"vibe_cov\"\n    leb128_encode_u32(cov_content, String::length(cov_name))\n    let mut cni = 0\n    while cni < String::length(cov_name) {\n      bytebuf_push(cov_content, String::char_code_at(cov_name, cni))\n      cni = cni + 1\n    }\n    bytebuf_push(cov_content, cov_base & 255)\n    bytebuf_push(cov_content, (cov_base >> 8) & 255)\n    bytebuf_push(cov_content, (cov_base >> 16) & 255)\n    bytebuf_push(cov_content, (cov_base >> 24) & 255)\n    bytebuf_push(cov_content, cov_count & 255)\n    bytebuf_push(cov_content, (cov_count >> 8) & 255)\n    bytebuf_push(cov_content, (cov_count >> 16) & 255)\n    bytebuf_push(cov_content, (cov_count >> 24) & 255)\n    let mut covni = 0\n    while covni < num_user_funcs {\n      let covnm = Array::get(fn_names_list, covni)\n      let covnml = String::length(covnm)\n      let mut covci = 0\n      while covci < covnml {\n        bytebuf_push(cov_content, String::char_code_at(covnm, covci))\n        covci = covci + 1\n      }\n      bytebuf_push(cov_content, 10)\n      covni = covni + 1\n    }\n    bytebuf_push_section(out, 0, cov_content)\n    // #cov branch: a `vibe_cov_branch` custom section describing the branch-hit\n    // bitmap. Payload: i32 LE branch_base, i32 LE branch_count, then\n    // branch_count i32 LE entries giving the owning user-function index per\n    // branch id (in id order). The consumer reads memory[base .. base+count]\n    // after running and attributes each hit branch to its function (names from\n    // the `vibe_cov` section), so it can report per-function branch coverage.\n    let covb_content = bytebuf_new()\n    let covb_name = \"vibe_cov_branch\"\n    leb128_encode_u32(covb_content, String::length(covb_name))\n    let mut covbni = 0\n    while covbni < String::length(covb_name) {\n      bytebuf_push(covb_content, String::char_code_at(covb_name, covbni))\n      covbni = covbni + 1\n    }\n    let covb_count = Array::get(cov_state.next, 0)\n    bytebuf_push(covb_content, cov_branch_base & 255)\n    bytebuf_push(covb_content, (cov_branch_base >> 8) & 255)\n    bytebuf_push(covb_content, (cov_branch_base >> 16) & 255)\n    bytebuf_push(covb_content, (cov_branch_base >> 24) & 255)\n    bytebuf_push(covb_content, covb_count & 255)\n    bytebuf_push(covb_content, (covb_count >> 8) & 255)\n    bytebuf_push(covb_content, (covb_count >> 16) & 255)\n    bytebuf_push(covb_content, (covb_count >> 24) & 255)\n    let mut covbi = 0\n    while covbi < covb_count {\n      let owner = Array::get(cov_state.owners, covbi)\n      bytebuf_push(covb_content, owner & 255)\n      bytebuf_push(covb_content, (owner >> 8) & 255)\n      bytebuf_push(covb_content, (owner >> 16) & 255)\n      bytebuf_push(covb_content, (owner >> 24) & 255)\n      covbi = covbi + 1\n    }\n    bytebuf_push_section(out, 0, covb_content)\n  } else {\n    ()\n  }\n  // debugger trace (DAP P1 groundwork): emit a `vibe.trace` custom section\n  // describing the in-memory trace log. Payload layout: i32 LE counter_addr,\n  // i32 LE log_base, i32 LE cap, then the user-function names (one per line, in\n  // user-index order — the same list the name section uses). The runner reads\n  // memory[counter_addr] for the count, then `count` i32 entries from log_base,\n  // and maps each index to a name. Only present in debug-trace builds.\n  if debug_trace {\n    let tr_content = bytebuf_new()\n    let tr_name = \"vibe.trace\"\n    leb128_encode_u32(tr_content, String::length(tr_name))\n    let mut trni = 0\n    while trni < String::length(tr_name) {\n      bytebuf_push(tr_content, String::char_code_at(tr_name, trni))\n      trni = trni + 1\n    }\n    bytebuf_push(tr_content, trace_counter_addr & 255)\n    bytebuf_push(tr_content, (trace_counter_addr >> 8) & 255)\n    bytebuf_push(tr_content, (trace_counter_addr >> 16) & 255)\n    bytebuf_push(tr_content, (trace_counter_addr >> 24) & 255)\n    bytebuf_push(tr_content, trace_log_base & 255)\n    bytebuf_push(tr_content, (trace_log_base >> 8) & 255)\n    bytebuf_push(tr_content, (trace_log_base >> 16) & 255)\n    bytebuf_push(tr_content, (trace_log_base >> 24) & 255)\n    bytebuf_push(tr_content, trace_cap & 255)\n    bytebuf_push(tr_content, (trace_cap >> 8) & 255)\n    bytebuf_push(tr_content, (trace_cap >> 16) & 255)\n    bytebuf_push(tr_content, (trace_cap >> 24) & 255)\n    let mut trni2 = 0\n    while trni2 < num_user_funcs {\n      let trnm = Array::get(fn_names_list, trni2)\n      let trnml = String::length(trnm)\n      let mut trci = 0\n      while trci < trnml {\n        bytebuf_push(tr_content, String::char_code_at(trnm, trci))\n        trci = trci + 1\n      }\n      bytebuf_push(tr_content, 10)\n      trni2 = trni2 + 1\n    }\n    bytebuf_push_section(out, 0, tr_content)\n  } else {\n    ()\n  }\n  // debugger argument inspection (DAP P2): emit a `vibe.dbgargs` custom section\n  // publishing the addresses + value ABI the runner reads. Payload layout:\n  // i32 LE dbgargs_count_addr, i32 LE dbgargs_base, i32 LE tag_mode. At a\n  // breakpoint the runner reads memory[count_addr] (i32) for the arg count, then\n  // that many i64 values from dbgargs_base, decoding each per tag_mode:\n  //   tag_mode 0 (enable_rc off): values are plain untagged i64 ints.\n  //   tag_mode 1 (enable_rc on):  values are 1-bit tagged — low bit 0 => int\n  //                               (raw >> 1), low bit 1 => heap pointer (hex).\n  // Only present in break builds.\n  if debug_break {\n    let da_content = bytebuf_new()\n    let da_name = \"vibe.dbgargs\"\n    leb128_encode_u32(da_content, String::length(da_name))\n    let mut dani = 0\n    while dani < String::length(da_name) {\n      bytebuf_push(da_content, String::char_code_at(da_name, dani))\n      dani = dani + 1\n    }\n    bytebuf_push(da_content, dbgargs_count_addr & 255)\n    bytebuf_push(da_content, (dbgargs_count_addr >> 8) & 255)\n    bytebuf_push(da_content, (dbgargs_count_addr >> 16) & 255)\n    bytebuf_push(da_content, (dbgargs_count_addr >> 24) & 255)\n    bytebuf_push(da_content, dbgargs_base & 255)\n    bytebuf_push(da_content, (dbgargs_base >> 8) & 255)\n    bytebuf_push(da_content, (dbgargs_base >> 16) & 255)\n    bytebuf_push(da_content, (dbgargs_base >> 24) & 255)\n    let da_tag_mode = if enable_rc {\n      1\n    } else {\n      0\n    }\n    bytebuf_push(da_content, da_tag_mode & 255)\n    bytebuf_push(da_content, (da_tag_mode >> 8) & 255)\n    bytebuf_push(da_content, (da_tag_mode >> 16) & 255)\n    bytebuf_push(da_content, (da_tag_mode >> 24) & 255)\n    bytebuf_push_section(out, 0, da_content)\n  } else {\n    ()\n  }\n  // debugger named-parameter inspection (DAP P4): emit a `vibe.dbgnames` custom\n  // section listing, per user function (in user-index order — the same order as\n  // the name section / fn_names_list / vibe.dbgargs spill), that function's name\n  // followed by its parameter names. One record per function, terminated by\n  // newline (10); within a record fields are tab-delimited (9): the first field\n  // is the function name, the remaining fields are the parameter names. A\n  // function with no params emits just its name + newline. Names are capped at\n  // dbgargs_cap to match the spilled value count. The runner keys a map by\n  // function name so entering-function F's names can be paired with F's spilled\n  // values to print `args: [name=value]`. Only present in break builds; off =>\n  // byte-identical to a normal build (fixpoint preserved).\n  if debug_break {\n    let dn_content = bytebuf_new()\n    let dn_name = \"vibe.dbgnames\"\n    leb128_encode_u32(dn_content, String::length(dn_name))\n    let mut dnni = 0\n    while dnni < String::length(dn_name) {\n      bytebuf_push(dn_content, String::char_code_at(dn_name, dnni))\n      dnni = dnni + 1\n    }\n    let mut dnfi = 0\n    while dnfi < num_user_funcs {\n      let dn_fnname = Array::get(fn_names_list, dnfi)\n      let mut dn_fci = 0\n      while dn_fci < String::length(dn_fnname) {\n        bytebuf_push(dn_content, String::char_code_at(dn_fnname, dn_fci))\n        dn_fci = dn_fci + 1\n      }\n      let dn_stmt = Array::get(stmts, Array::get(fn_stmt_indices, dnfi))\n      let dn_expr = get_slet_expr(dn_stmt)\n      if is_efn(dn_expr) {\n        let dn_params = get_efn_params(dn_expr)\n        let dn_np = Array::length(dn_params)\n        let dn_n = if dn_np > dbgargs_cap {\n          dbgargs_cap\n        } else {\n          dn_np\n        }\n        let mut dn_pi = 0\n        while dn_pi < dn_n {\n          let (dn_pname_raw, _) = Array::get(dn_params, dn_pi)\n          let dn_pnl = String::length(dn_pname_raw)\n          let dn_pname = if dn_pnl > 0 {\n            let dn_plc = String::char_code_at(dn_pname_raw, dn_pnl - 1)\n            if dn_plc == '~' || dn_plc == '?' {\n              dn_pname_raw[0: dn_pnl - 1]\n            } else {\n              dn_pname_raw\n            }\n          } else {\n            dn_pname_raw\n          }\n          bytebuf_push(dn_content, 9)\n          let mut dn_ci = 0\n          while dn_ci < String::length(dn_pname) {\n            bytebuf_push(dn_content, String::char_code_at(dn_pname, dn_ci))\n            dn_ci = dn_ci + 1\n          }\n          dn_pi = dn_pi + 1\n        }\n      } else {\n        // #715: `dn_expr` is a fresh per-iteration owned binding (like\n        // `__bi_expr` in the main codegen loop above), and -- unlike\n        // `__bi_expr` -- `is_efn(dn_expr)` is NOT overwhelmingly true here:\n        // `fn_stmt_indices` legitimately mixes real functions with non-\n        // function \"thunk\" entries (constant initializers), so this `else`\n        // is a common, not rare, runtime path. An empty `else { () }` uses\n        // `dn_expr` zero times while `then` uses it once (via\n        // `get_efn_params`), so `pc_emit`'s EIf MIN-merge (#705) permanently\n        // carries the `then`-consumed (lower) remaining forward even on the\n        // iterations that really take this branch -- the loop-body scope-end\n        // drop for `dn_expr` is then skipped based on that borrowed count,\n        // leaking `dn_expr` on every thunk entry. Call `is_efn` again here,\n        // discarding the result, purely to consume `dn_expr` exactly once --\n        // matching `then`'s single consuming use so both branches leave the\n        // same remaining count and the plan's assumption holds either way.\n        is_efn(dn_expr)\n      }\n      bytebuf_push(dn_content, 10)\n      dnfi = dnfi + 1\n    }\n    bytebuf_push_section(out, 0, dn_content)\n  } else {\n    ()\n  }\n  // Interior-line breakpoints (span-arc step5, multi-file): emit a `vibe.dbgfiles`\n  // custom section listing the source-file basenames in file-id order, one per\n  // line (terminated by newline 10). `vibe::dbg_line(file_id, line)` passes the\n  // file id; the runner indexes this table to recover the basename and match a\n  // `--break <file>:<line>` spec. Only present when dbg_line is active, so off =>\n  // byte-identical (fixpoint preserved).\n  if dbg_line_on {\n    let df_content = bytebuf_new()\n    let df_name = \"vibe.dbgfiles\"\n    leb128_encode_u32(df_content, String::length(df_name))\n    let mut dfni = 0\n    while dfni < String::length(df_name) {\n      bytebuf_push(df_content, String::char_code_at(df_name, dfni))\n      dfni = dfni + 1\n    }\n    let mut dffi = 0\n    while dffi < Array::length(prov.files) {\n      let df_base = Array::get(prov.files, dffi)\n      let mut df_ci = 0\n      while df_ci < String::length(df_base) {\n        bytebuf_push(df_content, String::char_code_at(df_base, df_ci))\n        df_ci = df_ci + 1\n      }\n      bytebuf_push(df_content, 10)\n      dffi = dffi + 1\n    }\n    bytebuf_push_section(out, 0, df_content)\n  } else {\n    ()\n  }\n  bytebuf_push_section(out, 1, type_content)\n  let import_content = bytebuf_new()\n  bytebuf_push_vec_header(import_content, num_imported_funcs)\n  emit_name(import_content, \"wasi_snapshot_preview1\")\n  emit_name(import_content, \"fd_write\")\n  bytebuf_push(import_content, 0)\n  leb128_encode_u32(import_content, 0)\n  if env_get_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"env-get\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if env_args_len_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"args-len\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 5)\n  }\n  if env_args_get_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"args-get\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_read_file_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_read_file\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_exists_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_exists\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_stat_token_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_stat_token\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_write_file_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_write_file\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 6)\n  }\n  if fs_write_bytes_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_write_bytes\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 6)\n  }\n  // #632: fs_read_bytes — emitted right after fs_write_bytes to match its\n  // reserved index. Type 3 is `(i64) -> i64` (same as fs_read_file).\n  if fs_read_bytes_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_read_bytes\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  // #729/#730: fs_read_dir — emitted right after fs_read_bytes to match its\n  // reserved index. Type 3 is `(i64) -> i64` (same as fs_read_file).\n  if fs_read_dir_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_read_dir\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if profiler_now_us_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"profile-now-us\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 5)\n  }\n  // `vibe.profile-heap-bytes () -> i64` — emitted right after profile-now-us\n  // to match its reserved index. Type 5 is `() -> i64` (same as now-us).\n  if profiler_heap_bytes_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"profile-heap-bytes\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 5)\n  }\n  // `vibe.sleep (i64) -> ()` — reserved index after profiler, matching the\n  // allocation order above. Type 1 is `(i64) -> ()`.\n  if sleep_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"sleep\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // `vibe.stdin_read_char () -> i64` — after sleep, matching allocation order.\n  // Type 5 is `() -> i64` (same as profile-now-us).\n  if stdin_read_char_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"stdin_read_char\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 5)\n  } else {\n    ()\n  }\n  // `vibe.sh (i64) -> i64` and `vibe.sh_lines (i64) -> i64` — reserved after\n  // stdin_read_char (before dbg_break), matching allocation order. Type 3 is\n  // `(i64) -> i64` (same as fs_read_file / fs_read_dir).\n  if sh_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"sh\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  if sh_lines_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"sh_lines\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  // `vibe.stdin_read_stream (i64) -> i64` (type 3, like fs_read_file), then the\n  // two void `vibe.stdout_write_stream` / `vibe.stdout_write_char (i64) -> ()`\n  // (type 1, like sleep) — reserved after sh_lines (before dbg_break), matching\n  // allocation order.\n  if stdin_read_stream_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"stdin_read_stream\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  if stdout_write_stream_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"stdout_write_stream\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  if stdout_write_char_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"stdout_write_char\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // `vibe.resolve_path (i64) -> i64` (type 3, like fs_read_file) — reserved after\n  // stdout_write_char (before dbg_break), matching allocation order.\n  if resolve_path_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"resolve_path\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  // #768: `vibe.fs_remove (i64) -> ()` (type 1, like sleep) — reserved after\n  // resolve_path (before dbg_break), matching allocation order.\n  if fs_remove_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_remove\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // #768: `vibe.fs_mkdir_p (i64) -> ()` (type 1, like fs_remove) — reserved\n  // after fs_remove (before dbg_break), matching allocation order.\n  if fs_mkdir_p_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_mkdir_p\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // #768: `vibe.fs_mkdir (i64) -> ()` (type 1, like fs_remove) — reserved\n  // after fs_mkdir_p, matching allocation order.\n  if fs_mkdir_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_mkdir\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // #768: `vibe.fs_chdir (i64) -> ()` (type 1, like fs_remove) — reserved\n  // after fs_mkdir, matching allocation order.\n  if fs_chdir_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_chdir\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // #768: `vibe.fs_copy (i64, i64) -> ()` (type 6, like fs_write_file).\n  if fs_copy_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_copy\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 6)\n  } else {\n    ()\n  }\n  // #768: `vibe.fs_append (i64, i64) -> ()` (type 6, like fs_write_file).\n  if fs_append_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_append\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 6)\n  } else {\n    ()\n  }\n  // #768: `vibe.fs_rename (i64, i64) -> ()` (type 6, like fs_write_file).\n  if fs_rename_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_rename\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 6)\n  } else {\n    ()\n  }\n  // #768: `vibe.fs_is_dir (i64) -> i64` (type 3, like fs_exists/fs_read_file).\n  if fs_is_dir_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_is_dir\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  // #768: `vibe.fs_is_file (i64) -> i64` (type 3, like fs_exists).\n  if fs_is_file_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_is_file\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  // #768: `vibe.fs_getcwd () -> i64` (type 5, like profile-now-us).\n  if fs_getcwd_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_getcwd\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 5)\n  } else {\n    ()\n  }\n  // #794: `vibe.http_request (i64,i64,i64,i64) -> i64` — the dedicated type\n  // appended after base/closure/dbg types (http_request_type_idx).\n  if http_request_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"http_request\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, http_request_type_idx)\n  } else {\n    ()\n  }\n  // #794: `vibe.http_response_status (i64) -> i64` (type 3, like fs_exists).\n  if http_response_status_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"http_response_status\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  // #794: `vibe.http_response_header (i64, i64) -> i64` (type 4).\n  if http_response_header_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"http_response_header\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 4)\n  } else {\n    ()\n  }\n  // #794: `vibe.http_response_body (i64) -> i64` (type 3, like fs_read_file).\n  if http_response_body_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"http_response_body\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  // #794: `vibe.http_close (i64) -> ()` (type 1, like fs_remove).\n  if http_close_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"http_close\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // #865: `vibe.sh_capture (i64) -> i64` (type 3, like fs_read_file) -- runs\n  // the command once and returns a handle.\n  if sh_capture_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"sh_capture\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  // #865: `vibe.sh_capture_exit_code (i64) -> i64` (type 3, like fs_exists).\n  if sh_capture_exit_code_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"sh_capture_exit_code\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  // #865: `vibe.sh_capture_stdout (i64) -> i64` (type 3, like fs_read_file).\n  if sh_capture_stdout_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"sh_capture_stdout\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  // #865: `vibe.sh_capture_stderr (i64) -> i64` (type 3, like fs_read_file).\n  if sh_capture_stderr_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"sh_capture_stderr\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  } else {\n    ()\n  }\n  // #865: `vibe.sh_capture_close (i64) -> ()` (type 1, like fs_remove).\n  if sh_capture_close_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"sh_capture_close\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // #903/#865: `vibe.process_exit (i64) -> ()` (type 1, like fs_remove).\n  if process_exit_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"process_exit\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  // #865: `vibe.stderr_write_stream (i64) -> ()` / `vibe.stderr_write_char\n  // (i64) -> ()` (type 1, like Stdout's pair).\n  if stderr_write_stream_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"stderr_write_stream\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  if stderr_write_char_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"stderr_write_char\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 1)\n  } else {\n    ()\n  }\n  if dbg_break_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"dbg_break\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 2)\n  }\n  // Interior-line breakpoints (span-arc step5): emit the `vibe::dbg_line` import\n  // descriptor here, AFTER dbg_break and BEFORE the linked imports, matching its\n  // reserved import index order. Type index is the appended `(i32) -> ()` type.\n  if dbg_line_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"dbg_line\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, dbg_line_type_idx)\n  } else {\n    ()\n  }\n  let mut li_emit = 0\n  while li_emit < Array::length(linked_imports) {\n    let (lmod, lfn, lparams, _) = Array::get(linked_imports, li_emit)\n    emit_name(import_content, lmod)\n    emit_name(import_content, lfn)\n    bytebuf_push(import_content, 0)\n    let type_idx = num_base_types + lparams\n    leb128_encode_u32(import_content, type_idx)\n    li_emit = li_emit + 1\n  }\n  bytebuf_push_section(out, 2, import_content)\n  let func_type_indices = lc_fresh_int_array()\n  // #415 B-1: the builtin type indices are declared next to each body push\n  // (push_builtin above), in the exact bodies order — splice them here where\n  // a hand-maintained bare number list used to mirror that order from ~1,400\n  // lines away.\n  let mut bti = 0\n  while bti < Array::length(builtin_type_idxs) {\n    Array::push(func_type_indices, Array::get(builtin_type_idxs, bti))\n    bti = bti + 1\n  }\n  let mut fti = 0\n  while fti < num_user_funcs {\n    let upc = Array::get(fn_param_counts, fti)\n    Array::push(func_type_indices, num_base_types + upc)\n    fti = fti + 1\n  }\n  Array::push(func_type_indices, 2)\n  Array::push(func_type_indices, 5)\n  let mut lfi = 0\n  while lfi < num_lambdas {\n    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1\n    Array::push(func_type_indices, num_base_types + lam_user_params)\n    lfi = lfi + 1\n  }\n  if Array::length(func_type_indices) != Array::length(bodies) {\n    throw(\"WASI codegen internal error: function section and code section count mismatch\")\n  }\n  emit_function_section(out, func_type_indices)\n  let total_table_entries = num_user_funcs + num_lambdas\n  if total_table_entries > 0 {\n    emit_table_section_funcref(out, total_table_entries)\n  }\n  emit_memory_section(out, wasi_memory_min_pages_for_heap(heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve + (if rc_shadow {\n    rc_shadow_reserve()\n  } else {\n    0\n  })))\n  // #721: emit the tag section only when something can reference a tag --\n  // EThrow (`throw 2`), EHandle (try_table over tags 0-3), or a declared\n  // effect (per-effect tags at index 4+). Pure-compute modules then carry no\n  // exceptions machinery at all, which keeps V8 off its slower exnref module\n  // path (~35% wall on call-heavy code; wasmtime is indifferent).\n  let uses_exceptions = Array::length(effect_names_list) > 0 || stmts_contain_exceptions(stmts)\n  if uses_exceptions {\n    let tag_content = bytebuf_new()\n    let num_tags = Array::length(effect_names_list) + 4\n    bytebuf_push_vec_header(tag_content, num_tags)\n    let mut tag_emit_i = 0\n    while tag_emit_i < num_tags {\n      bytebuf_push(tag_content, 0)\n      leb128_encode_u32(tag_content, 1)\n      tag_emit_i = tag_emit_i + 1\n    }\n    bytebuf_push_section(out, 13, tag_content)\n  } else {\n    ()\n  }\n  let global_content = bytebuf_new()\n  // Base globals (bump ptr, effect state, ..., g_op_index) plus two i64\n  // globals per module-level thunk (memo value + init flag) appended last —\n  // see the thunk-body memoization above for the index formula.\n  let tg_num_thunks = Array::length(thunk_names_list)\n  if enable_rc {\n    bytebuf_push_vec_header(global_content, 7 + tg_num_thunks * 2)\n  } else {\n    bytebuf_push_vec_header(global_content, 6 + tg_num_thunks * 2)\n  }\n  bytebuf_push(global_content, 127)\n  bytebuf_push(global_content, 1)\n  emit_i32_const(global_content, heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve)\n  emit_end(global_content)\n  bytebuf_push(global_content, 126)\n  bytebuf_push(global_content, 1)\n  emit_i64_const(global_content, 0)\n  emit_end(global_content)\n  if enable_rc {\n    bytebuf_push(global_content, 127)\n    bytebuf_push(global_content, 1)\n    emit_i32_const(global_content, 0)\n    emit_end(global_content)\n  }\n  bytebuf_push(global_content, 126)\n  bytebuf_push(global_content, 1)\n  emit_i64_const(global_content, 0)\n  emit_end(global_content)\n  bytebuf_push(global_content, 126)\n  bytebuf_push(global_content, 1)\n  emit_i64_const(global_content, 0)\n  emit_end(global_content)\n  bytebuf_push(global_content, 127)\n  bytebuf_push(global_content, 1)\n  emit_i32_const(global_content, heap_start)\n  emit_end(global_content)\n  // #665: g_op_index (i64, mut) — operation index of the perform unwinding to a\n  // handler, for multi-operation dispatch. Appended last; index = rc ? 6 : 5.\n  bytebuf_push(global_content, 126)\n  bytebuf_push(global_content, 1)\n  emit_i64_const(global_content, 0)\n  emit_end(global_content)\n  let mut tg_gi = 0\n  while tg_gi < tg_num_thunks * 2 {\n    bytebuf_push(global_content, 126)\n    bytebuf_push(global_content, 1)\n    emit_i64_const(global_content, 0)\n    emit_end(global_content)\n    tg_gi = tg_gi + 1\n  }\n  bytebuf_push_section(out, 6, global_content)\n  let start_func_idx = func_offset + num_user_funcs\n  let run_func_idx = start_func_idx + 1\n  let all_export_names = lc_fresh_string_array()\n  let all_export_indices = lc_fresh_int_array()\n  if !library_mode {\n    Array::push(all_export_names, \"_start\")\n    Array::push(all_export_indices, start_func_idx)\n  }\n  if !library_mode && entry_func_idx >= 0 && !array_contains_str(all_export_names, entry_name) {\n    Array::push(all_export_names, entry_name)\n    Array::push(all_export_indices, entry_func_idx)\n  }\n  let mut exi = 0\n  while exi < Array::length(export_fn_names) {\n    let ename = Array::get(export_fn_names, exi)\n    let skip_export = library_mode && ename == entry_name\n    if !skip_export && !array_contains_str(all_export_names, ename) {\n      Array::push(all_export_names, ename)\n      Array::push(all_export_indices, Array::get(export_fn_user_indices, exi) + func_offset)\n    }\n    exi = exi + 1\n  }\n  // Per-block bench: export each `__bench_<name>` function so the runner's\n  // `--bench` mode can time benchmark blocks individually (instead of running the\n  // whole `_start`). Only `__no_entry__` test/bench builds populate test_fn_names,\n  // so normal builds (incl. the compiler self-compile) are byte-identical. The\n  // wasm index of a user function at user-index `j` is `j + func_offset`.\n  let mut bxi = 0\n  while bxi < Array::length(test_fn_names) {\n    let bname = Array::get(test_fn_names, bxi)\n    if String::starts_with(bname, \"__bench_\") && !array_contains_str(all_export_names, bname) {\n      let mut bj = 0\n      let mut bfound = 0 - 1\n      while bj < num_user_funcs {\n        if Array::get(fn_names_list, bj) == bname {\n          bfound = bj\n          bj = num_user_funcs\n        } else {\n          bj = bj + 1\n        }\n      }\n      if bfound >= 0 {\n        Array::push(all_export_names, bname)\n        Array::push(all_export_indices, bfound + func_offset)\n      }\n    }\n    bxi = bxi + 1\n  }\n  let export_content = bytebuf_new()\n  // #721: the \"error\" tag export exists only when the tag section does.\n  let export_count = Array::length(all_export_names) + 1 +\n  (if library_mode {\n    0\n  } else {\n    1 + (if uses_exceptions {\n      1\n    } else {\n      0\n    })\n  })\n  bytebuf_push_vec_header(export_content, export_count)\n  let mut efi = 0\n  while efi < Array::length(all_export_names) {\n    emit_name(export_content, Array::get(all_export_names, efi))\n    bytebuf_push(export_content, 0)\n    leb128_encode_u32(export_content, Array::get(all_export_indices, efi))\n    efi = efi + 1\n  }\n  emit_name(export_content, \"memory\")\n  bytebuf_push(export_content, 2)\n  leb128_encode_u32(export_content, 0)\n  if !library_mode {\n    emit_name(export_content, \"__heap_ptr\")\n    bytebuf_push(export_content, 3)\n    leb128_encode_u32(export_content, 0)\n    if uses_exceptions {\n      emit_name(export_content, \"error\")\n      bytebuf_push(export_content, 4)\n      leb128_encode_u32(export_content, 0)\n    } else {\n      ()\n    }\n  }\n  bytebuf_push_section(out, 7, export_content)\n  if total_table_entries > 0 {\n    let table_func_indices = lc_fresh_int_array()\n    let mut tei = 0\n    while tei < num_user_funcs {\n      Array::push(table_func_indices, func_offset + tei)\n      tei = tei + 1\n    }\n    let mut tej = 0\n    while tej < num_lambdas {\n      Array::push(table_func_indices, run_func_idx + 1 + tej)\n      tej = tej + 1\n    }\n    emit_element_section_active(out, table_func_indices)\n  }\n  let code_content = bytebuf_new()\n  bytebuf_push_vec_header(code_content, Array::length(bodies))\n  let mut ci = 0\n  while ci < Array::length(bodies) {\n    let body = Array::get(bodies, ci)\n    let func_buf = bytebuf_new()\n    let ni32 = Array::get(meta_i32, ci)\n    let ni64 = Array::get(meta_i64, ci)\n    if ni32 == 0 {\n      if ni64 == 0 {\n        leb128_encode_u32(func_buf, 0)\n      } else {\n        leb128_encode_u32(func_buf, 1)\n        leb128_encode_u32(func_buf, ni64)\n        bytebuf_push(func_buf, 126)\n      }\n    } else {\n      if ni64 == 0 {\n        leb128_encode_u32(func_buf, 1)\n        leb128_encode_u32(func_buf, ni32)\n        bytebuf_push(func_buf, 127)\n      } else {\n        leb128_encode_u32(func_buf, 2)\n        leb128_encode_u32(func_buf, ni32)\n        bytebuf_push(func_buf, 127)\n        leb128_encode_u32(func_buf, ni64)\n        bytebuf_push(func_buf, 126)\n      }\n    }\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\n    bytebuf_push_buf(code_content, func_buf)\n    ci = ci + 1\n  }\n  bytebuf_push_section(out, 10, code_content)\n  if num_strings > 0 {\n    let data_offsets = lc_fresh_int_array()\n    let data_bufs = lc_fresh_bytes_array()\n    let mut di = 0\n    while di < num_strings {\n      Array::push(data_offsets, Array::get(str_offsets, di))\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\n      di = di + 1\n    }\n    emit_data_section_multi(out, data_offsets, data_bufs)\n  }\n  // Name section (debugger P0 / ADR-0035): name the user functions so wasm\n  // backtraces and tooling show `main` etc. instead of `<wasm function N>`.\n  // User functions occupy consecutive indices starting at `func_offset`.\n  // #768: emit ONLY the first num_user_funcs entries -- fn_names_list also\n  // carries the builtin/runtime names appended for call resolution (Env::get,\n  // Fs::read_file, ...), but those bodies live at LOW indices (below\n  // func_offset). Emitting the whole list consecutively shifted every\n  // post-user name: `_start` was labeled `Env::get` in crash stacks, which\n  // repeatedly sent debugging to functions the trace never touched. `_start`\n  // and `run` sit right after the user block, so name them explicitly.\n  // #799: name the GENERATED runtime helpers too. Profilers (node --cpu-prof)\n  // attributed the hottest samples to anonymous wasm-function[N] frames\n  // because only user functions carried name-section entries; the generated\n  // string/array/bytes helpers occupy the consecutive index range\n  // [num_imported_funcs, func_offset). Unassigned slots (lambda-arity pads\n  // etc.) keep the generic \"__rt_gen\" label.\n  let gen_sec_names = lc_fresh_string_array()\n  let mut gsn_i = 0\n  while gsn_i < num_generated {\n    Array::push(gen_sec_names, \"__rt_gen\")\n    gsn_i = gsn_i + 1\n  }\n  Array::set(gen_sec_names, print_int_idx - num_imported_funcs, \"__rt_print_int\")\n  Array::set(gen_sec_names, print_str_idx - num_imported_funcs, \"__rt_print_str\")\n  Array::set(gen_sec_names, str_len_idx - num_imported_funcs, \"__rt_str_len\")\n  Array::set(gen_sec_names, str_eq_idx - num_imported_funcs, \"__rt_str_eq\")\n  Array::set(gen_sec_names, str_concat_idx - num_imported_funcs, \"__rt_str_concat\")\n  Array::set(gen_sec_names, arr_new_idx - num_imported_funcs, \"__rt_arr_new\")\n  Array::set(gen_sec_names, arr_len_idx - num_imported_funcs, \"__rt_arr_len\")\n  Array::set(gen_sec_names, arr_get_idx - num_imported_funcs, \"__rt_arr_get\")\n  Array::set(gen_sec_names, arr_push_idx - num_imported_funcs, \"__rt_arr_push\")\n  Array::set(gen_sec_names, arr_set_idx - num_imported_funcs, \"__rt_arr_set\")\n  Array::set(gen_sec_names, double_to_int_idx - num_imported_funcs, \"__rt_double_to_int\")\n  Array::set(gen_sec_names, int_to_double_idx - num_imported_funcs, \"__rt_int_to_double\")\n  Array::set(gen_sec_names, str_char_code_at_idx - num_imported_funcs, \"__rt_str_char_code_at\")\n  Array::set(gen_sec_names, str_from_char_code_idx - num_imported_funcs, \"__rt_str_from_char_code\")\n  Array::set(gen_sec_names, str_substring_idx - num_imported_funcs, \"__rt_str_substring\")\n  Array::set(gen_sec_names, identity_idx - num_imported_funcs, \"__rt_identity\")\n  Array::set(gen_sec_names, arr_slice_idx - num_imported_funcs, \"__rt_arr_slice\")\n  Array::set(gen_sec_names, arr_concat_idx - num_imported_funcs, \"__rt_arr_concat\")\n  Array::set(gen_sec_names, arr_truncate_idx - num_imported_funcs, \"__rt_arr_truncate\")\n  Array::set(gen_sec_names, string_join_idx - num_imported_funcs, \"__rt_string_join\")\n  Array::set(gen_sec_names, fs_read_file_stub_idx - num_imported_funcs, \"__rt_stub_a\")\n  Array::set(gen_sec_names, fs_exists_stub_idx - num_imported_funcs, \"__rt_stub_b\")\n  Array::set(gen_sec_names, fs_stat_token_stub_idx - num_imported_funcs, \"__rt_stub_c\")\n  Array::set(gen_sec_names, fs_write_file_stub_idx - num_imported_funcs, \"__rt_stub_d\")\n  Array::set(gen_sec_names, fs_write_bytes_stub_idx - num_imported_funcs, \"__rt_stub_e\")\n  Array::set(gen_sec_names, eq_idx - num_imported_funcs, \"__rt_eq\")\n  Array::set(gen_sec_names, string_ends_with_idx - num_imported_funcs, \"__rt_string_ends_with\")\n  Array::set(gen_sec_names, string_last_index_of_idx - num_imported_funcs, \"__rt_string_last_index_of\")\n  Array::set(gen_sec_names, arr_push_all_idx - num_imported_funcs, \"__rt_arr_push_all\")\n  Array::set(gen_sec_names, string_index_of_idx - num_imported_funcs, \"__rt_string_index_of\")\n  Array::set(gen_sec_names, string_contains_idx - num_imported_funcs, \"__rt_string_contains\")\n  Array::set(gen_sec_names, string_starts_with_idx - num_imported_funcs, \"__rt_string_starts_with\")\n  Array::set(gen_sec_names, string_split_idx - num_imported_funcs, \"__rt_string_split\")\n  Array::set(gen_sec_names, string_trim_idx - num_imported_funcs, \"__rt_string_trim\")\n  Array::set(gen_sec_names, sources_idx - num_imported_funcs, \"__rt_sources\")\n  Array::set(gen_sec_names, bytes_new_idx - num_imported_funcs, \"__rt_bytes_new\")\n  Array::set(gen_sec_names, bytes_len_idx - num_imported_funcs, \"__rt_bytes_len\")\n  Array::set(gen_sec_names, bytes_get_idx - num_imported_funcs, \"__rt_bytes_get\")\n  Array::set(gen_sec_names, bytes_set_idx - num_imported_funcs, \"__rt_bytes_set\")\n  Array::set(gen_sec_names, bytes_push_idx - num_imported_funcs, \"__rt_bytes_push\")\n  Array::set(gen_sec_names, bytes_append_idx - num_imported_funcs, \"__rt_bytes_append\")\n  Array::set(gen_sec_names, bytes_concat_idx - num_imported_funcs, \"__rt_bytes_concat\")\n  Array::set(gen_sec_names, bytes_slice_idx - num_imported_funcs, \"__rt_bytes_slice\")\n  Array::set(gen_sec_names, bytes_from_array_idx - num_imported_funcs, \"__rt_bytes_from_array\")\n  Array::set(gen_sec_names, bytes_to_array_idx - num_imported_funcs, \"__rt_bytes_to_array\")\n  if enable_rc {\n    Array::set(gen_sec_names, rc_drop_idx - num_imported_funcs, \"__rt_rc_drop\")\n    Array::set(gen_sec_names, rc_alloc_idx - num_imported_funcs, \"__rt_rc_alloc\")\n  } else {\n    ()\n  }\n  Array::set(gen_sec_names, heap_grow_check_idx - num_imported_funcs, \"__rt_heap_grow_check\")\n  Array::set(gen_sec_names, simd_skip_ws_idx - num_imported_funcs, \"__rt_simd_skip_ws\")\n  Array::set(gen_sec_names, simd_scan_alnum_idx - num_imported_funcs, \"__rt_simd_scan_alnum\")\n  Array::set(gen_sec_names, simd_scan_alnum_str_idx - num_imported_funcs, \"__rt_simd_scan_alnum_str\")\n  Array::set(gen_sec_names, str_lex_diff_idx - num_imported_funcs, \"__rt_str_lex_diff\")\n  Array::set(gen_sec_names, generic_rel_diff_idx - num_imported_funcs, \"__rt_generic_rel_diff\")\n  Array::set(gen_sec_names, generic_add_idx - num_imported_funcs, \"__rt_generic_add\")\n  let name_sec_names = gen_sec_names\n  let mut usn_i = 0\n  while usn_i < num_user_funcs {\n    Array::push(name_sec_names, Array::get(fn_names_list, usn_i))\n    usn_i = usn_i + 1\n  }\n  Array::push(name_sec_names, \"_start\")\n  Array::push(name_sec_names, \"run\")\n  emit_function_name_section(out, name_sec_names, num_imported_funcs)\n  bytebuf_to_bytes(out)\n}\n\nexport fn compile_wasi_module_rc_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  let stmts = elaborate_heap_params(stmts_in)\n  compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, true, false, false, false, false, empty_dbg_prov())\n}\n\n// #715 recurrence guard: RC + shadow-liveness instrumentation (VIBE_RC=shadow).\nexport fn compile_wasi_module_rc_shadow_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  let stmts = elaborate_heap_params(stmts_in)\n  compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, true, false, false, false, true, empty_dbg_prov())\n}\n\nexport fn compile_wasi_module_with_sources_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error } {\n  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, false, false, false, false, false, empty_dbg_prov())\n}\n\n// Coverage build (#cov): compile with function-level hit instrumentation +\n// `vibe_cov` custom section. Same as compile_wasi_module_with_sources_impl but\n// with coverage enabled.\nexport fn compile_wasi_module_with_sources_coverage_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error } {\n  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, true, true, false, false, false, empty_dbg_prov())\n}\n\n// Trace build (debugger / DAP P1 groundwork): compile with function-call\n// execution-trace instrumentation + `vibe.trace` custom section. Same as\n// compile_wasi_module_with_sources_impl but with debug_trace enabled.\nexport fn compile_wasi_module_with_sources_trace_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with { Error } {\n  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, true, false, true, false, false, empty_dbg_prov())\n}\n\n// Break build (debugger / DAP P1): compile with `vibe::dbg_break` host-hook\n// instrumentation at each user function entry. Same as\n// compile_wasi_module_with_sources_impl but with debug_break enabled.\nexport fn compile_wasi_module_with_sources_break_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], prov: DbgProv) -> Bytes with { Error } {\n  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, true, false, false, true, false, prov)\n}\n")
}

let cli_adapter_source_105 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/component_codegen.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_code_section, emit_export_section, emit_func_type_raw, emit_function_section, emit_header, emit_i32_add, emit_i32_const, emit_i32_store, emit_i64_const, emit_local_get, emit_local_set, emit_name\n}\n\n//# Functions\n\nfn read_uleb(bytes: Bytes, start: Int) -> (Int, Int) {\n  let mut value = 0\n  let mut shift = 0\n  let mut i = start\n  let len = Bytes::length(bytes)\n  let mut done = false\n  while (i < len) && (done == false) {\n    let b = Bytes::get(bytes, i)\n    value = value|((b&127)<<shift)\n    i = i + 1\n    if (b&128) == 0 {\n      done = true\n    } else {\n      shift = shift + 7\n    }\n  }\n  (value, i)\n}\n\nlet section_type = 7\n\nlet core_sort_mem = 2\n\nfn new_int_array() -> Array[Int] {\n  array_empty()\n}\n\nlet section_alias = 6\n\nlet section_canon = 8\n\nlet core_sort_func = 0\n\nfn read_name_info(bytes: Bytes, start: Int) -> (Int, Int) {\n  read_uleb(bytes, start)\n}\n\nfn skip_name(bytes: Bytes, start: Int) -> Int {\n  let (name_len, after_len) = read_name_info(bytes, start)\n  after_len + name_len\n}\n\nlet section_export = 11\n\nlet section_import = 10\n\nlet section_module = 1\n\nfn parse_type_sigs(bytes: Bytes, sec_start: Int, sec_end: Int, out_sigs: Array[Array[Int]]) -> Unit {\n  let mut j = sec_start\n  let (type_count, next_j) = read_uleb(bytes, j)\n  j = next_j\n  let mut t = 0\n  while t < type_count {\n    if j >= sec_end {\n      t = type_count\n    }\n    else {\n      let form = Bytes::get(bytes, j)\n      j = j + 1\n      if form != 96 {\n        t = type_count\n      }\n      else {\n        let sig = new_int_array()\n        let (param_count, next_j2) = read_uleb(bytes, j)\n        j = next_j2\n        Array::push(sig, param_count)\n        let mut p = 0\n        while p < param_count {\n          if j >= sec_end {\n            p = param_count\n          }\n          else {\n            Array::push(sig, Bytes::get(bytes, j))\n            j = j + 1\n            p = p + 1\n          }\n        }\n        let (result_count, next_j3) = read_uleb(bytes, j)\n        j = next_j3\n        Array::push(sig, result_count)\n        let mut rv = 0\n        while rv < result_count {\n          if j >= sec_end {\n            rv = result_count\n          }\n          else {\n            Array::push(sig, Bytes::get(bytes, j))\n            j = j + 1\n            rv = rv + 1\n          }\n        }\n        Array::push(out_sigs, sig)\n        t = t + 1\n      }\n    }\n  }\n}\n\nlet comp_extern_func = 1\n\nlet comp_valtype_f32 = 118\n\nlet comp_valtype_f64 = 117\n\nlet comp_valtype_s32 = 122\n\nlet comp_valtype_s64 = 120\n\nfn emit_raw_content(buf: Bytes, content: Bytes) -> Unit {\n  leb128_encode_u32(buf, Bytes::length(content))\n  bytebuf_push_buf(buf, content)\n}\n\nfn read_name_string(bytes: Bytes, start: Int) -> String {\n  let (name_len, after_len) = read_name_info(bytes, start)\n  // Char-by-char: was `s = String::concat(s, char)` per byte, O(N²) on\n  // the name length (which can be hundreds of chars for mangled\n  // identifiers).\n  let buf = StringBuilder::new()\n  let mut i = 0\n  while i < name_len {\n    StringBuilder::push(buf, String::from_char_code(Bytes::get(bytes, after_len + i)))\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nfn skip_wasm_limits(bytes: Bytes, start: Int, end_pos: Int) -> Int {\n  let mut i = start\n  if i >= end_pos {\n    end_pos\n  }\n  else {\n    let flags = Bytes::get(bytes, i)\n    i = i + 1\n    let (min_limit, next_i1) = read_uleb(bytes, i)\n    let _ = min_limit\n    i = next_i1\n    if (flags&1) != 0 {\n      let (max_limit, next_i2) = read_uleb(bytes, i)\n      let _ = max_limit\n      i = next_i2\n    }\n    if (flags&4) != 0 {\n      let (page_size, next_i3) = read_uleb(bytes, i)\n      let _ = page_size\n      i = next_i3\n    }\n    if i > end_pos {\n      end_pos\n    } else {\n      i\n    }\n  }\n}\n\nlet component_magic_0 = 0\n\nlet component_magic_1 = 97\n\nlet component_magic_2 = 115\n\nlet component_magic_3 = 109\n\nfn emit_alias_section(buf: Bytes, core_instance_idx: Int, names: Array[String], sorts: Array[Int]) -> Unit {\n  let count = Array::length(names)\n  if count == 0 {\n    ()\n  }\n  else {\n    bytebuf_push(buf, section_alias)\n    let content = bytebuf_new()\n    leb128_encode_u32(content, count)\n    let mut i = 0\n    while i < count {\n      bytebuf_push(content, 0)\n      bytebuf_push(content, Array::get(sorts, i))\n      bytebuf_push(content, 1)\n      leb128_encode_u32(content, core_instance_idx)\n      emit_name(content, Array::get(names, i))\n      i = i + 1\n    }\n    emit_raw_content(buf, content)\n  }\n}\n\nlet comp_valtype_string = 115\n\nlet component_version_0 = 13\n\nlet component_version_1 = 0\n\nlet component_version_2 = 1\n\nlet component_version_3 = 0\n\nfn core_to_comp_valtype(v: Int) -> Int {\n  if v == 127 {\n    comp_valtype_s32\n  }\n  else {\n    if v == 126 {\n      comp_valtype_s64\n    }\n    else {\n      if v == 125 {\n        comp_valtype_f32\n      }\n      else {\n        if v == 124 {\n          comp_valtype_f64\n        }\n        else {\n          0 - 1\n        }\n      }\n    }\n  }\n}\n\nfn emit_canon_lift_func(content: Bytes, core_func_idx: Int, type_idx: Int, need_string: Int, memory_idx: Int, realloc_idx: Int) -> Unit {\n  bytebuf_push(content, 0)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, core_func_idx)\n  if need_string != 0 {\n    leb128_encode_u32(content, 3)\n    bytebuf_push(content, 0)\n    bytebuf_push(content, 3)\n    leb128_encode_u32(content, memory_idx)\n    bytebuf_push(content, 4)\n    leb128_encode_u32(content, realloc_idx)\n  } else {\n    leb128_encode_u32(content, 0)\n  }\n  leb128_encode_u32(content, type_idx)\n}\n\nfn emit_component_header(buf: Bytes) -> Unit {\n  bytebuf_push(buf, component_magic_0)\n  bytebuf_push(buf, component_magic_1)\n  bytebuf_push(buf, component_magic_2)\n  bytebuf_push(buf, component_magic_3)\n  bytebuf_push(buf, component_version_0)\n  bytebuf_push(buf, component_version_1)\n  bytebuf_push(buf, component_version_2)\n  bytebuf_push(buf, component_version_3)\n}\n\nlet section_core_instance = 2\n\nfn skip_core_import_desc(bytes: Bytes, start: Int, kind: Int, end_pos: Int) -> Int {\n  let mut i = start\n  if kind == 1 {\n    if i < end_pos {\n      i = i + 1\n    }\n    i = skip_wasm_limits(bytes, i, end_pos)\n  } else {\n    if kind == 2 {\n      i = skip_wasm_limits(bytes, i, end_pos)\n    } else {\n      if kind == 3 {\n        if (i + 2) <= end_pos {\n          i = i + 2\n        } else {\n          i = end_pos\n        }\n      } else {\n        if kind == 4 {\n          if i < end_pos {\n            i = i + 1\n          }\n          let (type_idx, next_i) = read_uleb(bytes, i)\n          let _ = type_idx\n          i = next_i\n        } else {\n          i = end_pos\n        }\n      }\n    }\n  }\n  if i > end_pos {\n    end_pos\n  } else {\n    i\n  }\n}\n\nfn parse_core_exports(core_wasm: Bytes, out_names: Array[String], out_func_indices: Array[Int], out_type_sigs: Array[Array[Int]]) -> Int {\n  let len = Bytes::length(core_wasm)\n  if len < 8 {\n    0\n  }\n  else {\n    let type_sigs = array_empty()\n    let func_type_indices = new_int_array()\n    let mut import_func_count = 0\n    let mut i = 8\n    let mut export_count = 0\n    while i < len {\n      let sec_id = Bytes::get(core_wasm, i)\n      i = i + 1\n      let (sec_size, next_i) = read_uleb(core_wasm, i)\n      i = next_i\n      let sec_end = i + sec_size\n      if sec_end > len {\n        i = len\n      }\n      else {\n        if sec_id == 1 {\n          parse_type_sigs(core_wasm, i, sec_end, type_sigs)\n        } else {\n          if sec_id == 2 {\n            let mut j = i\n            let (imp_count, next_j) = read_uleb(core_wasm, j)\n            j = next_j\n            let mut imp = 0\n            while imp < imp_count {\n              if j >= sec_end {\n                imp = imp_count\n              }\n              else {\n                j = skip_name(core_wasm, j)\n                j = skip_name(core_wasm, j)\n                if j >= sec_end {\n                  imp = imp_count\n                }\n                else {\n                  let kind = Bytes::get(core_wasm, j)\n                  j = j + 1\n                  if kind == 0 {\n                    let (type_idx, next_j2) = read_uleb(core_wasm, j)\n                    let _ = type_idx\n                    j = next_j2\n                    import_func_count = import_func_count + 1\n                  } else {\n                    j = skip_core_import_desc(core_wasm, j, kind, sec_end)\n                  }\n                  imp = imp + 1\n                }\n              }\n            }\n          } else {\n            if sec_id == 3 {\n              let mut j = i\n              let (func_count, next_j) = read_uleb(core_wasm, j)\n              j = next_j\n              let mut f = 0\n              while f < func_count {\n                if j >= sec_end {\n                  f = func_count\n                }\n                else {\n                  let (type_idx, next_j2) = read_uleb(core_wasm, j)\n                  Array::push(func_type_indices, type_idx)\n                  j = next_j2\n                  f = f + 1\n                }\n              }\n            } else {\n              if sec_id == 7 {\n                let mut j = i\n                let (exp_count, next_j) = read_uleb(core_wasm, j)\n                j = next_j\n                let mut e = 0\n                while e < exp_count {\n                  if j >= sec_end {\n                    e = exp_count\n                  }\n                  else {\n                    let name = read_name_string(core_wasm, j)\n                    j = skip_name(core_wasm, j)\n                    if j >= sec_end {\n                      e = exp_count\n                    }\n                    else {\n                      let kind = Bytes::get(core_wasm, j)\n                      j = j + 1\n                      let (index, next_j2) = read_uleb(core_wasm, j)\n                      j = next_j2\n                      if kind == 0 {\n                        let type_idx = if index < import_func_count {\n                          0 - 1\n                        }\n                        else {\n                          let local_idx = index - import_func_count\n                          if local_idx < Array::length(func_type_indices) {\n                            Array::get(func_type_indices, local_idx)\n                          } else {\n                            0 - 1\n                          }\n                        }\n                        if (type_idx >= 0) && (type_idx < Array::length(type_sigs)) {\n                          Array::push(out_names, name)\n                          Array::push(out_func_indices, index)\n                          Array::push(out_type_sigs, Array::get(type_sigs, type_idx))\n                          export_count = export_count + 1\n                        }\n                      }\n                      e = e + 1\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n        i = sec_end\n      }\n    }\n    export_count\n  }\n}\n\nfn parse_core_imports(core_wasm: Bytes, out_module_names: Array[String], out_func_names: Array[String], out_type_indices: Array[Int], out_type_sigs: Array[Array[Int]]) -> Int {\n  let len = Bytes::length(core_wasm)\n  if len < 8 {\n    0\n  }\n  else {\n    let mut i = 8\n    let mut import_count = 0\n    while i < len {\n      let sec_id = Bytes::get(core_wasm, i)\n      i = i + 1\n      let (sec_size, next_i) = read_uleb(core_wasm, i)\n      i = next_i\n      let sec_end = i + sec_size\n      if sec_end > len {\n        i = len\n      }\n      else {\n        if sec_id == 1 {\n          parse_type_sigs(core_wasm, i, sec_end, out_type_sigs)\n        } else {\n          if sec_id == 2 {\n            let mut j = i\n            let (imp_count, next_j) = read_uleb(core_wasm, j)\n            j = next_j\n            let mut imp = 0\n            while imp < imp_count {\n              if j >= sec_end {\n                imp = imp_count\n              }\n              else {\n                let mod_name = read_name_string(core_wasm, j)\n                j = skip_name(core_wasm, j)\n                let fn_name = read_name_string(core_wasm, j)\n                j = skip_name(core_wasm, j)\n                if j >= sec_end {\n                  imp = imp_count\n                }\n                else {\n                  let kind = Bytes::get(core_wasm, j)\n                  j = j + 1\n                  if kind == 0 {\n                    let (type_idx, next_j2) = read_uleb(core_wasm, j)\n                    j = next_j2\n                    Array::push(out_module_names, mod_name)\n                    Array::push(out_func_names, fn_name)\n                    Array::push(out_type_indices, type_idx)\n                    import_count = import_count + 1\n                  } else {\n                    j = skip_core_import_desc(core_wasm, j, kind, sec_end)\n                  }\n                  imp = imp + 1\n                }\n              }\n            }\n          }\n        }\n        i = sec_end\n      }\n    }\n    import_count\n  }\n}\n\nfn build_import_plan(core_wasm: Bytes, out_import_names: Array[String], out_binding_func_names: Array[String], out_binding_func_indices: Array[Int], out_unique_module_names: Array[String], out_module_binding_counts: Array[Int], out_comp_params: Array[Array[Int]], out_comp_param_names: Array[Array[String]], out_comp_results: Array[Array[Int]]) -> Int {\n  let imp_module_names = array_empty()\n  let imp_func_names = array_empty()\n  let imp_type_indices = new_int_array()\n  let type_sigs = array_empty()\n  let _ = parse_core_imports(core_wasm, imp_module_names, imp_func_names, imp_type_indices, type_sigs)\n  let seen_keys = array_empty()\n  let module_idx_map_keys = array_empty()\n  let module_idx_map_vals = new_int_array()\n  let mut binding_count = 0\n  let mut i = 0\n  while i < Array::length(imp_module_names) {\n    let mod_name = Array::get(imp_module_names, i)\n    let fn_name = Array::get(imp_func_names, i)\n    let key = \"\\{mod_name}||\\{fn_name}\"\n    let mut already = false\n    let mut s = 0\n    while s < Array::length(seen_keys) {\n      if Array::get(seen_keys, s) == key {\n        already = true\n      }\n      s = s + 1\n    }\n    if already == false {\n      Array::push(seen_keys, key)\n      let type_idx = Array::get(imp_type_indices, i)\n      if type_idx < Array::length(type_sigs) {\n        let sig = Array::get(type_sigs, type_idx)\n        let param_count = Array::get(sig, 0)\n        let result_count_index = 1 + param_count\n        let result_count = Array::get(sig, result_count_index)\n        let comp_params = new_int_array()\n        let mut valid = true\n        let mut p = 0\n        while p < param_count {\n          let cv = core_to_comp_valtype(Array::get(sig, 1 + p))\n          if cv < 0 {\n            valid = false\n          }\n          else {\n            Array::push(comp_params, cv)\n          }\n          p = p + 1\n        }\n        let comp_results = new_int_array()\n        let mut r = 0\n        while r < result_count {\n          let cv = core_to_comp_valtype(Array::get(sig, result_count_index + 1 + r))\n          if cv < 0 {\n            valid = false\n          }\n          else {\n            Array::push(comp_results, cv)\n          }\n          r = r + 1\n        }\n        if valid {\n          let mut mod_idx = 0 - 1\n          let mut mi = 0\n          while mi < Array::length(module_idx_map_keys) {\n            if Array::get(module_idx_map_keys, mi) == mod_name {\n              mod_idx = Array::get(module_idx_map_vals, mi)\n            }\n            mi = mi + 1\n          }\n          if mod_idx < 0 {\n            mod_idx = Array::length(out_unique_module_names)\n            Array::push(out_unique_module_names, mod_name)\n            Array::push(out_module_binding_counts, 0)\n            Array::push(module_idx_map_keys, mod_name)\n            Array::push(module_idx_map_vals, mod_idx)\n          }\n          let import_name = \"import-\\{binding_count}\"\n          Array::push(out_import_names, import_name)\n          Array::push(out_binding_func_names, fn_name)\n          Array::push(out_binding_func_indices, binding_count)\n          Array::push(out_comp_params, comp_params)\n          let empty_names = array_empty()\n          Array::push(out_comp_param_names, empty_names)\n          Array::push(out_comp_results, comp_results)\n          let cur = Array::get(out_module_binding_counts, mod_idx)\n          Array::set(out_module_binding_counts, mod_idx, cur + 1)\n          binding_count = binding_count + 1\n        }\n      }\n    }\n    i = i + 1\n  }\n  binding_count\n}\n\nlet comp_inst_arg_instance = 18\n\nfn emit_canon_lift_section(buf: Bytes, core_func_idx: Int, type_idx: Int) -> Unit {\n  bytebuf_push(buf, section_canon)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  emit_canon_lift_func(content, core_func_idx, type_idx, 0, 0, 0)\n  emit_raw_content(buf, content)\n}\n\nfn emit_canon_lower_section(buf: Bytes, count: Int) -> Unit {\n  if count == 0 {\n    ()\n  }\n  else {\n    bytebuf_push(buf, section_canon)\n    let content = bytebuf_new()\n    leb128_encode_u32(content, count)\n    let mut i = 0\n    while i < count {\n      bytebuf_push(content, 1)\n      bytebuf_push(content, 0)\n      leb128_encode_u32(content, i)\n      leb128_encode_u32(content, 0)\n      i = i + 1\n    }\n    emit_raw_content(buf, content)\n  }\n}\n\nfn emit_comp_import_section(buf: Bytes, import_names: Array[String], count: Int) -> Unit {\n  if count == 0 {\n    ()\n  }\n  else {\n    bytebuf_push(buf, section_import)\n    let content = bytebuf_new()\n    leb128_encode_u32(content, count)\n    let mut i = 0\n    while i < count {\n      bytebuf_push(content, 0)\n      emit_name(content, Array::get(import_names, i))\n      bytebuf_push(content, comp_extern_func)\n      leb128_encode_u32(content, i)\n      i = i + 1\n    }\n    emit_raw_content(buf, content)\n  }\n}\n\nfn emit_core_module_section(buf: Bytes, core_wasm: Bytes) -> Unit {\n  bytebuf_push(buf, section_module)\n  let wasm_len = Bytes::length(core_wasm)\n  leb128_encode_u32(buf, wasm_len)\n  bytebuf_push_buf(buf, core_wasm)\n}\n\nfn emit_alias_run_and_memory(buf: Bytes, core_instance_idx: Int) -> Unit {\n  emit_alias_section(buf, core_instance_idx, [\n    \"_start\",\n    \"memory\"\n  ], [\n    core_sort_func,\n    core_sort_mem\n  ])\n}\n\n// Seed-compatible `_` -> `-` rewrite. `String::replace_all` is newer than the\n// pinned selfhost seed's frozen prelude, so a manual char loop keeps this file\n// buildable from the fixed seed (docs/selfhost-bootstrap.md, new-feature rule).\nfn comp_underscores_to_dashes(name: String) -> String {\n  let len = String::length(name)\n  let mut out = \"\"\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(name, i)\n    if c == 95 {\n      out = String::concat(out, \"-\")\n    } else {\n      out = String::concat(out, String::from_char_code(c))\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn normalize_comp_param_name(name: String) -> String {\n  comp_underscores_to_dashes(name)\n}\n\nfn emit_comp_func_type(content: Bytes, param_types: Array[Int], param_names: Array[String], result_types: Array[Int], is_async: Int) -> Unit {\n  if is_async != 0 {\n    bytebuf_push(content, 67)\n  } else {\n    bytebuf_push(content, 64)\n  }\n  leb128_encode_u32(content, Array::length(param_types))\n  let mut i = 0\n  while i < Array::length(param_types) {\n    let name = if i < Array::length(param_names) {\n      normalize_comp_param_name(Array::get(param_names, i))\n    }\n    else {\n      \"p\\{i}\"\n    }\n    emit_name(content, name)\n    bytebuf_push(content, Array::get(param_types, i))\n    i = i + 1\n  }\n  if Array::length(result_types) == 0 {\n    bytebuf_push(content, 1)\n    leb128_encode_u32(content, 0)\n  } else {\n    if Array::length(result_types) == 1 {\n      bytebuf_push(content, 0)\n      bytebuf_push(content, Array::get(result_types, 0))\n    } else {\n      bytebuf_push(content, 1)\n      leb128_encode_u32(content, Array::length(result_types))\n      let mut r = 0\n      while r < Array::length(result_types) {\n        emit_name(content, \"r\\{r}\")\n        bytebuf_push(content, Array::get(result_types, r))\n        r = r + 1\n      }\n    }\n  }\n}\n\nfn emit_comp_type_section(buf: Bytes, sigs_params: Array[Array[Int]], sigs_param_names: Array[Array[String]], sigs_results: Array[Array[Int]], sigs_async: Array[Int]) -> Unit {\n  let count = Array::length(sigs_params)\n  if count == 0 {\n    ()\n  }\n  else {\n    bytebuf_push(buf, section_type)\n    let content = bytebuf_new()\n    leb128_encode_u32(content, count)\n    let mut i = 0\n    while i < count {\n      emit_comp_func_type(content, Array::get(sigs_params, i), Array::get(sigs_param_names, i), Array::get(sigs_results, i), Array::get(sigs_async, i))\n      i = i + 1\n    }\n    emit_raw_content(buf, content)\n  }\n}\n\nfn emit_comp_type_section_run(buf: Bytes) -> Unit {\n  bytebuf_push(buf, section_type)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  emit_comp_func_type(content, array_empty(), array_empty(), [\n    comp_valtype_s64\n  ], 0)\n  emit_raw_content(buf, content)\n}\n\nfn normalize_comp_export_name(name: String) -> String {\n  comp_underscores_to_dashes(name)\n}\n\nfn emit_comp_export_section(buf: Bytes, name: String, func_idx: Int) -> Unit {\n  let export_name = normalize_comp_export_name(name)\n  bytebuf_push(buf, section_export)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 0)\n  emit_name(content, export_name)\n  bytebuf_push(content, comp_extern_func)\n  leb128_encode_u32(content, func_idx)\n  leb128_encode_u32(content, 0)\n  emit_raw_content(buf, content)\n}\n\nexport fn comp_generate_string_trampoline(string_param_count: Int, call_run_init: Int) -> Bytes {\n  let buf = bytebuf_new()\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 97)\n  bytebuf_push(buf, 115)\n  bytebuf_push(buf, 109)\n  bytebuf_push(buf, 1)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n  let body = bytebuf_new()\n  let type_sec = bytebuf_new()\n  leb128_encode_u32(type_sec, if call_run_init != 0 {\n    4\n  } else {\n    3\n  })\n  bytebuf_push(type_sec, 96)\n  leb128_encode_u32(type_sec, string_param_count + 1)\n  let mut ti = 0\n  while ti < string_param_count {\n    bytebuf_push(type_sec, 126)\n    ti = ti + 1\n  }\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 1)\n  bytebuf_push(type_sec, 126)\n  bytebuf_push(type_sec, 96)\n  bytebuf_push(type_sec, 4)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 1)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 96)\n  leb128_encode_u32(type_sec, string_param_count * 2)\n  let mut ci = 0\n  while ci < (string_param_count * 2) {\n    bytebuf_push(type_sec, 127)\n    ci = ci + 1\n  }\n  bytebuf_push(type_sec, 1)\n  bytebuf_push(type_sec, 126)\n  if call_run_init != 0 {\n    bytebuf_push(type_sec, 96)\n    leb128_encode_u32(type_sec, 0)\n    bytebuf_push(type_sec, 1)\n    bytebuf_push(type_sec, 126)\n  }\n  bytebuf_push_section(body, 1, type_sec)\n  let import_sec = bytebuf_new()\n  leb128_encode_u32(import_sec, if call_run_init != 0 {\n    4\n  } else {\n    3\n  })\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"target_func\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"cabi_realloc\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 1)\n  if call_run_init != 0 {\n    emit_name(import_sec, \"env\")\n    emit_name(import_sec, \"run_init\")\n    bytebuf_push(import_sec, 0)\n    leb128_encode_u32(import_sec, 3)\n  }\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"memory\")\n  bytebuf_push(import_sec, 2)\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  bytebuf_push_section(body, 2, import_sec)\n  let func_sec = bytebuf_new()\n  leb128_encode_u32(func_sec, 1)\n  leb128_encode_u32(func_sec, 2)\n  bytebuf_push_section(body, 3, func_sec)\n  let export_sec = bytebuf_new()\n  leb128_encode_u32(export_sec, 1)\n  emit_name(export_sec, \"canon_func\")\n  bytebuf_push(export_sec, 0)\n  leb128_encode_u32(export_sec, if call_run_init != 0 {\n    3\n  } else {\n    2\n  })\n  bytebuf_push_section(body, 7, export_sec)\n  let code_sec = bytebuf_new()\n  leb128_encode_u32(code_sec, 1)\n  let func_body = bytebuf_new()\n  leb128_encode_u32(func_body, 2)\n  leb128_encode_u32(func_body, string_param_count)\n  bytebuf_push(func_body, 126)\n  leb128_encode_u32(func_body, string_param_count)\n  bytebuf_push(func_body, 127)\n  if call_run_init != 0 {\n    bytebuf_push(func_body, 16)\n    leb128_encode_u32(func_body, 2)\n    bytebuf_push(func_body, 26)\n  }\n  let tagged_base = string_param_count * 2\n  let obj_base = tagged_base + string_param_count\n  let mut si = 0\n  while si < string_param_count {\n    let ptr_local = si * 2\n    let len_local = (si * 2) + 1\n    let tagged_local = tagged_base + si\n    let obj_local = obj_base + si\n    emit_i32_const(func_body, 0)\n    emit_i32_const(func_body, 0)\n    emit_i32_const(func_body, 4)\n    emit_local_get(func_body, len_local)\n    emit_i32_const(func_body, 8)\n    emit_i32_add(func_body)\n    bytebuf_push(func_body, 16)\n    leb128_encode_u32(func_body, 1)\n    emit_local_set(func_body, obj_local)\n    emit_local_get(func_body, obj_local)\n    emit_i32_const(func_body, 1)\n    emit_i32_store(func_body, 0, 0)\n    emit_local_get(func_body, obj_local)\n    emit_local_get(func_body, len_local)\n    emit_i32_store(func_body, 0, 4)\n    emit_local_get(func_body, obj_local)\n    emit_i32_const(func_body, 8)\n    emit_i32_add(func_body)\n    emit_local_get(func_body, ptr_local)\n    emit_local_get(func_body, len_local)\n    bytebuf_push(func_body, 252)\n    leb128_encode_u32(func_body, 10)\n    bytebuf_push(func_body, 0)\n    bytebuf_push(func_body, 0)\n    emit_local_get(func_body, obj_local)\n    bytebuf_push(func_body, 173)\n    bytebuf_push(func_body, 66)\n    leb128_encode_s64(func_body, 1)\n    bytebuf_push(func_body, 132)\n    emit_local_set(func_body, tagged_local)\n    si = si + 1\n  }\n  let mut ci2 = 0\n  while ci2 < string_param_count {\n    emit_local_get(func_body, tagged_base + ci2)\n    ci2 = ci2 + 1\n  }\n  emit_i32_const(func_body, 0)\n  bytebuf_push(func_body, 16)\n  leb128_encode_u32(func_body, 0)\n  bytebuf_push(func_body, 11)\n  leb128_encode_u32(code_sec, Bytes::length(func_body))\n  bytebuf_push_buf(code_sec, func_body)\n  bytebuf_push_section(body, 10, code_sec)\n  bytebuf_push_buf(buf, body)\n  bytebuf_to_bytes(buf)\n}\n\nfn emit_core_instance_from_exports(buf: Bytes, num_modules: Int, module_binding_counts: Array[Int], binding_func_names: Array[String], binding_func_indices: Array[Int]) -> Unit {\n  if num_modules == 0 {\n    ()\n  }\n  else {\n    bytebuf_push(buf, section_core_instance)\n    let content = bytebuf_new()\n    leb128_encode_u32(content, num_modules)\n    let mut offset = 0\n    let mut m = 0\n    while m < num_modules {\n      let count = Array::get(module_binding_counts, m)\n      bytebuf_push(content, 1)\n      leb128_encode_u32(content, count)\n      let mut b = 0\n      while b < count {\n        emit_name(content, Array::get(binding_func_names, offset + b))\n        bytebuf_push(content, core_sort_func)\n        leb128_encode_u32(content, Array::get(binding_func_indices, offset + b))\n        b = b + 1\n      }\n      offset = offset + count\n      m = m + 1\n    }\n    emit_raw_content(buf, content)\n  }\n}\n\nfn emit_core_instance_instantiate_section(buf: Bytes, module_index: Int, module_names: Array[String]) -> Unit {\n  bytebuf_push(buf, section_core_instance)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, module_index)\n  leb128_encode_u32(content, Array::length(module_names))\n  let mut i = 0\n  while i < Array::length(module_names) {\n    emit_name(content, Array::get(module_names, i))\n    bytebuf_push(content, comp_inst_arg_instance)\n    leb128_encode_u32(content, i)\n    i = i + 1\n  }\n  emit_raw_content(buf, content)\n}\n\nexport fn comp_emit_component_wasm(core_wasm: Bytes) -> Bytes {\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, core_wasm)\n  emit_core_instance_instantiate_section(buf, 0, array_empty())\n  emit_alias_run_and_memory(buf, 0)\n  bytebuf_to_bytes(buf)\n}\n\nexport fn comp_emit_component_wasm_with_lift(core_wasm: Bytes, export_name: String) -> Bytes {\n  let import_names = array_empty()\n  let binding_func_names = array_empty()\n  let binding_func_indices = new_int_array()\n  let unique_module_names = array_empty()\n  let module_binding_counts = new_int_array()\n  let comp_params = array_empty()\n  let comp_param_names = array_empty()\n  let comp_results = array_empty()\n  let import_func_count = build_import_plan(core_wasm, import_names, binding_func_names, binding_func_indices, unique_module_names, module_binding_counts, comp_params, comp_param_names, comp_results)\n  let main_instance_idx = Array::length(unique_module_names)\n  let run_core_func_idx = import_func_count\n  let run_type_idx = import_func_count\n  let run_func_idx = import_func_count\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, core_wasm)\n  let async_flags = new_int_array()\n  let mut af = 0\n  while af < import_func_count {\n    Array::push(async_flags, 0)\n    af = af + 1\n  }\n  emit_comp_type_section(buf, comp_params, comp_param_names, comp_results, async_flags)\n  emit_comp_import_section(buf, import_names, import_func_count)\n  emit_canon_lower_section(buf, import_func_count)\n  emit_core_instance_from_exports(buf, Array::length(unique_module_names), module_binding_counts, binding_func_names, binding_func_indices)\n  emit_core_instance_instantiate_section(buf, 0, unique_module_names)\n  emit_alias_run_and_memory(buf, main_instance_idx)\n  emit_comp_type_section_run(buf)\n  emit_canon_lift_section(buf, run_core_func_idx, run_type_idx)\n  emit_comp_export_section(buf, export_name, run_func_idx)\n  bytebuf_to_bytes(buf)\n}\n\nexport fn comp_emit_component_wasm_with_string_lift(core_wasm: Bytes, target_func_name: String, export_name: String, string_param_count: Int, param_names: Array[String], is_async: Int) -> Bytes {\n  let import_names = array_empty()\n  let binding_func_names = array_empty()\n  let binding_func_indices = new_int_array()\n  let unique_module_names = array_empty()\n  let module_binding_counts = new_int_array()\n  let comp_params = array_empty()\n  let comp_param_names = array_empty()\n  let comp_results = array_empty()\n  let export_names = array_empty()\n  let export_func_indices = new_int_array()\n  let export_type_sigs = array_empty()\n  let import_func_count = build_import_plan(core_wasm, import_names, binding_func_names, binding_func_indices, unique_module_names, module_binding_counts, comp_params, comp_param_names, comp_results)\n  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)\n  let mut call_run_init = 0\n  let mut ei = 0\n  while ei < Array::length(export_names) {\n    if Array::get(export_names, ei) == \"_start\" {\n      call_run_init = 1\n      ei = Array::length(export_names)\n    } else {\n      ei = ei + 1\n    }\n  }\n  let has_distinct_run_alias =\n  if (call_run_init != 0) && (target_func_name != \"_start\") {\n    1\n  } else {\n    0\n  }\n  let main_instance_idx = Array::length(unique_module_names)\n  let trampoline_wasm = comp_generate_string_trampoline(string_param_count, call_run_init)\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, core_wasm)\n  emit_core_module_section(buf, trampoline_wasm)\n  let async_flags = new_int_array()\n  let mut af = 0\n  while af < import_func_count {\n    Array::push(async_flags, 0)\n    af = af + 1\n  }\n  emit_comp_type_section(buf, comp_params, comp_param_names, comp_results, async_flags)\n  emit_comp_import_section(buf, import_names, import_func_count)\n  emit_canon_lower_section(buf, import_func_count)\n  emit_core_instance_from_exports(buf, Array::length(unique_module_names), module_binding_counts, binding_func_names, binding_func_indices)\n  emit_core_instance_instantiate_section(buf, 0, unique_module_names)\n  let alias_names = array_empty()\n  let alias_sorts = new_int_array()\n  Array::push(alias_names, target_func_name)\n  Array::push(alias_sorts, core_sort_func)\n  Array::push(alias_names, \"cabi_realloc\")\n  Array::push(alias_sorts, core_sort_func)\n  if has_distinct_run_alias != 0 {\n    Array::push(alias_names, \"_start\")\n    Array::push(alias_sorts, core_sort_func)\n  }\n  Array::push(alias_names, \"memory\")\n  Array::push(alias_sorts, core_sort_mem)\n  emit_alias_section(buf, main_instance_idx, alias_names, alias_sorts)\n  let target_func_core_idx = import_func_count\n  let cabi_realloc_core_idx = import_func_count + 1\n  let run_init_core_idx =\n  if call_run_init != 0 {\n    if has_distinct_run_alias != 0 {\n      import_func_count + 2\n    } else {\n      target_func_core_idx\n    }\n  } else {\n    0 - 1\n  }\n  bytebuf_push(buf, section_core_instance)\n  let tramp_env = bytebuf_new()\n  leb128_encode_u32(tramp_env, 1)\n  bytebuf_push(tramp_env, 1)\n  leb128_encode_u32(tramp_env, if call_run_init != 0 {\n    4\n  } else {\n    3\n  })\n  emit_name(tramp_env, \"target_func\")\n  bytebuf_push(tramp_env, core_sort_func)\n  leb128_encode_u32(tramp_env, target_func_core_idx)\n  emit_name(tramp_env, \"cabi_realloc\")\n  bytebuf_push(tramp_env, core_sort_func)\n  leb128_encode_u32(tramp_env, cabi_realloc_core_idx)\n  if call_run_init != 0 {\n    emit_name(tramp_env, \"run_init\")\n    bytebuf_push(tramp_env, core_sort_func)\n    leb128_encode_u32(tramp_env, run_init_core_idx)\n  }\n  emit_name(tramp_env, \"memory\")\n  bytebuf_push(tramp_env, core_sort_mem)\n  leb128_encode_u32(tramp_env, 0)\n  emit_raw_content(buf, tramp_env)\n  let env_instance_idx = main_instance_idx + 1\n  bytebuf_push(buf, section_core_instance)\n  let tramp_inst = bytebuf_new()\n  leb128_encode_u32(tramp_inst, 1)\n  bytebuf_push(tramp_inst, 0)\n  leb128_encode_u32(tramp_inst, 1)\n  leb128_encode_u32(tramp_inst, 1)\n  emit_name(tramp_inst, \"env\")\n  bytebuf_push(tramp_inst, comp_inst_arg_instance)\n  leb128_encode_u32(tramp_inst, env_instance_idx)\n  emit_raw_content(buf, tramp_inst)\n  let trampoline_instance_idx = env_instance_idx + 1\n  emit_alias_section(buf, trampoline_instance_idx, [\n    \"canon_func\"\n  ], [\n    core_sort_func\n  ])\n  let alias_func_count = if has_distinct_run_alias != 0 {\n    3\n  } else {\n    2\n  }\n  let canon_func_core_idx = import_func_count + alias_func_count\n  bytebuf_push(buf, section_type)\n  let type_content = bytebuf_new()\n  leb128_encode_u32(type_content, 1)\n  if is_async != 0 {\n    bytebuf_push(type_content, 67)\n  } else {\n    bytebuf_push(type_content, 64)\n  }\n  leb128_encode_u32(type_content, string_param_count)\n  let mut pi = 0\n  while pi < string_param_count {\n    let pname = if pi < Array::length(param_names) {\n      normalize_comp_param_name(Array::get(param_names, pi))\n    }\n    else {\n      \"p\\{pi}\"\n    }\n    emit_name(type_content, pname)\n    bytebuf_push(type_content, comp_valtype_string)\n    pi = pi + 1\n  }\n  bytebuf_push(type_content, 0)\n  bytebuf_push(type_content, comp_valtype_s64)\n  emit_raw_content(buf, type_content)\n  let component_type_idx = import_func_count\n  bytebuf_push(buf, section_canon)\n  let canon_content = bytebuf_new()\n  leb128_encode_u32(canon_content, 1)\n  emit_canon_lift_func(canon_content, canon_func_core_idx, component_type_idx, 1, 0, cabi_realloc_core_idx)\n  emit_raw_content(buf, canon_content)\n  let lifted_func_idx = import_func_count\n  emit_comp_export_section(buf, export_name, lifted_func_idx)\n  bytebuf_to_bytes(buf)\n}\n\n// WASI 0.3 async (M1b, docs/spec/wasi-p3-async.md §3.2). The `task.return`\n// canonical built-in lowers to a core func `(param <result>) -> ()` that\n// delivers an async-lifted export's result. Encoding verified byte-for-byte\n// against src/x/cm_async/cm_async_lift_probe.wat (runs on wasmtime 45):\n// section 0x08, body `01 09 00 <valtype> 00` (count=1; opcode 0x09; result\n// Some(valtype); empty options).\nfn emit_canon_task_return(buf: Bytes, result_valtype: Int) -> Unit {\n  bytebuf_push(buf, section_canon)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 9)\n  bytebuf_push(content, 0)\n  bytebuf_push(content, result_valtype)\n  bytebuf_push(content, 0)\n  emit_raw_content(buf, content)\n}\n\n// Async (callback-less / stackful) `canon lift`. Unlike emit_canon_lift_func it\n// carries the async canonopt (0x06). Verified body: `01 00 00 <core_func_idx>\n// 01 06 <type_idx>` (count=1; lift; core-func sort; idx; 1 option = async).\nfn emit_canon_lift_async_section(buf: Bytes, core_func_idx: Int, type_idx: Int) -> Unit {\n  bytebuf_push(buf, section_canon)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 0)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, core_func_idx)\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 6)\n  leb128_encode_u32(content, type_idx)\n  emit_raw_content(buf, content)\n}\n\n// Component type section with a single async func type `() -> <result>`.\n// Verified body: `01 43 00 00 <valtype>` (count=1; async functype opcode 0x43;\n// 0 params; result-form 0x00 + valtype).\nfn emit_comp_async_functype_section(buf: Bytes, result_valtype: Int) -> Unit {\n  bytebuf_push(buf, section_type)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 67)\n  bytebuf_push(content, 0)\n  bytebuf_push(content, 0)\n  bytebuf_push(content, result_valtype)\n  emit_raw_content(buf, content)\n}\n\n// Wrap a core module that imports (\"cm\",\"task-return\") and exports a void `run`\n// into an async-lifted component export. Section order mirrors\n// cm_async_lift_probe.wat (verified to run on wasmtime 45 with\n// -W concurrency-support=y component-model-async=y component-model-async-stackful=y).\n// `result_valtype` is the component valtype of the lifted result (e.g.\n// comp_valtype_s64 for vibe Int).\nexport fn comp_emit_component_wasm_async(core_wasm: Bytes, export_name: String, result_valtype: Int) -> Bytes {\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, core_wasm)\n  emit_canon_task_return(buf, result_valtype)\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"task-return\"\n  ], [\n    0\n  ])\n  emit_core_instance_instantiate_section(buf, 0, [\n    \"cm\"\n  ])\n  emit_comp_async_functype_section(buf, result_valtype)\n  emit_alias_section(buf, 1, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_canon_lift_async_section(buf, 1, 0)\n  emit_comp_export_section(buf, export_name, 0)\n  bytebuf_to_bytes(buf)\n}\n\n// Map a component valtype to the core valtype it lowers from (inverse of\n// core_to_comp_valtype). Used to type the trampoline module's entry/task-return.\nfn comp_valtype_to_core(v: Int) -> Int {\n  if v == comp_valtype_s64 {\n    126\n  }\n  else {\n    if v == comp_valtype_s32 {\n      127\n    }\n    else {\n      if v == comp_valtype_f32 {\n        125\n      }\n      else {\n        if v == comp_valtype_f64 {\n          124\n        }\n        else {\n          127\n        }\n      }\n    }\n  }\n}\n\n// M1b-2 (docs/spec/wasi-p3-async.md §3.4). Async trampoline core module: imports\n// the normally-compiled entry (\"main\",\"run\" : () -> <core_valtype>) and\n// (\"cm\",\"task-return\" : (<core_valtype>) -> ()), and exports a void `run` that\n// calls the entry and forwards its result to task.return. Byte template verified\n// against src/x/cm_async/cm_async_trampoline_probe.wat (runs on wasmtime 45).\nfn comp_generate_async_trampoline(core_valtype: Int) -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  let tc = bytebuf_new()\n  bytebuf_push_vec_header(tc, 3)\n  // type0: the entry `run` — a nullary vibe fn compiles to (param i64) -> result\n  // (the i64 is the unit argument), so the trampoline passes a dummy i64.\n  emit_func_type_raw(tc, [\n    126\n  ], [\n    core_valtype\n  ])\n  emit_func_type_raw(tc, [\n    core_valtype\n  ], array_empty())\n  emit_func_type_raw(tc, array_empty(), array_empty())\n  bytebuf_push_section(out, 1, tc)\n  let ic = bytebuf_new()\n  bytebuf_push_vec_header(ic, 2)\n  emit_name(ic, \"main\")\n  emit_name(ic, \"run\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 0)\n  emit_name(ic, \"cm\")\n  emit_name(ic, \"task-return\")\n  bytebuf_push(ic, 0)\n  bytebuf_push(ic, 1)\n  bytebuf_push_section(out, 2, ic)\n  emit_function_section(out, [\n    2\n  ])\n  emit_export_section(out, \"run\", 2)\n  let body = bytebuf_new()\n  emit_i64_const(body, 0)\n  bytebuf_push(body, 16)\n  leb128_encode_u32(body, 0)\n  bytebuf_push(body, 16)\n  leb128_encode_u32(body, 1)\n  emit_code_section(out, [\n    body\n  ])\n  bytebuf_to_bytes(out)\n}\n\n// Instantiate a core module with explicit (arg-name -> core-instance-index) args.\n// Unlike emit_core_instance_instantiate_section, the arg instance indices need\n// not be sequential.\nfn emit_core_instance_instantiate_args(buf: Bytes, module_index: Int, arg_names: Array[String], arg_instance_indices: Array[Int]) -> Unit {\n  bytebuf_push(buf, section_core_instance)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, module_index)\n  leb128_encode_u32(content, Array::length(arg_names))\n  let mut i = 0\n  while i < Array::length(arg_names) {\n    emit_name(content, Array::get(arg_names, i))\n    bytebuf_push(content, comp_inst_arg_instance)\n    leb128_encode_u32(content, Array::get(arg_instance_indices, i))\n    i = i + 1\n  }\n  emit_raw_content(buf, content)\n}\n\n// Wrap a normally-compiled core module (exporting `run : () -> <core>`, value\n// returned directly) into an async-lifted component export via the trampoline\n// (two-module) approach — no change to the core module / linked_compile needed.\n// `comp_result_valtype` is the component valtype of the lifted result\n// (comp_valtype_s64 for vibe Int). Section order mirrors\n// cm_async_trampoline_probe.wat (verified to run on wasmtime 45).\nexport fn comp_emit_component_wasm_async_trampolined(main_core_wasm: Bytes, export_name: String, comp_result_valtype: Int) -> Bytes {\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, main_core_wasm)\n  emit_core_module_section(buf, comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))\n  emit_core_instance_instantiate_section(buf, 0, array_empty())\n  emit_canon_task_return(buf, comp_result_valtype)\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"task-return\"\n  ], [\n    0\n  ])\n  emit_alias_section(buf, 0, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"run\"\n  ], [\n    1\n  ])\n  emit_core_instance_instantiate_args(buf, 1, [\n    \"main\",\n    \"cm\"\n  ], [\n    2,\n    1\n  ])\n  emit_comp_async_functype_section(buf, comp_result_valtype)\n  emit_alias_section(buf, 3, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_canon_lift_async_section(buf, 2, 0)\n  emit_comp_export_section(buf, export_name, 0)\n  bytebuf_to_bytes(buf)\n}\n\n// M1b-2d: a no-op `wasi_snapshot_preview1.fd_write` stub core module\n// (`(i32,i32,i32,i32) -> i32` returning 0). Compiled core modules\n// import fd_write from wasi_snapshot_preview1 for their runtime preamble; the\n// stub satisfies that import so the async component is self-contained and\n// instantiable without an external preview1 adapter.\nfn comp_generate_wasi_fd_write_stub() -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  let tc = bytebuf_new()\n  bytebuf_push_vec_header(tc, 1)\n  emit_func_type_raw(tc, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  bytebuf_push_section(out, 1, tc)\n  emit_function_section(out, [\n    0\n  ])\n  emit_export_section(out, \"fd_write\", 0)\n  let body = bytebuf_new()\n  emit_i32_const(body, 0)\n  emit_code_section(out, [\n    body\n  ])\n  bytebuf_to_bytes(out)\n}\n\n// Like comp_emit_component_wasm_async_trampolined, but for a main core module\n// that imports `wasi_snapshot_preview1.fd_write` (every compiled core does). A\n// fd_write stub module is instantiated first and supplied to the main module's\n// instantiation, making the async component fully self-contained / runnable.\n// core instances: 0=wasi-stub, 1=main(+wasi), 2=cm(task-return), 3=env(run),\n// 4=trampoline. core funcs: 0=task.return, 1=main.run, 2=trampoline.run.\nexport fn comp_emit_component_wasm_async_trampolined_p1(main_core_wasm: Bytes, export_name: String, comp_result_valtype: Int) -> Bytes {\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, main_core_wasm)\n  emit_core_module_section(buf, comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))\n  emit_core_module_section(buf, comp_generate_wasi_fd_write_stub())\n  emit_core_instance_instantiate_section(buf, 2, array_empty())\n  emit_core_instance_instantiate_args(buf, 0, [\n    \"wasi_snapshot_preview1\"\n  ], [\n    0\n  ])\n  emit_canon_task_return(buf, comp_result_valtype)\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"task-return\"\n  ], [\n    0\n  ])\n  emit_alias_section(buf, 1, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_core_instance_from_exports(buf, 1, [\n    1\n  ], [\n    \"run\"\n  ], [\n    1\n  ])\n  emit_core_instance_instantiate_args(buf, 1, [\n    \"main\",\n    \"cm\"\n  ], [\n    3,\n    2\n  ])\n  emit_comp_async_functype_section(buf, comp_result_valtype)\n  emit_alias_section(buf, 4, [\n    \"run\"\n  ], [\n    core_sort_func\n  ])\n  emit_canon_lift_async_section(buf, 2, 0)\n  emit_comp_export_section(buf, export_name, 0)\n  bytebuf_to_bytes(buf)\n}\n\n// #537: core:sort for globals (func=0, table=1, mem=2, global=3).\nlet core_sort_global = 3\n\n// #537: from-exports core instance with per-item sorts (the older\n// emit_core_instance_from_exports hardcodes core_sort_func; the packed-string\n// env instance also carries the main memory and the __heap_ptr global).\nfn emit_core_instance_from_exports_sorted(buf: Bytes, names: Array[String], sorts: Array[Int], indices: Array[Int]) -> Unit {\n  bytebuf_push(buf, section_core_instance)\n  let content = bytebuf_new()\n  leb128_encode_u32(content, 1)\n  bytebuf_push(content, 1)\n  leb128_encode_u32(content, Array::length(names))\n  let mut i = 0\n  while i < Array::length(names) {\n    emit_name(content, Array::get(names, i))\n    bytebuf_push(content, Array::get(sorts, i))\n    leb128_encode_u32(content, Array::get(indices, i))\n    i = i + 1\n  }\n  emit_raw_content(buf, content)\n}\n\n// #537: string trampoline for the CURRENT wasi linear backend ABI.\n// A vibe string value is the packed i64 `(byte_offset << 32) | byte_len`\n// (mode-invariant: identical under bump and RC; see gen_str_len_body /\n// gen_str_char_code_at_body). The legacy comp_generate_string_trampoline\n// predates this and builds retired-host heap-object strings, so it cannot\n// call today's core modules.\n//\n// Imports (module \"env\", all supplied from the main core instance):\n//   target_func : (i64 x N) -> i64      the exported vibe handler\n//   memory      : the main linear memory\n//   __heap_ptr  : mut i32 global        the main module's bump frontier\n// Exports:\n//   cabi_realloc : (i32,i32,i32,i32) -> i32\n//     Canonical-ABI allocator used by the host to lower string params into\n//     the main memory (and by canon_func for the string-result ret area).\n//     Bumps __heap_ptr (align-adjusted) and memory.grows as needed. Fresh\n//     allocations only (old_ptr is ignored) — the canonical lowering of\n//     bare string params/results never reallocates.\n//   canon_func : (i32 x 2N) -> i32\n//     Canonical-ABI core shape of `(string x N) -> string`: N (ptr,len)\n//     pairs in, retptr out. Packs each pair into a vibe string value, calls\n//     target_func, unpacks the returned value into an 8-byte (ptr,len)\n//     return area allocated via cabi_realloc.\nexport fn comp_generate_string_trampoline_packed(string_param_count: Int) -> Bytes {\n  let buf = bytebuf_new()\n  emit_header(buf)\n  // types: 0 = target_func (i64 x N) -> i64; 1 = canon_func (i32 x 2N) -> i32;\n  // 2 = cabi_realloc (i32,i32,i32,i32) -> i32\n  let type_sec = bytebuf_new()\n  bytebuf_push_vec_header(type_sec, 3)\n  bytebuf_push(type_sec, 96)\n  // +1: top-level vibe functions carry a trailing closure-env i64 param\n  // (callers pass 0); see linked_compile's entry invocation.\n  leb128_encode_u32(type_sec, string_param_count + 1)\n  let mut ti = 0\n  while ti < (string_param_count + 1) {\n    bytebuf_push(type_sec, 126)\n    ti = ti + 1\n  }\n  bytebuf_push(type_sec, 1)\n  bytebuf_push(type_sec, 126)\n  bytebuf_push(type_sec, 96)\n  leb128_encode_u32(type_sec, string_param_count * 2)\n  let mut ci = 0\n  while ci < (string_param_count * 2) {\n    bytebuf_push(type_sec, 127)\n    ci = ci + 1\n  }\n  bytebuf_push(type_sec, 1)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 96)\n  leb128_encode_u32(type_sec, 4)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push(type_sec, 1)\n  bytebuf_push(type_sec, 127)\n  bytebuf_push_section(buf, 1, type_sec)\n  // imports: env.target_func (func 0), env.__heap_ptr (mut i32 global), env.memory\n  let import_sec = bytebuf_new()\n  leb128_encode_u32(import_sec, 3)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"target_func\")\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"__heap_ptr\")\n  bytebuf_push(import_sec, 3)\n  bytebuf_push(import_sec, 127)\n  bytebuf_push(import_sec, 1)\n  emit_name(import_sec, \"env\")\n  emit_name(import_sec, \"memory\")\n  bytebuf_push(import_sec, 2)\n  bytebuf_push(import_sec, 0)\n  leb128_encode_u32(import_sec, 0)\n  bytebuf_push_section(buf, 2, import_sec)\n  // funcs: 1 = canon_func (type 1), 2 = cabi_realloc (type 2)\n  let func_sec = bytebuf_new()\n  leb128_encode_u32(func_sec, 2)\n  leb128_encode_u32(func_sec, 1)\n  leb128_encode_u32(func_sec, 2)\n  bytebuf_push_section(buf, 3, func_sec)\n  let export_sec = bytebuf_new()\n  leb128_encode_u32(export_sec, 2)\n  emit_name(export_sec, \"canon_func\")\n  bytebuf_push(export_sec, 0)\n  leb128_encode_u32(export_sec, 1)\n  emit_name(export_sec, \"cabi_realloc\")\n  bytebuf_push(export_sec, 0)\n  leb128_encode_u32(export_sec, 2)\n  bytebuf_push_section(buf, 7, export_sec)\n  let code_sec = bytebuf_new()\n  leb128_encode_u32(code_sec, 2)\n  // canon_func body. locals: params 0..2N-1 (i32); 2N = result i64; 2N+1 = retptr i32\n  let canon_body = bytebuf_new()\n  leb128_encode_u32(canon_body, 2)\n  leb128_encode_u32(canon_body, 1)\n  bytebuf_push(canon_body, 126)\n  leb128_encode_u32(canon_body, 1)\n  bytebuf_push(canon_body, 127)\n  let result_local = string_param_count * 2\n  let retptr_local = result_local + 1\n  let mut si = 0\n  while si < string_param_count {\n    // (extend_u(ptr) << 32) | extend_u(len)\n    emit_local_get(canon_body, si * 2)\n    bytebuf_push(canon_body, 173)\n    emit_i64_const(canon_body, 32)\n    bytebuf_push(canon_body, 134)\n    emit_local_get(canon_body, (si * 2) + 1)\n    bytebuf_push(canon_body, 173)\n    bytebuf_push(canon_body, 132)\n    si = si + 1\n  }\n  // Trailing closure-env argument (0 for a top-level function).\n  emit_i64_const(canon_body, 0)\n  bytebuf_push(canon_body, 16)\n  leb128_encode_u32(canon_body, 0)\n  emit_local_set(canon_body, result_local)\n  // retptr = cabi_realloc(0, 0, 4, 8)\n  emit_i32_const(canon_body, 0)\n  emit_i32_const(canon_body, 0)\n  emit_i32_const(canon_body, 4)\n  emit_i32_const(canon_body, 8)\n  bytebuf_push(canon_body, 16)\n  leb128_encode_u32(canon_body, 2)\n  emit_local_set(canon_body, retptr_local)\n  // [retptr] = wrap(result >> 32); [retptr+4] = wrap(result & 0xFFFFFFFF)\n  emit_local_get(canon_body, retptr_local)\n  emit_local_get(canon_body, result_local)\n  emit_i64_const(canon_body, 32)\n  bytebuf_push(canon_body, 136)\n  bytebuf_push(canon_body, 167)\n  emit_i32_store(canon_body, 2, 0)\n  emit_local_get(canon_body, retptr_local)\n  emit_local_get(canon_body, result_local)\n  bytebuf_push(canon_body, 167)\n  emit_i32_store(canon_body, 2, 4)\n  emit_local_get(canon_body, retptr_local)\n  bytebuf_push(canon_body, 11)\n  leb128_encode_u32(code_sec, Bytes::length(canon_body))\n  bytebuf_push_buf(code_sec, canon_body)\n  // cabi_realloc body. params: 0=old_ptr 1=old_size 2=align 3=new_size;\n  // local 4 = aligned ptr.\n  let realloc_body = bytebuf_new()\n  leb128_encode_u32(realloc_body, 1)\n  leb128_encode_u32(realloc_body, 1)\n  bytebuf_push(realloc_body, 127)\n  // p = (heap + align - 1) & (0 - align)\n  bytebuf_push(realloc_body, 35)\n  leb128_encode_u32(realloc_body, 0)\n  emit_local_get(realloc_body, 2)\n  emit_i32_add(realloc_body)\n  emit_i32_const(realloc_body, 1)\n  bytebuf_push(realloc_body, 107)\n  emit_i32_const(realloc_body, 0)\n  emit_local_get(realloc_body, 2)\n  bytebuf_push(realloc_body, 107)\n  bytebuf_push(realloc_body, 113)\n  emit_local_set(realloc_body, 4)\n  // __heap_ptr = p + new_size\n  emit_local_get(realloc_body, 4)\n  emit_local_get(realloc_body, 3)\n  emit_i32_add(realloc_body)\n  bytebuf_push(realloc_body, 36)\n  leb128_encode_u32(realloc_body, 0)\n  // if (__heap_ptr > memory.size << 16) memory.grow(pages needed)\n  bytebuf_push(realloc_body, 35)\n  leb128_encode_u32(realloc_body, 0)\n  bytebuf_push(realloc_body, 63)\n  bytebuf_push(realloc_body, 0)\n  emit_i32_const(realloc_body, 16)\n  bytebuf_push(realloc_body, 116)\n  bytebuf_push(realloc_body, 75)\n  bytebuf_push(realloc_body, 4)\n  bytebuf_push(realloc_body, 64)\n  bytebuf_push(realloc_body, 35)\n  leb128_encode_u32(realloc_body, 0)\n  emit_i32_const(realloc_body, 65535)\n  emit_i32_add(realloc_body)\n  emit_i32_const(realloc_body, 16)\n  bytebuf_push(realloc_body, 118)\n  bytebuf_push(realloc_body, 63)\n  bytebuf_push(realloc_body, 0)\n  bytebuf_push(realloc_body, 107)\n  bytebuf_push(realloc_body, 64)\n  bytebuf_push(realloc_body, 0)\n  bytebuf_push(realloc_body, 26)\n  bytebuf_push(realloc_body, 11)\n  emit_local_get(realloc_body, 4)\n  bytebuf_push(realloc_body, 11)\n  leb128_encode_u32(code_sec, Bytes::length(realloc_body))\n  bytebuf_push_buf(code_sec, realloc_body)\n  bytebuf_push_section(buf, 10, code_sec)\n  bytebuf_to_bytes(buf)\n}\n\n// #537: wrap a compiled core module into a component exporting\n//   <export_name> : func(<param_names>: string, ...) -> string\n// via the packed-string trampoline above. This is the replacement\n// for the retired host's `--compose-p3` handler-side componentization: the\n// result plugs into the P3 HTTP adapter's `import handler: func(method, url,\n// headers, body) -> string` (scripts/build_wasi_http_p3_full_adapter.sh).\n//\n// The core module must export `target_func_name` with signature\n// (i64 x N) -> i64 (N = param count, all vibe String), plus `memory` and\n// `__heap_ptr` (any normal non-library compile does). Host imports\n// other than wasi_snapshot_preview1.fd_write (stubbed to a no-op) are\n// rejected: a serve handler must be a pure function of its request params.\nexport fn comp_emit_component_wasm_string_handler(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with { Error } {\n  let string_param_count = Array::length(param_names)\n  // Validate the target export exists with the packed-string core signature.\n  let export_names = array_empty()\n  let export_func_indices = new_int_array()\n  let export_type_sigs = array_empty()\n  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)\n  let mut target_sig_ok = false\n  let mut target_found = false\n  let mut ei = 0\n  while ei < Array::length(export_names) {\n    if Array::get(export_names, ei) == target_func_name {\n      target_found = true\n      let sig = Array::get(export_type_sigs, ei)\n      // sig = [param_count, params..., result_count, results...]. Core shape\n      // is (i64 x N+1) -> i64: leading closure-env param + one i64 per String.\n      let core_param_count = string_param_count + 1\n      if Array::length(sig) == (core_param_count + 3) {\n        let mut ok = Array::get(sig, 0) == core_param_count\n        let mut pi = 0\n        while pi < core_param_count {\n          if Array::get(sig, 1 + pi) != 126 {\n            ok = false\n          }\n          pi = pi + 1\n        }\n        if Array::get(sig, 1 + core_param_count) != 1 {\n          ok = false\n        }\n        if Array::get(sig, 2 + core_param_count) != 126 {\n          ok = false\n        }\n        target_sig_ok = ok\n      }\n      ei = Array::length(export_names)\n    } else {\n      ei = ei + 1\n    }\n  }\n  if !target_found {\n    throw(\"component: core module does not export '\\{target_func_name}'\")\n  }\n  if !target_sig_ok {\n    throw(\"component: '\\{target_func_name}' must take \\{string_param_count} String params and return String\")\n  }\n  // Reject host imports the stub cannot satisfy.\n  let imp_modules = array_empty()\n  let imp_names = array_empty()\n  let imp_type_indices = new_int_array()\n  let imp_type_sigs = array_empty()\n  let import_count = parse_core_imports(core_wasm, imp_modules, imp_names, imp_type_indices, imp_type_sigs)\n  let mut ii = 0\n  while ii < import_count {\n    let im = Array::get(imp_modules, ii)\n    let ifn = Array::get(imp_names, ii)\n    if im == \"wasi_snapshot_preview1\" && ifn == \"fd_write\" {\n      ()\n    } else {\n      throw(\"component: handler uses host import '\\{im}.\\{ifn}' (a serve handler must be pure; only stdout via fd_write is stubbed)\")\n    }\n    ii = ii + 1\n  }\n  let buf = bytebuf_new()\n  emit_component_header(buf)\n  emit_core_module_section(buf, core_wasm)\n  emit_core_module_section(buf, comp_generate_string_trampoline_packed(string_param_count))\n  emit_core_module_section(buf, comp_generate_wasi_fd_write_stub())\n  // core instance 0: fd_write stub (module 2)\n  emit_core_instance_instantiate_section(buf, 2, array_empty())\n  // core instance 1: main (module 0), wasi_snapshot_preview1 satisfied by the\n  // stub when the core imports it (an argument for an import the module does\n  // not declare is legal and ignored).\n  emit_core_instance_instantiate_args(buf, 0, [\n    \"wasi_snapshot_preview1\"\n  ], [\n    0\n  ])\n  // core func 0 = target, core mem 0 = main memory, core global 0 = __heap_ptr\n  emit_alias_section(buf, 1, [\n    target_func_name\n  ], [\n    core_sort_func\n  ])\n  emit_alias_section(buf, 1, [\n    \"memory\"\n  ], [\n    core_sort_mem\n  ])\n  emit_alias_section(buf, 1, [\n    \"__heap_ptr\"\n  ], [\n    core_sort_global\n  ])\n  // core instance 2: env = {target_func, __heap_ptr, memory} from the aliases\n  emit_core_instance_from_exports_sorted(buf, [\n    \"target_func\",\n    \"__heap_ptr\",\n    \"memory\"\n  ], [\n    core_sort_func,\n    core_sort_global,\n    core_sort_mem\n  ], [\n    0,\n    0,\n    0\n  ])\n  // core instance 3: trampoline (module 1) with env\n  emit_core_instance_instantiate_args(buf, 1, [\n    \"env\"\n  ], [\n    2\n  ])\n  // core func 1 = canon_func, core func 2 = cabi_realloc\n  emit_alias_section(buf, 3, [\n    \"canon_func\",\n    \"cabi_realloc\"\n  ], [\n    core_sort_func,\n    core_sort_func\n  ])\n  // component type 0: (param_names: string...) -> string\n  bytebuf_push(buf, section_type)\n  let type_content = bytebuf_new()\n  leb128_encode_u32(type_content, 1)\n  let comp_param_types = new_int_array()\n  let mut pt = 0\n  while pt < string_param_count {\n    Array::push(comp_param_types, comp_valtype_string)\n    pt = pt + 1\n  }\n  emit_comp_func_type(type_content, comp_param_types, param_names, [\n    comp_valtype_string\n  ], 0)\n  emit_raw_content(buf, type_content)\n  // canon lift canon_func (core func 1) with memory 0 + realloc (core func 2)\n  bytebuf_push(buf, section_canon)\n  let canon_content = bytebuf_new()\n  leb128_encode_u32(canon_content, 1)\n  emit_canon_lift_func(canon_content, 1, 0, 1, 0, 2)\n  emit_raw_content(buf, canon_content)\n  emit_comp_export_section(buf, export_name, 0)\n  bytebuf_to_bytes(buf)\n}\n")
}

let cli_adapter_source_106 = () -> (String, String) {
  ("lib/@vibe/compiler/wit_gen.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Stmt, TypeExpr\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# WIT text generation (#537)\n//\n// Maps a vibe program's EFFECT SURFACE to a WIT world:\n//\n//   - Each *exported* top-level function with a full type annotation becomes a\n//     world `export <kebab-name>: func(...)`.\n//   - The union of the effects named in those exported signatures' `with { E }`\n//     rows becomes the world's imports. An effect declared in the program via\n//     `effect E { Op(Args) -> Ret; ... }` is emitted as an inline interface\n//     import: `import <kebab-E>: interface { <kebab-op>: func(...) -> ...; }`.\n//   - `Error` never surfaces (it is vibe-internal control flow: an escaping\n//     throw is a component trap, not a capability).\n//   - Effect names WITHOUT a matching `effect` declaration (host capabilities\n//     such as Fs / Env / Async) get a comment marker: they are provided by the\n//     vibe runtime's host imports and have no WIT mapping yet.\n//\n// Type mapping (vibe -> WIT): Int -> s64, Double -> f64, Bool -> bool,\n// String -> string, Char -> char, Unit -> (no result), Bytes -> list<u8>,\n// Array[T] -> list<T>, Option[T] -> option<T>, Result[T, E] -> result<T, E>,\n// Map[K, V] -> list<tuple<K, V>>, tuples -> tuple<...>. Anything else\n// (named user types, function types) is rejected with a clear error — the\n// golden output never silently mis-declares a boundary type.\n//\n// The full contract lives in docs/effect-wit-mapping.md; the generated text is\n// pinned by fixtures/wit_gen_http.golden.wit (gate step) and round-trips\n// through vibe/wasm/wit_parser (wit_gen_test.vibe).\n\n// Lowercase a single ASCII char code, else identity.\nfn wit_lower_char(c: Int) -> Int {\n  if c >= 65 && c <= 90 {\n    c + 32\n  } else {\n    c\n  }\n}\n\n// vibe identifier (CamelCase / snake_case) -> WIT kebab-case word list.\n// `HttpReq` -> `http-req`, `now_us` -> `now-us`, `Fs` -> `fs`. Consecutive\n// uppercase letters split per letter (`URL` -> `u-r-l`) — vibe convention is\n// strict CamelCase, so this stays predictable.\nexport fn wit_kebab_ident(name: String) -> String {\n  let sb = StringBuilder::new()\n  let len = String::length(name)\n  let mut i = 0\n  let mut prev_dash = true\n  while i < len {\n    let c = String::char_code_at(name, i)\n    if c == 95 {\n      if !prev_dash {\n        StringBuilder::push(sb, \"-\")\n      }\n      prev_dash = true\n    } else if c >= 65 && c <= 90 {\n      if !prev_dash {\n        StringBuilder::push(sb, \"-\")\n      }\n      StringBuilder::push(sb, String::from_char_code(wit_lower_char(c)))\n      prev_dash = false\n    } else {\n      StringBuilder::push(sb, String::from_char_code(c))\n      prev_dash = false\n    }\n    i = i + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\nfn wit_is_unit_type(ty: TypeExpr) -> Bool {\n  match ty {\n    TyUnit => true,\n    TyName(name) => name == \"Unit\",\n    _ => false\n  }\n}\n\n// vibe TypeExpr -> WIT type text. Throws on types with no WIT mapping.\nexport fn wit_type_text(ty: TypeExpr) -> String with { Error } {\n  match ty {\n    TyName(name) => {\n      if name == \"Int\" {\n        \"s64\"\n      } else if name == \"Double\" {\n        \"f64\"\n      } else if name == \"Bool\" {\n        \"bool\"\n      } else if name == \"String\" {\n        \"string\"\n      } else if name == \"Char\" {\n        \"char\"\n      } else if name == \"Bytes\" {\n        \"list<u8>\"\n      } else {\n        throw(\"wit: no WIT mapping for type '\\{name}' (supported: Int, Double, Bool, String, Char, Bytes, Unit, Array, Option, Result, Map, tuples)\")\n      }\n    },\n    TyApp(head, args) => {\n      if head == \"Array\" && Array::length(args) == 1 {\n        \"list<\\{wit_type_text(Array::get(args, 0))}>\"\n      } else if head == \"Option\" && Array::length(args) == 1 {\n        \"option<\\{wit_type_text(Array::get(args, 0))}>\"\n      } else if head == \"Result\" && Array::length(args) == 2 {\n        \"result<\\{wit_type_text(Array::get(args, 0))}, \\{wit_type_text(Array::get(args, 1))}>\"\n      } else if head == \"Map\" && Array::length(args) == 2 {\n        \"list<tuple<\\{wit_type_text(Array::get(args, 0))}, \\{wit_type_text(Array::get(args, 1))}>>\"\n      } else {\n        throw(\"wit: no WIT mapping for type '\\{head}[..]'\")\n      }\n    },\n    TyTuple(items) => {\n      let sb = StringBuilder::new()\n      StringBuilder::push(sb, \"tuple<\")\n      let mut i = 0\n      while i < Array::length(items) {\n        if i > 0 {\n          StringBuilder::push(sb, \", \")\n        }\n        StringBuilder::push(sb, wit_type_text(Array::get(items, i)))\n        i = i + 1\n      }\n      StringBuilder::push(sb, \">\")\n      StringBuilder::freeze(sb)\n    },\n    TyFn(_, _, _) => throw(\"wit: function types cannot cross the WIT boundary\"),\n    TyUnit => throw(\"wit: Unit is only valid as a return type\")\n  }\n}\n\n// `func(name: ty, ...) -> ret` text for a signature. Unit return omits `->`.\nfn wit_func_text(param_names: Array[String], param_types: Array[TypeExpr], ret: TypeExpr) -> String with { Error } {\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, \"func(\")\n  let mut i = 0\n  while i < Array::length(param_types) {\n    if i > 0 {\n      StringBuilder::push(sb, \", \")\n    }\n    let pname = if i < Array::length(param_names) {\n      wit_kebab_ident(Array::get(param_names, i))\n    } else {\n      \"arg\\{i}\"\n    }\n    StringBuilder::push(sb, pname)\n    StringBuilder::push(sb, \": \")\n    StringBuilder::push(sb, wit_type_text(Array::get(param_types, i)))\n    i = i + 1\n  }\n  StringBuilder::push(sb, \")\")\n  if !wit_is_unit_type(ret) {\n    StringBuilder::push(sb, \" -> \")\n    StringBuilder::push(sb, wit_type_text(ret))\n  }\n  StringBuilder::freeze(sb)\n}\n\n// Split a parsed effect row (\"A, B\") into names. The parser joins the\n// `with { A, B }` list with \", \" (parser_base.vibe collect_effect_names).\nfn wit_split_effect_row(row: String) -> Array[String] {\n  let out = array_empty()\n  let len = String::length(row)\n  let mut piece = \"\"\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(row, i)\n    if c == 44 {\n      if String::length(piece) > 0 {\n        Array::push(out, piece)\n      }\n      piece = \"\"\n    } else if c == 32 {\n      ()\n    } else {\n      piece = String::concat(piece, String::from_char_code(c))\n    }\n    i = i + 1\n  }\n  if String::length(piece) > 0 {\n    Array::push(out, piece)\n  }\n  out\n}\n\nfn wit_array_contains(items: Array[String], needle: String) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(items) {\n    if Array::get(items, i) == needle {\n      found = true\n    }\n    i = i + 1\n  }\n  found\n}\n\n// One exported function surface as a tuple:\n//   (name, param_names, param_types, ret, effects)\n// A plain tuple, not a struct: struct values crossing function boundaries\n// miscompile in the flat-bundle lane today (#537 follow-up filed), while\n// tuples are battle-tested everywhere in the compiler.\n\n// Extract the boundary signature of `SLet(true, _, name, ann, body)`.\n// Priority: TyFn annotation (param names from the EFn body when available),\n// else fully-annotated EFn params/ret. Non-function exports and unannotated\n// functions return None (they have no declarable WIT surface).\nfn wit_export_of_slet(name: String, ann: Option[TypeExpr], body: Expr) -> Option[(String, Array[String], Array[TypeExpr], TypeExpr, Array[String])] {\n  let efn_param_names = array_empty()\n  let efn_param_types = array_empty()\n  let mut efn_params_ok = true\n  let mut efn_ret = None\n  let mut efn_eff = None\n  match body {\n    EFn(_, _, params, ret_opt, eff_opt, _) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, pty_opt) = Array::get(params, i)\n        Array::push(efn_param_names, pname)\n        match pty_opt {\n          Some(pty) => Array::push(efn_param_types, pty),\n          None => {\n            efn_params_ok = false\n          }\n        }\n        i = i + 1\n      }\n      efn_ret = ret_opt\n      efn_eff = eff_opt\n    },\n    _ => {\n      efn_params_ok = false\n    }\n  }\n  let mut ann_fn = None\n  match ann {\n    Some(ty) => match ty {\n      TyFn(ptys, rty, eff) => {\n        ann_fn = Some((ptys, rty, eff))\n      },\n      _ => ()\n    },\n    None => ()\n  }\n  match ann_fn {\n    Some(fn_parts) => {\n      let (ptys, rty, eff) = fn_parts\n      let effects = match eff {\n        Some(row) => wit_split_effect_row(row),\n        None => array_empty()\n      }\n      Some((name, efn_param_names, ptys, rty, effects))\n    },\n    None => {\n      if efn_params_ok {\n        match efn_ret {\n          Some(rty) => {\n            let effects = match efn_eff {\n              Some(row) => wit_split_effect_row(row),\n              None => array_empty()\n            }\n            Some((name, efn_param_names, Array::slice(efn_param_types, 0, Array::length(efn_param_types)), rty, effects))\n          },\n          None => None\n        }\n      } else {\n        None\n      }\n    }\n  }\n}\n\n//# vibe serve handler contract (#537)\n\n// The wasi-http P3 full-adapter handler contract\n// (scripts/build_wasi_http_p3_full_adapter.sh):\n//   export let handler = (method: String, url: String, headers: String, body: String) -> String\n// returning \"STATUS\\n<Header: value lines>\\n\\n<body>\".\nexport fn serve_handler_param_names() -> Array[String] {\n  [\n    \"method\",\n    \"url\",\n    \"headers\",\n    \"body\"\n  ]\n}\n\nfn wit_type_is_string(ty: TypeExpr) -> Bool {\n  match ty {\n    TyName(name) => name == \"String\",\n    _ => false\n  }\n}\n\n// Validate the entry file's `handler` export against the serve contract,\n// with a teaching error when it does not fit.\nexport fn validate_serve_handler(entry_stmts: Array[Stmt]) -> Unit with { Error } {\n  let contract = \"serve: expected `export let handler = (method: String, url: String, headers: String, body: String) -> String`\"\n  match wit_boundary_signature(entry_stmts, \"handler\") {\n    None => throw(String::concat(contract, \" (no exported `handler` with a full type annotation found)\")),\n    Some(sig) => {\n      let (_sname, _spnames, sig_param_types, sig_ret, sig_effects) = sig\n      if Array::length(sig_param_types) != 4 {\n        throw(String::concat(contract, \" (found \\{Array::length(sig_param_types)} params)\"))\n      }\n      let mut pi = 0\n      while pi < Array::length(sig_param_types) {\n        if !wit_type_is_string(Array::get(sig_param_types, pi)) {\n          throw(String::concat(contract, \" (param \\{pi} is not String)\"))\n        }\n        pi = pi + 1\n      }\n      if !wit_type_is_string(sig_ret) {\n        throw(String::concat(contract, \" (return type is not String)\"))\n      }\n      let mut ei = 0\n      while ei < Array::length(sig_effects) {\n        let ename = Array::get(sig_effects, ei)\n        if ename != \"Error\" {\n          throw(\"serve: handler requires capability effect '\\{ename}'; a serve handler must be a pure function of its request params (discharge the effect with `handle` inside the file)\")\n        }\n        ei = ei + 1\n      }\n    }\n  }\n}\n\n// Boundary signature of one exported top-level function, by name. Used by\n// `vibe serve` to validate the handler contract before componentizing.\nexport fn wit_boundary_signature(stmts: Array[Stmt], name: String) -> Option[(String, Array[String], Array[TypeExpr], TypeExpr, Array[String])] {\n  let mut found = None\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, _, sname, ann, body) => {\n        if exported && sname == name {\n          found = wit_export_of_slet(sname, ann, body)\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// Collect `effect` declarations (recursing into module blocks) as parallel\n// name/ops arrays.\nfn wit_collect_effect_defs(stmts: Array[Stmt], out_names: Array[String], out_ops: Array[Array[(String, Array[TypeExpr], TypeExpr)]]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectDef(_, name, _, ops) => {\n        if !wit_array_contains(out_names, name) {\n          Array::push(out_names, name)\n          Array::push(out_ops, ops)\n        }\n      },\n      SModule(_, _, inner) => wit_collect_effect_defs(inner, out_names, out_ops),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\n// Generate the WIT world text for a program.\n//   export_stmts: statements scanned for *exported* function surfaces\n//                 (normally the entry file's own statements).\n//   effect_stmts: statements scanned for `effect` declarations (may be the\n//                 same array, or entry + resolved import type decls).\n//   world_name:   raw name; kebab-cased into the world header.\n// ADR-0071 (#755) step 5: a row item collected by wit_split_effect_row can\n// now be a qualified operation (`Ask::Get`, step 1) or an effectset name\n// (`AskAll`, step 2+) instead of only a bare effect name -- WITHOUT this,\n// either shape falls through to the \"host capability effect ... no WIT\n// mapping yet\" branch below, which is wrong (it's neither a host effect\n// nor unmappable, just spelled differently than wit_collect_effect_defs'\n// bare-name lookup expects). Local to this file (no new cross-file\n// reference -- see docs/effectset.md's bootstrap gotcha); duplicates the\n// same small ES-table/cycle-safe-expansion shape already used in\n// checker_stmt.vibe and contract.vibe for the same reason.\nfn wit_es_collect_into(stmts: Array[Stmt], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectSet(_, esname, esmembers) => {\n        Array::push(es_names, esname)\n        Array::push(es_members_list, esmembers)\n      },\n      SModule(_, _, inner) => wit_es_collect_into(inner, es_names, es_members_list),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn wit_es_expand_into(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String], out: Array[String]) -> Unit {\n  if wit_array_contains(path, name) {\n    ()\n  } else {\n    let idx_of = { let mut i = 0\n      let mut found = -1\n      while i < Array::length(es_names) {\n        if Array::get(es_names, i) == name {\n          found = i\n        }\n        i = i + 1\n      }\n      found\n    }\n    if idx_of < 0 {\n      if wit_array_contains(out, name) {\n        ()\n      } else {\n        Array::push(out, name)\n      }\n    } else {\n      Array::push(path, name)\n      let members = Array::get(es_members_list, idx_of)\n      let mut mi = 0\n      while mi < Array::length(members) {\n        wit_es_expand_into(es_names, es_members_list, Array::get(members, mi), path, out)\n        mi = mi + 1\n      }\n      Array::truncate(path, Array::length(path) - 1)\n    }\n  }\n}\n\n// Strip a qualified operation name (`Ask::Get`) down to its effect prefix\n// (`Ask`); a bare name (already an effect name, or an unresolvable label)\n// passes through unchanged.\nfn wit_effect_name_of(label: String) -> String {\n  let idx = String::index_of(label, \"::\")\n  if idx > 0 {\n    String::substring(label, 0, idx)\n  } else {\n    label\n  }\n}\n\n// Resolve one raw row-item label to the underlying effect NAME(s) it\n// requires: expand it if it's a known effectset (pushing each expanded\n// leaf's effect prefix), or just push its own effect prefix directly\n// otherwise. Appends into `out` (deduped by the caller).\nfn wit_resolve_effect_names_into(label: String, es_names: Array[String], es_members_list: Array[Array[String]], out: Array[String]) -> Unit {\n  let is_effectset = { let mut i = 0\n    let mut found = false\n    while i < Array::length(es_names) {\n      if Array::get(es_names, i) == label {\n        found = true\n      }\n      i = i + 1\n    }\n    found\n  }\n  if is_effectset {\n    let leaves = array_empty()\n    wit_es_expand_into(es_names, es_members_list, label, array_empty(), leaves)\n    let mut li = 0\n    while li < Array::length(leaves) {\n      let ename = wit_effect_name_of(Array::get(leaves, li))\n      if wit_array_contains(out, ename) {\n        ()\n      } else {\n        Array::push(out, ename)\n      }\n      li = li + 1\n    }\n  } else {\n    let ename = wit_effect_name_of(label)\n    if wit_array_contains(out, ename) {\n      ()\n    } else {\n      Array::push(out, ename)\n    }\n  }\n}\n\nexport fn wit_from_program(export_stmts: Array[Stmt], effect_stmts: Array[Stmt], world_name: String) -> String with { Error } {\n  let eff_names = array_empty()\n  let eff_ops = array_empty()\n  wit_collect_effect_defs(effect_stmts, eff_names, eff_ops)\n  wit_collect_effect_defs(export_stmts, eff_names, eff_ops)\n  let wit_es_names = array_empty()\n  let wit_es_members_list = array_empty()\n  wit_es_collect_into(effect_stmts, wit_es_names, wit_es_members_list)\n  wit_es_collect_into(export_stmts, wit_es_names, wit_es_members_list)\n  let exports = array_empty()\n  let mut i = 0\n  while i < Array::length(export_stmts) {\n    match Array::get(export_stmts, i) {\n      SLet(exported, _, name, ann, body) => {\n        if exported {\n          match wit_export_of_slet(name, ann, body) {\n            Some(ex) => Array::push(exports, ex),\n            None => ()\n          }\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  // Imports: effects referenced by exported signatures, in first-use order.\n  // ADR-0071 (#755) step 5: each raw row-item label is resolved through\n  // wit_resolve_effect_names_into first -- a qualified operation\n  // (`Ask::Get`) or effectset name (`AskAll`) maps to its underlying real\n  // effect name(s) instead of being pushed verbatim (which would never\n  // match eff_names below and misreport as an unmappable host capability).\n  let used_effects = array_empty()\n  let mut xi = 0\n  while xi < Array::length(exports) {\n    let (_xn, _xp, _xt, _xr, ex_effects) = Array::get(exports, xi)\n    let mut ei = 0\n    while ei < Array::length(ex_effects) {\n      let ename = Array::get(ex_effects, ei)\n      if ename != \"Error\" {\n        let resolved = array_empty()\n        wit_resolve_effect_names_into(ename, wit_es_names, wit_es_members_list, resolved)\n        let mut ri = 0\n        while ri < Array::length(resolved) {\n          let rname = Array::get(resolved, ri)\n          if rname != \"Error\" && !wit_array_contains(used_effects, rname) {\n            Array::push(used_effects, rname)\n          }\n          ri = ri + 1\n        }\n      } else {\n        ()\n      }\n      ei = ei + 1\n    }\n    xi = xi + 1\n  }\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, \"package vibe:app;\\n\\nworld \")\n  StringBuilder::push(sb, wit_kebab_ident(world_name))\n  StringBuilder::push(sb, \" {\\n\")\n  let mut ui = 0\n  while ui < Array::length(used_effects) {\n    let ename = Array::get(used_effects, ui)\n    let mut def_idx = 0 - 1\n    let mut di = 0\n    while di < Array::length(eff_names) {\n      if Array::get(eff_names, di) == ename {\n        def_idx = di\n      }\n      di = di + 1\n    }\n    if def_idx >= 0 {\n      StringBuilder::push(sb, \"  import \")\n      StringBuilder::push(sb, wit_kebab_ident(ename))\n      StringBuilder::push(sb, \": interface {\\n\")\n      let ops = Array::get(eff_ops, def_idx)\n      let mut oi = 0\n      while oi < Array::length(ops) {\n        let (op_name, op_args, op_ret) = Array::get(ops, oi)\n        StringBuilder::push(sb, \"    \")\n        StringBuilder::push(sb, wit_kebab_ident(op_name))\n        StringBuilder::push(sb, \": \")\n        StringBuilder::push(sb, wit_func_text(array_empty(), op_args, op_ret))\n        StringBuilder::push(sb, \";\\n\")\n        oi = oi + 1\n      }\n      StringBuilder::push(sb, \"  }\\n\")\n    } else {\n      // Host capability effect (Fs / Env / Async / ...): provided by the vibe\n      // runtime's host imports; no declared operations to surface.\n      StringBuilder::push(sb, \"  // host capability effect '\")\n      StringBuilder::push(sb, ename)\n      StringBuilder::push(sb, \"' (provided by the vibe runtime; no WIT mapping yet)\\n\")\n    }\n    ui = ui + 1\n  }\n  let mut xo = 0\n  while xo < Array::length(exports) {\n    let (ex_name, ex_param_names, ex_param_types, ex_ret, _ex_effects) = Array::get(exports, xo)\n    StringBuilder::push(sb, \"  export \")\n    StringBuilder::push(sb, wit_kebab_ident(ex_name))\n    StringBuilder::push(sb, \": \")\n    StringBuilder::push(sb, wit_func_text(ex_param_names, ex_param_types, ex_ret))\n    StringBuilder::push(sb, \";\\n\")\n    xo = xo + 1\n  }\n  StringBuilder::push(sb, \"}\\n\")\n  StringBuilder::freeze(sb)\n}\n")
}

let cli_adapter_source_107 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/builtin_bodies/bodies_core_a1a1_eq.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\n// Push `memory.size * 65536` (linear memory size in BYTES) as an i64.\nfn emit_mem_size_bytes(b: Bytes) -> Unit {\n  bytebuf_push(b, 63)\n  bytebuf_push(b, 0)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 65536)\n  emit_i64_mul(b)\n}\n\n// Push an i32 bool: could `v` (the i64 in local `slot`) be safely byte-compared\n// as a string fat-pointer `(ptr << 32) | len` WITHOUT reading out of bounds —\n// i.e. `ptr + len <= memory_size`, where ptr is the UNSIGNED high word (a value\n// whose high bit is set yields a huge ptr that exceeds memory_size, so it is\n// rejected rather than wrapping to a low in-bounds address). This is the OOB\n// guard from #664; it deliberately does NOT require `ptr >= 64`, because a\n// genuine empty string can have a low pointer (e.g. a 0-length name read from a\n// custom section) and must still compare equal — requiring `ptr >= 64` regressed\n// such comparisons to \"not equal\". The residual it gives up on (two distinct\n// integers with equal low words comparing equal) is the accepted #678 hole.\nfn emit_looks_like_string(b: Bytes, slot: Int) -> Unit {\n  emit_local_get(b, slot)\n  emit_i64_const(b, 32)\n  bytebuf_push(b, 136)\n  emit_local_get(b, slot)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i64_add(b)\n  emit_mem_size_bytes(b)\n  emit_i64_le_s(b)\n}\n\nexport fn gen_eq_body(str_eq_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_eq(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 1)\n  emit_else(b)\n  // The operands are bit-different. Falling back to `str_eq` here is only valid\n  // when both are genuine string fat-pointers; a raw integer (e.g. a 61-bit\n  // value) whose bits resemble `(ptr << 32) | len` would otherwise be misread —\n  // a low word of 0 makes two unequal ints compare EQUAL, and a large low word\n  // makes `str_eq`'s byte loop read out of bounds (the #664 class of bug, here\n  // surfacing for `==`/`!=` on Int >= 2^32). Gate the fallback on both operands\n  // looking like real strings; otherwise the values are simply not equal.\n  emit_looks_like_string(b, 0)\n  emit_looks_like_string(b, 1)\n  bytebuf_push(b, 113)\n  emit_if_i64(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, str_eq_idx)\n  emit_else(b)\n  emit_i64_const(b, 0)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\n// #973 review: `emit_looks_like_string` alone is too permissive for the\n// erased-generic dispatch below. ANY ordinary non-negative Int under 2^32\n// (i.e. essentially every everyday int -- 3, 4, 10, ...) has ptr==0 (its high\n// 32 bits are zero), and ptr(0) + len(anything up to memory_size) <=\n// memory_size is trivially true -- so `emit_looks_like_string` answers \"yes\"\n// for nearly all small ints, not just genuine strings. For `gen_eq_body`'s\n// `==`/`!=` that false positive is harmless: two DIFFERENT ints almost always\n// decode to different fake \"lengths\", so `str_eq`'s own length check still\n// answers \"not equal\" -- the same answer a raw compare would give (the only\n// accepted residual is #678's narrow \"equal low words\" coincidence). It is\n// NOT harmless for `+`: concatenating two int-reinterpreted-as-strings\n// produces a garbage packed value, not their sum -- confirmed empirically,\n// `my_add_gen(3, 4)` trapped instead of returning 7 with the plain heuristic.\n// Requiring `ptr >= 64` (the ORIGINAL pre-#664 bound) excludes every ordinary\n// small Int (whose implied ptr is 0..63) while a genuine String's\n// data-section/heap address in this codegen is always >= 64 -- INCLUDING\n// empty strings: `data_base` (the fixed start of the string data section,\n// `linked_compile.vibe`/`gc/backend_body.vibe`) is 64, so there is no\n// legitimate empty-string case with ptr < 64 to carve out here, unlike the\n// #664 residual this borrows its bound from.\n//\n// #973 P1 fix (Codex review on PR #1005): an EARLIER version of this\n// function additionally treated `len == 0` alone as \"looks like a string\"\n// (reasoning, incorrectly, that a real empty string might have ptr < 64).\n// That let (ptr=0, len=0) -- i.e. the packed representation of plain integer\n// `0` -- satisfy the strict check via the `len == 0` branch even though\n// `ptr >= 64` was false, so `num_add[T: Add](0, 0)` matched as \"both look\n// like strings\" and called `str_concat` instead of `i64.add`, returning a\n// garbage heap pointer instead of `0` -- confirmed empirically. Dropping the\n// `len == 0` disjunct (requiring `ptr >= 64` unconditionally) fixes this\n// while still accepting every genuine string, empty or not, per the\n// `data_base = 64` invariant above. The residual this narrows down to -- a\n// very large Int (implied ptr >= 64, i.e. the value is >= 64 * 2^32)\n// mistaken for a string -- is the same CLASS of accepted large-int residual\n// #664/#678 already carry for `eq`/`str_lex_diff`, just with a much smaller\n// trigger window than the plain heuristic's \"any small int\".\nfn emit_looks_like_string_strict(b: Bytes, slot: Int) -> Unit {\n  emit_looks_like_string(b, slot)\n  emit_local_get(b, slot)\n  emit_i64_const(b, 32)\n  bytebuf_push(b, 136)\n  emit_i64_const(b, 64)\n  emit_i64_ge_s(b)\n  bytebuf_push(b, 113)\n}\n\n// #973: runtime dispatch for `<`/`>`/`<=`/`>=` on an ERASED generic type\n// parameter (`[T: Ord]`). #952 keeps such a `T` rigid/polymorphic all the way\n// through the checker (no forced monomorphization to Int/Double/String), but\n// `Ord`/`Add` are method-less MARKER traits (declared with an empty body --\n// see `builtin_traits.vibe`), so `build_gens` never threads them a witness\n// dict (only method-bearing bounds get one). That leaves the desugar rewrite\n// in `desugar_trait_dict.vibe` with a STATIC type name of the bare type\n// parameter itself (e.g. \"T\", from `seed_var_types`'s generic `EFn` seeding)\n// at the `<`/`>`/`+` site -- nothing concrete to key a `String`-vs-`Int`\n// rewrite off, so it fell through to a raw signed i64 compare, which orders a\n// heap String operand's packed `(ptr<<32)|len` representation by POINTER, not\n// content (the `ord_clamp(\"m\",\"a\",\"z\")` repro in #973).\n//\n// Uses `emit_looks_like_string_strict` (see above), NOT the plain\n// `emit_looks_like_string` `gen_eq_body` uses -- see that function's doc\n// comment for why the plain heuristic is unsafe here. The non-string fallback\n// is the EXACT signed i64 compare `emit_binop_op` already emits for the\n// monomorphic case, so Int operands (and Double bit patterns, already broken\n// independently of this fix -- the default linear/non-RC backend has no tag\n// distinguishing an Int from an f64 bit pattern, so that residual is a\n// separate, harder problem left untouched) behave identically to before this\n// function existed. Returns a sign value consumed the same way `str_lex_diff`\n// is: desugar rewrites `a <op> b` to `__generic_rel_diff(a, b) <op> 0`. Under\n// RC, scalar Int is tagged `n << 1` (see `str_lex_diff`'s own tagging\n// comment) -- doubling preserves sign so `< 0` would stay correct either way,\n// but the numeric-fallback branch tags its own -1/0/1 literals to match\n// convention; the string branch already returns a `str_lex_diff` result that\n// tags itself internally, so it is NOT re-tagged here (that would\n// double-shift it).\nexport fn gen_generic_rel_diff_body(enable_rc: Bool, str_lex_diff_idx: Int) -> Bytes {\n  let neg1 = if enable_rc {\n    0 - 2\n  } else {\n    0 - 1\n  }\n  let pos1 = if enable_rc {\n    2\n  } else {\n    1\n  }\n  let b = bytebuf_new()\n  emit_looks_like_string_strict(b, 0)\n  emit_looks_like_string_strict(b, 1)\n  bytebuf_push(b, 113)\n  emit_if_i64(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, str_lex_diff_idx)\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_lt_s(b)\n  emit_if_i64(b)\n  emit_i64_const(b, neg1)\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_gt_s(b)\n  emit_if_i64(b)\n  emit_i64_const(b, pos1)\n  emit_else(b)\n  emit_i64_const(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\n// #973: runtime dispatch for `+` on an erased generic type parameter\n// (`[T: Add]`). Mirrors `gen_generic_rel_diff_body`'s string/numeric split\n// and ALSO uses `emit_looks_like_string_strict`, not the plain heuristic --\n// this one is not optional here (see that function's doc comment): the plain\n// heuristic answers \"looks like a string\" for nearly every ordinary small\n// Int, and concatenating two int-reinterpreted-as-strings produces a garbage\n// packed value, not their sum, with no rescue analogous to `str_eq`'s length\n// check or `str_lex_diff`'s tiebreak. String operands concat via\n// `str_concat_idx` (whose result is already the correctly-shaped packed\n// representation for its return type -- no extra tagging needed here),\n// non-string operands take the exact `emit_i64_add` the monomorphic Int path\n// already uses. Under RC, `tagged_a + tagged_b` already equals\n// `tagged(a + b)` (doubling is linear), matching `compile_expr.vibe`'s\n// existing RC `\"+\"` case, which likewise applies no post-add shift -- so this\n// needs no `enable_rc` parameter at all.\nexport fn gen_generic_add_body(str_concat_idx: Int) -> Bytes {\n  let b = bytebuf_new()\n  emit_looks_like_string_strict(b, 0)\n  emit_looks_like_string_strict(b, 1)\n  bytebuf_push(b, 113)\n  emit_if_i64(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, str_concat_idx)\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_add(b)\n  emit_end(b)\n  b\n}\n")
}

let cli_adapter_source_108 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/builtin_bodies/bodies_core_a1a1_str_eq.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_v128_load, emit_i8x16_eq, emit_i8x16_all_true, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\n// ADR-0054 (#748): byte-content equality with a 16-byte SIMD fast path.\n// After the length check, whole chunks are compared with `v128.load` x2 +\n// `i8x16.eq` + `i8x16.all_true` (v128 stays on the operand stack — no v128\n// locals); any unequal chunk answers 0 immediately (equality needs no\n// differing-byte position). A scalar byte loop finishes the < 16-byte tail.\n// Params 0=a 1=b (packed (ptr<<32)|len i64). Locals (all i32, meta_i32=6):\n// 2=len_a 3=len_b 4=ptr_a 5=ptr_b 6=i 7=chunk_limit (len-15, or 0 when\n// len < 16 so the unsigned loop guard skips the chunk phase entirely).\nexport fn gen_str_eq_body() -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_local_get(b, 3)\n  emit_i32_ne(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 0)\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 5)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 6)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 7)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 16)\n  emit_i32_ge_u(b)\n  emit_if_void(b)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 15)\n  emit_i32_sub(b)\n  emit_local_set(b, 7)\n  emit_end(b)\n  emit_block_i64(b)\n  // Scalar first-byte precheck: a mismatch at byte 0 answers without the\n  // 16-byte chunk work. index_of probes str_eq once per haystack position\n  // and ~all probes mismatch immediately — the chunk-first version made\n  // index_of 2x SLOWER than the old byte loop; this restores that fast path\n  // for one extra byte-compare on the (rarer) equal/long-prefix cases.\n  emit_block_void(b)\n  emit_local_get(b, 2)\n  emit_i32_eqz(b)\n  emit_br_if(b, 0)\n  emit_local_get(b, 4)\n  emit_i32_load8_u(b, 0, 0)\n  emit_local_get(b, 5)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i32_ne(b)\n  emit_i32_eqz(b)\n  emit_br_if(b, 0)\n  emit_i64_const(b, 0)\n  emit_br(b, 1)\n  emit_end(b)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 6)\n  emit_local_get(b, 7)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 4)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_v128_load(b, 0, 0)\n  emit_local_get(b, 5)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_v128_load(b, 0, 0)\n  emit_i8x16_eq(b)\n  emit_i8x16_all_true(b)\n  emit_i32_eqz(b)\n  emit_if_void(b)\n  emit_i64_const(b, 0)\n  emit_br(b, 3)\n  emit_end(b)\n  emit_local_get(b, 6)\n  emit_i32_const(b, 16)\n  emit_i32_add(b)\n  emit_local_set(b, 6)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 6)\n  emit_local_get(b, 2)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 4)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_local_get(b, 5)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i32_ne(b)\n  emit_if_void(b)\n  emit_i64_const(b, 0)\n  emit_br(b, 3)\n  emit_end(b)\n  emit_local_get(b, 6)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 6)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_i64_const(b, 1)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\n// #746/#748: lexicographic byte comparison for String `<` `>` `<=` `>=`.\n// Returns a sign-carrying diff (NOT normalized to -1/0/1): the first\n// differing byte's `a[i] - b[i]`, or `len_a - len_b` when one string is a\n// prefix of the other, 0 when equal. Callers only ever compare the result\n// against 0 (desugar rewrites `a < b` to `str_lex_diff(a, b) < 0`), so the\n// magnitude is irrelevant and the extra signum normalization is skipped.\n// Tagged (<<1) under RC like every value-world int return; shifting\n// preserves sign so `< 0` stays correct either way.\n// A 16-byte SIMD chunk loop skips the common prefix: equal chunks advance\n// by 16; the first UNEQUAL chunk breaks WITHOUT advancing so the scalar\n// loop locates the differing byte within <= 16 steps. Params 0=a 1=b\n// (packed (ptr<<32)|len i64). Locals (all i32, meta_i32=7): 2=len_a\n// 3=len_b 4=ptr_a 5=ptr_b 6=i 7=min_len 8=chunk_limit (min_len-15, or 0\n// when min_len < 16 so the unsigned guard skips the chunk phase).\nexport fn gen_str_lex_diff_body(enable_rc: Bool) -> Bytes {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 5)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 6)\n  emit_local_get(b, 2)\n  emit_local_get(b, 3)\n  emit_i32_ge_u(b)\n  emit_if_void(b)\n  emit_local_get(b, 3)\n  emit_local_set(b, 7)\n  emit_else(b)\n  emit_local_get(b, 2)\n  emit_local_set(b, 7)\n  emit_end(b)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 8)\n  emit_local_get(b, 7)\n  emit_i32_const(b, 16)\n  emit_i32_ge_u(b)\n  emit_if_void(b)\n  emit_local_get(b, 7)\n  emit_i32_const(b, 15)\n  emit_i32_sub(b)\n  emit_local_set(b, 8)\n  emit_end(b)\n  emit_block_i64(b)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 6)\n  emit_local_get(b, 8)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 4)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_v128_load(b, 0, 0)\n  emit_local_get(b, 5)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_v128_load(b, 0, 0)\n  emit_i8x16_eq(b)\n  emit_i8x16_all_true(b)\n  emit_i32_eqz(b)\n  emit_if_void(b)\n  emit_br(b, 2)\n  emit_end(b)\n  emit_local_get(b, 6)\n  emit_i32_const(b, 16)\n  emit_i32_add(b)\n  emit_local_set(b, 6)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 6)\n  emit_local_get(b, 7)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 4)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_local_get(b, 5)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i32_ne(b)\n  emit_if_void(b)\n  emit_local_get(b, 4)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_local_get(b, 5)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i32_sub(b)\n  emit_i64_extend_i32_s(b)\n  emit_br(b, 3)\n  emit_end(b)\n  emit_local_get(b, 6)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 6)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 2)\n  emit_local_get(b, 3)\n  emit_i32_sub(b)\n  emit_i64_extend_i32_s(b)\n  emit_end(b)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  } else {\n    ()\n  }\n  b\n}\n")
}

