let cli_adapter_source_219 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/preprocess_interp.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Stmt\n}\n\nimport ./preprocess_interp_rewrite.vibe {\n  rewrite_interp\n}\n\nimport @vibe/compiler/codegen {\n  desugar_trait_dicts\n}\n\n//# Functions\n\nexport fn expand_interp_stmts(stmts: Array[Stmt]) -> Unit with { Error } {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, is_rec, name, ann, expr) => Array::set(stmts, i, SLet(exp, is_rec, name, ann, rewrite_interp(expr)))\n      ,\n      STest(name, expr) => Array::set(stmts, i, STest(name, rewrite_interp(expr)))\n      ,\n      SBench(name, expr) => Array::set(stmts, i, SBench(name, rewrite_interp(expr)))\n      ,\n      _ => ()\n    }\n    i = i + 1\n  }\n  // Method-bearing-trait dictionary passing (#641 PR-3). No-op unless the\n  // program declares a trait with method signatures.\n  desugar_trait_dicts(stmts)\n}\n")
}

