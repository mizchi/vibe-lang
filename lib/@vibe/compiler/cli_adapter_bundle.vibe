let cli_adapter_source_203 = () -> (String, String) {
  ("lib/@vibe/json/jsonrpc.vibe",
"//# Imports\n\nimport @vibe/prelude {\n  Result\n}\n\nimport ./json.vibe {\n  Json, parse, stringify\n}\n\n//# Types\n\n// #897 (ADR-0070 Phase 3): declared `opaque type` in ./index.vpkg (not\n// transparent) — see json_types.vibe's `Json` comment: enum variants do not\n// resolve across units, so the definitions must stay in the impl file.\n\nexport enum RpcId {\n  IdNum(Int);\n  IdStr(String);\n  IdNull\n}\n\nexport enum RpcMessage {\n  Request(String, Json, RpcId);\n  Notification(String, Json);\n  SuccessResponse(RpcId, Json);\n  ErrorResponse(RpcId, Int, String, Json)\n}\n\n//# Functions\n\n// Inlined @vibe/prelude::from_option (#769 precedent, cache_underlying.vibe):\n// generate_bundle.sh strips import lines from embedded sources and\n// collect_merged_stmts resolves references BY NAME, so a cross-package\n// prelude FUNCTION reference here is unresolvable once this file rides in\n// the compiler's merged bundle (@vibe/prelude has no bundle rows). A local\n// definition survives the strip; Result/Option/Some/None/Ok/Err are\n// builtins and need no import.\nfn require_key(obj: Map[String, Json], key: String) -> Result[Json, String] {\n  if Map::has_key(obj, key) {\n    Ok(Map::get(obj, key))\n  } else {\n    Err(\"missing key: \\{key}\")\n  }\n}\n\nfn get_string(obj: Map[String, Json], key: String) -> Result[String, String] {\n  match require_key(obj, key) {\n    Ok(JStr(s)) => Ok(s),\n    Ok(_) => Err(\"expected string for key: \\{key}\"),\n    Err(msg) => Err(msg)\n  }\n}\n\nfn get_object(j: Json, message: String) -> Result[Map[String, Json], String] {\n  match j {\n    JObj(m) => Ok(m),\n    _ => Err(message)\n  }\n}\n\nfn parse_rpc_id(j: Json) -> Result[RpcId, String] {\n  match j {\n    JNum(n) => Ok(IdNum(Double::to_int(n))),\n    JStr(s) => Ok(IdStr(s)),\n    JNull => Ok(IdNull),\n    _ => Err(\"invalid id\")\n  }\n}\n\nexport fn parse_message(input: String) -> Result[RpcMessage, String] {\n  match parse(input) {\n    Ok((json, _)) => match get_object(json, \"expected object\") {\n      Ok(obj) => match get_string(obj, \"jsonrpc\") {\n        Ok(jsonrpc) =>\n          if jsonrpc != \"2.0\" {\n            Err(\"invalid jsonrpc version\")\n          } else {\n            let has_method = Map::has_key(obj, \"method\")\n            let has_result = Map::has_key(obj, \"result\")\n            let has_error = Map::has_key(obj, \"error\")\n            if has_method {\n              match get_string(obj, \"method\") {\n                Ok(method) => {\n                  let params = if Map::has_key(obj, \"params\") {\n                    Map::get(obj, \"params\")\n                  } else JNull\n                  if Map::has_key(obj, \"id\") {\n                    match parse_rpc_id(Map::get(obj, \"id\")) {\n                      Ok(id) => Ok(Request(method, params, id)),\n                      Err(msg) => Err(msg)\n                    }\n                  } else Ok(Notification(method, params))\n                },\n                Err(msg) => Err(msg)\n              }\n            } else if has_result {\n              match require_key(obj, \"id\") {\n                Ok(id_json) => match parse_rpc_id(id_json) {\n                  Ok(id) => Ok(SuccessResponse(id, Map::get(obj, \"result\"))),\n                  Err(msg) => Err(msg)\n                },\n                Err(msg) => Err(msg)\n              }\n            } else if has_error {\n              match require_key(obj, \"id\") {\n                Ok(id_json) => match parse_rpc_id(id_json) {\n                  Ok(id) => match get_object(Map::get(obj, \"error\"), \"error must be object\") {\n                    Ok(err_obj) => match require_key(err_obj, \"code\") {\n                      Ok(JNum(n)) => match get_string(err_obj, \"message\") {\n                        Ok(message) => {\n                          let data = if Map::has_key(err_obj, \"data\") {\n                            Map::get(err_obj, \"data\")\n                          } else JNull\n                          Ok(ErrorResponse(id, Double::to_int(n), message, data))\n                        },\n                        Err(msg) => Err(msg)\n                      },\n                      Ok(_) => Err(\"error code must be number\"),\n                      Err(msg) => Err(msg)\n                    },\n                    Err(msg) => Err(msg)\n                  },\n                  Err(msg) => Err(msg)\n                },\n                Err(msg) => Err(msg)\n              }\n            } else Err(\"invalid message: missing method, result, or error\")\n          },\n        Err(msg) => Err(msg)\n      },\n      Err(msg) => Err(msg)\n    },\n    Err(msg) => Err(msg)\n  }\n}\n\nfn rpc_id_json_str(id: RpcId) -> String {\n  match id {\n    IdNum(n) => stringify(JNum(Int::to_double(n))),\n    IdStr(s) => stringify(JStr(s)),\n    IdNull => \"null\"\n  }\n}\n\nexport fn stringify_error(id: RpcId, code: Int, message: String, data: Json) -> String {\n  let code_str = stringify(JNum(Int::to_double(code)))\n  let msg_str = stringify(JStr(message))\n  let data_str = stringify(data)\n  let id_str = rpc_id_json_str(id)\n  let err_str = \"{\\\"code\\\":\\{code_str},\\\"message\\\":\\{msg_str},\\\"data\\\":\\{data_str}}\"\n  \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"error\\\":\\{err_str},\\\"id\\\":\\{id_str}}\"\n}\n\nexport fn stringify_request(method: String, params: Json, id: RpcId) -> String {\n  let method_str = stringify(JStr(method))\n  let params_str = stringify(params)\n  let id_str = rpc_id_json_str(id)\n  \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"method\\\":\\{method_str},\\\"params\\\":\\{params_str},\\\"id\\\":\\{id_str}}\"\n}\n\nexport fn stringify_response(id: RpcId, result: Json) -> String {\n  let result_str = stringify(result)\n  let id_str = rpc_id_json_str(id)\n  \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"result\\\":\\{result_str},\\\"id\\\":\\{id_str}}\"\n}\n\nexport fn stringify_notification(method: String, params: Json) -> String {\n  let method_str = stringify(JStr(method))\n  let params_str = stringify(params)\n  \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"method\\\":\\{method_str},\\\"params\\\":\\{params_str}}\"\n}\n")
}

let cli_adapter_source_204 = () -> (String, String) {
  ("lib/@vibe/compiler/contract/index.vpkg",
"version 0.0.1\n\n// @vibe/compiler/contract — the .vpkg/.vibei contract conformance engine\n// itself (ADR-0063 Phase C, #729): bodyless-declaration parsing, impl\n// def/type collection, conformance checking, facade generation, contract /\n// package hashing, and the semver bump classifier (#731/#752/#847).\n// COMPILER-INTERNAL contract batch 2 (ADR-0070 Phase 3, #897) — compiled\n// into the compiler itself via compiler_sources_manifest.tsv (group\n// `loader`, dual-row: this contract + contract.vibe). Yes: the conformance\n// engine now checks its own contract.\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package is single-file), so it moved verbatim to contract.vibe. The\n// surface is fns plus two exported String constants (`let name: Type`\n// bodyless value declarations, #752; @vibe/cache `version` precedent,\n// PR #914). No exported types: every struct/enum this package touches\n// (Stmt/Token/TypeExpr) is owned by ../core / ../syntax and arrives as\n// structural signature text resolved against the implementation imports\n// when the facade is merged in (@vibe/symbol / @vibe/parser precedent —\n// no re-import needed here). The impl's trailing bare\n// `export { parse_contract_program, ... }` block (SExport) re-exports\n// names this file already defines+exports, is invisible to check_contract\n// (which only sees SLet defs and SReExport), and stays verbatim in\n// contract.vibe. No `version` binding existed (compiler-internal package).\n\n// --- facade / shared-import markers (#740/#753, #897)\nlet contract_facade_marker: String\nlet vpkg_shared_import_marker: String\n\n// --- contract grammar\nfn parse_contract_program(tokens: Array[Token]) -> (Array[(String, String)], Array[(String, Int)], Array[Stmt]) with { Error }\nfn classify_contract_stmts(stmts: Array[Stmt]) -> (Array[String], Array[Stmt]) with { Error }\nfn contract_impl_import_raw_paths(stmts: Array[Stmt]) -> Array[String] with { Error }\nfn contract_directory_shared_imports(stmts: Array[Stmt]) -> Array[Stmt]\nfn contract_directory_shared_import_prefix_text(stmts: Array[Stmt]) -> String\n\n// --- implementation surface collection + conformance\nfn collect_impl_fn_defs(stmts: Array[Stmt]) -> Array[(String, Option[String], Bool)]\nfn collect_impl_type_defs(stmts: Array[Stmt]) -> Array[(String, Bool, Int)]\nfn check_contract(decls: Array[(String, String)], opaque_names: Array[(String, Int)], impl_stmts: Array[Stmt], contract_type_defs: Array[Stmt]) -> Array[String]\n\n// --- facade generation\nfn contract_facade_source(decls: Array[(String, String)], opaque_names: Array[(String, Int)], type_defs: Array[Stmt], impl_units: Array[(String, Array[Stmt])]) -> String with { Error }\n\n// --- hashing\nfn contract_hash(fn_decls: Array[(String, String)], opaque_names: Array[(String, Int)], type_defs: Array[Stmt]) -> String\nfn package_hash_from_sources(sources: Array[(String, String)]) -> String\n\n// --- version / pin grammar (#751/#752)\nfn is_strict_semver(v: String) -> Bool\nfn is_package_pin(h: String) -> Bool\nfn extract_require_pins(source: String) -> (Array[(String, String, String)], String) with { Error }\nfn extract_package_version(source: String) -> String with { Error }\n\n// --- semver surface diff (#731)\nfn contract_surface_lines(fn_decls: Array[(String, String)], opaque_names: Array[(String, Int)], type_defs: Array[Stmt]) -> Array[String]\nfn classify_contract_change(old_lines: Array[String], new_lines: Array[String]) -> String\nfn semver_bump_kind(prev: String, next: String) -> Option[String]\nfn verify_publish_bump(prev_version: String, next_version: String, old_lines: Array[String], new_lines: Array[String]) -> Array[String]\n")
}

let cli_adapter_source_205 = () -> (String, String) {
  ("lib/@vibe/compiler/contract/contract.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr, Stmt, TypeExpr\n}\n\nimport @vibe/compiler/syntax {\n  Token, parse_type, peek, tk_name, parse_fn_signature, parse_stmt, print_stmt, print_type_expr\n}\n\n// #741: consumed through the @vibe/core contract boundary (directory import\n// resolving via index.vibei), replacing the vendored cache/sha1.vibe twin.\nimport @vibe/core {\n  array_empty,\n  sha1\n}\n\n//# Functions\n\n// #740/#753: facades are marked so every re-ingestion point (the grouped\n// chokepoint, the persistent-header lane, type_db re-reads of collected\n// sources) can tell an already-desugared facade from raw contract grammar.\n// Re-parsing a facade AS a contract mis-attributes its imports (a facade\n// with only `import ./impl.vibe {}` lines yields zero DECLS, and one with\n// only type defs yields zero impl imports → sibling auto-discovery), so the\n// marker check must happen wherever `.vibei`-suffixed sources are parsed.\nexport let contract_facade_marker: String = \"// vibe: contract facade (desugared from .vibei)\\n\"\n\n// #897 (ADR-0070 Phase 1): mirrors `contract_facade_marker`'s idempotency\n// role, for a DIFFERENT ingestion transform -- a sibling `.vibe` impl file\n// under a `.vpkg` directory gets that vpkg's directory-shared imports\n// PREPENDED to its own source text (see `contract_directory_shared_import_prefix_text`\n// below and `ingest_source_text_fs`/`collect_sources_rec` in loader/index.vibe,\n// the two call sites). Ingestion is applied more than once to the same\n// logical file in ordinary operation (`collect_source_groups_fs` re-ingests\n// every already-collected source; #740's comment documents the same\n// re-ingestion for the contract-facade case) -- without a marker, a second\n// pass would prepend the imports AGAIN, producing duplicate `import`\n// statements. The loader checks for this marker before prepending and skips\n// if already present, exactly like the facade marker check.\nexport let vpkg_shared_import_marker: String = \"// vibe: vpkg directory-shared imports (#897)\\n\"\n\n// ADR-0063 Phase C (#729): contract conformance engine for `.vibei` files.\n//\n// A contract file's top level declares the package's public API. This module\n// parses bodyless `fn` declarations (the contract grammar) and checks that a\n// package's implementation statements provide exactly the declared surface:\n// every declared fn exists with a matching signature (param types + labels,\n// generics, return type, effect row), and no exported def is undeclared.\n//\n// This increment is the pure engine + its grammar; wiring into import\n// resolution / the merge layer (directory imports resolving through\n// index.vibei, boundary rules) is the next #729 stage.\n\n// Canonical signature fingerprint: `[T: Eq](Int, x~: Int) -> Ret with { E }`.\n// Labeled params keep their name (the label is ABI); positional params are\n// types only. Built from the same shapes both the contract declaration and\n// the implementation's EFn carry, so string equality is signature equality.\nfn fn_sig_text(tps: Array[String], tbs: Array[(String, Array[String])], params: Array[(String, Option[TypeExpr])], ret_ty: TypeExpr, eff_opt: Option[String]) -> Option[String] {\n  let mut missing = false\n  let parts = array_empty()\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, pty_opt) = Array::get(params, i)\n    match pty_opt {\n      Some(pty) => {\n        let tystr = print_type_expr(pty)\n        let entry = if String::ends_with(pname, \"~\") {\n          \"\\{pname}: \\{tystr}\"\n        } else tystr\n        Array::push(parts, entry)\n      },\n      None => { missing = true }\n    }\n    i = i + 1\n  }\n  if missing {\n    None\n  } else {\n    let gen = if Array::length(tps) == 0 {\n      \"\"\n    } else {\n      let entries = array_empty()\n      let mut gi = 0\n      while gi < Array::length(tps) {\n        let tp = Array::get(tps, gi)\n        let mut bound = \"\"\n        let mut bi = 0\n        while bi < Array::length(tbs) {\n          let (bname, bnds) = Array::get(tbs, bi)\n          if bname == tp && Array::length(bnds) > 0 {\n            bound = String::join(bnds, \" + \")\n          } else ()\n          bi = bi + 1\n        }\n        let entry = if String::length(bound) == 0 {\n          tp\n        } else \"\\{tp}: \\{bound}\"\n        Array::push(entries, entry)\n        gi = gi + 1\n      }\n      \"[\\{String::join(entries, \", \")}]\"\n    }\n    let eff = match eff_opt {\n      Some(e) => \" with { \\{e} }\",\n      None => \"\"\n    }\n    Some(\"\\{gen}(\\{String::join(parts, \", \")}) -> \\{print_type_expr(ret_ty)}\\{eff}\")\n  }\n}\n\n// Parse a contract source's top level. Bare `fn` heads become declarations\n// (name, canonical signature); a declaration followed by `{` is an error —\n// contract files carry no bodies. `opaque type Name` declares a public type\n// whose definition lives in an implementation file (#729 C-4). Everything\n// else (implementation imports, transparent type definitions) parses as\n// ordinary statements and is returned alongside.\n// #739: opaque/bodyless type declarations carry (name, arity) so conformance\n// can reject an impl whose type-parameter count differs and the semver\n// surface can see `Box` -> `Box[T]` as a breaking change.\nexport fn parse_contract_program(tokens: Array[Token]) -> (Array[(String, String)], Array[(String, Int)], Array[Stmt]) with { Error } {\n  let decls = array_empty()\n  let opaques = array_empty()\n  let stmts = array_empty()\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => { done = true },\n      TType => {\n        // Bodyless `type Name` / `type Name[T]` — a TRANSPARENT public type\n        // whose definition lives in an implementation file (the facade\n        // re-exports it; same conformance rules as opaque, opacity is the\n        // only — currently documentation-level — difference). `type X = ..`\n        // (with '=') is the contract-defined alias and parses as a stmt.\n        let mut la = pos + 1\n        let tname = match peek(tokens, la) {\n          TIdent(tn) => tn,\n          _ => \"\"\n        }\n        let mut is_bodyless = false\n        let mut arity = 0\n        if tname == \"\" {\n          ()\n        } else {\n          la = la + 1\n          let mut scan = la\n          match peek(tokens, scan) {\n            TLBracket => {\n              let mut depth = 1\n              // `[T, U]` — parameters at depth 1 are comma-separated (#739).\n              arity = 1\n              scan = scan + 1\n              while depth > 0 {\n                match peek(tokens, scan) {\n                  TLBracket => { depth = depth + 1 },\n                  TRBracket => { depth = depth - 1 },\n                  TComma => if depth == 1 {\n                    arity = arity + 1\n                  } else {\n                    ()\n                  },\n                  TEof => { depth = 0 },\n                  _ => ()\n                }\n                scan = scan + 1\n              }\n            },\n            _ => ()\n          }\n          match peek(tokens, scan) {\n            TEq => {\n              arity = 0\n            },\n            _ => {\n              is_bodyless = true\n              la = scan\n            }\n          }\n        }\n        if is_bodyless {\n          Array::push(opaques, (tname, arity))\n          pos = la\n        } else {\n          let (stmt, next) = parse_stmt(tokens, [], pos)\n          Array::push(stmts, stmt)\n          pos = next\n        }\n      },\n      TLet => {\n        // #752 (ADR-0065): bodyless `let name: Type` — a public VALUE\n        // declaration (constants like `pi: Double`). The definition lives in\n        // an implementation file and is fingerprinted as \"val <type>\";\n        // conformance and the facade treat it exactly like a fn decl (both\n        // are name + signature-string). A body (`= ...`) is rejected like fn\n        // bodies; `let mut` cannot be contract surface.\n        match peek(tokens, pos + 1) {\n          TMut => throw(\"contract let declaration cannot be `mut` (#752)\"),\n          _ => ()\n        }\n        let vname = match peek(tokens, pos + 1) {\n          TIdent(vn) => vn,\n          _ => throw(\"expected value name after 'let' in a contract\")\n        }\n        match peek(tokens, pos + 2) {\n          TColon => (),\n          _ => throw(\"contract value declaration '\\{vname}' requires a type annotation (#752)\")\n        }\n        let (vty, vnext) = parse_type(tokens, pos + 3)\n        match peek(tokens, vnext) {\n          TEq => throw(\"contract value declaration '\\{vname}' must not have a definition (#752)\"),\n          _ => ()\n        }\n        Array::push(decls, (vname, String::concat(\"val \", print_type_expr(vty))))\n        pos = vnext\n      },\n      TIdent(head) => if head == \"opaque\" {\n        match peek(tokens, pos + 1) {\n          TType => match peek(tokens, pos + 2) {\n            TIdent(oname) => {\n              match peek(tokens, pos + 3) {\n                TLBracket => throw(\"opaque type '\\{oname}': type parameters are not yet supported (#729)\"),\n                _ => ()\n              }\n              Array::push(opaques, (oname, 0))\n              pos = pos + 3\n            },\n            _ => throw(\"expected type name after 'opaque type'\")\n          },\n          _ => throw(\"expected 'type' after 'opaque'\")\n        }\n      } else if head == \"fn\" {\n        // where clauses on declarations parse but are not yet part of the\n        // contract fingerprint (conformance/hash coverage comes with the\n        // SMT stage of #731).\n        let (dhead, dsig, _, next) = parse_fn_signature(tokens, pos + 1)\n        let (name, tps, tbs) = dhead\n        let (params, ret_ty, eff_opt) = dsig\n        match peek(tokens, next) {\n          TLBrace => throw(\"contract fn declaration '\\{name}' must not have a body (#729)\"),\n          _ => ()\n        }\n        match fn_sig_text(tps, tbs, params, ret_ty, eff_opt) {\n          Some(sig) => Array::push(decls, (name, sig)),\n          None => throw(\"contract fn declaration '\\{name}' requires full annotations\")\n        }\n        pos = next\n      } else {\n        let (stmt, next) = parse_stmt(tokens, [], pos)\n        Array::push(stmts, stmt)\n        pos = next\n      },\n      _ => {\n        let (stmt, next) = parse_stmt(tokens, [], pos)\n        Array::push(stmts, stmt)\n        pos = next\n      }\n    }\n  }\n  (decls, opaques, stmts)\n}\n\n// Collect (name, Some(sig) | None, exported) for every top-level let whose\n// value is a function. A None signature means the def lacks the full\n// annotations needed to compare against a contract (e.g. an unannotated\n// lambda) — reported as a conformance error if the name is declared.\nexport fn collect_impl_fn_defs(stmts: Array[Stmt]) -> Array[(String, Option[String], Bool)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, _, name, ty_opt, val) => match val {\n        EFn(tps, tbs, params, ret_opt, eff_opt, _) => {\n          let sig = match ret_opt {\n            Some(ret_ty) => fn_sig_text(tps, tbs, params, ret_ty, eff_opt),\n            None => None\n          }\n          Array::push(out, (name, sig, exported))\n        },\n        // #752: a non-fn top-level let is a VALUE def — contract surface when\n        // exported, fingerprinted as \"val <type>\" (matching the contract's\n        // bodyless `let name: Type` declarations). An unannotated value maps\n        // to None, so a declared name reports the standard\n        // \"lacks the full annotations\" conformance error.\n        _ => match ty_opt {\n          Some(vty) => Array::push(out, (name, Some(String::concat(\"val \", print_type_expr(vty))), exported)),\n          None => Array::push(out, (name, None, exported))\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// Collect (name, exported) for every top-level type definition (struct /\n// enum / type alias / suberror) — the shapes an `opaque type` declaration\n// can be implemented by.\n// #739: the third element is the implementation's type-parameter count, so\n// conformance can compare it against the contract's declared arity.\n// Suberrors carry no type parameters in the AST — arity 0. Structs DO\n// (#829 gave SStruct a trailing tparams field, `struct S[T] { ... }`) —\n// this used to be hardcoded to 0 for every struct, which forced every\n// generic-struct package's contract to under-declare its arity as 0 (see\n// e.g. the #841 packages' now-stale \"arity 0\" workaround NOTEs).\nexport fn collect_impl_type_defs(stmts: Array[Stmt]) -> Array[(String, Bool, Int)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(exported, name, _, _, _, tparams) => Array::push(out, (name, exported, Array::length(tparams))),\n      SEnum(exported, name, tparams, _, _) => Array::push(out, (name, exported, Array::length(tparams))),\n      STypeAlias(exported, name, tparams, _) => Array::push(out, (name, exported, Array::length(tparams))),\n      SSuberror(exported, name, _) => Array::push(out, (name, exported, 0)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// #847: names an impl file brings into the package's export surface via\n// `export ./other.vibe { name, other as alias }` rather than a direct\n// SLet/SStruct/... definition — invisible to `collect_impl_fn_defs`/\n// `collect_impl_type_defs`, which only match direct top-level defs. Resolved\n// to the alias when present (the alias, not the source name, is what the\n// contract surface actually sees).\nfn collect_reexported_names(impl_stmts: Array[Stmt]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(impl_stmts) {\n    match Array::get(impl_stmts, i) {\n      SReExport(_, items) => {\n        let mut ii = 0\n        while ii < Array::length(items) {\n          let (rname, alias_opt) = Array::get(items, ii)\n          let exported_name = match alias_opt {\n            Some(a) => a,\n            None => rname\n          }\n          Array::push(out, exported_name)\n          ii = ii + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn array_contains_string(xs: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(xs) {\n    if Array::get(xs, i) == target {\n      found = true\n    } else ()\n    i = i + 1\n  }\n  found\n}\n\n// ADR-0071 (#755) step 5: signature-matching effectset awareness. decls'\n// and defs' signature strings (fn_sig_text, above) render a fn's effect\n// row VERBATIM as parsed -- a contract spelled with an effectset alias\n// (`with { AskAll }`) and an implementation spelled with the literal\n// operations it expands to (`with { Ask::Get }`) are semantically\n// identical but compare unequal as raw strings, producing a false\n// \"signature mismatch\". Local to this file (no new cross-file reference --\n// see docs/effectset.md's bootstrap gotcha) since it needs its own\n// ES table built from the CONTRACT's own type_defs (the sole source of\n// truth for effect/effectset definitions; implementation files use but\n// never redefine them, same discipline as SEffectDef).\nfn ctr_es_index_of(names: Array[String], name: String) -> Int {\n  let mut i = 0\n  let mut found = -1\n  while i < Array::length(names) {\n    if Array::get(names, i) == name {\n      found = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn ctr_es_contains(arr: Array[String], v: String) -> Bool {\n  ctr_es_index_of(arr, v) >= 0\n}\n\nfn ctr_es_collect_tables(stmts: Array[Stmt]) -> (Array[String], Array[Array[String]]) {\n  let es_names = array_empty()\n  let es_members_list = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectSet(_, esname, esmembers) => {\n        Array::push(es_names, esname)\n        Array::push(es_members_list, esmembers)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  (es_names, es_members_list)\n}\n\n// Same cycle-safe DFS technique as checker_stmt.vibe's es_detect_cycle /\n// es_expand_into -- a cyclic effectset is rejected by the checker\n// separately (checker_stmt.vibe), but this pass runs independently at\n// load/conformance time and must not hang even on a source that hasn't\n// been through that check yet.\nfn ctr_es_expand_into(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String], out: Array[String]) -> Unit {\n  if ctr_es_contains(path, name) {\n    ()\n  } else {\n    let idx = ctr_es_index_of(es_names, name)\n    if idx < 0 {\n      if ctr_es_contains(out, name) {\n        ()\n      } else {\n        Array::push(out, name)\n      }\n    } else {\n      Array::push(path, name)\n      let members = Array::get(es_members_list, idx)\n      let mut mi = 0\n      while mi < Array::length(members) {\n        ctr_es_expand_into(es_names, es_members_list, Array::get(members, mi), path, out)\n        mi = mi + 1\n      }\n      Array::truncate(path, Array::length(path) - 1)\n    }\n  }\n}\n\nfn ctr_es_join_comma(names: Array[String]) -> String {\n  let mut result = \"\"\n  let mut i = 0\n  while i < Array::length(names) {\n    if i == 0 {\n      result = Array::get(names, i)\n    } else {\n      result = String::concat(result, String::concat(\", \", Array::get(names, i)))\n    }\n    i = i + 1\n  }\n  result\n}\n\nfn ctr_es_expand_row_string(row: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> String {\n  let raw = String::split(row, \", \")\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(raw) {\n    let expanded = array_empty()\n    ctr_es_expand_into(es_names, es_members_list, Array::get(raw, i), array_empty(), expanded)\n    let mut j = 0\n    while j < Array::length(expanded) {\n      let e = Array::get(expanded, j)\n      if ctr_es_contains(out, e) {\n        ()\n      } else {\n        Array::push(out, e)\n      }\n      j = j + 1\n    }\n    i = i + 1\n  }\n  ctr_es_join_comma(out)\n}\n\n// `sig` is fn_sig_text's output; when a row is present it ALWAYS ends in\n// the exact suffix \" with { ROW }\" (see fn_sig_text above). Finds that\n// suffix (first \"with {\" is safe -- no other part of a rendered signature\n// can contain that substring), expands ROW's effectset-name tokens, and\n// rebuilds the string. A signature with no row, or one that doesn't match\n// the expected suffix shape, passes through completely unchanged (never\n// corrupt a string this pass doesn't recognize).\nfn ctr_expand_sig_row(sig: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> String {\n  if Array::length(es_names) == 0 {\n    sig\n  } else {\n    let marker = \" with { \"\n    let idx = String::index_of(sig, marker)\n    if idx < 0 {\n      sig\n    } else {\n      let slen = String::length(sig)\n      let mlen = String::length(marker)\n      if slen < idx + mlen + 2 {\n        sig\n      } else {\n        let last_two = String::substring(sig, slen - 2, slen)\n        if last_two != \" }\" {\n          sig\n        } else {\n          let head = String::substring(sig, 0, idx)\n          let row = String::substring(sig, idx + mlen, slen - 2)\n          let expanded = ctr_es_expand_row_string(row, es_names, es_members_list)\n          String::concat(head, String::concat(marker, String::concat(expanded, \" }\")))\n        }\n      }\n    }\n  }\n}\n\n// Check that `impl_stmts` provide exactly the contract surface. Returns a\n// list of human-readable conformance errors; empty = conformant.\n// `contract_type_defs` (ADR-0071/#755): the CONTRACT's own classified type\n// definitions (classify_contract_stmts' second return value at the call\n// site) -- used only to build the effectset expansion table above, so a\n// contract signature spelled with an effectset alias and an\n// implementation spelled with its literal expansion compare as equal\n// instead of a false \"signature mismatch\".\nexport fn check_contract(decls: Array[(String, String)], opaque_names: Array[(String, Int)], impl_stmts: Array[Stmt], contract_type_defs: Array[Stmt]) -> Array[String] {\n  let errors = array_empty()\n  let (ctr_es_names, ctr_es_members_list) = ctr_es_collect_tables(contract_type_defs)\n  let defs = collect_impl_fn_defs(impl_stmts)\n  // #847: a re-exported name has no signature to compare (SReExport carries\n  // no type info) — it is accepted at face value as satisfying a declared\n  // fn or opaque type, same trust boundary the loader already gives a plain\n  // `export ./impl.vibe { name }` line (the re-exported definition's OWN\n  // package/contract is responsible for that definition's correctness).\n  let reexported = collect_reexported_names(impl_stmts)\n  let mut di = 0\n  while di < Array::length(decls) {\n    let (dname, dsig) = Array::get(decls, di)\n    // ADR-0071 (#755): compare EXPANDED forms so a contract signature\n    // spelled with an effectset alias matches an implementation spelled\n    // with the literal operations it expands to (or vice versa) -- `dsig`\n    // itself (used in error messages / satisfied tracking below) stays the\n    // original, as-written text so a mismatch still quotes what the user\n    // actually typed, not an internal normalized form.\n    let dsig_expanded = ctr_expand_sig_row(dsig, ctr_es_names, ctr_es_members_list)\n    // A declaration is satisfied by ANY exported def with a matching\n    // signature. Same-name defs in OTHER package files (private aliases,\n    // domain-local helpers) are legal and never violations by themselves —\n    // only when NO def satisfies the decl do the candidates drive the\n    // error message (best mismatch first, then export status).\n    let mut satisfied = false\n    let mut seen_any = false\n    let mut best_msg = \"\"\n    let mut fi = 0\n    while fi < Array::length(defs) {\n      let (fname, fsig_opt, fexported) = Array::get(defs, fi)\n      if fname == dname {\n        seen_any = true\n        match fsig_opt {\n          Some(fsig) => if ctr_expand_sig_row(fsig, ctr_es_names, ctr_es_members_list) == dsig_expanded {\n            if fexported {\n              satisfied = true\n            } else {\n              best_msg = \"contract declaration '\\{dname}' is implemented but not exported by its implementation file\"\n            }\n          } else {\n            if best_msg == \"\" {\n              best_msg = \"signature mismatch for '\\{dname}': contract \\{dsig} but implementation \\{fsig}\"\n            } else ()\n          },\n          None => if best_msg == \"\" {\n            best_msg = \"implementation of '\\{dname}' lacks the full annotations required by the contract\"\n          } else ()\n        }\n      } else ()\n      fi = fi + 1\n    }\n    if satisfied {\n      ()\n    } else if array_contains_string(reexported, dname) {\n      ()\n    } else if seen_any {\n      Array::push(errors, best_msg)\n    } else {\n      Array::push(errors, \"contract declaration '\\{dname}' has no implementation\")\n    }\n    di = di + 1\n  }\n  let mut ei = 0\n  while ei < Array::length(defs) {\n    let (fname, _fsig_opt, fexported) = Array::get(defs, ei)\n    if fexported {\n      let mut declared = false\n      let mut ci = 0\n      while ci < Array::length(decls) {\n        let (dname, _dsig) = Array::get(decls, ci)\n        if dname == fname {\n          declared = true\n        } else ()\n        ci = ci + 1\n      }\n      if declared {\n        ()\n      } else {\n        Array::push(errors, \"exported '\\{fname}' is not declared in the contract\")\n      }\n    } else ()\n    ei = ei + 1\n  }\n  let type_defs = collect_impl_type_defs(impl_stmts)\n  let mut oi = 0\n  while oi < Array::length(opaque_names) {\n    let (oname, oarity) = Array::get(opaque_names, oi)\n    // #847: same trust-at-face-value treatment as the fn-decl loop above —\n    // a re-exported name has no arity to compare, so it satisfies an opaque\n    // type declaration without an arity check (there is nothing to check).\n    let mut ofound = array_contains_string(reexported, oname)\n    let mut ti = 0\n    while ti < Array::length(type_defs) {\n      let (tname, texported, tarity) = Array::get(type_defs, ti)\n      if tname == oname {\n        ofound = true\n        if texported {\n          ()\n        } else {\n          Array::push(errors, \"opaque type '\\{oname}' is implemented but not exported by its implementation file\")\n        }\n        // #739: the contract's declared type-parameter count is part of the\n        // surface — `type Box[T]` is not satisfied by a nullary `enum Box`.\n        if tarity == oarity {\n          ()\n        } else {\n          Array::push(errors, \"type '\\{oname}' arity mismatch: contract declares \\{oarity} type parameter(s), implementation defines \\{tarity}\")\n        }\n      } else ()\n      ti = ti + 1\n    }\n    if ofound {\n      ()\n    } else {\n      Array::push(errors, \"opaque type '\\{oname}' has no implementation\")\n    }\n    oi = oi + 1\n  }\n  let mut xi = 0\n  while xi < Array::length(type_defs) {\n    let (tname, texported, _) = Array::get(type_defs, xi)\n    if texported {\n      let mut tdeclared = false\n      let mut oj = 0\n      while oj < Array::length(opaque_names) {\n        let (ojname, _) = Array::get(opaque_names, oj)\n        if ojname == tname {\n          tdeclared = true\n        } else ()\n        oj = oj + 1\n      }\n      if tdeclared {\n        ()\n      } else {\n        Array::push(errors, \"exported type '\\{tname}' is not declared in the contract (declare it as `opaque type \\{tname}` or define it transparently in the contract)\")\n      }\n    } else ()\n    xi = xi + 1\n  }\n  // #847: `collect_impl_fn_defs`/`collect_impl_type_defs` only see SLet/\n  // SStruct/... top-level defs — an impl file that RE-exports a symbol\n  // (`export ./other.vibe { extra }`) is neither, so its name was invisible\n  // to every check above and could leak an undeclared symbol into the\n  // package's real export surface. Require every re-exported name to match\n  // either a declared fn or a declared opaque type.\n  let mut rxi = 0\n  while rxi < Array::length(reexported) {\n    let exported_name = Array::get(reexported, rxi)\n    let mut rdeclared = false\n    let mut rdi = 0\n    while rdi < Array::length(decls) {\n      let (dname, _) = Array::get(decls, rdi)\n      if dname == exported_name {\n        rdeclared = true\n      } else ()\n      rdi = rdi + 1\n    }\n    if rdeclared {\n      ()\n    } else {\n      let mut roi = 0\n      while roi < Array::length(opaque_names) {\n        let (oname, _) = Array::get(opaque_names, roi)\n        if oname == exported_name {\n          rdeclared = true\n        } else ()\n        roi = roi + 1\n      }\n    }\n    if rdeclared {\n      ()\n    } else {\n      Array::push(errors, \"re-exported '\\{exported_name}' is not declared in the contract\")\n    }\n    rxi = rxi + 1\n  }\n  errors\n}\n\n// Classify a contract's non-declaration statements: implementation-file\n// imports (`import ./impl.vibe {}`) and transparent type definitions\n// (struct / enum / type alias — the definition IS the contract, so it lives\n// here and passes into the facade verbatim, exported). Anything else is\n// rejected (subpath re-exports arrive with @scope resolution, #730).\nexport fn classify_contract_stmts(stmts: Array[Stmt]) -> (Array[String], Array[Stmt]) with { Error } {\n  let raws = array_empty()\n  let type_defs = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => Array::push(raws, raw_path),\n      SStruct(_, name, fields, derives, mut_names, tparams) => Array::push(type_defs, SStruct(true, name, fields, derives, mut_names, tparams)),\n      SEnum(_, name, tparams, ctors, derives) => Array::push(type_defs, SEnum(true, name, tparams, ctors, derives)),\n      STypeAlias(_, name, tparams, ty) => Array::push(type_defs, STypeAlias(true, name, tparams, ty)),\n      // #752: a transparent EFFECT definition — like transparent types, the\n      // definition IS the contract (effect rows are core contract surface,\n      // ADR-0063). It passes into the facade verbatim, exported; the\n      // implementation files use the effect but must not re-define it.\n      SEffectDef(_, ename, etparams, eops) => Array::push(type_defs, SEffectDef(true, ename, etparams, eops)),\n      // ADR-0071 (#755) step 5: an `effectset` is likewise a transparent,\n      // compile-time-only alias (no runtime identity of its own, same as\n      // SEffectDef) -- the ADR's Decision section explicitly calls out\n      // that it \"は `index.vpkg` の contract symbol として import/export\n      // できる\". Passes into the facade verbatim, exported, same as\n      // SEffectDef immediately above. The checker (checker_stmt.vibe)\n      // still independently validates cycle/collision on every effectset\n      // it type-checks, including ones that arrive via this contract path.\n      SEffectSet(_, esname, esmembers) => Array::push(type_defs, SEffectSet(true, esname, esmembers)),\n      // #729's original message said \"a .vibei contract\" -- this classifier\n      // is shared plumbing for BOTH `index.vpkg` (ADR-0070's boundary file,\n      // docs/module-system-oracle.md) and the legacy `index.vibei` spelling\n      // (not itself a boundary; kept only during migration), invoked from\n      // loader.vibe/header_cache.vibe regardless of which extension the\n      // directory actually has. \"contract file\" avoids implying vpkg\n      // callers hit vibei-specific rules.\n      _ => throw(\"unsupported statement in a contract file (index.vpkg / index.vibei): only fn declarations, opaque type declarations, transparent type/effect/effectset definitions, and implementation-file imports are allowed (#729)\")\n    }\n    i = i + 1\n  }\n  (raws, type_defs)\n}\n\n// Compat shim for the strict v1 shape (implementation imports only).\nexport fn contract_impl_import_raw_paths(stmts: Array[Stmt]) -> Array[String] with { Error } {\n  let (raws, _) = classify_contract_stmts(stmts)\n  raws\n}\n\n// #897 (ADR-0070 Phase 1): does every item of a qualified `import <path> as\n// <mod> only { x, y }` import get its dot-joined \"mod.x\" alias (parser.vibe's\n// `qualify_import_items`)? Real identifiers can never contain '.', so a \".\"\n// inside an item's alias is conclusive proof the import was written in the\n// namespaced `as ... only` form, not the unqualified `import <path> { x, y }`\n// form this module's directory-shared-scope feature applies to. Only the\n// unqualified form is shared with sibling impl files -- the namespaced form's\n// whole point is to keep `mod.x` the ONLY way in, so propagating it verbatim\n// would defeat that.\nfn import_items_are_dot_qualified(items: Array[(String, Option[String])]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    let (_, alias) = Array::get(items, i)\n    match alias {\n      Some(a) => if String::index_of(a, \".\") >= 0 {\n        found = true\n      } else {\n        ()\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// #897 (ADR-0070 Phase 1): a `.vpkg` contract's own UNQUALIFIED external\n// dependency imports (`import @user/mod { x, y }`) -- the ones ADR-0070\n// says register `x`/`y` into the package directory's SHARED scope, so any\n// sibling `.vibe` implementation file can use them without its own import\n// line. Scans the same non-declaration statement list `classify_contract_stmts`\n// does (a contract's `extra`, pre-classification), but keeps the full\n// `SImport` node (raw path + item names/aliases) instead of collapsing to a\n// bare path string, and keeps only `@`-prefixed imports whose items are NOT\n// namespace-qualified (see `import_items_are_dot_qualified`). Relative\n// impl-file imports (`import ./impl.vibe {}`) and the namespaced `as mod\n// only` form are excluded -- neither participates in directory-shared scope.\nexport fn contract_directory_shared_imports(stmts: Array[Stmt]) -> Array[Stmt] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, items) =>\n        if String::starts_with(raw_path, \"@\") && !import_items_are_dot_qualified(items) {\n          Array::push(out, SImport(raw_path, items))\n        } else {\n          ()\n        },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// #897: render a `.vpkg` contract's directory-shared imports (see\n// `contract_directory_shared_imports`) as literal `import ...` source lines,\n// one per statement, each newline-terminated -- ready to PREPEND verbatim to\n// a qualifying sibling `.vibe` file's own source text so every existing\n// import-processing code path (checker env-binding, whole-program merge\n// rename/alias-rewrite, header/dep extraction) sees the inherited import\n// exactly as if the sibling had written it itself. `print_stmt` round-trips\n// `SImport` back to valid `import <path> { name [as alias], ... }` syntax\n// (parser.vibe/printer.vibe), so this needs no bespoke formatting. Empty\n// input -> \"\" (nothing to prepend).\nexport fn contract_directory_shared_import_prefix_text(stmts: Array[Stmt]) -> String {\n  let shared = contract_directory_shared_imports(stmts)\n  if Array::length(shared) == 0 {\n    \"\"\n  } else {\n    let lines = array_empty()\n    let mut i = 0\n    while i < Array::length(shared) {\n      Array::push(lines, print_stmt(Array::get(shared, i)))\n      i = i + 1\n    }\n    String::concat(String::join(lines, \"\\n\"), \"\\n\")\n  }\n}\n\n// Desugar a conformance-checked contract to facade source text: one\n// `export <raw> { names }` re-export line per implementation file, each\n// declared name allocated to its first definer. The facade is plain vibe\n// source, so everything downstream of the loader (type db, merge plan,\n// codegen) needs no .vibei awareness — it rides the #716 re-export\n// machinery unchanged.\nexport fn contract_facade_source(decls: Array[(String, String)], opaque_names: Array[(String, Int)], type_defs: Array[Stmt], impl_units: Array[(String, Array[Stmt])]) -> String with { Error } {\n  let lines = array_empty()\n  let mut tdi = 0\n  while tdi < Array::length(type_defs) {\n    Array::push(lines, print_stmt(Array::get(type_defs, tdi)))\n    tdi = tdi + 1\n  }\n  let allocated = array_empty()\n  let mut ui = 0\n  while ui < Array::length(impl_units) {\n    let (raw, unit_stmts) = Array::get(impl_units, ui)\n    let defs = collect_impl_fn_defs(unit_stmts)\n    let unit_types = collect_impl_type_defs(unit_stmts)\n    // #847: a unit may satisfy a declaration purely via `export ./other.vibe\n    // { name }` (no direct SLet/SStruct/... def of its own) — `check_contract`\n    // already accepts this (a re-export is trusted at face value, same as any\n    // other impl declaration), so the facade must allocate it here too, or a\n    // contract that relies on re-export throws \"some declarations have no\n    // implementation file\" despite passing conformance.\n    let unit_reexported = collect_reexported_names(unit_stmts)\n    let names = array_empty()\n    let mut oi = 0\n    while oi < Array::length(opaque_names) {\n      let (oname, _) = Array::get(opaque_names, oi)\n      let mut otaken = false\n      let mut oai = 0\n      while oai < Array::length(allocated) {\n        if Array::get(allocated, oai) == \"type \\{oname}\" {\n          otaken = true\n        } else ()\n        oai = oai + 1\n      }\n      if otaken {\n        ()\n      } else {\n        let mut here = array_contains_string(unit_reexported, oname)\n        let mut uti = 0\n        while uti < Array::length(unit_types) {\n          let (tname, _, _) = Array::get(unit_types, uti)\n          if tname == oname {\n            here = true\n          } else ()\n          uti = uti + 1\n        }\n        if here {\n          Array::push(names, \"type \\{oname}\")\n          Array::push(allocated, \"type \\{oname}\")\n        } else ()\n      }\n      oi = oi + 1\n    }\n    let mut di = 0\n    while di < Array::length(decls) {\n      let (dname, _) = Array::get(decls, di)\n      let mut taken = false\n      let mut ai = 0\n      while ai < Array::length(allocated) {\n        if Array::get(allocated, ai) == dname {\n          taken = true\n        } else ()\n        ai = ai + 1\n      }\n      if taken {\n        ()\n      } else {\n        let mut defined_here = array_contains_string(unit_reexported, dname)\n        let mut fi = 0\n        while fi < Array::length(defs) {\n          let (fname, _, fexp) = Array::get(defs, fi)\n          if fname == dname && fexp {\n            defined_here = true\n          } else ()\n          fi = fi + 1\n        }\n        if defined_here {\n          Array::push(names, dname)\n          Array::push(allocated, dname)\n        } else ()\n      }\n      di = di + 1\n    }\n    if Array::length(names) > 0 {\n      Array::push(lines, \"export \\{raw} { \\{String::join(names, \", \")} }\")\n    } else {\n      // #753: an impl unit with no allocated names must STILL appear in the\n      // facade. A facade with no import/export lines re-header-parses (the\n      // type_db lane re-reads collected sources under the .vibei path) to\n      // ZERO impl imports, which triggers sibling auto-discovery and pulls\n      // test files beside the package into its dep set — an `import .` test\n      // then manufactures \"type_db: import cycle detected\". Zero-name impl\n      // units are real for all-transparent-type packages (@vibe/ast).\n      Array::push(lines, \"import \\{raw} {}\")\n    }\n    ui = ui + 1\n  }\n  if Array::length(allocated) != Array::length(decls) + Array::length(opaque_names) {\n    throw(\"contract facade: some declarations have no implementation file (run check_contract first)\")\n  } else ()\n  String::concat(String::join(lines, \"\\n\"), \"\\n\")\n}\n\n// ADR-0063 §5 (#730): content addressing. Two hashes identify a package:\n//\n// - contract_hash — the API surface only (fn signatures, opaque names,\n//   transparent type definitions), independent of implementation text.\n//   The API-compatibility signal and the dependents' recheck cache key.\n// - package_hash — the merkle over the package's normalized (path, source)\n//   pairs. Paths must be PACKAGE-RELATIVE (the contract as \"index.vibei\",\n//   impls by their raw import spelling) so the hash is location-independent.\n//   Since require/import lines are part of the hashed file contents, pinning\n//   a package hash transitively fixes its dependency choices.\n//\n// Format: `ct:sha1:<40hex>` / `pkg:sha1:<40hex>` (SHA1 per ADR-0004; the\n// scheme prefix leaves room for a stronger digest without ambiguity).\n\nfn sorted_strings(items: Array[String]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(items) {\n    Array::push(out, Array::get(items, i))\n    i = i + 1\n  }\n  let n = Array::length(out)\n  let mut a = 0\n  while a < n {\n    let mut b = a + 1\n    let mut min_i = a\n    while b < n {\n      // char-by-char lexicographic compare (String < is length-first)\n      let x = Array::get(out, b)\n      let y = Array::get(out, min_i)\n      let xl = String::length(x)\n      let yl = String::length(y)\n      let mut ci = 0\n      let mut cmp = 0\n      while cmp == 0 && ci < xl && ci < yl {\n        let cx = String::char_code_at(x, ci)\n        let cy = String::char_code_at(y, ci)\n        if cx < cy {\n          cmp = 0 - 1\n        } else if cx > cy {\n          cmp = 1\n        } else ()\n        ci = ci + 1\n      }\n      if cmp == 0 {\n        if xl < yl {\n          cmp = 0 - 1\n        } else if xl > yl {\n          cmp = 1\n        } else ()\n      } else ()\n      if cmp < 0 {\n        min_i = b\n      } else ()\n      b = b + 1\n    }\n    if min_i != a {\n      let tmp = Array::get(out, a)\n      Array::set(out, a, Array::get(out, min_i))\n      Array::set(out, min_i, tmp)\n    } else ()\n    a = a + 1\n  }\n  out\n}\n\nexport fn contract_hash(fn_decls: Array[(String, String)], opaque_names: Array[(String, Int)], type_defs: Array[Stmt]) -> String {\n  let canon = String::join(sorted_strings(contract_surface_lines(fn_decls, opaque_names, type_defs)), \"\\n\")\n  \"ct:sha1:\\{sha1(String::concat(\"vibei:v1\\n\", canon))}\"\n}\n\nexport fn package_hash_from_sources(sources: Array[(String, String)]) -> String {\n  let keys = array_empty()\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, _) = Array::get(sources, i)\n    Array::push(keys, path)\n    i = i + 1\n  }\n  let ordered = sorted_strings(keys)\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, \"vibe-pkg:v1\\n\")\n  let mut ki = 0\n  while ki < Array::length(ordered) {\n    let key = Array::get(ordered, ki)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, text) = Array::get(sources, si)\n      if path == key {\n        StringBuilder::push(sb, \"file \\{path} \\{String::length(text)}\\n\")\n        StringBuilder::push(sb, text)\n        StringBuilder::push(sb, \"\\n\")\n        si = Array::length(sources)\n      } else {\n        si = si + 1\n      }\n    }\n    ki = ki + 1\n  }\n  \"pkg:sha1:\\{sha1(StringBuilder::freeze(sb))}\"\n}\n\n// ADR-0063 §6 (#730 D-2): `require` pin lines. A directive, not statement\n// grammar: `require @scope/name 1.2.3 = #pkg:sha1:<40hex>` lines sit at the\n// top of a file (blank lines / line comments may precede). The loader\n// extracts them BEFORE parsing and blanks them to spaces, so byte offsets —\n// and therefore diagnostics — are preserved (same philosophy as #cfg's\n// tail-append). semver is strict: bare x.y.z or ^x.y.z, full triple only.\n// The constraint is edit-time tooling metadata; the build consumes only the\n// hash. The hash is REQUIRED here until fmt pin-insertion lands (D-3).\n\nfn is_digit_run(s: String, from: Int, to: Int) -> Bool {\n  if to <= from {\n    false\n  } else {\n    let mut i = from\n    let mut ok = true\n    while i < to {\n      let c = String::char_code_at(s, i)\n      if c < '0' || c > '9' {\n        ok = false\n        i = to\n      } else {\n        i = i + 1\n      }\n    }\n    ok\n  }\n}\n\nexport fn is_strict_semver(v: String) -> Bool {\n  let start = if String::starts_with(v, \"^\") {\n    1\n  } else 0\n  let body = String::substring(v, start, String::length(v))\n  let parts = String::split(body, \".\")\n  if Array::length(parts) != 3 {\n    false\n  } else {\n    let a = Array::get(parts, 0)\n    let b = Array::get(parts, 1)\n    let c = Array::get(parts, 2)\n    is_digit_run(a, 0, String::length(a)) && is_digit_run(b, 0, String::length(b)) && is_digit_run(c, 0, String::length(c))\n  }\n}\n\nexport fn is_package_pin(h: String) -> Bool {\n  if !String::starts_with(h, \"#pkg:sha1:\") {\n    false\n  } else if String::length(h) != 50 {\n    false\n  } else {\n    let mut i = 10\n    let mut ok = true\n    while i < 50 {\n      let c = String::char_code_at(h, i)\n      let is_hex = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')\n      if is_hex {\n        i = i + 1\n      } else {\n        ok = false\n        i = 50\n      }\n    }\n    ok\n  }\n}\n\nfn split_fields(line: String) -> Array[String] {\n  let raw = String::split(String::trim(line), \" \")\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(raw) {\n    let f = Array::get(raw, i)\n    if String::length(f) > 0 {\n      Array::push(out, f)\n    } else ()\n    i = i + 1\n  }\n  out\n}\n\n// Returns ((name, constraint, pin) triples, source with require lines\n// blanked to spaces). Only the leading directive region is scanned; a\n// `require` line after the first ordinary statement is a parse error\n// downstream (it never parses as a statement), which is intended.\n// #754 (ADR-0065): the leading region may also carry ONE `version x.y.z`\n// directive — the PACKAGE-side version declaration. It is validated and\n// blanked here (so every parse lane tolerates it) and read back with\n// extract_package_version below. The raw line stays in the file text, so it\n// is part of the package hash by construction: a version change is a new\n// artifact, and version->hash immutability is checkable.\nexport fn extract_require_pins(source: String) -> (Array[(String, String, String)], String) with { Error } {\n  let pins = array_empty()\n  let sb = StringBuilder::new()\n  let len = String::length(source)\n  let mut pos = 0\n  let mut scanning = true\n  let mut seen_version = false\n  while pos < len {\n    let mut nl = pos\n    while nl < len && String::char_code_at(source, nl) != 10 {\n      nl = nl + 1\n    }\n    let line = String::substring(source, pos, nl)\n    let trimmed = String::trim(line)\n    let is_require = scanning && String::starts_with(trimmed, \"require \")\n    let is_version = scanning && String::starts_with(trimmed, \"version \")\n    if is_version {\n      let vfields = split_fields(trimmed)\n      if Array::length(vfields) != 2 {\n        throw(\"malformed version directive (expected: version x.y.z): \\{trimmed}\")\n      } else ()\n      let vver = Array::get(vfields, 1)\n      if String::starts_with(vver, \"^\") || !is_strict_semver(vver) {\n        throw(\"version directive must be an exact semver triple (x.y.z): \\{trimmed}\")\n      } else ()\n      if seen_version {\n        throw(\"duplicate version directive: \\{trimmed}\")\n      } else ()\n      seen_version = true\n      let mut vbi = 0\n      while vbi < String::length(line) {\n        StringBuilder::push(sb, \" \")\n        vbi = vbi + 1\n      }\n    } else if is_require {\n      let fields = split_fields(trimmed)\n      let nfields = Array::length(fields)\n      if nfields != 5 && nfields != 3 {\n        throw(\"malformed require line (expected: require @scope/name x.y.z [= #pkg:sha1:<40hex>]): \\{trimmed}\")\n      } else ()\n      let name = Array::get(fields, 1)\n      let ver = Array::get(fields, 2)\n      if !String::starts_with(name, \"@\") {\n        throw(\"require package name must start with '@': \\{name}\")\n      } else ()\n      if !is_strict_semver(ver) {\n        throw(\"require version must be a strict semver triple (x.y.z or ^x.y.z): \\{ver}\")\n      } else ()\n      // Unpinned (3-field) form: accepted at parse so `vibe fmt` can fill\n      // the pin offline from the store (D-3); the BUILD still refuses to\n      // resolve an unpinned package (hash-only, resolver-free).\n      let pin_hash = if nfields == 5 {\n        let eq = Array::get(fields, 3)\n        let pin = Array::get(fields, 4)\n        if eq == \"=\" {\n          ()\n        } else {\n          throw(\"malformed require line (missing '='): \\{trimmed}\")\n        }\n        if !is_package_pin(pin) {\n          throw(\"require pin must be #pkg:sha1:<40hex> (compute with `vibe hash`): \\{pin}\")\n        } else ()\n        String::substring(pin, 1, String::length(pin))\n      } else {\n        \"\"\n      }\n      Array::push(pins, (name, ver, pin_hash))\n      // blank the line, preserving its byte length\n      let mut bi = 0\n      while bi < String::length(line) {\n        StringBuilder::push(sb, \" \")\n        bi = bi + 1\n      }\n    } else {\n      if String::length(trimmed) == 0 || String::starts_with(trimmed, \"//\") {\n        ()\n      } else {\n        scanning = false\n      }\n      StringBuilder::push(sb, line)\n    }\n    if nl < len {\n      StringBuilder::push(sb, \"\\n\")\n    } else ()\n    pos = nl + 1\n  }\n  (pins, StringBuilder::freeze(sb))\n}\n\n// #754: read the `version x.y.z` directive from a contract's leading\n// directive region (\"\" when absent). Same scanning rules as\n// extract_require_pins — only the region before the first ordinary\n// statement counts.\nexport fn extract_package_version(source: String) -> String with { Error } {\n  let len = String::length(source)\n  let mut pos = 0\n  let mut found = \"\"\n  let mut scanning = true\n  while pos < len && scanning {\n    let mut nl = pos\n    while nl < len && String::char_code_at(source, nl) != 10 {\n      nl = nl + 1\n    }\n    let trimmed = String::trim(String::substring(source, pos, nl))\n    if String::starts_with(trimmed, \"version \") {\n      let vfields = split_fields(trimmed)\n      if Array::length(vfields) == 2 {\n        found = Array::get(vfields, 1)\n        scanning = false\n      } else {\n        throw(\"malformed version directive (expected: version x.y.z): \\{trimmed}\")\n      }\n    } else if String::length(trimmed) == 0 || String::starts_with(trimmed, \"//\") || String::starts_with(trimmed, \"require \") {\n      ()\n    } else {\n      scanning = false\n    }\n    pos = nl + 1\n  }\n  found\n}\n\n// ADR-0063 §8 (#732 Phase F): Elm-style machine-verified semver. The\n// version bump a release CLAIMS must match what its contract diff REQUIRES:\n//   patch — the API surface is unchanged (same fn decls, opaques, types)\n//   minor — additions only (every old declaration survives verbatim)\n//   major — anything else\n// \"semver is trusted\" becomes a checkable property instead of a hope.\n\nfn str_in(arr: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) && !found {\n    if Array::get(arr, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// Canonical per-declaration lines for a contract surface (shared by\n// contract_hash and the change classifier, so they can never disagree).\nexport fn contract_surface_lines(fn_decls: Array[(String, String)], opaque_names: Array[(String, Int)], type_defs: Array[Stmt]) -> Array[String] {\n  let lines = array_empty()\n  let mut i = 0\n  while i < Array::length(fn_decls) {\n    let (dname, dsig) = Array::get(fn_decls, i)\n    Array::push(lines, \"fn \\{dname} \\{dsig}\")\n    i = i + 1\n  }\n  let mut oi = 0\n  while oi < Array::length(opaque_names) {\n    let (oname, oarity) = Array::get(opaque_names, oi)\n    // #739: arity is part of the surface — `Box` -> `Box[T]` must classify\n    // as a MAJOR change. Zero-arity keeps the historical `opaque X` line so\n    // existing contract hashes only move for parameterized types.\n    let oline = if oarity == 0 {\n      \"opaque \\{oname}\"\n    } else {\n      \"opaque \\{oname}[\\{oarity}]\"\n    }\n    Array::push(lines, oline)\n    oi = oi + 1\n  }\n  let mut ti = 0\n  while ti < Array::length(type_defs) {\n    Array::push(lines, \"type \\{print_stmt(Array::get(type_defs, ti))}\")\n    ti = ti + 1\n  }\n  lines\n}\n\n// \"patch\" | \"minor\" | \"major\" for old -> new surface lines.\nexport fn classify_contract_change(old_lines: Array[String], new_lines: Array[String]) -> String {\n  let mut all_old_kept = true\n  let mut i = 0\n  while i < Array::length(old_lines) {\n    if str_in(new_lines, Array::get(old_lines, i)) {\n      ()\n    } else {\n      all_old_kept = false\n    }\n    i = i + 1\n  }\n  if !all_old_kept {\n    \"major\"\n  } else {\n    let mut any_new = false\n    let mut j = 0\n    while j < Array::length(new_lines) {\n      if str_in(old_lines, Array::get(new_lines, j)) {\n        ()\n      } else {\n        any_new = true\n      }\n      j = j + 1\n    }\n    if any_new {\n      \"minor\"\n    } else {\n      \"patch\"\n    }\n  }\n}\n\nfn digits_to_int(raw: String) -> Int {\n  let len = String::length(raw)\n  let mut result = 0\n  let mut i = 0\n  while i < len {\n    result = result * 10 + (String::char_code_at(raw, i) - 48)\n    i = i + 1\n  }\n  result\n}\n\nfn semver_parts(v: String) -> Option[(Int, Int, Int)] {\n  if is_strict_semver(v) && !String::starts_with(v, \"^\") {\n    let parts = String::split(v, \".\")\n    Some((digits_to_int(Array::get(parts, 0)), digits_to_int(Array::get(parts, 1)), digits_to_int(Array::get(parts, 2))))\n  } else {\n    None\n  }\n}\n\n// The bump kind a version transition claims: Some(\"patch\"/\"minor\"/\"major\"),\n// None when the transition is not a single well-formed forward bump.\nexport fn semver_bump_kind(prev: String, next: String) -> Option[String] {\n  match semver_parts(prev) {\n    None => None,\n    Some(pp) => match semver_parts(next) {\n      None => None,\n      Some(np) => {\n        let (pa, pb, pc) = pp\n        let (na, nb, nc) = np\n        if na == pa + 1 && nb == 0 && nc == 0 {\n          Some(\"major\")\n        } else if na == pa && nb == pb + 1 && nc == 0 {\n          Some(\"minor\")\n        } else if na == pa && nb == pb && nc == pc + 1 {\n          Some(\"patch\")\n        } else {\n          None\n        }\n      }\n    }\n  }\n}\n\n// The publish gate: claimed bump must be exactly what the diff requires.\nexport fn verify_publish_bump(prev_version: String, next_version: String, old_lines: Array[String], new_lines: Array[String]) -> Array[String] {\n  let errors = array_empty()\n  let required = classify_contract_change(old_lines, new_lines)\n  match semver_bump_kind(prev_version, next_version) {\n    None => Array::push(errors, \"\\{prev_version} -> \\{next_version} is not a single forward semver bump\"),\n    Some(claimed) => if claimed == required {\n      ()\n    } else {\n      Array::push(errors, \"version \\{prev_version} -> \\{next_version} claims a \\{claimed} bump but the contract change requires \\{required}\")\n    }\n  }\n  errors\n}\n\nexport {\n  parse_contract_program, collect_impl_fn_defs, check_contract\n}\n")
}

let cli_adapter_source_206 = () -> (String, String) {
  ("lib/@vibe/compiler/loader/index.vpkg",
"version 0.0.1\n\n// @vibe/compiler/loader — ADR-0070 / #897 compiler-internal contract,\n// compiler-internal batch 7. Module-graph loading: source collection off\n// disk (collect_all_sources_fs / collect_source_groups_fs /\n// collect_sources_rec), persistent list/group/manifest-header caching (the\n// resolution_context_*, load_persistent_*, store_persistent_* families),\n// contract/publish-bump plumbing (contract_package_hashes_fs,\n// fill_require_pins_fs*, publish_check_fs), package-boundary enforcement\n// (enforce_incoming_boundary_fs, validate_index_layout_fs, vpkg directory\n// scanning), plus the tab-separated build manifest reader\n// (manifest_sources.vibe) and its persistent header-scan cache\n// (header_cache.vibe). Three files, no naming collision on the established\n// `git mv index.vibe <dirname>.vibe` rename convention (unlike checker/'s\n// and codegen/'s batches), so the old index.vibe moved verbatim to\n// loader.vibe.\n//\n// loader.vibe is NOT a pure facade — like codegen/common_base's batch, it\n// carries substantial real implementation of its own (source collection,\n// caching, contract/publish helpers) in addition to importing and\n// re-exporting a chosen subset of manifest_sources.vibe's surface. Its\n// existing `export ./manifest_sources.vibe { .. }` SReExport block (added\n// under #847, see its own comment in loader.vibe) stays untouched: this\n// contract is now the actual source of truth for the package's full export\n// surface (all 34 names below, across all 3 files), so the facade's\n// partial, hand-picked re-export list is no longer load-bearing for\n// outside callers — they reach every name here through this contract\n// regardless of what loader.vibe itself re-exports, exactly like\n// checker_facade.vibe's partial list after checker/'s batch.\n//\n// join_path naming wrinkle (the specific case #847 flagged this directory\n// as a \"facade-design blocker\" over): loader.vibe defines its own PRIVATE,\n// same-named `join_path` helper (a deliberate duplicate, see its own #740\n// comment) — so loader.vibe can never itself\n// `export ./manifest_sources.vibe { join_path }` without colliding with\n// its own local binding, and manifest_sources.vibe's `join_path` was\n// therefore unreachable through the old plain-index.vibe facade.\n// loader_hotspot_probe.vibe worked around this with a documented direct\n// leaf import straight from `loader/manifest_sources.vibe`. A .vpkg\n// contract has no such collision: it declares bodyless signatures, not\n// executable bindings, so `join_path` below (grouped under\n// manifest_sources.vibe) declares the export cleanly. The workaround leaf\n// import is retracted by this migration — loader_hotspot_probe.vibe now\n// gets `join_path` the same way as every other manifest_sources.vibe\n// export, through this contract's `import ../loader { .. }` package form.\n//\n// No exported types: TypeEnv/Stmt/Subst/Type (../core) and Map (builtin)\n// are plain structural signature text here, not declared at all\n// (normalize/perceus/contract precedent) — ../core itself was not yet\n// migrated to vpkg at the time of this batch (out of scope then), so\n// loader.vibe / header_cache.vibe kept their existing bare `import\n// ../core/index.vibe { .. }` style references unchanged. #897 batch 9\n// migrated core/ to its own index.vpkg and, per that contract's own\n// boundary-enforcement note, converted these two literal leaf-path\n// references to the bare `import ../core { .. }` package form (manifest_sources.vibe\n// never imported this compiler-internal ../core — its `@vibe/core` import\n// is the unrelated external stdlib package).\n//\n// External-caller fixes (literal `loader/index.vibe` /\n// `loader/manifest_sources.vibe` / `loader/header_cache.vibe` paths → bare\n// `../loader` / `./loader` package form, now that leaf-file imports from\n// outside the package are rejected by enforce_incoming_boundary_fs):\n// cli_adapter.vibe, loader_hotspot_probe.vibe (also folds its join_path\n// workaround import into the package form), loader_list_materialize_bench.vibe,\n// loader_materialize_bench.vibe, tests/contract_vpkg_test.vibe,\n// tests/loader_manifest_sources_test.vibe,\n// entry/source_compile/wasi_only/merge_sources.vibe,\n// entry/compiler/file_compile/file_compile.vibe,\n// entry/compiler/fs_compile/index.vibe. No import cycle found: none of\n// loader/'s own dependencies (checker/, runtime/eval_loader/, contract/,\n// syntax/ — all already vpkg) import back into loader/.\n//\n// Compiled into the compiler itself via compiler_sources_manifest.tsv\n// (group `loader`): the old single `loader/index.vibe` row becomes a dual\n// row (this contract + loader.vibe); header_cache.vibe and\n// manifest_sources.vibe already had their own rows and are unchanged.\n\n// --- loader.vibe\nfn resolution_context_fingerprint_fs() -> String with { Error, Fs }\nfn ingest_source_text_fs(path: String, raw: String) -> String with { Error, Fs }\nfn load_persistent_source_group_fingerprint_if_valid(entry_path: String) -> Option[String] with { Error, Fs }\nfn load_or_parse_module_header_fs(path: String, source: String, parse_count: Int) -> (Array[String], Array[String], Int) with { Error, Fs }\nfn check_module(source: String, path: String, sources: Array[(String, String)], loading: Array[String], checked_cache: Array[(String, TypeEnv)]) -> TypeEnv with { Error }\nfn contract_package_hashes_fs(path: String) -> (String, String) with { Error, Fs }\nfn fill_require_pins_fs(source: String) -> String with { Error, Fs }\nfn fill_require_pins_fs_mode(source: String, repin: Bool) -> String with { Error, Fs }\nfn publish_check_fs(prev_contract_path: String, next_contract_path: String, prev_version: String, next_version: String) -> Array[String] with { Error, Fs }\nfn collect_all_sources_fs(entry_path: String) -> Array[(String, String)] with { Error, Fs }\nfn collect_source_groups_fs(entry_path: String) -> Array[(String, Array[(String, String)])] with { Error, Fs }\nfn collect_merged_stmts(sources: Array[(String, String)]) -> Array[Stmt] with { Error }\nfn find_missing_vpkg_dirs(root: String) -> Array[String] with { Error, Fs }\nfn check_missing_vpkg_dirs(root: String) -> Int with { Error, Fs }\n\n// --- header_cache.vibe\nfn contract_sibling_impl_raws(dir: String) -> Array[String] with { Error, Fs }\nfn merge_impl_raws_dedupe(explicit: Array[String], discovered: Array[String]) -> Array[String]\nfn load_or_parse_module_header_fs_impl(path: String, source: String, parse_count: Int) -> (Array[String], Array[String], Int) with { Error, Fs }\n\n// --- manifest_sources.vibe\nfn join_path(base_dir: String, rel_path: String) -> String\nfn build_manifest_source_index(sources: Array[(String, String)]) -> Map[String, String]\nfn build_manifest_path_index(paths: Array[String]) -> Map[String, Bool]\nfn try_load_manifest_rows(entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs }\nfn load_manifest_full_sources(base_dir: String, rows: Array[(String, String)]) -> Array[(String, String)] with { Error, Fs }\nfn build_grouped_sources_from_manifest_row_source_index(base_dir: String, rows: Array[(String, String)], source_index: Map[String, String]) -> Array[(String, Array[(String, String)])]\nfn build_grouped_sources_from_manifest_rows(base_dir: String, rows: Array[(String, String)], sources: Array[(String, String)]) -> Array[(String, Array[(String, String)])]\nfn filter_manifest_sources_by_path_index(preloaded_sources: Array[(String, String)], needed_path_index: Map[String, Bool]) -> Array[(String, String)]\nfn filter_manifest_sources_by_paths(preloaded_sources: Array[(String, String)], needed_paths: Array[String]) -> Array[(String, String)]\nfn filter_manifest_sources_by_paths_linear(preloaded_sources: Array[(String, String)], needed_paths: Array[String]) -> Array[(String, String)]\nfn filter_manifest_sources_by_source_index(needed_paths: Array[String], preloaded_source_index: Map[String, String]) -> Array[(String, String)]\nfn probe_manifest_header_rows_count(entry_path: String) -> Int with { Error, Fs }\nfn probe_manifest_header_rows_uncached_count(entry_path: String) -> Int with { Error, Fs }\nfn probe_manifest_needed_paths_count(entry_path: String) -> Int with { Error, Fs }\nfn probe_manifest_scan_paths_count(entry_path: String) -> Int with { Error, Fs }\nfn try_collect_manifest_sources_fs(entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs }\nfn try_collect_manifest_source_groups_fs(entry_path: String) -> Option[(String, Array[(String, Array[(String, String)])])] with { Error, Fs }\n")
}

let cli_adapter_source_207 = () -> (String, String) {
  ("lib/@vibe/compiler/loader/loader.vibe",
"//# Imports\n\nimport @vibe/compiler/syntax {\n  lex, parse_program, parse_program_preserving\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  Expr,\n  Stmt,\n  Subst,\n  Type,\n  TypeExpr,\n  TypeDef,\n  TypeEnv,\n  env_bind,\n  env_lookup,\n  dir_of_path,\n  ensure_regular_source_fs,\n  external_lib_roots,\n  is_contract_ext,\n  nearest_vpkg_path_fs,\n  normalize_path,\n  path_in_dir,\n  resolve_import_path,\n  resolve_import_path_candidates,\n  vibe_env_flag,\n  vpkg_path_in_dir,\n  contains_path,\n  path_set_add,\n  path_set_contains,\n  path_set_new\n}\n\nimport @vibe/compiler/checker {\n  check_stmts\n}\n\nimport @vibe/compiler/runtime/eval_loader {\n  collect_exports, load_and_parse\n}\n\nimport ./header_cache.vibe {\n  contract_sibling_impl_raws, load_or_parse_module_header_fs_impl, merge_impl_raws_dedupe\n}\n\nimport @vibe/compiler/contract {\n  check_contract, classify_contract_stmts, contract_directory_shared_import_prefix_text, contract_facade_marker, contract_facade_source, contract_hash, contract_surface_lines, extract_package_version, extract_require_pins, package_hash_from_sources, parse_contract_program, verify_publish_bump, vpkg_shared_import_marker\n}\n\nimport ./manifest_sources.vibe {\n  build_grouped_sources_from_manifest_rows,\n  load_manifest_full_sources,\n  try_collect_manifest_source_groups_fs,\n  try_collect_manifest_sources_fs,\n  try_load_manifest_rows\n}\n\n// #847: `loader/` has no index.vibei boundary of its own, so outside callers\n// have historically reached straight into `loader/manifest_sources.vibe`\n// (bench scripts, tests) instead of going through `loader/index.vibe`. Since\n// this module already imports several of manifest_sources' functions for its\n// own use above, re-export the full set those outside callers need so they\n// can route through the index instead (ADR-0063's \"index is the only entry\n// point\" rule, generalized to plain-index.vibe directories per #847).\nexport ./manifest_sources.vibe {\n  build_grouped_sources_from_manifest_row_source_index,\n  build_grouped_sources_from_manifest_rows,\n  build_manifest_path_index,\n  build_manifest_source_index,\n  filter_manifest_sources_by_path_index,\n  filter_manifest_sources_by_paths,\n  filter_manifest_sources_by_paths_linear,\n  filter_manifest_sources_by_source_index,\n  load_manifest_full_sources,\n  try_collect_manifest_source_groups_fs,\n  try_collect_manifest_sources_fs,\n  try_load_manifest_rows\n}\n\nimport @vibe/compiler/cache {\n  build_source_groups_fingerprint_from_compact_fingerprints,\n  compact_string_fingerprint,\n  normalize_persistent_cache_text,\n  persistent_module_header_cache_path,\n  persistent_source_group_cache_path,\n  persistent_source_list_cache_path\n}\n\n// ADR-0075 Phase 1: `.vibex` is a language-level executable root, not a\n// launcher convention. Validate the preserving AST before fn declarations\n// are lowered to SLet so a value-bound main cannot masquerade as canonical\n// `fn main`. Exact operation-row equality is wired in a later phase; this\n// slice fixes the file/entry shape and requires an explicit row.\nfn validate_vibex_entry_source(path: String, source: String) -> Unit with { Error } {\n  if !String::ends_with(path, \".vibex\") {\n    ()\n  } else {\n    let stmts = parse_program_preserving(lex(source))\n    let mut main_count = 0\n    let mut saw_value_main = false\n    let mut invalid_shape = false\n    let mut missing_effect_row = false\n    let mut exported_main = false\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SFnDecl(exported, name, value, _, _) => if name == \"main\" {\n          main_count = main_count + 1\n          if exported {\n            exported_main = true\n          } else {\n            ()\n          }\n          match value {\n            EFn(type_params, _, params, ret, effects, _) => {\n              let returns_unit = match ret {\n                Some(TyName(name)) => name == \"Unit\",\n                _ => false\n              }\n              if Array::length(type_params) != 0 || Array::length(params) != 0 || !returns_unit {\n                invalid_shape = true\n              } else {\n                ()\n              }\n              match effects {\n                Some(_) => (),\n                None => {\n                  missing_effect_row = true\n                }\n              }\n            },\n            _ => {\n              invalid_shape = true\n            }\n          }\n        } else {\n          ()\n        },\n        SLet(_, _, name, _, _) => if name == \"main\" {\n          saw_value_main = true\n        } else {\n          ()\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n    if saw_value_main {\n      throw(\"\\{path}: value-bound main is not allowed in .vibex; use 'fn main with { ... } { ... }'\")\n    } else if main_count != 1 {\n      throw(\"\\{path}: .vibex executable requires exactly one fn main\")\n    } else if exported_main {\n      throw(\"\\{path}: .vibex fn main is an entry declaration and cannot be exported\")\n    } else if invalid_shape {\n      throw(\"\\{path}: .vibex fn main must have type () -> Unit\")\n    } else if missing_effect_row {\n      throw(\"\\{path}: .vibex fn main requires an explicit effect row; write 'with { }' for a pure entry\")\n    } else {\n      ()\n    }\n  }\n}\n\n//# Path helpers\n\nfn source_lookup(sources: Array[(String, String)], path_key: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    match found {\n      Some(_) => (),\n      None => {\n        let (p, src) = Array::get(sources, i)\n        if p == path_key {\n          found = Some(src)\n        }\n      }\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn resolve_path_in_sources(base_dir: String, raw_path: String, sources: Array[(String, String)]) -> Option[(String, String)] {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(candidates) {\n    match found {\n      Some(_) => (),\n      None => {\n        let candidate = Array::get(candidates, i)\n        match source_lookup(sources, candidate) {\n          Some(source) => {\n            found = Some((candidate, source))\n          }\n          None => ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn resolve_path_fs(base_dir: String, raw_path: String) -> String with { Fs } {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = \"\"\n  while i < Array::length(candidates) {\n    if found == \"\" {\n      let candidate = Array::get(candidates, i)\n      // #768/#778: direct-call form, not `perform Fs::Exists` -- matches\n      // loader/header_cache.vibe's sibling resolve_path_fs (already\n      // direct-call) and avoids the perform/effect-op crash risk in a\n      // narrow-effect-surface compiled unit.\n      let candidate_exists = Fs::exists(candidate)\n      if candidate_exists {\n        found = candidate\n      }\n    }\n    i = i + 1\n  }\n  if found == \"\" {\n    Array::get(candidates, 0)\n  } else {\n    found\n  }\n}\n\n// #740: normalized for the same reason as manifest_sources' join_path —\n// manifest rows outside the compiler dir must key under the import-resolved\n// spelling.\nfn join_path(base_dir: String, rel_path: String) -> String {\n  if base_dir == \"\" {\n    normalize_path(rel_path)\n  } else {\n    normalize_path(String::concat(base_dir, String::concat(\"/\", rel_path)))\n  }\n}\n\nfn strip_trailing_cr(line: String) -> String {\n  let len = String::length(line)\n  if len > 0 {\n    if String::char_code_at(line, len - 1) == 13 {\n      line[0:len - 1]\n    } else {\n      line\n    }\n  } else {\n    line\n  }\n}\n\n\nfn string_to_bytes(s: String) -> Bytes {\n  let out = Bytes::new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Bytes::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  out\n}\n\nfn special_bundle_header(path: String) -> Option[(Array[String], Array[String])] {\n  if String::ends_with(path, \"compiler_sources_bundle.vibe\") {\n    Some((\n      array_empty(),\n      [\"compiler_sources\", \"compiler_source_groups\"]\n    ))\n  } else {\n    None\n  }\n}\n\nfn split_tsv_fields(line: String) -> Array[String] {\n  let fields = array_empty()\n  let len = String::length(line)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_field_end = if i == len {\n      true\n    } else {\n      String::char_code_at(line, i) == 9\n    }\n    if at_field_end {\n      Array::push(fields, line[start:i])\n      start = i + 1\n    }\n    i = i + 1\n  }\n  fields\n}\n\nlet header_value_separator = String::from_char_code(31)\n\nfn join_header_values(values: Array[String]) -> String {\n  // O(N) via StringBuilder (previous accumulator was O(N^2)).\n  let sb = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(values) {\n    if i > 0 {\n      StringBuilder::push(sb, header_value_separator)\n    }\n    StringBuilder::push(sb, Array::get(values, i))\n    i = i + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\nfn split_header_values(text: String) -> Array[String] {\n  let values = array_empty()\n  if String::length(text) == 0 {\n    values\n  } else {\n    let sep = String::char_code_at(header_value_separator, 0)\n    let len = String::length(text)\n    let mut start = 0\n    let mut i = 0\n    while i <= len {\n      let at_value_end = if i == len {\n        true\n      } else {\n        String::char_code_at(text, i) == sep\n      }\n      if at_value_end {\n        Array::push(values, text[start:i])\n        start = i + 1\n      }\n      i = i + 1\n    }\n    values\n  }\n}\n\nfn empty_source_specs() -> Array[(String, String)] {\n  array_empty()\n}\n\nfn copy_source_specs(sources: Array[(String, String)]) -> Array[(String, String)] {\n  let out = empty_source_specs()\n  let mut i = 0\n  while i < Array::length(sources) {\n    Array::push(out, Array::get(sources, i))\n    i = i + 1\n  }\n  out\n}\n\nfn empty_group_specs() -> Array[(String, String, String)] {\n  array_empty()\n}\n\nfn empty_source_cache_specs() -> Array[(String, String, String)] {\n  array_empty()\n}\n\nfn empty_group_cache_specs() -> Array[(String, String, String, String)] {\n  array_empty()\n}\n\nfn empty_grouped_sources() -> Array[(String, Array[(String, String)])] {\n  array_empty()\n}\n\nfn source_paths(sources: Array[(String, String)]) -> Array[String] {\n  let paths = array_empty()\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, _) = Array::get(sources, i)\n    if path != \"\" {\n      Array::push(paths, path)\n    } else ()\n    i = i + 1\n  }\n  paths\n}\n\nfn source_cache_spec_paths(specs: Array[(String, String, String)]) -> Array[String] {\n  let paths = array_empty()\n  let mut i = 0\n  while i < Array::length(specs) {\n    let (path, _, _) = Array::get(specs, i)\n    if path != \"\" {\n      Array::push(paths, path)\n    } else ()\n    i = i + 1\n  }\n  paths\n}\n\nfn grouped_source_paths(groups: Array[(String, Array[(String, String)])]) -> Array[String] {\n  let paths = array_empty()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (_, sources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, _) = Array::get(sources, si)\n      if path != \"\" {\n        Array::push(paths, path)\n      } else ()\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  paths\n}\n\nfn group_cache_row_paths(rows: Array[(String, String, String, String)]) -> Array[String] {\n  let paths = array_empty()\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, path, _, _) = Array::get(rows, i)\n    if path != \"\" {\n      Array::push(paths, path)\n    } else ()\n    i = i + 1\n  }\n  paths\n}\n\nfn push_grouped_source(groups: Array[(String, Array[(String, String)])], group_name: String, path: String, source: String) -> Unit {\n  let group_count = Array::length(groups)\n  let handled_by_tail = if group_count > 0 {\n    let (last_name, last_sources) = Array::get(groups, group_count - 1)\n    if last_name == group_name {\n      Array::push(last_sources, (path, source))\n      true\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n  if !handled_by_tail {\n    let mut i = 0\n    let mut found_index = -1\n    while i < group_count {\n      if found_index == -1 {\n        let (name, sources) = Array::get(groups, i)\n        if name == group_name {\n          Array::push(sources, (path, source))\n          found_index = i\n        }\n      }\n      i = i + 1\n    }\n    if found_index == -1 {\n      let sources = array_empty()\n      Array::push(sources, (path, source))\n      Array::push(groups, (group_name, sources))\n    }\n  }\n}\n\nfn push_grouped_source_fingerprint(groups: Array[(String, Array[(String, String)])], group_name: String, path: String, source_fingerprint: String) -> Unit {\n  let group_count = Array::length(groups)\n  let handled_by_tail = if group_count > 0 {\n    let (last_name, last_specs) = Array::get(groups, group_count - 1)\n    if last_name == group_name {\n      Array::push(last_specs, (path, source_fingerprint))\n      true\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n  if !handled_by_tail {\n    let mut i = 0\n    let mut found_index = -1\n    while i < group_count {\n      if found_index == -1 {\n        let (name, specs) = Array::get(groups, i)\n        if name == group_name {\n          Array::push(specs, (path, source_fingerprint))\n          found_index = i\n        }\n      }\n      i = i + 1\n    }\n    if found_index == -1 {\n      let specs = array_empty()\n      Array::push(specs, (path, source_fingerprint))\n      Array::push(groups, (group_name, specs))\n    }\n  }\n}\n\nfn empty_manifest_header_cache_rows() -> Array[(String, String, String, String)] {\n  array_empty()\n}\n\n// #801: the source list/group caches store a RESOLVED graph, and `@scope/name`\n// resolution depends on which packages EXIST under `.vibe/store`, `lib/`, and\n// the external roots at resolve time — not just on the root list (#758's env\n// seed covers the latter only). A graph collected while `.vibe/store/@vibe/core`\n// existed (store install gates/tests create and delete it) can lack the\n// lib/-resolved vibe_core group entirely; every row such a cache DOES list\n// still validates, so row-level checks can never notice the missing package.\n// The visible package set itself must therefore be part of the validity check:\n// writers record its fingerprint (`resctx` row) and validators refuse the\n// cache when the current set differs.\n// NOTE: no Fs::is_dir guards here — the fixed seed compiler predates that\n// builtin (bootstrap bump required first). Scope/package levels are\n// directories by layout convention (resolver assumes the same).\nfn push_context_packages_under(sb: StringBuilder, root: String) -> Unit with { Error, Fs } {\n  if Fs::exists(root) {\n    let scopes = Fs::readdir(root)\n    let mut i = 0\n    while i < Array::length(scopes) {\n      let scope = Array::get(scopes, i)\n      if String::starts_with(scope, \"@\") {\n        let scope_dir = String::concat(root, String::concat(\"/\", scope))\n        let names = Fs::readdir(scope_dir)\n        let mut j = 0\n        while j < Array::length(names) {\n          let name = Array::get(names, j)\n          let pkg_dir = String::concat(scope_dir, String::concat(\"/\", name))\n          if Fs::exists(String::concat(pkg_dir, \"/index.vpkg\")) || Fs::exists(String::concat(pkg_dir, \"/index.vibei\")) {\n            StringBuilder::push(sb, root)\n            StringBuilder::push(sb, \"|\")\n            StringBuilder::push(sb, scope)\n            StringBuilder::push(sb, \"/\")\n            StringBuilder::push(sb, name)\n            StringBuilder::push(sb, \"\\n\")\n          } else {\n            ()\n          }\n          j = j + 1\n        }\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n  } else {\n    ()\n  }\n}\n\nexport fn resolution_context_fingerprint_fs() -> String with { Error, Fs } {\n  let sb = StringBuilder::new()\n  push_context_packages_under(sb, \".vibe/store\")\n  push_context_packages_under(sb, \"lib\")\n  let roots = external_lib_roots()\n  let mut i = 0\n  while i < Array::length(roots) {\n    push_context_packages_under(sb, Array::get(roots, i))\n    i = i + 1\n  }\n  compact_string_fingerprint(StringBuilder::freeze(sb))\n}\n\n// Persistent source caches contain a resolved graph, so local package policy is\n// also part of their context. Per-source owner state detects a newly inserted\n// nested boundary; owner contract content detects changed shared imports; and\n// the direct-root listing detects production siblings added after a cache was\n// written. This keeps cache hits observationally equivalent to a cold walk.\nfn module_policy_context_fingerprint_fs(entry_path: String, paths: Array[String]) -> String with { Error, Fs } {\n  let sb = StringBuilder::new()\n  let owners = array_empty()\n  let all_paths = array_empty()\n  if entry_path != \"\" {\n    Array::push(all_paths, entry_path)\n  } else ()\n  let mut pi = 0\n  while pi < Array::length(paths) {\n    let path = Array::get(paths, pi)\n    if path != \"\" && !contains_path(all_paths, path) {\n      Array::push(all_paths, path)\n    } else ()\n    pi = pi + 1\n  }\n  let mut i = 0\n  while i < Array::length(all_paths) {\n    let path = Array::get(all_paths, i)\n    StringBuilder::push(sb, \"source|\")\n    StringBuilder::push(sb, path)\n    if Fs::exists(path) {\n      validate_index_layout_fs(path)\n      let owner = nearest_vpkg_path_fs(path)\n      StringBuilder::push(sb, \"|owner|\")\n      StringBuilder::push(sb, owner)\n      if owner != \"\" && !contains_path(owners, owner) {\n        Array::push(owners, owner)\n      } else ()\n    } else {\n      StringBuilder::push(sb, \"|missing\")\n    }\n    StringBuilder::push(sb, \"\\n\")\n    i = i + 1\n  }\n  let mut oi = 0\n  while oi < Array::length(owners) {\n    let owner = Array::get(owners, oi)\n    validate_index_layout_fs(owner)\n    StringBuilder::push(sb, \"contract|\")\n    StringBuilder::push(sb, owner)\n    StringBuilder::push(sb, \"|\")\n    StringBuilder::push(sb, compact_string_fingerprint(Fs::read_file(owner)))\n    StringBuilder::push(sb, \"\\n\")\n    let roots = contract_sibling_impl_raws(dir_of_path(owner))\n    let mut ri = 0\n    while ri < Array::length(roots) {\n      StringBuilder::push(sb, \"root|\")\n      StringBuilder::push(sb, owner)\n      StringBuilder::push(sb, \"|\")\n      StringBuilder::push(sb, Array::get(roots, ri))\n      StringBuilder::push(sb, \"\\n\")\n      ri = ri + 1\n    }\n    oi = oi + 1\n  }\n  compact_string_fingerprint(StringBuilder::freeze(sb))\n}\n\nfn persistent_resolution_context_fingerprint_fs(entry_path: String, paths: Array[String]) -> String with { Error, Fs } {\n  String::concat(\n    resolution_context_fingerprint_fs(),\n    String::concat(\":\", module_policy_context_fingerprint_fs(entry_path, paths))\n  )\n}\n\nfn resolution_context_is_valid(resctx: Option[String], entry_path: String, paths: Array[String]) -> Bool with { Error, Fs } {\n  match resctx {\n    Some(fp) => fp == persistent_resolution_context_fingerprint_fs(entry_path, paths),\n    // No resctx row = written before #801 (or by a foreign writer): the\n    // context it resolved under is unknown, so it cannot be trusted.\n    None => false\n  }\n}\n\nfn parse_persistent_source_list_cache(raw: String) -> (Int, Option[(String, String, String)], Array[(String, String, String)], Option[String]) with { Error } {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let mut resctx = None\n  let sources = empty_source_cache_specs()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source list cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else if version_text == \"3\" {\n            version = 3\n          } else {\n            throw(\"invalid persistent source list cache version\")\n          }\n        } else if tag == \"resctx\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source list cache resctx row\")\n          }\n          resctx = Some(Array::get(fields, 1))\n        } else if tag == \"manifest\" {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source list cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source list cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else if tag == \"source\" {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source list cache source row\")\n            }\n            Array::push(sources, (Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source list cache source row\")\n            }\n            Array::push(sources, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else {\n          throw(String::concat(\"invalid persistent source list cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, sources, resctx)\n}\n\nfn parse_persistent_source_group_cache(raw: String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)], Option[String]) with { Error } {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let mut resctx = None\n  let rows = empty_group_cache_specs()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source group cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else if version_text == \"3\" {\n            version = 3\n          } else {\n            throw(\"invalid persistent source group cache version\")\n          }\n        } else if tag == \"resctx\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source group cache resctx row\")\n          }\n          resctx = Some(Array::get(fields, 1))\n        } else if tag == \"manifest\" {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source group cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source group cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else if tag == \"group\" {\n          if version == 1 {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source group cache group row\")\n            }\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), \"\", Array::get(fields, 3)))\n          } else {\n            if Array::length(fields) != 5 {\n              throw(\"invalid persistent source group cache group row\")\n            }\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3), Array::get(fields, 4)))\n          }\n        } else {\n          throw(String::concat(\"invalid persistent source group cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, rows, resctx)\n}\n\nfn matches_cached_file_spec(path: String, stat_token_text: String, source_fingerprint: String) -> Bool with { Error, Fs } {\n  if !(Fs::exists(path)) {\n    false\n  } else {\n    let has_stat_token = String::length(stat_token_text) > 0\n    if has_stat_token {\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\n        true\n      } else if String::length(source_fingerprint) > 0 {\n        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n      } else {\n        false\n      }\n    } else if String::length(source_fingerprint) > 0 {\n      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n    } else {\n      false\n    }\n  }\n}\n\nfn load_source_if_cached_file_spec_matches(path: String, stat_token_text: String, source_fingerprint: String) -> Option[String] with { Error, Fs } {\n  if !(Fs::exists(path)) {\n    None\n  } else {\n    let has_stat_token = String::length(stat_token_text) > 0\n    if has_stat_token {\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\n        Some(Fs::read_file(path))\n      } else if String::length(source_fingerprint) > 0 {\n        let source = Fs::read_file(path)\n        if compact_string_fingerprint(source) == source_fingerprint {\n          Some(source)\n        } else {\n          None\n        }\n      } else {\n        None\n      }\n    } else if String::length(source_fingerprint) > 0 {\n      let source = Fs::read_file(path)\n      if compact_string_fingerprint(source) == source_fingerprint {\n        Some(source)\n      } else {\n        None\n      }\n    } else {\n      None\n    }\n  }\n}\n\n// #729/#730: EVERY path that turns an on-disk file into an in-memory source\n// must apply the same ingestion transform — require-pin blanking, and for\n// index.vibei contracts the conformance-checked facade desugar. The cold\n// walk (collect_sources_rec) did; the persistent-cache reconstruction lanes\n// below re-read RAW disk bytes, so a warm cache leaked undesugared contracts\n// into the merge (masked until now because every compiler-bundle change\n// invalidated the caches). Cache validity stays keyed on the RAW file.\n// Exported (#741): the wasi_only MERGE lane (merge_sources.vibe) applies the\n// same ingestion when collecting its import graph, so contract packages\n// (.vibei) resolve in that lane too.\n// #740: the facade output is marked so a second ingestion pass (the\n// collect_source_groups_fs chokepoint below re-ingests EVERY collected\n// source, including ones a cache-reconstruction branch already ingested)\n// recognizes an already-desugared contract instead of re-parsing the facade\n// as contract grammar (which would fail conformance with empty decls).\n// #753: the marker constant moved to contract/index.vibe so the\n// persistent-header lane (header_cache.vibe) applies the same check.\n\nfn path_basename(path: String) -> String {\n  let idx = String::last_index_of(path, \"/\")\n  if idx < 0 {\n    path\n  } else {\n    path[idx + 1: String::length(path)]\n  }\n}\n\nfn is_vpkg_companion_basename(name: String) -> Bool {\n  String::ends_with(name, \"_test.vibe\") || String::ends_with(name, \"_bench.vibe\")\n}\n\nfn is_vpkg_explicit_only_basename(name: String) -> Bool {\n  String::ends_with(name, \".vibe\") && (String::starts_with(name, \"_\") || String::ends_with(name, \".draft.vibe\"))\n}\n\n// This is intentionally the same direct-production filter used by implicit\n// `.vpkg` discovery. Companions are handled separately: they are not package\n// members, but an explicitly-run companion inherits the nearest package scope.\nfn is_vpkg_direct_production_basename(name: String) -> Bool {\n  name != \"index.vibei\" && name != \"index.vibe\" && name != \"index.vpkg\" && String::ends_with(name, \".vibe\") && !is_vpkg_companion_basename(name) && !String::ends_with(name, \".draft.vibe\") && !String::starts_with(name, \"_\")\n}\n\nfn validate_index_layout_fs(path: String) -> Unit with { Error, Fs } {\n  ensure_regular_source_fs(path)\n  let dir = dir_of_path(path)\n  let present = array_empty()\n  if Fs::exists(path_in_dir(dir, \"index.vibe\")) {\n    Array::push(present, \"index.vibe\")\n  } else ()\n  if Fs::exists(path_in_dir(dir, \"index.vibei\")) {\n    Array::push(present, \"index.vibei\")\n  } else ()\n  if Fs::exists(vpkg_path_in_dir(dir)) {\n    Array::push(present, \"index.vpkg\")\n  } else ()\n  if Array::length(present) > 1 {\n    throw(\"\\{String::join(present, \" and \")} exist in \\{dir} (#729/#897): a boundary has exactly one index\")\n  } else ()\n}\n\n// #897: the directory-shared `import @user/mod { x, y }` text to PREPEND to\n// `path`'s own source. Direct production siblings use their directory's vpkg;\n// explicitly-run test/bench companions and explicitly-reached private/draft\n// sources use their nearest enclosing vpkg. These sources remain excluded from\n// implicit build roots; explicit-only sources enter the hash only when reached.\n// \"\" when `path` doesn't qualify or the vpkg declares no shared imports.\n// Reads `index.vpkg` FRESH from disk on every\n// call rather than caching anything about it here — every caller already\n// keys its OWN cache off a fingerprint of this function's return value baked\n// into the ingested source text (`compact_string_fingerprint`, throughout\n// runtime/index.vibe and header_cache.vibe's `load_or_parse_module_header_fs_impl`),\n// so a live re-read is what makes a change to `index.vpkg`'s shared imports\n// correctly invalidate every sibling's downstream caches — no separate\n// invalidation bookkeeping needed (the #801 stale-cache bug class this\n// avoids: caching a derived value under a key that does not depend on\n// everything the value was derived from).\n// Scoped to `.vpkg` only (#897 issue comments: `.vibei`'s legacy either/or\n// import behavior is deliberately left unchanged by this feature).\nfn vpkg_directory_shared_import_prefix_fs(path: String) -> String with { Error, Fs } {\n  if is_contract_ext(path) {\n    \"\"\n  } else {\n    let basename = path_basename(path)\n    let vpkg_path = if is_vpkg_companion_basename(basename) || is_vpkg_explicit_only_basename(basename) {\n      nearest_vpkg_path_fs(path)\n    } else if is_vpkg_direct_production_basename(basename) {\n      let direct = vpkg_path_in_dir(dir_of_path(path))\n      if Fs::exists(direct) { direct } else { \"\" }\n    } else {\n      \"\"\n    }\n    if vpkg_path == \"\" {\n      \"\"\n    } else {\n      ensure_regular_source_fs(vpkg_path)\n      let (_, vpkg_pin_blanked) = extract_require_pins(Fs::read_file(vpkg_path))\n      let (_, _, vpkg_extra) = parse_contract_program(lex(vpkg_pin_blanked))\n      contract_directory_shared_import_prefix_text(vpkg_extra)\n    }\n  }\n}\n\n// #897: applies `vpkg_directory_shared_import_prefix_fs`, guarded by\n// `vpkg_shared_import_marker` so re-ingesting an already-ingested source\n// (routine: `collect_source_groups_fs` re-ingests every source it collects,\n// #740) does not prepend the inherited imports a second time.\nfn apply_vpkg_directory_shared_imports_fs(path: String, pin_blanked: String) -> String with { Error, Fs } {\n  if String::starts_with(pin_blanked, vpkg_shared_import_marker) {\n    pin_blanked\n  } else {\n    let prefix = vpkg_directory_shared_import_prefix_fs(path)\n    if prefix == \"\" {\n      pin_blanked\n    } else {\n      String::concat(vpkg_shared_import_marker, String::concat(prefix, pin_blanked))\n    }\n  }\n}\n\nexport fn ingest_source_text_fs(path: String, raw: String) -> String with { Error, Fs } {\n  let (_, pin_blanked) = extract_require_pins(raw)\n  if is_contract_ext(path) {\n    if String::starts_with(pin_blanked, contract_facade_marker) {\n      pin_blanked\n    } else {\n      String::concat(contract_facade_marker, desugar_contract_source_fs(path, pin_blanked))\n    }\n  } else {\n    apply_vpkg_directory_shared_imports_fs(path, pin_blanked)\n  }\n}\n\n// #740: manifest source loaders (manifest_sources.vibe) read RAW disk bytes;\n// a .vibei contract reaching the grouped merge un-desugared left its imports\n// unresolvable (\"undefined variable (local): sha1 @call\" — contract/index.vibe's\n// @vibe/core import never rewrote). Ingest every collected source once here,\n// the single point all collection branches (manifest, caches, recursive walk)\n// flow through.\nfn ingest_grouped_sources_fs(groups: Array[(String, Array[(String, String)])]) -> Array[(String, Array[(String, String)])] with { Error, Fs } {\n  let out = empty_grouped_sources()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (gname, gsources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(gsources) {\n      let (spath, stext) = Array::get(gsources, si)\n      push_grouped_source(out, gname, spath, ingest_source_text_fs(spath, stext))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  out\n}\n\nfn load_cached_sources_rec(specs: Array[(String, String, String)], index: Int, out: Array[(String, String)]) -> Option[Array[(String, String)]] with { Error, Fs } {\n  if index >= Array::length(specs) {\n    Some(out)\n  } else {\n    let (path, stat_token_text, source_fingerprint) = Array::get(specs, index)\n    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\n      Some(source) => {\n        Array::push(out, (path, ingest_source_text_fs(path, source)))\n        load_cached_sources_rec(specs, index + 1, out)\n      },\n      None => None\n    }\n  }\n}\n\nfn load_cached_grouped_sources_rec(rows: Array[(String, String, String, String)], index: Int, out: Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } {\n  if index >= Array::length(rows) {\n    Some(out)\n  } else {\n    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)\n    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\n      Some(source) => {\n        push_grouped_source(out, group_name, path, ingest_source_text_fs(path, source))\n        load_cached_grouped_sources_rec(rows, index + 1, out)\n      },\n      None => None\n    }\n  }\n}\n\nfn load_cached_group_fingerprint_rec(rows: Array[(String, String, String, String)], index: Int, out: Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } {\n  if index >= Array::length(rows) {\n    Some(out)\n  } else {\n    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)\n    if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {\n      None\n    } else {\n      push_grouped_source_fingerprint(out, group_name, path, source_fingerprint)\n      load_cached_group_fingerprint_rec(rows, index + 1, out)\n    }\n  }\n}\n\nfn manifest_cache_is_valid(manifest: Option[(String, String, String)]) -> Bool with { Error, Fs } {\n  match manifest {\n    Some((path, stat_token_text, source_fingerprint)) =>\n      matches_cached_file_spec(path, stat_token_text, source_fingerprint),\n    None => true\n  }\n}\n\nfn load_persistent_sources_cache_if_valid(entry_path: String) -> Option[Array[(String, String)]] with { Error, Fs } {\n  let cache_path = persistent_source_list_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, specs, resctx) = parse_persistent_source_list_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(resolution_context_is_valid(resctx, entry_path, source_cache_spec_paths(specs))) {\n      None\n    } else if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      load_cached_sources_rec(specs, 0, empty_source_specs())\n    }\n  }\n}\n\nfn load_persistent_source_groups_cache_if_valid(entry_path: String) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows, resctx) = parse_persistent_source_group_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(resolution_context_is_valid(resctx, entry_path, group_cache_row_paths(rows))) {\n      None\n    } else if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      load_cached_grouped_sources_rec(rows, 0, empty_grouped_sources())\n    }\n  }\n}\n\nfn manifest_path_of(manifest: Option[(String, String, String)]) -> Option[String] {\n  match manifest {\n    Some((path, _, _)) => Some(path),\n    None => None\n  }\n}\n\nfn load_persistent_sources_from_group_cache_if_valid(entry_path: String) -> Option[(Option[String], Array[(String, String)])] with { Error, Fs } {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows, resctx) = parse_persistent_source_group_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(resolution_context_is_valid(resctx, entry_path, group_cache_row_paths(rows))) {\n      None\n    } else if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      let specs = empty_source_cache_specs()\n      let mut i = 0\n      while i < Array::length(rows) {\n        let (_, path, stat_token_text, source_fingerprint) = Array::get(rows, i)\n        Array::push(specs, (path, stat_token_text, source_fingerprint))\n        i = i + 1\n      }\n      match load_cached_sources_rec(specs, 0, empty_source_specs()) {\n        Some(sources) => Some((manifest_path_of(manifest), sources)),\n        None => None\n      }\n    }\n  }\n}\n\nfn load_persistent_source_groups_from_source_list_cache_if_valid(entry_path: String) -> Option[(Option[String], Array[(String, Array[(String, String)])])] with { Error, Fs } {\n  let cache_path = persistent_source_list_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, specs, resctx) = parse_persistent_source_list_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(resolution_context_is_valid(resctx, entry_path, source_cache_spec_paths(specs))) {\n      None\n    } else if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      match load_cached_sources_rec(specs, 0, empty_source_specs()) {\n        Some(sources) =>\n          match try_load_manifest_rows(entry_path) {\n            Some((base_dir, rows)) => {\n              let groups = build_grouped_sources_from_manifest_rows(base_dir, rows, sources)\n              // #801 bug 2: `sources` comes from the source-LIST cache, a\n              // SEPARATE persistent cache from the group cache being rebuilt\n              // here. Each cache independently passes its own resctx/manifest\n              // validity check, but that does not guarantee the two enumerate\n              // the SAME file set -- e.g. the list cache may have been seeded\n              // via a plain recursive walk (or an older manifest snapshot)\n              // that never reached every manifest-listed group.\n              // build_grouped_sources_from_manifest_rows silently drops any\n              // manifest row with no matching path in `sources`, so a\n              // stale/narrower list cache can make an entire group vanish\n              // with no signal (observed: lib/@vibe/core's vibe_core /\n              // index.vibei group dropped wholesale, 50/51 rows survived).\n              // Cross-validate the reconstruction against the manifest's own\n              // row count before trusting (and persisting) it: a short count\n              // means rows were dropped, so refuse this lane and let the\n              // caller fall through to a fresh manifest collection\n              // (try_collect_manifest_source_groups_fs) that rebuilds the\n              // correct groups directly from disk instead of silently\n              // caching/returning the incomplete graph.\n              if Array::length(flatten_group_sources(groups)) != Array::length(rows) {\n                None\n              } else {\n                Some((manifest_path_of(manifest), groups))\n              }\n            },\n            None => {\n              let groups = empty_grouped_sources()\n              Array::push(groups, (\"recursive\", sources))\n              Some((None, groups))\n            }\n          },\n        None => None\n      }\n    }\n  }\n}\n\nexport fn load_persistent_source_group_fingerprint_if_valid(entry_path: String) -> Option[String] with { Error, Fs } {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows, resctx) = parse_persistent_source_group_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(resolution_context_is_valid(resctx, entry_path, group_cache_row_paths(rows))) {\n      None\n    } else if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      match load_cached_group_fingerprint_rec(rows, 0, empty_grouped_sources()) {\n        Some(groups) => Some(build_source_groups_fingerprint_from_compact_fingerprints(groups)),\n        None => None\n      }\n    }\n  }\n}\n\n// #769: O(N) build via StringBuilder. The previous `out = String::concat(out,\n// row)` per row was O(N^2) over the row count -- on the heaviest standalone\n// closures (cache_probe_cli_prepare_batch_bench_test pulls the whole compiler)\n// the bump-allocated concat garbage blew past the 4GB wasm32 address space in\n// ~3s (peak RSS 3.6GB measured) and memory.grow's ignored failure surfaced as\n// a \"memory access out of bounds\" inside String::concat's memory.copy. Same\n// fix and issue class as stable_cache_path's #366 note (lib/@vibe/cache).\nfn build_persistent_sources_cache_text(entry_path: String, manifest_path: Option[String], sources: Array[(String, String)]) -> String with { Error, Fs } {\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, \"version\\t3\\n\")\n  StringBuilder::push(sb, \"resctx\\t\")\n  StringBuilder::push(\n    sb,\n    persistent_resolution_context_fingerprint_fs(entry_path, source_paths(sources))\n  )\n  StringBuilder::push(sb, \"\\n\")\n  match manifest_path {\n    Some(path) => {\n      StringBuilder::push(sb, \"manifest\\t\")\n      StringBuilder::push(sb, path)\n      StringBuilder::push(sb, \"\\t\")\n      StringBuilder::push(sb, __to_string(Fs::stat_token(path)))\n      StringBuilder::push(sb, \"\\t\")\n      StringBuilder::push(sb, compact_string_fingerprint(Fs::read_file(path)))\n      StringBuilder::push(sb, \"\\n\")\n    },\n    None => ()\n  }\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    // #769: skip empty-path rows -- `Fs::stat_token(\"\")` throws in the host\n    // (ENOENT stat ''), and a pathless row could never be validated on reload\n    // anyway. Empty paths have been observed reaching this writer through the\n    // recursive-collection lane (cache_probe_loader_manifest_groups_bench /\n    // collect_source_groups_fs on some entries); the row origin is tracked\n    // separately, but the writer must never crash the whole compile over it.\n    if String::length(path) == 0 {\n      ()\n    } else {\n      StringBuilder::push(sb, \"source\\t\")\n      StringBuilder::push(sb, path)\n      StringBuilder::push(sb, \"\\t\")\n      StringBuilder::push(sb, __to_string(Fs::stat_token(path)))\n      StringBuilder::push(sb, \"\\t\")\n      StringBuilder::push(sb, compact_string_fingerprint(source))\n      StringBuilder::push(sb, \"\\n\")\n    }\n    i = i + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\n// #769: O(N) via StringBuilder, same rationale as\n// build_persistent_sources_cache_text above.\nfn build_persistent_source_groups_cache_text(entry_path: String, manifest_path: Option[String], groups: Array[(String, Array[(String, String)])]) -> String with { Error, Fs } {\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, \"version\\t3\\n\")\n  StringBuilder::push(sb, \"resctx\\t\")\n  StringBuilder::push(\n    sb,\n    persistent_resolution_context_fingerprint_fs(\n      entry_path,\n      grouped_source_paths(groups)\n    )\n  )\n  StringBuilder::push(sb, \"\\n\")\n  match manifest_path {\n    Some(path) => {\n      StringBuilder::push(sb, \"manifest\\t\")\n      StringBuilder::push(sb, path)\n      StringBuilder::push(sb, \"\\t\")\n      StringBuilder::push(sb, __to_string(Fs::stat_token(path)))\n      StringBuilder::push(sb, \"\\t\")\n      StringBuilder::push(sb, compact_string_fingerprint(Fs::read_file(path)))\n      StringBuilder::push(sb, \"\\n\")\n    },\n    None => ()\n  }\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      // #769: skip empty-path rows (see build_persistent_sources_cache_text).\n      if String::length(path) == 0 {\n        ()\n      } else {\n        StringBuilder::push(sb, \"group\\t\")\n        StringBuilder::push(sb, group_name)\n        StringBuilder::push(sb, \"\\t\")\n        StringBuilder::push(sb, path)\n        StringBuilder::push(sb, \"\\t\")\n        StringBuilder::push(sb, __to_string(Fs::stat_token(path)))\n        StringBuilder::push(sb, \"\\t\")\n        StringBuilder::push(sb, compact_string_fingerprint(source))\n        StringBuilder::push(sb, \"\\n\")\n      }\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\nfn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String) -> Array[String] with { Fs } {\n  let deps = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\n      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  deps\n}\n\nexport fn load_or_parse_module_header_fs(path: String, source: String, parse_count: Int) -> (Array[String], Array[String], Int) with { Error, Fs } {\n  load_or_parse_module_header_fs_impl(path, source, parse_count)\n}\n\nfn store_persistent_sources_cache(entry_path: String, manifest_path: Option[String], sources: Array[(String, String)]) -> Unit with { Error, Fs } {\n  Fs::write_file(\n    persistent_source_list_cache_path(entry_path),\n    build_persistent_sources_cache_text(entry_path, manifest_path, sources)\n  )\n}\n\nfn store_persistent_source_groups_cache(entry_path: String, manifest_path: Option[String], groups: Array[(String, Array[(String, String)])]) -> Unit with { Error, Fs } {\n  Fs::write_file(\n    persistent_source_group_cache_path(entry_path),\n    build_persistent_source_groups_cache_text(entry_path, manifest_path, groups)\n  )\n}\n\nfn copy_grouped_sources(groups: Array[(String, Array[(String, String)])]) -> Array[(String, Array[(String, String)])] {\n  let out = empty_grouped_sources()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let copied_sources = copy_source_specs(sources)\n    Array::push(out, (group_name, copied_sources))\n    gi = gi + 1\n  }\n  out\n}\n\nfn flatten_group_sources(groups: Array[(String, Array[(String, String)])]) -> Array[(String, String)] {\n  let out = empty_source_specs()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (_, sources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      Array::push(out, Array::get(sources, si))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  out\n}\n\nfn filter_group_sources(groups: Array[(String, Array[(String, String)])], ordered_sources: Array[(String, String)]) -> Array[(String, Array[(String, String)])] {\n  let filtered = empty_grouped_sources()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let next_sources = empty_source_specs()\n    let mut si = 0\n    while si < Array::length(sources) {\n      let pair = Array::get(sources, si)\n      let (path, _) = pair\n      match source_lookup(ordered_sources, path) {\n        Some(_) => Array::push(next_sources, pair),\n        None => ()\n      }\n      si = si + 1\n    }\n    if Array::length(next_sources) > 0 {\n      Array::push(filtered, (group_name, next_sources))\n    }\n    gi = gi + 1\n  }\n  filtered\n}\n\nfn special_bundle_source_groups(entry_path: String) -> Option[Array[(String, Array[(String, String)])]] {\n  let _ = entry_path\n  None\n}\n\nfn normalize_bundle_source_groups(groups: Array[(String, Array[(String, String)])], main_path: String, main_source: String) -> Array[(String, Array[(String, String)])] {\n  let normalized = empty_grouped_sources()\n  let mut found = false\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let next_sources = empty_source_specs()\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      if path == main_path {\n        Array::push(next_sources, (path, main_source))\n        found = true\n      } else {\n        Array::push(next_sources, (path, source))\n      }\n      si = si + 1\n    }\n    Array::push(normalized, (group_name, next_sources))\n    gi = gi + 1\n  }\n  if !found {\n    let entry_sources = empty_source_specs()\n    Array::push(entry_sources, (main_path, main_source))\n    Array::push(normalized, (\"entry\", entry_sources))\n  }\n  normalized\n}\n\nfn special_manifest_sources(entry_path: String) -> Option[(String, Array[(String, String)])] {\n  let _ = entry_path\n  None\n}\n\nfn special_manifest_source_groups(entry_path: String) -> Option[(String, Array[(String, Array[(String, String)])])] {\n  let _ = entry_path\n  None\n}\n\n\n//# Helper functions\n\n// Cache lookup helper\nfn cache_lookup(cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\n  let len = Array::length(cache)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while i < len {\n    if done {\n      i = len\n    } else {\n      let (p, e) = Array::get(cache, i)\n      if p == path {\n        result = Some(e)\n        done = true\n      }\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn export_marker_name(name: String) -> String {\n  String::concat(\"__vibe_internal_export__:\", name)\n}\n\nfn env_has_export_marker(env: TypeEnv, name: String) -> Bool {\n  match env_lookup(env, export_marker_name(name)) {\n    Some(_) => true,\n    None => false\n  }\n}\n\nfn bind_export_markers(env: TypeEnv, exports: Array[String]) -> TypeEnv {\n  let mut acc = env\n  let mut i = 0\n  while i < Array::length(exports) {\n    acc = env_bind(acc, export_marker_name(Array::get(exports, i)), CtUnit)\n    i = i + 1\n  }\n  acc\n}\n\n// Bind imported names from a checked module's env\nfn bind_checked_imports(names: Array[(String, Option[String])], i: Int, env: TypeEnv, mod_env: TypeEnv) -> TypeEnv {\n  if i >= Array::length(names) {\n    env\n  } else {\n    let (name, alias) = Array::get(names, i)\n    let bound_name = match alias {\n      Some(a) => a,\n      None => name\n    }\n    let new_env = if env_has_export_marker(mod_env, name) {\n      match env_lookup(mod_env, name) {\n        Some(ty) => env_bind(env, bound_name, ty),\n        None => env\n      }\n    } else {\n      env\n    }\n    bind_checked_imports(names, i + 1, new_env, mod_env)\n  }\n}\n\n//# Module Loader\n\n// Check a module and return its TypeEnv, resolving imports recursively.\n// resolve_imports is inlined to avoid mutual recursion (vibe has no forward references).\nexport fn check_module(source: String, path: String, sources: Array[(String, String)], loading: Array[String], checked_cache: Array[(String, TypeEnv)]) -> TypeEnv with { Error } {\n  // Check cache first\n  let cached = cache_lookup(checked_cache, path)\n  match cached {\n    Some(env) => env,\n    None => {\n      // Cycle detection\n      if contains_path(loading, path) {\n        throw(String::concat(\"import cycle detected: \", path))\n      }\n      let tokens = lex(source)\n      let stmts = parse_program(tokens)\n      let base_dir = dir_of_path(path)\n      // Cycle-detection stack: push self before recursing through this\n      // module's imports, truncate back when done. O(1) per frame vs.\n      // the previous `Array::concat(loading, [path])`, which copied the\n      // entire ancestor stack on every recursion and made nested module\n      // loads O(depth²) — same idiom as `runtime/typecheck_fs.vibe`\n      // (#366 truncate cutover).\n      let saved_loading_len = Array::length(loading)\n      Array::push(loading, path)\n\n      // Resolve imports using while loop\n      let mut import_env = EnvEmpty\n      let mut ri = 0\n      while ri < Array::length(stmts) {\n        let stmt = Array::get(stmts, ri)\n        import_env = match stmt {\n          SImport(raw_path, names) => {\n            match resolve_path_in_sources(base_dir, raw_path, sources) {\n              None => throw(String::concat(\"module not found: \", resolve_import_path(base_dir, raw_path))),\n              Some((resolved, mod_source)) => {\n                let mod_env = check_module(mod_source, resolved, sources, loading, checked_cache)\n                bind_checked_imports(names, 0, import_env, mod_env)\n              }\n            }\n          },\n          SReExport(raw_path, names) => {\n            match resolve_path_in_sources(base_dir, raw_path, sources) {\n              None => throw(String::concat(\"module not found: \", resolve_import_path(base_dir, raw_path))),\n              Some((resolved, mod_source)) => {\n                let mod_env = check_module(mod_source, resolved, sources, loading, checked_cache)\n                bind_checked_imports(names, 0, import_env, mod_env)\n              }\n            }\n          },\n          _ => import_env\n        }\n        ri = ri + 1\n      }\n      Array::truncate(loading, saved_loading_len)\n\n      // Type-check with imported env\n      let empty_defs = array_empty()\n      let check_errors = array_empty()\n      // (8th arg: the typed-hover tytab — unused in this lane. The stale\n      // 7-arg call only surfaced under the cold-cache whole-graph check,\n      // #740 fallout.)\n      let check_tytab = array_empty()\n      let (env, _, _) = check_stmts(stmts, 0, import_env, empty_defs, SubstEmpty, 0, check_errors, check_tytab)\n\n      // Cache result\n      let cached_env = bind_export_markers(env, collect_exports(stmts))\n      Array::push(checked_cache, (path, cached_env))\n      cached_env\n    }\n  }\n}\n\n//# FS-based source collection\n\n// `visited` is a `path_set` (#533): this recursion runs once per import\n// EDGE and the visited set grows to every module of the program, so the\n// previous linear `contains_path` scan was O(edges × modules). The set is\n// membership-only — `sources` keeps its own dependency-first order from\n// the recursion, which is what callers consume.\n// #729 (ADR-0063 Phase C-2): ingest an index.vibei contract. The contract is\n// conformance-checked against its declared implementation files and desugared\n// to plain facade source (re-export lines), so everything downstream of the\n// loader — type db, merge plan, codegen — sees ordinary vibe source and needs\n// no .vibei awareness. Implementation files are DECLARED by the contract\n// (`import ./impl.vibe {}`) rather than discovered: the Fs effect has no\n// directory listing yet (auto-discovery arrives with Fs::ReadDir, #730).\nfn desugar_contract_source_fs(path: String, source: String) -> String with { Error, Fs } {\n  let dir = dir_of_path(path)\n  validate_index_layout_fs(path)\n  let (decls_raw, opaque_names, extra) = parse_contract_program(lex(source))\n  // `source` here has already had its leading directive region blanked by\n  // extract_require_pins (see ingest_source_text_fs), so the directive must\n  // be read back from the ORIGINAL on-disk text via `path`.\n  let pkg_version = extract_package_version(Fs::read_file(path))\n  // #<version-synthesis>: `version` is already carried by the package's own\n  // leading `version x.y.z` directive (ADR-0065/#754) -- a contract no\n  // longer needs to also declare `let version: String`, nor does any impl\n  // file need to define it. Drop it from `decls` (so `check_contract` stops\n  // demanding an implementation for it) and synthesize the binding directly\n  // into the facade instead. Only do this when a directive actually exists\n  // (Codex review on #1054): a contract with a bare `let version: String`\n  // decl and NO `version x.y.z` directive is the pre-existing legacy shape\n  // (declared + hand-implemented, no synthesis) -- dropping it there too\n  // would strip the declaration out from under a real implementation with\n  // nothing to replace it, turning a legitimate impl into an undeclared\n  // export. A contract that still spells the old bodyless `let version:\n  // String` line alongside a real directive keeps parsing (this filter just\n  // makes it a no-op) so existing packages migrate at their own pace.\n  let decls = array_empty()\n  let mut dvi = 0\n  while dvi < Array::length(decls_raw) {\n    let (dname, dsig) = Array::get(decls_raw, dvi)\n    if dname == \"version\" && dsig == \"val String\" && pkg_version != \"\" {\n      ()\n    } else {\n      Array::push(decls, (dname, dsig))\n    }\n    dvi = dvi + 1\n  }\n  let (impl_raws0, type_defs) = classify_contract_stmts(extra)\n  // #730: explicit `import ./impl.vibe {}` declarations win; a contract that\n  // declares none auto-discovers its sibling *.vibe files (Fs::readdir,\n  // byte-sorted by the host so the facade is deterministic).\n  // #897/#855 (ADR-0070 Phase 1): .vpkg gets implicit membership\n  // unconditionally -- explicit declarations (if any) are MERGED with\n  // discovery rather than suppressing it, replacing the empty-import idiom.\n  let impl_raws = if String::ends_with(path, \".vpkg\") {\n    merge_impl_raws_dedupe(impl_raws0, contract_sibling_impl_raws(dir))\n  } else if Array::length(impl_raws0) == 0 {\n    contract_sibling_impl_raws(dir)\n  } else {\n    impl_raws0\n  }\n  let impl_units = array_empty()\n  let union_stmts = array_empty()\n  let mut ri = 0\n  while ri < Array::length(impl_raws) {\n    let raw = Array::get(impl_raws, ri)\n    // #842: probe directory/contract candidates the same way the regular\n    // loader does (resolve_path_fs) instead of assuming the plain-file form\n    // — a bare `import ../pkg { ... }` inside a .vibei must resolve to\n    // `../pkg/index.vibei` (or `/index.vibe`) when `../pkg.vibe` does not\n    // exist, exactly like the same import spelled inside a .vibe impl file.\n    let resolved = resolve_path_fs(dir, raw)\n    ensure_regular_source_fs(resolved)\n    // #842: an impl raw may itself resolve to ANOTHER package's contract\n    // (a cross-package `import ../pkg { ... }`, not just this package's own\n    // sibling impl files) — route it through the same ingestion transform\n    // every other on-disk source goes through (ingest_source_text_fs), so a\n    // `.vibei` target is recursively desugared to its facade text instead of\n    // being handed to parse_program as raw (bodyless) contract grammar.\n    let impl_ingested = ingest_source_text_fs(resolved, Fs::read_file(resolved))\n    let impl_stmts = parse_program(lex(impl_ingested))\n    Array::push(impl_units, (raw, impl_stmts))\n    // #847: a raw resolving to ANOTHER package's own index.vibei/index.vibe\n    // (a cross-package or nested-boundary reference, e.g. `import ../pkgb\n    // { type X }` written purely so the contract's own bodyless signatures\n    // can NAME `X`) is that OTHER package's already-conformance-checked\n    // facade, not this package's own implementation surface. Its stmts are\n    // excluded from `union_stmts` (this package's own conformance input) —\n    // otherwise pkgb's synthetic `export ./impl.vibe { X, make, value }`\n    // facade line reads as pkga re-exporting undeclared symbols, a false\n    // positive `check_contract`'s SReExport check would otherwise raise.\n    // `impl_units` (facade generation) is unaffected: a boundary unit's defs\n    // are already invisible to `collect_impl_fn_defs`/`collect_impl_type_defs`\n    // (a facade is SReExport-only, no SLet/SStruct), so it never allocates a\n    // re-export line under this package's own name anyway.\n    let is_boundary_unit = String::ends_with(resolved, \"/index.vibei\") || String::ends_with(resolved, \"/index.vpkg\") || String::ends_with(resolved, \"/index.vibe\")\n    if is_boundary_unit {\n      ()\n    } else {\n      let mut si = 0\n      while si < Array::length(impl_stmts) {\n        Array::push(union_stmts, Array::get(impl_stmts, si))\n        si = si + 1\n      }\n    }\n    ri = ri + 1\n  }\n  let errors = check_contract(decls, opaque_names, union_stmts, type_defs)\n  if Array::length(errors) > 0 {\n    throw(\"\\{path}: contract violation: \\{String::join(errors, \"; \")}\")\n  } else ()\n  let facade = contract_facade_source(decls, opaque_names, type_defs, impl_units)\n  if pkg_version == \"\" {\n    facade\n  } else {\n    String::concat(facade, \"\\nexport let version: String = \\\"\\{pkg_version}\\\"\\n\")\n  }\n}\n\n// #730 (D-2): both content-addressing hashes of a contract package, from its\n// ORIGINAL on-disk texts (require lines included — they are part of the\n// hashed content, which is what makes a direct pin fix the transitive\n// closure). Paths in the package hash are package-relative (\"index.vibei\" +\n// each impl's raw import spelling), so the hash is location-independent —\n// the same function serves `vibe hash` on a working directory and store\n// verification of an installed copy.\nexport fn contract_package_hashes_fs(path: String) -> (String, String) with { Error, Fs } {\n  validate_index_layout_fs(path)\n  let raw = Fs::read_file(path)\n  let (_, blanked) = extract_require_pins(raw)\n  let (decls, opaques, extra) = parse_contract_program(lex(blanked))\n  let (impl_raws0, type_defs) = classify_contract_stmts(extra)\n  let package_contract = normalize_path(path)\n  let dir = dir_of_path(package_contract)\n  // #730: mirror the ingestion's auto-discovery — the package hash must cover\n  // the same impl files the facade is built from. Discovered raws are\n  // \"./<name>\" and byte-sorted, so the hash stays location-independent and\n  // deterministic.\n  // #897/#855: mirror desugar_contract_source_fs's .vpkg implicit-membership\n  // merge exactly, so the hash always covers the same impl set the facade\n  // was built from (a mismatch here would make the content-addressed hash\n  // silently stale relative to what actually got conformance-checked).\n  let impl_raws = if String::ends_with(path, \".vpkg\") {\n    merge_impl_raws_dedupe(impl_raws0, contract_sibling_impl_raws(dir))\n  } else if Array::length(impl_raws0) == 0 {\n    contract_sibling_impl_raws(dir)\n  } else {\n    impl_raws0\n  }\n  let sources = array_empty()\n  // #897 (ADR-0070 Phase 1): the package-hash key names the contract file by\n  // its OWN on-disk suffix rather than assuming \"index.vibei\" — `path` is\n  // already the resolved contract file (whichever of .vibei/.vpkg won), so\n  // its basename is read off directly instead of re-probing the filesystem.\n  // A directory that migrates from index.vibei to index.vpkg intentionally\n  // gets a different hash (the rename is a real content/identity change).\n  let contract_last_slash = String::last_index_of(path, \"/\")\n  let contract_basename = if contract_last_slash < 0 {\n    path\n  } else {\n    path[contract_last_slash + 1: String::length(path)]\n  }\n  Array::push(sources, (contract_basename, raw))\n  let mut ri = 0\n  if String::ends_with(package_contract, \".vpkg\") {\n    let visited = path_set_new()\n    while ri < Array::length(impl_raws) {\n      let resolved = resolve_path_fs(dir, Array::get(impl_raws, ri))\n      collect_package_hash_source_closure_fs(\n        package_contract,\n        dir,\n        resolved,\n        sources,\n        visited\n      )\n      ri = ri + 1\n    }\n  } else {\n    // Legacy .vibei hashing preserves its declared/direct implementation set.\n    while ri < Array::length(impl_raws) {\n      let iraw = Array::get(impl_raws, ri)\n      let resolved = resolve_path_fs(dir, iraw)\n      ensure_regular_source_fs(resolved)\n      let itext = Fs::read_file(resolved)\n      Array::push(sources, (iraw, itext))\n      ri = ri + 1\n    }\n  }\n  (package_hash_from_sources(sources), contract_hash(decls, opaques, type_defs))\n}\n\n// #730 (D-3): fill missing require pins OFFLINE from the workspace store.\n// `require @x/y 1.2.3` becomes `require @x/y 1.2.3 = #pkg:sha1:<hex>` when\n// .vibe/store/@x/y/ is installed; a package absent from the store is an\n// error (network fetch belongs to `vibe add`/`update`, never to fmt).\n// Pinned lines pass through untouched, so the rewrite is idempotent.\nexport fn fill_require_pins_fs(source: String) -> String with { Error, Fs } {\n  fill_require_pins_fs_mode(source, false)\n}\n\n// repin=true rewrites EVERY require line to the store's current hash —\n// `vibe dedupe --apply` (#730 D-4): after updating a store package, one\n// pass re-points all pins in a file at the installed copies. With the\n// by-name store there is one installed version per package, so repinning\n// IS conflict resolution.\nexport fn fill_require_pins_fs_mode(source: String, repin: Bool) -> String with { Error, Fs } {\n  let sb = StringBuilder::new()\n  let len = String::length(source)\n  let mut pos = 0\n  let mut scanning = true\n  while pos < len {\n    let mut nl = pos\n    while nl < len && String::char_code_at(source, nl) != 10 {\n      nl = nl + 1\n    }\n    let line = String::substring(source, pos, nl)\n    let trimmed = String::trim(line)\n    let mut emitted = false\n    if scanning && String::starts_with(trimmed, \"require \") {\n      let (pins_one, _) = extract_require_pins(String::concat(trimmed, \"\\n\"))\n      if Array::length(pins_one) == 1 {\n        let (pname, pver, ppin) = Array::get(pins_one, 0)\n        if ppin == \"\" || repin {\n          // #897: try the target spelling (.vpkg) first, then legacy\n          // .vibei, mirroring resolve_import_path_candidates' root ordering.\n          let store_index_vpkg = String::concat(\".vibe/store/\", String::concat(pname, \"/index.vpkg\"))\n          let store_index_vibei = String::concat(\".vibe/store/\", String::concat(pname, \"/index.vibei\"))\n          let store_index = if Fs::exists(store_index_vpkg) {\n            store_index_vpkg\n          } else {\n            store_index_vibei\n          }\n          if Fs::exists(store_index) {\n            ()\n          } else {\n            throw(\"cannot pin \\{pname} offline: not installed in the store (.vibe/store/\\{pname}/)\")\n          }\n          let (pkg_hash, _) = contract_package_hashes_fs(store_index)\n          StringBuilder::push(sb, \"require \\{pname} \\{pver} = #\\{pkg_hash}\")\n          emitted = true\n        } else ()\n      } else ()\n    } else {\n      if String::length(trimmed) == 0 || String::starts_with(trimmed, \"//\") {\n        ()\n      } else {\n        scanning = false\n      }\n    }\n    if emitted {\n      ()\n    } else {\n      StringBuilder::push(sb, line)\n    }\n    if nl < len {\n      StringBuilder::push(sb, \"\\n\")\n    } else ()\n    pos = nl + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\n// #732 (Phase F): publish gate. Parse the previous and next contract\n// surfaces and verify the claimed version bump is exactly what the diff\n// requires (Elm-style machine-checked semver). Returns error strings;\n// empty = the release claim is honest.\nexport fn publish_check_fs(prev_contract_path: String, next_contract_path: String, prev_version: String, next_version: String) -> Array[String] with { Error, Fs } {\n  let prev_raw = Fs::read_file(prev_contract_path)\n  let (_, prev_blanked) = extract_require_pins(prev_raw)\n  let (pd, po, pextra) = parse_contract_program(lex(prev_blanked))\n  let (_, ptypes) = classify_contract_stmts(pextra)\n  let next_raw = Fs::read_file(next_contract_path)\n  let (_, next_blanked) = extract_require_pins(next_raw)\n  let (nd, no, nextra) = parse_contract_program(lex(next_blanked))\n  let (_, ntypes) = classify_contract_stmts(nextra)\n  // #754: versions come from the PACKAGE-side `version x.y.z` directive when\n  // the caller does not pass them; a caller-passed version that contradicts\n  // the directive is its own error (a publish must not claim a version the\n  // package does not declare).\n  let prev_directive = extract_package_version(prev_raw)\n  let next_directive = extract_package_version(next_raw)\n  let errors = array_empty()\n  if prev_version != \"\" && prev_directive != \"\" && prev_version != prev_directive {\n    Array::push(errors, \"previous version \\{prev_version} contradicts the contract's version directive \\{prev_directive}\")\n  } else ()\n  if next_version != \"\" && next_directive != \"\" && next_version != next_directive {\n    Array::push(errors, \"claimed version \\{next_version} contradicts the contract's version directive \\{next_directive}\")\n  } else ()\n  let pv = if prev_version != \"\" {\n    prev_version\n  } else {\n    prev_directive\n  }\n  let nv = if next_version != \"\" {\n    next_version\n  } else {\n    next_directive\n  }\n  if pv == \"\" || nv == \"\" {\n    Array::push(errors, \"publish versions unavailable: pass them explicitly or add a `version x.y.z` directive to the contract (#754)\")\n    errors\n  } else if Array::length(errors) > 0 {\n    errors\n  } else {\n    verify_publish_bump(\n      pv,\n      nv,\n      contract_surface_lines(pd, po, ptypes),\n      contract_surface_lines(nd, no, ntypes)\n    )\n  }\n}\n\n// #730 (D-2): verify a store-resolved package against the importer's require\n// pin. The store is laid out BY NAME (.vibe/store/@scope/name/) and trusted\n// only through this hash check, so any mirror/copy mechanism is fine.\nfn verify_store_package_fs(importer: String, pins: Array[(String, String, String)], store_index_path: String) -> Unit with { Error, Fs } {\n  let prefix = \".vibe/store/\"\n  // #897: `store_index_path` is already the RESOLVED dep (the caller reads\n  // it off the collected import graph), so its own suffix tells us which\n  // spelling won without re-probing the filesystem.\n  let suffix = if String::ends_with(store_index_path, \"/index.vpkg\") {\n    \"/index.vpkg\"\n  } else {\n    \"/index.vibei\"\n  }\n  let name = String::substring(\n    store_index_path,\n    String::length(prefix),\n    String::length(store_index_path) - String::length(suffix)\n  )\n  let mut pin_hash = \"\"\n  let mut pin_found = false\n  let mut pi = 0\n  while pi < Array::length(pins) {\n    let (pname, _, phash) = Array::get(pins, pi)\n    if pname == name {\n      pin_hash = phash\n      pin_found = true\n    } else ()\n    pi = pi + 1\n  }\n  if pin_found {\n    ()\n  } else {\n    throw(\"no require pin for \\{name} in \\{importer} (add: require \\{name} <x.y.z> = #<pkg-hash>; compute with `vibe hash`)\")\n  }\n  if pin_hash == \"\" {\n    throw(\"unpinned require for \\{name} in \\{importer}: run `vibe fmt` (VIBE_FILL_PINS=1) to insert the pin from the store\")\n  } else ()\n  if Fs::exists(store_index_path) {\n    ()\n  } else {\n    throw(\"package \\{name} is not installed in the store (.vibe/store/\\{name}/)\")\n  }\n  let (actual, _) = contract_package_hashes_fs(store_index_path)\n  if actual == pin_hash {\n    ()\n  } else {\n    throw(\"pin mismatch for \\{name}: \\{importer} requires #\\{pin_hash} but the store copy is #\\{actual}\")\n  }\n}\n\n// #751 (ADR-0065): a `lib/`-resolved package is the dev-mode lane — no\n// require pin is demanded (that stays a store/release rule). But a pin is\n// the truth WHEREVER resolution lands: when the importer does pin the name,\n// the lib/ (or VIBE_LIB external root) copy must match it, or a stale\n// checkout silently diverges from what the pin promises. Under\n// VIBE_REQUIRE_PINS=1 (the release/publish freeze switch; `vibe run\n// --freeze` maps to it) the pin stops being optional: dev-mode name\n// resolution without a pin is an error.\nfn verify_lib_package_fs(importer: String, pins: Array[(String, String, String)], lib_index_path: String) -> Unit with { Error, Fs } {\n  // The package name starts at the \"@\" — works for both the workspace\n  // spelling (\"lib/@scope/name/index.vibei\") and an absolute VIBE_LIB root\n  // (\"/home/u/.vibe/lib/@scope/name/index.vibei\"), and (#897) either's\n  // `.vpkg`-suffixed alternate spelling. `lib_index_path` is already the\n  // RESOLVED dep, so its own suffix tells us which spelling won.\n  let suffix = if String::ends_with(lib_index_path, \"/index.vpkg\") {\n    \"/index.vpkg\"\n  } else {\n    \"/index.vibei\"\n  }\n  let at = String::last_index_of(lib_index_path, \"@\")\n  let name = String::substring(\n    lib_index_path,\n    at,\n    String::length(lib_index_path) - String::length(suffix)\n  )\n  let mut pin_hash = \"\"\n  let mut pi = 0\n  while pi < Array::length(pins) {\n    let (pname, _, phash) = Array::get(pins, pi)\n    if pname == name {\n      pin_hash = phash\n    } else ()\n    pi = pi + 1\n  }\n  if pin_hash == \"\" {\n    if vibe_env_flag(\"VIBE_REQUIRE_PINS\") {\n      throw(\"pin required for \\{name} (VIBE_REQUIRE_PINS=1): \\{importer} resolves it via the dev-mode lib lane; add `require \\{name} <version> = #pkg:sha1:<hash>` (ADR-0065)\")\n    } else if !(Fs::exists(lib_index_path)) {\n      // #831: an unpinned lib/VIBE_LIB package reference with no installed\n      // copy used to fall through here silently and only fail later, deep\n      // inside the raw `Fs::read_file` primitive in `collect_sources_rec`\n      // (an uncaught host-level crash, not a diagnostic). Catch it here,\n      // at resolution time, with the same guidance shape as the pin-mismatch\n      // and store-install errors below/above.\n      throw(\"cannot resolve import \\{name}: not found via lib/ or VIBE_LIB (looked for \\{lib_index_path})\")\n    } else ()\n  } else {\n    let (actual, _) = contract_package_hashes_fs(lib_index_path)\n    if actual == pin_hash {\n      ()\n    } else {\n      throw(\"pin mismatch for \\{name}: \\{importer} requires #\\{pin_hash} but the lib/ copy is #\\{actual}\")\n    }\n  }\n}\n\n// Package-owner boundary enforcement. `index.vpkg` is the sole boundary\n// marker, and the nearest enclosing one owns a source. A contract itself is a\n// public facade. Sources without an owner form a public compatibility space.\n// Every owned implementation target requires the importer to have that same\n// nearest owner, so nested -> parent and parent -> nested internal imports are\n// both rejected.\nfn enforce_incoming_boundary_fs(importer: String, target: String) -> Unit with { Error, Fs } {\n  if is_vpkg_companion_basename(path_basename(target)) {\n    throw(\"cannot import test/bench companion as a module target: \\{target}\")\n  } else ()\n  let target_owner = nearest_vpkg_path_fs(target)\n  if target_owner == \"\" {\n    ()\n  } else if target == target_owner {\n    ()\n  } else {\n    let importer_owner = nearest_vpkg_path_fs(importer)\n    if importer_owner == target_owner {\n      ()\n    } else {\n      throw(\"cannot import \\{target} across a package boundary; target owner is \\{target_owner} (#729); import the owner contract instead\")\n    }\n  }\n}\n\nfn package_relative_hash_key(package_dir: String, source_path: String) -> String with { Error } {\n  let prefix = if package_dir == \"\" {\n    \"\"\n  } else if package_dir == \"/\" {\n    \"/\"\n  } else {\n    String::concat(package_dir, \"/\")\n  }\n  let relative = if prefix == \"\" {\n    source_path\n  } else if String::starts_with(source_path, prefix) {\n    source_path[String::length(prefix): String::length(source_path)]\n  } else {\n    throw(\"package hash source \\{source_path} is outside package directory \\{package_dir}\")\n  }\n  String::concat(\"./\", relative)\n}\n\n// Collect the same-owner dependency closure rooted at direct production\n// siblings. Explicit-only `_*.vibe` / `*.draft.vibe` sources are absent from\n// discovery, but enter this closure when a production source imports them.\n// Cross-package contracts remain represented by the importing source's text\n// and require pin; their implementation bytes belong to their own hash.\nfn collect_package_hash_source_closure_fs(\n  package_contract: String,\n  package_dir: String,\n  source_path: String,\n  sources: Array[(String, String)],\n  visited: Array[Array[String]]\n) -> Unit with { Error, Fs } {\n  if path_set_contains(visited, source_path) {\n    ()\n  } else {\n    path_set_add(visited, source_path)\n    validate_index_layout_fs(source_path)\n    let source = Fs::read_file(source_path)\n    Array::push(sources, (package_relative_hash_key(package_dir, source_path), source))\n    let (deps, _, _) = load_or_parse_module_header_fs(source_path, source, 0)\n    let mut i = 0\n    while i < Array::length(deps) {\n      let dep = Array::get(deps, i)\n      enforce_incoming_boundary_fs(source_path, dep)\n      let dep_owner = nearest_vpkg_path_fs(dep)\n      if dep_owner == package_contract && dep != package_contract {\n        collect_package_hash_source_closure_fs(\n          package_contract,\n          package_dir,\n          dep,\n          sources,\n          visited\n        )\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n  }\n}\n\nfn collect_sources_rec(path: String, sources: Array[(String, String)], visited: Array[Array[String]]) -> Unit with { Error, Fs } {\n  if path_set_contains(visited, path) {\n    ()\n  }\n  else {\n    path_set_add(visited, path)\n    // #831: safety net. `path` normally already passed the located,\n    // raw-import-spelling-aware existence check in\n    // header_cache.vibe's `resolve_checked_path_fs` before it ever became a\n    // dep here -- but this recursion is also entered directly for the\n    // top-level entry path (no importer, no located import site) and can\n    // replay a WARM persistent header cache written before that check\n    // existed (stale fallback dep). `Fs::read_file` is a raw host\n    // primitive: a missing file there is a JS-level throw from the host\n    // runner, not a guest `Error` effect, so it crosses the wasm/JS\n    // boundary uncaught and prints a low-level crash dump instead of a\n    // diagnostic. Guard it here too so no path through this recursion can\n    // still reach that raw primitive with a nonexistent file.\n    if !(Fs::exists(path)) {\n      throw(\"cannot resolve module: \\{path} does not exist\")\n    } else ()\n    validate_index_layout_fs(path)\n    let raw_source = Fs::read_file(path)\n    // #730 (D-2): require pin lines are a leading directive, extracted and\n    // blanked (offset-preserving) before anything parses the source.\n    let (pins, pin_blanked) = extract_require_pins(raw_source)\n    // #749: the facade MUST carry contract_facade_marker — every collected\n    // source is re-ingested at the collect_source_groups_fs chokepoint, and\n    // an unmarked facade re-enters desugar_contract_source_fs as if it were\n    // raw contract grammar (classify_contract_stmts rejects its re-export\n    // lines). This walk used to emit the bare facade; only the cold first\n    // pass reaches it, so the failure hid behind the runner's module-init\n    // re-run (#749).\n    let source = if is_contract_ext(path) {\n      String::concat(contract_facade_marker, desugar_contract_source_fs(path, pin_blanked))\n    } else {\n      // #897: directory-shared vpkg imports (see\n      // `apply_vpkg_directory_shared_imports_fs` above) apply here too --\n      // this cold walk builds `source` independently of `ingest_source_text_fs`\n      // (it needs `pins` separately, for pin verification below), so it must\n      // repeat the same ingestion step rather than silently skip it.\n      apply_vpkg_directory_shared_imports_fs(path, pin_blanked)\n    }\n    let (deps, _, _) = load_or_parse_module_header_fs(path, source, 0)\n    // First, recurse into dependencies (imports and re-exports)\n    let mut i = 0\n    while i < Array::length(deps) {\n      let dep = Array::get(deps, i)\n      enforce_incoming_boundary_fs(path, dep)\n      // Only a store PACKAGE reference (its contract) is pin-verified;\n      // paths inside an already-verified store package (its impl files)\n      // are covered by that package's hash.\n      if String::starts_with(dep, \".vibe/store/\") && is_contract_ext(dep) {\n        verify_store_package_fs(path, pins, dep)\n      } else if is_contract_ext(dep) && String::last_index_of(dep, \"@\") >= 0 {\n        // #751: dev-mode lane (workspace lib/ OR a VIBE_LIB external root —\n        // any @-named package contract that is not the store) — pin\n        // optional but verified when present; VIBE_REQUIRE_PINS=1 demands it.\n        verify_lib_package_fs(path, pins, dep)\n      } else ()\n      collect_sources_rec(dep, sources, visited)\n      i = i + 1\n    }\n    // Then add this module (dependencies come first)\n    Array::push(sources, (path, source))\n  }\n}\n\n// Recursively collect all source files from filesystem, following imports and re-exports.\n// Returns Array[(path, source)] in dependency order (dependencies first).\nexport fn collect_all_sources_fs(entry_path: String) -> Array[(String, String)] with { Error, Fs } {\n  match special_manifest_sources(entry_path) {\n    Some((manifest_path, sources)) => {\n      let _ = manifest_path\n      copy_source_specs(sources)\n    },\n    None =>\n      match load_persistent_sources_cache_if_valid(entry_path) {\n        Some(sources) => sources,\n        None => {\n          match try_collect_manifest_sources_fs(entry_path) {\n            Some((manifest_path, sources)) => {\n              store_persistent_sources_cache(entry_path, Some(manifest_path), sources)\n              sources\n            },\n            None => {\n              match try_load_manifest_rows(entry_path) {\n                Some((base_dir, rows)) => {\n                  let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n                  let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n                  store_persistent_sources_cache(entry_path, Some(manifest_path), preloaded_sources)\n                  preloaded_sources\n                },\n                None => {\n                  let sources = array_empty()\n                  let visited = path_set_new()\n                  collect_sources_rec(entry_path, sources, visited)\n                  store_persistent_sources_cache(entry_path, None, sources)\n                  sources\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}\n\n// #740: the grouped merge (db_grouped_merged_source) treats the LAST\n// flattened source as the export-rename plan entry — its exports stay\n// UNRENAMED. Manifest collection returns sources in MANIFEST ROW ORDER, so a\n// manifest-listed entry that is not the last needed row left some LATER dep\n// exempt from renames instead of the entry: callers were rewritten to that\n// dep's `_exp_<path>` names whose defs were never emitted (\"undefined\n// variable (local): ripple_get_fingerprint_exp_...\" when FS-compiling\n// runtime/typecheck_fs.vibe, row 152, whose ripple deps sit at rows 150-151).\n// Centralized here (rather than in each collection branch) so groups\n// reconstructed from PERSISTENT CACHES get the same ordering guarantee.\n// No-op when the entry is already last (the plain recursive walk).\nfn move_entry_last_grouped(groups: Array[(String, Array[(String, String)])], entry_path: String) -> Array[(String, Array[(String, String)])] {\n  let glen = Array::length(groups)\n  let mut total = 0\n  let mut gi = 0\n  while gi < glen {\n    let (_, gsources) = Array::get(groups, gi)\n    total = total + Array::length(gsources)\n    gi = gi + 1\n  }\n  let mut seen = 0\n  let mut entry_is_last = false\n  let mut entry_found = false\n  let mut entry_source = \"\"\n  gi = 0\n  while gi < glen {\n    let (_, gsources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(gsources) {\n      seen = seen + 1\n      let (spath, stext) = Array::get(gsources, si)\n      if spath == entry_path {\n        entry_found = true\n        entry_source = stext\n        if seen == total {\n          entry_is_last = true\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  if !entry_found || entry_is_last {\n    groups\n  } else {\n    let out = empty_grouped_sources()\n    gi = 0\n    while gi < glen {\n      let (gname, gsources) = Array::get(groups, gi)\n      let mut si = 0\n      while si < Array::length(gsources) {\n        let (spath, stext) = Array::get(gsources, si)\n        if spath == entry_path {\n          ()\n        } else {\n          push_grouped_source(out, gname, spath, stext)\n        }\n        si = si + 1\n      }\n      gi = gi + 1\n    }\n    push_grouped_source(out, \"entry_last\", entry_path, entry_source)\n    out\n  }\n}\n\nexport fn collect_source_groups_fs(entry_path: String) -> Array[(String, Array[(String, String)])] with { Error, Fs } {\n  if String::ends_with(entry_path, \".vibex\") {\n    ensure_regular_source_fs(entry_path)\n    validate_vibex_entry_source(entry_path, Fs::read_file(entry_path))\n  } else {\n    ()\n  }\n  let collected = match special_manifest_source_groups(entry_path) {\n    Some((manifest_path, groups)) => {\n      let _ = manifest_path\n      copy_grouped_sources(groups)\n    },\n    None =>\n      match load_persistent_source_groups_cache_if_valid(entry_path) {\n        Some(groups) => groups,\n        None =>\n          match load_persistent_source_groups_from_source_list_cache_if_valid(entry_path) {\n            Some((manifest_path, groups)) => {\n              store_persistent_source_groups_cache(entry_path, manifest_path, groups)\n              groups\n            },\n            None =>\n              match try_collect_manifest_source_groups_fs(entry_path) {\n                Some((manifest_path, groups)) => {\n                  store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)\n                  groups\n                },\n                None =>\n                  match try_load_manifest_rows(entry_path) {\n                    Some((base_dir, rows)) => {\n                      let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n                      let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n                      let groups = empty_grouped_sources()\n                      let mut j = 0\n                      while j < Array::length(rows) {\n                        let (group_name, rel_path) = Array::get(rows, j)\n                        let path = join_path(base_dir, rel_path)\n                        let mut found = \"\"\n                        let mut k = 0\n                        while k < Array::length(preloaded_sources) {\n                          if found == \"\" {\n                            let (source_path, source_text) = Array::get(preloaded_sources, k)\n                            if source_path == path {\n                              found = source_text\n                            }\n                          }\n                          k = k + 1\n                        }\n                        if found == \"\" {\n                          ()\n                        } else {\n                          push_grouped_source(groups, group_name, path, found)\n                        }\n                        j = j + 1\n                      }\n                      store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)\n                      groups\n                    },\n                    None => {\n                      let groups = empty_grouped_sources()\n                      let recursive_sources = collect_all_sources_fs(entry_path)\n                      Array::push(groups, (\"recursive\", recursive_sources))\n                      store_persistent_source_groups_cache(entry_path, None, groups)\n                      groups\n                    }\n                  }\n              }\n          }\n      }\n  }\n  move_entry_last_grouped(ingest_grouped_sources_fs(collected), entry_path)\n}\n\n//# Module bundling — merge stmts from all modules in dependency order\n\n// Given all sources (in dependency order), parse and merge their statements.\n// Skips SImport, SReExport (already resolved). Keeps all definitions.\nexport fn collect_merged_stmts(sources: Array[(String, String)]) -> Array[Stmt] with { Error } {\n  let merged = array_empty()\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (_, src) = Array::get(sources, si)\n    // Use lex+parse_program directly (skip resolve_interp_stmt to reduce heap pressure)\n    let stmts = parse_program(lex(src))\n    let mut j = 0\n    while j < Array::length(stmts) {\n      let stmt = Array::get(stmts, j)\n      match stmt {\n        SImport(_, _) => (),\n        SReExport(_, _) => (),\n        SAliasDecl(_, _) => (),\n        _ => Array::push(merged, stmt)\n      }\n      j = j + 1\n    }\n    si = si + 1\n  }\n  merged\n}\n\n// #847-style trap-free directory probe (see loader/header_cache.vibe's\n// fs_is_directory for the full rationale): `Fs::readdir` TRAPS the whole\n// wasm instance on a non-directory, so a real directory test is required\n// before ever calling it speculatively. Appending \"/.\" and testing with\n// `Fs::exists` is safe on the frozen bootstrap seed (predates `Fs::is_dir`).\nfn vpkg_scan_is_directory(path: String) -> Bool with { Fs } {\n  Fs::exists(String::concat(path, \"/.\"))\n}\n\n// #897 (ADR-0070): directories this scan skips entirely -- not source, or\n// not part of this repo's own migration surface (vendored/fetched content,\n// build output, VCS metadata). Anything starting with \".\" already covers\n// `.git`/`.vibe` (the content-addressed store lives under `.vibe/store/`).\nfn vpkg_scan_skip_dir(name: String) -> Bool {\n  (String::length(name) > 0 && String::char_code_at(name, 0) == '.') || name == \"_build\" || name == \"node_modules\" || name == \"target\" || name == \"deps\"\n}\n\n// #897 (ADR-0070): recurse into every non-skipped directory under `root`,\n// recording any directory that has `index.vibei` or plain `index.vibe` but\n// NOT YET `index.vpkg` -- exactly the 76-directory migration surface ADR-\n// 0070 counts. A directory with none of the three index files is not a\n// package boundary and is out of scope. Unlike contract_sibling_impl_raws_\n// rec (which stops at a nested boundary because its job is to list PLAIN\n// impl files), this must recurse THROUGH boundaries too, since nested\n// sub-packages are themselves part of the migration surface.\nfn vpkg_scan_rec(dir: String, out: Array[String]) -> Unit with { Error, Fs } {\n  let has_vpkg = Fs::exists(String::concat(dir, \"/index.vpkg\"))\n  let has_vibei = Fs::exists(String::concat(dir, \"/index.vibei\"))\n  let has_vibe = Fs::exists(String::concat(dir, \"/index.vibe\"))\n  if !has_vpkg && (has_vibei || has_vibe) {\n    Array::push(out, dir)\n  } else {\n    ()\n  }\n  let names = Fs::readdir(dir)\n  let mut i = 0\n  while i < Array::length(names) {\n    let name = Array::get(names, i)\n    if !vpkg_scan_skip_dir(name) {\n      let full = String::concat(dir, String::concat(\"/\", name))\n      if vpkg_scan_is_directory(full) {\n        vpkg_scan_rec(full, out)\n      } else {\n        ()\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n}\n\n// find_missing_vpkg_dirs: (String) -> Array[String] with { Error, Fs }\nexport fn find_missing_vpkg_dirs(root: String) -> Array[String] with { Error, Fs } {\n  let out = array_empty()\n  vpkg_scan_rec(root, out)\n  out\n}\n\n// check_missing_vpkg_dirs: (String) -> Int with { Error, Fs }\n// #897/ADR-0070: `vibe check --missing-vpkg <root>` diagnostic. Reports (via\n// throw, matching every other `vibe check` diagnostic's error-surfacing\n// convention) every directory under `root` still on the old `index.vibei`\n// or bare `index.vibe` spelling, so the migration's remaining scope is a\n// single command away instead of manual auditing.\nexport fn check_missing_vpkg_dirs(root: String) -> Int with { Error, Fs } {\n  let missing = find_missing_vpkg_dirs(root)\n  if Array::length(missing) == 0 {\n    0\n  } else {\n    throw(String::concat(\"missing index.vpkg (#897) in: \", String::join(missing, \", \")))\n  }\n}\n")
}

let cli_adapter_source_208 = () -> (String, String) {
  ("lib/@vibe/compiler/normalize/index.vpkg",
"version 0.0.1\n\n// @vibe/compiler/normalize — the `vibe normalize` canonicalizing source\n// transform (parse -> module flatten -> DCE -> categorize -> re-render), plus\n// the two RC-enabling pure AST rewrites codegen runs before building each\n// function's Perceus plan: lift_match_scrutinees (#703/#708) and\n// uniquify_shadowed_bindings (#712/#715). First COMPILER-INTERNAL contract\n// batch (ADR-0070 Phase 3, #897) — unlike the stdlib batches, this package\n// is compiled into the compiler itself via compiler_sources_manifest.tsv\n// (group `normalize`, dual-row: this contract + normalize.vibe).\n//\n// The old index.vibe was not a facade but the whole implementation (the\n// package is single-file), so it moved verbatim to normalize.vibe and this\n// contract declares its four exported fns. No exported types, no `version`\n// binding existed (compiler-internal package — nothing to preserve, unlike\n// the PR #914 stdlib precedent), so the surface is fns only. Signature\n// types (Stmt/Expr from ../core) are structural signature text resolved\n// against the implementation import when the facade is merged in — same\n// precedent as @vibe/symbol / @vibe/parser (no re-import needed here).\n\nfn normalize_stmts(stmts: Array[Stmt]) -> Array[Stmt]\nfn normalize_source(src: String) -> String with { Error }\nfn lift_match_scrutinees(expr: Expr, counter: Array[Int]) -> Expr\nfn uniquify_shadowed_bindings(expr: Expr, env: Map[String, String], counter: Array[Int], seen: Array[String]) -> Expr\n")
}

let cli_adapter_source_209 = () -> (String, String) {
  ("lib/@vibe/compiler/normalize/normalize.vibe",
"//# `vibe normalize` engine (vertical slice, #594)\n//#\n//# A canonicalizing source transform built on the compiler's own AST. The first\n//# slice implements the structural pipeline:\n//#\n//#   parse -> flatten modules (`module m { let f }` => `let m::f`)\n//#         -> dead-code elimination from exported roots\n//#         -> drop redundant aggregate `export { .. }` statements\n//#         -> categorize into Imports / Types / Functions / Tests sections\n//#         -> render via the AST printer with section headers + blank lines\n//#\n//# Deferred to follow-ups (the host engine is ~6.6k lines): inline/const fold,\n//# inferred type annotations, decl-separator / labeled-arg quickfixes, and\n//# semver dependency `latest` resolution.\n\n//# Imports\n\nimport @vibe/compiler/contract {\n  extract_require_pins\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/syntax {\n  Token, lex, parse_program_preserving, print_stmt\n}\n\nimport @vibe/compiler/core {\n  Stmt, TypeExpr, Expr, Pat, dce_stmts, rewrite_import_alias_expr\n}\n\n//# Module flattening\n\nfn empty_stmts() -> Array[Stmt] {\n  array_empty()\n}\n\nfn empty_strs() -> Array[String] {\n  array_empty()\n}\n\n// Prefix a binding name with the enclosing module path (`math` + `helper` =>\n// `math::helper`). Empty prefix leaves the name unchanged.\nfn join_module_name(prefix: String, name: String) -> String {\n  if prefix == \"\" {\n    name\n  } else {\n    String::concat(prefix, String::concat(\"::\", name))\n  }\n}\n\n// Alias map (short name -> `prefix::name`) for the value members of a module\n// body, so intra-module references can be qualified to match the renamed decls.\nfn module_value_aliases(body: Array[Stmt], prefix: String, out: Array[(String, String)]) -> Int {\n  let mut i = 0\n  while i < Array::length(body) {\n    match Array::get(body, i) {\n      SLet(_, _, name, _, _) => {\n        Array::push(out, (name, join_module_name(prefix, name)))\n        0\n      },\n      SLetMut(name, _, _) => {\n        Array::push(out, (name, join_module_name(prefix, name)))\n        0\n      },\n      SExternLet(name, _) => {\n        Array::push(out, (name, join_module_name(prefix, name)))\n        0\n      },\n      SModule(_, inner, inner_body) => {\n        let _ = module_value_aliases(inner_body, join_module_name(prefix, inner), out)\n        0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  0\n}\n\n// Flatten a (DCE'd) module body to top-level decls: rename each value binding to\n// `prefix::name` AND qualify intra-module value references in its body, so the\n// flattened source typechecks without the enclosing module scope (a sibling call\n// `helper()` becomes `m::helper()`, matching the renamed `let m::helper`).\nfn flatten_module_body(body: Array[Stmt], prefix: String, aliases: Array[(String, String)], out: Array[Stmt]) -> Int {\n  let mut i = 0\n  while i < Array::length(body) {\n    match Array::get(body, i) {\n      SLet(exp, is_rec, name, ty, b) => {\n        Array::push(out, SLet(exp, is_rec, join_module_name(prefix, name), ty, rewrite_import_alias_expr(b, aliases)))\n        0\n      },\n      SLetMut(name, ty, b) => {\n        Array::push(out, SLetMut(join_module_name(prefix, name), ty, rewrite_import_alias_expr(b, aliases)))\n        0\n      },\n      SExternLet(name, ty) => {\n        Array::push(out, SExternLet(join_module_name(prefix, name), ty))\n        0\n      },\n      SModule(_, inner, inner_body) => {\n        let _ = flatten_module_body(inner_body, join_module_name(prefix, inner), aliases, out)\n        0\n      },\n      other => {\n        Array::push(out, other)\n        0\n      }\n    }\n    i = i + 1\n  }\n  0\n}\n\nfn is_module_stmt(stmt: Stmt) -> Bool {\n  match stmt {\n    SModule(_, _, _) => true,\n    _ => false\n  }\n}\n\n//# Exported roots for DCE\n\n// Roots for top-level DCE: exported value bindings, plus any already\n// module-qualified binding (a `m::f` name). Flattening renames a kept module\n// member to `m::f` while leaving its body referencing the short `f`, so a\n// second normalize pass must not drop those by name — keeping all `::` names\n// (module members are live by construction) makes normalize idempotent.\nfn exported_value_names(stmts: Array[Stmt]) -> Array[String] {\n  let roots = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, _, name, _, _) => if exp || String::contains(name, \"::\") {\n        Array::push(roots, name)\n      },\n      // Preserved fn decl (ADR-0064 #727): same root rule as SLet.\n      SFnDecl(exp, name, _, _, _) => if exp || String::contains(name, \"::\") {\n        Array::push(roots, name)\n      },\n      SLetMut(name, _, _) => if String::contains(name, \"::\") {\n        Array::push(roots, name)\n      },\n      // Aggregate `export { a, b }` also marks an exported API; without this a\n      // file whose only export is `export { run }` would DCE everything away.\n      SExport(names) => {\n        let mut j = 0\n        while j < Array::length(names) {\n          Array::push(roots, Array::get(names, j))\n          j = j + 1\n        }\n        0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  roots\n}\n\n// Names that an aggregate `export { .. }` re-exports (the renderer drops the\n// `SExport` statement, so the underlying bindings must be promoted to keep the\n// public API).\nfn aggregate_export_names(stmts: Array[Stmt]) -> Array[String] {\n  let names = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SExport(exported) => {\n        let mut j = 0\n        while j < Array::length(exported) {\n          Array::push(names, Array::get(exported, j))\n          j = j + 1\n        }\n        0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  names\n}\n\nfn str_array_has(arr: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) && !found {\n    if Array::get(arr, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nfn promote_aggregate_exports(stmts: Array[Stmt], agg: Array[String]) -> Array[Stmt] {\n  let result = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    let promoted = match stmt {\n      SLet(exp, is_rec, name, ty, body) => if !exp && str_array_has(agg, name) {\n        SLet(true, is_rec, name, ty, body)\n      } else {\n        stmt\n      },\n      SFnDecl(exp, name, fn_value, reqs, enss) => if !exp && str_array_has(agg, name) {\n        SFnDecl(true, name, fn_value, reqs, enss)\n      } else {\n        stmt\n      },\n      _ => stmt\n    }\n    Array::push(result, promoted)\n    i = i + 1\n  }\n  result\n}\n\n//# Type-alias DCE: drop non-exported aliases whose name is never referenced.\n\nfn collect_type_names_into(ty: TypeExpr, out: Array[String]) -> Int {\n  match ty {\n    TyName(n) => {\n      Array::push(out, n)\n      0\n    },\n    TyApp(n, args) => {\n      Array::push(out, n)\n      let mut i = 0\n      while i < Array::length(args) {\n        let _ = collect_type_names_into(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    TyFn(params, ret, _) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let _ = collect_type_names_into(Array::get(params, i), out)\n        i = i + 1\n      }\n      let _ = collect_type_names_into(ret, out)\n      0\n    },\n    TyTuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        let _ = collect_type_names_into(Array::get(items, i), out)\n        i = i + 1\n      }\n      0\n    },\n    TyUnit => 0\n  }\n}\n\nfn collect_opt_type_into(ty_opt: Option[TypeExpr], out: Array[String]) -> Int {\n  match ty_opt {\n    Some(ty) => collect_type_names_into(ty, out),\n    None => 0\n  }\n}\n\n// Collect every type-name referenced by a statement.\nfn collect_stmt_type_refs_into(stmt: Stmt, out: Array[String]) -> Int {\n  match stmt {\n    SLet(_, _, _, ty, _) => collect_opt_type_into(ty, out),\n    // Preserved fn decl: its types live on the EFn params/return (there is\n    // no let-annotation), so collect them there — otherwise a type alias\n    // referenced only by an fn signature would be dropped as unused.\n    SFnDecl(_, _, fn_value, _, _) => match fn_value {\n      EFn(_, _, params, ret_opt, _, _) => {\n        let mut fpi = 0\n        while fpi < Array::length(params) {\n          let (_, pty) = Array::get(params, fpi)\n          let _ = collect_opt_type_into(pty, out)\n          fpi = fpi + 1\n        }\n        collect_opt_type_into(ret_opt, out)\n      },\n      _ => 0\n    },\n    SLetMut(_, ty, _) => collect_opt_type_into(ty, out),\n    SExternLet(_, ty) => collect_type_names_into(ty, out),\n    STypeAlias(_, _, _, rhs) => collect_type_names_into(rhs, out),\n    SStruct(_, _, fields, _, _, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fty) = Array::get(fields, i)\n        let _ = collect_type_names_into(fty, out)\n        i = i + 1\n      }\n      0\n    },\n    SEnum(_, _, _, ctors, _) => {\n      let mut i = 0\n      while i < Array::length(ctors) {\n        let (_, args) = Array::get(ctors, i)\n        let mut j = 0\n        while j < Array::length(args) {\n          let _ = collect_type_names_into(Array::get(args, j), out)\n          j = j + 1\n        }\n        i = i + 1\n      }\n      0\n    },\n    SImpl(_, _, _, type_name) => {\n      Array::push(out, type_name)\n      0\n    },\n    _ => 0\n  }\n}\n\n\nfn drop_unused_type_aliases(stmts: Array[Stmt]) -> Array[Stmt] {\n  let referenced = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let _ = collect_stmt_type_refs_into(Array::get(stmts, i), referenced)\n    i = i + 1\n  }\n  let result = empty_stmts()\n  let mut k = 0\n  while k < Array::length(stmts) {\n    let stmt = Array::get(stmts, k)\n    let keep = match stmt {\n      STypeAlias(exp, name, _, _) => exp || str_array_has(referenced, name),\n      _ => true\n    }\n    if keep {\n      Array::push(result, stmt)\n    }\n    k = k + 1\n  }\n  result\n}\n\n//# Categorize + render\n\n// 0 = import, 1 = type/structural, 2 = function/value, 3 = test/bench,\n// 9 = drop (aggregate export / bare expression).\nfn stmt_section(stmt: Stmt) -> Int {\n  match stmt {\n    SImport(_, _) => 0,\n    SReExport(_, _) => 0,\n    SAliasDecl(_, _) => 0,\n    SEnum(_, _, _, _, _) => 1,\n    SSuberror(_, _, _) => 1,\n    SStruct(_, _, _, _, _, _) => 1,\n    STypeAlias(_, _, _, _) => 1,\n    STrait(_, _, _, _, _) => 1,\n    SImpl(_, _, _, _) => 1,\n    SEffectDef(_, _, _, _) => 1,\n    SExternLet(_, _) => 1,\n    SLet(_, _, _, _, _) => 2,\n    SFnDecl(_, _, _, _, _) => 2,\n    SLetMut(_, _, _) => 2,\n    SLetPat(_, _) => 2,\n    STest(_, _) => 3,\n    SBench(_, _) => 3,\n    SExport(_) => 9,\n    SExpr(_) => 9,\n    _ => 9\n  }\n}\n\nfn section_header(section: Int) -> String {\n  if section == 0 {\n    \"//# Imports\"\n  } else if section == 1 {\n    \"//# Types\"\n  } else if section == 2 {\n    \"//# Functions\"\n  } else {\n    \"//# Tests\"\n  }\n}\n\n// Render all statements in one section (already filtered) joined by blank lines,\n// prefixed by the section header. Returns \"\" when the section is empty.\nfn render_section(stmts: Array[Stmt], section: Int) -> String {\n  let parts = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if stmt_section(stmt) == section {\n      Array::push(parts, print_stmt(stmt))\n    }\n    i = i + 1\n  }\n  if Array::length(parts) == 0 {\n    \"\"\n  } else {\n    let body = String::join(parts, \"\\n\\n\")\n    String::concat(section_header(section), String::concat(\"\\n\\n\", body))\n  }\n}\n\n//# Lambda-annotation hoisting\n\nfn normalize_empty_type_exprs() -> Array[TypeExpr] {\n  array_empty()\n}\n\nfn all_params_typed(params: Array[(String, Option[TypeExpr])]) -> Bool {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(params) {\n    let (_, ty_opt) = Array::get(params, i)\n    match ty_opt {\n      Some(_) => 0,\n      None => {\n        ok = false\n        0\n      }\n    }\n    i = i + 1\n  }\n  ok\n}\n\nfn param_type_list(params: Array[(String, Option[TypeExpr])]) -> Array[TypeExpr] {\n  let out = normalize_empty_type_exprs()\n  let mut i = 0\n  while i < Array::length(params) {\n    let (_, ty_opt) = Array::get(params, i)\n    match ty_opt {\n      Some(ty) => Array::push(out, ty),\n      None => 0\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn strip_param_types(params: Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(params) {\n    let (name, _) = Array::get(params, i)\n    Array::push(out, (name, None))\n    i = i + 1\n  }\n  out\n}\n\n// Canonicalize an old-syntax lambda binding `let f = (x: T) -> R { body }` to\n// the annotated form `let f: (T) -> R = (x) -> { body }`: move the parameter\n// types + return type into a `TyFn` let-annotation and strip them from the\n// lambda. Only when the let has no annotation yet, the value is a return-type\n// annotated lambda, and every parameter carries a type (full type recoverable).\nfn hoist_lambda_let(stmt: Stmt) -> Stmt {\n  match stmt {\n    SLet(exp, is_rec, name, ty, value) => match ty {\n      Some(_) => stmt,\n      None => match value {\n        EFn(type_params, bounds, params, ret_opt, effect, body) => match ret_opt {\n          None => stmt,\n          // Skip generic lambdas: their `[T]` type params scope the lambda, not\n          // the let annotation, so hoisting `[T](x: T) -> T` to `: (T) -> T =\n          // [T](x) -> {...}` would leave `T` unbound in the annotation and the\n          // normalized output would not compile.\n          Some(ret_ty) => if Array::length(type_params) == 0 && all_params_typed(params) {\n            SLet(exp, is_rec, name, Some(TyFn(param_type_list(params), ret_ty, effect)), EFn(type_params, bounds, strip_param_types(params), None, None, body))\n          } else {\n            stmt\n          }\n        },\n        _ => stmt\n      }\n    },\n    _ => stmt\n  }\n}\n\nfn hoist_lambda_lets(stmts: Array[Stmt]) -> Array[Stmt] {\n  let out = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::push(out, hoist_lambda_let(Array::get(stmts, i)))\n    i = i + 1\n  }\n  out\n}\n\n//# Constant folding\n\n// Fold a binary op on two int literals. Only the closed arithmetic ops `+ - *`,\n// which are total and wrap identically at compile time and runtime (both use\n// 62-bit Int), so folding is semantics-preserving. `/` and `%` are skipped\n// (a literal `x / 0` must keep trapping at runtime, not at fold time).\nfn fold_int_binop(op: String, a: Int, b: Int) -> Option[Int] {\n  if op == \"+\" {\n    Some(a + b)\n  } else if op == \"-\" {\n    Some(a - b)\n  } else if op == \"*\" {\n    Some(a * b)\n  } else {\n    None\n  }\n}\n\nfn fold_expr(expr: Expr) -> Expr {\n  match expr {\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EIdent(_, _) => expr,\n    EUnit => expr,\n    EStringInterp(_) => expr,\n    ETuple(items) => ETuple(for it in items {\n      fold_expr(it)\n    }),\n    EArray(items) => EArray(for it in items {\n      fold_expr(it)\n    }),\n    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {\n      let (n, v) = f\n      (n, fold_expr(v))\n    }, targs),\n    EIf(c, t, e) => EIf(fold_expr(c), fold_expr(t), fold_expr(e)),\n    ELet(n, v, b, soff) => ELet(n, fold_expr(v), fold_expr(b), soff),\n    ELetRec(n, v, b) => ELetRec(n, fold_expr(v), fold_expr(b)),\n    ELetMut(n, v, b, soff) => ELetMut(n, fold_expr(v), fold_expr(b), soff),\n    EAssign(n, v, b) => EAssign(n, fold_expr(v), fold_expr(b)),\n    EAssignOp(op, n, v, b) => EAssignOp(op, n, fold_expr(v), fold_expr(b)),\n    ESeq(a, b) => ESeq(fold_expr(a), fold_expr(b)),\n    EMatch(s, arms) => EMatch(fold_expr(s), for a in arms {\n      let (p, e) = a\n      (p, fold_expr(e))\n    }),\n    EHandle(s, arms) => EHandle(fold_expr(s), for a in arms {\n      let (p, e) = a\n      (p, fold_expr(e))\n    }),\n    EWhile(c, b) => EWhile(fold_expr(c), fold_expr(b)),\n    ELoop(params, b) => ELoop(for pr in params {\n      let (n, init) = pr\n      (n, fold_expr(init))\n    }, fold_expr(b)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, fold_expr(it), fold_expr(b)),\n    ECall(callee, args, off) => ECall(fold_expr(callee), for a in args {\n      fold_expr(a)\n    }, off),\n    EBinOp(op, l, r) => {\n      let fl = fold_expr(l)\n      let fr = fold_expr(r)\n      match fl {\n        EInt(a) => match fr {\n          EInt(b) => match fold_int_binop(op, a, b) {\n            Some(v) => EInt(v),\n            None => EBinOp(op, fl, fr)\n          },\n          _ => EBinOp(op, fl, fr)\n        },\n        _ => EBinOp(op, fl, fr)\n      }\n    },\n    EUnaryOp(op, e) => EUnaryOp(op, fold_expr(e)),\n    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, fold_expr(body)),\n    EDot(e, field, off, fdoff) => EDot(fold_expr(e), field, off, fdoff),\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, fold_expr(v)),\n    EReturn(e) => EReturn(fold_expr(e)),\n    EBreak(opt) => match opt {\n      Some(v) => EBreak(Some(fold_expr(v))),\n      None => EBreak(None)\n    },\n    EContinue(args) => EContinue(for a in args {\n      fold_expr(a)\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (k, v) = f\n      (k, fold_expr(v))\n    }),\n    ESpread(e) => ESpread(fold_expr(e))\n  }\n}\n\n// #703 follow-up: lift a temporary (non-variable) match scrutinee into a `let`\n// so the Perceus RC pass — which attributes drops to NAMED bindings — gives it\n// a scope-end drop. `match <e> { arms }` -> `let __m_scrut_N = <e> in match\n// __m_scrut_N { arms }` when `<e>` is not already an identifier. Without a\n// binding the fresh owned heap value the scrutinee produces (`match foo() {\n// .. }`, `match Some(x) { .. }`) is never dropped and leaks under RC.\n//\n// #708: the lift name MUST be unique per lift site (the `_N` suffix, from a\n// counter cell threaded through every recursive call). A single non-unique\n// name shared by every lift in a function is not just an RC-drop-scheduling\n// hazard (the original #708 fix) — when two lifts NEST (a match whose\n// scrutinee is itself a non-identifier match, e.g. `let (a,b) = match\n// <call> { .. }`, which the parser also desugars through a match-over-a-\n// match), the OUTER lift's own body-compile resolves the identifier by\n// searching local slots most-recent-first. Since the INNER lift (compiled\n// while evaluating the outer lift's OWN value) pushes the identical name\n// *after* the outer one, that search finds the inner (already out-of-scope)\n// binding instead of the outer one it meant to reference — reading whatever\n// unrelated heap object the inner scrutinee held (e.g. a `Token`) as if it\n// were the outer's freshly-built tuple, and misinterpreting its raw memory\n// as tuple fields. This produced garbage values (not a crash) for a `let\n// (a,b,c,d) = match <call> {..}` pattern local's fields — confirmed via a\n// minimal repro and fixed by this uniqueness change (see #708 follow-up\n// investigation notes). Modeled on fold_expr's complete walk; only the\n// EMatch case differs. EHandle is left as-is (effect handlers are not the\n// same ownership shape). Pure rewrite (aside from the counter cell) —\n// applied to each function body before build_perceus_plan so the plan and\n// codegen agree; running it on the non-RC backend would be harmless but it is\n// gated at the call site to keep that backend byte-identical.\n// #712: RC codegen's per-function bookkeeping (CompileCtx's `heap_binding_names`,\n// `rc_drop_names`, `rc_alias_dup_names`, `rc_dup_names`, `loop_borrowed_names`,\n// etc., and the Perceus plan itself) all key on the bare identifier NAME, not\n// binding identity. When an inner scope shadows an outer binding of the same\n// name (`let x = ...; { let x = ...; f(x) }`, or a `while` loop body rebinding\n// a name the loop already loop-borrows), those name-keyed lookups cannot tell\n// the two `x`s apart -- an action meant for one binding can fire at the other's\n// site instead (spurious/missing rc_dup, premature/missing rc_drop).\n//\n// Rather than retrofit every name-keyed consumer with binding identity (a\n// larger, more invasive change -- see #712), this eliminates the ambiguity at\n// the source: alpha-rename every binding that shadows an enclosing one to a\n// fresh, globally-unique name before the Perceus plan is built, so no two live\n// bindings in one function ever share a name. Modeled on lift_match_scrutinees\n// (#708) -- same shared-counter-cell technique for uniqueness, same complete\n// per-Expr-variant walk. Unshadowed bindings (the vast majority) are left with\n// their original name (so debugging/argument-inspection output is unaffected\n// outside the rare shadowing case). Pure rewrite; gated at the call site to\n// keep the non-RC backend byte-identical.\nfn fresh_shadow_name(counter: Array[Int], name: String) -> String {\n  let n = Array::get(counter, 0)\n  Array::set(counter, 0, n + 1)\n  String::concat(String::concat(\"__shadow_\", __to_string(n)), String::concat(\"_\", name))\n}\n\n// Renamed reference for `name` under `env`, or `name` unchanged if it is not a\n// tracked (shadowed-or-not) binding -- i.e. a free variable / global / builtin.\nfn uq_lookup(env: Map[String, String], name: String) -> String {\n  if Map::has_key(env, name) {\n    Map::get(env, name)\n  } else {\n    name\n  }\n}\n\n// #715: has `name` been bound ANYWHERE in this function already (including a\n// sibling scope that has since closed)? `seen` is a shared mutable array, one\n// per top-level function, appended by uq_bind_name's first-binder path.\nfn uq_seen_contains(seen: Array[String], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(seen) {\n    if Array::get(seen, i) == name {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// Introduce binding `name` into `env`. If `name` is already tracked (bound by\n// an enclosing scope, shadowed or not), this occurrence shadows it: mint a\n// fresh unique name and map `name` to it for the extent of the inner scope.\n//\n// #715: ALSO rename when `name` was bound anywhere EARLIER in this same\n// function, even in an already-closed sibling scope (two match arms both\n// declaring `let resolved = ...`). The Perceus plan's actions and codegen's\n// bookkeeping (rc_drop_names / rc_dup_names / heap_binding_names) are flat,\n// name-keyed, whole-function lists, so two same-named sibling bindings\n// receive each other's planned dups/drops -- confirmed as the #715 checker\n// crash: check_expr declares `let resolved` in four sibling scopes; a\n// scope-end PaDrop planned for one fired at another whose reference had\n// already been consumed through resolve_tparams_in, freeing the block a\n// still-live tuple pointed at (use-after-free at the `pt` destructure dup).\n//\n// Otherwise this is the first binder for `name` in this function; keep it\n// as-is but still record the identity mapping, so a DEEPER shadow of the same\n// name is detected against this occurrence.\nfn uq_bind_name(name: String, env: Map[String, String], counter: Array[Int], seen: Array[String]) -> (String, Map[String, String]) {\n  // A labeled/optional param (`a~`/`a?`) is declared with its suffix but its\n  // body references use the STRIPPED name, so this env (keyed by the declared\n  // name) never rewrites those references anyway -- renaming the declaration\n  // alone would orphan them. Leave such params untouched (status quo).\n  let nlen = String::length(name)\n  let lastc = if nlen > 0 {\n    String::char_code_at(name, nlen - 1)\n  } else {\n    0\n  }\n  if lastc == '~' || lastc == '?' {\n    (name, env)\n  } else if Map::has_key(env, name) || uq_seen_contains(seen, name) {\n    let fresh = fresh_shadow_name(counter, name)\n    (fresh, Map::set(env, name, fresh))\n  } else {\n    Array::push(seen, name)\n    (name, Map::set(env, name, name))\n  }\n}\n\nfn uq_pat_names(pat: Pat, out: Array[String]) -> Unit {\n  match pat {\n    PBind(name) => Array::push(out, name),\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        uq_pat_names(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        uq_pat_names(Array::get(pats, i), out)\n        i = i + 1\n      }\n    },\n    POr(l, _r) => uq_pat_names(l, out),\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        uq_pat_names(fp, out)\n        i = i + 1\n      }\n    },\n    PInt(_) => (),\n    PFloat(_) => (),\n    PString(_) => (),\n    PBool(_) => (),\n    PWild => ()\n  }\n}\n\nfn uq_pat_rewrite(pat: Pat, env: Map[String, String]) -> Pat {\n  match pat {\n    PBind(name) => PBind(uq_lookup(env, name)),\n    PCtor(name, args) => PCtor(name, for a in args {\n      uq_pat_rewrite(a, env)\n    }),\n    PTuple(pats) => PTuple(for a in pats {\n      uq_pat_rewrite(a, env)\n    }),\n    POr(l, r) => POr(uq_pat_rewrite(l, env), uq_pat_rewrite(r, env)),\n    PStruct(name, fields) => PStruct(name, for f in fields {\n      let (fname, fp) = f\n      (fname, uq_pat_rewrite(fp, env))\n    }),\n    _ => pat\n  }\n}\n\n// Binds every name in `pat` (shadow-checked against `env`) and returns the\n// rewritten pattern together with the extended env for the pattern's own\n// scope (the arm body).\nfn uq_bind_pat(pat: Pat, env: Map[String, String], counter: Array[Int], seen: Array[String]) -> (Pat, Map[String, String]) {\n  let names: Array[String] = [\n  ]\n  uq_pat_names(pat, names)\n  let mut env2 = env\n  let mut i = 0\n  while i < Array::length(names) {\n    let (_, env3) = uq_bind_name(Array::get(names, i), env2, counter, seen)\n    env2 = env3\n    i = i + 1\n  }\n  (uq_pat_rewrite(pat, env2), env2)\n}\n\nexport fn uniquify_shadowed_bindings(expr: Expr, env: Map[String, String], counter: Array[Int], seen: Array[String]) -> Expr {\n  match expr {\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EIdent(name, off) => EIdent(uq_lookup(env, name), off),\n    EUnit => expr,\n    EStringInterp(_) => expr,\n    ETuple(items) => ETuple(for it in items {\n      uniquify_shadowed_bindings(it, env, counter, seen)\n    }),\n    EArray(items) => EArray(for it in items {\n      uniquify_shadowed_bindings(it, env, counter, seen)\n    }),\n    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {\n      let (n, v) = f\n      (n, uniquify_shadowed_bindings(v, env, counter, seen))\n    }, targs),\n    EIf(c, t, e) => EIf(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(t, env, counter, seen), uniquify_shadowed_bindings(e, env, counter, seen)),\n    ELet(n, v, b, soff) => {\n      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      ELet(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen), soff)\n    },\n    ELetRec(n, v, b) => {\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      let v2 = uniquify_shadowed_bindings(v, env2, counter, seen)\n      ELetRec(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))\n    },\n    ELetMut(n, v, b, soff) => {\n      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      ELetMut(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen), soff)\n    },\n    EAssign(n, v, b) => EAssign(uq_lookup(env, n), uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    EAssignOp(n, op, v, b) => EAssignOp(uq_lookup(env, n), op, uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    ESeq(a, b) => ESeq(uniquify_shadowed_bindings(a, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    EMatch(s, arms) => EMatch(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {\n      let (p, e) = a\n      let (p2, env2) = uq_bind_pat(p, env, counter, seen)\n      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))\n    }),\n    EHandle(s, arms) => EHandle(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {\n      let (p, e) = a\n      let (p2, env2) = uq_bind_pat(p, env, counter, seen)\n      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))\n    }),\n    EWhile(c, b) => EWhile(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    ELoop(params, b) => {\n      let mut env2 = env\n      let zipped: Array[(String, Expr)] = [\n      ]\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pn, init) = Array::get(params, pi)\n        let init2 = uniquify_shadowed_bindings(init, env, counter, seen)\n        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)\n        env2 = envN\n        Array::push(zipped, (pn2, init2))\n        pi = pi + 1\n      }\n      ELoop(zipped, uniquify_shadowed_bindings(b, env2, counter, seen))\n    },\n    EForIn(n, idx, it, b) => {\n      let it2 = uniquify_shadowed_bindings(it, env, counter, seen)\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      let (idx2, env3) = match idx {\n        Some(iname) => {\n          let (iname2, envI) = uq_bind_name(iname, env2, counter, seen)\n          (Some(iname2), envI)\n        },\n        None => (None, env2)\n      }\n      EForIn(n2, idx2, it2, uniquify_shadowed_bindings(b, env3, counter, seen))\n    },\n    ECall(callee, args, off) => ECall(uniquify_shadowed_bindings(callee, env, counter, seen), for a in args {\n      uniquify_shadowed_bindings(a, env, counter, seen)\n    }, off),\n    EBinOp(op, l, r) => EBinOp(op, uniquify_shadowed_bindings(l, env, counter, seen), uniquify_shadowed_bindings(r, env, counter, seen)),\n    EUnaryOp(op, e) => EUnaryOp(op, uniquify_shadowed_bindings(e, env, counter, seen)),\n    EFn(tp, bounds, params, ret, eff, body) => {\n      let mut env2 = env\n      let params2: Array[(String, Option[TypeExpr])] = [\n      ]\n      let mut fi = 0\n      while fi < Array::length(params) {\n        let (pn, pty) = Array::get(params, fi)\n        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)\n        env2 = envN\n        Array::push(params2, (pn2, pty))\n        fi = fi + 1\n      }\n      EFn(tp, bounds, params2, ret, eff, uniquify_shadowed_bindings(body, env2, counter, seen))\n    },\n    EDot(e, field, off, fdoff) => EDot(uniquify_shadowed_bindings(e, env, counter, seen), field, off, fdoff),\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, uniquify_shadowed_bindings(v, env, counter, seen)),\n    EReturn(e) => EReturn(uniquify_shadowed_bindings(e, env, counter, seen)),\n    EBreak(opt) => match opt {\n      Some(v) => EBreak(Some(uniquify_shadowed_bindings(v, env, counter, seen))),\n      None => EBreak(None)\n    },\n    EContinue(args) => EContinue(for a in args {\n      uniquify_shadowed_bindings(a, env, counter, seen)\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (k, v) = f\n      (k, uniquify_shadowed_bindings(v, env, counter, seen))\n    }),\n    ESpread(e) => ESpread(uniquify_shadowed_bindings(e, env, counter, seen))\n  }\n}\n\nfn fresh_m_scrut_name(counter: Array[Int]) -> String {\n  let n = Array::get(counter, 0)\n  Array::set(counter, 0, n + 1)\n  String::concat(\"__m_scrut_\", __to_string(n))\n}\n\nexport fn lift_match_scrutinees(expr: Expr, counter: Array[Int]) -> Expr {\n  match expr {\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EIdent(_, _) => expr,\n    EUnit => expr,\n    EStringInterp(_) => expr,\n    ETuple(items) => ETuple(for it in items {\n      lift_match_scrutinees(it, counter)\n    }),\n    EArray(items) => EArray(for it in items {\n      lift_match_scrutinees(it, counter)\n    }),\n    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {\n      let (n, v) = f\n      (n, lift_match_scrutinees(v, counter))\n    }, targs),\n    EIf(c, t, e) => EIf(lift_match_scrutinees(c, counter), lift_match_scrutinees(t, counter), lift_match_scrutinees(e, counter)),\n    ELet(n, v, b, soff) => ELet(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter), soff),\n    ELetRec(n, v, b) => ELetRec(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    ELetMut(n, v, b, soff) => ELetMut(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter), soff),\n    EAssign(n, v, b) => EAssign(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    EAssignOp(op, n, v, b) => EAssignOp(op, n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    ESeq(a, b) => ESeq(lift_match_scrutinees(a, counter), lift_match_scrutinees(b, counter)),\n    EMatch(s, arms) => {\n      let lifted_arms = for a in arms {\n        let (p, e) = a\n        (p, lift_match_scrutinees(e, counter))\n      }\n      let ls = lift_match_scrutinees(s, counter)\n      match ls {\n        EIdent(_, _) => EMatch(ls, lifted_arms),\n        _ => {\n          let fresh = fresh_m_scrut_name(counter)\n          ELet(fresh, ls, EMatch(EIdent(fresh, -1), lifted_arms), -1)\n        }\n      }\n    },\n    EHandle(s, arms) => EHandle(lift_match_scrutinees(s, counter), for a in arms {\n      let (p, e) = a\n      (p, lift_match_scrutinees(e, counter))\n    }),\n    EWhile(c, b) => EWhile(lift_match_scrutinees(c, counter), lift_match_scrutinees(b, counter)),\n    ELoop(params, b) => ELoop(for pr in params {\n      let (n, init) = pr\n      (n, lift_match_scrutinees(init, counter))\n    }, lift_match_scrutinees(b, counter)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, lift_match_scrutinees(it, counter), lift_match_scrutinees(b, counter)),\n    ECall(callee, args, off) => ECall(lift_match_scrutinees(callee, counter), for a in args {\n      lift_match_scrutinees(a, counter)\n    }, off),\n    EBinOp(op, l, r) => EBinOp(op, lift_match_scrutinees(l, counter), lift_match_scrutinees(r, counter)),\n    EUnaryOp(op, e) => EUnaryOp(op, lift_match_scrutinees(e, counter)),\n    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, lift_match_scrutinees(body, counter)),\n    EDot(e, field, off, fdoff) => EDot(lift_match_scrutinees(e, counter), field, off, fdoff),\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, lift_match_scrutinees(v, counter)),\n    EReturn(e) => EReturn(lift_match_scrutinees(e, counter)),\n    EBreak(opt) => match opt {\n      Some(v) => EBreak(Some(lift_match_scrutinees(v, counter))),\n      None => EBreak(None)\n    },\n    EContinue(args) => EContinue(for a in args {\n      lift_match_scrutinees(a, counter)\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (k, v) = f\n      (k, lift_match_scrutinees(v, counter))\n    }),\n    ESpread(e) => ESpread(lift_match_scrutinees(e, counter))\n  }\n}\n\nfn fold_stmt(stmt: Stmt) -> Stmt {\n  match stmt {\n    SLet(exp, is_rec, name, ty, body) => SLet(exp, is_rec, name, ty, fold_expr(body)),\n    SFnDecl(exp, name, fn_value, reqs, enss) => SFnDecl(exp, name, fold_expr(fn_value), reqs, enss),\n    SLetMut(name, ty, body) => SLetMut(name, ty, fold_expr(body)),\n    STest(n, body) => STest(n, fold_expr(body)),\n    SBench(n, body) => SBench(n, fold_expr(body)),\n    SExpr(e) => SExpr(fold_expr(e)),\n    SLetPat(p, body) => SLetPat(p, fold_expr(body)),\n    _ => stmt\n  }\n}\n\nfn fold_stmts(stmts: Array[Stmt]) -> Array[Stmt] {\n  let out = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::push(out, fold_stmt(Array::get(stmts, i)))\n    i = i + 1\n  }\n  out\n}\n\n//# Literal type annotation\n\n// The type of a value binding whose initializer is a literal of an obvious\n// type. Only these self-evident cases are annotated; anything needing real\n// inference (a call result, an identifier, arithmetic over non-literals) is\n// left unannotated so normalize never asserts a type it cannot prove.\nfn literal_type(e: Expr) -> Option[TypeExpr] {\n  match e {\n    EInt(_) => Some(TyName(\"Int\")),\n    EBool(_) => Some(TyName(\"Bool\")),\n    EString(_) => Some(TyName(\"String\")),\n    EFloat(_) => Some(TyName(\"Double\")),\n    _ => None\n  }\n}\n\n// Add `: T` to an un-annotated `let x = <literal>` (runs after folding, so e.g.\n// `let answer = 40 + 2` -> `let answer = 42` -> `let answer: Int = 42`). Lambda\n// values are handled by hoisting, not here (a literal is never an `EFn`).\nfn annotate_literal_let(stmt: Stmt) -> Stmt {\n  match stmt {\n    SLet(exp, is_rec, name, ty, body) => match ty {\n      Some(_) => stmt,\n      None => match literal_type(body) {\n        Some(t) => SLet(exp, is_rec, name, Some(t), body),\n        None => stmt\n      }\n    },\n    _ => stmt\n  }\n}\n\nfn annotate_literal_lets(stmts: Array[Stmt]) -> Array[Stmt] {\n  let out = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::push(out, annotate_literal_let(Array::get(stmts, i)))\n    i = i + 1\n  }\n  out\n}\n\n// DCE is name-based, so it must run while module members still carry their\n// short names (a body says `helper()`, not `math::helper()`). We therefore DCE\n// each scope before flattening renames its bindings:\n//   - top-level non-module decls are DCE'd against the exported top-level roots;\n//   - each module body is DCE'd against its own exported members, then renamed.\nexport fn normalize_stmts(stmts: Array[Stmt]) -> Array[Stmt] {\n  let nonmods = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if !is_module_stmt(stmt) {\n      Array::push(nonmods, stmt)\n    }\n    i = i + 1\n  }\n  let result = empty_stmts()\n  let live_top = dce_stmts(nonmods, exported_value_names(nonmods))\n  Array::push_all(result, live_top)\n  let mut m = 0\n  while m < Array::length(stmts) {\n    match Array::get(stmts, m) {\n      SModule(_, name, body) => {\n        let live_body = dce_stmts(body, exported_value_names(body))\n        let aliases = array_empty()\n        let _ = module_value_aliases(live_body, name, aliases)\n        let _ = flatten_module_body(live_body, name, aliases, result)\n        0\n      },\n      _ => 0\n    }\n    m = m + 1\n  }\n  let promoted = promote_aggregate_exports(result, aggregate_export_names(stmts))\n  hoist_lambda_lets(annotate_literal_lets(fold_stmts(drop_unused_type_aliases(promoted))))\n}\n\nexport fn normalize_source(src: String) -> String with { Error } {\n  // #730 (D-3): require pin lines are a leading directive, not statement\n  // grammar — extract them, normalize the remainder, and re-emit them in\n  // canonical single-space form above the output. Pin FILLING is the\n  // Fs-mode wrapper's job (VIBE_FILL_PINS); this pure engine re-emits\n  // pinned and unpinned lines as they are.\n  let (req_pins, src_wo_requires) = extract_require_pins(src)\n  // #cfg guard: parse_program DROPS inactive #cfg statements, so formatting\n  // a #cfg-bearing source would silently delete the disabled code from the\n  // re-printed output. Refuse instead.\n  let toks_cfg = lex(src_wo_requires)\n  let mut ci = 0\n  while ci < Array::length(toks_cfg) {\n    match Array::get(toks_cfg, ci) {\n      THash => throw(\"cannot normalize a source containing #cfg directives\"),\n      _ => ()\n    }\n    ci = ci + 1\n  }\n  // #727 (ADR-0064): parse with the fn-PRESERVING entry so `fn` declarations\n  // (and their where-contracts) survive as SFnDecl and re-print in fn form\n  // instead of being rewritten to `let rec` + inlined asserts.\n  let stmts = parse_program_preserving(toks_cfg)\n  let kept = normalize_stmts(stmts)\n  let sections = empty_strs()\n  if Array::length(req_pins) > 0 {\n    let req_lines = empty_strs()\n    let mut ri = 0\n    while ri < Array::length(req_pins) {\n      let (rname, rver, rpin) = Array::get(req_pins, ri)\n      if rpin == \"\" {\n        Array::push(req_lines, \"require \\{rname} \\{rver}\")\n      } else {\n        Array::push(req_lines, \"require \\{rname} \\{rver} = #\\{rpin}\")\n      }\n      ri = ri + 1\n    }\n    Array::push(sections, String::join(req_lines, \"\\n\"))\n  } else ()\n  let mut s = 0\n  while s <= 3 {\n    let rendered = render_section(kept, s)\n    if rendered != \"\" {\n      Array::push(sections, rendered)\n    }\n    s = s + 1\n  }\n  String::concat(String::join(sections, \"\\n\\n\"), \"\\n\")\n}\n")
}

let cli_adapter_source_210 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/desugar_trait_dict.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  sort_perm_by_names,\n  str_lt\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# Functions\n\n// Dictionary-passing desugaring for method-bearing traits (#641 PR-3\n// components 3+4). Runs pre-check, after string-interpolation expansion. It is\n// INERT unless the program declares a trait with method signatures, so all\n// existing code (and the compiler's own selfbuild) is untouched.\n//\n// For a method-bearing `trait Tr { m(Self) -> R; ... }` it:\n//   1. synthesizes a witness struct `TrDict { m: (Self) -> R; ... }`,\n//   2. for each top-level generic `f = [T: Tr](.. x: T ..) -> Ret { body }`\n//      that is bounded by `Tr`, prepends a hidden dict parameter\n//      `__dict_Tr_T: TrDict[T]` and rewrites `T::m(args)` in the body to\n//      `(__dict_Tr_T.m)(args)`,\n//   3. at every call site `f(.. recv ..)` synthesizes the witness\n//      `TrDict::{ m: C::m, ... }` from the concrete receiver type C (the impl's\n//      `C::m` free functions from PR-1) and threads it in.\n//\n// First slice (see docs/method-bearing-traits-plan.md): single type parameter\n// per bound that appears directly as a parameter type (`x: T`), concrete call\n// sites whose receiver type is syntactically determinable (primitive literals\n// and struct literals). Anything outside this leaves the call unrewritten, so a\n// missing dictionary surfaces as a loud arity error rather than a miscompile.\n\nfn empty_expr_array() -> Array[Expr] {\n  array_empty()\n}\n\nfn empty_str_array() -> Array[String] {\n  array_empty()\n}\n\n// #886: empty explicit-type-argument list for constructed ERecord nodes\n// (dict witnesses / trait defaults never carry explicit struct type args).\nfn empty_ty_args() -> Array[TypeExpr] {\n  array_empty()\n}\n\nfn empty_type_exprs() -> Array[TypeExpr] {\n  array_empty()\n}\n\n// Method names declared by a trait, in declaration order.\nfn method_names_of_sigs(methods: Array[(String, Array[TypeExpr], TypeExpr)]) -> Array[String] {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(methods) {\n    let (mname, _, _) = Array::get(methods, i)\n    Array::push(out, mname)\n    i = i + 1\n  }\n  out\n}\n\nfn str_array_contains(arr: Array[String], val: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == val {\n      found = true\n      i = Array::length(arr)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// Split a qualified `Head::member` into Some((head, member)) on the FIRST `::`.\nfn split_qualified(name: String) -> Option[(String, String)] {\n  let idx = String::index_of(name, \"::\")\n  if idx < 0 {\n    None\n  } else {\n    let head = String::substring(name, 0, idx)\n    let member = String::substring(name, idx + 2, String::length(name))\n    Some((head, member))\n  }\n}\n\n// The dict struct name for a trait, e.g. `Measurable` -> `MeasurableDict`.\nfn dict_struct_name(trait_name: String) -> String {\n  String::concat(trait_name, \"Dict\")\n}\n\n// The hidden dict parameter name for `[T: Tr]`, e.g. `__dict_Measurable_T`.\nfn dict_param_name(trait_name: String, tparam: String) -> String {\n  String::concat(\"__dict_\", String::concat(trait_name, String::concat(\"_\", tparam)))\n}\n\n// Collect method-bearing traits (name -> signatures). Marker-only traits\n// (no method signatures) are skipped, which is what keeps this pass inert on\n// existing code.\nfn collect_method_traits(stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STrait(_, tname, _, methods, _) => if Array::length(methods) > 0 {\n        Array::push(out, (tname, methods))\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// ---- rank-1 method generics (#684) ----\n//\n// A trait method may declare its own type parameters, `m: [X: Show](Self, X) ->\n// R`. The binder lives on the TRAIT method only (STrait's 5th field); the impl\n// `impl Tr for C { m = (self, x) -> {..} }` does NOT repeat it and parses to a\n// top-level `SLet(_, _, \"C::m\", _, EFn([], [], [(self,None),(x,None)], ..))`.\n// `inject_method_generics` re-attaches the trait method's `[X: Show]` binder to\n// the impl's free function and annotates the unannotated params with the trait\n// method's declared param types. After injection `build_gens` sees `x: X`,\n// registers `C::m` as a Show-bounded generic, and the existing dict-passing\n// machinery threads/synthesizes the `Show` witness at qualified call sites.\n\nfn empty_method_gens() -> Array[(String, Array[String], Array[(String, Array[String])])] {\n  array_empty()\n}\n\n// Collect every trait's per-method generic binders (name -> [(method,\n// type_params, bounds)]) from STrait's 5th field. Only traits that declare a\n// non-empty binder on at least one method are kept, so this stays inert.\nfn collect_trait_method_gens(stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STrait(_, tname, _, _, method_gens) => {\n        let mut any = false\n        let mut j = 0\n        while j < Array::length(method_gens) {\n          let (_, tps, _) = Array::get(method_gens, j)\n          if Array::length(tps) > 0 {\n            any = true\n          } else {\n            ()\n          }\n          j = j + 1\n        }\n        if any {\n          Array::push(out, (tname, method_gens))\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// Look up a method's `(type_params, bounds)` in a trait's method-gen table.\n// Returns None when the method has no binder (empty type_params).\nfn lookup_method_gen(table: Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], trait_name: String, method: String) -> Option[(Array[String], Array[(String, Array[String])])] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(table) {\n    let (tn, gens) = Array::get(table, i)\n    if tn == trait_name {\n      let mut j = 0\n      while j < Array::length(gens) {\n        let (mname, tps, bounds) = Array::get(gens, j)\n        if mname == method && Array::length(tps) > 0 {\n          result = Some((tps, bounds))\n          j = Array::length(gens)\n        } else {\n          j = j + 1\n        }\n      }\n      i = Array::length(table)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// Map each impl's target type to the trait it implements\n// (`impl Tr for C` -> (C, Tr)). A type may implement several traits; the first\n// matching trait that declares the method is used at lookup time.\nfn collect_impl_trait_map(stmts: Array[Stmt]) -> Array[(String, String)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImpl(_, _, trait_name, type_name) => Array::push(out, (type_name, trait_name)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// The declared parameter types of method `m` in trait `trait_name` (its 3-tuple\n// signature). Used to annotate the impl method's unannotated params so the\n// per-method type parameter `X` appears as `x: X`.\nfn lookup_trait_method_param_types(traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], trait_name: String, method: String) -> Option[Array[TypeExpr]] {\n  match lookup_trait_sigs(traits, trait_name) {\n    Some(sigs) => {\n      let mut j = 0\n      let mut result = None\n      while j < Array::length(sigs) {\n        let (mname, ptypes, _) = Array::get(sigs, j)\n        if mname == method {\n          result = Some(ptypes)\n          j = Array::length(sigs)\n        } else {\n          j = j + 1\n        }\n      }\n      result\n    },\n    None => None\n  }\n}\n\n// Find the trait, among those `type_name` implements, that declares a\n// method-level binder for `method`. Returns its (type_params, bounds, param\n// types) so the impl method can be re-typed.\nfn find_method_generic_for_impl(impl_map: Array[(String, String)], gen_table: Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], type_name: String, method: String) -> Option[(Array[String], Array[(String, Array[String])], Array[TypeExpr])] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(impl_map) {\n    let (tn, trait_name) = Array::get(impl_map, i)\n    if tn == type_name {\n      match lookup_method_gen(gen_table, trait_name, method) {\n        Some(g) => {\n          let (tps, bounds) = g\n          match lookup_trait_method_param_types(traits, trait_name, method) {\n            Some(ptypes) => {\n              result = Some((tps, bounds, ptypes))\n              i = Array::length(impl_map)\n            },\n            None => {\n              i = i + 1\n            }\n          }\n        },\n        None => {\n          i = i + 1\n        }\n      }\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// Annotate each parameter whose annotation is None with the trait method's\n// declared param type (when one exists at that index). Already-annotated params\n// keep their annotation.\nfn annotate_params_from_sig(params: Array[(String, Option[TypeExpr])], ptypes: Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, ann) = Array::get(params, i)\n    let new_ann = match ann {\n      Some(_) => ann,\n      None => if i < Array::length(ptypes) {\n        Some(Array::get(ptypes, i))\n      } else {\n        None\n      }\n    }\n    Array::push(out, (pname, new_ann))\n    i = i + 1\n  }\n  out\n}\n\n// In-place: for each impl method `C::m` whose trait declares a method-level\n// `[X: Bound]` binder, re-attach the binder to the EFn and annotate its params\n// with the trait method's declared types. Idempotent: an EFn that already\n// carries type_params was injected on a prior run and is skipped.\nfn inject_method_generics(stmts: Array[Stmt], impl_map: Array[(String, String)], gen_table: Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, isrec, qname, ann, body) => match body {\n        EFn(tparams, bounds, params, ret, eff, fbody) => if Array::length(tparams) == 0 {\n          match split_qualified(qname) {\n            Some(parts) => {\n              let (cname, method) = parts\n              match find_method_generic_for_impl(impl_map, gen_table, traits, cname, method) {\n                Some(g) => {\n                  let (mtparams, mtbounds, ptypes) = g\n                  let new_params = annotate_params_from_sig(params, ptypes)\n                  let new_efn = EFn(mtparams, mtbounds, new_params, ret, eff, fbody)\n                  Array::set(stmts, i, SLet(exp, isrec, qname, ann, new_efn))\n                },\n                None => ()\n              }\n            },\n            None => ()\n          }\n        } else {\n          ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\n// Re-attach trait-method `[X: Bound]` binders to impl free functions, given a\n// (possibly flattened) method-trait table for param-type lookup. Inert and\n// idempotent. Shared by `desugar_trait_dicts` (pre-codegen) and `check_program`\n// (so the FS-compile path, which type-checks before the desugar runs, also sees\n// the binder and can resolve `X::method`).\nfn inject_trait_method_generics_with(stmts: Array[Stmt], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit {\n  let method_gen_table = collect_trait_method_gens(stmts)\n  if Array::length(method_gen_table) > 0 {\n    let impl_map = collect_impl_trait_map(stmts)\n    inject_method_generics(stmts, impl_map, method_gen_table, traits)\n  } else {\n    ()\n  }\n}\n\n// Self-contained entry for callers that have not flattened the trait table\n// (the checker). Builds its own (flattened) method-trait table from `stmts`.\nexport fn inject_trait_method_generics(stmts: Array[Stmt]) -> Unit {\n  let traits_raw = collect_method_traits(stmts)\n  let supers_map = collect_trait_supers(stmts)\n  let traits = flatten_traits(traits_raw, supers_map)\n  inject_trait_method_generics_with(stmts, traits)\n}\n\n// #760(2): `Result` is not a built-in type constructor (unlike Option/CtOption);\n// it is the ordinary user enum `enum Result[T, E] { Ok(T); Err(E) }` (see\n// vibe/prelude/result.vibe). A standalone program that neither declares nor\n// imports it gets `unknown name: Ok` / `Err` / `Result::Ok`. This appends that\n// enum declaration to the program UNLESS a `Result` type (or an `Ok`/`Err`\n// constructor) is already in scope — user-declared, or imported and merged in as\n// a statement. All the existing user-enum machinery (ctor resolution, pattern\n// match, exhaustiveness, codegen ctor construction) then applies with no\n// type-system changes. Type declarations are hoisted, so appending is order-safe.\n// In-place + idempotent + inert when Result is already present. Shared by\n// `desugar_trait_dicts` (pre-codegen) and `check_program` (the FS-compile path\n// type-checks before the codegen desugar runs), which both re-parse the merged\n// program, so each independently appends the SAME deterministic declaration.\n// #760(2): does the program actually reference `Result` / `Ok` / `Err`? The\n// prelude injection is gated on this so a program that never mentions Result\n// gets NO injected enum — otherwise every binary would carry (and #cov would\n// instrument) a dead `Ok`/`Err` ctor. Covers construction (`Ok`/`Err`/\n// `Result::Ok`/`Result::Err` value references), pattern matches (`Ok(..)` /\n// `Err(..)` arms), and `Result[..]` type annotations.\nfn is_result_ctor_name(s: String) -> Bool {\n  s == \"Ok\" || s == \"Err\" || s == \"Result::Ok\" || s == \"Result::Err\"\n}\n\nfn ty_mentions_result(te: TypeExpr) -> Bool {\n  match te {\n    TyName(n) => n == \"Result\",\n    TyApp(n, args) => if n == \"Result\" {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if ty_mentions_result(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyFn(params, ret, _) => {\n      let mut found = ty_mentions_result(ret)\n      let mut i = 0\n      while i < Array::length(params) {\n        if ty_mentions_result(Array::get(params, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyTuple(elems) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(elems) {\n        if ty_mentions_result(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyUnit => false\n  }\n}\n\nfn opt_ty_mentions_result(o: Option[TypeExpr]) -> Bool {\n  match o {\n    Some(t) => ty_mentions_result(t),\n    None => false\n  }\n}\n\nfn pat_mentions_result(p: Pat) -> Bool {\n  match p {\n    PCtor(name, sub) => if is_result_ctor_name(name) {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(sub) {\n        if pat_mentions_result(Array::get(sub, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    PStruct(name, fields) => if is_result_ctor_name(name) || name == \"Result\" {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        if pat_mentions_result(fp) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    PTuple(sub) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(sub) {\n        if pat_mentions_result(Array::get(sub, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    POr(a, b) => pat_mentions_result(a) || pat_mentions_result(b),\n    _ => false\n  }\n}\n\n// Recurse into an array of exprs (inlined, like collect_strings_expr — a `let\n// rec` cannot forward-reference a plain `let` helper defined later).\nfn expr_mentions_result(e: Expr) -> Bool {\n  match e {\n    EIdent(n, _) => is_result_ctor_name(n) || n == \"Result\",\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_mentions_result(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_mentions_result(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        if expr_mentions_result(v) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        if expr_mentions_result(v) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EIf(c, t, el) => expr_mentions_result(c) || expr_mentions_result(t) || expr_mentions_result(el),\n    ELet(_, v, b, _) => expr_mentions_result(v) || expr_mentions_result(b),\n    ELetRec(_, v, b) => expr_mentions_result(v) || expr_mentions_result(b),\n    ELetMut(_, v, b, _) => expr_mentions_result(v) || expr_mentions_result(b),\n    EAssign(_, v, b) => expr_mentions_result(v) || expr_mentions_result(b),\n    EAssignOp(_, _, v, b) => expr_mentions_result(v) || expr_mentions_result(b),\n    ESeq(a, b) => expr_mentions_result(a) || expr_mentions_result(b),\n    EMatch(scrut, arms) => {\n      let mut found = expr_mentions_result(scrut)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        if pat_mentions_result(p) || expr_mentions_result(b) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EHandle(scrut, arms) => {\n      let mut found = expr_mentions_result(scrut)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        if pat_mentions_result(p) || expr_mentions_result(b) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EWhile(c, b) => expr_mentions_result(c) || expr_mentions_result(b),\n    ELoop(params, body) => {\n      let mut found = expr_mentions_result(body)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, v) = Array::get(params, i)\n        if expr_mentions_result(v) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EForIn(_, _, it, body) => expr_mentions_result(it) || expr_mentions_result(body),\n    ECall(callee, args, _) => {\n      let mut found = expr_mentions_result(callee)\n      let mut i = 0\n      while i < Array::length(args) {\n        if expr_mentions_result(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EBinOp(_, l, r) => expr_mentions_result(l) || expr_mentions_result(r),\n    EUnaryOp(_, x) => expr_mentions_result(x),\n    EFn(_, _, params, ret, _, body) => {\n      let mut found = opt_ty_mentions_result(ret) || expr_mentions_result(body)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, ann) = Array::get(params, i)\n        if opt_ty_mentions_result(ann) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EDot(o, _, _, _) => expr_mentions_result(o),\n    ELabeledArg(_, _, v) => expr_mentions_result(v),\n    EReturn(x) => expr_mentions_result(x),\n    EBreak(o) => match o {\n      Some(x) => expr_mentions_result(x),\n      None => false\n    },\n    EContinue(xs) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(xs) {\n        if expr_mentions_result(Array::get(xs, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ESpread(x) => expr_mentions_result(x),\n    _ => false\n  }\n}\n\nfn stmt_mentions_result(s: Stmt) -> Bool {\n  match s {\n    SLet(_, _, _, ann, v) => opt_ty_mentions_result(ann) || expr_mentions_result(v),\n    SLetMut(_, ann, v) => opt_ty_mentions_result(ann) || expr_mentions_result(v),\n    STest(_, b) => expr_mentions_result(b),\n    SBench(_, b) => expr_mentions_result(b),\n    SExpr(e) => expr_mentions_result(e),\n    SLetPat(p, e) => pat_mentions_result(p) || expr_mentions_result(e),\n    SExternLet(_, te) => ty_mentions_result(te),\n    STypeAlias(_, _, _, te) => ty_mentions_result(te),\n    SStruct(_, _, fields, _, _, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, te) = Array::get(fields, i)\n        if ty_mentions_result(te) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    SModule(_, _, body) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(body) {\n        if stmt_mentions_result(Array::get(body, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    _ => false\n  }\n}\n\nfn program_mentions_result(stmts: Array[Stmt]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    if stmt_mentions_result(Array::get(stmts, i)) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn result_already_present(stmts: Array[Stmt]) -> Bool {\n  let mut present = false\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEnum(_, name, _, variants, _) => {\n        if name == \"Result\" {\n          present = true\n        } else {\n          ()\n        }\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vn, _) = Array::get(variants, vi)\n          if vn == \"Ok\" || vn == \"Err\" {\n            present = true\n          } else {\n            ()\n          }\n          vi = vi + 1\n        }\n      },\n      SStruct(_, name, _, _, _, _) => if name == \"Result\" {\n        present = true\n      } else {\n        ()\n      },\n      STypeAlias(_, name, _, _) => if name == \"Result\" {\n        present = true\n      } else {\n        ()\n      },\n      // An imported / re-exported `Result` (or `Ok`/`Err`) — e.g.\n      // `import ../prelude/result.vibe { Result }`. Without this the per-file\n      // checker path (which sees the import but not the merged enum declaration)\n      // would inject a SECOND, nominally-distinct `Result`, so a value of the\n      // imported type would not unify with the injected one (`type mismatch in\n      // '=='`). Treat the imported name as already-present.\n      SImport(_, names) => {\n        let mut ni = 0\n        while ni < Array::length(names) {\n          let (nm, _) = Array::get(names, ni)\n          if nm == \"Result\" || nm == \"Ok\" || nm == \"Err\" {\n            present = true\n          } else {\n            ()\n          }\n          ni = ni + 1\n        }\n      },\n      SReExport(_, names) => {\n        let mut ni = 0\n        while ni < Array::length(names) {\n          let (nm, _) = Array::get(names, ni)\n          if nm == \"Result\" || nm == \"Ok\" || nm == \"Err\" {\n            present = true\n          } else {\n            ()\n          }\n          ni = ni + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  present\n}\n\nexport fn inject_prelude_result(stmts: Array[Stmt]) -> Unit {\n  if result_already_present(stmts) || !program_mentions_result(stmts) {\n    ()\n  } else {\n    let variants = [\n      (\"Ok\", [\n        TyName(\"T\")\n      ]),\n      (\"Err\", [\n        TyName(\"E\")\n      ])\n    ]\n    let params = [\n      \"T\",\n      \"E\"\n    ]\n    Array::push(stmts, SEnum(false, \"Result\", params, variants, empty_str_array()))\n  }\n}\n\n// Collect each trait's declared supertraits (`trait B: A + ...`), for all\n// traits (method-bearing or not), so a method-bearing trait can inherit its\n// supertraits' methods.\nfn collect_trait_supers(stmts: Array[Stmt]) -> Array[(String, Array[String])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STrait(_, tname, supers, _, _) => Array::push(out, (tname, supers)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_supers(supers_map: Array[(String, Array[String])], name: String) -> Array[String] {\n  let mut i = 0\n  let mut result = empty_str_array()\n  while i < Array::length(supers_map) {\n    let (tname, supers) = Array::get(supers_map, i)\n    if tname == name {\n      result = supers\n      i = Array::length(supers_map)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// Flatten a trait's method signatures with those of its (transitive) method-\n// bearing supertraits, deduplicating by method name, so `[T: B]` for\n// `trait B: A` can dispatch both B's and A's methods through one flat witness\n// dictionary. `acc_names` / `out` accumulate across the recursion.\n//\n// Supertrait methods are emitted BEFORE the trait's own, so an inherited method\n// keeps the same field index in every dict that contains it (e.g. `measure`\n// is index 0 in both `MeasurableDict` and `SizedDict`). This matters because\n// codegen resolves `dict.field` by a global first-match field-name search\n// (compile_expr_tail4.vibe), not by the object's static type — so a shared\n// field name must sit at a consistent index across structs. (Single supertrait\n// chains only; multiple-supertrait ordering is a deferred slice.)\nfn flatten_trait_sigs_into(tname: String, traits_raw: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], supers_map: Array[(String, Array[String])], acc_names: Array[String], out: Array[(String, Array[TypeExpr], TypeExpr)]) -> Unit {\n  let supers = lookup_supers(supers_map, tname)\n  let mut s = 0\n  while s < Array::length(supers) {\n    flatten_trait_sigs_into(Array::get(supers, s), traits_raw, supers_map, acc_names, out)\n    s = s + 1\n  }\n  match lookup_trait_sigs(traits_raw, tname) {\n    Some(sigs) => {\n      let mut i = 0\n      while i < Array::length(sigs) {\n        let (mname, params, ret) = Array::get(sigs, i)\n        if str_array_contains(acc_names, mname) {\n          ()\n        } else {\n          Array::push(acc_names, mname)\n          Array::push(out, (mname, params, ret))\n        }\n        i = i + 1\n      }\n    },\n    None => ()\n  }\n}\n\n// Produce a method-trait table whose signatures are flattened across\n// supertraits, so all downstream code (dict struct, dispatch names, witness\n// materialization) sees one flat method set per trait.\nfn flatten_traits(traits_raw: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], supers_map: Array[(String, Array[String])]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(traits_raw) {\n    let (tname, _) = Array::get(traits_raw, i)\n    let acc_names = empty_str_array()\n    let flat = array_empty()\n    flatten_trait_sigs_into(tname, traits_raw, supers_map, acc_names, flat)\n    Array::push(out, (tname, flat))\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_trait_sigs(traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], name: String) -> Option[Array[(String, Array[TypeExpr], TypeExpr)]] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(traits) {\n    let (tname, sigs) = Array::get(traits, i)\n    if tname == name {\n      result = Some(sigs)\n      i = Array::length(traits)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// Collect user struct field-name sets, for inferring a struct-literal's type\n// (the parser discards the `Name::` prefix of `Name::{ ... }`).\nfn collect_struct_field_sets(stmts: Array[Stmt]) -> Array[(String, Array[String])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, sname, fields, _, _, _) => {\n        let names = empty_str_array()\n        let mut j = 0\n        while j < Array::length(fields) {\n          let (fname, _) = Array::get(fields, j)\n          Array::push(names, fname)\n          j = j + 1\n        }\n        Array::push(out, (sname, names))\n      },\n      // #672: also record enum names (with an EMPTY field set, so the ERecord\n      // field-set match never confuses an enum with a struct literal) so the\n      // `==` dispatch's `struct_set_has` gate accepts enum operands too.\n      SEnum(_, ename, _, _, _) => Array::push(out, (ename, empty_str_array())),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// Build the witness struct `TrDict { m: (Self) -> R; ... }` for a trait. The\n// `Self` placeholder in the signatures stays verbatim — struct type params are\n// erased, so the field-access typing is structural (proven in spike G-3).\nfn make_dict_struct_stmt(trait_name: String, sigs: Array[(String, Array[TypeExpr], TypeExpr)]) -> Stmt {\n  let fields = array_empty()\n  let mut i = 0\n  while i < Array::length(sigs) {\n    let (mname, params, ret) = Array::get(sigs, i)\n    Array::push(fields, (mname, TyFn(params, ret, None)))\n    i = i + 1\n  }\n  SStruct(false, dict_struct_name(trait_name), fields, empty_str_array(), empty_str_array(), empty_str_array())\n}\n\n// Two field-name sets describe the same struct shape when they have equal\n// length and every name in one appears in the other.\nfn field_sets_match(a: Array[String], b: Array[String]) -> Bool {\n  if Array::length(a) != Array::length(b) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(a) {\n      if str_array_contains(b, Array::get(a, i)) {\n        i = i + 1\n      } else {\n        ok = false\n        i = Array::length(a)\n      }\n    }\n    ok\n  }\n}\n\n// Is `name` a known struct (a key in struct_sets)? Gates the #672 `==` dispatch.\nfn struct_set_has(struct_sets: Array[(String, Array[String])], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(struct_sets) {\n    let (sname, _) = Array::get(struct_sets, i)\n    if sname == name {\n      found = true\n      i = Array::length(struct_sets)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// Whether type `name` declares a field/variant called `member` (struct_sets\n// maps struct AND enum names to their field/variant name lists). Used to keep\n// a field-stored-function call `b.f(args)` as an EDot when the struct also\n// has a same-named `T::f` method candidate.\nfn struct_set_member(struct_sets: Array[(String, Array[String])], name: String, member: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(struct_sets) {\n    let (sname, members) = Array::get(struct_sets, i)\n    if sname == name {\n      let mut j = 0\n      while j < Array::length(members) {\n        if Array::get(members, j) == member {\n          found = true\n          j = Array::length(members)\n        } else {\n          j = j + 1\n        }\n      }\n      i = Array::length(struct_sets)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// [robj, arg1, arg2, ...] — receiver prepended to the rewritten args for a\n// method-call rewrite (`xs.m(a)` -> `T::m(xs, a)`).\nfn prepend_expr(head: Expr, rest: Array[Expr]) -> Array[Expr] {\n  let out = array_empty()\n  Array::push(out, head)\n  let mut i = 0\n  while i < Array::length(rest) {\n    Array::push(out, Array::get(rest, i))\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_var_type(var_types: Array[(String, String)], name: String) -> Option[String] {\n  // `extend_var_types` APPENDS on each `let`, so a shadowing rebind adds a second\n  // entry for the same name. Return the LAST match (the innermost binding in\n  // scope) so `let r = record { a }; ...; let r = record { c }; r.c` resolves\n  // against the inner shape rather than the stale outer one (#760(4)).\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(var_types) {\n    let (vn, vt) = Array::get(var_types, i)\n    if vn == name {\n      result = Some(vt)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  result\n}\n\n// Best-effort syntactic inference of a call argument's concrete type, enough to\n// pick the trait impl at a concrete call site. Consults `var_types` (locals\n// bound to inferable values and parameters with concrete annotations). Returns\n// None when the type is not determinable (the call is then left unrewritten).\n// Resolve a (possibly qualified) constructor name to its enum/return type.\n// Bare `Green` -> `Color` via fn_returns; qualified `Color::Green` first tries\n// the whole name (no match) then the member `Green` confirming its enum equals\n// the head — so `let a = Color::Green` seeds `a -> Color` for `==` dispatch.\nfn ctor_enum_of_name(fn_returns: Array[(String, String)], name: String) -> Option[String] {\n  match fn_return_type(fn_returns, name) {\n    Some(t) => Some(t),\n    None => match split_qualified(name) {\n      Some(parts) => {\n        let (head, member) = parts\n        match fn_return_type(fn_returns, member) {\n          Some(en) => if en == head {\n            Some(en)\n          } else {\n            None\n          },\n          None => None\n        }\n      },\n      None => None\n    }\n  }\n}\n\nfn infer_arg_type_name(arg: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {\n  match arg {\n    EInt(_) => Some(\"Int\"),\n    EBool(_) => Some(\"Bool\"),\n    EString(_) => Some(\"String\"),\n    EFloat(_) => Some(\"Double\"),\n    // String `+` chains: `\"a\" + b + \"c\"` infers String when EITHER side does\n    // (the checker enforces both sides are String when one is). This both\n    // types the concat rewrite below and lets a `let u = a + \"x\"` binding\n    // record u -> String for downstream `u + ...`. Other `+` operands stay\n    // None (no behavior change for numeric/unknown).\n    EBinOp(bop, bl, br) => if bop == \"+\" {\n      let lstr = match infer_arg_type_name(bl, struct_sets, var_types, fn_returns) {\n        Some(t) => t == \"String\",\n        None => false\n      }\n      let rstr = match infer_arg_type_name(br, struct_sets, var_types, fn_returns) {\n        Some(t) => t == \"String\",\n        None => false\n      }\n      if lstr || rstr {\n        Some(\"String\")\n      } else {\n        None\n      }\n    } else {\n      None\n    },\n    // An array literal dispatches to an `impl [T] Trait for Array` witness\n    // (#5 generic impls): its constructor is \"Array\" regardless of element type.\n    EArray(_) => Some(\"Array\"),\n    // Same for a `map { ... }` literal: constructor \"Map\" (lets a let-bound\n    // map resolve an `impl ... for Map` witness at a generic call site).\n    EMap(_) => Some(\"Map\"),\n    // A variable's recorded type, else a (possibly qualified) nullary\n    // constructor's enum name (`Green`/`Color::Green` -> `Color`) so that a\n    // `let a = Green` / `let a = Color::Green` binding resolves for `==`. The\n    // builtin nullary `None` resolves to the structural shape \"Option\" so a\n    // `let a = None; ... a == b` dispatches structurally (#695).\n    EIdent(name, _) => if name == \"None\" {\n      Some(\"Option\")\n    } else {\n      match lookup_var_type(var_types, name) {\n        Some(t) => Some(t),\n        None => ctor_enum_of_name(fn_returns, name)\n      }\n    },\n    // A call-valued iterable (`for x in lazy_iter_arr([..])`) or data ctor\n    // (`Sh::Circle(5)`): its type is the head of the callee's return type. The\n    // builtin `Some`/`Ok`/`Err` constructors resolve to \"Option\"/\"Result\" so a\n    // bare `==` on them dispatches structurally (#695).\n    ECall(callee, _, _) => match callee {\n      EIdent(\"Some\", _) => Some(\"Option\"),\n      EIdent(\"Ok\", _) => Some(\"Result\"),\n      EIdent(\"Err\", _) => Some(\"Result\"),\n      // String-returning builtins (not in fn_returns): lets a\n      // `String::concat(a, b) + c` / `__to_string(n) + s` operand type as\n      // String for the concat rewrite.\n      EIdent(\"String::concat\", _) => Some(\"String\"),\n      EIdent(\"String::join\", _) => Some(\"String\"),\n      EIdent(\"String::substring\", _) => Some(\"String\"),\n      EIdent(\"String::trim\", _) => Some(\"String\"),\n      EIdent(\"String::replace\", _) => Some(\"String\"),\n      EIdent(\"String::from_char_code\", _) => Some(\"String\"),\n      EIdent(\"__to_string\", _) => Some(\"String\"),\n      // Map-returning builtins (not in fn_returns): lets `let m2 = Map::set(m,\n      // k, v)` record m2 -> Map so a later `m2[k]` takes the #760(3) Map::get\n      // rewrite. (A `map { }` literal is already classified as Map above.)\n      EIdent(\"Map::set\", _) => Some(\"Map\"),\n      EIdent(\"Map::remove\", _) => Some(\"Map\"),\n      EIdent(\"Map::insert\", _) => Some(\"Map\"),\n      EIdent(\"Map::delete\", _) => Some(\"Map\"),\n      EIdent(\"MapBuilder::freeze\", _) => Some(\"Map\"),\n      // Stream-returning builtins (ADR-0012 eager Array-backed model): lets\n      // `for await x in Stream::once(v)` — or a let-bound stream via\n      // extend_var_types — classify as \"Stream\" so classify_for_await_loop\n      // lowers it to the plain array loop instead of the pull-closure loop\n      // (#822: the pull desugar called the stream value as a closure —\n      // call_indirect on an array pointer = table OOB trap).\n      EIdent(\"Stream::once\", _) => Some(\"Stream\"),\n      EIdent(\"Stream::empty\", _) => Some(\"Stream\"),\n      EIdent(\"Stream::map\", _) => Some(\"Stream\"),\n      EIdent(\"Stream::filter\", _) => Some(\"Stream\"),\n      EIdent(\"String::to_bytes\", _) => Some(\"Stream\"),\n      EIdent(fname, _) => ctor_enum_of_name(fn_returns, fname),\n      // `let x: T = e` is desugared to `((__asc: T) -> __asc)(e)` (ascribe_wrap);\n      // recover the operand's type head from the annotation so an annotated\n      // `let a: Option[Int] = None` records `a -> \"Option\"` for `==` dispatch.\n      EFn(_, _, params, _, _, _) => if Array::length(params) == 1 {\n        let (_, ann) = Array::get(params, 0)\n        match ann {\n          Some(TyName(n)) => Some(n),\n          Some(TyApp(n, _)) => Some(n),\n          _ => None\n        }\n      } else {\n        None\n      },\n      // #864: a UFCS method-chain call `x.method(args)` as the callee here means\n      // `arg` itself IS `x.method(args)` (e.g. the receiver of an outer\n      // `.and_then(...)` in `x.and_then(f).and_then(g)`, or a `let`-bound\n      // `let b = x.and_then(f)` whose type feeds a later `b.is_ok()`). Without\n      // this case the match fell through to `_ => None`, so the result type of\n      // ANY UFCS call went untracked -- the EDot call-position rewrite below\n      // (see the `as_recv_method` match on `EDot(obj, m, ...)`) then can't\n      // infer the OUTER call's receiver type either, leaves the outer\n      // `.method(...)` as a bare EDot, and codegen's EDot fallback (which only\n      // understands genuine struct-field projections) throws \"unknown struct\n      // field: <method>\" even though the checker -- which performs proper\n      // type-directed `T::method` resolution independently in checker.vibe's\n      // `EDot(obj, method, ...)` arm -- already accepted the same expression\n      // as type-correct. Mirror that checker resolution here: infer the\n      // receiver's type, then look up the qualified `Type::method` return\n      // type, falling back to the bare method name (prelude functions like\n      // `Result::and_then` / `and_then` register both forms in `fn_returns`).\n      EDot(dobj, dmethod, _, _) => {\n        let recv_tn = infer_arg_type_name(dobj, struct_sets, var_types, fn_returns)\n        let qual_rt = match recv_tn {\n          Some(tn) => fn_return_type(fn_returns, String::concat(tn, String::concat(\"::\", dmethod))),\n          None => None\n        }\n        match qual_rt {\n          Some(rt) => Some(rt),\n          None => fn_return_type(fn_returns, dmethod)\n        }\n      },\n      _ => None\n    },\n    ERecord(_, fields, _) => {\n      let names = empty_str_array()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, _) = Array::get(fields, i)\n        Array::push(names, fname)\n        i = i + 1\n      }\n      let mut j = 0\n      let mut result = None\n      while j < Array::length(struct_sets) {\n        let (sname, sfields) = Array::get(struct_sets, j)\n        if field_sets_match(names, sfields) {\n          result = Some(sname)\n          j = Array::length(struct_sets)\n        } else {\n          j = j + 1\n        }\n      }\n      result\n    },\n    _ => None\n  }\n}\n\n// #973: known concrete/struct-like type names `infer_arg_type_name` can\n// report, for which the EXISTING per-type rewrites (String concat/relational,\n// struct `==`, Option/Result structural eq, ...) already apply, or correctly\n// do not. Anything else it returns `Some` for is, by construction, the bare\n// name of an in-scope generic type parameter: `seed_var_types` (and the `EFn`\n// arm of `rewrite_expr`) seed a parameter's own `[T]` annotation verbatim as\n// its \"type name\" — see #931's `as_tparam_dict`, which reuses the same\n// inference for method calls — and no other path in `infer_arg_type_name`\n// produces a non-concrete `Some`.\nfn is_concrete_or_known_type_name(t: String, struct_sets: Array[(String, Array[String])]) -> Bool {\n  t == \"Int\" || t == \"Bool\" || t == \"String\" || t == \"Double\" || t == \"Float\" || t == \"Array\" || t == \"Map\" || t == \"Option\" || t == \"Result\" || t == \"Stream\" || struct_set_has(struct_sets, t)\n}\n\n// #973: does either operand's inferred static type look like an ERASED\n// generic type parameter (`[T: Ord]` / `[T: Add]`) rather than a concrete\n// type `infer_arg_type_name` already has type-specific handling for? Routes\n// `<`/`>`/`<=`/`>=`/`+` through a runtime tag-check dispatch instead of the\n// hardcoded numeric binop when the checker (#952) lets a bound-but-unresolved\n// `T` survive to codegen with NO monomorphization and NO witness dict — Ord\n// and Add are method-less marker traits (`export trait Ord` with an empty\n// body; see builtin_traits.vibe), so `build_gens` never threads either one a\n// dict (only method-bearing bounds get one), leaving nothing concrete to key\n// a String-vs-Int rewrite off at this site. Without this, `x < lo` inside a\n// `fn ord_clamp[T: Ord](x: T, lo: T, ..)` body compiled a raw signed i64\n// compare, which orders a heap String's packed `(ptr<<32)|len` value by\n// POINTER, not content (#973's `ord_clamp(\"m\", \"a\", \"z\")` repro).\nfn is_erased_generic_operand(l: Expr, r: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Bool {\n  let lg = match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {\n    Some(t) => !is_concrete_or_known_type_name(t, struct_sets),\n    None => false\n  }\n  let rg = match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {\n    Some(t) => !is_concrete_or_known_type_name(t, struct_sets),\n    None => false\n  }\n  lg || rg\n}\n\n// #760(3): `m[k]` parses to `__index(m, k)`, whose codegen array-indexes the\n// receiver — on a Map that reads its backing store as a positional array and\n// traps. Rewrite to `Map::get(m, k)` ONLY when the receiver is determinably\n// Map-typed (a `map { }` literal, or a binding/param annotated `Map[..]`,\n// which `infer_arg_type_name` reports as \"Map\"). A non-Map receiver — an\n// Array/Bytes/String, or an unknown — is left as `__index`, so array indexing\n// (and the type checker's rejection of e.g. `a[\"x\"]` on an Array) is unchanged.\n// `rwargs` are the already-rewritten arguments to carry into the new call.\nfn map_index_rewrite(callee: Expr, args: Array[Expr], rwargs: Array[Expr], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] {\n  match callee {\n    EIdent(nm, _) => if nm == \"__index\" && Array::length(args) == 2 {\n      let recv_map = match infer_arg_type_name(Array::get(args, 0), struct_sets, var_types, fn_returns) {\n        Some(t) => t == \"Map\",\n        None => false\n      }\n      if recv_map {\n        Some(ECall(EIdent(\"Map::get\", -1), rwargs, -1))\n      } else {\n        None\n      }\n    } else {\n      None\n    },\n    _ => None\n  }\n}\n\n// #760(4): anonymous-record dot access `r.name`. A `record { .. }` literal whose\n// field-set matches NO declared struct is stored in LITERAL field order with tag\n// 0 (see compile_expr_tail4 ERecord); its `.field` reads reach codegen's EDot,\n// which resolves the slot only through declared structs (`struct_field_candidates`)\n// and therefore throws \"unknown struct field\". The record-pattern destructure\n// (`let record { name: n } = r`) already works because the parser lowers it to\n// positional `__rec_field(r, i)` reads (parser_expr_dispatch). This mirrors that:\n// we thread each anonymous-record binding's ordered field list through `var_types`\n// (as a `__anonrec:` sentinel) and rewrite `binding.field` to the same\n// `__rec_field(binding, slot)` positional read. A struct-matching record is left\n// alone — its literal is reordered to the struct's declared order and the EDot\n// struct-tag-dispatch path resolves it correctly.\nfn anon_record_prefix() -> String {\n  \"__anonrec:\"\n}\n\n// Encode an ordered field-name list as a `var_types` sentinel value.\nfn anon_record_sentinel(names: Array[String]) -> String {\n  let mut s = anon_record_prefix()\n  let mut i = 0\n  while i < Array::length(names) {\n    if i > 0 {\n      s = String::concat(s, \",\")\n    } else {\n      ()\n    }\n    s = String::concat(s, Array::get(names, i))\n    i = i + 1\n  }\n  s\n}\n\n// The slot of `field` within a `__anonrec:` sentinel, or -1 if the string is not\n// a sentinel or does not carry `field`. Splits on `,` so a field name that is a\n// prefix of another (e.g. `ver` vs `version`) does not false-match.\nfn anon_field_index(sentinel: String, field: String) -> Int {\n  let prefix = anon_record_prefix()\n  if !String::starts_with(sentinel, prefix) {\n    -1\n  } else {\n    let mut rest = String::substring(sentinel, String::length(prefix), String::length(sentinel))\n    let mut idx = 0\n    let mut found = -1\n    let mut go = true\n    while go {\n      let comma = String::index_of(rest, \",\")\n      let tok = if comma < 0 {\n        rest\n      } else {\n        String::substring(rest, 0, comma)\n      }\n      if tok == field {\n        found = idx\n        go = false\n      } else if comma < 0 {\n        go = false\n      } else {\n        rest = String::substring(rest, comma + 1, String::length(rest))\n        idx = idx + 1\n      }\n    }\n    found\n  }\n}\n\n// If `val` is a `record { .. }` literal whose field-set matches no declared\n// struct, the `__anonrec:` sentinel recording its literal field order; else None.\n// Threaded into `var_types` at `let`/`let mut` so a later `binding.field` on the\n// same name resolves positionally.\nfn anon_record_inferred(val: Expr, struct_sets: Array[(String, Array[String])]) -> Option[String] {\n  match val {\n    ERecord(_, fields, _) => {\n      let names = empty_str_array()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, _) = Array::get(fields, i)\n        Array::push(names, fname)\n        i = i + 1\n      }\n      let mut j = 0\n      let mut matched = false\n      while j < Array::length(struct_sets) {\n        let (_, sfields) = Array::get(struct_sets, j)\n        if field_sets_match(names, sfields) {\n          matched = true\n          j = Array::length(struct_sets)\n        } else {\n          j = j + 1\n        }\n      }\n      if matched {\n        None\n      } else {\n        Some(anon_record_sentinel(names))\n      }\n    },\n    _ => None\n  }\n}\n\n// Prefer the anonymous-record sentinel for a `let` value, falling back to the\n// ordinary type inference used for trait dispatch / `==` / the Map-index rewrite.\nfn anon_or_infer(val: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {\n  match anon_record_inferred(val, struct_sets) {\n    Some(s) => Some(s),\n    None => infer_arg_type_name(val, struct_sets, var_types, fn_returns)\n  }\n}\n\n// `binding.field` -> `__rec_field(binding, slot)` when `binding` is an\n// anonymous-record binding (a `__anonrec:` var_types entry) that carries `field`.\n// `robj` is the already-rewritten receiver. None leaves the EDot untouched (a\n// declared-struct field, a tuple index, or an unknown receiver).\nfn anon_dot_rewrite(obj: Expr, field: String, off: Int, robj: Expr, var_types: Array[(String, String)]) -> Option[Expr] {\n  match obj {\n    EIdent(vn, _) => match lookup_var_type(var_types, vn) {\n      Some(t) => {\n        let idx = anon_field_index(t, field)\n        if idx >= 0 {\n          Some(ECall(EIdent(\"__rec_field\", off), [\n            robj,\n            EInt(idx)\n          ], off))\n        } else {\n          None\n        }\n      },\n      None => None\n    },\n    _ => None\n  }\n}\n\n// The hidden bounds threaded into a generic: (type-param, trait, receiver\n// parameter index). Empty registry sentinel for arrays of these.\nfn empty_threaded() -> Array[(String, String, Int)] {\n  array_empty()\n}\n\nfn empty_dict_binds() -> Array[(String, String, String, Array[String])] {\n  array_empty()\n}\n\n// A function already carries a threaded dict parameter (idempotency guard\n// against desugaring the same stmts twice while bounds are still present).\nfn already_threaded(params: Array[(String, Option[TypeExpr])]) -> Bool {\n  if Array::length(params) == 0 {\n    false\n  } else {\n    let (pname, _) = Array::get(params, 0)\n    String::starts_with(pname, \"__dict_\")\n  }\n}\n\n// Index of the first parameter whose annotation is exactly the type parameter\n// `tp` (`x: T`). -1 when `T` does not appear directly as a parameter type.\nfn find_recv_index(params: Array[(String, Option[TypeExpr])], tp: String) -> Int {\n  let mut i = 0\n  let mut idx = -1\n  while i < Array::length(params) {\n    let (_, ann) = Array::get(params, i)\n    match ann {\n      Some(TyName(n)) => if n == tp {\n        idx = i\n        i = Array::length(params)\n      } else {\n        i = i + 1\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  idx\n}\n\n// Build the registry of top-level generics that need dictionary threading:\n// each is a (function name, threaded-bounds) pair. A bound is threaded only\n// when its trait is method-bearing and the type parameter appears directly as\n// a parameter type.\n// The type-constructor head of a qualified name (`Array::show2` -> \"Array\"),\n// or \"\" if unqualified.\nfn qualified_head(name: String) -> String {\n  match split_qualified(name) {\n    Some(parts) => {\n      let (head, _) = parts\n      head\n    },\n    None => \"\"\n  }\n}\n\n// Type names of bounded generic impls (`impl [T: Bound] Trait for C`). Their\n// methods (`C::m`) carry the bound `T` even though it appears nested in the\n// receiver (`self: C[T]`), so they must be threaded a witness dict (the normal\n// \"type param is a direct parameter\" rule misses them).\nfn collect_generic_impl_types(stmts: Array[Stmt]) -> Array[String] {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImpl(tparams, tbounds, _, type_name) => if Array::length(tparams) > 0 {\n        let mut has_bound = false\n        let mut bi = 0\n        while bi < Array::length(tbounds) {\n          let (_, bs) = Array::get(tbounds, bi)\n          let mut bj = 0\n          while bj < Array::length(bs) {\n            if Array::get(bs, bj) != \"\" {\n              has_bound = true\n            } else {\n              ()\n            }\n            bj = bj + 1\n          }\n          bi = bi + 1\n        }\n        if has_bound {\n          Array::push(out, type_name)\n        } else {\n          ()\n        }\n      } else (),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn build_gens(stmts: Array[Stmt], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], gimpl_types: Array[String]) -> Array[(String, Array[(String, String, Int)])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, _, body) => match body {\n        EFn(_, bounds, params, _, _, _) => if already_threaded(params) {\n          ()\n        } else {\n          let threaded = empty_threaded()\n          let mut bi = 0\n          while bi < Array::length(bounds) {\n            let (tp, trait_list) = Array::get(bounds, bi)\n            let mut ti = 0\n            while ti < Array::length(trait_list) {\n              let tr = Array::get(trait_list, ti)\n              match lookup_trait_sigs(traits, tr) {\n                Some(_) => {\n                  let ridx = find_recv_index(params, tp)\n                  if ridx >= 0 {\n                    Array::push(threaded, (tp, tr, ridx))\n                  } else if str_array_contains(gimpl_types, qualified_head(fname)) {\n                    // bounded generic-impl method: T is nested in `self: C[T]`,\n                    // so there is no inferable receiver argument — the witness\n                    // dict is supplied when C's witness is built. Thread with -1.\n                    Array::push(threaded, (tp, tr, 0 - 1))\n                  } else {\n                    ()\n                  }\n                },\n                None => ()\n              }\n              ti = ti + 1\n            }\n            bi = bi + 1\n          }\n          if Array::length(threaded) > 0 {\n            Array::push(out, (fname, threaded))\n          } else {\n            ()\n          }\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn lookup_gen(gens: Array[(String, Array[(String, String, Int)])], name: String) -> Option[Array[(String, String, Int)]] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(gens) {\n    let (gname, threaded) = Array::get(gens, i)\n    if gname == name {\n      result = Some(threaded)\n      i = Array::length(gens)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// Find the dict parameter to dispatch a `head::member` call against, given the\n// dict bindings in scope: the binding whose type-param is `head` and whose\n// trait declares `member`.\nfn find_dict_for_method(dict_binds: Array[(String, String, String, Array[String])], head: String, member: String) -> Option[String] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(dict_binds) {\n    let (tp, _, dict_pname, methods) = Array::get(dict_binds, i)\n    if tp == head && str_array_contains(methods, member) {\n      result = Some(dict_pname)\n      i = Array::length(dict_binds)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// Find the in-scope dict parameter bound to type-param `tparam` for `trait_name`\n// (used to forward a caller's own witness into a generic->generic call).\nfn find_dict_for_trait(dict_binds: Array[(String, String, String, Array[String])], tparam: String, trait_name: String) -> Option[String] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(dict_binds) {\n    let (tp, tr, dict_pname, _) = Array::get(dict_binds, i)\n    if tp == tparam && tr == trait_name {\n      result = Some(dict_pname)\n      i = Array::length(dict_binds)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// The first element of an array-literal receiver (for a bounded generic impl\n// `impl [T: Bound] Trait for Array`, the element determines T's witness).\nfn first_array_elem(e: Expr) -> Option[Expr] {\n  match e {\n    EArray(elems) => if Array::length(elems) > 0 {\n      Some(Array::get(elems, 0))\n    } else None,\n    _ => None\n  }\n}\n\n// Build the witness `ERecord` for a concrete type `cname` implementing\n// `trait_name`. Codegen resolves it to the dict struct structurally by field\n// names.\n//\n// For a plain impl each method field is the free function `C::method`. For a\n// BOUNDED generic impl (`impl [T: Bound] Trait for C`) the method\n// `C::method` was threaded to take its own `Bound` dictionary for the element\n// type, so the field is instead a closure that supplies that nested dictionary:\n//   { method: (__w) -> C::method(<element Bound dict>, __w) }\n// The element dict is built recursively from the array literal's first element\n// (`arg_expr`) — a dictionary-of-dictionaries (#5 Increment B). If the element\n// type / dict cannot be determined the whole witness fails to build (returns\n// None), so the call is left unrewritten (a loud arity error, never a silent\n// miscompile).\nfn build_concrete_dict(cname: String, trait_name: String, traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], gens: Array[(String, Array[(String, String, Int)])], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)], arg_expr: Expr) -> Option[Expr] {\n  match lookup_trait_sigs(traits, trait_name) {\n    Some(sigs) => {\n      let mnames = method_names_of_sigs(sigs)\n      let recfields = array_empty()\n      let mut mi = 0\n      let mut failed = false\n      while mi < Array::length(mnames) {\n        let m = Array::get(mnames, mi)\n        let qm = String::concat(cname, String::concat(\"::\", m))\n        if not(fn_exists(fn_returns, qm)) {\n          // No `cname::m` free function exists — `cname` does not actually\n          // implement `trait_name`. Refuse to fabricate a witness (which would\n          // otherwise silently dispatch to a same-shaped function), so the call\n          // is left unrewritten and fails loudly instead of miscompiling.\n          failed = true\n        } else {\n        match lookup_gen(gens, qm) {\n          Some(threaded) => {\n            // `qm` is a bounded generic-impl method: supply its element dict(s).\n            match first_array_elem(arg_expr) {\n              Some(elem) => match infer_arg_type_name(elem, struct_sets, var_types, fn_returns) {\n                Some(en) => {\n                  let callargs = empty_expr_array()\n                  let mut bi = 0\n                  let mut subok = true\n                  while bi < Array::length(threaded) {\n                    let (_, btrait, _) = Array::get(threaded, bi)\n                    match build_concrete_dict(en, btrait, traits, gens, struct_sets, var_types, fn_returns, elem) {\n                      Some(sd) => Array::push(callargs, sd),\n                      None => {\n                        subok = false\n                      }\n                    }\n                    bi = bi + 1\n                  }\n                  if subok {\n                    Array::push(callargs, EIdent(\"__w\", -1))\n                    let closure = EFn(empty_str_array(), array_empty(), Array::slice([\n                      (\"__w\", None)\n                    ], 0, 1), None, None, ECall(EIdent(qm, -1), callargs, -1))\n                    Array::push(recfields, (m, closure))\n                  } else {\n                    failed = true\n                  }\n                },\n                None => {\n                  failed = true\n                }\n              },\n              None => {\n                failed = true\n              }\n            }\n          },\n          None => Array::push(recfields, (m, EIdent(qm, -1)))\n        }\n        }\n        mi = mi + 1\n      }\n      if failed {\n        None\n      } else {\n        Some(ERecord(\"\", recfields, empty_ty_args()))\n      }\n    },\n    None => None\n  }\n}\n\n// Synthesize the witness dictionaries for a call to a transformed generic, or\n// None when any receiver's witness cannot be determined (the call is then left\n// unrewritten). Each bound is satisfied either by a concrete dict literal (the\n// receiver type is syntactically known) or by forwarding the caller's own dict\n// parameter (the receiver is a type parameter bound by the same trait in the\n// enclosing generic — the generic->generic case).\nfn synth_dicts(threaded: Array[(String, String, Int)], orig_args: Array[Expr], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], dict_binds: Array[(String, String, String, Array[String])], fn_returns: Array[(String, String)], gens: Array[(String, Array[(String, String, Int)])]) -> Option[Array[Expr]] {\n  let dicts = empty_expr_array()\n  let mut ok = true\n  let mut bi = 0\n  while bi < Array::length(threaded) {\n    let (_, trait_name, recv_idx) = Array::get(threaded, bi)\n    if ok && recv_idx >= 0 && recv_idx < Array::length(orig_args) {\n      let recv_arg = Array::get(orig_args, recv_idx)\n      match infer_arg_type_name(recv_arg, struct_sets, var_types, fn_returns) {\n        Some(nm) => match find_dict_for_trait(dict_binds, nm, trait_name) {\n          Some(dict_pname) => Array::push(dicts, EIdent(dict_pname, -1)),\n          None => match build_concrete_dict(nm, trait_name, traits, gens, struct_sets, var_types, fn_returns, recv_arg) {\n            Some(dict) => Array::push(dicts, dict),\n            None => {\n              ok = false\n            }\n          }\n        },\n        None => {\n          ok = false\n        }\n      }\n    } else {\n      ok = false\n    }\n    bi = bi + 1\n  }\n  if ok {\n    Some(dicts)\n  } else {\n    None\n  }\n}\n\nfn concat_expr_arrays(a: Array[Expr], b: Array[Expr]) -> Array[Expr] {\n  let out = empty_expr_array()\n  let mut i = 0\n  while i < Array::length(a) {\n    Array::push(out, Array::get(a, i))\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(b) {\n    Array::push(out, Array::get(b, j))\n    j = j + 1\n  }\n  out\n}\n\n// Seed a var-type environment from a function's parameters whose annotation is\n// a bare type name `T` — concrete (`Point`) for call-site dict synthesis, or a\n// type parameter (`T`) for generic->generic dict forwarding. The distinction is\n// made at use time against the in-scope dict bindings. `tparams` is retained for\n// signature compatibility but no longer filters (both kinds are tracked).\nfn seed_var_types(params: Array[(String, Option[TypeExpr])], tparams: Array[String], base: Array[(String, String)]) -> Array[(String, String)] {\n  let _ = tparams\n  let out = array_empty()\n  let mut b = 0\n  while b < Array::length(base) {\n    Array::push(out, Array::get(base, b))\n    b = b + 1\n  }\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, ann) = Array::get(params, i)\n    match ann {\n      Some(TyName(tn)) => Array::push(out, (pname, tn)),\n      // A generic struct annotation `x: LazyIter[T]` -> track the head name so\n      // `for x in <param>` over a generic iterator type resolves (#636).\n      Some(TyApp(tn, _)) => Array::push(out, (pname, tn)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// Collect the return-type name of every top-level `let f = (..) -> R { .. }`\n// (R only when it is a bare type name), so the `for` desugar can tell an\n// iterator (`C::next` exists) from an iterable (`C::iter` returns an iterator).\nfn collect_fn_returns(stmts: Array[Stmt]) -> Array[(String, String)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, _, body) => match body {\n        EFn(_, _, _, ret, _, _) => {\n          // Record the head name of the return type: `TyName(n)` -> n,\n          // `TyApp(n, _)` -> n (so a generic `iter() -> LazyIter[T]` resolves to\n          // `LazyIter`, and an async `next() -> Future[Option[..]]` resolves to\n          // `Future` so the `for await` desugar can tell async from sync).\n          let rn = match ret {\n            Some(te) => match te {\n              TyName(n) => n,\n              TyApp(n, _) => n,\n              _ => \"\"\n            },\n            None => \"\"\n          }\n          Array::push(out, (fname, rn))\n        },\n        _ => ()\n      },\n      // `fn name(..) -> R { .. }` declares parse to SFnDecl, not SLet (see\n      // parse_fn_stmt_general) -- without this case every `fn`-declared\n      // function (the more common spelling) was invisible here, silently\n      // missing from the `for`/async-vs-sync desugar and other fn_returns\n      // consumers below.\n      SFnDecl(_, fname, body, _, _) => match body {\n        EFn(_, _, _, ret, _, _) => {\n          let rn = match ret {\n            Some(te) => match te {\n              TyName(n) => n,\n              TyApp(n, _) => n,\n              _ => \"\"\n            },\n            None => \"\"\n          }\n          Array::push(out, (fname, rn))\n        },\n        _ => ()\n      },\n      // #672: map each enum variant constructor to its enum name, so a\n      // `let t = Node(...)` binding resolves `t`'s type for the `==` dispatch\n      // (infer_arg_type_name reads ctor calls through fn_returns).\n      SEnum(_, ename, _, variants, _) => {\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, _) = Array::get(variants, vi)\n          Array::push(out, (vname, ename))\n          vi = vi + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  // Perf: this table holds every top-level fn + enum variant of the merged\n  // compile (thousands of entries) and fn_exists/fn_return_type consulted it\n  // LINEARLY per expression during the rewrite. Sort once (STABLE, so the\n  // leftmost duplicate stays the linear scan's \"first match\") and let the\n  // helpers below binary-search. Nothing outside those helpers reads the\n  // table positionally, so the order change is invisible.\n  let names = array_empty()\n  let mut ni = 0\n  while ni < Array::length(out) {\n    let (n, _) = Array::get(out, ni)\n    Array::push(names, n)\n    ni = ni + 1\n  }\n  let perm = sort_perm_by_names(names)\n  let sorted = array_empty()\n  let mut pi = 0\n  while pi < Array::length(perm) {\n    Array::push(sorted, Array::get(out, Array::get(perm, pi)))\n    pi = pi + 1\n  }\n  sorted\n}\n\n// Leftmost binary search over the SORTED fn_returns table (see\n// collect_fn_returns). Leftmost-of-run preserves first-match-wins for\n// duplicate names.\nfn fn_returns_find(fn_returns: Array[(String, String)], fname: String) -> Int {\n  let mut lo = 0\n  let mut hi = Array::length(fn_returns)\n  while lo < hi {\n    let mid = (lo + hi) / 2\n    let (n, _) = Array::get(fn_returns, mid)\n    if str_lt(n, fname) {\n      lo = mid + 1\n    } else {\n      hi = mid\n    }\n  }\n  let mut res = -1\n  if lo < Array::length(fn_returns) {\n    let (n2, _) = Array::get(fn_returns, lo)\n    if n2 == fname {\n      res = lo\n    }\n  }\n  res\n}\n\nfn fn_exists(fn_returns: Array[(String, String)], fname: String) -> Bool {\n  fn_returns_find(fn_returns, fname) >= 0\n}\n\nfn fn_return_type(fn_returns: Array[(String, String)], fname: String) -> Option[String] {\n  let idx = fn_returns_find(fn_returns, fname)\n  if idx < 0 {\n    None\n  } else {\n    let (_, rt) = Array::get(fn_returns, idx)\n    if String::length(rt) == 0 {\n      None\n    } else {\n      Some(rt)\n    }\n  }\n}\n\n// Desugar `for x in it { body }` over a struct iterator type `C` into a loop\n// driven by the functional `C::next(self) -> Option[(T, Self)]`:\n//\n//   let mut __iter_cur = it\n//   let mut __iter_go = true\n//   while __iter_go {\n//     match C::next(__iter_cur) {\n//       Some((x, __iter_rest)) => { __iter_cur = __iter_rest; body },\n//       None => { __iter_go = false }\n//     }\n//   }\n//\n// Nested loops shadow the `__iter_*` names correctly (ELetMut scoping). The\n// optional index binding is not supported for iterators (first slice).\n//\n// `nextcall` is the expression yielding `Option[(T, Self)]` for the current\n// cursor `__iter_cur`: a bare `C::next(__iter_cur)` for a sync iterator, or\n// `await(C::next(__iter_cur))` (a `Future[Option[(T, Self)]]` unwrapped) for an\n// async iterator under `for await`.\nfn build_iter_for_with(name: String, nextcall: Expr, iter: Expr, body: Expr) -> Expr {\n  let some_arm = (PCtor(\"Some\", [\n    PTuple([\n      PBind(name),\n      PBind(\"__iter_rest\")\n    ])\n  ]), EAssign(\"__iter_cur\", EIdent(\"__iter_rest\", -1), body))\n  let none_arm = (PCtor(\"None\", array_empty()), EAssign(\"__iter_go\", EBool(false), EUnit))\n  let loop_body = EMatch(nextcall, [\n    some_arm,\n    none_arm\n  ])\n  // Bind the iterand through an immutable `__iter_src` and initialize the\n  // mutable cursor from that ident, rather than from `iter` directly. The\n  // cursor is consumed by `C::next(__iter_cur)` and then reassigned each\n  // iteration; initializing it from a fresh heap value (e.g. a struct literal\n  // `for x in Range::{..}`) made that consume-then-reassign double-free the\n  // initial value under RC. Seeding from a stable binding mirrors the working\n  // `let r = ..; for x in r` shape so the ownership accounting balances (#704).\n  ELet(\"__iter_src\", iter, ELetMut(\"__iter_cur\", EIdent(\"__iter_src\", -1), ELetMut(\"__iter_go\", EBool(true), EWhile(EIdent(\"__iter_go\", -1), loop_body), -1), -1), -1)\n}\n\nfn next_call_for(ctype: String) -> Expr {\n  ECall(EIdent(String::concat(ctype, \"::next\"), -1), [\n    EIdent(\"__iter_cur\", -1)\n  ], -1)\n}\n\nfn build_iter_for(name: String, ctype: String, iter: Expr, body: Expr) -> Expr {\n  build_iter_for_with(name, next_call_for(ctype), iter, body)\n}\n\n// #736: `for x in xs` over a USER type implementing the indexed Iterable\n// protocol (`C::iter_length(Self) -> Int` + `C::iter_get(Self, Int) -> T`,\n// e.g. @vibe/core's List) desugars to an index-driven loop:\n//\n//   let __iter_src = xs\n//   let __iter_n = C::iter_length(__iter_src)\n//   let mut __iter_i = 0\n//   while __iter_i < __iter_n {\n//     let x = C::iter_get(__iter_src, __iter_i)\n//     body\n//     __iter_i = __iter_i + 1\n//   }\n//\n// The iterand is seeded through an immutable `__iter_src` for the same RC\n// ownership reason as build_iter_for_with (#704). Unlike the next-protocol\n// desugar, the optional index binding IS supported here (the loop counter is\n// the index): `for x, i in xs` binds `i` to the current `__iter_i`. The loop\n// is a statement (no per-iteration result collection).\nfn build_indexed_iter_for(name: String, idx: Option[String], ctype: String, iter: Expr, body: Expr) -> Expr {\n  let get_call = ECall(EIdent(String::concat(ctype, \"::iter_get\"), -1), [\n    EIdent(\"__iter_src\", -1),\n    EIdent(\"__iter_i\", -1)\n  ], -1)\n  let len_call = ECall(EIdent(String::concat(ctype, \"::iter_length\"), -1), [\n    EIdent(\"__iter_src\", -1)\n  ], -1)\n  let incr = EAssign(\"__iter_i\", EBinOp(\"+\", EIdent(\"__iter_i\", -1), EInt(1)), EUnit)\n  let bound_body = match idx {\n    Some(iname) => ELet(iname, EIdent(\"__iter_i\", -1), body, -1),\n    None => body\n  }\n  let loop_body = ELet(name, get_call, ESeq(bound_body, incr), -1)\n  ELet(\"__iter_src\", iter, ELet(\"__iter_n\", len_call, ELetMut(\"__iter_i\", EInt(0), EWhile(EBinOp(\"<\", EIdent(\"__iter_i\", -1), EIdent(\"__iter_n\", -1)), loop_body), -1), -1), -1)\n}\n\n// `for await` over an async iterator type `C` whose\n// `C::next(self) -> Future[Option[(T, Self)]] with { Async }`: identical to the\n// sync loop but each step `await`s the next-future. `await` is the M1a builtin\n// (`await(Future[T]) -> T`); on the synchronous ready-future codegen it unwraps\n// in place, so this also runs on the linear backend today.\nfn build_await_iter_for(name: String, ctype: String, iter: Expr, body: Expr) -> Expr {\n  let awaited = ECall(EIdent(\"await\", -1), [\n    next_call_for(ctype)\n  ], -1)\n  build_iter_for_with(name, awaited, iter, body)\n}\n\n// `for await x in pull { body }` over a pull closure `pull : () -> Option[T]`\n// (host-state async iterator, e.g. `stdin_stream`): drive `pull()` to `None`.\n// This is the M2c-3 pull model, moved here from the parser so `for await` shares\n// one type-directed desugar with the trait iterators (a struct `C` with a\n// `C::next` drives the iterator loop above; anything else — a pull closure or a\n// call whose return type is unknown — falls back to this).\nfn build_pull_for_in(value_name: String, index_name: Option[String], iterable: Expr, body: Expr) -> Expr {\n  let some_arm = match index_name {\n    Some(ix) => ESeq(body, EAssign(ix, EBinOp(\"+\", EIdent(ix, -1), EInt(1)), EUnit)),\n    None => ESeq(body, EUnit)\n  }\n  let loop_body = EMatch(ECall(EIdent(\"__pull_next\", -1), array_empty(), -1), [\n    (PCtor(\"Some\", [\n      PBind(value_name)\n    ]), some_arm),\n    (PCtor(\"None\", array_empty()), EAssign(\"__pull_continue\", EBool(false), EUnit))\n  ])\n  let core_loop = ELetMut(\"__pull_continue\", EBool(true), EWhile(EIdent(\"__pull_continue\", -1), loop_body), -1)\n  let with_index = match index_name {\n    Some(ix) => ELetMut(ix, EInt(0), core_loop, -1),\n    None => core_loop\n  }\n  ELet(\"__pull_next\", iterable, with_index, -1)\n}\n\n// Unwrap a `for await` marker: the parser wraps the iterable of a `for await`\n// loop in `__await_iter(<iterable>)` (a non-builtin sentinel call) so this pass\n// — which has type information the parser lacks — picks the iterator vs pull\n// desugar. Returns the inner iterable when `iter` is the marker.\nfn for_await_inner(iter: Expr) -> Option[Expr] {\n  match iter {\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if nm == \"__await_iter\" && Array::length(args) == 1 {\n        Some(Array::get(args, 0))\n      } else {\n        None\n      },\n      _ => None\n    },\n    _ => None\n  }\n}\n\n// Does `fname`'s recorded return-type head indicate an async iterator\n// (`next() -> Future[Option[..]]`)? Drives the `await`-wrapped loop choice.\nfn fn_return_is_future(fn_returns: Array[(String, String)], fname: String) -> Bool {\n  match fn_return_type(fn_returns, fname) {\n    Some(head) => head == \"Future\",\n    None => false\n  }\n}\n\n// #827: is `inner` positively a pull-closure source? The pull loop binds the\n// iteratee as `__pull_next` and CALLS it, so lowering anything that is not a\n// function value that way is a call_indirect on a non-function pointer — an\n// out-of-bounds table trap at runtime. Only two shapes are accepted: a lambda\n// literal, and a call to a known top-level function whose recorded return-type\n// head is empty (a non-named return — the closure-returning sources like\n// `stdin_stream: (Int) -> (() -> Option[String])`; a named head would have\n// classified in the Some branch instead).\nfn for_await_is_pull_source(inner: Expr, fn_returns: Array[(String, String)]) -> Bool {\n  match inner {\n    EFn(_, _, _, _, _, _) => true,\n    ECall(callee, _, _) => match callee {\n      EIdent(fname, _) => fn_exists(fn_returns, fname),\n      _ => false\n    },\n    _ => false\n  }\n}\n\n// #827: located \"cannot classify this `for await`\" error. The desugar has no\n// source text, so the position rides the checker's `[@off=N]` marker format\n// (decoded to line:col by the located-diagnostics layer where available;\n// harmless plain text otherwise). String::concat only (NUL hazard for `+`).\nfn for_await_classify_error(inner: Expr) -> String {\n  let off = match inner {\n    EIdent(_, o) => o,\n    ECall(_, _, o) => o,\n    _ => -1\n  }\n  let base = \"for await: cannot infer the type of the loop source; annotate it (e.g. `s: Stream[Int]`) or iterate a Stream/Array expression directly\"\n  if off >= 0 {\n    String::concat(base, String::concat(\" [@off=\", String::concat(__to_string(off), \"]\")))\n  } else {\n    base\n  }\n}\n\n// `for await x in inner { body }`: classify `inner` and build the loop.\n// `rinner` / `rbody` are the already-rewritten iterable / body. A struct type\n// with a `::next` drives the iterator loop (`await`-wrapped when async); a\n// Stream/Array head drives the plain array loop (#822); a positively\n// pull-shaped source (see for_await_is_pull_source) drives the pull-closure\n// loop. Anything else — most commonly an UNannotated lambda param whose type\n// this syntactic pass cannot see — is a compile error (#827): the old silent\n// pull fallback compiled fine and then trapped at runtime (call_indirect on\n// the stream's array pointer).\nfn classify_for_await_loop(name: String, idx: Option[String], inner: Expr, rinner: Expr, rbody: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {\n  match infer_arg_type_name(inner, struct_sets, var_types, fn_returns) {\n    Some(tn) => if fn_exists(fn_returns, String::concat(tn, \"::next\")) {\n      if fn_return_is_future(fn_returns, String::concat(tn, \"::next\")) {\n        build_await_iter_for(name, tn, rinner, rbody)\n      } else {\n        build_iter_for(name, tn, rinner, rbody)\n      }\n    } else {\n      if tn == \"Stream\" || tn == \"Array\" {\n        // #822: the builtin Stream is eager Array-backed (ADR-0012), so\n        // `for await x in <stream>` (and over a plain Array) iterates with\n        // the plain array loop. The pull lowering would bind the VALUE as\n        // `__pull_next` and call it — call_indirect on an array pointer,\n        // i.e. an out-of-bounds table trap at runtime.\n        EForIn(name, idx, rinner, rbody)\n      } else {\n        throw(for_await_classify_error(inner))\n      }\n    },\n    None => if for_await_is_pull_source(inner, fn_returns) {\n      build_pull_for_in(name, idx, rinner, rbody)\n    } else {\n      throw(for_await_classify_error(inner))\n    }\n  }\n}\n\n// `for x in iter { body }`: iterator (`::next`) / iterable (`::iter`) / array\n// classification. `riter` / `rbody` are already rewritten.\n// #736: the indexed-Iterable slice of for-loop classification, USER types only\n// (struct_sets gate — Array/String/Map keep the builtin EForIn lowering even\n// though the prelude's Iterable impls define e.g. `Array::iter_length`). Split\n// out of classify_sync_for_loop because it needs no declared trait (the\n// protocol is plain named `C::iter_length`/`C::iter_get` functions, e.g.\n// @vibe/core's List), so it also runs for trait-free programs where the\n// next/iter classification stays gated off.\nfn classify_indexed_for_loop(name: String, idx: Option[String], iter: Expr, riter: Expr, rbody: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {\n  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {\n    Some(tn) => if struct_set_has(struct_sets, tn) && fn_exists(fn_returns, String::concat(tn, \"::iter_length\")) && fn_exists(fn_returns, String::concat(tn, \"::iter_get\")) {\n      build_indexed_iter_for(name, idx, tn, riter, rbody)\n    } else {\n      EForIn(name, idx, riter, rbody)\n    },\n    None => EForIn(name, idx, riter, rbody)\n  }\n}\n\nfn classify_sync_for_loop(name: String, idx: Option[String], iter: Expr, riter: Expr, rbody: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {\n  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {\n    Some(tn) => if fn_exists(fn_returns, String::concat(tn, \"::next\")) {\n      build_iter_for(name, tn, riter, rbody)\n    } else {\n      match fn_return_type(fn_returns, String::concat(tn, \"::iter\")) {\n        Some(itertype) => build_iter_for(name, itertype, ECall(EIdent(String::concat(tn, \"::iter\"), -1), [\n          riter\n        ], -1), rbody),\n        None => classify_indexed_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)\n      }\n    },\n    None => EForIn(name, idx, riter, rbody)\n  }\n}\n\n// #1064 (Codex review on the original fix): a railway-bound name's real type\n// is `val`'s PAYLOAD, not `val`'s own wrapper type -- conflating them broke\n// plain scalar payloads (the common case: `let* rv = half(x)`, `half: Int ->\n// Option[Int]`, `rv: Int`). But when `val` is a LITERAL nested constructor\n// (`let* outer = Some(Some(1))`), the payload genuinely IS an Option/Result\n// value, so `outer` DOES need a var_types entry -- otherwise a follow-up\n// `let* inner = outer` chaining through the bare identifier can't tell it\n// apart from a Result and defaults to the wrong (Ok/Err) arms. Recurse ONE\n// level into a literal `Some(x)`/`Ok(x)` (never `Err(x)` -- Err's own\n// payload is the error value, never itself railway-chained) to recover the\n// payload's head type for exactly this literal-nesting shape; every other\n// `val` shape (a call to a user function, a bare identifier, ...) has no\n// recoverable payload type here (`fn_returns` only carries a call's return\n// head, not its type arguments) and stays untracked, same as the plain\n// scalar fix.\nfn railway_bind_payload_type(val: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {\n  match val {\n    ECall(callee, inner_args, _) => match callee {\n      EIdent(cname, _) => if (cname == \"Some\" || cname == \"Ok\") && Array::length(inner_args) == 1 {\n        infer_arg_type_name(Array::get(inner_args, 0), struct_sets, var_types, fn_returns)\n      } else {\n        None\n      },\n      _ => None\n    },\n    _ => None\n  }\n}\n\n// Extend the local var-type environment with `name` when its bound value's\n// type was inferable. A fresh array (copy) is returned so sibling scopes do not\n// see the binding.\nfn extend_var_types(var_types: Array[(String, String)], name: String, inferred: Option[String]) -> Array[(String, String)] {\n  match inferred {\n    Some(tname) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(var_types) {\n        Array::push(out, Array::get(var_types, i))\n        i = i + 1\n      }\n      Array::push(out, (name, tname))\n      out\n    },\n    None => var_types\n  }\n}\n\n// #672: a qualified constructor `Enum::Variant` -> the unqualified variant\n// `Variant`, when `member` is a constructor of enum `head` (variants are bound\n// unqualified, and codegen's ctor table is keyed unqualified). `head` MUST be a\n// known user enum/struct (`struct_sets` includes enum names) — this is the gate\n// that keeps builtin qualified calls like `String::join` / `Array::map` alone\n// even when a same-named function (`join`/`map`) happens to return that type.\nfn qual_ctor_member(head: String, member: String, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Option[String] {\n  if struct_set_has(struct_sets, head) {\n    match fn_return_type(fn_returns, member) {\n      Some(en) => if en == head {\n        Some(member)\n      } else {\n        None\n      },\n      None => None\n    }\n  } else {\n    None\n  }\n}\n\n// #635: classify a call as a railway-bind/op sentinel. Returns\n//   0 = `__try_bind(val, (name) -> rest)` (callee `__try_bind`, 2 args, arg1\n//       a 1-param closure),\n//   1 = `__try_op(val)` (callee `__try_op`, exactly 1 arg),\n//   2 = not a sentinel (ordinary call; e.g. a user fn that happens to share the\n//       name but with a different arity/shape).\nfn try_sentinel(callee: Expr, args: Array[Expr]) -> Int {\n  match callee {\n    EIdent(n, _) => if n == \"__try_bind\" {\n      if Array::length(args) == 2 {\n        match Array::get(args, 1) {\n          EFn(_, _, ps, _, _, _) => if Array::length(ps) == 1 {\n            0\n          } else {\n            2\n          },\n          _ => 2\n        }\n      } else {\n        2\n      }\n    } else if n == \"__try_op\" {\n      if Array::length(args) == 1 {\n        1\n      } else {\n        2\n      }\n    } else {\n      2\n    },\n    _ => 2\n  }\n}\n\n// #941: best-effort char offset of a railway operand, so the desugar-generated\n// failure-track nodes (`Err(e)` / `None`) carry the `?`/`let*` operand's own\n// source position — the checker's Option⇔Result mixing diagnostics anchor on\n// it. -1 (unlocated) when the operand carries no offset.\nfn railway_val_off(e: Expr) -> Int {\n  match e {\n    EIdent(_, off) => off,\n    ECall(callee, _, off) => if off >= 0 {\n      off\n    } else {\n      railway_val_off(callee)\n    },\n    EDot(base, _, off, _) => if off >= 0 {\n      off\n    } else {\n      railway_val_off(base)\n    },\n    EBinOp(_, lhs, _) => railway_val_off(lhs),\n    _ => -1\n  }\n}\n\n// #635: lower the `let* name = val <rest>` sentinel by `val`'s head type.\n// Option -> `match val { Some(name) => rest, None => None }`; else (Result, or\n// undeterminable -> default Result, today's behavior) the railway Result match\n// `match val { Ok(name) => rest, Err(__bind_err) => Err(__bind_err) }`.\nfn lower_try_bind(val: Expr, name: String, rest: Expr, inferred: Option[String]) -> Expr {\n  let voff = railway_val_off(val)\n  match inferred {\n    Some(tn) => if tn == \"Option\" {\n      EMatch(val, [\n        (PCtor(\"Some\", [\n          PBind(name)\n        ]), rest),\n        (PCtor(\"None\", array_empty()), EIdent(\"None\", voff))\n      ])\n    } else {\n      EMatch(val, [\n        (PCtor(\"Ok\", [\n          PBind(name)\n        ]), rest),\n        (PCtor(\"Err\", [\n          PBind(\"__bind_err\")\n        ]), ECall(EIdent(\"Err\", voff), [\n          EIdent(\"__bind_err\", -1)\n        ], voff))\n      ])\n    },\n    None => EMatch(val, [\n      (PCtor(\"Ok\", [\n        PBind(name)\n      ]), rest),\n      (PCtor(\"Err\", [\n        PBind(\"__bind_err\")\n      ]), ECall(EIdent(\"Err\", voff), [\n        EIdent(\"__bind_err\", -1)\n      ], voff))\n    ])\n  }\n}\n\n// #635: lower the `val?` sentinel by `val`'s head type. Option -> yield the\n// inner value on `Some`, early-`return None` on `None`. Else (Result, or\n// undeterminable -> default Result) -> yield on `Ok`, early-`return Err(e)` on\n// `Err`. Uses `EReturn`, so the enclosing function short-circuits.\nfn lower_try_op(val: Expr, inferred: Option[String]) -> Expr {\n  let voff = railway_val_off(val)\n  match inferred {\n    Some(tn) => if tn == \"Option\" {\n      EMatch(val, [\n        (PCtor(\"Some\", [\n          PBind(\"__try_v\")\n        ]), EIdent(\"__try_v\", -1)),\n        (PCtor(\"None\", array_empty()), EReturn(EIdent(\"None\", voff)))\n      ])\n    } else {\n      EMatch(val, [\n        (PCtor(\"Ok\", [\n          PBind(\"__try_v\")\n        ]), EIdent(\"__try_v\", -1)),\n        (PCtor(\"Err\", [\n          PBind(\"__try_e\")\n        ]), EReturn(ECall(EIdent(\"Err\", voff), [\n          EIdent(\"__try_e\", -1)\n        ], voff)))\n      ])\n    },\n    None => EMatch(val, [\n      (PCtor(\"Ok\", [\n        PBind(\"__try_v\")\n      ]), EIdent(\"__try_v\", -1)),\n      (PCtor(\"Err\", [\n        PBind(\"__try_e\")\n      ]), EReturn(ECall(EIdent(\"Err\", voff), [\n        EIdent(\"__try_e\", -1)\n      ], voff)))\n    ])\n  }\n}\n\n// #635: standalone railway-sentinel lowering. Walks an expr and rewrites only\n// the `__try_bind`/`__try_op` sentinels (everything else is recursed\n// structurally unchanged), type-directing each by `infer_arg_type_name`. Runs\n// from BOTH the checker (`check_program`, where the heavy dict-passing pass does\n// NOT run) and — idempotently — the codegen `desugar_trait_dicts`. It is inert\n// for programs that use no `let*`/`?` (no sentinels present). `var_types` tracks\n// locals so `let* x = some_opt` then `let* y = uses(x)` resolves x's type.\nfn railway_rw(expr: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {\n  match expr {\n    ECall(callee, args, off) => {\n      let k = try_sentinel(callee, args)\n      if k == 0 {\n        let val = Array::get(args, 0)\n        match Array::get(args, 1) {\n          EFn(_, _, ps, _, _, rest) => {\n            let (name, _) = Array::get(ps, 0)\n            let rwval = railway_rw(val, struct_sets, var_types, fn_returns)\n            let inferred = infer_arg_type_name(val, struct_sets, var_types, fn_returns)\n            // #1064: `name` binds to the UNWRAPPED payload (`Some(name)`'s\n            // field), never to a value of `inferred`'s own type (the\n            // wrapper \"Option\"/\"Result\" of `val`) -- recording name ->\n            // inferred unconditionally here conflated the two, so a later\n            // `name == <int literal>` in `rest` was misclassified by\n            // infer_arg_type_name's var_types lookup as an Option/Result\n            // operand and routed through the structural opt_eq_match/\n            // result_eq_match rewrite instead of a scalar comparison,\n            // silently computing nonsense for the common scalar-payload\n            // case. `railway_bind_payload_type` recovers the real payload\n            // type for the one shape it CAN (a literal `Some(x)`/`Ok(x)`\n            // nesting, e.g. `let* outer = Some(Some(1))`) so a follow-up\n            // `let* inner = outer` still chains correctly; every other\n            // shape (a plain function call, a bare identifier, ...) stays\n            // untracked, falling through infer_arg_type_name to `None`,\n            // which keeps the plain scalar `==`/`!=` codegen path.\n            let body_vars = extend_var_types(var_types, name, railway_bind_payload_type(val, struct_sets, var_types, fn_returns))\n            let rwrest = railway_rw(rest, struct_sets, body_vars, fn_returns)\n            lower_try_bind(rwval, name, rwrest, inferred)\n          },\n          _ => EUnit\n        }\n      } else if k == 1 {\n        let val = Array::get(args, 0)\n        let rwval = railway_rw(val, struct_sets, var_types, fn_returns)\n        lower_try_op(rwval, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      } else {\n        let rwargs = for a in args {\n          railway_rw(a, struct_sets, var_types, fn_returns)\n        }\n        match map_index_rewrite(callee, args, rwargs, struct_sets, var_types, fn_returns) {\n          Some(map_get) => map_get,\n          None => ECall(railway_rw(callee, struct_sets, var_types, fn_returns), rwargs, off)\n        }\n      }\n    },\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EUnit => expr,\n    ESpread(e) => ESpread(railway_rw(e, struct_sets, var_types, fn_returns)),\n    EStringInterp(_) => expr,\n    EIdent(_, _) => expr,\n    ETuple(elems) => ETuple(for e in elems {\n      railway_rw(e, struct_sets, var_types, fn_returns)\n    }),\n    EArray(elems) => EArray(for e in elems {\n      railway_rw(e, struct_sets, var_types, fn_returns)\n    }),\n    ERecord(rn, fields, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, fval) = Array::get(fields, i)\n        Array::push(out, (fname, railway_rw(fval, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fields) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (k, v) = Array::get(fields, i)\n        Array::push(out, (k, railway_rw(v, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(railway_rw(c, struct_sets, var_types, fn_returns), railway_rw(t, struct_sets, var_types, fn_returns), railway_rw(e, struct_sets, var_types, fn_returns)),\n    ELet(name, val, body, soff) => {\n      let new_val = railway_rw(val, struct_sets, var_types, fn_returns)\n      let body_vars = extend_var_types(var_types, name, anon_or_infer(val, struct_sets, var_types, fn_returns))\n      ELet(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns), soff)\n    },\n    ELetRec(name, val, body) => ELetRec(name, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(body, struct_sets, var_types, fn_returns)),\n    ELetMut(name, val, body, soff) => {\n      let new_val = railway_rw(val, struct_sets, var_types, fn_returns)\n      let body_vars = extend_var_types(var_types, name, anon_or_infer(val, struct_sets, var_types, fn_returns))\n      ELetMut(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns), soff)\n    },\n    EAssign(name, val, cont) => EAssign(name, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(cont, struct_sets, var_types, fn_returns)),\n    EAssignOp(name, op, val, cont) => EAssignOp(name, op, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(cont, struct_sets, var_types, fn_returns)),\n    ESeq(a, b) => ESeq(railway_rw(a, struct_sets, var_types, fn_returns), railway_rw(b, struct_sets, var_types, fn_returns)),\n    EMatch(scrut, arms) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, railway_rw(b, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMatch(railway_rw(scrut, struct_sets, var_types, fn_returns), out)\n    },\n    EHandle(scrut, arms) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, railway_rw(b, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      EHandle(railway_rw(scrut, struct_sets, var_types, fn_returns), out)\n    },\n    EWhile(c, b) => EWhile(railway_rw(c, struct_sets, var_types, fn_returns), railway_rw(b, struct_sets, var_types, fn_returns)),\n    ELoop(params, body) => ELoop(for param in params {\n      let (name, init) = param\n      (name, railway_rw(init, struct_sets, var_types, fn_returns))\n    }, railway_rw(body, struct_sets, var_types, fn_returns)),\n    EForIn(name, idx, iter, body) => EForIn(name, idx, railway_rw(iter, struct_sets, var_types, fn_returns), railway_rw(body, struct_sets, var_types, fn_returns)),\n    EBinOp(op, l, r) => EBinOp(op, railway_rw(l, struct_sets, var_types, fn_returns), railway_rw(r, struct_sets, var_types, fn_returns)),\n    EUnaryOp(op, e) => EUnaryOp(op, railway_rw(e, struct_sets, var_types, fn_returns)),\n    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, railway_rw(body, struct_sets, seed_var_types(ps, tp, var_types), fn_returns)),\n    EDot(obj, field, off, fdoff) => {\n      let robj = railway_rw(obj, struct_sets, var_types, fn_returns)\n      match anon_dot_rewrite(obj, field, off, robj, var_types) {\n        Some(rw) => rw,\n        None => EDot(robj, field, off, fdoff)\n      }\n    },\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, railway_rw(body, struct_sets, var_types, fn_returns)),\n    EReturn(e) => EReturn(railway_rw(e, struct_sets, var_types, fn_returns)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(railway_rw(e, struct_sets, var_types, fn_returns))),\n      None => expr\n    },\n    EContinue(exprs) => EContinue(for e in exprs {\n      railway_rw(e, struct_sets, var_types, fn_returns)\n    })\n  }\n}\n\n// #839: every top-level `let name = record { .. }` whose field-set matches no\n// declared struct, collected as `__anonrec:` var_types entries UP FRONT (same\n// encoding `anon_record_inferred`/`anon_dot_rewrite` use for a local `let`).\n// Threaded as the BASE var_types into every top-level statement's own\n// `railway_rw` pass below (instead of starting each statement fresh from\n// empty), so `name.field` resolves whether it appears in a LATER top-level\n// statement or inside a function/test body that merely closes over a\n// top-level binding — not just within the same statement's own expression\n// tree (#839: previously the only working position was a bare top-level\n// expression statement in the SAME statement as the record literal, which\n// ADR-0069 now rejects outright). Consistent with `collect_struct_field_sets`\n// / `collect_fn_returns`, this does not recurse into `SModule` bodies — a\n// module-nested anonymous-record `let` is a fresh scope of its own, same as\n// module-nested struct/fn declarations are already scoped in those passes.\nfn collect_toplevel_anon_records(stmts: Array[Stmt], struct_sets: Array[(String, Array[String])]) -> Array[(String, String)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, val) => match anon_record_inferred(val, struct_sets) {\n        Some(sentinel) => Array::push(out, (name, sentinel)),\n        None => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// #635: lower the `let*`/`?` sentinels across a whole program. In-place,\n// idempotent (a second run finds no sentinels), and inert for programs that use\n// neither. Exported so the checker path can lower before type-checking.\n// `toplevel_vars` (#839) seeds every top-level statement's var_types with the\n// program's top-level anonymous-record bindings — see\n// `collect_toplevel_anon_records` — so `EFn`/`ELet`'s existing var_types\n// threading (which already covers a SINGLE statement's own nested scopes)\n// extends across top-level statement boundaries too.\nfn railway_rw_stmt(s: Stmt, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)], toplevel_vars: Array[(String, String)]) -> Stmt {\n  match s {\n    SLet(exp, isrec, fname, ann, body) => SLet(exp, isrec, fname, ann, railway_rw(body, struct_sets, toplevel_vars, fn_returns)),\n    SLetMut(name, ty, e) => SLetMut(name, ty, railway_rw(e, struct_sets, toplevel_vars, fn_returns)),\n    STest(name, body) => STest(name, railway_rw(body, struct_sets, toplevel_vars, fn_returns)),\n    SBench(name, body) => SBench(name, railway_rw(body, struct_sets, toplevel_vars, fn_returns)),\n    SExpr(e) => SExpr(railway_rw(e, struct_sets, toplevel_vars, fn_returns)),\n    SModule(exp, name, body) => SModule(exp, name, for inner in body {\n      railway_rw_stmt(inner, struct_sets, fn_returns, toplevel_vars)\n    }),\n    _ => s\n  }\n}\n\nexport fn desugar_railway_binds(stmts: Array[Stmt]) -> Unit {\n  let struct_sets = collect_struct_field_sets(stmts)\n  let fn_returns = collect_fn_returns(stmts)\n  let toplevel_vars = collect_toplevel_anon_records(stmts, struct_sets)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::set(stmts, i, railway_rw_stmt(Array::get(stmts, i), struct_sets, fn_returns, toplevel_vars))\n    i = i + 1\n  }\n}\n\n// The core rewriter. `dict_binds` is non-empty only inside a transformed\n// generic's body (so `T::method` resolves to a dict field); call-site dict\n// threading applies everywhere a transformed generic is called. `var_types`\n// tracks locals/params whose concrete type is known, for call-site dict\n// synthesis when the receiver is a variable.\nfn rewrite_expr(expr: Expr, gens: Array[(String, Array[(String, String, Int)])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {\n  match expr {\n    EIdent(name, off) => match split_qualified(name) {\n      Some(parts) => {\n        let (head, member) = parts\n        match find_dict_for_method(dict_binds, head, member) {\n          Some(dict_pname) => EDot(EIdent(dict_pname, -1), member, -1, -1),\n          None => match qual_ctor_member(head, member, struct_sets, fn_returns) {\n            Some(m) => EIdent(m, off),\n            None => expr\n          }\n        }\n      },\n      None => expr\n    },\n    ECall(callee, args, off) => {\n      // #635: type-directed lowering of the railway sentinels emitted by the\n      // parser. `__try_bind(val, (x) -> rest)` and `__try_op(val)` carry no type\n      // info from the parser; here `infer_arg_type_name(val)` picks Option vs\n      // Result (default Result when undeterminable — today's behavior). A user\n      // function literally named `__try_bind`/`__try_op` with the wrong shape\n      // (handled by `try_sentinel` returning None) takes the generic path.\n      let try_kind = try_sentinel(callee, args)\n      if try_kind == 0 {\n        // __try_bind(val, (name) -> rest)\n        let val = Array::get(args, 0)\n        match Array::get(args, 1) {\n          EFn(_, _, ps, _, _, rest) => {\n            let (name, _) = Array::get(ps, 0)\n            let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n            let inferred = infer_arg_type_name(val, struct_sets, var_types, fn_returns)\n            // #1064: `name` binds to the UNWRAPPED payload (`Some(name)`'s\n            // field), never to a value of `inferred`'s own type (the\n            // wrapper \"Option\"/\"Result\" of `val`) -- recording name ->\n            // inferred unconditionally here conflated the two, so a later\n            // `name == <int literal>` in `rest` was misclassified by\n            // infer_arg_type_name's var_types lookup as an Option/Result\n            // operand and routed through the structural opt_eq_match/\n            // result_eq_match rewrite instead of a scalar comparison,\n            // silently computing nonsense for the common scalar-payload\n            // case. `railway_bind_payload_type` recovers the real payload\n            // type for the one shape it CAN (a literal `Some(x)`/`Ok(x)`\n            // nesting, e.g. `let* outer = Some(Some(1))`) so a follow-up\n            // `let* inner = outer` still chains correctly; every other\n            // shape (a plain function call, a bare identifier, ...) stays\n            // untracked, falling through infer_arg_type_name to `None`,\n            // which keeps the plain scalar `==`/`!=` codegen path.\n            let body_vars = extend_var_types(var_types, name, railway_bind_payload_type(val, struct_sets, var_types, fn_returns))\n            let rwrest = rewrite_expr(rest, gens, traits, struct_sets, dict_binds, body_vars, fn_returns)\n            lower_try_bind(rwval, name, rwrest, inferred)\n          },\n          _ => EUnit\n        }\n      } else if try_kind == 1 {\n        // __try_op(val)\n        let val = Array::get(args, 0)\n        let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n        lower_try_op(rwval, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      } else {\n      let rwargs = for a in args {\n        rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      }\n      match map_index_rewrite(callee, args, rwargs, struct_sets, var_types, fn_returns) {\n        Some(map_get) => map_get,\n        None =>\n      match callee {\n        EIdent(name0, coff) => {\n          // #672: unqualify a qualified constructor call `Enum::Variant(..)` ->\n          // `Variant(..)` so codegen's (unqualified) ctor table recognizes it.\n          let name_ctor = match split_qualified(name0) {\n            Some(parts0) => {\n              let (h0, m0) = parts0\n              match qual_ctor_member(h0, m0, struct_sets, fn_returns) {\n                Some(mm) => mm,\n                None => name0\n              }\n            },\n            None => name0\n          }\n          // #736 residual: bare method-style callee — `xs |> length` is\n          // `length(xs)`; with only the receiver TYPE imported there is no\n          // top-level `length`, so resolve to `<type-of-arg0>::length` (USER\n          // types only, and only when no top-level fn of the bare name exists\n          // — a lexically visible `length` keeps normal call semantics). The\n          // checker applies the same rule, so typing and codegen agree.\n          let name = if String::index_of(name_ctor, \"::\") < 0 && !fn_exists(fn_returns, name_ctor) && Array::length(args) >= 1 {\n            match infer_arg_type_name(Array::get(args, 0), struct_sets, var_types, fn_returns) {\n              Some(tn) => {\n                let qual = String::concat(tn, String::concat(\"::\", name_ctor))\n                if struct_set_has(struct_sets, tn) && fn_exists(fn_returns, qual) {\n                  qual\n                } else {\n                  name_ctor\n                }\n              },\n              None => name_ctor\n            }\n          } else {\n            name_ctor\n          }\n          // `T::method(args)` inside a transformed body -> `(dict.method)(args)`.\n          let as_method = match split_qualified(name) {\n            Some(parts) => {\n              let (head, member) = parts\n              find_dict_for_method(dict_binds, head, member)\n            },\n            None => None\n          }\n          match as_method {\n            Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), member_of(name), -1, -1), rwargs, off),\n            None => match lookup_gen(gens, name) {\n              Some(threaded) => match synth_dicts(threaded, args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) {\n                Some(dicts) => ECall(EIdent(name, coff), concat_expr_arrays(dicts, rwargs), off),\n                None => ECall(EIdent(name, coff), rwargs, off)\n              },\n              None => ECall(EIdent(name, coff), rwargs, off)\n            }\n          }\n        },\n        EDot(obj, m, doff, fdoff) => {\n          // #736 residual: method-style call `xs.length()` on a USER type —\n          // codegen compiles a called EDot as struct-field access, so a\n          // receiver method (`List::length`) failed with \"unknown struct\n          // field\". Rewrite to the qualified call when the receiver's type is\n          // inferable and declares the method as a top-level fn. A struct\n          // FIELD of the same name keeps the field-stored-function call (the\n          // field is the closer binding), and unknown receivers keep the EDot\n          // (codegen's existing paths).\n          let robj = rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n          // #931: UFCS on a trait-BOUNDED TYPE PARAMETER — `k.probe_key()`\n          // where `k: K` and `[K: Hash]` is in scope. The receiver's inferred\n          // \"type name\" is the tparam itself (\"K\"), which is neither a struct\n          // nor a concrete `K::method` top-level fn, so the concrete-method\n          // rewrite below missed it and the call stayed a bare EDot — codegen\n          // compiles a called EDot as a struct-field read, yielding a\n          // null-function call at runtime. Route it through the SAME threaded\n          // witness dict as the qualified spelling `K::probe_key(k)` (the\n          // EIdent arm above): `(dict.method)(k, args)`. Checked FIRST so both\n          // spellings resolve identically (the qualified path also consults\n          // find_dict_for_method before any concrete fallback).\n          let recv_tn = infer_arg_type_name(obj, struct_sets, var_types, fn_returns)\n          let as_tparam_dict = match recv_tn {\n            Some(tn) => find_dict_for_method(dict_binds, tn, m),\n            None => None\n          }\n          let as_recv_method = match as_tparam_dict {\n            Some(_) => None,\n            None => match recv_tn {\n            Some(tn) => {\n              let qual = String::concat(tn, String::concat(\"::\", m))\n              let is_field = struct_set_member(struct_sets, tn, m)\n              if !is_field && fn_exists(fn_returns, qual) {\n                Some(qual)\n              } else {\n                None\n              }\n            },\n            None => None\n            }\n          }\n          match as_tparam_dict {\n            Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), m, -1, -1), prepend_expr(robj, rwargs), off),\n            None => match as_recv_method {\n            Some(qual) => ECall(EIdent(qual, doff), prepend_expr(robj, rwargs), off),\n            None => ECall(EDot(robj, m, doff, fdoff), rwargs, off)\n            }\n          }\n        },\n        _ => ECall(rewrite_expr(callee, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rwargs, off)\n      }\n      }\n      }\n    },\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EUnit => expr,\n    ESpread(_) => expr,\n    EStringInterp(_) => expr,\n    ETuple(elems) => ETuple(for e in elems {\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n    }),\n    EArray(elems) => EArray(for e in elems {\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n    }),\n    ERecord(rn, fields, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, fval) = Array::get(fields, i)\n        Array::push(out, (fname, rewrite_expr(fval, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fields) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (k, v) = Array::get(fields, i)\n        Array::push(out, (k, rewrite_expr(v, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(t, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ELet(name, val, body, soff) => {\n      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      let body_vars = extend_var_types(var_types, name, anon_or_infer(val, struct_sets, var_types, fn_returns))\n      ELet(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns), soff)\n    },\n    ELetRec(name, val, body) => ELetRec(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ELetMut(name, val, body, soff) => {\n      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      let body_vars = extend_var_types(var_types, name, anon_or_infer(val, struct_sets, var_types, fn_returns))\n      ELetMut(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns), soff)\n    },\n    EAssign(name, val, cont) => EAssign(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EAssignOp(name, op, val, cont) => EAssignOp(name, op, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ESeq(a, b) => ESeq(rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EMatch(scrut, arms) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMatch(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)\n    },\n    EHandle(scrut, arms) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      EHandle(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)\n    },\n    EWhile(c, b) => EWhile(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ELoop(params, body) => ELoop(for param in params {\n      let (name, init) = param\n      (name, rewrite_expr(init, gens, traits, struct_sets, dict_binds, var_types, fn_returns))\n    }, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EForIn(name, idx, iter, body) => {\n      let rbody = rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      // `for await x in s` (#636 unification): the parser wraps `s` in an\n      // `__await_iter` marker; classify_for_await_loop picks iterator vs pull\n      // loop by type. It runs regardless of whether a trait is declared, since\n      // `for await` predates the trait machinery. A plain `for x in e` is\n      // iterator/iterable/array-classified only when a method-bearing trait is\n      // present (without one there are no `impl ::next` methods to dispatch), so\n      // trait-free programs' `for` loops are untouched.\n      match for_await_inner(iter) {\n        Some(inner) => {\n          let rinner = rewrite_expr(inner, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n          classify_for_await_loop(name, idx, inner, rinner, rbody, struct_sets, var_types, fn_returns)\n        },\n        None => {\n          let riter = rewrite_expr(iter, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n          if Array::length(traits) == 0 {\n            // No declared trait: next/iter classification stays off (no\n            // `impl ::next` to dispatch), but the #736 indexed protocol is\n            // plain named functions, so it classifies regardless.\n            classify_indexed_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)\n          } else {\n            classify_sync_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)\n          }\n        }\n      }\n    },\n    EBinOp(op, l, r) => {\n      let rl = rewrite_expr(l, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      let rr = rewrite_expr(r, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      // #672: dispatch `a == b` / `a != b` on a struct type to the generated\n      // structural `T::equals`. The operand's type is resolved best-effort via\n      // `infer_arg_type_name` (var_types for variables, field-set match for\n      // struct literals); a struct type whose `equals` we generated is rewritten\n      // to a call. Non-struct / unresolved operands keep the scalar binop.\n      if op == \"==\" || op == \"!=\" {\n        // #695: an empty array LITERAL on either side reduces `==` to a length\n        // check on the other operand (an array equals `[]` iff its length is 0),\n        // which is exact and needs no element type. This also covers `[] == []`,\n        // whose element type is otherwise undeterminable.\n        let empty_l = is_empty_array_lit(l)\n        let empty_r = is_empty_array_lit(r)\n        // #695: a bare array `==` (operand is an array literal whose element type\n        // is statically determinable) dispatches to the monomorphic\n        // `__arr_equals__<key>` helper (emitted by desugar_derives), since the\n        // runtime `eq` would identity-compare the array. Opaque array-typed\n        // operands (no literal in scope) are left as `==` (documented residual).\n        let arr_elem = match infer_earray_elem_type(l) {\n          Some(t) => Some(t),\n          None => infer_earray_elem_type(r)\n        }\n        if empty_l || empty_r {\n          let other = if empty_l {\n            rr\n          } else {\n            rl\n          }\n          let lencmp = EBinOp(\"==\", ECall(EIdent(\"Array::length\", -1), [\n            other\n          ], -1), EInt(0))\n          if op == \"==\" {\n            lencmp\n          } else {\n            ECall(EIdent(\"not\", -1), [\n              lencmp\n            ], -1)\n          }\n        } else {\n        match arr_elem {\n          Some(elem) => {\n            let call = ECall(EIdent(arr_equals_name(elem), -1), [\n              rl,\n              rr\n            ], -1)\n            if op == \"==\" {\n              call\n            } else {\n              ECall(EIdent(\"not\", -1), [\n                call\n              ], -1)\n            }\n          },\n          None => {\n            // #825: full static-shape dispatch. When either operand's complete\n            // TypeExpr is inferable from literal syntax (Some/Ok/Err ctor\n            // literals, tuple literals, array literals with non-scalar\n            // elements), route through the fully-recursive `eq_for_typed` so\n            // aggregate payloads (`Some([1,2])`, `Ok([1,2])`, `Some(Some(1))`,\n            // `([1,2], 0)`) compare structurally instead of by word identity.\n            // `known_types` is empty: this inference only ever yields builtin\n            // shapes (never user struct/enum names), and unknown positions\n            // carry the `__EqUnknown` marker which `eq_for_typed` compares\n            // with raw `==` (status quo for that position).\n            let sty = infer_static_eq_type_binop(l, r)\n            let dty = match sty {\n              Some(t) => if static_eq_dispatchable(t) {\n                Some(t)\n              } else {\n                None\n              },\n              None => None\n            }\n            match dty {\n              Some(dt) => {\n                let call = eq_for_typed(dt, rl, rr, empty_str_array())\n                if op == \"==\" {\n                  call\n                } else {\n                  ECall(EIdent(\"not\", -1), [\n                    call\n                  ], -1)\n                }\n              },\n              None => {\n            let ty = match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {\n              Some(t) => Some(t),\n              None => infer_arg_type_name(r, struct_sets, var_types, fn_returns)\n            }\n            match ty {\n              Some(t) => if struct_set_has(struct_sets, t) {\n                let call = ECall(EIdent(String::concat(t, \"::equals\"), -1), [\n                  rl,\n                  rr\n                ], -1)\n                if op == \"==\" {\n                  call\n                } else {\n                  ECall(EIdent(\"not\", -1), [\n                    call\n                  ], -1)\n                }\n              } else if t == \"Option\" {\n                // Bare `==` on Option-typed operands (e.g. `let a = None; a == b`)\n                // dispatches to a structural match; the runtime would otherwise\n                // identity-compare the heap-allocated nullary `None`. Payloads\n                // compare with `==` — correct for scalar payloads (the common\n                // case); an aggregate-payload bare-Option variable is a #695\n                // residual (route it through a struct field for full recursion).\n                let eqm = opt_eq_match(rl, rr)\n                if op == \"==\" {\n                  eqm\n                } else {\n                  ECall(EIdent(\"not\", -1), [\n                    eqm\n                  ], -1)\n                }\n              } else if t == \"Result\" {\n                let eqm = result_eq_match(rl, rr)\n                if op == \"==\" {\n                  eqm\n                } else {\n                  ECall(EIdent(\"not\", -1), [\n                    eqm\n                  ], -1)\n                }\n              } else {\n                EBinOp(op, rl, rr)\n              },\n              None => EBinOp(op, rl, rr)\n            }\n              }\n            }\n          }\n        }\n        }\n      } else if op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" {\n        // #746: String relational lowering. The backends compile a bare\n        // `<`/`>`/`<=`/`>=` as signed i64 compare — on the (ptr<<32)|len\n        // string repr that orders by POINTER, not content. Rewrite to\n        // `str_lex_diff(l, r) <op> 0` (a builtin returning a sign-carrying\n        // lexicographic diff with length tie-break) when either ORIGINAL\n        // operand is determinably String — same inference and residual\n        // class as the `+` -> String::concat rewrite below.\n        let rel_stringish = (match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {\n          Some(t) => t == \"String\",\n          None => false\n        }) || (match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {\n          Some(t) => t == \"String\",\n          None => false\n        })\n        if rel_stringish {\n          EBinOp(op, ECall(EIdent(\"str_lex_diff\", -1), [\n            rl,\n            rr\n          ], -1), EInt(0))\n        } else if is_erased_generic_operand(l, r, struct_sets, var_types, fn_returns) {\n          // #973: neither operand is determinably String, but at least one is\n          // the bare name of an in-scope generic type parameter — the\n          // concrete runtime type is erased, so dispatch at runtime instead\n          // (see is_erased_generic_operand / gen_generic_rel_diff_body).\n          EBinOp(op, ECall(EIdent(\"__generic_rel_diff\", -1), [\n            rl,\n            rr\n          ], -1), EInt(0))\n        } else {\n          EBinOp(op, rl, rr)\n        }\n      } else if op == \"+\" {\n        // String `+` lowering: the checker types `String + String` as String,\n        // but the backends compile a bare `+` as numeric i64.add — on the\n        // (ptr<<32)|len string repr that adds the lengths and garbles the\n        // pointer. Rewrite to String::concat when either ORIGINAL operand is\n        // determinably String (literal, tracked var, string-returning call,\n        // or a nested `+` chain of those). Undeterminable operands (e.g. two\n        // untracked call results) keep the raw binop — same residual class\n        // as #695's opaque `==`.\n        let stringish = (match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {\n          Some(t) => t == \"String\",\n          None => false\n        }) || (match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {\n          Some(t) => t == \"String\",\n          None => false\n        })\n        if stringish {\n          ECall(EIdent(\"String::concat\", -1), [\n            rl,\n            rr\n          ], -1)\n        } else if is_erased_generic_operand(l, r, struct_sets, var_types, fn_returns) {\n          // #973: same erased-`[T: Add]` case as the relational branch above.\n          ECall(EIdent(\"__generic_add\", -1), [\n            rl,\n            rr\n          ], -1)\n        } else {\n          EBinOp(op, rl, rr)\n        }\n      } else {\n        EBinOp(op, rl, rr)\n      }\n    },\n    EUnaryOp(op, e) => EUnaryOp(op, rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, rewrite_expr(body, gens, traits, struct_sets, dict_binds, seed_var_types(ps, tp, var_types), fn_returns)),\n    EDot(obj, field, off, fdoff) => {\n      let robj = rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      match anon_dot_rewrite(obj, field, off, robj, var_types) {\n        Some(rw) => rw,\n        None => EDot(robj, field, off, fdoff)\n      }\n    },\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EReturn(e) => EReturn(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns))),\n      None => expr\n    },\n    EContinue(exprs) => EContinue(for e in exprs {\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n    })\n  }\n}\n\n// Extract the member of a qualified `Head::member` name (the part after `::`).\nfn member_of(name: String) -> String {\n  match split_qualified(name) {\n    Some(parts) => {\n      let (_, member) = parts\n      member\n    },\n    None => name\n  }\n}\n\n// Build the dict bindings in scope for a transformed generic's body.\nfn dict_binds_of(threaded: Array[(String, String, Int)], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Array[(String, String, String, Array[String])] {\n  let out = empty_dict_binds()\n  let mut i = 0\n  while i < Array::length(threaded) {\n    let (tp, trait_name, _) = Array::get(threaded, i)\n    let methods = match lookup_trait_sigs(traits, trait_name) {\n      Some(sigs) => method_names_of_sigs(sigs),\n      None => empty_str_array()\n    }\n    Array::push(out, (tp, trait_name, dict_param_name(trait_name, tp), methods))\n    i = i + 1\n  }\n  out\n}\n\n// Prepend the hidden dict parameters to a transformed generic's parameter list.\nfn thread_dict_params(threaded: Array[(String, String, Int)], params: Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] {\n  let result = array_empty()\n  let mut i = 0\n  while i < Array::length(threaded) {\n    let (tp, trait_name, _) = Array::get(threaded, i)\n    let dty = TyApp(dict_struct_name(trait_name), [\n      TyName(tp)\n    ])\n    Array::push(result, (dict_param_name(trait_name, tp), Some(dty)))\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(params) {\n    Array::push(result, Array::get(params, j))\n    j = j + 1\n  }\n  result\n}\n\n// `toplevel_vars` (#839): the program's top-level anonymous-record bindings\n// (see `collect_toplevel_anon_records`), seeded as the base var_types for\n// every top-level statement's own `rewrite_expr` pass — mirrors the\n// `railway_rw_stmt` fix for the SAME `anon_dot_rewrite` call below, since this\n// is the SECOND, independent pass (the \"heavy dict-passing\" pass driving\n// `desugar_trait_dicts`, used by the RC/FS-compile codegen entries) that also\n// lowers `record{}.field` dot access — without this it inherited the exact\n// same \"only resolves within a single top-level statement's own expression\n// tree\" gap.\nfn rewrite_stmt(stmt: Stmt, gens: Array[(String, Array[(String, String, Int)])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)], toplevel_vars: Array[(String, String)]) -> Stmt {\n  let no_binds = empty_dict_binds()\n  match stmt {\n    SLet(exp, isrec, fname, ann, body) => match lookup_gen(gens, fname) {\n      Some(threaded) => match body {\n        EFn(tparams, bounds, params, ret, eff, fbody) => {\n          let binds = dict_binds_of(threaded, traits)\n          let new_params = thread_dict_params(threaded, params)\n          let seeded = seed_var_types(params, tparams, toplevel_vars)\n          let new_body = rewrite_expr(fbody, gens, traits, struct_sets, binds, seeded, fn_returns)\n          SLet(exp, isrec, fname, ann, EFn(tparams, bounds, new_params, ret, eff, new_body))\n        },\n        _ => stmt\n      },\n      None => SLet(exp, isrec, fname, ann, rewrite_expr(body, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns))\n    },\n    SLetMut(name, ty, e) => SLetMut(name, ty, rewrite_expr(e, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),\n    STest(name, body) => STest(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),\n    SBench(name, body) => SBench(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),\n    SExpr(e) => SExpr(rewrite_expr(e, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),\n    SModule(exp, name, body) => SModule(exp, name, for s in body {\n      rewrite_stmt(s, gens, traits, struct_sets, fn_returns, toplevel_vars)\n    }),\n    _ => stmt\n  }\n}\n\n// ---- derive(...) structural function generation (#638) ----\n//\n// For a `struct P { x; y } derive(Show, Ord)` this generates the structural\n// free functions `P::to_string` and `P::compare` (concrete `Type::method`,\n// resolved by the PR-1 dispatch path). `Eq` stays a no-op marker (structural\n// `==` is a runtime builtin). Hash / Default and enums are deferred slices.\n\nfn qualified_name(tname: String, method: String) -> String {\n  String::concat(tname, String::concat(\"::\", method))\n}\n\nfn top_level_fn_exists(stmts: Array[Stmt], fname: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, _) => if name == fname {\n        found = true\n        i = Array::length(stmts)\n      } else {\n        i = i + 1\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  found\n}\n\nfn concat2(a: Expr, b: Expr) -> Expr {\n  ECall(EIdent(\"String::concat\", -1), [\n    a,\n    b\n  ], -1)\n}\n\n// A stable, fn-name-safe key for a TypeExpr, used to name the monomorphic array\n// to-string helper `__arr_to_string__<key>` so distinct element types get\n// distinct helpers. `Int` -> \"Int\", `Array[Int]` -> \"Array_Int\",\n// `Option[Int]` -> \"Option_Int\", `(Int,Bool)` -> \"Tup_Int_Bool\", else \"Any\".\n// (#694: mirrors #672/#695-era helper-naming so Layer-2 recursion into\n// `Array[t]` fields produces a structural — not pointer-heuristic — string.)\nfn ts_type_key(ty: TypeExpr) -> String {\n  match ty {\n    TyName(n) => n,\n    TyApp(n, args) => {\n      let mut s = n\n      let mut i = 0\n      while i < Array::length(args) {\n        s = String::concat(s, String::concat(\"_\", ts_type_key(Array::get(args, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyTuple(ts) => {\n      let mut s = \"Tup\"\n      let mut i = 0\n      while i < Array::length(ts) {\n        s = String::concat(s, String::concat(\"_\", ts_type_key(Array::get(ts, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyUnit => \"Unit\",\n    _ => \"Any\"\n  }\n}\n\n// The generated monomorphic array-to-string helper name for element type `t`.\nfn arr_to_string_name(t: TypeExpr) -> String {\n  String::concat(\"__arr_to_string__\", ts_type_key(t))\n}\n\n// Produce a String expression for a value `val` whose declared type is `fty`.\n// Fully type-directed and recursive (#694 Layer 2):\n//   - `String` -> verbatim\n//   - scalar `TyName` -> `__to_string(val)`\n//   - declared struct/enum `TyName(n)` (`known_types`) -> `n::to_string(val)`\n//   - `Option[t]` -> `match val { Some(x) => \"Some(\" ++ show(x) ++ \")\", None => \"None\" }`\n//   - `Result[t,e]` -> `Ok(..)` / `Err(..)` structural match\n//   - tuple `(t0,..,tn)` -> `\"(\" ++ show(t0) ++ \", \" ++ .. ++ \")\"`\n//   - `Array[t]` -> a call to the monomorphic `__arr_to_string__<key>` helper\n//   - declared generic `TyApp(n, _)` (e.g. `Box[T]`) -> `n::to_string(val)`\n//   - anything else -> `__to_string(val)` (status-quo pointer/scalar heuristic)\n// The structural `Type::to_string` (and the derived `Type::hash_key` that\n// delegates to it) is therefore stable for two distinct-but-equal aggregates,\n// no matter how deeply nested.\nfn show_for_typed(fty: TypeExpr, val: Expr, known_types: Array[String]) -> Expr {\n  match fty {\n    TyName(\"String\") => val,\n    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"to_string\"), -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyApp(\"Option\", args) => if Array::length(args) == 1 {\n      let t = Array::get(args, 0)\n      let inner = show_for_typed(t, EIdent(\"__os_v\", -1), known_types)\n      let some_body = concat2(EString(\"Some(\"), concat2(inner, EString(\")\")))\n      EMatch(val, Array::slice([\n        (PCtor(\"Some\", Array::slice([\n          PBind(\"__os_v\")\n        ], 0, 1)), some_body),\n        (PCtor(\"None\", array_empty()), EString(\"None\"))\n      ], 0, 2))\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyApp(\"Result\", args) => if Array::length(args) == 2 {\n      let t = Array::get(args, 0)\n      let e = Array::get(args, 1)\n      let ok_inner = show_for_typed(t, EIdent(\"__rs_v\", -1), known_types)\n      let err_inner = show_for_typed(e, EIdent(\"__rs_v\", -1), known_types)\n      let ok_body = concat2(EString(\"Ok(\"), concat2(ok_inner, EString(\")\")))\n      let err_body = concat2(EString(\"Err(\"), concat2(err_inner, EString(\")\")))\n      EMatch(val, Array::slice([\n        (PCtor(\"Ok\", Array::slice([\n          PBind(\"__rs_v\")\n        ], 0, 1)), ok_body),\n        (PCtor(\"Err\", Array::slice([\n          PBind(\"__rs_v\")\n        ], 0, 1)), err_body)\n      ], 0, 2))\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyTuple(ts) => {\n      let n = Array::length(ts)\n      let pats = array_empty()\n      let mut i = 0\n      while i < n {\n        Array::push(pats, PBind(String::concat(\"__ts_t\", idx_str(i))))\n        i = i + 1\n      }\n      let segs = empty_expr_array()\n      Array::push(segs, EString(\"(\"))\n      let mut k = 0\n      while k < n {\n        if k > 0 {\n          Array::push(segs, EString(\", \"))\n        } else {\n          ()\n        }\n        Array::push(segs, show_for_typed(Array::get(ts, k), EIdent(String::concat(\"__ts_t\", idx_str(k)), -1), known_types))\n        k = k + 1\n      }\n      Array::push(segs, EString(\")\"))\n      let mut acc = Array::get(segs, Array::length(segs) - 1)\n      let mut j = Array::length(segs) - 2\n      while j >= 0 {\n        acc = concat2(Array::get(segs, j), acc)\n        j = j - 1\n      }\n      EMatch(val, Array::slice([\n        (PTuple(pats), acc)\n      ], 0, 1))\n    },\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      ECall(EIdent(arr_to_string_name(Array::get(args, 0)), -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyApp(n, _) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"to_string\"), -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    _ => ECall(EIdent(\"__to_string\", -1), Array::slice([\n      val\n    ], 0, 1), -1)\n  }\n}\n\n// Show a single struct field value as a String expression, by its declared type\n// (#694: type-directed and recursive — aggregate fields recurse structurally\n// instead of falling into the `__to_string` pointer heuristic).\nfn field_show_expr(fname: String, fty: TypeExpr, known_types: Array[String]) -> Expr {\n  show_for_typed(fty, EDot(EIdent(\"self\", -1), fname, -1, -1), known_types)\n}\n\n// `let __arr_to_string__<key> = (a: Array[t]) -> String {\n//    \"[\" ++ join(show(a[0]), \", \", show(a[1]), ...) ++ \"]\" }` — a monomorphic,\n// fully-recursive array to-string. Element rendering goes through\n// `show_for_typed`, so `Array[Foo]` / `Array[Array[Int]]` recurse structurally\n// instead of pointer-stringifying aggregate elements. (#694 Layer 2.)\nfn gen_arr_to_string_fn(elem_ty: TypeExpr, known_types: Array[String]) -> Stmt {\n  let elem_get = ECall(EIdent(\"Array::get\", -1), Array::slice([\n    EIdent(\"a\", -1),\n    EIdent(\"__as_i\", -1)\n  ], 0, 2), -1)\n  let elem_show = show_for_typed(elem_ty, elem_get, known_types)\n  // `__as_acc = __as_acc ++ (if i == 0 { \"\" } else { \", \" }) ++ show(a[i])`\n  let sep = EIf(EBinOp(\"==\", EIdent(\"__as_i\", -1), EInt(0)), EString(\"\"), EString(\", \"))\n  let append = concat2(concat2(EIdent(\"__as_acc\", -1), sep), elem_show)\n  let set_acc = EAssign(\"__as_acc\", append, EUnit)\n  let incr = EAssign(\"__as_i\", EBinOp(\"+\", EIdent(\"__as_i\", -1), EInt(1)), EUnit)\n  let loop_body = ESeq(set_acc, incr)\n  let while_loop = EWhile(EBinOp(\"<\", EIdent(\"__as_i\", -1), ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"a\", -1)\n  ], 0, 1), -1)), loop_body)\n  let closed = concat2(EIdent(\"__as_acc\", -1), EString(\"]\"))\n  let body = ELetMut(\"__as_i\", EInt(0), ELetMut(\"__as_acc\", EString(\"[\"), ESeq(while_loop, closed), -1), -1)\n  let arr_ty = TyApp(\"Array\", Array::slice([\n    elem_ty\n  ], 0, 1))\n  let params = Array::slice([\n    (\"a\", Some(arr_ty))\n  ], 0, 1)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, arr_to_string_name(elem_ty), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, body))\n}\n\n// `let P::to_string = (self: P) -> String { \"P { x: \" ++ show(x) ++ \", ... }\" }`\nfn gen_show_fn(tname: String, fields: Array[(String, TypeExpr)], known_types: Array[String]) -> Stmt {\n  let segs = empty_expr_array()\n  Array::push(segs, EString(String::concat(tname, \" { \")))\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (fname, fty) = Array::get(fields, i)\n    let sep = if i == 0 {\n      \"\"\n    } else \", \"\n    Array::push(segs, EString(String::concat(sep, String::concat(fname, \": \"))))\n    Array::push(segs, field_show_expr(fname, fty, known_types))\n    i = i + 1\n  }\n  Array::push(segs, EString(\" }\"))\n  // fold right: concat(seg0, concat(seg1, ... segN))\n  let mut body = Array::get(segs, Array::length(segs) - 1)\n  let mut j = Array::length(segs) - 2\n  while j >= 0 {\n    body = concat2(Array::get(segs, j), body)\n    j = j - 1\n  }\n  let params = Array::slice([\n    (\"self\", Some(TyName(tname)))\n  ], 0, 1)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(tname, \"to_string\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, body))\n}\n\n// A type name that the runtime compares as a flat scalar (no structural\n// `equals` needed). Everything else named is a user struct/enum and recurses\n// through its generated `T::equals`.\nfn is_scalar_type_name(n: String) -> Bool {\n  n == \"Int\" || n == \"Double\" || n == \"Bool\" || n == \"String\" || n == \"Char\" || n == \"Unit\" || n == \"Bytes\"\n}\n\n// A stable, fn-name-safe key for a TypeExpr, used to name the monomorphic array\n// helper `__arr_equals__<key>` so distinct element types get distinct helpers.\n// `Int` -> \"Int\", `Array[Int]` -> \"Array_Int\", `Option[Int]` -> \"Option_Int\",\n// `(Int,Bool)` -> \"Tup_Int_Bool\", unknown shapes -> \"Any\".\nfn type_key(ty: TypeExpr) -> String {\n  match ty {\n    TyName(n) => n,\n    TyApp(n, args) => {\n      let mut s = n\n      let mut i = 0\n      while i < Array::length(args) {\n        s = String::concat(s, String::concat(\"_\", type_key(Array::get(args, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyTuple(ts) => {\n      let mut s = \"Tup\"\n      let mut i = 0\n      while i < Array::length(ts) {\n        s = String::concat(s, String::concat(\"_\", type_key(Array::get(ts, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyUnit => \"Unit\",\n    _ => \"Any\"\n  }\n}\n\n// The generated monomorphic array-equality helper name for element type `t`.\nfn arr_equals_name(t: TypeExpr) -> String {\n  String::concat(\"__arr_equals__\", type_key(t))\n}\n\n// Structural equality match for two Option operands whose element type is NOT\n// statically known here (bare `==` dispatch on Option-typed variables). Some\n// payloads compare with `==` (correct for scalars); a None matches a None.\n// (#695.)\nfn opt_eq_match(lhs: Expr, rhs: Expr) -> Expr {\n  let some_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"Some\", Array::slice([\n      PBind(\"__oeq_r\")\n    ], 0, 1)), EBinOp(\"==\", EIdent(\"__oeq_l\", -1), EIdent(\"__oeq_r\", -1))),\n    (PWild, EBool(false))\n  ], 0, 2))\n  let none_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"None\", array_empty()), EBool(true)),\n    (PWild, EBool(false))\n  ], 0, 2))\n  EMatch(lhs, Array::slice([\n    (PCtor(\"Some\", Array::slice([\n      PBind(\"__oeq_l\")\n    ], 0, 1)), some_inner),\n    (PCtor(\"None\", array_empty()), none_inner)\n  ], 0, 2))\n}\n\n// Structural equality match for two Result operands of statically-unknown\n// element types (bare `==` dispatch). (#695.)\nfn result_eq_match(lhs: Expr, rhs: Expr) -> Expr {\n  let ok_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"Ok\", Array::slice([\n      PBind(\"__req_r\")\n    ], 0, 1)), EBinOp(\"==\", EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1))),\n    (PWild, EBool(false))\n  ], 0, 2))\n  let err_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"Err\", Array::slice([\n      PBind(\"__req_r\")\n    ], 0, 1)), EBinOp(\"==\", EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1))),\n    (PWild, EBool(false))\n  ], 0, 2))\n  EMatch(lhs, Array::slice([\n    (PCtor(\"Ok\", Array::slice([\n      PBind(\"__req_l\")\n    ], 0, 1)), ok_inner),\n    (PCtor(\"Err\", Array::slice([\n      PBind(\"__req_l\")\n    ], 0, 1)), err_inner)\n  ], 0, 2))\n}\n\n// Equality of two operands whose declared type is `fty`. Fully type-directed:\n//   - scalar `TyName` -> raw `==`\n//   - declared struct/enum `TyName(n)` -> `n::equals(lhs, rhs)`\n//   - `Option[t]` / `Result[t,e]` -> inline `match` recursing on payloads\n//   - `(t0,..,tn)` tuple -> inline `match` over `PTuple`, conjoining element eqs\n//   - `Array[t]` -> a call to the monomorphic `__arr_equals__<key>` helper\n//   - declared generic `TyApp(n, _)` (e.g. `Box[T]`) -> `n::equals(lhs, rhs)`\n//   - anything else -> raw `==` (status quo fallback)\n// The runtime `eq` builtin is type-blind (it identity-compares aggregates), so\n// structural equality MUST be resolved here at the AST level where the static\n// type is known. (#695.)\nfn eq_for_typed(fty: TypeExpr, lhs: Expr, rhs: Expr, known_types: Array[String]) -> Expr {\n  match fty {\n    TyName(n) => if n == \"Double\" || n == \"Float\" {\n      // Under RC a Double is a BOXED heap value, so a raw `==` between two\n      // Double fields compares box identity (always false) instead of the f64\n      // payload. Wrap each operand in the identity `Double::to_float` so the\n      // `==` codegen recognizes the operands as floatish (expr_is_floatish) and\n      // takes the unbox-then-f64.eq path. Harmless on the non-RC backend, where\n      // the wrapper is identity and the float branch compares raw bits (#704).\n      EBinOp(\"==\", ECall(EIdent(\"Double::to_float\", -1), Array::slice([\n        lhs\n      ], 0, 1), -1), ECall(EIdent(\"Double::to_float\", -1), Array::slice([\n        rhs\n      ], 0, 1), -1))\n    } else if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"equals\"), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyApp(\"Option\", args) => if Array::length(args) == 1 {\n      let t = Array::get(args, 0)\n      let inner_eq = eq_for_typed(t, EIdent(\"__oeq_l\", -1), EIdent(\"__oeq_r\", -1), known_types)\n      let some_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"Some\", Array::slice([\n          PBind(\"__oeq_r\")\n        ], 0, 1)), inner_eq),\n        (PWild, EBool(false))\n      ], 0, 2))\n      let none_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"None\", array_empty()), EBool(true)),\n        (PWild, EBool(false))\n      ], 0, 2))\n      EMatch(lhs, Array::slice([\n        (PCtor(\"Some\", Array::slice([\n          PBind(\"__oeq_l\")\n        ], 0, 1)), some_inner),\n        (PCtor(\"None\", array_empty()), none_inner)\n      ], 0, 2))\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyApp(\"Result\", args) => if Array::length(args) == 2 {\n      let t = Array::get(args, 0)\n      let e = Array::get(args, 1)\n      let ok_eq = eq_for_typed(t, EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1), known_types)\n      let err_eq = eq_for_typed(e, EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1), known_types)\n      let ok_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"Ok\", Array::slice([\n          PBind(\"__req_r\")\n        ], 0, 1)), ok_eq),\n        (PWild, EBool(false))\n      ], 0, 2))\n      let err_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"Err\", Array::slice([\n          PBind(\"__req_r\")\n        ], 0, 1)), err_eq),\n        (PWild, EBool(false))\n      ], 0, 2))\n      EMatch(lhs, Array::slice([\n        (PCtor(\"Ok\", Array::slice([\n          PBind(\"__req_l\")\n        ], 0, 1)), ok_inner),\n        (PCtor(\"Err\", Array::slice([\n          PBind(\"__req_l\")\n        ], 0, 1)), err_inner)\n      ], 0, 2))\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyTuple(ts) => {\n      let n = Array::length(ts)\n      let lpats = array_empty()\n      let rpats = array_empty()\n      let mut i = 0\n      while i < n {\n        Array::push(lpats, PBind(String::concat(\"__teq_l\", idx_str(i))))\n        Array::push(rpats, PBind(String::concat(\"__teq_r\", idx_str(i))))\n        i = i + 1\n      }\n      let mut conj = EBool(true)\n      let mut j = n - 1\n      while j >= 0 {\n        let cmp = eq_for_typed(Array::get(ts, j), EIdent(String::concat(\"__teq_l\", idx_str(j)), -1), EIdent(String::concat(\"__teq_r\", idx_str(j)), -1), known_types)\n        conj = EBinOp(\"&&\", cmp, conj)\n        j = j - 1\n      }\n      let inner = EMatch(rhs, Array::slice([\n        (PTuple(rpats), conj)\n      ], 0, 1))\n      EMatch(lhs, Array::slice([\n        (PTuple(lpats), inner)\n      ], 0, 1))\n    },\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      ECall(EIdent(arr_equals_name(Array::get(args, 0)), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyApp(n, _) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"equals\"), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    _ => EBinOp(\"==\", lhs, rhs)\n  }\n}\n\n// `let __arr_equals__<key> = (a: Array[t], b: Array[t]) -> Bool { ... }` — a\n// monomorphic, fully-recursive array structural equality. Element compare goes\n// through `eq_for_typed`, so `Array[Foo]` / `Array[Array[Int]]` recurse\n// correctly instead of identity-comparing aggregate elements. (#695.)\nfn gen_arr_equals_fn(elem_ty: TypeExpr, known_types: Array[String]) -> Stmt {\n  let len_a = ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"a\", -1)\n  ], 0, 1), -1)\n  let len_b = ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"b\", -1)\n  ], 0, 1), -1)\n  let elem_a = ECall(EIdent(\"Array::get\", -1), Array::slice([\n    EIdent(\"a\", -1),\n    EIdent(\"__ae_i\", -1)\n  ], 0, 2), -1)\n  let elem_b = ECall(EIdent(\"Array::get\", -1), Array::slice([\n    EIdent(\"b\", -1),\n    EIdent(\"__ae_i\", -1)\n  ], 0, 2), -1)\n  let elem_eq = eq_for_typed(elem_ty, elem_a, elem_b, known_types)\n  let not_eq = ECall(EIdent(\"not\", -1), Array::slice([\n    elem_eq\n  ], 0, 1), -1)\n  let set_false = EIf(not_eq, EAssign(\"__ae_ok\", EBool(false), EUnit), EUnit)\n  let incr = EAssign(\"__ae_i\", EBinOp(\"+\", EIdent(\"__ae_i\", -1), EInt(1)), EUnit)\n  let loop_body = ESeq(set_false, incr)\n  let while_loop = EWhile(EBinOp(\"<\", EIdent(\"__ae_i\", -1), ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"a\", -1)\n  ], 0, 1), -1)), loop_body)\n  let body_eq = ELetMut(\"__ae_i\", EInt(0), ELetMut(\"__ae_ok\", EBool(true), ESeq(while_loop, EIdent(\"__ae_ok\", -1)), -1), -1)\n  let body = EIf(EBinOp(\"!=\", len_a, len_b), EBool(false), body_eq)\n  let arr_ty = TyApp(\"Array\", Array::slice([\n    elem_ty\n  ], 0, 1))\n  let params = Array::slice([\n    (\"a\", Some(arr_ty)),\n    (\"b\", Some(arr_ty))\n  ], 0, 2)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, arr_equals_name(elem_ty), None, EFn(no_tp, no_tb, params, Some(TyName(\"Bool\")), None, body))\n}\n\n// One field's equality expression: `a.f == b.f` for scalar/param fields, or a\n// direct `FieldType::equals(a.f, b.f)` for aggregate (declared struct/enum)\n// fields so nested/recursive structs compare structurally. (#672 recursion.)\nfn field_eq_expr(fname: String, fty: TypeExpr, known_types: Array[String]) -> Expr {\n  eq_for_typed(fty, EDot(EIdent(\"a\", -1), fname, -1, -1), EDot(EIdent(\"b\", -1), fname, -1, -1), known_types)\n}\n\n// `let P::equals = (a: P, b: P) -> Bool { a.x == b.x && a.y == b.y && ... }`\n// Mirrors gen_compare_fn. Primitive fields compare with `==`; aggregate fields\n// recurse through the field type's generated `equals`. An empty struct is `true`.\nfn gen_eq_fn(tname: String, fields: Array[(String, TypeExpr)], known_types: Array[String]) -> Stmt {\n  let mut body = EBool(true)\n  let mut i = Array::length(fields) - 1\n  while i >= 0 {\n    let (fname, fty) = Array::get(fields, i)\n    body = EBinOp(\"&&\", field_eq_expr(fname, fty, known_types), body)\n    i = i - 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(tname))),\n    (\"b\", Some(TyName(tname)))\n  ], 0, 2)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(tname, \"equals\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Bool\")), None, body))\n}\n\n// Small non-negative Int -> decimal String (Int::to_string is not in scope in\n// this module). Used only to make unique enum-field binder names.\nfn digit_str(d: Int) -> String {\n  if d == 0 {\n    \"0\"\n  } else if d == 1 {\n    \"1\"\n  } else if d == 2 {\n    \"2\"\n  } else if d == 3 {\n    \"3\"\n  } else if d == 4 {\n    \"4\"\n  } else if d == 5 {\n    \"5\"\n  } else if d == 6 {\n    \"6\"\n  } else if d == 7 {\n    \"7\"\n  } else if d == 8 {\n    \"8\"\n  } else {\n    \"9\"\n  }\n}\n\nfn idx_str(n: Int) -> String {\n  if n < 10 {\n    digit_str(n)\n  } else {\n    String::concat(idx_str(n / 10), digit_str(n % 10))\n  }\n}\n\n// `let E::equals = (a: E, b: E) -> Bool {\n//    match a {\n//      V1(_a0, _a1) => match b { V1(_b0, _b1) => _a0 == _b0 && _a1 == _b1, _ => false },\n//      V2          => match b { V2 => true, _ => false }, ... } }`\n// Tag mismatch falls to the inner `_ => false`; payload `==` is itself\n// dispatched, so aggregate payloads recurse into their own `equals`.\nfn gen_enum_eq_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {\n  let outer_arms = array_empty()\n  let mut vi = 0\n  while vi < Array::length(variants) {\n    let (vname, ftypes) = Array::get(variants, vi)\n    let nf = Array::length(ftypes)\n    let abinds = array_empty()\n    let bbinds = array_empty()\n    let mut fi = 0\n    while fi < nf {\n      Array::push(abinds, PBind(String::concat(\"__a\", idx_str(fi))))\n      Array::push(bbinds, PBind(String::concat(\"__b\", idx_str(fi))))\n      fi = fi + 1\n    }\n    let mut body = EBool(true)\n    let mut bi = nf - 1\n    while bi >= 0 {\n      let cmp = eq_for_typed(Array::get(ftypes, bi), EIdent(String::concat(\"__a\", idx_str(bi)), -1), EIdent(String::concat(\"__b\", idx_str(bi)), -1), known_types)\n      body = EBinOp(\"&&\", cmp, body)\n      bi = bi - 1\n    }\n    let inner_arms = Array::slice([\n      (PCtor(vname, bbinds), body),\n      (PWild, EBool(false))\n    ], 0, 2)\n    let inner = EMatch(EIdent(\"b\", -1), inner_arms)\n    Array::push(outer_arms, (PCtor(vname, abinds), inner))\n    vi = vi + 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(ename))),\n    (\"b\", Some(TyName(ename)))\n  ], 0, 2)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(ename, \"equals\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Bool\")), None, EMatch(EIdent(\"a\", -1), outer_arms)))\n}\n\n// `let P::compare = (a: P, b: P) -> Int { lexicographic over fields -> -1/0/1 }`\nfn gen_compare_fn(tname: String, fields: Array[(String, TypeExpr)]) -> Stmt {\n  let neg_one = 0 - 1\n  let mut body = EInt(0)\n  let mut i = Array::length(fields) - 1\n  while i >= 0 {\n    let (fname, _) = Array::get(fields, i)\n    let af = EDot(EIdent(\"a\", -1), fname, -1, -1)\n    let bf = EDot(EIdent(\"b\", -1), fname, -1, -1)\n    body = EIf(EBinOp(\"<\", af, bf), EInt(neg_one), EIf(EBinOp(\">\", af, bf), EInt(1), body))\n    i = i - 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(tname))),\n    (\"b\", Some(TyName(tname)))\n  ], 0, 2)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(tname, \"compare\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Int\")), None, body))\n}\n\n// Show an arbitrary value expression by its declared type (#694: type-directed\n// and recursive via `show_for_typed`, so aggregate enum payloads — nested\n// struct/enum, Option, Result, tuple, Array — render structurally instead of\n// through the `__to_string` pointer heuristic).\nfn show_expr_typed(val: Expr, fty: TypeExpr, known_types: Array[String]) -> Expr {\n  show_for_typed(fty, val, known_types)\n}\n\n// `let E::to_string = (self: E) -> String {\n//    match self { V0(_a0, _a1) => \"V0(\" ++ show(_a0) ++ \", \" ++ show(_a1) ++ \")\",\n//                 V1 => \"V1\", ... } }`\n// A nullary variant shows as its bare name; a payload variant shows as\n// `Name(p0, p1, ...)` with each payload shown structurally.\nfn gen_enum_show_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {\n  let arms = array_empty()\n  let mut vi = 0\n  while vi < Array::length(variants) {\n    let (vname, ftypes) = Array::get(variants, vi)\n    let nf = Array::length(ftypes)\n    let binds = array_empty()\n    let mut fi = 0\n    while fi < nf {\n      Array::push(binds, PBind(String::concat(\"__s\", idx_str(fi))))\n      fi = fi + 1\n    }\n    let body = if nf == 0 {\n      EString(vname)\n    } else {\n      let segs = empty_expr_array()\n      Array::push(segs, EString(String::concat(vname, \"(\")))\n      let mut si = 0\n      while si < nf {\n        let sep = if si == 0 {\n          \"\"\n        } else \", \"\n        if sep != \"\" {\n          Array::push(segs, EString(sep))\n        } else {\n          ()\n        }\n        Array::push(segs, show_expr_typed(EIdent(String::concat(\"__s\", idx_str(si)), -1), Array::get(ftypes, si), known_types))\n        si = si + 1\n      }\n      Array::push(segs, EString(\")\"))\n      let mut acc = Array::get(segs, Array::length(segs) - 1)\n      let mut j = Array::length(segs) - 2\n      while j >= 0 {\n        acc = concat2(Array::get(segs, j), acc)\n        j = j - 1\n      }\n      acc\n    }\n    Array::push(arms, (PCtor(vname, binds), body))\n    vi = vi + 1\n  }\n  let params = Array::slice([\n    (\"self\", Some(TyName(ename)))\n  ], 0, 1)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(ename, \"to_string\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, EMatch(EIdent(\"self\", -1), arms)))\n}\n\n// `let T::hash_key = (self: T) -> String { T::to_string(self) }` (#694 Layer 1).\n// `derive(Hash)` makes a type usable as a Map key via the method-bearing `Hash`\n// trait (`hash_key(Self) -> String`): `map_key_to_string = [K: Hash](key) ->\n// K::hash_key(key)` threads the witness (#684), and at a concrete call site\n// `get_by(m, T::{..})` the synthesized `HashDict::{ hash_key: T::hash_key }`\n// resolves here. The key is the structural `to_string` (now fully recursive via\n// `show_for_typed`), so two distinct-but-field-equal values hash to one entry.\nfn gen_hash_key_fn(tname: String) -> Stmt {\n  let body = ECall(EIdent(qualified_name(tname, \"to_string\"), -1), Array::slice([\n    EIdent(\"self\", -1)\n  ], 0, 1), -1)\n  let params = Array::slice([\n    (\"self\", Some(TyName(tname)))\n  ], 0, 1)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(tname, \"hash_key\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, body))\n}\n\n// Append any `Array[e]` element types referenced by a TypeExpr to `acc`\n// (dedup by type-key), so a Show/Hash-deriving type with an `Array[t]` field or\n// payload gets a generated `__arr_to_string__<key>` helper. (#694 Layer 2.)\nfn collect_show_array_elems(ty: TypeExpr, acc: Array[TypeExpr], keys: Array[String]) -> Unit {\n  match ty {\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      let et = Array::get(args, 0)\n      let k = ts_type_key(et)\n      if str_array_contains(keys, k) {\n        ()\n      } else {\n        Array::push(keys, k)\n        Array::push(acc, et)\n      }\n    } else {\n      ()\n    },\n    _ => ()\n  }\n}\n\n// Compare two operands of declared type `fty`, returning -1/0/1. Aggregate\n// (declared struct/enum) operands recurse through `T::compare`; scalars and type\n// parameters use the runtime structural `<` / `>` (codegen handles them).\nfn compare_for_typed(fty: TypeExpr, lhs: Expr, rhs: Expr, known_types: Array[String]) -> Expr {\n  let neg_one = 0 - 1\n  match fty {\n    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"compare\"), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EIf(EBinOp(\"<\", lhs, rhs), EInt(neg_one), EIf(EBinOp(\">\", lhs, rhs), EInt(1), EInt(0)))\n    },\n    _ => EIf(EBinOp(\"<\", lhs, rhs), EInt(neg_one), EIf(EBinOp(\">\", lhs, rhs), EInt(1), EInt(0)))\n  }\n}\n\n// `let E::compare = (a: E, b: E) -> Int { ... }`\n// Lexicographic: first by variant order (a's tag index vs b's tag index), then\n// (same variant) by payload, recursively. The variant index of `a` is computed\n// by matching `a`; for each `a` variant the inner match on `b` either compares\n// payloads (same variant) or returns the sign of (a_index - b_index).\nfn gen_enum_compare_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {\n  let neg_one = 0 - 1\n  let outer_arms = array_empty()\n  let mut ai = 0\n  while ai < Array::length(variants) {\n    let (avname, aftypes) = Array::get(variants, ai)\n    let anf = Array::length(aftypes)\n    let abinds = array_empty()\n    let mut afi = 0\n    while afi < anf {\n      Array::push(abinds, PBind(String::concat(\"__a\", idx_str(afi))))\n      afi = afi + 1\n    }\n    // inner match over b: for the same variant compare payloads; otherwise the\n    // sign comes from the variant order (a before b -> -1, after -> 1).\n    let inner_arms = array_empty()\n    let mut bi = 0\n    while bi < Array::length(variants) {\n      let (bvname, bftypes) = Array::get(variants, bi)\n      let bnf = Array::length(bftypes)\n      let bbinds = array_empty()\n      let mut bfi = 0\n      while bfi < bnf {\n        Array::push(bbinds, PBind(String::concat(\"__b\", idx_str(bfi))))\n        bfi = bfi + 1\n      }\n      let arm_body = if ai == bi {\n        // same variant: lexicographic over payloads, 0 if no payload.\n        let mut body = EInt(0)\n        let mut pi = anf - 1\n        while pi >= 0 {\n          let cmp = compare_for_typed(Array::get(aftypes, pi), EIdent(String::concat(\"__a\", idx_str(pi)), -1), EIdent(String::concat(\"__b\", idx_str(pi)), -1), known_types)\n          let prev = body\n          body = EIf(EBinOp(\"<\", cmp, EInt(0)), EInt(neg_one), EIf(EBinOp(\">\", cmp, EInt(0)), EInt(1), prev))\n          pi = pi - 1\n        }\n        body\n      } else if ai < bi {\n        EInt(neg_one)\n      } else {\n        EInt(1)\n      }\n      Array::push(inner_arms, (PCtor(bvname, bbinds), arm_body))\n      bi = bi + 1\n    }\n    Array::push(outer_arms, (PCtor(avname, abinds), EMatch(EIdent(\"b\", -1), inner_arms)))\n    ai = ai + 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(ename))),\n    (\"b\", Some(TyName(ename)))\n  ], 0, 2)\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(ename, \"compare\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Int\")), None, EMatch(EIdent(\"a\", -1), outer_arms)))\n}\n\n// The default value expression for a declared field type. Per-type rules:\n//   Int -> 0, Double/Float -> 0.0, Bool -> false, String -> \"\", Unit -> (),\n//   Option[_] -> None, Array[_] -> empty array, and a declared struct/enum\n//   (in `known_types`) -> `T::default()`. A type with no sensible default (a\n//   bare type parameter, a function/tuple type, an unknown name) falls back to\n//   `()` — codegen will then flag the literal against the field's real type, so\n//   the limitation surfaces as a type error rather than silently wrong data.\nfn default_for_type(fty: TypeExpr, known_types: Array[String]) -> Expr {\n  match fty {\n    TyName(\"Int\") => EInt(0),\n    TyName(\"Double\") => EFloat(0.0),\n    TyName(\"Float\") => EFloat(0.0),\n    TyName(\"Bool\") => EBool(false),\n    TyName(\"String\") => EString(\"\"),\n    TyName(\"Unit\") => EUnit,\n    TyName(n) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"default\"), -1), empty_expr_array(), -1)\n    } else {\n      EUnit\n    },\n    TyApp(\"Option\", _) => EIdent(\"None\", -1),\n    TyApp(\"Array\", _) => EArray(empty_expr_array()),\n    TyApp(n, _) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"default\"), -1), empty_expr_array(), -1)\n    } else {\n      EUnit\n    },\n    TyUnit => EUnit,\n    _ => EUnit\n  }\n}\n\n// `let P::default = () -> P { P::{ f1: <default>, ... } }` — a struct literal\n// (ERecord; the struct type is recovered from the field set) with each field at\n// its type's default.\nfn gen_default_fn(tname: String, fields: Array[(String, TypeExpr)], known_types: Array[String]) -> Stmt {\n  let rec_fields = array_empty()\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (fname, fty) = Array::get(fields, i)\n    Array::push(rec_fields, (fname, default_for_type(fty, known_types)))\n    i = i + 1\n  }\n  let no_params = array_empty()\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(tname, \"default\"), None, EFn(no_tp, no_tb, no_params, Some(TyName(tname)), None, ERecord(\"\", rec_fields, empty_ty_args())))\n}\n\n// `let E::default = () -> E { V0(<default>, ...) }` — the FIRST variant, with\n// each payload slot at its type's default (nullary -> bare constructor name).\nfn gen_enum_default_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {\n  let (vname, ftypes) = Array::get(variants, 0)\n  let body = if Array::length(ftypes) == 0 {\n    EIdent(vname, -1)\n  } else {\n    let args = empty_expr_array()\n    let mut i = 0\n    while i < Array::length(ftypes) {\n      Array::push(args, default_for_type(Array::get(ftypes, i), known_types))\n      i = i + 1\n    }\n    ECall(EIdent(vname, -1), args, -1)\n  }\n  let no_params = array_empty()\n  let no_tp = array_empty()\n  let no_tb = array_empty()\n  SLet(false, false, qualified_name(ename, \"default\"), None, EFn(no_tp, no_tb, no_params, Some(TyName(ename)), None, body))\n}\n\n// Scan `ty` and, for every `Array[e]` shape found anywhere inside it, append the\n// element type `e` to `acc` (deduped by `type_key`). Only the immediate element\n// types are added here; transitive nesting (`Array[Array[Int]]` needs the\n// `Array[Int]` helper too) is closed by the worklist loop in the caller, which\n// re-scans every element type it collects. (#695.)\nfn collect_array_elem_types(ty: TypeExpr, acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {\n  match ty {\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      let e = Array::get(args, 0)\n      let k = type_key(e)\n      if !str_array_contains(acc_keys, k) {\n        Array::push(acc, e)\n        Array::push(acc_keys, k)\n      } else {\n        ()\n      }\n      collect_array_elem_types(e, acc, acc_keys)\n    } else {\n      ()\n    },\n    TyApp(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_array_elem_types(Array::get(args, i), acc, acc_keys)\n        i = i + 1\n      }\n    },\n    TyTuple(ts) => {\n      let mut i = 0\n      while i < Array::length(ts) {\n        collect_array_elem_types(Array::get(ts, i), acc, acc_keys)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\n// Best-effort element TypeExpr of an array LITERAL, inferred from its first\n// element: scalars and nested array literals only. An empty array, or a first\n// element whose type is not statically obvious here (variables, struct records,\n// calls), yields `None` — the caller then leaves a bare-array `==` as the\n// status-quo scalar binop (documented #695 residual) rather than guessing.\n// Is `e` an empty array literal `[]`? Used to reduce `[] == x` to a length check.\nfn is_empty_array_lit(e: Expr) -> Bool {\n  match e {\n    EArray(elems) => Array::length(elems) == 0,\n    _ => false\n  }\n}\n\nfn infer_earray_elem_type(arr: Expr) -> Option[TypeExpr] {\n  match arr {\n    EArray(elems) => if Array::length(elems) == 0 {\n      None\n    } else {\n      match Array::get(elems, 0) {\n        EInt(_) => Some(TyName(\"Int\")),\n        EBool(_) => Some(TyName(\"Bool\")),\n        EString(_) => Some(TyName(\"String\")),\n        EFloat(_) => Some(TyName(\"Double\")),\n        EArray(_) => match infer_earray_elem_type(Array::get(elems, 0)) {\n          Some(inner) => Some(TyApp(\"Array\", Array::slice([\n            inner\n          ], 0, 1))),\n          None => None\n        },\n        _ => None\n      }\n    },\n    _ => None\n  }\n}\n\n// #825: does `t` contain the `__EqUnknown` marker anywhere? Used to keep the\n// marker out of generated `__arr_equals__<key>` helper names/annotations (an\n// Array element type must be fully concrete to be usable).\nfn ty_contains_eq_unknown(t: TypeExpr) -> Bool {\n  match t {\n    TyName(n) => n == \"__EqUnknown\",\n    TyApp(_, args) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if ty_contains_eq_unknown(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyTuple(ts) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(ts) {\n        if ty_contains_eq_unknown(Array::get(ts, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    _ => false\n  }\n}\n\n// #825: best-effort full STATIC TypeExpr of a bare `==` operand, inferred from\n// literal syntax alone (no environment). Where the name-based `==` dispatch\n// only recovers a head name (\"Option\"/\"Result\") and compares payloads with a\n// raw word `==`, this recovers the payload SHAPE too, so\n// `Some([1,2]) == Some([1,2])` / `Ok([1,2]) == Ok([1,2])` /\n// `Some(Some(1)) == Some(Some(1))` / `([1,2], 0) == ([1,2], 0)` route through\n// the fully-recursive `eq_for_typed` instead of identity-comparing aggregate\n// payloads. A position whose type is not statically obvious yields the marker\n// `TyName(\"__EqUnknown\")` — never a scalar or declared type, so `eq_for_typed`\n// falls back to raw `==` there (exactly the status-quo behavior for that\n// position). An Array element type must be marker-free (else the whole array\n// is uninferable): the element type names the generated `__arr_equals__<key>`\n// helper and appears in its parameter annotations, where the marker would not\n// resolve.\nfn infer_static_eq_type(e: Expr) -> Option[TypeExpr] {\n  match e {\n    EInt(_) => Some(TyName(\"Int\")),\n    EBool(_) => Some(TyName(\"Bool\")),\n    EString(_) => Some(TyName(\"String\")),\n    EFloat(_) => Some(TyName(\"Double\")),\n    EUnit => Some(TyUnit),\n    EArray(elems) => if Array::length(elems) == 0 {\n      None\n    } else {\n      match infer_static_eq_type(Array::get(elems, 0)) {\n        Some(t) => if ty_contains_eq_unknown(t) {\n          None\n        } else {\n          Some(TyApp(\"Array\", Array::slice([\n            t\n          ], 0, 1)))\n        },\n        None => None\n      }\n    },\n    ETuple(es) => {\n      let ts = empty_type_exprs()\n      let mut i = 0\n      while i < Array::length(es) {\n        match infer_static_eq_type(Array::get(es, i)) {\n          Some(t) => Array::push(ts, t),\n          None => Array::push(ts, TyName(\"__EqUnknown\"))\n        }\n        i = i + 1\n      }\n      Some(TyTuple(ts))\n    },\n    EIdent(n, _) => if n == \"None\" {\n      Some(TyApp(\"Option\", Array::slice([\n        TyName(\"__EqUnknown\")\n      ], 0, 1)))\n    } else {\n      None\n    },\n    ECall(callee, args, _) => match callee {\n      // #825 review follow-up: the docs' qualified ctor spellings\n      // (`Option::Some` / `Result::Ok` / `Result::Err`) must infer the same\n      // shape as the bare forms — they fell through to the name-only path\n      // where aggregate payloads word-compare.\n      EIdent(\"Option::Some\", _) => if Array::length(args) == 1 {\n        let pt = match infer_static_eq_type(Array::get(args, 0)) {\n          Some(t) => t,\n          None => TyName(\"__EqUnknown\")\n        }\n        Some(TyApp(\"Option\", Array::slice([\n          pt\n        ], 0, 1)))\n      } else {\n        None\n      },\n      EIdent(\"Result::Ok\", _) => if Array::length(args) == 1 {\n        let pt = match infer_static_eq_type(Array::get(args, 0)) {\n          Some(t) => t,\n          None => TyName(\"__EqUnknown\")\n        }\n        Some(TyApp(\"Result\", Array::slice([\n          pt,\n          TyName(\"__EqUnknown\")\n        ], 0, 2)))\n      } else {\n        None\n      },\n      EIdent(\"Result::Err\", _) => if Array::length(args) == 1 {\n        let pt = match infer_static_eq_type(Array::get(args, 0)) {\n          Some(t) => t,\n          None => TyName(\"__EqUnknown\")\n        }\n        Some(TyApp(\"Result\", Array::slice([\n          TyName(\"__EqUnknown\"),\n          pt\n        ], 0, 2)))\n      } else {\n        None\n      },\n      EIdent(\"Some\", _) => if Array::length(args) == 1 {\n        let pt = match infer_static_eq_type(Array::get(args, 0)) {\n          Some(t) => t,\n          None => TyName(\"__EqUnknown\")\n        }\n        Some(TyApp(\"Option\", Array::slice([\n          pt\n        ], 0, 1)))\n      } else {\n        None\n      },\n      EIdent(\"Ok\", _) => if Array::length(args) == 1 {\n        let pt = match infer_static_eq_type(Array::get(args, 0)) {\n          Some(t) => t,\n          None => TyName(\"__EqUnknown\")\n        }\n        Some(TyApp(\"Result\", Array::slice([\n          pt,\n          TyName(\"__EqUnknown\")\n        ], 0, 2)))\n      } else {\n        None\n      },\n      EIdent(\"Err\", _) => if Array::length(args) == 1 {\n        let pt = match infer_static_eq_type(Array::get(args, 0)) {\n          Some(t) => t,\n          None => TyName(\"__EqUnknown\")\n        }\n        Some(TyApp(\"Result\", Array::slice([\n          TyName(\"__EqUnknown\"),\n          pt\n        ], 0, 2)))\n      } else {\n        None\n      },\n      _ => None\n    },\n    _ => None\n  }\n}\n\n// #825 review follow-up: pick the static shape for `l == r` from whichever\n// side is MORE concrete. A left-first choice masked a fully concrete right\n// shape — `let xs = [1, 2]; Some(xs) == Some([1, 2])` inferred the left as\n// `Option[__EqUnknown]` and the payload fell back to raw word `==`. Prefer a\n// marker-free shape; between two partial shapes keep the left one.\nfn infer_static_eq_type_binop(l: Expr, r: Expr) -> Option[TypeExpr] {\n  let lt = infer_static_eq_type(l)\n  let rt = infer_static_eq_type(r)\n  match lt {\n    Some(lty) => if ty_contains_eq_unknown(lty) {\n      match rt {\n        Some(rty) => if ty_contains_eq_unknown(rty) {\n          Some(lty)\n        } else {\n          Some(rty)\n        },\n        None => Some(lty)\n      }\n    } else {\n      Some(lty)\n    },\n    None => rt\n  }\n}\n\n// #825: shapes worth dispatching through `eq_for_typed` at a bare `==` site.\n// Only the aggregate shapes the runtime word-compare gets wrong; scalars keep\n// the raw binop and anything unrecognized falls back to the name-based\n// dispatch (which preserves the pre-#825 behavior).\nfn static_eq_dispatchable(t: TypeExpr) -> Bool {\n  match t {\n    TyApp(n, args) => (n == \"Option\" && Array::length(args) == 1) || (n == \"Result\" && Array::length(args) == 2) || (n == \"Array\" && Array::length(args) == 1),\n    TyTuple(_) => true,\n    _ => false\n  }\n}\n\n// Walk an expression and, for every `a == b` / `a != b` whose operand is an\n// array LITERAL with a determinable element type, collect that element type so a\n// `__arr_equals__<key>` helper is generated for the dispatch rewrite to call.\nfn collect_bare_array_eq_keys(e: Expr, acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {\n  match e {\n    EBinOp(op, l, r) => {\n      if op == \"==\" || op == \"!=\" {\n        let et = match infer_earray_elem_type(l) {\n          Some(t) => Some(t),\n          None => infer_earray_elem_type(r)\n        }\n        match et {\n          Some(t) => {\n            let k = type_key(t)\n            if !str_array_contains(acc_keys, k) {\n              Array::push(acc, t)\n              Array::push(acc_keys, k)\n            } else {\n              ()\n            }\n            collect_array_elem_types(t, acc, acc_keys)\n          },\n          None => ()\n        }\n        // #825: the full static-shape dispatch can surface Array element types\n        // nested inside Option/Result/tuple literals (`Some([1,2]) == ...`,\n        // `([1,2], 0) == ...`, `[Some(1)] == ...`) — collect them so their\n        // `__arr_equals__<key>` helpers exist for `eq_for_typed`'s calls.\n        let sty = infer_static_eq_type_binop(l, r)\n        match sty {\n          Some(t2) => collect_array_elem_types(t2, acc, acc_keys),\n          None => ()\n        }\n      } else {\n        ()\n      }\n      collect_bare_array_eq_keys(l, acc, acc_keys)\n      collect_bare_array_eq_keys(r, acc, acc_keys)\n    },\n    EInt(_) => (),\n    EFloat(_) => (),\n    EString(_) => (),\n    EBool(_) => (),\n    EIdent(_, _) => (),\n    EUnit => (),\n    ETuple(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\n    EArray(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\n    ERecord(_, fs, _) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, fe) = Array::get(fs, i)\n        collect_bare_array_eq_keys(fe, acc, acc_keys)\n        i = i + 1\n      }\n    },\n    EMap(fs) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, fe) = Array::get(fs, i)\n        collect_bare_array_eq_keys(fe, acc, acc_keys)\n        i = i + 1\n      }\n    },\n    EIf(c, t, el) => {\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n      collect_bare_array_eq_keys(t, acc, acc_keys)\n      collect_bare_array_eq_keys(el, acc, acc_keys)\n    },\n    ELet(_, v, b, _) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ELetRec(_, v, b) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ELetMut(_, v, b, _) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    EAssign(_, v, c) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n    },\n    EAssignOp(_, _, v, c) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n    },\n    ESeq(a, b) => {\n      collect_bare_array_eq_keys(a, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    EMatch(s, arms) => {\n      collect_bare_array_eq_keys(s, acc, acc_keys)\n      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)\n    },\n    EHandle(s, arms) => {\n      collect_bare_array_eq_keys(s, acc, acc_keys)\n      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)\n    },\n    EWhile(c, b) => {\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ELoop(params, b) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        collect_bare_array_eq_keys(init, acc, acc_keys)\n        i = i + 1\n      }\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    EForIn(_, _, it, b) => {\n      collect_bare_array_eq_keys(it, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ECall(callee, args, _) => {\n      collect_bare_array_eq_keys(callee, acc, acc_keys)\n      collect_bare_array_eq_keys_list(args, acc, acc_keys)\n    },\n    EUnaryOp(_, x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n    EFn(_, _, _, _, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),\n    EDot(o, _, _, _) => collect_bare_array_eq_keys(o, acc, acc_keys),\n    ELabeledArg(_, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),\n    EReturn(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n    EBreak(opt) => match opt {\n      Some(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n      None => ()\n    },\n    EContinue(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\n    ESpread(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n    _ => ()\n  }\n}\n\nfn collect_bare_array_eq_keys_list(es: Array[Expr], acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(es) {\n    collect_bare_array_eq_keys(Array::get(es, i), acc, acc_keys)\n    i = i + 1\n  }\n}\n\nfn collect_bare_array_eq_keys_arms(arms: Array[(Pat, Expr)], acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, b) = Array::get(arms, i)\n    collect_bare_array_eq_keys(b, acc, acc_keys)\n    i = i + 1\n  }\n}\n\n// In-place: for each struct with `derive(Show/Ord)`, append the structural\n// function if not already present (idempotent across the double-run pipeline).\n// The set of concrete struct/enum names declared in the program — the gate for\n// emitting DIRECT `T::equals` calls in generated comparators (a field/arg whose\n// type name is NOT here, e.g. a type parameter `T` of `Box[T]`, falls back to\n// scalar `==`, since there is no `T::equals` to call).\nfn collect_decl_type_names(stmts: Array[Stmt]) -> Array[String] {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, name, _, _, _, _) => Array::push(out, name),\n      SEnum(_, ename, _, _, _) => Array::push(out, ename),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport fn desugar_derives(stmts: Array[Stmt]) -> Unit {\n  let gen = empty_stmt_list()\n  let known_types = collect_decl_type_names(stmts)\n  // #694 Layer 2: collect `Array[e]` element types referenced by Show/Hash-\n  // deriving types' fields/payloads, so each gets a `__arr_to_string__<key>`\n  // helper. A worklist closes nesting (`Array[Array[Int]]` -> `Array[Int]`).\n  let arr_elems = empty_type_exprs()\n  let arr_keys = empty_str_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, name, fields, derives, _, _) => {\n        // `derive(Hash)` also needs the structural `to_string`: a Hash type's\n        // stable Map-key string is its structural representation (#638), so\n        // generate `to_string` for Show OR Hash.\n        if (str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\")) && !top_level_fn_exists(stmts, qualified_name(name, \"to_string\")) {\n          Array::push(gen, gen_show_fn(name, fields, known_types))\n        } else {\n          ()\n        }\n        // #694 Layer 1: `derive(Hash)` -> structural `T::hash_key` (delegates to\n        // the recursive `to_string`), so the method-bearing `Hash` witness at a\n        // `get_by(m, T::{..})` call site resolves to a stable structural key.\n        if str_array_contains(derives, \"Hash\") && !top_level_fn_exists(stmts, qualified_name(name, \"hash_key\")) {\n          Array::push(gen, gen_hash_key_fn(name))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\") {\n          let mut fi = 0\n          while fi < Array::length(fields) {\n            let (_, fty) = Array::get(fields, fi)\n            collect_show_array_elems(fty, arr_elems, arr_keys)\n            fi = fi + 1\n          }\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Ord\") && !top_level_fn_exists(stmts, qualified_name(name, \"compare\")) {\n          Array::push(gen, gen_compare_fn(name, fields))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Default\") && !top_level_fn_exists(stmts, qualified_name(name, \"default\")) {\n          Array::push(gen, gen_default_fn(name, fields, known_types))\n        } else {\n          ()\n        }\n        // Generate `T::equals` for every struct (not just derive(Eq)) so the\n        // `==` dispatch below always resolves; structural equality is the\n        // sensible default for any struct, and a struct never relied on the old\n        // pointer-identity `==` (which was silently always-false).\n        if !top_level_fn_exists(stmts, qualified_name(name, \"equals\")) {\n          Array::push(gen, gen_eq_fn(name, fields, known_types))\n        } else {\n          ()\n        }\n      },\n      SEnum(_, ename, _, variants, derives) => {\n        if (str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\")) && !top_level_fn_exists(stmts, qualified_name(ename, \"to_string\")) {\n          Array::push(gen, gen_enum_show_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Hash\") && !top_level_fn_exists(stmts, qualified_name(ename, \"hash_key\")) {\n          Array::push(gen, gen_hash_key_fn(ename))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\") {\n          let mut vi = 0\n          while vi < Array::length(variants) {\n            let (_, ftypes) = Array::get(variants, vi)\n            let mut ti = 0\n            while ti < Array::length(ftypes) {\n              collect_show_array_elems(Array::get(ftypes, ti), arr_elems, arr_keys)\n              ti = ti + 1\n            }\n            vi = vi + 1\n          }\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Ord\") && !top_level_fn_exists(stmts, qualified_name(ename, \"compare\")) {\n          Array::push(gen, gen_enum_compare_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Default\") && !top_level_fn_exists(stmts, qualified_name(ename, \"default\")) {\n          Array::push(gen, gen_enum_default_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n        // Generate `E::equals` for every enum (same rationale as structs), so\n        // the `==` dispatch resolves enum operands too.\n        if !top_level_fn_exists(stmts, qualified_name(ename, \"equals\")) {\n          Array::push(gen, gen_enum_eq_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  // #695: collect every `Array[e]` element type referenced by struct fields /\n  // enum payloads (transitively) plus those surfaced by bare-array `==` sites in\n  // user code, then emit one monomorphic `__arr_equals__<key>` helper per\n  // distinct key. The worklist closes nesting: scanning element type `e` may\n  // surface a further `Array[u]` whose helper is also required. Idempotent:\n  // guarded by `top_level_fn_exists` so re-running the pass is inert.\n  let elem_types = empty_type_exprs()\n  let elem_keys = empty_str_array()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, _, fields, _, _, _) => {\n        let mut fi = 0\n        while fi < Array::length(fields) {\n          let (_, fty) = Array::get(fields, fi)\n          collect_array_elem_types(fty, elem_types, elem_keys)\n          fi = fi + 1\n        }\n      },\n      SEnum(_, _, _, variants, _) => {\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (_, ftypes) = Array::get(variants, vi)\n          let mut ti = 0\n          while ti < Array::length(ftypes) {\n            collect_array_elem_types(Array::get(ftypes, ti), elem_types, elem_keys)\n            ti = ti + 1\n          }\n          vi = vi + 1\n        }\n      },\n      SLet(_, _, _, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      SLetMut(_, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      SExpr(e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      STest(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      SBench(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      _ => ()\n    }\n    si = si + 1\n  }\n  // Worklist closure: scanning each collected element type can surface further\n  // nested array element types (e.g. `Array[Array[Int]]` -> `Array[Int]`).\n  let mut wi = 0\n  while wi < Array::length(elem_types) {\n    collect_array_elem_types(Array::get(elem_types, wi), elem_types, elem_keys)\n    wi = wi + 1\n  }\n  let mut ei = 0\n  while ei < Array::length(elem_types) {\n    let et = Array::get(elem_types, ei)\n    if !top_level_fn_exists(stmts, arr_equals_name(et)) {\n      Array::push(gen, gen_arr_equals_fn(et, known_types))\n    } else {\n      ()\n    }\n    ei = ei + 1\n  }\n  // #694: emit `__arr_to_string__<key>` helpers for Array element types\n  // referenced by Show/Hash-deriving fields/payloads (`arr_elems` populated in\n  // the struct/enum arms above). Independent of the #695 `__arr_equals__` set.\n  let mut wi2 = 0\n  while wi2 < Array::length(arr_elems) {\n    collect_show_array_elems(Array::get(arr_elems, wi2), arr_elems, arr_keys)\n    wi2 = wi2 + 1\n  }\n  let mut ei2 = 0\n  while ei2 < Array::length(arr_elems) {\n    let et2 = Array::get(arr_elems, ei2)\n    if !top_level_fn_exists(stmts, arr_to_string_name(et2)) {\n      Array::push(gen, gen_arr_to_string_fn(et2, known_types))\n    } else {\n      ()\n    }\n    ei2 = ei2 + 1\n  }\n  let mut g = 0\n  while g < Array::length(gen) {\n    Array::push(stmts, Array::get(gen, g))\n    g = g + 1\n  }\n}\n\nfn empty_stmt_list() -> Array[Stmt] {\n  array_empty()\n}\n\nfn struct_decl_exists(stmts: Array[Stmt], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, sname, _, _, _, _) => if sname == name {\n        found = true\n        i = Array::length(stmts)\n      } else {\n        i = i + 1\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  found\n}\n\n///|\n// ===== #786: hoist non-capturing effectful local lambdas to top-level =====\n// A `let f = () -> { perform ... }` bound INSIDE a block compiles to a closure\n// value; calling it inside `handle` drives a miscompiled effect+closure lowering\n// (unregistered arity-1 closure type / infinite recursion, #786). The identical\n// function at TOP LEVEL compiles to a direct call and works. So hoist a local\n// `let`-bound lambda whose body performs/throws and that provably captures NO\n// enclosing local, to a fresh top-level `let`, rewriting its call sites.\n//\n// Safety: hoisted only when EVERY free identifier (used, not bound inside the\n// lambda) is an effect keyword (perform/throw/resume), a qualified name (`A::b`),\n// or a constructor (Uppercase-initial). Locals are snake_case (lowercase,\n// unqualified) by convention, so any captured local fails the test -- the pass\n// can never hoist a capturing lambda. Bare lowercase top-level helpers also fail,\n// so such lambdas are left alone (a safe miss, not a miscompile).\nfn dlh_name_ok(n: String) -> Bool {\n  if n == \"perform\" || n == \"throw\" || n == \"resume\" {\n    true\n  } else if String::index_of(n, \"::\") >= 0 {\n    true\n  } else if String::length(n) > 0 {\n    let c = String::char_code_at(n, 0)\n    c >= 65 && c <= 90\n  } else {\n    false\n  }\n}\n\n///|\nfn dlh_with(arr: Array[String], name: String) -> Array[String] {\n  let out = Array::slice(arr, 0, Array::length(arr))\n  Array::push(out, name)\n  out\n}\n\n///|\n// Local membership test — avoids depending on `array_contains_str` (defined in\n// other compiler modules and NOT imported here; it resolves in the concatenated\n// sources bundle but is `unknown name` in the strict per-module module_source\n// merge that the FS-compile lane type-checks).\nfn dlh_contains(arr: Array[String], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == name {\n      found = true\n      i = Array::length(arr)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n///|\nfn dlh_strip_tilde(n: String) -> String {\n  let ln = String::length(n)\n  if ln > 0 && n[ln - 1: ln] == \"~\" {\n    n[0: ln - 1]\n  } else {\n    n\n  }\n}\n\n///|\nfn dlh_pat_binds(p: Pat, out: Array[String]) -> Unit {\n  match p {\n    PBind(n) => Array::push(out, n),\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        dlh_pat_binds(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    PTuple(ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        dlh_pat_binds(Array::get(ps, i), out)\n        i = i + 1\n      }\n    },\n    POr(a, b) => {\n      dlh_pat_binds(a, out)\n      dlh_pat_binds(b, out)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        dlh_pat_binds(fp, out)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\n///|\n// #786 targets `perform` inside a local lambda that is later called under a\n// `handle`. Hoisting is gated on the body containing a `perform` specifically —\n// NOT `throw`. A `throw(SubErr(..))` lambda (see effect_handler_test) has no\n// closure bug and compiled fine as a local closure; hoisting it to top-level\n// would relocate its bare suberror-ctor references (`KeyInvalid`) out of the\n// scope that resolves them (`undefined variable (local): KeyInvalid @call`).\nfn dlh_has_perform(expr: Expr) -> Bool {\n  match expr {\n    ECall(callee, args, _) => {\n      let head = match callee {\n        EIdent(n, _) => n == \"perform\",\n        _ => false\n      }\n      // #640 Stage 2: `throw(x)` now parses to `perform Error::Throw(x)`, but\n      // the hoist gate must keep treating it as a THROW, not a perform — the\n      // comment above this function documents exactly why hoisting a\n      // `throw(SubErr(..))` lambda breaks (bare suberror-ctor references get\n      // relocated out of resolving scope). Recurse into the payload so a real\n      // perform nested inside a throw payload still triggers.\n      let is_throw_shape = if head && Array::length(args) == 1 {\n        match Array::get(args, 0) {\n          ECall(op_callee, _, _) => match op_callee {\n            EIdent(op_n, _) => op_n == \"Error::Throw\",\n            _ => false\n          },\n          _ => false\n        }\n      } else {\n        false\n      }\n      if head && !is_throw_shape {\n        true\n      } else {\n        let mut i = 0\n        let mut found = dlh_has_perform(callee)\n        while i < Array::length(args) {\n          if dlh_has_perform(Array::get(args, i)) {\n            found = true\n          } else {\n            ()\n          }\n          i = i + 1\n        }\n        found\n      }\n    },\n    EBinOp(_, l, r) => dlh_has_perform(l) || dlh_has_perform(r),\n    EUnaryOp(_, e) => dlh_has_perform(e),\n    EIf(c, t, e) => dlh_has_perform(c) || dlh_has_perform(t) || dlh_has_perform(e),\n    ELet(_, v, b, _) => dlh_has_perform(v) || dlh_has_perform(b),\n    ELetRec(_, v, b) => dlh_has_perform(v) || dlh_has_perform(b),\n    ELetMut(_, v, b, _) => dlh_has_perform(v) || dlh_has_perform(b),\n    EAssign(_, v, c) => dlh_has_perform(v) || dlh_has_perform(c),\n    EAssignOp(_, _, v, c) => dlh_has_perform(v) || dlh_has_perform(c),\n    ESeq(a, b) => dlh_has_perform(a) || dlh_has_perform(b),\n    EWhile(c, b) => dlh_has_perform(c) || dlh_has_perform(b),\n    EForIn(_, _, it, b) => dlh_has_perform(it) || dlh_has_perform(b),\n    EDot(o, _, _, _) => dlh_has_perform(o),\n    ELabeledArg(_, _, e) => dlh_has_perform(e),\n    EReturn(e) => dlh_has_perform(e),\n    EMatch(s, arms) => dlh_has_perform(s) || dlh_has_perform_arms(arms),\n    EHandle(s, _) => dlh_has_perform(s),\n    _ => false\n  }\n}\n\n// Collect the effect-name prefix (`split_qualified`'s head, or the bare\n// operand name if unqualified) of every `perform <qname>`/`perform\n// <qname>(args)` found in `expr`, deduped, into `out`. Mirrors\n// dlh_has_perform's exact traversal shape (same `Error::Throw` exclusion,\n// same set of recursed-into node kinds -- deliberately NOT into a nested\n// EFn, matching dlh_has_perform's own scope: a perform inside a DEEPER\n// nested closure is that closure's own concern when/if IT is separately\n// hoisted, not this one's).\n//\n// Exists to fix a real bug found via gc-backend coverage testing\n// (2026-07-23): a local closure with NO explicit `with {...}` annotation\n// (its `eff` field is `None` in the AST -- the checker infers its\n// effect row internally but never writes it back onto the node) that\n// performs an effect and gets lambda-lifted to a fresh top-level binding\n// by dlh_hoist_expr (the capture-free case) used to keep `eff = None` on\n// the hoisted definition too. `evidence_dict_pass` classifies TOP-LEVEL\n// functions as \"needing\" an effect purely by reading this row string\n// (codegen/common_base/inline_direct_perform.vibe's edp_collect_fn_defs),\n// so the hoisted function was silently never recognized as needing\n// anything, and its `perform` was never migrated -- harmless on the\n// linear backend (an un-rewritten perform just falls back to replay\n// codegen, still correct) but a hard \"unsupported perform\" compile error\n// on the gc backend, which has no such fallback. See\n// fixtures/effect_handle_call_evidence_closure_literal.vibe's\n// `never_called` for the exact shape that surfaced this.\nfn dlh_collect_performed_effect_names(expr: Expr, out: Array[String]) -> Unit {\n  match expr {\n    ECall(callee, args, _) => {\n      let head = match callee {\n        EIdent(n, _) => n == \"perform\",\n        _ => false\n      }\n      if head && Array::length(args) == 1 {\n        let operand = Array::get(args, 0)\n        let qname = match operand {\n          EIdent(qn, _) => Some(qn),\n          ECall(op_callee, _, _) => match op_callee {\n            EIdent(qn, _) => Some(qn),\n            _ => None\n          },\n          _ => None\n        }\n        match qname {\n          Some(qn) => if qn != \"Error::Throw\" {\n            let ename = match split_qualified(qn) {\n              Some((h, _)) => h,\n              None => qn\n            }\n            if dlh_contains(out, ename) {\n              ()\n            } else {\n              Array::push(out, ename)\n            }\n          } else {\n            ()\n          },\n          None => ()\n        }\n      } else {\n        ()\n      }\n      dlh_collect_performed_effect_names(callee, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        dlh_collect_performed_effect_names(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    EBinOp(_, l, r) => {\n      dlh_collect_performed_effect_names(l, out)\n      dlh_collect_performed_effect_names(r, out)\n    },\n    EUnaryOp(_, e) => dlh_collect_performed_effect_names(e, out),\n    EIf(c, t, e) => {\n      dlh_collect_performed_effect_names(c, out)\n      dlh_collect_performed_effect_names(t, out)\n      dlh_collect_performed_effect_names(e, out)\n    },\n    ELet(_, v, b, _) => {\n      dlh_collect_performed_effect_names(v, out)\n      dlh_collect_performed_effect_names(b, out)\n    },\n    ELetRec(_, v, b) => {\n      dlh_collect_performed_effect_names(v, out)\n      dlh_collect_performed_effect_names(b, out)\n    },\n    ELetMut(_, v, b, _) => {\n      dlh_collect_performed_effect_names(v, out)\n      dlh_collect_performed_effect_names(b, out)\n    },\n    EAssign(_, v, c) => {\n      dlh_collect_performed_effect_names(v, out)\n      dlh_collect_performed_effect_names(c, out)\n    },\n    EAssignOp(_, _, v, c) => {\n      dlh_collect_performed_effect_names(v, out)\n      dlh_collect_performed_effect_names(c, out)\n    },\n    ESeq(a, b) => {\n      dlh_collect_performed_effect_names(a, out)\n      dlh_collect_performed_effect_names(b, out)\n    },\n    EWhile(c, b) => {\n      dlh_collect_performed_effect_names(c, out)\n      dlh_collect_performed_effect_names(b, out)\n    },\n    EForIn(_, _, it, b) => {\n      dlh_collect_performed_effect_names(it, out)\n      dlh_collect_performed_effect_names(b, out)\n    },\n    EDot(o, _, _, _) => dlh_collect_performed_effect_names(o, out),\n    ELabeledArg(_, _, e) => dlh_collect_performed_effect_names(e, out),\n    EReturn(e) => dlh_collect_performed_effect_names(e, out),\n    EMatch(s, arms) => {\n      dlh_collect_performed_effect_names(s, out)\n      dlh_collect_performed_effect_names_arms(arms, out)\n    },\n    EHandle(s, _) => dlh_collect_performed_effect_names(s, out),\n    _ => ()\n  }\n}\n\nfn dlh_collect_performed_effect_names_arms(arms: Array[(Pat, Expr)], out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, b) = Array::get(arms, i)\n    dlh_collect_performed_effect_names(b, out)\n    i = i + 1\n  }\n}\n\nfn dlh_join_comma(names: Array[String]) -> String {\n  let mut out = \"\"\n  let mut i = 0\n  while i < Array::length(names) {\n    if i == 0 {\n      out = Array::get(names, i)\n    } else {\n      out = String::concat(String::concat(out, \", \"), Array::get(names, i))\n    }\n    i = i + 1\n  }\n  out\n}\n\n///|\nfn dlh_has_perform_arms(arms: Array[(Pat, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) {\n    let (_, b) = Array::get(arms, i)\n    if dlh_has_perform(b) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n///|\n// Append to `bad` any free identifier of `expr` that is not `dlh_name_ok` and\n// not in `bound`. Non-empty `bad` => the lambda references a bare lowercase\n// non-top-level name (capture or bare-helper call) and must not be hoisted.\nfn dlh_scan_free(expr: Expr, bound: Array[String], bad: Array[String]) -> Unit {\n  match expr {\n    EIdent(n, _) => if dlh_name_ok(n) || dlh_contains(bound, n) {\n      ()\n    } else {\n      Array::push(bad, n)\n    },\n    EBinOp(_, l, r) => {\n      dlh_scan_free(l, bound, bad)\n      dlh_scan_free(r, bound, bad)\n    },\n    EUnaryOp(_, e) => dlh_scan_free(e, bound, bad),\n    ECall(callee, args, _) => {\n      dlh_scan_free(callee, bound, bad)\n      let mut i = 0\n      while i < Array::length(args) {\n        dlh_scan_free(Array::get(args, i), bound, bad)\n        i = i + 1\n      }\n    },\n    ETuple(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_scan_free(Array::get(es, i), bound, bad)\n        i = i + 1\n      }\n    },\n    EArray(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_scan_free(Array::get(es, i), bound, bad)\n        i = i + 1\n      }\n    },\n    ESpread(e) => dlh_scan_free(e, bound, bad),\n    EContinue(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_scan_free(Array::get(es, i), bound, bad)\n        i = i + 1\n      }\n    },\n    ERecord(_, fs, _) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, v) = Array::get(fs, i)\n        dlh_scan_free(v, bound, bad)\n        i = i + 1\n      }\n    },\n    EMap(fs) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, v) = Array::get(fs, i)\n        dlh_scan_free(v, bound, bad)\n        i = i + 1\n      }\n    },\n    EIf(c, t, e) => {\n      dlh_scan_free(c, bound, bad)\n      dlh_scan_free(t, bound, bad)\n      dlh_scan_free(e, bound, bad)\n    },\n    ELet(name, v, b, _) => {\n      dlh_scan_free(v, bound, bad)\n      dlh_scan_free(b, dlh_with(bound, name), bad)\n    },\n    ELetRec(name, v, b) => {\n      let b2 = dlh_with(bound, name)\n      dlh_scan_free(v, b2, bad)\n      dlh_scan_free(b, b2, bad)\n    },\n    ELetMut(name, v, b, _) => {\n      dlh_scan_free(v, bound, bad)\n      dlh_scan_free(b, dlh_with(bound, name), bad)\n    },\n    EAssign(name, v, c) => {\n      if dlh_name_ok(name) || dlh_contains(bound, name) {\n        ()\n      } else {\n        Array::push(bad, name)\n      }\n      dlh_scan_free(v, bound, bad)\n      dlh_scan_free(c, bound, bad)\n    },\n    EAssignOp(name, _, v, c) => {\n      if dlh_name_ok(name) || dlh_contains(bound, name) {\n        ()\n      } else {\n        Array::push(bad, name)\n      }\n      dlh_scan_free(v, bound, bad)\n      dlh_scan_free(c, bound, bad)\n    },\n    ESeq(a, b) => {\n      dlh_scan_free(a, bound, bad)\n      dlh_scan_free(b, bound, bad)\n    },\n    EWhile(c, b) => {\n      dlh_scan_free(c, bound, bad)\n      dlh_scan_free(b, bound, bad)\n    },\n    EForIn(name, idxn, it, b) => {\n      dlh_scan_free(it, bound, bad)\n      let mut b2 = dlh_with(bound, name)\n      b2 = match idxn {\n        Some(inm) => dlh_with(b2, inm),\n        None => b2\n      }\n      dlh_scan_free(b, b2, bad)\n    },\n    EDot(o, _, _, _) => dlh_scan_free(o, bound, bad),\n    ELabeledArg(_, _, e) => dlh_scan_free(e, bound, bad),\n    EReturn(e) => dlh_scan_free(e, bound, bad),\n    EBreak(opt) => match opt {\n      Some(e) => dlh_scan_free(e, bound, bad),\n      None => ()\n    },\n    EFn(_, _, params, _, _, body) => {\n      let mut inner = bound\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, _) = Array::get(params, i)\n        inner = dlh_with(inner, dlh_strip_tilde(pn))\n        i = i + 1\n      }\n      dlh_scan_free(body, inner, bad)\n    },\n    EMatch(s, arms) => {\n      dlh_scan_free(s, bound, bad)\n      dlh_scan_arms(arms, bound, bad)\n    },\n    EHandle(s, arms) => {\n      dlh_scan_free(s, bound, bad)\n      dlh_scan_arms(arms, bound, bad)\n    },\n    ELoop(params, b) => {\n      let mut b2 = bound\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, init) = Array::get(params, i)\n        dlh_scan_free(init, bound, bad)\n        b2 = dlh_with(b2, pn)\n        i = i + 1\n      }\n      dlh_scan_free(b, b2, bad)\n    },\n    _ => ()\n  }\n}\n\n///|\nfn dlh_scan_arms(arms: Array[(Pat, Expr)], bound: Array[String], bad: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (p, b) = Array::get(arms, i)\n    let mut ab = bound\n    let pb = empty_str_array()\n    dlh_pat_binds(p, pb)\n    let mut j = 0\n    while j < Array::length(pb) {\n      ab = dlh_with(ab, Array::get(pb, j))\n      j = j + 1\n    }\n    dlh_scan_free(b, ab, bad)\n    i = i + 1\n  }\n}\n\n///|\n// Capture-safe substitution: EIdent(from) -> EIdent(to), stopping in subtrees\n// that rebind `from`.\nfn dlh_subst(expr: Expr, from: String, to: String) -> Expr {\n  match expr {\n    EIdent(n, off) => if n == from {\n      EIdent(to, off)\n    } else {\n      expr\n    },\n    EBinOp(op, l, r) => EBinOp(op, dlh_subst(l, from, to), dlh_subst(r, from, to)),\n    EUnaryOp(op, e) => EUnaryOp(op, dlh_subst(e, from, to)),\n    ECall(callee, args, off) => ECall(dlh_subst(callee, from, to), for a in args {\n      dlh_subst(a, from, to)\n    }, off),\n    ETuple(es) => ETuple(for e in es {\n      dlh_subst(e, from, to)\n    }),\n    EArray(es) => EArray(for e in es {\n      dlh_subst(e, from, to)\n    }),\n    ESpread(e) => ESpread(dlh_subst(e, from, to)),\n    EContinue(es) => EContinue(for e in es {\n      dlh_subst(e, from, to)\n    }),\n    ERecord(rn, fs, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dlh_subst(v, from, to)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dlh_subst(v, from, to)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(dlh_subst(c, from, to), dlh_subst(t, from, to), dlh_subst(e, from, to)),\n    ELet(name, v, b, soff) => ELet(name, dlh_subst(v, from, to), if name == from {\n      b\n    } else {\n      dlh_subst(b, from, to)\n    }, soff),\n    ELetRec(name, v, b) => if name == from {\n      ELetRec(name, v, b)\n    } else {\n      ELetRec(name, dlh_subst(v, from, to), dlh_subst(b, from, to))\n    },\n    ELetMut(name, v, b, soff) => ELetMut(name, dlh_subst(v, from, to), if name == from {\n      b\n    } else {\n      dlh_subst(b, from, to)\n    }, soff),\n    EAssign(name, v, c) => EAssign(name, dlh_subst(v, from, to), dlh_subst(c, from, to)),\n    EAssignOp(name, op, v, c) => EAssignOp(name, op, dlh_subst(v, from, to), dlh_subst(c, from, to)),\n    ESeq(a, b) => ESeq(dlh_subst(a, from, to), dlh_subst(b, from, to)),\n    EWhile(c, b) => EWhile(dlh_subst(c, from, to), dlh_subst(b, from, to)),\n    EForIn(name, idxn, it, b) => {\n      let shadow = name == from || (match idxn {\n        Some(inm) => inm == from,\n        None => false\n      })\n      EForIn(name, idxn, dlh_subst(it, from, to), if shadow {\n        b\n      } else {\n        dlh_subst(b, from, to)\n      })\n    },\n    EDot(o, f, off, fdoff) => EDot(dlh_subst(o, from, to), f, off, fdoff),\n    ELabeledArg(l, m, e) => ELabeledArg(l, m, dlh_subst(e, from, to)),\n    EReturn(e) => EReturn(dlh_subst(e, from, to)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(dlh_subst(e, from, to))),\n      None => expr\n    },\n    EFn(tp, bnds, params, rt, eff, body) => {\n      let mut shadow = false\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, _) = Array::get(params, i)\n        if dlh_strip_tilde(pn) == from {\n          shadow = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      if shadow {\n        expr\n      } else {\n        EFn(tp, bnds, params, rt, eff, dlh_subst(body, from, to))\n      }\n    },\n    EMatch(s, arms) => EMatch(dlh_subst(s, from, to), dlh_subst_arms(arms, from, to)),\n    EHandle(s, arms) => EHandle(dlh_subst(s, from, to), dlh_subst_arms(arms, from, to)),\n    ELoop(params, b) => {\n      let mut shadow = false\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, init) = Array::get(params, i)\n        if pn == from {\n          shadow = true\n        } else {\n          ()\n        }\n        Array::push(out, (pn, dlh_subst(init, from, to)))\n        i = i + 1\n      }\n      ELoop(out, if shadow {\n        b\n      } else {\n        dlh_subst(b, from, to)\n      })\n    },\n    _ => expr\n  }\n}\n\n///|\nfn dlh_subst_arms(arms: Array[(Pat, Expr)], from: String, to: String) -> Array[(Pat, Expr)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (p, b) = Array::get(arms, i)\n    let pb = empty_str_array()\n    dlh_pat_binds(p, pb)\n    let shadow = dlh_contains(pb, from)\n    Array::push(out, (p, if shadow {\n      b\n    } else {\n      dlh_subst(b, from, to)\n    }))\n    i = i + 1\n  }\n  out\n}\n\n///|\n// #1069 follow-up: closure-conversion for a CAPTURING local effectful\n// lambda (`dlh_scan_free` found a non-empty `bad`). The plain rename\n// dlh_hoist_expr already does for the non-capturing case (dlh_subst,\n// `name` -> `fresh`) isn't enough here: every remaining occurrence of\n// `name` also needs the captured values threaded in as extra arguments,\n// which only makes sense at a CALL site -- `name` used as a bare value\n// anywhere else (passed on, stored, returned) has no sound rewrite once\n// hoisted (the hoisted top-level function now expects the captures as\n// its own leading parameters, not something a bare reference could\n// supply). Detecting \"used only as a direct call target\" needs the SAME\n// shadow-awareness dlh_scan_free/dlh_subst already have -- rather than\n// duplicate that scope-tracking a third time, reuse dlh_subst itself:\n// substitute `name` for a freshly-minted, globally-unique marker name\n// first (dlh_subst is already proven correct about not touching a\n// SHADOWED occurrence), then scan the marker's occurrences with a\n// deliberately simple, non-shadow-aware walk -- safe, because a fresh\n// unique marker can never collide with an unrelated binding the way\n// `name` itself could.\nfn dlh_mocd_scan(expr: Expr, marker: String, bad: Array[Bool]) -> Unit {\n  match expr {\n    EIdent(n, _) => if n == marker {\n      Array::set(bad, 0, true)\n    } else {\n      ()\n    },\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(n, _) => if n == marker {\n          ()\n        } else {\n          dlh_mocd_scan(callee, marker, bad)\n        },\n        _ => dlh_mocd_scan(callee, marker, bad)\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        dlh_mocd_scan(Array::get(args, i), marker, bad)\n        i = i + 1\n      }\n    },\n    EBinOp(_, l, r) => {\n      dlh_mocd_scan(l, marker, bad)\n      dlh_mocd_scan(r, marker, bad)\n    },\n    EUnaryOp(_, e) => dlh_mocd_scan(e, marker, bad),\n    ETuple(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_mocd_scan(Array::get(es, i), marker, bad)\n        i = i + 1\n      }\n    },\n    EArray(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_mocd_scan(Array::get(es, i), marker, bad)\n        i = i + 1\n      }\n    },\n    ESpread(e) => dlh_mocd_scan(e, marker, bad),\n    EContinue(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_mocd_scan(Array::get(es, i), marker, bad)\n        i = i + 1\n      }\n    },\n    ERecord(_, fs, _) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, v) = Array::get(fs, i)\n        dlh_mocd_scan(v, marker, bad)\n        i = i + 1\n      }\n    },\n    EMap(fs) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, v) = Array::get(fs, i)\n        dlh_mocd_scan(v, marker, bad)\n        i = i + 1\n      }\n    },\n    EIf(c, t, e) => {\n      dlh_mocd_scan(c, marker, bad)\n      dlh_mocd_scan(t, marker, bad)\n      dlh_mocd_scan(e, marker, bad)\n    },\n    ELet(_, v, b, _) => {\n      dlh_mocd_scan(v, marker, bad)\n      dlh_mocd_scan(b, marker, bad)\n    },\n    ELetRec(_, v, b) => {\n      dlh_mocd_scan(v, marker, bad)\n      dlh_mocd_scan(b, marker, bad)\n    },\n    ELetMut(_, v, b, _) => {\n      dlh_mocd_scan(v, marker, bad)\n      dlh_mocd_scan(b, marker, bad)\n    },\n    EAssign(n, v, c) => {\n      if n == marker {\n        Array::set(bad, 0, true)\n      } else {\n        ()\n      }\n      dlh_mocd_scan(v, marker, bad)\n      dlh_mocd_scan(c, marker, bad)\n    },\n    EAssignOp(n, _, v, c) => {\n      if n == marker {\n        Array::set(bad, 0, true)\n      } else {\n        ()\n      }\n      dlh_mocd_scan(v, marker, bad)\n      dlh_mocd_scan(c, marker, bad)\n    },\n    ESeq(a, b) => {\n      dlh_mocd_scan(a, marker, bad)\n      dlh_mocd_scan(b, marker, bad)\n    },\n    EWhile(c, b) => {\n      dlh_mocd_scan(c, marker, bad)\n      dlh_mocd_scan(b, marker, bad)\n    },\n    EForIn(_, _, it, b) => {\n      dlh_mocd_scan(it, marker, bad)\n      dlh_mocd_scan(b, marker, bad)\n    },\n    EDot(o, _, _, _) => dlh_mocd_scan(o, marker, bad),\n    ELabeledArg(_, _, e) => dlh_mocd_scan(e, marker, bad),\n    EReturn(e) => dlh_mocd_scan(e, marker, bad),\n    EBreak(opt) => match opt {\n      Some(e) => dlh_mocd_scan(e, marker, bad),\n      None => ()\n    },\n    EFn(_, _, _, _, _, body) => dlh_mocd_scan(body, marker, bad),\n    EMatch(s, arms) => {\n      dlh_mocd_scan(s, marker, bad)\n      dlh_mocd_scan_arms(arms, marker, bad)\n    },\n    EHandle(s, arms) => {\n      dlh_mocd_scan(s, marker, bad)\n      dlh_mocd_scan_arms(arms, marker, bad)\n    },\n    ELoop(params, b) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        dlh_mocd_scan(init, marker, bad)\n        i = i + 1\n      }\n      dlh_mocd_scan(b, marker, bad)\n    },\n    _ => ()\n  }\n}\n\nfn dlh_mocd_scan_arms(arms: Array[(Pat, Expr)], marker: String, bad: Array[Bool]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, b) = Array::get(arms, i)\n    dlh_mocd_scan(b, marker, bad)\n    i = i + 1\n  }\n}\n\nfn dlh_marker_only_called_directly(expr: Expr, marker: String) -> Bool {\n  let bad = [\n    false\n  ]\n  dlh_mocd_scan(expr, marker, bad)\n  !Array::get(bad, 0)\n}\n\n// Rewrite every `ECall(EIdent(marker), args, off)` into `ECall(EIdent(fresh),\n// extra_names_as_idents ++ args, off)` -- the captured-value arguments the\n// newly-hoisted top-level function now expects as its leading parameters,\n// each just a bare reference to the SAME name it had in the original\n// (unshadowed, per dlh_marker_only_called_directly's guarantee) enclosing\n// scope, still valid at the call site since hoisting doesn't move the call\n// site itself, only the closure's OWN body. Full traversal (marker is\n// fresh/unique, no shadowing concern, so no bound-tracking needed here).\nfn dlh_prepend_and_rename_calls(expr: Expr, marker: String, fresh: String, extra_names: Array[String]) -> Expr {\n  match expr {\n    ECall(callee, args, off) => match callee {\n      EIdent(n, coff) => if n == marker {\n        let extra_args = for en in extra_names {\n          EIdent(en, coff)\n        }\n        ECall(EIdent(fresh, coff), Array::concat(extra_args, for a in args {\n          dlh_prepend_and_rename_calls(a, marker, fresh, extra_names)\n        }), off)\n      } else {\n        ECall(dlh_prepend_and_rename_calls(callee, marker, fresh, extra_names), for a in args {\n          dlh_prepend_and_rename_calls(a, marker, fresh, extra_names)\n        }, off)\n      },\n      _ => ECall(dlh_prepend_and_rename_calls(callee, marker, fresh, extra_names), for a in args {\n        dlh_prepend_and_rename_calls(a, marker, fresh, extra_names)\n      }, off)\n    },\n    EBinOp(op, l, r) => EBinOp(op, dlh_prepend_and_rename_calls(l, marker, fresh, extra_names), dlh_prepend_and_rename_calls(r, marker, fresh, extra_names)),\n    EUnaryOp(op, e) => EUnaryOp(op, dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),\n    ETuple(es) => ETuple(for e in es {\n      dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)\n    }),\n    EArray(es) => EArray(for e in es {\n      dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)\n    }),\n    ESpread(e) => ESpread(dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),\n    EContinue(es) => EContinue(for e in es {\n      dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)\n    }),\n    ERecord(rn, fs, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(dlh_prepend_and_rename_calls(c, marker, fresh, extra_names), dlh_prepend_and_rename_calls(t, marker, fresh, extra_names), dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),\n    ELet(n, v, b, soff) => ELet(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names), soff),\n    ELetRec(n, v, b) => ELetRec(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),\n    ELetMut(n, v, b, soff) => ELetMut(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names), soff),\n    EAssign(n, v, c) => EAssign(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(c, marker, fresh, extra_names)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(c, marker, fresh, extra_names)),\n    ESeq(a, b) => ESeq(dlh_prepend_and_rename_calls(a, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),\n    EWhile(c, b) => EWhile(dlh_prepend_and_rename_calls(c, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),\n    EForIn(n, idxn, it, b) => EForIn(n, idxn, dlh_prepend_and_rename_calls(it, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),\n    EDot(o, f, off, fdoff) => EDot(dlh_prepend_and_rename_calls(o, marker, fresh, extra_names), f, off, fdoff),\n    ELabeledArg(l, m, e) => ELabeledArg(l, m, dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),\n    EReturn(e) => EReturn(dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e) => Some(dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),\n      None => None\n    }),\n    EFn(tp, bnds, params, rt, eff, body) => EFn(tp, bnds, params, rt, eff, dlh_prepend_and_rename_calls(body, marker, fresh, extra_names)),\n    EMatch(s, arms) => EMatch(dlh_prepend_and_rename_calls(s, marker, fresh, extra_names), for a in arms {\n      let (p, b) = a\n      (p, dlh_prepend_and_rename_calls(b, marker, fresh, extra_names))\n    }),\n    EHandle(s, arms) => EHandle(dlh_prepend_and_rename_calls(s, marker, fresh, extra_names), for a in arms {\n      let (p, b) = a\n      (p, dlh_prepend_and_rename_calls(b, marker, fresh, extra_names))\n    }),\n    ELoop(params, b) => ELoop(for p in params {\n      let (pn, init) = p\n      (pn, dlh_prepend_and_rename_calls(init, marker, fresh, extra_names))\n    }, dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),\n    _ => expr\n  }\n}\n\nfn dlh_dedup_names(names: Array[String]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(names) {\n    let n = Array::get(names, i)\n    if dlh_contains(out, n) {\n      ()\n    } else {\n      Array::push(out, n)\n    }\n    i = i + 1\n  }\n  out\n}\n\n// Closure conversion passes each captured name's CURRENT VALUE at the call\n// site as a plain argument -- correct only if that value can never diverge\n// from what a genuine reference-capturing closure would have seen, i.e.\n// the captured name is never reassigned anywhere the conversion could\n// observe (`let mut base = ...` captured and later mutated, or mutated\n// again inside the closure's OWN body such that the mutation should be\n// visible to code after the call, would silently do the WRONG thing under\n// pass-by-value). Deliberately conservative: flags `names` as unsafe if\n// EITHER `fbody` (the closure's own body) or `rest` (everything after the\n// closure definition, where call sites live) reassigns any of them via\n// `EAssign`/`EAssignOp`, regardless of whether the original declaration\n// was `let` or `let mut` -- simpler than tracking declaration-site\n// mutability precisely, and every bit as safe: nothing to observe\n// diverging means pass-by-value and capture-by-reference are behaviorally\n// identical for this specific program, whatever the declaration said.\nfn dlh_names_ever_assigned(expr: Expr, names: Array[String]) -> Bool {\n  let bad = [\n    false\n  ]\n  dlh_naa_scan(expr, names, bad)\n  Array::get(bad, 0)\n}\n\nfn dlh_naa_scan(expr: Expr, names: Array[String], bad: Array[Bool]) -> Unit {\n  match expr {\n    EAssign(n, v, c) => {\n      if dlh_contains(names, n) {\n        Array::set(bad, 0, true)\n      } else {\n        ()\n      }\n      dlh_naa_scan(v, names, bad)\n      dlh_naa_scan(c, names, bad)\n    },\n    EAssignOp(n, _, v, c) => {\n      if dlh_contains(names, n) {\n        Array::set(bad, 0, true)\n      } else {\n        ()\n      }\n      dlh_naa_scan(v, names, bad)\n      dlh_naa_scan(c, names, bad)\n    },\n    ECall(callee, args, _) => {\n      dlh_naa_scan(callee, names, bad)\n      let mut i = 0\n      while i < Array::length(args) {\n        dlh_naa_scan(Array::get(args, i), names, bad)\n        i = i + 1\n      }\n    },\n    EBinOp(_, l, r) => {\n      dlh_naa_scan(l, names, bad)\n      dlh_naa_scan(r, names, bad)\n    },\n    EUnaryOp(_, e) => dlh_naa_scan(e, names, bad),\n    ETuple(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_naa_scan(Array::get(es, i), names, bad)\n        i = i + 1\n      }\n    },\n    EArray(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_naa_scan(Array::get(es, i), names, bad)\n        i = i + 1\n      }\n    },\n    ESpread(e) => dlh_naa_scan(e, names, bad),\n    EContinue(es) => {\n      let mut i = 0\n      while i < Array::length(es) {\n        dlh_naa_scan(Array::get(es, i), names, bad)\n        i = i + 1\n      }\n    },\n    ERecord(_, fs, _) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, v) = Array::get(fs, i)\n        dlh_naa_scan(v, names, bad)\n        i = i + 1\n      }\n    },\n    EMap(fs) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, v) = Array::get(fs, i)\n        dlh_naa_scan(v, names, bad)\n        i = i + 1\n      }\n    },\n    EIf(c, t, e) => {\n      dlh_naa_scan(c, names, bad)\n      dlh_naa_scan(t, names, bad)\n      dlh_naa_scan(e, names, bad)\n    },\n    ELet(_, v, b, _) => {\n      dlh_naa_scan(v, names, bad)\n      dlh_naa_scan(b, names, bad)\n    },\n    ELetRec(_, v, b) => {\n      dlh_naa_scan(v, names, bad)\n      dlh_naa_scan(b, names, bad)\n    },\n    ELetMut(_, v, b, _) => {\n      dlh_naa_scan(v, names, bad)\n      dlh_naa_scan(b, names, bad)\n    },\n    ESeq(a, b) => {\n      dlh_naa_scan(a, names, bad)\n      dlh_naa_scan(b, names, bad)\n    },\n    EWhile(c, b) => {\n      dlh_naa_scan(c, names, bad)\n      dlh_naa_scan(b, names, bad)\n    },\n    EForIn(_, _, it, b) => {\n      dlh_naa_scan(it, names, bad)\n      dlh_naa_scan(b, names, bad)\n    },\n    EDot(o, _, _, _) => dlh_naa_scan(o, names, bad),\n    ELabeledArg(_, _, e) => dlh_naa_scan(e, names, bad),\n    EReturn(e) => dlh_naa_scan(e, names, bad),\n    EBreak(opt) => match opt {\n      Some(e) => dlh_naa_scan(e, names, bad),\n      None => ()\n    },\n    EFn(_, _, _, _, _, body) => dlh_naa_scan(body, names, bad),\n    EMatch(s, arms) => {\n      dlh_naa_scan(s, names, bad)\n      dlh_naa_scan_arms(arms, names, bad)\n    },\n    EHandle(s, arms) => {\n      dlh_naa_scan(s, names, bad)\n      dlh_naa_scan_arms(arms, names, bad)\n    },\n    ELoop(params, b) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        dlh_naa_scan(init, names, bad)\n        i = i + 1\n      }\n      dlh_naa_scan(b, names, bad)\n    },\n    _ => ()\n  }\n}\n\nfn dlh_naa_scan_arms(arms: Array[(Pat, Expr)], names: Array[String], bad: Array[Bool]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, b) = Array::get(arms, i)\n    dlh_naa_scan(b, names, bad)\n    i = i + 1\n  }\n}\n\n///|\n// Only ever matches an EFFECTFUL literal (dlh_has_perform on its body) --\n// found via a live regression (2026-07-23, fixtures/eq_array_option_fields.vibe\n// trapping \"unreachable\" in a derive(Eq)-generated equality helper, bisected\n// to this fix's own introducing commit): the original unguarded version\n// matched ANY literal EFn argument, including the PURE comparator closures\n// derive(Eq)/derive(Ord) generate for Array/Option/tuple field comparisons.\n// Wrapping a pure closure in a synthetic let-binding was assumed harmless\n// (closure construction has no side effects), but something downstream\n// (likely type inference/monomorphization for the generic higher-order\n// comparator call) broke when the literal stopped appearing directly at\n// the call site. Scoping this to effectful literals only -- exactly\n// mirroring dlh_hoist_expr's own ELet branch, which has always required\n// dlh_has_perform before touching a closure at all -- keeps every pure\n// closure completely untouched by this pass, restoring the pre-existing\n// (working) behavior for that case while keeping the IIFE/HOF-arg fix\n// for genuinely effectful literals.\nfn dlh_args_have_literal_efn(args: Array[Expr]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(args) && !found {\n    match Array::get(args, i) {\n      EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) { found = true } else { () },\n      // A labeled argument (`with_log(f = () -> ... { perform ... })`,\n      // cheatsheet \"Labeled arguments\") wraps the literal in ELabeledArg --\n      // found via testing this exact syntax against the IIFE/HOF-arg fix\n      // above (2026-07-23): it still crashed, since this check only\n      // matched a BARE EFn, not one hiding one layer deeper inside a label\n      // wrapper. Recurse one layer to catch it too.\n      ELabeledArg(_, _, inner) => match inner {\n        EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) { found = true } else { () },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n///|\n// Rewrites `callee(args...)` so every DIRECT `EFn` literal in `args` --\n// bare, or one layer inside an `ELabeledArg` wrapper (`f = () -> ...`) --\n// is let-bound immediately before the call, left-to-right (same evaluation\n// order as the literal appearing inline): `callee(a, <lit>, b)` becomes\n// `let __dlh_arglit_N = <lit>; callee(a, __dlh_arglit_N, b)`; a labeled\n// literal `callee(f = <lit>)` becomes\n// `let __dlh_arglit_N = <lit>; callee(f = __dlh_arglit_N)` (the label\n// wrapper is preserved, only its inner value is replaced). Non-literal\n// args are left untouched. See dlh_args_have_literal_efn's call site\n// (dlh_hoist_expr's ECall case) for why this exists.\nfn dlh_letbind_literal_args(callee: Expr, args: Array[Expr], off: Int, ctr: Array[Int]) -> Expr {\n  let new_args = array_empty()\n  let lits = array_empty()\n  let mut i = 0\n  while i < Array::length(args) {\n    let a = Array::get(args, i)\n    match a {\n      EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) {\n        let idx = Array::get(ctr, 0)\n        Array::set(ctr, 0, idx + 1)\n        let nm = \"__dlh_arglit_\\{idx}\"\n        Array::push(lits, (nm, a))\n        Array::push(new_args, EIdent(nm, off))\n      } else {\n        Array::push(new_args, a)\n      },\n      ELabeledArg(lbl, mname, inner) => match inner {\n        EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) {\n          let idx = Array::get(ctr, 0)\n          Array::set(ctr, 0, idx + 1)\n          let nm = \"__dlh_arglit_\\{idx}\"\n          Array::push(lits, (nm, inner))\n          Array::push(new_args, ELabeledArg(lbl, mname, EIdent(nm, off)))\n        } else {\n          Array::push(new_args, a)\n        },\n        _ => Array::push(new_args, a)\n      },\n      other => Array::push(new_args, other)\n    }\n    i = i + 1\n  }\n  let mut wrapped = ECall(callee, new_args, off)\n  let mut k = Array::length(lits) - 1\n  while k >= 0 {\n    let (nm, lit) = Array::get(lits, k)\n    wrapped = ELet(nm, lit, wrapped, off)\n    k = k - 1\n  }\n  wrapped\n}\n\n///|\nfn dlh_hoist_expr(expr: Expr, hoisted: Array[Stmt], ctr: Array[Int]) -> Expr {\n  match expr {\n    ELet(name, v, b, soff) => match v {\n      EFn(tp, bnds, params, rt, eff, fbody) => {\n        // Backfill a missing (unannotated) effect row from what the body\n        // actually performs BEFORE hoisting: a hoisted top-level function's\n        // row is what evidence_dict_pass's needing-classification reads\n        // (codegen/common_base/inline_direct_perform.vibe's\n        // edp_collect_fn_defs), so silently keeping `eff = None` here made\n        // an effect-performing hoisted closure invisible to that pass --\n        // see dlh_collect_performed_effect_names' doc comment for the full\n        // history (found via gc-backend coverage testing, 2026-07-23).\n        // Only fires when `eff` is genuinely absent; an explicit user-\n        // written row (however it's spelled) is left untouched.\n        let eff_is_blank = match eff {\n          None => true,\n          Some(es) => String::trim(es) == \"\"\n        }\n        let eff_fixed = if eff_is_blank {\n          let performed = empty_str_array()\n          dlh_collect_performed_effect_names(fbody, performed)\n          if Array::length(performed) == 0 {\n            eff\n          } else {\n            Some(dlh_join_comma(performed))\n          }\n        } else {\n          eff\n        }\n        let hoisted_fn = dlh_hoist_expr(EFn(tp, bnds, params, rt, eff_fixed, fbody), hoisted, ctr)\n        let rest = dlh_hoist_expr(b, hoisted, ctr)\n        let bad = empty_str_array()\n        let mut pb = empty_str_array()\n        let mut i = 0\n        while i < Array::length(params) {\n          let (pn, _) = Array::get(params, i)\n          pb = dlh_with(pb, dlh_strip_tilde(pn))\n          i = i + 1\n        }\n        match hoisted_fn {\n          EFn(_, _, _, _, _, hb) => dlh_scan_free(hb, pb, bad),\n          _ => ()\n        }\n        let hoistable = dlh_has_perform(fbody) && Array::length(bad) == 0\n        if hoistable {\n          let idx = Array::get(ctr, 0)\n          Array::set(ctr, 0, idx + 1)\n          let fresh = \"__hoisted_lam_\\{idx}_\\{name}\"\n          Array::push(hoisted, SLet(false, false, fresh, None, hoisted_fn))\n          dlh_subst(rest, name, fresh)\n        } else if dlh_has_perform(fbody) && Array::length(bad) > 0 {\n          // #1069: `bad` is non-empty (the lambda captures at least one\n          // ordinary enclosing local) but it still performs -- the exact\n          // shape #786's own landed fix declined to touch, still hitting\n          // the original unregistered-closure-type/broken-combinator bug\n          // unless something else routes it around that path. Attempt\n          // closure conversion (see dlh_prepend_and_rename_calls' doc\n          // comment) rather than leaving it on the broken path\n          // unconditionally: only when every call site can be proven safe\n          // to rewrite (dlh_marker_only_called_directly, via dlh_subst's\n          // already-proven shadow-correctness). Falls through to the\n          // ORIGINAL (unchanged, currently-broken-for-this-shape) local-let\n          // behavior when it can't -- never worse than before this change,\n          // only sometimes better.\n          let idx = Array::get(ctr, 0)\n          Array::set(ctr, 0, idx + 1)\n          let marker = \"__dlh_cc_marker_\\{idx}\"\n          let rest_marked = dlh_subst(rest, name, marker)\n          let captured = dlh_dedup_names(bad)\n          if dlh_marker_only_called_directly(rest_marked, marker) && !dlh_names_ever_assigned(fbody, captured) && !dlh_names_ever_assigned(rest, captured) {\n            let extra_params = for cn in captured {\n              (cn, None)\n            }\n            let new_params = Array::concat(extra_params, params)\n            let hoisted_fn2 = match hoisted_fn {\n              EFn(tp2, bnds2, _, rt2, eff2, hb2) => EFn(tp2, bnds2, new_params, rt2, eff2, hb2),\n              _ => hoisted_fn\n            }\n            let fresh = \"__hoisted_lam_\\{idx}_\\{name}\"\n            Array::push(hoisted, SLet(false, false, fresh, None, hoisted_fn2))\n            dlh_prepend_and_rename_calls(rest_marked, marker, fresh, captured)\n          } else {\n            ELet(name, hoisted_fn, rest, soff)\n          }\n        } else {\n          ELet(name, hoisted_fn, rest, soff)\n        }\n      },\n      _ => ELet(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr), soff)\n    },\n    EBinOp(op, l, r) => EBinOp(op, dlh_hoist_expr(l, hoisted, ctr), dlh_hoist_expr(r, hoisted, ctr)),\n    EUnaryOp(op, e) => EUnaryOp(op, dlh_hoist_expr(e, hoisted, ctr)),\n    // A bare IIFE -- `(() -> ... { perform ... })()` -- calls an `EFn`\n    // literal directly with NO enclosing `ELet` at all. Every hoist/\n    // closure-conversion rule above (capture-free hoist, #1069's\n    // capturing-closure conversion) pattern-matches specifically on\n    // `ELet(name, EFn(...), body)`, so this shape evaded all of them and\n    // fell straight through to the pre-#786 broken local-closure+effect\n    // combinator path -- an effectful IIFE with ZERO captures produced\n    // invalid wasm (\"invalid signature index\") at compile time, found via\n    // testing effect_row_open.vibe-adjacent higher-order-function shapes\n    // (2026-07-23). Fix: desugar the IIFE into the ALREADY-handled\n    // `ELet(fresh, EFn(...), fresh())` shape and re-enter this same\n    // function -- reuses 100% of the existing, separately-verified\n    // ELet/EFn logic above with no new closure-conversion code.\n    ECall(callee, args, off) => match callee {\n      EFn(_, _, _, _, _, cfbody) => if dlh_has_perform(cfbody) {\n        let idx = Array::get(ctr, 0)\n        Array::set(ctr, 0, idx + 1)\n        let iife_name = \"__dlh_iife_\\{idx}\"\n        dlh_hoist_expr(ELet(iife_name, callee, ECall(EIdent(iife_name, off), args, off), off), hoisted, ctr)\n      } else {\n        ECall(dlh_hoist_expr(callee, hoisted, ctr), for a in args {\n          dlh_hoist_expr(a, hoisted, ctr)\n        }, off)\n      },\n      _ => if dlh_args_have_literal_efn(args) {\n        // An inline `EFn` literal passed as a CALL ARGUMENT (not the\n        // callee) to an ordinary (non-trivial-wrapper) named function --\n        // `with_log(() -> Int with { Log } { perform ...; 42 })` where\n        // `with_log`'s own body genuinely calls its parameter internally\n        // (`handle { f() } with Log { .. }`), not merely a same-arity\n        // forward `dtpw_inline_trivial_wrappers` (#1070) would already\n        // reduce to an IIFE. Verified via direct A/B testing (2026-07-23)\n        // that a NAMED closure (top-level, or already hoisted) passed the\n        // exact same way to the exact same `with_log` already works fine\n        // -- confirming the crash is specific to the literal itself\n        // having no name for any hoist/closure-conversion rule to latch\n        // onto, not to anything about `with_log`. Fix: synthesize a let-\n        // binding for each literal-EFn argument immediately before this\n        // call (semantics-preserving -- same left-to-right evaluation\n        // order as the literal appearing inline) so the existing ELet/EFn\n        // hoist logic above turns it into an ordinary named function\n        // reference, exactly like the already-working named-closure case.\n        dlh_hoist_expr(dlh_letbind_literal_args(callee, args, off, ctr), hoisted, ctr)\n      } else {\n        ECall(dlh_hoist_expr(callee, hoisted, ctr), for a in args {\n          dlh_hoist_expr(a, hoisted, ctr)\n        }, off)\n      }\n    },\n    ETuple(es) => ETuple(for e in es {\n      dlh_hoist_expr(e, hoisted, ctr)\n    }),\n    EArray(es) => EArray(for e in es {\n      dlh_hoist_expr(e, hoisted, ctr)\n    }),\n    ESpread(e) => ESpread(dlh_hoist_expr(e, hoisted, ctr)),\n    EContinue(es) => EContinue(for e in es {\n      dlh_hoist_expr(e, hoisted, ctr)\n    }),\n    ERecord(rn, fs, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dlh_hoist_expr(v, hoisted, ctr)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dlh_hoist_expr(v, hoisted, ctr)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(dlh_hoist_expr(c, hoisted, ctr), dlh_hoist_expr(t, hoisted, ctr), dlh_hoist_expr(e, hoisted, ctr)),\n    ELetRec(name, v, b) => ELetRec(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),\n    ELetMut(name, v, b, soff) => ELetMut(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr), soff),\n    EAssign(name, v, c) => EAssign(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(c, hoisted, ctr)),\n    EAssignOp(name, op, v, c) => EAssignOp(name, op, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(c, hoisted, ctr)),\n    ESeq(a, b) => ESeq(dlh_hoist_expr(a, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),\n    EWhile(c, b) => EWhile(dlh_hoist_expr(c, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),\n    EForIn(name, idxn, it, b) => EForIn(name, idxn, dlh_hoist_expr(it, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),\n    EDot(o, f, off, fdoff) => EDot(dlh_hoist_expr(o, hoisted, ctr), f, off, fdoff),\n    ELabeledArg(l, m, e) => ELabeledArg(l, m, dlh_hoist_expr(e, hoisted, ctr)),\n    EReturn(e) => EReturn(dlh_hoist_expr(e, hoisted, ctr)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(dlh_hoist_expr(e, hoisted, ctr))),\n      None => expr\n    },\n    EFn(tp, bnds, params, rt, eff, body) => EFn(tp, bnds, params, rt, eff, dlh_hoist_expr(body, hoisted, ctr)),\n    EMatch(s, arms) => EMatch(dlh_hoist_expr(s, hoisted, ctr), dlh_hoist_arms(arms, hoisted, ctr)),\n    EHandle(s, arms) => EHandle(dlh_hoist_expr(s, hoisted, ctr), dlh_hoist_arms(arms, hoisted, ctr)),\n    ELoop(params, b) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pn, init) = Array::get(params, i)\n        Array::push(out, (pn, dlh_hoist_expr(init, hoisted, ctr)))\n        i = i + 1\n      }\n      ELoop(out, dlh_hoist_expr(b, hoisted, ctr))\n    },\n    _ => expr\n  }\n}\n\n///|\nfn dlh_hoist_arms(arms: Array[(Pat, Expr)], hoisted: Array[Stmt], ctr: Array[Int]) -> Array[(Pat, Expr)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (p, b) = Array::get(arms, i)\n    Array::push(out, (p, dlh_hoist_expr(b, hoisted, ctr)))\n    i = i + 1\n  }\n  out\n}\n\n///|\nfn dlh_hoist_stmt(stmt: Stmt, hoisted: Array[Stmt], ctr: Array[Int]) -> Stmt {\n  match stmt {\n    SLet(ex, rc, name, ty, body) => SLet(ex, rc, name, ty, dlh_hoist_expr(body, hoisted, ctr)),\n    SLetMut(name, ty, body) => SLetMut(name, ty, dlh_hoist_expr(body, hoisted, ctr)),\n    STest(name, body) => STest(name, dlh_hoist_expr(body, hoisted, ctr)),\n    SBench(name, body) => SBench(name, dlh_hoist_expr(body, hoisted, ctr)),\n    SExpr(e) => SExpr(dlh_hoist_expr(e, hoisted, ctr)),\n    SLetPat(pat, e) => SLetPat(pat, dlh_hoist_expr(e, hoisted, ctr)),\n    _ => stmt\n  }\n}\n\n///|\n// In-place hoisting of non-capturing effectful local lambdas across the program.\nexport fn desugar_hoist_local_lambdas(stmts: Array[Stmt]) -> Unit {\n  let hoisted = array_empty()\n  let ctr = [\n    0\n  ]\n  let n = Array::length(stmts)\n  let mut i = 0\n  while i < n {\n    Array::set(stmts, i, dlh_hoist_stmt(Array::get(stmts, i), hoisted, ctr))\n    i = i + 1\n  }\n  let mut h = 0\n  while h < Array::length(hoisted) {\n    Array::push(stmts, Array::get(hoisted, h))\n    h = h + 1\n  }\n}\n\n///|\n// Labeled-argument reordering. Named args are order-independent — `f(y=2, x=1)`\n// binds x=1, y=2 (cheatsheet \"Labeled arguments\"). Codegen strips ELabeledArg\n// labels and binds positionally, so a call given out of declared order used to\n// bind by position (silently wrong; `add`-style commutative calls masked it).\n// This pass reorders a FULLY-labeled call's args into the callee's declared\n// parameter order. It fires when the callee is a top-level let-bound function\n// (#986: ANY such function — a plain `fn add(x: Int, y: Int)` too, not just\n// `~`-labeled declarations; `fn` decls lower to `SLet` + `EFn` before this\n// pass, and a fully-labeled call names the parameters either way) and every\n// arg is an ELabeledArg naming one of its params; any other shape (positional,\n// partial, unknown callee) is left untouched, so positional binding is\n// unchanged.\nfn strip_label_tilde(n: String) -> String {\n  let ln = String::length(n)\n  if ln > 0 {\n    let last = n[ln - 1: ln]\n    if last == \"~\" || last == \"?\" {\n      n[0: ln - 1]\n    } else {\n      n\n    }\n  } else {\n    n\n  }\n}\n\n///|\n// fname -> ordered param base names, for every top-level `let f = (..) -> ..`\n// (#986: labeled or not — see the pass comment above).\nfn collect_fn_param_labels(stmts: Array[Stmt]) -> Array[(String, Array[String])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, _, body) => match body {\n        EFn(_, _, params, _, _, _) => {\n          let labels = empty_str_array()\n          let mut pi = 0\n          while pi < Array::length(params) {\n            let (pn, _) = Array::get(params, pi)\n            Array::push(labels, strip_label_tilde(pn))\n            pi = pi + 1\n          }\n          Array::push(out, (fname, labels))\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n///|\nfn lookup_param_labels(tbl: Array[(String, Array[String])], fname: String) -> Option[Array[String]] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(tbl) {\n    let (n, labels) = Array::get(tbl, i)\n    if n == fname {\n      found = Some(labels)\n      i = Array::length(tbl)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n///|\n// Reorder a fully-labeled arg list into `param_labels` order. None when the call\n// is not a candidate (arity mismatch, some arg not labeled, or a label matches no\n// parameter) — the caller then leaves the args untouched.\nfn reorder_labeled_args(args: Array[Expr], param_labels: Array[String]) -> Option[Array[Expr]] {\n  if Array::length(args) != Array::length(param_labels) {\n    None\n  } else {\n    let mut all_labeled = true\n    let mut i = 0\n    while i < Array::length(args) {\n      let is_lbl = match Array::get(args, i) {\n        ELabeledArg(_, _, _) => true,\n        _ => false\n      }\n      if is_lbl {\n        ()\n      } else {\n        all_labeled = false\n      }\n      i = i + 1\n    }\n    if !all_labeled {\n      None\n    } else {\n      let out = empty_expr_array()\n      let mut ok = true\n      let mut pj = 0\n      while pj < Array::length(param_labels) {\n        let want = Array::get(param_labels, pj)\n        let mut fk = -1\n        let mut k = 0\n        while k < Array::length(args) {\n          match Array::get(args, k) {\n            ELabeledArg(lbl, _, _) => if lbl == want && fk < 0 {\n              fk = k\n            } else {\n              ()\n            },\n            _ => ()\n          }\n          k = k + 1\n        }\n        if fk < 0 {\n          ok = false\n          pj = Array::length(param_labels)\n        } else {\n          Array::push(out, Array::get(args, fk))\n          pj = pj + 1\n        }\n      }\n      if ok {\n        Some(out)\n      } else {\n        None\n      }\n    }\n  }\n}\n\n///|\n// #986 (Codex P2-2 on #993): is `name` lexically shadowed at this point? The\n// table indexes TOP-LEVEL functions only, so a local binding of the same name\n// (`let f = (y) -> ..` / a fn param / a pattern bind) must suppress both the\n// reorder and the label-name validation — the call resolves to the local\n// value, whose parameter names the table knows nothing about.\nfn relabel_shadowed(shadows: Array[String], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(shadows) {\n    if Array::get(shadows, i) == name {\n      found = true\n      i = Array::length(shadows)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n///|\nfn relabel_pat_binds(pat: Pat, shadows: Array[String]) -> Unit {\n  match pat {\n    PBind(n) => Array::push(shadows, n),\n    PCtor(_, ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        relabel_pat_binds(Array::get(ps, i), shadows)\n        i = i + 1\n      }\n    },\n    PTuple(ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        relabel_pat_binds(Array::get(ps, i), shadows)\n        i = i + 1\n      }\n    },\n    POr(a, b) => {\n      relabel_pat_binds(a, shadows)\n      relabel_pat_binds(b, shadows)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        relabel_pat_binds(fp, shadows)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\n///|\n// Strip the ELabeledArg wrappers off a VALIDATED arg list (labels confirmed to\n// match their positions — either via a successful full reorder, or\n// individually below). Codegen binds positionally and ignores labels, so this\n// is semantically neutral there; for the checker it is the RESOLUTION MARKER:\n// a stripped arg participates in strict positional unification, while a\n// surviving ELabeledArg means \"label correspondence unknown here\" and types\n// tolerantly (see check_expr's ELabeledArg arm) — the erroneous local shapes\n// are reported by name (check_labeled_arg_names_stmts), and import-resolved\n// callees (whose param names this module cannot see, Codex P2-1 on #993) are\n// no longer falsely rejected by position.\nfn strip_labeled_wrappers(args: Array[Expr]) -> Array[Expr] {\n  let out = empty_expr_array()\n  let mut i = 0\n  while i < Array::length(args) {\n    match Array::get(args, i) {\n      ELabeledArg(_, _, v) => Array::push(out, v),\n      other => Array::push(out, other)\n    }\n    i = i + 1\n  }\n  out\n}\n\n///|\n// For a call that could NOT be fully reordered (partial labeling, or some\n// label mismatched): strip only the labeled args whose label already matches\n// the parameter at their own position — those are positionally correct\n// decorative labels and must stay strictly type-checked. Mismatched ones are\n// kept for the name-validation walk to report.\nfn strip_in_position_labels(args: Array[Expr], labels: Array[String]) -> Array[Expr] {\n  let out = empty_expr_array()\n  let mut i = 0\n  while i < Array::length(args) {\n    let arg = Array::get(args, i)\n    match arg {\n      ELabeledArg(lbl, m, v) => if i < Array::length(labels) && Array::get(labels, i) == lbl {\n        Array::push(out, v)\n      } else {\n        Array::push(out, ELabeledArg(lbl, m, v))\n      },\n      other => Array::push(out, other)\n    }\n    i = i + 1\n  }\n  out\n}\n\n///|\nfn relabel_expr(expr: Expr, tbl: Array[(String, Array[String])], shadows: Array[String]) -> Expr {\n  match expr {\n    ECall(callee, args, off) => {\n      let rargs = for a in args {\n        relabel_expr(a, tbl, shadows)\n      }\n      let rcallee = relabel_expr(callee, tbl, shadows)\n      // #986: `tbl` now holds EVERY top-level function (not just `~`-labeled\n      // ones), so gate the linear table scan on the call actually carrying a\n      // labeled argument — labeled calls are rare, plain calls are the entire\n      // program.\n      let mut any_labeled_arg = false\n      let mut la_i = 0\n      while la_i < Array::length(rargs) {\n        match Array::get(rargs, la_i) {\n          ELabeledArg(_, _, _) => {\n            any_labeled_arg = true\n          },\n          _ => ()\n        }\n        la_i = la_i + 1\n      }\n      let final_args = if any_labeled_arg {\n        match callee {\n          EIdent(fname, _) => if relabel_shadowed(shadows, fname) {\n            rargs\n          } else {\n            match lookup_param_labels(tbl, fname) {\n              Some(labels) => match reorder_labeled_args(rargs, labels) {\n                Some(reordered) => strip_labeled_wrappers(reordered),\n                None => strip_in_position_labels(rargs, labels)\n              },\n              None => rargs\n            }\n          },\n          _ => rargs\n        }\n      } else {\n        rargs\n      }\n      ECall(rcallee, final_args, off)\n    },\n    EBinOp(op, l, r) => EBinOp(op, relabel_expr(l, tbl, shadows), relabel_expr(r, tbl, shadows)),\n    EUnaryOp(op, e) => EUnaryOp(op, relabel_expr(e, tbl, shadows)),\n    ETuple(elems) => ETuple(for e in elems {\n      relabel_expr(e, tbl, shadows)\n    }),\n    EArray(elems) => EArray(for e in elems {\n      relabel_expr(e, tbl, shadows)\n    }),\n    ESpread(e) => ESpread(relabel_expr(e, tbl, shadows)),\n    ERecord(rn, fields, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, fval) = Array::get(fields, i)\n        Array::push(out, (fname, relabel_expr(fval, tbl, shadows)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fields) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (k, v) = Array::get(fields, i)\n        Array::push(out, (k, relabel_expr(v, tbl, shadows)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(relabel_expr(c, tbl, shadows), relabel_expr(t, tbl, shadows), relabel_expr(e, tbl, shadows)),\n    ELet(name, v, b, soff) => {\n      let rv = relabel_expr(v, tbl, shadows)\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      let rb = relabel_expr(b, tbl, shadows)\n      Array::truncate(shadows, mark)\n      ELet(name, rv, rb, soff)\n    },\n    ELetRec(name, v, b) => {\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      let rv = relabel_expr(v, tbl, shadows)\n      let rb = relabel_expr(b, tbl, shadows)\n      Array::truncate(shadows, mark)\n      ELetRec(name, rv, rb)\n    },\n    ELetMut(name, v, b, soff) => {\n      let rv = relabel_expr(v, tbl, shadows)\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      let rb = relabel_expr(b, tbl, shadows)\n      Array::truncate(shadows, mark)\n      ELetMut(name, rv, rb, soff)\n    },\n    EAssign(name, v, c) => EAssign(name, relabel_expr(v, tbl, shadows), relabel_expr(c, tbl, shadows)),\n    EAssignOp(name, op, v, c) => EAssignOp(name, op, relabel_expr(v, tbl, shadows), relabel_expr(c, tbl, shadows)),\n    ESeq(a, b) => ESeq(relabel_expr(a, tbl, shadows), relabel_expr(b, tbl, shadows)),\n    EMatch(scrut, arms) => {\n      let rscrut = relabel_expr(scrut, tbl, shadows)\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        let mark = Array::length(shadows)\n        relabel_pat_binds(p, shadows)\n        Array::push(out, (p, relabel_expr(b, tbl, shadows)))\n        Array::truncate(shadows, mark)\n        i = i + 1\n      }\n      EMatch(rscrut, out)\n    },\n    EHandle(scrut, arms) => {\n      let rscrut = relabel_expr(scrut, tbl, shadows)\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        let mark = Array::length(shadows)\n        relabel_pat_binds(p, shadows)\n        Array::push(out, (p, relabel_expr(b, tbl, shadows)))\n        Array::truncate(shadows, mark)\n        i = i + 1\n      }\n      EHandle(rscrut, out)\n    },\n    EWhile(c, b) => EWhile(relabel_expr(c, tbl, shadows), relabel_expr(b, tbl, shadows)),\n    ELoop(params, b) => {\n      let rinits = for param in params {\n        let (name, init) = param\n        (name, relabel_expr(init, tbl, shadows))\n      }\n      let mark = Array::length(shadows)\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname, _) = Array::get(params, pi)\n        Array::push(shadows, pname)\n        pi = pi + 1\n      }\n      let rb = relabel_expr(b, tbl, shadows)\n      Array::truncate(shadows, mark)\n      ELoop(rinits, rb)\n    },\n    EForIn(name, idx, iter, b) => {\n      let riter = relabel_expr(iter, tbl, shadows)\n      let mark = Array::length(shadows)\n      Array::push(shadows, name)\n      match idx {\n        Some(ix) => Array::push(shadows, ix),\n        None => ()\n      }\n      let rb = relabel_expr(b, tbl, shadows)\n      Array::truncate(shadows, mark)\n      EForIn(name, idx, riter, rb)\n    },\n    EFn(tp, bnds, params, rt, eff, b) => {\n      let mark = Array::length(shadows)\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pn, _) = Array::get(params, pi)\n        Array::push(shadows, strip_label_tilde(pn))\n        pi = pi + 1\n      }\n      let rb = relabel_expr(b, tbl, shadows)\n      Array::truncate(shadows, mark)\n      EFn(tp, bnds, params, rt, eff, rb)\n    },\n    EDot(obj, field, off, fdoff) => EDot(relabel_expr(obj, tbl, shadows), field, off, fdoff),\n    ELabeledArg(label, name, b) => ELabeledArg(label, name, relabel_expr(b, tbl, shadows)),\n    EReturn(e) => EReturn(relabel_expr(e, tbl, shadows)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(relabel_expr(e, tbl, shadows))),\n      None => expr\n    },\n    EContinue(exprs) => EContinue(for e in exprs {\n      relabel_expr(e, tbl, shadows)\n    }),\n    _ => expr\n  }\n}\n\n///|\nfn relabel_stmt(stmt: Stmt, tbl: Array[(String, Array[String])]) -> Stmt {\n  match stmt {\n    SLet(ex, rc, name, ty, body) => SLet(ex, rc, name, ty, relabel_expr(body, tbl, empty_str_array())),\n    SLetMut(name, ty, body) => SLetMut(name, ty, relabel_expr(body, tbl, empty_str_array())),\n    STest(name, body) => STest(name, relabel_expr(body, tbl, empty_str_array())),\n    SBench(name, body) => SBench(name, relabel_expr(body, tbl, empty_str_array())),\n    SExpr(e) => SExpr(relabel_expr(e, tbl, empty_str_array())),\n    SLetPat(pat, e) => SLetPat(pat, relabel_expr(e, tbl, empty_str_array())),\n    SModule(ex, name, stmts) => SModule(ex, name, for s in stmts {\n      relabel_stmt(s, tbl)\n    }),\n    _ => stmt\n  }\n}\n\n///|\n// #986: read-only containment scan — does this expr contain any ELabeledArg?\n// Used to gate the (allocating) relabel_stmt rebuild per top-level statement,\n// since collect_fn_param_labels now indexes EVERY top-level function and the\n// old `tbl empty -> skip` fast path no longer fires for ordinary programs.\nfn expr_has_labeled_arg(expr: Expr) -> Bool {\n  match expr {\n    ELabeledArg(_, _, _) => true,\n    ECall(callee, args, _) => {\n      let mut found = expr_has_labeled_arg(callee)\n      let mut i = 0\n      while i < Array::length(args) {\n        if found {\n          i = Array::length(args)\n        } else {\n          found = expr_has_labeled_arg(Array::get(args, i))\n          i = i + 1\n        }\n      }\n      found\n    },\n    EBinOp(_, l, r) => expr_has_labeled_arg(l) || expr_has_labeled_arg(r),\n    EUnaryOp(_, e) => expr_has_labeled_arg(e),\n    ETuple(elems) => arr_has_labeled_arg(elems),\n    EArray(elems) => arr_has_labeled_arg(elems),\n    ESpread(e) => expr_has_labeled_arg(e),\n    ERecord(_, fields, _) => pairs_have_labeled_arg(fields),\n    EMap(fields) => pairs_have_labeled_arg(fields),\n    EIf(c, t, e) => expr_has_labeled_arg(c) || expr_has_labeled_arg(t) || expr_has_labeled_arg(e),\n    ELet(_, v, b, _) => expr_has_labeled_arg(v) || expr_has_labeled_arg(b),\n    ELetRec(_, v, b) => expr_has_labeled_arg(v) || expr_has_labeled_arg(b),\n    ELetMut(_, v, b, _) => expr_has_labeled_arg(v) || expr_has_labeled_arg(b),\n    EAssign(_, v, k) => expr_has_labeled_arg(v) || expr_has_labeled_arg(k),\n    EAssignOp(_, _, v, k) => expr_has_labeled_arg(v) || expr_has_labeled_arg(k),\n    ESeq(a, b) => expr_has_labeled_arg(a) || expr_has_labeled_arg(b),\n    EMatch(scrut, arms) => expr_has_labeled_arg(scrut) || arms_have_labeled_arg(arms),\n    EHandle(scrut, arms) => expr_has_labeled_arg(scrut) || arms_have_labeled_arg(arms),\n    EWhile(c, b) => expr_has_labeled_arg(c) || expr_has_labeled_arg(b),\n    ELoop(inits, b) => pairs_have_labeled_arg(inits) || expr_has_labeled_arg(b),\n    EForIn(_, _, iter, b) => expr_has_labeled_arg(iter) || expr_has_labeled_arg(b),\n    EFn(_, _, _, _, _, b) => expr_has_labeled_arg(b),\n    EDot(obj, _, _, _) => expr_has_labeled_arg(obj),\n    EReturn(e) => expr_has_labeled_arg(e),\n    EBreak(opt) => match opt {\n      Some(e) => expr_has_labeled_arg(e),\n      None => false\n    },\n    EContinue(exprs) => arr_has_labeled_arg(exprs),\n    _ => false\n  }\n}\n\n///|\nfn arr_has_labeled_arg(exprs: Array[Expr]) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(exprs) {\n    if found {\n      i = Array::length(exprs)\n    } else {\n      found = expr_has_labeled_arg(Array::get(exprs, i))\n      i = i + 1\n    }\n  }\n  found\n}\n\n///|\nfn pairs_have_labeled_arg(pairs: Array[(String, Expr)]) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(pairs) {\n    if found {\n      i = Array::length(pairs)\n    } else {\n      let (_, v) = Array::get(pairs, i)\n      found = expr_has_labeled_arg(v)\n      i = i + 1\n    }\n  }\n  found\n}\n\n///|\nfn arms_have_labeled_arg(arms: Array[(Pat, Expr)]) -> Bool {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(arms) {\n    if found {\n      i = Array::length(arms)\n    } else {\n      let (_, b) = Array::get(arms, i)\n      found = expr_has_labeled_arg(b)\n      i = i + 1\n    }\n  }\n  found\n}\n\n///|\nfn stmt_has_labeled_arg(stmt: Stmt) -> Bool {\n  match stmt {\n    SLet(_, _, _, _, body) => expr_has_labeled_arg(body),\n    SLetMut(_, _, body) => expr_has_labeled_arg(body),\n    STest(_, body) => expr_has_labeled_arg(body),\n    SBench(_, body) => expr_has_labeled_arg(body),\n    SExpr(e) => expr_has_labeled_arg(e),\n    SLetPat(_, e) => expr_has_labeled_arg(e),\n    SModule(_, _, ms) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(ms) {\n        if found {\n          i = Array::length(ms)\n        } else {\n          found = stmt_has_labeled_arg(Array::get(ms, i))\n          i = i + 1\n        }\n      }\n      found\n    },\n    _ => false\n  }\n}\n\n///|\n// In-place labeled-argument reordering over a whole program. Rebuilds only the\n// top-level statements that actually contain a labeled argument (see\n// expr_has_labeled_arg).\nexport fn desugar_labeled_args(stmts: Array[Stmt]) -> Unit {\n  let tbl = collect_fn_param_labels(stmts)\n  if Array::length(tbl) == 0 {\n    ()\n  } else {\n    let mut i = 0\n    while i < Array::length(stmts) {\n      if stmt_has_labeled_arg(Array::get(stmts, i)) {\n        Array::set(stmts, i, relabel_stmt(Array::get(stmts, i), tbl))\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n  }\n}\n\n///|\n// #790: lower array-literal spreads `[a, ...xs, b]` into an `Array::concat` chain\n// of segments (`Array::concat(Array::concat([a], xs), [b])`). The parser accepts\n// `...expr` inside an array literal (ESpread), but the active desugar pipeline\n// never lowered it, so codegen reached ESpread and threw \"unsupported expression\n// in codegen\". Ported from the legacy desugar.vibe (spread-only; no other legacy\n// transforms). `das_arms` is mutually recursive with `das_expr`.\nfn das_expr(expr: Expr) -> Expr {\n  match expr {\n    EArray(elems) => {\n      let mut has_spread = false\n      let mut si0 = 0\n      while si0 < Array::length(elems) {\n        match Array::get(elems, si0) {\n          ESpread(_) => {\n            has_spread = true\n          },\n          _ => ()\n        }\n        si0 = si0 + 1\n      }\n      if has_spread {\n        let segments = array_empty()\n        let mut buf = empty_expr_array()\n        let mut si = 0\n        while si < Array::length(elems) {\n          let elem = Array::get(elems, si)\n          match elem {\n            ESpread(inner) => {\n              if Array::length(buf) > 0 {\n                Array::push(segments, EArray(for e in buf {\n                  das_expr(e)\n                }))\n                buf = empty_expr_array()\n              } else {\n                ()\n              }\n              Array::push(segments, das_expr(inner))\n            },\n            _ => Array::push(buf, elem)\n          }\n          si = si + 1\n        }\n        if Array::length(buf) > 0 {\n          Array::push(segments, EArray(for e in buf {\n            das_expr(e)\n          }))\n        } else {\n          ()\n        }\n        let mut acc = Array::get(segments, 0)\n        let mut fi = 1\n        while fi < Array::length(segments) {\n          acc = ECall(EIdent(\"Array::concat\", 0 - 1), [\n            acc,\n            Array::get(segments, fi)\n          ], 0 - 1)\n          fi = fi + 1\n        }\n        acc\n      } else {\n        EArray(for e in elems {\n          das_expr(e)\n        })\n      }\n    },\n    ETuple(es) => ETuple(for e in es {\n      das_expr(e)\n    }),\n    ERecord(rn, fs, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, das_expr(v)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, das_expr(v)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(das_expr(c), das_expr(t), das_expr(e)),\n    ELet(n, v, b, soff) => ELet(n, das_expr(v), das_expr(b), soff),\n    ELetRec(n, v, b) => ELetRec(n, das_expr(v), das_expr(b)),\n    ELetMut(n, v, b, soff) => ELetMut(n, das_expr(v), das_expr(b), soff),\n    EAssign(n, v, c) => EAssign(n, das_expr(v), das_expr(c)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, das_expr(v), das_expr(c)),\n    ESeq(a, b) => ESeq(das_expr(a), das_expr(b)),\n    EMatch(s, arms) => EMatch(das_expr(s), das_arms(arms)),\n    EHandle(s, arms) => EHandle(das_expr(s), das_arms(arms)),\n    EWhile(c, b) => EWhile(das_expr(c), das_expr(b)),\n    ELoop(params, b) => ELoop(for param in params {\n      let (name, init) = param\n      (name, das_expr(init))\n    }, das_expr(b)),\n    EForIn(n, idxn, it, b) => EForIn(n, idxn, das_expr(it), das_expr(b)),\n    ECall(callee, args, off) => ECall(das_expr(callee), for a in args {\n      das_expr(a)\n    }, off),\n    EBinOp(op, l, r) => EBinOp(op, das_expr(l), das_expr(r)),\n    EUnaryOp(op, e) => EUnaryOp(op, das_expr(e)),\n    EFn(tp, tb, params, rt, eff, body) => EFn(tp, tb, params, rt, eff, das_expr(body)),\n    EDot(o, f, off, fdoff) => EDot(das_expr(o), f, off, fdoff),\n    ELabeledArg(l, m, e) => ELabeledArg(l, m, das_expr(e)),\n    EReturn(e) => EReturn(das_expr(e)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(das_expr(e))),\n      None => expr\n    },\n    EContinue(es) => EContinue(for e in es {\n      das_expr(e)\n    }),\n    ESpread(inner) => ESpread(das_expr(inner)),\n    _ => expr\n  }\n}\n\n///|\nfn das_arms(arms: Array[(Pat, Expr)]) -> Array[(Pat, Expr)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (p, b) = Array::get(arms, i)\n    Array::push(out, (p, das_expr(b)))\n    i = i + 1\n  }\n  out\n}\n\n///|\nfn das_stmt(stmt: Stmt) -> Stmt {\n  match stmt {\n    SLet(ex, rc, name, ty, body) => SLet(ex, rc, name, ty, das_expr(body)),\n    SLetMut(name, ty, body) => SLetMut(name, ty, das_expr(body)),\n    STest(name, body) => STest(name, das_expr(body)),\n    SBench(name, body) => SBench(name, das_expr(body)),\n    SExpr(e) => SExpr(das_expr(e)),\n    SLetPat(pat, e) => SLetPat(pat, das_expr(e)),\n    _ => stmt\n  }\n}\n\n///|\n// In-place lowering of array-literal spreads across the whole program (#790).\nexport fn desugar_array_spread(stmts: Array[Stmt]) -> Unit {\n  let n = Array::length(stmts)\n  let mut i = 0\n  while i < n {\n    Array::set(stmts, i, das_stmt(Array::get(stmts, i)))\n    i = i + 1\n  }\n}\n\n///|\nfn dtpw_exprs_bind_name(es: Array[Expr], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(es) && !found {\n    if dtpw_expr_binds_name(Array::get(es, i), name) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n///|\n// Does `expr` bind (shadow) `name` ANYWHERE within it -- as an EFn\n// parameter, a `let`/`let mut`/`let rec` name, a match/handle arm's\n// pattern binder, a for-loop's item/index name, or a `loop` parameter?\n// Full-coverage traversal mirroring dtpw_inline_expr's own node coverage.\n// See dtpw_collect_wrappers' call site for why this exists (#1074 review,\n// chatgpt-codex-connector P1: \"Respect lexical shadowing in wrapper\n// inlining\").\nfn dtpw_expr_binds_name(expr: Expr, name: String) -> Bool {\n  match expr {\n    EFn(_, _, params, _, _, body) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) && !found {\n        let (pn, _) = Array::get(params, i)\n        if dlh_strip_tilde(pn) == name {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found || dtpw_expr_binds_name(body, name)\n    },\n    ELet(n, v, b, _) => n == name || dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(b, name),\n    ELetRec(n, v, b) => n == name || dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(b, name),\n    ELetMut(n, v, b, _) => n == name || dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(b, name),\n    EForIn(n, idxn, it, b) => {\n      let idx_hit = match idxn {\n        Some(i2) => i2 == name,\n        None => false\n      }\n      n == name || idx_hit || dtpw_expr_binds_name(it, name) || dtpw_expr_binds_name(b, name)\n    },\n    ELoop(params, b) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) && !found {\n        let (pn, init) = Array::get(params, i)\n        if pn == name || dtpw_expr_binds_name(init, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found || dtpw_expr_binds_name(b, name)\n    },\n    EMatch(s, arms) => {\n      let mut i = 0\n      let mut found = dtpw_expr_binds_name(s, name)\n      while i < Array::length(arms) && !found {\n        let (p, b) = Array::get(arms, i)\n        let bound = array_empty()\n        dlh_pat_binds(p, bound)\n        if dlh_contains(bound, name) || dtpw_expr_binds_name(b, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EHandle(s, arms) => {\n      let mut i = 0\n      let mut found = dtpw_expr_binds_name(s, name)\n      while i < Array::length(arms) && !found {\n        let (p, b) = Array::get(arms, i)\n        let bound = array_empty()\n        dlh_pat_binds(p, bound)\n        if dlh_contains(bound, name) || dtpw_expr_binds_name(b, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ECall(callee, args, _) => dtpw_expr_binds_name(callee, name) || dtpw_exprs_bind_name(args, name),\n    EBinOp(_, l, r) => dtpw_expr_binds_name(l, name) || dtpw_expr_binds_name(r, name),\n    EUnaryOp(_, e) => dtpw_expr_binds_name(e, name),\n    ETuple(es) => dtpw_exprs_bind_name(es, name),\n    EArray(es) => dtpw_exprs_bind_name(es, name),\n    ESpread(e) => dtpw_expr_binds_name(e, name),\n    EContinue(es) => dtpw_exprs_bind_name(es, name),\n    ERecord(_, fs, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fs) && !found {\n        let (_, v) = Array::get(fs, i)\n        if dtpw_expr_binds_name(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fs) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fs) && !found {\n        let (_, v) = Array::get(fs, i)\n        if dtpw_expr_binds_name(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EIf(c, t, e) => dtpw_expr_binds_name(c, name) || dtpw_expr_binds_name(t, name) || dtpw_expr_binds_name(e, name),\n    EAssign(_, v, c) => dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(c, name),\n    EAssignOp(_, _, v, c) => dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(c, name),\n    ESeq(a, b) => dtpw_expr_binds_name(a, name) || dtpw_expr_binds_name(b, name),\n    EWhile(c, b) => dtpw_expr_binds_name(c, name) || dtpw_expr_binds_name(b, name),\n    EDot(o, _, _, _) => dtpw_expr_binds_name(o, name),\n    ELabeledArg(_, _, e) => dtpw_expr_binds_name(e, name),\n    EReturn(e) => dtpw_expr_binds_name(e, name),\n    EBreak(opt) => match opt {\n      Some(e) => dtpw_expr_binds_name(e, name),\n      None => false\n    },\n    _ => false\n  }\n}\n\n///|\n// #1070 (narrow slice): a \"trivial pass-through wrapper\" is a top-level\n// `let name = (param) -> T with { ... } { param() }` -- exactly one\n// parameter, body is EXACTLY a zero-arg call to that same parameter and\n// nothing else. Collects (wrapper_name, needed) pairs; `needed` is always\n// true here (arity always matches: the wrapper always takes exactly 1 arg\n// and calls its param with exactly 0), kept as a tuple only for symmetry\n// with how this file's other collector helpers are shaped.\n//\n// A collected name is DROPPED again if it's shadowed ANYWHERE in the\n// program (any nested `let`/`let mut`/EFn parameter/match-or-handle-arm\n// binder/for-loop name/loop parameter reusing the same identifier) --\n// dtpw_inline_expr's rewrite matches call sites by NAME ONLY with no\n// scope tracking, so a shadowed name would otherwise get inlined at the\n// WRONG (shadowing) binding's call sites too, changing real program\n// behavior (#1074 review, chatgpt-codex-connector P1). This is\n// deliberately whole-program-conservative rather than precisely\n// scope-threaded: losing the optimization on the rare program that\n// happens to reuse a wrapper's name as a binder elsewhere is an\n// acceptable trade for guaranteed correctness, matching this file's\n// established \"bail out entirely when it can't be proven safe\" pattern\n// (see dlh_marker_only_called_directly's own doc comment).\nfn dtpw_collect_wrappers(stmts: Array[Stmt]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, EFn(_, _, params, _, _, body)) => if Array::length(params) == 1 {\n        let (pname, _) = Array::get(params, 0)\n        let stripped = dlh_strip_tilde(pname)\n        match body {\n          ECall(callee, args, _) => match callee {\n            EIdent(cn, _) => if cn == stripped && Array::length(args) == 0 {\n              Array::push(out, name)\n            } else {\n              ()\n            },\n            _ => ()\n          },\n          _ => ()\n        }\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  let safe = array_empty()\n  let mut j = 0\n  while j < Array::length(out) {\n    let wn = Array::get(out, j)\n    let mut shadowed = false\n    let mut k = 0\n    while k < Array::length(stmts) && !shadowed {\n      match Array::get(stmts, k) {\n        SLet(_, _, _, _, sv) => if dtpw_expr_binds_name(sv, wn) {\n          shadowed = true\n        } else {\n          ()\n        },\n        _ => ()\n      }\n      k = k + 1\n    }\n    if !shadowed {\n      Array::push(safe, wn)\n    } else {\n      ()\n    }\n    j = j + 1\n  }\n  safe\n}\n\n// Rewrite every `ECall(EIdent(wname), [single_arg], off)` where `wname` is a\n// collected trivial wrapper into `ECall(single_arg, [], off)` -- calling the\n// argument directly instead of routing through the identity wrapper. Full\n// traversal (mirrors this file's other full-coverage passes); the wrapper's\n// own top-level definition is left completely untouched, so it remains\n// valid wherever else it's referenced (as a value, or with a different\n// arity that wouldn't match here anyway).\nfn dtpw_inline_expr(expr: Expr, wrappers: Array[String]) -> Expr {\n  match expr {\n    ECall(callee, args, off) => match callee {\n      EIdent(wn, _) => if dlh_contains(wrappers, wn) && Array::length(args) == 1 {\n        ECall(dtpw_inline_expr(Array::get(args, 0), wrappers), array_empty(), off)\n      } else {\n        ECall(dtpw_inline_expr(callee, wrappers), for a in args {\n          dtpw_inline_expr(a, wrappers)\n        }, off)\n      },\n      _ => ECall(dtpw_inline_expr(callee, wrappers), for a in args {\n        dtpw_inline_expr(a, wrappers)\n      }, off)\n    },\n    EBinOp(op, l, r) => EBinOp(op, dtpw_inline_expr(l, wrappers), dtpw_inline_expr(r, wrappers)),\n    EUnaryOp(op, e) => EUnaryOp(op, dtpw_inline_expr(e, wrappers)),\n    ETuple(es) => ETuple(for e in es {\n      dtpw_inline_expr(e, wrappers)\n    }),\n    EArray(es) => EArray(for e in es {\n      dtpw_inline_expr(e, wrappers)\n    }),\n    ESpread(e) => ESpread(dtpw_inline_expr(e, wrappers)),\n    EContinue(es) => EContinue(for e in es {\n      dtpw_inline_expr(e, wrappers)\n    }),\n    ERecord(rn, fs, targs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dtpw_inline_expr(v, wrappers)))\n        i = i + 1\n      }\n      ERecord(rn, out, targs)\n    },\n    EMap(fs) => {\n      let out = array_empty()\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (k, v) = Array::get(fs, i)\n        Array::push(out, (k, dtpw_inline_expr(v, wrappers)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(dtpw_inline_expr(c, wrappers), dtpw_inline_expr(t, wrappers), dtpw_inline_expr(e, wrappers)),\n    ELet(n, v, b, soff) => ELet(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(b, wrappers), soff),\n    ELetRec(n, v, b) => ELetRec(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(b, wrappers)),\n    ELetMut(n, v, b, soff) => ELetMut(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(b, wrappers), soff),\n    EAssign(n, v, c) => EAssign(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(c, wrappers)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(c, wrappers)),\n    ESeq(a, b) => ESeq(dtpw_inline_expr(a, wrappers), dtpw_inline_expr(b, wrappers)),\n    EWhile(c, b) => EWhile(dtpw_inline_expr(c, wrappers), dtpw_inline_expr(b, wrappers)),\n    EForIn(n, idxn, it, b) => EForIn(n, idxn, dtpw_inline_expr(it, wrappers), dtpw_inline_expr(b, wrappers)),\n    EDot(o, f, off, fdoff) => EDot(dtpw_inline_expr(o, wrappers), f, off, fdoff),\n    ELabeledArg(l, m, e) => ELabeledArg(l, m, dtpw_inline_expr(e, wrappers)),\n    EReturn(e) => EReturn(dtpw_inline_expr(e, wrappers)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e) => Some(dtpw_inline_expr(e, wrappers)),\n      None => None\n    }),\n    EFn(tp, bnds, params, rt, eff, body) => EFn(tp, bnds, params, rt, eff, dtpw_inline_expr(body, wrappers)),\n    EMatch(s, arms) => EMatch(dtpw_inline_expr(s, wrappers), for a in arms {\n      let (p, b) = a\n      (p, dtpw_inline_expr(b, wrappers))\n    }),\n    EHandle(s, arms) => EHandle(dtpw_inline_expr(s, wrappers), for a in arms {\n      let (p, b) = a\n      (p, dtpw_inline_expr(b, wrappers))\n    }),\n    ELoop(params, b) => ELoop(for p in params {\n      let (pn, init) = p\n      (pn, dtpw_inline_expr(init, wrappers))\n    }, dtpw_inline_expr(b, wrappers)),\n    _ => expr\n  }\n}\n\nfn dtpw_inline_trivial_wrappers(stmts: Array[Stmt]) -> Unit {\n  let wrappers = dtpw_collect_wrappers(stmts)\n  if Array::length(wrappers) == 0 {\n    ()\n  } else {\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, i, SLet(exported, is_rec, name, ty, dtpw_inline_expr(expr, wrappers))),\n        _ => ()\n      }\n      i = i + 1\n    }\n  }\n}\n\n///|\n// Entry point: in-place dictionary-passing desugaring. No-op unless the program\n// declares at least one method-bearing trait. Idempotent: re-running (the\n// single-file pipeline desugars before generic-stripping and codegen re-runs on\n// the same stmts after) finds the bounds already stripped (so no function is\n// re-threaded) and skips dict structs that already exist.\nexport fn desugar_trait_dicts(stmts: Array[Stmt]) -> Unit {\n  // #790: lower array-literal spreads first, so no downstream pass or codegen\n  // ever sees a raw ESpread.\n  desugar_array_spread(stmts)\n  // #1070 (narrow slice): inline a trivial pass-through wrapper\n  // (`let apply = (f) -> { f() }`, body EXACTLY a same-arity direct call to\n  // its own sole parameter, nothing else) at each matching call site\n  // (`apply(x)` -> `x()`), before #786's hoist below. A capturing effectful\n  // closure PASSED BY VALUE through such a wrapper (`apply(inner)` where\n  // `inner` captures a local) crashes independent of #1069's closure-\n  // conversion fix -- #1069 only rewrites provably-direct call sites, and\n  // `inner` used as a bare argument to `apply` is exactly the \"used as a\n  // value\" shape it correctly declines to touch. This doesn't attempt the\n  // general problem (#1070's own analysis: real closure-conversion-to-\n  // value semantics, or fixing #786's still-unlocated deeper combinator\n  // bug) -- it only recognizes the specific case where the \"value use\" is\n  // itself immediately, trivially, and unconditionally a direct call one\n  // level removed, and short-circuits it back into an ordinary direct\n  // call BEFORE #786/#1069's hoist+conversion logic runs, so THAT already-\n  // verified machinery picks it up exactly as if the caller had written\n  // `inner()` directly. Always sound regardless of what the argument does\n  // (identity-wrapper inlining never changes observable behavior -- the\n  // wrapper's own row already required whatever effects the checker\n  // already validated at the original `apply(inner)` call site, and\n  // `inner()` requires the identical row by construction), and leaves the\n  // wrapper's own top-level definition untouched (usable as a value\n  // wherever else it's referenced) -- only matching call sites are\n  // rewritten, so a wrapper used BOTH as a value AND as a direct call\n  // elsewhere is still handled safely either way.\n  dtpw_inline_trivial_wrappers(stmts)\n  // #786: hoist non-capturing effectful local lambdas to top-level functions\n  // before any other pass. A local `let f = (x) -> { perform ... }` that captures\n  // nothing gets promoted to a top-level `let f = ...`, so codegen emits a direct\n  // function (with its `$read` effect param) instead of a local closure whose\n  // arity-1 type may go unregistered. Runs first so the hoisted top-level SLets\n  // are processed by every downstream pass (labeled args, dict rewrite, codegen).\n  desugar_hoist_local_lambdas(stmts)\n  // Labeled-argument reordering runs first so downstream passes and codegen see\n  // args already in declared parameter order.\n  desugar_labeled_args(stmts)\n  // #760(2): make `Result` (Ok/Err) available standalone by appending its enum\n  // declaration when neither declared nor imported. Runs first so the ctor table\n  // and every downstream pass see it. Idempotent + inert when already present.\n  inject_prelude_result(stmts)\n  // derive(...) structural function generation (#638) — independent of traits,\n  // idempotent, so it runs unconditionally here at the shared pre-check points.\n  desugar_derives(stmts)\n  // Flatten supertrait methods into each trait so `[T: B]` (for `trait B: A`)\n  // dispatches both B's and A's methods through one witness dictionary. When the\n  // program declares no method-bearing trait `traits` is empty, the dict-passing\n  // rewrites are all no-ops (`gens` empty, sync-`for` classification gated off),\n  // and the rewrite pass only strips `for await` markers — so it must still run\n  // unconditionally (`for await` predates the trait machinery).\n  let traits_raw = collect_method_traits(stmts)\n  let supers_map = collect_trait_supers(stmts)\n  let traits = flatten_traits(traits_raw, supers_map)\n  // Rank-1 method generics (#684): re-attach each trait method's `[X: Bound]`\n  // binder to its impl free functions (and annotate their params) BEFORE\n  // build_gens, so `C::m` is registered as a bounded generic and the existing\n  // dict-passing threads the witness at qualified call sites. Inert (and\n  // idempotent) when no trait declares a method-level binder. Also run from\n  // `check_program` so the FS-compile path (which type-checks before this pass)\n  // sees the `X` binding and can resolve `X::method` in the impl body.\n  inject_trait_method_generics_with(stmts, traits)\n  let struct_sets = collect_struct_field_sets(stmts)\n  let fn_returns = collect_fn_returns(stmts)\n  let gimpl_types = collect_generic_impl_types(stmts)\n  let gens = build_gens(stmts, traits, gimpl_types)\n  // #839: see `collect_toplevel_anon_records` / the `rewrite_stmt` doc comment.\n  let toplevel_vars = collect_toplevel_anon_records(stmts, struct_sets)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::set(stmts, i, rewrite_stmt(Array::get(stmts, i), gens, traits, struct_sets, fn_returns, toplevel_vars))\n    i = i + 1\n  }\n  // Witness dict structs are only needed when method-bearing traits exist.\n  if Array::length(traits_raw) == 0 {\n    ()\n  } else {\n    let mut ti = 0\n    while ti < Array::length(traits) {\n      let (trait_name, sigs) = Array::get(traits, ti)\n      if struct_decl_exists(stmts, dict_struct_name(trait_name)) {\n        ()\n      } else {\n        Array::push(stmts, make_dict_struct_stmt(trait_name, sigs))\n      }\n      ti = ti + 1\n    }\n  }\n}\n")
}

let cli_adapter_source_211 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/self_tail_call.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  __to_string\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# Functions\n\n// Self-tail-call optimization (#tco): a top-level `let f = (p0, p1, ...) ->\n// T { ... f(a0, a1, ...) ... }` whose ONLY self-references are calls to\n// itself in TAIL position compiles today to an ordinary wasm `call` at every\n// recursive step — confirmed by disassembly to overflow the native/wasm call\n// stack at a recursion depth in the low tens of thousands. `loop (i = 0, ..)\n// { ... continue(...) }` already compiles to genuine wasm `block`/`loop`/`br`\n// with zero stack growth (parser_expr_primary.vibe's parse_loop_primary +\n// desugar_loop_body). This pass rewrites a self-tail-recursive function body\n// into the SAME shape the parser already produces for an explicit `loop`, so\n// it inherits that already-proven-safe lowering: each function parameter is\n// shadowed by a fresh mutable local seeded from the parameter, the body is\n// wrapped in `while (true) { ... }`, a tail self-call becomes an assignment\n// to those mutable locals followed by a bare `continue`, and every other\n// tail expression becomes `__stc_result = <expr>; break`.\n//\n// Deliberately conservative (bail out to leave the original recursive `call`\n// untouched) whenever the shape is not obviously safe to rewrite:\n//   - the function's own name is shadowed anywhere in its body (a nested\n//     `let`/`let mut`/`let rec`/closure param/match-or-handle-pattern binding\n//     the same name) — a shadowed reference is NOT a self-call, and proving\n//     that precisely everywhere would need full scope tracking this pass\n//     does not do (see checker_capture.vibe's `bound` threading for what\n//     that would take);\n//   - a parameter, or anything bound anywhere in the body, is named\n//     `__stc_result` or starts with `__stc` (the reserved prefix this pass\n//     itself generates fresh names under) — this pass runs automatically,\n//     with no opt-in syntax the way `loop` has, so a user binding that\n//     happens to collide with a synthesized name must not be silently\n//     shadowed;\n//   - the body contains `EHandle` (effect handler) or `EReturn` (early\n//     return) anywhere — both interact with control flow in ways this local,\n//     structural rewrite does not attempt to reason about;\n//   - the body contains a nested `EFn` (closure literal) anywhere — turning\n//     a parameter into a shared mutable loop-carried cell (below) changes\n//     capture semantics for any closure that captures it: codegen boxes a\n//     captured mutable binding by reference, so a closure built in a\n//     non-final iteration and later invoked would observe a LATER\n//     iteration's value instead of a snapshot of its own invocation's value.\n//     Rejecting any nested closure is coarser than necessary (a closure\n//     that captures nothing of this function's parameters would actually be\n//     fine) but avoids needing real capture analysis here;\n//   - no tail-position call to the function's own name with matching arity\n//     is found at all (nothing to rewrite).\n//\n// Runs once over the whole merged program, called from both codegen\n// backends' convergence points (mirrors desugar_trait_dicts /\n// rewrite_top_level_fn_alias_refs — see their call sites in\n// codegen/wasi/linked_compile.vibe and codegen/gc/backend_body.vibe).\nexport fn rewrite_self_tail_calls(stmts: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, is_rec, name, ty, expr) => match expr {\n        EFn(tps, tbs, params, ret, eff, body) => {\n          let param_names = stc_param_names(params)\n          let arity = Array::length(param_names)\n          if stc_eligible(name, params, param_names, arity, body) {\n            let new_body = stc_build_loop_body(name, param_names, arity, body)\n            Array::set(stmts, i, SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, new_body)))\n          } else {\n            ()\n          }\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn stc_param_names(params: Array[(String, Option[TypeExpr])]) -> Array[String] {\n  for p in params {\n    let (pn, _) = p\n    pn\n  }\n}\n\n// Order matters for compile-time cost, not just correctness: `params_all_\n// scalar` and `tail_has_self_call` are cheap (the latter only walks tail\n// SLOTS, not the whole tree) and reject the overwhelming majority of\n// functions immediately, so the two whole-body scans below only run for the\n// rare function that's an actual self-tail-recursion candidate. Checking\n// them first (as an earlier version of this pass did) made\n// `rewrite_self_tail_calls` walk the FULL body of every scalar-only-param\n// function in the compiled program twice, regardless of whether it\n// self-recurses at all -- measurable overhead across thousands of functions\n// in a large program, caught by CI's self-compile heap-usage KPI gate.\nfn stc_eligible(name: String, params: Array[(String, Option[TypeExpr])], param_names: Array[String], arity: Int, body: Expr) -> Bool {\n  if !stc_params_all_scalar(params) {\n    false\n  } else if !stc_tail_has_self_call(body, name, arity) {\n    false\n  } else if stc_params_bind_name(params, name) {\n    false\n  } else if stc_expr_binds_name(body, name) {\n    false\n  } else {\n    !stc_expr_has_handle_or_return(body)\n  }\n}\n\n// Conservative safety valve: only rewrite when every parameter is an\n// unboxed scalar (Int/Bool/Float/Double/Unit, by declared type annotation).\n// The rewrite reassigns EVERY parameter's mutable local on every loop\n// iteration (mirroring how `loop (...)  { continue(...) }` already treats\n// its params — see the module doc comment), including parameters whose\n// value never actually changes across recursive calls. For a heap-managed\n// value (Array/String/struct/...) that redundant per-iteration reassignment\n// needs the same retain/release bookkeeping the RC (perceus) pass plans for\n// an ordinary `let mut`, and this pass runs too late in the pipeline to\n// replan that -- restricting to declared-scalar parameters sidesteps the\n// whole question. An unannotated parameter (`None`) is treated as NOT\n// scalar (conservative default: we cannot tell).\nfn stc_params_all_scalar(params: Array[(String, Option[TypeExpr])]) -> Bool {\n  let mut i = 0\n  let mut all_scalar = true\n  while i < Array::length(params) {\n    let (_, oty) = Array::get(params, i)\n    if !stc_type_is_scalar(oty) {\n      all_scalar = false\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  all_scalar\n}\n\nfn stc_type_is_scalar(oty: Option[TypeExpr]) -> Bool {\n  match oty {\n    Some(TyName(n)) => n == \"Int\" || n == \"Bool\" || n == \"Float\" || n == \"Double\",\n    Some(TyUnit) => true,\n    _ => false\n  }\n}\n\n// --- shadow guard: does `expr` bind `target`, OR anything under the\n// reserved `__stc` prefix this pass itself generates, ANYWHERE (not just in\n// tail position)? A conservative whole-body scan — see the module doc\n// comment. Folding the reserved-prefix check into the same traversal (via\n// `stc_name_unsafe` below) as the \"is this the function's own name\"\n// shadow-check keeps this a single pass instead of two.\n\nfn stc_is_reserved_name(n: String) -> Bool {\n  String::starts_with(n, \"__stc\")\n}\n\nfn stc_name_unsafe(n: String, target: String) -> Bool {\n  n == target || stc_is_reserved_name(n)\n}\n\nfn stc_expr_binds_name(expr: Expr, target: String) -> Bool {\n  match expr {\n    ELet(n, v, b, _) => stc_name_unsafe(n, target) || stc_expr_binds_name(v, target) || stc_expr_binds_name(b, target),\n    ELetMut(n, v, b, _) => stc_name_unsafe(n, target) || stc_expr_binds_name(v, target) || stc_expr_binds_name(b, target),\n    ELetRec(n, v, b) => stc_name_unsafe(n, target) || stc_expr_binds_name(v, target) || stc_expr_binds_name(b, target),\n    EFn(_, _, params, _, _, b) => stc_params_bind_name(params, target) || stc_expr_binds_name(b, target),\n    EForIn(n, idx, it, b) => stc_name_unsafe(n, target) || stc_opt_name_is(idx, target) || stc_expr_binds_name(it, target) || stc_expr_binds_name(b, target),\n    EMatch(s, arms) => stc_expr_binds_name(s, target) || stc_arms_bind_name(arms, target),\n    EHandle(s, arms) => stc_expr_binds_name(s, target) || stc_arms_bind_name(arms, target),\n    EIf(c, t, e) => stc_expr_binds_name(c, target) || stc_expr_binds_name(t, target) || stc_expr_binds_name(e, target),\n    ESeq(a, b) => stc_expr_binds_name(a, target) || stc_expr_binds_name(b, target),\n    EWhile(c, b) => stc_expr_binds_name(c, target) || stc_expr_binds_name(b, target),\n    ELoop(pairs, b) => stc_loop_pairs_bind_name(pairs, target) || stc_expr_binds_name(b, target),\n    ECall(callee, args, _) => stc_expr_binds_name(callee, target) || stc_exprs_bind_name(args, target),\n    EBinOp(_, l, r) => stc_expr_binds_name(l, target) || stc_expr_binds_name(r, target),\n    EUnaryOp(_, e2) => stc_expr_binds_name(e2, target),\n    EAssign(_, v, c) => stc_expr_binds_name(v, target) || stc_expr_binds_name(c, target),\n    EAssignOp(_, _, v, c) => stc_expr_binds_name(v, target) || stc_expr_binds_name(c, target),\n    EDot(o, _, _, _) => stc_expr_binds_name(o, target),\n    ELabeledArg(_, _, v) => stc_expr_binds_name(v, target),\n    EReturn(e2) => stc_expr_binds_name(e2, target),\n    EBreak(opt) => match opt {\n      Some(e2) => stc_expr_binds_name(e2, target),\n      None => false\n    },\n    EContinue(args) => stc_exprs_bind_name(args, target),\n    ETuple(elems) => stc_exprs_bind_name(elems, target),\n    EArray(elems) => stc_exprs_bind_name(elems, target),\n    ERecord(_, fields, _) => stc_fields_bind_name(fields, target),\n    EMap(fields) => stc_fields_bind_name(fields, target),\n    ESpread(e2) => stc_expr_binds_name(e2, target),\n    _ => false\n  }\n}\n\nfn stc_opt_name_is(opt: Option[String], target: String) -> Bool {\n  match opt {\n    Some(n) => stc_name_unsafe(n, target),\n    None => false\n  }\n}\n\nfn stc_exprs_bind_name(exprs: Array[Expr], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(exprs) {\n    if stc_expr_binds_name(Array::get(exprs, i), target) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_fields_bind_name(fields: Array[(String, Expr)], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    if stc_expr_binds_name(v, target) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_params_bind_name(params: Array[(String, Option[TypeExpr])], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(params) {\n    let (pn, _) = Array::get(params, i)\n    if stc_name_unsafe(pn, target) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_loop_pairs_bind_name(pairs: Array[(String, Expr)], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(pairs) {\n    let (pn, init) = Array::get(pairs, i)\n    if stc_name_unsafe(pn, target) || stc_expr_binds_name(init, target) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_pat_binds_name(pat: Pat, target: String) -> Bool {\n  match pat {\n    PBind(n) => stc_name_unsafe(n, target),\n    PCtor(_, ps) => stc_pats_bind_name(ps, target),\n    PTuple(ps) => stc_pats_bind_name(ps, target),\n    POr(a, b) => stc_pat_binds_name(a, target) || stc_pat_binds_name(b, target),\n    PStruct(_, fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, p) = Array::get(fields, i)\n        if stc_pat_binds_name(p, target) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    _ => false\n  }\n}\n\nfn stc_pats_bind_name(pats: Array[Pat], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(pats) {\n    if stc_pat_binds_name(Array::get(pats, i), target) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_arms_bind_name(arms: Array[(Pat, Expr)], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) {\n    let (p, ex) = Array::get(arms, i)\n    if stc_pat_binds_name(p, target) || stc_expr_binds_name(ex, target) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// --- whole-body guard: bail if `EHandle`/`EReturn`/a nested `EFn` (closure\n// literal) appear anywhere. The `EFn` case matches immediately rather than\n// recursing into the closure body: a nested closure ANYWHERE is enough to\n// reject (see the module doc comment on why -- captured-parameter semantics\n// would change under this rewrite), so there is nothing more to learn by\n// looking inside it, and merging this into the same traversal as the\n// EHandle/EReturn check avoids a second whole-body walk.\n\nfn stc_expr_has_handle_or_return(expr: Expr) -> Bool {\n  match expr {\n    EHandle(_, _) => true,\n    EReturn(_) => true,\n    EFn(_, _, _, _, _, _) => true,\n    ELet(_, v, b, _) => stc_expr_has_handle_or_return(v) || stc_expr_has_handle_or_return(b),\n    ELetMut(_, v, b, _) => stc_expr_has_handle_or_return(v) || stc_expr_has_handle_or_return(b),\n    ELetRec(_, v, b) => stc_expr_has_handle_or_return(v) || stc_expr_has_handle_or_return(b),\n    EForIn(_, _, it, b) => stc_expr_has_handle_or_return(it) || stc_expr_has_handle_or_return(b),\n    EMatch(s, arms) => stc_expr_has_handle_or_return(s) || stc_arms_have_handle_or_return(arms),\n    EIf(c, t, e) => stc_expr_has_handle_or_return(c) || stc_expr_has_handle_or_return(t) || stc_expr_has_handle_or_return(e),\n    ESeq(a, b) => stc_expr_has_handle_or_return(a) || stc_expr_has_handle_or_return(b),\n    EWhile(c, b) => stc_expr_has_handle_or_return(c) || stc_expr_has_handle_or_return(b),\n    ELoop(pairs, b) => stc_loop_pairs_have_handle_or_return(pairs) || stc_expr_has_handle_or_return(b),\n    ECall(callee, args, _) => stc_expr_has_handle_or_return(callee) || stc_exprs_have_handle_or_return(args),\n    EBinOp(_, l, r) => stc_expr_has_handle_or_return(l) || stc_expr_has_handle_or_return(r),\n    EUnaryOp(_, e2) => stc_expr_has_handle_or_return(e2),\n    EAssign(_, v, c) => stc_expr_has_handle_or_return(v) || stc_expr_has_handle_or_return(c),\n    EAssignOp(_, _, v, c) => stc_expr_has_handle_or_return(v) || stc_expr_has_handle_or_return(c),\n    EDot(o, _, _, _) => stc_expr_has_handle_or_return(o),\n    ELabeledArg(_, _, v) => stc_expr_has_handle_or_return(v),\n    EBreak(opt) => match opt {\n      Some(e2) => stc_expr_has_handle_or_return(e2),\n      None => false\n    },\n    EContinue(args) => stc_exprs_have_handle_or_return(args),\n    ETuple(elems) => stc_exprs_have_handle_or_return(elems),\n    EArray(elems) => stc_exprs_have_handle_or_return(elems),\n    ERecord(_, fields, _) => stc_fields_have_handle_or_return(fields),\n    EMap(fields) => stc_fields_have_handle_or_return(fields),\n    ESpread(e2) => stc_expr_has_handle_or_return(e2),\n    _ => false\n  }\n}\n\nfn stc_exprs_have_handle_or_return(exprs: Array[Expr]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(exprs) {\n    if stc_expr_has_handle_or_return(Array::get(exprs, i)) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_fields_have_handle_or_return(fields: Array[(String, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    if stc_expr_has_handle_or_return(v) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_loop_pairs_have_handle_or_return(pairs: Array[(String, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(pairs) {\n    let (_, init) = Array::get(pairs, i)\n    if stc_expr_has_handle_or_return(init) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn stc_arms_have_handle_or_return(arms: Array[(Pat, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    if stc_expr_has_handle_or_return(ex) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// --- tail-position self-call detection: recurses ONLY into structural tail\n// slots (mirrors parser_expr_primary.vibe's desugar_loop_body traversal).\n\nfn stc_is_self_call(expr: Expr, name: String, arity: Int) -> Bool {\n  match expr {\n    ECall(callee, args, _) => match callee {\n      EIdent(cn, _) => cn == name && Array::length(args) == arity,\n      _ => false\n    },\n    _ => false\n  }\n}\n\nfn stc_tail_has_self_call(expr: Expr, name: String, arity: Int) -> Bool {\n  match expr {\n    EIf(_, t, e) => stc_tail_has_self_call(t, name, arity) || stc_tail_has_self_call(e, name, arity),\n    EMatch(_, arms) => stc_tail_arms_have_self_call(arms, name, arity),\n    ELet(_, _, b, _) => stc_tail_has_self_call(b, name, arity),\n    ELetMut(_, _, b, _) => stc_tail_has_self_call(b, name, arity),\n    ELetRec(_, _, b) => stc_tail_has_self_call(b, name, arity),\n    ESeq(_, b) => stc_tail_has_self_call(b, name, arity),\n    EAssign(_, _, c) => stc_tail_has_self_call(c, name, arity),\n    EAssignOp(_, _, _, c) => stc_tail_has_self_call(c, name, arity),\n    _ => stc_is_self_call(expr, name, arity)\n  }\n}\n\nfn stc_tail_arms_have_self_call(arms: Array[(Pat, Expr)], name: String, arity: Int) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    if stc_tail_has_self_call(ex, name, arity) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// --- the rewrite itself.\n\nfn stc_build_loop_body(name: String, param_names: Array[String], arity: Int, body: Expr) -> Expr {\n  let transformed = stc_rewrite_tail(body, name, param_names, arity, 0)\n  let while_expr = EWhile(EBool(true), transformed)\n  let looped = ELetMut(\"__stc_result\", EInt(0),\n    ESeq(while_expr, EIdent(\"__stc_result\", -1)), -1)\n  let mut wrapped = looped\n  let mut wi = arity - 1\n  while wi >= 0 {\n    let pn = Array::get(param_names, wi)\n    wrapped = ELetMut(pn, EIdent(pn, -1), wrapped, -1)\n    wi = wi - 1\n  }\n  wrapped\n}\n\n// Recurses into tail slots exactly like stc_tail_has_self_call above; a self-\n// call in tail position becomes an assign-then-continue, every other tail\n// leaf becomes an assign-to-`__stc_result`-then-break. `seq` seeds the temp\n// names (`__stc<seq>_<argIdx>`) so nested self-calls under different tail\n// branches of the same function never collide with each other's temporaries.\nfn stc_rewrite_tail(expr: Expr, name: String, param_names: Array[String], arity: Int, seq: Int) -> Expr {\n  match expr {\n    EIf(c, t, e) => EIf(c, stc_rewrite_tail(t, name, param_names, arity, seq * 2 + 1), stc_rewrite_tail(e, name, param_names, arity, seq * 2 + 2)),\n    EMatch(s, arms) => EMatch(s, stc_rewrite_tail_arms(arms, name, param_names, arity, seq)),\n    ELet(n, v, b, off) => ELet(n, v, stc_rewrite_tail(b, name, param_names, arity, seq), off),\n    ELetMut(n, v, b, off) => ELetMut(n, v, stc_rewrite_tail(b, name, param_names, arity, seq), off),\n    ELetRec(n, v, b) => ELetRec(n, v, stc_rewrite_tail(b, name, param_names, arity, seq)),\n    ESeq(a, b) => ESeq(a, stc_rewrite_tail(b, name, param_names, arity, seq)),\n    EAssign(n, v, c) => EAssign(n, v, stc_rewrite_tail(c, name, param_names, arity, seq)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, v, stc_rewrite_tail(c, name, param_names, arity, seq)),\n    _ => if stc_is_self_call(expr, name, arity) {\n      stc_build_continue(expr, param_names, arity, seq)\n    } else {\n      EAssign(\"__stc_result\", expr, EBreak(None))\n    }\n  }\n}\n\nfn stc_rewrite_tail_arms(arms: Array[(Pat, Expr)], name: String, param_names: Array[String], arity: Int, seq: Int) -> Array[(Pat, Expr)] {\n  let mut i = 0\n  let mut out = array_empty()\n  while i < Array::length(arms) {\n    let (p, ex) = Array::get(arms, i)\n    Array::push(out, (p, stc_rewrite_tail(ex, name, param_names, arity, seq * 101 + i)))\n    i = i + 1\n  }\n  out\n}\n\n// `f(a0, a1, ...)` in tail position -> bind each arg to a fresh temp (so\n// argument evaluation cannot observe partially-updated loop-carried\n// parameters, exactly like desugar_loop_body's `continue(args)` handling),\n// assign the temps into the parameters' mutable locals, then a bare\n// `continue` (codegen drops any EContinue payload — see the parser's\n// desugar_loop_body doc comment — so the payload here is only ever empty).\nfn stc_build_continue(call_expr: Expr, param_names: Array[String], arity: Int, seq: Int) -> Expr {\n  match call_expr {\n    ECall(_, args, _) => {\n      let mut result = EContinue(array_empty())\n      let mut ai = arity - 1\n      while ai >= 0 {\n        let tmp = stc_temp_name(seq, ai)\n        result = EAssign(Array::get(param_names, ai), EIdent(tmp, -1), result)\n        ai = ai - 1\n      }\n      let mut aj = arity - 1\n      while aj >= 0 {\n        let tmp = stc_temp_name(seq, aj)\n        result = ELet(tmp, Array::get(args, aj), result, -1)\n        aj = aj - 1\n      }\n      result\n    },\n    _ => call_expr\n  }\n}\n\nfn stc_temp_name(seq: Int, idx: Int) -> String {\n  String::concat(\"__stc\", String::concat(__to_string(seq), String::concat(\"_\", __to_string(idx))))\n}\n")
}

let cli_adapter_source_212 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/common_base/inline_direct_perform.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  dce_keep_flags\n}\n\nimport @vibe/core {\n  array_empty\n}\n\n//# Functions\n\n// ADR-0076 Phase 2 (evidence-passing effect handlers, #817), first slice.\n//\n// `handle { BODY } with Effect { Op(args) => arm_body, ... }` is compiled\n// today via a replay loop (compile_expr_tail6.vibe) that re-executes BODY\n// from the top on every resume -- the mechanism behind the M2 correctness\n// bug (fixtures/effect_handle_replay_corruption.vibe) and the ~16K perform\n// bound. #942 already guarantees, as a hard compile error otherwise, that\n// every `resume(e)` in a handler arm is in TAIL position with nothing after\n// it (single-shot, no post-processing) -- i.e. every arm body already has\n// exactly the shape ADR-0076 calls \"tail-resumptive\". This pass exploits\n// that: for a `perform Effect::Op(args)` that occurs DIRECTLY inside a\n// handle's own BODY (not behind an intervening function call, and not\n// inside a nested closure or a nested `handle`), the handler is known at\n// the exact point of the perform -- no runtime dispatch, no evidence dict,\n// no unwind is needed at all. The perform is replaced in place by the\n// matching arm's body (with each pattern-bound parameter let-bound to the\n// actual argument expression, and the arm's own tail `resume(e)` rewritten\n// to plain `e`), and if EVERY perform for this handle's operations turns\n// out to be reachable this way, the `EHandle` wrapper itself is dropped\n// entirely -- the compiled program has no handler machinery left for that\n// `handle` at all.\n//\n// This does NOT attempt the general case (evidence dicts threaded through\n// intervening function calls, ADR-0076's primary mechanism) -- that is a\n// separate, larger slice. Conservative bail-out: if a handle's BODY\n// contains any `EFn` (nested closure -- a perform inside it might run much\n// later, dynamically, possibly after this handle has already returned) or\n// any nested `EHandle` (handler-shadowing semantics this pass does not\n// attempt to reason about), inlining is skipped entirely for that handle\n// and it is left for the existing replay codegen, matching today's\n// behavior exactly. A handle with some performs reachable and some hidden\n// behind such a boundary is a documented future improvement -- today it is\n// all-or-nothing.\n//\n// Phase 2b (this revision): a call is also no longer an automatic bail-out\n// when its callee is one of a small, hand-audited set of builtin static\n// functions (idp_pure_builtin_names) that the checker's own builtin type\n// table (checker/builtins_string1.vibe, builtins_string2.vibe,\n// builtins_misc.vibe) records with effect `None` and with no function-typed\n// parameter -- i.e. calls that provably cannot themselves perform, and\n// cannot invoke any user-supplied closure that might. `String::equals` in a\n// handle body (fixtures/effect_handle_two_layer.vibe's cache-hit check) no\n// longer forces a bail-out just because it is a call. Calls to ordinary\n// user-defined functions (whose declared effect row this pass does not\n// consult) are still unconditionally unsafe.\n//\n// Runs once over the whole merged program, called from both codegen\n// backends' convergence points, mirroring rewrite_self_tail_calls\n// (self_tail_call.vibe) and desugar_trait_dicts.\nexport fn inline_direct_performs(stmts: Array[Stmt]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, is_rec, name, ty, expr) => {\n        let new_expr = idp_rewrite(expr, idp_empty_table())\n        Array::set(stmts, i, SLet(exported, is_rec, name, ty, new_expr))\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\n// Arm lookup table: parallel arrays (op qualified name, param bind names,\n// prepared body with tail resume(e) already rewritten to e). Empty arrays\n// mean \"no handle scope currently active\" -- performs never match.\nfn idp_empty_table() -> (Array[String], Array[Array[String]], Array[Expr]) {\n  (array_empty_str(), array_empty_arr_str(), array_empty_expr())\n}\n\nfn array_empty_str() -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nfn array_empty_arr_str() -> Array[Array[String]] {\n  Array::slice([\n    array_empty_str()\n  ], 0, 0)\n}\n\nfn array_empty_expr() -> Array[Expr] {\n  Array::slice([\n    EUnit\n  ], 0, 0)\n}\n\nfn idp_table_is_empty(table: (Array[String], Array[Array[String]], Array[Expr])) -> Bool {\n  let (names, _, _) = table\n  Array::length(names) == 0\n}\n\nfn idp_table_lookup(table: (Array[String], Array[Array[String]], Array[Expr]), qname: String) -> Int {\n  let (names, _, _) = table\n  let mut i = 0\n  let mut found = -1\n  while i < Array::length(names) {\n    if Array::get(names, i) == qname {\n      found = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// --- conservative bail-out guard.\n//\n// Inlining is only sound when EVERY perform matching this handle's\n// operations is actually reachable by this pass's own traversal. Two\n// things can hide one: (a) an `EFn`/nested `EHandle` (a perform inside\n// either might run later, dynamically, or is intercepted by a nearer\n// handler -- see the module doc comment), and (b) a call to anything\n// other than `perform` itself. (b) matters even with no lambda in sight:\n// `handle { f() } with Http { Fetch(_) => resume(...) } }` (exactly the\n// shape of every fixtures/effect_higher_order_*.vibe fixture) calls a\n// NAMED function `f` whose OWN body may perform Http::Fetch -- that\n// perform is not in `body`'s AST at all (it lives in f's separate\n// top-level definition), so this pass cannot see, let alone inline, it.\n// Treating \"no EFn/EHandle\" as sufficient to drop the wrapper would have\n// deleted the handler for that unseen perform entirely -- an unhandled\n// perform at runtime. Conservatively flagging every non-`perform` call as\n// unsafe avoids this, EXCEPT for the fixed pure-builtin allowlist below\n// (idp_is_pure_builtin_call) -- those are checker-verified effect-free and\n// take no closure argument, so they cannot hide a perform. Recognizing\n// calls to user functions whose declared row excludes this effect is a\n// larger follow-up (needs the row/signature info this untyped AST pass\n// does not have), not attempted here.\nfn idp_has_unsafe_construct(expr: Expr) -> Bool {\n  match expr {\n    EFn(_, _, _, _, _, _) => true,\n    EHandle(_, _) => true,\n    ELet(_, v, b, _) => idp_has_unsafe_construct(v) || idp_has_unsafe_construct(b),\n    ELetMut(_, v, b, _) => idp_has_unsafe_construct(v) || idp_has_unsafe_construct(b),\n    ELetRec(_, v, b) => idp_has_unsafe_construct(v) || idp_has_unsafe_construct(b),\n    ESeq(a, b) => idp_has_unsafe_construct(a) || idp_has_unsafe_construct(b),\n    EIf(c, t, e) => idp_has_unsafe_construct(c) || idp_has_unsafe_construct(t) || idp_has_unsafe_construct(e),\n    EMatch(s, arms) => idp_has_unsafe_construct(s) || idp_arms_have_unsafe_construct(arms),\n    EWhile(c, b) => idp_has_unsafe_construct(c) || idp_has_unsafe_construct(b),\n    EForIn(_, _, it, b) => idp_has_unsafe_construct(it) || idp_has_unsafe_construct(b),\n    ECall(callee, args, _) => match callee {\n      // `perform Effect::Op(args)` parses to `ECall(EIdent(\"perform\"),\n      // [ECall(EIdent(\"Effect::Op\"), args)])` (or `[EIdent(\"Effect::Op\")]`\n      // for a zero-arg op) -- the operation's own qualified name is NOT a\n      // \"call to something else\" in the unsafe sense, it is the operation\n      // being performed; only ITS OWN arguments need checking.\n      EIdent(nm, _) => if nm == \"perform\" && Array::length(args) == 1 {\n        idp_perform_operand_has_unsafe_construct(Array::get(args, 0))\n      } else if idp_is_pure_builtin_call(nm) {\n        idp_exprs_have_unsafe_construct(args)\n      } else {\n        idp_call_is_unsafe(callee) || idp_exprs_have_unsafe_construct(args)\n      },\n      _ => idp_call_is_unsafe(callee) || idp_exprs_have_unsafe_construct(args)\n    },\n    EBinOp(_, l, r) => idp_has_unsafe_construct(l) || idp_has_unsafe_construct(r),\n    EUnaryOp(_, e2) => idp_has_unsafe_construct(e2),\n    EAssign(_, v, c) => idp_has_unsafe_construct(v) || idp_has_unsafe_construct(c),\n    EAssignOp(_, _, v, c) => idp_has_unsafe_construct(v) || idp_has_unsafe_construct(c),\n    // Any `.field`/method-style access is conservatively unsafe too (could\n    // be a method dispatch with hidden effects by the time this runs).\n    EDot(_, _, _, _) => true,\n    ELabeledArg(_, _, v) => idp_has_unsafe_construct(v),\n    EReturn(e2) => idp_has_unsafe_construct(e2),\n    EBreak(opt) => match opt {\n      Some(e2) => idp_has_unsafe_construct(e2),\n      None => false\n    },\n    EContinue(args) => idp_exprs_have_unsafe_construct(args),\n    ETuple(elems) => idp_exprs_have_unsafe_construct(elems),\n    EArray(elems) => idp_exprs_have_unsafe_construct(elems),\n    ERecord(_, fields, _) => idp_fields_have_unsafe_construct(fields),\n    EMap(fields) => idp_fields_have_unsafe_construct(fields),\n    ESpread(e2) => idp_has_unsafe_construct(e2),\n    ELoop(pairs, b) => idp_pairs_have_unsafe_construct(pairs) || idp_has_unsafe_construct(b),\n    _ => false\n  }\n}\n\n// Only a direct call to the `perform` builtin is safe; a call to anything\n// else (a named top-level function, a parameter-bound closure, a computed\n// callee expression) may reach a perform this pass cannot see. (The\n// pure-builtin allowlist is checked separately, before this function is\n// ever reached -- see idp_is_pure_builtin_call's call site.)\nfn idp_call_is_unsafe(callee: Expr) -> Bool {\n  match callee {\n    EIdent(nm, _) => nm != \"perform\",\n    _ => true\n  }\n}\n\n// Phase 2b: a fixed, hand-audited set of builtin static-call names, each\n// individually checked (as of this change) against the checker's builtin\n// type table to have effect `None` (pure -- see checker/builtins_string1.\n// vibe, builtins_string2.vibe, builtins_misc.vibe) AND no function-typed\n// parameter (so it cannot invoke a user-supplied closure that might\n// perform). Deliberately NOT a prefix/namespace match: builtins_misc.vibe\n// mixes pure entries (Int::to_string, Char::to_int, ...) with impure ones\n// in the SAME file (`print`, `println`, `throw` -- `throw` in particular\n// is documented there as going through the Error effect, i.e. it IS a\n// perform in disguise), so only exact, individually-verified names belong\n// here. Extending this list requires re-checking the new name's entry in\n// those files, not just adding a plausible-looking string.\nfn idp_pure_builtin_names() -> Array[String] {\n  [\n    \"String::concat\", \"String::equals\", \"String::length\", \"String::substring\",\n    \"string_char_at\", \"String::trim\", \"String::split\", \"String::contains\",\n    \"String::index_of\", \"String::to_lower\", \"String::to_upper\",\n    \"String::ends_with\", \"String::starts_with\", \"String::char_code_at\",\n    \"String::last_index_of\", \"String::from_char_code\", \"String::join\",\n    \"Char::to_int\", \"Char::from_int\",\n    \"Int::to_double\", \"Int::to_float\", \"Int::to_string\",\n    \"Double::to_int\", \"Float::to_int\",\n    \"Double::to_string\", \"Float::to_string\",\n    \"Double::abs\", \"Double::floor\", \"Double::ceil\",\n    \"Double::max\", \"Double::min\",\n    \"Int::parse\", \"Double::parse\",\n    // #817 gc-backend follow-up (2026-07-23): `obj[i]` desugars to\n    // `__index(obj, i)` (desugar_trait_dict.vibe); `Array::get`/`Map::get`/\n    // `Bytes::get` are the same read operation spelled explicitly, and\n    // `Array::length`/`Map::size`/`Bytes::length` are the same class of\n    // pure, no-function-param builtin query. All seven are individually\n    // checker-verified pure (effect `None`, no function-typed parameter --\n    // checker/builtins_misc.vibe's lookup_index,\n    // builtins_array.vibe/builtins_map.vibe/builtins_bytes.vibe's own\n    // `*::get`/`*::length`/`Map::size` entries) and the `__index`/`*::get`\n    // subset is already treated as the same borrow-only-read equivalence\n    // class elsewhere in the compiler (perceus.vibe, common_analysis.vibe).\n    // Found missing via gc-backend coverage testing:\n    // `perform Logger::Log(items[i])` inside a `while i < Array::length\n    // (items) { ... }`-bodied needing function was sunk to ineligible\n    // purely because `items[i]`'s desugared `__index` call (and\n    // `Array::length`'s own call in the loop condition) weren't on this\n    // list, not because of anything about the perform itself.\n    \"__index\", \"Array::get\", \"Map::get\", \"Bytes::get\", \"Array::length\", \"Map::size\", \"Bytes::length\"\n  ]\n}\n\nfn idp_is_pure_builtin_call(nm: String) -> Bool {\n  let names = idp_pure_builtin_names()\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(names) {\n    if Array::get(names, i) == nm {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// `operand` is `perform`'s single argument -- the operation application\n// itself (`EIdent(qname)` for zero args, `ECall(EIdent(qname), op_args)`\n// otherwise). The qualified operation name is never itself an unsafe call\n// target; only the actual argument expressions need checking.\nfn idp_perform_operand_has_unsafe_construct(operand: Expr) -> Bool {\n  match operand {\n    EIdent(_, _) => false,\n    ECall(op_callee, op_args, _) => match op_callee {\n      EIdent(_, _) => idp_exprs_have_unsafe_construct(op_args),\n      _ => true\n    },\n    _ => true\n  }\n}\n\nfn idp_exprs_have_unsafe_construct(exprs: Array[Expr]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(exprs) {\n    if idp_has_unsafe_construct(Array::get(exprs, i)) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn idp_fields_have_unsafe_construct(fields: Array[(String, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    if idp_has_unsafe_construct(v) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn idp_pairs_have_unsafe_construct(pairs: Array[(String, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(pairs) {\n    let (_, v) = Array::get(pairs, i)\n    if idp_has_unsafe_construct(v) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn idp_arms_have_unsafe_construct(arms: Array[(Pat, Expr)]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    if idp_has_unsafe_construct(ex) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// --- per-arm preparation: bind names + tail resume(e) -> e.\n\nfn idp_pat_bind_names(pat: Pat) -> Array[String] {\n  match pat {\n    PCtor(_, subpats) => for p in subpats {\n      match p {\n        PBind(n) => n,\n        _ => \"_\"\n      }\n    },\n    _ => array_empty_str()\n  }\n}\n\nfn idp_pat_qname(pat: Pat) -> String {\n  match pat {\n    PCtor(name, _) => name,\n    _ => \"\"\n  }\n}\n\n// Replace every tail-position `resume(e)` with `e`. Mirrors #942's own\n// tail-position traversal (check_arm_resume_tail in checker.vibe) so the\n// two stay in lockstep: #942 already guarantees resume only ever appears\n// at exactly these tail slots, with nothing after it.\nfn idp_strip_tail_resume(expr: Expr) -> Expr {\n  match expr {\n    EIf(c, t, e) => EIf(c, idp_strip_tail_resume(t), idp_strip_tail_resume(e)),\n    EMatch(s, arms) => EMatch(s, idp_strip_tail_resume_arms(arms)),\n    ELet(n, v, b, off) => ELet(n, v, idp_strip_tail_resume(b), off),\n    ELetMut(n, v, b, off) => ELetMut(n, v, idp_strip_tail_resume(b), off),\n    ELetRec(n, v, b) => ELetRec(n, v, idp_strip_tail_resume(b)),\n    ESeq(a, b) => ESeq(a, idp_strip_tail_resume(b)),\n    EAssign(n, v, c) => EAssign(n, v, idp_strip_tail_resume(c)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, v, idp_strip_tail_resume(c)),\n    EReturn(e2) => EReturn(idp_strip_tail_resume(e2)),\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if nm == \"resume\" && Array::length(args) == 1 {\n        Array::get(args, 0)\n      } else {\n        expr\n      },\n      _ => expr\n    },\n    _ => expr\n  }\n}\n\nfn idp_strip_tail_resume_arms(arms: Array[(Pat, Expr)]) -> Array[(Pat, Expr)] {\n  for a in arms {\n    let (p, ex) = a\n    (p, idp_strip_tail_resume(ex))\n  }\n}\n\n// --- the main rewrite.\n\nfn idp_rewrite(expr: Expr, table: (Array[String], Array[Array[String]], Array[Expr])) -> Expr {\n  match expr {\n    EHandle(body, arms) => idp_rewrite_handle(body, arms, table),\n    EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, idp_rewrite(b, idp_empty_table())),\n    ELet(n, v, b, off) => ELet(n, idp_rewrite(v, table), idp_rewrite(b, table), off),\n    ELetMut(n, v, b, off) => ELetMut(n, idp_rewrite(v, table), idp_rewrite(b, table), off),\n    ELetRec(n, v, b) => ELetRec(n, idp_rewrite(v, table), idp_rewrite(b, table)),\n    ESeq(a, b) => ESeq(idp_rewrite(a, table), idp_rewrite(b, table)),\n    EIf(c, t, e) => EIf(idp_rewrite(c, table), idp_rewrite(t, table), idp_rewrite(e, table)),\n    EMatch(s, arms) => EMatch(idp_rewrite(s, table), idp_rewrite_arms(arms, table)),\n    EWhile(c, b) => EWhile(idp_rewrite(c, table), idp_rewrite(b, table)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, idp_rewrite(it, table), idp_rewrite(b, table)),\n    ECall(callee, args, off) => idp_rewrite_call(callee, args, off, table),\n    EBinOp(op, l, r) => EBinOp(op, idp_rewrite(l, table), idp_rewrite(r, table)),\n    EUnaryOp(op, e2) => EUnaryOp(op, idp_rewrite(e2, table)),\n    EAssign(n, v, c) => EAssign(n, idp_rewrite(v, table), idp_rewrite(c, table)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, idp_rewrite(v, table), idp_rewrite(c, table)),\n    EDot(o, f, off1, off2) => EDot(idp_rewrite(o, table), f, off1, off2),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, idp_rewrite(v, table)),\n    EReturn(e2) => EReturn(idp_rewrite(e2, table)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e2) => Some(idp_rewrite(e2, table)),\n      None => None\n    }),\n    EContinue(args) => EContinue(idp_rewrite_exprs(args, table)),\n    ETuple(elems) => ETuple(idp_rewrite_exprs(elems, table)),\n    EArray(elems) => EArray(idp_rewrite_exprs(elems, table)),\n    ERecord(n, fields, tas) => ERecord(n, idp_rewrite_fields(fields, table), tas),\n    EMap(fields) => EMap(idp_rewrite_fields(fields, table)),\n    ESpread(e2) => ESpread(idp_rewrite(e2, table)),\n    ELoop(pairs, b) => ELoop(idp_rewrite_pairs(pairs, table), idp_rewrite(b, table)),\n    _ => expr\n  }\n}\n\nfn idp_rewrite_exprs(exprs: Array[Expr], table: (Array[String], Array[Array[String]], Array[Expr])) -> Array[Expr] {\n  for e in exprs {\n    idp_rewrite(e, table)\n  }\n}\n\nfn idp_rewrite_fields(fields: Array[(String, Expr)], table: (Array[String], Array[Array[String]], Array[Expr])) -> Array[(String, Expr)] {\n  for f in fields {\n    let (n, v) = f\n    (n, idp_rewrite(v, table))\n  }\n}\n\nfn idp_rewrite_pairs(pairs: Array[(String, Expr)], table: (Array[String], Array[Array[String]], Array[Expr])) -> Array[(String, Expr)] {\n  for p in pairs {\n    let (n, v) = p\n    (n, idp_rewrite(v, table))\n  }\n}\n\nfn idp_rewrite_arms(arms: Array[(Pat, Expr)], table: (Array[String], Array[Array[String]], Array[Expr])) -> Array[(Pat, Expr)] {\n  for a in arms {\n    let (p, ex) = a\n    (p, idp_rewrite(ex, table))\n  }\n}\n\nfn idp_rewrite_handle(body: Expr, arms: Array[(Pat, Expr)], outer_table: (Array[String], Array[Array[String]], Array[Expr])) -> Expr {\n  if idp_has_unsafe_construct(body) {\n    // Conservative bail-out: leave this handle's own performs to the\n    // existing replay codegen. Still recurse into body/arms with a FRESH\n    // (empty) context -- any OTHER handle nested inside (which triggered\n    // this bail-out) gets its own independent chance to inline, and any\n    // stray perform for the now-inactive outer effect is simply left alone\n    // (matches ordinary lexical scoping: this pass never invents a target\n    // that codegen wouldn't otherwise resolve).\n    EHandle(idp_rewrite(body, idp_empty_table()), idp_rewrite_arms(arms, idp_empty_table()))\n  } else {\n    let op_names = for a in arms {\n      let (p, _) = a\n      idp_pat_qname(p)\n    }\n    let bind_names = for a in arms {\n      let (p, _) = a\n      idp_pat_bind_names(p)\n    }\n    let prepared_bodies = for a in arms {\n      let (_, ex) = a\n      idp_strip_tail_resume(idp_rewrite(ex, idp_empty_table()))\n    }\n    let table = (op_names, bind_names, prepared_bodies)\n    // No EFn/nested-handle boundary exists anywhere in `body`, so this\n    // rewrite is guaranteed to reach and inline every perform matching\n    // one of `arms` -- the result has none left, and the EHandle wrapper\n    // (and everything it would have compiled to: replay loop, per-effect\n    // reserved region, perform counter) can be dropped entirely.\n    idp_rewrite(body, table)\n  }\n}\n\nfn idp_rewrite_call(callee: Expr, args: Array[Expr], off: Int, table: (Array[String], Array[Array[String]], Array[Expr])) -> Expr {\n  match callee {\n    EIdent(nm, _) => if nm == \"perform\" && Array::length(args) == 1 && !idp_table_is_empty(table) {\n      idp_rewrite_perform(Array::get(args, 0), table)\n    } else {\n      ECall(idp_rewrite(callee, table), idp_rewrite_exprs(args, table), off)\n    },\n    _ => ECall(idp_rewrite(callee, table), idp_rewrite_exprs(args, table), off)\n  }\n}\n\n// `operand` is the perform's single argument: either `EIdent(qname)` for a\n// zero-arg operation, or `ECall(EIdent(qname), op_args)` for one with\n// arguments (see parser_expr_primary.vibe's parse_perform_primary).\nfn idp_rewrite_perform(operand: Expr, table: (Array[String], Array[Array[String]], Array[Expr])) -> Expr {\n  match operand {\n    EIdent(qname, _) => idp_splice_or_leave(qname, array_empty_expr(), operand, table),\n    ECall(op_callee, op_args, _) => match op_callee {\n      EIdent(qname, _) => idp_splice_or_leave(qname, idp_rewrite_exprs(op_args, table), operand, table),\n      _ => ECall(EIdent(\"perform\", -1), [\n        idp_rewrite(operand, table)\n      ], -1)\n    },\n    _ => ECall(EIdent(\"perform\", -1), [\n      idp_rewrite(operand, table)\n    ], -1)\n  }\n}\n\nfn idp_splice_or_leave(qname: String, actual_args: Array[Expr], original_operand: Expr, table: (Array[String], Array[Array[String]], Array[Expr])) -> Expr {\n  let idx = idp_table_lookup(table, qname)\n  if idx < 0 {\n    ECall(EIdent(\"perform\", -1), [\n      original_operand\n    ], -1)\n  } else {\n    let (_, bind_names_list, prepared_bodies) = table\n    let bind_names = Array::get(bind_names_list, idx)\n    let prepared_body = Array::get(prepared_bodies, idx)\n    idp_bind_args(bind_names, actual_args, prepared_body)\n  }\n}\n\n// `let bind_0 = actual_0; let bind_1 = actual_1; ...; prepared_body` --\n// evaluates every argument exactly once, in left-to-right order, before the\n// (already tail-resume-stripped) arm body runs, matching ordinary function\n// call-argument semantics.\nfn idp_bind_args(bind_names: Array[String], actual_args: Array[Expr], prepared_body: Expr) -> Expr {\n  let n = Array::length(bind_names)\n  let mut result = prepared_body\n  let mut i = n - 1\n  while i >= 0 {\n    if i < Array::length(actual_args) {\n      result = ELet(Array::get(bind_names, i), Array::get(actual_args, i), result, -1)\n    } else {\n      ()\n    }\n    i = i - 1\n  }\n  result\n}\n\n// ADR-0076 Phase 3 (evidence-passing effect handlers, #817), first slice\n// (docs/effect-evidence-passing.md \"追記 2\" hypothesis, 2026-07-22).\n//\n// Phase 2 (inline_direct_perform.vibe) only covers a `handle`'s BODY when\n// every `perform` for its operations is lexically reachable in that same\n// body -- a call to a named top-level function is an automatic bail-out,\n// because the callee's own perform (if any) lives in a different AST\n// location Phase 2's textual splice cannot see. That gap is a real,\n// currently-reproducible correctness bug, not just a missed optimization:\n// fixtures/effect_handle_call_evidence.vibe shows the SAME M2-style replay\n// corruption (a `let mut` counter incremented before two performs gets\n// double-counted) when the two performs are reached via a helper function\n// call instead of directly in the handle body.\n//\n// This pass covers the single narrowest case that closes that gap without\n// needing CPS/yield-bubbling (see the ADR's \"追記 2\" for why #942's\n// tail-resume-only-in-tail-position guarantee makes every handler arm\n// already tail-resumptive, so plain evidence-dict threading -- an ordinary\n// call/return, the same codegen shape as desugar_trait_dict.vibe's\n// dict-passing -- suffices; no new IR node or runtime continuation type is\n// introduced here):\n//\n//   - a top-level function `f` whose ENTIRE declared effect row is EXACTLY\n//     one user-defined effect name `E` (no row-variable, no other effect\n//     alongside it -- kept single-effect-only for this first slice so one\n//     function is never threaded for two different effects in the same\n//     pass, which would require reasoning about injection order);\n//   - every `perform E::Op(...)` anywhere in `f`'s own body (which, by the\n//     eligibility check below, cannot itself contain a nested closure,\n//     nested `handle`, or any call other than to `perform`/another such\n//     function/a pure builtin) is rewritten to call through an implicit\n//     \"evidence dict\" parameter prepended to `f`'s params -- a plain struct\n//     value with one field per operation of E, each field a closure built\n//     from a `handle`'s arm body (mirrors desugar_trait_dict.vibe's\n//     TrDict[T] exactly, just keyed by effect operation instead of trait\n//     method);\n//   - a `handle { BODY } with E { arms } }` whose only reason for failing\n//     Phase 2's stricter check is that BODY calls one or more such\n//     functions synthesizes the evidence dict from `arms` (same\n//     tail-resume-stripped arm bodies Phase 2 already knows how to\n//     prepare) and passes it at each such call, then drops the `EHandle`\n//     wrapper exactly as Phase 2 does -- no replay codegen is generated\n//     for it either.\n//\n// Soundness argument (why this cannot silently miscompile, only\n// under-optimize): a function is only ever added to the \"needing\" set when\n// its OWN declared row is EXACTLY `E` -- by the existing effect checker's\n// own soundness (checker/checker_effects.vibe's transitive perform-effect\n// check, unrelated to and unchanged by this pass), any `perform E::Op`\n// reachable from `f`'s body without crossing a nested `handle` for `E`\n// REQUIRES `f`'s declared row to already contain `E`; this pass never\n// invents authorization the checker did not already grant. The per-body\n// eligibility scan (edp_has_unsafe_construct) is the exact same\n// conservative bail-out shape as Phase 2's idp_has_unsafe_construct, with\n// the single addition that a call to a name in the already-computed\n// `needing` set is treated as safe (that callee's own body is itself\n// checked the same way before the whole migration for `E` is applied at\n// all). If ANY handle-for-`E` site or ANY needing-function body fails this\n// check, the ENTIRE migration for `E` is abandoned and every occurrence is\n// left completely untouched for the existing replay/Phase-2 codegen --\n// there is no partial or best-effort application. Effects with an empty\n// needing set (nothing to gain) or with any ineligible site are simply\n// left alone, matching today's behavior exactly.\n//\n// Not attempted here (left on replay, same as before this pass exists):\n// migrating a row VARIABLE itself (there is no concrete effect there to\n// migrate -- see edp_row_is_exactly's doc comment for why this is also\n// simply correct, not a limitation), and any effect for which even one\n// handle site or needing function fails the eligibility scan.\n//\n// A function whose row combines `E` with another concrete effect, OR with\n// an open row-variable tail (`with { Ask, e }`), IS attempted per-effect,\n// independently (`edp_row_is_exactly`'s row-containment match) -- each\n// effect in the row is eligibility-checked and migrated (or not) on its\n// own terms; see edp_row_is_exactly's doc comment for why this is sound\n// and the history of getting there for the concrete-effect-vs-concrete-\n// effect case. The row-variable-tail case was verified separately\n// (2026-07-23): `with { Ask, e }` migrates `Ask` too, exactly like any\n// other multi-effect row -- the row-variable token `e` simply never\n// matches any real declared effect name, so it's inert to this pass's own\n// matching logic. If the function body actually exercises whatever `e`\n// turns out to mean at a given call site (invoking a callback parameter\n// typed with that row, for instance), the pre-existing \"unrecognized\n// callee is unsafe\" rule in edp_has_unsafe_construct already rejects\n// that, independent of anything row-string-related.\n//\n// A handle site\n// (or needing function) whose own body is directly ANOTHER effect's\n// `EHandle` is ALSO no longer automatically excluded: edp_has_unsafe_\n// construct recurses into a nested handle for a DIFFERENT effect (its body\n// and arms) rather than rejecting it outright, so a directly-nested\n// `handle A { handle B {...} }` pair -- or the equivalent split across a\n// wrapper function -- can have BOTH effects migrate independently, not\n// just the innermost one; see that function's doc comment for the\n// `resume` recognition this needed and fixtures/effect_handle_multi_\n// effect_nested_handles.vibe for the regression lock. A call to a plain\n// user-defined function the checker has ALREADY proven pure (empty\n// declared row, `edp_pure_fn_names`) is ALSO safe now, not just the\n// hand-audited `edp_pure_builtin_names` allowlist -- see fixtures/\n// effect_handle_call_evidence_pure_helper.vibe. A bare `.field` READ\n// (`EDot`, not a call through it) is ALSO safe now -- see fixtures/\n// effect_handle_call_evidence_struct_field.vibe -- despite this pass\n// having no type information: only the object expression being read\n// from can hide anything unsafe, which the existing traversal already\n// answers soundly regardless of the field's static type. A closure\n// LITERAL's own body (`EFn`) is ALSO safe to look inside now -- see\n// fixtures/effect_handle_call_evidence_closure_literal.vibe -- covering\n// only the closure's DEFINITION: CALLING an arbitrary local closure\n// (`f()` where `f` is a local variable, not a top-level function name)\n// would still need real scope tracking this AST-level pass doesn't have\n// to recognize safely by name alone (risking the kind of shadowing\n// false-safety `pure_fns`/`needing`'s name-matching could ALSO in\n// principle hit -- see edp_pure_fn_names' considerations) -- EXCEPT this\n// turns out to already be a non-issue for the common, CAPTURE-FREE case:\n// #786 (\"hoist non-capturing effectful local lambdas to top-level\",\n// desugar_trait_dict.vibe) already lambda-lifts such a closure to a\n// fresh top-level binding BEFORE this pass ever runs, so by the time\n// edp_has_unsafe_construct sees the call site, it's already an ordinary\n// call to a genuine top-level function -- ALREADY handled correctly by\n// the existing needing-forwarding logic, no closure-specific code needed\n// here at all. Verified directly (2026-07-23) rather than assumed still\n// broken: see fixtures/effect_handle_call_evidence_local_closure_capture_\n// free.vibe. Only a local closure that ALSO captures an outer local (not\n// just the effect) remains excluded -- and not merely from this pass:\n// investigating this surfaced that the CAPTURING case independently hits\n// a pre-existing, deeper miscompilation bug in the closure+effect\n// combinator itself (invalid wasm at instantiation) that #786's own\n// landed fix explicitly declined to touch and that #786's own body had\n// already flagged as the harder, never-actually-fixed \"Layer 2\" of that\n// bug -- tracked separately as #1069, since it's a closure-codegen bug\n// independent of evidence_dict_pass, not something a row-migration pass\n// could paper over even in principle (the underlying replay path is\n// what's broken for that shape, migrated or not).\n//\n// A row spelled with an `effectset` alias (`with { AskAll }`) is ALSO\n// recognized now, at whatever granularity the alias expands to -- see\n// edp_row_is_exactly's doc comment for why the row string needed its own\n// local (re-)expansion here rather than trusting it was already expanded\n// by the time codegen sees it.\n//\n// (An earlier draft of this comment also listed \"a wrapper that merely\n// forwards to a needing function without itself declaring the effect\" as\n// a follow-up item -- verified, and removed, 2026-07-23: the checker\n// already rejects that program outright at compile time (\"effect row\n// mismatch ... missing { E } (no 'with' clause, requires { E })\"), so it\n// can never reach this pass at all. Not every item that sounds plausible\n// on paper turns out to be a real, reachable gap; this one wasn't either,\n// same lesson as the local-closure-invocation item above.)\n// Two phases, deliberately NOT interleaved (see edp_row_is_exactly's doc\n// comment, \"追記 8\", for the bug this avoids): first decide eligibility\n// for EVERY effect against the still-completely-unmutated `stmts`, then\n// apply every eligible migration in a separate pass afterward.\n//\n// Interleaving (decide effect A's eligibility, apply A's rewrite, decide\n// B's eligibility, apply B's rewrite, ...) was tried first and found\n// unsound for a function needing more than one effect: applying A's\n// rewrite introduces `EDot` nodes into that function's body (the\n// dict-field-access call an evidence-passed `perform` compiles to), and\n// `edp_has_unsafe_construct` treats every `EDot` as unconditionally\n// unsafe -- so B's eligibility check, re-scanning that SAME (now A-\n// mutated) body, would always see A's own rewrite as a disqualifying\n// construct and abort, even though nothing about the ORIGINAL program\n// was actually unsafe for B.\n//\n// Deciding all eligibility upfront sidesteps this entirely: by the time\n// ANY mutation happens, every effect's needing set, handle sites, and\n// eligibility verdict are already fixed facts about the original tree.\n// Applying migrations afterward is safe against each other's rewrites\n// because edp_apply_migration's actual rewrite step (edp_find_rewrite_\n// handles) always re-walks the CURRENT stmts fresh rather than trusting\n// a stale collected handle-site list, and edp_rewrite_needing_body only\n// pattern-matches specific ECall/EHandle shapes -- it already tolerates\n// (passes through unchanged) an EDot or an extra prepended argument left\n// by an earlier effect's migration, it just doesn't blanket-reject them\n// the way the eligibility check does.\n// `entry_name` (2026-07-23, gc-backend follow-up): a needing function can\n// become genuinely UNREACHABLE mid-pipeline -- e.g. dtpw_inline_trivial_wrappers\n// (desugar_trait_dict.vibe, #1070 narrow slice) rewrites `apply(inner)` into\n// `inner()`, leaving a trivial pass-through wrapper's own top-level `apply`\n// definition uncalled anywhere, yet `apply` still declares the migrated\n// effect in its row (it forwards an arbitrary closure argument's effect,\n// which this pass can never prove safe -- see edp_has_unsafe_construct's\n// \"call to a non-statically-known target\" rejection) and so used to sink\n// the WHOLE effect's eligibility to false, even though the offending\n// function can never actually run. `entry_name` lets edp_plan_migrations\n// reuse the SAME reachability engine `dce_stmts`/`dce_keep_flags`\n// (core/dce.vibe) already uses in production elsewhere in the compiler to\n// drop provably-dead needing functions from consideration before the\n// safety scan -- see edp_plan_migrations' doc comment for the full\n// analysis of why this is safe even if reachability is ever imprecise.\nexport fn evidence_dict_pass(stmts: Array[Stmt], entry_name: String) -> Unit {\n  let effect_defs = edp_collect_effect_defs(stmts)\n  let fn_defs = edp_collect_fn_defs(stmts)\n  let keep = dce_keep_flags(stmts, [entry_name])\n  let plans = edp_plan_migrations(stmts, effect_defs, fn_defs, keep)\n  let mut pi = 0\n  while pi < Array::length(plans) {\n    let (ename, ops, needing, handle_sites) = Array::get(plans, pi)\n    edp_apply_migration(stmts, ename, ops, needing, handle_sites, fn_defs)\n    pi = pi + 1\n  }\n}\n\n// Drop any `needing` name whose OWN top-level definition `keep` (from\n// `dce_keep_flags`, computed against the real entry point) marks\n// unreachable -- a needing function that can never actually run at runtime\n// can never need the evidence dict at runtime either, so excluding it from\n// `needing` changes nothing observable, REGARDLESS of whether its body\n// would otherwise have been judged \"safe\" by edp_has_unsafe_construct.\n//\n// Why this can never cause a silent miscompile even if `keep`'s\n// reachability analysis is ever imprecise: `keep` is used ONLY to shrink\n// `needing` here, never to delete anything from `stmts` (dce_stmts itself\n// is not called). If `keep` ever under-approximates unreachability (wrongly\n// calls something dead that's actually still called somewhere), the\n// excluded function's own body -- if it directly performs the migrated\n// effect -- is simply left un-rewritten. That still-literal `perform` node\n// then hits exactly the same fallback every genuinely-ineligible perform\n// already hits today: the linear backend's pre-existing replay codegen\n// (still correct, just not the fast evidence-dict path), or the gc\n// backend's pre-existing \"unsupported perform\" hard compile error (loud,\n// not silent). Both are the SAME failure modes this pass already produces\n// for any effect it declines to migrate -- this filter can only ever\n// recover eligibility that dead code would otherwise block, never regress\n// a case that worked before it existed.\nfn edp_drop_unreachable_needing(needing: Array[String], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], keep: Array[Bool]) -> Array[String] {\n  let out = array_empty()\n  let mut ni = 0\n  while ni < Array::length(needing) {\n    let nm = Array::get(needing, ni)\n    if edp_needing_name_reachable(nm, fn_defs, keep) {\n      Array::push(out, nm)\n    } else {\n      ()\n    }\n    ni = ni + 1\n  }\n  out\n}\n\n// Local copy of dlh_strip_tilde (desugar_trait_dict.vibe) -- see\n// edp_pat_binds' own doc comment just below for why this file keeps local\n// copies rather than adding new cross-file callers.\nfn edp_strip_tilde(n: String) -> String {\n  let ln = String::length(n)\n  if ln > 0 && n[ln - 1:ln] == \"~\" {\n    n[0:ln - 1]\n  } else {\n    n\n  }\n}\n\n// Local copy of a pattern's bound names (mirrors dlh_pat_binds in\n// desugar_trait_dict.vibe -- kept as a separate local copy rather than a\n// cross-file import to avoid the bootstrap flatten gotcha documented\n// elsewhere in this file: a brand-new cross-file export + its first\n// cross-file caller in the SAME commit gets silently dropped by the\n// merge/flatten tool).\nfn edp_pat_binds(p: Pat, out: Array[String]) -> Unit {\n  match p {\n    PBind(n) => Array::push(out, n),\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        edp_pat_binds(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    PTuple(ps) => {\n      let mut i = 0\n      while i < Array::length(ps) {\n        edp_pat_binds(Array::get(ps, i), out)\n        i = i + 1\n      }\n    },\n    POr(a, b) => {\n      edp_pat_binds(a, out)\n      edp_pat_binds(b, out)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        edp_pat_binds(fp, out)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\n// Does `expr` bind (shadow) `name` anywhere within it? Full-coverage\n// traversal mirroring edp_rewrite_needing_body's own node coverage, plus\n// match/handle arm pattern binders (which edp_rewrite_needing_body itself\n// doesn't need to examine, but shadow detection does). See\n// edp_drop_shadowed_needing's own doc comment for why this exists.\nfn edp_expr_binds_name(expr: Expr, name: String) -> Bool {\n  match expr {\n    EFn(_, _, params, _, _, body) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) && !found {\n        let (pn, _) = Array::get(params, i)\n        if edp_strip_tilde(pn) == name {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found || edp_expr_binds_name(body, name)\n    },\n    EHandle(body, arms) => {\n      let mut i = 0\n      let mut found = edp_expr_binds_name(body, name)\n      while i < Array::length(arms) && !found {\n        let (p, ex) = Array::get(arms, i)\n        let bound = array_empty()\n        edp_pat_binds(p, bound)\n        if edp_str_array_contains(bound, name) || edp_expr_binds_name(ex, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EIf(c, t, e2) => edp_expr_binds_name(c, name) || edp_expr_binds_name(t, name) || edp_expr_binds_name(e2, name),\n    EMatch(s, arms) => {\n      let mut i = 0\n      let mut found = edp_expr_binds_name(s, name)\n      while i < Array::length(arms) && !found {\n        let (p, ex) = Array::get(arms, i)\n        let bound = array_empty()\n        edp_pat_binds(p, bound)\n        if edp_str_array_contains(bound, name) || edp_expr_binds_name(ex, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EWhile(c, b) => edp_expr_binds_name(c, name) || edp_expr_binds_name(b, name),\n    EForIn(n, idx, it, b) => {\n      let idx_hit = match idx {\n        Some(i2) => i2 == name,\n        None => false\n      }\n      n == name || idx_hit || edp_expr_binds_name(it, name) || edp_expr_binds_name(b, name)\n    },\n    ELoop(pairs, b) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(pairs) && !found {\n        let (n, v) = Array::get(pairs, i)\n        if n == name || edp_expr_binds_name(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found || edp_expr_binds_name(b, name)\n    },\n    ELet(n, v, b, _) => n == name || edp_expr_binds_name(v, name) || edp_expr_binds_name(b, name),\n    ELetMut(n, v, b, _) => n == name || edp_expr_binds_name(v, name) || edp_expr_binds_name(b, name),\n    ELetRec(n, v, b) => n == name || edp_expr_binds_name(v, name) || edp_expr_binds_name(b, name),\n    ESeq(a, b) => edp_expr_binds_name(a, name) || edp_expr_binds_name(b, name),\n    EAssign(_, v, c) => edp_expr_binds_name(v, name) || edp_expr_binds_name(c, name),\n    EAssignOp(_, _, v, c) => edp_expr_binds_name(v, name) || edp_expr_binds_name(c, name),\n    EReturn(e2) => edp_expr_binds_name(e2, name),\n    EDot(o, _, _, _) => edp_expr_binds_name(o, name),\n    ECall(callee, args, _) => edp_expr_binds_name(callee, name) || edp_exprs_bind_name(args, name),\n    EBinOp(_, l, r) => edp_expr_binds_name(l, name) || edp_expr_binds_name(r, name),\n    EUnaryOp(_, e2) => edp_expr_binds_name(e2, name),\n    ELabeledArg(_, _, v) => edp_expr_binds_name(v, name),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_expr_binds_name(e2, name),\n      None => false\n    },\n    EContinue(args) => edp_exprs_bind_name(args, name),\n    ETuple(elems) => edp_exprs_bind_name(elems, name),\n    EArray(elems) => edp_exprs_bind_name(elems, name),\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) && !found {\n        let (_, v) = Array::get(fields, i)\n        if edp_expr_binds_name(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) && !found {\n        let (_, v) = Array::get(fields, i)\n        if edp_expr_binds_name(v, name) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ESpread(e2) => edp_expr_binds_name(e2, name),\n    _ => false\n  }\n}\n\nfn edp_exprs_bind_name(es: Array[Expr], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(es) && !found {\n    if edp_expr_binds_name(Array::get(es, i), name) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// Drop any `needing` name that's shadowed ANYWHERE in the program (any\n// nested `let`/`let mut`/`let rec`, EFn parameter, match/handle arm\n// pattern binder, for-loop name, or loop parameter reusing the same\n// identifier as a top-level \"needing\" function). edp_rewrite_needing_body\n// matches a call's callee by NAME ONLY (`edp_str_array_contains(needing,\n// nm)`, line ~1952) with no scope tracking -- a local binding that\n// shadows a needing function's name would get the evidence-dict argument\n// prepended to ITS calls too, even though the local closure/value was\n// never rewritten to accept that extra parameter, producing an arity\n// mismatch / invalid generated call (#1074 PR review,\n// chatgpt-codex-connector P1: \"Respect local shadowing when forwarding\n// evidence\"). Deliberately whole-program-conservative rather than\n// precisely scope-threaded, matching edp_drop_self_discharging_needing's\n// own established pattern immediately below: losing eligibility for the\n// rare needing function whose name is ALSO reused as a shadowing binder\n// elsewhere is an acceptable trade for guaranteed correctness.\nfn edp_drop_shadowed_needing(needing: Array[String], stmts: Array[Stmt]) -> Array[String] {\n  let out = array_empty()\n  let mut ni = 0\n  while ni < Array::length(needing) {\n    let nm = Array::get(needing, ni)\n    let mut shadowed = false\n    let mut si = 0\n    while si < Array::length(stmts) && !shadowed {\n      match Array::get(stmts, si) {\n        SLet(_, _, _, _, sv) => if edp_expr_binds_name(sv, nm) {\n          shadowed = true\n        } else {\n          ()\n        },\n        _ => ()\n      }\n      si = si + 1\n    }\n    if shadowed {\n      ()\n    } else {\n      Array::push(out, nm)\n    }\n    ni = ni + 1\n  }\n  out\n}\n\n// Drop any `needing` name whose OWN entire body is BARE `handle {..} with\n// ename {..}` -- e.g. `fixtures/effect_effectset_expansion.vibe`'s `main`,\n// declared `with { Ask, Ask::Get }` purely to satisfy a checker requirement\n// unrelated to evidence_dict_pass (\"a `handle ... with Effect` expression's\n// enclosing declared row must authorize the whole effect name\" -- see that\n// fixture's own doc comment), whose body never performs `ename` OUTSIDE the\n// handle it already fully discharges. `edp_needing_names` has no way to see\n// that distinction (it only reads the row string), so such a function was\n// always included in `needing`; `edp_has_unsafe_construct`, entirely\n// correctly for the GENERAL case, then flags a same-effect `EHandle` as\n// unsafe (\"nested handling of the SAME effect inside itself is not a shape\n// this pass targets\" -- see its own doc comment) -- but here that \"nested\"\n// handle IS the function's own whole body, not something hidden inside a\n// call chain this pass can't already see. It is ALREADY discovered and\n// rewritten independently via edp_collect_handle_sites/edp_find_rewrite_\n// handles (which scan every EHandle for `ename` in `stmts` directly, not\n// through `needing`), so dropping such a function from `needing` loses\n// nothing -- it never needed the dict passed to IT (nothing in its body\n// can observably require one once its own handle is excluded from\n// consideration), it only ever PROVIDES one for its own nested call(s).\n//\n// Deliberately narrow: only the exact bare-EHandle-as-whole-body shape\n// qualifies (no ESeq prefix, no wrapping ELet, etc.) -- anything else keeps\n// the function in `needing` and falls back to the existing (already sound)\n// conservative treatment, exactly as before this change existed.\nfn edp_drop_self_discharging_needing(needing: Array[String], stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String) -> Array[String] {\n  let out = array_empty()\n  let mut ni = 0\n  while ni < Array::length(needing) {\n    let nm = Array::get(needing, ni)\n    let drop = match edp_find_fn_body(stmts, fn_defs, nm) {\n      Some(body) => edp_body_is_bare_self_discharge(body, ename),\n      None => false\n    }\n    if drop {\n      ()\n    } else {\n      Array::push(out, nm)\n    }\n    ni = ni + 1\n  }\n  out\n}\n\nfn edp_body_is_bare_self_discharge(body: Expr, ename: String) -> Bool {\n  match body {\n    EHandle(_, arms) => edp_handle_matches_effect(arms, ename),\n    _ => false\n  }\n}\n\nfn edp_needing_name_reachable(name: String, fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], keep: Array[Bool]) -> Bool {\n  let mut fi = 0\n  let mut result = true\n  let mut found = false\n  while fi < Array::length(fn_defs) {\n    let (idx, _, _, nm, _, _) = Array::get(fn_defs, fi)\n    if nm == name && !found {\n      found = true\n      result = if idx >= 0 && idx < Array::length(keep) {\n        Array::get(keep, idx)\n      } else {\n        true\n      }\n    } else {\n      ()\n    }\n    fi = fi + 1\n  }\n  result\n}\n\n// Decide eligibility for every effect against `stmts` as it is RIGHT NOW\n// (the caller must not have mutated anything yet) and return the plans\n// for the effects that qualify, in effect-declaration order.\n//\n// `keep` (2026-07-23): per-stmt-index reachable flags from `dce_keep_flags`\n// (core/dce.vibe), computed by the caller against the SAME `entry_name` the\n// real compile uses. Before the safety scan below, `needing` is filtered\n// down to only the names `keep` marks reachable -- see\n// edp_drop_unreachable_needing's doc comment for why dropping a provably-\n// dead needing function can never cause a silent miscompile, only recover\n// eligibility that a dead function's un-provable body would otherwise sink\n// for the whole effect.\nfn edp_plan_migrations(stmts: Array[Stmt], effect_defs: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], keep: Array[Bool]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)], Array[String], Array[(Expr, Array[(Pat, Expr)])])] {\n  let es_names = array_empty()\n  let es_members_list = array_empty()\n  edp_es_collect_into(stmts, es_names, es_members_list)\n  let plans = array_empty()\n  let mut ei = 0\n  while ei < Array::length(effect_defs) {\n    let (ename, ops) = Array::get(effect_defs, ei)\n    let needing_all = edp_needing_names(fn_defs, ename, es_names, es_members_list)\n    // Shadowed-name exclusion is ALSO unconditional (#1074 review: a\n    // needing function's name shadowed by a local binding elsewhere in\n    // the program is never safe to leave in `needing` regardless of\n    // dead-code/self-discharge status -- see edp_drop_shadowed_needing's\n    // own doc comment), so it applies before the self-discharging filter.\n    let needing_unshadowed = edp_drop_shadowed_needing(needing_all, stmts)\n    // Self-discharging exclusion is unconditional (a self-discharging\n    // function never needs the dict for itself, dead or not -- see\n    // edp_drop_self_discharging_needing's doc comment), so it applies to\n    // the FULL set before either eligibility attempt below.\n    let needing_full = edp_drop_self_discharging_needing(needing_unshadowed, stmts, fn_defs, ename)\n    match edp_try_plan_for_effect(stmts, ename, ops, needing_full, fn_defs) {\n      Some(plan) => Array::push(plans, plan),\n      None => {\n        // Fall back to dropping provably-DEAD needing functions and retry\n        // ONLY if the full set was ineligible -- trying the full set FIRST\n        // (rather than always dropping dead functions up front) matters:\n        // an independently-safe dead function (e.g. a hoisted closure\n        // whose own body is a bare `perform`, dlh_hoist_expr's row-\n        // backfill fix, 2026-07-23) should stay in `needing` and get\n        // properly migrated like any other safe function -- gc backend\n        // codegen still has to compile it even though it never runs, and\n        // a dead-but-still-present un-rewritten `perform` is exactly as\n        // fatal there as a live one. Dropping dead functions is only a\n        // NET WIN when the full set fails for some OTHER (unsafe, not\n        // dead) member -- see edp_drop_unreachable_needing's doc comment\n        // for why dropping in that case is always safe.\n        let needing_live = edp_drop_unreachable_needing(needing_full, fn_defs, keep)\n        if Array::length(needing_live) == Array::length(needing_full) {\n          ()\n        } else {\n          match edp_try_plan_for_effect(stmts, ename, ops, needing_live, fn_defs) {\n            Some(plan2) => Array::push(plans, plan2),\n            None => ()\n          }\n        }\n      }\n    }\n    ei = ei + 1\n  }\n  plans\n}\n\n// Attempt eligibility for `needing` (already effect-set/self-discharge\n// filtered by the caller) against `stmts` as-is; `Some` iff every needing\n// function AND every handle site is safe.\nfn edp_try_plan_for_effect(stmts: Array[Stmt], ename: String, ops: Array[(String, Array[TypeExpr], TypeExpr)], needing: Array[String], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Option[(String, Array[(String, Array[TypeExpr], TypeExpr)], Array[String], Array[(Expr, Array[(Pat, Expr)])])] {\n  if Array::length(needing) == 0 {\n    None\n  } else {\n    let handle_sites = edp_collect_handle_sites(stmts, ename)\n    if edp_all_sites_eligible(stmts, ename, needing, handle_sites, fn_defs) {\n      Some((ename, ops, needing, handle_sites))\n    } else {\n      None\n    }\n  }\n}\n\n// --- effectset-aware row resolution.\n//\n// A needing function's row string (EFn's own `eff` slot, taken verbatim by\n// edp_collect_fn_defs) can be spelled with an `effectset` alias --\n// `with { AskAll }` where `effectset AskAll = { Ask }` -- instead of the\n// bare effect name. checker_stmt.vibe's own effectset-expansion\n// (es_expand_stmts_effect_rows) deliberately runs on a NON-mutating COPY of\n// `stmts` used only for type-checking (see check_program's comment: \"codegen\n// never reads the row's text content\") -- the EFn node codegen actually\n// receives keeps the alias UNEXPANDED. That comment's premise no longer\n// holds now that evidence_dict_pass reads row text directly: without this,\n// `AskAll`-declared functions were silently excluded from migration even in\n// the simplest case (an effectset that's just a whole-effect alias),\n// invisibly falling back to the pre-existing replay codegen -- found by\n// writing a small effectset fixture and confirming, via a temporary\n// migration-plan probe, that no plan was produced for it at all, THEN\n// tracing why (edp_needing_names' string match against the still-literal\n// \"AskAll\" label never matches a bare \"Ask\" query) rather than assuming.\n//\n// Fixed the same way wit_gen.vibe/contract.vibe/checker_stmt.vibe each\n// already fix the identical problem for their own consumers: a small LOCAL\n// copy of the ES-table/cycle-safe-expansion shape (no new cross-file\n// reference -- see docs/effectset.md's bootstrap gotcha), re-run here on\n// `stmts` as evidence_dict_pass actually receives them. Resolving down to\n// EFFECT-name granularity (not operation-level) is enough for this pass's\n// purposes even for an operation-level effectset (`effectset Env::Read = {\n// Env::get, ...}`): the dict struct this pass builds always has one field\n// per operation the EFFECT declares (edp_make_dict_struct_stmt, from\n// effect_defs) and a handle site's arms already provide real closures for\n// every operation regardless of which subset a caller's row happened to\n// mention, so \"does this row require effect X at all\" is exactly the\n// question edp_needing_names needs answered, whether the original\n// declaration enumerated operations, named an effectset, or wrote the bare\n// effect name.\nfn edp_es_collect_into(stmts: Array[Stmt], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectSet(_, esname, esmembers) => {\n        Array::push(es_names, esname)\n        Array::push(es_members_list, esmembers)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn edp_es_expand_into(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String], out: Array[String]) -> Unit {\n  if edp_str_array_contains(path, name) {\n    ()\n  } else {\n    let idx = edp_str_array_index_of(es_names, name)\n    if idx < 0 {\n      if edp_str_array_contains(out, name) {\n        ()\n      } else {\n        Array::push(out, name)\n      }\n    } else {\n      Array::push(path, name)\n      let members = Array::get(es_members_list, idx)\n      let mut mi = 0\n      while mi < Array::length(members) {\n        edp_es_expand_into(es_names, es_members_list, Array::get(members, mi), path, out)\n        mi = mi + 1\n      }\n      Array::truncate(path, Array::length(path) - 1)\n    }\n  }\n}\n\n// Strip a qualified operation label (`Ask::Get`) down to its effect prefix\n// (`Ask`); a bare label (already an effect name, or a row-variable label\n// this pass doesn't recognize either way) passes through unchanged.\nfn edp_effect_name_of(label: String) -> String {\n  let idx = String::index_of(label, \"::\")\n  if idx > 0 {\n    String::substring(label, 0, idx)\n  } else {\n    label\n  }\n}\n\n// Resolve one raw row-item label to the underlying effect NAME(s) it\n// requires: expand it first if it's a known effectset (pushing each\n// expanded leaf's effect prefix), or just push its own effect prefix\n// directly otherwise. Appends into `out` (deduped by the caller).\nfn edp_resolve_effect_names_into(label: String, es_names: Array[String], es_members_list: Array[Array[String]], out: Array[String]) -> Unit {\n  if edp_str_array_contains(es_names, label) {\n    let leaves = array_empty()\n    edp_es_expand_into(es_names, es_members_list, label, array_empty(), leaves)\n    let mut li = 0\n    while li < Array::length(leaves) {\n      let ename = edp_effect_name_of(Array::get(leaves, li))\n      if edp_str_array_contains(out, ename) {\n        ()\n      } else {\n        Array::push(out, ename)\n      }\n      li = li + 1\n    }\n  } else {\n    let ename = edp_effect_name_of(label)\n    if edp_str_array_contains(out, ename) {\n      ()\n    } else {\n      Array::push(out, ename)\n    }\n  }\n}\n\nfn edp_str_array_index_of(arr: Array[String], v: String) -> Int {\n  let mut i = 0\n  let mut found = -1\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == v {\n      found = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// --- collection.\n\nfn edp_collect_effect_defs(stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEffectDef(_, name, _, ops) => Array::push(out, (name, ops)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// (stmt index, exported, is_rec, name, top-level type annotation, declared\n// effect row string (\"\" for none) -- taken directly from the EFn's own\n// `eff` slot, the same field #942/the checker already validate).\nfn edp_collect_fn_defs(stmts: Array[Stmt]) -> Array[(Int, Bool, Bool, String, Option[TypeExpr], String)] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, is_rec, name, ty, expr) => match expr {\n        EFn(_, _, _, _, eff, _) => {\n          let row = match eff {\n            Some(s) => s,\n            None => \"\"\n          }\n          Array::push(out, (i, exported, is_rec, name, ty, row))\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// Row CONTAINMENT: a function whose row is several comma-joined effect\n// names (e.g. \"Ask, Fs\") qualifies for EACH effect's migration\n// independently, alongside a bare exact-match row. A row-variable label is\n// still excluded (containment only matches literal effect names present in\n// the row string).\n//\n// This relaxation was tried and reverted TWICE on 2026-07-23 before being\n// shipped for real: both rounds crashed on\n// fixtures/effect_handle_multi_effect_row_fallback.vibe with an uncaught\n// exception, and two rounds of code-reading-only diagnosis (an EDot\n// artifact from one effect's own rewrite tripping a later effect's\n// eligibility re-scan; a needing function's body being directly another\n// effect's own `EHandle`) both turned out to be real but NOT the actual\n// cause once retested. Runtime instrumentation (temporarily exporting\n// every per-effect wasm exception tag by name, so an uncaught exception's\n// tag could be decoded from outside the module) finally isolated the true\n// cause: it had nothing to do with multi-effect rows at all.\n// edp_rewrite_needing_body's traversal was missing several positions\n// edp_has_unsafe_construct (its own eligibility check) already covered --\n// most simply, a `perform` bound via `let` rather than written as a bare\n// tail expression -- so a migrated function's own perform could pass\n// eligibility but be silently left un-rewritten, orphaning it once the\n// migration also dropped its handle site's `EHandle`. That bug (fixed\n// separately, see edp_rewrite_needing_body's doc comment) is what both\n// crashes actually were; `both_helper` in the multi-effect fixture happens\n// to bind both of its performs via `let`, so containment relaxation merely\n// exercised it via a different code path than the single-effect fixtures\n// that found and fixed it directly.\n//\n// With that fixed, re-testing the SAME multi-effect fixture under\n// containment (2026-07-23, round 3) -- confirmed via a temporary\n// migration-plan probe that `Ask`'s plan really is produced and applied,\n// not merely \"coincidentally not crashing\" -- compiles, self-hosts\n// (stage2==stage3), and runs to the SAME stable value the pre-Phase-3\n// replay fallback already produced (3018): `both_helper` needs `{Ask,\n// Fs}`; `Ask`'s migration succeeds (its only needing function and handle\n// site are both clean); `Fs`'s is correctly rejected on its own terms\n// because `ask_only_wrapper` (needing `Fs`) has a body that is directly\n// `handle {...} with Ask {...}` -- a genuine, deliberate\n// `edp_has_unsafe_construct` rejection (nested EHandle), independent of\n// this bug and independent of containment. `Ask` migrating to evidence-\n// dict while `Fs` stays on replay is safe: the two effects use disjoint\n// per-tag memory regions and neither codegen path depends on the other's\n// presence, so a needing function may freely have SOME of its performs\n// migrated and others still raw (edp_qname_is_for_effect already ensures\n// `edp_rewrite_needing_body` only ever touches performs for the effect\n// currently being migrated).\n//\n// Follow-up (2026-07-23, same day): the directly-nested-handle scope\n// boundary noted above (\"only the innermost effect of a nested handle\n// pair can migrate\") is now also resolved -- edp_has_unsafe_construct\n// recurses into a nested EHandle for a DIFFERENT effect instead of\n// rejecting it outright, so BOTH effects of a `handle ... with A { handle\n// ... with B {...} }` nest (or the equivalent wrapper-function split this\n// fixture's own `ask_only_wrapper` uses) can migrate independently. See\n// edp_has_unsafe_construct's doc comment for that change, and fixtures/\n// effect_handle_multi_effect_nested_handles.vibe for a minimal regression\n// lock without the wrapper-function indirection. This fixture\n// (effect_handle_multi_effect_row_fallback.vibe) was updated accordingly:\n// `Fs` now migrates too (verified via the same migration-plan-probe\n// technique, not just \"doesn't crash\"), and its pinned value changed from\n// 3018 (the replay-inflated value, `Fs`'s handler body replaying an extra\n// time each pass) to 2017 (the semantically-ideal value once neither\n// effect duplicates any surrounding side effect) -- itself confirming\n// this is a genuine correctness improvement, not merely broader coverage.\n// Effectset-aware: `row` is comma-split, each item resolved to its\n// underlying effect name(s) via edp_resolve_effect_names_into (a no-op\n// pass-through for an already-bare effect name -- see that function's doc\n// comment, and edp_es_collect_into's for why this needs its own effectset\n// tables rather than trusting the row string to already be expanded).\n// `ename` qualifies if it appears in ANY item's resolved set.\nfn edp_row_is_exactly(row: String, ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {\n  if row == ename {\n    true\n  } else {\n    let parts = String::split(row, \",\")\n    let mut i = 0\n    let mut found = false\n    while i < Array::length(parts) {\n      let label = String::trim(Array::get(parts, i))\n      let resolved = array_empty()\n      edp_resolve_effect_names_into(label, es_names, es_members_list, resolved)\n      if edp_str_array_contains(resolved, ename) {\n        found = true\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    found\n  }\n}\n\nfn edp_needing_names(fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(fn_defs) {\n    let (_, _, _, name, _, row) = Array::get(fn_defs, i)\n    if edp_row_is_exactly(row, ename, es_names, es_members_list) {\n      Array::push(out, name)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn edp_str_array_contains(arr: Array[String], v: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == v {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// --- naming.\n\nfn edp_dict_struct_name(ename: String) -> String {\n  String::concat(\"__EvDict_\", ename)\n}\n\nfn edp_dict_param_name(ename: String) -> String {\n  String::concat(\"__ev_\", ename)\n}\n\nfn edp_strip_effect_prefix(qname: String, ename: String) -> String {\n  let prefix = String::concat(ename, \"::\")\n  let plen = String::length(prefix)\n  if String::length(qname) > plen && String::substring(qname, 0, plen) == prefix {\n    String::substring(qname, plen, String::length(qname))\n  } else {\n    qname\n  }\n}\n\nfn edp_struct_decl_exists(stmts: Array[Stmt], sname: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, n, _, _, _, _) => if n == sname {\n        found = true\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn edp_make_dict_struct_stmt(ename: String, ops: Array[(String, Array[TypeExpr], TypeExpr)]) -> Stmt {\n  let fields = array_empty()\n  let mut i = 0\n  while i < Array::length(ops) {\n    let (opname, params, ret) = Array::get(ops, i)\n    Array::push(fields, (opname, TyFn(params, ret, None)))\n    i = i + 1\n  }\n  SStruct(false, edp_dict_struct_name(ename), fields, empty_str_array(), empty_str_array(), empty_str_array())\n}\n\nfn empty_str_array() -> Array[String] {\n  array_empty()\n}\n\n// --- eligibility: the same conservative-bail-out shape as\n// inline_direct_perform.vibe's idp_has_unsafe_construct, plus several\n// relaxations: a call to a name in `needing` is safe (that callee's own\n// body is scanned the same way as part of this same migration attempt); a\n// nested `EHandle` for a DIFFERENT effect than the one currently being\n// checked (`ename`) is safe to look inside rather than an automatic\n// rejection; and a call to a function the checker has ALREADY proven pure\n// (`pure_fns`, see edp_pure_fn_names) is safe regardless of whether it\n// happens to be hand-listed as a builtin -- see below.\n//\n// Branching constructs (EIf/EMatch/EWhile/EForIn/ELoop) ARE recursed into\n// (not unconditionally unsafe): a needing-function call nested inside one\n// used to compile to invalid wasm, but that was root-caused (docs/effect-\n// evidence-passing.md \"追記 6\") to a since-fixed handle-site rewrite bug\n// (edp_find_rewrite_handles replaced the old collect-then-re-find-by-\n// equality design that silently failed to re-locate branching handle\n// bodies), not anything inherent to branching itself -- see\n// fixtures/effect_handle_call_evidence_branch.vibe for the regression lock\n// on branching being genuinely safe now.\n//\n// `EHandle(body, arms)` for effect `ename` itself stays unconditionally\n// unsafe (nested handling of the SAME effect inside itself is not a shape\n// this pass targets). A NESTED handle for a DIFFERENT effect, though, is\n// exactly the \"wrapper function discharges one effect, caller discharges\n// another\" and \"directly-nested `handle A { handle B {...} }`\" shapes --\n// recursing into its body (and treating a `resume(...)` call in its own\n// arms as safe, mirroring the \"perform\"/needing-call special cases; a\n// handler arm's plain `resume` cannot itself hide anything unsafe for a\n// DIFFERENT effect's migration) lets both shapes become eligible. See\n// edp_row_is_exactly's doc comment for the history of the wrapper-function\n// shape; this is the natural follow-up covering direct nesting too.\n//\n// A call to a function whose OWN declared effect row is checker-verified\n// empty (`pure_fns`) is safe without even recursing into ITS body: by the\n// checker's own soundness (#942, the same guarantee edp_collect_fn_defs's\n// doc comment cites for the row string itself) a function with no `with`\n// clause cannot perform ANY effect, ever, so it cannot possibly hide a\n// perform of `ename`, a call to a needing function, or anything else this\n// pass would need to rewrite -- generalizing the old hand-audited\n// `edp_pure_builtin_names` allowlist (kept as-is for the handful of\n// builtins the checker doesn't track as ordinary functions) to every\n// user-defined pure function too. Only the call's OWN ARGS still need\n// checking (they're evaluated in the CALLER's context, where a perform of\n// `ename` or a needing-call could legitimately appear).\n//\n// edp_rewrite_needing_body/edp_rewrite_handle_body mirror the EHandle/\n// needing-call traversal exactly (see their own doc comments for why the\n// two must always agree, per \"追記 10\") -- a call to a `pure_fns` member\n// needs NO corresponding rewrite-side change, since it already falls\n// through those functions' existing \"recurse into args, leave the call\n// itself unchanged\" default case, which is exactly correct here too.\n//\n// `EDot(obj, field, ..)` -- a plain `.field` read, NOT a call through it\n// (calling through a field is `ECall(EDot(..), args)`, which the ECall\n// case above still rejects via its `_ => true` fallback for any callee\n// shape besides a bare `EIdent`) -- is safe to recurse into `obj` for\n// rather than reject outright. Unlike the `needing`/`pure_fns` checks,\n// this needs NO type information and carries NO name-shadowing risk: it\n// isn't a name lookup at all, just \"does the object expression being\n// read from hide anything unsafe\", which the recursive traversal already\n// answers soundly for any `obj` shape. The field name itself is a bare\n// string, not a sub-expression, so there's nothing else to check.\n// edp_rewrite_needing_body/edp_rewrite_handle_body gained a matching\n// `EDot` case (recursing into `obj`, leaving the field name untouched)\n// for the same \"the two traversals must agree\" reason as everywhere else\n// in this function.\n//\n// `EFn(.., body)` -- a closure LITERAL -- now recurses into its own body\n// with the exact same check, instead of being unconditionally unsafe.\n// This is sound for the same structural reason as everywhere else in\n// this function: if the closure's body, scanned by this SAME recursive\n// traversal, contains nothing this pass doesn't already know how to\n// classify (a `perform` of `ename`, a call to a `needing`/`pure_fns`\n// member, or any of the other already-recognized safe shapes), then\n// whatever the closure eventually does when invoked -- once, many times,\n// stored and called later, whatever -- is exactly as well-understood as\n// any other code this pass already rewrites; nothing about closures\n// specifically weakens that. A `perform ename::Op` found inside the\n// closure's body IS rewritten (edp_rewrite_needing_body/edp_rewrite_\n// handle_body gained a matching `EFn` case, recursing into the body the\n// same way), using the closure's LEXICALLY CAPTURED `dict_pname` from\n// its enclosing scope -- an ordinary captured variable reference, no\n// different from any other value a closure captures, valid for as long\n// as the closure itself is (standard closure-capture semantics, entirely\n// orthogonal to anything effect-handling-specific). The closure's own\n// declared effect row (if any) is not consulted here; it's the type\n// checker's own bookkeeping, unrelated to whether this AST-level rewrite\n// can soundly transform the closure's body.\nfn edp_has_unsafe_construct(expr: Expr, needing: Array[String], ename: String, pure_fns: Array[String]) -> Bool {\n  match expr {\n    EFn(_, _, _, _, _, body) => edp_has_unsafe_construct(body, needing, ename, pure_fns),\n    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {\n      true\n    } else {\n      edp_has_unsafe_construct(body, needing, ename, pure_fns) || edp_arms_have_unsafe_construct(arms, needing, ename, pure_fns)\n    },\n    EIf(c, t, e) => edp_has_unsafe_construct(c, needing, ename, pure_fns) || edp_has_unsafe_construct(t, needing, ename, pure_fns) || edp_has_unsafe_construct(e, needing, ename, pure_fns),\n    EMatch(s, arms) => edp_has_unsafe_construct(s, needing, ename, pure_fns) || edp_arms_have_unsafe_construct(arms, needing, ename, pure_fns),\n    EWhile(c, b) => edp_has_unsafe_construct(c, needing, ename, pure_fns) || edp_has_unsafe_construct(b, needing, ename, pure_fns),\n    EForIn(_, _, it, b) => edp_has_unsafe_construct(it, needing, ename, pure_fns) || edp_has_unsafe_construct(b, needing, ename, pure_fns),\n    ELoop(pairs, b) => edp_pairs_have_unsafe_construct(pairs, needing, ename, pure_fns) || edp_has_unsafe_construct(b, needing, ename, pure_fns),\n    ELet(_, v, b, _) => edp_has_unsafe_construct(v, needing, ename, pure_fns) || edp_has_unsafe_construct(b, needing, ename, pure_fns),\n    ELetMut(_, v, b, _) => edp_has_unsafe_construct(v, needing, ename, pure_fns) || edp_has_unsafe_construct(b, needing, ename, pure_fns),\n    ELetRec(_, v, b) => edp_has_unsafe_construct(v, needing, ename, pure_fns) || edp_has_unsafe_construct(b, needing, ename, pure_fns),\n    ESeq(a, b) => edp_has_unsafe_construct(a, needing, ename, pure_fns) || edp_has_unsafe_construct(b, needing, ename, pure_fns),\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if nm == \"perform\" && Array::length(args) == 1 {\n        edp_perform_operand_has_unsafe_construct(Array::get(args, 0), needing, ename, pure_fns)\n      } else if nm == \"resume\" {\n        edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns)\n      } else if edp_is_pure_builtin_call(nm) {\n        edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns)\n      } else if edp_str_array_contains(needing, nm) {\n        edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns)\n      } else if edp_str_array_contains(pure_fns, nm) {\n        edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns)\n      } else {\n        true\n      },\n      _ => true\n    },\n    EBinOp(_, l, r) => edp_has_unsafe_construct(l, needing, ename, pure_fns) || edp_has_unsafe_construct(r, needing, ename, pure_fns),\n    EUnaryOp(_, e2) => edp_has_unsafe_construct(e2, needing, ename, pure_fns),\n    EAssign(_, v, c) => edp_has_unsafe_construct(v, needing, ename, pure_fns) || edp_has_unsafe_construct(c, needing, ename, pure_fns),\n    EAssignOp(_, _, v, c) => edp_has_unsafe_construct(v, needing, ename, pure_fns) || edp_has_unsafe_construct(c, needing, ename, pure_fns),\n    EDot(o, _, _, _) => edp_has_unsafe_construct(o, needing, ename, pure_fns),\n    ELabeledArg(_, _, v) => edp_has_unsafe_construct(v, needing, ename, pure_fns),\n    EReturn(e2) => edp_has_unsafe_construct(e2, needing, ename, pure_fns),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_has_unsafe_construct(e2, needing, ename, pure_fns),\n      None => false\n    },\n    EContinue(args) => edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns),\n    ETuple(elems) => edp_exprs_have_unsafe_construct(elems, needing, ename, pure_fns),\n    EArray(elems) => edp_exprs_have_unsafe_construct(elems, needing, ename, pure_fns),\n    ERecord(_, fields, _) => edp_fields_have_unsafe_construct(fields, needing, ename, pure_fns),\n    EMap(fields) => edp_fields_have_unsafe_construct(fields, needing, ename, pure_fns),\n    ESpread(e2) => edp_has_unsafe_construct(e2, needing, ename, pure_fns),\n    // `_ => false` also covers `EStringInterp` -- verified (2026-07-23), not\n    // an oversight: `expand_interp_stmts` (entry/source_compile/wasi_only/\n    // preprocess_interp.vibe) always fully rewrites every `EStringInterp`\n    // into ordinary EBinOp/ECall string-concat nodes BEFORE check_program,\n    // itself called before this pass ever runs (see\n    // preprocess_compile.vibe's `expand_interp_stmts(stmts); check_program\n    // (stmts); ...compile_wasi_module_*_impl(stmts, ...)` ordering, all four\n    // entry variants). An `EStringInterp` node containing an embedded\n    // `perform` therefore can never actually reach this traversal -- by the\n    // time it would, the perform is already an ordinary sub-expression of a\n    // string-concat chain, visited through EBinOp/ECall like any other.\n    // Checked directly (not assumed) after noticing this pass's own match\n    // arms, unlike edp_has_unsafe_construct's sibling in perceus.vibe/\n    // common_analysis.vibe/checker_warning.vibe/etc., never explicitly\n    // lists `EStringInterp` at all -- worth confirming once rather than\n    // leaving it as a plausible-looking gap for a future reader to\n    // re-investigate from scratch.\n    _ => false\n  }\n}\n\n// Mirrors inline_direct_perform.vibe's idp_pure_builtin_names allowlist\n// exactly (same hand-audited, individually-verified set -- see that file's\n// doc comment for the auditing rule).\nfn edp_pure_builtin_names() -> Array[String] {\n  [\n    \"String::concat\", \"String::equals\", \"String::length\", \"String::substring\",\n    \"string_char_at\", \"String::trim\", \"String::split\", \"String::contains\",\n    \"String::index_of\", \"String::to_lower\", \"String::to_upper\",\n    \"String::ends_with\", \"String::starts_with\", \"String::char_code_at\",\n    \"String::last_index_of\", \"String::from_char_code\", \"String::join\",\n    \"Char::to_int\", \"Char::from_int\",\n    \"Int::to_double\", \"Int::to_float\", \"Int::to_string\",\n    \"Double::to_int\", \"Float::to_int\",\n    \"Double::to_string\", \"Float::to_string\",\n    \"Double::abs\", \"Double::floor\", \"Double::ceil\",\n    \"Double::max\", \"Double::min\",\n    \"Int::parse\", \"Double::parse\",\n    // Mirrors idp_pure_builtin_names' own addition (same doc comment, same\n    // audit) -- see that function's doc comment for the full rationale.\n    \"__index\", \"Array::get\", \"Map::get\", \"Bytes::get\", \"Array::length\", \"Map::size\", \"Bytes::length\"\n  ]\n}\n\nfn edp_is_pure_builtin_call(nm: String) -> Bool {\n  edp_str_array_contains(edp_pure_builtin_names(), nm)\n}\n\n// Every top-level function name whose declared effect row is\n// checker-verified empty (`\"\"`, meaning no `with` clause at all -- #942's\n// same guarantee edp_collect_fn_defs's own doc comment cites). See\n// edp_has_unsafe_construct's doc comment for why a call to one of these is\n// always safe to treat as inert.\nfn edp_pure_fn_names(fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(fn_defs) {\n    let (_, _, _, name, _, row) = Array::get(fn_defs, i)\n    if row == \"\" {\n      Array::push(out, name)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn edp_perform_operand_has_unsafe_construct(operand: Expr, needing: Array[String], ename: String, pure_fns: Array[String]) -> Bool {\n  match operand {\n    EIdent(_, _) => false,\n    ECall(op_callee, op_args, _) => match op_callee {\n      EIdent(_, _) => edp_exprs_have_unsafe_construct(op_args, needing, ename, pure_fns),\n      _ => true\n    },\n    _ => true\n  }\n}\n\nfn edp_exprs_have_unsafe_construct(exprs: Array[Expr], needing: Array[String], ename: String, pure_fns: Array[String]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(exprs) {\n    if edp_has_unsafe_construct(Array::get(exprs, i), needing, ename, pure_fns) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn edp_fields_have_unsafe_construct(fields: Array[(String, Expr)], needing: Array[String], ename: String, pure_fns: Array[String]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    if edp_has_unsafe_construct(v, needing, ename, pure_fns) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn edp_pairs_have_unsafe_construct(pairs: Array[(String, Expr)], needing: Array[String], ename: String, pure_fns: Array[String]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(pairs) {\n    let (_, v) = Array::get(pairs, i)\n    if edp_has_unsafe_construct(v, needing, ename, pure_fns) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn edp_arms_have_unsafe_construct(arms: Array[(Pat, Expr)], needing: Array[String], ename: String, pure_fns: Array[String]) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    if edp_has_unsafe_construct(ex, needing, ename, pure_fns) {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// --- per-arm preparation (identical shape to inline_direct_perform.vibe).\n\nfn edp_pat_bind_names(pat: Pat) -> Array[String] {\n  match pat {\n    PCtor(_, subpats) => for p in subpats {\n      match p {\n        PBind(n) => n,\n        _ => \"_\"\n      }\n    },\n    _ => empty_str_array()\n  }\n}\n\nfn edp_pat_qname(pat: Pat) -> String {\n  match pat {\n    PCtor(name, _) => name,\n    _ => \"\"\n  }\n}\n\nfn edp_strip_tail_resume(expr: Expr) -> Expr {\n  match expr {\n    EIf(c, t, e) => EIf(c, edp_strip_tail_resume(t), edp_strip_tail_resume(e)),\n    EMatch(s, arms) => EMatch(s, edp_strip_tail_resume_arms(arms)),\n    ELet(n, v, b, off) => ELet(n, v, edp_strip_tail_resume(b), off),\n    ELetMut(n, v, b, off) => ELetMut(n, v, edp_strip_tail_resume(b), off),\n    ELetRec(n, v, b) => ELetRec(n, v, edp_strip_tail_resume(b)),\n    ESeq(a, b) => ESeq(a, edp_strip_tail_resume(b)),\n    EAssign(n, v, c) => EAssign(n, v, edp_strip_tail_resume(c)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, v, edp_strip_tail_resume(c)),\n    EReturn(e2) => EReturn(edp_strip_tail_resume(e2)),\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if nm == \"resume\" && Array::length(args) == 1 {\n        Array::get(args, 0)\n      } else {\n        expr\n      },\n      _ => expr\n    },\n    _ => expr\n  }\n}\n\nfn edp_strip_tail_resume_arms(arms: Array[(Pat, Expr)]) -> Array[(Pat, Expr)] {\n  for a in arms {\n    let (p, ex) = a\n    (p, edp_strip_tail_resume(ex))\n  }\n}\n\n// --- the migration for one effect.\n\n// Every top-level `EHandle` (searched via the same whole-program recursive\n// descent as the eligibility/rewrite passes) whose arms discharge `ename`\n// -- identified by the qualified prefix on the first arm's pattern, since a\n// `handle ... with Effect { ... }` block's arms are always all for the same\n// effect (ADR-0050).\nfn edp_collect_handle_sites(stmts: Array[Stmt], ename: String) -> Array[(Expr, Array[(Pat, Expr)])] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => edp_collect_handle_sites_expr(expr, ename, out),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn edp_handle_matches_effect(arms: Array[(Pat, Expr)], ename: String) -> Bool {\n  if Array::length(arms) == 0 {\n    false\n  } else {\n    let (p, _) = Array::get(arms, 0)\n    let qname = edp_pat_qname(p)\n    let (eff_opt, _) = edp_split_qualified(qname)\n    match eff_opt {\n      Some(e) => e == ename,\n      None => false\n    }\n  }\n}\n\nfn edp_split_qualified(name: String) -> (Option[String], String) {\n  let idx = String::index_of(name, \"::\")\n  if idx > 0 {\n    (Some(String::substring(name, 0, idx)), String::substring(name, idx + 2, String::length(name)))\n  } else {\n    (None, name)\n  }\n}\n\nfn edp_collect_handle_sites_expr(expr: Expr, ename: String, out: Array[(Expr, Array[(Pat, Expr)])]) -> Unit {\n  match expr {\n    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {\n      Array::push(out, (body, arms))\n    } else {\n      edp_collect_handle_sites_expr(body, ename, out)\n    },\n    EFn(_, _, _, _, _, b) => edp_collect_handle_sites_expr(b, ename, out),\n    ELet(_, v, b, _) => {\n      edp_collect_handle_sites_expr(v, ename, out)\n      edp_collect_handle_sites_expr(b, ename, out)\n    },\n    ELetMut(_, v, b, _) => {\n      edp_collect_handle_sites_expr(v, ename, out)\n      edp_collect_handle_sites_expr(b, ename, out)\n    },\n    ELetRec(_, v, b) => {\n      edp_collect_handle_sites_expr(v, ename, out)\n      edp_collect_handle_sites_expr(b, ename, out)\n    },\n    ESeq(a, b) => {\n      edp_collect_handle_sites_expr(a, ename, out)\n      edp_collect_handle_sites_expr(b, ename, out)\n    },\n    EIf(c, t, e) => {\n      edp_collect_handle_sites_expr(c, ename, out)\n      edp_collect_handle_sites_expr(t, ename, out)\n      edp_collect_handle_sites_expr(e, ename, out)\n    },\n    EMatch(s, arms) => {\n      edp_collect_handle_sites_expr(s, ename, out)\n      for a in arms {\n        let (_, ex) = a\n        edp_collect_handle_sites_expr(ex, ename, out)\n      }\n    },\n    EWhile(c, b) => {\n      edp_collect_handle_sites_expr(c, ename, out)\n      edp_collect_handle_sites_expr(b, ename, out)\n    },\n    EForIn(_, _, it, b) => {\n      edp_collect_handle_sites_expr(it, ename, out)\n      edp_collect_handle_sites_expr(b, ename, out)\n    },\n    ECall(callee, args, _) => {\n      edp_collect_handle_sites_expr(callee, ename, out)\n      for a in args {\n        edp_collect_handle_sites_expr(a, ename, out)\n      }\n    },\n    EBinOp(_, l, r) => {\n      edp_collect_handle_sites_expr(l, ename, out)\n      edp_collect_handle_sites_expr(r, ename, out)\n    },\n    EUnaryOp(_, e2) => edp_collect_handle_sites_expr(e2, ename, out),\n    EAssign(_, v, c) => {\n      edp_collect_handle_sites_expr(v, ename, out)\n      edp_collect_handle_sites_expr(c, ename, out)\n    },\n    EAssignOp(_, _, v, c) => {\n      edp_collect_handle_sites_expr(v, ename, out)\n      edp_collect_handle_sites_expr(c, ename, out)\n    },\n    EDot(o, _, _, _) => edp_collect_handle_sites_expr(o, ename, out),\n    ELabeledArg(_, _, v) => edp_collect_handle_sites_expr(v, ename, out),\n    EReturn(e2) => edp_collect_handle_sites_expr(e2, ename, out),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_collect_handle_sites_expr(e2, ename, out),\n      None => ()\n    },\n    EContinue(args) => for a in args {\n      edp_collect_handle_sites_expr(a, ename, out)\n    },\n    ETuple(elems) => for a in elems {\n      edp_collect_handle_sites_expr(a, ename, out)\n    },\n    EArray(elems) => for a in elems {\n      edp_collect_handle_sites_expr(a, ename, out)\n    },\n    ERecord(_, fields, _) => for f in fields {\n      let (_, v) = f\n      edp_collect_handle_sites_expr(v, ename, out)\n    },\n    EMap(fields) => for f in fields {\n      let (_, v) = f\n      edp_collect_handle_sites_expr(v, ename, out)\n    },\n    ESpread(e2) => edp_collect_handle_sites_expr(e2, ename, out),\n    ELoop(pairs, b) => {\n      for p in pairs {\n        let (_, v) = p\n        edp_collect_handle_sites_expr(v, ename, out)\n      }\n      edp_collect_handle_sites_expr(b, ename, out)\n    },\n    _ => ()\n  }\n}\n\nfn edp_all_sites_eligible(stmts: Array[Stmt], ename: String, needing: Array[String], handle_sites: Array[(Expr, Array[(Pat, Expr)])], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Bool {\n  if Array::length(handle_sites) == 0 {\n    // Nothing discharges `ename` anywhere -- by the checker's own\n    // soundness a `needing` function could never actually run, so there is\n    // nothing to gain (and nothing unsound about skipping); leave it alone.\n    false\n  } else {\n    let pure_fns = edp_pure_fn_names(fn_defs)\n    let es_names = array_empty()\n    let es_members_list = array_empty()\n    edp_es_collect_into(stmts, es_names, es_members_list)\n    let mut hi = 0\n    let mut ok = true\n    while hi < Array::length(handle_sites) {\n      let (body, _) = Array::get(handle_sites, hi)\n      if edp_has_unsafe_construct(body, needing, ename, pure_fns) {\n        ok = false\n      } else {\n        ()\n      }\n      hi = hi + 1\n    }\n    let mut ni = 0\n    while ni < Array::length(needing) {\n      let nm = Array::get(needing, ni)\n      match edp_find_fn_params_and_body(stmts, fn_defs, nm) {\n        // #1070 (general case): a call to this function's OWN closure-\n        // typed parameter is treated exactly like a call to another\n        // needing function (dict forwarding), but ONLY for the specific\n        // parameter positions edp_own_closure_params has proven safe\n        // across every call site in the whole program -- see that\n        // function's own doc comment and edp_apply_migration's mirrored\n        // computation (must use the same stmts view; this eligibility\n        // check runs strictly before either is mutated for `ename`).\n        Some((gparams, b)) => {\n          let own_cp = edp_own_closure_params(stmts, nm, gparams, ename, needing, pure_fns, es_names, es_members_list)\n          let call_safe = Array::concat(needing, edp_closure_param_names_only(own_cp))\n          if edp_has_unsafe_construct(b, call_safe, ename, pure_fns) {\n            ok = false\n          } else {\n            ()\n          }\n        },\n        None => {\n          ok = false\n        }\n      }\n      ni = ni + 1\n    }\n    ok\n  }\n}\n\nfn edp_find_fn_body(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], name: String) -> Option[Expr] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(fn_defs) {\n    let (idx, _, _, nm, _, _) = Array::get(fn_defs, i)\n    if nm == name {\n      match Array::get(stmts, idx) {\n        SLet(_, _, _, _, EFn(_, _, _, _, _, body)) => {\n          result = Some(body)\n        },\n        _ => ()\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  result\n}\n\n// --- #1070 (general case): a needing function calling an opaque\n// closure-typed PARAMETER of its own (`f()` where `f: () -> R with\n// {ename}`), instead of another named needing function. Static (AST-only)\n// analysis can never fully prove what closure VALUE flows into an\n// arbitrary parameter, so this is scoped deliberately narrowly and\n// conservatively: a parameter position is only ever treated as safe to\n// forward the dict through if EVERY call site of the owning function in\n// the whole program can be proven, by itself, to pass a migratable\n// closure LITERAL at that exact position (edp_closure_param_universally_\n// safe) -- any call passing something else (a non-identifier expression,\n// a missing argument, or an identifier that isn't a provably single-use,\n// row-matching, safe-bodied `let`-bound closure literal) makes the WHOLE\n// position ineligible, and the owning function falls back to its\n// pre-existing (unsafe -> replay) treatment exactly as before this\n// change. This two-sided requirement is essential, not a nicety: if only\n// the call site were rewritten (forwarding a dict argument) without the\n// actual closure VALUE also being recompiled to accept it, the extra\n// argument would land on a closure whose compiled arity doesn't expect\n// it -- silently wrong at best, a wrong-arity crash at worst. Provably\n// requiring BOTH sides before touching either is what keeps this sound.\n\n// A parameter's declared type denotes a function whose row is EXACTLY\n// `ename` (same effectset-aware matching edp_needing_names uses for\n// top-level functions, reused here for a parameter's own type instead of\n// a function's declared row).\nfn edp_type_is_fn_row_exactly(pty: Option[TypeExpr], ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {\n  match pty {\n    Some(t) => match t {\n      TyFn(_, _, roweff) => match roweff {\n        Some(row) => edp_row_is_exactly(row, ename, es_names, es_members_list),\n        None => false\n      },\n      _ => false\n    },\n    None => false\n  }\n}\n\n// Like edp_find_fn_body but also returns the function's own params (needed\n// to inspect a parameter's declared type, which edp_collect_fn_defs never\n// captures).\nfn edp_find_fn_params_and_body(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], name: String) -> Option[(Array[(String, Option[TypeExpr])], Expr)] {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(fn_defs) {\n    let (idx, _, _, nm, _, _) = Array::get(fn_defs, i)\n    if nm == name {\n      match Array::get(stmts, idx) {\n        SLet(_, _, _, _, EFn(_, _, params, _, _, body)) => {\n          result = Some((params, body))\n        },\n        _ => ()\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  result\n}\n\n// Is `expr` an EFn literal whose OWN declared row is exactly `ename` and\n// whose body contains nothing edp_has_unsafe_construct rejects? This is\n// the exact eligibility bar a top-level needing function must also clear\n// -- reused here for a LOCAL closure literal considered for the same\n// dict-parameter treatment.\nfn edp_efn_eligible_for_migration(expr: Expr, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {\n  match expr {\n    EFn(_, _, _, _, eff, body) => {\n      let row = match eff {\n        Some(s) => s,\n        None => \"\"\n      }\n      edp_row_is_exactly(row, ename, es_names, es_members_list) && !edp_has_unsafe_construct(body, needing, ename, pure_fns)\n    },\n    _ => false\n  }\n}\n\n// Whole-program count of every `EIdent(name)` occurrence -- full coverage\n// mirroring edp_has_unsafe_construct/edp_rewrite_needing_body's own node\n// list (see those functions' doc comments for why missing a position here\n// would be unsafe, not just incomplete: undercounting could make a\n// closure look falsely single-use).\nfn edp_count_ident_uses_stmts(stmts: Array[Stmt], name: String) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => {\n        total = total + edp_count_ident_uses(expr, name)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_ident_uses(expr: Expr, name: String) -> Int {\n  match expr {\n    EIdent(nm, _) => if nm == name {\n      1\n    } else {\n      0\n    },\n    EFn(_, _, _, _, _, body) => edp_count_ident_uses(body, name),\n    EHandle(body, arms) => edp_count_ident_uses(body, name) + edp_count_ident_uses_arms(arms, name),\n    EIf(c, t, e) => edp_count_ident_uses(c, name) + edp_count_ident_uses(t, name) + edp_count_ident_uses(e, name),\n    EMatch(s, arms) => edp_count_ident_uses(s, name) + edp_count_ident_uses_arms(arms, name),\n    EWhile(c, b) => edp_count_ident_uses(c, name) + edp_count_ident_uses(b, name),\n    EForIn(_, _, it, b) => edp_count_ident_uses(it, name) + edp_count_ident_uses(b, name),\n    ELoop(pairs, b) => edp_count_ident_uses_pairs(pairs, name) + edp_count_ident_uses(b, name),\n    ELet(_, v, b, _) => edp_count_ident_uses(v, name) + edp_count_ident_uses(b, name),\n    ELetMut(_, v, b, _) => edp_count_ident_uses(v, name) + edp_count_ident_uses(b, name),\n    ELetRec(_, v, b) => edp_count_ident_uses(v, name) + edp_count_ident_uses(b, name),\n    ESeq(a, b) => edp_count_ident_uses(a, name) + edp_count_ident_uses(b, name),\n    ECall(callee, args, _) => edp_count_ident_uses(callee, name) + edp_count_ident_uses_exprs(args, name),\n    EBinOp(_, l, r) => edp_count_ident_uses(l, name) + edp_count_ident_uses(r, name),\n    EUnaryOp(_, e2) => edp_count_ident_uses(e2, name),\n    EAssign(_, v, c) => edp_count_ident_uses(v, name) + edp_count_ident_uses(c, name),\n    EAssignOp(_, _, v, c) => edp_count_ident_uses(v, name) + edp_count_ident_uses(c, name),\n    EDot(o, _, _, _) => edp_count_ident_uses(o, name),\n    ELabeledArg(_, _, v) => edp_count_ident_uses(v, name),\n    EReturn(e2) => edp_count_ident_uses(e2, name),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_count_ident_uses(e2, name),\n      None => 0\n    },\n    EContinue(args) => edp_count_ident_uses_exprs(args, name),\n    ETuple(elems) => edp_count_ident_uses_exprs(elems, name),\n    EArray(elems) => edp_count_ident_uses_exprs(elems, name),\n    ERecord(_, fields, _) => edp_count_ident_uses_fields(fields, name),\n    EMap(fields) => edp_count_ident_uses_fields(fields, name),\n    ESpread(e2) => edp_count_ident_uses(e2, name),\n    _ => 0\n  }\n}\n\nfn edp_count_ident_uses_exprs(exprs: Array[Expr], name: String) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(exprs) {\n    total = total + edp_count_ident_uses(Array::get(exprs, i), name)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_ident_uses_arms(arms: Array[(Pat, Expr)], name: String) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    total = total + edp_count_ident_uses(ex, name)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_ident_uses_pairs(pairs: Array[(String, Expr)], name: String) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(pairs) {\n    let (_, v) = Array::get(pairs, i)\n    total = total + edp_count_ident_uses(v, name)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_ident_uses_fields(fields: Array[(String, Expr)], name: String) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    total = total + edp_count_ident_uses(v, name)\n    i = i + 1\n  }\n  total\n}\n\n// Whole-program count of `let`-bound (top-level SLet or nested ELet/\n// ELetRec) closure literals named `xname` that are individually eligible\n// (edp_efn_eligible_for_migration). Same full coverage as\n// edp_count_ident_uses.\nfn edp_count_safe_closure_bindings_stmts(stmts: Array[Stmt], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, nm, _, expr) => {\n        let self_hit = if nm == xname && edp_efn_eligible_for_migration(expr, ename, needing, pure_fns, es_names, es_members_list) {\n          1\n        } else {\n          0\n        }\n        total = total + self_hit + edp_count_safe_closure_bindings(expr, xname, ename, needing, pure_fns, es_names, es_members_list)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_safe_closure_bindings(expr: Expr, xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {\n  match expr {\n    ELet(n, v, b, _) => {\n      let self_hit = if n == xname && edp_efn_eligible_for_migration(v, ename, needing, pure_fns, es_names, es_members_list) {\n        1\n      } else {\n        0\n      }\n      self_hit + edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list)\n    },\n    ELetRec(n, v, b) => {\n      let self_hit = if n == xname && edp_efn_eligible_for_migration(v, ename, needing, pure_fns, es_names, es_members_list) {\n        1\n      } else {\n        0\n      }\n      self_hit + edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list)\n    },\n    EFn(_, _, _, _, _, body) => edp_count_safe_closure_bindings(body, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EHandle(body, arms) => edp_count_safe_closure_bindings(body, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings_arms(arms, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EIf(c, t, e) => edp_count_safe_closure_bindings(c, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(t, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(e, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EMatch(s, arms) => edp_count_safe_closure_bindings(s, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings_arms(arms, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EWhile(c, b) => edp_count_safe_closure_bindings(c, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EForIn(_, _, it, b) => edp_count_safe_closure_bindings(it, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list),\n    ELoop(pairs, b) => edp_count_safe_closure_bindings_pairs(pairs, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list),\n    ELetMut(_, v, b, _) => edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list),\n    ESeq(a, b) => edp_count_safe_closure_bindings(a, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EAssign(_, v, c) => edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(c, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EAssignOp(_, _, v, c) => edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(c, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EDot(o, _, _, _) => edp_count_safe_closure_bindings(o, xname, ename, needing, pure_fns, es_names, es_members_list),\n    ELabeledArg(_, _, v) => edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EReturn(e2) => edp_count_safe_closure_bindings(e2, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_count_safe_closure_bindings(e2, xname, ename, needing, pure_fns, es_names, es_members_list),\n      None => 0\n    },\n    ECall(callee, args, _) => edp_count_safe_closure_bindings(callee, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings_exprs(args, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EBinOp(_, l, r) => edp_count_safe_closure_bindings(l, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(r, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EUnaryOp(_, e2) => edp_count_safe_closure_bindings(e2, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EContinue(args) => edp_count_safe_closure_bindings_exprs(args, xname, ename, needing, pure_fns, es_names, es_members_list),\n    ETuple(elems) => edp_count_safe_closure_bindings_exprs(elems, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EArray(elems) => edp_count_safe_closure_bindings_exprs(elems, xname, ename, needing, pure_fns, es_names, es_members_list),\n    ERecord(_, fields, _) => edp_count_safe_closure_bindings_fields(fields, xname, ename, needing, pure_fns, es_names, es_members_list),\n    EMap(fields) => edp_count_safe_closure_bindings_fields(fields, xname, ename, needing, pure_fns, es_names, es_members_list),\n    ESpread(e2) => edp_count_safe_closure_bindings(e2, xname, ename, needing, pure_fns, es_names, es_members_list),\n    _ => 0\n  }\n}\n\nfn edp_count_safe_closure_bindings_exprs(exprs: Array[Expr], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(exprs) {\n    total = total + edp_count_safe_closure_bindings(Array::get(exprs, i), xname, ename, needing, pure_fns, es_names, es_members_list)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_safe_closure_bindings_arms(arms: Array[(Pat, Expr)], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    total = total + edp_count_safe_closure_bindings(ex, xname, ename, needing, pure_fns, es_names, es_members_list)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_safe_closure_bindings_pairs(pairs: Array[(String, Expr)], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(pairs) {\n    let (_, v) = Array::get(pairs, i)\n    total = total + edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list)\n    i = i + 1\n  }\n  total\n}\n\nfn edp_count_safe_closure_bindings_fields(fields: Array[(String, Expr)], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {\n  let mut total = 0\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    total = total + edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list)\n    i = i + 1\n  }\n  total\n}\n\n// Whole-program scan for `gname(args)` calls, collecting the bare\n// identifier found at `args[argpos]`. A call to `gname` whose argument at\n// that position is EITHER missing (arity mismatch we can't reason about)\n// OR present but not a bare identifier (a literal, a field access, an\n// inline lambda, ...) pushes the sentinel \"##edp_unsafe##\" instead --\n// edp_closure_param_universally_safe treats its presence, anywhere in the\n// result, as an unconditional \"not safe\" for the whole position.\nfn edp_collect_ecall_arg_idents(stmts: Array[Stmt], gname: String, argpos: Int) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nfn edp_collect_ecall_arg_idents_expr(expr: Expr, gname: String, argpos: Int, out: Array[String]) -> Unit {\n  match expr {\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(nm, _) => if nm == gname {\n          if Array::length(args) > argpos {\n            match Array::get(args, argpos) {\n              EIdent(xn, _) => Array::push(out, xn),\n              _ => Array::push(out, \"##edp_unsafe##\")\n            }\n          } else {\n            Array::push(out, \"##edp_unsafe##\")\n          }\n        } else {\n          ()\n        },\n        _ => ()\n      }\n      edp_collect_ecall_arg_idents_expr(callee, gname, argpos, out)\n      edp_collect_ecall_arg_idents_exprs(args, gname, argpos, out)\n    },\n    EFn(_, _, _, _, _, body) => edp_collect_ecall_arg_idents_expr(body, gname, argpos, out),\n    EHandle(body, arms) => {\n      edp_collect_ecall_arg_idents_expr(body, gname, argpos, out)\n      edp_collect_ecall_arg_idents_arms(arms, gname, argpos, out)\n    },\n    EIf(c, t, e) => {\n      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(t, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(e, gname, argpos, out)\n    },\n    EMatch(s, arms) => {\n      edp_collect_ecall_arg_idents_expr(s, gname, argpos, out)\n      edp_collect_ecall_arg_idents_arms(arms, gname, argpos, out)\n    },\n    EWhile(c, b) => {\n      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)\n    },\n    EForIn(_, _, it, b) => {\n      edp_collect_ecall_arg_idents_expr(it, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)\n    },\n    ELoop(pairs, b) => {\n      let mut i = 0\n      while i < Array::length(pairs) {\n        let (_, v) = Array::get(pairs, i)\n        edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n        i = i + 1\n      }\n      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)\n    },\n    ELet(_, v, b, _) => {\n      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)\n    },\n    ELetMut(_, v, b, _) => {\n      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)\n    },\n    ELetRec(_, v, b) => {\n      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)\n    },\n    ESeq(a, b) => {\n      edp_collect_ecall_arg_idents_expr(a, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)\n    },\n    EBinOp(_, l, r) => {\n      edp_collect_ecall_arg_idents_expr(l, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(r, gname, argpos, out)\n    },\n    EUnaryOp(_, e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out),\n    EAssign(_, v, c) => {\n      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out)\n    },\n    EAssignOp(_, _, v, c) => {\n      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out)\n    },\n    EDot(o, _, _, _) => edp_collect_ecall_arg_idents_expr(o, gname, argpos, out),\n    ELabeledArg(_, _, v) => edp_collect_ecall_arg_idents_expr(v, gname, argpos, out),\n    EReturn(e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out),\n    EBreak(opt) => match opt {\n      Some(e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out),\n      None => ()\n    },\n    EContinue(args) => edp_collect_ecall_arg_idents_exprs(args, gname, argpos, out),\n    ETuple(elems) => edp_collect_ecall_arg_idents_exprs(elems, gname, argpos, out),\n    EArray(elems) => edp_collect_ecall_arg_idents_exprs(elems, gname, argpos, out),\n    ERecord(_, fields, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n        i = i + 1\n      }\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)\n        i = i + 1\n      }\n    },\n    ESpread(e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out),\n    _ => ()\n  }\n}\n\nfn edp_collect_ecall_arg_idents_exprs(exprs: Array[Expr], gname: String, argpos: Int, out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(exprs) {\n    edp_collect_ecall_arg_idents_expr(Array::get(exprs, i), gname, argpos, out)\n    i = i + 1\n  }\n}\n\nfn edp_collect_ecall_arg_idents_arms(arms: Array[(Pat, Expr)], gname: String, argpos: Int, out: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, ex) = Array::get(arms, i)\n    edp_collect_ecall_arg_idents_expr(ex, gname, argpos, out)\n    i = i + 1\n  }\n}\n\n// A closure-typed parameter position is safe to widen only if EVERY\n// candidate identifier found at that position (across the whole program)\n// is itself: used EXACTLY once anywhere (so no OTHER use could depend on\n// the pre-migration arity), and bound to at least one individually-\n// eligible closure literal. See this section's opening comment for why\n// both sides must hold.\nfn edp_closure_param_universally_safe(stmts: Array[Stmt], gname: String, pi: Int, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {\n  let candidates = edp_collect_ecall_arg_idents(stmts, gname, pi)\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(candidates) {\n    let xn = Array::get(candidates, i)\n    if xn == \"##edp_unsafe##\" {\n      ok = false\n    } else if edp_count_ident_uses_stmts(stmts, xn) != 1 {\n      ok = false\n    } else if edp_count_safe_closure_bindings_stmts(stmts, xn, ename, needing, pure_fns, es_names, es_members_list) < 1 {\n      ok = false\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  ok\n}\n\n// For a needing function's own params, the (name, position) pairs of\n// closure-typed parameters that edp_closure_param_universally_safe has\n// cleared -- these are treated exactly like another needing function's\n// name when rewriting this function's own body (dict forwarded the same\n// way via edp_prepend_dict_arg).\nfn edp_own_closure_params(stmts: Array[Stmt], gname: String, gparams: Array[(String, Option[TypeExpr])], ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[(String, Int)] {\n  let out = array_empty()\n  let mut pi = 0\n  while pi < Array::length(gparams) {\n    let (pname, pty) = Array::get(gparams, pi)\n    if edp_type_is_fn_row_exactly(pty, ename, es_names, es_members_list) && edp_closure_param_universally_safe(stmts, gname, pi, ename, needing, pure_fns, es_names, es_members_list) {\n      Array::push(out, (edp_strip_tilde(pname), pi))\n    } else {\n      ()\n    }\n    pi = pi + 1\n  }\n  out\n}\n\nfn edp_closure_param_names_only(pairs: Array[(String, Int)]) -> Array[String] {\n  for p in pairs {\n    let (n, _) = p\n    n\n  }\n}\n\n// Migrates ONE closure literal binding (top-level SLet or nested ELet/\n// ELetRec named `xname`) in place: prepends the evidence-dict parameter\n// and rewrites its body exactly like a top-level needing function's own\n// definition (edp_rewrite_needing_fn). Only actually mutates if the\n// binding's value is still individually eligible at the point this runs\n// (edp_maybe_migrate_efn) -- a defensive re-check, not just trusting the\n// caller's earlier edp_closure_param_universally_safe verdict.\nfn edp_maybe_migrate_efn(expr: Expr, ename: String, dict_pname: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Option[Expr] {\n  match expr {\n    EFn(tps, tbs, params, ret, eff, body) => if edp_efn_eligible_for_migration(expr, ename, needing, pure_fns, es_names, es_members_list) {\n      let new_params = Array::concat([\n        (dict_pname, Some(TyName(edp_dict_struct_name(ename))))\n      ], params)\n      let new_body = edp_rewrite_needing_body(body, ename, dict_pname, needing)\n      Some(EFn(tps, tbs, new_params, ret, eff, new_body))\n    } else {\n      None\n    },\n    _ => None\n  }\n}\n\nfn edp_migrate_closure_binding_stmts(stmts: Array[Stmt], xname: String, ename: String, dict_pname: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, is_rec, nm, ty, expr) => if nm == xname {\n        match edp_maybe_migrate_efn(expr, ename, dict_pname, needing, pure_fns, es_names, es_members_list) {\n          Some(new_expr) => Array::set(stmts, i, SLet(exported, is_rec, nm, ty, new_expr)),\n          None => ()\n        }\n      } else {\n        Array::set(stmts, i, SLet(exported, is_rec, nm, ty, edp_migrate_closure_binding_expr(expr, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)))\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nfn edp_migrate_closure_binding_expr(expr: Expr, xname: String, ename: String, dict_pname: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Expr {\n  match expr {\n    ELet(n, v, b, off) => if n == xname {\n      match edp_maybe_migrate_efn(v, ename, dict_pname, needing, pure_fns, es_names, es_members_list) {\n        Some(nv) => ELet(n, nv, edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), off),\n        None => ELet(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), off)\n      }\n    } else {\n      ELet(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), off)\n    },\n    ELetRec(n, v, b) => if n == xname {\n      match edp_maybe_migrate_efn(v, ename, dict_pname, needing, pure_fns, es_names, es_members_list) {\n        Some(nv) => ELetRec(n, nv, edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n        None => ELetRec(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))\n      }\n    } else {\n      ELetRec(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))\n    },\n    EFn(tps, tbs, params, ret, eff, body) => EFn(tps, tbs, params, ret, eff, edp_migrate_closure_binding_expr(body, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EHandle(body, arms) => EHandle(edp_migrate_closure_binding_expr(body, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), for a in arms {\n      let (p, ex) = a\n      (p, edp_migrate_closure_binding_expr(ex, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))\n    }),\n    EIf(c, t, e) => EIf(edp_migrate_closure_binding_expr(c, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(t, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(e, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EMatch(s, arms) => EMatch(edp_migrate_closure_binding_expr(s, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), for a in arms {\n      let (p, ex) = a\n      (p, edp_migrate_closure_binding_expr(ex, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))\n    }),\n    EWhile(c, b) => EWhile(edp_migrate_closure_binding_expr(c, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, edp_migrate_closure_binding_expr(it, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    ELoop(pairs, b) => ELoop(for p in pairs {\n      let (n, v) = p\n      (n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))\n    }, edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    ELetMut(n, v, b, off) => ELetMut(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), off),\n    ESeq(a, b) => ESeq(edp_migrate_closure_binding_expr(a, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EAssign(n, v, c) => EAssign(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(c, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(c, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EDot(o, f, off1, off2) => EDot(edp_migrate_closure_binding_expr(o, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), f, off1, off2),\n    ECall(callee, args, off) => ECall(callee, for a in args {\n      edp_migrate_closure_binding_expr(a, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)\n    }, off),\n    EBinOp(op, l, r) => EBinOp(op, edp_migrate_closure_binding_expr(l, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(r, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EUnaryOp(op, e2) => EUnaryOp(op, edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EReturn(e2) => EReturn(edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e2) => Some(edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n      None => None\n    }),\n    EContinue(args) => EContinue(for a in args {\n      edp_migrate_closure_binding_expr(a, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)\n    }),\n    ETuple(elems) => ETuple(for e2 in elems {\n      edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)\n    }),\n    EArray(elems) => EArray(for e2 in elems {\n      edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)\n    }),\n    ERecord(n, fields, tas) => ERecord(n, for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))\n    }, tas),\n    EMap(fields) => EMap(for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))\n    }),\n    ESpread(e2) => ESpread(edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),\n    _ => expr\n  }\n}\n\n// --- applying an eligible migration.\n\nfn edp_apply_migration(stmts: Array[Stmt], ename: String, ops: Array[(String, Array[TypeExpr], TypeExpr)], needing: Array[String], handle_sites: Array[(Expr, Array[(Pat, Expr)])], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Unit {\n  let dict_pname = edp_dict_param_name(ename)\n  let dict_tyname = edp_dict_struct_name(ename)\n  let pure_fns = edp_pure_fn_names(fn_defs)\n  let es_names = array_empty()\n  let es_members_list = array_empty()\n  edp_es_collect_into(stmts, es_names, es_members_list)\n  // #1070 (general case): compute + commit closure-parameter migrations\n  // for EVERY needing function BEFORE any needing function's own\n  // params/body are rewritten below -- edp_collect_ecall_arg_idents scans\n  // call sites by ARGUMENT POSITION, which would be silently thrown off\n  // by an earlier needing-to-needing dict-forwarding rewrite prepending\n  // an argument to some OTHER call in between. Doing every function's\n  // read-only analysis (and Part B's closure-literal rewrites, which only\n  // ever touch OTHER statements -- the literals themselves, never a call\n  // site's argument list) in one pass up front, strictly before the\n  // rewrite loop that follows, keeps every position-based scan looking at\n  // the same unshifted view edp_all_sites_eligible already vetted this\n  // against.\n  let own_cp_map = array_empty()\n  let mut ni0 = 0\n  while ni0 < Array::length(needing) {\n    let gname = Array::get(needing, ni0)\n    match edp_find_fn_params_and_body(stmts, fn_defs, gname) {\n      Some((gparams, _)) => {\n        let own_cp = edp_own_closure_params(stmts, gname, gparams, ename, needing, pure_fns, es_names, es_members_list)\n        Array::push(own_cp_map, own_cp)\n        let mut cpi = 0\n        while cpi < Array::length(own_cp) {\n          let (_, ppos) = Array::get(own_cp, cpi)\n          let candidates = edp_collect_ecall_arg_idents(stmts, gname, ppos)\n          let mut ci = 0\n          while ci < Array::length(candidates) {\n            let xn = Array::get(candidates, ci)\n            if xn == \"##edp_unsafe##\" {\n              ()\n            } else {\n              edp_migrate_closure_binding_stmts(stmts, xn, ename, dict_pname, needing, pure_fns, es_names, es_members_list)\n            }\n            ci = ci + 1\n          }\n          cpi = cpi + 1\n        }\n      },\n      None => Array::push(own_cp_map, array_empty())\n    }\n    ni0 = ni0 + 1\n  }\n  // Rewrite each needing function's own definition in place: prepend the\n  // evidence-dict parameter, and rewrite its body to call through it\n  // (direct performs) / forward it (calls to other needing functions, and\n  // -- per own_cp_map above -- calls through its own closure-typed\n  // parameters that were just proven safe to widen).\n  let mut ni = 0\n  while ni < Array::length(needing) {\n    let nm = Array::get(needing, ni)\n    let own_cp = Array::get(own_cp_map, ni)\n    let call_safe = Array::concat(needing, edp_closure_param_names_only(own_cp))\n    edp_rewrite_needing_fn(stmts, fn_defs, nm, ename, dict_pname, dict_tyname, call_safe)\n    ni = ni + 1\n  }\n  // Rewrite each handle site: synthesize a fresh evidence dict from its\n  // arms, splice direct performs the same way Phase 2 does, pass the dict\n  // at calls to needing functions, and drop the EHandle wrapper. Single\n  // pass over `stmts`, rewriting each matching EHandle node the moment it\n  // is found -- see edp_find_rewrite_handles's doc comment for why this\n  // replaced an earlier collect-then-re-find-by-equality design.\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, si, SLet(exported, is_rec, name, ty, edp_find_rewrite_handles(expr, ename, needing))),\n      _ => ()\n    }\n    si = si + 1\n  }\n  // Register the dict struct type once (idempotent, mirrors\n  // desugar_trait_dict.vibe's own struct_decl_exists guard).\n  if edp_struct_decl_exists(stmts, dict_tyname) {\n    ()\n  } else {\n    Array::push(stmts, edp_make_dict_struct_stmt(ename, ops))\n  }\n}\n\nfn edp_rewrite_needing_fn(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], name: String, ename: String, dict_pname: String, dict_tyname: String, needing: Array[String]) -> Unit {\n  let mut i = 0\n  while i < Array::length(fn_defs) {\n    let (idx, exported, is_rec, nm, ty, _) = Array::get(fn_defs, i)\n    if nm == name {\n      match Array::get(stmts, idx) {\n        SLet(_, _, _, _, EFn(tps, tbs, params, ret, eff, body)) => {\n          let new_params = Array::concat([\n            (dict_pname, Some(TyName(dict_tyname)))\n          ], params)\n          let new_body = edp_rewrite_needing_body(body, ename, dict_pname, needing)\n          Array::set(stmts, idx, SLet(exported, is_rec, nm, ty, EFn(tps, tbs, new_params, ret, eff, new_body)))\n        },\n        _ => ()\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n}\n\n// Rewrite a needing function's own body: a direct `perform E::Op(args)`\n// becomes a call through the received dict parameter's `Op` field; a call\n// to another needing function has the SAME received dict parameter\n// forwarded as its new leading argument (mirrors desugar_trait_dict.vibe's\n// find_dict_for_trait forwarding). By this point edp_has_unsafe_construct\n// has already verified this body contains nothing else that could hide a\n// perform (no EFn/EHandle/EDot/other calls), so this traversal only needs\n// to handle the shapes that check allows through -- but it must still visit\n// EVERY position edp_has_unsafe_construct visits, not just the ones a bare\n// tail-position perform happens to need. This traversal used to be missing\n// several of those positions -- ELet/ELetMut/ELetRec/EAssign/EAssignOp's\n// value/RHS slot, EIf's condition, EMatch's scrutinee, and EWhile/EForIn/\n// ELoop/EUnaryOp/ELabeledArg/EBreak/EContinue/ETuple/EArray/ERecord/EMap/\n// ESpread entirely (falling to the `_ => expr` passthrough) -- even though\n// edp_has_unsafe_construct's OWN traversal (the eligibility check that\n// gates whether this rewrite runs at all) already recursed into every one\n// of them. A perform reached only through one of those positions -- most\n// simply, bound via `let` (`let a = perform Ask::Get; ...`) rather than\n// written as a bare tail expression -- therefore passed eligibility\n// (nothing unsafe about it, by has_unsafe_construct's own correct\n// judgment) but was silently left un-rewritten: still a raw `perform`,\n// throwing a tag the enclosing handle site no longer catches once this\n// migration drops it -- producing an uncaught-exception crash at runtime\n// despite a clean compile. Found via runtime instrumentation (temporary\n// exported per-effect tags decoded the escaping exception as the MIGRATED\n// effect's own tag, not a foreign one -- see\n// fixtures/effect_handle_call_evidence_let_bound.vibe) while investigating\n// an unrelated multi-effect-row crash; independent of that investigation\n// and reproducible with a single exact-match effect, so this was a real,\n// already-shipped soundness gap, not something specific to the multi-\n// effect experiment that led to finding it.\nfn edp_rewrite_needing_body(expr: Expr, ename: String, dict_pname: String, needing: Array[String]) -> Expr {\n  match expr {\n    // A closure literal's body is rewritten the same way its enclosing\n    // needing function's body is (edp_has_unsafe_construct already\n    // verified this is safe); the closure's own params/type params/\n    // return type/declared row are untouched, only its body. A perform\n    // of `ename` found inside resolves through `dict_pname` via ordinary\n    // lexical capture from the enclosing scope.\n    EFn(tps, tbs, params, ret, eff, body) => EFn(tps, tbs, params, ret, eff, edp_rewrite_needing_body(body, ename, dict_pname, needing)),\n    // A nested EHandle for a DIFFERENT effect than `ename` is safe to\n    // recurse into (edp_has_unsafe_construct already verified this, both\n    // for its body and its arms -- see that function's doc comment); one\n    // matching `ename` itself is unconditionally unsafe and therefore\n    // never reaches this rewrite (eligibility already rejected it), so\n    // leave it structurally unchanged if somehow encountered defensively.\n    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {\n      expr\n    } else {\n      EHandle(edp_rewrite_needing_body(body, ename, dict_pname, needing), for a in arms {\n        let (p, ex) = a\n        (p, edp_rewrite_needing_body(ex, ename, dict_pname, needing))\n      })\n    },\n    EIf(c, t, e) => EIf(edp_rewrite_needing_body(c, ename, dict_pname, needing), edp_rewrite_needing_body(t, ename, dict_pname, needing), edp_rewrite_needing_body(e, ename, dict_pname, needing)),\n    EMatch(s, arms) => EMatch(edp_rewrite_needing_body(s, ename, dict_pname, needing), for a in arms {\n      let (p, ex) = a\n      (p, edp_rewrite_needing_body(ex, ename, dict_pname, needing))\n    }),\n    EWhile(c, b) => EWhile(edp_rewrite_needing_body(c, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, edp_rewrite_needing_body(it, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing)),\n    ELoop(pairs, b) => ELoop(for p in pairs {\n      let (n, v) = p\n      (n, edp_rewrite_needing_body(v, ename, dict_pname, needing))\n    }, edp_rewrite_needing_body(b, ename, dict_pname, needing)),\n    ELet(n, v, b, off) => ELet(n, edp_rewrite_needing_body(v, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing), off),\n    ELetMut(n, v, b, off) => ELetMut(n, edp_rewrite_needing_body(v, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing), off),\n    ELetRec(n, v, b) => ELetRec(n, edp_rewrite_needing_body(v, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing)),\n    ESeq(a, b) => ESeq(edp_rewrite_needing_body(a, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing)),\n    EAssign(n, v, c) => EAssign(n, edp_rewrite_needing_body(v, ename, dict_pname, needing), edp_rewrite_needing_body(c, ename, dict_pname, needing)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_rewrite_needing_body(v, ename, dict_pname, needing), edp_rewrite_needing_body(c, ename, dict_pname, needing)),\n    EReturn(e2) => EReturn(edp_rewrite_needing_body(e2, ename, dict_pname, needing)),\n    // A bare `.field` read (NOT a call through it -- ECall's own EDot\n    // callee case never recurses through here, `_ => true`/its rewrite\n    // counterpart's `_ => ECall(...)` catch it independently) only needs\n    // its object expression rewritten; the field name is a bare string.\n    EDot(o, f, off1, off2) => EDot(edp_rewrite_needing_body(o, ename, dict_pname, needing), f, off1, off2),\n    ECall(callee, args, off) => match callee {\n      EIdent(nm, _) => if nm == \"perform\" && Array::length(args) == 1 {\n        edp_rewrite_perform_via_dict(Array::get(args, 0), ename, dict_pname, needing)\n      } else if edp_str_array_contains(needing, nm) {\n        ECall(callee, edp_prepend_dict_arg(dict_pname, edp_rewrite_needing_body_exprs(args, ename, dict_pname, needing)), off)\n      } else {\n        ECall(callee, edp_rewrite_needing_body_exprs(args, ename, dict_pname, needing), off)\n      },\n      _ => ECall(callee, edp_rewrite_needing_body_exprs(args, ename, dict_pname, needing), off)\n    },\n    EBinOp(op, l, r) => EBinOp(op, edp_rewrite_needing_body(l, ename, dict_pname, needing), edp_rewrite_needing_body(r, ename, dict_pname, needing)),\n    EUnaryOp(op, e2) => EUnaryOp(op, edp_rewrite_needing_body(e2, ename, dict_pname, needing)),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_rewrite_needing_body(v, ename, dict_pname, needing)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e2) => Some(edp_rewrite_needing_body(e2, ename, dict_pname, needing)),\n      None => None\n    }),\n    EContinue(args) => EContinue(edp_rewrite_needing_body_exprs(args, ename, dict_pname, needing)),\n    ETuple(elems) => ETuple(edp_rewrite_needing_body_exprs(elems, ename, dict_pname, needing)),\n    EArray(elems) => EArray(edp_rewrite_needing_body_exprs(elems, ename, dict_pname, needing)),\n    ERecord(n, fields, tas) => ERecord(n, for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_rewrite_needing_body(v, ename, dict_pname, needing))\n    }, tas),\n    EMap(fields) => EMap(for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_rewrite_needing_body(v, ename, dict_pname, needing))\n    }),\n    ESpread(e2) => ESpread(edp_rewrite_needing_body(e2, ename, dict_pname, needing)),\n    _ => expr\n  }\n}\n\nfn edp_rewrite_needing_body_exprs(exprs: Array[Expr], ename: String, dict_pname: String, needing: Array[String]) -> Array[Expr] {\n  for e in exprs {\n    edp_rewrite_needing_body(e, ename, dict_pname, needing)\n  }\n}\n\nfn edp_prepend_dict_arg(dict_pname: String, args: Array[Expr]) -> Array[Expr] {\n  Array::concat([\n    EIdent(dict_pname, -1)\n  ], args)\n}\n\n// A needing function's declared row is exactly `ename`, but it may still\n// contain a `perform` for a DIFFERENT effect that is exempt from row\n// declaration -- `Error` (#640 Stage 2: `perform Error::Throw`/`throw`\n// never needs a declared `with { Error }` row). Only a perform whose\n// qualified operation name's own effect prefix is `ename` gets rewritten\n// into a dict-field call; anything else (in practice, only Error) is left\n// completely untouched and falls through to its own existing codegen\n// (Error compiles unconditionally to a throw/trap, needing no evidence\n// dict or handler machinery at all, regardless of context).\nfn edp_qname_is_for_effect(qname: String, ename: String) -> Bool {\n  let (eff_opt, _) = edp_split_qualified(qname)\n  match eff_opt {\n    Some(e) => e == ename,\n    None => false\n  }\n}\n\nfn edp_rewrite_perform_via_dict(operand: Expr, ename: String, dict_pname: String, needing: Array[String]) -> Expr {\n  match operand {\n    EIdent(qname, _) => if edp_qname_is_for_effect(qname, ename) {\n      ECall(EDot(EIdent(dict_pname, -1), edp_strip_effect_prefix(qname, ename), -1, -1), array_empty(), -1)\n    } else {\n      ECall(EIdent(\"perform\", -1), [\n        operand\n      ], -1)\n    },\n    ECall(op_callee, op_args, _) => match op_callee {\n      EIdent(qname, _) => if edp_qname_is_for_effect(qname, ename) {\n        ECall(EDot(EIdent(dict_pname, -1), edp_strip_effect_prefix(qname, ename), -1, -1), edp_rewrite_needing_body_exprs(op_args, ename, dict_pname, needing), -1)\n      } else {\n        ECall(EIdent(\"perform\", -1), [\n          ECall(op_callee, edp_rewrite_needing_body_exprs(op_args, ename, dict_pname, needing), -1)\n        ], -1)\n      },\n      _ => ECall(EIdent(\"perform\", -1), [\n        operand\n      ], -1)\n    },\n    _ => ECall(EIdent(\"perform\", -1), [\n      operand\n    ], -1)\n  }\n}\n\n// --- rewriting a handle site.\n\nfn edp_rewrite_handle_site(body: Expr, arms: Array[(Pat, Expr)], ename: String, needing: Array[String]) -> Expr {\n  let op_names = for a in arms {\n    let (p, _) = a\n    edp_pat_qname(p)\n  }\n  let bind_names = for a in arms {\n    let (p, _) = a\n    edp_pat_bind_names(p)\n  }\n  let prepared_bodies = for a in arms {\n    let (_, ex) = a\n    edp_strip_tail_resume(ex)\n  }\n  let dict_literal = edp_build_dict_literal(ename, op_names, bind_names, prepared_bodies)\n  edp_rewrite_handle_body(body, ename, op_names, bind_names, prepared_bodies, dict_literal, needing)\n}\n\nfn edp_build_dict_literal(ename: String, op_names: Array[String], bind_names: Array[Array[String]], prepared_bodies: Array[Expr]) -> Expr {\n  let fields = array_empty()\n  let mut i = 0\n  while i < Array::length(op_names) {\n    let bare = edp_strip_effect_prefix(Array::get(op_names, i), ename)\n    let params = for n in Array::get(bind_names, i) {\n      (n, None)\n    }\n    let closure = EFn(empty_str_array(), array_empty(), params, None, None, Array::get(prepared_bodies, i))\n    Array::push(fields, (bare, closure))\n    i = i + 1\n  }\n  ERecord(\"\", fields, array_empty())\n}\n\nfn edp_table_lookup(op_names: Array[String], qname: String) -> Int {\n  let mut i = 0\n  let mut found = -1\n  while i < Array::length(op_names) {\n    if Array::get(op_names, i) == qname {\n      found = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nfn edp_bind_args(bind_names: Array[String], actual_args: Array[Expr], prepared_body: Expr) -> Expr {\n  let n = Array::length(bind_names)\n  let mut result = prepared_body\n  let mut i = n - 1\n  while i >= 0 {\n    if i < Array::length(actual_args) {\n      result = ELet(Array::get(bind_names, i), Array::get(actual_args, i), result, -1)\n    } else {\n      ()\n    }\n    i = i - 1\n  }\n  result\n}\n\n// Same completeness requirement as edp_rewrite_needing_body (see that\n// function's doc comment): the handle body's own eligibility was checked\n// with edp_has_unsafe_construct too (edp_all_sites_eligible calls it on\n// each handle site's body), so this traversal must visit every position\n// that check visits or a perform/needing-call reachable only through\n// EWhile/EForIn/ELoop/EUnaryOp/ELabeledArg/EBreak/EContinue/ETuple/EArray/\n// ERecord/EMap/ESpread would pass eligibility but silently stay\n// unrewritten, same failure mode.\nfn edp_rewrite_handle_body(expr: Expr, ename: String, op_names: Array[String], bind_names_list: Array[Array[String]], prepared_bodies: Array[Expr], dict_literal: Expr, needing: Array[String]) -> Expr {\n  match expr {\n    // Same closure-literal handling as edp_rewrite_needing_body: a\n    // `perform ename::Op` inside a closure defined within this handle's\n    // body is spliced the same way as anywhere else in the body (pure\n    // AST substitution of the arm's prepared body, not a runtime\n    // reference -- see edp_splice_perform -- so it's exactly as valid\n    // wherever the closure ends up being called, sync or later).\n    EFn(tps, tbs, params, ret, eff, body) => EFn(tps, tbs, params, ret, eff, edp_rewrite_handle_body(body, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    // Same nested-EHandle handling as edp_rewrite_needing_body: recurse\n    // into a DIFFERENT effect's nested handle (splicing any `perform\n    // ename::Op` found inside it exactly like anywhere else in this\n    // handle's own body); one matching `ename` itself never reaches here\n    // (eligibility already rejected it as unconditionally unsafe).\n    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {\n      expr\n    } else {\n      EHandle(edp_rewrite_handle_body(body, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), for a in arms {\n        let (p, ex) = a\n        (p, edp_rewrite_handle_body(ex, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))\n      })\n    },\n    EIf(c, t, e) => EIf(edp_rewrite_handle_body(c, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(t, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(e, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EMatch(s, arms) => EMatch(edp_rewrite_handle_body(s, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), for a in arms {\n      let (p, ex) = a\n      (p, edp_rewrite_handle_body(ex, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))\n    }),\n    EWhile(c, b) => EWhile(edp_rewrite_handle_body(c, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, edp_rewrite_handle_body(it, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    ELoop(pairs, b) => ELoop(for p in pairs {\n      let (n, v) = p\n      (n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))\n    }, edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    ELet(n, v, b, off) => ELet(n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), off),\n    ELetMut(n, v, b, off) => ELetMut(n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), off),\n    ELetRec(n, v, b) => ELetRec(n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    ESeq(a, b) => ESeq(edp_rewrite_handle_body(a, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EAssign(n, v, c) => EAssign(n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(c, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(c, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EReturn(e2) => EReturn(edp_rewrite_handle_body(e2, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    // Same bare-`.field`-read handling as edp_rewrite_needing_body: only\n    // the object expression can hide anything that needs rewriting.\n    EDot(o, f, off1, off2) => EDot(edp_rewrite_handle_body(o, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), f, off1, off2),\n    ECall(callee, args, off) => match callee {\n      EIdent(nm, _) => if nm == \"perform\" && Array::length(args) == 1 {\n        edp_splice_perform(Array::get(args, 0), op_names, bind_names_list, prepared_bodies)\n      } else if edp_str_array_contains(needing, nm) {\n        ECall(callee, edp_prepend_expr(dict_literal, edp_rewrite_handle_body_exprs(args, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)), off)\n      } else {\n        ECall(callee, edp_rewrite_handle_body_exprs(args, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), off)\n      },\n      _ => ECall(callee, edp_rewrite_handle_body_exprs(args, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), off)\n    },\n    EBinOp(op, l, r) => EBinOp(op, edp_rewrite_handle_body(l, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(r, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EUnaryOp(op, e2) => EUnaryOp(op, edp_rewrite_handle_body(e2, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e2) => Some(edp_rewrite_handle_body(e2, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n      None => None\n    }),\n    EContinue(args) => EContinue(edp_rewrite_handle_body_exprs(args, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    ETuple(elems) => ETuple(edp_rewrite_handle_body_exprs(elems, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    EArray(elems) => EArray(edp_rewrite_handle_body_exprs(elems, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    ERecord(n, fields, tas) => ERecord(n, for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))\n    }, tas),\n    EMap(fields) => EMap(for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))\n    }),\n    ESpread(e2) => ESpread(edp_rewrite_handle_body(e2, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),\n    _ => expr\n  }\n}\n\nfn edp_rewrite_handle_body_exprs(exprs: Array[Expr], ename: String, op_names: Array[String], bind_names_list: Array[Array[String]], prepared_bodies: Array[Expr], dict_literal: Expr, needing: Array[String]) -> Array[Expr] {\n  for e in exprs {\n    edp_rewrite_handle_body(e, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)\n  }\n}\n\nfn edp_prepend_expr(v: Expr, args: Array[Expr]) -> Array[Expr] {\n  Array::concat([\n    v\n  ], args)\n}\n\nfn edp_splice_perform(operand: Expr, op_names: Array[String], bind_names_list: Array[Array[String]], prepared_bodies: Array[Expr]) -> Expr {\n  match operand {\n    EIdent(qname, _) => edp_splice_or_leave(qname, array_empty(), operand, op_names, bind_names_list, prepared_bodies),\n    ECall(op_callee, op_args, _) => match op_callee {\n      EIdent(qname, _) => edp_splice_or_leave(qname, op_args, operand, op_names, bind_names_list, prepared_bodies),\n      _ => ECall(EIdent(\"perform\", -1), [\n        operand\n      ], -1)\n    },\n    _ => ECall(EIdent(\"perform\", -1), [\n      operand\n    ], -1)\n  }\n}\n\nfn edp_splice_or_leave(qname: String, actual_args: Array[Expr], original_operand: Expr, op_names: Array[String], bind_names_list: Array[Array[String]], prepared_bodies: Array[Expr]) -> Expr {\n  let idx = edp_table_lookup(op_names, qname)\n  if idx < 0 {\n    ECall(EIdent(\"perform\", -1), [\n      original_operand\n    ], -1)\n  } else {\n    edp_bind_args(Array::get(bind_names_list, idx), actual_args, Array::get(prepared_bodies, idx))\n  }\n}\n\n// Find every `EHandle` whose arms discharge `ename` and rewrite it via\n// edp_rewrite_handle_site, in the SAME traversal that finds it -- no\n// separate \"collect, then re-find by structural equality\" step.\n//\n// An earlier version collected handle sites (edp_collect_handle_sites)\n// and re-located each one afterward via a hand-rolled structural-equality\n// check (edp_same_handle/edp_expr_eq) covering only a handful of Expr\n// constructors (EIdent/ECall/ESeq/ELet/EBinOp/EAssign/EInt). Any handle\n// body containing an Expr shape outside that list -- EIf being the first\n// one actually hit -- made edp_expr_eq silently return false for the\n// handle's own body compared against itself, so edp_replace_handle_in_\n// stmts never found a match and left the ORIGINAL, unmodified handle body\n// in place. Meanwhile edp_rewrite_needing_fn (which locates functions by\n// NAME via fn_defs, not by re-matching an Expr) had already prepended the\n// evidence-dict parameter to the needing function's signature regardless\n// -- producing exactly the inconsistent state that crashed at the wasm\n// level (\"not enough arguments on the stack for call\"): a callee expecting\n// N+1 params, called from an unrewritten site still passing N. This was\n// the actual root cause of the branch-nested-call bug (docs/effect-\n// evidence-passing.md \"追記 4\"/\"追記 6\"), not the EIf/local_names\n// interaction originally suspected -- runtime instrumentation of\n// compile_call.vibe's local_idx_hint/fn_idx_in_list dispatch (which\n// correctly selected the direct-call path) ruled that out.\n//\n// This single-pass design can't have that failure mode: a handle is\n// rewritten the moment it's found, so there is no second \"find it again\"\n// step to fail. By this point (called only from edp_apply_migration,\n// itself only reached when edp_all_sites_eligible returned true for\n// `ename`), EVERY handle whose arms discharge `ename` anywhere in the\n// whole program is already known-eligible, so unconditionally rewriting\n// every occurrence found here is sound -- eligibility, not this\n// traversal, is what decides whether rewriting was safe to attempt at\n// all.\nfn edp_find_rewrite_handles(expr: Expr, ename: String, needing: Array[String]) -> Expr {\n  match expr {\n    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {\n      edp_rewrite_handle_site(body, arms, ename, needing)\n    } else {\n      EHandle(edp_find_rewrite_handles(body, ename, needing), for a in arms {\n        let (p, ex) = a\n        (p, edp_find_rewrite_handles(ex, ename, needing))\n      })\n    },\n    EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, edp_find_rewrite_handles(b, ename, needing)),\n    ELet(n, v, b, off) => ELet(n, edp_find_rewrite_handles(v, ename, needing), edp_find_rewrite_handles(b, ename, needing), off),\n    ELetMut(n, v, b, off) => ELetMut(n, edp_find_rewrite_handles(v, ename, needing), edp_find_rewrite_handles(b, ename, needing), off),\n    ELetRec(n, v, b) => ELetRec(n, edp_find_rewrite_handles(v, ename, needing), edp_find_rewrite_handles(b, ename, needing)),\n    ESeq(a, b) => ESeq(edp_find_rewrite_handles(a, ename, needing), edp_find_rewrite_handles(b, ename, needing)),\n    EIf(c, t, e) => EIf(edp_find_rewrite_handles(c, ename, needing), edp_find_rewrite_handles(t, ename, needing), edp_find_rewrite_handles(e, ename, needing)),\n    EMatch(s, arms) => EMatch(edp_find_rewrite_handles(s, ename, needing), for a in arms {\n      let (p, ex) = a\n      (p, edp_find_rewrite_handles(ex, ename, needing))\n    }),\n    EWhile(c, b) => EWhile(edp_find_rewrite_handles(c, ename, needing), edp_find_rewrite_handles(b, ename, needing)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, edp_find_rewrite_handles(it, ename, needing), edp_find_rewrite_handles(b, ename, needing)),\n    ECall(callee, args, off) => ECall(edp_find_rewrite_handles(callee, ename, needing), for a in args {\n      edp_find_rewrite_handles(a, ename, needing)\n    }, off),\n    EBinOp(op, l, r) => EBinOp(op, edp_find_rewrite_handles(l, ename, needing), edp_find_rewrite_handles(r, ename, needing)),\n    EUnaryOp(op, e2) => EUnaryOp(op, edp_find_rewrite_handles(e2, ename, needing)),\n    EAssign(n, v, c) => EAssign(n, edp_find_rewrite_handles(v, ename, needing), edp_find_rewrite_handles(c, ename, needing)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_find_rewrite_handles(v, ename, needing), edp_find_rewrite_handles(c, ename, needing)),\n    EDot(o, f, off1, off2) => EDot(edp_find_rewrite_handles(o, ename, needing), f, off1, off2),\n    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_find_rewrite_handles(v, ename, needing)),\n    EReturn(e2) => EReturn(edp_find_rewrite_handles(e2, ename, needing)),\n    EBreak(opt) => EBreak(match opt {\n      Some(e2) => Some(edp_find_rewrite_handles(e2, ename, needing)),\n      None => None\n    }),\n    EContinue(args) => EContinue(for a in args {\n      edp_find_rewrite_handles(a, ename, needing)\n    }),\n    ETuple(elems) => ETuple(for a in elems {\n      edp_find_rewrite_handles(a, ename, needing)\n    }),\n    EArray(elems) => EArray(for a in elems {\n      edp_find_rewrite_handles(a, ename, needing)\n    }),\n    ERecord(n, fields, tas) => ERecord(n, for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_find_rewrite_handles(v, ename, needing))\n    }, tas),\n    EMap(fields) => EMap(for f in fields {\n      let (fn2, v) = f\n      (fn2, edp_find_rewrite_handles(v, ename, needing))\n    }),\n    ESpread(e2) => ESpread(edp_find_rewrite_handles(e2, ename, needing)),\n    ELoop(pairs, b) => ELoop(for p in pairs {\n      let (n, v) = p\n      (n, edp_find_rewrite_handles(v, ename, needing))\n    }, edp_find_rewrite_handles(b, ename, needing)),\n    _ => expr\n  }\n}\n")
}

let cli_adapter_source_213 = () -> (String, String) {
  ("lib/@vibe/compiler/entry/source_compile/wasi_only/index.vpkg",
"version 0.0.1\n\n// @vibe/compiler/entry/source_compile/wasi_only — ADR-0070 / #897 compiler-\n// internal contract, part of entry/'s own explicit \"high risk\" sub-batch\n// (issue #897 body: \"高リスク (要個別設計判断)... entry/ とそのサブディレ\n// クトリ\"), migrated alongside entry/compiler/, entry/compiler/fs_compile/,\n// and entry/source_compile/ in the same batch. Its sibling\n// entry/source_compile/gc_only/ (the wasm-gc-backend analogue) was already\n// migrated in an earlier #897 batch -- see that package's index.vpkg for\n// the simpler single-file shape this directory does NOT have.\n//\n// Directory-shared-scope package: 22 impl files (~1164 lines), of which\n// only 13 carry a REAL exported def (`export fn`) -- the other 9 are pure\n// re-export shims, each pairing a genuine `export ./sibling.vibe { name }`\n// cross-file SReExport with a redundant bare `export { name }` block for\n// the same name (harmless: check_contract's collect_reexported_names only\n// looks at the SReExport form, so the trailing bare block is inert). The\n// 13 real-def files, grouped below: linked_artifacts.vibe (4),\n// linked_library.vibe (1), merge_sources.vibe (2), preprocess_compile.vibe\n// (4), preprocess_interp.vibe (1), preprocess_interp_parse.vibe (1),\n// preprocess_interp_rewrite_impl.vibe (1), preprocess_interp_string_build.vibe\n// (1), preprocess_interp_string_collect.vibe (1),\n// preprocess_interp_string_fold_core.vibe (1),\n// preprocess_interp_string_fold_loop.vibe (1),\n// preprocess_interp_string_fold_nonempty.vibe (1), preprocess_strip.vibe (1)\n// -- 20 names total, all declared below.\n//\n// Deliberately NOT declared (the #847-documented trap this migration keeps\n// hitting): path_utils.vibe's `empty_stmt_array` and linked_helpers.vibe's\n// `path_to_module_name` / `resolve_reexport_chain` are each a PRIVATE local\n// `fn` (no `export` on the fn itself) promoted to sibling-file visibility\n// ONLY via a trailing bare `export { name }` block -- collect_impl_fn_defs\n// sees them with `exported = false` (the SLet node's own flag, unaffected\n// by a later bare SExport), so declaring them here would fail check_contract\n// with \"implemented but not exported by its implementation file\" (the exact\n// documented trap for the bare `export {}` promotion shape). Nothing outside\n// this directory ever imported them by that name pre-migration either (only\n// sibling files did, via directory-shared scope / leaf imports within the\n// same directory, both still legal post-migration) -- confirmed via a\n// repo-wide grep, not assumed. merge_sources.vibe's `collect_merged_stmts_recursive`\n// is the same private+bare-exported shape and is likewise undeclared.\n//\n// Naming: no collision (wasi_only/wasi_only.vibe did not exist, mirroring\n// gc_only/gc_only.vibe's sibling precedent), old index.vibe moved verbatim\n// to wasi_only.vibe.\n//\n// External-caller fixes (literal leaf-path references into this directory\n// from OUTSIDE it, now that enforce_incoming_boundary_fs rejects them once\n// this directory is a package boundary):\n//   - lib/@vibe/compiler/index.vibe: `./entry/source_compile/wasi_only/index.vibe\n//     { compile_source_wasi_only, compile_source_wasi_only_rc }` -> bare\n//     `./entry/source_compile/wasi_only { .. }` package form.\n//   - tests/compiler_fs_test.vibe: had BOTH a leaf import of\n//     linked_artifacts.vibe (`collect_linked_compile_inputs`) and an\n//     existing package-form import in the same file -- merged into the one\n//     package-form import.\n//   - cli_adapter.vibe: two leaf imports (preprocess.vibe, merge_sources.vibe)\n//     merged into one package-form import.\n//   - cli_support.vibe: three leaf imports (linked_artifacts.vibe,\n//     preprocess_interp.vibe, linked_library.vibe) merged into one\n//     package-form import; the FOURTH leaf import (path_utils.vibe's\n//     `empty_stmt_array`) is dropped entirely rather than routed through the\n//     package form, since `empty_stmt_array` is one of the undeclared\n//     private names above (see that trap note) -- its body is a one-line\n//     forward to `@vibe/core`'s generic `array_empty[T]()`, already imported\n//     in cli_support.vibe under its own name, so the two call sites just\n//     call `array_empty()` directly instead.\n//   - selfbuild_gate_sources_b.vibe: five string-literal fixtures embedding\n//     `import ./entry/source_compile/wasi_only/index.vibe { .. }` as source\n//     TEXT (compiled via the FS lane, not parsed as this file's own\n//     imports) now target `./entry/source_compile/wasi_only/wasi_only.vibe`\n//     -- the renamed leaf file -- keeping each fixture's original \"leaf\n//     import of an internal file\" test shape intact (same fix codegen/'s\n//     own batch made for its analogous `./codegen/index.vibe` fixtures).\n//\n// No import cycle found: none of this directory's own dependencies\n// (checker/, codegen/wasi, codegen/common_base, core/, syntax/,\n// module_graph_path.vibe -- all already vpkg or plain leaf files) import\n// back into entry/source_compile/wasi_only/.\n//\n// Compiled into the compiler itself via compiler_sources_manifest.tsv\n// (group `entry`): the old single `entry/source_compile/wasi_only/index.vibe`\n// row becomes a dual row (this contract + wasi_only.vibe); the other 21\n// sibling files already had their own rows and are unchanged.\n//\n// No exported types: Stmt/Expr (../../../core) and Token (../../../syntax)\n// arrive as structural signature text (loader/runtime/core precedent -- no\n// re-import needed here).\n\n// --- linked_artifacts.vibe\nfn collect_linked_dep_inputs_for_stmts(entry_path: String, entry_stmts: Array[Stmt]) -> (Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs }\nfn collect_linked_compile_inputs(entry_path: String) -> (Array[Stmt], Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs }\nfn compile_file_wasi_linked_artifacts(entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)], Array[(String, String)]) with { Error, Fs }\nfn compile_file_wasi_linked(entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)]) with { Error, Fs }\n\n// --- linked_library.vibe\nfn compile_file_wasi_library(dep_path: String) -> Bytes with { Error, Fs }\n\n// --- merge_sources.vibe\nfn merged_program_source_fs(entry_path: String) -> String with { Error, Fs }\nfn compile_file_wasi_only(entry_path: String, entry_name: String) -> Bytes with { Error, Fs }\n\n// --- preprocess_compile.vibe\nfn compile_source_wasi_only(source: String, entry_name: String) -> Bytes with { Error }\nfn compile_source_wasi_only_coverage(source: String, entry_name: String) -> Bytes with { Error }\nfn compile_source_wasi_only_rc(source: String, entry_name: String) -> Bytes with { Error }\nfn compile_source_wasi_only_rc_shadow(source: String, entry_name: String) -> Bytes with { Error }\n\n// --- preprocess_interp.vibe\nfn expand_interp_stmts(stmts: Array[Stmt]) -> Unit with { Error }\n\n// --- preprocess_interp_parse.vibe\nfn parse_interp_expr(tokens: Array[Token]) -> Expr with { Error }\n\n// --- preprocess_interp_rewrite_impl.vibe\nfn rewrite_interp(e: Expr) -> Expr with { Error }\n\n// --- preprocess_interp_string_build.vibe\nfn rewrite_interp_string(parts: Array[String]) -> Expr with { Error }\n\n// --- preprocess_interp_string_collect.vibe\nfn collect_interp_exprs(parts: Array[String]) -> Array[Expr] with { Error }\n\n// --- preprocess_interp_string_fold_core.vibe\nfn fold_interp_exprs(result_arr: Array[Expr]) -> Expr\n\n// --- preprocess_interp_string_fold_loop.vibe\nfn fold_interp_exprs_loop(result_arr: Array[Expr], result_len: Int, result0: Expr, j0: Int) -> Expr\n\n// --- preprocess_interp_string_fold_nonempty.vibe\nfn fold_interp_exprs_nonempty(result_arr: Array[Expr], result_len: Int) -> Expr\n\n// --- preprocess_strip.vibe\nfn strip_generic_type_params(stmts: Array[Stmt]) -> Unit\n\n// --- component_codegen.vibe (relocated here from compiler/ top level,\n// #897 batch; single real external consumer was this directory's own\n// preprocess_compile.vibe, now an ordinary same-package sibling reference)\nfn comp_generate_string_trampoline(string_param_count: Int, call_run_init: Int) -> Bytes\nfn comp_emit_component_wasm(core_wasm: Bytes) -> Bytes\nfn comp_emit_component_wasm_with_lift(core_wasm: Bytes, export_name: String) -> Bytes\nfn comp_emit_component_wasm_with_string_lift(core_wasm: Bytes, target_func_name: String, export_name: String, string_param_count: Int, param_names: Array[String], is_async: Int) -> Bytes\nfn comp_emit_component_wasm_async(core_wasm: Bytes, export_name: String, result_valtype: Int) -> Bytes\nfn comp_emit_component_wasm_async_trampolined(main_core_wasm: Bytes, export_name: String, comp_result_valtype: Int) -> Bytes\nfn comp_emit_component_wasm_async_trampolined_p1(main_core_wasm: Bytes, export_name: String, comp_result_valtype: Int) -> Bytes\nfn comp_generate_string_trampoline_packed(string_param_count: Int) -> Bytes\nfn comp_emit_component_wasm_string_handler(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with { Error }\n")
}

