f, addr_l)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_v128_store(buf, 0, 0)\n      // push (box | 1)\n      emit_local_get(buf, box_l)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl + 3\n    }\n    else if !prefer_bound_call && fname == \"v128_store\" {\n      // v128_store(bytes, off, v) -> Unit. addr as in v128_load; store v's box.\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)\n      let v_l = nl\n      let off_l = nl + 1\n      let addr_l = nl + 2\n      Array::push(local_names, \"__v128_v\")\n      Array::push(local_names, \"__v128_soff\")\n      Array::push(local_names, \"__v128_saddr\")\n      // stack: bytesval, offval, vval. Save v, off; compute addr.\n      emit_local_set(buf, v_l)\n      emit_local_set(buf, off_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_load(buf, 2, 8)\n      emit_local_get(buf, off_l)\n      // #705: untag off under RC (see v128_load above).\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i32_add(buf)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, addr_l)\n      // v128.store(addr, v128.load(v_box))\n      emit_local_get(buf, addr_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, v_l)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_v128_store(buf, 0, 0)\n      // Unit\n      emit_i64_const(buf, 0)\n      nl + 3\n    }\n    else if !prefer_bound_call && fname == \"v128_splat_i8x16\" {\n      // v128_splat_i8x16(n) -> V128. low byte of n broadcast to 16 lanes.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let box_l = nl\n      let byte_l = nl + 1\n      Array::push(local_names, \"__v128_box\")\n      Array::push(local_names, \"__v128_byte\")\n      // stack: nval (i64). Save it; wrap to i32 only when feeding i8x16.splat.\n      emit_local_set(buf, byte_l)\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, box_l)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, 16)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, box_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, byte_l)\n      // #705: untag n under RC (see v128_load above) -- otherwise the low byte\n      // fed to i8x16.splat is n's tag bit, not n itself (e.g. splat(0xFF)\n      // would broadcast 0xFE).\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i8x16_splat(buf)\n      emit_v128_store(buf, 0, 0)\n      emit_local_get(buf, box_l)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl + 2\n    }\n    else if !prefer_bound_call && (fname == \"v128_eq_i8x16\" || fname == \"v128_le_u_i8x16\" || fname == \"v128_ge_u_i8x16\" || fname == \"v128_and\" || fname == \"v128_or\") {\n      // Binary (V128, V128) -> V128. Load both operands from their boxes, emit\n      // the op, box the result.\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      let b_l = nl\n      let a_l = nl + 1\n      let box_l = nl + 2\n      Array::push(local_names, \"__v128_b\")\n      Array::push(local_names, \"__v128_a\")\n      Array::push(local_names, \"__v128_box\")\n      emit_local_set(buf, b_l)\n      emit_local_set(buf, a_l)\n      // box-alloc 16\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, box_l)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, 16)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      // box.store(op(load(a), load(b)))\n      emit_local_get(buf, box_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, a_l)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_local_get(buf, b_l)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      if fname == \"v128_eq_i8x16\" {\n        emit_i8x16_eq(buf)\n      } else if fname == \"v128_le_u_i8x16\" {\n        emit_i8x16_le_u(buf)\n      } else if fname == \"v128_ge_u_i8x16\" {\n        emit_i8x16_ge_u(buf)\n      } else if fname == \"v128_and\" {\n        emit_v128_and(buf)\n      } else {\n        emit_v128_or(buf)\n      }\n      emit_v128_store(buf, 0, 0)\n      emit_local_get(buf, box_l)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl + 3\n    }\n    else if !prefer_bound_call && fname == \"v128_not\" {\n      // v128_not(v) -> V128.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let v_l = nl\n      let box_l = nl + 1\n      Array::push(local_names, \"__v128_v\")\n      Array::push(local_names, \"__v128_box\")\n      emit_local_set(buf, v_l)\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, box_l)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, 16)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, box_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, v_l)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_v128_not(buf)\n      emit_v128_store(buf, 0, 0)\n      emit_local_get(buf, box_l)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl + 2\n    }\n    else if !prefer_bound_call && fname == \"v128_bitmask_i8x16\" {\n      // v128_bitmask_i8x16(v) -> Int. i8x16.bitmask -> i32; zero-extend to i64.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_i8x16_bitmask(buf)\n      emit_i64_extend_i32_u(buf)\n      // #705: under RC an Int is a tagged scalar (n << 1, see eq/not above);\n      // the bump backend leaves it raw, so only shift under RC.\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      } else {\n        ()\n      }\n      nl\n    }\n    else if !prefer_bound_call && (fname == \"v128_any_true\" || fname == \"v128_all_true_i8x16\") {\n      // (V128) -> Bool. emit op (-> i32 bool), sign-extend to the i64 Bool value.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      if fname == \"v128_any_true\" {\n        emit_v128_any_true(buf)\n      } else {\n        emit_i8x16_all_true(buf)\n      }\n      emit_i64_extend_i32_s(buf)\n      // #705: under RC a Bool is tagged (true = 1<<1, see eq/not above); the\n      // bump backend leaves it raw 0/1, so only shift under RC.\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      } else {\n        ()\n      }\n      nl\n    }\n    else if !prefer_bound_call && fname == \"perform\" {\n      let op_expr = Array::get(args, 0)\n      let op_head = if is_eident(op_expr) {\n        get_eident_name(op_expr)\n      } else if expr_tag(op_expr) == 8 {\n        let op_callee = get_ecall_callee(op_expr)\n        if is_eident(op_callee) {\n          get_eident_name(op_callee)\n        } else {\n          \"\"\n        }\n      } else {\n        \"\"\n      }\n      // #640: `perform Error::Throw(x)` IS `throw(x)`. `Error` is never in\n      // ctx.effect_names (linked_compile.vibe excludes it), so the generic\n      // lowering below would assign it the out-of-range fallback tag 3+n and\n      // a `with Error` handler (which catches tag 2, the EThrow tag — see\n      // compile_expr_tail6.vibe) would never see it. Emit the exact EThrow\n      // sequence instead (compile payload, throw tag 2), skipping the\n      // perform-counter/memo-region machinery — Error is non-resumable.\n      if op_head == \"Error::Throw\" {\n        let mut enl = next_local\n        if expr_tag(op_expr) == 8 && Array::length(get_ecall_args(op_expr)) > 0 {\n          enl = ce(buf, Array::get(get_ecall_args(op_expr), 0), local_names, enl, ctx, ld)\n        } else {\n          emit_i64_const(buf, 0)\n        }\n        bytebuf_push(buf, 8)\n        bytebuf_push(buf, 2)\n        enl\n      } else if String::index_of(op_head, \"Error::\") == 0 {\n        throw(String::concat(\"perform \", String::concat(op_head, \": the builtin Error effect has a single operation, Throw (#640)\")))\n      } else {\n        // ADR-0076 追記34 V2: the perform-counter/memo frontier is gone.\n        // A perform that reaches codegen was NOT migrated by\n        // evidence_dict_pass -- i.e. its effect has no live handle\n        // anywhere (a handled perform is rewritten into a dict call, a\n        // mock over a host-effect label included) -- so at RUNTIME it can\n        // only ever be an unhandled effect: it lowers to a value plus a\n        // bare throw (exactly the old memo-miss leg minus the counter/\n        // memo bookkeeping), which traps if it somehow executes. In\n        // practice these sites are DEAD code that codegen must still\n        // emit (dce-tolerated unreachable wrappers, e.g. lib/@vibe/fs's\n        // perform wrappers in a program that never handles Fs), and the\n        // throw's stack polymorphism is ALSO what keeps them valid: in a\n        // program whose value aliases occupy a canonical builtin name\n        // (`let Fs::read_file = read_file`, fs.vibe #795), the\n        // op_is_builtin leg's recursive compile can resolve into the\n        // alias hijack and leave an inconsistent stack -- harmless under\n        // the throw, an invalid module without it (found live when V2's\n        // first cut dropped the throw for host-mapped ops).\n        let mut nl = next_local\n        let eff_tag = effect_name_to_tag(ctx.effect_names, op_head)\n        let op_canon = canonical_builtin_name(op_head)\n        let op_is_builtin = func_table_index_of(ctx.func_table, op_canon) >= 0\n        if op_is_builtin {\n          nl = ce(buf, op_expr, local_names, nl, ctx, ld)\n        } else if expr_tag(op_expr) == 8 {\n          let op_args = get_ecall_args(op_expr)\n          if Array::length(op_args) > 1 {\n            // Multi-value payload (#548): pack all op args into a tuple (one\n            // heap ref threaded as the single thrown value).\n            nl = ce(buf, ETuple(op_args), local_names, nl, ctx, ld)\n          } else if Array::length(op_args) > 0 {\n            nl = ce(buf, Array::get(op_args, 0), local_names, nl, ctx, ld)\n          } else {\n            emit_i64_const(buf, 0)\n          }\n        } else {\n          emit_i64_const(buf, 0)\n        }\n        bytebuf_push(buf, 8)\n        bytebuf_push(buf, eff_tag)\n        nl\n      }\n    }\n    else if !prefer_bound_call && fname == \"path\" {\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"__loop_tail_retain\" {\n      // #768: codegen-internal marker (retain_wrap_branch_tails,\n      // compile_expr_tail.vibe) -- a loop-borrowed bare ident / projection\n      // escaping an if/match branch as the branch VALUE into a\n      // scope-end-dropped `let`. Compile the read, then guarded rc_dup so the\n      // per-iteration drop consumes the dup, not the loop-carried reference.\n      // Never present in user AST (synthesized during codegen only).\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let v_l = nl\n      Array::push(local_names, \"__ltr_v\")\n      emit_local_set(buf, v_l)\n      emit_rc_dup_guarded(buf, v_l, ctx.rc_shadow)\n      emit_local_get(buf, v_l)\n      nl + 1\n    }\n    else if !prefer_bound_call && (fname == \"Path::ref\" || fname == \"Path::resolve\") && Array::length(args) == 1 {\n      // #762: both resolve their argument to an absolute path against the\n      // process CWD via the `resolve_path` host import. The runtime op is\n      // identical; the effect distinction (Path::ref pure, Path::resolve\n      // `with { Env }`) lives in the checker's builtin signatures.\n      ce(buf, ECall(EIdent(\"resolve_path\", -1), [\n        Array::get(args, 0)\n      ], -1), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Path::to_string\" && Array::length(args) == 1 {\n      // #762: PathRef / DynamicPath wrap a raw String; to_string is identity.\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Path::is_absolute\" && Array::length(args) == 1 {\n      // #762: absolute iff the path begins with '/'. eq(char_code_at(x, 0), 47)\n      // avoids synthesizing a \"/\" string (which would not be in the string\n      // table).\n      ce(buf, ECall(EIdent(\"eq\", -1), [\n        ECall(EIdent(\"String::char_code_at\", -1), [\n          Array::get(args, 0),\n          EInt(0)\n        ], -1),\n        EInt(47)\n      ], -1), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"__float_bits\" {\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Int::to_string\" && Array::length(args) == 1 {\n      // Cheatsheet-documented alias of the integer `__to_string` path (the\n      // argument is Int by signature, so the string-pointer heuristic's int\n      // route applies).\n      ce(buf, ECall(EIdent(\"__to_string\", -1), [\n        Array::get(args, 0)\n      ], -1), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Fs::readdir\" && Array::length(args) == 1 {\n      // #729/#730: readdir's surface is Array[String], but the host import\n      // (`vibe_fs_read_dir_raw`, linked_compile) returns the byte-sorted entry\n      // names \"\\n\"-joined as ONE packed string (same ABI as fs_read_file —\n      // no host-side array building, RC/bump agnostic). Lower to ordinary\n      // AST so String::split's codegen does the array work. An empty dir\n      // returns \"\" which must yield [] — but split(\"\", d) is [\"\"] — hence\n      // the length guard. String pieces are built with String::from_char_code\n      // because a synthesized EString is not in the string table (same\n      // constraint as double_to_string_expr).\n      ce(buf, ELet(\"__rd_names\", ECall(EIdent(\"vibe_fs_read_dir_raw\", -1), [\n        Array::get(args, 0)\n      ], -1), EIf(EBinOp(\"==\", ECall(EIdent(\"String::length\", -1), [\n        EIdent(\"__rd_names\", -1)\n      ], -1), EInt(0)), ECall(EIdent(\"Array::slice\", -1), [\n        EArray([\n          ECall(EIdent(\"String::from_char_code\", -1), [\n            EInt(10)\n          ], -1)\n        ]),\n        EInt(0),\n        EInt(0)\n      ], -1), ECall(EIdent(\"String::split\", -1), [\n        EIdent(\"__rd_names\", -1),\n        ECall(EIdent(\"String::from_char_code\", -1), [\n          EInt(10)\n        ], -1)\n      ], -1)), -1), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"sh_lines\" && Array::length(args) >= 1 {\n      // `sh_lines(cmd) -> Array[String]`: the host import (`vibe_sh_lines_raw`,\n      // linked_compile) runs the command and returns its stdout \"\\n\"-joined as\n      // ONE packed string (same ABI as fs_read_dir). Lower to `String::split`\n      // over it, with the empty-output guard yielding [] (split(\"\", d) is [\"\"]).\n      // #777: any args beyond the first are labeled boolean flags folded\n      // into the command string by `sh_lines_flag_cmd` (single-arg calls are\n      // the common case and pass straight through unchanged).\n      let sh_cmd = sh_lines_flag_cmd(Array::get(args, 0), args, 1)\n      ce(buf, ELet(\"__sh_out\", ECall(EIdent(\"vibe_sh_lines_raw\", -1), [\n        sh_cmd\n      ], -1), EIf(EBinOp(\"==\", ECall(EIdent(\"String::length\", -1), [\n        EIdent(\"__sh_out\", -1)\n      ], -1), EInt(0)), ECall(EIdent(\"Array::slice\", -1), [\n        EArray([\n          ECall(EIdent(\"String::from_char_code\", -1), [\n            EInt(10)\n          ], -1)\n        ]),\n        EInt(0),\n        EInt(0)\n      ], -1), ECall(EIdent(\"String::split\", -1), [\n        EIdent(\"__sh_out\", -1),\n        ECall(EIdent(\"String::from_char_code\", -1), [\n          EInt(10)\n        ], -1)\n      ], -1)), -1), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"__to_string\" && Array::length(args) == 1 && cc_expr_is_floatish(Array::get(args, 0), local_names, ctx) {\n      // #744: a statically-floatish argument takes the synthesized Double\n      // formatter — the generic handler below would stringify the raw f64\n      // bits (or the box pointer under RC) as an integer.\n      ce(buf, double_to_string_expr(Array::get(args, 0)), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"__to_string\" && Array::length(args) == 1 && cc_expr_is_boolish(Array::get(args, 0), local_names, ctx) {\n      // #784: a statically-boolean argument formats as \"true\"/\"false\", not the\n      // integer 1/0 the generic path below would emit. Reuse the existing\n      // if/EString codegen: `if b { \"true\" } else { \"false\" }`.\n      ce(buf, EIf(Array::get(args, 0), EString(\"true\"), EString(\"false\")), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"__to_string\" && Array::length(args) == 1 && cc_expr_is_stringish(Array::get(args, 0), local_names, ctx) {\n      // #950: a statically-String argument IS the result — the generic\n      // handler below already returns a string value unchanged at runtime,\n      // but only after a string-pointer heuristic that requires ptr >= 64,\n      // so the legal packed empty-string encoding 0 (ptr 0, len 0 — e.g.\n      // `String::join([], sep)`'s empty case) was misread as Int 0 and\n      // printed \"0\". Emitting the argument directly is byte-for-byte the\n      // same dataflow as the generic path's string identity branch, minus\n      // the misfiring heuristic. Appending the 0-encoded empty string via\n      // String::concat copies 0 bytes, so `\"[\\{String::join([], \"-\")}]\"`\n      // now renders \"[]\".\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"__to_string\" {\n      let ts_arg0 = Array::get(args, 0)\n      let ts_arg_is_int = ts_known_int(ts_arg0, local_names, ctx)\n      let mut nl = ce(buf, ts_arg0, local_names, next_local, ctx, ld)\n      let val_l = nl\n      let neg_l = nl + 1\n      let cur_l = nl + 2\n      let abs_l = nl + 3\n      let hp_l = nl + 4\n      let len_l = nl + 5\n      Array::push(local_names, \"__ts_val\")\n      Array::push(local_names, \"__ts_neg\")\n      Array::push(local_names, \"__ts_cur\")\n      Array::push(local_names, \"__ts_abs\")\n      Array::push(local_names, \"__ts_hp\")\n      Array::push(local_names, \"__ts_len\")\n      emit_local_set(buf, val_l)\n      emit_block_i64(buf)\n      if ts_arg_is_int {\n        // #678: the argument is statically a known Int (literal or int-bound\n        // local) — never run it through the string-pointer heuristic (a large\n        // int like `1 << 40` has a zero low word and an in-bounds high word, so\n        // it would be misread as an empty string). Force the integer path with\n        // a false (i32) condition — the heuristic below also yields an i32 bool.\n        emit_i32_const(buf, 0)\n      } else {\n        emit_local_get(buf, val_l)\n        emit_i64_const(buf, 32)\n        bytebuf_push(buf, 136)\n        emit_local_tee(buf, abs_l)\n        emit_i64_const(buf, 64)\n        emit_i64_ge_s(buf)\n        emit_local_get(buf, abs_l)\n        // #606: a string is represented as (ptr << 32) | len, and `__to_string`\n        // returns the value unchanged when it looks like a string pointer. A\n        // string can live anywhere in linear memory — including the static data\n        // section (token / literal strings), whose offset is ABOVE the heap bump\n        // pointer during early compilation. The old bound `ptr < heap_ptr`\n        // (global 0) misclassified such strings as ints and stringified their raw\n        // i64, leaking a heap pointer (e.g. labeled param `x~` printed as\n        // `1285664100319233~`). Use the full linear-memory size (memory.size\n        // pages * 65536) as the upper bound so any in-bounds pointer is\n        // recognized; a small int still has a zero high word and takes the int\n        // path below.\n        bytebuf_push(buf, 63)\n        bytebuf_push(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_i64_const(buf, 65536)\n        emit_i64_mul(buf)\n        emit_i64_lt_s(buf)\n        bytebuf_push(buf, 113)\n        // #664: ALSO require the candidate string to FIT in linear memory:\n        // ptr + len <= memory_size. The `ptr < memory_size` bound above is not\n        // enough — a large integer (e.g. a 61-bit `Fs::stat_token`) whose HIGH\n        // word happens to land below memory_size is otherwise misread as a string\n        // pointer, and its LOW word becomes a multi-gigabyte \"length\". The next\n        // `String::concat` then `memory.copy`s that bogus length and traps with\n        // \"memory access out of bounds\" (the #664 crash, triggered during the\n        // persistent-sources-cache write `__to_string(Fs::stat_token(path))`). A\n        // real string always satisfies ptr + len <= memory_size, so adding this\n        // bound keeps genuine strings on the identity path while routing such\n        // large integers back to the integer-stringify path below.\n        emit_local_get(buf, abs_l)\n        emit_local_get(buf, val_l)\n        emit_i64_const(buf, 4294967295)\n        emit_i64_and(buf)\n        emit_i64_add(buf)\n        bytebuf_push(buf, 63)\n        bytebuf_push(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_i64_const(buf, 65536)\n        emit_i64_mul(buf)\n        emit_i64_le_s(buf)\n        bytebuf_push(buf, 113)\n      }\n      emit_if_void(buf)\n      emit_local_get(buf, val_l)\n      emit_br(buf, 1)\n      emit_end(buf)\n      // Under RC a scalar Int is tagged `n << 1` (low bit 0 marks a non-heap\n      // value; see `Int::to_double` / `Double::to_int` which shift to/from this\n      // form). Arithmetic stays in tagged space and compares correctly, but the\n      // digit loop below renders the RAW i64 — so without untagging it prints\n      // `2n` (e.g. 42 -> \"84\"). Recover the logical value with an arithmetic\n      // (sign-preserving) shift right by 1. Strings already returned above via\n      // the `br`, so this only touches the integer path.\n      if ctx.enable_rc {\n        emit_local_get(buf, val_l)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        emit_local_set(buf, val_l)\n      }\n      emit_i64_const(buf, 46)\n      emit_local_set(buf, cur_l)\n      emit_local_get(buf, val_l)\n      emit_i64_const(buf, 0)\n      emit_i64_lt_s(buf)\n      emit_i64_extend_i32_s(buf)\n      emit_local_set(buf, neg_l)\n      emit_local_get(buf, val_l)\n      emit_i64_const(buf, 0)\n      emit_i64_lt_s(buf)\n      emit_if_i64(buf)\n      emit_i64_const(buf, 0)\n      emit_local_get(buf, val_l)\n      emit_i64_sub(buf)\n      emit_else(buf)\n      emit_local_get(buf, val_l)\n      emit_end(buf)\n      emit_local_set(buf, abs_l)\n      emit_local_get(buf, abs_l)\n      emit_i64_eqz(buf)\n      emit_if_void(buf)\n      emit_local_get(buf, cur_l)\n      emit_i32_wrap_i64(buf)\n  