"//# Imports\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32, namespace_exported_name\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  canonical_builtin_name,\n  emit_rc_word_inc_saturating, CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, agg_expr_lookup, agg_slot_lookup, emit_rc_dup_guarded, effect_name_to_tag, effect_op_index, emit_binop_op, emit_box_float, emit_heap_grow_after_heap_set, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_index_one, emit_str_ref, emit_unbox_float, expr_tag, find_local_slot, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, ctor_table_index_of, resolve_func, resolve_local, struct_field_candidates, struct_field_dispatch_cases, double_to_string_expr, int_parse_expr, double_parse_expr\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_const_lohi, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_f64_abs, emit_f64_ceil, emit_f64_floor, emit_f64_max, emit_f64_min, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data, emit_v128_load, emit_v128_store, emit_i8x16_splat, emit_i8x16_eq, emit_i8x16_le_u, emit_i8x16_ge_u, emit_v128_and, emit_v128_or, emit_v128_not, emit_i8x16_bitmask, emit_v128_any_true, emit_i8x16_all_true, emit_v128_const_splat_byte\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\n// A field projection `a.f` (EDot) passed as an argument to an owning user\n// function (which drops its parameters) is a borrow of the source aggregate.\n// Without a retain the callee's param-drop frees it while the source still\n// references it — a double-free that corrupts the free list (e.g. derived\n// `T::equals` passing `a.items` to the consuming `__arr_equals__` helper, #704).\n// #929: non-throwing func-table membership probe (resolve_func throws on a\n// missing name). The println/print fallback lowering below must yield to a\n// SOURCE-provided definition (@vibe/io's println, or a user shadow) whenever\n// one is merged into the program.\nfn cc_ft_has(ft: FuncTable, name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(ft.names) {\n    if Array::get(ft.names, i) == name {\n      found = true\n      i = Array::length(ft.names)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// Perceus emits no action for bare projections, so this guarded dup is the only\n// owner-increment. Scalars are no-ops; this is NOT applied to borrow-arg0\n// builtins (Array::get/length etc.), which do not drop their argument.\nfn cc_is_projection(e: Expr) -> Bool {\n  match e {\n    EDot(_, _, _, _) => true,\n    _ => false\n  }\n}\n\n// #705: a borrow-RETURNING builtin call (`Array::get` / `Map::get` / `__index`)\n// yields a borrowed view of a heap element — its refcount is NOT bumped, like a\n// projection `a.f`. When that result is consumed in an OWNING position (a ctor\n// field, or an owning call arg of a fn that drops its params), it must be\n// rc_dup'd or the container's recursive drop and the consume double-free the\n// same element (e.g. `chk(Array::get(ps, i))` recursing over a heap array, or\n// `validate(s, Map::get(obj, key))`). Scalars are even so the guarded dup is a\n// runtime no-op for `Array[Int]` etc.\nexport fn cc_is_borrow_ret_call(e: Expr, ctx: CompileCtx) -> Bool {\n  match e {\n    ECall(callee, _, _) =>\n    match callee {\n      EIdent(f, _) => f == \"Array::get\" || f == \"Map::get\" || f == \"__index\" || f == \"__rec_field\" || array_contains_str(ctx.borrow_ret_names, f),\n      _ => false\n    },\n    _ => false\n  }\n}\n\n// Is `e` provably a scalar (Int/Bool) by structure alone — an int/bool literal,\n// a bitwise/shift/comparison/logical binop, or a logical `!`? Conservative: no\n// ident-slot/type lookup and no arith ops (+,-,*,/ can be Float). Used to route\n// an explicit `eq(a, b)` to a direct i64.eq when an operand is provably scalar,\n// matching how the `==` binop dispatches intish operands (emit_eq_value). Without\n// this, `eq(int, int)` falls through to the generic bound `eq` whose\n// `looks_like_string`/str_eq fallback reads OOB on ints resembling fat-pointers\n// (#678 residual) — e.g. leb128's `eq(val, 0)` trapped under RC (#705).\nfn cc_arg_is_scalarish(e: Expr) -> Bool with { Error } {\n  let t = expr_tag(e)\n  if t == 0 || t == 1 {\n    true\n  } else if t == 5 {\n    let op = get_ebinop_op(e)\n    op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"==\" || op == \"!=\" || op == \"&&\" || op == \"||\"\n  } else if t == 6 {\n    let uop = get_eunaryop_op(e)\n    // `!x` is Bool; `-x` is scalar iff its operand is (so a negative int literal\n    // like `-1`, which parses as unary minus of `1`, is detected as scalar).\n    uop == \"!\" || (uop == \"-\" && cc_arg_is_scalarish(get_eunaryop_expr(e)))\n  } else {\n    false\n  }\n}\n\n// #745: local mirror of compile_expr_tail's expr_is_floatish/slot_is_floatish\n// (importing them here would be a cycle: compile_expr_tail imports this file).\n// Used to route `eq(a, b)` with a float operand onto the unbox + f64.eq path\n// under RC — the scalar i64.eq below compares BOX POINTERS for boxed floats,\n// so `eq(0.0125, 0.0125)` came out false and the assert trapped.\nfn cc_slot_is_floatish(ctx: CompileCtx, slot: Int) -> Bool {\n  let arr = ctx.float_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 2 == slot {\n      result = (entry % 2) == 1\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\nfn cc_expr_is_floatish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\n  // fbox (#797): mirror of expr_is_floatish's EDot tuple-projection case --\n  // `t.N` on a tracked tuple-literal binding recurses into the backing\n  // ETuple element via the #724 agg log.\n  let dot_float = match e {\n    EDot(dobj, dfield, _, _) => {\n      let fc = String::char_code_at(dfield, 0)\n      if fc >= 48 && fc <= 57 && is_eident(dobj) {\n        let slot = find_local_slot(local_names, get_eident_name(dobj))\n        if slot >= 0 {\n          let info = agg_slot_lookup(ctx.agg_local_slots, slot)\n          if info >= 0 && info / 64 == 1 {\n            let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\n            if is_etuple(backing) {\n              let elems = get_etuple_elems(backing)\n              let mut k = 0\n              let mut fp = 0\n              while fp < String::length(dfield) {\n                k = k * 10 + (String::char_code_at(dfield, fp) - 48)\n                fp = fp + 1\n              }\n              if k >= 0 && k < Array::length(elems) {\n                cc_expr_is_floatish(Array::get(elems, k), local_names, ctx)\n              } else {\n                false\n              }\n            } else {\n              false\n            }\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      } else {\n        false\n      }\n    },\n    _ => false\n  }\n  let tag = expr_tag(e)\n  if dot_float {\n    true\n  } else if tag == 2 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let len = Array::length(local_names)\n    let mut i = len - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      cc_slot_is_floatish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n      cc_expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || cc_expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 6 {\n    let op = get_eunaryop_op(e)\n    if op == \"-\" {\n      cc_expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 8 {\n    let callee = get_ecall_callee(e)\n    if is_eident(callee) {\n      let fname = get_eident_name(callee)\n      if fname == \"Int::to_double\" || fname == \"Int::to_float\" || fname == \"Float::to_double\" || fname == \"Double::to_float\" || fname == \"Double::from_i64_bits\" {\n        true\n      } else if fname == \"__rec_field\" {\n        // fbox (#797): mirror of expr_is_floatish's tuple-projection case --\n        // `t.0` on a tracked tuple-literal binding recurses into the backing\n        // ETuple element via the #724 agg log (heap fields hold raw f64 bits,\n        // so the reader must recover float-ness statically).\n        let args = get_ecall_args(e)\n        if Array::length(args) == 2 && is_eident(Array::get(args, 0)) && expr_tag(Array::get(args, 1)) == 0 {\n          let slot = find_local_slot(local_names, get_eident_name(Array::get(args, 0)))\n          if slot >= 0 {\n            let info = agg_slot_lookup(ctx.agg_local_slots, slot)\n            if info >= 0 && info / 64 == 1 {\n              let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)\n              if is_etuple(backing) {\n                let elems = get_etuple_elems(backing)\n                let k = get_eint_value(Array::get(args, 1))\n                if k >= 0 && k < Array::length(elems) {\n                  cc_expr_is_floatish(Array::get(elems, k), local_names, ctx)\n                } else {\n                  false\n                }\n              } else {\n                false\n              }\n            } else {\n              false\n            }\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      } else {\n        false\n      }\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\n// #950: FIRST-match index of `name` in the func table, or -1 on a miss.\n// Mirrors resolve_func's scan (first match wins) without throwing, so a\n// classifier can ask \"which entry would actually serve this call?\".\nfn cc_ft_first_idx(ft: FuncTable, name: String) -> Int {\n  let len = Array::length(ft.names)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if Array::get(ft.names, i) == name {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// #950: declared return kind of a call whose callee resolves to a BUILTIN —\n// 0 = unknown, 1 = Bool, 2 = String. This is the type-directed half of the\n// interpolation display fix: `\"\\{String::contains(a, b)}\"` printed 1/0 and\n// `\"\\{String::join([], \"-\")}\"` printed 0 (the packed empty-string encoding,\n// misread as Int by __to_string's runtime string-pointer heuristic), because\n// the display classifiers were purely syntactic and never consulted the\n// builtin's declared return type.\n//\n// Shadow-safety (the reason #784 deliberately skipped name-based\n// classification): the func table lays out USER functions first (indices\n// < ctx.num_user_funcs) and appends the registered builtins after them, and\n// call emission resolves FIRST match (resolve_func) / prefers a bound call\n// (prefer_bound_call). So the builtin's declared type only applies when the\n// name is NOT locally bound AND its first func-table match (if any) is NOT a\n// user function. A user/prelude shadow therefore classifies as 0 (unknown),\n// exactly matching what the actual call emission dispatches to. Name sets\n// mirror the checker's declared types (checker/checker.vibe\n// direct_builtin_return / codegen/builtin_registry.vibe).\nexport fn cc_builtin_call_ret_kind(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Int with { Error } {\n  if expr_tag(e) == 8 {\n    let bcallee = get_ecall_callee(e)\n    if is_eident(bcallee) {\n      let bn = canonical_builtin_name(get_eident_name(bcallee))\n      let kind = if bn == \"eq\" || bn == \"not\" || bn == \"String::equals\" || bn == \"String::contains\" || bn == \"String::starts_with\" || bn == \"String::ends_with\" || bn == \"Array::contains\" || bn == \"Array::any\" || bn == \"Array::all\" || bn == \"Map::has_key\" || bn == \"Map::has\" || bn == \"map_has\" || bn == \"Path::is_absolute\" || bn == \"Fs::exists\" || bn == \"Fs::is_dir\" || bn == \"Fs::is_file\" {\n        1\n      } else if bn == \"__to_string\" || bn == \"Int::to_string\" || bn == \"Double::to_string\" || bn == \"Float::to_string\" || bn == \"String::concat\" || bn == \"String::substring\" || bn == \"String::trim\" || bn == \"String::from_char_code\" || bn == \"String::join\" || bn == \"Env::get\" || bn == \"Env::args_get\" || bn == \"Fs::read_file\" || bn == \"Fs::getcwd\" || bn == \"sh\" {\n        2\n      } else {\n        0\n      }\n      if kind == 0 {\n        0\n      } else if find_local_slot(local_names, bn) >= 0 {\n        0\n      } else {\n        let fi = cc_ft_first_idx(ctx.func_table, bn)\n        if fi >= 0 && fi < ctx.num_user_funcs {\n          0\n        } else {\n          kind\n        }\n      }\n    } else {\n      0\n    }\n  } else {\n    0\n  }\n}\n\n// #950: is `e` statically a String? The stringish sibling of\n// cc_expr_is_boolish below (same structure, same slot-log discipline: kind-2\n// entries in ctx.int_local_slots track `let`-bound strings, see\n// compile_expr_tail's slot_is_intish doc). Consumed by the `__to_string`\n// dispatch: a statically-String segment IS the result, so it bypasses the\n// runtime string-pointer heuristic — which misreads the packed empty-string\n// encoding 0 (e.g. `String::join([], sep)`, ptr 0 / len 0) as Int 0 and\n// printed \"0\" for a perfectly legal empty string.\nexport fn cc_expr_is_stringish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\n  let tag = expr_tag(e)\n  if tag == 3 {\n    true\n  } else if tag == 4 {\n    // A bare ident `let`-bound to a stringish value — kind-2 entry in\n    // ctx.int_local_slots (slot*4 + kind). Same scan as the boolish kind-3\n    // lookup below.\n    let nm = get_eident_name(e)\n    let mut i = Array::length(local_names) - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      let arr = ctx.int_local_slots\n      let mut j = Array::length(arr) - 1\n      let mut result = false\n      while j >= 0 {\n        let entry = Array::get(arr, j)\n        if entry / 4 == slot {\n          result = (entry % 4) == 2\n          j = -1\n        } else {\n          j = j - 1\n        }\n      }\n      result\n    } else {\n      false\n    }\n  } else if tag == 9 {\n    cc_expr_is_stringish(get_elet_body(e), local_names, ctx)\n  } else if tag == 10 {\n    cc_expr_is_stringish(get_eletrec_body(e), local_names, ctx)\n  } else if tag == 11 {\n    cc_expr_is_stringish(get_eletmut_body(e), local_names, ctx)\n  } else if tag == 14 {\n    cc_expr_is_stringish(get_eseq_second(e), local_names, ctx)\n  } else if tag == 7 {\n    cc_expr_is_stringish(get_eif_then(e), local_names, ctx) && cc_expr_is_stringish(get_eif_else(e), local_names, ctx)\n  } else if tag == 16 {\n    let arms = get_match_arms(e)\n    let alen2 = Array::length(arms)\n    if alen2 == 0 {\n      false\n    } else {\n      let mut all_str = true\n      let mut si2 = 0\n      while si2 < alen2 {\n        if !cc_expr_is_stringish(get_arm_body(Array::get(arms, si2)), local_names, ctx) {\n          all_str = false\n        } else {\n          ()\n        }\n        si2 = si2 + 1\n      }\n      all_str\n    }\n  } else if tag == 8 {\n    let bcallee = get_ecall_callee(e)\n    if is_efn(bcallee) && Array::length(get_ecall_args(e)) == 1 {\n      // `let s: String = e` ascription marker `((__asc: String) -> __asc)(e)`\n      // — honor the annotation (same shapes as the Bool arm in\n      // cc_expr_is_boolish below, incl. the uniquify-renamed form).\n      let fparams = get_efn_params(bcallee)\n      if Array::length(fparams) == 1 {\n        let (asc_name, asc_ty) = Array::get(fparams, 0)\n        (asc_name == \"__asc\" || (String::starts_with(asc_name, \"__shadow_\") && String::ends_with(asc_name, \"___asc\"))) && (match asc_ty {\n          Some(TyName(tn)) => tn == \"String\",\n          _ => false\n        })\n      } else {\n        false\n      }\n    } else {\n      cc_builtin_call_ret_kind(e, local_names, ctx) == 2\n    }\n  } else {\n    false\n  }\n}\n\n// #784: is `e` statically — BY SHAPE — a Bool via an UNSHADOWABLE form? A bool\n// literal, a comparison / logical binary op, or a `!` unary. These lower directly\n// (operators bypass name resolution) so the classification is always correct.\n// Used to route `\"\\{b}\"` / `__to_string(b)` to a \"true\"/\"false\" formatter instead\n// of the integer path (which prints 1/0, since Bool and Int share the tagged-int\n// runtime representation). Purely syntactic, like `cc_expr_is_floatish`.\n//\n// #950: calls to bool-returning BUILTINS are now classified through\n// cc_builtin_call_ret_kind (see the tag-8 arm), which checks the same\n// user-shadow conditions the actual call emission honors via\n// `prefer_bound_call` — closing the gap #784 documented (a name-only match\n// would have misformatted a shadowed function's result; the shadow-aware\n// lookup does not). A bool bound to a local and then interpolated is covered\n// by the kind-3 slot log. Never fires for an integer expression, so the\n// pervasive `__to_string(<int>)` calls (lengths, offsets, ids) are untouched.\nfn cc_expr_is_boolish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error } {\n  let tag = expr_tag(e)\n  if tag == 1 {\n    true\n  } else if tag == 4 {\n    // #769: a bare ident `let`-bound to a boolish value -- kind-3 entry in\n    // ctx.int_local_slots (slot*4 + kind, see compile_expr_tail's\n    // slot_is_intish). Closes the documented #785-P2 gap where\n    // `let b = true; \"\\{b}\"` printed the raw integer. Duplicated slot scan\n    // (expr_is_boolish lives in compile_expr_tail, which imports this file --\n    // importing back would be circular).\n    let nm = get_eident_name(e)\n    let mut i = Array::length(local_names) - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      let arr = ctx.int_local_slots\n      let mut j = Array::length(arr) - 1\n      let mut result = false\n      while j >= 0 {\n        let entry = Array::get(arr, j)\n        if entry / 4 == slot {\n          result = (entry % 4) == 3\n          j = -1\n        } else {\n          j = j - 1\n        }\n      }\n      result\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    op == \"==\" || op == \"!=\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"&&\" || op == \"||\"\n  } else if tag == 6 {\n    get_eunaryop_op(e) == \"!\"\n  } else if tag == 16 {\n    // #815: an `is` expression desugars at parse time to a match whose arms\n    // all return Bool literals — classify such a match as boolish so\n    // `\"\\{opt is None}\"` prints true/false instead of the raw 0/1.\n    // #825: arm bodies recurse through cc_expr_is_boolish (not just Bool\n    // literals), because the structural `==` dispatch on Option/Result/tuple\n    // lowers to nested matches whose leaf arms are `==`/`&&` chains and Bool\n    // literals — so `\"\\{Some(1) == Some(1)}\"` prints true, not 1.\n    let arms = get_match_arms(e)\n    let alen2 = Array::length(arms)\n    if alen2 == 0 {\n      false\n    } else {\n      let mut all_bool = true\n      let mut bi2 = 0\n      while bi2 < alen2 {\n        if !cc_expr_is_boolish(get_arm_body(Array::get(arms, bi2)), local_names, ctx) {\n          all_bool = false\n        } else {\n          ()\n        }\n        bi2 = bi2 + 1\n      }\n      all_bool\n    }\n  } else if tag == 9 {\n    // #825: the normalize pass lifts a non-ident match scrutinee into\n    // `let __m_scrut_N = <e> in match ...` (lift_match_scrutinees), so a\n    // boolish match arrives here wrapped in a let — classify by the BODY.\n    // Same for the other body-position wrappers below.\n    cc_expr_is_boolish(get_elet_body(e), local_names, ctx)\n  } else if tag == 10 {\n    cc_expr_is_boolish(get_eletrec_body(e), local_names, ctx)\n  } else if tag == 11 {\n    cc_expr_is_boolish(get_eletmut_body(e), local_names, ctx)\n  } else if tag == 14 {\n    cc_expr_is_boolish(get_eseq_second(e), local_names, ctx)\n  } else if tag == 7 {\n    // An if-expression is boolish when BOTH branches are.\n    cc_expr_is_boolish(get_eif_then(e), local_names, ctx) && cc_expr_is_boolish(get_eif_else(e), local_names, ctx)\n  } else if tag == 8 {\n    // #815: the `==` desugar rewrites array equality to the compiler-emitted\n    // `__arr_equals__<key>` helper and struct/enum equality to `T::equals`\n    // (both Bool-returning), so the EBinOp shape above is gone by codegen.\n    // `__arr_equals__` is a reserved compiler prefix; `::equals` (2 args) is\n    // the == rewrite's exact output shape. A `not(...)` wrap (the `!=`\n    // rewrite's output) is classified only when its single argument is itself\n    // boolish AND `not` is not locally shadowed (display-only risk, see the\n    // expr_is_boolish twin in compile_expr_tail.vibe).\n    let bcallee = get_ecall_callee(e)\n    if is_eident(bcallee) {\n      let bcn = get_eident_name(bcallee)\n      String::starts_with(bcn, \"__arr_equals__\") || (String::ends_with(bcn, \"::equals\") && Array::length(get_ecall_args(e)) == 2) || (bcn == \"not\" && Array::length(get_ecall_args(e)) == 1 && find_local_slot(local_names, \"not\") < 0 && cc_expr_is_boolish(Array::get(get_ecall_args(e), 0), local_names, ctx)) || cc_builtin_call_ret_kind(e, local_names, ctx) == 1\n    } else if is_efn(bcallee) && Array::length(get_ecall_args(e)) == 1 {\n      // #815: `let x: Bool = e` parses to the ascription marker\n      // `((__asc: Bool) -> __asc)(e)` (see parser_expr_dispatch's\n      // ascribe_wrap) — honor the annotation so the binding's slot is logged\n      // boolish even when `e` itself is opaque.\n      // The SECOND and later ascriptions in one function arrive with the\n      // param renamed to `__shadow_<n>___asc` (normalize's\n      // uniquify_shadowed_bindings; per-function `seen` de-dup), so match\n      // that renamed form too — otherwise only the first annotated let per\n      // function was classified (#825 follow-up).\n      let fparams = get_efn_params(bcallee)\n      if Array::length(fparams) == 1 {\n        let (asc_name, asc_ty) = Array::get(fparams, 0)\n        (asc_name == \"__asc\" || (String::starts_with(asc_name, \"__shadow_\") && String::ends_with(asc_name, \"___asc\"))) && (match asc_ty {\n          Some(TyName(tn)) => tn == \"Bool\",\n          _ => false\n        })\n      } else {\n        false\n      }\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\n// #706: is `e` a bare reference to a value live-in to an enclosing loop (and not\n// a `mut` ref-cell, whose reassignment already manages its own drop)? Passing\n// such a value to a consuming (owning) parameter inside the loop frees it on the\n// first iteration; dup'ing at the call site keeps the loop-carried reference\n// alive across the back-edge. rc_dup is a no-op on scalars, so a scalar loop var\n// caught here costs only a wasted (guarded) dup, not a correctness problem.\nexport fn cc_is_loop_borrowed_ident(e: Expr, ctx: CompileCtx) -> Bool {\n  match e {\n    EIdent(name, _) =>\n    array_contains_str(ctx.loop_borrowed_names, name) && !array_contains_str(ctx.ref_cell_names, name),\n    _ => false\n  }\n}\n\n// Builtins whose arg0 is BORROWED (read in place, not consumed/dropped). Kept in\n// sync with `is_borrow_arg0_call` in perceus/index.vibe — a projection passed as\n// arg0 to one of these must NOT be rc_dup'd at the call site (the callee never\n// drops it, so the dup would leak; #704). Other argument positions are owning.\nfn cc_is_borrow_arg0_call(f: String) -> Bool {\n  f == \"__index\" || f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Array::push\" || f == \"ArrayBuilder::push\" || f == \"StringBuilder::push\" || f == \"MapBuilder::set\" || f == \"Map::get\" || f == \"Map::keys\" || f == \"Map::has_key\" || f == \"Map::has\" || f == \"Map::set\" || f == \"Map::size\" || f == \"Map::values\" || f == \"Map::delete\" || f == \"Bytes::push\" || f == \"Bytes::set\" || f == \"Bytes::get\" || f == \"Bytes::length\" || f == \"__rec_field\"\n}\n\n// #745: retain a borrowed argument that a STORING inline builtin (Map::set /\n// MapBuilder::set key+value) keeps a reference to. The generic owning-call\n// path already dups projection / borrow-returning-call / loop-borrowed args\n// (see the `__argdup` sites below), but the inline-emitted builtins compile\n// their args directly and skipped it — json's `build_json_map` stored\n// `Array::get(vals, i)` un-retained, and once `vals` died the map's entry\n// pointed at freed memory (ctor match on `Map::get` then read garbage).\n// Expects the freshly compiled arg on the wasm stack; leaves it there.\nfn cc_retain_stored_arg(buf: Bytes, carg: Expr, local_names: Array[String], nl: Int, ctx: CompileCtx) -> Int with { Error } {\n  let is_loop_borrow = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx)\n  if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow) {\n    // #706 leak follow-up: a loop-borrowed trigger needs the epilogue's\n    // compensating drop, same as the generic path's `__argdup` sites.\n    if is_loop_borrow {\n      Array::push(ctx.loop_consumed_names, get_eident_name(carg))\n    } else {\n      ()\n    }\n    Array::push(local_names, \"__argdup\")\n    emit_local_tee(buf, nl)\n    emit_rc_dup_guarded(buf, nl, ctx.rc_shadow)\n    nl + 1\n  } else {\n    nl\n  }\n}\n\n// #664/#678: is `e` statically — BY SHAPE — a known integer that must NOT be run\n// through `__to_string`'s string-pointer heuristic (which misreads a large int\n// as an empty string)? An Int literal, or a bitwise/shift/mod expression (those\n// operators are never float or string). Bare idents are deliberately excluded:\n// a per-slot \"is int\" log is unsound because slots are reused across scopes\n// without updating it. Covers `\"\\{1 << 40}\"` and integer-literal interpolation.\nfn ts_known_int(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool {\n  let tag = expr_tag(e)\n  if tag == 0 {\n    true\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\"\n  } else if tag == 8 {\n    // #769 (#664 follow-up): a DIRECT call to a known Int-returning builtin is\n    // statically an Int -- force the integer path. The #664 runtime bound\n    // (`ptr + len <= memory_size`) is load-dependent: once the process has\n    // grown to hundreds of MB (a cold full-closure FS compile), a 61-bit\n    // `Fs::stat_token` hash whose high word lands below memory_size and whose\n    // low word keeps ptr+len in bounds passes the string-pointer heuristic and\n    // is emitted as GARBAGE BYTES (observed: a deterministic ~100MB\n    // persistent-source-groups cache row for one specific file, \"invalid\n    // persistent source group cache group row\" on re-read). The bound can\n    // never be airtight for 61-bit hashes; static knowledge is.\n    match get_ecall_callee(e) {\n      EIdent(cn, _) => cn == \"Fs::stat_token\" || cn == \"vibe_fs_stat_token_raw\" || cn == \"Profiler::now_us\" || cn == \"Profiler::heap_bytes\" || cn == \"Env::args_len\" || cn == \"String::length\" || cn == \"Array::length\" || cn == \"Bytes::length\" || cn == \"String::char_code_at\" || cn == \"String::index_of\" || cn == \"String::last_index_of\" || cn == \"Stdin::read_char\",\n      _ => false\n    }\n  } else {\n    false\n  }\n}\n\n// A synthesized `EString` literal is NOT in the compile unit's string table\n// (same constraint double_to_string_expr documents) — a flag label is only\n// known at codegen time, so it can't have been pre-interned like a literal\n// from the original source. Build it char-by-char via `String::from_char_code`\n// + `String::concat` instead, exactly like double_to_string_expr's `ch_minus`\n// / `ch_dot` pieces. `s` must be non-empty (callers only pass \" -<label>\").\nfn uninterned_string_expr(s: String, i: Int) -> Expr {\n  let ch = ECall(EIdent(\"String::from_char_code\", -1), [\n    EInt(String::char_code_at(s, i))\n  ], -1)\n  if i >= String::length(s) - 1 {\n    ch\n  } else {\n    ECall(EIdent(\"String::concat\", -1), [\n      ch,\n      uninterned_string_expr(s, i + 1)\n    ], -1)\n  }\n}\n\n// #777: `sh_lines(cmd, flag1 = boolExpr1, flag2 = boolExpr2, ...)` — extra\n// labeled boolean args (beyond the command string) become `-<label>`\n// appended to the command when the labeled expression is true, so callers\n// can write `sh_lines(\"ls\", a = true)` instead of building the flag string\n// by hand. NOTE: argument labels are NOT part of a general keyword-argument\n// feature here — labels are purely decorative for ordinary calls (args\n// still bind positionally), so this reads the literal label text directly\n// off the `ELabeledArg` AST node rather than relying on any label-based\n// rebinding machinery (there isn't one).\nfn sh_lines_flag_cmd(acc: Expr, args: Array[Expr], i: Int) -> Expr {\n  if i >= Array::length(args) {\n    acc\n  } else {\n    let next_acc = match Array::get(args, i) {\n      ELabeledArg(label, _, cond) => EIf(cond, ECall(EIdent(\"String::concat\", -1), [\n        acc,\n        uninterned_string_expr(String::concat(\" -\", label), 0)\n      ], -1), acc),\n      _ => acc\n    }\n    sh_lines_flag_cmd(next_acc, args, i + 1)\n  }\n}\n\nexport fn compile_call(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  if is_eident(callee) {\n    let fname0 = canonical_builtin_name(get_eident_name(callee))\n    // Stream[T] (docs/spec/wasi-p3-async.md §2.4) is backed by the eager Array\n    // machinery on the linear backend: map/fold reuse the existing inline\n    // Array::map / Array::fold lowering verbatim (same arg order, same value\n    // representation). empty/once/filter are handled explicitly below.\n    let fname = if fname0 == \"Stream::map\" {\n      \"Array::map\"\n    } else if fname0 == \"Stream::fold\" {\n      \"Array::fold\"\n    } else {\n      fname0\n    }\n    let fn_len2 = Array::length(ctx.func_table.names)\n    let mut fn_idx_in_list = -1\n    let mut __tr_j = 0\n    while __tr_j < fn_len2 {\n      if Array::get(ctx.func_table.names, __tr_j) == fname {\n        fn_idx_in_list = __tr_j\n        __tr_j = fn_len2\n      } else {\n        __tr_j = __tr_j + 1\n      }\n    }\n    let mut local_idx_hint = -1\n    let mut li = Array::length(local_names) - 1\n    while li >= 0 {\n      if Array::get(local_names, li) == fname {\n        local_idx_hint = li\n        li = -1\n      } else {\n        li = li - 1\n      }\n    }\n    let prefer_bound_call = fn_idx_in_list >= 0 || local_idx_hint >= 0\n    let ctor_lookup_idx = ctor_table_index_of(ctx.ctor_table, fname)\n    if ctor_lookup_idx >= 0 {\n      let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)\n      let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)\n      let ptr_local = next_local\n      Array::push(local_names, \"__ctor_ptr\")\n      let actual_args = if Array::length(args) == 1 {\n        match Array::get(args, 0) {\n          ERecord(_, rec_fields, _) => {\n            let mut si2 = 0\n            let mut sn_idx = -1\n            while si2 < Array::length(ctx.ctor_table.struct_names) {\n              if Array::get(ctx.ctor_table.struct_names, si2) == fname {\n                sn_idx = si2\n                si2 = Array::length(ctx.ctor_table.struct_names)\n              } else {\n                si2 = si2 + 1\n              }\n            }\n            if sn_idx >= 0 {\n              let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)\n              let ordered = array_empty()\n              let mut oi = 0\n              while oi < Array::length(def_fnames) {\n                let target_name = Array::get(def_fnames, oi)\n                let mut ri = 0\n                let mut found_rfv = EUnit\n                while ri < Array::length(rec_fields) {\n                  let (rfn, rfv) = Array::get(rec_fields, ri)\n                  if rfn == target_name {\n                    found_rfv = rfv\n                    ri = Array::length(rec_fields)\n                  } else {\n                    ri = ri + 1\n                  }\n                }\n                Array::push(ordered, found_rfv)\n                oi = oi + 1\n              }\n              ordered\n            } else {\n              args\n            }\n          },\n          _ => args\n        }\n      } else {\n        args\n      }\n      if ctx.enable_rc {\n        let total = 16 + fc * 8\n        emit_i64_const(buf, total)\n        emit_call(buf, ctx.rc_alloc_func_idx)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, total)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store(buf, 2, 4)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store8(buf, 0, 7)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag)\n        emit_i32_store(buf, 2, 8)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, fc)\n        emit_i32_store(buf, 2, 12)\n        let mut nl_c = next_local + 1\n        let mut fi_c = 0\n        while fi_c < Array::length(actual_args) {\n          let carg_c = Array::get(actual_args, fi_c)\n          nl_c = ce(buf, carg_c, local_names, nl_c, ctx, ld)\n          let val_local = nl_c\n          Array::push(local_names, \"__ctor_val\")\n          emit_local_set(buf, val_local)\n          nl_c = nl_c + 1\n          // A heap field projection `a.f` stored into a constructor is a borrow;\n          // the constructed value OWNS its fields (drop class 1 recurses), so\n          // retain it or the source's drop double-frees it (e.g. `Some(b.items)`\n          // returned while `b` is dropped). Mirrors the ERecord field-store dup\n          // (#704). Perceus emits no action for bare projections.\n          // #715: also retain a bare-ident arg whose binding is borrow-bound or\n          // loop-borrowed (cc_is_loop_borrowed_ident) -- same gap as the ETuple\n          // case in compile_expr_tail2.vibe (see the comment there).\n          if ctx.enable_rc && (cc_is_projection(carg_c) || cc_is_borrow_ret_call(carg_c, ctx) || cc_is_loop_borrowed_ident(carg_c, ctx)) {\n            emit_rc_dup_guarded(buf, val_local, ctx.rc_shadow)\n          } else {\n            ()\n          }\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 16 + fi_c * 8)\n          fi_c = fi_c + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 8)\n        emit_i64_add(buf)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_c\n      } else {\n        let obj_size = 8 + fc * 8\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_heap_grow_after_heap_set(buf, ctx)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, fc)\n        emit_i32_store(buf, 2, 4)\n        let mut nl_c = next_local + 1\n        let mut fi_c = 0\n        while fi_c < Array::length(actual_args) {\n          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ctx, ld)\n          let val_local = nl_c\n          Array::push(local_names, \"__ctor_val\")\n          emit_local_set(buf, val_local)\n          nl_c = nl_c + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + fi_c * 8)\n          fi_c = fi_c + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_c\n      }\n    }\n    else if fname == \"eq\" && Array::length(args) == 2 && ctx.enable_rc && (cc_expr_is_floatish(Array::get(args, 0), local_names, ctx) || cc_expr_is_floatish(Array::get(args, 1), local_names, ctx)) {\n      // #745: under RC floats are BOXED — the scalar i64.eq below would\n      // compare box pointers, so `eq(0.0125, 0.0125)` returned false. Take\n      // the same unbox + f64.eq path the `==` binop uses. Non-RC floats are\n      // raw f64 bits in an i64, where bitwise i64.eq matches the existing\n      // `==` behavior, so this branch is RC-only.\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_unbox_float(buf)\n      emit_f64_reinterpret_i64(buf)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_unbox_float(buf)\n      emit_f64_reinterpret_i64(buf)\n      emit_f64_eq(buf)\n      emit_i64_extend_i32_s(buf)\n      // Tag the Bool like the scalar branch below (ADR-0055).\n      emit_i64_const(buf, 1)\n      emit_i64_shl(buf)\n      nl\n    }\n    else if fname == \"eq\" && Array::length(args) == 2 && (!prefer_bound_call || cc_arg_is_scalarish(Array::get(args, 0)) || cc_arg_is_scalarish(Array::get(args, 1))) {\n      // Direct i64.eq for `eq(a, b)` when it is the builtin and at least one\n      // operand is provably scalar. This sidesteps the bound `eq`'s string\n      // fallback, which reads OOB on Int values resembling fat-pointers (#705):\n      // `==` already dispatches intish operands this way via emit_eq_value, and\n      // `eq` must match. A genuinely string/heap `eq` (no scalar operand) still\n      // falls through to the bound call below.\n      //\n      // #710/#711: keeping the scalarish disjunct (not just !prefer_bound_call)\n      // is required -- prefer_bound_call is a global cross-file name match, not\n      // scoped to the calling file (see #711), so dropping it regressed\n      // leb128_test.vibe. Root fix tracked in #711.\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_eq(buf)\n      emit_i64_extend_i32_s(buf)\n      // ADR-0055: under RC a Bool is a TAGGED scalar (true = 1<<1). The raw\n      // i64.eq result is 0/1 (untagged); tag it so `eq(..) == true`/`if`/derived\n      // comparisons see the same representation as a bool literal (#705 — without\n      // this, `eq(a,b) == true` compared untagged 1 against tagged 2 and failed).\n      // The bump backend leaves bools untagged, so only shift under RC.\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      } else {\n        ()\n      }\n      nl\n    }\n    else if Array::length(args) == 1 && (cc_expr_is_floatish(Array::get(args, 0), local_names, ctx) || cc_expr_is_boolish(Array::get(args, 0), local_names, ctx) || cc_expr_is_stringish(Array::get(args, 0), local_names, ctx)) && fname == namespace_exported_name(\"lib/@vibe/prelude/builtin_traits.vibe\", \"to_string\") {\n      // #1015: the prelude generic wrapper `to_string[T: Show](x: T) -> String\n      // { __to_string(x) }` (lib/@vibe/prelude/builtin_traits.vibe) compiles\n      // to exactly ONE shared wasm function body -- there is no\n      // monomorphization pass that duplicates a generic function body per\n      // instantiation. Inside that body `x` is a bare parameter of the\n      // opaque type param T, so the `__to_string` builtin lowering below --\n      // which classifies its argument via the syntactic cc_expr_is_floatish/\n      // boolish/stringish checks -- can never recognize `x` as Bool/Float/\n      // String there; it always falls to the generic runtime bit-pattern\n      // heuristic. `Show` is a marker-only trait (never declared with method\n      // signatures, so #641's dictionary-passing desugar -- which only\n      // handles method-bearing traits -- never synthesizes a runtime witness\n      // for it) and Bool has NO runtime tag distinguishing it from Int:\n      // `true`/`false` compile to raw i64 1/0 (linear) or tagged 2/0 (RC),\n      // bit-identical to Int 1/0 in both backends. So the runtime heuristic\n      // cannot possibly classify a Bool argument reached this way -- it\n      // silently mis-stringifies `true` as `\"1\"` (confirmed via a standalone\n      // repro: the generic fallback itself does not crash for input 0/1, it\n      // just returns the wrong string; the reported \"RuntimeError:\n      // unreachable\" is `assert(to_string(true) == \"true\")` failing on that\n      // wrong value and THEN trapping).\n      //\n      // Fix: at the CALL SITE `to_string(arg)`, the ORIGINAL argument\n      // expression is still visible (unlike inside the generic body), so\n      // when it is statically classifiable by the same cc_expr_is_* checks\n      // the `__to_string` builtin uses, bypass the generic `to_string`\n      // function call entirely and inline it as `__to_string(arg)` directly\n      // -- hitting the correct existing static fast path. This is purely\n      // additive: a call whose argument is NOT statically classifiable\n      // (e.g. forwarding another opaque generic parameter) still falls\n      // through unchanged to the ordinary bound call below.\n      //\n      // `fname` is essentially NEVER the bare `\"to_string\"` at this point:\n      // #716 export-name visibility renames every exported value def of a\n      // non-entry file to `name_exp_<sanitized path>` (namespace_exported_name,\n      // lib/@vibe/compiler/core/import_alias_rewrite.vibe) and rewrites every\n      // importer's reference to match, so a call to the prelude's `to_string`\n      // (defined in lib/@vibe/prelude/builtin_traits.vibe, a non-entry file)\n      // arrives here as `to_string_exp_lib__vibe_prelude_builtin_traits_vibe`\n      // -- verified with throw()-based instrumentation. A prior fix attempt\n      // for this issue special-cased only the bare name (fname equal to the\n      // plain string \"to_string\") and was silently dead code because it\n      // never fired for this reason.\n      //\n      // This match is intentionally the EXACT mangled name (via\n      // `namespace_exported_name` -- the SAME function the renaming pass\n      // itself uses, not a hand-copied string literal), not a bare-name or\n      // prefix match: an earlier version of this fix matched fname against\n      // either the bare \"to_string\" or, via String::starts_with, anything\n      // prefixed \"to_string_exp_\", which was unsound -- code review (#1015)\n      // correctly pointed out that\n      // (a) the bare form also matches a user's OWN `to_string` defined\n      // directly in an entry file (never renamed, so indistinguishable from\n      // the prelude's by name alone), and (b) the prefix form also matches\n      // ANY other file's own exported `to_string` (e.g. a user module\n      // exporting `to_string`, mangled to `to_string_exp_<that file's own\n      // sanitized path>`), silently overriding either user function's real\n      // behavior with the Bool/Float/String formatter. The exact mangled\n      // name embeds the full defining-file path, so it can only ever refer\n      // to THIS specific prelude definition. Guarding with `!prefer_bound_call`\n      // instead (as sibling `not`/`eq` branches above do) does NOT work here\n      // and was tried and rejected: unlike `not`/`eq`, which are pure\n      // compiler-provided fallbacks with no real backing definition unless a\n      // user shadows them, `to_string` ALWAYS resolves to a real declared\n      // function (the prelude's own, if nothing else) -- so `prefer_bound_call`\n      // is unconditionally true even for the correct, un-shadowed prelude\n      // call (confirmed with throw()-based instrumentation: `prefer_bound_call\n      // = T` at the real failing call site), and gating on `!prefer_bound_call`\n      // would make this branch never fire at all.\n      //\n      // Condition order matters here (selfcompile KPI heap regression found\n      // during review): `namespace_exported_name(...)` builds a fresh string\n      // via StringBuilder on every call, and this bump-allocated compiler\n      // never reclaims that memory mid-compile, so evaluating it FIRST --\n      // as the original version of this branch did -- ran it once per\n      // ECall node in the ENTIRE compiled program (this `else if` chain is\n      // walked for every function call), not just once per `to_string`\n      // call. `&&` short-circuits (desugars to `if`, see docs/cheatsheet.md),\n      // so putting the cheap arity check and the shape-based\n      // floatish/boolish/stringish classification first means the\n      // allocating name comparison only runs for the rare 1-arg calls whose\n      // argument is already known-classifiable -- functionally identical\n      // result, far fewer StringBuilder allocations across a whole compile.\n      ce(buf, ECall(EIdent(\"__to_string\", -1), [\n        Array::get(args, 0)\n      ], -1), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"not\" {\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      } else {\n        ()\n      }\n      nl\n    }\n    else if !prefer_bound_call && fname == \"await\" {\n      // M1b-3b (docs/spec/wasi-p3-async.md): awaiting a ready future yields the\n      // value directly (ready-future fast path). Real blocking future.read for\n      // async sources (host async imports / spawned subtasks) is M1b-3c.\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Future::ready\" {\n      // Future::ready(x) carries x directly — no canon future is created for an\n      // already-resolved value.\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Task::spawn\" {\n      // Structured concurrency, synchronous model (docs/spec/wasi-p3-async.md\n      // §2.5): on the single-threaded linear backend a spawned task runs its\n      // thunk eagerly, so the Task[T] value *is* the resolved result. `join`\n      // is then identity and `cancel` a no-op. Real subtask spawn over\n      // waitable-set / future.cancel is documented future work.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let fn_l = nl\n      let slot_l = nl + 1\n      let env_l = nl + 2\n      Array::push(local_names, \"__spawn_fn\")\n      Array::push(local_names, \"__spawn_slot\")\n      Array::push(local_names, \"__spawn_env\")\n      emit_local_set(buf, fn_l)\n      emit_closure_resolve(buf, fn_l, slot_l, env_l)\n      emit_closure_call_tail(buf, env_l, slot_l, 9, 0)\n      nl + 3\n    }\n    else if !prefer_bound_call && fname == \"Task::join\" {\n      // The task already holds its resolved value (eager spawn) — join is the\n      // identity projection onto that value.\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Task::cancel\" {\n      // The eager task has already completed; cancel evaluates the handle for\n      // its effects, drops it, and yields Unit.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_drop(buf)\n      emit_i64_const(buf, 0)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"Task::race\" {\n      // Both tasks are already resolved under the eager model; race resolves to\n      // the first task's value. (b is evaluated for its effects, then dropped.)\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_drop(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"Stream::empty\" {\n      // Empty stream = empty backing array.\n      let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      emit_call(buf, arr_new_fi)\n      next_local\n    }\n    else if !prefer_bound_call && fname == \"Stream::once\" {\n      // Singleton stream = one-element backing array.\n      let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let val_l = nl\n      let arr_l = nl + 1\n      Array::push(local_names, \"__once_val\")\n      Array::push(local_names, \"__once_arr\")\n      emit_local_set(buf, val_l)\n      emit_call(buf, arr_new_fi)\n      emit_local_set(buf, arr_l)\n      emit_local_get(buf, arr_l)\n      emit_local_get(buf, val_l)\n      emit_call(buf, arr_push_fi)\n      emit_local_get(buf, arr_l)\n      nl + 2\n    }\n    else if !prefer_bound_call && fname == \"Stream::filter\" {\n      // Eager filter: walk the backing array, keep elements whose predicate is\n      // truthy. Mirrors the Array::map loop but pushes conditionally.\n      let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_len_fi, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n      let (arr_get_fi, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n      let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      let arr_l = nl\n      let fn_l = nl + 1\n      let res_l = nl + 2\n      let len_l = nl + 3\n      let i_l = nl + 4\n      let slot_l = nl + 5\n      let env_l = nl + 6\n      let elem_l = nl + 7\n      Array::push(local_names, \"__filter_arr\")\n      Array::push(local_names, \"__filter_fn\")\n      Array::push(local_names, \"__filter_res\")\n      Array::push(local_names, \"__filter_len\")\n      Array::push(local_names, \"__filter_i\")\n      Array::push(local_names, \"__filter_slot\")\n      Array::push(local_names, \"__filter_env\")\n      Array::push(local_names, \"__filter_elem\")\n      emit_local_set(buf, fn_l)\n      emit_local_set(buf, arr_l)\n      emit_call(buf, arr_new_fi)\n      emit_local_set(buf, res_l)\n      emit_local_get(buf, arr_l)\n      emit_call(buf, arr_len_fi)\n      emit_local_set(buf, len_l)\n      emit_i64_const(buf, 0)\n      emit_local_set(buf, i_l)\n      emit_closure_resolve(buf, fn_l, slot_l, env_l)\n      emit_block_void(buf)\n      emit_loop_void(buf)\n      emit_local_get(buf, i_l)\n      emit_local_get(buf, len_l)\n      emit_i64_ge_s(buf)\n      emit_br_if(buf, 1)\n      emit_local_get(buf, arr_l)\n      emit_local_get(buf, i_l)\n      emit_call(buf, arr_get_fi)\n      emit_local_set(buf, elem_l)\n      emit_local_get(buf, elem_l)\n      emit_closure_call_tail(buf, env_l, slot_l, 9, 1)\n      emit_i64_const(buf, 0)\n      emit_i64_ne(buf)\n      emit_if_void(buf)\n      emit_local_get(buf, res_l)\n      emit_local_get(buf, elem_l)\n      emit_call(buf, arr_push_fi)\n      emit_end(buf)\n      emit_local_get(buf, i_l)\n      emit_index_one(buf, ctx)\n      emit_i64_add(buf)\n      emit_local_set(buf, i_l)\n      emit_br(buf, 0)\n      emit_end(buf)\n      emit_end(buf)\n      emit_local_get(buf, res_l)\n      nl + 8\n    }\n    else if !prefer_bound_call && fname == \"Stream::next\" {\n      // Stream::next(s) : Future[Option[T]] (docs/spec §2.4). On the eager\n      // Array-backed model `next` peeks the head: Some(s[0]) if non-empty else\n      // None. Synthesize the Option expression and reuse the existing ctor +\n      // Array::length/get lowering via `ce`. (await unwraps the ready future.)\n      let s_expr = Array::get(args, 0)\n      let synth = ELet(\"__nx_s\", s_expr, EIf(ECall(EIdent(\"lt\", -1), [\n        EInt(0),\n        ECall(EIdent(\"Array::length\", -1), [\n          EIdent(\"__nx_s\", -1)\n        ], -1)\n      ], -1), ECall(EIdent(\"Some\", -1), [\n        ECall(EIdent(\"Array::get\", -1), [\n          EIdent(\"__nx_s\", -1),\n          EInt(0)\n        ], -1)\n      ], -1), ECall(EIdent(\"None\", -1), array_empty(), -1)), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Task::timeout\" {\n      // Task::timeout(ms, thunk) : Option[T] (docs/spec §2.5). Synchronous eager\n      // model: the thunk always completes, so the result is Some(thunk()); the\n      // deadline is evaluated for its effects then ignored. Synthesized and\n      // lowered via `ce` so the Some ctor + 0-arg closure call reuse existing\n      // lowering.\n      let ms_expr = Array::get(args, 0)\n      let thunk_expr = Array::get(args, 1)\n      let synth = ELet(\"__to_fn\", thunk_expr, ELet(\"__to_ms\", ms_expr, ECall(EIdent(\"Some\", -1), [\n        ECall(EIdent(\"__to_fn\", -1), array_empty(), -1)\n      ], -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"String::to_bytes\" {\n      // String::to_bytes(s) : Stream[Int]  (ByteStream, docs/spec §2.4/§4.1).\n      // Eagerly materialise the string's bytes into the Array that backs a\n      // Stream[Int], so request/response bodies can be consumed with the Stream\n      // combinators. Synthesized as a `let mut arr = []; while i < length(s) {\n      // Array::push(arr, char_code_at(s, i)); i = i + 1 }; arr` loop and lowered\n      // via `ce`, so String::length/char_code_at + the loop counter follow the\n      // same (RC) tagging conventions as ordinary source. char_code_at reads one\n      // byte (i32.load8_u), so this is byte-accurate.\n      let s_expr = Array::get(args, 0)\n      let loop_body = ESeq(ECall(EIdent(\"Array::push\", -1), [\n        EIdent(\"__tb_arr\", -1),\n        ECall(EIdent(\"String::char_code_at\", -1), [\n          EIdent(\"__tb_s\", -1),\n          EIdent(\"__tb_i\", -1)\n        ], -1)\n      ], -1), EAssign(\"__tb_i\", ECall(EIdent(\"add\", -1), [\n        EIdent(\"__tb_i\", -1),\n        EInt(1)\n      ], -1), EUnit))\n      let synth = ELet(\"__tb_s\", s_expr, ELetMut(\"__tb_arr\", EArray(array_empty()), ELetMut(\"__tb_i\", EInt(0), ESeq(EWhile(ECall(EIdent(\"lt\", -1), [\n        EIdent(\"__tb_i\", -1),\n        ECall(EIdent(\"String::length\", -1), [\n          EIdent(\"__tb_s\", -1)\n        ], -1)\n      ], -1), loop_body), EIdent(\"__tb_arr\", -1)), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Stream::to_string\" {\n      // Stream::to_string(bs) : String  (ByteStream -> String, docs/spec\n      // §M2c-2). Collect a Stream[Int] of byte codes into a String, e.g. to\n      // build a response body. Synthesized as `let parts = []; while i <\n      // length(bs) { Array::push(parts, String::from_char_code(bs[i])); i = i +\n      // 1 }; String::join(parts, \"\")` and lowered via `ce`. Pushing one-char\n      // pieces and joining once is O(n); the earlier `acc = String::concat(acc,\n      // ...)` accumulator was O(n^2) (each concat copied the whole prefix), the\n      // dominant cost in the streaming bench (4 KB to_string: 1.77s -> see\n      // scripts/bench_streaming.sh). linked_compile always seeds \"\" into the\n      // string table, so the join separator literal resolves.\n      let bs_expr = Array::get(args, 0)\n      let ts_body = ESeq(ECall(EIdent(\"Array::push\", -1), [\n        EIdent(\"__ts_parts\", -1),\n        ECall(EIdent(\"String::from_char_code\", -1), [\n          ECall(EIdent(\"Array::get\", -1), [\n            EIdent(\"__ts_arr\", -1),\n            EIdent(\"__ts_i\", -1)\n          ], -1)\n        ], -1)\n      ], -1), EAssign(\"__ts_i\", ECall(EIdent(\"add\", -1), [\n        EIdent(\"__ts_i\", -1),\n        EInt(1)\n      ], -1), EUnit))\n      let synth = ELet(\"__ts_arr\", bs_expr, ELetMut(\"__ts_parts\", EArray(array_empty()), ELetMut(\"__ts_i\", EInt(0), ESeq(EWhile(ECall(EIdent(\"lt\", -1), [\n        EIdent(\"__ts_i\", -1),\n        ECall(EIdent(\"Array::length\", -1), [\n          EIdent(\"__ts_arr\", -1)\n        ], -1)\n      ], -1), ts_body), ECall(EIdent(\"String::join\", -1), [\n        EIdent(\"__ts_parts\", -1),\n        EString(\"\")\n      ], -1)), -1), -1), -1)\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"add\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_add(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"sub\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_sub(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"mul\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_mul(buf)\n      // Under RC, Int values are tagged `(n << 1)`. Multiplying two tagged\n      // operands raw gives `(a*b) << 2` (an extra factor of 2 vs. the `<< 1`\n      // every other Int carries) -- shift right once to correct back, exactly\n      // like the `*` EBinOp path does (compile_expr.vibe `op == \"*\"`) that\n      // this builtin fast path duplicates but had not mirrored.\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n      } else {\n        ()\n      }\n      nl\n    }\n    else if !prefer_bound_call && fname == \"lt\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_lt_s(buf)\n      emit_i64_extend_i32_s(buf)\n      // Under RC, Bool values are also tagged `(0|1) << 1` (mirrors the `<`\n      // EBinOp path's retag) -- untagged here means callers see 0 (== false\n      // tagged) but a true result reads as 1 instead of the expected 2.\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      } else {\n        ()\n      }\n      nl\n    }\n    else if !prefer_bound_call && fname == \"simd_skip_ws\" {\n      // #536 Phase 3: fused SIMD whitespace skip.\n      // simd_skip_ws(src: Bytes, pos: Int, len: Int) -> Int returns the first\n      // index >= pos that is NOT ASCII whitespace (' ' \\t \\n \\r), or len if all\n      // remaining bytes are whitespace. Scans 16 bytes at a time with the v128\n      // chunk kept on the operand stack (NO heap boxing — the per-op boxed v128\n      // intrinsics would bump-allocate 16 bytes each and leak), plus a scalar\n      // tail. Bytes layout (gen_bytes_get_body): [alloc@0][len@4][payload_ptr@8].\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)\n      let base_l = nl\n      let pos_l = nl + 1\n      let len_l = nl + 2\n      let res_l = nl + 3\n      let mask_l = nl + 4\n      let addr_l = nl + 5\n      let b_l = nl + 6\n      Array::push(local_names, \"__sw_base\")\n      Array::push(local_names, \"__sw_pos\")\n      Array::push(local_names, \"__sw_len\")\n      Array::push(local_names, \"__sw_res\")\n      Array::push(local_names, \"__sw_mask\")\n      Array::push(local_names, \"__sw_addr\")\n      Array::push(local_names, \"__sw_b\")\n      // stack: srcval, posval, lenval\n      emit_local_set(buf, len_l)\n      emit_local_set(buf, pos_l)\n      // top = srcval; base = payload_ptr (i32 @ +8) extended to i64\n      emit_i32_wrap_i64(buf)\n      emit_i32_load(buf, 2, 8)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, base_l)\n      // res defaults to len (every path overwrites it; keep it defined)\n      emit_local_get(buf, len_l)\n      emit_local_set(buf, res_l)\n      emit_block_void(buf)\n      // $ret\n      emit_block_void(buf)\n      // $tail\n      emit_loop_void(buf)\n      // $scan: if (pos + 16 > len) br $tail\n      emit_local_get(buf, pos_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 16)\n      emit_i32_add(buf)\n      emit_local_get(buf, len_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_gt_u(buf)\n      emit_if_void(buf)\n      emit_br(buf, 2)\n      emit_end(buf)\n      // addr = base + pos\n      emit_local_get(buf, base_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, pos_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_add(buf)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, addr_l)\n      // is_ws = (c==0x20) | (c==0x09) | (c==0x0A) | (c==0x0D), v128 on stack\n      emit_local_get(buf, addr_l)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_v128_const_splat_byte(buf, 32)\n      emit_i8x16_eq(buf)\n      emit_local_get(buf, addr_l)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_v128_const_splat_byte(buf, 9)\n      emit_i8x16_eq(buf)\n      emit_v128_or(buf)\n      emit_local_get(buf, addr_l)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_v128_const_splat_byte(buf, 10)\n      emit_i8x16_eq(buf)\n      emit_v128_or(buf)\n      emit_local_get(buf, addr_l)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_v128_const_splat_byte(buf, 13)\n      emit_i8x16_eq(buf)\n      emit_v128_or(buf)\n      // mask = bitmask(not(is_ws)): bit i set => lane i is NON-whitespace\n      emit_v128_not(buf)\n      emit_i8x16_bitmask(buf)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, mask_l)\n      // if (mask == 0) { pos += 16; br $scan }\n      emit_local_get(buf, mask_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_eqz(buf)\n      emit_if_void(buf)\n      emit_local_get(buf, pos_l)\n      emit_i64_const(buf, 16)\n      emit_i64_add(buf)\n      emit_local_set(buf, pos_l)\n      emit_br(buf, 1)\n      emit_end(buf)\n      // found: res = pos + ctz(mask); br $ret\n      emit_local_get(buf, pos_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, mask_l)\n      emit_i32_wrap_i64(buf)\n      bytebuf_push(buf, 104)\n      // i32.ctz\n      emit_i32_add(buf)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, res_l)\n      emit_br(buf, 2)\n      emit_end(buf)\n      // loop $scan\n      emit_end(buf)\n      // block $tail\n      // scalar tail: loop $tscan\n      emit_loop_void(buf)\n      // if (pos >= len) { res = pos; br $ret }\n      emit_local_get(buf, pos_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, len_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_ge_u(buf)\n      emit_if_void(buf)\n      emit_local_get(buf, pos_l)\n      emit_local_set(buf, res_l)\n      emit_br(buf, 2)\n      emit_end(buf)\n      // b = load8_u(base + pos)\n      emit_local_get(buf, base_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, pos_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_add(buf)\n      emit_i32_load8_u(buf, 0, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, b_l)\n      // non_ws = (b!=32) & (b!=9) & (b!=10) & (b!=13)\n      emit_local_get(buf, b_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 32)\n      emit_i32_ne(buf)\n      emit_local_get(buf, b_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 9)\n      emit_i32_ne(buf)\n      bytebuf_push(buf, 113)\n      // i32.and\n      emit_local_get(buf, b_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 10)\n      emit_i32_ne(buf)\n      bytebuf_push(buf, 113)\n      emit_local_get(buf, b_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 13)\n      emit_i32_ne(buf)\n      bytebuf_push(buf, 113)\n      // if (non_ws) { res = pos; br $ret }\n      emit_if_void(buf)\n      emit_local_get(buf, pos_l)\n      emit_local_set(buf, res_l)\n      emit_br(buf, 2)\n      emit_end(buf)\n      // pos += 1; br $tscan\n      emit_local_get(buf, pos_l)\n      emit_i64_const(buf, 1)\n      emit_i64_add(buf)\n      emit_local_set(buf, pos_l)\n      emit_br(buf, 0)\n      emit_end(buf)\n      // loop $tscan\n      emit_end(buf)\n      // block $ret\n      emit_local_get(buf, res_l)\n      nl + 7\n    }\n    else if !prefer_bound_call && fname == \"v128_load\" {\n      // #536: v128_load(bytes, off) -> V128.\n      // Bytes layout (see gen_bytes_get_body): [alloc@0][len@4][payload_ptr@8].\n      // addr = load_i32(bytesptr+8) + off; v128.load align=0; box the result.\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      let off_l = nl\n      let addr_l = nl + 1\n      let box_l = nl + 2\n      Array::push(local_names, \"__v128_off\")\n      Array::push(local_names, \"__v128_addr\")\n      Array::push(local_names, \"__v128_box\")\n      // stack: bytesval, offval. Save off, compute payload addr + off into addr_l.\n      emit_local_set(buf, off_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_load(buf, 2, 8)\n      emit_local_get(buf, off_l)\n      // #705: under RC an Int is tagged (n << 1, see eq/not above); the bump\n      // backend leaves it raw. off is used as a raw byte offset below, so\n      // untag it under RC first (without this, splat/load/store off-by-one-bit\n      // silently mistreat the offset/byte value -- e.g. off=1 reads as 2).\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i32_add(buf)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, addr_l)\n      // box = bump-alloc 16 bytes (non-RC), keep value pointer in box_l.\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, box_l)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, 16)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      // box.store(v128.load(addr))\n      emit_local_get(buf, box_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, addr_l)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_v128_store(buf, 0, 0)\n      // push (box | 1)\n      emit_local_get(buf, box_l)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl + 3\n    }\n    else if !prefer_bound_call && fname == \"v128_store\" {\n      // v128_store(bytes, off, v) -> Unit. addr as in v128_load; store v's box.\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)\n      let v_l = nl\n      let off_l = nl + 1\n      let addr_l = nl + 2\n      Array::push(local_names, \"__v128_v\")\n      Array::push(local_names, \"__v128_soff\")\n      Array::push(local_names, \"__v128_saddr\")\n      // stack: bytesval, offval, vval. Save v, off; compute addr.\n      emit_local_set(buf, v_l)\n      emit_local_set(buf, off_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_load(buf, 2, 8)\n      emit_local_get(buf, off_l)\n      // #705: untag off under RC (see v128_load above).\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i32_add(buf)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, addr_l)\n      // v128.store(addr, v128.load(v_box))\n      emit_local_get(buf, addr_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, v_l)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_v128_store(buf, 0, 0)\n      // Unit\n      emit_i64_const(buf, 0)\n      nl + 3\n    }\n    else if !prefer_bound_call && fname == \"v128_splat_i8x16\" {\n      // v128_splat_i8x16(n) -> V128. low byte of n broadcast to 16 lanes.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let box_l = nl\n      let byte_l = nl + 1\n      Array::push(local_names, \"__v128_box\")\n      Array::push(local_names, \"__v128_byte\")\n      // stack: nval (i64). Save it; wrap to i32 only when feeding i8x16.splat.\n      emit_local_set(buf, byte_l)\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, box_l)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, 16)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, box_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, byte_l)\n      // #705: untag n under RC (see v128_load above) -- otherwise the low byte\n      // fed to i8x16.splat is n's tag bit, not n itself (e.g. splat(0xFF)\n      // would broadcast 0xFE).\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i8x16_splat(buf)\n      emit_v128_store(buf, 0, 0)\n      emit_local_get(buf, box_l)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl + 2\n    }\n    else if !prefer_bound_call && (fname == \"v128_eq_i8x16\" || fname == \"v128_le_u_i8x16\" || fname == \"v128_ge_u_i8x16\" || fname == \"v128_and\" || fname == \"v128_or\") {\n      // Binary (V128, V128) -> V128. Load both operands from their boxes, emit\n      // the op, box the result.\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      let b_l = nl\n      let a_l = nl + 1\n      let box_l = nl + 2\n      Array::push(local_names, \"__v128_b\")\n      Array::push(local_names, \"__v128_a\")\n      Array::push(local_names, \"__v128_box\")\n      emit_local_set(buf, b_l)\n      emit_local_set(buf, a_l)\n      // box-alloc 16\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, box_l)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, 16)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      // box.store(op(load(a), load(b)))\n      emit_local_get(buf, box_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, a_l)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_local_get(buf, b_l)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      if fname == \"v128_eq_i8x16\" {\n        emit_i8x16_eq(buf)\n      } else if fname == \"v128_le_u_i8x16\" {\n        emit_i8x16_le_u(buf)\n      } else if fname == \"v128_ge_u_i8x16\" {\n        emit_i8x16_ge_u(buf)\n      } else if fname == \"v128_and\" {\n        emit_v128_and(buf)\n      } else {\n        emit_v128_or(buf)\n      }\n      emit_v128_store(buf, 0, 0)\n      emit_local_get(buf, box_l)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl + 3\n    }\n    else if !prefer_bound_call && fname == \"v128_not\" {\n      // v128_not(v) -> V128.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let v_l = nl\n      let box_l = nl + 1\n      Array::push(local_names, \"__v128_v\")\n      Array::push(local_names, \"__v128_box\")\n      emit_local_set(buf, v_l)\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, box_l)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, 16)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, box_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, v_l)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_v128_not(buf)\n      emit_v128_store(buf, 0, 0)\n      emit_local_get(buf, box_l)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl + 2\n    }\n    else if !prefer_bound_call && fname == \"v128_bitmask_i8x16\" {\n      // v128_bitmask_i8x16(v) -> Int. i8x16.bitmask -> i32; zero-extend to i64.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_i8x16_bitmask(buf)\n      emit_i64_extend_i32_u(buf)\n      // #705: under RC an Int is a tagged scalar (n << 1, see eq/not above);\n      // the bump backend leaves it raw, so only shift under RC.\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      } else {\n        ()\n      }\n      nl\n    }\n    else if !prefer_bound_call && (fname == \"v128_any_true\" || fname == \"v128_all_true_i8x16\") {\n      // (V128) -> Bool. emit op (-> i32 bool), sign-extend to the i64 Bool value.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      if fname == \"v128_any_true\" {\n        emit_v128_any_true(buf)\n      } else {\n        emit_i8x16_all_true(buf)\n      }\n      emit_i64_extend_i32_s(buf)\n      // #705: under RC a Bool is tagged (true = 1<<1, see eq/not above); the\n      // bump backend leaves it raw 0/1, so only shift under RC.\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      } else {\n        ()\n      }\n      nl\n    }\n    else if !prefer_bound_call && fname == \"perform\" {\n      let op_expr = Array::get(args, 0)\n      let op_head = if is_eident(op_expr) {\n        get_eident_name(op_expr)\n      } else if expr_tag(op_expr) == 8 {\n        let op_callee = get_ecall_callee(op_expr)\n        if is_eident(op_callee) {\n          get_eident_name(op_callee)\n        } else {\n          \"\"\n        }\n      } else {\n        \"\"\n      }\n      // #640: `perform Error::Throw(x)` IS `throw(x)`. `Error` is never in\n      // ctx.effect_names (linked_compile.vibe excludes it), so the generic\n      // lowering below would assign it the out-of-range fallback tag 3+n and\n      // a `with Error` handler (which catches tag 2, the EThrow tag — see\n      // compile_expr_tail6.vibe) would never see it. Emit the exact EThrow\n      // sequence instead (compile payload, throw tag 2), skipping the\n      // perform-counter/memo-region machinery — Error is non-resumable.\n      if op_head == \"Error::Throw\" {\n        let mut enl = next_local\n        if expr_tag(op_expr) == 8 && Array::length(get_ecall_args(op_expr)) > 0 {\n          enl = ce(buf, Array::get(get_ecall_args(op_expr), 0), local_names, enl, ctx, ld)\n        } else {\n          emit_i64_const(buf, 0)\n        }\n        bytebuf_push(buf, 8)\n        bytebuf_push(buf, 2)\n        enl\n      } else if String::index_of(op_head, \"Error::\") == 0 {\n        throw(String::concat(\"perform \", String::concat(op_head, \": the builtin Error effect has a single operation, Throw (#640)\")))\n      } else {\n        let mut nl = next_local\n        let g_rbuf = if ctx.enable_rc {\n          5\n        } else {\n          4\n        }\n        let eff_tag = effect_name_to_tag(ctx.effect_names, op_head)\n        // #553: per-effect region stride; MUST match eff_reserve in\n        // linked_compile.vibe and compile_expr_tail6.vibe.\n        let eff_off = (eff_tag - 3) * 131072\n        emit_global_get(buf, g_rbuf)\n        emit_i32_const(buf, eff_off)\n        emit_i32_add(buf)\n        emit_i64_load(buf, 3, 0)\n        emit_global_set(buf, 1)\n        emit_global_get(buf, g_rbuf)\n        emit_i32_const(buf, eff_off)\n        emit_i32_add(buf)\n        emit_global_get(buf, 1)\n        emit_i64_const(buf, 1)\n        emit_i64_add(buf)\n        emit_i64_store(buf, 3, 0)\n        emit_global_get(buf, 1)\n        emit_global_get(buf, g_rbuf)\n        emit_i32_const(buf, eff_off)\n        emit_i32_add(buf)\n        emit_i64_load(buf, 3, 8)\n        emit_i64_lt_s(buf)\n        emit_if_i64(buf)\n        emit_global_get(buf, g_rbuf)\n        emit_i32_const(buf, eff_off)\n        emit_i32_add(buf)\n        emit_global_get(buf, 1)\n        emit_i64_const(buf, 8)\n        emit_i64_mul(buf)\n        emit_i32_wrap_i64(buf)\n        emit_i32_add(buf)\n        emit_i64_load(buf, 3, 16)\n        emit_else(buf)\n        // #665: record which operation is unwinding (stack-neutral global set).\n        let g_op_idx_global = if ctx.enable_rc {\n          6\n        } else {\n          5\n        }\n        emit_i64_const(buf, effect_op_index(ctx.effect_op_keys, op_head))\n        emit_global_set(buf, g_op_idx_global)\n        let op_canon = canonical_builtin_name(op_head)\n        let __ft_len = Array::length(ctx.func_table.names)\n        let mut op_is_builtin = false\n        let mut __op_i = 0\n        while __op_i < __ft_len {\n          if Array::get(ctx.func_table.names, __op_i) == op_canon {\n            op_is_builtin = true\n            __op_i = __ft_len\n          } else {\n            __op_i = __op_i + 1\n          }\n        }\n        if op_is_builtin {\n          nl = ce(buf, op_expr, local_names, nl, ctx, ld)\n        } else if expr_tag(op_expr) == 8 {\n          let op_args = get_ecall_args(op_expr)\n          if Array::length(op_args) > 1 {\n            // Multi-value payload (#548): pack all op args into a tuple (one heap\n            // ref threaded as the single thrown value); the handler arm pattern\n            // destructures it element-by-element in compile_expr_tail6.\n            nl = ce(buf, ETuple(op_args), local_names, nl, ctx, ld)\n          } else if Array::length(op_args) > 0 {\n            nl = ce(buf, Array::get(op_args, 0), local_names, nl, ctx, ld)\n          } else {\n            emit_i64_const(buf, 0)\n          }\n        } else {\n          emit_i64_const(buf, 0)\n        }\n        bytebuf_push(buf, 8)\n        bytebuf_push(buf, eff_tag)\n        emit_end(buf)\n        nl\n      }\n    }\n    else if !prefer_bound_call && fname == \"path\" {\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"__loop_tail_retain\" {\n      // #768: codegen-internal marker (retain_wrap_branch_tails,\n      // compile_expr_tail.vibe) -- a loop-borrowed bare ident / projection\n      // escaping an if/match branch as the branch VALUE into a\n      // scope-end-dropped `let`. Compile the read, then guarded rc_dup so the\n      // per-iteration drop consumes the dup, not the loop-carried reference.\n      // Never present in user AST (synthesized during codegen only).\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let v_l = nl\n      Array::push(local_names, \"__ltr_v\")\n      emit_local_set(buf, v_l)\n      emit_rc_dup_guarded(buf, v_l, ctx.rc_shadow)\n      emit_local_get(buf, v_l)\n      nl + 1\n    }\n    else if !prefer_bound_call && (fname == \"Path::ref\" || fname == \"Path::resolve\") && Array::length(args) == 1 {\n      // #762: both resolve their argument to an absolute path against the\n      // process CWD via the `resolve_path` host import. The runtime op is\n      // identical; the effect distinction (Path::ref pure, Path::resolve\n      // `with { Env }`) lives in the checker's builtin signatures.\n      ce(buf, ECall(EIdent(\"resolve_path\", -1), [\n        Array::get(args, 0)\n      ], -1), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Path::to_string\" && Array::length(args) == 1 {\n      // #762: PathRef / DynamicPath wrap a raw String; to_string is identity.\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Path::is_absolute\" && Array::length(args) == 1 {\n      // #762: absolute iff the path begins with '/'. eq(char_code_at(x, 0), 47)\n      // avoids synthesizing a \"/\" string (which would not be in the string\n      // table).\n      ce(buf, ECall(EIdent(\"eq\", -1), [\n        ECall(EIdent(\"String::char_code_at\", -1), [\n          Array::get(args, 0),\n          EInt(0)\n        ], -1),\n        EInt(47)\n      ], -1), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"__float_bits\" {\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Int::to_string\" && Array::length(args) == 1 {\n      // Cheatsheet-documented alias of the integer `__to_string` path (the\n      // argument is Int by signature, so the string-pointer heuristic's int\n      // route applies).\n      ce(buf, ECall(EIdent(\"__to_string\", -1), [\n        Array::get(args, 0)\n      ], -1), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Fs::readdir\" && Array::length(args) == 1 {\n      // #729/#730: readdir's surface is Array[String], but the host import\n      // (`vibe_fs_read_dir_raw`, linked_compile) returns the byte-sorted entry\n      // names \"\\n\"-joined as ONE packed string (same ABI as fs_read_file —\n      // no host-side array building, RC/bump agnostic). Lower to ordinary\n      // AST so String::split's codegen does the array work. An empty dir\n      // returns \"\" which must yield [] — but split(\"\", d) is [\"\"] — hence\n      // the length guard. String pieces are built with String::from_char_code\n      // because a synthesized EString is not in the string table (same\n      // constraint as double_to_string_expr).\n      ce(buf, ELet(\"__rd_names\", ECall(EIdent(\"vibe_fs_read_dir_raw\", -1), [\n        Array::get(args, 0)\n      ], -1), EIf(EBinOp(\"==\", ECall(EIdent(\"String::length\", -1), [\n        EIdent(\"__rd_names\", -1)\n      ], -1), EInt(0)), ECall(EIdent(\"Array::slice\", -1), [\n        EArray([\n          ECall(EIdent(\"String::from_char_code\", -1), [\n            EInt(10)\n          ], -1)\n        ]),\n        EInt(0),\n        EInt(0)\n      ], -1), ECall(EIdent(\"String::split\", -1), [\n        EIdent(\"__rd_names\", -1),\n        ECall(EIdent(\"String::from_char_code\", -1), [\n          EInt(10)\n        ], -1)\n      ], -1)), -1), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"sh_lines\" && Array::length(args) >= 1 {\n      // `sh_lines(cmd) -> Array[String]`: the host import (`vibe_sh_lines_raw`,\n      // linked_compile) runs the command and returns its stdout \"\\n\"-joined as\n      // ONE packed string (same ABI as fs_read_dir). Lower to `String::split`\n      // over it, with the empty-output guard yielding [] (split(\"\", d) is [\"\"]).\n      // #777: any args beyond the first are labeled boolean flags folded\n      // into the command string by `sh_lines_flag_cmd` (single-arg calls are\n      // the common case and pass straight through unchanged).\n      let sh_cmd = sh_lines_flag_cmd(Array::get(args, 0), args, 1)\n      ce(buf, ELet(\"__sh_out\", ECall(EIdent(\"vibe_sh_lines_raw\", -1), [\n        sh_cmd\n      ], -1), EIf(EBinOp(\"==\", ECall(EIdent(\"String::length\", -1), [\n        EIdent(\"__sh_out\", -1)\n      ], -1), EInt(0)), ECall(EIdent(\"Array::slice\", -1), [\n        EArray([\n          ECall(EIdent(\"String::from_char_code\", -1), [\n            EInt(10)\n          ], -1)\n        ]),\n        EInt(0),\n        EInt(0)\n      ], -1), ECall(EIdent(\"String::split\", -1), [\n        EIdent(\"__sh_out\", -1),\n        ECall(EIdent(\"String::from_char_code\", -1), [\n          EInt(10)\n        ], -1)\n      ], -1)), -1), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"__to_string\" && Array::length(args) == 1 && cc_expr_is_floatish(Array::get(args, 0), local_names, ctx) {\n      // #744: a statically-floatish argument takes the synthesized Double\n      // formatter — the generic handler below would stringify the raw f64\n      // bits (or the box pointer under RC) as an integer.\n      ce(buf, double_to_string_expr(Array::get(args, 0)), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"__to_string\" && Array::length(args) == 1 && cc_expr_is_boolish(Array::get(args, 0), local_names, ctx) {\n      // #784: a statically-boolean argument formats as \"true\"/\"false\", not the\n      // integer 1/0 the generic path below would emit. Reuse the existing\n      // if/EString codegen: `if b { \"true\" } else { \"false\" }`.\n      ce(buf, EIf(Array::get(args, 0), EString(\"true\"), EString(\"false\")), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"__to_string\" && Array::length(args) == 1 && cc_expr_is_stringish(Array::get(args, 0), local_names, ctx) {\n      // #950: a statically-String argument IS the result — the generic\n      // handler below already returns a string value unchanged at runtime,\n      // but only after a string-pointer heuristic that requires ptr >= 64,\n      // so the legal packed empty-string encoding 0 (ptr 0, len 0 — e.g.\n      // `String::join([], sep)`'s empty case) was misread as Int 0 and\n      // printed \"0\". Emitting the argument directly is byte-for-byte the\n      // same dataflow as the generic path's string identity branch, minus\n      // the misfiring heuristic. Appending the 0-encoded empty string via\n      // String::concat copies 0 bytes, so `\"[\\{String::join([], \"-\")}]\"`\n      // now renders \"[]\".\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"__to_string\" {\n      let ts_arg0 = Array::get(args, 0)\n      let ts_arg_is_int = ts_known_int(ts_arg0, local_names, ctx)\n      let mut nl = ce(buf, ts_arg0, local_names, next_local, ctx, ld)\n      let val_l = nl\n      let neg_l = nl + 1\n      let cur_l = nl + 2\n      let abs_l = nl + 3\n      let hp_l = nl + 4\n      let len_l = nl + 5\n      Array::push(local_names, \"__ts_val\")\n      Array::push(local_names, \"__ts_neg\")\n      Array::push(local_names, \"__ts_cur\")\n      Array::push(local_names, \"__ts_abs\")\n      Array::push(local_names, \"__ts_hp\")\n      Array::push(local_names, \"__ts_len\")\n      emit_local_set(buf, val_l)\n      emit_block_i64(buf)\n      if ts_arg_is_int {\n        // #678: the argument is statically a known Int (literal or int-bound\n        // local) — never run it through the string-pointer heuristic (a large\n        // int like `1 << 40` has a zero low word and an in-bounds high word, so\n        // it would be misread as an empty string). Force the integer path with\n        // a false (i32) condition — the heuristic below also yields an i32 bool.\n        emit_i32_const(buf, 0)\n      } else {\n      emit_local_get(buf, val_l)\n      emit_i64_const(buf, 32)\n      bytebuf_push(buf, 136)\n      emit_local_tee(buf, abs_l)\n      emit_i64_const(buf, 64)\n      emit_i64_ge_s(buf)\n      emit_local_get(buf, abs_l)\n      // #606: a string is represented as (ptr << 32) | len, and `__to_string`\n      // returns the value unchanged when it looks like a string pointer. A\n      // string can live anywhere in linear memory — including the static data\n      // section (token / literal strings), whose offset is ABOVE the heap bump\n      // pointer during early compilation. The old bound `ptr < heap_ptr`\n      // (global 0) misclassified such strings as ints and stringified their raw\n      // i64, leaking a heap pointer (e.g. labeled param `x~` printed as\n      // `1285664100319233~`). Use the full linear-memory size (memory.size\n      // pages * 65536) as the upper bound so any in-bounds pointer is\n      // recognized; a small int still has a zero high word and takes the int\n      // path below.\n      bytebuf_push(buf, 63)\n      bytebuf_push(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_i64_const(buf, 65536)\n      emit_i64_mul(buf)\n      emit_i64_lt_s(buf)\n      bytebuf_push(buf, 113)\n      // #664: ALSO require the candidate string to FIT in linear memory:\n      // ptr + len <= memory_size. The `ptr < memory_size` bound above is not\n      // enough — a large integer (e.g. a 61-bit `Fs::stat_token`) whose HIGH\n      // word happens to land below memory_size is otherwise misread as a string\n      // pointer, and its LOW word becomes a multi-gigabyte \"length\". The next\n      // `String::concat` then `memory.copy`s that bogus length and traps with\n      // \"memory access out of bounds\" (the #664 crash, triggered during the\n      // persistent-sources-cache write `__to_string(Fs::stat_token(path))`). A\n      // real string always satisfies ptr + len <= memory_size, so adding this\n      // bound keeps genuine strings on the identity path while routing such\n      // large integers back to the integer-stringify path below.\n      emit_local_get(buf, abs_l)\n      emit_local_get(buf, val_l)\n      emit_i64_const(buf, 4294967295)\n      emit_i64_and(buf)\n      emit_i64_add(buf)\n      bytebuf_push(buf, 63)\n      bytebuf_push(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_i64_const(buf, 65536)\n      emit_i64_mul(buf)\n      emit_i64_le_s(buf)\n      bytebuf_push(buf, 113)\n      }\n      emit_if_void(buf)\n      emit_local_get(buf, val_l)\n      emit_br(buf, 1)\n      emit_end(buf)\n      // Under RC a scalar Int is tagged `n << 1` (low bit 0 marks a non-heap\n      // value; see `Int::to_double` / `Double::to_int` which shift to/from this\n      // form). Arithmetic stays in tagged space and compares correctly, but the\n      // digit loop below renders the RAW i64 — so without untagging it prints\n      // `2n` (e.g. 42 -> \"84\"). Recover the logical value with an arithmetic\n      // (sign-preserving) shift right by 1. Strings already returned above via\n      // the `br`, so this only touches the integer path.\n      if ctx.enable_rc {\n        emit_local_get(buf, val_l)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        emit_local_set(buf, val_l)\n      }\n      emit_i64_const(buf, 46)\n      emit_local_set(buf, cur_l)\n      emit_local_get(buf, val_l)\n      emit_i64_const(buf, 0)\n      emit_i64_lt_s(buf)\n      emit_i64_extend_i32_s(buf)\n      emit_local_set(buf, neg_l)\n      emit_local_get(buf, val_l)\n      emit_i64_const(buf, 0)\n      emit_i64_lt_s(buf)\n      emit_if_i64(buf)\n      emit_i64_const(buf, 0)\n      emit_local_get(buf, val_l)\n      emit_i64_sub(buf)\n      emit_else(buf)\n      emit_local_get(buf, val_l)\n      emit_end(buf)\n      emit_local_set(buf, abs_l)\n      emit_local_get(buf, abs_l)\n      emit_i64_eqz(buf)\n      emit_if_void(buf)\n      emit_local_get(buf, cur_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 48)\n      emit_i32_store8(buf, 0, 0)\n      emit_local_get(buf, cur_l)\n      emit_i64_const(buf, 1)\n      emit_i64_sub(buf)\n      emit_local_set(buf, cur_l)\n      emit_end(buf)\n      emit_block_void(buf)\n      emit_loop_void(buf)\n      emit_local_get(buf, abs_l)\n      emit_i64_eqz(buf)\n      emit_br_if(buf, 1)\n      emit_local_get(buf, cur_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, abs_l)\n      emit_i64_const(buf, 10)\n      emit_i64_rem_s(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 48)\n      emit_i32_add(buf)\n      emit_i32_store8(buf, 0, 0)\n      emit_local_get(buf, cur_l)\n      emit_i64_const(buf, 1)\n      emit_i64_sub(buf)\n      emit_local_set(buf, cur_l)\n      emit_local_get(buf, abs_l)\n      emit_i64_const(buf, 10)\n      emit_i64_div_s(buf)\n      emit_local_set(buf, abs_l)\n      emit_br(buf, 0)\n      emit_end(buf)\n      emit_end(buf)\n      emit_local_get(buf, neg_l)\n      emit_i32_wrap_i64(buf)\n      emit_if_void(buf)\n      emit_local_get(buf, cur_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 45)\n      emit_i32_store8(buf, 0, 0)\n      emit_local_get(buf, cur_l)\n      emit_i64_const(buf, 1)\n      emit_i64_sub(buf)\n      emit_local_set(buf, cur_l)\n      emit_end(buf)\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, hp_l)\n      emit_i64_const(buf, 46)\n      emit_local_get(buf, cur_l)\n      emit_i64_sub(buf)\n      emit_local_set(buf, len_l)\n      // Bump the heap pointer and run the grow check BEFORE the memory.copy\n      // into the fresh allocation. The copy used to come first, which traps\n      // with \"memory access out of bounds\" whenever the previous allocation\n      // left global 0 within `len` bytes of the current memory end (the grow\n      // check only guarantees the heap pointer itself is addressable, not a\n      // full page of headroom). Hit in practice by large multi-module FS\n      // compiles (#533 measurement: ~200-file cold-cache walk).\n      emit_local_get(buf, hp_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, len_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 7)\n      emit_i32_add(buf)\n      emit_i32_const(buf, -8)\n      bytebuf_push(buf, 113)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, hp_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, cur_l)\n      emit_i64_const(buf, 1)\n      emit_i64_add(buf)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, len_l)\n      emit_i32_wrap_i64(buf)\n      emit_memory_copy(buf)\n      emit_local_get(buf, hp_l)\n      emit_i64_const(buf, 32)\n      emit_i64_shl(buf)\n      emit_local_get(buf, len_l)\n      emit_i64_or(buf)\n      emit_end(buf)\n      nl + 6\n    }\n    else if fname == \"Double::to_int\" || fname == \"Float::to_int\" {\n      // #997: `i64.trunc_f64_s` TRAPS (an unhandled wasm trap, not a\n      // catchable vibe `Error`) on NaN, +-Infinity, or any magnitude\n      // ou