  ("lib/@vibe/compiler/cache/codegen_fingerprint.vibe",
"// AUTO-GENERATED by scripts/generate_bundle.sh (#630).\n// Do not edit manually. Regenerate with: bash scripts/generate_bundle.sh\n//\n// A hash of every compiler source file in compiler_sources_manifest.tsv (the\n// codegen included). persistent_cache folds it into the artifact cache key so a\n// codegen change — which produces different wasm from the SAME user source —\n// automatically invalidates stale compiled .hex artifacts (#630).\n\n//# Functions\n\nexport let codegen_fingerprint: () -> String = () -> {\n  \"37312bfc5c990389\"\n}\n")
}

let cli_adapter_source_170 = () -> (String, String) {
  ("lib/@vibe/compiler/cache/cache_underlying.vibe",
"//# Imports\n\n// #769: `cache_`-prefixed forwarding wrappers around the generic @vibe/cache\n// primitives, replacing persistent_cache.vibe's `import ... { x as cache_x }`\n// aliases. Rationale: generate_bundle.sh strips relative import\n// lines from every embedded .vibe source on the assumption that\n// collect_merged_stmts resolves references BY NAME -- an `as` alias only\n// exists in the import line, so the stripped bundle's merged program had\n// calls to `cache_persistent_artifact_cache_path` with no such definition\n// (\"undefined variable (local): ... @call\", the s5_entry/size/wasm/\n// determinism_test failure). Real wrapper functions survive the strip: their\n// bodies call the @vibe/cache definitions by their own exported names, which\n// the merge resolves. Keep this file alias-free.\nimport @vibe/cache {\n  persistent_artifact_cache_path,\n  store_persistent_artifact,\n  load_persistent_artifact,\n  persistent_dep_list_cache_path,\n  persistent_type_env_cache_path,\n  persistent_source_list_cache_path,\n  persistent_source_group_cache_path,\n  persistent_module_header_cache_path,\n  persistent_manifest_header_cache_path,\n  persistent_leaf_fingerprint_cache_path\n}\n\n//# Functions\n\n// #849 (Codex review, PR #899): VIBE_BUILD_CACHE_DIR override lives HERE,\n// not in @vibe/cache/cache.vibe — this compiler-specific wrapper layer\n// already requires host Fs/Error imports for every consumer, so an\n// `Env::get` reference here forces nothing new. Putting it in the generic\n// package instead would force a `vibe.env_get` host import onto every\n// consumer of @vibe/cache's whole linked program (even ones only using pure\n// helpers like compact_string_fingerprint), since collect_used_builtin_names\n// scans all top-level statements of the linked program, not just ones\n// reachable from the entry point. Private effect + checker-only discharge,\n// mirroring module_graph_path.vibe's ADR-0065 pattern (VIBE_LIB / VIBE_HOME\n// / HOME / VIBE_REQUIRE_PINS) so the 8 path-returning wrappers below don't\n// need an `Env` row on their own signatures or their ~20-30 call sites.\neffect Env {\n  Get(String) -> String\n}\n\nfn env_get_raw(name: String) -> String with { Env } {\n  Env::get(name)\n}\n\nfn read_env_discharged(name: String) -> String {\n  handle {\n    env_get_raw(name)\n  } with Env {\n    Get(_n) => resume(\"\")\n  }\n}\n\n// @vibe/cache/cache.vibe's stable_cache_path always roots paths under the\n// literal \"_build/vibe_\" prefix. When VIBE_BUILD_CACHE_DIR is set, rebase\n// that prefix onto the override directory (still ending in \"vibe_\", so the\n// existing \"<prefix>_<token>_<suffix>\" filename convention appends\n// unchanged) so parallel `git worktree` checkouts can share one physical\n// cache directory (the cache KEY is already content/relative-path based —\n// see #849 audit comment).\nfn rebase_cache_path(path: String) -> String {\n  let override_root = read_env_discharged(\"VIBE_BUILD_CACHE_DIR\")\n  let default_prefix = \"_build/vibe_\"\n  if String::length(override_root) == 0 {\n    path\n  } else if !(String::starts_with(path, default_prefix)) {\n    path\n  } else {\n    let override_len = String::length(override_root)\n    let override_prefix = if String::char_code_at(override_root, override_len - 1) == 47 {\n      String::concat(override_root, \"vibe_\")\n    } else {\n      String::concat(override_root, \"/vibe_\")\n    }\n    String::concat(override_prefix, path[String::length(default_prefix): String::length(path)])\n  }\n}\n\nexport fn cache_persistent_artifact_cache_path(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> String {\n  rebase_cache_path(persistent_artifact_cache_path(version_tag, kind, entry_name, fingerprint))\n}\n\nexport fn cache_store_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs } {\n  store_persistent_artifact(version_tag, kind, entry_name, fingerprint, bytes)\n}\n\nexport fn cache_load_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs } {\n  load_persistent_artifact(version_tag, kind, entry_name, fingerprint)\n}\n\nexport fn cache_persistent_dep_list_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String {\n  rebase_cache_path(persistent_dep_list_cache_path(version_tag, path, source_fingerprint, resolution_seed))\n}\n\nexport fn cache_persistent_type_env_cache_path(version_tag: String, fingerprint: String) -> String {\n  rebase_cache_path(persistent_type_env_cache_path(version_tag, fingerprint))\n}\n\nexport fn cache_persistent_source_list_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String {\n  rebase_cache_path(persistent_source_list_cache_path(version_tag, entry_path, resolution_seed))\n}\n\nexport fn cache_persistent_source_group_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String {\n  rebase_cache_path(persistent_source_group_cache_path(version_tag, entry_path, resolution_seed))\n}\n\nexport fn cache_persistent_module_header_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String {\n  rebase_cache_path(persistent_module_header_cache_path(version_tag, path, source_fingerprint, resolution_seed))\n}\n\nexport fn cache_persistent_manifest_header_cache_path(version_tag: String, entry_path: String) -> String {\n  rebase_cache_path(persistent_manifest_header_cache_path(version_tag, entry_path))\n}\n\nexport fn cache_persistent_leaf_fingerprint_cache_path(version_tag: String, path: String, source_fingerprint: String) -> String {\n  rebase_cache_path(persistent_leaf_fingerprint_cache_path(version_tag, path, source_fingerprint))\n}\n")
}

let cli_adapter_source_171 = () -> (String, String) {
  ("lib/@vibe/compiler/cache/persistent_cache.vibe",
"//# Imports\n\n// #766: the generic disk-cache primitives live in @vibe/cache (no compiler\n// dependency). This file is the compiler-specific adapter: it supplies the\n// two identity components a generic cache can't know about — the compiler's\n// own codegen fingerprint (so a codegen change invalidates stale artifacts,\n// #630) and VIBE_LIB's module-resolution env seed (#758) — and re-exports\n// the ORIGINAL wrapper names/signatures so every existing call site in the\n// compiler keeps working unchanged.\n// #769: the `cache_`-prefixed underlying names come from real forwarding\n// wrappers (cache_underlying.vibe), NOT `x as cache_x` import aliases -- an\n// alias only exists in the import line, which generate_bundle.sh\n// strips from embedded sources, so the bundle-merge lane\n// (collect_merged_stmts, s5_entry/size/wasm/determinism_test) had\n// no definition for the aliased names (\"undefined variable (local):\n// cache_persistent_artifact_cache_path @call\"). See cache_underlying.vibe.\nimport ./cache_underlying.vibe {\n  cache_persistent_artifact_cache_path,\n  cache_store_persistent_artifact,\n  cache_load_persistent_artifact,\n  cache_persistent_dep_list_cache_path,\n  cache_persistent_type_env_cache_path,\n  cache_persistent_source_list_cache_path,\n  cache_persistent_source_group_cache_path,\n  cache_persistent_module_header_cache_path,\n  cache_persistent_manifest_header_cache_path,\n  cache_persistent_leaf_fingerprint_cache_path\n}\n\nimport ./codegen_fingerprint.vibe {\n  codegen_fingerprint\n}\n\nimport @vibe/compiler/core {\n  is_contract_ext,\n  resolution_env_seed,\n  resolve_import_path_candidates\n}\n\n//# Misc\n\n// #897 (cache/ vpkg migration): rewritten from the old bare\n// `import ../../../../lib/@vibe/cache {...}` + separate `export {...}`\n// two-step to the `export <path> { names }` SReExport form -- a bare\n// import + export does NOT satisfy check_contract as an implementation for\n// a declared contract name (only a real local `export fn`/`export type`\n// body, or an SReExport, counts; see core/ast.vibe's identical fix for\n// @vibe/ast's Expr/Pat/Stmt/TypeExpr). cache/index.vpkg's fn declarations\n// for these 12 names are satisfied by this SReExport at face value\n// (check_contract trusts re-exported names without a body/arity check --\n// the source package's own contract, lib/@vibe/cache/index.vpkg, is what\n// actually pins their shape).\nexport ../../../../lib/@vibe/cache {\n  compact_string_fingerprint,\n  build_source_groups_fingerprint,\n  normalize_persistent_cache_text,\n  build_source_groups_fingerprint_from_compact_fingerprints,\n  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint,\n  build_fs_compile_wasi_artifact_fingerprint,\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint,\n  build_file_compile_wasi_artifact_fingerprint,\n  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint,\n  build_fs_compile_module_artifact_fingerprint,\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint,\n  build_file_compile_module_artifact_fingerprint\n}\n\n//# Functions\n\n// Cache key version tag. TWO independent reasons to bump it (#630):\n//  - cache FORMAT change (how `.hex` / `.tsv` entries are serialized): bump `vNN`.\n//  - CODEGEN / wasm-ABI change (the SAME source now compiles to DIFFERENT wasm):\n//    bump `cgNN`. The artifact cache is keyed by the source fingerprint only, so\n//    without a codegen segment a codegen change returns a STALE compiled wasm for\n//    unchanged source. Bump `cg` on any change to emitted wasm / runtime ABI.\n//    The `cg` segment is `codegen_fingerprint()` — a build-time hash of\n//    all compiler source files (compiler_sources_manifest.tsv), regenerated with\n//    the bundle. So any codegen-source change automatically changes the key and\n//    invalidates stale artifacts; no manual bump needed (#630). `vNN` is still a\n//    manual knob for pure cache-FORMAT changes that don't change the source hash.\nfn persistent_cache_version_tag() -> String {\n  // v12 (#801): source list/group cache text gained a mandatory `resctx` row\n  // (resolution-context fingerprint) and its version row moved to 3 — a cache\n  // FORMAT change. Loaders written before #801 throw on the unknown row tag,\n  // so the manual `vNN` knob is bumped to keep old and new writers in\n  // disjoint key spaces (this also orphans any #801-poisoned entries).\n  // v11 (#632): artifact cache switched from hex text (`.hex`) to raw binary\n  // (`.bin`, via Fs::write_bytes / Fs::read_bytes) — a cache FORMAT change, so\n  // the manual `vNN` knob is bumped. Old `.hex` entries are now unreferenced\n  // (different key + suffix) and reclaimable via `pkf run cache-clean` (#631).\n  String::concat(\"v12|cg-\", codegen_fingerprint())\n}\n\nexport fn persistent_artifact_cache_path(kind: String, entry_name: String, fingerprint: String) -> String {\n  cache_persistent_artifact_cache_path(persistent_cache_version_tag(), kind, entry_name, fingerprint)\n}\n\nexport fn store_persistent_artifact(kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs } {\n  cache_store_persistent_artifact(persistent_cache_version_tag(), kind, entry_name, fingerprint, bytes)\n}\n\nexport fn load_persistent_artifact(kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs } {\n  cache_load_persistent_artifact(persistent_cache_version_tag(), kind, entry_name, fingerprint)\n}\n\nexport fn persistent_dep_list_cache_path(path: String, source_fingerprint: String) -> String {\n  cache_persistent_dep_list_cache_path(persistent_cache_version_tag(), path, source_fingerprint, resolution_env_seed())\n}\n\nexport fn persistent_type_env_cache_path(fingerprint: String) -> String {\n  cache_persistent_type_env_cache_path(persistent_cache_version_tag(), fingerprint)\n}\n\nexport fn persistent_source_list_cache_path(entry_path: String) -> String {\n  // #758 review (P1): the cached artifact is a RESOLVED graph — the external\n  // lib roots and the freeze switch (#751) are part of its identity, or a\n  // graph resolved without pins replays under VIBE_REQUIRE_PINS=1 (and a\n  // VIBE_LIB change replays the previous roots). Same seed on the dep-list\n  // and module-header caches below.\n  cache_persistent_source_list_cache_path(persistent_cache_version_tag(), entry_path, resolution_env_seed())\n}\n\nexport fn persistent_source_group_cache_path(entry_path: String) -> String {\n  cache_persistent_source_group_cache_path(persistent_cache_version_tag(), entry_path, resolution_env_seed())\n}\n\nexport fn persistent_module_header_cache_path(path: String, source_fingerprint: String) -> String {\n  cache_persistent_module_header_cache_path(persistent_cache_version_tag(), path, source_fingerprint, resolution_env_seed())\n}\n\nexport fn persistent_manifest_header_cache_path(entry_path: String) -> String {\n  cache_persistent_manifest_header_cache_path(persistent_cache_version_tag(), entry_path)\n}\n\nexport fn persistent_leaf_fingerprint_cache_path(path: String, source_fingerprint: String) -> String {\n  cache_persistent_leaf_fingerprint_cache_path(persistent_cache_version_tag(), path, source_fingerprint)\n}\n\n// #801 follow-up: the module-header and dep-list caches store RESOLVED dep\n// paths, and a `@scope/name` import resolves to a DIFFERENT package root\n// (.vibe/store wins over lib/ wins over external roots) depending on what\n// exists at resolve time. A header cached while a store copy existed lists\n// the store index.vibei as a dep; replayed after the store copy is gone (or\n// vice versa) it aims the walk at the wrong root. Unlike the source-group\n// cache (#801's resctx row), the poison here is VISIBLE in the cached rows —\n// the importing file's dep always names the winning package index — so no\n// context enumeration is needed: re-derive the `@scope/name` ref from each\n// package-index dep and check it still wins today.\nfn package_ref_of_index_dep(dep: String) -> Option[String] {\n  // #897: a resolved package-index dep only ever ends in `.vibei` or (once a\n  // directory has migrated) `.vpkg` — no other on-disk file uses either\n  // extension — so the shared `is_contract_ext` boolean is exact here, not\n  // an approximation of the \"/index.<ext>\" filename check.\n  if is_contract_ext(dep) {\n    let parts = String::split(dep, \"/\")\n    let n = Array::length(parts)\n    if n >= 3 && String::starts_with(Array::get(parts, n - 3), \"@\") {\n      Some(String::concat(Array::get(parts, n - 3), String::concat(\"/\", Array::get(parts, n - 2))))\n    } else {\n      None\n    }\n  } else {\n    None\n  }\n}\n\nexport fn package_index_dep_is_current(dep: String) -> Bool with { Fs } {\n  match package_ref_of_index_dep(dep) {\n    None => true,\n    Some(pkg_ref) => {\n      let candidates = resolve_import_path_candidates(\"\", pkg_ref)\n      let mut i = 0\n      let mut winner = \"\"\n      while i < Array::length(candidates) {\n        if winner == \"\" {\n          let candidate = Array::get(candidates, i)\n          if Fs::exists(candidate) {\n            winner = candidate\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      // Mirror resolve_path_fs: no existing candidate falls back to the\n      // first (store) spelling.\n      if winner == \"\" {\n        Array::get(candidates, 0) == dep\n      } else {\n        winner == dep\n      }\n    }\n  }\n}\n\nexport fn package_index_deps_are_current(deps: Array[String]) -> Bool with { Fs } {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(deps) {\n    if ok && !(package_index_dep_is_current(Array::get(deps, i))) {\n      ok = false\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  ok\n}\n")
}

let cli_adapter_source_172 = () -> (String, String) {
  ("lib/@vibe/compiler/cache/index.vpkg",
"version 0.0.1\n\n// @vibe/compiler/cache — ADR-0070 / #897 compiler-internal contract. This\n// directory is the second-to-last plain directory under\n// lib/@vibe/compiler/ (the top-level directory itself is the true last\n// one, and depends on this batch + a sibling module_graph_path.vibe\n// relocation batch landing first, #897 tracking issue). Three impl files,\n// no facade rename (none of them was the old index.vibe, so no\n// `git mv index.vibe <dirname>.vibe` was needed):\n//\n//   - codegen_fingerprint.vibe: AUTO-GENERATED by scripts/generate_bundle.sh\n//     (#630). A single `export let codegen_fingerprint: () -> String = ...`\n//     zero-arg thunk, no imports.\n//   - cache_underlying.vibe: `cache_`-prefixed forwarding wrappers around\n//     the EXTERNAL @vibe/cache package's generic disk-cache primitives\n//     (#769 -- real wrapper fns, not `x as cache_x` import aliases, because\n//     generate_bundle.sh's bundle-merge lane resolves references by name\n//     and strips relative import lines, so an alias-only rename has no\n//     surviving definition). Also owns the VIBE_BUILD_CACHE_DIR override\n//     (#849) via a private, non-exported `effect Env` + checker-only\n//     discharge (mirrors module_graph_path.vibe's ADR-0065 pattern) so the\n//     8 path-returning wrappers don't need an `Env` row on their own\n//     signatures.\n//   - persistent_cache.vibe: the compiler-specific adapter over\n//     cache_underlying.vibe -- supplies the two identity components a\n//     generic cache can't know (the codegen fingerprint, #630, and\n//     VIBE_LIB's module-resolution env seed, #758) and re-exports the\n//     ORIGINAL @vibe/cache wrapper names/signatures so every existing\n//     compiler call site keeps working unchanged. Also owns the\n//     package-index-dep staleness check (package_index_dep_is_current /\n//     package_index_deps_are_current, #897) used to detect a cached\n//     module-header/dep-list row naming a `@scope/name` package-index dep\n//     that no longer resolves to the same on-disk root.\n//\n// `export ../../../../lib/@vibe/cache { .. }` SReExport (see\n// persistent_cache.vibe's own header comment): rewritten from the old bare\n// `import ../../../../lib/@vibe/cache {...}` + separate `export {...}`\n// two-step, which does NOT satisfy check_contract as an implementation for\n// a declared contract name (only a real local `export fn`/`export type`\n// body, or an SReExport, counts) -- same fix as core/ast.vibe's identical\n// rewrite for @vibe/ast's Expr/Pat/Stmt/TypeExpr. The 12 fn declarations\n// below for those re-exported names are satisfied by this SReExport at\n// face value; lib/@vibe/cache/index.vpkg is what actually pins their\n// shape.\n//\n// No bare-name collision across the three files: cache_underlying.vibe's\n// exports are ALL `cache_`-prefixed (cache_persistent_artifact_cache_path,\n// ...) while persistent_cache.vibe's own wrappers use the un-prefixed\n// `persistent_*` names -- distinct from the prelude/ batch's mid-session\n// collision precedent (two files exporting the identical bare name), which\n// does not recur here.\n//\n// No import cycle: persistent_cache.vibe's only compiler-internal\n// dependency outside this directory is ../module_graph_path.vibe (a\n// top-level compiler file, not yet relocated as of this batch -- see the\n// tracking-issue note above), which itself only imports the external\n// @vibe/core package -- it does not import cache/ back.\n\n// --- codegen_fingerprint\nfn codegen_fingerprint() -> String\n\n// --- cache_underlying\nfn cache_persistent_artifact_cache_path(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> String\nfn cache_store_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs }\nfn cache_load_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs }\nfn cache_persistent_dep_list_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String\nfn cache_persistent_type_env_cache_path(version_tag: String, fingerprint: String) -> String\nfn cache_persistent_source_list_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String\nfn cache_persistent_source_group_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String\nfn cache_persistent_module_header_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String\nfn cache_persistent_manifest_header_cache_path(version_tag: String, entry_path: String) -> String\nfn cache_persistent_leaf_fingerprint_cache_path(version_tag: String, path: String, source_fingerprint: String) -> String\n\n// --- persistent_cache (own wrappers)\nfn persistent_artifact_cache_path(kind: String, entry_name: String, fingerprint: String) -> String\nfn store_persistent_artifact(kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs }\nfn load_persistent_artifact(kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs }\nfn persistent_dep_list_cache_path(path: String, source_fingerprint: String) -> String\nfn persistent_type_env_cache_path(fingerprint: String) -> String\nfn persistent_source_list_cache_path(entry_path: String) -> String\nfn persistent_source_group_cache_path(entry_path: String) -> String\nfn persistent_module_header_cache_path(path: String, source_fingerprint: String) -> String\nfn persistent_manifest_header_cache_path(entry_path: String) -> String\nfn persistent_leaf_fingerprint_cache_path(path: String, source_fingerprint: String) -> String\nfn package_index_dep_is_current(dep: String) -> Bool with { Fs }\nfn package_index_deps_are_current(deps: Array[String]) -> Bool with { Fs }\n\n// --- persistent_cache (SReExport of lib/@vibe/cache, see header; exact\n// signatures copied from lib/@vibe/cache/index.vpkg -- that contract is\n// what actually pins these names' shape)\nfn compact_string_fingerprint(source: String) -> String\nfn build_source_groups_fingerprint(groups: Array[(String, Array[(String, String)])]) -> String\nfn normalize_persistent_cache_text(text: String) -> String\nfn build_source_groups_fingerprint_from_compact_fingerprints(groups: Array[(String, Array[(String, String)])]) -> String\nfn build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String) -> String\nfn build_fs_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> String\nfn build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String, mode: String) -> String\nfn build_file_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String, mode: String) -> String\nfn build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String\nfn build_fs_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String\nfn build_file_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String\nfn build_file_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String\n")
}

let cli_adapter_source_173 = () -> (String, String) {
  ("lib/@vibe/compiler/core/module_graph_path.vibe",
"import @vibe/core {\n  array_empty\n}\n\n//# Functions\n\n// #897 (ADR-0070 Phase 1): `index.vpkg` is the target spelling `index.vibei`\n// is being renamed to (76 directories, migrated in later phases). Every site\n// that currently recognizes a `.vibei` contract file by extension must also\n// recognize `.vpkg` during the migration, so a directory may use EITHER\n// spelling. This is the ONE shared boolean test — string-comparison sites\n// that only need a yes/no \"is this a contract-grammar file\" answer should\n// call this instead of duplicating the `String::ends_with` pair. Sites that\n// need to build a candidate path (e.g. `dir + \"/index.vpkg\"`) still spell the\n// literal suffix themselves.\nexport fn is_contract_ext(path: String) -> Bool {\n  String::ends_with(path, \".vibei\") || String::ends_with(path, \".vpkg\")\n}\n\nexport fn dir_of_path(file_path: String) -> String {\n  let idx = String::last_index_of(file_path, \"/\")\n  if idx < 0 {\n    \"\"\n  } else if idx == 0 {\n    \"/\"\n  } else {\n    file_path[0: idx]\n  }\n}\n\n// Module/package sources must be regular filesystem entries.\nexport fn ensure_regular_source_fs(path: String) -> Unit with { Error, Fs } {\n  // The Fs::stat_token host ABI reserves -1 for a symbolic link. This keeps\n  // symlink rejection bootstrap-compatible without adding a new builtin that\n  // the pinned seed compiler could not yet type-check.\n  if Fs::stat_token(path) == -1 {\n    throw(\"symlink module source is not allowed: \\{path}\")\n  } else {\n    ()\n  }\n}\n\nexport fn path_in_dir(dir: String, basename: String) -> String {\n  if dir == \"\" {\n    basename\n  } else if dir == \"/\" {\n    String::concat(\"/\", basename)\n  } else {\n    String::concat(String::concat(dir, \"/\"), basename)\n  }\n}\n\nexport fn vpkg_path_in_dir(dir: String) -> String {\n  path_in_dir(dir, \"index.vpkg\")\n}\n\n// The nearest enclosing index.vpkg is the package owner. Returning the\n// contract path (rather than the directory) also distinguishes a root package\n// from \"no owner\", where both directory strings would otherwise be empty.\nexport fn nearest_vpkg_path_fs(path: String) -> String with { Fs } {\n  let mut current = dir_of_path(path)\n  let mut found = \"\"\n  let mut searching = true\n  while searching {\n    let candidate = vpkg_path_in_dir(current)\n    if Fs::exists(candidate) {\n      ensure_regular_source_fs(candidate)\n      found = candidate\n      searching = false\n    } else {\n      let parent = dir_of_path(current)\n      if parent == current {\n        searching = false\n      } else {\n        current = parent\n      }\n    }\n  }\n  found\n}\n\n// Linear membership scan used by `resolve_reexport_chain` to filter\n// re-exported names. Bounded per-module, not whole-program: `items`\n// (`wanted_names`) is a single re-export selection (typically 1-5 names)\n// and it is scanned once per pub statement of one source file. The\n// original O(N^2)-accumulator survey (#366) classified this as \"small N,\n// refactor pointless\" and #533 re-confirms it. A `Map[String, Bool]`\n// would NOT help: the runtime emits `Map::has_key` as a linear\n// search (#395, closed not-planned). See\n// bench/perf/README.md (\"String-keyed lookup\" postmortem).\nexport fn contains_name(items: Array[String], name: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == name {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// Linear membership scan used by `collect_direct_dep_paths` to dedup the\n// direct dependency paths of one entry file. Bounded by that file's\n// unique imports (≈5-30), so the dedup is O(D^2) with small D (≤ ~900\n// ops, per #366's survey). NOTE: the whole-graph visited/scheduled sets\n// that used to route through this helper (merge recursion, FS collect,\n// manifest worklists) moved to the bucketed `path_set` below (#533);\n// only genuinely small, per-module dedups should keep using this. Kept\n// linear deliberately for those (#533):\n//   - `Map[String, Bool]` is a no-op — the runtime emits\n//     `Map::has_key`/`Map::get` as linear searches (#395 not-planned).\n//   - A sort+merge dedup is UNSAFE: the resulting `dep_paths` order is\n//     preserved into `linked_imports`, which the linked codegen turns\n//     into wasm import-section indices (see\n//     lib/@vibe/compiler/codegen/wasi/linked_compile.vibe). Reordering would\n//     change the emitted binary, breaking reproducibility/parity.\n// First-occurrence insertion order must therefore be preserved.\nexport fn contains_path(visited: Array[String], path: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(visited) && !found {\n    if Array::get(visited, i) == path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// #533: mutable bucketed string set for whole-graph membership tests.\n//\n// The per-module `contains_name` / `contains_path` scans above are fine\n// (small bounded N — see the notes on each), but the graph-traversal\n// dedup sites (`collect_sources_rec`, `collect_merged_stmts_recursive`,\n// the manifest worklist loops) test membership against a set that grows\n// to ALL modules, once per import edge — O(edges × modules) string\n// compares, plus O(modules²) entry copying where the set was a\n// `Map[String, Bool]` (the runtime `Map::set` copies the whole map per\n// insert; `Map::has_key` is a linear scan — #395, closed not-planned).\n//\n// This set is plain `Array[Array[String]]` buckets + `Array::push`, so\n// it relies on nothing but O(1)-amortized array ops: membership and\n// insert are O(len(path)) hash + a short bucket scan, independent of\n// module count. Insert-only; iteration order is NOT meaningful — callers\n// that need ordered output must keep their own insertion-ordered array\n// (see the reorder hazard on `contains_path` above).\nlet path_set_bucket_count = 64\n\nfn path_set_hash(s: String) -> Int {\n  let len = String::length(s)\n  let mut h = 5381\n  let mut i = 0\n  while i < len {\n    // djb2-xor, masked to 30 bits so `h * 33` stays far below the 61-bit\n    // tagged-int range.\n    h = ((h * 33) ^ String::char_code_at(s, i)) & 0x3FFFFFFF\n    i = i + 1\n  }\n  h\n}\n\nexport fn path_set_new() -> Array[Array[String]] {\n  let buckets = array_empty()\n  let mut i = 0\n  while i < path_set_bucket_count {\n    Array::push(buckets, array_empty())\n    i = i + 1\n  }\n  buckets\n}\n\nexport fn path_set_contains(set: Array[Array[String]], path: String) -> Bool {\n  let bucket = Array::get(set, path_set_hash(path) & (path_set_bucket_count - 1))\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(bucket) && !found {\n    if Array::get(bucket, i) == path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// No membership check: callers gate on `path_set_contains` first (every\n// site below is check-then-add), so adding unconditionally here avoids a\n// second hash walk.\nexport fn path_set_add(set: Array[Array[String]], path: String) -> Unit {\n  Array::push(Array::get(set, path_set_hash(path) & (path_set_bucket_count - 1)), path)\n}\n\nexport fn normalize_path(path: String) -> String {\n  let is_absolute = String::length(path) > 0 && String::char_code_at(path, 0) == 47\n  let mut parts = array_empty()\n  let len = String::length(path)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_sep = if i == len {\n      true\n    } else {\n      String::char_code_at(path, i) == 47\n    }\n    if at_sep {\n      let part = path[start: i]\n      let skip_part = if String::length(part) == 0 {\n        true\n      } else {\n        part == \".\"\n      }\n      if skip_part {\n        ()\n      } else if part == \"..\" {\n        // O(1) truncate vs. previous O(N) copy of `parts[0:N-1]` into a\n        // fresh Array.\n        if Array::length(parts) > 0 {\n          Array::truncate(parts, Array::length(parts) - 1)\n        }\n      } else {\n        Array::push(parts, part)\n      }\n      start = i + 1\n    }\n    i = i + 1\n  }\n  // Build the joined output via StringBuilder. The previous code did\n  // `out = String::concat(out, ...)` in a loop, which is O(N²) over the\n  // segment count because each concat allocates and copies the growing\n  // string. Same shape as the StringBuilder migrations issue #366\n  // tracks for the rest of this codebase.\n  let buf = StringBuilder::new()\n  if is_absolute {\n    StringBuilder::push(buf, \"/\")\n  }\n  let mut pi = 0\n  while pi < Array::length(parts) {\n    if pi > 0 {\n      StringBuilder::push(buf, \"/\")\n    }\n    StringBuilder::push(buf, Array::get(parts, pi))\n    pi = pi + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport fn get_export_name(items: Array[(String, Option[String])], name: String) -> String {\n  let mut result = name\n  let mut i = 0\n  while i < Array::length(items) {\n    let (iname, irename) = Array::get(items, i)\n    if iname == name {\n      match irename {\n        Some(alias) => {\n          result = alias\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n  result\n}\n\nfn join_relative_path(base_dir: String, raw_path: String) -> String {\n  if base_dir == \"\" || base_dir == \"/\" {\n    String::concat(base_dir, raw_path)\n  } else {\n    String::concat(base_dir, String::concat(\"/\", raw_path))\n  }\n}\n\nexport fn path_to_module_name(path: String) -> String {\n  let len = String::length(path)\n  let mut last_slash = -1\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(path, i) == 47 {\n      last_slash = i\n    }\n    i = i + 1\n  }\n  let base = if last_slash >= 0 {\n    path[last_slash + 1: len]\n  } else {\n    path\n  }\n  let base_len = String::length(base)\n  if String::ends_with(base, \".vibe\") {\n    base[0: base_len - 5]\n  } else {\n    base\n  }\n}\n\nexport fn path_has_relative_prefix(raw_path: String, len: Int) -> Bool {\n  // Bare `.` / `..` are relative too: `import . { x }` targets the importing\n  // file's own directory index. They were previously treated as workspace-\n  // root-relative raw paths, so `.` normalized to \"\" and the first candidate\n  // became \".vibe\" — the workspace STORE DIRECTORY — which fs_read trapped on\n  // with no diagnostic (EISDIR from the host).\n  if raw_path == \".\" || raw_path == \"..\" {\n    true\n  } else if len >= 2 {\n    if raw_path[0: 2] == \"./\" {\n      true\n    } else if len >= 3 {\n      raw_path[0: 3] == \"../\"\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\nexport fn resolve_import_path(base_dir: String, raw_path: String) -> String {\n  let len = String::length(raw_path)\n  let joined = if path_has_relative_prefix(raw_path, len) {\n    join_relative_path(base_dir, raw_path)\n  } else {\n    raw_path\n  }\n  let normalized = normalize_path(joined)\n  if String::ends_with(normalized, \".vibe\") {\n    normalized\n  } else {\n    String::concat(normalized, \".vibe\")\n  }\n}\n\n// #751 (ADR-0065): the private Env effect + checker-only discharge below\n// let this module read VIBE_LIB / VIBE_HOME / HOME without carrying an\n// `Env` row on every resolver in the loader chain: builtin `Env::get`\n// compiles to the env-get host import DIRECTLY, so the handler arm is never\n// invoked at runtime (same mechanism as the Fs handles in\n// fixtures/fs_readdir_test.vibe). The effect declaration is private —\n// nothing outside this module sees it.\neffect Env {\n  Get(String) -> String\n}\n\nfn env_get_raw(name: String) -> String with { Env } {\n  Env::get(name)\n}\n\nfn read_env_discharged(name: String) -> String {\n  handle {\n    env_get_raw(name)\n  } with Env {\n    Get(_n) => resume(\"\")\n  }\n}\n\nfn strip_trailing_slash(p: String) -> String {\n  let len = String::length(p)\n  if len > 1 && String::ends_with(p, \"/\") {\n    p[0: len - 1]\n  } else {\n    p\n  }\n}\n\n// #751 (ADR-0065): external library roots, PATH-style. Pure so it is\n// testable: VIBE_LIB (\":\"-separated, empty segments dropped) wins;\n// otherwise the default single root is $VIBE_HOME/lib, falling back to\n// $HOME/.vibe/lib. No environment at all -> no external roots\n// (workspace-only resolution).\nexport fn parse_vibe_lib_roots(vibe_lib: String, vibe_home: String, home: String) -> Array[String] {\n  let roots = array_empty()\n  if String::length(vibe_lib) > 0 {\n    let parts = String::split(vibe_lib, \":\")\n    let mut i = 0\n    while i < Array::length(parts) {\n      let part = Array::get(parts, i)\n      if String::length(part) > 0 {\n        Array::push(roots, strip_trailing_slash(part))\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n  } else if String::length(vibe_home) > 0 {\n    Array::push(roots, String::concat(strip_trailing_slash(vibe_home), \"/lib\"))\n  } else if String::length(home) > 0 {\n    Array::push(roots, String::concat(strip_trailing_slash(home), \"/.vibe/lib\"))\n  } else {\n    ()\n  }\n  roots\n}\n\nexport fn external_lib_roots() -> Array[String] {\n  parse_vibe_lib_roots(read_env_discharged(\"VIBE_LIB\"), read_env_discharged(\"VIBE_HOME\"), read_env_discharged(\"HOME\"))\n}\n\n// #751: \"is the environment flag set to 1\" — the loader's freeze switch\n// (VIBE_REQUIRE_PINS) reads through the same checker-only discharge so its\n// signature stays effect-free.\nexport fn vibe_env_flag(name: String) -> Bool {\n  read_env_discharged(name) == \"1\"\n}\n\n// #758 review (P1): the RESOLUTION ENVIRONMENT as a cache-key seed. The\n// persistent header/dep-list/source-list caches store RESOLVED graphs, and\n// resolution depends on the external lib roots (#751) and the freeze switch\n// — a graph cached without pins under one VIBE_LIB must not be replayed\n// under VIBE_REQUIRE_PINS=1 or a different root list (the freeze gate and\n// the pin verification only run on the cold walk). Folding this seed into\n// the cache paths makes each environment its own cache universe instead of\n// re-verifying cached graphs on load.\nexport fn resolution_env_seed() -> String {\n  let roots = external_lib_roots()\n  let pins = if vibe_env_flag(\"VIBE_REQUIRE_PINS\") {\n    \"1\"\n  } else {\n    \"0\"\n  }\n  String::concat(\"|roots=\", String::concat(String::join(roots, \":\"), String::concat(\"|pins=\", pins)))\n}\n\nexport fn resolve_import_path_candidates(base_dir: String, raw_path: String) -> Array[String] {\n  // #730 (ADR-0063 §5/§6): `@scope/name` package refs resolve to the\n  // workspace store, laid out BY NAME and verified BY HASH against the\n  // importer's require pin (verification happens in the loader; this\n  // function stays pure). Root-relative, independent of base_dir.\n  // #751 (ADR-0065): `lib/@scope/name` is the SECOND candidate — dev-mode\n  // resolution for in-repo packages and the materialize target for\n  // distributed ones. The pinned store wins when both exist; a lib/-resolved\n  // package is a contract package like the store (index.vibei required,\n  // boundary + conformance apply by path) but is NOT pin-verified — pins\n  // stay mandatory on the store/release path only. External roots (VIBE_LIB,\n  // default $VIBE_HOME/lib -> ~/.vibe/lib) come LAST, in list order — the\n  // workspace always wins over the installation. Both runners' raw fs lanes\n  // read absolute paths, so external roots need no extra preopen.\n  if String::starts_with(raw_path, \"@\") {\n    let candidates = array_empty()\n    // #897 (ADR-0070 Phase 1): each root probes `.vpkg` (the target spelling)\n    // BEFORE `.vibei` (legacy, still valid during the migration), so a\n    // directory that has switched to `.vpkg` resolves without needing the\n    // pin/verify lanes to change at all — only the candidate list grows.\n    Array::push(candidates, String::concat(\".vibe/store/\", String::concat(raw_path, \"/index.vpkg\")))\n    Array::push(candidates, String::concat(\".vibe/store/\", String::concat(raw_path, \"/index.vibei\")))\n    Array::push(candidates, String::concat(\"lib/\", String::concat(raw_path, \"/index.vpkg\")))\n    Array::push(candidates, String::concat(\"lib/\", String::concat(raw_path, \"/index.vibei\")))\n    let roots = external_lib_roots()\n    let mut ri = 0\n    while ri < Array::length(roots) {\n      Array::push(candidates, String::concat(Array::get(roots, ri), String::concat(\"/\", String::concat(raw_path, \"/index.vpkg\"))))\n      Array::push(candidates, String::concat(Array::get(roots, ri), String::concat(\"/\", String::concat(raw_path, \"/index.vibei\"))))\n      ri = ri + 1\n    }\n    return candidates\n  } else ()\n  let len = String::length(raw_path)\n  let joined = if path_has_relative_prefix(raw_path, len) {\n    join_relative_path(base_dir, raw_path)\n  } else {\n    raw_path\n  }\n  let normalized = normalize_path(joined)\n  if String::ends_with(normalized, \".vibe\") {\n    [\n      normalized\n    ]\n  } else {\n    // #729: a bare (directory-style) import may target a contract package —\n    // `<dir>/index.vibei` (or, #897, `<dir>/index.vpkg`) is probed between\n    // the plain-file and index.vibe forms. Existence-probing resolvers pick\n    // it up when present; index-0 stays the plain-file form so no-match\n    // fallbacks are unchanged. `.vpkg` is tried before `.vibei` (#897:\n    // target spelling wins when a directory somehow has neither yet\n    // resolved, matching the `@scope/name` root ordering above).\n    [\n      String::concat(normalized, \".vibe\"),\n      String::concat(normalized, \"/index.vpkg\"),\n      String::concat(normalized, \"/index.vibei\"),\n      String::concat(normalized, \"/index.vibe\")\n    ]\n  }\n}\n")
}

let cli_adapter_source_174 = () -> (String, String) {
  ("lib/@vibe/compiler/loader/header_cache.vibe",
"//# Imports\n\nimport @vibe/cache {\n  parse_persistent_module_header_text, persistent_module_header_text\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/cache {\n  compact_string_fingerprint, normalize_persistent_cache_text, package_index_deps_are_current, persistent_module_header_cache_path\n}\n\nimport @vibe/compiler/core {\n  Stmt,\n  dir_of_path, ensure_regular_source_fs, is_contract_ext, nearest_vpkg_path_fs,\n  path_has_relative_prefix, resolve_import_path_candidates\n}\n\nimport @vibe/compiler/runtime/eval_loader {\n  collect_exports\n}\n\nimport @vibe/compiler/syntax {\n  lex, lex_with_offsets, offset_to_line_col, parse_program, parse_program_located\n}\nimport @vibe/compiler/contract {\n  classify_contract_stmts, contract_facade_marker, extract_package_version, extract_require_pins, parse_contract_program\n}\n\n//# Functions\n\nfn resolve_path_fs(base_dir: String, raw_path: String, self_path: String) -> String with { Fs } {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = \"\"\n  let mut fallback = \"\"\n  while i < Array::length(candidates) {\n    let candidate = Array::get(candidates, i)\n    // A directory-style import from a same-named facade file resolves its\n    // plain-file candidate to the IMPORTING file itself (`export ./codegen`\n    // inside codegen.vibe -> codegen.vibe): a self-dep is never meant, it\n    // only manufactures \"type_db: import cycle detected\". Skip it so the\n    // probe falls through to <dir>/index.vibe(i).\n    if candidate == self_path {\n      ()\n    } else {\n      if fallback == \"\" {\n        fallback = candidate\n      } else {\n        ()\n      }\n      if found == \"\" && Fs::exists(candidate) {\n        found = candidate\n      } else {\n        ()\n      }\n    }\n    i = i + 1\n  }\n  if found == \"\" {\n    if fallback == \"\" {\n      Array::get(candidates, 0)\n    } else {\n      fallback\n    }\n  } else {\n    found\n  }\n}\n\nfn is_special_bundle_path(path: String) -> Bool {\n  String::ends_with(path, \"compiler_sources_bundle.vibe\") || String::ends_with(path, \"cli_adapter_bundle.vibe\") || String::ends_with(path, \"selfbuild_runtime_entry_bundle.vibe\")\n}\n\nfn special_bundle_header(path: String) -> Option[(Array[String], Array[String])] {\n  if String::ends_with(path, \"compiler_sources_bundle.vibe\") {\n    Some((array_empty(), [\n      \"compiler_sources\",\n      \"compiler_source_groups\"\n    ]))\n  } else if String::ends_with(path, \"cli_adapter_bundle.vibe\") {\n    Some((array_empty(), [\n      \"cli_adapter_sources\",\n      \"cli_adapter_source_groups\",\n      \"cli_adapter_ordered_sources\",\n      \"cli_adapter_merged_source\",\n      \"cli_adapter_module_source\"\n    ]))\n  } else if String::ends_with(path, \"selfbuild_runtime_entry_bundle.vibe\") {\n    Some((array_empty(), [\n      \"selfbuild_runtime_entry_source\"\n    ]))\n  } else {\n    None\n  }\n}\n\n// #831: a plain relative/workspace-absolute import (`import ./x.vibe { .. }`,\n// `export ./x.vibe { .. }`) whose resolved candidate does not exist on disk\n// used to reach `Fs::read_file` unguarded further down the pipeline\n// (`collect_sources_rec`), which is a raw host primitive -- a missing file\n// there is a JS-level throw from the host runner, NOT a guest `Error` effect,\n// so it crosses the wasm/JS boundary uncaught and prints a \"[crash debug]\"\n// dump instead of a located diagnostic. Catch it HERE, at the import\n// resolution call site, where the raw import spelling and the importing\n// module's source text (for a line:col lookup) are still both in scope.\n// `@scope/name` package refs are exempt: their resolution has its own,\n// more specific existence + pin checks downstream (`verify_store_package_fs`,\n// `verify_lib_package_fs` in loader/index.vibe), which report a better\n// message (pin/store-install guidance) than a generic \"cannot resolve\n// import\" would.\nfn located_missing_import_error(source: String, keyword: String, raw_path: String, resolved: String) -> String {\n  let base_msg = String::concat(\"cannot resolve import '\", String::concat(raw_path, String::concat(\"' (resolved to \", String::concat(resolved, \")\"))))\n  let needle = String::concat(keyword, String::concat(\" \", raw_path))\n  let needle_off = String::index_of(source, needle)\n  let off = if needle_off >= 0 {\n    needle_off + String::length(keyword) + 1\n  } else {\n    String::index_of(source, raw_path)\n  }\n  if off < 0 {\n    base_msg\n  } else {\n    let (line, col) = offset_to_line_col(source, off)\n    String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), String::concat(\": \", base_msg)))))\n  }\n}\n\n// The `@scope/name...` spelling a relative-import-boundary error should\n// suggest instead, derived from the resolved package owner's contract path\n// (`lib/@vibe/compiler/core/index.vpkg` -> `@vibe/compiler/core`,\n// `.vibe/store/@vibe/json/index.vpkg` -> `@vibe/json`). Unlike\n// `import_display_name` above (a short display label, truncated to the\n// first two `@scope/name` segments), this must reproduce the FULL lib/-\n// relative path so a compiler-internal nested package (no separate `@`\n// identity of its own) still gets a spelling that actually resolves.\nfn qualified_package_name_from_owner(owner: String) -> String {\n  let without_suffix = if String::ends_with(owner, \"/index.vpkg\") {\n    owner[0: String::length(owner) - String::length(\"/index.vpkg\")]\n  } else if String::ends_with(owner, \"/index.vibei\") {\n    owner[0: String::length(owner) - String::length(\"/index.vibei\")]\n  } else {\n    owner\n  }\n  if String::starts_with(without_suffix, \"lib/\") {\n    without_suffix[String::length(\"lib/\"): String::length(without_suffix)]\n  } else if String::starts_with(without_suffix, \".vibe/store/\") {\n    without_suffix[String::length(\".vibe/store/\"): String::length(without_suffix)]\n  } else {\n    without_suffix\n  }\n}\n\n// The message must contain the literal phrase \"package boundary\" and the\n// target owner's path: `enforce_incoming_boundary_fs`'s established\n// \"cannot import ... across a package boundary\" wording (loader.vibe,\n// #729) is what tests/fixtures across this tree assert on\n// (contract_vpkg_test.vibe's \"nested package cannot import parent\n// internals\" / \"parent package cannot import nested package internals\").\nfn located_package_boundary_error(source: String, keyword: String, raw_path: String, suggestion: String) -> String {\n  let base_msg = String::concat(\"relative \", String::concat(keyword, String::concat(\" '\", String::concat(raw_path, String::concat(\"' crosses a package boundary; use `\", String::concat(keyword, String::concat(\" \", String::concat(suggestion, \"` instead\"))))))))\n  let needle = String::concat(keyword, String::concat(\" \", raw_path))\n  let needle_off = String::index_of(source, needle)\n  let off = if needle_off >= 0 {\n    needle_off + String::length(keyword) + 1\n  } else {\n    String::index_of(source, raw_path)\n  }\n  if off < 0 {\n    base_msg\n  } else {\n    let (line, col) = offset_to_line_col(source, off)\n    String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), String::concat(\": \", base_msg)))))\n  }\n}\n\n// A relative (`./`, `../`) import must stay within the importing file's own\n// nearest `index.vpkg`-owned package -- reaching a DIFFERENT package,\n// including the neighbor's own facade, is only allowed via a qualified\n// `@scope/name` (or compiler-internal `@scope/name/...`) import. This closes\n// the loophole `enforce_incoming_boundary_fs` (loader.vibe) deliberately\n// leaves open for `@`-qualified imports of a neighbor's facade: that\n// exception is for the CORRECT spelling, not the relative one.\n//\n// `export` (re-export, SReExport) is exempt: the parser's export-statement\n// grammar has no `@scope/name` production at all (only `.`/`..`-prefixed\n// paths), so a boundary-crossing re-export has no alternative spelling to\n// migrate to yet -- enforcing this on `export` would just break working\n// facades with no fix available.\nfn enforce_relative_import_package_boundary_fs(raw_path: String, self_path: String, resolved: String, source: String, keyword: String) -> Unit with { Error, Fs } {\n  if keyword == \"import\" && path_has_relative_prefix(raw_path, String::length(raw_path)) {\n    let importer_owner = nearest_vpkg_path_fs(self_path)\n    let target_owner = nearest_vpkg_path_fs(resolved)\n    if importer_owner == \"\" || target_owner == \"\" || importer_owner == target_owner {\n      ()\n    } else {\n      throw(located_package_boundary_error(source, keyword, raw_path, qualified_package_name_from_owner(target_owner)))\n    }\n  } else ()\n}\n\nfn resolve_checked_path_fs(base_dir: String, raw_path: String, self_path: String, source: String, keyword: String) -> String with { Error, Fs } {\n  let resolved = resolve_path_fs(base_dir, raw_path, self_path)\n  if String::starts_with(raw_path, \"@\") || Fs::exists(resolved) {\n    enforce_relative_import_package_boundary_fs(raw_path, self_path, resolved, source, keyword)\n    resolved\n  } else {\n    throw(located_missing_import_error(source, keyword, raw_path, resolved))\n  }\n}\n\n// #943: `import <pkg> { a, b }` / `export <pkg> { a, b }` names used to bind\n// blindly against whatever the resolved module's CHECKED env happened to\n// contain (runtime/index.vibe's `bind_import_names_from_cache` does a flat,\n// export-UNAWARE lookup): a nonexistent name silently became `CtUnknown` (no\n// error unless later used somewhere that needed a real type), and a\n// genuinely PRIVATE name silently bound its REAL type (every top-level def\n// is present in a checked module's env, exported or not) and only failed\n// much later, UNLOCATED, deep inside the codegen merge's export-aware\n// private-namespacing pass (\"undefined variable (local): <name>\", no\n// file/line, no mention of the import). Catch it HERE instead, at the same\n// call site that already resolves the raw import path and has the\n// importing module's own source text in scope for a line:col lookup\n// (mirrors `located_missing_import_error` above).\n//\n// Scope (deliberately conservative -- see #943 discussion): only checked\n// when the import target is a CONTRACT package boundary (`.../index.vpkg`\n// or `.../index.vibei` -- ADR-0063/ADR-0070's declared-surface packages,\n// the same shape #729/#847's boundary-enforcement machinery treats as the\n// sole authoritative entry point), and only for plain lowercase-leading\n// value names (see `is_lowercase_leading_plain_ident`). Shapes left\n// UNVALIDATED on purpose:\n//   - plain `index.vibe` facade directories: their effective surface is\n//     historically LEAKIER than the facade's own re-export list --\n//     fixtures/import_visibility_float_eq_test.vibe (#716) deliberately\n//     imports `eq` through prelude/index.vibe even though the facade only\n//     lists `Float::eq` (the merge-level export of float.vibe's `export\n//     let eq` is what actually binds). A facade's collect_exports list is\n//     therefore not a positive proof of absence.\n//   - direct-file imports (`import ../checker_effects.vibe { ... }`, the\n//     common compiler-internal shape): same-package edges are not a\n//     package-contract question at all.\n//   - a package whose store/lib copy is not materialized (unresolved\n//     `@scope/name` pin) -- the `Fs::exists` guard below.\nfn is_contract_boundary_path(path: String) -> Bool {\n  String::ends_with(path, \"/index.vibei\") || String::ends_with(path, \"/index.vpkg\")\n}\n\n// Type names, enum-variant constructors, and `Type::member` qualified items\n// (`import ../ast { type Json, Type::method }`) are excluded on purpose:\n// `collect_exports` (reused below for the VALUE namespace) enumerates enum\n// VARIANT constructors but never the enum/struct/alias/trait NAME itself, so\n// a routine, entirely legitimate `import ../core { Stmt, Expr,\n// TypeEnv, ... }` (used all over this compiler) would false-positive as \"not\n// exported\" if type-shaped names were checked against the same list. The\n// vibe convention is snake_case values / UpperCamelCase types (CLAUDE.md),\n// so a lowercase first letter reliably selects the VALUE namespace this\n// check can actually speak to.\nfn is_lowercase_leading_plain_ident(name: String) -> Bool {\n  if String::length(name) == 0 {\n    false\n  } else if String::index_of(name, \"::\") >= 0 {\n    false\n  } else {\n    let c = String::char_code_at(name, 0)\n    c >= 97 && c <= 122\n  }\n}\n\nfn string_array_contains_hc(items: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// The target's OWN export surface only -- deliberately NOT recursive (never\n// walks the target's own imports/deps). Reusing\n// `load_or_parse_module_header_fs_impl(resolved, ..)` here would recurse\n// into this same validation for the target's own import list, which\n// recurses again for ITS deps, and so on -- effectively re-validating the\n// whole transitive import graph from every single edge. This reads +\n// (contract-)parses `resolved` exactly once instead, mirroring the same\n// decls/opaques/collect_exports combination the contract-header branch above\n// already uses for its own `exports` result.\nfn resolved_export_names_fs(resolved: String) -> Array[String] with { Error, Fs } {\n  let source = Fs::read_file(resolved)\n  if is_contract_ext(resolved) && !String::starts_with(source, contract_facade_marker) {\n    let (_, pin_blanked) = extract_require_pins(source)\n    let (cdecls, copaques, cextra) = parse_contract_program(lex(pin_blanked))\n    let names = collect_exports(cextra)\n    let mut cdi = 0\n    while cdi < Array::length(cdecls) {\n      let (cdname, _) = Array::get(cdecls, cdi)\n      Array::push(names, cdname)\n      cdi = cdi + 1\n    }\n    let mut coi = 0\n    while coi < Array::length(copaques) {\n      let (coname, _) = Array::get(copaques, coi)\n      Array::push(names, coname)\n      coi = coi + 1\n    }\n    // `version` is synthesized into the facade from the package's own\n    // `version x.y.z` directive (see desugar_contract_source_fs) rather than\n    // requiring a `let version: String` contract decl -- mirror that here so\n    // this header-only export list agrees with the actual generated facade.\n    if extract_package_version(source) == \"\" || string_array_contains_hc(names, \"version\") {\n      ()\n    } else {\n      Array::push(names, \"version\")\n    }\n    names\n  } else {\n    collect_exports(parse_program(lex(source)))\n  }\n}\n\nfn located_import_name_error(source: String, keyword: String, raw_path: String, name: String, display: String) -> String {\n  let base_msg = String::concat(\"\\\"\", String::concat(name, String::concat(\"\\\" is not exported by \", display)))\n  let needle = String::concat(keyword, String::concat(\" \", raw_path))\n  let needle_off = String::index_of(source, needle)\n  let off = if needle_off >= 0 {\n    needle_off + String::length(keyword) + 1\n  } else {\n    String::index_of(source, raw_path)\n  }\n  if off < 0 {\n    base_msg\n  } else {\n    let (line, col) = offset_to_line_col(source, off)\n    String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), String::concat(\": \", base_msg)))))\n  }\n}\n\n// A friendly `@scope/name` label for the error message when derivable from\n// the resolved on-disk path (`.../lib/@vibe/json/index.vpkg` -> `@vibe/json`);\n// falls back to the raw import spelling otherwise.\nfn import_display_name(raw_path: String, resolved: String) -> String {\n  if String::starts_with(raw_path, \"@\") {\n    raw_path\n  } else {\n    let at = String::last_index_of(resolved, \"@\")\n    if at < 0 {\n      raw_path\n    } else {\n      let rest = String::substring(resolved, at, String::length(resolved))\n      let slash1 = String::index_of(rest, \"/\")\n      if slash1 < 0 {\n        raw_path\n      } else {\n        let after_scope = String::substring(rest, slash1 + 1, String::length(rest))\n        let slash2 = String::index_of(after_scope, \"/\")\n        if slash2 < 0 {\n          rest\n        } else {\n          String::substring(rest, 0, slash1 + 1 + slash2)\n        }\n      }\n    }\n  }\n}\n\nfn validate_import_names_fs(source: String, keyword: String, raw_path: String, resolved: String, names: Array[(String, Option[String])]) -> Unit with { Error, Fs } {\n  if is_contract_boundary_path(resolved) && Fs::exists(resolved) {\n    let mut dep_exports = array_empty()\n    let mut loaded = false\n    let mut i = 0\n    while i < Array::length(names) {\n      let (name, _alias) = Array::get(names, i)\n      if is_lowercase_leading_plain_ident(name) {\n        if !loaded {\n          dep_exports = resolved_export_names_fs(resolved)\n          loaded = true\n        } else ()\n        if string_array_contains_hc(dep_exports, name) {\n          ()\n        } else {\n          throw(located_import_name_error(source, keyword, raw_path, name, import_display_name(raw_path, resolved)))\n        }\n      } else ()\n      i = i + 1\n    }\n  } else ()\n}\n\nfn collect_import_deps_from_stmts(stmts: Array[Stmt], base_dir: String, self_path: String, source: String) -> Array[String] with { Error, Fs } {\n  let deps = array_empty()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, names) => {\n        let resolved = resolve_checked_path_fs(base_dir, raw_path, self_path, source, \"import\")\n        validate_import_names_fs(source, \"import\", raw_path, resolved, names)\n        Array::push(deps, resolved)\n      },\n      SReExport(raw_path, names) => {\n        let resolved = resolve_checked_path_fs(base_dir, raw_path, self_path, source, \"export\")\n        validate_import_names_fs(source, \"export\", raw_path, resolved, names)\n        Array::push(deps, resolved)\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  deps\n}\n\n// Direct production siblings of a contract package, as raw import spellings\n// (`./<name>`). Subdirectories are never scanned implicitly: their sources\n// enter the graph only through an explicit relative import from a direct root.\n// Fs::readdir is byte-sorted, so facade, hash, and dependency order remain\n// deterministic.\nfn directory_entry_path(dir: String, name: String) -> String {\n  if dir == \"\" {\n    name\n  } else if dir == \"/\" {\n    String::concat(\"/\", name)\n  } else {\n    String::concat(dir, String::concat(\"/\", name))\n  }\n}\n\nexport fn contract_sibling_impl_raws(dir: String) -> Array[String] with { Error, Fs } {\n  let out = array_empty()\n  let scan_dir = if dir == \"\" { \".\" } else { dir }\n  let names = Fs::readdir(scan_dir)\n  let mut i = 0\n  while i < Array::length(names) {\n    let name = Array::get(names, i)\n    if name != \"index.vibei\" && name != \"index.vibe\" && name != \"index.vpkg\" && String::ends_with(name, \".vibe\") && !String::ends_with(name, \"_test.vibe\") && !String::ends_with(name, \"_bench.vibe\") && !String::ends_with(name, \".draft.vibe\") && !String::starts_with(name, \"_\") {\n      let full = directory_entry_path(dir, name)\n      ensure_regular_source_fs(full)\n      Array::push(out, String::concat(\"./\", name))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// #897/#855 (ADR-0070 Phase 1): a .vpkg contract gets implicit membership\n// unconditionally (unlike .vibei's legacy all-or-nothing gate) -- explicit\n// `import ./x.vibe {}` declarations are merged with auto-discovered\n// siblings rather than suppressing discovery. `explicit` wins ordering (its\n// declared spelling is part of the package hash); newly-discovered names\n// are appended after, de-duplicated, preserving contract_sibling_impl_raws'\n// deterministic byte-sorted discovery order for anything not already listed.\nexport fn merge_impl_raws_dedupe(explicit: Array[String], discovered: Array[String]) -> Array[String] {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(explicit) {\n    Array::push(out, Array::get(explicit, i))\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(discovered) {\n    let d = Array::get(discovered, j)\n    let mut k = 0\n    let mut found = false\n    while k < Array::length(out) && !found {\n      if Array::get(out, k) == d {\n        found = true\n      } else {\n        k = k + 1\n      }\n    }\n    if !found {\n      Array::push(out, d)\n    } else {\n      ()\n    }\n    j = j + 1\n  }\n  out\n}\n\nexport fn load_or_parse_module_header_fs_impl(path: String, source: String, parse_count: Int) -> (Array[String], Array[String], Int) with { Error, Fs } {\n  let cache_path = persistent_module_header_cache_path(path, compact_string_fingerprint(source))\n  // #801 follow-up: a warm header whose package-index deps no longer match\n  // the current resolution winners was written under a different resolution\n  // context (a store copy appeared or vanished) — fall through to the cold\n  // lane and re-resolve. Plain Bool dispatch (mut flag), NOT an Option match\n  // wrapping the parser calls below — see the #708 note in the cold lane.\n  let mut warm_deps = array_empty()\n  let mut warm_exports = array_empty()\n  let mut warm_ok = false\n  if Fs::exists(cache_path) {\n    let parsed = parse_persistent_module_header_text(normalize_persistent_cache_text(Fs::read_file(cache_path)))\n    // #943 review (Codex P2): the cache key only covers the IMPORTER's\n    // source, so editing a target contract (dropping/renaming an export)\n    // while the importer is unchanged used to replay the stale header and\n    // skip import-name validation entirely. v2 entries record each\n    // contract-boundary dep's content fingerprint at build time; any\n    // mismatch (or a pre-v2 entry, which recorded none) falls through to\n    // the cold lane, which re-validates the import list against the\n    // CURRENT contract surface.\n    if parsed.3 && package_index_deps_are_current(parsed.0) && contract_dep_fingerprints_current(parsed.2) {\n      warm_deps = parsed.0\n      warm_exports = parsed.1\n      warm_ok = true\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n  if warm_ok {\n    (warm_deps, warm_exports, parse_count)\n  } else {\n    // #708: dispatch on `is_special_bundle_path` (a plain Bool) rather than\n    // matching `special_bundle_header(path)`'s Option result directly here,\n    // and never nest the `Some((deps, exports))` tuple-in-option pattern in\n    // the same match as the `None` arm's parse call. A compiler that is\n    // itself self-hosted under RC traps (\"wasm unreachable\" in `tk_name`,\n    // reached via `parse_stmt`) reading a corrupted Token tag when\n    // `load_or_parse_module_header_fs_impl` is compiled with the call chain\n    // that reaches `tk_name` (lex_with_offsets/parse_program_located, or\n    // even the plain lex/parse_program pair) sitting inside ONE arm of a\n    // `match` on `special_bundle_header(path)`'s `Option` result — even\n    // though that arm is never taken for ordinary (non-bundle-file) input.\n    // Splitting the dispatch into this Bool `if` (special_bundle_header is\n    // then only ever called, and only ever `match`ed, inside the branch that\n    // does NOT also reach the parser) reproducibly avoids the trap for the\n    // simplest repro. NOT a full fix for #708: a structurally similar crash\n    // still reproduces one level deeper (`parse_type_impl`, reached once the\n    // input has a type annotation) -- root cause remains uncharacterized, and\n    // this workaround likely needs to be repeated at that/other call sites.\n    // #753: an already-desugared facade can reach this parse under its\n    // .vibei path (type_db re-reads COLLECTED sources, and collection\n    // replaces a contract's text with its facade). A facade is ordinary\n    // program syntax — re-parsing it as contract grammar mis-reads its\n    // surface (a facade with only type defs has zero impl imports, which\n    // would trigger sibling auto-discovery below and pull `_test.vibe`\n    // neighbors into the package's dep set — \"import cycle detected\" for\n    // any `import .` test). Route it to the ordinary branch instead.\n    let is_contract_source = is_contract_ext(path) && !String::starts_with(source, contract_facade_marker)\n    let header_result = if is_contract_source {\n      // #740 fallout: a .vibei contract is not ordinary program syntax\n      // (bodyless fn/type declarations), so the full-program parse below\n      // threw \"expected = but got type\". Only the COLD-cache lane reaches\n      // this parse (warm runs read the cached header), which is why it\n      // survived until the whole-graph cold repro. Parse with the contract\n      // grammar instead: deps come from the implementation imports, the\n      // export surface from decls + opaques + transparent type stmts.\n      let (_, pin_blanked) = extract_require_pins(source)\n      let (cdecls, copaques, cextra) = parse_contract_program(lex(pin_blanked))\n      let cexports = collect_exports(cextra)\n      let mut cdi = 0\n      while cdi < Array::length(cdecls) {\n        let (cdname, _) = Array::get(cdecls, cdi)\n        Array::push(cexports, cdname)\n        cdi = cdi + 1\n      }\n      let mut coi = 0\n      while coi < Array::length(copaques) {\n        let (coname, _) = Array::get(copaques, coi)\n        Array::push(cexports, coname)\n        coi = coi + 1\n      }\n      // Mirror resolved_export_names_fs: `version` is synthesized into the\n      // facade from the package's own `version x.y.z` directive rather than\n      // requiring a `let version: String` contract decl.\n      if extract_package_version(source) == \"\" || string_array_contains_hc(cexports, \"version\") {\n        ()\n      } else {\n        Array::push(cexports, \"version\")\n      }\n      // #730: a contract with no implementation imports auto-discovers its\n      // siblings — those files are deps of the header too, or an impl edit\n      // would not invalidate this cache entry.\n      // #897/#855: a .vpkg contract always merges discovered siblings with\n      // its explicit deps (implicit membership is unconditional for .vpkg),\n      // so its header deps must include both, not just whichever won under\n      // the old either/or gate.\n      let cdeps = collect_import_deps_from_stmts(cextra, dir_of_path(path), path, pin_blanked)\n      let is_vpkg_contract = String::ends_with(path, \".vpkg\")\n      let cdeps2 = if is_vpkg_contract || Array::length(cdeps) == 0 {\n        let craws = if is_vpkg_contract {\n          let (craws0, _) = classify_contract_stmts(cextra)\n          merge_impl_raws_dedupe(craws0, contract_sibling_impl_raws(dir_of_path(path)))\n        } else {\n          contract_sibling_impl_raws(dir_of_path(path))\n        }\n        let resolved = array_empty()\n        let mut cri = 0\n        while cri < Array::length(craws) {\n          Array::push(resolved, resolve_path_fs(dir_of_path(path), Array::get(craws, cri), path))\n          cri = cri + 1\n        }\n        resolved\n      } else {\n        cdeps\n      }\n      (cdeps2, cexports, parse_count + 1)\n    } else if is_special_bundle_path(path) {\n      match special_bundle_header(path) {\n        Some(pair) => {\n          let deps = pair.0\n          let exports = pair.1\n          (deps, exports, parse_count)\n        },\n        None => (array_empty(), array_empty(), parse_count)\n      }\n    } else {\n      let (tokens, starts, _ends) = lex_with_offsets(source)\n      let stmts = handle {\n        parse_program_located(tokens, starts, source)\n      } with Error {\n        Throw(msg) => throw(String::concat(path, String::concat(\": \", msg)))\n      }\n      (collect_import_deps_from_stmts(stmts, dir_of_path(path), path, source), collect_exports(stmts), parse_count + 1)\n    }\n    let deps = header_result.0\n    let exports = header_result.1\n    let next_parse_count = header_result.2\n    Fs::write_file(cache_path, persistent_module_header_text(deps, exports, contract_dep_fingerprints_now(deps)))\n    (deps, exports, next_parse_count)\n  }\n}\n\n// Snapshot each contract-boundary dep's content fingerprint for the v2\n// header entry (#943 review). A dep that is not a contract boundary — or\n// whose file is not materialized — records nothing: the warm gate only\n// compares what was recorded, and a contract that APPEARS later changes\n// resolution winners, which the #801 package_index_deps_are_current gate\n// already catches.\nfn contract_dep_fingerprints_now(deps: Array[String]) -> Array[(String, String)] with { Fs } {\n  let out = array_empty()\n  let mut i = 0\n  while i < Array::length(deps) {\n    let d = Array::get(deps, i)\n    if is_contract_boundary_path(d) && Fs::exists(d) {\n      Array::push(out, (d, compact_string_fingerprint(Fs::read_file(d))))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// Warm-gate check: every recorded contract fingerprint must still match the\n// on-disk contract text. A vanished or edited contract fails the gate and\n// forces a cold re-parse + re-validation of the importer's names.\nfn contract_dep_fingerprints_current(cdeps: Array[(String, String)]) -> Bool with { Fs } {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(cdeps) {\n    let (cpath, cfp) = Array::get(cdeps, i)\n    if ok {\n      if Fs::exists(cpath) {\n        ok = compact_string_fingerprint(Fs::read_file(cpath)) == cfp\n      } else {\n        ok = false\n      }\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  ok\n}\n")
}

let cli_adapter_source_175 = () -> (String, String) {
  ("lib/@vibe/compiler/loader/manifest_sources.vibe",
"//# Imports\n\nimport ./header_cache.vibe {\n  contract_sibling_impl_raws, load_or_parse_module_header_fs_impl, merge_impl_raws_dedupe\n}\n\nimport @vibe/core {\n  array_empty\n}\n\nimport @vibe/compiler/cache {\n  compact_string_fingerprint, normalize_persistent_cache_text, persistent_manifest_header_cache_path\n}\n\nimport @vibe/compiler/core {\n  contains_path, dir_of_path, is_contract_ext, normalize_path, path_set_add, path_set_contains,\n  path_set_new, resolve_import_path_candidates\n}\n\nimport @vibe/compiler/syntax {\n  lex, Token, collect_import_path, peek, skip_semi\n}\n\nimport @vibe/compiler/contract {\n  extract_require_pins\n}\n\n//# Path helpers\n\n// #740: NORMALIZED join. Manifest rows may point outside the compiler dir\n// (\"../../lib/@vibe/core/...\"); the joined spelling must match what import\n// resolution produces (resolve_import_path normalizes), or the merge plan\n// keys the file under one spelling while importers resolve the other and\n// every cross-reference silently misses (bare `sha1 @call` in the merge).\n// #769: exported for loader_hotspot_probe's linear baseline -- it must build\n// row paths with the SAME `../` normalization the real builders apply, or the\n// manifest's `../../../lib/@vibe/...` rows never match the collected sources.\nexport fn join_path(base_dir: String, rel_path: String) -> String {\n  if base_dir == \"\" {\n    normalize_path(rel_path)\n  } else {\n    normalize_path(String::concat(base_dir, String::concat(\"/\", rel_path)))\n  }\n}\n\nfn resolve_manifest_dep_path(base_dir: String, raw_path: String, manifest_path_index: Map[String, Bool]) -> String with { Error, Fs } {\n  if String::length(raw_path) > 0 && String::char_code_at(raw_path, 0) == 64 {\n    // A `@scope/name[...]` import used to mean \"genuinely external package,\n    // not manifest-tracked\" -- returning the raw spelling unresolved was\n    // harmless since manifest_path_index/should_schedule_manifest_dep never\n    // matched it either way. Now that a compiler-internal cross-package\n    // import ALSO uses `@vibe/compiler/<sub>` (loader/header_cache.vibe's\n    // relative-import package-boundary check requires it), the raw string\n    // must actually be resolved for those -- otherwise the dependency edge\n    // to that manifest-tracked sub-package silently vanishes from the fast\n    // manifest-based collection closure. Try real resolution first; fall\n    // back to the raw spelling (old behavior) only when no candidate is\n    // manifest-tracked, i.e. it really is external.\n    let candidates = resolve_import_path_candidates(base_dir, raw_path)\n    let mut i = 0\n    let mut found = \"\"\n    while i < Array::length(candidates) {\n      if found == \"\" {\n        let candidate = Array::get(candidates, i)\n        if Map::has_key(manifest_path_index, candidate) || Fs::exists(candidate) {\n          found = candidate\n        } else ()\n      } else ()\n      i = i + 1\n    }\n    if found == \"\" {\n      raw_path\n    } else {\n      found\n    }\n  } else {\n    let candidates = resolve_import_path_candidates(base_dir, raw_path)\n    let mut i = 0\n    let mut found = \"\"\n    while i < Array::length(candidates) {\n      if found == \"\" {\n        let candidate = Array::get(candidates, i)\n        if Map::has_key(manifest_path_index, candidate) || Fs::exists(candidate) {\n          found = candidate\n        }\n      }\n      i = i + 1\n    }\n    if found == \"\" {\n      Array::get(candidates, 0)\n    } else {\n      found\n    }\n  }\n}\n\n// #1027: an `export <path> { names }` re-export's path can start with either\n// `./` (TDot, same-dir) or `../` (TDotDot, parent-dir) -- `../` lexes as a\n// SINGLE TDotDot token (see @vibe/parser's lexer.vibe / token.vibe / CLAUDE.md\n// \"62-bit tagged\" section notwithstanding, this is a lexer-level fact:\n// `collect_import_path` in @vibe/parser/parser_base.vibe treats TDot and\n// TDotDot as two distinct path-continuation tokens), NOT a repeated TDot.\n// Checking only TDot here silently treated any `export ../../foo { .. }`\n// statement in a manifest-tracked file (this is the fast hand-rolled scanner\n// used for files listed in compiler_sources_manifest.tsv, NOT the full\n// AST-based collect_import_deps_from_stmts in header_cache.vibe, which\n// already matches SReExport structurally and was unaffected) as a BARE\n// re-export of previously-imported names (no path, no dependency edge) --\n// every `../`-rooted export dependency was silently dropped from the\n// header-based transitive walk (collect_needed_paths_and_manifest_headers /\n// try_collect_manifest_sources_fs / collect_all_sources_fs). Every existing\n// facade in this tree happened to reexport via `./` only, so the gap was\n// latent until lib/@vibe/compiler/syntax/*.vibe (#897 batch 5) became the\n// first manifest-tracked files whose ENTIRE content is a single\n// `export ../../../../lib/@vibe/parser { .. }` statement -- collect_all_sources_fs\n// then silently dropped lib/@vibe/parser/index.vpkg (and everything only\n// reachable through it) from the compiler's own source closure.\nfn starts_with_reexport_path_token(tok: Token) -> Bool {\n  match tok {\n    TDot => true,\n    TDotDot => true,\n    _ => false\n  }\n}\n\nfn is_ident_char(c: Int) -> Bool {\n  (c >= 'a' && c <= 'z') ||\n    (c >= 'A' && c <= 'Z') ||\n    (c >= '0' && c <= '9') ||\n    c == '_'\n}\n\nfn slice_eq_text(s: String, start: Int, text: String) -> Bool {\n  let text_len = String::length(text)\n  if start + text_len > String::length(s) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while ok && i < text_len {\n      ok = String::char_code_at(s, start + i) == String::char_code_at(text, i)\n      i = i + 1\n    }\n    ok\n  }\n}\n\nfn starts_with_keyword_at(s: String, pos: Int, keyword: String) -> Bool {\n  let keyword_len = String::length(keyword)\n  if !(slice_eq_text(s, pos, keyword)) {\n    false\n  } else {\n    let before_ok = if pos == 0 {\n      true\n    } else {\n      !(is_ident_char(String::char_code_at(s, pos - 1)))\n    }\n    let after_pos = pos + keyword_len\n    let after_ok = if after_pos >= String::length(s) {\n      true\n    } else {\n      !(is_ident_char(String::char_code_at(s, after_pos)))\n    }\n    before_ok && after_ok\n  }\n}\n\nfn skip_header_ws_and_comments(s: String, len: Int, start: Int) -> Int {\n  let mut pos = start\n  let mut done = false\n  while !done && pos < len {\n    let c = String::char_code_at(s, pos)\n    if c == ' ' || c == '\\n' || c == '\\t' || c == '\\r' || c == ';' {\n      pos = pos + 1\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\n      pos = pos + 2\n      while pos < len && String::char_code_at(s, pos) != '\\n' {\n        pos = pos + 1\n      }\n    } else {\n      done = true\n    }\n  }\n  pos\n}\n\nfn scan_header_stmt_end(s: String, len: Int, start: Int) -> Int with { Error } {\n  let mut pos = start\n  let mut brace_depth = 0\n  let mut in_string = false\n  let mut string_quote = 0\n  let mut escape = false\n  let mut done = false\n  while pos < len && !done {\n    let c = String::char_code_at(s, pos)\n    if in_string {\n      if escape {\n        escape = false\n      } else if c == '\\\\' {\n        escape = true\n      } else if c == string_quote {\n        in_string = false\n      }\n      pos = pos + 1\n    } else if c == '\"' || c == '\\'' {\n      in_string = true\n      string_quote = c\n      pos = pos + 1\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\n      while pos < len && String::char_code_at(s, pos) != '\\n' {\n        pos = pos + 1\n      }\n    } else if c == '{' {\n      brace_depth = brace_depth + 1\n      pos = pos + 1\n    } else if c == '}' {\n      if brace_depth > 0 {\n        brace_depth = brace_depth - 1\n      }\n      pos = pos + 1\n    } else if brace_depth == 0 && (c == '\\n' || c == ';') {\n      done = true\n    } else {\n      pos = pos + 1\n    }\n  }\n  pos\n}\n\nfn skip_brace_list(tokens: Array[Token], pos: Int) -> Int with { Error } {\n  match peek(tokens, pos) {\n    TLBrace => {\n      let mut depth = 1\n      let mut i = pos + 1\n      while depth > 0 {\n        match peek(tokens, i) {\n          TLBrace => {\n            depth = depth + 1\n          },\n          TRBrace => {\n            depth = depth - 1\n          },\n          TEof => throw(\"unterminated brace list in manifest import scanner\"),\n          _ => ()\n        }\n        i = i + 1\n      }\n      i\n    }\n    _ => throw(\"expected '{' in manifest import scanner\")\n  }\n}\n\nfn scan_header_import_dep(tokens: Array[Token], pos: Int, base_dir: String, manifest_path_index: Map[String, Bool]) -> (String, Int) with { Error, Fs } {\n  let (raw_path, next_pos) = match peek(tokens, pos) {\n    TIdent(name) =>\n      if String::length(name) > 1 && String::char_code_at(name, 0) == 64 {\n        (name, pos + 1)\n      } else {\n        collect_import_path(tokens, pos, \"\")\n      },\n    _ => collect_import_path(tokens, pos, \"\")\n  }\n  let after_path = match peek(tokens, next_pos) {\n    TIdent(alias_name) =>\n      if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == 64 {\n        next_pos + 1\n      } else {\n        next_pos\n      },\n    _ => next_pos\n  }\n  let end_pos = match peek(tokens, after_path) {\n    TLBrace => skip_brace_list(tokens, after_path),\n    _ => after_path\n  }\n  (resolve_manifest_dep_path(base_dir, raw_path, manifest_path_index), end_pos)\n}\n\n// #1027: this scanner's main loop stops at the first top-level statement\n// that isn't `import`/`export` (a deliberate fast-path exploiting the\n// codebase convention that every file's imports come first -- see the\n// `done = true` fallthrough below). A `.vpkg` contract's grammar puts a\n// `version x.y.z` directive (and optional `require ...` pin lines) BEFORE\n// its `import ./x.vibe {}` lines, so scanning a contract file's RAW text\n// hit that fallthrough on line 1 and returned zero deps for EVERY\n// vpkg-ified directory (external package boundaries AND #897 compiler-\n// internal ones alike) -- this is the root cause of #1027's own title\n// (\"collect_all_sources_fs undercounts vpkg-ified internal directories\"):\n// the walk correctly resolves an import/export edge down to the target\n// `.vpkg` row (that part was always fine), but then found NO further\n// dependencies when it visited that row itself, so a directory's own impl\n// files never got scheduled. `extract_require_pins` (contract/contract.vibe)\n// already knows how to blank exactly this leading directive region (line-\n// based, tolerates comments/blank lines, stops at the first ordinary\n// statement) -- reuse it here instead of re-deriving the same rule, so the\n// import/export scan below sees the blanked (all-whitespace) directive\n// lines and continues straight through to the real import statements.\nfn manifest_header_scan_source(path: String, source: String) -> String with { Error } {\n  if is_contract_ext(path) {\n    let (_, blanked) = extract_require_pins(source)\n    blanked\n  } else {\n    source\n  }\n}\n\nfn collect_manifest_header_deps_from_source(path: String, raw_source: String, manifest_path_index: Map[String, Bool]) -> Array[String] with { Error, Fs } {\n  let deps = array_empty()\n  let base_dir = dir_of_path(path)\n  let source = manifest_header_scan_source(path, raw_source)\n  let len = String::length(source)\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    pos = skip_header_ws_and_comments(source, len, pos)\n    if pos >= len {\n      done = true\n    } else {\n      let is_import = starts_with_keyword_at(source, pos, \"import\")\n      let is_export = starts_with_keyword_at(source, pos, \"export\")\n      if !(is_import || is_export) {\n        done = true\n      } else {\n        let stmt_end = scan_header_stmt_end(source, len, pos)\n        let stmt_source = source[pos:stmt_end]\n        let tokens = lex(stmt_source)\n        let stmt_pos = skip_semi(tokens, 0)\n        match peek(tokens, stmt_pos) {\n          TImport => {\n            let (dep_path, _) = scan_header_import_dep(\n              tokens,\n              stmt_pos + 1,\n              base_dir,\n              manifest_path_index\n            )\n            Array::push(deps, dep_path)\n          },\n          TExport => {\n            if starts_with_reexport_path_token(peek(tokens, stmt_pos + 1)) {\n              let (dep_path, _) = scan_header_import_dep(\n                tokens,\n                stmt_pos + 1,\n                base_dir,\n                manifest_path_index\n              )\n              Array::push(deps, dep_path)\n            }\n          },\n          _ => {\n            done = true\n          }\n        }\n        pos = stmt_end\n      }\n    }\n  }\n  // Mirror the full loader's unconditional `.vpkg` sibling auto-discovery\n  // (ADR-0070 Phase 1): this fast textual scanner only sees deps the\n  // contract's OWN `import ./x.vibe {}` lines spell out explicitly, so a\n  // `.vpkg` that relies on (now-legitimate) undeclared siblings silently\n  // dropped them from the manifest-preferring FS collection closure --\n  // same class of gap as #1027, just for auto-discovered rather than\n  // version-directive-blocked deps.\n  if String::ends_with(path, \".vpkg\") {\n    let discovered_raws = contract_sibling_impl_raws(base_dir)\n    let mut di = 0\n    let discovered_deps = array_empty()\n    while di < Array::length(discovered_raws) {\n      Array::push(discovered_deps, resolve_manifest_dep_path(base_dir, Array::get(discovered_raws, di), manifest_path_index))\n      di = di + 1\n    }\n    merge_impl_raws_dedupe(deps, discovered_deps)\n  } else {\n    deps\n  }\n}\n\nfn collect_manifest_header_deps_from_source_with_context(path: String, source: String, manifest_path_index: Map[String, Bool]) -> Array[String] with { Error, Fs } {\n  handle {\n    collect_manifest_header_deps_from_source(path, source, manifest_path_index)\n  } with Error {\n    Throw(err) => throw(\"manifest header scan failed for \" + path + \": \" + err)\n  }\n}\n\nfn is_manifest_external_terminal_dep(path: String) -> Bool {\n  String::ends_with(path, \"compiler_sources_bundle.vibe\")\n}\n\nfn should_schedule_manifest_dep(dep_path: String, manifest_path_index: Map[String, Bool]) -> Bool {\n  if Map::has_key(manifest_path_index, dep_path) {\n    true\n  } else {\n    !(is_manifest_external_terminal_dep(dep_path))\n  }\n}\n\nfn load_or_parse_module_header_deps_with_context(path: String, source: String) -> Array[String] with { Error, Fs } {\n  handle {\n    let (deps, _, _) = load_or_parse_module_header_fs_impl(path, source, 0)\n    deps\n  } with Error {\n    Throw(err) => throw(\"module header parse failed for \" + path + \": \" + err)\n  }\n}\n\nexport fn build_manifest_source_index(sources: Array[(String, String)]) -> Map[String, String] {\n  let builder = MapBuilder::new()\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    MapBuilder::set(builder, path, source)\n    i = i + 1\n  }\n  MapBuilder::freeze(builder)\n}\n\nfn source_lookup_in_index(source_index: Map[String, String], path_key: String) -> Option[String] {\n  if Map::has_key(source_index, path_key) {\n    Some(Map::get(source_index, path_key))\n  } else {\n    None\n  }\n}\n\nexport fn build_manifest_path_index(paths: Array[String]) -> Map[String, Bool] {\n  let builder = MapBuilder::new()\n  let mut i = 0\n  while i < Array::length(paths) {\n    MapBuilder::set(builder, Array::get(paths, i), true)\n    i = i + 1\n  }\n  MapBuilder::freeze(builder)\n}\n\nfn empty_path_index() -> Map[String, Bool] {\n  let builder = MapBuilder::new()\n  MapBuilder::freeze(builder)\n}\n\nfn build_manifest_path_index_from_rows(base_dir: String, rows: Array[(String, String)]) -> Map[String, Bool] {\n  let builder = MapBuilder::new()\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    MapBuilder::set(builder, join_path(base_dir, rel_path), true)\n    i = i + 1\n  }\n  MapBuilder::freeze(builder)\n}\n\nfn find_manifest_base_dir(entry_path: String) -> Option[String] with { Fs } {\n  let mut base_dir = dir_of_path(entry_path)\n  let mut found = None\n  let mut done = false\n  loop {\n    if done {\n      break\n    }\n    let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n    if Fs::exists(manifest_path) {\n      found = Some(base_dir)\n      done = true\n    } else if base_dir == \"\" {\n      done = true\n    } else {\n      let parent = dir_of_path(base_dir)\n      if parent == base_dir {\n        done = true\n      } else {\n        base_dir = parent\n      }\n    }\n  }\n  found\n}\n\nfn strip_trailing_cr(line: String) -> String {\n  let len = String::length(line)\n  if len > 0 {\n    if String::char_code_at(line, len - 1) == 13 {\n      line[0:len - 1]\n    } else {\n      line\n    }\n  } else {\n    line\n  }\n}\n\nfn find_char(s: String, target: Int) -> Int {\n  let len = String::length(s)\n  let mut i = 0\n  let mut result = -1\n  while i < len {\n    if String::char_code_at(s, i) == target {\n      result = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nfn split_tsv_fields(line: String) -> Array[String] {\n  let fields = array_empty()\n  let len = String::length(line)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_field_end = if i == len {\n      true\n    } else {\n      String::char_code_at(line, i) == 9\n    }\n    if at_field_end {\n      Array::push(fields, line[start:i])\n      start = i + 1\n    }\n    i = i + 1\n  }\n  fields\n}\n\nlet header_value_separator = String::from_char_code(31)\n\nfn join_header_values(values: Array[String]) -> String {\n  // O(N) join via StringBuilder; per-value String::concat was O(N²) (issue #366).\n  let out = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(values) {\n    if i > 0 {\n      StringBuilder::push(out, header_value_separator)\n    }\n    StringBuilder::push(out, Array::get(values, i))\n    i = i + 1\n  }\n  StringBuilder::freeze(out)\n}\n\nfn split_header_values(text: String) -> Array[String] {\n  let values = array_empty()\n  if String::length(text) == 0 {\n    values\n  } else {\n    let sep = String::char_code_at(header_value_separator, 0)\n    let len = String::length(text)\n    let mut start = 0\n    let mut i = 0\n    while i <= len {\n      let at_value_end = if i == len {\n        true\n      } else {\n        String::char_code_at(text, i) == sep\n      }\n      if at_value_end {\n        Array::push(values, text[start:i])\n        start = i + 1\n      }\n      i = i + 1\n    }\n    values\n  }\n}\n\nfn empty_manifest_header_cache_rows() -> Array[(String, String, String, String)] {\n  array_empty()\n}\n\nfn empty_grouped_sources() -> Array[(String, Array[(String, String)])] {\n  array_empty()\n}\n\n// #801 (系統2 follow-up): a bucket that does not exist yet MUST have its first\n// element pushed BEFORE the (group_name, bucket) tuple is embedded into\n// `groups` -- never the other way around. Pushing an EMPTY bucket into\n// `groups` first and mutating the returned handle afterward (the previous\n// shape of this function) let a `groups`-array growth event land between the\n// two pushes; the bucket handle the caller went on to push the first real\n// element into was then observed to diverge from the copy embedded in\n// `groups`, leaving a corrupted `path=\"0\"` row behind (reproduced\n// deterministically for entry \"lib/@vibe/compiler/loader/index.vibe\": the\n// 11th distinct group, \"vibe_core\", landed exactly on this hazard while\n// every other group -- multi-row groups whose bucket is already \"live\" by\n// the time any subsequent `groups` growth happens, and single-row groups\n// created before the hazard's growth boundary -- did not). The already-safe\n// sibling `push_grouped_source` (loader/index.vibe) avoids this by always\n// populating a brand-new bucket with its first item BEFORE pushing the tuple\n// into the outer array; this seeded variant applies the same ordering here.\nfn ensure_grouped_source_bucket_seeded(groups: Array[(String, Array[(String, String)])], group_name: String, path: String, value: String) -> Array[(String, String)] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(groups) {\n    let (name, sources) = Array::get(groups, i)\n    if name == group_name {\n      found = Some(sources)\n      i = Array::length(groups)\n    } else {\n      i = i + 1\n    }\n  }\n  match found {\n    Some(sources) => {\n      Array::push(sources, (path, value))\n      sources\n    },\n    None => {\n      let sources = array_empty()\n      Array::push(sources, (path, value))\n      Array::push(groups, (group_name, sources))\n      sources\n    }\n  }\n}\n\nfn build_grouped_sources_from_manifest_rows_with_lookup(base_dir: String, rows: Array[(String, String)], on_path: (String) -> Option[String]) -> Array[(String, Array[(String, String)])] {\n  let groups = empty_grouped_sources()\n  let mut last_group_name = \"\"\n  let mut last_group_sources = array_empty()\n  let mut has_last_group = false\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (group_name, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    match on_path(path) {\n      Some(source) => {\n        if has_last_group && last_group_name == group_name {\n          Array::push(last_group_sources, (path, source))\n        } else {\n          let ensured = ensure_grouped_source_bucket_seeded(groups, group_name, path, source)\n          last_group_name = group_name\n          last_group_sources = ensured\n          has_last_group = true\n        }\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  groups\n}\n\n//# Manifest parsing\n\nfn parse_source_manifest_rows(manifest_source: String) -> Array[(String, String)] with { Error } {\n  let rows = array_empty()\n  let len = String::length(manifest_source)\n  let mut line_start = 0\n  let mut i = 0\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(manifest_source, i) == 10\n    }\n    if at_line_end {\n      let raw_line = strip_trailing_cr(manifest_source[line_start:i])\n      let line_len = String::length(raw_line)\n      let has_content = line_len > 0\n      let is_comment = if has_content {\n        String::char_code_at(raw_line, 0) == 35\n      } else {\n        false\n      }\n      if has_content {\n        if is_comment {\n          ()\n        } else {\n          let tab_idx = find_char(raw_line, 9)\n          let invalid_row = if tab_idx < 0 {\n            true\n          } else {\n            tab_idx + 1 >= line_len\n          }\n          if invalid_row {\n            throw(String::concat(\"invalid source manifest row: \", raw_line))\n          }\n          let group = raw_line[0:tab_idx]\n          let path = raw_line[tab_idx + 1:line_len]\n          Array::push(rows, (group, path))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  rows\n}\n\nexport fn try_load_manifest_rows(entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs } {\n  match find_manifest_base_dir(entry_path) {\n    Some(base_dir) => {\n      let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n      let rows = parse_source_manifest_rows(Fs::read_file(manifest_path))\n      let mut has_entry = false\n      let mut i = 0\n      while i < Array::length(rows) {\n        let (_, rel_path) = Array::get(rows, i)\n        let path = join_path(base_dir, rel_path)\n        if path == entry_path {\n          has_entry = true\n        }\n        i = i + 1\n      }\n      if has_entry {\n        Some((base_dir, rows))\n      } else {\n        None\n      }\n    },\n    None => None\n  }\n}\n\nexport fn load_manifest_full_sources(base_dir: String, rows: Array[(String, String)]) -> Array[(String, String)] with { Error, Fs } {\n  let full_sources = array_empty()\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    Array::push(full_sources, (path, Fs::read_file(path)))\n    i = i + 1\n  }\n  full_sources\n}\n\nfn load_manifest_sources_by_path_index(base_dir: String, rows: Array[(String, String)], needed_path_index: Map[String, Bool]) -> Array[(String, String)] with { Error, Fs } {\n  let sources = array_empty()\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    if Map::has_key(needed_path_index, path) {\n      Array::push(sources, (path, Fs::read_file(path)))\n    }\n    i = i + 1\n  }\n  sources\n}\n\nfn load_manifest_source_groups_by_path_index(base_dir: String, rows: Array[(String, String)], needed_path_index: Map[String, Bool]) -> Array[(String, Array[(String, String)])] with { Error, Fs } {\n  let groups = empty_grouped_sources()\n  let mut last_group_name = \"\"\n  let mut last_group_sources = array_empty()\n  let mut has_last_group = false\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (group_name, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    if Map::has_key(needed_path_index, path) {\n      if has_last_group && last_group_name == group_name {\n        Array::push(last_group_sources, (path, Fs::read_file(path)))\n      } else {\n        let ensured = ensure_grouped_source_bucket_seeded(groups, group_name, path, Fs::read_file(path))\n        last_group_name = group_name\n        last_group_sources = ensured\n        has_last_group = true\n      }\n    }\n    i = i + 1\n  }\n  groups\n}\n\nexport fn build_grouped_sources_from_manifest_row_source_index(base_dir: String, rows: Array[(String, String)], source_index: Map[String, String]) -> Array[(String, Array[(String, String)])] {\n  build_grouped_sources_from_manifest_rows_with_lookup(\n    base_dir,\n    rows,\n    (path: String) -> Option[String] {\n      source_lookup_in_index(source_index, path)\n    }\n  )\n}\n\nexport fn build_grouped_sources_from_manifest_rows(base_dir: String, rows: Array[(String, String)], sources: Array[(String, String)]) -> Array[(String, Array[(String, String)])] {\n  let source_index = build_manifest_source_index(sources)\n  build_grouped_sources_from_manifest_row_source_index(base_dir, rows, source_index)\n}\n\nexport fn filter_manifest_sources_by_path_index(preloaded_sources: Array[(String, String)], needed_path_index: Map[String, Bool]) -> Array[(String, String)] {\n  let filtered_sources = array_empty()\n  let mut i = 0\n  while i < Array::length(preloaded_sources) {\n    let (path, source) = Array::get(preloaded_sources, i)\n    if Map::has_key(needed_path_index, path) {\n      Array::push(filtered_sources, (path, source))\n    }\n    i = i + 1\n  }\n  filtered_sources\n}\n\nexport fn filter_manifest_sources_by_paths(preloaded_sources: Array[(String, String)], needed_paths: Array[String]) -> Array[(String, String)] {\n  let needed_path_index = build_manifest_path_index(needed_paths)\n  filter_manifest_sources_by_path_index(preloaded_sources, needed_path_index)\n}\n\nexport fn filter_manifest_sources_by_paths_linear(preloaded_sources: Array[(String, String)], needed_paths: Array[String]) -> Array[(String, String)] {\n  let filtered_sources = array_empty()\n  let mut i = 0\n  while i < Array::length(preloaded_sources) {\n    let (path, source) = Array::get(preloaded_sources, i)\n    if contains_path(needed_paths, path) {\n      Array::push(filtered_sources, (path, source))\n    }\n    i = i + 1\n  }\n  filtered_sources\n}\n\nexport fn filter_manifest_sources_by_source_index(needed_paths: Array[String], preloaded_source_index: Map[String, String]) -> Array[(String, String)] {\n  let filtered_sources = array_empty()\n  let mut i = 0\n  while i < Array::length(needed_paths) {\n    let path = Array::get(needed_paths, i)\n    match source_lookup_in_index(preloaded_source_index, path) {\n      Some(source) => Array::push(filtered_sources, (path, source)),\n      None => ()\n    }\n    i = i + 1\n  }\n  filtered_sources\n}\n\n//# Manifest header cache\n\nfn parse_persistent_manifest_header_cache(raw: String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let rows = empty_manifest_header_cache_rows()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent manifest header cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else {\n            throw(\"invalid persistent manifest header cache version\")\n          }\n        } else if tag == \"manifest\" {\n          if Array::length(fields) != 4 {\n            throw(\"invalid persistent manifest header cache manifest row\")\n          }\n          manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n        } else if tag == \"header\" {\n          if version == 1 {\n            if Array::length(fields) != 6 {\n              throw(\"invalid persistent manifest header cache header row\")\n            }\n            Array::push(\n              rows,\n              (\n                Array::get(fields, 1),\n                Array::get(fields, 2),\n                Array::get(fields, 3),\n                Array::get(fields, 4)\n              )\n            )\n          } else {\n            if Array::length(fields) != 5 {\n              throw(\"invalid persistent manifest header cache header row\")\n            }\n            Array::push(\n              rows,\n              (\n                Array::get(fields, 1),\n                Array::get(fields, 2),\n                Array::get(fields, 3),\n                Array::get(fields, 4)\n              )\n            )\n          }\n        } else {\n          throw(String::concat(\"invalid persistent manifest header cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, rows)\n}\n\nfn matches_cached_file_spec(path: String, stat_token_text: String, source_fingerprint: String) -> Bool with { Error, Fs } {\n  if !(Fs::exists(path)) {\n    false\n  } else {\n    let has_stat_token = String::length(stat_token_text) > 0\n    if has_stat_token {\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\n        true\n      } else if String::length(source_fingerprint) > 0 {\n        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n      } else {\n        false\n      }\n    } else if String::length(source_fingerprint) > 0 {\n      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n    } else {\n      false\n    }\n  }\n}\n\nfn load_persistent_manifest_header_cache_if_valid(entry_path: String, manifest_path: String, manifest_path_index: Map[String, Bool]) -> Option[Array[(String, String, String, String)]] with { Error, Fs } {\n  let cache_path = persistent_manifest_header_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_manifest_header_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    let manifest_ok = match manifest {\n      Some((cached_path, stat_token_text, source_fingerprint)) =>\n        cached_path == manifest_path &&\n          matches_cached_file_spec(manifest_path, stat_token_text, source_fingerprint),\n      None => false\n    }\n    if !manifest_ok {\n      None\n    } else {\n      let mut valid = true\n      let mut i = 0\n      while i < Array::length(rows) {\n        if valid {\n          let (path, stat_token_text, source_fingerprint, _) = Array::get(rows, i)\n          if !(Map::has_key(manifest_path_index, path)) {\n            valid = false\n          } else if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {\n            valid = false\n          }\n        }\n        i = i + 1\n      }\n      if valid {\n        Some(rows)\n      } else {\n        None\n      }\n    }\n  }\n}\n\nfn build_persistent_manifest_header_cache_text(manifest_path: String, rows: Array[(String, String, String, String)]) -> String with { Error, Fs } {\n  let mut out = \"version\\t2\\n\"\n  out = String::concat(\n    out,\n    String::concat(\n      \"manifest\\t\",\n      String::concat(\n        manifest_path,\n        String::concat(\n          \"\\t\",\n          String::concat(\n            __to_string(Fs::stat_token(manifest_path)),\n            String::concat(\"\\t\", String::concat(compact_string_fingerprint(Fs::read_file(manifest_path)), \"\\n\"))\n          )\n        )\n      )\n    )\n  )\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (path, stat_token_text, source_fingerprint, deps_text) = Array::get(rows, i)\n    out = String::concat(\n      out,\n      String::concat(\n        \"header\\t\",\n        String::concat(\n          path,\n          String::concat(\n            \"\\t\",\n            String::concat(\n              stat_token_text,\n              String::concat(\n                \"\\t\",\n                String::concat(\n                  source_fingerprint,\n                  String::concat(\"\\t\", String::concat(deps_text, \"\\n\"))\n                )\n              )\n            )\n          )\n        )\n      )\n    )\n    i = i + 1\n  }\n  out\n}\n\nfn store_persistent_manifest_header_cache(entry_path: String, manifest_path: String, rows: Array[(String, String, String, String)]) -> Unit with { Error, Fs } {\n  Fs::write_file(\n    persistent_manifest_header_cache_path(entry_path),\n    build_persistent_manifest_header_cache_text(manifest_path, rows)\n  )\n}\n\nfn manifest_header_deps_lookup(rows: Array[(String, String, String, String)], path: String) -> Option[Array[String]] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(rows) {\n    let (row_path, _, _, deps_text) = Array::get(rows, i)\n    if row_path == path {\n      found = Some(split_header_values(deps_text))\n      i = Array::length(rows)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// #533: schedule-time dedup via a mutable `path_set`. The previous\n// `Map[String, Bool]` scheduled-set copied the whole map on every\n// `Map::set` (O(N) per insert → O(N²) total) and linearly scanned it per\n// `Map::has_key`; the pop-time `contains_path(visited, current)` guard\n// was another O(edges × modules) scan that could never fire, because\n// every worklist push is gated on the scheduled set, making worklist\n// entries unique by construction. `visited` stays an insertion-ordered\n// array — it is the returned needed-paths list. (Same pattern in the two\n// sibling collectors below.)\nfn collect_needed_paths_from_manifest_headers(path: String, manifest_path_index: Map[String, Bool], rows: Array[(String, String, String, String)]) -> Array[String] with { Error, Fs } {\n  let visited = array_empty()\n  let worklist = array_empty()\n  let scheduled = path_set_new()\n  Array::push(worklist, path)\n  path_set_add(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    Array::push(visited, current)\n    let deps = match manifest_header_deps_lookup(rows, current) {\n      Some(found) => found,\n      None => {\n        let source = Fs::read_file(current)\n        if Map::has_key(manifest_path_index, current) {\n          collect_manifest_header_deps_from_source_with_context(\n            current,\n            source,\n            manifest_path_index\n          )\n        } else {\n          load_or_parse_module_header_deps_with_context(current, source)\n        }\n      }\n    }\n    let mut dep_i = 0\n    while dep_i < Array::length(deps) {\n      let dep_path = Array::get(deps, dep_i)\n      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\n        !(path_set_contains(scheduled, dep_path)) {\n        Array::push(worklist, dep_path)\n        path_set_add(scheduled, dep_path)\n        work_len = work_len + 1\n      }\n      dep_i = dep_i + 1\n    }\n    work_i = work_i + 1\n  }\n  visited\n}\n\nfn collect_needed_paths_and_manifest_headers(path: String, manifest_path_index: Map[String, Bool]) -> (Array[(String, String, String, String)], Array[String]) with { Error, Fs } {\n  let rows = empty_manifest_header_cache_rows()\n  let visited = array_empty()\n  let worklist = array_empty()\n  let scheduled = path_set_new()\n  Array::push(worklist, path)\n  path_set_add(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    Array::push(visited, current)\n    let source = Fs::read_file(current)\n    let deps = match manifest_header_deps_lookup(rows, current) {\n      Some(found) => found,\n      None => {\n        let parsed_deps = if Map::has_key(manifest_path_index, current) {\n          collect_manifest_header_deps_from_source_with_context(\n            current,\n            source,\n            manifest_path_index\n          )\n        } else {\n          load_or_parse_module_header_deps_with_context(current, source)\n        }\n        Array::push(\n          rows,\n          (\n            current,\n            __to_string(Fs::stat_token(current)),\n            compact_string_fingerprint(source),\n            join_header_values(parsed_deps)\n          )\n        )\n        parsed_deps\n      }\n    }\n    let mut dep_i = 0\n    while dep_i < Array::length(deps) {\n      let dep_path = Array::get(deps, dep_i)\n      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\n        !(path_set_contains(scheduled, dep_path)) {\n        Array::push(worklist, dep_path)\n        path_set_add(scheduled, dep_path)\n        work_len = work_len + 1\n      }\n      dep_i = dep_i + 1\n    }\n    work_i = work_i + 1\n  }\n  (rows, visited)\n}\n\nfn collect_needed_paths_from_manifest_scan(path: String, manifest_path_index: Map[String, Bool]) -> Array[String] with { Error, Fs } {\n  let visited = array_empty()\n  let worklist = array_empty()\n  let scheduled = path_set_new()\n  Array::push(worklist, path)\n  path_set_add(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    Array::push(visited, current)\n    let source = Fs::read_file(current)\n    let deps = if Map::has_key(manifest_path_index, current) {\n      collect_manifest_header_deps_from_source_with_context(\n        current,\n        source,\n        manifest_path_index\n      )\n    } else {\n      load_or_parse_module_header_deps_with_context(current, source)\n    }\n    let mut dep_i = 0\n    while dep_i < Array::length(deps) {\n      let dep_path = Array::get(deps, dep_i)\n      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\n        !(path_set_contains(scheduled, dep_path)) {\n        Array::push(worklist, dep_path)\n        path_set_add(scheduled, dep_path)\n        work_len = work_len + 1\n      }\n      dep_i = dep_i + 1\n    }\n    work_i = work_i + 1\n  }\n  visited\n}\n\nfn load_or_collect_manifest_header_rows(entry_path: String, manifest_path: String, manifest_path_index: Map[String, Bool]) -> Array[(String, String, String, String)] with { Error, Fs } {\n  match load_persistent_manifest_header_cache_if_valid(\n    entry_path,\n    manifest_path,\n    manifest_path_index\n  ) {\n    Some(cached_rows) => cached_rows,\n    None => {\n      let (built_rows, _) = collect_needed_paths_and_manifest_headers(\n        entry_path,\n        manifest_path_index\n      )\n      store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)\n      built_rows\n    }\n  }\n}\n\nexport fn probe_manifest_header_rows_count(entry_path: String) -> Int with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      Array::length(header_rows)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\nexport fn probe_manifest_header_rows_uncached_count(entry_path: String) -> Int with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let (header_rows, _) = collect_needed_paths_and_manifest_headers(\n        entry_path,\n        manifest_path_index\n      )\n      Array::length(header_rows)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\nexport fn probe_manifest_needed_paths_count(entry_path: String) -> Int with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      let needed_paths = collect_needed_paths_from_manifest_headers(\n        entry_path,\n        manifest_path_index,\n        header_rows\n      )\n      Array::length(needed_paths)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\nexport fn probe_manifest_scan_paths_count(entry_path: String) -> Int with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let needed_paths = collect_needed_paths_from_manifest_scan(\n        entry_path,\n        manifest_path_index\n      )\n      Array::length(needed_paths)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\n//# Source collection\n\nexport fn try_collect_manifest_sources_fs(entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      let needed_paths = collect_needed_paths_from_manifest_headers(\n        entry_path,\n        manifest_path_index,\n        header_rows\n      )\n      let needed_path_index = build_manifest_path_index(needed_paths)\n      let sources = load_manifest_sources_by_path_index(base_dir, rows, needed_path_index)\n      Some((manifest_path, sources))\n    },\n    None => None\n  }\n}\n\nexport fn try_collect_manifest_source_groups_fs(entry_path: String) -> Option[(String, Array[(String, Array[(String, String)])])] with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"compiler_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      let needed_paths = collect_needed_paths_from_manifest_headers(\n        entry_path,\n        manifest_path_index,\n        header_rows\n      )\n      let needed_path_index = build_manifest_path_index(needed_paths)\n      let groups = load_manifest_source_groups_by_path_index(base_dir, rows, needed_path_index)\n      Some((manifest_path, groups))\n    },\n    None => None\n  }\n}\n")
}

let cli_adapter_source_176 = () -> (String, String) {
  ("lib/@vibe/cache/index.vpkg",
"version 0.0.1\n\n// @vibe/cache — content-addressed persistent build/artifact cache path\n// derivation + fingerprinting, and the module-header text codec (ADR-0070\n// Phase 3, #897). No opaque/transparent types: every declared name is a\n// pure fn over String/Bytes/Array/tuple primitives, never a struct/enum.\n// `version` was `export let version = \"0.0.1\"` directly in the old\n// index.vibe facade -- a real importable binding, not just contract\n// metadata -- so it is preserved verbatim as an implementation-file value\n// (cache.vibe) with a matching bodyless declaration here (Codex review\n// precedent, PR #914).\n\n// --- cache\nfn compact_string_fingerprint(source: String) -> String\nfn stable_cache_path(version_tag: String, prefix: String, seed: String, suffix: String) -> String\nfn persistent_artifact_cache_path(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> String\nfn store_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs }\nfn persistent_dep_list_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String\nfn persistent_type_env_cache_path(version_tag: String, fingerprint: String) -> String\nfn build_source_groups_fingerprint(groups: Array[(String, Array[(String, String)])]) -> String\nfn normalize_persistent_cache_text(text: String) -> String\nfn load_persistent_artifact(version_tag: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs }\nfn persistent_source_list_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String\nfn persistent_source_group_cache_path(version_tag: String, entry_path: String, resolution_seed: String) -> String\nfn persistent_module_header_cache_path(version_tag: String, path: String, source_fingerprint: String, resolution_seed: String) -> String\nfn persistent_manifest_header_cache_path(version_tag: String, entry_path: String) -> String\nfn persistent_leaf_fingerprint_cache_path(version_tag: String, path: String, source_fingerprint: String) -> String\nfn build_source_groups_fingerprint_from_compact_fingerprints(groups: Array[(String, Array[(String, String)])]) -> String\nfn build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String) -> String\nfn build_fs_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> String\nfn build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String, entry_name: String, mode: String) -> String\nfn build_file_compile_wasi_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])], entry_name: String, mode: String) -> String\nfn build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String\nfn build_fs_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String\nfn build_file_compile_module_artifact_fingerprint_from_group_fingerprint(source_groups_fingerprint: String) -> String\nfn build_file_compile_module_artifact_fingerprint(source_groups: Array[(String, Array[(String, String)])]) -> String\n\n// --- header_codec\nfn persistent_module_header_text(deps: Array[String], exports: Array[String], contract_fps: Array[(String, String)]) -> String\nfn parse_persistent_module_header_text(raw: String) -> (Array[String], Array[String], Array[(String, String)], Bool) with { Error }\n")
