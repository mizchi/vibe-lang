"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_str_ref,\n  expr_tag,\n  get_arm_body,\n  get_arm_pat,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  is_efn,\n  is_eident,\n  is_etuple,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  lookup_ctor,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_ereturn_expr,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\nimport ./compile_call.vibe {\n  compile_call\n}\n\nimport ./compile_expr_tail4.vibe {\n  compile_expr_tail4\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\nexport fn compile_expr_tail3(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let __tag = expr_tag(expr)\n  if __tag == 19 {\n    let cond = get_ewhile_cond(expr)\n    let body = get_ewhile_body(expr)\n    // #706: the locals live at the loop header are loop-borrowed — a consume of\n    // one inside the cond/body re-executes each iteration and must dup so the\n    // value survives the back-edge. Record them (RC only); restore after. Names\n    // declared inside the body are appended past lb_base and removed by truncate.\n    let lb_base = Array::length(ctx.loop_borrowed_names)\n    if ctx.enable_rc {\n      let mut lbi = 0\n      while lbi < Array::length(local_names) {\n        Array::push(ctx.loop_borrowed_names, Array::get(local_names, lbi))\n        lbi = lbi + 1\n      }\n    } else {\n      ()\n    }\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    // ld measures wasm blocks between the current position and the INNERMOST\n    // loop header (EBreak emits `br ld+1`, EContinue `br ld`). A new loop\n    // RESETS that distance to 0 — the previous `ld + 1` only converted the\n    // top-level -1 correctly; for a while nested in another loop it kept\n    // counting from the OUTER loop, so an inner `break` jumped to the outer\n    // loop header (observed as an infinite insertion sort in\n    // fixtures/index_assign_test.vibe).\n    let w_ld_in = 0\n    let w_cond_tag = expr_tag(cond)\n    let nl1 = if w_cond_tag == 5 {\n      let wcop = get_ebinop_op(cond)\n      if wcop == \"<\" || wcop == \">\" || wcop == \"<=\" || wcop == \">=\" {\n        let wlhs = get_ebinop_lhs(cond)\n        let wrhs = get_ebinop_rhs(cond)\n        let wnl1 = compile_expr(buf, wlhs, local_names, next_local, ctx, w_ld_in)\n        let wnl2 = compile_expr(buf, wrhs, local_names, wnl1, ctx, w_ld_in)\n        if wcop == \"<\" {\n          emit_i64_lt_s(buf); emit_i32_eqz(buf)\n        }\n        else if wcop == \">\" {\n          emit_i64_gt_s(buf); emit_i32_eqz(buf)\n        }\n        else if wcop == \"<=\" {\n          emit_i64_le_s(buf); emit_i32_eqz(buf)\n        }\n        else {\n          emit_i64_ge_s(buf); emit_i32_eqz(buf)\n        }\n        wnl2\n      } else {\n        let wnl = compile_expr(buf, cond, local_names, next_local, ctx, w_ld_in)\n        emit_i64_eqz(buf)\n        wnl\n      }\n    } else {\n      let wnl = compile_expr(buf, cond, local_names, next_local, ctx, w_ld_in)\n      emit_i64_eqz(buf)\n      wnl\n    }\n    emit_br_if(buf, 1)\n    let nl2 = compile_expr(buf, body, local_names, nl1, ctx, w_ld_in)\n    emit_drop(buf)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    Array::truncate(ctx.loop_borrowed_names, lb_base)\n    emit_i64_const(buf, 0)\n    nl2\n  } else if __tag == 20 {\n    emit_br(buf, ld + 1)\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 21 {\n    emit_br(buf, ld)\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 22 {\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 24 {\n    compile_lambda(buf, get_efn_params(expr), get_efn_body(expr), local_names, next_local, ctx, ld, compile_expr)\n  } else if __tag == 26 {\n    let ret_expr = get_ereturn_expr(expr)\n    let nl = compile_expr(buf, ret_expr, local_names, next_local, ctx, ld)\n    emit_return(buf)\n    nl\n  } else {\n    compile_expr_tail4(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

