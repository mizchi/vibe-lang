let cli_adapter_source_86 = () -> (String, String) {
  ("lib/@vibe/compiler/codegen/expr/compile_match.vibe",
"//# Imports\n\nimport @vibe/compiler/core {\n  Expr,\n  Pat,\n  Stmt,\n  TypeExpr,\n  bsearch_leftmost,\n  bytebuf_length,\n  bytebuf_new,\n  bytebuf_push,\n  bytebuf_push_section,\n  bytebuf_push_vec_header,\n  bytebuf_to_bytes,\n  leb128_encode_s64,\n  leb128_encode_u32\n}\n\nimport @vibe/compiler/codegen/common_analysis {\n  collect_free_vars,\n  collect_strings_stmts,\n  emit_closure_call_tail,\n  emit_closure_resolve,\n  emit_i64_extend_i32_u,\n  is_mut_captured_in,\n  md_consume_count\n}\n\nimport @vibe/compiler/codegen/common_base {\n  CompileCtx,\n  CtorTable,\n  FuncTable,\n  LambdaTable,\n  StrTable,\n  agg_log_reset_above2,\n  cov_emit_branch,\n  ctor_field_is_float,\n  ctor_table_index_of,\n  emit_binop_op,\n  emit_i32_eq,\n  emit_i32_eqz,\n  emit_i32_ge_u,\n  emit_i32_mul,\n  emit_i32_ne,\n  emit_i32_sub,\n  emit_i64_load,\n  emit_i64_store,\n  emit_rc_dup_guarded,\n  emit_str_ref,\n  emit_unbox_float,\n  expr_tag,\n  float_log_reset_above,\n  get_ebinop_op,\n  get_efn_body,\n  get_eif_cond,\n  get_eif_else,\n  get_eif_then,\n  get_elet_body,\n  get_elet_name,\n  get_elet_val,\n  get_slet_expr,\n  get_slet_name,\n  int_log_reset_above,\n  is_efn,\n  is_eident,\n  is_etuple,\n  is_pbind,\n  is_pbool,\n  is_pctor,\n  is_pfloat,\n  is_pint,\n  is_pstring,\n  is_ptuple,\n  is_pwild,\n  is_slet,\n  resolve_func,\n  resolve_local\n}\n\nimport @vibe/compiler/codegen/common_extractors {\n  array_contains_str,\n  emit_assignop_op,\n  emit_memory_copy,\n  find_catchall_idx,\n  get_earray_elems,\n  get_eassign_body,\n  get_eassign_name,\n  get_eassign_val,\n  get_eassignop_body,\n  get_eassignop_name,\n  get_eassignop_op,\n  get_eassignop_val,\n  get_ebinop_lhs,\n  get_ebinop_rhs,\n  get_ebool_value,\n  get_ecall_args,\n  get_ecall_callee,\n  get_efloat_value,\n  get_efn_params,\n  get_eforin_body,\n  get_eforin_iter,\n  get_eforin_name,\n  get_eident_name,\n  get_eint_value,\n  get_eletmut_body,\n  get_eletmut_name,\n  get_eletmut_val,\n  get_eletrec_body,\n  get_eletrec_name,\n  get_eletrec_val,\n  get_eseq_first,\n  get_eseq_second,\n  get_estring_value,\n  get_etuple_elems,\n  get_eunaryop_expr,\n  get_eunaryop_op,\n  get_ewhile_body,\n  get_ewhile_cond,\n  get_match_arms,\n  get_match_scrutinee,\n  get_pbind_name,\n  get_pbool_value,\n  get_pctor_args,\n  get_pctor_name,\n  get_pfloat_value,\n  get_pint_value,\n  get_pstring_value,\n  get_ptuple_pats,\n  get_slet_export,\n  str_table_lookup\n}\n\nimport @vibe/compiler/codegen/wasm_emit {\n  emit_block_i64,\n  emit_block_void,\n  emit_br,\n  emit_br_if,\n  emit_call,\n  emit_call_indirect,\n  emit_code_section,\n  emit_code_section_with_locals,\n  emit_data_section,\n  emit_data_section_multi,\n  emit_drop,\n  emit_element_section_active,\n  emit_else,\n  emit_end,\n  emit_export_section,\n  emit_export_section_multi,\n  emit_exports_full,\n  emit_exports_with_memory,\n  emit_f64_add,\n  emit_f64_const_bits,\n  emit_f64_const_lohi,\n  emit_f64_convert_i64_s,\n  emit_f64_div,\n  emit_f64_eq,\n  emit_f64_ge,\n  emit_f64_gt,\n  emit_f64_le,\n  emit_f64_lt,\n  emit_f64_mul,\n  emit_f64_ne,\n  emit_f64_neg,\n  emit_f64_reinterpret_i64,\n  emit_f64_sub,\n  emit_func_type_raw,\n  emit_function_section,\n  emit_global_get,\n  emit_global_section_i32_mut,\n  emit_global_set,\n  emit_header,\n  emit_i32_add,\n  emit_i32_const,\n  emit_i32_load,\n  emit_i32_load8_u,\n  emit_i32_store,\n  emit_i32_store8,\n  emit_i32_wrap_i64,\n  emit_i64_add,\n  emit_i64_and,\n  emit_i64_const,\n  emit_i64_div_s,\n  emit_i64_eq,\n  emit_i64_eqz,\n  emit_i64_extend_i32_s,\n  emit_i64_ge_s,\n  emit_i64_gt_s,\n  emit_i64_le_s,\n  emit_i64_lt_s,\n  emit_i64_mul,\n  emit_i64_ne,\n  emit_i64_or,\n  emit_i64_reinterpret_f64,\n  emit_i64_rem_s,\n  emit_i64_shl,\n  emit_i64_shr_s,\n  emit_i64_sub,\n  emit_i64_trunc_f64_s,\n  emit_i64_xor,\n  emit_if_i64,\n  emit_if_void,\n  emit_import_section_func,\n  emit_local_get,\n  emit_local_set,\n  emit_local_tee,\n  emit_loop_void,\n  emit_memory_section,\n  emit_name,\n  emit_return,\n  emit_table_section_funcref,\n  emit_type_section,\n  emit_type_section_multi,\n  string_to_data\n}\n\n//# Functions\n\n// #613 follow-up: bind every `PBind` reachable under a container pattern\n// (tuple or constructor) at ANY nesting depth, skipping literal / wildcard\n// sub-patterns. `base_local` holds the (possibly tagged) pointer to the\n// container whose fields hold the sub-pattern values. `is_ctor_layout`\n// selects the field layout: a constructor stores its tag at offset 0 and\n// fields at `8 + i*8` with the pointer always tag-cleared; a tuple stores\n// fields at `8 + i*8` (RC, tagged) or `i*8` (non-RC, untagged). Used for\n// conditional match arms whose top pattern is a bare tuple with literal\n// siblings (`(false, n) => ..`), where the binding pass previously emitted\n// nothing and any use of `n` trapped codegen with \"undefined variable\".\n\n//# ADR-0092 Phase 1: drop-guided reuse (narrow fusion; see\n//# CompileCtx.reuse_scrutinee_names). Local mirrors of compile_call's\n//# cc_is_* arg classifiers (same-file rule for the bundle flatten tool).\n\nfn mr_is_projection(e: Expr) -> Bool {\n  match e {\n    EDot(_, _, _, _) => true,\n    _ => false\n  }\n}\n\nfn mr_is_borrow_ret_call(e: Expr, ctx: CompileCtx) -> Bool {\n  match e {\n    ECall(callee, _, _) =>\n    match callee {\n      EIdent(f, _) => f == \"Array::get\" || f == \"Map::get\" || f == \"__index\" || f == \"__rec_field\" || bsearch_leftmost(ctx.borrow_ret_names, f) >= 0,\n      _ => false\n    },\n    _ => false\n  }\n}\n\nfn mr_is_loop_borrowed_ident(e: Expr, ctx: CompileCtx) -> Bool {\n  match e {\n    EIdent(name, _) => array_contains_str(ctx.loop_borrowed_names, name) && !array_contains_str(ctx.ref_cell_names, name),\n    _ => false\n  }\n}\n\nfn mr_spine_tail(e: Expr) -> Expr with { Error } {\n  if expr_tag(e) == 9 {\n    mr_spine_tail(get_elet_body(e))\n  } else {\n    e\n  }\n}\n\n/// A let-spine prefix is admissible when every spine binding carries NO\n/// planned RC action (not in rc_drop/rc_dup/rc_alias_dup) -- such bindings\n/// compile as plain value+local_set with no bookkeeping to reproduce, so the\n/// reuse path can compile them verbatim without re-implementing\n/// compile_expr_tail's ELet dup/drop machinery. Scalar temporaries\n/// (`let s = x + y`) are the common case; anything the plan tracks makes the\n/// arm ineligible (normal path).\nfn mr_spine_lets_ok(e: Expr, ctx: CompileCtx) -> Bool with { Error } {\n  if expr_tag(e) == 9 {\n    let n = get_elet_name(e)\n    if array_contains_str(ctx.rc_drop_names, n) || array_contains_str(ctx.rc_dup_names, n) || array_contains_str(ctx.rc_alias_dup_names, n) {\n      false\n    } else {\n      mr_spine_lets_ok(get_elet_body(e), ctx)\n    }\n  } else {\n    true\n  }\n}\n\n/// Eligibility for the reuse fusion on ONE conditional arm: the staged\n/// scrutinee (top of ctx.reuse_scrutinee_names) is this match's own bare-ident\n/// scrutinee, the arm pattern is `PCtor` whose args are all PBind/PWild with\n/// every PBind consumed EXACTLY once in the arm body (ownership then moves\n/// cleanly: no bind-time dup, no binding-scope drop -- this is what lets\n/// uniqueness cascade through a recursive rebuild instead of dying at depth\n/// 1), the arm body is EXACTLY a constructor call with the SAME field count\n/// (same block size, 16 + 8n, by ctor layout), the target ctor has no\n/// boxed-float fields (their store path differs), and the scrutinee name is\n/// not referenced anywhere in the arm body (the arm consumes the reference up\n/// front). Returns the target ctor_table index, or -1 when the arm must\n/// compile through the normal borrow-bind path (scope-end drop covers it).\nfn mr_reuse_eligible(p: Pat, body: Expr, scrutinee: Expr, ctx: CompileCtx) -> Int with { Error } {\n  let mr_tail = mr_spine_tail(body)\n  if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && ctx.rc_alloc_func_idx >= 0 && Array::length(ctx.reuse_scrutinee_names) > 0 && is_pctor(p) && is_eident(scrutinee) && expr_tag(mr_tail) == 8 && mr_spine_lets_ok(body, ctx) {\n    let sname = Array::get(ctx.reuse_scrutinee_names, Array::length(ctx.reuse_scrutinee_names) - 1)\n    if get_eident_name(scrutinee) == sname {\n      let pargs = get_pctor_args(p)\n      let arity = Array::length(pargs)\n      let callee = get_ecall_callee(mr_tail)\n      if arity >= 1 && is_eident(callee) {\n        let ci = ctor_table_index_of(ctx.ctor_table, get_eident_name(callee))\n        let src_ci = ctor_table_index_of(ctx.ctor_table, get_pctor_name(p))\n        if ci >= 0 && src_ci >= 0 && Array::get(ctx.ctor_table.field_counts, ci) == arity && Array::length(get_ecall_args(mr_tail)) == arity {\n          let mut shape_ok = true\n          let mut fj = 0\n          while fj < arity {\n            let pa = Array::get(pargs, fj)\n            // Neither side may have a boxed-float field: the target's store\n            // path differs, and a SOURCE float payload would bypass\n            // bind_match_pat's float_local_slots registration (the raw-load\n            // bind below doesn't know field types), so e.g. `-x` on the\n            // binding would negate the box pointer (Codex review P1).\n            if ctor_field_is_float(ctx, ci, fj) || ctor_field_is_float(ctx, src_ci, fj) {\n              shape_ok = false\n            } else if is_pbind(pa) {\n              if md_consume_count(body, get_pbind_name(pa)) != 1 {\n                shape_ok = false\n              } else {\n                ()\n              }\n            } else if is_pwild(pa) {\n              ()\n            } else {\n              shape_ok = false\n            }\n            fj = fj + 1\n          }\n          let __no_params: Array[String] = [\n          ]\n          let __no_fns: Array[String] = [\n          ]\n          if shape_ok && !array_contains_str(collect_free_vars(body, __no_params, __no_fns), sname) {\n            ci\n          } else {\n            0 - 1\n          }\n        } else {\n          0 - 1\n        }\n      } else {\n        0 - 1\n      }\n    } else {\n      0 - 1\n    }\n  } else {\n    0 - 1\n  }\n}\n\n/// Compile an eligible arm with in-place block reuse, Perceus-shaped:\n/// consume the scrutinee reference FIRST, then run one shared continuation.\n///   1. bind payloads as raw loads (no bind-time dup -- eligibility proved\n///      each PBind is consumed exactly once, so ownership transfers).\n///   2. test the block's rc word: exactly `1 | (class 1 << 24)` means ours is\n///      the only reference -- keep the block as a reuse token (children now\n///      owned by the payload bindings; PWild children are dropped here, they\n///      are ours and unused). Otherwise dup each PBind payload (the bindings\n///      become owners), release our reference with a guarded drop (never\n///      frees: rc > 1 on this path; immortal-saturated words also land here\n///      and their drop is a no-op), and zero the token.\n///   3. either way the ELet's staged reference is consumed: set the flag so\n///      the scope-end drop is skipped on this arm's path.\n///   4. compute the constructor's field values (payloads referenced exactly\n///      once move through; non-payload borrowed-view args get the same\n///      owning-position retain compile_call's ctor path applies).\n///   5. token != 0 -> rewrite tag + fields in place (size/rc/class/field\n///      count already correct); token == 0 -> fresh __rc_alloc identical to\n///      compile_call's ctor path.\nfn mr_compile_reuse_arm(buf: Bytes, body: Expr, pat: Pat, scrut_local: Int, flag_local: Int, arity: Int, ctor_idx: Int, local_names: Array[String], ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let args = get_ecall_args(mr_spine_tail(body))\n  let pargs = get_pctor_args(pat)\n  let tag = Array::get(ctx.ctor_table.tags, ctor_idx)\n  // 1. raw payload binds: field j lives at (scrut & ~1) + 8 + 8j.\n  let mut bi = 0\n  while bi < arity {\n    let pa = Array::get(pargs, bi)\n    if is_pbind(pa) {\n      let bl = Array::length(local_names)\n      emit_local_get(buf, scrut_local)\n      emit_i64_const(buf, 0 - 2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + bi * 8)\n      emit_local_set(buf, bl)\n      Array::push(local_names, get_pbind_name(pa))\n    } else {\n      ()\n    }\n    bi = bi + 1\n  }\n  // ADR-0062 shadow lane: route the scrutinee through a guarded dup+drop\n  // pair before consuming it. Net-zero on the refcount, but both halves\n  // check the shadow liveness byte, so reusing (or releasing) a block the\n  // shadow ledger already considers freed traps deterministically here\n  // instead of corrupting the free list downstream.\n  if ctx.rc_shadow {\n    emit_rc_dup_guarded(buf, scrut_local, true)\n    emit_local_get(buf, scrut_local)\n    emit_call(buf, ctx.rc_drop_func_idx)\n  } else {\n    ()\n  }\n  // 2. consume the reference; tk = block base or 0.\n  let tk = Array::length(local_names)\n  Array::push(local_names, \"__reuse_tk\")\n  emit_local_get(buf, scrut_local)\n  emit_i64_const(buf, 0 - 2)\n  emit_i64_and(buf)\n  emit_i64_const(buf, 8)\n  emit_i64_sub(buf)\n  emit_local_set(buf, tk)\n  emit_local_get(buf, tk)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 4)\n  emit_i32_const(buf, 16777217)\n  emit_i32_eq(buf)\n  emit_if_void(buf)\n  let mut wj = 0\n  while wj < arity {\n    if is_pwild(Array::get(pargs, wj)) {\n      emit_local_get(buf, tk)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 16 + wj * 8)\n      emit_call(buf, ctx.rc_drop_func_idx)\n    } else {\n      ()\n    }\n    wj = wj + 1\n  }\n  emit_else(buf)\n  let mut dj = 0\n  let mut bl2 = 0\n  while dj < arity {\n    if is_pbind(Array::get(pargs, dj)) {\n      // payload locals sit just below tk, in pattern order\n      let nbinds_before = mr_binds_before(pargs, dj)\n      emit_rc_dup_guarded(buf, tk - mr_bind_count(pargs) + nbinds_before, ctx.rc_shadow)\n      bl2 = bl2 + 1\n    } else {\n      ()\n    }\n    dj = dj + 1\n  }\n  emit_local_get(buf, scrut_local)\n  emit_call(buf, ctx.rc_drop_func_idx)\n  emit_i64_const(buf, 0)\n  emit_local_set(buf, tk)\n  emit_end(buf)\n  emit_i64_const(buf, 1)\n  emit_local_set(buf, flag_local)\n  // 3b. admissible let-spine prefix: plain value + local_set per binding\n  // (mr_spine_lets_ok proved the plan owes them no dup/drop), evaluated\n  // AFTER the reference is consumed -- payloads are owned by their\n  // bindings, so spine code may consume them exactly once as usual.\n  let mut mr_sp = body\n  while expr_tag(mr_sp) == 9 {\n    let spv = get_elet_val(mr_sp)\n    let spn = get_elet_name(mr_sp)\n    let spnl = ce(buf, spv, local_names, Array::length(local_names), ctx, ld)\n    emit_local_set(buf, spnl)\n    Array::push(local_names, spn)\n    mr_sp = get_elet_body(mr_sp)\n  }\n  // 4. field values.\n  let vals: Array[Int] = [\n  ]\n  let mut nl = Array::length(local_names)\n  let mut i = 0\n  while i < arity {\n    let a = Array::get(args, i)\n    nl = ce(buf, a, local_names, nl, ctx, ld)\n    let vl = nl\n    Array::push(local_names, \"__reuse_val\")\n    emit_local_set(buf, vl)\n    if mr_is_loop_borrowed_ident(a, ctx) {\n      Array::push(ctx.loop_consumed_names, get_eident_name(a))\n      emit_rc_dup_guarded(buf, vl, ctx.rc_shadow)\n    } else if mr_is_projection(a) || mr_is_borrow_ret_call(a, ctx) {\n      emit_rc_dup_guarded(buf, vl, ctx.rc_shadow)\n    } else {\n      ()\n    }\n    Array::push(vals, vl)\n    nl = nl + 1\n    i = i + 1\n  }\n  // 5. reuse or fresh-alloc; both branches yield the tagged value.\n  emit_local_get(buf, tk)\n  emit_i64_eqz(buf)\n  emit_i32_eqz(buf)\n  emit_if_i64(buf)\n  emit_local_get(buf, tk)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, tag)\n  emit_i32_store(buf, 2, 8)\n  let mut sj = 0\n  while sj < arity {\n    emit_local_get(buf, tk)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, Array::get(vals, sj))\n    emit_i64_store(buf, 3, 16 + sj * 8)\n    sj = sj + 1\n  }\n  emit_local_get(buf, tk)\n  emit_i64_const(buf, 8)\n  emit_i64_add(buf)\n  emit_i64_const(buf, 1)\n  emit_i64_or(buf)\n  emit_else(buf)\n  let total = 16 + arity * 8\n  emit_i64_const(buf, total)\n  emit_call(buf, ctx.rc_alloc_func_idx)\n  emit_local_set(buf, tk)\n  emit_local_get(buf, tk)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, total)\n  emit_i32_store(buf, 2, 0)\n  emit_local_get(buf, tk)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 1)\n  emit_i32_store(buf, 2, 4)\n  emit_local_get(buf, tk)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 1)\n  emit_i32_store8(buf, 0, 7)\n  emit_local_get(buf, tk)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, tag)\n  emit_i32_store(buf, 2, 8)\n  emit_local_get(buf, tk)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, arity)\n  emit_i32_store(buf, 2, 12)\n  let mut fj2 = 0\n  while fj2 < arity {\n    emit_local_get(buf, tk)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, Array::get(vals, fj2))\n    emit_i64_store(buf, 3, 16 + fj2 * 8)\n    fj2 = fj2 + 1\n  }\n  emit_local_get(buf, tk)\n  emit_i64_const(buf, 8)\n  emit_i64_add(buf)\n  emit_i64_const(buf, 1)\n  emit_i64_or(buf)\n  emit_end(buf)\n  nl\n}\n\nfn mr_bind_count(pargs: Array[Pat]) -> Int {\n  let mut n = 0\n  let mut i = 0\n  while i < Array::length(pargs) {\n    if is_pbind(Array::get(pargs, i)) {\n      n = n + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  n\n}\n\nfn mr_binds_before(pargs: Array[Pat], idx: Int) -> Int {\n  let mut n = 0\n  let mut i = 0\n  while i < idx {\n    if is_pbind(Array::get(pargs, i)) {\n      n = n + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  n\n}\n\n/// Emit `n` guarded rc_dups of `local_idx` (one per owning consume of a matched\n/// field; see md_consume_count). n<=0 emits nothing.\nfn emit_rc_dup_guarded_n(buf: Bytes, local_idx: Int, n: Int, rc_shadow: Bool) -> Unit {\n  let mut k = 0\n  while k < n {\n    emit_rc_dup_guarded(buf, local_idx, rc_shadow)\n    k = k + 1\n  }\n}\n\nfn bind_match_pat(buf: Bytes, base_local: Int, container_pat: Pat, is_ctor_layout: Bool, local_names: Array[String], ctx: CompileCtx, body: Expr) -> Unit with { Error } {\n  let elems = if is_ctor_layout {\n    get_pctor_args(container_pat)\n  } else {\n    get_ptuple_pats(container_pat)\n  }\n  // #1062: a bound field's declared type is only known here for the ctor\n  // layout (a bare tuple pattern has no declared field types to consult) --\n  // resolve the matched constructor's ctor_idx ONCE per call so the loop\n  // below can ask ctor_field_is_float per positional field. -1 (not a ctor\n  // layout) makes ctor_field_is_float trivially return false.\n  let __bmp_ctor_idx = if is_ctor_layout {\n    ctor_table_index_of(ctx.ctor_table, get_pctor_name(container_pat))\n  } else {\n    -1\n  }\n  let mut i = 0\n  while i < Array::length(elems) {\n    let ep = Array::get(elems, i)\n    let off = if is_ctor_layout {\n      8 + i * 8\n    } else if ctx.enable_rc {\n      8 + i * 8\n    } else {\n      i * 8\n    }\n    let clear_tag = is_ctor_layout || ctx.enable_rc\n    if is_pbind(ep) {\n      let nm = get_pbind_name(ep)\n      let fl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      if clear_tag {\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, fl)\n      // #1062: a Double/Float-typed constructor field bound by a pattern\n      // (`Circle(r) => r * r`) must be registered into float_local_slots\n      // exactly like a `let`-bound float, else it falls through to the\n      // integer-multiply path -- under RC that multiplies two boxed-float\n      // POINTERS together, producing a bogus pointer that traps (\"memory\n      // access out of bounds\") when later dereferenced. __bmp_ctor_idx is\n      // -1 for a bare tuple pattern, and ctor_field_is_float trivially\n      // returns false for a -1 ctor_idx, so this is a no-op there.\n      if ctor_field_is_float(ctx, __bmp_ctor_idx, i) {\n        Array::push(ctx.float_local_slots, fl * 2 + 1)\n      } else {\n        ()\n      }\n      // #715 follow-up: this helper previously bound the field without ever\n      // dup'ing it, regardless of how many owning uses `nm` has in `body` — a\n      // matched field is a borrowed view sharing the container's refcount\n      // (see #702/#705 at the inline call sites in `compile_match`), so an\n      // owning consume plus the container's own recursive drop double-frees\n      // the same block. Mirror the inline sites' guarded per-consume dup.\n      // #1097 (historical): this used to ALSO add one dup per closure\n      // literal capturing `nm` (md_capturing_fn_count) because closure envs\n      // held captures as borrows. The owned-captures ABI (ADR-0076 追記31\n      // Vertical A) moved that +1 into compile_lambda's creation-site dup,\n      // so only the owning-consume compensation remains here.\n      if ctx.enable_rc {\n        emit_rc_dup_guarded_n(buf, fl, md_consume_count(body, nm), ctx.rc_shadow)\n      } else {\n        ()\n      }\n      Array::push(local_names, nm)\n    } else if is_ptuple(ep) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      if clear_tag {\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, ep, false, local_names, ctx, body)\n    } else if is_pctor(ep) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      if clear_tag {\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, ep, true, local_names, ctx, body)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n}\n\n/// The index of `field` WITHIN the struct named `sname`. A struct value lays its\n/// fields out exactly like a constructor — tag/header at 0, field i at `8 + i*8`,\n/// pointer tag-cleared — so the offset is `8 + index*8`, identical to what\n/// `obj.field` reads. The matched struct name MUST drive the lookup: two structs\n/// can share a field name at different positions (`A { x; y }` vs `B { y; x }`),\n/// so a name-agnostic \"first struct that declares the field\" scan binds the wrong\n/// offset. Only when `sname` is not in the table do we fall back to that scan.\nfn find_struct_index(ctx: CompileCtx, sname: String) -> Int {\n  let names = ctx.ctor_table.struct_names\n  let mut si = 0\n  let mut sidx = -1\n  while si < Array::length(names) {\n    if Array::get(names, si) == sname {\n      sidx = si\n      si = Array::length(names)\n    } else {\n      si = si + 1\n    }\n  }\n  sidx\n}\n\nfn field_index_in(fnames: Array[String], field: String) -> Int {\n  let mut fi = 0\n  let mut found = -1\n  while fi < Array::length(fnames) {\n    if Array::get(fnames, fi) == field {\n      found = fi\n      fi = Array::length(fnames)\n    } else {\n      fi = fi + 1\n    }\n  }\n  found\n}\n\nfn struct_field_index(ctx: CompileCtx, sname: String, field: String) -> Int with { Error } {\n  let sidx = find_struct_index(ctx, sname)\n  if sidx >= 0 {\n    let found = field_index_in(Array::get(ctx.ctor_table.struct_field_names, sidx), field)\n    if found < 0 {\n      throw(String::concat(String::concat(String::concat(\"unknown field `\", field), \"` in struct \"), sname))\n    } else {\n      found\n    }\n  } else {\n    // `sname` not found in the struct table: fall back to the legacy global\n    // first-match scan so unqualified / synthetic names still resolve.\n    let names = ctx.ctor_table.struct_names\n    let mut gsi = 0\n    let mut gfound = -1\n    while gsi < Array::length(names) {\n      let f = field_index_in(Array::get(ctx.ctor_table.struct_field_names, gsi), field)\n      if f >= 0 {\n        gfound = f\n        gsi = Array::length(names)\n      } else {\n        gsi = gsi + 1\n      }\n    }\n    if gfound < 0 {\n      throw(String::concat(\"unknown struct field in pattern: \", field))\n    } else {\n      gfound\n    }\n  }\n}\n\n/// Bind every variable in a struct pattern `S::{ f1: p1, f2: p2, ... }` whose\n/// value is the (tagged) struct pointer in `base_local`. Each field is loaded by\n/// NAME (offset `8 + struct_field_index*8`), then its sub-pattern is bound:\n/// a `PBind` becomes a local; a tuple/constructor sub-pattern recurses through\n/// the positional `bind_match_pat`; a nested struct recurses here. Literal /\n/// wildcard sub-patterns bind nothing (a struct pattern with a literal field is\n/// refutable and is not routed here — see `is_catchall_pat`).\nfn bind_struct_pat(buf: Bytes, base_local: Int, sname: String, fields: Array[(String, Pat)], local_names: Array[String], ctx: CompileCtx, body: Expr) -> Unit with { Error } {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (fname, subpat) = Array::get(fields, i)\n    let off = 8 + struct_field_index(ctx, sname, fname) * 8\n    if is_pbind(subpat) {\n      let nm = get_pbind_name(subpat)\n      let fl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, fl)\n      // #715 follow-up: same missing-dup gap as `bind_match_pat` above, for an\n      // irrefutable struct-pattern field. The former #1097 capturing-literal\n      // term moved to compile_lambda's creation-site dup (owned-captures).\n      if ctx.enable_rc {\n        emit_rc_dup_guarded_n(buf, fl, md_consume_count(body, nm), ctx.rc_shadow)\n      } else {\n        ()\n      }\n      Array::push(local_names, nm)\n    } else if is_ptuple(subpat) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, subpat, false, local_names, ctx, body)\n    } else if is_pctor(subpat) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, subpat, true, local_names, ctx, body)\n    } else {\n      match subpat {\n        PStruct(__sname, sfields) => {\n          let sl = Array::length(local_names)\n          emit_local_get(buf, base_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, off)\n          emit_local_set(buf, sl)\n          Array::push(local_names, \"__bind_sub\")\n          bind_struct_pat(buf, sl, __sname, sfields, local_names, ctx, body)\n        },\n        _ => ()\n      }\n    }\n    i = i + 1\n  }\n}\n\nexport fn compile_match(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let __match_scrutinee = get_match_scrutinee(expr)\n  let __match_arms = get_match_arms(expr)\n  let scrut_local = next_local\n  Array::push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = Array::length(__match_arms)\n  let catchall_idx = find_catchall_idx(__match_arms)\n  let num_cond_arms = catchall_idx\n  let mut ai = 0\n  let mut max_nl = nl1\n  let names_len_at_match = Array::length(local_names)\n  // #965 review (#984): ref_cell_names is name-keyed. An arm's captured\n  // `let mut n` stayed registered as a ref cell after the local_names\n  // truncate below, so a LATER arm's `n` resolved to the outer scalar slot\n  // but was loaded through the ref-cell path (garbage in the bump lane; the\n  // RC lane α-renames shadows first). Restore it with the same discipline.\n  let ref_cells_at_match = Array::length(ctx.ref_cell_names)\n  // #613 follow-up: discriminate literal sub-patterns at EVERY nesting level,\n  // not just the top constructor-argument level. `load_field` is a thunk that\n  // pushes the (tagged) value at this position. `emit_pat_test` emits a single\n  // i32 boolean (\"does the value at this position match `sp`?\") with NO trailing\n  // AND, recursing through ctor args, tuple elements, and or-branches. Without\n  // recursing, `N(W(false), n)` matched `N(W(true), _)`, `T((false, n))` matched\n  // `T((true, _))`, and or-branches `(1, _) | (2, _)` / `\"a\" | \"b\"` matched\n  // anything — silent wrong results. Bindings/wildcards always match (push 1).\n  let rec emit_pat_test: (Pat, () -> Unit) -> Unit = (sp, load_field) -> {\n    match sp {\n      POr(__l, __r) => {\n        // (left matches) OR (right matches) at this same position.\n        emit_pat_test(__l, load_field)\n        emit_pat_test(__r, load_field)\n        bytebuf_push(buf, 114)\n      },\n      _ => {\n        if is_pfloat(sp) {\n          // Bit-exact f64 compare: bump lane holds raw bits, RC lane a boxed\n          // pointer (unbox first). f64.eq gives `==` semantics (0.0 == -0.0).\n          load_field()\n          if ctx.enable_rc {\n            emit_unbox_float(buf)\n          } else {\n            ()\n          }\n          emit_f64_reinterpret_i64(buf)\n          let __pfv = get_pfloat_value(sp)\n          emit_f64_const_lohi(buf, Double::to_i64_bits_lo(__pfv), Double::to_i64_bits_hi(__pfv))\n          emit_f64_eq(buf)\n        } else if is_pint(sp) {\n          load_field()\n          emit_i64_const(buf, get_pint_value(sp))\n          if ctx.enable_rc {\n            emit_i64_const(buf, 1)\n            emit_i64_shl(buf)\n          }\n          emit_i64_eq(buf)\n        } else if is_pbool(sp) {\n          load_field()\n          emit_i64_const(buf, if get_pbool_value(sp) {\n            1\n          } else {\n            0\n          })\n          if ctx.enable_rc {\n            emit_i64_const(buf, 1)\n            emit_i64_shl(buf)\n          }\n          emit_i64_eq(buf)\n        } else if is_pstring(sp) {\n          let __sv = get_pstring_value(sp)\n          let __si = str_table_lookup(ctx.str_table.strs, __sv)\n          if __si >= 0 {\n            let (__seq_fi, _, _) = resolve_func(ctx.func_table, \"eq\")\n            load_field()\n            emit_str_ref(buf, Array::get(ctx.str_table.offsets, __si), Array::get(ctx.str_table.lengths, __si))\n            emit_call(buf, __seq_fi)\n            emit_i32_wrap_i64(buf)\n          } else {\n            // String literal absent from the table: conservatively match (the\n            // prior behavior emitted no test at all).\n            emit_i32_const(buf, 1)\n          }\n        } else if is_pctor(sp) {\n          let __ncname = get_pctor_name(sp)\n          let __nci = ctor_table_index_of(ctx.ctor_table, __ncname)\n          let __ntag = if __nci >= 0 {\n            Array::get(ctx.ctor_table.tags, __nci)\n          } else {\n            -1\n          }\n          load_field()\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, __ntag)\n          emit_i32_eq(buf)\n          let __nargs = get_pctor_args(sp)\n          // #705: payload sub-tests must NOT run when the tag test above\n          // failed. The value may be a different constructor (or a scalar)\n          // whose slot at `8 + k*8` is not a valid value of this ctor's field\n          // type; a nested tag test would dereference that garbage — a\n          // data-dependent OOB that crashed the RC-built compiler's\n          // check_expr / seed_var_types on `Some(TDEnum(..))`-style patterns.\n          // Guard the sub-tests behind the tag test with `if (result i32)`\n          // so the AND short-circuits. Binds/wildcards add no test.\n          let mut __nany = false\n          let mut __nj = 0\n          while __nj < Array::length(__nargs) {\n            let __np = Array::get(__nargs, __nj)\n            if is_pbind(__np) || is_pwild(__np) {\n              ()\n            } else {\n              __nany = true\n            }\n            __nj = __nj + 1\n          }\n          if __nany {\n            bytebuf_push(buf, 4)\n            bytebuf_push(buf, 127)\n            emit_i32_const(buf, 1)\n            let mut __nk = 0\n            while __nk < Array::length(__nargs) {\n              let __nkk = __nk\n              let __np2 = Array::get(__nargs, __nkk)\n              if is_pbind(__np2) || is_pwild(__np2) {\n                ()\n              } else {\n                let __nload: () -> Unit = () -> {\n                  load_field()\n                  emit_i64_const(buf, -2)\n                  emit_i64_and(buf)\n                  emit_i32_wrap_i64(buf)\n                  emit_i64_load(buf, 3, 8 + __nkk * 8)\n                }\n                emit_pat_test(__np2, __nload)\n                bytebuf_push(buf, 113)\n              }\n              __nk = __nk + 1\n            }\n            emit_else(buf)\n            emit_i32_const(buf, 0)\n            emit_end(buf)\n          } else {\n            ()\n          }\n        } else if is_ptuple(sp) {\n          emit_i32_const(buf, 1)\n          let __tpats = get_ptuple_pats(sp)\n          let mut __tk = 0\n          while __tk < Array::length(__tpats) {\n            let __tkk = __tk\n            let __tload: () -> Unit = () -> {\n              load_field()\n              if ctx.enable_rc {\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n              }\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, if ctx.enable_rc {\n                8 + __tkk * 8\n              } else {\n                __tkk * 8\n              })\n            }\n            emit_pat_test(Array::get(__tpats, __tkk), __tload)\n            bytebuf_push(buf, 113)\n            __tk = __tk + 1\n          }\n        } else {\n          // PBind / PWild: always matches.\n          emit_i32_const(buf, 1)\n        }\n      }\n    }\n  }\n  // AND a position's match test onto the accumulator already on the stack.\n  // Bindings/wildcards add no constraint, so they emit nothing (keeping the\n  // accumulator untouched) rather than `const 1; and`.\n  let emit_sub_tests: (Pat, () -> Unit) -> Unit = (sp, load_field) -> {\n    if is_pbind(sp) || is_pwild(sp) {\n      ()\n    } else {\n      emit_pat_test(sp, load_field)\n      bytebuf_push(buf, 113)\n    }\n  }\n  while ai < num_cond_arms {\n    Array::truncate(local_names, names_len_at_match)\n    Array::truncate(ctx.ref_cell_names, ref_cells_at_match)\n    // #678: a previous arm may have logged integral slots >= names_len_at_match\n    // that this arm's pattern binders (non-`let`, so they log nothing) reuse;\n    // drop them so a string bound there is not misread as int by `==`.\n    int_log_reset_above(ctx, names_len_at_match)\n    agg_log_reset_above2(ctx.agg_local_slots, ctx.agg_local_exprs, names_len_at_match)\n    // #1062 follow-up: same prune for the float log -- a previous arm's\n    // Double-typed ctor-field bind (bind_match_pat, see ctor_field_is_float)\n    // may have logged a slot >= names_len_at_match that THIS arm's pattern\n    // binder reuses for a non-float field; without dropping it here the\n    // stale float=1 entry survives and misroutes the new field's arithmetic\n    // through the f64 path.\n    float_log_reset_above(ctx, names_len_at_match)\n    let (__cond_p, __arm_body) = Array::get(__match_arms, ai)\n    let __cond_done = if is_pfloat(__cond_p) {\n      // Top-level float literal arm (`match d { 0.0 => .. }`): same f64\n      // compare as emit_pat_test's PFloat branch.\n      emit_local_get(buf, scrut_local)\n      if ctx.enable_rc {\n        emit_unbox_float(buf)\n      } else {\n        ()\n      }\n      emit_f64_reinterpret_i64(buf)\n      let __apfv = get_pfloat_value(__cond_p)\n      emit_f64_const_lohi(buf, Double::to_i64_bits_lo(__apfv), Double::to_i64_bits_hi(__apfv))\n      emit_f64_eq(buf)\n      emit_if_i64(buf)\n      0\n    } else if is_pint(__cond_p) {\n      emit_local_get(buf, scrut_local)\n      emit_i64_const(buf, get_pint_value(__cond_p))\n      // ADR-0055 Stage 1: scrutinee is a tagged int; tag the literal to match.\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      emit_i64_eq(buf)\n      emit_if_i64(buf)\n      0\n    } else {\n      if is_pbool(__cond_p) {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, if get_pbool_value(__cond_p) {\n          if ctx.enable_rc {\n            2\n          } else {\n            1\n          }\n        } else {\n          0\n        })\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      } else {\n        if is_pctor(__cond_p) {\n          let cname_cond = get_pctor_name(__cond_p)\n          let ctor_ci = ctor_table_index_of(ctx.ctor_table, cname_cond)\n          let expected_tag = if ctor_ci >= 0 {\n            Array::get(ctx.ctor_table.tags, ctor_ci)\n          } else {\n            -1\n          }\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, expected_tag)\n          emit_i32_eq(buf)\n          // #603/#608/#613: the tag test alone is not enough — literal\n          // sub-patterns must be checked at EVERY nesting level, else\n          // `I(1)`/`I(\"x\")` match `I(2)`/`I(\"y\")`, nested `N(W(false),_)` matches\n          // `N(W(true),_)`, and tuple `T((false,_))` matches `T((true,_))`. AND-in\n          // a recursive field-vs-literal test per constructor argument. Bindings\n          // and wildcards add no test. This bug silently broke\n          // `match stmt { SEnum(false, ...) => ... }` in the compiler's own\n          // namespace pass, mis-namespacing exported enums.\n          let __cargs_cond = get_pctor_args(__cond_p)\n          // #705: same short-circuit guard as `emit_pat_test` — payload\n          // sub-tests only run when the arm's tag test matched, else a nested\n          // tag test dereferences a slot that is not a valid tagged value.\n          let mut __cany = false\n          let mut __cj = 0\n          while __cj < Array::length(__cargs_cond) {\n            let __cp = Array::get(__cargs_cond, __cj)\n            if is_pbind(__cp) || is_pwild(__cp) {\n              ()\n            } else {\n              __cany = true\n            }\n            __cj = __cj + 1\n          }\n          if __cany {\n            bytebuf_push(buf, 4)\n            bytebuf_push(buf, 127)\n            emit_i32_const(buf, 1)\n            let mut __ck = 0\n            while __ck < Array::length(__cargs_cond) {\n              let __ckk = __ck\n              let __cload: () -> Unit = () -> {\n                emit_local_get(buf, scrut_local)\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n                emit_i32_wrap_i64(buf)\n                emit_i64_load(buf, 3, 8 + __ckk * 8)\n              }\n              emit_sub_tests(Array::get(__cargs_cond, __ckk), __cload)\n              __ck = __ck + 1\n            }\n            emit_else(buf)\n            emit_i32_const(buf, 0)\n            emit_end(buf)\n          } else {\n            ()\n          }\n          emit_if_i64(buf)\n          0\n        } else {\n          if is_pstring(__cond_p) {\n            let sval = get_pstring_value(__cond_p)\n            let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n            if str_idx >= 0 {\n              let (str_eq_fi, _, _) = resolve_func(ctx.func_table, \"eq\")\n              emit_local_get(buf, scrut_local)\n              emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\n              emit_call(buf, str_eq_fi)\n              emit_i32_wrap_i64(buf)\n              emit_if_i64(buf)\n            }\n            0\n          } else if is_ptuple(__cond_p) {\n            // A bare tuple cond pattern (`(false, n) => ..`) has no tag to test;\n            // previously it fell through to `emit_or_check`'s `_ => const 1`,\n            // making the arm UNCONDITIONALLY match — `(false, n)` matched\n            // `(true, 5)` (silent wrong result, the #613 unsoundness for bare\n            // tuples). Start from a `true` accumulator and AND-in a recursive\n            // field-vs-literal test for every literal element (binds/wildcards\n            // add no test, so an all-bind tuple stays always-true).\n            emit_i32_const(buf, 1)\n            let __tpats_cond = get_ptuple_pats(__cond_p)\n            let mut __tck = 0\n            while __tck < Array::length(__tpats_cond) {\n              let __tckk = __tck\n              let __tcload: () -> Unit = () -> {\n                emit_local_get(buf, scrut_local)\n                if ctx.enable_rc {\n                  emit_i64_const(buf, -2)\n                  emit_i64_and(buf)\n                } else {\n                  ()\n                }\n                emit_i32_wrap_i64(buf)\n                emit_i64_load(buf, 3, if ctx.enable_rc {\n                  8 + __tckk * 8\n                } else {\n                  __tckk * 8\n                })\n              }\n              emit_sub_tests(Array::get(__tpats_cond, __tckk), __tcload)\n              __tck = __tck + 1\n            }\n            emit_if_i64(buf)\n            0\n          } else {\n            let rec emit_or_check: (Pat) -> Unit = (pat) -> {\n              match pat {\n                POr(left, right) => {\n                  emit_or_check(left)\n                  emit_or_check(right)\n                  bytebuf_push(buf, 114)\n                },\n                PInt(n) => {\n                  emit_local_get(buf, scrut_local)\n                  emit_i64_const(buf, n)\n                  if ctx.enable_rc {\n                    emit_i64_const(buf, 1)\n                    emit_i64_shl(buf)\n                  }\n                  emit_i64_eq(buf)\n                },\n                PFloat(fv) => {\n                  // A float or-branch (`0.0|180.0`) previously fell through to\n                  // `_ => const 1` (always-true). Same f64 compare as\n                  // emit_pat_test's PFloat branch.\n                  emit_local_get(buf, scrut_local)\n                  if ctx.enable_rc {\n                    emit_unbox_float(buf)\n                  } else {\n                    ()\n                  }\n                  emit_f64_reinterpret_i64(buf)\n                  emit_f64_const_lohi(buf, Double::to_i64_bits_lo(fv), Double::to_i64_bits_hi(fv))\n                  emit_f64_eq(buf)\n                },\n                PCtor(cname, cargs) => {\n                  let ci = ctor_table_index_of(ctx.ctor_table, cname)\n                  let ctag = if ci >= 0 {\n                    Array::get(ctx.ctor_table.tags, ci)\n                  } else {\n                    -1\n                  }\n                  emit_local_get(buf, scrut_local)\n                  emit_i64_const(buf, -2)\n                  emit_i64_and(buf)\n                  emit_i32_wrap_i64(buf)\n                  emit_i32_load(buf, 2, 0)\n                  emit_i32_const(buf, ctag)\n                  emit_i32_eq(buf)\n                  if Array::length(cargs) == 1 {\n                    match Array::get(cargs, 0) {\n                      PInt(n) => {\n                        emit_local_get(buf, scrut_local)\n                        emit_i64_const(buf, -2)\n                        emit_i64_and(buf)\n                        emit_i32_wrap_i64(buf)\n                        emit_i64_load(buf, 3, 8)\n                        emit_i64_const(buf, n)\n                        if ctx.enable_rc {\n                          emit_i64_const(buf, 1)\n                          emit_i64_shl(buf)\n                        }\n                        emit_i64_eq(buf)\n                        bytebuf_push(buf, 113)\n                      },\n                      _ => ()\n                    }\n                  }\n                },\n                PBool(b) => {\n                  // An or-branch boolean literal (`true | ..`) previously fell\n                  // through to `_ => const 1` (always-true), so `\"a\"|\"b\"` /\n                  // `(1,_)|(2,_)` / bool ors silently matched everything.\n                  emit_local_get(buf, scrut_local)\n                  emit_i64_const(buf, if b {\n                    if ctx.enable_rc {\n                      2\n                    } else {\n                      1\n                    }\n                  } else {\n                    0\n                  })\n                  emit_i64_eq(buf)\n                },\n                PString(sv) => {\n                  let __si = str_table_lookup(ctx.str_table.strs, sv)\n                  if __si >= 0 {\n                    let (__eqfi, _, _) = resolve_func(ctx.func_table, \"eq\")\n                    emit_local_get(buf, scrut_local)\n                    emit_str_ref(buf, Array::get(ctx.str_table.offsets, __si), Array::get(ctx.str_table.lengths, __si))\n                    emit_call(buf, __eqfi)\n                    emit_i32_wrap_i64(buf)\n                  } else {\n                    emit_i32_const(buf, 1)\n                  }\n                },\n                PTuple(tpats) => {\n                  // A tuple or-branch (`(1, _) | (2, _)`): no tag to test, so\n                  // start from `true` and AND-in a field-vs-literal test for\n                  // every literal element (binds/wildcards add none).\n                  emit_i32_const(buf, 1)\n                  let mut __ok = 0\n                  while __ok < Array::length(tpats) {\n                    let __okk = __ok\n                    let __oload: () -> Unit = () -> {\n                      emit_local_get(buf, scrut_local)\n                      if ctx.enable_rc {\n                        emit_i64_const(buf, -2)\n                        emit_i64_and(buf)\n                      } else {\n                        ()\n                      }\n                      emit_i32_wrap_i64(buf)\n                      emit_i64_load(buf, 3, if ctx.enable_rc {\n                        8 + __okk * 8\n                      } else {\n                        __okk * 8\n                      })\n                    }\n                    emit_sub_tests(Array::get(tpats, __okk), __oload)\n                    __ok = __ok + 1\n                  }\n                },\n                _ => emit_i32_const(buf, 1)\n              }\n            }\n            emit_or_check(__cond_p)\n            emit_if_i64(buf)\n            0\n          }\n        }\n      }\n    }\n    // #cov branch: this conditional arm was taken (start of the if-then block).\n    cov_emit_branch(buf, ctx.cov)\n    let ld_arm = if ld >= 0 {\n      ld + ai + 1\n    } else {\n      -1\n    }\n    let arm_nl = if is_pctor(__cond_p) {\n      // #703/#705: the #702 dup of a matched heap field must give the binding\n      // ONE owned reference per owning consume in the arm body (see\n      // bind_match_pat's md_consume_count note). Binding is delegated to the\n      // recursive bind_match_pat so nested ctor/tuple sub-patterns bind at ANY\n      // depth — the previous inline loop stopped at depth 2, so the `v` in\n      // `Some(Some(Some(v)))` was never emitted and its use trapped codegen\n      // (resolve_local fails). Discrimination already recurses (#603/#608).\n      // ADR-0092 Phase 1: an eligible rebuild arm consumes the staged\n      // scrutinee reference up front (unique -> in-place reuse token,\n      // shared -> dup payloads + guarded release) and skips the normal\n      // borrow-bind path entirely. Every other arm compiles exactly as\n      // before, including its bind-time payload dups.\n      let __mr_ci = mr_reuse_eligible(__cond_p, __arm_body, __match_scrutinee, ctx)\n      if __mr_ci >= 0 {\n        let __mr_flag = Array::get(ctx.reuse_flag_locals, Array::length(ctx.reuse_flag_locals) - 1)\n        mr_compile_reuse_arm(buf, __arm_body, __cond_p, scrut_local, __mr_flag, Array::length(get_pctor_args(__cond_p)), __mr_ci, local_names, ctx, ld_arm, ce)\n      } else {\n        bind_match_pat(buf, scrut_local, __cond_p, true, local_names, ctx, __arm_body)\n        ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)\n      }\n    } else if is_ptuple(__cond_p) {\n      // A bare tuple arm pattern with literal siblings (`(false, n) => ..`):\n      // discrimination already tested the literals above, but the binding pass\n      // emitted nothing here, so `n` was undefined. Load the scrutinee tuple\n      // pointer and bind every reachable PBind (skipping literals/wildcards).\n      let tup_ptr = Array::length(local_names)\n      emit_local_get(buf, scrut_local)\n      emit_local_set(buf, tup_ptr)\n      Array::push(local_names, \"__cond_tup\")\n      bind_match_pat(buf, tup_ptr, __cond_p, false, local_names, ctx, __arm_body)\n      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)\n    } else {\n      ce(buf, __arm_body, local_names, nl1, ctx, ld_arm)\n    }\n    if arm_nl > max_nl {\n      max_nl = arm_nl\n    }\n    emit_else(buf)\n    ai = ai + 1\n  }\n  Array::truncate(local_names, names_len_at_match)\n  Array::truncate(ctx.ref_cell_names, ref_cells_at_match)\n  // #678: same prune before the catch-all arm's pattern binders reuse the slots.\n  int_log_reset_above(ctx, names_len_at_match)\n  agg_log_reset_above2(ctx.agg_local_slots, ctx.agg_local_exprs, names_len_at_match)\n  // #1062 follow-up: same prune for the float log -- see the analogous call\n  // above.\n  float_log_reset_above(ctx, names_len_at_match)\n  let ld_catch = if ld >= 0 {\n    ld + num_cond_arms\n  } else {\n    -1\n  }\n  let catch_nl = if catchall_idx < num_arms {\n    let __catch_arm = Array::get(__match_arms, catchall_idx)\n    let (__catch_p, __catch_body) = __catch_arm\n    0\n    // #cov branch: the catch-all (none of the conditional arms matched). Only a\n    // real decision point when there is at least one conditional arm.\n    if num_cond_arms > 0 {\n      cov_emit_branch(buf, ctx.cov)\n    } else {\n      ()\n    }\n    if is_pbind(__catch_p) {\n      let bname = get_pbind_name(__catch_p)\n      let bind_local = Array::length(local_names)\n      emit_local_get(buf, scrut_local)\n      emit_local_set(buf, bind_local)\n      Array::push(local_names, bname)\n      ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n    } else {\n      if is_pctor(__catch_p) {\n        // #705 dup note as above; recursive bind_match_pat replaces the\n        // depth-1 inline loop (same depth-3 gap as the cond arms).\n        bind_match_pat(buf, scrut_local, __catch_p, true, local_names, ctx, __catch_body)\n        ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n      } else {\n        if is_ptuple(__catch_p) {\n          let ptr_local2 = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_local_set(buf, ptr_local2)\n          Array::push(local_names, \"__tup_ptr2\")\n          // Recursive bind (was a depth-2 inline loop; nested ctor elements\n          // inside the tuple were never bound).\n          bind_match_pat(buf, ptr_local2, __catch_p, false, local_names, ctx, __catch_body)\n          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n        } else {\n          match __catch_p {\n            PStruct(__sname, __sfields) => {\n              // An irrefutable struct pattern `S::{ x, y }` as the catch-all arm:\n              // bind every field by name from the scrutinee struct pointer.\n              let __sp_ptr = Array::length(local_names)\n              emit_local_get(buf, scrut_local)\n              emit_local_set(buf, __sp_ptr)\n              Array::push(local_names, \"__struct_ptr\")\n              bind_struct_pat(buf, __sp_ptr, __sname, __sfields, local_names, ctx, __catch_body)\n              ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n            },\n            _ => ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n          }\n        }\n      }\n    }\n  } else {\n    bytebuf_push(buf, 0)\n    0\n  }\n  if catch_nl > max_nl {\n    max_nl = catch_nl\n  }\n  let mut ci2 = 0\n  while ci2 < num_cond_arms {\n    emit_end(buf)\n    ci2 = ci2 + 1\n  }\n  while Array::length(local_names) < max_nl {\n    Array::push(local_names, \"\")\n  }\n  max_nl\n}\n")
}

