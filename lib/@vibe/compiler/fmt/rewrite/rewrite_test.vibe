import @vibe/compiler/fmt/lexer {
  lex_lossless
}
import @vibe/compiler/fmt/layout {
  format_tokens
}
import @vibe/compiler/fmt/rewrite {
  rewrite_tokens
}

test "token rewrites sort import members before layout" {
  let tokens = lex_lossless("import @vibe/core { tau, pi }\n")
  inspect(format_tokens(rewrite_tokens(tokens), 2), content = "import @vibe/core {\n  pi, tau\n}\n")
}
