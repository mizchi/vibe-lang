// Canonical token rewrites before layout. Each rewrite preserves the established pass order.

import @vibe/compiler/fmt/lexer {
  LTok,
  k_arrow,
  k_bit_or,
  k_comma,
  k_comment,
  k_double_colon,
  k_lbrace,
  k_lbracket,
  k_lparen,
  k_name,
  k_newline,
  k_none,
  k_plus,
  k_rbrace,
  k_rbracket,
  k_rparen,
  k_semicolon,
  k_type,
  k_with,
  k_ws
}

import @vibe/compiler/fmt/token_stream {
  brace_starts_import_list, find_matching_rbrace, is_handler_with, next_non_trivia_index, next_non_trivia_kind
}

/// Non-trivia tokens between a matching { open_idx .. close_idx }, split on
/// TOP-LEVEL commas into one Array[LTok] per item (trailing/empty items
/// dropped). Import items never nest brackets/braces, so a flat scan is safe.
fn split_import_items(toks: Array[LTok], start: Int, close_idx: Int) -> Array[Array[LTok]] {
  let items = []
  let mut cur = []
  let mut i = start
  while i < close_idx {
    let k = Array::get(toks, i).kind
    if k == k_comma {
      if Array::length(cur) > 0 {
        Array::push(items, cur)
      }
      cur = []
    } else if k == k_ws || k == k_newline || k == k_comment {
      ()
    } else {
      Array::push(cur, Array::get(toks, i))
    }
    i = i + 1
  }
  if Array::length(cur) > 0 {
    Array::push(items, cur)
  }
  items
}

fn span_has_comment(toks: Array[LTok], start: Int, close_idx: Int) -> Bool {
  let mut i = start
  let mut found = false
  while i < close_idx {
    if Array::get(toks, i).kind == k_comment {
      found = true
    }
    i = i + 1
  }
  found
}

/// Sort key: item tokens' texts joined by a single space (`type Foo`,
/// `Foo::Bar`, `Foo as Bar`) -- doesn't need to match the final rendered
/// spacing exactly, only to be a deterministic function of the item's own
/// tokens so re-sorting an already-sorted list is a no-op (fixpoint).
///
/// `type X` items get a `"0 "` prefix (everything else `"1 "`) so type
/// imports always sort as a group before value imports, instead of a plain
/// alphabetical sort scattering them wherever lowercase `type` (ASCII 't',
/// 116) falls relative to the uppercase-leading value/ctor names this
/// codebase's import lists otherwise consist of (after 'T'/'S'/'R'/'C', 84
/// through 67) -- i.e. after everything, not grouped with the other
/// `TaskGroup`/`TaskHandle` names it's conceptually next to. Confirmed real
/// regression, not just cosmetic: lib/@vibe/concurrent/suspend_test.vibe
/// sorted `type Channel` after `Channel::bounded` et al., and the loader
/// resolves an import list's type/value bindings order-sensitively for
/// same-named type+namespace pairs -- the reordering alone (no content
/// change) flipped a passing test to a real type-checker error far away
/// from the import list itself.
fn item_key_text(item: Array[LTok]) -> String {
  let n = Array::length(item)
  let is_type_item = n > 0 && Array::get(item, 0).kind == k_type
  let mut key = if is_type_item {
    "0 "
  } else {
    "1 "
  }
  let mut i = 0
  while i < n {
    let t = Array::get(item, i).text
    key = "\{key} \{t}"
    i = i + 1
  }
  key
}

/// Typed helper for Array::get-sourced values. Keeping the operands behind
/// String parameters preserves the #1184 relational-lowering boundary.
fn str_lt(a: String, b: String) -> Bool {
  a < b
}

/// Stable in-place insertion sort (import lists are small; O(n^2) is fine).
fn insertion_sort_items(items: Array[Array[LTok]], keys: Array[String]) -> Unit {
  let n = Array::length(items)
  let mut i = 1
  while i < n {
    let cur_item = Array::get(items, i)
    let cur_key = Array::get(keys, i)
    let mut j = i - 1
    let mut going = true
    while going && j >= 0 {
      if str_lt(cur_key, Array::get(keys, j)) {
        Array::set(items, j + 1, Array::get(items, j))
        Array::set(keys, j + 1, Array::get(keys, j))
        j = j - 1
      } else {
        going = false
      }
    }
    Array::set(items, j + 1, cur_item)
    Array::set(keys, j + 1, cur_key)
    i = i + 1
  }
}

/// Rewrites every import/export symbol-list `{ .. }` in toks to list its
/// items in sorted order. Skips (copies through verbatim) any list containing
/// a comment, 0, or 1 items -- nothing meaningful to reorder, and dropping a
/// comment while reordering would lose it (item tokens carry no trivia).
fn reorder_import_lists(toks: Array[LTok]) -> Array[LTok] {
  let out = []
  let n = Array::length(toks)
  let mut i = 0
  while i < n {
    let k = Array::get(toks, i).kind
    if k == k_lbrace && brace_starts_import_list(toks, i) {
      let close = find_matching_rbrace(toks, i)
      if close < 0 {
        Array::push(out, Array::get(toks, i))
        i = i + 1
      } else if span_has_comment(toks, i + 1, close) {
        let mut j = i
        while j <= close {
          Array::push(out, Array::get(toks, j))
          j = j + 1
        }
        i = close + 1
      } else {
        let items = split_import_items(toks, i + 1, close)
        let m = Array::length(items)
        if m <= 1 {
          let mut j = i
          while j <= close {
            Array::push(out, Array::get(toks, j))
            j = j + 1
          }
          i = close + 1
        } else {
          let keys = []
          let mut ii = 0
          while ii < m {
            Array::push(keys, item_key_text(Array::get(items, ii)))
            ii = ii + 1
          }
          insertion_sort_items(items, keys)
          Array::push(out, Array::get(toks, i))
          let mut jj = 0
          while jj < m {
            if jj > 0 {
              Array::push(out, LTok::{
                kind: k_comma,
                text: ","
              })
            }
            let item = Array::get(items, jj)
            let mut kk = 0
            let item_n = Array::length(item)
            while kk < item_n {
              Array::push(out, Array::get(item, kk))
              kk = kk + 1
            }
            jj = jj + 1
          }
          Array::push(out, Array::get(toks, close))
          i = close + 1
        }
      }
    } else {
      Array::push(out, Array::get(toks, i))
      i = i + 1
    }
  }
  out
}

fn handler_arm_starts_at(toks: Array[LTok], start: Int, close: Int) -> Bool {
  if start < 0 || start >= close || Array::get(toks, start).kind != k_name {
    false
  } else {
    let mut paren = 0
    let mut bracket = 0
    let mut i = start
    let mut result = false
    let mut going = true
    while going && i < close {
      let k = Array::get(toks, i).kind
      if k == k_lparen {
        paren = paren + 1
      } else if k == k_rparen {
        paren = paren - 1
      } else if k == k_lbracket {
        bracket = bracket + 1
      } else if k == k_rbracket {
        bracket = bracket - 1
      } else if paren == 0 && bracket == 0 && k == k_arrow {
        result = true
        going = false
      } else if paren == 0 && bracket == 0 &&
      (k == k_semicolon || k == k_comma || k == k_newline || k == k_rbrace) {
        going = false
      }
      i = i + 1
    }
    result
  }
}

fn handler_arm_name_is_constructor(name: String) -> Bool {
  if String::length(name) == 0 {
    false
  } else {
    let first = String::char_code_at(name, 0)
    first >= 'A' && first <= 'Z'
  }
}

fn handler_has_unsupported_pattern(toks: Array[LTok], open_idx: Int, close_idx: Int) -> Bool {
  let mut i = open_idx + 1
  let mut brace = 1
  let mut paren = 0
  let mut bracket = 0
  let mut arm_start = true
  let mut before_arrow = true
  let mut result = false
  while !result && i < close_idx {
    let tok = Array::get(toks, i)
    let k = tok.kind
    if k == k_lbrace {
      brace = brace + 1
    } else if k == k_rbrace {
      brace = brace - 1
    } else if brace == 1 && k == k_lparen {
      paren = paren + 1
    } else if brace == 1 && k == k_rparen {
      paren = paren - 1
    } else if brace == 1 && k == k_lbracket {
      bracket = bracket + 1
    } else if brace == 1 && k == k_rbracket {
      bracket = bracket - 1
    } else if brace == 1 && paren == 0 && bracket == 0 && arm_start &&
    k != k_ws && k != k_newline && k != k_comment {
      if k != k_name || !handler_arm_name_is_constructor(tok.text) {
        result = true
      } else if next_non_trivia_kind(toks, i) == k_double_colon {
        // #2254 review: a `::` after the arm head means either an explicit
        // qualifier (`Other::Op` -- the legacy parser DROPS it and
        // dispatches on the header effect, measured, so carrying it into
        // the qualified set changes which effect the arm handles) or a
        // struct pattern (`Op::{ value }` -- parse_qualified_handle_arm
        // accepts only a constructor pattern, so the rewrite would not
        // parse). Both migrate wrong; keep the legacy handler intact.
        result = true
      }
      arm_start = false
    } else if brace == 1 && paren == 0 && bracket == 0 && before_arrow && k == k_bit_or {
      result = true
    } else if brace == 1 && paren == 0 && bracket == 0 && k == k_arrow {
      before_arrow = false
    } else if brace == 1 && paren == 0 && bracket == 0 &&
    (k == k_semicolon || k == k_comma || k == k_newline) {
      arm_start = true
      before_arrow = true
    }
    i = i + 1
  }
  result
}

/// ADR-0102 migration fix-it:
///
///   handle { body } with E { Op(x) => arm }
///   -> handle { body } with { E::Op(x) => arm }
///
/// This is deliberately a lossless-token pre-pass so it remains available
/// after the parser eventually rejects the legacy spelling. It only rewrites
/// a `with` whose preceding balanced block is introduced by `handle`.
fn normalize_legacy_handler_headers(toks: Array[LTok]) -> Array[LTok] {
  let out = Array::slice([LTok::{ kind: k_none, text: "" }], 0, 0)
  let n = Array::length(toks)
  let mut i = 0
  while i < n {
    let t = Array::get(toks, i)
    let effect_start = if t.kind == k_with && is_handler_with(toks, i) {
      next_non_trivia_index(toks, i)
    } else {
      -1
    }
    if effect_start >= 0 && Array::get(toks, effect_start).kind == k_name {
      let mut arm_open = effect_start + 1
      let mut bracket_depth = 0
      while arm_open < n &&
      !(Array::get(toks, arm_open).kind == k_lbrace && bracket_depth == 0) {
        let k = Array::get(toks, arm_open).kind
        if k == k_lbracket {
          bracket_depth = bracket_depth + 1
        } else if k == k_rbracket {
          bracket_depth = bracket_depth - 1
        }
        arm_open = arm_open + 1
      }
      let arm_close = if arm_open < n {
        find_matching_rbrace(toks, arm_open)
      } else {
        -1
      }
      if arm_close < 0 {
        Array::push(out, t)
        i = i + 1
      } else if handler_has_unsupported_pattern(toks, arm_open, arm_close) {
        // A qualified handler arm currently accepts one constructor pattern.
        // Keep the whole legacy handler intact for wildcard, literal, or-pattern,
        // and other unsupported arms instead of producing invalid source.
        let mut j = i
        while j <= arm_close {
          Array::push(out, Array::get(toks, j))
          j = j + 1
        }
        i = arm_close + 1
      } else {
        Array::push(out, t)
        Array::push(out, LTok::{ kind: k_ws, text: " " })
        Array::push(out, Array::get(toks, arm_open))
        // Relocate header trivia inside the canonical handler set. The effect
        // name and optional type arguments become arm qualifiers, but comments
        // around them must survive this lossless migration pass.
        let mut h = i + 1
        while h < arm_open {
          let ht = Array::get(toks, h)
          if ht.kind == k_ws || ht.kind == k_newline || ht.kind == k_comment {
            Array::push(out, ht)
          }
          h = h + 1
        }
        let mut j = arm_open + 1
        let mut brace_depth = 1
        let mut arm_start = true
        while j < arm_close {
          let cur = Array::get(toks, j)
          if arm_start && cur.kind != k_ws && cur.kind != k_newline &&
          cur.kind != k_comment && handler_arm_starts_at(toks, j, arm_close) {
            // An arm head followed by `::` never reaches this loop --
            // handler_has_unsupported_pattern keeps those handlers legacy
            // (#2254 review) -- so every arm here takes the header qualifier.
            let mut q = effect_start
            while q < arm_open {
              let qt = Array::get(toks, q)
              if qt.kind != k_ws && qt.kind != k_newline && qt.kind != k_comment {
                Array::push(out, qt)
              }
              q = q + 1
            }
            Array::push(out, LTok::{ kind: k_double_colon, text: "::" })
            arm_start = false
          }
          Array::push(out, cur)
          if cur.kind == k_lbrace {
            brace_depth = brace_depth + 1
          } else if cur.kind == k_rbrace {
            brace_depth = brace_depth - 1
          } else if brace_depth == 1 && (cur.kind == k_semicolon || cur.kind == k_comma) {
            arm_start = true
          } else if cur.kind == k_newline && brace_depth == 1 {
            let candidate = next_non_trivia_index(toks, j)
            if candidate >= 0 && handler_arm_starts_at(toks, candidate, arm_close) {
              arm_start = true
            }
          }
          j = j + 1
        }
        Array::push(out, Array::get(toks, arm_close))
        i = arm_close + 1
      }
    } else {
      Array::push(out, t)
      i = i + 1
    }
  }
  out
}

/// #1429: rewrite a braced effect row into the braceless spelling.
///
///   with { A, B }  ->  with A + B
///   with { }       ->  with ()
///
/// This runs as a token pre-pass rather than as a rule inside the emitter,
/// which is what makes it safe to apply to the whole tree: it can only ever
/// see real `with` and `{` TOKENS, so every occurrence of the TEXT `with {`
/// that lives inside a string literal in the compiler's own sources (the
/// checker's test-input corpora, and the diagnostic strings that render an
/// effect SET as `missing { .. }` / `requires { .. }`) is structurally
/// untouchable. A textual rewrite would have corrupted every one of them.
///
/// Idempotent: an already-converted row has a name or `(` after `with`, not
/// `{`, so a second pass leaves it alone. `handle .. with E { arms }` is also
/// unaffected -- that `with` is followed by the effect NAME, and the brace it
/// eventually reaches belongs to the handler arms.
///
/// This pass OUTLIVES the migration it was written for. The parser retired the
/// braced branch once the tree was converted (parser_base.vibe's
/// parse_effect_row), so `with { A, B }` is now a parse error -- but this is a
/// TOKEN pre-pass, not a parse, so it still converts such source. That is what
/// makes `vibe fmt` the fix-it the parser's error message points at, for code
/// written against an older vibe.
fn normalize_effect_rows(toks: Array[LTok]) -> Array[LTok] {
  let out = Array::slice([LTok::{ kind: k_none, text: "" }], 0, 0)
  let n = Array::length(toks)
  let mut i = 0
  while i < n {
    let t = Array::get(toks, i)
    if t.kind == k_with && next_non_trivia_kind(toks, i) == k_lbrace && !is_handler_with(toks, i) {
      Array::push(out, t)
      // Find the row's `{` and its matching `}` (rows do not nest braces).
      let mut open_i = i + 1
      while Array::get(toks, open_i).kind != k_lbrace {
        open_i = open_i + 1
      }
      let mut close_i = open_i + 1
      while close_i < n && Array::get(toks, close_i).kind != k_rbrace {
        close_i = close_i + 1
      }
      // Is there any code token between the braces?
      let mut has_item = false
      let mut scan = open_i + 1
      while scan < close_i {
        let sk = Array::get(toks, scan).kind
        if sk != k_ws && sk != k_newline && sk != k_comment {
          has_item = true
        }
        scan = scan + 1
      }
      if has_item {
        // Drop both braces; every top-level comma becomes `+`.
        let mut j = open_i + 1
        while j < close_i {
          let inner = Array::get(toks, j)
          if inner.kind == k_comma {
            Array::push(out, LTok::{
              kind: k_plus,
              text: "+"
            })
          } else {
            Array::push(out, inner)
          }
          j = j + 1
        }
      } else {
        Array::push(out, LTok::{
          kind: k_lparen,
          text: "("
        })
        Array::push(out, LTok::{
          kind: k_rparen,
          text: ")"
        })
      }
      i = close_i + 1
    } else {
      Array::push(out, t)
      i = i + 1
    }
  }
  out
}

/// #1461: rewrite the retired effect label `Error` to `Exception` inside effect
/// ROWS, at the token level.
///
/// This is the fix-it the parser's retirement message points at, and it exists
/// for the same reason `normalize_effect_rows` above does: the parser rejects
/// the old spelling, so only a pass that never parses can convert source
/// written against an older vibe.
///
/// Runs AFTER `normalize_effect_rows` so it also catches labels freed from a
/// braced row in the same format: `with { Error, Fs }` has already become
/// `with Exception + Fs` by the time this sees it.
///
/// Row position is recognized structurally rather than by tracking the row
/// grammar: a label is renamed only where a row ITEM can begin -- directly
/// after `with`, after the contextual `allows`, or after a `+` -- skipping
/// trivia. That is deliberately narrower than the real grammar and it is what
/// keeps the pass safe. `Error` is still a live TYPE name (the throwable trait,
/// `impl Error for ..`), and none of its uses sit in any of those three
/// positions; a textual rewrite, or one that renamed every `Error` token,
/// would have corrupted all of them.
fn normalize_retired_effect_labels(toks: Array[LTok]) -> Array[LTok] {
  let out = Array::slice([LTok::{ kind: k_none, text: "" }], 0, 0)
  let n = Array::length(toks)
  let mut i = 0
  let mut item_start = false
  while i < n {
    let t = Array::get(toks, i)
    if item_start && t.kind == k_name && t.text == "Error" {
      Array::push(out, LTok::{
        kind: k_name,
        text: "Exception"
      })
    } else {
      Array::push(out, t)
    }
    if t.kind == k_ws || t.kind == k_newline || t.kind == k_comment {
      // Trivia does not end an item position -- `with\n  Error` is still a row.
      ()
    } else {
      item_start = t.kind == k_with || t.kind == k_plus || (t.kind == k_name && t.text == "allows")
    }
    i = i + 1
  }
  out
}

export fn rewrite_tokens(toks: Array[LTok]) -> Array[LTok] {
  normalize_retired_effect_labels(normalize_effect_rows(normalize_legacy_handler_headers(reorder_import_lists(toks))))
}
