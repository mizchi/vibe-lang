name = @vibe/compiler/fmt
version = 0.0.1
description =
  #|@vibe/compiler/fmt — the CST-token formatter behind
deps = {}

generated_hash =

// @vibe/compiler/fmt — the CST-token formatter behind
// `scripts/vibe_fmt.sh` (#594/#628): re-renders a source file from its
// token stream with canonical spacing, preserving comments and layout
// decisions recorded in the tokens. COMPILER-INTERNAL contract batch 2
// (ADR-0070 Phase 3, #897).
//
// Unlike the other compiler-internal packages this one is NOT a row in
// compiler_sources_manifest.tsv — it is not compiled into the compiler.
// Its only consumer is lib/@vibe/cli/fmt_entry.vibe, FS-compiled on demand
// by scripts/vibe_fmt.sh (which references fmt/format.vibe by path for its
// mtime staleness check only). The package never had an index.vibe — the
// implementation was always the named file format.vibe (no rename needed)
// and the entry imported it directly; that direct cross-package impl
// import is retargeted to this facade.
//
// The whole surface is two fns over String — no types, no value bindings,
// no `version` binding (compiler-internal package). Everything else in
// format.vibe (the token classifier tables, spacing rules, path-mode
// tracker, the .vpkg header splitter/writer) is private and intentionally
// undeclared.

fn format_script(src: String) -> String
fn format_vpkg(src: String) -> String
fn format_source(path: String, src: String) -> String
fn source_header_end(src: String) -> Int
