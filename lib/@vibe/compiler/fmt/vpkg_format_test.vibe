//# Imports

import ./format.vibe {
  format_script, format_source, format_vpkg
}

//# Tests
// #1435: the `.vpkg` formatter. The header is NOT vibe syntax, so the guard
// that matters most is #3 below -- `name = @vibe/parser` must survive
// verbatim, where format_script would render it `name = @vibe / parser`.

test "vpkg: a canonical header is a fixpoint" {
  let src = "name = @vibe/parser\nversion = 0.1.0\ndescription =\n  #|the parser\ndeps = {\n  @vibe/ast : 0.1.0\n}\n\ngenerated_hash =\n\n// doc\nfn lex(src: String) -> Int\n"
  assert(format_vpkg(src) == src)
}

test "vpkg: key order, value spacing and the generated_hash blank are normalized" {
  let src = "version = 0.1.0\nname =    @vibe/parser\ngenerated_hash =\ndeps = {}\n\nfn f() -> Int\n"
  let want = "name = @vibe/parser\nversion = 0.1.0\ndeps = {}\n\ngenerated_hash =\n\nfn f() -> Int\n"
  assert(format_vpkg(src) == want)
}

test "vpkg: a key the loader would not recognize is left completely alone" {
  // scan_package_header matches the exact spelling `name =`, so `name  =`
  // and `nmae =` are not directives to the loader either. Formatting them
  // as declarations would rewrite `@vibe/parser` to `@vibe / parser`.
  let loose = "name  = @vibe/parser\nversion = 0.1.0\n\ngenerated_hash =\n\nfn f() -> Int\n"
  assert(format_vpkg(loose) == loose)
  let typo = "nmae = @vibe/parser\nversion = 0.1.0\n\ngenerated_hash =\n\nfn f() -> Int\n"
  assert(format_vpkg(typo) == typo)
}

test "vpkg: the package reference in the header is never tokenized" {
  // format_script would split `@vibe/parser` on `/` and space the operator:
  // this is the whole reason .vpkg needs its own formatter.
  let src = "name = @vibe/parser\nversion = 0.1.0\n\ngenerated_hash =\n\nfn f() -> Int\n"
  let out = format_vpkg(src)
  assert(out == src)
  assert(format_script(src) != src)
}

test "vpkg: the declaration region still goes through format_script" {
  // The declarations are ordinary bodyless vibe, so the layout pass spaces
  // them the way it spaces any other source.
  let src = "name = @vibe/x\nversion = 0.0.1\n\ngenerated_hash =\n\nfn f(x:Int)->Int\n"
  let want = "name = @vibe/x\nversion = 0.0.1\n\ngenerated_hash =\n\nfn f(x: Int) -> Int\n"
  assert(format_vpkg(src) == want)
}

test "vpkg: deps entries are sorted and re-spaced" {
  let src = "name = @vibe/x\nversion = 0.0.1\ndeps = {\n  @vibe/zzz:0.0.1\n  @vibe/aaaa   :   0.2.0\n}\n\ngenerated_hash =\n\nfn f() -> Int\n"
  let want = "name = @vibe/x\nversion = 0.0.1\ndeps = {\n  @vibe/aaaa : 0.2.0\n  @vibe/zzz : 0.0.1\n}\n\ngenerated_hash =\n\nfn f() -> Int\n"
  // Also pins the comparator: plain String `<` is length-first, which would
  // order the shorter `@vibe/zzz` first (see str_lt in format.vibe).
  assert(format_vpkg(src) == want)
}

test "vpkg: description continuation lines keep their text and take a 2-space indent" {
  let src = "name = @vibe/x\nversion = 0.0.1\ndescription =\n#|first  line\n      #|  second\n\ngenerated_hash =\n\nfn f() -> Int\n"
  let want = "name = @vibe/x\nversion = 0.0.1\ndescription =\n  #|first  line\n  #|  second\n\ngenerated_hash =\n\nfn f() -> Int\n"
  assert(format_vpkg(src) == want)
}

test "vpkg: the blank line between header and declarations is normalized to one" {
  let src = "name = @vibe/x\nversion = 0.0.1\n\ngenerated_hash =\n\n\n\nfn f() -> Int\n"
  let want = "name = @vibe/x\nversion = 0.0.1\n\ngenerated_hash =\n\nfn f() -> Int\n"
  assert(format_vpkg(src) == want)
}

test "vpkg: a file with no header is plain vibe" {
  // The fixtures/contract_* packages carry no header at all.
  let src = "// a contract with no header\nfn f() -> Int with { Error }\n"
  assert(format_vpkg(src) == format_script(src))
}

test "vpkg: a comment block after the header belongs to the declarations" {
  // Comments do not end the header scan (scan_package_header treats them as
  // neutral), so the boundary must be the last DIRECTIVE line -- otherwise
  // the package's doc comment would be swallowed into the header and lost.
  let src = "name = @vibe/x\nversion = 0.0.1\n\ngenerated_hash =\n\n// package doc\n// second line\nfn f() -> Int\n"
  assert(format_vpkg(src) == src)
}

test "vpkg: an unterminated deps block is left completely alone" {
  // The loader rejects this file anyway. A formatter that guessed here
  // would run the header scan to EOF and delete every declaration.
  let src = "name = @vibe/x\nversion = 0.0.1\ndeps = {\n  @vibe/ast : 0.0.1\n\nfn f() -> Int\n"
  assert(format_vpkg(src) == src)
}

test "vpkg: a deps entry with no colon is left completely alone" {
  let src = "name = @vibe/x\nversion = 0.0.1\ndeps = {\n  @vibe/ast 0.0.1\n}\n\ngenerated_hash =\n\nfn f() -> Int\n"
  assert(format_vpkg(src) == src)
}

test "vpkg: formatting is idempotent" {
  let src = "version = 0.1.0\nname = @vibe/parser\ndeps = {\n  @vibe/zzz:0.0.1\n  @vibe/aaaa:0.2.0\n}\ngenerated_hash =\n\nfn f() -> Int with { Error }\n"
  let once = format_vpkg(src)
  assert(format_vpkg(once) == once)
}

test "a canonical handler set is a fixpoint" {
  let src = "handle { risky() } with { Exception::Throw(_) => 99 }\n"
  let got = format_script(src)
  assert(String::contains(got, "with {"))
  assert(String::contains(got, "Exception::Throw(_) => 99"))
  assert(format_script(got) == got)
}

test "format_source dispatches on the .vpkg extension" {
  let src = "name = @vibe/parser\nversion = 0.1.0\n\ngenerated_hash =\n\nfn f() -> Int\n"
  assert(format_source("lib/@vibe/parser/index.vpkg", src) == format_vpkg(src))
  // #2253 round 6: a plain .vibe whose leading lines are loader directives
  // keeps that head VERBATIM (it is not vibe syntax -- format_script would
  // mangle it) and formats only the body. This assertion used to demand
  // format_script over the whole file, i.e. the mangling.
  let head = "name = @vibe/parser\nversion = 0.1.0\n\ngenerated_hash =\n"
  let body = "\nfn f() -> Int\n"
  assert(format_source("lib/@vibe/parser/lexer.vibe", src) == String::concat(head, format_script(body)))
  // A headerless .vibe still formats whole.
  assert(format_source("lib/@vibe/parser/lexer.vibe", "fn f() -> Int\n") == format_script("fn f() -> Int\n"))
  // A path too short to carry the extension must not index out of bounds.
  assert(format_source("x", "fn f() -> Int\n") == "fn f() -> Int\n")
  // A header the .vibe lane keeps verbatim is canonicalized on the .vpkg
  // lane, so the two paths disagree on it -- the canonical `src` above
  // reads the same through either and cannot tell which one ran.
  let loose = "version = 0.1.0\nname = @vibe/parser\n\ngenerated_hash =\n\nfn f() -> Int\n"
  assert(format_source("lib/@vibe/parser/index.vpkg", loose) == format_vpkg(loose))
  assert(format_source("lib/@vibe/parser/lexer.vibe", loose) == loose)
  // A head the header scanner cannot classify leaves the file untouched,
  // body included.
  let unclosed = "deps = {\nfn  f()  ->  Int\n"
  assert(format_source("lib/@vibe/parser/lexer.vibe", unclosed) == unclosed)
  assert(format_script(unclosed) != unclosed)
}

test "#2676: a require line's from clause survives formatting, in canonical position" {
  let pin = "#pkg:sha1:0000000000000000000000000000000000000000"
  let canonical = String::concat("name = @local/app\nversion = 0.1.0\ndeps = {\n  @acme/json : 1.2.0\n}\nrequire @acme/json 1.2.0 = ", String::concat(pin, " from github:acme/json@0123abc\n\ngenerated_hash =\n"))
  assert(format_vpkg(canonical) == canonical)
  let loose = String::concat("version = 0.1.0\nrequire   @acme/json  1.2.0  =  ", String::concat(pin, "  from  github:acme/json@0123abc\nname = @local/app\ndeps = {\n  @acme/json : 1.2.0\n}\n\ngenerated_hash =\n"))
  assert(format_vpkg(loose) == canonical)
}
