import @vibe/compiler/fmt/lexer {
  lex_lossless
}

test "lossless tokens retain comments whitespace and UTF-8 text" {
  let source = "// 日本語\nlet  value = 123\n"
  let tokens = lex_lossless(source)
  let mut reconstructed = ""
  let mut i = 0
  while i < Array::length(tokens) {
    reconstructed = String::concat(reconstructed, Array::get(tokens, i).text)
    i = i + 1
  }
  inspect(reconstructed, content = "// 日本語\nlet  value = 123\n")
}
