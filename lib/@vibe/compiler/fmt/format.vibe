//# vibe source formatter (port of the retired host `src/parser/format.mbt`)
//#
//# Faithful port of the CST-token-stream formatter. A lossless lexer turns
//# source into a flat token stream (including whitespace / newline / comment
//# trivia), and `format_tokens` walks that stream deciding spacing, newlines and
//# indentation purely from token kinds and adjacency — exactly mirroring the
//# host formatter so the existing (host-formatted) codebase is a fixpoint.
//#
//# Kinds are Int constants; -1 (`k_none`) is the "no token" sentinel used where
//# the host used `SyntaxKind?::None`. Token texts use "" as the none sentinel.

//# Token kind constants

let k_none = -1
let k_eof = 0
let k_error = 1
let k_ws = 2
let k_newline = 3
let k_comment = 4
let k_name = 10
let k_int = 11
let k_float = 12
let k_string = 13
let k_string_interp = 14
let k_char = 15
let k_bool = 16
let k_hash_ref = 17
let k_let = 20
let k_import = 21
let k_use = 22
let k_declare = 23
let k_test = 24
let k_if = 25
let k_else = 26
let k_match = 27
let k_record = 28
let k_for = 30
let k_in = 31
let k_with = 32
let k_is = 33
let k_derive = 34
let k_fn = 35
let k_rec = 36
let k_type = 37
let k_enum = 38
let k_while = 39
let k_loop = 40
let k_bench = 41

// #819: `example` is its own token kind, not an identifier. Without it the
// keyword falls through to k_ident, is_keyword_kind is false, and needs_space
// emits `example"name"` -- the same class of glue defect the k_handle/k_return
// comment below records.
let k_example = 103
let k_mut = 42
let k_raise = 43
let k_yield = 44
let k_handle = 45
let k_break = 46
let k_continue = 47
let k_return = 48
let k_export = 49
let k_from = 50
let k_as = 51
let k_struct = 52
let k_trait = 53
let k_impl = 54
let k_flake = 55
let k_alias = 56
let k_arrow = 60
let k_eqeq = 61
let k_eq = 62
let k_minus_eq = 63
let k_thin_arrow = 64
let k_minus = 65
let k_semicolon = 66
let k_lbrace = 67
let k_rbrace = 68
let k_lparen = 69
let k_rparen = 70
let k_lbracket = 71
let k_rbracket = 72
let k_comma = 73
let k_double_colon = 74
let k_colon = 75
let k_slash_eq = 76
let k_slash = 77
let k_plus_eq = 78
let k_plus = 79
let k_star_eq = 80
let k_star = 81
let k_percent_eq = 82
let k_percent = 83
let k_neq = 84
let k_bang = 85
let k_question = 86
let k_lshift = 87
let k_lte = 88
let k_lt = 89
let k_rshift = 90
let k_gte = 91
let k_gt = 92
let k_and_and = 93
let k_bit_and = 94
let k_or_or = 95
let k_pipe_gt = 96
let k_bit_or = 97
let k_bit_xor = 98
let k_dot = 99
let k_dotdotdot = 100
let k_dotdot = 101
let k_pipe = 102

//# Container kind constants (Int)

let c_brace_block = 0
let c_brace_record = 1
let c_brace_match = 3
let c_brace_enum = 4
let c_brace_effects = 5
let c_bracket_array = 6
let c_bracket_type_args = 7
let c_bracket_index = 8
/// import/export symbol list `{ ... }` whose single-line rendering would
/// exceed max_import_list_width -- forces one item per line, like
/// c_brace_record. A short import list still uses plain c_brace_block (one
/// joined line), so this kind only exists to opt in to per-item newlines.
let c_brace_import_wrap = 9

let max_import_list_width = 140

//# TypeDeclMode constants

let decl_none = 0
let decl_type_alias = 1
let decl_enum = 2

//# Lossless lexer

struct LTok {
  kind: Int;
  text: String
}

struct LX {
  input: String;
  len: Int;
  mut pos: Int
}

fn lx_peek(lx: LX) -> Int {
  if lx.pos >= lx.len {
    -1
  } else {
    String::char_code_at(lx.input, lx.pos)
  }
}

fn lx_at(lx: LX, i: Int) -> Int {
  if i < 0 || i >= lx.len {
    -1
  } else {
    String::char_code_at(lx.input, i)
  }
}

fn is_alpha_c(c: Int) -> Bool {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

fn is_digit_c(c: Int) -> Bool {
  c >= '0' && c <= '9'
}

fn is_hex_c(c: Int) -> Bool {
  (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

fn is_alnum_c(c: Int) -> Bool {
  is_alpha_c(c) || is_digit_c(c)
}

fn is_ws_c(c: Int) -> Bool {
  c == ' ' || c == '\t'
}

fn is_ident_delim_c(c: Int) -> Bool {
  is_ws_c(c) || c == '\n' || c == '(' || c == ')' || c == '{' || c == '}' ||
  c == '[' || c == ']' || c == ',' || c == ';' || c == '=' || c == ':' ||
  c == '+' || c == '*' || c == '-' || c == '/' || c == '%' || c == '.' ||
  c == '|' || c == '!' || c == '?' || c == '<' || c == '>' || c == '&' ||
  c == '^' || c == '\''
}

/// Does the run of non-delimiter chars after pos contain `@` or `/` (a qualifier)?
fn lx_should_continue_qualified(lx: LX) -> Bool {
  let mut i = lx.pos + 1
  let mut result = false
  let mut going = true
  while going && i < lx.len {
    let ch = String::char_code_at(lx.input, i)
    if is_ident_delim_c(ch) {
      going = false
    } else if ch == '@' || ch == '/' {
      result = true
      going = false
    } else {
      i = i + 1
    }
  }
  result
}

/// Lex an identifier run starting at lx.pos; returns the end position.
fn lx_ident_end(lx: LX) -> Int {
  let mut i = lx.pos
  let mut allow_qual = false
  let mut going = true
  while going && i < lx.len {
    let ch = String::char_code_at(lx.input, i)
    if is_alnum_c(ch) || ch == '_' {
      i = i + 1
    } else if ch == '.' {
      if allow_qual {
        i = i + 1
      } else {
        going = false
      }
    } else if ch == '#' || ch == '?' || ch == '~' || ch == '@' {
      if ch == '@' {
        allow_qual = true
      }
      i = i + 1
    } else if ch == '/' {
      // peek qualified continuation from position i
      let saved = lx.pos
      lx.pos = i
      let cont = allow_qual || lx_should_continue_qualified(lx)
      lx.pos = saved
      if cont {
        allow_qual = true
        i = i + 1
      } else {
        going = false
      }
    } else if ch == '-' {
      if allow_qual {
        i = i + 1
      } else {
        going = false
      }
    } else {
      going = false
    }
  }
  i
}

fn keyword_kind_for(text: String, lx: LX) -> Int {
  if text == "let" {
    k_let
  }
  else if text == "import" {
    k_import
  }
  else if text == "use" {
    k_use
  }
  else if text == "declare" {
    k_declare
  }
  else if text == "test" {
    k_test
  }
  else if text == "example" {
    k_example
  }
  else if text == "if" {
    k_if
  }
  else if text == "else" {
    k_else
  }
  else if text == "match" {
    k_match
  }
  else if text == "record" {
    k_record
  }
  else if text == "for" {
    k_for
  }
  else if text == "in" {
    k_in
  }
  else if text == "with" { k_with }
  else if text == "is" {
    k_is
  }
  else if text == "derive" {
    k_derive
  }
  else if text == "fn" {
    k_fn
  }
  else if text == "rec" {
    k_rec
  }
  else if text == "type" {
    k_type
  }
  else if text == "enum" {
    k_enum
  }
  else if text == "while" {
    k_while
  }
  else if text == "loop" {
    k_loop
  }
  else if text == "bench" {
    k_bench
  }
  else if text == "mut" {
    k_mut
  }
  else if text == "raise" {
    k_raise
  }
  else if text == "yield" {
    k_yield
  }
  else if text == "handle" {
    k_handle
  }
  else if text == "break" {
    k_break
  }
  else if text == "continue" {
    k_continue
  }
  else if text == "return" {
    k_return
  }
  else if text == "export" {
    k_export
  }
  else if text == "from" {
    k_from
  }
  else if text == "as" {
    k_as
  }
  else if text == "struct" {
    k_struct
  }
  else if text == "trait" {
    k_trait
  }
  else if text == "impl" {
    k_impl
  }
  else if text == "true" {
    k_bool
  }
  else if text == "false" {
    k_bool
  }
  else {
    k_name
  }
}

/// Is `text` a raw identifier r#foo? Returns the body or "" if not.
fn raw_ident_body(text: String) -> String {
  let n = String::length(text)
  if n < 3 {
    ""
  } else if String::char_code_at(text, 0) != 'r' || String::char_code_at(text, 1) != '#' {
    ""
  } else {
    let first = String::char_code_at(text, 2)
    if !is_alpha_c(first) {
      ""
    } else {
      let mut i = 3
      let mut ok = true
      while ok && i < n {
        let c = String::char_code_at(text, i)
        if !(is_alnum_c(c) || c == '_') {
          ok = false
        } else {
          i = i + 1
        }
      }
      if ok {
        String::substring(text, 2, n)
      } else {
        ""
      }
    }
  }
}

/// Lex a "..." string literal: returns (kind, decoded-or-raw text, end pos).
fn lx_string(lx: LX) -> LTok {
  let start = lx.pos
  lx.pos = lx.pos + 1
  // O(N) build via StringBuilder; the previous `buf/raw = String::concat(...)`
  // per char was O(L²) over the literal length (issue #366). Both are written
  // only in this loop and read once at the final LTok below.
  let buf = StringBuilder::new()
  let raw = StringBuilder::new()
  let mut has_interp = false
  let mut bad_escape = false
  let mut going = true
  while going {
    let c = lx_peek(lx)
    if c == '"' || c == -1 {
      going = false
    } else if c == '\\' {
      lx.pos = lx.pos + 1
      let n = lx_peek(lx)
      if n == '{' || n == '(' {
        has_interp = true
        let open_char = n
        let close_char = if open_char == '(' {
          ')'
        } else {
          '}'
        }
        StringBuilder::push(raw, "\\")
        StringBuilder::push(raw, String::from_char_code(open_char))
        lx.pos = lx.pos + 1
        let mut depth = 1
        let mut inner = true
        while inner {
          let ic = lx_peek(lx)
          if ic == -1 {
            inner = false
          } else if ic == open_char {
            lx.pos = lx.pos + 1
            depth = depth + 1
            StringBuilder::push(raw, String::from_char_code(ic))
          } else if ic == close_char {
            lx.pos = lx.pos + 1
            depth = depth - 1
            StringBuilder::push(raw, String::from_char_code(ic))
            if depth == 0 {
              inner = false
            }
          } else {
            lx.pos = lx.pos + 1
            StringBuilder::push(raw, String::from_char_code(ic))
          }
        }
      } else {
        let e = lx_peek(lx)
        if e == -1 {
          going = false
        } else {
          lx.pos = lx.pos + 1
          if e == '"' {
            StringBuilder::push(buf, "\"")
            StringBuilder::push(raw, "\\\"")
          } else if e == '\\' {
            StringBuilder::push(buf, "\\")
            StringBuilder::push(raw, "\\\\")
          } else if e == 'n' {
            StringBuilder::push(buf, "\n")
            StringBuilder::push(raw, "\\n")
          } else if e == 't' {
            StringBuilder::push(buf, "\t")
            StringBuilder::push(raw, "\\t")
          } else if e == 'r' {
            StringBuilder::push(buf, "\r")
            StringBuilder::push(raw, "\\r")
          } else {
            bad_escape = true
            StringBuilder::push(buf, String::from_char_code(e))
            StringBuilder::push(raw, String::concat("\\", String::from_char_code(e)))
          }
        }
      }
    } else {
      lx.pos = lx.pos + 1
      StringBuilder::push(buf, String::from_char_code(c))
      StringBuilder::push(raw, String::from_char_code(c))
    }
  }
  if lx_peek(lx) == '"' {
    lx.pos = lx.pos + 1
    if bad_escape {
      LTok::{
        kind: k_error, text: StringBuilder::freeze(buf)
      }
    } else if has_interp {
      LTok::{
        kind: k_string_interp, text: StringBuilder::freeze(raw)
      }
    } else {
      LTok::{
        kind: k_string, text: StringBuilder::freeze(buf)
      }
    }
  } else {
    let _ = start
    LTok::{
      kind: k_error, text: StringBuilder::freeze(buf)
    }
  }
}

/// Lex a raw string r"..." — no escape processing.
fn lx_raw_string(lx: LX) -> LTok {
  lx.pos = lx.pos + 1
  lx.pos = lx.pos + 1
  // O(N) build via StringBuilder; the previous `buf = String::concat(buf, c)`
  // per char was O(N²) over the raw-string length (issue #366).
  let buf = StringBuilder::new()
  let mut going = true
  while going {
    let c = lx_peek(lx)
    if c == '"' || c == -1 {
      going = false
    } else {
      lx.pos = lx.pos + 1
      StringBuilder::push(buf, String::from_char_code(c))
    }
  }
  if lx_peek(lx) == '"' {
    lx.pos = lx.pos + 1
    LTok::{
      kind: k_string, text: StringBuilder::freeze(buf)
    }
  } else {
    LTok::{
      kind: k_error, text: StringBuilder::freeze(buf)
    }
  }
}

/// Lex a 'c' char literal.
fn lx_char(lx: LX) -> LTok {
  lx.pos = lx.pos + 1
  let c = lx_peek(lx)
  if c == -1 || c == '\n' {
    LTok::{
      kind: k_error, text: "'"
    }
  } else if c == '\\' {
    lx.pos = lx.pos + 1
    let e = lx_peek(lx)
    if e == -1 {
      LTok::{
        kind: k_error, text: "'"
      }
    } else {
      let decoded = if e == 'n' {
        10
      }
      else if e == 't' {
        9
      }
      else if e == 'r' {
        13
      }
      else if e == '\'' {
        39
      }
      else if e == '\\' {
        92
      }
      else {
        -1
      }
      if decoded == -1 {
        lx.pos = lx.pos + 1
        let mut going = true
        while going {
          let p = lx_peek(lx)
          if p == '\'' || p == -1 {
            going = false
          } else {
            lx.pos = lx.pos + 1
          }
        }
        if lx_peek(lx) == '\'' {
          lx.pos = lx.pos + 1
        }
        LTok::{
          kind: k_error, text: "'"
        }
      } else {
        lx.pos = lx.pos + 1
        if lx_peek(lx) == '\'' {
          lx.pos = lx.pos + 1
          LTok::{
            kind: k_char, text: String::from_char_code(decoded)
          }
        } else {
          LTok::{
            kind: k_error, text: "'"
          }
        }
      }
    }
  } else {
    lx.pos = lx.pos + 1
    if lx_peek(lx) == '\'' {
      lx.pos = lx.pos + 1
      LTok::{
        kind: k_char, text: String::from_char_code(c)
      }
    } else {
      LTok::{
        kind: k_error, text: "'"
      }
    }
  }
}

/// Lex a #| multiline string starting at the already-detected '#'.
fn lx_multiline_string(lx: LX) -> LTok {
  // O(N) build via StringBuilder; the per-char `line` and per-line `buf` builds
  // via String::concat were each O(N²) over their length (issue #366).
  let buf = StringBuilder::new()
  let mut first_line = true
  let mut running = true
  while running {
    lx.pos = lx.pos + 1
    let line = StringBuilder::new()
    let mut inner = true
    while inner {
      let c = lx_peek(lx)
      if c == '\n' || c == -1 {
        inner = false
      } else {
        lx.pos = lx.pos + 1
        StringBuilder::push(line, String::from_char_code(c))
      }
    }
    if !first_line {
      StringBuilder::push(buf, "\n")
    }
    first_line = false
    StringBuilder::push(buf, StringBuilder::freeze(line))
    if lx_peek(lx) == '\n' {
      lx.pos = lx.pos + 1
      let saved = lx.pos
      let mut sk = true
      while sk {
        let c = lx_peek(lx)
        if c == ' ' || c == '\t' {
          lx.pos = lx.pos + 1
        } else {
          sk = false
        }
      }
      if lx_peek(lx) == '#' {
        lx.pos = lx.pos + 1
        if lx_peek(lx) == '|' {
          ()
        } else {
          lx.pos = saved
          running = false
        }
      } else {
        lx.pos = saved
        running = false
      }
    } else {
      running = false
    }
  }
  LTok::{
    kind: k_string, text: StringBuilder::freeze(buf)
  }
}

fn lx_next(lx: LX) -> LTok {
  let c = lx_peek(lx)
  if c == -1 {
    LTok::{
      kind: k_eof, text: ""
    }
  } else if is_ws_c(c) {
    let start = lx.pos
    let mut going = true
    while going {
      let ch = lx_peek(lx)
      if ch != -1 && is_ws_c(ch) {
        lx.pos = lx.pos + 1
      } else {
        going = false
      }
    }
    LTok::{
      kind: k_ws, text: String::substring(lx.input, start, lx.pos)
    }
  } else if c == '\n' {
    lx.pos = lx.pos + 1
    LTok::{
      kind: k_newline, text: "\n"
    }
  } else if c == '"' {
    lx_string(lx)
  } else if c == '\'' {
    lx_char(lx)
  } else if c == 'r' && lx.pos + 1 < lx.len && String::char_code_at(lx.input, lx.pos + 1) == '"' {
    lx_raw_string(lx)
  } else if is_alpha_c(c) {
    let start = lx.pos
    let end = lx_ident_end(lx)
    lx.pos = end
    let text = String::substring(lx.input, start, end)
    let body = raw_ident_body(text)
    if body != "" {
      LTok::{
        kind: k_name, text: body
      }
    } else {
      LTok::{
        kind: keyword_kind_for(text, lx), text: text
      }
    }
  } else if is_digit_c(c) {
    let start = lx.pos
    let after_field_dot = start >= 1 && lx_at(lx, start - 1) == '.' &&
    (start < 2 || lx_at(lx, start - 2) != '.')
    if c == '0' && lx.pos + 1 < lx.len &&
    (String::char_code_at(lx.input, lx.pos + 1) == 'x' || String::char_code_at(lx.input, lx.pos + 1) == 'X') {
      lx.pos = lx.pos + 2
      let mut going = true
      while going {
        let ch = lx_peek(lx)
        if ch != -1 && is_hex_c(ch) {
          lx.pos = lx.pos + 1
        } else {
          going = false
        }
      }
      LTok::{
        kind: k_int, text: String::substring(lx.input, start, lx.pos)
      }
    } else {
      let mut going = true
      while going {
        let ch = lx_peek(lx)
        if ch != -1 && is_digit_c(ch) {
          lx.pos = lx.pos + 1
        } else {
          going = false
        }
      }
      let mut is_float = false
      if !after_field_dot && lx_peek(lx) == '.' &&
      !(lx.pos + 1 < lx.len && String::char_code_at(lx.input, lx.pos + 1) == '.') {
        is_float = true
        lx.pos = lx.pos + 1
        let mut g2 = true
        while g2 {
          let ch = lx_peek(lx)
          if ch != -1 && is_digit_c(ch) {
            lx.pos = lx.pos + 1
          } else {
            g2 = false
          }
        }
      }
      let e = lx_peek(lx)
      if e == 'e' || e == 'E' {
        is_float = true
        lx.pos = lx.pos + 1
        let s = lx_peek(lx)
        if s == '+' || s == '-' {
          lx.pos = lx.pos + 1
        }
        let mut g3 = true
        while g3 {
          let ch = lx_peek(lx)
          if ch != -1 && is_digit_c(ch) {
            lx.pos = lx.pos + 1
          } else {
            g3 = false
          }
        }
      }
      let f = lx_peek(lx)
      if f == 'f' || f == 'F' {
        is_float = true
        lx.pos = lx.pos + 1
      }
      let text = String::substring(lx.input, start, lx.pos)
      if is_float {
        LTok::{
          kind: k_float, text: text
        }
      } else {
        LTok::{
          kind: k_int, text: text
        }
      }
    }
  } else {
    lx.pos = lx.pos + 1
    if c == '=' {
      let n = lx_peek(lx)
      if n == '>' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_arrow, text: "=>"
        }
      }
      else if n == '=' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_eqeq, text: "=="
        }
      }
      else {
        LTok::{
          kind: k_eq, text: "="
        }
      }
    } else if c == '-' {
      let n = lx_peek(lx)
      if n == '=' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_minus_eq, text: "-="
        }
      }
      else if n == '>' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_thin_arrow, text: "->"
        }
      }
      else {
        LTok::{
          kind: k_minus, text: "-"
        }
      }
    } else if c == ';' {
      LTok::{
        kind: k_semicolon, text: ";"
      }
    }
    else if c == '{' {
      LTok::{
        kind: k_lbrace, text: "{"
      }
    }
    else if c == '}' {
      LTok::{
        kind: k_rbrace, text: "}"
      }
    }
    else if c == '(' {
      LTok::{
        kind: k_lparen, text: "("
      }
    }
    else if c == ')' {
      LTok::{
        kind: k_rparen, text: ")"
      }
    }
    else if c == '[' {
      LTok::{
        kind: k_lbracket, text: "["
      }
    }
    else if c == ']' {
      LTok::{
        kind: k_rbracket, text: "]"
      }
    }
    else if c == ',' {
      LTok::{
        kind: k_comma, text: ","
      }
    }
    else if c == ':' {
      if lx_peek(lx) == ':' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_double_colon, text: "::"
        }
      }
      else {
        LTok::{
          kind: k_colon, text: ":"
        }
      }
    } else if c == '/' {
      let n = lx_peek(lx)
      if n == '=' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_slash_eq, text: "/="
        }
      }
      else if n == '/' {
        let start = lx.pos - 1
        lx.pos = lx.pos + 1
        let mut going = true
        while going {
          let ch = lx_peek(lx)
          if ch == '\n' || ch == -1 {
            going = false
          } else {
            lx.pos = lx.pos + 1
          }
        }
        LTok::{
          kind: k_comment, text: String::substring(lx.input, start, lx.pos)
        }
      } else {
        LTok::{
          kind: k_slash, text: "/"
        }
      }
    } else if c == '+' {
      if lx_peek(lx) == '=' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_plus_eq, text: "+="
        }
      }
      else {
        LTok::{
          kind: k_plus, text: "+"
        }
      }
    } else if c == '*' {
      if lx_peek(lx) == '=' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_star_eq, text: "*="
        }
      }
      else {
        LTok::{
          kind: k_star, text: "*"
        }
      }
    } else if c == '%' {
      if lx_peek(lx) == '=' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_percent_eq, text: "%="
        }
      }
      else {
        LTok::{
          kind: k_percent, text: "%"
        }
      }
    } else if c == '!' {
      if lx_peek(lx) == '=' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_neq, text: "!="
        }
      }
      else {
        LTok::{
          kind: k_bang, text: "!"
        }
      }
    } else if c == '?' {
      LTok::{
        kind: k_question, text: "?"
      }
    }
    else if c == '<' {
      let n = lx_peek(lx)
      if n == '<' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_lshift, text: "<<"
        }
      }
      else if n == '=' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_lte, text: "<="
        }
      }
      else {
        LTok::{
          kind: k_lt, text: "<"
        }
      }
    } else if c == '>' {
      let n = lx_peek(lx)
      if n == '>' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_rshift, text: ">>"
        }
      }
      else if n == '=' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_gte, text: ">="
        }
      }
      else {
        LTok::{
          kind: k_gt, text: ">"
        }
      }
    } else if c == '&' {
      if lx_peek(lx) == '&' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_and_and, text: "&&"
        }
      }
      else {
        LTok::{
          kind: k_bit_and, text: "&"
        }
      }
    } else if c == '|' {
      let n = lx_peek(lx)
      if n == '|' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_or_or, text: "||"
        }
      }
      else if n == '>' {
        lx.pos = lx.pos + 1; LTok::{
          kind: k_pipe_gt, text: "|>"
        }
      }
      else {
        LTok::{
          kind: k_bit_or, text: "|"
        }
      }
    } else if c == '^' {
      LTok::{
        kind: k_bit_xor, text: "^"
      }
    }
    else if c == '.' {
      if lx.pos + 1 < lx.len && String::char_code_at(lx.input, lx.pos) == '.' &&
      String::char_code_at(lx.input, lx.pos + 1) == '.' {
        lx.pos = lx.pos + 2
        LTok::{
          kind: k_dotdotdot, text: "..."
        }
      } else if lx.pos < lx.len && String::char_code_at(lx.input, lx.pos) == '.' {
        lx.pos = lx.pos + 1
        LTok::{
          kind: k_dotdot, text: ".."
        }
      } else {
        LTok::{
          kind: k_dot, text: "."
        }
      }
    } else if c == '#' {
      if lx_peek(lx) == '|' {
        lx.pos = lx.pos - 1
        lx_multiline_string(lx)
      } else {
        let start = lx.pos - 1
        let mut going = true
        while going {
          let ch = lx_peek(lx)
          if ch != -1 && is_alnum_c(ch) {
            lx.pos = lx.pos + 1
          } else {
            going = false
          }
        }
        LTok::{
          kind: k_hash_ref, text: String::substring(lx.input, start, lx.pos)
        }
      }
    } else if c == '@' {
      if lx.pos < lx.len && is_alpha_c(String::char_code_at(lx.input, lx.pos)) {
        let start = lx.pos - 1
        let mut going = true
        while going {
          let ch = lx_peek(lx)
          if ch != -1 && (is_alnum_c(ch) || ch == '_') {
            lx.pos = lx.pos + 1
          } else {
            going = false
          }
        }
        LTok::{
          kind: k_name, text: String::substring(lx.input, start, lx.pos)
        }
      } else {
        LTok::{
          kind: k_error, text: String::from_char_code(c)
        }
      }
    } else {
      LTok::{
        kind: k_error, text: String::from_char_code(c)
      }
    }
  }
}

fn lex_lossless(src: String) -> Array[LTok] {
  let lx = LX::{
    input: src, len: String::length(src), pos: 0
  }
  let toks = [
  ]
  let mut going = true
  while going {
    if lx.pos >= lx.len {
      going = false
    } else {
      Array::push(toks, lx_next(lx))
    }
  }
  Array::push(toks, LTok::{
    kind: k_eof, text: ""
  })
  toks
}

//# Predicate helpers (kind classification)

fn is_operator_kind(k: Int) -> Bool {
  k == k_eq || k == k_plus || k == k_minus || k == k_star || k == k_slash ||
  k == k_percent || k == k_plus_eq || k == k_minus_eq || k == k_star_eq ||
  k == k_slash_eq || k == k_percent_eq || k == k_eqeq || k == k_neq ||
  k == k_lt || k == k_lte || k == k_gt || k == k_gte || k == k_and_and ||
  k == k_or_or || k == k_arrow || k == k_thin_arrow || k == k_pipe || k == k_pipe_gt
}

fn is_keyword_kind(k: Int) -> Bool {
  k == k_let || k == k_rec || k == k_enum || k == k_type || k == k_alias ||
  k == k_import || k == k_use || k == k_declare || k == k_export || k == k_from ||
  k == k_as || k == k_test || k == k_example || k == k_bench || k == k_if || k == k_else ||
  k == k_match || k == k_record || k == k_for || k == k_in || k == k_with ||
  k == k_is || k == k_derive || k == k_fn || k == k_while || k == k_loop ||
  k == k_break || k == k_continue || k == k_mut || k == k_raise || k == k_yield ||
  k == k_struct || k == k_trait || k == k_impl || k == k_flake ||
  k == k_handle || k == k_return
  // `handle`/`return` were missing here (real corruption: `return handle {
  // .. } with Error { .. }` -- `return` immediately followed by `handle`
  // with no space between them, since needs_space's is_keyword_kind(curr)/
  // is_keyword_kind(prev) checks both fell through to false -- collapsed
  // into the single glued token `returnhandle`, which then cascaded into an
  // unrelated far-later "unexpected token: with" parse error).
}

fn is_literal_kind(k: Int) -> Bool {
  k == k_int || k == k_float || k == k_string || k == k_string_interp ||
  k == k_bool || k == k_char
}

fn is_statement_start(k: Int) -> Bool {
  k == k_let || k == k_flake || k == k_alias || k == k_import || k == k_use ||
  k == k_test || k == k_example || k == k_bench || k == k_if || k == k_while || k == k_loop ||
  k == k_match || k == k_break || k == k_continue || k == k_return ||
  k == k_raise || k == k_enum || k == k_type || k == k_struct || k == k_trait ||
  k == k_impl || k == k_export
}

fn is_index_receiver_kind(k: Int) -> Bool {
  k == k_name || k == k_rparen || k == k_rbracket || k == k_rbrace || is_literal_kind(k)
}

fn is_type_context_end(k: Int) -> Bool {
  k == k_comma || k == k_semicolon || k == k_eq || k == k_arrow ||
  k == k_lbrace || k == k_rparen || k == k_rbrace || k == k_rbracket
}

fn container_indents(c: Int) -> Bool {
  c == c_brace_block || c == c_brace_record || c == c_brace_import_wrap ||
  c == c_brace_match || c == c_brace_enum || c == c_bracket_array
}

fn container_forces_list_newlines(c: Int) -> Bool {
  c == c_brace_record || c == c_brace_match || c == c_brace_import_wrap ||
  c == c_brace_enum || c == c_bracket_array
}

fn is_ctor_name_text(text: String) -> Bool {
  if String::length(text) == 0 {
    false
  } else {
    let f = String::char_code_at(text, 0)
    f >= 'A' && f <= 'Z'
  }
}

//# Token stream queries (operate on parallel kinds/texts arrays)

fn next_non_trivia_kind(toks: Array[LTok], start: Int) -> Int {
  let mut i = start + 1
  let n = Array::length(toks)
  let mut result = k_none
  let mut going = true
  while going && i < n {
    let k = Array::get(toks, i).kind
    if k == k_ws || k == k_newline || k == k_comment {
      i = i + 1
    } else if k == k_eof {
      going = false
    } else {
      result = k
      going = false
    }
  }
  result
}

fn find_matching_rbrace(toks: Array[LTok], start: Int) -> Int {
  let n = Array::length(toks)
  if start < 0 || start >= n || Array::get(toks, start).kind != k_lbrace {
    -1
  } else {
    let mut depth = 0
    let mut i = start
    let mut result = -1
    let mut going = true
    while going && i < n {
      let k = Array::get(toks, i).kind
      if k == k_lbrace {
        depth = depth + 1
      } else if k == k_rbrace {
        depth = depth - 1
        if depth == 0 {
          result = i
          going = false
        }
      }
      if going {
        i = i + 1
      }
    }
    result
  }
}

/// #? import-list wrap: is the `{` at open_idx the item-list brace of an
/// `import <path> { .. }` / `export { .. }` / `import <path> as X only { .. }`
/// header, as opposed to some unrelated brace (a fn/match/struct-literal body,
/// or an `export enum`/`export struct`/`export effect Name { .. }` body) that
/// merely happens to follow a NAME token? A plain forward-tracked "are we
/// still in path mode" flag isn't enough here: e.g.
/// `export let f = () -> Foo { x: 1 }` never crosses a newline or another `{`
/// between `export` and the struct-literal brace, so a flag set once at
/// `export` and cleared only at the next `{`/newline would misfire on that
/// brace too.
///
/// Walking backward from `{`, a real path is a chain of name/keyword-as-name
/// segments joined by `.`/`/`/`::`, terminated by `import`/`export`/`from`.
/// The bug this guards against: `export enum Re { .. }` walked backward is
/// `Re`(name) `enum`(keyword) `export`(keyword) -- naively treating every
/// keyword as a tolerable path-segment collision (needed for real collisions
/// like `import a/is/b { .. }`, where `is` lexes as k_is not k_name) would
/// skip straight through `enum` and hit `export`, misclassifying the enum
/// body as an import list. The fix: two name/keyword segments in a row with
/// no `.`/`/`/`::` separator between them is never valid path syntax --
/// `last_was_name` tracks whether the token just consumed (closer to `{`)
/// was such a segment, and a second one immediately behind it aborts the
/// scan instead of being tolerated.
fn brace_starts_import_list(toks: Array[LTok], open_idx: Int) -> Bool {
  let mut i = open_idx - 1
  let mut going = true
  let mut result = false
  let mut last_was_name = false
  while going && i >= 0 {
    let k = Array::get(toks, i).kind
    if k == k_ws || k == k_newline || k == k_comment {
      i = i - 1
    } else if k == k_import || k == k_export {
      result = true
      going = false
      // NOTE: deliberately NOT k_from here -- unlike `import`/`export`,
      // `from` is not part of any accepted import-statement grammar in
      // lib/@vibe/parser (grep confirms no k_from/"from" handling there); the
      // formatter's own lexer still special-cases it as a keyword (vestigial,
      // presumably for an import syntax that was never implemented), so a
      // bare identifier legitimately named `from` (e.g.
      // `dlh_subst(expr, from, to)`, `if name == from { ... }`) lexes as
      // k_from instead of k_name. Treating it as an unconditional "this is an
      // import list" trigger here caused a real corruption: `if name == from
      // { ELetRec(name, v, b) }` had its `{` misdetected as an import list,
      // and reorder_import_lists's flat (nesting-blind) comma split then
      // sorted the nested call's args into `ELetRec(name, b), v`.
    } else if k == k_dot || k == k_slash || k == k_double_colon {
      last_was_name = false
      i = i - 1
    } else if k == k_as || (k == k_name && Array::get(toks, i).text == "only") {
      // `import <path> as <alias> only { .. }` (#897): `as` and the
      // contextual word `only` (an ordinary k_name to this lexer, not a
      // reserved word) are structural markers of the qualified-import
      // suffix, not path/name segments -- reset last_was_name so the
      // adjacent real names on either side (`<alias>` before `only`, the
      // path segment before `as`) don't collide with them. Without this,
      // walking backward from `{` hits `only`(name) then `<alias>`(name)
      // with no separator between, aborts before ever reaching `import`,
      // and both the sort and the >140-col wrap silently stop applying to
      // this form (Codex review on #1193).
      last_was_name = false
      i = i - 1
    } else if k == k_name || is_keyword_kind(k) {
      if last_was_name {
        going = false
      } else {
        last_was_name = true
        i = i - 1
      }
    } else {
      going = false
    }
  }
  result
}

/// Estimated single-line rendered width of the import-list interior
/// (open_idx+1 .. close_idx), joined as `item1, item2, ...` starting at
/// column base_col. Only needs to be a consistent (idempotent) function of
/// the token stream, not pixel-perfect: it drives a wrap/no-wrap threshold
/// decision, not the actual spacing (needs_space still renders the tokens).
fn import_list_width(toks: Array[LTok], open_idx: Int, close_idx: Int, base_col: Int) -> Int {
  let mut total = base_col
  let mut i = open_idx + 1
  let mut prev_kind = k_none
  let mut first_in_item = true
  while i < close_idx {
    let k = Array::get(toks, i).kind
    if k == k_ws || k == k_newline || k == k_comment {
      i = i + 1
    } else if k == k_comma {
      total = total + 2
      prev_kind = k_none
      first_in_item = true
      i = i + 1
    } else {
      let t = Array::get(toks, i).text
      let need_sp = !first_in_item && prev_kind != k_double_colon && k != k_double_colon
      total = total + (if need_sp {
        1
      } else {
        0
      }) + String::length(t)
      prev_kind = k
      first_in_item = false
      i = i + 1
    }
  }
  total
}

fn import_list_should_wrap(toks: Array[LTok], open_idx: Int, base_col: Int) -> Bool {
  let close = find_matching_rbrace(toks, open_idx)
  if close < 0 {
    false
  } else {
    import_list_width(toks, open_idx, close, base_col) > max_import_list_width
  }
}

fn find_matching_rbracket(toks: Array[LTok], start: Int) -> Int {
  let n = Array::length(toks)
  if start < 0 || start >= n || Array::get(toks, start).kind != k_lbracket {
    -1
  } else {
    let mut depth = 0
    let mut i = start
    let mut result = -1
    let mut going = true
    while going && i < n {
      let k = Array::get(toks, i).kind
      if k == k_lbracket {
        depth = depth + 1
      } else if k == k_rbracket {
        depth = depth - 1
        if depth == 0 {
          result = i
          going = false
        }
      }
      if going {
        i = i + 1
      }
    }
    result
  }
}

fn bracket_looks_like_type_params(toks: Array[LTok], start: Int, close: Int) -> Bool {
  let mut saw_name = false
  let mut i = start + 1
  let mut ok = true
  let mut going = true
  while going && i < close {
    let k = Array::get(toks, i).kind
    if k == k_ws || k == k_newline || k == k_comment || k == k_eof {
      i = i + 1
    } else if k == k_name {
      saw_name = true
      i = i + 1
    } else if k == k_comma || k == k_colon || k == k_plus || k == k_lbracket || k == k_rbracket {
      i = i + 1
    } else {
      ok = false
      going = false
    }
  }
  ok && saw_name
}

fn is_generic_param_bracket(toks: Array[LTok], start: Int) -> Bool {
  let close = find_matching_rbracket(toks, start)
  if close < 0 {
    false
  } else if !bracket_looks_like_type_params(toks, start, close) {
    false
  } else {
    let nk = next_non_trivia_kind(toks, close)
    nk == k_lparen || nk == k_name
  }
}

//# Output text rendering

fn trim_ascii_ws(text: String) -> String {
  let len = String::length(text)
  if len == 0 {
    ""
  } else {
    let mut start = 0
    let mut going = true
    while going && start < len {
      let c = String::char_code_at(text, start)
      if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
        start = start + 1
      } else {
        going = false
      }
    }
    let mut end = len
    let mut g2 = true
    while g2 && end > start {
      let c = String::char_code_at(text, end - 1)
      if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
        end = end - 1
      } else {
        g2 = false
      }
    }
    String::substring(text, start, end)
  }
}

fn write_escaped_char(c: Int, for_char: Bool) -> String {
  if c == '\n' {
    "\\n"
  }
  else if c == '\t' {
    "\\t"
  }
  else if c == '\r' {
    "\\r"
  }
  else if c == '\\' {
    "\\\\"
  }
  else if c == '"' {
    if for_char {
      "\""
    } else {
      "\\\""
    }
  }
  else if c == '\'' {
    if for_char {
      "\\'"
    } else {
      "'"
    }
  }
  else {
    String::from_char_code(c)
  }
}

fn quote_string_literal(text: String) -> String {
  // O(N) build via StringBuilder; per-char String::concat was O(L²) over the
  // string-literal length, paid when re-emitting every literal (issue #366).
  let out = StringBuilder::new()
  StringBuilder::push(out, "\"")
  let n = String::length(text)
  let mut i = 0
  while i < n {
    StringBuilder::push(out, write_escaped_char(String::char_code_at(text, i), false))
    i = i + 1
  }
  StringBuilder::push(out, "\"")
  StringBuilder::freeze(out)
}

fn quote_char_literal(text: String) -> String {
  let mut out = "'"
  if String::length(text) > 0 {
    out = String::concat(out, write_escaped_char(String::char_code_at(text, 0), true))
  }
  String::concat(out, "'")
}

fn should_escape_identifier_text(text: String) -> Bool {
  text == "let" || text == "import" || text == "use" || text == "declare" ||
  text == "test" || text == "if" || text == "else" || text == "match" ||
  text == "record" || text == "fn" || text == "rec" ||
  text == "type" || text == "enum" || text == "while" || text == "loop" ||
  text == "bench" || text == "example" || text == "mut" || text == "raise" || text == "yield" ||
  text == "break" || text == "continue" || text == "export" || text == "from" ||
  text == "as" || text == "struct" || text == "trait" || text == "impl" ||
  text == "true" || text == "false"
}

fn token_text_for_output(tok: LTok, next_kind: Int) -> String {
  let k = tok.kind
  if k == k_string {
    quote_string_literal(tok.text)
  } else if k == k_string_interp {
    String::concat("\"", String::concat(tok.text, "\""))
  } else if k == k_char {
    quote_char_literal(tok.text)
  } else if k == k_name {
    // #960 Stage 2: the `map { ... }` literal is retired, so `map` is an
    // ordinary identifier — no k_map soft keyword, no `r#` re-escaping.
    let trimmed = trim_ascii_ws(tok.text)
    if should_escape_identifier_text(trimmed) {
      String::concat("r#", trimmed)
    } else {
      trimmed
    }
  } else {
    trim_ascii_ws(tok.text)
  }
}

//# Spacing / structure decisions

fn container_kind_for_brace(prev_kind: Int) -> Int {
  if prev_kind == k_record {
    c_brace_record
  }
  else {
    c_brace_block
  }
}

fn container_kind_for_bracket(prev_kind: Int, in_type_context: Bool, in_type_decl_header: Bool, generic_hint: Bool) -> Int {
  if generic_hint {
    c_bracket_type_args
  } else if (prev_kind == k_name || prev_kind == k_rbracket) && (in_type_context || in_type_decl_header) {
    c_bracket_type_args
  } else if is_index_receiver_kind(prev_kind) {
    c_bracket_index
  } else {
    c_bracket_array
  }
}

fn should_force_newline_before(kind: Int, container_stack: Array[Int]) -> Bool {
  if kind != k_rbrace && kind != k_rbracket {
    false
  } else if Array::length(container_stack) == 0 {
    false
  } else {
    container_indents(Array::get(container_stack, Array::length(container_stack) - 1))
  }
}

fn should_start_type_context_on_colon(container_stack: Array[Int]) -> Bool {
  if Array::length(container_stack) == 0 {
    true
  } else {
    let top = Array::get(container_stack, Array::length(container_stack) - 1)
    !(top == c_brace_record)
  }
}

fn is_prefix_op(kind: Int, prev_kind: Int) -> Bool {
  if kind != k_minus && kind != k_bang {
    false
  } else if prev_kind == k_none {
    true
  } else {
    is_operator_kind(prev_kind) || is_keyword_kind(prev_kind) ||
    prev_kind == k_lparen || prev_kind == k_lbracket || prev_kind == k_lbrace ||
    prev_kind == k_comma || prev_kind == k_colon || prev_kind == k_semicolon
  }
}

fn should_insert_struct_double_colon(prev_prev_kind: Int, prev_prev_text: String, prev_kind: Int, prev_text: String, curr_kind: Int, in_type_context: Bool) -> Bool {
  if curr_kind != k_lbrace || in_type_context {
    false
  } else if prev_prev_kind == k_struct || prev_prev_kind == k_enum || prev_prev_kind == k_type {
    false
  } else if prev_prev_kind == k_trait || prev_prev_kind == k_impl || prev_prev_kind == k_for {
    // #945: `trait Greet {` / `impl Greet {` / `impl Greet for Int {` are
    // declaration headers, not struct literals — inserting `::` here
    // produced unparseable `trait Greet::{`.
    false
  } else if prev_prev_text == "effect" || prev_prev_text == "suberror" || prev_prev_text == "with" { false } else if prev_prev_kind == k_plus {
    // #1429: the tail of a braceless multi-label effect row sits directly
    // before the BODY brace -- `fn f() -> T with Error + Fs {` has prev_prev
    // `+`, prev `Fs`, curr `{`. The `with` guard above only covers the
    // single-label shape (`with Stdout {`), so without this the row's last
    // label was rewritten to `Fs::{` and the body parsed as struct-literal
    // fields: the same corruption family the k_is and k_match/k_while/k_if
    // guards below were added for. Measured on the tree-wide conversion --
    // 52 unit-test files regressed and the bundle flatten failed with
    // "expected qualified operation name after '::' in effect row".
    //
    // Cost: `a + Point { x: 1 }` no longer gets the `::` inserted for it.
    // That spelling is not valid vibe anyway (struct literals are written
    // `Point::{ .. }`), whereas `with A + B {` is now the shape of EVERY
    // multi-label row, so the trade is one-sided.
    false
  } else if prev_prev_kind == k_thin_arrow {
    false
  } else if prev_prev_kind == k_is {
    // `x is CtUnknown {` (a bare-variant pattern check) followed by an
    // unrelated `{` that opens the enclosing `if`'s body -- NOT a struct
    // literal. Confirmed real corruption: checker.vibe's `if hres_now is
    // CtUnknown {` got rewritten to `if hres_now is CtUnknown::{`, which
    // parses the block body as bogus struct-literal fields and cascades
    // into an unrelated "unexpected token" error much later in the file.
    false
  } else if prev_prev_kind == k_match || prev_prev_kind == k_while || prev_prev_kind == k_if ||
  prev_prev_kind == k_loop {
    // Same false-positive family as k_is above, pre-empted rather than
    // waiting for a real corruption to surface one keyword at a time:
    // `match SomeBareVariant {` / `while SomeFlag {` / `if SomeCond {` /
    // `loop SomeState {` all put a bare capitalized name directly before a
    // `{` that opens a match/loop/if BODY, not a struct literal.
    false
  } else if prev_kind != k_name {
    false
  } else {
    is_ctor_name_text(prev_text)
  }
}

fn needs_space(prev_prev_kind: Int, prev_kind: Int, curr_kind: Int, prev_prefix: Bool, prev_pipe: Bool, path_active: Bool) -> Bool {
  if prev_kind == k_none {
    false
  } else if prev_prefix {
    false
  } else if prev_pipe && curr_kind == k_gt {
    false
  } else if prev_kind == k_let && curr_kind == k_star {
    false
  } else if path_active && prev_kind != k_import && prev_kind != k_export && prev_kind != k_from &&
  (prev_kind == k_slash || curr_kind == k_slash || prev_kind == k_dot || curr_kind == k_dot || prev_kind == k_dotdot || curr_kind == k_dotdot) {
    // import/export path separators (`./a/b/index.vibe`, `.. / ..`) are a single
    // path token, not division/projection — no surrounding spaces (#628). The
    // space right after the `import`/`export`/`from` keyword is kept (excluded).
    false
  } else if curr_kind == k_rparen || curr_kind == k_rbracket || curr_kind == k_rbrace ||
  curr_kind == k_comma || curr_kind == k_semicolon {
    false
  } else if curr_kind == k_colon {
    false
  } else if prev_kind == k_name && curr_kind == k_name {
    true
  } else if prev_kind == k_rbracket && curr_kind == k_name {
    true
  } else if (curr_kind == k_lparen || curr_kind == k_lbracket) &&
  (prev_kind == k_name || is_literal_kind(prev_kind) || prev_kind == k_rparen || prev_kind == k_rbracket || prev_kind == k_rbrace) {
    false
  } else if curr_kind == k_lbrace &&
  (prev_kind == k_lparen || prev_kind == k_lbracket || prev_kind == k_double_colon) {
    false
  } else if prev_kind == k_lparen || prev_kind == k_lbracket {
    false
  } else if (prev_kind == k_import || prev_kind == k_export) &&
  (curr_kind == k_dot || curr_kind == k_slash) {
    true
  } else if prev_kind == k_slash && curr_kind == k_name &&
  (prev_prev_kind == k_dot || prev_prev_kind == k_import || prev_prev_kind == k_export) {
    false
  } else if prev_kind == k_dot || curr_kind == k_dot {
    false
  } else if prev_kind == k_lbrace {
    true
  } else if prev_kind == k_comma || prev_kind == k_semicolon || prev_kind == k_colon {
    true
  } else if curr_kind == k_lbrace {
    true
  } else if is_keyword_kind(curr_kind) {
    true
  } else if is_operator_kind(prev_kind) || is_operator_kind(curr_kind) {
    true
  } else if is_keyword_kind(prev_kind) {
    true
  } else {
    false
  }
}

fn spaces(n: Int) -> String {
  let mut out = ""
  let mut i = 0
  while i < n {
    out = String::concat(out, " ")
    i = i + 1
  }
  out
}

fn arr_pop_int(arr: Array[Int]) -> Int {
  let n = Array::length(arr)
  if n == 0 {
    -1
  } else {
    let v = Array::get(arr, n - 1)
    Array::truncate(arr, n - 1)
    v
  }
}

//# The core formatter

fn format_tokens(toks: Array[LTok], indent_size: Int) -> String {
  let out = [
  ]
  let mut indent = 0
  let mut pending_newlines = 0
  let container_stack = [
  ]
  let cpb_stack = [
  ]
  let cpb_bracket_stack = [
  ]
  let mut paren_depth = 0
  let mut brace_depth = 0
  let mut bracket_depth = 0
  let pm_paren = [
  ]
  let pm_brace = [
  ]
  let pm_bracket = [
  ]
  let tc_paren = [
  ]
  let tc_brace = [
  ]
  let tc_bracket = [
  ]
  let mut type_decl_header = decl_none
  let mut type_decl_rhs_active = false
  let mut saw_newline = false
  let mut line_has_content = false
  let mut prev_prev_kind = k_none
  let mut prev_prev_text = ""
  let mut prev_kind = k_none
  let mut prev_text = ""
  let mut prev_prefix = false
  let mut prev_pipe = false
  let mut prev_line_comment = false
  // #628: true while inside an import/export path region (keyword .. `{`), so
  // `/` and `.` separators are emitted without surrounding spaces.
  let mut path_active = false
  let mut i = 0
  let n = Array::length(toks)
  while i < n {
    let tok = Array::get(toks, i)
    let kind = tok.kind
    if kind == k_ws {
      i = i + 1
    } else if kind == k_comment {
      let comment_text = trim_ascii_ws(tok.text)
      if pending_newlines == 0 && line_has_content {
        pending_newlines = 1
      }
      if pending_newlines > 0 {
        let mut j = 0
        while j < pending_newlines {
          Array::push(out, "\n")
          j = j + 1
        }
        pending_newlines = 0
        Array::push(out, spaces(if indent <= 0 || indent_size <= 0 {
          0
        } else {
          indent * indent_size
        }))
        line_has_content = false
      }
      Array::push(out, comment_text)
      line_has_content = true
      prev_prev_kind = k_none
      prev_prev_text = ""
      prev_kind = k_none
      prev_text = ""
      prev_prefix = false
      prev_pipe = false
      path_active = false
      prev_line_comment = String::length(comment_text) >= 2 &&
      String::char_code_at(comment_text, 0) == '/' && String::char_code_at(comment_text, 1) == '/'
      i = i + 1
    } else if kind == k_newline {
      saw_newline = true
      if prev_line_comment {
        let max_nl = if brace_depth == 0 {
          2
        } else {
          1
        }
        if pending_newlines < max_nl {
          pending_newlines = pending_newlines + 1
        }
        prev_line_comment = false
        i = i + 1
      } else {
        let next_kind = next_non_trivia_kind(toks, i)
        let collapse_generic_break =
        (prev_kind == k_impl || prev_kind == k_eq) && next_kind == k_lbracket
        let in_effects_brace = Array::length(container_stack) > 0 &&
        Array::get(container_stack, Array::length(container_stack) - 1) == c_brace_effects
        // A newline directly inside a brace BLOCK (one statement per source
        // line) is significant even when that block sits inside an enclosing
        // call's parens (`run(() -> {`) or an array/bracket literal -- only a
        // newline inside a paren/bracket construct opened AFTER the current
        // innermost container (mid-expression line-wrapping, e.g. multi-line
        // call args) should be swallowed. Comparing against the ABSOLUTE
        // paren_depth/bracket_depth (as opposed to their value recorded when
        // the innermost container was entered, via cpb_stack/cpb_bracket_stack)
        // wrongly swallowed every statement-separating newline inside any
        // brace block nested in an outer call's argument list, collapsing the
        // whole block onto one line.
        let base_paren = if Array::length(cpb_stack) > 0 {
          Array::get(cpb_stack, Array::length(cpb_stack) - 1)
        } else {
          0
        }
        let base_bracket = if Array::length(cpb_bracket_stack) > 0 {
          Array::get(cpb_bracket_stack, Array::length(cpb_bracket_stack) - 1)
        } else {
          0
        }
        if paren_depth > base_paren || bracket_depth > base_bracket || collapse_generic_break || in_effects_brace {
          i = i + 1
        } else {
          let max_nl = if brace_depth == 0 {
            2
          } else {
            1
          }
          if pending_newlines < max_nl {
            pending_newlines = pending_newlines + 1
          }
          i = i + 1
        }
      }
    } else if kind == k_eof {
      i = i + 1
    } else {
      if kind == k_match {
        Array::push(pm_paren, paren_depth)
        Array::push(pm_brace, brace_depth)
        Array::push(pm_bracket, bracket_depth)
      }
      if saw_newline && paren_depth == 0 && brace_depth == 0 && bracket_depth == 0 &&
      is_statement_start(kind) {
        Array::truncate(tc_paren, 0)
        Array::truncate(tc_brace, 0)
        Array::truncate(tc_bracket, 0)
        type_decl_rhs_active = false
        type_decl_header = decl_none
      }
      saw_newline = false
      if pending_newlines == 0 && should_force_newline_before(kind, container_stack) {
        pending_newlines = 1
      }
      let mut dedented_before = false
      if pending_newlines > 0 {
        if kind == k_rbrace || kind == k_rbracket {
          if Array::length(container_stack) > 0 {
            let container = Array::get(container_stack, Array::length(container_stack) - 1)
            if container_indents(container) && indent > 0 {
              indent = indent - 1
              dedented_before = true
            }
          }
        }
        let mut j = 0
        while j < pending_newlines {
          Array::push(out, "\n")
          j = j + 1
        }
        pending_newlines = 0
        Array::push(out, spaces(if indent <= 0 || indent_size <= 0 {
          0
        } else {
          indent * indent_size
        }))
        prev_prev_kind = k_none
        prev_prev_text = ""
        prev_kind = k_none
        prev_text = ""
        prev_prefix = false
        prev_pipe = false
        path_active = false
        line_has_content = false
      }
      let next_kind = next_non_trivia_kind(toks, i)
      let curr_pipe = kind == k_pipe && next_kind == k_gt
      let in_type_context = Array::length(tc_paren) > 0 ||
      type_decl_header != decl_none || type_decl_rhs_active
      let in_enum_container = Array::length(container_stack) > 0 &&
      Array::get(container_stack, Array::length(container_stack) - 1) == c_brace_enum
      let enum_top_level = in_enum_container && Array::length(cpb_stack) > 0 &&
      paren_depth == Array::get(cpb_stack, Array::length(cpb_stack) - 1)
      let rendered_text = if kind == k_comma && enum_top_level {
        ";"
      } else {
        token_text_for_output(tok, next_kind)
      }
      if String::length(rendered_text) == 0 {
        i = i + 1
      } else {
        let curr_prefix = is_prefix_op(kind, prev_kind)
        let insert_double_colon = should_insert_struct_double_colon(prev_prev_kind, prev_prev_text, prev_kind, prev_text, kind, in_type_context)
        let effects_rbrace = kind == k_rbrace && Array::length(container_stack) > 0 &&
        Array::get(container_stack, Array::length(container_stack) - 1) == c_brace_effects
        if line_has_content && !insert_double_colon &&
        (effects_rbrace || needs_space(prev_prev_kind, prev_kind, kind, prev_prefix, prev_pipe, path_active)) {
          Array::push(out, " ")
        }
        if insert_double_colon {
          Array::push(out, "::")
        }
        Array::push(out, rendered_text)
        line_has_content = true
        if kind == k_type {
          type_decl_header = decl_type_alias
        } else if kind == k_enum {
          type_decl_header = decl_enum
        }
        if kind == k_colon && should_start_type_context_on_colon(container_stack) {
          Array::push(tc_paren, paren_depth)
          Array::push(tc_brace, brace_depth)
          Array::push(tc_bracket, bracket_depth)
        } else if kind == k_thin_arrow {
          Array::push(tc_paren, paren_depth)
          Array::push(tc_brace, brace_depth)
          Array::push(tc_bracket, bracket_depth)
        }
        if kind == k_lparen {
          paren_depth = paren_depth + 1
        } else if kind == k_rparen {
          if paren_depth > 0 {
            paren_depth = paren_depth - 1
          }
        }
        if kind == k_lbrace || kind == k_lbracket {
          if kind == k_lbrace {
            let is_effects_brace = prev_text == "with"
            let container = if type_decl_header == decl_enum {
              c_brace_enum
            } else if is_effects_brace {
              c_brace_effects
            } else {
              // is_match_brace
              let pml = Array::length(pm_paren)
              let is_mb = if pml == 0 {
                false
              } else if paren_depth != Array::get(pm_paren, pml - 1) ||
              brace_depth != Array::get(pm_brace, pml - 1) ||
              bracket_depth != Array::get(pm_bracket, pml - 1) {
                false
              } else {
                prev_kind != k_match && prev_kind != k_record &&
                prev_kind != k_if && prev_kind != k_else && prev_kind != k_none
              }
              if is_mb {
                let _ = arr_pop_int(pm_paren)
                let _ = arr_pop_int(pm_brace)
                let _ = arr_pop_int(pm_bracket)
                c_brace_match
              } else if brace_starts_import_list(toks, i) &&
              import_list_should_wrap(toks, i, (indent + 1) * indent_size) {
                c_brace_import_wrap
              } else {
                container_kind_for_brace(prev_kind)
              }
            }
            brace_depth = brace_depth + 1
            if type_decl_header == decl_enum {
              type_decl_header = decl_none
            }
            Array::push(container_stack, container)
            Array::push(cpb_stack, paren_depth)
            Array::push(cpb_bracket_stack, bracket_depth)
            if container_indents(container) {
              indent = indent + 1
              if pending_newlines == 0 {
                pending_newlines = 1
              }
            }
          } else {
            let generic_hint = prev_kind == k_impl || is_generic_param_bracket(toks, i)
            let container = container_kind_for_bracket(prev_kind, Array::length(tc_paren) > 0 || type_decl_rhs_active, type_decl_header != decl_none, generic_hint)
            Array::push(container_stack, container)
            Array::push(cpb_stack, paren_depth)
            Array::push(cpb_bracket_stack, bracket_depth)
            bracket_depth = bracket_depth + 1
            if container_indents(container) {
              indent = indent + 1
              if pending_newlines == 0 {
                pending_newlines = 1
              }
            }
          }
        } else if kind == k_rbrace || kind == k_rbracket {
          if kind == k_rbrace && brace_depth > 0 {
            brace_depth = brace_depth - 1
          }
          if kind == k_rbracket && bracket_depth > 0 {
            bracket_depth = bracket_depth - 1
          }
          if Array::length(container_stack) > 0 {
            let container = Array::get(container_stack, Array::length(container_stack) - 1)
            if container_indents(container) && !dedented_before && indent > 0 {
              indent = indent - 1
            }
          }
          if Array::length(container_stack) > 0 {
            if Array::length(cpb_stack) > 0 {
              let _ = arr_pop_int(cpb_stack)
            }
            if Array::length(cpb_bracket_stack) > 0 {
              let _ = arr_pop_int(cpb_bracket_stack)
            }
            let _ = arr_pop_int(container_stack)
          }
        } else if kind == k_comma || kind == k_semicolon {
          if Array::length(container_stack) > 0 && Array::length(cpb_stack) > 0 &&
          container_forces_list_newlines(Array::get(container_stack, Array::length(container_stack) - 1)) &&
          paren_depth == Array::get(cpb_stack, Array::length(cpb_stack) - 1) &&
          pending_newlines == 0 {
            pending_newlines = 1
          }
        }
        if kind == k_eq && type_decl_header == decl_type_alias {
          type_decl_header = decl_none
          type_decl_rhs_active = true
        } else if kind == k_semicolon {
          type_decl_rhs_active = false
          type_decl_header = decl_none
        }
        // maybe_end_type_context
        if Array::length(tc_paren) > 0 && is_type_context_end(kind) {
          let eff_brace = if kind == k_lbrace && brace_depth > 0 {
            brace_depth - 1
          } else {
            brace_depth
          }
          let eff_bracket = if kind == k_lbracket && bracket_depth > 0 {
            bracket_depth - 1
          } else {
            bracket_depth
          }
          let mut going = true
          while going && Array::length(tc_paren) > 0 {
            let li = Array::length(tc_paren) - 1
            if Array::get(tc_paren, li) == paren_depth &&
            Array::get(tc_brace, li) == eff_brace &&
            Array::get(tc_bracket, li) == eff_bracket {
              let _ = arr_pop_int(tc_paren)
              let _ = arr_pop_int(tc_brace)
              let _ = arr_pop_int(tc_bracket)
            } else {
              going = false
            }
          }
        }
        prev_prev_kind = prev_kind
        prev_prev_text = prev_text
        prev_kind = kind
        prev_text = tok.text
        prev_prefix = curr_prefix
        prev_pipe = curr_pipe
        prev_line_comment = false
        // #628: enter path mode on import/export; leave it at the import
        // list `{` (and any brace, harmless when already false). Deliberately
        // NOT k_from -- see the comment on the matching check in
        // brace_starts_import_list; `from` is a valid bare identifier in
        // real vibe source (no import-statement grammar uses it), so it must
        // not be treated as an import-context marker.
        if kind == k_import || kind == k_export {
          path_active = true
        } else if kind == k_lbrace {
          path_active = false
        }
        i = i + 1
      }
    }
  }
  if pending_newlines > 0 {
    let mut j = 0
    while j < pending_newlines {
      Array::push(out, "\n")
      j = j + 1
    }
  }
  String::join(out, "")
}

//# Import-list item reordering (sort each import/export symbol list
//# alphabetically). Runs as a token-array-to-token-array preprocessing pass
//# BEFORE format_tokens, so format_tokens's width/wrap decision (above) sees
//# the already-sorted item order -- sorting doesn't change the total
//# rendered width, so there's no ordering dependency between the two passes.

/// Non-trivia tokens between a matching { open_idx .. close_idx }, split on
/// TOP-LEVEL commas into one Array[LTok] per item (trailing/empty items
/// dropped). Import items never nest brackets/braces, so a flat scan is safe.
fn split_import_items(toks: Array[LTok], start: Int, close_idx: Int) -> Array[Array[LTok]] {
  let items = [
  ]
  let mut cur = [
  ]
  let mut i = start
  while i < close_idx {
    let k = Array::get(toks, i).kind
    if k == k_comma {
      if Array::length(cur) > 0 {
        Array::push(items, cur)
      }
      cur = [
      ]
    } else if k == k_ws || k == k_newline || k == k_comment {
      ()
    } else {
      Array::push(cur, Array::get(toks, i))
    }
    i = i + 1
  }
  if Array::length(cur) > 0 {
    Array::push(items, cur)
  }
  items
}

fn span_has_comment(toks: Array[LTok], start: Int, close_idx: Int) -> Bool {
  let mut i = start
  let mut found = false
  while i < close_idx {
    if Array::get(toks, i).kind == k_comment {
      found = true
    }
    i = i + 1
  }
  found
}

/// Sort key: item tokens' texts joined by a single space (`type Foo`,
/// `Foo::Bar`, `Foo as Bar`) -- doesn't need to match the final rendered
/// spacing exactly, only to be a deterministic function of the item's own
/// tokens so re-sorting an already-sorted list is a no-op (fixpoint).
///
/// `type X` items get a `"0 "` prefix (everything else `"1 "`) so type
/// imports always sort as a group before value imports, instead of a plain
/// alphabetical sort scattering them wherever lowercase `type` (ASCII 't',
/// 116) falls relative to the uppercase-leading value/ctor names this
/// codebase's import lists otherwise consist of (after 'T'/'S'/'R'/'C', 84
/// through 67) -- i.e. after everything, not grouped with the other
/// `TaskGroup`/`TaskHandle` names it's conceptually next to. Confirmed real
/// regression, not just cosmetic: lib/@vibex/concurrent/suspend_test.vibe
/// sorted `type Channel` after `Channel::bounded` et al., and the loader
/// resolves an import list's type/value bindings order-sensitively for
/// same-named type+namespace pairs -- the reordering alone (no content
/// change) flipped a passing test to a real type-checker error far away
/// from the import list itself.
fn item_key_text(item: Array[LTok]) -> String {
  let n = Array::length(item)
  let is_type_item = n > 0 && Array::get(item, 0).kind == k_type
  let mut key = if is_type_item {
    "0 "
  } else {
    "1 "
  }
  let mut i = 0
  while i < n {
    let t = Array::get(item, i).text
    key = "\{key} \{t}"
    i = i + 1
  }
  key
}

/// Work around #1184 (String `<`/`>` degrade to a length-based comparison,
/// not lexicographic, once an operand originates from Array::get): a
/// char-by-char comparator confirmed correct against that issue's repro.
/// Plain `<` is fine everywhere else in this file (only ever used on fresh
/// literals/interpolated text); this is the one place that needs to compare
/// two Array::get-sourced values.
fn str_lt(a: String, b: String) -> Bool {
  let la = String::length(a)
  let lb = String::length(b)
  let n = if la < lb {
    la
  } else {
    lb
  }
  let mut i = 0
  let mut result = -1
  while result < 0 && i < n {
    let ca = String::char_code_at(a, i)
    let cb = String::char_code_at(b, i)
    if ca < cb {
      result = 1
    }
    else if ca > cb {
      result = 2
    }
    else {
      i = i + 1
    }
  }
  if result == 1 {
    true
  } else if result == 2 {
    false
  } else {
    la < lb
  }
}

/// Stable in-place insertion sort (import lists are small; O(n^2) is fine).
fn insertion_sort_items(items: Array[Array[LTok]], keys: Array[String]) -> Unit {
  let n = Array::length(items)
  let mut i = 1
  while i < n {
    let cur_item = Array::get(items, i)
    let cur_key = Array::get(keys, i)
    let mut j = i - 1
    let mut going = true
    while going && j >= 0 {
      if str_lt(cur_key, Array::get(keys, j)) {
        Array::set(items, j + 1, Array::get(items, j))
        Array::set(keys, j + 1, Array::get(keys, j))
        j = j - 1
      } else {
        going = false
      }
    }
    Array::set(items, j + 1, cur_item)
    Array::set(keys, j + 1, cur_key)
    i = i + 1
  }
}

/// Rewrites every import/export symbol-list `{ .. }` in toks to list its
/// items in sorted order. Skips (copies through verbatim) any list containing
/// a comment, 0, or 1 items -- nothing meaningful to reorder, and dropping a
/// comment while reordering would lose it (item tokens carry no trivia).
fn reorder_import_lists(toks: Array[LTok]) -> Array[LTok] {
  let out = [
  ]
  let n = Array::length(toks)
  let mut i = 0
  while i < n {
    let k = Array::get(toks, i).kind
    if k == k_lbrace && brace_starts_import_list(toks, i) {
      let close = find_matching_rbrace(toks, i)
      if close < 0 {
        Array::push(out, Array::get(toks, i))
        i = i + 1
      } else if span_has_comment(toks, i + 1, close) {
        let mut j = i
        while j <= close {
          Array::push(out, Array::get(toks, j))
          j = j + 1
        }
        i = close + 1
      } else {
        let items = split_import_items(toks, i + 1, close)
        let m = Array::length(items)
        if m <= 1 {
          let mut j = i
          while j <= close {
            Array::push(out, Array::get(toks, j))
            j = j + 1
          }
          i = close + 1
        } else {
          let keys = [
          ]
          let mut ii = 0
          while ii < m {
            Array::push(keys, item_key_text(Array::get(items, ii)))
            ii = ii + 1
          }
          insertion_sort_items(items, keys)
          Array::push(out, Array::get(toks, i))
          let mut jj = 0
          while jj < m {
            if jj > 0 {
              Array::push(out, LTok::{
                kind: k_comma, text: ","
              })
            }
            let item = Array::get(items, jj)
            let mut kk = 0
            let item_n = Array::length(item)
            while kk < item_n {
              Array::push(out, Array::get(item, kk))
              kk = kk + 1
            }
            jj = jj + 1
          }
          Array::push(out, Array::get(toks, close))
          i = close + 1
        }
      }
    } else {
      Array::push(out, Array::get(toks, i))
      i = i + 1
    }
  }
  out
}

/// #1429: rewrite a braced effect row into the braceless spelling.
///
///   with { A, B }  ->  with A + B
///   with { }       ->  with ()
///
/// This runs as a token pre-pass rather than as a rule inside the emitter,
/// which is what makes it safe to apply to the whole tree: it can only ever
/// see real `with` and `{` TOKENS, so the 115 occurrences of the text
/// `with {` that live INSIDE string literals in the compiler's own sources
/// (checker test inputs, and the `hint: declare 'fn f(...) -> T with { .. }'`
/// diagnostic text) are structurally untouchable. A textual rewrite would
/// have corrupted every one of them.
///
/// Idempotent: an already-converted row has a name or `(` after `with`, not
/// `{`, so a second pass leaves it alone. `handle .. with E { arms }` is also
/// unaffected -- that `with` is followed by the effect NAME, and the brace it
/// eventually reaches belongs to the handler arms.
fn normalize_effect_rows(toks: Array[LTok]) -> Array[LTok] {
  let out = Array::slice([
    LTok::{
      kind: k_none, text: ""
    }
  ], 0, 0)
  let n = Array::length(toks)
  let mut i = 0
  while i < n {
    let t = Array::get(toks, i)
    if t.kind == k_with && next_non_trivia_kind(toks, i) == k_lbrace {
      Array::push(out, t)
      // Find the row's `{` and its matching `}` (rows do not nest braces).
      let mut open_i = i + 1
      while Array::get(toks, open_i).kind != k_lbrace {
        open_i = open_i + 1
      }
      let mut close_i = open_i + 1
      while close_i < n && Array::get(toks, close_i).kind != k_rbrace {
        close_i = close_i + 1
      }
      // Is there any code token between the braces?
      let mut has_item = false
      let mut scan = open_i + 1
      while scan < close_i {
        let sk = Array::get(toks, scan).kind
        if sk != k_ws && sk != k_newline && sk != k_comment {
          has_item = true
        }
        scan = scan + 1
      }
      if has_item {
        // Drop both braces; every top-level comma becomes `+`.
        let mut j = open_i + 1
        while j < close_i {
          let inner = Array::get(toks, j)
          if inner.kind == k_comma {
            Array::push(out, LTok::{
              kind: k_plus, text: "+"
            })
          } else {
            Array::push(out, inner)
          }
          j = j + 1
        }
      } else {
        Array::push(out, LTok::{
          kind: k_lparen, text: "("
        })
        Array::push(out, LTok::{
          kind: k_rparen, text: ")"
        })
      }
      i = close_i + 1
    } else {
      Array::push(out, t)
      i = i + 1
    }
  }
  out
}

export fn format_script(src: String) -> String {
  format_tokens(normalize_effect_rows(reorder_import_lists(lex_lossless(src))), 2)
}
