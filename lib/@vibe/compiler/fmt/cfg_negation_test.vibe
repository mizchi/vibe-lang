import ./format.vibe {
  format_script
}
import @vibe/parser {
  lex, parse_program_with_cfg
}

test "formatting retains both cfg polarities and reaches a fixpoint" {
  let source = "#cfg(telemetry)\nfn observe()->Int{101}\n#cfg(not(telemetry))\nfn observe()->Int{7}\n"
  let once = format_script(source)
  assert(String::contains(once, needle = "#cfg(telemetry)"))
  assert(String::contains(once, needle = "#cfg(not(telemetry))"))
  assert(String::contains(once, needle = "101"))
  assert(String::contains(once, needle = "7"))
  assert_eq(format_script(once), once)
  assert_eq(Array::length(parse_program_with_cfg(lex(once), cfg_flags = [])), 1)
  assert_eq(Array::length(parse_program_with_cfg(lex(once), cfg_flags = [
    "telemetry"
  ])), 1)
}
