name = @vibe/compiler/fmt/token_stream
version = 0.0.1
description =
  #|Read-only queries over formatter tokens. No layout or source rewriting state.
deps = {
  @vibe/compiler/fmt/lexer : 0.0.1
}

generated_hash =

fn is_operator_kind(k: Int) -> Bool
fn is_keyword_kind(k: Int) -> Bool
fn is_literal_kind(k: Int) -> Bool
fn is_statement_start(k: Int) -> Bool
fn is_index_receiver_kind(k: Int) -> Bool
fn is_type_context_end(k: Int) -> Bool
fn next_non_trivia_kind(toks: Array[LTok], start: Int) -> Int
fn find_matching_rbrace(toks: Array[LTok], start: Int) -> Int
fn prev_non_trivia_index(toks: Array[LTok], start: Int) -> Int
fn is_handler_with(toks: Array[LTok], with_pos: Int) -> Bool
fn brace_starts_import_list(toks: Array[LTok], open_idx: Int) -> Bool
fn span_has_newline(toks: Array[LTok], open_idx: Int, close_idx: Int) -> Bool
fn text_contains_newline(text: String) -> Bool
fn find_matching_rbracket(toks: Array[LTok], start: Int) -> Int
fn is_generic_param_bracket(toks: Array[LTok], start: Int) -> Bool
fn next_non_trivia_index(toks: Array[LTok], start: Int) -> Int
