import @vibe/compiler/fmt/lexer {
  lex_lossless
}
import @vibe/compiler/fmt/token_stream {
  find_matching_rbrace, prev_non_trivia_index
}

test "token queries retain nesting and skip comment trivia" {
  let tokens = lex_lossless("{ {x} } // why\ny")
  inspect(find_matching_rbrace(tokens, 0), content = "6")
  inspect(prev_non_trivia_index(tokens, 10), content = "6")
}
