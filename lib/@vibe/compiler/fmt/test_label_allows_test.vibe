//# #3154: the formatter glued a test label to a following `allows` clause,
// writing `test "label" allows Exception {` back as `test "label"allows
// Exception {`. `allows` is contextual, so the lexer hands it over as a plain
// name, and no spacing rule covered a string literal followed by a name.

//# Imports

import ./format.vibe {
  format_script
}

//# Tests

test "a test label keeps its space before allows" {
  let src = "test \"label\" allows Exception {\n  assert(true)\n}\n"
  assert_eq(format_script(src), src)
}

test "a label glued to allows is separated again" {
  let src = "test \"label\"allows Exception {\n  assert(true)\n}\n"
  assert_eq(format_script(src), "test \"label\" allows Exception {\n  assert(true)\n}\n")
}

test "a test label without allows is unchanged" {
  let src = "test \"x\" {\n  assert(true)\n}\n"
  assert_eq(format_script(src), src)
}

test "a bench label keeps its space before allows" {
  let src = "bench \"b\" allows Console {\n  println(\"x\")\n}\n"
  assert_eq(format_script(src), src)
}
