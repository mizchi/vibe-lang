import @vibe/compiler/fmt/lexer {
  lex_lossless
}
import @vibe/compiler/fmt/layout {
  format_tokens
}

test "layout formats tokens independently of source rewrites" {
  inspect(format_tokens(lex_lossless("let xs=[1,2]\n"), 2), content = "let xs = [1, 2]\n")
}

// #3041: a line-leading `- 1` continues the previous line (binary minus) and
// `-1` starts a new expression (prefix minus). The space after the `-` is
// what tells them apart, so the formatter must keep both spellings as they
// are: collapsing `- 1` to `-1` would change the program's meaning.
test "layout keeps a line-leading binary minus spaced" {
  let src = "fn f(a: Int) -> Int {\n  a\n  - 1\n}\n"
  inspect(format_tokens(lex_lossless(src), 2), content = "fn f(a: Int) -> Int {\n  a\n  - 1\n}\n")
}

test "layout keeps a line-leading prefix minus tight" {
  let src = "fn f(a: Int) -> Int {\n  let _ = a\n  -1\n}\n"
  inspect(format_tokens(lex_lossless(src), 2), content = "fn f(a: Int) -> Int {\n  let _ = a\n  -1\n}\n")
}

test "layout keeps a trailing binary minus on its line" {
  let src = "fn f(a: Int) -> Int {\n  a -\n  1\n}\n"
  inspect(format_tokens(lex_lossless(src), 2), content = "fn f(a: Int) -> Int {\n  a -\n  1\n}\n")
}
