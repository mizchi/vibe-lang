import @vibe/compiler/fmt/header {
  format_vpkg_with, source_header_end
}

test "header formatting delegates only the declaration body" {
  let source = "version = 0.0.1\nname = @test/example\n\nfn value()->Int\n"
  let format_body = (body: String) -> String::concat("BODY:", body)
  inspect(format_vpkg_with(source, format_body), content = "name = @test/example\nversion = 0.0.1\n\nBODY:fn value()->Int\n")
}

test "header boundaries distinguish plain source from package directives" {
  inspect(source_header_end("let x = 1\n"), content = "0")
  inspect(source_header_end("name = @test/example\n\nfn value() -> Int\n"), content = "21")
}
