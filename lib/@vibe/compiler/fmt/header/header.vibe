// Loader-directive header scanning and package-header formatting. The caller supplies body formatting.

import @vibe/compiler/fmt/lexer {
  is_alpha_c, is_ws_c
}

/// True if `s` starts with `p`. Local, like the char-class helpers above:
/// this file deliberately keeps to a small String vocabulary.
fn vp_starts_with(s: String, p: String) -> Bool {
  let ls = String::length(s)
  let lp = String::length(p)
  if lp > ls {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while ok && i < lp {
      if String::char_code_at(s, at = i) != String::char_code_at(p, at = i) {
        ok = false
      } else {
        i = i + 1
      }
    }
    ok
  }
}

/// Index of the first non-space/tab char of `s` (== its length when blank).
fn vp_lead(_ s: String) -> Int {
  let n = String::length(s)
  let mut i = 0
  while i < n && is_ws_c(String::char_code_at(s, at = i)) {
    i = i + 1
  }
  i
}

fn vp_trim(_ s: String) -> String {
  let a = vp_lead(s)
  let mut b = String::length(s)
  while b > a && is_ws_c(String::char_code_at(s, at = b - 1)) {
    b = b - 1
  }
  String::substring(s, start = a, end = b)
}

/// An Array[String] with nothing in it. Written this way (rather than `[]`)
/// so the element type never depends on a push that a branch might skip.
fn vp_empty_strings() -> Array[String] {
  Array::slice([""], start = 0, end = 0)
}

fn vp_split_lines(_ text: String) -> Array[String] {
  let out = vp_empty_strings()
  let n = String::length(text)
  let mut start = 0
  let mut i = 0
  while i < n {
    if String::char_code_at(text, at = i) == '\n' {
      Array::push(out, value = String::substring(text, start = start, end = i))
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    Array::push(out, value = String::substring(text, start = start, end = n))
  } else ()
  out
}

/// Offset of the newline ending the line that starts at `from` (== length
/// when the last line is unterminated).
fn vp_line_end(src: String, from: Int) -> Int {
  let n = String::length(src)
  let mut i = from
  while i < n && String::char_code_at(src, at = i) != '\n' {
    i = i + 1
  }
  i
}

/// Start of the line after the one ending at `nl`. Clamps at the end of an
/// unterminated final line so the caller's scan can never run past it.
fn vp_after_line(src: String, nl: Int) -> Int {
  if nl < String::length(src) {
    nl + 1
  } else {
    nl
  }
}

/// Index of the first `c` in `s`, or -1.
fn vp_index_of(s: String, c: Int) -> Int {
  let n = String::length(s)
  let mut i = 0
  let mut found = -1
  while found < 0 && i < n {
    if String::char_code_at(s, at = i) == c {
      found = i
    } else {
      i = i + 1
    }
  }
  found
}

/// The trimmed text after the first `=` of a `key = value` line ("" when the
/// value is empty, as every committed `generated_hash =` is).
fn vp_value_after_eq(_ trimmed: String) -> String {
  let eq = vp_index_of(s = trimmed, c = '=')
  if eq < 0 {
    ""
  } else {
    vp_trim(String::substring(trimmed, start = eq + 1, end = String::length(trimmed)))
  }
}

/// Whitespace-separated fields of `s` rejoined with single spaces.
fn vp_collapse_spaces(_ s: String) -> String {
  let parts = vp_empty_strings()
  let n = String::length(s)
  let mut i = 0
  while i < n {
    while i < n && is_ws_c(String::char_code_at(s, at = i)) {
      i = i + 1
    }
    let start = i
    while i < n && !is_ws_c(String::char_code_at(s, at = i)) {
      i = i + 1
    }
    if i > start {
      Array::push(parts, value = String::substring(s, start = start, end = i))
    } else ()
  }
  String::join(parts, sep = " ")
}

/// The one-line header directives (everything except the two block forms).
fn vp_is_simple_directive(_ trimmed: String) -> Bool {
  vp_starts_with(s = trimmed, p = "name =") || vp_starts_with(s = trimmed, p = "version =") ||
  vp_starts_with(s = trimmed, p = "version ") || vp_starts_with(s = trimmed, p = "main =") ||
  vp_starts_with(s = trimmed, p = "generated_hash =") ||
  vp_starts_with(s = trimmed, p = "require ") || trimmed == "deps = {}"
}

/// Does `s` look like a header key assignment (`ident =` / `ident=`)? Used
/// only to DECLINE: `scan_package_header` recognizes the exact spelling
/// `name =` and nothing else, so `name  = @vibe/x` or `nmae = @vibe/x` is
/// not a directive to the loader -- and therefore not one here either.
/// Without this check such a line would fall into the declaration region and
/// format_script would rewrite it to `name = @vibe / x`, mangling a file
/// whose author obviously meant a header. No real declaration line has this
/// shape (`let x = 1` does not: the identifier is not adjacent to the `=`),
/// verified across every tracked .vpkg.
fn vp_looks_like_header_key(_ s: String) -> Bool {
  let n = String::length(s)
  let mut i = 0
  while i < n && is_alpha_c(String::char_code_at(s, at = i)) {
    i = i + 1
  }
  if i == 0 {
    false
  } else {
    let mut j = i
    while j < n && is_ws_c(String::char_code_at(s, at = j)) {
      j = j + 1
    }
    j < n && String::char_code_at(s, at = j) == '='
  }
}

/// Byte offset just past the last header directive line of `src`, 0 when the
/// file carries no header at all (the fixtures/contract_* packages), or -1
/// when the header is malformed in a way that makes the split unsafe: an
/// unterminated `deps = {` block, a deps entry with no `:`, or a line that
/// looks like a header key but is not one the loader recognizes. On -1
/// format_vpkg leaves the file completely alone. The loader rejects it
/// anyway (contract.vibe throws, or the line fails to parse as a
/// declaration), and a formatter that guessed here would swallow real
/// declarations into the header and delete them.
///
/// Blank and `//` comment lines do NOT end the scan -- that matches
/// scan_package_header, and it is why the boundary is the last DIRECTIVE
/// line rather than the end of the scanning region: the comment block that
/// documents the package sits after `generated_hash =` and belongs to the
/// declaration region.
fn vp_header_end(_ src: String) -> Int {
  let len = String::length(src)
  let mut pos = 0
  let mut scanning = true
  let mut end = 0
  let mut bad = false
  while scanning && pos < len {
    let nl = vp_line_end(src = src, from = pos)
    let trimmed = vp_trim(String::substring(src, start = pos, end = nl))
    let mut next_pos = vp_after_line(src = src, nl = nl)
    if trimmed == "description =" {
      // `#|` continuations at ANY indentation. The column-consistency rule
      // is the loader's to enforce; re-emission normalizes the column.
      let mut p = next_pos
      let mut going = true
      while going && p < len {
        let dnl = vp_line_end(src = src, from = p)
        if vp_starts_with(s = vp_trim(String::substring(src, start = p, end = dnl)), p = "#|") {
          p = vp_after_line(src = src, nl = dnl)
        } else {
          going = false
        }
      }
      next_pos = p
      end = p
    } else if trimmed == "deps = {" {
      let mut p = next_pos
      let mut closed = false
      while !closed && p < len {
        let dnl = vp_line_end(src = src, from = p)
        let d = vp_trim(String::substring(src, start = p, end = dnl))
        p = vp_after_line(src = src, nl = dnl)
        if d == "}" {
          closed = true
        } else if String::length(d) > 0 && vp_index_of(s = d, c = ':') < 0 {
          closed = true
          bad = true
        } else ()
      }
      if !closed {
        bad = true
      } else ()
      next_pos = p
      end = p
    } else if vp_is_simple_directive(trimmed) {
      end = next_pos
    } else if String::length(trimmed) == 0 || vp_starts_with(s = trimmed, p = "//") {
      ()
    } else {
      scanning = false
      if vp_looks_like_header_key(trimmed) {
        bad = true
      } else ()
    }
    if bad {
      scanning = false
    } else ()
    pos = next_pos
  }
  if bad {
    -1
  } else {
    end
  }
}

/// Sorts the parallel (name, version) deps arrays by package name. Uses the
/// typed vp_str_lt helper because the operands originate from Array::get (#1184).
fn vp_sort_deps(names: Array[String], vers: Array[String]) -> Unit {
  let n = Array::length(names)
  let mut i = 1
  while i < n {
    let cur_name = Array::get(names, at = i)
    let cur_ver = Array::get(vers, at = i)
    let mut j = i - 1
    let mut going = true
    while going && j >= 0 {
      if vp_str_lt(a = cur_name, b = Array::get(names, at = j)) {
        Array::set(names, at = j + 1, value = Array::get(names, at = j))
        Array::set(vers, at = j + 1, value = Array::get(vers, at = j))
        j = j - 1
      } else {
        going = false
      }
    }
    Array::set(names, at = j + 1, value = cur_name)
    Array::set(vers, at = j + 1, value = cur_ver)
    i = i + 1
  }
}

/// Re-emits the header in canonical order and spacing. `header` is exactly
/// the region vp_header_end delimited, so every line in it is one this
/// function recognizes -- there is no unrecognized-line case to preserve.
fn vp_render_header(_ header: String) -> String {
  let lines = vp_split_lines(header)
  let n = Array::length(lines)
  let out = vp_empty_strings()
  let desc = vp_empty_strings()
  let dep_names = vp_empty_strings()
  let dep_vers = vp_empty_strings()
  let reqs = vp_empty_strings()
  let mut name_v = ""
  let mut seen_name = false
  let mut version_v = ""
  // The legacy bare `version x.y.z` (ADR-0065/#754) is still accepted by
  // the loader, so its spelling is preserved rather than upgraded: the
  // bootstrap seed that builds the compiler understands only that form for
  // some packages, and switching one is a bootstrap-bump decision, not a
  // formatting one.
  let mut version_eq = true
  let mut seen_version = false
  let mut main_v = ""
  let mut seen_main = false
  let mut seen_desc = false
  let mut seen_deps = false
  let mut hash_v = ""
  let mut seen_hash = false
  let mut i = 0
  while i < n {
    let raw = Array::get(lines, at = i)
    let trimmed = vp_trim(raw)
    if trimmed == "description =" {
      seen_desc = true
      i = i + 1
      let mut going = true
      while going && i < n {
        let draw = Array::get(lines, at = i)
        if vp_starts_with(s = vp_trim(draw), p = "#|") {
          // Everything after `#|` is raw description text -- kept byte for
          // byte, including any trailing spaces. Only the indent moves.
          let lead = vp_lead(draw)
          Array::push(desc, value = String::substring(draw, start = lead + 2, end = String::length(draw)))
          i = i + 1
        } else {
          going = false
        }
      }
    } else if trimmed == "deps = {" {
      seen_deps = true
      i = i + 1
      let mut closed = false
      while !closed && i < n {
        let d = vp_trim(Array::get(lines, at = i))
        i = i + 1
        if d == "}" {
          closed = true
        } else if String::length(d) > 0 {
          let c = vp_index_of(s = d, c = ':')
          Array::push(dep_names, value = vp_trim(String::substring(d, start = 0, end = c)))
          Array::push(dep_vers, value = vp_trim(String::substring(d, start = c + 1, end = String::length(d))))
        } else ()
      }
    } else if trimmed == "deps = {}" {
      seen_deps = true
      i = i + 1
    } else if vp_starts_with(s = trimmed, p = "name =") {
      name_v = vp_value_after_eq(trimmed)
      seen_name = true
      i = i + 1
    } else if vp_starts_with(s = trimmed, p = "version =") {
      version_v = vp_value_after_eq(trimmed)
      version_eq = true
      seen_version = true
      i = i + 1
    } else if vp_starts_with(s = trimmed, p = "version ") {
      version_v = vp_collapse_spaces(String::substring(trimmed, start = 8, end = String::length(trimmed)))
      version_eq = false
      seen_version = true
      i = i + 1
    } else if vp_starts_with(s = trimmed, p = "main =") {
      main_v = vp_value_after_eq(trimmed)
      seen_main = true
      i = i + 1
    } else if vp_starts_with(s = trimmed, p = "generated_hash =") {
      hash_v = vp_value_after_eq(trimmed)
      seen_hash = true
      i = i + 1
    } else if vp_starts_with(s = trimmed, p = "require ") {
      Array::push(reqs, value = vp_collapse_spaces(trimmed))
      i = i + 1
    } else {
      // Blank lines between directives: dropped here and re-emitted by the
      // layout rules below.
      i = i + 1
    }
  }
  if seen_name {
    Array::push(out, value = String::join(["name = ", name_v], sep = ""))
  } else ()
  if seen_version {
    if version_eq {
      Array::push(out, value = String::join(["version = ", version_v], sep = ""))
    } else {
      Array::push(out, value = String::join(["version ", version_v], sep = ""))
    }
  } else ()
  if seen_main {
    Array::push(out, value = String::join(["main = ", main_v], sep = ""))
  } else ()
  if seen_desc {
    Array::push(out, value = "description =")
    let mut d = 0
    while d < Array::length(desc) {
      Array::push(out, value = String::join(["  #|", Array::get(desc, at = d)], sep = ""))
      d = d + 1
    }
  } else ()
  if seen_deps {
    let ndeps = Array::length(dep_names)
    if ndeps == 0 {
      Array::push(out, value = "deps = {}")
    } else {
      vp_sort_deps(names = dep_names, vers = dep_vers)
      Array::push(out, value = "deps = {")
      let mut d = 0
      while d < ndeps {
        Array::push(out, value = String::join([
          "  ",
          Array::get(dep_names, at = d),
          " : ",
          Array::get(dep_vers, at = d)
        ], sep = ""))
        d = d + 1
      }
      Array::push(out, value = "}")
    }
  } else ()
  let mut r = 0
  while r < Array::length(reqs) {
    Array::push(out, value = Array::get(reqs, at = r))
    r = r + 1
  }
  if seen_hash {
    if Array::length(out) > 0 {
      Array::push(out, value = "")
    } else ()
    if String::length(hash_v) == 0 {
      Array::push(out, value = "generated_hash =")
    } else {
      Array::push(out, value = String::join(["generated_hash = ", hash_v], sep = ""))
    }
  } else ()
  String::join(out, sep = "\n")
}

/// Drops leading all-whitespace lines. The single blank line separating the
/// header from the declarations is re-emitted by format_vpkg, so however
/// many the input had, the output has exactly one.
fn vp_strip_leading_blanks(_ text: String) -> String {
  let n = String::length(text)
  let mut pos = 0
  let mut going = true
  while going && pos < n {
    let nl = vp_line_end(src = text, from = pos)
    if nl < n && String::length(vp_trim(String::substring(text, start = pos, end = nl))) == 0 {
      pos = nl + 1
    } else {
      going = false
    }
  }
  String::substring(text, start = pos, end = n)
}

/// Byte offset just past a plain vibe source's leading loader-directive
/// head (`require @scope/name x.y.z = #pkg:sha1:...` pins and the other
/// scan_package_header directives), 0 when there is none, -1 when the head
/// is malformed in a way that makes the split unsafe (vp_header_end's
/// contract). Exported for the entries' #1821 parse guards, which must ask
/// the parse question of the BODY -- the head is not vibe syntax.
export fn source_header_end(_ src: String) -> Int {
  vp_header_end(src)
}

fn vp_str_lt(a: String, b: String) -> Bool {
  a < b
}

/// Format a `.vpkg` package contract: canonical header + format_script over
/// the declarations. See the section header above for the split.
export fn format_vpkg_with(src: String, format_body: (String) -> String) -> String {
  let end = vp_header_end(src)
  if end < 0 {
    src
  } else if end == 0 {
    format_body(src)
  } else {
    let header = vp_render_header(String::substring(src, start = 0, end = end))
    let rest = vp_strip_leading_blanks(String::substring(src, start = end, end = String::length(src)))
    if String::length(rest) == 0 {
      String::join([header, ""], sep = "\n")
    } else {
      String::join([header, "", format_body(rest)], sep = "\n")
    }
  }
}
