//# Imports

import @vibe/compiler/core {
  Expr, Stmt, TypeExpr, is_entry_runtime_managed_effect, is_exception_effect_name
}

import @vibe/core {
  array_empty
}

//# WIT text generation (#537)
//
// Maps a vibe program's EFFECT SURFACE to a WIT world:
//
//   - Each *exported* top-level function with a full type annotation becomes a
//     world `export <kebab-name>: func(...)`.
//   - The union of the effects named in those exported signatures' `with E`
//     rows becomes the world's imports. An effect declared in the program via
//     `effect E { Op(Args) -> Ret; ... }` is emitted as an inline interface
//     import: `import <kebab-E>: interface { <kebab-op>: func(...) -> ...; }`.
//   - `Error` never surfaces (it is vibe-internal control flow: an escaping
//     throw is a component trap, not a capability).
//   - `Async` never surfaces as an import either (ADR-0089 Decision 5,
//     #1218): it is THE builtin suspension effect (Decision 1), realized as
//     the export's `async func` lifting mode — an exported signature whose
//     row carries Async is emitted as `export <name>: async func(...)`, the
//     shape step 4's composition actually produces.
//   - Effect names WITHOUT a matching `effect` declaration (host capabilities
//     such as Fs / Env) get a comment marker: they are provided by the
//     vibe runtime's host imports and have no WIT mapping yet.
//
// Type mapping (vibe -> WIT): Int -> s64, Double -> f64, Bool -> bool,
// String -> string, Char -> char, Unit -> (no result), Bytes -> list<u8>,
// Array[T] -> list<T>, Option[T] -> option<T>, Result[T, E] -> result<T, E>,
// Map[K, V] -> list<tuple<K, V>>, tuples -> tuple<...>,
// Future[T] -> future<T'>, ByteStream -> stream<u8> (ADR-0089 Decision 5;
// the eager `Stream[T]` builtin deliberately has NO mapping — only nominal
// host-owned boundary streams may cross, spec §3.3). Anything else
// (named user types, function types) is rejected with a clear error — the
// golden output never silently mis-declares a boundary type.
//
// The full contract lives in docs/effect-wit-mapping.md; the generated text is
// pinned by fixtures/wit_gen_http.golden.wit (gate step) and round-trips
// through vibe/wasm/wit_parser (wit_gen_test.vibe).

/// Lowercase a single ASCII char code, else identity.
fn wit_lower_char(c: Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

/// vibe identifier (CamelCase / snake_case) -> WIT kebab-case word list.
/// `HttpReq` -> `http-req`, `now_us` -> `now-us`, `Fs` -> `fs`. Consecutive
/// uppercase letters split per letter (`URL` -> `u-r-l`) — vibe convention is
/// strict CamelCase, so this stays predictable.
export fn wit_kebab_ident(name: String) -> String {
  let sb = StringBuilder::new()
  let len = String::length(name)
  let mut i = 0
  let mut prev_dash = true
  while i < len {
    let c = String::char_code_at(name, i)
    if c == 95 {
      if !prev_dash {
        StringBuilder::push(sb, "-")
      }
      prev_dash = true
    } else if c >= 65 && c <= 90 {
      if !prev_dash {
        StringBuilder::push(sb, "-")
      }
      StringBuilder::push(sb, String::from_char_code(wit_lower_char(c)))
      prev_dash = false
    } else {
      StringBuilder::push(sb, String::from_char_code(c))
      prev_dash = false
    }
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

fn wit_is_unit_type(ty: TypeExpr) -> Bool {
  match ty {
    TyUnit => true,
    TyName(name) => name == "Unit",
    _ => false
  }
}

/// vibe TypeExpr -> WIT type text. Throws on types with no WIT mapping.
export fn wit_type_text(ty: TypeExpr) -> String with Exception {
  match ty {
    TyName(name) => {
      if name == "Int" {
        "s64"
      } else if name == "Double" {
        "f64"
      } else if name == "Bool" {
        "bool"
      } else if name == "String" {
        "string"
      } else if name == "Char" {
        "char"
      } else if name == "Bytes" {
        "list<u8>"
      } else if name == "ByteStream" {
        // ADR-0089 Decision 5 (#1218): the one NOMINAL boundary-stream
        // handle -- a byte stream whose producer end the host owns
        // (docs/spec/wasi-p3-async.md §2.4/§3.3; Decision 3's AsyncIter
        // unification keeps general guest streams out of the boundary).
        "stream<u8>"
      } else {
        throw("wit: no WIT mapping for type '\{name}' (supported: Int, Double, Bool, String, Char, Bytes, Unit, Array, Option, Result, Map, tuples, Future[T], ByteStream)")
      }
    },
    TyApp(head, args) => {
      if head == "Array" && Array::length(args) == 1 {
        "list<\{wit_type_text(Array::get(args, 0))}>"
      } else if head == "Option" && Array::length(args) == 1 {
        "option<\{wit_type_text(Array::get(args, 0))}>"
      } else if head == "Result" && Array::length(args) == 2 {
        "result<\{wit_type_text(Array::get(args, 0))}, \{wit_type_text(Array::get(args, 1))}>"
      } else if head == "Map" && Array::length(args) == 2 {
        "list<tuple<\{wit_type_text(Array::get(args, 0))}, \{wit_type_text(Array::get(args, 1))}>>"
      } else if head == "Future" && Array::length(args) == 1 {
        // ADR-0089 Decision 5 (#1218): `Future[T]` projects to the P3
        // `future<T'>` payload type. Backed by a real lowering since step
        // 4 (spec §3.13/§3.14: host-supplied future<u32> -> Future[Int]
        // cell -> waitable-set.wait park), so this is a projection of an
        // implemented boundary, not an aspiration.
        //
        // Deliberately NOT mapped: the eager `Stream[T]` builtin. Decision
        // 5 restricts `stream<T'>` to NOMINAL boundary-stream handles whose
        // producer end the host owns (`ByteStream` below) -- advertising a
        // guest-produced stream value would declare an ABI the lowering
        // cannot implement (spec §3.3: a producer cannot enter the
        // component instance), so it stays a hard error here.
        "future<\{wit_type_text(Array::get(args, 0))}>"
      } else {
        throw("wit: no WIT mapping for type '\{head}[..]'")
      }
    },
    TyTuple(items) => {
      let sb = StringBuilder::new()
      StringBuilder::push(sb, "tuple<")
      let mut i = 0
      while i < Array::length(items) {
        if i > 0 {
          StringBuilder::push(sb, ", ")
        }
        StringBuilder::push(sb, wit_type_text(Array::get(items, i)))
        i = i + 1
      }
      StringBuilder::push(sb, ">")
      StringBuilder::freeze(sb)
    },
    TyFn(_, _, _) => throw("wit: function types cannot cross the WIT boundary"),
    TyUnit => throw("wit: Unit is only valid as a return type")
  }
}

/// `func(name: ty, ...) -> ret` text for a signature. Unit return omits `->`.
/// `is_async` (ADR-0089 Decision 5, #1218) prefixes `async` -- the P3
/// async-lifted function type an `with Async` export projects to.
fn wit_func_text_of(param_names: Array[String], param_types: Array[TypeExpr], ret: TypeExpr, is_async: Bool) -> String with Exception {
  let sb = StringBuilder::new()
  if is_async {
    StringBuilder::push(sb, "async ")
  } else {
    ()
  }
  StringBuilder::push(sb, "func(")
  let mut i = 0
  while i < Array::length(param_types) {
    if i > 0 {
      StringBuilder::push(sb, ", ")
    }
    let pname = if i < Array::length(param_names) {
      wit_kebab_ident(Array::get(param_names, i))
    } else {
      "arg\{i}"
    }
    StringBuilder::push(sb, pname)
    StringBuilder::push(sb, ": ")
    StringBuilder::push(sb, wit_type_text(Array::get(param_types, i)))
    i = i + 1
  }
  StringBuilder::push(sb, ")")
  if !wit_is_unit_type(ret) {
    StringBuilder::push(sb, " -> ")
    StringBuilder::push(sb, wit_type_text(ret))
  }
  StringBuilder::freeze(sb)
}

fn wit_func_text(param_names: Array[String], param_types: Array[TypeExpr], ret: TypeExpr) -> String with Exception {
  wit_func_text_of(param_names, param_types, ret, false)
}

/// Split a parsed effect row ("A, B") into names. The parser joins the
/// `with A + B` list with ", " (parser_base.vibe collect_effect_names).
fn wit_split_effect_row(row: String) -> Array[String] {
  let out = array_empty()
  let len = String::length(row)
  let mut piece = ""
  let mut i = 0
  while i < len {
    let c = String::char_code_at(row, i)
    if c == 44 {
      if String::length(piece) > 0 {
        Array::push(out, piece)
      }
      piece = ""
    } else if c == 32 {
      ()
    } else {
      piece = String::concat(piece, String::from_char_code(c))
    }
    i = i + 1
  }
  if String::length(piece) > 0 {
    Array::push(out, piece)
  }
  out
}

fn wit_array_contains(items: Array[String], needle: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(items) {
    if Array::get(items, i) == needle {
      found = true
    }
    i = i + 1
  }
  found
}

// One exported function surface as a tuple:
//   (name, param_names, param_types, ret, effects)
// A plain tuple, not a struct: struct values crossing function boundaries
// miscompile in the flat-bundle lane today (#537 follow-up filed), while
// tuples are battle-tested everywhere in the compiler.

/// Extract the boundary signature of `SLet(true, _, name, ann, body)`.
/// Priority: TyFn annotation (param names from the EFn body when available),
/// else fully-annotated EFn params/ret. Non-function exports and unannotated
/// functions return None (they have no declarable WIT surface).
fn wit_export_of_slet(name: String, ann: Option[TypeExpr], body: Expr) -> Option[(String, Array[String], Array[TypeExpr], TypeExpr, Array[String])] {
  let efn_param_names = array_empty()
  let efn_param_types = array_empty()
  let mut efn_params_ok = true
  let mut efn_ret = None
  let mut efn_eff = None
  match body {
    EFn(_, _, params, ret_opt, eff_opt, _) => {
      let mut i = 0
      while i < Array::length(params) {
        let (pname, pty_opt) = Array::get(params, i)
        Array::push(efn_param_names, pname)
        match pty_opt {
          Some(pty) => Array::push(efn_param_types, pty),
          None => {
            efn_params_ok = false
          }
        }
        i = i + 1
      }
      efn_ret = ret_opt
      efn_eff = eff_opt
    },
    _ => {
      efn_params_ok = false
    }
  }
  let mut ann_fn = None
  match ann {
    Some(ty) => match ty {
      TyFn(ptys, rty, eff) => {
        ann_fn = Some((ptys, rty, eff))
      },
      _ => ()
    },
    None => ()
  }
  match ann_fn {
    Some(fn_parts) => {
      let (ptys, rty, eff) = fn_parts
      let effects = match eff {
        Some(row) => wit_split_effect_row(row),
        None => array_empty()
      }
      Some((name, efn_param_names, ptys, rty, effects))
    },
    None => {
      if efn_params_ok {
        match efn_ret {
          Some(rty) => {
            let effects = match efn_eff {
              Some(row) => wit_split_effect_row(row),
              None => array_empty()
            }
            Some((name, efn_param_names, Array::slice(efn_param_types, 0, Array::length(efn_param_types)), rty, effects))
          },
          None => None
        }
      } else {
        None
      }
    }
  }
}

//# vibe serve handler contract (#537)

/// The wasi-http P3 full-adapter handler contract
/// (scripts/build_wasi_http_p3_full_adapter.sh):
///   export let handler = (method: String, url: String, headers: String, body: String) -> String
/// returning "STATUS\n<Header: value lines>\n\n<body>".
export fn serve_handler_param_names() -> Array[String] {
  [
    "method",
    "url",
    "headers",
    "body"
  ]
}

fn wit_type_is_string(ty: TypeExpr) -> Bool {
  match ty {
    TyName(name) => name == "String",
    _ => false
  }
}

/// Validate the entry file's `handler` export against the serve contract,
/// with a teaching error when it does not fit.
export fn validate_serve_handler(entry_stmts: Array[Stmt]) -> Unit with Exception {
  let contract = "serve: expected `export let handler = (method: String, url: String, headers: String, body: String) -> String`"
  match wit_boundary_signature(entry_stmts, "handler") {
    None => throw(String::concat(contract, " (no exported `handler` with a full type annotation found)")),
    Some(sig) => {
      let (_sname, _spnames, sig_param_types, sig_ret, sig_effects) = sig
      if Array::length(sig_param_types) != 4 {
        throw(String::concat(contract, " (found \{Array::length(sig_param_types)} params)"))
      }
      let mut pi = 0
      while pi < Array::length(sig_param_types) {
        if !wit_type_is_string(Array::get(sig_param_types, pi)) {
          throw(String::concat(contract, " (param \{pi} is not String)"))
        }
        pi = pi + 1
      }
      if !wit_type_is_string(sig_ret) {
        throw(String::concat(contract, " (return type is not String)"))
      }
      let mut ei = 0
      while ei < Array::length(sig_effects) {
        let ename = Array::get(sig_effects, ei)
        if !is_exception_effect_name(ename) {
          throw("serve: handler requires capability effect '\{ename}'; a serve handler must be a pure function of its request params (discharge the effect with `handle` inside the file)")
        }
        ei = ei + 1
      }
    }
  }
}

/// Boundary signature of one exported top-level function, by name. Used by
/// `vibe serve` to validate the handler contract before componentizing.
export fn wit_boundary_signature(stmts: Array[Stmt], name: String) -> Option[(String, Array[String], Array[TypeExpr], TypeExpr, Array[String])] {
  let mut found = None
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exported, _, sname, ann, body) => {
        if exported && sname == name {
          found = wit_export_of_slet(sname, ann, body)
        }
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// Collect `effect` declarations (recursing into module blocks) as parallel
/// name/ops arrays.
fn wit_collect_effect_defs(stmts: Array[Stmt], out_names: Array[String], out_ops: Array[Array[(String, Array[TypeExpr], TypeExpr)]]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEffectDef(_, name, _, ops) => {
        if !wit_array_contains(out_names, name) {
          Array::push(out_names, name)
          Array::push(out_ops, ops)
        }
      },
      SModule(_, _, inner) => wit_collect_effect_defs(inner, out_names, out_ops),
      _ => ()
    }
    i = i + 1
  }
}

/// Generate the WIT world text for a program.
///   export_stmts: statements scanned for *exported* function surfaces
///                 (normally the entry file's own statements).
///   effect_stmts: statements scanned for `effect` declarations (may be the
///                 same array, or entry + resolved import type decls).
///   world_name:   raw name; kebab-cased into the world header.
/// ADR-0071 (#755) step 5: a row item collected by wit_split_effect_row can
/// now be a qualified operation (`Ask::Get`, step 1) or an effectset name
/// (`AskAll`, step 2+) instead of only a bare effect name -- WITHOUT this,
/// either shape falls through to the "host capability effect ... no WIT
/// mapping yet" branch below, which is wrong (it's neither a host effect
/// nor unmappable, just spelled differently than wit_collect_effect_defs'
/// bare-name lookup expects). Local to this file (no new cross-file
/// reference -- see docs/effectset.md's bootstrap gotcha); duplicates the
/// same small ES-table/cycle-safe-expansion shape already used in
/// checker_stmt.vibe and contract.vibe for the same reason.
fn wit_es_collect_into(stmts: Array[Stmt], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEffectSet(_, esname, esmembers) => {
        Array::push(es_names, esname)
        Array::push(es_members_list, esmembers)
      },
      SModule(_, _, inner) => wit_es_collect_into(inner, es_names, es_members_list),
      _ => ()
    }
    i = i + 1
  }
}

fn wit_es_expand_into(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String], out: Array[String]) -> Unit {
  if wit_array_contains(path, name) {
    ()
  } else {
    let idx_of = {
      let mut i = 0
      let mut found = -1
      while i < Array::length(es_names) {
        if Array::get(es_names, i) == name {
          found = i
        }
        i = i + 1
      }
      found
    }
    if idx_of < 0 {
      if wit_array_contains(out, name) {
        ()
      } else {
        Array::push(out, name)
      }
    } else {
      Array::push(path, name)
      let members = Array::get(es_members_list, idx_of)
      let mut mi = 0
      while mi < Array::length(members) {
        wit_es_expand_into(es_names, es_members_list, Array::get(members, mi), path, out)
        mi = mi + 1
      }
      Array::truncate(path, Array::length(path) - 1)
    }
  }
}

/// Strip a qualified operation name (`Ask::Get`) down to its effect prefix
/// (`Ask`); a bare name (already an effect name, or an unresolvable label)
/// passes through unchanged.
fn wit_effect_name_of(label: String) -> String {
  let idx = String::index_of(label, "::")
  if idx > 0 {
    String::substring(label, 0, idx)
  } else {
    label
  }
}

/// Resolve one raw row-item label to the underlying effect NAME(s) it
/// requires: expand it if it's a known effectset (pushing each expanded
/// leaf's effect prefix), or just push its own effect prefix directly
/// otherwise. Appends into `out` (deduped by the caller).
fn wit_resolve_effect_names_into(label: String, es_names: Array[String], es_members_list: Array[Array[String]], out: Array[String]) -> Unit {
  let is_effectset = {
    let mut i = 0
    let mut found = false
    while i < Array::length(es_names) {
      if Array::get(es_names, i) == label {
        found = true
      }
      i = i + 1
    }
    found
  }
  if is_effectset {
    let leaves = array_empty()
    wit_es_expand_into(es_names, es_members_list, label, array_empty(), leaves)
    let mut li = 0
    while li < Array::length(leaves) {
      let ename = wit_effect_name_of(Array::get(leaves, li))
      if wit_array_contains(out, ename) {
        ()
      } else {
        Array::push(out, ename)
      }
      li = li + 1
    }
  } else {
    let ename = wit_effect_name_of(label)
    if wit_array_contains(out, ename) {
      ()
    } else {
      Array::push(out, ename)
    }
  }
}

export fn wit_from_program(export_stmts: Array[Stmt], effect_stmts: Array[Stmt], world_name: String) -> String with Exception {
  let eff_names = array_empty()
  let eff_ops = array_empty()
  wit_collect_effect_defs(effect_stmts, eff_names, eff_ops)
  wit_collect_effect_defs(export_stmts, eff_names, eff_ops)
  let wit_es_names = array_empty()
  let wit_es_members_list = array_empty()
  wit_es_collect_into(effect_stmts, wit_es_names, wit_es_members_list)
  wit_es_collect_into(export_stmts, wit_es_names, wit_es_members_list)
  let exports = array_empty()
  let mut i = 0
  while i < Array::length(export_stmts) {
    match Array::get(export_stmts, i) {
      SLet(exported, _, name, ann, body) => {
        if exported {
          match wit_export_of_slet(name, ann, body) {
            Some(ex) => Array::push(exports, ex),
            None => ()
          }
        }
      },
      _ => ()
    }
    i = i + 1
  }
  // Imports: effects referenced by exported signatures, in first-use order.
  // ADR-0071 (#755) step 5: each raw row-item label is resolved through
  // wit_resolve_effect_names_into first -- a qualified operation
  // (`Ask::Get`) or effectset name (`AskAll`) maps to its underlying real
  // effect name(s) instead of being pushed verbatim (which would never
  // match eff_names below and misreport as an unmappable host capability).
  let used_effects = array_empty()
  let mut xi = 0
  while xi < Array::length(exports) {
    let (_xn, _xp, _xt, _xr, ex_effects) = Array::get(exports, xi)
    let mut ei = 0
    while ei < Array::length(ex_effects) {
      let ename = Array::get(ex_effects, ei)
      if !is_exception_effect_name(ename) {
        let resolved = array_empty()
        wit_resolve_effect_names_into(ename, wit_es_names, wit_es_members_list, resolved)
        let mut ri = 0
        while ri < Array::length(resolved) {
          let rname = Array::get(resolved, ri)
          // Standard entry/runtime handling produces no WIT world import.
          // `Error`/`Exception[K]` escape through the entry boundary as a
          // component trap rather than a provider requirement; `Async`
          // surfaces through the export's `async func` lifting mode instead.
          // core/standard_effect_policy.vibe centralizes this unchanged
          // behavior for the checker and WIT generator.
          //
          // The deferred declaration-versus-provider inversion below
          // (`def_idx < 0`) is intentionally unchanged: a declared `effect
          // X { .. }` still maps to an interface while an undeclared label is
          // treated as a host capability. This slice does not alter WIT
          // mapping, provider selection, or handler semantics.
          if is_entry_runtime_managed_effect(rname) {
            ()
          } else if !wit_array_contains(used_effects, rname) {
            Array::push(used_effects, rname)
          } else {
            ()
          }
          ri = ri + 1
        }
      } else {
        ()
      }
      ei = ei + 1
    }
    xi = xi + 1
  }
  let sb = StringBuilder::new()
  StringBuilder::push(sb, "package vibe:app;\n\nworld ")
  StringBuilder::push(sb, wit_kebab_ident(world_name))
  StringBuilder::push(sb, " {\n")
  let mut ui = 0
  while ui < Array::length(used_effects) {
    let ename = Array::get(used_effects, ui)
    let mut def_idx = 0 - 1
    let mut di = 0
    while di < Array::length(eff_names) {
      if Array::get(eff_names, di) == ename {
        def_idx = di
      }
      di = di + 1
    }
    if def_idx >= 0 {
      StringBuilder::push(sb, "  import ")
      StringBuilder::push(sb, wit_kebab_ident(ename))
      StringBuilder::push(sb, ": interface {\n")
      let ops = Array::get(eff_ops, def_idx)
      let mut oi = 0
      while oi < Array::length(ops) {
        let (op_name, op_args, op_ret) = Array::get(ops, oi)
        StringBuilder::push(sb, "    ")
        StringBuilder::push(sb, wit_kebab_ident(op_name))
        StringBuilder::push(sb, ": ")
        StringBuilder::push(sb, wit_func_text(array_empty(), op_args, op_ret))
        StringBuilder::push(sb, ";\n")
        oi = oi + 1
      }
      StringBuilder::push(sb, "  }\n")
    } else {
      // Host capability effect (Fs / Env / Async / ...): provided by the vibe
      // runtime's host imports; no declared operations to surface.
      StringBuilder::push(sb, "  // host capability effect '")
      StringBuilder::push(sb, ename)
      StringBuilder::push(sb, "' (provided by the vibe runtime; no WIT mapping yet)\n")
    }
    ui = ui + 1
  }
  let mut xo = 0
  while xo < Array::length(exports) {
    let (ex_name, ex_param_names, ex_param_types, ex_ret, ex_effects) = Array::get(exports, xo)
    // ADR-0089 Decision 5 (#1218): an `with Async` export projects to
    // an `async func` (the async-lifted export shape step 4's composition
    // actually emits); resolve row labels first so `Async` reached via an
    // effectset is seen too.
    let mut is_async = false
    let mut ai = 0
    while ai < Array::length(ex_effects) {
      let alabel = Array::get(ex_effects, ai)
      let aresolved = array_empty()
      wit_resolve_effect_names_into(alabel, wit_es_names, wit_es_members_list, aresolved)
      if wit_array_contains(aresolved, "Async") {
        is_async = true
      } else {
        ()
      }
      ai = ai + 1
    }
    StringBuilder::push(sb, "  export ")
    StringBuilder::push(sb, wit_kebab_ident(ex_name))
    StringBuilder::push(sb, ": ")
    StringBuilder::push(sb, wit_func_text_of(ex_param_names, ex_param_types, ex_ret, is_async))
    StringBuilder::push(sb, ";\n")
    xo = xo + 1
  }
  StringBuilder::push(sb, "}\n")
  StringBuilder::freeze(sb)
}
