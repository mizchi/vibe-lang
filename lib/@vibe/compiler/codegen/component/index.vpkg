fn comp_emit_component_wasm_stream_value(export_name: String, comp_result_valtype: Int) -> Bytes with Exception
// ADR-0089 D2 / step 4 (#1218): host-supplied future<u32> -- imports
// `get-future`, parks the read on waitable-set.wait until the host's
// producer resolves (driven by runtime/viberun's FutureReader import).
fn comp_emit_component_wasm_host_future_value(export_name: String, comp_result_valtype: Int) -> Bytes with Exception
// #1539: production-unused stdin provider shadow component. This is an
// internal gate emitter only; it has no end-user API or linked_compile route.
fn comp_emit_component_wasm_stdin_provider_shadow() -> Bytes
// #1539 bounded checker-hidden core route. The fixture is internal to the
// structural/runtime gate (0 drain, 1 early close, 2/3/4 malformed-wire traps).
// `vibe build --component` face selection: does the core import anything
// from the host `vibe` module? (component_codegen.vibe)
fn comp_core_imports_vibe_host(core_wasm: Bytes) -> Bool
// The command-component wrap itself: picks the face from that answer, so
// every caller of `vibe build --component` gets the same one.
fn comp_emit_component_wasm_command(core_wasm: Bytes, target_func_name: String, export_name: String) -> Bytes with Exception
fn comp_core_imports_stdin_provider(core_wasm: Bytes) -> Bool
fn comp_emit_component_wasm_async_stdin_provider(main_core_wasm: Bytes, export_name: String) -> Bytes with Exception
fn comp_emit_component_wasm_async_stdin_provider_fixture(mode: Int) -> Bytes with Exception

// #1540: byte-shape fixture for the widened async canon emitters.
fn comp_emit_async_string_canon_fixture() -> Bytes

// #1540: memhost module that also exports cabi_realloc.
fn comp_emit_memhost_realloc_fixture() -> Bytes

