// #1540 scope 3: byte-shape fixture for the stream-parameter trampoline.
fn comp_emit_stream_trampoline_fixture(string_param_count: Int) -> Bytes

// #1540 scope 4: the serve lane for a handler whose last param is a HostStream.
fn comp_emit_component_wasm_stream_handler(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with Exception
fn comp_emit_component_wasm_service_handler(core_wasm: Bytes, target_func_name: String, export_name: String, param_names: Array[String]) -> Bytes with Exception
// ADR-0089 step 4 (#1218): REAL-source wiring -- wrap a compiled core whose
// program calls `host_future_get` (core imports vibe.host_future_get/_wait,
// sniffed by comp_core_imports_host_future) into the adapter-backed async
// component (get-future import + waitable-set.wait park + u32 lift).
fn comp_core_imports_host_future(core_wasm: Bytes) -> Bool
// ADR-0089 (c) (#1218): the host-future GET core import names, in
// declaration order -- the list both the adapter layout and the component's
// import/lower order are derived from.
fn comp_core_host_future_names(core_wasm: Bytes) -> Array[String]
// ADR-0089 Decision 3 (#1218): the host-stream siblings -- named
// `vibe.host_stream_get$<name>` core imports become per-name `stream<u8>`
// component imports on the same adapter-backed composition (spec §3.18).
fn comp_core_imports_host_stream(core_wasm: Bytes) -> Bool
fn comp_core_host_stream_names(core_wasm: Bytes) -> Array[String]
// #1342: `vibe.sleep` keys the same adapter-backed composition -- the composer
// adds a `sleep-for` component import and an adapter func that parks on its
// subtask, so an async component can sleep.
fn comp_core_imports_sleep(core_wasm: Bytes) -> Bool
// #1342: fail closed instead of emitting a component whose compiled core has
// an import nothing in the composition provides.
fn comp_reject_unsatisfiable_selfcontained_imports(core_wasm: Bytes) -> Unit with Exception
fn comp_emit_component_wasm_async_hostfuture(main_core_wasm: Bytes, export_name: String) -> Bytes with Exception
fn comp_emit_component_wasm_async_wit_future_fixture() -> Bytes with Exception
fn comp_emit_component_wasm_async_wit_future_mixed_fixture() -> Bytes with Exception
