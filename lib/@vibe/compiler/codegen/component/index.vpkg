name = @vibe/compiler/codegen/component
version = 0.0.1
description =
  #|@vibe/compiler/codegen/component — WebAssembly component-model encoder
deps = {
  @vibe/compiler/codegen/wasm_emit : 0.0.1
  @vibe/compiler/core : 0.0.1
  @vibe/core : 0.2.0
}

generated_hash =

// @vibe/compiler/codegen/component — wraps a compiled core wasm module in a
// WebAssembly component: the component header and sections, canonical
// lift/lower, the async / stream / future adapter core modules, and the WIT
// surfaces the HTTP and CLI worlds need. Directory-shared-scope package.
//
// It reads core wasm bytes and emits component bytes; it does not compile
// vibe source. entry/source_compile/wasi_only is its caller: it compiles the
// entry, then hands the core module here.
//
// `comp_emit_wasi_cli_stdin_import_surface_for_test` is a private fn promoted
// to sibling visibility by a bare `export { .. }` block for the adjacent
// exact-byte test, so it is intentionally absent from this contract.

// --- component_codegen.vibe
fn comp_generate_string_trampoline(string_param_count: Int, call_run_init: Int) -> Bytes
fn comp_emit_component_wasm(core_wasm: Bytes) -> Bytes
fn comp_emit_component_wasm_with_lift(core_wasm: Bytes, export_name: String) -> Bytes
fn comp_emit_component_wasm_with_string_lift(core_wasm: Bytes, target_func_name: String, export_name: String, string_param_count: Int, param_names: Array[String], is_async: Int) -> Bytes
