//# Functions

fn read_uleb(bytes: Bytes, start: Int) -> (Int, Int) {
  let mut value = 0
  let mut shift = 0
  let mut i = start
  let len = Bytes::length(bytes)
  let mut done = false
  while (i < len) && (done == false) {
    let b = Bytes::get(bytes, at = i)
    value = value|((b&127)<<shift)
    i = i + 1
    if (b&128) == 0 {
      done = true
    } else {
      shift = shift + 7
    }
  }
  (value, i)
}

export let section_type: Int = 7

export let core_sort_mem: Int = 2

export fn new_int_array() -> Array[Int] {
  array_empty()
}

export let section_alias: Int = 6

export let section_canon: Int = 8

/// #1540: canonical-option opcodes, measured against
/// tools/wasip3_component_probe/async_string_lift/component.wat rather than
/// read off a spec draft -- the probe is what the gate keeps true.
let canonopt_utf8: Int = 0

let canonopt_memory: Int = 3

let canonopt_realloc: Int = 4

let canonopt_async: Int = 6

export let core_sort_func: Int = 0

fn read_name_info(bytes: Bytes, start: Int) -> (Int, Int) {
  read_uleb(bytes = bytes, start = start)
}

fn skip_name(bytes: Bytes, start: Int) -> Int {
  let (name_len, after_len) = read_name_info(bytes = bytes, start = start)
  after_len + name_len
}

let section_export: Int = 11

export let section_import: Int = 10

let section_module: Int = 1

fn parse_type_sigs(bytes: Bytes, sec_start: Int, sec_end: Int, out_sigs: Array[Array[Int]]) -> Unit {
  let mut j = sec_start
  let (type_count, next_j) = read_uleb(bytes = bytes, start = j)
  j = next_j
  let mut t = 0
  while t < type_count {
    if j >= sec_end {
      t = type_count
    }
    else {
      let form = Bytes::get(bytes, at = j)
      j = j + 1
      if form != 96 {
        t = type_count
      }
      else {
        let sig = new_int_array()
        let (param_count, next_j2) = read_uleb(bytes = bytes, start = j)
        j = next_j2
        Array::push(sig, value = param_count)
        let mut p = 0
        while p < param_count {
          if j >= sec_end {
            p = param_count
          }
          else {
            Array::push(sig, value = Bytes::get(bytes, at = j))
            j = j + 1
            p = p + 1
          }
        }
        let (result_count, next_j3) = read_uleb(bytes = bytes, start = j)
        j = next_j3
        Array::push(sig, value = result_count)
        let mut rv = 0
        while rv < result_count {
          if j >= sec_end {
            rv = result_count
          }
          else {
            Array::push(sig, value = Bytes::get(bytes, at = j))
            j = j + 1
            rv = rv + 1
          }
        }
        Array::push(out_sigs, value = sig)
        t = t + 1
      }
    }
  }
}

export let comp_extern_func: Int = 1

let comp_valtype_f32: Int = 118

let comp_valtype_f64: Int = 117

export let comp_valtype_s32: Int = 122

export let comp_valtype_s64: Int = 120

export fn emit_raw_content(buf: Bytes, content: Bytes) -> Unit {
  leb128_encode_u32(buf = buf, value = Bytes::length(content))
  bytebuf_push_buf(dst = buf, src = content)
}

fn read_name_string(bytes: Bytes, start: Int) -> String {
  let (name_len, after_len) = read_name_info(bytes = bytes, start = start)
  // Char-by-char: was `s = String::concat(s, char)` per byte, O(N²) on
  // the name length (which can be hundreds of chars for mangled
  // identifiers).
  let buf = StringBuilder::new()
  let mut i = 0
  while i < name_len {
    StringBuilder::push(buf, value = String::from_char_code(Bytes::get(bytes, at = after_len + i)))
    i = i + 1
  }
  StringBuilder::freeze(buf)
}

fn skip_wasm_limits(bytes: Bytes, start: Int, end_pos: Int) -> Int {
  let mut i = start
  if i >= end_pos {
    end_pos
  }
  else {
    let flags = Bytes::get(bytes, at = i)
    i = i + 1
    let (min_limit, next_i1) = read_uleb(bytes = bytes, start = i)
    let _ = min_limit
    i = next_i1
    if (flags&1) != 0 {
      let (max_limit, next_i2) = read_uleb(bytes = bytes, start = i)
      let _ = max_limit
      i = next_i2
    }
    if (flags&4) != 0 {
      let (page_size, next_i3) = read_uleb(bytes = bytes, start = i)
      let _ = page_size
      i = next_i3
    }
    if i > end_pos {
      end_pos
    } else {
      i
    }
  }
}

let component_magic_0: Int = 0

let component_magic_1: Int = 97

let component_magic_2: Int = 115

let component_magic_3: Int = 109

export fn emit_alias_section(buf: Bytes, core_instance_idx: Int, names: Array[String], sorts: Array[Int]) -> Unit {
  let count = Array::length(names)
  if count == 0 {
    ()
  }
  else {
    bytebuf_push(buf = buf, byte = section_alias)
    let content = bytebuf_new()
    leb128_encode_u32(buf = content, value = count)
    let mut i = 0
    while i < count {
      bytebuf_push(buf = content, byte = 0)
      bytebuf_push(buf = content, byte = Array::get(sorts, at = i))
      bytebuf_push(buf = content, byte = 1)
      leb128_encode_u32(buf = content, value = core_instance_idx)
      emit_name(buf = content, name = Array::get(names, at = i))
      i = i + 1
    }
    emit_raw_content(buf = buf, content = content)
  }
}

export let comp_valtype_string: Int = 115

export let comp_valtype_bool: Int = 127

let component_version_0: Int = 13

let component_version_1: Int = 0

let component_version_2: Int = 1

let component_version_3: Int = 0

fn core_to_comp_valtype(_ v: Int) -> Int {
  if v == 127 {
    comp_valtype_s32
  }
  else {
    if v == 126 {
      comp_valtype_s64
    }
    else {
      if v == 125 {
        comp_valtype_f32
      }
      else {
        if v == 124 {
          comp_valtype_f64
        }
        else {
          0 - 1
        }
      }
    }
  }
}

export fn emit_canon_lift_func(content: Bytes, core_func_idx: Int, type_idx: Int, need_string: Int, memory_idx: Int, realloc_idx: Int) -> Unit {
  bytebuf_push(buf = content, byte = 0)
  bytebuf_push(buf = content, byte = 0)
  leb128_encode_u32(buf = content, value = core_func_idx)
  if need_string != 0 {
    leb128_encode_u32(buf = content, value = 3)
    bytebuf_push(buf = content, byte = 0)
    bytebuf_push(buf = content, byte = 3)
    leb128_encode_u32(buf = content, value = memory_idx)
    bytebuf_push(buf = content, byte = 4)
    leb128_encode_u32(buf = content, value = realloc_idx)
  } else {
    leb128_encode_u32(buf = content, value = 0)
  }
  leb128_encode_u32(buf = content, value = type_idx)
}

export fn emit_component_header(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = component_magic_0)
  bytebuf_push(buf = buf, byte = component_magic_1)
  bytebuf_push(buf = buf, byte = component_magic_2)
  bytebuf_push(buf = buf, byte = component_magic_3)
  bytebuf_push(buf = buf, byte = component_version_0)
  bytebuf_push(buf = buf, byte = component_version_1)
  bytebuf_push(buf = buf, byte = component_version_2)
  bytebuf_push(buf = buf, byte = component_version_3)
}

export let section_core_instance: Int = 2

fn skip_core_import_desc(bytes: Bytes, start: Int, kind: Int, end_pos: Int) -> Int {
  let mut i = start
  if kind == 1 {
    if i < end_pos {
      i = i + 1
    }
    i = skip_wasm_limits(bytes = bytes, start = i, end_pos = end_pos)
  } else {
    if kind == 2 {
      i = skip_wasm_limits(bytes = bytes, start = i, end_pos = end_pos)
    } else {
      if kind == 3 {
        if (i + 2) <= end_pos {
          i = i + 2
        } else {
          i = end_pos
        }
      } else {
        if kind == 4 {
          if i < end_pos {
            i = i + 1
          }
          let (type_idx, next_i) = read_uleb(bytes = bytes, start = i)
          let _ = type_idx
          i = next_i
        } else {
          i = end_pos
        }
      }
    }
  }
  if i > end_pos {
    end_pos
  } else {
    i
  }
}

export fn parse_core_exports(core_wasm: Bytes, out_names: Array[String], out_func_indices: Array[Int], out_type_sigs: Array[Array[Int]]) -> Int {
  let len = Bytes::length(core_wasm)
  if len < 8 {
    0
  }
  else {
    let type_sigs = array_empty()
    let func_type_indices = new_int_array()
    let mut import_func_count = 0
    let mut i = 8
    let mut export_count = 0
    while i < len {
      let sec_id = Bytes::get(core_wasm, at = i)
      i = i + 1
      let (sec_size, next_i) = read_uleb(bytes = core_wasm, start = i)
      i = next_i
      let sec_end = i + sec_size
      if sec_end > len {
        i = len
      }
      else {
        if sec_id == 1 {
          parse_type_sigs(bytes = core_wasm, sec_start = i, sec_end = sec_end, out_sigs = type_sigs)
        } else {
          if sec_id == 2 {
            let mut j = i
            let (imp_count, next_j) = read_uleb(bytes = core_wasm, start = j)
            j = next_j
            let mut imp = 0
            while imp < imp_count {
              if j >= sec_end {
                imp = imp_count
              }
              else {
                j = skip_name(bytes = core_wasm, start = j)
                j = skip_name(bytes = core_wasm, start = j)
                if j >= sec_end {
                  imp = imp_count
                }
                else {
                  let kind = Bytes::get(core_wasm, at = j)
                  j = j + 1
                  if kind == 0 {
                    let (type_idx, next_j2) = read_uleb(bytes = core_wasm, start = j)
                    let _ = type_idx
                    j = next_j2
                    import_func_count = import_func_count + 1
                  } else {
                    j = skip_core_import_desc(bytes = core_wasm, start = j, kind = kind, end_pos = sec_end)
                  }
                  imp = imp + 1
                }
              }
            }
          } else {
            if sec_id == 3 {
              let mut j = i
              let (func_count, next_j) = read_uleb(bytes = core_wasm, start = j)
              j = next_j
              let mut f = 0
              while f < func_count {
                if j >= sec_end {
                  f = func_count
                }
                else {
                  let (type_idx, next_j2) = read_uleb(bytes = core_wasm, start = j)
                  Array::push(func_type_indices, value = type_idx)
                  j = next_j2
                  f = f + 1
                }
              }
            } else {
              if sec_id == 7 {
                let mut j = i
                let (exp_count, next_j) = read_uleb(bytes = core_wasm, start = j)
                j = next_j
                let mut e = 0
                while e < exp_count {
                  if j >= sec_end {
                    e = exp_count
                  }
                  else {
                    let name = read_name_string(bytes = core_wasm, start = j)
                    j = skip_name(bytes = core_wasm, start = j)
                    if j >= sec_end {
                      e = exp_count
                    }
                    else {
                      let kind = Bytes::get(core_wasm, at = j)
                      j = j + 1
                      let (index, next_j2) = read_uleb(bytes = core_wasm, start = j)
                      j = next_j2
                      if kind == 0 {
                        let type_idx = if index < import_func_count {
                          0 - 1
                        }
                        else {
                          let local_idx = index - import_func_count
                          if local_idx < Array::length(func_type_indices) {
                            Array::get(func_type_indices, at = local_idx)
                          } else {
                            0 - 1
                          }
                        }
                        if (type_idx >= 0) && (type_idx < Array::length(type_sigs)) {
                          Array::push(out_names, value = name)
                          Array::push(out_func_indices, value = index)
                          Array::push(out_type_sigs, value = Array::get(type_sigs, at = type_idx))
                          export_count = export_count + 1
                        }
                      }
                      e = e + 1
                    }
                  }
                }
              }
            }
          }
        }
        i = sec_end
      }
    }
    export_count
  }
}

export fn parse_core_imports(core_wasm: Bytes, out_module_names: Array[String], out_func_names: Array[String], out_type_indices: Array[Int], out_type_sigs: Array[Array[Int]]) -> Int {
  let len = Bytes::length(core_wasm)
  if len < 8 {
    0
  }
  else {
    let mut i = 8
    let mut import_count = 0
    while i < len {
      let sec_id = Bytes::get(core_wasm, at = i)
      i = i + 1
      let (sec_size, next_i) = read_uleb(bytes = core_wasm, start = i)
      i = next_i
      let sec_end = i + sec_size
      if sec_end > len {
        i = len
      }
      else {
        if sec_id == 1 {
          parse_type_sigs(bytes = core_wasm, sec_start = i, sec_end = sec_end, out_sigs = out_type_sigs)
        } else {
          if sec_id == 2 {
            let mut j = i
            let (imp_count, next_j) = read_uleb(bytes = core_wasm, start = j)
            j = next_j
            let mut imp = 0
            while imp < imp_count {
              if j >= sec_end {
                imp = imp_count
              }
              else {
                let mod_name = read_name_string(bytes = core_wasm, start = j)
                j = skip_name(bytes = core_wasm, start = j)
                let fn_name = read_name_string(bytes = core_wasm, start = j)
                j = skip_name(bytes = core_wasm, start = j)
                if j >= sec_end {
                  imp = imp_count
                }
                else {
                  let kind = Bytes::get(core_wasm, at = j)
                  j = j + 1
                  if kind == 0 {
                    let (type_idx, next_j2) = read_uleb(bytes = core_wasm, start = j)
                    j = next_j2
                    Array::push(out_module_names, value = mod_name)
                    Array::push(out_func_names, value = fn_name)
                    Array::push(out_type_indices, value = type_idx)
                    import_count = import_count + 1
                  } else {
                    j = skip_core_import_desc(bytes = core_wasm, start = j, kind = kind, end_pos = sec_end)
                  }
                  imp = imp + 1
                }
              }
            }
          }
        }
        i = sec_end
      }
    }
    import_count
  }
}

/// Read the value representation published by linked_compile. This is an ABI
/// contract, not a hint: absence, malformed payloads, unsupported values, and
/// conflicting declarations all fail before composition instead of guessing
/// a convention and producing a plausible wrong value.
export fn comp_core_tag_mode(_ core_wasm: Bytes) -> Int with Exception {
  let len = Bytes::length(core_wasm)
  let mut i = 8
  let mut found = 0 - 1
  while i < len {
    let sec_id = Bytes::get(core_wasm, at = i)
    i = i + 1
    let (sec_size, next_i) = read_uleb(bytes = core_wasm, start = i)
    i = next_i
    let sec_end = i + sec_size
    if sec_end > len {
      throw("component: malformed core section while reading vibe.tagmode")
    } else {
      if sec_id == 0 && read_name_string(bytes = core_wasm, start = i) == "vibe.tagmode" {
        let payload = skip_name(bytes = core_wasm, start = i)
        if payload + 4 != sec_end {
          throw("component: malformed vibe.tagmode section (expected one i32 payload)")
        } else {
          let mode = Bytes::get(core_wasm, at = payload)|
          (Bytes::get(core_wasm, at = payload + 1)<<8)|
          (Bytes::get(core_wasm, at = payload + 2)<<16)|
          (Bytes::get(core_wasm, at = payload + 3)<<24)
          if mode != 0 && mode != 1 {
            throw("component: unsupported vibe.tagmode \{mode} (expected 0 or 1)")
          } else if found >= 0 {
            throw("component: duplicate or conflicting vibe.tagmode sections")
          } else {
            found = mode
          }
        }
      } else {
        ()
      }
      i = sec_end
    }
  }
  if found < 0 {
    throw("component: core is missing required vibe.tagmode section")
  } else {
    found
  }
}

export fn comp_require_tag_mode(core_wasm: Bytes, expected: Int, context: String) -> Unit with Exception {
  let actual = comp_core_tag_mode(core_wasm)
  if actual != expected {
    throw("\{context}: core vibe.tagmode is \{actual}, expected \{expected}")
  } else {
    ()
  }
}

fn build_import_plan(core_wasm: Bytes, out_import_names: Array[String], out_binding_func_names: Array[String], out_binding_func_indices: Array[Int], out_unique_module_names: Array[String], out_module_binding_counts: Array[Int], out_comp_params: Array[Array[Int]], out_comp_param_names: Array[Array[String]], out_comp_results: Array[Array[Int]]) -> Int {
  let imp_module_names = array_empty()
  let imp_func_names = array_empty()
  let imp_type_indices = new_int_array()
  let type_sigs = array_empty()
  let _ = parse_core_imports(core_wasm = core_wasm, out_module_names = imp_module_names, out_func_names = imp_func_names, out_type_indices = imp_type_indices, out_type_sigs = type_sigs)
  let seen_keys = array_empty()
  let module_idx_map_keys = array_empty()
  let module_idx_map_vals = new_int_array()
  let mut binding_count = 0
  let mut i = 0
  while i < Array::length(imp_module_names) {
    let mod_name = Array::get(imp_module_names, at = i)
    let fn_name = Array::get(imp_func_names, at = i)
    let key = "\{mod_name}||\{fn_name}"
    let mut already = false
    let mut s = 0
    while s < Array::length(seen_keys) {
      if Array::get(seen_keys, at = s) == key {
        already = true
      }
      s = s + 1
    }
    if already == false {
      Array::push(seen_keys, value = key)
      let type_idx = Array::get(imp_type_indices, at = i)
      if type_idx < Array::length(type_sigs) {
        let sig = Array::get(type_sigs, at = type_idx)
        let param_count = Array::get(sig, at = 0)
        let result_count_index = 1 + param_count
        let result_count = Array::get(sig, at = result_count_index)
        let comp_params = new_int_array()
        let mut valid = true
        let mut p = 0
        while p < param_count {
          let cv = core_to_comp_valtype(Array::get(sig, at = 1 + p))
          if cv < 0 {
            valid = false
          }
          else {
            Array::push(comp_params, value = cv)
          }
          p = p + 1
        }
        let comp_results = new_int_array()
        let mut r = 0
        while r < result_count {
          let cv = core_to_comp_valtype(Array::get(sig, at = result_count_index + 1 + r))
          if cv < 0 {
            valid = false
          }
          else {
            Array::push(comp_results, value = cv)
          }
          r = r + 1
        }
        if valid {
          let mut mod_idx = 0 - 1
          let mut mi = 0
          while mi < Array::length(module_idx_map_keys) {
            if Array::get(module_idx_map_keys, at = mi) == mod_name {
              mod_idx = Array::get(module_idx_map_vals, at = mi)
            }
            mi = mi + 1
          }
          if mod_idx < 0 {
            mod_idx = Array::length(out_unique_module_names)
            Array::push(out_unique_module_names, value = mod_name)
            Array::push(out_module_binding_counts, value = 0)
            Array::push(module_idx_map_keys, value = mod_name)
            Array::push(module_idx_map_vals, value = mod_idx)
          }
          let import_name = "import-\{binding_count}"
          Array::push(out_import_names, value = import_name)
          Array::push(out_binding_func_names, value = fn_name)
          Array::push(out_binding_func_indices, value = binding_count)
          Array::push(out_comp_params, value = comp_params)
          let empty_names = array_empty()
          Array::push(out_comp_param_names, value = empty_names)
          Array::push(out_comp_results, value = comp_results)
          let cur = Array::get(out_module_binding_counts, at = mod_idx)
          Array::set(out_module_binding_counts, at = mod_idx, value = cur + 1)
          binding_count = binding_count + 1
        }
      }
    }
    i = i + 1
  }
  binding_count
}

let comp_inst_arg_instance: Int = 18

fn emit_canon_lift_section(buf: Bytes, core_func_idx: Int, type_idx: Int) -> Unit {
  bytebuf_push(buf = buf, byte = section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  emit_canon_lift_func(content = content, core_func_idx = core_func_idx, type_idx = type_idx, need_string = 0, memory_idx = 0, realloc_idx = 0)
  emit_raw_content(buf = buf, content = content)
}

fn emit_canon_lower_section(buf: Bytes, count: Int) -> Unit {
  if count == 0 {
    ()
  }
  else {
    bytebuf_push(buf = buf, byte = section_canon)
    let content = bytebuf_new()
    leb128_encode_u32(buf = content, value = count)
    let mut i = 0
    while i < count {
      bytebuf_push(buf = content, byte = 1)
      bytebuf_push(buf = content, byte = 0)
      leb128_encode_u32(buf = content, value = i)
      leb128_encode_u32(buf = content, value = 0)
      i = i + 1
    }
    emit_raw_content(buf = buf, content = content)
  }
}

export fn emit_comp_import_section(buf: Bytes, import_names: Array[String], count: Int) -> Unit {
  if count == 0 {
    ()
  }
  else {
    bytebuf_push(buf = buf, byte = section_import)
    let content = bytebuf_new()
    leb128_encode_u32(buf = content, value = count)
    let mut i = 0
    while i < count {
      bytebuf_push(buf = content, byte = 0)
      emit_name(buf = content, name = Array::get(import_names, at = i))
      bytebuf_push(buf = content, byte = comp_extern_func)
      leb128_encode_u32(buf = content, value = i)
      i = i + 1
    }
    emit_raw_content(buf = buf, content = content)
  }
}

export fn emit_core_module_section(buf: Bytes, core_wasm: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = section_module)
  let wasm_len = Bytes::length(core_wasm)
  leb128_encode_u32(buf = buf, value = wasm_len)
  bytebuf_push_buf(dst = buf, src = core_wasm)
}

fn emit_alias_run_and_memory(buf: Bytes, core_instance_idx: Int) -> Unit {
  emit_alias_section(buf = buf, core_instance_idx = core_instance_idx, names = ["_start", "memory"], sorts = [
    core_sort_func,
    core_sort_mem
  ])
}

/// Seed-compatible `_` -> `-` rewrite. `String::replace_all` is newer than the
/// pinned selfhost seed's frozen prelude, so a manual char loop keeps this file
/// buildable from the fixed seed (docs/selfhost-bootstrap.md, new-feature rule).
fn comp_underscores_to_dashes(_ name: String) -> String {
  let len = String::length(name)
  let mut out = ""
  let mut i = 0
  while i < len {
    let c = String::char_code_at(name, at = i)
    if c == 95 {
      out = String::concat(out, "-")
    } else {
      out = String::concat(out, String::from_char_code(c))
    }
    i = i + 1
  }
  out
}

fn normalize_comp_param_name(_ name: String) -> String {
  comp_underscores_to_dashes(name)
}

export fn emit_comp_func_type(content: Bytes, param_types: Array[Int], param_names: Array[String], result_types: Array[Int], is_async: Int) -> Unit {
  if is_async != 0 {
    bytebuf_push(buf = content, byte = 67)
  } else {
    bytebuf_push(buf = content, byte = 64)
  }
  leb128_encode_u32(buf = content, value = Array::length(param_types))
  let mut i = 0
  while i < Array::length(param_types) {
    let name = if i < Array::length(param_names) {
      normalize_comp_param_name(Array::get(param_names, at = i))
    }
    else {
      "p\{i}"
    }
    emit_name(buf = content, name = name)
    bytebuf_push(buf = content, byte = Array::get(param_types, at = i))
    i = i + 1
  }
  if Array::length(result_types) == 0 {
    bytebuf_push(buf = content, byte = 1)
    leb128_encode_u32(buf = content, value = 0)
  } else {
    if Array::length(result_types) == 1 {
      bytebuf_push(buf = content, byte = 0)
      bytebuf_push(buf = content, byte = Array::get(result_types, at = 0))
    } else {
      bytebuf_push(buf = content, byte = 1)
      leb128_encode_u32(buf = content, value = Array::length(result_types))
      let mut r = 0
      while r < Array::length(result_types) {
        emit_name(buf = content, name = "r\{r}")
        bytebuf_push(buf = content, byte = Array::get(result_types, at = r))
        r = r + 1
      }
    }
  }
}

fn emit_comp_type_section(buf: Bytes, sigs_params: Array[Array[Int]], sigs_param_names: Array[Array[String]], sigs_results: Array[Array[Int]], sigs_async: Array[Int]) -> Unit {
  let count = Array::length(sigs_params)
  if count == 0 {
    ()
  }
  else {
    bytebuf_push(buf = buf, byte = section_type)
    let content = bytebuf_new()
    leb128_encode_u32(buf = content, value = count)
    let mut i = 0
    while i < count {
      emit_comp_func_type(content = content, param_types = Array::get(sigs_params, at = i), param_names = Array::get(sigs_param_names, at = i), result_types = Array::get(sigs_results, at = i), is_async = Array::get(sigs_async, at = i))
      i = i + 1
    }
    emit_raw_content(buf = buf, content = content)
  }
}

fn emit_comp_type_section_run(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = section_type)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  emit_comp_func_type(content = content, param_types = array_empty(), param_names = array_empty(), result_types = [comp_valtype_s64], is_async = 0)
  emit_raw_content(buf = buf, content = content)
}

fn normalize_comp_export_name(_ name: String) -> String {
  comp_underscores_to_dashes(name)
}

export fn emit_comp_export_section(buf: Bytes, name: String, func_idx: Int) -> Unit {
  let export_name = normalize_comp_export_name(name)
  bytebuf_push(buf = buf, byte = section_export)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  bytebuf_push(buf = content, byte = 0)
  emit_name(buf = content, name = export_name)
  bytebuf_push(buf = content, byte = comp_extern_func)
  leb128_encode_u32(buf = content, value = func_idx)
  leb128_encode_u32(buf = content, value = 0)
  emit_raw_content(buf = buf, content = content)
}

export fn comp_generate_string_trampoline(string_param_count: Int, call_run_init: Int) -> Bytes {
  let buf = bytebuf_new()
  bytebuf_push(buf = buf, byte = 0)
  bytebuf_push(buf = buf, byte = 97)
  bytebuf_push(buf = buf, byte = 115)
  bytebuf_push(buf = buf, byte = 109)
  bytebuf_push(buf = buf, byte = 1)
  bytebuf_push(buf = buf, byte = 0)
  bytebuf_push(buf = buf, byte = 0)
  bytebuf_push(buf = buf, byte = 0)
  let body = bytebuf_new()
  let type_sec = bytebuf_new()
  leb128_encode_u32(buf = type_sec, value = if call_run_init != 0 {
    4
  } else {
    3
  })
  bytebuf_push(buf = type_sec, byte = 96)
  leb128_encode_u32(buf = type_sec, value = string_param_count + 1)
  let mut ti = 0
  while ti < string_param_count {
    bytebuf_push(buf = type_sec, byte = 126)
    ti = ti + 1
  }
  bytebuf_push(buf = type_sec, byte = 127)
  bytebuf_push(buf = type_sec, byte = 1)
  bytebuf_push(buf = type_sec, byte = 126)
  bytebuf_push(buf = type_sec, byte = 96)
  bytebuf_push(buf = type_sec, byte = 4)
  bytebuf_push(buf = type_sec, byte = 127)
  bytebuf_push(buf = type_sec, byte = 127)
  bytebuf_push(buf = type_sec, byte = 127)
  bytebuf_push(buf = type_sec, byte = 127)
  bytebuf_push(buf = type_sec, byte = 1)
  bytebuf_push(buf = type_sec, byte = 127)
  bytebuf_push(buf = type_sec, byte = 96)
  leb128_encode_u32(buf = type_sec, value = string_param_count * 2)
  let mut ci = 0
  while ci < (string_param_count * 2) {
    bytebuf_push(buf = type_sec, byte = 127)
    ci = ci + 1
  }
  bytebuf_push(buf = type_sec, byte = 1)
  bytebuf_push(buf = type_sec, byte = 126)
  if call_run_init != 0 {
    bytebuf_push(buf = type_sec, byte = 96)
    leb128_encode_u32(buf = type_sec, value = 0)
    bytebuf_push(buf = type_sec, byte = 1)
    bytebuf_push(buf = type_sec, byte = 126)
  }
  bytebuf_push_section(out = body, section_id = 1, content = type_sec)
  let import_sec = bytebuf_new()
  leb128_encode_u32(buf = import_sec, value = if call_run_init != 0 {
    4
  } else {
    3
  })
  emit_name(buf = import_sec, name = "env")
  emit_name(buf = import_sec, name = "target_func")
  bytebuf_push(buf = import_sec, byte = 0)
  leb128_encode_u32(buf = import_sec, value = 0)
  emit_name(buf = import_sec, name = "env")
  emit_name(buf = import_sec, name = "cabi_realloc")
  bytebuf_push(buf = import_sec, byte = 0)
  leb128_encode_u32(buf = import_sec, value = 1)
  if call_run_init != 0 {
    emit_name(buf = import_sec, name = "env")
    emit_name(buf = import_sec, name = "run_init")
    bytebuf_push(buf = import_sec, byte = 0)
    leb128_encode_u32(buf = import_sec, value = 3)
  }
  emit_name(buf = import_sec, name = "env")
  emit_name(buf = import_sec, name = "memory")
  bytebuf_push(buf = import_sec, byte = 2)
  bytebuf_push(buf = import_sec, byte = 0)
  leb128_encode_u32(buf = import_sec, value = 0)
  bytebuf_push_section(out = body, section_id = 2, content = import_sec)
  let func_sec = bytebuf_new()
  leb128_encode_u32(buf = func_sec, value = 1)
  leb128_encode_u32(buf = func_sec, value = 2)
  bytebuf_push_section(out = body, section_id = 3, content = func_sec)
  let export_sec = bytebuf_new()
  leb128_encode_u32(buf = export_sec, value = 1)
  emit_name(buf = export_sec, name = "canon_func")
  bytebuf_push(buf = export_sec, byte = 0)
  leb128_encode_u32(buf = export_sec, value = if call_run_init != 0 {
    3
  } else {
    2
  })
  bytebuf_push_section(out = body, section_id = 7, content = export_sec)
  let code_sec = bytebuf_new()
  leb128_encode_u32(buf = code_sec, value = 1)
  let func_body = bytebuf_new()
  leb128_encode_u32(buf = func_body, value = 2)
  leb128_encode_u32(buf = func_body, value = string_param_count)
  bytebuf_push(buf = func_body, byte = 126)
  leb128_encode_u32(buf = func_body, value = string_param_count)
  bytebuf_push(buf = func_body, byte = 127)
  if call_run_init != 0 {
    bytebuf_push(buf = func_body, byte = 16)
    leb128_encode_u32(buf = func_body, value = 2)
    bytebuf_push(buf = func_body, byte = 26)
  }
  let tagged_base = string_param_count * 2
  let obj_base = tagged_base + string_param_count
  let mut si = 0
  while si < string_param_count {
    let ptr_local = si * 2
    let len_local = (si * 2) + 1
    let tagged_local = tagged_base + si
    let obj_local = obj_base + si
    emit_i32_const(buf = func_body, value = 0)
    emit_i32_const(buf = func_body, value = 0)
    emit_i32_const(buf = func_body, value = 4)
    emit_local_get(buf = func_body, idx = len_local)
    emit_i32_const(buf = func_body, value = 8)
    emit_i32_add(func_body)
    bytebuf_push(buf = func_body, byte = 16)
    leb128_encode_u32(buf = func_body, value = 1)
    emit_local_set(buf = func_body, idx = obj_local)
    emit_local_get(buf = func_body, idx = obj_local)
    emit_i32_const(buf = func_body, value = 1)
    emit_i32_store(buf = func_body, align = 0, offset = 0)
    emit_local_get(buf = func_body, idx = obj_local)
    emit_local_get(buf = func_body, idx = len_local)
    emit_i32_store(buf = func_body, align = 0, offset = 4)
    emit_local_get(buf = func_body, idx = obj_local)
    emit_i32_const(buf = func_body, value = 8)
    emit_i32_add(func_body)
    emit_local_get(buf = func_body, idx = ptr_local)
    emit_local_get(buf = func_body, idx = len_local)
    bytebuf_push(buf = func_body, byte = 252)
    leb128_encode_u32(buf = func_body, value = 10)
    bytebuf_push(buf = func_body, byte = 0)
    bytebuf_push(buf = func_body, byte = 0)
    emit_local_get(buf = func_body, idx = obj_local)
    bytebuf_push(buf = func_body, byte = 173)
    bytebuf_push(buf = func_body, byte = 66)
    leb128_encode_s64(buf = func_body, value = 1)
    bytebuf_push(buf = func_body, byte = 132)
    emit_local_set(buf = func_body, idx = tagged_local)
    si = si + 1
  }
  let mut ci2 = 0
  while ci2 < string_param_count {
    emit_local_get(buf = func_body, idx = tagged_base + ci2)
    ci2 = ci2 + 1
  }
  emit_i32_const(buf = func_body, value = 0)
  bytebuf_push(buf = func_body, byte = 16)
  leb128_encode_u32(buf = func_body, value = 0)
  bytebuf_push(buf = func_body, byte = 11)
  leb128_encode_u32(buf = code_sec, value = Bytes::length(func_body))
  bytebuf_push_buf(dst = code_sec, src = func_body)
  bytebuf_push_section(out = body, section_id = 10, content = code_sec)
  bytebuf_push_buf(dst = buf, src = body)
  bytebuf_to_bytes(buf)
}

export fn emit_core_instance_from_exports(buf: Bytes, num_modules: Int, module_binding_counts: Array[Int], binding_func_names: Array[String], binding_func_indices: Array[Int]) -> Unit {
  if num_modules == 0 {
    ()
  }
  else {
    bytebuf_push(buf = buf, byte = section_core_instance)
    let content = bytebuf_new()
    leb128_encode_u32(buf = content, value = num_modules)
    let mut offset = 0
    let mut m = 0
    while m < num_modules {
      let count = Array::get(module_binding_counts, at = m)
      bytebuf_push(buf = content, byte = 1)
      leb128_encode_u32(buf = content, value = count)
      let mut b = 0
      while b < count {
        emit_name(buf = content, name = Array::get(binding_func_names, at = offset + b))
        bytebuf_push(buf = content, byte = core_sort_func)
        leb128_encode_u32(buf = content, value = Array::get(binding_func_indices, at = offset + b))
        b = b + 1
      }
      offset = offset + count
      m = m + 1
    }
    emit_raw_content(buf = buf, content = content)
  }
}

export fn emit_core_instance_instantiate_section(buf: Bytes, module_index: Int, module_names: Array[String]) -> Unit {
  bytebuf_push(buf = buf, byte = section_core_instance)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  bytebuf_push(buf = content, byte = 0)
  leb128_encode_u32(buf = content, value = module_index)
  leb128_encode_u32(buf = content, value = Array::length(module_names))
  let mut i = 0
  while i < Array::length(module_names) {
    emit_name(buf = content, name = Array::get(module_names, at = i))
    bytebuf_push(buf = content, byte = comp_inst_arg_instance)
    leb128_encode_u32(buf = content, value = i)
    i = i + 1
  }
  emit_raw_content(buf = buf, content = content)
}

export fn comp_emit_component_wasm(_ core_wasm: Bytes) -> Bytes {
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf = buf, core_wasm = core_wasm)
  emit_core_instance_instantiate_section(buf = buf, module_index = 0, module_names = array_empty())
  emit_alias_run_and_memory(buf = buf, core_instance_idx = 0)
  bytebuf_to_bytes(buf)
}

export fn comp_emit_component_wasm_with_lift(core_wasm: Bytes, export_name: String) -> Bytes {
  let import_names = array_empty()
  let binding_func_names = array_empty()
  let binding_func_indices = new_int_array()
  let unique_module_names = array_empty()
  let module_binding_counts = new_int_array()
  let comp_params = array_empty()
  let comp_param_names = array_empty()
  let comp_results = array_empty()
  let import_func_count = build_import_plan(core_wasm = core_wasm, out_import_names = import_names, out_binding_func_names = binding_func_names, out_binding_func_indices = binding_func_indices, out_unique_module_names = unique_module_names, out_module_binding_counts = module_binding_counts, out_comp_params = comp_params, out_comp_param_names = comp_param_names, out_comp_results = comp_results)
  let main_instance_idx = Array::length(unique_module_names)
  let run_core_func_idx = import_func_count
  let run_type_idx = import_func_count
  let run_func_idx = import_func_count
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf = buf, core_wasm = core_wasm)
  let async_flags = new_int_array()
  let mut af = 0
  while af < import_func_count {
    Array::push(async_flags, value = 0)
    af = af + 1
  }
  emit_comp_type_section(buf = buf, sigs_params = comp_params, sigs_param_names = comp_param_names, sigs_results = comp_results, sigs_async = async_flags)
  emit_comp_import_section(buf = buf, import_names = import_names, count = import_func_count)
  emit_canon_lower_section(buf = buf, count = import_func_count)
  emit_core_instance_from_exports(buf = buf, num_modules = Array::length(unique_module_names), module_binding_counts = module_binding_counts, binding_func_names = binding_func_names, binding_func_indices = binding_func_indices)
  emit_core_instance_instantiate_section(buf = buf, module_index = 0, module_names = unique_module_names)
  emit_alias_run_and_memory(buf = buf, core_instance_idx = main_instance_idx)
  emit_comp_type_section_run(buf)
  emit_canon_lift_section(buf = buf, core_func_idx = run_core_func_idx, type_idx = run_type_idx)
  emit_comp_export_section(buf = buf, name = export_name, func_idx = run_func_idx)
  bytebuf_to_bytes(buf)
}

export fn comp_emit_component_wasm_with_string_lift(core_wasm: Bytes, target_func_name: String, export_name: String, string_param_count: Int, param_names: Array[String], is_async: Int) -> Bytes {
  let import_names = array_empty()
  let binding_func_names = array_empty()
  let binding_func_indices = new_int_array()
  let unique_module_names = array_empty()
  let module_binding_counts = new_int_array()
  let comp_params = array_empty()
  let comp_param_names = array_empty()
  let comp_results = array_empty()
  let export_names = array_empty()
  let export_func_indices = new_int_array()
  let export_type_sigs = array_empty()
  let import_func_count = build_import_plan(core_wasm = core_wasm, out_import_names = import_names, out_binding_func_names = binding_func_names, out_binding_func_indices = binding_func_indices, out_unique_module_names = unique_module_names, out_module_binding_counts = module_binding_counts, out_comp_params = comp_params, out_comp_param_names = comp_param_names, out_comp_results = comp_results)
  let _ = parse_core_exports(core_wasm = core_wasm, out_names = export_names, out_func_indices = export_func_indices, out_type_sigs = export_type_sigs)
  let mut call_run_init = 0
  let mut ei = 0
  while ei < Array::length(export_names) {
    if Array::get(export_names, at = ei) == "_start" {
      call_run_init = 1
      ei = Array::length(export_names)
    } else {
      ei = ei + 1
    }
  }
  let has_distinct_run_alias =
  if (call_run_init != 0) && (target_func_name != "_start") {
    1
  } else {
    0
  }
  let main_instance_idx = Array::length(unique_module_names)
  let trampoline_wasm = comp_generate_string_trampoline(string_param_count = string_param_count, call_run_init = call_run_init)
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf = buf, core_wasm = core_wasm)
  emit_core_module_section(buf = buf, core_wasm = trampoline_wasm)
  let async_flags = new_int_array()
  let mut af = 0
  while af < import_func_count {
    Array::push(async_flags, value = 0)
    af = af + 1
  }
  emit_comp_type_section(buf = buf, sigs_params = comp_params, sigs_param_names = comp_param_names, sigs_results = comp_results, sigs_async = async_flags)
  emit_comp_import_section(buf = buf, import_names = import_names, count = import_func_count)
  emit_canon_lower_section(buf = buf, count = import_func_count)
  emit_core_instance_from_exports(buf = buf, num_modules = Array::length(unique_module_names), module_binding_counts = module_binding_counts, binding_func_names = binding_func_names, binding_func_indices = binding_func_indices)
  emit_core_instance_instantiate_section(buf = buf, module_index = 0, module_names = unique_module_names)
  let alias_names = array_empty()
  let alias_sorts = new_int_array()
  Array::push(alias_names, value = target_func_name)
  Array::push(alias_sorts, value = core_sort_func)
  Array::push(alias_names, value = "cabi_realloc")
  Array::push(alias_sorts, value = core_sort_func)
  if has_distinct_run_alias != 0 {
    Array::push(alias_names, value = "_start")
    Array::push(alias_sorts, value = core_sort_func)
  }
  Array::push(alias_names, value = "memory")
  Array::push(alias_sorts, value = core_sort_mem)
  emit_alias_section(buf = buf, core_instance_idx = main_instance_idx, names = alias_names, sorts = alias_sorts)
  let target_func_core_idx = import_func_count
  let cabi_realloc_core_idx = import_func_count + 1
  let run_init_core_idx =
  if call_run_init != 0 {
    if has_distinct_run_alias != 0 {
      import_func_count + 2
    } else {
      target_func_core_idx
    }
  } else {
    0 - 1
  }
  bytebuf_push(buf = buf, byte = section_core_instance)
  let tramp_env = bytebuf_new()
  leb128_encode_u32(buf = tramp_env, value = 1)
  bytebuf_push(buf = tramp_env, byte = 1)
  leb128_encode_u32(buf = tramp_env, value = if call_run_init != 0 {
    4
  } else {
    3
  })
  emit_name(buf = tramp_env, name = "target_func")
  bytebuf_push(buf = tramp_env, byte = core_sort_func)
  leb128_encode_u32(buf = tramp_env, value = target_func_core_idx)
  emit_name(buf = tramp_env, name = "cabi_realloc")
  bytebuf_push(buf = tramp_env, byte = core_sort_func)
  leb128_encode_u32(buf = tramp_env, value = cabi_realloc_core_idx)
  if call_run_init != 0 {
    emit_name(buf = tramp_env, name = "run_init")
    bytebuf_push(buf = tramp_env, byte = core_sort_func)
    leb128_encode_u32(buf = tramp_env, value = run_init_core_idx)
  }
  emit_name(buf = tramp_env, name = "memory")
  bytebuf_push(buf = tramp_env, byte = core_sort_mem)
  leb128_encode_u32(buf = tramp_env, value = 0)
  emit_raw_content(buf = buf, content = tramp_env)
  let env_instance_idx = main_instance_idx + 1
  bytebuf_push(buf = buf, byte = section_core_instance)
  let tramp_inst = bytebuf_new()
  leb128_encode_u32(buf = tramp_inst, value = 1)
  bytebuf_push(buf = tramp_inst, byte = 0)
  leb128_encode_u32(buf = tramp_inst, value = 1)
  leb128_encode_u32(buf = tramp_inst, value = 1)
  emit_name(buf = tramp_inst, name = "env")
  bytebuf_push(buf = tramp_inst, byte = comp_inst_arg_instance)
  leb128_encode_u32(buf = tramp_inst, value = env_instance_idx)
  emit_raw_content(buf = buf, content = tramp_inst)
  let trampoline_instance_idx = env_instance_idx + 1
  emit_alias_section(buf = buf, core_instance_idx = trampoline_instance_idx, names = ["canon_func"], sorts = [
    core_sort_func
  ])
  let alias_func_count = if has_distinct_run_alias != 0 {
    3
  } else {
    2
  }
  let canon_func_core_idx = import_func_count + alias_func_count
  bytebuf_push(buf = buf, byte = section_type)
  let type_content = bytebuf_new()
  leb128_encode_u32(buf = type_content, value = 1)
  if is_async != 0 {
    bytebuf_push(buf = type_content, byte = 67)
  } else {
    bytebuf_push(buf = type_content, byte = 64)
  }
  leb128_encode_u32(buf = type_content, value = string_param_count)
  let mut pi = 0
  while pi < string_param_count {
    let pname = if pi < Array::length(param_names) {
      normalize_comp_param_name(Array::get(param_names, at = pi))
    }
    else {
      "p\{pi}"
    }
    emit_name(buf = type_content, name = pname)
    bytebuf_push(buf = type_content, byte = comp_valtype_string)
    pi = pi + 1
  }
  bytebuf_push(buf = type_content, byte = 0)
  bytebuf_push(buf = type_content, byte = comp_valtype_s64)
  emit_raw_content(buf = buf, content = type_content)
  let component_type_idx = import_func_count
  bytebuf_push(buf = buf, byte = section_canon)
  let canon_content = bytebuf_new()
  leb128_encode_u32(buf = canon_content, value = 1)
  emit_canon_lift_func(content = canon_content, core_func_idx = canon_func_core_idx, type_idx = component_type_idx, need_string = 1, memory_idx = 0, realloc_idx = cabi_realloc_core_idx)
  emit_raw_content(buf = buf, content = canon_content)
  let lifted_func_idx = import_func_count
  emit_comp_export_section(buf = buf, name = export_name, func_idx = lifted_func_idx)
  bytebuf_to_bytes(buf)
}

/// WASI 0.3 async (M1b, docs/internal/design/wasi-p3-async.md §3.2). The `task.return`
/// canonical built-in lowers to a core func `(param <result>) -> ()` that
/// delivers an async-lifted export's result. Encoding verified byte-for-byte
/// against src/x/cm_async/cm_async_lift_probe.wat (runs on wasmtime 45):
/// section 0x08, body `01 09 00 <valtype> 00` (count=1; opcode 0x09; result
/// Some(valtype); empty options).
export fn emit_canon_task_return(buf: Bytes, result_valtype: Int) -> Unit {
  emit_canon_task_return_opts(buf = buf, result_valtype = result_valtype, mem_idx = -1, utf8 = false)
}

/// #1540: the same built-in for a result that lives in guest memory -- a
/// `string` result cannot be delivered without telling `task.return` which
/// memory to lift it out of, and in which encoding.
///
/// `mem_idx < 0` emits no memory option and `utf8 = false` no encoding one, so
/// `emit_canon_task_return` above stays byte-identical for every existing
/// caller.
///
/// `realloc` is deliberately absent: wasmtime rejects it outright here
/// ("cannot specify `realloc` option on `task.return`"), because this built-in
/// LIFTS the result out of guest memory -- it reads, it never allocates. Its
/// absence is measured, not assumed; see
/// tools/wasip3_component_probe/async_string_lift/component.wat.
///
/// Measured body for a string result: `01 09 00 73 02 03 <mem> 00`
/// (count=1; opcode 0x09; result Some(string); 2 options; Memory(mem); UTF8).
export fn emit_canon_task_return_opts(buf: Bytes, result_valtype: Int, mem_idx: Int, utf8: Bool) -> Unit {
  bytebuf_push(buf = buf, byte = section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  bytebuf_push(buf = content, byte = 9)
  bytebuf_push(buf = content, byte = 0)
  bytebuf_push(buf = content, byte = result_valtype)
  let mut nopts = 0
  if mem_idx >= 0 {
    nopts = nopts + 1
  } else {
    ()
  }
  if utf8 {
    nopts = nopts + 1
  } else {
    ()
  }
  leb128_encode_u32(buf = content, value = nopts)
  if mem_idx >= 0 {
    bytebuf_push(buf = content, byte = canonopt_memory)
    leb128_encode_u32(buf = content, value = mem_idx)
  } else {
    ()
  }
  if utf8 {
    bytebuf_push(buf = content, byte = canonopt_utf8)
  } else {
    ()
  }
  emit_raw_content(buf = buf, content = content)
}

/// Async (callback-less / stackful) `canon lift`. Unlike emit_canon_lift_func it
/// carries the async canonopt (0x06). Verified body: `01 00 00 <core_func_idx>
/// 01 06 <type_idx>` (count=1; lift; core-func sort; idx; 1 option = async).
export fn emit_canon_lift_async_section(buf: Bytes, core_func_idx: Int, type_idx: Int) -> Unit {
  emit_canon_lift_async_opts(buf = buf, core_func_idx = core_func_idx, type_idx = type_idx, mem_idx = -1, realloc_idx = -1, utf8 = false)
}

/// #1540: the async lift for a function whose params or result live in guest
/// memory. Unlike `task.return` above, this one DOES take `realloc` -- it
/// lowers the caller's arguments INTO guest memory, so it allocates.
///
/// Negative indices and `utf8 = false` drop the corresponding option, so
/// `emit_canon_lift_async_section` above stays byte-identical.
///
/// Measured body with all four: `01 00 00 <idx> 04 06 03 <mem> 04 <realloc> 00 <type>`
/// (count=1; lift; core-func sort; idx; 4 options = Async, Memory, Realloc,
/// UTF8; type idx). The order is the one wasmtime emits and accepts.
///
/// The component functype this lifts to must ALSO be declared async --
/// wasmtime rejects the option otherwise ("the `async` canonical option
/// requires an async function type"), which is why
/// `emit_comp_async_functype_params` below exists alongside it.
export fn emit_canon_lift_async_opts(buf: Bytes, core_func_idx: Int, type_idx: Int, mem_idx: Int, realloc_idx: Int, utf8: Bool) -> Unit {
  bytebuf_push(buf = buf, byte = section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  bytebuf_push(buf = content, byte = 0)
  bytebuf_push(buf = content, byte = 0)
  leb128_encode_u32(buf = content, value = core_func_idx)
  let mut nopts = 1
  if mem_idx >= 0 {
    nopts = nopts + 1
  } else {
    ()
  }
  if realloc_idx >= 0 {
    nopts = nopts + 1
  } else {
    ()
  }
  if utf8 {
    nopts = nopts + 1
  } else {
    ()
  }
  leb128_encode_u32(buf = content, value = nopts)
  bytebuf_push(buf = content, byte = canonopt_async)
  if mem_idx >= 0 {
    bytebuf_push(buf = content, byte = canonopt_memory)
    leb128_encode_u32(buf = content, value = mem_idx)
  } else {
    ()
  }
  if realloc_idx >= 0 {
    bytebuf_push(buf = content, byte = canonopt_realloc)
    leb128_encode_u32(buf = content, value = realloc_idx)
  } else {
    ()
  }
  if utf8 {
    bytebuf_push(buf = content, byte = canonopt_utf8)
  } else {
    ()
  }
  leb128_encode_u32(buf = content, value = type_idx)
  emit_raw_content(buf = buf, content = content)
}

/// Component type section with a single async func type `() -> <result>`.
/// Verified body: `01 43 00 00 <valtype>` (count=1; async functype opcode 0x43;
/// 0 params; result-form 0x00 + valtype).
export fn emit_comp_async_functype_section(buf: Bytes, result_valtype: Int) -> Unit {
  emit_comp_async_functype_params(buf = buf, param_names = array_empty(), param_valtypes = array_empty(), result_valtype = result_valtype)
}

/// #1540: the same async functype WITH named params. The zero-param spelling
/// above delegates here, so it stays byte-identical.
///
/// This has to be widened together with `emit_canon_lift_async_opts`: an async
/// lift is only legal against a functype that is itself declared async, and a
/// handler that takes its request as parameters needs those parameters on the
/// type. Measured body for one string param and a string result:
/// `01 43 01 04 6e 61 6d 65 73 00 73` (count=1; async functype 0x43; 1 param;
/// name "name"; string; result-form 0x00; string).
/// #1540: byte-shape fixture for the three widened emitters above.
///
/// They have no production caller yet -- the serve-emitter merge that needs
/// them is the next slice -- so this exists to make the ENCODING testable now,
/// the same way `comp_emit_component_wasm_async_stdin_provider_fixture` makes a
/// shape testable without a real source program.
///
/// It emits the exact section shapes measured in
/// `tools/wasip3_component_probe/async_string_lift/component.wat`, so the unit
/// test can assert byte equality against the sequences the probe gate pins
/// against wasmtime. If wasmtime's accepted encoding moves, the probe gate
/// fails; if this emitter drifts from it, the unit test fails. Neither can go
/// stale quietly on its own.
/// #1540: the memhost-with-realloc module on its own, so its shape is testable
/// before the serve-emitter merge gives it a caller.
export fn comp_emit_memhost_realloc_fixture() -> Bytes {
  comp_generate_memhost_realloc_module(1024)
}

export fn comp_emit_async_string_canon_fixture() -> Bytes {
  let buf = bytebuf_new()
  emit_comp_async_functype_params(buf = buf, param_names = ["name"], param_valtypes = [comp_valtype_string], result_valtype = comp_valtype_string)
  emit_canon_task_return_opts(buf = buf, result_valtype = comp_valtype_string, mem_idx = 0, utf8 = true)
  emit_canon_lift_async_opts(buf = buf, core_func_idx = 2, type_idx = 0, mem_idx = 0, realloc_idx = 0, utf8 = true)
  bytebuf_to_bytes(buf)
}

export fn emit_comp_async_functype_params(buf: Bytes, param_names: Array[String], param_valtypes: Array[Int], result_valtype: Int) -> Unit {
  bytebuf_push(buf = buf, byte = section_type)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  bytebuf_push(buf = content, byte = 67)
  leb128_encode_u32(buf = content, value = Array::length(param_names))
  let mut i = 0
  while i < Array::length(param_names) {
    emit_name(buf = content, name = Array::get(param_names, at = i))
    bytebuf_push(buf = content, byte = Array::get(param_valtypes, at = i))
    i = i + 1
  }
  bytebuf_push(buf = content, byte = 0)
  bytebuf_push(buf = content, byte = result_valtype)
  emit_raw_content(buf = buf, content = content)
}

/// Wrap a core module that imports ("cm","task-return") and exports a void `run`
/// into an async-lifted component export. Section order mirrors
/// cm_async_lift_probe.wat (verified to run on wasmtime 45 with
/// -W concurrency-support=y component-model-async=y component-model-async-stackful=y).
/// `result_valtype` is the component valtype of the lifted result (e.g.
/// comp_valtype_s64 for vibe Int).
export fn comp_emit_component_wasm_async(core_wasm: Bytes, export_name: String, result_valtype: Int) -> Bytes {
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf = buf, core_wasm = core_wasm)
  emit_canon_task_return(buf = buf, result_valtype = result_valtype)
  emit_core_instance_from_exports(buf = buf, num_modules = 1, module_binding_counts = [1], binding_func_names = ["task-return"], binding_func_indices = [0])
  emit_core_instance_instantiate_section(buf = buf, module_index = 0, module_names = ["cm"])
  emit_comp_async_functype_section(buf = buf, result_valtype = result_valtype)
  emit_alias_section(buf = buf, core_instance_idx = 1, names = ["run"], sorts = [core_sort_func])
  emit_canon_lift_async_section(buf = buf, core_func_idx = 1, type_idx = 0)
  emit_comp_export_section(buf = buf, name = export_name, func_idx = 0)
  bytebuf_to_bytes(buf)
}

/// Map a component valtype to the core valtype it lowers from (inverse of
/// core_to_comp_valtype). Used to type the trampoline module's entry/task-return.
export fn comp_valtype_to_core(_ v: Int) -> Int {
  if v == comp_valtype_s64 {
    126
  }
  else {
    if v == comp_valtype_s32 {
      127
    }
    else {
      if v == comp_valtype_f32 {
        125
      }
      else {
        if v == comp_valtype_f64 {
          124
        }
        else {
          127
        }
      }
    }
  }
}

/// M1b-2 (docs/internal/design/wasi-p3-async.md §3.4). Async trampoline core module: imports
/// the normally-compiled entry ("main","run" : () -> <core_valtype>) and
/// ("cm","task-return" : (<core_valtype>) -> ()), and exports a void `run` that
/// calls the entry and forwards its result to task.return. Byte template verified
/// against src/x/cm_async/cm_async_trampoline_probe.wat (runs on wasmtime 45).
export fn comp_generate_async_trampoline(_ core_valtype: Int) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(buf = tc, count = 3)
  // type0: the entry `run` — a nullary vibe fn compiles to (param i64) -> result
  // (the i64 is the unit argument), so the trampoline passes a dummy i64.
  emit_func_type_raw(buf = tc, param_types = [126], result_types = [core_valtype])
  emit_func_type_raw(buf = tc, param_types = [core_valtype], result_types = array_empty())
  emit_func_type_raw(buf = tc, param_types = array_empty(), result_types = array_empty())
  bytebuf_push_section(out = out, section_id = 1, content = tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(buf = ic, count = 2)
  emit_name(buf = ic, name = "main")
  emit_name(buf = ic, name = "run")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 0)
  emit_name(buf = ic, name = "cm")
  emit_name(buf = ic, name = "task-return")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 1)
  bytebuf_push_section(out = out, section_id = 2, content = ic)
  emit_function_section(out = out, type_indices = [2])
  emit_export_section(out = out, name = "run", func_idx = 2)
  let body = bytebuf_new()
  emit_i64_const(buf = body, value = 0)
  bytebuf_push(buf = body, byte = 16)
  leb128_encode_u32(buf = body, value = 0)
  bytebuf_push(buf = body, byte = 16)
  leb128_encode_u32(buf = body, value = 1)
  emit_code_section(out = out, bodies = [body])
  bytebuf_to_bytes(out)
}

/// Instantiate a core module with explicit (arg-name -> core-instance-index) args.
/// Unlike emit_core_instance_instantiate_section, the arg instance indices need
/// not be sequential.
export fn emit_core_instance_instantiate_args(buf: Bytes, module_index: Int, arg_names: Array[String], arg_instance_indices: Array[Int]) -> Unit {
  bytebuf_push(buf = buf, byte = section_core_instance)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  bytebuf_push(buf = content, byte = 0)
  leb128_encode_u32(buf = content, value = module_index)
  leb128_encode_u32(buf = content, value = Array::length(arg_names))
  let mut i = 0
  while i < Array::length(arg_names) {
    emit_name(buf = content, name = Array::get(arg_names, at = i))
    bytebuf_push(buf = content, byte = comp_inst_arg_instance)
    leb128_encode_u32(buf = content, value = Array::get(arg_instance_indices, at = i))
    i = i + 1
  }
  emit_raw_content(buf = buf, content = content)
}

/// Wrap a normally-compiled core module (exporting `run : () -> <core>`, value
/// returned directly) into an async-lifted component export via the trampoline
/// (two-module) approach — no change to the core module / linked_compile needed.
/// `comp_result_valtype` is the component valtype of the lifted result
/// (comp_valtype_s64 for vibe Int). Section order mirrors
/// cm_async_trampoline_probe.wat (verified to run on wasmtime 45).
export fn comp_emit_component_wasm_async_trampolined(main_core_wasm: Bytes, export_name: String, comp_result_valtype: Int) -> Bytes {
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf = buf, core_wasm = main_core_wasm)
  emit_core_module_section(buf = buf, core_wasm = comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))
  emit_core_instance_instantiate_section(buf = buf, module_index = 0, module_names = array_empty())
  emit_canon_task_return(buf = buf, result_valtype = comp_result_valtype)
  emit_core_instance_from_exports(buf = buf, num_modules = 1, module_binding_counts = [1], binding_func_names = ["task-return"], binding_func_indices = [0])
  emit_alias_section(buf = buf, core_instance_idx = 0, names = ["run"], sorts = [core_sort_func])
  emit_core_instance_from_exports(buf = buf, num_modules = 1, module_binding_counts = [1], binding_func_names = ["run"], binding_func_indices = [1])
  emit_core_instance_instantiate_args(buf = buf, module_index = 1, arg_names = ["main", "cm"], arg_instance_indices = [2, 1])
  emit_comp_async_functype_section(buf = buf, result_valtype = comp_result_valtype)
  emit_alias_section(buf = buf, core_instance_idx = 3, names = ["run"], sorts = [core_sort_func])
  emit_canon_lift_async_section(buf = buf, core_func_idx = 2, type_idx = 0)
  emit_comp_export_section(buf = buf, name = export_name, func_idx = 0)
  bytebuf_to_bytes(buf)
}

/// #1540: the memhost, plus a `cabi_realloc` the canon options can point at.
///
/// The async_string_lift probe surfaced this as a structural requirement, not a
/// convenience. `task.return` for a string result needs a memory, the async
/// lift needs a memory AND a realloc, and BOTH canons are declared before the
/// guest instance exists -- the guest imports `[task-return]`, so a
/// guest-owned memory or realloc would be an instantiation cycle. They have to
/// come from a module instantiated first.
///
/// A bump allocator is the whole implementation: nothing in this shape ever
/// frees, and the lift only needs somewhere to put the caller's arguments for
/// the duration of one call. It ignores the old-pointer / old-size arguments
/// for the same reason.
///
/// Deliberately a SEPARATE generator rather than an extra export on
/// `comp_generate_memhost_module`: every component built today embeds that
/// module, and adding an export would change all of their bytes for the
/// benefit of a shape none of them use.
export fn comp_generate_memhost_realloc_module(_ heap_start: Int) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(buf = tc, count = 1)
  emit_func_type_raw(buf = tc, param_types = [127, 127, 127, 127], result_types = [127])
  bytebuf_push_section(out = out, section_id = 1, content = tc)
  emit_function_section(out = out, type_indices = [0])
  emit_memory_section(out = out, min_pages = 1)
  // The caller derives this from every fixed data segment that shares the
  // memory. A fixed 1024 silently overlapped replies longer than 1008 bytes:
  // canonical lowering wrote its argument into the reply before task.return.
  emit_global_section_i32_mut(out = out, init_value = heap_start)
  // One export section with a MIXED kind list. `emit_export_memory` and
  // `emit_export_section` each emit their own section 7, and a core module may
  // carry only one -- the first cut did both and produced "section out of
  // order", caught by `wasm-tools validate` on the emitted bytes rather than by
  // any test that only inspected them.
  let exports = bytebuf_new()
  bytebuf_push_vec_header(buf = exports, count = 2)
  emit_name(buf = exports, name = "memory")
  bytebuf_push(buf = exports, byte = 2)
  leb128_encode_u32(buf = exports, value = 0)
  emit_name(buf = exports, name = "cabi_realloc")
  bytebuf_push(buf = exports, byte = 0)
  leb128_encode_u32(buf = exports, value = 0)
  bytebuf_push_section(out = out, section_id = 7, content = exports)
  let body = bytebuf_new()
  emit_global_get(buf = body, idx = 0)
  emit_global_get(buf = body, idx = 0)
  // align the bump by a fixed stride rather than by the requested size: the
  // shape this serves hands back one region per call and never reuses it.
  emit_i32_const(buf = body, value = 64)
  emit_i32_add(body)
  emit_global_set(buf = body, idx = 0)
  emit_code_section(out = out, bodies = [body])
  bytebuf_to_bytes(out)
}

export fn comp_generate_memhost_module() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  emit_memory_section(out = out, min_pages = 1)
  emit_export_memory(out = out, name = "memory", mem_idx = 0)
  bytebuf_to_bytes(out)
}

/// #1230 M1b-3c-1b: blocking-await guest core module with the wait loop
/// factored into its own function -- a direct translation of
/// tools/wasip3_component_probe/spawned_future/component.wat's `$guest`
/// module. `$writer` performs the async-lowered host call + waitable-set
/// retry loop; `$run` calls it and forwards the result to task.return.
///
/// SCOPE / WHAT THIS DOES AND DOES NOT PROVE (#1240 review). `$writer` is
/// an ORDINARY internal wasm function that `$run` calls synchronously --
/// NOT a second Component-Model task. So this shape only models
/// `spawn(f); await(t)` in the degenerate case where nothing observable
/// happens in the parent between the spawn and the join: the "spawn" is
/// then semantically a no-op and compiles away to a direct call, and the
/// canon set needed is exactly the simpler stackful/ probe's
/// (task.return, async-lowered host import, waitable-set.new/.wait/.drop,
/// waitable.join, subtask.drop) -- which the probe verifies end-to-end
/// against a genuinely blocking host import.
///
/// It does NOT establish that a REAL spawn -- a second guest computation
/// that interleaves with parent work before the join -- needs no extra
/// machinery. It cannot: one stackful fiber runs one call chain, so
/// concurrent guest work requires either another task or a guest-side
/// poll executor. The Phase A probe's evidence points the other way: a
/// genuine `wit_bindgen::spawn_local` pulls in a FuturesUnordered
/// executor plus `context.get/set` and `waitable-set.poll`. Any
/// parent/child handshake, or observable work between spawn and join,
/// would therefore reorder or deadlock under this lowering -- the same
/// limitation the linear backend's eager `Task::spawn` already carries
/// (docs/internal/design/wasi-p3-async.md §2.5). M-conc-2 (#1537) has since
/// landed interleaving on host waits for `TaskGroup::spawn_suspend` tasks
/// (same section).
///
/// Local func indices: 7 = $writer (type1: () -> i32; performs the
/// async-lowered host call + waitable-set retry loop and returns the
/// resolved value like an ordinary helper function), 8 = $run
/// (type5: () -> (); exported "run"; calls $writer and forwards its result
/// to task.return). Import func indices 0-6 occupy the func index space
/// before them (0=[async-lower]get-async, 1=[waitable-set-new],
/// 2=[waitable-join], 3=[waitable-set-wait], 4=[waitable-set-drop],
/// 5=[subtask-drop], 6=[task-return]run).
export fn comp_generate_spawned_future_guest_core_module() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  // types: 0 (i32)->(i32) get_async; 1 ()->(i32) ws_new & $writer;
  // 2 (i32,i32)->() waitable_join; 3 (i32,i32)->(i32) ws_wait;
  // 4 (i32)->() ws_drop/subtask_drop/task_return; 5 ()->() $run.
  let tc = bytebuf_new()
  bytebuf_push_vec_header(buf = tc, count = 6)
  emit_func_type_raw(buf = tc, param_types = [127], result_types = [127])
  emit_func_type_raw(buf = tc, param_types = array_empty(), result_types = [127])
  emit_func_type_raw(buf = tc, param_types = [127, 127], result_types = array_empty())
  emit_func_type_raw(buf = tc, param_types = [127, 127], result_types = [127])
  emit_func_type_raw(buf = tc, param_types = [127], result_types = array_empty())
  emit_func_type_raw(buf = tc, param_types = array_empty(), result_types = array_empty())
  bytebuf_push_section(out = out, section_id = 1, content = tc)
  // imports: 7 core funcs (indices 0-6) + memory (module "env", IMPORTED
  // rather than declared/exported -- probe bug #2: every async canon
  // built-in's (memory ...) option must reference the SAME memory instance
  // the guest's own code reads/writes through).
  let ic = bytebuf_new()
  bytebuf_push_vec_header(buf = ic, count = 8)
  emit_name(buf = ic, name = "$root")
  emit_name(buf = ic, name = "[async-lower]get-async")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 0)
  emit_name(buf = ic, name = "$root")
  emit_name(buf = ic, name = "[waitable-set-new]")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 1)
  emit_name(buf = ic, name = "$root")
  emit_name(buf = ic, name = "[waitable-join]")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 2)
  emit_name(buf = ic, name = "$root")
  emit_name(buf = ic, name = "[waitable-set-wait]")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 3)
  emit_name(buf = ic, name = "$root")
  emit_name(buf = ic, name = "[waitable-set-drop]")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 4)
  emit_name(buf = ic, name = "$root")
  emit_name(buf = ic, name = "[subtask-drop]")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 4)
  emit_name(buf = ic, name = "[export]$root")
  emit_name(buf = ic, name = "[task-return]run")
  bytebuf_push(buf = ic, byte = 0)
  bytebuf_push(buf = ic, byte = 4)
  emit_name(buf = ic, name = "env")
  emit_name(buf = ic, name = "memory")
  bytebuf_push(buf = ic, byte = 2)
  bytebuf_push(buf = ic, byte = 0)
  leb128_encode_u32(buf = ic, value = 1)
  bytebuf_push_section(out = out, section_id = 2, content = ic)
  emit_function_section(out = out, type_indices = [1, 5])
  emit_export_section(out = out, name = "run", func_idx = 8)
  // Code section built by hand (not via emit_code_section/
  // emit_code_section_with_locals -- neither supports declaring i32-typed
  // locals): $writer needs 5 i32 locals, matching the string-trampoline
  // functions above's own manual code-section convention.
  let code_sec = bytebuf_new()
  leb128_encode_u32(buf = code_sec, value = 2)
  // $writer (func idx 7). locals: 0=packed, 1=code, 2=subtask, 3=ws,
  // 4=event0, 5=has_ws (all i32). Direct translation of component.wat's
  // $writer body. `has_ws` (zero-initialized like every wasm local) records
  // whether the BLOCKED path actually allocated a waitable set, so the
  // epilogue can drop it -- #1240 review: without it every blocking call
  // leaks one canonical waitable-set handle, eventually exhausting the
  // instance's handle space. (The stackful/ probe has the same latent leak;
  // it imports [waitable-set-drop] and never calls it. Harmless there --
  // one-shot probe -- but not in emitted code.)
  let writer_body = bytebuf_new()
  leb128_encode_u32(buf = writer_body, value = 1)
  leb128_encode_u32(buf = writer_body, value = 6)
  bytebuf_push(buf = writer_body, byte = 127)
  emit_i32_const(buf = writer_body, value = 0)
  emit_call(buf = writer_body, func_idx = 0)
  emit_local_set(buf = writer_body, idx = 0)
  emit_local_get(buf = writer_body, idx = 0)
  emit_i32_const(buf = writer_body, value = 15)
  emit_i32_and(writer_body)
  emit_local_set(buf = writer_body, idx = 1)
  emit_local_get(buf = writer_body, idx = 0)
  emit_i32_const(buf = writer_body, value = 4)
  emit_i32_shr_u(writer_body)
  emit_local_set(buf = writer_body, idx = 2)
  emit_block_void(writer_body)
  emit_local_get(buf = writer_body, idx = 1)
  emit_i32_const(buf = writer_body, value = 2)
  emit_i32_eq(writer_body)
  emit_br_if(buf = writer_body, label = 0)
  emit_call(buf = writer_body, func_idx = 1)
  emit_local_set(buf = writer_body, idx = 3)
  emit_i32_const(buf = writer_body, value = 1)
  emit_local_set(buf = writer_body, idx = 5)
  emit_local_get(buf = writer_body, idx = 2)
  emit_local_get(buf = writer_body, idx = 3)
  emit_call(buf = writer_body, func_idx = 2)
  emit_loop_void(writer_body)
  emit_local_get(buf = writer_body, idx = 3)
  emit_i32_const(buf = writer_body, value = 8)
  emit_call(buf = writer_body, func_idx = 3)
  emit_local_set(buf = writer_body, idx = 4)
  emit_local_get(buf = writer_body, idx = 4)
  emit_i32_const(buf = writer_body, value = 1)
  emit_i32_eq(writer_body)
  emit_if_void(writer_body)
  emit_i32_const(buf = writer_body, value = 12)
  emit_i32_load(buf = writer_body, align = 2, offset = 0)
  emit_local_set(buf = writer_body, idx = 1)
  emit_local_get(buf = writer_body, idx = 1)
  emit_i32_const(buf = writer_body, value = 2)
  emit_i32_eq(writer_body)
  emit_br_if(buf = writer_body, label = 2)
  emit_end(writer_body)
  emit_br(buf = writer_body, label = 0)
  emit_end(writer_body)
  emit_end(writer_body)
  // epilogue: on the BLOCKED path only, drop the subtask FIRST and then the
  // waitable set; then load the host's result from the results area.
  //
  // Both drops are guarded by the same flag (local 5) because both resources
  // come into existence together, in the same straight-line blocked-path
  // sequence: an async-lowered call that completes EAGERLY (status RETURNED
  // straight out of the call, the `br_if $done` above) creates NO subtask --
  // the handle bits of the packed result are 0 -- and allocates no waitable
  // set. #1230 M1b-3c-2: dropping unconditionally therefore traps with
  // "unknown handle index 0" the moment a host import resolves without
  // suspending, which is an entirely ordinary thing for a real host to do
  // (a cached value, a zero timeout, a socket read whose data already
  // arrived). Found live by driving this component through runtime/viberun
  // with a zero-delay host import; the probe's own host always slept 300ms,
  // so it only ever exercised the blocked path.
  //
  // Order matters within the guard: the subtask was `waitable.join`ed into
  // the set, so dropping the set while it still holds the subtask traps with
  // "resource has children" (observed live on wasmtime 47).
  emit_local_get(buf = writer_body, idx = 5)
  emit_if_void(writer_body)
  emit_local_get(buf = writer_body, idx = 2)
  emit_call(buf = writer_body, func_idx = 5)
  emit_local_get(buf = writer_body, idx = 3)
  emit_call(buf = writer_body, func_idx = 4)
  emit_end(writer_body)
  emit_i32_const(buf = writer_body, value = 0)
  emit_i32_load(buf = writer_body, align = 2, offset = 0)
  bytebuf_push(buf = writer_body, byte = 11)
  leb128_encode_u32(buf = code_sec, value = Bytes::length(writer_body))
  bytebuf_push_buf(dst = code_sec, src = writer_body)
  // $run (func idx 8): call $writer, forward its result to task_return.
  let run_body = bytebuf_new()
  leb128_encode_u32(buf = run_body, value = 0)
  emit_call(buf = run_body, func_idx = 7)
  emit_call(buf = run_body, func_idx = 6)
  bytebuf_push(buf = run_body, byte = 11)
  leb128_encode_u32(buf = code_sec, value = Bytes::length(run_body))
  bytebuf_push_buf(dst = code_sec, src = run_body)
  bytebuf_push_section(out = out, section_id = 10, content = code_sec)
  bytebuf_to_bytes(out)
}
