  bytebuf_new,
  bytebuf_push,
  bytebuf_push_buf,
  bytebuf_push_section,
  bytebuf_push_vec_header,
  bytebuf_to_bytes,
  leb128_encode_s64,
  leb128_encode_u32
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/codegen/wasm_emit {
  emit_block_void,
  emit_br,
  emit_br_if,
  emit_call,
  emit_code_section,
  emit_end,
  emit_export_memory,
  emit_export_section,
  emit_func_type_raw,
  emit_function_section,
  emit_global_get,
  emit_global_section_i32_mut,
  emit_global_set,
  emit_header,
  emit_i32_add,
  emit_i32_and,
  emit_i32_const,
  emit_i32_eq,
  emit_i32_load,
  emit_i32_shr_u,
  emit_i32_store,
  emit_i64_const,
  emit_if_void,
  emit_local_get,
  emit_local_set,
  emit_loop_void,
