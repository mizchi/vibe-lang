/// M1b-2d: a no-op `wasi_snapshot_preview1.fd_write` stub core module
/// (`(i32,i32,i32,i32) -> i32` returning 0). Compiled core modules
/// import fd_write from wasi_snapshot_preview1 for their runtime preamble; the
/// stub satisfies that import so the async component is self-contained and
/// instantiable without an external preview1 adapter.
export fn comp_generate_wasi_fd_write_stub() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(buf = tc, count = 1)
  emit_func_type_raw(buf = tc, param_types = [127, 127, 127, 127], result_types = [
    127
  ])
  bytebuf_push_section(out = out, section_id = 1, content = tc)
  emit_function_section(out = out, type_indices = [0])
  emit_export_section(out = out, name = "fd_write", func_idx = 0)
  let body = bytebuf_new()
  emit_i32_const(buf = body, value = 0)
  emit_code_section(out = out, bodies = [body])
  bytebuf_to_bytes(out)
}

/// Like comp_emit_component_wasm_async_trampolined, but for a main core module
/// that imports `wasi_snapshot_preview1.fd_write` (every compiled core does). A
/// fd_write stub module is instantiated first and supplied to the main module's
/// instantiation, making the async component fully self-contained / runnable.
/// core instances: 0=wasi-stub, 1=main(+wasi), 2=cm(task-return), 3=env(run),
/// 4=trampoline. core funcs: 0=task.return, 1=main.run, 2=trampoline.run.
export fn comp_emit_component_wasm_async_trampolined_p1(main_core_wasm: Bytes, export_name: String, comp_result_valtype: Int) -> Bytes {
  let needs_stderr = comp_core_imports_func(core_wasm = main_core_wasm, module_name = "vibe", func_name = "stderr_write_stream")
  // #2976: the exception boundary exits through `vibe.process_exit` after
  // writing its diagnosis, so the trapping stub serves it there -- the trap
  // IS the boundary's non-zero outcome. An exit the program wrote itself is
  // refused before this runs -- by comp_reject_unsatisfiable_selfcontained_imports
  // when no stderr import accompanies it, and by the source lane's provenance
  // check (`maybe_wrap_async_component`) when one does -- because a trapping
  // stub would turn `exit(0)` into a failure.
  let needs_exit = needs_stderr && comp_core_imports_func(core_wasm = main_core_wasm, module_name = "vibe", func_name = "process_exit")
  let needs_vibe = needs_stderr
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf = buf, core_wasm = main_core_wasm)
  emit_core_module_section(buf = buf, core_wasm = comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))
  if needs_vibe {
    // The exception boundary only needs these imports on its failing path. A
    // local trapping stub keeps the self-contained component valid and
    // preserves the same non-zero outcome as core launchers; components that
    // import neither retain their exact pre-existing bytes.
    let stub_names = array_empty()
    let stub_sigs = array_empty()
    if needs_stderr {
      Array::push(stub_names, value = "stderr_write_stream")
      Array::push(stub_sigs, value = [1, 126, 0])
    }
    if needs_exit {
      Array::push(stub_names, value = "process_exit")
      Array::push(stub_sigs, value = [1, 126, 0])
    }
    emit_core_module_section(buf = buf, core_wasm = comp_generate_host_stub_module(vibe_names = stub_names, vibe_sigs = stub_sigs))
  } else {
    emit_core_module_section(buf = buf, core_wasm = comp_generate_wasi_fd_write_stub())
  }
  emit_core_instance_instantiate_section(buf = buf, module_index = 2, module_names = array_empty())
  if needs_vibe {
    emit_core_instance_instantiate_args(buf = buf, module_index = 0, arg_names = [
      "wasi_snapshot_preview1",
      "vibe"
    ], arg_instance_indices = [0, 0])
  } else {
    emit_core_instance_instantiate_args(buf = buf, module_index = 0, arg_names = [
      "wasi_snapshot_preview1"
    ], arg_instance_indices = [0])
  }
  emit_canon_task_return(buf = buf, result_valtype = comp_result_valtype)
  emit_core_instance_from_exports(buf = buf, num_modules = 1, module_binding_counts = [
    1
  ], binding_func_names = ["task-return"], binding_func_indices = [0])
  emit_alias_section(buf = buf, core_instance_idx = 1, names = ["run"], sorts = [
    core_sort_func
  ])
  emit_core_instance_from_exports(buf = buf, num_modules = 1, module_binding_counts = [
    1
  ], binding_func_names = ["run"], binding_func_indices = [1])
  emit_core_instance_instantiate_args(buf = buf, module_index = 1, arg_names = [
    "main",
    "cm"
  ], arg_instance_indices = [3, 2])
  emit_comp_async_functype_section(buf = buf, result_valtype = comp_result_valtype)
  emit_alias_section(buf = buf, core_instance_idx = 4, names = ["run"], sorts = [
    core_sort_func
  ])
  emit_canon_lift_async_section(buf = buf, core_func_idx = 2, type_idx = 0)
  emit_comp_export_section(buf = buf, name = export_name, func_idx = 0)
  bytebuf_to_bytes(buf)
}

export fn comp_core_imports_func(core_wasm: Bytes, module_name: String, func_name: String) -> Bool {
  let modules = array_empty()
  let names = array_empty()
  let type_indices = new_int_array()
  let type_sigs = array_empty()
  let count = parse_core_imports(core_wasm = core_wasm, out_module_names = modules, out_func_names = names, out_type_indices = type_indices, out_type_sigs = type_sigs)
  let mut found = false
  let mut i = 0
  while i < count {
    if Array::get(modules, at = i) == module_name && Array::get(names, at = i) == func_name {
      found = true
    }
    i = i + 1
  }
  found
}

/// #1230 M1b-3c-1b: component valtype for u32, matching the
/// wasip3_component_probe's own result type (see spawned_future/ below).
export let comp_valtype_u32: Int = 121

/// #1230 M1b-3c-1b: canon `lower <f> async (memory M)` -- the async
/// counterpart to emit_canon_lower_section above (which only ever emits the
/// sync, zero-canonopt form). Byte shape recovered from a validated,
/// actually-running component via `wasm-tools dump` against
/// tools/wasip3_component_probe/spawned_future/component.wat's compiled
/// output (not hand-derived from the spec): `01 00 <funcidx> 02 06 03
/// <memidx>` -- opcode=lower(1), reserved byte(0), funcidx, canonopt-count=2,
/// async tag(6), memory tag(3)+core-memory-idx.
export fn emit_canon_lower_async_section(buf: Bytes, comp_func_idx: Int, memory_core_idx: Int) -> Unit {
  bytebuf_push(buf = buf, byte = section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  bytebuf_push(buf = content, byte = 1)
  bytebuf_push(buf = content, byte = 0)
  leb128_encode_u32(buf = content, value = comp_func_idx)
  leb128_encode_u32(buf = content, value = 2)
  bytebuf_push(buf = content, byte = 6)
  bytebuf_push(buf = content, byte = 3)
  leb128_encode_u32(buf = content, value = memory_core_idx)
  emit_raw_content(buf = buf, content = content)
}

/// #1230 M1b-3c-1b: canon waitable-set.new -- single-byte opcode 0x1f (31),
/// verified via wasm-tools dump against spawned_future/component.wat.
export fn emit_canon_waitable_set_new(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  bytebuf_push(buf = content, byte = 31)
  emit_raw_content(buf = buf, content = content)
}

/// #1230 M1b-3c-1b: canon waitable.join -- single-byte opcode 0x23 (35).
export fn emit_canon_waitable_join(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = section_canon)
