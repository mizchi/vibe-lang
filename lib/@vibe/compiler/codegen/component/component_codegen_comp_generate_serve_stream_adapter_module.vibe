}

/// #1230 M1b-3c-1b: canon waitable-set.wait (memory M) -- opcode 0x20 (32),
/// a cancellable flag byte (0 = not cancellable, matching the probe), then
/// the memory core index.
export fn emit_canon_waitable_set_wait(buf: Bytes, memory_core_idx: Int) -> Unit {
  bytebuf_push(buf = buf, byte = section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  bytebuf_push(buf = content, byte = 32)
  bytebuf_push(buf = content, byte = 0)
  leb128_encode_u32(buf = content, value = memory_core_idx)
  emit_raw_content(buf = buf, content = content)
}

/// #1230 M1b-3c-1b: canon waitable-set.drop -- single-byte opcode 0x22 (34).
export fn emit_canon_waitable_set_drop(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  bytebuf_push(buf = content, byte = 34)
