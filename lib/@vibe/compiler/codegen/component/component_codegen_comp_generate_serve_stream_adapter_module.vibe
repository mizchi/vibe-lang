/// #1537: canon subtask.cancel (synchronous) -- opcode 0x06 then the
/// async? flag 0x00, byte shape recovered with `wasm-tools parse` of
/// `(canon subtask.cancel)`. `(i32 subtask) -> (i32 status)`.
export fn emit_canon_subtask_cancel(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  bytebuf_push(buf = content, byte = 6)
  bytebuf_push(buf = content, byte = 0)
  emit_raw_content(buf = buf, content = content)
}

/// ADR-0089 step 2 (#1218): component type section defining `(future <T>)`.
/// Byte shape recovered via `wasm-tools dump` against
/// tools/wasip3_component_probe/future_value/component.wat's compiled
/// output: defvaltype future = 0x65 (101), then an option tag 0x01 + the
/// payload's component valtype (an absent-payload `future` would carry
/// 0x00 and no valtype). The type lands in the COMPONENT type index space
/// (shared with the async functypes), and every future.* canon below
/// references it by that index.
export fn emit_comp_future_type_section(buf: Bytes, elem_valtype: Int) -> Unit {
  bytebuf_push(buf = buf, byte = section_type)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  bytebuf_push(buf = content, byte = 101)
  bytebuf_push(buf = content, byte = 1)
  bytebuf_push(buf = content, byte = elem_valtype)
  emit_raw_content(buf = buf, content = content)
}

/// ADR-0089 step 2: canon future.new <ty> -- opcode 0x15 (21) + the
/// component type index of the `(future T)` type. Core signature
/// `[] -> [i64]`, the i64 packing (writable << 32) | readable -- readable
/// end in the LOW 32 bits (pinned by the probe: swapping them makes
/// future.read trap with a wrong-handle-kind error).
export fn emit_canon_future_new(buf: Bytes, type_idx: Int) -> Unit {
  bytebuf_push(buf = buf, byte = section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  bytebuf_push(buf = content, byte = 21)
  leb128_encode_u32(buf = content, value = type_idx)
  emit_raw_content(buf = buf, content = content)
}

/// ADR-0089 step 2: canon future.read <ty> async (memory M) -- opcode 0x16
/// (22) + type index + 2 canonopts (async tag 6, memory tag 3 + core memory
/// index), same canonopt encoding as emit_canon_lower_async_section. Core
/// signature `[handle, buf_ptr] -> [status]`; with the async canonopt a
/// read with no pending writer returns BLOCKED (0xffffffff) and parks the
/// readable end as a waitable instead of parking the fiber.
export fn emit_canon_future_read(buf: Bytes, type_idx: Int, memory_core_idx: Int) -> Unit {
  bytebuf_push(buf = buf, byte = section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  bytebuf_push(buf = content, byte = 22)
  leb128_encode_u32(buf = content, value = type_idx)
  leb128_encode_u32(buf = content, value = 2)
  bytebuf_push(buf = content, byte = 6)
  bytebuf_push(buf = content, byte = 3)
  leb128_encode_u32(buf = content, value = memory_core_idx)
  emit_raw_content(buf = buf, content = content)
}

/// ADR-0089 step 2: canon future.write <ty> async (memory M) -- opcode 0x17
/// (23), same shape as future.read. Core signature
/// `[handle, buf_ptr] -> [status]`; a write against an already-pending read
/// performs the copy immediately and returns COMPLETED (not BLOCKED) --
/// the rendezvous the future-value guest module relies on.
export fn emit_canon_future_write(buf: Bytes, type_idx: Int, memory_core_idx: Int) -> Unit {
  bytebuf_push(buf = buf, byte = section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(buf = content, value = 1)
  bytebuf_push(buf = content, byte = 23)
  leb128_encode_u32(buf = content, value = type_idx)
  leb128_encode_u32(buf = content, value = 2)
  bytebuf_push(buf = content, byte = 6)
  bytebuf_push(buf = content, byte = 3)
  leb128_encode_u32(buf = content, value = memory_core_idx)
  emit_raw_content(buf = buf, content = content)
}

/// #1537: canon future.cancel-read <ty> (synchronous) -- opcode 0x18 (24),
/// type index, then the async flag (0). Core signature `[handle] ->
/// [status]` (measured with wasm-tools 1.253: `18 00 00`).
export fn emit_canon_future_cancel_read(buf: Bytes, type_idx: Int) -> Unit {
