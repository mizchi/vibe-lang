deps = {
  @vibe/ast : 0.2.0
  @vibe/compiler/checker : 0.0.1
  @vibe/compiler/core : 0.0.1
  @vibe/core : 0.2.0
}

generated_hash =

import @vibe/compiler/core {
  Stmt, TypeExpr
}

fn wit_kebab_ident(_ name: String) -> String
fn wit_type_text(_ ty: TypeExpr) -> String with Exception
fn serve_handler_param_names() -> Array[String]
fn validate_serve_handler(_ entry_stmts: Array[Stmt]) -> Unit with Exception
fn serve_handler_takes_body_stream(_ entry_stmts: Array[Stmt]) -> Bool
fn wit_boundary_signature(stmts: Array[Stmt], name: String) -> Option[(String, Array[String], Array[TypeExpr], TypeExpr, Array[String])]
