//# Imports

import @vibe/compiler/core {
  Stmt
}

import @vibe/compiler/codegen/common_base {
  DbgProv, erase_railway_origin_markers, unbox_tuple_loop_params
}

import @vibe/compiler/codegen/expr {
  compile_module_expr
}

import @vibe/compiler/codegen/wasi {
  compile_wasi_module_break_impl,
  compile_wasi_module_coverage_impl,
  compile_wasi_module_impl,
  compile_wasi_module_rc_impl,
  compile_wasi_module_rc_shadow_impl,
  compile_wasi_module_replayed_impl,
  compile_wasi_module_sliced_impl,
  compile_wasi_module_trace_impl,
  compile_wasi_module_with_sources_impl
}

// #847 Phase C: facade re-export for inline_wat. The builtin registry is
// owned by @vibe/compiler/core so checker and both codegen lanes consume the
// same lower-level contract directly.
export ./common_base {
  compile_inline_wat,
  compile_inline_wat_full,
  desugar_labeled_args,
  desugar_railway_binds,
  desugar_trait_dicts,
  ensure_exn_kind_cell,
  erase_railway_origin_markers,
  exn_kind_read_expr,
  exn_msg_read_expr,
  inject_trait_method_generics,
  unbox_tuple_loop_params
}

//# Functions

export fn compile_module(stmts: Array[Stmt]) -> Bytes with Exception {
  // #1262: the test/bench module lane compiles through compile_module_expr,
  // not the linked convergence point -- run the tuple `let mut` unbox here so
  // both linear entries agree on the lowering (docs 6.4 finding 1).
  erase_railway_origin_markers(stmts)
  unbox_tuple_loop_params(stmts)
  compile_module_expr(stmts)
}

export fn compile_wasi_module_with_sources(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with Exception {
  compile_wasi_module_with_sources_impl(stmts, entry_name, srcs)
}

export fn compile_wasi_module(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception {
  compile_wasi_module_impl(stmts, entry_name)
}

/// #1259 step 7 round-trip check: same module, but with every function body
/// compiled once, harvested, and then REPLAYED from the cache. Throws on the
/// first byte that differs from the straight compile. Test/gate only -- it
/// compiles the program twice on purpose.
export fn compile_wasi_module_replayed(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception {
  compile_wasi_module_replayed_impl(stmts, entry_name)
}

/// #1259 step 8: same module, but with the bodies harvested in two disjoint
/// slices, the harvests merged, and the merged cache replayed. Throws on the
/// first byte that differs from the straight compile. Test/gate only.
export fn compile_wasi_module_sliced(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception {
  compile_wasi_module_sliced_impl(stmts, entry_name)
}

/// #701 RC variant: the Perceus RC codegen path (enable_rc) for the FS-compile
/// entry, so `vibe run`/import-resolving programs honor VIBE_RC instead of
/// silently using the bump path. Same merged stmts as compile_wasi_module.
export fn compile_wasi_module_rc(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception {
  compile_wasi_module_rc_impl(stmts, entry_name)
}

/// #715/#768 debug variant: RC codegen + shadow-liveness double-free traps
/// (VIBE_RC=shadow) for the FS-compile entry, so import-resolving test builds
/// can be shadow-instrumented too -- previously only the single-source path
/// (compile_source_wasi_only_rc_shadow) supported shadow, so `vibe test`-shaped
/// heap corruption could not be pinned to its first bad free.
export fn compile_wasi_module_rc_shadow(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception {
  compile_wasi_module_rc_shadow_impl(stmts, entry_name)
}

/// Coverage variant (#cov): function-level hit instrumentation + `vibe_cov`
/// custom section. Used by the coverage self-compile entry.
export fn compile_wasi_module_coverage(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception {
  compile_wasi_module_coverage_impl(stmts, entry_name)
}

/// Trace variant (debugger / DAP P1 groundwork): function-call execution-trace
/// instrumentation + `vibe.trace` custom section. Used by the FS-compile trace
/// entry under VIBE_DEBUG=1.
export fn compile_wasi_module_trace(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception {
  compile_wasi_module_trace_impl(stmts, entry_name)
}

/// Break variant (debugger / DAP P1): `vibe::dbg_break` host-hook instrumentation
/// at each user function entry. Used by the FS-compile break entry under
/// VIBE_DEBUG_BREAK=1.
export fn compile_wasi_module_break(stmts: Array[Stmt], entry_name: String, prov: DbgProv) -> Bytes with Exception {
  compile_wasi_module_break_impl(stmts, entry_name, prov)
}

// (A second, identical `compile_wasi_module_rc` definition used to live here —
// the flat bundle's first-match tolerated it; the #726 merge flatten surfaced
// it as the last remaining duplicate top-level def.)
