// @vibe/compiler/codegen — ADR-0070 / #897 compiler-internal contract for
// this directory's own top-level files ONLY. The 8 subdirectories
// (builtin_bodies/, common_analysis/, common_base/, common_extractors/,
// expr/, gc/, wasi/, wasm_emit/) are each already separate, already-migrated
// index.vpkg packages in their own right (earlier batches of this same
// #897 series) and are NOT covered by this contract — this package imports
// them as ordinary sibling packages, same as any other outside consumer.
//
// Single-file package: codegen.vibe (the old index.vibe, renamed — see
// naming note below) is the ENTIRE directory-owned surface. It is a thin
// public facade, forwarding compile_module/compile_wasi_module* to the
// expr/ and wasi/ subpackages, and re-exporting a subset of
// codegen/common_base's compile_inline_wat surface via the `export
// ./common_base { names }` cross-package SReExport form (#847 Phase C; same
// shape as syntax/syntax.vibe's re-export of @vibe/parser).
//
// Structural wrinkle (found only via the full verification chain, not by
// static reading): double_to_string_expr.vibe, int_parse_expr.vibe and
// inline_wat.vibe used to live at this directory's top level too (siblings
// of codegen.vibe). But codegen/'s subpackages (expr/, gc/, wasi/) need
// those 3 files directly, while codegen.vibe (this package's facade) ALSO
// depends downward on expr/ and wasi/ to forward compile_module/
// compile_wasi_module*. Owning the files here made codegen/index.vpkg <->
// codegen/expr(gc,wasi)/index.vpkg a genuine two-node import cycle when their
// leaf imports were switched to boundary-legal package imports. Moving them
// to codegen/common_base/ breaks the cycle: that package remains shared
// substrate with no upward codegen edges.
//
// Naming note: the established rename convention for this migration batch
// is `git mv index.vibe <dirname>.vibe` (codegen/expr/expr.vibe,
// codegen/gc/gc.vibe, syntax/syntax.vibe, checker/checker_facade.vibe when
// dirname collided). For this directory the dirname is "codegen" and no
// `codegen/codegen.vibe` previously existed, so the plain rename applies
// with no collision.
//
// Compiled into the compiler itself via compiler_sources_manifest.tsv
// (group `codegen`): the old single `codegen/index.vibe` row becomes a dual
// row (this contract + codegen.vibe); double_to_string_expr.vibe /
// int_parse_expr.vibe / inline_wat.vibe's rows are repointed to their new codegen/common_base/ paths (see that package's
// manifest rows) as part of this same batch.

// --- codegen.vibe
fn compile_module(stmts: Array[Stmt]) -> Bytes with Exception
fn compile_wasi_module_with_sources(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with Exception
fn compile_wasi_module(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception
fn compile_wasi_module_replayed(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception
fn compile_wasi_module_sliced(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception
fn compile_wasi_module_rc(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception
fn compile_wasi_module_rc_shadow(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception
fn compile_wasi_module_coverage(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception
fn compile_wasi_module_trace(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception
fn compile_wasi_module_break(stmts: Array[Stmt], entry_name: String, prov: DbgProv) -> Bytes with Exception

// --- re-exported from codegen/common_base (cross-package SReExport, see
// header note above).
fn compile_inline_wat(fn_name: String, wat: String, param_names: Array[String]) -> Bytes with Exception
fn compile_inline_wat_full(fn_name: String, wat: String, param_names: Array[String], extra_base: Int) -> (Bytes, Int, Int, Int) with Exception

// --- normalize/desugar_trait_dict.vibe (re-exported through
// codegen/common_base for compatibility; see that package's index.vpkg header)
fn desugar_labeled_args(stmts: Array[Stmt]) -> Unit
fn desugar_railway_binds(stmts: Array[Stmt]) -> Unit
fn erase_railway_origin_markers(stmts: Array[Stmt]) -> Unit
fn inject_trait_method_generics(stmts: Array[Stmt]) -> Unit
fn desugar_trait_dicts(stmts: Array[Stmt]) -> Unit
fn unbox_tuple_loop_params(stmts: Array[Stmt]) -> Unit
// #1374: the exception-kind side channel. `desugar_trait_dicts` maintains the
// cell; these two let a pass that runs AFTER it (the entry boundary) read the
// kind and make sure the cell exists.
fn exn_kind_read_expr() -> Expr
fn exn_msg_read_expr() -> Expr
fn ensure_exn_kind_cell(stmts: Array[Stmt]) -> Unit
