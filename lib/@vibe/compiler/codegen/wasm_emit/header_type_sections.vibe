//# Imports

import @vibe/compiler/core {
  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32
}

import @vibe/core {
  array_empty
}

//# Functions

export fn emit_func_type(buf: Bytes, param_count: Int, result_count: Int) -> Unit {
  bytebuf_push(buf = buf, byte = 96)
  leb128_encode_u32(buf = buf, value = param_count)
  let mut i = 0
  while i < param_count {
    bytebuf_push(buf = buf, byte = 126)
    i = i + 1
  }
  leb128_encode_u32(buf = buf, value = result_count)
  let mut j = 0
  while j < result_count {
    bytebuf_push(buf = buf, byte = 126)
    j = j + 1
  }
}

export fn emit_type_section_multi(out: Bytes, type_defs: Array[Int]) -> Unit {
  let count = Array::length(type_defs) / 2
  let content = bytebuf_new()
  bytebuf_push_vec_header(buf = content, count = count)
  let mut i = 0
  while i < count {
    emit_func_type(buf = content, param_count = Array::get(type_defs, at = i * 2), result_count = Array::get(type_defs, at = (i * 2) + 1))
    i = i + 1
  }
  bytebuf_push_section(out = out, section_id = 1, content = content)
}

export fn emit_type_section(out: Bytes, param_count: Int, result_count: Int) -> Unit {
  let type_defs = array_empty()
  Array::push(type_defs, value = param_count)
  Array::push(type_defs, value = result_count)
  emit_type_section_multi(out = out, type_defs = type_defs)
}
