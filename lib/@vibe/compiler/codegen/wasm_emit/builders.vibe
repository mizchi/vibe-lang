fn singleton_string_array(_ v0: String) -> Array[String] {
  let values = builders_empty_string_array()
  Array::push(values, value = v0)
  values
}

export fn build_hello_module() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(buf = type_content, count = 2)
  emit_func_type_raw(buf = type_content, param_types = quad_int_array(v0 = builders_vt_i32, v1 = builders_vt_i32, v2 = builders_vt_i32, v3 = builders_vt_i32), result_types = singleton_int_array(builders_vt_i32))
  emit_func_type_raw(buf = type_content, param_types = array_empty(), result_types = array_empty())
  bytebuf_push_section(out = out, section_id = sec_type, content = type_content)
  emit_import_section_func(out = out, module_name = "wasi_snapshot_preview1", field_name = "fd_write", type_idx = 0)
  emit_function_section(out = out, type_indices = singleton_int_array(1))
  emit_memory_section(out = out, min_pages = 1)
  emit_exports_with_memory(out = out, fn_names = singleton_string_array("_start"), fn_indices = singleton_int_array(1), mem_name = "memory", mem_idx = 0)
  let b = bytebuf_new()
  emit_i32_const(buf = b, value = 0)
  emit_i32_const(buf = b, value = 8)
  emit_i32_store(buf = b, align = 2, offset = 0)
  emit_i32_const(buf = b, value = 4)
  emit_i32_const(buf = b, value = 12)
  emit_i32_store(buf = b, align = 2, offset = 0)
  emit_i32_const(buf = b, value = 1)
  emit_i32_const(buf = b, value = 0)
  emit_i32_const(buf = b, value = 1)
  emit_i32_const(buf = b, value = 100)
  emit_call(buf = b, func_idx = 0)
  emit_drop(b)
  emit_code_section(out = out, bodies = singleton_bytes_array(b))
  let hello_data = bytebuf_new()
  bytebuf_push(buf = hello_data, byte = 104)
  bytebuf_push(buf = hello_data, byte = 101)
  bytebuf_push(buf = hello_data, byte = 108)
  bytebuf_push(buf = hello_data, byte = 108)
  bytebuf_push(buf = hello_data, byte = 111)
  bytebuf_push(buf = hello_data, byte = 32)
  bytebuf_push(buf = hello_data, byte = 119)
  bytebuf_push(buf = hello_data, byte = 111)
  bytebuf_push(buf = hello_data, byte = 114)
  bytebuf_push(buf = hello_data, byte = 108)
  bytebuf_push(buf = hello_data, byte = 100)
  bytebuf_push(buf = hello_data, byte = 10)
  emit_data_section(out = out, offset = 8, data = hello_data)
  bytebuf_to_bytes(out)
}

export fn build_arithmetic_module() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section(out = out, param_count = 2, result_count = 1)
  emit_function_section(out = out, type_indices = triple_int_array(v0 = 0, v1 = 0, v2 = 0))
  emit_export_section_multi(out = out, names = triple_string_array(v0 = "add", v1 = "sub", v2 = "mul"), func_indices = triple_int_array(v0 = 0, v1 = 1, v2 = 2))
  let add_body = bytebuf_new()
  emit_local_get(buf = add_body, idx = 0)
  emit_local_get(buf = add_body, idx = 1)
  emit_i64_add(add_body)
  let sub_body = bytebuf_new()
  emit_local_get(buf = sub_body, idx = 0)
  emit_local_get(buf = sub_body, idx = 1)
  emit_i64_sub(sub_body)
  let mul_body = bytebuf_new()
  emit_local_get(buf = mul_body, idx = 0)
  emit_local_get(buf = mul_body, idx = 1)
  emit_i64_mul(mul_body)
  emit_code_section(out = out, bodies = triple_bytes_array(v0 = add_body, v1 = sub_body, v2 = mul_body))
  bytebuf_to_bytes(out)
}

export fn emit_data_section_multi(out: Bytes, offsets: Array[Int], datas: Array[Bytes]) -> Unit {
  let count = Array::length(offsets)
  // A segment needs at most 13 framing bytes; the vector count needs five.
  let mut capacity = 5 + count * 13
  let mut di = 0
  while di < count {
    capacity = capacity + Bytes::length(Array::get(datas, at = di))
    di = di + 1
  }
  let content = if capacity >= 1024 && capacity <= 1073741816 {
    Bytes::with_capacity(capacity)
  } else {
    // Small sections favor the default allocator; oversized ones keep growing.
    bytebuf_new()
  }
  bytebuf_push_vec_header(buf = content, count = count)
  let mut i = 0
  while i < count {
    bytebuf_push(buf = content, byte = 0)
    emit_i32_const(buf = content, value = Array::get(offsets, at = i))
    emit_end(content)
    let data = Array::get(datas, at = i)
    leb128_encode_u32(buf = content, value = Bytes::length(data))
    bytebuf_push_buf(dst = content, src = data)
    i = i + 1
  }
  bytebuf_push_section(out = out, section_id = builders_sec_data, content = content)
}

export fn build_print_string_module(_ msg: String) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(buf = type_content, count = 2)
  emit_func_type_raw(buf = type_content, param_types = quad_int_array(v0 = builders_vt_i32, v1 = builders_vt_i32, v2 = builders_vt_i32, v3 = builders_vt_i32), result_types = singleton_int_array(builders_vt_i32))
  emit_func_type_raw(buf = type_content, param_types = array_empty(), result_types = array_empty())
  bytebuf_push_section(out = out, section_id = sec_type, content = type_content)
  emit_import_section_func(out = out, module_name = "wasi_snapshot_preview1", field_name = "fd_write", type_idx = 0)
  emit_function_section(out = out, type_indices = singleton_int_array(1))
  emit_memory_section(out = out, min_pages = 1)
  emit_exports_with_memory(out = out, fn_names = singleton_string_array("_start"), fn_indices = singleton_int_array(1), mem_name = "memory", mem_idx = 0)
  let str_data = string_to_data(msg)
  let str_len = Bytes::length(str_data)
  let b = bytebuf_new()
  emit_i32_const(buf = b, value = 0)
  emit_i32_const(buf = b, value = 16)
  emit_i32_store(buf = b, align = 2, offset = 0)
  emit_i32_const(buf = b, value = 4)
  emit_i32_const(buf = b, value = str_len)
  emit_i32_store(buf = b, align = 2, offset = 0)
  emit_i32_const(buf = b, value = 1)
  emit_i32_const(buf = b, value = 0)
  emit_i32_const(buf = b, value = 1)
  emit_i32_const(buf = b, value = 8)
  emit_call(buf = b, func_idx = 0)
  emit_drop(b)
  emit_code_section(out = out, bodies = singleton_bytes_array(b))
  emit_data_section(out = out, offset = 16, data = str_data)
  bytebuf_to_bytes(out)
}
