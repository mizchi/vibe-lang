//# Functions

let builders_vt_i32 = 127

let builders_sec_data = 11

let sec_type = 1

export fn string_to_data(_ s: String) -> Bytes {
  let buf = bytebuf_new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    bytebuf_push(buf = buf, byte = String::char_code_at(s, at = i))
    i = i + 1
  }
  buf
}

fn empty_int_array() -> Array[Int] {
  array_empty()
}

fn pair_int_array(v0: Int, v1: Int) -> Array[Int] {
  let values = empty_int_array()
  Array::push(values, value = v0)
  Array::push(values, value = v1)
  values
}

fn quad_int_array(v0: Int, v1: Int, v2: Int, v3: Int) -> Array[Int] {
  let values = empty_int_array()
  Array::push(values, value = v0)
  Array::push(values, value = v1)
  Array::push(values, value = v2)
  Array::push(values, value = v3)
  values
}

fn triple_int_array(v0: Int, v1: Int, v2: Int) -> Array[Int] {
  let values = empty_int_array()
  Array::push(values, value = v0)
  Array::push(values, value = v1)
  Array::push(values, value = v2)
  values
}

fn empty_bytes_array() -> Array[Bytes] {
  array_empty()
}

fn pair_bytes_array(v0: Bytes, v1: Bytes) -> Array[Bytes] {
  let values = empty_bytes_array()
  Array::push(values, value = v0)
  Array::push(values, value = v1)
  values
}

fn builders_empty_string_array() -> Array[String] {
  array_empty()
}

fn pair_string_array(v0: String, v1: String) -> Array[String] {
  let values = builders_empty_string_array()
  Array::push(values, value = v0)
  Array::push(values, value = v1)
  values
}

export fn build_call_module() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section_multi(out = out, type_defs = quad_int_array(v0 = 1, v1 = 1, v2 = 2, v3 = 1))
  emit_function_section(out = out, type_indices = pair_int_array(v0 = 0, v1 = 1))
  emit_export_section_multi(out = out, names = pair_string_array(v0 = "square", v1 = "sum_sq"), func_indices = pair_int_array(v0 = 0, v1 = 1))
  let sq_body = bytebuf_new()
  emit_local_get(buf = sq_body, idx = 0)
  emit_local_get(buf = sq_body, idx = 0)
  emit_i64_mul(sq_body)
  let ss_body = bytebuf_new()
  emit_local_get(buf = ss_body, idx = 0)
  emit_call(buf = ss_body, func_idx = 0)
  emit_local_get(buf = ss_body, idx = 1)
  emit_call(buf = ss_body, func_idx = 0)
  emit_i64_add(ss_body)
  emit_code_section(out = out, bodies = pair_bytes_array(v0 = sq_body, v1 = ss_body))
  bytebuf_to_bytes(out)
}

fn triple_bytes_array(v0: Bytes, v1: Bytes, v2: Bytes) -> Array[Bytes] {
  let values = empty_bytes_array()
  Array::push(values, value = v0)
  Array::push(values, value = v1)
  Array::push(values, value = v2)
  values
}

fn singleton_int_array(_ v0: Int) -> Array[Int] {
  let values = empty_int_array()
  Array::push(values, value = v0)
  values
}

fn triple_string_array(v0: String, v1: String, v2: String) -> Array[String] {
  let values = builders_empty_string_array()
  Array::push(values, value = v0)
  Array::push(values, value = v1)
  Array::push(values, value = v2)
  values
}

fn singleton_bytes_array(_ v0: Bytes) -> Array[Bytes] {
  let values = empty_bytes_array()
  Array::push(values, value = v0)
  values
}

export fn build_add_module() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section(out = out, param_count = 2, result_count = 1)
  emit_function_section(out = out, type_indices = singleton_int_array(0))
  emit_export_section(out = out, name = "add", func_idx = 0)
  let body = bytebuf_new()
  emit_local_get(buf = body, idx = 0)
  emit_local_get(buf = body, idx = 1)
  emit_i64_add(body)
  emit_code_section(out = out, bodies = singleton_bytes_array(body))
  bytebuf_to_bytes(out)
}

export fn build_factorial_module() -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section(out = out, param_count = 1, result_count = 1)
  emit_function_section(out = out, type_indices = singleton_int_array(0))
  emit_export_section(out = out, name = "fact", func_idx = 0)
  let b = bytebuf_new()
  emit_i64_const(buf = b, value = 1)
  emit_local_set(buf = b, idx = 1)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(buf = b, idx = 0)
  emit_i64_const(buf = b, value = 1)
  emit_i64_le_s(b)
  emit_br_if(buf = b, label = 1)
  emit_local_get(buf = b, idx = 1)
  emit_local_get(buf = b, idx = 0)
  emit_i64_mul(b)
  emit_local_set(buf = b, idx = 1)
  emit_local_get(buf = b, idx = 0)
  emit_i64_const(buf = b, value = 1)
  emit_i64_sub(b)
  emit_local_set(buf = b, idx = 0)
  emit_br(buf = b, label = 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(buf = b, idx = 1)
  emit_code_section_with_locals(out = out, bodies = singleton_bytes_array(b), local_counts = singleton_int_array(1))
  bytebuf_to_bytes(out)
}

