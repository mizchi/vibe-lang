}

import @vibe/core {
  array_empty
}

import ./instructions.vibe {
  emit_block_void,
  emit_br,
  emit_br_if,
  emit_call,
  emit_drop,
  emit_i32_store,
  emit_i64_add,
  emit_i64_const,
  emit_i64_le_s,
  emit_i64_mul,
  emit_i64_sub,
  emit_local_get,
  emit_local_set,
  emit_loop_void
}

import ./sections.vibe {
