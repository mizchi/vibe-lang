//# Imports

import @vibe/compiler/core {
  bytebuf_push, bytebuf_push3
}

//# Functions

export fn emit_header(_ buf: Bytes) -> Unit {
  bytebuf_push3(buf = buf, b1 = 0, b2 = 97, b3 = 115)
  bytebuf_push3(buf = buf, b1 = 109, b2 = 1, b3 = 0)
  bytebuf_push(buf = buf, byte = 0)
  bytebuf_push(buf = buf, byte = 0)
}
