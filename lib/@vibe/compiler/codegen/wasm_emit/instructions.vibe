/// `0xFB <sub> <typeidx>`: a GC instruction's type operand is a relocatable
/// slot like a `call_indirect` type (#3941), so every site the relocation
/// scanner records as `reloc_kind_type` carries the same width.
fn emit_gc_type_op(buf: Bytes, sub: Int, type_idx: Int) -> Unit {
  bytebuf_push(buf = buf, byte = 251)
  leb128_encode_u32(buf = buf, value = sub)
  leb128_encode_u32_slot(buf = buf, value = type_idx)
}

export fn emit_struct_get(buf: Bytes, type_idx: Int, field_idx: Int) -> Unit {
  emit_gc_type_op(buf = buf, sub = 2, type_idx = type_idx)
  leb128_encode_u32(buf = buf, value = field_idx)
}

export fn emit_struct_new(buf: Bytes, type_idx: Int) -> Unit {
  emit_gc_type_op(buf = buf, sub = 0, type_idx = type_idx)
}

export fn emit_array_new(buf: Bytes, type_idx: Int) -> Unit {
