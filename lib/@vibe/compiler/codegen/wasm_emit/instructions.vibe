//# Functions

let op_br = 12

let op_if = 4

let bt_i64 = 126

let bt_void = 64

export fn emit_br(buf: Bytes, label: Int) -> Unit {
  bytebuf_push_opcode_u32(buf = buf, opcode = op_br, value = label)
}

let op_call = 16

let op_drop = 26

let op_else = 5

let op_loop = 3

let op_block = 2

let op_br_if = 13

/// The target is a relocatable slot (#3941): at the compile's slot width, so
/// a callee's index magnitude does not decide the caller's length.
export fn emit_call(buf: Bytes, func_idx: Int) -> Unit {
  if reloc_slot_width() == 0 {
    bytebuf_push_opcode_u32(buf = buf, opcode = op_call, value = func_idx)
  } else {
    bytebuf_push(buf = buf, byte = op_call)
    leb128_encode_u32_slot(buf = buf, value = func_idx)
  }
}

export fn emit_drop(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = op_drop)
}

export fn emit_else(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = op_else)
}

