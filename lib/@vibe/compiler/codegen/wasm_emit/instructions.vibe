/// ADR-0089 (c) (#1218): the host-future adapter indexes per-handle scratch
/// slots (`base + handle * 4`), i.e. it needs the i32 sibling of the i64
/// shift that has been here since the tagged-value lowering.
export fn emit_i32_shl(buf: Bytes) -> Unit {
  bytebuf_push(buf, op_i32_shl)
}

/// #1230 M1b-3c-3: the concurrent-awaits emitter needs these four to count
/// down a "how many subtasks are still pending" local and branch on it.
