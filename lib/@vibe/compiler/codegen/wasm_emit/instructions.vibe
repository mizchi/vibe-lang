let op_i64_trunc_f64_s = 176

export fn emit_f64_const_bits(buf: Bytes, bits: Int) -> Unit {
  bytebuf_push9(buf = buf, b1 = 68, b2 = bits&255, b3 = (bits>>8)&255, b4 = (bits>>16)&255, b5 = (bits>>24)&255, b6 = (bits>>32)&255, b7 = (bits>>40)&255, b8 = (bits>>48)&255, b9 = (bits>>56)&255)
}

/// Emit f64.const from the f64 pattern split into its low / high 32 bits
/// (little-endian: 4 bytes of lo, then 4 bytes of hi). Each half is 0..2^32-1,
/// so it fits the 62-bit Int — unlike the full pattern, which overflows it
/// (Blocker-2, ADR-0055). Callers obtain lo/hi via Double::to_i64_bits_lo/_hi.
export fn emit_f64_const_lohi(buf: Bytes, lo: Int, hi: Int) -> Unit {
  bytebuf_push9(buf = buf, b1 = 68, b2 = lo&255, b3 = (lo>>8)&255, b4 = (lo>>16)&255, b5 = (lo>>24)&255, b6 = hi&255, b7 = (hi>>8)&255, b8 = (hi>>16)&255, b9 = (hi>>24)&255)
}

let op_i64_extend_i32_s = 172

export fn emit_i64_trunc_f64_s(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = op_i64_trunc_f64_s)
}

export fn emit_struct_type_raw(buf: Bytes, field_types: Array[Int], field_muts: Array[Int]) -> Unit {
  bytebuf_push_opcode_u32(buf = buf, opcode = 95, value = Array::length(field_types))
  let mut i = 0
  while i < Array::length(field_types) {
    bytebuf_push2(buf = buf, b1 = Array::get(field_types, at = i), b2 = Array::get(field_muts, at = i))
    i = i + 1
  }
}

/// #1542: struct type whose fields may be typed references. A field entry is
/// either a value type byte or, when `field_types[i] < 0`, the nullable
/// reference `(ref null ref_type_idx)` -- spelled `0x63 <typeidx>` rather than a
/// single value-type byte, which is why this cannot go through the plain
/// `emit_struct_type_raw`.
export fn emit_struct_type_raw_refs(buf: Bytes, field_types: Array[Int], field_muts: Array[Int], ref_type_idx: Int) -> Unit {
  bytebuf_push_opcode_u32(buf = buf, opcode = 95, value = Array::length(field_types))
  let mut i = 0
  while i < Array::length(field_types) {
    let ft = Array::get(field_types, at = i)
    if ft < 0 {
      emit_ref_null_valtype(buf = buf, type_idx = ref_type_idx)
      bytebuf_push(buf = buf, byte = Array::get(field_muts, at = i))
    } else {
      bytebuf_push2(buf = buf, b1 = ft, b2 = Array::get(field_muts, at = i))
    }
    i = i + 1
  }
}

export fn emit_array_type_raw(buf: Bytes, elem_type: Int, is_mut: Int) -> Unit {
  bytebuf_push3(buf = buf, b1 = 94, b2 = elem_type, b3 = is_mut)
}

let op_f64_convert_i64_s = 185

export fn emit_i64_extend_i32_s(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = op_i64_extend_i32_s)
}

export fn emit_f64_convert_i64_s(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = op_f64_convert_i64_s)
}

// #3543: the f32 conversions the 32-bit `Float` rounds through. A Float is
// held as an f64, so rounding one is `f32.demote_f64` then `f64.promote_f32`,
// and an Int becomes one through `f32.convert_i64_s` (one rounding, not two).
let op_f32_convert_i64_s = 180

let op_f32_demote_f64 = 182

let op_f64_promote_f32 = 187

export fn emit_f32_convert_i64_s(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = op_f32_convert_i64_s)
}

export fn emit_f32_demote_f64(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = op_f32_demote_f64)
}

export fn emit_f64_promote_f32(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = op_f64_promote_f32)
}

let op_f64_reinterpret_i64 = 191

let op_i64_reinterpret_f64 = 189

export fn emit_f64_reinterpret_i64(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = op_f64_reinterpret_i64)
}

export fn emit_i64_reinterpret_f64(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = op_i64_reinterpret_f64)
}

export fn emit_table_section_funcref(out: Bytes, num_entries: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(buf = content, count = 1)
  bytebuf_push2(buf = content, b1 = type_funcref, b2 = 0)
  leb128_encode_u32(buf = content, value = num_entries)
  bytebuf_push_section(out = out, section_id = sec_table, content = content)
}

/// #1107 Phase 4: like emit_element_section_active, but takes PARALLEL arrays
/// of (table slot, function index), sorted ascending by slot, and emits one
/// active segment (flag 0, table 0, i32.const offset) per RUN of consecutive
/// slots — so slots between runs stay ref.null without padding entries. Used
/// by the linear backend to register only the closure-materialized slots
/// recorded in CompileCtx.table_slots_used.
export fn emit_element_section_active_runs(out: Bytes, slots: Array[Int], func_indices: Array[Int]) -> Unit {
  let n = Array::length(slots)
  let mut runs = 0
  let mut i = 0
  while i < n {
    if i == 0 || Array::get(slots, at = i) != Array::get(slots, at = i - 1) + 1 {
      runs = runs + 1
    } else {
      ()
    }
    i = i + 1
  }
  let content = bytebuf_new()
  bytebuf_push_vec_header(buf = content, count = runs)
  let mut s = 0
  while s < n {
    let mut e = s + 1
    while e < n && Array::get(slots, at = e) == Array::get(slots, at = e - 1) + 1 {
      e = e + 1
    }
    bytebuf_push(buf = content, byte = 0)
    emit_i32_const(buf = content, value = Array::get(slots, at = s))
    emit_end(content)
    leb128_encode_u32(buf = content, value = e - s)
    let mut k = s
    while k < e {
      leb128_encode_u32(buf = content, value = Array::get(func_indices, at = k))
      k = k + 1
    }
    s = e
  }
  bytebuf_push_section(out = out, section_id = sec_element, content = content)
}

export fn emit_element_section_active(out: Bytes, func_indices: Array[Int]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(buf = content, count = 1)
  bytebuf_push(buf = content, byte = 0)
  emit_i32_const(buf = content, value = 0)
  emit_end(content)
  leb128_encode_u32(buf = content, value = Array::length(func_indices))
  let mut i = 0
  while i < Array::length(func_indices) {
    leb128_encode_u32(buf = content, value = Array::get(func_indices, at = i))
    i = i + 1
  }
  bytebuf_push_section(out = out, section_id = sec_element, content = content)
}
