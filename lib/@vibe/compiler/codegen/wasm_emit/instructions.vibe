export fn emit_if_i64(_ buf: Bytes) -> Unit {
  bytebuf_push2(buf = buf, b1 = op_if, b2 = bt_i64)
}

/// `if` whose result is a value type that has no single-byte blocktype --
/// today a `(ref null $t)`. The binary format spells that as a TYPE INDEX in
/// the blocktype position, encoded as signed LEB128 (s33), referring to a func
/// type with no parameters and that one result.
///
/// The single-byte encoding below is only valid while the index fits in six
/// bits: s33 reserves bit 6 for the sign, and the negative range is where the
/// single-byte value types (0x7E i64, 0x40 empty, ...) live. Callers pass a
/// fixed base type index, so this is a static property rather than a bound to
/// check at every call -- but it is checked, because getting it wrong emits a
/// module that decodes as some unrelated value type instead of failing.
///
/// At a slot width (#3941) the index is a signed LEB128 of that width instead,
/// like every other type index in a body, so a `reloc_kind_blocktype` site is
/// rebuilt at the width it was written at. A padded s33 carries the sign in
/// its LAST byte, so the six-bit bound does not apply to it; the bound is
/// still enforced, so the minimal and padded builds accept the same indices.
export fn emit_if_type_index(buf: Bytes, type_idx: Int) -> Unit with Exception {
  if type_idx < 0 || type_idx >= 64 {
    throw("blocktype type index \{type_idx} needs a multi-byte s33 encoding (only 0..63 supported)")
  } else {
    ()
  }
  if reloc_slot_width() == 0 {
    bytebuf_push2(buf = buf, b1 = op_if, b2 = type_idx)
  } else {
    bytebuf_push(buf = buf, byte = op_if)
    leb128_encode_s_slot(buf = buf, value = type_idx)
  }
}

/// The value type `(ref null <type_idx>)`: `0x63`, then the type index as a
/// HEAP TYPE. A heap type is a signed LEB128 (s33) -- negative values are the
/// abstract heap types (`0x6E` any, `0x70` func, ...) -- so the index must be
/// written signed. Unsigned LEB128 agrees with it only while the last 7-bit
/// group has bit 6 clear: written unsigned, index 64 is `0x40` (read as -64,
/// no such heap type) and 110 is `0x6E` (read as `any`), #4084. Every
/// `(ref null $t)` the compiler writes goes through here.
export fn emit_ref_null_valtype(buf: Bytes, type_idx: Int) -> Unit {
  bytebuf_push(buf = buf, byte = 99)
  leb128_encode_s32(buf = buf, value = type_idx)
}

/// `(func (result (ref null <ref_type_idx>)))` -- the func type an `if` (or any
/// other structured instruction) points at to declare a typed-reference result.
export fn emit_func_type_ref_result(buf: Bytes, ref_type_idx: Int) -> Unit {
  bytebuf_push(buf = buf, byte = 96)
  leb128_encode_u32(buf = buf, value = 0)
  leb128_encode_u32(buf = buf, value = 1)
  emit_ref_null_valtype(buf = buf, type_idx = ref_type_idx)
}

export fn emit_return(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = op_return)
}

