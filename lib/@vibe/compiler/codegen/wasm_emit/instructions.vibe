}

export fn emit_i64_const(buf: Bytes, value: Int) -> Unit {
  bytebuf_push_opcode_s64(buf = buf, opcode = op_i64_const, value = value)
}

/// An `i64.const` / `i32.const` whose operand is a funcref TABLE SLOT -- a
/// function value or a closure header's slot -- at the compile's slot width
/// (#3941), so the slot's magnitude does not decide the body's length. These
/// are the blind relocation kinds 101 / 102; the relocator rewrites them with
/// the same encoders.
export fn emit_i64_const_slot(buf: Bytes, value: Int) -> Unit {
  bytebuf_push(buf = buf, byte = op_i64_const)
  leb128_encode_s_slot(buf = buf, value = value)
}

/// A pooled string's address as an `i64.const` (#3941): the bare offset of
/// `blind_kind_str_ref`, or the `(offset << 32) | length` of
/// `blind_kind_str_fat`, at the compile's string width (`reloc_str_width`),
/// so a literal added anywhere in the program does not change the length of
/// a body that embeds a later string. The relocator re-emits with these.
export fn emit_i64_const_str(buf: Bytes, value: Int, fat: Bool) -> Unit {
  bytebuf_push(buf = buf, byte = op_i64_const)
  leb128_encode_s_padded(buf = buf, value = value, width = reloc_str_width(fat = fat))
}

/// A constructor tag as `i32.const`, at the compile's constructor-tag width
/// (#3941), so a type declared ahead does not change the length of a body
/// that constructs or matches a later type. Kind 105; the relocator re-emits
/// with this.
///
/// A BUILT-IN tag (below `2 << 16`, the first user type) never moves -- the
/// relocator leaves it alone (`lc_map_ctor_tag`) -- so it stays minimal: a
/// variant of type 0 is one byte, and padding it would cost three for nothing.
export fn emit_i32_const_ctor_tag(buf: Bytes, value: Int) -> Unit {
  bytebuf_push(buf = buf, byte = 65)
  let w = if value < 2<<16 {
    0
  } else {
    reloc_ctor_tag_width()
  }
  leb128_encode_s_padded(buf = buf, value = value, width = w)
}

export fn emit_i32_const_slot(buf: Bytes, value: Int) -> Unit {
  bytebuf_push(buf = buf, byte = 65)
  leb128_encode_s_slot(buf = buf, value = value)
}

