}

/// The type index is a relocatable slot (#3941), at the compile's slot
/// width; the table index (always 0 here) stays minimal.
export fn emit_call_indirect(buf: Bytes, type_idx: Int) -> Unit {
  bytebuf_push(buf = buf, byte = op_call_indirect)
