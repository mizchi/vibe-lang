//# Imports

import ../../core {
  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_string, leb128_encode_u32
}

//# Functions

// Emit the standard WebAssembly "name" custom section with a function-names
// subsection (id 1) naming `count` consecutive functions starting at
// `base_index`. Custom sections are ignored at execution time, so this only
// improves tooling/trace readability (e.g. wasm backtraces show `main` instead
// of `<wasm function N>`). This is debugger P0 groundwork (ADR-0035 /
// docs/release-roadmap.md テーマ3): a source-line map can be layered on later.
export fn emit_function_name_section(out: Bytes, names: Array[String], base_index: Int) -> Unit {
  let count = Array::length(names)
  if count == 0 {
    ()
  } else {
    let content = bytebuf_new()
    bytebuf_push_string(content, "name")
    // function-names subsection: vec of (funcidx, name), funcidx ascending.
    let namemap = bytebuf_new()
    leb128_encode_u32(namemap, count)
    let mut i = 0
    while i < count {
      leb128_encode_u32(namemap, base_index + i)
      bytebuf_push_string(namemap, Array::get(names, i))
      i = i + 1
    }
    bytebuf_push_section(content, 1, namemap)
    bytebuf_push_section(out, 0, content)
  }
}

fn emit_ascii_payload(buf: Bytes, text: String) -> Unit {
  let len = String::length(text)
  let mut i = 0
  while i < len {
    bytebuf_push(buf, String::char_code_at(text, i))
    i = i + 1
  }
}

export fn emit_vibe_abi_custom_section(out: Bytes, host_import_abi: String) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_string(content, "vibe.abi")
  emit_ascii_payload(content, "version=1\n")
  emit_ascii_payload(content, String::concat("host_import_abi=", host_import_abi))
  emit_ascii_payload(content, "\n")
  bytebuf_push_section(out, 0, content)
}
