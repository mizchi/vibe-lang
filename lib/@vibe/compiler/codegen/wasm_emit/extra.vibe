//# Imports

import .. / .. / core {
  bytebuf_new, bytebuf_push, bytebuf_push2, bytebuf_push_buf, bytebuf_push_opcode_u32, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32
}

import ./base.vibe {
  emit_end, emit_i32_const, emit_name
}

//# Functions

let vt_i32 = 127

let sec_data = 11

let type_func = 96

let sec_export = 7

let sec_global = 6

let sec_import = 2

let export_func = 0

let export_memory = 2

let op_global_get = 35

let op_global_set = 36

let op_i32_add = 106

let op_i32_sub = 107

let op_i32_shr_u = 118

let op_i32_gt_u = 75

let op_memory_size = 63

let op_memory_grow = 64

let op_drop = 26

let op_if = 4

let bt_void = 64

export fn emit_global_get(buf: Bytes, idx: Int) -> Unit {
  bytebuf_push_opcode_u32(buf, op_global_get, idx)
}

export fn emit_heap_memory_grow_check(buf: Bytes) -> Unit {
  // Grow memory to `(heap_ptr + 65536) >> 16` pages — i.e. ALWAYS at least one
  // page past `heap_ptr`. The previous `+ 65535` rounded to `ceil(heap_ptr /
  // 65536)`, which holds only `[0, heap_ptr)`; when `heap_ptr` lands exactly on
  // a page boundary that leaves `memory_size == heap_ptr`, and an access at
  // `heap_ptr` (the next slot the bump allocator hands out) traps with
  // "memory access out of bounds". The `+ 65536` reserves a guard page so
  // `heap_ptr` itself is always addressable. Monotonic: never grows LESS than
  // before, so it cannot under-allocate.
  emit_global_get(buf, 0)
  emit_i32_const(buf, 65536)
  bytebuf_push(buf, op_i32_add)
  emit_i32_const(buf, 16)
  bytebuf_push(buf, op_i32_shr_u)
  bytebuf_push2(buf, op_memory_size, 0)
  bytebuf_push(buf, op_i32_gt_u)
  bytebuf_push2(buf, op_if, bt_void)
  emit_global_get(buf, 0)
  emit_i32_const(buf, 65536)
  bytebuf_push(buf, op_i32_add)
  emit_i32_const(buf, 16)
  bytebuf_push(buf, op_i32_shr_u)
  bytebuf_push2(buf, op_memory_size, 0)
  bytebuf_push(buf, op_i32_sub)
  bytebuf_push2(buf, op_memory_grow, 0)
  bytebuf_push(buf, op_drop)
  emit_end(buf)
}

export fn emit_global_set(buf: Bytes, idx: Int) -> Unit {
  bytebuf_push_opcode_u32(buf, op_global_set, idx)
}

export fn emit_data_section(out: Bytes, offset: Int, data: Bytes) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  bytebuf_push(content, 0)
  emit_i32_const(content, offset)
  emit_end(content)
  leb128_encode_u32(content, Bytes::length(data))
  bytebuf_push_buf(content, data)
  bytebuf_push_section(out, sec_data, content)
}

export fn emit_exports_full(out: Bytes, fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int, global_names: Array[String], global_indices: Array[Int]) -> Unit {
  let count = Array::length(fn_names) + 1 + Array::length(global_names)
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < Array::length(fn_names) {
    emit_name(content, Array::get(fn_names, i))
    bytebuf_push(content, export_func)
    leb128_encode_u32(content, Array::get(fn_indices, i))
    i = i + 1
  }
  emit_name(content, mem_name)
  bytebuf_push(content, export_memory)
  leb128_encode_u32(content, mem_idx)
  let mut gi = 0
  while gi < Array::length(global_names) {
    emit_name(content, Array::get(global_names, gi))
    bytebuf_push(content, 3)
    leb128_encode_u32(content, Array::get(global_indices, gi))
    gi = gi + 1
  }
  bytebuf_push_section(out, sec_export, content)
}

export fn emit_export_memory(out: Bytes, name: String, mem_idx: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  emit_name(content, name)
  bytebuf_push(content, export_memory)
  leb128_encode_u32(content, mem_idx)
  bytebuf_push_section(out, sec_export, content)
}

export fn emit_func_type_raw(buf: Bytes, param_types: Array[Int], result_types: Array[Int]) -> Unit {
  bytebuf_push(buf, type_func)
  leb128_encode_u32(buf, Array::length(param_types))
  let mut i = 0
  while i < Array::length(param_types) {
    bytebuf_push(buf, Array::get(param_types, i))
    i = i + 1
  }
  leb128_encode_u32(buf, Array::length(result_types))
  let mut j = 0
  while j < Array::length(result_types) {
    bytebuf_push(buf, Array::get(result_types, j))
    j = j + 1
  }
}

export fn emit_exports_with_memory(out: Bytes, fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int) -> Unit {
  let count = Array::length(fn_names) + 1
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < Array::length(fn_names) {
    emit_name(content, Array::get(fn_names, i))
    bytebuf_push(content, export_func)
    leb128_encode_u32(content, Array::get(fn_indices, i))
    i = i + 1
  }
  emit_name(content, mem_name)
  bytebuf_push(content, export_memory)
  leb128_encode_u32(content, mem_idx)
  bytebuf_push_section(out, sec_export, content)
}

export fn emit_import_section_func(out: Bytes, module_name: String, field_name: String, type_idx: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  emit_name(content, module_name)
  emit_name(content, field_name)
  bytebuf_push(content, export_func)
  leb128_encode_u32(content, type_idx)
  bytebuf_push_section(out, sec_import, content)
}

export fn emit_global_section_i32_mut(out: Bytes, init_value: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  bytebuf_push2(content, vt_i32, 1)
  emit_i32_const(content, init_value)
  emit_end(content)
  bytebuf_push_section(out, sec_global, content)
}
