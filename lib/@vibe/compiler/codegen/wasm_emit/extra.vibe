//# Imports

import @vibe/compiler/core {
  bytebuf_new,
  bytebuf_push,
  bytebuf_push2,
  bytebuf_push_buf,
  bytebuf_push_opcode_u32,
  bytebuf_push_section,
  bytebuf_push_vec_header,
  leb128_encode_u32
}

import ./base.vibe {
  emit_end, emit_i32_const, emit_name
}

//# Functions

let vt_i32 = 127

let sec_data = 11

let type_func = 96

let sec_export = 7

let sec_global = 6

let sec_import = 2

let export_func = 0

let export_memory = 2

let op_global_get = 35

let op_global_set = 36

let op_i32_add = 106

let op_i32_sub = 107

let op_i32_shr_u = 118

let op_i32_gt_u = 75

let op_i32_gt_s = 74

let op_local_get = 32

let op_local_tee = 34

let op_memory_size = 63

let op_memory_grow = 64

let op_drop = 26

let op_select = 27

let op_i32_eq = 70

let op_if = 4

let bt_void = 64

export fn emit_global_get(buf: Bytes, idx: Int) -> Unit {
  bytebuf_push_opcode_u32(buf = buf, opcode = op_global_get, value = idx)
}

/// pushes `needed_pages - memory_size` (the exact page deficit) on the stack.
fn emit_heap_page_deficit(_ buf: Bytes) -> Unit {
  emit_global_get(buf = buf, idx = 0)
  emit_i32_const(buf = buf, value = 65536)
  bytebuf_push(buf = buf, byte = op_i32_add)
  emit_i32_const(buf = buf, value = 16)
  bytebuf_push(buf = buf, byte = op_i32_shr_u)
  bytebuf_push2(buf = buf, b1 = op_memory_size, b2 = 0)
  bytebuf_push(buf = buf, byte = op_i32_sub)
}

/// pushes `memory_size / 2` on the stack.
fn emit_heap_half_current(_ buf: Bytes) -> Unit {
  bytebuf_push2(buf = buf, b1 = op_memory_size, b2 = 0)
  emit_i32_const(buf = buf, value = 1)
  bytebuf_push(buf = buf, byte = op_i32_shr_u)
}

export fn emit_heap_memory_grow_check(_ buf: Bytes) -> Unit {
  // Grow memory when `(heap_ptr + 65536) >> 16` pages exceed `memory_size` —
  // i.e. ALWAYS keep at least one page past `heap_ptr`. The `+ 65536` (not
  // `+ 65535`) reserves a guard page so `heap_ptr` itself (the next slot the
  // bump allocator hands out) is always addressable even when it lands
  // exactly on a page boundary. Monotonic: never grows LESS than before.
  //
  // Growth POLICY (2026-07 perf): grow by `max(deficit, memory_size / 2)`
  // instead of the exact deficit. The exact-deficit policy grew a large
  // compile's heap in thousands of 1-2 page steps; on the node host every
  // `memory.grow` invalidates the cached typed-array views and stampedes
  // V8's external-memory GC accounting — profiling the selfcompile KPI
  // showed 38% of CPU inside V8's GC and pre-growing the memory up front
  // halved wall time (14.1s -> 6.4s). Exponential growth caps the number of
  // grows at O(log heap) with at most 50% address-space overshoot; untouched
  // tail pages are never written by the bump allocator, so RSS barely moves.
  // If the 1.5x request fails (memory.grow == -1: the module declares no
  // max, so only near the wasm32 4GB ceiling), RETRY with the exact deficit
  // — the old policy's request — so a large-but-satisfiable allocation near
  // the ceiling still succeeds exactly as before.
  emit_global_get(buf = buf, idx = 0)
  emit_i32_const(buf = buf, value = 65536)
  bytebuf_push(buf = buf, byte = op_i32_add)
  emit_i32_const(buf = buf, value = 16)
  bytebuf_push(buf = buf, byte = op_i32_shr_u)
  bytebuf_push2(buf = buf, b1 = op_memory_size, b2 = 0)
  bytebuf_push(buf = buf, byte = op_i32_gt_u)
  bytebuf_push2(buf = buf, b1 = op_if, b2 = bt_void)
  // grow_by = max(deficit, memory_size/2)  (select re-derives both operands:
  // this body has no locals, and it runs O(log heap) times, so the few extra
  // instructions are irrelevant)
  emit_heap_page_deficit(buf)
  emit_heap_half_current(buf)
  emit_heap_page_deficit(buf)
  emit_heap_half_current(buf)
  bytebuf_push(buf = buf, byte = op_i32_gt_u)
  bytebuf_push(buf = buf, byte = op_select)
  bytebuf_push2(buf = buf, b1 = op_memory_grow, b2 = 0)
  // -1 = the oversized request failed; retry with the exact deficit.
  emit_i32_const(buf = buf, value = -1)
  bytebuf_push(buf = buf, byte = op_i32_eq)
  bytebuf_push2(buf = buf, b1 = op_if, b2 = bt_void)
  emit_heap_page_deficit(buf)
  bytebuf_push2(buf = buf, b1 = op_memory_grow, b2 = 0)
  bytebuf_push(buf = buf, byte = op_drop)
  emit_end(buf)
  emit_end(buf)
}

/// emit_heap_memory_grow_check for a body with two i32 locals it may
/// clobber: the same test and the same growth policy, with the deficit
/// computed once into `deficit_local` (and `memory_size / 2` into
/// `half_local`) instead of re-derived for every use. The deficit is a
/// signed page count, at most 65536 either way: heap_ptr never passes
/// 2^32 - 65537 (the allocator traps first), so `heap_ptr + 65536` does not
/// wrap, and "deficit > 0" is the unsigned `pages > memory_size` above.
export fn emit_heap_memory_grow_check_locals(buf: Bytes, deficit_local: Int, half_local: Int) -> Unit {
  emit_heap_page_deficit(buf)
  bytebuf_push_opcode_u32(buf = buf, opcode = op_local_tee, value = deficit_local)
  emit_i32_const(buf = buf, value = 0)
  bytebuf_push(buf = buf, byte = op_i32_gt_s)
  bytebuf_push2(buf = buf, b1 = op_if, b2 = bt_void)
  // grow_by = max(deficit, memory_size / 2)
  bytebuf_push_opcode_u32(buf = buf, opcode = op_local_get, value = deficit_local)
  emit_heap_half_current(buf)
  bytebuf_push_opcode_u32(buf = buf, opcode = op_local_tee, value = half_local)
  bytebuf_push_opcode_u32(buf = buf, opcode = op_local_get, value = deficit_local)
  bytebuf_push_opcode_u32(buf = buf, opcode = op_local_get, value = half_local)
  bytebuf_push(buf = buf, byte = op_i32_gt_u)
  bytebuf_push(buf = buf, byte = op_select)
  bytebuf_push2(buf = buf, b1 = op_memory_grow, b2 = 0)
  // -1 = the oversized request failed; retry with the exact deficit.
  emit_i32_const(buf = buf, value = -1)
  bytebuf_push(buf = buf, byte = op_i32_eq)
  bytebuf_push2(buf = buf, b1 = op_if, b2 = bt_void)
  bytebuf_push_opcode_u32(buf = buf, opcode = op_local_get, value = deficit_local)
  bytebuf_push2(buf = buf, b1 = op_memory_grow, b2 = 0)
  bytebuf_push(buf = buf, byte = op_drop)
  emit_end(buf)
  emit_end(buf)
}

export fn emit_global_set(buf: Bytes, idx: Int) -> Unit {
  bytebuf_push_opcode_u32(buf = buf, opcode = op_global_set, value = idx)
}

export fn emit_data_section(out: Bytes, offset: Int, data: Bytes) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(buf = content, count = 1)
  bytebuf_push(buf = content, byte = 0)
  emit_i32_const(buf = content, value = offset)
  emit_end(content)
  leb128_encode_u32(buf = content, value = Bytes::length(data))
  bytebuf_push_buf(dst = content, src = data)
  bytebuf_push_section(out = out, section_id = sec_data, content = content)
}

export fn emit_exports_full(out: Bytes, fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int, global_names: Array[String], global_indices: Array[Int]) -> Unit {
  let count = Array::length(fn_names) + 1 + Array::length(global_names)
  let content = bytebuf_new()
  bytebuf_push_vec_header(buf = content, count = count)
  let mut i = 0
  while i < Array::length(fn_names) {
    emit_name(buf = content, name = Array::get(fn_names, at = i))
    bytebuf_push(buf = content, byte = export_func)
    leb128_encode_u32(buf = content, value = Array::get(fn_indices, at = i))
    i = i + 1
  }
  emit_name(buf = content, name = mem_name)
  bytebuf_push(buf = content, byte = export_memory)
  leb128_encode_u32(buf = content, value = mem_idx)
  let mut gi = 0
  while gi < Array::length(global_names) {
    emit_name(buf = content, name = Array::get(global_names, at = gi))
    bytebuf_push(buf = content, byte = 3)
    leb128_encode_u32(buf = content, value = Array::get(global_indices, at = gi))
    gi = gi + 1
  }
  bytebuf_push_section(out = out, section_id = sec_export, content = content)
}

export fn emit_export_memory(out: Bytes, name: String, mem_idx: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(buf = content, count = 1)
  emit_name(buf = content, name = name)
  bytebuf_push(buf = content, byte = export_memory)
  leb128_encode_u32(buf = content, value = mem_idx)
  bytebuf_push_section(out = out, section_id = sec_export, content = content)
}

export fn emit_func_type_raw(buf: Bytes, param_types: Array[Int], result_types: Array[Int]) -> Unit {
  bytebuf_push(buf = buf, byte = type_func)
  leb128_encode_u32(buf = buf, value = Array::length(param_types))
  let mut i = 0
  while i < Array::length(param_types) {
    bytebuf_push(buf = buf, byte = Array::get(param_types, at = i))
    i = i + 1
  }
  leb128_encode_u32(buf = buf, value = Array::length(result_types))
  let mut j = 0
  while j < Array::length(result_types) {
    bytebuf_push(buf = buf, byte = Array::get(result_types, at = j))
    j = j + 1
  }
}

export fn emit_exports_with_memory(out: Bytes, fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int) -> Unit {
  let count = Array::length(fn_names) + 1
  let content = bytebuf_new()
  bytebuf_push_vec_header(buf = content, count = count)
  let mut i = 0
  while i < Array::length(fn_names) {
    emit_name(buf = content, name = Array::get(fn_names, at = i))
    bytebuf_push(buf = content, byte = export_func)
    leb128_encode_u32(buf = content, value = Array::get(fn_indices, at = i))
    i = i + 1
  }
  emit_name(buf = content, name = mem_name)
  bytebuf_push(buf = content, byte = export_memory)
  leb128_encode_u32(buf = content, value = mem_idx)
  bytebuf_push_section(out = out, section_id = sec_export, content = content)
}

export fn emit_import_section_func(out: Bytes, module_name: String, field_name: String, type_idx: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(buf = content, count = 1)
  emit_name(buf = content, name = module_name)
  emit_name(buf = content, name = field_name)
  bytebuf_push(buf = content, byte = export_func)
  leb128_encode_u32(buf = content, value = type_idx)
  bytebuf_push_section(out = out, section_id = sec_import, content = content)
}

export fn emit_global_section_i32_mut(out: Bytes, init_value: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(buf = content, count = 1)
  bytebuf_push2(buf = content, b1 = vt_i32, b2 = 1)
  emit_i32_const(buf = content, value = init_value)
  emit_end(content)
  bytebuf_push_section(out = out, section_id = sec_global, content = content)
}
