//# Imports

import @vibe/compiler/core {
  bytebuf_length,
  bytebuf_new,
  bytebuf_push,
  bytebuf_push_buf,
  bytebuf_push_opcode_s64,
  bytebuf_push_section,
  bytebuf_push_vec_header,
  leb128_encode_u32
}

//# Functions

export fn emit_end(_ buf: Bytes) -> Unit {
  bytebuf_push(buf = buf, byte = 11)
}

export fn emit_i32_const(buf: Bytes, value: Int) -> Unit {
  bytebuf_push_opcode_s64(buf = buf, opcode = 65, value = value)
}

export fn emit_code_section(out: Bytes, bodies: Array[Bytes]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(buf = content, count = Array::length(bodies))
  let mut i = 0
  while i < Array::length(bodies) {
    let body = Array::get(bodies, at = i)
    let func_buf = bytebuf_new()
    leb128_encode_u32(buf = func_buf, value = 0)
    bytebuf_push_buf(dst = func_buf, src = body)
    bytebuf_push(buf = func_buf, byte = 11)
    leb128_encode_u32(buf = content, value = bytebuf_length(func_buf))
    bytebuf_push_buf(dst = content, src = func_buf)
    i = i + 1
  }
  bytebuf_push_section(out = out, section_id = 10, content = content)
}

export fn emit_memory_section(out: Bytes, min_pages: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(buf = content, count = 1)
  bytebuf_push(buf = content, byte = 0)
  leb128_encode_u32(buf = content, value = min_pages)
  bytebuf_push_section(out = out, section_id = 5, content = content)
}

export fn emit_code_section_with_locals(out: Bytes, bodies: Array[Bytes], local_counts: Array[Int]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(buf = content, count = Array::length(bodies))
  let mut i = 0
  while i < Array::length(bodies) {
    let body = Array::get(bodies, at = i)
    let num_locals = Array::get(local_counts, at = i)
    let func_buf = bytebuf_new()
    if num_locals == 0 {
      leb128_encode_u32(buf = func_buf, value = 0)
    } else {
      leb128_encode_u32(buf = func_buf, value = 1)
      leb128_encode_u32(buf = func_buf, value = num_locals)
      bytebuf_push(buf = func_buf, byte = 126)
    }
    bytebuf_push_buf(dst = func_buf, src = body)
    bytebuf_push(buf = func_buf, byte = 11)
    leb128_encode_u32(buf = content, value = bytebuf_length(func_buf))
    bytebuf_push_buf(dst = content, src = func_buf)
    i = i + 1
  }
  bytebuf_push_section(out = out, section_id = 10, content = content)
}
