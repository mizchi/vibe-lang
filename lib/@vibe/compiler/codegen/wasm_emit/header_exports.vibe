//# Imports

import .. / .. / core {
  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_string, bytebuf_push_vec_header, leb128_encode_u32
}

//# Functions

export let emit_name: (Bytes, String) -> Unit = (buf, name) -> {
  bytebuf_push_string(buf, name)
}

export let emit_function_section: (Bytes, Array[Int]) -> Unit = (out, type_indices) -> {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, Array::length(type_indices))
  let mut i = 0
  while i < Array::length(type_indices) {
    leb128_encode_u32(content, Array::get(type_indices, i))
    i = i + 1
  }
  bytebuf_push_section(out, 3, content)
}

export let emit_export_section_multi: (Bytes, Array[String], Array[Int]) -> Unit = (out, names, func_indices) -> {
  let count = Array::length(names)
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < count {
    emit_name(content, Array::get(names, i))
    bytebuf_push(content, 0)
    leb128_encode_u32(content, Array::get(func_indices, i))
    i = i + 1
  }
  bytebuf_push_section(out, 7, content)
}

export let emit_export_section: (Bytes, String, Int) -> Unit = (out, name, func_idx) -> {
  emit_export_section_multi(out, [
    name
  ], [
    func_idx
  ])
}
