//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

import ./double_runtime.vibe {
  double_runtime_to_string_name
}

//# Functions

/// #744 / #2652: `Double::to_string` / `Float::to_string`, and `__to_string`
/// on a statically-floatish argument, lower to ONE call into the Double
/// runtime prelude (double_runtime.vibe) -- `__vibe_double_to_string`, a
/// top-level function every lane appends to a program that can hold a
/// Double (`append_double_runtime`). Shared by the linear callsite handler
/// (expr/compile_call.vibe) and the gc dispatch (gc/backend_call.vibe), which
/// each run `double_runtime_require` first so a lane that never appended the
/// prelude fails loudly at the lowering.
///
/// This used to synthesize the formatter inline at every callsite: a fixed
/// 15-digit fraction over `Double::to_int`, which printed
/// `2.2250738585072014` as `2.225073858507201` and `1e300` as `0` -- silently
/// (#2652). The prelude's formatter is shortest-round-trip and exact; see
/// double_runtime.vibe for the algorithm and the spelling.
export fn double_to_string_expr(arg: Expr) -> Expr {
  ECall(EIdent(double_runtime_to_string_name(), -1), [arg], -1)
}
