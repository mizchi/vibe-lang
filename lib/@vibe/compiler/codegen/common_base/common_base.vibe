//# Trait-desugaring compatibility facade
//
// Dictionary-passing and its pre-check transforms live in normalize so the
// checker does not depend on codegen. Keep this cross-package re-export so
// existing common_base and codegen facade consumers retain their contracts.
export ../../normalize {
  inject_trait_method_generics,
  exn_kind_read_expr,
  exn_msg_read_expr,
  ensure_exn_kind_cell,
  desugar_railway_binds,
  desugar_derives,
  desugar_hoist_local_lambdas,
  desugar_labeled_args,
  desugar_array_spread,
  desugar_trait_dicts,
  unbox_tuple_loop_params
}

//# Types

export struct FuncTable {
  names: Array[String];
  indices: Array[Int];
  params: Array[Int];
  returns: Array[Int];
  needs_env: Array[Bool];
  // #1100: sorted-name index (see ctor_sorted_index/ctor_table_index_of,
  // this file) for func_table_index_of's O(log N) bsearch_leftmost lookup --
  // built ONCE per compile from `names` via ctor_sorted_index, same as
  // CtorTable.names_sorted/names_sorted_pos. `names` itself stays in its
  // original (declaration) order; only this sorted VIEW is new.
  names_sorted: Array[String];
  names_sorted_pos: Array[Int]
}

export struct StrTable {
  strs: Array[String];
  offsets: Array[Int];
  lengths: Array[Int]
}

export struct LambdaTable {
  bodies: Array[Bytes];
  param_counts: Array[Int];
  captures: Array[Array[String]];
  meta_i32: Array[Int];
  meta_i64: Array[Int]
}

/// #1259 step 7: one user function's codegen OUTPUT, carried as a value.
///
/// Body codegen has to become something a coordinator can hand out per
/// function and collect back, and the compiler runs inside wasm -- it cannot
/// spawn workers, and it must not grow an `Fs` row to persist anything (that
/// row propagates out through the codegen facades and into the signatures of
/// user programs that call `compile_wasi_module`, which is not acceptable).
/// So the unit of exchange is a VALUE: the caller (file_compile, which already
/// has Fs) does any serialization.
///
/// Parallel arrays rather than an array of records, matching how `bodies` /
/// `meta_i32` / `meta_i64` and LambdaTable are already carried in this
/// codegen.
///
/// `fn_*` is one entry per cached user function, keyed by `fn_indices`.
/// `lam_*` is one entry per lambda that function produced, keyed by the
/// PLANNED lambda index (#1275/#1277) -- which is what makes a body compiled
/// in isolation reusable: its emitted table_slot immediates already refer to
/// the slots the whole-program assembly will install these lambdas at.
export struct CodegenBodyCache {
  fn_indices: Array[Int];
  fn_bodies: Array[Bytes];
  fn_meta_i32: Array[Int];
  fn_meta_i64: Array[Int];
  /// v128-local run length of the function's code-entry locals header
  /// (inline-wasm fns with `(local $x v128)` declarations; 0 otherwise).
  fn_meta_v128: Array[Int];
  lam_owner: Array[Int];
  lam_indices: Array[Int];
  lam_bodies: Array[Bytes];
  lam_param_counts: Array[Int];
  lam_captures: Array[Array[String]];
  lam_meta_i32: Array[Int];
  lam_meta_i64: Array[Int];
  /// The `table_slots_used` entries this function's compile appended, keyed by
  /// owning function index. Not part of the function's own bytes -- the log is
  /// read only after the body loop, to decide which table slots the element
  /// section registers -- but a replayed function never runs the pushes, so
  /// without carrying them a fully replayed build would emit a SMALLER element
  /// section than a compiled one. The consumer builds a flag set, so order and
  /// duplicates do not matter, which is what lets slices merge freely.
  slot_owner: Array[Int];
  slot_values: Array[Int]
}

/// An empty cache. Threading one of these in means "compile everything, cache
/// nothing" -- the pre-#1259 behaviour.
export fn codegen_body_cache_new() -> CodegenBodyCache {
  CodegenBodyCache::{
    fn_indices: array_empty(),
    fn_bodies: array_empty(),
    fn_meta_i32: array_empty(),
    fn_meta_i64: array_empty(),
    fn_meta_v128: array_empty(),
    lam_owner: array_empty(),
    lam_indices: array_empty(),
    lam_bodies: array_empty(),
    lam_param_counts: array_empty(),
    lam_captures: array_empty(),
    lam_meta_i32: array_empty(),
    lam_meta_i64: array_empty(),
    slot_owner: array_empty(),
    slot_values: array_empty()
  }
}

/// Position of `fn_index` in the cache, or -1. Linear scan: a slice holds at
/// most the whole program's function count, and this runs once per function.
export fn codegen_body_cache_find(cache: CodegenBodyCache, fn_index: Int) -> Int {
  let n = Array::length(cache.fn_indices)
  let mut i = 0
  let mut found = 0 - 1
  while found < 0 && i < n {
    if Array::get(cache.fn_indices, i) == fn_index {
      found = i
    } else {
      i = i + 1
    }
  }
  found
}

/// Append function `fn_index`'s just-finished codegen output to `cache`.
///
/// Reads the LAST entry of `bodies` / `meta_i32` / `meta_i64` -- the loop has
/// just pushed them -- and the lambda table slice `[lam_lo, lam_hi)`, which is
/// exactly the range the plan assigned this function.
export fn codegen_body_cache_record(cache: CodegenBodyCache, fn_index: Int, bodies: Array[Bytes], meta_i32: Array[Int], meta_i64: Array[Int], meta_v128: Array[Int], lt: LambdaTable, lam_lo: Int, lam_hi: Int, slots: Array[Int], slot_lo: Int, slot_hi: Int) -> Unit {
  let n = Array::length(bodies)
  if n == 0 {
    ()
  } else {
    Array::push(cache.fn_indices, fn_index)
    Array::push(cache.fn_bodies, Array::get(bodies, n - 1))
    Array::push(cache.fn_meta_i32, Array::get(meta_i32, Array::length(meta_i32) - 1))
    Array::push(cache.fn_meta_i64, Array::get(meta_i64, Array::length(meta_i64) - 1))
    Array::push(cache.fn_meta_v128, Array::get(meta_v128, Array::length(meta_v128) - 1))
    let mut li = lam_lo
    while li < lam_hi {
      Array::push(cache.lam_owner, fn_index)
      Array::push(cache.lam_indices, li)
      Array::push(cache.lam_bodies, Array::get(lt.bodies, li))
      Array::push(cache.lam_param_counts, Array::get(lt.param_counts, li))
      Array::push(cache.lam_captures, Array::get(lt.captures, li))
      Array::push(cache.lam_meta_i32, Array::get(lt.meta_i32, li))
      Array::push(cache.lam_meta_i64, Array::get(lt.meta_i64, li))
      li = li + 1
    }
    let mut si = slot_lo
    while si < slot_hi {
      Array::push(cache.slot_owner, fn_index)
      Array::push(cache.slot_values, Array::get(slots, si))
      si = si + 1
    }
  }
}

/// Concatenate two harvests. Used to reassemble the whole program from the
/// per-slice caches a `--jobs N` run produces.
///
/// A plain append is enough because nothing in a cache entry is positional: a
/// function is keyed by `fn_indices`, a lambda by its PLANNED index, and a
/// table slot by its owning function. Replay looks each up by key and pushes
/// in the body loop's order, so the order entries sit in here never reaches
/// the output. Slices are expected to be disjoint; overlapping ones would give
/// `codegen_body_cache_find` two candidates and it would take the first.
export fn codegen_body_cache_merge(a: CodegenBodyCache, b: CodegenBodyCache) -> CodegenBodyCache {
  let out = codegen_body_cache_new()
  let mut si = 0
  while si < 2 {
    let src = if si == 0 {
      a
    } else {
      b
    }
    let fn_n = Array::length(src.fn_indices)
    let mut i = 0
    while i < fn_n {
      Array::push(out.fn_indices, Array::get(src.fn_indices, i))
      Array::push(out.fn_bodies, Array::get(src.fn_bodies, i))
      Array::push(out.fn_meta_i32, Array::get(src.fn_meta_i32, i))
      Array::push(out.fn_meta_i64, Array::get(src.fn_meta_i64, i))
      Array::push(out.fn_meta_v128, Array::get(src.fn_meta_v128, i))
      i = i + 1
    }
    let lam_n = Array::length(src.lam_owner)
    let mut j = 0
    while j < lam_n {
      Array::push(out.lam_owner, Array::get(src.lam_owner, j))
      Array::push(out.lam_indices, Array::get(src.lam_indices, j))
      Array::push(out.lam_bodies, Array::get(src.lam_bodies, j))
      Array::push(out.lam_param_counts, Array::get(src.lam_param_counts, j))
      Array::push(out.lam_captures, Array::get(src.lam_captures, j))
      Array::push(out.lam_meta_i32, Array::get(src.lam_meta_i32, j))
      Array::push(out.lam_meta_i64, Array::get(src.lam_meta_i64, j))
      j = j + 1
    }
    let slot_n = Array::length(src.slot_owner)
    let mut k = 0
    while k < slot_n {
      Array::push(out.slot_owner, Array::get(src.slot_owner, k))
      Array::push(out.slot_values, Array::get(src.slot_values, k))
      k = k + 1
    }
    si = si + 1
  }
  out
}

/// Replay cache entry `at` into the whole-program accumulators, in place of
/// compiling that function.
///
/// The lambdas go back by plain append, which lands them at their planned
/// indices exactly because functions are replayed in the same order they were
/// planned: `lt.bodies` is `lam_lo` long when this runs. That is the same
/// invariant the compile path relies on, so a replayed function and a compiled
/// one leave the table identical.
export fn codegen_body_cache_replay(cache: CodegenBodyCache, at: Int, bodies: Array[Bytes], meta_i32: Array[Int], meta_i64: Array[Int], meta_v128: Array[Int], lt: LambdaTable, slots: Array[Int]) -> Unit {
  let owner = Array::get(cache.fn_indices, at)
  Array::push(bodies, Array::get(cache.fn_bodies, at))
  Array::push(meta_i32, Array::get(cache.fn_meta_i32, at))
  Array::push(meta_i64, Array::get(cache.fn_meta_i64, at))
  Array::push(meta_v128, Array::get(cache.fn_meta_v128, at))
  let n = Array::length(cache.lam_owner)
  let mut i = 0
  while i < n {
    if Array::get(cache.lam_owner, i) == owner {
      Array::push(lt.bodies, Array::get(cache.lam_bodies, i))
      Array::push(lt.param_counts, Array::get(cache.lam_param_counts, i))
      Array::push(lt.captures, Array::get(cache.lam_captures, i))
      Array::push(lt.meta_i32, Array::get(cache.lam_meta_i32, i))
      Array::push(lt.meta_i64, Array::get(cache.lam_meta_i64, i))
    } else {
      ()
    }
    i = i + 1
  }
  let sn = Array::length(cache.slot_owner)
  let mut si = 0
  while si < sn {
    if Array::get(cache.slot_owner, si) == owner {
      Array::push(slots, Array::get(cache.slot_values, si))
    } else {
      ()
    }
    si = si + 1
  }
}

export struct CtorTable {
  names: Array[String];
  tags: Array[Int];
  field_counts: Array[Int];
  type_names: Array[String];
  struct_names: Array[String];
  struct_field_names: Array[Array[String]];
  // #1542: parallel to struct_field_names -- whether each declared field is a
  // reference-lane array, which decides that field's wasm type.
  struct_field_is_ref: Array[Array[Bool]];
  // Sorted view of `names` + original-position payload (ctor_sorted_index).
  // ctor_table_index_of binary-searches these instead of linearly scanning
  // `names` per constructor reference -- lookup_ctor was a top-10 self-time
  // entry in compiler-closure compile profiles. Keep in sync with `names`
  // (same length); ctor_table_index_of falls back to the linear scan when a
  // hand-built table skips them.
  names_sorted: Array[String];
  names_sorted_pos: Array[Int]
}

/// #cov branch coverage state, threaded via CompileCtx. Linear-backend only;
/// active only when `enabled` (VIBE_COVERAGE=1 build). `base`/`cap` bound a fixed
/// reserved memory region (1 byte per branch id). `next` is a 1-element mutable
/// counter cell assigning sequential branch ids in codegen-traversal order;
/// `cur_fn` is a 1-element cell holding the index of the function currently being
/// compiled (set before each top-level body). `owners` accumulates, per branch
/// id in id order, the owning function index so the report attributes branches to
/// functions (reusing the `vibe_cov` function-name table). When disabled all of
/// this is inert and codegen output is byte-identical to a normal build.
export struct CovState {
  enabled: Bool;
  base: Int;
  cap: Int;
  next: Array[Int];
  cur_fn: Array[Int];
  owners: Array[Int]
}

/// A disabled CovState (coverage off): inert, used by the normal compile path and
/// the non-WASI module entry. Fresh 1-element cells keep Array::get safe.
export fn cov_disabled() -> CovState {
  CovState::{
    enabled: false,
    base: 0,
    cap: 0,
    next: [
      0
    ],
    cur_fn: [
      0
    ],
    owners: ArrayBuilder::freeze(ArrayBuilder::new())
  }
}

/// #cov: emit a stack-neutral hit store for one branch target and assign it the
/// next sequential branch id, recording the owning function index. No-op when
/// coverage is off or the fixed-cap region is full. Called at the start of each
/// branch arm's instruction sequence (if/else, match arm), so the store runs
/// only when that branch is actually taken at run time.
export fn cov_emit_branch(buf: Bytes, cov: CovState) -> Unit {
  if cov.enabled {
    let id = Array::get(cov.next, 0)
    if id < cov.cap {
      Array::set(cov.next, 0, id + 1)
      Array::push(cov.owners, Array::get(cov.cur_fn, 0))
      emit_i32_const(buf, cov.base + id)
      emit_i32_const(buf, 1)
      emit_i32_store8(buf, 0, 0)
    } else {
      ()
    }
  } else {
    ()
  }
}

export struct CompileCtx {
  func_table: FuncTable;
  str_table: StrTable;
  lambda_table: LambdaTable;
  num_user_funcs: Int;
  func_offset: Int;
  ref_cell_names: Array[String];
  ctor_table: CtorTable;
  // #1062: sparse `ctor_idx * 64 + field_idx` entries for constructor (enum
  // variant / struct) fields whose DECLARED type is Double/Float, keyed by
  // position in ctor_table.names (see ctor_table_index_of) and positional
  // field index (see ctor_table's field_counts). Built once from the
  // program's SEnum/SSuberror/SStruct declarations (the only place a
  // constructor field's static type is available -- codegen itself is
  // otherwise untyped, see float_local_slots below). Consulted by
  // bind_match_pat (compile_match.vibe) so a pattern-bound field like `r` in
  // `Circle(r) => r * r` gets registered into float_local_slots exactly like
  // a `let`-bound float, instead of falling through to the integer-multiply
  // path and treating a boxed-float pointer as a scalar (OOB trap under RC).
  ctor_float_fields: Array[Int];
  thunk_names: Array[String];
  const_int_names: Array[String];
  const_int_values: Array[Int];
  // Perceus RC mode (docs/spec/selfhost-rc-port.md). When true, heap objects
  // carry a uniform `[type_id@0][length@4][payload@8...]` header so the (future)
  // RC drop helper can dispatch and recurse. Default false: layout unchanged.
  // Threaded as a parameter on the WASI compile path (a module-level flag is
  // not usable: a getter capturing it is `missing closure env` in the native
  // CLI codegen, and a cross-module `let` reference is `unknown name`).
  enable_rc: Bool;
  // #1696: under RC the exported entry's RESULT is untagged, and that untag is
  // appended after the body -- which a `return` jumps straight past, handing the
  // host a tagged (doubled) value. True only while compiling the entry
  // function's own body, so `return` untags there too. Deliberately not
  // propagated into `lam_ctx` (compile_lambda.vibe): a lambda is a separate
  // wasm function whose result is an ordinary tagged value.
  rc_entry_untag_return: Bool;
  // #715 recurrence guard (VIBE_RC=shadow): emit shadow-liveness traps -- a
  // byte per heap address marks freed blocks; the FIRST dup-of-freed or
  // drop-of-freed executes `unreachable` instead of silently corrupting the
  // free list. Debug-only; false (byte-identical output) on normal builds.
  rc_shadow: Bool;
  // RC: names of `let` bindings whose value the Perceus analysis says to drop
  // at scope end (computed per function from build_perceus_plan). compile_expr
  // emits an rc_drop for a tuple binding whose name appears here.
  rc_drop_names: Array[String];
  // RC: alias bindings (`let a = t`) whose source `t` is multiply-used, so the
  // alias takes a duplicated reference — compile_expr emits an rc_dup of the
  // source at the alias `let`. (PaAliasDup from the Perceus plan.)
  rc_alias_dup_names: Array[String];
  // RC: bindings known at codegen time to hold a heap object (bound to a
  // tuple/record/enum literal, or an alias of such). Built as `let`s compile.
  // Gates rc_dup / rc_drop so we never touch a non-heap (e.g. Int-returning
  // call) binding the static Perceus `scalar` flag over-approximates as heap.
  heap_binding_names: Array[String];
  // RC: wasm function index of the generic recursive `vibe_rc_drop` helper
  // (ADR-0055 Stage 3), or -1 when unavailable (non-RC, or the legacy inline
  // drop). When >= 0, scope-end drops emit a `call` to it so nested heap is
  // reclaimed to arbitrary depth.
  rc_drop_func_idx: Int;
  // RC: wasm function index of the free-list search allocator `vibe_rc_alloc`
  // (ADR-0055 Stage 4), or -1 when unavailable (non-RC). When >= 0, heap-object
  // construction calls it with the block size so an exact-fit free block is found
  // anywhere in the free-list (not just the head), eliminating the size-ordering
  // fragmentation a head-only check leaves when interleaved sizes are freed.
  rc_alloc_func_idx: Int;
  // ADR-0092 (#1262): index of the out-of-line dup helper (__rt_rc_dup).
  // -1 outside the linked RC path, which makes emit_rc_dup_guarded fall back
  // to the inline form.
  rc_dup_func_idx: Int;
  // ADR-0090 (#1262): the region arena. `region_ptr_addr` is the linear-memory
  // address of the arena bump pointer, or -1 when this module has no region
  // (or is on the RC lane, where the arena is not yet safe -- see the layout
  // comment in wasi/linked_compile.vibe). The two func indices are the arena
  // variants of `ArrayBuilder::new` / `ArrayBuilder::push`, -1 alongside.
  // Everything else about the segment is derived from region_ptr_addr by the
  // region_* helpers below, so the emitter and the layout cannot disagree.
  region_ptr_addr: Int;
  region_arr_new_func_idx: Int;
  region_bytes_new_func_idx: Int;
  // Linear-memory backend: wasm function index of `vibe_heap_grow_check`, or -1
  // when the surrounding module does not define the helper. Bump allocations
  // call it after updating global 0 so low initial memory can grow on demand.
  heap_grow_check_func_idx: Int;
  // Map[String,V] O(1)-average get/has_key side hash index (see the doc
  // comment on gen_map_hash_body, builtin_bodies/bodies_core_b.vibe). -1 in
  // any CompileCtx that doesn't wire these (e.g. compile_module_expr.vibe's
  // non-linked lite path) -- Map::get/has_key/set/delete/MapBuilder::freeze
  // all fall back to the untouched linear-scan/no-index codegen whenever
  // map_probe_func_idx / map_build_index_func_idx is negative.
  map_hash_func_idx: Int;
  map_cap_func_idx: Int;
  map_build_index_func_idx: Int;
  map_probe_func_idx: Int;
  // RC: names of `let` bindings the Perceus plan marks with a non-alias `PaDup`
  // (a heap value used in more than one *owning* position, e.g. `let u = (t, t)`
  // dups `t`). One entry per dup (so a name's multiplicity = its dup budget).
  // compile_expr emits that many guarded rc_dups at the binding site, giving the
  // block the extra references its container/owning uses consume — without this
  // the recursive drop visits the shared child more times than it has refs.
  // (ADR-0055 Stage 4.)
  rc_dup_names: Array[String];
  // Blocker-3 (ADR-0055): append-only log of `slot*2 + flag` entries (flag 1 =
  // a `let`/`let mut` binding whose value is statically floatish; flag 0 = a
  // non-float rebind overriding a previously-float slot). The MOST RECENT entry
  // for a local slot wins, so `expr_is_floatish` can recognise a *variable*
  // holding a float (`let x = 1.5; x + y` takes the f64 path) while a shadowing
  // rebind of another type — nested block or if/match branch reusing the slot —
  // is classified by its own binding. Append-only (not truncated) because the
  // wasm-gc backend cannot truncate a struct-field array; the log only grows for
  // float-related bindings, which are rare. Still a syntactic over-
  // approximation (the AST is untyped): float function params / lambda-captured
  // floats are not tracked.
  // #799 perf: membership index over func_table.names + ctor_table.names,
  // built ONCE per compile. collect_free_vars_indexed consults it per ident
  // instead of linearly scanning the flat name arrays (which was ~70% of a
  // compiler-closure compile's profile).
  // Round 2: the Map representation was itself a linear assoc scan per
  // lookup (Map::has_key is O(entries)); now a SORTED name array consulted
  // via binary search (core/sorted_index.vibe).
  capture_name_index: Array[String];
  float_local_slots: Array[Int];
  // #678: append-only log of `slot*2 + flag` entries, the integer dual of
  // float_local_slots. flag 1 marks a `let`/`let mut` slot whose value is
  // statically integral (Int/Bool); flag 0 a non-int rebind overriding a
  // previously-int slot. Most-recent entry per slot wins, so a bare integer
  // variable in `==`/`!=` takes the direct `i64.eq` path instead of the
  // polymorphic `eq` whose string fall-back misreads a large int as a string
  // fat-pointer (two unequal ints with a zero low word compare EQUAL). UNLIKE
  // the float log this one IS pruned: `int_log_reset_above` drops entries for
  // slots a branch/arm is about to reuse, so a slot rebound by a NON-`let`
  // binder (match-arm / for-in / catch-all pattern var) — which never logs an
  // entry — is never read as a stale int. Without that pruning a reused slot
  // holding a string would be misclassified and string `==` would break.
  int_local_slots: Array[Int];
  // #724: append-only log of `slot*256 + kind*64 + n` entries tracking
  // let-bound AGGREGATE literals, so `a == b` with BOTH sides non-literal
  // bindings can still take the structural comparators (the generic runtime
  // `eq` pointer-compares tuples, which carry no runtime header to walk).
  // kind 1 = tuple literal (n = arity), kind 2 = ctor / record literal
  // (n = field count), kind 0 = non-aggregate rebind overriding a reused
  // slot. Most-recent entry per slot wins; pruned at the same branch/arm
  // boundaries as int_local_slots (agg_log_reset_above) so a slot reused by
  // a non-`let` binder is never read as a stale aggregate. Bindings whose
  // value shape is not statically known (params, call results, match binds)
  // are NOT tracked and keep the generic-eq fallback.
  agg_local_slots: Array[Int];
  // #672 (post-#724): parallel array to agg_local_slots, SAME length and
  // index correspondence (every push to agg_local_slots pushes exactly one
  // entry here too, in the same call). Holds the actual shape LITERAL
  // expression (ETuple / ctor ECall / nullary-ctor EIdent) backing a kind-1
  // (tuple) or kind-2 (ctor/record) entry, or an inert EInt(0) placeholder
  // for kind-0 / untracked entries (never consulted — callers only read this
  // after confirming kind via agg_slot_lookup). This lets `a == b` on a
  // TRACKED variable recurse into NESTED aggregate elements (e.g. `let a =
  // ((1,2),3)`) the same way a literal operand does, instead of only
  // comparing the top-level shape and falling back to pointer `eq` for any
  // element that is itself an aggregate. See agg_expr_lookup / emit_eq_shape_slots
  // (compile_expr.vibe).
  agg_local_exprs: Array[Expr];
  // #724 round 2: program-wide (fn name -> declared aggregate return shape)
  // parallel arrays (see compute_agg_returning). Shared across functions —
  // NOT per-function like agg_local_slots.
  agg_ret_names: Array[String];
  agg_ret_infos: Array[Int];
  // #791: program-wide (fn name) set for top-level functions whose DECLARED
  // return type is heap (see compute_heap_returning / type_expr_is_heap).
  // Consulted by classify_let_value_heap so `let mut s = Set::new()` reads
  // Set::new's own `-> Set[T]` signature instead of over-approximating every
  // ECall-valued let/let-mut as heap. Shared across functions, like
  // agg_ret_names.
  heap_ret_names: Array[String];
  // #545 nesting: declared effect names (excluding `Error`), in tag-assignment
  // order. Effect `effect_names[i]` is routed through wasm exception tag `3 + i`
  // with its own resume frontier; `perform` and `handle` both derive the tag
  // from this list so a perform reaches its own handler through an unrelated
  // inner handle (which catches a different tag) and uses an independent
  // frontier. See effect_name_to_tag.
  effect_names: Array[String];
  // #548 multi-value payloads: parallel arrays keyed by full op name
  // ("Effect::Op") giving each effect op's DECLARED parameter count. The handle
  // arm uses the declared arity (not the pattern arity) to decide whether the
  // thrown payload is a packed tuple to destructure (arity > 1) or a single
  // value — so an extra continuation-slot bind like `Question(q, k)` on a
  // 1-arg op is not mistaken for a 2-tuple. See effect_op_declared_arity.
  effect_op_keys: Array[String];
  effect_op_arities: Array[Int];
  // #cov branch coverage state (linear backend). cov_disabled() when off.
  cov: CovState;
  // Interior-line breakpoints (span-arc step5): wasm function index of the
  // `vibe::dbg_line` host import, or -1 when off (default / non-break /
  // multi-file). When >= 0, the ELet/ELetMut/ESeq handlers emit
  // `i32.const <line>` + `call dbg_line_idx` at each statement boundary so the
  // runner can pause at interior source lines. Default -1: codegen unchanged.
  dbg_line_idx: Int;
  // Interior-line breakpoints: sorted newline char-offsets of THIS function's
  // source file, used to map a statement's char-offset to a 1-based line. Empty
  // when off.
  dbg_line_nl: Array[Int];
  // Interior-line breakpoints (multi-file): the file id of THIS function's source
  // file (index into `vibe.dbgfiles`), emitted alongside the line so the runner
  // matches `--break <file>:<line>` against the right file. 0 when off.
  dbg_line_file_id: Int;
  // #706 (RC): names live-in to the innermost enclosing `while` loop. A loop body
  // re-executes, so passing such an owned heap value to a consuming call frees it
  // on iteration 1 and dangles on the next (use-after-free). compile_call emits a
  // guarded rc_dup for a bare-ident owning arg whose name is in this set, so each
  // iteration's consume is balanced and the loop-carried reference survives. The
  // EWhile codegen sets this to the live-in locals around the body and restores
  // it after (a shared mutable array; bindings declared inside the body are never
  // added). Empty outside any loop; rc_dup is a no-op under bump, so the
  // bump-built compiler is unaffected.
  loop_borrowed_names: Array[String];
  // #706 leak follow-up: append-only per-function log — one entry per loop-
  // borrowed identifier name each time compile_call emits the protective
  // rc_dup (see loop_borrowed_names above). That dup+the callee's own internal
  // drop cancel out across the loop, so the textual occurrence the Perceus plan
  // treated as "one real consume" of the binding actually consumes NOTHING from
  // it — the plan's `remaining` count is therefore one too low per occurrence,
  // and it omits the function-exit drop the binding still needs. The function
  // epilogue (linked_compile.vibe) counts each function param's occurrences in
  // this log and emits that many EXTRA rc_drop calls, exactly compensating
  // without touching the plan's borrow/consume decisions anywhere else (so it
  // cannot perturb a path the plan and codegen already agree on).
  loop_consumed_names: Array[String];
  // ADR-0092 Phase 1 (drop-guided reuse, narrow fusion): parallel stacks
  // scoped by an ELet whose planned scope-end drop can be moved to last use.
  // compile_expr_tail pushes (name, flag_local) before compiling a let body
  // that is exactly `match <name> { ... }` and truncates after; compile_match,
  // on a PCtor arm whose payload arity equals its tail constructor's field
  // count (same block size by layout), consumes the unique scrutinee block in
  // place and sets the flag local to 1. The ELet guards its scope-end drop on
  // the flag (0 = not reused on the taken path, drop exactly as before).
  // Same push/truncate discipline as loop_borrowed_names above.
  reuse_scrutinee_names: Array[String];
  reuse_flag_locals: Array[Int];
  // #707: names of user-defined `let`s whose body provably tail-reaches only
  // `Array::get`/`Map::get`/`__index` (transitively, through if/match/wrapper
  // calls to other names already in this list) — computed once per compile via
  // `compute_borrow_returning_names` over the merged program. compile_call's
  // `cc_is_borrow_ret_call` treats a call to one of these exactly like a direct
  // `Array::get`/`Map::get`/`__index` call: its result is a borrowed view of a
  // heap element (no refcount bump), so passing it into an OWNING position
  // (ctor field / consuming call arg) needs the same guarded rc_dup or the
  // element is double-freed when its container is later dropped (e.g. a
  // `peek(tokens, pos)` wrapper around `Array::get`). Empty outside RC.
  borrow_ret_names: Array[String];
  // ADR-0092 borrow-inference slice 1: whole-program set of user fns whose
  // ABI has at least one borrowed parameter (compute_borrow_param_user_fns),
  // sorted. The call-emission borrow check (compile_call.vibe) and the plan
  // builder both consult it; the callee-side epilogue drops for those params
  // are filtered at the linked_compile plan site. Empty outside the linked
  // RC path.
  borrow_param_user: Array[String];
  // Aligned to borrow_param_user: bit i of entry k says parameter i of
  // borrow_param_user[k] is borrowed. Always carried together with the names
  // -- one bsearch on the names indexes straight into this, and a caller that
  // re-sorted the names alone would silently misattribute every mask.
  borrow_param_mask: Array[Int];
  // User fns that may RETURN an unowned interior view
  // (compute_may_return_view_fns, intersected in linked_compile). The plan
  // builder marks view-call let-bindings from it (PCtx.view_ret_user).
  // Empty outside the linked RC path.
  borrow_view_ret: Array[String];
  // #710: names of top-level functions whose DECLARED return type (from
  // their `let f: (...) -> R = ...` signature) is provably scalar (Int/Bool/
  // Unit) — computed once via `compute_scalar_returning_names` over the
  // merged program. The ELet ECall branch (compile_expr_tail.vibe) consults
  // this to skip `heap_binding_names` for `let n = f(...)` when `f` is one of
  // these: without it, ANY non-borrow-ret call result defaults to heap, so a
  // binding that is really a plain Int (e.g. `build_import_plan(...) -> Int`)
  // gets treated as a tagged pointer. If that binding is later aliased more
  // than once, the Perceus plan schedules a PaAliasDup for it, and
  // `emit_rc_dup_local` untags-and-derefs the "pointer" — for a small int
  // like 0 that reads/writes near address -4, a `memory access out of
  // bounds` trap, not a leak. Empty outside RC.
  scalar_ret_names: Array[String];
  // #875 fix 2: single-slot mutable hint (0 = unset, 1 entry = pending name),
  // set by the ELetRec codegen handler (compile_expr_tail.vibe, `__tag == 10`)
  // immediately before compiling a `let rec NAME = (...) -> { ... }` closure's
  // OWN value, and consumed (read + cleared) as the very first action of
  // compile_lambda -- the sole, immediate callee that dispatch to an EFn value
  // reaches (compile_expr -> compile_expr_tail chain -> compile_expr_tail3
  // `__tag == 24`), so the window between set and consume contains no
  // throwable code and no other codegen call. Lets compile_lambda force NAME
  // into its own capture list (collect_free_vars_indexed_self) even when NAME
  // collides by bare string equality with an unrelated entry already in
  // capture_name_index (see collect_free_vars_indexed_self's doc comment in
  // common_analysis/common_analysis.vibe) -- without this, a colliding let-rec closure's
  // self-reference is wrongly treated as "resolves globally" and never
  // captured, so it has no way to call itself (#875). Any OTHER EFn value
  // (anonymous lambda, non-rec `let`) leaves this empty, so capture
  // computation is byte-identical to before. Reset to empty in every
  // freshly-derived per-lambda CompileCtx (see compile_lambda.vibe's
  // `lam_ctx`) so a nested let-rec inside a closure body starts with no
  // stale hint from its enclosing scope.
  pending_letrec_self_name: Array[String];
  // #1107 Phase 4: append-only recorder of every funcref-table slot codegen
  // actually materializes as a closure value — the `(table_slot<<2)|2`
  // constant in compile_expr's named-function-as-value branch and the
  // single `table_slot` computation in compile_lambda (which feeds both the
  // captureless i64-const form and the closure-header i32.store forms).
  // The linear backend's element section is then built from exactly this
  // set (run-compressed active segments, emit_element_section_active_runs)
  // instead of registering every user function + lambda: a slot no closure
  // value ever carries can never reach call_indirect, so it stays ref.null.
  // Slot NUMBERING and the declared table size are unchanged. Shared BY
  // REFERENCE into per-lambda derived ctxs (like the other append-only logs
  // above) so nested-lambda recordings land in the module-level array.
  table_slots_used: Array[Int];
  // #1259 step 7 groundwork: the lambda index this function's NEXT lambda
  // must receive, preassigned before any body is emitted.
  //
  // compile_lambda takes a lambda's function index from the live length of
  // the shared LambdaTable, and emits it into the body as a table_slot
  // immediate -- so a function's output bytes depend on how many lambdas
  // every function compiled before it produced. That is what stops a worker
  // from ever compiling a body on its own, and it is the thing a frozen
  // WholeProgramPlan has to remove (docs/compiler-parallelism.md).
  //
  // A one-element mutable cell, shared BY REFERENCE into per-lambda derived
  // ctxs exactly like table_slots_used above, so a nested lambda advances the
  // same counter its enclosing function does. Seeded per user function from
  // the counting pass (plan_lambda_bases) and checked against the live length
  // at every allocation: while the two agree, the plan is a faithful
  // prediction of what the sequential walk does, which is what makes flipping
  // compile_lambda over to it a no-op on the emitted bytes.
  //
  // Empty disables the check entirely (the gc lane and any ctx built outside
  // the planned body loop).
  lambda_plan_next: Array[Int];
  // #644: static (wasm code offset -> source file/line) recorder for the
  // `vibe.linemap` custom section. Shared by reference across every
  // TOP-LEVEL function's CompileCtx (like `cov` above); `linemap.cur_fn`
  // holds the user-function index (`bi`) currently being compiled, set by
  // linked_compile.vibe's main function loop before each body. Every
  // emit_dbg_line_stmt call (compile_expr_tail.vibe) appends the body-buffer-
  // relative byte offset of its probe alongside `linemap.cur_fn`'s current
  // value, the file id and the line. Disabled (linemap_disabled()) outside
  // debug-break builds, and ALSO forced disabled on every lambda-derived
  // ctx (compile_lambda.vibe) -- a lambda compiles into its OWN separate
  // wasm function body buffer, so an offset recorded against `cur_fn`'s
  // enclosing top-level index would point at the wrong function entirely.
  // That is a known, documented gap (like the funcmap's entry-file-only
  // scope): lambda-body statements are simply absent from the linemap.
  linemap: LineMapState
}

/// Interior-line breakpoints (span-arc step5, multi-file): per-file provenance the
/// break codegen needs to emit `vibe::dbg_line(<file_id>, <line>)` and a
/// `vibe.dbgfiles` section. `files[k]` is the basename of source file id k;
/// `file_nls[k]` its newline char-offsets; `stmt_file_id[s]` the file id of merged
/// top-level statement s. Empty (via empty_dbg_prov) on non-break builds.
export struct DbgProv {
  files: Array[String];
  file_nls: Array[Array[Int]];
  stmt_file_id: Array[Int]
}

export fn empty_dbg_prov() -> DbgProv {
  DbgProv::{
    files: array_empty(),
    file_nls: array_empty(),
    stmt_file_id: array_empty()
  }
}

/// #644: static line-map recorder threaded via CompileCtx.linemap. Mirrors
/// CovState's cur_fn/append-only-log shape: `cur_fn` is a 1-element mutable
/// cell holding the top-level user-function index (`bi`) currently being
/// compiled (set once per function by linked_compile.vibe's main loop,
/// BEFORE that function's body_buf is compiled); `funcs`/`offsets`/
/// `file_ids`/`lines` are parallel append-only logs, one entry per
/// emit_dbg_line_stmt probe, recording (that probe's owning `bi`, the
/// probe's body_buf-relative byte offset, the file id, the 1-based line).
/// `offsets` are relative to the START of the function's own instruction
/// buffer (body_buf) -- NOT yet shifted by that function's locals-
/// declaration header length, since body_buf is compiled before the
/// final per-function locals header is known. linked_compile.vibe adds
/// each function's header length (computed while assembling the code
/// section) before emitting the final `vibe.linemap` custom section, so
/// the section's offsets land exactly where wasmtime's own
/// `FrameInfo::func_offset()` measures from (the first byte of the code
/// entry, i.e. including the locals declaration -- verified empirically
/// against wasmtime 45's WasmBacktrace).
export struct LineMapState {
  enabled: Bool;
  cur_fn: Array[Int];
  funcs: Array[Int];
  offsets: Array[Int];
  file_ids: Array[Int];
  lines: Array[Int]
}

/// A disabled LineMapState (non-debug-break builds, and every lambda-derived
/// CompileCtx): `record` is a no-op, so codegen output is byte-identical.
export fn linemap_disabled() -> LineMapState {
  LineMapState::{
    enabled: false,
    cur_fn: [
      0
    ],
    funcs: array_empty(),
    offsets: array_empty(),
    file_ids: array_empty(),
    lines: array_empty()
  }
}

export struct CompileCtxGc {
  func_table: FuncTable;
  str_table: StrTable;
  lambda_table: LambdaTable;
  num_user_funcs: Int;
  func_offset: Int;
  ref_cell_names: Array[String];
  ref_local_indices: Array[Int];
  refcell_type_idx: Int;
  closure_type_base: Int;
  // Named gc_ctor_table, NOT ctor_table: codegen resolves record fields by
  // name-first-match across ALL struct declarations (compile_expr_tail4 EDot),
  // so a field name shared with CompileCtx at a DIFFERENT position reads the
  // wrong slot. CompileCtx.ctor_table sits at index 6; this one is index 9 --
  // sharing the name made every gc-lane ctor lookup read ref_local_indices
  // (empty) instead of the table. See the field-collision issue for the
  // root-cause fix direction.
  gc_ctor_table: CtorTable;
  // #538: module-level literal constants (`let op_call = 16` etc.). Kind 0 =
  // Int/Bool (value in gc_const_ivals), kind 1 = String (value in
  // gc_const_svals, rendered via the string table). All fields gc_-prefixed
  // for the same collision reason as gc_ctor_table (CompileCtx carries
  // const_int_names/const_int_values at different slots).
  gc_const_names: Array[String];
  gc_const_kinds: Array[Int];
  gc_const_ivals: Array[Int];
  gc_const_svals: Array[String];
  // #538: module-level COMPUTED values (`let t = Bytes::from_array([..])`):
  // one mutable i64 wasm global each (index 1 + position; global 0 is the
  // heap pointer), initialized at the top of _start in statement order.
  gc_global_names: Array[String];
  // #538 P4.5: locals KNOWN to hold f64 raw bits (shape-tracked at let-bind:
  // float literal / Int::to_double / float arithmetic). Fresh per function
  // (like ref_cell_names). Arithmetic on a floatish operand emits real f64
  // ops — the unconditional i64 ops silently zeroed float-literal parsing
  // (lexer parse_frac_digits) when the gc-compiled compiler ran. Best-effort:
  // annotated Double params and tuple-destructured floats are NOT tracked.
  //
  // #1032: tracked by local SLOT INDEX (not name -- this used to be
  // Array[String], name-keyed and unpruned, which let a name reused with a
  // different type across sibling branches keep its stale classification;
  // see gc_bool_locals below, which had and fixed the identical bug for
  // #1015). Entries are pruned at every branch/match-arm/for-in scope-exit
  // boundary via gc_slot_log_reset_above(ctx.gc_float_locals, floor), the
  // same discipline gc_bool_locals and gc_agg_local_slots already follow at
  // those same boundaries (see backend_expr.vibe's EIf/for-in/handle and
  // backend_match.vibe's match-arm truncation sites). Without this, `if c {
  // let x = 1.5; .. } else { let x = 1; f(x) }` would misclassify the else
  // branch's `x` (a DIFFERENT binding that happens to reuse the same
  // now-freed slot) as floatish too.
  gc_float_locals: Array[Int];
  // #1015: gc twin of the linear lane's int_local_slots kind-3 (boolish)
  // tracking -- locals (params/lets) KNOWN to hold a Bool. Bool and Int
  // share the same gc-lane numeric representation (no distinguishing
  // runtime type tag between them, mirroring the linear backend), so the
  // generic runtime `__to_string` dispatch cannot tell them apart; this
  // set lets `bc_expr_is_boolish`/`gc_expr_is_boolish` recognize a
  // Bool-typed identifier statically instead, the same way `gc_float_locals`
  // lets floatish idents take the f64 path.
  //
  // Tracked by local SLOT INDEX (not name; see gc_float_locals above, which
  // follows the same design): entries are pruned at every
  // branch/match-arm/for-in scope-exit boundary via
  // gc_slot_log_reset_above(ctx.gc_bool_locals, floor), the exact same
  // "slot >= floor is about to be reused by a sibling scope, drop stale
  // entries" discipline agg_log_reset_above already applies to
  // gc_agg_local_slots at those same boundaries (see backend_expr.vibe's
  // EIf/for-in/handle and backend_match.vibe's match-arm truncation sites).
  // Without this, `if c { let b = true; to_string(b) } else { let b = 1;
  // to_string(b) }` would misclassify the else branch's `b` (a DIFFERENT
  // binding that happens to reuse the same now-freed slot) as boolish too.
  gc_bool_locals: Array[Int];
  // Native wasm-gc array references are permitted only for a proven-local
  // literal binding. `gc_native_array_locals` is the current lexical set used
  // by call lowering; it is pruned when slots are reused by sibling scopes.
  // `gc_native_array_local_types` is append-only so body emission can declare
  // every typed local, including one that only existed in a branch.
  gc_native_array_locals: Array[Int];
  gc_native_array_local_types: Array[Int];
  /// The MODULE's native i64-array type index, or -1 if this compile has none.
  /// A property of the module, never of the frame -- see
  /// gc_native_array_frame_ok for the per-frame half.
  gc_native_array_type_idx: Int;
  gc_native_array_block_type_idx: Int;
  // #1702: slot -> ctor-table struct index for locals holding a
  // `(struct (mut i64) x N)` reference. `_scope` is pruned at branch/arm
  // boundaries like the other slot logs; `_decl` is never pruned, because the
  // code section still has to declare every typed slot the body allocated.
  gc_native_struct_scope: Array[Int];
  gc_native_struct_decl: Array[Int];
  // Index of `(struct (mut i64))`; an N-field record uses base + (N - 1).
  // Negative disables the lane (lambda frames, module initializers).
  gc_native_struct_type_base: Int;
  /// Whether THIS frame's own locals may hold a native array reference.
  ///
  /// These two facts used to share the `gc_native_array_type_idx >= 0`
  /// sentinel, which conflated "the module has no array type" with "this
  /// particular body cannot declare typed locals". That conflation leaked:
  /// `_start` sets the frame half false (its slots are shared across every
  /// module initializer, and its typed-local row is never emitted), and a
  /// lambda CREATED INSIDE an initializer then inherited the sentinel and
  /// silently lost native lowering even though a lambda compiles into its own
  /// independent frame with its own emitted row (#1332, Codex review).
  ///
  /// Kept as one predicate read in one place (backend_expr.vibe's ELet/EArray
  /// gate); this only stops it from meaning two different things.
  gc_native_array_frame_ok: Bool;
  // #1332: one typed-local row PER RECORDED LAMBDA, parallel to
  // LambdaTable.bodies. A lambda body compiles into its own local frame, so
  // its typed slots cannot live in the enclosing function's row -- but the
  // code section declares lambda locals from a module-level array, which is
  // why lambda bodies previously had to keep the linear fallback.
  //
  // Shared BY REFERENCE through make_lambda_ctx_gc (same discipline as
  // table_slots_used below): a nested lambda records itself DURING its
  // parent's compile, so both must append to the one module-level array or
  // the rows stop lining up with LambdaTable.bodies. Appended in
  // record_lambda_meta_gc, which is the single writer of that table.
  gc_lambda_native_array_locals: Array[Array[Int]];
  // #1541: conservative, module-wide direct-call reference ABI evidence.
  // Empty tables mean the whole module fell back to the tagged-i64 ABI.
  // When populated, rows are parallel: each named top-level function has one
  // parameter-reference row and one result-reference flag. Only direct calls
  // may consume this evidence; closures, globals, generics, aggregates, and
  // unsupported control-flow crossings make the producer leave all rows empty.
  gc_direct_abi_names: Array[String];
  gc_direct_abi_param_refs: Array[Array[Bool]];
  gc_direct_abi_return_refs: Array[Bool];
  // Per-body result expectation. This is true only while compiling a proven
  // direct-ABI function whose wasm result is `(ref null $native_i64_array)`.
  gc_direct_abi_current_return_ref: Bool;
  // #1015: computed ONCE per compile (backend_body.vibe's
  // gc_to_string_resolves_to_show_wrapper, before any CompileCtxGc is
  // constructed) and copied unchanged into every ctx thereafter (including
  // lambda ctxs, backend_lambda_ctx.vibe). True iff this program's own
  // top-level `to_string` (if any) structurally matches the Show-bounded
  // generic forwarding wrapper `to_string[T: Show](x: T) -> String {
  // __to_string(x) }`. Gates backend_call.vibe's "to_string" call-site fast
  // path -- required so a SAME-file user-defined `fn to_string(x: Bool) ->
  // String { "custom" }` (a real, different function) is not silently
  // replaced by the Bool/Float formatter (code review, #1015): the gc
  // lane's single-file compile model rules out cross-file name collisions
  // (unlike linear, which needs a mangled-name match), but not this
  // same-file case.
  gc_to_string_is_show_wrapper: Bool;
  // #724: gc twin of CompileCtx.agg_local_slots (same encoding + pruning
  // discipline) so the gc lane's structural ==/!= also covers non-literal
  // aggregate bindings. gc_-prefixed per the #722 field-collision convention.
  gc_agg_local_slots: Array[Int];
  // #724 round 2: gc twins of agg_ret_names/agg_ret_infos.
  gc_agg_ret_names: Array[String];
  gc_agg_ret_infos: Array[Int];
  // #1109 gc parity: gc twin of CompileCtx.table_slots_used (see that
  // field's doc comment for the full rationale) -- append-only recorder of
  // every funcref-table slot the gc lane's own closure codegen
  // (backend_expr.vibe's named-fn-as-value branch, backend_lambda_body.vibe's
  // closure construction) actually materializes as a closure value. The gc
  // lane uses the SAME tagged-i64 funcref-table + heap-allocated
  // closure-header scheme as linear (backend_lambda_emit.vibe), so the same
  // "record used slots, rebuild the element section from exactly that set"
  // approach applies unchanged.
  table_slots_used: Array[Int];
  // ADR-0090 (#1262) tier 2: gc twins of CompileCtx's region arena fields.
  // Same meaning and same `-1 == no arena in this module` convention, so the
  // two lanes' `__region_run` / `MutList::empty` / `MutBytes::empty` arms read
  // identically. See the layout note in gc/backend_body.vibe for why this
  // lane wants an arena at all despite being the GC lane.
  gc_region_ptr_addr: Int;
  gc_region_arr_new_func_idx: Int;
  gc_region_bytes_new_func_idx: Int
}

//# Functions

/// #678: prune the integer-slot log so it carries NO entry for any slot index
/// >= `floor`. Called right after `local_names` is truncated to `floor` at a
/// branch / match-arm / for-in boundary, where those high slots are about to be
/// reused by the sibling scope. A `let`/`let mut` reusing a slot re-logs its own
/// int-ness, but a NON-`let` binder (match-arm / catch-all / for-in pattern var)
/// logs nothing — so without this prune its slot would still read the previous
/// sibling's stale `int=1` and a string bound there would wrongly take the
/// `i64.eq` path. Compacts the array IN PLACE (entries are unordered, so a plain
/// truncate-by-count will not do): keep entries for slots < floor, then truncate.
/// No temporary allocation — this runs at every branch / arm boundary while
/// compiling, and a fresh array per call piles up on the bump/RC heap during one
/// big function and can trip a heap-marginal compile.
export fn int_log_reset_above(ctx: CompileCtx, floor: Int) -> Unit {
  let arr = ctx.int_local_slots
  let n = Array::length(arr)
  let mut w = 0
  let mut i = 0
  while i < n {
    let e = Array::get(arr, i)
    // #769: entries are slot*4 + kind now (see slot_is_intish).
    if e / 4 < floor {
      Array::set(arr, w, e)
      w = w + 1
    } else {
      ()
    }
    i = i + 1
  }
  Array::truncate(arr, w)
}

/// #1062 follow-up: the float-log twin of `int_log_reset_above`, for exactly
/// the same reason. `bind_match_pat` now logs a pattern-bound constructor
/// field into `float_local_slots` when its declared type is Double/Float (see
/// CompileCtx.ctor_float_fields), but a NON-float field bound at the SAME
/// local slot by a SIBLING match arm (arms share slot numbers -- `local_names`
/// is truncated back to `names_len_at_match` before every arm, see the call
/// sites in compile_match.vibe) never logs anything to override a stale
/// float=1 entry a PRIOR arm left at that slot. Left unpruned, that stale
/// entry survives via float_local_slots' normal "most recent entry per slot
/// wins" lookup (slot_is_floatish) and makes the later arm's plain Int/String
/// field take the f64 reinterpret-bits arithmetic path -- silently corrupting
/// ordinary integer arithmetic (discovered when re-enabling the ctor-float
/// check caused ~37 unrelated selfhost unit-test regressions: the compiler's
/// own AST enums, e.g. Expr/Pat/Token, mix a Double-carrying variant
/// (EFloat/PFloat/TFloat) with many non-float siblings matched in the same
/// `match`, at the same rotating slot numbers). Same compaction discipline as
/// int_log_reset_above: keep entries for slots < floor, truncate the rest.
export fn float_log_reset_above(ctx: CompileCtx, floor: Int) -> Unit {
  let arr = ctx.float_local_slots
  let n = Array::length(arr)
  let mut w = 0
  let mut i = 0
  while i < n {
    let e = Array::get(arr, i)
    // Entries are slot*2 + flag (see slot_is_floatish).
    if e / 2 < floor {
      Array::set(arr, w, e)
      w = w + 1
    } else {
      ()
    }
    i = i + 1
  }
  Array::truncate(arr, w)
}

/// #724: prune the aggregate-shape log (see CompileCtx.agg_local_slots) at the
/// same branch/arm boundaries as int_log_reset_above — a slot reused by a
/// non-`let` binder must not be read as a stale tuple/ctor, or the structural
/// comparator would walk a non-aggregate value.
export fn agg_log_reset_above(arr: Array[Int], floor: Int) -> Unit {
  let n = Array::length(arr)
  let mut w = 0
  let mut i = 0
  while i < n {
    let e = Array::get(arr, i)
    if e / 256 < floor {
      Array::set(arr, w, e)
      w = w + 1
    } else {
      ()
    }
    i = i + 1
  }
  Array::truncate(arr, w)
}

/// #1015: gc-lane twin of int_log_reset_above, for a PLAIN slot-indexed array
/// (no packed kind -- e.g. CompileCtxGc.gc_bool_locals, which unlike
/// CompileCtx.int_local_slots tracks exactly one thing, so entries are raw
/// slot ints rather than slot*4+kind). Same discipline: called right after
/// `local_names` is truncated to `floor` at a branch/match-arm/for-in
/// boundary, so a stale entry for a slot about to be reused by a sibling
/// scope does not leak into that sibling's classification of an unrelated
/// binding landing on the same freed slot.
/// #1702: slot -> payload map, indexed BY SLOT rather than a list of slots.
///
/// The native ARRAY lane can use a plain slot list because every entry has the
/// same wasm type. A struct local also has to carry WHICH struct it holds (the
/// wasm type follows from the field count, and field access needs the declared
/// order). Keeping that as a second array parallel to a slot list does not
/// survive `gc_slot_log_reset_above`: pruning one and not the other silently
/// pairs a slot with the wrong struct. Indexing by slot removes the pairing --
/// reset is positional and there is nothing to keep in step. Absent slots
/// read as -1.
/// #1542: does struct `struct_idx` declare `field` as a reference-lane array?
/// Lives here rather than beside either use because the binding site, the read
/// lowering and the receiver test all have to agree; a private copy per file is
/// how the #1722 lookups drifted.
export fn gc_ctor_field_is_ref(ct: CtorTable, struct_idx: Int, field: String) -> Bool {
  if struct_idx < 0 || struct_idx >= Array::length(ct.struct_field_is_ref) {
    false
  } else {
    let declared = Array::get(ct.struct_field_names, struct_idx)
    let refs = Array::get(ct.struct_field_is_ref, struct_idx)
    let mut i = 0
    let mut found = false
    while i < Array::length(declared) {
      if Array::get(declared, i) == field && Array::get(refs, i) {
        found = true
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

/// Slot of `field` within struct `struct_idx`, or -1.
export fn gc_ctor_field_slot(ct: CtorTable, struct_idx: Int, field: String) -> Int {
  if struct_idx < 0 || struct_idx >= Array::length(ct.struct_field_names) {
    0 - 1
  } else {
    let declared = Array::get(ct.struct_field_names, struct_idx)
    let mut i = 0
    let mut found = 0 - 1
    while i < Array::length(declared) {
      if found < 0 && Array::get(declared, i) == field {
        found = i
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

export fn gc_slot_map_set(map: Array[Int], slot: Int, value: Int) -> Unit {
  while Array::length(map) <= slot {
    Array::push(map, 0 - 1)
  }
  Array::set(map, slot, value)
}

export fn gc_slot_map_get(map: Array[Int], slot: Int) -> Int {
  if slot < 0 || slot >= Array::length(map) {
    0 - 1
  } else {
    Array::get(map, slot)
  }
}

/// Positional twin of `gc_slot_log_reset_above`: clear every slot at or above
/// `floor` so a sibling scope reusing those numbers for ordinary i64 bindings
/// does not inherit this scope's classification.
export fn gc_slot_map_reset_above(map: Array[Int], floor: Int) -> Unit {
  let mut i = if floor < 0 {
    0
  } else {
    floor
  }
  while i < Array::length(map) {
    Array::set(map, i, 0 - 1)
    i = i + 1
  }
}

export fn gc_slot_log_reset_above(arr: Array[Int], floor: Int) -> Unit {
  let n = Array::length(arr)
  let mut w = 0
  let mut i = 0
  while i < n {
    let e = Array::get(arr, i)
    if e < floor {
      Array::set(arr, w, e)
      w = w + 1
    } else {
      ()
    }
    i = i + 1
  }
  Array::truncate(arr, w)
}

/// #672 (post-#724): dual-array twin of agg_log_reset_above — prunes
/// agg_local_slots AND its parallel agg_local_exprs in lockstep (same
/// keep/drop decision, driven by the slots array, applied to both), so the
/// two arrays stay the same length / index-aligned after a branch/arm
/// boundary prunes stale entries. See CompileCtx.agg_local_exprs.
export fn agg_log_reset_above2(arr: Array[Int], exprs: Array[Expr], floor: Int) -> Unit {
  let n = Array::length(arr)
  let mut w = 0
  let mut i = 0
  while i < n {
    let e = Array::get(arr, i)
    if e / 256 < floor {
      Array::set(arr, w, e)
      Array::set(exprs, w, Array::get(exprs, i))
      w = w + 1
    } else {
      ()
    }
    i = i + 1
  }
  Array::truncate(arr, w)
  Array::truncate(exprs, w)
}

/// #724: most-recent aggregate-shape entry for `slot` — `kind*64 + n`
/// (kind 1 = tuple/arity, 2 = ctor/field count), or -1 when untracked /
/// overridden by a non-aggregate rebind.
export fn agg_slot_lookup(arr: Array[Int], slot: Int) -> Int {
  let mut i = Array::length(arr) - 1
  let mut out = 0 - 1
  while i >= 0 {
    let e = Array::get(arr, i)
    if e / 256 == slot {
      out = e % 256
      i = 0 - 1
    } else {
      i = i - 1
    }
  }
  if out == 0 {
    0 - 1
  } else {
    out
  }
}

/// #672 (post-#724): companion to agg_slot_lookup — the shape-literal Expr
/// paired with the most-recent tracked entry for `slot` (same rightmost-match
/// scan), or EInt(0) when the slot has no entry at all. Callers only read the
/// result after agg_slot_lookup has confirmed a kind 1 (tuple) or kind 2
/// (ctor/record) entry exists for the slot, so the EInt(0) fallback is never
/// actually consulted as a shape in practice — it just keeps this total.
export fn agg_expr_lookup(arr: Array[Int], exprs: Array[Expr], slot: Int) -> Expr {
  let mut i = Array::length(arr) - 1
  let mut out = EInt(0)
  while i >= 0 {
    let e = Array::get(arr, i)
    if e / 256 == slot {
      out = Array::get(exprs, i)
      i = 0 - 1
    } else {
      i = i - 1
    }
  }
  out
}

/// #724 round 2: aggregate-shape classification from a DECLARED TypeExpr —
/// the static dual of the shape log below, used for function RETURN types
/// (`let a = mk_pt(...)` — the value shape is invisible at the ELet, but the
/// callee's signature names it) and annotated params. Same `kind*64 + n`
/// encoding; n = 63 is the "dynamic field count" sentinel: enum-typed values
/// have a variant-dependent argc, so the comparator reads argc@4 from the
/// value at runtime instead of unrolling a static count.
export fn agg_info_of_type_name(ct: CtorTable, tname: String) -> Int {
  let mut si = 0
  let mut out = 0
  while si < Array::length(ct.struct_names) {
    if Array::get(ct.struct_names, si) == tname {
      out = 128 + Array::length(Array::get(ct.struct_field_names, si))
      si = Array::length(ct.struct_names)
    } else {
      si = si + 1
    }
  }
  if out > 0 {
    out
  } else {
    let mut ti = 0
    let mut is_enum = false
    while ti < Array::length(ct.type_names) {
      if Array::get(ct.type_names, ti) == tname {
        is_enum = true
        ti = Array::length(ct.type_names)
      } else {
        ti = ti + 1
      }
    }
    if is_enum {
      128 + 63
    } else {
      0
    }
  }
}

export fn agg_info_of_type_expr(ct: CtorTable, te: TypeExpr) -> Int {
  match te {
    TyTuple(tels) => 64 + Array::length(tels),
    TyName(tname) => agg_info_of_type_name(ct, tname),
    TyApp(tname, _) => agg_info_of_type_name(ct, tname),
    _ => 0
  }
}

/// #724 round 2: program-wide (fn name -> aggregate return shape) table,
/// filled from each top-level `let f: (..) -> R = (..) -> {..}`'s declared
/// return type (the SLet annotation's TyFn ret, falling back to the EFn's
/// own return annotation). The `==` codegen consults it for `let a = f(..)`
/// bindings. Structural, all-lane-safe knowledge — unannotated returns stay
/// untracked (generic-eq fallback), preserving backend parity.
export fn compute_agg_returning(stmts: Array[Stmt], ct: CtorTable, out_names: Array[String], out_infos: Array[Int]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, ann, value) => match value {
        EFn(_, _, _, fn_ret, _, _) => {
          let ret = match ann {
            Some(at) => match at {
              TyFn(_, r, _) => Some(r),
              _ => fn_ret
            },
            None => fn_ret
          }
          match ret {
            Some(rte) => {
              let info = agg_info_of_type_expr(ct, rte)
              if info > 0 {
                Array::push(out_names, name)
                Array::push(out_infos, info)
              } else {
                ()
              }
            },
            None => ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

export fn agg_ret_lookup(names: Array[String], infos: Array[Int], fname: String) -> Int {
  let mut i = 0
  let mut out = 0 - 1
  while i < Array::length(names) {
    if Array::get(names, i) == fname {
      out = Array::get(infos, i)
      i = Array::length(names)
    } else {
      i = i + 1
    }
  }
  out
}

/// #724: non-throwing last-match local lookup (resolve_local throws on a
/// missing name, which is wrong for OPTIONAL classification — a bare ident
/// can name a global function or ctor instead of a local).
export fn find_local_slot(names: Array[String], name: String) -> Int {
  let mut i = Array::length(names) - 1
  let mut result = 0 - 1
  while i >= 0 {
    if Array::get(names, i) == name {
      result = i
      i = 0 - 1
    } else {
      i = i - 1
    }
  }
  result
}

/// #724: aggregate-shape info for a bare-ident operand of `==`/`!=`:
/// resolves the ident's CURRENT slot and returns its latest log entry
/// (`kind*64 + n`), or -1 for non-idents / untracked slots.
export fn agg_info_of_ident(arr: Array[Int], e: Expr, local_names: Array[String]) -> Int {
  match e {
    EIdent(nm, _) => {
      let slot = find_local_slot(local_names, nm)
      if slot >= 0 {
        agg_slot_lookup(arr, slot)
      } else {
        0 - 1
      }
    },
    _ => 0 - 1
  }
}

/// #672 (post-#724): companion to agg_info_of_ident — the tracked shape-
/// literal Expr for a bare-ident operand (same ident -> slot resolution), or
/// EInt(0) when the ident is not a tracked slot. Callers gate on
/// agg_info_of_ident's kind first, same discipline as agg_expr_lookup.
export fn agg_expr_of_ident(arr: Array[Int], exprs: Array[Expr], e: Expr, local_names: Array[String]) -> Expr {
  match e {
    EIdent(nm, _) => {
      let slot = find_local_slot(local_names, nm)
      if slot >= 0 {
        agg_expr_lookup(arr, exprs, slot)
      } else {
        EInt(0)
      }
    },
    _ => EInt(0)
  }
}

export fn is_efn(expr: Expr) -> Bool {
  match expr {
    EFn(_, _, _, _, _, _) => true,
    _ => false
  }
}

export fn is_pint(p: Pat) -> Bool {
  match p {
    PInt(_) => true,
    _ => false
  }
}

export fn is_pfloat(p: Pat) -> Bool {
  match p {
    PFloat(_) => true,
    _ => false
  }
}

export fn is_slet(stmt: Stmt) -> Bool {
  match stmt {
    SLet(_, _, _, _, _) => true,
    _ => false
  }
}

export fn expr_tag(expr: Expr) -> Int {
  match expr {
    EInt(_) => 0,
    EBool(_) => 1,
    EFloat(_) => 2,
    EString(_) => 3,
    EIdent(_, _) => 4,
    EBinOp(_, _, _) => 5,
    EUnaryOp(_, _) => 6,
    EIf(_, _, _) => 7,
    ECall(_, _, _) => 8,
    ELet(_, _, _, _) => 9,
    ELetRec(_, _, _) => 10,
    ELetMut(_, _, _, _) => 11,
    EAssign(_, _, _) => 12,
    EAssignOp(_, _, _, _) => 13,
    ESeq(_, _) => 14,
    ETuple(_) => 15,
    EMatch(_, _) => 16,
    EArray(_) => 17,
    EForIn(_, _, _, _) => 18,
    EWhile(_, _) => 19,
    EBreak(_) => 20,
    EContinue(_) => 21,
    EUnit => 22,
    EFn(_, _, _, _, _, _) => 24,
    ELoop(_, _) => 25,
    EReturn(_) => 26,
    _ => -1
  }
}

export fn is_pbind(p: Pat) -> Bool {
  match p {
    PBind(_) => true,
    _ => false
  }
}

export fn is_pbool(p: Pat) -> Bool {
  match p {
    PBool(_) => true,
    _ => false
  }
}

export fn is_pctor(p: Pat) -> Bool {
  match p {
    PCtor(_, _) => true,
    _ => false
  }
}

export fn is_pwild(p: Pat) -> Bool {
  match p {
    PWild => true,
    _ => false
  }
}

export fn is_earray(expr: Expr) -> Bool {
  match expr {
    EArray(_) => true,
    _ => false
  }
}

export fn is_eident(expr: Expr) -> Bool {
  match expr {
    EIdent(_, _) => true,
    _ => false
  }
}

export fn is_etuple(expr: Expr) -> Bool {
  match expr {
    ETuple(_) => true,
    _ => false
  }
}

export fn is_ptuple(p: Pat) -> Bool {
  match p {
    PTuple(_) => true,
    _ => false
  }
}

let op_i32_eq = 70

let op_i32_ne = 71

export fn is_erecord(expr: Expr) -> Bool {
  match expr {
    ERecord(_, _, _) => true,
    _ => false
  }
}

export fn is_pstring(p: Pat) -> Bool {
  match p {
    PString(_) => true,
    _ => false
  }
}

let op_i32_eqz = 69

let op_i32_mul = 108

let op_i32_sub = 107

export fn emit_i32_eq(buf: Bytes) -> Unit {
  bytebuf_push(buf, op_i32_eq)
}

export fn emit_i32_ne(buf: Bytes) -> Unit {
  bytebuf_push(buf, op_i32_ne)
}

export fn get_arm_pat(arm: (Pat, Expr)) -> Pat {
  let (p, _) = arm
  p
}

export fn lookup_ctor(ctor_names: Array[String], name: String, i: Int) -> Int {
  if i >= Array::length(ctor_names) {
    -1
  }
  else if Array::get(ctor_names, i) == name {
    i
  }
  else lookup_ctor(ctor_names, name, i + 1)
}

/// Build CtorTable.names_sorted / names_sorted_pos from the name list: a
/// stable sort permutation, so equal names keep insertion order and the
/// leftmost binary-search hit maps to the same index the linear scan found.
export fn ctor_sorted_index(names: Array[String]) -> (Array[String], Array[Int]) {
  let perm = sort_perm_by_names(names)
  (apply_perm_strings(names, perm), perm)
}

/// O(log N) replacement for `lookup_ctor(ct.names, name, 0)` at CtorTable
/// call sites. Falls back to the linear scan when the sorted view is absent
/// (defensive: a table built without ctor_sorted_index stays correct).
export fn ctor_table_index_of(ct: CtorTable, name: String) -> Int {
  if Array::length(ct.names_sorted) != Array::length(ct.names) {
    lookup_ctor(ct.names, name, 0)
  } else {
    let slot = bsearch_leftmost(ct.names_sorted, name)
    if slot < 0 {
      -1
    } else {
      Array::get(ct.names_sorted_pos, slot)
    }
  }
}

/// #1062: is constructor `ctor_idx`'s positional field `field_idx` declared
/// Double/Float? See CompileCtx.ctor_float_fields for the encoding.
export fn ctor_field_is_float(ctx: CompileCtx, ctor_idx: Int, field_idx: Int) -> Bool {
  let arr = ctx.ctor_float_fields
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    let e = Array::get(arr, i)
    if e / 64 == ctor_idx && e % 64 == field_idx {
      found = true
      i = Array::length(arr)
    } else {
      i = i + 1
    }
  }
  found
}

/// #722: candidates for a NAME-based struct field access. Returns
/// (ctor_tag, field_idx) for every struct whose field list contains `field`,
/// in struct-declaration order. Field resolution used to take the FIRST
/// struct containing the name (type-blind), so a same-named field living at
/// a DIFFERENT slot in a later struct silently read the wrong slot — which
/// program shapes hit this depended on the declaration set/order, i.e. the
/// flat-bundle vs FS-linked lane divergence observed in #722. Callers keep
/// the first candidate as the static fast path when every candidate agrees
/// on the slot, and otherwise dispatch at runtime on the value's ctor tag
/// (struct construction — both the `S::{...}` ctor path and the set-matched
/// bare-record path — stamps the struct's unique tag at value+0).
export fn struct_field_candidates(ct: CtorTable, field: String) -> Array[(Int, Int)] {
  let out = array_empty()
  let mut si = 0
  while si < Array::length(ct.struct_names) {
    let fnames = Array::get(ct.struct_field_names, si)
    let mut fi = 0
    while fi < Array::length(fnames) {
      if Array::get(fnames, fi) == field {
        let ci = ctor_table_index_of(ct, Array::get(ct.struct_names, si))
        let tag = if ci >= 0 {
          Array::get(ct.tags, ci)
        } else {
          -1
        }
        Array::push(out, (tag, fi))
        fi = Array::length(fnames)
      } else {
        fi = fi + 1
      }
    }
    si = si + 1
  }
  out
}

/// #722: the subset of `candidates` (beyond the first) whose slot index
/// DISAGREES with the first candidate's — exactly the cases the static
/// first-match resolution used to miscompile. Empty result = the static
/// fast path is sound; non-empty = the caller must emit a runtime tag
/// dispatch over these, with candidate 0 as the untagged/legacy fallback.
export fn struct_field_dispatch_cases(cands: Array[(Int, Int)]) -> Array[(Int, Int)] {
  let (_, idx0) = Array::get(cands, 0)
  let out = array_empty()
  let mut i = 1
  while i < Array::length(cands) {
    let (tag_i, idx_i) = Array::get(cands, i)
    if idx_i != idx0 && tag_i >= 0 {
      Array::push(out, (tag_i, idx_i))
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// #722: resolve a bare record literal to a struct by exact field-name-set
/// match (the same rule the checker uses — `S::{...}` drops the name at
/// parse time in some construction paths, and hand-built ASTs build ERecord
/// directly). Returns the struct index or -1. Callers use it to lay the
/// record out in the struct's DECLARED field order and stamp the struct's
/// ctor tag, making bare records byte-compatible with `S::{...}` ctor-path
/// construction (which already reorders to declared order).
export fn struct_index_by_field_set(ct: CtorTable, lit_names: Array[String]) -> Int {
  let mut si = 0
  let mut found = -1
  while si < Array::length(ct.struct_names) {
    let fnames = Array::get(ct.struct_field_names, si)
    if Array::length(fnames) == Array::length(lit_names) {
      let mut all = true
      let mut fi = 0
      while fi < Array::length(fnames) {
        let dn = Array::get(fnames, fi)
        let mut present = false
        let mut li = 0
        while li < Array::length(lit_names) {
          if Array::get(lit_names, li) == dn {
            present = true
            li = Array::length(lit_names)
          } else {
            li = li + 1
          }
        }
        if present {
          fi = fi + 1
        } else {
          all = false
          fi = Array::length(fnames)
        }
      }
      if all {
        found = si
        si = Array::length(ct.struct_names)
      } else {
        si = si + 1
      }
    } else {
      si = si + 1
    }
  }
  found
}

/// #722: ctor tag for struct index `si`, or 0 (the legacy anonymous-record
/// type id) when the struct is not in the ctor table.
export fn struct_tag_by_index(ct: CtorTable, si: Int) -> Int {
  let ci = ctor_table_index_of(ct, Array::get(ct.struct_names, si))
  if ci >= 0 {
    Array::get(ct.tags, ci)
  } else {
    0
  }
}

let op_i32_ge_u = 79

let op_i32_gt_u = 75

let op_i64_load = 41

export fn emit_i32_eqz(buf: Bytes) -> Unit {
  bytebuf_push(buf, op_i32_eqz)
}

export fn emit_i32_mul(buf: Bytes) -> Unit {
  bytebuf_push(buf, op_i32_mul)
}

export fn emit_i32_sub(buf: Bytes) -> Unit {
  bytebuf_push(buf, op_i32_sub)
}

export fn emit_str_ref(buf: Bytes, offset: Int, length: Int) -> Unit {
  emit_i64_const(buf, offset)
  emit_i64_const(buf, 32)
  emit_i64_shl(buf)
  emit_i64_const(buf, length)
  emit_i64_or(buf)
}

export fn get_arm_body(arm: (Pat, Expr)) -> Expr {
  let (_, b) = arm
  b
}

export fn get_efn_body(expr: Expr) -> Expr with Exception {
  match expr {
    EFn(_, _, _, _, _, body) => body,
    _ => throw("not EFn")
  }
}

export fn get_eif_cond(expr: Expr) -> Expr with Exception {
  match expr {
    EIf(c, _, _) => c,
    _ => throw("not EIf")
  }
}

export fn get_eif_else(expr: Expr) -> Expr with Exception {
  match expr {
    EIf(_, _, e) => e,
    _ => throw("not EIf")
  }
}

export fn get_eif_then(expr: Expr) -> Expr with Exception {
  match expr {
    EIf(_, t, _) => t,
    _ => throw("not EIf")
  }
}

export fn get_elet_val(expr: Expr) -> Expr with Exception {
  match expr {
    ELet(_, val, _, _) => val,
    _ => throw("not ELet")
  }
}

export fn is_ctor_call(value: Expr, ct: CtorTable) -> Bool {
  match value {
    ECall(callee, _, _) => match callee {
      EIdent(nm, _) => ctor_table_index_of(ct, nm) >= 0,
      _ => false
    },
    _ => false
  }
}

let op_i64_store = 55

/// #1100: O(log N) replacement for the linear scan over `ft.names` this and
/// several other call sites (compile_call.vibe's cc_ft_has/cc_ft_first_idx/
/// fn_idx_in_list/op_is_builtin, compile_expr.vibe's ident-not-local fallback)
/// used to each do independently -- func_table.names commonly holds several
/// hundred entries (every builtin plus every user/linked function) and these
/// scans run once per identifier/call resolved during codegen, the single
/// largest attributed self-time bucket in a full-closure compile's
/// --cpu-prof (see .claude/skills/compiler-perf-profiling). Mirrors
/// ctor_table_index_of exactly, including its defensive linear-scan fallback
/// for a table built without the sorted view. FIRST-match semantics are
/// preserved exactly: bsearch_leftmost returns the leftmost slot of an equal
/// run in the STABLE sort, which is the same entry a forward linear scan
/// would stop at first (see sorted_index.vibe's stability contract).
export fn func_table_index_of(ft: FuncTable, name: String) -> Int {
  if Array::length(ft.names_sorted) != Array::length(ft.names) {
    let len = Array::length(ft.names)
    let mut i = 0
    let mut found = -1
    while i < len {
      if Array::get(ft.names, i) == name {
        found = i
        i = len
      } else {
        i = i + 1
      }
    }
    found
  } else {
    let slot = bsearch_leftmost(ft.names_sorted, name)
    if slot < 0 {
      -1
    } else {
      Array::get(ft.names_sorted_pos, slot)
    }
  }
}

export fn resolve_func(ft: FuncTable, name: String) -> (Int, Int, Int) with Exception {
  let found = func_table_index_of(ft, name)
  if found < 0 {
    throw(String::concat("undefined function: ", name))
  };
  (Array::get(ft.indices, found), Array::get(ft.params, found), Array::get(ft.returns, found))
}

export fn emit_binop_op(buf: Bytes, op: String) -> Unit with Exception {
  if op == "+" {
    emit_i64_add(buf)
  }
  else if op == "-" {
    emit_i64_sub(buf)
  }
  else if op == "*" {
    emit_i64_mul(buf)
  }
  else if op == "/" {
    emit_i64_div_s(buf)
  }
  else if op == "%" {
    emit_i64_rem_s(buf)
  }
  else if op == "&" {
    emit_i64_and(buf)
  }
  else if op == "|" {
    emit_i64_or(buf)
  }
  else if op == "^" {
    emit_i64_xor(buf)
  }
  else if op == "<<" {
    emit_i64_shl(buf)
  }
  else if op == ">>" {
    emit_i64_shr_s(buf)
  }
  else if op == "==" {
    emit_i64_eq(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "!=" {
    emit_i64_ne(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "<" {
    emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == ">" {
    emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "<=" {
    emit_i64_le_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == ">=" {
    emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "&&" {
    emit_i64_and(buf)
  }
  else if op == "||" {
    emit_i64_or(buf)
  }
  else {
    throw(String::concat("unsupported binop: ", op))
  }
}

export fn emit_i32_ge_u(buf: Bytes) -> Unit {
  bytebuf_push(buf, op_i32_ge_u)
}

export fn emit_i32_gt_u(buf: Bytes) -> Unit {
  bytebuf_push(buf, op_i32_gt_u)
}

export fn emit_i64_load(buf: Bytes, align: Int, offset: Int) -> Unit {
  bytebuf_push(buf, op_i64_load)
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

export fn get_ebinop_op(expr: Expr) -> String with Exception {
  match expr {
    EBinOp(op, _, _) => op,
    _ => throw("not EBinOp")
  }
}

export fn get_elet_body(expr: Expr) -> Expr with Exception {
  match expr {
    ELet(_, _, body, _) => body,
    _ => throw("not ELet")
  }
}

/// #644: the let-statement's source offset (the `let` keyword token), -1 for
/// synthesized lets. Break-mode codegen uses it as the dbg_line fallback when
/// the bound value is a bare literal that carries no offset of its own.
export fn get_elet_off(expr: Expr) -> Int with Exception {
  match expr {
    ELet(_, _, _, soff) => soff,
    _ => throw("not ELet")
  }
}

export fn get_eletmut_off(expr: Expr) -> Int with Exception {
  match expr {
    ELetMut(_, _, _, soff) => soff,
    _ => throw("not ELetMut")
  }
}

export fn get_elet_name(expr: Expr) -> String with Exception {
  match expr {
    ELet(name, _, _, _) => name,
    _ => throw("not ELet")
  }
}

export fn get_func_body(stmt: Stmt) -> Expr with Exception {
  match stmt {
    SLet(_, _, _, _, expr) => match expr {
      EFn(_, _, _, _, _, body) => body,
      _ => throw("get_func_body: not a function")
    },
    _ => throw("get_func_body: not a let statement")
  }
}

export fn get_slet_expr(stmt: Stmt) -> Expr with Exception {
  match stmt {
    SLet(_, _, _, _, expr) => expr,
    _ => throw("not SLet")
  }
}

export fn get_slet_name(stmt: Stmt) -> String with Exception {
  match stmt {
    SLet(_, _, name, _, _) => name,
    _ => throw("not SLet")
  }
}

export fn get_slet_type(stmt: Stmt) -> Option[TypeExpr] {
  match stmt {
    SLet(_, _, _, ty, _) => ty,
    _ => None
  }
}

export fn resolve_local(names: Array[String], name: String, tag: String) -> Int with Exception {
  let mut i = Array::length(names) - 1
  let mut result = -1
  while i >= 0 {
    if Array::get(names, i) == name {
      result = i
      i = -1
    } else {
      i = i - 1
    }
  }
  if result < 0 {
    // A name reaching codegen unresolved is a CHECKER hole, not a user error:
    // the checker either bound it or should have rejected it, and everything
    // between accepted it. Every #1502 / #1510 / #1491 / #1521 / #1529 landed
    // here, and the message said nothing a reader could act on -- no file, no
    // line, and `locals=[__env,,__fn_val]` is pass state. Say whose bug it is.
    throw(String::concat(String::concat(codegen_unresolved_name_prefix(), name), String::concat("` (local, @", String::concat(tag, codegen_unresolved_name_suffix()))))
  }
  result
}

/// Shared opening of the "a name survived type checking" internal error (see
/// `resolve_local`). One spelling so the three codegen sites that can raise it
/// -- linear locals, linear idents, and the gc backend -- cannot drift apart,
/// and so a gate can pin the whole class by one string.
export fn codegen_unresolved_name_prefix() -> String {
  "internal compiler error: `"
}

export fn codegen_unresolved_name_suffix() -> String {
  ") reached code generation unresolved. The type checker should have bound or rejected this name, so this is a bug in the compiler and not in your program -- please report the source that triggers it."
}

export fn emit_i64_store(buf: Bytes, align: Int, offset: Int) -> Unit {
  bytebuf_push(buf, op_i64_store)
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

export fn emit_box_float(buf: Bytes, ctx: CompileCtx, bits_local: Int, box_local: Int) -> Unit {
  emit_local_set(buf, bits_local)
  emit_i64_const(buf, 16)
  emit_call(buf, ctx.rc_alloc_func_idx)
  emit_local_set(buf, box_local)
  emit_local_get(buf, box_local)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 16)
  emit_i32_store(buf, 2, 0)
  emit_local_get(buf, box_local)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 1)
  emit_i32_store(buf, 2, 4)
  emit_local_get(buf, box_local)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf, bits_local)
  emit_i64_store(buf, 3, 8)
  emit_local_get(buf, box_local)
  emit_i64_const(buf, 8)
  emit_i64_add(buf)
  emit_i64_const(buf, 1)
  emit_i64_or(buf)
}

export fn find_func_stmt(stmts: Array[Stmt], name: String) -> Stmt with Exception {
  let len = Array::length(stmts)
  let mut i = 0
  let mut found = -1
  while i < len {
    let stmt = Array::get(stmts, i)
    match stmt {
      SLet(_, _, sname, _, _) => if sname == name {
        found = i
        i = len
      },
      _ => ()
    }
    if found < 0 {
      i = i + 1
    }
  }
  if found < 0 {
    throw(String::concat("function not found: ", name))
  }
  Array::get(stmts, found)
}

export fn emit_unbox_float(buf: Bytes) -> Unit {
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i64_load(buf, 3, 0)
}

/// Push the i64 increment that advances an array INDEX counter by ONE LOGICAL
/// element. Under RC a scalar Int is tagged `n << 1`, and the inline array loops
/// compare their counter against `Array::length` (which returns a tagged length)
/// and feed it to `Array::get` (which untags the index). So the counter must
/// live in tagged space too — stepping by raw 2 (= logical 1). Without RC the
/// counter is a raw index and steps by 1. Using a raw 1 under RC makes the loop
/// run twice per element (each read/processed twice; #704).
export fn emit_index_one(buf: Bytes, ctx: CompileCtx) -> Unit {
  if ctx.enable_rc {
    emit_i64_const(buf, 2)
  } else {
    emit_i64_const(buf, 1)
  }
}

/// Guarded rc_dup of the heap value in `local_idx` (no-op for scalars/strings):
/// if it is odd (a heap pointer) with a zero high word (not a string fat
/// pointer), increment its rc_count at block-4. The single canonical copy — the
/// codegen files (compile_expr_tail / _tail4 / _tail6 / compile_match /
/// compile_lambda / compile_call / linked_compile) call this instead of keeping
/// per-file duplicates.
/// #715 recurrence guard: base address of the shadow-liveness byte table
/// (1 byte per heap address at base+vptr) and the reservation pad that keeps
/// it inside linear memory. Only referenced when compiling with rc_shadow.
/// ADR-0090 (#1262) region arena control words, all derived from the bump
/// pointer address so the layout lives in exactly one place:
/// `[bump ptr @+0][depth @+4][saved bump ptrs @+8, region_max_depth levels]`.
export fn region_depth_addr_of(region_ptr_addr: Int) -> Int {
  region_ptr_addr + 4
}

export fn region_saves_base_of(region_ptr_addr: Int) -> Int {
  region_ptr_addr + 8
}

/// Nesting levels the save table holds. A region entered deeper than this
/// skips both the save and the release: it keeps allocating from the arena
/// (correct, just unreclaimed) instead of scribbling past the table.
export fn region_max_depth() -> Int {
  64
}

/// ADR-0090 (#1262) arena bracket, SHARED by both backends. These lived as
/// private fns in expr/compile_call.vibe while only the linear lane had an
/// arena; the gc lane now brackets its own `__region_run` with the same two,
/// so a change to the save/restore protocol cannot reach one lane only.
/// Push the arena's saved-bump-pointer stack (ADR-0090, #1262). Emitted
/// around the region body call, using only linear-memory control words so it
/// needs no wasm local at the call site -- a synthesized local here would have
/// to be declared in the enclosing function's local vector, which this
/// rewrite has no way to reach.
///
/// Deeper than `region_max_depth()` the save is skipped, and the matching
/// restore is skipped by the same test, so an over-deep region keeps
/// allocating from the arena without reclaiming it. That is the same
/// degradation as arena exhaustion: less reclamation, never a wrong answer.
export fn emit_region_enter(buf: Bytes, region_ptr_addr: Int) -> Unit {
  let depth_addr = region_depth_addr_of(region_ptr_addr)
  let saves_base = region_saves_base_of(region_ptr_addr)
  emit_i32_const(buf, region_max_depth())
  emit_i32_const(buf, depth_addr)
  emit_i32_load(buf, 2, 0)
  emit_i32_gt_u(buf)
  emit_if_void(buf)
  emit_i32_const(buf, saves_base)
  emit_i32_const(buf, depth_addr)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 4)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_i32_const(buf, region_ptr_addr)
  emit_i32_load(buf, 2, 0)
  emit_i32_store(buf, 2, 0)
  emit_end(buf)
  emit_i32_const(buf, depth_addr)
  emit_i32_const(buf, depth_addr)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 1)
  emit_i32_add(buf)
  emit_i32_store(buf, 2, 0)
}

/// The bulk release: reset the arena bump pointer to the watermark this
/// region entered at. Emitted with the body's RESULT already on the stack --
/// every instruction below consumes only its own operands, so the result
/// rides through untouched. Sound because the sanctioned exits copied out of
/// the segment before we get here (see `mutlist_exit_copy`), and because
/// ordinary heap values built in the body live on the MAIN bump heap, which
/// this does not touch.
export fn emit_region_exit(buf: Bytes, region_ptr_addr: Int) -> Unit {
  let depth_addr = region_depth_addr_of(region_ptr_addr)
  let saves_base = region_saves_base_of(region_ptr_addr)
  emit_i32_const(buf, depth_addr)
  emit_i32_const(buf, depth_addr)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 1)
  emit_i32_sub(buf)
  emit_i32_store(buf, 2, 0)
  emit_i32_const(buf, region_max_depth())
  emit_i32_const(buf, depth_addr)
  emit_i32_load(buf, 2, 0)
  emit_i32_gt_u(buf)
  emit_if_void(buf)
  emit_i32_const(buf, region_ptr_addr)
  emit_i32_const(buf, saves_base)
  emit_i32_const(buf, depth_addr)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 4)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_store(buf, 2, 0)
  emit_end(buf)
}

export fn rc_shadow_base() -> Int {
  268435456
}

export fn rc_shadow_reserve() -> Int {
  536870912
}

/// #720: the rc field is the LOW 24 BITS of the rc word (the class id lives in
/// the high byte of the same word at vptr-1). A raw `store(load(addr)+1)` at
/// rc == 0xFFFFFF carries into the class byte and wraps rc to 0 -- a couple of
/// rc ops later the block frees itself with millions of references still
/// outstanding. Hot shared structures (func/ctor tables, analysis accumulator
/// arrays) cross 2^24 refs only on large compiles (the entry-dup budgets leak
/// by design), which made the corruption look layout- and size-dependent.
/// Saturate instead: once rc hits 0xFFFFFF the block is immortal (never
/// incremented, never decremented, never freed -- see gen_rc_drop_body's
/// matching skip). `push_addr` emits the i32 address of the rc word; it is
/// invoked up to three times, so it must be a pure push.
export fn emit_rc_word_inc_saturating(buf: Bytes, push_addr: () -> Unit) -> Unit {
  push_addr()
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 16777215)
  // i32.and (0x71) -- no emit_i32_and helper exists
  bytebuf_push(buf, 113)
  emit_i32_const(buf, 16777215)
  emit_i32_ne(buf)
  emit_if_void(buf)
  push_addr()
  push_addr()
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 1)
  emit_i32_add(buf)
  emit_i32_store(buf, 2, 0)
  emit_end(buf)
}

/// ADR-0092 (#1262): the dup guard, OUT-OF-LINE -- `local.get v; call
/// __rt_rc_dup`, ~5 B instead of the 72 B the inline form costs at every
/// site. `dup_fn_idx < 0` falls back to the inline form, which is what the
/// runtime helper itself is built from (gen_rc_dup_body) and what any
/// emitter without a function table in reach still uses.
///
/// Why this is the size lever and borrow inference is not (all measured on
/// the RC-built stage2, 2026-08-03): the RC binary carries **52,479** inline
/// dup guards, each **exactly 72 B** (min == max over a 2000-site sample --
/// the shape is fully deterministic). That is 3.78 MB of the 4.37 MB by
/// which the RC stage2 exceeds the bump one, i.e. **86% of the entire RC
/// size overhead is this one emitter**. Widening borrow inference removes
/// guards, but even its unsound ceiling was only -5.8%; out-lining touches
/// every guard that legitimately has to exist.
///
/// This is the MIRROR of the reverted #1274 experiment, which INLINED the
/// drop fast path: that grew per-site code ~5 B -> ~70 B, failed the
/// output-size ratchet, and bought no wall time. The direction that lost
/// there is the direction that wins here.
export fn emit_rc_dup_guarded(buf: Bytes, local_idx: Int, rc_shadow: Bool, dup_fn_idx: Int) -> Unit {
  // Both arms use `buf` EXACTLY ONCE. That symmetry is load-bearing, not
  // style: pc_emit merges an EIf's two arms by taking the MINIMUM use count
  // (#705), so an arm that touches `buf` twice while the other touches it
  // once gets a budget of one and releases two -- the over-release that
  // corrupts the free list and surfaces later as an out-of-bounds access
  // (#715). Writing the call form inline here cost exactly that: the
  // all-RC bootstrap trapped in stage1 while every bump-built compiler
  // emitting the same bytes was fine, because only an RC-built binary
  // actually refcounts. Keep the two-instruction form in its own function.
  if dup_fn_idx >= 0 {
    emit_rc_dup_tagtest_call(buf, local_idx, dup_fn_idx)
  } else {
    emit_rc_dup_inline(buf, local_idx, rc_shadow)
  }
}

/// `local.get v; call __rt_rc_dup` -- factored out so emit_rc_dup_guarded's
/// arms stay use-count symmetric (see the note there).
fn emit_rc_dup_call(buf: Bytes, local_idx: Int, dup_fn_idx: Int) -> Unit {
  emit_local_get(buf, local_idx)
  emit_call(buf, dup_fn_idx)
}

/// #1262: the immediate test INLINE, the rest of the guard out-of-line.
///
/// `emit_rc_dup_inline`'s FIRST test is `v & 1` -- odd = candidate heap
/// pointer, even = tagged immediate (`Int` is `value << 1`, so every Int is
/// even). For an immediate the whole helper is a no-op, yet the pure
/// out-of-line form pays a full `call` to discover that. Measured cost of
/// that discovery: **~2.7 ns per dup**, which made a trivial
/// `fn add2(a: Int, b: Int) -> Int` in a hot loop run **6.4x** slower under
/// RC than under bump (1052 -> 6750 ns / 1000 iterations) -- while the SAME
/// call with constant (non-loop-borrowed, hence un-dup'd) arguments cost
/// 1390 ns under BOTH modes. See docs/side-effect-consolidation.md 2.8.
///
/// So: branch on the tag here, call only on the heap path.
///
///     local.get v; i64.const 1; i64.and; i32.wrap_i64
///     if (void)  local.get v; call __rt_rc_dup  end
///
/// ~13 B per site against ~5 B for the bare call and 72 B for the full
/// inline guard -- the third point between the two the size analysis above
/// compares. The helper re-tests the tag on entry (it is built from
/// `emit_rc_dup_inline`), so this is a pure fast-path skip: the emitted
/// semantics are unchanged, including the VIBE_RC=shadow recurrence guard,
/// which stays inside the helper.
fn emit_rc_dup_tagtest_call(buf: Bytes, local_idx: Int, dup_fn_idx: Int) -> Unit {
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, 1)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_if_void(buf)
  emit_local_get(buf, local_idx)
  emit_call(buf, dup_fn_idx)
  emit_end(buf)
}

/// The guard expanded in place. Kept as the single definition of what a dup
/// MEANS: gen_rc_dup_body builds the out-of-line helper by calling this with
/// local 0, so the two forms cannot drift apart.
export fn emit_rc_dup_inline(buf: Bytes, local_idx: Int, rc_shadow: Bool) -> Unit {
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, 1)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_if_void(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, 32)
  emit_i64_shr_s(buf)
  emit_i64_eqz(buf)
  emit_if_void(buf)
  // #715 recurrence guard (VIBE_RC=shadow): trap via `unreachable` if the
  // shadow byte at RC_SHADOW_BASE+vptr says this block was already freed --
  // a dup-of-freed would otherwise increment the free-list NEXT link.
  if rc_shadow {
    emit_local_get(buf, local_idx)
    emit_i64_const(buf, -2)
    emit_i64_and(buf)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, rc_shadow_base())
    emit_i32_add(buf)
    emit_i32_load8_u(buf, 0, 0)
    emit_if_void(buf)
    bytebuf_push(buf, 0)
    emit_end(buf)
  } else {
    ()
  }
  emit_rc_word_inc_saturating(buf, () -> {
    emit_local_get(buf, local_idx)
    emit_i64_const(buf, -2)
    emit_i64_and(buf)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 4)
    emit_i32_sub(buf)
  })
  emit_end(buf)
  emit_end(buf)
}

export fn fn_type_param_types(ty: Option[TypeExpr]) -> Option[Array[TypeExpr]] {
  match ty {
    Some(t) =>
    match t {
      TyFn(args, _, _) => Some(args),
      _ => None
    },
    None => None
  }
}

export fn is_nullary_ctor_ident(value: Expr, ct: CtorTable) -> Bool {
  match value {
    EIdent(nm, _) => ctor_table_index_of(ct, nm) >= 0,
    _ => false
  }
}

export fn name_has_effect_prefix(full: String, eff: String) -> Bool {
  let el = String::length(eff)
  let fl = String::length(full)
  if fl < el + 2 {
    false
  } else {
    let mut ok = true
    let mut j = 0
    while j < el {
      if String::char_code_at(full, j) != String::char_code_at(eff, j) {
        ok = false
        j = el
      } else {
        j = j + 1
      }
    }
    ok && String::char_code_at(full, el) == 58 && String::char_code_at(full, el + 1) == 58
  }
}

export fn effect_name_to_tag(effect_names: Array[String], full: String) -> Int {
  let n = Array::length(effect_names)
  let mut result = 3 + n
  let mut i = 0
  while i < n {
    if name_has_effect_prefix(full, Array::get(effect_names, i)) {
      result = 3 + i
      i = n
    } else {
      i = i + 1
    }
  }
  result
}

export fn effect_op_declared_arity(keys: Array[String], arities: Array[Int], full: String) -> Int {
  let n = Array::length(keys)
  let mut result = -1
  let mut i = 0
  while i < n {
    if Array::get(keys, i) == full {
      result = Array::get(arities, i)
      i = n
    } else {
      i = i + 1
    }
  }
  result
}

/// #665: index of a qualified op key (`Eff::Op`) in the global effect_op_keys
/// table — the operation discriminant for multi-operation handler dispatch.
export fn effect_op_index(keys: Array[String], full: String) -> Int {
  let n = Array::length(keys)
  let mut result = 0 - 1
  let mut i = 0
  while i < n {
    if Array::get(keys, i) == full {
      result = i
      i = n
    } else {
      i = i + 1
    }
  }
  result
}

export fn emit_heap_grow_after_heap_set(buf: Bytes, ctx: CompileCtx) -> Unit {
  if ctx.heap_grow_check_func_idx >= 0 {
    emit_call(buf, ctx.heap_grow_check_func_idx)
  } else {
    ()
  }
}
