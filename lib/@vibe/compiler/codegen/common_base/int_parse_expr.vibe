//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

//# Functions

/// #767: Int::parse(s) -> Option[Int], synthesized as ordinary AST (same
/// technique as double_to_string_expr) and lowered via each backend's `ce`.
/// Building this as composed calls to already-working builtins (String::length
/// / String::char_code_at / Some / None) means no new raw-wasm enum/Option
/// construction is needed — the normal expr compiler already knows how to
/// build Option values. Accepts an optional leading '-'; any other non-digit
/// character, or an empty string (after the sign), yields None.
export fn int_parse_expr(arg: Expr) -> Expr {
  let c1: (String, Expr) -> Expr = (f, a0) -> {
    ECall(EIdent(f, -1), [a0], -1, [])
  }
  let c2: (String, Expr, Expr) -> Expr = (f, a0, a1) -> {
    ECall(EIdent(f, -1), [a0, a1], -1, [])
  }
  let s = EIdent("__ip_s", -1)
  let len = EIdent("__ip_len", -1)
  let start = EIdent("__ip_start", -1)
  let neg = EIdent("__ip_neg", -1)
  let i = EIdent("__ip_i", -1)
  let acc = EIdent("__ip_acc", -1)
  let valid = EIdent("__ip_valid", -1)
  let ch = EIdent("__ip_ch", -1)
  // Overflow guard. The digits accumulate on the NEGATIVE side, where the
  // range is one wider: `acc * 10 - digit` must not fall below
  // Int::min_value, i.e. `acc >= (min + digit) / 10` (division truncates
  // toward zero, which rounds a negative quotient up -- the bound needed).
  // Accumulating positively refused "-4611686018427387904", so
  // `Int::parse(Int::to_string(Int::min_value))` answered None. A positive
  // string whose magnitude is min_value's is refused at the end.
  let min_int = EInt(0 - 4611686018427387903 - 1)
  let digit_step = EIf(EBinOp("<", acc, EBinOp("/", EBinOp("+", min_int, EBinOp("-", ch, EInt(48), -1), -1), EInt(10), -1), -1), EAssign("__ip_valid", EBool(false), EUnit, -1), EAssign("__ip_acc", EBinOp("-", EBinOp("*", acc, EInt(10), -1), EBinOp("-", ch, EInt(48), -1), -1), EUnit, -1))
  let loop_body = ELet("__ip_ch", c2("String::char_code_at", s, i), ESeq(EIf(EBinOp("||", EBinOp("<", ch, EInt(48), -1), EBinOp(">", ch, EInt(57), -1), -1), EAssign("__ip_valid", EBool(false), EUnit, -1), digit_step), EAssign("__ip_i", EBinOp("+", i, EInt(1), -1), EUnit, -1)), -1)
  // review-lint: allow-fixed-synthetic-name
  let while_loop = EWhile(EBinOp("<", i, len, -1), loop_body)
  let result_val = EIf(neg, acc, EBinOp("-", EInt(0), acc, -1))
  // `>` rather than `!=`: an untyped `==` / `!=` in synthesized AST can take
  // the generic `eq`, whose string fallback confuses words with a zero low half.
  let in_range = EBinOp("||", neg, EBinOp(">", acc, EInt(0 - 4611686018427387903 - 1), -1), -1)
  let final_check = EIf(EBinOp("&&", EBinOp("&&", valid, EBinOp("<", start, len, -1), -1), in_range, -1), c1("Some", result_val), EIdent("None", -1))
  ELet("__ip_s", arg, ELet("__ip_len", c1("String::length", s), EIf(EBinOp("==", len, EInt(0), -1), EIdent("None", -1), ELet("__ip_neg", EBinOp("==", c2("String::char_code_at", s, EInt(0)), EInt(45), -1), ELet("__ip_start", EIf(neg, EInt(1), EInt(0)), ELetMut("__ip_i", start, ELetMut("__ip_acc", EInt(0), ELetMut("__ip_valid", EBool(true), ESeq(while_loop, final_check), -1), -1), -1), -1), -1)), -1), -1)
  // review-lint: allow-fixed-synthetic-name
}
