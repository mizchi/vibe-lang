//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

//# Functions

/// #767: Int::parse(s) -> Option[Int], synthesized as ordinary AST (same
/// technique as double_to_string_expr) and lowered via each backend's `ce`.
/// Building this as composed calls to already-working builtins (String::length
/// / String::char_code_at / Some / None) means no new raw-wasm enum/Option
/// construction is needed — the normal expr compiler already knows how to
/// build Option values. Accepts an optional leading '-'; any other non-digit
/// character, or an empty string (after the sign), yields None.
export fn int_parse_expr(arg: Expr) -> Expr {
  let c1: (String, Expr) -> Expr = (f, a0) -> {
    ECall(EIdent(f, -1), [a0], -1)
  }
  let c2: (String, Expr, Expr) -> Expr = (f, a0, a1) -> {
    ECall(EIdent(f, -1), [a0, a1], -1)
  }
  let s = EIdent("__ip_s", -1)
  let len = EIdent("__ip_len", -1)
  let start = EIdent("__ip_start", -1)
  let neg = EIdent("__ip_neg", -1)
  let i = EIdent("__ip_i", -1)
  let acc = EIdent("__ip_acc", -1)
  let valid = EIdent("__ip_valid", -1)
  let ch = EIdent("__ip_ch", -1)
  // Overflow guard: reject when `acc * 10 + digit` would exceed
  // Int::max_value (2^61 - 1) — pre-check `acc > (max - d) / 10` so the
  // accumulator never wraps. Without this, "4611686018427387904" (max + 1)
  // silently parsed as an out-of-range value. The exact min_value string
  // also yields None (its magnitude is max_value + 1).
  let digit_step = EIf(EBinOp(">", acc, EBinOp("/", EBinOp("-", EInt((2305843009213693951<<1)|1), EBinOp("-", ch, EInt(48))), EInt(10))), EAssign("__ip_valid", EBool(false), EUnit), EAssign("__ip_acc", EBinOp("+", EBinOp("*", acc, EInt(10)), EBinOp("-", ch, EInt(48))), EUnit))
  let loop_body = ELet("__ip_ch", c2("String::char_code_at", s, i), ESeq(EIf(EBinOp("||", EBinOp("<", ch, EInt(48)), EBinOp(">", ch, EInt(57))), EAssign("__ip_valid", EBool(false), EUnit), digit_step), EAssign("__ip_i", EBinOp("+", i, EInt(1)), EUnit)), -1)
  let while_loop = EWhile(EBinOp("<", i, len), loop_body)
  let result_val = EIf(neg, EBinOp("-", EInt(0), acc), acc)
  let final_check = EIf(EBinOp("&&", valid, EBinOp("<", start, len)), c1("Some", result_val), EIdent("None", -1))
  ELet("__ip_s", arg, ELet("__ip_len", c1("String::length", s), EIf(EBinOp("==", len, EInt(0)), EIdent("None", -1), ELet("__ip_neg", EBinOp("==", c2("String::char_code_at", s, EInt(0)), EInt(45)), ELet("__ip_start", EIf(neg, EInt(1), EInt(0)), ELetMut("__ip_i", start, ELetMut("__ip_acc", EInt(0), ELetMut("__ip_valid", EBool(true), ESeq(while_loop, final_check), -1), -1), -1), -1), -1)), -1), -1)
}
