version 0.0.1

// @vibe/compiler/codegen/common_base — the shared codegen substrate: the
// linear-backend CompileCtx / wasm-gc-backend CompileCtxGc compile-context
// structs plus the func/str/lambda/ctor lookup tables they carry, the branch-
// coverage CovState, the interior-line-breakpoint DbgProv, and ~80 low-level
// AST-shape predicates / wasm instruction emit helpers / ctor-table and
// effect-tag lookups shared across every codegen backend and expr-compile
// module (ADR-0070 Phase 3, #897, compiler-internal batch). Compiled into
// the compiler itself via compiler_sources_manifest.tsv (group `codegen`,
// dual-row: this contract + common_base.vibe).
//
// The old index.vibe was not a facade but the whole implementation (the
// package is single-file: no sibling files in this directory), so it moved
// verbatim to common_base.vibe. Unlike normalize/perceus/common_analysis,
// this package DOES export real struct types (FuncTable, StrTable,
// LambdaTable, CtorTable, CovState, CompileCtx, DbgProv, CompileCtxGc) that
// other codegen packages construct/pattern-match/access fields on directly.
// Per contract/contract.vibe's conformance checker, a package-owned struct
// like this is declared as a bodyless (opaque-arity, TRANSPARENT — no
// `opaque` keyword) `type Name` line: the real field list stays the single
// source of truth in common_base.vibe, and check_contract only verifies the
// name + arity match an exported top-level type def there. This is
// DIFFERENT from @vibe/ast's index.vpkg, where the enums are the only
// definition (the impl stub never redefines them) so the FULL body lives in
// the contract; common_base's structs are the opposite shape (impl-owned,
// contract just attests they exist), so only the bodyless form belongs
// here. Expr/Pat/Stmt/TypeExpr (../../core) are plain structural signature
// text, not declared at all (normalize/perceus precedent).
//
// Three external files previously imported this package by literal
// `common_base/index.vibe` path instead of the bare directory form every
// other consumer already used (`import ../common_base { .. }`):
// entry/compiler/file_compile/file_compile.vibe, codegen/index.vibe, and
// codegen/wasi/wasi.vibe. All three were switched to the bare form so every
// consumer now reaches this package only through its index.vpkg.

import ./common_base.vibe {}

// Func/string/lambda-table lookups threaded through CompileCtx/CompileCtxGc.
type FuncTable
type StrTable
type LambdaTable

// Constructor/struct dispatch table threaded through CompileCtx/CompileCtxGc.
type CtorTable

// #cov branch coverage state (linear backend only). cov_disabled() when off.
type CovState

// The linear-backend compile context: func/str/lambda/ctor tables, RC
// (Perceus) bookkeeping, branch-coverage and interior-line-breakpoint state,
// and per-function shape-tracking logs. See common_base.vibe for the full
// field list and their extensive per-field doc comments.
type CompileCtx

// Interior-line breakpoints (span-arc step5, multi-file): per-file
// provenance the break codegen needs to emit `vibe::dbg_line(<file_id>,
// <line>)` and a `vibe.dbgfiles` section. empty_dbg_prov() on non-break
// builds.
type DbgProv

// The wasm-gc-backend twin of CompileCtx (gc_-prefixed fields where a name
// would otherwise collide with CompileCtx's own field at a different slot
// index — see common_base.vibe's field-collision comment on gc_ctor_table).
type CompileCtxGc

fn cov_disabled() -> CovState
fn cov_emit_branch(buf: Bytes, cov: CovState) -> Unit
fn empty_dbg_prov() -> DbgProv
fn int_log_reset_above(ctx: CompileCtx, floor: Int) -> Unit
fn agg_log_reset_above(arr: Array[Int], floor: Int) -> Unit
fn agg_log_reset_above2(arr: Array[Int], exprs: Array[Expr], floor: Int) -> Unit
fn agg_slot_lookup(arr: Array[Int], slot: Int) -> Int
fn agg_expr_lookup(arr: Array[Int], exprs: Array[Expr], slot: Int) -> Expr
fn agg_info_of_type_name(ct: CtorTable, tname: String) -> Int
fn agg_info_of_type_expr(ct: CtorTable, te: TypeExpr) -> Int
fn compute_agg_returning(stmts: Array[Stmt], ct: CtorTable, out_names: Array[String], out_infos: Array[Int]) -> Unit
fn agg_ret_lookup(names: Array[String], infos: Array[Int], fname: String) -> Int
fn find_local_slot(names: Array[String], name: String) -> Int
fn agg_info_of_ident(arr: Array[Int], e: Expr, local_names: Array[String]) -> Int
fn agg_expr_of_ident(arr: Array[Int], exprs: Array[Expr], e: Expr, local_names: Array[String]) -> Expr
fn is_efn(expr: Expr) -> Bool
fn is_pint(p: Pat) -> Bool
fn is_pfloat(p: Pat) -> Bool
fn is_slet(stmt: Stmt) -> Bool
fn expr_tag(expr: Expr) -> Int
fn is_pbind(p: Pat) -> Bool
fn is_pbool(p: Pat) -> Bool
fn is_pctor(p: Pat) -> Bool
fn is_pwild(p: Pat) -> Bool
fn is_earray(expr: Expr) -> Bool
fn is_eident(expr: Expr) -> Bool
fn is_etuple(expr: Expr) -> Bool
fn is_ptuple(p: Pat) -> Bool
fn is_erecord(expr: Expr) -> Bool
fn is_pstring(p: Pat) -> Bool
fn emit_i32_eq(buf: Bytes) -> Unit
fn emit_i32_ne(buf: Bytes) -> Unit
fn get_arm_pat(arm: (Pat, Expr)) -> Pat
fn lookup_ctor(ctor_names: Array[String], name: String, i: Int) -> Int
