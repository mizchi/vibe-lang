//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr
}

import ./double_runtime.vibe {
  double_runtime_parse_name
}

//# Functions

/// #841 (item E1) / #2652: `Double::parse(s) -> Option[Double]` lowers to ONE
/// call into the Double runtime prelude (double_runtime.vibe) --
/// `__vibe_double_parse`, appended to every program that can hold a Double
/// (`append_double_runtime`), on both lanes; each dispatch runs
/// `double_runtime_require` first.
///
/// The parser accepts an optional sign, digits, an optional fraction, an
/// optional `e`/`E` exponent, and `NaN` / `Infinity` / `-Infinity`; anything
/// else, or no digit at all, is `None`. It is correctly rounded (ties to the
/// even significand), so it reads back exactly what `Double::to_string`
/// writes. The inline synthesis this replaced accumulated the digits in a
/// Double and divided by a power of ten -- two roundings, and no exponent
/// form at all, so `1e300` was `None` and a 17-digit mantissa could land one
/// ulp off.
export fn double_parse_expr(arg: Expr) -> Expr {
  ECall(EIdent(double_runtime_parse_name(), -1), [arg], -1)
}
