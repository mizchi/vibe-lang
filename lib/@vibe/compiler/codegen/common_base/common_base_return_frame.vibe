import @vibe/compiler/codegen/common_analysis {
  return_control_expr_uses
}
import @vibe/compiler/core {
  Expr
}
import ./common_base_codegen_body_cache_from_bytes.vibe {
  emit_i64_load, emit_rc_dup_guarded
}
// Targeted lexical return control transport.
import @vibe/compiler/core {
  bytebuf_push, leb128_encode_u32
}
import @vibe/compiler/codegen/wasm_emit {
  emit_block_i64,
  emit_br,
  emit_call,
  emit_else,
  emit_end,
  emit_i32_wrap_i64,
  emit_i64_and,
  emit_i64_const,
  emit_i64_eq,
  emit_i64_eqz,
  emit_i64_store,
  emit_if_i64,
  emit_if_void,
  emit_local_get,
  emit_local_set
}
fn frame_pointer(buf: Bytes, local: Int, rc: Bool) -> Unit {
  emit_local_get(buf = buf, idx = local)
  if rc {
    emit_i64_const(buf = buf, value = -2); emit_i64_and(buf)
  }
  emit_i32_wrap_i64(buf)
}
export fn emit_frame_field(buf: Bytes, local: Int, index: Int, rc: Bool) -> Unit {
  frame_pointer(buf = buf, local = local, rc = rc)
  emit_i64_load(buf = buf, align = 3, offset = (if rc {
    8
  } else {
    0
  }) + index * 8)
}
export fn emit_frame_clear(buf: Bytes, local: Int, rc: Bool) -> Unit {
  frame_pointer(buf = buf, local = local, rc = rc)
  emit_i64_const(buf = buf, value = 0)
  emit_i64_store(buf = buf, align = 3, offset = if rc {
    8
  } else {
    0
  })
}
export fn emit_frame_check_payload(buf: Bytes, payload: Int, frame: Int, rc: Bool) -> Unit {
  emit_frame_field(buf = buf, local = payload, index = 0, rc = rc)
  emit_local_set(buf = buf, idx = frame)
  emit_frame_field(buf = buf, local = frame, index = 0, rc = rc)
  emit_i64_eqz(buf)
  emit_if_void(buf)
  // The caller emits the diagnostic and closes this conditional.
}
export fn emit_frame_scope_prologue(buf: Bytes, control_tag: Int) -> Unit {
  emit_block_i64(buf)
  // catch_all_ref branches with an exnref; retain it on the stack while
  // deactivating this frame, then throw_ref preserves its original tag.
  bytebuf_push(buf = buf, byte = 2); bytebuf_push(buf = buf, byte = 105)
  emit_block_i64(buf)
  bytebuf_push(buf = buf, byte = 31); bytebuf_push(buf = buf, byte = 126)
  leb128_encode_u32(buf = buf, value = 2)
  bytebuf_push(buf = buf, byte = 0); leb128_encode_u32(buf = buf, value = control_tag); leb128_encode_u32(buf = buf, value = 0)
  bytebuf_push(buf = buf, byte = 3); leb128_encode_u32(buf = buf, value = 1)
}
fn frame_drop(buf: Bytes, local: Int, rc: Bool, drop_index: Int) -> Unit {
  if rc && drop_index >= 0 {
    emit_local_get(buf = buf, idx = local); emit_call(buf = buf, func_idx = drop_index)
  }
}
export fn emit_frame_scope_epilogue(buf: Bytes, control_tag: Int, frame: Int, payload: Int, result: Int, rc: Bool, shadow: Bool, dup_index: Int, drop_index: Int, cookie: Int) -> Unit {
  emit_end(buf)
  emit_frame_clear(buf = buf, local = frame, rc = rc)
  frame_drop(buf = buf, local = frame, rc = rc, drop_index = drop_index)
  emit_br(buf = buf, label = 2)
  emit_end(buf)
  emit_local_set(buf = buf, idx = payload)
  emit_frame_clear(buf = buf, local = frame, rc = rc)
  emit_frame_field(buf = buf, local = payload, index = 0, rc = rc)
  emit_local_get(buf = buf, idx = frame)
  emit_i64_eq(buf)
  emit_if_i64(buf)
  emit_frame_field(buf = buf, local = payload, index = 1, rc = rc)
  emit_local_set(buf = buf, idx = result)
  if rc {
    emit_rc_dup_guarded(buf = buf, local_idx = result, rc_shadow = shadow, dup_fn_idx = dup_index)
  }
  frame_drop(buf = buf, local = payload, rc = rc, drop_index = drop_index)
  frame_drop(buf = buf, local = frame, rc = rc, drop_index = drop_index)
  if cookie >= 0 {
    emit_i64_const(buf = buf, value = 0); emit_local_set(buf = buf, idx = cookie)
  }
  emit_local_get(buf = buf, idx = result)
  emit_else(buf)
  frame_drop(buf = buf, local = frame, rc = rc, drop_index = drop_index)
  emit_local_get(buf = buf, idx = payload)
  bytebuf_push(buf = buf, byte = 8); leb128_encode_u32(buf = buf, value = control_tag)
  emit_end(buf)
  emit_br(buf = buf, label = 1)
  emit_end(buf)
  emit_frame_clear(buf = buf, local = frame, rc = rc)
  frame_drop(buf = buf, local = frame, rc = rc, drop_index = drop_index)
  bytebuf_push(buf = buf, byte = 10)
  emit_end(buf)
}

export fn frame_prepare_cookie(body: Expr, locals: Array[String], next: Int, state: Array[Int], enabled: Bool) -> Int {
  while Array::length(state) < 4 {
    Array::push(state, value = -1)
  }
  if enabled && return_control_expr_uses(body) {
    Array::push(locals, value = "")
    Array::set(state, at = 3, value = next)
    next + 1
  } else {
    next
  }
}
export fn frame_cookie(_ state: Array[Int]) -> Int {
  if Array::length(state) >= 4 {
    Array::get(state, at = 3)
  } else {
    -1
  }
}
export fn frame_cookie_set(buf: Bytes, state: Array[Int], value: Int) -> Unit {
  let cookie = frame_cookie(state)
  if cookie >= 0 {
    emit_i64_const(buf = buf, value = value); emit_local_set(buf = buf, idx = cookie)
  }
}
