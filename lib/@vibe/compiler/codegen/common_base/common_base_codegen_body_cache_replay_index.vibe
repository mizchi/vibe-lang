import @vibe/codegen/transport {
  CodegenBodyCache
}
import ./common_base_compilectx.vibe {
  LambdaTable, LineMapState
}
import ./common_base_codegen_body_cache_from_bytes.vibe {
  codegen_body_cache_replay
}

struct CacheOwnerRows { starts: Array[Int]; rows: Array[Int] }

/// One immutable cache's auxiliary rows, grouped by function owner. Construct
/// after filtering and keep the cache unchanged throughout the replay phase.
export struct BodyCacheReplayIndex {
  cache: CodegenBodyCache;
  key_count: Int;
  lambda_rows: CacheOwnerRows;
  slot_rows: CacheOwnerRows;
  blind_rows: CacheOwnerRows;
  line_rows: CacheOwnerRows
}

fn replay_zeroes(_ n: Int) -> Array[Int] {
  let xs: Array[Int] = Array::with_capacity(n)
  let mut i = 0
  while i < n {
    Array::push(xs, value = 0); i = i + 1
  }
  xs
}

// Stable counting partition: each owner's row order remains the original
// scan order, including interleaved, sparse or reversed slice contributions.
fn replay_owner_rows(owners: Array[Int], count: Int) -> CacheOwnerRows {
  let starts = replay_zeroes(count + 1)
  for owner in owners {
    if owner >= 0 && owner < count {
      Array::set(starts, at = owner + 1, value = Array::get(starts, at = owner + 1) + 1)
    } else ()
  }
  let mut i = 1
  while i <= count {
    Array::set(starts, at = i, value = Array::get(starts, at = i) + Array::get(starts, at = i - 1)); i = i + 1
  }
  let positions = Array::slice(starts, start = 0, end = count)
  let rows = replay_zeroes(Array::get(starts, at = count))
  i = 0
  while i < Array::length(owners) {
    let owner = Array::get(owners, at = i)
    if owner >= 0 && owner < count {
      let at = Array::get(positions, at = owner)
      Array::set(rows, at = at, value = i)
      Array::set(positions, at = owner, value = at + 1)
    } else ()
    i = i + 1
  }
  CacheOwnerRows::{ starts: starts, rows: rows }
}

export fn codegen_body_cache_replay_index(cache: CodegenBodyCache, key_count: Int) -> BodyCacheReplayIndex {
  let count = if key_count < 0 {
    0
  } else {
    key_count
  }
  let lambdas = replay_owner_rows(owners = cache.lam_owner, count = count)
  let slots = replay_owner_rows(owners = cache.slot_owner, count = count)
  let blind = replay_owner_rows(owners = cache.blind_fn, count = count)
  let lines = replay_owner_rows(owners = cache.lm_owner, count = count)
  BodyCacheReplayIndex::{
    cache: cache,
    key_count: count,
    lambda_rows: lambdas,
    slot_rows: slots,
    blind_rows: blind,
    line_rows: lines
  }
}

/// Replay only this owner's rows instead of rescanning all auxiliary arrays
/// for every function. Total work is linear in functions plus metadata rows.
/// The legacy scan remains the oracle and fallback for owners outside the index.
export fn codegen_body_cache_replay_indexed(index: BodyCacheReplayIndex, at: Int, bodies: Array[Bytes], meta_i32: Array[Int], meta_i64: Array[Int], meta_v128: Array[Int], lt: LambdaTable, slots: Array[Int], blind_bodies: Array[Int], blind_offsets: Array[Int], blind_kinds: Array[Int], blind_syms: Array[Int], lm: LineMapState, replay_bi: Int) -> Unit {
  let cache = index.cache
  let owner = Array::get(cache.fn_indices, at = at)
  if owner < 0 || owner >= index.key_count {
    codegen_body_cache_replay(cache = cache, at = at, bodies = bodies, meta_i32 = meta_i32, meta_i64 = meta_i64, meta_v128 = meta_v128, lt = lt, slots = slots, blind_bodies = blind_bodies, blind_offsets = blind_offsets, blind_kinds = blind_kinds, blind_syms = blind_syms, lm = lm, replay_bi = replay_bi)
    return ()
  } else ()
  Array::push(bodies, value = Array::get(cache.fn_bodies, at = at))
  Array::push(meta_i32, value = Array::get(cache.fn_meta_i32, at = at))
  Array::push(meta_i64, value = Array::get(cache.fn_meta_i64, at = at))
  Array::push(meta_v128, value = Array::get(cache.fn_meta_v128, at = at))
  let lambdas = index.lambda_rows
  let mut p = Array::get(lambdas.starts, at = owner)
  let lambda_end = Array::get(lambdas.starts, at = owner + 1)
  while p < lambda_end {
    let i = Array::get(lambdas.rows, at = p)
    Array::push(lt.bodies, value = Array::get(cache.lam_bodies, at = i))
    Array::push(lt.param_counts, value = Array::get(cache.lam_param_counts, at = i))
    Array::push(lt.captures, value = Array::get(cache.lam_captures, at = i))
    Array::push(lt.meta_i32, value = Array::get(cache.lam_meta_i32, at = i))
    Array::push(lt.meta_i64, value = Array::get(cache.lam_meta_i64, at = i))
    p = p + 1
  }
  let slot_rows = index.slot_rows
  p = Array::get(slot_rows.starts, at = owner)
  let slot_end = Array::get(slot_rows.starts, at = owner + 1)
  while p < slot_end {
    Array::push(slots, value = Array::get(cache.slot_values, at = Array::get(slot_rows.rows, at = p)))
    p = p + 1
  }
  let blind = index.blind_rows
  p = Array::get(blind.starts, at = owner)
  let blind_end = Array::get(blind.starts, at = owner + 1)
  while p < blind_end {
    let i = Array::get(blind.rows, at = p)
    Array::push(blind_bodies, value = Array::get(cache.blind_body, at = i))
    Array::push(blind_offsets, value = Array::get(cache.blind_offsets, at = i))
    Array::push(blind_kinds, value = Array::get(cache.blind_kinds, at = i))
    Array::push(blind_syms, value = Array::get(cache.blind_syms, at = i))
    p = p + 1
  }
  if lm.enabled {
    let lines = index.line_rows
    p = Array::get(lines.starts, at = owner)
    let line_end = Array::get(lines.starts, at = owner + 1)
    while p < line_end {
      let i = Array::get(lines.rows, at = p)
      Array::push(lm.funcs, value = replay_bi)
      Array::push(lm.offsets, value = Array::get(cache.lm_offsets, at = i))
      Array::push(lm.file_ids, value = Array::get(cache.lm_file_ids, at = i))
      Array::push(lm.lines, value = Array::get(cache.lm_lines, at = i))
      p = p + 1
    }
  } else ()
}
