//# Imports

import @vibe/compiler/core {
  Expr,
  Pat,
  Stmt,
  TypeExpr,
  dce_keep_flags,
  expr_children,
  is_exception_effect_name,
  is_exception_throw_handler_name,
  is_exception_throw_operation
}

import @vibe/core {
  array_empty
}

//# Functions

/// ADR-0076 Phase 2 (evidence-passing effect handlers, #817), first slice.
///
/// `handle { BODY } with Effect { Op(args) => arm_body, ... }` is compiled
/// today via a replay loop (compile_expr_tail6.vibe) that re-executes BODY
/// from the top on every resume -- the mechanism behind the M2 correctness
/// bug (fixtures/effect_handle_replay_corruption.vibe) and the ~16K perform
/// bound. #942 already guarantees, as a hard compile error otherwise, that
/// every `resume(e)` in a handler arm is in TAIL position with nothing after
/// it (single-shot, no post-processing) -- i.e. every arm body already has
/// exactly the shape ADR-0076 calls "tail-resumptive". This pass exploits
/// that: for a `perform Effect::Op(args)` that occurs DIRECTLY inside a
/// handle's own BODY (not behind an intervening function call, and not
/// inside a nested closure or a nested `handle`), the handler is known at
/// the exact point of the perform -- no runtime dispatch, no evidence dict,
/// no unwind is needed at all. The perform is replaced in place by the
/// matching arm's body (with each pattern-bound parameter let-bound to the
/// actual argument expression, and the arm's own tail `resume(e)` rewritten
/// to plain `e`), and if EVERY perform for this handle's operations turns
/// out to be reachable this way, the `EHandle` wrapper itself is dropped
/// entirely -- the compiled program has no handler machinery left for that
/// `handle` at all.
///
/// This does NOT attempt the general case (evidence dicts threaded through
/// intervening function calls, ADR-0076's primary mechanism) -- that is a
/// separate, larger slice. Conservative bail-out: if a handle's BODY
/// contains any `EFn` (nested closure -- a perform inside it might run much
/// later, dynamically, possibly after this handle has already returned) or
/// any nested `EHandle` (handler-shadowing semantics this pass does not
/// attempt to reason about), inlining is skipped entirely for that handle
/// and it is left for the existing replay codegen, matching today's
/// behavior exactly. A handle with some performs reachable and some hidden
/// behind such a boundary is a documented future improvement -- today it is
/// all-or-nothing.
///
/// Phase 2b (this revision): a call is also no longer an automatic bail-out
/// when its callee is one of a small, hand-audited set of builtin static
/// functions (idp_pure_builtin_names) that the checker's own builtin type
/// table (checker/builtins_string1.vibe, builtins_string2.vibe,
/// builtins_misc.vibe) records with effect `None` and with no function-typed
/// parameter -- i.e. calls that provably cannot themselves perform, and
/// cannot invoke any user-supplied closure that might. `String::equals` in a
/// handle body (fixtures/effect_handle_two_layer.vibe's cache-hit check) no
/// longer forces a bail-out just because it is a call. Calls to ordinary
/// user-defined functions (whose declared effect row this pass does not
/// consult) are still unconditionally unsafe.
///
/// Runs once over the whole merged program, called from both codegen
/// backends' convergence points, mirroring rewrite_self_tail_calls
/// (self_tail_call.vibe) and desugar_trait_dicts.
export fn inline_direct_performs(stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exported, is_rec, name, ty, expr) => {
        let new_expr = idp_rewrite(expr, idp_empty_table())
        Array::set(stmts, i, SLet(exported, is_rec, name, ty, new_expr))
      },
      _ => ()
    }
    i = i + 1
  }
}

/// Arm lookup table: parallel arrays (op qualified name, param bind names,
/// prepared body with tail resume(e) already rewritten to e). Empty arrays
/// mean "no handle scope currently active" -- performs never match.
fn idp_empty_table() -> (Array[String], Array[Array[String]], Array[Expr]) {
  (array_empty_str(), array_empty_arr_str(), array_empty_expr())
}

fn array_empty_str() -> Array[String] {
  Array::slice([
    ""
  ], 0, 0)
}

fn array_empty_arr_str() -> Array[Array[String]] {
  Array::slice([
    array_empty_str()
  ], 0, 0)
}

fn array_empty_expr() -> Array[Expr] {
  Array::slice([
    EUnit
  ], 0, 0)
}

fn array_empty_ecfg() -> Array[(String, Array[String], Array[String])] {
  Array::slice([
    ("", array_empty_str(), array_empty_str())
  ], 0, 0)
}

fn array_empty_scope() -> Array[(String, String)] {
  Array::slice([
    ("", "")
  ], 0, 0)
}

fn idp_table_is_empty(table: (Array[String], Array[Array[String]], Array[Expr])) -> Bool {
  let (names, _, _) = table
  Array::length(names) == 0
}

fn idp_table_lookup(table: (Array[String], Array[Array[String]], Array[Expr]), qname: String) -> Int {
  let (names, _, _) = table
  let mut i = 0
  let mut found = -1
  while i < Array::length(names) {
    if Array::get(names, i) == qname {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// --- conservative bail-out guard.
///
/// Inlining is only sound when EVERY perform matching this handle's
/// operations is actually reachable by this pass's own traversal. Two
/// things can hide one: (a) an `EFn`/nested `EHandle` (a perform inside
/// either might run later, dynamically, or is intercepted by a nearer
/// handler -- see the module doc comment), and (b) a call to anything
/// other than `perform` itself. (b) matters even with no lambda in sight:
/// `handle { f() } with Http { Fetch(_) => resume(...) } }` (exactly the
/// shape of every fixtures/effect_higher_order_*.vibe fixture) calls a
/// NAMED function `f` whose OWN body may perform Http::Fetch -- that
/// perform is not in `body`'s AST at all (it lives in f's separate
/// top-level definition), so this pass cannot see, let alone inline, it.
/// Treating "no EFn/EHandle" as sufficient to drop the wrapper would have
/// deleted the handler for that unseen perform entirely -- an unhandled
/// perform at runtime. Conservatively flagging every non-`perform` call as
/// unsafe avoids this, EXCEPT for the fixed pure-builtin allowlist below
/// (idp_is_pure_builtin_call) -- those are checker-verified effect-free and
/// take no closure argument, so they cannot hide a perform. Recognizing
/// calls to user functions whose declared row excludes this effect is a
/// larger follow-up (needs the row/signature info this untyped AST pass
/// does not have), not attempted here.
fn idp_has_unsafe_construct(expr: Expr) -> Bool {
  match expr {
    EFn(_, _, _, _, _, _) => true,
    EHandle(_, _) => true,
    ELet(_, v, b, _) => idp_has_unsafe_construct(v) || idp_has_unsafe_construct(b),
    ELetMut(_, v, b, _) => idp_has_unsafe_construct(v) || idp_has_unsafe_construct(b),
    ELetRec(_, v, b) => idp_has_unsafe_construct(v) || idp_has_unsafe_construct(b),
    ESeq(a, b) => idp_has_unsafe_construct(a) || idp_has_unsafe_construct(b),
    EIf(c, t, e) => idp_has_unsafe_construct(c) || idp_has_unsafe_construct(t) || idp_has_unsafe_construct(e),
    EMatch(s, arms) => idp_has_unsafe_construct(s) || idp_arms_have_unsafe_construct(arms),
    EWhile(c, b) => idp_has_unsafe_construct(c) || idp_has_unsafe_construct(b),
    EForIn(_, _, it, b) => idp_has_unsafe_construct(it) || idp_has_unsafe_construct(b),
    ECall(callee, args, _) => match callee {
      // `perform Effect::Op(args)` parses to `ECall(EIdent("perform"),
      // [ECall(EIdent("Effect::Op"), args)])` (or `[EIdent("Effect::Op")]`
      // for a zero-arg op) -- the operation's own qualified name is NOT a
      // "call to something else" in the unsafe sense, it is the operation
      // being performed; only ITS OWN arguments need checking.
      EIdent(nm, _) => if nm == "perform" && Array::length(args) == 1 {
        idp_perform_operand_has_unsafe_construct(Array::get(args, 0))
      } else if idp_is_pure_builtin_call(nm) {
        idp_exprs_have_unsafe_construct(args)
      } else {
        idp_call_is_unsafe(callee) || idp_exprs_have_unsafe_construct(args)
      },
      _ => idp_call_is_unsafe(callee) || idp_exprs_have_unsafe_construct(args)
    },
    EBinOp(_, l, r) => idp_has_unsafe_construct(l) || idp_has_unsafe_construct(r),
    EUnaryOp(_, e2) => idp_has_unsafe_construct(e2),
    EAssign(_, v, c) => idp_has_unsafe_construct(v) || idp_has_unsafe_construct(c),
    EAssignOp(_, _, v, c) => idp_has_unsafe_construct(v) || idp_has_unsafe_construct(c),
    // Any `.field`/method-style access is conservatively unsafe too (could
    // be a method dispatch with hidden effects by the time this runs).
    EDot(_, _, _, _) => true,
    ELabeledArg(_, _, v) => idp_has_unsafe_construct(v),
    EReturn(e2) => idp_has_unsafe_construct(e2),
    EBreak(opt) => match opt {
      Some(e2) => idp_has_unsafe_construct(e2),
      None => false
    },
    EContinue(args) => idp_exprs_have_unsafe_construct(args),
    ETuple(elems) => idp_exprs_have_unsafe_construct(elems),
    EArray(elems) => idp_exprs_have_unsafe_construct(elems),
    ERecord(_, fields, _) => idp_fields_have_unsafe_construct(fields),
    EMap(fields) => idp_fields_have_unsafe_construct(fields),
    ESpread(e2) => idp_has_unsafe_construct(e2),
    ELoop(pairs, b) => idp_pairs_have_unsafe_construct(pairs) || idp_has_unsafe_construct(b),
    _ => false
  }
}

/// Only a direct call to the `perform` builtin is safe; a call to anything
/// else (a named top-level function, a parameter-bound closure, a computed
/// callee expression) may reach a perform this pass cannot see. (The
/// pure-builtin allowlist is checked separately, before this function is
/// ever reached -- see idp_is_pure_builtin_call's call site.)
fn idp_call_is_unsafe(callee: Expr) -> Bool {
  match callee {
    EIdent(nm, _) => nm != "perform",
    _ => true
  }
}

/// Phase 2b: a fixed, hand-audited set of builtin static-call names, each
/// individually checked (as of this change) against the checker's builtin
/// type table to have effect `None` (pure -- see checker/builtins_string1.
/// vibe, builtins_string2.vibe, builtins_misc.vibe) AND no function-typed
/// parameter (so it cannot invoke a user-supplied closure that might
/// perform). Deliberately NOT a prefix/namespace match: builtins_misc.vibe
/// mixes pure entries (Int::to_string, Char::to_int, ...) with impure ones
/// in the SAME file (`print`, `println`, `throw` -- `throw` in particular
/// is documented there as going through the Error effect, i.e. it IS a
/// perform in disguise), so only exact, individually-verified names belong
/// here. Extending this list requires re-checking the new name's entry in
/// those files, not just adding a plausible-looking string.
fn idp_pure_builtin_names() -> Array[String] {
  [
    "String::concat",
    "String::equals",
    "String::length",
    "String::substring",
    "string_char_at",
    "String::trim",
    "String::split",
    "String::contains",
    "String::index_of",
    "String::to_lower",
    "String::to_upper",
    "String::ends_with",
    "String::starts_with",
    "String::char_code_at",
    "String::last_index_of",
    "String::from_char_code",
    "String::join",
    "Char::to_int",
    "Char::from_int",
    "Int::to_double",
    "Int::to_float",
    "Int::to_string",
    "Double::to_int",
    "Float::to_int",
    "Double::to_string",
    "Float::to_string",
    "Double::abs",
    "Double::floor",
    "Double::ceil",
    "Double::max",
    "Double::min",
    "Int::parse",
    "Double::parse",
    // #817 gc-backend follow-up (2026-07-23): `obj[i]` desugars to
    // `__index(obj, i)` (desugar_trait_dict.vibe); `Array::get`/`Map::get`/
    // `Bytes::get` are the same read operation spelled explicitly, and
    // `Array::length`/`Map::size`/`Bytes::length` are the same class of
    // pure, no-function-param builtin query. All seven are individually
    // checker-verified pure (effect `None`, no function-typed parameter --
    // checker/builtins_misc.vibe's lookup_index,
    // builtins_array.vibe/builtins_map.vibe/builtins_bytes.vibe's own
    // `*::get`/`*::length`/`Map::size` entries) and the `__index`/`*::get`
    // subset is already treated as the same borrow-only-read equivalence
    // class elsewhere in the compiler (perceus.vibe, common_analysis.vibe).
    // Found missing via gc-backend coverage testing:
    // `perform Logger::Log(items[i])` inside a `while i < Array::length
    // (items) { ... }`-bodied needing function was sunk to ineligible
    // purely because `items[i]`'s desugared `__index` call (and
    // `Array::length`'s own call in the loop condition) weren't on this
    // list, not because of anything about the perform itself.
    "__index",
    "Array::get",
    "Map::get",
    "Bytes::get",
    "Array::length",
    "Map::size",
    "Bytes::length",
    // ADR-0076 追記34 V2: string interpolation desugars every `\{...}`
    // segment to a `__to_string(...)` call (preprocess_interp_string_
    // collect.vibe) BEFORE the checker runs, so any needing function
    // formatting with interp was sunk to ineligible purely by that
    // synthesized call name -- surfaced by gate 4b the moment the replay
    // fallback stopped absorbing it. Checker-verified pure: effect None
    // (checker/builtins_misc.vibe lookup_to_string) and it never INVOKES
    // its argument (stringification only), so the function-typed-param
    // exclusion does not apply. `not` (Bool -> Bool, effect None --
    // checker/builtins_misc.vibe lookup_not) was surfaced the same way by
    // quickcheck_effect's `if not(prop()) {..}` needing body.
    "__to_string",
    "not",
    // #1324: the operator helpers desugar_trait_dict emits when an operand's
    // type is not syntactically determinable. `a + b` becomes
    // `__generic_add(a, b)` and `a < b` becomes `__generic_rel_diff(a, b) < 0`
    // whenever `infer_arg_type_name` reports a non-concrete name (#973), and
    // `str_lex_diff` is the String arm of the same relational rewrite. That
    // fires for any value bound from a GENERIC callee's result -- e.g.
    // `let v = TaskHandle::result_wait(h)` (returns `T`) followed by `v + 1`
    // inside a `spawn_suspend` closure literal -- so an ordinary arithmetic
    // tail sank the whole closure to ineligible on the synthesized callee
    // name alone, exactly like `__to_string` above. All three are registered
    // builtins with hand-written wasm bodies and a `None` effect
    // (builtin_registry.vibe: `(Int, Int) -> Int` / `(String, String) -> Int`),
    // so they can neither perform a user effect nor invoke a function-typed
    // argument.
    "__generic_add",
    "__generic_rel_diff",
    "str_lex_diff",
    // #1374: the exception-kind side channel's write. Every `throw(v)` in a
    // suspend-class closure literal now carries a preceding `Array::set
    // (__exn_kind_cell, 0, "<Kind>")` (desugar_trait_dict.vibe), so without
    // this entry the very throws this list already admits as performs would
    // sink their own closure to ineligible on the synthesized WRITE alone --
    // the same failure mode `__generic_add` above hit. What this list gates is
    // "can neither perform a user effect nor invoke a function-typed
    // argument", and a 3-arg store into an `Array[String]` does neither.
    // `Array::get` (the READ, used by handler arms) is already listed above.
    "Array::set",
    // ADR-0089 D1 (#1218/#1312): the HOST sleeps. Not effect-free -- `sleep`
    // carries the nominal Async row -- but what this list actually gates is
    // "an opaque callee that cannot PERFORM a user effect and never invokes
    // a function-typed argument", and both qualify (Int -> Unit host
    // calls). Needed because the scoped sleep retarget deliberately leaves
    // the raw builtin in top-level fn bodies when no entry boundary exists
    // (Codex P1 on #1312): an Async-row fn like `fn delay() with Async
    // { sleep(1) }` must classify as PERFORM-FREE (the stat_token
    // precedent, edp_append_perform_free_row_fns) rather than sinking the
    // whole effect's migration to ineligible on an unknown callee -- and
    // the same call must pass scps_calls_ok when such a fn is driven from
    // a suspend-class handle.
    "sleep",
    "sleep_blocking",
    // ADR-0089 D2 (#1218): the Future cell primitives, same audit criterion
    // as `sleep` above -- none can perform a user effect or invoke a
    // function-typed argument. `Future::pending`/`Future::ready` allocate
    // the two-slot [state, payload] cell and `Future::resolve` is two
    // Array::set stores (compile_call.vibe's inline lowerings). Without
    // these, any handle body (or Async-row entry under the injected
    // boundary) that touches a PENDING future sinks to ineligible on the
    // opaque callee name alone (measured: `sleep(1); let f =
    // Future::pending(); Future::resolve(f, 42); await(f)` under an
    // Async-row entry was rejected with the ADR-0076 ineligibility
    // diagnostic before these entries existed). `await` itself needs no
    // entry: await_poll_pass rewrites every await call into `__aw_poll`
    // (a needing fn) before any effect pass runs.
    "Future::pending",
    "Future::ready",
    "Future::resolve",
    // ADR-0089 step 4 (#1218): the host-future surface + its raw halves,
    // same audit criterion -- opaque host calls (`vibe.host_future_get` /
    // `vibe.host_future_wait` component-adapter imports) that cannot
    // perform a user effect and take/return only Ints. `host_future_get`
    // appears in user code (a boundary-wrapped entry body touching it must
    // stay eligible, the Future::pending precedent above);
    // `vibe_hf_wait_raw` appears in the injected `__entry_settle`;
    // `vibe_hf_get_raw` only after compile_call's lowering (listed for
    // symmetry/safety).
    "host_future_get",
    "vibe_hf_get_raw",
    "vibe_hf_wait_raw",
    // ADR-0089 (c) (#1218): the NAMED sibling of host_future_get. Its raw
    // half is per-name (`vibe_hf_get_raw$<name>`), matched by prefix in
    // idp_is_pure_builtin_call below -- same audit, same shapes (a
    // `() -> Int` opaque host call).
    "host_future_named",
    // ADR-0089 Decision 3 (#1218): the host-stream surface + its shared raw
    // read half, same audit criterion -- opaque component-adapter imports
    // (`vibe.host_stream_get$<name>` / `vibe.host_stream_read`) that cannot
    // perform a user effect and take/return only Ints. `host_stream_named`
    // appears in user code (a boundary-wrapped entry body creating the
    // stream cell must stay eligible, the host_future_named precedent);
    // `vibe_hs_read_raw` appears in the injected `__entry_settle` stream
    // arm. `host_stream_next` needs no entry here: the boundary machinery
    // retargets every call to the injected `__hs_next` (a needing fn)
    // before any effect pass runs, exactly like await -> `__aw_poll`.
    // `vibe_hs_close_raw` (the drop half, injected `__hs_close`) is inert on
    // the same grounds -- dropping a readable end takes an Int and performs
    // nothing.
    "host_stream_named",
    "vibe_hs_close_raw",
    "vibe_hs_read_raw",
    // #1539: opaque stdin provider calls are inert host boundaries. Authority
    // is carried by the checker rows; none can perform a user effect.
    "Stdin::read_via_stream",
    "StdinStream::next",
    "StdinStream::close",
    "vibe_stdin_provider_acquire_raw",
    "vibe_stdin_provider_read_raw",
    "vibe_stdin_provider_close_raw"
  ]
}

/// ADR-0089 (c) (#1218): the per-name raw halves of `host_future_named`.
/// compile_call mints one callee name per import name, so the exact-match
/// list above cannot enumerate them; the prefix is the whole criterion (the
/// suffix is a validated component label, and every such callee is the same
/// `() -> Int` adapter import).
fn idp_is_host_future_named_raw(nm: String) -> Bool {
  String::starts_with(nm, "vibe_hf_get_raw$")
}

/// ADR-0089 Decision 3 (#1218): the per-name raw halves of
/// `host_stream_named` (`vibe_hs_get_raw$<name>`), same prefix criterion --
/// every such callee is the same `() -> Int` adapter import.
fn idp_is_host_stream_named_raw(nm: String) -> Bool {
  String::starts_with(nm, "vibe_hs_get_raw$")
}

fn idp_is_pure_builtin_call(nm: String) -> Bool {
  if idp_is_host_future_named_raw(nm) || idp_is_host_stream_named_raw(nm) {
    true
  } else {
    let names = idp_pure_builtin_names()
    let mut i = 0
    let mut found = false
    while i < Array::length(names) {
      if Array::get(names, i) == nm {
        found = true
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

/// `operand` is `perform`'s single argument -- the operation application
/// itself (`EIdent(qname)` for zero args, `ECall(EIdent(qname), op_args)`
/// otherwise). The qualified operation name is never itself an unsafe call
/// target; only the actual argument expressions need checking.
fn idp_perform_operand_has_unsafe_construct(operand: Expr) -> Bool {
  match operand {
    EIdent(_, _) => false,
    ECall(op_callee, op_args, _) => match op_callee {
      EIdent(_, _) => idp_exprs_have_unsafe_construct(op_args),
      _ => true
    },
    _ => true
  }
}

fn idp_exprs_have_unsafe_construct(exprs: Array[Expr]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(exprs) {
    if idp_has_unsafe_construct(Array::get(exprs, i)) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn idp_fields_have_unsafe_construct(fields: Array[(String, Expr)]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    if idp_has_unsafe_construct(v) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn idp_pairs_have_unsafe_construct(pairs: Array[(String, Expr)]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, i)
    if idp_has_unsafe_construct(v) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn idp_arms_have_unsafe_construct(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (_, ex) = Array::get(arms, i)
    if idp_has_unsafe_construct(ex) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

// --- per-arm preparation: bind names + tail resume(e) -> e.

fn idp_pat_bind_names(pat: Pat) -> Array[String] {
  match pat {
    PCtor(_, subpats) => for p in subpats {
      match p {
        PBind(n) => n,
        _ => "_"
      }
    },
    _ => array_empty_str()
  }
}

fn idp_pat_qname(pat: Pat) -> String {
  match pat {
    PCtor(name, _) => name,
    _ => ""
  }
}

/// Replace every tail-position `resume(e)` with `e`. Mirrors #942's own
/// tail-position traversal (check_arm_resume_tail in checker.vibe) so the
/// two stay in lockstep: #942 already guarantees resume only ever appears
/// at exactly these tail slots, with nothing after it.
fn idp_strip_tail_resume(expr: Expr) -> Expr {
  match expr {
    EIf(c, t, e) => EIf(c, idp_strip_tail_resume(t), idp_strip_tail_resume(e)),
    EMatch(s, arms) => EMatch(s, idp_strip_tail_resume_arms(arms)),
    ELet(n, v, b, off) => ELet(n, v, idp_strip_tail_resume(b), off),
    ELetMut(n, v, b, off) => ELetMut(n, v, idp_strip_tail_resume(b), off),
    ELetRec(n, v, b) => ELetRec(n, v, idp_strip_tail_resume(b)),
    ESeq(a, b) => ESeq(a, idp_strip_tail_resume(b)),
    EAssign(n, v, c) => EAssign(n, v, idp_strip_tail_resume(c)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, v, idp_strip_tail_resume(c)),
    EReturn(e2) => EReturn(idp_strip_tail_resume(e2)),
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if nm == "resume" && Array::length(args) == 1 {
        Array::get(args, 0)
      } else {
        expr
      },
      _ => expr
    },
    _ => expr
  }
}

fn idp_strip_tail_resume_arms(arms: Array[(Pat, Expr)]) -> Array[(Pat, Expr)] {
  for a in arms {
    let (p, ex) = a
    (p, idp_strip_tail_resume(ex))
  }
}

// --- the main rewrite.

fn idp_rewrite(expr: Expr, table: (Array[String], Array[Array[String]], Array[Expr])) -> Expr {
  match expr {
    EHandle(body, arms) => idp_rewrite_handle(body, arms, table),
    EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, idp_rewrite(b, idp_empty_table())),
    ELet(n, v, b, off) => ELet(n, idp_rewrite(v, table), idp_rewrite(b, table), off),
    ELetMut(n, v, b, off) => ELetMut(n, idp_rewrite(v, table), idp_rewrite(b, table), off),
    ELetRec(n, v, b) => ELetRec(n, idp_rewrite(v, table), idp_rewrite(b, table)),
    ESeq(a, b) => ESeq(idp_rewrite(a, table), idp_rewrite(b, table)),
    EIf(c, t, e) => EIf(idp_rewrite(c, table), idp_rewrite(t, table), idp_rewrite(e, table)),
    EMatch(s, arms) => EMatch(idp_rewrite(s, table), idp_rewrite_arms(arms, table)),
    EWhile(c, b) => EWhile(idp_rewrite(c, table), idp_rewrite(b, table)),
    EForIn(n, idx, it, b) => EForIn(n, idx, idp_rewrite(it, table), idp_rewrite(b, table)),
    ECall(callee, args, off) => idp_rewrite_call(callee, args, off, table),
    EBinOp(op, l, r) => EBinOp(op, idp_rewrite(l, table), idp_rewrite(r, table)),
    EUnaryOp(op, e2) => EUnaryOp(op, idp_rewrite(e2, table)),
    EAssign(n, v, c) => EAssign(n, idp_rewrite(v, table), idp_rewrite(c, table)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, idp_rewrite(v, table), idp_rewrite(c, table)),
    EDot(o, f, off1, off2) => EDot(idp_rewrite(o, table), f, off1, off2),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, idp_rewrite(v, table)),
    EReturn(e2) => EReturn(idp_rewrite(e2, table)),
    EBreak(opt) => EBreak(match opt {
      Some(e2) => Some(idp_rewrite(e2, table)),
      None => None
    }),
    EContinue(args) => EContinue(idp_rewrite_exprs(args, table)),
    ETuple(elems) => ETuple(idp_rewrite_exprs(elems, table)),
    EArray(elems) => EArray(idp_rewrite_exprs(elems, table)),
    ERecord(n, fields, tas) => ERecord(n, idp_rewrite_fields(fields, table), tas),
    EMap(fields) => EMap(idp_rewrite_fields(fields, table)),
    ESpread(e2) => ESpread(idp_rewrite(e2, table)),
    ELoop(pairs, b) => ELoop(idp_rewrite_pairs(pairs, table), idp_rewrite(b, table)),
    _ => expr
  }
}

fn idp_rewrite_exprs(exprs: Array[Expr], table: (Array[String], Array[Array[String]], Array[Expr])) -> Array[Expr] {
  for e in exprs {
    idp_rewrite(e, table)
  }
}

fn idp_rewrite_fields(fields: Array[(String, Expr)], table: (Array[String], Array[Array[String]], Array[Expr])) -> Array[(String, Expr)] {
  for f in fields {
    let (n, v) = f
    (n, idp_rewrite(v, table))
  }
}

fn idp_rewrite_pairs(pairs: Array[(String, Expr)], table: (Array[String], Array[Array[String]], Array[Expr])) -> Array[(String, Expr)] {
  for p in pairs {
    let (n, v) = p
    (n, idp_rewrite(v, table))
  }
}

fn idp_rewrite_arms(arms: Array[(Pat, Expr)], table: (Array[String], Array[Array[String]], Array[Expr])) -> Array[(Pat, Expr)] {
  for a in arms {
    let (p, ex) = a
    (p, idp_rewrite(ex, table))
  }
}

/// #1087: `Error` is NON-resumable (#640) -- a `handle .. with Exception` arm
/// never calls resume; its value must become the whole handle's result and
/// the rest of the body must NOT run. The splice below implements exactly
/// the opposite (resumptive) semantics: the arm body replaces the perform
/// in place, so its value becomes the PERFORM's result and the body's
/// continuation keeps running. In tail position the two coincide (which is
/// why the bug stayed hidden); for a non-tail `throw` the arm's value is
/// discarded and the body continues -- a silent wrong-value miscompile.
/// Any handle whose arms discharge an Error operation is therefore never
/// eligible for this pass and stays on the try_table lowering
/// (compile_expr_tail6.vibe), whose catch-and-branch shape aborts the body
/// correctly in every position.
fn idp_arms_discharge_error(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (p, _) = Array::get(arms, i)
    let q = idp_pat_qname(p)
    if is_exception_throw_handler_name(q) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn idp_rewrite_handle(body: Expr, arms: Array[(Pat, Expr)], outer_table: (Array[String], Array[Array[String]], Array[Expr])) -> Expr {
  if idp_has_unsafe_construct(body) || idp_arms_discharge_error(arms) {
    // Conservative bail-out: leave this handle's own performs to the
    // existing replay codegen. Still recurse into body/arms with a FRESH
    // (empty) context -- any OTHER handle nested inside (which triggered
    // this bail-out) gets its own independent chance to inline, and any
    // stray perform for the now-inactive outer effect is simply left alone
    // (matches ordinary lexical scoping: this pass never invents a target
    // that codegen wouldn't otherwise resolve).
    EHandle(idp_rewrite(body, idp_empty_table()), idp_rewrite_arms(arms, idp_empty_table()))
  } else {
    let op_names = for a in arms {
      let (p, _) = a
      idp_pat_qname(p)
    }
    let bind_names = for a in arms {
      let (p, _) = a
      idp_pat_bind_names(p)
    }
    let prepared_bodies = for a in arms {
      let (_, ex) = a
      idp_strip_tail_resume(idp_rewrite(ex, idp_empty_table()))
    }
    let table = (op_names, bind_names, prepared_bodies)
    // No EFn/nested-handle boundary exists anywhere in `body`, so this
    // rewrite is guaranteed to reach and inline every perform matching
    // one of `arms` -- the result has none left, and the EHandle wrapper
    // (and everything it would have compiled to: replay loop, per-effect
    // reserved region, perform counter) can be dropped entirely.
    idp_rewrite(body, table)
  }
}

fn idp_rewrite_call(callee: Expr, args: Array[Expr], off: Int, table: (Array[String], Array[Array[String]], Array[Expr])) -> Expr {
  match callee {
    EIdent(nm, _) => if nm == "perform" && Array::length(args) == 1 && !idp_table_is_empty(table) {
      idp_rewrite_perform(Array::get(args, 0), table)
    } else {
      ECall(idp_rewrite(callee, table), idp_rewrite_exprs(args, table), off)
    },
    _ => ECall(idp_rewrite(callee, table), idp_rewrite_exprs(args, table), off)
  }
}

/// `operand` is the perform's single argument: either `EIdent(qname)` for a
/// zero-arg operation, or `ECall(EIdent(qname), op_args)` for one with
/// arguments (see parser_expr_primary.vibe's parse_perform_primary).
fn idp_rewrite_perform(operand: Expr, table: (Array[String], Array[Array[String]], Array[Expr])) -> Expr {
  match operand {
    EIdent(qname, _) => idp_splice_or_leave(qname, array_empty_expr(), operand, table),
    ECall(op_callee, op_args, _) => match op_callee {
      EIdent(qname, _) => idp_splice_or_leave(qname, idp_rewrite_exprs(op_args, table), operand, table),
      _ => ECall(EIdent("perform", -1), [
        idp_rewrite(operand, table)
      ], -1)
    },
    _ => ECall(EIdent("perform", -1), [
      idp_rewrite(operand, table)
    ], -1)
  }
}

fn idp_splice_or_leave(qname: String, actual_args: Array[Expr], original_operand: Expr, table: (Array[String], Array[Array[String]], Array[Expr])) -> Expr {
  let idx = idp_table_lookup(table, qname)
  if idx < 0 {
    ECall(EIdent("perform", -1), [
      original_operand
    ], -1)
  } else {
    let (_, bind_names_list, prepared_bodies) = table
    let bind_names = Array::get(bind_names_list, idx)
    let prepared_body = Array::get(prepared_bodies, idx)
    idp_bind_args(bind_names, actual_args, prepared_body)
  }
}

/// `let bind_0 = actual_0; let bind_1 = actual_1; ...; prepared_body` --
/// evaluates every argument exactly once, in left-to-right order, before the
/// (already tail-resume-stripped) arm body runs, matching ordinary function
/// call-argument semantics.
fn idp_bind_args(bind_names: Array[String], actual_args: Array[Expr], prepared_body: Expr) -> Expr {
  let n = Array::length(bind_names)
  let mut result = prepared_body
  let mut i = n - 1
  while i >= 0 {
    if i < Array::length(actual_args) {
      result = ELet(Array::get(bind_names, i), Array::get(actual_args, i), result, -1)
    } else {
      ()
    }
    i = i - 1
  }
  result
}

/// ADR-0076 Phase 3 (evidence-passing effect handlers, #817), first slice
/// (docs/effect-evidence-passing.md "追記 2" hypothesis, 2026-07-22).
///
/// Phase 2 (inline_direct_perform.vibe) only covers a `handle`'s BODY when
/// every `perform` for its operations is lexically reachable in that same
/// body -- a call to a named top-level function is an automatic bail-out,
/// because the callee's own perform (if any) lives in a different AST
/// location Phase 2's textual splice cannot see. That gap is a real,
/// currently-reproducible correctness bug, not just a missed optimization:
/// fixtures/effect_handle_call_evidence.vibe shows the SAME M2-style replay
/// corruption (a `let mut` counter incremented before two performs gets
/// double-counted) when the two performs are reached via a helper function
/// call instead of directly in the handle body.
///
/// This pass covers the single narrowest case that closes that gap without
/// needing CPS/yield-bubbling (see the ADR's "追記 2" for why #942's
/// tail-resume-only-in-tail-position guarantee makes every handler arm
/// already tail-resumptive, so plain evidence-dict threading -- an ordinary
/// call/return, the same codegen shape as desugar_trait_dict.vibe's
/// dict-passing -- suffices; no new IR node or runtime continuation type is
/// introduced here):
///
///   - a top-level function `f` whose ENTIRE declared effect row is EXACTLY
///     one user-defined effect name `E` (no row-variable, no other effect
///     alongside it -- kept single-effect-only for this first slice so one
///     function is never threaded for two different effects in the same
///     pass, which would require reasoning about injection order);
///   - every `perform E::Op(...)` anywhere in `f`'s own body (which, by the
///     eligibility check below, cannot itself contain a nested closure,
///     nested `handle`, or any call other than to `perform`/another such
///     function/a pure builtin) is rewritten to call through an implicit
///     "evidence dict" parameter prepended to `f`'s params -- a plain struct
///     value with one field per operation of E, each field a closure built
///     from a `handle`'s arm body (mirrors desugar_trait_dict.vibe's
///     TrDict[T] exactly, just keyed by effect operation instead of trait
///     method);
///   - a `handle { BODY } with E { arms } }` whose only reason for failing
///     Phase 2's stricter check is that BODY calls one or more such
///     functions synthesizes the evidence dict from `arms` (same
///     tail-resume-stripped arm bodies Phase 2 already knows how to
///     prepare) and passes it at each such call, then drops the `EHandle`
///     wrapper exactly as Phase 2 does -- no replay codegen is generated
///     for it either.
///
/// Soundness argument (why this cannot silently miscompile, only
/// under-optimize): a function is only ever added to the "needing" set when
/// its OWN declared row is EXACTLY `E` -- by the existing effect checker's
/// own soundness (checker/checker_effects.vibe's transitive perform-effect
/// check, unrelated to and unchanged by this pass), any `perform E::Op`
/// reachable from `f`'s body without crossing a nested `handle` for `E`
/// REQUIRES `f`'s declared row to already contain `E`; this pass never
/// invents authorization the checker did not already grant. The per-body
/// eligibility scan (edp_has_unsafe_construct) is the exact same
/// conservative bail-out shape as Phase 2's idp_has_unsafe_construct, with
/// the single addition that a call to a name in the already-computed
/// `needing` set is treated as safe (that callee's own body is itself
/// checked the same way before the whole migration for `E` is applied at
/// all). If ANY handle-for-`E` site or ANY needing-function body fails this
/// check, the ENTIRE migration for `E` is abandoned and every occurrence is
/// left completely untouched for the existing replay/Phase-2 codegen --
/// there is no partial or best-effort application. Effects with an empty
/// needing set (nothing to gain) or with any ineligible site are simply
/// left alone, matching today's behavior exactly.
///
/// Not attempted here (left on replay, same as before this pass exists):
/// migrating a row VARIABLE itself (there is no concrete effect there to
/// migrate -- see edp_row_is_exactly's doc comment for why this is also
/// simply correct, not a limitation), and any effect for which even one
/// handle site or needing function fails the eligibility scan.
///
/// A function whose row combines `E` with another concrete effect, OR with
/// an open row-variable tail (`with Ask + e`), IS attempted per-effect,
/// independently (`edp_row_is_exactly`'s row-containment match) -- each
/// effect in the row is eligibility-checked and migrated (or not) on its
/// own terms; see edp_row_is_exactly's doc comment for why this is sound
/// and the history of getting there for the concrete-effect-vs-concrete-
/// effect case. The row-variable-tail case was verified separately
/// (2026-07-23): `with Ask + e` migrates `Ask` too, exactly like any
/// other multi-effect row -- the row-variable token `e` simply never
/// matches any real declared effect name, so it's inert to this pass's own
/// matching logic. If the function body actually exercises whatever `e`
/// turns out to mean at a given call site (invoking a callback parameter
/// typed with that row, for instance), the pre-existing "unrecognized
/// callee is unsafe" rule in edp_has_unsafe_construct already rejects
/// that, independent of anything row-string-related.
///
/// A handle site
/// (or needing function) whose own body is directly ANOTHER effect's
/// `EHandle` is ALSO no longer automatically excluded: edp_has_unsafe_
/// construct recurses into a nested handle for a DIFFERENT effect (its body
/// and arms) rather than rejecting it outright, so a directly-nested
/// `handle A { handle B {...} }` pair -- or the equivalent split across a
/// wrapper function -- can have BOTH effects migrate independently, not
/// just the innermost one; see that function's doc comment for the
/// `resume` recognition this needed and fixtures/effect_handle_multi_
/// effect_nested_handles.vibe for the regression lock. A call to a plain
/// user-defined function the checker has ALREADY proven pure (empty
/// declared row, `edp_pure_fn_names`) is ALSO safe now, not just the
/// hand-audited `edp_pure_builtin_names` allowlist -- see fixtures/
/// effect_handle_call_evidence_pure_helper.vibe. A bare `.field` READ
/// (`EDot`, not a call through it) is ALSO safe now -- see fixtures/
/// effect_handle_call_evidence_struct_field.vibe -- despite this pass
/// having no type information: only the object expression being read
/// from can hide anything unsafe, which the existing traversal already
/// answers soundly regardless of the field's static type. A closure
/// LITERAL's own body (`EFn`) is ALSO safe to look inside now -- see
/// fixtures/effect_handle_call_evidence_closure_literal.vibe -- covering
/// only the closure's DEFINITION: CALLING an arbitrary local closure
/// (`f()` where `f` is a local variable, not a top-level function name)
/// would still need real scope tracking this AST-level pass doesn't have
/// to recognize safely by name alone (risking the kind of shadowing
/// false-safety `pure_fns`/`needing`'s name-matching could ALSO in
/// principle hit -- see edp_pure_fn_names' considerations) -- EXCEPT this
/// turns out to already be a non-issue for the common, CAPTURE-FREE case:
/// #786 ("hoist non-capturing effectful local lambdas to top-level",
/// desugar_trait_dict.vibe) already lambda-lifts such a closure to a
/// fresh top-level binding BEFORE this pass ever runs, so by the time
/// edp_has_unsafe_construct sees the call site, it's already an ordinary
/// call to a genuine top-level function -- ALREADY handled correctly by
/// the existing needing-forwarding logic, no closure-specific code needed
/// here at all. Verified directly (2026-07-23) rather than assumed still
/// broken: see fixtures/effect_handle_call_evidence_local_closure_capture_
/// free.vibe. Only a local closure that ALSO captures an outer local (not
/// just the effect) remains excluded -- and not merely from this pass:
/// investigating this surfaced that the CAPTURING case independently hits
/// a pre-existing, deeper miscompilation bug in the closure+effect
/// combinator itself (invalid wasm at instantiation) that #786's own
/// landed fix explicitly declined to touch and that #786's own body had
/// already flagged as the harder, never-actually-fixed "Layer 2" of that
/// bug -- tracked separately as #1069, since it's a closure-codegen bug
/// independent of evidence_dict_pass, not something a row-migration pass
/// could paper over even in principle (the underlying replay path is
/// what's broken for that shape, migrated or not).
///
/// A row spelled with an `effectset` alias (`with AskAll`) is ALSO
/// recognized now, at whatever granularity the alias expands to -- see
/// edp_row_is_exactly's doc comment for why the row string needed its own
/// local (re-)expansion here rather than trusting it was already expanded
/// by the time codegen sees it.
///
/// (An earlier draft of this comment also listed "a wrapper that merely
/// forwards to a needing function without itself declaring the effect" as
/// a follow-up item -- verified, and removed, 2026-07-23: the checker
/// already rejects that program outright at compile time ("effect row
/// mismatch ... missing { E } (no 'with' clause, requires { E })"), so it
/// can never reach this pass at all. Not every item that sounds plausible
/// on paper turns out to be a real, reachable gap; this one wasn't either,
/// same lesson as the local-closure-invocation item above.)
/// Two phases, deliberately NOT interleaved (see edp_row_is_exactly's doc
/// comment, "追記 8", for the bug this avoids): first decide eligibility
/// for EVERY effect against the still-completely-unmutated `stmts`, then
/// apply every eligible migration in a separate pass afterward.
///
/// Interleaving (decide effect A's eligibility, apply A's rewrite, decide
/// B's eligibility, apply B's rewrite, ...) was tried first and found
/// unsound for a function needing more than one effect: applying A's
/// rewrite introduces `EDot` nodes into that function's body (the
/// dict-field-access call an evidence-passed `perform` compiles to), and
/// `edp_has_unsafe_construct` treats every `EDot` as unconditionally
/// unsafe -- so B's eligibility check, re-scanning that SAME (now A-
/// mutated) body, would always see A's own rewrite as a disqualifying
/// construct and abort, even though nothing about the ORIGINAL program
/// was actually unsafe for B.
///
/// Deciding all eligibility upfront sidesteps this entirely: by the time
/// ANY mutation happens, every effect's needing set, handle sites, and
/// eligibility verdict are already fixed facts about the original tree.
/// Applying migrations afterward is safe against each other's rewrites
/// because edp_apply_migration's actual rewrite step (edp_find_rewrite_
/// handles) always re-walks the CURRENT stmts fresh rather than trusting
/// a stale collected handle-site list, and edp_rewrite_needing_body only
/// pattern-matches specific ECall/EHandle shapes -- it already tolerates
/// (passes through unchanged) an EDot or an extra prepended argument left
/// by an earlier effect's migration, it just doesn't blanket-reject them
/// the way the eligibility check does.
/// `entry_name` (2026-07-23, gc-backend follow-up): a needing function can
/// become genuinely UNREACHABLE mid-pipeline -- e.g. dtpw_inline_trivial_wrappers
/// (desugar_trait_dict.vibe, #1070 narrow slice) rewrites `apply(inner)` into
/// `inner()`, leaving a trivial pass-through wrapper's own top-level `apply`
/// definition uncalled anywhere, yet `apply` still declares the migrated
/// effect in its row (it forwards an arbitrary closure argument's effect,
/// which this pass can never prove safe -- see edp_has_unsafe_construct's
/// "call to a non-statically-known target" rejection) and so used to sink
/// the WHOLE effect's eligibility to false, even though the offending
/// function can never actually run. `entry_name` lets edp_plan_migrations
/// reuse the SAME reachability engine `dce_stmts`/`dce_keep_flags`
/// (core/dce.vibe) already uses in production elsewhere in the compiler to
/// drop provably-dead needing functions from consideration before the
/// safety scan -- see edp_plan_migrations' doc comment for the full
/// analysis of why this is safe even if reachability is ever imprecise.
/// Returns the pass's hard-error list (ADR-0076 追記34: a program holding
/// row-E closure VALUES whose migration cannot complete must fail loudly,
/// never fall back to replay — the caller turns a non-empty list into a
/// compile error, mirroring suspend_cps_pass's contract).
/// #1347 (ADR-0089 Part A, 資料 p87 "higher-order effect"): does some declared
/// effect's operation take a BLOCK — a function-typed parameter whose OWN row
/// carries `ename`? E.g. `effect Tracing { Span(String, () -> Int with Log)
/// -> Int }` handled under an outer `handle .. with Log`: the arm invokes that
/// block, so Log's evidence would have to migrate across the arm boundary,
/// which this implementation cannot do. Returns "T::Op" when the shape is
/// present, "" otherwise.
///
/// Worth singling out because the generic migration error below blames the
/// `Log` handle and tells the reader to restructure ITS body — but no
/// restructuring of that body can help; the gap is in the OPERATION's
/// signature, one level away. Label matching here is a plain base-name
/// compare (no effectset resolution): a miss just falls back to the generic
/// message, which is the pre-#1347 behavior.
fn edp_ho_row_names_contain(row: Option[String], ename: String) -> Bool {
  match row {
    None => false,
    Some(s) => {
      let parts = String::split(s, ",")
      let mut i = 0
      let mut found = false
      while i < Array::length(parts) {
        let label = String::trim(Array::get(parts, i))
        let qi = String::index_of(label, "::")
        let head = if qi > 0 {
          label[0: qi]
        } else {
          label
        }
        let bi = String::index_of(head, "[")
        let base = if bi > 0 {
          head[0: bi]
        } else {
          head
        }
        if base == ename {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    }
  }
}

fn edp_ho_texpr_has_block_row(t: TypeExpr, ename: String) -> Bool {
  match t {
    TyFn(ps, ret, eff) => if edp_ho_row_names_contain(eff, ename) {
      true
    } else {
      edp_ho_texprs_have_block_row(ps, ename) || edp_ho_texpr_has_block_row(ret, ename)
    },
    TyApp(_, args) => edp_ho_texprs_have_block_row(args, ename),
    TyTuple(elems) => edp_ho_texprs_have_block_row(elems, ename),
    _ => false
  }
}

fn edp_ho_texprs_have_block_row(ts: Array[TypeExpr], ename: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(ts) && !found {
    found = edp_ho_texpr_has_block_row(Array::get(ts, i), ename)
    i = i + 1
  }
  found
}

/// The shared #1347 wording. Used from BOTH migration failure paths (the
/// closure-value guard in edp_plan_migrations and the live-replay-handle check
/// in evidence_dict_pass), because which one a given program trips depends on
/// whether the block is written as a row-annotated literal — an accident of
/// spelling, not a different limitation.
fn edp_higher_order_error_msg(ename: String, ho: String) -> String {
  let tail = String::concat(ho, String::concat("` takes a block whose own row carries '", String::concat(ename, "', and invoking that block from a handler arm would require migrating the effect's evidence across the arm boundary. Higher-order effects (an operation parameterised by an EFFECTFUL block) are not supported -- ADR-0089 Part A / #1347. Make the block PURE (a row-free function parameter works, and keeps the arm's start/end pairing), or handle the effect inside the function that builds the block")))
  String::concat("effect '", String::concat(ename, String::concat("' cannot be compiled here: operation `", tail)))
}

fn edp_higher_order_block_owner(effect_defs: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], ename: String) -> String {
  let mut i = 0
  let mut hit = ""
  while i < Array::length(effect_defs) && String::length(hit) == 0 {
    let (tname, ops) = Array::get(effect_defs, i)
    let mut j = 0
    while j < Array::length(ops) && String::length(hit) == 0 {
      let (opname, params, _) = Array::get(ops, j)
      if edp_ho_texprs_have_block_row(params, ename) {
        hit = String::concat(tname, String::concat("::", opname))
      } else {
        ()
      }
      j = j + 1
    }
    i = i + 1
  }
  hit
}

export fn evidence_dict_pass(stmts: Array[Stmt], entry_name: String) -> Array[String] {
  let errs = empty_str_array()
  let effect_defs = edp_collect_effect_defs(stmts)
  // ADR-0076 追記34 V2 step 1: vacuous-handle elimination. An effect with
  // ZERO performs anywhere in the program has provably-dead handler arms
  // at every one of its handle sites (nothing can ever throw its tag;
  // direct builtin CALLS like `Env::get(..)` never reach a user handler),
  // so the whole `handle { body } with E { ... }` node is just `body`.
  // Erasing it here (the checker already consumed the node for row
  // discharge -- that job is done by this point) is what legalizes the
  // host-row label-pun sites (cache_underlying.vibe /
  // module_graph_path.vibe's module-private `effect Env` discharging the
  // HOST Env row of the Env::get builtin, and entry.vibe / dispatch_test's
  // dead-arm Profiler handles) without touching their source rows and
  // without Env's builtin-charged needing set ever entering migration.
  // An effect that IS performed somewhere keeps all its handles and goes
  // through ordinary migration -- including host-effect-label mocks like
  // fs_effect_test's `handle {..} with Fs {..}` over `perform
  // Fs::ReadFile` (see edp_user_perform_effect_of's doc comment).
  // #1119 Codex review (P2): candidates are the DECLARED effects plus every
  // effect label a handle site actually names. The latter matters for
  // checker-BUILTIN effects (`Http`, `Fs`, ... -- charged by builtin calls,
  // never declared via `effect X {..}`): a wrapper discharging one of those
  // around direct host calls is exactly as vacuous as a declared-effect
  // one, but iterating `effect_defs` alone never reached it, so it survived
  // to edp_first_live_replay_handle and got rejected. It cannot go through
  // migration either -- with no SEffectDef there is no operation list to
  // build a dict from -- so erasure is the only lowering it has.
  let vhe_names = empty_str_array()
  let mut vhn = 0
  while vhn < Array::length(effect_defs) {
    let (vh_declared, _) = Array::get(effect_defs, vhn)
    if edp_str_array_contains(vhe_names, vh_declared) {
      ()
    } else {
      Array::push(vhe_names, vh_declared)
    }
    vhn = vhn + 1
  }
  edp_collect_handle_effect_names(stmts, vhe_names)
  let vhe_fn_defs = edp_collect_fn_defs(stmts)
  let vhe_fn_names = edp_all_fn_names(vhe_fn_defs)
  let vhe_inert = edp_pure_fn_names(vhe_fn_defs)
  edp_append_free_host_inert_names(stmts, vhe_inert)
  let mut vhi = 0
  while vhi < Array::length(vhe_names) {
    let vh_name = Array::get(vhe_names, vhi)
    if edp_program_user_performs(stmts, vh_name) {
      // Per-HANDLE vacuity: some sites of this effect may still be
      // provably dead even though the program performs it elsewhere (see
      // edp_body_may_perform). Erasing those is what keeps a client-only
      // handle over a builtin effect label compilable next to unrelated
      // server-side perform wrappers.
      edp_erase_effect_handles(stmts, vh_name, true, edp_collect_performing_fns(stmts, vhe_fn_defs, vh_name, vhe_inert, vhe_fn_names), vhe_inert, vhe_fn_names)
    } else {
      // Nothing performs it ANYWHERE: every site is vacuous by
      // construction, so erase unconditionally -- no reachability
      // question to ask, and asking would wrongly keep sites whose body
      // merely makes an opaque call (entry.vibe's Profiler handle wraps
      // the whole CLI dispatch).
      edp_erase_effect_handles(stmts, vh_name, false, empty_str_array(), vhe_inert, vhe_fn_names)
    }
    vhi = vhi + 1
  }
  let fn_defs = edp_collect_fn_defs(stmts)
  // V2 step 2: α-rename local binders that shadow a needing function's
  // name (fresh `__edpsh_N_<name>`), so edp_drop_shadowed_needing finds
  // nothing to drop and the shadowed-needing class migrates like any
  // other program instead of falling back to the (now removed) replay
  // engine. See edp_alpha_rename_shadowed's doc comment. `user_edpsh` /
  // `edp_renamed` feed the culprit diagnostic below: only names the walk
  // actually generated may be un-mangled back to their original spelling.
  let user_edpsh = empty_str_array()
  let edp_renamed = edp_alpha_rename_shadowed(stmts, effect_defs, fn_defs, user_edpsh)
  let keep = dce_keep_flags(stmts, [
    entry_name
  ])
  let plans = edp_plan_migrations(stmts, effect_defs, fn_defs, keep, errs)
  let mut pi = 0
  while pi < Array::length(plans) {
    let (ename, ops, needing, handle_sites) = Array::get(plans, pi)
    edp_apply_migration(stmts, ename, ops, needing, handle_sites, fn_defs)
    pi = pi + 1
  }
  // V2 step 3: the replay frontier is gone from codegen, so any non-Error
  // handle still present in REACHABLE code after migration has nothing
  // left to compile to -- hard error, never a silent fallback. Handles in
  // provably-dead functions are exempt (they compile to a single
  // `unreachable`, matching how edp_drop_unreachable_needing already
  // tolerates dead un-rewritten performs).
  if Array::length(errs) == 0 {
    let bad = edp_first_live_replay_handle(stmts, keep)
    if String::length(bad) > 0 {
      // #1347: when the cause is a higher-order operation (an effect whose
      // operation takes a block carrying this row), say so -- the generic
      // advice below is unactionable for that shape.
      let ho = edp_higher_order_block_owner(effect_defs, bad)
      if String::length(ho) > 0 {
        Array::push(errs, edp_higher_order_error_msg(bad, ho))
      } else {
        // #1511: the actionable sentence comes FIRST. The previous wording led
        // with `not eligible for evidence-passing migration (ADR-0076)` and
        // `the replay engine was removed (追記34 V2)` -- compiler-internal
        // vocabulary with no counterpart in the source being written, so a
        // reader had to get past two clauses of it to reach the only advice
        // that acts on their program. The ADR reference is kept, at the end,
        // for the reader who does want the design record.
        //
        // #1514 C (repair 08): name WHICH call hides the perform and carry its
        // source offset as the ` [@off=N:M]` marker (resolved to `line:col` by
        // the lanes that know the source basis, ALWAYS stripped before a user
        // sees it). EHandle itself has no offset field, but the offending
        // CALL does -- and the call is the better edit point anyway. inert /
        // fn_names are recomputed here (error path only): the erasure and
        // migration passes above have mutated `stmts` since the vhe_* sets
        // were built.
        let li_fn_defs = edp_collect_fn_defs(stmts)
        let li_fn_names = edp_all_fn_names(li_fn_defs)
        let li_inert = edp_pure_fn_names(li_fn_defs)
        edp_append_free_host_inert_names(stmts, li_inert)
        let (culprit_raw, culprit_off) = edp_live_handle_opaque_info(stmts, keep, bad, li_inert, li_fn_names)
        // Un-mangle ONLY names the rename walk generated: a user-authored
        // `__edpsh_0_helper` (in `user_edpsh`, or the walk never ran) must be
        // reported verbatim -- stripping it would name a `helper` that does
        // not exist in the source (Codex review, PR #1594).
        let culprit = if edp_renamed && !edp_str_array_contains(user_edpsh, culprit_raw) {
          edp_unmangle_shadow_name(culprit_raw)
        } else {
          culprit_raw
        }
        // #1591: when no opaque call exists -- the body really does only
        // call named top-level `fn`s, the very form the enumeration below
        // says is allowed -- check for the one named-callee shape that
        // still breaks static visibility: a callee that discharges this
        // same effect around its own whole body but RE-PERFORMS it from a
        // handler arm (see edp_live_handle_dirty_selfdischarge's doc
        // comment). Name it and say what about it is the problem, instead
        // of emitting an enumeration this program already satisfies.
        let (ds_raw, ds_off) = if String::length(culprit_raw) == 0 {
          edp_live_handle_dirty_selfdischarge(stmts, keep, bad, li_fn_defs)
        } else {
          ("", -1)
        }
        let ds_nm = if edp_renamed && !edp_str_array_contains(user_edpsh, ds_raw) {
          edp_unmangle_shadow_name(ds_raw)
        } else {
          ds_raw
        }
        if String::length(ds_nm) > 0 {
          let mut ds_head = String::concat(String::concat("handle of effect '", bad), "' cannot be compiled here: the handled body's call to '")
          ds_head = String::concat(ds_head, ds_nm)
          ds_head = String::concat(ds_head, "' hides a perform from it. '")
          ds_head = String::concat(ds_head, ds_nm)
          ds_head = String::concat(ds_head, String::concat("' handles ", bad))
          ds_head = String::concat(ds_head, String::concat(" around its own body, but one of its handler arms performs ", bad))
          ds_head = String::concat(ds_head, " again -- that re-perform escapes '")
          ds_head = String::concat(ds_head, ds_nm)
          ds_head = String::concat(ds_head, "' into this handle's body, where it is not statically visible. Move that perform out of the handler arm (compute the value before the `handle`), or wrap the arm's perform in its own `handle`. (ADR-0076 evidence-passing migration; the replay engine that used to accept this shape was removed.)")
          let ds_marked = if ds_off >= 0 {
            String::concat(ds_head, String::concat(" [@off=", String::concat(__to_string(ds_off), String::concat(":", String::concat(__to_string(ds_off + String::length(ds_nm)), "]")))))
          } else {
            ds_head
          }
          Array::push(errs, ds_marked)
        } else {
          let head = String::concat(String::concat("handle of effect '", bad), "' cannot be compiled here. Every perform this handle covers has to be statically visible to it, so the handled body may only: perform directly, call a named top-level `fn`, or call a closure literal that carries an effect row annotation. A call through a local binding or a closure parameter hides the perform and is what this rejects")
          let named = if String::length(culprit) > 0 {
            String::concat(head, String::concat(" (here: the call to '", String::concat(culprit, "')")))
          } else {
            head
          }
          let full = String::concat(named, " -- move the `handle` into the function that performs, or replace the indirect call with a direct one. (ADR-0076 evidence-passing migration; the replay engine that used to accept this shape was removed.)")
          let marked = if culprit_off >= 0 {
            if String::length(culprit) > 0 {
              String::concat(full, String::concat(" [@off=", String::concat(__to_string(culprit_off), String::concat(":", String::concat(__to_string(culprit_off + String::length(culprit)), "]")))))
            } else {
              String::concat(full, String::concat(" [@off=", String::concat(__to_string(culprit_off), "]")))
            }
          } else {
            full
          }
          Array::push(errs, marked)
        }
      }
    } else {
      ()
    }
  } else {
    ()
  }
  errs
}

/// --- ADR-0076 追記34 V2: replay-frontier removal support. ---------------
///
/// The effect name a `perform` targets, or "" when `expr` is not a perform.
/// EVERY perform counts here, including ones whose op is host-mapped
/// (`perform Fs::ReadFile` etc.): a user handle over a host-effect label is
/// the in-tree MOCKING pattern (lib/@vibe/fs's fs_effect_test /
/// index_import_test), and keeping those handles makes edp migrate them
/// like any user effect -- the arm now receives the operation's ARGUMENTS
/// and its resume value wins outright (under replay the real builtin ran
/// first, side effects included, and the arm was thrown its RESULT). Only
/// a perform with NO handle anywhere compiles to the direct builtin call
/// (see compile_call.vibe's op_is_builtin branch).
fn edp_user_perform_effect_of(expr: Expr) -> String {
  match expr {
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if nm == "perform" && Array::length(args) == 1 {
        let q = match Array::get(args, 0) {
          ECall(inner, _, _) => match inner {
            EIdent(qn, _) => qn,
            _ => ""
          },
          EIdent(qn, _) => qn,
          _ => ""
        }
        if String::length(q) > 0 {
          edp_effect_name_of(q)
        } else {
          ""
        }
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

fn edp_performs_user_effect_expr(expr: Expr, ename: String) -> Bool {
  if edp_user_perform_effect_of(expr) == ename {
    true
  } else {
    match expr {
      EFn(_, _, _, _, _, b) => edp_performs_user_effect_expr(b, ename),
      EHandle(b, arms) => {
        let mut found = edp_performs_user_effect_expr(b, ename)
        let mut i = 0
        while i < Array::length(arms) && !found {
          let (_, ex) = Array::get(arms, i)
          found = edp_performs_user_effect_expr(ex, ename)
          i = i + 1
        }
        found
      },
      EIf(c, t, e2) => edp_performs_user_effect_expr(c, ename) || edp_performs_user_effect_expr(t, ename) || edp_performs_user_effect_expr(e2, ename),
      EMatch(s, arms) => {
        let mut found = edp_performs_user_effect_expr(s, ename)
        let mut i = 0
        while i < Array::length(arms) && !found {
          let (_, ex) = Array::get(arms, i)
          found = edp_performs_user_effect_expr(ex, ename)
          i = i + 1
        }
        found
      },
      EWhile(c, b) => edp_performs_user_effect_expr(c, ename) || edp_performs_user_effect_expr(b, ename),
      EForIn(_, _, it, b) => edp_performs_user_effect_expr(it, ename) || edp_performs_user_effect_expr(b, ename),
      ELoop(pairs, b) => {
        let mut found = edp_performs_user_effect_expr(b, ename)
        let mut i = 0
        while i < Array::length(pairs) && !found {
          let (_, v) = Array::get(pairs, i)
          found = edp_performs_user_effect_expr(v, ename)
          i = i + 1
        }
        found
      },
      ELet(_, v, b, _) => edp_performs_user_effect_expr(v, ename) || edp_performs_user_effect_expr(b, ename),
      ELetMut(_, v, b, _) => edp_performs_user_effect_expr(v, ename) || edp_performs_user_effect_expr(b, ename),
      ELetRec(_, v, b) => edp_performs_user_effect_expr(v, ename) || edp_performs_user_effect_expr(b, ename),
      ESeq(a, b) => edp_performs_user_effect_expr(a, ename) || edp_performs_user_effect_expr(b, ename),
      EAssign(_, v, c) => edp_performs_user_effect_expr(v, ename) || edp_performs_user_effect_expr(c, ename),
      EAssignOp(_, _, v, c) => edp_performs_user_effect_expr(v, ename) || edp_performs_user_effect_expr(c, ename),
      EReturn(e2) => edp_performs_user_effect_expr(e2, ename),
      EDot(o, _, _, _) => edp_performs_user_effect_expr(o, ename),
      ECall(callee, args, _) => edp_performs_user_effect_expr(callee, ename) || edp_performs_user_effect_exprs(args, ename),
      EBinOp(_, l, r) => edp_performs_user_effect_expr(l, ename) || edp_performs_user_effect_expr(r, ename),
      EUnaryOp(_, e2) => edp_performs_user_effect_expr(e2, ename),
      ELabeledArg(_, _, v) => edp_performs_user_effect_expr(v, ename),
      EBreak(opt) => match opt {
        Some(e2) => edp_performs_user_effect_expr(e2, ename),
        None => false
      },
      EContinue(args) => edp_performs_user_effect_exprs(args, ename),
      ETuple(elems) => edp_performs_user_effect_exprs(elems, ename),
      EArray(elems) => edp_performs_user_effect_exprs(elems, ename),
      ERecord(_, fields, _) => {
        let mut found = false
        let mut i = 0
        while i < Array::length(fields) && !found {
          let (_, v) = Array::get(fields, i)
          found = edp_performs_user_effect_expr(v, ename)
          i = i + 1
        }
        found
      },
      EMap(fields) => {
        let mut found = false
        let mut i = 0
        while i < Array::length(fields) && !found {
          let (_, v) = Array::get(fields, i)
          found = edp_performs_user_effect_expr(v, ename)
          i = i + 1
        }
        found
      },
      ESpread(e2) => edp_performs_user_effect_expr(e2, ename),
      _ => false
    }
  }
}

fn edp_performs_user_effect_exprs(es: Array[Expr], ename: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(es) && !found {
    found = edp_performs_user_effect_expr(Array::get(es, i), ename)
    i = i + 1
  }
  found
}

/// --- per-handle vacuity (#1119 Codex review, P2) -------------------------
///
/// Whether a SPECIFIC handle is vacuous is a question about ITS OWN body,
/// not about the program. The first cut asked "does the program perform E
/// anywhere", which is too coarse: `lib/@vibe/http` declares server-side
/// wrappers that DO `perform Http::Listen`, so the program-level answer was
/// yes and http_e2e_test's client-only handle — whose body reaches nothing
/// but direct host calls — stayed, then hard-errored (Http is a checker
/// BUILTIN effect, so migration has no operation list to build a dict
/// from). Per-handle reachability is also strictly more precise for the
/// declared-effect pun sites the coarse rule already covered.
///
/// `perf_fns` is the transitive set of top-level functions that can perform
/// E (edp_collect_performing_fns). A body "may perform" if it contains a
/// direct `perform E::op`, calls a member of `perf_fns`, or makes any call
/// this analysis cannot resolve to a known-inert target — the unresolved
/// case is deliberately conservative, since guessing wrong here would erase
/// a handler that really does fire.
fn edp_body_may_perform(body: Expr, ename: String, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Bool {
  if edp_user_perform_effect_of(body) == ename {
    true
  } else {
    match body {
      ECall(callee, args, _) => match callee {
        EIdent(nm, _) => if nm == "perform" {
          // A perform of a DIFFERENT effect: only its operand's arguments
          // can reach further code.
          edp_may_perform_exprs(args, ename, perf_fns, inert, fn_names)
        } else if edp_str_array_contains(perf_fns, nm) {
          true
        } else if edp_callee_is_resolvable(nm, inert, fn_names) {
          // Known-inert, or a known top-level fn already proven not to
          // perform E (it would be in perf_fns otherwise -- the set's
          // seed (b) also covers fns that call opaque targets).
          edp_may_perform_exprs(args, ename, perf_fns, inert, fn_names)
        } else {
          true
        },
        _ => true
      },
      EHandle(b, arms) => if edp_handle_matches_effect(arms, ename) {
        // A nested same-effect handle discharges its own body; only the
        // arms can still reach outward.
        edp_may_perform_arms(arms, ename, perf_fns, inert, fn_names)
      } else {
        edp_body_may_perform(b, ename, perf_fns, inert, fn_names) || edp_may_perform_arms(arms, ename, perf_fns, inert, fn_names)
      },
      EFn(_, _, _, _, _, b) => edp_body_may_perform(b, ename, perf_fns, inert, fn_names),
      EIf(c, t, e2) => edp_body_may_perform(c, ename, perf_fns, inert, fn_names) || edp_body_may_perform(t, ename, perf_fns, inert, fn_names) || edp_body_may_perform(e2, ename, perf_fns, inert, fn_names),
      EMatch(s, arms) => edp_body_may_perform(s, ename, perf_fns, inert, fn_names) || edp_may_perform_arms(arms, ename, perf_fns, inert, fn_names),
      EWhile(c, b) => edp_body_may_perform(c, ename, perf_fns, inert, fn_names) || edp_body_may_perform(b, ename, perf_fns, inert, fn_names),
      EForIn(_, _, it, b) => edp_body_may_perform(it, ename, perf_fns, inert, fn_names) || edp_body_may_perform(b, ename, perf_fns, inert, fn_names),
      ELoop(pairs, b) => edp_may_perform_pairs(pairs, ename, perf_fns, inert, fn_names) || edp_body_may_perform(b, ename, perf_fns, inert, fn_names),
      ELet(_, v, b, _) => edp_body_may_perform(v, ename, perf_fns, inert, fn_names) || edp_body_may_perform(b, ename, perf_fns, inert, fn_names),
      ELetMut(_, v, b, _) => edp_body_may_perform(v, ename, perf_fns, inert, fn_names) || edp_body_may_perform(b, ename, perf_fns, inert, fn_names),
      ELetRec(_, v, b) => edp_body_may_perform(v, ename, perf_fns, inert, fn_names) || edp_body_may_perform(b, ename, perf_fns, inert, fn_names),
      ESeq(a, b) => edp_body_may_perform(a, ename, perf_fns, inert, fn_names) || edp_body_may_perform(b, ename, perf_fns, inert, fn_names),
      EAssign(_, v, c) => edp_body_may_perform(v, ename, perf_fns, inert, fn_names) || edp_body_may_perform(c, ename, perf_fns, inert, fn_names),
      EAssignOp(_, _, v, c) => edp_body_may_perform(v, ename, perf_fns, inert, fn_names) || edp_body_may_perform(c, ename, perf_fns, inert, fn_names),
      EReturn(e2) => edp_body_may_perform(e2, ename, perf_fns, inert, fn_names),
      EDot(o, _, _, _) => edp_body_may_perform(o, ename, perf_fns, inert, fn_names),
      EBinOp(_, l, r) => edp_body_may_perform(l, ename, perf_fns, inert, fn_names) || edp_body_may_perform(r, ename, perf_fns, inert, fn_names),
      EUnaryOp(_, e2) => edp_body_may_perform(e2, ename, perf_fns, inert, fn_names),
      ELabeledArg(_, _, v) => edp_body_may_perform(v, ename, perf_fns, inert, fn_names),
      EBreak(opt) => match opt {
        Some(e2) => edp_body_may_perform(e2, ename, perf_fns, inert, fn_names),
        None => false
      },
      EContinue(args) => edp_may_perform_exprs(args, ename, perf_fns, inert, fn_names),
      ETuple(elems) => edp_may_perform_exprs(elems, ename, perf_fns, inert, fn_names),
      EArray(elems) => edp_may_perform_exprs(elems, ename, perf_fns, inert, fn_names),
      ERecord(_, fields, _) => edp_may_perform_fields(fields, ename, perf_fns, inert, fn_names),
      EMap(fields) => edp_may_perform_fields(fields, ename, perf_fns, inert, fn_names),
      ESpread(e2) => edp_body_may_perform(e2, ename, perf_fns, inert, fn_names),
      _ => false
    }
  }
}

fn edp_may_perform_exprs(es: Array[Expr], ename: String, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(es) && !found {
    found = edp_body_may_perform(Array::get(es, i), ename, perf_fns, inert, fn_names)
    i = i + 1
  }
  found
}

fn edp_may_perform_arms(arms: Array[(Pat, Expr)], ename: String, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) && !found {
    let (_, ex) = Array::get(arms, i)
    found = edp_body_may_perform(ex, ename, perf_fns, inert, fn_names)
    i = i + 1
  }
  found
}

fn edp_may_perform_pairs(pairs: Array[(String, Expr)], ename: String, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(pairs) && !found {
    let (_, v) = Array::get(pairs, i)
    found = edp_body_may_perform(v, ename, perf_fns, inert, fn_names)
    i = i + 1
  }
  found
}

fn edp_may_perform_fields(fields: Array[(String, Expr)], ename: String, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(fields) && !found {
    let (_, v) = Array::get(fields, i)
    found = edp_body_may_perform(v, ename, perf_fns, inert, fn_names)
    i = i + 1
  }
  found
}

/// Top-level function names that can perform `ename`. Seeded with BOTH
///   (a) the ones whose body carries a direct `perform ename::op`
///       (syntactically, anywhere inside -- nested closures included, since
///       a literal defined here can be called from anywhere), and
///   (b) the ones whose body makes a call this analysis cannot resolve (an
///       opaque closure parameter, an indirect callee, a local binding) --
///       such a call can reach ANY code in the program, performs included.
/// Then closed transitively over calls-by-name until the set stops growing.
///
/// (b) is not optional: `apply_twice(f) = f() + f()` performs nothing
/// directly and calls nothing by name, so without it the whole set missed
/// it and a handle over `apply_twice(inner)` looked vacuous -- gate 40ap
/// caught exactly that ("null function or function signature mismatch",
/// the erased handler's dict never built). Only ever consulted when the
/// program really does perform `ename` somewhere; when it doesn't, every
/// site is vacuous by construction and no reachability question is asked.
fn edp_collect_performing_fns(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String, inert: Array[String], fn_names: Array[String]) -> Array[String] {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(fn_defs) {
    let (_, _, _, nm, _, _) = Array::get(fn_defs, i)
    match edp_find_fn_body(stmts, fn_defs, nm) {
      Some(body) => if (edp_performs_user_effect_expr(body, ename) || edp_body_has_opaque_call(body, inert, fn_names)) && !edp_str_array_contains(out, nm) {
        Array::push(out, nm)
      } else {
        ()
      },
      None => ()
    }
    i = i + 1
  }
  let mut grew = true
  let mut rounds = 0
  while grew && rounds < Array::length(fn_defs) + 1 {
    grew = false
    rounds = rounds + 1
    let mut j = 0
    while j < Array::length(fn_defs) {
      let (_, _, _, nm2, _, _) = Array::get(fn_defs, j)
      if edp_str_array_contains(out, nm2) {
        ()
      } else {
        match edp_find_fn_body(stmts, fn_defs, nm2) {
          Some(body2) => if edp_body_calls_any(body2, out) {
            Array::push(out, nm2)
            grew = true
          } else {
            ()
          },
          None => ()
        }
      }
      j = j + 1
    }
  }
  out
}

/// Is this callee one whose target this analysis can name? Anything else
/// (an opaque closure parameter, a local binding, an indirect callee) can
/// reach arbitrary code, performs included.
fn edp_callee_is_resolvable(nm: String, inert: Array[String], fn_names: Array[String]) -> Bool {
  nm == "perform" || nm == "resume" || edp_is_pure_builtin_call(nm) || edp_name_is_host_raw_shape(nm) || edp_str_array_contains(inert, nm) || edp_str_array_contains(fn_names, nm)
}

/// Does `expr` make any call this analysis cannot resolve to a named
/// target? See edp_collect_performing_fns seed (b).
fn edp_body_has_opaque_call(expr: Expr, inert: Array[String], fn_names: Array[String]) -> Bool {
  match expr {
    ECall(callee, args, _) => {
      let opaque = match callee {
        EIdent(nm, _) => !edp_callee_is_resolvable(nm, inert, fn_names),
        _ => true
      }
      opaque || edp_opaque_call_exprs(args, inert, fn_names)
    },
    EFn(_, _, _, _, _, b) => edp_body_has_opaque_call(b, inert, fn_names),
    EHandle(b, arms) => edp_body_has_opaque_call(b, inert, fn_names) || edp_opaque_call_arms(arms, inert, fn_names),
    EIf(c, t, e2) => edp_body_has_opaque_call(c, inert, fn_names) || edp_body_has_opaque_call(t, inert, fn_names) || edp_body_has_opaque_call(e2, inert, fn_names),
    EMatch(s, arms) => edp_body_has_opaque_call(s, inert, fn_names) || edp_opaque_call_arms(arms, inert, fn_names),
    EWhile(c, b) => edp_body_has_opaque_call(c, inert, fn_names) || edp_body_has_opaque_call(b, inert, fn_names),
    EForIn(_, _, it, b) => edp_body_has_opaque_call(it, inert, fn_names) || edp_body_has_opaque_call(b, inert, fn_names),
    ELoop(pairs, b) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(pairs) && !found {
        let (_, v) = Array::get(pairs, i)
        found = edp_body_has_opaque_call(v, inert, fn_names)
        i = i + 1
      }
      found || edp_body_has_opaque_call(b, inert, fn_names)
    },
    ELet(_, v, b, _) => edp_body_has_opaque_call(v, inert, fn_names) || edp_body_has_opaque_call(b, inert, fn_names),
    ELetMut(_, v, b, _) => edp_body_has_opaque_call(v, inert, fn_names) || edp_body_has_opaque_call(b, inert, fn_names),
    ELetRec(_, v, b) => edp_body_has_opaque_call(v, inert, fn_names) || edp_body_has_opaque_call(b, inert, fn_names),
    ESeq(a, b) => edp_body_has_opaque_call(a, inert, fn_names) || edp_body_has_opaque_call(b, inert, fn_names),
    EAssign(_, v, c) => edp_body_has_opaque_call(v, inert, fn_names) || edp_body_has_opaque_call(c, inert, fn_names),
    EAssignOp(_, _, v, c) => edp_body_has_opaque_call(v, inert, fn_names) || edp_body_has_opaque_call(c, inert, fn_names),
    EReturn(e2) => edp_body_has_opaque_call(e2, inert, fn_names),
    EDot(o, _, _, _) => edp_body_has_opaque_call(o, inert, fn_names),
    EBinOp(_, l, r) => edp_body_has_opaque_call(l, inert, fn_names) || edp_body_has_opaque_call(r, inert, fn_names),
    EUnaryOp(_, e2) => edp_body_has_opaque_call(e2, inert, fn_names),
    ELabeledArg(_, _, v) => edp_body_has_opaque_call(v, inert, fn_names),
    EBreak(opt) => match opt {
      Some(e2) => edp_body_has_opaque_call(e2, inert, fn_names),
      None => false
    },
    EContinue(args) => edp_opaque_call_exprs(args, inert, fn_names),
    ETuple(elems) => edp_opaque_call_exprs(elems, inert, fn_names),
    EArray(elems) => edp_opaque_call_exprs(elems, inert, fn_names),
    ERecord(_, fields, _) => edp_opaque_call_fields(fields, inert, fn_names),
    EMap(fields) => edp_opaque_call_fields(fields, inert, fn_names),
    ESpread(e2) => edp_body_has_opaque_call(e2, inert, fn_names),
    _ => false
  }
}

fn edp_opaque_call_exprs(es: Array[Expr], inert: Array[String], fn_names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(es) && !found {
    found = edp_body_has_opaque_call(Array::get(es, i), inert, fn_names)
    i = i + 1
  }
  found
}

fn edp_opaque_call_arms(arms: Array[(Pat, Expr)], inert: Array[String], fn_names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) && !found {
    let (_, ex) = Array::get(arms, i)
    found = edp_body_has_opaque_call(ex, inert, fn_names)
    i = i + 1
  }
  found
}

fn edp_opaque_call_fields(fields: Array[(String, Expr)], inert: Array[String], fn_names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(fields) && !found {
    let (_, v) = Array::get(fields, i)
    found = edp_body_has_opaque_call(v, inert, fn_names)
    i = i + 1
  }
  found
}

/// Does `expr` contain a call whose callee is a bare name in `names`?
fn edp_body_calls_any(expr: Expr, names: Array[String]) -> Bool {
  match expr {
    ECall(callee, args, _) => {
      let hit = match callee {
        EIdent(nm, _) => edp_str_array_contains(names, nm),
        _ => false
      }
      hit || edp_body_calls_any(callee, names) || edp_calls_any_exprs(args, names)
    },
    EFn(_, _, _, _, _, b) => edp_body_calls_any(b, names),
    EHandle(b, arms) => edp_body_calls_any(b, names) || edp_calls_any_arms(arms, names),
    EIf(c, t, e2) => edp_body_calls_any(c, names) || edp_body_calls_any(t, names) || edp_body_calls_any(e2, names),
    EMatch(s, arms) => edp_body_calls_any(s, names) || edp_calls_any_arms(arms, names),
    EWhile(c, b) => edp_body_calls_any(c, names) || edp_body_calls_any(b, names),
    EForIn(_, _, it, b) => edp_body_calls_any(it, names) || edp_body_calls_any(b, names),
    ELoop(pairs, b) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(pairs) && !found {
        let (_, v) = Array::get(pairs, i)
        found = edp_body_calls_any(v, names)
        i = i + 1
      }
      found || edp_body_calls_any(b, names)
    },
    ELet(_, v, b, _) => edp_body_calls_any(v, names) || edp_body_calls_any(b, names),
    ELetMut(_, v, b, _) => edp_body_calls_any(v, names) || edp_body_calls_any(b, names),
    ELetRec(_, v, b) => edp_body_calls_any(v, names) || edp_body_calls_any(b, names),
    ESeq(a, b) => edp_body_calls_any(a, names) || edp_body_calls_any(b, names),
    EAssign(_, v, c) => edp_body_calls_any(v, names) || edp_body_calls_any(c, names),
    EAssignOp(_, _, v, c) => edp_body_calls_any(v, names) || edp_body_calls_any(c, names),
    EReturn(e2) => edp_body_calls_any(e2, names),
    EDot(o, _, _, _) => edp_body_calls_any(o, names),
    EBinOp(_, l, r) => edp_body_calls_any(l, names) || edp_body_calls_any(r, names),
    EUnaryOp(_, e2) => edp_body_calls_any(e2, names),
    ELabeledArg(_, _, v) => edp_body_calls_any(v, names),
    EBreak(opt) => match opt {
      Some(e2) => edp_body_calls_any(e2, names),
      None => false
    },
    EContinue(args) => edp_calls_any_exprs(args, names),
    ETuple(elems) => edp_calls_any_exprs(elems, names),
    EArray(elems) => edp_calls_any_exprs(elems, names),
    ERecord(_, fields, _) => edp_calls_any_fields(fields, names),
    EMap(fields) => edp_calls_any_fields(fields, names),
    ESpread(e2) => edp_body_calls_any(e2, names),
    _ => false
  }
}

fn edp_calls_any_exprs(es: Array[Expr], names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(es) && !found {
    found = edp_body_calls_any(Array::get(es, i), names)
    i = i + 1
  }
  found
}

fn edp_calls_any_arms(arms: Array[(Pat, Expr)], names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) && !found {
    let (_, ex) = Array::get(arms, i)
    found = edp_body_calls_any(ex, names)
    i = i + 1
  }
  found
}

fn edp_calls_any_fields(fields: Array[(String, Expr)], names: Array[String]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(fields) && !found {
    let (_, v) = Array::get(fields, i)
    found = edp_body_calls_any(v, names)
    i = i + 1
  }
  found
}

fn edp_all_fn_names(fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Array[String] {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(fn_defs) {
    let (_, _, _, nm, _, _) = Array::get(fn_defs, i)
    if edp_str_array_contains(out, nm) {
      ()
    } else {
      Array::push(out, nm)
    }
    i = i + 1
  }
  out
}

fn edp_program_user_performs(stmts: Array[Stmt], ename: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) && !found {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => {
        found = edp_performs_user_effect_expr(expr, ename)
      },
      SLetMut(_, _, expr) => {
        found = edp_performs_user_effect_expr(expr, ename)
      },
      SExpr(expr) => {
        found = edp_performs_user_effect_expr(expr, ename)
      },
      STest(_, expr) => {
        found = edp_performs_user_effect_expr(expr, ename)
      },
      SBench(_, expr) => {
        found = edp_performs_user_effect_expr(expr, ename)
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// Erase a `handle { body } with ename { ... }` (replace the node with its
/// own body) when the body provably cannot perform `ename`; see
/// edp_body_may_perform for the reachability rule. Handles whose body can
/// (or might) perform stay put for ordinary migration.
fn edp_erase_effect_handles_expr(expr: Expr, ename: String, analyze: Bool, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Expr {
  match expr {
    EHandle(body, arms) => {
      let body2 = edp_erase_effect_handles_expr(body, ename, analyze, perf_fns, inert, fn_names)
      if edp_handle_matches_effect(arms, ename) && (!analyze || !edp_body_may_perform(body, ename, perf_fns, inert, fn_names)) {
        body2
      } else {
        EHandle(body2, for a in arms {
          let (p, ex) = a
          (p, edp_erase_effect_handles_expr(ex, ename, analyze, perf_fns, inert, fn_names))
        })
      }
    },
    EFn(tps, tbs, params, ret, eff, body) => EFn(tps, tbs, params, ret, eff, edp_erase_effect_handles_expr(body, ename, analyze, perf_fns, inert, fn_names)),
    EIf(c, t, e2) => EIf(edp_erase_effect_handles_expr(c, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(t, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(e2, ename, analyze, perf_fns, inert, fn_names)),
    EMatch(s, arms) => EMatch(edp_erase_effect_handles_expr(s, ename, analyze, perf_fns, inert, fn_names), for a in arms {
      let (p, ex) = a
      (p, edp_erase_effect_handles_expr(ex, ename, analyze, perf_fns, inert, fn_names))
    }),
    EWhile(c, b) => EWhile(edp_erase_effect_handles_expr(c, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(b, ename, analyze, perf_fns, inert, fn_names)),
    EForIn(n, idx, it, b) => EForIn(n, idx, edp_erase_effect_handles_expr(it, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(b, ename, analyze, perf_fns, inert, fn_names)),
    ELoop(pairs, b) => ELoop(for pr in pairs {
      let (n, v) = pr
      (n, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names))
    }, edp_erase_effect_handles_expr(b, ename, analyze, perf_fns, inert, fn_names)),
    ELet(n, v, b, off) => ELet(n, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(b, ename, analyze, perf_fns, inert, fn_names), off),
    ELetMut(n, v, b, off) => ELetMut(n, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(b, ename, analyze, perf_fns, inert, fn_names), off),
    ELetRec(n, v, b) => ELetRec(n, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(b, ename, analyze, perf_fns, inert, fn_names)),
    ESeq(a, b) => ESeq(edp_erase_effect_handles_expr(a, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(b, ename, analyze, perf_fns, inert, fn_names)),
    EAssign(n, v, c) => EAssign(n, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(c, ename, analyze, perf_fns, inert, fn_names)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(c, ename, analyze, perf_fns, inert, fn_names)),
    EReturn(e2) => EReturn(edp_erase_effect_handles_expr(e2, ename, analyze, perf_fns, inert, fn_names)),
    EDot(o, f, off1, off2) => EDot(edp_erase_effect_handles_expr(o, ename, analyze, perf_fns, inert, fn_names), f, off1, off2),
    ECall(callee, args, off) => ECall(edp_erase_effect_handles_expr(callee, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_exprs(args, ename, analyze, perf_fns, inert, fn_names), off),
    EBinOp(op, l, r) => EBinOp(op, edp_erase_effect_handles_expr(l, ename, analyze, perf_fns, inert, fn_names), edp_erase_effect_handles_expr(r, ename, analyze, perf_fns, inert, fn_names)),
    EUnaryOp(op, e2) => EUnaryOp(op, edp_erase_effect_handles_expr(e2, ename, analyze, perf_fns, inert, fn_names)),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names)),
    EBreak(opt) => EBreak(match opt {
      Some(e2) => Some(edp_erase_effect_handles_expr(e2, ename, analyze, perf_fns, inert, fn_names)),
      None => None
    }),
    EContinue(args) => EContinue(edp_erase_effect_handles_exprs(args, ename, analyze, perf_fns, inert, fn_names)),
    ETuple(elems) => ETuple(edp_erase_effect_handles_exprs(elems, ename, analyze, perf_fns, inert, fn_names)),
    EArray(elems) => EArray(edp_erase_effect_handles_exprs(elems, ename, analyze, perf_fns, inert, fn_names)),
    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {
      let (fn2, v) = f
      (fn2, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names))
    }, targs),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, edp_erase_effect_handles_expr(v, ename, analyze, perf_fns, inert, fn_names))
    }),
    ESpread(e2) => ESpread(edp_erase_effect_handles_expr(e2, ename, analyze, perf_fns, inert, fn_names)),
    _ => expr
  }
}

fn edp_erase_effect_handles_exprs(es: Array[Expr], ename: String, analyze: Bool, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Array[Expr] {
  for e in es {
    edp_erase_effect_handles_expr(e, ename, analyze, perf_fns, inert, fn_names)
  }
}

fn edp_erase_effect_handles(stmts: Array[Stmt], ename: String, analyze: Bool, perf_fns: Array[String], inert: Array[String], fn_names: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, i, SLet(exported, is_rec, name, ty, edp_erase_effect_handles_expr(expr, ename, analyze, perf_fns, inert, fn_names))),
      SLetMut(nm, ty, expr) => Array::set(stmts, i, SLetMut(nm, ty, edp_erase_effect_handles_expr(expr, ename, analyze, perf_fns, inert, fn_names))),
      SExpr(expr) => Array::set(stmts, i, SExpr(edp_erase_effect_handles_expr(expr, ename, analyze, perf_fns, inert, fn_names))),
      STest(tn, expr) => Array::set(stmts, i, STest(tn, edp_erase_effect_handles_expr(expr, ename, analyze, perf_fns, inert, fn_names))),
      SBench(bn, expr) => Array::set(stmts, i, SBench(bn, edp_erase_effect_handles_expr(expr, ename, analyze, perf_fns, inert, fn_names))),
      _ => ()
    }
    i = i + 1
  }
}

/// --- V2 step 2: seed-scoped α-rename of shadowing binders. --------------
///
/// edp_rewrite_needing_body / edp_rewrite_handle_body match call sites by
/// NAME ONLY, so #1074's edp_drop_shadowed_needing conservatively dropped
/// any needing name shadowed anywhere -- and the site then fell back to
/// replay. With replay removed that fallback is a hard error, and "a local
/// variable somewhere reuses an effectful function's name" is far too
/// common to reject. Instead of teaching every rewriter scope tracking,
/// rename the SHADOWING binders themselves (`__edpsh_N_<name>`, plain
/// α-conversion, semantics-free): afterwards the name-only match is exact,
/// edp_drop_shadowed_needing finds nothing to drop, and the shadowed-
/// needing class migrates like any other program. The same trick is
/// already proven program-wide by the RC lane's uniquify_shadowed_bindings
/// (#712, normalize/index.vibe) -- this is its seed-scoped local cousin
/// (local copy per this file's convention; only binders whose name is in
/// `seed` are touched, everything else is left byte-identical). Any binder
/// shape this traversal might ever miss stays shadowed and is still caught
/// by edp_drop_shadowed_needing, so the failure mode is the OLD
/// conservative behavior (now a loud ineligibility error), never a
/// miscompile.
/// #1119 Codex review (P2): the generated spelling must not collide with a
/// name the program ALREADY uses. If user code binds `__edpsh_0_helper`
/// itself and also shadows a needing `helper`, a blind counter would rename
/// the shadow ONTO the existing binding -- two distinct bindings become one
/// name before any later uniquification can tell them apart, so reads of
/// the pre-existing one can resolve to the renamed shadow (wrong value, no
/// diagnostic). `taken` carries every `__edpsh_`-prefixed name already
/// present anywhere in the program (edp_collect_prefixed_names, one scan);
/// the counter skips past any candidate that hits it.
fn edp_ar_fresh(counter: Array[Int], name: String, taken: Array[String]) -> String {
  let mut out = ""
  while out == "" {
    let n = Array::get(counter, 0)
    Array::set(counter, 0, n + 1)
    let cand = String::concat(String::concat(String::concat("__edpsh_", __to_string(n)), "_"), name)
    if edp_str_array_contains(taken, cand) {
      ()
    } else {
      out = cand
    }
  }
  out
}

/// Every name starting with `prefix` that appears anywhere in `stmts` --
/// as a binder OR as a reference. Prefix-filtered (not a full identifier
/// census) because the only collisions that matter are against the
/// generated `__edpsh_` namespace, and the compiler program carries
/// thousands of ordinary identifiers a full collection would scan on
/// every membership test.
fn edp_collect_prefixed_names(stmts: Array[Stmt], prefix: String, out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, nm, _, expr) => {
        edp_prefix_push(nm, prefix, out)
        edp_collect_prefixed_expr(expr, prefix, out)
      },
      SLetMut(nm, _, expr) => {
        edp_prefix_push(nm, prefix, out)
        edp_collect_prefixed_expr(expr, prefix, out)
      },
      SExpr(expr) => edp_collect_prefixed_expr(expr, prefix, out),
      STest(_, expr) => edp_collect_prefixed_expr(expr, prefix, out),
      SBench(_, expr) => edp_collect_prefixed_expr(expr, prefix, out),
      _ => ()
    }
    i = i + 1
  }
}

fn edp_prefix_push(nm: String, prefix: String, out: Array[String]) -> Unit {
  if String::starts_with(nm, prefix) && !edp_str_array_contains(out, nm) {
    Array::push(out, nm)
  } else {
    ()
  }
}

fn edp_collect_prefixed_pat(p: Pat, prefix: String, out: Array[String]) -> Unit {
  let names = array_empty()
  edp_pat_binds(p, names)
  let mut i = 0
  while i < Array::length(names) {
    edp_prefix_push(Array::get(names, i), prefix, out)
    i = i + 1
  }
}

fn edp_collect_prefixed_exprs(es: Array[Expr], prefix: String, out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(es) {
    edp_collect_prefixed_expr(Array::get(es, i), prefix, out)
    i = i + 1
  }
}

fn edp_collect_prefixed_expr(expr: Expr, prefix: String, out: Array[String]) -> Unit {
  match expr {
    EIdent(nm, _) => edp_prefix_push(nm, prefix, out),
    EFn(_, _, params, _, _, body) => {
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        edp_prefix_push(edp_strip_tilde(pn), prefix, out)
        i = i + 1
      }
      edp_collect_prefixed_expr(body, prefix, out)
    },
    EHandle(b, arms) => {
      edp_collect_prefixed_expr(b, prefix, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        edp_collect_prefixed_pat(p, prefix, out)
        edp_collect_prefixed_expr(ex, prefix, out)
        i = i + 1
      }
    },
    EMatch(s, arms) => {
      edp_collect_prefixed_expr(s, prefix, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        edp_collect_prefixed_pat(p, prefix, out)
        edp_collect_prefixed_expr(ex, prefix, out)
        i = i + 1
      }
    },
    EIf(c, t, e2) => {
      edp_collect_prefixed_expr(c, prefix, out)
      edp_collect_prefixed_expr(t, prefix, out)
      edp_collect_prefixed_expr(e2, prefix, out)
    },
    EWhile(c, b) => {
      edp_collect_prefixed_expr(c, prefix, out)
      edp_collect_prefixed_expr(b, prefix, out)
    },
    EForIn(n, idx, it, b) => {
      edp_prefix_push(n, prefix, out)
      match idx {
        Some(iname) => edp_prefix_push(iname, prefix, out),
        None => ()
      }
      edp_collect_prefixed_expr(it, prefix, out)
      edp_collect_prefixed_expr(b, prefix, out)
    },
    ELoop(pairs, b) => {
      let mut i = 0
      while i < Array::length(pairs) {
        let (pn, v) = Array::get(pairs, i)
        edp_prefix_push(pn, prefix, out)
        edp_collect_prefixed_expr(v, prefix, out)
        i = i + 1
      }
      edp_collect_prefixed_expr(b, prefix, out)
    },
    ELet(n, v, b, _) => {
      edp_prefix_push(n, prefix, out)
      edp_collect_prefixed_expr(v, prefix, out)
      edp_collect_prefixed_expr(b, prefix, out)
    },
    ELetMut(n, v, b, _) => {
      edp_prefix_push(n, prefix, out)
      edp_collect_prefixed_expr(v, prefix, out)
      edp_collect_prefixed_expr(b, prefix, out)
    },
    ELetRec(n, v, b) => {
      edp_prefix_push(n, prefix, out)
      edp_collect_prefixed_expr(v, prefix, out)
      edp_collect_prefixed_expr(b, prefix, out)
    },
    ESeq(a, b) => {
      edp_collect_prefixed_expr(a, prefix, out)
      edp_collect_prefixed_expr(b, prefix, out)
    },
    EAssign(n, v, c) => {
      edp_prefix_push(n, prefix, out)
      edp_collect_prefixed_expr(v, prefix, out)
      edp_collect_prefixed_expr(c, prefix, out)
    },
    EAssignOp(n, _, v, c) => {
      edp_prefix_push(n, prefix, out)
      edp_collect_prefixed_expr(v, prefix, out)
      edp_collect_prefixed_expr(c, prefix, out)
    },
    EReturn(e2) => edp_collect_prefixed_expr(e2, prefix, out),
    EDot(o, _, _, _) => edp_collect_prefixed_expr(o, prefix, out),
    ECall(callee, args, _) => {
      edp_collect_prefixed_expr(callee, prefix, out)
      edp_collect_prefixed_exprs(args, prefix, out)
    },
    EBinOp(_, l, r) => {
      edp_collect_prefixed_expr(l, prefix, out)
      edp_collect_prefixed_expr(r, prefix, out)
    },
    EUnaryOp(_, e2) => edp_collect_prefixed_expr(e2, prefix, out),
    ELabeledArg(_, _, v) => edp_collect_prefixed_expr(v, prefix, out),
    EBreak(opt) => match opt {
      Some(e2) => edp_collect_prefixed_expr(e2, prefix, out),
      None => ()
    },
    EContinue(args) => edp_collect_prefixed_exprs(args, prefix, out),
    ETuple(elems) => edp_collect_prefixed_exprs(elems, prefix, out),
    EArray(elems) => edp_collect_prefixed_exprs(elems, prefix, out),
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        edp_collect_prefixed_expr(v, prefix, out)
        i = i + 1
      }
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        edp_collect_prefixed_expr(v, prefix, out)
        i = i + 1
      }
    },
    ESpread(e2) => edp_collect_prefixed_expr(e2, prefix, out),
    _ => ()
  }
}

fn edp_ar_lookup(env_names: Array[String], env_repl: Array[String], name: String) -> String {
  let mut i = Array::length(env_names) - 1
  let mut out = name
  let mut found = false
  while i >= 0 && !found {
    if Array::get(env_names, i) == name {
      out = Array::get(env_repl, i)
      found = true
    } else {
      ()
    }
    i = i - 1
  }
  out
}

fn edp_ar_bind(name: String, seed: Array[String], env_names: Array[String], env_repl: Array[String], counter: Array[Int], taken: Array[String]) -> String {
  if edp_str_array_contains(seed, name) {
    let fresh = edp_ar_fresh(counter, name, taken)
    Array::push(env_names, name)
    Array::push(env_repl, fresh)
    fresh
  } else {
    name
  }
}

fn edp_ar_pat_rewrite(p: Pat, env_names: Array[String], env_repl: Array[String]) -> Pat {
  match p {
    PBind(n) => PBind(edp_ar_lookup(env_names, env_repl, n)),
    PCtor(nm, args) => PCtor(nm, for a in args {
      edp_ar_pat_rewrite(a, env_names, env_repl)
    }),
    PTuple(ps) => PTuple(for a in ps {
      edp_ar_pat_rewrite(a, env_names, env_repl)
    }),
    POr(a, b) => POr(edp_ar_pat_rewrite(a, env_names, env_repl), edp_ar_pat_rewrite(b, env_names, env_repl)),
    PStruct(nm, fields) => PStruct(nm, for f in fields {
      let (fname, fp) = f
      (fname, edp_ar_pat_rewrite(fp, env_names, env_repl))
    }),
    _ => p
  }
}

/// Two-phase like normalize's uq_bind_pat: bind every seed-colliding name
/// first (POr binds the same name on both sides -- last mapping wins for
/// both, keeping the sides consistent), then rewrite the pattern via
/// lookup.
fn edp_ar_bind_pat(p: Pat, seed: Array[String], env_names: Array[String], env_repl: Array[String], counter: Array[Int], taken: Array[String]) -> Pat {
  let names = array_empty()
  edp_pat_binds(p, names)
  let mut i = 0
  while i < Array::length(names) {
    let _ = edp_ar_bind(Array::get(names, i), seed, env_names, env_repl, counter, taken)
    i = i + 1
  }
  edp_ar_pat_rewrite(p, env_names, env_repl)
}

fn edp_ar_exprs(es: Array[Expr], seed: Array[String], env_names: Array[String], env_repl: Array[String], counter: Array[Int], taken: Array[String]) -> Array[Expr] {
  for e in es {
    edp_ar_expr(e, seed, env_names, env_repl, counter, taken)
  }
}

fn edp_ar_expr(expr: Expr, seed: Array[String], env_names: Array[String], env_repl: Array[String], counter: Array[Int], taken: Array[String]) -> Expr {
  match expr {
    EIdent(n, off) => EIdent(edp_ar_lookup(env_names, env_repl, n), off),
    EFn(tps, tbs, params, ret, eff, body) => {
      let base = Array::length(env_names)
      let params2: Array[(String, Option[TypeExpr])] = [
      ]
      let mut i = 0
      while i < Array::length(params) {
        let (pn, pty) = Array::get(params, i)
        Array::push(params2, (edp_ar_bind(pn, seed, env_names, env_repl, counter, taken), pty))
        i = i + 1
      }
      let body2 = edp_ar_expr(body, seed, env_names, env_repl, counter, taken)
      Array::truncate(env_names, base)
      Array::truncate(env_repl, base)
      EFn(tps, tbs, params2, ret, eff, body2)
    },
    EHandle(body, arms) => EHandle(edp_ar_expr(body, seed, env_names, env_repl, counter, taken), for a in arms {
      let (p, ex) = a
      let base = Array::length(env_names)
      let p2 = edp_ar_bind_pat(p, seed, env_names, env_repl, counter, taken)
      let ex2 = edp_ar_expr(ex, seed, env_names, env_repl, counter, taken)
      Array::truncate(env_names, base)
      Array::truncate(env_repl, base)
      (p2, ex2)
    }),
    EMatch(s, arms) => EMatch(edp_ar_expr(s, seed, env_names, env_repl, counter, taken), for a in arms {
      let (p, ex) = a
      let base = Array::length(env_names)
      let p2 = edp_ar_bind_pat(p, seed, env_names, env_repl, counter, taken)
      let ex2 = edp_ar_expr(ex, seed, env_names, env_repl, counter, taken)
      Array::truncate(env_names, base)
      Array::truncate(env_repl, base)
      (p2, ex2)
    }),
    EIf(c, t, e2) => EIf(edp_ar_expr(c, seed, env_names, env_repl, counter, taken), edp_ar_expr(t, seed, env_names, env_repl, counter, taken), edp_ar_expr(e2, seed, env_names, env_repl, counter, taken)),
    EWhile(c, b) => EWhile(edp_ar_expr(c, seed, env_names, env_repl, counter, taken), edp_ar_expr(b, seed, env_names, env_repl, counter, taken)),
    EForIn(n, idx, it, b) => {
      let it2 = edp_ar_expr(it, seed, env_names, env_repl, counter, taken)
      let base = Array::length(env_names)
      let n2 = edp_ar_bind(n, seed, env_names, env_repl, counter, taken)
      let idx2 = match idx {
        Some(iname) => Some(edp_ar_bind(iname, seed, env_names, env_repl, counter, taken)),
        None => None
      }
      let b2 = edp_ar_expr(b, seed, env_names, env_repl, counter, taken)
      Array::truncate(env_names, base)
      Array::truncate(env_repl, base)
      EForIn(n2, idx2, it2, b2)
    },
    ELoop(pairs, b) => {
      let inits2: Array[Expr] = [
      ]
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, v) = Array::get(pairs, i)
        Array::push(inits2, edp_ar_expr(v, seed, env_names, env_repl, counter, taken))
        i = i + 1
      }
      let base = Array::length(env_names)
      let pairs2: Array[(String, Expr)] = [
      ]
      let mut j = 0
      while j < Array::length(pairs) {
        let (pn, _) = Array::get(pairs, j)
        Array::push(pairs2, (edp_ar_bind(pn, seed, env_names, env_repl, counter, taken), Array::get(inits2, j)))
        j = j + 1
      }
      let b2 = edp_ar_expr(b, seed, env_names, env_repl, counter, taken)
      Array::truncate(env_names, base)
      Array::truncate(env_repl, base)
      ELoop(pairs2, b2)
    },
    ELet(n, v, b, off) => {
      let v2 = edp_ar_expr(v, seed, env_names, env_repl, counter, taken)
      let base = Array::length(env_names)
      let n2 = edp_ar_bind(n, seed, env_names, env_repl, counter, taken)
      let b2 = edp_ar_expr(b, seed, env_names, env_repl, counter, taken)
      Array::truncate(env_names, base)
      Array::truncate(env_repl, base)
      ELet(n2, v2, b2, off)
    },
    ELetMut(n, v, b, off) => {
      let v2 = edp_ar_expr(v, seed, env_names, env_repl, counter, taken)
      let base = Array::length(env_names)
      let n2 = edp_ar_bind(n, seed, env_names, env_repl, counter, taken)
      let b2 = edp_ar_expr(b, seed, env_names, env_repl, counter, taken)
      Array::truncate(env_names, base)
      Array::truncate(env_repl, base)
      ELetMut(n2, v2, b2, off)
    },
    ELetRec(n, v, b) => {
      let base = Array::length(env_names)
      let n2 = edp_ar_bind(n, seed, env_names, env_repl, counter, taken)
      let v2 = edp_ar_expr(v, seed, env_names, env_repl, counter, taken)
      let b2 = edp_ar_expr(b, seed, env_names, env_repl, counter, taken)
      Array::truncate(env_names, base)
      Array::truncate(env_repl, base)
      ELetRec(n2, v2, b2)
    },
    ESeq(a, b) => ESeq(edp_ar_expr(a, seed, env_names, env_repl, counter, taken), edp_ar_expr(b, seed, env_names, env_repl, counter, taken)),
    EAssign(n, v, c) => EAssign(edp_ar_lookup(env_names, env_repl, n), edp_ar_expr(v, seed, env_names, env_repl, counter, taken), edp_ar_expr(c, seed, env_names, env_repl, counter, taken)),
    EAssignOp(n, op, v, c) => EAssignOp(edp_ar_lookup(env_names, env_repl, n), op, edp_ar_expr(v, seed, env_names, env_repl, counter, taken), edp_ar_expr(c, seed, env_names, env_repl, counter, taken)),
    EReturn(e2) => EReturn(edp_ar_expr(e2, seed, env_names, env_repl, counter, taken)),
    EDot(o, f, off1, off2) => EDot(edp_ar_expr(o, seed, env_names, env_repl, counter, taken), f, off1, off2),
    ECall(callee, args, off) => ECall(edp_ar_expr(callee, seed, env_names, env_repl, counter, taken), edp_ar_exprs(args, seed, env_names, env_repl, counter, taken), off),
    EBinOp(op, l, r) => EBinOp(op, edp_ar_expr(l, seed, env_names, env_repl, counter, taken), edp_ar_expr(r, seed, env_names, env_repl, counter, taken)),
    EUnaryOp(op, e2) => EUnaryOp(op, edp_ar_expr(e2, seed, env_names, env_repl, counter, taken)),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_ar_expr(v, seed, env_names, env_repl, counter, taken)),
    EBreak(opt) => EBreak(match opt {
      Some(e2) => Some(edp_ar_expr(e2, seed, env_names, env_repl, counter, taken)),
      None => None
    }),
    EContinue(args) => EContinue(edp_ar_exprs(args, seed, env_names, env_repl, counter, taken)),
    ETuple(elems) => ETuple(edp_ar_exprs(elems, seed, env_names, env_repl, counter, taken)),
    EArray(elems) => EArray(edp_ar_exprs(elems, seed, env_names, env_repl, counter, taken)),
    ERecord(rn, fields, targs) => ERecord(rn, for f in fields {
      let (fn2, v) = f
      (fn2, edp_ar_expr(v, seed, env_names, env_repl, counter, taken))
    }, targs),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, edp_ar_expr(v, seed, env_names, env_repl, counter, taken))
    }),
    ESpread(e2) => ESpread(edp_ar_expr(e2, seed, env_names, env_repl, counter, taken)),
    _ => expr
  }
}

/// Returns true iff the rename walk actually ran (some needing name was
/// shadowed), and in that case fills `user_prefixed` with every
/// `__edpsh_`-prefixed name the program contained BEFORE renaming — i.e. the
/// user-authored ones. edp_ar_fresh never re-issues a name from that census,
/// so post-rename a prefixed name is compiler-generated iff the walk ran and
/// the name is NOT in `user_prefixed` (Codex review, PR #1594: culprit
/// diagnostics must not strip a prefix the user spelled themselves).
fn edp_alpha_rename_shadowed(stmts: Array[Stmt], effect_defs: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], user_prefixed: Array[String]) -> Bool {
  let es_names = array_empty()
  let es_members_list = array_empty()
  edp_es_collect_into(stmts, es_names, es_members_list)
  let seed = empty_str_array()
  let mut ei = 0
  while ei < Array::length(effect_defs) {
    let (ename, _) = Array::get(effect_defs, ei)
    let needing = edp_needing_names(fn_defs, ename, es_names, es_members_list)
    let mut ni = 0
    while ni < Array::length(needing) {
      let nm = Array::get(needing, ni)
      if edp_str_array_contains(seed, nm) {
        ()
      } else {
        let mut shadowed = false
        let mut si = 0
        while si < Array::length(stmts) && !shadowed {
          let sv_opt = match Array::get(stmts, si) {
            SLet(_, _, _, _, sv) => Some(sv),
            SLetMut(_, _, sv) => Some(sv),
            SExpr(sv) => Some(sv),
            STest(_, sv) => Some(sv),
            SBench(_, sv) => Some(sv),
            _ => None
          }
          match sv_opt {
            Some(sv) => if edp_expr_binds_name(sv, nm) {
              shadowed = true
            } else {
              ()
            },
            None => ()
          }
          si = si + 1
        }
        if shadowed {
          Array::push(seed, nm)
        } else {
          ()
        }
      }
      ni = ni + 1
    }
    ei = ei + 1
  }
  if Array::length(seed) == 0 {
    false
  } else {
    let counter = [
      0
    ]
    // #1119 Codex review (P2): never generate a name the program already
    // uses -- see edp_ar_fresh's doc comment. The same census doubles as
    // the user-authored-name record for the culprit diagnostic (doc above).
    let taken = user_prefixed
    edp_collect_prefixed_names(stmts, "__edpsh_", taken)
    let mut i = 0
    while i < Array::length(stmts) {
      let expr_opt = match Array::get(stmts, i) {
        SLet(_, _, _, _, expr) => Some(expr),
        SLetMut(_, _, expr) => Some(expr),
        SExpr(expr) => Some(expr),
        STest(_, expr) => Some(expr),
        SBench(_, expr) => Some(expr),
        _ => None
      }
      match expr_opt {
        Some(expr) => {
          let mut hits = false
          let mut sj = 0
          while sj < Array::length(seed) && !hits {
            hits = edp_expr_binds_name(expr, Array::get(seed, sj))
            sj = sj + 1
          }
          if hits {
            let env_names = empty_str_array()
            let env_repl = empty_str_array()
            let new_expr = edp_ar_expr(expr, seed, env_names, env_repl, counter, taken)
            match Array::get(stmts, i) {
              SLet(exported, is_rec, name, ty, _) => Array::set(stmts, i, SLet(exported, is_rec, name, ty, new_expr)),
              SLetMut(nm2, ty2, _) => Array::set(stmts, i, SLetMut(nm2, ty2, new_expr)),
              SExpr(_) => Array::set(stmts, i, SExpr(new_expr)),
              STest(tn2, _) => Array::set(stmts, i, STest(tn2, new_expr)),
              SBench(bn2, _) => Array::set(stmts, i, SBench(bn2, new_expr)),
              _ => ()
            }
          } else {
            ()
          }
        },
        None => ()
      }
      i = i + 1
    }
    true
  }
}

/// --- V2 step 3: post-migration live-handle check. ------------------------
///
/// Returns the effect name (or "<catch-all>") of the first non-Error
/// `handle` still present in REACHABLE code after every migration pass has
/// run, or "" when the tree is clean. `keep` is dce_keep_flags' per-stmt
/// verdict; note apply may have APPENDED stmts past keep's length -- those
/// are pass-synthesized (dict structs / closures), contain no handles, and
/// are treated as kept.
fn edp_first_live_replay_handle(stmts: Array[Stmt], keep: Array[Bool]) -> String {
  let mut i = 0
  let mut found = ""
  while i < Array::length(stmts) && found == "" {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => {
        let dead_fn = match expr {
          EFn(_, _, _, _, _, _) => if i < Array::length(keep) {
            !Array::get(keep, i)
          } else {
            false
          },
          _ => false
        }
        if dead_fn {
          ()
        } else {
          found = edp_nonerror_handle_desc_expr(expr)
        }
      },
      SLetMut(_, _, expr) => {
        found = edp_nonerror_handle_desc_expr(expr)
      },
      SExpr(expr) => {
        found = edp_nonerror_handle_desc_expr(expr)
      },
      STest(_, expr) => {
        found = edp_nonerror_handle_desc_expr(expr)
      },
      SBench(_, expr) => {
        found = edp_nonerror_handle_desc_expr(expr)
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// The effect desc a `handle`'s arm list claims: the first arm's effect name,
/// `"<catch-all>"` for a wildcard/binder arm, `""` for an Error handle (or no
/// arms). Shared by the live-handle check and the #1514 culprit-call locator so
/// both agree on WHICH handle a given desc refers to.
fn edp_handle_own_effect_desc(arms: Array[(Pat, Expr)]) -> String {
  let mut own = ""
  if Array::length(arms) > 0 {
    let (p, _) = Array::get(arms, 0)
    match p {
      PCtor(qname, _) => if is_exception_throw_operation(qname) {
        ()
      } else {
        own = edp_effect_name_of(qname)
      },
      PWild => {
        own = "<catch-all>"
      },
      PBind(_) => {
        own = "<catch-all>"
      },
      _ => ()
    }
  } else {
    ()
  }
  own
}

fn edp_nonerror_handle_desc_expr(expr: Expr) -> String {
  match expr {
    EHandle(body, arms) => {
      let own = edp_handle_own_effect_desc(arms)
      if own == "" {
        let inner = edp_nonerror_handle_desc_expr(body)
        if inner == "" {
          edp_nonerror_handle_desc_arms(arms)
        } else {
          inner
        }
      } else {
        own
      }
    },
    EFn(_, _, _, _, _, b) => edp_nonerror_handle_desc_expr(b),
    EIf(c, t, e2) => {
      let a = edp_nonerror_handle_desc_expr(c)
      if a == "" {
        let b = edp_nonerror_handle_desc_expr(t)
        if b == "" {
          edp_nonerror_handle_desc_expr(e2)
        } else {
          b
        }
      } else {
        a
      }
    },
    EMatch(s, arms) => {
      let a = edp_nonerror_handle_desc_expr(s)
      if a == "" {
        edp_nonerror_handle_desc_arms(arms)
      } else {
        a
      }
    },
    EWhile(c, b) => {
      let a = edp_nonerror_handle_desc_expr(c)
      if a == "" {
        edp_nonerror_handle_desc_expr(b)
      } else {
        a
      }
    },
    EForIn(_, _, it, b) => {
      let a = edp_nonerror_handle_desc_expr(it)
      if a == "" {
        edp_nonerror_handle_desc_expr(b)
      } else {
        a
      }
    },
    ELoop(pairs, b) => {
      let mut out = ""
      let mut i = 0
      while i < Array::length(pairs) && out == "" {
        let (_, v) = Array::get(pairs, i)
        out = edp_nonerror_handle_desc_expr(v)
        i = i + 1
      }
      if out == "" {
        edp_nonerror_handle_desc_expr(b)
      } else {
        out
      }
    },
    ELet(_, v, b, _) => {
      let a = edp_nonerror_handle_desc_expr(v)
      if a == "" {
        edp_nonerror_handle_desc_expr(b)
      } else {
        a
      }
    },
    ELetMut(_, v, b, _) => {
      let a = edp_nonerror_handle_desc_expr(v)
      if a == "" {
        edp_nonerror_handle_desc_expr(b)
      } else {
        a
      }
    },
    ELetRec(_, v, b) => {
      let a = edp_nonerror_handle_desc_expr(v)
      if a == "" {
        edp_nonerror_handle_desc_expr(b)
      } else {
        a
      }
    },
    ESeq(a, b) => {
      let x = edp_nonerror_handle_desc_expr(a)
      if x == "" {
        edp_nonerror_handle_desc_expr(b)
      } else {
        x
      }
    },
    EAssign(_, v, c) => {
      let a = edp_nonerror_handle_desc_expr(v)
      if a == "" {
        edp_nonerror_handle_desc_expr(c)
      } else {
        a
      }
    },
    EAssignOp(_, _, v, c) => {
      let a = edp_nonerror_handle_desc_expr(v)
      if a == "" {
        edp_nonerror_handle_desc_expr(c)
      } else {
        a
      }
    },
    EReturn(e2) => edp_nonerror_handle_desc_expr(e2),
    EDot(o, _, _, _) => edp_nonerror_handle_desc_expr(o),
    ECall(callee, args, _) => {
      let a = edp_nonerror_handle_desc_expr(callee)
      if a == "" {
        edp_nonerror_handle_desc_exprs(args)
      } else {
        a
      }
    },
    EBinOp(_, l, r) => {
      let a = edp_nonerror_handle_desc_expr(l)
      if a == "" {
        edp_nonerror_handle_desc_expr(r)
      } else {
        a
      }
    },
    EUnaryOp(_, e2) => edp_nonerror_handle_desc_expr(e2),
    ELabeledArg(_, _, v) => edp_nonerror_handle_desc_expr(v),
    EBreak(opt) => match opt {
      Some(e2) => edp_nonerror_handle_desc_expr(e2),
      None => ""
    },
    EContinue(args) => edp_nonerror_handle_desc_exprs(args),
    ETuple(elems) => edp_nonerror_handle_desc_exprs(elems),
    EArray(elems) => edp_nonerror_handle_desc_exprs(elems),
    ERecord(_, fields, _) => {
      let mut out = ""
      let mut i = 0
      while i < Array::length(fields) && out == "" {
        let (_, v) = Array::get(fields, i)
        out = edp_nonerror_handle_desc_expr(v)
        i = i + 1
      }
      out
    },
    EMap(fields) => {
      let mut out = ""
      let mut i = 0
      while i < Array::length(fields) && out == "" {
        let (_, v) = Array::get(fields, i)
        out = edp_nonerror_handle_desc_expr(v)
        i = i + 1
      }
      out
    },
    ESpread(e2) => edp_nonerror_handle_desc_expr(e2),
    _ => ""
  }
}

fn edp_nonerror_handle_desc_exprs(es: Array[Expr]) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(es) && out == "" {
    out = edp_nonerror_handle_desc_expr(Array::get(es, i))
    i = i + 1
  }
  out
}

fn edp_nonerror_handle_desc_arms(arms: Array[(Pat, Expr)]) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(arms) && out == "" {
    let (_, ex) = Array::get(arms, i)
    out = edp_nonerror_handle_desc_expr(ex)
    i = i + 1
  }
  out
}

/// --- #1514 C (repair 08): name the call that made a live handle ineligible.
///
/// `edp_body_has_opaque_call` answers only Bool, so the live-handle hard error
/// could say WHAT is rejected (an indirect call) but not WHERE. This trio walks
/// the same shapes and returns the first offending call as
/// (found, callee name, source byte offset): the exact edit point. Callee name
/// is "" when the callee is not a bare identifier (an arbitrary callee
/// expression); offset is -1 when the node carries none (synthesized AST).

fn edp_first_opaque_call_info(expr: Expr, inert: Array[String], fn_names: Array[String]) -> (Bool, String, Int) {
  match expr {
    ECall(callee, args, off) => match callee {
      EIdent(nm, ioff) => if edp_callee_is_resolvable(nm, inert, fn_names) {
        edp_first_opaque_call_info_exprs(args, inert, fn_names)
      } else {
        (true, nm, if ioff >= 0 {
          ioff
        } else {
          off
        })
      },
      _ => (true, "", off)
    },
    _ => edp_first_opaque_call_info_exprs(expr_children(expr), inert, fn_names)
  }
}

fn edp_first_opaque_call_info_exprs(es: Array[Expr], inert: Array[String], fn_names: Array[String]) -> (Bool, String, Int) {
  let mut i = 0
  let mut found = false
  let mut nm = ""
  let mut off = -1
  while i < Array::length(es) && !found {
    let (f, n, o) = edp_first_opaque_call_info(Array::get(es, i), inert, fn_names)
    found = f
    nm = n
    off = o
    i = i + 1
  }
  (found, nm, off)
}

/// Find the first `handle` whose arm list claims effect `ename` (the desc
/// edp_first_live_replay_handle just reported) and name the first opaque call
/// in its BODY. Returns ("", -1) when the handle is found but its body has no
/// opaque call (it survived for another reason), or when no such handle is in
/// reachable code (should not happen when called with a live desc).
fn edp_live_handle_opaque_info_expr(expr: Expr, ename: String, inert: Array[String], fn_names: Array[String]) -> (Bool, String, Int) {
  match expr {
    EHandle(body, arms) => if edp_handle_own_effect_desc(arms) == ename {
      let (_, nm, off) = edp_first_opaque_call_info(body, inert, fn_names)
      (true, nm, off)
    } else {
      edp_live_handle_opaque_info_exprs(expr_children(expr), ename, inert, fn_names)
    },
    _ => edp_live_handle_opaque_info_exprs(expr_children(expr), ename, inert, fn_names)
  }
}

fn edp_live_handle_opaque_info_exprs(es: Array[Expr], ename: String, inert: Array[String], fn_names: Array[String]) -> (Bool, String, Int) {
  let mut i = 0
  let mut found = false
  let mut nm = ""
  let mut off = -1
  while i < Array::length(es) && !found {
    let (f, n, o) = edp_live_handle_opaque_info_expr(Array::get(es, i), ename, inert, fn_names)
    found = f
    nm = n
    off = o
    i = i + 1
  }
  (found, nm, off)
}

/// Stmt-level driver; mirrors edp_first_live_replay_handle's walk order and
/// its dead-`fn` exemption so it lands on the same handle the desc came from.
fn edp_live_handle_opaque_info(stmts: Array[Stmt], keep: Array[Bool], ename: String, inert: Array[String], fn_names: Array[String]) -> (String, Int) {
  let mut i = 0
  let mut found = false
  let mut nm = ""
  let mut off = -1
  while i < Array::length(stmts) && !found {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => {
        let dead_fn = match expr {
          EFn(_, _, _, _, _, _) => if i < Array::length(keep) {
            !Array::get(keep, i)
          } else {
            false
          },
          _ => false
        }
        if dead_fn {
          ()
        } else {
          let (f, n, o) = edp_live_handle_opaque_info_expr(expr, ename, inert, fn_names)
          found = f
          nm = n
          off = o
        }
      },
      SLetMut(_, _, expr) => {
        let (f, n, o) = edp_live_handle_opaque_info_expr(expr, ename, inert, fn_names)
        found = f
        nm = n
        off = o
      },
      SExpr(expr) => {
        let (f, n, o) = edp_live_handle_opaque_info_expr(expr, ename, inert, fn_names)
        found = f
        nm = n
        off = o
      },
      STest(_, expr) => {
        let (f, n, o) = edp_live_handle_opaque_info_expr(expr, ename, inert, fn_names)
        found = f
        nm = n
        off = o
      },
      SBench(_, expr) => {
        let (f, n, o) = edp_live_handle_opaque_info_expr(expr, ename, inert, fn_names)
        found = f
        nm = n
        off = o
      },
      _ => ()
    }
    i = i + 1
  }
  (nm, off)
}

/// A culprit callee that went through edp_alpha_rename_shadowed carries a
/// `__edpsh_<N>_` prefix that exists nowhere in the user's source; report the
/// original spelling (the rename preserves the node's offset, and the binder's
/// source text IS the original name, so the un-mangled spelling and its span
/// both match the file). The CALLER must gate on the rename census — a name
/// the user spelled with this prefix themselves goes through verbatim (Codex
/// review, PR #1594); this helper only does the string surgery.
fn edp_unmangle_shadow_name(nm: String) -> String {
  let prefix = "__edpsh_"
  if String::index_of(nm, prefix) == 0 {
    let rest = String::substring(nm, String::length(prefix), String::length(nm))
    let us = String::index_of(rest, "_")
    if us > 0 {
      String::substring(rest, us + 1, String::length(rest))
    } else {
      nm
    }
  } else {
    nm
  }
}

/// #1591/#1595 follow-up culprit: the live handle's body only calls a named
/// top-level `fn` -- a shape the ineligibility diagnostic's enumeration says
/// is allowed -- but that callee's own body is a bare same-effect `handle`
/// whose handler ARM re-performs the effect. Such a callee is dropped from
/// `needing` (edp_drop_self_discharging_needing) yet NOT call-inert
/// (edp_fn_is_self_discharging_inert rejects it for exactly this arm), so
/// the caller's handle stays ineligible -- and without this scan the error
/// carried no culprit at all (the call is resolvable, so
/// edp_first_opaque_call_info finds nothing). Returns (callee name, source
/// byte offset of the call) or ("", -1). Mirrors
/// edp_live_handle_opaque_info's walk shape but only needs the first
/// matching call in the first `ename` handle body.
fn edp_dirty_selfdischarge_callee_expr(expr: Expr, ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> (Bool, String, Int) {
  match expr {
    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {
      edp_dirty_selfdischarge_call_in(body, ename, stmts, fn_defs)
    } else {
      edp_dirty_selfdischarge_callee_exprs(expr_children(expr), ename, stmts, fn_defs)
    },
    _ => edp_dirty_selfdischarge_callee_exprs(expr_children(expr), ename, stmts, fn_defs)
  }
}

fn edp_dirty_selfdischarge_callee_exprs(es: Array[Expr], ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> (Bool, String, Int) {
  let mut i = 0
  let mut found = false
  let mut nm = ""
  let mut off = -1
  while i < Array::length(es) && !found {
    let (f, n, o) = edp_dirty_selfdischarge_callee_expr(Array::get(es, i), ename, stmts, fn_defs)
    found = f
    nm = n
    off = o
    i = i + 1
  }
  (found, nm, off)
}

/// Inside an `ename` handle's BODY: the first call to a top-level fn whose
/// own body is a bare same-effect handle with an arm that re-performs.
fn edp_dirty_selfdischarge_call_in(expr: Expr, ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> (Bool, String, Int) {
  match expr {
    ECall(callee, args, off) => match callee {
      EIdent(nm, ioff) => if edp_callee_is_dirty_selfdischarge(nm, ename, stmts, fn_defs) {
        (true, nm, if ioff >= 0 {
          ioff
        } else {
          off
        })
      } else {
        edp_dirty_selfdischarge_call_in_exprs(args, ename, stmts, fn_defs)
      },
      _ => edp_dirty_selfdischarge_call_in_exprs(expr_children(expr), ename, stmts, fn_defs)
    },
    _ => edp_dirty_selfdischarge_call_in_exprs(expr_children(expr), ename, stmts, fn_defs)
  }
}

fn edp_dirty_selfdischarge_call_in_exprs(es: Array[Expr], ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> (Bool, String, Int) {
  let mut i = 0
  let mut found = false
  let mut nm = ""
  let mut off = -1
  while i < Array::length(es) && !found {
    let (f, n, o) = edp_dirty_selfdischarge_call_in(Array::get(es, i), ename, stmts, fn_defs)
    found = f
    nm = n
    off = o
    i = i + 1
  }
  (found, nm, off)
}

fn edp_callee_is_dirty_selfdischarge(nm: String, ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Bool {
  match edp_find_fn_body(stmts, fn_defs, nm) {
    Some(body) => match body {
      EHandle(_, arms) => if edp_handle_matches_effect(arms, ename) {
        let mut dirty = false
        let mut ai = 0
        while ai < Array::length(arms) {
          let (_, ab) = Array::get(arms, ai)
          if edp_performs_user_effect_expr(ab, ename) {
            dirty = true
          } else {
            ()
          }
          ai = ai + 1
        }
        dirty
      } else {
        false
      },
      _ => false
    },
    None => false
  }
}

/// Stmt-level driver for the dirty self-discharge culprit; same walk order
/// and dead-`fn` exemption as edp_live_handle_opaque_info.
fn edp_live_handle_dirty_selfdischarge(stmts: Array[Stmt], keep: Array[Bool], ename: String, fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> (String, Int) {
  let mut i = 0
  let mut found = false
  let mut nm = ""
  let mut off = -1
  while i < Array::length(stmts) && !found {
    let expr_opt = match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => {
        let dead_fn = match expr {
          EFn(_, _, _, _, _, _) => if i < Array::length(keep) {
            !Array::get(keep, i)
          } else {
            false
          },
          _ => false
        }
        if dead_fn {
          None
        } else {
          Some(expr)
        }
      },
      SLetMut(_, _, expr) => Some(expr),
      SExpr(expr) => Some(expr),
      STest(_, expr) => Some(expr),
      SBench(_, expr) => Some(expr),
      _ => None
    }
    match expr_opt {
      Some(expr) => {
        let (f, n, o) = edp_dirty_selfdischarge_callee_expr(expr, ename, stmts, fn_defs)
        found = f
        nm = n
        off = o
      },
      None => ()
    }
    i = i + 1
  }
  (nm, off)
}

/// Drop any `needing` name whose OWN top-level definition `keep` (from
/// `dce_keep_flags`, computed against the real entry point) marks
/// unreachable -- a needing function that can never actually run at runtime
/// can never need the evidence dict at runtime either, so excluding it from
/// `needing` changes nothing observable, REGARDLESS of whether its body
/// would otherwise have been judged "safe" by edp_has_unsafe_construct.
///
/// Why this can never cause a silent miscompile even if `keep`'s
/// reachability analysis is ever imprecise: `keep` is used ONLY to shrink
/// `needing` here, never to delete anything from `stmts` (dce_stmts itself
/// is not called). If `keep` ever under-approximates unreachability (wrongly
/// calls something dead that's actually still called somewhere), the
/// excluded function's own body -- if it directly performs the migrated
/// effect -- is simply left un-rewritten. That still-literal `perform` node
/// then hits exactly the same fallback every genuinely-ineligible perform
/// already hits today: the linear backend's pre-existing replay codegen
/// (still correct, just not the fast evidence-dict path), or the gc
/// backend's pre-existing "unsupported perform" hard compile error (loud,
/// not silent). Both are the SAME failure modes this pass already produces
/// for any effect it declines to migrate -- this filter can only ever
/// recover eligibility that dead code would otherwise block, never regress
/// a case that worked before it existed.
fn edp_drop_unreachable_needing(needing: Array[String], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], keep: Array[Bool]) -> Array[String] {
  let out = array_empty()
  let mut ni = 0
  while ni < Array::length(needing) {
    let nm = Array::get(needing, ni)
    if edp_needing_name_reachable(nm, fn_defs, keep) {
      Array::push(out, nm)
    } else {
      ()
    }
    ni = ni + 1
  }
  out
}

/// Local copy of dlh_strip_tilde (desugar_trait_dict.vibe) -- see
/// edp_pat_binds' own doc comment just below for why this file keeps local
/// copies rather than adding new cross-file callers.
fn edp_strip_tilde(n: String) -> String {
  let ln = String::length(n)
  if ln > 0 && n[ln - 1: ln] == "~" {
    n[0: ln - 1]
  } else {
    n
  }
}

/// Local copy of a pattern's bound names (mirrors dlh_pat_binds in
/// desugar_trait_dict.vibe -- kept as a separate local copy rather than a
/// cross-file import to avoid the bootstrap flatten gotcha documented
/// elsewhere in this file: a brand-new cross-file export + its first
/// cross-file caller in the SAME commit gets silently dropped by the
/// merge/flatten tool).
fn edp_pat_binds(p: Pat, out: Array[String]) -> Unit {
  match p {
    PBind(n) => Array::push(out, n),
    PCtor(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        edp_pat_binds(Array::get(args, i), out)
        i = i + 1
      }
    },
    PTuple(ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        edp_pat_binds(Array::get(ps, i), out)
        i = i + 1
      }
    },
    POr(a, b) => {
      edp_pat_binds(a, out)
      edp_pat_binds(b, out)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        edp_pat_binds(fp, out)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// Does `expr` bind (shadow) `name` anywhere within it? Full-coverage
/// traversal mirroring edp_rewrite_needing_body's own node coverage, plus
/// match/handle arm pattern binders (which edp_rewrite_needing_body itself
/// doesn't need to examine, but shadow detection does). See
/// edp_drop_shadowed_needing's own doc comment for why this exists.
fn edp_expr_binds_name(expr: Expr, name: String) -> Bool {
  match expr {
    EFn(_, _, params, _, _, body) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(params) && !found {
        let (pn, _) = Array::get(params, i)
        if edp_strip_tilde(pn) == name {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found || edp_expr_binds_name(body, name)
    },
    EHandle(body, arms) => {
      let mut i = 0
      let mut found = edp_expr_binds_name(body, name)
      while i < Array::length(arms) && !found {
        let (p, ex) = Array::get(arms, i)
        let bound = array_empty()
        edp_pat_binds(p, bound)
        if edp_str_array_contains(bound, name) || edp_expr_binds_name(ex, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EIf(c, t, e2) => edp_expr_binds_name(c, name) || edp_expr_binds_name(t, name) || edp_expr_binds_name(e2, name),
    EMatch(s, arms) => {
      let mut i = 0
      let mut found = edp_expr_binds_name(s, name)
      while i < Array::length(arms) && !found {
        let (p, ex) = Array::get(arms, i)
        let bound = array_empty()
        edp_pat_binds(p, bound)
        if edp_str_array_contains(bound, name) || edp_expr_binds_name(ex, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EWhile(c, b) => edp_expr_binds_name(c, name) || edp_expr_binds_name(b, name),
    EForIn(n, idx, it, b) => {
      let idx_hit = match idx {
        Some(i2) => i2 == name,
        None => false
      }
      n == name || idx_hit || edp_expr_binds_name(it, name) || edp_expr_binds_name(b, name)
    },
    ELoop(pairs, b) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(pairs) && !found {
        let (n, v) = Array::get(pairs, i)
        if n == name || edp_expr_binds_name(v, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found || edp_expr_binds_name(b, name)
    },
    ELet(n, v, b, _) => n == name || edp_expr_binds_name(v, name) || edp_expr_binds_name(b, name),
    ELetMut(n, v, b, _) => n == name || edp_expr_binds_name(v, name) || edp_expr_binds_name(b, name),
    ELetRec(n, v, b) => n == name || edp_expr_binds_name(v, name) || edp_expr_binds_name(b, name),
    ESeq(a, b) => edp_expr_binds_name(a, name) || edp_expr_binds_name(b, name),
    EAssign(_, v, c) => edp_expr_binds_name(v, name) || edp_expr_binds_name(c, name),
    EAssignOp(_, _, v, c) => edp_expr_binds_name(v, name) || edp_expr_binds_name(c, name),
    EReturn(e2) => edp_expr_binds_name(e2, name),
    EDot(o, _, _, _) => edp_expr_binds_name(o, name),
    ECall(callee, args, _) => edp_expr_binds_name(callee, name) || edp_exprs_bind_name(args, name),
    EBinOp(_, l, r) => edp_expr_binds_name(l, name) || edp_expr_binds_name(r, name),
    EUnaryOp(_, e2) => edp_expr_binds_name(e2, name),
    ELabeledArg(_, _, v) => edp_expr_binds_name(v, name),
    EBreak(opt) => match opt {
      Some(e2) => edp_expr_binds_name(e2, name),
      None => false
    },
    EContinue(args) => edp_exprs_bind_name(args, name),
    ETuple(elems) => edp_exprs_bind_name(elems, name),
    EArray(elems) => edp_exprs_bind_name(elems, name),
    ERecord(_, fields, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) && !found {
        let (_, v) = Array::get(fields, i)
        if edp_expr_binds_name(v, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EMap(fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) && !found {
        let (_, v) = Array::get(fields, i)
        if edp_expr_binds_name(v, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ESpread(e2) => edp_expr_binds_name(e2, name),
    _ => false
  }
}

fn edp_exprs_bind_name(es: Array[Expr], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(es) && !found {
    if edp_expr_binds_name(Array::get(es, i), name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Drop any `needing` name that's shadowed ANYWHERE in the program (any
/// nested `let`/`let mut`/`let rec`, EFn parameter, match/handle arm
/// pattern binder, for-loop name, or loop parameter reusing the same
/// identifier as a top-level "needing" function). edp_rewrite_needing_body
/// matches a call's callee by NAME ONLY (`edp_str_array_contains(needing,
/// nm)`, line ~1952) with no scope tracking -- a local binding that
/// shadows a needing function's name would get the evidence-dict argument
/// prepended to ITS calls too, even though the local closure/value was
/// never rewritten to accept that extra parameter, producing an arity
/// mismatch / invalid generated call (#1074 PR review,
/// chatgpt-codex-connector P1: "Respect local shadowing when forwarding
/// evidence"). Deliberately whole-program-conservative rather than
/// precisely scope-threaded, matching edp_drop_self_discharging_needing's
/// own established pattern immediately below: losing eligibility for the
/// rare needing function whose name is ALSO reused as a shadowing binder
/// elsewhere is an acceptable trade for guaranteed correctness.
fn edp_drop_shadowed_needing(needing: Array[String], stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  let mut ni = 0
  while ni < Array::length(needing) {
    let nm = Array::get(needing, ni)
    let mut shadowed = false
    let mut si = 0
    while si < Array::length(stmts) && !shadowed {
      let sv_opt = match Array::get(stmts, si) {
        SLet(_, _, _, _, sv) => Some(sv),
        SLetMut(_, _, sv) => Some(sv),
        SExpr(sv) => Some(sv),
        STest(_, sv) => Some(sv),
        SBench(_, sv) => Some(sv),
        _ => None
      }
      match sv_opt {
        Some(sv) => if edp_expr_binds_name(sv, nm) {
          shadowed = true
        } else {
          ()
        },
        None => ()
      }
      si = si + 1
    }
    if shadowed {
      ()
    } else {
      Array::push(out, nm)
    }
    ni = ni + 1
  }
  out
}

/// Drop any `needing` name whose OWN entire body is BARE `handle {..} with
/// ename {..}` -- e.g. `fixtures/effect_effectset_expansion.vibe`'s `main`,
/// declared `with Ask + Ask::Get` purely to satisfy a checker requirement
/// unrelated to evidence_dict_pass ("a `handle ... with Effect` expression's
/// enclosing declared row must authorize the whole effect name" -- see that
/// fixture's own doc comment), whose body never performs `ename` OUTSIDE the
/// handle it already fully discharges. `edp_needing_names` has no way to see
/// that distinction (it only reads the row string), so such a function was
/// always included in `needing`; `edp_has_unsafe_construct`, entirely
/// correctly for the GENERAL case, then flags a same-effect `EHandle` as
/// unsafe ("nested handling of the SAME effect inside itself is not a shape
/// this pass targets" -- see its own doc comment) -- but here that "nested"
/// handle IS the function's own whole body, not something hidden inside a
/// call chain this pass can't already see. It is ALREADY discovered and
/// rewritten independently via edp_collect_handle_sites/edp_find_rewrite_
/// handles (which scan every EHandle for `ename` in `stmts` directly, not
/// through `needing`), so dropping such a function from `needing` loses
/// nothing -- it never needed the dict passed to IT (nothing in its body
/// can observably require one once its own handle is excluded from
/// consideration), it only ever PROVIDES one for its own nested call(s).
///
/// Deliberately narrow: only the exact bare-EHandle-as-whole-body shape
/// qualifies (no ESeq prefix, no wrapping ELet, etc.) -- anything else keeps
/// the function in `needing` and falls back to the existing (already sound)
/// conservative treatment, exactly as before this change existed.
///
/// #1595: this drop is only HALF of the treatment. Removing the fn from
/// `needing` also removes the membership that made calls TO it safe in
/// edp_has_unsafe_construct, so any row-carrying CALLER of a dropped fn
/// went ineligible and sank the whole effect anyway. The other half is
/// edp_append_self_discharging_row_fns (calls to such a fn are inert,
/// appended into `pure_fns` at every safety-scan construction site) --
/// with the extra arm condition documented on
/// edp_fn_is_self_discharging_inert.
fn edp_drop_self_discharging_needing(needing: Array[String], stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String) -> Array[String] {
  let out = array_empty()
  let mut ni = 0
  while ni < Array::length(needing) {
    let nm = Array::get(needing, ni)
    let drop = match edp_find_fn_body(stmts, fn_defs, nm) {
      Some(body) => edp_body_is_bare_self_discharge(body, ename),
      None => false
    }
    if drop {
      ()
    } else {
      Array::push(out, nm)
    }
    ni = ni + 1
  }
  out
}

fn edp_body_is_bare_self_discharge(body: Expr, ename: String) -> Bool {
  match body {
    EHandle(_, arms) => edp_handle_matches_effect(arms, ename),
    _ => false
  }
}

fn edp_needing_name_reachable(name: String, fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], keep: Array[Bool]) -> Bool {
  let mut fi = 0
  let mut result = true
  let mut found = false
  while fi < Array::length(fn_defs) {
    let (idx, _, _, nm, _, _) = Array::get(fn_defs, fi)
    if nm == name && !found {
      found = true
      result = if idx >= 0 && idx < Array::length(keep) {
        Array::get(keep, idx)
      } else {
        true
      }
    } else {
      ()
    }
    fi = fi + 1
  }
  result
}

/// Decide eligibility for every effect against `stmts` as it is RIGHT NOW
/// (the caller must not have mutated anything yet) and return the plans
/// for the effects that qualify, in effect-declaration order.
///
/// `keep` (2026-07-23): per-stmt-index reachable flags from `dce_keep_flags`
/// (core/dce.vibe), computed by the caller against the SAME `entry_name` the
/// real compile uses. Before the safety scan below, `needing` is filtered
/// down to only the names `keep` marks reachable -- see
/// edp_drop_unreachable_needing's doc comment for why dropping a provably-
/// dead needing function can never cause a silent miscompile, only recover
/// eligibility that a dead function's un-provable body would otherwise sink
/// for the whole effect.
fn edp_plan_migrations(stmts: Array[Stmt], effect_defs: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], keep: Array[Bool], errs: Array[String]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)], Array[String], Array[(Expr, Array[(Pat, Expr)])])] {
  let es_names = array_empty()
  let es_members_list = array_empty()
  edp_es_collect_into(stmts, es_names, es_members_list)
  let plans = array_empty()
  let mut ei = 0
  while ei < Array::length(effect_defs) {
    let (ename, ops) = Array::get(effect_defs, ei)
    let needing_all = edp_needing_names(fn_defs, ename, es_names, es_members_list)
    // Shadowed-name exclusion is ALSO unconditional (#1074 review: a
    // needing function's name shadowed by a local binding elsewhere in
    // the program is never safe to leave in `needing` regardless of
    // dead-code/self-discharge status -- see edp_drop_shadowed_needing's
    // own doc comment), so it applies before the self-discharging filter.
    let needing_unshadowed = edp_drop_shadowed_needing(needing_all, stmts)
    // Self-discharging exclusion is unconditional (a self-discharging
    // function never needs the dict for itself, dead or not -- see
    // edp_drop_self_discharging_needing's doc comment), so it applies to
    // the FULL set before either eligibility attempt below.
    let needing_sd = edp_drop_self_discharging_needing(needing_unshadowed, stmts, fn_defs, ename)
    // ADR-0076 追記34 V2: perform-free exclusion -- a row-E fn that cannot
    // perform E needs no dict and must NOT get one (its call sites may sit
    // outside any handle; see edp_fn_is_perform_free's doc comment). The
    // same predicate feeds the pure_fns appends inside eligibility/apply,
    // so both views classify these names identically.
    let pf_inert = edp_pure_fn_names(fn_defs)
    edp_append_free_host_inert_names(stmts, pf_inert)
    edp_append_self_discharging_row_fns(stmts, fn_defs, ename, pf_inert)
    edp_append_perform_free_row_fns(stmts, fn_defs, ename, pf_inert)
    let needing_full = array_empty()
    let mut pfi = 0
    while pfi < Array::length(needing_sd) {
      let pf_nm = Array::get(needing_sd, pfi)
      if edp_str_array_contains(pf_inert, pf_nm) {
        ()
      } else {
        Array::push(needing_full, pf_nm)
      }
      pfi = pfi + 1
    }
    // #1261: a needing function's VALUE reaching a slot the migration cannot
    // follow would prepend the dict parameter at the definition while the
    // call through that slot stays at the old arity (a wasm signature-
    // mismatch trap, not a diagnosable failure). Eta-expand those values
    // first (edp_etawrap_stmts): the wrapper closes over the evidence and
    // presents the arity the receiving slot expects, which is exactly what
    // writing the rows out by hand achieves. Whatever the wrapping cannot
    // reach is then still an escape, and stays a hard error per ADR-0076
    // 追記34 V2. Both are only relevant while handle sites for E remain:
    // with none, nothing gets migrated in the first place.
    let live_sites = Array::length(needing_full) > 0 && Array::length(edp_collect_handle_sites(stmts, ename)) > 0
    if live_sites {
      edp_etawrap_stmts(stmts, needing_full, ename, fn_defs, es_names, es_members_list)
    } else {
      ()
    }
    let escaped = if live_sites {
      edp_needing_escape_stmts(stmts, needing_full, ename, fn_defs, es_names, es_members_list)
    } else {
      ""
    }
    if escaped != "" {
      Array::push(errs, String::concat(String::concat(String::concat("function `", escaped), String::concat("` carries effect ", ename)), String::concat(String::concat(" and is passed as a VALUE into a slot whose type does not carry that row, so evidence-passing (ADR-0076) cannot reach the call through it (#1261) -- annotate the receiving parameter (and any binding it flows through) with `with ", ename), "`, or call the function directly instead of passing it")))
    } else {
      ()
    }
    match edp_try_plan_for_effect(stmts, ename, ops, needing_full, fn_defs) {
      Some(plan) => if escaped == "" {
        Array::push(plans, plan)
      } else {
        ()
      },
      None => {
        // Fall back to dropping provably-DEAD needing functions and retry
        // ONLY if the full set was ineligible -- trying the full set FIRST
        // (rather than always dropping dead functions up front) matters:
        // an independently-safe dead function (e.g. a hoisted closure
        // whose own body is a bare `perform`, dlh_hoist_expr's row-
        // backfill fix, 2026-07-23) should stay in `needing` and get
        // properly migrated like any other safe function -- gc backend
        // codegen still has to compile it even though it never runs, and
        // a dead-but-still-present un-rewritten `perform` is exactly as
        // fatal there as a live one. Dropping dead functions is only a
        // NET WIN when the full set fails for some OTHER (unsafe, not
        // dead) member -- see edp_drop_unreachable_needing's doc comment
        // for why dropping in that case is always safe.
        let needing_live = edp_drop_unreachable_needing(needing_full, fn_defs, keep)
        let mut planned2 = false
        if Array::length(needing_live) == Array::length(needing_full) {
          ()
        } else {
          match edp_try_plan_for_effect(stmts, ename, ops, needing_live, fn_defs) {
            Some(plan2) => {
              Array::push(plans, plan2)
              planned2 = true
            },
            None => ()
          }
        }
        // ADR-0076 追記34 V1 guard: a program that holds row-E closure
        // VALUES compiles them under the __ev-taking convention, so a
        // failed migration cannot silently fall back to replay (an
        // unmigrated caller would call a migrated closure at the wrong
        // arity). Hard error; the message names the effect.
        if !planned2 {
          let gb = empty_str_array()
          let gl = array_empty()
          edp_row_lit_scan(stmts, ename, needing_full, es_names, es_members_list, gb, gl)
          // Guard scope: only when HANDLE SITES for E remain in the tree.
          // Zero sites means nothing can fall to replay — the suspend
          // lane (ADR-0076 Phase 3a/3b) transforms its handles BEFORE
          // this pass, so a CPS-mode effect's row-E closure values (e.g.
          // spawn_suspend's `f: () -> T with Async + Exception` param)
          // follow the STEP convention and are none of edp's business.
          if Array::length(edp_collect_handle_sites(stmts, ename)) > 0 && (Array::length(gb) > 0 || Array::length(gl) > 0 || edp_any_row_typed_param(stmts, fn_defs, ename, es_names, es_members_list)) {
            // #1347: name the higher-order operation when that is the cause.
            // The generic wording below points at "a handle body, a needing
            // function, or a row-carrying closure literal", none of which the
            // reader can fix for this shape -- the gap is the OPERATION's
            // signature, one level away.
            let ho = edp_higher_order_block_owner(effect_defs, ename)
            if String::length(ho) > 0 {
              Array::push(errs, edp_higher_order_error_msg(ename, ho))
            } else {
              Array::push(errs, String::concat(String::concat("effect ", ename), " has closure values whose row carries it (type-directed evidence, ADR-0076 追記34), but its evidence migration is not fully eligible -- a handle body, a needing function, or a row-carrying closure literal calls something the pass cannot see through; replay fallback is not available for closure-value programs"))
            }
          } else {
            ()
          }
        } else {
          ()
        }
      }
    }
    ei = ei + 1
  }
  plans
}

/// Attempt eligibility for `needing` (already effect-set/self-discharge
/// filtered by the caller) against `stmts` as-is; `Some` iff every needing
/// function AND every handle site is safe.
///
/// An empty `needing` set is no longer an automatic None (#1070 second
/// slice): a SELF-DISCHARGING owner's closure-typed parameter
/// (edp_handle_owner_cps) needs migration even though nothing in the
/// program carries `ename` in a declared row -- the repro's whole point is
/// that `run_with_handler` has no row at all. Migration is still skipped
/// when there is neither a needing function NOR any proven owner param
/// (nothing to gain; matches the old behavior for every previously-planned
/// program exactly).
fn edp_try_plan_for_effect(stmts: Array[Stmt], ename: String, ops: Array[(String, Array[TypeExpr], TypeExpr)], needing: Array[String], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Option[(String, Array[(String, Array[TypeExpr], TypeExpr)], Array[String], Array[(Expr, Array[(Pat, Expr)])])] {
  // ADR-0076 追記31 Vertical C (replay 撤去): a handle site EXISTING is
  // itself worth planning for — a self-discharging dispatcher whose body
  // performs the effect directly (lsp_server.vibe's Lsp handler is the
  // canonical shape: every branch a bare perform, every arm tail-resume)
  // has an empty `needing` set and was invisibly replay-bound before.
  // Eligibility (edp_all_sites_eligible / edp_has_unsafe_construct) still
  // decides migration site-by-site, and zero collected sites still bails
  // (edp_all_sites_eligible returns false on an empty site list).
  let handle_sites = edp_collect_handle_sites(stmts, ename)
  let worth = Array::length(needing) > 0 || Array::length(handle_sites) > 0 || edp_any_handle_owner_cp(stmts, ename, needing, fn_defs)
  if !worth {
    None
  } else {
    if edp_all_sites_eligible(stmts, ename, needing, handle_sites, fn_defs) {
      Some((ename, ops, needing, handle_sites))
    } else {
      None
    }
  }
}

/// Does ANY top-level function have at least one proven self-discharging-
/// owner closure param for `ename`? Read-only pre-scan used solely to
/// decide whether an empty-`needing` effect is still worth planning.
fn edp_any_handle_owner_cp(stmts: Array[Stmt], ename: String, needing: Array[String], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Bool {
  let pure_fns = edp_pure_fn_names(fn_defs)
  edp_append_free_host_inert_names(stmts, pure_fns)
  edp_append_self_discharging_row_fns(stmts, fn_defs, ename, pure_fns)
  edp_append_perform_free_row_fns(stmts, fn_defs, ename, pure_fns)
  let es_names = array_empty()
  let es_members_list = array_empty()
  edp_es_collect_into(stmts, es_names, es_members_list)
  let mut si = 0
  let mut found = false
  while si < Array::length(stmts) && !found {
    match Array::get(stmts, si) {
      SLet(_, _, snm, _, sval) => match sval {
        EFn(_, _, sparams, _, _, sbody) => if Array::length(edp_handle_owner_cps(stmts, snm, sparams, sbody, ename, needing, pure_fns, es_names, es_members_list)) > 0 {
          found = true
        } else {
          ()
        },
        _ => ()
      },
      _ => ()
    }
    si = si + 1
  }
  found
}

/// --- effectset-aware row resolution.
///
/// A needing function's row string (EFn's own `eff` slot, taken verbatim by
/// edp_collect_fn_defs) can be spelled with an `effectset` alias --
/// `with AskAll` where `effectset AskAll = { Ask }` -- instead of the
/// bare effect name. checker_stmt.vibe's own effectset-expansion
/// (es_expand_stmts_effect_rows) deliberately runs on a NON-mutating COPY of
/// `stmts` used only for type-checking (see check_program's comment: "codegen
/// never reads the row's text content") -- the EFn node codegen actually
/// receives keeps the alias UNEXPANDED. That comment's premise no longer
/// holds now that evidence_dict_pass reads row text directly: without this,
/// `AskAll`-declared functions were silently excluded from migration even in
/// the simplest case (an effectset that's just a whole-effect alias),
/// invisibly falling back to the pre-existing replay codegen -- found by
/// writing a small effectset fixture and confirming, via a temporary
/// migration-plan probe, that no plan was produced for it at all, THEN
/// tracing why (edp_needing_names' string match against the still-literal
/// "AskAll" label never matches a bare "Ask" query) rather than assuming.
///
/// Fixed the same way wit_gen.vibe/contract.vibe/checker_stmt.vibe each
/// already fix the identical problem for their own consumers: a small LOCAL
/// copy of the ES-table/cycle-safe-expansion shape (no new cross-file
/// reference -- see docs/effectset.md's bootstrap gotcha), re-run here on
/// `stmts` as evidence_dict_pass actually receives them. Resolving down to
/// EFFECT-name granularity (not operation-level) is enough for this pass's
/// purposes even for an operation-level effectset (`effectset Env::Read = {
/// Env::get, ...}`): the dict struct this pass builds always has one field
/// per operation the EFFECT declares (edp_make_dict_struct_stmt, from
/// effect_defs) and a handle site's arms already provide real closures for
/// every operation regardless of which subset a caller's row happened to
/// mention, so "does this row require effect X at all" is exactly the
/// question edp_needing_names needs answered, whether the original
/// declaration enumerated operations, named an effectset, or wrote the bare
/// effect name.
fn edp_es_collect_into(stmts: Array[Stmt], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEffectSet(_, esname, esmembers) => {
        Array::push(es_names, esname)
        Array::push(es_members_list, esmembers)
      },
      _ => ()
    }
    i = i + 1
  }
}

fn edp_es_expand_into(es_names: Array[String], es_members_list: Array[Array[String]], name: String, path: Array[String], out: Array[String]) -> Unit {
  if edp_str_array_contains(path, name) {
    ()
  } else {
    let idx = edp_str_array_index_of(es_names, name)
    if idx < 0 {
      if edp_str_array_contains(out, name) {
        ()
      } else {
        Array::push(out, name)
      }
    } else {
      Array::push(path, name)
      let members = Array::get(es_members_list, idx)
      let mut mi = 0
      while mi < Array::length(members) {
        edp_es_expand_into(es_names, es_members_list, Array::get(members, mi), path, out)
        mi = mi + 1
      }
      Array::truncate(path, Array::length(path) - 1)
    }
  }
}

/// Strip a qualified operation label (`Ask::Get`) down to its effect prefix
/// (`Ask`); a bare label (already an effect name, or a row-variable label
/// this pass doesn't recognize either way) passes through unchanged.
/// #1340 (ADR-0071): a generic instantiation label (`State[Int]`) strips to
/// its base effect name too — codegen identifies an algebraic effect by
/// NAME at runtime; the instantiation is type-level only, so every row
/// consumer in this pass (migration eligibility, CPS row scans) must see
/// `State`, not `State[Int]`.
fn edp_effect_name_of(label: String) -> String {
  let bidx = String::index_of(label, "[")
  let base = if bidx > 0 {
    String::substring(label, 0, bidx)
  } else {
    label
  }
  let idx = String::index_of(base, "::")
  if idx > 0 {
    String::substring(base, 0, idx)
  } else {
    base
  }
}

/// Resolve one raw row-item label to the underlying effect NAME(s) it
/// requires: expand it first if it's a known effectset (pushing each
/// expanded leaf's effect prefix), or just push its own effect prefix
/// directly otherwise. Appends into `out` (deduped by the caller).
fn edp_resolve_effect_names_into(label: String, es_names: Array[String], es_members_list: Array[Array[String]], out: Array[String]) -> Unit {
  if edp_str_array_contains(es_names, label) {
    let leaves = array_empty()
    edp_es_expand_into(es_names, es_members_list, label, array_empty(), leaves)
    let mut li = 0
    while li < Array::length(leaves) {
      let ename = edp_effect_name_of(Array::get(leaves, li))
      if edp_str_array_contains(out, ename) {
        ()
      } else {
        Array::push(out, ename)
      }
      li = li + 1
    }
  } else {
    let ename = edp_effect_name_of(label)
    if edp_str_array_contains(out, ename) {
      ()
    } else {
      Array::push(out, ename)
    }
  }
}

fn edp_str_array_index_of(arr: Array[String], v: String) -> Int {
  let mut i = 0
  let mut found = -1
  while i < Array::length(arr) {
    if Array::get(arr, i) == v {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

// --- collection.

/// ADR-0076 追記34 V2: dedup by NAME. The merge lane can pull the same
/// effect-declaring file in twice under two import spellings (lib/@vibe/fs's
/// fs_effect.vibe reaches index_import_test both through the package index
/// and through a direct `./fs_effect.vibe` import), leaving two identical
/// `SEffectDef`s in the merged program. Planning the same label twice made
/// edp_apply_migration run twice, double-prepending the dict parameter on
/// every needing definition while handle-site calls (consumed by the first
/// application) carried it once -- an arity-broken invalid module ("not
/// enough arguments on the stack", found live on index_import_test the
/// moment test-block handles joined migration). Harmless pre-V2 only
/// because zero collected handle sites meant the duplicated label never
/// got a plan at all.
fn edp_collect_effect_defs(stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {
  let out = array_empty()
  let seen = empty_str_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEffectDef(_, name, _, ops) => if edp_str_array_contains(seen, name) {
        ()
      } else {
        Array::push(seen, name)
        Array::push(out, (name, ops))
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// (stmt index, exported, is_rec, name, top-level type annotation, declared
/// effect row string ("" for none) -- taken directly from the EFn's own
/// `eff` slot, the same field #942/the checker already validate).
fn edp_collect_fn_defs(stmts: Array[Stmt]) -> Array[(Int, Bool, Bool, String, Option[TypeExpr], String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exported, is_rec, name, ty, expr) => match expr {
        EFn(_, _, _, _, eff, _) => {
          let row = match eff {
            Some(s) => s,
            None => ""
          }
          Array::push(out, (i, exported, is_rec, name, ty, row))
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Row CONTAINMENT: a function whose row is several comma-joined effect
/// names (e.g. "Ask, Fs") qualifies for EACH effect's migration
/// independently, alongside a bare exact-match row. A row-variable label is
/// still excluded (containment only matches literal effect names present in
/// the row string).
///
/// This relaxation was tried and reverted TWICE on 2026-07-23 before being
/// shipped for real: both rounds crashed on
/// fixtures/effect_handle_multi_effect_row_fallback.vibe with an uncaught
/// exception, and two rounds of code-reading-only diagnosis (an EDot
/// artifact from one effect's own rewrite tripping a later effect's
/// eligibility re-scan; a needing function's body being directly another
/// effect's own `EHandle`) both turned out to be real but NOT the actual
/// cause once retested. Runtime instrumentation (temporarily exporting
/// every per-effect wasm exception tag by name, so an uncaught exception's
/// tag could be decoded from outside the module) finally isolated the true
/// cause: it had nothing to do with multi-effect rows at all.
/// edp_rewrite_needing_body's traversal was missing several positions
/// edp_has_unsafe_construct (its own eligibility check) already covered --
/// most simply, a `perform` bound via `let` rather than written as a bare
/// tail expression -- so a migrated function's own perform could pass
/// eligibility but be silently left un-rewritten, orphaning it once the
/// migration also dropped its handle site's `EHandle`. That bug (fixed
/// separately, see edp_rewrite_needing_body's doc comment) is what both
/// crashes actually were; `both_helper` in the multi-effect fixture happens
/// to bind both of its performs via `let`, so containment relaxation merely
/// exercised it via a different code path than the single-effect fixtures
/// that found and fixed it directly.
///
/// With that fixed, re-testing the SAME multi-effect fixture under
/// containment (2026-07-23, round 3) -- confirmed via a temporary
/// migration-plan probe that `Ask`'s plan really is produced and applied,
/// not merely "coincidentally not crashing" -- compiles, self-hosts
/// (stage2==stage3), and runs to the SAME stable value the pre-Phase-3
/// replay fallback already produced (3018): `both_helper` needs `{Ask,
/// Fs}`; `Ask`'s migration succeeds (its only needing function and handle
/// site are both clean); `Fs`'s is correctly rejected on its own terms
/// because `ask_only_wrapper` (needing `Fs`) has a body that is directly
/// `handle {...} with Ask {...}` -- a genuine, deliberate
/// `edp_has_unsafe_construct` rejection (nested EHandle), independent of
/// this bug and independent of containment. `Ask` migrating to evidence-
/// dict while `Fs` stays on replay is safe: the two effects use disjoint
/// per-tag memory regions and neither codegen path depends on the other's
/// presence, so a needing function may freely have SOME of its performs
/// migrated and others still raw (edp_qname_is_for_effect already ensures
/// `edp_rewrite_needing_body` only ever touches performs for the effect
/// currently being migrated).
///
/// Follow-up (2026-07-23, same day): the directly-nested-handle scope
/// boundary noted above ("only the innermost effect of a nested handle
/// pair can migrate") is now also resolved -- edp_has_unsafe_construct
/// recurses into a nested EHandle for a DIFFERENT effect instead of
/// rejecting it outright, so BOTH effects of a `handle ... with A { handle
/// ... with B {...} }` nest (or the equivalent wrapper-function split this
/// fixture's own `ask_only_wrapper` uses) can migrate independently. See
/// edp_has_unsafe_construct's doc comment for that change, and fixtures/
/// effect_handle_multi_effect_nested_handles.vibe for a minimal regression
/// lock without the wrapper-function indirection. This fixture
/// (effect_handle_multi_effect_row_fallback.vibe) was updated accordingly:
/// `Fs` now migrates too (verified via the same migration-plan-probe
/// technique, not just "doesn't crash"), and its pinned value changed from
/// 3018 (the replay-inflated value, `Fs`'s handler body replaying an extra
/// time each pass) to 2017 (the semantically-ideal value once neither
/// effect duplicates any surrounding side effect) -- itself confirming
/// this is a genuine correctness improvement, not merely broader coverage.
/// Effectset-aware: `row` is comma-split, each item resolved to its
/// underlying effect name(s) via edp_resolve_effect_names_into (a no-op
/// pass-through for an already-bare effect name -- see that function's doc
/// comment, and edp_es_collect_into's for why this needs its own effectset
/// tables rather than trusting the row string to already be expanded).
/// `ename` qualifies if it appears in ANY item's resolved set.
fn edp_row_is_exactly(row: String, ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  if row == ename {
    true
  } else {
    let parts = String::split(row, ",")
    let mut i = 0
    let mut found = false
    while i < Array::length(parts) {
      let label = String::trim(Array::get(parts, i))
      let resolved = array_empty()
      edp_resolve_effect_names_into(label, es_names, es_members_list, resolved)
      if edp_str_array_contains(resolved, ename) {
        found = true
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

fn edp_needing_names(fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(fn_defs) {
    let (_, _, _, name, _, row) = Array::get(fn_defs, i)
    if edp_row_is_exactly(row, ename, es_names, es_members_list) {
      Array::push(out, name)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn edp_str_array_contains(arr: Array[String], v: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == v {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

// --- naming.

fn edp_dict_struct_name(ename: String) -> String {
  String::concat("__EvDict_", ename)
}

fn edp_dict_param_name(ename: String) -> String {
  String::concat("__ev_", ename)
}

fn edp_strip_effect_prefix(qname: String, ename: String) -> String {
  let prefix = String::concat(ename, "::")
  let plen = String::length(prefix)
  if String::length(qname) > plen && String::substring(qname, 0, plen) == prefix {
    String::substring(qname, plen, String::length(qname))
  } else {
    qname
  }
}

fn edp_struct_decl_exists(stmts: Array[Stmt], sname: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, n, _, _, _, _) => if n == sname {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn edp_make_dict_struct_stmt(ename: String, ops: Array[(String, Array[TypeExpr], TypeExpr)]) -> Stmt {
  let fields = array_empty()
  let mut i = 0
  while i < Array::length(ops) {
    let (opname, params, ret) = Array::get(ops, i)
    Array::push(fields, (opname, TyFn(params, ret, None)))
    i = i + 1
  }
  SStruct(false, edp_dict_struct_name(ename), fields, empty_str_array(), empty_str_array(), empty_str_array())
}

fn empty_str_array() -> Array[String] {
  array_empty()
}

/// --- eligibility: the same conservative-bail-out shape as
/// inline_direct_perform.vibe's idp_has_unsafe_construct, plus several
/// relaxations: a call to a name in `needing` is safe (that callee's own
/// body is scanned the same way as part of this same migration attempt); a
/// nested `EHandle` for a DIFFERENT effect than the one currently being
/// checked (`ename`) is safe to look inside rather than an automatic
/// rejection; and a call to a function the checker has ALREADY proven pure
/// (`pure_fns`, see edp_pure_fn_names) is safe regardless of whether it
/// happens to be hand-listed as a builtin -- see below.
///
/// Branching constructs (EIf/EMatch/EWhile/EForIn/ELoop) ARE recursed into
/// (not unconditionally unsafe): a needing-function call nested inside one
/// used to compile to invalid wasm, but that was root-caused (docs/effect-
/// evidence-passing.md "追記 6") to a since-fixed handle-site rewrite bug
/// (edp_find_rewrite_handles replaced the old collect-then-re-find-by-
/// equality design that silently failed to re-locate branching handle
/// bodies), not anything inherent to branching itself -- see
/// fixtures/effect_handle_call_evidence_branch.vibe for the regression lock
/// on branching being genuinely safe now.
///
/// `EHandle(body, arms)` for effect `ename` itself stays unconditionally
/// unsafe (nested handling of the SAME effect inside itself is not a shape
/// this pass targets). A NESTED handle for a DIFFERENT effect, though, is
/// exactly the "wrapper function discharges one effect, caller discharges
/// another" and "directly-nested `handle A { handle B {...} }`" shapes --
/// recursing into its body (and treating a `resume(...)` call in its own
/// arms as safe, mirroring the "perform"/needing-call special cases; a
/// handler arm's plain `resume` cannot itself hide anything unsafe for a
/// DIFFERENT effect's migration) lets both shapes become eligible. See
/// edp_row_is_exactly's doc comment for the history of the wrapper-function
/// shape; this is the natural follow-up covering direct nesting too.
///
/// A call to a function whose OWN declared effect row is checker-verified
/// empty (`pure_fns`) is safe without even recursing into ITS body: by the
/// checker's own soundness (#942, the same guarantee edp_collect_fn_defs's
/// doc comment cites for the row string itself) a function with no `with`
/// clause cannot perform ANY effect, ever, so it cannot possibly hide a
/// perform of `ename`, a call to a needing function, or anything else this
/// pass would need to rewrite -- generalizing the old hand-audited
/// `edp_pure_builtin_names` allowlist (kept as-is for the handful of
/// builtins the checker doesn't track as ordinary functions) to every
/// user-defined pure function too. Only the call's OWN ARGS still need
/// checking (they're evaluated in the CALLER's context, where a perform of
/// `ename` or a needing-call could legitimately appear).
///
/// edp_rewrite_needing_body/edp_rewrite_handle_body mirror the EHandle/
/// needing-call traversal exactly (see their own doc comments for why the
/// two must always agree, per "追記 10") -- a call to a `pure_fns` member
/// needs NO corresponding rewrite-side change, since it already falls
/// through those functions' existing "recurse into args, leave the call
/// itself unchanged" default case, which is exactly correct here too.
///
/// `EDot(obj, field, ..)` -- a plain `.field` read, NOT a call through it
/// (calling through a field is `ECall(EDot(..), args)`, which the ECall
/// case above still rejects via its `_ => true` fallback for any callee
/// shape besides a bare `EIdent`) -- is safe to recurse into `obj` for
/// rather than reject outright. Unlike the `needing`/`pure_fns` checks,
/// this needs NO type information and carries NO name-shadowing risk: it
/// isn't a name lookup at all, just "does the object expression being
/// read from hide anything unsafe", which the recursive traversal already
/// answers soundly for any `obj` shape. The field name itself is a bare
/// string, not a sub-expression, so there's nothing else to check.
/// edp_rewrite_needing_body/edp_rewrite_handle_body gained a matching
/// `EDot` case (recursing into `obj`, leaving the field name untouched)
/// for the same "the two traversals must agree" reason as everywhere else
/// in this function.
///
/// `EFn(.., body)` -- a closure LITERAL -- now recurses into its own body
/// with the exact same check, instead of being unconditionally unsafe.
/// This is sound for the same structural reason as everywhere else in
/// this function: if the closure's body, scanned by this SAME recursive
/// traversal, contains nothing this pass doesn't already know how to
/// classify (a `perform` of `ename`, a call to a `needing`/`pure_fns`
/// member, or any of the other already-recognized safe shapes), then
/// whatever the closure eventually does when invoked -- once, many times,
/// stored and called later, whatever -- is exactly as well-understood as
/// any other code this pass already rewrites; nothing about closures
/// specifically weakens that. A `perform ename::Op` found inside the
/// closure's body IS rewritten (edp_rewrite_needing_body/edp_rewrite_
/// handle_body gained a matching `EFn` case, recursing into the body the
/// same way), using the closure's LEXICALLY CAPTURED `dict_pname` from
/// its enclosing scope -- an ordinary captured variable reference, no
/// different from any other value a closure captures, valid for as long
/// as the closure itself is (standard closure-capture semantics, entirely
/// orthogonal to anything effect-handling-specific). The closure's own
/// declared effect row (if any) is not consulted here; it's the type
/// checker's own bookkeeping, unrelated to whether this AST-level rewrite
/// can soundly transform the closure's body.
/// ADR-0076 追記34 V2: the traversal is scope-tracked. `ls_names` /
/// `ls_flags` are a parallel-array binding environment (last-wins lookup):
/// flag TRUE means the name is `let`/`let rec`-bound to a closure LITERAL
/// in the current scope -- a call through it is safe, because the
/// literal's own body is scanned by this very traversal at its definition
/// site (any perform inside it is rewritten in place by
/// edp_rewrite_needing_body, with the dict reaching it as an ordinary
/// closure capture). Flag FALSE marks every other binder (params, `let
/// mut`, for/loop/match/arm binders, non-literal lets), and a FALSE hit
/// makes the call UNSAFE even when the name also matches `needing` /
/// `pure_fns` -- a local rebind shadows the top-level meaning, so trusting
/// the global sets there was never sound. Without the TRUE case, ANY
/// local helper closure inside an effectful function sank its whole
/// effect's eligibility -- tolerable when the replay engine existed as a
/// fallback, a language-breaking rejection once it was removed (追記34
/// V2), which is why the scope tracking arrived in the same change that
/// deleted replay.
fn edp_has_unsafe_construct(expr: Expr, needing: Array[String], ename: String, pure_fns: Array[String]) -> Bool {
  edp_has_unsafe_construct_sc(expr, needing, ename, pure_fns, empty_str_array(), edp_empty_bool_array())
}

fn edp_empty_bool_array() -> Array[Bool] {
  let out: Array[Bool] = [
  ]
  out
}

fn edp_expr_is_fn_literal(e: Expr) -> Bool {
  match e {
    EFn(_, _, _, _, _, _) => true,
    _ => false
  }
}

/// Last-wins lookup: 1 = bound to a closure literal (call safe), 0 = bound
/// to anything else (call unsafe), -1 = not locally bound at all.
fn edp_local_safe_lookup(ls_names: Array[String], ls_flags: Array[Bool], name: String) -> Int {
  let mut i = Array::length(ls_names) - 1
  let mut out = -1
  while i >= 0 && out < 0 {
    if Array::get(ls_names, i) == name {
      out = if Array::get(ls_flags, i) {
        1
      } else {
        0
      }
    } else {
      ()
    }
    i = i - 1
  }
  out
}

fn edp_ls_push_pat(p: Pat, ls_names: Array[String], ls_flags: Array[Bool]) -> Unit {
  let names = array_empty()
  edp_pat_binds(p, names)
  let mut i = 0
  while i < Array::length(names) {
    Array::push(ls_names, Array::get(names, i))
    Array::push(ls_flags, false)
    i = i + 1
  }
}

fn edp_has_unsafe_construct_sc(expr: Expr, needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {
  match expr {
    EFn(_, _, params, _, _, body) => {
      let base = Array::length(ls_names)
      let mut pi = 0
      while pi < Array::length(params) {
        let (pn, _) = Array::get(params, pi)
        Array::push(ls_names, edp_strip_tilde(pn))
        Array::push(ls_flags, false)
        pi = pi + 1
      }
      let r = edp_has_unsafe_construct_sc(body, needing, ename, pure_fns, ls_names, ls_flags)
      Array::truncate(ls_names, base)
      Array::truncate(ls_flags, base)
      r
    },
    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {
      true
    } else {
      edp_has_unsafe_construct_sc(body, needing, ename, pure_fns, ls_names, ls_flags) || edp_arms_have_unsafe_construct(arms, needing, ename, pure_fns, ls_names, ls_flags)
    },
    EIf(c, t, e) => edp_has_unsafe_construct_sc(c, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(t, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(e, needing, ename, pure_fns, ls_names, ls_flags),
    EMatch(s, arms) => edp_has_unsafe_construct_sc(s, needing, ename, pure_fns, ls_names, ls_flags) || edp_arms_have_unsafe_construct(arms, needing, ename, pure_fns, ls_names, ls_flags),
    EWhile(c, b) => edp_has_unsafe_construct_sc(c, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(b, needing, ename, pure_fns, ls_names, ls_flags),
    EForIn(n, idx, it, b) => {
      if edp_has_unsafe_construct_sc(it, needing, ename, pure_fns, ls_names, ls_flags) {
        true
      } else {
        let base = Array::length(ls_names)
        Array::push(ls_names, n)
        Array::push(ls_flags, false)
        match idx {
          Some(iname) => {
            Array::push(ls_names, iname)
            Array::push(ls_flags, false)
          },
          None => ()
        }
        let r = edp_has_unsafe_construct_sc(b, needing, ename, pure_fns, ls_names, ls_flags)
        Array::truncate(ls_names, base)
        Array::truncate(ls_flags, base)
        r
      }
    },
    ELoop(pairs, b) => {
      if edp_pairs_have_unsafe_construct(pairs, needing, ename, pure_fns, ls_names, ls_flags) {
        true
      } else {
        let base = Array::length(ls_names)
        let mut li = 0
        while li < Array::length(pairs) {
          let (ln, _) = Array::get(pairs, li)
          Array::push(ls_names, ln)
          Array::push(ls_flags, false)
          li = li + 1
        }
        let r = edp_has_unsafe_construct_sc(b, needing, ename, pure_fns, ls_names, ls_flags)
        Array::truncate(ls_names, base)
        Array::truncate(ls_flags, base)
        r
      }
    },
    ELet(n, v, b, _) => {
      if edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags) {
        true
      } else {
        let base = Array::length(ls_names)
        Array::push(ls_names, n)
        Array::push(ls_flags, edp_expr_is_fn_literal(v))
        let r = edp_has_unsafe_construct_sc(b, needing, ename, pure_fns, ls_names, ls_flags)
        Array::truncate(ls_names, base)
        Array::truncate(ls_flags, base)
        r
      }
    },
    ELetMut(n, v, b, _) => {
      if edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags) {
        true
      } else {
        let base = Array::length(ls_names)
        Array::push(ls_names, n)
        Array::push(ls_flags, false)
        let r = edp_has_unsafe_construct_sc(b, needing, ename, pure_fns, ls_names, ls_flags)
        Array::truncate(ls_names, base)
        Array::truncate(ls_flags, base)
        r
      }
    },
    ELetRec(n, v, b) => {
      let base = Array::length(ls_names)
      Array::push(ls_names, n)
      Array::push(ls_flags, edp_expr_is_fn_literal(v))
      let r = edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(b, needing, ename, pure_fns, ls_names, ls_flags)
      Array::truncate(ls_names, base)
      Array::truncate(ls_flags, base)
      r
    },
    ESeq(a, b) => edp_has_unsafe_construct_sc(a, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(b, needing, ename, pure_fns, ls_names, ls_flags),
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if nm == "perform" && Array::length(args) == 1 {
        edp_perform_operand_has_unsafe_construct(Array::get(args, 0), needing, ename, pure_fns, ls_names, ls_flags)
      } else if nm == "resume" {
        edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns, ls_names, ls_flags)
      } else {
        let local = edp_local_safe_lookup(ls_names, ls_flags, nm)
        if local == 1 {
          edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns, ls_names, ls_flags)
        } else if local == 0 {
          true
        } else if edp_is_pure_builtin_call(nm) {
          edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns, ls_names, ls_flags)
        } else if edp_str_array_contains(needing, nm) {
          edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns, ls_names, ls_flags)
        } else if edp_str_array_contains(pure_fns, nm) {
          edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns, ls_names, ls_flags)
        } else {
          true
        }
      },
      _ => true
    },
    EBinOp(_, l, r) => edp_has_unsafe_construct_sc(l, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(r, needing, ename, pure_fns, ls_names, ls_flags),
    EUnaryOp(_, e2) => edp_has_unsafe_construct_sc(e2, needing, ename, pure_fns, ls_names, ls_flags),
    EAssign(_, v, c) => edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(c, needing, ename, pure_fns, ls_names, ls_flags),
    EAssignOp(_, _, v, c) => edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags) || edp_has_unsafe_construct_sc(c, needing, ename, pure_fns, ls_names, ls_flags),
    EDot(o, _, _, _) => edp_has_unsafe_construct_sc(o, needing, ename, pure_fns, ls_names, ls_flags),
    ELabeledArg(_, _, v) => edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags),
    EReturn(e2) => edp_has_unsafe_construct_sc(e2, needing, ename, pure_fns, ls_names, ls_flags),
    EBreak(opt) => match opt {
      Some(e2) => edp_has_unsafe_construct_sc(e2, needing, ename, pure_fns, ls_names, ls_flags),
      None => false
    },
    EContinue(args) => edp_exprs_have_unsafe_construct(args, needing, ename, pure_fns, ls_names, ls_flags),
    ETuple(elems) => edp_exprs_have_unsafe_construct(elems, needing, ename, pure_fns, ls_names, ls_flags),
    EArray(elems) => edp_exprs_have_unsafe_construct(elems, needing, ename, pure_fns, ls_names, ls_flags),
    ERecord(_, fields, _) => edp_fields_have_unsafe_construct(fields, needing, ename, pure_fns, ls_names, ls_flags),
    EMap(fields) => edp_fields_have_unsafe_construct(fields, needing, ename, pure_fns, ls_names, ls_flags),
    ESpread(e2) => edp_has_unsafe_construct_sc(e2, needing, ename, pure_fns, ls_names, ls_flags),
    // `_ => false` also covers `EStringInterp` -- verified (2026-07-23), not
    // an oversight: `expand_interp_stmts` (entry/source_compile/wasi_only/
    // preprocess_interp.vibe) always fully rewrites every `EStringInterp`
    // into ordinary EBinOp/ECall string-concat nodes BEFORE check_program,
    // itself called before this pass ever runs (see
    // preprocess_compile.vibe's `expand_interp_stmts(stmts); check_program
    // (stmts); ...compile_wasi_module_*_impl(stmts, ...)` ordering, all four
    // entry variants). An `EStringInterp` node containing an embedded
    // `perform` therefore can never actually reach this traversal -- by the
    // time it would, the perform is already an ordinary sub-expression of a
    // string-concat chain, visited through EBinOp/ECall like any other.
    // Checked directly (not assumed) after noticing this pass's own match
    // arms, unlike edp_has_unsafe_construct's sibling in perceus.vibe/
    // common_analysis.vibe/checker_warning.vibe/etc., never explicitly
    // lists `EStringInterp` at all -- worth confirming once rather than
    // leaving it as a plausible-looking gap for a future reader to
    // re-investigate from scratch.
    _ => false
  }
}

/// Mirrors inline_direct_perform.vibe's idp_pure_builtin_names allowlist
/// exactly (same hand-audited, individually-verified set -- see that file's
/// doc comment for the auditing rule).
fn edp_pure_builtin_names() -> Array[String] {
  [
    "String::concat",
    "String::equals",
    "String::length",
    "String::substring",
    "string_char_at",
    "String::trim",
    "String::split",
    "String::contains",
    "String::index_of",
    "String::to_lower",
    "String::to_upper",
    "String::ends_with",
    "String::starts_with",
    "String::char_code_at",
    "String::last_index_of",
    "String::from_char_code",
    "String::join",
    "Char::to_int",
    "Char::from_int",
    "Int::to_double",
    "Int::to_float",
    "Int::to_string",
    "Double::to_int",
    "Float::to_int",
    "Double::to_string",
    "Float::to_string",
    "Double::abs",
    "Double::floor",
    "Double::ceil",
    "Double::max",
    "Double::min",
    "Int::parse",
    "Double::parse",
    // Mirrors idp_pure_builtin_names' own additions (same doc comments,
    // same audits) -- see that function's doc comment for the rationale,
    // including 追記34 V2's `__to_string` (string-interp desugar output)
    // and `not`.
    "__index",
    "Array::get",
    "Map::get",
    "Bytes::get",
    "Array::length",
    "Map::size",
    "Bytes::length",
    "__to_string",
    "not",
    // #1324: desugar_trait_dict's undeterminable-operand helpers -- mirrors
    // idp_pure_builtin_names' entry (same audit, see that list's comment).
    "__generic_add",
    "__generic_rel_diff",
    "str_lex_diff",
    // #1374: the exception-kind side channel's write, emitted before every
    // `throw` -- mirrors idp_pure_builtin_names' entry (same audit).
    "Array::set",
    // ADR-0089 D1 (#1218/#1312): the HOST sleeps. Not effect-free -- `sleep`
    // carries the nominal Async row -- but what this list actually gates is
    // "an opaque callee that cannot PERFORM a user effect and never invokes
    // a function-typed argument", and both qualify (Int -> Unit host
    // calls). Needed because the scoped sleep retarget deliberately leaves
    // the raw builtin in top-level fn bodies when no entry boundary exists
    // (Codex P1 on #1312): an Async-row fn like `fn delay() with Async
    // { sleep(1) }` must classify as PERFORM-FREE (the stat_token
    // precedent, edp_append_perform_free_row_fns) rather than sinking the
    // whole effect's migration to ineligible on an unknown callee -- and
    // the same call must pass scps_calls_ok when such a fn is driven from
    // a suspend-class handle.
    "sleep",
    "sleep_blocking",
    // ADR-0089 D2 (#1218): Future cell primitives -- mirrors
    // idp_pure_builtin_names' entry (same audit, see that list's comment).
    "Future::pending",
    "Future::ready",
    "Future::resolve",
    // ADR-0089 step 4 (#1218): host-future surface + raw halves -- mirrors
    // idp_pure_builtin_names' entry (same audit, see that list's comment).
    "host_future_get",
    "vibe_hf_get_raw",
    "vibe_hf_wait_raw",
    // ADR-0089 (c) (#1218): the NAMED sibling; its per-name raw halves are
    // matched by prefix below (see idp_is_host_future_named_raw's comment).
    "host_future_named",
    // ADR-0089 Decision 3 (#1218): host-stream surface + shared raw read --
    // mirrors idp_pure_builtin_names' entry (same audit, see that list's
    // comment; the per-name `vibe_hs_get_raw$<name>` halves are matched by
    // prefix below).
    "host_stream_named",
    "vibe_hs_close_raw",
    "vibe_hs_read_raw",
    "Stdin::read_via_stream",
    "StdinStream::next",
    "StdinStream::close",
    "vibe_stdin_provider_acquire_raw",
    "vibe_stdin_provider_read_raw",
    "vibe_stdin_provider_close_raw"
  ]
}

fn edp_is_pure_builtin_call(nm: String) -> Bool {
  idp_is_host_future_named_raw(nm) || idp_is_host_stream_named_raw(nm) || edp_str_array_contains(edp_pure_builtin_names(), nm)
}

/// Every top-level function name whose declared effect row is
/// checker-verified empty (`""`, meaning no `with` clause at all -- #942's
/// same guarantee edp_collect_fn_defs's own doc comment cites). See
/// edp_has_unsafe_construct's doc comment for why a call to one of these is
/// always safe to treat as inert.
fn edp_pure_fn_names(fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(fn_defs) {
    let (_, _, _, name, _, row) = Array::get(fn_defs, i)
    if row == "" {
      Array::push(out, name)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// ADR-0076 追記34 V2: raw host-import calls are INERT for eligibility --
/// a host import can neither perform a user effect nor invoke a
/// user-supplied closure, so a call to one hides nothing this pass needs
/// to see. The in-tree convention for direct host wrappers is
/// `vibe_<area>_<op>_raw` (lib/@vibe/http's client side and lib/@vibe/fs's
/// stat_token route around the perform machinery through exactly these --
/// see http.vibe's #794 doc comment); such a name qualifies ONLY when no
/// top-level statement binds it (a same-named user fn resolves to that
/// binding instead and is judged by the ordinary needing/pure rules; a
/// same-named top-level VALUE stays conservatively unsafe). Collected
/// callees are appended into the `pure_fns` ("inert callee") set the
/// safety scans already thread everywhere.
fn edp_name_is_host_raw_shape(nm: String) -> Bool {
  String::starts_with(nm, "vibe_") && String::ends_with(nm, "_raw")
}

/// ADR-0076 追記34 V2: a row-E function that provably cannot PERFORM E --
/// no `perform E::op` anywhere in its body and every call inert (pure
/// builtin / row-free top-level fn / free host-raw name; an unknown,
/// local-value, or needing callee disqualifies) -- needs no evidence dict
/// at runtime, so it is kept OUT of `needing` (edp_plan_migrations) and
/// calls to it are inert (appended into `pure_fns` at every safety-scan
/// construction site). This is what lets a host-discharge wrapper like
/// lib/@vibe/fs's `stat_token` (row Fs, body = one raw host call) keep
/// being invoked NAKED from a test while its perform-based siblings'
/// mock handles migrate the same effect: migrating it would prepend a
/// dict parameter that its uncovered call sites can never supply (arity
/// break at runtime, caught live by index_import_test's stat_token test).
/// Single pass in candidate order, no fixpoint -- a perform-free fn whose
/// only blemish is calling a LATER-listed perform-free sibling stays
/// needing (conservative; both the plan filter and the pure_fns appends
/// iterate the same order over the same base, so their verdicts agree).
fn edp_fn_is_perform_free(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], nm: String, ename: String, base_inert: Array[String]) -> Bool {
  match edp_find_fn_body(stmts, fn_defs, nm) {
    Some(body) => !edp_performs_user_effect_expr(body, ename) && !edp_has_unsafe_construct(body, empty_str_array(), ename, base_inert),
    None => false
  }
}

fn edp_append_perform_free_row_fns(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String, pure_fns: Array[String]) -> Unit {
  let es_names = array_empty()
  let es_members_list = array_empty()
  edp_es_collect_into(stmts, es_names, es_members_list)
  let candidates = edp_needing_names(fn_defs, ename, es_names, es_members_list)
  let mut i = 0
  while i < Array::length(candidates) {
    let nm = Array::get(candidates, i)
    if edp_str_array_contains(pure_fns, nm) {
      ()
    } else if edp_fn_is_perform_free(stmts, fn_defs, nm, ename, pure_fns) {
      Array::push(pure_fns, nm)
    } else {
      ()
    }
    i = i + 1
  }
}

/// #1595: a row-E function whose ENTIRE body is a bare `handle {..} with
/// ename {..}` that its own handler arms cannot leak `ename` out of is
/// inert to CALL, exactly like a perform-free row fn (see
/// edp_fn_is_perform_free above): every perform of `ename` reachable
/// through the call is discharged inside the callee by its own handle
/// (which edp_collect_handle_sites discovers and migrates independently),
/// so nothing about the call needs this pass's attention -- no dict to
/// forward (the callee was dropped from `needing` by
/// edp_drop_self_discharging_needing for the same reason) and no perform
/// that could escape into the caller's context. Without this second half,
/// the drop was self-defeating for any self-discharging fn that had a
/// CALLER carrying the same row: the drop removed the callee from
/// `needing`, which removed the very membership that made calls to it safe
/// in edp_has_unsafe_construct, so the caller went ineligible and sank the
/// whole effect's migration -- #1595's repro (`main` with row
/// `Ask + Ask::Get` calling self-discharging `selfd`) is exactly that.
///
/// The arm condition is what keeps this narrower than the drop itself: an
/// arm CAN legally re-perform `ename` (arms run outside their own handle's
/// coverage, so that perform escapes to the caller), and an arm making a
/// call this pass cannot resolve could hide the same thing. Either
/// disqualifies the fn from call-inertness (its callers then stay
/// ineligible and fail loudly, same as before this change) while the drop
/// still applies. `resume(...)` stays safe -- a resumed continuation
/// re-enters the handled body, which the fn's own handle still covers.
fn edp_fn_is_self_discharging_inert(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], nm: String, ename: String, base_inert: Array[String]) -> Bool {
  match edp_find_fn_body(stmts, fn_defs, nm) {
    Some(body) => match body {
      EHandle(_, arms) => if edp_handle_matches_effect(arms, ename) {
        let mut ok = true
        let mut ai = 0
        while ai < Array::length(arms) {
          let (_, ab) = Array::get(arms, ai)
          if edp_performs_user_effect_expr(ab, ename) || edp_has_unsafe_construct(ab, empty_str_array(), ename, base_inert) {
            ok = false
          } else {
            ()
          }
          ai = ai + 1
        }
        ok
      } else {
        false
      },
      _ => false
    },
    None => false
  }
}

/// #1595: append every self-discharging call-inert row fn (see
/// edp_fn_is_self_discharging_inert) into `pure_fns`, mirroring
/// edp_append_perform_free_row_fns' shape -- called at the SAME
/// construction sites, in the SAME position (after the host-inert append,
/// before the perform-free append, so a caller whose only row-E reach is
/// a call to a self-discharging fn is itself classified perform-free and
/// kept out of `needing` too -- #1595's `main` needs exactly that to keep
/// its entry arity). Single pass, same-order determinism argument as
/// edp_fn_is_perform_free's doc comment.
fn edp_append_self_discharging_row_fns(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String, pure_fns: Array[String]) -> Unit {
  let es_names = array_empty()
  let es_members_list = array_empty()
  edp_es_collect_into(stmts, es_names, es_members_list)
  let candidates = edp_needing_names(fn_defs, ename, es_names, es_members_list)
  let mut i = 0
  while i < Array::length(candidates) {
    let nm = Array::get(candidates, i)
    if edp_str_array_contains(pure_fns, nm) {
      ()
    } else if edp_fn_is_self_discharging_inert(stmts, fn_defs, nm, ename, pure_fns) {
      Array::push(pure_fns, nm)
    } else {
      ()
    }
    i = i + 1
  }
}

fn edp_append_free_host_inert_names(stmts: Array[Stmt], pure_fns: Array[String]) -> Unit {
  let top_names = empty_str_array()
  let mut ti = 0
  while ti < Array::length(stmts) {
    match Array::get(stmts, ti) {
      SLet(_, _, nm, _, _) => Array::push(top_names, nm),
      SLetMut(nm, _, _) => Array::push(top_names, nm),
      _ => ()
    }
    ti = ti + 1
  }
  let found = empty_str_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => edp_collect_host_raw_callees(expr, found),
      SLetMut(_, _, expr) => edp_collect_host_raw_callees(expr, found),
      SExpr(expr) => edp_collect_host_raw_callees(expr, found),
      STest(_, expr) => edp_collect_host_raw_callees(expr, found),
      SBench(_, expr) => edp_collect_host_raw_callees(expr, found),
      _ => ()
    }
    i = i + 1
  }
  let mut fi = 0
  while fi < Array::length(found) {
    let nm = Array::get(found, fi)
    if edp_str_array_contains(top_names, nm) || edp_str_array_contains(pure_fns, nm) {
      ()
    } else {
      Array::push(pure_fns, nm)
    }
    fi = fi + 1
  }
}

fn edp_collect_host_raw_callees(expr: Expr, out: Array[String]) -> Unit {
  match expr {
    ECall(callee, args, _) => {
      match callee {
        EIdent(nm, _) => if edp_name_is_host_raw_shape(nm) && !edp_str_array_contains(out, nm) {
          Array::push(out, nm)
        } else {
          ()
        },
        _ => edp_collect_host_raw_callees(callee, out)
      }
      let mut i = 0
      while i < Array::length(args) {
        edp_collect_host_raw_callees(Array::get(args, i), out)
        i = i + 1
      }
    },
    EFn(_, _, _, _, _, b) => edp_collect_host_raw_callees(b, out),
    EHandle(b, arms) => {
      edp_collect_host_raw_callees(b, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, i)
        edp_collect_host_raw_callees(ex, out)
        i = i + 1
      }
    },
    EIf(c, t, e2) => {
      edp_collect_host_raw_callees(c, out)
      edp_collect_host_raw_callees(t, out)
      edp_collect_host_raw_callees(e2, out)
    },
    EMatch(s, arms) => {
      edp_collect_host_raw_callees(s, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, i)
        edp_collect_host_raw_callees(ex, out)
        i = i + 1
      }
    },
    EWhile(c, b) => {
      edp_collect_host_raw_callees(c, out)
      edp_collect_host_raw_callees(b, out)
    },
    EForIn(_, _, it, b) => {
      edp_collect_host_raw_callees(it, out)
      edp_collect_host_raw_callees(b, out)
    },
    ELoop(pairs, b) => {
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, v) = Array::get(pairs, i)
        edp_collect_host_raw_callees(v, out)
        i = i + 1
      }
      edp_collect_host_raw_callees(b, out)
    },
    ELet(_, v, b, _) => {
      edp_collect_host_raw_callees(v, out)
      edp_collect_host_raw_callees(b, out)
    },
    ELetMut(_, v, b, _) => {
      edp_collect_host_raw_callees(v, out)
      edp_collect_host_raw_callees(b, out)
    },
    ELetRec(_, v, b) => {
      edp_collect_host_raw_callees(v, out)
      edp_collect_host_raw_callees(b, out)
    },
    ESeq(a, b) => {
      edp_collect_host_raw_callees(a, out)
      edp_collect_host_raw_callees(b, out)
    },
    EAssign(_, v, c) => {
      edp_collect_host_raw_callees(v, out)
      edp_collect_host_raw_callees(c, out)
    },
    EAssignOp(_, _, v, c) => {
      edp_collect_host_raw_callees(v, out)
      edp_collect_host_raw_callees(c, out)
    },
    EReturn(e2) => edp_collect_host_raw_callees(e2, out),
    EDot(o, _, _, _) => edp_collect_host_raw_callees(o, out),
    EBinOp(_, l, r) => {
      edp_collect_host_raw_callees(l, out)
      edp_collect_host_raw_callees(r, out)
    },
    EUnaryOp(_, e2) => edp_collect_host_raw_callees(e2, out),
    ELabeledArg(_, _, v) => edp_collect_host_raw_callees(v, out),
    EBreak(opt) => match opt {
      Some(e2) => edp_collect_host_raw_callees(e2, out),
      None => ()
    },
    EContinue(args) => {
      let mut i = 0
      while i < Array::length(args) {
        edp_collect_host_raw_callees(Array::get(args, i), out)
        i = i + 1
      }
    },
    ETuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        edp_collect_host_raw_callees(Array::get(elems, i), out)
        i = i + 1
      }
    },
    EArray(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        edp_collect_host_raw_callees(Array::get(elems, i), out)
        i = i + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        edp_collect_host_raw_callees(v, out)
        i = i + 1
      }
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        edp_collect_host_raw_callees(v, out)
        i = i + 1
      }
    },
    ESpread(e2) => edp_collect_host_raw_callees(e2, out),
    _ => ()
  }
}

fn edp_perform_operand_has_unsafe_construct(operand: Expr, needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {
  match operand {
    EIdent(_, _) => false,
    ECall(op_callee, op_args, _) => match op_callee {
      EIdent(_, _) => edp_exprs_have_unsafe_construct(op_args, needing, ename, pure_fns, ls_names, ls_flags),
      _ => true
    },
    _ => true
  }
}

fn edp_exprs_have_unsafe_construct(exprs: Array[Expr], needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(exprs) {
    if edp_has_unsafe_construct_sc(Array::get(exprs, i), needing, ename, pure_fns, ls_names, ls_flags) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn edp_fields_have_unsafe_construct(fields: Array[(String, Expr)], needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    if edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn edp_pairs_have_unsafe_construct(pairs: Array[(String, Expr)], needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, i)
    if edp_has_unsafe_construct_sc(v, needing, ename, pure_fns, ls_names, ls_flags) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #965-style scope discipline for arm binders: each arm's pattern binds
/// mask any outer local-safe closure binding of the same name for the
/// arm's own body only.
fn edp_arms_have_unsafe_construct(arms: Array[(Pat, Expr)], needing: Array[String], ename: String, pure_fns: Array[String], ls_names: Array[String], ls_flags: Array[Bool]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (p, ex) = Array::get(arms, i)
    let base = Array::length(ls_names)
    edp_ls_push_pat(p, ls_names, ls_flags)
    if edp_has_unsafe_construct_sc(ex, needing, ename, pure_fns, ls_names, ls_flags) {
      found = true
    } else {
      ()
    }
    Array::truncate(ls_names, base)
    Array::truncate(ls_flags, base)
    i = i + 1
  }
  found
}

// --- per-arm preparation (identical shape to inline_direct_perform.vibe).

fn edp_pat_bind_names(pat: Pat) -> Array[String] {
  match pat {
    PCtor(_, subpats) => for p in subpats {
      match p {
        PBind(n) => n,
        _ => "_"
      }
    },
    _ => empty_str_array()
  }
}

fn edp_pat_qname(pat: Pat) -> String {
  match pat {
    PCtor(name, _) => name,
    _ => ""
  }
}

fn edp_strip_tail_resume(expr: Expr) -> Expr {
  match expr {
    EIf(c, t, e) => EIf(c, edp_strip_tail_resume(t), edp_strip_tail_resume(e)),
    EMatch(s, arms) => EMatch(s, edp_strip_tail_resume_arms(arms)),
    ELet(n, v, b, off) => ELet(n, v, edp_strip_tail_resume(b), off),
    ELetMut(n, v, b, off) => ELetMut(n, v, edp_strip_tail_resume(b), off),
    ELetRec(n, v, b) => ELetRec(n, v, edp_strip_tail_resume(b)),
    ESeq(a, b) => ESeq(a, edp_strip_tail_resume(b)),
    EAssign(n, v, c) => EAssign(n, v, edp_strip_tail_resume(c)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, v, edp_strip_tail_resume(c)),
    EReturn(e2) => EReturn(edp_strip_tail_resume(e2)),
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if nm == "resume" && Array::length(args) == 1 {
        Array::get(args, 0)
      } else {
        expr
      },
      _ => expr
    },
    _ => expr
  }
}

fn edp_strip_tail_resume_arms(arms: Array[(Pat, Expr)]) -> Array[(Pat, Expr)] {
  for a in arms {
    let (p, ex) = a
    (p, edp_strip_tail_resume(ex))
  }
}

// --- the migration for one effect.

/// Every top-level `EHandle` (searched via the same whole-program recursive
/// descent as the eligibility/rewrite passes) whose arms discharge `ename`
/// -- identified by the qualified prefix on the first arm's pattern, since a
/// `handle ... with Effect { ... }` block's arms are always all for the same
/// effect (ADR-0050).
/// ADR-0076 追記34 V2: `test`/`bench` blocks and top-level expressions are
/// site-bearing statements too. They were invisible to collection (and to
/// eligibility / apply, which mirror this stmt coverage) for as long as the
/// replay engine silently absorbed their handles; with replay gone they
/// migrate like any SLet body -- and the whole-program claims the closure-
/// param proofs make (edp_own_closure_params: "across every call site in
/// the whole program") now actually see every statement kind.
fn edp_collect_handle_sites(stmts: Array[Stmt], ename: String) -> Array[(Expr, Array[(Pat, Expr)])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => edp_collect_handle_sites_expr(expr, ename, out),
      SLetMut(_, _, expr) => edp_collect_handle_sites_expr(expr, ename, out),
      SExpr(expr) => edp_collect_handle_sites_expr(expr, ename, out),
      STest(_, expr) => edp_collect_handle_sites_expr(expr, ename, out),
      SBench(_, expr) => edp_collect_handle_sites_expr(expr, ename, out),
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Every effect label named by a handle site anywhere in `stmts` (deduped,
/// appended into `out`). `Error` is excluded -- it is the one handler class
/// that still has real codegen (compile_expr_tail6) and must never be
/// erased. Feeds the vacuous-handle elimination candidate list so
/// checker-builtin effect labels (no SEffectDef) are considered too; see
/// evidence_dict_pass's own comment.
fn edp_collect_handle_effect_names(stmts: Array[Stmt], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => edp_collect_handle_effect_names_expr(expr, out),
      SLetMut(_, _, expr) => edp_collect_handle_effect_names_expr(expr, out),
      SExpr(expr) => edp_collect_handle_effect_names_expr(expr, out),
      STest(_, expr) => edp_collect_handle_effect_names_expr(expr, out),
      SBench(_, expr) => edp_collect_handle_effect_names_expr(expr, out),
      _ => ()
    }
    i = i + 1
  }
}

fn edp_collect_handle_effect_names_expr(expr: Expr, out: Array[String]) -> Unit {
  match expr {
    EHandle(body, arms) => {
      if Array::length(arms) > 0 {
        let (p, _) = Array::get(arms, 0)
        let qname = edp_pat_qname(p)
        let (eff_opt, _) = edp_split_qualified(qname)
        match eff_opt {
          Some(e) => if is_exception_effect_name(e) || edp_str_array_contains(out, e) {
            ()
          } else {
            Array::push(out, e)
          },
          None => ()
        }
      } else {
        ()
      }
      edp_collect_handle_effect_names_expr(body, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, i)
        edp_collect_handle_effect_names_expr(ex, out)
        i = i + 1
      }
    },
    EFn(_, _, _, _, _, b) => edp_collect_handle_effect_names_expr(b, out),
    EIf(c, t, e2) => {
      edp_collect_handle_effect_names_expr(c, out)
      edp_collect_handle_effect_names_expr(t, out)
      edp_collect_handle_effect_names_expr(e2, out)
    },
    EMatch(s, arms) => {
      edp_collect_handle_effect_names_expr(s, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, i)
        edp_collect_handle_effect_names_expr(ex, out)
        i = i + 1
      }
    },
    EWhile(c, b) => {
      edp_collect_handle_effect_names_expr(c, out)
      edp_collect_handle_effect_names_expr(b, out)
    },
    EForIn(_, _, it, b) => {
      edp_collect_handle_effect_names_expr(it, out)
      edp_collect_handle_effect_names_expr(b, out)
    },
    ELoop(pairs, b) => {
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, v) = Array::get(pairs, i)
        edp_collect_handle_effect_names_expr(v, out)
        i = i + 1
      }
      edp_collect_handle_effect_names_expr(b, out)
    },
    ELet(_, v, b, _) => {
      edp_collect_handle_effect_names_expr(v, out)
      edp_collect_handle_effect_names_expr(b, out)
    },
    ELetMut(_, v, b, _) => {
      edp_collect_handle_effect_names_expr(v, out)
      edp_collect_handle_effect_names_expr(b, out)
    },
    ELetRec(_, v, b) => {
      edp_collect_handle_effect_names_expr(v, out)
      edp_collect_handle_effect_names_expr(b, out)
    },
    ESeq(a, b) => {
      edp_collect_handle_effect_names_expr(a, out)
      edp_collect_handle_effect_names_expr(b, out)
    },
    EAssign(_, v, c) => {
      edp_collect_handle_effect_names_expr(v, out)
      edp_collect_handle_effect_names_expr(c, out)
    },
    EAssignOp(_, _, v, c) => {
      edp_collect_handle_effect_names_expr(v, out)
      edp_collect_handle_effect_names_expr(c, out)
    },
    EReturn(e2) => edp_collect_handle_effect_names_expr(e2, out),
    EDot(o, _, _, _) => edp_collect_handle_effect_names_expr(o, out),
    ECall(callee, args, _) => {
      edp_collect_handle_effect_names_expr(callee, out)
      let mut i = 0
      while i < Array::length(args) {
        edp_collect_handle_effect_names_expr(Array::get(args, i), out)
        i = i + 1
      }
    },
    EBinOp(_, l, r) => {
      edp_collect_handle_effect_names_expr(l, out)
      edp_collect_handle_effect_names_expr(r, out)
    },
    EUnaryOp(_, e2) => edp_collect_handle_effect_names_expr(e2, out),
    ELabeledArg(_, _, v) => edp_collect_handle_effect_names_expr(v, out),
    EBreak(opt) => match opt {
      Some(e2) => edp_collect_handle_effect_names_expr(e2, out),
      None => ()
    },
    EContinue(args) => {
      let mut i = 0
      while i < Array::length(args) {
        edp_collect_handle_effect_names_expr(Array::get(args, i), out)
        i = i + 1
      }
    },
    ETuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        edp_collect_handle_effect_names_expr(Array::get(elems, i), out)
        i = i + 1
      }
    },
    EArray(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        edp_collect_handle_effect_names_expr(Array::get(elems, i), out)
        i = i + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        edp_collect_handle_effect_names_expr(v, out)
        i = i + 1
      }
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        edp_collect_handle_effect_names_expr(v, out)
        i = i + 1
      }
    },
    ESpread(e2) => edp_collect_handle_effect_names_expr(e2, out),
    _ => ()
  }
}

fn edp_handle_matches_effect(arms: Array[(Pat, Expr)], ename: String) -> Bool {
  if Array::length(arms) == 0 {
    false
  } else {
    let (p, _) = Array::get(arms, 0)
    let qname = edp_pat_qname(p)
    let (eff_opt, _) = edp_split_qualified(qname)
    match eff_opt {
      Some(e) => e == ename,
      None => false
    }
  }
}

fn edp_split_qualified(name: String) -> (Option[String], String) {
  let idx = String::index_of(name, "::")
  if idx > 0 {
    (Some(String::substring(name, 0, idx)), String::substring(name, idx + 2, String::length(name)))
  } else {
    (None, name)
  }
}

fn edp_collect_handle_sites_expr(expr: Expr, ename: String, out: Array[(Expr, Array[(Pat, Expr)])]) -> Unit {
  match expr {
    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {
      Array::push(out, (body, arms))
    } else {
      edp_collect_handle_sites_expr(body, ename, out)
    },
    EFn(_, _, _, _, _, b) => edp_collect_handle_sites_expr(b, ename, out),
    ELet(_, v, b, _) => {
      edp_collect_handle_sites_expr(v, ename, out)
      edp_collect_handle_sites_expr(b, ename, out)
    },
    ELetMut(_, v, b, _) => {
      edp_collect_handle_sites_expr(v, ename, out)
      edp_collect_handle_sites_expr(b, ename, out)
    },
    ELetRec(_, v, b) => {
      edp_collect_handle_sites_expr(v, ename, out)
      edp_collect_handle_sites_expr(b, ename, out)
    },
    ESeq(a, b) => {
      edp_collect_handle_sites_expr(a, ename, out)
      edp_collect_handle_sites_expr(b, ename, out)
    },
    EIf(c, t, e) => {
      edp_collect_handle_sites_expr(c, ename, out)
      edp_collect_handle_sites_expr(t, ename, out)
      edp_collect_handle_sites_expr(e, ename, out)
    },
    EMatch(s, arms) => {
      edp_collect_handle_sites_expr(s, ename, out)
      for a in arms {
        let (_, ex) = a
        edp_collect_handle_sites_expr(ex, ename, out)
      }
    },
    EWhile(c, b) => {
      edp_collect_handle_sites_expr(c, ename, out)
      edp_collect_handle_sites_expr(b, ename, out)
    },
    EForIn(_, _, it, b) => {
      edp_collect_handle_sites_expr(it, ename, out)
      edp_collect_handle_sites_expr(b, ename, out)
    },
    ECall(callee, args, _) => {
      edp_collect_handle_sites_expr(callee, ename, out)
      for a in args {
        edp_collect_handle_sites_expr(a, ename, out)
      }
    },
    EBinOp(_, l, r) => {
      edp_collect_handle_sites_expr(l, ename, out)
      edp_collect_handle_sites_expr(r, ename, out)
    },
    EUnaryOp(_, e2) => edp_collect_handle_sites_expr(e2, ename, out),
    EAssign(_, v, c) => {
      edp_collect_handle_sites_expr(v, ename, out)
      edp_collect_handle_sites_expr(c, ename, out)
    },
    EAssignOp(_, _, v, c) => {
      edp_collect_handle_sites_expr(v, ename, out)
      edp_collect_handle_sites_expr(c, ename, out)
    },
    EDot(o, _, _, _) => edp_collect_handle_sites_expr(o, ename, out),
    ELabeledArg(_, _, v) => edp_collect_handle_sites_expr(v, ename, out),
    EReturn(e2) => edp_collect_handle_sites_expr(e2, ename, out),
    EBreak(opt) => match opt {
      Some(e2) => edp_collect_handle_sites_expr(e2, ename, out),
      None => ()
    },
    EContinue(args) => for a in args {
      edp_collect_handle_sites_expr(a, ename, out)
    },
    ETuple(elems) => for a in elems {
      edp_collect_handle_sites_expr(a, ename, out)
    },
    EArray(elems) => for a in elems {
      edp_collect_handle_sites_expr(a, ename, out)
    },
    ERecord(_, fields, _) => for f in fields {
      let (_, v) = f
      edp_collect_handle_sites_expr(v, ename, out)
    },
    EMap(fields) => for f in fields {
      let (_, v) = f
      edp_collect_handle_sites_expr(v, ename, out)
    },
    ESpread(e2) => edp_collect_handle_sites_expr(e2, ename, out),
    ELoop(pairs, b) => {
      for p in pairs {
        let (_, v) = p
        edp_collect_handle_sites_expr(v, ename, out)
      }
      edp_collect_handle_sites_expr(b, ename, out)
    },
    _ => ()
  }
}

fn edp_all_sites_eligible(stmts: Array[Stmt], ename: String, needing: Array[String], handle_sites: Array[(Expr, Array[(Pat, Expr)])], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Bool {
  if Array::length(handle_sites) == 0 {
    // Nothing discharges `ename` anywhere -- by the checker's own
    // soundness a `needing` function could never actually run, so there is
    // nothing to gain (and nothing unsound about skipping); leave it alone.
    false
  } else {
    let pure_fns = edp_pure_fn_names(fn_defs)
    edp_append_free_host_inert_names(stmts, pure_fns)
    edp_append_self_discharging_row_fns(stmts, fn_defs, ename, pure_fns)
    edp_append_perform_free_row_fns(stmts, fn_defs, ename, pure_fns)
    let es_names = array_empty()
    let es_members_list = array_empty()
    edp_es_collect_into(stmts, es_names, es_members_list)
    // ADR-0076 追記34 V1: type-directed widening. When the program holds
    // row-E closure VALUES, names directly bound to row-E literals are
    // safe callees everywhere (the sweep gives every such literal the
    // __ev_E param), and each fn's own row-E-typed params are safe inside
    // that fn — no call-site proofs. Row-E literal BODIES join the safety
    // check below (each is compiled with the same widened set).
    let td_binds_raw = empty_str_array()
    let td_lits = array_empty()
    edp_row_lit_scan(stmts, ename, needing, es_names, es_members_list, td_binds_raw, td_lits)
    // #1116 Codex P1: drop names that are ALSO bound to a non-evidence
    // value in some other scope — widening those program-wide would
    // rewrite an unrelated same-named call at the wrong arity.
    let td_poison = empty_str_array()
    edp_collect_poison_stmts(stmts, ename, needing, es_names, es_members_list, td_poison)
    let td_binds = edp_filter_unpoisoned(td_binds_raw, td_poison)
    let td_mode = Array::length(td_binds) > 0 || Array::length(td_lits) > 0 || edp_any_row_typed_param(stmts, fn_defs, ename, es_names, es_members_list)
    // Handle sites are checked PER TOP-LEVEL STATEMENT (not from the flat
    // `handle_sites` list, which carries no owner attribution): a site
    // inside a self-discharging owner function may call that owner's own
    // proven-safe closure-typed parameters (#1070 second slice,
    // edp_handle_owner_cps), which extends the safe-call set for exactly
    // that statement's sites and no others -- per-owner scoping matters
    // (#1074 review: name-only matching without scoping is how the
    // shadowing bug happened).
    let mut ok = true
    let mut hsi = 0
    while hsi < Array::length(stmts) {
      // ADR-0076 追記34 V2: non-SLet site-bearing statements (test/bench
      // blocks, top-level exprs, `let mut`) get the base safe-call set --
      // no owner-closure-param extension (that proof is tied to a named
      // fn's own params) and the bare td_binds widening.
      let sval_opt = match Array::get(stmts, hsi) {
        SLet(_, _, _, _, sv) => Some(sv),
        SLetMut(_, _, sv) => Some(sv),
        SExpr(sv) => Some(sv),
        STest(_, sv) => Some(sv),
        SBench(_, sv) => Some(sv),
        _ => None
      }
      match sval_opt {
        Some(sval) => {
          let hext = match Array::get(stmts, hsi) {
            SLet(_, _, snm, _, _) => match sval {
              EFn(_, _, sparams, _, _, sbody) => edp_closure_param_names_only(edp_handle_owner_cps(stmts, snm, sparams, sbody, ename, needing, pure_fns, es_names, es_members_list)),
              _ => empty_str_array()
            },
            _ => empty_str_array()
          }
          let tdext = if td_mode {
            match sval {
              EFn(_, _, sparams2, _, _, _) => Array::concat(td_binds, edp_row_typed_param_names(sparams2, ename, es_names, es_members_list)),
              _ => td_binds
            }
          } else {
            empty_str_array()
          }
          let call_safe_h = Array::concat(Array::concat(needing, hext), tdext)
          let sites = array_empty()
          edp_collect_handle_sites_expr(sval, ename, sites)
          let mut hi = 0
          while hi < Array::length(sites) {
            let (body, _) = Array::get(sites, hi)
            if edp_has_unsafe_construct(body, call_safe_h, ename, pure_fns) {
              ok = false
            } else {
              ()
            }
            hi = hi + 1
          }
        },
        None => ()
      }
      hsi = hsi + 1
    }
    let mut ni = 0
    while ni < Array::length(needing) {
      let nm = Array::get(needing, ni)
      match edp_find_fn_params_and_body(stmts, fn_defs, nm) {
        // #1070 (general case): a call to this function's OWN closure-
        // typed parameter is treated exactly like a call to another
        // needing function (dict forwarding), but ONLY for the specific
        // parameter positions edp_own_closure_params has proven safe
        // across every call site in the whole program -- see that
        // function's own doc comment and edp_apply_migration's mirrored
        // computation (must use the same stmts view; this eligibility
        // check runs strictly before either is mutated for `ename`).
        Some((gparams, b)) => {
          let own_cp = edp_own_closure_params(stmts, nm, gparams, ename, needing, pure_fns, es_names, es_members_list)
          let tdext2 = if td_mode {
            Array::concat(td_binds, edp_row_typed_param_names(gparams, ename, es_names, es_members_list))
          } else {
            empty_str_array()
          }
          let call_safe = Array::concat(Array::concat(needing, edp_closure_param_names_only(own_cp)), tdext2)
          if edp_has_unsafe_construct(b, call_safe, ename, pure_fns) {
            ok = false
          } else {
            ()
          }
        },
        None => {
          ok = false
        }
      }
      ni = ni + 1
    }
    // ADR-0076 追記34 V1: every row-E literal's BODY must be compilable
    // under the same widened set (its own row-E params + the bound names).
    let mut tli = 0
    while tli < Array::length(td_lits) {
      match Array::get(td_lits, tli) {
        EFn(_, _, lparams, _, _, lbody) => {
          let lsafe = Array::concat(Array::concat(needing, td_binds), edp_row_typed_param_names(lparams, ename, es_names, es_members_list))
          if edp_has_unsafe_construct(lbody, lsafe, ename, pure_fns) {
            ok = false
          } else {
            ()
          }
        },
        _ => ()
      }
      tli = tli + 1
    }
    ok
  }
}

fn edp_find_fn_body(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], name: String) -> Option[Expr] {
  let mut i = 0
  let mut result = None
  while i < Array::length(fn_defs) {
    let (idx, _, _, nm, _, _) = Array::get(fn_defs, i)
    if nm == name {
      match Array::get(stmts, idx) {
        SLet(_, _, _, _, EFn(_, _, _, _, _, body)) => {
          result = Some(body)
        },
        _ => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  result
}

// --- #1070 (general case): a needing function calling an opaque
// closure-typed PARAMETER of its own (`f()` where `f: () -> R with
// {ename}`), instead of another named needing function. Static (AST-only)
// analysis can never fully prove what closure VALUE flows into an
// arbitrary parameter, so this is scoped deliberately narrowly and
// conservatively: a parameter position is only ever treated as safe to
// forward the dict through if EVERY call site of the owning function in
// the whole program can be proven, by itself, to pass a migratable
// closure LITERAL at that exact position (edp_closure_param_universally_
// safe) -- any call passing something else (a non-identifier expression,
// a missing argument, or an identifier that isn't a provably single-use,
// row-matching, safe-bodied `let`-bound closure literal) makes the WHOLE
// position ineligible, and the owning function falls back to its
// pre-existing (unsafe -> replay) treatment exactly as before this
// change. This two-sided requirement is essential, not a nicety: if only
// the call site were rewritten (forwarding a dict argument) without the
// actual closure VALUE also being recompiled to accept it, the extra
// argument would land on a closure whose compiled arity doesn't expect
// it -- silently wrong at best, a wrong-arity crash at worst. Provably
// requiring BOTH sides before touching either is what keeps this sound.

/// A parameter's declared type denotes a function whose row is EXACTLY
/// `ename` (same effectset-aware matching edp_needing_names uses for
/// top-level functions, reused here for a parameter's own type instead of
/// a function's declared row).
fn edp_type_is_fn_row_exactly(pty: Option[TypeExpr], ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  match pty {
    Some(t) => match t {
      TyFn(_, _, roweff) => match roweff {
        Some(row) => edp_row_is_exactly(row, ename, es_names, es_members_list),
        None => false
      },
      _ => false
    },
    None => false
  }
}

/// Like edp_find_fn_body but also returns the function's own params (needed
/// to inspect a parameter's declared type, which edp_collect_fn_defs never
/// captures).
fn edp_find_fn_params_and_body(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], name: String) -> Option[(Array[(String, Option[TypeExpr])], Expr)] {
  let mut i = 0
  let mut result = None
  while i < Array::length(fn_defs) {
    let (idx, _, _, nm, _, _) = Array::get(fn_defs, i)
    if nm == name {
      match Array::get(stmts, idx) {
        SLet(_, _, _, _, EFn(_, _, params, _, _, body)) => {
          result = Some((params, body))
        },
        _ => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  result
}

// Is `expr` an EFn literal whose OWN declared row is exactly `ename` and
// whose body contains nothing edp_has_unsafe_construct rejects? This is
// the exact eligibility bar a top-level needing function must also clear
// -- reused here for a LOCAL closure literal considered for the same
// dict-parameter treatment.
// --- ADR-0076 追記34 V1: type-directed closure evidence.
//
// closure-value mode for effect E: the program contains a VALUE of a
// function type whose row carries E — an annotated closure literal
// (`() -> T with E { .. }`) or a fn-typed parameter annotation. In
// this mode migration is TYPE-directed and TOTAL: every row-E literal
// gets the `__ev_E` leading param, every call through a row-E-typed name
// forwards evidence, and a named needing fn used as a value already has
// the same arity after its own rewrite. The same row type always means
// the same arity program-wide, so the #1070-family call-site proofs
// (single-use / universal-call-site / no-value-reference /
// handle-confinement) are unnecessary here — they remain only for
// programs with NO row-E values (mode off), where behavior is unchanged.
// Ineligibility in this mode is a HARD error surfaced through
// evidence_dict_pass's returned error list (never a silent replay
// fallback) — the frontier-deletion prerequisite.

/// #1116 Codex review (P1): the idempotency check must be EFFECT-SPECIFIC.
/// A `with A + B` literal gets `__ev_A` from A's sweep; a blanket
/// `starts_with(p0, "__ev_")` would then make B's sweep skip it, so B's
/// perform escapes after B's handler is removed. Check for THIS effect's
/// dict param by exact name, scanning ALL params (a prior effect's param
/// is prepended AHEAD of this one, so it is not necessarily param 0).
fn edp_params_have_dict(params: Array[(String, Option[TypeExpr])], dict_pname: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(params) {
    let (pn, _) = Array::get(params, i)
    if pn == dict_pname {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn edp_efn_row_carries(expr: Expr, ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  match expr {
    EFn(_, _, params, _, eff, _) => match eff {
      Some(row) => {
        let already = edp_params_have_dict(params, edp_dict_param_name(ename))
        !already && edp_row_is_exactly(row, ename, es_names, es_members_list)
      },
      None => false
    },
    _ => false
  }
}

fn edp_row_typed_param_names(params: Array[(String, Option[TypeExpr])], ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[String] {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(params) {
    let (pn, pty) = Array::get(params, i)
    if edp_type_is_fn_row_exactly(pty, ename, es_names, es_members_list) {
      Array::push(out, edp_strip_tilde(pn))
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// Scan (read-only) for row-E closure literals: `binds` collects names
/// DIRECTLY let/letrec-bound to one (call sites through those names get
/// evidence prepended), `lits` collects every row-E literal expression
/// (each body must pass the safety check; the sweep migrates them all).
/// Top-level `SLet name = <row-E EFn>` is deliberately NOT a bind — that
/// is a needing fn (row containment on its own eff slot) and the needing
/// rewrite owns it.
fn edp_row_lit_scan(stmts: Array[Stmt], ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]], binds: Array[String], lits: Array[Expr]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => match expr {
        EFn(_, _, _, _, _, fb) => edp_row_lit_scan_expr(fb, ename, needing, es_names, es_members_list, binds, lits),
        _ => edp_row_lit_scan_expr(expr, ename, needing, es_names, es_members_list, binds, lits)
      },
      SLetMut(_, _, expr) => edp_row_lit_scan_expr(expr, ename, needing, es_names, es_members_list, binds, lits),
      SExpr(expr) => edp_row_lit_scan_expr(expr, ename, needing, es_names, es_members_list, binds, lits),
      STest(_, expr) => edp_row_lit_scan_expr(expr, ename, needing, es_names, es_members_list, binds, lits),
      SBench(_, expr) => edp_row_lit_scan_expr(expr, ename, needing, es_names, es_members_list, binds, lits),
      _ => ()
    }
    i = i + 1
  }
}

/// #1116 Codex review (P1): `binds` is a program-wide flat name list, so a
/// name bound to a row-E literal in one scope would widen EVERY same-named
/// call — including an unrelated pure `f` bound in another scope, which
/// would be miscompiled to `f(__ev_E)`. Collect POISONED names: any name
/// bound (anywhere, any binder form) to something that is NOT an
/// evidence-taking value for this effect. A name that is both a row-E bind
/// somewhere and poisoned elsewhere is dropped from the widening set —
/// call sites through it then fail eligibility (a hard error, loud) rather
/// than silently mismatching arity. Names bound uniquely to a row-E value
/// (the common shape: `let inner = () -> _ with E {..}`) are never
/// poisoned and stay widened.
fn edp_filter_unpoisoned(binds: Array[String], poison: Array[String]) -> Array[String] {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(binds) {
    let nm = Array::get(binds, i)
    if edp_str_array_contains(poison, nm) || edp_str_array_contains(out, nm) {
      ()
    } else {
      Array::push(out, nm)
    }
    i = i + 1
  }
  out
}

fn edp_collect_poison_stmts(stmts: Array[Stmt], ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]], poison: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      // #1117 Codex P1: the top-level binder NAME must be poisoned too when
      // its value is not evidence-taking. A top-level `let f = <pure>`
      // sharing a name with a nested row-E closure `f` would otherwise keep
      // `f` widened and rewrite the top-level call with an extra evidence
      // arg. A row-E EFn / needing-ref top-level binding stays un-poisoned
      // (it is itself widened via the needing rewrite).
      SLet(_, _, snm, _, expr) => match expr {
        EFn(_, _, params, _, _, fb) => {
          if edp_row_lit_bindable(expr, ename, needing, es_names, es_members_list) {
            ()
          } else {
            edp_poison_add(snm, poison)
          }
          edp_poison_params(params, ename, es_names, es_members_list, poison)
          edp_collect_poison_expr(fb, ename, needing, es_names, es_members_list, poison)
        },
        _ => {
          if edp_row_lit_bindable(expr, ename, needing, es_names, es_members_list) {
            ()
          } else {
            edp_poison_add(snm, poison)
          }
          edp_collect_poison_expr(expr, ename, needing, es_names, es_members_list, poison)
        }
      },
      SLetMut(snm, _, expr) => {
        edp_poison_add(snm, poison)
        edp_collect_poison_expr(expr, ename, needing, es_names, es_members_list, poison)
      },
      SExpr(expr) => edp_collect_poison_expr(expr, ename, needing, es_names, es_members_list, poison),
      STest(_, expr) => edp_collect_poison_expr(expr, ename, needing, es_names, es_members_list, poison),
      SBench(_, expr) => edp_collect_poison_expr(expr, ename, needing, es_names, es_members_list, poison),
      _ => ()
    }
    i = i + 1
  }
}

/// #1117 Codex P2: a parameter whose type is a row-E function is ITSELF
/// evidence-taking (widened by edp_row_typed_param_names), so poisoning it
/// would wrongly drop a legitimately-widened name and hard-error a valid
/// program. Poison only params that will NOT receive this effect's
/// evidence.
fn edp_poison_params(params: Array[(String, Option[TypeExpr])], ename: String, es_names: Array[String], es_members_list: Array[Array[String]], poison: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(params) {
    let (pn, pty) = Array::get(params, i)
    if edp_type_is_fn_row_exactly(pty, ename, es_names, es_members_list) {
      ()
    } else {
      let nm = edp_strip_tilde(pn)
      if edp_str_array_contains(poison, nm) {
        ()
      } else {
        Array::push(poison, nm)
      }
    }
    i = i + 1
  }
}

fn edp_poison_add(nm: String, poison: Array[String]) -> Unit {
  if edp_str_array_contains(poison, nm) {
    ()
  } else {
    Array::push(poison, nm)
  }
}

fn edp_collect_poison_expr(e: Expr, ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]], poison: Array[String]) -> Unit {
  match e {
    ELet(n, v, b, _) => {
      if !edp_row_lit_bindable(v, ename, needing, es_names, es_members_list) {
        edp_poison_add(n, poison)
      } else {
        ()
      }
      edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)
      edp_collect_poison_expr(b, ename, needing, es_names, es_members_list, poison)
    },
    ELetRec(n, v, b) => {
      if !edp_row_lit_bindable(v, ename, needing, es_names, es_members_list) {
        edp_poison_add(n, poison)
      } else {
        ()
      }
      edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)
      edp_collect_poison_expr(b, ename, needing, es_names, es_members_list, poison)
    },
    ELetMut(n, v, b, _) => {
      edp_poison_add(n, poison)
      edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)
      edp_collect_poison_expr(b, ename, needing, es_names, es_members_list, poison)
    },
    EFn(_, _, params, _, _, fb) => {
      edp_poison_params(params, ename, es_names, es_members_list, poison)
      edp_collect_poison_expr(fb, ename, needing, es_names, es_members_list, poison)
    },
    ESeq(a, b) => {
      edp_collect_poison_expr(a, ename, needing, es_names, es_members_list, poison)
      edp_collect_poison_expr(b, ename, needing, es_names, es_members_list, poison)
    },
    EIf(c, t, el) => {
      edp_collect_poison_expr(c, ename, needing, es_names, es_members_list, poison)
      edp_collect_poison_expr(t, ename, needing, es_names, es_members_list, poison)
      edp_collect_poison_expr(el, ename, needing, es_names, es_members_list, poison)
    },
    EMatch(sc, arms) => {
      edp_collect_poison_expr(sc, ename, needing, es_names, es_members_list, poison)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pp, ex) = Array::get(arms, ai)
        edp_poison_pat(pp, poison)
        edp_collect_poison_expr(ex, ename, needing, es_names, es_members_list, poison)
        ai = ai + 1
      }
    },
    EHandle(bd, arms) => {
      edp_collect_poison_expr(bd, ename, needing, es_names, es_members_list, poison)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pp, ex) = Array::get(arms, ai)
        edp_poison_pat(pp, poison)
        edp_collect_poison_expr(ex, ename, needing, es_names, es_members_list, poison)
        ai = ai + 1
      }
    },
    ECall(callee, args, _) => {
      edp_collect_poison_expr(callee, ename, needing, es_names, es_members_list, poison)
      let mut ai = 0
      while ai < Array::length(args) {
        edp_collect_poison_expr(Array::get(args, ai), ename, needing, es_names, es_members_list, poison)
        ai = ai + 1
      }
    },
    EWhile(c, b) => {
      edp_collect_poison_expr(c, ename, needing, es_names, es_members_list, poison)
      edp_collect_poison_expr(b, ename, needing, es_names, es_members_list, poison)
    },
    EForIn(n, idx, it, b) => {
      edp_poison_add(n, poison)
      match idx {
        Some(ix) => edp_poison_add(ix, poison),
        None => ()
      }
      edp_collect_poison_expr(it, ename, needing, es_names, es_members_list, poison)
      edp_collect_poison_expr(b, ename, needing, es_names, es_members_list, poison)
    },
    ELoop(pairs, b) => {
      let mut pi = 0
      while pi < Array::length(pairs) {
        let (n, v) = Array::get(pairs, pi)
        edp_poison_add(n, poison)
        edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)
        pi = pi + 1
      }
      edp_collect_poison_expr(b, ename, needing, es_names, es_members_list, poison)
    },
    EBinOp(_, l, r) => {
      edp_collect_poison_expr(l, ename, needing, es_names, es_members_list, poison)
      edp_collect_poison_expr(r, ename, needing, es_names, es_members_list, poison)
    },
    EUnaryOp(_, x) => edp_collect_poison_expr(x, ename, needing, es_names, es_members_list, poison),
    EAssign(_, v, c) => {
      edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)
      edp_collect_poison_expr(c, ename, needing, es_names, es_members_list, poison)
    },
    EAssignOp(_, _, v, c) => {
      edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)
      edp_collect_poison_expr(c, ename, needing, es_names, es_members_list, poison)
    },
    EReturn(x) => edp_collect_poison_expr(x, ename, needing, es_names, es_members_list, poison),
    EDot(o, _, _, _) => edp_collect_poison_expr(o, ename, needing, es_names, es_members_list, poison),
    ELabeledArg(_, _, v) => edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison),
    EBreak(opt) => match opt {
      Some(x) => edp_collect_poison_expr(x, ename, needing, es_names, es_members_list, poison),
      None => ()
    },
    EContinue(args) => {
      let mut ai = 0
      while ai < Array::length(args) {
        edp_collect_poison_expr(Array::get(args, ai), ename, needing, es_names, es_members_list, poison)
        ai = ai + 1
      }
    },
    ETuple(items) => {
      let mut ai = 0
      while ai < Array::length(items) {
        edp_collect_poison_expr(Array::get(items, ai), ename, needing, es_names, es_members_list, poison)
        ai = ai + 1
      }
    },
    EArray(items) => {
      let mut ai = 0
      while ai < Array::length(items) {
        edp_collect_poison_expr(Array::get(items, ai), ename, needing, es_names, es_members_list, poison)
        ai = ai + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut ai = 0
      while ai < Array::length(fields) {
        let (_, v) = Array::get(fields, ai)
        edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)
        ai = ai + 1
      }
    },
    EMap(fields) => {
      let mut ai = 0
      while ai < Array::length(fields) {
        let (_, v) = Array::get(fields, ai)
        edp_collect_poison_expr(v, ename, needing, es_names, es_members_list, poison)
        ai = ai + 1
      }
    },
    ESpread(x) => edp_collect_poison_expr(x, ename, needing, es_names, es_members_list, poison),
    _ => ()
  }
}

fn edp_poison_pat(p: Pat, poison: Array[String]) -> Unit {
  let names = empty_str_array()
  edp_pat_binds(p, names)
  let mut i = 0
  while i < Array::length(names) {
    edp_poison_add(Array::get(names, i), poison)
    i = i + 1
  }
}

/// A binding counts as evidence-taking when its value is a row-E literal
/// OR a direct value reference to a needing fn (post-migration both have
/// the __ev-leading arity, so calls through the binding prepend evidence).
fn edp_row_lit_bindable(v: Expr, ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  if edp_efn_row_carries(v, ename, es_names, es_members_list) {
    true
  } else {
    match v {
      EIdent(nm, _) => edp_str_array_contains(needing, nm),
      _ => false
    }
  }
}

fn edp_row_lit_scan_expr(e: Expr, ename: String, needing: Array[String], es_names: Array[String], es_members_list: Array[Array[String]], binds: Array[String], lits: Array[Expr]) -> Unit {
  if edp_efn_row_carries(e, ename, es_names, es_members_list) {
    Array::push(lits, e)
  } else {
    ()
  }
  match e {
    ELet(n, v, b, _) => {
      if edp_row_lit_bindable(v, ename, needing, es_names, es_members_list) {
        Array::push(binds, n)
      } else {
        ()
      }
      edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)
      edp_row_lit_scan_expr(b, ename, needing, es_names, es_members_list, binds, lits)
    },
    ELetRec(n, v, b) => {
      if edp_row_lit_bindable(v, ename, needing, es_names, es_members_list) {
        Array::push(binds, n)
      } else {
        ()
      }
      edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)
      edp_row_lit_scan_expr(b, ename, needing, es_names, es_members_list, binds, lits)
    },
    ELetMut(_, v, b, _) => {
      edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)
      edp_row_lit_scan_expr(b, ename, needing, es_names, es_members_list, binds, lits)
    },
    EFn(_, _, _, _, _, fb) => edp_row_lit_scan_expr(fb, ename, needing, es_names, es_members_list, binds, lits),
    ESeq(a, b) => {
      edp_row_lit_scan_expr(a, ename, needing, es_names, es_members_list, binds, lits)
      edp_row_lit_scan_expr(b, ename, needing, es_names, es_members_list, binds, lits)
    },
    EIf(c, t, el) => {
      edp_row_lit_scan_expr(c, ename, needing, es_names, es_members_list, binds, lits)
      edp_row_lit_scan_expr(t, ename, needing, es_names, es_members_list, binds, lits)
      edp_row_lit_scan_expr(el, ename, needing, es_names, es_members_list, binds, lits)
    },
    EMatch(sc, arms) => {
      edp_row_lit_scan_expr(sc, ename, needing, es_names, es_members_list, binds, lits)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, ex) = Array::get(arms, ai)
        edp_row_lit_scan_expr(ex, ename, needing, es_names, es_members_list, binds, lits)
        ai = ai + 1
      }
    },
    EHandle(bd, arms) => {
      edp_row_lit_scan_expr(bd, ename, needing, es_names, es_members_list, binds, lits)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, ex) = Array::get(arms, ai)
        edp_row_lit_scan_expr(ex, ename, needing, es_names, es_members_list, binds, lits)
        ai = ai + 1
      }
    },
    ECall(callee, args, _) => {
      edp_row_lit_scan_expr(callee, ename, needing, es_names, es_members_list, binds, lits)
      let mut ai = 0
      while ai < Array::length(args) {
        edp_row_lit_scan_expr(Array::get(args, ai), ename, needing, es_names, es_members_list, binds, lits)
        ai = ai + 1
      }
    },
    EWhile(c, b) => {
      edp_row_lit_scan_expr(c, ename, needing, es_names, es_members_list, binds, lits)
      edp_row_lit_scan_expr(b, ename, needing, es_names, es_members_list, binds, lits)
    },
    EForIn(_, _, it, b) => {
      edp_row_lit_scan_expr(it, ename, needing, es_names, es_members_list, binds, lits)
      edp_row_lit_scan_expr(b, ename, needing, es_names, es_members_list, binds, lits)
    },
    ELoop(pairs, b) => {
      let mut pi = 0
      while pi < Array::length(pairs) {
        let (_, v) = Array::get(pairs, pi)
        edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)
        pi = pi + 1
      }
      edp_row_lit_scan_expr(b, ename, needing, es_names, es_members_list, binds, lits)
    },
    EBinOp(_, l, r) => {
      edp_row_lit_scan_expr(l, ename, needing, es_names, es_members_list, binds, lits)
      edp_row_lit_scan_expr(r, ename, needing, es_names, es_members_list, binds, lits)
    },
    EUnaryOp(_, x) => edp_row_lit_scan_expr(x, ename, needing, es_names, es_members_list, binds, lits),
    EAssign(_, v, c) => {
      edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)
      edp_row_lit_scan_expr(c, ename, needing, es_names, es_members_list, binds, lits)
    },
    EAssignOp(_, _, v, c) => {
      edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)
      edp_row_lit_scan_expr(c, ename, needing, es_names, es_members_list, binds, lits)
    },
    EReturn(x) => edp_row_lit_scan_expr(x, ename, needing, es_names, es_members_list, binds, lits),
    EDot(o, _, _, _) => edp_row_lit_scan_expr(o, ename, needing, es_names, es_members_list, binds, lits),
    ELabeledArg(_, _, v) => edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits),
    EBreak(opt) => match opt {
      Some(x) => edp_row_lit_scan_expr(x, ename, needing, es_names, es_members_list, binds, lits),
      None => ()
    },
    EContinue(args) => {
      let mut ai = 0
      while ai < Array::length(args) {
        edp_row_lit_scan_expr(Array::get(args, ai), ename, needing, es_names, es_members_list, binds, lits)
        ai = ai + 1
      }
    },
    ETuple(items) => {
      let mut ai = 0
      while ai < Array::length(items) {
        edp_row_lit_scan_expr(Array::get(items, ai), ename, needing, es_names, es_members_list, binds, lits)
        ai = ai + 1
      }
    },
    EArray(items) => {
      let mut ai = 0
      while ai < Array::length(items) {
        edp_row_lit_scan_expr(Array::get(items, ai), ename, needing, es_names, es_members_list, binds, lits)
        ai = ai + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut ai = 0
      while ai < Array::length(fields) {
        let (_, v) = Array::get(fields, ai)
        edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)
        ai = ai + 1
      }
    },
    EMap(fields) => {
      let mut ai = 0
      while ai < Array::length(fields) {
        let (_, v) = Array::get(fields, ai)
        edp_row_lit_scan_expr(v, ename, needing, es_names, es_members_list, binds, lits)
        ai = ai + 1
      }
    },
    ESpread(x) => edp_row_lit_scan_expr(x, ename, needing, es_names, es_members_list, binds, lits),
    _ => ()
  }
}

/// Any top-level fn with a row-E-typed parameter?
fn edp_any_row_typed_param(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(fn_defs) {
    let (idx, _, _, _, _, _) = Array::get(fn_defs, i)
    match Array::get(stmts, idx) {
      SLet(_, _, _, _, EFn(_, _, params, _, _, _)) => if Array::length(edp_row_typed_param_names(params, ename, es_names, es_members_list)) > 0 {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn edp_efn_eligible_for_migration(expr: Expr, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  match expr {
    EFn(_, _, _, _, eff, body) => {
      let row = match eff {
        Some(s) => s,
        None => ""
      }
      edp_row_is_exactly(row, ename, es_names, es_members_list) && !edp_has_unsafe_construct(body, needing, ename, pure_fns)
    },
    _ => false
  }
}

/// Whole-program count of every `EIdent(name)` occurrence -- full coverage
/// mirroring edp_has_unsafe_construct/edp_rewrite_needing_body's own node
/// list (see those functions' doc comments for why missing a position here
/// would be unsafe, not just incomplete: undercounting could make a
/// closure look falsely single-use).
fn edp_count_ident_uses_stmts(stmts: Array[Stmt], name: String) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => {
        total = total + edp_count_ident_uses(expr, name)
      },
      _ => ()
    }
    i = i + 1
  }
  total
}

/// #1261: the parameter list of the top-level function named `nm`, or None
/// when `nm` is not a plain top-level `SLet name = EFn(..)`.
fn edp_params_of_fn(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], nm: String) -> Option[Array[(String, Option[TypeExpr])]] {
  let mut out: Option[Array[(String, Option[TypeExpr])]] = None
  let mut i = 0
  while i < Array::length(fn_defs) {
    let (idx, _, _, name, _, _) = Array::get(fn_defs, i)
    if name == nm {
      match Array::get(stmts, idx) {
        SLet(_, _, _, _, EFn(_, _, params, _, _, _)) => {
          out = Some(params)
        },
        _ => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// #1261: is `nm`'s value legal to hand to parameter `pos` of `callee_nm`?
/// The evidence migration prepends a dict parameter to every needing
/// function, and a call THROUGH a parameter only gets the dict prepended
/// when that parameter's declared type carries the row
/// (edp_row_typed_param_names). So a needing function reaching a row-FREE
/// function-typed slot is compiled at one arity and called at another --
/// wasm's own `null function or function signature mismatch`.
fn edp_arg_slot_accepts_needing(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], callee_nm: String, pos: Int, ename: String, es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  // Deliberately accept unless the slot is PROVEN row-free-and-function-
  // typed: an unknown callee (a local binding aliasing a needing function
  // -- fixtures/effect_local_closure_wrapper_referenced_as_value.vibe), an
  // unannotated parameter, or a non-function annotation all stay legal, so
  // this guard only fires on the shape that demonstrably traps.
  match edp_params_of_fn(stmts, fn_defs, callee_nm) {
    Some(params) => if pos < Array::length(params) {
      let (_, pty) = Array::get(params, pos)
      match pty {
        Some(TyFn(_, _, _)) => edp_type_is_fn_row_exactly(pty, ename, es_names, es_members_list),
        _ => true
      }
    } else {
      true
    },
    None => true
  }
}

/// #1261: the first needing-function name that ESCAPES as a value into a
/// slot the migration cannot reach (see edp_arg_slot_accepts_needing), or
/// "" when every use is a direct call or a row-carrying parameter slot.
///
/// This is the codegen-side backstop for the fact that the checker and this
/// pass classify the SAME closure literal differently: the checker charges a
/// literal's `perform` to the ENCLOSING function and leaves the literal
/// itself row-free, while dlh_hoist_expr backfills the row from the body
/// (追記20) so the hoisted function lands in `needing` here. Nothing on the
/// checker side then rejects handing that value to a row-free `(x) -> y`
/// parameter. Per 追記34 V2, an un-migratable shape is a hard error, never a
/// silent fallback -- the alternative is a runtime trap.
fn edp_needing_escape(e: Expr, needing: Array[String], ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> String {
  match e {
    ECall(callee, args, _) => {
      let callee_nm = match callee {
        EIdent(cn, _) => cn,
        _ => ""
      }
      let mut hit = if callee_nm == "" {
        edp_needing_escape(callee, needing, ename, stmts, fn_defs, es_names, es_members_list)
      } else {
        ""
      }
      let mut i = 0
      while i < Array::length(args) && hit == "" {
        let a = Array::get(args, i)
        let bare = match a {
          EIdent(an, _) => if edp_str_array_contains(needing, an) {
            an
          } else {
            ""
          },
          _ => ""
        }
        if bare == "" {
          hit = edp_needing_escape(a, needing, ename, stmts, fn_defs, es_names, es_members_list)
        } else if callee_nm != "" && edp_arg_slot_accepts_needing(stmts, fn_defs, callee_nm, i, ename, es_names, es_members_list) {
          ()
        } else {
          hit = bare
        }
        i = i + 1
      }
      hit
    },
    EFn(_, _, _, _, _, b) => edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list),
    EHandle(b, arms) => edp_needing_escape_or(edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape_arms(arms, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    EIf(c, t, el) => edp_needing_escape_or(edp_needing_escape(c, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape_or(edp_needing_escape(t, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(el, needing, ename, stmts, fn_defs, es_names, es_members_list))),
    EMatch(s, arms) => edp_needing_escape_or(edp_needing_escape(s, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape_arms(arms, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    EWhile(c, b) => edp_needing_escape_or(edp_needing_escape(c, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    EForIn(_, _, it, b) => edp_needing_escape_or(edp_needing_escape(it, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    ELoop(pairs, b) => edp_needing_escape_or(edp_needing_escape_pairs(pairs, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    ELet(_, v, b, _) => edp_needing_escape_or(edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    ELetMut(_, v, b, _) => edp_needing_escape_or(edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    ELetRec(_, v, b) => edp_needing_escape_or(edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    ESeq(a, b) => edp_needing_escape_or(edp_needing_escape(a, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(b, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    EBinOp(_, l, r) => edp_needing_escape_or(edp_needing_escape(l, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(r, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    EUnaryOp(_, x) => edp_needing_escape(x, needing, ename, stmts, fn_defs, es_names, es_members_list),
    EAssign(_, v, c) => edp_needing_escape_or(edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(c, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    EAssignOp(_, _, v, c) => edp_needing_escape_or(edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list), edp_needing_escape(c, needing, ename, stmts, fn_defs, es_names, es_members_list)),
    EDot(o, _, _, _) => edp_needing_escape(o, needing, ename, stmts, fn_defs, es_names, es_members_list),
    ELabeledArg(_, _, v) => edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list),
    EReturn(x) => edp_needing_escape(x, needing, ename, stmts, fn_defs, es_names, es_members_list),
    EBreak(opt) => match opt {
      Some(x) => edp_needing_escape(x, needing, ename, stmts, fn_defs, es_names, es_members_list),
      None => ""
    },
    EContinue(args) => edp_needing_escape_exprs(args, needing, ename, stmts, fn_defs, es_names, es_members_list),
    ETuple(items) => edp_needing_escape_exprs(items, needing, ename, stmts, fn_defs, es_names, es_members_list),
    EArray(items) => edp_needing_escape_exprs(items, needing, ename, stmts, fn_defs, es_names, es_members_list),
    ERecord(_, fields, _) => edp_needing_escape_pairs(fields, needing, ename, stmts, fn_defs, es_names, es_members_list),
    EMap(fields) => edp_needing_escape_pairs(fields, needing, ename, stmts, fn_defs, es_names, es_members_list),
    ESpread(x) => edp_needing_escape(x, needing, ename, stmts, fn_defs, es_names, es_members_list),
    _ => ""
  }
}

fn edp_needing_escape_or(a: String, b: String) -> String {
  if a == "" {
    b
  } else {
    a
  }
}

fn edp_needing_escape_exprs(es: Array[Expr], needing: Array[String], ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> String {
  let mut hit = ""
  let mut i = 0
  while i < Array::length(es) && hit == "" {
    hit = edp_needing_escape(Array::get(es, i), needing, ename, stmts, fn_defs, es_names, es_members_list)
    i = i + 1
  }
  hit
}

fn edp_needing_escape_pairs(pairs: Array[(String, Expr)], needing: Array[String], ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> String {
  let mut hit = ""
  let mut i = 0
  while i < Array::length(pairs) && hit == "" {
    let (_, v) = Array::get(pairs, i)
    hit = edp_needing_escape(v, needing, ename, stmts, fn_defs, es_names, es_members_list)
    i = i + 1
  }
  hit
}

fn edp_needing_escape_arms(arms: Array[(Pat, Expr)], needing: Array[String], ename: String, stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> String {
  let mut hit = ""
  let mut i = 0
  while i < Array::length(arms) && hit == "" {
    let (_, ex) = Array::get(arms, i)
    hit = edp_needing_escape(ex, needing, ename, stmts, fn_defs, es_names, es_members_list)
    i = i + 1
  }
  hit
}

fn edp_needing_escape_stmts(stmts: Array[Stmt], needing: Array[String], ename: String, fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> String {
  let mut hit = ""
  let mut i = 0
  while i < Array::length(stmts) && hit == "" {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => {
        hit = edp_needing_escape(expr, needing, ename, stmts, fn_defs, es_names, es_members_list)
      },
      SLetMut(_, _, expr) => {
        hit = edp_needing_escape(expr, needing, ename, stmts, fn_defs, es_names, es_members_list)
      },
      SExpr(expr) => {
        hit = edp_needing_escape(expr, needing, ename, stmts, fn_defs, es_names, es_members_list)
      },
      STest(_, expr) => {
        hit = edp_needing_escape(expr, needing, ename, stmts, fn_defs, es_names, es_members_list)
      },
      SBench(_, expr) => {
        hit = edp_needing_escape(expr, needing, ename, stmts, fn_defs, es_names, es_members_list)
      },
      _ => ()
    }
    i = i + 1
  }
  hit
}

/// #1261: the eta-expansion `(__edpw_0, ..) -> nm(__edpw_0, ..)` of needing
/// function `nm`, or None when `nm` has no copyable parameter list.
///
/// This is what lets a needing function's VALUE reach a slot the evidence
/// migration cannot follow. The wrapper is an ordinary closure literal, so
/// the migration's own body rewrites (edp_rewrite_needing_body /
/// edp_rewrite_handle_body, both of which recurse into closure literals)
/// prepend the dict to the call INSIDE it exactly as they would to any other
/// direct call to `nm`. The value that escapes is therefore a plain
/// row-free-arity function that closes over the evidence, and the receiving
/// row-free parameter calls it at the arity it was compiled with.
///
/// The evidence captured is the one in scope where the value escapes, which
/// is the correct one: the checker charges a closure literal's `perform` to
/// the ENCLOSING function, so the handler that discharges it is by
/// construction the one enclosing the escape site.
///
/// Fresh `__edpw_N` parameter names (never the callee's own) keep the
/// wrapper from introducing a binder that shadows a needing function name --
/// edp_alpha_rename_shadowed has already run by the time this synthesizes
/// anything.
fn edp_etawrap_value(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], nm: String) -> Option[Expr] {
  match edp_params_of_fn(stmts, fn_defs, nm) {
    Some(params) => {
      // A labeled parameter cannot be reached by the wrapper's positional
      // forwarding, so those shapes stay un-wrapped (and are reported by
      // edp_needing_escape instead of silently miscompiled).
      let mut plain = true
      let mut ci = 0
      while ci < Array::length(params) {
        let (pn, _) = Array::get(params, ci)
        if String::starts_with(pn, "~") || String::starts_with(pn, "?") {
          plain = false
        } else {
          ()
        }
        ci = ci + 1
      }
      if plain {
        let wparams = array_empty()
        let cargs = array_empty()
        let mut i = 0
        while i < Array::length(params) {
          let wn = String::concat("__edpw_", Int::to_string(i))
          Array::push(wparams, (wn, None))
          Array::push(cargs, EIdent(wn, -1))
          i = i + 1
        }
        Some(EFn(empty_str_array(), array_empty(), wparams, None, None, ECall(EIdent(nm, -1), cargs, -1)))
      } else {
        None
      }
    },
    None => None
  }
}

/// #1261: replace every needing-function VALUE that is about to escape into
/// a slot the migration cannot follow with its eta-expansion
/// (edp_etawrap_value), in place.
///
/// `in_scope` tracks whether this position is one the migration will
/// actually rewrite -- inside a needing function's body, or inside the body
/// of a `handle` for `ename`. Only there does the wrapper's inner call get
/// the dict prepended; wrapping anywhere else would swap one arity mismatch
/// for another, so those positions are left alone for edp_needing_escape to
/// reject. The scope rules mirror the rewrites exactly: both recurse into
/// closure literals, a nested handle for a DIFFERENT effect keeps the
/// current scope for body and arms alike, and a handle for `ename` itself
/// puts only its BODY in scope (its arms are never rewritten by either).
fn edp_etawrap_stmts(stmts: Array[Stmt], needing: Array[String], ename: String, fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {
  let wc = (stmts, fn_defs, es_names, es_members_list)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(ex, isrec, nm, ty, expr) => {
        let scope = edp_str_array_contains(needing, nm)
        Array::set(stmts, i, SLet(ex, isrec, nm, ty, edp_etawrap_expr(expr, scope, needing, ename, wc)))
      },
      SLetMut(nm, ty, expr) => {
        Array::set(stmts, i, SLetMut(nm, ty, edp_etawrap_expr(expr, false, needing, ename, wc)))
      },
      SExpr(expr) => {
        Array::set(stmts, i, SExpr(edp_etawrap_expr(expr, false, needing, ename, wc)))
      },
      STest(nm, expr) => {
        Array::set(stmts, i, STest(nm, edp_etawrap_expr(expr, false, needing, ename, wc)))
      },
      SBench(nm, expr) => {
        Array::set(stmts, i, SBench(nm, edp_etawrap_expr(expr, false, needing, ename, wc)))
      },
      _ => ()
    }
    i = i + 1
  }
}

fn edp_etawrap_expr(e: Expr, in_scope: Bool, needing: Array[String], ename: String, wc: (Array[Stmt], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]])) -> Expr {
  match e {
    ECall(callee, args, off) => {
      let (wstmts, wfn_defs, wes_names, wes_members) = wc
      let callee_nm = match callee {
        EIdent(cn, _) => cn,
        _ => ""
      }
      let new_callee = if callee_nm == "" {
        edp_etawrap_expr(callee, in_scope, needing, ename, wc)
      } else {
        callee
      }
      let new_args = array_empty()
      let mut i = 0
      while i < Array::length(args) {
        let a = Array::get(args, i)
        let bare = match a {
          EIdent(an, _) => if edp_str_array_contains(needing, an) {
            an
          } else {
            ""
          },
          _ => ""
        }
        let wrapped = if bare != "" && in_scope && callee_nm != "" && !edp_arg_slot_accepts_needing(wstmts, wfn_defs, callee_nm, i, ename, wes_names, wes_members) {
          edp_etawrap_value(wstmts, wfn_defs, bare)
        } else {
          None
        }
        match wrapped {
          Some(w) => Array::push(new_args, w),
          None => Array::push(new_args, edp_etawrap_expr(a, in_scope, needing, ename, wc))
        }
        i = i + 1
      }
      ECall(new_callee, new_args, off)
    },
    EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, edp_etawrap_expr(b, in_scope, needing, ename, wc)),
    EHandle(b, arms) => {
      let matches = edp_handle_matches_effect(arms, ename)
      let body_scope = if matches {
        true
      } else {
        in_scope
      }
      let arm_scope = if matches {
        false
      } else {
        in_scope
      }
      EHandle(edp_etawrap_expr(b, body_scope, needing, ename, wc), edp_etawrap_arms(arms, arm_scope, needing, ename, wc))
    },
    EIf(c, t, el) => EIf(edp_etawrap_expr(c, in_scope, needing, ename, wc), edp_etawrap_expr(t, in_scope, needing, ename, wc), edp_etawrap_expr(el, in_scope, needing, ename, wc)),
    EMatch(s, arms) => EMatch(edp_etawrap_expr(s, in_scope, needing, ename, wc), edp_etawrap_arms(arms, in_scope, needing, ename, wc)),
    EWhile(c, b) => EWhile(edp_etawrap_expr(c, in_scope, needing, ename, wc), edp_etawrap_expr(b, in_scope, needing, ename, wc)),
    EForIn(n, idx, it, b) => EForIn(n, idx, edp_etawrap_expr(it, in_scope, needing, ename, wc), edp_etawrap_expr(b, in_scope, needing, ename, wc)),
    ELoop(pairs, b) => ELoop(edp_etawrap_pairs(pairs, in_scope, needing, ename, wc), edp_etawrap_expr(b, in_scope, needing, ename, wc)),
    ELet(n, v, b, off) => ELet(n, edp_etawrap_expr(v, in_scope, needing, ename, wc), edp_etawrap_expr(b, in_scope, needing, ename, wc), off),
    ELetMut(n, v, b, off) => ELetMut(n, edp_etawrap_expr(v, in_scope, needing, ename, wc), edp_etawrap_expr(b, in_scope, needing, ename, wc), off),
    ELetRec(n, v, b) => ELetRec(n, edp_etawrap_expr(v, in_scope, needing, ename, wc), edp_etawrap_expr(b, in_scope, needing, ename, wc)),
    ESeq(a, b) => ESeq(edp_etawrap_expr(a, in_scope, needing, ename, wc), edp_etawrap_expr(b, in_scope, needing, ename, wc)),
    EBinOp(op, l, r) => EBinOp(op, edp_etawrap_expr(l, in_scope, needing, ename, wc), edp_etawrap_expr(r, in_scope, needing, ename, wc)),
    EUnaryOp(op, x) => EUnaryOp(op, edp_etawrap_expr(x, in_scope, needing, ename, wc)),
    EAssign(n, v, c) => EAssign(n, edp_etawrap_expr(v, in_scope, needing, ename, wc), edp_etawrap_expr(c, in_scope, needing, ename, wc)),
    EAssignOp(op, n, v, c) => EAssignOp(op, n, edp_etawrap_expr(v, in_scope, needing, ename, wc), edp_etawrap_expr(c, in_scope, needing, ename, wc)),
    EDot(o, f, o1, o2) => EDot(edp_etawrap_expr(o, in_scope, needing, ename, wc), f, o1, o2),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_etawrap_expr(v, in_scope, needing, ename, wc)),
    EReturn(x) => EReturn(edp_etawrap_expr(x, in_scope, needing, ename, wc)),
    EBreak(opt) => EBreak(match opt {
      Some(x) => Some(edp_etawrap_expr(x, in_scope, needing, ename, wc)),
      None => None
    }),
    EContinue(args) => EContinue(edp_etawrap_exprs(args, in_scope, needing, ename, wc)),
    ETuple(items) => ETuple(edp_etawrap_exprs(items, in_scope, needing, ename, wc)),
    EArray(items) => EArray(edp_etawrap_exprs(items, in_scope, needing, ename, wc)),
    ERecord(n, fields, tas) => ERecord(n, edp_etawrap_pairs(fields, in_scope, needing, ename, wc), tas),
    EMap(fields) => EMap(edp_etawrap_pairs(fields, in_scope, needing, ename, wc)),
    ESpread(x) => ESpread(edp_etawrap_expr(x, in_scope, needing, ename, wc)),
    _ => e
  }
}

fn edp_etawrap_exprs(es: Array[Expr], in_scope: Bool, needing: Array[String], ename: String, wc: (Array[Stmt], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]])) -> Array[Expr] {
  for x in es {
    edp_etawrap_expr(x, in_scope, needing, ename, wc)
  }
}

fn edp_etawrap_pairs(pairs: Array[(String, Expr)], in_scope: Bool, needing: Array[String], ename: String, wc: (Array[Stmt], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]])) -> Array[(String, Expr)] {
  for p in pairs {
    let (n, v) = p
    (n, edp_etawrap_expr(v, in_scope, needing, ename, wc))
  }
}

fn edp_etawrap_arms(arms: Array[(Pat, Expr)], in_scope: Bool, needing: Array[String], ename: String, wc: (Array[Stmt], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]])) -> Array[(Pat, Expr)] {
  for a in arms {
    let (p, ex) = a
    (p, edp_etawrap_expr(ex, in_scope, needing, ename, wc))
  }
}

fn edp_count_ident_uses(expr: Expr, name: String) -> Int {
  match expr {
    EIdent(nm, _) => if nm == name {
      1
    } else {
      0
    },
    EFn(_, _, _, _, _, body) => edp_count_ident_uses(body, name),
    EHandle(body, arms) => edp_count_ident_uses(body, name) + edp_count_ident_uses_arms(arms, name),
    EIf(c, t, e) => edp_count_ident_uses(c, name) + edp_count_ident_uses(t, name) + edp_count_ident_uses(e, name),
    EMatch(s, arms) => edp_count_ident_uses(s, name) + edp_count_ident_uses_arms(arms, name),
    EWhile(c, b) => edp_count_ident_uses(c, name) + edp_count_ident_uses(b, name),
    EForIn(_, _, it, b) => edp_count_ident_uses(it, name) + edp_count_ident_uses(b, name),
    ELoop(pairs, b) => edp_count_ident_uses_pairs(pairs, name) + edp_count_ident_uses(b, name),
    ELet(_, v, b, _) => edp_count_ident_uses(v, name) + edp_count_ident_uses(b, name),
    ELetMut(_, v, b, _) => edp_count_ident_uses(v, name) + edp_count_ident_uses(b, name),
    ELetRec(_, v, b) => edp_count_ident_uses(v, name) + edp_count_ident_uses(b, name),
    ESeq(a, b) => edp_count_ident_uses(a, name) + edp_count_ident_uses(b, name),
    ECall(callee, args, _) => edp_count_ident_uses(callee, name) + edp_count_ident_uses_exprs(args, name),
    EBinOp(_, l, r) => edp_count_ident_uses(l, name) + edp_count_ident_uses(r, name),
    EUnaryOp(_, e2) => edp_count_ident_uses(e2, name),
    EAssign(_, v, c) => edp_count_ident_uses(v, name) + edp_count_ident_uses(c, name),
    EAssignOp(_, _, v, c) => edp_count_ident_uses(v, name) + edp_count_ident_uses(c, name),
    EDot(o, _, _, _) => edp_count_ident_uses(o, name),
    ELabeledArg(_, _, v) => edp_count_ident_uses(v, name),
    EReturn(e2) => edp_count_ident_uses(e2, name),
    EBreak(opt) => match opt {
      Some(e2) => edp_count_ident_uses(e2, name),
      None => 0
    },
    EContinue(args) => edp_count_ident_uses_exprs(args, name),
    ETuple(elems) => edp_count_ident_uses_exprs(elems, name),
    EArray(elems) => edp_count_ident_uses_exprs(elems, name),
    ERecord(_, fields, _) => edp_count_ident_uses_fields(fields, name),
    EMap(fields) => edp_count_ident_uses_fields(fields, name),
    ESpread(e2) => edp_count_ident_uses(e2, name),
    _ => 0
  }
}

fn edp_count_ident_uses_exprs(exprs: Array[Expr], name: String) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(exprs) {
    total = total + edp_count_ident_uses(Array::get(exprs, i), name)
    i = i + 1
  }
  total
}

fn edp_count_ident_uses_arms(arms: Array[(Pat, Expr)], name: String) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(arms) {
    let (_, ex) = Array::get(arms, i)
    total = total + edp_count_ident_uses(ex, name)
    i = i + 1
  }
  total
}

fn edp_count_ident_uses_pairs(pairs: Array[(String, Expr)], name: String) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, i)
    total = total + edp_count_ident_uses(v, name)
    i = i + 1
  }
  total
}

fn edp_count_ident_uses_fields(fields: Array[(String, Expr)], name: String) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    total = total + edp_count_ident_uses(v, name)
    i = i + 1
  }
  total
}

/// Whole-program count of `let`-bound (top-level SLet or nested ELet/
/// ELetRec) closure literals named `xname` that are individually eligible
/// (edp_efn_eligible_for_migration). Same full coverage as
/// edp_count_ident_uses.
fn edp_count_safe_closure_bindings_stmts(stmts: Array[Stmt], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, nm, _, expr) => {
        let self_hit = if nm == xname && edp_efn_eligible_for_migration(expr, ename, needing, pure_fns, es_names, es_members_list) {
          1
        } else {
          0
        }
        total = total + self_hit + edp_count_safe_closure_bindings(expr, xname, ename, needing, pure_fns, es_names, es_members_list)
      },
      _ => ()
    }
    i = i + 1
  }
  total
}

fn edp_count_safe_closure_bindings(expr: Expr, xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {
  match expr {
    ELet(n, v, b, _) => {
      let self_hit = if n == xname && edp_efn_eligible_for_migration(v, ename, needing, pure_fns, es_names, es_members_list) {
        1
      } else {
        0
      }
      self_hit + edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list)
    },
    ELetRec(n, v, b) => {
      let self_hit = if n == xname && edp_efn_eligible_for_migration(v, ename, needing, pure_fns, es_names, es_members_list) {
        1
      } else {
        0
      }
      self_hit + edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list)
    },
    EFn(_, _, _, _, _, body) => edp_count_safe_closure_bindings(body, xname, ename, needing, pure_fns, es_names, es_members_list),
    EHandle(body, arms) => edp_count_safe_closure_bindings(body, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings_arms(arms, xname, ename, needing, pure_fns, es_names, es_members_list),
    EIf(c, t, e) => edp_count_safe_closure_bindings(c, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(t, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(e, xname, ename, needing, pure_fns, es_names, es_members_list),
    EMatch(s, arms) => edp_count_safe_closure_bindings(s, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings_arms(arms, xname, ename, needing, pure_fns, es_names, es_members_list),
    EWhile(c, b) => edp_count_safe_closure_bindings(c, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list),
    EForIn(_, _, it, b) => edp_count_safe_closure_bindings(it, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list),
    ELoop(pairs, b) => edp_count_safe_closure_bindings_pairs(pairs, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list),
    ELetMut(_, v, b, _) => edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list),
    ESeq(a, b) => edp_count_safe_closure_bindings(a, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(b, xname, ename, needing, pure_fns, es_names, es_members_list),
    EAssign(_, v, c) => edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(c, xname, ename, needing, pure_fns, es_names, es_members_list),
    EAssignOp(_, _, v, c) => edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(c, xname, ename, needing, pure_fns, es_names, es_members_list),
    EDot(o, _, _, _) => edp_count_safe_closure_bindings(o, xname, ename, needing, pure_fns, es_names, es_members_list),
    ELabeledArg(_, _, v) => edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list),
    EReturn(e2) => edp_count_safe_closure_bindings(e2, xname, ename, needing, pure_fns, es_names, es_members_list),
    EBreak(opt) => match opt {
      Some(e2) => edp_count_safe_closure_bindings(e2, xname, ename, needing, pure_fns, es_names, es_members_list),
      None => 0
    },
    ECall(callee, args, _) => edp_count_safe_closure_bindings(callee, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings_exprs(args, xname, ename, needing, pure_fns, es_names, es_members_list),
    EBinOp(_, l, r) => edp_count_safe_closure_bindings(l, xname, ename, needing, pure_fns, es_names, es_members_list) + edp_count_safe_closure_bindings(r, xname, ename, needing, pure_fns, es_names, es_members_list),
    EUnaryOp(_, e2) => edp_count_safe_closure_bindings(e2, xname, ename, needing, pure_fns, es_names, es_members_list),
    EContinue(args) => edp_count_safe_closure_bindings_exprs(args, xname, ename, needing, pure_fns, es_names, es_members_list),
    ETuple(elems) => edp_count_safe_closure_bindings_exprs(elems, xname, ename, needing, pure_fns, es_names, es_members_list),
    EArray(elems) => edp_count_safe_closure_bindings_exprs(elems, xname, ename, needing, pure_fns, es_names, es_members_list),
    ERecord(_, fields, _) => edp_count_safe_closure_bindings_fields(fields, xname, ename, needing, pure_fns, es_names, es_members_list),
    EMap(fields) => edp_count_safe_closure_bindings_fields(fields, xname, ename, needing, pure_fns, es_names, es_members_list),
    ESpread(e2) => edp_count_safe_closure_bindings(e2, xname, ename, needing, pure_fns, es_names, es_members_list),
    _ => 0
  }
}

fn edp_count_safe_closure_bindings_exprs(exprs: Array[Expr], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(exprs) {
    total = total + edp_count_safe_closure_bindings(Array::get(exprs, i), xname, ename, needing, pure_fns, es_names, es_members_list)
    i = i + 1
  }
  total
}

fn edp_count_safe_closure_bindings_arms(arms: Array[(Pat, Expr)], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(arms) {
    let (_, ex) = Array::get(arms, i)
    total = total + edp_count_safe_closure_bindings(ex, xname, ename, needing, pure_fns, es_names, es_members_list)
    i = i + 1
  }
  total
}

fn edp_count_safe_closure_bindings_pairs(pairs: Array[(String, Expr)], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, i)
    total = total + edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list)
    i = i + 1
  }
  total
}

fn edp_count_safe_closure_bindings_fields(fields: Array[(String, Expr)], xname: String, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    total = total + edp_count_safe_closure_bindings(v, xname, ename, needing, pure_fns, es_names, es_members_list)
    i = i + 1
  }
  total
}

/// Whole-program scan for `gname(args)` calls, collecting the bare
/// identifier found at `args[argpos]`. A call to `gname` whose argument at
/// that position is EITHER missing (arity mismatch we can't reason about)
/// OR present but not a bare identifier (a literal, a field access, an
/// inline lambda, ...) pushes the sentinel "##edp_unsafe##" instead --
/// edp_closure_param_universally_safe treats its presence, anywhere in the
/// result, as an unconditional "not safe" for the whole position.
fn edp_collect_ecall_arg_idents(stmts: Array[Stmt], gname: String, argpos: Int) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out),
      SLetMut(_, _, expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out),
      SExpr(expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out),
      STest(_, expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out),
      SBench(_, expr) => edp_collect_ecall_arg_idents_expr(expr, gname, argpos, out),
      _ => ()
    }
    i = i + 1
  }
  out
}

fn edp_collect_ecall_arg_idents_expr(expr: Expr, gname: String, argpos: Int, out: Array[String]) -> Unit {
  match expr {
    ECall(callee, args, _) => {
      match callee {
        EIdent(nm, _) => if nm == gname {
          if Array::length(args) > argpos {
            match Array::get(args, argpos) {
              EIdent(xn, _) => Array::push(out, xn),
              _ => Array::push(out, "##edp_unsafe##")
            }
          } else {
            Array::push(out, "##edp_unsafe##")
          }
        } else {
          ()
        },
        _ => ()
      }
      edp_collect_ecall_arg_idents_expr(callee, gname, argpos, out)
      edp_collect_ecall_arg_idents_exprs(args, gname, argpos, out)
    },
    EFn(_, _, _, _, _, body) => edp_collect_ecall_arg_idents_expr(body, gname, argpos, out),
    EHandle(body, arms) => {
      edp_collect_ecall_arg_idents_expr(body, gname, argpos, out)
      edp_collect_ecall_arg_idents_arms(arms, gname, argpos, out)
    },
    EIf(c, t, e) => {
      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out)
      edp_collect_ecall_arg_idents_expr(t, gname, argpos, out)
      edp_collect_ecall_arg_idents_expr(e, gname, argpos, out)
    },
    EMatch(s, arms) => {
      edp_collect_ecall_arg_idents_expr(s, gname, argpos, out)
      edp_collect_ecall_arg_idents_arms(arms, gname, argpos, out)
    },
    EWhile(c, b) => {
      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out)
      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)
    },
    EForIn(_, _, it, b) => {
      edp_collect_ecall_arg_idents_expr(it, gname, argpos, out)
      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)
    },
    ELoop(pairs, b) => {
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, v) = Array::get(pairs, i)
        edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)
        i = i + 1
      }
      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)
    },
    ELet(_, v, b, _) => {
      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)
      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)
    },
    ELetMut(_, v, b, _) => {
      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)
      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)
    },
    ELetRec(_, v, b) => {
      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)
      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)
    },
    ESeq(a, b) => {
      edp_collect_ecall_arg_idents_expr(a, gname, argpos, out)
      edp_collect_ecall_arg_idents_expr(b, gname, argpos, out)
    },
    EBinOp(_, l, r) => {
      edp_collect_ecall_arg_idents_expr(l, gname, argpos, out)
      edp_collect_ecall_arg_idents_expr(r, gname, argpos, out)
    },
    EUnaryOp(_, e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out),
    EAssign(_, v, c) => {
      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)
      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out)
    },
    EAssignOp(_, _, v, c) => {
      edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)
      edp_collect_ecall_arg_idents_expr(c, gname, argpos, out)
    },
    EDot(o, _, _, _) => edp_collect_ecall_arg_idents_expr(o, gname, argpos, out),
    ELabeledArg(_, _, v) => edp_collect_ecall_arg_idents_expr(v, gname, argpos, out),
    EReturn(e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out),
    EBreak(opt) => match opt {
      Some(e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out),
      None => ()
    },
    EContinue(args) => edp_collect_ecall_arg_idents_exprs(args, gname, argpos, out),
    ETuple(elems) => edp_collect_ecall_arg_idents_exprs(elems, gname, argpos, out),
    EArray(elems) => edp_collect_ecall_arg_idents_exprs(elems, gname, argpos, out),
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)
        i = i + 1
      }
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        edp_collect_ecall_arg_idents_expr(v, gname, argpos, out)
        i = i + 1
      }
    },
    ESpread(e2) => edp_collect_ecall_arg_idents_expr(e2, gname, argpos, out),
    _ => ()
  }
}

fn edp_collect_ecall_arg_idents_exprs(exprs: Array[Expr], gname: String, argpos: Int, out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(exprs) {
    edp_collect_ecall_arg_idents_expr(Array::get(exprs, i), gname, argpos, out)
    i = i + 1
  }
}

fn edp_collect_ecall_arg_idents_arms(arms: Array[(Pat, Expr)], gname: String, argpos: Int, out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (_, ex) = Array::get(arms, i)
    edp_collect_ecall_arg_idents_expr(ex, gname, argpos, out)
    i = i + 1
  }
}

/// A closure-typed parameter position is safe to widen only if EVERY
/// candidate identifier found at that position (across the whole program)
/// is itself: used EXACTLY once anywhere (so no OTHER use could depend on
/// the pre-migration arity), and bound to at least one individually-
/// eligible closure literal. See this section's opening comment for why
/// both sides must hold.
fn edp_closure_param_universally_safe(stmts: Array[Stmt], gname: String, pi: Int, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Bool {
  let candidates = edp_collect_ecall_arg_idents(stmts, gname, pi)
  let mut i = 0
  let mut ok = true
  while i < Array::length(candidates) {
    let xn = Array::get(candidates, i)
    if xn == "##edp_unsafe##" {
      ok = false
    } else if edp_count_ident_uses_stmts(stmts, xn) != 1 {
      ok = false
    } else if edp_count_safe_closure_bindings_stmts(stmts, xn, ename, needing, pure_fns, es_names, es_members_list) < 1 {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

/// For a needing function's own params, the (name, position) pairs of
/// closure-typed parameters that edp_closure_param_universally_safe has
/// cleared -- these are treated exactly like another needing function's
/// name when rewriting this function's own body (dict forwarded the same
/// way via edp_prepend_dict_arg).
fn edp_own_closure_params(stmts: Array[Stmt], gname: String, gparams: Array[(String, Option[TypeExpr])], ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[(String, Int)] {
  let out = array_empty()
  let mut pi = 0
  while pi < Array::length(gparams) {
    let (pname, pty) = Array::get(gparams, pi)
    if edp_type_is_fn_row_exactly(pty, ename, es_names, es_members_list) && edp_closure_param_universally_safe(stmts, gname, pi, ename, needing, pure_fns, es_names, es_members_list) {
      Array::push(out, (edp_strip_tilde(pname), pi))
    } else {
      ()
    }
    pi = pi + 1
  }
  out
}

fn edp_closure_param_names_only(pairs: Array[(String, Int)]) -> Array[String] {
  for p in pairs {
    let (n, _) = p
    n
  }
}

// --- #1070 (general case, second slice -- docs/effect-evidence-passing.md
// 追記25): a function that establishes its OWN `handle ... with ename` and
// calls an opaque closure-typed PARAMETER inside that handle's body,
// WITHOUT itself carrying `ename` in its declared row (it fully discharges
// the effect locally, so edp_needing_names never classifies it as needing
// and edp_own_closure_params never applies to it). The self-hosted
// `vibe lsp`'s original `lsp_run_with_handler` (#1077) was exactly this
// shape, and it trapped ("indirect call type mismatch") under real
// wasmtime while passing under the Node dev-runner.
//
// Treatment mirrors edp_own_closure_params exactly -- prove BOTH sides
// (every flowing closure literal AND every call through the parameter)
// before touching either; see that section's opening comment for why
// one-sided rewriting is unsound -- with two EXTRA guards the
// needing-owner case gets for free from the type system:
//
// (1) the owner must never be referenced as a bare VALUE anywhere in the
//     program (edp_fn_used_as_value): `let alias = owner` followed by
//     `alias(other_closure)` invokes the owner through a name
//     edp_collect_ecall_arg_idents cannot see, so `other_closure` would
//     never be migrated while the owner's rewritten handle body
//     unconditionally passes the dict -- an arity mismatch. A NEEDING
//     owner is protected from this by its own row: any call to it,
//     however aliased, must sit in an `ename`-authorized context that
//     eligibility already scans (the aliased call is then flagged as an
//     unknown-name call there). A self-discharging owner has NO row, so
//     its calls can sit in completely pure code no eligibility scan ever
//     visits -- requiring zero value references is the only sound option.
//
// (2) every use of the parameter inside the owner's body must be a DIRECT
//     CALL located inside one of the owner's own `ename`-handle bodies
//     (edp_param_uses_confined_to_handle_calls). A needing owner's WHOLE
//     body gets rewritten (every call through the param receives the
//     forwarded dict), but here only the handle bodies are rewritten --
//     a use outside them (a call before the handle, a reference in a
//     handler arm, a pass-along to another function) would keep the old
//     arity against a closure that HAS been migrated.

/// Count of `name(args)` calls (ECall whose callee is exactly
/// EIdent(name)) -- full traversal mirroring edp_count_ident_uses' node
/// list (an undercounted position could make a value-reference look like
/// a call, or vice versa; both comparisons below need exact counts).
fn edp_count_direct_calls(expr: Expr, name: String) -> Int {
  match expr {
    ECall(callee, args, _) => {
      let self_hit = match callee {
        EIdent(nm, _) => if nm == name {
          1
        } else {
          0
        },
        _ => edp_count_direct_calls(callee, name)
      }
      self_hit + edp_count_direct_calls_exprs(args, name)
    },
    EFn(_, _, _, _, _, body) => edp_count_direct_calls(body, name),
    EHandle(body, arms) => edp_count_direct_calls(body, name) + edp_count_direct_calls_arms(arms, name),
    EIf(c, t, e) => edp_count_direct_calls(c, name) + edp_count_direct_calls(t, name) + edp_count_direct_calls(e, name),
    EMatch(s, arms) => edp_count_direct_calls(s, name) + edp_count_direct_calls_arms(arms, name),
    EWhile(c, b) => edp_count_direct_calls(c, name) + edp_count_direct_calls(b, name),
    EForIn(_, _, it, b) => edp_count_direct_calls(it, name) + edp_count_direct_calls(b, name),
    ELoop(pairs, b) => {
      let mut total = 0
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, v) = Array::get(pairs, i)
        total = total + edp_count_direct_calls(v, name)
        i = i + 1
      }
      total + edp_count_direct_calls(b, name)
    },
    ELet(_, v, b, _) => edp_count_direct_calls(v, name) + edp_count_direct_calls(b, name),
    ELetMut(_, v, b, _) => edp_count_direct_calls(v, name) + edp_count_direct_calls(b, name),
    ELetRec(_, v, b) => edp_count_direct_calls(v, name) + edp_count_direct_calls(b, name),
    ESeq(a, b) => edp_count_direct_calls(a, name) + edp_count_direct_calls(b, name),
    EBinOp(_, l, r) => edp_count_direct_calls(l, name) + edp_count_direct_calls(r, name),
    EUnaryOp(_, e2) => edp_count_direct_calls(e2, name),
    EAssign(_, v, c) => edp_count_direct_calls(v, name) + edp_count_direct_calls(c, name),
    EAssignOp(_, _, v, c) => edp_count_direct_calls(v, name) + edp_count_direct_calls(c, name),
    EDot(o, _, _, _) => edp_count_direct_calls(o, name),
    ELabeledArg(_, _, v) => edp_count_direct_calls(v, name),
    EReturn(e2) => edp_count_direct_calls(e2, name),
    EBreak(opt) => match opt {
      Some(e2) => edp_count_direct_calls(e2, name),
      None => 0
    },
    EContinue(args) => edp_count_direct_calls_exprs(args, name),
    ETuple(elems) => edp_count_direct_calls_exprs(elems, name),
    EArray(elems) => edp_count_direct_calls_exprs(elems, name),
    ERecord(_, fields, _) => edp_count_direct_calls_fields(fields, name),
    EMap(fields) => edp_count_direct_calls_fields(fields, name),
    ESpread(e2) => edp_count_direct_calls(e2, name),
    _ => 0
  }
}

fn edp_count_direct_calls_exprs(exprs: Array[Expr], name: String) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(exprs) {
    total = total + edp_count_direct_calls(Array::get(exprs, i), name)
    i = i + 1
  }
  total
}

fn edp_count_direct_calls_arms(arms: Array[(Pat, Expr)], name: String) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(arms) {
    let (_, ex) = Array::get(arms, i)
    total = total + edp_count_direct_calls(ex, name)
    i = i + 1
  }
  total
}

fn edp_count_direct_calls_fields(fields: Array[(String, Expr)], name: String) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    total = total + edp_count_direct_calls(v, name)
    i = i + 1
  }
  total
}

fn edp_count_direct_calls_stmts(stmts: Array[Stmt], name: String) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => {
        total = total + edp_count_direct_calls(expr, name)
      },
      _ => ()
    }
    i = i + 1
  }
  total
}

/// Guard (1): any EIdent occurrence of `fname` that is NOT the callee of a
/// direct call is a value reference (stored, passed along, returned...).
fn edp_fn_used_as_value(stmts: Array[Stmt], fname: String) -> Bool {
  edp_count_ident_uses_stmts(stmts, fname) > edp_count_direct_calls_stmts(stmts, fname)
}

/// Guard (2): every occurrence of `pname` in `body` is a direct call AND
/// sits inside one of `body`'s own `ename`-handle bodies. Requires at
/// least one use -- a never-used parameter has nothing to gain from
/// widening. Nested same-effect handles would double-count uses here
/// (edp_collect_handle_sites_expr collects both levels), failing the
/// equality -- conservative, and such shapes are ineligible anyway
/// (edp_has_unsafe_construct rejects same-effect nesting).
fn edp_param_uses_confined_to_handle_calls(body: Expr, pname: String, ename: String) -> Bool {
  let total = edp_count_ident_uses(body, pname)
  let sites = array_empty()
  edp_collect_handle_sites_expr(body, ename, sites)
  let mut uses_in = 0
  let mut calls_in = 0
  let mut i = 0
  while i < Array::length(sites) {
    let (hb, _) = Array::get(sites, i)
    uses_in = uses_in + edp_count_ident_uses(hb, pname)
    calls_in = calls_in + edp_count_direct_calls(hb, pname)
    i = i + 1
  }
  total > 0 && total == uses_in && uses_in == calls_in
}

/// The (name, position) pairs of `fname`'s closure-typed parameters that
/// clear every guard above plus the same universal call-site proof the
/// needing-owner path uses. `fname` must NOT itself be needing (needing
/// owners take the edp_own_closure_params path; a needing owner containing
/// a same-effect handle is ineligible regardless).
/// PERF (#1082 review, caught by scripts/profile_compile.sh): guard order
/// matters enormously here. This function runs for EVERY top-level
/// function x EVERY effect (edp_any_handle_owner_cp, the per-stmt
/// eligibility loop, and apply's analysis phase), and `edp_fn_used_as_value`
/// walks the WHOLE program -- running it unconditionally made
/// edp_count_ident_uses/edp_count_direct_calls 61% of total compile CPU
/// (76.8s wall for codegen_lexer_test vs ~8s before). The overwhelming
/// majority of functions have no closure-typed parameter with the exact
/// row at all, so every whole-program scan is gated behind the cheap,
/// function-local checks (param row match, then per-param body-local
/// shadow/confinement) and runs at most once per surviving owner.
fn edp_handle_owner_cps(stmts: Array[Stmt], fname: String, fparams: Array[(String, Option[TypeExpr])], fbody: Expr, ename: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Array[(String, Int)] {
  let out = array_empty()
  let mut has_row_param = false
  let mut hp = 0
  while hp < Array::length(fparams) {
    let (_, hpty) = Array::get(fparams, hp)
    if edp_type_is_fn_row_exactly(hpty, ename, es_names, es_members_list) {
      has_row_param = true
    } else {
      ()
    }
    hp = hp + 1
  }
  if !has_row_param || edp_str_array_contains(needing, fname) {
    out
  } else {
    // Body-local pre-filters per param, BEFORE the whole-program scans.
    let local_ok = array_empty()
    let mut pi = 0
    while pi < Array::length(fparams) {
      let (pname_raw, pty) = Array::get(fparams, pi)
      let pname = edp_strip_tilde(pname_raw)
      if edp_type_is_fn_row_exactly(pty, ename, es_names, es_members_list) && !edp_expr_binds_name(fbody, pname) && edp_param_uses_confined_to_handle_calls(fbody, pname, ename) {
        Array::push(local_ok, (pname, pi))
      } else {
        ()
      }
      pi = pi + 1
    }
    if Array::length(local_ok) == 0 {
      out
    } else if edp_fn_used_as_value(stmts, fname) {
      out
    } else {
      let mut li = 0
      while li < Array::length(local_ok) {
        let (pname, ppos) = Array::get(local_ok, li)
        if edp_closure_param_universally_safe(stmts, fname, ppos, ename, needing, pure_fns, es_names, es_members_list) {
          Array::push(out, (pname, ppos))
        } else {
          ()
        }
        li = li + 1
      }
      out
    }
  }
}

/// Migrates ONE closure literal binding (top-level SLet or nested ELet/
/// ELetRec named `xname`) in place: prepends the evidence-dict parameter
/// and rewrites its body exactly like a top-level needing function's own
/// definition (edp_rewrite_needing_fn). Only actually mutates if the
/// binding's value is still individually eligible at the point this runs
/// (edp_maybe_migrate_efn) -- a defensive re-check, not just trusting the
/// caller's earlier edp_closure_param_universally_safe verdict.
/// ADR-0076 追記34 V1: unconditionally migrate every row-E closure literal
/// (bottom-up: nested literals first). `call_safe` already carries needing
/// + the literal-bound names; each literal's own row-E params are added
/// per literal.
fn edp_sweep_row_lits_stmts(stmts: Array[Stmt], ename: String, dict_pname: String, call_safe: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exported, is_rec, nm, ty, expr) => match expr {
        // Top-level fn VALUES are the needing rewrite's domain; sweep
        // only their bodies' nested literals.
        EFn(tps, tbs, params, ret, eff, fb) => Array::set(stmts, i, SLet(exported, is_rec, nm, ty, EFn(tps, tbs, params, ret, eff, edp_sweep_row_lits_expr(fb, ename, dict_pname, call_safe, es_names, es_members_list)))),
        _ => Array::set(stmts, i, SLet(exported, is_rec, nm, ty, edp_sweep_row_lits_expr(expr, ename, dict_pname, call_safe, es_names, es_members_list)))
      },
      SLetMut(nm, ty, expr) => Array::set(stmts, i, SLetMut(nm, ty, edp_sweep_row_lits_expr(expr, ename, dict_pname, call_safe, es_names, es_members_list))),
      SExpr(expr) => Array::set(stmts, i, SExpr(edp_sweep_row_lits_expr(expr, ename, dict_pname, call_safe, es_names, es_members_list))),
      STest(tn, expr) => Array::set(stmts, i, STest(tn, edp_sweep_row_lits_expr(expr, ename, dict_pname, call_safe, es_names, es_members_list))),
      SBench(bn, expr) => Array::set(stmts, i, SBench(bn, edp_sweep_row_lits_expr(expr, ename, dict_pname, call_safe, es_names, es_members_list))),
      _ => ()
    }
    i = i + 1
  }
}

fn edp_sweep_row_lits_expr(e: Expr, ename: String, dict_pname: String, call_safe: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Expr {
  match e {
    EFn(tps, tbs, params, ret, eff, body) => {
      let body2 = edp_sweep_row_lits_expr(body, ename, dict_pname, call_safe, es_names, es_members_list)
      let node2 = EFn(tps, tbs, params, ret, eff, body2)
      if edp_efn_row_carries(node2, ename, es_names, es_members_list) {
        let lsafe = Array::concat(call_safe, edp_row_typed_param_names(params, ename, es_names, es_members_list))
        let new_params = Array::concat([
          (dict_pname, Some(TyName(edp_dict_struct_name(ename))))
        ], params)
        EFn(tps, tbs, new_params, ret, eff, edp_rewrite_needing_body(body2, ename, dict_pname, lsafe))
      } else {
        node2
      }
    },
    ELet(n, v, b, off) => ELet(n, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(b, ename, dict_pname, call_safe, es_names, es_members_list), off),
    ELetRec(n, v, b) => ELetRec(n, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(b, ename, dict_pname, call_safe, es_names, es_members_list)),
    ELetMut(n, v, b, off) => ELetMut(n, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(b, ename, dict_pname, call_safe, es_names, es_members_list), off),
    ESeq(a, b) => ESeq(edp_sweep_row_lits_expr(a, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(b, ename, dict_pname, call_safe, es_names, es_members_list)),
    EIf(c, t, el) => EIf(edp_sweep_row_lits_expr(c, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(t, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(el, ename, dict_pname, call_safe, es_names, es_members_list)),
    EMatch(sc, arms) => EMatch(edp_sweep_row_lits_expr(sc, ename, dict_pname, call_safe, es_names, es_members_list), for a in arms {
      let (pp, ex) = a
      (pp, edp_sweep_row_lits_expr(ex, ename, dict_pname, call_safe, es_names, es_members_list))
    }),
    EHandle(bd, arms) => EHandle(edp_sweep_row_lits_expr(bd, ename, dict_pname, call_safe, es_names, es_members_list), for a in arms {
      let (pp, ex) = a
      (pp, edp_sweep_row_lits_expr(ex, ename, dict_pname, call_safe, es_names, es_members_list))
    }),
    ECall(callee, args, off) => ECall(edp_sweep_row_lits_expr(callee, ename, dict_pname, call_safe, es_names, es_members_list), for a in args {
      edp_sweep_row_lits_expr(a, ename, dict_pname, call_safe, es_names, es_members_list)
    }, off),
    EWhile(c, b) => EWhile(edp_sweep_row_lits_expr(c, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(b, ename, dict_pname, call_safe, es_names, es_members_list)),
    EForIn(n, idx, it, b) => EForIn(n, idx, edp_sweep_row_lits_expr(it, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(b, ename, dict_pname, call_safe, es_names, es_members_list)),
    ELoop(pairs, b) => ELoop(for pr in pairs {
      let (n, v) = pr
      (n, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list))
    }, edp_sweep_row_lits_expr(b, ename, dict_pname, call_safe, es_names, es_members_list)),
    EBinOp(op, l, r) => EBinOp(op, edp_sweep_row_lits_expr(l, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(r, ename, dict_pname, call_safe, es_names, es_members_list)),
    EUnaryOp(op, x) => EUnaryOp(op, edp_sweep_row_lits_expr(x, ename, dict_pname, call_safe, es_names, es_members_list)),
    EAssign(n, v, c) => EAssign(n, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(c, ename, dict_pname, call_safe, es_names, es_members_list)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list), edp_sweep_row_lits_expr(c, ename, dict_pname, call_safe, es_names, es_members_list)),
    EReturn(x) => EReturn(edp_sweep_row_lits_expr(x, ename, dict_pname, call_safe, es_names, es_members_list)),
    EDot(o, f, o1, o2) => EDot(edp_sweep_row_lits_expr(o, ename, dict_pname, call_safe, es_names, es_members_list), f, o1, o2),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list)),
    EBreak(opt) => EBreak(match opt {
      Some(x) => Some(edp_sweep_row_lits_expr(x, ename, dict_pname, call_safe, es_names, es_members_list)),
      None => None
    }),
    EContinue(args) => EContinue(for a in args {
      edp_sweep_row_lits_expr(a, ename, dict_pname, call_safe, es_names, es_members_list)
    }),
    ETuple(items) => ETuple(for a in items {
      edp_sweep_row_lits_expr(a, ename, dict_pname, call_safe, es_names, es_members_list)
    }),
    EArray(items) => EArray(for a in items {
      edp_sweep_row_lits_expr(a, ename, dict_pname, call_safe, es_names, es_members_list)
    }),
    ERecord(n, fields, tas) => ERecord(n, for f in fields {
      let (fn2, v) = f
      (fn2, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list))
    }, tas),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, edp_sweep_row_lits_expr(v, ename, dict_pname, call_safe, es_names, es_members_list))
    }),
    ESpread(x) => ESpread(edp_sweep_row_lits_expr(x, ename, dict_pname, call_safe, es_names, es_members_list)),
    _ => e
  }
}

fn edp_maybe_migrate_efn(expr: Expr, ename: String, dict_pname: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Option[Expr] {
  match expr {
    // 追記34: a literal the type-directed sweep already migrated FOR THIS
    // EFFECT must not be double-prepended by the proof-path revisit
    // (#1116 Codex P1: effect-specific — a `with A + B` literal already
    // carrying `__ev_A` still needs `__ev_B`).
    EFn(tps, tbs, params, ret, eff, body) => if edp_params_have_dict(params, dict_pname) {
      None
    } else if edp_efn_eligible_for_migration(expr, ename, needing, pure_fns, es_names, es_members_list) {
      let new_params = Array::concat([
        (dict_pname, Some(TyName(edp_dict_struct_name(ename))))
      ], params)
      let new_body = edp_rewrite_needing_body(body, ename, dict_pname, needing)
      Some(EFn(tps, tbs, new_params, ret, eff, new_body))
    } else {
      None
    },
    _ => None
  }
}

fn edp_migrate_closure_binding_stmts(stmts: Array[Stmt], xname: String, ename: String, dict_pname: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exported, is_rec, nm, ty, expr) => if nm == xname {
        match edp_maybe_migrate_efn(expr, ename, dict_pname, needing, pure_fns, es_names, es_members_list) {
          Some(new_expr) => Array::set(stmts, i, SLet(exported, is_rec, nm, ty, new_expr)),
          None => ()
        }
      } else {
        Array::set(stmts, i, SLet(exported, is_rec, nm, ty, edp_migrate_closure_binding_expr(expr, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)))
      },
      SLetMut(nm2, ty2, expr) => Array::set(stmts, i, SLetMut(nm2, ty2, edp_migrate_closure_binding_expr(expr, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))),
      SExpr(expr) => Array::set(stmts, i, SExpr(edp_migrate_closure_binding_expr(expr, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))),
      STest(tn, expr) => Array::set(stmts, i, STest(tn, edp_migrate_closure_binding_expr(expr, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))),
      SBench(bn, expr) => Array::set(stmts, i, SBench(bn, edp_migrate_closure_binding_expr(expr, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))),
      _ => ()
    }
    i = i + 1
  }
}

fn edp_migrate_closure_binding_expr(expr: Expr, xname: String, ename: String, dict_pname: String, needing: Array[String], pure_fns: Array[String], es_names: Array[String], es_members_list: Array[Array[String]]) -> Expr {
  match expr {
    ELet(n, v, b, off) => if n == xname {
      match edp_maybe_migrate_efn(v, ename, dict_pname, needing, pure_fns, es_names, es_members_list) {
        Some(nv) => ELet(n, nv, edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), off),
        None => ELet(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), off)
      }
    } else {
      ELet(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), off)
    },
    ELetRec(n, v, b) => if n == xname {
      match edp_maybe_migrate_efn(v, ename, dict_pname, needing, pure_fns, es_names, es_members_list) {
        Some(nv) => ELetRec(n, nv, edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),
        None => ELetRec(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))
      }
    } else {
      ELetRec(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))
    },
    EFn(tps, tbs, params, ret, eff, body) => EFn(tps, tbs, params, ret, eff, edp_migrate_closure_binding_expr(body, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),
    EHandle(body, arms) => EHandle(edp_migrate_closure_binding_expr(body, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), for a in arms {
      let (p, ex) = a
      (p, edp_migrate_closure_binding_expr(ex, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))
    }),
    EIf(c, t, e) => EIf(edp_migrate_closure_binding_expr(c, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(t, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(e, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),
    EMatch(s, arms) => EMatch(edp_migrate_closure_binding_expr(s, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), for a in arms {
      let (p, ex) = a
      (p, edp_migrate_closure_binding_expr(ex, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))
    }),
    EWhile(c, b) => EWhile(edp_migrate_closure_binding_expr(c, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),
    EForIn(n, idx, it, b) => EForIn(n, idx, edp_migrate_closure_binding_expr(it, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),
    ELoop(pairs, b) => ELoop(for p in pairs {
      let (n, v) = p
      (n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))
    }, edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),
    ELetMut(n, v, b, off) => ELetMut(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), off),
    ESeq(a, b) => ESeq(edp_migrate_closure_binding_expr(a, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(b, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),
    EAssign(n, v, c) => EAssign(n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(c, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(c, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),
    EDot(o, f, off1, off2) => EDot(edp_migrate_closure_binding_expr(o, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), f, off1, off2),
    ECall(callee, args, off) => ECall(callee, for a in args {
      edp_migrate_closure_binding_expr(a, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)
    }, off),
    EBinOp(op, l, r) => EBinOp(op, edp_migrate_closure_binding_expr(l, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list), edp_migrate_closure_binding_expr(r, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),
    EUnaryOp(op, e2) => EUnaryOp(op, edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),
    EReturn(e2) => EReturn(edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),
    EBreak(opt) => EBreak(match opt {
      Some(e2) => Some(edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),
      None => None
    }),
    EContinue(args) => EContinue(for a in args {
      edp_migrate_closure_binding_expr(a, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)
    }),
    ETuple(elems) => ETuple(for e2 in elems {
      edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)
    }),
    EArray(elems) => EArray(for e2 in elems {
      edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)
    }),
    ERecord(n, fields, tas) => ERecord(n, for f in fields {
      let (fn2, v) = f
      (fn2, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))
    }, tas),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, edp_migrate_closure_binding_expr(v, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list))
    }),
    ESpread(e2) => ESpread(edp_migrate_closure_binding_expr(e2, xname, ename, dict_pname, needing, pure_fns, es_names, es_members_list)),
    _ => expr
  }
}

// --- applying an eligible migration.

fn edp_apply_migration(stmts: Array[Stmt], ename: String, ops: Array[(String, Array[TypeExpr], TypeExpr)], needing: Array[String], handle_sites: Array[(Expr, Array[(Pat, Expr)])], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)]) -> Unit {
  let dict_pname = edp_dict_param_name(ename)
  let dict_tyname = edp_dict_struct_name(ename)
  let pure_fns = edp_pure_fn_names(fn_defs)
  edp_append_free_host_inert_names(stmts, pure_fns)
  edp_append_self_discharging_row_fns(stmts, fn_defs, ename, pure_fns)
  edp_append_perform_free_row_fns(stmts, fn_defs, ename, pure_fns)
  let es_names = array_empty()
  let es_members_list = array_empty()
  edp_es_collect_into(stmts, es_names, es_members_list)
  // #1070 (general case): compute + commit closure-parameter migrations
  // for EVERY needing function BEFORE any needing function's own
  // params/body are rewritten below -- edp_collect_ecall_arg_idents scans
  // call sites by ARGUMENT POSITION, which would be silently thrown off
  // by an earlier needing-to-needing dict-forwarding rewrite prepending
  // an argument to some OTHER call in between. Doing every function's
  // read-only analysis (and Part B's closure-literal rewrites, which only
  // ever touch OTHER statements -- the literals themselves, never a call
  // site's argument list) in one pass up front, strictly before the
  // rewrite loop that follows, keeps every position-based scan looking at
  // the same unshifted view edp_all_sites_eligible already vetted this
  // against.
  let own_cp_map = array_empty()
  let mut ni0 = 0
  while ni0 < Array::length(needing) {
    let gname = Array::get(needing, ni0)
    match edp_find_fn_params_and_body(stmts, fn_defs, gname) {
      Some((gparams, _)) => {
        let own_cp = edp_own_closure_params(stmts, gname, gparams, ename, needing, pure_fns, es_names, es_members_list)
        Array::push(own_cp_map, own_cp)
        let mut cpi = 0
        while cpi < Array::length(own_cp) {
          let (_, ppos) = Array::get(own_cp, cpi)
          let candidates = edp_collect_ecall_arg_idents(stmts, gname, ppos)
          let mut ci = 0
          while ci < Array::length(candidates) {
            let xn = Array::get(candidates, ci)
            // Same needing-membership guard as the handle-owner loop
            // below (see its comment): a candidate that is itself a
            // needing top-level function gets the identical migration
            // from edp_rewrite_needing_fn; migrating it here too would
            // double-prepend the dict parameter.
            if xn == "##edp_unsafe##" || edp_str_array_contains(needing, xn) {
              ()
            } else {
              edp_migrate_closure_binding_stmts(stmts, xn, ename, dict_pname, needing, pure_fns, es_names, es_members_list)
            }
            ci = ci + 1
          }
          cpi = cpi + 1
        }
      },
      None => Array::push(own_cp_map, array_empty())
    }
    ni0 = ni0 + 1
  }
  // #1070 second slice (edp_handle_owner_cps): the same up-front
  // analyze-then-commit for SELF-DISCHARGING owners' closure params.
  // Phase 1 is strictly read-only across ALL statements (mirroring the
  // exact unmutated view edp_all_sites_eligible vetted) before Phase 2
  // migrates any closure literal -- a literal bound inside one owner's
  // body can be an argument to a DIFFERENT owner, so interleaving
  // analysis with mutation could diverge from what eligibility saw.
  let hcp_by_stmt = array_empty()
  let mut hsi0 = 0
  while hsi0 < Array::length(stmts) {
    match Array::get(stmts, hsi0) {
      SLet(_, _, snm, _, sval) => match sval {
        EFn(_, _, sparams, _, _, sbody) => Array::push(hcp_by_stmt, (snm, edp_handle_owner_cps(stmts, snm, sparams, sbody, ename, needing, pure_fns, es_names, es_members_list))),
        _ => Array::push(hcp_by_stmt, ("", array_empty()))
      },
      _ => Array::push(hcp_by_stmt, ("", array_empty()))
    }
    hsi0 = hsi0 + 1
  }
  let mut hsi1 = 0
  while hsi1 < Array::length(hcp_by_stmt) {
    let (howner, hcps) = Array::get(hcp_by_stmt, hsi1)
    let mut hcpi = 0
    while hcpi < Array::length(hcps) {
      let (_, ppos) = Array::get(hcps, hcpi)
      let hc_candidates = edp_collect_ecall_arg_idents(stmts, howner, ppos)
      let mut hci = 0
      while hci < Array::length(hc_candidates) {
        let xn = Array::get(hc_candidates, hci)
        // A candidate that is ALSO a needing top-level function (a
        // capture-free closure literal hoisted by dlh_hoist_expr with its
        // row backfilled -- 追記20 -- becomes exactly that) must NOT be
        // migrated here: the needing-function rewrite loop below performs
        // the IDENTICAL migration (same dict param, same body rewrite),
        // and running both would prepend the dict parameter twice --
        // caught live by gate 40al (effect_inline_lambda_literal_hof_arg,
        // whose with_log argument hoists to a top-level needing fn).
        if xn == "##edp_unsafe##" || edp_str_array_contains(needing, xn) {
          ()
        } else {
          edp_migrate_closure_binding_stmts(stmts, xn, ename, dict_pname, needing, pure_fns, es_names, es_members_list)
        }
        hci = hci + 1
      }
      hcpi = hcpi + 1
    }
    hsi1 = hsi1 + 1
  }
  // Rewrite each needing function's own definition in place: prepend the
  // evidence-dict parameter, and rewrite its body to call through it
  // (direct performs) / forward it (calls to other needing functions, and
  // -- per own_cp_map above -- calls through its own closure-typed
  // parameters that were just proven safe to widen).
  // ADR-0076 追記34 V1 (type-directed sweep): migrate EVERY row-E closure
  // literal in place — prepend __ev_E and rewrite the body — and widen the
  // safe-call sets with the literal-bound names + each fn's own
  // row-E-typed params. Runs BEFORE the needing rewrites so those see the
  // already-swept literals (the __ev_ first-param guard makes any later
  // proof-path re-visit a no-op).
  let td_binds_raw = empty_str_array()
  let td_lits0 = array_empty()
  edp_row_lit_scan(stmts, ename, needing, es_names, es_members_list, td_binds_raw, td_lits0)
  // #1116 Codex P1: same shadow-poison filter as eligibility (both views
  // must agree on the widened set, or apply widens what eligibility did
  // not vet).
  let td_poison0 = empty_str_array()
  edp_collect_poison_stmts(stmts, ename, needing, es_names, es_members_list, td_poison0)
  let td_binds = edp_filter_unpoisoned(td_binds_raw, td_poison0)
  let td_mode = Array::length(td_binds) > 0 || Array::length(td_lits0) > 0 || edp_any_row_typed_param(stmts, fn_defs, ename, es_names, es_members_list)
  if td_mode {
    let td_safe = Array::concat(needing, td_binds)
    edp_sweep_row_lits_stmts(stmts, ename, dict_pname, td_safe, es_names, es_members_list)
  } else {
    ()
  }
  let mut ni = 0
  while ni < Array::length(needing) {
    let nm = Array::get(needing, ni)
    let own_cp = Array::get(own_cp_map, ni)
    let tdw = if td_mode {
      match edp_find_fn_params_and_body(stmts, fn_defs, nm) {
        Some((gparams2, _)) => Array::concat(td_binds, edp_row_typed_param_names(gparams2, ename, es_names, es_members_list)),
        None => td_binds
      }
    } else {
      empty_str_array()
    }
    let call_safe = Array::concat(Array::concat(needing, edp_closure_param_names_only(own_cp)), tdw)
    edp_rewrite_needing_fn(stmts, fn_defs, nm, ename, dict_pname, dict_tyname, call_safe)
    ni = ni + 1
  }
  // Rewrite each handle site: synthesize a fresh evidence dict from its
  // arms, splice direct performs the same way Phase 2 does, pass the dict
  // at calls to needing functions, and drop the EHandle wrapper. Single
  // pass over `stmts`, rewriting each matching EHandle node the moment it
  // is found -- see edp_find_rewrite_handles's doc comment for why this
  // replaced an earlier collect-then-re-find-by-equality design.
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      SLet(exported, is_rec, name, ty, expr) => {
        // Extend the safe-call set with THIS statement's own proven
        // closure params (if it is a self-discharging owner) so its
        // handle bodies' calls through them get the dict literal
        // prepended -- scoped to this statement only, mirroring the
        // per-owner eligibility check exactly.
        let (_, hcps2) = Array::get(hcp_by_stmt, si)
        let tdh = if td_mode {
          match expr {
            EFn(_, _, sparams3, _, _, _) => Array::concat(td_binds, edp_row_typed_param_names(sparams3, ename, es_names, es_members_list)),
            _ => td_binds
          }
        } else {
          empty_str_array()
        }
        let needing_h = Array::concat(Array::concat(needing, edp_closure_param_names_only(hcps2)), tdh)
        Array::set(stmts, si, SLet(exported, is_rec, name, ty, edp_find_rewrite_handles(expr, ename, needing_h)))
      },
      // ADR-0076 追記34 V2: non-SLet site-bearing statements, mirroring
      // eligibility's own coverage (base needing + bare td_binds; no
      // owner-closure-param extension).
      SLetMut(nm2, ty2, expr) => {
        let tdh2 = if td_mode {
          td_binds
        } else {
          empty_str_array()
        }
        Array::set(stmts, si, SLetMut(nm2, ty2, edp_find_rewrite_handles(expr, ename, Array::concat(needing, tdh2))))
      },
      SExpr(expr) => {
        let tdh2 = if td_mode {
          td_binds
        } else {
          empty_str_array()
        }
        Array::set(stmts, si, SExpr(edp_find_rewrite_handles(expr, ename, Array::concat(needing, tdh2))))
      },
      STest(tn2, expr) => {
        let tdh2 = if td_mode {
          td_binds
        } else {
          empty_str_array()
        }
        Array::set(stmts, si, STest(tn2, edp_find_rewrite_handles(expr, ename, Array::concat(needing, tdh2))))
      },
      SBench(bn2, expr) => {
        let tdh2 = if td_mode {
          td_binds
        } else {
          empty_str_array()
        }
        Array::set(stmts, si, SBench(bn2, edp_find_rewrite_handles(expr, ename, Array::concat(needing, tdh2))))
      },
      _ => ()
    }
    si = si + 1
  }
  // Register the dict struct type once (idempotent, mirrors
  // desugar_trait_dict.vibe's own struct_decl_exists guard).
  if edp_struct_decl_exists(stmts, dict_tyname) {
    ()
  } else {
    Array::push(stmts, edp_make_dict_struct_stmt(ename, ops))
  }
}

fn edp_rewrite_needing_fn(stmts: Array[Stmt], fn_defs: Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], name: String, ename: String, dict_pname: String, dict_tyname: String, needing: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(fn_defs) {
    let (idx, exported, is_rec, nm, ty, _) = Array::get(fn_defs, i)
    if nm == name {
      match Array::get(stmts, idx) {
        // ADR-0076 追記34 V2: effect-specific idempotency guard (#1116's
        // edp_params_have_dict), mirroring edp_maybe_migrate_efn's own --
        // a def already carrying THIS effect's dict parameter must not be
        // rewritten again (double param prepend + double dict forwarding
        // at its needing calls). Belt to edp_collect_effect_defs' name
        // dedup braces: either alone prevents the duplicate-SEffectDef
        // double apply, together they keep it structurally impossible.
        SLet(_, _, _, _, EFn(tps, tbs, params, ret, eff, body)) => if edp_params_have_dict(params, dict_pname) {
          ()
        } else {
          let new_params = Array::concat([
            (dict_pname, Some(TyName(dict_tyname)))
          ], params)
          let new_body = edp_rewrite_needing_body(body, ename, dict_pname, needing)
          Array::set(stmts, idx, SLet(exported, is_rec, nm, ty, EFn(tps, tbs, new_params, ret, eff, new_body)))
        },
        _ => ()
      }
    } else {
      ()
    }
    i = i + 1
  }
}

/// Rewrite a needing function's own body: a direct `perform E::Op(args)`
/// becomes a call through the received dict parameter's `Op` field; a call
/// to another needing function has the SAME received dict parameter
/// forwarded as its new leading argument (mirrors desugar_trait_dict.vibe's
/// find_dict_for_trait forwarding). By this point edp_has_unsafe_construct
/// has already verified this body contains nothing else that could hide a
/// perform (no EFn/EHandle/EDot/other calls), so this traversal only needs
/// to handle the shapes that check allows through -- but it must still visit
/// EVERY position edp_has_unsafe_construct visits, not just the ones a bare
/// tail-position perform happens to need. This traversal used to be missing
/// several of those positions -- ELet/ELetMut/ELetRec/EAssign/EAssignOp's
/// value/RHS slot, EIf's condition, EMatch's scrutinee, and EWhile/EForIn/
/// ELoop/EUnaryOp/ELabeledArg/EBreak/EContinue/ETuple/EArray/ERecord/EMap/
/// ESpread entirely (falling to the `_ => expr` passthrough) -- even though
/// edp_has_unsafe_construct's OWN traversal (the eligibility check that
/// gates whether this rewrite runs at all) already recursed into every one
/// of them. A perform reached only through one of those positions -- most
/// simply, bound via `let` (`let a = perform Ask::Get; ...`) rather than
/// written as a bare tail expression -- therefore passed eligibility
/// (nothing unsafe about it, by has_unsafe_construct's own correct
/// judgment) but was silently left un-rewritten: still a raw `perform`,
/// throwing a tag the enclosing handle site no longer catches once this
/// migration drops it -- producing an uncaught-exception crash at runtime
/// despite a clean compile. Found via runtime instrumentation (temporary
/// exported per-effect tags decoded the escaping exception as the MIGRATED
/// effect's own tag, not a foreign one -- see
/// fixtures/effect_handle_call_evidence_let_bound.vibe) while investigating
/// an unrelated multi-effect-row crash; independent of that investigation
/// and reproducible with a single exact-match effect, so this was a real,
/// already-shipped soundness gap, not something specific to the multi-
/// effect experiment that led to finding it.
fn edp_rewrite_needing_body(expr: Expr, ename: String, dict_pname: String, needing: Array[String]) -> Expr {
  match expr {
    // A closure literal's body is rewritten the same way its enclosing
    // needing function's body is (edp_has_unsafe_construct already
    // verified this is safe); the closure's own params/type params/
    // return type/declared row are untouched, only its body. A perform
    // of `ename` found inside resolves through `dict_pname` via ordinary
    // lexical capture from the enclosing scope.
    //
    // UNLESS the literal already carries its own dict param: the
    // type-directed sweep (edp_sweep_row_lits_expr) runs first and gives
    // every row-`ename` literal an `__ev_ename` of its OWN, rewriting the
    // body against it. That param shadows the enclosing one, so the body
    // is already complete -- walking in again would forward the dict a
    // SECOND time at each needing call and hand the callee one argument
    // too many. This is the `__ev_` first-param guard edp_rewrite_needing_fn
    // already uses for the same reason, applied to the nested case.
    EFn(tps, tbs, params, ret, eff, body) => if edp_params_have_dict(params, dict_pname) {
      expr
    } else {
      EFn(tps, tbs, params, ret, eff, edp_rewrite_needing_body(body, ename, dict_pname, needing))
    },
    // A nested EHandle for a DIFFERENT effect than `ename` is safe to
    // recurse into (edp_has_unsafe_construct already verified this, both
    // for its body and its arms -- see that function's doc comment); one
    // matching `ename` itself is unconditionally unsafe and therefore
    // never reaches this rewrite (eligibility already rejected it), so
    // leave it structurally unchanged if somehow encountered defensively.
    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {
      expr
    } else {
      EHandle(edp_rewrite_needing_body(body, ename, dict_pname, needing), for a in arms {
        let (p, ex) = a
        (p, edp_rewrite_needing_body(ex, ename, dict_pname, needing))
      })
    },
    EIf(c, t, e) => EIf(edp_rewrite_needing_body(c, ename, dict_pname, needing), edp_rewrite_needing_body(t, ename, dict_pname, needing), edp_rewrite_needing_body(e, ename, dict_pname, needing)),
    EMatch(s, arms) => EMatch(edp_rewrite_needing_body(s, ename, dict_pname, needing), for a in arms {
      let (p, ex) = a
      (p, edp_rewrite_needing_body(ex, ename, dict_pname, needing))
    }),
    EWhile(c, b) => EWhile(edp_rewrite_needing_body(c, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing)),
    EForIn(n, idx, it, b) => EForIn(n, idx, edp_rewrite_needing_body(it, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing)),
    ELoop(pairs, b) => ELoop(for p in pairs {
      let (n, v) = p
      (n, edp_rewrite_needing_body(v, ename, dict_pname, needing))
    }, edp_rewrite_needing_body(b, ename, dict_pname, needing)),
    ELet(n, v, b, off) => ELet(n, edp_rewrite_needing_body(v, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing), off),
    ELetMut(n, v, b, off) => ELetMut(n, edp_rewrite_needing_body(v, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing), off),
    ELetRec(n, v, b) => ELetRec(n, edp_rewrite_needing_body(v, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing)),
    ESeq(a, b) => ESeq(edp_rewrite_needing_body(a, ename, dict_pname, needing), edp_rewrite_needing_body(b, ename, dict_pname, needing)),
    EAssign(n, v, c) => EAssign(n, edp_rewrite_needing_body(v, ename, dict_pname, needing), edp_rewrite_needing_body(c, ename, dict_pname, needing)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_rewrite_needing_body(v, ename, dict_pname, needing), edp_rewrite_needing_body(c, ename, dict_pname, needing)),
    EReturn(e2) => EReturn(edp_rewrite_needing_body(e2, ename, dict_pname, needing)),
    // A bare `.field` read (NOT a call through it -- ECall's own EDot
    // callee case never recurses through here, `_ => true`/its rewrite
    // counterpart's `_ => ECall(...)` catch it independently) only needs
    // its object expression rewritten; the field name is a bare string.
    EDot(o, f, off1, off2) => EDot(edp_rewrite_needing_body(o, ename, dict_pname, needing), f, off1, off2),
    ECall(callee, args, off) => match callee {
      EIdent(nm, _) => if nm == "perform" && Array::length(args) == 1 {
        edp_rewrite_perform_via_dict(Array::get(args, 0), ename, dict_pname, needing)
      } else if edp_str_array_contains(needing, nm) {
        ECall(callee, edp_prepend_dict_arg(dict_pname, edp_rewrite_needing_body_exprs(args, ename, dict_pname, needing)), off)
      } else {
        ECall(callee, edp_rewrite_needing_body_exprs(args, ename, dict_pname, needing), off)
      },
      _ => ECall(callee, edp_rewrite_needing_body_exprs(args, ename, dict_pname, needing), off)
    },
    EBinOp(op, l, r) => EBinOp(op, edp_rewrite_needing_body(l, ename, dict_pname, needing), edp_rewrite_needing_body(r, ename, dict_pname, needing)),
    EUnaryOp(op, e2) => EUnaryOp(op, edp_rewrite_needing_body(e2, ename, dict_pname, needing)),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_rewrite_needing_body(v, ename, dict_pname, needing)),
    EBreak(opt) => EBreak(match opt {
      Some(e2) => Some(edp_rewrite_needing_body(e2, ename, dict_pname, needing)),
      None => None
    }),
    EContinue(args) => EContinue(edp_rewrite_needing_body_exprs(args, ename, dict_pname, needing)),
    ETuple(elems) => ETuple(edp_rewrite_needing_body_exprs(elems, ename, dict_pname, needing)),
    EArray(elems) => EArray(edp_rewrite_needing_body_exprs(elems, ename, dict_pname, needing)),
    ERecord(n, fields, tas) => ERecord(n, for f in fields {
      let (fn2, v) = f
      (fn2, edp_rewrite_needing_body(v, ename, dict_pname, needing))
    }, tas),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, edp_rewrite_needing_body(v, ename, dict_pname, needing))
    }),
    ESpread(e2) => ESpread(edp_rewrite_needing_body(e2, ename, dict_pname, needing)),
    _ => expr
  }
}

fn edp_rewrite_needing_body_exprs(exprs: Array[Expr], ename: String, dict_pname: String, needing: Array[String]) -> Array[Expr] {
  for e in exprs {
    edp_rewrite_needing_body(e, ename, dict_pname, needing)
  }
}

fn edp_prepend_dict_arg(dict_pname: String, args: Array[Expr]) -> Array[Expr] {
  Array::concat([
    EIdent(dict_pname, -1)
  ], args)
}

/// A needing function's declared row is exactly `ename`, but it may still
/// contain a `perform` for a DIFFERENT effect that is exempt from row
/// declaration -- `Error` (#640 Stage 2: `perform Exception::Throw`/`throw`
/// never needs a declared `with Exception` row). Only a perform whose
/// qualified operation name's own effect prefix is `ename` gets rewritten
/// into a dict-field call; anything else (in practice, only Error) is left
/// completely untouched and falls through to its own existing codegen
/// (Error compiles unconditionally to a throw/trap, needing no evidence
/// dict or handler machinery at all, regardless of context).
fn edp_qname_is_for_effect(qname: String, ename: String) -> Bool {
  let (eff_opt, _) = edp_split_qualified(qname)
  match eff_opt {
    Some(e) => e == ename,
    None => false
  }
}

fn edp_rewrite_perform_via_dict(operand: Expr, ename: String, dict_pname: String, needing: Array[String]) -> Expr {
  match operand {
    EIdent(qname, _) => if edp_qname_is_for_effect(qname, ename) {
      ECall(EDot(EIdent(dict_pname, -1), edp_strip_effect_prefix(qname, ename), -1, -1), array_empty(), -1)
    } else {
      ECall(EIdent("perform", -1), [
        operand
      ], -1)
    },
    ECall(op_callee, op_args, _) => match op_callee {
      EIdent(qname, _) => if edp_qname_is_for_effect(qname, ename) {
        ECall(EDot(EIdent(dict_pname, -1), edp_strip_effect_prefix(qname, ename), -1, -1), edp_rewrite_needing_body_exprs(op_args, ename, dict_pname, needing), -1)
      } else {
        ECall(EIdent("perform", -1), [
          ECall(op_callee, edp_rewrite_needing_body_exprs(op_args, ename, dict_pname, needing), -1)
        ], -1)
      },
      _ => ECall(EIdent("perform", -1), [
        operand
      ], -1)
    },
    _ => ECall(EIdent("perform", -1), [
      operand
    ], -1)
  }
}

// --- rewriting a handle site.

fn edp_rewrite_handle_site(body: Expr, arms: Array[(Pat, Expr)], ename: String, needing: Array[String]) -> Expr {
  let op_names = for a in arms {
    let (p, _) = a
    edp_pat_qname(p)
  }
  let bind_names = for a in arms {
    let (p, _) = a
    edp_pat_bind_names(p)
  }
  let prepared_bodies = for a in arms {
    let (_, ex) = a
    edp_strip_tail_resume(ex)
  }
  let dict_literal = edp_build_dict_literal(ename, op_names, bind_names, prepared_bodies)
  edp_rewrite_handle_body(body, ename, op_names, bind_names, prepared_bodies, dict_literal, needing)
}

fn edp_build_dict_literal(ename: String, op_names: Array[String], bind_names: Array[Array[String]], prepared_bodies: Array[Expr]) -> Expr {
  let fields = array_empty()
  let mut i = 0
  while i < Array::length(op_names) {
    let bare = edp_strip_effect_prefix(Array::get(op_names, i), ename)
    let params = for n in Array::get(bind_names, i) {
      (n, None)
    }
    let closure = EFn(empty_str_array(), array_empty(), params, None, None, Array::get(prepared_bodies, i))
    Array::push(fields, (bare, closure))
    i = i + 1
  }
  ERecord("", fields, array_empty())
}

fn edp_table_lookup(op_names: Array[String], qname: String) -> Int {
  let mut i = 0
  let mut found = -1
  while i < Array::length(op_names) {
    if Array::get(op_names, i) == qname {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn edp_bind_args(bind_names: Array[String], actual_args: Array[Expr], prepared_body: Expr) -> Expr {
  let n = Array::length(bind_names)
  let mut result = prepared_body
  let mut i = n - 1
  while i >= 0 {
    if i < Array::length(actual_args) {
      result = ELet(Array::get(bind_names, i), Array::get(actual_args, i), result, -1)
    } else {
      ()
    }
    i = i - 1
  }
  result
}

/// Same completeness requirement as edp_rewrite_needing_body (see that
/// function's doc comment): the handle body's own eligibility was checked
/// with edp_has_unsafe_construct too (edp_all_sites_eligible calls it on
/// each handle site's body), so this traversal must visit every position
/// that check visits or a perform/needing-call reachable only through
/// EWhile/EForIn/ELoop/EUnaryOp/ELabeledArg/EBreak/EContinue/ETuple/EArray/
/// ERecord/EMap/ESpread would pass eligibility but silently stay
/// unrewritten, same failure mode.
fn edp_rewrite_handle_body(expr: Expr, ename: String, op_names: Array[String], bind_names_list: Array[Array[String]], prepared_bodies: Array[Expr], dict_literal: Expr, needing: Array[String]) -> Expr {
  match expr {
    // Same closure-literal handling as edp_rewrite_needing_body: a
    // `perform ename::Op` inside a closure defined within this handle's
    // body is spliced the same way as anywhere else in the body (pure
    // AST substitution of the arm's prepared body, not a runtime
    // reference -- see edp_splice_perform -- so it's exactly as valid
    // wherever the closure ends up being called, sync or later).
    //
    // Same `__ev_` guard as there, and for the same reason: a literal the
    // type-directed sweep already migrated takes its own dict param and
    // forwards THAT at its needing calls, so prepending this handle's
    // synthesized dict literal on top would pass one argument too many.
    // Only visible when the literal CALLS a needing fn -- a body that just
    // performs has no call left for this arm to prepend to, which is why
    // the perform-only shape (effect_needing_value_annotated.vibe) always
    // worked and the calling shape emitted an invalid module.
    EFn(tps, tbs, params, ret, eff, body) => if edp_params_have_dict(params, edp_dict_param_name(ename)) {
      expr
    } else {
      EFn(tps, tbs, params, ret, eff, edp_rewrite_handle_body(body, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))
    },
    // Same nested-EHandle handling as edp_rewrite_needing_body: recurse
    // into a DIFFERENT effect's nested handle (splicing any `perform
    // ename::Op` found inside it exactly like anywhere else in this
    // handle's own body); one matching `ename` itself never reaches here
    // (eligibility already rejected it as unconditionally unsafe).
    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {
      expr
    } else {
      EHandle(edp_rewrite_handle_body(body, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), for a in arms {
        let (p, ex) = a
        (p, edp_rewrite_handle_body(ex, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))
      })
    },
    EIf(c, t, e) => EIf(edp_rewrite_handle_body(c, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(t, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(e, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    EMatch(s, arms) => EMatch(edp_rewrite_handle_body(s, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), for a in arms {
      let (p, ex) = a
      (p, edp_rewrite_handle_body(ex, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))
    }),
    EWhile(c, b) => EWhile(edp_rewrite_handle_body(c, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    EForIn(n, idx, it, b) => EForIn(n, idx, edp_rewrite_handle_body(it, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    ELoop(pairs, b) => ELoop(for p in pairs {
      let (n, v) = p
      (n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))
    }, edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    ELet(n, v, b, off) => ELet(n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), off),
    ELetMut(n, v, b, off) => ELetMut(n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), off),
    ELetRec(n, v, b) => ELetRec(n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    ESeq(a, b) => ESeq(edp_rewrite_handle_body(a, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(b, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    EAssign(n, v, c) => EAssign(n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(c, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(c, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    EReturn(e2) => EReturn(edp_rewrite_handle_body(e2, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    // Same bare-`.field`-read handling as edp_rewrite_needing_body: only
    // the object expression can hide anything that needs rewriting.
    EDot(o, f, off1, off2) => EDot(edp_rewrite_handle_body(o, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), f, off1, off2),
    ECall(callee, args, off) => match callee {
      EIdent(nm, _) => if nm == "perform" && Array::length(args) == 1 {
        edp_splice_perform(Array::get(args, 0), op_names, bind_names_list, prepared_bodies)
      } else if edp_str_array_contains(needing, nm) {
        ECall(callee, edp_prepend_expr(dict_literal, edp_rewrite_handle_body_exprs(args, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)), off)
      } else {
        ECall(callee, edp_rewrite_handle_body_exprs(args, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), off)
      },
      _ => ECall(callee, edp_rewrite_handle_body_exprs(args, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), off)
    },
    EBinOp(op, l, r) => EBinOp(op, edp_rewrite_handle_body(l, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing), edp_rewrite_handle_body(r, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    EUnaryOp(op, e2) => EUnaryOp(op, edp_rewrite_handle_body(e2, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    EBreak(opt) => EBreak(match opt {
      Some(e2) => Some(edp_rewrite_handle_body(e2, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
      None => None
    }),
    EContinue(args) => EContinue(edp_rewrite_handle_body_exprs(args, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    ETuple(elems) => ETuple(edp_rewrite_handle_body_exprs(elems, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    EArray(elems) => EArray(edp_rewrite_handle_body_exprs(elems, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    ERecord(n, fields, tas) => ERecord(n, for f in fields {
      let (fn2, v) = f
      (fn2, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))
    }, tas),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, edp_rewrite_handle_body(v, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing))
    }),
    ESpread(e2) => ESpread(edp_rewrite_handle_body(e2, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)),
    _ => expr
  }
}

fn edp_rewrite_handle_body_exprs(exprs: Array[Expr], ename: String, op_names: Array[String], bind_names_list: Array[Array[String]], prepared_bodies: Array[Expr], dict_literal: Expr, needing: Array[String]) -> Array[Expr] {
  for e in exprs {
    edp_rewrite_handle_body(e, ename, op_names, bind_names_list, prepared_bodies, dict_literal, needing)
  }
}

fn edp_prepend_expr(v: Expr, args: Array[Expr]) -> Array[Expr] {
  Array::concat([
    v
  ], args)
}

fn edp_splice_perform(operand: Expr, op_names: Array[String], bind_names_list: Array[Array[String]], prepared_bodies: Array[Expr]) -> Expr {
  match operand {
    EIdent(qname, _) => edp_splice_or_leave(qname, array_empty(), operand, op_names, bind_names_list, prepared_bodies),
    ECall(op_callee, op_args, _) => match op_callee {
      EIdent(qname, _) => edp_splice_or_leave(qname, op_args, operand, op_names, bind_names_list, prepared_bodies),
      _ => ECall(EIdent("perform", -1), [
        operand
      ], -1)
    },
    _ => ECall(EIdent("perform", -1), [
      operand
    ], -1)
  }
}

fn edp_splice_or_leave(qname: String, actual_args: Array[Expr], original_operand: Expr, op_names: Array[String], bind_names_list: Array[Array[String]], prepared_bodies: Array[Expr]) -> Expr {
  let idx = edp_table_lookup(op_names, qname)
  if idx < 0 {
    ECall(EIdent("perform", -1), [
      original_operand
    ], -1)
  } else {
    edp_bind_args(Array::get(bind_names_list, idx), actual_args, Array::get(prepared_bodies, idx))
  }
}

/// Find every `EHandle` whose arms discharge `ename` and rewrite it via
/// edp_rewrite_handle_site, in the SAME traversal that finds it -- no
/// separate "collect, then re-find by structural equality" step.
///
/// An earlier version collected handle sites (edp_collect_handle_sites)
/// and re-located each one afterward via a hand-rolled structural-equality
/// check (edp_same_handle/edp_expr_eq) covering only a handful of Expr
/// constructors (EIdent/ECall/ESeq/ELet/EBinOp/EAssign/EInt). Any handle
/// body containing an Expr shape outside that list -- EIf being the first
/// one actually hit -- made edp_expr_eq silently return false for the
/// handle's own body compared against itself, so edp_replace_handle_in_
/// stmts never found a match and left the ORIGINAL, unmodified handle body
/// in place. Meanwhile edp_rewrite_needing_fn (which locates functions by
/// NAME via fn_defs, not by re-matching an Expr) had already prepended the
/// evidence-dict parameter to the needing function's signature regardless
/// -- producing exactly the inconsistent state that crashed at the wasm
/// level ("not enough arguments on the stack for call"): a callee expecting
/// N+1 params, called from an unrewritten site still passing N. This was
/// the actual root cause of the branch-nested-call bug (docs/effect-
/// evidence-passing.md "追記 4"/"追記 6"), not the EIf/local_names
/// interaction originally suspected -- runtime instrumentation of
/// compile_call.vibe's local_idx_hint/fn_idx_in_list dispatch (which
/// correctly selected the direct-call path) ruled that out.
///
/// This single-pass design can't have that failure mode: a handle is
/// rewritten the moment it's found, so there is no second "find it again"
/// step to fail. By this point (called only from edp_apply_migration,
/// itself only reached when edp_all_sites_eligible returned true for
/// `ename`), EVERY handle whose arms discharge `ename` anywhere in the
/// whole program is already known-eligible, so unconditionally rewriting
/// every occurrence found here is sound -- eligibility, not this
/// traversal, is what decides whether rewriting was safe to attempt at
/// all.
fn edp_find_rewrite_handles(expr: Expr, ename: String, needing: Array[String]) -> Expr {
  match expr {
    EHandle(body, arms) => if edp_handle_matches_effect(arms, ename) {
      edp_rewrite_handle_site(body, arms, ename, needing)
    } else {
      EHandle(edp_find_rewrite_handles(body, ename, needing), for a in arms {
        let (p, ex) = a
        (p, edp_find_rewrite_handles(ex, ename, needing))
      })
    },
    EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, edp_find_rewrite_handles(b, ename, needing)),
    ELet(n, v, b, off) => ELet(n, edp_find_rewrite_handles(v, ename, needing), edp_find_rewrite_handles(b, ename, needing), off),
    ELetMut(n, v, b, off) => ELetMut(n, edp_find_rewrite_handles(v, ename, needing), edp_find_rewrite_handles(b, ename, needing), off),
    ELetRec(n, v, b) => ELetRec(n, edp_find_rewrite_handles(v, ename, needing), edp_find_rewrite_handles(b, ename, needing)),
    ESeq(a, b) => ESeq(edp_find_rewrite_handles(a, ename, needing), edp_find_rewrite_handles(b, ename, needing)),
    EIf(c, t, e) => EIf(edp_find_rewrite_handles(c, ename, needing), edp_find_rewrite_handles(t, ename, needing), edp_find_rewrite_handles(e, ename, needing)),
    EMatch(s, arms) => EMatch(edp_find_rewrite_handles(s, ename, needing), for a in arms {
      let (p, ex) = a
      (p, edp_find_rewrite_handles(ex, ename, needing))
    }),
    EWhile(c, b) => EWhile(edp_find_rewrite_handles(c, ename, needing), edp_find_rewrite_handles(b, ename, needing)),
    EForIn(n, idx, it, b) => EForIn(n, idx, edp_find_rewrite_handles(it, ename, needing), edp_find_rewrite_handles(b, ename, needing)),
    ECall(callee, args, off) => ECall(edp_find_rewrite_handles(callee, ename, needing), for a in args {
      edp_find_rewrite_handles(a, ename, needing)
    }, off),
    EBinOp(op, l, r) => EBinOp(op, edp_find_rewrite_handles(l, ename, needing), edp_find_rewrite_handles(r, ename, needing)),
    EUnaryOp(op, e2) => EUnaryOp(op, edp_find_rewrite_handles(e2, ename, needing)),
    EAssign(n, v, c) => EAssign(n, edp_find_rewrite_handles(v, ename, needing), edp_find_rewrite_handles(c, ename, needing)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, edp_find_rewrite_handles(v, ename, needing), edp_find_rewrite_handles(c, ename, needing)),
    EDot(o, f, off1, off2) => EDot(edp_find_rewrite_handles(o, ename, needing), f, off1, off2),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, edp_find_rewrite_handles(v, ename, needing)),
    EReturn(e2) => EReturn(edp_find_rewrite_handles(e2, ename, needing)),
    EBreak(opt) => EBreak(match opt {
      Some(e2) => Some(edp_find_rewrite_handles(e2, ename, needing)),
      None => None
    }),
    EContinue(args) => EContinue(for a in args {
      edp_find_rewrite_handles(a, ename, needing)
    }),
    ETuple(elems) => ETuple(for a in elems {
      edp_find_rewrite_handles(a, ename, needing)
    }),
    EArray(elems) => EArray(for a in elems {
      edp_find_rewrite_handles(a, ename, needing)
    }),
    ERecord(n, fields, tas) => ERecord(n, for f in fields {
      let (fn2, v) = f
      (fn2, edp_find_rewrite_handles(v, ename, needing))
    }, tas),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, edp_find_rewrite_handles(v, ename, needing))
    }),
    ESpread(e2) => ESpread(edp_find_rewrite_handles(e2, ename, needing)),
    ELoop(pairs, b) => ELoop(for p in pairs {
      let (n, v) = p
      (n, edp_find_rewrite_handles(v, ename, needing))
    }, edp_find_rewrite_handles(b, ename, needing)),
    _ => expr
  }
}

/// ============================================================
/// ADR-0076 Phase 3a+3b (#817, docs/effect-evidence-passing.md 追記27-29):
/// suspend CPS -- lowering for the third handler class ("suspend": a
/// handler arm STORES `resume` as a first-class value and calls it later,
/// at most once, from a different dynamic extent -- exactly ADR-0068's
/// Async::suspend shape, the scheduler primitive @vibex/concurrent needs).
///
/// Trigger: a `handle` site where at least one arm references `resume` as a
/// bare VALUE (not only as the direct call `resume(x)` -- #942 keeps the
/// tail constraint on that form, and the checker's arm-scope binding of
/// `resume` makes the value form legal in declared-effect arms). Sites with
/// no value reference are completely untouched -- they keep today's
/// replay / Phase-2-inline / evidence-dict paths bit-for-bit.
///
/// Lowering (everything built from EXISTING AST nodes -- no new IR, no new
/// runtime type). Per EFFECT E (injected once, shared by every site and
/// clone -- 3b's call-crossing requires a step type independent of any one
/// handle site):
///
///   enum __ScpsStep_E {                    // variants keyed by NAME
///     __ScpsDone_E(R);                     // computation finished with R
///     __ScpsY_E_op(P..., (Q) -> __ScpsStep_E)  // one per DECLARED op:
///   }                                      //   payload + continuation
///
///   let rec __scps_bubble_E = (st, k) -> match st {   // step composition
///     __ScpsDone_E(v) => k(v),
///     __ScpsY_E_op(p.., kk) => __ScpsY_E_op(p.., (rv) ->
///       __scps_bubble_E(kk(rv), k))        // re-wrap: bubble one level up
///   }
///
/// Per triggered handle site: the body is split at each direct `perform`
/// on its evaluation spine into continuation closures producing
/// __ScpsStep_E values, and the whole handle expression becomes
///
///   let rec __scps_driveN = (st) -> match st {
///     __ScpsDone_E(v) => v,
///     __ScpsY_E_op(p.., k) => {
///       let __scps_onceN = [false]
///       let resume = (rv) -> if __scps_onceN[0] { diag + trap } else {
///         __scps_onceN[0] = true; __scps_driveN(k(rv)) }
///       ARM                              // original arm body, unchanged --
///     }                                  // `resume` is now a plain local
///   }
///   __scps_driveN(<split body>)
///
/// 3b (yield bubbling / selective CPS, wasm_of_ocaml-style): a call in the
/// body (or in a clone body) to a named top-level function `f` whose
/// declared row CONTAINS E is now supported. A CPS CLONE `__scps_cps_E_f`
/// is synthesized -- f's body run through the SAME spine split, so the
/// clone returns __ScpsStep_E (its direct performs become __ScpsY
/// constructions, its own calls to other row-carrying functions become
/// bubble compositions, recursively over a worklist). The ORIGINAL f is
/// left completely untouched for every other caller (tail-resumptive
/// handles via replay / Phase 2 / evidence-dict) -- the double-compilation
/// approach, so this pass never conflicts with those paths. Call sites in
/// suspend-lowered code become
///
///   let x = f(a)  REST   ==>   __scps_bubble_E(__scps_cps_E_f(a),
///                                              (x) -> <split REST>)
///   tail f(a)            ==>   __scps_cps_E_f(a)      // step passthrough
///
/// A clone's EFn carries eff=None deliberately: evidence_dict_pass scans
/// declared rows to build its needing set, and a clone (whose performs are
/// already gone) must not sink an effect's evidence eligibility.
///
///   An arm that stores `resume` and returns without calling it makes the
///   whole handle return the arm's value (the suspend). Calling the stored
///   closure later runs the remaining body up to the next perform, where the
///   SAME driver dispatches the next arm -- a scheduler receives the next
///   continuation exactly as ADR-0068 requires. One-shot is enforced
///   dynamically: the second call of the same continuation writes a
///   diagnostic to stderr and traps (assert(false) miscompiles inside
///   closures, #1095, and Exception::Throw would leak past a no-Error-row
///   entry as a raw exception -- see the trap construction below). Direct
///   tail `resume(v)` calls in a triggered arm route through the same
///   closure (codegen's prefer_bound_call), so the one-shot flag covers
///   them too.
///
/// Eligibility (checked per site and per clone; an INELIGIBLE triggered
/// site is a hard compile error via the returned error list -- never a
/// silent fallback, because a value-referencing arm cannot compile on the
/// replay path at all):
///   - every `perform` of a handled operation, and every call to a
///     row-carrying (needing) function, appears directly on the body's
///     let/seq/tail/branch-tail spine, which includes a `while` / `loop`
///     body (converted to a recursive step-returning closure, #1230/#1536 --
///     including one carrying `break` / `continue`, but not `return`).
///     `for` forms and nested expression positions are not eligible;
///   - every OTHER call in the body is provably unable to perform E:
///     a `perform` of another effect, a hand-audited pure builtin
///     (idp_pure_builtin_names), an enum/suberror constructor application,
///     or a named top-level function whose declared row is CONCRETE and
///     does not contain E (checker row soundness: an unhandled perform of
///     E inside f forces E -- or a row variable -- into f's declared row,
///     so a concrete E-free row cannot reach one). A row-VARIABLE row
///     (`with e` / `with X + e`) on a non-needing callee is
///     ineligible -- the variable could be instantiated to E via a closure
///     argument this pass cannot see;
///   - no nested handle, and no closure containing a handled-op perform or
///     needing call.
/// Arm BODIES are unrestricted (under the driver they are plain code).
///
/// Runs from compile_wasi_module_linked_impl (linear backend) BEFORE
/// inline_direct_performs / evidence_dict_pass, so those passes only ever
/// see the sites this one left alone. The gc backend does not run this pass
/// (linear-first per 追記27) -- a resume-value program on gc fails loudly in
/// gc codegen instead.
export fn suspend_cps_pass(stmts: Array[Stmt]) -> Array[String] {
  let errs = array_empty_str()
  // #1102 perf: allocation-free pre-scan. scps_rewrite reconstructs every
  // node, so it must only run on statements that actually contain a
  // triggered handle — and when NOTHING triggers (every ordinary program,
  // including the compiler itself), skip the fact-table construction
  // below entirely. See scps_expr_has_trigger.
  let mut any_trigger = false
  let mut i0 = 0
  while i0 < Array::length(stmts) {
    if scps_stmt_has_trigger(Array::get(stmts, i0)) {
      any_trigger = true
    } else {
      ()
    }
    i0 = i0 + 1
  }
  if !any_trigger {
    errs
  } else {
    let effect_defs = edp_collect_effect_defs(stmts)
    let fn_defs = edp_collect_fn_defs(stmts)
    let es_names = array_empty()
    let es_members_list = array_empty()
    edp_es_collect_into(stmts, es_names, es_members_list)
    let ctor_names = scps_collect_ctor_names(stmts)
    let ctx = (stmts, effect_defs, fn_defs, es_names, es_members_list, ctor_names)
    let st = (scps_ctr_box(), array_empty_str(), array_empty_str(), array_empty_str(), array_empty_str(), scps_empty_stmts(), errs)
    // closure-CPS (追記31 Vertical B) phase 1: the CPS-mode effect set.
    let cps_effs = scps_collect_cps_effs(stmts)
    let ecfgs = array_empty_ecfg()
    let mut ce = 0
    while ce < Array::length(cps_effs) {
      Array::push(ecfgs, scps_ecfg_for(ctx, Array::get(cps_effs, ce)))
      ce = ce + 1
    }
    // phase 2 (prepass, ALL statements): step-split needing literals and fix
    // up arg conventions at E-row param positions. Records which effects got
    // step-compiled closure values (split_effs) for the phase-5 guard.
    let split_effs = array_empty_str()
    let mut ip = 0
    while ip < (if Array::length(ecfgs) > 0 {
      Array::length(stmts)
    } else {
      0
    }) {
      match Array::get(stmts, ip) {
        // A TOP-LEVEL fn value is the 3b needing-fn world: the ORIGINAL must
        // stay untouched (dual entry -- cps callers go through the
        // __scps_cps_* clone), so the literal-split rule must not apply to
        // the top node itself; only its body's NESTED literals are prepass
        // material. Splitting it here double-wrapped the clone (emit_clone
        // re-split an already-split body into Done(Y(..))).
        SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, ip, SLet(exported, is_rec, name, ty, match expr {
          EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, scps_prepass_expr(b, ecfgs, ctx, st, split_effs)),
          _ => scps_prepass_expr(expr, ecfgs, ctx, st, split_effs)
        })),
        SLetMut(name, ty, expr) => Array::set(stmts, ip, SLetMut(name, ty, match expr {
          EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, scps_prepass_expr(b, ecfgs, ctx, st, split_effs)),
          _ => scps_prepass_expr(expr, ecfgs, ctx, st, split_effs)
        })),
        SExpr(expr) => Array::set(stmts, ip, SExpr(scps_prepass_expr(expr, ecfgs, ctx, st, split_effs))),
        STest(tn, expr) => Array::set(stmts, ip, STest(tn, scps_prepass_expr(expr, ecfgs, ctx, st, split_effs))),
        SBench(bn, expr) => Array::set(stmts, ip, SBench(bn, scps_prepass_expr(expr, ecfgs, ctx, st, split_effs))),
        _ => ()
      }
      ip = ip + 1
    }
    // phase 3: transform triggered handle sites (scope threads the lexical
    // step-typed bindings down to each site).
    let scope = array_empty_scope()
    let mut i = 0
    while i < Array::length(stmts) {
      if scps_stmt_has_trigger(Array::get(stmts, i)) {
        match Array::get(stmts, i) {
          SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, i, SLet(exported, is_rec, name, ty, scps_rewrite(expr, ctx, st, cps_effs, scope))),
          SLetMut(name, ty, expr) => Array::set(stmts, i, SLetMut(name, ty, scps_rewrite(expr, ctx, st, cps_effs, scope))),
          SExpr(expr) => Array::set(stmts, i, SExpr(scps_rewrite(expr, ctx, st, cps_effs, scope))),
          STest(tn, expr) => Array::set(stmts, i, STest(tn, scps_rewrite(expr, ctx, st, cps_effs, scope))),
          SBench(bn, expr) => Array::set(stmts, i, SBench(bn, scps_rewrite(expr, ctx, st, cps_effs, scope))),
          _ => ()
        }
      } else {
        ()
      }
      i = i + 1
    }
    // phase 4: process the clone worklist -- it can grow while being
    // processed (a clone's own body may need further clones).
    let (_, _, _, q_eff, q_fn, inj, _) = st
    let mut qi = 0
    while qi < Array::length(q_fn) {
      scps_emit_clone(Array::get(q_eff, qi), Array::get(q_fn, qi), ctx, st)
      qi = qi + 1
    }
    let mut j = 0
    while j < Array::length(inj) {
      Array::push(stmts, Array::get(inj, j))
      j = j + 1
    }
    // phase 5: convention-consistency guard.
    if Array::length(split_effs) > 0 {
      let mut gi = 0
      while gi < Array::length(stmts) {
        match scps_stmt_expr_of(Array::get(stmts, gi)) {
          Some(expr) => scps_guard_untriggered(expr, split_effs, errs),
          None => ()
        }
        gi = gi + 1
      }
    } else {
      ()
    }
    errs
  }
}

// --- pass state accessors. st = (site counter box, injected effect list,
// clone keys ("E||f"), clone queue effects, clone queue fn names,
// injected stmts, errors).

fn scps_ctr_box() -> Array[Int] {
  [
    0
  ]
}

fn scps_next_site(st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Int {
  let (ctr, _, _, _, _, _, _) = st
  let site = Array::get(ctr, 0)
  Array::set(ctr, 0, site + 1)
  site
}

fn scps_st_errs(st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Array[String] {
  let (_, _, _, _, _, _, errs) = st
  errs
}

fn scps_st_inj(st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Array[Stmt] {
  let (_, _, _, _, _, inj, _) = st
  inj
}

// --- typed-empty helpers (function-signature-driven literal typing, same
// trick as array_empty_str/array_empty_expr above).

fn scps_empty_stmts() -> Array[Stmt] {
  Array::slice([
    SExpr(EUnit)
  ], 0, 0)
}

fn scps_empty_pats() -> Array[Pat] {
  Array::slice([
    PWild
  ], 0, 0)
}

fn scps_empty_arms() -> Array[(Pat, Expr)] {
  Array::slice([
    (PWild, EUnit)
  ], 0, 0)
}

fn scps_empty_tys() -> Array[TypeExpr] {
  Array::slice([
    TyUnit
  ], 0, 0)
}

fn scps_empty_ctors() -> Array[(String, Array[TypeExpr])] {
  Array::slice([
    ("", scps_empty_tys())
  ], 0, 0)
}

fn scps_empty_tbs() -> Array[(String, Array[String])] {
  Array::slice([
    ("", array_empty_str())
  ], 0, 0)
}

fn scps_empty_params() -> Array[(String, Option[TypeExpr])] {
  Array::slice([
    ("", None)
  ], 0, 0)
}

/// One-parameter closure literal -- continuation, resume wrapper, and driver
/// are all 1-param closures.
fn scps_mk_fn1(param: String, body: Expr) -> Expr {
  let ps = scps_empty_params()
  Array::push(ps, (param, None))
  EFn(array_empty_str(), scps_empty_tbs(), ps, None, None, body)
}

fn scps_mk_fn2(p1: String, p2: String, body: Expr) -> Expr {
  let ps = scps_empty_params()
  Array::push(ps, (p1, None))
  Array::push(ps, (p2, None))
  EFn(array_empty_str(), scps_empty_tbs(), ps, None, None, body)
}

// --- generated-name builders. Step/Done/Y are PER-EFFECT (shared across
// sites and clones); driver locals get a per-site ordinal.

fn scps_step_name(eff: String) -> String {
  String::concat("__ScpsStep_", eff)
}

fn scps_done_name(eff: String) -> String {
  String::concat("__ScpsDone_", eff)
}

fn scps_y_name(eff: String, opname: String) -> String {
  String::concat(String::concat(String::concat("__ScpsY_", eff), "_"), opname)
}

fn scps_bubble_name(eff: String) -> String {
  String::concat("__scps_bubble_", eff)
}

fn scps_sanitize(name: String) -> String {
  let parts = String::split(name, "::")
  String::join(parts, "__")
}

fn scps_clone_name(eff: String, fname: String) -> String {
  String::concat(String::concat(String::concat("__scps_cps_", eff), "_"), scps_sanitize(fname))
}

fn scps_local(prefix: String, site: Int) -> String {
  String::concat(prefix, Int::to_string(site))
}

fn scps_op_suffix(qname: String) -> String {
  let ci = String::index_of(qname, "::")
  if ci > 0 {
    String::substring(qname, ci + 2, String::length(qname))
  } else {
    qname
  }
}

// --- program-fact helpers over the pass context. ctx = (stmts, effect
// defs, fn defs, effectset names, effectset member lists, ctor names).

fn scps_collect_ctor_names(stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty_str()
  Array::push(out, "Some")
  Array::push(out, "Ok")
  Array::push(out, "Err")
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(_, _, _, ctors, _) => {
        let mut ci = 0
        while ci < Array::length(ctors) {
          let (cn, _) = Array::get(ctors, ci)
          Array::push(out, cn)
          ci = ci + 1
        }
      },
      SSuberror(_, _, ctors) => {
        let mut ci = 0
        while ci < Array::length(ctors) {
          let (cn, _) = Array::get(ctors, ci)
          Array::push(out, cn)
          ci = ci + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Declared ops of `eff` as (opname, arity); found=false when `eff` is not
/// a declared effect in this program.
fn scps_effect_decl_ops(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), eff: String) -> (Bool, Array[(String, Int)]) {
  let (_, effect_defs, _, _, _, _) = ctx
  let out = Array::slice([
    ("", 0)
  ], 0, 0)
  let mut found = false
  let mut i = 0
  while i < Array::length(effect_defs) {
    let (name, ops) = Array::get(effect_defs, i)
    if name == eff {
      found = true
      let mut oi = 0
      while oi < Array::length(ops) {
        let (opname, params, _) = Array::get(ops, oi)
        Array::push(out, (opname, Array::length(params)))
        oi = oi + 1
      }
    } else {
      ()
    }
    i = i + 1
  }
  (found, out)
}

/// Top-level functions whose declared row CONTAINS eff (effectset-aware,
/// via the same edp_row_is_exactly containment evidence_dict_pass uses).
fn scps_needing_for(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), eff: String) -> Array[String] {
  let (_, _, fn_defs, es_names, es_members_list, _) = ctx
  edp_needing_names(fn_defs, eff, es_names, es_members_list)
}

/// (is a known top-level fn, its declared row string -- "" for none).
fn scps_fn_row_of(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), name: String) -> (Bool, String) {
  let (_, _, fn_defs, _, _, _) = ctx
  let mut found = false
  let mut row = ""
  let mut i = 0
  while i < Array::length(fn_defs) {
    let (_, _, _, fname, _, frow) = Array::get(fn_defs, i)
    if fname == name {
      found = true
      row = frow
    } else {
      ()
    }
    i = i + 1
  }
  (found, row)
}

/// A row item starting with a lowercase letter is a row VARIABLE (`with
/// { e }` / `with X + e`): the variable can be instantiated to the
/// migrated effect via a closure argument this pass cannot see, so such a
/// callee is never "provably E-free". Effect names / effectset aliases /
/// qualified ops are all capitalized or contain `::`.
fn scps_row_has_var(row: String) -> Bool {
  if row == "" {
    false
  } else {
    let parts = String::split(row, ",")
    let mut has = false
    let mut i = 0
    while i < Array::length(parts) {
      let item = String::trim(Array::get(parts, i))
      if String::length(item) > 0 && String::index_of(item, "::") < 0 {
        let c = String::char_code_at(item, 0)
        if c >= 97 && c <= 122 {
          has = true
        } else {
          ()
        }
      } else {
        ()
      }
      i = i + 1
    }
    has
  }
}

fn scps_row_contains(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), row: String, eff: String) -> Bool {
  let (_, _, _, es_names, es_members_list, _) = ctx
  if row == "" {
    false
  } else {
    edp_row_is_exactly(row, eff, es_names, es_members_list)
  }
}

fn scps_is_ctor_name(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), nm: String) -> Bool {
  let (_, _, _, _, _, ctor_names) = ctx
  edp_str_array_contains(ctor_names, nm)
}

// --- trigger detection: does an arm body reference `resume` as a bare
// value (not as the immediate callee of a call)? Shadow tracking mirrors
// checker.vibe's check_arm_resume_tail: any enclosing binder named
// `resume` turns references into ordinary variable uses.

fn scps_pat_binds_resume(p: Pat) -> Bool {
  match p {
    PBind(n) => n == "resume",
    PCtor(_, ps) => scps_pats_bind_resume(ps),
    PTuple(ps) => scps_pats_bind_resume(ps),
    POr(a, b) => scps_pat_binds_resume(a) || scps_pat_binds_resume(b),
    PStruct(_, fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        if scps_pat_binds_resume(fp) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

fn scps_pats_bind_resume(ps: Array[Pat]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(ps) {
    if scps_pat_binds_resume(Array::get(ps, i)) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn scps_fn_params_bind_resume(params: Array[(String, Option[TypeExpr])]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(params) {
    let (pn, _) = Array::get(params, i)
    let ln = String::length(pn)
    let base = if ln > 0 && pn[ln - 1: ln] == "~" {
      pn[0: ln - 1]
    } else {
      pn
    }
    if base == "resume" {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn scps_arm_refs_resume_value(e: Expr, sh: Bool) -> Bool {
  match e {
    EIdent(nm, _) => nm == "resume" && !sh,
    ECall(callee, args, _) => {
      // The immediate callee position `resume(x)` is the direct call form
      // (#942's territory), NOT a value reference. Everything else in the
      // call -- including a computed callee -- is walked normally.
      let callee_hit = match callee {
        EIdent(_, _) => false,
        _ => scps_arm_refs_resume_value(callee, sh)
      }
      callee_hit || scps_exprs_ref_resume_value(args, sh)
    },
    ELet(n, v, b, _) => scps_arm_refs_resume_value(v, sh) || scps_arm_refs_resume_value(b, sh || n == "resume"),
    ELetMut(n, v, b, _) => scps_arm_refs_resume_value(v, sh) || scps_arm_refs_resume_value(b, sh || n == "resume"),
    ELetRec(n, v, b) => scps_arm_refs_resume_value(v, sh || n == "resume") || scps_arm_refs_resume_value(b, sh || n == "resume"),
    ESeq(a, b) => scps_arm_refs_resume_value(a, sh) || scps_arm_refs_resume_value(b, sh),
    EIf(c, t, el) => scps_arm_refs_resume_value(c, sh) || scps_arm_refs_resume_value(t, sh) || scps_arm_refs_resume_value(el, sh),
    EMatch(s, arms) => {
      let mut hit = scps_arm_refs_resume_value(s, sh)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        if scps_arm_refs_resume_value(ex, sh || scps_pat_binds_resume(p)) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EHandle(b, arms) => {
      let mut hit = scps_arm_refs_resume_value(b, sh)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, i)
        // A nested handle's arms rebind `resume` for THEMSELVES (their
        // value references belong to the inner site, detected when the
        // rewrite reaches that inner EHandle) -- shadowed here.
        if scps_arm_refs_resume_value(ex, true) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EFn(_, _, params, _, _, b) => scps_arm_refs_resume_value(b, sh || scps_fn_params_bind_resume(params)),
    EWhile(c, b) => scps_arm_refs_resume_value(c, sh) || scps_arm_refs_resume_value(b, sh),
    EForIn(v1, v2, it, b) => {
      let for_sh = v1 == "resume" || (match v2 {
        Some(v2n) => v2n == "resume",
        None => false
      })
      scps_arm_refs_resume_value(it, sh) || scps_arm_refs_resume_value(b, sh || for_sh)
    },
    ELoop(pairs, b) => {
      let mut hit = false
      let mut loop_sh = sh
      let mut i = 0
      while i < Array::length(pairs) {
        let (n, v) = Array::get(pairs, i)
        if n == "resume" {
          loop_sh = true
        } else {
          ()
        }
        if scps_arm_refs_resume_value(v, sh) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit || scps_arm_refs_resume_value(b, loop_sh)
    },
    EBinOp(_, l, r) => scps_arm_refs_resume_value(l, sh) || scps_arm_refs_resume_value(r, sh),
    EUnaryOp(_, e2) => scps_arm_refs_resume_value(e2, sh),
    EAssign(_, v, c) => scps_arm_refs_resume_value(v, sh) || scps_arm_refs_resume_value(c, sh),
    EAssignOp(_, _, v, c) => scps_arm_refs_resume_value(v, sh) || scps_arm_refs_resume_value(c, sh),
    EReturn(e2) => scps_arm_refs_resume_value(e2, sh),
    EDot(o, _, _, _) => scps_arm_refs_resume_value(o, sh),
    ELabeledArg(_, _, v) => scps_arm_refs_resume_value(v, sh),
    EBreak(opt) => match opt {
      Some(e2) => scps_arm_refs_resume_value(e2, sh),
      None => false
    },
    EContinue(args) => scps_exprs_ref_resume_value(args, sh),
    ETuple(elems) => scps_exprs_ref_resume_value(elems, sh),
    EArray(elems) => scps_exprs_ref_resume_value(elems, sh),
    ERecord(_, fields, _) => scps_fields_ref_resume_value(fields, sh),
    EMap(fields) => scps_fields_ref_resume_value(fields, sh),
    ESpread(e2) => scps_arm_refs_resume_value(e2, sh),
    _ => false
  }
}

fn scps_exprs_ref_resume_value(es: Array[Expr], sh: Bool) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(es) {
    if scps_arm_refs_resume_value(Array::get(es, i), sh) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_fields_ref_resume_value(fields: Array[(String, Expr)], sh: Bool) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    if scps_arm_refs_resume_value(v, sh) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

// --- handled-op perform / needing-call detection. sctx = (effect name,
// qualified op names ("E::op", declaration order), needing fn names,
// per-site ordinal for generated locals).

fn scps_op_index(ops: Array[String], q: String) -> Int {
  let mut i = 0
  let mut found = -1
  while i < Array::length(ops) {
    if Array::get(ops, i) == q {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// If `e` is exactly `perform Op(args)` / `perform Op` for a handled op,
/// return the op's index in ops; -1 otherwise.
fn scps_as_target_perform(e: Expr, ops: Array[String]) -> Int {
  match e {
    ECall(callee, pargs, _) => match callee {
      EIdent(nm, _) => if nm == "perform" && Array::length(pargs) == 1 {
        match Array::get(pargs, 0) {
          EIdent(q, _) => scps_op_index(ops, q),
          ECall(opc, _, _) => match opc {
            EIdent(q, _) => scps_op_index(ops, q),
            _ => -1
          },
          _ => -1
        }
      } else {
        -1
      },
      _ => -1
    },
    _ => -1
  }
}

fn scps_perform_args(e: Expr) -> Array[Expr] {
  match e {
    ECall(_, pargs, _) => if Array::length(pargs) == 1 {
      match Array::get(pargs, 0) {
        ECall(_, op_args, _) => op_args,
        _ => array_empty_expr()
      }
    } else {
      array_empty_expr()
    },
    _ => array_empty_expr()
  }
}

/// If `e` is a call to a needing (row-contains-E) top-level function,
/// return its name; "" otherwise.
fn scps_as_needing_call(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String])) -> String {
  let (_, _, needing, _, _) = sctx
  match e {
    ECall(callee, _, _) => match callee {
      EIdent(nm, _) => if nm != "perform" && edp_str_array_contains(needing, nm) {
        nm
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

fn scps_call_args(e: Expr) -> Array[Expr] {
  match e {
    ECall(_, args, _) => args,
    _ => array_empty_expr()
  }
}

// --- closure-CPS (ADR-0076 追記31 Vertical B) helpers. A "cps local" is a
// binding in scope whose closure value is compiled step-returning for the
// handled effect: a param whose declared TyFn row contains E, or a local
// let-bound to a literal the prepass step-split. Calls through one are
// needing-shaped (the call already returns __ScpsStep_E) but need NO clone.

fn scps_as_cps_local_call(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String])) -> String {
  let (_, _, _, _, cps_locals) = sctx
  match e {
    ECall(callee, _, _) => match callee {
      EIdent(nm, _) => if edp_str_array_contains(cps_locals, nm) {
        nm
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

/// The row string of a function-typed annotation, "" when absent/not a fn.
fn scps_ty_row(ty: Option[TypeExpr]) -> String {
  match ty {
    Some(t) => match t {
      TyFn(_, _, row_opt) => match row_opt {
        Some(row) => row,
        None => ""
      },
      _ => ""
    },
    None => ""
  }
}

/// Is `v` an EFn literal already step-split for `eff` (its body mentions the
/// generated step runtime for that effect)? The generated namespace is
/// reserved (`__Scps`/`__scps_`), so a mention is unambiguous.
///
/// #1371: a CPS CLONE call counts too. A literal whose body is a bare TAIL
/// call to a needing fn splits to the step PASSTHROUGH form
/// (`__scps_cps_E_f(a)`, see scps_split_tail) -- it constructs no step of its
/// own, so it mentions none of the other three names. Missing it here made
/// the arg-position fixup in scps_prepass_expr split the literal a SECOND
/// time, Done-wrapping a body that already returns a step: the task settled
/// with the step OBJECT as its value (a heap pointer read back as the
/// result) and the continuation was never resumed, so a `throw` past the
/// first suspension never ran either. Both call sites that ask this question
/// (the arg-position fixup and the let-bound cps-local rule) need the clone
/// form to answer yes.
fn scps_literal_is_step_for(v: Expr, eff: String) -> Bool {
  match v {
    EFn(_, _, _, _, _, b) => {
      let dn = scps_done_name(eff)
      let bn = scps_bubble_name(eff)
      scps_mentions_step(b, dn, scps_y_name(eff, ""), bn) || scps_mentions_step(b, dn, scps_clone_name(eff, ""), bn)
    },
    _ => false
  }
}

fn scps_mentions_step(e: Expr, dn: String, yprefix: String, bn: String) -> Bool {
  match e {
    EIdent(nm, _) => nm == dn || nm == bn || String::starts_with(nm, yprefix),
    ECall(callee, args, _) => scps_mentions_step(callee, dn, yprefix, bn) || scps_exprs_mention_step(args, dn, yprefix, bn),
    ELet(_, v, b, _) => scps_mentions_step(v, dn, yprefix, bn) || scps_mentions_step(b, dn, yprefix, bn),
    ELetMut(_, v, b, _) => scps_mentions_step(v, dn, yprefix, bn) || scps_mentions_step(b, dn, yprefix, bn),
    ELetRec(_, v, b) => scps_mentions_step(v, dn, yprefix, bn) || scps_mentions_step(b, dn, yprefix, bn),
    ESeq(a, b) => scps_mentions_step(a, dn, yprefix, bn) || scps_mentions_step(b, dn, yprefix, bn),
    EIf(c, t, el) => scps_mentions_step(c, dn, yprefix, bn) || scps_mentions_step(t, dn, yprefix, bn) || scps_mentions_step(el, dn, yprefix, bn),
    EMatch(s, arms) => {
      let mut hit = scps_mentions_step(s, dn, yprefix, bn)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, i)
        if scps_mentions_step(ex, dn, yprefix, bn) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EHandle(s, arms) => {
      let mut hit = scps_mentions_step(s, dn, yprefix, bn)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, i)
        if scps_mentions_step(ex, dn, yprefix, bn) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EFn(_, _, _, _, _, b) => scps_mentions_step(b, dn, yprefix, bn),
    EWhile(c, b) => scps_mentions_step(c, dn, yprefix, bn) || scps_mentions_step(b, dn, yprefix, bn),
    EForIn(_, _, it, b) => scps_mentions_step(it, dn, yprefix, bn) || scps_mentions_step(b, dn, yprefix, bn),
    EBinOp(_, l, r) => scps_mentions_step(l, dn, yprefix, bn) || scps_mentions_step(r, dn, yprefix, bn),
    EUnaryOp(_, x) => scps_mentions_step(x, dn, yprefix, bn),
    EAssign(_, v, c) => scps_mentions_step(v, dn, yprefix, bn) || scps_mentions_step(c, dn, yprefix, bn),
    EAssignOp(_, _, v, c) => scps_mentions_step(v, dn, yprefix, bn) || scps_mentions_step(c, dn, yprefix, bn),
    EReturn(x) => scps_mentions_step(x, dn, yprefix, bn),
    EDot(o, _, _, _) => scps_mentions_step(o, dn, yprefix, bn),
    ELabeledArg(_, _, v) => scps_mentions_step(v, dn, yprefix, bn),
    EBreak(opt) => match opt {
      Some(x) => scps_mentions_step(x, dn, yprefix, bn),
      None => false
    },
    EContinue(args) => scps_exprs_mention_step(args, dn, yprefix, bn),
    ETuple(items) => scps_exprs_mention_step(items, dn, yprefix, bn),
    EArray(items) => scps_exprs_mention_step(items, dn, yprefix, bn),
    ERecord(_, fields, _) => scps_fields_mention_step(fields, dn, yprefix, bn),
    EMap(fields) => scps_fields_mention_step(fields, dn, yprefix, bn),
    ESpread(x) => scps_mentions_step(x, dn, yprefix, bn),
    ELoop(pairs, b) => {
      let mut hit = scps_mentions_step(b, dn, yprefix, bn)
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, v) = Array::get(pairs, i)
        if scps_mentions_step(v, dn, yprefix, bn) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    _ => false
  }
}

fn scps_exprs_mention_step(es: Array[Expr], dn: String, yprefix: String, bn: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(es) {
    if scps_mentions_step(Array::get(es, i), dn, yprefix, bn) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_fields_mention_step(fields: Array[(String, Expr)], dn: String, yprefix: String, bn: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    if scps_mentions_step(v, dn, yprefix, bn) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// Does the subtree contain a SUSPENDABLE -- a perform of a handled op or
/// a call to a needing function -- ANYWHERE, including inside nested
/// closures and nested handles (both make its timing/ownership dynamic,
/// which the spine split must treat as ineligible in that position)?
fn scps_contains_susp(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {
  let (_, ops, _, _, _) = sctx
  if scps_as_target_perform(e, ops) >= 0 || scps_as_needing_call(e, sctx) != "" || scps_as_cps_local_call(e, sctx) != "" {
    true
  } else {
    match e {
      ECall(callee, args, _) => scps_contains_susp(callee, sctx) || scps_exprs_contain_susp(args, sctx),
      ELet(_, v, b, _) => scps_contains_susp(v, sctx) || scps_contains_susp(b, sctx),
      ELetMut(_, v, b, _) => scps_contains_susp(v, sctx) || scps_contains_susp(b, sctx),
      ELetRec(_, v, b) => scps_contains_susp(v, sctx) || scps_contains_susp(b, sctx),
      ESeq(a, b) => scps_contains_susp(a, sctx) || scps_contains_susp(b, sctx),
      EIf(c, t, el) => scps_contains_susp(c, sctx) || scps_contains_susp(t, sctx) || scps_contains_susp(el, sctx),
      EMatch(s, arms) => scps_contains_susp(s, sctx) || scps_arms_contain_susp(arms, sctx),
      EHandle(b, arms) => scps_contains_susp(b, sctx) || scps_arms_contain_susp(arms, sctx),
      EFn(_, _, _, _, _, b) => scps_contains_susp(b, sctx),
      EWhile(c, b) => scps_contains_susp(c, sctx) || scps_contains_susp(b, sctx),
      EForIn(_, _, it, b) => scps_contains_susp(it, sctx) || scps_contains_susp(b, sctx),
      ELoop(pairs, b) => scps_pairs_contain_susp(pairs, sctx) || scps_contains_susp(b, sctx),
      EBinOp(_, l, r) => scps_contains_susp(l, sctx) || scps_contains_susp(r, sctx),
      EUnaryOp(_, e2) => scps_contains_susp(e2, sctx),
      EAssign(_, v, c) => scps_contains_susp(v, sctx) || scps_contains_susp(c, sctx),
      EAssignOp(_, _, v, c) => scps_contains_susp(v, sctx) || scps_contains_susp(c, sctx),
      EReturn(e2) => scps_contains_susp(e2, sctx),
      EDot(o, _, _, _) => scps_contains_susp(o, sctx),
      ELabeledArg(_, _, v) => scps_contains_susp(v, sctx),
      EBreak(opt) => match opt {
        Some(e2) => scps_contains_susp(e2, sctx),
        None => false
      },
      EContinue(args) => scps_exprs_contain_susp(args, sctx),
      ETuple(elems) => scps_exprs_contain_susp(elems, sctx),
      EArray(elems) => scps_exprs_contain_susp(elems, sctx),
      ERecord(_, fields, _) => scps_fields_contain_susp(fields, sctx),
      EMap(fields) => scps_fields_contain_susp(fields, sctx),
      ESpread(e2) => scps_contains_susp(e2, sctx),
      _ => false
    }
  }
}

fn scps_exprs_contain_susp(es: Array[Expr], sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(es) {
    if scps_contains_susp(Array::get(es, i), sctx) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_fields_contain_susp(fields: Array[(String, Expr)], sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    if scps_contains_susp(v, sctx) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_pairs_contain_susp(pairs: Array[(String, Expr)], sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, i)
    if scps_contains_susp(v, sctx) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_arms_contain_susp(arms: Array[(Pat, Expr)], sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(arms) {
    let (_, ex) = Array::get(arms, i)
    if scps_contains_susp(ex, sctx) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// --- body call policy: a call in a suspend-lowered body must be provably
/// unable to perform E outside this pass's sight. Safe: `perform` itself,
/// a hand-audited pure builtin, an enum/suberror ctor application, a
/// needing function (its clone is split the same way), or a named
/// top-level function whose declared row is CONCRETE and E-free (checker
/// row soundness -- see the module doc). Everything else -- local
/// closures, method-style callees, row-variable rows, nested handles --
/// is ineligible.
fn scps_calls_ok(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Bool {
  let (eff, _, needing, _, cps_locals) = sctx
  match e {
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if nm == "perform" && Array::length(args) == 1 {
        match Array::get(args, 0) {
          EIdent(_, _) => true,
          ECall(opc, op_args, _) => match opc {
            EIdent(_, _) => scps_exprs_calls_ok(op_args, sctx, ctx),
            _ => false
          },
          _ => false
        }
      } else if idp_is_pure_builtin_call(nm) || scps_is_safe_mut_builtin(nm) || scps_is_ctor_name(ctx, nm) || edp_str_array_contains(needing, nm) {
        scps_exprs_calls_ok(args, sctx, ctx)
      } else if edp_str_array_contains(cps_locals, nm) || String::starts_with(nm, "__scps_") || String::starts_with(nm, "__Scps") {
        // closure-CPS (追記31 Vertical B): a call through a step-typed
        // closure binding returns __ScpsStep_E directly, and the reserved
        // generated namespace (step ctors / bubble / clones referenced by
        // an already-split literal body) is safe by construction.
        scps_exprs_calls_ok(args, sctx, ctx)
      } else {
        let (is_fn, row) = scps_fn_row_of(ctx, nm)
        if is_fn && !scps_row_contains(ctx, row, eff) && !scps_row_has_var(row) {
          scps_exprs_calls_ok(args, sctx, ctx)
        } else {
          false
        }
      },
      _ => false
    },
    ELet(_, v, b, _) => scps_calls_ok(v, sctx, ctx) && scps_calls_ok(b, sctx, ctx),
    ELetMut(_, v, b, _) => scps_calls_ok(v, sctx, ctx) && scps_calls_ok(b, sctx, ctx),
    ELetRec(_, v, b) => scps_calls_ok(v, sctx, ctx) && scps_calls_ok(b, sctx, ctx),
    ESeq(a, b) => scps_calls_ok(a, sctx, ctx) && scps_calls_ok(b, sctx, ctx),
    EIf(c, t, el) => scps_calls_ok(c, sctx, ctx) && scps_calls_ok(t, sctx, ctx) && scps_calls_ok(el, sctx, ctx),
    EMatch(s, arms) => {
      let mut ok = scps_calls_ok(s, sctx, ctx)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, i)
        if !scps_calls_ok(ex, sctx, ctx) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok
    },
    EHandle(_, _) => false,
    EFn(_, _, _, _, _, b) => scps_calls_ok(b, sctx, ctx),
    EWhile(c, b) => scps_calls_ok(c, sctx, ctx) && scps_calls_ok(b, sctx, ctx),
    EForIn(_, _, it, b) => scps_calls_ok(it, sctx, ctx) && scps_calls_ok(b, sctx, ctx),
    ELoop(pairs, b) => {
      let mut ok = scps_calls_ok(b, sctx, ctx)
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, v) = Array::get(pairs, i)
        if !scps_calls_ok(v, sctx, ctx) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok
    },
    EBinOp(_, l, r) => scps_calls_ok(l, sctx, ctx) && scps_calls_ok(r, sctx, ctx),
    EUnaryOp(_, e2) => scps_calls_ok(e2, sctx, ctx),
    EAssign(_, v, c) => scps_calls_ok(v, sctx, ctx) && scps_calls_ok(c, sctx, ctx),
    EAssignOp(_, _, v, c) => scps_calls_ok(v, sctx, ctx) && scps_calls_ok(c, sctx, ctx),
    EReturn(e2) => scps_calls_ok(e2, sctx, ctx),
    EDot(o, _, _, _) => scps_calls_ok(o, sctx, ctx),
    ELabeledArg(_, _, v) => scps_calls_ok(v, sctx, ctx),
    EBreak(opt) => match opt {
      Some(e2) => scps_calls_ok(e2, sctx, ctx),
      None => true
    },
    EContinue(args) => scps_exprs_calls_ok(args, sctx, ctx),
    ETuple(elems) => scps_exprs_calls_ok(elems, sctx, ctx),
    EArray(elems) => scps_exprs_calls_ok(elems, sctx, ctx),
    ERecord(_, fields, _) => scps_fields_calls_ok(fields, sctx, ctx),
    EMap(fields) => scps_fields_calls_ok(fields, sctx, ctx),
    ESpread(e2) => scps_calls_ok(e2, sctx, ctx),
    _ => true
  }
}

fn scps_exprs_calls_ok(es: Array[Expr], sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(es) {
    if !scps_calls_ok(Array::get(es, i), sctx, ctx) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn scps_fields_calls_ok(fields: Array[(String, Expr)], sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    if !scps_calls_ok(v, sctx, ctx) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

/// --- #1536 / #1514 parity: name the call scps_calls_ok rejected.
///
/// scps_calls_ok answers only Bool, so the suspend-lowering ineligibility
/// errors could say WHAT kind of callee is rejected but not WHERE. This trio
/// mirrors its decision structure in lockstep and returns the FIRST rejected
/// call as (found, callee name, source char offset) -- the edit point. Name
/// is the bare identifier (or the field name of a method-style callee, whose
/// fdoff points at the spelled field); "" when the callee has no stable
/// spelling in source (a computed callee expression, a nested handle).
/// Offset is -1 when the node carries none (synthesized AST). Keep the
/// traversal identical to scps_calls_ok: the culprit reported here must be
/// exactly a call that made it return false, never a call it accepted.
fn scps_first_bad_call_info(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> (Bool, String, Int) {
  let (eff, _, needing, _, cps_locals) = sctx
  match e {
    ECall(callee, args, off) => match callee {
      EIdent(nm, ioff) => if nm == "perform" && Array::length(args) == 1 {
        match Array::get(args, 0) {
          EIdent(_, _) => (false, "", -1),
          ECall(opc, op_args, _) => match opc {
            EIdent(_, _) => scps_first_bad_call_info_exprs(op_args, sctx, ctx),
            _ => (true, nm, scps_pick_off(ioff, off))
          },
          _ => (true, nm, scps_pick_off(ioff, off))
        }
      } else if idp_is_pure_builtin_call(nm) || scps_is_safe_mut_builtin(nm) || scps_is_ctor_name(ctx, nm) || edp_str_array_contains(needing, nm) {
        scps_first_bad_call_info_exprs(args, sctx, ctx)
      } else if edp_str_array_contains(cps_locals, nm) || String::starts_with(nm, "__scps_") || String::starts_with(nm, "__Scps") {
        scps_first_bad_call_info_exprs(args, sctx, ctx)
      } else {
        let (is_fn, row) = scps_fn_row_of(ctx, nm)
        if is_fn && !scps_row_contains(ctx, row, eff) && !scps_row_has_var(row) {
          scps_first_bad_call_info_exprs(args, sctx, ctx)
        } else {
          (true, nm, scps_pick_off(ioff, off))
        }
      },
      EDot(_, field, _, fdoff) => (true, field, fdoff),
      _ => (true, "", off)
    },
    ELet(_, v, b, _) => scps_first_bad_call_info_pair(v, b, sctx, ctx),
    ELetMut(_, v, b, _) => scps_first_bad_call_info_pair(v, b, sctx, ctx),
    ELetRec(_, v, b) => scps_first_bad_call_info_pair(v, b, sctx, ctx),
    ESeq(a, b) => scps_first_bad_call_info_pair(a, b, sctx, ctx),
    EIf(c, t, el) => {
      let (f, n, o) = scps_first_bad_call_info_pair(c, t, sctx, ctx)
      if f {
        (f, n, o)
      } else {
        scps_first_bad_call_info(el, sctx, ctx)
      }
    },
    EMatch(s, arms) => {
      let mut found = false
      let mut nm = ""
      let mut off = -1
      let (sf, sn, so) = scps_first_bad_call_info(s, sctx, ctx)
      found = sf
      nm = sn
      off = so
      let mut i = 0
      while i < Array::length(arms) && !found {
        let (_, ex) = Array::get(arms, i)
        let (f, n, o) = scps_first_bad_call_info(ex, sctx, ctx)
        found = f
        nm = n
        off = o
        i = i + 1
      }
      (found, nm, off)
    },
    EHandle(_, _) => (true, "", -1),
    EFn(_, _, _, _, _, b) => scps_first_bad_call_info(b, sctx, ctx),
    EWhile(c, b) => scps_first_bad_call_info_pair(c, b, sctx, ctx),
    EForIn(_, _, it, b) => scps_first_bad_call_info_pair(it, b, sctx, ctx),
    ELoop(pairs, b) => {
      let mut found = false
      let mut nm = ""
      let mut off = -1
      let mut i = 0
      while i < Array::length(pairs) && !found {
        let (_, v) = Array::get(pairs, i)
        let (f, n, o) = scps_first_bad_call_info(v, sctx, ctx)
        found = f
        nm = n
        off = o
        i = i + 1
      }
      if found {
        (found, nm, off)
      } else {
        scps_first_bad_call_info(b, sctx, ctx)
      }
    },
    EBinOp(_, l, r) => scps_first_bad_call_info_pair(l, r, sctx, ctx),
    EUnaryOp(_, e2) => scps_first_bad_call_info(e2, sctx, ctx),
    EAssign(_, v, c) => scps_first_bad_call_info_pair(v, c, sctx, ctx),
    EAssignOp(_, _, v, c) => scps_first_bad_call_info_pair(v, c, sctx, ctx),
    EReturn(e2) => scps_first_bad_call_info(e2, sctx, ctx),
    EDot(o, _, _, _) => scps_first_bad_call_info(o, sctx, ctx),
    ELabeledArg(_, _, v) => scps_first_bad_call_info(v, sctx, ctx),
    EBreak(opt) => match opt {
      Some(e2) => scps_first_bad_call_info(e2, sctx, ctx),
      None => (false, "", -1)
    },
    EContinue(args) => scps_first_bad_call_info_exprs(args, sctx, ctx),
    ETuple(elems) => scps_first_bad_call_info_exprs(elems, sctx, ctx),
    EArray(elems) => scps_first_bad_call_info_exprs(elems, sctx, ctx),
    ERecord(_, fields, _) => scps_first_bad_call_info_fields(fields, sctx, ctx),
    EMap(fields) => scps_first_bad_call_info_fields(fields, sctx, ctx),
    ESpread(e2) => scps_first_bad_call_info(e2, sctx, ctx),
    _ => (false, "", -1)
  }
}

fn scps_pick_off(ident_off: Int, call_off: Int) -> Int {
  if ident_off >= 0 {
    ident_off
  } else {
    call_off
  }
}

fn scps_first_bad_call_info_pair(a: Expr, b: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> (Bool, String, Int) {
  let (f, n, o) = scps_first_bad_call_info(a, sctx, ctx)
  if f {
    (f, n, o)
  } else {
    scps_first_bad_call_info(b, sctx, ctx)
  }
}

fn scps_first_bad_call_info_exprs(es: Array[Expr], sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> (Bool, String, Int) {
  let mut i = 0
  let mut found = false
  let mut nm = ""
  let mut off = -1
  while i < Array::length(es) && !found {
    let (f, n, o) = scps_first_bad_call_info(Array::get(es, i), sctx, ctx)
    found = f
    nm = n
    off = o
    i = i + 1
  }
  (found, nm, off)
}

fn scps_first_bad_call_info_fields(fields: Array[(String, Expr)], sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> (Bool, String, Int) {
  let mut i = 0
  let mut found = false
  let mut nm = ""
  let mut off = -1
  while i < Array::length(fields) && !found {
    let (_, v) = Array::get(fields, i)
    let (f, n, o) = scps_first_bad_call_info(v, sctx, ctx)
    found = f
    nm = n
    off = o
    i = i + 1
  }
  (found, nm, off)
}

/// Render the two culprit fragments for a suspend-lowering ineligibility
/// error: the human clause ` (here: the call to 'X')` and the ` [@off=N:M]`
/// transport marker (resolved to `line:col` by the lanes that know the source
/// basis, ALWAYS stripped before a user sees it -- same contract as the
/// handle-side #1514 C marker). Either half degrades to "" independently: an
/// unnamed culprit (computed callee, nested handle) gets no clause, an
/// offset-less culprit (synthesized AST) gets no marker.
fn scps_culprit_parts(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> (String, String) {
  let (found, nm, off) = scps_first_bad_call_info(e, sctx, ctx)
  if !found {
    ("", "")
  } else {
    let clause = if String::length(nm) > 0 {
      String::concat(" (here: the call to '", String::concat(nm, "')"))
    } else {
      ""
    }
    let marker = if off >= 0 {
      if String::length(nm) > 0 {
        String::concat(" [@off=", String::concat(__to_string(off), String::concat(":", String::concat(__to_string(off + String::length(nm)), "]"))))
      } else {
        String::concat(" [@off=", String::concat(__to_string(off), "]"))
      }
    } else {
      ""
    }
    (clause, marker)
  }
}

// --- step constructors.

fn scps_mk_yield(eff: String, opname: String, args: Array[Expr], bind_name: String, cont_body: Expr) -> Expr {
  let payload = array_empty_expr()
  let mut i = 0
  while i < Array::length(args) {
    Array::push(payload, Array::get(args, i))
    i = i + 1
  }
  Array::push(payload, scps_mk_fn1(bind_name, cont_body))
  ECall(EIdent(scps_y_name(eff, opname), -1), payload, -1)
}

fn scps_mk_done(eff: String, v: Expr) -> Expr {
  ECall(EIdent(scps_done_name(eff), -1), [
    v
  ], -1)
}

// --- per-effect runtime injection: the __ScpsStep_E enum (from the
// effect DECLARATION, so every op has its variant regardless of which
// sites/clones use it) and the __scps_bubble_E composition combinator.
// Injected once per effect per program.

fn scps_ensure_effect_runtime(eff: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Unit {
  let (_, injected, _, _, _, inj, _) = st
  if edp_str_array_contains(injected, eff) {
    ()
  } else {
    Array::push(injected, eff)
    let (_, decl_ops) = scps_effect_decl_ops(ctx, eff)
    // enum
    let ctors = scps_empty_ctors()
    let done_tys = scps_empty_tys()
    Array::push(done_tys, TyName("Int"))
    Array::push(ctors, (scps_done_name(eff), done_tys))
    let mut ei = 0
    while ei < Array::length(decl_ops) {
      let (opname, arity) = Array::get(decl_ops, ei)
      let ytys = scps_empty_tys()
      let mut ti = 0
      while ti < arity + 1 {
        Array::push(ytys, TyName("Int"))
        ti = ti + 1
      }
      Array::push(ctors, (scps_y_name(eff, opname), ytys))
      ei = ei + 1
    }
    Array::push(inj, SEnum(false, scps_step_name(eff), array_empty_str(), ctors, array_empty_str()))
    // bubble: (st, k) -> match st { Done(v) => k(v),
    //   Y_op(p.., kk) => Y_op(p.., (rv) -> bubble(kk(rv), k)) }
    let bname = scps_bubble_name(eff)
    let marms = scps_empty_arms()
    let done_pats = scps_empty_pats()
    Array::push(done_pats, PBind("__scps_bv"))
    Array::push(marms, (PCtor(scps_done_name(eff), done_pats), ECall(EIdent("__scps_bk", -1), [
      EIdent("__scps_bv", -1)
    ], -1)))
    let mut bi = 0
    while bi < Array::length(decl_ops) {
      let (opname, arity) = Array::get(decl_ops, bi)
      let ypats = scps_empty_pats()
      let yargs = array_empty_expr()
      let mut pi = 0
      while pi < arity {
        let pname = scps_local("__scps_bp", pi)
        Array::push(ypats, PBind(pname))
        Array::push(yargs, EIdent(pname, -1))
        pi = pi + 1
      }
      Array::push(ypats, PBind("__scps_bkk"))
      let rewrap = scps_mk_fn1("__scps_brv", ECall(EIdent(bname, -1), [
        ECall(EIdent("__scps_bkk", -1), [
          EIdent("__scps_brv", -1)
        ], -1),
        EIdent("__scps_bk", -1)
      ], -1))
      Array::push(yargs, rewrap)
      Array::push(marms, (PCtor(scps_y_name(eff, opname), ypats), ECall(EIdent(scps_y_name(eff, opname), -1), yargs, -1)))
      bi = bi + 1
    }
    let bfn = scps_mk_fn2("__scps_bst", "__scps_bk", EMatch(EIdent("__scps_bst", -1), marms))
    Array::push(inj, SLet(false, true, bname, None, bfn))
  }
}

// --- clone worklist.

fn scps_need_clone(eff: String, fname: String, st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Unit {
  let (_, _, clone_keys, q_eff, q_fn, _, _) = st
  let key = String::concat(String::concat(eff, "||"), fname)
  if edp_str_array_contains(clone_keys, key) {
    ()
  } else {
    Array::push(clone_keys, key)
    Array::push(q_eff, eff)
    Array::push(q_fn, fname)
  }
}

// --- the body split: `e` sits in TAIL position of the computation being
// lowered (a handle body or a clone body); the result is an expression
// producing a __ScpsStep_E value. Suspendables (direct performs of E,
// calls to needing functions) are only recognized on the
// let/seq/tail/branch-tail spine. A direct recognized suspension may also
// occupy an if condition, match scrutinee, or plain-assignment RHS: it is
// first named by a fresh ELet, then the existing spine machinery resumes into
// selection/assignment or a while condition. Compound inputs, compound
// assignment, and every other nested suspension still fail closed.

fn scps_direct_spine_input(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {
  let (_, ops, _, _, _) = sctx
  scps_as_target_perform(e, ops) >= 0 || scps_as_needing_call(e, sctx) != "" || scps_as_cps_local_call(e, sctx) != ""
}

fn scps_selection_fresh(e: Expr, site: Int) -> String {
  // Reuse the scope-blind collision probe used by sequence-head floating.
  // Passing the whole selection expression ensures the generated binder is
  // absent from both the input and every continuation branch/arm.
  scps_seq_float_fresh("select", e, EUnit, site)
}

fn scps_split_tail(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> (Bool, Expr) {
  let (eff, ops, _, site, cps_locals) = sctx
  if !scps_contains_susp(e, sctx) {
    (true, scps_mk_done(eff, e))
  } else {
    let tail_idx = scps_as_target_perform(e, ops)
    let tail_needing = scps_as_needing_call(e, sctx)
    let tail_cps = scps_as_cps_local_call(e, sctx)
    if tail_idx >= 0 {
      // tail `perform Op(a..)` -- the op's value IS the computation's value.
      let targs = scps_perform_args(e)
      if scps_exprs_contain_susp(targs, sctx) {
        (false, e)
      } else {
        let tv = scps_local("__scps_tv", site)
        (true, scps_mk_yield(eff, scps_op_suffix(Array::get(ops, tail_idx)), targs, tv, scps_mk_done(eff, EIdent(tv, -1))))
      }
    } else if tail_needing != "" {
      // tail call to a needing fn -- its clone already returns a step.
      let cargs = scps_call_args(e)
      if scps_exprs_contain_susp(cargs, sctx) {
        (false, e)
      } else {
        scps_need_clone(eff, tail_needing, st)
        (true, ECall(EIdent(scps_clone_name(eff, tail_needing), -1), cargs, -1))
      }
    } else if tail_cps != "" {
      // closure-CPS (追記31 Vertical B): tail call through a step-typed
      // closure binding -- the call already returns a step. Passthrough.
      let cargs = scps_call_args(e)
      if scps_exprs_contain_susp(cargs, sctx) {
        (false, e)
      } else {
        (true, e)
      }
    } else {
      match e {
        ELet(x, v, b, off) => {
          let vp = scps_as_target_perform(v, ops)
          let vn = scps_as_needing_call(v, sctx)
          let vc = scps_as_cps_local_call(v, sctx)
          if vp >= 0 {
            let vargs = scps_perform_args(v)
            if scps_exprs_contain_susp(vargs, sctx) {
              (false, e)
            } else {
              let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
              (bok, scps_mk_yield(eff, scps_op_suffix(Array::get(ops, vp)), vargs, x, bexpr))
            }
          } else if vn != "" {
            let vargs = scps_call_args(v)
            if scps_exprs_contain_susp(vargs, sctx) {
              (false, e)
            } else {
              scps_need_clone(eff, vn, st)
              let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
              (bok, ECall(EIdent(scps_bubble_name(eff), -1), [
                ECall(EIdent(scps_clone_name(eff, vn), -1), vargs, -1),
                scps_mk_fn1(x, bexpr)
              ], -1))
            }
          } else if vc != "" {
            // closure-CPS: `let x = f(a) REST` where `f` is a step-typed
            // closure binding -- bubble the step it returns, no clone.
            let vargs = scps_call_args(v)
            if scps_exprs_contain_susp(vargs, sctx) {
              (false, e)
            } else {
              let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
              (bok, ECall(EIdent(scps_bubble_name(eff), -1), [
                v,
                scps_mk_fn1(x, bexpr)
              ], -1))
            }
          } else if scps_contains_susp(v, sctx) {
            (false, e)
          } else {
            // closure-CPS: a let-bound literal the prepass step-split makes
            // `x` a step-typed binding for the rest of this spine; a
            // non-step rebind of an existing cps-local name masks it.
            let is_step_lit = scps_literal_is_step_for(v, eff)
            let (_, s_ops, s_needing, s_site, s_cps) = sctx
            let sctx2 = if is_step_lit {
              let ext = Array::slice(s_cps, 0, Array::length(s_cps))
              Array::push(ext, x)
              (eff, s_ops, s_needing, s_site, ext)
            } else if edp_str_array_contains(s_cps, x) {
              let masked = array_empty_str()
              let mut mi = 0
              while mi < Array::length(s_cps) {
                let mnm = Array::get(s_cps, mi)
                if mnm == x {
                  ()
                } else {
                  Array::push(masked, mnm)
                }
                mi = mi + 1
              }
              (eff, s_ops, s_needing, s_site, masked)
            } else {
              sctx
            }
            let (bok, bexpr) = scps_split_tail(b, sctx2, ctx, st)
            (bok, ELet(x, v, bexpr, off))
          }
        },
        ESeq(a, b) => match a {
          // #1230: a loop in statement position takes `b` as its exit
          // continuation -- see scps_split_while. Only when the loop
          // ITSELF suspends: a loop that merely PRECEDES a suspension
          // stays an ordinary `while` (Codex P1 on #1263). Converting one
          // that never suspends would trade a constant-space loop for
          // recursion the tail-call rewrite can no longer flatten (it runs
          // before this pass), so a long ordinary loop would exhaust the
          // wasm call stack on its way to a suspension further down.
          EWhile(wc, wb) => if scps_contains_susp(a, sctx) {
            scps_split_while(wc, wb, b, sctx, ctx, st)
          } else {
            let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
            (bok, ESeq(a, bexpr))
          },
          // #1536 (a) v3, let-floating: a suspending let-chain compound in
          // SEQUENCE HEAD position (what an async-iterator `for` in statement
          // position desugars to -- `ELet(__iter_src, ..)` terminating in the
          // loop, with the rest of the body as the seq tail) is rebalanced
          // onto the continuation spine this split already handles:
          //   ESeq(ELet(x, v, k), b)  ==>  ELet(nx, v, ESeq(k[x:=nx], b))
          // Widening the binder's scope over `b` is only sound if `b` cannot
          // capture it, so the binder is ALWAYS alpha-renamed to a
          // site-suffixed fresh spelling first (shadow-aware, assignment
          // targets included -- scps_rename_ident): any `x` free in `b`
          // refers to an OUTER binding and must keep doing so. Two floated
          // binders collide in `nx` only if they share the original name, and
          // then surface block scoping already guarantees the inner one
          // shadows every use the rename could reach. Non-suspending heads
          // keep the ordinary statement path below (same reasoning as the
          // `while` arm above: no gratuitous restructuring).
          ELet(x, v, k, off) => if scps_contains_susp(a, sctx) {
            let nx = scps_seq_float_fresh(x, k, b, site)
            scps_split_tail(ELet(nx, v, ESeq(scps_rename_ident(k, x, nx), b), off), sctx, ctx, st)
          } else {
            let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
            (bok, ESeq(a, bexpr))
          },
          ELetMut(x, v, k, off) => if scps_contains_susp(a, sctx) {
            let nx = scps_seq_float_fresh(x, k, b, site)
            scps_split_tail(ELetMut(nx, v, ESeq(scps_rename_ident(k, x, nx), b), off), sctx, ctx, st)
          } else {
            let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
            (bok, ESeq(a, bexpr))
          },
          // #1536 (a) v4: distribute the sequence continuation through a
          // suspending conditional. The condition remains outside the
          // branches, so it is evaluated exactly once before exactly one
          // branch and its continuation. Branch-local lets remain lexical
          // to their branch because `b` is an ESeq sibling, not their body.
          EIf(c, t, el) => if scps_contains_susp(a, sctx) {
            if scps_direct_spine_input(c, sctx) {
              let sx = scps_selection_fresh(e, site)
              scps_split_tail(ELet(sx, c, EIf(EIdent(sx, -1), ESeq(t, b), ESeq(el, b)), -1), sctx, ctx, st)
            } else if scps_contains_susp(c, sctx) {
              (false, e)
            } else {
              scps_split_tail(EIf(c, ESeq(t, b), ESeq(el, b)), sctx, ctx, st)
            }
          } else {
            let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
            (bok, ESeq(a, bexpr))
          },
          // #1536 (a) v4: likewise distribute through match after first
          // alpha-renaming every pattern binder. The tail was outside the
          // match originally; without the rename, a pattern binding could
          // capture an outer reference in the duplicated tail.
          EMatch(s, arms) => if scps_contains_susp(a, sctx) {
            if scps_direct_spine_input(s, sctx) {
              let sx = scps_selection_fresh(e, site)
              scps_split_tail(ELet(sx, s, EMatch(EIdent(sx, -1), scps_seq_float_match_arms(arms, b, site)), -1), sctx, ctx, st)
            } else if scps_contains_susp(s, sctx) {
              (false, e)
            } else {
              scps_split_tail(EMatch(s, scps_seq_float_match_arms(arms, b, site)), sctx, ctx, st)
            }
          } else {
            let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
            (bok, ESeq(a, bexpr))
          },
          // Reassociate a suspending nested sequence head so its own head
          // surfaces for the arms above: ESeq(ESeq(a1, a2), b) ==>
          // ESeq(a1, ESeq(a2, b)). Strictly decreases head size, so the
          // rewrite loop terminates.
          ESeq(a1, a2) => if scps_contains_susp(a, sctx) {
            scps_split_tail(ESeq(a1, ESeq(a2, b)), sctx, ctx, st)
          } else {
            let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
            (bok, ESeq(a, bexpr))
          },
          _ => {
            let ap = scps_as_target_perform(a, ops)
            let an = scps_as_needing_call(a, sctx)
            if ap >= 0 {
              let aargs = scps_perform_args(a)
              if scps_exprs_contain_susp(aargs, sctx) {
                (false, e)
              } else {
                let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
                (bok, scps_mk_yield(eff, scps_op_suffix(Array::get(ops, ap)), aargs, scps_local("__scps_w", site), bexpr))
              }
            } else if an != "" {
              let aargs = scps_call_args(a)
              if scps_exprs_contain_susp(aargs, sctx) {
                (false, e)
              } else {
                scps_need_clone(eff, an, st)
                let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
                (bok, ECall(EIdent(scps_bubble_name(eff), -1), [
                  ECall(EIdent(scps_clone_name(eff, an), -1), aargs, -1),
                  scps_mk_fn1(scps_local("__scps_w", site), bexpr)
                ], -1))
              }
            } else if scps_as_cps_local_call(a, sctx) != "" {
              // closure-CPS: statement-position call through a step-typed
              // closure binding -- bubble, discard the resumed value.
              let aargs = scps_call_args(a)
              if scps_exprs_contain_susp(aargs, sctx) {
                (false, e)
              } else {
                let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
                (bok, ECall(EIdent(scps_bubble_name(eff), -1), [
                  a,
                  scps_mk_fn1(scps_local("__scps_w", site), bexpr)
                ], -1))
              }
            } else if scps_contains_susp(a, sctx) {
              (false, e)
            } else {
              let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
              (bok, ESeq(a, bexpr))
            }
          }
        },
        EIf(c, t, el) => if scps_direct_spine_input(c, sctx) {
          let sx = scps_selection_fresh(e, site)
          scps_split_tail(ELet(sx, c, EIf(EIdent(sx, -1), t, el), -1), sctx, ctx, st)
        } else if scps_contains_susp(c, sctx) {
          (false, e)
        } else {
          let (tok, te) = scps_split_tail(t, sctx, ctx, st)
          let (eok, ee) = scps_split_tail(el, sctx, ctx, st)
          if tok && eok {
            (true, EIf(c, te, ee))
          } else {
            (false, e)
          }
        },
        EMatch(s, arms) => if scps_direct_spine_input(s, sctx) {
          let sx = scps_selection_fresh(e, site)
          scps_split_tail(ELet(sx, s, EMatch(EIdent(sx, -1), arms), -1), sctx, ctx, st)
        } else if scps_contains_susp(s, sctx) {
          (false, e)
        } else {
          let out = scps_empty_arms()
          let mut ok = true
          let mut i = 0
          while i < Array::length(arms) {
            let (mp, mb) = Array::get(arms, i)
            let (aok, ae) = scps_split_tail(mb, sctx, ctx, st)
            if !aok {
              ok = false
            } else {
              ()
            }
            Array::push(out, (mp, ae))
            i = i + 1
          }
          if ok {
            (true, EMatch(s, out))
          } else {
            (false, e)
          }
        },
        // #1536 (a) v6: a plain assignment RHS that is itself one direct
        // recognized suspension can use the established let spine. Probe the
        // whole assignment when minting the binder so assignment targets and
        // continuation names cannot collide with it. Compound RHS and
        // EAssignOp deliberately keep the generic fail-closed path.
        EAssign(x, v, b) => if scps_direct_spine_input(v, sctx) {
          let ax = scps_seq_float_fresh("assign", e, EUnit, site)
          scps_split_tail(ELet(ax, v, EAssign(x, EIdent(ax, -1), b), -1), sctx, ctx, st)
        } else {
          (false, e)
        },
        ELetMut(x, v, b, off) => if scps_contains_susp(v, sctx) {
          (false, e)
        } else {
          // #1230: box the mutable local so every continuation closure on
          // this spine shares one cell instead of capturing a copy.
          let (_, s_ops, s_needing, s_site, s_cps) = sctx
          let masked = array_empty_str()
          let mut mi = 0
          while mi < Array::length(s_cps) {
            let mnm = Array::get(s_cps, mi)
            if mnm == x {
              ()
            } else {
              Array::push(masked, mnm)
            }
            mi = mi + 1
          }
          let sctx2 = (eff, s_ops, s_needing, s_site, masked)
          // Float a direct assignment suspension before cellification turns a
          // write to `x` into Array::set(...). After that rewrite the perform
          // would be nested in a builtin argument and no longer recognizable.
          let b2 = scps_float_direct_assign(b, sctx2, site)
          let (bok, bexpr) = scps_split_tail(scps_cellify(b2, x), sctx2, ctx, st)
          let cell = array_empty_expr()
          Array::push(cell, v)
          (bok, ELet(x, EArray(cell), bexpr, off))
        },
        EWhile(c, b) => scps_split_while(c, b, EUnit, sctx, ctx, st),
        _ => (false, e)
      }
    }
  }
}

/// Name direct suspension RHS values before mutable-local boxing. Traverse
/// only continuation-spine positions; values, loop bodies, nested handles and
/// closure bodies remain untouched and therefore fail closed as before.
fn scps_float_direct_assign(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), site: Int) -> Expr {
  match e {
    EAssign(x, v, b) => if scps_direct_spine_input(v, sctx) {
      let ax = scps_seq_float_fresh("assign", e, EUnit, site)
      ELet(ax, v, EAssign(x, EIdent(ax, -1), scps_float_direct_assign(b, sctx, site)), -1)
    } else {
      EAssign(x, v, scps_float_direct_assign(b, sctx, site))
    },
    EAssignOp(op, x, v, b) => EAssignOp(op, x, v, scps_float_direct_assign(b, sctx, site)),
    ELet(x, v, b, off) => ELet(x, v, scps_float_direct_assign(b, sctx, site), off),
    ELetMut(x, v, b, off) => ELetMut(x, v, scps_float_direct_assign(b, sctx, site), off),
    ELetRec(x, v, b) => ELetRec(x, v, scps_float_direct_assign(b, sctx, site)),
    ESeq(a, b) => ESeq(a, scps_float_direct_assign(b, sctx, site)),
    EIf(c, t, el) => EIf(c, scps_float_direct_assign(t, sctx, site), scps_float_direct_assign(el, sctx, site)),
    EMatch(s, arms) => {
      let out = scps_empty_arms()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        Array::push(out, (p, scps_float_direct_assign(b, sctx, site)))
        i = i + 1
      }
      EMatch(s, out)
    },
    _ => e
  }
}

// --- loop widening (#1230): `while` and `let mut` on the spine.
//
// The split above turns "the rest of the computation after a perform" into
// a closure. Two ordinary constructs used to fall outside it:
//
//   * `let mut x = v` -- the rest-closure would capture `x` by value, so a
//     write performed after a resume would be invisible to the code that
//     continues. Fixed by BOXING: `let x = [v]`, reads become
//     `Array::get(x, 0)` and writes `Array::set(x, 0, ..)`. The box is a
//     heap value, so every closure on the spine shares the same cell. The
//     one-shot flag the driver already emits (`[false]`) is the same trick.
//
//   * `while c { body }` -- a perform inside the body has no single
//     continuation split point, because the continuation is "the rest of
//     THIS iteration, then the loop again". Fixed by converting the loop to
//     a recursive step-returning closure: `let rec lp = () -> { if c {
//     <split of `body; lp()`> } else { <split of the rest> } }; lp()`. The
//     loop's own continuation is then just a tail call to `lp`, which the
//     closure-CPS path (`scps_as_cps_local_call`) already knows how to
//     bubble -- no new step shape and no ABI change. `lp` is registered as
//     a cps-local for exactly that reason.
//
// Note this synthesizes a LOCAL recursive closure, not a top-level
// function: the split runs after type checking and after `scps_calls_ok`
// has already vetted the ORIGINAL body, so the "a local closure is not
// see-through" eligibility rule (which is about code this pass did not
// write) does not apply to the code it emits itself. Every iteration that
// performs returns a step to the driver rather than recursing, so the
// native stack only grows across consecutive non-performing iterations.
//
// `break`/`continue`/`return` inside such a loop are still rejected: they
// have no meaning once the loop is a function, and rewriting them would
// need the escape continuation this slice does not build.

fn scps_has_loop_ctl(e: Expr) -> Bool {
  match e {
    EBreak(_) => true,
    EContinue(_) => true,
    EReturn(_) => true,
    ELet(_, v, b, _) => scps_has_loop_ctl(v) || scps_has_loop_ctl(b),
    ELetMut(_, v, b, _) => scps_has_loop_ctl(v) || scps_has_loop_ctl(b),
    ELetRec(_, v, b) => scps_has_loop_ctl(v) || scps_has_loop_ctl(b),
    ESeq(a, b) => scps_has_loop_ctl(a) || scps_has_loop_ctl(b),
    EIf(c, t, el) => scps_has_loop_ctl(c) || scps_has_loop_ctl(t) || scps_has_loop_ctl(el),
    EMatch(s, arms) => scps_has_loop_ctl(s) || scps_arms_have_loop_ctl(arms),
    EHandle(b, arms) => scps_has_loop_ctl(b) || scps_arms_have_loop_ctl(arms),
    // A nested closure is a control-flow boundary: its `return` targets the
    // closure, and its `break`/`continue` target a loop inside it. None of
    // them can reach the loop being converted, so scanning through would be
    // a false rejection (Codex P2 on #1263).
    EFn(_, _, _, _, _, _) => false,
    EWhile(c, b) => scps_has_loop_ctl(c) || scps_has_loop_ctl(b),
    EForIn(_, _, it, b) => scps_has_loop_ctl(it) || scps_has_loop_ctl(b),
    ELoop(pairs, b) => scps_pairs_have_loop_ctl(pairs) || scps_has_loop_ctl(b),
    ECall(callee, args, _) => scps_has_loop_ctl(callee) || scps_exprs_have_loop_ctl(args),
    EBinOp(_, l, r) => scps_has_loop_ctl(l) || scps_has_loop_ctl(r),
    EUnaryOp(_, a) => scps_has_loop_ctl(a),
    EAssign(_, v, b) => scps_has_loop_ctl(v) || scps_has_loop_ctl(b),
    EAssignOp(_, _, v, b) => scps_has_loop_ctl(v) || scps_has_loop_ctl(b),
    EDot(o, _, _, _) => scps_has_loop_ctl(o),
    ELabeledArg(_, _, v) => scps_has_loop_ctl(v),
    ETuple(items) => scps_exprs_have_loop_ctl(items),
    EArray(items) => scps_exprs_have_loop_ctl(items),
    ERecord(_, fields, _) => scps_pairs_have_loop_ctl(fields),
    EMap(fields) => scps_pairs_have_loop_ctl(fields),
    ESpread(a) => scps_has_loop_ctl(a),
    _ => false
  }
}

fn scps_exprs_have_loop_ctl(es: Array[Expr]) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(es) {
    if scps_has_loop_ctl(Array::get(es, i)) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_pairs_have_loop_ctl(pairs: Array[(String, Expr)]) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, i)
    if scps_has_loop_ctl(v) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_arms_have_loop_ctl(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(arms) {
    let (_, ex) = Array::get(arms, i)
    if scps_has_loop_ctl(ex) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// Does `p` bind the name `x` (so an arm under it sees a different `x`)?
fn scps_pat_binds_name(p: Pat, x: String) -> Bool {
  match p {
    PBind(n) => n == x,
    PCtor(_, ps) => scps_pats_bind_name(ps, x),
    PTuple(ps) => scps_pats_bind_name(ps, x),
    POr(a, b) => scps_pat_binds_name(a, x) || scps_pat_binds_name(b, x),
    PStruct(_, fields) => {
      let mut i = 0
      let mut hit = false
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        if scps_pat_binds_name(fp, x) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    _ => false
  }
}

fn scps_pats_bind_name(ps: Array[Pat], x: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(ps) {
    if scps_pat_binds_name(Array::get(ps, i), x) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_params_bind_name(params: Array[(String, Option[TypeExpr])], x: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(params) {
    let (nm, _) = Array::get(params, i)
    if nm == x {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_cell_get(x: String, off: Int) -> Expr {
  ECall(EIdent("Array::get", -1), [
    EIdent(x, off),
    EInt(0)
  ], -1)
}

fn scps_cell_set(x: String, v: Expr) -> Expr {
  ECall(EIdent("Array::set", -1), [
    EIdent(x, -1),
    EInt(0),
    v
  ], -1)
}

/// Rewrite every read and write of the local `x` in `e` into 1-element
/// Array cell operations, stopping at any binder that shadows the name.
/// See the boxing rationale above.
fn scps_cellify(e: Expr, x: String) -> Expr {
  match e {
    EIdent(nm, off) => if nm == x {
      scps_cell_get(nm, off)
    } else {
      e
    },
    EAssign(nm, v, b) => if nm == x {
      ESeq(scps_cell_set(nm, scps_cellify(v, x)), scps_cellify(b, x))
    } else {
      EAssign(nm, scps_cellify(v, x), scps_cellify(b, x))
    },
    EAssignOp(op, nm, v, b) => if nm == x {
      ESeq(scps_cell_set(nm, EBinOp(op, scps_cell_get(nm, -1), scps_cellify(v, x))), scps_cellify(b, x))
    } else {
      EAssignOp(op, nm, scps_cellify(v, x), scps_cellify(b, x))
    },
    ELet(nm, v, b, off) => ELet(nm, scps_cellify(v, x), if nm == x {
      b
    } else {
      scps_cellify(b, x)
    }, off),
    ELetMut(nm, v, b, off) => ELetMut(nm, scps_cellify(v, x), if nm == x {
      b
    } else {
      scps_cellify(b, x)
    }, off),
    ELetRec(nm, v, b) => if nm == x {
      e
    } else {
      ELetRec(nm, scps_cellify(v, x), scps_cellify(b, x))
    },
    ESeq(a, b) => ESeq(scps_cellify(a, x), scps_cellify(b, x)),
    EIf(c, t, el) => EIf(scps_cellify(c, x), scps_cellify(t, x), scps_cellify(el, x)),
    EMatch(s, arms) => EMatch(scps_cellify(s, x), scps_cellify_arms(arms, x)),
    EHandle(b, arms) => EHandle(scps_cellify(b, x), scps_cellify_arms(arms, x)),
    EFn(tps, tbs, params, rt, ef, b) => if scps_params_bind_name(params, x) {
      e
    } else {
      EFn(tps, tbs, params, rt, ef, scps_cellify(b, x))
    },
    EWhile(c, b) => EWhile(scps_cellify(c, x), scps_cellify(b, x)),
    EForIn(nm, idx, it, b) => {
      let shadowed = nm == x || match idx {
        Some(inm) => inm == x,
        None => false
      }
      EForIn(nm, idx, scps_cellify(it, x), if shadowed {
        b
      } else {
        scps_cellify(b, x)
      })
    },
    ELoop(pairs, b) => {
      let mut shadowed = false
      let out = scps_empty_pairs()
      let mut i = 0
      while i < Array::length(pairs) {
        let (nm, v) = Array::get(pairs, i)
        if nm == x {
          shadowed = true
        } else {
          ()
        }
        Array::push(out, (nm, scps_cellify(v, x)))
        i = i + 1
      }
      ELoop(out, if shadowed {
        b
      } else {
        scps_cellify(b, x)
      })
    },
    ECall(callee, args, off) => ECall(scps_cellify(callee, x), scps_cellify_exprs(args, x), off),
    EBinOp(op, l, r) => EBinOp(op, scps_cellify(l, x), scps_cellify(r, x)),
    EUnaryOp(op, a) => EUnaryOp(op, scps_cellify(a, x)),
    EReturn(a) => EReturn(scps_cellify(a, x)),
    EDot(o, f, off, foff) => EDot(scps_cellify(o, x), f, off, foff),
    ELabeledArg(l, m, v) => ELabeledArg(l, m, scps_cellify(v, x)),
    EBreak(opt) => match opt {
      Some(a) => EBreak(Some(scps_cellify(a, x))),
      None => e
    },
    EContinue(args) => EContinue(scps_cellify_exprs(args, x)),
    ETuple(items) => ETuple(scps_cellify_exprs(items, x)),
    EArray(items) => EArray(scps_cellify_exprs(items, x)),
    ERecord(rn, fields, targs) => ERecord(rn, scps_cellify_pairs(fields, x), targs),
    EMap(fields) => EMap(scps_cellify_pairs(fields, x)),
    ESpread(a) => ESpread(scps_cellify(a, x)),
    _ => e
  }
}

fn scps_empty_pairs() -> Array[(String, Expr)] {
  Array::slice([
    ("", EUnit)
  ], 0, 0)
}

fn scps_cellify_exprs(es: Array[Expr], x: String) -> Array[Expr] {
  let out = array_empty_expr()
  let mut i = 0
  while i < Array::length(es) {
    Array::push(out, scps_cellify(Array::get(es, i), x))
    i = i + 1
  }
  out
}

fn scps_cellify_pairs(pairs: Array[(String, Expr)], x: String) -> Array[(String, Expr)] {
  let out = scps_empty_pairs()
  let mut i = 0
  while i < Array::length(pairs) {
    let (nm, v) = Array::get(pairs, i)
    Array::push(out, (nm, scps_cellify(v, x)))
    i = i + 1
  }
  out
}

fn scps_cellify_arms(arms: Array[(Pat, Expr)], x: String) -> Array[(Pat, Expr)] {
  let out = scps_empty_arms()
  let mut i = 0
  while i < Array::length(arms) {
    let (p, ex) = Array::get(arms, i)
    Array::push(out, (p, if scps_pat_binds_name(p, x) {
      ex
    } else {
      scps_cellify(ex, x)
    }))
    i = i + 1
  }
  out
}

/// A `return` inside the loop body targets the FUNCTION, which a loop closure
/// cannot express. Nested closures own their own `return`, so the scan stops
/// at them (the same boundary scps_has_loop_ctl uses).
fn scps_body_has_return(e: Expr) -> Bool {
  match e {
    EReturn(_) => true,
    EFn(_, _, _, _, _, _) => false,
    ELet(_, v, b, _) => scps_body_has_return(v) || scps_body_has_return(b),
    ELetMut(_, v, b, _) => scps_body_has_return(v) || scps_body_has_return(b),
    ELetRec(_, v, b) => scps_body_has_return(v) || scps_body_has_return(b),
    ESeq(a, b) => scps_body_has_return(a) || scps_body_has_return(b),
    EIf(c, t, el) => scps_body_has_return(c) || scps_body_has_return(t) || scps_body_has_return(el),
    EMatch(s, arms) => scps_body_has_return(s) || scps_body_arms_have_return(arms),
    EHandle(b, arms) => scps_body_has_return(b) || scps_body_arms_have_return(arms),
    EWhile(c, b) => scps_body_has_return(c) || scps_body_has_return(b),
    EForIn(_, _, it, b) => scps_body_has_return(it) || scps_body_has_return(b),
    ELoop(_, b) => scps_body_has_return(b),
    ECall(callee, args, _) => scps_body_has_return(callee) || scps_body_exprs_have_return(args),
    EBinOp(_, l, r) => scps_body_has_return(l) || scps_body_has_return(r),
    EUnaryOp(_, a) => scps_body_has_return(a),
    EAssign(_, v, b) => scps_body_has_return(v) || scps_body_has_return(b),
    EAssignOp(_, _, v, b) => scps_body_has_return(v) || scps_body_has_return(b),
    EDot(o, _, _, _) => scps_body_has_return(o),
    ELabeledArg(_, _, v) => scps_body_has_return(v),
    EBreak(opt) => match opt {
      Some(v) => scps_body_has_return(v),
      None => false
    },
    EContinue(args) => scps_body_exprs_have_return(args),
    ETuple(items) => scps_body_exprs_have_return(items),
    EArray(items) => scps_body_exprs_have_return(items),
    ERecord(_, fields, _) => scps_body_fields_have_return(fields),
    EMap(fields) => scps_body_fields_have_return(fields),
    ESpread(a) => scps_body_has_return(a),
    _ => false
  }
}

fn scps_body_exprs_have_return(es: Array[Expr]) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(es) {
    if scps_body_has_return(Array::get(es, i)) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_body_arms_have_return(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(arms) {
    let (_, ex) = Array::get(arms, i)
    if scps_body_has_return(ex) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_body_fields_have_return(fields: Array[(String, Expr)]) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(fields) {
    let (_, ex) = Array::get(fields, i)
    if scps_body_has_return(ex) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// #1536: is this expression an unconditional transfer out of the enclosing
/// loop iteration? Nothing sequenced after one runs, which is what lets the
/// repeat-append and the ctl rewrite below drop the dead tail.
fn scps_is_ctl_terminator(e: Expr) -> Bool {
  match e {
    EBreak(_) => true,
    EContinue(_) => true,
    _ => false
  }
}

/// Put every transfer of THIS loop in a TAIL slot of the body, so the append
/// and the rewrite below see it as one. A transfer written mid-sequence --
/// `if i >= n { break }` followed by the rest of the body, the ordinary
/// spelling -- is not a tail until the sequence continuation is distributed
/// into the branches it can transfer out of; after that, the statements
/// sequenced behind the transfer are dead and drop.
///
/// Distribution only fires for a head that actually carries a transfer, so a
/// body without `break`/`continue` keeps its shape. Match arms get the same
/// binder alpha-rename the #1610 sequence-head distribution uses, for the same
/// reason: the continuation moves under the arm's scope.
fn scps_loop_normalize_ctl(e: Expr, site: Int) -> Expr {
  match e {
    ESeq(a, b) => if scps_is_ctl_terminator(a) {
      a
    } else if scps_loop_ctl_remains(a) {
      match a {
        EIf(c, t, el) => scps_loop_normalize_ctl(EIf(c, ESeq(t, b), ESeq(el, b)), site),
        EMatch(s, arms) => scps_loop_normalize_ctl(EMatch(s, scps_seq_float_match_arms(arms, b, site)), site),
        _ => ESeq(scps_loop_normalize_ctl(a, site), scps_loop_normalize_ctl(b, site))
      }
    } else {
      ESeq(a, scps_loop_normalize_ctl(b, site))
    },
    ELet(x, v, b, off) => ELet(x, v, scps_loop_normalize_ctl(b, site), off),
    ELetMut(x, v, b, off) => ELetMut(x, v, scps_loop_normalize_ctl(b, site), off),
    ELetRec(x, v, b) => ELetRec(x, v, scps_loop_normalize_ctl(b, site)),
    EAssign(nm, v, b) => EAssign(nm, v, scps_loop_normalize_ctl(b, site)),
    EAssignOp(op, nm, v, b) => EAssignOp(op, nm, v, scps_loop_normalize_ctl(b, site)),
    EIf(c, t, el) => EIf(c, scps_loop_normalize_ctl(t, site), scps_loop_normalize_ctl(el, site)),
    EMatch(s, arms) => {
      let out = scps_empty_arms()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        Array::push(out, (p, scps_loop_normalize_ctl(ex, site)))
        i = i + 1
      }
      EMatch(s, out)
    },
    _ => e
  }
}

/// Like scps_seq_append, but for a `loop` body: a tail that already transfers
/// (`break` / `continue`) keeps its own transfer instead of falling through to
/// the repeat call, and statements sequenced after a transfer are dropped as
/// the dead code they are. Nested loops and closures are not spine positions,
/// so their own `break`/`continue` are never touched here.
fn scps_loop_append_repeat(e: Expr, k: Expr) -> Expr {
  match e {
    EBreak(_) => e,
    EContinue(_) => e,
    ELet(x, v, b, off) => ELet(x, v, scps_loop_append_repeat(b, k), off),
    ELetMut(x, v, b, off) => ELetMut(x, v, scps_loop_append_repeat(b, k), off),
    ELetRec(x, v, b) => ELetRec(x, v, scps_loop_append_repeat(b, k)),
    ESeq(a, b) => if scps_is_ctl_terminator(a) {
      a
    } else {
      ESeq(a, scps_loop_append_repeat(b, k))
    },
    EAssign(nm, v, b) => EAssign(nm, v, scps_loop_append_repeat(b, k)),
    EAssignOp(op, nm, v, b) => EAssignOp(op, nm, v, scps_loop_append_repeat(b, k)),
    EIf(c, t, el) => EIf(c, scps_loop_append_repeat(t, k), scps_loop_append_repeat(el, k)),
    EMatch(s, arms) => {
      let out = scps_empty_arms()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        Array::push(out, (p, scps_loop_append_repeat(ex, k)))
        i = i + 1
      }
      EMatch(s, out)
    },
    EUnit => k,
    _ => ESeq(e, k)
  }
}

/// The `loop`'s parameters as call arguments, for the repeat call and for a
/// bare `continue` (which the surface language defines as "repeat with the
/// parameters unchanged").

/// Rewrite THIS loop's transfers into calls on the CPS spine:
///   `break v`      -> `k(v)`        (the loop's exit continuation)
///   `continue(as)` -> `lp(as)`      (bare `continue` repeats the parameters)
/// Nested loops (`while` / `for` / `loop`) and closures own the transfers
/// written inside them, so the walk stops there. Values are not descended
/// into: a transfer buried in one (`let x = if c { break } else { 1 }`) is
/// left alone and then rejected by scps_loop_ctl_remains, rather than
/// silently rewritten into a value position where it means something else.
fn scps_loop_rewrite_ctl(e: Expr, lp: String, kname: String) -> Expr {
  match e {
    EBreak(opt) => {
      let bv = match opt {
        Some(v) => v,
        None => EUnit
      }
      let args = array_empty_expr()
      Array::push(args, bv)
      ECall(EIdent(kname, -1), args, -1)
    },
    // The parser's loop desugar leaves `continue` payload-less (it assigns the
    // parameters first), so a payload here is a shape this pass has never seen:
    // leave it, and scps_loop_ctl_remains rejects the site.
    EContinue(args) => if Array::length(args) == 0 {
      ECall(EIdent(lp, -1), array_empty_expr(), -1)
    } else {
      e
    },
    EWhile(_, _) => e,
    EForIn(_, _, _, _) => e,
    ELoop(_, _) => e,
    EFn(_, _, _, _, _, _) => e,
    EHandle(_, _) => e,
    ESeq(a, b) => {
      let a2 = scps_loop_rewrite_ctl(a, lp, kname)
      if scps_is_ctl_terminator(a) {
        a2
      } else {
        ESeq(a2, scps_loop_rewrite_ctl(b, lp, kname))
      }
    },
    ELet(x, v, b, off) => ELet(x, v, scps_loop_rewrite_ctl(b, lp, kname), off),
    ELetMut(x, v, b, off) => ELetMut(x, v, scps_loop_rewrite_ctl(b, lp, kname), off),
    ELetRec(x, v, b) => ELetRec(x, v, scps_loop_rewrite_ctl(b, lp, kname)),
    EAssign(nm, v, b) => EAssign(nm, v, scps_loop_rewrite_ctl(b, lp, kname)),
    EAssignOp(op, nm, v, b) => EAssignOp(op, nm, v, scps_loop_rewrite_ctl(b, lp, kname)),
    EIf(c, t, el) => EIf(c, scps_loop_rewrite_ctl(t, lp, kname), scps_loop_rewrite_ctl(el, lp, kname)),
    EMatch(s, arms) => {
      let out = scps_empty_arms()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        Array::push(out, (p, scps_loop_rewrite_ctl(ex, lp, kname)))
        i = i + 1
      }
      EMatch(s, out)
    },
    _ => e
  }
}

/// Any transfer belonging to THIS loop that the rewrite above did not reach
/// (a `break` inside a let value, a call argument, an operand, ...). The scan
/// uses the same nested-loop / closure boundaries, so an inner loop's own
/// transfers do not count. `return` counts too: the loop becomes a closure,
/// and a closure cannot return from the function that encloses it.
fn scps_loop_ctl_remains(e: Expr) -> Bool {
  match e {
    EBreak(_) => true,
    EContinue(_) => true,
    EWhile(_, _) => false,
    EForIn(_, _, _, _) => false,
    ELoop(_, _) => false,
    EFn(_, _, _, _, _, _) => false,
    ELet(_, v, b, _) => scps_loop_ctl_remains(v) || scps_loop_ctl_remains(b),
    ELetMut(_, v, b, _) => scps_loop_ctl_remains(v) || scps_loop_ctl_remains(b),
    ELetRec(_, v, b) => scps_loop_ctl_remains(v) || scps_loop_ctl_remains(b),
    ESeq(a, b) => scps_loop_ctl_remains(a) || scps_loop_ctl_remains(b),
    EIf(c, t, el) => scps_loop_ctl_remains(c) || scps_loop_ctl_remains(t) || scps_loop_ctl_remains(el),
    EMatch(s, arms) => scps_loop_ctl_remains(s) || scps_loop_arms_ctl_remain(arms),
    EHandle(b, arms) => scps_loop_ctl_remains(b) || scps_loop_arms_ctl_remain(arms),
    ECall(callee, args, _) => scps_loop_ctl_remains(callee) || scps_loop_exprs_ctl_remain(args),
    EBinOp(_, l, r) => scps_loop_ctl_remains(l) || scps_loop_ctl_remains(r),
    EUnaryOp(_, a) => scps_loop_ctl_remains(a),
    EAssign(_, v, b) => scps_loop_ctl_remains(v) || scps_loop_ctl_remains(b),
    EAssignOp(_, _, v, b) => scps_loop_ctl_remains(v) || scps_loop_ctl_remains(b),
    EDot(o, _, _, _) => scps_loop_ctl_remains(o),
    ELabeledArg(_, _, v) => scps_loop_ctl_remains(v),
    ETuple(items) => scps_loop_exprs_ctl_remain(items),
    EArray(items) => scps_loop_exprs_ctl_remain(items),
    ERecord(_, fields, _) => scps_loop_fields_ctl_remain(fields),
    EMap(fields) => scps_loop_fields_ctl_remain(fields),
    ESpread(a) => scps_loop_ctl_remains(a),
    _ => false
  }
}

fn scps_loop_exprs_ctl_remain(es: Array[Expr]) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(es) {
    if scps_loop_ctl_remains(Array::get(es, i)) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_loop_arms_ctl_remain(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(arms) {
    let (_, ex) = Array::get(arms, i)
    if scps_loop_ctl_remains(ex) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_loop_fields_ctl_remain(fields: Array[(String, Expr)]) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(fields) {
    let (_, ex) = Array::get(fields, i)
    if scps_loop_ctl_remains(ex) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// "Run `e` (for its effects), then `k`" -- pushed into `e`'s TAIL slots
/// rather than wrapped as `ESeq(e, k)`, because the splitter only
/// recognizes a suspendable in a sequence's HEAD when that head is the
/// perform/call itself. A branch gets `k` in each arm (duplicated, but `k`
/// is only ever the loop's own zero-argument self-call).
fn scps_seq_append(e: Expr, k: Expr) -> Expr {
  match e {
    ELet(x, v, b, off) => ELet(x, v, scps_seq_append(b, k), off),
    ELetMut(x, v, b, off) => ELetMut(x, v, scps_seq_append(b, k), off),
    ELetRec(x, v, b) => ELetRec(x, v, scps_seq_append(b, k)),
    ESeq(a, b) => ESeq(a, scps_seq_append(b, k)),
    EAssign(nm, v, b) => EAssign(nm, v, scps_seq_append(b, k)),
    EAssignOp(op, nm, v, b) => EAssignOp(op, nm, v, scps_seq_append(b, k)),
    EIf(c, t, el) => EIf(c, scps_seq_append(t, k), scps_seq_append(el, k)),
    EMatch(s, arms) => {
      let out = scps_empty_arms()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        Array::push(out, (p, scps_seq_append(ex, k)))
        i = i + 1
      }
      EMatch(s, out)
    },
    EUnit => k,
    _ => ESeq(e, k)
  }
}

/// Split `while c { body } ; rest` (rest is EUnit when the loop is itself
/// in tail position) into a recursive step-returning closure. See the
/// rationale above.
fn scps_split_while(c: Expr, body: Expr, rest: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> (Bool, Expr) {
  let (eff, s_ops, s_needing, s_site, s_cps) = sctx
  let orig = ESeq(EWhile(c, body), rest)
  // #1536: `break` / `continue` are now carried (see scps_split_while_ctl);
  // `return` still is not -- the loop becomes a closure, and a closure cannot
  // return from the function around it.
  if scps_body_has_return(body) {
    (false, orig)
  } else if scps_loop_ctl_remains(body) {
    scps_split_while_ctl(c, body, rest, sctx, ctx, st)
  } else {
    let lp = scps_local("__scps_lp", scps_next_site(st))
    let ext = Array::slice(s_cps, 0, Array::length(s_cps))
    Array::push(ext, lp)
    let sctx2 = (eff, s_ops, s_needing, s_site, ext)
    let step = scps_seq_append(body, ECall(EIdent(lp, -1), array_empty_expr(), -1))
    if scps_direct_spine_input(c, sctx) {
      // #1536 (a) v7: evaluate one directly recognized suspending condition
      // once per loop check, then resume into the existing recursive loop
      // selection. Probe the whole loop + continuation so the fresh binder
      // cannot capture a user spelling in the condition, body, or rest.
      let cx = scps_seq_float_fresh("while", orig, EUnit, s_site)
      let loop_body = ELet(cx, c, EIf(EIdent(cx, -1), step, rest), -1)
      let (lok, lowered) = scps_split_tail(loop_body, sctx2, ctx, st)
      if lok {
        let lam = EFn(array_empty_str(), scps_empty_tbs(), scps_empty_params(), None, None, lowered)
        (true, ELetRec(lp, lam, ECall(EIdent(lp, -1), array_empty_expr(), -1)))
      } else {
        (false, orig)
      }
    } else if scps_contains_susp(c, sctx) {
      (false, orig)
    } else {
      let (iok, ibody) = scps_split_tail(step, sctx2, ctx, st)
      let (rok, rbody) = scps_split_tail(rest, sctx2, ctx, st)
      if iok && rok {
        let lam = EFn(array_empty_str(), scps_empty_tbs(), scps_empty_params(), None, None, EIf(c, ibody, rbody))
        (true, ELetRec(lp, lam, ECall(EIdent(lp, -1), array_empty_expr(), -1)))
      } else {
        (false, orig)
      }
    }
  }
}

/// #1536: `while c { body } ; rest` whose body carries `break` / `continue`.
/// The plain path above inlines `rest` into the loop closure's exit branch,
/// which only works when that branch is the single exit. With transfers there
/// are several, so the exit becomes its own closure and every transfer is a
/// call on the CPS spine:
///
///   let     k  = (bv) -> <rest, split>     // one exit continuation, shared
///   let rec lp = ()   -> <body', split>
///   lp()
///
/// where body' rewrites `break` to `k(unit)`, `continue` to `lp()`, and
/// appends `lp()` to every remaining tail (falling off the body's end repeats,
/// as it does today). Both closures are registered as step-typed cps-locals,
/// so the existing closure-CPS bubbling carries their results without a clone.
///
/// This is also what makes the surface `loop (p = e, ..) { .. }` form work:
/// the parser desugars it (desugar_loop_body) into mutable parameter locals
/// plus exactly this shape -- `while true` with bare `break` / `continue` --
/// long before this pass runs, which is why there is no ELoop case here.
fn scps_split_while_ctl(c: Expr, body: Expr, rest: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> (Bool, Expr) {
  let (eff, s_ops, s_needing, s_site, s_cps) = sctx
  let orig = ESeq(EWhile(c, body), rest)
  let lsite = scps_next_site(st)
  let lp = scps_local("__scps_lp", lsite)
  let kname = scps_local("__scps_lpk", lsite)
  let bv = scps_local("__scps_lpv", lsite)
  let repeat = ECall(EIdent(lp, -1), array_empty_expr(), -1)
  let normalized = scps_loop_normalize_ctl(body, lsite)
  let rewritten = scps_loop_rewrite_ctl(scps_loop_append_repeat(normalized, repeat), lp, kname)
  // Anything the rewrite could not place on the spine (a transfer inside a
  // value, a call argument, an operand) stays fail-closed.
  if scps_loop_ctl_remains(rewritten) {
    (false, orig)
  } else {
    let ext = Array::slice(s_cps, 0, Array::length(s_cps))
    Array::push(ext, lp)
    Array::push(ext, kname)
    let sctx2 = (eff, s_ops, s_needing, s_site, ext)
    let exit_args = array_empty_expr()
    Array::push(exit_args, EUnit)
    let exit_call = ECall(EIdent(kname, -1), exit_args, -1)
    let loop_body = if scps_direct_spine_input(c, sctx) {
      let cx = scps_seq_float_fresh("while", orig, EUnit, s_site)
      ELet(cx, c, EIf(EIdent(cx, -1), rewritten, exit_call), -1)
    } else {
      EIf(c, rewritten, exit_call)
    }
    if !scps_direct_spine_input(c, sctx) && scps_contains_susp(c, sctx) {
      (false, orig)
    } else {
      let (lok, lowered) = scps_split_tail(loop_body, sctx2, ctx, st)
      let (kok, kbody) = scps_split_tail(rest, sctx2, ctx, st)
      if lok && kok {
        let lam = EFn(array_empty_str(), scps_empty_tbs(), scps_empty_params(), None, None, lowered)
        (true, ELet(kname, scps_mk_fn1(bv, kbody), ELetRec(lp, lam, ECall(EIdent(lp, -1), array_empty_expr(), -1)), -1))
      } else {
        (false, orig)
      }
    }
  }
}

// --- per-site transform: driver synthesis. Returns None (with a pushed
// error) when the site is ineligible -- the caller keeps the original
// node, and the pass's caller turns the error list into a hard compile
// failure (a value-referencing arm can never compile on the replay path,
// so silence is not an option).

fn scps_transform_handle(body: Expr, arms: Array[(Pat, Expr)], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), scope: Array[(String, String)]) -> Option[Expr] {
  let errs = scps_st_errs(st)
  // effect identity: every arm must be `Eff::Op` for one shared DECLARED
  // effect, and Error (non-resumable) arms may not appear.
  let mut eff = ""
  let mut shape_ok = true
  let mut si = 0
  while si < Array::length(arms) {
    let (p, _) = Array::get(arms, si)
    match p {
      PCtor(q, _) => {
        let ci = String::index_of(q, "::")
        if ci > 0 {
          let qe = String::substring(q, 0, ci)
          if eff == "" {
            eff = qe
          } else if eff == qe {
            ()
          } else {
            shape_ok = false
          }
        } else {
          shape_ok = false
        }
      },
      _ => {
        shape_ok = false
      }
    }
    si = si + 1
  }
  let (eff_declared, decl_ops) = scps_effect_decl_ops(ctx, eff)
  if !shape_ok || idp_arms_discharge_error(arms) || !eff_declared {
    Array::push(errs, "a handler arm captures `resume` as a value, but this handle has an Error arm (Error is non-resumable, #640), mixes effects, or handles a non-declared effect -- not supported by the suspend lowering (#817, ADR-0076)")
    None
  } else {
    let ops_qnames = array_empty_str()
    let mut oi = 0
    while oi < Array::length(decl_ops) {
      let (opname, _) = Array::get(decl_ops, oi)
      Array::push(ops_qnames, String::concat(String::concat(eff, "::"), opname))
      oi = oi + 1
    }
    let needing = scps_needing_for(ctx, eff)
    let site = scps_next_site(st)
    // closure-CPS (追記31 Vertical B): lexical bindings whose row carries
    // the handled effect (enclosing-fn params with an annotated E-row, and
    // let-bound literals the prepass step-split) are callable step sources
    // inside this body. Last binding of a name wins ("" row = mask).
    let cps_seed = array_empty_str()
    let seen_scope = array_empty_str()
    let mut sci = Array::length(scope) - 1
    while sci >= 0 {
      let (snm, srow) = Array::get(scope, sci)
      if edp_str_array_contains(seen_scope, snm) {
        ()
      } else {
        Array::push(seen_scope, snm)
        if srow != "" && scps_row_contains(ctx, srow, eff) {
          Array::push(cps_seed, snm)
        } else {
          ()
        }
      }
      sci = sci - 1
    }
    let sctx = (eff, ops_qnames, needing, site, cps_seed)
    if !scps_calls_ok(body, sctx, ctx) {
      // #1536 / #1514 parity: name the offending call and carry its offset
      // as the ` [@off=N:M]` marker the located lanes resolve (and every
      // lane strips), same contract as the handle-side culprit marker.
      let (culprit_clause, culprit_marker) = scps_culprit_parts(body, sctx, ctx)
      let mut scps_msg = "a handler arm captures `resume` as a value (suspend class, ADR-0076 Phase 3a/3b), but the handle body calls something this suspend lowering cannot see through (a local closure, a method-style callee, a nested handle, or a function whose declared row has a row variable)"
      scps_msg = String::concat(scps_msg, culprit_clause)
      scps_msg = String::concat(scps_msg, " -- only `perform`, pure builtins, constructors, provably effect-free functions, and functions whose concrete row carries the handled effect may be called in the handled body (#817)")
      scps_msg = String::concat(scps_msg, culprit_marker)
      Array::push(errs, scps_msg)
      None
    } else {
      let (split_ok, split_body) = scps_split_tail(body, sctx, ctx, st)
      if !split_ok {
        Array::push(errs, "a handler arm captures `resume` as a value (suspend class, ADR-0076 Phase 3a/3b), but a perform of the handled effect (or a call to a function that performs it) is not directly on the handle body's let/seq/tail/branch-tail spine (a loop body containing `return`, a `for` form, nested closures/handles, and nested expression positions are not eligible; a `while` / `loop` spine is, including one carrying `break` / `continue`, #1230/#1536) (#817)")
        None
      } else {
        scps_ensure_effect_runtime(eff, ctx, st)
        let drive = scps_local("__scps_drive", site)
        let kname = scps_local("__scps_k", site)
        let once = scps_local("__scps_once", site)
        let rv = scps_local("__scps_rv", site)
        let vname = scps_local("__scps_v", site)
        let dmarms = scps_empty_arms()
        let done_pats = scps_empty_pats()
        Array::push(done_pats, PBind(vname))
        Array::push(dmarms, (PCtor(scps_done_name(eff), done_pats), EIdent(vname, -1)))
        let mut di = 0
        while di < Array::length(arms) {
          let (p, ab) = Array::get(arms, di)
          let (aq, subpats) = match p {
            PCtor(q, sp) => (q, sp),
            _ => ("", scps_empty_pats())
          }
          let ypats = scps_empty_pats()
          let mut pi = 0
          while pi < Array::length(subpats) {
            Array::push(ypats, Array::get(subpats, pi))
            pi = pi + 1
          }
          Array::push(ypats, PBind(kname))
          let once_get = ECall(EIdent("Array::get", -1), [
            EIdent(once, -1),
            EInt(0)
          ], -1)
          // One-shot violation: write the diagnostic and TRAP via an
          // out-of-bounds Array::get (clean `unreachable`, verified to
          // trap correctly INSIDE a closure). NOT assert(false) (#1095:
          // assert inside a closure miscompiles to a null indirect call)
          // and NOT Exception::Throw (the #944 entry boundary only wraps
          // entries whose declared row carries Error, so a synthesized
          // throw in a program with no Error row would leak to the host
          // as a raw WebAssembly.Exception with no message at all).
          let trap = ESeq(ECall(EIdent("Stderr::write_stream", -1), [
            EString("vibe: resume one-shot continuation called twice (#817, ADR-0076 Phase 3a)\n")
          ], -1), ECall(EIdent("Array::get", -1), [
            EArray([
              EInt(0)
            ]),
            EInt(1)
          ], -1))
          let set_true = ECall(EIdent("Array::set", -1), [
            EIdent(once, -1),
            EInt(0),
            EBool(true)
          ], -1)
          let drive_call = ECall(EIdent(drive, -1), [
            ECall(EIdent(kname, -1), [
              EIdent(rv, -1)
            ], -1)
          ], -1)
          let rfn = scps_mk_fn1(rv, EIf(once_get, trap, ESeq(set_true, drive_call)))
          let lowered = ELet(once, EArray([
            EBool(false)
          ]), ELet("resume", rfn, ab, -1), -1)
          Array::push(dmarms, (PCtor(scps_y_name(eff, scps_op_suffix(aq)), ypats), lowered))
          di = di + 1
        }
        let stn = scps_local("__scps_st", site)
        let dfn = scps_mk_fn1(stn, EMatch(EIdent(stn, -1), dmarms))
        Some(ELetRec(drive, dfn, ECall(EIdent(drive, -1), [
          split_body
        ], -1)))
      }
    }
  }
}

// --- #1536 (a): inert closure-param see-through.
//
// A ROW-FREE function-typed parameter (`pred: (x: T) -> Bool`) is not
// automatically safe to call from a CPS clone: #761 charges a closure
// literal's performs to the ENCLOSING function's row, so "declared row is
// empty => cannot perform" does not hold for values arriving through a
// parameter (docs/spec/wasi-p3-async.md §2.2). What IS sound is an
// argument-flow proof: the clone `__scps_cps_E_f` is only ever invoked
// from BY-NAME call sites of `f` (a call through a binding that aliases
// `f` runs the untouched original), so if every by-name site of `f`
// passes a provably suspend-inert value in that slot -- a closure literal
// whose body cannot reach a perform of E (no perform at all, no needing
// name, no opaque callee), or the enclosing top-level fn's own row-free
// param whose slot is proven the same way (delegation, e.g.
// `async_iter_any` forwarding `pred` to `async_iter_find`) -- then a call
// through that parameter inside the clone cannot suspend and compiles as
// a plain call.
//
// Mechanically the proof does NOT widen `sctx`: a proven param is
// alpha-renamed into the reserved `__scps_inert_<site>_<name>` namespace
// inside the clone only (shadow-aware, scps_rename_ident), and both
// scps_calls_ok and scps_first_bad_call_info already accept the
// `__scps_` prefix, while scps_split_tail treats the call as an ordinary
// spine element (it is neither a needing call nor a cps-local call), so
// no bubble is emitted -- exactly the plain-call semantics the proof
// grants. An unproven param is left alone and keeps today's rejection.
//
// Conservative by construction: ANY perform inside a candidate literal
// taints it (even of an unrelated tail-resumptive effect -- alias
// spellings make per-effect matching unreliable here), as does any
// reference to a needing name (call or value), any opaque/method/row-var
// callee, any nested handle, a labeled/spread argument at a site, a
// value reference to `f` itself anywhere, or a rebind of the forwarded
// param name anywhere in the delegating fn's body.

/// Shadow-aware alpha-rename of local name `x` to `nx` in `e` -- reads,
/// writes and compound-assign targets, stopping at any binder that
/// shadows `x`. Traversal mirrors scps_cellify.
fn scps_rename_ident(e: Expr, x: String, nx: String) -> Expr {
  match e {
    EIdent(nm, off) => if nm == x {
      EIdent(nx, off)
    } else {
      e
    },
    EAssign(nm, v, b) => if nm == x {
      EAssign(nx, scps_rename_ident(v, x, nx), scps_rename_ident(b, x, nx))
    } else {
      EAssign(nm, scps_rename_ident(v, x, nx), scps_rename_ident(b, x, nx))
    },
    EAssignOp(op, nm, v, b) => if nm == x {
      EAssignOp(op, nx, scps_rename_ident(v, x, nx), scps_rename_ident(b, x, nx))
    } else {
      EAssignOp(op, nm, scps_rename_ident(v, x, nx), scps_rename_ident(b, x, nx))
    },
    ELet(nm, v, b, off) => ELet(nm, scps_rename_ident(v, x, nx), if nm == x {
      b
    } else {
      scps_rename_ident(b, x, nx)
    }, off),
    ELetMut(nm, v, b, off) => ELetMut(nm, scps_rename_ident(v, x, nx), if nm == x {
      b
    } else {
      scps_rename_ident(b, x, nx)
    }, off),
    ELetRec(nm, v, b) => if nm == x {
      e
    } else {
      ELetRec(nm, scps_rename_ident(v, x, nx), scps_rename_ident(b, x, nx))
    },
    ESeq(a, b) => ESeq(scps_rename_ident(a, x, nx), scps_rename_ident(b, x, nx)),
    EIf(c, t, el) => EIf(scps_rename_ident(c, x, nx), scps_rename_ident(t, x, nx), scps_rename_ident(el, x, nx)),
    EMatch(s, arms) => EMatch(scps_rename_ident(s, x, nx), scps_rename_ident_arms(arms, x, nx)),
    EHandle(b, arms) => EHandle(scps_rename_ident(b, x, nx), scps_rename_ident_arms(arms, x, nx)),
    EFn(tps, tbs, params, rt, ef, b) => if scps_params_bind_name(params, x) {
      e
    } else {
      EFn(tps, tbs, params, rt, ef, scps_rename_ident(b, x, nx))
    },
    EWhile(c, b) => EWhile(scps_rename_ident(c, x, nx), scps_rename_ident(b, x, nx)),
    EForIn(nm, idx, it, b) => {
      let shadowed = nm == x || match idx {
        Some(inm) => inm == x,
        None => false
      }
      EForIn(nm, idx, scps_rename_ident(it, x, nx), if shadowed {
        b
      } else {
        scps_rename_ident(b, x, nx)
      })
    },
    ELoop(pairs, b) => {
      let mut shadowed = false
      let out = scps_empty_pairs()
      let mut i = 0
      while i < Array::length(pairs) {
        let (nm, v) = Array::get(pairs, i)
        if nm == x {
          shadowed = true
        } else {
          ()
        }
        Array::push(out, (nm, scps_rename_ident(v, x, nx)))
        i = i + 1
      }
      ELoop(out, if shadowed {
        b
      } else {
        scps_rename_ident(b, x, nx)
      })
    },
    ECall(callee, args, off) => ECall(scps_rename_ident(callee, x, nx), scps_rename_ident_exprs(args, x, nx), off),
    EBinOp(op, l, r) => EBinOp(op, scps_rename_ident(l, x, nx), scps_rename_ident(r, x, nx)),
    EUnaryOp(op, a) => EUnaryOp(op, scps_rename_ident(a, x, nx)),
    EReturn(a) => EReturn(scps_rename_ident(a, x, nx)),
    EDot(o, f, off, foff) => EDot(scps_rename_ident(o, x, nx), f, off, foff),
    ELabeledArg(l, m, v) => ELabeledArg(l, m, scps_rename_ident(v, x, nx)),
    EBreak(opt) => match opt {
      Some(a) => EBreak(Some(scps_rename_ident(a, x, nx))),
      None => e
    },
    EContinue(args) => EContinue(scps_rename_ident_exprs(args, x, nx)),
    ETuple(items) => ETuple(scps_rename_ident_exprs(items, x, nx)),
    EArray(items) => EArray(scps_rename_ident_exprs(items, x, nx)),
    ERecord(rn, fields, targs) => ERecord(rn, scps_rename_ident_pairs(fields, x, nx), targs),
    EMap(fields) => EMap(scps_rename_ident_pairs(fields, x, nx)),
    ESpread(a) => ESpread(scps_rename_ident(a, x, nx)),
    _ => e
  }
}

fn scps_rename_ident_exprs(es: Array[Expr], x: String, nx: String) -> Array[Expr] {
  let out = array_empty_expr()
  let mut i = 0
  while i < Array::length(es) {
    Array::push(out, scps_rename_ident(Array::get(es, i), x, nx))
    i = i + 1
  }
  out
}

fn scps_rename_ident_pairs(pairs: Array[(String, Expr)], x: String, nx: String) -> Array[(String, Expr)] {
  let out = scps_empty_pairs()
  let mut i = 0
  while i < Array::length(pairs) {
    let (nm, v) = Array::get(pairs, i)
    Array::push(out, (nm, scps_rename_ident(v, x, nx)))
    i = i + 1
  }
  out
}

fn scps_rename_ident_arms(arms: Array[(Pat, Expr)], x: String, nx: String) -> Array[(Pat, Expr)] {
  let out = scps_empty_arms()
  let mut i = 0
  while i < Array::length(arms) {
    let (p, ex) = Array::get(arms, i)
    Array::push(out, (p, if scps_pat_binds_name(p, x) {
      ex
    } else {
      scps_rename_ident(ex, x, nx)
    }))
    i = i + 1
  }
  out
}

/// True if ANY binder anywhere in `e` (let / let mut / let rec / closure
/// param / for / loop / match / handle arm pattern) binds `x`. Used as the
/// conservative shadow check before trusting a forwarded param name at a
/// delegating call site.
fn scps_binds_name(e: Expr, x: String) -> Bool {
  match e {
    ELet(nm, v, b, _) => nm == x || scps_binds_name(v, x) || scps_binds_name(b, x),
    ELetMut(nm, v, b, _) => nm == x || scps_binds_name(v, x) || scps_binds_name(b, x),
    ELetRec(nm, v, b) => nm == x || scps_binds_name(v, x) || scps_binds_name(b, x),
    EFn(_, _, params, _, _, b) => scps_params_bind_name(params, x) || scps_binds_name(b, x),
    EForIn(nm, idx, it, b) => nm == x || match idx {
      Some(inm) => inm == x,
      None => false
    } || scps_binds_name(it, x) || scps_binds_name(b, x),
    ELoop(pairs, b) => {
      let mut hit = scps_binds_name(b, x)
      let mut i = 0
      while i < Array::length(pairs) {
        let (nm, v) = Array::get(pairs, i)
        if nm == x || scps_binds_name(v, x) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EMatch(s, arms) => scps_binds_name(s, x) || scps_binds_name_arms(arms, x),
    EHandle(b, arms) => scps_binds_name(b, x) || scps_binds_name_arms(arms, x),
    ESeq(a, b) => scps_binds_name(a, x) || scps_binds_name(b, x),
    EIf(c, t, el) => scps_binds_name(c, x) || scps_binds_name(t, x) || scps_binds_name(el, x),
    ECall(callee, args, _) => scps_binds_name(callee, x) || scps_binds_name_exprs(args, x),
    EBinOp(_, l, r) => scps_binds_name(l, x) || scps_binds_name(r, x),
    EUnaryOp(_, a) => scps_binds_name(a, x),
    EAssign(_, v, b) => scps_binds_name(v, x) || scps_binds_name(b, x),
    EAssignOp(_, _, v, b) => scps_binds_name(v, x) || scps_binds_name(b, x),
    EReturn(a) => scps_binds_name(a, x),
    EDot(o, _, _, _) => scps_binds_name(o, x),
    ELabeledArg(_, _, v) => scps_binds_name(v, x),
    EBreak(opt) => match opt {
      Some(a) => scps_binds_name(a, x),
      None => false
    },
    EContinue(args) => scps_binds_name_exprs(args, x),
    ETuple(items) => scps_binds_name_exprs(items, x),
    EArray(items) => scps_binds_name_exprs(items, x),
    ERecord(_, fields, _) => scps_binds_name_pairs(fields, x),
    EMap(fields) => scps_binds_name_pairs(fields, x),
    ESpread(a) => scps_binds_name(a, x),
    _ => false
  }
}

fn scps_binds_name_exprs(es: Array[Expr], x: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(es) {
    if scps_binds_name(Array::get(es, i), x) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_binds_name_pairs(pairs: Array[(String, Expr)], x: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, i)
    if scps_binds_name(v, x) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_binds_name_arms(arms: Array[(Pat, Expr)], x: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(arms) {
    let (p, ex) = Array::get(arms, i)
    if scps_pat_binds_name(p, x) || scps_binds_name(ex, x) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// True if `x` occurs ANYWHERE in `e` as an identifier reference or an
/// assignment target (scope-blind on purpose: this feeds the seq-float's
/// freshness probe, where any occurrence at all -- bound or free -- means
/// the candidate spelling is not safe to mint). Binder occurrences are
/// scps_binds_name's job; scps_mentions_name below ORs the two.
fn scps_refs_name(e: Expr, x: String) -> Bool {
  match e {
    EIdent(nm, _) => nm == x,
    EAssign(nm, v, b) => nm == x || scps_refs_name(v, x) || scps_refs_name(b, x),
    EAssignOp(_, nm, v, b) => nm == x || scps_refs_name(v, x) || scps_refs_name(b, x),
    ELet(_, v, b, _) => scps_refs_name(v, x) || scps_refs_name(b, x),
    ELetMut(_, v, b, _) => scps_refs_name(v, x) || scps_refs_name(b, x),
    ELetRec(_, v, b) => scps_refs_name(v, x) || scps_refs_name(b, x),
    EFn(_, _, _, _, _, b) => scps_refs_name(b, x),
    EForIn(_, _, it, b) => scps_refs_name(it, x) || scps_refs_name(b, x),
    ELoop(pairs, b) => {
      let mut hit = scps_refs_name(b, x)
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, v) = Array::get(pairs, i)
        if scps_refs_name(v, x) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EMatch(s, arms) => scps_refs_name(s, x) || scps_refs_name_arms(arms, x),
    EHandle(b, arms) => scps_refs_name(b, x) || scps_refs_name_arms(arms, x),
    ESeq(a, b) => scps_refs_name(a, x) || scps_refs_name(b, x),
    EIf(c, t, el) => scps_refs_name(c, x) || scps_refs_name(t, x) || scps_refs_name(el, x),
    ECall(callee, args, _) => scps_refs_name(callee, x) || scps_refs_name_exprs(args, x),
    EBinOp(_, l, r) => scps_refs_name(l, x) || scps_refs_name(r, x),
    EUnaryOp(_, a) => scps_refs_name(a, x),
    EReturn(a) => scps_refs_name(a, x),
    EDot(o, _, _, _) => scps_refs_name(o, x),
    ELabeledArg(_, _, v) => scps_refs_name(v, x),
    EBreak(opt) => match opt {
      Some(a) => scps_refs_name(a, x),
      None => false
    },
    EContinue(args) => scps_refs_name_exprs(args, x),
    ETuple(items) => scps_refs_name_exprs(items, x),
    EArray(items) => scps_refs_name_exprs(items, x),
    ERecord(_, fields, _) => scps_refs_name_pairs(fields, x),
    EMap(fields) => scps_refs_name_pairs(fields, x),
    ESpread(a) => scps_refs_name(a, x),
    _ => false
  }
}

fn scps_refs_name_exprs(es: Array[Expr], x: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(es) {
    if scps_refs_name(Array::get(es, i), x) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_refs_name_pairs(pairs: Array[(String, Expr)], x: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, i)
    if scps_refs_name(v, x) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_refs_name_arms(arms: Array[(Pat, Expr)], x: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(arms) {
    let (_, ex) = Array::get(arms, i)
    if scps_refs_name(ex, x) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_mentions_name(e: Expr, x: String) -> Bool {
  scps_binds_name(e, x) || scps_refs_name(e, x)
}

/// Mint the seq-float's alpha-renaming target: `__scps_seq<site>_<x>`,
/// bumped with a numeric suffix until the spelling occurs NOWHERE in the
/// floated continuation `k` or the sequence tail `b` (Codex P1 on #1607:
/// nothing stops a user binding or referencing the generated spelling
/// literally, and a collision either captures the tail's outer reference
/// or lets an inner binder capture the renamed occurrences -- both
/// silent-wrong). The probe is scope-blind (any occurrence disqualifies),
/// so the minted name is fresh for both roles by construction.
fn scps_seq_float_fresh(x: String, k: Expr, b: Expr, site: Int) -> String {
  let base = String::concat(String::concat(scps_local("__scps_seq", site), "_"), x)
  let mut nx = base
  let mut i = 0
  while scps_mentions_name(k, nx) || scps_mentions_name(b, nx) {
    i = i + 1
    nx = String::concat(String::concat(base, "_"), Int::to_string(i))
  }
  nx
}

/// Append the original sequence tail to every match arm without letting a
/// pattern binder capture a name in that tail. Each arm gets fresh binders
/// and a correspondingly alpha-renamed body before `b` is placed under the
/// arm scope. The scrutinee remains outside this helper and is evaluated once.
fn scps_seq_float_match_arms(arms: Array[(Pat, Expr)], b: Expr, site: Int) -> Array[(Pat, Expr)] {
  let out = scps_empty_arms()
  let mut i = 0
  while i < Array::length(arms) {
    let (p, body) = Array::get(arms, i)
    let names = array_empty()
    scps_pat_collect_binds(p, names)
    let mut p2 = p
    let mut body2 = body
    let mut ni = 0
    while ni < Array::length(names) {
      let nm = Array::get(names, ni)
      let mut seen = false
      let mut prev = 0
      while prev < ni {
        if Array::get(names, prev) == nm {
          seen = true
        } else {
          ()
        }
        prev = prev + 1
      }
      if seen {
        ()
      } else {
        let nx = scps_seq_float_match_fresh(nm, p2, body2, b, site, i)
        p2 = scps_rename_pat_ident(p2, nm, nx)
        body2 = scps_rename_ident(body2, nm, nx)
      }
      ni = ni + 1
    }
    Array::push(out, (p2, ESeq(body2, b)))
    i = i + 1
  }
  out
}

/// Fresh name for one distributed match arm. Besides the arm body and shared
/// tail, probe the pattern itself: a target already bound by a sibling field
/// or an or-pattern would change its binding relation.
fn scps_seq_float_match_fresh(x: String, p: Pat, body: Expr, b: Expr, site: Int, arm: Int) -> String {
  let arm_base = String::concat(String::concat(scps_local("__scps_match", site), "_"), Int::to_string(arm))
  let base = String::concat(String::concat(arm_base, "_"), x)
  let mut nx = base
  let mut i = 0
  while scps_pat_binds_name(p, nx) || scps_mentions_name(body, nx) || scps_mentions_name(b, nx) {
    i = i + 1
    nx = String::concat(String::concat(base, "_"), Int::to_string(i))
  }
  nx
}

fn scps_rename_pat_ident(p: Pat, x: String, nx: String) -> Pat {
  match p {
    PBind(nm) => if nm == x {
      PBind(nx)
    } else {
      p
    },
    PCtor(nm, ps) => PCtor(nm, scps_rename_pat_idents(ps, x, nx)),
    PTuple(ps) => PTuple(scps_rename_pat_idents(ps, x, nx)),
    POr(a, b) => POr(scps_rename_pat_ident(a, x, nx), scps_rename_pat_ident(b, x, nx)),
    PStruct(nm, fields) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fp) = Array::get(fields, i)
        Array::push(out, (fname, scps_rename_pat_ident(fp, x, nx)))
        i = i + 1
      }
      PStruct(nm, out)
    },
    _ => p
  }
}

fn scps_rename_pat_idents(ps: Array[Pat], x: String, nx: String) -> Array[Pat] {
  let out = scps_empty_pats()
  let mut i = 0
  while i < Array::length(ps) {
    Array::push(out, scps_rename_pat_ident(Array::get(ps, i), x, nx))
    i = i + 1
  }
  out
}

/// True if `e` could reach a suspend of the effect under proof: ANY
/// perform (per-effect matching is unreliable under alias spellings, so
/// every perform taints), any reference to a needing name (call OR value
/// -- a value escape could smuggle a performer), any callee that is not a
/// pure/safe-mut builtin, a ctor, or a named top-level fn with a concrete
/// eff-free row, any reference into the reserved `__scps_`/`__Scps`
/// namespace, or any nested handle. Nested closure literals are recursed
/// (their row annotation carrying `eff` also taints -- convention
/// mixing).
///
/// `locals` carries the names BOUND WITHIN the candidate literal (its
/// params plus let/letrec/for/loop/match binders on the path): a bare
/// identifier outside that set is a CAPTURED value of unknown provenance
/// -- it may alias a closure the phase-2 prepass step-compiled (a
/// captured performing literal is spelled through its binding, not
/// inline) -- so passing one into an accepted callee would launder a
/// suspending closure through the plain-call convention. Everything not
/// locally bound taints, except ctor references (Codex review on #1602).
fn scps_inert_taint(e: Expr, eff: String, needing: Array[String], locals: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Bool {
  match e {
    EIdent(nm, _) => !edp_str_array_contains(locals, nm) && !scps_is_ctor_name(ctx, nm),
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if nm == "perform" {
        true
      } else if edp_str_array_contains(needing, nm) || String::starts_with(nm, "__scps_") || String::starts_with(nm, "__Scps") {
        true
      } else if idp_is_pure_builtin_call(nm) || scps_is_safe_mut_builtin(nm) || scps_is_ctor_name(ctx, nm) {
        scps_inert_taint_exprs(args, eff, needing, locals, ctx)
      } else {
        let (is_fn, row) = scps_fn_row_of(ctx, nm)
        if is_fn && !scps_row_contains(ctx, row, eff) && !scps_row_has_var(row) {
          scps_inert_taint_exprs(args, eff, needing, locals, ctx)
        } else {
          true
        }
      },
      _ => true
    },
    EHandle(_, _) => true,
    EFn(_, _, fparams, _, ef, b) => match ef {
      Some(row) => scps_row_contains(ctx, row, eff) || scps_row_has_var(row) || scps_inert_taint(b, eff, needing, scps_locals_with_params(locals, fparams), ctx),
      None => scps_inert_taint(b, eff, needing, scps_locals_with_params(locals, fparams), ctx)
    },
    ELet(nm, v, b, _) => scps_inert_taint(v, eff, needing, locals, ctx) || scps_inert_taint(b, eff, needing, scps_locals_with(locals, nm), ctx),
    ELetMut(nm, v, b, _) => scps_inert_taint(v, eff, needing, locals, ctx) || scps_inert_taint(b, eff, needing, scps_locals_with(locals, nm), ctx),
    ELetRec(nm, v, b) => {
      let ext = scps_locals_with(locals, nm)
      scps_inert_taint(v, eff, needing, ext, ctx) || scps_inert_taint(b, eff, needing, ext, ctx)
    },
    ESeq(a, b) => scps_inert_taint(a, eff, needing, locals, ctx) || scps_inert_taint(b, eff, needing, locals, ctx),
    EIf(c, t, el) => scps_inert_taint(c, eff, needing, locals, ctx) || scps_inert_taint(t, eff, needing, locals, ctx) || scps_inert_taint(el, eff, needing, locals, ctx),
    EMatch(s, arms) => scps_inert_taint(s, eff, needing, locals, ctx) || scps_inert_taint_arms(arms, eff, needing, locals, ctx),
    EWhile(c, b) => scps_inert_taint(c, eff, needing, locals, ctx) || scps_inert_taint(b, eff, needing, locals, ctx),
    EForIn(nm, idx, it, b) => {
      let ext = scps_locals_with(locals, nm)
      let ext2 = match idx {
        Some(inm) => scps_locals_with(ext, inm),
        None => ext
      }
      scps_inert_taint(it, eff, needing, locals, ctx) || scps_inert_taint(b, eff, needing, ext2, ctx)
    },
    ELoop(pairs, b) => {
      let mut ext = locals
      let mut hit = false
      let mut i = 0
      while i < Array::length(pairs) {
        let (nm, v) = Array::get(pairs, i)
        if scps_inert_taint(v, eff, needing, locals, ctx) {
          hit = true
        } else {
          ()
        }
        ext = scps_locals_with(ext, nm)
        i = i + 1
      }
      hit || scps_inert_taint(b, eff, needing, ext, ctx)
    },
    EBinOp(_, l, r) => scps_inert_taint(l, eff, needing, locals, ctx) || scps_inert_taint(r, eff, needing, locals, ctx),
    EUnaryOp(_, a) => scps_inert_taint(a, eff, needing, locals, ctx),
    EAssign(_, v, b) => scps_inert_taint(v, eff, needing, locals, ctx) || scps_inert_taint(b, eff, needing, locals, ctx),
    EAssignOp(_, _, v, b) => scps_inert_taint(v, eff, needing, locals, ctx) || scps_inert_taint(b, eff, needing, locals, ctx),
    EReturn(a) => scps_inert_taint(a, eff, needing, locals, ctx),
    EDot(o, _, _, _) => scps_inert_taint(o, eff, needing, locals, ctx),
    ELabeledArg(_, _, v) => scps_inert_taint(v, eff, needing, locals, ctx),
    EBreak(opt) => match opt {
      Some(a) => scps_inert_taint(a, eff, needing, locals, ctx),
      None => false
    },
    EContinue(args) => scps_inert_taint_exprs(args, eff, needing, locals, ctx),
    ETuple(items) => scps_inert_taint_exprs(items, eff, needing, locals, ctx),
    EArray(items) => scps_inert_taint_exprs(items, eff, needing, locals, ctx),
    ERecord(_, fields, _) => scps_inert_taint_pairs(fields, eff, needing, locals, ctx),
    EMap(fields) => scps_inert_taint_pairs(fields, eff, needing, locals, ctx),
    ESpread(a) => scps_inert_taint(a, eff, needing, locals, ctx),
    _ => false
  }
}

fn scps_locals_with(locals: Array[String], nm: String) -> Array[String] {
  let out = Array::slice(locals, 0, Array::length(locals))
  Array::push(out, nm)
  out
}

fn scps_locals_with_params(locals: Array[String], params: Array[(String, Option[TypeExpr])]) -> Array[String] {
  let out = Array::slice(locals, 0, Array::length(locals))
  let mut i = 0
  while i < Array::length(params) {
    let (pnm, _) = Array::get(params, i)
    Array::push(out, pnm)
    i = i + 1
  }
  out
}

fn scps_pat_collect_binds(p: Pat, acc: Array[String]) -> Unit {
  match p {
    PBind(n) => Array::push(acc, n),
    PCtor(_, ps) => scps_pats_collect_binds(ps, acc),
    PTuple(ps) => scps_pats_collect_binds(ps, acc),
    POr(a, b) => {
      scps_pat_collect_binds(a, acc)
      scps_pat_collect_binds(b, acc)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        scps_pat_collect_binds(fp, acc)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn scps_pats_collect_binds(ps: Array[Pat], acc: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(ps) {
    scps_pat_collect_binds(Array::get(ps, i), acc)
    i = i + 1
  }
}

fn scps_inert_taint_exprs(es: Array[Expr], eff: String, needing: Array[String], locals: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(es) {
    if scps_inert_taint(Array::get(es, i), eff, needing, locals, ctx) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_inert_taint_pairs(pairs: Array[(String, Expr)], eff: String, needing: Array[String], locals: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, i)
    if scps_inert_taint(v, eff, needing, locals, ctx) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_inert_taint_arms(arms: Array[(Pat, Expr)], eff: String, needing: Array[String], locals: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(arms) {
    let (p, ex) = Array::get(arms, i)
    let ext = Array::slice(locals, 0, Array::length(locals))
    scps_pat_collect_binds(p, ext)
    if scps_inert_taint(ex, eff, needing, ext, ctx) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// Is argument `a` (found in a proven-slot position at a by-name call
/// site) suspend-inert? A closure literal must have a taint-free body and
/// must not itself declare a row carrying `eff`; a bare identifier is
/// accepted only as the enclosing top-level fn's own function-typed param
/// whose slot is (recursively) proven and never rebound anywhere in that
/// fn's body. Everything else is not provable.
fn scps_arg_is_inert(a: Expr, has_encl: Bool, encl_params: Array[(String, Option[TypeExpr])], encl_body: Expr, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), encl_name: String, visiting: Array[String]) -> Bool {
  match a {
    EFn(_, _, aparams, _, ef, b) => {
      let row_ok = match ef {
        Some(row) => !scps_row_contains(ctx, row, eff) && !scps_row_has_var(row),
        None => true
      }
      // The taint scan starts with ONLY the literal's own params as
      // locally-bound names: any other bare identifier in the body is a
      // captured value of unknown provenance and taints (it may alias a
      // step-compiled closure -- Codex review on #1602).
      row_ok && !scps_inert_taint(b, eff, needing, scps_locals_with_params(array_empty_str(), aparams), ctx)
    },
    EIdent(an, _) => if has_encl {
      let mut slot = -1
      let mut i = 0
      while i < Array::length(encl_params) {
        let (pnm, _) = Array::get(encl_params, i)
        if pnm == an && slot < 0 {
          slot = i
        } else {
          ()
        }
        i = i + 1
      }
      if slot < 0 {
        false
      } else if scps_binds_name(encl_body, an) {
        false
      } else {
        scps_param_slot_inert(encl_name, slot, eff, needing, ctx, visiting)
      }
    } else {
      false
    },
    _ => false
  }
}

/// True when every occurrence of `fname` in `e` is a by-name call whose
/// argument in `slot` is suspend-inert -- and `fname` never escapes as a
/// bare value. Binders shadowing `fname` stop the scan (calls below them
/// are not calls to the top-level fn).
fn scps_slot_sites_ok(e: Expr, fname: String, slot: Int, has_encl: Bool, encl_params: Array[(String, Option[TypeExpr])], encl_body: Expr, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), encl_name: String, visiting: Array[String]) -> Bool {
  // Phase 3 has already rewritten suspend-context call sites of `fname`
  // to its CPS-clone spelling (args preserved) by the time phase 4 runs
  // this proof, so a site counts under EITHER name -- missing the
  // rewritten spelling would let a tainted argument through unseen.
  let cname = scps_clone_name(eff, fname)
  match e {
    EIdent(nm, _) => nm != fname && nm != cname,
    ECall(callee, args, _) => {
      let head_ok = match callee {
        EIdent(nm, _) => if nm == fname || nm == cname {
          let mut shape_ok = slot < Array::length(args)
          let mut ai = 0
          while ai < Array::length(args) {
            match Array::get(args, ai) {
              ELabeledArg(_, _, _) => {
                shape_ok = false
              },
              ESpread(_) => {
                shape_ok = false
              },
              _ => ()
            }
            ai = ai + 1
          }
          shape_ok && scps_arg_is_inert(Array::get(args, slot), has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)
        } else {
          true
        },
        _ => scps_slot_sites_ok(callee, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)
      }
      let mut ok = head_ok
      let mut i = 0
      while i < Array::length(args) {
        // Bare-ident args recurse like everything else: EIdent(fname) in
        // ANY argument position (including a self-call's own slot) is a
        // value escape and must fail via the EIdent arm.
        if !scps_slot_sites_ok(Array::get(args, i), fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok
    },
    EFn(_, _, params, _, _, b) => if scps_params_bind_name(params, fname) {
      true
    } else {
      scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)
    },
    ELet(nm, v, b, _) => scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && (nm == fname || scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)),
    ELetMut(nm, v, b, _) => scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && (nm == fname || scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)),
    ELetRec(nm, v, b) => if nm == fname {
      true
    } else {
      scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)
    },
    ESeq(a, b) => scps_slot_sites_ok(a, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EIf(c, t, el) => scps_slot_sites_ok(c, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(t, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(el, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EMatch(s, arms) => {
      let mut ok = scps_slot_sites_ok(s, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        if scps_pat_binds_name(p, fname) {
          ()
        } else if !scps_slot_sites_ok(ex, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok
    },
    EHandle(b, arms) => {
      let mut ok = scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        if scps_pat_binds_name(p, fname) {
          ()
        } else if !scps_slot_sites_ok(ex, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok
    },
    EWhile(c, b) => scps_slot_sites_ok(c, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EForIn(nm, idx, it, b) => {
      let shadowed = nm == fname || match idx {
        Some(inm) => inm == fname,
        None => false
      }
      scps_slot_sites_ok(it, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && (shadowed || scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting))
    },
    ELoop(pairs, b) => {
      let mut shadowed = false
      let mut ok = true
      let mut i = 0
      while i < Array::length(pairs) {
        let (nm, v) = Array::get(pairs, i)
        if nm == fname {
          shadowed = true
        } else {
          ()
        }
        if !scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok && (shadowed || scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting))
    },
    EBinOp(_, l, r) => scps_slot_sites_ok(l, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(r, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EUnaryOp(_, a) => scps_slot_sites_ok(a, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EAssign(_, v, b) => scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EAssignOp(_, _, v, b) => scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EReturn(a) => scps_slot_sites_ok(a, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EDot(o, _, _, _) => scps_slot_sites_ok(o, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    ELabeledArg(_, _, v) => scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EBreak(opt) => match opt {
      Some(a) => scps_slot_sites_ok(a, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
      None => true
    },
    EContinue(args) => scps_slot_sites_ok_exprs(args, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    ETuple(items) => scps_slot_sites_ok_exprs(items, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EArray(items) => scps_slot_sites_ok_exprs(items, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    ERecord(_, fields, _) => scps_slot_sites_ok_pairs(fields, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EMap(fields) => scps_slot_sites_ok_pairs(fields, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    ESpread(a) => scps_slot_sites_ok(a, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    _ => true
  }
}

fn scps_slot_sites_ok_exprs(es: Array[Expr], fname: String, slot: Int, has_encl: Bool, encl_params: Array[(String, Option[TypeExpr])], encl_body: Expr, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), encl_name: String, visiting: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(es) {
    if !scps_slot_sites_ok(Array::get(es, i), fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn scps_slot_sites_ok_pairs(pairs: Array[(String, Expr)], fname: String, slot: Int, has_encl: Bool, encl_params: Array[(String, Option[TypeExpr])], encl_body: Expr, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), encl_name: String, visiting: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, i)
    if !scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

/// Prove param slot `slot` of top-level fn `fname` suspend-inert for
/// `eff`: the slot's declared type must be function-typed with a row that
/// is absent, or concrete and eff-free; and every by-name occurrence of
/// `fname` program-wide must be a call passing an inert value in that
/// slot. Delegation cycles are handled coinductively: a slot already on
/// the `visiting` stack contributes no new taint evidence and is treated
/// as inert within its own proof.
fn scps_param_slot_inert(fname: String, slot: Int, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), visiting: Array[String]) -> Bool {
  let key = String::concat(String::concat(fname, "||"), Int::to_string(slot))
  if edp_str_array_contains(visiting, key) {
    true
  } else {
    let (stmts, _, fn_defs, _, _, _) = ctx
    let slot_ok = match edp_params_of_fn(stmts, fn_defs, fname) {
      Some(params) => if slot < Array::length(params) {
        let (_, pty) = Array::get(params, slot)
        let prow = scps_ty_row(pty)
        match pty {
          Some(TyFn(_, _, _)) => !scps_row_contains(ctx, prow, eff) && !scps_row_has_var(prow),
          _ => false
        }
      } else {
        false
      },
      None => false
    }
    if !slot_ok {
      false
    } else {
      let visiting2 = Array::slice(visiting, 0, Array::length(visiting))
      Array::push(visiting2, key)
      let mut ok = true
      let mut i = 0
      while i < Array::length(stmts) {
        match Array::get(stmts, i) {
          SLet(_, _, dnm, _, dexpr) => match dexpr {
            EFn(_, _, dparams, _, _, dbody) => {
              if !scps_slot_sites_ok(dbody, fname, slot, true, dparams, dbody, eff, needing, ctx, dnm, visiting2) {
                ok = false
              } else {
                ()
              }
            },
            _ => if !scps_slot_sites_ok(dexpr, fname, slot, false, scps_empty_params(), EUnit, eff, needing, ctx, "", visiting2) {
              ok = false
            } else {
              ()
            }
          },
          SLetMut(_, _, mexpr) => if !scps_slot_sites_ok(mexpr, fname, slot, false, scps_empty_params(), EUnit, eff, needing, ctx, "", visiting2) {
            ok = false
          } else {
            ()
          },
          SExpr(sexpr) => if !scps_slot_sites_ok(sexpr, fname, slot, false, scps_empty_params(), EUnit, eff, needing, ctx, "", visiting2) {
            ok = false
          } else {
            ()
          },
          STest(_, texpr) => if !scps_slot_sites_ok(texpr, fname, slot, false, scps_empty_params(), EUnit, eff, needing, ctx, "", visiting2) {
            ok = false
          } else {
            ()
          },
          SBench(_, bexpr) => if !scps_slot_sites_ok(bexpr, fname, slot, false, scps_empty_params(), EUnit, eff, needing, ctx, "", visiting2) {
            ok = false
          } else {
            ()
          },
          _ => ()
        }
        i = i + 1
      }
      ok
    }
  }
}

// --- CPS clone emission (3b). The clone's EFn deliberately carries
// ret=None and eff=None: the return type is now __ScpsStep_E (an
// annotation would lie, and codegen ignores it post-check), and the row
// must not re-enter evidence_dict_pass's needing collection (the clone
// no longer performs anything directly).

fn scps_emit_clone(eff: String, fname: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Unit {
  let (stmts, _, fn_defs, _, _, _) = ctx
  let errs = scps_st_errs(st)
  let mut def_idx = -1
  let mut fi = 0
  while fi < Array::length(fn_defs) {
    let (idx, _, _, name, _, _) = Array::get(fn_defs, fi)
    if name == fname {
      def_idx = idx
    } else {
      ()
    }
    fi = fi + 1
  }
  if def_idx < 0 {
    Array::push(errs, String::concat(String::concat("suspend lowering: internal error -- no top-level definition found for `", fname), "` while emitting its CPS clone (#817)"))
  } else {
    match Array::get(stmts, def_idx) {
      SLet(_, _, _, _, EFn(tps, tbs, params, _, _, fbody)) => {
        scps_ensure_effect_runtime(eff, ctx, st)
        let (_, decl_ops) = scps_effect_decl_ops(ctx, eff)
        let ops_qnames = array_empty_str()
        let mut oi = 0
        while oi < Array::length(decl_ops) {
          let (opname, _) = Array::get(decl_ops, oi)
          Array::push(ops_qnames, String::concat(String::concat(eff, "::"), opname))
          oi = oi + 1
        }
        let needing = scps_needing_for(ctx, eff)
        let site = scps_next_site(st)
        // closure-CPS (追記31 Vertical B): the clone's own params whose
        // annotated row carries the effect are step-typed closure sources
        // (`run_with(f: () -> T with E)` called from a suspend body).
        let cps_seed = array_empty_str()
        let mut cpi = 0
        while cpi < Array::length(params) {
          let (pnm, pty) = Array::get(params, cpi)
          let prow = scps_ty_row(pty)
          if prow != "" && scps_row_contains(ctx, prow, eff) {
            Array::push(cps_seed, pnm)
          } else {
            ()
          }
          cpi = cpi + 1
        }
        // #1536 (a): a row-free (or concrete eff-free row) function-typed
        // param whose every by-name call site provably receives a
        // suspend-inert value is renamed into the reserved __scps_inert_
        // namespace inside this clone, which both eligibility walkers
        // already accept and the split leaves as a plain call (see the
        // inert see-through block above). An unproven param stays as-is
        // and keeps the existing rejection.
        let cparams = scps_empty_params()
        let mut fbody2 = fbody
        let mut ipi = 0
        while ipi < Array::length(params) {
          let (pnm, pty) = Array::get(params, ipi)
          let prow = scps_ty_row(pty)
          let in_seed = edp_str_array_contains(cps_seed, pnm)
          let candidate = match pty {
            Some(TyFn(_, _, _)) => !in_seed && !scps_row_contains(ctx, prow, eff) && !scps_row_has_var(prow),
            _ => false
          }
          if candidate && scps_param_slot_inert(fname, ipi, eff, needing, ctx, array_empty_str()) {
            let inm = String::concat(String::concat(scps_local("__scps_inert_", site), "_"), pnm)
            Array::push(cparams, (inm, pty))
            fbody2 = scps_rename_ident(fbody2, pnm, inm)
          } else {
            Array::push(cparams, (pnm, pty))
          }
          ipi = ipi + 1
        }
        let sctx = (eff, ops_qnames, needing, site, cps_seed)
        if !scps_calls_ok(fbody2, sctx, ctx) {
          // #1536 / #1514 parity: name the offending call inside `fname`'s
          // body. The offset indexes the module that defines `fname`, which
          // may not be the entry file -- verify_culprit_off_marker degrades
          // a basis mismatch to the unlocated message.
          let (culprit_clause, culprit_marker) = scps_culprit_parts(fbody2, sctx, ctx)
          let mut scps_msg = String::concat(String::concat(String::concat("function `", fname), String::concat("` (whose row carries ", eff)), ") is called from a suspend-class handle body, but its own body calls something the suspend lowering cannot see through (a local closure, a method-style callee, a nested handle, or a row-variable callee)")
          scps_msg = String::concat(scps_msg, culprit_clause)
          scps_msg = String::concat(scps_msg, " (#817, ADR-0076 Phase 3b)")
          scps_msg = String::concat(scps_msg, culprit_marker)
          Array::push(errs, scps_msg)
        } else {
          let (split_ok, split_body) = scps_split_tail(fbody2, sctx, ctx, st)
          if !split_ok {
            Array::push(errs, String::concat(String::concat(String::concat("function `", fname), String::concat("` (whose row carries ", eff)), ") is called from a suspend-class handle body, but a perform of that effect (or a call to a function that performs it) is not directly on its body's let/seq/tail/branch-tail spine (a loop body containing `return`, a `for` form, nested closures/handles, and nested expression positions are not eligible; a `while` / `loop` spine is, including one carrying `break` / `continue`, #1230/#1536) (#817, ADR-0076 Phase 3b)"))
          } else {
            Array::push(scps_st_inj(st), SLet(false, true, scps_clone_name(eff, fname), None, EFn(tps, tbs, cparams, None, None, split_body)))
          }
        }
      },
      _ => Array::push(errs, String::concat(String::concat("suspend lowering: internal error -- `", fname), "` is not a plain top-level function definition (#817)"))
    }
  }
}

// --- the whole-program rewrite walk. Bottom-up at EHandle: inner sites
// transform first, then this site's own trigger is evaluated on the
// already-rewritten arms/body. closure-CPS (追記31 Vertical B): the walk
// threads a lexical `scope` of (name, row) pairs -- fn params with their
// annotated row (or "" mask), let-bound step-split literals with the
// effect they were split for, every other binder as a "" mask -- so a
// transform site can seed its step-typed closure bindings.

fn scps_scope_push_pat(p: Pat, scope: Array[(String, String)]) -> Unit {
  match p {
    PBind(n) => Array::push(scope, (n, "")),
    PCtor(_, ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        scps_scope_push_pat(Array::get(ps, i), scope)
        i = i + 1
      }
    },
    PTuple(ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        scps_scope_push_pat(Array::get(ps, i), scope)
        i = i + 1
      }
    },
    POr(a, b) => {
      scps_scope_push_pat(a, scope)
      scps_scope_push_pat(b, scope)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        scps_scope_push_pat(fp, scope)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// The row to record for a let binding of `v`: the effect a step-split
/// literal was split for, else "" (mask).
fn scps_let_bind_row(v: Expr, cps_effs: Array[String]) -> String {
  let mut row = ""
  let mut i = 0
  while i < Array::length(cps_effs) {
    let eff = Array::get(cps_effs, i)
    if row == "" && scps_literal_is_step_for(v, eff) {
      row = eff
    } else {
      ()
    }
    i = i + 1
  }
  row
}

fn scps_rewrite(e: Expr, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), cps_effs: Array[String], scope: Array[(String, String)]) -> Expr {
  match e {
    EHandle(body, arms) => {
      let rbody = scps_rewrite(body, ctx, st, cps_effs, scope)
      let rarms = for a in arms {
        let (p, ex) = a
        let amark = Array::length(scope)
        scps_scope_push_pat(p, scope)
        let rex = scps_rewrite(ex, ctx, st, cps_effs, scope)
        Array::truncate(scope, amark)
        (p, rex)
      }
      let mut triggered = false
      let mut ai = 0
      while ai < Array::length(rarms) {
        let (ap, ab) = Array::get(rarms, ai)
        if scps_arm_refs_resume_value(ab, scps_pat_binds_resume(ap)) {
          triggered = true
        } else {
          ()
        }
        ai = ai + 1
      }
      if triggered {
        match scps_transform_handle(rbody, rarms, ctx, st, scope) {
          Some(t) => t,
          None => EHandle(rbody, rarms)
        }
      } else {
        EHandle(rbody, rarms)
      }
    },
    EFn(tps, tbs, params, ret, eff, b) => {
      let fmark = Array::length(scope)
      let mut fpi = 0
      while fpi < Array::length(params) {
        let (pnm, pty) = Array::get(params, fpi)
        Array::push(scope, (pnm, scps_ty_row(pty)))
        fpi = fpi + 1
      }
      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)
      Array::truncate(scope, fmark)
      EFn(tps, tbs, params, ret, eff, rb)
    },
    ELet(n, v, b, off) => {
      let rv = scps_rewrite(v, ctx, st, cps_effs, scope)
      let lmark = Array::length(scope)
      Array::push(scope, (n, scps_let_bind_row(rv, cps_effs)))
      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)
      Array::truncate(scope, lmark)
      ELet(n, rv, rb, off)
    },
    ELetMut(n, v, b, off) => {
      let rv = scps_rewrite(v, ctx, st, cps_effs, scope)
      let lmark = Array::length(scope)
      Array::push(scope, (n, ""))
      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)
      Array::truncate(scope, lmark)
      ELetMut(n, rv, rb, off)
    },
    ELetRec(n, v, b) => {
      let lmark = Array::length(scope)
      Array::push(scope, (n, ""))
      let rv = scps_rewrite(v, ctx, st, cps_effs, scope)
      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)
      Array::truncate(scope, lmark)
      ELetRec(n, rv, rb)
    },
    ESeq(a, b) => ESeq(scps_rewrite(a, ctx, st, cps_effs, scope), scps_rewrite(b, ctx, st, cps_effs, scope)),
    EIf(c, t, el) => EIf(scps_rewrite(c, ctx, st, cps_effs, scope), scps_rewrite(t, ctx, st, cps_effs, scope), scps_rewrite(el, ctx, st, cps_effs, scope)),
    EMatch(s, arms) => EMatch(scps_rewrite(s, ctx, st, cps_effs, scope), for a in arms {
      let (p, ex) = a
      let amark = Array::length(scope)
      scps_scope_push_pat(p, scope)
      let rex = scps_rewrite(ex, ctx, st, cps_effs, scope)
      Array::truncate(scope, amark)
      (p, rex)
    }),
    EWhile(c, b) => EWhile(scps_rewrite(c, ctx, st, cps_effs, scope), scps_rewrite(b, ctx, st, cps_effs, scope)),
    EForIn(n, idx, it, b) => {
      let rit = scps_rewrite(it, ctx, st, cps_effs, scope)
      let fmark = Array::length(scope)
      Array::push(scope, (n, ""))
      match idx {
        Some(ix) => Array::push(scope, (ix, "")),
        None => ()
      }
      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)
      Array::truncate(scope, fmark)
      EForIn(n, idx, rit, rb)
    },
    ECall(callee, args, off) => ECall(scps_rewrite(callee, ctx, st, cps_effs, scope), for a in args {
      scps_rewrite(a, ctx, st, cps_effs, scope)
    }, off),
    EBinOp(op, l, r) => EBinOp(op, scps_rewrite(l, ctx, st, cps_effs, scope), scps_rewrite(r, ctx, st, cps_effs, scope)),
    EUnaryOp(op, e2) => EUnaryOp(op, scps_rewrite(e2, ctx, st, cps_effs, scope)),
    EAssign(n, v, c) => EAssign(n, scps_rewrite(v, ctx, st, cps_effs, scope), scps_rewrite(c, ctx, st, cps_effs, scope)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, scps_rewrite(v, ctx, st, cps_effs, scope), scps_rewrite(c, ctx, st, cps_effs, scope)),
    EDot(o, f, off1, off2) => EDot(scps_rewrite(o, ctx, st, cps_effs, scope), f, off1, off2),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, scps_rewrite(v, ctx, st, cps_effs, scope)),
    EReturn(e2) => EReturn(scps_rewrite(e2, ctx, st, cps_effs, scope)),
    EBreak(opt) => EBreak(match opt {
      Some(e2) => Some(scps_rewrite(e2, ctx, st, cps_effs, scope)),
      None => None
    }),
    EContinue(args) => EContinue(for a in args {
      scps_rewrite(a, ctx, st, cps_effs, scope)
    }),
    ETuple(elems) => ETuple(for a in elems {
      scps_rewrite(a, ctx, st, cps_effs, scope)
    }),
    EArray(elems) => EArray(for a in elems {
      scps_rewrite(a, ctx, st, cps_effs, scope)
    }),
    ERecord(n, fields, tas) => ERecord(n, for f in fields {
      let (fn2, v) = f
      (fn2, scps_rewrite(v, ctx, st, cps_effs, scope))
    }, tas),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, scps_rewrite(v, ctx, st, cps_effs, scope))
    }),
    ESpread(e2) => ESpread(scps_rewrite(e2, ctx, st, cps_effs, scope)),
    ELoop(pairs, b) => {
      let rpairs = for p in pairs {
        let (n, v) = p
        (n, scps_rewrite(v, ctx, st, cps_effs, scope))
      }
      let lmark = Array::length(scope)
      let mut lpi = 0
      while lpi < Array::length(pairs) {
        let (n, _) = Array::get(pairs, lpi)
        Array::push(scope, (n, ""))
        lpi = lpi + 1
      }
      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)
      Array::truncate(scope, lmark)
      ELoop(rpairs, rb)
    },
    _ => e
  }
}

/// Additional builtins that are safe in a SUSPEND-lowered body but are
/// deliberately NOT on idp_pure_builtin_names: they MUTATE (Array::push /
/// Array::set / builder ops) or trap (assert), so adding them to the
/// shared list would newly change which handles Phase 2's INLINE pass
/// (and evidence_dict_pass) migrate off the replay path -- a behavior
/// change for replay-pinned fixtures this pass has no business making.
/// For the suspend lowering the only property that matters is the same
/// one the pure list encodes: checker-verified effect `None` and no
/// function-typed parameter, so the call can neither perform the handled
/// effect itself nor invoke a user closure that might. Each name below
/// was checked against the checker's builtin tables on those two axes.
fn scps_is_safe_mut_builtin(nm: String) -> Bool {
  let names = [
    "Array::push",
    "Array::set",
    "Array::slice",
    "ArrayBuilder::new",
    "ArrayBuilder::push",
    "ArrayBuilder::freeze",
    "Map::set",
    "Map::delete",
    "Bytes::set",
    "StringBuilder::new",
    "StringBuilder::push",
    "StringBuilder::freeze",
    // parser-desugar internals: `o.f = v` → __set_field(o, "f", v) and
    // `a[i]` → __index(a, i) (channel blocking slice — a suspend-class
    // clone body mutating a struct field, e.g. Channel.pend_seq, arrives
    // as a __set_field call). Both are checker-verified effect-free and
    // take no function-typed argument.
    "__set_field",
    "__index",
    "assert"
  ]
  let mut i = 0
  let mut found = false
  while i < Array::length(names) {
    if Array::get(names, i) == nm {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

// --- closure-CPS (追記31 Vertical B) whole-program phases.
//
// Phase 1 (collector): the set of effects with at least one TRIGGERED
// handle site anywhere -- the "CPS-mode" effects. Only these can require
// literal step-splitting.

fn scps_collect_cps_effs_expr(e: Expr, out: Array[String]) -> Unit {
  match e {
    EHandle(b, arms) => {
      scps_collect_cps_effs_expr(b, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        if scps_arm_refs_resume_value(ex, scps_pat_binds_resume(p)) {
          match p {
            PCtor(q, _) => {
              let ci = String::index_of(q, "::")
              if ci > 0 {
                let qe = String::substring(q, 0, ci)
                if edp_str_array_contains(out, qe) {
                  ()
                } else {
                  Array::push(out, qe)
                }
              } else {
                ()
              }
            },
            _ => ()
          }
        } else {
          ()
        }
        scps_collect_cps_effs_expr(ex, out)
        i = i + 1
      }
    },
    EFn(_, _, _, _, _, b) => scps_collect_cps_effs_expr(b, out),
    ELet(_, v, b, _) => {
      scps_collect_cps_effs_expr(v, out)
      scps_collect_cps_effs_expr(b, out)
    },
    ELetMut(_, v, b, _) => {
      scps_collect_cps_effs_expr(v, out)
      scps_collect_cps_effs_expr(b, out)
    },
    ELetRec(_, v, b) => {
      scps_collect_cps_effs_expr(v, out)
      scps_collect_cps_effs_expr(b, out)
    },
    ESeq(a, b) => {
      scps_collect_cps_effs_expr(a, out)
      scps_collect_cps_effs_expr(b, out)
    },
    EIf(c, t, el) => {
      scps_collect_cps_effs_expr(c, out)
      scps_collect_cps_effs_expr(t, out)
      scps_collect_cps_effs_expr(el, out)
    },
    EMatch(s, arms) => {
      scps_collect_cps_effs_expr(s, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, i)
        scps_collect_cps_effs_expr(ex, out)
        i = i + 1
      }
    },
    ECall(callee, args, _) => {
      scps_collect_cps_effs_expr(callee, out)
      let mut i = 0
      while i < Array::length(args) {
        scps_collect_cps_effs_expr(Array::get(args, i), out)
        i = i + 1
      }
    },
    EWhile(c, b) => {
      scps_collect_cps_effs_expr(c, out)
      scps_collect_cps_effs_expr(b, out)
    },
    EForIn(_, _, it, b) => {
      scps_collect_cps_effs_expr(it, out)
      scps_collect_cps_effs_expr(b, out)
    },
    ELoop(pairs, b) => {
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, v) = Array::get(pairs, i)
        scps_collect_cps_effs_expr(v, out)
        i = i + 1
      }
      scps_collect_cps_effs_expr(b, out)
    },
    EBinOp(_, l, r) => {
      scps_collect_cps_effs_expr(l, out)
      scps_collect_cps_effs_expr(r, out)
    },
    EUnaryOp(_, x) => scps_collect_cps_effs_expr(x, out),
    EAssign(_, v, c) => {
      scps_collect_cps_effs_expr(v, out)
      scps_collect_cps_effs_expr(c, out)
    },
    EAssignOp(_, _, v, c) => {
      scps_collect_cps_effs_expr(v, out)
      scps_collect_cps_effs_expr(c, out)
    },
    EReturn(x) => scps_collect_cps_effs_expr(x, out),
    EDot(o, _, _, _) => scps_collect_cps_effs_expr(o, out),
    ELabeledArg(_, _, v) => scps_collect_cps_effs_expr(v, out),
    EBreak(opt) => match opt {
      Some(x) => scps_collect_cps_effs_expr(x, out),
      None => ()
    },
    EContinue(args) => {
      let mut i = 0
      while i < Array::length(args) {
        scps_collect_cps_effs_expr(Array::get(args, i), out)
        i = i + 1
      }
    },
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        scps_collect_cps_effs_expr(Array::get(items, i), out)
        i = i + 1
      }
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        scps_collect_cps_effs_expr(Array::get(items, i), out)
        i = i + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        scps_collect_cps_effs_expr(v, out)
        i = i + 1
      }
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        scps_collect_cps_effs_expr(v, out)
        i = i + 1
      }
    },
    ESpread(x) => scps_collect_cps_effs_expr(x, out),
    _ => ()
  }
}

fn scps_stmt_expr_of(s: Stmt) -> Option[Expr] {
  match s {
    SLet(_, _, _, _, expr) => Some(expr),
    SLetMut(_, _, expr) => Some(expr),
    SExpr(expr) => Some(expr),
    STest(_, expr) => Some(expr),
    SBench(_, expr) => Some(expr),
    _ => None
  }
}

fn scps_collect_cps_effs(stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty_str()
  let mut i = 0
  while i < Array::length(stmts) {
    match scps_stmt_expr_of(Array::get(stmts, i)) {
      Some(expr) => scps_collect_cps_effs_expr(expr, out),
      None => ()
    }
    i = i + 1
  }
  out
}

// Does a literal BODY need eff -- a raw perform of a handled op or a call
// to a needing fn -- OUTSIDE any nested handle that itself discharges eff?
// (A literal whose performs are all under its own lexical `handle ... with
// eff` -- e.g. a TaskGroup::run body containing settle(handle {..}) -- is
// self-contained and must NOT be step-split.)

fn scps_lit_needs(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {
  let (eff, ops, _, _, _) = sctx
  if scps_as_target_perform(e, ops) >= 0 || scps_as_needing_call(e, sctx) != "" {
    true
  } else {
    match e {
      EHandle(b, arms) => {
        let mut discharges = false
        if Array::length(arms) > 0 {
          let (p0, _) = Array::get(arms, 0)
          match p0 {
            PCtor(q, _) => {
              let ci = String::index_of(q, "::")
              if ci > 0 && String::substring(q, 0, ci) == eff {
                discharges = true
              } else {
                ()
              }
            },
            _ => ()
          }
        } else {
          ()
        }
        if discharges {
          false
        } else {
          let mut hit = scps_lit_needs(b, sctx)
          let mut i = 0
          while i < Array::length(arms) {
            let (_, ex) = Array::get(arms, i)
            if scps_lit_needs(ex, sctx) {
              hit = true
            } else {
              ()
            }
            i = i + 1
          }
          hit
        }
      },
      ECall(callee, args, _) => scps_lit_needs(callee, sctx) || scps_exprs_lit_need(args, sctx),
      ELet(_, v, b, _) => scps_lit_needs(v, sctx) || scps_lit_needs(b, sctx),
      ELetMut(_, v, b, _) => scps_lit_needs(v, sctx) || scps_lit_needs(b, sctx),
      ELetRec(_, v, b) => scps_lit_needs(v, sctx) || scps_lit_needs(b, sctx),
      ESeq(a, b) => scps_lit_needs(a, sctx) || scps_lit_needs(b, sctx),
      EIf(c, t, el) => scps_lit_needs(c, sctx) || scps_lit_needs(t, sctx) || scps_lit_needs(el, sctx),
      EMatch(s, arms) => {
        let mut hit = scps_lit_needs(s, sctx)
        let mut i = 0
        while i < Array::length(arms) {
          let (_, ex) = Array::get(arms, i)
          if scps_lit_needs(ex, sctx) {
            hit = true
          } else {
            ()
          }
          i = i + 1
        }
        hit
      },
      EFn(_, _, _, _, _, b) => scps_lit_needs(b, sctx),
      EWhile(c, b) => scps_lit_needs(c, sctx) || scps_lit_needs(b, sctx),
      EForIn(_, _, it, b) => scps_lit_needs(it, sctx) || scps_lit_needs(b, sctx),
      ELoop(pairs, b) => {
        let mut hit = scps_lit_needs(b, sctx)
        let mut i = 0
        while i < Array::length(pairs) {
          let (_, v) = Array::get(pairs, i)
          if scps_lit_needs(v, sctx) {
            hit = true
          } else {
            ()
          }
          i = i + 1
        }
        hit
      },
      EBinOp(_, l, r) => scps_lit_needs(l, sctx) || scps_lit_needs(r, sctx),
      EUnaryOp(_, x) => scps_lit_needs(x, sctx),
      EAssign(_, v, c) => scps_lit_needs(v, sctx) || scps_lit_needs(c, sctx),
      EAssignOp(_, _, v, c) => scps_lit_needs(v, sctx) || scps_lit_needs(c, sctx),
      EReturn(x) => scps_lit_needs(x, sctx),
      EDot(o, _, _, _) => scps_lit_needs(o, sctx),
      ELabeledArg(_, _, v) => scps_lit_needs(v, sctx),
      EBreak(opt) => match opt {
        Some(x) => scps_lit_needs(x, sctx),
        None => false
      },
      EContinue(args) => scps_exprs_lit_need(args, sctx),
      ETuple(items) => scps_exprs_lit_need(items, sctx),
      EArray(items) => scps_exprs_lit_need(items, sctx),
      ERecord(_, fields, _) => scps_fields_lit_need(fields, sctx),
      EMap(fields) => scps_fields_lit_need(fields, sctx),
      ESpread(x) => scps_lit_needs(x, sctx),
      _ => false
    }
  }
}

fn scps_exprs_lit_need(es: Array[Expr], sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(es) {
    if scps_lit_needs(Array::get(es, i), sctx) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_fields_lit_need(fields: Array[(String, Expr)], sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    if scps_lit_needs(v, sctx) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

// Phase 2 (prepass): step-split every EFn literal that needs a CPS-mode
// effect, and at call sites of known top-level fns rewrite arguments in
// E-row param positions (a pure literal gets Done-wrapped so it matches
// the step convention its consumer expects; a bare needing-fn reference
// becomes its CPS clone). Runs over ALL statements -- a spawn call site
// in user code carries no handle of its own.

fn scps_ecfg_for(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), eff: String) -> (String, Array[String], Array[String]) {
  let (_, decl_ops) = scps_effect_decl_ops(ctx, eff)
  let ops_qnames = array_empty_str()
  let mut oi = 0
  while oi < Array::length(decl_ops) {
    let (opname, _) = Array::get(decl_ops, oi)
    Array::push(ops_qnames, String::concat(String::concat(eff, "::"), opname))
    oi = oi + 1
  }
  (eff, ops_qnames, scps_needing_for(ctx, eff))
}

fn scps_fn_def_params(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), name: String) -> Option[Array[(String, Option[TypeExpr])]] {
  let (stmts, _, fn_defs, _, _, _) = ctx
  let mut def_idx = -1
  let mut fi = 0
  while fi < Array::length(fn_defs) {
    let (idx, _, _, fnm, _, _) = Array::get(fn_defs, fi)
    if fnm == name {
      def_idx = idx
    } else {
      ()
    }
    fi = fi + 1
  }
  if def_idx < 0 {
    None
  } else {
    match Array::get(stmts, def_idx) {
      SLet(_, _, _, _, EFn(_, _, params, _, _, _)) => Some(params),
      _ => None
    }
  }
}

/// Step-split one literal for `eff`. Pushes errors on ineligibility;
/// returns the literal unchanged in that case (the error is fatal anyway).
fn scps_split_literal(tps: Array[String], tbs: Array[(String, Array[String])], params: Array[(String, Option[TypeExpr])], b: Expr, ecfg: (String, Array[String], Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Expr {
  let (eff, ops_qnames, needing) = ecfg
  let errs = scps_st_errs(st)
  let site = scps_next_site(st)
  let cps_seed = array_empty_str()
  let mut cpi = 0
  while cpi < Array::length(params) {
    let (pnm, pty) = Array::get(params, cpi)
    let prow = scps_ty_row(pty)
    if prow != "" && scps_row_contains(ctx, prow, eff) {
      Array::push(cps_seed, pnm)
    } else {
      ()
    }
    cpi = cpi + 1
  }
  let sctx = (eff, ops_qnames, needing, site, cps_seed)
  if !scps_calls_ok(b, sctx, ctx) {
    // #1536 / #1514 parity: name the offending call in the literal's body.
    let (culprit_clause, culprit_marker) = scps_culprit_parts(b, sctx, ctx)
    let mut scps_msg = String::concat(String::concat("a closure literal whose row carries ", eff), " (suspend class, ADR-0076 追記31 Vertical B) calls something the suspend lowering cannot see through (a local closure, a method-style callee, a nested handle, or a row-variable callee)")
    scps_msg = String::concat(scps_msg, culprit_clause)
    scps_msg = String::concat(scps_msg, " (#817)")
    scps_msg = String::concat(scps_msg, culprit_marker)
    Array::push(errs, scps_msg)
    EFn(tps, tbs, params, None, None, b)
  } else {
    let (split_ok, split_body) = scps_split_tail(b, sctx, ctx, st)
    if !split_ok {
      Array::push(errs, String::concat(String::concat("a closure literal whose row carries ", eff), " (suspend class, ADR-0076 追記31 Vertical B) performs it (or calls a function that performs it) off the let/seq/tail/branch-tail spine (a loop body containing `return`, a `for` form, nested closures/handles, and nested expression positions are not eligible; a `while` / `loop` spine is, including one carrying `break` / `continue`, #1230/#1536) (#817)"))
      EFn(tps, tbs, params, None, None, b)
    } else {
      scps_ensure_effect_runtime(eff, ctx, st)
      EFn(tps, tbs, params, None, None, split_body)
    }
  }
}

fn scps_prepass_expr(e: Expr, ecfgs: Array[(String, Array[String], Array[String])], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), split_effs: Array[String]) -> Expr {
  match e {
    EFn(tps, tbs, params, ret, eff, b) => {
      let b2 = scps_prepass_expr(b, ecfgs, ctx, st, split_effs)
      let mut hit_eff = ""
      let mut multi = false
      let mut ei = 0
      while ei < Array::length(ecfgs) {
        let (ceff, cops, cneeding) = Array::get(ecfgs, ei)
        let probe = (ceff, cops, cneeding, 0, array_empty_str())
        if scps_lit_needs(b2, probe) {
          if hit_eff == "" {
            hit_eff = ceff
          } else {
            multi = true
          }
        } else {
          ()
        }
        ei = ei + 1
      }
      if multi {
        Array::push(scps_st_errs(st), "a closure literal raw-performs more than one suspend-class effect -- not supported (split the effect or handle one of them inside the literal) (ADR-0076 追記31 Vertical B)")
        EFn(tps, tbs, params, ret, eff, b2)
      } else if hit_eff != "" {
        let mut cfg = ("", array_empty_str(), array_empty_str())
        let mut ci = 0
        while ci < Array::length(ecfgs) {
          let (ceff, _, _) = Array::get(ecfgs, ci)
          if ceff == hit_eff {
            cfg = Array::get(ecfgs, ci)
          } else {
            ()
          }
          ci = ci + 1
        }
        if edp_str_array_contains(split_effs, hit_eff) {
          ()
        } else {
          Array::push(split_effs, hit_eff)
        }
        scps_split_literal(tps, tbs, params, b2, cfg, ctx, st)
      } else {
        EFn(tps, tbs, params, ret, eff, b2)
      }
    },
    ECall(callee, args, off) => {
      let rcallee = scps_prepass_expr(callee, ecfgs, ctx, st, split_effs)
      let rargs = for a in args {
        scps_prepass_expr(a, ecfgs, ctx, st, split_effs)
      }
      // arg-position convention fixups against the callee's declared params
      match rcallee {
        EIdent(fname, _) => match scps_fn_def_params(ctx, fname) {
          Some(fparams) => {
            let mut aj = 0
            while aj < Array::length(rargs) {
              if aj < Array::length(fparams) {
                let (_, pty) = Array::get(fparams, aj)
                let prow = scps_ty_row(pty)
                if prow != "" {
                  let mut ei2 = 0
                  while ei2 < Array::length(ecfgs) {
                    let (ceff, _, cneeding) = Array::get(ecfgs, ei2)
                    if scps_row_contains(ctx, prow, ceff) {
                      match Array::get(rargs, aj) {
                        EFn(atps, atbs, aparams, aret, aeff, ab) => if scps_literal_is_step_for(Array::get(rargs, aj), ceff) {
                          ()
                        } else {
                          // pure literal in an E-row position: Done-wrap so
                          // it matches the step convention.
                          let mut cfg2 = ("", array_empty_str(), array_empty_str())
                          let mut ci2 = 0
                          while ci2 < Array::length(ecfgs) {
                            let (ceff2, _, _) = Array::get(ecfgs, ci2)
                            if ceff2 == ceff {
                              cfg2 = Array::get(ecfgs, ci2)
                            } else {
                              ()
                            }
                            ci2 = ci2 + 1
                          }
                          if edp_str_array_contains(split_effs, ceff) {
                            ()
                          } else {
                            Array::push(split_effs, ceff)
                          }
                          Array::set(rargs, aj, scps_split_literal(atps, atbs, aparams, ab, cfg2, ctx, st))
                        },
                        EIdent(anm, aoff) => if edp_str_array_contains(cneeding, anm) {
                          scps_need_clone(ceff, anm, st)
                          if edp_str_array_contains(split_effs, ceff) {
                            ()
                          } else {
                            Array::push(split_effs, ceff)
                          }
                          Array::set(rargs, aj, EIdent(scps_clone_name(ceff, anm), aoff))
                        } else {
                          ()
                        },
                        _ => ()
                      }
                    } else {
                      ()
                    }
                    ei2 = ei2 + 1
                  }
                } else {
                  ()
                }
              } else {
                ()
              }
              aj = aj + 1
            }
          },
          None => ()
        },
        _ => ()
      }
      ECall(rcallee, rargs, off)
    },
    EHandle(b, arms) => EHandle(scps_prepass_expr(b, ecfgs, ctx, st, split_effs), for a in arms {
      let (p, ex) = a
      (p, scps_prepass_expr(ex, ecfgs, ctx, st, split_effs))
    }),
    ELet(n, v, b, off) => ELet(n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs), scps_prepass_expr(b, ecfgs, ctx, st, split_effs), off),
    ELetMut(n, v, b, off) => ELetMut(n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs), scps_prepass_expr(b, ecfgs, ctx, st, split_effs), off),
    ELetRec(n, v, b) => ELetRec(n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs), scps_prepass_expr(b, ecfgs, ctx, st, split_effs)),
    ESeq(a, b) => ESeq(scps_prepass_expr(a, ecfgs, ctx, st, split_effs), scps_prepass_expr(b, ecfgs, ctx, st, split_effs)),
    EIf(c, t, el) => EIf(scps_prepass_expr(c, ecfgs, ctx, st, split_effs), scps_prepass_expr(t, ecfgs, ctx, st, split_effs), scps_prepass_expr(el, ecfgs, ctx, st, split_effs)),
    EMatch(s, arms) => EMatch(scps_prepass_expr(s, ecfgs, ctx, st, split_effs), for a in arms {
      let (p, ex) = a
      (p, scps_prepass_expr(ex, ecfgs, ctx, st, split_effs))
    }),
    EWhile(c, b) => EWhile(scps_prepass_expr(c, ecfgs, ctx, st, split_effs), scps_prepass_expr(b, ecfgs, ctx, st, split_effs)),
    EForIn(n, idx, it, b) => EForIn(n, idx, scps_prepass_expr(it, ecfgs, ctx, st, split_effs), scps_prepass_expr(b, ecfgs, ctx, st, split_effs)),
    EBinOp(op, l, r) => EBinOp(op, scps_prepass_expr(l, ecfgs, ctx, st, split_effs), scps_prepass_expr(r, ecfgs, ctx, st, split_effs)),
    EUnaryOp(op, x) => EUnaryOp(op, scps_prepass_expr(x, ecfgs, ctx, st, split_effs)),
    EAssign(n, v, c) => EAssign(n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs), scps_prepass_expr(c, ecfgs, ctx, st, split_effs)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, scps_prepass_expr(v, ecfgs, ctx, st, split_effs), scps_prepass_expr(c, ecfgs, ctx, st, split_effs)),
    EDot(o, f, off1, off2) => EDot(scps_prepass_expr(o, ecfgs, ctx, st, split_effs), f, off1, off2),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs)),
    EReturn(x) => EReturn(scps_prepass_expr(x, ecfgs, ctx, st, split_effs)),
    EBreak(opt) => EBreak(match opt {
      Some(x) => Some(scps_prepass_expr(x, ecfgs, ctx, st, split_effs)),
      None => None
    }),
    EContinue(args) => EContinue(for a in args {
      scps_prepass_expr(a, ecfgs, ctx, st, split_effs)
    }),
    ETuple(items) => ETuple(for a in items {
      scps_prepass_expr(a, ecfgs, ctx, st, split_effs)
    }),
    EArray(items) => EArray(for a in items {
      scps_prepass_expr(a, ecfgs, ctx, st, split_effs)
    }),
    ERecord(n, fields, tas) => ERecord(n, for f in fields {
      let (fn2, v) = f
      (fn2, scps_prepass_expr(v, ecfgs, ctx, st, split_effs))
    }, tas),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, scps_prepass_expr(v, ecfgs, ctx, st, split_effs))
    }),
    ESpread(x) => ESpread(scps_prepass_expr(x, ecfgs, ctx, st, split_effs)),
    ELoop(pairs, b) => ELoop(for p in pairs {
      let (n, v) = p
      (n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs))
    }, scps_prepass_expr(b, ecfgs, ctx, st, split_effs)),
    _ => e
  }
}

// Phase 5 (guard): once ANY literal/arg was step-compiled for an effect,
// the step convention is global for that effect's closure values -- an
// UNTRIGGERED handle for it left in the program (evidence/Phase 2/replay
// bound) would call them under the value convention. v1: hard error.

fn scps_guard_untriggered(e: Expr, guard_effs: Array[String], errs: Array[String]) -> Unit {
  match e {
    EHandle(b, arms) => {
      scps_guard_untriggered(b, guard_effs, errs)
      if Array::length(arms) > 0 {
        let (p0, _) = Array::get(arms, 0)
        match p0 {
          PCtor(q, _) => {
            let ci = String::index_of(q, "::")
            if ci > 0 && edp_str_array_contains(guard_effs, String::substring(q, 0, ci)) {
              Array::push(errs, String::concat(String::concat("effect ", String::substring(q, 0, ci)), " has step-compiled closure values (a literal or argument was CPS-lowered for it), but this handle for it does not capture `resume` as a value -- mixing the step convention with tail-resumptive/replay handling of the same effect is not supported; split the effect or make every handler suspend-class (ADR-0076 追記31 Vertical B)"))
            } else {
              ()
            }
          },
          _ => ()
        }
      } else {
        ()
      }
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, i)
        scps_guard_untriggered(ex, guard_effs, errs)
        i = i + 1
      }
    },
    EFn(_, _, _, _, _, b) => scps_guard_untriggered(b, guard_effs, errs),
    ELet(_, v, b, _) => {
      scps_guard_untriggered(v, guard_effs, errs)
      scps_guard_untriggered(b, guard_effs, errs)
    },
    ELetMut(_, v, b, _) => {
      scps_guard_untriggered(v, guard_effs, errs)
      scps_guard_untriggered(b, guard_effs, errs)
    },
    ELetRec(_, v, b) => {
      scps_guard_untriggered(v, guard_effs, errs)
      scps_guard_untriggered(b, guard_effs, errs)
    },
    ESeq(a, b) => {
      scps_guard_untriggered(a, guard_effs, errs)
      scps_guard_untriggered(b, guard_effs, errs)
    },
    EIf(c, t, el) => {
      scps_guard_untriggered(c, guard_effs, errs)
      scps_guard_untriggered(t, guard_effs, errs)
      scps_guard_untriggered(el, guard_effs, errs)
    },
    EMatch(s, arms) => {
      scps_guard_untriggered(s, guard_effs, errs)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, i)
        scps_guard_untriggered(ex, guard_effs, errs)
        i = i + 1
      }
    },
    ECall(callee, args, _) => {
      scps_guard_untriggered(callee, guard_effs, errs)
      let mut i = 0
      while i < Array::length(args) {
        scps_guard_untriggered(Array::get(args, i), guard_effs, errs)
        i = i + 1
      }
    },
    EWhile(c, b) => {
      scps_guard_untriggered(c, guard_effs, errs)
      scps_guard_untriggered(b, guard_effs, errs)
    },
    EForIn(_, _, it, b) => {
      scps_guard_untriggered(it, guard_effs, errs)
      scps_guard_untriggered(b, guard_effs, errs)
    },
    ELoop(pairs, b) => {
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, v) = Array::get(pairs, i)
        scps_guard_untriggered(v, guard_effs, errs)
        i = i + 1
      }
      scps_guard_untriggered(b, guard_effs, errs)
    },
    EBinOp(_, l, r) => {
      scps_guard_untriggered(l, guard_effs, errs)
      scps_guard_untriggered(r, guard_effs, errs)
    },
    EUnaryOp(_, x) => scps_guard_untriggered(x, guard_effs, errs),
    EAssign(_, v, c) => {
      scps_guard_untriggered(v, guard_effs, errs)
      scps_guard_untriggered(c, guard_effs, errs)
    },
    EAssignOp(_, _, v, c) => {
      scps_guard_untriggered(v, guard_effs, errs)
      scps_guard_untriggered(c, guard_effs, errs)
    },
    EReturn(x) => scps_guard_untriggered(x, guard_effs, errs),
    EDot(o, _, _, _) => scps_guard_untriggered(o, guard_effs, errs),
    ELabeledArg(_, _, v) => scps_guard_untriggered(v, guard_effs, errs),
    EBreak(opt) => match opt {
      Some(x) => scps_guard_untriggered(x, guard_effs, errs),
      None => ()
    },
    EContinue(args) => {
      let mut i = 0
      while i < Array::length(args) {
        scps_guard_untriggered(Array::get(args, i), guard_effs, errs)
        i = i + 1
      }
    },
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        scps_guard_untriggered(Array::get(items, i), guard_effs, errs)
        i = i + 1
      }
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        scps_guard_untriggered(Array::get(items, i), guard_effs, errs)
        i = i + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        scps_guard_untriggered(v, guard_effs, errs)
        i = i + 1
      }
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        scps_guard_untriggered(v, guard_effs, errs)
        i = i + 1
      }
    },
    ESpread(x) => scps_guard_untriggered(x, guard_effs, errs),
    _ => ()
  }
}

/// --- allocation-free trigger pre-scan (#1102 perf). scps_rewrite
/// reconstructs every node it walks, so running it unconditionally deep-
/// copied the ENTIRE program's top-level bodies on every compile — for a
/// program with no suspend-class handles at all (the compiler itself:
/// ~4k handles, every one a plain `with Exception`) that was pure allocation
/// churn, a measurable slice of the selfcompile heap KPI. This walk
/// allocates nothing and answers "does this expression contain ANY handle
/// arm that value-references `resume`?"; the pass skips fact-table
/// construction entirely when no statement triggers, and leaves
/// non-triggering statements' trees fully shared (unreconstructed).
fn scps_expr_has_trigger(e: Expr) -> Bool {
  match e {
    EHandle(b, arms) => {
      let mut hit = scps_expr_has_trigger(b)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        if scps_arm_refs_resume_value(ex, scps_pat_binds_resume(p)) || scps_expr_has_trigger(ex) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EFn(_, _, _, _, _, b) => scps_expr_has_trigger(b),
    ELet(_, v, b, _) => scps_expr_has_trigger(v) || scps_expr_has_trigger(b),
    ELetMut(_, v, b, _) => scps_expr_has_trigger(v) || scps_expr_has_trigger(b),
    ELetRec(_, v, b) => scps_expr_has_trigger(v) || scps_expr_has_trigger(b),
    ESeq(a, b) => scps_expr_has_trigger(a) || scps_expr_has_trigger(b),
    EIf(c, t, el) => scps_expr_has_trigger(c) || scps_expr_has_trigger(t) || scps_expr_has_trigger(el),
    EMatch(s, arms) => {
      let mut hit = scps_expr_has_trigger(s)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, i)
        if scps_expr_has_trigger(ex) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EWhile(c, b) => scps_expr_has_trigger(c) || scps_expr_has_trigger(b),
    EForIn(_, _, it, b) => scps_expr_has_trigger(it) || scps_expr_has_trigger(b),
    ELoop(pairs, b) => {
      let mut hit = scps_expr_has_trigger(b)
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, v) = Array::get(pairs, i)
        if scps_expr_has_trigger(v) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    ECall(callee, args, _) => {
      let mut hit = scps_expr_has_trigger(callee)
      let mut i = 0
      while i < Array::length(args) {
        if scps_expr_has_trigger(Array::get(args, i)) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EBinOp(_, l, r) => scps_expr_has_trigger(l) || scps_expr_has_trigger(r),
    EUnaryOp(_, x) => scps_expr_has_trigger(x),
    EAssign(_, v, b) => scps_expr_has_trigger(v) || scps_expr_has_trigger(b),
    EAssignOp(_, _, v, b) => scps_expr_has_trigger(v) || scps_expr_has_trigger(b),
    EReturn(x) => scps_expr_has_trigger(x),
    EDot(o, _, _, _) => scps_expr_has_trigger(o),
    ELabeledArg(_, _, v) => scps_expr_has_trigger(v),
    EBreak(opt) => match opt {
      Some(x) => scps_expr_has_trigger(x),
      None => false
    },
    EContinue(args) => {
      let mut hit = false
      let mut i = 0
      while i < Array::length(args) {
        if scps_expr_has_trigger(Array::get(args, i)) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    ETuple(items) => {
      let mut hit = false
      let mut i = 0
      while i < Array::length(items) {
        if scps_expr_has_trigger(Array::get(items, i)) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EArray(items) => {
      let mut hit = false
      let mut i = 0
      while i < Array::length(items) {
        if scps_expr_has_trigger(Array::get(items, i)) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    ERecord(_, fields, _) => {
      let mut hit = false
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        if scps_expr_has_trigger(v) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EMap(fields) => {
      let mut hit = false
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        if scps_expr_has_trigger(v) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    ESpread(x) => scps_expr_has_trigger(x),
    _ => false
  }
}

fn scps_stmt_has_trigger(s: Stmt) -> Bool {
  match s {
    SLet(_, _, _, _, expr) => scps_expr_has_trigger(expr),
    SLetMut(_, _, expr) => scps_expr_has_trigger(expr),
    SExpr(expr) => scps_expr_has_trigger(expr),
    STest(_, expr) => scps_expr_has_trigger(expr),
    SBench(_, expr) => scps_expr_has_trigger(expr),
    _ => false
  }
}

//# await の poll-wait 展開 (#1230, ADR-0068 / docs/spec/wasi-p3-async.md M1b-3c)

/// #1230: expand `await(f)` into the suspend-and-retry loop that a PENDING
/// future needs, before any of the effect passes run.
///
/// `Future[T]` is the two-element `[state, payload]` array
/// (compile_call.vibe's `future_ready_expr`); state 0 is ready. `await` used
/// to be lowered in compile_call, which emits wasm directly -- far too late
/// for the `perform Async::Suspend(..)` a pending future has to raise, since
/// suspend_cps_pass and evidence_dict_pass have both already run by then.
/// Doing it here, right after desugar_trait_dicts (which is what produces the
/// `await(..)` calls of an async-iterator `for` loop) and before rewrite_self_tail_calls,
/// puts the perform on the ordinary AST where those passes see it like any
/// hand-written one.
///
/// The shape is the one `@vibex/concurrent`'s own blocking helpers use
/// (`Receiver::recv_wait`: re-check, `perform Async::Suspend(1)`, re-check):
///
/// ```text
/// let __aw_f_N = <future>
/// while 0 < Array::get(__aw_f_N, 0) {
///   let __aw_w_N = perform Async::Suspend(1)
///   ()
/// }
/// Array::get(__aw_f_N, 1)
/// ```
///
/// 1 is the poll-wait reason (concurrent.vibe's payload convention: 0 =
/// cooperative yield, 1 = poll wait, negative = sleep debt), so a driver that
/// parks the continuation re-runs it and the loop re-reads the state slot --
/// the producer resolves a future by writing slot 1 and clearing slot 0.
///
/// Every future in the tree today is created ready, so the loop is not entered
/// at runtime; what this buys is that `await` is now CORRECT for a pending
/// future, leaving "add a producer" as the only remaining step rather than
/// "add a producer AND rework await under the effect passes".
///
/// `await(Future::ready(x))` collapses to `x` outright: the ready-future fast
/// path the spec calls for, and it keeps the common case free of both the
/// array and the loop.
export fn await_poll_pass(stmts: Array[Stmt], host_future: Bool, waiter_hooks: Bool) -> Unit {
  // A user-defined top-level `await` shadows the builtin; leave those calls
  // alone (compile_call applies the same rule via `prefer_bound_call`).
  //
  // `host_future` (ADR-0089 step 4, #1218): the caller's "program calls
  // host_future_get" key -- selects the waitable-aware __aw_poll form (see
  // awp_poll_fn_def). Passed in rather than scanned here so the deep
  // call-scan lives once, next to the boundary machinery's other keys
  // (linked_compile's lc_expr_calls_host_future).
  //
  // `waiter_hooks` (ADR-0089 #1218, resolve -> direct wake): the program
  // can call `__aw_wait` / `__aw_notify_resolve` (@vibex/concurrent's
  // direct-wake hooks -- linked imports or local defs). __aw_poll then
  // routes each poll round through `__aw_wait` (register as waiter +
  // suspend) instead of a bare perform, and compile_call appends the
  // notify to every Future::resolve lowering, so in-task awaiters of a
  // pending future are woken by the resolve instead of re-polled every
  // pump round. host_future takes precedence: the waitable form needs its
  // own payload protocol, and host-future programs are entry-boundary
  // driven (no in-guest scheduler to direct-wake).
  if awp_program_defines_await(stmts) {
    ()
  } else {
    let ctr = [
      0
    ]
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SLet(ex, isrec, nm, ty, expr) => {
          Array::set(stmts, i, SLet(ex, isrec, nm, ty, awp_tail(expr, ctr)))
        },
        SLetMut(nm, ty, expr) => {
          Array::set(stmts, i, SLetMut(nm, ty, awp_tail(expr, ctr)))
        },
        SExpr(expr) => {
          Array::set(stmts, i, SExpr(awp_tail(expr, ctr)))
        },
        STest(nm, expr) => {
          Array::set(stmts, i, STest(nm, awp_tail(expr, ctr)))
        },
        SBench(nm, expr) => {
          Array::set(stmts, i, SBench(nm, awp_tail(expr, ctr)))
        },
        _ => ()
      }
      i = i + 1
    }
    // ADR-0089 D1 increment 4 (#1218): the poll loop lives in a synthesized
    // NAMED top-level fn, injected once per program iff some await actually
    // expanded (ctr counts expansions; the ready-future fast path leaves it
    // untouched). See awp_wrap for why the call-shape matters.
    if Array::get(ctr, 0) > 0 {
      Array::push(stmts, awp_poll_fn_def(host_future, waiter_hooks))
      if host_future {
        Array::push(stmts, awp_pay_fn_def())
        Array::push(stmts, awp_settle_fn_def())
      } else {
        ()
      }
    } else {
      ()
    }
  }
}

/// The synthesized `__aw_poll(fut) -> Int with Async` definition:
///
/// ```text
/// while 0 < Array::get(fut, 0) {
///   let __aw_w = perform Async::Suspend(1)
///   ()
/// }
/// Array::get(fut, 1)
/// ```
///
/// ADR-0089 step 4 (#1218): when the program calls `host_future_get`
/// (`host_future` true), the loop instead computes the suspend payload per
/// iteration and settles the cell from the resume value:
///
/// ```text
/// while 0 < Array::get(fut, 0) {
///   let __aw_p = __aw_pay(fut)                  // 1, or handle + 2 (waitable)
///   let __aw_w = perform Async::Suspend(__aw_p)
///   let __aw_s = __aw_settle(fut, __aw_w)       // waitable: cell <- resumed value
///   ()
/// }
/// Array::get(fut, 1)
/// ```
///
/// The helpers are synthesized row-free top-level fns (awp_pay_fn_def /
/// awp_settle_fn_def) so the loop spine stays a let-chain of
/// effect-free-fn calls around the perform -- the shape the suspend CPS
/// split accepts. The non-host-future form is kept byte-identical for
/// every program that never touches `host_future_get`.
///
/// `waiter_hooks` (resolve -> direct wake, ADR-0089 #1218): route the
/// round through the library's `__aw_wait(fut)` -- an IMPORTED (or local)
/// concrete-Async-row named fn, the same callee shape as recv_wait, so
/// both the suspend CPS split and the evidence migration accept it
/// (measured via a hand-written mimic before wiring):
///
/// ```text
/// while 0 < Array::get(fut, 0) {
///   let __aw_w = __aw_wait(fut)     // register as waiter + Suspend(1)
///   ()
/// }
/// Array::get(fut, 1)
/// ```
fn awp_poll_fn_def(host_future: Bool, waiter_hooks: Bool) -> Stmt {
  let fut = EIdent("__aw_fut", -1)
  let state = ECall(EIdent("Array::get", -1), [
    fut,
    EInt(0)
  ], -1)
  // EBinOp("<"), NOT the `lt` builtin the old inline expansion used: the
  // evidence migration's see-through scan does not know `lt` as a pure
  // callee, so a `while lt(...)` condition makes this fn -- and therefore
  // every handle whose body awaits -- ineligible (measured: reduced case
  // v9 REJECTED with `lt`, identical fn with `<` compiles and runs).
  let pending = EBinOp("<", EInt(0), state)
  let payload = ECall(EIdent("Array::get", -1), [
    fut,
    EInt(1)
  ], -1)
  let loop_body = if host_future {
    let suspend = ECall(EIdent("perform", -1), [
      ECall(EIdent("Async::Suspend", -1), [
        EIdent("__aw_p", -1)
      ], -1)
    ], -1)
    let pay = ECall(EIdent("__aw_pay", -1), [
      fut
    ], -1)
    let settle = ECall(EIdent("__aw_settle", -1), [
      fut,
      EIdent("__aw_w", -1)
    ], -1)
    ELet("__aw_p", pay, ELet("__aw_w", suspend, ELet("__aw_s", settle, EUnit, -1), -1), -1)
  } else if waiter_hooks {
    let wait_call = ECall(EIdent("__aw_wait", -1), [
      fut
    ], -1)
    ELet("__aw_w", wait_call, EUnit, -1)
  } else {
    let suspend = ECall(EIdent("perform", -1), [
      ECall(EIdent("Async::Suspend", -1), [
        EInt(1)
      ], -1)
    ], -1)
    ELet("__aw_w", suspend, EUnit, -1)
  }
  let body = ESeq(EWhile(pending, loop_body), payload)
  let params: Array[(String, Option[TypeExpr])] = [
    ("__aw_fut", None)
  ]
  SLet(false, false, "__aw_poll", None, EFn(array_empty_str(), array_empty(), params, None, Some("Async"), body))
}

/// `__aw_pay(f) -> Int`: the suspend payload for one poll round. A waitable
/// cell (state 2, ADR-0089 step 4) parks with `handle + 2` -- the reserved
/// waitable band (0 = yield, 1 = poll wait, negative = sleep debt; the +2
/// keeps even handle 0/1 out of the low reasons). Anything else is the
/// plain poll-wait retry.
fn awp_pay_fn_def() -> Stmt {
  let f = EIdent("__awp_f", -1)
  let state = ECall(EIdent("Array::get", -1), [
    f,
    EInt(0)
  ], -1)
  // `hnd`, not `handle` -- `handle` is the effect-handler keyword.
  let hnd = ECall(EIdent("Array::get", -1), [
    f,
    EInt(1)
  ], -1)
  let body = EIf(EBinOp("==", state, EInt(2)), EBinOp("+", hnd, EInt(2)), EInt(1))
  let params: Array[(String, Option[TypeExpr])] = [
    ("__awp_f", None)
  ]
  SLet(false, false, "__aw_pay", None, EFn(array_empty_str(), array_empty(), params, None, None, body))
}

/// `__aw_settle(f, v) -> Int`: after a waitable park resumes, `v` is the
/// value the boundary read from the host future -- write it into the cell
/// (payload first, then state, the Future::resolve ordering) so the poll
/// loop observes readiness. Poll-wait rounds (state != 2) ignore `v`.
fn awp_settle_fn_def() -> Stmt {
  let f = EIdent("__aws_f", -1)
  let state = ECall(EIdent("Array::get", -1), [
    f,
    EInt(0)
  ], -1)
  let set_payload = ECall(EIdent("Array::set", -1), [
    f,
    EInt(1),
    EIdent("__aws_v", -1)
  ], -1)
  let set_state = ECall(EIdent("Array::set", -1), [
    f,
    EInt(0),
    EInt(0)
  ], -1)
  let body = EIf(EBinOp("==", state, EInt(2)), ESeq(set_payload, ESeq(set_state, EInt(0))), EInt(0))
  let params: Array[(String, Option[TypeExpr])] = [
    ("__aws_f", None),
    ("__aws_v", None)
  ]
  SLet(false, false, "__aw_settle", None, EFn(array_empty_str(), array_empty(), params, None, None, body))
}

fn awp_program_defines_await(stmts: Array[Stmt]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, nm, _, _) => if nm == "await" {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// #1230: pull every unconditionally-evaluated `await` out of `e` into
/// `binds`, replacing each with a fresh identifier.
///
/// The expansion must NOT be spliced in where the await stood. It is a
/// `let`/`while`/read sequence, and vibe has no block expression, so
/// `let a = await(..)` would produce `ELet(a, ELet(f, .., ESeq(EWhile(..),
/// ..)), ..)` -- a shape no source program can write and, with two of them in
/// one function, one the downstream passes do not converge on (the compiler
/// itself recursed without bound). Hoisting instead keeps every synthesized
/// node on the ordinary let/seq spine, which is exactly the discipline
/// scps_split_tail already follows for the same reason.
///
/// Only positions that are evaluated unconditionally and in order are lifted.
/// A branch, a loop body, a closure body, or a nested spine is left to its
/// OWN spine rewrite (awp_rewrite), so an await under a condition never
/// escapes ahead of it.
fn awp_lift(e: Expr, ctr: Array[Int], binds: Array[(String, Expr, String)]) -> Expr {
  match e {
    ECall(callee, args, off) => {
      let callee_nm = match callee {
        EIdent(cn, _) => cn,
        _ => ""
      }
      if callee_nm == "await" && Array::length(args) == 1 {
        let inner = awp_lift(Array::get(args, 0), ctr, binds)
        match awp_ready_payload(inner) {
          Some(payload) => payload,
          None => {
            let n = Array::get(ctr, 0)
            Array::set(ctr, 0, n + 1)
            let fname = String::concat("__aw_f_", Int::to_string(n))
            let vname = String::concat("__aw_v_", Int::to_string(n))
            Array::push(binds, (fname, inner, vname))
            EIdent(vname, -1)
          }
        }
      } else {
        let new_callee = if callee_nm == "" {
          awp_lift(callee, ctr, binds)
        } else {
          callee
        }
        ECall(new_callee, awp_lift_exprs(args, ctr, binds), off)
      }
    },
    EBinOp(op, l, r) => EBinOp(op, awp_lift(l, ctr, binds), awp_lift(r, ctr, binds)),
    EUnaryOp(op, x) => EUnaryOp(op, awp_lift(x, ctr, binds)),
    EDot(o, f, o1, o2) => EDot(awp_lift(o, ctr, binds), f, o1, o2),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, awp_lift(v, ctr, binds)),
    ETuple(items) => ETuple(awp_lift_exprs(items, ctr, binds)),
    EArray(items) => EArray(awp_lift_exprs(items, ctr, binds)),
    ESpread(x) => ESpread(awp_lift(x, ctr, binds)),
    ERecord(n, fields, tas) => ERecord(n, awp_lift_pairs(fields, ctr, binds), tas),
    EMap(fields) => EMap(awp_lift_pairs(fields, ctr, binds)),
    // Everything else is either conditional, a loop, a closure, or a spine of
    // its own: hand it to awp_rewrite so its awaits are hoisted THERE.
    _ => awp_rewrite(e, ctr)
  }
}

fn awp_lift_exprs(es: Array[Expr], ctr: Array[Int], binds: Array[(String, Expr, String)]) -> Array[Expr] {
  for x in es {
    awp_lift(x, ctr, binds)
  }
}

fn awp_lift_pairs(pairs: Array[(String, Expr)], ctr: Array[Int], binds: Array[(String, Expr, String)]) -> Array[(String, Expr)] {
  for p in pairs {
    let (n, v) = p
    (n, awp_lift(v, ctr, binds))
  }
}

/// Wrap `inner` in one suspend-and-retry block per lifted await, innermost
/// last so the bindings evaluate in source order:
///
/// ```text
/// let __aw_f_N = <future>
/// while 0 < Array::get(__aw_f_N, 0) {
///   let __aw_w_N = perform Async::Suspend(1)
///   ()
/// }
/// let __aw_v_N = Array::get(__aw_f_N, 1)
/// <inner>
/// ```
fn awp_wrap(binds: Array[(String, Expr, String)], inner: Expr) -> Expr {
  // ADR-0089 D1 increment 4 (#1218): the poll loop is a CALL to the
  // synthesized named `__aw_poll` (see awp_poll_fn_def), not an inline
  // `while`. The shapes are semantically identical, but only the call is
  // visible to the TAIL-RESUMPTIVE evidence migration -- a
  // `handle ... with Async` body may contain "direct performs, calls to
  // named top-level functions, or row-annotated closure literals", and an
  // inline loop-wrapped perform is none of those (measured: the
  // await-discharge fixture was rejected with "not eligible for
  // evidence-passing migration" until this changed). This is the same
  // asymmetry increment 1 solved for `sleep` by injecting `__slp_perform`;
  // the suspend-class path is indifferent (a needing-fn call on the spine
  // vs an inline loop both split), so the named form serves both.
  let mut out = inner
  let mut i = Array::length(binds) - 1
  while i >= 0 {
    let (fname, fut, vname) = Array::get(binds, i)
    let poll = ECall(EIdent("__aw_poll", -1), [
      EIdent(fname, -1)
    ], -1)
    out = ELet(fname, fut, ELet(vname, poll, out, -1), -1)
    i = i - 1
  }
  out
}

/// Rewrite an expression in a SPINE position, hoisting the awaits of its
/// unconditional sub-expression in front of it.
fn awp_spine(e: Expr, ctr: Array[Int], rebuild_is_tail: Bool) -> Expr {
  let _ = rebuild_is_tail
  let binds = array_empty()
  let lifted = awp_lift(e, ctr, binds)
  awp_wrap(binds, lifted)
}

/// `Future::ready(x)` awaited immediately is just `x` -- no array, no loop.
fn awp_ready_payload(fut: Expr) -> Option[Expr] {
  match fut {
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if nm == "Future::ready" && Array::length(args) == 1 {
        Some(Array::get(args, 0))
      } else {
        None
      },
      _ => None
    },
    _ => None
  }
}

/// A spine node's own rewrite: recurse structurally, hoisting the awaits of
/// each unconditionally-evaluated slot in front of that slot's construct.
/// Anything that is NOT a spine node is returned untouched -- awp_tail is the
/// entry that lifts a bare tail expression, and keeping the two fallbacks
/// disjoint is what makes the mutual recursion terminate.
fn awp_rewrite(e: Expr, ctr: Array[Int]) -> Expr {
  match e {
    ELet(n, v, b, off) => {
      let binds = array_empty()
      let v2 = awp_lift(v, ctr, binds)
      awp_wrap(binds, ELet(n, v2, awp_tail(b, ctr), off))
    },
    ELetMut(n, v, b, off) => {
      let binds = array_empty()
      let v2 = awp_lift(v, ctr, binds)
      awp_wrap(binds, ELetMut(n, v2, awp_tail(b, ctr), off))
    },
    ELetRec(n, v, b) => ELetRec(n, awp_tail(v, ctr), awp_tail(b, ctr)),
    ESeq(a, b) => {
      let binds = array_empty()
      let a2 = awp_lift(a, ctr, binds)
      awp_wrap(binds, ESeq(a2, awp_tail(b, ctr)))
    },
    EAssign(n, v, c) => {
      let binds = array_empty()
      let v2 = awp_lift(v, ctr, binds)
      awp_wrap(binds, EAssign(n, v2, awp_tail(c, ctr)))
    },
    EAssignOp(op, n, v, c) => {
      let binds = array_empty()
      let v2 = awp_lift(v, ctr, binds)
      awp_wrap(binds, EAssignOp(op, n, v2, awp_tail(c, ctr)))
    },
    EIf(c, t, el) => {
      let binds = array_empty()
      let c2 = awp_lift(c, ctr, binds)
      awp_wrap(binds, EIf(c2, awp_tail(t, ctr), awp_tail(el, ctr)))
    },
    EMatch(sc, arms) => {
      let binds = array_empty()
      let sc2 = awp_lift(sc, ctr, binds)
      awp_wrap(binds, EMatch(sc2, awp_rewrite_arms(arms, ctr)))
    },
    // A loop condition is re-evaluated every iteration, so nothing can be
    // hoisted out of it; both parts get their own spine instead.
    EWhile(c, b) => EWhile(awp_tail(c, ctr), awp_tail(b, ctr)),
    EForIn(n, idx, it, b) => {
      let binds = array_empty()
      let it2 = awp_lift(it, ctr, binds)
      awp_wrap(binds, EForIn(n, idx, it2, awp_tail(b, ctr)))
    },
    ELoop(pairs, b) => ELoop(awp_rewrite_pairs(pairs, ctr), awp_tail(b, ctr)),
    EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, awp_tail(b, ctr)),
    EHandle(b, arms) => EHandle(awp_tail(b, ctr), awp_rewrite_arms(arms, ctr)),
    EReturn(x) => {
      let binds = array_empty()
      let x2 = awp_lift(x, ctr, binds)
      awp_wrap(binds, EReturn(x2))
    },
    EBreak(opt) => match opt {
      Some(x) => {
        let binds = array_empty()
        let x2 = awp_lift(x, ctr, binds)
        awp_wrap(binds, EBreak(Some(x2)))
      },
      None => e
    },
    EContinue(args) => {
      let binds = array_empty()
      let args2 = awp_lift_exprs(args, ctr, binds)
      awp_wrap(binds, EContinue(args2))
    },
    _ => e
  }
}

/// A TAIL (or statement) position: a spine node recurses structurally, and
/// anything else is a value whose awaits are hoisted in front of it.
fn awp_tail(e: Expr, ctr: Array[Int]) -> Expr {
  match e {
    ELet(_, _, _, _) => awp_rewrite(e, ctr),
    ELetMut(_, _, _, _) => awp_rewrite(e, ctr),
    ELetRec(_, _, _) => awp_rewrite(e, ctr),
    ESeq(_, _) => awp_rewrite(e, ctr),
    EAssign(_, _, _) => awp_rewrite(e, ctr),
    EAssignOp(_, _, _, _) => awp_rewrite(e, ctr),
    EIf(_, _, _) => awp_rewrite(e, ctr),
    EMatch(_, _) => awp_rewrite(e, ctr),
    EWhile(_, _) => awp_rewrite(e, ctr),
    EForIn(_, _, _, _) => awp_rewrite(e, ctr),
    ELoop(_, _) => awp_rewrite(e, ctr),
    EFn(_, _, _, _, _, _) => awp_rewrite(e, ctr),
    EHandle(_, _) => awp_rewrite(e, ctr),
    EReturn(_) => awp_rewrite(e, ctr),
    EBreak(_) => awp_rewrite(e, ctr),
    EContinue(_) => awp_rewrite(e, ctr),
    _ => awp_spine(e, ctr, true)
  }
}

fn awp_rewrite_pairs(pairs: Array[(String, Expr)], ctr: Array[Int]) -> Array[(String, Expr)] {
  for p in pairs {
    let (n, v) = p
    (n, awp_tail(v, ctr))
  }
}

fn awp_rewrite_arms(arms: Array[(Pat, Expr)], ctr: Array[Int]) -> Array[(Pat, Expr)] {
  for a in arms {
    let (p, ex) = a
    (p, awp_tail(ex, ctr))
  }
}
