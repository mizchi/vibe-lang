//# Imports

import @vibe/compiler/core {
  bytebuf_new, bytebuf_push, bytebuf_push_buf, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32
}

import @vibe/core {
  array_empty
}

//# Functions

// #805 inline wasm: a small WAT-body assembler for the linear backend's
// `fn f(a: Int, b: Int) -> Int = wasm "(i64.add (local.get $a) (local.get $b))"`
// form. Compiles the body TEXT of one function to raw instruction bytes
// (no locals-declaration header, no trailing 0x0B end opcode — exactly the
// `bodies` convention of linked_compile.vibe's code-section builder, which
// adds both).
//
// Why not reuse lib/@vibex/wasm/wat_encoder? Three reasons, each fatal for
// this use (see ADR-0072):
//   1. wat_encoder has NO SIMD (0xFD prefix) support at all — a headline
//      motivation for inline wasm (roadmap item 7) — so it would need
//      extension anyway.
//   2. its body walker emits folded S-expressions in PREFIX order (the
//      operator before its operands), which mis-orders the canonical
//      `(i64.add (local.get $a) (local.get $b))` spelling. This assembler
//      implements real folded-form semantics (operands first).
//   3. it silently resolves unknown instruction/local names to index 0 with
//      no error channel; inline wasm needs located compile errors.
// Pulling the 2.8k-line package into the compiler dependency closure (and
// its source into the seed-compiled bundle) for a subset we would then have
// to patch was strictly worse than this ~600-line purpose-built assembler.
//
// Supported subset (v0.3 slice, documented in docs/cheatsheet.md):
//   - folded S-expressions AND flat instruction sequences; structured
//     control (block/loop/if) is folded-form ONLY
//   - `(block $l (result i64) ...)`, `(loop $l ...)`,
//     `(if (result T)? <cond> (then ...) (else ...)?)`, br / br_if with
//     `$label` or numeric relative depth; return/unreachable/nop/drop/select
//   - local.get / local.set / local.tee over the fn's own params
//     (`$paramname` or numeric index) AND `(local $name TYPE)` declarations
//     at the START of the body (types i32/i64/v128, grouped in that order —
//     the code-entry locals header encodes one run per type, so interleaved
//     declarations would silently renumber; a located error enforces the
//     grouping). Declared locals index from `extra_base` (the caller's
//     param-slot count including the closure-env slot).
//   - i32/i64 const (decimal / hex / `_` separators; BOTH the signed and the
//     unsigned spelling of an immediate, per the spec's `iN ::= n:uN | i:sN`),
//     full i32/i64 integer arithmetic / compare / shift / rotate /
//     conversion set, f32/f64 arithmetic + compares (no f32/f64.const)
//   - memory loads/stores with optional `offset=` / `align=` (align in
//     bytes, spec-style), memory.size / memory.grow
//   - SIMD (0xFD): v128.load/store, v128.const, splat / extract_lane /
//     replace_lane, i8x16.shuffle (16 lane-byte immediates 0..31), integer
//     lane arithmetic + compares, bitwise, all_true / any_true / bitmask,
//     swizzle, shifts
//   - folded `(call $f <operands...>)` to another inline-wasm fn in the SAME
//     module (#2348), arity-checked against the callee's declared params.
//     The closure-env slot and the call opcode are emitted by the assembler;
//     the WAT author writes only the real arguments. Folded form only --
//     the flat spelling's operand count is not knowable here, so it could
//     not be checked
//   - NOT supported (clear errors): flat-form call / call_indirect /
//     return_call / br_table / global.get/set / f32.const / f64.const

fn iw_err(fn_name: String, msg: String, off: Int) -> String {
  "inline wasm (fn \{fn_name}): \{msg} (WAT offset \{off})"
}

fn iw_fresh_ints() -> Array[Int] {
  array_empty()
}

fn iw_fresh_strings() -> Array[String] {
  array_empty()
}

fn iw_fresh_locals() -> Array[(String, Int)] {
  array_empty()
}

/// #2348: the empty callee table — a body that may not `call` anything.
fn iw_fresh_callees() -> Array[(String, Int, Int)] {
  array_empty()
}

fn iw_is_space(c: Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13
}

/// Token kinds: 1 = '(', 2 = ')', 3 = word. Words end at whitespace, parens
/// or ';'. Comments: `;; ...` to end of line, `(; ... ;)` (non-nested).
fn iw_tokenize(fn_name: String, src: String) -> (Array[Int], Array[String], Array[Int]) with Exception {
  let kinds = iw_fresh_ints()
  let texts = iw_fresh_strings()
  let offs = iw_fresh_ints()
  let n = String::length(src)
  let mut i = 0
  while i < n {
    let c = String::char_code_at(src, i)
    if iw_is_space(c) {
      i = i + 1
    } else if c == 59 {
      // ';' — only meaningful as ';;' line comment
      if i + 1 < n && String::char_code_at(src, i + 1) == 59 {
        while i < n && String::char_code_at(src, i) != 10 {
          i = i + 1
        }
      } else {
        throw(iw_err(fn_name, "stray ';' (use ';;' line comments)", i))
      }
    } else if c == 40 {
      // '(' — possibly a '(;' block comment
      if i + 1 < n && String::char_code_at(src, i + 1) == 59 {
        let mut j = i + 2
        let mut closed = false
        while j + 1 < n && !closed {
          if String::char_code_at(src, j) == 59 && String::char_code_at(src, j + 1) == 41 {
            closed = true
          } else {
            j = j + 1
          }
        }
        if !closed {
          throw(iw_err(fn_name, "unterminated '(;' block comment", i))
        } else {
          ()
        }
        i = j + 2
      } else {
        Array::push(kinds, 1)
        Array::push(texts, "")
        Array::push(offs, i)
        i = i + 1
      }
    } else if c == 41 {
      Array::push(kinds, 2)
      Array::push(texts, "")
      Array::push(offs, i)
      i = i + 1
    } else {
      let start = i
      let mut j = i
      let mut stop = false
      while j < n && !stop {
        let wc = String::char_code_at(src, j)
        if iw_is_space(wc) || wc == 40 || wc == 41 || wc == 59 {
          stop = true
        } else {
          j = j + 1
        }
      }
      Array::push(kinds, 3)
      Array::push(texts, String::substring(src, start, j))
      Array::push(offs, start)
      i = j
    }
  }
  (kinds, texts, offs)
}

/// Integer immediates: decimal / 0x-hex, optional leading '-', '_' separators.
fn iw_parse_int(fn_name: String, s: String, off: Int) -> Int with Exception {
  let n = String::length(s)
  let mut i = 0
  let mut neg = false
  if i < n && String::char_code_at(s, i) == '-' {
    neg = true
    i = i + 1
  } else {
    ()
  }
  let mut hex = false
  if i + 1 < n && String::char_code_at(s, i) == '0' {
    let x = String::char_code_at(s, i + 1)
    if x == 'x' || x == 'X' {
      hex = true
      i = i + 2
    } else {
      ()
    }
  } else {
    ()
  }
  let mut v = 0
  let mut any = false
  while i < n {
    let c = String::char_code_at(s, i)
    if c == '_' {
      i = i + 1
    } else if hex {
      let d = if c >= '0' && c <= '9' {
        c - '0'
      } else if c >= 'a' && c <= 'f' {
        c - 'a' + 10
      } else if c >= 'A' && c <= 'F' {
        c - 'A' + 10
      } else {
        0 - 1
      }
      if d < 0 {
        throw(iw_err(fn_name, "invalid integer literal '\{s}'", off))
      } else {
        ()
      }
      iw_check_digit_fits(fn_name, s, v, 16, d, off)
      v = v * 16 + d
      any = true
      i = i + 1
    } else {
      if c >= '0' && c <= '9' {
        iw_check_digit_fits(fn_name, s, v, 10, c - '0', off)
        v = v * 10 + (c - '0')
        any = true
        i = i + 1
      } else {
        throw(iw_err(fn_name, "invalid integer literal '\{s}'", off))
      }
    }
  }
  if !any {
    throw(iw_err(fn_name, "invalid integer literal '\{s}'", off))
  } else {
    ()
  }
  if neg {
    0 - v
  } else {
    v
  }
}

/// The largest vibe `Int`, 2^62-1. Spelled by arithmetic on purpose: until the
/// next bootstrap bump the committed seed still enforces the pre-#1877 literal
/// bound of 2^61-1, and seed-driven tooling (`vibe fmt`) lexes all of `lib/**`.
fn iw_int_max() -> Int {
  (2305843009213693951<<1)|1
}

/// Reject `v * base + d` BEFORE it wraps. #1877 made `Int` arithmetic wrap as
/// 63-bit two's complement, so an over-long literal used to silently become a
/// different number -- the worst way to break, and invisible in a WAT string.
fn iw_check_digit_fits(fn_name: String, s: String, v: Int, base: Int, d: Int, off: Int) -> Unit with Exception {
  if v > (iw_int_max() - d) / base {
    throw(iw_err(fn_name, "integer literal '\{s}' is out of range for a vibe Int (max \{iw_int_max()})", off))
  } else {
    ()
  }
}

/// Fold a WAT integer immediate into the signed range wasm actually encodes.
///
/// The text format accepts BOTH spellings of an `iN` immediate (spec:
/// `iN ::= n:uN | i:sN`), so `(i32.const 2654435761)` and
/// `(i32.const -1640531535)` are the same instruction -- 0x9E3779B1 either way.
/// This used to encode the first one verbatim as a 5-byte s32 LEB, which no
/// validator accepts: `vibe check` reported the file CLEAN and the module then
/// failed at load with a wasmtime backtrace naming a function index the author
/// never wrote (#2341).
///
/// `bits` is 8 / 16 / 32; 64-bit immediates need no folding because every vibe
/// `Int` already fits in an i64.
fn iw_fold_signed_imm(fn_name: String, what: String, v: Int, bits: Int, off: Int) -> Int with Exception {
  let span = 1<<bits
  let half = span / 2
  if v >= 0 - half && v < half {
    v
  } else if v >= half && v < span {
    v - span
  } else {
    throw(iw_err(fn_name, "\{what} \{v} is out of range for i\{bits}: write a value in \{0 - half}..\{span - 1} (either spelling of the same bit pattern is accepted), or widen the instruction", off))
  }
}

