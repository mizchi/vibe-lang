//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr, is_exception_throw_operation, sort_perm_by_names, str_lt
}

import @vibe/core {
  array_empty
}

//# Functions

// Dictionary-passing desugaring for method-bearing traits (#641 PR-3
// components 3+4). Runs pre-check, after string-interpolation expansion. It is
// INERT unless the program declares a trait with method signatures, so all
// existing code (and the compiler's own selfbuild) is untouched.
//
// For a method-bearing `trait Tr { m(Self) -> R; ... }` it:
//   1. synthesizes a witness struct `TrDict { m: (Self) -> R; ... }`,
//   2. for each top-level generic `f = [T: Tr](.. x: T ..) -> Ret { body }`
//      that is bounded by `Tr`, prepends a hidden dict parameter
//      `__dict_Tr_T: TrDict[T]` and rewrites `T::m(args)` in the body to
//      `(__dict_Tr_T.m)(args)`,
//   3. at every call site `f(.. recv ..)` synthesizes the witness
//      `TrDict::{ m: C::m, ... }` from the concrete receiver type C (the impl's
//      `C::m` free functions from PR-1) and threads it in.
//
// First slice (see docs/method-bearing-traits-plan.md): single type parameter
// per bound that appears directly as a parameter type (`x: T`), concrete call
// sites whose receiver type is syntactically determinable (primitive literals
// and struct literals). Anything outside this leaves the call unrewritten, so a
// missing dictionary surfaces as a loud arity error rather than a miscompile.

fn empty_expr_array() -> Array[Expr] {
  array_empty()
}

fn empty_str_array() -> Array[String] {
  array_empty()
}

/// #886: empty explicit-type-argument list for constructed ERecord nodes
/// (dict witnesses / trait defaults never carry explicit struct type args).
fn empty_ty_args() -> Array[TypeExpr] {
  array_empty()
}

fn empty_type_exprs() -> Array[TypeExpr] {
  array_empty()
}

/// Method names declared by a trait, in declaration order.
fn method_names_of_sigs(methods: Array[(String, Array[TypeExpr], TypeExpr)]) -> Array[String] {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(methods) {
    let (mname, _, _) = Array::get(methods, i)
    Array::push(out, mname)
    i = i + 1
  }
  out
}

fn str_array_contains(arr: Array[String], val: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == val {
      found = true
      i = Array::length(arr)
    } else {
      i = i + 1
    }
  }
  found
}

/// Split a qualified `Head::member` into Some((head, member)) on the FIRST `::`.
fn split_qualified(name: String) -> Option[(String, String)] {
  let idx = String::index_of(name, "::")
  if idx < 0 {
    None
  } else {
    let head = String::substring(name, 0, idx)
    let member = String::substring(name, idx + 2, String::length(name))
    Some((head, member))
  }
}

/// The dict struct name for a trait, e.g. `Measurable` -> `MeasurableDict`.
fn dict_struct_name(trait_name: String) -> String {
  String::concat(trait_name, "Dict")
}

/// The hidden dict parameter name for `[T: Tr]`, e.g. `__dict_Measurable_T`.
fn dict_param_name(trait_name: String, tparam: String) -> String {
  String::concat("__dict_", String::concat(trait_name, String::concat("_", tparam)))
}

/// Collect method-bearing traits (name -> signatures). Marker-only traits
/// (no method signatures) are skipped, which is what keeps this pass inert on
/// existing code.
fn collect_method_traits(stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STrait(_, tname, _, methods, _, _) => if Array::length(methods) > 0 {
        Array::push(out, (tname, methods))
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

// ---- rank-1 method generics (#684) ----
//
// A trait method may declare its own type parameters, `m: [X: Show](Self, X) ->
// R`. The binder lives on the TRAIT method only (STrait's 5th field); the impl
// `impl Tr for C { m = (self, x) -> {..} }` does NOT repeat it and parses to a
// top-level `SLet(_, _, "C::m", _, EFn([], [], [(self,None),(x,None)], ..))`.
// `inject_method_generics` re-attaches the trait method's `[X: Show]` binder to
// the impl's free function and annotates the unannotated params with the trait
// method's declared param types. After injection `build_gens` sees `x: X`,
// registers `C::m` as a Show-bounded generic, and the existing dict-passing
// machinery threads/synthesizes the `Show` witness at qualified call sites.

fn empty_method_gens() -> Array[(String, Array[String], Array[(String, Array[String])])] {
  array_empty()
}

/// Collect every trait's per-method generic binders (name -> [(method,
/// type_params, bounds)]) from STrait's 5th field. Only traits that declare a
/// non-empty binder on at least one method are kept, so this stays inert.
fn collect_trait_method_gens(stmts: Array[Stmt]) -> Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STrait(_, tname, _, _, method_gens, _) => {
        let mut any = false
        let mut j = 0
        while j < Array::length(method_gens) {
          let (_, tps, _) = Array::get(method_gens, j)
          if Array::length(tps) > 0 {
            any = true
          } else {
            ()
          }
          j = j + 1
        }
        if any {
          Array::push(out, (tname, method_gens))
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Look up a method's `(type_params, bounds)` in a trait's method-gen table.
/// Returns None when the method has no binder (empty type_params).
fn lookup_method_gen(table: Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], trait_name: String, method: String) -> Option[(Array[String], Array[(String, Array[String])])] {
  let mut i = 0
  let mut result = None
  while i < Array::length(table) {
    let (tn, gens) = Array::get(table, i)
    if tn == trait_name {
      let mut j = 0
      while j < Array::length(gens) {
        let (mname, tps, bounds) = Array::get(gens, j)
        if mname == method && Array::length(tps) > 0 {
          result = Some((tps, bounds))
          j = Array::length(gens)
        } else {
          j = j + 1
        }
      }
      i = Array::length(table)
    } else {
      i = i + 1
    }
  }
  result
}

/// Map each impl's target type to the trait it implements
/// (`impl Tr for C` -> (C, Tr)). A type may implement several traits; the first
/// matching trait that declares the method is used at lookup time.
fn collect_impl_trait_map(stmts: Array[Stmt]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImpl(_, _, trait_name, type_name) => Array::push(out, (type_name, trait_name)),
      _ => ()
    }
    i = i + 1
  }
  out
}

/// The declared parameter types of method `m` in trait `trait_name` (its 3-tuple
/// signature). Used to annotate the impl method's unannotated params so the
/// per-method type parameter `X` appears as `x: X`.
fn lookup_trait_method_param_types(traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], trait_name: String, method: String) -> Option[Array[TypeExpr]] {
  match lookup_trait_sigs(traits, trait_name) {
    Some(sigs) => {
      let mut j = 0
      let mut result = None
      while j < Array::length(sigs) {
        let (mname, ptypes, _) = Array::get(sigs, j)
        if mname == method {
          result = Some(ptypes)
          j = Array::length(sigs)
        } else {
          j = j + 1
        }
      }
      result
    },
    None => None
  }
}

/// Find the trait, among those `type_name` implements, that declares a
/// method-level binder for `method`. Returns its (type_params, bounds, param
/// types) so the impl method can be re-typed.
fn find_method_generic_for_impl(impl_map: Array[(String, String)], gen_table: Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], type_name: String, method: String) -> Option[(Array[String], Array[(String, Array[String])], Array[TypeExpr])] {
  let mut i = 0
  let mut result = None
  while i < Array::length(impl_map) {
    let (tn, trait_name) = Array::get(impl_map, i)
    if tn == type_name {
      match lookup_method_gen(gen_table, trait_name, method) {
        Some(g) => {
          let (tps, bounds) = g
          match lookup_trait_method_param_types(traits, trait_name, method) {
            Some(ptypes) => {
              result = Some((tps, bounds, ptypes))
              i = Array::length(impl_map)
            },
            None => {
              i = i + 1
            }
          }
        },
        None => {
          i = i + 1
        }
      }
    } else {
      i = i + 1
    }
  }
  result
}

/// Annotate each parameter whose annotation is None with the trait method's
/// declared param type (when one exists at that index). Already-annotated params
/// keep their annotation.
fn annotate_params_from_sig(params: Array[(String, Option[TypeExpr])], ptypes: Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ann) = Array::get(params, i)
    let new_ann = match ann {
      Some(_) => ann,
      None => if i < Array::length(ptypes) {
        Some(Array::get(ptypes, i))
      } else {
        None
      }
    }
    Array::push(out, (pname, new_ann))
    i = i + 1
  }
  out
}

/// In-place: for each impl method `C::m` whose trait declares a method-level
/// `[X: Bound]` binder, re-attach the binder to the EFn and annotate its params
/// with the trait method's declared types. Idempotent: an EFn that already
/// carries type_params was injected on a prior run and is skipped.
fn inject_method_generics(stmts: Array[Stmt], impl_map: Array[(String, String)], gen_table: Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exp, isrec, qname, ann, body) => match body {
        EFn(tparams, bounds, params, ret, eff, fbody) => if Array::length(tparams) == 0 {
          match split_qualified(qname) {
            Some(parts) => {
              let (cname, method) = parts
              match find_method_generic_for_impl(impl_map, gen_table, traits, cname, method) {
                Some(g) => {
                  let (mtparams, mtbounds, ptypes) = g
                  let new_params = annotate_params_from_sig(params, ptypes)
                  let new_efn = EFn(mtparams, mtbounds, new_params, ret, eff, fbody)
                  Array::set(stmts, i, SLet(exp, isrec, qname, ann, new_efn))
                },
                None => ()
              }
            },
            None => ()
          }
        } else {
          ()
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

/// Re-attach trait-method `[X: Bound]` binders to impl free functions, given a
/// (possibly flattened) method-trait table for param-type lookup. Inert and
/// idempotent. Shared by `desugar_trait_dicts` (pre-codegen) and `check_program`
/// (so the FS-compile path, which type-checks before the desugar runs, also sees
/// the binder and can resolve `X::method`).
fn inject_trait_method_generics_with(stmts: Array[Stmt], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit {
  let method_gen_table = collect_trait_method_gens(stmts)
  if Array::length(method_gen_table) > 0 {
    let impl_map = collect_impl_trait_map(stmts)
    inject_method_generics(stmts, impl_map, method_gen_table, traits)
  } else {
    ()
  }
}

/// Self-contained entry for callers that have not flattened the trait table
/// (the checker). Builds its own (flattened) method-trait table from `stmts`.
export fn inject_trait_method_generics(stmts: Array[Stmt]) -> Unit {
  let traits_raw = collect_method_traits(stmts)
  let supers_map = collect_trait_supers(stmts)
  let traits = flatten_traits(traits_raw, supers_map)
  inject_trait_method_generics_with(stmts, traits)
}

/// #760(2): `Result` is not a built-in type constructor (unlike Option/CtOption);
/// it is the ordinary user enum `enum Result[T, E] { Ok(T); Err(E) }` (see
/// vibe/prelude/result.vibe). A standalone program that neither declares nor
/// imports it gets `unknown name: Ok` / `Err` / `Result::Ok`. This appends that
/// enum declaration to the program UNLESS a `Result` type (or an `Ok`/`Err`
/// constructor) is already in scope — user-declared, or imported and merged in as
/// a statement. All the existing user-enum machinery (ctor resolution, pattern
/// match, exhaustiveness, codegen ctor construction) then applies with no
/// type-system changes. Type declarations are hoisted, so appending is order-safe.
/// In-place + idempotent + inert when Result is already present. Shared by
/// `desugar_trait_dicts` (pre-codegen) and `check_program` (the FS-compile path
/// type-checks before the codegen desugar runs), which both re-parse the merged
/// program, so each independently appends the SAME deterministic declaration.
/// #760(2): does the program actually reference `Result` / `Ok` / `Err`? The
/// prelude injection is gated on this so a program that never mentions Result
/// gets NO injected enum — otherwise every binary would carry (and #cov would
/// instrument) a dead `Ok`/`Err` ctor. Covers construction (`Ok`/`Err`/
/// `Result::Ok`/`Result::Err` value references), pattern matches (`Ok(..)` /
/// `Err(..)` arms), and `Result[..]` type annotations.
fn is_result_ctor_name(s: String) -> Bool {
  s == "Ok" || s == "Err" || s == "Result::Ok" || s == "Result::Err"
}

fn ty_mentions_result(te: TypeExpr) -> Bool {
  match te {
    TyName(n) => n == "Result",
    TyApp(n, args) => if n == "Result" {
      true
    } else {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if ty_mentions_result(Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyFn(params, ret, _) => {
      let mut found = ty_mentions_result(ret)
      let mut i = 0
      while i < Array::length(params) {
        if ty_mentions_result(Array::get(params, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyTuple(elems) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(elems) {
        if ty_mentions_result(Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyUnit => false
  }
}

fn opt_ty_mentions_result(o: Option[TypeExpr]) -> Bool {
  match o {
    Some(t) => ty_mentions_result(t),
    None => false
  }
}

fn pat_mentions_result(p: Pat) -> Bool {
  match p {
    PCtor(name, sub) => if is_result_ctor_name(name) {
      true
    } else {
      let mut i = 0
      let mut found = false
      while i < Array::length(sub) {
        if pat_mentions_result(Array::get(sub, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    PStruct(name, fields) => if is_result_ctor_name(name) || name == "Result" {
      true
    } else {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        if pat_mentions_result(fp) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    PTuple(sub) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(sub) {
        if pat_mentions_result(Array::get(sub, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    POr(a, b) => pat_mentions_result(a) || pat_mentions_result(b),
    _ => false
  }
}

/// Recurse into an array of exprs (inlined, like collect_strings_expr — a `let
/// rec` cannot forward-reference a plain `let` helper defined later).
fn expr_mentions_result(e: Expr) -> Bool {
  match e {
    EIdent(n, _) => is_result_ctor_name(n) || n == "Result",
    ETuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if expr_mentions_result(Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EArray(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if expr_mentions_result(Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        if expr_mentions_result(v) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EMap(fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        if expr_mentions_result(v) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EIf(c, t, el) => expr_mentions_result(c) || expr_mentions_result(t) || expr_mentions_result(el),
    ELet(_, v, b, _) => expr_mentions_result(v) || expr_mentions_result(b),
    ELetRec(_, v, b) => expr_mentions_result(v) || expr_mentions_result(b),
    ELetMut(_, v, b, _) => expr_mentions_result(v) || expr_mentions_result(b),
    EAssign(_, v, b) => expr_mentions_result(v) || expr_mentions_result(b),
    EAssignOp(_, _, v, b) => expr_mentions_result(v) || expr_mentions_result(b),
    ESeq(a, b) => expr_mentions_result(a) || expr_mentions_result(b),
    EMatch(scrut, arms) => {
      let mut found = expr_mentions_result(scrut)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        if pat_mentions_result(p) || expr_mentions_result(b) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EHandle(scrut, arms) => {
      let mut found = expr_mentions_result(scrut)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        if pat_mentions_result(p) || expr_mentions_result(b) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EWhile(c, b) => expr_mentions_result(c) || expr_mentions_result(b),
    ELoop(params, body) => {
      let mut found = expr_mentions_result(body)
      let mut i = 0
      while i < Array::length(params) {
        let (_, v) = Array::get(params, i)
        if expr_mentions_result(v) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EForIn(_, _, it, body) => expr_mentions_result(it) || expr_mentions_result(body),
    ECall(callee, args, _) => {
      let mut found = expr_mentions_result(callee)
      let mut i = 0
      while i < Array::length(args) {
        if expr_mentions_result(Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EBinOp(_, l, r) => expr_mentions_result(l) || expr_mentions_result(r),
    EUnaryOp(_, x) => expr_mentions_result(x),
    EFn(_, _, params, ret, _, body) => {
      let mut found = opt_ty_mentions_result(ret) || expr_mentions_result(body)
      let mut i = 0
      while i < Array::length(params) {
        let (_, ann) = Array::get(params, i)
        if opt_ty_mentions_result(ann) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EDot(o, _, _, _) => expr_mentions_result(o),
    ELabeledArg(_, _, v) => expr_mentions_result(v),
    EReturn(x) => expr_mentions_result(x),
    EBreak(o) => match o {
      Some(x) => expr_mentions_result(x),
      None => false
    },
    EContinue(xs) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(xs) {
        if expr_mentions_result(Array::get(xs, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ESpread(x) => expr_mentions_result(x),
    _ => false
  }
}

fn stmt_mentions_result(s: Stmt) -> Bool {
  match s {
    SLet(_, _, _, ann, v) => opt_ty_mentions_result(ann) || expr_mentions_result(v),
    SLetMut(_, ann, v) => opt_ty_mentions_result(ann) || expr_mentions_result(v),
    STest(_, b) => expr_mentions_result(b),
    SBench(_, b) => expr_mentions_result(b),
    SExpr(e) => expr_mentions_result(e),
    SLetPat(p, e) => pat_mentions_result(p) || expr_mentions_result(e),
    SExternLet(_, te) => ty_mentions_result(te),
    STypeAlias(_, _, _, te) => ty_mentions_result(te),
    SStruct(_, _, fields, _, _, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, te) = Array::get(fields, i)
        if ty_mentions_result(te) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    SModule(_, _, body) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(body) {
        if stmt_mentions_result(Array::get(body, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

fn program_mentions_result(stmts: Array[Stmt]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    if stmt_mentions_result(Array::get(stmts, i)) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn result_already_present(stmts: Array[Stmt]) -> Bool {
  let mut present = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(_, name, _, variants, _) => {
        if name == "Result" {
          present = true
        } else {
          ()
        }
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vn, _) = Array::get(variants, vi)
          if vn == "Ok" || vn == "Err" {
            present = true
          } else {
            ()
          }
          vi = vi + 1
        }
      },
      SStruct(_, name, _, _, _, _) => if name == "Result" {
        present = true
      } else {
        ()
      },
      STypeAlias(_, name, _, _) => if name == "Result" {
        present = true
      } else {
        ()
      },
      // An imported / re-exported `Result` (or `Ok`/`Err`) — e.g.
      // `import ../prelude/result.vibe { Result }`. Without this the per-file
      // checker path (which sees the import but not the merged enum declaration)
      // would inject a SECOND, nominally-distinct `Result`, so a value of the
      // imported type would not unify with the injected one (`type mismatch in
      // '=='`). Treat the imported name as already-present.
      SImport(_, names) => {
        let mut ni = 0
        while ni < Array::length(names) {
          let (nm, _) = Array::get(names, ni)
          if nm == "Result" || nm == "Ok" || nm == "Err" {
            present = true
          } else {
            ()
          }
          ni = ni + 1
        }
      },
      SReExport(_, names) => {
        let mut ni = 0
        while ni < Array::length(names) {
          let (nm, _) = Array::get(names, ni)
          if nm == "Result" || nm == "Ok" || nm == "Err" {
            present = true
          } else {
            ()
          }
          ni = ni + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  present
}

export fn inject_prelude_result(stmts: Array[Stmt]) -> Unit {
  if result_already_present(stmts) || !program_mentions_result(stmts) {
    ()
  } else {
    let variants = [
      ("Ok", [
        TyName("T")
      ]),
      ("Err", [
        TyName("E")
      ])
    ]
    let params = [
      "T",
      "E"
    ]
    Array::push(stmts, SEnum(false, "Result", params, variants, empty_str_array()))
  }
}

//# #1374: the runtime exception-kind side channel
//
// ADR-0085 lowers EVERY exception spelling to one abortive Wasm tag with no
// kind discriminator, and the erased `Error` spelling is deliberately
// compatible with every kind (that is what kept #1344 additive over #786's
// suberror throws). So `handle { .. } with Error { Throw(m) => .. }` also
// catches a typed `Exception[E]` throw, and `m`'s static type there is
// `CtUnknown` -- using it as a String type-checks, then misreads an enum
// pointer as a packed `(ptr<<32)|len` string. Measured on #1372: a whole data
// segment written to stderr, and a `String::length` of 2129 on a `Closed`
// payload. PR #1375 stopped the arbitrary-memory read by routing both sinks
// through `__to_string`; it could not tell the two cases apart, so a non-String
// payload printed as a bare decimal.
//
// The channel: a one-slot module-level cell, written immediately before every
// `perform <Exception>::Throw(v)` with the payload's statically resolved type
// name, read back by `__exn_kind()`. The payload's representation is untouched,
// so every existing handler keeps working unchanged -- purely additive.
//
// Why a module-level `let` array rather than a new wasm global or a new pair of
// builtins: the cell is ordinary vibe AST, so it rides the already-verified
// module-let path (initialized once, one shared identity, mutations visible
// across accesses -- fixtures/module_let_memo_test.vibe pins exactly these
// three properties) and needs no new emission in EITHER backend, so the linear
// and wasm-gc lanes cannot desynchronize on it.
//
// Why ONE slot is enough. The window between the write and the handler's read
// is a single abortive unwind, and nothing else runs inside it:
//   - `Error` is non-resumable (#640), so the unwind never returns to the throw
//     site and no code after the write executes before the handler.
//   - the ADR-0076 task pump re-enters a task only at a suspend point, never
//     mid-unwind, so a sibling task cannot interleave a write.
//   - a nested throw (a throw inside a handler arm) writes before it unwinds
//     and is read by ITS handler first, which is the correct innermost-wins
//     order.
// A handler that stores the payload and inspects the kind LATER is outside that
// window and must read `__exn_kind()` in the arm itself. Both sinks below do.

fn exn_kind_cell_name() -> String {
  "__exn_kind_cell"
}

/// The `[""]`-shaped one-slot cell, appended to the program on demand.
fn exn_kind_cell_stmt() -> Stmt {
  SLet(false, false, exn_kind_cell_name(), None, EArray([
    EString("")
  ]))
}

/// What `__exn_kind()` lowers to. Exported because the compiler-synthesized
/// entry boundary (lc_wrap_entry_error_boundary) is built AFTER this pass and
/// so has to spell the lowered form itself.
export fn exn_kind_read_expr() -> Expr {
  ECall(EIdent("Array::get", -1), [
    EIdent(exn_kind_cell_name(), -1),
    EInt(0)
  ], -1)
}

fn exn_kind_write_expr(kind: String) -> Expr {
  ECall(EIdent("Array::set", -1), [
    EIdent(exn_kind_cell_name(), -1),
    EInt(0),
    EString(kind)
  ], -1)
}

/// Append the cell unless the program already declares it. Idempotent, and
/// callable from any pass that needs the cell to exist (the entry boundary
/// synthesizes a reader after this pass has already run).
export fn ensure_exn_kind_cell(stmts: Array[Stmt]) -> Unit {
  if exn_kind_cell_present(stmts) {
    ()
  } else {
    Array::push(stmts, exn_kind_cell_stmt())
  }
}

fn exn_kind_cell_present(stmts: Array[Stmt]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, n, _, _) => if n == exn_kind_cell_name() {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// Pass state for the rewrite below, reset at every `desugar_trait_dicts`
/// entry (the same discipline `set_throw_kind_table` uses in the checker, and
/// for the same reason -- state must never survive into the next program).
///
/// `[0]` = suppressed: the cell is already declared, so an earlier run of this
/// pass on the same program already wrapped every throw. Re-wrapping would nest
/// a second, redundant write inside the first one's `ESeq`. `[1]` = used: at
/// least one throw was wrapped or one `__exn_kind()` was lowered, so the cell
/// has to be appended once the rewrite loop finishes. `[2]` = the payload-temp
/// counter, so each wrapped throw binds its payload under a name of its own.
let dtd_exn_kind_state = [
  0,
  0,
  0
]

fn exn_kind_suppressed() -> Bool {
  Array::get(dtd_exn_kind_state, 0) == 1
}

fn exn_kind_mark_used() -> Unit {
  Array::set(dtd_exn_kind_state, 1, 1)
}

/// A payload-temp name no other throw site shares. Lexical scoping alone would
/// make one fixed name correct (an inner throw's binding closes before the
/// outer one binds), but a distinct name per site keeps that from being a fact
/// the reader has to re-derive, and keeps the nesting legible in dumped IR.
fn exn_kind_fresh_payload_name() -> String {
  let n = Array::get(dtd_exn_kind_state, 2)
  Array::set(dtd_exn_kind_state, 2, n + 1)
  String::concat("__exn_payload", __to_string(n))
}

/// `perform <Error|Exception[K]>::Throw(payload)` -- the ONLY shape `throw(x)`
/// lowers to (#640 Stage 2), and the only one that reaches the abortive tag.
fn is_perform_throw_shape(callee: Expr, args: Array[Expr]) -> Bool {
  let head = match callee {
    EIdent(n, _) => n == "perform",
    _ => false
  }
  if head && Array::length(args) == 1 {
    match Array::get(args, 0) {
      ECall(op_callee, oargs, _) => match op_callee {
        EIdent(op_n, _) => is_exception_throw_operation(op_n) && Array::length(oargs) == 1,
        _ => false
      },
      _ => false
    }
  } else {
    false
  }
}

/// A nullary `__exn_kind()` call.
fn is_exception_kind_read(callee: Expr, args: Array[Expr]) -> Bool {
  match callee {
    EIdent(n, _) => n == "__exn_kind" && Array::length(args) == 0,
    _ => false
  }
}

fn perform_throw_payload(args: Array[Expr]) -> Expr {
  match Array::get(args, 0) {
    ECall(_, oargs, _) => Array::get(oargs, 0),
    _ => EUnit
  }
}

/// `perform_throw_payload`'s inverse: the same `perform Throw(..)` shape with
/// the payload swapped for `payload`. Used to hoist the payload into a `let`
/// so the kind write happens after it is evaluated (#1374).
fn perform_throw_with_payload(args: Array[Expr], payload: Expr) -> Array[Expr] {
  match Array::get(args, 0) {
    ECall(op_callee, _, ooff) => [
      ECall(op_callee, [
        payload
      ], ooff)
    ],
    _ => args
  }
}

/// Collect each trait's declared supertraits (`trait B: A + ...`), for all
/// traits (method-bearing or not), so a method-bearing trait can inherit its
/// supertraits' methods.
fn collect_trait_supers(stmts: Array[Stmt]) -> Array[(String, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STrait(_, tname, supers, _, _, _) => Array::push(out, (tname, supers)),
      _ => ()
    }
    i = i + 1
  }
  out
}

fn lookup_supers(supers_map: Array[(String, Array[String])], name: String) -> Array[String] {
  let mut i = 0
  let mut result = empty_str_array()
  while i < Array::length(supers_map) {
    let (tname, supers) = Array::get(supers_map, i)
    if tname == name {
      result = supers
      i = Array::length(supers_map)
    } else {
      i = i + 1
    }
  }
  result
}

/// Flatten a trait's method signatures with those of its (transitive) method-
/// bearing supertraits, deduplicating by method name, so `[T: B]` for
/// `trait B: A` can dispatch both B's and A's methods through one flat witness
/// dictionary. `acc_names` / `out` accumulate across the recursion.
///
/// Supertrait methods are emitted BEFORE the trait's own, so an inherited method
/// keeps the same field index in every dict that contains it (e.g. `measure`
/// is index 0 in both `MeasurableDict` and `SizedDict`). This matters because
/// codegen resolves `dict.field` by a global first-match field-name search
/// (compile_expr_tail4.vibe), not by the object's static type — so a shared
/// field name must sit at a consistent index across structs. (Single supertrait
/// chains only; multiple-supertrait ordering is a deferred slice.)
fn flatten_trait_sigs_into(tname: String, traits_raw: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], supers_map: Array[(String, Array[String])], acc_names: Array[String], out: Array[(String, Array[TypeExpr], TypeExpr)]) -> Unit {
  let supers = lookup_supers(supers_map, tname)
  let mut s = 0
  while s < Array::length(supers) {
    flatten_trait_sigs_into(Array::get(supers, s), traits_raw, supers_map, acc_names, out)
    s = s + 1
  }
  match lookup_trait_sigs(traits_raw, tname) {
    Some(sigs) => {
      let mut i = 0
      while i < Array::length(sigs) {
        let (mname, params, ret) = Array::get(sigs, i)
        if str_array_contains(acc_names, mname) {
          ()
        } else {
          Array::push(acc_names, mname)
          Array::push(out, (mname, params, ret))
        }
        i = i + 1
      }
    },
    None => ()
  }
}

/// Produce a method-trait table whose signatures are flattened across
/// supertraits, so all downstream code (dict struct, dispatch names, witness
/// materialization) sees one flat method set per trait.
fn flatten_traits(traits_raw: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], supers_map: Array[(String, Array[String])]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(traits_raw) {
    let (tname, _) = Array::get(traits_raw, i)
    let acc_names = empty_str_array()
    let flat = array_empty()
    flatten_trait_sigs_into(tname, traits_raw, supers_map, acc_names, flat)
    Array::push(out, (tname, flat))
    i = i + 1
  }
  out
}

fn lookup_trait_sigs(traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], name: String) -> Option[Array[(String, Array[TypeExpr], TypeExpr)]] {
  let mut i = 0
  let mut result = None
  while i < Array::length(traits) {
    let (tname, sigs) = Array::get(traits, i)
    if tname == name {
      result = Some(sigs)
      i = Array::length(traits)
    } else {
      i = i + 1
    }
  }
  result
}

/// Collect user struct field-name sets, for inferring a struct-literal's type
/// (the parser discards the `Name::` prefix of `Name::{ ... }`).
fn collect_struct_field_sets(stmts: Array[Stmt]) -> Array[(String, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, fields, _, _, _) => {
        let names = empty_str_array()
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, _) = Array::get(fields, j)
          Array::push(names, fname)
          j = j + 1
        }
        Array::push(out, (sname, names))
      },
      // #672: also record enum names (with an EMPTY field set, so the ERecord
      // field-set match never confuses an enum with a struct literal) so the
      // `==` dispatch's `struct_set_has` gate accepts enum operands too.
      SEnum(_, ename, _, _, _) => Array::push(out, (ename, empty_str_array())),
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Build the witness struct `TrDict { m: (Self) -> R; ... }` for a trait. The
/// `Self` placeholder in the signatures stays verbatim — struct type params are
/// erased, so the field-access typing is structural (proven in spike G-3).
fn make_dict_struct_stmt(trait_name: String, sigs: Array[(String, Array[TypeExpr], TypeExpr)]) -> Stmt {
  let fields = array_empty()
  let mut i = 0
  while i < Array::length(sigs) {
    let (mname, params, ret) = Array::get(sigs, i)
    Array::push(fields, (mname, TyFn(params, ret, None)))
    i = i + 1
  }
  SStruct(false, dict_struct_name(trait_name), fields, empty_str_array(), empty_str_array(), empty_str_array())
}

/// Two field-name sets describe the same struct shape when they have equal
/// length and every name in one appears in the other.
fn field_sets_match(a: Array[String], b: Array[String]) -> Bool {
  if Array::length(a) != Array::length(b) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while i < Array::length(a) {
      if str_array_contains(b, Array::get(a, i)) {
        i = i + 1
      } else {
        ok = false
        i = Array::length(a)
      }
    }
    ok
  }
}

/// Is `name` a known struct (a key in struct_sets)? Gates the #672 `==` dispatch.
fn struct_set_has(struct_sets: Array[(String, Array[String])], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(struct_sets) {
    let (sname, _) = Array::get(struct_sets, i)
    if sname == name {
      found = true
      i = Array::length(struct_sets)
    } else {
      i = i + 1
    }
  }
  found
}

/// Whether type `name` declares a field/variant called `member` (struct_sets
/// maps struct AND enum names to their field/variant name lists). Used to keep
/// a field-stored-function call `b.f(args)` as an EDot when the struct also
/// has a same-named `T::f` method candidate.
fn struct_set_member(struct_sets: Array[(String, Array[String])], name: String, member: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(struct_sets) {
    let (sname, members) = Array::get(struct_sets, i)
    if sname == name {
      let mut j = 0
      while j < Array::length(members) {
        if Array::get(members, j) == member {
          found = true
          j = Array::length(members)
        } else {
          j = j + 1
        }
      }
      i = Array::length(struct_sets)
    } else {
      i = i + 1
    }
  }
  found
}

/// [robj, arg1, arg2, ...] — receiver prepended to the rewritten args for a
/// method-call rewrite (`xs.m(a)` -> `T::m(xs, a)`).
fn prepend_expr(head: Expr, rest: Array[Expr]) -> Array[Expr] {
  let out = array_empty()
  Array::push(out, head)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, Array::get(rest, i))
    i = i + 1
  }
  out
}

fn lookup_var_type(var_types: Array[(String, String)], name: String) -> Option[String] {
  // `extend_var_types` APPENDS on each `let`, so a shadowing rebind adds a second
  // entry for the same name. Return the LAST match (the innermost binding in
  // scope) so `let r = record { a }; ...; let r = record { c }; r.c` resolves
  // against the inner shape rather than the stale outer one (#760(4)).
  let mut i = 0
  let mut result = None
  while i < Array::length(var_types) {
    let (vn, vt) = Array::get(var_types, i)
    if vn == name {
      result = Some(vt)
    } else {
      ()
    }
    i = i + 1
  }
  result
}

/// Best-effort syntactic inference of a call argument's concrete type, enough to
/// pick the trait impl at a concrete call site. Consults `var_types` (locals
/// bound to inferable values and parameters with concrete annotations). Returns
/// None when the type is not determinable (the call is then left unrewritten).
/// Resolve a (possibly qualified) constructor name to its enum/return type.
/// Bare `Green` -> `Color` via fn_returns; qualified `Color::Green` first tries
/// the whole name (no match) then the member `Green` confirming its enum equals
/// the head — so `let a = Color::Green` seeds `a -> Color` for `==` dispatch.
fn ctor_enum_of_name(fn_returns: Array[(String, String)], name: String) -> Option[String] {
  match fn_return_type(fn_returns, name) {
    Some(t) => Some(t),
    None => match split_qualified(name) {
      Some(parts) => {
        let (head, member) = parts
        match fn_return_type(fn_returns, member) {
          Some(en) => if en == head {
            Some(en)
          } else {
            None
          },
          None => None
        }
      },
      None => None
    }
  }
}

fn infer_arg_type_name(arg: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match arg {
    EInt(_) => Some("Int"),
    EBool(_) => Some("Bool"),
    EString(_) => Some("String"),
    EFloat(_) => Some("Double"),
    // String `+` chains: `"a" + b + "c"` infers String when EITHER side does
    // (the checker enforces both sides are String when one is). This both
    // types the concat rewrite below and lets a `let u = a + "x"` binding
    // record u -> String for downstream `u + ...`. Other `+` operands stay
    // None (no behavior change for numeric/unknown).
    EBinOp(bop, bl, br) => if bop == "+" {
      let lstr = match infer_arg_type_name(bl, struct_sets, var_types, fn_returns) {
        Some(t) => t == "String",
        None => false
      }
      let rstr = match infer_arg_type_name(br, struct_sets, var_types, fn_returns) {
        Some(t) => t == "String",
        None => false
      }
      if lstr || rstr {
        Some("String")
      } else {
        None
      }
    } else {
      None
    },
    // An array literal dispatches to an `impl [T] Trait for Array` witness
    // (#5 generic impls): its constructor is "Array" regardless of element type.
    EArray(_) => Some("Array"),
    // Same for a `map { ... }` literal: constructor "Map" (lets a let-bound
    // map resolve an `impl ... for Map` witness at a generic call site).
    EMap(_) => Some("Map"),
    // A variable's recorded type, else a (possibly qualified) nullary
    // constructor's enum name (`Green`/`Color::Green` -> `Color`) so that a
    // `let a = Green` / `let a = Color::Green` binding resolves for `==`. The
    // builtin nullary `None` resolves to the structural shape "Option" so a
    // `let a = None; ... a == b` dispatches structurally (#695).
    EIdent(name, _) => if name == "None" {
      Some("Option")
    } else {
      match lookup_var_type(var_types, name) {
        Some(t) => Some(t),
        None => ctor_enum_of_name(fn_returns, name)
      }
    },
    // #1341 (Codex P1 on #1369): a PROJECTION (`h.s`). The object's type name
    // plus the field name give the field's declared type head, via the
    // reserved fn_returns key seeded by collect_struct_field_types. Without
    // this, `for b in h.s` over a host stream fell through to the array loop
    // and iterated the 2-word `[state, handle]` cell -- returning 4 instead of
    // the body's bytes, with no diagnostic. It also makes `let s = h.s`
    // record `s -> HostStream` (extend_var_types runs infer_arg_type_name on
    // the bound value), so the bind-then-loop spelling works too.
    EDot(obj, field, _, _) => match infer_arg_type_name(obj, struct_sets, var_types, fn_returns) {
      Some(otype) => fn_return_type(fn_returns, struct_field_type_key(otype, field)),
      None => None
    },
    // A call-valued iterable (`for x in lazy_iter_arr([..])`) or data ctor
    // (`Sh::Circle(5)`): its type is the head of the callee's return type. The
    // builtin `Some`/`Ok`/`Err` constructors resolve to "Option"/"Result" so a
    // bare `==` on them dispatches structurally (#695).
    ECall(callee, cargs, _) => match callee {
      EIdent("Some", _) => Some("Option"),
      EIdent("Ok", _) => Some("Result"),
      EIdent("Err", _) => Some("Result"),
      // #1199 bug 1: `Array::get(arr, i)` / `arr[i]` (parses to `__index(arr,
      // i)`, #760(3)) on an Array-typed PARAMETER whose element type
      // seed_var_types recorded (array_elem_key) resolves to that element
      // type -- so `let v = Array::get(values, 0); some_hash_bounded_call(v)`
      // can find v's type the same way a direct `f[T: Hash](v: T)` parameter
      // already could. Without this, infer_arg_type_name fell through to the
      // generic EIdent(fname,_) => ctor_enum_of_name arm below, which knows
      // nothing about "Array::get"/"__index" and returns None -- silently
      // failing synth_dicts and emitting a call short its dictionary
      // argument(s) (invalid wasm) instead of a resolved or forwarded dict.
      EIdent("Array::get", _) => if Array::length(cargs) == 2 {
        match Array::get(cargs, 0) {
          EIdent(arrname, _) => array_elem_type_of(var_types, arrname),
          _ => None
        }
      } else {
        None
      },
      EIdent("__index", _) => if Array::length(cargs) == 2 {
        match Array::get(cargs, 0) {
          EIdent(arrname, _) => array_elem_type_of(var_types, arrname),
          _ => None
        }
      } else {
        None
      },
      // String-returning builtins (not in fn_returns): lets a
      // `String::concat(a, b) + c` / `__to_string(n) + s` operand type as
      // String for the concat rewrite.
      // #1341: the p3 host stream. Not in fn_returns (it is a builtin), and
      // its nominal type is what routes `for b in s` to the host read below
      // instead of to the array loop -- which used to iterate the 2-word cell.
      //
      // Codex P1 on #1369: projections (`for b in h.s`) are covered too --
      // see the EDot arm above, which reads the field's declared head from
      // the `Struct.field` entries collect_struct_field_types seeds into
      // fn_returns. Before that they fell back to the array loop and summed
      // the 2-word cell (measured: 4).
      //
      // Still true, and NOT closed here: the nominal type is a ROUTING KEY,
      // not an enforced barrier. `take_int(s)` with `s: HostStream`
      // type-checks (a `CtNamed` head is tolerated at argument positions,
      // nominal_head_conflict's concreteness gate), so applying an eager
      // Stream combinator to a host stream is not itself a type error.
      // Tightening argument-position nominal checking is cross-cutting work
      // beyond HostStream. Tracked on #1341.
      EIdent("host_stream_named", _) => Some("HostStream"),
      EIdent("String::concat", _) => Some("String"),
      EIdent("String::join", _) => Some("String"),
      EIdent("String::substring", _) => Some("String"),
      EIdent("String::trim", _) => Some("String"),
      EIdent("String::replace", _) => Some("String"),
      EIdent("String::from_char_code", _) => Some("String"),
      EIdent("__to_string", _) => Some("String"),
      // Map-returning builtins (not in fn_returns): lets `let m2 = Map::set(m,
      // k, v)` record m2 -> Map so a later `m2[k]` takes the #760(3) Map::get
      // rewrite. (A `map { }` literal is already classified as Map above.)
      EIdent("Map::set", _) => Some("Map"),
      EIdent("Map::remove", _) => Some("Map"),
      EIdent("Map::insert", _) => Some("Map"),
      EIdent("Map::delete", _) => Some("Map"),
      EIdent("MapBuilder::freeze", _) => Some("Map"),
      // Stream-returning builtins (ADR-0012 eager Array-backed model): lets
      // `for x in Stream::once(v)` — or a let-bound stream via
      // extend_var_types — classify as "Stream" so the for-loop classification
      // lowers it to the plain array loop instead of the pull-closure loop
      // (#822: the pull desugar called the stream value as a closure —
      // call_indirect on an array pointer = table OOB trap).
      EIdent("Stream::once", _) => Some("Stream"),
      EIdent("Stream::empty", _) => Some("Stream"),
      EIdent("Stream::map", _) => Some("Stream"),
      EIdent("Stream::filter", _) => Some("Stream"),
      EIdent("String::to_bytes", _) => Some("Stream"),
      EIdent(fname, _) => ctor_enum_of_name(fn_returns, fname),
      // `let x: T = e` is desugared to `((__asc: T) -> __asc)(e)` (ascribe_wrap);
      // recover the operand's type head from the annotation so an annotated
      // `let a: Option[Int] = None` records `a -> "Option"` for `==` dispatch.
      EFn(_, _, params, _, _, _) => if Array::length(params) == 1 {
        let (_, ann) = Array::get(params, 0)
        match ann {
          Some(TyName(n)) => Some(n),
          Some(TyApp(n, _)) => Some(n),
          _ => None
        }
      } else {
        None
      },
      // #864: a UFCS method-chain call `x.method(args)` as the callee here means
      // `arg` itself IS `x.method(args)` (e.g. the receiver of an outer
      // `.and_then(...)` in `x.and_then(f).and_then(g)`, or a `let`-bound
      // `let b = x.and_then(f)` whose type feeds a later `b.is_ok()`). Without
      // this case the match fell through to `_ => None`, so the result type of
      // ANY UFCS call went untracked -- the EDot call-position rewrite below
      // (see the `as_recv_method` match on `EDot(obj, m, ...)`) then can't
      // infer the OUTER call's receiver type either, leaves the outer
      // `.method(...)` as a bare EDot, and codegen's EDot fallback (which only
      // understands genuine struct-field projections) throws "unknown struct
      // field: <method>" even though the checker -- which performs proper
      // type-directed `T::method` resolution independently in checker.vibe's
      // `EDot(obj, method, ...)` arm -- already accepted the same expression
      // as type-correct. Mirror that checker resolution here: infer the
      // receiver's type, then look up the qualified `Type::method` return
      // type, falling back to the bare method name (prelude functions like
      // `Result::and_then` / `and_then` register both forms in `fn_returns`).
      EDot(dobj, dmethod, _, _) => {
        let recv_tn = infer_arg_type_name(dobj, struct_sets, var_types, fn_returns)
        let qual_rt = match recv_tn {
          Some(tn) => fn_return_type(fn_returns, String::concat(tn, String::concat("::", dmethod))),
          None => None
        }
        match qual_rt {
          Some(rt) => Some(rt),
          None => fn_return_type(fn_returns, dmethod)
        }
      },
      _ => None
    },
    ERecord(_, fields, _) => {
      let names = empty_str_array()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, _) = Array::get(fields, i)
        Array::push(names, fname)
        i = i + 1
      }
      let mut j = 0
      let mut result = None
      while j < Array::length(struct_sets) {
        let (sname, sfields) = Array::get(struct_sets, j)
        if field_sets_match(names, sfields) {
          result = Some(sname)
          j = Array::length(struct_sets)
        } else {
          j = j + 1
        }
      }
      result
    },
    _ => None
  }
}

/// #973: known concrete/struct-like type names `infer_arg_type_name` can
/// report, for which the EXISTING per-type rewrites (String concat/relational,
/// struct `==`, Option/Result structural eq, ...) already apply, or correctly
/// do not. Anything else it returns `Some` for is, by construction, the bare
/// name of an in-scope generic type parameter: `seed_var_types` (and the `EFn`
/// arm of `rewrite_expr`) seed a parameter's own `[T]` annotation verbatim as
/// its "type name" — see #931's `as_tparam_dict`, which reuses the same
/// inference for method calls — and no other path in `infer_arg_type_name`
/// produces a non-concrete `Some`.
fn is_concrete_or_known_type_name(t: String, struct_sets: Array[(String, Array[String])]) -> Bool {
  t == "Int" || t == "Bool" || t == "String" || t == "Double" || t == "Float" || t == "Array" || t == "Map" || t == "Option" || t == "Result" || t == "Stream" || struct_set_has(struct_sets, t)
}

/// #973: does either operand's inferred static type look like an ERASED
/// generic type parameter (`[T: Ord]` / `[T: Add]`) rather than a concrete
/// type `infer_arg_type_name` already has type-specific handling for? Routes
/// `<`/`>`/`<=`/`>=`/`+` through a runtime tag-check dispatch instead of the
/// hardcoded numeric binop when the checker (#952) lets a bound-but-unresolved
/// `T` survive to codegen with NO monomorphization and NO witness dict — Ord
/// and Add are method-less marker traits (`export trait Ord` with an empty
/// body; see builtin_traits.vibe), so `build_gens` never threads either one a
/// dict (only method-bearing bounds get one), leaving nothing concrete to key
/// a String-vs-Int rewrite off at this site. Without this, `x < lo` inside a
/// `fn ord_clamp[T: Ord](x: T, lo: T, ..)` body compiled a raw signed i64
/// compare, which orders a heap String's packed `(ptr<<32)|len` value by
/// POINTER, not content (#973's `ord_clamp("m", "a", "z")` repro).
fn is_erased_generic_operand(l: Expr, r: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Bool {
  let lg = match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {
    Some(t) => !is_concrete_or_known_type_name(t, struct_sets),
    None => false
  }
  let rg = match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {
    Some(t) => !is_concrete_or_known_type_name(t, struct_sets),
    None => false
  }
  lg || rg
}

/// #760(3): `m[k]` parses to `__index(m, k)`, whose codegen array-indexes the
/// receiver — on a Map that reads its backing store as a positional array and
/// traps. Rewrite to `Map::get(m, k)` ONLY when the receiver is determinably
/// Map-typed (a `map { }` literal, or a binding/param annotated `Map[..]`,
/// which `infer_arg_type_name` reports as "Map"). A non-Map receiver — an
/// Array/Bytes/String, or an unknown — is left as `__index`, so array indexing
/// (and the type checker's rejection of e.g. `a["x"]` on an Array) is unchanged.
/// `rwargs` are the already-rewritten arguments to carry into the new call.
fn map_index_rewrite(callee: Expr, args: Array[Expr], rwargs: Array[Expr], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[Expr] {
  match callee {
    EIdent(nm, _) => if nm == "__index" && Array::length(args) == 2 {
      let recv_map = match infer_arg_type_name(Array::get(args, 0), struct_sets, var_types, fn_returns) {
        Some(t) => t == "Map",
        None => false
      }
      if recv_map {
        Some(ECall(EIdent("Map::get", -1), rwargs, -1))
      } else {
        None
      }
    } else {
      None
    },
    _ => None
  }
}

/// #760(4): anonymous-record dot access `r.name`. A `record { .. }` literal whose
/// field-set matches NO declared struct is stored in LITERAL field order with tag
/// 0 (see compile_expr_tail4 ERecord); its `.field` reads reach codegen's EDot,
/// which resolves the slot only through declared structs (`struct_field_candidates`)
/// and therefore throws "unknown struct field". The record-pattern destructure
/// (`let record { name: n } = r`) already works because the parser lowers it to
/// positional `__rec_field(r, i)` reads (parser_expr_dispatch). This mirrors that:
/// we thread each anonymous-record binding's ordered field list through `var_types`
/// (as a `__anonrec:` sentinel) and rewrite `binding.field` to the same
/// `__rec_field(binding, slot)` positional read. A struct-matching record is left
/// alone — its literal is reordered to the struct's declared order and the EDot
/// struct-tag-dispatch path resolves it correctly.
fn anon_record_prefix() -> String {
  "__anonrec:"
}

/// Encode an ordered field-name list as a `var_types` sentinel value.
fn anon_record_sentinel(names: Array[String]) -> String {
  let mut s = anon_record_prefix()
  let mut i = 0
  while i < Array::length(names) {
    if i > 0 {
      s = String::concat(s, ",")
    } else {
      ()
    }
    s = String::concat(s, Array::get(names, i))
    i = i + 1
  }
  s
}

/// The slot of `field` within a `__anonrec:` sentinel, or -1 if the string is not
/// a sentinel or does not carry `field`. Splits on `,` so a field name that is a
/// prefix of another (e.g. `ver` vs `version`) does not false-match.
fn anon_field_index(sentinel: String, field: String) -> Int {
  let prefix = anon_record_prefix()
  if !String::starts_with(sentinel, prefix) {
    -1
  } else {
    let mut rest = String::substring(sentinel, String::length(prefix), String::length(sentinel))
    let mut idx = 0
    let mut found = -1
    let mut go = true
    while go {
      let comma = String::index_of(rest, ",")
      let tok = if comma < 0 {
        rest
      } else {
        String::substring(rest, 0, comma)
      }
      if tok == field {
        found = idx
        go = false
      } else if comma < 0 {
        go = false
      } else {
        rest = String::substring(rest, comma + 1, String::length(rest))
        idx = idx + 1
      }
    }
    found
  }
}

/// If `val` is a `record { .. }` literal whose field-set matches no declared
/// struct, the `__anonrec:` sentinel recording its literal field order; else None.
/// Threaded into `var_types` at `let`/`let mut` so a later `binding.field` on the
/// same name resolves positionally.
fn anon_record_inferred(val: Expr, struct_sets: Array[(String, Array[String])]) -> Option[String] {
  match val {
    ERecord(_, fields, _) => {
      let names = empty_str_array()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, _) = Array::get(fields, i)
        Array::push(names, fname)
        i = i + 1
      }
      let mut j = 0
      let mut matched = false
      while j < Array::length(struct_sets) {
        let (_, sfields) = Array::get(struct_sets, j)
        if field_sets_match(names, sfields) {
          matched = true
          j = Array::length(struct_sets)
        } else {
          j = j + 1
        }
      }
      if matched {
        None
      } else {
        Some(anon_record_sentinel(names))
      }
    },
    _ => None
  }
}

/// Prefer the anonymous-record sentinel for a `let` value, falling back to the
/// ordinary type inference used for trait dispatch / `==` / the Map-index rewrite.
fn anon_or_infer(val: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match anon_record_inferred(val, struct_sets) {
    Some(s) => Some(s),
    None => infer_arg_type_name(val, struct_sets, var_types, fn_returns)
  }
}

/// `binding.field` -> `__rec_field(binding, slot)` when `binding` is an
/// anonymous-record binding (a `__anonrec:` var_types entry) that carries `field`.
/// `robj` is the already-rewritten receiver. None leaves the EDot untouched (a
/// declared-struct field, a tuple index, or an unknown receiver).
fn anon_dot_rewrite(obj: Expr, field: String, off: Int, robj: Expr, var_types: Array[(String, String)]) -> Option[Expr] {
  match obj {
    EIdent(vn, _) => match lookup_var_type(var_types, vn) {
      Some(t) => {
        let idx = anon_field_index(t, field)
        if idx >= 0 {
          Some(ECall(EIdent("__rec_field", off), [
            robj,
            EInt(idx)
          ], off))
        } else {
          None
        }
      },
      None => None
    },
    _ => None
  }
}

/// The hidden bounds threaded into a generic: (type-param, trait, receiver
/// parameter index). Empty registry sentinel for arrays of these.
fn empty_threaded() -> Array[(String, String, Int)] {
  array_empty()
}

fn empty_dict_binds() -> Array[(String, String, String, Array[String])] {
  array_empty()
}

/// A function already carries a threaded dict parameter (idempotency guard
/// against desugaring the same stmts twice while bounds are still present).
fn already_threaded(params: Array[(String, Option[TypeExpr])]) -> Bool {
  if Array::length(params) == 0 {
    false
  } else {
    let (pname, _) = Array::get(params, 0)
    String::starts_with(pname, "__dict_")
  }
}

/// Index of the first parameter whose annotation is exactly the type parameter
/// `tp` (`x: T`). -1 when `T` does not appear directly as a parameter type.
fn find_recv_index(params: Array[(String, Option[TypeExpr])], tp: String) -> Int {
  let mut i = 0
  let mut idx = -1
  while i < Array::length(params) {
    let (_, ann) = Array::get(params, i)
    match ann {
      Some(TyName(n)) => if n == tp {
        idx = i
        i = Array::length(params)
      } else {
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  idx
}

/// #1199 bug 1: index of the first parameter whose annotation is `Array[tp]`
/// (`x: Array[T]`) -- the sibling of find_recv_index for a type param that
/// appears as an Array's element rather than directly. -1 when `T` doesn't
/// appear that way either. build_gens tries this ONLY after find_recv_index
/// fails, so a function with BOTH a direct `x: T` param and an `xs: Array[T]`
/// param keeps preferring the direct (cheaper, unambiguous) receiver.
fn find_array_elem_recv_index(params: Array[(String, Option[TypeExpr])], tp: String) -> Int {
  let mut i = 0
  let mut idx = -1
  while i < Array::length(params) {
    let (_, ann) = Array::get(params, i)
    match ann {
      Some(TyApp("Array", targs)) => if Array::length(targs) == 1 {
        match Array::get(targs, 0) {
          TyName(n) => if n == tp {
            idx = i
            i = Array::length(params)
          } else {
            i = i + 1
          },
          _ => {
            i = i + 1
          }
        }
      } else {
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  idx
}

/// #1199 bug 1: `threaded`'s recv_idx field packs TWO distinct receiver kinds
/// into one Int rather than widening the tuple everywhere it's threaded
/// (9 call sites across this file): `idx >= 0` is a DIRECT receiver
/// (`x: T`, unchanged, existing behavior) and `idx <= -2` is an
/// ARRAY-ELEMENT receiver (`xs: Array[T]`) with the real param index encoded
/// as `-idx - 2` (index 0 -> -2, 1 -> -3, ...) -- -1 stays reserved for the
/// pre-existing "no inferable receiver, dict supplied via a generic-impl
/// witness" sentinel (build_gens' gimpl_types branch). Only synth_dicts
/// (the sole recv_idx consumer that reads more than the trait name) needs
/// to decode this.
fn encode_array_elem_recv_index(idx: Int) -> Int {
  0 - idx - 2
}

fn is_array_elem_recv_index(idx: Int) -> Bool {
  idx <= (0 - 2)
}

fn decode_array_elem_recv_index(idx: Int) -> Int {
  0 - idx - 2
}

/// Build the registry of top-level generics that need dictionary threading:
/// each is a (function name, threaded-bounds) pair. A bound is threaded only
/// when its trait is method-bearing and the type parameter appears directly as
/// a parameter type.
/// The type-constructor head of a qualified name (`Array::show2` -> "Array"),
/// or "" if unqualified.
fn qualified_head(name: String) -> String {
  match split_qualified(name) {
    Some(parts) => {
      let (head, _) = parts
      head
    },
    None => ""
  }
}

/// Type names of bounded generic impls (`impl [T: Bound] Trait for C`). Their
/// methods (`C::m`) carry the bound `T` even though it appears nested in the
/// receiver (`self: C[T]`), so they must be threaded a witness dict (the normal
/// "type param is a direct parameter" rule misses them).
fn collect_generic_impl_types(stmts: Array[Stmt]) -> Array[String] {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImpl(tparams, tbounds, _, type_name) => if Array::length(tparams) > 0 {
        let mut has_bound = false
        let mut bi = 0
        while bi < Array::length(tbounds) {
          let (_, bs) = Array::get(tbounds, bi)
          let mut bj = 0
          while bj < Array::length(bs) {
            if Array::get(bs, bj) != "" {
              has_bound = true
            } else {
              ()
            }
            bj = bj + 1
          }
          bi = bi + 1
        }
        if has_bound {
          Array::push(out, type_name)
        } else {
          ()
        }
      } else (),
      _ => ()
    }
    i = i + 1
  }
  out
}

fn build_gens(stmts: Array[Stmt], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], gimpl_types: Array[String]) -> Array[(String, Array[(String, String, Int)])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(_, bounds, params, _, _, _) => if already_threaded(params) {
          ()
        } else {
          let threaded = empty_threaded()
          let mut bi = 0
          while bi < Array::length(bounds) {
            let (tp, trait_list) = Array::get(bounds, bi)
            let mut ti = 0
            while ti < Array::length(trait_list) {
              let tr = Array::get(trait_list, ti)
              match lookup_trait_sigs(traits, tr) {
                Some(_) => {
                  let ridx = find_recv_index(params, tp)
                  if ridx >= 0 {
                    Array::push(threaded, (tp, tr, ridx))
                  } else if str_array_contains(gimpl_types, qualified_head(fname)) {
                    // bounded generic-impl method: T is nested in `self: C[T]`,
                    // so there is no inferable receiver argument — the witness
                    // dict is supplied when C's witness is built. Thread with -1.
                    Array::push(threaded, (tp, tr, 0 - 1))
                  } else {
                    // #1199 bug 1: T may still appear, just wrapped one level
                    // in an `Array[T]` param (`fn f[T: Hash](xs: Array[T])`)
                    // rather than bare `x: T` -- find_recv_index alone missed
                    // this, so f was silently left un-threaded: no dict param
                    // on its own signature, `no_binds` for its body (see
                    // rewrite_stmt's `lookup_gen` miss), and any Hash-bounded
                    // call inside f on a value pulled out of `xs` had no dict
                    // to forward, however it was written -- synth_dicts fails
                    // and the call site was emitted short its dict arg
                    // (invalid wasm), not merely "less generic than it could
                    // be" as the direct-receiver miss would read.
                    let widx = find_array_elem_recv_index(params, tp)
                    if widx >= 0 {
                      Array::push(threaded, (tp, tr, encode_array_elem_recv_index(widx)))
                    } else {
                      ()
                    }
                  }
                },
                None => ()
              }
              ti = ti + 1
            }
            bi = bi + 1
          }
          if Array::length(threaded) > 0 {
            Array::push(out, (fname, threaded))
          } else {
            ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

fn lookup_gen(gens: Array[(String, Array[(String, String, Int)])], name: String) -> Option[Array[(String, String, Int)]] {
  let mut i = 0
  let mut result = None
  while i < Array::length(gens) {
    let (gname, threaded) = Array::get(gens, i)
    if gname == name {
      result = Some(threaded)
      i = Array::length(gens)
    } else {
      i = i + 1
    }
  }
  result
}

/// Find the dict parameter to dispatch a `head::member` call against, given the
/// dict bindings in scope: the binding whose type-param is `head` and whose
/// trait declares `member`.
fn find_dict_for_method(dict_binds: Array[(String, String, String, Array[String])], head: String, member: String) -> Option[String] {
  let mut i = 0
  let mut result = None
  while i < Array::length(dict_binds) {
    let (tp, _, dict_pname, methods) = Array::get(dict_binds, i)
    if tp == head && str_array_contains(methods, member) {
      result = Some(dict_pname)
      i = Array::length(dict_binds)
    } else {
      i = i + 1
    }
  }
  result
}

/// Find the in-scope dict parameter bound to type-param `tparam` for `trait_name`
/// (used to forward a caller's own witness into a generic->generic call).
fn find_dict_for_trait(dict_binds: Array[(String, String, String, Array[String])], tparam: String, trait_name: String) -> Option[String] {
  let mut i = 0
  let mut result = None
  while i < Array::length(dict_binds) {
    let (tp, tr, dict_pname, _) = Array::get(dict_binds, i)
    if tp == tparam && tr == trait_name {
      result = Some(dict_pname)
      i = Array::length(dict_binds)
    } else {
      i = i + 1
    }
  }
  result
}

/// The first element of an array-literal receiver (for a bounded generic impl
/// `impl [T: Bound] Trait for Array`, the element determines T's witness).
fn first_array_elem(e: Expr) -> Option[Expr] {
  match e {
    EArray(elems) => if Array::length(elems) > 0 {
      Some(Array::get(elems, 0))
    } else None,
    _ => None
  }
}

/// Build the witness `ERecord` for a concrete type `cname` implementing
/// `trait_name`. Codegen resolves it to the dict struct structurally by field
/// names.
///
/// For a plain impl each method field is the free function `C::method`. For a
/// BOUNDED generic impl (`impl [T: Bound] Trait for C`) the method
/// `C::method` was threaded to take its own `Bound` dictionary for the element
/// type, so the field is instead a closure that supplies that nested dictionary:
///   { method: (__w) -> C::method(<element Bound dict>, __w) }
/// The element dict is built recursively from the array literal's first element
/// (`arg_expr`) — a dictionary-of-dictionaries (#5 Increment B). If the element
/// type / dict cannot be determined the whole witness fails to build (returns
/// None), so the call is left unrewritten (a loud arity error, never a silent
/// miscompile).
fn build_concrete_dict(cname: String, trait_name: String, traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], gens: Array[(String, Array[(String, String, Int)])], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)], arg_expr: Expr) -> Option[Expr] {
  match lookup_trait_sigs(traits, trait_name) {
    Some(sigs) => {
      let mnames = method_names_of_sigs(sigs)
      let recfields = array_empty()
      let mut mi = 0
      let mut failed = false
      while mi < Array::length(mnames) {
        let m = Array::get(mnames, mi)
        let qm = String::concat(cname, String::concat("::", m))
        if not(fn_exists(fn_returns, qm)) {
          // No `cname::m` free function exists — `cname` does not actually
          // implement `trait_name`. Refuse to fabricate a witness (which would
          // otherwise silently dispatch to a same-shaped function), so the call
          // is left unrewritten and fails loudly instead of miscompiling.
          failed = true
        } else {
          match lookup_gen(gens, qm) {
            Some(threaded) => {
              // `qm` is a bounded generic-impl method: supply its element dict(s).
              match first_array_elem(arg_expr) {
                Some(elem) => match infer_arg_type_name(elem, struct_sets, var_types, fn_returns) {
                  Some(en) => {
                    let callargs = empty_expr_array()
                    let mut bi = 0
                    let mut subok = true
                    while bi < Array::length(threaded) {
                      let (_, btrait, _) = Array::get(threaded, bi)
                      match build_concrete_dict(en, btrait, traits, gens, struct_sets, var_types, fn_returns, elem) {
                        Some(sd) => Array::push(callargs, sd),
                        None => {
                          subok = false
                        }
                      }
                      bi = bi + 1
                    }
                    if subok {
                      Array::push(callargs, EIdent("__w", -1))
                      let closure = EFn(empty_str_array(), array_empty(), Array::slice([
                        ("__w", None)
                      ], 0, 1), None, None, ECall(EIdent(qm, -1), callargs, -1))
                      Array::push(recfields, (m, closure))
                    } else {
                      failed = true
                    }
                  },
                  None => {
                    failed = true
                  }
                },
                None => {
                  failed = true
                }
              }
            },
            None => Array::push(recfields, (m, EIdent(qm, -1)))
          }
        }
        mi = mi + 1
      }
      if failed {
        None
      } else {
        Some(ERecord("", recfields, empty_ty_args()))
      }
    },
    None => None
  }
}

/// Synthesize the witness dictionaries for a call to a transformed generic, or
/// #1199 bug 1: the call-site counterpart of array_elem_type_of, for an
/// ARRAY-ELEMENT receiver (see encode_array_elem_recv_index) whose call-site
/// argument expression is the array itself, not a plain identifier already
/// carrying a recorded element type. Handles the two shapes that actually
/// occur at a call site: a variable naming an Array-typed parameter
/// (array_elem_type_of's existing sentinel lookup), or an inline array
/// literal (infer the element type from its own first element — an empty
/// literal has nothing to infer FROM and is left unresolved, same
/// conservative stance as every other best-effort case in this file).
fn infer_arg_elem_type_name(arg: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match arg {
    EIdent(name, _) => array_elem_type_of(var_types, name),
    EArray(elems) => if Array::length(elems) > 0 {
      infer_arg_type_name(Array::get(elems, 0), struct_sets, var_types, fn_returns)
    } else {
      None
    },
    _ => None
  }
}

/// None when any receiver's witness cannot be determined (the call is then left
/// unrewritten). Each bound is satisfied either by a concrete dict literal (the
/// receiver type is syntactically known) or by forwarding the caller's own dict
/// parameter (the receiver is a type parameter bound by the same trait in the
/// enclosing generic — the generic->generic case).
fn synth_dicts(threaded: Array[(String, String, Int)], orig_args: Array[Expr], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], dict_binds: Array[(String, String, String, Array[String])], fn_returns: Array[(String, String)], gens: Array[(String, Array[(String, String, Int)])]) -> Option[Array[Expr]] {
  let dicts = empty_expr_array()
  let mut ok = true
  let mut bi = 0
  while bi < Array::length(threaded) {
    let (_, trait_name, recv_idx_raw) = Array::get(threaded, bi)
    // #1199 bug 1: decode the packed receiver kind (see
    // encode_array_elem_recv_index's doc comment) once, up front, so the rest
    // of this loop body works from a plain non-negative index + the right
    // inference function either way.
    let is_elem_recv = is_array_elem_recv_index(recv_idx_raw)
    let recv_idx = if is_elem_recv {
      decode_array_elem_recv_index(recv_idx_raw)
    } else {
      recv_idx_raw
    }
    if ok && recv_idx >= 0 && recv_idx < Array::length(orig_args) {
      let recv_arg = Array::get(orig_args, recv_idx)
      let inferred = if is_elem_recv {
        infer_arg_elem_type_name(recv_arg, struct_sets, var_types, fn_returns)
      } else {
        infer_arg_type_name(recv_arg, struct_sets, var_types, fn_returns)
      }
      match inferred {
        Some(nm) => match find_dict_for_trait(dict_binds, nm, trait_name) {
          Some(dict_pname) => Array::push(dicts, EIdent(dict_pname, -1)),
          None => match build_concrete_dict(nm, trait_name, traits, gens, struct_sets, var_types, fn_returns, recv_arg) {
            Some(dict) => Array::push(dicts, dict),
            None => {
              ok = false
            }
          }
        },
        None => {
          ok = false
        }
      }
    } else {
      ok = false
    }
    bi = bi + 1
  }
  if ok {
    Some(dicts)
  } else {
    None
  }
}

fn concat_expr_arrays(a: Array[Expr], b: Array[Expr]) -> Array[Expr] {
  let out = empty_expr_array()
  let mut i = 0
  while i < Array::length(a) {
    Array::push(out, Array::get(a, i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(b) {
    Array::push(out, Array::get(b, j))
    j = j + 1
  }
  out
}

/// #1199 bug 1: sentinel key prefix recording a parameter's ARRAY ELEMENT type,
/// keyed off the parameter name so `array_elem_type_of` below can recover it
/// without a second table threaded through every caller. Reuses the existing
/// `var_types: Array[(String, String)]` association list -- same trick as the
/// anonymous-record `__anonrec:` sentinel (anon_record_prefix above): a
/// synthetic KEY (not value) that no real source identifier can collide with,
/// since `$` isn't a valid identifier character.
fn array_elem_key(pname: String) -> String {
  String::concat("__arrelem$", pname)
}

/// #1199 bug 1: look up the element type recorded for an Array-typed variable
/// by `seed_var_types` (function parameters) or `array_elem_bind` (let-bound
/// array literals).
fn array_elem_type_of(var_types: Array[(String, String)], name: String) -> Option[String] {
  lookup_var_type(var_types, array_elem_key(name))
}

/// #1199 follow-up (Codex review on the original fix): the let-bound sibling
/// of `seed_var_types`' Array[T]-parameter element tracking. Without this,
/// `let xs = [1, 2]; Set::from_array(xs)` left `xs`'s element type
/// unrecoverable at the call site -- `extend_var_types` only records the
/// coarse "Array" head (via `infer_arg_type_name`'s `EArray(_) => Some
/// ("Array")` case), so `infer_arg_elem_type_name`'s `EIdent` arm had nothing
/// to look up, `synth_dicts` failed, and the call was emitted without its
/// Hash dict argument(s) -- invalid wasm, the same failure shape bug 1's
/// `Array::get` case had. Only a bare (unannotated) array literal RHS with a
/// syntactically inferable first-element type is handled here, matching the
/// rest of this file's syntax-directed (not full type-inference) approach;
/// an empty literal (`let xs = []`) or an already-Array-typed variable RHS
/// stays untracked -- recovering those needs the RHS's *expected* type
/// flowing in from an enclosing annotation, which this bottom-up pass does
/// not thread.
fn array_elem_bind(var_types: Array[(String, String)], name: String, val: Expr, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Array[(String, String)] {
  match val {
    EArray(elems) => if Array::length(elems) > 0 {
      match infer_arg_type_name(Array::get(elems, 0), struct_sets, var_types, fn_returns) {
        Some(elemty) => {
          let out = array_empty()
          let mut i = 0
          while i < Array::length(var_types) {
            Array::push(out, Array::get(var_types, i))
            i = i + 1
          }
          Array::push(out, (array_elem_key(name), elemty))
          out
        },
        None => var_types
      }
    } else {
      var_types
    },
    _ => var_types
  }
}

/// Seed a var-type environment from a function's parameters whose annotation is
/// a bare type name `T` — concrete (`Point`) for call-site dict synthesis, or a
/// type parameter (`T`) for generic->generic dict forwarding. The distinction is
/// made at use time against the in-scope dict bindings. `tparams` is retained for
/// signature compatibility but no longer filters (both kinds are tracked).
fn seed_var_types(params: Array[(String, Option[TypeExpr])], tparams: Array[String], base: Array[(String, String)]) -> Array[(String, String)] {
  let _ = tparams
  let out = array_empty()
  let mut b = 0
  while b < Array::length(base) {
    Array::push(out, Array::get(base, b))
    b = b + 1
  }
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ann) = Array::get(params, i)
    match ann {
      Some(TyName(tn)) => Array::push(out, (pname, tn)),
      // A generic struct annotation `x: LazyIter[T]` -> track the head name so
      // `for x in <param>` over a generic iterator type resolves (#636).
      // #1199 bug 1: for `x: Array[T]` specifically, ALSO record T under the
      // array_elem_key sentinel -- without it, `Array::get(x, i)` /
      // `x[i]` has no recorded type (infer_arg_type_name has nothing to look
      // up), so a downstream `[K: Hash]`-bounded call fed that value can't
      // resolve or forward a witness dictionary and synth_dicts fails,
      // silently emitting a call short the dict argument(s) -- invalid wasm
      // ("not enough arguments on the stack"), not a compile error. Only the
      // single-bare-type-arg shape is handled (matches every other bare-name
      // inference in this file); nested/nested-generic element types are
      // left untracked, same conservative scope as the rest of
      // infer_arg_type_name.
      Some(TyApp(tn, targs)) => {
        Array::push(out, (pname, tn))
        if tn == "Array" && Array::length(targs) == 1 {
          match Array::get(targs, 0) {
            TyName(elem) => Array::push(out, (array_elem_key(pname), elem)),
            _ => ()
          }
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Collect the return-type name of every top-level `let f = (..) -> R { .. }`
/// (R only when it is a bare type name), so the `for` desugar can tell an
/// iterator (`C::next` exists) from an iterable (`C::iter` returns an iterator).
/// The tail expression a function body evaluates to, walking the binding
/// spine (`let` / `let mut` / `letrec` / sequencing) to its final position.
/// Used to infer a return head when the annotation is omitted.
fn fn_body_tail_expr(e: Expr) -> Expr {
  match e {
    ELet(_, _, rest, _) => fn_body_tail_expr(rest),
    ELetMut(_, _, rest, _) => fn_body_tail_expr(rest),
    ELetRec(_, _, rest) => fn_body_tail_expr(rest),
    ESeq(_, rest) => fn_body_tail_expr(rest),
    other => other
  }
}

/// Record the head name of a function's return type: `TyName(n)` -> n,
/// `TyApp(n, _)` -> n (so a generic `iter() -> LazyIter[T]` resolves to
/// `LazyIter`, and an async `next() -> Future[Option[..]]` resolves to
/// `Future` so the for-loop desugar can tell async from sync).
///
/// #1350 (Codex P1, twice): a FUNCTION-typed return gets its own head
/// sentinel instead of collapsing into the empty "unknown" head, because
/// `for x in f()` may only classify as a pull-closure loop when `f`
/// positively returns a function -- otherwise an unannotated
/// `let values = () -> { [40, 2] }` is indistinguishable from
/// `stdin_stream : (Int) -> (() -> Option[String])` and the array gets
/// called as a closure (call_indirect trap).
///
/// When the annotation is OMITTED the head is inferred from the body's tail
/// expression: a body that evaluates to a lambda is a closure factory, so it
/// gets the same sentinel. Without this, tightening the annotated case alone
/// just moved the trap to the other side -- an unannotated
/// `let make_pull = () -> { () -> { .. } }` lost its pull loop and iterated a
/// function value as an array. Only the lambda shape is inferred; every other
/// tail keeps the empty head, so nothing that used to classify by NAME
/// changes. fn_return_type maps the sentinel to None, so every consumer that
/// reads type NAMES sees exactly what it saw before.
fn fn_return_head_of(ret: Option[TypeExpr], body: Expr) -> String {
  match ret {
    Some(te) => match te {
      TyName(n) => n,
      TyApp(n, _) => n,
      TyFn(_, _, _) => fn_type_return_head(),
      _ => ""
    },
    None => match fn_body_tail_expr(body) {
      EFn(_, _, _, _, _, _) => fn_type_return_head(),
      _ => ""
    }
  }
}

/// #1341 (Codex P1 on #1369): the key under which a struct FIELD's declared
/// type head rides in the fn_returns table. `.` cannot appear in a vibe
/// binding or function name (qualified names use `::`), so this can never
/// collide with a real entry -- the same reserved-key trick array_elem_key
/// already uses for var_types.
///
/// fn_returns is threaded through every infer_arg_type_name caller already,
/// and struct_sets carries field NAMES only, so this is the cheapest place to
/// put field types without adding a parameter to a dozen signatures.
fn struct_field_type_key(struct_name: String, field: String) -> String {
  String::concat(struct_name, String::concat(".", field))
}

/// (`Holder.s` -> `HostStream`) for every declared struct field whose
/// annotation has a head name. Appended to fn_returns so `infer_arg_type_name`
/// can type a projection (`h.s`).
fn collect_struct_field_types(stmts: Array[Stmt], out: Array[(String, String)]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, fields, _, _, _) => {
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, fty) = Array::get(fields, j)
          let head = match fty {
            TyName(n) => n,
            TyApp(n, _) => n,
            _ => ""
          }
          if String::length(head) > 0 {
            Array::push(out, (struct_field_type_key(sname, fname), head))
          } else {
            ()
          }
          j = j + 1
        }
      },
      SModule(_, _, inner) => collect_struct_field_types(inner, out),
      _ => ()
    }
    i = i + 1
  }
}

fn collect_fn_returns(stmts: Array[Stmt]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(_, _, _, ret, _, fbody) => {
          Array::push(out, (fname, fn_return_head_of(ret, fbody)))
        },
        _ => ()
      },
      // `fn name(..) -> R { .. }` declares parse to SFnDecl, not SLet (see
      // parse_fn_stmt_general) -- without this case every `fn`-declared
      // function (the more common spelling) was invisible here, silently
      // missing from the `for`/async-vs-sync desugar and other fn_returns
      // consumers below.
      SFnDecl(_, fname, body, _, _) => match body {
        EFn(_, _, _, ret, _, fbody) => {
          Array::push(out, (fname, fn_return_head_of(ret, fbody)))
        },
        _ => ()
      },
      // #672: map each enum variant constructor to its enum name, so a
      // `let t = Node(...)` binding resolves `t`'s type for the `==` dispatch
      // (infer_arg_type_name reads ctor calls through fn_returns).
      SEnum(_, ename, _, variants, _) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, _) = Array::get(variants, vi)
          Array::push(out, (vname, ename))
          vi = vi + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  // #1341: struct FIELD type heads ride along under the reserved
  // `Struct.field` key (struct_field_type_key). Must be pushed BEFORE the
  // sort below -- fn_exists/fn_return_type binary-search this table, so an
  // entry appended afterwards would be invisible. (That is exactly how the
  // first cut of this failed: the seeding call landed in a different
  // collector whose result is not what infer_arg_type_name reads.)
  collect_struct_field_types(stmts, out)
  // Perf: this table holds every top-level fn + enum variant of the merged
  // compile (thousands of entries) and fn_exists/fn_return_type consulted it
  // LINEARLY per expression during the rewrite. Sort once (STABLE, so the
  // leftmost duplicate stays the linear scan's "first match") and let the
  // helpers below binary-search. Nothing outside those helpers reads the
  // table positionally, so the order change is invisible.
  let names = array_empty()
  let mut ni = 0
  while ni < Array::length(out) {
    let (n, _) = Array::get(out, ni)
    Array::push(names, n)
    ni = ni + 1
  }
  let perm = sort_perm_by_names(names)
  let sorted = array_empty()
  let mut pi = 0
  while pi < Array::length(perm) {
    Array::push(sorted, Array::get(out, Array::get(perm, pi)))
    pi = pi + 1
  }
  sorted
}

/// Leftmost binary search over the SORTED fn_returns table (see
/// collect_fn_returns). Leftmost-of-run preserves first-match-wins for
/// duplicate names.
fn fn_returns_find(fn_returns: Array[(String, String)], fname: String) -> Int {
  let mut lo = 0
  let mut hi = Array::length(fn_returns)
  while lo < hi {
    let mid = (lo + hi) / 2
    let (n, _) = Array::get(fn_returns, mid)
    if str_lt(n, fname) {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  let mut res = -1
  if lo < Array::length(fn_returns) {
    let (n2, _) = Array::get(fn_returns, lo)
    if n2 == fname {
      res = lo
    }
  }
  res
}

fn fn_exists(fn_returns: Array[(String, String)], fname: String) -> Bool {
  fn_returns_find(fn_returns, fname) >= 0
}

/// #1350 (Codex P1): the recorded return-type head for a FUNCTION-typed
/// return. Not a legal type name, so it can never collide with a real head.
/// Only fn_return_is_fn_type reads it; fn_return_type maps it to None so the
/// type-name consumers (infer_arg_type_name and everything downstream of it)
/// behave exactly as they did when function returns had an empty head.
fn fn_type_return_head() -> String {
  "->"
}

fn fn_return_type(fn_returns: Array[(String, String)], fname: String) -> Option[String] {
  let idx = fn_returns_find(fn_returns, fname)
  if idx < 0 {
    None
  } else {
    let (_, rt) = Array::get(fn_returns, idx)
    if String::length(rt) == 0 || rt == fn_type_return_head() {
      None
    } else {
      Some(rt)
    }
  }
}

/// Does `fname` positively RETURN A FUNCTION (an annotated function type)?
/// This is the pull-closure classification's real question -- distinct from
/// "the return annotation was omitted", which records an empty head.
fn fn_return_is_fn_type(fn_returns: Array[(String, String)], fname: String) -> Bool {
  let idx = fn_returns_find(fn_returns, fname)
  if idx < 0 {
    false
  } else {
    let (_, rt) = Array::get(fn_returns, idx)
    rt == fn_type_return_head()
  }
}

/// Desugar `for x in it { body }` over a struct iterator type `C` into a loop
/// driven by the functional `C::next(self) -> Option[(T, Self)]`:
///
///   let mut __iter_cur = it
///   let mut __iter_go = true
///   while __iter_go {
///     match C::next(__iter_cur) {
///       Some((x, __iter_rest)) => { __iter_cur = __iter_rest; body },
///       None => { __iter_go = false }
///     }
///   }
///
/// Nested loops shadow the `__iter_*` names correctly (ELetMut scoping). The
/// optional index binding is not supported for iterators (first slice).
///
/// `nextcall` is the expression yielding `Option[(T, Self)]` for the current
/// cursor `__iter_cur`: a bare `C::next(__iter_cur)` for a sync iterator, or
/// `await(C::next(__iter_cur))` (a `Future[Option[(T, Self)]]` unwrapped) for an
/// async iterator under `for`.
fn build_iter_for_with(name: String, nextcall: Expr, iter: Expr, body: Expr) -> Expr {
  let some_arm = (PCtor("Some", [
    PTuple([
      PBind(name),
      PBind("__iter_rest")
    ])
  ]), EAssign("__iter_cur", EIdent("__iter_rest", -1), body))
  let none_arm = (PCtor("None", array_empty()), EAssign("__iter_go", EBool(false), EUnit))
  let loop_body = EMatch(nextcall, [
    some_arm,
    none_arm
  ])
  // Bind the iterand through an immutable `__iter_src` and initialize the
  // mutable cursor from that ident, rather than from `iter` directly. The
  // cursor is consumed by `C::next(__iter_cur)` and then reassigned each
  // iteration; initializing it from a fresh heap value (e.g. a struct literal
  // `for x in Range::{..}`) made that consume-then-reassign double-free the
  // initial value under RC. Seeding from a stable binding mirrors the working
  // `let r = ..; for x in r` shape so the ownership accounting balances (#704).
  ELet("__iter_src", iter, ELetMut("__iter_cur", EIdent("__iter_src", -1), ELetMut("__iter_go", EBool(true), EWhile(EIdent("__iter_go", -1), loop_body), -1), -1), -1)
}

fn next_call_for(ctype: String) -> Expr {
  ECall(EIdent(String::concat(ctype, "::next"), -1), [
    EIdent("__iter_cur", -1)
  ], -1)
}

fn build_iter_for(name: String, ctype: String, iter: Expr, body: Expr) -> Expr {
  build_iter_for_with(name, next_call_for(ctype), iter, body)
}

/// #736: `for x in xs` over a USER type implementing the indexed Iterable
/// protocol (`C::iter_length(Self) -> Int` + `C::iter_get(Self, Int) -> T`,
/// e.g. @vibe/core's List) desugars to an index-driven loop:
///
///   let __iter_src = xs
///   let __iter_n = C::iter_length(__iter_src)
///   let mut __iter_i = 0
///   while __iter_i < __iter_n {
///     let x = C::iter_get(__iter_src, __iter_i)
///     body
///     __iter_i = __iter_i + 1
///   }
///
/// The iterand is seeded through an immutable `__iter_src` for the same RC
/// ownership reason as build_iter_for_with (#704). Unlike the next-protocol
/// desugar, the optional index binding IS supported here (the loop counter is
/// the index): `for x, i in xs` binds `i` to the current `__iter_i`. The loop
/// is a statement (no per-iteration result collection).
fn build_indexed_iter_for(name: String, idx: Option[String], ctype: String, iter: Expr, body: Expr) -> Expr {
  let get_call = ECall(EIdent(String::concat(ctype, "::iter_get"), -1), [
    EIdent("__iter_src", -1),
    EIdent("__iter_i", -1)
  ], -1)
  let len_call = ECall(EIdent(String::concat(ctype, "::iter_length"), -1), [
    EIdent("__iter_src", -1)
  ], -1)
  let incr = EAssign("__iter_i", EBinOp("+", EIdent("__iter_i", -1), EInt(1)), EUnit)
  let bound_body = match idx {
    Some(iname) => ELet(iname, EIdent("__iter_i", -1), body, -1),
    None => body
  }
  let loop_body = ELet(name, get_call, ESeq(bound_body, incr), -1)
  ELet("__iter_src", iter, ELet("__iter_n", len_call, ELetMut("__iter_i", EInt(0), EWhile(EBinOp("<", EIdent("__iter_i", -1), EIdent("__iter_n", -1)), loop_body), -1), -1), -1)
}

/// `for` over an async iterator type `C` whose
/// `C::next(self) -> Future[Option[(T, Self)]] with { Async }`: identical to the
/// sync loop but each step `await`s the next-future. `await` is the M1a builtin
/// (`await(Future[T]) -> T`); on the synchronous ready-future codegen it unwraps
/// in place, so this also runs on the linear backend today.
/// #1341 (ADR-0089 D3): `for b in <host stream>`. The p3 host stream has no
/// `next` returning `Future[Option[T]]` -- its read primitive is the scalar
/// `host_stream_next(s) -> Int with { Async }`, which yields the next byte or
/// -1 once the writer is gone (spec §3.18). So this loop is built directly on
/// that read rather than on the AsyncIter protocol:
///
///   let __hs_src = <iter>
///   let mut __hs_b = host_stream_next(__hs_src)
///   while 0 <= __hs_b {
///     let <name> = __hs_b
///     <body>
///     __hs_b = host_stream_next(__hs_src)
///   }
///
/// which is exactly the hand-written while loop the named-hoststreams gate has
/// been running since #1339 -- so this introduces no new codegen, only the
/// surface. Each read parks and resumes on its own (`Suspend(handle + 2048)`),
/// which is why the enclosing row must carry `Async`; the checker requires
/// that separately (checker_effects, #1358/#1341).
///
/// No index binding: `for b, i in s` over a host stream would have to count
/// reads, and a byte offset is not the same thing as a position in a
/// re-iterable collection. Left unsupported rather than given a plausible
/// wrong meaning.
fn build_host_stream_for(name: String, iter: Expr, body: Expr) -> Expr {
  let read_call = ECall(EIdent("host_stream_next", -1), [
    EIdent("__hs_src", -1)
  ], -1)
  let advance = EAssign("__hs_b", read_call, EUnit)
  let loop_body = ELet(name, EIdent("__hs_b", -1), ESeq(body, advance), -1)
  ELet("__hs_src", iter, ELetMut("__hs_b", read_call, EWhile(EBinOp("<=", EInt(0), EIdent("__hs_b", -1)), loop_body), -1), -1)
}

fn build_await_iter_for(name: String, ctype: String, iter: Expr, body: Expr) -> Expr {
  let awaited = ECall(EIdent("await", -1), [
    next_call_for(ctype)
  ], -1)
  build_iter_for_with(name, awaited, iter, body)
}

/// `for x in pull { body }` over a pull closure `pull : () -> Option[T]`
/// (host-state async iterator, e.g. `stdin_stream`): drive `pull()` to `None`.
/// This is the M2c-3 pull model, moved here from the parser so `for` shares
/// one type-directed desugar with the trait iterators (a struct `C` with a
/// `C::next` drives the iterator loop above; anything else — a pull closure or a
/// call whose return type is unknown — falls back to this).
fn build_pull_for_in(value_name: String, index_name: Option[String], iterable: Expr, body: Expr) -> Expr {
  let some_arm = match index_name {
    Some(ix) => ESeq(body, EAssign(ix, EBinOp("+", EIdent(ix, -1), EInt(1)), EUnit)),
    None => ESeq(body, EUnit)
  }
  let loop_body = EMatch(ECall(EIdent("__pull_next", -1), array_empty(), -1), [
    (PCtor("Some", [
      PBind(value_name)
    ]), some_arm),
    (PCtor("None", array_empty()), EAssign("__pull_continue", EBool(false), EUnit))
  ])
  let core_loop = ELetMut("__pull_continue", EBool(true), EWhile(EIdent("__pull_continue", -1), loop_body), -1)
  let with_index = match index_name {
    Some(ix) => ELetMut(ix, EInt(0), core_loop, -1),
    None => core_loop
  }
  ELet("__pull_next", iterable, with_index, -1)
}

/// Does `fname`'s recorded return-type head indicate an async iterator
/// (`next() -> Future[Option[..]]`)? Drives the `await`-wrapped loop choice.
fn fn_return_is_future(fn_returns: Array[(String, String)], fname: String) -> Bool {
  match fn_return_type(fn_returns, fname) {
    Some(head) => head == "Future",
    None => false
  }
}

/// #827: is `inner` positively a pull-closure source? The pull loop binds the
/// iteratee as `__pull_next` and CALLS it, so lowering anything that is not a
/// function value that way is a call_indirect on a non-function pointer — an
/// out-of-bounds table trap at runtime. Only two shapes are accepted: a lambda
/// literal, and a call to a known function that positively RETURNS A FUNCTION
/// (the closure-returning sources like
/// `stdin_stream: (Int) -> (() -> Option[String])`).
///
/// #1350 (Codex P1) tightened the second shape. It used to accept any known
/// function reaching this point, on the reasoning that a named return head
/// would have classified in the Some branch instead -- true while only
/// `for await` could get here, but wrong once plain `for` shares the path: an
/// UNANNOTATED `let values = () -> { [40, 2] }` also has no head, and its
/// array was then called as a closure. Requiring the recorded head to be the
/// function-type sentinel separates "returns a function" from "return
/// annotation omitted"; the latter falls back to the array loop, as it did
/// before this classification was shared.
fn for_await_is_pull_source(inner: Expr, fn_returns: Array[(String, String)]) -> Bool {
  match inner {
    EFn(_, _, _, _, _, _) => true,
    ECall(callee, _, _) => match callee {
      EIdent(fname, _) => fn_return_is_fn_type(fn_returns, fname),
      _ => false
    },
    _ => false
  }
}

/// #1350: the trait-free arm of the for-loop classification. Without a
/// declared trait there are no `impl ::next` methods to dispatch, so a plain
/// `for x in e` keeps its EForIn (array) lowering -- but the two ASYNC shapes
/// still classify here, because they never needed the trait machinery and
/// their consumers are trait-free files (the prelude's AsyncIter terminals,
/// @vibe/console's pull streams). This is the `for await` path's old
/// "runs regardless of whether a trait is declared" property, kept after the
/// syntax went away.
///
/// #827's hazard is gone by construction rather than by diagnostic: the
/// UNCLASSIFIED fallback is now the array loop (correct for the eager
/// Array-backed `Stream`, ADR-0012), not the pull loop that used to
/// call_indirect an array pointer. The pull loop fires only on a POSITIVE
/// function-shaped classification.
fn classify_trait_free_for_loop(name: String, idx: Option[String], iter: Expr, riter: Expr, rbody: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {
  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {
    Some(tn) => if tn == "HostStream" {
      build_host_stream_for(name, riter, rbody)
    } else if fn_exists(fn_returns, String::concat(tn, "::next")) && fn_return_is_future(fn_returns, String::concat(tn, "::next")) {
      build_await_iter_for(name, tn, riter, rbody)
    } else {
      classify_indexed_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)
    },
    None => if for_await_is_pull_source(iter, fn_returns) {
      build_pull_for_in(name, idx, riter, rbody)
    } else {
      EForIn(name, idx, riter, rbody)
    }
  }
}

/// `for x in iter { body }`: iterator (`::next`) / iterable (`::iter`) / array
/// classification. `riter` / `rbody` are already rewritten.
/// #736: the indexed-Iterable slice of for-loop classification, USER types only
/// (struct_sets gate — Array/String/Map keep the builtin EForIn lowering even
/// though the prelude's Iterable impls define e.g. `Array::iter_length`). Split
/// out of classify_sync_for_loop because it needs no declared trait (the
/// protocol is plain named `C::iter_length`/`C::iter_get` functions, e.g.
/// @vibe/core's List), so it also runs for trait-free programs where the
/// next/iter classification stays gated off.
fn classify_indexed_for_loop(name: String, idx: Option[String], iter: Expr, riter: Expr, rbody: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {
  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {
    Some(tn) => if struct_set_has(struct_sets, tn) && fn_exists(fn_returns, String::concat(tn, "::iter_length")) && fn_exists(fn_returns, String::concat(tn, "::iter_get")) {
      build_indexed_iter_for(name, idx, tn, riter, rbody)
    } else {
      EForIn(name, idx, riter, rbody)
    },
    None => EForIn(name, idx, riter, rbody)
  }
}

/// `for x in iter { body }` -- the ONE for-loop classification (#1350 folded
/// the `for await` variant in here).
///
/// The async/sync choice is made from the iterand's type, exactly as the old
/// `for await` path made it: a `C::next` returning `Future[..]` drives the
/// await-wrapped loop, a plain `C::next` the sync one. That is why the
/// syntactic marker could go -- it never carried information this pass did
/// not already have, it only duplicated what the effect row states.
///
/// One shape is admitted here that the old sync path rejected: a PULL CLOSURE
/// (`() -> Option[T]`, e.g. `stdin_stream(4)`), which the `for await` path
/// classified via for_await_is_pull_source. The classification is positive
/// (lambda literal, or a call to a known top-level fn with a non-named return
/// head) and it only fires where the sync path used to emit `EForIn` over a
/// function value -- a call_indirect on a non-array pointer, i.e. a runtime
/// trap. So this strictly turns a trap into a working loop (#827's own
/// reasoning, now applied to the single surface).
fn classify_sync_for_loop(name: String, idx: Option[String], iter: Expr, riter: Expr, rbody: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {
  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {
    Some(tn) => if tn == "HostStream" {
      build_host_stream_for(name, riter, rbody)
    } else if fn_exists(fn_returns, String::concat(tn, "::next")) {
      if fn_return_is_future(fn_returns, String::concat(tn, "::next")) {
        build_await_iter_for(name, tn, riter, rbody)
      } else {
        build_iter_for(name, tn, riter, rbody)
      }
    } else {
      match fn_return_type(fn_returns, String::concat(tn, "::iter")) {
        Some(itertype) => build_iter_for(name, itertype, ECall(EIdent(String::concat(tn, "::iter"), -1), [
          riter
        ], -1), rbody),
        None => classify_indexed_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)
      }
    },
    None => if for_await_is_pull_source(iter, fn_returns) {
      build_pull_for_in(name, idx, riter, rbody)
    } else {
      EForIn(name, idx, riter, rbody)
    }
  }
}

/// #1064 (Codex review on the original fix): a railway-bound name's real type
/// is `val`'s PAYLOAD, not `val`'s own wrapper type -- conflating them broke
/// plain scalar payloads (the common case: `let* rv = half(x)`, `half: Int ->
/// Option[Int]`, `rv: Int`). But when `val` is a LITERAL nested constructor
/// (`let* outer = Some(Some(1))`), the payload genuinely IS an Option/Result
/// value, so `outer` DOES need a var_types entry -- otherwise a follow-up
/// `let* inner = outer` chaining through the bare identifier can't tell it
/// apart from a Result and defaults to the wrong (Ok/Err) arms. Recurse ONE
/// level into a literal `Some(x)`/`Ok(x)` (never `Err(x)` -- Err's own
/// payload is the error value, never itself railway-chained) to recover the
/// payload's head type for exactly this literal-nesting shape; every other
/// `val` shape (a call to a user function, a bare identifier, ...) has no
/// recoverable payload type here (`fn_returns` only carries a call's return
/// head, not its type arguments) and stays untracked, same as the plain
/// scalar fix.
fn railway_bind_payload_type(val: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Option[String] {
  match val {
    ECall(callee, inner_args, _) => match callee {
      EIdent(cname, _) => if (cname == "Some" || cname == "Ok") && Array::length(inner_args) == 1 {
        infer_arg_type_name(Array::get(inner_args, 0), struct_sets, var_types, fn_returns)
      } else {
        None
      },
      _ => None
    },
    _ => None
  }
}

/// Extend the local var-type environment with `name` when its bound value's
/// type was inferable. A fresh array (copy) is returned so sibling scopes do not
/// see the binding.
fn extend_var_types(var_types: Array[(String, String)], name: String, inferred: Option[String]) -> Array[(String, String)] {
  match inferred {
    Some(tname) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(var_types) {
        Array::push(out, Array::get(var_types, i))
        i = i + 1
      }
      Array::push(out, (name, tname))
      out
    },
    None => var_types
  }
}

/// #672: a qualified constructor `Enum::Variant` -> the unqualified variant
/// `Variant`, when `member` is a constructor of enum `head` (variants are bound
/// unqualified, and codegen's ctor table is keyed unqualified). `head` MUST be a
/// known user enum/struct (`struct_sets` includes enum names) — this is the gate
/// that keeps builtin qualified calls like `String::join` / `Array::map` alone
/// even when a same-named function (`join`/`map`) happens to return that type.
fn qual_ctor_member(head: String, member: String, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)]) -> Option[String] {
  if struct_set_has(struct_sets, head) {
    match fn_return_type(fn_returns, member) {
      Some(en) => if en == head {
        Some(member)
      } else {
        None
      },
      None => None
    }
  } else {
    None
  }
}

/// #635: classify a call as a railway-bind/op sentinel. Returns
///   0 = `__try_bind(val, (name) -> rest)` (callee `__try_bind`, 2 args, arg1
///       a 1-param closure),
///   1 = `__try_op(val)` (callee `__try_op`, exactly 1 arg),
///   2 = not a sentinel (ordinary call; e.g. a user fn that happens to share the
///       name but with a different arity/shape).
fn try_sentinel(callee: Expr, args: Array[Expr]) -> Int {
  match callee {
    EIdent(n, _) => if n == "__try_bind" {
      if Array::length(args) == 2 {
        match Array::get(args, 1) {
          EFn(_, _, ps, _, _, _) => if Array::length(ps) == 1 {
            0
          } else {
            2
          },
          _ => 2
        }
      } else {
        2
      }
    } else if n == "__try_op" {
      if Array::length(args) == 1 {
        1
      } else {
        2
      }
    } else {
      2
    },
    _ => 2
  }
}

/// #941: best-effort char offset of a railway operand, so the desugar-generated
/// failure-track nodes (`Err(e)` / `None`) carry the `?`/`let*` operand's own
/// source position — the checker's Option⇔Result mixing diagnostics anchor on
/// it. -1 (unlocated) when the operand carries no offset.
fn railway_val_off(e: Expr) -> Int {
  match e {
    EIdent(_, off) => off,
    ECall(callee, _, off) => if off >= 0 {
      off
    } else {
      railway_val_off(callee)
    },
    EDot(base, _, off, _) => if off >= 0 {
      off
    } else {
      railway_val_off(base)
    },
    EBinOp(_, lhs, _) => railway_val_off(lhs),
    _ => -1
  }
}

/// #635: lower the `let* name = val <rest>` sentinel by `val`'s head type.
/// Option -> `match val { Some(name) => rest, None => None }`; else (Result, or
/// undeterminable -> default Result, today's behavior) the railway Result match
/// `match val { Ok(name) => rest, Err(__bind_err) => Err(__bind_err) }`.
fn lower_try_bind(val: Expr, name: String, rest: Expr, inferred: Option[String]) -> Expr {
  let voff = railway_val_off(val)
  match inferred {
    Some(tn) => if tn == "Option" {
      EMatch(val, [
        (PCtor("Some", [
          PBind(name)
        ]), rest),
        (PCtor("None", array_empty()), EIdent("None", voff))
      ])
    } else {
      EMatch(val, [
        (PCtor("Ok", [
          PBind(name)
        ]), rest),
        (PCtor("Err", [
          PBind("__bind_err")
        ]), ECall(EIdent("Err", voff), [
          EIdent("__bind_err", -1)
        ], voff))
      ])
    },
    None => EMatch(val, [
      (PCtor("Ok", [
        PBind(name)
      ]), rest),
      (PCtor("Err", [
        PBind("__bind_err")
      ]), ECall(EIdent("Err", voff), [
        EIdent("__bind_err", -1)
      ], voff))
    ])
  }
}

/// #635: lower the `val?` sentinel by `val`'s head type. Option -> yield the
/// inner value on `Some`, early-`return None` on `None`. Else (Result, or
/// undeterminable -> default Result) -> yield on `Ok`, early-`return Err(e)` on
/// `Err`. Uses `EReturn`, so the enclosing function short-circuits.
fn lower_try_op(val: Expr, inferred: Option[String]) -> Expr {
  let voff = railway_val_off(val)
  match inferred {
    Some(tn) => if tn == "Option" {
      EMatch(val, [
        (PCtor("Some", [
          PBind("__try_v")
        ]), EIdent("__try_v", -1)),
        (PCtor("None", array_empty()), EReturn(EIdent("None", voff)))
      ])
    } else {
      EMatch(val, [
        (PCtor("Ok", [
          PBind("__try_v")
        ]), EIdent("__try_v", -1)),
        (PCtor("Err", [
          PBind("__try_e")
        ]), EReturn(ECall(EIdent("Err", voff), [
          EIdent("__try_e", -1)
        ], voff)))
      ])
    },
    None => EMatch(val, [
      (PCtor("Ok", [
        PBind("__try_v")
      ]), EIdent("__try_v", -1)),
      (PCtor("Err", [
        PBind("__try_e")
      ]), EReturn(ECall(EIdent("Err", voff), [
        EIdent("__try_e", -1)
      ], voff)))
    ])
  }
}

/// #635: standalone railway-sentinel lowering. Walks an expr and rewrites only
/// the `__try_bind`/`__try_op` sentinels (everything else is recursed
/// structurally unchanged), type-directing each by `infer_arg_type_name`. Runs
/// from BOTH the checker (`check_program`, where the heavy dict-passing pass does
/// NOT run) and — idempotently — the codegen `desugar_trait_dicts`. It is inert
/// for programs that use no `let*`/`?` (no sentinels present). `var_types` tracks
/// locals so `let* x = some_opt` then `let* y = uses(x)` resolves x's type.
fn railway_rw(expr: Expr, struct_sets: Array[(String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr {
  match expr {
    ECall(callee, args, off) => {
      let k = try_sentinel(callee, args)
      if k == 0 {
        let val = Array::get(args, 0)
        match Array::get(args, 1) {
          EFn(_, _, ps, _, _, rest) => {
            let (name, _) = Array::get(ps, 0)
            let rwval = railway_rw(val, struct_sets, var_types, fn_returns)
            let inferred = infer_arg_type_name(val, struct_sets, var_types, fn_returns)
            // #1064: `name` binds to the UNWRAPPED payload (`Some(name)`'s
            // field), never to a value of `inferred`'s own type (the
            // wrapper "Option"/"Result" of `val`) -- recording name ->
            // inferred unconditionally here conflated the two, so a later
            // `name == <int literal>` in `rest` was misclassified by
            // infer_arg_type_name's var_types lookup as an Option/Result
            // operand and routed through the structural opt_eq_match/
            // result_eq_match rewrite instead of a scalar comparison,
            // silently computing nonsense for the common scalar-payload
            // case. `railway_bind_payload_type` recovers the real payload
            // type for the one shape it CAN (a literal `Some(x)`/`Ok(x)`
            // nesting, e.g. `let* outer = Some(Some(1))`) so a follow-up
            // `let* inner = outer` still chains correctly; every other
            // shape (a plain function call, a bare identifier, ...) stays
            // untracked, falling through infer_arg_type_name to `None`,
            // which keeps the plain scalar `==`/`!=` codegen path.
            let body_vars = extend_var_types(var_types, name, railway_bind_payload_type(val, struct_sets, var_types, fn_returns))
            let rwrest = railway_rw(rest, struct_sets, body_vars, fn_returns)
            lower_try_bind(rwval, name, rwrest, inferred)
          },
          _ => EUnit
        }
      } else if k == 1 {
        let val = Array::get(args, 0)
        let rwval = railway_rw(val, struct_sets, var_types, fn_returns)
        lower_try_op(rwval, infer_arg_type_name(val, struct_sets, var_types, fn_returns))
      } else {
        let rwargs = for a in args {
          railway_rw(a, struct_sets, var_types, fn_returns)
        }
        match map_index_rewrite(callee, args, rwargs, struct_sets, var_types, fn_returns) {
          Some(map_get) => map_get,
          None => ECall(railway_rw(callee, struct_sets, var_types, fn_returns), rwargs, off)
        }
      }
    },
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EUnit => expr,
    ESpread(e) => ESpread(railway_rw(e, struct_sets, var_types, fn_returns)),
    EStringInterp(_) => expr,
    EIdent(_, _) => expr,
    ETuple(elems) => ETuple(for e in elems {
      railway_rw(e, struct_sets, var_types, fn_returns)
    }),
    EArray(elems) => EArray(for e in elems {
      railway_rw(e, struct_sets, var_types, fn_returns)
    }),
    ERecord(rn, fields, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fval) = Array::get(fields, i)
        Array::push(out, (fname, railway_rw(fval, struct_sets, var_types, fn_returns)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fields) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (k, v) = Array::get(fields, i)
        Array::push(out, (k, railway_rw(v, struct_sets, var_types, fn_returns)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(railway_rw(c, struct_sets, var_types, fn_returns), railway_rw(t, struct_sets, var_types, fn_returns), railway_rw(e, struct_sets, var_types, fn_returns)),
    ELet(name, val, body, soff) => {
      let new_val = railway_rw(val, struct_sets, var_types, fn_returns)
      let body_vars = extend_var_types(var_types, name, anon_or_infer(val, struct_sets, var_types, fn_returns))
      ELet(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns), soff)
    },
    ELetRec(name, val, body) => ELetRec(name, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(body, struct_sets, var_types, fn_returns)),
    ELetMut(name, val, body, soff) => {
      let new_val = railway_rw(val, struct_sets, var_types, fn_returns)
      let body_vars = extend_var_types(var_types, name, anon_or_infer(val, struct_sets, var_types, fn_returns))
      ELetMut(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns), soff)
    },
    EAssign(name, val, cont) => EAssign(name, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(cont, struct_sets, var_types, fn_returns)),
    EAssignOp(name, op, val, cont) => EAssignOp(name, op, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(cont, struct_sets, var_types, fn_returns)),
    ESeq(a, b) => ESeq(railway_rw(a, struct_sets, var_types, fn_returns), railway_rw(b, struct_sets, var_types, fn_returns)),
    EMatch(scrut, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        Array::push(out, (p, railway_rw(b, struct_sets, var_types, fn_returns)))
        i = i + 1
      }
      EMatch(railway_rw(scrut, struct_sets, var_types, fn_returns), out)
    },
    EHandle(scrut, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        Array::push(out, (p, railway_rw(b, struct_sets, var_types, fn_returns)))
        i = i + 1
      }
      EHandle(railway_rw(scrut, struct_sets, var_types, fn_returns), out)
    },
    EWhile(c, b) => EWhile(railway_rw(c, struct_sets, var_types, fn_returns), railway_rw(b, struct_sets, var_types, fn_returns)),
    ELoop(params, body) => ELoop(for param in params {
      let (name, init) = param
      (name, railway_rw(init, struct_sets, var_types, fn_returns))
    }, railway_rw(body, struct_sets, var_types, fn_returns)),
    EForIn(name, idx, iter, body) => EForIn(name, idx, railway_rw(iter, struct_sets, var_types, fn_returns), railway_rw(body, struct_sets, var_types, fn_returns)),
    EBinOp(op, l, r) => EBinOp(op, railway_rw(l, struct_sets, var_types, fn_returns), railway_rw(r, struct_sets, var_types, fn_returns)),
    EUnaryOp(op, e) => EUnaryOp(op, railway_rw(e, struct_sets, var_types, fn_returns)),
    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, railway_rw(body, struct_sets, seed_var_types(ps, tp, var_types), fn_returns)),
    EDot(obj, field, off, fdoff) => {
      let robj = railway_rw(obj, struct_sets, var_types, fn_returns)
      match anon_dot_rewrite(obj, field, off, robj, var_types) {
        Some(rw) => rw,
        None => EDot(robj, field, off, fdoff)
      }
    },
    ELabeledArg(label, name, body) => ELabeledArg(label, name, railway_rw(body, struct_sets, var_types, fn_returns)),
    EReturn(e) => EReturn(railway_rw(e, struct_sets, var_types, fn_returns)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(railway_rw(e, struct_sets, var_types, fn_returns))),
      None => expr
    },
    EContinue(exprs) => EContinue(for e in exprs {
      railway_rw(e, struct_sets, var_types, fn_returns)
    })
  }
}

/// #839: every top-level `let name = record { .. }` whose field-set matches no
/// declared struct, collected as `__anonrec:` var_types entries UP FRONT (same
/// encoding `anon_record_inferred`/`anon_dot_rewrite` use for a local `let`).
/// Threaded as the BASE var_types into every top-level statement's own
/// `railway_rw` pass below (instead of starting each statement fresh from
/// empty), so `name.field` resolves whether it appears in a LATER top-level
/// statement or inside a function/test body that merely closes over a
/// top-level binding — not just within the same statement's own expression
/// tree (#839: previously the only working position was a bare top-level
/// expression statement in the SAME statement as the record literal, which
/// ADR-0069 now rejects outright). Consistent with `collect_struct_field_sets`
/// / `collect_fn_returns`, this does not recurse into `SModule` bodies — a
/// module-nested anonymous-record `let` is a fresh scope of its own, same as
/// module-nested struct/fn declarations are already scoped in those passes.
fn collect_toplevel_anon_records(stmts: Array[Stmt], struct_sets: Array[(String, Array[String])]) -> Array[(String, String)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, val) => match anon_record_inferred(val, struct_sets) {
        Some(sentinel) => Array::push(out, (name, sentinel)),
        None => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// #635: lower the `let*`/`?` sentinels across a whole program. In-place,
/// idempotent (a second run finds no sentinels), and inert for programs that use
/// neither. Exported so the checker path can lower before type-checking.
/// `toplevel_vars` (#839) seeds every top-level statement's var_types with the
/// program's top-level anonymous-record bindings — see
/// `collect_toplevel_anon_records` — so `EFn`/`ELet`'s existing var_types
/// threading (which already covers a SINGLE statement's own nested scopes)
/// extends across top-level statement boundaries too.
fn railway_rw_stmt(s: Stmt, struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)], toplevel_vars: Array[(String, String)]) -> Stmt {
  match s {
    SLet(exp, isrec, fname, ann, body) => SLet(exp, isrec, fname, ann, railway_rw(body, struct_sets, toplevel_vars, fn_returns)),
    SLetMut(name, ty, e) => SLetMut(name, ty, railway_rw(e, struct_sets, toplevel_vars, fn_returns)),
    STest(name, body) => STest(name, railway_rw(body, struct_sets, toplevel_vars, fn_returns)),
    SBench(name, body) => SBench(name, railway_rw(body, struct_sets, toplevel_vars, fn_returns)),
    SExpr(e) => SExpr(railway_rw(e, struct_sets, toplevel_vars, fn_returns)),
    SModule(exp, name, body) => SModule(exp, name, for inner in body {
      railway_rw_stmt(inner, struct_sets, fn_returns, toplevel_vars)
    }),
    _ => s
  }
}

export fn desugar_railway_binds(stmts: Array[Stmt]) -> Unit {
  let struct_sets = collect_struct_field_sets(stmts)
  let fn_returns = collect_fn_returns(stmts)
  let toplevel_vars = collect_toplevel_anon_records(stmts, struct_sets)
  let mut i = 0
  while i < Array::length(stmts) {
    Array::set(stmts, i, railway_rw_stmt(Array::get(stmts, i), struct_sets, fn_returns, toplevel_vars))
    i = i + 1
  }
}

/// The core rewriter. `dict_binds` is non-empty only inside a transformed
/// generic's body (so `T::method` resolves to a dict field); call-site dict
/// threading applies everywhere a transformed generic is called. `var_types`
/// tracks locals/params whose concrete type is known, for call-site dict
/// synthesis when the receiver is a variable.
fn rewrite_expr(expr: Expr, gens: Array[(String, Array[(String, String, Int)])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], dict_binds: Array[(String, String, String, Array[String])], var_types: Array[(String, String)], fn_returns: Array[(String, String)]) -> Expr with { Error } {
  match expr {
    EIdent(name, off) => match split_qualified(name) {
      Some(parts) => {
        let (head, member) = parts
        match find_dict_for_method(dict_binds, head, member) {
          Some(dict_pname) => EDot(EIdent(dict_pname, -1), member, -1, -1),
          None => match qual_ctor_member(head, member, struct_sets, fn_returns) {
            Some(m) => EIdent(m, off),
            None => expr
          }
        }
      },
      None => expr
    },
    ECall(callee, args, off) => {
      // #635: type-directed lowering of the railway sentinels emitted by the
      // parser. `__try_bind(val, (x) -> rest)` and `__try_op(val)` carry no type
      // info from the parser; here `infer_arg_type_name(val)` picks Option vs
      // Result (default Result when undeterminable — today's behavior). A user
      // function literally named `__try_bind`/`__try_op` with the wrong shape
      // (handled by `try_sentinel` returning None) takes the generic path.
      let try_kind = try_sentinel(callee, args)
      if try_kind == 0 {
        // __try_bind(val, (name) -> rest)
        let val = Array::get(args, 0)
        match Array::get(args, 1) {
          EFn(_, _, ps, _, _, rest) => {
            let (name, _) = Array::get(ps, 0)
            let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
            let inferred = infer_arg_type_name(val, struct_sets, var_types, fn_returns)
            // #1064: `name` binds to the UNWRAPPED payload (`Some(name)`'s
            // field), never to a value of `inferred`'s own type (the
            // wrapper "Option"/"Result" of `val`) -- recording name ->
            // inferred unconditionally here conflated the two, so a later
            // `name == <int literal>` in `rest` was misclassified by
            // infer_arg_type_name's var_types lookup as an Option/Result
            // operand and routed through the structural opt_eq_match/
            // result_eq_match rewrite instead of a scalar comparison,
            // silently computing nonsense for the common scalar-payload
            // case. `railway_bind_payload_type` recovers the real payload
            // type for the one shape it CAN (a literal `Some(x)`/`Ok(x)`
            // nesting, e.g. `let* outer = Some(Some(1))`) so a follow-up
            // `let* inner = outer` still chains correctly; every other
            // shape (a plain function call, a bare identifier, ...) stays
            // untracked, falling through infer_arg_type_name to `None`,
            // which keeps the plain scalar `==`/`!=` codegen path.
            let body_vars = extend_var_types(var_types, name, railway_bind_payload_type(val, struct_sets, var_types, fn_returns))
            let rwrest = rewrite_expr(rest, gens, traits, struct_sets, dict_binds, body_vars, fn_returns)
            lower_try_bind(rwval, name, rwrest, inferred)
          },
          _ => EUnit
        }
      } else if try_kind == 1 {
        // __try_op(val)
        let val = Array::get(args, 0)
        let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
        lower_try_op(rwval, infer_arg_type_name(val, struct_sets, var_types, fn_returns))
      } else if !exn_kind_suppressed() && is_exception_kind_read(callee, args) {
        // #1374: `__exn_kind()` is a checker-only intrinsic (typed
        // `() -> String` in checker/builtins_misc.vibe, no wasm body) -- it
        // exists so a handler arm can spell the read, and it is gone by the
        // time either backend sees the program.
        exn_kind_mark_used()
        exn_kind_read_expr()
      } else if !exn_kind_suppressed() && is_perform_throw_shape(callee, args) {
        // #1374: record the payload's static type name for the handler. The
        // write is UNCONDITIONAL, including the empty name for a payload this
        // pass cannot resolve -- leaving the slot alone there would let an
        // earlier throw's kind be read as this one's.
        //
        // The resolver is codegen's own `infer_arg_type_name`, not the
        // checker's `throw_payload_kind`: both answer the same question from
        // the same syntax, but the checker's table is TypeEnv-derived state
        // that does not reach codegen, and this pass already carries
        // `var_types`/`fn_returns` for every expression it visits. They can
        // disagree only by one being MORE conservative (an unresolved name is
        // ""), which costs a kind here and a row precision there, never
        // soundness.
        let kind = match infer_arg_type_name(perform_throw_payload(args), struct_sets, var_types, fn_returns) {
          Some(k) => k,
          None => ""
        }
        let rwargs = for a in args {
          rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
        }
        exn_kind_mark_used()
        // The write has to land AFTER the payload is evaluated, not before.
        // There is ONE slot, so anything the payload expression does that
        // reaches a throw -- even one it handles itself -- overwrites the kind
        // this site just recorded. `throw(payload())` where `payload()`
        // internally catches a `throw(Bang(1))` and returns a String would
        // otherwise leave `Boom` in the slot and be reported as `<Boom>`
        // instead of its own message. Binding the payload first makes the
        // write the last thing before the perform.
        let pname = exn_kind_fresh_payload_name()
        ELet(pname, perform_throw_payload(rwargs), ESeq(exn_kind_write_expr(kind), ECall(callee, perform_throw_with_payload(rwargs, EIdent(pname, -1)), off)), -1)
      } else {
        let rwargs = for a in args {
          rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
        }
        match map_index_rewrite(callee, args, rwargs, struct_sets, var_types, fn_returns) {
          Some(map_get) => map_get,
          None =>
          match callee {
            EIdent(name0, coff) => {
              // #672: unqualify a qualified constructor call `Enum::Variant(..)` ->
              // `Variant(..)` so codegen's (unqualified) ctor table recognizes it.
              let name_ctor = match split_qualified(name0) {
                Some(parts0) => {
                  let (h0, m0) = parts0
                  match qual_ctor_member(h0, m0, struct_sets, fn_returns) {
                    Some(mm) => mm,
                    None => name0
                  }
                },
                None => name0
              }
              // #736 residual: bare method-style callee — `xs |> length` is
              // `length(xs)`; with only the receiver TYPE imported there is no
              // top-level `length`, so resolve to `<type-of-arg0>::length` (USER
              // types only, and only when no top-level fn of the bare name exists
              // — a lexically visible `length` keeps normal call semantics). The
              // checker applies the same rule, so typing and codegen agree.
              let name = if String::index_of(name_ctor, "::") < 0 && !fn_exists(fn_returns, name_ctor) && Array::length(args) >= 1 {
                match infer_arg_type_name(Array::get(args, 0), struct_sets, var_types, fn_returns) {
                  Some(tn) => {
                    let qual = String::concat(tn, String::concat("::", name_ctor))
                    if struct_set_has(struct_sets, tn) && fn_exists(fn_returns, qual) {
                      qual
                    } else {
                      name_ctor
                    }
                  },
                  None => name_ctor
                }
              } else {
                name_ctor
              }
              // `T::method(args)` inside a transformed body -> `(dict.method)(args)`.
              let as_method = match split_qualified(name) {
                Some(parts) => {
                  let (head, member) = parts
                  find_dict_for_method(dict_binds, head, member)
                },
                None => None
              }
              match as_method {
                Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), member_of(name), -1, -1), rwargs, off),
                None => match lookup_gen(gens, name) {
                  Some(threaded) => match synth_dicts(threaded, args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) {
                    Some(dicts) => ECall(EIdent(name, coff), concat_expr_arrays(dicts, rwargs), off),
                    None => ECall(EIdent(name, coff), rwargs, off)
                  },
                  None => ECall(EIdent(name, coff), rwargs, off)
                }
              }
            },
            EDot(obj, m, doff, fdoff) => {
              // #736 residual: method-style call `xs.length()` on a USER type —
              // codegen compiles a called EDot as struct-field access, so a
              // receiver method (`List::length`) failed with "unknown struct
              // field". Rewrite to the qualified call when the receiver's type is
              // inferable and declares the method as a top-level fn. A struct
              // FIELD of the same name keeps the field-stored-function call (the
              // field is the closer binding), and unknown receivers keep the EDot
              // (codegen's existing paths).
              let robj = rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
              // #931: UFCS on a trait-BOUNDED TYPE PARAMETER — `k.probe_key()`
              // where `k: K` and `[K: Hash]` is in scope. The receiver's inferred
              // "type name" is the tparam itself ("K"), which is neither a struct
              // nor a concrete `K::method` top-level fn, so the concrete-method
              // rewrite below missed it and the call stayed a bare EDot — codegen
              // compiles a called EDot as a struct-field read, yielding a
              // null-function call at runtime. Route it through the SAME threaded
              // witness dict as the qualified spelling `K::probe_key(k)` (the
              // EIdent arm above): `(dict.method)(k, args)`. Checked FIRST so both
              // spellings resolve identically (the qualified path also consults
              // find_dict_for_method before any concrete fallback).
              let recv_tn = infer_arg_type_name(obj, struct_sets, var_types, fn_returns)
              let as_tparam_dict = match recv_tn {
                Some(tn) => find_dict_for_method(dict_binds, tn, m),
                None => None
              }
              let as_recv_method = match as_tparam_dict {
                Some(_) => None,
                None => match recv_tn {
                  Some(tn) => {
                    let qual = String::concat(tn, String::concat("::", m))
                    let is_field = struct_set_member(struct_sets, tn, m)
                    if !is_field && fn_exists(fn_returns, qual) {
                      Some(qual)
                    } else {
                      None
                    }
                  },
                  None => None
                }
              }
              match as_tparam_dict {
                Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), m, -1, -1), prepend_expr(robj, rwargs), off),
                None => match as_recv_method {
                  // #1199 bug 2: `qual` (e.g. "Box::describe") can be a
                  // THREADED generic itself (`Box::describe[T: Hash](b:
                  // Box[T], value: T)`) exactly like a directly-written
                  // `Box::describe(b, value)` call reaching the EIdent arm
                  // above -- but until this fix, this EDot rewrite only ever
                  // built `ECall(EIdent(qual), [receiver, ...args])`,
                  // NEVER consulting lookup_gen/synth_dicts the way the
                  // EIdent arm does. So the qualified spelling of a call
                  // correctly prepended its witness dictionary argument(s)
                  // while the identical call written as dot-call sugar
                  // silently dropped them -- the callee's (already
                  // dict-threaded) signature and the dot-call's rewritten
                  // arg count then disagreed, and codegen emitted a call
                  // short its dict argument(s) (invalid wasm), not two
                  // notations of the same, both-valid call. Mirror the
                  // EIdent arm exactly: synth_dicts against the ORIGINAL
                  // (pre-rewrite) receiver + args, prepending the resolved
                  // dicts ahead of the rewritten receiver + args on success,
                  // falling back to the un-dicted call (same as the EIdent
                  // arm's own fallback) when synth_dicts can't resolve one.
                  Some(qual) => match lookup_gen(gens, qual) {
                    Some(threaded) => match synth_dicts(threaded, prepend_expr(obj, args), traits, struct_sets, var_types, dict_binds, fn_returns, gens) {
                      Some(dicts) => ECall(EIdent(qual, doff), concat_expr_arrays(dicts, prepend_expr(robj, rwargs)), off),
                      None => ECall(EIdent(qual, doff), prepend_expr(robj, rwargs), off)
                    },
                    None => ECall(EIdent(qual, doff), prepend_expr(robj, rwargs), off)
                  },
                  None => ECall(EDot(robj, m, doff, fdoff), rwargs, off)
                }
              }
            },
            _ => ECall(rewrite_expr(callee, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rwargs, off)
          }
        }
      }
    },
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EUnit => expr,
    ESpread(_) => expr,
    EStringInterp(_) => expr,
    ETuple(elems) => ETuple(for e in elems {
      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    }),
    EArray(elems) => EArray(for e in elems {
      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    }),
    ERecord(rn, fields, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fval) = Array::get(fields, i)
        Array::push(out, (fname, rewrite_expr(fval, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fields) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (k, v) = Array::get(fields, i)
        Array::push(out, (k, rewrite_expr(v, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(t, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    ELet(name, val, body, soff) => {
      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      let body_vars0 = extend_var_types(var_types, name, anon_or_infer(val, struct_sets, var_types, fn_returns))
      let body_vars = array_elem_bind(body_vars0, name, val, struct_sets, fn_returns)
      ELet(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns), soff)
    },
    ELetRec(name, val, body) => ELetRec(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    ELetMut(name, val, body, soff) => {
      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      let body_vars0 = extend_var_types(var_types, name, anon_or_infer(val, struct_sets, var_types, fn_returns))
      let body_vars = array_elem_bind(body_vars0, name, val, struct_sets, fn_returns)
      ELetMut(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns), soff)
    },
    EAssign(name, val, cont) => EAssign(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EAssignOp(name, op, val, cont) => EAssignOp(name, op, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    ESeq(a, b) => ESeq(rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EMatch(scrut, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))
        i = i + 1
      }
      EMatch(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)
    },
    EHandle(scrut, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))
        i = i + 1
      }
      EHandle(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)
    },
    EWhile(c, b) => EWhile(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    ELoop(params, body) => ELoop(for param in params {
      let (name, init) = param
      (name, rewrite_expr(init, gens, traits, struct_sets, dict_binds, var_types, fn_returns))
    }, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EForIn(name, idx, iter, body) => {
      let rbody = rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      // #1350: one surface, one classification. A plain `for x in e` is
      // iterator/iterable/array-classified only when a method-bearing trait is
      // present (without one there are no `impl ::next` methods to dispatch),
      // so trait-free programs' `for` loops keep their EForIn lowering -- with
      // the two ASYNC shapes as the exception, exactly as `for await` was the
      // exception before: they are plain named functions / closures, need no
      // trait machinery, and their consumers (the prelude's AsyncIter
      // terminals, @vibe/console's pull streams) are trait-free files.
      let riter = rewrite_expr(iter, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      if Array::length(traits) == 0 {
        classify_trait_free_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)
      } else {
        classify_sync_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)
      }
    },
    EBinOp(op, l, r) => {
      let rl = rewrite_expr(l, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      let rr = rewrite_expr(r, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      // #672: dispatch `a == b` / `a != b` on a struct type to the generated
      // structural `T::equals`. The operand's type is resolved best-effort via
      // `infer_arg_type_name` (var_types for variables, field-set match for
      // struct literals); a struct type whose `equals` we generated is rewritten
      // to a call. Non-struct / unresolved operands keep the scalar binop.
      if op == "==" || op == "!=" {
        // #695: an empty array LITERAL on either side reduces `==` to a length
        // check on the other operand (an array equals `[]` iff its length is 0),
        // which is exact and needs no element type. This also covers `[] == []`,
        // whose element type is otherwise undeterminable.
        let empty_l = is_empty_array_lit(l)
        let empty_r = is_empty_array_lit(r)
        // #695: a bare array `==` (operand is an array literal whose element type
        // is statically determinable) dispatches to the monomorphic
        // `__arr_equals__<key>` helper (emitted by desugar_derives), since the
        // runtime `eq` would identity-compare the array. Opaque array-typed
        // operands (no literal in scope) are left as `==` (documented residual).
        let arr_elem = match infer_earray_elem_type(l) {
          Some(t) => Some(t),
          None => infer_earray_elem_type(r)
        }
        if empty_l || empty_r {
          let other = if empty_l {
            rr
          } else {
            rl
          }
          let lencmp = EBinOp("==", ECall(EIdent("Array::length", -1), [
            other
          ], -1), EInt(0))
          if op == "==" {
            lencmp
          } else {
            ECall(EIdent("not", -1), [
              lencmp
            ], -1)
          }
        } else {
          match arr_elem {
            Some(elem) => {
              let call = ECall(EIdent(arr_equals_name(elem), -1), [
                rl,
                rr
              ], -1)
              if op == "==" {
                call
              } else {
                ECall(EIdent("not", -1), [
                  call
                ], -1)
              }
            },
            None => {
              // #825: full static-shape dispatch. When either operand's complete
              // TypeExpr is inferable from literal syntax (Some/Ok/Err ctor
              // literals, tuple literals, array literals with non-scalar
              // elements), route through the fully-recursive `eq_for_typed` so
              // aggregate payloads (`Some([1,2])`, `Ok([1,2])`, `Some(Some(1))`,
              // `([1,2], 0)`) compare structurally instead of by word identity.
              // `known_types` is empty: this inference only ever yields builtin
              // shapes (never user struct/enum names), and unknown positions
              // carry the `__EqUnknown` marker which `eq_for_typed` compares
              // with raw `==` (status quo for that position).
              let sty = infer_static_eq_type_binop(l, r)
              let dty = match sty {
                Some(t) => if static_eq_dispatchable(t) {
                  Some(t)
                } else {
                  None
                },
                None => None
              }
              match dty {
                Some(dt) => {
                  let call = eq_for_typed(dt, rl, rr, empty_str_array())
                  if op == "==" {
                    call
                  } else {
                    ECall(EIdent("not", -1), [
                      call
                    ], -1)
                  }
                },
                None => {
                  let ty = match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {
                    Some(t) => Some(t),
                    None => infer_arg_type_name(r, struct_sets, var_types, fn_returns)
                  }
                  match ty {
                    Some(t) => if struct_set_has(struct_sets, t) {
                      let call = ECall(EIdent(String::concat(t, "::equals"), -1), [
                        rl,
                        rr
                      ], -1)
                      if op == "==" {
                        call
                      } else {
                        ECall(EIdent("not", -1), [
                          call
                        ], -1)
                      }
                    } else if t == "Option" {
                      // Bare `==` on Option-typed operands (e.g. `let a = None; a == b`)
                      // dispatches to a structural match; the runtime would otherwise
                      // identity-compare the heap-allocated nullary `None`. Payloads
                      // compare with `==` — correct for scalar payloads (the common
                      // case); an aggregate-payload bare-Option variable is a #695
                      // residual (route it through a struct field for full recursion).
                      let eqm = opt_eq_match(rl, rr)
                      if op == "==" {
                        eqm
                      } else {
                        ECall(EIdent("not", -1), [
                          eqm
                        ], -1)
                      }
                    } else if t == "Result" {
                      let eqm = result_eq_match(rl, rr)
                      if op == "==" {
                        eqm
                      } else {
                        ECall(EIdent("not", -1), [
                          eqm
                        ], -1)
                      }
                    } else {
                      EBinOp(op, rl, rr)
                    },
                    None => EBinOp(op, rl, rr)
                  }
                }
              }
            }
          }
        }
      } else if op == "<" || op == ">" || op == "<=" || op == ">=" {
        // #746: String relational lowering. The backends compile a bare
        // `<`/`>`/`<=`/`>=` as signed i64 compare — on the (ptr<<32)|len
        // string repr that orders by POINTER, not content. Rewrite to
        // `str_lex_diff(l, r) <op> 0` (a builtin returning a sign-carrying
        // lexicographic diff with length tie-break) when either ORIGINAL
        // operand is determinably String — same inference and residual
        // class as the `+` -> String::concat rewrite below.
        let rel_stringish = (match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {
          Some(t) => t == "String",
          None => false
        }) || (match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {
          Some(t) => t == "String",
          None => false
        })
        if rel_stringish {
          EBinOp(op, ECall(EIdent("str_lex_diff", -1), [
            rl,
            rr
          ], -1), EInt(0))
        } else if is_erased_generic_operand(l, r, struct_sets, var_types, fn_returns) {
          // #973: neither operand is determinably String, but at least one is
          // the bare name of an in-scope generic type parameter — the
          // concrete runtime type is erased, so dispatch at runtime instead
          // (see is_erased_generic_operand / gen_generic_rel_diff_body).
          EBinOp(op, ECall(EIdent("__generic_rel_diff", -1), [
            rl,
            rr
          ], -1), EInt(0))
        } else {
          EBinOp(op, rl, rr)
        }
      } else if op == "+" {
        // String `+` lowering: the checker types `String + String` as String,
        // but the backends compile a bare `+` as numeric i64.add — on the
        // (ptr<<32)|len string repr that adds the lengths and garbles the
        // pointer. Rewrite to String::concat when either ORIGINAL operand is
        // determinably String (literal, tracked var, string-returning call,
        // or a nested `+` chain of those). Undeterminable operands (e.g. two
        // untracked call results) keep the raw binop — same residual class
        // as #695's opaque `==`.
        let stringish = (match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {
          Some(t) => t == "String",
          None => false
        }) || (match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {
          Some(t) => t == "String",
          None => false
        })
        if stringish {
          ECall(EIdent("String::concat", -1), [
            rl,
            rr
          ], -1)
        } else if is_erased_generic_operand(l, r, struct_sets, var_types, fn_returns) {
          // #973: same erased-`[T: Add]` case as the relational branch above.
          ECall(EIdent("__generic_add", -1), [
            rl,
            rr
          ], -1)
        } else {
          EBinOp(op, rl, rr)
        }
      } else {
        EBinOp(op, rl, rr)
      }
    },
    EUnaryOp(op, e) => EUnaryOp(op, rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, rewrite_expr(body, gens, traits, struct_sets, dict_binds, seed_var_types(ps, tp, var_types), fn_returns)),
    EDot(obj, field, off, fdoff) => {
      let robj = rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      match anon_dot_rewrite(obj, field, off, robj, var_types) {
        Some(rw) => rw,
        None => EDot(robj, field, off, fdoff)
      }
    },
    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EReturn(e) => EReturn(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns))),
      None => expr
    },
    EContinue(exprs) => EContinue(for e in exprs {
      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    })
  }
}

/// Extract the member of a qualified `Head::member` name (the part after `::`).
fn member_of(name: String) -> String {
  match split_qualified(name) {
    Some(parts) => {
      let (_, member) = parts
      member
    },
    None => name
  }
}

/// Build the dict bindings in scope for a transformed generic's body.
fn dict_binds_of(threaded: Array[(String, String, Int)], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Array[(String, String, String, Array[String])] {
  let out = empty_dict_binds()
  let mut i = 0
  while i < Array::length(threaded) {
    let (tp, trait_name, _) = Array::get(threaded, i)
    let methods = match lookup_trait_sigs(traits, trait_name) {
      Some(sigs) => method_names_of_sigs(sigs),
      None => empty_str_array()
    }
    Array::push(out, (tp, trait_name, dict_param_name(trait_name, tp), methods))
    i = i + 1
  }
  out
}

/// Prepend the hidden dict parameters to a transformed generic's parameter list.
fn thread_dict_params(threaded: Array[(String, String, Int)], params: Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] {
  let result = array_empty()
  let mut i = 0
  while i < Array::length(threaded) {
    let (tp, trait_name, _) = Array::get(threaded, i)
    let dty = TyApp(dict_struct_name(trait_name), [
      TyName(tp)
    ])
    Array::push(result, (dict_param_name(trait_name, tp), Some(dty)))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(params) {
    Array::push(result, Array::get(params, j))
    j = j + 1
  }
  result
}

/// `toplevel_vars` (#839): the program's top-level anonymous-record bindings
/// (see `collect_toplevel_anon_records`), seeded as the base var_types for
/// every top-level statement's own `rewrite_expr` pass — mirrors the
/// `railway_rw_stmt` fix for the SAME `anon_dot_rewrite` call below, since this
/// is the SECOND, independent pass (the "heavy dict-passing" pass driving
/// `desugar_trait_dicts`, used by the RC/FS-compile codegen entries) that also
/// lowers `record{}.field` dot access — without this it inherited the exact
/// same "only resolves within a single top-level statement's own expression
/// tree" gap.
fn rewrite_stmt(stmt: Stmt, gens: Array[(String, Array[(String, String, Int)])], traits: Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], struct_sets: Array[(String, Array[String])], fn_returns: Array[(String, String)], toplevel_vars: Array[(String, String)]) -> Stmt with { Error } {
  let no_binds = empty_dict_binds()
  match stmt {
    SLet(exp, isrec, fname, ann, body) => match lookup_gen(gens, fname) {
      Some(threaded) => match body {
        EFn(tparams, bounds, params, ret, eff, fbody) => {
          let binds = dict_binds_of(threaded, traits)
          let new_params = thread_dict_params(threaded, params)
          let seeded = seed_var_types(params, tparams, toplevel_vars)
          let new_body = rewrite_expr(fbody, gens, traits, struct_sets, binds, seeded, fn_returns)
          SLet(exp, isrec, fname, ann, EFn(tparams, bounds, new_params, ret, eff, new_body))
        },
        _ => stmt
      },
      None => SLet(exp, isrec, fname, ann, rewrite_expr(body, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns))
    },
    SLetMut(name, ty, e) => SLetMut(name, ty, rewrite_expr(e, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),
    STest(name, body) => STest(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),
    SBench(name, body) => SBench(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),
    SExpr(e) => SExpr(rewrite_expr(e, gens, traits, struct_sets, no_binds, toplevel_vars, fn_returns)),
    SModule(exp, name, body) => SModule(exp, name, for s in body {
      rewrite_stmt(s, gens, traits, struct_sets, fn_returns, toplevel_vars)
    }),
    _ => stmt
  }
}

// ---- derive(...) structural function generation (#638) ----
//
// For a `struct P { x; y } derive(Show, Ord)` this generates the structural
// free functions `P::to_string` and `P::compare` (concrete `Type::method`,
// resolved by the PR-1 dispatch path). `Eq` stays a no-op marker (structural
// `==` is a runtime builtin). Hash / Default and enums are deferred slices.

fn qualified_name(tname: String, method: String) -> String {
  String::concat(tname, String::concat("::", method))
}

fn top_level_fn_exists(stmts: Array[Stmt], fname: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, _) => if name == fname {
        found = true
        i = Array::length(stmts)
      } else {
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  found
}

fn concat2(a: Expr, b: Expr) -> Expr {
  ECall(EIdent("String::concat", -1), [
    a,
    b
  ], -1)
}

/// A stable, fn-name-safe key for a TypeExpr, used to name the monomorphic array
/// to-string helper `__arr_to_string__<key>` so distinct element types get
/// distinct helpers. `Int` -> "Int", `Array[Int]` -> "Array_Int",
/// `Option[Int]` -> "Option_Int", `(Int,Bool)` -> "Tup_Int_Bool", else "Any".
/// (#694: mirrors #672/#695-era helper-naming so Layer-2 recursion into
/// `Array[t]` fields produces a structural — not pointer-heuristic — string.)
fn ts_type_key(ty: TypeExpr) -> String {
  match ty {
    TyName(n) => n,
    TyApp(n, args) => {
      let mut s = n
      let mut i = 0
      while i < Array::length(args) {
        s = String::concat(s, String::concat("_", ts_type_key(Array::get(args, i))))
        i = i + 1
      }
      s
    },
    TyTuple(ts) => {
      let mut s = "Tup"
      let mut i = 0
      while i < Array::length(ts) {
        s = String::concat(s, String::concat("_", ts_type_key(Array::get(ts, i))))
        i = i + 1
      }
      s
    },
    TyUnit => "Unit",
    _ => "Any"
  }
}

/// The generated monomorphic array-to-string helper name for element type `t`.
fn arr_to_string_name(t: TypeExpr) -> String {
  String::concat("__arr_to_string__", ts_type_key(t))
}

/// Produce a String expression for a value `val` whose declared type is `fty`.
/// Fully type-directed and recursive (#694 Layer 2):
///   - `String` -> verbatim
///   - scalar `TyName` -> `__to_string(val)`
///   - declared struct/enum `TyName(n)` (`known_types`) -> `n::to_string(val)`
///   - `Option[t]` -> `match val { Some(x) => "Some(" ++ show(x) ++ ")", None => "None" }`
///   - `Result[t,e]` -> `Ok(..)` / `Err(..)` structural match
///   - tuple `(t0,..,tn)` -> `"(" ++ show(t0) ++ ", " ++ .. ++ ")"`
///   - `Array[t]` -> a call to the monomorphic `__arr_to_string__<key>` helper
///   - declared generic `TyApp(n, _)` (e.g. `Box[T]`) -> `n::to_string(val)`
///   - anything else -> `__to_string(val)` (status-quo pointer/scalar heuristic)
/// The structural `Type::to_string` (and the derived `Type::hash_key` that
/// delegates to it) is therefore stable for two distinct-but-equal aggregates,
/// no matter how deeply nested.
fn show_for_typed(fty: TypeExpr, val: Expr, known_types: Array[String]) -> Expr {
  match fty {
    TyName("String") => val,
    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {
      ECall(EIdent(qualified_name(n, "to_string"), -1), Array::slice([
        val
      ], 0, 1), -1)
    } else {
      ECall(EIdent("__to_string", -1), Array::slice([
        val
      ], 0, 1), -1)
    },
    TyApp("Option", args) => if Array::length(args) == 1 {
      let t = Array::get(args, 0)
      let inner = show_for_typed(t, EIdent("__os_v", -1), known_types)
      let some_body = concat2(EString("Some("), concat2(inner, EString(")")))
      EMatch(val, Array::slice([
        (PCtor("Some", Array::slice([
          PBind("__os_v")
        ], 0, 1)), some_body),
        (PCtor("None", array_empty()), EString("None"))
      ], 0, 2))
    } else {
      ECall(EIdent("__to_string", -1), Array::slice([
        val
      ], 0, 1), -1)
    },
    TyApp("Result", args) => if Array::length(args) == 2 {
      let t = Array::get(args, 0)
      let e = Array::get(args, 1)
      let ok_inner = show_for_typed(t, EIdent("__rs_v", -1), known_types)
      let err_inner = show_for_typed(e, EIdent("__rs_v", -1), known_types)
      let ok_body = concat2(EString("Ok("), concat2(ok_inner, EString(")")))
      let err_body = concat2(EString("Err("), concat2(err_inner, EString(")")))
      EMatch(val, Array::slice([
        (PCtor("Ok", Array::slice([
          PBind("__rs_v")
        ], 0, 1)), ok_body),
        (PCtor("Err", Array::slice([
          PBind("__rs_v")
        ], 0, 1)), err_body)
      ], 0, 2))
    } else {
      ECall(EIdent("__to_string", -1), Array::slice([
        val
      ], 0, 1), -1)
    },
    TyTuple(ts) => {
      let n = Array::length(ts)
      let pats = array_empty()
      let mut i = 0
      while i < n {
        Array::push(pats, PBind(String::concat("__ts_t", idx_str(i))))
        i = i + 1
      }
      let segs = empty_expr_array()
      Array::push(segs, EString("("))
      let mut k = 0
      while k < n {
        if k > 0 {
          Array::push(segs, EString(", "))
        } else {
          ()
        }
        Array::push(segs, show_for_typed(Array::get(ts, k), EIdent(String::concat("__ts_t", idx_str(k)), -1), known_types))
        k = k + 1
      }
      Array::push(segs, EString(")"))
      let mut acc = Array::get(segs, Array::length(segs) - 1)
      let mut j = Array::length(segs) - 2
      while j >= 0 {
        acc = concat2(Array::get(segs, j), acc)
        j = j - 1
      }
      EMatch(val, Array::slice([
        (PTuple(pats), acc)
      ], 0, 1))
    },
    TyApp("Array", args) => if Array::length(args) == 1 {
      ECall(EIdent(arr_to_string_name(Array::get(args, 0)), -1), Array::slice([
        val
      ], 0, 1), -1)
    } else {
      ECall(EIdent("__to_string", -1), Array::slice([
        val
      ], 0, 1), -1)
    },
    TyApp(n, _) => if str_array_contains(known_types, n) {
      ECall(EIdent(qualified_name(n, "to_string"), -1), Array::slice([
        val
      ], 0, 1), -1)
    } else {
      ECall(EIdent("__to_string", -1), Array::slice([
        val
      ], 0, 1), -1)
    },
    _ => ECall(EIdent("__to_string", -1), Array::slice([
      val
    ], 0, 1), -1)
  }
}

/// Show a single struct field value as a String expression, by its declared type
/// (#694: type-directed and recursive — aggregate fields recurse structurally
/// instead of falling into the `__to_string` pointer heuristic).
fn field_show_expr(fname: String, fty: TypeExpr, known_types: Array[String]) -> Expr {
  show_for_typed(fty, EDot(EIdent("self", -1), fname, -1, -1), known_types)
}

/// `let __arr_to_string__<key> = (a: Array[t]) -> String {
///    "[" ++ join(show(a[0]), ", ", show(a[1]), ...) ++ "]" }` — a monomorphic,
/// fully-recursive array to-string. Element rendering goes through
/// `show_for_typed`, so `Array[Foo]` / `Array[Array[Int]]` recurse structurally
/// instead of pointer-stringifying aggregate elements. (#694 Layer 2.)
fn gen_arr_to_string_fn(elem_ty: TypeExpr, known_types: Array[String]) -> Stmt {
  let elem_get = ECall(EIdent("Array::get", -1), Array::slice([
    EIdent("a", -1),
    EIdent("__as_i", -1)
  ], 0, 2), -1)
  let elem_show = show_for_typed(elem_ty, elem_get, known_types)
  // `__as_acc = __as_acc ++ (if i == 0 { "" } else { ", " }) ++ show(a[i])`
  let sep = EIf(EBinOp("==", EIdent("__as_i", -1), EInt(0)), EString(""), EString(", "))
  let append = concat2(concat2(EIdent("__as_acc", -1), sep), elem_show)
  let set_acc = EAssign("__as_acc", append, EUnit)
  let incr = EAssign("__as_i", EBinOp("+", EIdent("__as_i", -1), EInt(1)), EUnit)
  let loop_body = ESeq(set_acc, incr)
  let while_loop = EWhile(EBinOp("<", EIdent("__as_i", -1), ECall(EIdent("Array::length", -1), Array::slice([
    EIdent("a", -1)
  ], 0, 1), -1)), loop_body)
  let closed = concat2(EIdent("__as_acc", -1), EString("]"))
  let body = ELetMut("__as_i", EInt(0), ELetMut("__as_acc", EString("["), ESeq(while_loop, closed), -1), -1)
  let arr_ty = TyApp("Array", Array::slice([
    elem_ty
  ], 0, 1))
  let params = Array::slice([
    ("a", Some(arr_ty))
  ], 0, 1)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, arr_to_string_name(elem_ty), None, EFn(no_tp, no_tb, params, Some(TyName("String")), None, body))
}

/// `let P::to_string = (self: P) -> String { "P { x: " ++ show(x) ++ ", ... }" }`
fn gen_show_fn(tname: String, fields: Array[(String, TypeExpr)], known_types: Array[String]) -> Stmt {
  let segs = empty_expr_array()
  Array::push(segs, EString(String::concat(tname, " { ")))
  let mut i = 0
  while i < Array::length(fields) {
    let (fname, fty) = Array::get(fields, i)
    let sep = if i == 0 {
      ""
    } else ", "
    Array::push(segs, EString(String::concat(sep, String::concat(fname, ": "))))
    Array::push(segs, field_show_expr(fname, fty, known_types))
    i = i + 1
  }
  Array::push(segs, EString(" }"))
  // fold right: concat(seg0, concat(seg1, ... segN))
  let mut body = Array::get(segs, Array::length(segs) - 1)
  let mut j = Array::length(segs) - 2
  while j >= 0 {
    body = concat2(Array::get(segs, j), body)
    j = j - 1
  }
  let params = Array::slice([
    ("self", Some(TyName(tname)))
  ], 0, 1)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(tname, "to_string"), None, EFn(no_tp, no_tb, params, Some(TyName("String")), None, body))
}

/// A type name that the runtime compares as a flat scalar (no structural
/// `equals` needed). Everything else named is a user struct/enum and recurses
/// through its generated `T::equals`.
fn is_scalar_type_name(n: String) -> Bool {
  n == "Int" || n == "Double" || n == "Bool" || n == "String" || n == "Char" || n == "Unit" || n == "Bytes"
}

/// A stable, fn-name-safe key for a TypeExpr, used to name the monomorphic array
/// helper `__arr_equals__<key>` so distinct element types get distinct helpers.
/// `Int` -> "Int", `Array[Int]` -> "Array_Int", `Option[Int]` -> "Option_Int",
/// `(Int,Bool)` -> "Tup_Int_Bool", unknown shapes -> "Any".
fn type_key(ty: TypeExpr) -> String {
  match ty {
    TyName(n) => n,
    TyApp(n, args) => {
      let mut s = n
      let mut i = 0
      while i < Array::length(args) {
        s = String::concat(s, String::concat("_", type_key(Array::get(args, i))))
        i = i + 1
      }
      s
    },
    TyTuple(ts) => {
      let mut s = "Tup"
      let mut i = 0
      while i < Array::length(ts) {
        s = String::concat(s, String::concat("_", type_key(Array::get(ts, i))))
        i = i + 1
      }
      s
    },
    TyUnit => "Unit",
    _ => "Any"
  }
}

/// The generated monomorphic array-equality helper name for element type `t`.
fn arr_equals_name(t: TypeExpr) -> String {
  String::concat("__arr_equals__", type_key(t))
}

/// Structural equality match for two Option operands whose element type is NOT
/// statically known here (bare `==` dispatch on Option-typed variables). Some
/// payloads compare with `==` (correct for scalars); a None matches a None.
/// (#695.)
fn opt_eq_match(lhs: Expr, rhs: Expr) -> Expr {
  let some_inner = EMatch(rhs, Array::slice([
    (PCtor("Some", Array::slice([
      PBind("__oeq_r")
    ], 0, 1)), EBinOp("==", EIdent("__oeq_l", -1), EIdent("__oeq_r", -1))),
    (PWild, EBool(false))
  ], 0, 2))
  let none_inner = EMatch(rhs, Array::slice([
    (PCtor("None", array_empty()), EBool(true)),
    (PWild, EBool(false))
  ], 0, 2))
  EMatch(lhs, Array::slice([
    (PCtor("Some", Array::slice([
      PBind("__oeq_l")
    ], 0, 1)), some_inner),
    (PCtor("None", array_empty()), none_inner)
  ], 0, 2))
}

/// Structural equality match for two Result operands of statically-unknown
/// element types (bare `==` dispatch). (#695.)
fn result_eq_match(lhs: Expr, rhs: Expr) -> Expr {
  let ok_inner = EMatch(rhs, Array::slice([
    (PCtor("Ok", Array::slice([
      PBind("__req_r")
    ], 0, 1)), EBinOp("==", EIdent("__req_l", -1), EIdent("__req_r", -1))),
    (PWild, EBool(false))
  ], 0, 2))
  let err_inner = EMatch(rhs, Array::slice([
    (PCtor("Err", Array::slice([
      PBind("__req_r")
    ], 0, 1)), EBinOp("==", EIdent("__req_l", -1), EIdent("__req_r", -1))),
    (PWild, EBool(false))
  ], 0, 2))
  EMatch(lhs, Array::slice([
    (PCtor("Ok", Array::slice([
      PBind("__req_l")
    ], 0, 1)), ok_inner),
    (PCtor("Err", Array::slice([
      PBind("__req_l")
    ], 0, 1)), err_inner)
  ], 0, 2))
}

/// Equality of two operands whose declared type is `fty`. Fully type-directed:
///   - scalar `TyName` -> raw `==`
///   - declared struct/enum `TyName(n)` -> `n::equals(lhs, rhs)`
///   - `Option[t]` / `Result[t,e]` -> inline `match` recursing on payloads
///   - `(t0,..,tn)` tuple -> inline `match` over `PTuple`, conjoining element eqs
///   - `Array[t]` -> a call to the monomorphic `__arr_equals__<key>` helper
///   - declared generic `TyApp(n, _)` (e.g. `Box[T]`) -> `n::equals(lhs, rhs)`
///   - anything else -> raw `==` (status quo fallback)
/// The runtime `eq` builtin is type-blind (it identity-compares aggregates), so
/// structural equality MUST be resolved here at the AST level where the static
/// type is known. (#695.)
fn eq_for_typed(fty: TypeExpr, lhs: Expr, rhs: Expr, known_types: Array[String]) -> Expr {
  match fty {
    TyName(n) => if n == "Double" || n == "Float" {
      // Under RC a Double is a BOXED heap value, so a raw `==` between two
      // Double fields compares box identity (always false) instead of the f64
      // payload. Wrap each operand in the identity `Double::to_float` so the
      // `==` codegen recognizes the operands as floatish (expr_is_floatish) and
      // takes the unbox-then-f64.eq path. Harmless on the non-RC backend, where
      // the wrapper is identity and the float branch compares raw bits (#704).
      EBinOp("==", ECall(EIdent("Double::to_float", -1), Array::slice([
        lhs
      ], 0, 1), -1), ECall(EIdent("Double::to_float", -1), Array::slice([
        rhs
      ], 0, 1), -1))
    } else if !is_scalar_type_name(n) && str_array_contains(known_types, n) {
      ECall(EIdent(qualified_name(n, "equals"), -1), Array::slice([
        lhs,
        rhs
      ], 0, 2), -1)
    } else {
      EBinOp("==", lhs, rhs)
    },
    TyApp("Option", args) => if Array::length(args) == 1 {
      let t = Array::get(args, 0)
      let inner_eq = eq_for_typed(t, EIdent("__oeq_l", -1), EIdent("__oeq_r", -1), known_types)
      let some_inner = EMatch(rhs, Array::slice([
        (PCtor("Some", Array::slice([
          PBind("__oeq_r")
        ], 0, 1)), inner_eq),
        (PWild, EBool(false))
      ], 0, 2))
      let none_inner = EMatch(rhs, Array::slice([
        (PCtor("None", array_empty()), EBool(true)),
        (PWild, EBool(false))
      ], 0, 2))
      EMatch(lhs, Array::slice([
        (PCtor("Some", Array::slice([
          PBind("__oeq_l")
        ], 0, 1)), some_inner),
        (PCtor("None", array_empty()), none_inner)
      ], 0, 2))
    } else {
      EBinOp("==", lhs, rhs)
    },
    TyApp("Result", args) => if Array::length(args) == 2 {
      let t = Array::get(args, 0)
      let e = Array::get(args, 1)
      let ok_eq = eq_for_typed(t, EIdent("__req_l", -1), EIdent("__req_r", -1), known_types)
      let err_eq = eq_for_typed(e, EIdent("__req_l", -1), EIdent("__req_r", -1), known_types)
      let ok_inner = EMatch(rhs, Array::slice([
        (PCtor("Ok", Array::slice([
          PBind("__req_r")
        ], 0, 1)), ok_eq),
        (PWild, EBool(false))
      ], 0, 2))
      let err_inner = EMatch(rhs, Array::slice([
        (PCtor("Err", Array::slice([
          PBind("__req_r")
        ], 0, 1)), err_eq),
        (PWild, EBool(false))
      ], 0, 2))
      EMatch(lhs, Array::slice([
        (PCtor("Ok", Array::slice([
          PBind("__req_l")
        ], 0, 1)), ok_inner),
        (PCtor("Err", Array::slice([
          PBind("__req_l")
        ], 0, 1)), err_inner)
      ], 0, 2))
    } else {
      EBinOp("==", lhs, rhs)
    },
    TyTuple(ts) => {
      let n = Array::length(ts)
      let lpats = array_empty()
      let rpats = array_empty()
      let mut i = 0
      while i < n {
        Array::push(lpats, PBind(String::concat("__teq_l", idx_str(i))))
        Array::push(rpats, PBind(String::concat("__teq_r", idx_str(i))))
        i = i + 1
      }
      let mut conj = EBool(true)
      let mut j = n - 1
      while j >= 0 {
        let cmp = eq_for_typed(Array::get(ts, j), EIdent(String::concat("__teq_l", idx_str(j)), -1), EIdent(String::concat("__teq_r", idx_str(j)), -1), known_types)
        conj = EBinOp("&&", cmp, conj)
        j = j - 1
      }
      let inner = EMatch(rhs, Array::slice([
        (PTuple(rpats), conj)
      ], 0, 1))
      EMatch(lhs, Array::slice([
        (PTuple(lpats), inner)
      ], 0, 1))
    },
    TyApp("Array", args) => if Array::length(args) == 1 {
      ECall(EIdent(arr_equals_name(Array::get(args, 0)), -1), Array::slice([
        lhs,
        rhs
      ], 0, 2), -1)
    } else {
      EBinOp("==", lhs, rhs)
    },
    TyApp(n, _) => if str_array_contains(known_types, n) {
      ECall(EIdent(qualified_name(n, "equals"), -1), Array::slice([
        lhs,
        rhs
      ], 0, 2), -1)
    } else {
      EBinOp("==", lhs, rhs)
    },
    _ => EBinOp("==", lhs, rhs)
  }
}

/// `let __arr_equals__<key> = (a: Array[t], b: Array[t]) -> Bool { ... }` — a
/// monomorphic, fully-recursive array structural equality. Element compare goes
/// through `eq_for_typed`, so `Array[Foo]` / `Array[Array[Int]]` recurse
/// correctly instead of identity-comparing aggregate elements. (#695.)
fn gen_arr_equals_fn(elem_ty: TypeExpr, known_types: Array[String]) -> Stmt {
  let len_a = ECall(EIdent("Array::length", -1), Array::slice([
    EIdent("a", -1)
  ], 0, 1), -1)
  let len_b = ECall(EIdent("Array::length", -1), Array::slice([
    EIdent("b", -1)
  ], 0, 1), -1)
  let elem_a = ECall(EIdent("Array::get", -1), Array::slice([
    EIdent("a", -1),
    EIdent("__ae_i", -1)
  ], 0, 2), -1)
  let elem_b = ECall(EIdent("Array::get", -1), Array::slice([
    EIdent("b", -1),
    EIdent("__ae_i", -1)
  ], 0, 2), -1)
  let elem_eq = eq_for_typed(elem_ty, elem_a, elem_b, known_types)
  let not_eq = ECall(EIdent("not", -1), Array::slice([
    elem_eq
  ], 0, 1), -1)
  let set_false = EIf(not_eq, EAssign("__ae_ok", EBool(false), EUnit), EUnit)
  let incr = EAssign("__ae_i", EBinOp("+", EIdent("__ae_i", -1), EInt(1)), EUnit)
  let loop_body = ESeq(set_false, incr)
  let while_loop = EWhile(EBinOp("<", EIdent("__ae_i", -1), ECall(EIdent("Array::length", -1), Array::slice([
    EIdent("a", -1)
  ], 0, 1), -1)), loop_body)
  let body_eq = ELetMut("__ae_i", EInt(0), ELetMut("__ae_ok", EBool(true), ESeq(while_loop, EIdent("__ae_ok", -1)), -1), -1)
  let body = EIf(EBinOp("!=", len_a, len_b), EBool(false), body_eq)
  let arr_ty = TyApp("Array", Array::slice([
    elem_ty
  ], 0, 1))
  let params = Array::slice([
    ("a", Some(arr_ty)),
    ("b", Some(arr_ty))
  ], 0, 2)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, arr_equals_name(elem_ty), None, EFn(no_tp, no_tb, params, Some(TyName("Bool")), None, body))
}

/// One field's equality expression: `a.f == b.f` for scalar/param fields, or a
/// direct `FieldType::equals(a.f, b.f)` for aggregate (declared struct/enum)
/// fields so nested/recursive structs compare structurally. (#672 recursion.)
fn field_eq_expr(fname: String, fty: TypeExpr, known_types: Array[String]) -> Expr {
  eq_for_typed(fty, EDot(EIdent("a", -1), fname, -1, -1), EDot(EIdent("b", -1), fname, -1, -1), known_types)
}

/// `let P::equals = (a: P, b: P) -> Bool { a.x == b.x && a.y == b.y && ... }`
/// Mirrors gen_compare_fn. Primitive fields compare with `==`; aggregate fields
/// recurse through the field type's generated `equals`. An empty struct is `true`.
fn gen_eq_fn(tname: String, fields: Array[(String, TypeExpr)], known_types: Array[String]) -> Stmt {
  let mut body = EBool(true)
  let mut i = Array::length(fields) - 1
  while i >= 0 {
    let (fname, fty) = Array::get(fields, i)
    body = EBinOp("&&", field_eq_expr(fname, fty, known_types), body)
    i = i - 1
  }
  let params = Array::slice([
    ("a", Some(TyName(tname))),
    ("b", Some(TyName(tname)))
  ], 0, 2)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(tname, "equals"), None, EFn(no_tp, no_tb, params, Some(TyName("Bool")), None, body))
}

/// Small non-negative Int -> decimal String (Int::to_string is not in scope in
/// this module). Used only to make unique enum-field binder names.
fn digit_str(d: Int) -> String {
  if d == 0 {
    "0"
  } else if d == 1 {
    "1"
  } else if d == 2 {
    "2"
  } else if d == 3 {
    "3"
  } else if d == 4 {
    "4"
  } else if d == 5 {
    "5"
  } else if d == 6 {
    "6"
  } else if d == 7 {
    "7"
  } else if d == 8 {
    "8"
  } else {
    "9"
  }
}

fn idx_str(n: Int) -> String {
  if n < 10 {
    digit_str(n)
  } else {
    String::concat(idx_str(n / 10), digit_str(n % 10))
  }
}

/// `let E::equals = (a: E, b: E) -> Bool {
///    match a {
///      V1(_a0, _a1) => match b { V1(_b0, _b1) => _a0 == _b0 && _a1 == _b1, _ => false },
///      V2          => match b { V2 => true, _ => false }, ... } }`
/// Tag mismatch falls to the inner `_ => false`; payload `==` is itself
/// dispatched, so aggregate payloads recurse into their own `equals`.
fn gen_enum_eq_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {
  let outer_arms = array_empty()
  let mut vi = 0
  while vi < Array::length(variants) {
    let (vname, ftypes) = Array::get(variants, vi)
    let nf = Array::length(ftypes)
    let abinds = array_empty()
    let bbinds = array_empty()
    let mut fi = 0
    while fi < nf {
      Array::push(abinds, PBind(String::concat("__a", idx_str(fi))))
      Array::push(bbinds, PBind(String::concat("__b", idx_str(fi))))
      fi = fi + 1
    }
    let mut body = EBool(true)
    let mut bi = nf - 1
    while bi >= 0 {
      let cmp = eq_for_typed(Array::get(ftypes, bi), EIdent(String::concat("__a", idx_str(bi)), -1), EIdent(String::concat("__b", idx_str(bi)), -1), known_types)
      body = EBinOp("&&", cmp, body)
      bi = bi - 1
    }
    let inner_arms = Array::slice([
      (PCtor(vname, bbinds), body),
      (PWild, EBool(false))
    ], 0, 2)
    let inner = EMatch(EIdent("b", -1), inner_arms)
    Array::push(outer_arms, (PCtor(vname, abinds), inner))
    vi = vi + 1
  }
  let params = Array::slice([
    ("a", Some(TyName(ename))),
    ("b", Some(TyName(ename)))
  ], 0, 2)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(ename, "equals"), None, EFn(no_tp, no_tb, params, Some(TyName("Bool")), None, EMatch(EIdent("a", -1), outer_arms)))
}

/// `let P::compare = (a: P, b: P) -> Int { lexicographic over fields -> -1/0/1 }`
fn gen_compare_fn(tname: String, fields: Array[(String, TypeExpr)]) -> Stmt {
  let neg_one = 0 - 1
  let mut body = EInt(0)
  let mut i = Array::length(fields) - 1
  while i >= 0 {
    let (fname, _) = Array::get(fields, i)
    let af = EDot(EIdent("a", -1), fname, -1, -1)
    let bf = EDot(EIdent("b", -1), fname, -1, -1)
    body = EIf(EBinOp("<", af, bf), EInt(neg_one), EIf(EBinOp(">", af, bf), EInt(1), body))
    i = i - 1
  }
  let params = Array::slice([
    ("a", Some(TyName(tname))),
    ("b", Some(TyName(tname)))
  ], 0, 2)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(tname, "compare"), None, EFn(no_tp, no_tb, params, Some(TyName("Int")), None, body))
}

/// Show an arbitrary value expression by its declared type (#694: type-directed
/// and recursive via `show_for_typed`, so aggregate enum payloads — nested
/// struct/enum, Option, Result, tuple, Array — render structurally instead of
/// through the `__to_string` pointer heuristic).
fn show_expr_typed(val: Expr, fty: TypeExpr, known_types: Array[String]) -> Expr {
  show_for_typed(fty, val, known_types)
}

/// `let E::to_string = (self: E) -> String {
///    match self { V0(_a0, _a1) => "V0(" ++ show(_a0) ++ ", " ++ show(_a1) ++ ")",
///                 V1 => "V1", ... } }`
/// A nullary variant shows as its bare name; a payload variant shows as
/// `Name(p0, p1, ...)` with each payload shown structurally.
fn gen_enum_show_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {
  let arms = array_empty()
  let mut vi = 0
  while vi < Array::length(variants) {
    let (vname, ftypes) = Array::get(variants, vi)
    let nf = Array::length(ftypes)
    let binds = array_empty()
    let mut fi = 0
    while fi < nf {
      Array::push(binds, PBind(String::concat("__s", idx_str(fi))))
      fi = fi + 1
    }
    let body = if nf == 0 {
      EString(vname)
    } else {
      let segs = empty_expr_array()
      Array::push(segs, EString(String::concat(vname, "(")))
      let mut si = 0
      while si < nf {
        let sep = if si == 0 {
          ""
        } else ", "
        if sep != "" {
          Array::push(segs, EString(sep))
        } else {
          ()
        }
        Array::push(segs, show_expr_typed(EIdent(String::concat("__s", idx_str(si)), -1), Array::get(ftypes, si), known_types))
        si = si + 1
      }
      Array::push(segs, EString(")"))
      let mut acc = Array::get(segs, Array::length(segs) - 1)
      let mut j = Array::length(segs) - 2
      while j >= 0 {
        acc = concat2(Array::get(segs, j), acc)
        j = j - 1
      }
      acc
    }
    Array::push(arms, (PCtor(vname, binds), body))
    vi = vi + 1
  }
  let params = Array::slice([
    ("self", Some(TyName(ename)))
  ], 0, 1)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(ename, "to_string"), None, EFn(no_tp, no_tb, params, Some(TyName("String")), None, EMatch(EIdent("self", -1), arms)))
}

/// `let T::hash_key = (self: T) -> String { T::to_string(self) }` (#694 Layer 1).
/// `derive(Hash)` makes a type usable as a Map key via the method-bearing `Hash`
/// trait (`hash_key(Self) -> String`): `map_key_to_string = [K: Hash](key) ->
/// K::hash_key(key)` threads the witness (#684), and at a concrete call site
/// `get_by(m, T::{..})` the synthesized `HashDict::{ hash_key: T::hash_key }`
/// resolves here. The key is the structural `to_string` (now fully recursive via
/// `show_for_typed`), so two distinct-but-field-equal values hash to one entry.
fn gen_hash_key_fn(tname: String) -> Stmt {
  let body = ECall(EIdent(qualified_name(tname, "to_string"), -1), Array::slice([
    EIdent("self", -1)
  ], 0, 1), -1)
  let params = Array::slice([
    ("self", Some(TyName(tname)))
  ], 0, 1)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(tname, "hash_key"), None, EFn(no_tp, no_tb, params, Some(TyName("String")), None, body))
}

/// Append any `Array[e]` element types referenced by a TypeExpr to `acc`
/// (dedup by type-key), so a Show/Hash-deriving type with an `Array[t]` field or
/// payload gets a generated `__arr_to_string__<key>` helper. (#694 Layer 2.)
fn collect_show_array_elems(ty: TypeExpr, acc: Array[TypeExpr], keys: Array[String]) -> Unit {
  match ty {
    TyApp("Array", args) => if Array::length(args) == 1 {
      let et = Array::get(args, 0)
      let k = ts_type_key(et)
      if str_array_contains(keys, k) {
        ()
      } else {
        Array::push(keys, k)
        Array::push(acc, et)
      }
    } else {
      ()
    },
    _ => ()
  }
}

/// Compare two operands of declared type `fty`, returning -1/0/1. Aggregate
/// (declared struct/enum) operands recurse through `T::compare`; scalars and type
/// parameters use the runtime structural `<` / `>` (codegen handles them).
fn compare_for_typed(fty: TypeExpr, lhs: Expr, rhs: Expr, known_types: Array[String]) -> Expr {
  let neg_one = 0 - 1
  match fty {
    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {
      ECall(EIdent(qualified_name(n, "compare"), -1), Array::slice([
        lhs,
        rhs
      ], 0, 2), -1)
    } else {
      EIf(EBinOp("<", lhs, rhs), EInt(neg_one), EIf(EBinOp(">", lhs, rhs), EInt(1), EInt(0)))
    },
    _ => EIf(EBinOp("<", lhs, rhs), EInt(neg_one), EIf(EBinOp(">", lhs, rhs), EInt(1), EInt(0)))
  }
}

/// `let E::compare = (a: E, b: E) -> Int { ... }`
/// Lexicographic: first by variant order (a's tag index vs b's tag index), then
/// (same variant) by payload, recursively. The variant index of `a` is computed
/// by matching `a`; for each `a` variant the inner match on `b` either compares
/// payloads (same variant) or returns the sign of (a_index - b_index).
fn gen_enum_compare_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {
  let neg_one = 0 - 1
  let outer_arms = array_empty()
  let mut ai = 0
  while ai < Array::length(variants) {
    let (avname, aftypes) = Array::get(variants, ai)
    let anf = Array::length(aftypes)
    let abinds = array_empty()
    let mut afi = 0
    while afi < anf {
      Array::push(abinds, PBind(String::concat("__a", idx_str(afi))))
      afi = afi + 1
    }
    // inner match over b: for the same variant compare payloads; otherwise the
    // sign comes from the variant order (a before b -> -1, after -> 1).
    let inner_arms = array_empty()
    let mut bi = 0
    while bi < Array::length(variants) {
      let (bvname, bftypes) = Array::get(variants, bi)
      let bnf = Array::length(bftypes)
      let bbinds = array_empty()
      let mut bfi = 0
      while bfi < bnf {
        Array::push(bbinds, PBind(String::concat("__b", idx_str(bfi))))
        bfi = bfi + 1
      }
      let arm_body = if ai == bi {
        // same variant: lexicographic over payloads, 0 if no payload.
        let mut body = EInt(0)
        let mut pi = anf - 1
        while pi >= 0 {
          let cmp = compare_for_typed(Array::get(aftypes, pi), EIdent(String::concat("__a", idx_str(pi)), -1), EIdent(String::concat("__b", idx_str(pi)), -1), known_types)
          let prev = body
          body = EIf(EBinOp("<", cmp, EInt(0)), EInt(neg_one), EIf(EBinOp(">", cmp, EInt(0)), EInt(1), prev))
          pi = pi - 1
        }
        body
      } else if ai < bi {
        EInt(neg_one)
      } else {
        EInt(1)
      }
      Array::push(inner_arms, (PCtor(bvname, bbinds), arm_body))
      bi = bi + 1
    }
    Array::push(outer_arms, (PCtor(avname, abinds), EMatch(EIdent("b", -1), inner_arms)))
    ai = ai + 1
  }
  let params = Array::slice([
    ("a", Some(TyName(ename))),
    ("b", Some(TyName(ename)))
  ], 0, 2)
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(ename, "compare"), None, EFn(no_tp, no_tb, params, Some(TyName("Int")), None, EMatch(EIdent("a", -1), outer_arms)))
}

/// The default value expression for a declared field type. Per-type rules:
///   Int -> 0, Double/Float -> 0.0, Bool -> false, String -> "", Unit -> (),
///   Option[_] -> None, Array[_] -> empty array, and a declared struct/enum
///   (in `known_types`) -> `T::default()`. A type with no sensible default (a
///   bare type parameter, a function/tuple type, an unknown name) falls back to
///   `()` — codegen will then flag the literal against the field's real type, so
///   the limitation surfaces as a type error rather than silently wrong data.
fn default_for_type(fty: TypeExpr, known_types: Array[String]) -> Expr {
  match fty {
    TyName("Int") => EInt(0),
    TyName("Double") => EFloat(0.0),
    TyName("Float") => EFloat(0.0),
    TyName("Bool") => EBool(false),
    TyName("String") => EString(""),
    TyName("Unit") => EUnit,
    TyName(n) => if str_array_contains(known_types, n) {
      ECall(EIdent(qualified_name(n, "default"), -1), empty_expr_array(), -1)
    } else {
      EUnit
    },
    TyApp("Option", _) => EIdent("None", -1),
    TyApp("Array", _) => EArray(empty_expr_array()),
    TyApp(n, _) => if str_array_contains(known_types, n) {
      ECall(EIdent(qualified_name(n, "default"), -1), empty_expr_array(), -1)
    } else {
      EUnit
    },
    TyUnit => EUnit,
    _ => EUnit
  }
}

/// `let P::default = () -> P { P::{ f1: <default>, ... } }` — a struct literal
/// (ERecord; the struct type is recovered from the field set) with each field at
/// its type's default.
fn gen_default_fn(tname: String, fields: Array[(String, TypeExpr)], known_types: Array[String]) -> Stmt {
  let rec_fields = array_empty()
  let mut i = 0
  while i < Array::length(fields) {
    let (fname, fty) = Array::get(fields, i)
    Array::push(rec_fields, (fname, default_for_type(fty, known_types)))
    i = i + 1
  }
  let no_params = array_empty()
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(tname, "default"), None, EFn(no_tp, no_tb, no_params, Some(TyName(tname)), None, ERecord("", rec_fields, empty_ty_args())))
}

/// `let E::default = () -> E { V0(<default>, ...) }` — the FIRST variant, with
/// each payload slot at its type's default (nullary -> bare constructor name).
fn gen_enum_default_fn(ename: String, variants: Array[(String, Array[TypeExpr])], known_types: Array[String]) -> Stmt {
  let (vname, ftypes) = Array::get(variants, 0)
  let body = if Array::length(ftypes) == 0 {
    EIdent(vname, -1)
  } else {
    let args = empty_expr_array()
    let mut i = 0
    while i < Array::length(ftypes) {
      Array::push(args, default_for_type(Array::get(ftypes, i), known_types))
      i = i + 1
    }
    ECall(EIdent(vname, -1), args, -1)
  }
  let no_params = array_empty()
  let no_tp = array_empty()
  let no_tb = array_empty()
  SLet(false, false, qualified_name(ename, "default"), None, EFn(no_tp, no_tb, no_params, Some(TyName(ename)), None, body))
}

/// Scan `ty` and, for every `Array[e]` shape found anywhere inside it, append the
/// element type `e` to `acc` (deduped by `type_key`). Only the immediate element
/// types are added here; transitive nesting (`Array[Array[Int]]` needs the
/// `Array[Int]` helper too) is closed by the worklist loop in the caller, which
/// re-scans every element type it collects. (#695.)
fn collect_array_elem_types(ty: TypeExpr, acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {
  match ty {
    TyApp("Array", args) => if Array::length(args) == 1 {
      let e = Array::get(args, 0)
      let k = type_key(e)
      if !str_array_contains(acc_keys, k) {
        Array::push(acc, e)
        Array::push(acc_keys, k)
      } else {
        ()
      }
      collect_array_elem_types(e, acc, acc_keys)
    } else {
      ()
    },
    TyApp(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        collect_array_elem_types(Array::get(args, i), acc, acc_keys)
        i = i + 1
      }
    },
    TyTuple(ts) => {
      let mut i = 0
      while i < Array::length(ts) {
        collect_array_elem_types(Array::get(ts, i), acc, acc_keys)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// Best-effort element TypeExpr of an array LITERAL, inferred from its first
/// element: scalars and nested array literals only. An empty array, or a first
/// element whose type is not statically obvious here (variables, struct records,
/// calls), yields `None` — the caller then leaves a bare-array `==` as the
/// status-quo scalar binop (documented #695 residual) rather than guessing.
/// Is `e` an empty array literal `[]`? Used to reduce `[] == x` to a length check.
fn is_empty_array_lit(e: Expr) -> Bool {
  match e {
    EArray(elems) => Array::length(elems) == 0,
    _ => false
  }
}

fn infer_earray_elem_type(arr: Expr) -> Option[TypeExpr] {
  match arr {
    EArray(elems) => if Array::length(elems) == 0 {
      None
    } else {
      match Array::get(elems, 0) {
        EInt(_) => Some(TyName("Int")),
        EBool(_) => Some(TyName("Bool")),
        EString(_) => Some(TyName("String")),
        EFloat(_) => Some(TyName("Double")),
        EArray(_) => match infer_earray_elem_type(Array::get(elems, 0)) {
          Some(inner) => Some(TyApp("Array", Array::slice([
            inner
          ], 0, 1))),
          None => None
        },
        _ => None
      }
    },
    _ => None
  }
}

/// #825: does `t` contain the `__EqUnknown` marker anywhere? Used to keep the
/// marker out of generated `__arr_equals__<key>` helper names/annotations (an
/// Array element type must be fully concrete to be usable).
fn ty_contains_eq_unknown(t: TypeExpr) -> Bool {
  match t {
    TyName(n) => n == "__EqUnknown",
    TyApp(_, args) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if ty_contains_eq_unknown(Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyTuple(ts) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(ts) {
        if ty_contains_eq_unknown(Array::get(ts, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

/// #825: best-effort full STATIC TypeExpr of a bare `==` operand, inferred from
/// literal syntax alone (no environment). Where the name-based `==` dispatch
/// only recovers a head name ("Option"/"Result") and compares payloads with a
/// raw word `==`, this recovers the payload SHAPE too, so
/// `Some([1,2]) == Some([1,2])` / `Ok([1,2]) == Ok([1,2])` /
/// `Some(Some(1)) == Some(Some(1))` / `([1,2], 0) == ([1,2], 0)` route through
/// the fully-recursive `eq_for_typed` instead of identity-comparing aggregate
/// payloads. A position whose type is not statically obvious yields the marker
/// `TyName("__EqUnknown")` — never a scalar or declared type, so `eq_for_typed`
/// falls back to raw `==` there (exactly the status-quo behavior for that
/// position). An Array element type must be marker-free (else the whole array
/// is uninferable): the element type names the generated `__arr_equals__<key>`
/// helper and appears in its parameter annotations, where the marker would not
/// resolve.
fn infer_static_eq_type(e: Expr) -> Option[TypeExpr] {
  match e {
    EInt(_) => Some(TyName("Int")),
    EBool(_) => Some(TyName("Bool")),
    EString(_) => Some(TyName("String")),
    EFloat(_) => Some(TyName("Double")),
    EUnit => Some(TyUnit),
    EArray(elems) => if Array::length(elems) == 0 {
      None
    } else {
      match infer_static_eq_type(Array::get(elems, 0)) {
        Some(t) => if ty_contains_eq_unknown(t) {
          None
        } else {
          Some(TyApp("Array", Array::slice([
            t
          ], 0, 1)))
        },
        None => None
      }
    },
    ETuple(es) => {
      let ts = empty_type_exprs()
      let mut i = 0
      while i < Array::length(es) {
        match infer_static_eq_type(Array::get(es, i)) {
          Some(t) => Array::push(ts, t),
          None => Array::push(ts, TyName("__EqUnknown"))
        }
        i = i + 1
      }
      Some(TyTuple(ts))
    },
    EIdent(n, _) => if n == "None" {
      Some(TyApp("Option", Array::slice([
        TyName("__EqUnknown")
      ], 0, 1)))
    } else {
      None
    },
    ECall(callee, args, _) => match callee {
      // #825 review follow-up: the docs' qualified ctor spellings
      // (`Option::Some` / `Result::Ok` / `Result::Err`) must infer the same
      // shape as the bare forms — they fell through to the name-only path
      // where aggregate payloads word-compare.
      EIdent("Option::Some", _) => if Array::length(args) == 1 {
        let pt = match infer_static_eq_type(Array::get(args, 0)) {
          Some(t) => t,
          None => TyName("__EqUnknown")
        }
        Some(TyApp("Option", Array::slice([
          pt
        ], 0, 1)))
      } else {
        None
      },
      EIdent("Result::Ok", _) => if Array::length(args) == 1 {
        let pt = match infer_static_eq_type(Array::get(args, 0)) {
          Some(t) => t,
          None => TyName("__EqUnknown")
        }
        Some(TyApp("Result", Array::slice([
          pt,
          TyName("__EqUnknown")
        ], 0, 2)))
      } else {
        None
      },
      EIdent("Result::Err", _) => if Array::length(args) == 1 {
        let pt = match infer_static_eq_type(Array::get(args, 0)) {
          Some(t) => t,
          None => TyName("__EqUnknown")
        }
        Some(TyApp("Result", Array::slice([
          TyName("__EqUnknown"),
          pt
        ], 0, 2)))
      } else {
        None
      },
      EIdent("Some", _) => if Array::length(args) == 1 {
        let pt = match infer_static_eq_type(Array::get(args, 0)) {
          Some(t) => t,
          None => TyName("__EqUnknown")
        }
        Some(TyApp("Option", Array::slice([
          pt
        ], 0, 1)))
      } else {
        None
      },
      EIdent("Ok", _) => if Array::length(args) == 1 {
        let pt = match infer_static_eq_type(Array::get(args, 0)) {
          Some(t) => t,
          None => TyName("__EqUnknown")
        }
        Some(TyApp("Result", Array::slice([
          pt,
          TyName("__EqUnknown")
        ], 0, 2)))
      } else {
        None
      },
      EIdent("Err", _) => if Array::length(args) == 1 {
        let pt = match infer_static_eq_type(Array::get(args, 0)) {
          Some(t) => t,
          None => TyName("__EqUnknown")
        }
        Some(TyApp("Result", Array::slice([
          TyName("__EqUnknown"),
          pt
        ], 0, 2)))
      } else {
        None
      },
      _ => None
    },
    _ => None
  }
}

/// #825 review follow-up: pick the static shape for `l == r` from whichever
/// side is MORE concrete. A left-first choice masked a fully concrete right
/// shape — `let xs = [1, 2]; Some(xs) == Some([1, 2])` inferred the left as
/// `Option[__EqUnknown]` and the payload fell back to raw word `==`. Prefer a
/// marker-free shape; between two partial shapes keep the left one.
fn infer_static_eq_type_binop(l: Expr, r: Expr) -> Option[TypeExpr] {
  let lt = infer_static_eq_type(l)
  let rt = infer_static_eq_type(r)
  match lt {
    Some(lty) => if ty_contains_eq_unknown(lty) {
      match rt {
        Some(rty) => if ty_contains_eq_unknown(rty) {
          Some(lty)
        } else {
          Some(rty)
        },
        None => Some(lty)
      }
    } else {
      Some(lty)
    },
    None => rt
  }
}

/// #825: shapes worth dispatching through `eq_for_typed` at a bare `==` site.
/// Only the aggregate shapes the runtime word-compare gets wrong; scalars keep
/// the raw binop and anything unrecognized falls back to the name-based
/// dispatch (which preserves the pre-#825 behavior).
fn static_eq_dispatchable(t: TypeExpr) -> Bool {
  match t {
    TyApp(n, args) => (n == "Option" && Array::length(args) == 1) || (n == "Result" && Array::length(args) == 2) || (n == "Array" && Array::length(args) == 1),
    TyTuple(_) => true,
    _ => false
  }
}

/// Walk an expression and, for every `a == b` / `a != b` whose operand is an
/// array LITERAL with a determinable element type, collect that element type so a
/// `__arr_equals__<key>` helper is generated for the dispatch rewrite to call.
fn collect_bare_array_eq_keys(e: Expr, acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {
  match e {
    EBinOp(op, l, r) => {
      if op == "==" || op == "!=" {
        let et = match infer_earray_elem_type(l) {
          Some(t) => Some(t),
          None => infer_earray_elem_type(r)
        }
        match et {
          Some(t) => {
            let k = type_key(t)
            if !str_array_contains(acc_keys, k) {
              Array::push(acc, t)
              Array::push(acc_keys, k)
            } else {
              ()
            }
            collect_array_elem_types(t, acc, acc_keys)
          },
          None => ()
        }
        // #825: the full static-shape dispatch can surface Array element types
        // nested inside Option/Result/tuple literals (`Some([1,2]) == ...`,
        // `([1,2], 0) == ...`, `[Some(1)] == ...`) — collect them so their
        // `__arr_equals__<key>` helpers exist for `eq_for_typed`'s calls.
        let sty = infer_static_eq_type_binop(l, r)
        match sty {
          Some(t2) => collect_array_elem_types(t2, acc, acc_keys),
          None => ()
        }
      } else {
        ()
      }
      collect_bare_array_eq_keys(l, acc, acc_keys)
      collect_bare_array_eq_keys(r, acc, acc_keys)
    },
    EInt(_) => (),
    EFloat(_) => (),
    EString(_) => (),
    EBool(_) => (),
    EIdent(_, _) => (),
    EUnit => (),
    ETuple(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),
    EArray(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),
    ERecord(_, fs, _) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, fe) = Array::get(fs, i)
        collect_bare_array_eq_keys(fe, acc, acc_keys)
        i = i + 1
      }
    },
    EMap(fs) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, fe) = Array::get(fs, i)
        collect_bare_array_eq_keys(fe, acc, acc_keys)
        i = i + 1
      }
    },
    EIf(c, t, el) => {
      collect_bare_array_eq_keys(c, acc, acc_keys)
      collect_bare_array_eq_keys(t, acc, acc_keys)
      collect_bare_array_eq_keys(el, acc, acc_keys)
    },
    ELet(_, v, b, _) => {
      collect_bare_array_eq_keys(v, acc, acc_keys)
      collect_bare_array_eq_keys(b, acc, acc_keys)
    },
    ELetRec(_, v, b) => {
      collect_bare_array_eq_keys(v, acc, acc_keys)
      collect_bare_array_eq_keys(b, acc, acc_keys)
    },
    ELetMut(_, v, b, _) => {
      collect_bare_array_eq_keys(v, acc, acc_keys)
      collect_bare_array_eq_keys(b, acc, acc_keys)
    },
    EAssign(_, v, c) => {
      collect_bare_array_eq_keys(v, acc, acc_keys)
      collect_bare_array_eq_keys(c, acc, acc_keys)
    },
    EAssignOp(_, _, v, c) => {
      collect_bare_array_eq_keys(v, acc, acc_keys)
      collect_bare_array_eq_keys(c, acc, acc_keys)
    },
    ESeq(a, b) => {
      collect_bare_array_eq_keys(a, acc, acc_keys)
      collect_bare_array_eq_keys(b, acc, acc_keys)
    },
    EMatch(s, arms) => {
      collect_bare_array_eq_keys(s, acc, acc_keys)
      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)
    },
    EHandle(s, arms) => {
      collect_bare_array_eq_keys(s, acc, acc_keys)
      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)
    },
    EWhile(c, b) => {
      collect_bare_array_eq_keys(c, acc, acc_keys)
      collect_bare_array_eq_keys(b, acc, acc_keys)
    },
    ELoop(params, b) => {
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        collect_bare_array_eq_keys(init, acc, acc_keys)
        i = i + 1
      }
      collect_bare_array_eq_keys(b, acc, acc_keys)
    },
    EForIn(_, _, it, b) => {
      collect_bare_array_eq_keys(it, acc, acc_keys)
      collect_bare_array_eq_keys(b, acc, acc_keys)
    },
    ECall(callee, args, _) => {
      collect_bare_array_eq_keys(callee, acc, acc_keys)
      collect_bare_array_eq_keys_list(args, acc, acc_keys)
    },
    EUnaryOp(_, x) => collect_bare_array_eq_keys(x, acc, acc_keys),
    EFn(_, _, _, _, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),
    EDot(o, _, _, _) => collect_bare_array_eq_keys(o, acc, acc_keys),
    ELabeledArg(_, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),
    EReturn(x) => collect_bare_array_eq_keys(x, acc, acc_keys),
    EBreak(opt) => match opt {
      Some(x) => collect_bare_array_eq_keys(x, acc, acc_keys),
      None => ()
    },
    EContinue(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),
    ESpread(x) => collect_bare_array_eq_keys(x, acc, acc_keys),
    _ => ()
  }
}

fn collect_bare_array_eq_keys_list(es: Array[Expr], acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(es) {
    collect_bare_array_eq_keys(Array::get(es, i), acc, acc_keys)
    i = i + 1
  }
}

fn collect_bare_array_eq_keys_arms(arms: Array[(Pat, Expr)], acc: Array[TypeExpr], acc_keys: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (_, b) = Array::get(arms, i)
    collect_bare_array_eq_keys(b, acc, acc_keys)
    i = i + 1
  }
}

/// In-place: for each struct with `derive(Show/Ord)`, append the structural
/// function if not already present (idempotent across the double-run pipeline).
/// The set of concrete struct/enum names declared in the program — the gate for
/// emitting DIRECT `T::equals` calls in generated comparators (a field/arg whose
/// type name is NOT here, e.g. a type parameter `T` of `Box[T]`, falls back to
/// scalar `==`, since there is no `T::equals` to call).
fn collect_decl_type_names(stmts: Array[Stmt]) -> Array[String] {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, name, _, _, _, _) => Array::push(out, name),
      SEnum(_, ename, _, _, _) => Array::push(out, ename),
      _ => ()
    }
    i = i + 1
  }
  out
}

export fn desugar_derives(stmts: Array[Stmt]) -> Unit {
  let gen = empty_stmt_list()
  let known_types = collect_decl_type_names(stmts)
  // #694 Layer 2: collect `Array[e]` element types referenced by Show/Hash-
  // deriving types' fields/payloads, so each gets a `__arr_to_string__<key>`
  // helper. A worklist closes nesting (`Array[Array[Int]]` -> `Array[Int]`).
  let arr_elems = empty_type_exprs()
  let arr_keys = empty_str_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, name, fields, derives, _, _) => {
        // `derive(Hash)` also needs the structural `to_string`: a Hash type's
        // stable Map-key string is its structural representation (#638), so
        // generate `to_string` for Show OR Hash.
        if (str_array_contains(derives, "Show") || str_array_contains(derives, "Hash")) && !top_level_fn_exists(stmts, qualified_name(name, "to_string")) {
          Array::push(gen, gen_show_fn(name, fields, known_types))
        } else {
          ()
        }
        // #694 Layer 1: `derive(Hash)` -> structural `T::hash_key` (delegates to
        // the recursive `to_string`), so the method-bearing `Hash` witness at a
        // `get_by(m, T::{..})` call site resolves to a stable structural key.
        if str_array_contains(derives, "Hash") && !top_level_fn_exists(stmts, qualified_name(name, "hash_key")) {
          Array::push(gen, gen_hash_key_fn(name))
        } else {
          ()
        }
        if str_array_contains(derives, "Show") || str_array_contains(derives, "Hash") {
          let mut fi = 0
          while fi < Array::length(fields) {
            let (_, fty) = Array::get(fields, fi)
            collect_show_array_elems(fty, arr_elems, arr_keys)
            fi = fi + 1
          }
        } else {
          ()
        }
        if str_array_contains(derives, "Ord") && !top_level_fn_exists(stmts, qualified_name(name, "compare")) {
          Array::push(gen, gen_compare_fn(name, fields))
        } else {
          ()
        }
        if str_array_contains(derives, "Default") && !top_level_fn_exists(stmts, qualified_name(name, "default")) {
          Array::push(gen, gen_default_fn(name, fields, known_types))
        } else {
          ()
        }
        // Generate `T::equals` for every struct (not just derive(Eq)) so the
        // `==` dispatch below always resolves; structural equality is the
        // sensible default for any struct, and a struct never relied on the old
        // pointer-identity `==` (which was silently always-false).
        if !top_level_fn_exists(stmts, qualified_name(name, "equals")) {
          Array::push(gen, gen_eq_fn(name, fields, known_types))
        } else {
          ()
        }
      },
      SEnum(_, ename, _, variants, derives) => {
        if (str_array_contains(derives, "Show") || str_array_contains(derives, "Hash")) && !top_level_fn_exists(stmts, qualified_name(ename, "to_string")) {
          Array::push(gen, gen_enum_show_fn(ename, variants, known_types))
        } else {
          ()
        }
        if str_array_contains(derives, "Hash") && !top_level_fn_exists(stmts, qualified_name(ename, "hash_key")) {
          Array::push(gen, gen_hash_key_fn(ename))
        } else {
          ()
        }
        if str_array_contains(derives, "Show") || str_array_contains(derives, "Hash") {
          let mut vi = 0
          while vi < Array::length(variants) {
            let (_, ftypes) = Array::get(variants, vi)
            let mut ti = 0
            while ti < Array::length(ftypes) {
              collect_show_array_elems(Array::get(ftypes, ti), arr_elems, arr_keys)
              ti = ti + 1
            }
            vi = vi + 1
          }
        } else {
          ()
        }
        if str_array_contains(derives, "Ord") && !top_level_fn_exists(stmts, qualified_name(ename, "compare")) {
          Array::push(gen, gen_enum_compare_fn(ename, variants, known_types))
        } else {
          ()
        }
        if str_array_contains(derives, "Default") && !top_level_fn_exists(stmts, qualified_name(ename, "default")) {
          Array::push(gen, gen_enum_default_fn(ename, variants, known_types))
        } else {
          ()
        }
        // Generate `E::equals` for every enum (same rationale as structs), so
        // the `==` dispatch resolves enum operands too.
        if !top_level_fn_exists(stmts, qualified_name(ename, "equals")) {
          Array::push(gen, gen_enum_eq_fn(ename, variants, known_types))
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  // #695: collect every `Array[e]` element type referenced by struct fields /
  // enum payloads (transitively) plus those surfaced by bare-array `==` sites in
  // user code, then emit one monomorphic `__arr_equals__<key>` helper per
  // distinct key. The worklist closes nesting: scanning element type `e` may
  // surface a further `Array[u]` whose helper is also required. Idempotent:
  // guarded by `top_level_fn_exists` so re-running the pass is inert.
  let elem_types = empty_type_exprs()
  let elem_keys = empty_str_array()
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      SStruct(_, _, fields, _, _, _) => {
        let mut fi = 0
        while fi < Array::length(fields) {
          let (_, fty) = Array::get(fields, fi)
          collect_array_elem_types(fty, elem_types, elem_keys)
          fi = fi + 1
        }
      },
      SEnum(_, _, _, variants, _) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (_, ftypes) = Array::get(variants, vi)
          let mut ti = 0
          while ti < Array::length(ftypes) {
            collect_array_elem_types(Array::get(ftypes, ti), elem_types, elem_keys)
            ti = ti + 1
          }
          vi = vi + 1
        }
      },
      SLet(_, _, _, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),
      SLetMut(_, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),
      SExpr(e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),
      STest(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),
      SBench(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),
      _ => ()
    }
    si = si + 1
  }
  // Worklist closure: scanning each collected element type can surface further
  // nested array element types (e.g. `Array[Array[Int]]` -> `Array[Int]`).
  let mut wi = 0
  while wi < Array::length(elem_types) {
    collect_array_elem_types(Array::get(elem_types, wi), elem_types, elem_keys)
    wi = wi + 1
  }
  let mut ei = 0
  while ei < Array::length(elem_types) {
    let et = Array::get(elem_types, ei)
    if !top_level_fn_exists(stmts, arr_equals_name(et)) {
      Array::push(gen, gen_arr_equals_fn(et, known_types))
    } else {
      ()
    }
    ei = ei + 1
  }
  // #694: emit `__arr_to_string__<key>` helpers for Array element types
  // referenced by Show/Hash-deriving fields/payloads (`arr_elems` populated in
  // the struct/enum arms above). Independent of the #695 `__arr_equals__` set.
  let mut wi2 = 0
  while wi2 < Array::length(arr_elems) {
    collect_show_array_elems(Array::get(arr_elems, wi2), arr_elems, arr_keys)
    wi2 = wi2 + 1
  }
  let mut ei2 = 0
  while ei2 < Array::length(arr_elems) {
    let et2 = Array::get(arr_elems, ei2)
    if !top_level_fn_exists(stmts, arr_to_string_name(et2)) {
      Array::push(gen, gen_arr_to_string_fn(et2, known_types))
    } else {
      ()
    }
    ei2 = ei2 + 1
  }
  let mut g = 0
  while g < Array::length(gen) {
    Array::push(stmts, Array::get(gen, g))
    g = g + 1
  }
}

fn empty_stmt_list() -> Array[Stmt] {
  array_empty()
}

fn struct_decl_exists(stmts: Array[Stmt], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, _, _, _, _) => if sname == name {
        found = true
        i = Array::length(stmts)
      } else {
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  found
}

///|
/// ===== #786: hoist non-capturing effectful local lambdas to top-level =====
/// A `let f = () -> { perform ... }` bound INSIDE a block compiles to a closure
/// value; calling it inside `handle` drives a miscompiled effect+closure lowering
/// (unregistered arity-1 closure type / infinite recursion, #786). The identical
/// function at TOP LEVEL compiles to a direct call and works. So hoist a local
/// `let`-bound lambda whose body performs/throws and that provably captures NO
/// enclosing local, to a fresh top-level `let`, rewriting its call sites.
///
/// Safety: hoisted only when EVERY free identifier (used, not bound inside the
/// lambda) is an effect keyword (perform/throw/resume), a qualified name (`A::b`),
/// or a constructor (Uppercase-initial). Locals are snake_case (lowercase,
/// unqualified) by convention, so any captured local fails the test -- the pass
/// can never hoist a capturing lambda. Bare lowercase top-level helpers also fail,
/// so such lambdas are left alone (a safe miss, not a miscompile).
fn dlh_name_ok(n: String) -> Bool {
  if n == "perform" || n == "throw" || n == "resume" {
    true
  } else if String::index_of(n, "::") >= 0 {
    true
  } else if String::length(n) > 0 {
    let c = String::char_code_at(n, 0)
    c >= 65 && c <= 90
  } else {
    false
  }
}

///|
fn dlh_with(arr: Array[String], name: String) -> Array[String] {
  let out = Array::slice(arr, 0, Array::length(arr))
  Array::push(out, name)
  out
}

///|
/// Local membership test — avoids depending on `array_contains_str` (defined in
/// other compiler modules and NOT imported here; it resolves in the concatenated
/// sources bundle but is `unknown name` in the strict per-module module_source
/// merge that the FS-compile lane type-checks).
fn dlh_contains(arr: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == name {
      found = true
      i = Array::length(arr)
    } else {
      i = i + 1
    }
  }
  found
}

///|
fn dlh_strip_tilde(n: String) -> String {
  let ln = String::length(n)
  if ln > 0 && n[ln - 1: ln] == "~" {
    n[0: ln - 1]
  } else {
    n
  }
}

///|
fn dlh_pat_binds(p: Pat, out: Array[String]) -> Unit {
  match p {
    PBind(n) => Array::push(out, n),
    PCtor(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        dlh_pat_binds(Array::get(args, i), out)
        i = i + 1
      }
    },
    PTuple(ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        dlh_pat_binds(Array::get(ps, i), out)
        i = i + 1
      }
    },
    POr(a, b) => {
      dlh_pat_binds(a, out)
      dlh_pat_binds(b, out)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        dlh_pat_binds(fp, out)
        i = i + 1
      }
    },
    _ => ()
  }
}

///|
/// #786 targets `perform` inside a local lambda that is later called under a
/// `handle`. Hoisting is gated on the body containing a `perform` specifically —
/// NOT `throw`. A `throw(SubErr(..))` lambda (see effect_handler_test) has no
/// closure bug and compiled fine as a local closure; hoisting it to top-level
/// would relocate its bare suberror-ctor references (`KeyInvalid`) out of the
/// scope that resolves them (`undefined variable (local): KeyInvalid @call`).
fn dlh_has_perform(expr: Expr) -> Bool {
  match expr {
    ECall(callee, args, _) => {
      let head = match callee {
        EIdent(n, _) => n == "perform",
        _ => false
      }
      // #640 Stage 2: `throw(x)` now parses to `perform Error::Throw(x)`, but
      // the hoist gate must keep treating it as a THROW, not a perform — the
      // comment above this function documents exactly why hoisting a
      // `throw(SubErr(..))` lambda breaks (bare suberror-ctor references get
      // relocated out of resolving scope). Recurse into the payload so a real
      // perform nested inside a throw payload still triggers.
      let is_throw_shape = if head && Array::length(args) == 1 {
        match Array::get(args, 0) {
          ECall(op_callee, _, _) => match op_callee {
            EIdent(op_n, _) => is_exception_throw_operation(op_n),
            _ => false
          },
          _ => false
        }
      } else {
        false
      }
      if head && !is_throw_shape {
        true
      } else {
        let mut i = 0
        let mut found = dlh_has_perform(callee)
        while i < Array::length(args) {
          if dlh_has_perform(Array::get(args, i)) {
            found = true
          } else {
            ()
          }
          i = i + 1
        }
        found
      }
    },
    EBinOp(_, l, r) => dlh_has_perform(l) || dlh_has_perform(r),
    EUnaryOp(_, e) => dlh_has_perform(e),
    EIf(c, t, e) => dlh_has_perform(c) || dlh_has_perform(t) || dlh_has_perform(e),
    ELet(_, v, b, _) => dlh_has_perform(v) || dlh_has_perform(b),
    ELetRec(_, v, b) => dlh_has_perform(v) || dlh_has_perform(b),
    ELetMut(_, v, b, _) => dlh_has_perform(v) || dlh_has_perform(b),
    EAssign(_, v, c) => dlh_has_perform(v) || dlh_has_perform(c),
    EAssignOp(_, _, v, c) => dlh_has_perform(v) || dlh_has_perform(c),
    ESeq(a, b) => dlh_has_perform(a) || dlh_has_perform(b),
    EWhile(c, b) => dlh_has_perform(c) || dlh_has_perform(b),
    EForIn(_, _, it, b) => dlh_has_perform(it) || dlh_has_perform(b),
    EDot(o, _, _, _) => dlh_has_perform(o),
    ELabeledArg(_, _, e) => dlh_has_perform(e),
    EReturn(e) => dlh_has_perform(e),
    EMatch(s, arms) => dlh_has_perform(s) || dlh_has_perform_arms(arms),
    EHandle(s, _) => dlh_has_perform(s),
    _ => false
  }
}

/// Collect the effect-name prefix (`split_qualified`'s head, or the bare
/// operand name if unqualified) of every `perform <qname>`/`perform
/// <qname>(args)` found in `expr`, deduped, into `out`. Mirrors
/// dlh_has_perform's exact traversal shape (same `Error::Throw` exclusion,
/// same set of recursed-into node kinds -- deliberately NOT into a nested
/// EFn, matching dlh_has_perform's own scope: a perform inside a DEEPER
/// nested closure is that closure's own concern when/if IT is separately
/// hoisted, not this one's).
///
/// Exists to fix a real bug found via gc-backend coverage testing
/// (2026-07-23): a local closure with NO explicit `with {...}` annotation
/// (its `eff` field is `None` in the AST -- the checker infers its
/// effect row internally but never writes it back onto the node) that
/// performs an effect and gets lambda-lifted to a fresh top-level binding
/// by dlh_hoist_expr (the capture-free case) used to keep `eff = None` on
/// the hoisted definition too. `evidence_dict_pass` classifies TOP-LEVEL
/// functions as "needing" an effect purely by reading this row string
/// (codegen/common_base/inline_direct_perform.vibe's edp_collect_fn_defs),
/// so the hoisted function was silently never recognized as needing
/// anything, and its `perform` was never migrated -- harmless on the
/// linear backend (an un-rewritten perform just falls back to replay
/// codegen, still correct) but a hard "unsupported perform" compile error
/// on the gc backend, which has no such fallback. See
/// fixtures/effect_handle_call_evidence_closure_literal.vibe's
/// `never_called` for the exact shape that surfaced this.
fn dlh_collect_performed_effect_names(expr: Expr, out: Array[String]) -> Unit {
  match expr {
    ECall(callee, args, _) => {
      let head = match callee {
        EIdent(n, _) => n == "perform",
        _ => false
      }
      if head && Array::length(args) == 1 {
        let operand = Array::get(args, 0)
        let qname = match operand {
          EIdent(qn, _) => Some(qn),
          ECall(op_callee, _, _) => match op_callee {
            EIdent(qn, _) => Some(qn),
            _ => None
          },
          _ => None
        }
        match qname {
          Some(qn) => if !is_exception_throw_operation(qn) {
            let ename = match split_qualified(qn) {
              Some((h, _)) => h,
              None => qn
            }
            if dlh_contains(out, ename) {
              ()
            } else {
              Array::push(out, ename)
            }
          } else {
            ()
          },
          None => ()
        }
      } else {
        ()
      }
      dlh_collect_performed_effect_names(callee, out)
      let mut i = 0
      while i < Array::length(args) {
        dlh_collect_performed_effect_names(Array::get(args, i), out)
        i = i + 1
      }
    },
    EBinOp(_, l, r) => {
      dlh_collect_performed_effect_names(l, out)
      dlh_collect_performed_effect_names(r, out)
    },
    EUnaryOp(_, e) => dlh_collect_performed_effect_names(e, out),
    EIf(c, t, e) => {
      dlh_collect_performed_effect_names(c, out)
      dlh_collect_performed_effect_names(t, out)
      dlh_collect_performed_effect_names(e, out)
    },
    ELet(_, v, b, _) => {
      dlh_collect_performed_effect_names(v, out)
      dlh_collect_performed_effect_names(b, out)
    },
    ELetRec(_, v, b) => {
      dlh_collect_performed_effect_names(v, out)
      dlh_collect_performed_effect_names(b, out)
    },
    ELetMut(_, v, b, _) => {
      dlh_collect_performed_effect_names(v, out)
      dlh_collect_performed_effect_names(b, out)
    },
    EAssign(_, v, c) => {
      dlh_collect_performed_effect_names(v, out)
      dlh_collect_performed_effect_names(c, out)
    },
    EAssignOp(_, _, v, c) => {
      dlh_collect_performed_effect_names(v, out)
      dlh_collect_performed_effect_names(c, out)
    },
    ESeq(a, b) => {
      dlh_collect_performed_effect_names(a, out)
      dlh_collect_performed_effect_names(b, out)
    },
    EWhile(c, b) => {
      dlh_collect_performed_effect_names(c, out)
      dlh_collect_performed_effect_names(b, out)
    },
    EForIn(_, _, it, b) => {
      dlh_collect_performed_effect_names(it, out)
      dlh_collect_performed_effect_names(b, out)
    },
    EDot(o, _, _, _) => dlh_collect_performed_effect_names(o, out),
    ELabeledArg(_, _, e) => dlh_collect_performed_effect_names(e, out),
    EReturn(e) => dlh_collect_performed_effect_names(e, out),
    EMatch(s, arms) => {
      dlh_collect_performed_effect_names(s, out)
      dlh_collect_performed_effect_names_arms(arms, out)
    },
    EHandle(s, _) => dlh_collect_performed_effect_names(s, out),
    _ => ()
  }
}

fn dlh_collect_performed_effect_names_arms(arms: Array[(Pat, Expr)], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (_, b) = Array::get(arms, i)
    dlh_collect_performed_effect_names(b, out)
    i = i + 1
  }
}

fn dlh_join_comma(names: Array[String]) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(names) {
    if i == 0 {
      out = Array::get(names, i)
    } else {
      out = String::concat(String::concat(out, ", "), Array::get(names, i))
    }
    i = i + 1
  }
  out
}

///|
fn dlh_has_perform_arms(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (_, b) = Array::get(arms, i)
    if dlh_has_perform(b) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

///|
/// Append to `bad` any free identifier of `expr` that is not `dlh_name_ok` and
/// not in `bound`. Non-empty `bad` => the lambda references a bare lowercase
/// non-top-level name (capture or bare-helper call) and must not be hoisted.
fn dlh_scan_free(expr: Expr, bound: Array[String], bad: Array[String]) -> Unit {
  match expr {
    EIdent(n, _) => if dlh_name_ok(n) || dlh_contains(bound, n) {
      ()
    } else {
      Array::push(bad, n)
    },
    EBinOp(_, l, r) => {
      dlh_scan_free(l, bound, bad)
      dlh_scan_free(r, bound, bad)
    },
    EUnaryOp(_, e) => dlh_scan_free(e, bound, bad),
    ECall(callee, args, _) => {
      dlh_scan_free(callee, bound, bad)
      let mut i = 0
      while i < Array::length(args) {
        dlh_scan_free(Array::get(args, i), bound, bad)
        i = i + 1
      }
    },
    ETuple(es) => {
      let mut i = 0
      while i < Array::length(es) {
        dlh_scan_free(Array::get(es, i), bound, bad)
        i = i + 1
      }
    },
    EArray(es) => {
      let mut i = 0
      while i < Array::length(es) {
        dlh_scan_free(Array::get(es, i), bound, bad)
        i = i + 1
      }
    },
    ESpread(e) => dlh_scan_free(e, bound, bad),
    EContinue(es) => {
      let mut i = 0
      while i < Array::length(es) {
        dlh_scan_free(Array::get(es, i), bound, bad)
        i = i + 1
      }
    },
    ERecord(_, fs, _) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, v) = Array::get(fs, i)
        dlh_scan_free(v, bound, bad)
        i = i + 1
      }
    },
    EMap(fs) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, v) = Array::get(fs, i)
        dlh_scan_free(v, bound, bad)
        i = i + 1
      }
    },
    EIf(c, t, e) => {
      dlh_scan_free(c, bound, bad)
      dlh_scan_free(t, bound, bad)
      dlh_scan_free(e, bound, bad)
    },
    ELet(name, v, b, _) => {
      dlh_scan_free(v, bound, bad)
      dlh_scan_free(b, dlh_with(bound, name), bad)
    },
    ELetRec(name, v, b) => {
      let b2 = dlh_with(bound, name)
      dlh_scan_free(v, b2, bad)
      dlh_scan_free(b, b2, bad)
    },
    ELetMut(name, v, b, _) => {
      dlh_scan_free(v, bound, bad)
      dlh_scan_free(b, dlh_with(bound, name), bad)
    },
    EAssign(name, v, c) => {
      if dlh_name_ok(name) || dlh_contains(bound, name) {
        ()
      } else {
        Array::push(bad, name)
      }
      dlh_scan_free(v, bound, bad)
      dlh_scan_free(c, bound, bad)
    },
    EAssignOp(name, _, v, c) => {
      if dlh_name_ok(name) || dlh_contains(bound, name) {
        ()
      } else {
        Array::push(bad, name)
      }
      dlh_scan_free(v, bound, bad)
      dlh_scan_free(c, bound, bad)
    },
    ESeq(a, b) => {
      dlh_scan_free(a, bound, bad)
      dlh_scan_free(b, bound, bad)
    },
    EWhile(c, b) => {
      dlh_scan_free(c, bound, bad)
      dlh_scan_free(b, bound, bad)
    },
    EForIn(name, idxn, it, b) => {
      dlh_scan_free(it, bound, bad)
      let mut b2 = dlh_with(bound, name)
      b2 = match idxn {
        Some(inm) => dlh_with(b2, inm),
        None => b2
      }
      dlh_scan_free(b, b2, bad)
    },
    EDot(o, _, _, _) => dlh_scan_free(o, bound, bad),
    ELabeledArg(_, _, e) => dlh_scan_free(e, bound, bad),
    EReturn(e) => dlh_scan_free(e, bound, bad),
    EBreak(opt) => match opt {
      Some(e) => dlh_scan_free(e, bound, bad),
      None => ()
    },
    EFn(_, _, params, _, _, body) => {
      let mut inner = bound
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        inner = dlh_with(inner, dlh_strip_tilde(pn))
        i = i + 1
      }
      dlh_scan_free(body, inner, bad)
    },
    EMatch(s, arms) => {
      dlh_scan_free(s, bound, bad)
      dlh_scan_arms(arms, bound, bad)
    },
    EHandle(s, arms) => {
      dlh_scan_free(s, bound, bad)
      dlh_scan_arms(arms, bound, bad)
    },
    ELoop(params, b) => {
      let mut b2 = bound
      let mut i = 0
      while i < Array::length(params) {
        let (pn, init) = Array::get(params, i)
        dlh_scan_free(init, bound, bad)
        b2 = dlh_with(b2, pn)
        i = i + 1
      }
      dlh_scan_free(b, b2, bad)
    },
    _ => ()
  }
}

///|
fn dlh_scan_arms(arms: Array[(Pat, Expr)], bound: Array[String], bad: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (p, b) = Array::get(arms, i)
    let mut ab = bound
    let pb = empty_str_array()
    dlh_pat_binds(p, pb)
    let mut j = 0
    while j < Array::length(pb) {
      ab = dlh_with(ab, Array::get(pb, j))
      j = j + 1
    }
    dlh_scan_free(b, ab, bad)
    i = i + 1
  }
}

///|
/// Capture-safe substitution: EIdent(from) -> EIdent(to), stopping in subtrees
/// that rebind `from`.
fn dlh_subst(expr: Expr, from: String, to: String) -> Expr {
  match expr {
    EIdent(n, off) => if n == from {
      EIdent(to, off)
    } else {
      expr
    },
    EBinOp(op, l, r) => EBinOp(op, dlh_subst(l, from, to), dlh_subst(r, from, to)),
    EUnaryOp(op, e) => EUnaryOp(op, dlh_subst(e, from, to)),
    ECall(callee, args, off) => ECall(dlh_subst(callee, from, to), for a in args {
      dlh_subst(a, from, to)
    }, off),
    ETuple(es) => ETuple(for e in es {
      dlh_subst(e, from, to)
    }),
    EArray(es) => EArray(for e in es {
      dlh_subst(e, from, to)
    }),
    ESpread(e) => ESpread(dlh_subst(e, from, to)),
    EContinue(es) => EContinue(for e in es {
      dlh_subst(e, from, to)
    }),
    ERecord(rn, fs, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dlh_subst(v, from, to)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dlh_subst(v, from, to)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(dlh_subst(c, from, to), dlh_subst(t, from, to), dlh_subst(e, from, to)),
    ELet(name, v, b, soff) => ELet(name, dlh_subst(v, from, to), if name == from {
      b
    } else {
      dlh_subst(b, from, to)
    }, soff),
    ELetRec(name, v, b) => if name == from {
      ELetRec(name, v, b)
    } else {
      ELetRec(name, dlh_subst(v, from, to), dlh_subst(b, from, to))
    },
    ELetMut(name, v, b, soff) => ELetMut(name, dlh_subst(v, from, to), if name == from {
      b
    } else {
      dlh_subst(b, from, to)
    }, soff),
    EAssign(name, v, c) => EAssign(name, dlh_subst(v, from, to), dlh_subst(c, from, to)),
    EAssignOp(name, op, v, c) => EAssignOp(name, op, dlh_subst(v, from, to), dlh_subst(c, from, to)),
    ESeq(a, b) => ESeq(dlh_subst(a, from, to), dlh_subst(b, from, to)),
    EWhile(c, b) => EWhile(dlh_subst(c, from, to), dlh_subst(b, from, to)),
    EForIn(name, idxn, it, b) => {
      let shadow = name == from || (match idxn {
        Some(inm) => inm == from,
        None => false
      })
      EForIn(name, idxn, dlh_subst(it, from, to), if shadow {
        b
      } else {
        dlh_subst(b, from, to)
      })
    },
    EDot(o, f, off, fdoff) => EDot(dlh_subst(o, from, to), f, off, fdoff),
    ELabeledArg(l, m, e) => ELabeledArg(l, m, dlh_subst(e, from, to)),
    EReturn(e) => EReturn(dlh_subst(e, from, to)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(dlh_subst(e, from, to))),
      None => expr
    },
    EFn(tp, bnds, params, rt, eff, body) => {
      let mut shadow = false
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        if dlh_strip_tilde(pn) == from {
          shadow = true
        } else {
          ()
        }
        i = i + 1
      }
      if shadow {
        expr
      } else {
        EFn(tp, bnds, params, rt, eff, dlh_subst(body, from, to))
      }
    },
    EMatch(s, arms) => EMatch(dlh_subst(s, from, to), dlh_subst_arms(arms, from, to)),
    EHandle(s, arms) => EHandle(dlh_subst(s, from, to), dlh_subst_arms(arms, from, to)),
    ELoop(params, b) => {
      let mut shadow = false
      let out = array_empty()
      let mut i = 0
      while i < Array::length(params) {
        let (pn, init) = Array::get(params, i)
        if pn == from {
          shadow = true
        } else {
          ()
        }
        Array::push(out, (pn, dlh_subst(init, from, to)))
        i = i + 1
      }
      ELoop(out, if shadow {
        b
      } else {
        dlh_subst(b, from, to)
      })
    },
    _ => expr
  }
}

///|
fn dlh_subst_arms(arms: Array[(Pat, Expr)], from: String, to: String) -> Array[(Pat, Expr)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(arms) {
    let (p, b) = Array::get(arms, i)
    let pb = empty_str_array()
    dlh_pat_binds(p, pb)
    let shadow = dlh_contains(pb, from)
    Array::push(out, (p, if shadow {
      b
    } else {
      dlh_subst(b, from, to)
    }))
    i = i + 1
  }
  out
}

///|
/// #1069 follow-up: closure-conversion for a CAPTURING local effectful
/// lambda (`dlh_scan_free` found a non-empty `bad`). The plain rename
/// dlh_hoist_expr already does for the non-capturing case (dlh_subst,
/// `name` -> `fresh`) isn't enough here: every remaining occurrence of
/// `name` also needs the captured values threaded in as extra arguments,
/// which only makes sense at a CALL site -- `name` used as a bare value
/// anywhere else (passed on, stored, returned) has no sound rewrite once
/// hoisted (the hoisted top-level function now expects the captures as
/// its own leading parameters, not something a bare reference could
/// supply). Detecting "used only as a direct call target" needs the SAME
/// shadow-awareness dlh_scan_free/dlh_subst already have -- rather than
/// duplicate that scope-tracking a third time, reuse dlh_subst itself:
/// substitute `name` for a freshly-minted, globally-unique marker name
/// first (dlh_subst is already proven correct about not touching a
/// SHADOWED occurrence), then scan the marker's occurrences with a
/// deliberately simple, non-shadow-aware walk -- safe, because a fresh
/// unique marker can never collide with an unrelated binding the way
/// `name` itself could.
fn dlh_mocd_scan(expr: Expr, marker: String, bad: Array[Bool]) -> Unit {
  match expr {
    EIdent(n, _) => if n == marker {
      Array::set(bad, 0, true)
    } else {
      ()
    },
    ECall(callee, args, _) => {
      match callee {
        EIdent(n, _) => if n == marker {
          ()
        } else {
          dlh_mocd_scan(callee, marker, bad)
        },
        _ => dlh_mocd_scan(callee, marker, bad)
      }
      let mut i = 0
      while i < Array::length(args) {
        dlh_mocd_scan(Array::get(args, i), marker, bad)
        i = i + 1
      }
    },
    EBinOp(_, l, r) => {
      dlh_mocd_scan(l, marker, bad)
      dlh_mocd_scan(r, marker, bad)
    },
    EUnaryOp(_, e) => dlh_mocd_scan(e, marker, bad),
    ETuple(es) => {
      let mut i = 0
      while i < Array::length(es) {
        dlh_mocd_scan(Array::get(es, i), marker, bad)
        i = i + 1
      }
    },
    EArray(es) => {
      let mut i = 0
      while i < Array::length(es) {
        dlh_mocd_scan(Array::get(es, i), marker, bad)
        i = i + 1
      }
    },
    ESpread(e) => dlh_mocd_scan(e, marker, bad),
    EContinue(es) => {
      let mut i = 0
      while i < Array::length(es) {
        dlh_mocd_scan(Array::get(es, i), marker, bad)
        i = i + 1
      }
    },
    ERecord(_, fs, _) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, v) = Array::get(fs, i)
        dlh_mocd_scan(v, marker, bad)
        i = i + 1
      }
    },
    EMap(fs) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, v) = Array::get(fs, i)
        dlh_mocd_scan(v, marker, bad)
        i = i + 1
      }
    },
    EIf(c, t, e) => {
      dlh_mocd_scan(c, marker, bad)
      dlh_mocd_scan(t, marker, bad)
      dlh_mocd_scan(e, marker, bad)
    },
    ELet(_, v, b, _) => {
      dlh_mocd_scan(v, marker, bad)
      dlh_mocd_scan(b, marker, bad)
    },
    ELetRec(_, v, b) => {
      dlh_mocd_scan(v, marker, bad)
      dlh_mocd_scan(b, marker, bad)
    },
    ELetMut(_, v, b, _) => {
      dlh_mocd_scan(v, marker, bad)
      dlh_mocd_scan(b, marker, bad)
    },
    EAssign(n, v, c) => {
      if n == marker {
        Array::set(bad, 0, true)
      } else {
        ()
      }
      dlh_mocd_scan(v, marker, bad)
      dlh_mocd_scan(c, marker, bad)
    },
    EAssignOp(n, _, v, c) => {
      if n == marker {
        Array::set(bad, 0, true)
      } else {
        ()
      }
      dlh_mocd_scan(v, marker, bad)
      dlh_mocd_scan(c, marker, bad)
    },
    ESeq(a, b) => {
      dlh_mocd_scan(a, marker, bad)
      dlh_mocd_scan(b, marker, bad)
    },
    EWhile(c, b) => {
      dlh_mocd_scan(c, marker, bad)
      dlh_mocd_scan(b, marker, bad)
    },
    EForIn(_, _, it, b) => {
      dlh_mocd_scan(it, marker, bad)
      dlh_mocd_scan(b, marker, bad)
    },
    EDot(o, _, _, _) => dlh_mocd_scan(o, marker, bad),
    ELabeledArg(_, _, e) => dlh_mocd_scan(e, marker, bad),
    EReturn(e) => dlh_mocd_scan(e, marker, bad),
    EBreak(opt) => match opt {
      Some(e) => dlh_mocd_scan(e, marker, bad),
      None => ()
    },
    EFn(_, _, _, _, _, body) => dlh_mocd_scan(body, marker, bad),
    EMatch(s, arms) => {
      dlh_mocd_scan(s, marker, bad)
      dlh_mocd_scan_arms(arms, marker, bad)
    },
    EHandle(s, arms) => {
      dlh_mocd_scan(s, marker, bad)
      dlh_mocd_scan_arms(arms, marker, bad)
    },
    ELoop(params, b) => {
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        dlh_mocd_scan(init, marker, bad)
        i = i + 1
      }
      dlh_mocd_scan(b, marker, bad)
    },
    _ => ()
  }
}

fn dlh_mocd_scan_arms(arms: Array[(Pat, Expr)], marker: String, bad: Array[Bool]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (_, b) = Array::get(arms, i)
    dlh_mocd_scan(b, marker, bad)
    i = i + 1
  }
}

fn dlh_marker_only_called_directly(expr: Expr, marker: String) -> Bool {
  let bad = [
    false
  ]
  dlh_mocd_scan(expr, marker, bad)
  !Array::get(bad, 0)
}

/// Rewrite every `ECall(EIdent(marker), args, off)` into `ECall(EIdent(fresh),
/// extra_names_as_idents ++ args, off)` -- the captured-value arguments the
/// newly-hoisted top-level function now expects as its leading parameters,
/// each just a bare reference to the SAME name it had in the original
/// (unshadowed, per dlh_marker_only_called_directly's guarantee) enclosing
/// scope, still valid at the call site since hoisting doesn't move the call
/// site itself, only the closure's OWN body. Full traversal (marker is
/// fresh/unique, no shadowing concern, so no bound-tracking needed here).
fn dlh_prepend_and_rename_calls(expr: Expr, marker: String, fresh: String, extra_names: Array[String]) -> Expr {
  match expr {
    ECall(callee, args, off) => match callee {
      EIdent(n, coff) => if n == marker {
        let extra_args = for en in extra_names {
          EIdent(en, coff)
        }
        ECall(EIdent(fresh, coff), Array::concat(extra_args, for a in args {
          dlh_prepend_and_rename_calls(a, marker, fresh, extra_names)
        }), off)
      } else {
        ECall(dlh_prepend_and_rename_calls(callee, marker, fresh, extra_names), for a in args {
          dlh_prepend_and_rename_calls(a, marker, fresh, extra_names)
        }, off)
      },
      _ => ECall(dlh_prepend_and_rename_calls(callee, marker, fresh, extra_names), for a in args {
        dlh_prepend_and_rename_calls(a, marker, fresh, extra_names)
      }, off)
    },
    EBinOp(op, l, r) => EBinOp(op, dlh_prepend_and_rename_calls(l, marker, fresh, extra_names), dlh_prepend_and_rename_calls(r, marker, fresh, extra_names)),
    EUnaryOp(op, e) => EUnaryOp(op, dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),
    ETuple(es) => ETuple(for e in es {
      dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)
    }),
    EArray(es) => EArray(for e in es {
      dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)
    }),
    ESpread(e) => ESpread(dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),
    EContinue(es) => EContinue(for e in es {
      dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)
    }),
    ERecord(rn, fs, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(dlh_prepend_and_rename_calls(c, marker, fresh, extra_names), dlh_prepend_and_rename_calls(t, marker, fresh, extra_names), dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),
    ELet(n, v, b, soff) => ELet(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names), soff),
    ELetRec(n, v, b) => ELetRec(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),
    ELetMut(n, v, b, soff) => ELetMut(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names), soff),
    EAssign(n, v, c) => EAssign(n, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(c, marker, fresh, extra_names)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, dlh_prepend_and_rename_calls(v, marker, fresh, extra_names), dlh_prepend_and_rename_calls(c, marker, fresh, extra_names)),
    ESeq(a, b) => ESeq(dlh_prepend_and_rename_calls(a, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),
    EWhile(c, b) => EWhile(dlh_prepend_and_rename_calls(c, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),
    EForIn(n, idxn, it, b) => EForIn(n, idxn, dlh_prepend_and_rename_calls(it, marker, fresh, extra_names), dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),
    EDot(o, f, off, fdoff) => EDot(dlh_prepend_and_rename_calls(o, marker, fresh, extra_names), f, off, fdoff),
    ELabeledArg(l, m, e) => ELabeledArg(l, m, dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),
    EReturn(e) => EReturn(dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),
    EBreak(opt) => EBreak(match opt {
      Some(e) => Some(dlh_prepend_and_rename_calls(e, marker, fresh, extra_names)),
      None => None
    }),
    EFn(tp, bnds, params, rt, eff, body) => EFn(tp, bnds, params, rt, eff, dlh_prepend_and_rename_calls(body, marker, fresh, extra_names)),
    EMatch(s, arms) => EMatch(dlh_prepend_and_rename_calls(s, marker, fresh, extra_names), for a in arms {
      let (p, b) = a
      (p, dlh_prepend_and_rename_calls(b, marker, fresh, extra_names))
    }),
    EHandle(s, arms) => EHandle(dlh_prepend_and_rename_calls(s, marker, fresh, extra_names), for a in arms {
      let (p, b) = a
      (p, dlh_prepend_and_rename_calls(b, marker, fresh, extra_names))
    }),
    ELoop(params, b) => ELoop(for p in params {
      let (pn, init) = p
      (pn, dlh_prepend_and_rename_calls(init, marker, fresh, extra_names))
    }, dlh_prepend_and_rename_calls(b, marker, fresh, extra_names)),
    _ => expr
  }
}

fn dlh_dedup_names(names: Array[String]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(names) {
    let n = Array::get(names, i)
    if dlh_contains(out, n) {
      ()
    } else {
      Array::push(out, n)
    }
    i = i + 1
  }
  out
}

/// Closure conversion passes each captured name's CURRENT VALUE at the call
/// site as a plain argument -- correct only if that value can never diverge
/// from what a genuine reference-capturing closure would have seen, i.e.
/// the captured name is never reassigned anywhere the conversion could
/// observe (`let mut base = ...` captured and later mutated, or mutated
/// again inside the closure's OWN body such that the mutation should be
/// visible to code after the call, would silently do the WRONG thing under
/// pass-by-value). Deliberately conservative: flags `names` as unsafe if
/// EITHER `fbody` (the closure's own body) or `rest` (everything after the
/// closure definition, where call sites live) reassigns any of them via
/// `EAssign`/`EAssignOp`, regardless of whether the original declaration
/// was `let` or `let mut` -- simpler than tracking declaration-site
/// mutability precisely, and every bit as safe: nothing to observe
/// diverging means pass-by-value and capture-by-reference are behaviorally
/// identical for this specific program, whatever the declaration said.
fn dlh_names_ever_assigned(expr: Expr, names: Array[String]) -> Bool {
  let bad = [
    false
  ]
  dlh_naa_scan(expr, names, bad)
  Array::get(bad, 0)
}

fn dlh_naa_scan(expr: Expr, names: Array[String], bad: Array[Bool]) -> Unit {
  match expr {
    EAssign(n, v, c) => {
      if dlh_contains(names, n) {
        Array::set(bad, 0, true)
      } else {
        ()
      }
      dlh_naa_scan(v, names, bad)
      dlh_naa_scan(c, names, bad)
    },
    EAssignOp(n, _, v, c) => {
      if dlh_contains(names, n) {
        Array::set(bad, 0, true)
      } else {
        ()
      }
      dlh_naa_scan(v, names, bad)
      dlh_naa_scan(c, names, bad)
    },
    ECall(callee, args, _) => {
      dlh_naa_scan(callee, names, bad)
      let mut i = 0
      while i < Array::length(args) {
        dlh_naa_scan(Array::get(args, i), names, bad)
        i = i + 1
      }
    },
    EBinOp(_, l, r) => {
      dlh_naa_scan(l, names, bad)
      dlh_naa_scan(r, names, bad)
    },
    EUnaryOp(_, e) => dlh_naa_scan(e, names, bad),
    ETuple(es) => {
      let mut i = 0
      while i < Array::length(es) {
        dlh_naa_scan(Array::get(es, i), names, bad)
        i = i + 1
      }
    },
    EArray(es) => {
      let mut i = 0
      while i < Array::length(es) {
        dlh_naa_scan(Array::get(es, i), names, bad)
        i = i + 1
      }
    },
    ESpread(e) => dlh_naa_scan(e, names, bad),
    EContinue(es) => {
      let mut i = 0
      while i < Array::length(es) {
        dlh_naa_scan(Array::get(es, i), names, bad)
        i = i + 1
      }
    },
    ERecord(_, fs, _) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, v) = Array::get(fs, i)
        dlh_naa_scan(v, names, bad)
        i = i + 1
      }
    },
    EMap(fs) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, v) = Array::get(fs, i)
        dlh_naa_scan(v, names, bad)
        i = i + 1
      }
    },
    EIf(c, t, e) => {
      dlh_naa_scan(c, names, bad)
      dlh_naa_scan(t, names, bad)
      dlh_naa_scan(e, names, bad)
    },
    ELet(_, v, b, _) => {
      dlh_naa_scan(v, names, bad)
      dlh_naa_scan(b, names, bad)
    },
    ELetRec(_, v, b) => {
      dlh_naa_scan(v, names, bad)
      dlh_naa_scan(b, names, bad)
    },
    ELetMut(_, v, b, _) => {
      dlh_naa_scan(v, names, bad)
      dlh_naa_scan(b, names, bad)
    },
    ESeq(a, b) => {
      dlh_naa_scan(a, names, bad)
      dlh_naa_scan(b, names, bad)
    },
    EWhile(c, b) => {
      dlh_naa_scan(c, names, bad)
      dlh_naa_scan(b, names, bad)
    },
    EForIn(_, _, it, b) => {
      dlh_naa_scan(it, names, bad)
      dlh_naa_scan(b, names, bad)
    },
    EDot(o, _, _, _) => dlh_naa_scan(o, names, bad),
    ELabeledArg(_, _, e) => dlh_naa_scan(e, names, bad),
    EReturn(e) => dlh_naa_scan(e, names, bad),
    EBreak(opt) => match opt {
      Some(e) => dlh_naa_scan(e, names, bad),
      None => ()
    },
    EFn(_, _, _, _, _, body) => dlh_naa_scan(body, names, bad),
    EMatch(s, arms) => {
      dlh_naa_scan(s, names, bad)
      dlh_naa_scan_arms(arms, names, bad)
    },
    EHandle(s, arms) => {
      dlh_naa_scan(s, names, bad)
      dlh_naa_scan_arms(arms, names, bad)
    },
    ELoop(params, b) => {
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        dlh_naa_scan(init, names, bad)
        i = i + 1
      }
      dlh_naa_scan(b, names, bad)
    },
    _ => ()
  }
}

fn dlh_naa_scan_arms(arms: Array[(Pat, Expr)], names: Array[String], bad: Array[Bool]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (_, b) = Array::get(arms, i)
    dlh_naa_scan(b, names, bad)
    i = i + 1
  }
}

///|
/// Only ever matches an EFFECTFUL literal (dlh_has_perform on its body) --
/// found via a live regression (2026-07-23, fixtures/eq_array_option_fields.vibe
/// trapping "unreachable" in a derive(Eq)-generated equality helper, bisected
/// to this fix's own introducing commit): the original unguarded version
/// matched ANY literal EFn argument, including the PURE comparator closures
/// derive(Eq)/derive(Ord) generate for Array/Option/tuple field comparisons.
/// Wrapping a pure closure in a synthetic let-binding was assumed harmless
/// (closure construction has no side effects), but something downstream
/// (likely type inference/monomorphization for the generic higher-order
/// comparator call) broke when the literal stopped appearing directly at
/// the call site. Scoping this to effectful literals only -- exactly
/// mirroring dlh_hoist_expr's own ELet branch, which has always required
/// dlh_has_perform before touching a closure at all -- keeps every pure
/// closure completely untouched by this pass, restoring the pre-existing
/// (working) behavior for that case while keeping the IIFE/HOF-arg fix
/// for genuinely effectful literals.
/// A closure literal's DECLARED effect row is non-empty.
///
/// #1385: the IIFE normalization below used `dlh_has_perform` alone to
/// decide "is this literal effectful enough to deserve a name". That asks
/// whether the body performs DIRECTLY, so a literal that carries a row but
/// discharges it by CALLING a row-carrying function (`() -> Int with { E }
/// { helper(1) }`) answered no and kept its anonymous IIFE shape. The
/// evidence-dict pass then rejected the whole effect, because
/// edp_has_unsafe_construct treats every call whose callee is not a bare
/// identifier as opaque -- an IIFE is exactly that. Reading the declared
/// row instead of the body catches the delegating case while leaving the
/// derive(Eq)/derive(Ord) comparator closures that motivated the narrow
/// gate (see dlh_args_have_literal_efn's doc comment) untouched: those are
/// pure and carry no row at all.
///
/// Deliberately NOT used for the ELet hoist decision, which stays on
/// `dlh_has_perform`. Naming a literal is semantics-preserving; RELOCATING
/// one to the top level is not (that gate's own comment records a
/// suberror-ctor scoping break), so widening this must not widen that.
fn dlh_row_is_effectful(eff: Option[String]) -> Bool {
  match eff {
    Some(s) => String::trim(s) != "",
    None => false
  }
}

fn dlh_args_have_literal_efn(args: Array[Expr]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(args) && !found {
    match Array::get(args, i) {
      EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) {
        found = true
      } else {
        ()
      },
      // A labeled argument (`with_log(f = () -> ... { perform ... })`,
      // cheatsheet "Labeled arguments") wraps the literal in ELabeledArg --
      // found via testing this exact syntax against the IIFE/HOF-arg fix
      // above (2026-07-23): it still crashed, since this check only
      // matched a BARE EFn, not one hiding one layer deeper inside a label
      // wrapper. Recurse one layer to catch it too.
      ELabeledArg(_, _, inner) => match inner {
        EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) {
          found = true
        } else {
          ()
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

///|
/// Rewrites `callee(args...)` so every DIRECT `EFn` literal in `args` --
/// bare, or one layer inside an `ELabeledArg` wrapper (`f = () -> ...`) --
/// is let-bound immediately before the call, left-to-right (same evaluation
/// order as the literal appearing inline): `callee(a, <lit>, b)` becomes
/// `let __dlh_arglit_N = <lit>; callee(a, __dlh_arglit_N, b)`; a labeled
/// literal `callee(f = <lit>)` becomes
/// `let __dlh_arglit_N = <lit>; callee(f = __dlh_arglit_N)` (the label
/// wrapper is preserved, only its inner value is replaced). Non-literal
/// args are left untouched. See dlh_args_have_literal_efn's call site
/// (dlh_hoist_expr's ECall case) for why this exists.
fn dlh_letbind_literal_args(callee: Expr, args: Array[Expr], off: Int, ctr: Array[Int]) -> Expr {
  let new_args = array_empty()
  let lits = array_empty()
  let mut i = 0
  while i < Array::length(args) {
    let a = Array::get(args, i)
    match a {
      EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) {
        let idx = Array::get(ctr, 0)
        Array::set(ctr, 0, idx + 1)
        let nm = "__dlh_arglit_\{idx}"
        Array::push(lits, (nm, a))
        Array::push(new_args, EIdent(nm, off))
      } else {
        Array::push(new_args, a)
      },
      ELabeledArg(lbl, mname, inner) => match inner {
        EFn(_, _, _, _, _, fbody) => if dlh_has_perform(fbody) {
          let idx = Array::get(ctr, 0)
          Array::set(ctr, 0, idx + 1)
          let nm = "__dlh_arglit_\{idx}"
          Array::push(lits, (nm, inner))
          Array::push(new_args, ELabeledArg(lbl, mname, EIdent(nm, off)))
        } else {
          Array::push(new_args, a)
        },
        _ => Array::push(new_args, a)
      },
      other => Array::push(new_args, other)
    }
    i = i + 1
  }
  let mut wrapped = ECall(callee, new_args, off)
  let mut k = Array::length(lits) - 1
  while k >= 0 {
    let (nm, lit) = Array::get(lits, k)
    wrapped = ELet(nm, lit, wrapped, off)
    k = k - 1
  }
  wrapped
}

///|
fn dlh_hoist_expr(expr: Expr, hoisted: Array[Stmt], ctr: Array[Int]) -> Expr {
  match expr {
    ELet(name, v, b, soff) => match v {
      EFn(tp, bnds, params, rt, eff, fbody) => {
        // Backfill a missing (unannotated) effect row from what the body
        // actually performs BEFORE hoisting: a hoisted top-level function's
        // row is what evidence_dict_pass's needing-classification reads
        // (codegen/common_base/inline_direct_perform.vibe's
        // edp_collect_fn_defs), so silently keeping `eff = None` here made
        // an effect-performing hoisted closure invisible to that pass --
        // see dlh_collect_performed_effect_names' doc comment for the full
        // history (found via gc-backend coverage testing, 2026-07-23).
        // Only fires when `eff` is genuinely absent; an explicit user-
        // written row (however it's spelled) is left untouched.
        let eff_is_blank = match eff {
          None => true,
          Some(es) => String::trim(es) == ""
        }
        let eff_fixed = if eff_is_blank {
          let performed = empty_str_array()
          dlh_collect_performed_effect_names(fbody, performed)
          if Array::length(performed) == 0 {
            eff
          } else {
            Some(dlh_join_comma(performed))
          }
        } else {
          eff
        }
        let hoisted_fn = dlh_hoist_expr(EFn(tp, bnds, params, rt, eff_fixed, fbody), hoisted, ctr)
        let rest = dlh_hoist_expr(b, hoisted, ctr)
        let bad = empty_str_array()
        let mut pb = empty_str_array()
        let mut i = 0
        while i < Array::length(params) {
          let (pn, _) = Array::get(params, i)
          pb = dlh_with(pb, dlh_strip_tilde(pn))
          i = i + 1
        }
        match hoisted_fn {
          EFn(_, _, _, _, _, hb) => dlh_scan_free(hb, pb, bad),
          _ => ()
        }
        let hoistable = dlh_has_perform(fbody) && Array::length(bad) == 0
        if hoistable {
          let idx = Array::get(ctr, 0)
          Array::set(ctr, 0, idx + 1)
          let fresh = "__hoisted_lam_\{idx}_\{name}"
          Array::push(hoisted, SLet(false, false, fresh, None, hoisted_fn))
          dlh_subst(rest, name, fresh)
        } else if dlh_has_perform(fbody) && Array::length(bad) > 0 {
          // #1069: `bad` is non-empty (the lambda captures at least one
          // ordinary enclosing local) but it still performs -- the exact
          // shape #786's own landed fix declined to touch, still hitting
          // the original unregistered-closure-type/broken-combinator bug
          // unless something else routes it around that path. Attempt
          // closure conversion (see dlh_prepend_and_rename_calls' doc
          // comment) rather than leaving it on the broken path
          // unconditionally: only when every call site can be proven safe
          // to rewrite (dlh_marker_only_called_directly, via dlh_subst's
          // already-proven shadow-correctness). Falls through to the
          // ORIGINAL (unchanged, currently-broken-for-this-shape) local-let
          // behavior when it can't -- never worse than before this change,
          // only sometimes better.
          let idx = Array::get(ctr, 0)
          Array::set(ctr, 0, idx + 1)
          let marker = "__dlh_cc_marker_\{idx}"
          let rest_marked = dlh_subst(rest, name, marker)
          let captured = dlh_dedup_names(bad)
          if dlh_marker_only_called_directly(rest_marked, marker) && !dlh_names_ever_assigned(fbody, captured) && !dlh_names_ever_assigned(rest, captured) {
            let extra_params = for cn in captured {
              (cn, None)
            }
            let new_params = Array::concat(extra_params, params)
            let hoisted_fn2 = match hoisted_fn {
              EFn(tp2, bnds2, _, rt2, eff2, hb2) => EFn(tp2, bnds2, new_params, rt2, eff2, hb2),
              _ => hoisted_fn
            }
            let fresh = "__hoisted_lam_\{idx}_\{name}"
            Array::push(hoisted, SLet(false, false, fresh, None, hoisted_fn2))
            dlh_prepend_and_rename_calls(rest_marked, marker, fresh, captured)
          } else {
            ELet(name, hoisted_fn, rest, soff)
          }
        } else {
          ELet(name, hoisted_fn, rest, soff)
        }
      },
      _ => ELet(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr), soff)
    },
    EBinOp(op, l, r) => EBinOp(op, dlh_hoist_expr(l, hoisted, ctr), dlh_hoist_expr(r, hoisted, ctr)),
    EUnaryOp(op, e) => EUnaryOp(op, dlh_hoist_expr(e, hoisted, ctr)),
    // A bare IIFE -- `(() -> ... { perform ... })()` -- calls an `EFn`
    // literal directly with NO enclosing `ELet` at all. Every hoist/
    // closure-conversion rule above (capture-free hoist, #1069's
    // capturing-closure conversion) pattern-matches specifically on
    // `ELet(name, EFn(...), body)`, so this shape evaded all of them and
    // fell straight through to the pre-#786 broken local-closure+effect
    // combinator path -- an effectful IIFE with ZERO captures produced
    // invalid wasm ("invalid signature index") at compile time, found via
    // testing effect_row_open.vibe-adjacent higher-order-function shapes
    // (2026-07-23). Fix: desugar the IIFE into the ALREADY-handled
    // `ELet(fresh, EFn(...), fresh())` shape and re-enter this same
    // function -- reuses 100% of the existing, separately-verified
    // ELet/EFn logic above with no new closure-conversion code.
    ECall(callee, args, off) => match callee {
      EFn(_, _, _, _, ceff, cfbody) => if dlh_has_perform(cfbody) || dlh_row_is_effectful(ceff) {
        let idx = Array::get(ctr, 0)
        Array::set(ctr, 0, idx + 1)
        let iife_name = "__dlh_iife_\{idx}"
        dlh_hoist_expr(ELet(iife_name, callee, ECall(EIdent(iife_name, off), args, off), off), hoisted, ctr)
      } else {
        ECall(dlh_hoist_expr(callee, hoisted, ctr), for a in args {
          dlh_hoist_expr(a, hoisted, ctr)
        }, off)
      },
      _ => if dlh_args_have_literal_efn(args) {
        // An inline `EFn` literal passed as a CALL ARGUMENT (not the
        // callee) to an ordinary (non-trivial-wrapper) named function --
        // `with_log(() -> Int with { Log } { perform ...; 42 })` where
        // `with_log`'s own body genuinely calls its parameter internally
        // (`handle { f() } with Log { .. }`), not merely a same-arity
        // forward `dtpw_inline_trivial_wrappers` (#1070) would already
        // reduce to an IIFE. Verified via direct A/B testing (2026-07-23)
        // that a NAMED closure (top-level, or already hoisted) passed the
        // exact same way to the exact same `with_log` already works fine
        // -- confirming the crash is specific to the literal itself
        // having no name for any hoist/closure-conversion rule to latch
        // onto, not to anything about `with_log`. Fix: synthesize a let-
        // binding for each literal-EFn argument immediately before this
        // call (semantics-preserving -- same left-to-right evaluation
        // order as the literal appearing inline) so the existing ELet/EFn
        // hoist logic above turns it into an ordinary named function
        // reference, exactly like the already-working named-closure case.
        dlh_hoist_expr(dlh_letbind_literal_args(callee, args, off, ctr), hoisted, ctr)
      } else {
        ECall(dlh_hoist_expr(callee, hoisted, ctr), for a in args {
          dlh_hoist_expr(a, hoisted, ctr)
        }, off)
      }
    },
    ETuple(es) => ETuple(for e in es {
      dlh_hoist_expr(e, hoisted, ctr)
    }),
    EArray(es) => EArray(for e in es {
      dlh_hoist_expr(e, hoisted, ctr)
    }),
    ESpread(e) => ESpread(dlh_hoist_expr(e, hoisted, ctr)),
    EContinue(es) => EContinue(for e in es {
      dlh_hoist_expr(e, hoisted, ctr)
    }),
    ERecord(rn, fs, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dlh_hoist_expr(v, hoisted, ctr)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dlh_hoist_expr(v, hoisted, ctr)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(dlh_hoist_expr(c, hoisted, ctr), dlh_hoist_expr(t, hoisted, ctr), dlh_hoist_expr(e, hoisted, ctr)),
    ELetRec(name, v, b) => ELetRec(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),
    ELetMut(name, v, b, soff) => ELetMut(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr), soff),
    EAssign(name, v, c) => EAssign(name, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(c, hoisted, ctr)),
    EAssignOp(name, op, v, c) => EAssignOp(name, op, dlh_hoist_expr(v, hoisted, ctr), dlh_hoist_expr(c, hoisted, ctr)),
    ESeq(a, b) => ESeq(dlh_hoist_expr(a, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),
    EWhile(c, b) => EWhile(dlh_hoist_expr(c, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),
    EForIn(name, idxn, it, b) => EForIn(name, idxn, dlh_hoist_expr(it, hoisted, ctr), dlh_hoist_expr(b, hoisted, ctr)),
    EDot(o, f, off, fdoff) => EDot(dlh_hoist_expr(o, hoisted, ctr), f, off, fdoff),
    ELabeledArg(l, m, e) => ELabeledArg(l, m, dlh_hoist_expr(e, hoisted, ctr)),
    EReturn(e) => EReturn(dlh_hoist_expr(e, hoisted, ctr)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(dlh_hoist_expr(e, hoisted, ctr))),
      None => expr
    },
    EFn(tp, bnds, params, rt, eff, body) => EFn(tp, bnds, params, rt, eff, dlh_hoist_expr(body, hoisted, ctr)),
    EMatch(s, arms) => EMatch(dlh_hoist_expr(s, hoisted, ctr), dlh_hoist_arms(arms, hoisted, ctr)),
    EHandle(s, arms) => EHandle(dlh_hoist_expr(s, hoisted, ctr), dlh_hoist_arms(arms, hoisted, ctr)),
    ELoop(params, b) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(params) {
        let (pn, init) = Array::get(params, i)
        Array::push(out, (pn, dlh_hoist_expr(init, hoisted, ctr)))
        i = i + 1
      }
      ELoop(out, dlh_hoist_expr(b, hoisted, ctr))
    },
    _ => expr
  }
}

///|
fn dlh_hoist_arms(arms: Array[(Pat, Expr)], hoisted: Array[Stmt], ctr: Array[Int]) -> Array[(Pat, Expr)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(arms) {
    let (p, b) = Array::get(arms, i)
    Array::push(out, (p, dlh_hoist_expr(b, hoisted, ctr)))
    i = i + 1
  }
  out
}

///|
fn dlh_hoist_stmt(stmt: Stmt, hoisted: Array[Stmt], ctr: Array[Int]) -> Stmt {
  match stmt {
    SLet(ex, rc, name, ty, body) => SLet(ex, rc, name, ty, dlh_hoist_expr(body, hoisted, ctr)),
    SLetMut(name, ty, body) => SLetMut(name, ty, dlh_hoist_expr(body, hoisted, ctr)),
    STest(name, body) => STest(name, dlh_hoist_expr(body, hoisted, ctr)),
    SBench(name, body) => SBench(name, dlh_hoist_expr(body, hoisted, ctr)),
    SExpr(e) => SExpr(dlh_hoist_expr(e, hoisted, ctr)),
    SLetPat(pat, e) => SLetPat(pat, dlh_hoist_expr(e, hoisted, ctr)),
    _ => stmt
  }
}

///|
/// In-place hoisting of non-capturing effectful local lambdas across the program.
export fn desugar_hoist_local_lambdas(stmts: Array[Stmt]) -> Unit {
  let hoisted = array_empty()
  let ctr = [
    0
  ]
  let n = Array::length(stmts)
  let mut i = 0
  while i < n {
    Array::set(stmts, i, dlh_hoist_stmt(Array::get(stmts, i), hoisted, ctr))
    i = i + 1
  }
  let mut h = 0
  while h < Array::length(hoisted) {
    Array::push(stmts, Array::get(hoisted, h))
    h = h + 1
  }
}

///|
/// Labeled-argument reordering. Named args are order-independent — `f(y=2, x=1)`
/// binds x=1, y=2 (cheatsheet "Labeled arguments"). Codegen strips ELabeledArg
/// labels and binds positionally, so a call given out of declared order used to
/// bind by position (silently wrong; `add`-style commutative calls masked it).
/// This pass reorders a FULLY-labeled call's args into the callee's declared
/// parameter order. It fires when the callee is a top-level let-bound function
/// (#986: ANY such function — a plain `fn add(x: Int, y: Int)` too, not just
/// `~`-labeled declarations; `fn` decls lower to `SLet` + `EFn` before this
/// pass, and a fully-labeled call names the parameters either way) and every
/// arg is an ELabeledArg naming one of its params; any other shape (positional,
/// partial, unknown callee) is left untouched, so positional binding is
/// unchanged.
fn strip_label_tilde(n: String) -> String {
  let ln = String::length(n)
  if ln > 0 {
    let last = n[ln - 1: ln]
    if last == "~" || last == "?" {
      n[0: ln - 1]
    } else {
      n
    }
  } else {
    n
  }
}

///|
/// fname -> ordered param base names, for every top-level `let f = (..) -> ..`
/// (#986: labeled or not — see the pass comment above).
fn collect_fn_param_labels(stmts: Array[Stmt]) -> Array[(String, Array[String])] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(_, _, params, _, _, _) => {
          let labels = empty_str_array()
          let mut pi = 0
          while pi < Array::length(params) {
            let (pn, _) = Array::get(params, pi)
            Array::push(labels, strip_label_tilde(pn))
            pi = pi + 1
          }
          Array::push(out, (fname, labels))
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

///|
fn lookup_param_labels(tbl: Array[(String, Array[String])], fname: String) -> Option[Array[String]] {
  let mut i = 0
  let mut found = None
  while i < Array::length(tbl) {
    let (n, labels) = Array::get(tbl, i)
    if n == fname {
      found = Some(labels)
      i = Array::length(tbl)
    } else {
      i = i + 1
    }
  }
  found
}

///|
/// Reorder a fully-labeled arg list into `param_labels` order. None when the call
/// is not a candidate (arity mismatch, some arg not labeled, or a label matches no
/// parameter) — the caller then leaves the args untouched.
fn reorder_labeled_args(args: Array[Expr], param_labels: Array[String]) -> Option[Array[Expr]] {
  if Array::length(args) != Array::length(param_labels) {
    None
  } else {
    let mut all_labeled = true
    let mut i = 0
    while i < Array::length(args) {
      let is_lbl = match Array::get(args, i) {
        ELabeledArg(_, _, _) => true,
        _ => false
      }
      if is_lbl {
        ()
      } else {
        all_labeled = false
      }
      i = i + 1
    }
    if !all_labeled {
      None
    } else {
      let out = empty_expr_array()
      let mut ok = true
      let mut pj = 0
      while pj < Array::length(param_labels) {
        let want = Array::get(param_labels, pj)
        let mut fk = -1
        let mut k = 0
        while k < Array::length(args) {
          match Array::get(args, k) {
            ELabeledArg(lbl, _, _) => if lbl == want && fk < 0 {
              fk = k
            } else {
              ()
            },
            _ => ()
          }
          k = k + 1
        }
        if fk < 0 {
          ok = false
          pj = Array::length(param_labels)
        } else {
          Array::push(out, Array::get(args, fk))
          pj = pj + 1
        }
      }
      if ok {
        Some(out)
      } else {
        None
      }
    }
  }
}

///|
/// #986 (Codex P2-2 on #993): is `name` lexically shadowed at this point? The
/// table indexes TOP-LEVEL functions only, so a local binding of the same name
/// (`let f = (y) -> ..` / a fn param / a pattern bind) must suppress both the
/// reorder and the label-name validation — the call resolves to the local
/// value, whose parameter names the table knows nothing about.
fn relabel_shadowed(shadows: Array[String], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(shadows) {
    if Array::get(shadows, i) == name {
      found = true
      i = Array::length(shadows)
    } else {
      i = i + 1
    }
  }
  found
}

///|
fn relabel_pat_binds(pat: Pat, shadows: Array[String]) -> Unit {
  match pat {
    PBind(n) => Array::push(shadows, n),
    PCtor(_, ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        relabel_pat_binds(Array::get(ps, i), shadows)
        i = i + 1
      }
    },
    PTuple(ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        relabel_pat_binds(Array::get(ps, i), shadows)
        i = i + 1
      }
    },
    POr(a, b) => {
      relabel_pat_binds(a, shadows)
      relabel_pat_binds(b, shadows)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        relabel_pat_binds(fp, shadows)
        i = i + 1
      }
    },
    _ => ()
  }
}

///|
/// Strip the ELabeledArg wrappers off a VALIDATED arg list (labels confirmed to
/// match their positions — either via a successful full reorder, or
/// individually below). Codegen binds positionally and ignores labels, so this
/// is semantically neutral there; for the checker it is the RESOLUTION MARKER:
/// a stripped arg participates in strict positional unification, while a
/// surviving ELabeledArg means "label correspondence unknown here" and types
/// tolerantly (see check_expr's ELabeledArg arm) — the erroneous local shapes
/// are reported by name (check_labeled_arg_names_stmts), and import-resolved
/// callees (whose param names this module cannot see, Codex P2-1 on #993) are
/// no longer falsely rejected by position.
fn strip_labeled_wrappers(args: Array[Expr]) -> Array[Expr] {
  let out = empty_expr_array()
  let mut i = 0
  while i < Array::length(args) {
    match Array::get(args, i) {
      ELabeledArg(_, _, v) => Array::push(out, v),
      other => Array::push(out, other)
    }
    i = i + 1
  }
  out
}

///|
/// For a call that could NOT be fully reordered (partial labeling, or some
/// label mismatched): strip only the labeled args whose label already matches
/// the parameter at their own position — those are positionally correct
/// decorative labels and must stay strictly type-checked. Mismatched ones are
/// kept for the name-validation walk to report.
fn strip_in_position_labels(args: Array[Expr], labels: Array[String]) -> Array[Expr] {
  let out = empty_expr_array()
  let mut i = 0
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    match arg {
      ELabeledArg(lbl, m, v) => if i < Array::length(labels) && Array::get(labels, i) == lbl {
        Array::push(out, v)
      } else {
        Array::push(out, ELabeledArg(lbl, m, v))
      },
      other => Array::push(out, other)
    }
    i = i + 1
  }
  out
}

///|
fn relabel_expr(expr: Expr, tbl: Array[(String, Array[String])], shadows: Array[String]) -> Expr {
  match expr {
    ECall(callee, args, off) => {
      let rargs = for a in args {
        relabel_expr(a, tbl, shadows)
      }
      let rcallee = relabel_expr(callee, tbl, shadows)
      // #986: `tbl` now holds EVERY top-level function (not just `~`-labeled
      // ones), so gate the linear table scan on the call actually carrying a
      // labeled argument — labeled calls are rare, plain calls are the entire
      // program.
      let mut any_labeled_arg = false
      let mut la_i = 0
      while la_i < Array::length(rargs) {
        match Array::get(rargs, la_i) {
          ELabeledArg(_, _, _) => {
            any_labeled_arg = true
          },
          _ => ()
        }
        la_i = la_i + 1
      }
      let final_args = if any_labeled_arg {
        match callee {
          EIdent(fname, _) => if relabel_shadowed(shadows, fname) {
            rargs
          } else {
            match lookup_param_labels(tbl, fname) {
              Some(labels) => match reorder_labeled_args(rargs, labels) {
                Some(reordered) => strip_labeled_wrappers(reordered),
                None => strip_in_position_labels(rargs, labels)
              },
              None => rargs
            }
          },
          _ => rargs
        }
      } else {
        rargs
      }
      ECall(rcallee, final_args, off)
    },
    EBinOp(op, l, r) => EBinOp(op, relabel_expr(l, tbl, shadows), relabel_expr(r, tbl, shadows)),
    EUnaryOp(op, e) => EUnaryOp(op, relabel_expr(e, tbl, shadows)),
    ETuple(elems) => ETuple(for e in elems {
      relabel_expr(e, tbl, shadows)
    }),
    EArray(elems) => EArray(for e in elems {
      relabel_expr(e, tbl, shadows)
    }),
    ESpread(e) => ESpread(relabel_expr(e, tbl, shadows)),
    ERecord(rn, fields, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fval) = Array::get(fields, i)
        Array::push(out, (fname, relabel_expr(fval, tbl, shadows)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fields) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (k, v) = Array::get(fields, i)
        Array::push(out, (k, relabel_expr(v, tbl, shadows)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(relabel_expr(c, tbl, shadows), relabel_expr(t, tbl, shadows), relabel_expr(e, tbl, shadows)),
    ELet(name, v, b, soff) => {
      let rv = relabel_expr(v, tbl, shadows)
      let mark = Array::length(shadows)
      Array::push(shadows, name)
      let rb = relabel_expr(b, tbl, shadows)
      Array::truncate(shadows, mark)
      ELet(name, rv, rb, soff)
    },
    ELetRec(name, v, b) => {
      let mark = Array::length(shadows)
      Array::push(shadows, name)
      let rv = relabel_expr(v, tbl, shadows)
      let rb = relabel_expr(b, tbl, shadows)
      Array::truncate(shadows, mark)
      ELetRec(name, rv, rb)
    },
    ELetMut(name, v, b, soff) => {
      let rv = relabel_expr(v, tbl, shadows)
      let mark = Array::length(shadows)
      Array::push(shadows, name)
      let rb = relabel_expr(b, tbl, shadows)
      Array::truncate(shadows, mark)
      ELetMut(name, rv, rb, soff)
    },
    EAssign(name, v, c) => EAssign(name, relabel_expr(v, tbl, shadows), relabel_expr(c, tbl, shadows)),
    EAssignOp(name, op, v, c) => EAssignOp(name, op, relabel_expr(v, tbl, shadows), relabel_expr(c, tbl, shadows)),
    ESeq(a, b) => ESeq(relabel_expr(a, tbl, shadows), relabel_expr(b, tbl, shadows)),
    EMatch(scrut, arms) => {
      let rscrut = relabel_expr(scrut, tbl, shadows)
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        let mark = Array::length(shadows)
        relabel_pat_binds(p, shadows)
        Array::push(out, (p, relabel_expr(b, tbl, shadows)))
        Array::truncate(shadows, mark)
        i = i + 1
      }
      EMatch(rscrut, out)
    },
    EHandle(scrut, arms) => {
      let rscrut = relabel_expr(scrut, tbl, shadows)
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        let mark = Array::length(shadows)
        relabel_pat_binds(p, shadows)
        Array::push(out, (p, relabel_expr(b, tbl, shadows)))
        Array::truncate(shadows, mark)
        i = i + 1
      }
      EHandle(rscrut, out)
    },
    EWhile(c, b) => EWhile(relabel_expr(c, tbl, shadows), relabel_expr(b, tbl, shadows)),
    ELoop(params, b) => {
      let rinits = for param in params {
        let (name, init) = param
        (name, relabel_expr(init, tbl, shadows))
      }
      let mark = Array::length(shadows)
      let mut pi = 0
      while pi < Array::length(params) {
        let (pname, _) = Array::get(params, pi)
        Array::push(shadows, pname)
        pi = pi + 1
      }
      let rb = relabel_expr(b, tbl, shadows)
      Array::truncate(shadows, mark)
      ELoop(rinits, rb)
    },
    EForIn(name, idx, iter, b) => {
      let riter = relabel_expr(iter, tbl, shadows)
      let mark = Array::length(shadows)
      Array::push(shadows, name)
      match idx {
        Some(ix) => Array::push(shadows, ix),
        None => ()
      }
      let rb = relabel_expr(b, tbl, shadows)
      Array::truncate(shadows, mark)
      EForIn(name, idx, riter, rb)
    },
    EFn(tp, bnds, params, rt, eff, b) => {
      let mark = Array::length(shadows)
      let mut pi = 0
      while pi < Array::length(params) {
        let (pn, _) = Array::get(params, pi)
        Array::push(shadows, strip_label_tilde(pn))
        pi = pi + 1
      }
      let rb = relabel_expr(b, tbl, shadows)
      Array::truncate(shadows, mark)
      EFn(tp, bnds, params, rt, eff, rb)
    },
    EDot(obj, field, off, fdoff) => EDot(relabel_expr(obj, tbl, shadows), field, off, fdoff),
    ELabeledArg(label, name, b) => ELabeledArg(label, name, relabel_expr(b, tbl, shadows)),
    EReturn(e) => EReturn(relabel_expr(e, tbl, shadows)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(relabel_expr(e, tbl, shadows))),
      None => expr
    },
    EContinue(exprs) => EContinue(for e in exprs {
      relabel_expr(e, tbl, shadows)
    }),
    _ => expr
  }
}

///|
fn relabel_stmt(stmt: Stmt, tbl: Array[(String, Array[String])]) -> Stmt {
  match stmt {
    SLet(ex, rc, name, ty, body) => SLet(ex, rc, name, ty, relabel_expr(body, tbl, empty_str_array())),
    SLetMut(name, ty, body) => SLetMut(name, ty, relabel_expr(body, tbl, empty_str_array())),
    STest(name, body) => STest(name, relabel_expr(body, tbl, empty_str_array())),
    SBench(name, body) => SBench(name, relabel_expr(body, tbl, empty_str_array())),
    SExpr(e) => SExpr(relabel_expr(e, tbl, empty_str_array())),
    SLetPat(pat, e) => SLetPat(pat, relabel_expr(e, tbl, empty_str_array())),
    SModule(ex, name, stmts) => SModule(ex, name, for s in stmts {
      relabel_stmt(s, tbl)
    }),
    _ => stmt
  }
}

///|
/// #986: read-only containment scan — does this expr contain any ELabeledArg?
/// Used to gate the (allocating) relabel_stmt rebuild per top-level statement,
/// since collect_fn_param_labels now indexes EVERY top-level function and the
/// old `tbl empty -> skip` fast path no longer fires for ordinary programs.
fn expr_has_labeled_arg(expr: Expr) -> Bool {
  match expr {
    ELabeledArg(_, _, _) => true,
    ECall(callee, args, _) => {
      let mut found = expr_has_labeled_arg(callee)
      let mut i = 0
      while i < Array::length(args) {
        if found {
          i = Array::length(args)
        } else {
          found = expr_has_labeled_arg(Array::get(args, i))
          i = i + 1
        }
      }
      found
    },
    EBinOp(_, l, r) => expr_has_labeled_arg(l) || expr_has_labeled_arg(r),
    EUnaryOp(_, e) => expr_has_labeled_arg(e),
    ETuple(elems) => arr_has_labeled_arg(elems),
    EArray(elems) => arr_has_labeled_arg(elems),
    ESpread(e) => expr_has_labeled_arg(e),
    ERecord(_, fields, _) => pairs_have_labeled_arg(fields),
    EMap(fields) => pairs_have_labeled_arg(fields),
    EIf(c, t, e) => expr_has_labeled_arg(c) || expr_has_labeled_arg(t) || expr_has_labeled_arg(e),
    ELet(_, v, b, _) => expr_has_labeled_arg(v) || expr_has_labeled_arg(b),
    ELetRec(_, v, b) => expr_has_labeled_arg(v) || expr_has_labeled_arg(b),
    ELetMut(_, v, b, _) => expr_has_labeled_arg(v) || expr_has_labeled_arg(b),
    EAssign(_, v, k) => expr_has_labeled_arg(v) || expr_has_labeled_arg(k),
    EAssignOp(_, _, v, k) => expr_has_labeled_arg(v) || expr_has_labeled_arg(k),
    ESeq(a, b) => expr_has_labeled_arg(a) || expr_has_labeled_arg(b),
    EMatch(scrut, arms) => expr_has_labeled_arg(scrut) || arms_have_labeled_arg(arms),
    EHandle(scrut, arms) => expr_has_labeled_arg(scrut) || arms_have_labeled_arg(arms),
    EWhile(c, b) => expr_has_labeled_arg(c) || expr_has_labeled_arg(b),
    ELoop(inits, b) => pairs_have_labeled_arg(inits) || expr_has_labeled_arg(b),
    EForIn(_, _, iter, b) => expr_has_labeled_arg(iter) || expr_has_labeled_arg(b),
    EFn(_, _, _, _, _, b) => expr_has_labeled_arg(b),
    EDot(obj, _, _, _) => expr_has_labeled_arg(obj),
    EReturn(e) => expr_has_labeled_arg(e),
    EBreak(opt) => match opt {
      Some(e) => expr_has_labeled_arg(e),
      None => false
    },
    EContinue(exprs) => arr_has_labeled_arg(exprs),
    _ => false
  }
}

///|
fn arr_has_labeled_arg(exprs: Array[Expr]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(exprs) {
    if found {
      i = Array::length(exprs)
    } else {
      found = expr_has_labeled_arg(Array::get(exprs, i))
      i = i + 1
    }
  }
  found
}

///|
fn pairs_have_labeled_arg(pairs: Array[(String, Expr)]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(pairs) {
    if found {
      i = Array::length(pairs)
    } else {
      let (_, v) = Array::get(pairs, i)
      found = expr_has_labeled_arg(v)
      i = i + 1
    }
  }
  found
}

///|
fn arms_have_labeled_arg(arms: Array[(Pat, Expr)]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(arms) {
    if found {
      i = Array::length(arms)
    } else {
      let (_, b) = Array::get(arms, i)
      found = expr_has_labeled_arg(b)
      i = i + 1
    }
  }
  found
}

///|
fn stmt_has_labeled_arg(stmt: Stmt) -> Bool {
  match stmt {
    SLet(_, _, _, _, body) => expr_has_labeled_arg(body),
    SLetMut(_, _, body) => expr_has_labeled_arg(body),
    STest(_, body) => expr_has_labeled_arg(body),
    SBench(_, body) => expr_has_labeled_arg(body),
    SExpr(e) => expr_has_labeled_arg(e),
    SLetPat(_, e) => expr_has_labeled_arg(e),
    SModule(_, _, ms) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(ms) {
        if found {
          i = Array::length(ms)
        } else {
          found = stmt_has_labeled_arg(Array::get(ms, i))
          i = i + 1
        }
      }
      found
    },
    _ => false
  }
}

///|
/// In-place labeled-argument reordering over a whole program. Rebuilds only the
/// top-level statements that actually contain a labeled argument (see
/// expr_has_labeled_arg).
export fn desugar_labeled_args(stmts: Array[Stmt]) -> Unit {
  let tbl = collect_fn_param_labels(stmts)
  if Array::length(tbl) == 0 {
    ()
  } else {
    let mut i = 0
    while i < Array::length(stmts) {
      if stmt_has_labeled_arg(Array::get(stmts, i)) {
        Array::set(stmts, i, relabel_stmt(Array::get(stmts, i), tbl))
      } else {
        ()
      }
      i = i + 1
    }
  }
}

///|
/// #790: lower array-literal spreads `[a, ...xs, b]` into an `Array::concat` chain
/// of segments (`Array::concat(Array::concat([a], xs), [b])`). The parser accepts
/// `...expr` inside an array literal (ESpread), but the active desugar pipeline
/// never lowered it, so codegen reached ESpread and threw "unsupported expression
/// in codegen". Ported from the legacy desugar.vibe (spread-only; no other legacy
/// transforms). `das_arms` is mutually recursive with `das_expr`.
fn das_expr(expr: Expr) -> Expr {
  match expr {
    EArray(elems) => {
      let mut has_spread = false
      let mut si0 = 0
      while si0 < Array::length(elems) {
        match Array::get(elems, si0) {
          ESpread(_) => {
            has_spread = true
          },
          _ => ()
        }
        si0 = si0 + 1
      }
      if has_spread {
        let segments = array_empty()
        let mut buf = empty_expr_array()
        let mut si = 0
        while si < Array::length(elems) {
          let elem = Array::get(elems, si)
          match elem {
            ESpread(inner) => {
              if Array::length(buf) > 0 {
                Array::push(segments, EArray(for e in buf {
                  das_expr(e)
                }))
                buf = empty_expr_array()
              } else {
                ()
              }
              Array::push(segments, das_expr(inner))
            },
            _ => Array::push(buf, elem)
          }
          si = si + 1
        }
        if Array::length(buf) > 0 {
          Array::push(segments, EArray(for e in buf {
            das_expr(e)
          }))
        } else {
          ()
        }
        let mut acc = Array::get(segments, 0)
        let mut fi = 1
        while fi < Array::length(segments) {
          acc = ECall(EIdent("Array::concat", 0 - 1), [
            acc,
            Array::get(segments, fi)
          ], 0 - 1)
          fi = fi + 1
        }
        acc
      } else {
        EArray(for e in elems {
          das_expr(e)
        })
      }
    },
    ETuple(es) => ETuple(for e in es {
      das_expr(e)
    }),
    ERecord(rn, fs, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, das_expr(v)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, das_expr(v)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(das_expr(c), das_expr(t), das_expr(e)),
    ELet(n, v, b, soff) => ELet(n, das_expr(v), das_expr(b), soff),
    ELetRec(n, v, b) => ELetRec(n, das_expr(v), das_expr(b)),
    ELetMut(n, v, b, soff) => ELetMut(n, das_expr(v), das_expr(b), soff),
    EAssign(n, v, c) => EAssign(n, das_expr(v), das_expr(c)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, das_expr(v), das_expr(c)),
    ESeq(a, b) => ESeq(das_expr(a), das_expr(b)),
    EMatch(s, arms) => EMatch(das_expr(s), das_arms(arms)),
    EHandle(s, arms) => EHandle(das_expr(s), das_arms(arms)),
    EWhile(c, b) => EWhile(das_expr(c), das_expr(b)),
    ELoop(params, b) => ELoop(for param in params {
      let (name, init) = param
      (name, das_expr(init))
    }, das_expr(b)),
    EForIn(n, idxn, it, b) => EForIn(n, idxn, das_expr(it), das_expr(b)),
    ECall(callee, args, off) => ECall(das_expr(callee), for a in args {
      das_expr(a)
    }, off),
    EBinOp(op, l, r) => EBinOp(op, das_expr(l), das_expr(r)),
    EUnaryOp(op, e) => EUnaryOp(op, das_expr(e)),
    EFn(tp, tb, params, rt, eff, body) => EFn(tp, tb, params, rt, eff, das_expr(body)),
    EDot(o, f, off, fdoff) => EDot(das_expr(o), f, off, fdoff),
    ELabeledArg(l, m, e) => ELabeledArg(l, m, das_expr(e)),
    EReturn(e) => EReturn(das_expr(e)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(das_expr(e))),
      None => expr
    },
    EContinue(es) => EContinue(for e in es {
      das_expr(e)
    }),
    ESpread(inner) => ESpread(das_expr(inner)),
    _ => expr
  }
}

///|
fn das_arms(arms: Array[(Pat, Expr)]) -> Array[(Pat, Expr)] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(arms) {
    let (p, b) = Array::get(arms, i)
    Array::push(out, (p, das_expr(b)))
    i = i + 1
  }
  out
}

///|
fn das_stmt(stmt: Stmt) -> Stmt {
  match stmt {
    SLet(ex, rc, name, ty, body) => SLet(ex, rc, name, ty, das_expr(body)),
    SLetMut(name, ty, body) => SLetMut(name, ty, das_expr(body)),
    STest(name, body) => STest(name, das_expr(body)),
    SBench(name, body) => SBench(name, das_expr(body)),
    SExpr(e) => SExpr(das_expr(e)),
    SLetPat(pat, e) => SLetPat(pat, das_expr(e)),
    _ => stmt
  }
}

///|
/// In-place lowering of array-literal spreads across the whole program (#790).
export fn desugar_array_spread(stmts: Array[Stmt]) -> Unit {
  let n = Array::length(stmts)
  let mut i = 0
  while i < n {
    Array::set(stmts, i, das_stmt(Array::get(stmts, i)))
    i = i + 1
  }
}

///|
fn dtpw_exprs_bind_name(es: Array[Expr], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(es) && !found {
    if dtpw_expr_binds_name(Array::get(es, i), name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

///|
/// Does `expr` bind (shadow) `name` ANYWHERE within it -- as an EFn
/// parameter, a `let`/`let mut`/`let rec` name, a match/handle arm's
/// pattern binder, a for-loop's item/index name, or a `loop` parameter?
/// Full-coverage traversal mirroring dtpw_inline_expr's own node coverage.
/// See dtpw_collect_wrappers' call site for why this exists (#1074 review,
/// chatgpt-codex-connector P1: "Respect lexical shadowing in wrapper
/// inlining").
fn dtpw_expr_binds_name(expr: Expr, name: String) -> Bool {
  match expr {
    EFn(_, _, params, _, _, body) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(params) && !found {
        let (pn, _) = Array::get(params, i)
        if dlh_strip_tilde(pn) == name {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found || dtpw_expr_binds_name(body, name)
    },
    ELet(n, v, b, _) => n == name || dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(b, name),
    ELetRec(n, v, b) => n == name || dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(b, name),
    ELetMut(n, v, b, _) => n == name || dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(b, name),
    EForIn(n, idxn, it, b) => {
      let idx_hit = match idxn {
        Some(i2) => i2 == name,
        None => false
      }
      n == name || idx_hit || dtpw_expr_binds_name(it, name) || dtpw_expr_binds_name(b, name)
    },
    ELoop(params, b) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(params) && !found {
        let (pn, init) = Array::get(params, i)
        if pn == name || dtpw_expr_binds_name(init, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found || dtpw_expr_binds_name(b, name)
    },
    EMatch(s, arms) => {
      let mut i = 0
      let mut found = dtpw_expr_binds_name(s, name)
      while i < Array::length(arms) && !found {
        let (p, b) = Array::get(arms, i)
        let bound = array_empty()
        dlh_pat_binds(p, bound)
        if dlh_contains(bound, name) || dtpw_expr_binds_name(b, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EHandle(s, arms) => {
      let mut i = 0
      let mut found = dtpw_expr_binds_name(s, name)
      while i < Array::length(arms) && !found {
        let (p, b) = Array::get(arms, i)
        let bound = array_empty()
        dlh_pat_binds(p, bound)
        if dlh_contains(bound, name) || dtpw_expr_binds_name(b, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ECall(callee, args, _) => dtpw_expr_binds_name(callee, name) || dtpw_exprs_bind_name(args, name),
    EBinOp(_, l, r) => dtpw_expr_binds_name(l, name) || dtpw_expr_binds_name(r, name),
    EUnaryOp(_, e) => dtpw_expr_binds_name(e, name),
    ETuple(es) => dtpw_exprs_bind_name(es, name),
    EArray(es) => dtpw_exprs_bind_name(es, name),
    ESpread(e) => dtpw_expr_binds_name(e, name),
    EContinue(es) => dtpw_exprs_bind_name(es, name),
    ERecord(_, fs, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fs) && !found {
        let (_, v) = Array::get(fs, i)
        if dtpw_expr_binds_name(v, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EMap(fs) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fs) && !found {
        let (_, v) = Array::get(fs, i)
        if dtpw_expr_binds_name(v, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EIf(c, t, e) => dtpw_expr_binds_name(c, name) || dtpw_expr_binds_name(t, name) || dtpw_expr_binds_name(e, name),
    EAssign(_, v, c) => dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(c, name),
    EAssignOp(_, _, v, c) => dtpw_expr_binds_name(v, name) || dtpw_expr_binds_name(c, name),
    ESeq(a, b) => dtpw_expr_binds_name(a, name) || dtpw_expr_binds_name(b, name),
    EWhile(c, b) => dtpw_expr_binds_name(c, name) || dtpw_expr_binds_name(b, name),
    EDot(o, _, _, _) => dtpw_expr_binds_name(o, name),
    ELabeledArg(_, _, e) => dtpw_expr_binds_name(e, name),
    EReturn(e) => dtpw_expr_binds_name(e, name),
    EBreak(opt) => match opt {
      Some(e) => dtpw_expr_binds_name(e, name),
      None => false
    },
    _ => false
  }
}

///|
/// #1070 (narrow slice): a "trivial pass-through wrapper" is a top-level
/// `let name = (param) -> T with { ... } { param() }` -- exactly one
/// parameter, body is EXACTLY a zero-arg call to that same parameter and
/// nothing else. Collects (wrapper_name, needed) pairs; `needed` is always
/// true here (arity always matches: the wrapper always takes exactly 1 arg
/// and calls its param with exactly 0), kept as a tuple only for symmetry
/// with how this file's other collector helpers are shaped.
///
/// A collected name is DROPPED again if it's shadowed ANYWHERE in the
/// program (any nested `let`/`let mut`/EFn parameter/match-or-handle-arm
/// binder/for-loop name/loop parameter reusing the same identifier) --
/// dtpw_inline_expr's rewrite matches call sites by NAME ONLY with no
/// scope tracking, so a shadowed name would otherwise get inlined at the
/// WRONG (shadowing) binding's call sites too, changing real program
/// behavior (#1074 review, chatgpt-codex-connector P1). This is
/// deliberately whole-program-conservative rather than precisely
/// scope-threaded: losing the optimization on the rare program that
/// happens to reuse a wrapper's name as a binder elsewhere is an
/// acceptable trade for guaranteed correctness, matching this file's
/// established "bail out entirely when it can't be proven safe" pattern
/// (see dlh_marker_only_called_directly's own doc comment).
fn dtpw_collect_wrappers(stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, EFn(_, _, params, _, _, body)) => if Array::length(params) == 1 {
        let (pname, _) = Array::get(params, 0)
        let stripped = dlh_strip_tilde(pname)
        match body {
          ECall(callee, args, _) => match callee {
            EIdent(cn, _) => if cn == stripped && Array::length(args) == 0 {
              Array::push(out, name)
            } else {
              ()
            },
            _ => ()
          },
          _ => ()
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  let safe = array_empty()
  let mut j = 0
  while j < Array::length(out) {
    let wn = Array::get(out, j)
    let mut shadowed = false
    let mut k = 0
    while k < Array::length(stmts) && !shadowed {
      match Array::get(stmts, k) {
        SLet(_, _, _, _, sv) => if dtpw_expr_binds_name(sv, wn) {
          shadowed = true
        } else {
          ()
        },
        _ => ()
      }
      k = k + 1
    }
    if !shadowed {
      Array::push(safe, wn)
    } else {
      ()
    }
    j = j + 1
  }
  safe
}

/// Rewrite every `ECall(EIdent(wname), [single_arg], off)` where `wname` is a
/// collected trivial wrapper into `ECall(single_arg, [], off)` -- calling the
/// argument directly instead of routing through the identity wrapper. Full
/// traversal (mirrors this file's other full-coverage passes); the wrapper's
/// own top-level definition is left completely untouched, so it remains
/// valid wherever else it's referenced (as a value, or with a different
/// arity that wouldn't match here anyway).
fn dtpw_inline_expr(expr: Expr, wrappers: Array[String]) -> Expr {
  match expr {
    ECall(callee, args, off) => match callee {
      EIdent(wn, _) => if dlh_contains(wrappers, wn) && Array::length(args) == 1 {
        ECall(dtpw_inline_expr(Array::get(args, 0), wrappers), array_empty(), off)
      } else {
        ECall(dtpw_inline_expr(callee, wrappers), for a in args {
          dtpw_inline_expr(a, wrappers)
        }, off)
      },
      _ => ECall(dtpw_inline_expr(callee, wrappers), for a in args {
        dtpw_inline_expr(a, wrappers)
      }, off)
    },
    EBinOp(op, l, r) => EBinOp(op, dtpw_inline_expr(l, wrappers), dtpw_inline_expr(r, wrappers)),
    EUnaryOp(op, e) => EUnaryOp(op, dtpw_inline_expr(e, wrappers)),
    ETuple(es) => ETuple(for e in es {
      dtpw_inline_expr(e, wrappers)
    }),
    EArray(es) => EArray(for e in es {
      dtpw_inline_expr(e, wrappers)
    }),
    ESpread(e) => ESpread(dtpw_inline_expr(e, wrappers)),
    EContinue(es) => EContinue(for e in es {
      dtpw_inline_expr(e, wrappers)
    }),
    ERecord(rn, fs, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dtpw_inline_expr(v, wrappers)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fs) {
        let (k, v) = Array::get(fs, i)
        Array::push(out, (k, dtpw_inline_expr(v, wrappers)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(dtpw_inline_expr(c, wrappers), dtpw_inline_expr(t, wrappers), dtpw_inline_expr(e, wrappers)),
    ELet(n, v, b, soff) => ELet(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(b, wrappers), soff),
    ELetRec(n, v, b) => ELetRec(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(b, wrappers)),
    ELetMut(n, v, b, soff) => ELetMut(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(b, wrappers), soff),
    EAssign(n, v, c) => EAssign(n, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(c, wrappers)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, dtpw_inline_expr(v, wrappers), dtpw_inline_expr(c, wrappers)),
    ESeq(a, b) => ESeq(dtpw_inline_expr(a, wrappers), dtpw_inline_expr(b, wrappers)),
    EWhile(c, b) => EWhile(dtpw_inline_expr(c, wrappers), dtpw_inline_expr(b, wrappers)),
    EForIn(n, idxn, it, b) => EForIn(n, idxn, dtpw_inline_expr(it, wrappers), dtpw_inline_expr(b, wrappers)),
    EDot(o, f, off, fdoff) => EDot(dtpw_inline_expr(o, wrappers), f, off, fdoff),
    ELabeledArg(l, m, e) => ELabeledArg(l, m, dtpw_inline_expr(e, wrappers)),
    EReturn(e) => EReturn(dtpw_inline_expr(e, wrappers)),
    EBreak(opt) => EBreak(match opt {
      Some(e) => Some(dtpw_inline_expr(e, wrappers)),
      None => None
    }),
    EFn(tp, bnds, params, rt, eff, body) => EFn(tp, bnds, params, rt, eff, dtpw_inline_expr(body, wrappers)),
    EMatch(s, arms) => EMatch(dtpw_inline_expr(s, wrappers), for a in arms {
      let (p, b) = a
      (p, dtpw_inline_expr(b, wrappers))
    }),
    EHandle(s, arms) => EHandle(dtpw_inline_expr(s, wrappers), for a in arms {
      let (p, b) = a
      (p, dtpw_inline_expr(b, wrappers))
    }),
    ELoop(params, b) => ELoop(for p in params {
      let (pn, init) = p
      (pn, dtpw_inline_expr(init, wrappers))
    }, dtpw_inline_expr(b, wrappers)),
    _ => expr
  }
}

fn dtpw_inline_trivial_wrappers(stmts: Array[Stmt]) -> Unit {
  let wrappers = dtpw_collect_wrappers(stmts)
  if Array::length(wrappers) == 0 {
    ()
  } else {
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, i, SLet(exported, is_rec, name, ty, dtpw_inline_expr(expr, wrappers))),
        _ => ()
      }
      i = i + 1
    }
  }
}

///|
/// Entry point: in-place dictionary-passing desugaring. No-op unless the program
/// declares at least one method-bearing trait. Idempotent: re-running (the
/// single-file pipeline desugars before generic-stripping and codegen re-runs on
/// the same stmts after) finds the bounds already stripped (so no function is
/// re-threaded) and skips dict structs that already exist.
export fn desugar_trait_dicts(stmts: Array[Stmt]) -> Unit with { Error } {
  // #790: lower array-literal spreads first, so no downstream pass or codegen
  // ever sees a raw ESpread.
  desugar_array_spread(stmts)
  // #1070 (narrow slice): inline a trivial pass-through wrapper
  // (`let apply = (f) -> { f() }`, body EXACTLY a same-arity direct call to
  // its own sole parameter, nothing else) at each matching call site
  // (`apply(x)` -> `x()`), before #786's hoist below. A capturing effectful
  // closure PASSED BY VALUE through such a wrapper (`apply(inner)` where
  // `inner` captures a local) crashes independent of #1069's closure-
  // conversion fix -- #1069 only rewrites provably-direct call sites, and
  // `inner` used as a bare argument to `apply` is exactly the "used as a
  // value" shape it correctly declines to touch. This doesn't attempt the
  // general problem (#1070's own analysis: real closure-conversion-to-
  // value semantics, or fixing #786's still-unlocated deeper combinator
  // bug) -- it only recognizes the specific case where the "value use" is
  // itself immediately, trivially, and unconditionally a direct call one
  // level removed, and short-circuits it back into an ordinary direct
  // call BEFORE #786/#1069's hoist+conversion logic runs, so THAT already-
  // verified machinery picks it up exactly as if the caller had written
  // `inner()` directly. Always sound regardless of what the argument does
  // (identity-wrapper inlining never changes observable behavior -- the
  // wrapper's own row already required whatever effects the checker
  // already validated at the original `apply(inner)` call site, and
  // `inner()` requires the identical row by construction), and leaves the
  // wrapper's own top-level definition untouched (usable as a value
  // wherever else it's referenced) -- only matching call sites are
  // rewritten, so a wrapper used BOTH as a value AND as a direct call
  // elsewhere is still handled safely either way.
  dtpw_inline_trivial_wrappers(stmts)
  // #786: hoist non-capturing effectful local lambdas to top-level functions
  // before any other pass. A local `let f = (x) -> { perform ... }` that captures
  // nothing gets promoted to a top-level `let f = ...`, so codegen emits a direct
  // function (with its `$read` effect param) instead of a local closure whose
  // arity-1 type may go unregistered. Runs first so the hoisted top-level SLets
  // are processed by every downstream pass (labeled args, dict rewrite, codegen).
  desugar_hoist_local_lambdas(stmts)
  // Labeled-argument reordering runs first so downstream passes and codegen see
  // args already in declared parameter order.
  desugar_labeled_args(stmts)
  // #760(2): make `Result` (Ok/Err) available standalone by appending its enum
  // declaration when neither declared nor imported. Runs first so the ctor table
  // and every downstream pass see it. Idempotent + inert when already present.
  inject_prelude_result(stmts)
  // derive(...) structural function generation (#638) — independent of traits,
  // idempotent, so it runs unconditionally here at the shared pre-check points.
  desugar_derives(stmts)
  // Flatten supertrait methods into each trait so `[T: B]` (for `trait B: A`)
  // dispatches both B's and A's methods through one witness dictionary. When the
  // program declares no method-bearing trait `traits` is empty, the dict-passing
  // rewrites are all no-ops (`gens` empty, sync-`for` classification gated off),
  // and the rewrite pass only classifies the ASYNC for-loop shapes — so it must
  // still run unconditionally (those shapes need no trait machinery, #1350).
  let traits_raw = collect_method_traits(stmts)
  let supers_map = collect_trait_supers(stmts)
  let traits = flatten_traits(traits_raw, supers_map)
  // Rank-1 method generics (#684): re-attach each trait method's `[X: Bound]`
  // binder to its impl free functions (and annotate their params) BEFORE
  // build_gens, so `C::m` is registered as a bounded generic and the existing
  // dict-passing threads the witness at qualified call sites. Inert (and
  // idempotent) when no trait declares a method-level binder. Also run from
  // `check_program` so the FS-compile path (which type-checks before this pass)
  // sees the `X` binding and can resolve `X::method` in the impl body.
  inject_trait_method_generics_with(stmts, traits)
  let struct_sets = collect_struct_field_sets(stmts)
  let fn_returns = collect_fn_returns(stmts)
  let gimpl_types = collect_generic_impl_types(stmts)
  let gens = build_gens(stmts, traits, gimpl_types)
  // #839: see `collect_toplevel_anon_records` / the `rewrite_stmt` doc comment.
  let toplevel_vars = collect_toplevel_anon_records(stmts, struct_sets)
  // #1374: reset the exception-kind pass state. An already-declared cell means
  // an earlier run of this pass on this same program already wrapped every
  // throw, so the rewrite below stays off.
  Array::set(dtd_exn_kind_state, 0, if exn_kind_cell_present(stmts) {
    1
  } else {
    0
  })
  Array::set(dtd_exn_kind_state, 1, 0)
  Array::set(dtd_exn_kind_state, 2, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    Array::set(stmts, i, rewrite_stmt(Array::get(stmts, i), gens, traits, struct_sets, fn_returns, toplevel_vars))
    i = i + 1
  }
  // #1374: append the cell only for a program that actually reads or writes it,
  // so a throw-free program's output is unchanged.
  if Array::get(dtd_exn_kind_state, 1) == 1 {
    ensure_exn_kind_cell(stmts)
  } else {
    ()
  }
  // Witness dict structs are only needed when method-bearing traits exist.
  if Array::length(traits_raw) == 0 {
    ()
  } else {
    let mut ti = 0
    while ti < Array::length(traits) {
      let (trait_name, sigs) = Array::get(traits, ti)
      if struct_decl_exists(stmts, dict_struct_name(trait_name)) {
        ()
      } else {
        Array::push(stmts, make_dict_struct_stmt(trait_name, sigs))
      }
      ti = ti + 1
    }
  }
}
