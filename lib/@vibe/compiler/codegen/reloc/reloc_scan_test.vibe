//# Unit tests for the relocation scanner.
//#
//# These are SYNTHETIC bodies, on purpose: they pin one immediate shape each,
//# so an edit that breaks one shape names it. The complementary test is
//# `scripts/reloc_roundtrip.sh`, which runs the same scanner over whole real
//# modules and can therefore catch a shape nobody thought to write down here
//# -- that is how the 0xFB gc opcodes were found. Neither replaces the other:
//# synthetic cases localise a break, real modules find an omission.

//# Imports

import @vibe/compiler/codegen/reloc {
  body_relocs_count,
  rebuild_body_relocs,
  rebuild_body_relocs_with_slot_width,
  reloc_kind_blocktype,
  reloc_kind_data,
  reloc_kind_elem,
  reloc_kind_func,
  reloc_kind_global,
  reloc_kind_heaptype,
  reloc_kind_table,
  reloc_kind_tag,
  reloc_kind_type,
  scan_body_relocs
}

//# Functions

fn body_of(_ codes: Array[Int]) -> Bytes {
  let b = Bytes::new()
  let mut i = 0
  while i < Array::length(codes) {
    Bytes::push(b, value = Array::get(codes, at = i))
    i = i + 1
  }
  b
}

fn bytes_to_ints(_ b: Bytes) -> Array[Int] {
  let out = []
  let mut i = 0
  while i < Bytes::length(b) {
    Array::push(out, value = Bytes::get(b, at = i))
    i = i + 1
  }
  out
}

fn scan_all(_ codes: Array[Int]) -> (Array[Int], Array[Int], Array[Int], Array[Int]) with Exception {
  let b = body_of(codes)
  let r = scan_body_relocs(body = b, start = 0, end_pos = Bytes::length(b))
  (r.offsets, r.kinds, r.values, r.widths)
}

test "call is a func relocation, and identity rebuild is byte-exact" {
  // local.get 0 ; call 5 ; end
  let codes = [0x20, 0x00, 0x10, 0x05, 0x0B]
  let (offsets, kinds, values, widths) = scan_all(codes)
  assert_eq(Array::length(offsets), 1)
  assert_eq(Array::get(offsets, at = 0), 3)
  assert_eq(Array::get(kinds, at = 0), reloc_kind_func)
  assert_eq(Array::get(values, at = 0), 5)
  assert_eq(Array::get(widths, at = 0), 1)
  let b = body_of(codes)
  let r = scan_body_relocs(body = b, start = 0, end_pos = Bytes::length(b))
  let same = rebuild_body_relocs(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = r.values)
  assert_eq(bytes_to_ints(same), codes)
}

test "a relocation that crosses the LEB width band changes the body LENGTH" {
  // This is the property #2669 turns on. A callee moving from index 127 to
  // 128 grows its call immediate from one byte to two, so every calling body
  // gets LONGER -- measured on the real compiler as Rational::abs 135 -> 136
  // and make_rational 534 -> 536. A relocator that patched immediates in
  // place could not represent this; rebuilding spans does it for free.
  let codes = [0x10, 0x7F, 0x0B]
  let b = body_of(codes)
  let r = scan_body_relocs(body = b, start = 0, end_pos = Bytes::length(b))
  assert_eq(Array::get(r.values, at = 0), 127)
  assert_eq(Array::get(r.widths, at = 0), 1)
  let grown = rebuild_body_relocs(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = [
    128
  ])
  assert_eq(Bytes::length(grown), 4)
  assert_eq(bytes_to_ints(grown), [0x10, 0x80, 0x01, 0x0B])
  // and back down again, so the shrink direction is pinned too
  let r2 = scan_body_relocs(body = grown, start = 0, end_pos = Bytes::length(grown))
  assert_eq(Array::get(r2.widths, at = 0), 2)
  let shrunk = rebuild_body_relocs(body = grown, start = 0, end_pos = Bytes::length(grown), r = r2, new_values = [
    127
  ])
  assert_eq(bytes_to_ints(shrunk), codes)
}

test "global.get and call_indirect report their own kinds" {
  // global.get 1 ; call_indirect type=2 table=0 ; end
  //
  // THREE sites, not two: call_indirect's second immediate is a table index
  // and relocates as well. This case asserted two until that was recorded,
  // and failing was the right behaviour -- an expectation written against a
  // scanner that missed a reference class encodes the miss.
  let codes = [0x23, 0x01, 0x11, 0x02, 0x00, 0x0B]
  let (offsets, kinds, values, _widths) = scan_all(codes)
  assert_eq(Array::length(offsets), 3)
  assert_eq(Array::get(kinds, at = 0), reloc_kind_global)
  assert_eq(Array::get(values, at = 0), 1)
  assert_eq(Array::get(kinds, at = 1), reloc_kind_type)
  assert_eq(Array::get(values, at = 1), 2)
  assert_eq(Array::get(kinds, at = 2), reloc_kind_table)
  assert_eq(Array::get(values, at = 2), 0)
}

test "an i64.const is walked but never reported" {
  // The documented blind spot: a function VALUE and a data pointer both ride
  // an i64.const, and nothing in the encoding separates either from an
  // ordinary constant. The scanner must still SKIP it correctly -- a wrong
  // width here would desynchronise everything after it -- so the call that
  // follows has to be found at the right offset.
  //
  // i64.const 16254 (3 sleb bytes: fe fe 00) ; call 7 ; end
  let codes = [0x42, 0xFE, 0xFE, 0x00, 0x10, 0x07, 0x0B]
  let (offsets, kinds, values, _w) = scan_all(codes)
  assert_eq(Array::length(offsets), 1)
  assert_eq(Array::get(kinds, at = 0), reloc_kind_func)
  assert_eq(Array::get(values, at = 0), 7)
  assert_eq(Array::get(offsets, at = 0), 5)
}

test "memarg, br_table and block types are skipped at the right width" {
  // block (empty) ; br_table 2 [0,1] 0 ; i32.load align=2 off=8 ; drop ;
  // call 3 ; end ; end
  let codes = [
    0x02,
    0x40,
    0x0E,
    0x02,
    0x00,
    0x01,
    0x00,
    0x28,
    0x02,
    0x08,
    0x1A,
    0x10,
    0x03,
    0x0B,
    0x0B
  ]
  let (offsets, _k, values, _w) = scan_all(codes)
  assert_eq(Array::length(offsets), 1)
  assert_eq(Array::get(values, at = 0), 3)
  let b = body_of(codes)
  let r = scan_body_relocs(body = b, start = 0, end_pos = Bytes::length(b))
  assert_eq(bytes_to_ints(rebuild_body_relocs(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = r.values)), codes)
}

test "an unknown opcode is REFUSED, not guessed" {
  // 0x06 is not an instruction this decoder knows. Assuming a width for it
  // would desynchronise the walk and every later offset would be garbage that
  // still looked like a successful scan, which is why the contract is to
  // refuse. (@vibe/optimizer's decoder treats an unknown opcode as one byte;
  // that is right for an optimiser free to decline, wrong for an oracle.)
  let refused = handle {
    let _ = scan_all([0x06, 0x0B])
    false
  } with { Exception::Throw(_) => true }
  assert_true(refused)
}

test "a walk that would run past the end is REFUSED" {
  // `call` with a truncated immediate: the uleb runs into the end of the
  // body. Reporting a site here would invent a value.
  let refused = handle {
    let _ = scan_all([0x10, 0x80])
    false
  } with { Exception::Throw(_) => true }
  assert_true(refused)
}

test "exception tags are relocations, in both throw and try_table" {
  // Review found this, the oracle could not: an identity round-trip is
  // exactly what an UNRECORDED reference passes. Tag indices are sized by the
  // declared effects (`len(effect_names) + 4`), so adding an effect moves
  // them, and a rebuilt body holding a stale tag routes a perform to the
  // wrong handler with nothing failing at build time.
  //
  // throw 2 ; end
  let (o1, k1, v1, _w1) = scan_all([0x08, 0x02, 0x0B])
  assert_eq(Array::length(o1), 1)
  assert_eq(Array::get(k1, at = 0), reloc_kind_tag)
  assert_eq(Array::get(v1, at = 0), 2)
  // try_table (empty blocktype) [catch tag=3 label=0, catch_all label=1]
  //   call 9
  // end ; end
  let codes = [
    0x1F,
    0x40,
    0x02,
    0x00,
    0x03,
    0x00,
    0x02,
    0x01,
    0x10,
    0x09,
    0x0B,
    0x0B
  ]
  let (o2, k2, v2, _w2) = scan_all(codes)
  assert_eq(Array::length(o2), 2)
  // the catch clause's tag, then the call -- catch_all carries no tag
  assert_eq(Array::get(k2, at = 0), reloc_kind_tag)
  assert_eq(Array::get(v2, at = 0), 3)
  assert_eq(Array::get(k2, at = 1), reloc_kind_func)
  assert_eq(Array::get(v2, at = 1), 9)
  let b = body_of(codes)
  let r = scan_body_relocs(body = b, start = 0, end_pos = Bytes::length(b))
  assert_eq(bytes_to_ints(rebuild_body_relocs(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = r.values)), codes)
  // and the tag really is rewritable
  let moved = rebuild_body_relocs(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = [
    7,
    9
  ])
  assert_eq(Array::get(bytes_to_ints(moved), at = 4), 7)
}

test "a blocktype that is a TYPE INDEX relocates, and rebuilds SIGNED" {
  // `block`/`loop`/`if` take an s33: negative is a value type, non-negative is
  // an index into the type section. `emit_if_type_index` emits the latter and
  // the gc backend uses it for `gc_native_array_block_type_idx`.
  //
  // No module in scripts/reloc_roundtrip.sh's probe set contains one
  // (`blocktype=0` on all three), so this case is the ONLY coverage the kind
  // has. Same for reloc_kind_table. Said out loud because "it round-trips on
  // real modules" does not cover a construct those modules do not contain.
  // if (type 3) ; end ; end   -- a one-byte non-negative blocktype
  let codes = [0x04, 0x03, 0x0B, 0x0B]
  let (offsets, kinds, values, widths) = scan_all(codes)
  assert_eq(Array::length(offsets), 1)
  assert_eq(Array::get(kinds, at = 0), reloc_kind_blocktype)
  assert_eq(Array::get(values, at = 0), 3)
  assert_eq(Array::get(widths, at = 0), 1)
  // an EMPTY blocktype (-64, encoded 0x40) is a value type, not a relocation
  let (o2, _k2, _v2, _w2) = scan_all([0x02, 0x40, 0x0B, 0x0B])
  assert_eq(Array::length(o2), 0)
  let b = body_of(codes)
  let r = scan_body_relocs(body = b, start = 0, end_pos = Bytes::length(b))
  assert_eq(bytes_to_ints(rebuild_body_relocs(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = r.values)), codes)
  // THE SIGNED ENCODING IS THE POINT. Type index 64 is `0x40` as a uleb, but a
  // lone `0x40` sleb byte reads back as -64 -- an "empty" blocktype, i.e. a
  // different instruction. It has to grow to `0xC0 0x00`.
  let moved = rebuild_body_relocs(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = [
    64
  ])
  assert_eq(bytes_to_ints(moved), [0x04, 0xC0, 0x00, 0x0B, 0x0B])
  let r2 = scan_body_relocs(body = moved, start = 0, end_pos = Bytes::length(moved))
  assert_eq(Array::get(r2.values, at = 0), 64)
  assert_eq(Array::get(r2.kinds, at = 0), reloc_kind_blocktype)
}

test "call_indirect relocates BOTH immediates, and try_table's blocktype too" {
  // call_indirect type=2 table=1 ; end
  let (_o, k, v, _w) = scan_all([0x11, 0x02, 0x01, 0x0B])
  assert_eq(Array::length(k), 2)
  assert_eq(Array::get(k, at = 0), reloc_kind_type)
  assert_eq(Array::get(v, at = 0), 2)
  assert_eq(Array::get(k, at = 1), reloc_kind_table)
  assert_eq(Array::get(v, at = 1), 1)
  // try_table (type 5) [catch_all label=0] ; end ; end
  let (_o2, k2, v2, _w2) = scan_all([0x1F, 0x05, 0x01, 0x02, 0x00, 0x0B, 0x0B])
  assert_eq(Array::length(k2), 1)
  assert_eq(Array::get(k2, at = 0), reloc_kind_blocktype)
  assert_eq(Array::get(v2, at = 0), 5)
}

test "segment and heap-type indices relocate" {
  // 0xFC 8 = memory.init <dataidx> <memidx> ; 0xFC 13 = elem.drop <elemidx>
  let (_o, k, v, _w) = scan_all([0xFC, 0x08, 0x04, 0x00, 0xFC, 0x0D, 0x06, 0x0B])
  assert_eq(Array::length(k), 2)
  assert_eq(Array::get(k, at = 0), reloc_kind_data)
  assert_eq(Array::get(v, at = 0), 4)
  assert_eq(Array::get(k, at = 1), reloc_kind_elem)
  assert_eq(Array::get(v, at = 1), 6)
  // 0xFB 20 = ref.test <heaptype>. Non-negative is a TYPE INDEX; an abstract
  // heap type is negative and must NOT be reported.
  let (_o2, k2, v2, _w2) = scan_all([0xFB, 0x14, 0x09, 0x0B])
  assert_eq(Array::length(k2), 1)
  assert_eq(Array::get(k2, at = 0), reloc_kind_heaptype)
  assert_eq(Array::get(v2, at = 0), 9)
  // ref.null with the abstract `func` heap type (-16, sleb 0x70)
  let (o3, _k3, _v3, _w3) = scan_all([0xD0, 0x70, 0x0B])
  assert_eq(Array::length(o3), 0)
  // and a heap type rebuilds SIGNED, like a blocktype
  let codes = [0xFB, 0x14, 0x09, 0x0B]
  let b = body_of(codes)
  let r = scan_body_relocs(body = b, start = 0, end_pos = Bytes::length(b))
  assert_eq(bytes_to_ints(rebuild_body_relocs(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = [
    64
  ])), [0xFB, 0x14, 0xC0, 0x00, 0x0B])
}

test "#3941: a padded call slot keeps its length across the 127 -> 128 band" {
  // The same move as the test above, emitted at slot width 3: `call 127` is
  // `0x10 0xFF 0x80 0x00`. Rebuilt at width 3 the target becomes 128 without
  // the body growing, so nothing after the site moves.
  let codes = [0x10, 0xFF, 0x80, 0x00, 0x0B]
  let b = body_of(codes)
  let r = scan_body_relocs(body = b, start = 0, end_pos = Bytes::length(b))
  assert_eq(Array::get(r.values, at = 0), 127)
  assert_eq(Array::get(r.widths, at = 0), 3)
  let same = rebuild_body_relocs_with_slot_width(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = r.values, slot_width = 3)
  assert_eq(bytes_to_ints(same), codes)
  let to_128 = [128]
  let moved = rebuild_body_relocs_with_slot_width(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = to_128, slot_width = 3)
  assert_eq(bytes_to_ints(moved), [0x10, 0x80, 0x81, 0x00, 0x0B])
}

test "#3941: the width is a floor, not a cap, and minimal rebuild still shrinks" {
  // An index past the slot capacity (2^21 at width 3) still encodes, wider.
  let codes = [0x10, 0x85, 0x80, 0x00, 0x0B]
  let b = body_of(codes)
  let r = scan_body_relocs(body = b, start = 0, end_pos = Bytes::length(b))
  assert_eq(Array::get(r.values, at = 0), 5)
  let past_capacity = [2097152]
  let wide = rebuild_body_relocs_with_slot_width(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = past_capacity, slot_width = 3)
  assert_eq(bytes_to_ints(wide), [0x10, 0x80, 0x80, 0x80, 0x01, 0x0B])
  // Width 0 is the old rebuild: the padded slot is re-encoded minimally,
  // which is exactly why a padded module must be rebuilt with its width.
  let minimal = rebuild_body_relocs(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = r.values)
  assert_eq(bytes_to_ints(minimal), [0x10, 0x05, 0x0B])
}

test "#3941: function, tag, global and type indices are padded; a table index is not" {
  // global.get 5 ; call 5 ; throw 1 ; call_indirect (type 2) (table 0) ; end
  let codes = [0x23, 0x05, 0x10, 0x05, 0x08, 0x01, 0x11, 0x02, 0x00, 0x0B]
  let b = body_of(codes)
  let r = scan_body_relocs(body = b, start = 0, end_pos = Bytes::length(b))
  let padded = rebuild_body_relocs_with_slot_width(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = r.values, slot_width = 3)
  let global_get = [0x23, 0x85, 0x80, 0x00]
  let call = [0x10, 0x85, 0x80, 0x00]
  let throw_tag = [0x08, 0x81, 0x80, 0x00]
  let indirect = [0x11, 0x82, 0x80, 0x00, 0x00, 0x0B]
  let want = Array::concat(Array::concat(global_get, call), Array::concat(throw_tag, indirect))
  assert_eq(bytes_to_ints(padded), want)
}

test "#3941: a type-index blocktype is padded; a value-type blocktype and a heap type are not" {
  // if (type 13) end ; if (result i64) end ; ref.null 13 ; drop ; end.
  // Only `emit_if_type_index` pads, so only the first site grows.
  let codes = [0x04, 0x0D, 0x0B, 0x04, 0x7E, 0x0B, 0xD0, 0x0D, 0x1A, 0x0B]
  let b = body_of(codes)
  let r = scan_body_relocs(body = b, start = 0, end_pos = Bytes::length(b))
  assert_eq(body_relocs_count(r), 2)
  assert_eq(Array::get(r.kinds, at = 0), reloc_kind_blocktype)
  assert_eq(Array::get(r.kinds, at = 1), reloc_kind_heaptype)
  let padded = rebuild_body_relocs_with_slot_width(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = r.values, slot_width = 3)
  assert_eq(bytes_to_ints(padded), [
    0x04,
    0x8D,
    0x80,
    0x00,
    0x0B,
    0x04,
    0x7E,
    0x0B,
    0xD0,
    0x0D,
    0x1A,
    0x0B
  ])
}

test "#3941: a padded blocktype reads back and keeps its sign bit clear at 64" {
  // `0x04 0x8D 0x80 0x00` is `if (type 13)` at width 3. Moved to 64 it stays
  // three bytes; minimal sleb would need two (`0xC0 0x00`), because a lone
  // `0x40` reads as -64, the empty blocktype.
  let codes = [0x04, 0x8D, 0x80, 0x00, 0x0B, 0x0B]
  let b = body_of(codes)
  let r = scan_body_relocs(body = b, start = 0, end_pos = Bytes::length(b))
  assert_eq(Array::get(r.values, at = 0), 13)
  assert_eq(Array::get(r.widths, at = 0), 3)
  let same = rebuild_body_relocs_with_slot_width(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = r.values, slot_width = 3)
  assert_eq(bytes_to_ints(same), codes)
  let moved = rebuild_body_relocs_with_slot_width(body = b, start = 0, end_pos = Bytes::length(b), r = r, new_values = [
    64
  ], slot_width = 3)
  assert_eq(bytes_to_ints(moved), [0x04, 0xC0, 0x80, 0x00, 0x0B, 0x0B])
}

fn refusal(_ codes: Array[Int]) -> String {
  handle {
    let _ = scan_all(codes)
    "-"
  } with { Exception::Throw(msg) => msg }
}

test "a skipped immediate advances past every byte of it" {
  // #3938: a skipped immediate is walked without reading its value.
  // i64.const -1000000 (3 bytes) ; local.get 200 (2 bytes) ;
  // i32.load align=2 off=300 (1 + 2 bytes) ; drop ; call 7 ; end
  let codes = [
    0x42,
    0xC0,
    0xFB,
    0x42,
    0x20,
    0xC8,
    0x01,
    0x28,
    0x02,
    0xAC,
    0x02,
    0x1A,
    0x10,
    0x07,
    0x0B
  ]
  let (offsets, _k, values, _w) = scan_all(codes)
  assert_eq(offsets, [13])
  assert_eq(values, [7])
}

test "a skipped immediate is refused as the read one is" {
  inspect(refusal([0x20, 0x80]), content = "reloc_scan: uleb128 runs past the end of the body")
  inspect(refusal([0x42, 0xFF]), content = "reloc_scan: sleb128 runs past the end of the body")
  inspect(refusal([0x28, 0x02, 0x80]), content = "reloc_scan: uleb128 runs past the end of the body")
  inspect(refusal([
    0x20,
    0x80,
    0x80,
    0x80,
    0x80,
    0x80,
    0x80,
    0x80,
    0x80,
    0x80,
    0x01
  ]), content = "reloc_scan: uleb128 wider than a 63-bit Int")
  inspect(refusal([
    0x42,
    0x80,
    0x80,
    0x80,
    0x80,
    0x80,
    0x80,
    0x80,
    0x80,
    0x80,
    0x01
  ]), content = "reloc_scan: sleb128 wider than a 63-bit Int")
}
