//# Imports

import .. / core {
  Expr, Pat, Stmt, TypeExpr
}

//# Functions

// #767: String::replace(s, old, new) -> String, synthesized as ordinary AST
// (same technique as double_to_string_expr / int_parse_expr) so it lowers
// through each backend's normal `ce`/String::index_of/String::substring/
// String::concat codegen instead of needing new raw-wasm string-scanning
// logic. Replaces only the first occurrence (matching the documented
// behavior in docs/cheatsheet.md's "Key Builtins" list); returns `s`
// unchanged when `old` doesn't occur.
export let string_replace_expr: (Expr, Expr, Expr) -> Expr = (s_arg, old_arg, new_arg) -> {
  let c1: (String, Expr) -> Expr = (f, a0) -> {
    ECall(EIdent(f, -1), [
      a0
    ], -1)
  }
  let c2: (String, Expr, Expr) -> Expr = (f, a0, a1) -> {
    ECall(EIdent(f, -1), [
      a0,
      a1
    ], -1)
  }
  let c3: (String, Expr, Expr, Expr) -> Expr = (f, a0, a1, a2) -> {
    ECall(EIdent(f, -1), [
      a0,
      a1,
      a2
    ], -1)
  }
  let s = EIdent("__sr_s", -1)
  let old = EIdent("__sr_old", -1)
  let new_ = EIdent("__sr_new", -1)
  let idx = EIdent("__sr_idx", -1)
  let head = c3("String::substring", s, EInt(0), idx)
  let tail = c3("String::substring", s, EBinOp("+", idx, c1("String::length", old)), c1("String::length", s))
  let replaced = c2("String::concat", head, c2("String::concat", new_, tail))
  ELet("__sr_s", s_arg, ELet("__sr_old", old_arg, ELet("__sr_new", new_arg, ELet("__sr_idx", c2("String::index_of", s, old), EIf(EBinOp("<", idx, EInt(0)), s, replaced)))))
}
