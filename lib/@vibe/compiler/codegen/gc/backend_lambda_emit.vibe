//# Imports

import @vibe/compiler/core {
  bytebuf_new
}

import @vibe/compiler/codegen/common_analysis {
  emit_i64_extend_i32_u
}

import @vibe/compiler/codegen/common_base {
  emit_i64_store, resolve_local
}

import @vibe/compiler/codegen/wasm_emit {
  emit_global_get,
  emit_global_set,
  emit_heap_memory_grow_check,
  emit_i32_add,
  emit_i32_const,
  emit_i32_store,
  emit_i32_wrap_i64,
  emit_i64_const,
  emit_i64_or,
  emit_local_get,
  emit_local_tee
}

//# Functions

fn emit_lambda_closure_gc(buf: Bytes, captures: Array[String], num_captures: Int, local_names: Array[String], next_local: Int, table_slot: Int) -> Int with Exception {
  if num_captures == 0 {
    emit_i64_const(buf, (table_slot<<2)|2)
    next_local
  } else {
    let alloc_size = 8 + num_captures * 8
    let ptr_local = next_local
    let nl2 = next_local + 1
    Array::push(local_names, "[gc-temp]__closure_ptr")
    emit_global_get(buf, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_tee(buf, ptr_local)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, alloc_size)
    emit_i32_add(buf)
    emit_global_set(buf, 0)
    // #415: gc-lane heap bump must grow linear memory like the linear
    // backend does -- without this any allocation past the initial page
    // traps OOB (the gc smoke fixture only ever allocated a few bytes).
    emit_heap_memory_grow_check(buf)
    emit_local_get(buf, ptr_local)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, table_slot)
    emit_i32_store(buf, 2, 0)
    emit_local_get(buf, ptr_local)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, num_captures)
    emit_i32_store(buf, 2, 4)
    let mut csi = 0
    while csi < num_captures {
      let cap_name = Array::get(captures, csi)
      let cap_idx = resolve_local(local_names, cap_name, "gc_cap")
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, cap_idx)
      emit_i64_store(buf, 3, 8 + csi * 8)
      csi = csi + 1
    }
    emit_local_get(buf, ptr_local)
    emit_i64_const(buf, 1)
    emit_i64_or(buf)
    nl2
  }
}

//# Misc

export {
  emit_lambda_closure_gc
}
