/// #1976: the names this file IMPORTS, as they are spelled here (the alias when
/// there is one). Collected from the statement list rather than tracked through
/// the pipeline: this is only read on the failure path.
fn gc_imported_spellings(stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(_, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let item = Array::get(items, j)
          let orig = item.name
          let alias_opt = item.alias
          match alias_opt {
            Some(alias) => Array::push(out, alias),
            None => Array::push(out, orig)
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// #1976: the codegen "unresolved name" internal error tells the reader that
/// the compiler is at fault and asks them to report it. For ONE shape that is
/// false and misleading: direct source compilation deliberately analyzes one
/// file, so a name the file imported was never going to reach codegen. That is
/// the direct mode's behaviour, not a bug. The filesystem compile path resolves
/// imports before selecting this backend (#2376), so it never reaches this
/// diagnostic for a valid import.
///
/// The rewrite is deliberately narrow. It fires only when the message is the
/// unresolved-name error AND the name in it is one this file imports; anything
/// else passes through untouched, because the genuine class this message exists
/// for (#1502 / #1510 / #1491 / #1521 / #1529) is worth keeping visible.
///
/// Measured before writing this: an UNUSED import compiles fine here, and an
/// imported struct or enum fails in the checker with its own (already clear)
/// message. Only an imported function reaches this diagnostic.
///
/// The remediation keeps the GC backend selected and asks for filesystem
/// loading. Dropping the backend would hide a parity problem instead of
/// compiling the requested program on the requested backend.
fn gc_unresolved_import_message(err: String, stmts: Array[Stmt]) -> Option[String] {
  if !String::starts_with(err, codegen_unresolved_name_prefix()) {
    None
  } else {
    let names = gc_imported_spellings(stmts)
    let mut i = 0
    let mut hit = ""
    while i < Array::length(names) {
      let n = Array::get(names, i)
      if String::length(hit) == 0 && String::contains(err, String::concat("`", String::concat(n, "` (local, @gc"))) {
        hit = n
      }
      i = i + 1
    }
    if String::length(hit) == 0 {
      None
    } else {
      Some(String::concat("`", String::concat(hit, "` is imported, but this wasm-gc invocation is direct single-file mode, so the imported name cannot be reached.\n  Resolve the filesystem module graph before GC codegen: use `VIBE_TEST_BACKEND=gc vibe test` or set VIBE_FS_COMPILE=1 together with VIBE_BACKEND=gc.\n  (Direct single-file mode remains available for isolated sources; an unused import is fine.)")))
    }
  }
}

export fn gc_float_returning_names_pre_erasure(stmts: Array[Stmt]) -> Array[String] {
  compute_float_returning_names(stmts)
}

/// #3144 round 4: `rename_builtin_shadow_defs` for the gc source driver
/// (`entry/source_compile/gc_only`), which keeps out of `@vibe/compiler/core`
/// and reaches the rename through this package. The driver runs it before the
/// pre-erasure name tables above, so every table and the codegen that reads
/// them spell a program's own `Array::length` the same way.
export fn gc_rename_builtin_shadow_defs(stmts: Array[Stmt]) -> Unit {
  rename_builtin_shadow_defs(stmts)
}

/// #3126 review: the gc source driver compiles ONE source, so no file's
/// offsets are recorded; clear what a previous FS compile in this process
/// left, or a division-by-zero site would be placed in that program's file.
export fn gc_merged_offset_space_reset() -> Unit {
  merged_offset_space_reset()
}

/// Top-level function declaration identities before lambda hoisting.
export fn gc_top_level_function_names(stmts: Array[Stmt]) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, EFn(_, _, _, _, _, _)) => Array::push(out, name),
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Add only declarations synthesized by lambda hoisting. The before-set is
/// the provenance boundary: spelling is not authority because users may
/// legally declare names beginning with `__hoisted_lam_`.
export fn gc_add_hoisted_float_returning_names(stmts: Array[Stmt], before_names: Array[String], names: Array[String]) -> Unit {
  let post_desugar = compute_float_returning_names(stmts)
  let mut i = 0
  while i < Array::length(post_desugar) {
    let name = Array::get(post_desugar, i)
    if !array_contains_str(before_names, name) && !array_contains_str(names, name) {
      Array::push(names, name)
    }
    i = i + 1
  }
}

export fn compile_wasi_module_gc(stmts: Array[Stmt], entry_name: String, generated_test_artifact: Bool, gc_to_string_is_wrapper: Bool, direct_abi_generic_names: Array[String], gc_float_ret_fn_names: Array[String], gc_float_call_offsets: Array[Int], gc_int_render_offsets: Array[Int], gc_bool_render_offsets: Array[Int]) -> Bytes with Exception {
  handle {
    compile_wasi_module_gc_impl(stmts, entry_name, generated_test_artifact, gc_to_string_is_wrapper, direct_abi_generic_names, gc_float_ret_fn_names, gc_float_call_offsets, gc_int_render_offsets, gc_bool_render_offsets)
  } with { Exception::Throw(err) => match gc_unresolved_import_message(err, stmts) {
    Some(better) => throw(better),
    None => throw(err)
  } }
}
