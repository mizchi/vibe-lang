//# Functions

/// #538: call a func-table-RESOLVED index. User functions (>= func_offset)
/// take a trailing closure-env i64 (callers pass 0); builtins/imports do not.
/// The flat bundle defines its own __to_string / String::join / eq etc., so a
/// resolve_func hit is NOT guaranteed to be a builtin -- every resolved call
/// must go through here or a user-shadowed builtin miscompiles with a missing
/// env argument (invalid wasm, "expected i64 but nothing on stack").
export fn emit_call_resolved(buf: Bytes, ctx: CompileCtxGc, fidx: Int) -> Unit {
  if ctx.func_offset > 0 && fidx >= ctx.func_offset {
    emit_i64_const(buf = buf, value = 0)
  } else {
    ()
  }
  emit_call(buf = buf, func_idx = fidx)
}

/// #538 P4.5: resolve to the BUILTIN entry even when the compiled program
/// defines a top-level function of the same name (the compiler bundle has its
/// own `__to_string(Int)`). Builtins are appended AFTER user functions in the
/// func table, so the LAST match is the builtin. Interpolation's `__to_string`
/// must always hit the runtime string-vs-int dispatch body — routing it to the
/// program's decimal-only version rendered interpolated Strings as numbers.
export fn gc_resolve_builtin_last(ft: FuncTable, name: String) -> Int {
  let mut i = Array::length(ft.names) - 1
  let mut found = -1
  while i >= 0 {
    if found < 0 && Array::get(ft.names, at = i) == name {
      found = Array::get(ft.indices, at = i)
      i = -1
    } else {
      i = i - 1
    }
  }
  found
}

/// #3626: the gc lane's refutable-`let` trap, as on linear: print the line
/// the pool seeded for this `__let_refuted` call, then trap with nothing
/// pushed after it, so the arm types as the continuation's value. A pool
/// without the line keeps the bare trap.
fn gc_let_refuted_trap(buf: Bytes, args: Array[Expr], ctx: CompileCtxGc) -> Unit {
  let msg_fat = str_table_fat_or_zero(st = ctx.str_table, s = let_refuted_message(args))
  let nl_fat = str_table_fat_or_zero(st = ctx.str_table, s = "\n")
  let ps_idx = gc_resolve_builtin_last(ft = ctx.func_table, name = "print_str")
  if msg_fat != 0 && nl_fat != 0 && ps_idx >= 0 {
    emit_i64_const(buf = buf, value = msg_fat)
    emit_call_resolved(buf = buf, ctx = ctx, fidx = ps_idx)
    emit_i64_const(buf = buf, value = nl_fat)
    emit_call_resolved(buf = buf, ctx = ctx, fidx = ps_idx)
  } else {
    ()
  }
  bytebuf_push(buf = buf, byte = 0)
}

/// #3547: the gc lane's `Map::get` / `m[k]` miss trap. It prints the pooled
/// message through `print_str` first, as `abort(msg)` does on this lane and
/// `cc_map_get_miss_trap` does on linear. A pool without the message keeps the
/// bare trap rather than failing the build.
fn gc_map_get_miss_trap(buf: Bytes, ctx: CompileCtxGc) -> Unit {
  let msg_fat = str_table_fat_or_zero(st = ctx.str_table, s = map_get_miss_message())
  let ps_idx = gc_resolve_builtin_last(ft = ctx.func_table, name = "print_str")
  if msg_fat != 0 && ps_idx >= 0 {
    emit_i64_const(buf = buf, value = msg_fat)
    emit_call_resolved(buf = buf, ctx = ctx, fidx = ps_idx)
  } else {
    ()
  }
  bytebuf_push(buf = buf, byte = 0)
}

/// #2334: compare the stored key (below) with the probe key (on top), leaving
/// a 0/1 i64. A String-keyed operation calls the content-aware `eq` at
/// `eq_fi`; a scalar-keyed one compares the two keys as exact i64 values --
/// an `Int`, `Char` or `Bool` is an untagged i64 on this lane, and `eq`'s
/// String guard would read two Ints that look like packed String refs as
/// bytes in memory.
fn gc_map_emit_key_eq(buf: Bytes, ctx: CompileCtxGc, scalar: Bool, eq_fi: Int) -> Unit {
  if scalar {
    emit_i64_eq(buf)
    emit_i64_extend_i32_u(buf)
  } else {
    emit_call_resolved(buf = buf, ctx = ctx, fidx = eq_fi)
  }
}

/// #2334: the i32 at +4 of a gc Map block (the literal's capacity, read by no
/// operation) holds this marker on a scalar-keyed map, as the index slot does
/// on the linear lane. Every producer writes +4 -- a literal its capacity (32
/// or more), `freeze` / `set` / `delete` 0 or this marker -- so a String-keyed
/// map never holds it, even in a reused region block.
let gc_map_scalar_marker: Int = 1

/// #2334: trap when the map at `map_l` is scalar-keyed. Every String-keyed
/// operation runs this first: a call the checker filed no scalar row for
/// would otherwise compare an `Int` key through the String-aware `eq`.
fn gc_map_trap_if_scalar(buf: Bytes, map_l: Int) -> Unit {
  emit_local_get(buf = buf, idx = map_l)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf = buf, align = 2, offset = 4)
  emit_i32_const(buf = buf, value = gc_map_scalar_marker)
  emit_i32_eq(buf)
  emit_if_void(buf)
  bytebuf_push(buf = buf, byte = 0)
  emit_end(buf)
}

/// #2334: a MapBuilder handle ([count i32 @0][cap i32 @4][storage @8], the
/// linear lane's layout) is marked scalar-keyed by this bit of its capacity
/// word, which no capacity reaches.
let gc_mapbuilder_scalar_cap_marker: Int = 1073741824

/// #2334: trap when the builder at `mb_l` is scalar-keyed; every String-keyed
/// builder operation runs this first.
fn gc_mapbuilder_trap_if_scalar(buf: Bytes, mb_l: Int) -> Unit {
  emit_local_get(buf = buf, idx = mb_l)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf = buf, align = 2, offset = 4)
  emit_i32_const(buf = buf, value = gc_mapbuilder_scalar_cap_marker)
  emit_i32_and(buf)
  emit_if_void(buf)
  bytebuf_push(buf = buf, byte = 0)
  emit_end(buf)
}

/// #2334: mark the builder at `mb_l` scalar-keyed and strip the mark from the
/// capacity word loaded into `cap_l`.
fn gc_mapbuilder_mark_scalar_cap(buf: Bytes, mb_l: Int, cap_l: Int) -> Unit {
  emit_local_get(buf = buf, idx = mb_l)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf = buf, idx = cap_l)
  emit_i64_const(buf = buf, value = gc_mapbuilder_scalar_cap_marker)
  emit_i64_or(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_store(buf = buf, align = 2, offset = 4)
  emit_local_get(buf = buf, idx = cap_l)
  emit_i64_const(buf = buf, value = gc_mapbuilder_scalar_cap_marker - 1)
  emit_i64_and(buf)
  emit_local_set(buf = buf, idx = cap_l)
}

/// #2334: write the key class of the fresh map block at `map_l`: the scalar
/// marker for a scalar-keyed result, 0 otherwise.
fn gc_map_write_key_class(buf: Bytes, map_l: Int, scalar: Bool) -> Unit {
  emit_local_get(buf = buf, idx = map_l)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = if scalar {
    gc_map_scalar_marker
  } else {
    0
  })
  emit_i32_store(buf = buf, align = 2, offset = 4)
}

/// #4121: push the i32 test "is the map at `map_l` scalar-keyed?". An
/// unmarked map -- every String map, and an empty `Map::new()` -- answers 0.
fn gc_map_emit_is_scalar(buf: Bytes, map_l: Int) -> Unit {
  emit_local_get(buf = buf, idx = map_l)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf = buf, align = 2, offset = 4)
  emit_i32_const(buf = buf, value = gc_map_scalar_marker)
  emit_i32_eq(buf)
}

/// The body of `Map::delete` once its operands are in the six locals from
/// `nl`: copy every entry whose key does not match into a fresh block and
/// write the result's key class. Leaves the result at `nl + 3`.
fn gc_map_delete_body(buf: Bytes, ctx: CompileCtxGc, nl: Int, scalar_key: Bool, eq_fi_md: Int) -> Unit {
  let md_m = nl
  let md_k = nl + 1
  let md_cnt = nl + 2
  let md_new = nl + 3
  let md_i = nl + 4
  let md_out = nl + 5
  emit_local_get(buf = buf, idx = md_m)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf = buf, align = 2, offset = 0)
  emit_i64_extend_i32_u(buf)
  emit_local_set(buf = buf, idx = md_cnt)
  emit_global_get(buf = buf, idx = 0)
  emit_i64_extend_i32_u(buf)
  emit_local_set(buf = buf, idx = md_new)
  emit_global_get(buf = buf, idx = 0)
  emit_local_get(buf = buf, idx = md_cnt)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = 16)
  emit_i32_mul(buf)
  emit_i32_const(buf = buf, value = 8)
  emit_i32_add(buf)
  emit_i32_add(buf)
  emit_global_set(buf = buf, idx = 0)
  emit_heap_memory_grow_check(buf)
  emit_i64_const(buf = buf, value = 0)
  emit_local_set(buf = buf, idx = md_i)
  emit_i64_const(buf = buf, value = 0)
  emit_local_set(buf = buf, idx = md_out)
  emit_block_void(buf)
  emit_loop_void(buf)
  emit_local_get(buf = buf, idx = md_i)
  emit_local_get(buf = buf, idx = md_cnt)
  emit_i64_ge_s(buf)
  emit_br_if(buf = buf, label = 1)
  emit_local_get(buf = buf, idx = md_m)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf = buf, idx = md_i)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = 16)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_i64_load(buf = buf, align = 3, offset = 8)
  emit_local_get(buf = buf, idx = md_k)
  gc_map_emit_key_eq(buf = buf, ctx = ctx, scalar = scalar_key, eq_fi = eq_fi_md)
  emit_i32_wrap_i64(buf)
  emit_if_void(buf)
  emit_else(buf)
  emit_local_get(buf = buf, idx = md_new)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf = buf, idx = md_out)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = 16)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_local_get(buf = buf, idx = md_m)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf = buf, idx = md_i)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = 16)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_i64_load(buf = buf, align = 3, offset = 8)
  emit_i64_store(buf = buf, align = 3, offset = 8)
  emit_local_get(buf = buf, idx = md_new)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf = buf, idx = md_out)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = 16)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_local_get(buf = buf, idx = md_m)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf = buf, idx = md_i)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = 16)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_i64_load(buf = buf, align = 3, offset = 16)
  emit_i64_store(buf = buf, align = 3, offset = 16)
  emit_local_get(buf = buf, idx = md_out)
  emit_i64_const(buf = buf, value = 1)
  emit_i64_add(buf)
  emit_local_set(buf = buf, idx = md_out)
  emit_end(buf)
  emit_local_get(buf = buf, idx = md_i)
  emit_i64_const(buf = buf, value = 1)
  emit_i64_add(buf)
  emit_local_set(buf = buf, idx = md_i)
  emit_br(buf = buf, label = 0)
  emit_end(buf)
  emit_end(buf)
  emit_local_get(buf = buf, idx = md_new)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf = buf, idx = md_out)
  emit_i32_wrap_i64(buf)
  emit_i32_store(buf = buf, align = 2, offset = 0)
  gc_map_write_key_class(buf = buf, map_l = md_new, scalar = scalar_key)
}

/// The body of `Map::get` once its operands are in the four locals from `nl`:
/// a linear scan whose miss traps. Leaves the value as one i64.
fn gc_map_get_body(buf: Bytes, ctx: CompileCtxGc, nl: Int, scalar_key: Bool, eq_fi: Int) -> Unit {
  let map_l = nl
  let key_l = nl + 1
  let cnt_l = nl + 2
  let idx_l = nl + 3
  // Load count
  emit_local_get(buf = buf, idx = map_l)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf = buf, align = 2, offset = 0)
  emit_i64_extend_i32_u(buf)
  emit_local_set(buf = buf, idx = cnt_l)
  emit_i64_const(buf = buf, value = 0)
  emit_local_set(buf = buf, idx = idx_l)
  // block $result : i64
  emit_block_i64(buf)
  emit_block_void(buf)
  emit_loop_void(buf)
  // if i >= count: break
  emit_local_get(buf = buf, idx = idx_l)
  emit_local_get(buf = buf, idx = cnt_l)
  emit_i64_ge_s(buf)
  emit_br_if(buf = buf, label = 1)
  // Load key at entry[i]
  emit_local_get(buf = buf, idx = map_l)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf = buf, idx = idx_l)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = 16)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_i64_load(buf = buf, align = 3, offset = 8)
  emit_local_get(buf = buf, idx = key_l)
  gc_map_emit_key_eq(buf = buf, ctx = ctx, scalar = scalar_key, eq_fi = eq_fi)
  emit_i32_wrap_i64(buf)
  emit_if_void(buf)
  // Found: load value and break
  emit_local_get(buf = buf, idx = map_l)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf = buf, idx = idx_l)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = 16)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_i64_load(buf = buf, align = 3, offset = 16)
  emit_br(buf = buf, label = 3)
  emit_end(buf)
  // i++
  emit_local_get(buf = buf, idx = idx_l)
  emit_i64_const(buf = buf, value = 1)
  emit_i64_add(buf)
  emit_local_set(buf = buf, idx = idx_l)
  emit_br(buf = buf, label = 0)
  emit_end(buf)
  emit_end(buf)
  // #2990: not found traps, as on the linear lane (see
  // `cc_map_get_linear_scan`). `Map::has_key` is the guard.
  gc_map_get_miss_trap(buf = buf, ctx = ctx)
  emit_end(buf)
}

/// The body of `Map::has_key`, laid out like `gc_map_get_body`. Leaves a
/// raw 0/1 i64.
fn gc_map_has_body(buf: Bytes, ctx: CompileCtxGc, nl: Int, scalar_key: Bool, eq_fi: Int) -> Unit {
  let map_l = nl
  let key_l = nl + 1
  let cnt_l = nl + 2
  let idx_l = nl + 3
  emit_local_get(buf = buf, idx = map_l)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf = buf, align = 2, offset = 0)
  emit_i64_extend_i32_u(buf)
  emit_local_set(buf = buf, idx = cnt_l)
  emit_i64_const(buf = buf, value = 0)
  emit_local_set(buf = buf, idx = idx_l)
  emit_block_i64(buf)
  emit_block_void(buf)
  emit_loop_void(buf)
  emit_local_get(buf = buf, idx = idx_l)
  emit_local_get(buf = buf, idx = cnt_l)
  emit_i64_ge_s(buf)
  emit_br_if(buf = buf, label = 1)
  emit_local_get(buf = buf, idx = map_l)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf = buf, idx = idx_l)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = 16)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_i64_load(buf = buf, align = 3, offset = 8)
  emit_local_get(buf = buf, idx = key_l)
  gc_map_emit_key_eq(buf = buf, ctx = ctx, scalar = scalar_key, eq_fi = eq_fi)
  emit_i32_wrap_i64(buf)
  emit_if_void(buf)
  emit_i64_const(buf = buf, value = 1)
  emit_br(buf = buf, label = 3)
  emit_end(buf)
  emit_local_get(buf = buf, idx = idx_l)
  emit_i64_const(buf = buf, value = 1)
  emit_i64_add(buf)
  emit_local_set(buf = buf, idx = idx_l)
  emit_br(buf = buf, label = 0)
  emit_end(buf)
  emit_end(buf)
  emit_i64_const(buf = buf, value = 0)
  emit_end(buf)
}

/// #3068: gc mirror of the linear lane's `ts_offset_refuses_render`
/// (compile_call.vibe). The checker filed this render argument as a shape the
/// runtime renderer cannot print (#2987, tag 6, folded into the Int channel
/// under `typed_render_refuse_key`). The linear lane refused the build while
/// this lane had no such arm and sent the argument to the runtime-dispatching
/// `__to_string`, which printed its allocation address.
export fn bc_offset_refuses_render(e: Expr, ctx: CompileCtxGc) -> Bool {
  let off = typed_lowering_arg_offset(e)
  off >= 0 && array_contains_int(arr = ctx.gc_int_render_offsets, v = typed_render_refuse_key(off))
}

/// #2407: the scalar test the `eq(a, b)` builtin routes on, so it answers like
/// `a == b`: `emit_gc_eq_value` sends an intish pair to a raw `i64.eq`, and
/// this arm does too. Unlike `gc_expr_is_intish` (backend_expr.vibe), which
/// claims `+ - * /` from the operator alone, it recurses into the operands.
export fn bc_expr_is_intish(e: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {
  if gc_offset_says_int(e = e, ctx = ctx) {
    true
  } else {
    match e {
      EInt(_) => true,
      EBool(_) => true,
      // Int-only by the checker's own rule (`operands must be Int`), whatever
      // the operands are.
      EBinOp(op, l, r, _) => if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" || op == "%" {
        true
      } else if op == "<" || op == ">" || op == "<=" || op == ">=" || op == "==" || op == "!=" || op == "&&" || op == "||" {
        // Bool, which shares this lane's Int representation.
        true
      } else if op == "+" || op == "-" || op == "*" || op == "/" {
        // POLYMORPHIC: the checker resolves these from the operands (Int, then
        // Double, then String for `+`, then a user impl), so the operator alone
        // says nothing. Recursing is both safer and sharper than the linear
        // lane's blanket exclusion (`cc_arg_is_scalarish`): `b61 + b61` over
        // two int-bound locals still answers Int, while `1.5 + 2.5` answers
        // false at the EFloat leaf and a String `+` answers false at EString.
        //
        // Answering `true` unconditionally, as this arm did when it was copied
        // from `gc_expr_is_intish`, would send a Double pair to a raw `i64.eq`
        // (bit equality, so -0.0 != 0.0) and a packed string pointer through
        // the integer renderer. No String `+` reaches codegen today --
        // `desugar_trait_dicts` rewrites every one measured, literals,
        // parameters, projections, call results and match bindings alike, into
        // `String::concat` -- but a predicate that is only correct because
        // another pass happens to run first is a proxy, not a guarantee.
        bc_expr_is_intish(e = l, local_names = local_names, ctx = ctx) && bc_expr_is_intish(e = r, local_names = local_names, ctx = ctx)
      } else {
        false
      },
      // `!` and `~` are Int/Bool whatever they wrap. `-` is NOT: it carries the
      // operand's type, exactly as `+ - * /` do above, so it recurses
      // -- `gc_expr_is_floatish` already recursed for `-` and this arm did not,
      // and that asymmetry is the bug: `eq(-(64 << 32), -(65 << 32))` answered
      // false here, fell through to `String::equals`, and read two negative
      // integers as packed (ptr, len) pairs. Measured, gc lane: it traps, while
      // the same values without the negation are fine and the same negation over
      // small values is fine (the invented address happens to land in bounds).
      // No `+` arm: unary `+` is not vibe syntax -- `+(64 << 32)` is
      // `unexpected token: +`, measured -- so one would be dead code.
      EUnaryOp(op, x) => if op == "!" || op == "~" {
        true
      } else if op == "-" {
        bc_expr_is_intish(e = x, local_names = local_names, ctx = ctx)
      } else {
        false
      },
      // #2405: a bare ident has no shape to read, so it is answered from the
      // slot log `gc_compile_let_i64` writes -- resolved through the CURRENT
      // slot (find_local_slot) first, exactly as `gc_expr_is_floatish`
      // does, so a name rebound in a sibling scope is not read through its
      // stale entry.
      EIdent(iname, _) => {
        let slot = find_local_slot(names = local_names, name = iname)
        slot >= 0 && array_contains_int(arr = ctx.gc_int_locals, v = slot)
      },
      _ => false
    }
  }
}

export fn gc_native_array_receiver_slot(args: Array[Expr], local_names: Array[String], ctx: CompileCtxGc) -> Int {
  if Array::length(args) == 0 {
    -1
  } else {
    match Array::get(args, at = 0) {
      EIdent(name, _) => {
        let slot = find_local_slot(names = local_names, name = name)
        if slot >= 0 && array_contains_int(arr = ctx.gc_native_array_locals, v = slot) {
          slot
        } else {
          -1
        }
      },
      _ => -1
    }
  }
}

export fn gc_direct_abi_call_index(ctx: CompileCtxGc, name: String) -> Int {
  let exact = gc_direct_abi_call_index_exact(ctx = ctx, name = name)
  if exact >= 0 {
    exact
  } else {
    gc_direct_abi_call_index_exact(ctx = ctx, name = String::concat(name, "$ref"))
  }
}

fn gc_direct_abi_call_index_exact(ctx: CompileCtxGc, name: String) -> Int {
  let mut i = 0
  let mut found = -1
  while i < Array::length(ctx.gc_direct_abi_names) {
    if found < 0 && Array::get(ctx.gc_direct_abi_names, at = i) == name {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

export fn gc_direct_abi_twin_callee(ctx: CompileCtxGc, fname: String) -> String {
  if gc_direct_abi_call_index_exact(ctx = ctx, name = fname) >= 0 {
    fname
  } else {
    let twin = String::concat(fname, "$ref")
    if gc_direct_abi_call_index_exact(ctx = ctx, name = twin) >= 0 {
      twin
    } else {
      fname
    }
  }
}

export fn gc_expr_is_native_array_ref(expr: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {
  match expr {
    EIdent(name, _) => {
      let slot = find_local_slot(names = local_names, name = name)
      slot >= 0 && array_contains_int(arr = ctx.gc_native_array_locals, v = slot)
    },
    EArray(_) => true,
    // #1542: reading a reference-lane FIELD yields a reference, so it inhabits
    // the lane exactly as a native local does.
    EDot(EIdent(ns_obj, _), ns_field, _, _) => gc_ctor_field_is_ref(ct = ctx.gc_ctor_table, struct_idx = gc_slot_map_get(map = ctx.gc_native_struct_scope, slot = find_local_slot(names = local_names, name = ns_obj)), field = ns_field),
    ECall(EIdent(name, _), _, _, _) => {
      let idx = gc_direct_abi_call_index(ctx = ctx, name = name)
      find_local_slot(names = local_names, name = name) < 0 && idx >= 0 && Array::get(ctx.gc_direct_abi_return_refs, at = idx)
    },
    EIf(_, then_e, else_e) => gc_join_is_native_ref(then_e = then_e, else_e = else_e, local_names = local_names, ctx = ctx),
    _ => false
  }
}

/// Whether `gc_compile_native_array_ref` can produce `expr` on the reference
/// lane at this program point. This is deliberately stricter than "has type
/// Array": calls that retain the tagged-i64 ABI cannot be converted implicitly.
export fn gc_expr_can_compile_native_array_ref(expr: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {
  match expr {
    EIdent(name, _) => {
      let slot = find_local_slot(names = local_names, name = name)
      slot >= 0 && array_contains_int(arr = ctx.gc_native_array_locals, v = slot)
    },
    EArray(_) => true,
    EDot(EIdent(ns_obj, _), ns_field, _, _) => gc_ctor_field_is_ref(ct = ctx.gc_ctor_table, struct_idx = gc_slot_map_get(map = ctx.gc_native_struct_scope, slot = find_local_slot(names = local_names, name = ns_obj)), field = ns_field),
    ECall(EIdent(name, _), _, _, _) => {
      let idx = gc_direct_abi_call_index(ctx = ctx, name = name)
      find_local_slot(names = local_names, name = name) < 0 && idx >= 0 && Array::get(ctx.gc_direct_abi_return_refs, at = idx)
    },
    EIf(_, then_e, else_e) => gc_expr_can_compile_native_array_ref(expr = then_e, local_names = local_names, ctx = ctx) && gc_expr_can_compile_native_array_ref(expr = else_e, local_names = local_names, ctx = ctx),
    _ => false
  }
}

/// Values that ALREADY inhabit the reference lane here, as opposed to values
/// whose representation their consumer still picks. A bare `[1, 2]` is the
/// second kind: `gc_compile_native_array_ref` will happily give it a native
/// slot when a proven consumer asks for one, but on its own it is equally a
/// linear-memory literal. An `if` has no consumer proof to lean on, so only the
/// first kind may be joined.
fn gc_expr_is_lane_proven_ref(expr: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {
  match expr {
    EIdent(name, _) => {
      let slot = find_local_slot(names = local_names, name = name)
      slot >= 0 && array_contains_int(arr = ctx.gc_native_array_locals, v = slot)
    },
    ECall(EIdent(name, _), _, _, _) => {
      let idx = gc_direct_abi_call_index(ctx = ctx, name = name)
      find_local_slot(names = local_names, name = name) < 0 && idx >= 0 && Array::get(ctx.gc_direct_abi_return_refs, at = idx)
    },
    EIf(_, then_e, else_e) => gc_expr_is_lane_proven_ref(expr = then_e, local_names = local_names, ctx = ctx) && gc_expr_is_lane_proven_ref(expr = else_e, local_names = local_names, ctx = ctx),
    _ => false
  }
}

/// Does this `if` produce a `(ref null $native_i64_array)`? Both arms must
/// already be in the reference lane; one arm alone would mean the same program
/// point holds two representations, which is the invariant ADR-0095 is built
/// on. Shared with backend_expr.vibe so the tail/value position and the
/// direct-call argument position agree on the blocktype.
fn gc_join_is_native_ref(then_e: Expr, else_e: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {
  ctx.gc_native_array_block_type_idx >= 0 && gc_expr_is_lane_proven_ref(expr = then_e, local_names = local_names, ctx = ctx) && gc_expr_is_lane_proven_ref(expr = else_e, local_names = local_names, ctx = ctx)
}

/// Drop the bindings an `if` arm introduced, then pad the name list back up to
/// that arm's high-water mark so the next arm allocates strictly above it.
/// Only the NAME bindings are dropped: `gc_native_array_local_types` is the
/// declaration list and must keep every typed slot the arm allocated.
export fn gc_reset_join_arm_slots(local_names: Array[String], ctx: CompileCtxGc, names_len_before: Int, high_water: Int) -> Unit {
  Array::truncate(local_names, length = names_len_before)
  agg_log_reset_above(arr = ctx.gc_agg_local_slots, floor = names_len_before)
  gc_slot_log_reset_above(arr = ctx.gc_bool_locals, floor = names_len_before)
  gc_slot_log_reset_above(arr = ctx.gc_int_locals, floor = names_len_before)
  gc_slot_log_reset_above(arr = ctx.ref_local_indices, floor = names_len_before)
  gc_slot_log_reset_above(arr = ctx.gc_float_locals, floor = names_len_before)
  gc_slot_log_reset_above(arr = ctx.gc_native_array_locals, floor = names_len_before)
  gc_slot_map_reset_above(map = ctx.gc_native_struct_scope, floor = names_len_before)
  while Array::length(local_names) < high_water {
    Array::push(local_names, value = "")
  }
}

/// `Array::slice(v, 0, Array::length(v))` with `v` bound once, so an
/// effectful argument is evaluated a single time (#1733).
export fn gc_frozen_conversion_copy(value: Expr, tmp: String) -> Expr {
  ELet(tmp, value, ECall(EIdent("Array::slice", -1), [
    EIdent(tmp, -1),
    EInt(0),
    ECall(EIdent("Array::length", -1), [EIdent(tmp, -1)], -1, [])
  ], -1, []), -1)
}

/// #2300: is `name` something the READER wrote -- a lexical binding in this
/// closure, or a top-level definition -- rather than a generated builtin?
///
/// The gc lane's `assert` / `assert_true` / `assert_eq` arms below used to
/// claim the call unconditionally, so a program that defined its own
/// `assert_eq` trapped `unreachable` where the linear lane ran the user's
/// function (#2283/#2285 fixed linear; this is the other half).
///
/// Porting linear's guard verbatim does not work and was measured breaking
/// the lane outright (`expected 1 elements on the stack for fallthru, found
/// 3`). Linear tests `fn_idx_in_list < 0`, which is meaningful there because
/// `assert*` are NOT in its func table -- `core/builtin_registry.vibe` gives
/// those three rows `in_linear_table = false, in_gc_table = true`. Here the
/// index is >= 0 for every call, shadowed or not, so the guard fired always
/// and the arms stopped emitting their result.
///
/// The distinction the guard wants is user-vs-generated, and the table
/// already encodes it positionally: `func_offset = 1 + hbo + num_generated`
/// and user function `j` lives at `j + func_offset` (backend_body.vibe). An
/// index below `func_offset` is an import or a generated builtin; one at or
/// above it is the reader's. That is the same `idx >= ctx.func_offset` test
/// backend_expr.vibe already uses to tell the two apart.
///
/// The top-level half goes through `func_table_user_index_of` rather than
/// through `func_table_index_of` plus an index comparison. When a user shadows
/// a builtin the table holds both entries under one name, and that lookup
/// answers with whichever branch it takes -- today the gc `FuncTable` literals
/// set `names_sorted: array_empty()` so it is the linear first-match one, but
/// resting a correctness answer on that is resting it on sort stability. The
/// prefix scan is exact by construction on both backends.
export fn gc_name_is_user_defined(ctx: CompileCtxGc, local_names: Array[String], name: String) -> Bool {
  find_local_slot(names = local_names, name = name) >= 0 || func_table_user_index_of(ft = ctx.func_table, name = name, num_user_funcs = ctx.num_user_funcs) >= 0
}

/// wasm-gc counterpart of the linear checked Map key-slot load. Bounds and
/// trapping are emitted directly so source bindings cannot intercept them.
export fn gc_compile_map_iter_get_checked(buf: Bytes, map_expr: Expr, index_expr: Expr, local_names: Array[String], next_local: Int, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with Exception) -> Int with Exception {
  let map_l = next_local
  let index_l = next_local + 1
  let len_l = next_local + 2
  Array::push(local_names, value = "[gc-temp]__map_iter_get_map")
  Array::push(local_names, value = "[gc-temp]__map_iter_get_index")
  Array::push(local_names, value = "[gc-temp]__map_iter_get_len")
  let mut nl = next_local + 3
  nl = ce(buf, map_expr, local_names, nl, ld)
  emit_local_set(buf = buf, idx = map_l)
  nl = ce(buf, index_expr, local_names, nl, ld)
  emit_local_set(buf = buf, idx = index_l)
  emit_local_get(buf = buf, idx = map_l)
  emit_i64_const(buf = buf, value = -2)
  emit_i64_and(buf)
  emit_local_set(buf = buf, idx = map_l)
  emit_local_get(buf = buf, idx = map_l)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf = buf, align = 2, offset = 0)
  emit_i64_extend_i32_u(buf)
  emit_local_set(buf = buf, idx = len_l)
  emit_local_get(buf = buf, idx = index_l)
  emit_i64_const(buf = buf, value = 0)
  emit_i64_lt_s(buf)
  emit_if_void(buf)
  bytebuf_push(buf = buf, byte = 0)
  emit_end(buf)
  emit_local_get(buf = buf, idx = index_l)
  emit_local_get(buf = buf, idx = len_l)
  emit_i64_ge_s(buf)
  emit_if_void(buf)
  bytebuf_push(buf = buf, byte = 0)
  emit_end(buf)
  emit_local_get(buf = buf, idx = map_l)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf = buf, idx = index_l)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = 16)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_i64_load(buf = buf, align = 3, offset = 8)
  nl
}

// Ordered named-call dispatch group.
export fn gc_compile_named_2(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with Exception, fname: String, source_is_bound: Bool, ctor_lookup_idx: Int, compile_call_gc_fn: (Bytes, Expr, Array[Expr], Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with Exception) -> Int with Exception, gc_mut_alias_call_fn: (Bytes, String, Array[Expr], Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with Exception) -> Int with Exception, gc_compile_native_array_ref_fn: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with Exception) -> Int with Exception) -> Int with Exception {
  if fname == "MapBuilder::set" || fname == "MapBuilder::__scalar_set" {
    // Update-or-append (gc lane semantics), over the handle-indirect
    // storage (see MapBuilder::new). Grows storage ×2 when an append
    // finds it full — the old fixed-block version wrote past the block
    // with no check (#723-family heap corruption). #2334: the scalar set
    // compares keys as exact i64 values and marks the builder.
    let scalar_key = fname == "MapBuilder::__scalar_set"
    let (eq_fi, _, _) = resolve_func(ft = ctx.func_table, name = "eq")
    let mut nl = ce(buf, Array::get(args, at = 0), local_names, next_local, ld)
    nl = ce(buf, Array::get(args, at = 1), local_names, nl, ld)
    nl = ce(buf, Array::get(args, at = 2), local_names, nl, ld)
    let mb_l = nl
    let mk_l = nl + 1
    let mv_l = nl + 2
    let mc_l = nl + 3
    let mi_l = nl + 4
    let found_l = nl + 5
    let cap_l = nl + 6
    let st_l = nl + 7
    let ns_l = nl + 8
    Array::push(local_names, value = "[gc-temp]__mbs_map")
    Array::push(local_names, value = "[gc-temp]__mbs_key")
    Array::push(local_names, value = "[gc-temp]__mbs_val")
    Array::push(local_names, value = "[gc-temp]__mbs_cnt")
    Array::push(local_names, value = "[gc-temp]__mbs_i")
    Array::push(local_names, value = "[gc-temp]__mbs_found")
    Array::push(local_names, value = "[gc-temp]__mbs_cap")
    Array::push(local_names, value = "[gc-temp]__mbs_st")
    Array::push(local_names, value = "[gc-temp]__mbs_ns")
    emit_local_set(buf = buf, idx = mv_l)
    emit_local_set(buf = buf, idx = mk_l)
    emit_local_set(buf = buf, idx = mb_l)
    // Load count / cap / storage from the handle
    emit_local_get(buf = buf, idx = mb_l)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf = buf, align = 2, offset = 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf = buf, idx = mc_l)
    emit_local_get(buf = buf, idx = mb_l)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf = buf, align = 2, offset = 4)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf = buf, idx = cap_l)
    if scalar_key {
      gc_mapbuilder_mark_scalar_cap(buf = buf, mb_l = mb_l, cap_l = cap_l)
    } else {
      gc_mapbuilder_trap_if_scalar(buf = buf, mb_l = mb_l)
    }
    emit_local_get(buf = buf, idx = mb_l)
    emit_i32_wrap_i64(buf)
    emit_i64_load(buf = buf, align = 3, offset = 8)
    emit_local_set(buf = buf, idx = st_l)
    // Search for existing key (entries: key@+0, value@+8)
    emit_i64_const(buf = buf, value = 0)
    emit_local_set(buf = buf, idx = mi_l)
    emit_i64_const(buf = buf, value = 0)
    emit_local_set(buf = buf, idx = found_l)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf = buf, idx = mi_l)
    emit_local_get(buf = buf, idx = mc_l)
    emit_i64_ge_s(buf)
    emit_br_if(buf = buf, label = 1)
    // Compare key at entry[i]
    emit_local_get(buf = buf, idx = st_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf = buf, idx = mi_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf = buf, value = 16)
    emit_i32_mul(buf)
    emit_i32_add(buf)
    emit_i64_load(buf = buf, align = 3, offset = 0)
    emit_local_get(buf = buf, idx = mk_l)
    gc_map_emit_key_eq(buf = buf, ctx = ctx, scalar = scalar_key, eq_fi = eq_fi)
    emit_i32_wrap_i64(buf)
    emit_if_void(buf)
    // Found: update value in place
    emit_local_get(buf = buf, idx = st_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf = buf, idx = mi_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf = buf, value = 16)
    emit_i32_mul(buf)
    emit_i32_add(buf)
    emit_local_get(buf = buf, idx = mv_l)
    emit_i64_store(buf = buf, align = 3, offset = 8)
    emit_i64_const(buf = buf, value = 1)
    emit_local_set(buf = buf, idx = found_l)
    emit_br(buf = buf, label = 2)
    emit_end(buf)
    emit_local_get(buf = buf, idx = mi_l)
    emit_i64_const(buf = buf, value = 1)
    emit_i64_add(buf)
    emit_local_set(buf = buf, idx = mi_l)
    emit_br(buf = buf, label = 0)
    emit_end(buf)
    emit_end(buf)
    // If not found, append new entry (growing storage when full)
    emit_local_get(buf = buf, idx = found_l)
    emit_i64_eqz(buf)
    emit_if_void(buf)
    emit_local_get(buf = buf, idx = mc_l)
    emit_local_get(buf = buf, idx = cap_l)
    emit_i64_eq(buf)
    emit_if_void(buf)
    emit_global_get(buf = buf, idx = 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf = buf, idx = ns_l)
    emit_global_get(buf = buf, idx = 0)
    emit_local_get(buf = buf, idx = cap_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf = buf, value = 32)
    emit_i32_mul(buf)
    emit_i32_add(buf)
    emit_global_set(buf = buf, idx = 0)
    emit_heap_memory_grow_check(buf)
    emit_local_get(buf = buf, idx = ns_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf = buf, idx = st_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf = buf, idx = mc_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf = buf, value = 16)
    emit_i32_mul(buf)
    emit_memory_copy(buf)
    emit_local_get(buf = buf, idx = mb_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf = buf, idx = ns_l)
    emit_i64_store(buf = buf, align = 3, offset = 8)
    emit_local_get(buf = buf, idx = mb_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf = buf, idx = cap_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf = buf, value = 2)
    emit_i32_mul(buf)
    if scalar_key {
      // The doubled capacity is below the mark's bit: adding sets it.
      emit_i32_const(buf = buf, value = gc_mapbuilder_scalar_cap_marker)
      emit_i32_add(buf)
    } else ()
    emit_i32_store(buf = buf, align = 2, offset = 4)
    emit_local_get(buf = buf, idx = ns_l)
    emit_local_set(buf = buf, idx = st_l)
    emit_end(buf)
    // Store key/value at entry[count]
    emit_local_get(buf = buf, idx = st_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf = buf, idx = mc_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf = buf, value = 16)
    emit_i32_mul(buf)
    emit_i32_add(buf)
    emit_local_get(buf = buf, idx = mk_l)
    emit_i64_store(buf = buf, align = 3, offset = 0)
    emit_local_get(buf = buf, idx = st_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf = buf, idx = mc_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf = buf, value = 16)
    emit_i32_mul(buf)
    emit_i32_add(buf)
    emit_local_get(buf = buf, idx = mv_l)
    emit_i64_store(buf = buf, align = 3, offset = 8)
    // Increment count
    emit_local_get(buf = buf, idx = mb_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf = buf, idx = mc_l)
    emit_i64_const(buf = buf, value = 1)
    emit_i64_add(buf)
    emit_i32_wrap_i64(buf)
    emit_i32_store(buf = buf, align = 2, offset = 0)
    emit_end(buf)
    emit_i64_const(buf = buf, value = 0)
    nl + 9
  }
  else if fname == "MapBuilder::freeze" || fname == "MapBuilder::__scalar_freeze" {
    // Copy the handle's entries into a fresh plain Map block (the
    // builder is handle-indirect, so freeze is no longer a passthrough).
    // #2334: the scalar freeze marks the map scalar-keyed.
    let scalar_key = fname == "MapBuilder::__scalar_freeze"
    let nl = ce(buf, Array::get(args, at = 0), local_names, next_local, ld)
    let fb_l = nl
    let fc_l = nl + 1
    let fm_l = nl + 2
    Array::push(local_names, value = "[gc-temp]__mbf_b")
    Array::push(local_names, value = "[gc-temp]__mbf_cnt")
    Array::push(local_names, value = "[gc-temp]__mbf_map")
    emit_i64_const(buf = buf, value = -2)
    emit_i64_and(buf)
    emit_local_set(buf = buf, idx = fb_l)
    if scalar_key {
      ()
    } else {
