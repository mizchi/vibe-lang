    let cnt_l = nl + 2
    let i_l = nl + 3
    Array::push(local_names, value = "[gc-temp]__keys_map")
    Array::push(local_names, value = "[gc-temp]__keys_res")
    Array::push(local_names, value = "[gc-temp]__keys_cnt")
    Array::push(local_names, value = "[gc-temp]__keys_i")
    emit_local_set(buf = buf, idx = map_l)
    emit_call_resolved(buf = buf, ctx = ctx, fidx = arr_new_fi)
    emit_local_set(buf = buf, idx = res_l)
    emit_local_get(buf = buf, idx = map_l)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf = buf, align = 2, offset = 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf = buf, idx = cnt_l)
    emit_i64_const(buf = buf, value = 0)
    emit_local_set(buf = buf, idx = i_l)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf = buf, idx = i_l)
    emit_local_get(buf = buf, idx = cnt_l)
    emit_i64_ge_s(buf)
    emit_br_if(buf = buf, label = 1)
    emit_local_get(buf = buf, idx = res_l)
    emit_local_get(buf = buf, idx = map_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf = buf, idx = i_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf = buf, value = 16)
    emit_i32_mul(buf)
    emit_i32_add(buf)
    emit_i64_load(buf = buf, align = 3, offset = 8)
    emit_call_resolved(buf = buf, ctx = ctx, fidx = arr_push_fi)
    emit_local_get(buf = buf, idx = i_l)
    emit_i64_const(buf = buf, value = 1)
    emit_i64_add(buf)
    emit_local_set(buf = buf, idx = i_l)
    emit_br(buf = buf, label = 0)
    emit_end(buf)
    emit_end(buf)
    emit_local_get(buf = buf, idx = res_l)
    nl + 4
  }
  else if fname == "StringBuilder::new" {
    // #538: same lowering as the linear backend -- a StringBuilder IS an
    // Array[String]; freeze joins with "".
    let (arr_new_idx2, _, _) = resolve_func(ft = ctx.func_table, name = "array_new")
    emit_call_resolved(buf = buf, ctx = ctx, fidx = arr_new_idx2)
    next_local
  }
  else if fname == "StringBuilder::push" {
    let mut nl = ce(buf, Array::get(args, at = 0), local_names, next_local, ld)
    nl = ce(buf, Array::get(args, at = 1), local_names, nl, ld)
    let (arr_push_idx2, _, _) = resolve_func(ft = ctx.func_table, name = "Array::push")
    emit_call_resolved(buf = buf, ctx = ctx, fidx = arr_push_idx2)
    emit_i64_const(buf = buf, value = 0)
    nl
  }
  else if fname == "StringBuilder::freeze" {
    let nl = ce(buf, Array::get(args, at = 0), local_names, next_local, ld)
    let empty_idx = str_table_index_of(st = ctx.str_table, s = "")
    emit_str_ref(buf = buf, offset = Array::get(ctx.str_table.offsets, at = empty_idx), length = Array::get(ctx.str_table.lengths, at = empty_idx))
    let (join_idx, _, _) = resolve_func(ft = ctx.func_table, name = "String::join")
    emit_call_resolved(buf = buf, ctx = ctx, fidx = join_idx)
    nl
  }
  else if (fname == "print" || fname == "println") && !gc_name_is_user_defined(ctx = ctx, local_names = local_names, name = fname) {
    // print(x) = print_str(__to_string(x)); println then writes "\n" with a
    // second print_str -- the linear lane's shape (write_stream, then
    // write_char 10). A string literal is printed as is: it needs no
    // rendering, so a program that only prints literals links neither
    // `__to_string` nor `String::concat` (302 + 177 B of helpers).
    // `__to_string` stays for any other argument, because the backend
    // probes compile `println` of unchecked values (codegen_gc_test_support).
    let (ps_idx, _, _) = resolve_func(ft = ctx.func_table, name = "print_str")
    let arg = Array::get(args, at = 0)
    let nl = ce(buf, arg, local_names, next_local, ld)
    match arg {
      EString(_, _) => (),
      _ => emit_call_resolved(buf = buf, ctx = ctx, fidx = gc_resolve_builtin_last(ft = ctx.func_table, name = "__to_string"))
    }
    emit_call_resolved(buf = buf, ctx = ctx, fidx = ps_idx)
    if fname == "println" {
      let nl_idx = str_table_index_of(st = ctx.str_table, s = "\n")
      emit_str_ref(buf = buf, offset = Array::get(ctx.str_table.offsets, at = nl_idx), length = Array::get(ctx.str_table.lengths, at = nl_idx))
      emit_call_resolved(buf = buf, ctx = ctx, fidx = ps_idx)
    } else {
      ()
    }
    emit_i64_const(buf = buf, value = 0)
    nl
  }
  else if fname == "__let_refuted" {
    gc_let_refuted_trap(buf = buf, args = args, ctx = ctx)
    next_local
  }
  else if fname == "abort" && !gc_name_is_user_defined(ctx = ctx, local_names = local_names, name = fname) {
    // #2397: same print-then-trap as the linear lane, via `print_str`.
    let (ps_idx, _, _) = resolve_func(ft = ctx.func_table, name = "print_str")
    let nl = ce(buf, Array::get(args, at = 0), local_names, next_local, ld)
    emit_call_resolved(buf = buf, ctx = ctx, fidx = ps_idx)
    let nl_idx = str_table_index_of(st = ctx.str_table, s = "\n")
    emit_str_ref(buf = buf, offset = Array::get(ctx.str_table.offsets, at = nl_idx), length = Array::get(ctx.str_table.lengths, at = nl_idx))
    emit_call_resolved(buf = buf, ctx = ctx, fidx = ps_idx)
    bytebuf_push(buf = buf, byte = 0)
    emit_i64_const(buf = buf, value = 0)
    nl
  }
  else if (fname == "assert" || fname == "assert_true") && !gc_name_is_user_defined(ctx = ctx, local_names = local_names, name = fname) {
    // Trap (unreachable) on a false condition, like the linear backend.
    // #2300: ...unless the reader defined the name, in which case the
    // call below compiles it as the ordinary function it is.
    let nl = ce(buf, Array::get(args, at = 0), local_names, next_local, ld)
    emit_i64_eqz(buf)
    emit_if_void(buf)
    bytebuf_push(buf = buf, byte = 0)
    emit_end(buf)
    emit_i64_const(buf = buf, value = 0)
    nl
  }
  else if fname == "assert_eq" && !gc_name_is_user_defined(ctx = ctx, local_names = local_names, name = fname) {
    // Fallback only. The shipped path rewrites `assert_eq` in
    // desugar_trait_dicts -- and when THAT pass stands down for a user's
    // own `assert_eq` (#2283/#2285), this arm must stand down with it,
    // which is what the guard above does (#2300).
    // Keep parity with the linear fallback:
    // synthesized `==` uses the backend's value-aware equality path.
    let nl = ce(buf, EBinOp("==", Array::get(args, at = 0), Array::get(args, at = 1), -1), local_names, next_local, ld)
    emit_i64_eqz(buf)
    emit_if_void(buf)
    bytebuf_push(buf = buf, byte = 0)
    emit_end(buf)
    emit_i64_const(buf = buf, value = 0)
    nl
  }
  else if fname == "FixedArray::make" || fname == "Int64Array::make" {
    // FixedArray rides on the gc array: make(n, init) = n pushes of init.
    // #835: Int64Array::* is the same alias (Array already stores full
    // tagged Int elements — no separate i64-cell layout needed).
    let (fa_new_idx, _, _) = resolve_func(ft = ctx.func_table, name = "array_new")
    let (fa_push_idx, _, _) = resolve_func(ft = ctx.func_table, name = "Array::push")
    let mut nl = ce(buf, Array::get(args, at = 0), local_names, next_local, ld)
    nl = ce(buf, Array::get(args, at = 1), local_names, nl, ld)
    let fam_n = nl
    let fam_init = nl + 1
    let fam_arr = nl + 2
    let fam_i = nl + 3
    Array::push(local_names, value = "[gc-temp]__fam_n")
    Array::push(local_names, value = "[gc-temp]__fam_init")
    Array::push(local_names, value = "[gc-temp]__fam_arr")
    Array::push(local_names, value = "[gc-temp]__fam_i")
    emit_local_set(buf = buf, idx = fam_init)
    emit_local_set(buf = buf, idx = fam_n)
    emit_call_resolved(buf = buf, ctx = ctx, fidx = fa_new_idx)
    emit_local_set(buf = buf, idx = fam_arr)
    emit_i64_const(buf = buf, value = 0)
    emit_local_set(buf = buf, idx = fam_i)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf = buf, idx = fam_i)
    emit_local_get(buf = buf, idx = fam_n)
    emit_i64_ge_s(buf)
    emit_br_if(buf = buf, label = 1)
    emit_local_get(buf = buf, idx = fam_arr)
    emit_local_get(buf = buf, idx = fam_init)
    emit_call_resolved(buf = buf, ctx = ctx, fidx = fa_push_idx)
    emit_local_get(buf = buf, idx = fam_i)
    emit_i64_const(buf = buf, value = 1)
    emit_i64_add(buf)
    emit_local_set(buf = buf, idx = fam_i)
    emit_br(buf = buf, label = 0)
    emit_end(buf)
    emit_end(buf)
    emit_local_get(buf = buf, idx = fam_arr)
    nl + 4
  }
  else if fname == "FixedArray::length" || fname == "Int64Array::length" {
    let (fa_len_idx, _, _) = resolve_func(ft = ctx.func_table, name = "Array::length")
    let nl = ce(buf, Array::get(args, at = 0), local_names, next_local, ld)
    emit_call_resolved(buf = buf, ctx = ctx, fidx = fa_len_idx)
    nl
  }
  else if fname == "FixedArray::get" || fname == "Int64Array::get" {
    let (fa_get_idx, _, _) = resolve_func(ft = ctx.func_table, name = "Array::get")
    let mut nl = ce(buf, Array::get(args, at = 0), local_names, next_local, ld)
    nl = ce(buf, Array::get(args, at = 1), local_names, nl, ld)
    emit_call_resolved(buf = buf, ctx = ctx, fidx = fa_get_idx)
    nl
  }
  else if fname == "FixedArray::set" || fname == "FixedArray::unsafe_set" || fname == "Int64Array::set" {
    let (fa_set_idx, _, _) = resolve_func(ft = ctx.func_table, name = "Array::set")
    let mut nl = ce(buf, Array::get(args, at = 0), local_names, next_local, ld)
    nl = ce(buf, Array::get(args, at = 1), local_names, nl, ld)
    nl = ce(buf, Array::get(args, at = 2), local_names, nl, ld)
    emit_call_resolved(buf = buf, ctx = ctx, fidx = fa_set_idx)
    emit_i64_const(buf = buf, value = 0)
    nl
  }
  else if fname == "FixedArray::blit" {
    // blit(dst, dst_off, src, src_off, len): element-by-element copy.
    let (fb_get_idx, _, _) = resolve_func(ft = ctx.func_table, name = "Array::get")
    let (fb_set_idx, _, _) = resolve_func(ft = ctx.func_table, name = "Array::set")
    let mut nl = ce(buf, Array::get(args, at = 0), local_names, next_local, ld)
    nl = ce(buf, Array::get(args, at = 1), local_names, nl, ld)
    nl = ce(buf, Array::get(args, at = 2), local_names, nl, ld)
    nl = ce(buf, Array::get(args, at = 3), local_names, nl, ld)
    nl = ce(buf, Array::get(args, at = 4), local_names, nl, ld)
    let fb_dst = nl
    let fb_doff = nl + 1
    let fb_src = nl + 2
    let fb_soff = nl + 3
    let fb_len = nl + 4
    let fb_i = nl + 5
    Array::push(local_names, value = "[gc-temp]__fb_dst")
    Array::push(local_names, value = "[gc-temp]__fb_doff")
    Array::push(local_names, value = "[gc-temp]__fb_src")
    Array::push(local_names, value = "[gc-temp]__fb_soff")
    Array::push(local_names, value = "[gc-temp]__fb_len")
    Array::push(local_names, value = "[gc-temp]__fb_i")
    emit_local_set(buf = buf, idx = fb_len)
    emit_local_set(buf = buf, idx = fb_soff)
    emit_local_set(buf = buf, idx = fb_src)
    emit_local_set(buf = buf, idx = fb_doff)
    emit_local_set(buf = buf, idx = fb_dst)
    emit_i64_const(buf = buf, value = 0)
    emit_local_set(buf = buf, idx = fb_i)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf = buf, idx = fb_i)
    emit_local_get(buf = buf, idx = fb_len)
    emit_i64_ge_s(buf)
    emit_br_if(buf = buf, label = 1)
    emit_local_get(buf = buf, idx = fb_dst)
    emit_local_get(buf = buf, idx = fb_doff)
    emit_local_get(buf = buf, idx = fb_i)
    emit_i64_add(buf)
    emit_local_get(buf = buf, idx = fb_src)
    emit_local_get(buf = buf, idx = fb_soff)
    emit_local_get(buf = buf, idx = fb_i)
    emit_i64_add(buf)
    emit_call_resolved(buf = buf, ctx = ctx, fidx = fb_get_idx)
    emit_call_resolved(buf = buf, ctx = ctx, fidx = fb_set_idx)
    emit_local_get(buf = buf, idx = fb_i)
    emit_i64_const(buf = buf, value = 1)
    emit_i64_add(buf)
    emit_local_set(buf = buf, idx = fb_i)
    emit_br(buf = buf, label = 0)
    emit_end(buf)
    emit_end(buf)
    emit_i64_const(buf = buf, value = 0)
    nl + 6
  } else {
    let fn_len2 = Array::length(ctx.func_table.names)
    // The `$ref` twin is the direct-ABI entry of the callee -- a builtin's,
    // and also a program function's (gc_add_ref_twins makes one for an
    // exported function taking a native array), so it applies to both.
    let eff_fname = gc_direct_abi_twin_callee(ctx = ctx, fname = fname)
    let local_callee_idx = find_local_slot(names = local_names, name = fname)
    let mut fn_idx_in_list = -1
    let mut __fi = 0
    // A lexical binding shadows a same-named top-level function. Identifier
    // expressions already use this ordering; calls must do the same (#2160).
    while local_callee_idx < 0 && __fi < fn_len2 {
      if Array::get(ctx.func_table.names, at = __fi) == eff_fname {
        fn_idx_in_list = __fi
        __fi = fn_len2
      } else {
        __fi = __fi + 1
      }
    }
    if fn_idx_in_list >= 0 {
      let fidx = Array::get(ctx.func_table.indices, at = fn_idx_in_list)
      let has_ret = Array::get(ctx.func_table.returns, at = fn_idx_in_list)
      let direct_idx = gc_direct_abi_call_index(ctx = ctx, name = eff_fname)
      let mut nl = next_local
      let mut ci = 0
      while ci < Array::length(args) {
        if direct_idx >= 0 && Array::get(Array::get(ctx.gc_direct_abi_param_refs, at = direct_idx), at = ci) {
          nl = gc_compile_native_array_ref_fn(buf, Array::get(args, at = ci), local_names, nl, ctx, ld, ce)
        } else {
          nl = ce(buf, Array::get(args, at = ci), local_names, nl, ld)
        }
        ci = ci + 1
      }
      if ctx.func_offset > 0 {
        if fidx >= ctx.func_offset {
          emit_i64_const(buf = buf, value = 0)
        }
      }
      emit_call(buf = buf, func_idx = fidx)
      if has_ret == 0 {
        emit_i64_const(buf = buf, value = 0)
      }
      nl
    } else {
      // #3025: a computed module-level `let` holding a closure (`let g =
      // mk()`, or a binder of a top-level destructuring `let`) lives in a
      // global on this lane, not in a local; call through its value.
      // Looked up BEFORE the constructor guard below: a value may be named
      // with a capital (`let F = make_adder(1)`), and it is a global, not
      // an unknown constructor (Codex on #3047).
      let mut global_callee_idx = -1
      if local_callee_idx < 0 {
        let mut __gg = 0
        while __gg < Array::length(ctx.gc_global_names) {
          if Array::get(ctx.gc_global_names, at = __gg) == fname {
            global_callee_idx = __gg
            __gg = Array::length(ctx.gc_global_names)
          } else {
            __gg = __gg + 1
          }
        }
      }
      // An uppercase-initial callee that missed the ctor table is an
      // unknown constructor, not a local closure -- fail with a clear
      // message instead of resolve_local's "undefined variable".
      let c0 = String::char_code_at(fname, at = 0)
      if local_callee_idx < 0 && global_callee_idx < 0 && c0 >= 65 && c0 <= 90 {
        refuse_extern_effect_operation(fname)
        throw("GC codegen: unknown constructor or function: \{fname}")
      }
      let local_idx2 = if local_callee_idx >= 0 {
        local_callee_idx
      } else if global_callee_idx >= 0 {
        0 - 1
      } else {
        resolve_local(names = local_names, name = fname, tag = "gc_call")
      }
      let num_args = Array::length(args)
      let fn_val_local = next_local
      let slot_local = next_local + 1
      let env_local = next_local + 2
      let mut nl = next_local + 3
      Array::push(local_names, value = "[gc-temp]__fn_val")
      Array::push(local_names, value = "[gc-temp]__slot")
      Array::push(local_names, value = "[gc-temp]__env")
      if global_callee_idx >= 0 {
        // Same read as backend_expr's computed-global arm.
        emit_global_get(buf = buf, idx = 1 + global_callee_idx)
      } else {
        emit_local_get(buf = buf, idx = local_idx2)
      }
      // #2012: see the linear compile_call path — boxed `let mut`
      // locals store a cell address. #3357: asked of the SLOT the name
      // resolves to, so a later same-named `let` is called directly.
      if global_callee_idx < 0 && array_contains_int(arr = ctx.ref_local_indices, v = local_idx2) {
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf = buf, align = 3, offset = 0)
      } else {
        ()
      }
      emit_local_set(buf = buf, idx = fn_val_local)
      emit_closure_resolve(buf = buf, fn_val_local = fn_val_local, slot_local = slot_local, env_local = env_local)
      let mut ci = 0
      while ci < num_args {
        nl = ce(buf, Array::get(args, at = ci), local_names, nl, ld)
        ci = ci + 1
      }
      emit_closure_call_tail(buf = buf, env_local = env_local, slot_local = slot_local, closure_type_base = ctx.closure_type_base, num_args = num_args)
      nl
    }
  }
}

export {
  gc_join_is_native_ref
}
