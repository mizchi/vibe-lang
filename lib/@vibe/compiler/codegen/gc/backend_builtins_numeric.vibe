//# Functions

export fn gc_gen_identity_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  b
}

/// Push `memory.size * 65536` (linear memory size in BYTES) as an i64.
fn gc_emit_mem_size_bytes(b: Bytes) -> Unit {
  bytebuf_push(b, 63)
  bytebuf_push(b, 0)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 65536)
  emit_i64_mul(b)
}

/// #2405: the INTEGER half of `__to_string`, with the local slots passed in so
/// the same bytes serve two callers: the runtime-dispatching builtin below
/// (slots 0..5, its own params + locals) and a call site that already knows
/// the argument is an Int and must NOT run the string-pointer heuristic
/// (backend_call.vibe, fresh slots).
///
/// Reads `val_l`, leaves one i64 (the packed `(ptr << 32) | len` string) on the
/// stack, and clobbers the other five. It does not open a block of its own.
export fn gc_emit_int_to_string(b: Bytes, val_l: Int, neg_l: Int, cur_l: Int, abs_l: Int, hp_l: Int, len_l: Int) -> Unit {
  // Render decimal digits right-to-left into scratch bytes 46..1, then copy to
  // a fresh heap string (gc data_base is 64, so 0..63 is free).
  emit_i64_const(b, 46)
  emit_local_set(b, cur_l)
  emit_local_get(b, val_l)
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_i64_extend_i32_s(b)
  emit_local_set(b, neg_l)
  emit_local_get(b, val_l)
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_local_get(b, val_l)
  emit_i64_sub(b)
  emit_else(b)
  emit_local_get(b, val_l)
  emit_end(b)
  emit_local_set(b, abs_l)
  emit_local_get(b, abs_l)
  emit_i64_eqz(b)
  emit_if_void(b)
  emit_local_get(b, cur_l)
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 48)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, cur_l)
  emit_i64_const(b, 1)
  emit_i64_sub(b)
  emit_local_set(b, cur_l)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, abs_l)
  emit_i64_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, cur_l)
  emit_i32_wrap_i64(b)
  emit_local_get(b, abs_l)
  emit_i64_const(b, 10)
  emit_i64_rem_s(b)
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 48)
  emit_i32_add(b)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, cur_l)
  emit_i64_const(b, 1)
  emit_i64_sub(b)
  emit_local_set(b, cur_l)
  emit_local_get(b, abs_l)
  emit_i64_const(b, 10)
  emit_i64_div_s(b)
  emit_local_set(b, abs_l)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, neg_l)
  emit_i32_wrap_i64(b)
  emit_if_void(b)
  emit_local_get(b, cur_l)
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 45)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, cur_l)
  emit_i64_const(b, 1)
  emit_i64_sub(b)
  emit_local_set(b, cur_l)
  emit_end(b)
  emit_global_get(b, 0)
  emit_i64_extend_i32_u(b)
  emit_local_set(b, hp_l)
  emit_i64_const(b, 46)
  emit_local_get(b, cur_l)
  emit_i64_sub(b)
  emit_local_set(b, len_l)
  // Bump + grow check BEFORE the memory.copy into the fresh allocation —
  // same ordering fix as the linear inline `__to_string` handler
  // (compile_call.vibe): copying first traps when the previous allocation
  // left global 0 within `len` bytes of the memory end.
  emit_local_get(b, hp_l)
  emit_i32_wrap_i64(b)
  emit_local_get(b, len_l)
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 7)
  emit_i32_add(b)
  emit_i32_const(b, -8)
  bytebuf_push(b, 113)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_heap_memory_grow_check(b)
  emit_local_get(b, hp_l)
  emit_i32_wrap_i64(b)
  emit_local_get(b, cur_l)
  emit_i64_const(b, 1)
  emit_i64_add(b)
  emit_i32_wrap_i64(b)
  emit_local_get(b, len_l)
  emit_i32_wrap_i64(b)
  emit_memory_copy(b)
  emit_local_get(b, hp_l)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, len_l)
  emit_i64_or(b)
}

/// #538 P4.5: runtime-dispatching `__to_string`, ported from the linear lane's
/// inline call-site handler (compile_call.vibe, #606/#664 heuristics). String
/// interpolation desugars EVERY `\{x}` to `__to_string(x)`; the gc lane used to
/// resolve that to the compiled program's own decimal-only `__to_string(Int)`,
/// so interpolating a String rendered its packed (ptr<<32)|len pointer as a
/// NUMBER — the parser's `"\{acc}, \{name}"` effect-row join produced rows like
/// "127642133069826, 127659312939013" when the gc-compiled compiler ran, and
/// every multi-label `with A + B` declaration stopped authorizing anything.
/// Layout facts: params (val:i64); locals 1=neg 2=cur 3=abs 4=hp 5=len (i64).
///
/// #2405: the string test below is a HEURISTIC on the bit pattern, so an Int
/// whose high word is a plausible address and whose low word keeps `ptr + len`
/// in bounds is misread as a string and returned unchanged -- `64 << 32` reads
/// as (ptr 64, len 0) and rendered as the EMPTY STRING. A caller that already
/// knows the value is an Int must skip this and call `gc_emit_int_to_string`
/// directly; that is what the call-site arm in backend_call.vibe does, mirroring
/// the linear lane's `ts_known_int`.
export fn gc_gen_to_string_body() -> Bytes {
  let b = bytebuf_new()
  emit_block_i64(b)
  // Looks-like-string test: ptr = val >> 32 (unsigned) >= 64, ptr < memsize,
  // ptr + len <= memsize  ->  identity (it IS a string).
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  bytebuf_push(b, 136)
  emit_local_tee(b, 3)
  emit_i64_const(b, 64)
  emit_i64_ge_s(b)
  emit_local_get(b, 3)
  gc_emit_mem_size_bytes(b)
  emit_i64_lt_s(b)
  bytebuf_push(b, 113)
  emit_local_get(b, 3)
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i64_add(b)
  gc_emit_mem_size_bytes(b)
  emit_i64_le_s(b)
  bytebuf_push(b, 113)
  emit_if_void(b)
  emit_local_get(b, 0)
  emit_br(b, 1)
  emit_end(b)
  // #2405: the integer path, shared with the call-site fast path.
  gc_emit_int_to_string(b, 0, 1, 2, 3, 4, 5)
  emit_end(b)
  b
}

/// #997: see the identical guard + rationale on `gen_double_to_int_body` in
/// codegen/builtin_bodies/bodies_core_b.vibe -- `i64.trunc_f64_s` traps on
/// NaN/out-of-range, and this backend doesn't target the
/// nontrapping-float-to-int-conversions proposal either, so NaN and
/// out-of-i64-range doubles saturate to 0 instead of trunc'ing.
export fn gc_gen_double_to_int_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_f64_ne(b)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_else(b)
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_f64_const_lohi(b, 0, 1138753536)
  emit_f64_lt(b)
  emit_if_i64(b)
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_f64_const_lohi(b, 0, 3286237184)
  emit_f64_ge(b)
  emit_if_i64(b)
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_i64_trunc_f64_s(b)
  emit_else(b)
  emit_i64_const(b, 0)
  emit_end(b)
  emit_else(b)
  emit_i64_const(b, 0)
  emit_end(b)
  emit_end(b)
  b
}

export fn gc_gen_int_to_double_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_f64_convert_i64_s(b)
  emit_i64_reinterpret_f64(b)
  b
}
