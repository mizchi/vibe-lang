      else if fname == "StringBuilder::freeze" {
        let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        let empty_idx = str_table_lookup(ctx.str_table.strs, "")
        emit_str_ref(buf, Array::get(ctx.str_table.offsets, empty_idx), Array::get(ctx.str_table.lengths, empty_idx))
        let (join_idx, _, _) = resolve_func(ctx.func_table, "String::join")
        emit_call_resolved(buf, ctx, join_idx)
        nl
      }
      else if fname == "print" || fname == "println" {
        // print(x) = print_str(__to_string(x)); println appends "\n".
        let ts_idx = gc_resolve_builtin_last(ctx.func_table, "__to_string")
        let (ps_idx, _, _) = resolve_func(ctx.func_table, "print_str")
        let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        emit_call_resolved(buf, ctx, ts_idx)
        if fname == "println" {
          let nl_idx = str_table_lookup(ctx.str_table.strs, "\n")
          emit_str_ref(buf, Array::get(ctx.str_table.offsets, nl_idx), Array::get(ctx.str_table.lengths, nl_idx))
          let (cat_idx, _, _) = resolve_func(ctx.func_table, "String::concat")
          emit_call_resolved(buf, ctx, cat_idx)
        } else {
          ()
        }
        emit_call_resolved(buf, ctx, ps_idx)
        emit_i64_const(buf, 0)
        nl
      }
      else if (fname == "assert" || fname == "assert_true") && !gc_name_is_user_defined(ctx, local_names, fname) {
        // Trap (unreachable) on a false condition, like the linear backend.
        // #2300: ...unless the reader defined the name, in which case the
        // call below compiles it as the ordinary function it is.
        let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        emit_i64_eqz(buf)
        emit_if_void(buf)
        bytebuf_push(buf, 0)
        emit_end(buf)
        emit_i64_const(buf, 0)
        nl
      }
      else if fname == "assert_eq" && !gc_name_is_user_defined(ctx, local_names, fname) {
        // Fallback only. The shipped path rewrites `assert_eq` in
        // desugar_trait_dicts -- and when THAT pass stands down for a user's
        // own `assert_eq` (#2283/#2285), this arm must stand down with it,
        // which is what the guard above does (#2300).
        // Keep parity with the linear fallback:
        // synthesized `==` uses the backend's value-aware equality path.
        let nl = ce(buf, EBinOp("==", Array::get(args, 0), Array::get(args, 1)), local_names, next_local, ld)
        emit_i64_eqz(buf)
        emit_if_void(buf)
        bytebuf_push(buf, 0)
        emit_end(buf)
        emit_i64_const(buf, 0)
        nl
      }
      else if fname == "FixedArray::make" || fname == "Int64Array::make" {
        // FixedArray rides on the gc array: make(n, init) = n pushes of init.
        // #835: Int64Array::* is the same alias (Array already stores full
        // tagged Int elements — no separate i64-cell layout needed).
        let (fa_new_idx, _, _) = resolve_func(ctx.func_table, "array_new")
        let (fa_push_idx, _, _) = resolve_func(ctx.func_table, "Array::push")
        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
        let fam_n = nl
        let fam_init = nl + 1
        let fam_arr = nl + 2
        let fam_i = nl + 3
        Array::push(local_names, "[gc-temp]__fam_n")
        Array::push(local_names, "[gc-temp]__fam_init")
        Array::push(local_names, "[gc-temp]__fam_arr")
        Array::push(local_names, "[gc-temp]__fam_i")
        emit_local_set(buf, fam_init)
        emit_local_set(buf, fam_n)
        emit_call_resolved(buf, ctx, fa_new_idx)
        emit_local_set(buf, fam_arr)
        emit_i64_const(buf, 0)
        emit_local_set(buf, fam_i)
        emit_block_void(buf)
        emit_loop_void(buf)
        emit_local_get(buf, fam_i)
        emit_local_get(buf, fam_n)
        emit_i64_ge_s(buf)
        emit_br_if(buf, 1)
        emit_local_get(buf, fam_arr)
        emit_local_get(buf, fam_init)
        emit_call_resolved(buf, ctx, fa_push_idx)
        emit_local_get(buf, fam_i)
        emit_i64_const(buf, 1)
        emit_i64_add(buf)
        emit_local_set(buf, fam_i)
        emit_br(buf, 0)
        emit_end(buf)
        emit_end(buf)
        emit_local_get(buf, fam_arr)
        nl + 4
      }
      else if fname == "FixedArray::length" || fname == "Int64Array::length" {
        let (fa_len_idx, _, _) = resolve_func(ctx.func_table, "Array::length")
        let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        emit_call_resolved(buf, ctx, fa_len_idx)
        nl
      }
      else if fname == "FixedArray::get" || fname == "Int64Array::get" {
        let (fa_get_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
        emit_call_resolved(buf, ctx, fa_get_idx)
        nl
      }
      else if fname == "FixedArray::set" || fname == "FixedArray::unsafe_set" || fname == "Int64Array::set" {
        let (fa_set_idx, _, _) = resolve_func(ctx.func_table, "Array::set")
        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)
        emit_call_resolved(buf, ctx, fa_set_idx)
        emit_i64_const(buf, 0)
        nl
      }
      else if fname == "FixedArray::blit" {
        // blit(dst, dst_off, src, src_off, len): element-by-element copy.
        let (fb_get_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
        let (fb_set_idx, _, _) = resolve_func(ctx.func_table, "Array::set")
        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)
        nl = ce(buf, Array::get(args, 3), local_names, nl, ld)
        nl = ce(buf, Array::get(args, 4), local_names, nl, ld)
        let fb_dst = nl
        let fb_doff = nl + 1
        let fb_src = nl + 2
        let fb_soff = nl + 3
        let fb_len = nl + 4
        let fb_i = nl + 5
        Array::push(local_names, "[gc-temp]__fb_dst")
        Array::push(local_names, "[gc-temp]__fb_doff")
        Array::push(local_names, "[gc-temp]__fb_src")
        Array::push(local_names, "[gc-temp]__fb_soff")
        Array::push(local_names, "[gc-temp]__fb_len")
        Array::push(local_names, "[gc-temp]__fb_i")
        emit_local_set(buf, fb_len)
        emit_local_set(buf, fb_soff)
        emit_local_set(buf, fb_src)
        emit_local_set(buf, fb_doff)
        emit_local_set(buf, fb_dst)
        emit_i64_const(buf, 0)
        emit_local_set(buf, fb_i)
        emit_block_void(buf)
        emit_loop_void(buf)
        emit_local_get(buf, fb_i)
        emit_local_get(buf, fb_len)
        emit_i64_ge_s(buf)
        emit_br_if(buf, 1)
        emit_local_get(buf, fb_dst)
        emit_local_get(buf, fb_doff)
        emit_local_get(buf, fb_i)
        emit_i64_add(buf)
        emit_local_get(buf, fb_src)
        emit_local_get(buf, fb_soff)
        emit_local_get(buf, fb_i)
        emit_i64_add(buf)
        emit_call_resolved(buf, ctx, fb_get_idx)
        emit_call_resolved(buf, ctx, fb_set_idx)
        emit_local_get(buf, fb_i)
        emit_i64_const(buf, 1)
        emit_i64_add(buf)
        emit_local_set(buf, fb_i)
        emit_br(buf, 0)
        emit_end(buf)
        emit_end(buf)
        emit_i64_const(buf, 0)
        nl + 6
      }
      else {
        let fn_len2 = Array::length(ctx.func_table.names)
        let eff_fname = gc_direct_abi_twin_callee(ctx, fname)
        let local_callee_idx = find_local_slot(local_names, fname)
        let mut fn_idx_in_list = -1
        let mut __fi = 0
        // A lexical binding shadows a same-named top-level function. Identifier
        // expressions already use this ordering; calls must do the same (#2160).
        while local_callee_idx < 0 && __fi < fn_len2 {
          if Array::get(ctx.func_table.names, __fi) == eff_fname {
            fn_idx_in_list = __fi
            __fi = fn_len2
          } else {
            __fi = __fi + 1
          }
        }
        if fn_idx_in_list >= 0 {
          let fidx = Array::get(ctx.func_table.indices, fn_idx_in_list)
          let has_ret = Array::get(ctx.func_table.returns, fn_idx_in_list)
          let direct_idx = gc_direct_abi_call_index(ctx, eff_fname)
          let mut nl = next_local
          let mut ci = 0
          while ci < Array::length(args) {
            if direct_idx >= 0 && Array::get(Array::get(ctx.gc_direct_abi_param_refs, direct_idx), ci) {
              nl = gc_compile_native_array_ref(buf, Array::get(args, ci), local_names, nl, ctx, ld, ce)
            } else {
              nl = ce(buf, Array::get(args, ci), local_names, nl, ld)
            }
            ci = ci + 1
          }
          if ctx.func_offset > 0 {
            if fidx >= ctx.func_offset {
              emit_i64_const(buf, 0)
            }
          }
          emit_call(buf, fidx)
          if has_ret == 0 {
            emit_i64_const(buf, 0)
          }
          nl
        } else {
          // An uppercase-initial callee that missed the ctor table is an
          // unknown constructor, not a local closure -- fail with a clear
          // message instead of resolve_local's "undefined variable".
          let c0 = String::char_code_at(fname, 0)
          if local_callee_idx < 0 && c0 >= 65 && c0 <= 90 {
            throw("GC codegen: unknown constructor or function: \{fname}")
          }
          let local_idx2 = if local_callee_idx >= 0 {
            local_callee_idx
          } else {
            resolve_local(local_names, fname, "gc_call")
          }
          let num_args = Array::length(args)
          let fn_val_local = next_local
          let slot_local = next_local + 1
          let env_local = next_local + 2
          let mut nl = next_local + 3
          Array::push(local_names, "[gc-temp]__fn_val")
          Array::push(local_names, "[gc-temp]__slot")
          Array::push(local_names, "[gc-temp]__env")
          emit_local_get(buf, local_idx2)
          // #2012: see the linear compile_call path — boxed `let mut`
          // locals store a cell address.
          if array_contains_str(ctx.ref_cell_names, fname) {
            emit_i32_wrap_i64(buf)
            emit_i64_load(buf, 3, 0)
          } else {
            ()
          }
          emit_local_set(buf, fn_val_local)
          emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
          let mut ci = 0
          while ci < num_args {
            nl = ce(buf, Array::get(args, ci), local_names, nl, ld)
            ci = ci + 1
          }
          emit_closure_call_tail(buf, env_local, slot_local, ctx.closure_type_base, num_args)
          nl
        }
      }
    },
    _ => {
      let num_args = Array::length(args)
      let fn_val_local = next_local
      let slot_local = next_local + 1
      let env_local = next_local + 2
      let mut nl = next_local + 3
      Array::push(local_names, "[gc-temp]__fn_val")
      Array::push(local_names, "[gc-temp]__slot")
      Array::push(local_names, "[gc-temp]__env")
      nl = ce(buf, callee, local_names, nl, ld)
      emit_local_set(buf, fn_val_local)
      emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
      let mut ci = 0
      while ci < num_args {
        nl = ce(buf, Array::get(args, ci), local_names, nl, ld)
        ci = ci + 1
      }
      emit_closure_call_tail(buf, env_local, slot_local, ctx.closure_type_base, num_args)
      nl
    }
  }
}

//# Misc

export {
  compile_call_gc, gc_join_is_native_ref
}
