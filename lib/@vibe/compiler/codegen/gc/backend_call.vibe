        emit_local_get(buf, dst_local)
        emit_local_get(buf, src_local)
        emit_local_get(buf, i_local)
        emit_call_resolved(buf, ctx, ag_idx)
        emit_call_resolved(buf, ctx, ap_idx)
        emit_local_get(buf, i_local)
        emit_i64_const(buf, 1)
        emit_i64_add(buf)
        emit_local_set(buf, i_local)
        emit_br(buf, 0)
        emit_end(buf)
        emit_end(buf)
        emit_i64_const(buf, 0)
        nl
      }
      else if fname == "perform" {
        // #538: performs of host-capability effects (Fs::ReadFile,
        // Profiler::NowUs, ...) lower to their canonical builtin, exactly like
        // the linear backend's builtin fast path. Algebraic (user-effect)
        // performs need the replay-memo machinery and are not ported yet.
        let op_expr = Array::get(args, 0)
        let op_head = if is_eident(op_expr) {
          get_eident_name(op_expr)
        } else if expr_tag(op_expr) == 8 {
          let op_callee = get_ecall_callee(op_expr)
          if is_eident(op_callee) {
            get_eident_name(op_callee)
          } else {
            ""
          }
        } else {
          ""
        }
        // #640: `perform Exception::Throw(x)` IS `throw(x)` — route it to the same
        // wasm exception the EThrow arm emits (tag 0 on the gc backend, see
        // backend_expr.vibe), so a `with Exception` handler catches both spellings.
        if is_exception_throw_operation(op_head) {
          let mut enl = next_local
          if expr_tag(op_expr) == 8 && Array::length(get_ecall_args(op_expr)) > 0 {
            enl = ce(buf, Array::get(get_ecall_args(op_expr), 0), local_names, enl, ld)
          } else {
            emit_i64_const(buf, 0)
          }
          bytebuf_push(buf, 8)
          leb128_encode_u32(buf, 0)
          return enl
        }
        if is_exception_operation_name(op_head) {
          throw(String::concat("perform ", String::concat(op_head, ": the abortive Exception alias has a single operation, Throw (#1279)")))
        }
        let op_canon = canonical_builtin_name(op_head)
        let __pf_len = Array::length(ctx.func_table.names)
        let mut pf_i = -1
        let mut __pf = 0
        while __pf < __pf_len {
          if Array::get(ctx.func_table.names, __pf) == op_canon {
            pf_i = __pf
            __pf = __pf_len
          } else {
            __pf = __pf + 1
          }
        }
        if pf_i < 0 {
          throw(String::concat("GC codegen: unsupported perform (no builtin mapping): ", op_head))
        }
        let pf_idx = Array::get(ctx.func_table.indices, pf_i)
        let pf_ret = Array::get(ctx.func_table.returns, pf_i)
        let op_args = if expr_tag(op_expr) == 8 {
          get_ecall_args(op_expr)
        } else {
          array_empty()
        }
        let mut nl = next_local
        let mut pai = 0
        while pai < Array::length(op_args) {
          nl = ce(buf, Array::get(op_args, pai), local_names, nl, ld)
          pai = pai + 1
        }
        emit_call_resolved(buf, ctx, pf_idx)
        if pf_ret == 0 {
          emit_i64_const(buf, 0)
        }
        nl
      }
      else if fname == "eq" {
        // Content-based equality: i64_eq fast path, then str_eq fallback
        let (str_eq_idx, _, _) = resolve_func(ctx.func_table, "String::equals")
        let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
