//# Functions

/// The storage index of struct field `field`, mirroring the field-access lookup
/// in backend_expr (search the struct-field-name matrix; first struct that
/// declares the field wins). A struct lays its fields out like a constructor —
/// field i at `8 + i*8`, pointer tag-cleared — so the offset is `8 + index*8`,
/// identical to what `obj.field` reads.
fn field_index_in_gc(fnames: Array[String], field: String) -> Int {
  let mut fi = 0
  let mut found = -1
  while fi < Array::length(fnames) {
    if Array::get(fnames, fi) == field {
      found = fi
      fi = Array::length(fnames)
    } else {
      fi = fi + 1
    }
  }
  found
}

/// The index of `field` WITHIN the struct named `sname`. The matched struct name
/// MUST drive the lookup: two structs can share a field name at different
/// positions (`A { x; y }` vs `B { y; x }`), so a name-agnostic scan binds the
/// wrong offset. Falls back to a global first-match scan only when `sname` is
/// absent from the table.
fn struct_field_index_gc(ctx: CompileCtxGc, sname: String, field: String) -> Int with { Error } {
  let names = ctx.gc_ctor_table.struct_names
  let mut si = 0
  let mut sidx = -1
  while si < Array::length(names) {
    if Array::get(names, si) == sname {
      sidx = si
      si = Array::length(names)
    } else {
      si = si + 1
    }
  }
  if sidx >= 0 {
    let found = field_index_in_gc(Array::get(ctx.gc_ctor_table.struct_field_names, sidx), field)
    if found < 0 {
      throw(String::concat(String::concat(String::concat("unknown field `", field), "` in struct "), sname))
    } else {
      found
    }
  } else {
    let mut gsi = 0
    let mut gfound = -1
    while gsi < Array::length(names) {
      let f = field_index_in_gc(Array::get(ctx.gc_ctor_table.struct_field_names, gsi), field)
      if f >= 0 {
        gfound = f
        gsi = Array::length(names)
      } else {
        gsi = gsi + 1
      }
    }
    if gfound < 0 {
      throw(String::concat("unknown struct field in pattern: ", field))
    } else {
      gfound
    }
  }
}

// #538 recursive pattern support. The old cond-arm compiler tested only the
// TOP-LEVEL tag and bound only top-level PBind args: a nested ctor pattern
// (`Node(Leaf(a), r)`) neither narrowed the match (wrong arm taken) nor bound
// its variables ("undefined variable: a"). The helpers below mirror the
// linear backend's #705 short-circuit shape: a test leaves exactly one i32 on
// the stack, nested payload tests run INSIDE `if (result i32)` blocks guarded
// by the parent tag test, and binds recurse through fresh temp locals.

/// Does `pat` constrain the value at all (vs matching anything)?
fn gc_pat_needs_test(p: Pat) -> Bool {
  match p {
    PBind(_) => false,
    PWild => false,
    PTuple(ps) => {
      let mut any = false
      let mut i = 0
      while i < Array::length(ps) {
        if gc_pat_needs_test(Array::get(ps, i)) {
          any = true
        }
        i = i + 1
      }
      any
    },
    PStruct(_, fields) => {
      let mut any = false
      let mut i = 0
      while i < Array::length(fields) {
        let (_, sub) = Array::get(fields, i)
        if gc_pat_needs_test(sub) {
          any = true
        }
        i = i + 1
      }
      any
    },
    _ => true
  }
}

/// Does `pat` bind any variables?
fn gc_pat_has_binds(p: Pat) -> Bool {
  match p {
    PBind(_) => true,
    PCtor(_, args) => {
      let mut any = false
      let mut i = 0
      while i < Array::length(args) {
        if gc_pat_has_binds(Array::get(args, i)) {
          any = true
        }
        i = i + 1
      }
      any
    },
    PTuple(ps) => {
      let mut any = false
      let mut i = 0
      while i < Array::length(ps) {
        if gc_pat_has_binds(Array::get(ps, i)) {
          any = true
        }
        i = i + 1
      }
      any
    },
    PStruct(_, fields) => {
      let mut any = false
      let mut i = 0
      while i < Array::length(fields) {
        let (_, sub) = Array::get(fields, i)
        if gc_pat_has_binds(sub) {
          any = true
        }
        i = i + 1
      }
      any
    },
    POr(l, r) => gc_pat_has_binds(l) || gc_pat_has_binds(r),
    _ => false
  }
}

/// Load ctor payload `idx` of the tagged ctor value in `vloc` into a fresh
/// local (ctor layout: value|1 -> [tag@0][argc@4][payload@8+i*8]).
fn gc_extract_ctor_payload(buf: Bytes, local_names: Array[String], vloc: Int, idx: Int) -> Int {
  let tl = Array::length(local_names)
  emit_local_get(buf, vloc)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i64_load(buf, 3, 8 + idx * 8)
  emit_local_set(buf, tl)
  Array::push(local_names, "__pat_tmp")
  tl
}

/// Load tuple element `idx` of the untagged tuple pointer in `vloc` (tuple
/// layout: raw even pointer, elements at i*8, no header).
fn gc_extract_tuple_elem(buf: Bytes, local_names: Array[String], vloc: Int, idx: Int) -> Int {
  let tl = Array::length(local_names)
  emit_local_get(buf, vloc)
  emit_i32_wrap_i64(buf)
  emit_i64_load(buf, 3, idx * 8)
  emit_local_set(buf, tl)
  Array::push(local_names, "__pat_tmp")
  tl
}

/// Emit the truth test for `pat` against the value in `vloc`: pushes exactly
/// one i32 (1 = matched). Sub-tests short-circuit behind the parent test via
/// `if (result i32)` (bytes 4, 127) so payload loads never run on a value of
/// the wrong shape.
fn emit_gc_pat_test(buf: Bytes, local_names: Array[String], vloc: Int, pat: Pat, ctx: CompileCtxGc) -> Unit with { Error } {
  match pat {
    PInt(n) => {
      emit_local_get(buf, vloc)
      emit_i64_const(buf, n)
      emit_i64_eq(buf)
    },
    PFloat(fv) => {
      // gc lane holds raw f64 bits in i64 locals; f64.eq gives `==` semantics.
      emit_local_get(buf, vloc)
      emit_f64_reinterpret_i64(buf)
      emit_f64_const_lohi(buf, Double::to_i64_bits_lo(fv), Double::to_i64_bits_hi(fv))
      emit_f64_eq(buf)
    },
    PBool(bv) => {
      emit_local_get(buf, vloc)
      emit_i64_const(buf, if bv {
        1
      } else {
        0
      })
      emit_i64_eq(buf)
    },
    PString(sval) => {
      let str_idx = str_table_lookup(ctx.str_table.strs, sval)
      if str_idx >= 0 {
        let (streq_idx, _, _) = resolve_func(ctx.func_table, "String::equals")
        emit_local_get(buf, vloc)
        emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))
        // A user-shadowed String::equals would need a trailing env; the
        // builtin does not (idx < func_offset).
        if ctx.func_offset > 0 && streq_idx >= ctx.func_offset {
          emit_i64_const(buf, 0)
        } else {
          ()
        }
        emit_call(buf, streq_idx)
        emit_i64_const(buf, 1)
        emit_i64_eq(buf)
      } else {
        emit_i32_const(buf, 0)
      }
    },
    PBind(_) => emit_i32_const(buf, 1),
    PWild => emit_i32_const(buf, 1),
    POr(l, r) => {
      emit_gc_pat_test(buf, local_names, vloc, l, ctx)
      bytebuf_push(buf, 4)
      bytebuf_push(buf, 127)
      emit_i32_const(buf, 1)
      emit_else(buf)
      emit_gc_pat_test(buf, local_names, vloc, r, ctx)
      emit_end(buf)
    },
    PCtor(cname, cargs) => {
      let ctor_ci = ctor_table_index_of(ctx.gc_ctor_table, cname)
      let expected_tag = if ctor_ci >= 0 {
        Array::get(ctx.gc_ctor_table.tags, ctor_ci)
      } else {
        -1
      }
      emit_local_get(buf, vloc)
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_i32_load(buf, 2, 0)
      emit_i32_const(buf, expected_tag)
      emit_i32_eq(buf)
      let mut any_sub = false
      let mut ci = 0
      while ci < Array::length(cargs) {
        if gc_pat_needs_test(Array::get(cargs, ci)) {
          any_sub = true
        }
        ci = ci + 1
      }
      if any_sub {
        bytebuf_push(buf, 4)
        bytebuf_push(buf, 127)
        emit_i32_const(buf, 1)
        let mut si = 0
        while si < Array::length(cargs) {
          let sub = Array::get(cargs, si)
          if gc_pat_needs_test(sub) {
            bytebuf_push(buf, 4)
            bytebuf_push(buf, 127)
            let tl = gc_extract_ctor_payload(buf, local_names, vloc, si)
            emit_gc_pat_test(buf, local_names, tl, sub, ctx)
            emit_else(buf)
            emit_i32_const(buf, 0)
            emit_end(buf)
          } else {
            ()
          }
          si = si + 1
        }
        emit_else(buf)
        emit_i32_const(buf, 0)
        emit_end(buf)
      } else {
        ()
      }
    },
    PTuple(ps) => {
      emit_i32_const(buf, 1)
      let mut ti = 0
      while ti < Array::length(ps) {
        let sub = Array::get(ps, ti)
        if gc_pat_needs_test(sub) {
          bytebuf_push(buf, 4)
          bytebuf_push(buf, 127)
          let tl = gc_extract_tuple_elem(buf, local_names, vloc, ti)
          emit_gc_pat_test(buf, local_names, tl, sub, ctx)
          emit_else(buf)
          emit_i32_const(buf, 0)
          emit_end(buf)
        } else {
          ()
        }
        ti = ti + 1
      }
    },
    PStruct(sname, fields) => {
      emit_i32_const(buf, 1)
      let mut fi = 0
      while fi < Array::length(fields) {
        let (fname, sub) = Array::get(fields, fi)
        if gc_pat_needs_test(sub) {
          bytebuf_push(buf, 4)
          bytebuf_push(buf, 127)
          let off_idx = struct_field_index_gc(ctx, sname, fname)
          let tl = gc_extract_ctor_payload(buf, local_names, vloc, off_idx)
          emit_gc_pat_test(buf, local_names, tl, sub, ctx)
          emit_else(buf)
          emit_i32_const(buf, 0)
          emit_end(buf)
        } else {
          ()
        }
        fi = fi + 1
      }
    }
  }
}

/// Bind every variable under `pat` from the value in `vloc` (recursing through
/// payload extraction). Or-patterns that bind are rejected: the two sides may
/// bind from different shapes and this backend has no phi for that yet.
fn emit_gc_pat_binds(buf: Bytes, local_names: Array[String], vloc: Int, pat: Pat, ctx: CompileCtxGc) -> Unit with { Error } {
  match pat {
    PBind(name) => {
      let bl = Array::length(local_names)
      emit_local_get(buf, vloc)
      emit_local_set(buf, bl)
      Array::push(local_names, name)
    },
    PCtor(_, cargs) => {
      let mut i = 0
      while i < Array::length(cargs) {
        let sub = Array::get(cargs, i)
        if gc_pat_has_binds(sub) {
          let tl = gc_extract_ctor_payload(buf, local_names, vloc, i)
          emit_gc_pat_binds(buf, local_names, tl, sub, ctx)
        } else {
          ()
        }
        i = i + 1
      }
    },
    PTuple(ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        let sub = Array::get(ps, i)
        if gc_pat_has_binds(sub) {
          let tl = gc_extract_tuple_elem(buf, local_names, vloc, i)
          emit_gc_pat_binds(buf, local_names, tl, sub, ctx)
        } else {
          ()
        }
        i = i + 1
      }
    },
    PStruct(sname, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, sub) = Array::get(fields, i)
        if gc_pat_has_binds(sub) {
          let off_idx = struct_field_index_gc(ctx, sname, fname)
          let tl = gc_extract_ctor_payload(buf, local_names, vloc, off_idx)
          emit_gc_pat_binds(buf, local_names, tl, sub, ctx)
        } else {
          ()
        }
        i = i + 1
      }
    },
    POr(l, r) => {
      if gc_pat_has_binds(l) || gc_pat_has_binds(r) {
        throw("GC codegen: or-pattern with variable binds is unsupported")
      } else {
        ()
      }
    },
    _ => ()
  }
}

fn compile_match_gc(buf: Bytes, scrutinee: Expr, arms: Array[(Pat, Expr)], local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } {
  let scrut_local = next_local
  Array::push(local_names, "__match_scrut")
  let nl1 = ce(buf, scrutinee, local_names, next_local + 1, ld)
  emit_local_set(buf, scrut_local)
  let num_arms = Array::length(arms)
  let catchall_idx = find_catchall_idx(arms)
  let num_cond_arms = catchall_idx
  let mut max_nl = nl1
  // Match arms are sibling control-flow scopes. Their locals may have
  // different Wasm value types (notably native array refs versus i64), so
  // allocate each arm after the previous arm's high-water mark rather than
  // reusing the same lexical slots.
  let mut next_arm_local = Array::length(local_names)
  let mut ai = 0
  while ai < num_cond_arms {
    while Array::length(local_names) < next_arm_local {
      Array::push(local_names, "")
    }
    let names_len_at_arm = Array::length(local_names)
    let (p, arm_body) = Array::get(arms, ai)
    let ld_arm = if ld >= 0 {
      ld + ai + 1
    } else {
      -1
    }
    // Recursive test (nested payload sub-tests narrow the arm correctly)...
    emit_gc_pat_test(buf, local_names, scrut_local, p, ctx)
    emit_if_i64(buf)
    // ...then recursive binds (nested PBinds included).
    emit_gc_pat_binds(buf, local_names, scrut_local, p, ctx)
    let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)
    if arm_nl > max_nl {
      max_nl = arm_nl
    }
    if Array::length(local_names) > max_nl {
      max_nl = Array::length(local_names)
    }
    next_arm_local = max_nl
    emit_else(buf)
    Array::truncate(local_names, names_len_at_arm)
    agg_log_reset_above(ctx.gc_agg_local_slots, names_len_at_arm)
    gc_slot_log_reset_above(ctx.gc_bool_locals, names_len_at_arm)
    gc_slot_log_reset_above(ctx.gc_float_locals, names_len_at_arm)
    gc_slot_log_reset_above(ctx.gc_native_array_locals, names_len_at_arm)
    ai = ai + 1
  }
  let ld_catch = if ld >= 0 {
    ld + num_cond_arms
  } else {
    -1
  }
  while Array::length(local_names) < next_arm_local {
    Array::push(local_names, "")
  }
  let _names_len_at_catch = Array::length(local_names)
  if catchall_idx < num_arms {
    let (cp, cbody) = Array::get(arms, catchall_idx)
    // Catch-all arm: recursive binds handle PBind / PCtor / PTuple / PStruct
    // uniformly, including nested payload binds (and fix the old tuple-bind
    // offset bug: tuples have no header, elements sit at i*8).
    emit_gc_pat_binds(buf, local_names, scrut_local, cp, ctx)
    let catch_nl = ce(buf, cbody, local_names, Array::length(local_names), ld_catch)
    if catch_nl > max_nl {
      max_nl = catch_nl
    }
    0
  } else {
    bytebuf_push(buf, 0)
    0
  }
  let mut ci2 = 0
  while ci2 < num_cond_arms {
    emit_end(buf)
    ci2 = ci2 + 1
  }
  while Array::length(local_names) < max_nl {
    Array::push(local_names, "")
  }
  max_nl
}

//# Misc

export {
  compile_match_gc
}
