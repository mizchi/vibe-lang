//# Functions

export fn gc_gen_arr_len_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)
  emit_i64_extend_i32_u(b)
  b
}

export fn gc_gen_arr_new_body() -> Bytes {
  let b = bytebuf_new()
  emit_global_get(b, 0)
  emit_local_tee(b, 0)
  emit_i32_const(b, 76)
  emit_i32_add(b)
  emit_global_set(b, 0)
  // #415: gc-lane heap bump must grow linear memory like the linear
  // backend does -- without this any allocation past the initial page
  // traps OOB (the gc smoke fixture only ever allocated a few bytes).
  emit_heap_memory_grow_check(b)
  emit_local_get(b, 0)
  emit_i32_const(b, 8)
  emit_i32_store(b, 2, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 0)
  emit_i32_store(b, 2, 4)
  emit_local_get(b, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_i32_store(b, 2, 8)
  emit_local_get(b, 0)
  emit_i64_extend_i32_u(b)
  b
}

// #538: real function bodies for Array::slice/concat/truncate/push_all. They
// previously carried the placeholder table index (= arr_new), so any lookup
// through the func table (e.g. the __slice container dispatch) called a
// 0-arg allocator with values still on the stack -- invalid wasm. Built on
// arr_new/arr_get/arr_push calls so they stay layout-agnostic.

// (arr, start, end) -> new array of arr[start..end)
export fn gc_gen_arr_slice_body(arr_new_idx: Int, arr_get_idx: Int, arr_push_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_call(b, arr_new_idx)
  emit_local_set(b, 3)
  emit_local_get(b, 1)
  emit_local_set(b, 4)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_local_get(b, 2)
  emit_i64_ge_s(b)
  emit_br_if(b, 1)
  emit_local_get(b, 3)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_call(b, arr_get_idx)
  emit_call(b, arr_push_idx)
  emit_local_get(b, 4)
  emit_i64_const(b, 1)
  emit_i64_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 3)
  b
}

// (a, b) -> new array of a's elements then b's
export fn gc_gen_arr_concat_body(arr_new_idx: Int, arr_len_idx: Int, arr_get_idx: Int, arr_push_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_call(b, arr_new_idx)
  emit_local_set(b, 2)
  emit_i64_const(b, 0)
  emit_local_set(b, 3)
  emit_local_get(b, 0)
  emit_call(b, arr_len_idx)
  emit_local_set(b, 4)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 4)
  emit_i64_ge_s(b)
  emit_br_if(b, 1)
  emit_local_get(b, 2)
  emit_local_get(b, 0)
  emit_local_get(b, 3)
  emit_call(b, arr_get_idx)
  emit_call(b, arr_push_idx)
  emit_local_get(b, 3)
  emit_i64_const(b, 1)
  emit_i64_add(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_i64_const(b, 0)
  emit_local_set(b, 3)
  emit_local_get(b, 1)
  emit_call(b, arr_len_idx)
  emit_local_set(b, 4)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 4)
  emit_i64_ge_s(b)
  emit_br_if(b, 1)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_local_get(b, 3)
  emit_call(b, arr_get_idx)
  emit_call(b, arr_push_idx)
  emit_local_get(b, 3)
  emit_i64_const(b, 1)
  emit_i64_add(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 2)
  b
}

// (arr, n): shrink in place (len@4 of the gc array header)
export fn gc_gen_arr_truncate_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_store(b, 2, 4)
  b
}

// (dst, src): append all of src to dst
export fn gc_gen_arr_push_all_body(arr_len_idx: Int, arr_get_idx: Int, arr_push_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_i64_const(b, 0)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, arr_len_idx)
  emit_local_set(b, 3)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i64_ge_s(b)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 1)
  emit_local_get(b, 2)
  emit_call(b, arr_get_idx)
  emit_call(b, arr_push_idx)
  emit_local_get(b, 2)
  emit_i64_const(b, 1)
  emit_i64_add(b)
  emit_local_set(b, 2)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  b
}
