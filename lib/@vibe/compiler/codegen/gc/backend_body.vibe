//# Functions

/// Unit entry values have no observable result. Keep this in sync with the
/// linear WASI entry policy so `fn main {}` does not print its tagged zero.
fn gc_type_expr_is_unit(t: TypeExpr) -> Bool {
  match t {
    TyUnit => true,
    TyName(name) => name == "Unit",
    _ => false
  }
}

/// #1541 deliberately starts with the single element representation already
/// implemented by `$native_i64_array`. Nested arrays and erased/generic
/// element names stay on the tagged-i64 ABI until an explicit conversion
/// exists; guessing here would create an untraceable reference in an i64 cell.
fn gc_direct_abi_is_native_array_type(t: TypeExpr) -> Bool {
  match t {
    TyApp(name, args) => name == "Array" && Array::length(args) == 1 && (match Array::get(args, 0) {
      TyName(elem) => elem == "Int",
      _ => false
    }),
    _ => false
  }
}

fn gc_direct_abi_type_mentions_array(t: TypeExpr) -> Bool {
  match t {
    TyApp(name, args) => {
      let mut found = name == "Array"
      let mut i = 0
      while i < Array::length(args) {
        if gc_direct_abi_type_mentions_array(Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyFn(params, ret, _) => {
      let mut found = gc_direct_abi_type_mentions_array(ret)
      let mut i = 0
      while i < Array::length(params) {
        if gc_direct_abi_type_mentions_array(Array::get(params, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

fn gc_direct_abi_name_index(names: Array[String], name: String) -> Int {
  let mut i = 0
  let mut found = -1
  while i < Array::length(names) {
    if found < 0 && Array::get(names, i) == name {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn gc_direct_abi_name_in(names: Array[String], name: String) -> Bool {
  gc_direct_abi_name_index(names, name) >= 0
}

/// Static representation proof used before emitting any typed function type.
/// Result: -1 = unsupported crossing, 0 = tagged i64, 1 = native array ref.
/// Once a module has a candidate reference signature, an array literal bound
/// by `let` is analyzed in that same lane. Any unsupported use rejects the
/// complete module evidence table; codegen then retries the whole component
/// through its pre-existing tagged-i64 ABI. There is no mixed partial island.
fn gc_direct_abi_expr_kind(expr: Expr, native_names: Array[String], abi_names: Array[String], abi_param_refs: Array[Array[Bool]], abi_return_refs: Array[Bool]) -> Int {
  match expr {
    EIdent(name, _) => if gc_direct_abi_name_in(native_names, name) {
      1
    } else if gc_direct_abi_name_in(abi_names, name) {
      // A typed function used as a value would enter the universal closure
      // table. #1541 has no typed call_indirect lane, so reject the module.
      -1
    } else {
      0
    },
    EArray(elems) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(elems) {
        if gc_direct_abi_expr_kind(Array::get(elems, i), native_names, abi_names, abi_param_refs, abi_return_refs) != 0 {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      if ok {
        1
      } else {
        -1
      }
    },
    ELet(name, value, body, _) => match value {
      EArray(_) => {
        let floor = Array::length(native_names)
        Array::push(native_names, name)
        let native_body = gc_direct_abi_expr_kind(body, native_names, abi_names, abi_param_refs, abi_return_refs)
        Array::truncate(native_names, floor)
        native_body
      },
      _ => {
        let value_kind = gc_direct_abi_expr_kind(value, native_names, abi_names, abi_param_refs, abi_return_refs)
        if value_kind < 0 {
          -1
        } else if value_kind == 1 {
          let floor = Array::length(native_names)
          Array::push(native_names, name)
          let body_kind = gc_direct_abi_expr_kind(body, native_names, abi_names, abi_param_refs, abi_return_refs)
          Array::truncate(native_names, floor)
          body_kind
        } else {
          gc_direct_abi_expr_kind(body, native_names, abi_names, abi_param_refs, abi_return_refs)
        }
      }
    },
    ECall(callee, args, _) => match callee {
      EIdent(fname, _) => {
        let abi_idx = gc_direct_abi_name_index(abi_names, fname)
        if abi_idx >= 0 {
          let refs = Array::get(abi_param_refs, abi_idx)
          if Array::length(refs) != Array::length(args) {
            -1
          } else {
            let mut ok = true
            let mut i = 0
            while i < Array::length(args) {
              let kind = gc_direct_abi_expr_kind(Array::get(args, i), native_names, abi_names, abi_param_refs, abi_return_refs)
              if kind < 0 || (Array::get(refs, i) && kind != 1) || (!Array::get(refs, i) && kind != 0) {
                ok = false
              } else {
                ()
              }
              i = i + 1
            }
            if ok {
              if Array::get(abi_return_refs, abi_idx) {
                1
              } else {
                0
              }
            } else {
              -1
            }
          }
        } else {
          let native_array_op = (fname == "Array::length" && Array::length(args) == 1) || (fname == "Array::get" && Array::length(args) == 2) || (fname == "Array::set" && Array::length(args) == 3)
          let mut saw_native = false
          let mut ok = true
          let mut i = 0
          while i < Array::length(args) {
            let kind = gc_direct_abi_expr_kind(Array::get(args, i), native_names, abi_names, abi_param_refs, abi_return_refs)
            if kind < 0 {
              ok = false
            } else if kind == 1 {
              if i == 0 && native_array_op {
                saw_native = true
              } else {
                ok = false
              }
            } else {
              ()
            }
            i = i + 1
          }
          if ok {
            // Native Array length/get/set all produce an i64/Unit result.
            let _ = saw_native
            0
          } else {
            -1
          }
        }
      },
      _ => {
        let callee_kind = gc_direct_abi_expr_kind(callee, native_names, abi_names, abi_param_refs, abi_return_refs)
        let mut ok = callee_kind == 0
        let mut i = 0
        while i < Array::length(args) {
          if gc_direct_abi_expr_kind(Array::get(args, i), native_names, abi_names, abi_param_refs, abi_return_refs) != 0 {
            ok = false
          } else {
            ()
          }
          i = i + 1
        }
        if ok {
          0
        } else {
          -1
        }
      }
    },
    EReturn(value) => gc_direct_abi_expr_kind(value, native_names, abi_names, abi_param_refs, abi_return_refs),
    _ => {
      let children = expr_children(expr)
      let mut ok = true
      let mut i = 0
      while i < Array::length(children) {
        if gc_direct_abi_expr_kind(Array::get(children, i), native_names, abi_names, abi_param_refs, abi_return_refs) != 0 {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      if ok {
        0
      } else {
        -1
      }
    }
  }
}

fn gc_direct_abi_expr_mentions_name(expr: Expr, names: Array[String]) -> Bool {
  match expr {
    EIdent(name, _) => gc_direct_abi_name_in(names, name),
    _ => {
      let children = expr_children(expr)
      let mut found = false
      let mut i = 0
      while i < Array::length(children) {
        if gc_direct_abi_expr_mentions_name(Array::get(children, i), names) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    }
  }
}

fn emit_gc_direct_func_type(buf: Bytes, param_refs: Array[Bool], return_ref: Bool, native_array_type_idx: Int) -> Unit {
  bytebuf_push(buf, 96)
  // User functions always carry the hidden closure environment parameter.
  leb128_encode_u32(buf, Array::length(param_refs) + 1)
  let mut i = 0
  while i < Array::length(param_refs) {
    if Array::get(param_refs, i) {
      bytebuf_push(buf, 99)
      leb128_encode_u32(buf, native_array_type_idx)
    } else {
      bytebuf_push(buf, 126)
    }
    i = i + 1
  }
  bytebuf_push(buf, 126)
  leb128_encode_u32(buf, 1)
  if return_ref {
    bytebuf_push(buf, 99)
    leb128_encode_u32(buf, native_array_type_idx)
  } else {
    bytebuf_push(buf, 126)
  }
}

/// #805 (ADR-0072): inline wasm (`fn f(..) -> Int = wasm "..."`, carried as
/// the parser-internal `%wasm("<WAT>")` marker body) is LINEAR-BACKEND ONLY —
/// the WAT text is written against the linear backend's raw 62-bit tagged i64
/// ABI, which the wasm-gc backend does not share. Reject loudly instead of
/// letting the marker fall through to an opaque unknown-function error.
fn gc_reject_inline_wasm(stmts: Array[Stmt]) -> Unit with Exception {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, iw_name, _, iw_expr) => match iw_expr {
        EFn(_, _, _, _, _, iw_body) => match iw_body {
          ECall(iw_cal, iw_args, _) => match iw_cal {
            EIdent(iw_cn, _) => if iw_cn == "%wasm" && Array::length(iw_args) == 1 {
              throw("inline wasm fn '\{iw_name}' (= wasm \"...\") is linear-backend only; the wasm-gc backend does not support it (#805)")
            } else {
              ()
            },
            _ => ()
          },
          _ => ()
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

/// #1015: does this program's own top-level `to_string` (if it has one)
/// structurally match the Show-bounded generic forwarding wrapper
/// `to_string[T: Show](x: T) -> String { __to_string(x) }` -- exactly ONE
/// type param bounded by "Show", exactly one param whose annotation IS that
/// type param, and a body that's nothing but `__to_string(<that param>)`?
///
/// This gates backend_call.vibe's "to_string" call-site fast path (bypassing
/// the wrapper call and inlining `__to_string(arg)` directly with the
/// original, statically classifiable argument expression). Code review
/// (#1015) correctly flagged that the gc lane's single-file compile model
/// rules out CROSS-file shadowing (mangled-name matching, as the linear lane
/// does, is unnecessary here) but NOT a SAME-file user function of the same
/// name: `fn to_string(x: Bool) -> String { "custom" }` is a real, different
/// function that must keep running when called, not be silently replaced by
/// the Bool/Float formatter. That user function fails this structural check
/// (no type params, a concrete Bool param, a body that isn't a bare
/// `__to_string` forward) and so is correctly left alone; only a body that
/// is ACTUALLY just forwarding to `__to_string` -- which can only ever
/// render the same "true"/"false"/digits output the fast path itself
/// produces -- passes.
///
/// MUST be called on `stmts` BEFORE strip_generic_type_params runs (see
/// entry/source_compile/wasi_only/preprocess_strip.vibe): that pass
/// unconditionally zeroes EVERY top-level generic fn's type_params AND
/// bounds arrays (an erasure step, not specific to `to_string`), so by the
/// time compile_wasi_module_gc's own stmts are inspected, `to_string[T:
/// Show]`'s `type_params`/`bounds` are already `[]` and this check would
/// always see 0 type params -- always returning false, permanently
/// disabling the fast path (found via throw()-based instrumentation: the
/// first version of this check ran too late, inside compile_wasi_module_gc,
/// and never once returned true even for the genuine wrapper). Exported so
/// entry/source_compile/gc_only/gc_only.vibe (and the two other real
/// callers of compile_wasi_module_gc -- _cli_gc_entry.vibe,
/// tests/codegen_test_support.vibe, neither of which strip at all) can call
/// it on their own pre-strip `stmts` and pass the result in.
export fn gc_to_string_resolves_to_show_wrapper(stmts: Array[Stmt]) -> Bool {
  let mut i = 0
  let mut found = false
  let mut found_value = EUnit
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, tsw_name, _, tsw_value) => if tsw_name == "to_string" {
        found = true
        found_value = tsw_value
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  if found {
    gc_efn_is_show_to_string_wrapper(found_value)
  } else {
    false
  }
}

fn gc_efn_is_show_to_string_wrapper(value: Expr) -> Bool {
  match value {
    EFn(tsw_tparams, tsw_bounds, tsw_params, _, _, tsw_body) => if Array::length(tsw_tparams) == 1 && Array::length(tsw_params) == 1 {
      let tsw_tparam = Array::get(tsw_tparams, 0)
      let (tsw_pname, tsw_pty) = Array::get(tsw_params, 0)
      let tsw_ty_matches = match tsw_pty {
        Some(TyName(tsw_ptn)) => tsw_ptn == tsw_tparam,
        _ => false
      }
      tsw_ty_matches && gc_bounds_has_show(tsw_bounds, tsw_tparam) && gc_body_is_to_string_forward(tsw_body, tsw_pname)
    } else {
      false
    },
    _ => false
  }
}

fn gc_bounds_has_show(bounds: Array[(String, Array[String])], tparam: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(bounds) {
    let (bname, btraits) = Array::get(bounds, i)
    if bname == tparam {
      let mut j = 0
      while j < Array::length(btraits) {
        if Array::get(btraits, j) == "Show" {
          found = true
        } else {
          ()
        }
        j = j + 1
      }
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Is `body` exactly `__to_string(<pname>)` -- a bare one-arg forward of the
/// wrapper's own sole param to the `__to_string` builtin, nothing else?
fn gc_body_is_to_string_forward(body: Expr, pname: String) -> Bool {
  match body {
    ECall(tsf_callee, tsf_args, _) => match tsf_callee {
      EIdent(tsf_cn, _) => tsf_cn == "__to_string" && Array::length(tsf_args) == 1 && (match Array::get(tsf_args, 0) {
        EIdent(tsf_an, _) => tsf_an == pname,
        _ => false
      }),
      _ => false
    },
    _ => false
  }
}

/// Preserve the one pre-erasure fact the direct Array ABI must consume.
/// `strip_generic_type_params` deliberately removes every EFn binder, so the
/// gc-only source pipeline collects the generic declaration NAMES before
/// stripping and passes them into codegen. Post-strip an erased signature is
/// indistinguishable from a monomorphic one, so without this list a generic
/// `fn f[T](values: Array[Int], marker: T)` would be handed a typed
/// `(ref null $array)` parameter it cannot honor.
///
/// This used to be a single Bool ("no generic declaration anywhere"), which
/// disabled the island for every component containing any generic at all --
/// in practice, all real code. Carrying the names instead keeps exactly the
/// same rejection for generic declarations while letting a generic that never
/// touches a reference-lane value coexist with the island: it simply is not a
/// candidate, and any attempt to pass a reference into it is still rejected
/// component-wide by `gc_direct_abi_expr_kind`.
export fn gc_direct_abi_pre_erasure_generic_names(stmts: Array[Stmt]) -> Array[String] {
  let names = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, EFn(type_params, _, _, _, _, _)) => if Array::length(type_params) > 0 {
        Array::push(names, name)
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  names
}

/// Names intercepted by spelling before ordinary func-table dispatch in
/// backend_call.vibe. A user declaration with any of these spellings makes
/// typed user signatures unsafe: the call site can otherwise take a builtin
/// path while the body/type sections describe a `(ref null array)` user ABI.
/// Keep this list in sync with the `fname == ...` dispatch chain there.
fn gc_direct_abi_name_has_spelling_lowering(name: String) -> Bool {
  name == "Array::length" || name == "Array::get" || name == "Array::set" ||
  name == "Stdin::read_via_stream" || name == "StdinStream::next" || name == "StdinStream::close" || name == "StdinStream::read_chunk" ||
  name == "__slice" || name == "__index" || name == "__set_field" || name == "__rec_field" || name == "__len" ||
  name == "Array::slice" || name == "Array::concat" || name == "Array::truncate" || name == "Array::push_all" ||
  name == "perform" || name == "eq" || name == "not" ||
  name == "Double::from_i64_bits" || name == "Double::to_i64_bits_lo" || name == "Double::to_i64_bits_hi" ||
  name == "__to_string" || name == "to_string" || name == "Int::to_string" ||
  name == "MapBuilder::new" || name == "MapBuilder::set" || name == "MapBuilder::freeze" || name == "MapBuilder::has_key" || name == "MapBuilder::get" ||
  name == "Map::set" || name == "Map::get" || name == "Map::has_key" || name == "map_has" || name == "Map::keys" ||
  name == "StringBuilder::new" || name == "StringBuilder::push" || name == "StringBuilder::freeze" ||
  name == "print" || name == "println" || name == "assert" || name == "assert_true" || name == "assert_eq" ||
  name == "FixedArray::make" || name == "Int64Array::make" || name == "FixedArray::length" || name == "Int64Array::length" ||
  name == "FixedArray::get" || name == "Int64Array::get" || name == "FixedArray::set" || name == "FixedArray::unsafe_set" || name == "Int64Array::set" || name == "FixedArray::blit" ||
  name == "v128_load" || name == "v128_store" || name == "v128_splat_i8x16" || name == "v128_eq_i8x16" || name == "v128_le_u_i8x16" || name == "v128_ge_u_i8x16" ||
  name == "v128_and" || name == "v128_or" || name == "v128_not" || name == "v128_bitmask_i8x16" || name == "v128_any_true" || name == "v128_all_true_i8x16"
}

fn gc_direct_abi_name_is_exported(stmts: Array[Stmt], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exported, _, stmt_name, _, _) => if exported && stmt_name == name {
        found = true
      } else {
        ()
      },
      SExport(names) => {
        let mut j = 0
        while j < Array::length(names) {
          if Array::get(names, j) == name {
            found = true
          } else {
            ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

export fn compile_wasi_module_gc(stmts: Array[Stmt], entry_name: String, gc_to_string_is_wrapper: Bool, direct_abi_generic_names: Array[String]) -> Bytes with Exception {
  // #805: inline-wasm fns are linear-backend only — reject before any work.
  gc_reject_inline_wasm(stmts)
  // #1015: `gc_to_string_is_wrapper` is a PARAMETER, not computed here --
  // see the doc comment on gc_to_string_resolves_to_show_wrapper (which
  // MUST run before strip_generic_type_params, and this function's own
  // `stmts` have typically already been stripped by the time callers reach
  // here).
  // Top-level `let f = g` function aliases: retarget references to the final
  // EFn def so calls do not route through a 0-param thunk registration
  // (invalid wasm for any call arity). See import_alias_rewrite.vibe.
  rewrite_top_level_fn_alias_refs(stmts)
  // #tco: see codegen/common_base/self_tail_call.vibe's doc comment (same
  // rewrite as the linear backend's call site in codegen/wasi/linked_compile.vibe).
  rewrite_self_tail_calls(stmts)
  // ADR-0076 Phase 2/3 (#817), 段階導入計画 step 6: same evidence-dict AST
  // rewrite as the linear backend's call site in
  // codegen/wasi/linked_compile.vibe -- both passes only ever rewrite
  // EHandle/perform into ordinary ERecord/EFn/EDot/ECall nodes (a plain
  // closure-record dict threaded as an extra parameter), never touching
  // linear-memory pointers/offsets, so the rewritten AST is exactly as
  // backend-agnostic as any other desugaring here. A handle/perform this
  // pass cannot prove eligible (row-polymorphic helper, non-tail-resumptive
  // arm, etc.) is left untouched and still hits backend_expr.vibe's/
  // backend_call.vibe's existing "only `with Exception`/known builtins"
  // fallback exactly as before -- this only shrinks what falls through to
  // that fallback, it does not change the fallback itself. No-op on
  // programs with no eligible handle (identical to the linear backend's
  // unconditional call site), so this is strictly additive for gc codegen.
  inline_direct_performs(stmts)
  let edp_errs = evidence_dict_pass(stmts, entry_name)
  if Array::length(edp_errs) > 0 {
    throw(Array::get(edp_errs, 0))
  } else {
    ()
  }
  let fn_names_list = array_empty()
  let fn_param_counts = array_empty()
  let fn_needs_env_list = array_empty()
  let user_func_stmts = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SLet(_, _, name, _, expr) => match expr {
        EFn(_, _, params, _, _, _) => {
          Array::push(fn_names_list, name)
          Array::push(fn_param_counts, Array::length(params))
          Array::push(fn_needs_env_list, true)
          Array::push(user_func_stmts, stmt)
          0
        },
        _ => 0
      }
      ,
      _ => 0
    }
    i = i + 1
  }
  // #1541: derive one conservative module-wide ABI decision before emitting
  // any body or type. Any unsupported Array signature/use clears the complete
  // table, leaving the pre-existing tagged-i64 backend byte-for-byte in charge
  // of user function boundaries. Partial evidence is never consumed.
  let gc_direct_abi_names_l = array_empty()
  let gc_direct_abi_param_refs_l = array_empty()
  let gc_direct_abi_return_refs_l = array_empty()
  let mut gc_direct_abi_ok = true
  let mut dai = 0
  while dai < Array::length(user_func_stmts) {
    match Array::get(user_func_stmts, dai) {
      SLet(_, _, dai_name, dai_ann, dai_value) => match dai_value {
        EFn(dai_tparams, _, dai_params, dai_ret_ann, _, _) => {
          let param_refs = array_empty()
          let sig_params = match dai_ann {
            Some(TyFn(ps, _, _)) => if Array::length(ps) == Array::length(dai_params) {
              Some(ps)
            } else {
              None
            },
            _ => None
          }
          let mut has_ref = false
          let mut pi = 0
          while pi < Array::length(dai_params) {
            let pty = match sig_params {
              Some(ps) => Some(Array::get(ps, pi)),
              None => {
                let (_, own_ann) = Array::get(dai_params, pi)
                own_ann
              }
            }
            let is_ref = match pty {
              Some(t) => gc_direct_abi_is_native_array_type(t),
              None => false
            }
            match pty {
              Some(t) => if gc_direct_abi_type_mentions_array(t) && !is_ref {
                gc_direct_abi_ok = false
              } else {
                ()
              },
              None => ()
            }
            Array::push(param_refs, is_ref)
            if is_ref {
              has_ref = true
            } else {
              ()
            }
            pi = pi + 1
          }
          let ret_ty = match dai_ann {
            Some(TyFn(_, ret, _)) => Some(ret),
            _ => dai_ret_ann
          }
          let return_ref = match ret_ty {
            Some(t) => gc_direct_abi_is_native_array_type(t),
            None => false
          }
          match ret_ty {
            Some(t) => if gc_direct_abi_type_mentions_array(t) && !return_ref {
              gc_direct_abi_ok = false
            } else {
              ()
            },
            None => ()
          }
          if return_ref {
            has_ref = true
          } else {
            ()
          }
          // A generic signature cannot enter the reference lane. Two binders
          // must be consulted, and neither subsumes the other:
          //   * `dai_tparams` is the POST-strip binder. It is non-empty only
          //     for the impl methods `inject_method_generics` re-generifies
          //     AFTER `strip_generic_type_params` ran.
          //   * `direct_abi_generic_names` is the PRE-erasure name list, the
          //     only surviving evidence for source-level generics.
          // Concrete Array[Int] is additionally required above; a surviving
          // type parameter in the element position has already made
          // gc_direct_abi_ok false.
          let dai_is_generic = Array::length(dai_tparams) > 0 || gc_direct_abi_name_in(direct_abi_generic_names, dai_name)
          if dai_is_generic && has_ref {
            gc_direct_abi_ok = false
          } else {
            ()
          }
          // The CLI entry, every public declaration, and every spelling-routed
          // builtin collision stays outside the private typed island. Any such
          // declaration fails closed for the whole component so no body, call,
          // or type section can consume partial evidence.
          if gc_direct_abi_name_has_spelling_lowering(dai_name) {
            gc_direct_abi_ok = false
          } else {
            ()
          }
          if (dai_name == entry_name || gc_direct_abi_name_is_exported(stmts, dai_name)) && has_ref {
            gc_direct_abi_ok = false
          } else if has_ref {
            Array::push(gc_direct_abi_names_l, dai_name)
            Array::push(gc_direct_abi_param_refs_l, param_refs)
            Array::push(gc_direct_abi_return_refs_l, return_ref)
          } else {
            ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    dai = dai + 1
  }
  if gc_direct_abi_ok && Array::length(gc_direct_abi_names_l) > 0 {
    let mut si = 0
    while si < Array::length(user_func_stmts) {
      match Array::get(user_func_stmts, si) {
        SLet(_, _, si_name, _, EFn(_, _, si_params, _, _, si_body)) => {
          let native_params = array_empty()
          let sig_idx = gc_direct_abi_name_index(gc_direct_abi_names_l, si_name)
          if sig_idx >= 0 {
            let refs = Array::get(gc_direct_abi_param_refs_l, sig_idx)
            let mut spi = 0
            while spi < Array::length(refs) {
              if Array::get(refs, spi) {
                let (pname, _) = Array::get(si_params, spi)
                Array::push(native_params, pname)
              } else {
                ()
              }
              spi = spi + 1
            }
          } else {
            ()
          }
          let body_kind = gc_direct_abi_expr_kind(si_body, native_params, gc_direct_abi_names_l, gc_direct_abi_param_refs_l, gc_direct_abi_return_refs_l)
          let expected_kind = if sig_idx >= 0 && Array::get(gc_direct_abi_return_refs_l, sig_idx) {
            1
          } else {
            0
          }
          if body_kind != expected_kind {
            gc_direct_abi_ok = false
          } else {
            ()
          }
        },
        _ => ()
      }
      si = si + 1
    }
    // Computed module globals share `_start`'s raw i64 frame and must not
    // observe a typed function, even if the reference is consumed immediately.
    let mut gi = 0
    while gi < Array::length(stmts) {
      match Array::get(stmts, gi) {
        SLet(_, _, _, _, value) => match value {
          EFn(_, _, _, _, _, _) => (),
          _ => if gc_direct_abi_expr_mentions_name(value, gc_direct_abi_names_l) {
            gc_direct_abi_ok = false
          } else {
            ()
          }
        },
        _ => ()
      }
      gi = gi + 1
    }
  } else {
    ()
  }
  if !gc_direct_abi_ok {
    Array::truncate(gc_direct_abi_names_l, 0)
    Array::truncate(gc_direct_abi_param_refs_l, 0)
    Array::truncate(gc_direct_abi_return_refs_l, 0)
  } else {
    ()
  }
  let ctor_names_list = Array::slice([
    "None",
    "Some"
  ], 0, 2)
  let ctor_tags_list = Array::slice([
    0,
    1
  ], 0, 2)
  let ctor_field_counts_list = Array::slice([
    0,
    1
  ], 0, 2)
  let ctor_type_names_list = Array::slice([
    "Option",
    "Option"
  ], 0, 2)
  let mut type_index = 1
  let mut ei2 = 0
  while ei2 < Array::length(stmts) {
    match Array::get(stmts, ei2) {
      SEnum(_, ename, _, variants, _) => {
        type_index = type_index + 1
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vfields) = Array::get(variants, vi)
          Array::push(ctor_names_list, vname)
          Array::push(ctor_tags_list, (type_index<<16)|vi)
          Array::push(ctor_field_counts_list, Array::length(vfields))
          Array::push(ctor_type_names_list, ename)
          vi = vi + 1
        }
        0
      },
      SStruct(_, sname, sfields, _, _, _) => {
        type_index = type_index + 1
        Array::push(ctor_names_list, sname)
        Array::push(ctor_tags_list, type_index<<16)
        Array::push(ctor_field_counts_list, Array::length(sfields))
        Array::push(ctor_type_names_list, sname)
        0
      },
      // #817 gc-backend follow-up (2026-07-23): mirrors linked_compile.vibe's
      // own SSuberror case exactly -- a suberror is a single-typed enum
      // whose constructors produce a throwable value; register its ctors in
      // the ctor table like an enum's so `KeyInvalid("x")` allocates a
      // tagged value instead of hitting backend_call.vibe's "unknown
      // constructor or function" error. This case was simply never added
      // when the gc backend's own ctor-registration loop was written
      // (SEnum/SStruct only) -- found via gc-backend coverage testing.
      SSuberror(_, ename, variants) => {
        type_index = type_index + 1
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vfields) = Array::get(variants, vi)
          Array::push(ctor_names_list, vname)
          Array::push(ctor_tags_list, (type_index<<16)|vi)
          Array::push(ctor_field_counts_list, Array::length(vfields))
          Array::push(ctor_type_names_list, ename)
          vi = vi + 1
        }
        0
      },
      _ => 0
    }
    ei2 = ei2 + 1
  }
  // Sorted ctor-name index (see CtorTable.names_sorted): built once here,
  // shared by every CtorTable literal below.
  let (gc_ctor_names_sorted, gc_ctor_names_sorted_pos) = ctor_sorted_index(ctor_names_list)
  // #538: module-level literal constants (Int / Bool / String). The user-func
  // walk keeps only EFn lets; scalar lets like `let op_call = 16` previously
  // vanished and every reference threw "undefined variable".
  let gc_const_names_l = array_empty()
  let gc_const_kinds_l = array_empty()
  let gc_const_ivals_l = array_empty()
  let gc_const_svals_l = array_empty()
  let gc_global_names_l = array_empty()
  let gc_global_exprs_l = array_empty()
  let mut gci = 0
  while gci < Array::length(stmts) {
    match Array::get(stmts, gci) {
      SLet(_, _, cname, _, cval) => match cval {
        EInt(iv) => {
          Array::push(gc_const_names_l, cname)
          Array::push(gc_const_kinds_l, 0)
          Array::push(gc_const_ivals_l, iv)
          Array::push(gc_const_svals_l, "")
        },
        EBool(bv) => {
          Array::push(gc_const_names_l, cname)
          Array::push(gc_const_kinds_l, 0)
          Array::push(gc_const_ivals_l, if bv {
            1
          } else {
            0
          })
          Array::push(gc_const_svals_l, "")
        },
        EString(sv) => {
          Array::push(gc_const_names_l, cname)
          Array::push(gc_const_kinds_l, 1)
          Array::push(gc_const_ivals_l, 0)
          Array::push(gc_const_svals_l, sv)
        },
        EFn(_, _, _, _, _, _) => (),
        _ => {
          // Computed module-level value: a mutable i64 global initialized at
          // the top of _start (B12 port).
          Array::push(gc_global_names_l, cname)
          Array::push(gc_global_exprs_l, cval)
        }
      },
      _ => ()
    }
    gci = gci + 1
  }
  let struct_names = array_empty()
  let struct_field_names = array_empty()
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      SStruct(_, sname, sfields, _, _, _) => {
        Array::push(struct_names, sname)
        let fnames = array_empty()
        let mut sfi = 0
        while sfi < Array::length(sfields) {
          let (fname, _) = Array::get(sfields, sfi)
          Array::push(fnames, fname)
          sfi = sfi + 1
        }
        Array::push(struct_field_names, fnames)
        ()
      },
      _ => ()
    }
    si = si + 1
  }
  let num_user_funcs = Array::length(fn_names_list)
  if num_user_funcs == 0 {
    throw("no functions found to compile")
  }
  let mut entry_user_idx = -1
  let mut ei = 0
  while ei < num_user_funcs {
    if Array::get(fn_names_list, ei) == entry_name {
      entry_user_idx = ei
    }
    ei = ei + 1
  }
  if entry_user_idx < 0 {
    throw(String::concat("entry function not found: ", entry_name))
  }
  let str_strs = collect_strings_stmts(stmts)
  // #538: StringBuilder::freeze joins with "" and println appends "\n"; both
  // must exist in the string table even when the program has no such literal.
  if !array_contains_str(str_strs, "") {
    Array::push(str_strs, "")
  }
  if !array_contains_str(str_strs, "\n") {
    Array::push(str_strs, "\n")
  }
  let num_strings = Array::length(str_strs)
  let data_base = 64
  let str_offsets = array_empty()
  let str_lengths = array_empty()
  let mut str_pos = data_base
  let mut si = 0
  while si < num_strings {
    let s = Array::get(str_strs, si)
    let slen = String::length(s)
    Array::push(str_offsets, str_pos)
    Array::push(str_lengths, slen)
    str_pos = str_pos + slen
    si = si + 1
  }
  let heap_start = ((str_pos + 7) / 8) * 8
  let num_generated = 45
  // #538: host imports (module "vibe", tagged-i64 ABI -- the same raw ABI the
  // linear backend and the node host runner speak). Gated as a GROUP: pure
  // modules stay import-free (runnable on bare wasmtime); a module touching
  // any Env::/Fs:: builtin imports all nine at indices 1..9, shifting every
  // generated-body index by 9 (hbo).
  let use_host = stmts_use_builtin(stmts, fn_names_list, "Env::get") || stmts_use_builtin(stmts, fn_names_list, "Env::args_len") || stmts_use_builtin(stmts, fn_names_list, "Env::args_get") || stmts_use_builtin(stmts, fn_names_list, "Fs::read_file") || stmts_use_builtin(stmts, fn_names_list, "Fs::exists") || stmts_use_builtin(stmts, fn_names_list, "Fs::stat_token") || stmts_use_builtin(stmts, fn_names_list, "Fs::write_file") || stmts_use_builtin(stmts, fn_names_list, "Fs::publish_immutable_text") || stmts_use_builtin(stmts, fn_names_list, "Fs::write_bytes") || stmts_use_builtin(stmts, fn_names_list, "Fs::read_bytes") || stmts_use_builtin(stmts, fn_names_list, "Profiler::now_us")
  let hbo = if use_host {
    11
  } else {
    0
  }
  let func_offset = 1 + hbo + num_generated
  // #415 B-1: the central registry DRIVES the gc lane's registration too.
  // (name, params, returns) come from builtin_registry() rows with in_gc =
  // true; only the gc GENERATED-BODY INDEX is lane-local, resolved by the
  // match below. Adding a gc builtin = one registry row + one match arm (+
  // its generated body); param-count and returns live ONLY in the registry.
  let builtin_defs = array_empty()
  let gc_registry_rows = builtin_registry()
  let mut gc_reg_i = 0
  while gc_reg_i < Array::length(gc_registry_rows) {
    let (gc_name, gc_params, gc_returns, _, gc_in_gc) = Array::get(gc_registry_rows, gc_reg_i)
    if gc_in_gc {
      let gc_body_idx = match gc_name {
        "print_int" => 1,
        "print_str" => 2,
        "String::length" => 3,
        "String::equals" => 4,
        "String::concat" => 5,
        "array_new" => 6,
        "Array::length" => 7,
        "Array::get" => 8,
        "Array::push" => 9,
        "Array::set" => 10,
        "Double::to_int" => 11,
        "Int::to_double" => 12,
        "String::char_code_at" => 13,
        "String::from_char_code" => 14,
        "String::substring" => 15,
        "ArrayBuilder::new" => 6,
        "ArrayBuilder::push" => 9,
        "ArrayBuilder::freeze" => 16,
        // #906: FrozenArray[T] -- from_array/to_array are pure identity
        // casts (body 16, same as ArrayBuilder::freeze above); get/length
        // alias Array::get (8) / Array::length (7)'s own bodies.
        "FrozenArray::from_array" => 16,
        "FrozenArray::to_array" => 16,
        "FrozenArray::get" => 8,
        "FrozenArray::length" => 7,
        "Array::slice" => 38,
        "Array::concat" => 39,
        "Array::truncate" => 40,
        "Array::push_all" => 41,
        "str_lex_diff" => 42,
        "eq" => 29,
        "not" => 6,
        "String::join" => 35,
        "String::ends_with" => 33,
        "String::last_index_of" => 34,
        "String::starts_with" => 32,
        "String::contains" => 31,
        "String::index_of" => 30,
        "String::split" => 36,
        "String::trim" => 37,
        "Bytes::new" => 18,
        "Bytes::length" => 7,
        "Bytes::get" => 19,
        "Bytes::set" => 20,
        "Bytes::push" => 21,
        "Bytes::append" => 22,
        "Bytes::concat" => 23,
        "Bytes::slice" => 24,
        "Bytes::from_array" => 25,
        "Bytes::to_array" => 26,
        "Bytes::blit" => 27,
        "Bytes::fill" => 28,
        // #1331 調査: `Bytes` は両レーンとも linear memory にあり、SIMD は
        // その linear memory 上で成立する (v128.load はメモリアドレスを取る
        // 命令で、wasm-gc の配列はアドレス可能ではない)。つまり gc レーンで
        // 動かない理由は無く、単に未登録だっただけ。ボディは linear と同一の
        // 生成器を共有する。
        "simd_skip_ws" => 43,
        "simd_scan_alnum" => 44,
        "simd_scan_alnum_str" => 45,
        "Double::from_i64_bits" => 16,
        // #538 P4.5: identity wraps the trait-dict desugar emits around float
        // `==` operands (and int->float widening); all no-ops in the raw-bits
        // i64 world, same as the linear lane's compile_call identity handling.
        "Double::to_float" => 16,
        "Float::to_double" => 16,
        "Char::to_int" => 16,
        "Char::from_int" => 16,
        "Int::to_float" => 12,
        "FixedArray::make" => 6,
        "FixedArray::length" => 6,
        "FixedArray::get" => 6,
        "FixedArray::set" => 6,
        "FixedArray::unsafe_set" => 6,
        "FixedArray::blit" => 6,
        "Int64Array::make" => 6,
        "Int64Array::length" => 6,
        "Int64Array::get" => 6,
        "Int64Array::set" => 6,
        "StringBuilder::new" => 6,
        "StringBuilder::push" => 6,
        "StringBuilder::freeze" => 6,
        "Map::get" => 6,
        "Map::keys" => 6,
        "MapBuilder::new" => 6,
        "MapBuilder::set" => 6,
        "MapBuilder::freeze" => 6,
        "MapBuilder::has_key" => 6,
        "MapBuilder::get" => 6,
        "__to_string" => 17,
        "assert" => 6,
        "assert_true" => 6,
        "assert_eq" => 6,
        "println" => 6,
        "print" => 6,
        "map_has" => 6,
        _ => 0 - 1
      }
      if gc_body_idx < 0 {
        throw("builtin registry drift: no gc body-index mapping for builtin '\{gc_name}' (add a match arm in backend_body.vibe, #415)")
      } else {
        ()
      }
      Array::push(builtin_defs, (gc_name, gc_params, gc_body_idx, gc_returns))
    } else {
      ()
    }
    gc_reg_i = gc_reg_i + 1
  }
  // #415 B-0: builtin_defs must agree with the central registry (name set +
  // params + returns, both directions). The table is static, so this is a
  // full bidirectional check — a builtin added to the linear lane without an
  // explicit gc decision (or vice versa) fails every gc build by name.
  let __reg_names = array_empty()
  let __reg_params = array_empty()
  let __reg_returns = array_empty()
  let mut __ri = 0
  while __ri < Array::length(builtin_defs) {
    let (rbname, rbparams, _, rbreturns) = Array::get(builtin_defs, __ri)
    Array::push(__reg_names, rbname)
    Array::push(__reg_params, rbparams)
    Array::push(__reg_returns, rbreturns)
    __ri = __ri + 1
  }
  verify_lane_builtins("gc", __reg_names, __reg_params, __reg_returns)
  let mut __bi = 0
  while __bi < Array::length(builtin_defs) {
    let (bname, bparams, _, _) = Array::get(builtin_defs, __bi)
    Array::push(fn_names_list, bname)
    Array::push(fn_param_counts, bparams)
    Array::push(fn_needs_env_list, false)
    __bi = __bi + 1
  }
  let fn_indices_list = array_empty()
  let fn_returns_list = array_empty()
  let mut fi = 0
  while fi < num_user_funcs {
    Array::push(fn_indices_list, fi + func_offset)
    Array::push(fn_returns_list, 1)
    fi = fi + 1
  }
  let mut __bi2 = 0
  while __bi2 < Array::length(builtin_defs) {
    let (_, _, bwasm_idx, breturns) = Array::get(builtin_defs, __bi2)
    Array::push(fn_indices_list, bwasm_idx + hbo)
    Array::push(fn_returns_list, breturns)
    __bi2 = __bi2 + 1
  }
  // #538: host-import builtins at absolute import indices 1..9.
  if use_host {
    let host_defs = [
      ("Env::get", 1, 1, 1),
      ("Env::args_len", 0, 2, 1),
      ("Env::args_get", 1, 3, 1),
      ("Fs::read_file", 1, 4, 1),
      ("Fs::exists", 1, 5, 1),
      ("Fs::stat_token", 1, 6, 1),
      ("Fs::write_file", 2, 7, 0),
      ("Fs::publish_immutable_text", 2, 8, 1),
      ("Fs::write_bytes", 2, 9, 0),
      ("Fs::read_bytes", 1, 10, 1),
      ("Profiler::now_us", 0, 11, 1)
    ]
    let mut __hd = 0
    while __hd < Array::length(host_defs) {
      let (hname, hparams, hidx, hret) = Array::get(host_defs, __hd)
      Array::push(fn_names_list, hname)
      Array::push(fn_param_counts, hparams)
      Array::push(fn_needs_env_list, false)
      Array::push(fn_indices_list, hidx)
      Array::push(fn_returns_list, hret)
      __hd = __hd + 1
    }
  } else {
    ()
  }
  let ft_names = array_empty()
  let ft_indices = array_empty()
  // #724 round 2: (fn name -> declared aggregate return shape) table for
  // `let a = f(..)` structural `==` (see compute_agg_returning).
  let gc_agg_ret_names_l = array_empty()
  let gc_agg_ret_infos_l = array_empty()
  compute_agg_returning(stmts, CtorTable::{
    names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: gc_ctor_names_sorted, names_sorted_pos: gc_ctor_names_sorted_pos
  }, gc_agg_ret_names_l, gc_agg_ret_infos_l)
  let ft_params = array_empty()
  let ft_returns = array_empty()
  let ft_needs_env = array_empty()
  let mut ft_copy_i = 0
  while ft_copy_i < Array::length(fn_names_list) {
    Array::push(ft_names, Array::get(fn_names_list, ft_copy_i))
    Array::push(ft_indices, Array::get(fn_indices_list, ft_copy_i))
    Array::push(ft_params, Array::get(fn_param_counts, ft_copy_i))
    Array::push(ft_returns, Array::get(fn_returns_list, ft_copy_i))
    Array::push(ft_needs_env, Array::get(fn_needs_env_list, ft_copy_i))
    ft_copy_i = ft_copy_i + 1
  }
  let refcell_type_idx = 10
  // This private i64 array is only used by the always-run native-GC smoke
  // below. Its reference is dropped before user code, so it cannot cross the
  // universal i64 ABI or change capture/escape representation.
  let gc_native_alloc_probe_array_type_idx = 11
  // Mutable i64 array used solely by non-escaping user local literals.
  let gc_native_array_type_idx = 12
  let closure_type_base = 13
  let fresh_bytes_array: () -> Array[Bytes] = () -> {
    ArrayBuilder::freeze(ArrayBuilder::new())
  }
  // #1332: module-level, parallel to lt_w.bodies. Shared by reference into
  // every lambda ctx (backend_lambda_ctx.vibe) so nested lambdas append here
  // too; record_lambda_meta_gc is the single writer.
  let gc_lambda_native_array_locals_l = array_empty()
  let lt_w = LambdaTable::{
    bodies: fresh_bytes_array(),
    param_counts: array_empty(),
    captures: array_empty(),
    meta_i32: array_empty(),
    meta_i64: array_empty()
  }
  let bodies = fresh_bytes_array()
  let meta_i32 = array_empty()
  let meta_i64 = array_empty()
  let user_ref_local_indices_all = array_empty()
  // #1332: PARAM COUNT PER BODY, parallel to `bodies`.
  //
  // The code section previously recovered this as `ft_params[ci -
  // num_generated] + 1`, which silently assumes every body with a typed-local
  // row is a USER FUNCTION. That assumption is what #1427 tripped over (the
  // `_start` body is not one), and lambdas are not user functions either -- so
  // enabling typed locals for lambda bodies without fixing this would
  // reintroduce the same class of bug one row over.
  //
  // Every `Array::push(bodies, ...)` site pushes here too. Generated builtin
  // bodies push -1: they never carry a typed-local row, and the declaration
  // pass throws rather than guessing if one ever appears.
  let body_param_counts = array_empty()
  // Absolute local slots of typed native-array locals, one entry per user
  // body; ref-cell metadata remains separate because it is still i64.
  let user_native_array_local_indices_all = array_empty()
  // #415 B-1: one call = one gc builtin body — body bytes, extra local
  // counts, the (always empty here) user-ref locals row, and the
  // function-section type index together. The function section splices
  // gc_builtin_type_idxs in this same order; the count mismatch guard below
  // still applies.
  let gc_builtin_type_idxs = array_empty()
  let push_gc_builtin: (Bytes, Int, Int, Int) -> Unit = (body, m32, m64, type_idx) -> {
    Array::push(bodies, body)
    Array::push(meta_i32, m32)
    Array::push(meta_i64, m64)
    Array::push(user_ref_local_indices_all, array_empty())
    Array::push(user_native_array_local_indices_all, array_empty())
    Array::push(body_param_counts, -1)
    Array::push(gc_builtin_type_idxs, type_idx)
  }
  push_gc_builtin(gc_gen_print_i64_body(), 3, 1, 1)
  push_gc_builtin(gc_gen_print_str_body(), 2, 0, 1)
  push_gc_builtin(gc_gen_str_len_body(), 0, 0, 3)
  // #748: strings live in linear memory with the same packed layout in the
  // gc lane, so the SIMD chunk-compare generator is shared verbatim
  // (chunk_limit local -> meta_i32 6).
  push_gc_builtin(gen_str_eq_body(), 6, 0, 4)
  push_gc_builtin(gc_gen_str_concat_body(), 6, 0, 4)
  push_gc_builtin(gc_gen_arr_new_body(), 1, 0, 5)
  push_gc_builtin(gc_gen_arr_len_body(), 0, 0, 3)
  push_gc_builtin(gc_gen_arr_get_body(), 1, 0, 4)
  push_gc_builtin(gc_gen_arr_push_body(), 6, 0, 6)
  push_gc_builtin(gc_gen_arr_set_body(), 1, 0, 7)
  push_gc_builtin(gc_gen_double_to_int_body(), 0, 0, 3)
  push_gc_builtin(gc_gen_int_to_double_body(), 0, 0, 3)
  push_gc_builtin(gc_gen_str_char_code_at_body(), 1, 0, 4)
  push_gc_builtin(gc_gen_str_from_char_code_body(), 1, 0, 3)
  push_gc_builtin(gc_gen_str_substring_body(), 2, 0, 8)
  push_gc_builtin(gc_gen_identity_body(), 0, 0, 3)
  // Body 17 (__to_string): runtime string-vs-int dispatch, NOT identity —
  // interpolation routes every `\{x}` here (see gc_gen_to_string_body).
  push_gc_builtin(gc_gen_to_string_body(), 0, 5, 3)
  push_gc_builtin(gen_bytes_new_body(), 1, 0, 5)
  push_gc_builtin(gen_bytes_get_body(false), 1, 0, 4)
  push_gc_builtin(gen_bytes_set_body(false), 1, 0, 7)
  push_gc_builtin(gen_bytes_push_body(false), 6, 0, 6)
  push_gc_builtin(gen_bytes_append_body(), 8, 0, 6)
  push_gc_builtin(gen_bytes_concat_body(hbo + 18, hbo + 22), 0, 1, 4)
  push_gc_builtin(gen_bytes_slice_body(false, hbo + 18, hbo + 19, hbo + 21), 2, 1, 8)
  push_gc_builtin(gen_bytes_from_array_body(false, hbo + 7, hbo + 8, hbo + 18, hbo + 21), 2, 1, 3)
  push_gc_builtin(gen_bytes_to_array_body(false, hbo + 6, hbo + 9, hbo + 7, hbo + 19), 2, 1, 3)
  push_gc_builtin(gen_bytes_blit_body(false, hbo + 19, hbo + 21), 2, 0, 9)
  push_gc_builtin(gen_bytes_fill_body(false, hbo + 21), 2, 0, 7)
  // #538: generic eq (i64 fast path + looks-like-string guarded content eq)
  // -- Map::get/has_key/MapBuilder::set resolve "eq" from the func table, and
  // before this existed the placeholder index called array_new, which returns
  // a fresh non-zero pointer: every key comparison was TRUE (silent wrong Map
  // results). The gc string repr is the same packed (offset<<32)|len as the
  // linear backend, so the linear bodies are reused verbatim below.
  push_gc_builtin(gen_eq_body(hbo + 4), 0, 0, 4)
  push_gc_builtin(gen_string_index_of_body(false, hbo + 3, hbo + 15, hbo + 4), 8, 0, 4)
  push_gc_builtin(gen_string_contains_body(false, hbo + 30), 0, 0, 4)
  push_gc_builtin(gen_string_starts_with_body(false, hbo + 3, hbo + 15, hbo + 4), 2, 1, 4)
  push_gc_builtin(gen_string_ends_with_body(false, hbo + 3, hbo + 15, hbo + 4), 2, 1, 4)
  push_gc_builtin(gen_string_last_index_of_body(false, hbo + 3, hbo + 15, hbo + 4), 3, 1, 4)
  push_gc_builtin(gen_string_join_body(false, hbo + 7, hbo + 8, hbo + 5), 9, 1, 4)
  push_gc_builtin(gen_string_split_body(false, hbo + 6, hbo + 9, hbo + 3, hbo + 15, hbo + 30), 4, 1, 4)
  push_gc_builtin(gen_string_trim_body(false, hbo + 3, hbo + 13, hbo + 15), 4, 0, 3)
  push_gc_builtin(gc_gen_arr_slice_body(hbo + 6, hbo + 8, hbo + 9), 0, 2, 8)
  push_gc_builtin(gc_gen_arr_concat_body(hbo + 6, hbo + 7, hbo + 8, hbo + 9), 0, 3, 4)
  push_gc_builtin(gc_gen_arr_truncate_body(), 0, 0, 6)
  push_gc_builtin(gc_gen_arr_push_all_body(hbo + 7, hbo + 8, hbo + 9), 0, 2, 6)
  // #746: same packed-string layout as the linear lane, generator shared
  // verbatim (untagged ints in the gc lane -> enable_rc=false).
  push_gc_builtin(gen_str_lex_diff_body(false), 7, 0, 4)
  // #1331 調査で見つかった穴: `Bytes::blit`/`fill` は gc にあるのに SIMD
  // スキャンだけ linear 専用だった。generator は linear と同一 (gc レーンは
  // 他の Bytes builtin と同じく enable_rc=false)、型は 8 = (i64,i64,i64)->i64。
  // 追加は必ず末尾に置くこと -- 上の `hbo + N` は push 順の序数なので、
  // 途中に挿入すると既存の参照が全てずれる。
  push_gc_builtin(gen_simd_skip_ws_body(false), 2, 2, 8)
  push_gc_builtin(gen_simd_scan_alnum_body(false, false), 1, 3, 8)
  push_gc_builtin(gen_simd_scan_alnum_body(false, true), 1, 3, 8)
  // #1109 gc parity (linear twin: linked_compile.vibe's table_slots_used):
  // module-wide recorder of funcref-table slots codegen actually
  // materializes as closure values. Created once here -- every CompileCtxGc
  // constructed below (per-function and the globals-init ctx) shares this
  // array by reference -- and consumed by the element-section emission,
  // which registers only the recorded slots (see CompileCtx.table_slots_used
  // in common_base.vibe for the full rationale).
  let table_slots_used = array_empty()
  let mut bi = 0
  while bi < num_user_funcs {
    let stmt = Array::get(user_func_stmts, bi)
    match stmt {
      SLet(_, _, gc_fn_name, gc_fn_ann, expr) => match expr {
        EFn(_, _, params, _, _, body) => {
          let body_buf = bytebuf_new()
          let local_names = array_empty()
          let gc_agg_slots_f = array_empty()
          let mut ppi = 0
          while ppi < Array::length(params) {
            let (pname, _) = Array::get(params, ppi)
            Array::push(local_names, pname)
            ppi = ppi + 1
          }
          Array::push(local_names, "__env")
          let param_count = Array::length(params) + 1
          // #724 round 2: seed the aggregate-shape log from annotated params.
          // #744 gc mirror: seed float tracking from annotated Float/Double
          // params in the same walk (linear tracks these via float_local_slots).
          // #1015 gc mirror: seed bool tracking from annotated Bool params in
          // the same walk (linear tracks these via int_local_slots kind 3) --
          // without this a Bool-typed top-level fn param passed to
          // `to_string(b)` is an untracked bare EIdent and mis-renders `true`
          // as `"1"` through the generic runtime dispatch (Bool and Int share
          // the same gc-lane numeric representation, no distinguishing tag).
          // #1032: gc_float_slots_f/gc_bool_slots_f are both tracked by SLOT
          // INDEX (not name) -- `psi` IS the param's slot in local_names
          // (params are pushed there in order starting at 0, just above this
          // loop).
          let gc_float_slots_f = array_empty()
          let gc_bool_slots_f = array_empty()
          let gc_sig_ptypes = fn_type_param_types(gc_fn_ann)
          let mut psi = 0
          while psi < Array::length(params) {
            let pann = match gc_sig_ptypes {
              Some(pts) => if Array::length(pts) == Array::length(params) {
                Some(Array::get(pts, psi))
              } else {
                let (_, pa) = Array::get(params, psi)
                pa
              },
              None => {
                let (_, pa) = Array::get(params, psi)
                pa
              }
            }
            match pann {
              Some(pte) => {
                let pinfo = agg_info_of_type_expr(CtorTable::{
                  names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: gc_ctor_names_sorted, names_sorted_pos: gc_ctor_names_sorted_pos
                }, pte)
                if pinfo > 0 {
                  Array::push(gc_agg_slots_f, psi * 256 + pinfo)
                } else {
                  ()
                }
                match pte {
                  TyName(ptn) => if ptn == "Float" || ptn == "Double" {
                    Array::push(gc_float_slots_f, psi)
                  } else if ptn == "Bool" {
                    Array::push(gc_bool_slots_f, psi)
                  } else {
                    ()
                  },
                  _ => ()
                }
              },
              None => ()
            }
            psi = psi + 1
          }
          let ref_cell_names_f = array_empty()
          let ref_local_indices_f = array_empty()
          let direct_sig_idx = gc_direct_abi_name_index(gc_direct_abi_names_l, gc_fn_name)
          let direct_param_slots_f = array_empty()
          let direct_return_ref_f = direct_sig_idx >= 0 && Array::get(gc_direct_abi_return_refs_l, direct_sig_idx)
          if direct_sig_idx >= 0 {
            let direct_refs = Array::get(gc_direct_abi_param_refs_l, direct_sig_idx)
            let mut dri = 0
            while dri < Array::length(direct_refs) {
              if Array::get(direct_refs, dri) {
                Array::push(direct_param_slots_f, dri)
              } else {
                ()
              }
              dri = dri + 1
            }
          } else {
            ()
          }
          let ft = FuncTable::{
            names: ft_names,
            indices: ft_indices,
            params: ft_params,
            returns: ft_returns,
            needs_env: ft_needs_env,
            // #1100: GC backend keeps its own resolve_func-independent
            // lookups (gc_resolve_builtin_last etc., out of scope here) --
            // func_table_index_of falls back to a linear scan when
            // names_sorted's length doesn't match names'.
            names_sorted: array_empty(),
            names_sorted_pos: array_empty()
          }
          let st = StrTable::{
            strs: str_strs, offsets: str_offsets, lengths: str_lengths
          }
          let ct = CtorTable::{
            names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: gc_ctor_names_sorted, names_sorted_pos: gc_ctor_names_sorted_pos
          }
          let func_ctx = CompileCtxGc::{
            func_table: ft, str_table: st, lambda_table: lt_w,
            num_user_funcs: num_user_funcs, func_offset: func_offset,
            ref_cell_names: ref_cell_names_f, ref_local_indices: ref_local_indices_f,
            refcell_type_idx: refcell_type_idx, closure_type_base: closure_type_base,
            gc_ctor_table: ct,
            gc_const_names: gc_const_names_l, gc_const_kinds: gc_const_kinds_l,
            gc_const_ivals: gc_const_ivals_l, gc_const_svals: gc_const_svals_l,
            gc_global_names: gc_global_names_l,
            gc_float_locals: gc_float_slots_f,
            gc_bool_locals: gc_bool_slots_f,
            gc_native_array_locals: direct_param_slots_f,
            gc_native_array_local_types: array_empty(),
            gc_native_array_type_idx: gc_native_array_type_idx,
            gc_native_array_frame_ok: true,
            gc_lambda_native_array_locals: gc_lambda_native_array_locals_l,
            gc_direct_abi_names: gc_direct_abi_names_l,
            gc_direct_abi_param_refs: gc_direct_abi_param_refs_l,
            gc_direct_abi_return_refs: gc_direct_abi_return_refs_l,
            gc_direct_abi_current_return_ref: direct_return_ref_f,
            gc_to_string_is_show_wrapper: gc_to_string_is_wrapper,
            gc_agg_local_slots: gc_agg_slots_f,
            gc_agg_ret_names: gc_agg_ret_names_l,
            gc_agg_ret_infos: gc_agg_ret_infos_l,
            table_slots_used: table_slots_used
          }
          let final_nl = compile_expr_gc(body_buf, body, local_names, param_count, func_ctx, -1)
          Array::push(bodies, body_buf)
          let extra = if final_nl > param_count {
            final_nl - param_count
          } else {
            0
          }
          Array::push(meta_i32, 0)
          Array::push(meta_i64, extra)
          Array::push(user_ref_local_indices_all, ref_local_indices_f)
          Array::push(user_native_array_local_indices_all, func_ctx.gc_native_array_local_types)
          Array::push(body_param_counts, param_count)
        },
        _ => throw("expected function")
      }
      ,
      _ => throw("expected let statement")
    }
    bi = bi + 1
  }
  let start_body = bytebuf_new()
  let entry_func_idx = entry_user_idx + func_offset
  let entry_params = Array::get(ft_params, entry_user_idx)
  if entry_params != 0 {
    throw("WASI entry function must take 0 parameters")
  }
  // #538: initialize computed module-level globals (statement order) before
  // the entry runs. Compiled with a fresh local frame; lambdas created here
  // land in lt_w like any other (num_lambdas is computed AFTER this).
  let mut start_extra_locals = 0
  if Array::length(gc_global_names_l) > 0 {
    let init_ref_cells = array_empty()
    let init_ref_idx = array_empty()
    let init_ctx = CompileCtxGc::{
      func_table: FuncTable::{
        names: ft_names, indices: ft_indices, params: ft_params,
        returns: ft_returns, needs_env: ft_needs_env,
        names_sorted: array_empty(), names_sorted_pos: array_empty()
      },
      str_table: StrTable::{
        strs: str_strs, offsets: str_offsets, lengths: str_lengths
      },
      lambda_table: lt_w,
      num_user_funcs: num_user_funcs, func_offset: func_offset,
      ref_cell_names: init_ref_cells, ref_local_indices: init_ref_idx,
      refcell_type_idx: refcell_type_idx, closure_type_base: closure_type_base,
      gc_ctor_table: CtorTable::{
        names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list,
        type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names,
        names_sorted: gc_ctor_names_sorted, names_sorted_pos: gc_ctor_names_sorted_pos
      },
      gc_const_names: gc_const_names_l, gc_const_kinds: gc_const_kinds_l,
      gc_const_ivals: gc_const_ivals_l, gc_const_svals: gc_const_svals_l,
      gc_global_names: gc_global_names_l,
      gc_float_locals: array_empty(),
      gc_bool_locals: array_empty(),
      gc_native_array_locals: array_empty(),
      gc_native_array_local_types: array_empty(),
      // Module-level initializers compile into `_start`, which is registered
      // below with an unconditionally EMPTY native-local row -- so a slot the
      // native path claimed here would be declared `i64` while the body used
      // it as an array reference, and the module would fail validation
      // outright (`let result = { let xs = [1]; Array::get(xs, 0) }` reproduced
      // it: "local.set[0] expected type i64, found array.new_default").
      //
      // Propagating the row instead is NOT a drop-in alternative, for two
      // independent reasons:
      //   * the declaration pass reaches a body's param count via
      //     `ft_params[ci - num_generated]`, which only maps for USER
      //     functions -- `_start` is not one; and
      //   * every global initializer is compiled into the SAME local frame
      //     (`init_locals` / `start_extra_locals` is a max over them), so one
      //     slot can be a native array in one initializer and an i64 in the
      //     next, which no single declaration can satisfy.
      //
      // Disable it for THIS FRAME only. #1332 split the frame half out of the
      // type-index sentinel: lambdas created inside an initializer compile
      // into their own frames with their own emitted rows, so they must NOT
      // inherit this (they set frame_ok back to true in
      // backend_lambda_ctx.vibe). Still one predicate, read in one place.
      gc_native_array_type_idx: gc_native_array_type_idx,
      gc_native_array_frame_ok: false,
      gc_lambda_native_array_locals: gc_lambda_native_array_locals_l,
      // `_start` stays entirely outside the private direct-call ABI island.
      gc_direct_abi_names: gc_direct_abi_names_l,
      gc_direct_abi_param_refs: gc_direct_abi_param_refs_l,
      gc_direct_abi_return_refs: gc_direct_abi_return_refs_l,
      gc_direct_abi_current_return_ref: false,
      gc_to_string_is_show_wrapper: gc_to_string_is_wrapper,
      gc_agg_local_slots: array_empty(),
      gc_agg_ret_names: gc_agg_ret_names_l,
      gc_agg_ret_infos: gc_agg_ret_infos_l,
      table_slots_used: table_slots_used
    }
    let init_locals = array_empty()
    let mut ginit = 0
    while ginit < Array::length(gc_global_names_l) {
      let gexpr = Array::get(gc_global_exprs_l, ginit)
      let g_nl = compile_expr_gc(start_body, gexpr, init_locals, Array::length(init_locals), init_ctx, -1)
      emit_global_set(start_body, 1 + ginit)
      if g_nl > start_extra_locals {
        start_extra_locals = g_nl
      }
      if Array::length(init_locals) > start_extra_locals {
        start_extra_locals = Array::length(init_locals)
      }
      ginit = ginit + 1
    }
  }
  // Match the linear backend: an entry annotated `-> Unit` (including the
  // `fn main {}` desugaring) should discard its tagged Unit result, not pass
  // it to the historical integer-print helper.
  let mut entry_returns_unit = false
  let mut eri = 0
  while eri < Array::length(stmts) {
    match Array::get(stmts, eri) {
      SLet(_, _, name, annotation, value) => if name == entry_name {
        let annotation_is_unit = match annotation {
          Some(TyFn(_, ret, _)) => gc_type_expr_is_unit(ret),
          _ => false
        }
        let lambda_is_unit = match value {
          EFn(_, _, _, Some(ret), _, _) => gc_type_expr_is_unit(ret),
          _ => false
        }
        if annotation_is_unit || lambda_is_unit {
          entry_returns_unit = true
        }
      },
      _ => ()
    }
    eri = eri + 1
  }
  // First vertical slice toward native GC allocation: exercise a private
  // struct and array at startup, then drop both references. All user values,
  // function signatures, captures, and escaped values remain i64/linear.
  emit_i64_const(start_body, 0)
  emit_struct_new(start_body, refcell_type_idx)
  emit_drop(start_body)
  emit_i64_const(start_body, 0)
  emit_i32_const(start_body, 1)
  emit_array_new(start_body, gc_native_alloc_probe_array_type_idx)
  emit_drop(start_body)
  emit_i64_const(start_body, 0)
  emit_call(start_body, entry_func_idx)
  if entry_returns_unit {
    emit_drop(start_body)
  } else {
    emit_call(start_body, 1 + hbo)
  }
  let num_lambdas = Array::length(lt_w.bodies)
  Array::push(bodies, start_body)
  Array::push(meta_i32, 0)
  Array::push(meta_i64, start_extra_locals)
  Array::push(user_ref_local_indices_all, array_empty())
  Array::push(user_native_array_local_indices_all, array_empty())
  // `_start` takes no parameters (enforced above), so its extra locals begin
  // at slot 0.
  Array::push(body_param_counts, 0)
  let mut li = 0
  while li < num_lambdas {
    Array::push(bodies, Array::get(lt_w.bodies, li))
    Array::push(meta_i32, Array::get(lt_w.meta_i32, li))
    Array::push(meta_i64, Array::get(lt_w.meta_i64, li))
    Array::push(user_ref_local_indices_all, array_empty())
    // #1332: the lambda's own typed-local row, recorded parallel to
    // lt_w.bodies by record_lambda_meta_gc.
    Array::push(user_native_array_local_indices_all, Array::get(gc_lambda_native_array_locals_l, li))
    // lt_w.param_counts already counts the trailing `__env` parameter.
    Array::push(body_param_counts, Array::get(lt_w.param_counts, li))
    li = li + 1
  }
  let mut max_closure_arity = -1
  let mut lai = 0
  while lai < num_lambdas {
    let lpc = Array::get(lt_w.param_counts, lai) - 1
    if lpc > max_closure_arity {
      max_closure_arity = lpc
    }
    lai = lai + 1
  }
  let mut uai2 = 0
  while uai2 < num_user_funcs {
    let upc = Array::get(ft_params, uai2)
    if upc > max_closure_arity {
      max_closure_arity = upc
    }
    uai2 = uai2 + 1
  }
  let num_closure_types = if max_closure_arity >= 0 {
    max_closure_arity + 1
  } else {
    0
  }
  let num_base_types = 13
  let gc_direct_type_indices = array_empty()
  let mut gc_direct_type_count = 0
  let mut dti = 0
  while dti < num_user_funcs {
    let sig_idx = gc_direct_abi_name_index(gc_direct_abi_names_l, Array::get(fn_names_list, dti))
    if sig_idx >= 0 {
      Array::push(gc_direct_type_indices, num_base_types + num_closure_types + gc_direct_type_count)
      gc_direct_type_count = gc_direct_type_count + 1
    } else {
      Array::push(gc_direct_type_indices, -1)
    }
    dti = dti + 1
  }
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types + gc_direct_type_count)
  emit_func_type_raw(type_content, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(type_content, [
    126
  ], array_empty())
  emit_func_type_raw(type_content, array_empty(), array_empty())
  emit_func_type_raw(type_content, [
    126
  ], [
    126
  ])
  emit_func_type_raw(type_content, [
    126,
    126
  ], [
    126
  ])
  emit_func_type_raw(type_content, array_empty(), [
    126
  ])
  emit_func_type_raw(type_content, [
    126,
    126
  ], array_empty())
  emit_func_type_raw(type_content, [
    126,
    126,
    126
  ], array_empty())
  emit_func_type_raw(type_content, [
    126,
    126,
    126
  ], [
    126
  ])
  emit_func_type_raw(type_content, [
    126,
    126,
    126,
    126
  ], array_empty())
  emit_struct_type_raw(type_content, [
    126
  ], [
    1
  ])
  emit_array_type_raw(type_content, 126, 0)
  emit_array_type_raw(type_content, 126, 1)
  let mut cti = 0
  while cti < num_closure_types {
    let num_params = cti + 1
    let ct_params = array_empty()
    let mut cpti = 0
    while cpti < num_params {
      Array::push(ct_params, 126)
      cpti = cpti + 1
    }
    emit_func_type_raw(type_content, ct_params, [
      126
    ])
    cti = cti + 1
  }
  let mut dte = 0
  while dte < num_user_funcs {
    if Array::get(gc_direct_type_indices, dte) >= 0 {
      let sig_idx = gc_direct_abi_name_index(gc_direct_abi_names_l, Array::get(fn_names_list, dte))
      emit_gc_direct_func_type(type_content, Array::get(gc_direct_abi_param_refs_l, sig_idx), Array::get(gc_direct_abi_return_refs_l, sig_idx), gc_native_array_type_idx)
    } else {
      ()
    }
    dte = dte + 1
  }
  let out = bytebuf_new()
  emit_header(out)
  bytebuf_push_section(out, 1, type_content)
  if use_host {
    // fd_write + the ten "vibe" host imports (types: 3=(i64)->i64,
    // 4=(i64,i64)->i64, 5=()->i64, 6=(i64,i64)->()) -- the linear backend's
    // raw tagged ABI.
    let imp_content = bytebuf_new()
    bytebuf_push_vec_header(imp_content, 12)
    emit_name(imp_content, "wasi_snapshot_preview1")
    emit_name(imp_content, "fd_write")
    bytebuf_push(imp_content, 0)
    leb128_encode_u32(imp_content, 0)
    let host_imports = [
      ("env-get", 3),
      ("args-len", 5),
      ("args-get", 3),
      ("fs_read_file", 3),
      ("fs_exists", 3),
      ("fs_stat_token", 3),
      ("fs_write_file", 6),
      ("fs_publish_immutable_text", 4),
      ("fs_write_bytes", 6),
      ("fs_read_bytes", 3),
      ("profile-now-us", 5)
    ]
    let mut __hi = 0
    while __hi < Array::length(host_imports) {
      let (hin, hit) = Array::get(host_imports, __hi)
      emit_name(imp_content, "vibe")
      emit_name(imp_content, hin)
      bytebuf_push(imp_content, 0)
      leb128_encode_u32(imp_content, hit)
      __hi = __hi + 1
    }
    bytebuf_push_section(out, 2, imp_content)
  } else {
    emit_import_section_func(out, "wasi_snapshot_preview1", "fd_write", 0)
  }
  let func_type_indices = array_empty()
  // #415 B-1: builtin type indices are declared next to each body push
  // (push_gc_builtin above) — splice them here in the same order.
  let mut gbti = 0
  while gbti < Array::length(gc_builtin_type_idxs) {
    Array::push(func_type_indices, Array::get(gc_builtin_type_idxs, gbti))
    gbti = gbti + 1
  }
  let mut fti = 0
  while fti < num_user_funcs {
    let direct_type_idx = Array::get(gc_direct_type_indices, fti)
    if direct_type_idx >= 0 {
      Array::push(func_type_indices, direct_type_idx)
    } else {
      let upc = Array::get(ft_params, fti)
      Array::push(func_type_indices, closure_type_base + upc)
    }
    fti = fti + 1
  }
  Array::push(func_type_indices, 2)
  let mut lfi = 0
  while lfi < num_lambdas {
    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1
    Array::push(func_type_indices, closure_type_base + lam_user_params)
    lfi = lfi + 1
  }
  if Array::length(func_type_indices) != Array::length(bodies) {
    throw("gc codegen internal error: function section and code section count mismatch")
  } else {
    ()
  }
  emit_function_section(out, func_type_indices)
  let total_table_entries = num_user_funcs + num_lambdas
  if total_table_entries > 0 {
    emit_table_section_funcref(out, total_table_entries)
  }
  emit_memory_section(out, 1)
  // #538: exception tag (id 13 section sits between memory and global).
  // #721-style gating: throw-free modules stay tag-free and run on engines
  // without the exceptions proposal.
  if stmts_contain_exceptions(stmts) {
    let tag_content = bytebuf_new()
    leb128_encode_u32(tag_content, 1)
    bytebuf_push(tag_content, 0)
    leb128_encode_u32(tag_content, 1)
    bytebuf_push_section(out, 13, tag_content)
  } else {
    ()
  }
  if Array::length(gc_global_names_l) == 0 {
    emit_global_section_i32_mut(out, heap_start)
  } else {
    // global 0: i32 mut heap pointer; globals 1..N: i64 mut computed values.
    let g_content = bytebuf_new()
    bytebuf_push_vec_header(g_content, 1 + Array::length(gc_global_names_l))
    bytebuf_push(g_content, 127)
    bytebuf_push(g_content, 1)
    emit_i32_const(g_content, heap_start)
    emit_end(g_content)
    let mut ggi = 0
    while ggi < Array::length(gc_global_names_l) {
      bytebuf_push(g_content, 126)
      bytebuf_push(g_content, 1)
      emit_i64_const(g_content, 0)
      emit_end(g_content)
      ggi = ggi + 1
    }
    bytebuf_push_section(out, 6, g_content)
  }
  let start_func_idx = func_offset + num_user_funcs
  // #538 P4.5: export the entry function and __heap_ptr alongside _start.
  // The host runner's raw-ABI string allocation (args-get / env-get /
  // fs_read_file results) heap-bumps through the exported __heap_ptr global;
  // without it the runner falls back to an end-of-memory arena that the
  // guest's own bump allocator grows into and clobbers mid-compile.
  let export_content = bytebuf_new()
  let export_entry_too = entry_name != "_start"
  bytebuf_push_vec_header(export_content, if export_entry_too {
    4
  } else {
    3
  })
  emit_name(export_content, "_start")
  bytebuf_push(export_content, 0)
  leb128_encode_u32(export_content, start_func_idx)
  if export_entry_too {
    emit_name(export_content, entry_name)
    bytebuf_push(export_content, 0)
    leb128_encode_u32(export_content, entry_func_idx)
  } else {
    ()
  }
  emit_name(export_content, "memory")
  bytebuf_push(export_content, 2)
  leb128_encode_u32(export_content, 0)
  emit_name(export_content, "__heap_ptr")
  bytebuf_push(export_content, 3)
  leb128_encode_u32(export_content, 0)
  bytebuf_push_section(out, 7, export_content)
  if total_table_entries > 0 {
    // #1109 gc parity (linear twin: linked_compile.vibe's element-section
    // rebuild, ~3841-3886): register ONLY the slots codegen recorded a
    // closure value for (table_slots_used), not every user function +
    // lambda. A slot no closure carries can never be call_indirect'ed, so it
    // stays ref.null; slot numbering and the declared table size are
    // untouched. Run-compressed active segments skip the gaps.
    let slot_used_flags = array_empty()
    let mut sfi = 0
    while sfi < total_table_entries {
      Array::push(slot_used_flags, false)
      sfi = sfi + 1
    }
    let mut tsu = 0
    while tsu < Array::length(table_slots_used) {
      let ts = Array::get(table_slots_used, tsu)
      if ts >= 0 && ts < total_table_entries {
        Array::set(slot_used_flags, ts, true)
      } else {
        ()
      }
      tsu = tsu + 1
    }
    let table_slots = array_empty()
    let table_func_indices = array_empty()
    let mut tei = 0
    while tei < total_table_entries {
      if Array::get(slot_used_flags, tei) {
        Array::push(table_slots, tei)
        Array::push(table_func_indices, if tei < num_user_funcs {
          func_offset + tei
        } else {
          start_func_idx + 1 + (tei - num_user_funcs)
        })
      } else {
        ()
      }
      tei = tei + 1
    }
    if Array::length(table_slots) > 0 {
      emit_element_section_active_runs(out, table_slots, table_func_indices)
    } else {
      ()
    }
  }
  let code_content = bytebuf_new()
  bytebuf_push_vec_header(code_content, Array::length(bodies))
  let mut ci = 0
  while ci < Array::length(bodies) {
    let body = Array::get(bodies, ci)
    let func_buf = bytebuf_new()
    let ni32 = Array::get(meta_i32, ci)
    let ni64 = Array::get(meta_i64, ci)
    let ref_indices = Array::get(user_ref_local_indices_all, ci)
    let native_indices = Array::get(user_native_array_local_indices_all, ci)
    let num_ref_locals = Array::length(ref_indices)
    let num_native_locals = Array::length(native_indices)
    if num_ref_locals == 0 && num_native_locals == 0 {
      if ni32 == 0 {
        if ni64 == 0 {
          leb128_encode_u32(func_buf, 0)
        } else {
          leb128_encode_u32(func_buf, 1)
          leb128_encode_u32(func_buf, ni64)
          bytebuf_push(func_buf, 126)
        }
      } else {
        if ni64 == 0 {
          leb128_encode_u32(func_buf, 1)
          leb128_encode_u32(func_buf, ni32)
          bytebuf_push(func_buf, 127)
        } else {
          leb128_encode_u32(func_buf, 2)
          leb128_encode_u32(func_buf, ni32)
          bytebuf_push(func_buf, 127)
          leb128_encode_u32(func_buf, ni64)
          bytebuf_push(func_buf, 126)
        }
      }
    } else {
      let param_count_for_body = Array::get(body_param_counts, ci)
      if param_count_for_body < 0 {
        // A generated builtin body grew a typed-local row. Its extra locals
        // are declared from a fixed shape here, so there is no honest slot
        // numbering to fall back on -- fail loudly instead of emitting a
        // module whose local types do not match its body (#1332).
        throw("gc backend: generated builtin body has a typed-local row")
      } else {
        ()
      }
      let num_extra = ni64
      leb128_encode_u32(func_buf, num_extra)
      let mut rli = 0
      while rli < num_extra {
        let actual_local_idx = param_count_for_body + rli
        let mut is_ref = false
        let mut ri = 0
        while ri < num_ref_locals {
          if Array::get(ref_indices, ri) == actual_local_idx {
            is_ref = true
          }
          ri = ri + 1
        }
        let mut is_native_array = false
        let mut nai = 0
        while nai < num_native_locals {
          if Array::get(native_indices, nai) == actual_local_idx {
            is_native_array = true
          }
          nai = nai + 1
        }
        leb128_encode_u32(func_buf, 1)
        // #538 ref cells remain linear-memory i64 cells. Only proven local
        // literals use a nullable typed GC reference.
        let _ = is_ref
        if is_native_array {
          bytebuf_push(func_buf, 99)
          leb128_encode_u32(func_buf, gc_native_array_type_idx)
        } else {
          bytebuf_push(func_buf, 126)
        }
        rli = rli + 1
      }
    }
    bytebuf_push_buf(func_buf, body)
    bytebuf_push(func_buf, 11)
    leb128_encode_u32(code_content, bytebuf_length(func_buf))
    bytebuf_push_buf(code_content, func_buf)
    ci = ci + 1
  }
  bytebuf_push_section(out, 10, code_content)
  if num_strings > 0 {
    let data_offsets = array_empty()
    let data_bufs = fresh_bytes_array()
    let mut di = 0
    while di < num_strings {
      Array::push(data_offsets, Array::get(str_offsets, di))
      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))
      di = di + 1
    }
    emit_data_section_multi(out, data_offsets, data_bufs)
  }
  bytebuf_to_bytes(out)
}
