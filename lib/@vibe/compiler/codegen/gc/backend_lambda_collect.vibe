//# Imports

import @vibe/compiler/core {
  Expr, TypeExpr
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/codegen/common_analysis {
  collect_free_vars
}

import ./backend_direct_abi_names.vibe {
  gc_capture_global_builtin_names
}

import @vibe/compiler/codegen/common_base {
  CompileCtxGc, CtorTable, FuncTable
}

//# Functions

export fn collect_lambda_captures_gc(params: Array[(String, Option[TypeExpr])], fn_body: Expr, ctx: CompileCtxGc) -> (Array[String], Int, Int) {
  let param_names_arr = array_empty()
  let func_table = ctx.func_table
  let ctor_table = ctx.gc_ctor_table
  let mut pi = 0
  while pi < Array::length(params) {
    let (pname, _) = Array::get(params, pi)
    Array::push(param_names_arr, pname)
    pi = pi + 1
  }
  let mut globals = Array::concat(func_table.names, ctor_table.names)
  // #538: names that resolve globally must not be captured as env slots --
  // module-level literal constants and the call-site-only desugar builtins
  // (handled by name in compile_call_gc, absent from the func table).
  globals = Array::concat(globals, ctx.gc_const_names)
  globals = Array::concat(globals, ctx.gc_global_names)
  globals = Array::concat(globals, [
    "__index",
    "__len",
    "__set_field",
    "__set_index",
    "__slice",
    "__rec_field"
  ])
  // The `__`-prefixed desugar builtins above are only 6 of the ~60 names
  // `compile_call_gc` dispatches by spelling, and this list had drifted from
  // that one: a closure calling any of the others captured the builtin's own
  // spelling as a free variable, then died in `emit_lambda_closure_gc` with
  // "reached code generation unresolved". Take the namespaced ones from the
  // single list in backend_direct_abi_names.vibe instead of restating them
  // here -- see
  // `gc_capture_global_builtin_names` for why bare spellings are excluded.
  globals = Array::concat(globals, gc_capture_global_builtin_names())
  let captures = collect_free_vars(fn_body, param_names_arr, globals)
  let num_captures = Array::length(captures)
  let user_params = Array::length(params)
  (captures, num_captures, user_params)
}
