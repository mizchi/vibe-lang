/// Emit one value already proven to inhabit the direct reference lane.
/// Unsupported shapes are an internal proof failure and abort compilation;
/// they are never reinterpreted as i64.
export fn gc_compile_native_array_ref(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with Exception) -> Int with Exception {
  match expr {
    EIdent(name, _) => {
      let slot = find_local_slot(local_names, name)
      if slot >= 0 && array_contains_int(ctx.gc_native_array_locals, slot) {
        emit_local_get(buf, slot)
        next_local
      } else {
        throw("gc direct ABI proof mismatch: expected native array local")
      }
    },
    // #1542: the reference lives in a struct field, so producing it is a
    // struct.get rather than a local.get.
    EDot(EIdent(ns_obj, _), ns_field, _, _) => {
      let ns_slot = find_local_slot(local_names, ns_obj)
      let ns_struct_idx = gc_slot_map_get(ctx.gc_native_struct_scope, ns_slot)
      let ns_fidx = gc_ctor_field_slot(ctx.gc_ctor_table, ns_struct_idx, ns_field)
      if ns_struct_idx >= 0 && ns_fidx >= 0 && gc_ctor_field_is_ref(ctx.gc_ctor_table, ns_struct_idx, ns_field) {
        emit_local_get(buf, ns_slot)
        emit_struct_get(buf, ctx.gc_native_struct_type_base + ns_struct_idx, ns_fidx)
        next_local
      } else {
        throw("gc direct ABI proof mismatch: expected a reference-lane struct field")
      }
    },
    EArray(elems) => {
      let slot = next_local
      Array::push(local_names, "[gc-temp]__gc_direct_array_arg")
      Array::push(ctx.gc_native_array_locals, slot)
      Array::push(ctx.gc_native_array_local_types, slot)
      emit_i32_const(buf, Array::length(elems))
      emit_array_new_default(buf, ctx.gc_native_array_type_idx)
      emit_local_set(buf, slot)
      let mut nl = next_local + 1
      let mut i = 0
      while i < Array::length(elems) {
        emit_local_get(buf, slot)
        emit_i32_const(buf, i)
        nl = ce(buf, Array::get(elems, i), local_names, nl, ld)
        emit_array_set(buf, ctx.gc_native_array_type_idx)
        i = i + 1
      }
      emit_local_get(buf, slot)
      nl
    },
    ECall(callee, args, _) => match callee {
      EIdent(name, _) => {
        let idx = gc_direct_abi_call_index(ctx, name)
        if find_local_slot(local_names, name) < 0 && idx >= 0 && Array::get(ctx.gc_direct_abi_return_refs, idx) {
          compile_call_gc(buf, callee, args, local_names, next_local, ctx, ld, ce)
        } else {
          throw("gc direct ABI proof mismatch: call does not return a native array")
        }
      },
      _ => throw("gc direct ABI proof mismatch: indirect native array call")
    },
    // Reference-lane join. The blocktype has to name a TYPE INDEX because the
    // result is `(ref null $native_i64_array)`, which has no single-byte value
    // type spelling; `gc_native_array_block_type_idx` is the base type reserved
    // for exactly this (backend_body.vibe).
    //
    // The local bookkeeping mirrors the i64 `if` in backend_expr.vibe and for
    // the same reason: a native slot is a typed local, so the else arm must
    // never reuse a slot the then arm allocated -- the sibling can legally bind
    // an ordinary i64 at the same lexical depth. Start the else arm above the
    // then arm's high-water mark so the declaration list stays monotonic.
    EIf(cond, then_e, else_e) => {
      if ctx.gc_native_array_block_type_idx < 0 {
        throw("gc direct ABI proof mismatch: no blocktype for a reference-lane join")
      } else {
        ()
      }
      let nl_cond = ce(buf, cond, local_names, next_local, ld)
      emit_i32_wrap_i64(buf)
      emit_if_type_index(buf, ctx.gc_native_array_block_type_idx)
      let names_len_before = Array::length(local_names)
      let nl_then = gc_compile_native_array_ref(buf, then_e, local_names, nl_cond, ctx, ld, ce)
      emit_else(buf)
      gc_reset_join_arm_slots(local_names, ctx, names_len_before, nl_then)
      let nl_else = gc_compile_native_array_ref(buf, else_e, local_names, nl_then, ctx, ld, ce)
      emit_end(buf)
      gc_reset_join_arm_slots(local_names, ctx, names_len_before, nl_else)
      nl_else
    },
    _ => throw("gc direct ABI proof mismatch: unsupported native array expression")
  }
}

/// #3129: a `MutList::*` / `MutBytes::*` call is the BUILTIN `target` under
/// another spelling. Re-dispatching it as a call spelled `target` let a
/// program's own function of that name capture it (a program `Array::length`
/// answered 77 for `MutList::length` of a three-element list). When the
/// program defines `target`, call the builtin's table entry directly, with
/// the same argument handling as the resolved-call fallback in
/// `compile_call_gc`; otherwise the spelling is unambiguous and keeps its
/// ordinary lowering.
fn gc_mut_alias_call(buf: Bytes, target: String, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with Exception) -> Int with Exception {
  let eff_target = gc_direct_abi_twin_callee(ctx, target)
  let pos = if func_table_user_index_of(ctx.func_table, target, ctx.num_user_funcs) >= 0 {
    func_table_builtin_pos_of(ctx.func_table, eff_target, ctx.num_user_funcs)
  } else {
    -1
  }
  if pos < 0 {
    ce(buf, ECall(EIdent(target, -1), args, -1), local_names, next_local, ld)
  } else {
    let fidx = Array::get(ctx.func_table.indices, pos)
    let has_ret = Array::get(ctx.func_table.returns, pos)
    let direct_idx = gc_direct_abi_call_index(ctx, eff_target)
    let mut nl = next_local
    let mut ci = 0
    while ci < Array::length(args) {
      if direct_idx >= 0 && Array::get(Array::get(ctx.gc_direct_abi_param_refs, direct_idx), ci) {
        nl = gc_compile_native_array_ref(buf, Array::get(args, ci), local_names, nl, ctx, ld, ce)
      } else {
        nl = ce(buf, Array::get(args, ci), local_names, nl, ld)
      }
      ci = ci + 1
    }
    if ctx.func_offset > 0 && fidx >= ctx.func_offset {
      emit_i64_const(buf, 0)
    } else {
      ()
    }
    emit_call(buf, fidx)
    if has_ret == 0 {
      emit_i64_const(buf, 0)
    } else {
      ()
    }
    nl
  }
}

fn compile_call_gc(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with Exception) -> Int with Exception {
  match callee {
    EIdent(source_name, _) => {
      // Match checker/linear shadowing: an alias spelling is a builtin only
      // when the original source name has no function or local binding.
      let source_is_bound = func_table_index_of(ctx.func_table, source_name) >= 0 || find_local_slot(local_names, source_name) >= 0
      let fname = if source_is_bound {
        source_name
      } else {
        canonical_builtin_name(source_name)
      }
      // A refusal emits no call, including inside a lambda: its body is
      // compiled before capture emission. The direct-ABI list must leave
      // these spellings available to user definitions.
      // review-lint: allow-gc-direct-abi-unlisted
      if (fname == "await" || fname == "Future::ready" || fname == "Future::pending" || fname == "Future::resolve") && !gc_name_is_user_defined(ctx, local_names, fname) {
        throw("compile with the linear or RC backend: the wasm-gc backend does not support the builtin `\{fname}` yet")
      }
      // #1733: FrozenArray's two conversions must COPY, on this backend too.
      // Body 16 (the ArrayBuilder::freeze identity cast) is what they used to
      // map to in backend_body.vibe, which made `FrozenArray` mutable through
      // either end and took away the reason it is on the Send allowlist. The
      // rewrite mirrors the linear lane's (codegen/expr/compile_call.vibe):
      // bind the value once, then slice it. Guarded on the name not resolving
      // to anything real, same as every other builtin spelling here.
      //
      // The marker on the next line suppresses the gc_direct_abi_names() drift
      // rule, deliberately: both conversions have real func-table bodies, so
      // `globals` already keeps the lambda capture scan off them -- this is a
      // rewrite of a call that already resolves, not a spelling that exists
      // only here. Measured before suppressing: a closure calling
      // `FrozenArray::from_array` compiles and runs on both lanes. Listing
      // them would instead claim a user declaration with those names is
      // unsafe, which is not what this branch means.
      // ADR-0090 (#1262): regions on the gc lane, arena-free tier.
      //
      // The linear lane has two tiers: these source-level rewrites, and on top
      // of them an arena (watermark save/restore + a segment allocator) for
      // bulk release. Correctness lives entirely in the first tier -- the
      // arena is the reclamation optimization -- so the gc lane gets regions
      // that RUN CORRECTLY here, and the arena stays a separate question.
      //
      // `__region_run(lam)` calls the body immediately with a dummy token (0).
      // The token exists only for the checker's skolem escape scan; it has no
      // runtime representation, which is why passing 0 is not a placeholder
      // but the actual lowering.
      //
      // With tier 2 present (`gc_region_ptr_addr >= 0`) the body call is
      // bracketed by the arena watermark save/restore -- the SAME two
      // emitters the linear lane uses, now shared from common_base so the
      // save/restore protocol cannot change on one lane only.
      // #1937: the body sits in try_table catch (tag 0, same as EHandle);
      // a throw runs exit then rethrows so depth cannot fill the save table.
      if !source_is_bound && fname == "__region_run" && Array::length(args) == 1 {
        if ctx.gc_region_ptr_addr >= 0 {
          emit_region_enter(buf, ctx.gc_region_ptr_addr)
          if ctx.gc_region_exn_tag >= 0 {
            emit_region_try_prologue(buf, ctx.gc_region_exn_tag)
            let region_r = ce(buf, ECall(Array::get(args, 0), [EInt(0)], -1), local_names, next_local, region_try_body_ld(ld))
            emit_region_try_epilogue(buf, ctx.gc_region_ptr_addr, ctx.gc_region_exn_tag)
            return region_r
          } else {
            let region_r = ce(buf, ECall(Array::get(args, 0), [EInt(0)], -1), local_names, next_local, ld)
            emit_region_exit(buf, ctx.gc_region_ptr_addr)
            return region_r
          }
        } else {
          return ce(buf, ECall(Array::get(args, 0), [EInt(0)], -1), local_names, next_local, ld)
        }
      } else {
        ()
      }
      // With an arena the storage comes from the segment; without one
      // `MutList` storage IS an ArrayBuilder, as before. Either way the region
      // token is not evaluated -- by construction it is the pure binder ident
      // the parser emitted.
      if !source_is_bound && fname == "MutList::empty" && Array::length(args) == 1 {
        if ctx.gc_region_arr_new_func_idx >= 0 {
          emit_call(buf, ctx.gc_region_arr_new_func_idx)
          return next_local
        } else {
          ()
        }
        let no_args = Array::slice([EInt(0)], 0, 0)
        return ce(buf, ECall(EIdent("ArrayBuilder::new", -1), no_args, -1), local_names, next_local, ld)
      } else {
        ()
      }
      // Arena-free, `MutList` storage IS an ArrayBuilder, so the mutating and
      // reading operations are the ArrayBuilder/Array ones under another
      // spelling. The linear lane reaches the same place by registering these
      // as builtins whose bodies alias those; rewriting at the call site keeps
      // the gc lane's arena-free tier in one block.
      if !source_is_bound && fname == "MutList::push" && Array::length(args) == 2 {
        return gc_mut_alias_call(buf, "ArrayBuilder::push", args, local_names, next_local, ctx, ld, ce)
      } else {
        ()
      }
      if !source_is_bound && fname == "MutList::get" && Array::length(args) == 2 {
        return gc_mut_alias_call(buf, "Array::get", args, local_names, next_local, ctx, ld, ce)
      } else {
        ()
      }
      if !source_is_bound && fname == "MutList::length" && Array::length(args) == 1 {
        return gc_mut_alias_call(buf, "Array::length", args, local_names, next_local, ctx, ld, ce)
      } else {
        ()
      }
      if !source_is_bound && fname == "MutList::truncate" && Array::length(args) == 2 {
        return gc_mut_alias_call(buf, "Array::truncate", args, local_names, next_local, ctx, ld, ce)
      } else {
        ()
      }
      // The Bytes half of the same tier. `MutBytes` storage IS a `Bytes`
      // without an arena, so the operations are the Bytes ones under another
      // spelling, and the exit copies for the same reason as MutList's.
      if !source_is_bound && fname == "MutBytes::empty" && Array::length(args) == 1 {
        if ctx.gc_region_bytes_new_func_idx >= 0 {
          emit_call(buf, ctx.gc_region_bytes_new_func_idx)
          return next_local
        } else {
          ()
        }
        let no_bytes_args = Array::slice([EInt(0)], 0, 0)
        return ce(buf, ECall(EIdent("Bytes::new", -1), no_bytes_args, -1), local_names, next_local, ld)
      } else {
        ()
      }
      if !source_is_bound && fname == "MutBytes::to_bytes" && Array::length(args) == 1 {
        return ce(buf, region_mutbytes_exit_copy(Array::get(args, 0)), local_names, next_local, ld)
      } else {
        ()
      }
      if !source_is_bound && fname == "MutBytes::push" && Array::length(args) == 2 {
        return gc_mut_alias_call(buf, "Bytes::push", args, local_names, next_local, ctx, ld, ce)
      } else {
        ()
      }
      if !source_is_bound && fname == "MutBytes::append" && Array::length(args) == 2 {
        return gc_mut_alias_call(buf, "Bytes::append", args, local_names, next_local, ctx, ld, ce)
      } else {
        ()
      }
      if !source_is_bound && fname == "MutBytes::length" && Array::length(args) == 1 {
        return gc_mut_alias_call(buf, "Bytes::length", args, local_names, next_local, ctx, ld, ce)
      } else {
        ()
      }
      // The sanctioned region exits COPY (see region_mutlist_exit_copy).
      if !source_is_bound && (fname == "MutList::freeze" || fname == "MutList::to_array") && Array::length(args) == 1 {
        return ce(buf, region_mutlist_exit_copy(Array::get(args, 0)), local_names, next_local, ld)
      } else {
        ()
      }
      // #729/#730 + #1262: `Fs::readdir` surface. The host import returns the
      // entries NUL-joined (#2957) as ONE packed string, so turning it into
      // Array[String] is a source-level rewrite -- the SAME rewrite the linear
      // lane does, taken from the shared builder rather than spelled out again
      // here (that duplication is what drifted in #1809).
      if !source_is_bound && fname == "Fs::readdir" && Array::length(args) == 1 {
        return ce(buf, packed_dir_entries_to_array_expr(ECall(EIdent("vibe_fs_read_dir_raw", -1), [
          Array::get(args, 0)
        ], -1), "__rd_names"), local_names, next_local, ld)
      } else {
        ()
      }
      if !source_is_bound && Array::length(args) == 1 && (fname == "FrozenArray::from_array" || fname == "FrozenArray::to_array") {
        // review-lint: allow-gc-direct-abi-unlisted
        let ftmp = if fname == "FrozenArray::from_array" {
          // review-lint: allow-gc-direct-abi-unlisted
          "__frozen_in"
        } else {
          "__frozen_out"
        }
        return ce(buf, gc_frozen_conversion_copy(Array::get(args, 0), ftmp), local_names, next_local, ld)
      } else {
        ()
      }
      if fname == "Map::iter_get" && Array::length(args) == 2 && !gc_name_is_user_defined(ctx, local_names, fname) {
        return gc_compile_map_iter_get_checked(buf, Array::get(args, 0), Array::get(args, 1), local_names, next_local, ld, ce)
      } else {
        ()
      }
      let native_slot = gc_native_array_receiver_slot(args, local_names, ctx)
      // #3132: the shortcuts below ARE the builtins; a call the program
      // resolves to its own function of that name must not take them.
      let native_receiver = Array::length(args) > 0 && (native_slot >= 0 || gc_expr_is_native_array_ref(Array::get(args, 0), local_names, ctx)) && !gc_name_is_user_defined(ctx, local_names, fname)
      if native_receiver && fname == "Array::length" && Array::length(args) == 1 {
        let nl = if native_slot >= 0 {
          emit_local_get(buf, native_slot)
          next_local
        } else {
          gc_compile_native_array_ref(buf, Array::get(args, 0), local_names, next_local, ctx, ld, ce)
        }
        emit_array_len(buf)
        emit_i64_extend_i32_u(buf)
        return nl
      } else if native_receiver && fname == "Array::get" && Array::length(args) == 2 {
        let nl0 = if native_slot >= 0 {
          emit_local_get(buf, native_slot)
          next_local
        } else {
          gc_compile_native_array_ref(buf, Array::get(args, 0), local_names, next_local, ctx, ld, ce)
        }
        let nl = ce(buf, Array::get(args, 1), local_names, nl0, ld)
        emit_i32_wrap_i64(buf)
        emit_array_get(buf, ctx.gc_native_array_type_idx)
        return nl
      } else if native_receiver && fname == "Array::set" && Array::length(args) == 3 {
        let nl0 = if native_slot >= 0 {
          emit_local_get(buf, native_slot)
          next_local
        } else {
          gc_compile_native_array_ref(buf, Array::get(args, 0), local_names, next_local, ctx, ld, ce)
        }
        let nl1 = ce(buf, Array::get(args, 1), local_names, nl0, ld)
        emit_i32_wrap_i64(buf)
        let nl2 = ce(buf, Array::get(args, 2), local_names, nl1, ld)
        emit_array_set(buf, ctx.gc_native_array_type_idx)
        emit_i64_const(buf, 0)
        return nl2
      } else {
        ()
      }
      if fname == "Stdin::read_via_stream" || fname == "StdinStream::next" || fname == "StdinStream::close" || fname == "StdinStream::read_chunk" {
        throw("StdinStream is unsupported on gc backend; compile an Async component with the linear or RC backend")
      } else {
        ()
      }
      let ctor_lookup_idx = ctor_table_index_of(ctx.gc_ctor_table, fname)
      gc_compile_named_1(buf, callee, args, local_names, next_local, ctx, ld, ce, fname, source_is_bound, ctor_lookup_idx, compile_call_gc, gc_mut_alias_call, gc_compile_native_array_ref)
    },
    _ => {
      let num_args = Array::length(args)
      let fn_val_local = next_local
      let slot_local = next_local + 1
      let env_local = next_local + 2
      let mut nl = next_local + 3
      Array::push(local_names, "[gc-temp]__fn_val")
      Array::push(local_names, "[gc-temp]__slot")
      Array::push(local_names, "[gc-temp]__env")
      nl = ce(buf, callee, local_names, nl, ld)
      emit_local_set(buf, fn_val_local)
      emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
      let mut ci = 0
      while ci < num_args {
        nl = ce(buf, Array::get(args, ci), local_names, nl, ld)
        ci = ci + 1
      }
      emit_closure_call_tail(buf, env_local, slot_local, ctx.closure_type_base, num_args)
      nl
    }
  }
}

//# Misc

// Ordered named-call dispatch group.
fn gc_compile_named_1(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with Exception, fname: String, source_is_bound: Bool, ctor_lookup_idx: Int, compile_call_gc_fn: (Bytes, Expr, Array[Expr], Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with Exception) -> Int with Exception, gc_mut_alias_call_fn: (Bytes, String, Array[Expr], Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with Exception) -> Int with Exception, gc_compile_native_array_ref_fn: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with Exception) -> Int with Exception) -> Int with Exception {
  if ctor_lookup_idx >= 0 {
    let tag = Array::get(ctx.gc_ctor_table.tags, ctor_lookup_idx)
    let fc = Array::get(ctx.gc_ctor_table.field_counts, ctor_lookup_idx)
    let obj_size = 8 + fc * 8
    let ptr_local = next_local
    Array::push(local_names, "[gc-temp]__ctor_ptr")
    emit_global_get(buf, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, ptr_local)
    emit_global_get(buf, 0)
    emit_i32_const(buf, obj_size)
    emit_i32_add(buf)
    emit_global_set(buf, 0)
    // #415: gc-lane heap bump must grow linear memory like the linear
    // backend does -- without this any allocation past the initial page
    // traps OOB (the gc smoke fixture only ever allocated a few bytes).
    emit_heap_memory_grow_check(buf)
    emit_local_get(buf, ptr_local)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, tag)
    emit_i32_store(buf, 2, 0)
    emit_local_get(buf, ptr_local)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, fc)
    emit_i32_store(buf, 2, 4)
    let actual_args = if Array::length(args) == 1 {
      match Array::get(args, 0) {
        ERecord(_, rec_fields, _) => {
          let rec find_sn: (Int) -> Int = (sni) -> {
            if sni >= Array::length(ctx.gc_ctor_table.struct_names) {
              -1
            }
            else if Array::get(ctx.gc_ctor_table.struct_names, sni) == fname {
              sni
            }
            else find_sn(sni + 1)
          }
          let sn_idx = find_sn(0)
          if sn_idx >= 0 {
            let def_fnames = Array::get(ctx.gc_ctor_table.struct_field_names, sn_idx)
            let ordered = array_empty()
            let mut oi = 0
            while oi < Array::length(def_fnames) {
              let target_name = Array::get(def_fnames, oi)
              let rec find_rf: (Int) -> Expr = (ri) -> {
                if ri >= Array::length(rec_fields) {
                  EUnit
                }
                else {
                  let (rfn, rfv) = Array::get(rec_fields, ri)
                  if rfn == target_name {
                    rfv
                  }
                  else find_rf(ri + 1)
                }
              }
              Array::push(ordered, find_rf(0))
              oi = oi + 1
            }
            ordered
          } else {
            args
          }
        },
        _ => args
      }
    } else {
      args
    }
    let mut nl_c = next_local + 1
    let mut fi_c = 0
    while fi_c < Array::length(actual_args) {
      nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ld)
      let val_local = nl_c
      Array::push(local_names, "[gc-temp]__ctor_val")
      emit_local_set(buf, val_local)
      nl_c = nl_c + 1
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, val_local)
      emit_i64_store(buf, 3, 8 + fi_c * 8)
      fi_c = fi_c + 1
    }
    emit_local_get(buf, ptr_local)
    emit_i64_const(buf, 1)
    emit_i64_or(buf)
    nl_c
  }
  else if fname == "__slice" {
    let (ss_idx, _, _) = resolve_func(ctx.func_table, "String::substring")
    let (bs_idx, _, _) = resolve_func(ctx.func_table, "Bytes::slice")
    let (as_idx, _, _) = resolve_func(ctx.func_table, "Array::slice")
    let obj_local = next_local
    let start_local = next_local + 1
    let end_local = next_local + 2
    let ptr_local = next_local + 3
    let cap_local = next_local + 4
    Array::push(local_names, "[gc-temp]__slice_obj")
    Array::push(local_names, "[gc-temp]__slice_start")
    Array::push(local_names, "[gc-temp]__slice_end")
    Array::push(local_names, "[gc-temp]__slice_ptr")
    Array::push(local_names, "[gc-temp]__slice_cap")
    let mut nl = next_local + 5
    nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
    emit_local_set(buf, obj_local)
    nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
    emit_local_set(buf, start_local)
    nl = ce(buf, Array::get(args, 2), local_names, nl, ld)
    emit_local_set(buf, end_local)
    emit_local_get(buf, obj_local)
    emit_i64_const(buf, 32)
    emit_i64_shr_s(buf)
    emit_i64_eqz(buf)
    emit_if_i64(buf)
    emit_local_get(buf, obj_local)
    emit_local_set(buf, ptr_local)
    emit_local_get(buf, ptr_local)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, cap_local)
    emit_local_get(buf, cap_local)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 2147483647)
    emit_i32_gt_u(buf)
    emit_if_i64(buf)
    emit_local_get(buf, obj_local)
    emit_local_get(buf, start_local)
    emit_local_get(buf, end_local)
    emit_call_resolved(buf, ctx, bs_idx)
    emit_else(buf)
    emit_local_get(buf, obj_local)
    emit_local_get(buf, start_local)
    emit_local_get(buf, end_local)
    emit_call_resolved(buf, ctx, as_idx)
    emit_end(buf)
    emit_else(buf)
    emit_local_get(buf, obj_local)
    emit_local_get(buf, start_local)
    emit_local_get(buf, end_local)
    emit_call_resolved(buf, ctx, ss_idx)
    emit_end(buf)
    nl
  }
  else if fname == "__index" {
    let (sg_idx, _, _) = resolve_func(ctx.func_table, "String::char_code_at")
    let (bg_idx, _, _) = resolve_func(ctx.func_table, "Bytes::get")
    let (ag_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
    let obj_local = next_local
    let idx_local = next_local + 1
    let ptr_local = next_local + 2
    let cap_local = next_local + 3
    Array::push(local_names, "[gc-temp]__index_obj")
    Array::push(local_names, "[gc-temp]__index_idx")
    Array::push(local_names, "[gc-temp]__index_ptr")
    Array::push(local_names, "[gc-temp]__index_cap")
    let mut nl = next_local + 4
    nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
    emit_local_set(buf, obj_local)
    nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
    emit_local_set(buf, idx_local)
    emit_local_get(buf, obj_local)
    emit_i64_const(buf, 32)
    emit_i64_shr_s(buf)
    emit_i64_eqz(buf)
    emit_if_i64(buf)
    emit_local_get(buf, obj_local)
    emit_local_set(buf, ptr_local)
    emit_local_get(buf, ptr_local)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, cap_local)
    emit_local_get(buf, cap_local)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 2147483647)
    emit_i32_gt_u(buf)
    emit_if_i64(buf)
    emit_local_get(buf, obj_local)
    emit_local_get(buf, idx_local)
    emit_call_resolved(buf, ctx, bg_idx)
    emit_else(buf)
    emit_local_get(buf, obj_local)
    emit_local_get(buf, idx_local)
    emit_call_resolved(buf, ctx, ag_idx)
    emit_end(buf)
    emit_else(buf)
    emit_local_get(buf, obj_local)
    emit_local_get(buf, idx_local)
    emit_call_resolved(buf, ctx, sg_idx)
    emit_end(buf)
    nl
  }
  else if fname == "__set_field" {
    let field = get_estring_value(Array::get(args, 1))
    let fc = String::char_code_at(field, 0)
    let is_numeric = fc >= 48 && fc <= 57
    if is_numeric {
      let mut vi = 0
      let mut vp = 0
      while vp < String::length(field) {
        vi = vi * 10 + (String::char_code_at(field, vp) - 48)
        vp = vp + 1
      }
      let mut nl = next_local
      nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      nl = ce(buf, Array::get(args, 2), local_names, nl, ld)
      emit_i64_store(buf, 3, vi * 8)
      emit_i64_const(buf, 1)
      nl
    } else {
      // #1702 writes: a native wasm-gc struct local. Its exact struct was
      // fixed at the binding site, so the field index is static -- and the
      // tag dispatch below is impossible here anyway, because a native
      // struct carries no ctor tag.
      let ns_slot = match Array::get(args, 0) {
        EIdent(ns_obj, _) => find_local_slot(local_names, ns_obj),
        _ => 0 - 1
      }
      let ns_struct_idx = gc_slot_map_get(ctx.gc_native_struct_scope, ns_slot)
      if ns_struct_idx >= 0 {
        let ns_declared = Array::get(ctx.gc_ctor_table.struct_field_names, ns_struct_idx)
        let ns_field_refs = Array::get(ctx.gc_ctor_table.struct_field_is_ref, ns_struct_idx)
        let mut ns_fidx = 0 - 1
        let mut ns_i = 0
        while ns_i < Array::length(ns_declared) {
          if ns_fidx < 0 && Array::get(ns_declared, ns_i) == field {
            ns_fidx = ns_i
          } else {
            ()
          }
          ns_i = ns_i + 1
        }
        if ns_fidx < 0 {
          throw("gc native struct: stored field is not declared on the bound struct")
        } else {
          ()
        }
        emit_local_get(buf, ns_slot)
        let ns_nl = if Array::get(ns_field_refs, ns_fidx) {
          gc_compile_native_array_ref_fn(buf, Array::get(args, 2), local_names, next_local, ctx, ld, ce)
        } else {
          ce(buf, Array::get(args, 2), local_names, next_local, ld)
        }
        emit_struct_set(buf, ctx.gc_native_struct_type_base + ns_struct_idx, ns_fidx)
        emit_i64_const(buf, 1)
        return ns_nl
      } else {
        ()
      }
      // #722: same struct-tag dispatch as the linear __set_field — a
      // same-named `mut` field can live at a different slot in another
      // struct, and the static first-match store would corrupt it.
      let cands = struct_field_candidates(ctx.gc_ctor_table, field)
      if Array::length(cands) == 0 {
        throw(String::concat("unknown struct field: ", field))
      }
      let (_, idx0) = Array::get(cands, 0)
      let dispatch = struct_field_dispatch_cases(cands)
      if Array::length(dispatch) == 0 {
        let mut nl = next_local
        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
        emit_i64_const(buf, -2)
        emit_i64_and(buf)
        emit_i32_wrap_i64(buf)
        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)
        emit_i64_store(buf, 3, 8 + idx0 * 8)
        emit_i64_const(buf, 1)
        nl
      } else {
        let mut nl = next_local
        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
        emit_i64_const(buf, -2)
        emit_i64_and(buf)
        let obj_l = nl
        Array::push(local_names, "[gc-temp]__setf_obj")
        emit_local_set(buf, obj_l)
        nl = ce(buf, Array::get(args, 2), local_names, nl + 1, ld)
        let val_l = nl
        Array::push(local_names, "[gc-temp]__setf_val")
        emit_local_set(buf, val_l)
        let mut di = 0
        while di < Array::length(dispatch) {
          let (dtag, didx) = Array::get(dispatch, di)
          emit_local_get(buf, obj_l)
          emit_i32_wrap_i64(buf)
          emit_i32_load(buf, 2, 0)
          emit_i32_const(buf, dtag)
          emit_i32_eq(buf)
          emit_if_void(buf)
          emit_local_get(buf, obj_l)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, val_l)
          emit_i64_store(buf, 3, 8 + didx * 8)
          emit_else(buf)
          di = di + 1
        }
        emit_local_get(buf, obj_l)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, val_l)
        emit_i64_store(buf, 3, 8 + idx0 * 8)
        let mut de = 0
        while de < Array::length(dispatch) {
          emit_end(buf)
          de = de + 1
        }
        emit_i64_const(buf, 1)
        nl + 1
      }
    }
  }
  else if fname == "__rec_field" {
    // #760(4): positional record field read `__rec_field(rec, i)` — emitted
    // by the record-pattern destructure (parser) and the anonymous-record
    // dot-access lowering (desugar_trait_dict). gc records are
    // [tag@0][len@4][fields@8+i*8], the same shape as the linear backend, so
    // the field load is `8 + i*8` after untagging the pointer. Mirrors the
    // linear __rec_field in compile_call.vibe.
    let field_idx = match Array::get(args, 1) {
      EInt(n) => n,
      _ => throw("__rec_field: index must be an int literal")
    }
    let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
    emit_i64_const(buf, -2)
    emit_i64_and(buf)
    emit_i32_wrap_i64(buf)
    emit_i64_load(buf, 3, 8 + field_idx * 8)
    nl
  }
  else if fname == "__len" {
    let (sl_idx, _, _) = resolve_func(ctx.func_table, "String::length")
    let (bl_idx, _, _) = resolve_func(ctx.func_table, "Bytes::length")
    let (al_idx, _, _) = resolve_func(ctx.func_table, "Array::length")
    let obj_local = next_local
    let ptr_local = next_local + 1
    let cap_local = next_local + 2
    Array::push(local_names, "[gc-temp]__len_obj")
    Array::push(local_names, "[gc-temp]__len_ptr")
    Array::push(local_names, "[gc-temp]__len_cap")
    let mut nl = next_local + 3
    nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
    emit_local_set(buf, obj_local)
    emit_local_get(buf, obj_local)
    emit_i64_const(buf, 32)
    emit_i64_shr_s(buf)
    emit_i64_eqz(buf)
    emit_if_i64(buf)
    emit_local_get(buf, obj_local)
    emit_local_set(buf, ptr_local)
    emit_local_get(buf, ptr_local)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, cap_local)
    emit_local_get(buf, cap_local)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 2147483647)
    emit_i32_gt_u(buf)
    emit_if_i64(buf)
    emit_local_get(buf, obj_local)
    emit_call_resolved(buf, ctx, bl_idx)
    emit_else(buf)
    emit_local_get(buf, obj_local)
    emit_call_resolved(buf, ctx, al_idx)
    emit_end(buf)
    emit_else(buf)
    emit_local_get(buf, obj_local)
    emit_call_resolved(buf, ctx, sl_idx)
    emit_end(buf)
    nl
  }
  else if fname == "Float::to_int" && Array::length(args) == 1 {
    ce(buf, ECall(EIdent("Double::to_int", -1), [Array::get(args, 0)], -1), local_names, next_local, ld)
  }
  else if fname == "Map::values" {
    let (arr_new_fi, _, _) = resolve_func(ctx.func_table, "array_new")
    let (arr_push_fi, _, _) = resolve_func(ctx.func_table, "Array::push")
    let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
    let map_l = nl
    let res_l = nl + 1
    let cnt_l = nl + 2
    let i_l = nl + 3
    Array::push(local_names, "[gc-temp]__values_map")
    Array::push(local_names, "[gc-temp]__values_res")
    Array::push(local_names, "[gc-temp]__values_cnt")
    Array::push(local_names, "[gc-temp]__values_i")
    emit_local_set(buf, map_l)
    emit_call_resolved(buf, ctx, arr_new_fi)
    emit_local_set(buf, res_l)
    emit_local_get(buf, map_l)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, cnt_l)
    emit_i64_const(buf, 0)
    emit_local_set(buf, i_l)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf, i_l)
    emit_local_get(buf, cnt_l)
    emit_i64_ge_s(buf)
    emit_br_if(buf, 1)
    emit_local_get(buf, res_l)
    emit_local_get(buf, map_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf, i_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 16)
    emit_i32_mul(buf)
    emit_i32_add(buf)
    emit_i64_load(buf, 3, 16)
    emit_call_resolved(buf, ctx, arr_push_fi)
    emit_local_get(buf, i_l)
    emit_i64_const(buf, 1)
    emit_i64_add(buf)
    emit_local_set(buf, i_l)
    emit_br(buf, 0)
    emit_end(buf)
    emit_end(buf)
    emit_local_get(buf, res_l)
    nl + 4
  }
  else if !source_is_bound && fname == "Path::to_string" && Array::length(args) == 1 {
    // #762: PathRef / DynamicPath wrap a raw String; to_string is identity.
    ce(buf, Array::get(args, 0), local_names, next_local, ld)
  }
  else if !source_is_bound && fname == "Path::is_absolute" && Array::length(args) == 1 {
    // #762: absolute iff the path begins with '/'. `eq(char_code_at(x, 0),
    // 47)` avoids synthesizing a "/" string, which would not be in the
    // string table.
    ce(buf, ECall(EIdent("eq", -1), [
      ECall(EIdent("String::char_code_at", -1), [Array::get(args, 0), EInt(0)], -1),
      EInt(47)
    ], -1), local_names, next_local, ld)
  }
  else if !source_is_bound && fname == "String::to_bytes" {
    let (an_idx, _, _) = resolve_func(ctx.func_table, "array_new")
    let (ap_idx, _, _) = resolve_func(ctx.func_table, "Array::push")
    let (sl_idx, _, _) = resolve_func(ctx.func_table, "String::length")
    let (sc_idx, _, _) = resolve_func(ctx.func_table, "String::char_code_at")
    let str_local = next_local
    let res_local = next_local + 1
    let len_local = next_local + 2
    let i_local = next_local + 3
    Array::push(local_names, "[gc-temp]__tb_str")
    Array::push(local_names, "[gc-temp]__tb_res")
    Array::push(local_names, "[gc-temp]__tb_len")
    Array::push(local_names, "[gc-temp]__tb_idx")
    let mut nl = next_local + 4
    nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
    emit_local_set(buf, str_local)
    emit_call_resolved(buf, ctx, an_idx)
    emit_local_set(buf, res_local)
    emit_local_get(buf, str_local)
    emit_call_resolved(buf, ctx, sl_idx)
    emit_local_set(buf, len_local)
    emit_i64_const(buf, 0)
    emit_local_set(buf, i_local)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf, i_local)
    emit_local_get(buf, len_local)
    emit_i64_ge_s(buf)
    emit_br_if(buf, 1)
    emit_local_get(buf, res_local)
    emit_local_get(buf, str_local)
    emit_local_get(buf, i_local)
    emit_call_resolved(buf, ctx, sc_idx)
    emit_call_resolved(buf, ctx, ap_idx)
    emit_local_get(buf, i_local)
    emit_i64_const(buf, 1)
    emit_i64_add(buf)
    emit_local_set(buf, i_local)
    emit_br(buf, 0)
    emit_end(buf)
    emit_end(buf)
    emit_local_get(buf, res_local)
    nl
  }
  else if fname == "Double::abs" || fname == "Double::floor" || fname == "Double::ceil" {
    let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
    emit_f64_reinterpret_i64(buf)
    if fname == "Double::abs" {
      emit_f64_abs(buf)
    } else if fname == "Double::floor" {
      emit_f64_floor(buf)
    } else {
      emit_f64_ceil(buf)
    }
    emit_i64_reinterpret_f64(buf)
    nl
  }
  else if fname == "Double::max" || fname == "Double::min" {
    let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
    emit_f64_reinterpret_i64(buf)
    nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
    emit_f64_reinterpret_i64(buf)
    if fname == "Double::max" {
      emit_f64_max(buf)
    } else {
      emit_f64_min(buf)
    }
    emit_i64_reinterpret_f64(buf)
    nl
  }
  else if fname == "Double::parse" && !gc_name_is_user_defined(ctx, local_names, fname) {
    double_runtime_require(ctx.func_table, double_runtime_parse_name())
    ce(buf, double_parse_expr(Array::get(args, 0)), local_names, next_local, ld)
