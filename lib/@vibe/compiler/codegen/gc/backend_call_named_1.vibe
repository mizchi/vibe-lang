    let (an_idx, _, _) = resolve_func(ctx.func_table, "array_new")
    let (ap_idx, _, _) = resolve_func(ctx.func_table, "Array::push")
    let (ag_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
    let (al_idx, _, _) = resolve_func(ctx.func_table, "Array::length")
    let a_local = next_local
    let b_local = next_local + 1
    let new_arr_local = next_local + 2
    let i_local = next_local + 3
    let len_local = next_local + 4
    Array::push(local_names, "[gc-temp]__concat_a")
    Array::push(local_names, "[gc-temp]__concat_b")
    Array::push(local_names, "[gc-temp]__concat_new")
    Array::push(local_names, "[gc-temp]__concat_i")
    Array::push(local_names, "[gc-temp]__concat_len")
    let mut nl = next_local + 5
    nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
    emit_local_set(buf, a_local)
    nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
    emit_local_set(buf, b_local)
    emit_call_resolved(buf, ctx, an_idx)
    emit_local_set(buf, new_arr_local)
    emit_i64_const(buf, 0)
    emit_local_set(buf, i_local)
    emit_local_get(buf, a_local)
    emit_call_resolved(buf, ctx, al_idx)
    emit_local_set(buf, len_local)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf, i_local)
    emit_local_get(buf, len_local)
    emit_i64_ge_s(buf)
    emit_br_if(buf, 1)
    emit_local_get(buf, new_arr_local)
    emit_local_get(buf, a_local)
    emit_local_get(buf, i_local)
    emit_call_resolved(buf, ctx, ag_idx)
    emit_call_resolved(buf, ctx, ap_idx)
    emit_local_get(buf, i_local)
    emit_i64_const(buf, 1)
    emit_i64_add(buf)
    emit_local_set(buf, i_local)
    emit_br(buf, 0)
    emit_end(buf)
    emit_end(buf)
    emit_i64_const(buf, 0)
    emit_local_set(buf, i_local)
    emit_local_get(buf, b_local)
    emit_call_resolved(buf, ctx, al_idx)
    emit_local_set(buf, len_local)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf, i_local)
    emit_local_get(buf, len_local)
    emit_i64_ge_s(buf)
    emit_br_if(buf, 1)
    emit_local_get(buf, new_arr_local)
    emit_local_get(buf, b_local)
    emit_local_get(buf, i_local)
    emit_call_resolved(buf, ctx, ag_idx)
    emit_call_resolved(buf, ctx, ap_idx)
    emit_local_get(buf, i_local)
    emit_i64_const(buf, 1)
    emit_i64_add(buf)
    emit_local_set(buf, i_local)
    emit_br(buf, 0)
    emit_end(buf)
    emit_end(buf)
    emit_local_get(buf, new_arr_local)
    nl
  }
  else if fname == "Array::truncate" {
    // #538 P4.5: this was a drop-args no-op stub, so every direct
    // `Array::truncate(arr, n)` silently kept the old length -- the
    // checker's worklist loops (pop = truncate) never terminated when the
    // gc-compiled compiler ran. Call the real generated body (idx 40).
    let (at_idx, _, _) = resolve_func(ctx.func_table, "Array::truncate")
    let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
    nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
    emit_call_resolved(buf, ctx, at_idx)
    emit_i64_const(buf, 0)
    nl
  }
  else if fname == "Array::push_all" {
    let (ap_idx, _, _) = resolve_func(ctx.func_table, "Array::push")
    let (ag_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
    let (al_idx, _, _) = resolve_func(ctx.func_table, "Array::length")
    let dst_local = next_local
    let src_local = next_local + 1
    let i_local = next_local + 2
    let len_local = next_local + 3
    Array::push(local_names, "[gc-temp]__pushall_dst")
    Array::push(local_names, "[gc-temp]__pushall_src")
    Array::push(local_names, "[gc-temp]__pushall_i")
    Array::push(local_names, "[gc-temp]__pushall_len")
    let mut nl = next_local + 4
    nl = ce(buf, Array::get(args, 0), local_names, nl, ld)
    emit_local_set(buf, dst_local)
    nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
    emit_local_set(buf, src_local)
    emit_i64_const(buf, 0)
    emit_local_set(buf, i_local)
    emit_local_get(buf, src_local)
    emit_call_resolved(buf, ctx, al_idx)
    emit_local_set(buf, len_local)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf, i_local)
    emit_local_get(buf, len_local)
    emit_i64_ge_s(buf)
    emit_br_if(buf, 1)
    emit_local_get(buf, dst_local)
    emit_local_get(buf, src_local)
    emit_local_get(buf, i_local)
    emit_call_resolved(buf, ctx, ag_idx)
    emit_call_resolved(buf, ctx, ap_idx)
    emit_local_get(buf, i_local)
    emit_i64_const(buf, 1)
    emit_i64_add(buf)
    emit_local_set(buf, i_local)
    emit_br(buf, 0)
    emit_end(buf)
    emit_end(buf)
    emit_i64_const(buf, 0)
    nl
  }
  else if fname == "perform" {
    // #538: performs of host-capability effects (Fs::ReadFile,
    // Profiler::NowUs, ...) lower to their canonical builtin, exactly like
    // the linear backend's builtin fast path. Algebraic (user-effect)
    // performs need the replay-memo machinery and are not ported yet.
    let op_expr = Array::get(args, 0)
    let op_head = if is_eident(op_expr) {
      get_eident_name(op_expr)
    } else if expr_tag(op_expr) == 8 {
      let op_callee = get_ecall_callee(op_expr)
      if is_eident(op_callee) {
        get_eident_name(op_callee)
      } else {
        ""
      }
    } else {
      ""
    }
    // #640: `perform Exception::Throw(x)` IS `throw(x)` — route it to the same
    // wasm exception the EThrow arm emits (tag 0 on the gc backend, see
    // backend_expr.vibe), so a `with Exception` handler catches both spellings.
    if is_exception_throw_operation(op_head) {
      let mut enl = next_local
      if expr_tag(op_expr) == 8 && Array::length(get_ecall_args(op_expr)) > 0 {
        enl = ce(buf, Array::get(get_ecall_args(op_expr), 0), local_names, enl, ld)
      } else {
        emit_i64_const(buf, 0)
      }
      bytebuf_push(buf, 8)
      leb128_encode_u32(buf, 0)
      return enl
    }
    if is_exception_operation_name(op_head) {
      throw(String::concat("perform ", String::concat(op_head, ": the abortive Exception alias has a single operation, Throw (#1279)")))
    }
    let op_canon = canonical_builtin_name(op_head)
    let __pf_len = Array::length(ctx.func_table.names)
    let mut pf_i = -1
    let mut __pf = 0
    while __pf < __pf_len {
      if Array::get(ctx.func_table.names, __pf) == op_canon {
        pf_i = __pf
        __pf = __pf_len
      } else {
        __pf = __pf + 1
      }
    }
    if pf_i < 0 {
      // #3071: an algebraic (user-effect) perform that reaches codegen was
      // NOT migrated by evidence_dict_pass, so no live handle reaches it:
      // it can only ever run as an unhandled effect. In practice the site
      // is dead code -- a function nobody calls, or an exported callee
      // whose every call site took the suspend-lowered clone -- and
      // refusing it here rejected the whole program. Lower it the way the
      // linear lane does (compile_call.vibe's perform arm): evaluate the
      // payload, then abort. The linear lane throws an effect tag no
      // handler catches; this lane traps with `unreachable`, which no
      // `with Exception` handler (tag 0) can intercept either.
      let raw_args = if expr_tag(op_expr) == 8 {
        get_ecall_args(op_expr)
      } else {
        array_empty()
      }
      let mut unl = next_local
      let mut uai = 0
      while uai < Array::length(raw_args) {
        unl = ce(buf, Array::get(raw_args, uai), local_names, unl, ld)
        emit_drop(buf)
        uai = uai + 1
      }
      // `unreachable` leaves the stack polymorphic, so the site types as
      // whatever the operation returns, with nothing pushed after it.
      bytebuf_push(buf, 0)
      return unl
    }
    let pf_idx = Array::get(ctx.func_table.indices, pf_i)
    let pf_ret = Array::get(ctx.func_table.returns, pf_i)
    let op_args = if expr_tag(op_expr) == 8 {
      get_ecall_args(op_expr)
    } else {
      array_empty()
    }
    let mut nl = next_local
    let mut pai = 0
    while pai < Array::length(op_args) {
      nl = ce(buf, Array::get(op_args, pai), local_names, nl, ld)
      pai = pai + 1
    }
    emit_call_resolved(buf, ctx, pf_idx)
    if pf_ret == 0 {
      emit_i64_const(buf, 0)
    }
    nl
  }
  else if fname == "Bytes::new" && Array::length(args) == 1 && !gc_name_is_user_defined(ctx, local_names, fname) {
    // review-lint: allow-gc-direct-abi-unlisted -- Bytes::new has a registered GC function-table body; this arm rewrites its sized overload
    // Bytes::new(n): length-n zero-filled buffer. The runtime bytes_new
    // takes NO operands, so the generic path emits `n` and then calls the
    // zero-parameter body anyway, stranding the argument. This lane had no
    // counterpart to the linear lane's synthesis, which made the
    // one-argument overload linear-only -- clean under `vibe check` on both
    // lanes, past `wasmtime compile`, failing at run time on one (#2363).
    // The synthesis is SHARED now (common_base/sized_bytes_new_expr.vibe),
    // so this arm and the linear one are the same single call and cannot
    // drift apart again.
    //
    // The guard is gc_name_is_user_defined, NOT `!source_is_bound`: on this
    // backend the generated builtin BODIES live in ctx.func_table, so
    // `source_is_bound` is true for every builtin and the `!source_is_bound`
    // arms further up are reachable only for region-surface names that have
    // no body (MutList::/MutBytes::). Guarding this arm that way compiled,
    // linked, and simply never fired -- measured, not reasoned.
    ce(buf, sized_bytes_new_expr(Array::get(args, 0)), local_names, next_local, ld)
  }
  else if fname == "eq" && !gc_name_is_user_defined(ctx, local_names, fname) {
    // #2309 (Codex review on #2312): unconditional until now, so a program
    // that bound `eq` itself -- locally or at top level -- got content
    // equality instead of its own function. `let eq = (a: Int, b: Int) ->
    // Int { a + b }` then `eq(1, 2)` answered 0. Same guard as the assert
    // arms below, same reason.
    // #2407: a provably scalar operand takes a bare `i64.eq` and never
    // reaches the string fallback below. Without this the fallback ran for
    // every pair that is not bit-identical, reading both values as
    // `(ptr << 32) | len` fat pointers -- so `eq(64 << 32, 65 << 32)`
    // loaded from whatever address the high word happened to name and
    // trapped. Small values were fine only because the bogus address
    // happened to be in bounds, which is why this went unnoticed.
    //
    // The linear lane has had this guard since #705 (`cc_arg_is_scalarish`
    // in compile_call.vibe); it was never ported here. One operand is
    // enough: `==` already routes that way (`emit_gc_eq_value`), and a
    // scalar can only be equal to another scalar's bit pattern.
    if bc_expr_is_floatish(Array::get(args, 0), local_names, ctx) || bc_expr_is_floatish(Array::get(args, 1), local_names, ctx) {
      // #2426: a provably Double operand takes a real f64 comparison,
      // like `==` does (emit_gc_eq_value) and like the linear lane's own
      // `eq` arm has since #745. Without it BOTH remaining arms answer on
      // raw bits, and the content fall-back below is the sharper of the
      // two: it reads each operand as `(ptr << 32) | len`, and a Double's
      // low 32 bits are its mantissa tail, which is ZERO for every
      // round value. Two zero-length "strings" compare EQUAL, so
      // `eq(0.0, 1.5)` answered **true** -- measured on 978ccefc4, gc
      // lane, for two ordinary distinct Doubles with no diagnostic. The
      // `i64.eq` arm below is wrong for Doubles in the other direction:
      // `-0.0` and `nan` (identical bits, and IEEE 754 says not equal).
      let mut fnl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
      emit_f64_reinterpret_i64(buf)
      fnl = ce(buf, Array::get(args, 1), local_names, fnl, ld)
      emit_f64_reinterpret_i64(buf)
      emit_f64_eq(buf)
      emit_i64_extend_i32_s(buf)
      fnl
    } else if bc_expr_is_intish(Array::get(args, 0), local_names, ctx) || bc_expr_is_intish(Array::get(args, 1), local_names, ctx) {
      let mut snl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
      snl = ce(buf, Array::get(args, 1), local_names, snl, ld)
      emit_i64_eq(buf)
      emit_i64_extend_i32_s(buf)
      snl
    } else {
      // Content-based equality: i64_eq fast path, then str_eq fallback
      let (str_eq_idx, _, _) = resolve_func(ctx.func_table, "String::equals")
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ld)
      let eq_a = nl
      let eq_b = nl + 1
      Array::push(local_names, "[gc-temp]__eq_a")
      Array::push(local_names, "[gc-temp]__eq_b")
      emit_local_set(buf, eq_b)
      emit_local_set(buf, eq_a)
      emit_local_get(buf, eq_a)
      emit_local_get(buf, eq_b)
      emit_i64_eq(buf)
      emit_if_i64(buf)
      emit_i64_const(buf, 1)
      emit_else(buf)
      emit_local_get(buf, eq_a)
      emit_local_get(buf, eq_b)
      emit_call_resolved(buf, ctx, str_eq_idx)
      emit_end(buf)
      nl + 2
    }
  }
  else if fname == "not" && !gc_name_is_user_defined(ctx, local_names, fname) {
    // #2309: same as `eq` above. Measured -- `let not = (a: Int) -> Int
    // { a + 41 }` then `not(1)` gives 42 on linear (its arm is guarded by
    // `!prefer_bound_call`) and was hijacked here.
    let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
    emit_i64_eqz(buf)
    emit_i64_extend_i32_u(buf)
    nl
  }
  else if fname == "Double::from_i64_bits" {
    let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
    nl
  }
  else if fname == "Double::from_i64_bits_lohi" {
    // #2651. The gc lane carries a Double as raw f64 bits in an untagged
    // i64, so reassembling the halves IS the conversion. Both are masked
    // for the same reasons the linear arm gives.
    let nl0 = ce(buf, Array::get(args, 0), local_names, next_local, ld)
    emit_i64_const(buf, 4294967295)
    emit_i64_and(buf)
    let nl1 = ce(buf, Array::get(args, 1), local_names, nl0, ld)
    emit_i64_const(buf, 4294967295)
    emit_i64_and(buf)
    emit_i64_const(buf, 32)
    emit_i64_shl(buf)
    emit_i64_or(buf)
    nl1
  }
  else if fname == "Double::to_i64_bits_lo" {
    let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
    emit_i64_const(buf, 4294967295)
    emit_i64_and(buf)
    nl
  }
  else if fname == "Double::to_i64_bits_hi" {
    let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
    emit_i64_const(buf, 32)
    emit_i64_shr_s(buf)
    emit_i64_const(buf, 4294967295)
    emit_i64_and(buf)
    nl
  }
  else if fname == "__to_string" && Array::length(args) == 1 && bc_offset_refuses_render(Array::get(args, 0), ctx) {
    // #3068: refuse exactly where the linear lane refuses (#2987), with
    // the same message, rather than print an address.
    throw(unrenderable_render_message(Array::get(args, 0)))
  }
  else if fname == "__to_string" && Array::length(args) == 1 && bc_expr_is_floatish(Array::get(args, 0), local_names, ctx) {
    // #744 (gc mirror of the linear fix): a statically-floatish argument
    // takes the synthesized Double formatter — the runtime-dispatch
    // builtin below reads the raw f64 bits as an integer.
    double_runtime_require(ctx.func_table, double_runtime_to_string_name())
    ce(buf, double_to_string_expr(Array::get(args, 0)), local_names, next_local, ld)
  }
  else if fname == "__to_string" && Array::length(args) == 1 && bc_expr_is_boolish(Array::get(args, 0), local_names, ctx) {
    // #1015 (gc mirror of the linear fix): a statically-boolish argument
    // takes the "true"/"false" formatter directly — the runtime-dispatch
    // builtin below cannot distinguish Bool from Int (same
    // representation on this lane) and would mis-render `true` as "1".
    ce(buf, EIf(Array::get(args, 0), EString("true", -1), EString("false", -1)), local_names, next_local, ld)
  }
  else if fname == "to_string" && ctx.gc_to_string_is_show_wrapper && Array::length(args) == 1 && (bc_expr_is_floatish(Array::get(args, 0), local_names, ctx) || bc_expr_is_boolish(Array::get(args, 0), local_names, ctx)) {
    // #1015: gc-lane counterpart of the linear call-site fast path in
    // expr/compile_call.vibe. The gc lane has no cross-file #716
    // export-name mangling to key off (VIBE_BACKEND=gc is always a
    // direct SINGLE-FILE compile — see cli_adapter.vibe's dispatch,
    // "FS-import mode... stays linear-backend-only" — so the prelude's
    // to_string can't even be imported here; exercising this path means
    // the compiled file defines its own local `to_string[T: Show](x: T)
    // -> String { __to_string(x) }`-shaped wrapper). Inside that
    // wrapper's body `x` has the opaque generic type param T, so no
    // param/let seeding (concrete "Bool"/"Float" annotations only) can
    // make `bc_expr_is_boolish`/`bc_expr_is_floatish` recognize it --
    // the SAME root cause as the linear bug. Bypass the wrapper call
    // entirely and inline `__to_string(arg)` with the ORIGINAL call-site
    // argument expression, which the two branches above then classify
    // correctly.
    //
    // `ctx.gc_to_string_is_show_wrapper` (backend_body.vibe,
    // gc_to_string_resolves_to_show_wrapper, computed once per compile)
    // is the shadow guard: code review (#1015) correctly pointed out
    // that a bare `fname == "to_string"` match, while safe against
    // CROSS-file shadowing (the gc lane's single-file compile model
    // rules that out -- a second same-named top-level fn is a compile
    // error), is NOT safe against a SAME-file user `fn to_string(x:
    // Bool) -> String { "custom" }` -- a real, different function that
    // must keep running, not be silently replaced by this fast path.
    // The flag verifies the actual "to_string" in THIS program
    // structurally matches the trivial Show-forwarding wrapper shape
    // before this branch is allowed to bypass it; a differently-shaped
    // "to_string" (any real user function) leaves the flag false and
    // this whole branch inert, falling through to the ordinary bound
    // call below untouched.
    ce(buf, ECall(EIdent("__to_string", -1), [Array::get(args, 0)], -1), local_names, next_local, ld)
  }
  else if (fname == "Int::to_string" || fname == "__to_string") && Array::length(args) == 1 && bc_expr_is_intish(Array::get(args, 0), local_names, ctx) {
    // #2405: the builtin decides Int-vs-String by a HEURISTIC on the bit
    // pattern (`gc_gen_to_string_body`), so an Int whose high word is a
    // plausible address is returned unchanged instead of rendered:
    // `__to_string(64 << 32)` reads as (ptr 64, len 0) and produced the
    // EMPTY STRING on this lane while the linear lane printed
    // "274877906944". A statically-int argument therefore skips the
    // heuristic entirely and renders directly -- the same answer the
    // linear lane reaches through `ts_known_int` (compile_call.vibe).
    // The renderer is ~182 bytes. When the module carries the shared body
    // (`gc_gen_to_string_int_body`, pushed by backend_body.vibe whenever a
    // statically-int argument appears anywhere in it) this is one call;
    // int_wrap has eight such sites and paid for eight copies before.
    // The -1 case is not a fallback that can be wrong: the pre-pass that
    // decides to push the body classifies by shape alone and cannot see
    // the `gc_int_locals` slot log this arm also reads, so a bare-ident
    // site in a module with no shape-int site still inlines -- correct,
    // just bigger. A call to a body that was not pushed cannot happen.
    if ctx.gc_to_string_int_func_idx >= 0 {
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
      emit_call(buf, ctx.gc_to_string_int_func_idx)
      nl
    } else {
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
      let ts_val = nl
      let ts_neg = nl + 1
      let ts_cur = nl + 2
      let ts_abs = nl + 3
      let ts_hp = nl + 4
      let ts_len = nl + 5
      Array::push(local_names, "[gc-temp]__ts_val")
      Array::push(local_names, "[gc-temp]__ts_neg")
      Array::push(local_names, "[gc-temp]__ts_cur")
      Array::push(local_names, "[gc-temp]__ts_abs")
      Array::push(local_names, "[gc-temp]__ts_hp")
      Array::push(local_names, "[gc-temp]__ts_len")
      emit_local_set(buf, ts_val)
      gc_emit_int_to_string(buf, ts_val, ts_neg, ts_cur, ts_abs, ts_hp, ts_len)
      nl + 6
    }
  }
  else if fname == "Int::to_string" || fname == "__to_string" {
    let ts_idx = gc_resolve_builtin_last(ctx.func_table, "__to_string")
    let nl = ce(buf, Array::get(args, 0), local_names, next_local, ld)
    emit_call_resolved(buf, ctx, ts_idx)
    nl
  }
  else if fname == "MapBuilder::new" {
    // #723-family fix (mirrors the linear backend): the builder used to
    // be a FIXED 520-byte block whose append never checked the stored
    // capacity — the 33rd entry silently corrupted the heap. New shape:
    // handle [count@0][cap@4][storage_ptr@8] + separate entries storage
    // (key@+0/value@+8 per 16-byte slot); `set` grows storage through
    // the handle, `freeze` copies into a plain Map block.
    let ptr_l = next_local
    Array::push(local_names, "[gc-temp]__mb_ptr")
    emit_global_get(buf, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, ptr_l)
    emit_global_get(buf, 0)
    emit_i32_const(buf, 144)
    emit_i32_add(buf)
    emit_global_set(buf, 0)
    // #415: gc-lane heap bump must grow linear memory like the linear
    // backend does -- without this any allocation past the initial page
    // traps OOB (the gc smoke fixture only ever allocated a few bytes).
    emit_heap_memory_grow_check(buf)
    emit_local_get(buf, ptr_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 0)
    emit_i32_store(buf, 2, 0)
    emit_local_get(buf, ptr_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 8)
    emit_i32_store(buf, 2, 4)
    emit_local_get(buf, ptr_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf, ptr_l)
    emit_i64_const(buf, 16)
    emit_i64_add(buf)
    emit_i64_store(buf, 3, 8)
    emit_local_get(buf, ptr_l)
    next_local + 1
  } else {
    gc_compile_named_2(buf, callee, args, local_names, next_local, ctx, ld, ce, fname, source_is_bound, ctor_lookup_idx, compile_call_gc_fn, gc_mut_alias_call_fn, gc_compile_native_array_ref_fn)
  }
}

export {
  compile_call_gc
}
