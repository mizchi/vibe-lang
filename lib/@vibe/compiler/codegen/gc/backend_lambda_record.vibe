//# Imports

import @vibe/compiler/codegen/common_base {
  CompileCtxGc, LambdaTable
}

//# Functions

/// #1332: `native_array_locals` is this lambda body's typed-local row (absolute
/// local indices within ITS own frame), handed back by compile_lambda_inner_gc.
/// It is appended here because this is the single writer of LambdaTable.bodies
/// -- keeping the two arrays parallel by construction rather than by a second
/// bookkeeping site that could drift out of order under nesting.
export fn record_lambda_meta_gc(ctx: CompileCtxGc, lam_buf: Bytes, user_params: Int, captures: Array[String], final_lam_nl: Int, native_array_locals: Array[Int]) -> Int {
  let lambda_table = ctx.lambda_table
  let lambda_idx = Array::length(lambda_table.bodies)
  Array::push(lambda_table.bodies, lam_buf)
  Array::push(lambda_table.param_counts, user_params + 1)
  Array::push(lambda_table.captures, captures)
  Array::push(ctx.gc_lambda_native_array_locals, native_array_locals)
  let mut extra_lam = 0
  let min_lam_nl = user_params + 1
  if final_lam_nl > min_lam_nl {
    extra_lam = final_lam_nl - min_lam_nl
  }
  Array::push(lambda_table.meta_i32, 0)
  Array::push(lambda_table.meta_i64, extra_lam)
  lambda_idx
}
