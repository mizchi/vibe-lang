//# Imports

import @vibe/compiler/core {
  Expr, TypeExpr
}

import @vibe/compiler/codegen/common_base {
  CompileCtxGc
}

import ./backend_lambda_collect.vibe {
  collect_lambda_captures_gc
}

import ./backend_lambda_emit.vibe {
  emit_lambda_closure_gc
}

import ./backend_lambda_inner.vibe {
  compile_lambda_inner_gc
}

import ./backend_lambda_record.vibe {
  record_lambda_meta_gc
}

import ./backend_lambda_sig.vibe {
  CompileLambdaGcFn
}

//# Functions

export fn compile_lambda_gc(buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, compile_fn: CompileLambdaGcFn) -> Int with Exception {
  let (captures, num_captures, user_params) = collect_lambda_captures_gc(params = params, fn_body = fn_body, ctx = ctx, encl = local_names)
  let (lam_buf, final_lam_nl, lam_native_array_locals) = compile_lambda_inner_gc(params = params, fn_body = fn_body, captures = captures, user_params = user_params, outer_names = local_names, ctx = ctx, compile_fn = compile_fn, ld = ld)
  let lambda_idx = record_lambda_meta_gc(ctx = ctx, lam_buf = lam_buf, user_params = user_params, captures = captures, final_lam_nl = final_lam_nl, native_array_locals = lam_native_array_locals)
  let table_slot = ctx.num_user_funcs + lambda_idx
  Array::push(ctx.table_slots_used, value = table_slot)
  emit_lambda_closure_gc(buf = buf, captures = captures, num_captures = num_captures, local_names = local_names, next_local = next_local, table_slot = table_slot)
}
