//# Imports

import @vibe/compiler/core {
  Expr, TypeExpr
}

import @vibe/compiler/codegen/common_base {
  CompileCtxGc
}

import ./backend_lambda_collect.vibe {
  collect_lambda_captures_gc
}

import ./backend_lambda_emit.vibe {
  emit_lambda_closure_gc
}

import ./backend_lambda_inner.vibe {
  compile_lambda_inner_gc
}

import ./backend_lambda_record.vibe {
  record_lambda_meta_gc
}

import ./backend_lambda_sig.vibe {
  CompileLambdaGcFn
}

//# Functions

export fn compile_lambda_gc(buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, compile_fn: CompileLambdaGcFn) -> Int with Error {
  let (captures, num_captures, user_params) = collect_lambda_captures_gc(params, fn_body, ctx)
  let (lam_buf, final_lam_nl, lam_native_array_locals) = compile_lambda_inner_gc(params, fn_body, captures, user_params, ctx, compile_fn, ld)
  let lambda_idx = record_lambda_meta_gc(ctx, lam_buf, user_params, captures, final_lam_nl, lam_native_array_locals)
  let table_slot = ctx.num_user_funcs + lambda_idx
  Array::push(ctx.table_slots_used, table_slot)
  emit_lambda_closure_gc(buf, captures, num_captures, local_names, next_local, table_slot)
}
