//# Imports

import .. / .. / core {
  Expr, TypeExpr
}

import .. / common_base {
  CompileCtxGc
}

import ./backend_lambda_collect.vibe {
  collect_lambda_captures_gc
}

import ./backend_lambda_emit.vibe {
  emit_lambda_closure_gc
}

import ./backend_lambda_inner.vibe {
  compile_lambda_inner_gc
}

import ./backend_lambda_record.vibe {
  record_lambda_meta_gc
}

import ./backend_lambda_sig.vibe {
  CompileLambdaGcFn
}

//# Functions

export let compile_lambda_gc: (Bytes, Array[(String, Option[TypeExpr])], Expr, Array[String], Int, CompileCtxGc, Int, CompileLambdaGcFn) -> Int with { Error } = (buf, params, fn_body, local_names, next_local, ctx, ld, compile_fn) -> {
  let (captures, num_captures, user_params) = collect_lambda_captures_gc(params, fn_body, ctx)
  let (lam_buf, final_lam_nl) = compile_lambda_inner_gc(params, fn_body, captures, user_params, ctx, compile_fn, ld)
  let lambda_idx = record_lambda_meta_gc(ctx, lam_buf, user_params, captures, final_lam_nl)
  let table_slot = ctx.num_user_funcs + lambda_idx
  emit_lambda_closure_gc(buf, captures, num_captures, local_names, next_local, table_slot)
}
