//# Imports

import @vibe/compiler/core {
  Expr, TypeExpr, bytebuf_new
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/codegen/common_base {
  CompileCtxGc, emit_i64_load
}

import @vibe/compiler/codegen/common_extractors {
  array_contains_str
}

import @vibe/compiler/codegen/wasm_emit {
  emit_i32_wrap_i64, emit_local_get, emit_local_set
}

import ./backend_lambda_ctx.vibe {
  make_lambda_ctx_gc
}

import ./backend_lambda_sig.vibe {
  CompileLambdaGcFn
}

//# Functions

export fn compile_lambda_inner_gc(params: Array[(String, Option[TypeExpr])], fn_body: Expr, captures: Array[String], user_params: Int, ctx: CompileCtxGc, compile_fn: CompileLambdaGcFn, ld: Int) -> (Bytes, Int) with Error {
  let lam_buf = bytebuf_new()
  let lam_locals = array_empty()
  let mut lpi = 0
  while lpi < user_params {
    let (lpname, _) = Array::get(params, lpi)
    Array::push(lam_locals, lpname)
    lpi = lpi + 1
  }
  Array::push(lam_locals, "__env")
  let env_param_idx = user_params
  let lam_nl_start = user_params + 1
  let lam_ref_cells = array_empty()
  let lam_ref_local_indices = array_empty()
  let num_captures = Array::length(captures)
  let mut ci3 = 0
  let mut lam_nl = lam_nl_start
  while ci3 < num_captures {
    let cap_local = lam_nl
    let cap_name = Array::get(captures, ci3)
    emit_local_get(lam_buf, env_param_idx)
    emit_i32_wrap_i64(lam_buf)
    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)
    emit_local_set(lam_buf, cap_local)
    Array::push(lam_locals, cap_name)
    if array_contains_str(ctx.ref_cell_names, cap_name) {
      Array::push(lam_ref_cells, cap_name)
    }
    lam_nl = lam_nl + 1
    ci3 = ci3 + 1
  }
  let lam_ctx = make_lambda_ctx_gc(ctx, lam_ref_cells, lam_ref_local_indices)
  // #744 (gc mirror of the linear lam_float_slots seeding): annotated
  // Float/Double params join the fresh scope's float tracking, so closure
  // bodies get real f64 arithmetic/comparisons and the Double __to_string
  // formatter instead of raw-bits integer ops.
  // #1015 (gc mirror of the linear lam_bool_slots seeding): annotated Bool
  // params join the fresh scope's bool tracking, so `to_string(b)` /
  // `"\{b}"` on a Bool-typed closure param takes the "true"/"false"
  // formatter instead of the generic runtime dispatch (which cannot tell
  // Bool from Int -- they share the same gc-lane numeric representation).
  // #1032: both gc_float_locals and gc_bool_locals are slot-indexed --
  // `lfs_i` IS the param's slot in lam_locals (user params are pushed there
  // in order starting at 0, in this function's own lam_locals-building loop
  // above).
  let mut lfs_i = 0
  while lfs_i < user_params {
    let (_, lfs_ann) = Array::get(params, lfs_i)
    match lfs_ann {
      Some(lfs_ty) => match lfs_ty {
        TyName(lfs_tn) => if lfs_tn == "Float" || lfs_tn == "Double" {
          Array::push(lam_ctx.gc_float_locals, lfs_i)
        } else if lfs_tn == "Bool" {
          Array::push(lam_ctx.gc_bool_locals, lfs_i)
        } else {
          ()
        },
        _ => ()
      },
      None => ()
    }
    lfs_i = lfs_i + 1
  }
  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, ld)
  (lam_buf, final_lam_nl)
}
