//# Functions

fn is_frozen_array_conversion_name(name: String) -> Bool {
  name == "FrozenArray::from_array" || name == "FrozenArray::to_array"
}

/// See the linear twin: generated builtins precede `func_offset`, so expose a
/// first-class conversion as a tiny ordinary lambda with a valid table slot.
fn frozen_array_conversion_closure(name: String) -> Expr {
  let param = "__frozen_array_value"
  let params: Array[(String, Option[TypeExpr])] = [(param, None)]
  EFn(array_empty(), array_empty(), params, None, None, ECall(EIdent(name, -1), [
    EIdent(param, -1)
  ], -1))
}

/// #538 P4.5: shape-based "definitely scalar" test for `==`/`!=` operands,
/// mirroring the linear lane's expr_is_intish literal/operator cases (the gc
/// lane has no checker types or local-type tracking, so only shapes count).
/// Anything else routes through the `eq` builtin, whose fall-back compares
/// packed (ptr<<32)|len strings by CONTENT — raw i64.eq made every
/// string-vs-string `==` a pointer compare, so the gc-compiled compiler failed
/// its own types_equal with "return type mismatch: expected Int, got Int".
fn gc_expr_is_intish(e: Expr) -> Bool {
  match e {
    EInt(_) => true,
    EBool(_) => true,
    EBinOp(op, _, _) => op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" || op == "%" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "==" || op == "!=" || op == "&&" || op == "||" || op == "+" || op == "-" || op == "*" || op == "/",
    // `~` is Int by construction (#2344); see expr_is_intish for what routing
    // it through the generic `eq` path costs. Note gc_expr_is_boolish below
    // keeps `!` alone -- `~x` is an Int, not a Bool.
    EUnaryOp(op, _) => op == "!" || op == "~",
    _ => false
  }
}

/// #538 P4.5: shape-based "holds f64 raw bits" test. Float literals,
/// int->float conversions, arithmetic over a floatish operand, and let-bound
/// locals recorded in ctx.gc_float_locals count; anything else (annotated
/// Double params, tuple-destructured floats) is best-effort untracked.
/// #1032: a bare ident resolves to its CURRENT slot (find_local_slot) before
/// checking ctx.gc_float_locals -- mirrors gc_expr_is_boolish below, so a
/// name reused with a non-float binding in a sibling scope is not
/// misclassified via its old, now-stale slot entry.
fn gc_expr_is_floatish(e: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {
  match e {
    EFloat(_) => true,
    EIdent(fname, _) => {
      let slot = find_local_slot(local_names, fname)
      slot >= 0 && array_contains_int(ctx.gc_float_locals, slot)
    },
    EBinOp(op, l, r) => (op == "+" || op == "-" || op == "*" || op == "/") && (gc_expr_is_floatish(l, local_names, ctx) || gc_expr_is_floatish(r, local_names, ctx)),
    EUnaryOp(op, x) => op == "-" && gc_expr_is_floatish(x, local_names, ctx),
    ECall(fcallee, _, call_off) => match fcallee {
      EIdent(cn, _) => array_contains_int(ctx.gc_float_call_offsets, call_off) || cn == "Int::to_double" || cn == "Double::from_i64_bits" || cn == "Float::to_double" || cn == "Double::to_float" || cn == "Int::to_float" || gc_fn_returns_float(local_names, ctx, cn),
      _ => false
    },
    _ => false
  }
}

/// #1015: gc mirror of the linear lane's expr_is_boolish -- shape-based "is
/// this statically a Bool" test. Bool literals, comparison/logical operators,
/// unary `!`, and -- via ctx.gc_bool_locals -- a bare ident CURRENTLY bound
/// (via find_local_slot) to a slot tracked as boolish. Bool and Int share the
/// same gc-lane numeric representation (no distinguishing runtime type tag),
/// so this static classification is the only way to route a Bool argument to
/// the "true"/"false" formatter instead of the generic runtime `__to_string`
/// dispatch, which cannot tell them apart.
/// #2422: `gc_expr_is_intish` plus the ident arm, so a binding whose value is
/// ANOTHER int-bound name (`let y = x`) is classified too. The shape-only test
/// answers false for a bare ident, which left an alias unlogged and sent a
/// large Int through the runtime string-pointer heuristic. Resolved through the
/// CURRENT slot, exactly as gc_expr_is_boolish above does, so a name rebound in
/// a sibling scope is not read through its stale entry.
fn gbe_strip_param_label_marker(n: String) -> String {
  let ln = String::length(n)
  if ln > 0 {
    let c = String::char_code_at(n, ln - 1)
    if c == '~' || c == '?' {
      n[0: ln - 1]
    } else {
      n
    }
  } else {
    n
  }
}

fn gc_value_is_intish(e: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {
  match e {
    EIdent(iname, _) => {
      let slot = find_local_slot(local_names, iname)
      slot >= 0 && array_contains_int(ctx.gc_int_locals, slot)
    },
    // `-x` carries the operand's type, so it is logged only when the operand
    // is. Handled HERE rather than in `gc_expr_is_intish` on purpose: that one
    // also routes the `==` operator, where widening `-` would change how float
    // comparisons lower, and this fixes the measured defect without touching
    // that path. Measured: two `let` bindings from unary-negated large Ints
    // sent `eq(a, b)` to the string fallback (#2422 review). A Double stops at
    // the `EFloat` leaf, and the let-logging consults floatish first anyway.
    //
    // No `+` arm: unary `+` is not vibe syntax at all -- `+(64 << 32)` is
    // `unexpected token: +`, measured. An arm for it would be dead code that
    // reads like coverage.
    EUnaryOp(op, x) => if op == "!" || op == "~" {
      true
    } else if op == "-" {
      gc_value_is_intish(x, local_names, ctx)
    } else {
      false
    },
    _ => gc_expr_is_intish(e)
  }
}

fn gc_expr_is_boolish(e: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {
  match e {
    EBool(_) => true,
    EIdent(fname, _) => {
      let slot = find_local_slot(local_names, fname)
      slot >= 0 && array_contains_int(ctx.gc_bool_locals, slot)
    },
    EBinOp(op, _, _) => op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&&" || op == "||",
    EUnaryOp(op, _) => op == "!",
    _ => false
  }
}

/// #538 P4.5: is `e` syntactically a constructor value (ctor call or nullary
/// ctor ident)? Runtime values carry no type info, so — exactly like the
/// linear lane's emit_eq_value — the SHAPE of a literal operand decides the
/// structural comparison path for `==`/`!=`.
fn gc_is_ctor_expr(e: Expr, ctx: CompileCtxGc) -> Bool {
  match e {
    ECall(callee, _, _) => match callee {
      EIdent(cname, _) => ctor_table_index_of(ctx.gc_ctor_table, cname) >= 0,
      _ => false
    },
    EIdent(iname, _) => ctor_table_index_of(ctx.gc_ctor_table, iname) >= 0,
    _ => false
  }
}

/// Structural equality for two tuples (gc layout: raw even ptr, element i at
/// ptr+i*8, no header). Ported from the linear emit_tuple_struct_eq; leaves a
/// raw i64 0/1. `cefn` is compile_expr_gc, threaded to avoid a forward ref.
fn emit_gc_tuple_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, num: Int, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, cefn: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with Exception) -> Int with Exception {
  let aptr = next_local
  Array::push(local_names, "[gc-temp]__gceqa")
  let bptr = next_local + 1
  Array::push(local_names, "[gc-temp]__gceqb")
  let nl1 = cefn(buf, lhs, local_names, next_local + 2, ctx, ld)
  emit_local_set(buf, aptr)
  let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)
  emit_local_set(buf, bptr)
  let (eq_fidx, _, _) = resolve_func(ctx.func_table, "eq")
  emit_i64_const(buf, 1)
  let mut i = 0
  while i < num {
    emit_local_get(buf, aptr)
    emit_i32_wrap_i64(buf)
    emit_i64_load(buf, 3, i * 8)
    emit_local_get(buf, bptr)
    emit_i32_wrap_i64(buf)
    emit_i64_load(buf, 3, i * 8)
    emit_call(buf, eq_fidx)
    emit_i64_and(buf)
    i = i + 1
  }
  nl2
}

/// Structural equality for two ctor values (gc layout: value = ptr|1, tag i32
/// at +0, field i at +8+i*8): tags first, then field-wise `eq` (strings compare
/// by content there). The generic `eq` builtin compares ctor POINTERS — fresh
/// allocations are never bit-equal, which made the gc-compiled checker's
/// `Some(av) == rb` effect-row comparison (unify_effects) always false.
fn emit_gc_ctor_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, fc: Int, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, cefn: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with Exception) -> Int with Exception {
  let aptr = next_local
  Array::push(local_names, "[gc-temp]__gcceqa")
  let bptr = next_local + 1
  Array::push(local_names, "[gc-temp]__gcceqb")
  let nl1 = cefn(buf, lhs, local_names, next_local + 2, ctx, ld)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_local_set(buf, aptr)
  let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_local_set(buf, bptr)
  emit_local_get(buf, aptr)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf, 2, 0)
  emit_local_get(buf, bptr)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_eq(buf)
  emit_if_i64(buf)
  let (eq_fidx, _, _) = resolve_func(ctx.func_table, "eq")
  if fc == 63 {
    // #724 round 2: DYNAMIC field count (fc 63 sentinel) — see the linear
    // emit_ctor_struct_eq: equal tags imply equal argc, loop over argc@4.
    let res_l = nl2
    let cnt_l = nl2 + 1
    let ii_l = nl2 + 2
    Array::push(local_names, "[gc-temp]__gcceq_res")
    Array::push(local_names, "[gc-temp]__gcceq_cnt")
    Array::push(local_names, "[gc-temp]__gcceq_i")
    emit_i64_const(buf, 1)
    emit_local_set(buf, res_l)
    emit_local_get(buf, aptr)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 4)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, cnt_l)
    emit_i64_const(buf, 0)
    emit_local_set(buf, ii_l)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf, ii_l)
    emit_local_get(buf, cnt_l)
    emit_i64_ge_s(buf)
    emit_br_if(buf, 1)
    emit_local_get(buf, res_l)
    emit_local_get(buf, aptr)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf, ii_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 8)
    emit_i32_mul(buf)
    emit_i32_add(buf)
    emit_i64_load(buf, 3, 8)
    emit_local_get(buf, bptr)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf, ii_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 8)
    emit_i32_mul(buf)
    emit_i32_add(buf)
    emit_i64_load(buf, 3, 8)
    emit_call(buf, eq_fidx)
    emit_i64_and(buf)
    emit_local_set(buf, res_l)
    emit_local_get(buf, ii_l)
    emit_i64_const(buf, 1)
    emit_i64_add(buf)
    emit_local_set(buf, ii_l)
    emit_br(buf, 0)
    emit_end(buf)
    emit_end(buf)
    emit_local_get(buf, res_l)
    emit_else(buf)
    emit_i64_const(buf, 0)
    emit_end(buf)
    nl2 + 3
  } else {
    emit_i64_const(buf, 1)
    let mut i = 0
    while i < fc {
      emit_local_get(buf, aptr)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, 8 + i * 8)
      emit_local_get(buf, bptr)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, 8 + i * 8)
      emit_call(buf, eq_fidx)
      emit_i64_and(buf)
      i = i + 1
    }
    emit_else(buf)
    emit_i64_const(buf, 0)
    emit_end(buf)
    nl2
  }
}

/// The equality value for `lhs == rhs` (raw i64 0/1 on the stack): tuple / ctor
/// literals get structural comparison, floatish operands an `f64.eq` (#2426 --
/// raw bits separate `0.0` from `-0.0`, IEEE 754 does not), provably-scalar
/// operands a raw i64.eq, everything else the generic `eq` builtin (bit-equal
/// fast path + string content fall-back). Mirrors the linear lane's
/// emit_eq_value routing, including which operands it declines to take.
///
/// `!=` is the callers' `eqz` over this value, so it needs no arm of its own
/// and stays IEEE-correct through the same one: `f64.eq(NaN, NaN)` is 0, and
/// its negation is the `true` that `NaN != NaN` owes. The raw i64 compare
/// answered `true` for `NaN == NaN`, since the bits are identical.
fn emit_gc_eq_value(buf: Bytes, lhs: Expr, rhs: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, cefn: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with Exception) -> Int with Exception {
  let lhs_is_tuple = match lhs {
    ETuple(_) => true,
    _ => false
  }
  let rhs_is_tuple = match rhs {
    ETuple(_) => true,
    _ => false
  }
  // #724: aggregate shape of a bare-ident operand tracked at its `let`
  // (kind*64+n, or -1) — mirrors the linear backend's emit_eq_value.
  let lhs_agg = agg_info_of_ident(ctx.gc_agg_local_slots, lhs, local_names)
  let rhs_agg = agg_info_of_ident(ctx.gc_agg_local_slots, rhs, local_names)
  if lhs_is_tuple || rhs_is_tuple {
    let num = match lhs {
      ETuple(les) => Array::length(les),
      _ => match rhs {
        ETuple(res) => Array::length(res),
        _ => 0
      }
    }
    emit_gc_tuple_struct_eq(buf, lhs, rhs, num, local_names, next_local, ctx, ld, cefn)
  } else if lhs_agg / 64 == 1 || rhs_agg / 64 == 1 {
    let tn = if lhs_agg / 64 == 1 {
      lhs_agg % 64
    } else {
      rhs_agg % 64
    }
    emit_gc_tuple_struct_eq(buf, lhs, rhs, tn, local_names, next_local, ctx, ld, cefn)
  } else if gc_is_ctor_expr(lhs, ctx) || gc_is_ctor_expr(rhs, ctx) {
    let clit = if gc_is_ctor_expr(lhs, ctx) {
      lhs
    } else {
      rhs
    }
    let cfc = match clit {
      ECall(_, cargs, _) => Array::length(cargs),
      _ => 0
    }
    emit_gc_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, cefn)
  } else if lhs_agg / 64 == 2 || rhs_agg / 64 == 2 {
    // Tag comparison short-circuits unequal variants before any field read,
    // so walking the larger tracked field count is safe (see the linear
    // emit_eq_value for the argument).
    let lfc = if lhs_agg / 64 == 2 {
      lhs_agg % 64
    } else {
      0
    }
    let rfc = if rhs_agg / 64 == 2 {
      rhs_agg % 64
    } else {
      0
    }
    let cfc = if lfc > rfc {
      lfc
    } else {
      rfc
    }
    emit_gc_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, cefn)
  } else if gc_expr_is_floatish(lhs, local_names, ctx) || gc_expr_is_floatish(rhs, local_names, ctx) {
    // #2426: Double equality, which reached no float comparison at all before.
    // Both arms below answer on the RAW BITS -- `gc_expr_is_intish` claims
    // `+ - * /` from the operator alone and emits `i64.eq`, and the `eq`
    // builtin's fall-back reads each operand as a `(ptr << 32) | len` fat
    // pointer -- and `0.0` and `-0.0` differ in exactly the sign bit. So
    // `i64.eq` said "not equal", and the builtin agreed for a different
    // reason: bit 63 makes `-0.0`'s implied pointer far out of bounds, its
    // "both operands look like strings" guard answers no, and the fall-back
    // returns 0. IEEE 754 says `+0.0 == -0.0` is true, and the linear lane
    // says so too (`compile_expr`'s `==` arm diverts a floatish operand away
    // from `emit_eq_value` for the same reason, one lane over).
    //
    // The `<` `>` `<=` `>=` lowering in compile_expr_gc has routed through
    // f64 since #538, and its comment already names -0.0 as a value raw bits
    // misrank; equality was simply never given the same arm. Placed AFTER the
    // structural arms so a tuple or constructor holding Doubles keeps its
    // field-wise comparison, and before the scalar ones so a float never
    // reaches a bit compare.
    let nlf1 = cefn(buf, lhs, local_names, next_local, ctx, ld)
    emit_f64_reinterpret_i64(buf)
    let nlf2 = cefn(buf, rhs, local_names, nlf1, ctx, ld)
    emit_f64_reinterpret_i64(buf)
    emit_f64_eq(buf)
    emit_i64_extend_i32_s(buf)
    nlf2
  } else if gc_expr_is_intish(lhs) || gc_expr_is_intish(rhs) {
    let nl1 = cefn(buf, lhs, local_names, next_local, ctx, ld)
    let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)
    emit_i64_eq(buf)
    emit_i64_extend_i32_s(buf)
    nl2
  } else {
    let nl1 = cefn(buf, lhs, local_names, next_local, ctx, ld)
    let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)
    let (eq_fidx, _, _) = resolve_func(ctx.func_table, "eq")
    emit_call(buf, eq_fidx)
    nl2
  }
}

/// Conservative escape gate for native locals, extended in #1541 to admit a
/// reference in a proven direct-call parameter position and in the tail of a
/// proven reference-result body. `allow_tail` is reset for ordinary children,
/// so aggregates, indirect calls, captures, and joins remain impossible.
fn gc_native_array_body_is_safe_tail(expr: Expr, name: String, allow_tail: Bool, ctx: CompileCtxGc) -> Bool {
  gc_native_array_escape_gate(expr, name, allow_tail, ctx.gc_direct_abi_names, ctx.gc_direct_abi_param_refs)
}

/// Same gate, reading the direct-ABI evidence tables directly instead of a
/// compile context. The component-acceptance pass in backend_body.vibe runs
/// before any context exists and MUST reach the same verdict as lowering does:
/// when the two disagree, acceptance promises a reference that lowering cannot
/// produce, and compilation dies on an internal proof mismatch rather than
/// falling back (that was the failure this split fixes).
fn gc_native_array_escape_gate(expr: Expr, name: String, allow_tail: Bool, abi_names: Array[String], abi_param_refs: Array[Array[Bool]]) -> Bool {
  match expr {
    EIdent(n, _) => n != name || allow_tail,
    ECall(EIdent(fname, _), args, _) => {
      let direct_idx = gc_direct_abi_name_slot(abi_names, fname)
      if direct_idx >= 0 {
        let refs = Array::get(abi_param_refs, direct_idx)
        let mut i = 0
        let mut ok = Array::length(refs) == Array::length(args)
        while i < Array::length(args) {
          let is_target = match Array::get(args, i) {
            EIdent(n, _) => n == name,
            _ => false
          }
          if is_target {
            if !Array::get(refs, i) {
              ok = false
            } else {
              ()
            }
          } else if Array::get(refs, i) && gc_arg_is_reference_join(Array::get(args, i)) {
            // #1541 join: a reference parameter may be fed by an `if` whose
            // arms are themselves reference-lane values, so `name` reaching
            // the callee through an arm is the same proven crossing as
            // reaching it directly. The condition is an ordinary i64 child.
            if !gc_native_array_join_arg_is_safe(Array::get(args, i), name, abi_names, abi_param_refs) {
              ok = false
            } else {
              ()
            }
          } else if !gc_native_array_escape_gate(Array::get(args, i), name, false, abi_names, abi_param_refs) {
            ok = false
          } else {
            ()
          }
          i = i + 1
        }
        ok
      } else {
        let expected = if fname == "Array::length" {
          1
        } else if fname == "Array::get" {
          2
        } else if fname == "Array::set" {
          3
        } else {
          -1
        }
        if expected > 0 && Array::length(args) == expected {
          match Array::get(args, 0) {
            EIdent(n, _) => if n == name {
              let mut i = 1
              let mut ok = true
              while i < Array::length(args) {
                if !gc_native_array_escape_gate(Array::get(args, i), name, false, abi_names, abi_param_refs) {
                  ok = false
                }
                i = i + 1
              }
              ok
            } else {
              gc_native_array_children_are_safe(expr, name, abi_names, abi_param_refs)
            },
            _ => gc_native_array_children_are_safe(expr, name, abi_names, abi_param_refs)
          }
        } else {
          gc_native_array_children_are_safe(expr, name, abi_names, abi_param_refs)
        }
      }
    },
    // A plain alias remains in the same typed reference lane. Its own uses
    // are checked when that ELet is compiled and logged as a typed local.
    ELet(alias, EIdent(source, _), body, _) => if alias != name && source == name {
      // Check both spellings: the original binding remains in scope after a
      // plain alias and must not be smuggled into an unsupported i64 use.
      gc_native_array_escape_gate(body, alias, allow_tail, abi_names, abi_param_refs) && gc_native_array_escape_gate(body, name, allow_tail, abi_names, abi_param_refs)
    } else {
      alias != name && gc_native_array_children_are_safe(expr, name, abi_names, abi_param_refs)
    },
    ELet(n, _, _, _) => n != name && gc_native_array_children_are_safe(expr, name, abi_names, abi_param_refs),
    ELetMut(n, _, _, _) => n != name && gc_native_array_children_are_safe(expr, name, abi_names, abi_param_refs),
    ELetRec(n, _, _) => n != name && gc_native_array_children_are_safe(expr, name, abi_names, abi_param_refs),
    EAssign(n, _, _) => n != name && gc_native_array_children_are_safe(expr, name, abi_names, abi_param_refs),
    EAssignOp(n, _, _, _) => n != name && gc_native_array_children_are_safe(expr, name, abi_names, abi_param_refs),
    EFn(_, _, _, _, _, _) => false,
    EMatch(_, _) => false,
    EHandle(_, _) => false,
    EForIn(_, _, _, _) => false,
    ELoop(_, _) => false,
    // Both arms of a tail `if` are themselves tails, so a reference result may
    // flow out through either. With `allow_tail` false this is exactly the
    // generic child walk it replaces.
    EIf(cond, then_e, else_e) => gc_native_array_escape_gate(cond, name, false, abi_names, abi_param_refs) && gc_native_array_escape_gate(then_e, name, allow_tail, abi_names, abi_param_refs) && gc_native_array_escape_gate(else_e, name, allow_tail, abi_names, abi_param_refs),
    EReturn(value) => gc_native_array_escape_gate(value, name, allow_tail, abi_names, abi_param_refs),
    EBreak(_) => false,
    EContinue(_) => false,
    _ => gc_native_array_children_are_safe(expr, name, abi_names, abi_param_refs)
  }
}

fn gc_native_array_children_are_safe(expr: Expr, name: String, abi_names: Array[String], abi_param_refs: Array[Array[Bool]]) -> Bool {
  let children = expr_children(expr)
  let mut i = 0
  let mut ok = true
  while i < Array::length(children) {
    if !gc_native_array_escape_gate(Array::get(children, i), name, false, abi_names, abi_param_refs) {
      ok = false
    }
    i = i + 1
  }
  ok
}

/// #1702: may `name`, bound to a record literal, live in a wasm-gc struct local?
///
/// Only if every occurrence is the RECEIVER of a field read. A native struct
/// carries no ctor tag -- the binding site fixes its exact struct, so the tag
/// dispatch `EDot` normally does is unnecessary there -- which is exactly why
/// it must never reach anything that would look for one: equality, `Show`, a
/// call, a return, an aggregate, a closure capture, or a field STORE (that
/// lowers through `__set_field`, whose receiver is an ordinary value).
/// Anything not recognized here is rejected, so unfamiliar syntax fails closed.
/// #1542: reading a reference-lane FIELD yields a reference, not a tagged i64,
/// so unlike a scalar field it cannot be handed to arbitrary code. Only the
/// receiver position of a native array op consumes it correctly.
fn gc_native_struct_ref_field_reads_are_ops(expr: Expr, name: String, ctx: CompileCtxGc, ns_struct_idx: Int, local_names: Array[String]) -> Bool {
  match expr {
    EDot(EIdent(obj, _), field, _, _) => obj != name || !gc_ctor_field_is_ref(ctx.gc_ctor_table, ns_struct_idx, field),
    ECall(EIdent(fname, _), args, _) => {
      if fname == "__set_field" && Array::length(args) == 3 {
        match (Array::get(args, 0), Array::get(args, 1)) {
          (EIdent(obj, _), EString(field)) => if obj == name && gc_ctor_field_is_ref(ctx.gc_ctor_table, ns_struct_idx, field) {
            gc_expr_can_compile_native_array_ref(Array::get(args, 2), local_names, ctx)
          } else {
            gc_native_struct_ref_field_reads_are_ops(Array::get(args, 2), name, ctx, ns_struct_idx, local_names)
          },
          _ => gc_native_struct_ref_field_children_are_ops(expr, name, ctx, ns_struct_idx, local_names)
        }
      } else {
        let is_op = (fname == "Array::length" && Array::length(args) == 1) || (fname == "Array::get" && Array::length(args) == 2) || (fname == "Array::set" && Array::length(args) == 3)
        let mut ok = true
        let mut i = 0
        while i < Array::length(args) {
          let arg = Array::get(args, i)
          let receiver_ok = i == 0 && is_op && (match arg {
            EDot(EIdent(obj2, _), _, _, _) => obj2 == name,
            _ => false
          })
          if !receiver_ok && !gc_native_struct_ref_field_reads_are_ops(arg, name, ctx, ns_struct_idx, local_names) {
            ok = false
          } else {
            ()
          }
          i = i + 1
        }
        ok
      }
    },
    _ => gc_native_struct_ref_field_children_are_ops(expr, name, ctx, ns_struct_idx, local_names)
  }
}

fn gc_native_struct_ref_field_children_are_ops(expr: Expr, name: String, ctx: CompileCtxGc, ns_struct_idx: Int, local_names: Array[String]) -> Bool {
  let children = expr_children(expr)
  let mut i = 0
  let mut ok = true
  while i < Array::length(children) {
    if !gc_native_struct_ref_field_reads_are_ops(Array::get(children, i), name, ctx, ns_struct_idx, local_names) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn gc_native_struct_scope_is_safe(expr: Expr, name: String) -> Bool {
  match expr {
    EIdent(n, _) => n != name,
    // The one allowed shape. When the receiver IS `name` this is the field read
    // the lane exists for; when it is another binding, `name` does not occur
    // here at all. Either way nothing materializes the struct as a value.
    EDot(EIdent(_, _), _, _, _) => true,
    // #1702 writes: `p.x = v` lowers to `__set_field(p, "x", v)`. The receiver
    // is consumed by a struct.set here exactly as a read's receiver is consumed
    // by struct.get, so it never materializes as a value either -- but the
    // STORED value is an ordinary expression and still has to be checked, or
    // `p.x = p` would smuggle the struct out through its own field.
    ECall(EIdent(sf_callee, _), sf_args, _) => if sf_callee == "__set_field" && Array::length(sf_args) == 3 {
      match Array::get(sf_args, 0) {
        EIdent(_, _) => gc_native_struct_scope_is_safe(Array::get(sf_args, 2), name),
        _ => gc_native_struct_children_are_safe(expr, name)
      }
    } else {
      gc_native_struct_children_are_safe(expr, name)
    },
    EFn(_, _, _, _, _, _) => false,
    EMatch(_, _) => false,
    EHandle(_, _) => false,
    EForIn(_, _, _, _) => false,
    ELoop(_, _) => false,
    EBreak(_) => false,
    EContinue(_) => false,
    ELet(n, _, _, _) => n != name && gc_native_struct_children_are_safe(expr, name),
    ELetMut(n, _, _, _) => n != name && gc_native_struct_children_are_safe(expr, name),
    ELetRec(n, _, _) => n != name && gc_native_struct_children_are_safe(expr, name),
    EAssign(n, _, _) => n != name && gc_native_struct_children_are_safe(expr, name),
    EAssignOp(n, _, _, _) => n != name && gc_native_struct_children_are_safe(expr, name),
    _ => gc_native_struct_children_are_safe(expr, name)
  }
}

fn gc_native_struct_children_are_safe(expr: Expr, name: String) -> Bool {
  let children = expr_children(expr)
  let mut i = 0
  let mut ok = true
  while i < Array::length(children) {
    if !gc_native_struct_scope_is_safe(Array::get(children, i), name) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

/// Ctor-table index of the struct a record literal resolves to, or -1 when it
/// names no declared struct (an anonymous record has no declared field order to
/// fix a struct type to) or has no fields (a zero-field struct type is not
/// reserved and buys nothing).
fn gc_native_struct_field_set_matches(declared: Array[String], fields: Array[(String, Expr)]) -> Bool {
  if Array::length(declared) != Array::length(fields) {
    false
  } else {
    let mut di = 0
    let mut all = true
    while di < Array::length(declared) {
      let target = Array::get(declared, di)
      let mut fi = 0
      let mut found = false
      while fi < Array::length(fields) {
        let (fname, _) = Array::get(fields, fi)
        if fname == target {
          found = true
          fi = Array::length(fields)
        } else {
          fi = fi + 1
        }
      }
      if !found {
        all = false
      } else {
        ()
      }
      di = di + 1
    }
    all
  }
}

fn gc_native_struct_binding_index(ctx: CompileCtxGc, record_name: String, fields: Array[(String, Expr)]) -> Int {
  if Array::length(fields) == 0 {
    0 - 1
  } else if String::length(record_name) > 0 {
    let mut si = 0
    let mut found = 0 - 1
    while si < Array::length(ctx.gc_ctor_table.struct_names) {
      if Array::get(ctx.gc_ctor_table.struct_names, si) == record_name {
        found = si
        si = Array::length(ctx.gc_ctor_table.struct_names)
      } else {
        si = si + 1
      }
    }
    found
  } else {
    // Anonymous records have only shape evidence. Fail closed when more than
    // one nominal struct shares that shape, because their wasm field lanes may
    // differ even though their names do not.
    let mut si = 0
    let mut found = 0 - 1
    while si < Array::length(ctx.gc_ctor_table.struct_names) {
      if gc_native_struct_field_set_matches(Array::get(ctx.gc_ctor_table.struct_field_names, si), fields) {
        if found >= 0 {
          return 0 - 1
        } else {
          found = si
        }
      } else {
        ()
      }
      si = si + 1
    }
    found
  }
}

fn gc_native_struct_ref_initializers_are_compatible(ctx: CompileCtxGc, ns_struct_idx: Int, fields: Array[(String, Expr)], local_names: Array[String]) -> Bool {
  let declared = Array::get(ctx.gc_ctor_table.struct_field_names, ns_struct_idx)
  let refs = Array::get(ctx.gc_ctor_table.struct_field_is_ref, ns_struct_idx)
  let mut di = 0
  let mut ok = true
  while di < Array::length(declared) {
    if Array::get(refs, di) {
      let target = Array::get(declared, di)
      let mut fi = 0
      let mut compatible = false
      while fi < Array::length(fields) {
        let (fname, value) = Array::get(fields, fi)
        if fname == target {
          compatible = gc_expr_can_compile_native_array_ref(value, local_names, ctx)
          fi = Array::length(fields)
        } else {
          fi = fi + 1
        }
      }
      if !compatible {
        ok = false
      } else {
        ()
      }
    } else {
      ()
    }
    di = di + 1
  }
  ok
}

fn gc_arg_is_reference_join(arg: Expr) -> Bool {
  match arg {
    EIf(_, _, _) => true,
    _ => false
  }
}

/// `name` may reach a reference parameter through an `if` arm. Arms are
/// checked in tail position (each arm IS the argument); the condition is an
/// ordinary child, so a reference appearing there is still rejected.
fn gc_native_array_join_arg_is_safe(arg: Expr, name: String, abi_names: Array[String], abi_param_refs: Array[Array[Bool]]) -> Bool {
  match arg {
    EIf(cond, then_e, else_e) => gc_native_array_escape_gate(cond, name, false, abi_names, abi_param_refs) && gc_native_array_join_arg_is_safe(then_e, name, abi_names, abi_param_refs) && gc_native_array_join_arg_is_safe(else_e, name, abi_names, abi_param_refs),
    EIdent(_, _) => true,
    _ => gc_native_array_escape_gate(arg, name, false, abi_names, abi_param_refs)
  }
}

/// i64 fallback for an ELet after its name has already been pushed into
/// `local_names`. Keeping it separate makes the native-literal branch above
/// unable to accidentally feed a reference to the legacy local.set path.
fn gc_compile_let_i64(buf: Bytes, name: String, name_slot: Int, value: Expr, body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with Exception) -> Int with Exception {
  let local_idx = next_local
  if gc_expr_is_floatish(value, local_names, ctx) {
    Array::push(ctx.gc_float_locals, local_idx)
  } else if gc_expr_is_boolish(value, local_names, ctx) {
    Array::push(ctx.gc_bool_locals, local_idx)
  } else if gc_value_is_intish(value, local_names, ctx) {
    // #2405: last, so a value that is both boolish and intish by shape (a
    // comparison) keeps its boolish classification -- that one renders
    // "true"/"false", and Bool and Int share this lane's representation, so
    // reading it as an Int would print 1.
    Array::push(ctx.gc_int_locals, local_idx)
  } else {
    ()
  }
  let agg_entry = match value {
    ETuple(tels) => 64 + Array::length(tels),
    ERecord(_, rfields, _) => 128 + Array::length(rfields),
    _ => if gc_is_ctor_expr(value, ctx) {
      match value {
        ECall(_, cargs, _) => {
          let fcnt = if Array::length(cargs) == 1 {
            match Array::get(cargs, 0) {
              ERecord(_, crf, _) => Array::length(crf),
              _ => Array::length(cargs)
            }
          } else {
            Array::length(cargs)
          }
          128 + fcnt
        },
        _ => 128
      }
    } else {
      match value {
        EIdent(src_nm, _) => {
          let src_slot = find_local_slot(local_names, src_nm)
          if src_slot >= 0 {
            let src_info = agg_slot_lookup(ctx.gc_agg_local_slots, src_slot)
            if src_info > 0 {
              src_info
            } else {
              0
            }
          } else {
            0
          }
        },
        ECall(vcal, _, _) => match vcal {
          EIdent(cfn, _) => if find_local_slot(local_names, cfn) < 0 {
            let rinfo = agg_ret_lookup(ctx.gc_agg_ret_names, ctx.gc_agg_ret_infos, cfn)
            if rinfo > 0 {
              rinfo
            } else {
              0
            }
          } else {
            0
          },
          _ => 0
        },
        _ => 0
      }
    }
  }
  Array::push(ctx.gc_agg_local_slots, local_idx * 256 + agg_entry)
  let nl = ce(buf, value, local_names, next_local + 1, ld)
  emit_local_set(buf, local_idx)
  Array::set(local_names, name_slot, name)
  ce(buf, body, local_names, nl, ld)
}

//# Chain-interior renorm elision (#1877), gc-lane mirror of the linear lane's
//# compile_int_operand (compile_expr.vibe): the 63-bit renorm rewrites only
//# bit 63, and `+`/`-`/`*`/`<<`(lhs)/unary-minus derive bits 0..62 of their
//# result from bits 0..62 of their operands alone, so an arith result that
//# feeds another wrapping op skips its own renorm — the chain's outermost one
//# re-derives bit 63 before any observer, and per-op wrap values are unchanged.

/// True iff `e` compiles through the gc Int-arith fallthrough AND ends with a
/// renorm. Mirrors the EBinOp/EUnaryOp dispatch below: `&&`/`||`/`==`/`!=`
/// divert earlier; the float paths only claim `+`/`-`/`*`/`/` and compares,
/// so `<<` always lands on the Int fallthrough.
fn gc_is_untagged_wrap_arith(e: Expr, local_names: Array[String], ctx: CompileCtxGc) -> Bool {
  match e {
    EBinOp(op, lhs, rhs) => if op == "<<" {
      true
    } else if op == "+" || op == "-" || op == "*" || op == "/" {
      !gc_expr_is_floatish(lhs, local_names, ctx) && !gc_expr_is_floatish(rhs, local_names, ctx)
    } else {
      false
    },
    EUnaryOp(op, operand) => op == "-" && !gc_expr_is_floatish(operand, local_names, ctx),
    _ => false
  }
}

/// Compile one operand of the Int op `op`; wrapping consumers (`+`/`-`/`*`,
/// the shifted side of `<<`) elide a wrap-arith operand's trailing renorm.
fn gc_compile_int_operand(buf: Bytes, op: String, is_lhs: Bool, e: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int) -> Int with Exception {
  let tolerant = op == "+" || op == "-" || op == "*" || (op == "<<" && is_lhs)
  if tolerant && gc_is_untagged_wrap_arith(e, local_names, ctx) {
    gc_compile_wrap_arith_loose(buf, e, local_names, next_local, ctx, ld)
  } else {
    compile_expr_gc(buf, e, local_names, next_local, ctx, ld)
  }
}

/// Compile a wrap-arith expr with its trailing renorm ELIDED: bits 0..62
/// exact, bit 63 unspecified. Only reachable as the operand of a wrapping
/// consumer whose own renorm (or an ancestor's) runs before any observer.
/// Operands of an interior `/` still normalize; only its RESULT renorm defers.
fn gc_compile_wrap_arith_loose(buf: Bytes, e: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int) -> Int with Exception {
  match e {
    EBinOp(op, lhs, rhs) => {
      let nl1 = gc_compile_int_operand(buf, op, true, lhs, local_names, next_local, ctx, ld)
      let nl2 = gc_compile_int_operand(buf, op, false, rhs, local_names, nl1, ctx, ld)
      emit_binop_op(buf, op)
      nl2
    },
    EUnaryOp(_, operand) => {
      emit_i64_const(buf, 0)
      let nl = gc_compile_int_operand(buf, "-", false, operand, local_names, next_local, ctx, ld)
      emit_i64_sub(buf)
      nl
    },
    _ => throw("gc wrap-arith loose compile reached a non-arith expr")
  }
}

fn compile_expr_gc(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int) -> Int with Exception {
  let ce: (Bytes, Expr, Array[String], Int, Int) -> Int with Exception = (b, e, ln, nl, d) -> {
    compile_expr_gc(b, e, ln, nl, ctx, d)
  }
  match expr {
    EInt(n) => {
      emit_i64_const(buf, n)
      next_local
    },
    EBool(b_val) => {
      emit_i64_const(buf, if b_val {
        1
      } else {
        0
      })
      next_local
    },
    EFloat(v) => {
      // ADR-0055 Blocker-2: the full f64 bit pattern does NOT fit the 62-bit
      // tagged Int (`2.0` = 0x4000000000000000 = 2^62), so `Double::to_i64_bits`
      // cannot return it -- under RC it comes back halved, and every byte of the
      // emitted `f64.const` is the true byte `>> 1`. The linear backend was
      // migrated to the 32-bit halves (compile_expr.vibe); this gc-lane site was
      // left behind and silently miscompiled every float literal whenever the
      // COMPILER ITSELF was RC-built (gate 40h: 91527 vs 101557). Split the
      // pattern -- each half is <= 2^32-1 and fits.
      emit_f64_const_lohi(buf, Double::to_i64_bits_lo(v), Double::to_i64_bits_hi(v))
      emit_i64_reinterpret_f64(buf)
      next_local
    },
    EString(s) => {
      let idx = str_table_lookup(ctx.str_table.strs, s)
      emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))
      next_local
    },
    EIdent(raw_name, _) => {
      let name = if raw_name == "__try_none" {
        "None"
      } else {
        raw_name
      }
      if name == "Stdin::read_via_stream" || name == "StdinStream::next" || name == "StdinStream::close" || name == "StdinStream::read_chunk" {
        throw("StdinStream is unsupported on gc backend; compile an Async component with the linear or RC backend")
      } else {
        ()
      }
      let len = Array::length(local_names)
      let rec try_local: (Int) -> Int = (i) -> {
        if i < 0 {
          -1
        }
        else if Array::get(local_names, i) == name {
          i
        }
        else try_local(i - 1)
      }
      let local_idx = try_local(len - 1)
      if local_idx >= 0 {
        if array_contains_str(ctx.ref_cell_names, name) {
          // #538: ref cells are 8-byte linear-memory cells (NOT wasm-gc
          // structs): a (ref $t) value cannot cross the i64 world -- storing
          // a captured cell into a closure env emitted invalid wasm.
          emit_local_get(buf, local_idx)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, 0)
        } else {
          emit_local_get(buf, local_idx)
        }
        next_local
      } else if is_frozen_array_conversion_name(name) {
        ce(buf, frozen_array_conversion_closure(name), local_names, next_local, ld)
      } else {
        let ctor_idx = ctor_table_index_of(ctx.gc_ctor_table, name)
        if ctor_idx >= 0 {
          let tag_c = Array::get(ctx.gc_ctor_table.tags, ctor_idx)
          let ptr_l = next_local
          Array::push(local_names, "[gc-temp]__ctor_ptr")
          emit_global_get(buf, 0)
          emit_i64_extend_i32_u(buf)
          emit_local_set(buf, ptr_l)
          emit_global_get(buf, 0)
          emit_i32_const(buf, 8)
          emit_i32_add(buf)
          emit_global_set(buf, 0)
          // #415: gc-lane heap bump must grow linear memory like the linear
          // backend does -- without this any allocation past the initial page
          // traps OOB (the gc smoke fixture only ever allocated a few bytes).
          emit_heap_memory_grow_check(buf)
          emit_local_get(buf, ptr_l)
          emit_i32_wrap_i64(buf)
          emit_i32_const(buf, tag_c)
          emit_i32_store(buf, 2, 0)
          emit_local_get(buf, ptr_l)
          emit_i32_wrap_i64(buf)
          emit_i32_const(buf, 0)
          emit_i32_store(buf, 2, 4)
          emit_local_get(buf, ptr_l)
          emit_i64_const(buf, 1)
          emit_i64_or(buf)
          next_local + 1
        } else {
          // #538: module-level literal constants (`let op_call = 16`).
          let mut const_i = -1
          let mut __gc = 0
          while __gc < Array::length(ctx.gc_const_names) {
            if Array::get(ctx.gc_const_names, __gc) == name {
              const_i = __gc
              __gc = Array::length(ctx.gc_const_names)
            } else {
              __gc = __gc + 1
            }
          }
          if const_i >= 0 {
            if Array::get(ctx.gc_const_kinds, const_i) == 1 {
              let cs = Array::get(ctx.gc_const_svals, const_i)
              let csi = str_table_lookup(ctx.str_table.strs, cs)
              emit_str_ref(buf, Array::get(ctx.str_table.offsets, csi), Array::get(ctx.str_table.lengths, csi))
            } else {
              emit_i64_const(buf, Array::get(ctx.gc_const_ivals, const_i))
            }
            return next_local
          }
          // #538: computed module-level global (mutable i64, init in _start).
          let mut glob_i = -1
          let mut __gg = 0
          while __gg < Array::length(ctx.gc_global_names) {
            if Array::get(ctx.gc_global_names, __gg) == name {
              glob_i = __gg
              __gg = Array::length(ctx.gc_global_names)
            } else {
              __gg = __gg + 1
            }
          }
          if glob_i >= 0 {
            emit_global_get(buf, 1 + glob_i)
            return next_local
          }
          let fn_len = Array::length(ctx.func_table.names)
          let mut fni = -1
          let mut __fj = 0
          while __fj < fn_len {
            if Array::get(ctx.func_table.names, __fj) == name {
              fni = __fj
              __fj = fn_len
            } else {
              __fj = __fj + 1
            }
          }
          if fni < 0 {
            // See `resolve_local` in common_base: a checker hole, not a user
            // error. Same wording as the two linear-backend sites.
            throw(String::concat(String::concat(codegen_unresolved_name_prefix(), name), String::concat("` (gc ident", codegen_unresolved_name_suffix())))
          }
          let fidx = Array::get(ctx.func_table.indices, fni)
          let table_slot = fidx - ctx.func_offset
          Array::push(ctx.table_slots_used, table_slot)
          emit_i64_const(buf, (table_slot<<2)|2)
          next_local
        }
      }
    },
    EBinOp(op, lhs, rhs) => if op == "&&" || op == "||" {
      // Short-circuit lowering (mirrors the linear lane): the emit_binop_op
      // fallthrough's eager `i64.and`/`i64.or` evaluated BOTH operands, so
      // `false && inc()` ran inc()'s side effects. gc-lane bools are raw
      // 1/0 i64s; eqz treats any non-zero as true.
      let nl1 = ce(buf, lhs, local_names, next_local, ld)
      emit_i64_eqz(buf)
      if op == "&&" {
        emit_if_i64(buf)
        emit_i64_const(buf, 0)
        emit_else(buf)
        let nl2 = ce(buf, rhs, local_names, nl1, ld)
        emit_end(buf)
        nl2
      } else {
        emit_if_i64(buf)
        let nl2 = ce(buf, rhs, local_names, nl1, ld)
        emit_else(buf)
        emit_i64_const(buf, 1)
        emit_end(buf)
        nl2
      }
    } else if op == "==" {
      emit_gc_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr_gc)
    } else if op == "!=" {
      let nle = emit_gc_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr_gc)
      emit_i64_eqz(buf)
      emit_i64_extend_i32_s(buf)
      nle
    } else if (op == "+" || op == "-" || op == "*" || op == "/") && (gc_expr_is_floatish(lhs, local_names, ctx) || gc_expr_is_floatish(rhs, local_names, ctx)) {
      // Float arithmetic: locals hold raw f64 bits in i64; reinterpret both
      // sides, run the f64 op, reinterpret back. The unconditional i64 ops
      // below compute garbage on float bits (linear routes these through
      // expr_is_floatish the same way).
      let nl1 = ce(buf, lhs, local_names, next_local, ld)
      emit_f64_reinterpret_i64(buf)
      let nl2 = ce(buf, rhs, local_names, nl1, ld)
      emit_f64_reinterpret_i64(buf)
      if op == "+" {
        emit_f64_add(buf)
      } else if op == "-" {
        emit_f64_sub(buf)
      } else if op == "*" {
        emit_f64_mul(buf)
      } else {
        emit_f64_div(buf)
      }
      emit_i64_reinterpret_f64(buf)
      nl2
    } else if (op == "<" || op == ">" || op == "<=" || op == ">=") && (gc_expr_is_floatish(lhs, local_names, ctx) || gc_expr_is_floatish(rhs, local_names, ctx)) {
      // Float ordering: signed-i64 compare of raw f64 bits inverts the order
      // whenever both sides are negative (and misranks mixed signs vs -0.0),
      // so route through real f64 comparisons (mirrors the linear lane).
      let nl1 = ce(buf, lhs, local_names, next_local, ld)
      emit_f64_reinterpret_i64(buf)
      let nl2 = ce(buf, rhs, local_names, nl1, ld)
      emit_f64_reinterpret_i64(buf)
      if op == "<" {
        emit_f64_lt(buf)
      } else if op == ">" {
        emit_f64_gt(buf)
      } else if op == "<=" {
        emit_f64_le(buf)
      } else {
        emit_f64_ge(buf)
      }
      emit_i64_extend_i32_s(buf)
      nl2
    } else {
      // #1877: renormalize Int arithmetic to the 63-bit range (gc holds
      // untagged i64s, which otherwise wrap at 64 bits — diverging from the
      // linear lane with no diagnostic). Wrapping consumers elide the
      // operand's own trailing renorm (gc_compile_int_operand above).
      let nl1 = gc_compile_int_operand(buf, op, true, lhs, local_names, next_local, ctx, ld)
      let nl2 = gc_compile_int_operand(buf, op, false, rhs, local_names, nl1, ctx, ld)
      emit_binop_op(buf, op)
      emit_arith_wrap_int(buf, false, op)
      nl2
    },
    EUnaryOp(op, operand) => if op == "-" && gc_expr_is_floatish(operand, local_names, ctx) {
      // `0 - bits` integer-negates the f64 bit pattern; use f64.neg instead.
      let nl = ce(buf, operand, local_names, next_local, ld)
      emit_f64_reinterpret_i64(buf)
      emit_f64_neg(buf)
      emit_i64_reinterpret_f64(buf)
      nl
    } else if op == "-" {
      emit_i64_const(buf, 0)
      let nl = gc_compile_int_operand(buf, "-", false, operand, local_names, next_local, ctx, ld)
      emit_i64_sub(buf)
      emit_arith_wrap_int(buf, false, "-")
      nl
    } else if op == "!" {
      let nl = ce(buf, operand, local_names, next_local, ld)
      emit_i64_eqz(buf)
      emit_i64_extend_i32_s(buf)
      nl
    } else if op == "~" {
      // #2344 slice C: bit-not as `x ^ -1`. This lane keeps `Int` untagged,
      // so -1 is spelled directly -- the linear lane's RC branch needs
      // tagged(-1) = -2 for the same operation.
      let nl = ce(buf, operand, local_names, next_local, ld)
      emit_i64_const(buf, 0 - 1)
      emit_i64_xor(buf)
      nl
    } else {
      throw(String::concat("unsupported unary op: ", op))
    }
    ,
    EIf(cond, then_e, else_e) => {
      let nl1 = match cond {
        EBinOp(cop, clhs, crhs) => if cop == "==" {
          // #538 P4.5: `==`/`!=` route through emit_gc_eq_value (structural
          // tuple/ctor compare, string content via the `eq` builtin); the
          // result is shaped back into the raw comparison's i32 0/1.
          let cnl = emit_gc_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr_gc)
          emit_i32_wrap_i64(buf)
          cnl
        } else if cop == "!=" {
          let cnl = emit_gc_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr_gc)
          emit_i64_eqz(buf)
          cnl
        } else if (cop == "<" || cop == ">" || cop == "<=" || cop == ">=") && (gc_expr_is_floatish(clhs, local_names, ctx) || gc_expr_is_floatish(crhs, local_names, ctx)) {
          // Same f64-vs-raw-bits ordering fix as the EBinOp float comparison
          // branch; the fast path leaves the comparison's i32 for the `if`.
          let cnl1 = ce(buf, clhs, local_names, next_local, ld)
          emit_f64_reinterpret_i64(buf)
          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)
          emit_f64_reinterpret_i64(buf)
          if cop == "<" {
            emit_f64_lt(buf)
          }
          else if cop == ">" {
            emit_f64_gt(buf)
          }
          else if cop == "<=" {
            emit_f64_le(buf)
          }
          else {
            emit_f64_ge(buf)
          }
          cnl2
        } else if cop == "<" || cop == ">" || cop == "<=" || cop == ">=" {
          let cnl1 = ce(buf, clhs, local_names, next_local, ld)
          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)
          if cop == "<" {
            emit_i64_lt_s(buf)
          }
          else if cop == ">" {
            emit_i64_gt_s(buf)
          }
          else if cop == "<=" {
            emit_i64_le_s(buf)
          }
          else {
            emit_i64_ge_s(buf)
          }
          cnl2
        } else {
          let cnl = ce(buf, cond, local_names, next_local, ld)
          emit_i32_wrap_i64(buf)
          cnl
        },
        EBool(b_val) => {
          emit_i32_const(buf, if b_val {
            1
          } else {
            0
          })
          next_local
        },
        _ => {
          let cnl = ce(buf, cond, local_names, next_local, ld)
          emit_i32_wrap_i64(buf)
          cnl
        }
      }
      // #1541 reference-lane join: when both arms already hold a native array
      // reference the result cannot be described by a single-byte blocktype,
      // so the `if` names the reserved func type instead. Everything else stays
      // on the i64 blocktype byte-for-byte.
      if gc_join_is_native_ref(then_e, else_e, local_names, ctx) {
        emit_if_type_index(buf, ctx.gc_native_array_block_type_idx)
      } else {
        emit_if_i64(buf)
      }
      let ld_inner = if ld >= 0 {
        ld + 1
      } else {
        -1
      }
      let names_len_before = Array::length(local_names)
      let nl_then = ce(buf, then_e, local_names, nl1, ld_inner)
      emit_else(buf)
      Array::truncate(local_names, names_len_before)
      agg_log_reset_above(ctx.gc_agg_local_slots, names_len_before)
      gc_slot_log_reset_above(ctx.gc_bool_locals, names_len_before)
      gc_slot_log_reset_above(ctx.gc_int_locals, names_len_before)
      gc_slot_log_reset_above(ctx.gc_float_locals, names_len_before)
      gc_slot_log_reset_above(ctx.gc_native_array_locals, names_len_before)
      gc_slot_map_reset_above(ctx.gc_native_struct_scope, names_len_before)
      // #1985: the else arm reuses the then arm's slots -- the linear lane's
      // numbering -- unless it may bind a TYPED local of its own, in which
      // case it starts above everything the then arm allocated. Stacking the
      // arms unconditionally grew a frame's local count as 2^nesting-depth on
      // code that never had a typed local to protect.
      let else_start = gc_sibling_scope_start(ctx, local_names, else_e, nl1, nl_then)
      while Array::length(local_names) < else_start {
        Array::push(local_names, "")
      }
      let nl_else = ce(buf, else_e, local_names, else_start, ld_inner)
      emit_end(buf)
      Array::truncate(local_names, names_len_before)
      agg_log_reset_above(ctx.gc_agg_local_slots, names_len_before)
      gc_slot_log_reset_above(ctx.gc_bool_locals, names_len_before)
      gc_slot_log_reset_above(ctx.gc_int_locals, names_len_before)
      gc_slot_log_reset_above(ctx.gc_float_locals, names_len_before)
      gc_slot_log_reset_above(ctx.gc_native_array_locals, names_len_before)
      gc_slot_map_reset_above(ctx.gc_native_struct_scope, names_len_before)
      // `nl_else` is the high-water mark on its own only while the arms are
      // stacked; once they share slots (#1985) either arm can be the taller.
      let max_nl = if nl_else > nl_then {
        nl_else
      } else {
        nl_then
      }
      while Array::length(local_names) < max_nl {
        Array::push(local_names, "")
      }
      max_nl
    },
    ECall(callee, args, _) => compile_call_gc(buf, callee, args, local_names, next_local, ctx, ld, ce),
    ELet(name, value, body, _) => {
      let local_idx = next_local
      let name_slot = Array::length(local_names)
      Array::push(local_names, name)
      // A non-recursive binder is not visible in its own initializer. Reserve
      // its wasm slot but hide the source name until the body (#2160; mirrors
      // the linear lane's #1120 masking).
      Array::set(local_names, name_slot, "")
      match value {
        // #1702: a record literal bound to a local that never leaves field-read
        // position lives in a real wasm-gc struct instead of linear memory.
        ERecord(ns_name, ns_fields, _) => {
          let ns_struct_idx = gc_native_struct_binding_index(ctx, ns_name, ns_fields)
          if ctx.gc_native_struct_type_base >= 0 && ctx.gc_native_array_frame_ok && ns_struct_idx >= 0 && gc_native_struct_ref_initializers_are_compatible(ctx, ns_struct_idx, ns_fields, local_names) && gc_native_struct_scope_is_safe(body, name) && gc_native_struct_ref_field_reads_are_ops(body, name, ctx, ns_struct_idx, local_names) {
            let ns_declared = Array::get(ctx.gc_ctor_table.struct_field_names, ns_struct_idx)
            let ns_field_refs = Array::get(ctx.gc_ctor_table.struct_field_is_ref, ns_struct_idx)
            gc_slot_map_set(ctx.gc_native_struct_scope, local_idx, ns_struct_idx)
            gc_slot_map_set(ctx.gc_native_struct_decl, local_idx, ns_struct_idx)
            // struct.new takes its fields as operands, so they go on the stack in
            // DECLARED order however the literal spelled them.
            let mut ns_nl = next_local + 1
            let mut ns_di = 0
            while ns_di < Array::length(ns_declared) {
              let ns_target = Array::get(ns_declared, ns_di)
              let mut ns_fi = 0
              let mut ns_emitted = false
              while ns_fi < Array::length(ns_fields) {
                let (ns_fname, ns_fval) = Array::get(ns_fields, ns_fi)
                if !ns_emitted && ns_fname == ns_target {
                  // #1542: a field declared `Array[Int]` holds `(ref null $array)`,
                  // so its operand has to be produced on the reference lane rather
                  // than as a tagged i64.
                  ns_nl = if Array::get(ns_field_refs, ns_di) {
                    gc_compile_native_array_ref(buf, ns_fval, local_names, ns_nl, ctx, ld, ce)
                  } else {
                    ce(buf, ns_fval, local_names, ns_nl, ld)
                  }
                  ns_emitted = true
                } else {
                  ()
                }
                ns_fi = ns_fi + 1
              }
              if !ns_emitted {
                throw("gc native struct: literal is missing declared field")
              } else {
                ()
              }
              ns_di = ns_di + 1
            }
            emit_struct_new(buf, ctx.gc_native_struct_type_base + ns_struct_idx)
            emit_local_set(buf, local_idx)
            Array::set(local_names, name_slot, name)
            ce(buf, body, local_names, ns_nl, ld)
          } else {
            gc_compile_let_i64(buf, name, name_slot, value, body, local_names, next_local, ctx, ld, ce)
          }
        },
        EArray(native_elems) => if ctx.gc_native_array_frame_ok && ctx.gc_native_array_type_idx >= 0 && gc_native_array_body_is_safe_tail(body, name, ctx.gc_direct_abi_current_return_ref, ctx) {
          // This local is a `(ref null $native_i64_array)`, never an i64.
          Array::push(ctx.gc_native_array_locals, local_idx)
          Array::push(ctx.gc_native_array_local_types, local_idx)
          emit_i32_const(buf, Array::length(native_elems))
          emit_array_new_default(buf, ctx.gc_native_array_type_idx)
          emit_local_set(buf, local_idx)
          let mut native_nl = next_local + 1
          let mut ni = 0
          while ni < Array::length(native_elems) {
            emit_local_get(buf, local_idx)
            emit_i32_const(buf, ni)
            native_nl = ce(buf, Array::get(native_elems, ni), local_names, native_nl, ld)
            emit_array_set(buf, ctx.gc_native_array_type_idx)
            ni = ni + 1
          }
          Array::set(local_names, name_slot, name)
          ce(buf, body, local_names, native_nl, ld)
        } else {
          gc_compile_let_i64(buf, name, name_slot, value, body, local_names, next_local, ctx, ld, ce)
        },
        EIdent(source, _) => {
          let source_slot = find_local_slot(local_names, source)
          if source_slot >= 0 && array_contains_int(ctx.gc_native_array_locals, source_slot) && gc_native_array_body_is_safe_tail(body, name, ctx.gc_direct_abi_current_return_ref, ctx) {
            Array::push(ctx.gc_native_array_locals, local_idx)
            Array::push(ctx.gc_native_array_local_types, local_idx)
            emit_local_get(buf, source_slot)
            emit_local_set(buf, local_idx)
            Array::set(local_names, name_slot, name)
            ce(buf, body, local_names, next_local + 1, ld)
          } else {
            gc_compile_let_i64(buf, name, name_slot, value, body, local_names, next_local, ctx, ld, ce)
          }
        },
        ECall(_, _, _) => if gc_expr_can_compile_native_array_ref(value, local_names, ctx) && gc_native_array_body_is_safe_tail(body, name, ctx.gc_direct_abi_current_return_ref, ctx) {
          Array::push(ctx.gc_native_array_locals, local_idx)
          Array::push(ctx.gc_native_array_local_types, local_idx)
          let native_nl = ce(buf, value, local_names, next_local + 1, ld)
          emit_local_set(buf, local_idx)
          Array::set(local_names, name_slot, name)
          ce(buf, body, local_names, native_nl, ld)
        } else {
          gc_compile_let_i64(buf, name, name_slot, value, body, local_names, next_local, ctx, ld, ce)
        },
        _ => gc_compile_let_i64(buf, name, name_slot, value, body, local_names, next_local, ctx, ld, ce)
      }
    },
    ELetRec(name, value, body) => {
      let local_idx = next_local
      Array::push(local_names, name)
      let nl = ce(buf, value, local_names, next_local + 1, ld)
      emit_local_set(buf, local_idx)
      match value {
        EFn(_, _, params, _, _, fn_body) => {
          let param_names_bp = array_empty()
          let mut bpi = 0
          while bpi < Array::length(params) {
            let (pn, _) = Array::get(params, bpi)
            // The parser keeps the label marker ON THE NAME (`n~`), while the
            // body says `n`. Pushing the raw name leaves `n` unbound for
            // `collect_free_vars`, so it becomes a bogus capture, every later
            // capture shifts, and `self_cap_idx` names the wrong slot -- the
            // self-closure is then stored outside its environment and the call
            // traps with "uninitialized element". Measured: a `let rec` lambda
            // with a labeled parameter trapped on gc and ran on linear; the
            // same lambda without the label was fine on both (#2422 review).
            //
            // This is the fourth binding site in the #2404 family. Defined
            // beside its caller rather than imported: a brand-new cross-file
            // export plus its first cross-file caller in one change does not
            // survive the merge-flatten (the gotcha `edp_strip_tilde` records).
            Array::push(param_names_bp, gbe_strip_param_label_marker(pn))
            bpi = bpi + 1
          }
          let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.gc_ctor_table.names))
          let mut self_cap_idx = -1
          let mut bci = 0
          while bci < Array::length(caps) {
            if Array::get(caps, bci) == name {
              self_cap_idx = bci
            }
            bci = bci + 1
          }
          if self_cap_idx >= 0 {
            emit_local_get(buf, local_idx)
            emit_i64_const(buf, -4)
            emit_i64_and(buf)
            emit_i32_wrap_i64(buf)
            emit_local_get(buf, local_idx)
            emit_i64_store(buf, 3, 8 + self_cap_idx * 8)
          }
          0
        },
        _ => 0
      }
      ce(buf, body, local_names, nl, ld)
    },
    ELetMut(name, value, body, _) => {
      let local_idx = next_local
      Array::push(local_names, name)
      if mut_needs_ref_cell(body, name) {
        Array::push(ctx.ref_cell_names, name)
        // Linear-memory cell: local = cell address (i64), value stored at +0.
        emit_global_get(buf, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, local_idx)
        emit_global_get(buf, 0)
        emit_i32_const(buf, 8)
        emit_i32_add(buf)
        emit_global_set(buf, 0)
        emit_heap_memory_grow_check(buf)
        emit_local_get(buf, local_idx)
        emit_i32_wrap_i64(buf)
        let nl = ce(buf, value, local_names, next_local + 1, ld)
        emit_i64_store(buf, 3, 0)
        Array::push(ctx.ref_local_indices, local_idx)
        let nl2 = ce(buf, body, local_names, nl, ld)
        nl2
      } else {
        if gc_expr_is_floatish(value, local_names, ctx) {
          // #1032: logged by SLOT (local_idx), not name -- see
          // gc_float_locals' doc comment on CompileCtxGc.
          Array::push(ctx.gc_float_locals, local_idx)
        } else if gc_expr_is_boolish(value, local_names, ctx) {
          // #1015: logged by SLOT (local_idx), not name -- see
          // gc_bool_locals' doc comment on CompileCtxGc.
          Array::push(ctx.gc_bool_locals, local_idx)
        } else if gc_value_is_intish(value, local_names, ctx) {
          // #2422: `let mut` was the third binding form the int log missed
          // (annotated params and aliases were the other two), so
          // `let mut x = 64 << 32` rendered as the empty string.
          //
          // Only the non-ref-cell branch: a `let mut` captured by a closure
          // becomes a heap CELL whose local holds the cell ADDRESS, not the
          // value, and classifying the address as an Int would be exactly the
          // confusion this log exists to prevent.
          Array::push(ctx.gc_int_locals, local_idx)
        } else {
          ()
        }
        let nl = ce(buf, value, local_names, next_local + 1, ld)
        emit_local_set(buf, local_idx)
        let nl2 = ce(buf, body, local_names, nl, ld)
        nl2
      }
    },
    EAssign(name, value, body) => {
      let idx = resolve_local(local_names, name, "gc_var")
      if array_contains_str(ctx.ref_cell_names, name) {
        emit_local_get(buf, idx)
        emit_i32_wrap_i64(buf)
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_i64_store(buf, 3, 0)
        ce(buf, body, local_names, nl, ld)
      } else {
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_local_set(buf, idx)
        ce(buf, body, local_names, nl, ld)
      }
    },
    EAssignOp(name, op, value, body) => {
      let idx = resolve_local(local_names, name, "gc_var")
      if array_contains_str(ctx.ref_cell_names, name) {
        emit_local_get(buf, idx)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, idx)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, 0)
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_assignop_op(buf, op)
        emit_arith_wrap_int(buf, false, op)
        emit_i64_store(buf, 3, 0)
        ce(buf, body, local_names, nl, ld)
      } else {
        emit_local_get(buf, idx)
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_assignop_op(buf, op)
        emit_arith_wrap_int(buf, false, op)
        emit_local_set(buf, idx)
        ce(buf, body, local_names, nl, ld)
      }
    },
    ESeq(first, second) => {
      let nl_s = ce(buf, first, local_names, next_local, ld)
      emit_drop(buf)
      ce(buf, second, local_names, nl_s, ld)
    },
    ETuple(elems) => {
      let num_elems = Array::length(elems)
      let alloc_size = num_elems * 8
      let ptr_local = next_local
      Array::push(local_names, "[gc-temp]__tuple_ptr")
      let mut nl = next_local + 1
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_tee(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, alloc_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      // #415: gc-lane heap bump must grow linear memory like the linear
      // backend does -- without this any allocation past the initial page
      // traps OOB (the gc smoke fixture only ever allocated a few bytes).
      emit_heap_memory_grow_check(buf)
      let mut ti = 0
      while ti < num_elems {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        nl = ce(buf, Array::get(elems, ti), local_names, nl, ld)
        emit_i64_store(buf, 3, ti * 8)
        ti = ti + 1
      }
      emit_local_get(buf, ptr_local)
      nl
    },
    EMatch(scrutinee, arms) => compile_match_gc(buf, scrutinee, arms, local_names, next_local, ctx, ld, ce),
    EArray(elems) => {
      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, "array_new")
      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, "Array::push")
      let arr_local = next_local
      if ctx.func_offset > 0 && arr_new_idx >= ctx.func_offset {
        emit_i64_const(buf, 0)
      } else {
        ()
      }
      emit_call(buf, arr_new_idx)
      emit_local_set(buf, arr_local)
      Array::push(local_names, "[gc-temp]__arr_lit")
      let mut nl = next_local + 1
      let mut ei = 0
      while ei < Array::length(elems) {
        emit_local_get(buf, arr_local)
        nl = ce(buf, Array::get(elems, ei), local_names, nl, ld)
        if ctx.func_offset > 0 && arr_push_idx >= ctx.func_offset {
          emit_i64_const(buf, 0)
        } else {
          ()
        }
        emit_call(buf, arr_push_idx)
        ei = ei + 1
      }
      emit_local_get(buf, arr_local)
      nl
    },
    EForIn(var_name, index_name, iter_expr, body) => {
      // #538 P4.5: `for x in xs { ... }` is an EXPRESSION (comprehension) —
      // collect each body value into a fresh result array, exactly like the
      // linear lane (compile_expr_tail2). The old statement-shaped loop
      // DROPPED body values and yielded 0, so comprehension mappings like
      // type_to_string's `let parts = for p in params { type_to_string(p) }`
      // (and subst_apply's CtFn param map) produced EMPTY arrays when the
      // gc-compiled compiler ran — every 1+-param function type resolved and
      // printed as `()`, failing unify with "expected X, got X" diagnostics.
      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, "array_new")
      let (arr_len_idx, _, _) = resolve_func(ctx.func_table, "Array::length")
      let (arr_get_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, "Array::push")
      let names_len_at_forin = Array::length(local_names)
      let result_local = next_local
      let arr_local = next_local + 1
      let i_local = next_local + 2
      Array::push(local_names, "[gc-temp]__forin_res")
      Array::push(local_names, "[gc-temp]__forin_arr")
      Array::push(local_names, "[gc-temp]__forin_i")
      if ctx.func_offset > 0 && arr_new_idx >= ctx.func_offset {
        emit_i64_const(buf, 0)
      } else {
        ()
      }
      emit_call(buf, arr_new_idx)
      emit_local_set(buf, result_local)
      let nl1pre = ce(buf, iter_expr, local_names, next_local + 3, ld)
      emit_local_set(buf, arr_local)
      // #1295: String is a packed `(offset << 32) | length` value, not an
      // Array heap pointer. Detect nonempty packed strings and materialize
      // their character codes before entering the existing Array loop.
      // Array pointers have zero high bits, so they bypass this conversion.
      let (str_len_idx, _, _) = resolve_func(ctx.func_table, "String::length")
      let (str_ccat_idx, _, _) = resolve_func(ctx.func_table, "String::char_code_at")
      let conv_local = nl1pre
      let j_local = nl1pre + 1
      Array::push(local_names, "[gc-temp]__forin_string_chars")
      Array::push(local_names, "[gc-temp]__forin_string_i")
      let nl1 = nl1pre + 2
      emit_local_get(buf, arr_local)
      emit_i64_const(buf, 32)
      emit_i64_shr_s(buf)
      emit_i64_eqz(buf)
      emit_if_void(buf)
      emit_else(buf)
      if ctx.func_offset > 0 && arr_new_idx >= ctx.func_offset {
        emit_i64_const(buf, 0)
      } else {
        ()
      }
      emit_call(buf, arr_new_idx)
      emit_local_set(buf, conv_local)
      emit_i64_const(buf, 0)
      emit_local_set(buf, j_local)
      emit_block_void(buf)
      emit_loop_void(buf)
      emit_local_get(buf, j_local)
      emit_local_get(buf, arr_local)
      if ctx.func_offset > 0 && str_len_idx >= ctx.func_offset {
        emit_i64_const(buf, 0)
      } else {
        ()
      }
      emit_call(buf, str_len_idx)
      emit_i64_ge_s(buf)
      emit_br_if(buf, 1)
      emit_local_get(buf, conv_local)
      emit_local_get(buf, arr_local)
      emit_local_get(buf, j_local)
      if ctx.func_offset > 0 && str_ccat_idx >= ctx.func_offset {
        emit_i64_const(buf, 0)
      } else {
        ()
      }
      emit_call(buf, str_ccat_idx)
      if ctx.func_offset > 0 && arr_push_idx >= ctx.func_offset {
        emit_i64_const(buf, 0)
      } else {
        ()
      }
      emit_call(buf, arr_push_idx)
      emit_local_get(buf, j_local)
      emit_i64_const(buf, 1)
      emit_i64_add(buf)
      emit_local_set(buf, j_local)
      emit_br(buf, 0)
      emit_end(buf)
      emit_end(buf)
      emit_local_get(buf, conv_local)
      emit_local_set(buf, arr_local)
      emit_end(buf)
      emit_i64_const(buf, 0)
      emit_local_set(buf, i_local)
      emit_block_void(buf)
      emit_loop_void(buf)
      emit_local_get(buf, i_local)
      emit_local_get(buf, arr_local)
      if ctx.func_offset > 0 && arr_len_idx >= ctx.func_offset {
        emit_i64_const(buf, 0)
      } else {
        ()
      }
      emit_call(buf, arr_len_idx)
      emit_i64_ge_s(buf)
      emit_br_if(buf, 1)
      let var_local = match index_name {
        Some(idx_name) => {
          emit_local_get(buf, i_local)
          emit_local_set(buf, nl1)
          Array::push(local_names, idx_name)
          nl1 + 1
        },
        None => nl1
      }
      emit_local_get(buf, arr_local)
      emit_local_get(buf, i_local)
      if ctx.func_offset > 0 && arr_get_idx >= ctx.func_offset {
        emit_i64_const(buf, 0)
      } else {
        ()
      }
      emit_call(buf, arr_get_idx)
      emit_local_set(buf, var_local)
      Array::push(local_names, var_name)
      // #1967: step the index before the body. `continue` is `br` to this
      // loop header (`ld = 0`). If the increment stayed after the body, an
      // even-element `continue` retried the same `i` forever.
      emit_local_get(buf, i_local)
      emit_i64_const(buf, 1)
      emit_i64_add(buf)
      emit_local_set(buf, i_local)
      let nl3 = var_local + 1
      // Same innermost-loop ld reset as EWhile.
      let nl4 = ce(buf, body, local_names, nl3, 0)
      let body_val = nl4
      Array::push(local_names, "[gc-temp]__forin_val")
      emit_local_set(buf, body_val)
      emit_local_get(buf, result_local)
      emit_local_get(buf, body_val)
      if ctx.func_offset > 0 && arr_push_idx >= ctx.func_offset {
        emit_i64_const(buf, 0)
      } else {
        ()
      }
      emit_call(buf, arr_push_idx)
      emit_br(buf, 0)
      emit_end(buf)
      emit_end(buf)
      emit_local_get(buf, result_local)
      // Restore the outer name scope (loop-internal binds must not shadow
      // later lookups) while preserving slot numbering — linear parity.
      let final_nl = nl4 + 1
      Array::truncate(local_names, names_len_at_forin)
      agg_log_reset_above(ctx.gc_agg_local_slots, names_len_at_forin)
      gc_slot_log_reset_above(ctx.gc_bool_locals, names_len_at_forin)
      gc_slot_log_reset_above(ctx.gc_int_locals, names_len_at_forin)
      gc_slot_log_reset_above(ctx.gc_float_locals, names_len_at_forin)
      while Array::length(local_names) < final_nl {
        Array::push(local_names, "")
      }
      final_nl
    },
    EWhile(cond, body) => {
      // ld reset: a new loop is the new INNERMOST loop, so break/continue
      // distances restart at 0 (mirrors the linear EWhile fix — the old
      // `ld + 1` made an inner `break` jump to the OUTER loop header).
      emit_block_void(buf)
      emit_loop_void(buf)
      let nl1 = match cond {
        EBinOp(wcop, wlhs, wrhs) => if wcop == "==" {
          // #538 P4.5: same emit_gc_eq_value routing as the EIf fast path;
          // each branch leaves the raw comparison's i32 0/1 shape so the
          // shared i32_eqz inversion below applies uniformly.
          let wnl = emit_gc_eq_value(buf, wlhs, wrhs, local_names, next_local, ctx, 0, compile_expr_gc)
          emit_i32_wrap_i64(buf)
          emit_i32_eqz(buf)
          wnl
        } else if wcop == "!=" {
          let wnl = emit_gc_eq_value(buf, wlhs, wrhs, local_names, next_local, ctx, 0, compile_expr_gc)
          emit_i64_eqz(buf)
          emit_i32_eqz(buf)
          wnl
        } else if (wcop == "<" || wcop == ">" || wcop == "<=" || wcop == ">=") && (gc_expr_is_floatish(wlhs, local_names, ctx) || gc_expr_is_floatish(wrhs, local_names, ctx)) {
          // Same f64-vs-raw-bits ordering fix as the EBinOp/EIf float
          // comparison branches; leaves the i32 for the shared eqz below.
          let wnl1 = ce(buf, wlhs, local_names, next_local, 0)
          emit_f64_reinterpret_i64(buf)
          let wnl2 = ce(buf, wrhs, local_names, wnl1, 0)
          emit_f64_reinterpret_i64(buf)
          if wcop == "<" {
            emit_f64_lt(buf)
          }
          else if wcop == ">" {
            emit_f64_gt(buf)
          }
          else if wcop == "<=" {
            emit_f64_le(buf)
          }
          else {
            emit_f64_ge(buf)
          }
          emit_i32_eqz(buf)
          wnl2
        } else if wcop == "<" || wcop == ">" || wcop == "<=" || wcop == ">=" {
          let wnl1 = ce(buf, wlhs, local_names, next_local, 0)
          let wnl2 = ce(buf, wrhs, local_names, wnl1, 0)
          if wcop == "<" {
            emit_i64_lt_s(buf)
          }
          else if wcop == ">" {
            emit_i64_gt_s(buf)
          }
          else if wcop == "<=" {
            emit_i64_le_s(buf)
          }
          else {
            emit_i64_ge_s(buf)
          }
          emit_i32_eqz(buf)
          wnl2
        } else {
          let wnl = ce(buf, cond, local_names, next_local, 0)
          emit_i64_eqz(buf)
          wnl
        },
        _ => {
          let wnl = ce(buf, cond, local_names, next_local, 0)
          emit_i64_eqz(buf)
          wnl
        }
      }
      emit_br_if(buf, 1)
      let nl2 = ce(buf, body, local_names, nl1, 0)
      emit_drop(buf)
      emit_br(buf, 0)
      emit_end(buf)
      emit_end(buf)
      emit_i64_const(buf, 0)
      nl2
    },
    EBreak(_) => {
      emit_br(buf, ld + 1)
      emit_i64_const(buf, 0)
      next_local
    },
    EContinue(_) => {
      emit_br(buf, ld)
      emit_i64_const(buf, 0)
      next_local
    },
    EUnit => {
      emit_i64_const(buf, 0)
      next_local
    },
    EReturn(ret_expr) => {
      let nl = ce(buf, ret_expr, local_names, next_local, ld)
      emit_return(buf)
      nl
    },
    EFn(_, _, params, _, _, fn_body) =>
    compile_lambda_gc(buf, params, fn_body, local_names, next_local, ctx, ld, compile_expr_gc),
    EDot(obj, field, _, _) => {
      // #538: numeric field = tuple index (`t.0`). gc tuples are raw untagged
      // pointers with elements at i*8 (no header) -- see ETuple above.
      let fc0 = String::char_code_at(field, 0)
      if fc0 >= 48 && fc0 <= 57 {
        let mut tidx = 0
        let mut tp = 0
        while tp < String::length(field) {
          tidx = tidx * 10 + (String::char_code_at(field, tp) - 48)
          tp = tp + 1
        }
        let nl_t = ce(buf, obj, local_names, next_local, ld)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, tidx * 8)
        return nl_t
      }
      // #1702: a native wasm-gc struct local. Its exact struct was fixed at the
      // binding site, so the field index is static -- and the tag dispatch below
      // is not merely unnecessary but impossible: the value carries no tag.
      let ns_slot = match obj {
        EIdent(ns_obj, _) => find_local_slot(local_names, ns_obj),
        _ => 0 - 1
      }
      let ns_struct_idx = gc_slot_map_get(ctx.gc_native_struct_scope, ns_slot)
      if ns_struct_idx >= 0 {
        let ns_declared = Array::get(ctx.gc_ctor_table.struct_field_names, ns_struct_idx)
        let mut ns_fidx = 0 - 1
        let mut ns_i = 0
        while ns_i < Array::length(ns_declared) {
          if ns_fidx < 0 && Array::get(ns_declared, ns_i) == field {
            ns_fidx = ns_i
          } else {
            ()
          }
          ns_i = ns_i + 1
        }
        if ns_fidx < 0 {
          // The gate admits only field reads on this binding, so a name that is
          // not one of the struct's own fields means gate and lowering disagree
          // -- fail loudly rather than read some other slot.
          throw("gc native struct: field is not declared on the bound struct")
        } else {
          ()
        }
        emit_local_get(buf, ns_slot)
        emit_struct_get(buf, ctx.gc_native_struct_type_base + ns_struct_idx, ns_fidx)
        return next_local
      } else {
        ()
      }
      // #722: same struct-tag dispatch as the linear EDot path
      // (compile_expr_tail4.vibe) — static load when every declaring struct
      // agrees on the slot, runtime dispatch on the value's ctor tag when
      // they disagree, first candidate as the untagged/legacy fallback.
      let cands = struct_field_candidates(ctx.gc_ctor_table, field)
      if Array::length(cands) == 0 {
        throw(String::concat("unknown struct field: ", field))
      }
      let (_, idx0) = Array::get(cands, 0)
      let dispatch = struct_field_dispatch_cases(cands)
      let nl1 = ce(buf, obj, local_names, next_local, ld)
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      if Array::length(dispatch) == 0 {
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, 8 + idx0 * 8)
        nl1
      } else {
        let obj_l = nl1
        Array::push(local_names, "[gc-temp]__dot_obj")
        emit_local_set(buf, obj_l)
        let mut di = 0
        while di < Array::length(dispatch) {
          let (dtag, didx) = Array::get(dispatch, di)
          emit_local_get(buf, obj_l)
          emit_i32_wrap_i64(buf)
          emit_i32_load(buf, 2, 0)
          emit_i32_const(buf, dtag)
          emit_i32_eq(buf)
          emit_if_i64(buf)
          emit_local_get(buf, obj_l)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, 8 + didx * 8)
          emit_else(buf)
          di = di + 1
        }
        emit_local_get(buf, obj_l)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, 8 + idx0 * 8)
        let mut de = 0
        while de < Array::length(dispatch) {
          emit_end(buf)
          de = de + 1
        }
        nl1 + 1
      }
    },
    ERecord(rec_rn, fields, _) => {
      let flen = Array::length(fields)
      // #722: resolve to a struct by exact field-name set; on a match, lay
      // out in DECLARED field order and stamp the struct's ctor tag at
      // value+0 (mirrors the linear backend and the `S::{...}` ctor path) so
      // the tag-dispatching field access above stays type-correct.
      // #1839: an explicit anonymous literal (rec_rn == "") is exempt — it
      // always keeps literal order + tag 0 (mirrors the linear backend's
      // rule; see compile_expr_tail4).
      let lit_names = array_empty()
      let mut lni = 0
      while lni < flen {
        let (lfn, _) = Array::get(fields, lni)
        Array::push(lit_names, lfn)
        lni = lni + 1
      }
      let rec_si = if rec_rn == "" {
        -1
      } else {
        struct_index_by_field_set(ctx.gc_ctor_table, lit_names)
      }
      let rec_tag = if rec_si >= 0 {
        struct_tag_by_index(ctx.gc_ctor_table, rec_si)
      } else {
        0
      }
      let rec_fields = if rec_si >= 0 {
        let def_fnames = Array::get(ctx.gc_ctor_table.struct_field_names, rec_si)
        let ordered = array_empty()
        let mut oi = 0
        while oi < Array::length(def_fnames) {
          let target_name = Array::get(def_fnames, oi)
          let mut ri2 = 0
          while ri2 < flen {
            let (rfn, rfv) = Array::get(fields, ri2)
            if rfn == target_name {
              Array::push(ordered, (rfn, rfv))
              ri2 = flen
            } else {
              ri2 = ri2 + 1
            }
          }
          oi = oi + 1
        }
        ordered
      } else {
        fields
      }
      let obj_size = 8 + flen * 8
      let ptr_local = next_local
      Array::push(local_names, "[gc-temp]__rec_ptr")
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, ptr_local)
      emit_global_get(buf, 0)
      emit_i32_const(buf, obj_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      // #415: gc-lane heap bump must grow linear memory like the linear
      // backend does -- without this any allocation past the initial page
      // traps OOB (the gc smoke fixture only ever allocated a few bytes).
      emit_heap_memory_grow_check(buf)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, rec_tag)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, flen)
      emit_i32_store(buf, 2, 4)
      let mut nl_r = next_local + 1
      let mut ri = 0
      while ri < flen {
        let (_, fexpr) = Array::get(rec_fields, ri)
        nl_r = ce(buf, fexpr, local_names, nl_r, ld)
        let val_local = nl_r
        Array::push(local_names, "[gc-temp]__rec_val")
        emit_local_set(buf, val_local)
        nl_r = nl_r + 1
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, val_local)
        emit_i64_store(buf, 3, 8 + ri * 8)
        ri = ri + 1
      }
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
      nl_r
    },
    EHandle(body, harms) => {
      // #538: Exception handler via try_table -- abortive, so the continuation
      // below the handler is gone and only a never-resuming Throw fits here.
      //
      // This is NOT "algebraic effects are linear-backend only". The effect
      // lowering runs BEFORE codegen and is shared: backend_body.vibe calls
      // inline_direct_performs then evidence_dict_pass on the same statements
      // both backends compile, and a migration failure is reported by
      // evidence_dict_pass (edp_errs), not here. A tail-resumptive or
      // suspend-CPS handler is therefore already gone by the time this arm
      // runs -- measured: every case in bench/tracing/trace_effect_shapes_test
      // (perform in a while loop, four call levels down, inside an annotated
      // closure literal, a stateful handler building a span tree, and a
      // handler that stores `resume` as a value) passes under
      // VIBE_TEST_BACKEND=gc.
      //
      // The previous wording here ("algebraic user effects still need the
      // linear backend's memo machinery") named the replay/memo engine that
      // ADR-0076 追記34 V2 physically deleted, and it is where the mistaken
      // belief that wasm-gc cannot run user effects came from.
      //   block (result i64)            ;; B_outer: success value
      //     block (result i64)          ;; B_catch: thrown payload
      //       try_table (result i64) [catch tag0 -> label 0]
      //         <body>
      //       end
      //       br 1                       ;; success
      //     end
      //     <bind Throw(msg); handler>   ;; payload -> handler value
      //   end
      if Array::length(harms) == 0 {
        ce(buf, body, local_names, next_local, ld)
      } else {
        let (hpat, hexpr) = Array::get(harms, 0)
        let mut hpat_ok = false
        match hpat {
          PCtor(hname, _) => {
            if is_exception_throw_handler_name(hname) {
              hpat_ok = true
            }
          },
          _ => ()
        }
        if !hpat_ok {
          throw("GC codegen: only `with Exception` abortive Throw handlers are supported (the `Error` alias included; algebraic effect handlers need the linear backend)")
        }
        emit_block_i64(buf)
        emit_block_i64(buf)
        bytebuf_push(buf, 31)
        bytebuf_push(buf, 126)
        leb128_encode_u32(buf, 1)
        bytebuf_push(buf, 0)
        leb128_encode_u32(buf, 0)
        leb128_encode_u32(buf, 0)
        let body_ld = if ld >= 0 {
          ld + 3
        } else {
          -1
        }
        let nl_b = ce(buf, body, local_names, next_local, body_ld)
        emit_end(buf)
        emit_br(buf, 1)
        emit_end(buf)
        // payload (i64) on stack: bind the Throw arg if the pattern names it.
        let names_before_h = Array::length(local_names)
        let mut nl_h = nl_b
        match hpat {
          PCtor(_, hargs) => {
            if Array::length(hargs) > 0 {
              match Array::get(hargs, 0) {
                PBind(hbname) => {
                  let hb_l = Array::length(local_names)
                  emit_local_set(buf, hb_l)
                  Array::push(local_names, hbname)
                  if hb_l + 1 > nl_h {
                    nl_h = hb_l + 1
                  }
                },
                _ => emit_drop(buf)
              }
            } else {
              emit_drop(buf)
            }
          },
          _ => emit_drop(buf)
        }
        let harm_ld = if ld >= 0 {
          ld + 1
        } else {
          -1
        }
        let nl_h2 = ce(buf, hexpr, local_names, Array::length(local_names), harm_ld)
        emit_end(buf)
        Array::truncate(local_names, names_before_h)
        agg_log_reset_above(ctx.gc_agg_local_slots, names_before_h)
        gc_slot_log_reset_above(ctx.gc_bool_locals, names_before_h)
        gc_slot_log_reset_above(ctx.gc_int_locals, names_before_h)
        gc_slot_log_reset_above(ctx.gc_float_locals, names_before_h)
        if nl_h2 > nl_h {
          nl_h = nl_h2
        }
        // #2356: the handler arm is a sibling control-flow path, but its
        // locals still contribute to the function frame high-water mark.
        // Keep local_names aligned with that returned mark after dropping the
        // arm scope. Otherwise the next binding records its source name at
        // the first unpadded slot while emitting local.set at nl_h. Later
        // lookups then read the never-executed catch-arm local instead of the
        // successful handle result (observed as a corrupted Array on wasm-gc).
        while Array::length(local_names) < nl_h {
          Array::push(local_names, "")
        }
        nl_h
      }
    },
    ELabeledArg(_, _, lval) => ce(buf, lval, local_names, next_local, ld),
    EMap(mfields) => {
      // #538: map literal -> the gc Map block layout used by MapBuilder/Map::*
      // ([count@0][cap@4][key@8+i*16][val@16+i*16]); keys are string literals.
      let mflen = Array::length(mfields)
      let mcap = if mflen > 32 {
        mflen
      } else {
        32
      }
      let malloc_size = 8 + mcap * 16
      let mptr = next_local
      Array::push(local_names, "[gc-temp]__maplit_ptr")
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, mptr)
      emit_global_get(buf, 0)
      emit_i32_const(buf, malloc_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_memory_grow_check(buf)
      emit_local_get(buf, mptr)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, mflen)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, mptr)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, mcap)
      emit_i32_store(buf, 2, 4)
      let mut mnl = next_local + 1
      let mut mi = 0
      while mi < mflen {
        let (mkey, mval) = Array::get(mfields, mi)
        let mk_idx = str_table_lookup(ctx.str_table.strs, mkey)
        emit_local_get(buf, mptr)
        emit_i32_wrap_i64(buf)
        emit_str_ref(buf, Array::get(ctx.str_table.offsets, mk_idx), Array::get(ctx.str_table.lengths, mk_idx))
        emit_i64_store(buf, 3, 8 + mi * 16)
        emit_local_get(buf, mptr)
        emit_i32_wrap_i64(buf)
        mnl = ce(buf, mval, local_names, mnl, ld)
        emit_i64_store(buf, 3, 16 + mi * 16)
        mi = mi + 1
      }
      emit_local_get(buf, mptr)
      mnl
    },
    EStringInterp(_) => throw("GC codegen: EStringInterp must be resolved before codegen (call resolve_interp_stmts first)"),
    _ => throw(String::concat("unsupported expression in gc codegen: tag ", __to_string(expr_tag(expr))))
  }
}

//# Misc

export {
  compile_expr_gc, gc_native_array_escape_gate
}
