//# Imports

import ../common_base {
  CompileCtxGc
}

//# Functions

fn make_lambda_ctx_gc(ctx: CompileCtxGc, ref_cell_names: Array[String], ref_local_indices: Array[Int]) -> CompileCtxGc {
  CompileCtxGc::{
    func_table: ctx.func_table, str_table: ctx.str_table,
    lambda_table: ctx.lambda_table,
    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,
    ref_cell_names: ref_cell_names, ref_local_indices: ref_local_indices,
    refcell_type_idx: ctx.refcell_type_idx, closure_type_base: ctx.closure_type_base,
    gc_ctor_table: ctx.gc_ctor_table,
    gc_const_names: ctx.gc_const_names, gc_const_kinds: ctx.gc_const_kinds,
    gc_const_ivals: ctx.gc_const_ivals, gc_const_svals: ctx.gc_const_svals,
    gc_global_names: ctx.gc_global_names,
    // Fresh per lambda: float tracking is scope-local (captured floats are
    // not tracked — best-effort, same as annotated Double params).
    gc_float_locals: Array::slice([
      ""
    ], 0, 0),
    gc_agg_local_slots: Array::slice([
      0
    ], 0, 0),
    gc_agg_ret_names: ctx.gc_agg_ret_names,
    gc_agg_ret_infos: ctx.gc_agg_ret_infos
  }
}

//# Misc

export {
  make_lambda_ctx_gc
}
