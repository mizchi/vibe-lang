//# Imports

import @vibe/compiler/codegen/common_base {
  CompileCtxGc
}

import @vibe/core {
  array_empty
}

//# Functions

fn make_lambda_ctx_gc(ctx: CompileCtxGc, ref_cell_names: Array[String], ref_local_indices: Array[Int]) -> CompileCtxGc {
  CompileCtxGc::{
    func_table: ctx.func_table,
    str_table: ctx.str_table,
    lambda_table: ctx.lambda_table,
    num_user_funcs: ctx.num_user_funcs,
    func_offset: ctx.func_offset,
    ref_cell_names: ref_cell_names,
    ref_local_indices: ref_local_indices,
    refcell_type_idx: ctx.refcell_type_idx,
    closure_type_base: ctx.closure_type_base,
    gc_ctor_table: ctx.gc_ctor_table,
    gc_const_names: ctx.gc_const_names,
    gc_const_kinds: ctx.gc_const_kinds,
    gc_const_ivals: ctx.gc_const_ivals,
    gc_const_svals: ctx.gc_const_svals,
    gc_global_names: ctx.gc_global_names,
    // Fresh per lambda: float/bool tracking is scope-local (captured
    // floats/bools are not tracked — best-effort, same as annotated
    // Double/Bool params, seeded separately after this call returns).
    gc_float_locals: array_empty(),
    gc_float_ret_fns: ctx.gc_float_ret_fns,
    gc_float_call_offsets: ctx.gc_float_call_offsets,
    gc_int_render_offsets: ctx.gc_int_render_offsets,
    gc_bool_locals: array_empty(),
    gc_int_locals: array_empty(),
    gc_to_string_int_func_idx: ctx.gc_to_string_int_func_idx,
    // #1332: lambda records now DO carry typed-local metadata into the module
    // body declaration pass (gc_lambda_native_array_locals, appended by
    // record_lambda_meta_gc), so the native path is live here.
    //
    // Both tracking rows are FRESH per lambda -- a lambda body compiles into
    // its own local frame, so the enclosing function's slot numbers mean
    // nothing here. Only the module-level row array below is shared.
    //
    // Escapes across the universal i64 closure ABI stay excluded by
    // gc_native_array_body_is_safe, unchanged: it already returns false for
    // `EFn`, so an array a DEEPER lambda captures is never eligible, and the
    // recursive EIdent check still rejects returning the reference itself.
    gc_native_array_locals: array_empty(),
    gc_native_array_local_types: array_empty(),
    gc_native_array_type_idx: ctx.gc_native_array_type_idx,
    gc_native_array_block_type_idx: ctx.gc_native_array_block_type_idx,
    // #1702: the native STRUCT lane is not entered inside a lambda. A lambda
    // compiles into its own frame whose declaration row comes from
    // gc_lambda_native_array_locals, and there is no struct equivalent yet, so
    // a record literal in a lambda body keeps the linear fallback.
    gc_native_struct_scope: array_empty(),
    gc_native_struct_decl: array_empty(),
    gc_native_struct_type_base: 0 - 1,
    // A lambda compiles into its OWN frame and its row is emitted from
    // gc_lambda_native_array_locals, so eligibility does not inherit from the
    // enclosing body -- a lambda created inside a module initializer is still
    // a perfectly ordinary lambda frame.
    gc_native_array_frame_ok: true,
    // Shared BY REFERENCE (see the field's doc comment): a nested lambda
    // records itself during this lambda's own compile, and both rows must
    // land in the one module-level array to stay parallel to
    // LambdaTable.bodies.
    gc_lambda_native_array_locals: ctx.gc_lambda_native_array_locals,
    // Direct calls made inside a lambda may use a proven callee signature,
    // but the lambda's own closure ABI remains tagged-i64 in #1541.
    gc_direct_abi_names: ctx.gc_direct_abi_names,
    gc_direct_abi_param_refs: ctx.gc_direct_abi_param_refs,
    gc_direct_abi_return_refs: ctx.gc_direct_abi_return_refs,
    gc_direct_abi_current_return_ref: false,
    // #1015: computed once per compile, never per-scope -- pass through
    // unchanged (see the doc comment on CompileCtxGc.gc_to_string_is_show_wrapper).
    gc_to_string_is_show_wrapper: ctx.gc_to_string_is_show_wrapper,
    gc_agg_local_slots: array_empty(),
    gc_agg_ret_names: ctx.gc_agg_ret_names,
    gc_agg_ret_infos: ctx.gc_agg_ret_infos,
    // #1109 gc parity: shared BY REFERENCE like the linear lane's
    // compile_lambda.vibe (table_slots_used: ctx.table_slots_used) -- nested
    // lambda recordings must land in the module-level array, not a fresh one.
    table_slots_used: ctx.table_slots_used,
    // ADR-0090 (#1262): module-level layout, so it rides into every nested
    // lambda unchanged -- a `region` inside a closure must reach the same
    // arena as one at statement level.
    gc_region_ptr_addr: ctx.gc_region_ptr_addr,
    gc_region_arr_new_func_idx: ctx.gc_region_arr_new_func_idx,
    gc_region_bytes_new_func_idx: ctx.gc_region_bytes_new_func_idx,
    gc_region_exn_tag: ctx.gc_region_exn_tag
  }
}

//# Misc

export {
  make_lambda_ctx_gc
}
