//# Imports

import @vibe/compiler/codegen/common_base {
  CompileCtxGc
}

import @vibe/core {
  array_empty
}

//# Functions

fn make_lambda_ctx_gc(ctx: CompileCtxGc, ref_cell_names: Array[String], ref_local_indices: Array[Int]) -> CompileCtxGc {
  CompileCtxGc::{
    func_table: ctx.func_table, str_table: ctx.str_table,
    lambda_table: ctx.lambda_table,
    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,
    ref_cell_names: ref_cell_names, ref_local_indices: ref_local_indices,
    refcell_type_idx: ctx.refcell_type_idx, closure_type_base: ctx.closure_type_base,
    gc_ctor_table: ctx.gc_ctor_table,
    gc_const_names: ctx.gc_const_names, gc_const_kinds: ctx.gc_const_kinds,
    gc_const_ivals: ctx.gc_const_ivals, gc_const_svals: ctx.gc_const_svals,
    gc_global_names: ctx.gc_global_names,
    // Fresh per lambda: float/bool tracking is scope-local (captured
    // floats/bools are not tracked — best-effort, same as annotated
    // Double/Bool params, seeded separately after this call returns).
    gc_float_locals: array_empty(),
    gc_bool_locals: array_empty(),
    // #1332: lambda records now DO carry typed-local metadata into the module
    // body declaration pass (gc_lambda_native_array_locals, appended by
    // record_lambda_meta_gc), so the native path is live here.
    //
    // Both tracking rows are FRESH per lambda -- a lambda body compiles into
    // its own local frame, so the enclosing function's slot numbers mean
    // nothing here. Only the module-level row array below is shared.
    //
    // Escapes across the universal i64 closure ABI stay excluded by
    // gc_native_array_body_is_safe, unchanged: it already returns false for
    // `EFn`, so an array a DEEPER lambda captures is never eligible, and the
    // recursive EIdent check still rejects returning the reference itself.
    gc_native_array_locals: array_empty(),
    gc_native_array_local_types: array_empty(),
    gc_native_array_type_idx: ctx.gc_native_array_type_idx,
    // Shared BY REFERENCE (see the field's doc comment): a nested lambda
    // records itself during this lambda's own compile, and both rows must
    // land in the one module-level array to stay parallel to
    // LambdaTable.bodies.
    gc_lambda_native_array_locals: ctx.gc_lambda_native_array_locals,
    // #1015: computed once per compile, never per-scope -- pass through
    // unchanged (see the doc comment on CompileCtxGc.gc_to_string_is_show_wrapper).
    gc_to_string_is_show_wrapper: ctx.gc_to_string_is_show_wrapper,
    gc_agg_local_slots: array_empty(),
    gc_agg_ret_names: ctx.gc_agg_ret_names,
    gc_agg_ret_infos: ctx.gc_agg_ret_infos,
    // #1109 gc parity: shared BY REFERENCE like the linear lane's
    // compile_lambda.vibe (table_slots_used: ctx.table_slots_used) -- nested
    // lambda recordings must land in the module-level array, not a fresh one.
    table_slots_used: ctx.table_slots_used
  }
}

//# Misc

export {
  make_lambda_ctx_gc
}
