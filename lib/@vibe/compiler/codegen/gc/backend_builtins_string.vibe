//# Functions

export fn gc_gen_str_eq_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_ne(b)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_else(b)
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_local_get(b, 1)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_i32_const(b, 0)
  emit_local_set(b, 6)
  emit_block_i64(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 6)
  emit_local_get(b, 2)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 4)
  emit_local_get(b, 6)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_local_get(b, 5)
  emit_local_get(b, 6)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i32_ne(b)
  emit_if_void(b)
  emit_i64_const(b, 0)
  emit_br(b, 3)
  emit_end(b)
  emit_local_get(b, 6)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 6)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_i64_const(b, 1)
  emit_end(b)
  emit_end(b)
  b
}

export fn gc_gen_str_len_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  b
}

export fn gc_gen_str_concat_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_local_get(b, 1)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_local_set(b, 7)
  emit_global_get(b, 0)
  emit_local_tee(b, 6)
  emit_local_get(b, 7)
  emit_i32_add(b)
  emit_i32_const(b, 7)
  emit_i32_add(b)
  emit_i32_const(b, -8)
  bytebuf_push(b, 113)
  emit_global_set(b, 0)
  // #415: gc-lane heap bump must grow linear memory like the linear
  // backend does -- without this any allocation past the initial page
  // traps OOB (the gc smoke fixture only ever allocated a few bytes).
  emit_heap_memory_grow_check(b)
  emit_local_get(b, 6)
  emit_local_get(b, 4)
  emit_local_get(b, 2)
  emit_memory_copy(b)
  emit_local_get(b, 6)
  emit_local_get(b, 2)
  emit_i32_add(b)
  emit_local_get(b, 5)
  emit_local_get(b, 3)
  emit_memory_copy(b)
  emit_local_get(b, 6)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 7)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  b
}
