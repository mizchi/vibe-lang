//# Functions

/// Unit entry values have no observable result. Keep this in sync with the
/// linear WASI entry policy so `fn main {}` does not print its tagged zero.
/// #2404: a labeled (`x~`) or optional (`x?`) parameter is parsed with the
/// marker ON THE NAME (parser_base.vibe's parse_one_param_with_binder_context),
/// while the body refers to plain `x`. Every place that binds parameters to
/// slots has to be told the name the body uses.
///
/// A local copy of the linear lane's `strip_param_label_marker`
/// (codegen/expr/compile_lambda.vibe), copied rather than imported for the
/// reason that function's doc comment records.
export fn gb_strip_param_label_marker(n: String) -> String {
  let ln = String::length(n)
  if ln > 0 {
    let c = String::char_code_at(n, ln - 1)
    if c == '~' || c == '?' {
      n[0: ln - 1]
    } else {
      n
    }
  } else {
    n
  }
}

export fn gc_type_expr_is_unit(t: TypeExpr) -> Bool {
  match t {
    TyUnit => true,
    TyName(name) => name == "Unit",
    _ => false
  }
}

/// #1541 uses the single element representation already implemented by
/// `$native_i64_array`, whose cells are `(mut i64)` holding ordinary tagged
/// values -- exactly the bytes linear memory would hold for the same element.
/// The element TYPE therefore does not change the representation, and the
/// allowlist below is about what can be RECOGNIZED, not about what fits.
///
/// It stays an allowlist because `strip_generic_type_params` erases binders:
/// after it runs, the type variable in `fn f[T](xs: Array[T])` is spelled
/// `TyName("T")`, indistinguishable from a concrete type of that name. Erased
/// element names must not enter the lane, so only spellings that cannot be a
/// type variable are admitted -- the builtin scalars, which shadowing would
/// have to break first.
///
/// Nested arrays stay out for a different reason: an `Array[Array[Int]]` cell
/// would have to hold a reference, and there is no way to put one in an i64
/// cell without losing it. That is the root constraint, not a conservatism.
export fn gc_direct_abi_is_native_array_type(t: TypeExpr) -> Bool {
  match t {
    TyApp(name, args) => name == "Array" && Array::length(args) == 1 && (match Array::get(args, 0) {
      TyName(elem) => gc_direct_abi_is_tagged_scalar_element(elem),
      _ => false
    }),
    _ => false
  }
}

fn gc_direct_abi_is_tagged_scalar_element(elem: String) -> Bool {
  elem == "Int" || elem == "String" || elem == "Bool"
}

export fn gc_direct_abi_type_mentions_array(t: TypeExpr) -> Bool {
  match t {
    TyApp(name, args) => {
      let mut found = name == "Array"
      let mut i = 0
      while i < Array::length(args) {
        if gc_direct_abi_type_mentions_array(Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyFn(params, ret, _) => {
      let mut found = gc_direct_abi_type_mentions_array(ret)
      let mut i = 0
      while i < Array::length(params) {
        if gc_direct_abi_type_mentions_array(Array::get(params, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    _ => false
  }
}

fn gc_direct_abi_name_index(names: Array[String], name: String) -> Int {
  let exact = gc_direct_abi_name_index_exact(names, name)
  if exact >= 0 {
    exact
  } else {
    gc_direct_abi_name_index_exact(names, String::concat(name, "$ref"))
  }
}

export fn gc_direct_abi_name_index_exact(names: Array[String], name: String) -> Int {
  let mut i = 0
  let mut found = -1
  while i < Array::length(names) {
    if found < 0 && Array::get(names, i) == name {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

export fn gc_direct_abi_name_in(names: Array[String], name: String) -> Bool {
  gc_direct_abi_name_index(names, name) >= 0
}

/// Static mirror of backend_call.vibe's `gc_expr_is_lane_proven_ref`: a value
/// that ALREADY inhabits the reference lane, rather than one whose
/// representation its consumer still gets to pick. Keep the two shapes in sync
/// -- this one decides whether the component is accepted, that one decides what
/// gets emitted, and a disagreement is a validation failure at best.
fn gc_direct_abi_join_arm_is_lane_proven(expr: Expr, native_names: Array[String], abi_names: Array[String], abi_return_refs: Array[Bool]) -> Bool {
  match expr {
    EIdent(name, _) => gc_direct_abi_name_in(native_names, name),
    ECall(EIdent(fname, _), _, _) => {
      let idx = gc_direct_abi_name_index(abi_names, fname)
      idx >= 0 && Array::get(abi_return_refs, idx)
    },
    EIf(_, then_e, else_e) => gc_direct_abi_join_arm_is_lane_proven(then_e, native_names, abi_names, abi_return_refs) && gc_direct_abi_join_arm_is_lane_proven(else_e, native_names, abi_names, abi_return_refs),
    _ => false
  }
}

/// Static representation proof used before emitting any typed function type.
/// Result: -1 = unsupported crossing, 0 = tagged i64, 1 = native array ref.
/// Once a module has a candidate reference signature, an array literal bound
/// by `let` is analyzed in that same lane. Any unsupported use rejects the
/// complete module evidence table; codegen then retries the whole component
/// through its pre-existing tagged-i64 ABI. There is no mixed partial island.
export fn gc_direct_abi_expr_kind(expr: Expr, native_names: Array[String], abi_names: Array[String], abi_param_refs: Array[Array[Bool]], abi_return_refs: Array[Bool], return_ref: Bool) -> Int {
  match expr {
    EIdent(name, _) => if gc_direct_abi_name_in(native_names, name) {
      1
    } else if gc_direct_abi_name_in(abi_names, name) {
      // A typed function used as a value would enter the universal closure
      // table. #1541 has no typed call_indirect lane, so reject the module.
      -1
    } else {
      0
    },
    EArray(elems) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(elems) {
        if gc_direct_abi_expr_kind(Array::get(elems, i), native_names, abi_names, abi_param_refs, abi_return_refs, return_ref) != 0 {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      if ok {
        1
      } else {
        -1
      }
    },
    // A `let` enters the reference lane only if lowering will actually put it
    // there, which is `gc_native_array_escape_gate`'s decision -- the same
    // predicate compile_expr_gc consults at the binding site. Accepting a
    // reference here that lowering then declines to create is not a missed
    // optimization: the call site would demand a reference the local does not
    // have, and codegen aborts on its own proof mismatch. Disagreeing was a
    // real defect -- `let xs = [1, 2]` captured by any lambda and also passed
    // to a direct Array[Int] callee failed to compile at all.
    ELet(name, value, body, _) => {
      let binding_is_native = gc_native_array_escape_gate(body, name, return_ref, abi_names, abi_param_refs)
      match value {
        EArray(_) => if binding_is_native {
          let floor = Array::length(native_names)
          Array::push(native_names, name)
          let native_body = gc_direct_abi_expr_kind(body, native_names, abi_names, abi_param_refs, abi_return_refs, return_ref)
          Array::truncate(native_names, floor)
          native_body
        } else {
          gc_direct_abi_expr_kind(body, native_names, abi_names, abi_param_refs, abi_return_refs, return_ref)
        },
        _ => {
          let value_kind = gc_direct_abi_expr_kind(value, native_names, abi_names, abi_param_refs, abi_return_refs, return_ref)
          if value_kind < 0 {
            -1
          } else if value_kind == 1 && binding_is_native {
            let floor = Array::length(native_names)
            Array::push(native_names, name)
            let body_kind = gc_direct_abi_expr_kind(body, native_names, abi_names, abi_param_refs, abi_return_refs, return_ref)
            Array::truncate(native_names, floor)
            body_kind
          } else if value_kind == 1 {
            // The value IS a reference but the binding cannot hold one, so
            // there is nowhere for it to go. Fail the component closed.
            -1
          } else {
            gc_direct_abi_expr_kind(body, native_names, abi_names, abi_param_refs, abi_return_refs, return_ref)
          }
        }
      }
    },
    ECall(callee, args, _) => match callee {
      EIdent(fname, _) => {
        let abi_idx = gc_direct_abi_name_index(abi_names, fname)
        if abi_idx >= 0 {
          let refs = Array::get(abi_param_refs, abi_idx)
          if Array::length(refs) != Array::length(args) {
            -1
          } else {
            let mut ok = true
            let mut i = 0
            while i < Array::length(args) {
              let kind = gc_direct_abi_expr_kind(Array::get(args, i), native_names, abi_names, abi_param_refs, abi_return_refs, return_ref)
              if kind < 0 || (Array::get(refs, i) && kind != 1) || (!Array::get(refs, i) && kind != 0) {
                ok = false
              } else {
                ()
              }
              i = i + 1
            }
            if ok {
              if Array::get(abi_return_refs, abi_idx) {
                1
              } else {
                0
              }
            } else {
              -1
            }
          }
        } else {
          let native_array_op = (fname == "Array::length" && Array::length(args) == 1) || (fname == "Array::get" && Array::length(args) == 2) || (fname == "Array::set" && Array::length(args) == 3)
          let mut saw_native = false
          let mut ok = true
          let mut i = 0
          while i < Array::length(args) {
            let kind = gc_direct_abi_expr_kind(Array::get(args, i), native_names, abi_names, abi_param_refs, abi_return_refs, return_ref)
            if kind < 0 {
              ok = false
            } else if kind == 1 {
              if i == 0 && native_array_op {
                saw_native = true
              } else {
                ok = false
              }
            } else {
              ()
            }
            i = i + 1
          }
          if ok {
            // Native Array length/get/set all produce an i64/Unit result.
            let _ = saw_native
            0
          } else {
            -1
          }
        }
      },
      _ => {
        let callee_kind = gc_direct_abi_expr_kind(callee, native_names, abi_names, abi_param_refs, abi_return_refs, return_ref)
        let mut ok = callee_kind == 0
        let mut i = 0
        while i < Array::length(args) {
          if gc_direct_abi_expr_kind(Array::get(args, i), native_names, abi_names, abi_param_refs, abi_return_refs, return_ref) != 0 {
            ok = false
          } else {
            ()
          }
          i = i + 1
        }
        if ok {
          0
        } else {
          -1
        }
      }
    },
    // Control-flow join. The condition itself must stay on the tagged-i64
    // lane, and both arms must agree: a join of a reference with an i64 would
    // give one program point two representations. Agreeing arms carry their
    // common kind outward, so a plain i64 `if` is unaffected.
    //
    // A reference join additionally requires both arms to be ALREADY in the
    // reference lane (`gc_direct_abi_join_arm_is_lane_proven`). A bare array
    // literal has kind 1 but no representation of its own yet -- the consumer
    // picks one, and an `if` in an arbitrary position has no consumer proof to
    // lean on. Joining literals therefore still clears the component, which is
    // what fixtures/gc_direct_array_join_fallback_test.vibe pins.
    EIf(cond, then_e, else_e) => {
      let cond_kind = gc_direct_abi_expr_kind(cond, native_names, abi_names, abi_param_refs, abi_return_refs, return_ref)
      let then_kind = gc_direct_abi_expr_kind(then_e, native_names, abi_names, abi_param_refs, abi_return_refs, return_ref)
      let else_kind = gc_direct_abi_expr_kind(else_e, native_names, abi_names, abi_param_refs, abi_return_refs, return_ref)
      if cond_kind != 0 || then_kind < 0 || else_kind < 0 || then_kind != else_kind {
        -1
      } else if then_kind == 1 && !(gc_direct_abi_join_arm_is_lane_proven(then_e, native_names, abi_names, abi_return_refs) && gc_direct_abi_join_arm_is_lane_proven(else_e, native_names, abi_names, abi_return_refs)) {
        -1
      } else {
        then_kind
      }
    },
    EReturn(value) => gc_direct_abi_expr_kind(value, native_names, abi_names, abi_param_refs, abi_return_refs, return_ref),
    // #1541: a sequence's VALUE is its tail. Falling through to the catch-all
    // below was wrong here -- that clause requires EVERY child to be kind 0,
    // which is right for an operand list but rejects `Array::set(xs, 0, 9); xs`
    // because the tail legitimately yields the reference. That shape is exactly
    // a mutating transform, i.e. the case where passing a reference instead of a
    // copy is what makes the call mean anything, so the lane was declining the
    // work it exists to do and taking the whole component down with it.
    //
    // The leading statement still has to be reference-free: a discarded
    // reference would be a crossing nobody proved.
    ESeq(first, second) => if gc_direct_abi_expr_kind(first, native_names, abi_names, abi_param_refs, abi_return_refs, return_ref) != 0 {
      -1
    } else {
      gc_direct_abi_expr_kind(second, native_names, abi_names, abi_param_refs, abi_return_refs, return_ref)
    },
    _ => {
      let children = expr_children(expr)
      let mut ok = true
      let mut i = 0
      while i < Array::length(children) {
        if gc_direct_abi_expr_kind(Array::get(children, i), native_names, abi_names, abi_param_refs, abi_return_refs, return_ref) != 0 {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      if ok {
        0
      } else {
        -1
      }
    }
  }
}

/// #1541: does this expression's VALUE come straight from an array literal?
///
/// A bare literal is kind 1 but has not chosen its own representation -- the
/// consumer does. As a call argument that is fine: the callee's proven ref
/// parameter decides. As a ref RESULT nothing decides, and the lowering builds
/// an ordinary linear array, so accepting it produced a function whose type says
/// `(result (ref null $array))` while its body returns i64 -- wasm that fails
/// validation rather than a clean fallback.
export fn gc_direct_abi_tail_is_bare_array(expr: Expr) -> Bool {
  match expr {
    EArray(_) => true,
    ESeq(_, second) => gc_direct_abi_tail_is_bare_array(second),
    ELet(_, _, body, _) => gc_direct_abi_tail_is_bare_array(body),
    ELetMut(_, _, body, _) => gc_direct_abi_tail_is_bare_array(body),
    EIf(_, then_e, else_e) => gc_direct_abi_tail_is_bare_array(then_e) || gc_direct_abi_tail_is_bare_array(else_e),
    _ => false
  }
}

fn gc_name_is_called(expr: Expr, name: String) -> Bool {
  let direct = match expr {
    ECall(EIdent(callee, _), _, _) => callee == name,
    _ => false
  }
  if direct {
    true
  } else {
    let children = expr_children(expr)
    let mut i = 0
    let mut found = false
    while i < Array::length(children) {
      if gc_name_is_called(Array::get(children, i), name) {
        found = true
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

/// #2405 follow-up: `gc_emit_int_to_string` as a standalone function body, so
/// a statically-int call site can CALL the renderer instead of inlining ~182
/// bytes of it. Same slots the runtime-dispatching `__to_string` body uses
/// (param 0 = value, locals 1..5), minus the string heuristic -- which is the
/// whole point.
///
/// Defined HERE rather than beside the emitter it wraps in
/// backend_builtins_numeric.vibe: a brand-new cross-file export and its first
/// cross-file caller in the same change do not survive the merge/flatten
/// (`generate_bundle: unknown name: gc_gen_to_string_int_body`), the gotcha
/// `edp_strip_tilde` in codegen/common_base/inline_direct_perform.vibe
/// records. `gc_emit_int_to_string` itself already has a caller, so calling it
/// from a second file is fine.
export fn gc_gen_to_string_int_body() -> Bytes {
  let b = bytebuf_new()
  gc_emit_int_to_string(b, 0, 1, 2, 3, 4, 5)
  b
}

/// #2405 follow-up: is `e` an argument this lane classifies as statically Int
/// by SHAPE alone?
///
/// A deliberate subset of `bc_expr_is_intish` (backend_call.vibe): the ident
/// arm needs `local_names` + the ctx slot log, neither of which exists during
/// this pre-pass. Missing an ident case is safe -- see
/// `gc_stmts_need_to_string_int` for why the two are allowed to disagree in
/// exactly this direction.
fn gc_expr_is_shape_intish(e: Expr) -> Bool {
  match e {
    EInt(_) => true,
    EBool(_) => true,
    EBinOp(op, l, r, _) => if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" || op == "%" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "==" || op == "!=" || op == "&&" || op == "||" {
      true
    } else if op == "+" || op == "-" || op == "*" || op == "/" {
      // Same recursion as the call site's `bc_expr_is_intish`: these four are
      // resolved from the operands, not from the operator.
      gc_expr_is_shape_intish(l) && gc_expr_is_shape_intish(r)
    } else {
      false
    },
    // Same split as `bc_expr_is_intish`: `!` and `~` are their own type, while
    // `-` carries the operand's (unary `+` is not vibe syntax, measured, so
    // there is no arm for it). Leaving `-` out here did not make a
    // module WRONG -- the call site would find the argument Int, see the ctx
    // index at -1 and inline -- but a module whose only statically-Int renders
    // are written `__to_string(-(64 << 32))` then paid the ~182-byte inline
    // copy at every site, which is the growth the shared body exists to remove
    // (#2422 review).
    EUnaryOp(op, x) => if op == "!" || op == "~" {
      true
    } else if op == "-" {
      gc_expr_is_shape_intish(x)
    } else {
      false
    },
    _ => false
  }
}

/// Is this argument one the call site MIGHT classify as Int?
///
/// Deliberately looser than `gc_expr_is_shape_intish`: a bare ident counts,
/// because the call site resolves those through the `gc_int_locals` slot log
/// (annotated Int params, `let`/`let mut` bindings, aliases) and this pre-pass
/// has no slot log to consult.
///
/// Over-approximating is the safe direction and the cheap one. Too WIDE costs
/// one unused ~182-byte body in a module whose idents all turn out to be
/// Strings. Too NARROW costs an inline copy at every site the call site does
/// classify -- measured before this arm existed, that was sieve +15.31% and
/// records_pipeline +13.50% against baseline, because their `__to_string`
/// arguments are all idents. It can never cause a call to a body that was not
/// pushed: the call site emits a call only when the ctx index is non-negative.
fn gc_to_string_arg_may_be_int(e: Expr) -> Bool {
  match e {
    EIdent(_, _) => true,
    _ => gc_expr_is_shape_intish(e)
  }
}

fn gc_expr_needs_to_string_int(expr: Expr) -> Bool {
  let direct = match expr {
    ECall(EIdent(callee, _), cargs, _) => (callee == "__to_string" || callee == "Int::to_string") && Array::length(cargs) == 1 && gc_to_string_arg_may_be_int(Array::get(cargs, 0)),
    _ => false
  }
  if direct {
    true
  } else {
    let children = expr_children(expr)
    let mut i = 0
    let mut found = false
    while i < Array::length(children) {
      if gc_expr_needs_to_string_int(Array::get(children, i)) {
        found = true
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

/// #2405 follow-up: does this module have a `__to_string` argument that is Int
/// by shape, i.e. one the call-site arm would otherwise INLINE the ~182-byte
/// renderer for?
///
/// Decides whether `gc_gen_to_string_int_body` is emitted at all. The scan and
/// the call site are allowed to disagree, but only ONE WAY: the call site also
/// classifies a bare ident (through the `gc_int_locals` slot log), which this
/// scan cannot see, so it may find nothing where the call site later finds
/// something. That case falls back to inlining, which is correct and merely
/// bigger. The reverse -- the call site emitting a `call` to a body this scan
/// declined to push -- cannot happen, because the call site only calls when
/// the ctx carries a non-negative index, and only this scan sets it.
///
/// Modules with no such argument (six of the nine `bench/exec` samples) carry
/// no helper and are byte-identical to before.
/// #3126: the raw `(ptr << 32) | len` constant of a string the pool seeded
/// (the division-by-zero fragments); 0 if it is absent, which the abort body
/// reads as "no text" rather than a pointer.
export fn gc_str_fat(strs: Array[String], offsets: Array[Int], lengths: Array[Int], s: String) -> Int {
  let mut found = 0 - 1
  let mut i = 0
  while i < Array::length(strs) {
    if String::equals(Array::get(strs, i), s) {
      found = i
      i = Array::length(strs)
    } else {
      i = i + 1
    }
  }
  if found < 0 {
    0
  } else {
    (Array::get(offsets, found)<<32)|Array::get(lengths, found)
  }
}

export fn gc_stmts_need_to_string_int(stmts: Array[Stmt]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, value) => if gc_expr_needs_to_string_int(value) {
        found = true
      } else {
        ()
      },
      SLetMut(_, _, value) => if gc_expr_needs_to_string_int(value) {
        found = true
      } else {
        ()
      },
      SExpr(value) => if gc_expr_needs_to_string_int(value) {
        found = true
      } else {
        ()
      },
      STest(_, body) => if gc_expr_needs_to_string_int(body) {
        found = true
      } else {
        ()
      },
      SBench(_, body) => if gc_expr_needs_to_string_int(body) {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn gc_name_is_called_in_stmts(stmts: Array[Stmt], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, sname, _, value) => if sname != name && gc_name_is_called(value, name) {
        found = true
      } else {
        ()
      },
      STest(_, body) => if gc_name_is_called(body, name) {
        found = true
      } else {
        ()
      },
      SBench(_, body) => if gc_name_is_called(body, name) {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

fn gc_types_mention_array(ts: Array[TypeExpr]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(ts) {
    if gc_type_mentions_array(Array::get(ts, i)) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn gc_type_mentions_array(t: TypeExpr) -> Bool {
  match t {
    TyName(_) => false,
    TyApp(n, args) => n == "Array" || gc_types_mention_array(args),
    TyFn(params, ret, _) => gc_types_mention_array(params) || gc_type_mentions_array(ret),
    TyTuple(elems) => gc_types_mention_array(elems),
    TyUnit => false
  }
}

export fn gc_add_ref_twins(stmts: Array[Stmt]) -> Unit {
  let twins = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      // Ask the SAME question the rest of the lane asks. `is_export` on the
      // SLet only covers `export let f = ...`; the equally supported
      // `let f = ...; export { f }` records the export in a separate SExport,
      // and checking the flag alone silently skipped monomorphization for it --
      // the component just fell back to tagged i64 with nothing to show why.
      SLet(_, is_rec, name, ann, value) => if gc_direct_abi_name_is_exported(stmts, name) {
        match ann {
          // #1750: a SELF-RECURSIVE exported function gets no twin. The
          // original and the twin share one body AST, so the tagged copy's
          // self-call would resolve to the reference twin, hand it a tagged
          // parameter, and fail the whole component closed -- one declaration
          // silently switching the lane off for everything beside it, which is
          // the exact shape #1541 spent its coexistence work removing.
          //
          // Skipping the twin costs this declaration its monomorphization and
          // nothing else: it stays on the tagged lane it was already on, and
          // its neighbours keep the island. Threading the current function's
          // identity into the shared lookups would let even this one cross, and
          // that is what #1750 tracks.
          Some(t) => if gc_type_mentions_array(t) && gc_name_is_called_in_stmts(stmts, name) && !gc_name_is_called(value, name) {
            match value {
              EFn(_, _, _, _, _, _) => Array::push(twins, SLet(false, is_rec, String::concat(name, "$ref"), Some(t), value)),
              _ => ()
            }
          } else {
            ()
          },
          None => ()
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  let mut t2 = 0
  while t2 < Array::length(twins) {
    Array::push(stmts, Array::get(twins, t2))
    t2 = t2 + 1
  }
}

export fn gc_direct_abi_expr_mentions_name(expr: Expr, names: Array[String]) -> Bool {
  match expr {
    EIdent(name, _) => gc_direct_abi_name_in(names, name),
    _ => {
      let children = expr_children(expr)
      let mut found = false
      let mut i = 0
      while i < Array::length(children) {
        if gc_direct_abi_expr_mentions_name(Array::get(children, i), names) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    }
  }
}

export fn emit_gc_direct_func_type(buf: Bytes, param_refs: Array[Bool], return_ref: Bool, native_array_type_idx: Int) -> Unit {
  bytebuf_push(buf, 96)
  // User functions always carry the hidden closure environment parameter.
  leb128_encode_u32(buf, Array::length(param_refs) + 1)
  let mut i = 0
  while i < Array::length(param_refs) {
    if Array::get(param_refs, i) {
      bytebuf_push(buf, 99)
      leb128_encode_u32(buf, native_array_type_idx)
    } else {
      bytebuf_push(buf, 126)
    }
    i = i + 1
  }
  bytebuf_push(buf, 126)
  leb128_encode_u32(buf, 1)
  if return_ref {
    bytebuf_push(buf, 99)
    leb128_encode_u32(buf, native_array_type_idx)
  } else {
    bytebuf_push(buf, 126)
  }
}

/// #805 (ADR-0072): inline wasm (`fn f(..) -> Int = wasm "..."`, carried as
/// the parser-internal `%wasm("<WAT>")` marker body) is LINEAR-BACKEND ONLY —
/// the WAT text is written against the linear backend's raw 62-bit tagged i64
/// ABI, which the wasm-gc backend does not share. Reject loudly instead of
/// letting the marker fall through to an opaque unknown-function error.
export fn gc_reject_inline_wasm(stmts: Array[Stmt]) -> Unit with Exception {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, iw_name, _, iw_expr) => match iw_expr {
        EFn(_, _, _, _, _, iw_body) => match iw_body {
          ECall(iw_cal, iw_args, _) => match iw_cal {
            EIdent(iw_cn, _) => if iw_cn == "%wasm" && Array::length(iw_args) == 1 {
              throw("inline wasm fn '\{iw_name}' (= wasm \"...\") is linear-backend only; the wasm-gc backend does not support it (#805)")
            } else {
              ()
            },
            _ => ()
          },
          _ => ()
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

/// #1015: does this program's own top-level `to_string` (if it has one)
/// structurally match the Show-bounded generic forwarding wrapper
/// `to_string[T: Show](x: T) -> String { __to_string(x) }` -- exactly ONE
/// type param bounded by "Show", exactly one param whose annotation IS that
/// type param, and a body that's nothing but `__to_string(<that param>)`?
///
/// This gates backend_call.vibe's "to_string" call-site fast path (bypassing
/// the wrapper call and inlining `__to_string(arg)` directly with the
/// original, statically classifiable argument expression). Code review
/// (#1015) correctly flagged that the gc lane's single-file compile model
/// rules out CROSS-file shadowing (mangled-name matching, as the linear lane
/// does, is unnecessary here) but NOT a SAME-file user function of the same
/// name: `fn to_string(x: Bool) -> String { "custom" }` is a real, different
/// function that must keep running when called, not be silently replaced by
/// the Bool/Float formatter. That user function fails this structural check
/// (no type params, a concrete Bool param, a body that isn't a bare
/// `__to_string` forward) and so is correctly left alone; only a body that
/// is ACTUALLY just forwarding to `__to_string` -- which can only ever
/// render the same "true"/"false"/digits output the fast path itself
/// produces -- passes.
///
/// MUST be called on `stmts` BEFORE strip_generic_type_params runs (see
/// entry/source_compile/wasi_only/preprocess_strip.vibe): that pass
/// unconditionally zeroes EVERY top-level generic fn's type_params AND
/// bounds arrays (an erasure step, not specific to `to_string`), so by the
/// time compile_wasi_module_gc's own stmts are inspected, `to_string[T:
/// Show]`'s `type_params`/`bounds` are already `[]` and this check would
/// always see 0 type params -- always returning false, permanently
/// disabling the fast path (found via throw()-based instrumentation: the
/// first version of this check ran too late, inside compile_wasi_module_gc,
/// and never once returned true even for the genuine wrapper). Exported so
/// entry/source_compile/gc_only/gc_only.vibe (and
/// tests/codegen_test_support.vibe, which does not strip) can call
/// it on their own pre-strip `stmts` and pass the result in.
export fn gc_to_string_resolves_to_show_wrapper(stmts: Array[Stmt]) -> Bool {
  let mut i = 0
  let mut found = false
  let mut found_value = EUnit
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, tsw_name, _, tsw_value) => if tsw_name == "to_string" {
        found = true
        found_value = tsw_value
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  if found {
    gc_efn_is_show_to_string_wrapper(found_value)
  } else {
    false
  }
}

fn gc_efn_is_show_to_string_wrapper(value: Expr) -> Bool {
  match value {
    EFn(tsw_tparams, tsw_bounds, tsw_params, _, _, tsw_body) => if Array::length(tsw_tparams) == 1 && Array::length(tsw_params) == 1 {
      let tsw_tparam = Array::get(tsw_tparams, 0)
      let (tsw_pname, tsw_pty) = Array::get(tsw_params, 0)
      let tsw_ty_matches = match tsw_pty {
        Some(TyName(tsw_ptn)) => tsw_ptn == tsw_tparam,
        _ => false
      }
      tsw_ty_matches && gc_bounds_has_show(tsw_bounds, tsw_tparam) && gc_body_is_to_string_forward(tsw_body, tsw_pname)
    } else {
      false
    },
    _ => false
  }
}

fn gc_bounds_has_show(bounds: Array[(String, Array[String])], tparam: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(bounds) {
    let (bname, btraits) = Array::get(bounds, i)
    if bname == tparam {
      let mut j = 0
      while j < Array::length(btraits) {
        if Array::get(btraits, j) == "Show" {
          found = true
        } else {
          ()
        }
        j = j + 1
      }
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Is `body` exactly `__to_string(<pname>)` -- a bare one-arg forward of the
/// wrapper's own sole param to the `__to_string` builtin, nothing else?
fn gc_body_is_to_string_forward(body: Expr, pname: String) -> Bool {
  match body {
    ECall(tsf_callee, tsf_args, _) => match tsf_callee {
      EIdent(tsf_cn, _) => tsf_cn == "__to_string" && Array::length(tsf_args) == 1 && (match Array::get(tsf_args, 0) {
        EIdent(tsf_an, _) => tsf_an == pname,
        _ => false
      }),
      _ => false
    },
    _ => false
  }
}

/// Preserve the one pre-erasure fact the direct Array ABI must consume.
/// `strip_generic_type_params` deliberately removes every EFn binder, so the
/// gc-only source pipeline collects the generic declaration NAMES before
/// stripping and passes them into codegen. Post-strip an erased signature is
/// indistinguishable from a monomorphic one, so without this list a generic
/// `fn f[T](values: Array[Int], marker: T)` would be handed a typed
/// `(ref null $array)` parameter it cannot honor.
///
/// This used to be a single Bool ("no generic declaration anywhere"), which
/// disabled the island for every component containing any generic at all --
/// in practice, all real code. Carrying the names instead keeps exactly the
/// same rejection for generic declarations while letting a generic that never
/// touches a reference-lane value coexist with the island: it simply is not a
/// candidate, and any attempt to pass a reference into it is still rejected
/// component-wide by `gc_direct_abi_expr_kind`.
export fn gc_direct_abi_pre_erasure_generic_names(stmts: Array[Stmt]) -> Array[String] {
  let names = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, EFn(type_params, _, _, _, _, _)) => if Array::length(type_params) > 0 {
        Array::push(names, name)
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  names
}

export fn gc_direct_abi_name_is_exported(stmts: Array[Stmt], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exported, _, stmt_name, _, _) => if exported && stmt_name == name {
        found = true
      } else {
        ()
      },
      SExport(names) => {
        let mut j = 0
        while j < Array::length(names) {
          if Array::get(names, j) == name {
            found = true
          } else {
            ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  found
}
