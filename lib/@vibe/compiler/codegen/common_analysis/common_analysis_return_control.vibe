import @vibe/compiler/core {
  Expr, Stmt, builtin_frame_jump, builtin_frame_scope, expr_any_node, resolved_callee_operation, return_call_resolve, return_call_site
}
export fn return_control_node(_ e: Expr) -> Bool {
  match e {
    ECall(_, _, _, r) => {
      let operation = resolved_callee_operation(r); operation == builtin_frame_scope || operation == builtin_frame_jump || return_call_site(r) >= 0
    },
    _ => false
  }
}
export fn return_control_expr_uses(_ e: Expr) -> Bool {
  expr_any_node(expr = e, pred = return_control_node)
}
export fn return_control_program_uses(_ stmts: Array[Stmt]) -> Bool {
  let mut found = false
  for stmt in stmts {
    if !found {
      found = match stmt {
        SLet(_, _, _, _, e) => return_control_expr_uses(e),
        SLetMut(_, _, e) => return_control_expr_uses(e),
        SExpr(e) => return_control_expr_uses(e),
        STest(_, e) => return_control_expr_uses(e),
        SBench(_, e) => return_control_expr_uses(e),
        _ => false
      }
    }
  }
  found
}
export fn return_control_annotate_calls(e: Expr, counter: Array[Int]) -> Expr {
  match e {
    EReturn(value) => EReturn(return_control_annotate_calls(e = value, counter = counter)),
    EFn(ts, bs, ps, ret, eff, body) => EFn(ts, bs, ps, ret, eff, return_control_annotate_calls(e = body, counter = counter)),
    ELet(n, v, b, o) => ELet(n, return_control_annotate_calls(e = v, counter = counter), return_control_annotate_calls(e = b, counter = counter), o),
    ELetRec(n, v, b) => ELetRec(n, return_control_annotate_calls(e = v, counter = counter), return_control_annotate_calls(e = b, counter = counter)),
    ELetMut(n, v, b, o) => ELetMut(n, return_control_annotate_calls(e = v, counter = counter), return_control_annotate_calls(e = b, counter = counter), o),
    ESeq(a, b) => ESeq(return_control_annotate_calls(e = a, counter = counter), return_control_annotate_calls(e = b, counter = counter)),
    EIf(c, t, f) => EIf(return_control_annotate_calls(e = c, counter = counter), return_control_annotate_calls(e = t, counter = counter), return_control_annotate_calls(e = f, counter = counter)),
    EMatch(v, arms) => EMatch(return_control_annotate_calls(e = v, counter = counter), for arm in arms {
      (arm.0, return_control_annotate_calls(e = arm.1, counter = counter))
    }),
    EHandle(v, arms) => EHandle(return_control_annotate_calls(e = v, counter = counter), for arm in arms {
      (arm.0, return_control_annotate_calls(e = arm.1, counter = counter))
    }),
    EWhile(c, b) => EWhile(return_control_annotate_calls(e = c, counter = counter), return_control_annotate_calls(e = b, counter = counter)),
    ELoop(states, b) => ELoop(for item in states {
      (item.0, return_control_annotate_calls(e = item.1, counter = counter))
    }, return_control_annotate_calls(e = b, counter = counter)),
    EForIn(n, i, v, b, for_off) => EForIn(n, i, return_control_annotate_calls(e = v, counter = counter), return_control_annotate_calls(e = b, counter = counter), for_off),
    ECall(c, args, o, r) => {
      let callee = return_control_annotate_calls(e = c, counter = counter)
      let is_perform = match c {
        EIdent(n, _) => n == "perform",
        _ => false
      }
      let values = if is_perform && Array::length(args) == 1 {
        [
          match Array::get(args, at = 0) {
            ECall(op, ps, po, pr) => ECall(op, for p in ps {
              return_control_annotate_calls(e = p, counter = counter)
            }, po, pr),
            other => other
          }
        ]
      } else {
        for arg in args {
          return_control_annotate_calls(e = arg, counter = counter)
        }
      }
      let operation = resolved_callee_operation(r)
      let resolution = if operation == builtin_frame_scope || operation == builtin_frame_jump {
        r
      } else {
        let site = Array::get(counter, at = 0)
        Array::set(counter, at = 0, value = site + 1)
        return_call_resolve(resolution = r, site = site)
      }
      ECall(callee, values, o, resolution)
    },
    EBinOp(op, l, r, o) => EBinOp(op, return_control_annotate_calls(e = l, counter = counter), return_control_annotate_calls(e = r, counter = counter), o),
    EUnaryOp(op, v) => EUnaryOp(op, return_control_annotate_calls(e = v, counter = counter)),
    EAssign(n, v, b, o) => EAssign(n, return_control_annotate_calls(e = v, counter = counter), return_control_annotate_calls(e = b, counter = counter), o),
    EAssignOp(n, op, v, b, o) => EAssignOp(n, op, return_control_annotate_calls(e = v, counter = counter), return_control_annotate_calls(e = b, counter = counter), o),
    EDot(v, f, a, b) => EDot(return_control_annotate_calls(e = v, counter = counter), f, a, b),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, return_control_annotate_calls(e = v, counter = counter)),
    ETuple(es) => ETuple(for v in es {
      return_control_annotate_calls(e = v, counter = counter)
    }),
    EArray(es) => EArray(for v in es {
      return_control_annotate_calls(e = v, counter = counter)
    }),
    ERecord(n, fs, ts) => ERecord(n, for f in fs {
      (f.0, return_control_annotate_calls(e = f.1, counter = counter))
    }, ts),
    EMap(fs) => EMap(for f in fs {
      (f.0, return_control_annotate_calls(e = f.1, counter = counter))
    }),
    ESpread(v) => ESpread(return_control_annotate_calls(e = v, counter = counter)),
    EBreak(v) => EBreak(match v {
      Some(x) => Some(return_control_annotate_calls(e = x, counter = counter)),
      None => None
    }),
    EContinue(args) => EContinue(for a in args {
      return_control_annotate_calls(e = a, counter = counter)
    }),
    _ => e
  }
}
