// @vibe/compiler/codegen/common_analysis — free-variable / string-literal /
// exception-reachability AST analyses shared across codegen, plus a few
// low-level Perceus-adjacent codegen emit helpers (ADR-0070 Phase 3, #897,
// compiler-internal batch). Compiled into the compiler itself via
// compiler_sources_manifest.tsv (group `codegen`, dual-row: this contract +
// common_analysis.vibe).
//
// The old index.vibe was not a facade but the whole implementation (the
// package is single-file), so it moved verbatim to common_analysis.vibe. No
// exported types: every struct/enum this package touches (Expr/Pat/Stmt from
// ../../core) is structural signature text resolved against the
// implementation import when the facade is merged in (normalize/perceus
// precedent — no re-import needed here). No `version` binding existed
// (compiler-internal package).

fn collect_strings_expr(expr: Expr, out: Array[String]) -> Int
fn get_func_param_names(stmt: Stmt) -> Array[String] with Exception
fn expr_contains_exceptions(expr: Expr) -> Bool
fn stmts_contain_exceptions(stmts: Array[Stmt]) -> Bool
fn collect_strings_stmts(stmts: Array[Stmt]) -> Array[String]
fn emit_i64_extend_i32_u(buf: Bytes) -> Unit
fn emit_closure_resolve(buf: Bytes, fn_val_local: Int, slot_local: Int, env_local: Int) -> Unit
fn emit_closure_call_tail(buf: Bytes, env_local: Int, slot_local: Int, closure_type_base: Int, num_args: Int) -> Unit
fn collect_free_vars_expr(expr: Expr, bound: Array[String], fn_names: Array[String], out: Array[String]) -> Int
fn collect_free_vars(body: Expr, param_names: Array[String], fn_names: Array[String]) -> Array[String]
fn collect_free_vars_indexed(body: Expr, param_names: Array[String], fn_name_index: Array[String]) -> Array[String]
fn collect_free_vars_used_builtins(body: Expr, param_names: Array[String], fn_name_index: Array[String]) -> Array[String]
fn collect_free_vars_indexed_self(body: Expr, param_names: Array[String], fn_name_index: Array[String], self_name: String, encl: Array[String]) -> Array[String]
fn proj_root_ident(e: Expr) -> String
fn scope_tail_proj_root(e: Expr) -> String
fn is_mut_captured_in(expr: Expr, name: String) -> Bool
fn mut_needs_ref_cell(body: Expr, name: String) -> Bool
fn md_is_borrow_arg0_call(f: String) -> Bool
fn md_consume_count(e: Expr, name: String) -> Int
fn md_consume_count_b(e: Expr, name: String, bfns: Array[String], bmasks: Array[Int]) -> Int
fn md_shadow_zeroed_bmasks(e: Expr, bfns: Array[String], bmasks: Array[Int]) -> Array[Int]
fn md_consume_count_pre(e: Expr, name: String, bfns: Array[String], bmasks_zeroed: Array[Int]) -> Int
fn zero_alloc_check(stmts: Array[Stmt]) -> String
fn compute_borrow_param_user_fns(stmts: Array[Stmt], exclude: Array[String], out_masks: Array[Int]) -> Array[String]
fn bmask_max_param() -> Int
fn bmask_has(mask: Int, i: Int) -> Bool
fn compute_may_return_view_fns(stmts: Array[Stmt]) -> Array[String]
fn count_lambda_sites_expr(expr: Expr) -> Int
fn packed_lines_to_array_expr(raw_call: Expr, tmp_name: String) -> Expr
