// lib/@vibe/compiler/codegen/common_analysis/common_analysis.vibe — za walk.

import @vibe/compiler/core {
  Expr, Pat, Stmt, Type, TypeDef, TypeExpr, bsearch_leftmost, builtin_allocates, builtin_registry, sorted_names_of
}

import @vibe/core {
  array_empty, struct MutMap, struct MutSet
}

import @vibe/compiler/codegen/common_extractors {
  array_contains_str
}

import @vibe/compiler/codegen/wasm_emit {
  emit_call_indirect
}

import ./common_analysis_free_vars_expr_sc.vibe {
  collect_pattern_bindings, lambda_has_captures
}

//# ADR-0091 zero_alloc (Phase 1)

/// Builtins allowed inside a `#zero_alloc` fn. Allocation classification is
/// owned by the builtin registry so fused primitives and zero-allocation
/// checking cannot drift apart. Unknown builtins still fail closed.
fn za_safe_builtin(_ f: String) -> Bool {
  !builtin_allocates(f)
}

fn za_first(a: String, b: String) -> String {
  if a != "" {
    a
  } else {
    b
  }
}

/// Extract plain binder names from an EFn parameter list, stripping the
/// `?` label-sugar suffix (the call-site spelling binds the bare name).
fn za_param_facts(_ ps: Array[(String, Option[TypeExpr])]) -> Array[String] {
  let out = array_empty()
  let mut pi = 0
  while pi < Array::length(ps) {
    let (raw, annotation) = Array::get(ps, at = pi)
    let rl = String::length(raw)
    let stripped = if rl > 0 {
      let lc = String::char_code_at(raw, at = rl - 1)
      if lc == '?' {
        raw[0: rl - 1]
      } else {
        raw
      }
    } else {
      raw
    }
    Array::push(out, value = String::concat(stripped, String::concat("\n", typed_alloc_annotation_kind(annotation))))
    pi = pi + 1
  }
  out
}

fn za_param_fact_name(_ fact: String) -> String {
  let sep = String::index_of(fact, needle = "\n")
  if sep >= 0 {
    String::substring(fact, start = 0, end = sep)
  } else {
    fact
  }
}

fn za_param_fact_kind(_ fact: String) -> String {
  let sep = String::index_of(fact, needle = "\n")
  if sep >= 0 {
    String::substring(fact, start = sep + 1, end = String::length(fact))
  } else {
    ""
  }
}

fn typed_alloc_name_kind(names: Array[String], kinds: Array[String], name: String) -> String {
  let mut i = Array::length(names) - 1
  let mut matched = false
  let mut found = ""
  while i >= 0 && !matched {
    if Array::get(names, at = i) == name && i < Array::length(kinds) {
      matched = true
      found = Array::get(kinds, at = i)
    } else {
      ()
    }
    i = i - 1
  }
  if matched && found == "" {
    "<unknown>"
  } else {
    found
  }
}

fn typed_alloc_expr_kind(expr: Expr, names: Array[String], kinds: Array[String]) -> String {
  match expr {
    EInt(_) => "Int",
    EFloat(_) => "Float64",
    EString(_, _) => "String",
    EBool(_) => "Bool",
    EIdent(name, _) => typed_alloc_name_kind(names = names, kinds = kinds, name = name),
    EBinOp(op, lhs, _, _) => if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" || op == "&&" || op == "||" {
      "Bool"
    } else {
      typed_alloc_expr_kind(expr = lhs, names = names, kinds = kinds)
    },
    EUnaryOp(op, operand) => if op == "!" {
      "Bool"
    } else {
      typed_alloc_expr_kind(expr = operand, names = names, kinds = kinds)
    },
    _ => ""
  }
}

fn typed_alloc_annotation_kind(_ annotation: Option[TypeExpr]) -> String {
  match annotation {
    Some(TyName(name)) => if name == "Int" || name == "Float64" || name == "String" || name == "Bool" {
      name
    } else {
      ""
    },
    _ => ""
  }
}

fn typed_alloc_copy_strings(_ items: Array[String]) -> Array[String] {
  Array::slice(items, start = 0, end = Array::length(items))
}

fn za_lambda_global_index(fn_names: Array[String], ctors: Array[String]) -> Array[String] {
  let names = typed_alloc_copy_strings(fn_names)
  let mut ci = 0
  while ci < Array::length(ctors) {
    Array::push(names, value = Array::get(ctors, at = ci))
    ci = ci + 1
  }
  let registry = builtin_registry()
  let mut bi = 0
  while bi < Array::length(registry) {
    let (name, _, _, _, _) = Array::get(registry, at = bi)
    Array::push(names, value = name)
    bi = bi + 1
  }
  sorted_names_of(names)
}

/// Classify source operators whose statically evident overload allocates on
/// the linear backend. Lexical type facts survive package linking without
/// relying on file-local offsets. Unknown arithmetic is conservatively
/// reported rather than silently certified by `#zero_alloc`.
export fn typed_operator_alloc_kind(expr: Expr, names: Array[String], kinds: Array[String]) -> String {
  match expr {
    EBinOp(op, lhs, rhs, _) => if op == "+" || op == "-" || op == "*" || op == "/" {
      let left_kind = typed_alloc_expr_kind(expr = lhs, names = names, kinds = kinds)
      let kind = if left_kind == "" || left_kind == "<unknown>" {
        typed_alloc_expr_kind(expr = rhs, names = names, kinds = kinds)
      } else {
        left_kind
      }
      if kind == "Float64" {
        String::concat("operator:Float64:", op)
      } else if kind == "String" && op == "+" {
        "operator:String:+"
      } else if kind == "Int" {
        ""
      } else {
        String::concat("operator:unknown:", op)
      }
    } else {
      ""
    },
    EUnaryOp(op, operand) => if op == "-" {
      let kind = typed_alloc_expr_kind(expr = operand, names = names, kinds = kinds)
      if kind == "Float64" {
        "operator:Float64:-"
      } else if kind == "Int" {
        ""
      } else {
        "operator:unknown:-"
      }
    } else {
      ""
    },
    _ => ""
  }
}

/// Walk an expression under `#zero_alloc` and return "" when it is proven
/// allocation-free, else a description of the first allocation site found.
/// Conservative Phase 1 (ADR-0091): constructors, container/closure/string
/// literals, float literals (heap-boxed on the linear backend), effect
/// handlers, and any call not on the safe-builtin list or resolvable to a
/// proven-clean top-level fn are all rejected. Operators are classified from
/// package-stable lexical type facts so String concatenation and boxed Double
/// arithmetic cannot pass merely because their operands are variables.
fn za_is_region_alloc_callee(_ name: String) -> Bool {
  name == "__region_run" || name == "MutList::empty" || name == "MutList::push" || name == "MutList::truncate" || name == "MutBytes::empty" || name == "MutBytes::push"
}

fn za_is_region_read_callee(_ name: String) -> Bool {
  name == "MutList::length" || name == "MutList::get" || name == "MutBytes::length"
}

fn za_mode_of(_ visited: Array[String]) -> String {
  if Array::length(visited) == 0 {
    ""
  } else {
    let head = Array::get(visited, at = 0)
    if head == "@za:strict" {
      "strict"
    } else if head == "@za:assume" {
      "assume"
    } else {
      ""
    }
  }
}

fn za_walk(e: Expr, ctors: Array[String], fn_names: Array[String], fn_bodies: Array[Expr], fn_params: Array[Array[String]], visited: Array[String], bound: Array[String], typed_table: Array[String], typed_subst: Array[String]) -> String {
  match e {
    EInt(_) => "",
    EFloat(_) => "float literal (heap-boxed on the linear backend)",
    EString(_, _) => "",
    EBool(_) => "",
    EIdent(id, _) => if array_contains_str(arr = bound, s = id) {
      ""
    } else if array_contains_str(arr = ctors, s = id) {
      String::concat("constructor '", String::concat(id, "'"))
    } else {
      ""
    },
    ETuple(items) => {
      let _ = items
      "tuple literal"
    },
    EArray(_) => "array literal",
    ERecord(_, _, _) => "record/struct literal",
    EMap(_) => "map literal",
    EStringInterp(_) => "string interpolation",
    EFn(_, _, params, _, _, body) => if lambda_has_captures(body = body, params = params, fn_name_index = za_lambda_global_index(fn_names = fn_names, ctors = ctors), self_name = "", encl = bound) {
      "closure literal (allocates its environment)"
    } else {
      ""
    },
    EIf(zc, zt, zf) => za_first(a = za_walk(e = zc, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst), b = za_first(a = za_walk(e = zt, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst), b = za_walk(e = zf, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst))),
    ELet(zl_name, zv, zb, _) => {
      let value_result = za_walk(e = zv, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst)
      let body_bound = typed_alloc_copy_strings(bound)
      let body_names = typed_alloc_copy_strings(typed_table)
      let body_kinds = typed_alloc_copy_strings(typed_subst)
      Array::push(body_bound, value = zl_name)
      Array::push(body_names, value = zl_name)
      Array::push(body_kinds, value = typed_alloc_expr_kind(expr = zv, names = typed_table, kinds = typed_subst))
      za_first(a = value_result, b = za_walk(e = zb, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = body_bound, typed_table = body_names, typed_subst = body_kinds))
    },
    ELetRec(zlr_name, zv, zb) => {
      let body_bound = typed_alloc_copy_strings(bound)
      let body_names = typed_alloc_copy_strings(typed_table)
      let body_kinds = typed_alloc_copy_strings(typed_subst)
      Array::push(body_bound, value = zlr_name)
      Array::push(body_names, value = zlr_name)
      Array::push(body_kinds, value = typed_alloc_expr_kind(expr = zv, names = typed_table, kinds = typed_subst))
      za_first(a = za_walk(e = zv, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = body_bound, typed_table = body_names, typed_subst = body_kinds), b = za_walk(e = zb, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = body_bound, typed_table = body_names, typed_subst = body_kinds))
    },
    ELetMut(zlm_name, zv, zb, _) => {
      let value_result = za_walk(e = zv, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst)
      let body_bound = typed_alloc_copy_strings(bound)
      let body_names = typed_alloc_copy_strings(typed_table)
      let body_kinds = typed_alloc_copy_strings(typed_subst)
      Array::push(body_bound, value = zlm_name)
      Array::push(body_names, value = zlm_name)
      Array::push(body_kinds, value = typed_alloc_expr_kind(expr = zv, names = typed_table, kinds = typed_subst))
      za_first(a = value_result, b = za_walk(e = zb, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = body_bound, typed_table = body_names, typed_subst = body_kinds))
    },
    EAssign(_, zv, zb, _) => za_first(a = za_walk(e = zv, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst), b = za_walk(e = zb, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst)),
    EAssignOp(_, _, zv, zb, _) => za_first(a = za_walk(e = zv, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst), b = za_walk(e = zb, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst)),
    ESeq(za, zb) => za_first(a = za_walk(e = za, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst), b = za_walk(e = zb, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst)),
    EMatch(scr, arms) => {
      let mut r = za_walk(e = scr, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (arm_pat, arm_body) = Array::get(arms, at = ai)
        let _ = collect_pattern_bindings(pat = arm_pat, bindings = bound)
        if r == "" {
          r = za_walk(e = arm_body, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst)
        } else {
          ()
        }
        ai = ai + 1
      }
      r
    },
    EHandle(_, _) => "effect handler (allocates evidence)",
    EWhile(zc, zb) => za_first(a = za_walk(e = zc, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst), b = za_walk(e = zb, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst)),
    ELoop(inits, zb) => {
      let mut r = ""
      let loop_bound = typed_alloc_copy_strings(bound)
      let loop_names = typed_alloc_copy_strings(typed_table)
      let loop_kinds = typed_alloc_copy_strings(typed_subst)
      let mut li = 0
      while li < Array::length(inits) {
        let (zloop_name, init_e) = Array::get(inits, at = li)
        if r == "" {
          r = za_walk(e = init_e, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = loop_bound, typed_table = loop_names, typed_subst = loop_kinds)
        } else {
          ()
        }
        let init_kind = typed_alloc_expr_kind(expr = init_e, names = loop_names, kinds = loop_kinds)
        Array::push(loop_bound, value = zloop_name)
        Array::push(loop_names, value = zloop_name)
        Array::push(loop_kinds, value = init_kind)
        li = li + 1
      }
      za_first(a = r, b = za_walk(e = zb, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = loop_bound, typed_table = loop_names, typed_subst = loop_kinds))
    },
    EForIn(zfi_name, zfi_snd, zsrc, zb) => {
      Array::push(bound, value = zfi_name)
      match zfi_snd {
        Some(zfi_n2) => Array::push(bound, value = zfi_n2),
        None => ()
      }
      za_first(a = za_walk(e = zsrc, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst), b = za_walk(e = zb, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst))
    },
    ECall(callee, cargs, _, _) => {
      let region_run = match callee {
        EIdent(cname, _) => cname == "__region_run",
        _ => false
      }
      if region_run {
        if za_mode_of(visited) == "strict" {
          "region/arena allocation"
        } else if Array::length(cargs) == 1 {
          match Array::get(cargs, at = 0) {
            EFn(_, _, rparams, _, _, rbody) => {
              let region_bound = typed_alloc_copy_strings(bound)
              let region_names = typed_alloc_copy_strings(typed_table)
              let region_kinds = typed_alloc_copy_strings(typed_subst)
              let mut rpi = 0
              while rpi < Array::length(rparams) {
                let (rp_name, _) = Array::get(rparams, at = rpi)
                Array::push(region_bound, value = rp_name)
                Array::push(region_names, value = rp_name)
                Array::push(region_kinds, value = "")
                rpi = rpi + 1
              }
              za_walk(e = rbody, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = region_bound, typed_table = region_names, typed_subst = region_kinds)
            },
            other => za_walk(e = other, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst)
          }
        } else {
          ""
        }
      } else {
        let mut r = ""
        let mut ci = 0
        while ci < Array::length(cargs) {
          if r == "" {
            r = za_walk(e = Array::get(cargs, at = ci), ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst)
          } else {
            ()
          }
          ci = ci + 1
        }
        if r != "" {
          r
        } else {
          match callee {
            // #1274 Codex P1: a param or local shadowing a top-level fn is an
            // INDIRECT callee -- the supplied implementation may allocate, so
            // name-only fn_names resolution must not see it.
            EIdent(cname, _) => if array_contains_str(arr = bound, s = cname) {
              String::concat("call through local binding '", String::concat(cname, "' (not proven allocation-free)"))
            } else if array_contains_str(arr = ctors, s = cname) {
              String::concat("constructor '", String::concat(cname, "'"))
            } else if za_is_region_read_callee(cname) {
              ""
            } else if za_is_region_alloc_callee(cname) {
              if za_mode_of(visited) == "strict" {
                "region/arena allocation"
              } else {
                ""
              }
            } else {
              let mut fi = 0
              let mut fidx = 0 - 1
              while fi < Array::length(fn_names) {
                if Array::get(fn_names, at = fi) == cname {
                  fidx = fi
                  fi = Array::length(fn_names)
                } else {
                  fi = fi + 1
                }
              }
              // A source definition owns its spelling even when that spelling
              // is also registered as a builtin. Resolve the body first so a
              // shadow cannot inherit a name-only zero-allocation certificate.
              if fidx >= 0 {
                if array_contains_str(arr = visited, s = cname) {
                  ""
                } else {
                  Array::push(visited, value = cname)
                  // Fresh scope for the callee: its own params are its only
                  // lexical bindings (the caller's do not leak in).
                  let callee_bound = array_empty()
                  let callee_typed_names = array_empty()
                  let callee_typed_kinds = array_empty()
                  let callee_ps = Array::get(fn_params, at = fidx)
                  let mut cbi = 0
                  while cbi < Array::length(callee_ps) {
                    let callee_fact = Array::get(callee_ps, at = cbi)
                    let callee_name = za_param_fact_name(callee_fact)
                    Array::push(callee_bound, value = callee_name)
                    Array::push(callee_typed_names, value = callee_name)
                    Array::push(callee_typed_kinds, value = za_param_fact_kind(callee_fact))
                    cbi = cbi + 1
                  }
                  let inner = za_walk(e = Array::get(fn_bodies, at = fidx), ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = callee_bound, typed_table = callee_typed_names, typed_subst = callee_typed_kinds)
                  if inner == "" {
                    ""
                  } else {
                    String::concat("call to '", String::concat(cname, String::concat("' which may allocate: ", inner)))
                  }
                }
              } else if za_safe_builtin(cname) {
                ""
              } else if za_mode_of(visited) == "assume" {
                ""
              } else {
                String::concat("call to '", String::concat(cname, "' (not proven allocation-free)"))
              }
            },
            _ => "indirect call (not proven allocation-free)"
          }
        }
      }
    },
    EBinOp(_, za, zb, _) => za_first(a = za_first(a = za_walk(e = za, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst), b = za_walk(e = zb, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst)), b = typed_operator_alloc_kind(expr = e, names = typed_table, kinds = typed_subst)),
    EUnaryOp(_, za) => za_first(a = za_walk(e = za, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst), b = typed_operator_alloc_kind(expr = e, names = typed_table, kinds = typed_subst)),
    EDot(zobj, _, _, _) => za_walk(e = zobj, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst),
    ELabeledArg(_, _, zv) => za_walk(e = zv, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst),
    EReturn(zv) => za_walk(e = zv, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst),
    EBreak(zo) => match zo {
      Some(zv) => za_walk(e = zv, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst),
      None => ""
    },
    EContinue(zvs) => {
      let mut r = ""
      let mut vi = 0
      while vi < Array::length(zvs) {
        if r == "" {
          r = za_walk(e = Array::get(zvs, at = vi), ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst)
        } else {
          ()
        }
        vi = vi + 1
      }
      r
    },
    ESpread(zv) => za_walk(e = zv, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = bound, typed_table = typed_table, typed_subst = typed_subst),
    EUnit => ""
  }
}

fn za_stmt_marker_mode(_ stmt: Stmt) -> String {
  match stmt {
    SExpr(me) => match me {
      EIdent(mname, _) => if mname == "@zero_alloc_strict" {
        "strict"
      } else if mname == "@zero_alloc_assume" {
        "assume"
      } else if String::starts_with(mname, prefix = "@zero_alloc") {
        "bare"
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

fn za_eval_named_fn(name: String, mode: String, assume_names: Array[String], ctors: Array[String], fn_names: Array[String], fn_bodies: Array[Expr], fn_params: Array[Array[String]]) -> String {
  let mut fidx = 0 - 1
  let mut fi = 0
  while fi < Array::length(fn_names) {
    if Array::get(fn_names, at = fi) == name {
      fidx = fi
      fi = Array::length(fn_names)
    } else {
      fi = fi + 1
    }
  }
  if fidx < 0 {
    ""
  } else {
    let visited = array_empty()
    if mode == "strict" {
      Array::push(visited, value = "@za:strict")
    } else if mode == "assume" {
      Array::push(visited, value = "@za:assume")
    } else {
      Array::push(visited, value = "@za:")
    }
    let mut aj = 0
    while aj < Array::length(assume_names) {
      Array::push(visited, value = Array::get(assume_names, at = aj))
      aj = aj + 1
    }
    Array::push(visited, value = name)
    let seed_bound = array_empty()
    let seed_typed_names = array_empty()
    let seed_typed_kinds = array_empty()
    let seed_ps = Array::get(fn_params, at = fidx)
    let mut sbi = 0
    while sbi < Array::length(seed_ps) {
      let seed_fact = Array::get(seed_ps, at = sbi)
      let seed_name = za_param_fact_name(seed_fact)
      Array::push(seed_bound, value = seed_name)
      Array::push(seed_typed_names, value = seed_name)
      Array::push(seed_typed_kinds, value = za_param_fact_kind(seed_fact))
      sbi = sbi + 1
    }
    za_walk(e = Array::get(fn_bodies, at = fidx), ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params, visited = visited, bound = seed_bound, typed_table = seed_typed_names, typed_subst = seed_typed_kinds)
  }
}

/// ADR-0091 Phase 1: enforce `#zero_alloc` markers. The parser normalizes the
/// canonical directive (and legacy `@zero_alloc`) to a top-level `SExpr`
/// statement, which the linear backend drops, and it must IMMEDIATELY precede
/// the `fn` declaration it marks (lowered form: `SLet(_, _, name, _,
/// EFn(..))`). Returns "" when every marked fn is proven allocation-free,
/// else a `zero_alloc:`-prefixed diagnostic. Top-level fns only (module
/// bodies are out of scope for this slice); linear backend only.
export fn zero_alloc_check(_ stmts: Array[Stmt]) -> String {
  let fn_names = array_empty()
  let fn_bodies = array_empty()
  let fn_params = array_empty()
  let ctors = array_empty()
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, at = si) {
      SLet(_, _, lname, _, lval) => match lval {
        EFn(_, _, efn_params, _, _, fb) => {
          Array::push(fn_names, value = lname)
          Array::push(fn_bodies, value = fb)
          Array::push(fn_params, value = za_param_facts(efn_params))
        },
        _ => ()
      },
      SEnum(_, _, _, variants, _) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, _) = Array::get(variants, at = vi)
          Array::push(ctors, value = vname)
          vi = vi + 1
        }
      },
      SSuberror(_, _, sub_variants) => {
        let mut vi2 = 0
        while vi2 < Array::length(sub_variants) {
          let (vname2, _) = Array::get(sub_variants, at = vi2)
          Array::push(ctors, value = vname2)
          vi2 = vi2 + 1
        }
      },
      SStruct(_, sname, _, _, _, _) => Array::push(ctors, value = sname),
      _ => ()
    }
    si = si + 1
  }
  let assume_names = array_empty()
  let mut ai = 0
  while ai < Array::length(stmts) {
    match Array::get(stmts, at = ai) {
      SExpr(me) => match me {
        EIdent(mname, _) => if mname == "@zero_alloc_assume" && ai + 1 < Array::length(stmts) {
          match Array::get(stmts, at = ai + 1) {
            SLet(_, _, tname, _, tval) => match tval {
              EFn(_, _, _, _, _, _) => Array::push(assume_names, value = tname),
              _ => ()
            },
            _ => ()
          }
        } else {
          ()
        },
        _ => ()
      },
      _ => ()
    }
    ai = ai + 1
  }
  let mut msg = ""
  let mut mi = 0
  while mi < Array::length(stmts) {
    let marker_name = match Array::get(stmts, at = mi) {
      SExpr(me) => match me {
        EIdent(mname, _) => if String::starts_with(mname, prefix = "@zero_alloc") {
          mname
        } else {
          ""
        },
        _ => ""
      },
      _ => ""
    }
    let is_marker = marker_name != ""
    if is_marker && msg == "" {
      let za_mode = if marker_name == "@zero_alloc_strict" {
        "strict"
      } else if marker_name == "@zero_alloc_assume" {
        "assume"
      } else {
        ""
      }
      let target_name = if mi + 1 < Array::length(stmts) {
        match Array::get(stmts, at = mi + 1) {
          SLet(_, _, tname, _, tval) => match tval {
            EFn(_, _, _, _, _, _) => tname,
            _ => ""
          },
          _ => ""
        }
      } else {
        ""
      }
      if target_name == "" {
        msg = "zero_alloc: '#zero_alloc' must immediately precede a fn declaration"
      } else {
        let r = za_eval_named_fn(name = target_name, mode = za_mode, assume_names = assume_names, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params)
        if r != "" {
          msg = String::concat("zero_alloc: fn '", String::concat(target_name, String::concat("' may allocate: ", r)))
        } else {
          ()
        }
      }
    } else {
      ()
    }
    mi = mi + 1
  }
  msg
}

/// #1936: one row per top-level fn after import merge: (name, mode, site).
/// mode is "" / "bare" / "strict" / "assume". site is empty when that fn is
/// proven allocation-free under its own mode. Not called from the compile
/// hot path — only walk every fn when a caller asks for the summary table.
export fn zero_alloc_fn_summaries(_ stmts: Array[Stmt]) -> Array[(String, String, String)] {
  let fn_names = array_empty()
  let fn_bodies = array_empty()
  let fn_params = array_empty()
  let fn_modes = array_empty()
  let ctors = array_empty()
  let assume_names = array_empty()
  let mut si = 0
  let mut prev_mode = ""
  while si < Array::length(stmts) {
    let stmt = Array::get(stmts, at = si)
    let marker = za_stmt_marker_mode(stmt)
    if marker != "" {
      prev_mode = marker
    } else {
      match stmt {
        SLet(_, _, lname, _, lval) => match lval {
          EFn(_, _, efn_params, _, _, fb) => {
            Array::push(fn_names, value = lname)
            Array::push(fn_bodies, value = fb)
            Array::push(fn_params, value = za_param_facts(efn_params))
            Array::push(fn_modes, value = prev_mode)
            if prev_mode == "assume" {
              Array::push(assume_names, value = lname)
            } else {
              ()
            }
            prev_mode = ""
          },
          _ => {
            prev_mode = ""
          }
        },
        SEnum(_, _, _, variants, _) => {
          prev_mode = ""
          let mut vi = 0
          while vi < Array::length(variants) {
            let (vname, _) = Array::get(variants, at = vi)
            Array::push(ctors, value = vname)
            vi = vi + 1
          }
        },
        SSuberror(_, _, sub_variants) => {
          prev_mode = ""
          let mut vi2 = 0
          while vi2 < Array::length(sub_variants) {
            let (vname2, _) = Array::get(sub_variants, at = vi2)
            Array::push(ctors, value = vname2)
            vi2 = vi2 + 1
          }
        },
        SStruct(_, sname, _, _, _, _) => {
          prev_mode = ""
          Array::push(ctors, value = sname)
        },
        _ => {
          prev_mode = ""
        }
      }
    }
    si = si + 1
  }
  let rows = array_empty()
  let mut ri = 0
  while ri < Array::length(fn_names) {
    let name = Array::get(fn_names, at = ri)
    let mode = Array::get(fn_modes, at = ri)
    let site = za_eval_named_fn(name = name, mode = mode, assume_names = assume_names, ctors = ctors, fn_names = fn_names, fn_bodies = fn_bodies, fn_params = fn_params)
    Array::push(rows, value = (name, mode, site))
    ri = ri + 1
  }
  rows
}

//# ADR-0092 borrow-inference slice 1: per-fn borrowed arg0

/// Collect every top-level-fn name used as a VALUE (a bare ident in any
/// non-callee position) anywhere under `e`. A fn that only ever appears as
/// the direct callee of a call can safely change its arg0 ABI; one that is
/// aliased, passed, stored, captured, or returned cannot (indirect call
/// sites cannot consult the borrow set).
fn ca_collect_valued_idents(e: Expr, out: Array[String], seen: MutSet[String]) -> Int {
  match e {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_, _) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EIdent(vn, _) => {
      if MutSet::insert(seen, x = vn) {
        Array::push(out, value = vn)
      }
      0
    },
    ECall(callee, cargs, _, _) => {
      match callee {
        EIdent(_, _) => 0,
        _ => ca_collect_valued_idents(e = callee, out = out, seen = seen)
      }
      let mut ci = 0
      while ci < Array::length(cargs) {
        let _ = ca_collect_valued_idents(e = Array::get(cargs, at = ci), out = out, seen = seen)
        ci = ci + 1
      }
      0
    },
    ETuple(items) => ca_collect_valued_list(items = items, out = out, seen = seen),
    EArray(items) => ca_collect_valued_list(items = items, out = out, seen = seen),
    ERecord(_, rfields, _) => {
      let mut ri = 0
      while ri < Array::length(rfields) {
        let (_, rv) = Array::get(rfields, at = ri)
        let _ = ca_collect_valued_idents(e = rv, out = out, seen = seen)
        ri = ri + 1
      }
      0
    },
    EMap(mfields) => {
      let mut mi = 0
      while mi < Array::length(mfields) {
        let (_, mv) = Array::get(mfields, at = mi)
        let _ = ca_collect_valued_idents(e = mv, out = out, seen = seen)
        mi = mi + 1
      }
      0
    },
    EIf(c0, t0, f0) => {
      let _ = ca_collect_valued_idents(e = c0, out = out, seen = seen)
      let _ = ca_collect_valued_idents(e = t0, out = out, seen = seen)
      ca_collect_valued_idents(e = f0, out = out, seen = seen)
    },
    ELet(_, v0, b0, _) => {
      let _ = ca_collect_valued_idents(e = v0, out = out, seen = seen)
      ca_collect_valued_idents(e = b0, out = out, seen = seen)
    },
    ELetRec(_, v0, b0) => {
      let _ = ca_collect_valued_idents(e = v0, out = out, seen = seen)
      ca_collect_valued_idents(e = b0, out = out, seen = seen)
    },
    ELetMut(_, v0, b0, _) => {
      let _ = ca_collect_valued_idents(e = v0, out = out, seen = seen)
      ca_collect_valued_idents(e = b0, out = out, seen = seen)
    },
    EAssign(_, v0, b0, _) => {
      let _ = ca_collect_valued_idents(e = v0, out = out, seen = seen)
      ca_collect_valued_idents(e = b0, out = out, seen = seen)
    },
    EAssignOp(_, _, v0, b0, _) => {
      let _ = ca_collect_valued_idents(e = v0, out = out, seen = seen)
      ca_collect_valued_idents(e = b0, out = out, seen = seen)
    },
    ESeq(a0, b0) => {
      let _ = ca_collect_valued_idents(e = a0, out = out, seen = seen)
      ca_collect_valued_idents(e = b0, out = out, seen = seen)
    },
    EMatch(scr, arms) => {
      let _ = ca_collect_valued_idents(e = scr, out = out, seen = seen)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, ab) = Array::get(arms, at = ai)
        let _ = ca_collect_valued_idents(e = ab, out = out, seen = seen)
        ai = ai + 1
      }
      0
    },
    EHandle(hb, harms) => {
      let _ = ca_collect_valued_idents(e = hb, out = out, seen = seen)
      let mut hi = 0
      while hi < Array::length(harms) {
        let (_, hab) = Array::get(harms, at = hi)
        let _ = ca_collect_valued_idents(e = hab, out = out, seen = seen)
        hi = hi + 1
      }
      0
    },
    EWhile(c0, b0) => {
      let _ = ca_collect_valued_idents(e = c0, out = out, seen = seen)
      ca_collect_valued_idents(e = b0, out = out, seen = seen)
    },
    ELoop(inits, b0) => {
      let mut li = 0
      while li < Array::length(inits) {
        let (_, iv) = Array::get(inits, at = li)
        let _ = ca_collect_valued_idents(e = iv, out = out, seen = seen)
        li = li + 1
      }
      ca_collect_valued_idents(e = b0, out = out, seen = seen)
    },
    EForIn(_, _, s0, b0) => {
      let _ = ca_collect_valued_idents(e = s0, out = out, seen = seen)
      ca_collect_valued_idents(e = b0, out = out, seen = seen)
    },
    EBinOp(_, a0, b0, _) => {
      let _ = ca_collect_valued_idents(e = a0, out = out, seen = seen)
      ca_collect_valued_idents(e = b0, out = out, seen = seen)
    },
    EUnaryOp(_, a0) => ca_collect_valued_idents(e = a0, out = out, seen = seen),
    EFn(_, _, _, _, _, fb) => ca_collect_valued_idents(e = fb, out = out, seen = seen),
    EDot(o0, _, _, _) => ca_collect_valued_idents(e = o0, out = out, seen = seen),
    ELabeledArg(_, _, v0) => ca_collect_valued_idents(e = v0, out = out, seen = seen),
    EReturn(v0) => ca_collect_valued_idents(e = v0, out = out, seen = seen),
    EBreak(bo) => match bo {
      Some(bv) => ca_collect_valued_idents(e = bv, out = out, seen = seen),
      None => 0
    },
    EContinue(cvs) => ca_collect_valued_list(items = cvs, out = out, seen = seen),
    ESpread(sv) => ca_collect_valued_idents(e = sv, out = out, seen = seen)
  }
}

fn ca_collect_valued_list(items: Array[Expr], out: Array[String], seen: MutSet[String]) -> Int {
  let mut i = 0
  while i < Array::length(items) {
    let _ = ca_collect_valued_idents(e = Array::get(items, at = i), out = out, seen = seen)
    i = i + 1
  }
  0
}

export fn ca_walk_stmts_valued(stmts: Array[Stmt], out: Array[String]) -> Int {
  ca_walk_stmts_valued_seen(stmts = stmts, out = out, seen = MutSet::new_string())
}

/// Each name is pushed once per walk: every caller asks only whether a name
/// is among them, and the occurrence list of a whole program (every value
/// read of every local) was ~4 MB of the self-compile heap per walk.
fn ca_walk_stmts_valued_seen(stmts: Array[Stmt], out: Array[String], seen: MutSet[String]) -> Int {
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, at = si) {
      SLet(_, _, _, _, lv) => {
        let _ = ca_collect_valued_idents(e = lv, out = out, seen = seen)
        0
      },
      SLetMut(_, _, lv) => {
        let _ = ca_collect_valued_idents(e = lv, out = out, seen = seen)
        0
      },
      SLetPat(_, lv) => {
        let _ = ca_collect_valued_idents(e = lv, out = out, seen = seen)
        0
      },
      SExpr(se) => {
        let _ = ca_collect_valued_idents(e = se, out = out, seen = seen)
        0
      },
      STest(_, tb) => {
        let _ = ca_collect_valued_idents(e = tb, out = out, seen = seen)
        0
      },
      SBench(_, bb) => {
        let _ = ca_collect_valued_idents(e = bb, out = out, seen = seen)
        0
      },
      SModule(_, _, mb) => ca_walk_stmts_valued_seen(stmts = mb, out = out, seen = seen),
      _ => 0
    }
    si = si + 1
  }
  0
}

/// Callee name / argument POSITION pairs where a call somewhere passes a
/// NON-IDENT argument. A borrowed parameter is never dropped by the callee
/// (the epilogue drop is filtered program-wide in linked_compile), and the
/// call-emission borrow check is shape-independent, so a fresh temporary
/// passed directly at a borrowed position -- `ignore_children(Node(Leaf(i),
/// Leaf(j)))` in the RC reclamation gate fixture -- would be released by
/// NOBODY: the caller has no binding to scope-drop and the callee's drop is
/// gone (one leak per call; compiler-gate 40d catches it at N=20000). Such
/// POSITIONS must keep the owned ABI, so record every (callee, position)
/// with a non-ident argument and clear that bit of the callee's mask.
///
/// Per-position, not per-function: one fresh temp at arg2 disqualifies arg2
/// alone and leaves the fn's other read-only params borrowed. `out` and
/// `out_pos` are parallel -- entry k says "callee out[k] takes a non-ident
/// argument at position out_pos[k]".
///
/// A surviving `ELabeledArg` wrapper is not an `EIdent`, so it disqualifies
/// its position here. That is also what makes positional indexing safe at
/// all: checker-owned placements put known declarations in parameter order
/// and remove their wrappers before this walk. Opaque value-call labels stay
/// wrapped and land in this set.
fn ca_collect_nonident_args(e: Expr, out: Array[String], out_pos: Array[Int]) -> Int {
  match e {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_, _) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EIdent(_, _) => 0,
    ECall(callee, cargs, _, _) => {
      match callee {
        EIdent(cf, _) => {
          let mut ni = 0
          while ni < Array::length(cargs) {
            match Array::get(cargs, at = ni) {
              EIdent(_, _) => (),
              _ => {
                Array::push(out, value = cf)
                Array::push(out_pos, value = ni)
              }
            }
            ni = ni + 1
          }
          ()
        },
        _ => {
          let _ = ca_collect_nonident_args(e = callee, out = out, out_pos = out_pos)
          ()
        }
      }
      let mut ci = 0
      while ci < Array::length(cargs) {
        let _ = ca_collect_nonident_args(e = Array::get(cargs, at = ci), out = out, out_pos = out_pos)
        ci = ci + 1
      }
      0
    },
    ETuple(items) => ca_collect_nonident_args_list(items = items, out = out, out_pos = out_pos),
    EArray(items) => ca_collect_nonident_args_list(items = items, out = out, out_pos = out_pos),
    ERecord(_, rfields, _) => {
      let mut ri = 0
      while ri < Array::length(rfields) {
        let (_, rv) = Array::get(rfields, at = ri)
        let _ = ca_collect_nonident_args(e = rv, out = out, out_pos = out_pos)
        ri = ri + 1
      }
      0
    },
    EMap(mfields) => {
      let mut mi = 0
      while mi < Array::length(mfields) {
        let (_, mv) = Array::get(mfields, at = mi)
        let _ = ca_collect_nonident_args(e = mv, out = out, out_pos = out_pos)
        mi = mi + 1
      }
      0
    },
    EIf(c0, t0, f0) => {
      let _ = ca_collect_nonident_args(e = c0, out = out, out_pos = out_pos)
      let _ = ca_collect_nonident_args(e = t0, out = out, out_pos = out_pos)
      ca_collect_nonident_args(e = f0, out = out, out_pos = out_pos)
    },
    ELet(_, v0, b0, _) => {
      let _ = ca_collect_nonident_args(e = v0, out = out, out_pos = out_pos)
      ca_collect_nonident_args(e = b0, out = out, out_pos = out_pos)
    },
    ELetRec(_, v0, b0) => {
      let _ = ca_collect_nonident_args(e = v0, out = out, out_pos = out_pos)
      ca_collect_nonident_args(e = b0, out = out, out_pos = out_pos)
    },
    ELetMut(_, v0, b0, _) => {
      let _ = ca_collect_nonident_args(e = v0, out = out, out_pos = out_pos)
      ca_collect_nonident_args(e = b0, out = out, out_pos = out_pos)
    },
    EAssign(_, v0, b0, _) => {
      let _ = ca_collect_nonident_args(e = v0, out = out, out_pos = out_pos)
      ca_collect_nonident_args(e = b0, out = out, out_pos = out_pos)
    },
    EAssignOp(_, _, v0, b0, _) => {
      let _ = ca_collect_nonident_args(e = v0, out = out, out_pos = out_pos)
      ca_collect_nonident_args(e = b0, out = out, out_pos = out_pos)
    },
    ESeq(a0, b0) => {
      let _ = ca_collect_nonident_args(e = a0, out = out, out_pos = out_pos)
      ca_collect_nonident_args(e = b0, out = out, out_pos = out_pos)
    },
    EMatch(scr, arms) => {
      let _ = ca_collect_nonident_args(e = scr, out = out, out_pos = out_pos)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, ab) = Array::get(arms, at = ai)
        let _ = ca_collect_nonident_args(e = ab, out = out, out_pos = out_pos)
        ai = ai + 1
      }
      0
    },
    EHandle(hb, harms) => {
      let _ = ca_collect_nonident_args(e = hb, out = out, out_pos = out_pos)
      let mut hi = 0
      while hi < Array::length(harms) {
        let (_, hab) = Array::get(harms, at = hi)
        let _ = ca_collect_nonident_args(e = hab, out = out, out_pos = out_pos)
        hi = hi + 1
      }
      0
    },
    EWhile(c0, b0) => {
      let _ = ca_collect_nonident_args(e = c0, out = out, out_pos = out_pos)
      ca_collect_nonident_args(e = b0, out = out, out_pos = out_pos)
    },
    ELoop(inits, b0) => {
      let mut li = 0
      while li < Array::length(inits) {
        let (_, iv) = Array::get(inits, at = li)
        let _ = ca_collect_nonident_args(e = iv, out = out, out_pos = out_pos)
        li = li + 1
      }
      ca_collect_nonident_args(e = b0, out = out, out_pos = out_pos)
    },
    EForIn(_, _, s0, b0) => {
      let _ = ca_collect_nonident_args(e = s0, out = out, out_pos = out_pos)
      ca_collect_nonident_args(e = b0, out = out, out_pos = out_pos)
    },
    EBinOp(_, a0, b0, _) => {
      let _ = ca_collect_nonident_args(e = a0, out = out, out_pos = out_pos)
      ca_collect_nonident_args(e = b0, out = out, out_pos = out_pos)
    },
    EUnaryOp(_, a0) => ca_collect_nonident_args(e = a0, out = out, out_pos = out_pos),
    EFn(_, _, _, _, _, fb) => ca_collect_nonident_args(e = fb, out = out, out_pos = out_pos),
    EDot(o0, _, _, _) => ca_collect_nonident_args(e = o0, out = out, out_pos = out_pos),
    ELabeledArg(_, _, v0) => ca_collect_nonident_args(e = v0, out = out, out_pos = out_pos),
    EReturn(v0) => ca_collect_nonident_args(e = v0, out = out, out_pos = out_pos),
    EBreak(bo) => match bo {
      Some(bv) => ca_collect_nonident_args(e = bv, out = out, out_pos = out_pos),
      None => 0
    },
    EContinue(cvs) => ca_collect_nonident_args_list(items = cvs, out = out, out_pos = out_pos),
    ESpread(sv) => ca_collect_nonident_args(e = sv, out = out, out_pos = out_pos)
  }
}

fn ca_collect_nonident_args_list(items: Array[Expr], out: Array[String], out_pos: Array[Int]) -> Int {
  let mut i = 0
  while i < Array::length(items) {
    let _ = ca_collect_nonident_args(e = Array::get(items, at = i), out = out, out_pos = out_pos)
    i = i + 1
  }
  0
}

export fn ca_walk_stmts_nonident_args(stmts: Array[Stmt], out: Array[String], out_pos: Array[Int]) -> Int {
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, at = si) {
      SLet(_, _, _, _, lv) => {
        let _ = ca_collect_nonident_args(e = lv, out = out, out_pos = out_pos)
        0
      },
      SLetMut(_, _, lv) => {
        let _ = ca_collect_nonident_args(e = lv, out = out, out_pos = out_pos)
        0
      },
      SLetPat(_, lv) => {
        let _ = ca_collect_nonident_args(e = lv, out = out, out_pos = out_pos)
        0
      },
      SExpr(se) => {
        let _ = ca_collect_nonident_args(e = se, out = out, out_pos = out_pos)
        0
      },
      STest(_, tb) => {
        let _ = ca_collect_nonident_args(e = tb, out = out, out_pos = out_pos)
        0
      },
      SBench(_, bb) => {
        let _ = ca_collect_nonident_args(e = bb, out = out, out_pos = out_pos)
        0
      },
      SModule(_, _, mb) => ca_walk_stmts_nonident_args(stmts = mb, out = out, out_pos = out_pos),
      _ => 0
    }
    si = si + 1
  }
  0
}

/// Bit `i` of a borrow mask means "parameter `i` of this fn is BORROWED":
/// the caller keeps ownership across the call, so it emits no transfer dup
/// and the callee emits no epilogue drop. Positions >= `bmask_max_param`
/// are never borrowed -- Int is 62-bit tagged, and a 32-param ceiling keeps
/// every shift far inside it with no arity check at the query sites.
///
/// Shared by Perceus, call emission, and linked-compile analysis.
export fn bmask_max_param() -> Int {
  32
}

export fn bmask_has(mask: Int, i: Int) -> Bool {
  i >= 0 && i < 32 && ((mask>>i)&1) == 1
}

/// Strip a labeled/optional parameter's trailing `?` marker.
export fn bp_param_base_name(_ raw: String) -> String {
  let l = String::length(raw)
  if l > 0 {
    let c = String::char_code_at(raw, at = l - 1)
    if c == '?' {
      raw[0: l - 1]
    } else {
      raw
    }
  } else {
    raw
  }
}

/// #2638: the (callee, position) pairs folded into one mask per callee, the
/// way `compute_borrow_param_user_fns` folds them. Shared so a module's
/// published facts and the whole program's are built by one function.
export fn bp_fold_nonident(nonident_fns: Array[String], nonident_pos: Array[Int]) -> MutMap[String, Int] {
  let nonident: MutMap[String, Int] = MutMap::new_string()
  let mut ni = 0
  while ni < Array::length(nonident_fns) {
    let nf = Array::get(nonident_fns, at = ni)
    let np = Array::get(nonident_pos, at = ni)
    let prev = match MutMap::get(nonident, k = nf) {
      Some(m) => m,
      None => 0
    }
    if np >= 0 && np < bmask_max_param() {
      MutMap::set(nonident, k = nf, v = prev|(1<<np))
    } else {
      ()
    }
    ni = ni + 1
  }
  nonident
}

/// #2638: membership over a name list. #2386's rationale applies -- the
/// analysis never reads the order.
export fn bp_name_set(_ names: Array[String]) -> MutSet[String] {
  let s: MutSet[String] = MutSet::new_string()
  let mut i = 0
  while i < Array::length(names) {
    MutSet::add(s, x = Array::get(names, at = i))
    i = i + 1
  }
  s
}

/// #2638: the result shape every entry point here returns -- the SORTED names
/// with `out_masks` filled aligned to them, so one `bsearch_leftmost` on the
/// names indexes straight into the masks. Shared because a caller that sorted
/// the names itself would silently misattribute every mask.
export fn bp_sorted_with_masks(names: Array[String], masks: MutMap[String, Int], out_masks: Array[Int]) -> Array[String] {
  let names_srt = sorted_names_of(names)
  let mut oi = 0
  while oi < Array::length(names_srt) {
    Array::push(out_masks, value = match MutMap::get(masks, k = Array::get(names_srt, at = oi)) {
      Some(m) => m,
      None => 0
    })
    oi = oi + 1
  }
  names_srt
}
