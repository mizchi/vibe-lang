/// #2638: round 0 of ADR-0092's borrow inference, with the two facts that are
/// UNIONS OVER THE WHOLE PROGRAM taken as parameters instead of derived here:
/// the per-callee `nonident` disqualifier mask, and the names used as a VALUE.
/// Everything else it reads is body-local.
///
/// One implementation serves three callers -- the production pass (which
/// derives both unions from the merged program), the whole-program round-0
/// reference, and a module publishing its body-local half with both unions
/// EMPTY. That is what makes `round0 = local & ~owned_bits` a fact about this
/// code rather than a claim about two loops that look alike.
///
/// Returns the source-shadow bits observed; appends to `names` and fills
/// `masks`.
fn bp_round0_scan(stmts: Array[Stmt], nonident: MutMap[String, Int], valued_set: MutSet[String], excluded_set: MutSet[String], names: Array[String], masks: MutMap[String, Int]) -> Int {
  // #2386: both rounds ask "is this parameter consumed anywhere in the
  // body?" through ONE md_consumed_any walk per body instead of one
  // md_consume_count walk per parameter. The rows are reused across bodies;
  // a position a round will not ask about is pre-marked 1 so the walk never
  // queries it and stops once every asked position has answered.
  let bp_names: Array[String] = []
  let bp_hits: Array[Int] = []
  let bp_no_fns: Array[String] = []
  let bp_no_masks: Array[Int] = []
  let mut source_shadow_mask = 0
  let mut si = 0
  while si < Array::length(stmts) {
    let stmt = Array::get(stmts, at = si)
    let source_name = match stmt {
      SLet(_, _, name, _, _) => name,
      SFnDecl(_, name, _, _, _) => name,
      _ => ""
    }
    if source_name == "Map::iter_get" {
      source_shadow_mask = source_shadow_mask|1
    } else if source_name == "Map::__iter_get_unchecked" {
      source_shadow_mask = source_shadow_mask|2
    } else {
      ()
    }
    match stmt {
      SLet(_, _, fname, _, fval) => match fval {
        EFn(_, _, fps, _, _, fbody) => if !MutSet::has(valued_set, x = fname) && !MutSet::has(excluded_set, x = fname) {
          let owned_bits = match MutMap::get(nonident, k = fname) {
            Some(m) => m,
            None => 0
          }
          let mut mask = 0
          let mut pi = 0
          let np = Array::length(fps)
          let lim = if np < bmask_max_param() {
            np
          } else {
            bmask_max_param()
          }
          Array::truncate(bp_names, length = 0)
          Array::truncate(bp_hits, length = 0)
          while pi < lim {
            let (praw, _) = Array::get(fps, at = pi)
            let pn = bp_param_base_name(praw)
            Array::push(bp_names, value = pn)
            Array::push(bp_hits, value = if pn != "" && !bmask_has(mask = owned_bits, i = pi) {
              0
            } else {
              1
            })
            pi = pi + 1
          }
          md_consumed_any(e = fbody, names = bp_names, bfns = bp_no_fns, bmasks = bp_no_masks, hits = bp_hits)
          pi = 0
          while pi < lim {
            if Array::get(bp_hits, at = pi) == 0 && !is_mut_captured_in(expr = fbody, name = Array::get(bp_names, at = pi)) {
              mask = mask|(1<<pi)
            } else {
              ()
            }
            pi = pi + 1
          }
          if mask != 0 {
            Array::push(names, value = fname)
            MutMap::set(masks, k = fname, v = mask)
          } else {
            ()
          }
        } else {
          ()
        },
        _ => ()
      },
      _ => ()
    }
    si = si + 1
  }
  source_shadow_mask
}

/// Record a conservative reverse call graph. Shadowed names may add work,
/// but every expression child is visited so an ownership change reaches all
/// possible callers. A generation mark deduplicates edges within each body.
fn bp_index_callers(e: Expr, caller: Int, names: Array[String], callers: Array[Array[Int]], seen: Array[Int]) -> Unit {
  match e {
    ECall(EIdent(name, _), _, _, _) => {
      let slot = bsearch_leftmost(sorted = names, name = name)
      if slot >= 0 && Array::get(seen, at = slot) != caller {
        Array::set(seen, at = slot, value = caller)
        Array::push(Array::get(callers, at = slot), value = caller)
      }
    },
    _ => ()
  }
  let mark = expr_children_push(e)
  let end = expr_children_top()
  let mut i = mark
  while i < end {
    bp_index_callers(e = expr_child_at(i), caller = caller, names = names, callers = callers, seen = seen)
    i = i + 1
  }
  expr_children_pop(mark)
}

/// Greatest fixed point of the existing per-parameter ownership judgment.
/// Start with globally eligible positions, then only remove borrowed bits.
/// A removed bit revisits its callers, including cycles and self calls. No
/// provisional mask leaves this function; at most 32 bits per function can
/// be removed, so termination does not depend on a chosen round limit.
fn bp_fixpoint_parts(parts: Array[Array[Stmt]], nonident: MutMap[String, Int], valued: MutSet[String], excluded: MutSet[String], out_masks: Array[Int]) -> Array[String] {
  let declared: MutMap[String, Int] = MutMap::new_string()
  let unique_names: Array[String] = []
  let mut pi = 0
  while pi < Array::length(parts) {
    let part = Array::get(parts, at = pi)
    let mut si = 0
    while si < Array::length(part) {
      let name = match Array::get(part, at = si) {
        SLet(_, _, n, _, _) => n,
        SFnDecl(_, n, _, _, _) => n,
        _ => ""
      }
      if name != "" {
        match MutMap::get(declared, k = name) {
          Some(n) => MutMap::set(declared, k = name, v = n + 1),
          None => {
            Array::push(unique_names, value = name)
            MutMap::set(declared, k = name, v = 1)
          }
        }
      }
      si = si + 1
    }
    pi = pi + 1
  }
  let names = sorted_names_of(unique_names)
  let functions: Array[Expr] = []
  let masks: Array[Int] = []
  let callers: Array[Array[Int]] = []
  let shadows: Array[Array[Int]] = []
  let seen_calls: Array[Int] = []
  let seen_shadows: Array[Int] = []
  let checked_captures: Array[Bool] = []
  let queued: Array[Bool] = []
  let work: Array[Int] = []
  let mut i = 0
  while i < Array::length(names) {
    Array::push(functions, value = EUnit)
    Array::push(masks, value = 0)
    Array::push(callers, value = [])
    Array::push(shadows, value = [])
    Array::push(seen_calls, value = -1)
    Array::push(seen_shadows, value = -1)
    Array::push(checked_captures, value = false)
    Array::push(queued, value = false)
    i = i + 1
  }
  // Seed every mask before inspecting a body. Aliases, duplicate declarations
  // and excluded entries keep authoritative zero slots, even for builtins.
  pi = 0
  while pi < Array::length(parts) {
    let part = Array::get(parts, at = pi)
    let mut si = 0
    while si < Array::length(part) {
      match Array::get(part, at = si) {
        SLet(_, _, name, _, EFn(tps, bounds, params, ret, eff, body)) => {
          if MutMap::get(declared, k = name) == Some(1) && !MutSet::has(valued, x = name) && !MutSet::has(excluded, x = name) {
            let slot = bsearch_leftmost(sorted = names, name = name)
            let owned = match MutMap::get(nonident, k = name) {
              Some(m) => m,
              None => 0
            }
            let mut mask = 0
            let mut p = 0
            while p < Array::length(params) && p < bmask_max_param() {
              let (raw, _) = Array::get(params, at = p)
              if bp_param_base_name(raw) != "" && !bmask_has(mask = owned, i = p) {
                mask = mask|(1<<p)
              }
              p = p + 1
            }
            if mask != 0 {
              Array::set(functions, at = slot, value = EFn(tps, bounds, params, ret, eff, body))
              Array::set(masks, at = slot, value = mask)
            }
          }
        },
        _ => ()
      }
      si = si + 1
    }
    pi = pi + 1
  }
  let shadow_names: Array[String] = []
  i = 0
  while i < Array::length(names) {
    if Array::get(masks, at = i) != 0 {
      let value = Array::get(functions, at = i)
      bp_index_callers(e = value, caller = i, names = names, callers = callers, seen = seen_calls)
      // The outer parameters are binders too. Cache shadowed slots once;
      // re-analysis must use the latest callee masks, not a stale copied row.
      md_collect_shadow_names(e = value, out = shadow_names)
      let slots = Array::get(shadows, at = i)
      let mut j = 0
      while j < Array::length(shadow_names) {
        let slot = bsearch_leftmost(sorted = names, name = Array::get(shadow_names, at = j))
        if slot >= 0 && Array::get(seen_shadows, at = slot) != i {
          Array::set(seen_shadows, at = slot, value = i)
          Array::push(slots, value = slot)
        }
        j = j + 1
      }
      Array::truncate(shadow_names, length = 0)
      Array::push(work, value = i)
      Array::set(queued, at = i, value = true)
    }
    i = i + 1
  }
  let param_names: Array[String] = []
  let hits: Array[Int] = []
  let saved_masks: Array[Int] = []
  let mut wi = 0
  while wi < Array::length(work) {
    let slot = Array::get(work, at = wi)
    Array::set(queued, at = slot, value = false)
    let previous = Array::get(masks, at = slot)
    if previous != 0 {
      match Array::get(functions, at = slot) {
        EFn(_, _, params, _, _, body) => {
          Array::truncate(param_names, length = 0)
          Array::truncate(hits, length = 0)
          let mut p = 0
          while p < Array::length(params) && p < bmask_max_param() {
            let (raw, _) = Array::get(params, at = p)
            Array::push(param_names, value = bp_param_base_name(raw))
            Array::push(hits, value = if bmask_has(mask = previous, i = p) {
              0
            } else {
              1
            })
            p = p + 1
          }
          let slots = Array::get(shadows, at = slot)
          let mut j = 0
          while j < Array::length(slots) {
            let shadow = Array::get(slots, at = j)
            Array::push(saved_masks, value = Array::get(masks, at = shadow))
            Array::set(masks, at = shadow, value = 0)
            j = j + 1
          }
          // This pure visitor cannot re-enter inference or publish its table.
          md_consumed_any(e = body, names = param_names, bfns = names, bmasks = masks, hits = hits)
          j = 0
          while j < Array::length(slots) {
            Array::set(masks, at = Array::get(slots, at = j), value = Array::get(saved_masks, at = j))
            j = j + 1
          }
          Array::truncate(saved_masks, length = 0)
          let mut narrowed = 0
          p = 0
          while p < Array::length(param_names) {
            if Array::get(hits, at = p) == 0 {
              if Array::get(checked_captures, at = slot) || !is_mut_captured_in(expr = body, name = Array::get(param_names, at = p)) {
                narrowed = narrowed|(1<<p)
              }
            }
            p = p + 1
          }
          Array::set(checked_captures, at = slot, value = true)
          if narrowed != previous {
            Array::set(masks, at = slot, value = narrowed)
            let affected = Array::get(callers, at = slot)
            j = 0
            while j < Array::length(affected) {
              let caller = Array::get(affected, at = j)
              if Array::get(masks, at = caller) != 0 && !Array::get(queued, at = caller) {
                Array::push(work, value = caller)
                Array::set(queued, at = caller, value = true)
              }
              j = j + 1
            }
          }
        },
        _ => ()
      }
    }
    wi = wi + 1
  }
  let result: Array[String] = []
  i = 0
  while i < Array::length(names) {
    let name = Array::get(names, at = i)
    let mask = Array::get(masks, at = i)
    // #3128: a source definition of ANY borrowing builtin's name keeps its
    // row, even at a zero mask. Without the row md_borrow_mask_of falls back
    // to the builtin's mask, so a call that resolves to the user's function
    // handed over its argument as a borrow while the body consumed it.
    if mask != 0 || md_builtin_borrow_mask(name) != 0 {
      Array::push(result, value = name)
      Array::push(out_masks, value = mask)
    }
    i = i + 1
  }
  result
}

/// ADR-0092 borrow-inference: for every top-level fn, which of its
/// parameters are only ever READ. Each such position's ABI flips to
/// borrowed, program-wide and in lockstep: the caller's plan counts an
/// ident argument there as a free borrow (no transfer dup) and the callee's
/// plan-site drop for that param is skipped (linked_compile).
///
/// Each mask bit describes one parameter. A function that consumes param0
/// but only reads param1 can borrow param1 without changing param0's ABI.
///
/// Eligibility is decided per position, all conservative:
///   - the fn is a top-level `SLet` + `EFn`, and the position is < arity
///     and < bmask_max_param()
///   - that param's consume count in the body is 0 (only borrow-position
///     uses: projections, borrow-arg0 builtin calls -- md_consume_count)
///   - that param is not mut-captured by an inner closure
///   - the fn body does not shadow it (a rebinding would make the consume
///     count unreliable) -- approximated by md_consume_count only, which
///     counts ANY bare mention; a shadowed rebind's value read would count
///     as a consume and disqualify the position
///   - no call anywhere passes a NON-IDENT argument at that position
///     (ca_collect_nonident_args -- a fresh temp at a borrowed position has
///     no owner left to release it)
/// Whole-fn disqualifiers, which zero the mask outright:
///   - the fn name is used as a VALUE anywhere in the program (indirect
///     call sites cannot consult this set)
///   - the caller passes it in `exclude` (the program entry and the
///     conventional entry names: the host invokes them without consulting
///     the set either)
///
/// The worklist solves all direct-call dependencies together, including
/// arbitrary wrapper depth and recursive components. Globally ineligible
/// positions start owned; remaining borrowed bits are removed until stable.
/// Local callee shadows are neutralized before every ownership judgment.
///
/// Returns the SORTED name array and fills `out_masks` aligned to it, so a
/// single `bsearch_leftmost` on the names indexes straight into the masks.
/// Ordinary entries have a non-zero inferred borrow mask. A source definition
/// that shadows a borrowing builtin (md_builtin_borrow_mask non-zero) is
/// retained with an authoritative zero mask when it consumes every
/// parameter (#3128). Sorting and alignment happen
/// here together -- a caller that sorted the names itself would silently
/// misattribute every mask.
export fn compute_borrow_param_user_fns(stmts: Array[Stmt], exclude: Array[String], out_masks: Array[Int]) -> Array[String] {
  let valued = array_empty()
  let _ = ca_walk_stmts_valued(stmts = stmts, out = valued)
  let nonident_fns = array_empty()
  let nonident_pos = array_empty()
  let _ = ca_walk_stmts_nonident_args(stmts = stmts, out = nonident_fns, out_pos = nonident_pos)
  borrow_fixpoint_link_parts(parts = [stmts], valued = valued, nonident_fns = nonident_fns, nonident_pos = nonident_pos, exclude = exclude, out_masks = out_masks)
}

/// #2638: the facts about THIS statement list that ADR-0092's borrow
/// inference reads as a UNION over the whole program -- the names used as a
/// VALUE, and the (callee, position) pairs a call site here disqualifies.
///
/// A module can compute both from its own statements and neither can be
/// completed without every other module's, which is the whole asymmetry: the
/// functions a per-module run qualifies that the whole program refuses are
/// callees whose disqualifying call site lives in another module.
export fn compute_borrow_disqualifiers(stmts: Array[Stmt], out_valued: Array[String], out_nonident_fns: Array[String], out_nonident_pos: Array[Int]) -> Unit {
  let _ = ca_walk_stmts_valued(stmts = stmts, out = out_valued)
  let _ = ca_walk_stmts_nonident_args(stmts = stmts, out = out_nonident_fns, out_pos = out_nonident_pos)
}

/// #2638: round 0 alone, over the whole program -- the reference the
/// per-module body-local facts are measured against. The production entry
/// `compute_borrow_param_user_fns` instead solves all direct-call dependencies
/// to a fixed point after linking program-wide disqualifiers.
export fn compute_borrow_param_user_fns_round0(stmts: Array[Stmt], exclude: Array[String], out_masks: Array[Int]) -> Array[String] {
  let valued = array_empty()
  let nonident_fns = array_empty()
  let nonident_pos = array_empty()
  compute_borrow_disqualifiers(stmts = stmts, out_valued = valued, out_nonident_fns = nonident_fns, out_nonident_pos = nonident_pos)
  let names = array_empty()
  let masks: MutMap[String, Int] = MutMap::new_string()
  let _ = bp_round0_scan(stmts = stmts, nonident = bp_fold_nonident(nonident_fns = nonident_fns, nonident_pos = nonident_pos), valued_set = bp_name_set(valued), excluded_set = bp_name_set(exclude), names = names, masks = masks)
  bp_sorted_with_masks(names = names, masks = masks, out_masks = out_masks)
}

/// #2638: what a MODULE can publish -- the same scan with both program-wide
/// unions EMPTY, so every mask is the body-local answer and nothing has been
/// disqualified yet. The link removes what the unions say.
export fn compute_borrow_param_local_masks(stmts: Array[Stmt], out_masks: Array[Int], out_shadow: Array[Int]) -> Array[String] {
  let names = array_empty()
  let masks: MutMap[String, Int] = MutMap::new_string()
  let empty_nonident: MutMap[String, Int] = MutMap::new_string()
  let empty_valued: MutSet[String] = MutSet::new_string()
  let empty_excluded: MutSet[String] = MutSet::new_string()
  // The source-shadow bits are this module's half of a UNION (the program
  // shadows a compiler-owned accessor if ANY module does), so a module
  // publishes them exactly like its other body-local facts and the link ORs
  // them. Without this the link cannot reproduce the two zero-mask rows
  // `compute_borrow_param_user_fns` appends, and the comparison would have to
  // leave the tail off BOTH sides -- which hides whether the tail was empty or
  // merely unmeasured.
  Array::push(out_shadow, value = bp_round0_scan(stmts = stmts, nonident = empty_nonident, valued_set = empty_valued, excluded_set = empty_excluded, names = names, masks = masks))
  bp_sorted_with_masks(names = names, masks = masks, out_masks = out_masks)
}

/// #2638: THE LINK. Round 0 for the whole program, from the modules'
/// body-local masks and the UNION of their disqualifiers, without re-reading
/// a single body.
///
///   round0(f) = local(f) & ~owned_bits(f),  dropped when f is used as a
///   value anywhere, when the caller excludes it, or when the mask is empty
///
/// That factorisation is the claim, and `bp_round0_scan` is why it holds: the
/// scan pre-marks a position `owned_bits` disqualifies so the walk never asks
/// about it, which skips work for that position but cannot change the answer
/// for the ones it does ask. The oracle checks the claim against the
/// whole-program reference rather than trusting this paragraph.
///
/// A name is NOT deduplicated here. A program may declare one twice, the
/// whole-program scan pushes each occurrence and lets the last mask win, and
/// `sorted_names_of` keeps both -- so the link mirrors that rather than
/// tidying it, or the two answers would differ on exactly the programs the
/// oracle's `dup_defs` counter exists for.
export fn borrow_round0_link(local_names: Array[String], local_masks: Array[Int], valued: Array[String], nonident_fns: Array[String], nonident_pos: Array[Int], exclude: Array[String], out_masks: Array[Int]) -> Array[String] {
  let nonident = bp_fold_nonident(nonident_fns = nonident_fns, nonident_pos = nonident_pos)
  let valued_set = bp_name_set(valued)
  let excluded_set = bp_name_set(exclude)
  let names = array_empty()
  let masks: MutMap[String, Int] = MutMap::new_string()
  let mut i = 0
  while i < Array::length(local_names) {
    let nm = Array::get(local_names, at = i)
    if MutSet::has(valued_set, x = nm) || MutSet::has(excluded_set, x = nm) {
      ()
    } else {
      let owned_bits = match MutMap::get(nonident, k = nm) {
        Some(m) => m,
        None => 0
      }
      let mask = Array::get(local_masks, at = i)&(~owned_bits)
      if mask != 0 {
        Array::push(names, value = nm)
        MutMap::set(masks, k = nm, v = mask)
      } else {
        ()
      }
    }
    i = i + 1
  }
  bp_sorted_with_masks(names = names, masks = masks, out_masks = out_masks)
}

/// Link globally collected call-site disqualifiers before solving ownership.
/// Whole-program and per-module entry points share the same fixed point.
export fn borrow_fixpoint_link_parts(parts: Array[Array[Stmt]], valued: Array[String], nonident_fns: Array[String], nonident_pos: Array[Int], exclude: Array[String], out_masks: Array[Int]) -> Array[String] {
  bp_fixpoint_parts(parts = parts, nonident = bp_fold_nonident(nonident_fns = nonident_fns, nonident_pos = nonident_pos), valued = bp_name_set(valued), excluded = bp_name_set(exclude), out_masks = out_masks)
}

//# ADR-0092 borrow-inference: may-return-view analysis

/// True when `name` is provably bound to a FRESH (owned) value: it was
/// classified fresh at its binding and no assignment tainted it since.
/// Epoch-keyed membership: `m` maps name -> the generation that last
/// inserted it, so one shared table serves every per-function walk of the
/// fixpoint below -- bumping `gen` retires all previous entries at once
/// with no clearing and no per-function allocation (the naive
/// MutSet-per-walk variant of this index cost +160MB of bump high-water
/// on a selfcompile).
fn mrv_gen_has(m: MutMap[String, Int], gen: Int, name: String) -> Bool {
  match MutMap::get(m, k = name) {
    Some(g) => g == gen,
    None => false
  }
}

fn mrv_is_fresh_name(fresh_names: MutMap[String, Int], tainted: MutMap[String, Int], gen: Int, name: String) -> Bool {
  mrv_gen_has(m = fresh_names, gen = gen, name = name) && !mrv_gen_has(m = tainted, gen = gen, name = name)
}

/// Value classification for compute_may_return_view_fns: does `e` evaluate
/// to a provably FRESH/owned value (true), or might it be an unowned
/// interior view (false)? Conservative toward view: only literals, ctor
/// calls, container/closure literals, operators, and calls to
/// known-fresh-returning functions classify fresh; identifiers resolve
/// fresh only through let-chains of fresh values (params, globals, match
/// payload bindings, and borrow-returning builtin results never do).
///
/// The walk doubles as the taint collector, so it MUST recurse into every
/// child (modeled on md_consume_count's completeness): let/letmut bindings
/// record their freshness in `fresh_names`, mut assignments with a
/// non-fresh RHS push the target onto `tainted`, every binder (params are
/// pushed by the caller) lands in `bound` so a call through a local
/// closure is never mistaken for a fresh builtin call, and `EReturn` of a
/// non-fresh value sets `ret_view[0]` (an early return is a tail).
/// Bindings are recorded flat (no scope popping): a name REBOUND to a
/// non-fresh value taints itself, so collisions only ever push toward
/// view -- the safe direction.
fn mrv_fresh(e: Expr, fresh_names: MutMap[String, Int], tainted: MutMap[String, Int], bound: Array[String], gen: Int, user_fns_srt: Array[String], view_set: MutSet[String], ret_view: Array[Int], callees: Array[String]) -> Bool {
  match e {
    EInt(_) => true,
    EFloat(_) => true,
    EString(_, _) => true,
    EBool(_) => true,
    EUnit => true,
    EStringInterp(_) => true,
    EIdent(n, _) => mrv_is_fresh_name(fresh_names = fresh_names, tainted = tainted, gen = gen, name = n),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        let _ = mrv_fresh(e = Array::get(items, at = i), fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
        i = i + 1
      }
      true
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        let _ = mrv_fresh(e = Array::get(items, at = i), fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
        i = i + 1
      }
      true
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, at = i)
        let _ = mrv_fresh(e = v, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
        i = i + 1
      }
      true
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, at = i)
        let _ = mrv_fresh(e = v, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
        i = i + 1
      }
      true
    },
    EIf(c, t, el) => {
      let _ = mrv_fresh(e = c, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      let tf = mrv_fresh(e = t, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      let ef = mrv_fresh(e = el, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      tf && ef
    },
    ELet(n, v, b, _) => {
      let vf = mrv_fresh(e = v, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      Array::push(bound, value = n)
      if vf {
        MutMap::set(fresh_names, k = n, v = gen)
      } else {
        MutMap::set(tainted, k = n, v = gen)
      }
      mrv_fresh(e = b, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
    },
    ELetMut(n, v, b, _) => {
      let vf = mrv_fresh(e = v, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      Array::push(bound, value = n)
      if vf {
        MutMap::set(fresh_names, k = n, v = gen)
      } else {
        MutMap::set(tainted, k = n, v = gen)
      }
      mrv_fresh(e = b, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
    },
    ELetRec(n, v, b) => {
      let _ = mrv_fresh(e = v, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      Array::push(bound, value = n)
      MutMap::set(fresh_names, k = n, v = gen)
      mrv_fresh(e = b, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
    },
    EAssign(n, v, b, _) => {
      let vf = mrv_fresh(e = v, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      if vf {
        ()
      } else {
        MutMap::set(tainted, k = n, v = gen)
      }
      mrv_fresh(e = b, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
    },
    EAssignOp(_, _, v, b, _) => {
      let _ = mrv_fresh(e = v, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      mrv_fresh(e = b, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
    },
    ESeq(a, b) => {
      let _ = mrv_fresh(e = a, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      mrv_fresh(e = b, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
    },
    EMatch(s, arms) => {
      let _ = mrv_fresh(e = s, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      let mut all = true
      let mut i = 0
      while i < Array::length(arms) {
        let (p, v) = Array::get(arms, at = i)
        // Pattern payloads are interior views of the scrutinee: bound but
        // never fresh.
        let _ = collect_pattern_bindings(pat = p, bindings = bound)
        if mrv_fresh(e = v, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees) {
          ()
        } else {
          all = false
        }
        i = i + 1
      }
      all
    },
    EHandle(s, arms) => {
      let _ = mrv_fresh(e = s, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      let mut all = true
      let mut i = 0
      while i < Array::length(arms) {
        let (p, v) = Array::get(arms, at = i)
        let _ = collect_pattern_bindings(pat = p, bindings = bound)
        if mrv_fresh(e = v, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees) {
          ()
        } else {
          all = false
        }
        i = i + 1
      }
      all
    },
    EWhile(c, b) => {
      let _ = mrv_fresh(e = c, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      let _ = mrv_fresh(e = b, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      true
    },
    ELoop(params, b) => {
      let mut i = 0
      while i < Array::length(params) {
        let (pn, pv) = Array::get(params, at = i)
        let _ = mrv_fresh(e = pv, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
        Array::push(bound, value = pn)
        i = i + 1
      }
      let _ = mrv_fresh(e = b, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      // A loop's value flows out of `break v` sites we do not track: view.
      false
    },
    EForIn(n1, n2, it, b) => {
      let _ = mrv_fresh(e = it, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      Array::push(bound, value = n1)
      match n2 {
        Some(n2s) => Array::push(bound, value = n2s),
        None => ()
      }
      let _ = mrv_fresh(e = b, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      true
    },
    ECall(callee, args, _, _) => {
      let mut arg0_fresh = false
      let mut i = 0
      while i < Array::length(args) {
        let af = mrv_fresh(e = Array::get(args, at = i), fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
        if i == 0 {
          arg0_fresh = af
        } else {
          ()
        }
        i = i + 1
      }
      match callee {
        EIdent(f, _) => if array_contains_str(arr = bound, s = f) {
          // A locally-bound closure: its return is untrackable.
          false
        } else if bsearch_leftmost(sorted = user_fns_srt, name = f) >= 0 {
          // #2386: the ONE cross-function dependency of this walk. Record
          // it so the fixpoint driver re-walks this function only when `f`
          // enters the view set later.
          Array::push(callees, value = f)
          !MutSet::has(view_set, x = f)
        } else if borrow_ret_builtin_name(f) {
          false
        } else {
          // Ctor application or a fresh-returning builtin. (A ctor name is
          // uppercase, but a non-view builtin returns fresh too, so the
          // distinction does not matter here.)
          true
        },
        EFn(_, _, wfps, _, _, wbody) => {
          // #1915: `let x: T = e` parses to the identity application
          // `((__asc: T) -> __asc)(e)` (ascribe_wrap, parser_expr_dispatch.vibe)
          // -- a checker-only ascription device, so the call's freshness is the
          // argument's. Treating the non-ident callee as untrackable here put
          // every function tail-returning an annotated fresh binding (`let out:
          // Array[Int] = []; ...; out` -- the standard builder shape) into the
          // may-return-view set, and every caller then leaked the owned result
          // (view-call scope-end drop suppression, one object per call).
          // Recognized structurally (single param returned unchanged), not by
          // the `__asc` name, so a hand-written identity lambda gets the same
          // precision; anything else stays untrackable as before.
          let ident_ret = if Array::length(wfps) == 1 && Array::length(args) == 1 {
            let (wpn, _) = Array::get(wfps, at = 0)
            match wbody {
              EIdent(bn, _) => bn == wpn,
              _ => false
            }
          } else {
            false
          }
          if ident_ret {
            arg0_fresh
          } else {
            let _ = mrv_fresh(e = callee, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
            false
          }
        },
        _ => {
          let _ = mrv_fresh(e = callee, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
          false
        }
      }
    },
    EBinOp(_, l, r, _) => {
      let _ = mrv_fresh(e = l, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      let _ = mrv_fresh(e = r, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      true
    },
    EUnaryOp(_, x) => {
      let _ = mrv_fresh(e = x, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      true
    },
    EFn(_, _, fps, _, _, body) => {
      // A closure literal is a fresh value; its body can still taint
      // captured muts, so walk it -- but ITS early returns are not the
      // enclosing function's (dummy ret cell).
      let mut i = 0
      while i < Array::length(fps) {
        let (pn, _) = Array::get(fps, at = i)
        Array::push(bound, value = pn)
        i = i + 1
      }
      let dummy_ret = [0]
      let _ = mrv_fresh(e = body, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = dummy_ret, callees = callees)
      true
    },
    EDot(x, _, _, _) => {
      let _ = mrv_fresh(e = x, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
      false
    },
    ELabeledArg(_, _, v) => mrv_fresh(e = v, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees),
    EReturn(x) => {
      if mrv_fresh(e = x, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees) {
        ()
      } else {
        Array::set(ret_view, at = 0, value = 1)
      }
      true
    },
    EBreak(opt) => {
      let _ = match opt {
        Some(v) => mrv_fresh(e = v, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees),
        None => true
      }
      true
    },
    EContinue(args) => {
      let mut i = 0
      while i < Array::length(args) {
        let _ = mrv_fresh(e = Array::get(args, at = i), fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
        i = i + 1
      }
      true
    },
    ESpread(x) => mrv_fresh(e = x, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_set, ret_view = ret_view, callees = callees)
  }
}

/// #2638: is THIS function view-returning, given the set decided so far?
///
/// The one cross-function read is `view_seen` (through `mrv_fresh`), plus
/// `user_fns_srt` to tell a user-fn call from a builtin. Everything else is
/// the function's own body and parameters.
///
/// Extracted because the whole-program driver and the per-module lane run
/// DIFFERENT drivers and must not diverge on the DECISION. The worklist
/// (#2386) re-walks a function only when one of its callees enters the set,
/// through a reverse index over the whole program -- an index a module cannot
/// hold, since the caller and the callee may live in different modules. The
/// link therefore runs plain ROUNDS instead, which converge to the same set
/// because the fixpoint is monotone. So what is shared here is the
/// classification, not the loop around it; claiming one implementation serves
/// both drivers would be false.
///
/// `bound` and `callees` are the caller's scratch rows: `bound` is truncated
/// here, `callees` is appended to and read by a caller that maintains a
/// reverse index (the worklist does; the round driver does not need one).
fn mrv_classify_one(body: Expr, fps: Array[(String, Option[TypeExpr])], fresh_names: MutMap[String, Int], tainted: MutMap[String, Int], bound: Array[String], gen: Int, user_fns_srt: Array[String], view_seen: MutSet[String], callees: Array[String]) -> Bool {
  Array::truncate(bound, length = 0)
  let mut pi = 0
  while pi < Array::length(fps) {
    let (pn, _) = Array::get(fps, at = pi)
    Array::push(bound, value = pn)
    pi = pi + 1
  }
  let ret_view = [0]
  let tail_fresh = mrv_fresh(e = body, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_set = view_seen, ret_view = ret_view, callees = callees)
  !tail_fresh || Array::get(ret_view, at = 0) == 1
}

/// ADR-0092 borrow-inference: top-level functions whose RETURN VALUE may be
/// an unowned interior view (a borrow-returning builtin result, a match
/// payload, a global, a parameter, or anything reaching a return position
/// that mrv_fresh cannot prove fresh -- e.g. `let mut out = EInt(0); ...
/// out = Array::get(exprs, i) ...; out`). The planner suppresses the
/// retention-driven scope-end drop ONLY for let-bindings calling functions
/// in this set (intersected with the borrow-arg0 set): suppressing for a
/// fresh-returning callee instead leaks its result (caught by the
/// compiler-gate RC reclamation guard), and NOT suppressing for a
/// view-returning one releases a reference the binding never acquired
/// (the codegen_heap_e2e_test over-release). Iterated to a fixpoint so a
/// view propagates through wrapper functions whose tail is a call.
export fn compute_may_return_view_fns(_ stmts: Array[Stmt]) -> Array[String] {
  // #2386: a callee-edge worklist instead of whole-program rounds. The old
  // driver re-walked EVERY not-yet-classified function body on each round
  // until a round added nothing (0.32 s warm on the compiler closure, one
  // full walk per round). A function's verdict depends on its own body and
  // on which of its user-fn callees are in the view set (mrv_fresh's one
  // cross-function read), so after its first walk it needs another only
  // when one of its callees enters the set. The first walk records each
  // function's callees; a reverse index turns "f entered the view set"
  // into "re-walk f's callers". Same fixpoint, same set.
  let user_fns = array_empty()
  let fn_bodies = array_empty()
  let fn_params = array_empty()
  let mut ci = 0
  while ci < Array::length(stmts) {
    match Array::get(stmts, at = ci) {
      SLet(_, _, fname, _, fval) => match fval {
        EFn(_, _, fps, _, _, fbody) => {
          Array::push(user_fns, value = fname)
          Array::push(fn_params, value = fps)
          Array::push(fn_bodies, value = fbody)
        },
        _ => ()
      },
      _ => ()
    }
    ci = ci + 1
  }
  let user_fns_srt = sorted_names_of(user_fns)
  let view_set = array_empty()
  let view_seen = MutSet::new_string()
  let fresh_names: MutMap[String, Int] = MutMap::new_string()
  let tainted: MutMap[String, Int] = MutMap::new_string()
  let bound = array_empty()
  // callers_of[name] = indices (into user_fns) of the functions that call it;
  // filled from the first walk of each function.
  let callers_of: MutMap[String, Array[Int]] = MutMap::new_string()
  let nfn = Array::length(user_fns)
  // Every function is walked once, in declaration order (the same order the
  // round-based driver used for its first round). `queued` marks a function
  // that is on the worklist so it is never pushed twice.
  let work = array_empty()
  let queued = array_empty()
  let mut wi0 = 0
  while wi0 < nfn {
    Array::push(work, value = wi0)
    Array::push(queued, value = true)
    wi0 = wi0 + 1
  }
  let mut gen = 0
  let mut wi = 0
  while wi < Array::length(work) {
    let fi = Array::get(work, at = wi)
    Array::set(queued, at = fi, value = false)
    let fname = Array::get(user_fns, at = fi)
    if MutSet::has(view_seen, x = fname) {
      ()
    } else {
      gen = gen + 1
      let callees = array_empty()
      let is_view = mrv_classify_one(body = Array::get(fn_bodies, at = fi), fps = Array::get(fn_params, at = fi), fresh_names = fresh_names, tainted = tainted, bound = bound, gen = gen, user_fns_srt = user_fns_srt, view_seen = view_seen, callees = callees)
      // Reverse edges from this walk (recorded once; later walks of the
      // same body see the same callees, so re-recording would only add
      // duplicate callers, which the `queued` mark absorbs anyway).
      let mut ki = 0
      while ki < Array::length(callees) {
        let callee = Array::get(callees, at = ki)
        match MutMap::get(callers_of, k = callee) {
          Some(lst) => Array::push(lst, value = fi),
          None => MutMap::set(callers_of, k = callee, v = [fi])
        }
        ki = ki + 1
      }
      if is_view {
        Array::push(view_set, value = fname)
        MutSet::add(view_seen, x = fname)
        match MutMap::get(callers_of, k = fname) {
          Some(lst) => {
            let mut li = 0
            while li < Array::length(lst) {
              let cf = Array::get(lst, at = li)
              if Array::get(queued, at = cf) || MutSet::has(view_seen, x = Array::get(user_fns, at = cf)) {
                ()
              } else {
                Array::push(work, value = cf)
                Array::set(queued, at = cf, value = true)
              }
              li = li + 1
            }
          },
          None => ()
        }
      } else {
        ()
      }
    }
    wi = wi + 1
  }
  view_set
}

/// #2638: this module's own top-level function NAMES. `mrv_fresh` needs the
/// whole program's set to tell a user-fn call from a builtin, and that set is
/// a union -- so a module publishes its half. Body-free: one pass over the
/// declaration forms.
export fn mrv_declared_fn_names(_ stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, fname, _, fval) => match fval {
        EFn(_, _, _, _, _, _) => Array::push(out, value = fname),
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// #2638: ONE ROUND of the may-return-view fixpoint over `stmts`, against the
/// set decided so far. Returns whether it added anything.
fn mrv_round(stmts: Array[Stmt], user_fns_srt: Array[String], view_set: Array[String], view_seen: MutSet[String], fresh_names: MutMap[String, Int], tainted: MutMap[String, Int], bound: Array[String], gen_cell: Array[Int]) -> Bool {
  let mut changed = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, fname, _, fval) => match fval {
        EFn(_, _, fps, _, _, fbody) =>
        if MutSet::has(view_seen, x = fname) {
          ()
        } else {
          Array::set(gen_cell, at = 0, value = Array::get(gen_cell, at = 0) + 1)
          let callees = array_empty()
          if mrv_classify_one(body = fbody, fps = fps, fresh_names = fresh_names, tainted = tainted, bound = bound, gen = Array::get(gen_cell, at = 0), user_fns_srt = user_fns_srt, view_seen = view_seen, callees = callees) {
            Array::push(view_set, value = fname)
            MutSet::add(view_seen, x = fname)
            changed = true
          } else {
            ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  changed
}

/// #2638: THE MAY-RETURN-VIEW LINK. The whole program's view set, as rounds
/// the link drives across the modules.
///
/// Each round asks every module what it can add given the set so far, and
/// repeats until no module adds anything. A module reads only its own bodies,
/// that set, and `user_fn_names` -- the union the modules published.
///
/// ROUNDS, not the worklist: #2386 replaced rounds with a callee-edge worklist
/// keyed on a reverse index over the whole program, and that index is exactly
/// the cross-module edge (a caller in one module must be re-walked when a
/// callee in another enters the set). A module cannot hold it. Rounds converge
/// to the same set because the fixpoint is monotone, so the answer is
/// unchanged and only the driver is. The whole-program pass keeps its
/// worklist; this costs the rounds #2386 measured at ~0.32 s warm on the
/// compiler closure, and it is paid on the oracle lane alone.
export fn may_return_view_link_parts(parts: Array[Array[Stmt]], user_fn_names: Array[String]) -> Array[String] {
  let user_fns_srt = sorted_names_of(user_fn_names)
  let view_set = array_empty()
  let view_seen = MutSet::new_string()
  let fresh_names: MutMap[String, Int] = MutMap::new_string()
  let tainted: MutMap[String, Int] = MutMap::new_string()
  let bound = array_empty()
  let gen_cell = [0]
  let mut changed = true
  while changed {
    changed = false
    let mut pi = 0
    while pi < Array::length(parts) {
      if mrv_round(stmts = Array::get(parts, at = pi), user_fns_srt = user_fns_srt, view_set = view_set, view_seen = view_seen, fresh_names = fresh_names, tainted = tainted, bound = bound, gen_cell = gen_cell) {
        changed = true
      } else {
        ()
      }
      pi = pi + 1
    }
  }
  view_set
}

//# #1259 step 7 groundwork: lambda-site counting

/// How many lambda table entries compiling `expr` will allocate.
///
/// compile_lambda takes a lambda's function index from the LIVE length of the
/// shared LambdaTable and emits it into the body as a `table_slot` immediate,
/// so a function's output bytes depend on how many lambdas every function
/// compiled before it produced. That is what stops a worker from compiling a
/// body on its own, and removing it is what a frozen WholeProgramPlan means
/// (docs/internal/design/compiler-parallelism.md).
///
/// Counting is exact rather than an estimate: compile_expr dispatches EFn
/// (tag 24) to compile_lambda unconditionally (compile_expr_tail3.vibe), and
/// compile_lambda's push is unconditional, so one table entry per EFn node
/// reachable in the body -- nested lambdas included, since compile_lambda
/// compiles its own body through the same dispatch.
///
/// The traversal mirrors dce.vibe's collect_refs_into arm for arm, and since
/// #2442 that includes its BOUND SET: the walk has to answer "does codegen
/// resolve this name to the eta-expanded builtin, or to something that shadows
/// it", and a bare builtin name can be shadowed. See
/// `count_lambda_sites_ident`.
///
/// It is a PREDICTION of what the sequential walk does, and it is checked
/// against the live length at every allocation rather than trusted -- see
/// CompileCtx.lambda_plan_next. A silent mismatch would key a body's emitted
/// constants to a table slot nothing installs.
export fn count_lambda_sites_expr(expr: Expr, shadow_names: Array[String]) -> Int {
  count_lambda_sites_scoped(expr = expr, shadow_names = shadow_names, bound = common_analysis_fresh_string_array())
}

/// #2442: `x?: Int` reaches codegen as the parameter name `x?`, and compile_lambda pushes the STRIPPED name into `local_names` -- so
/// that is the spelling a body reference resolves against, and the spelling
/// this walk has to treat as bound.
///
/// File-local by the same rule `compile_lambda.vibe` states on its own copy: a
/// brand-new cross-file export and its first cross-file caller in one commit
/// are silently dropped by the merge/flatten tool.
fn cls_strip_param_label_marker(_ n: String) -> String {
  let ln = String::length(n)
  if ln > 0 {
    let c = String::char_code_at(n, at = ln - 1)
    if c == '?' {
      n[0: ln - 1]
    } else {
      n
    }
  } else {
    n
  }
}

/// #1733 / #2442: does codegen materialize this identifier as the synthetic
/// eta-expansion that owns a table slot?
///
/// The predicate is `builtin_value_form_arity`, shared with the checker and
/// both backends rather than restated as a name list here -- this walk was the
/// THIRD copy of #1733's two names, and a plan that disagrees with the walk is
/// not a wrong answer, it is a thrown `lambda plan over-count`.
///
/// The two shadow tests are the walk mirroring codegen's `EIdent` resolution
/// order, which since #2442 is
/// `locals -> consts -> constructors -> VALUE FORM -> func table`:
///
/// - `bound` is the LOCAL half, threaded through the binder arms below. Before
///   #2442 only QUALIFIED names had a value form and nothing local can be
///   spelled `A::b`, which is what let this walk be scope-free. A bare name
///   can be, so an ordinary `let eq = (a, b) -> a == b` would otherwise
///   reserve a slot for a use codegen resolves to the local.
/// - `shadow_names` is the WHOLE-PROGRAM half: user functions (#2448 -- a
///   program may declare `fn Array::get`, and the checker resolves the name to
///   the declaration), module-level int constants, and constructors. Those
///   three are what codegen finds before the value-form arm, and all three are
///   known without scope, which is why they ride a sorted array rather than
///   the bound set.
fn count_lambda_sites_ident(name: String, shadow_names: Array[String], bound: Array[String]) -> Int {
  if builtin_value_form_arity(name) >= 0 && !array_contains_str(arr = bound, s = name) && bsearch_leftmost(sorted = shadow_names, name = name) < 0 {
    1
  } else {
    0
  }
}

fn count_lambda_sites_scoped(expr: Expr, shadow_names: Array[String], bound: Array[String]) -> Int {
  match expr {
    EIdent(name, _) => count_lambda_sites_ident(name = name, shadow_names = shadow_names, bound = bound),
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_, _) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EBreak(_) => 0,
    EContinue(_) => 0,
    EReturn(e) => count_lambda_sites_scoped(expr = e, shadow_names = shadow_names, bound = bound),
    EUnaryOp(_, e) => count_lambda_sites_scoped(expr = e, shadow_names = shadow_names, bound = bound),
    ESpread(e) => count_lambda_sites_scoped(expr = e, shadow_names = shadow_names, bound = bound),
    EDot(obj, _, _, _) => count_lambda_sites_scoped(expr = obj, shadow_names = shadow_names, bound = bound),
    ELabeledArg(_, _, e) => count_lambda_sites_scoped(expr = e, shadow_names = shadow_names, bound = bound),
    ETuple(items) => count_lambda_sites_exprs(items = items, shadow_names = shadow_names, bound = bound),
    EArray(items) => count_lambda_sites_exprs(items = items, shadow_names = shadow_names, bound = bound),
    ERecord(_, fields, _) => count_lambda_sites_fields(fields = fields, shadow_names = shadow_names, bound = bound),
    EMap(fields) => count_lambda_sites_fields(fields = fields, shadow_names = shadow_names, bound = bound),
    EBinOp(_, l, r, _) => count_lambda_sites_scoped(expr = l, shadow_names = shadow_names, bound = bound) + count_lambda_sites_scoped(expr = r, shadow_names = shadow_names, bound = bound),
    ESeq(l, r) => count_lambda_sites_scoped(expr = l, shadow_names = shadow_names, bound = bound) + count_lambda_sites_scoped(expr = r, shadow_names = shadow_names, bound = bound),
    // A direct call stays direct; only a value-position identifier is
    // materialized as the synthetic lambda above. A callee that IS shadowed is
    // an ordinary local/global call, which allocates no table entry either, so
    // this arm answers 0 for both readings.
    ECall(callee, args, _, _) => {
      let callee_count = match callee {
        EIdent(_, _) => 0,
        _ => match ascription_call_value(callee = callee, args = args) {
          Some(_) => 0,
          None => count_lambda_sites_scoped(expr = callee, shadow_names = shadow_names, bound = bound)
        }
      }
      callee_count + count_lambda_sites_exprs(items = args, shadow_names = shadow_names, bound = bound)
    },
    EIf(cond, then_e, else_e) =>
    count_lambda_sites_scoped(expr = cond, shadow_names = shadow_names, bound = bound) + count_lambda_sites_scoped(expr = then_e, shadow_names = shadow_names, bound = bound) + count_lambda_sites_scoped(expr = else_e, shadow_names = shadow_names, bound = bound),
    ELet(name, val, body, _) => {
      let total = count_lambda_sites_scoped(expr = val, shadow_names = shadow_names, bound = bound)
      let mark = Array::length(bound)
      Array::push(bound, value = name)
      let body_total = count_lambda_sites_scoped(expr = body, shadow_names = shadow_names, bound = bound)
      Array::truncate(bound, length = mark)
      total + body_total
    },
    ELetRec(name, val, body) => {
      let mark = Array::length(bound)
      Array::push(bound, value = name)
      let total = count_lambda_sites_scoped(expr = val, shadow_names = shadow_names, bound = bound) + count_lambda_sites_scoped(expr = body, shadow_names = shadow_names, bound = bound)
      Array::truncate(bound, length = mark)
      total
    },
    ELetMut(name, val, body, _) => {
      let total = count_lambda_sites_scoped(expr = val, shadow_names = shadow_names, bound = bound)
      let mark = Array::length(bound)
      Array::push(bound, value = name)
      let body_total = count_lambda_sites_scoped(expr = body, shadow_names = shadow_names, bound = bound)
      Array::truncate(bound, length = mark)
      total + body_total
    },
    EAssign(_, val, body, _) => count_lambda_sites_scoped(expr = val, shadow_names = shadow_names, bound = bound) + count_lambda_sites_scoped(expr = body, shadow_names = shadow_names, bound = bound),
    EAssignOp(_, _, val, body, _) => count_lambda_sites_scoped(expr = val, shadow_names = shadow_names, bound = bound) + count_lambda_sites_scoped(expr = body, shadow_names = shadow_names, bound = bound),
    EWhile(cond, body) => count_lambda_sites_scoped(expr = cond, shadow_names = shadow_names, bound = bound) + count_lambda_sites_scoped(expr = body, shadow_names = shadow_names, bound = bound),
    EForIn(name, index_name, iter, body) => {
      let total = count_lambda_sites_scoped(expr = iter, shadow_names = shadow_names, bound = bound)
      let mark = Array::length(bound)
      Array::push(bound, value = name)
      match index_name {
        Some(index_name) => Array::push(bound, value = index_name),
        None => ()
      }
      let body_total = count_lambda_sites_scoped(expr = body, shadow_names = shadow_names, bound = bound)
      Array::truncate(bound, length = mark)
      total + body_total
    },
    ELoop(params, body) => {
      let mark = Array::length(bound)
      let mut i = 0
      let mut total = 0
      while i < Array::length(params) {
        let (name, init) = Array::get(params, at = i)
        total = total + count_lambda_sites_scoped(expr = init, shadow_names = shadow_names, bound = bound)
        Array::push(bound, value = name)
        i = i + 1
      }
      let body_total = count_lambda_sites_scoped(expr = body, shadow_names = shadow_names, bound = bound)
      Array::truncate(bound, length = mark)
      total + body_total
    },
    EMatch(scr, arms) => count_lambda_sites_scoped(expr = scr, shadow_names = shadow_names, bound = bound) + count_lambda_sites_arms(arms = arms, shadow_names = shadow_names, bound = bound),
    EHandle(body_expr, arms) => count_lambda_sites_scoped(expr = body_expr, shadow_names = shadow_names, bound = bound) + count_lambda_sites_arms(arms = arms, shadow_names = shadow_names, bound = bound),
    // The one arm that counts: this node IS a table entry, and its body may
    // hold more.
    EFn(_, _, params, _, _, body) => {
      let mark = Array::length(bound)
      let mut i = 0
      while i < Array::length(params) {
        let (pname, _) = Array::get(params, at = i)
        Array::push(bound, value = cls_strip_param_label_marker(pname))
        i = i + 1
      }
      let body_total = count_lambda_sites_scoped(expr = body, shadow_names = shadow_names, bound = bound)
      Array::truncate(bound, length = mark)
      1 + body_total
    }
  }
}

fn count_lambda_sites_exprs(items: Array[Expr], shadow_names: Array[String], bound: Array[String]) -> Int {
  let n = Array::length(items)
  let mut i = 0
  let mut total = 0
  while i < n {
    total = total + count_lambda_sites_scoped(expr = Array::get(items, at = i), shadow_names = shadow_names, bound = bound)
    i = i + 1
  }
  total
}

fn count_lambda_sites_fields(fields: Array[(String, Expr)], shadow_names: Array[String], bound: Array[String]) -> Int {
  let n = Array::length(fields)
  let mut i = 0
  let mut total = 0
  while i < n {
    let (_, val) = Array::get(fields, at = i)
    total = total + count_lambda_sites_scoped(expr = val, shadow_names = shadow_names, bound = bound)
    i = i + 1
  }
  total
}

fn count_lambda_sites_arms(arms: Array[(Pat, Expr)], shadow_names: Array[String], bound: Array[String]) -> Int {
  let n = Array::length(arms)
  let mut i = 0
  let mut total = 0
  while i < n {
    let (pat, body) = Array::get(arms, at = i)
    let mark = Array::length(bound)
    collect_pattern_bindings(pat = pat, bindings = bound)
    total = total + count_lambda_sites_scoped(expr = body, shadow_names = shadow_names, bound = bound)
    Array::truncate(bound, length = mark)
    i = i + 1
  }
  total
}

/// #729/#730 + #1262: the `Fs::readdir` surface, as ordinary AST.
///
/// The host import (`vibe.fs_read_dir_nul`) returns the entry names
/// NUL-joined as ONE packed string (the same ABI as `fs_read_file` -- no
/// host-side array building, RC/bump agnostic). Turning that into
/// `Array[String]` is a source-level rewrite, not codegen, so BOTH lanes want
/// the identical expression and neither should spell it out again: the linear
/// lane had this inline, and reproducing it in the gc lane is exactly the
/// two-copies-that-drift shape #1809 was about.
///
/// Three details are load-bearing:
///
///   - the separator is NUL, never "\n" (#2957). A POSIX file name may contain
///     a newline but never a NUL byte, so NUL is the only byte whose split
///     cannot manufacture fake entries. The host side of the pair is
///     `fs_read_dir_nul` in both runners; `fs_read_dir` is the "\n" framing
///     kept for modules built before #2957 and must not be targeted here.
///   - the length guard. An empty directory gives "", and `String::split("", d)`
///     is `[""]`, not `[]` -- so the empty case has to be built separately.
///     `Array::slice(x, 0, 0)` is how an empty array is spelled here.
///   - `String::from_char_code(0)` rather than a literal. A synthesized
///     `EString` is not in the string table (same constraint as
///     `double_to_string_expr`), so it cannot be emitted as a constant.
export fn packed_dir_entries_to_array_expr(raw_call: Expr, tmp_name: String) -> Expr {
  let separator = ECall(EIdent("String::from_char_code", -1), [EInt(0)], -1, [])
  ELet(tmp_name, raw_call, EIf(EBinOp("==", ECall(EIdent("String::length", -1), [
    EIdent(tmp_name, -1)
  ], -1, []), EInt(0), -1), ECall(EIdent("Array::slice", -1), [
    EArray([separator]),
    EInt(0),
    EInt(0)
  ], -1, []), ECall(EIdent("String::split", -1), [
    EIdent(tmp_name, -1),
    separator
  ], -1, [])), -1)
}

/// ADR-0090 (#1262): the region copy-out exits, shared by both backends.
///
/// `MutList::freeze` / `MutList::to_array` must COPY, not alias. Two reasons,
/// and the second is the one that bites: an alias would observe later pushes,
/// and with an arena the region release would leave the escaping value
/// dangling. `Array::slice(tmp, 0, Array::length(tmp))` allocates through the
/// ordinary main-heap path, so the escaping array never points into region
/// storage.
///
/// The value is bound to a temp first so an effectful argument is evaluated
/// once -- `f()` in `MutList::to_array(f())` must not run twice.
export fn region_array_value_copy(value: Expr, tmp: String) -> Expr {
  ELet(tmp, value, ECall(EIdent("Array::slice", -1), [
    EIdent(tmp, -1),
    EInt(0),
    ECall(EIdent("Array::length", -1), [EIdent(tmp, -1)], -1, [])
  ], -1, []), -1)
}

/// `MutBytes::to_bytes(mb)` -- the same exit for the Bytes half, for the same
/// two reasons (an alias observes later pushes; with an arena the release
/// dangles it). `Bytes::slice` allocates through `Bytes::new`, which is always
/// a main-heap bump, so the escaping value never points into region storage.
export fn region_mutbytes_exit_copy(_ arg: Expr) -> Expr {
  let tmp = "__mutbytes_exit"
  ELet(tmp, arg, ECall(EIdent("Bytes::slice", -1), [
    EIdent(tmp, -1),
    EInt(0),
    ECall(EIdent("Bytes::length", -1), [EIdent(tmp, -1)], -1, [])
  ], -1, []), -1)
}

export fn region_mutlist_exit_copy(_ arg: Expr) -> Expr {
  region_array_value_copy(value = ECall(EIdent("ArrayBuilder::freeze", -1), [
    arg
  ], -1, []), tmp = "__mutlist_exit")
}

/// #2158: names of user functions whose declared return type is a float.
///
/// codegen is untyped, so a call `half(5.0)` is just an ECall; without this
/// table the syntactic floatish classifiers cannot tell it from an Int-valued
/// call and `__to_string` falls through to a runtime bit-pattern heuristic
/// that renders an f64 as a plausible-looking integer.
///
/// ONE copy on purpose. This started as an inline walk in wasi's pre-pass, was
/// duplicated into the gc pre-pass when the fix had to be made twice, and the
/// alias gap then had to be found in both (#2156 review). The walk is cheap
/// and the stmt list is right here in every caller.
///
/// The classification is the CHECKER's, not a name match (#2166). Each
/// declared return type goes through `resolve_type_expr_shadowed` -- the same
/// entry point `check_stmts` uses for an `STypeAlias` body -- and the answer
/// is whether that resolves to `CtDouble`. This replaced a hand-written scan
/// that compared the spelling against "Float64"/"Float32" and walked
/// zero-parameter aliases by name. Four separate special cases dissolved into
/// the resolver, three of them previously WRONG:
///
///   * a PARAMETERIZED alias -- `type Box[T] = T; fn f() -> Box[Double]` is a
///     `TyApp`, which a name-keyed table structurally cannot follow. Printed
///     384 for 2.5 (#2166). Resolution substitutes the type arguments.
///   * the spellings `f64` and `f32`, which `resolve_builtin` has always
///     unified with Double and the name scan never listed. `fn f() -> f64`
///     printed 192 for 2.5 -- measured while fixing #2166, previously unfiled.
///   * alias CHAINS -- resolution is transitive, so there is no hop walk and
///     no step bound to get wrong (an earlier bound of a flat 16 printed 176
///     for a 16-hop chain).
///   * a type PARAMETER shadowing an alias -- `type D = Double; fn id[D](x: D)
///     -> D` returns the variable, not a float. That is the `shadow` argument,
///     which is what it is for; it needed an explicit guard before.
export fn compute_float_returning_names(_ stmts: Array[Stmt]) -> Array[String] {
  let strict_defs = collect_alias_type_defs(stmts)
  let loose_defs = collect_alias_type_defs_loose(stmts)
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, value) =>
      match value {
        EFn(tparams, _, _, ret, _, fbody) =>
        match ret {
          Some(rt) => match resolve_type_expr_core_shadowed(te = rt, defs = strict_defs, shadow = tparams) {
            CtDouble => Array::push(out, value = name),
            // #3543: a `Float` is an f64 at run time too.
            CtFloat => Array::push(out, value = name),
            // The checker could not see through this annotation -- a type
            // variable, or an alias applying one declared later -- so it
            // accepts an Int body and a Double body alike. If the annotation
            // WOULD reach Double once the ordering restriction is lifted, a
            // Double is what it almost always is; classify it, and step back
            // only for a body that is PROVABLY an Int.
            CtNamed(_, _) => match resolve_type_expr_core_shadowed(te = rt, defs = loose_defs, shadow = tparams) {
              CtDouble => if body_is_definitely_int(fbody) {
                ()
              } else {
                Array::push(out, value = name)
              },
              CtFloat => if body_is_definitely_int(fbody) {
                ()
              } else {
                Array::push(out, value = name)
              },
              _ => ()
            },
            _ => ()
          },
          None => ()
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Is this body PROVABLY an Int?
///
/// Used in one place: an annotation the checker could not resolve, which it
/// therefore accepts with either an Int or a Double body. Those need opposite
/// renderings and the annotation cannot choose, so something else must.
///
/// The direction matters more than the coverage, and this is the second design
/// here. The first asked "is the body provably a FLOAT?" and classified only
/// when it could tell -- which made every body shape it did not recognize
/// answer "not a float". Since such an annotation almost always does denote a
/// Double, that turned each unrecognized shape into a WRONG answer, and review
/// found them one after another: a call, a `return`, a `match` with all-float
/// arms, a value read back out of a `let`. Six rounds, each a regression
/// against what `main` already rendered correctly.
///
/// Asking the opposite question inverts that property. An unrecognized body
/// keeps the classification the annotation implies -- which is what `main`
/// does today -- so a shape this cannot see is never a regression, only a
/// missed improvement. Only a body it can PROVE returns an Int steps back, and
/// that proof is deliberately narrow: integer literals and arithmetic over
/// them, through the block forms to the tail, both arms of an `if`, and
/// through `return`. A call is NOT proof -- the callee's return type is not
/// visible here, and guessing was the previous design's mistake.
///
/// This is why there is no shadow set any more: nothing here consults a name,
/// so no binder can mask anything, and the "you did not carry the local
/// bindings / the parameters" class of bug cannot arise.
fn body_is_definitely_int(_ e: Expr) -> Bool {
  tail_is_definitely_int(e) && all_returns_definitely_int(e)
}

/// The value the body FALLS OUT of -- its tail expression.
fn tail_is_definitely_int(_ e: Expr) -> Bool {
  match e {
    EInt(_) => true,
    EBinOp(op, l, r, _) => (op == "+" || op == "-" || op == "*" || op == "/" || op == "%") && tail_is_definitely_int(l) && tail_is_definitely_int(r),
    // `~` is Int by construction (a bit pattern), so it is provably Int with
    // no condition on its operand; `-` may be a float negation, so it stays
    // conditional (#2344).
    EUnaryOp(op, x) => op == "~" || (op == "-" && tail_is_definitely_int(x)),
    ESeq(_, b) => tail_is_definitely_int(b),
    ELet(_, _, b, _) => tail_is_definitely_int(b),
    ELetRec(_, _, b) => tail_is_definitely_int(b),
    ELetMut(_, _, b, _) => tail_is_definitely_int(b),
    EIf(_, t, f) => tail_is_definitely_int(t) && tail_is_definitely_int(f),
    EReturn(x) => tail_is_definitely_int(x),
    _ => false
  }
}

/// Every `return` ANYWHERE in the body returns a provably-Int value.
///
/// The tail is not the only way out. `if flag { return 2.5 } else { return 3.5 }
/// ; 1` falls out of an Int literal that is not even reachable, and reading
/// only the tail declared it definitely-Int -- so the Double it actually
/// returns rendered through the non-float path, on both lanes (#2185 review).
///
/// The walk descends via `expr_children` rather than a per-constructor match,
/// and that is deliberate: this predicate is only sound if it finds EVERY
/// `return`, and an enumeration that silently misses a form fails in the
/// dangerous direction. Enumerating constructors one at a time is what the
/// previous design of this file did, six review rounds running.
///
/// A nested `EFn` is where the recursion stops -- a lambda's `return` belongs
/// to the lambda, not to the function being classified.
fn all_returns_definitely_int(_ e: Expr) -> Bool {
  match e {
    EFn(_, _, _, _, _, _) => true,
    EReturn(x) => tail_is_definitely_int(x) && all_returns_definitely_int(x),
    _ => {
      let kids = expr_children(e)
      let mut i = 0
      let mut ok = true
      while i < Array::length(kids) {
        if !all_returns_definitely_int(Array::get(kids, at = i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    }
  }
}

/// The type table `compute_float_returning_names` resolves against.
///
/// It mirrors what `check_stmts` has in `defs` when it resolves a return
/// annotation, in two respects that both matter for the answer:
///
/// (1) NOMINAL PRECEDENCE. `preclaim_local_type_defs` pushes an enum/struct
/// placeholder for every declaration before any alias is resolved, and
/// `find_typedef` is first-match-wins, so a name declared as BOTH a struct and
/// an alias resolves to the struct. Collecting aliases alone would pick the
/// alias and could classify a struct-returning function as float-returning
/// (#2177 review). Placeholders are therefore pushed first, in statement
/// order, exactly as the checker pushes them.
///
/// (2) ORDER INDEPENDENCE for the aliases themselves -- and here it
/// deliberately differs from `check_stmts`, which does NOT pre-claim an
/// `STypeAlias` (a placeholder alias body would be a lie: an alias resolves
/// THROUGH to its target, so an empty placeholder would silently retarget
/// every early reference). A forward reference to a later alias stays
/// unresolved there. codegen must not inherit that: measured before the
/// change, `fn f() -> Later { 2.5 }` above `type Later = Double` compiles and
/// renders 2.5 today, and answering "not a float" for it would be a
/// silent-wrong regression -- the exact class this table exists to close.
///
/// The order independence stops at an APPLICATION, and that boundary is not a
/// nicety: `type A = B[Double]` above `type B[T] = T` is stored by the checker
/// as the UNRESOLVED `CtNamed("B", [CtDouble])`, which is why it accepts
/// `fn f() -> A { 1 }` at all. A table that resolves `A` to `CtDouble` anyway
/// records `f` as float-returning and renders the tagged Int 1 as f64 bits --
/// `__to_string(f())` printed 0 (#2177 review, measured; the pre-#2177 scan and
/// the committed seed both print 1). Out-resolving the checker is not a
/// harmless over-approximation: it silently retypes a program the checker
/// accepted on the strength of NOT knowing.
///
/// A bare name keeps the order-independent view, because there the two agree
/// on what matters: `type X = Y` above `type Y = Double` renders 2.5 on every
/// compiler measured, and the checker's own tolerance is what lets it.
///
/// So alias bodies are re-resolved until the table stops changing, capped at
/// `n + 1` passes: a chain that never revisits an alias is at most `n` long,
/// so that is the acyclic maximum, and a cycle stops changing on its own. The
/// early exit is what keeps the common case cheap -- with no forward
/// reference the table is stable after the first pass and the second one ends
/// it, instead of running all `n + 1` (#2177 review). Measured: the flat
/// module source the compiler actually compiles has 5 aliases.
/// The same table WITHOUT the checker's ordering restriction: an application
/// in an alias body resolves against every alias, not only earlier ones.
///
/// This is deliberately NOT what the checker sees, and it is not used to
/// decide anything on its own. Its one job is to answer "would this annotation
/// reach Double if the ordering restriction were lifted?" -- i.e. to tell an
/// annotation that is merely ORDER-blocked from one that names something else
/// entirely. The first denotes a Double in every case anyone writes; the
/// second does not.
fn collect_alias_type_defs_loose(_ stmts: Array[Stmt]) -> Array[TypeDef] {
  let nominal: Array[TypeDef] = []
  let alias_names: Array[String] = []
  let alias_params: Array[Array[String]] = []
  let alias_targets: Array[TypeExpr] = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SEnum(_, ename, eparams, _, _) => Array::push(nominal, value = TDEnum(ename, eparams, array_empty())),
      SSuberror(_, sname, _) => Array::push(nominal, value = TDEnum(sname, array_empty(), array_empty())),
      SStruct(_, stname, _, _, mut_fields, tparams) => Array::push(nominal, value = TDStruct(stname, array_empty(), mut_fields, tparams)),
      STypeAlias(_, aname, aparams, atarget) => {
        Array::push(alias_names, value = aname)
        Array::push(alias_params, value = aparams)
        Array::push(alias_targets, value = atarget)
      },
      _ => ()
    }
    i = i + 1
  }
  let n = Array::length(alias_names)
  let mut defs = nominal
  let mut prev = ""
  let mut pass = 0
  let mut done = false
  while !done {
    let next: Array[TypeDef] = []
    let mut k = 0
    while k < Array::length(nominal) {
      Array::push(next, value = Array::get(nominal, at = k))
      k = k + 1
    }
    let mut sig = ""
    let mut j = 0
    while j < n {
      let ps = Array::get(alias_params, at = j)
      let target = Array::get(alias_targets, at = j)
      // An APPLICATION in an alias body sees only earlier declarations, which
      // is what `next` holds right now (the nominals plus aliases 0..j-1).
      // Resolving it against the whole table out-resolves the checker and
      // silently retypes a checker-accepted program -- see the doc comment.
      let resolved = resolve_type_expr_core_shadowed(te = target, defs = defs, shadow = ps)
      Array::push(next, value = TDAlias(Array::get(alias_names, at = j), ps, resolved))
      sig = String::concat(sig, String::concat(type_to_string(resolved), " |#| "))
      j = j + 1
    }
    defs = next
    pass = pass + 1
    if sig == prev || pass > n {
      done = true
    } else {
      prev = sig
    }
  }
  defs
}

fn collect_alias_type_defs(_ stmts: Array[Stmt]) -> Array[TypeDef] {
  let nominal: Array[TypeDef] = []
  let alias_names: Array[String] = []
  let alias_params: Array[Array[String]] = []
  let alias_targets: Array[TypeExpr] = []
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SEnum(_, ename, eparams, _, _) => Array::push(nominal, value = TDEnum(ename, eparams, array_empty())),
      SSuberror(_, sname, _) => Array::push(nominal, value = TDEnum(sname, array_empty(), array_empty())),
      SStruct(_, stname, _, _, mut_fields, tparams) => Array::push(nominal, value = TDStruct(stname, array_empty(), mut_fields, tparams)),
      STypeAlias(_, aname, aparams, atarget) => {
        Array::push(alias_names, value = aname)
        Array::push(alias_params, value = aparams)
        Array::push(alias_targets, value = atarget)
      },
      _ => ()
    }
    i = i + 1
  }
  let n = Array::length(alias_names)
  let mut defs = nominal
  let mut prev = ""
  let mut pass = 0
  let mut done = false
  while !done {
    let next: Array[TypeDef] = []
    let mut k = 0
    while k < Array::length(nominal) {
      Array::push(next, value = Array::get(nominal, at = k))
      k = k + 1
    }
    let mut sig = ""
    let mut j = 0
    while j < n {
      let ps = Array::get(alias_params, at = j)
      let target = Array::get(alias_targets, at = j)
      // An APPLICATION in an alias body sees only earlier declarations, which
      // is what `next` holds right now (the nominals plus aliases 0..j-1).
      // Resolving it against the whole table out-resolves the checker and
      // silently retypes a checker-accepted program -- see the doc comment.
      let scope = match target {
        TyApp(_, _) => next,
        _ => defs
      }
      let resolved = resolve_type_expr_core_shadowed(te = target, defs = scope, shadow = ps)
      Array::push(next, value = TDAlias(Array::get(alias_names, at = j), ps, resolved))
      sig = String::concat(sig, String::concat(type_to_string(resolved), " |#| "))
      j = j + 1
    }
    defs = next
    pass = pass + 1
    if sig == prev || pass > n {
      done = true
    } else {
      prev = sig
    }
  }
  defs
}

/// An if / match / handle value: its result is one of several arm tails.
///
/// ONE predicate for the codegen and the Perceus plan (#3114 review). Codegen
/// owns such a `let` by retaining its borrowed arm tails (#768 / #3103) only
/// while the binding keeps its planned scope-end drop, and the plan keeps
/// that drop when the binding is aliased. The plan's own copy listed `if` and
/// `match` and missed `handle`, so a `handle` source aliased as its last use
/// handed its reference to the alias and lost the drop the retain was keyed
/// on. Both sides now ask this function.
export fn is_branching_value(_ value: Expr) -> Bool {
  match value {
    EIf(_, _, _) => true,
    EMatch(_, _) => true,
    EHandle(_, _) => true,
    _ => false
  }
}
