let op_i64_extend_i32_u = 173

//# Functions

fn common_analysis_fresh_string_array() -> Array[String] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

/// Collect string literals appearing anywhere in a pattern, including inside
/// constructor / tuple / or / struct sub-patterns. #603: codegen now tests a
/// `PString` sub-pattern of a `PCtor`, so its literal must be registered in the
/// string table (previously only top-level `PString` arms were collected).
fn collect_strings_pat(pat: Pat, out: Array[String]) -> Int {
  match pat {
    PString(s) => {
      let mut pf = false
      let mut pi = 0
      while pi < Array::length(out) {
        if Array::get(out, pi) == s {
          pf = true
        }
        pi = pi + 1
      }
      if !pf {
        Array::push(out, s)
      }
      0
    },
    PCtor(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        let _ = collect_strings_pat(Array::get(args, i), out)
        i = i + 1
      }
      0
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        let _ = collect_strings_pat(Array::get(pats, i), out)
        i = i + 1
      }
      0
    },
    POr(l, r) => {
      let _ = collect_strings_pat(l, out)
      let _ = collect_strings_pat(r, out)
      0
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        let _ = collect_strings_pat(fp, out)
        i = i + 1
      }
      0
    },
    _ => 0
  }
}

export fn collect_strings_expr(expr: Expr, out: Array[String]) -> Int {
  match expr {
    EString(s) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(out) {
        if Array::get(out, i) == s {
          found = true
        }
        i = i + 1
      }
      if !found {
        Array::push(out, s)
      }
      0
    },
    EBinOp(_, lhs, rhs) => {
      collect_strings_expr(lhs, out)
      collect_strings_expr(rhs, out)
    },
    EUnaryOp(_, operand) => collect_strings_expr(operand, out),
    EIf(cond, then_e, else_e) => {
      collect_strings_expr(cond, out)
      collect_strings_expr(then_e, out)
      collect_strings_expr(else_e, out)
    },
    ECall(callee, args, _) => {
      collect_strings_expr(callee, out)
      // #784: the bool→string codegen path (compile_call.vibe) synthesizes
      // `if b { "true" } else { "false" }` for a statically-boolean `__to_string`
      // arg. Those EString nodes are created during codegen — AFTER this
      // collection pass — so their literals are otherwise absent from the string
      // table (`string not in table: true`, Codex #785 review, P1). Seed them
      // whenever `__to_string` is called. Over-approximates (also seeds for a
      // purely-integer `__to_string`), which is harmless: two small interned
      // strings.
      match callee {
        EIdent(nm, _) => if nm == "__to_string" {
          collect_strings_expr(EString("true"), out)
          collect_strings_expr(EString("false"), out)
        } else {
          0
        },
        _ => 0
      }
      let mut i = 0
      while i < Array::length(args) {
        collect_strings_expr(Array::get(args, i), out)
        i = i + 1
      }
      0
    },
    ELet(_, value, body, _) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ELetRec(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ELetMut(_, value, body, _) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    EAssign(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    EAssignOp(_, _, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ESeq(first, second) => {
      collect_strings_expr(first, out)
      collect_strings_expr(second, out)
    },
    EWhile(cond, body) => {
      collect_strings_expr(cond, out)
      collect_strings_expr(body, out)
    },
    EForIn(_, _, iter_e, body) => {
      collect_strings_expr(iter_e, out)
      collect_strings_expr(body, out)
    },
    ETuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        collect_strings_expr(Array::get(elems, i), out)
        i = i + 1
      }
      0
    },
    EArray(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        collect_strings_expr(Array::get(elems, i), out)
        i = i + 1
      }
      0
    },
    EMatch(scrutinee, arms) => {
      collect_strings_expr(scrutinee, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, arm_expr) = Array::get(arms, i)
        let _ = collect_strings_pat(pat, out)
        collect_strings_expr(arm_expr, out)
        i = i + 1
      }
      0
    },
    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),
    EReturn(msg) => collect_strings_expr(msg, out),
    EStringInterp(parts) => {
      let mut si_p = 0
      while si_p < Array::length(parts) {
        if si_p % 2 == 0 {
          let part = Array::get(parts, si_p)
          if String::length(part) > 0 {
            let mut found = false
            let mut fi2 = 0
            while fi2 < Array::length(out) {
              if Array::get(out, fi2) == part {
                found = true
              }
              fi2 = fi2 + 1
            }
            if !found {
              Array::push(out, part)
            }
          }
        }
        si_p = si_p + 1
      }
      0
    },
    EHandle(body, arms) => {
      collect_strings_expr(body, out)
      let mut hi = 0
      while hi < Array::length(arms) {
        let (_, arm_expr) = Array::get(arms, hi)
        collect_strings_expr(arm_expr, out)
        hi = hi + 1
      }
      0
    },
    EMap(fields) => {
      let mut mi = 0
      while mi < Array::length(fields) {
        let (key, val) = Array::get(fields, mi)
        let mut kf = false
        let mut ki = 0
        while ki < Array::length(out) {
          if Array::get(out, ki) == key {
            kf = true
          }
          ki = ki + 1
        }
        if !kf {
          Array::push(out, key)
        }
        collect_strings_expr(val, out)
        mi = mi + 1
      }
      0
    },
    ERecord(_, fields, _) => {
      let mut ri = 0
      while ri < Array::length(fields) {
        let (_, fval) = Array::get(fields, ri)
        collect_strings_expr(fval, out)
        ri = ri + 1
      }
      0
    },
    EDot(obj, _, _, _) => collect_strings_expr(obj, out),
    ELabeledArg(_, _, val) => collect_strings_expr(val, out),
    _ => 0
  }
}

/// Extract function param names from SLet(_, _, _, _, EFn(_, _, params, _, _, _))
export fn get_func_param_names(stmt: Stmt) -> Array[String] with Exception {
  match stmt {
    SLet(_, _, _, _, expr) => match expr {
      EFn(_, _, params, _, _, _) => {
        let names = common_analysis_fresh_string_array()
        let mut i = 0
        while i < Array::length(params) {
          let (pname, _) = Array::get(params, i)
          // Strip labeled/optional markers from param names
          let plen2 = String::length(pname)
          let clean_name = if plen2 > 0 {
            let last_char = String::char_code_at(pname, plen2 - 1)
            if last_char == '~' || last_char == '?' {
              pname[0: plen2 - 1]
            } else pname
          } else pname
          Array::push(names, clean_name)
          i = i + 1
        }
        names
      },
      _ => throw("get_func_param_names: not a function")
    },
    _ => throw("get_func_param_names: not a let statement")
  }
}

/// #721: does the program reference the exception machinery anywhere? EThrow
/// compiles to `throw 2`, EHandle to try_table over tags 0-3, and effect op
/// performs to `throw <eff_tag>` (guarded separately by the effect declaration
/// list). When NONE of these appear, the tag section and the "error" tag
/// export can be omitted entirely -- V8 runs exnref-bearing modules on a
/// slower path, costing pure-compute code ~35% (fib(38): 0.32s with tags vs
/// 0.20s without; wasmtime shows parity, so it is engine behavior, not
/// codegen). Conservative: any EThrow/EHandle at ANY nesting depth counts.
export fn expr_contains_exceptions(expr: Expr) -> Bool {
  match expr {
    EHandle(_, _) => true,
    EBinOp(_, lhs, rhs) => expr_contains_exceptions(lhs) || expr_contains_exceptions(rhs),
    EUnaryOp(_, operand) => expr_contains_exceptions(operand),
    EIf(cond, then_e, else_e) =>
    expr_contains_exceptions(cond) || expr_contains_exceptions(then_e) || expr_contains_exceptions(else_e),
    ECall(callee, args, _) => {
      // A bare `resume(..)` call compiles to `throw 1` (continuation resume)
      // even without a surrounding EHandle in this expression -- a resume
      // misused outside a handler must still produce a VALID module. A user
      // function actually named `resume` merely keeps the tags (harmless
      // over-approximation).
      //
      // #774: `perform Eff::Op(..)` compiles to `throw <eff_tag>`
      // (compile_call.vibe) EVEN WHEN the enclosing file declares no
      // `effect Eff { .. }` of its own (e.g. lib/@vibe/http/http.vibe /
      // lib/@vibe/socket/tcp.vibe perform `Http::*`/`Socket::*` ops whose
      // names never appear as an `SEffectDef` in the compiled unit) --
      // `effect_name_to_tag` falls back to a sentinel tag index in that
      // case. Missing "perform" here (like "resume") made `uses_exceptions`
      // false whenever a compiled unit's ONLY exception-shaped construct was
      // an un-declared-effect `perform` with no `handle`/`throw` anywhere
      // else, so the tag section was omitted -- and the emitted `throw
      // <eff_tag>` then referenced a tag index that plain does not exist,
      // failing wasm validation ("Invalid tag index: N") the moment the
      // function's body is compiled, whether or not it is ever called.
      let mut found = match callee {
        EIdent(cname, _) => cname == "resume" || cname == "perform",
        _ => expr_contains_exceptions(callee)
      }
      let mut i = 0
      while i < Array::length(args) {
        if expr_contains_exceptions(Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ELet(_, value, body, _) => expr_contains_exceptions(value) || expr_contains_exceptions(body),
    ELetRec(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),
    ELetMut(_, value, body, _) => expr_contains_exceptions(value) || expr_contains_exceptions(body),
    EAssign(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),
    EAssignOp(_, _, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),
    ESeq(first, second) => expr_contains_exceptions(first) || expr_contains_exceptions(second),
    EWhile(cond, body) => expr_contains_exceptions(cond) || expr_contains_exceptions(body),
    EForIn(_, _, iter_e, body) => expr_contains_exceptions(iter_e) || expr_contains_exceptions(body),
    ELoop(params, body) => {
      let mut i = 0
      let mut found = expr_contains_exceptions(body)
      while i < Array::length(params) {
        let (_, iv) = Array::get(params, i)
        if expr_contains_exceptions(iv) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EMatch(scrut, arms) => {
      let mut i = 0
      let mut found = expr_contains_exceptions(scrut)
      while i < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, i)
        if expr_contains_exceptions(arm_body) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EFn(_, _, _, _, _, body) => expr_contains_exceptions(body),
    ETuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if expr_contains_exceptions(Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EArray(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if expr_contains_exceptions(Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        if expr_contains_exceptions(fval) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EMap(fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        if expr_contains_exceptions(fval) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EDot(obj, _, _, _) => expr_contains_exceptions(obj),
    ELabeledArg(_, _, inner) => expr_contains_exceptions(inner),
    EReturn(inner) => expr_contains_exceptions(inner),
    ESpread(inner) => expr_contains_exceptions(inner),
    EBreak(opt) => match opt {
      Some(inner) => expr_contains_exceptions(inner),
      None => false
    },
    EContinue(args) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if expr_contains_exceptions(Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EInt(_) => false,
    EFloat(_) => false,
    EString(_) => false,
    EBool(_) => false,
    EIdent(_, _) => false,
    EStringInterp(_) => false,
    EUnit => false
  }
}

export fn stmts_contain_exceptions(stmts: Array[Stmt]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => if expr_contains_exceptions(expr) {
        found = true
      } else {
        ()
      },
      SLetMut(_, _, expr) => if expr_contains_exceptions(expr) {
        found = true
      } else {
        ()
      },
      SLetPat(_, expr) => if expr_contains_exceptions(expr) {
        found = true
      } else {
        ()
      },
      SExpr(expr) => if expr_contains_exceptions(expr) {
        found = true
      } else {
        ()
      },
      STest(_, expr) => if expr_contains_exceptions(expr) {
        found = true
      } else {
        ()
      },
      SBench(_, expr) => if expr_contains_exceptions(expr) {
        found = true
      } else {
        ()
      },
      SModule(_, _, inner) => if stmts_contain_exceptions(inner) {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

export fn collect_strings_stmts(stmts: Array[Stmt]) -> Array[String] {
  let out = common_analysis_fresh_string_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),
      _ => 0
    }
    i = i + 1
  }
  out
}

export fn emit_i64_extend_i32_u(buf: Bytes) -> Unit {
  bytebuf_push(buf, op_i64_extend_i32_u)
}

/// Resolve closure/fn value tag and fill slot_local/env_local
/// After this: slot_local = table slot index, env_local = env pointer (0 for bare fn)
export fn emit_closure_resolve(buf: Bytes, fn_val_local: Int, slot_local: Int, env_local: Int) -> Unit {
  emit_local_get(buf, fn_val_local)
  emit_i64_const(buf, 3)
  emit_i64_and(buf)
  emit_i64_const(buf, 2)
  emit_i64_eq(buf)
  emit_if_void(buf)
  // Bare fn: table_slot = fn_val >> 2, env = 0
  emit_local_get(buf, fn_val_local)
  emit_i64_const(buf, 2)
  emit_i64_shr_s(buf)
  emit_local_set(buf, slot_local)
  emit_i64_const(buf, 0)
  emit_local_set(buf, env_local)
  emit_else(buf)
  // Closure: env = fn_val & ~3, slot = i32.load(env, 0)
  emit_local_get(buf, fn_val_local)
  emit_i64_const(buf, -4)
  emit_i64_and(buf)
  emit_local_set(buf, env_local)
  emit_local_get(buf, env_local)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf, 2, 0)
  emit_i64_extend_i32_u(buf)
  emit_local_set(buf, slot_local)
  emit_end(buf)
}

/// Emit the tail of an indirect closure call (push env, push slot, call_indirect)
export fn emit_closure_call_tail(buf: Bytes, env_local: Int, slot_local: Int, closure_type_base: Int, num_args: Int) -> Unit {
  emit_local_get(buf, env_local)
  emit_local_get(buf, slot_local)
  emit_i32_wrap_i64(buf)
  emit_call_indirect(buf, closure_type_base + num_args)
}

fn collect_pattern_bindings(pat: Pat, bindings: Array[String]) -> Int {
  match pat {
    PBind(name) => {
      Array::push(bindings, name); 0
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        collect_pattern_bindings(Array::get(pats, i), bindings)
        i = i + 1
      }
      0
    },
    PCtor(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        collect_pattern_bindings(Array::get(args, i), bindings)
        i = i + 1
      }
      0
    },
    POr(l, r) => {
      collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fpat) = Array::get(fields, i)
        collect_pattern_bindings(fpat, bindings)
        i = i + 1
      }
      0
    },
    _ => 0
  }
}

/// Inlined async builtins (docs/spec/wasi-p3-async.md) are lowered directly by
/// compile_call rather than living in the func table, so — like operators — they
/// must never be treated as free variables when they appear inside a nested
/// lambda body. Otherwise a thunk such as `() -> { Task::join(t) }` would capture
/// `Task::join` as a closure value and mis-lower the call as an indirect apply.
fn is_inlined_async_builtin(name: String) -> Bool {
  // Every name here is lowered INLINE by compile_call.vibe and has NO func
  // table entry, so the free-var collector below must not record it as a
  // capturable free variable (the capture becomes a call_indirect of a
  // nonexistent closure value -- an invalid-signature-index module or a
  // "null function" trap, see the #773 story in the doc comment further
  // down). Keep this in sync with compile_call's
  // `!prefer_bound_call && fname == "..."` dispatch: a builtin added there
  // that is neither func-table-registered (like Array::set) nor listed
  // here reintroduces the bug for closures. Future::pending/resolve
  // (#1230) and Path::to_string/is_absolute were exactly such omissions --
  // each reproduced as a one-closure miscompile before being added
  // (#1218 D1 increment 4 follow-up).
  // #1348: `Path::ref` / `Path::resolve` are now listed. They were held out
  // because listing them regressed TOP-LEVEL
  // `Path::is_absolute(Path::resolve(..))` to a trap "through a mechanism not
  // yet understood" -- that mechanism is now understood and fixed at its
  // source: the USED-BUILTIN scan shared this walk and therefore this skip, so
  // listing a name here also erased it from the used-builtin set and the
  // `resolve_path` host import these two lower to was never reserved. The
  // scan now runs with the skip off (collect_free_vars_used_builtins), which
  // is why they can finally be listed. The other names hid the conflict only
  // because none of them reserves an import.
  //
  // NOT here, measured 2026-08-01 (#1218), do not add without a full battery
  // + Path-shape matrix: the bare `path` builtin. A bare snake_case name
  // collides with ordinary local bindings, and listing it corrupted the
  // SELF-COMPILE (stage2 miscompiled every Path-touching program, including
  // straight-line top-level code). That is a DIFFERENT failure from the one
  // fixed here -- shadowing, not import gating -- and `encl` (#1114) is the
  // machinery that would have to cover it.
  name == "await" || name == "Future::ready" || name == "Future::pending" || name == "Future::resolve" || name == "Stream::next" || name == "String::to_bytes" || name == "Stream::to_string" || name == "Path::to_string" || name == "Path::is_absolute" || name == "Path::ref" || name == "Path::resolve" || name == "host_future_get" || name == "host_future_named" || name == "host_stream_named" || name == "host_stream_next" || name == "host_stream_close"
}

/// #773: the scalar arithmetic/logic intrinsics ("not"/"add"/"sub"/"mul"/"lt")
/// are, like the async builtins above, lowered INLINE by compile_call.vibe
/// (`!prefer_bound_call && fname == "not"` etc.) rather than living in the func
/// table -- UNLESS a user top-level function of the same bare name shadows them,
/// in which case they're already present in `fn_names` (ctx.func_table.names)
/// and excluded by the check above. ("eq"/"Array::length"/"Bytes::length"/
/// "String::length" are unconditionally registered in the func table for every
/// compile, so they never reach this fallback and need no entry here.)
///
/// Before this fix, a closure/lambda literal that referenced one of these bare
/// names as a call callee (e.g. `(b: Bool) -> Bool { not(b) }`) — and did NOT
/// shadow it with a same-named top-level function — fell through to the `else`
/// branch below and was wrongly recorded as a FREE VARIABLE to capture from the
/// enclosing scope. compile_lambda.vibe then allocated a captured-env slot named
/// "not" and, back in compile_call.vibe, `local_idx_hint` found "not" among the
/// closure's own `local_names` (the just-added capture), forcing
/// `prefer_bound_call = true` -- i.e. treating the wrongly captured (and
/// nonexistent-in-the-enclosing-scope) "not" value as a closure to invoke via
/// `call_indirect`. That corrupted the closure's environment and crashed with
/// "unreachable" / "null function or function signature mismatch" at runtime
/// (reported against @vibex/quickcheck's check_int/check_bool + is_ok, whose
/// property closures call `not(...)`).
///
/// #1095: "assert" has the identical `!prefer_bound_call && fname == "assert"`
/// inline-lowering gate in compile_call.vibe, and hit the same bug: a closure
/// body calling bare `assert(...)` got it wrongly captured as a free variable,
/// so `assert(false)` inside a lambda crashed with "null function or function
/// signature mismatch" instead of the expected "unreachable" trap that the
/// same code produces at top level.
fn is_inlined_scalar_builtin(name: String) -> Bool {
  name == "not" || name == "add" || name == "sub" || name == "mul" || name == "lt" || name == "assert" || name == "Double::from_i64_bits"
}

/// A namespaced source alias recognized by the builtin registry resolves
/// globally, just like its canonical spelling. An unchanged canonical name is
/// accepted only when an actual top-level function provides it.
/// Namespaced spellings cannot be local binders, so this cannot hide a real
/// capture. The exact-name lookup remains first and keeps user/global shadows
/// authoritative.
fn canonical_builtin_resolves_globally(name: String, fn_names: Array[String]) -> Bool {
  if String::contains(name, "::") {
    let canonical = canonical_builtin_name(name)
    canonical != name || bsearch_leftmost(fn_names, canonical) >= 0
  } else {
    false
  }
}

/// #1348: the SIMD intrinsics (`lib/@vibex/simd`) are inline-dispatched by
/// compile_call exactly like the scalar ones above and were never registered
/// here -- a lambda calling `v128_load(..)` produced an INVALID MODULE
/// ("invalid signature index"), not merely a runtime trap. Found by
/// scripts/check_inline_builtin_capture.sh rather than by a user crash, which
/// is the point of that script: the same registration gap had already been
/// reintroduced four times (#773, #1095, #1230, #1218) and each time it was a
/// crash report that surfaced it.
fn is_inlined_simd_builtin(name: String) -> Bool {
  name == "v128_load" || name == "v128_store" || name == "v128_not" || name == "v128_and" || name == "v128_or" || name == "v128_any_true" || name == "v128_all_true_i8x16" || name == "v128_bitmask_i8x16" || name == "v128_splat_i8x16" || name == "v128_eq_i8x16" || name == "v128_le_u_i8x16" || name == "v128_ge_u_i8x16"
}

/// Stack-based free variable analysis: uses in-place push/truncate on bound array
/// to avoid O(n) array copies at every scope boundary. This dramatically reduces
/// heap allocation during meta-circular self-compilation.
/// #799 perf: `fn_names` is a MEMBERSHIP INDEX (Map), not an array. The flat
/// fn+ctor name table is thousands of entries in a compiler-closure compile,
/// and this walker consulted it linearly PER IDENT -- ~70% of a full compile's
/// profile was string-equality scans under this function. Callers with a hot
/// loop pass a prebuilt index (ctx.capture_name_index); the Array-taking
/// wrapper below builds one per call for small/cold callers.
/// #640 Stage 2: recognize the parse-time desugar of `throw(x)` —
/// `ECall(EIdent("perform"), [ECall(EIdent("Exception::Throw"), payload_args)])`
/// — and return its payload args. None for every other perform (or shape).
fn ca_perform_error_throw_op_args(args: Array[Expr]) -> Option[Array[Expr]] {
  if Array::length(args) == 1 {
    match Array::get(args, 0) {
      ECall(op_callee, op_args, _) => match op_callee {
        EIdent(op_name, _) => if is_exception_throw_operation(op_name) {
          Some(op_args)
        } else {
          None
        },
        _ => None
      },
      _ => None
    }
  } else {
    None
  }
}

/// #1114: the inlined-builtin skip below must also yield to a LOCAL binding
/// in an ENCLOSING scope. `bound` only ever holds the innermost lambda's own
/// binders (it is re-seeded per lambda from that lambda's parameters -- see
/// collect_free_vars_indexed), and `fn_names` only holds TOP-LEVEL names, so
/// neither can see that e.g. `fn outer(not: (Bool) -> Bool)` binds `not` for
/// a nested `() -> { not(true) }`. Without `encl` the skip fired, `not` was
/// never captured, and the call silently lowered to the BUILTIN logical-not
/// instead of invoking the parameter -- a wrong VALUE, not a crash.
/// `encl` is the enclosing compile scope's local names, threaded from
/// compile_lambda; the public wrapper passes an empty array, which reproduces
/// the previous behavior exactly for every other caller.
export fn collect_free_vars_expr(expr: Expr, bound: Array[String], fn_names: Array[String], out: Array[String]) -> Int {
  collect_free_vars_expr_sc(expr, bound, fn_names, common_analysis_fresh_string_array(), true, out)
}

fn collect_free_vars_expr_sc(expr: Expr, bound: Array[String], fn_names: Array[String], encl: Array[String], skip_inlined: Bool, out: Array[String]) -> Int {
  match expr {
    // #1203: `encl` (the enclosing scope's own locals, e.g. an outer
    // function's parameters) must be checked BEFORE `fn_names` (top-level
    // globals). Checking `fn_names` first meant a plain identifier reference
    // that is actually shadowed by an enclosing-scope local (e.g.
    // `compose(f, g) = (z) -> g(f(z))`, where `f`/`g` are compose's OWN
    // parameters) was wrongly treated as "already global, no capture needed"
    // whenever the merged program happened to also define a top-level
    // function of the same bare name (`fn f() { .. }` anywhere in the
    // linked program) -- silently dropping a real capture and corrupting
    // the closure's environment layout (wrong field count / call arity)
    // rather than raising any diagnostic.
    EIdent(name, _) => if array_contains_str(bound, name) {
      0
    }
    else if array_contains_str(encl, name) {
      if array_contains_str(out, name) {
        0
      } else {
        Array::push(out, name)
        0
      }
    }
    else if bsearch_leftmost(fn_names, name) >= 0 {
      0
    }
    else if array_contains_str(out, name) {
      0
    }
    else {
      Array::push(out, name)
      0
    },
    EInt(_) => 0,
    EBool(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EUnit => 0,
    EBinOp(_, lhs, rhs) => {
      collect_free_vars_expr_sc(lhs, bound, fn_names, encl, skip_inlined, out); collect_free_vars_expr_sc(rhs, bound, fn_names, encl, skip_inlined, out)
    },
    EUnaryOp(_, operand) => collect_free_vars_expr_sc(operand, bound, fn_names, encl, skip_inlined, out),
    EIf(cond, then_e, else_e) => {
      collect_free_vars_expr_sc(cond, bound, fn_names, encl, skip_inlined, out); collect_free_vars_expr_sc(then_e, bound, fn_names, encl, skip_inlined, out); collect_free_vars_expr_sc(else_e, bound, fn_names, encl, skip_inlined, out)
    },
    // #773/regression fix: the inlined-builtin skip only applies to a bare
    // name used as a CALL CALLEE (`sub(a, b)`), never to a plain identifier
    // reference. Checking it in the generic EIdent branch above would also
    // swallow a real bound-elsewhere variable that merely happens to share
    // one of these short names (e.g. a `sub: String` parameter in
    // lib/@vibe/prelude/string.vibe's string_index_of_from), wrongly
    // skipping its capture into a nested closure and crashing with
    // "undefined variable (ident)" at runtime.
    ECall(EIdent(cname, _), args, _) => if cname == "perform" {
      // #640 Stage 2: `throw(x)` parses to `perform Exception::Throw(x)`. The
      // magic `perform` callee and the `Exception::Throw` op name are keywords,
      // not capturable values — collecting them as free vars made every
      // throw-bearing LOCAL closure capture a garbage "perform" slot and
      // call through it (null call_indirect / signature mismatch at
      // runtime; the #786 perform-in-closure shape, which throw never had
      // as EThrow). Skip both and recurse into the payload only. A real
      // `perform Eff::Op(..)` keeps the historical collection verbatim
      // (those lambdas are dlh-hoisted before this analysis runs).
      match ca_perform_error_throw_op_args(args) {
        Some(op_args) => {
          let mut i = 0
          while i < Array::length(op_args) {
            collect_free_vars_expr_sc(Array::get(op_args, i), bound, fn_names, encl, skip_inlined, out)
            i = i + 1
          }
          0
        },
        None => {
          collect_free_vars_expr_sc(EIdent(cname, 0), bound, fn_names, encl, skip_inlined, out)
          let mut i = 0
          while i < Array::length(args) {
            collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, skip_inlined, out)
            i = i + 1
          }
          0
        }
      }
    } else if skip_inlined && !array_contains_str(bound, cname) && !(bsearch_leftmost(fn_names, cname) >= 0) && !array_contains_str(encl, cname) && (canonical_builtin_resolves_globally(cname, fn_names) || is_inlined_async_builtin(cname) || is_inlined_scalar_builtin(cname) || is_inlined_simd_builtin(cname)) {
      let mut i = 0
      while i < Array::length(args) {
        collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, skip_inlined, out)
        i = i + 1
      }
      0
    } else {
      collect_free_vars_expr_sc(EIdent(cname, 0), bound, fn_names, encl, skip_inlined, out)
      let mut i = 0
      while i < Array::length(args) {
        collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, skip_inlined, out)
        i = i + 1
      }
      0
    },
    ECall(callee, args, _) => {
      collect_free_vars_expr_sc(callee, bound, fn_names, encl, skip_inlined, out)
      let mut i = 0
      while i < Array::length(args) {
        collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, skip_inlined, out)
        i = i + 1
      }
      0
    },
    ELet(name, value, body, _) => {
      collect_free_vars_expr_sc(value, bound, fn_names, encl, skip_inlined, out)
      let saved = Array::length(bound)
      Array::push(bound, name)
      collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)
      Array::truncate(bound, saved)
      0
    },
    ELetRec(name, value, body) => {
      let saved = Array::length(bound)
      Array::push(bound, name)
      collect_free_vars_expr_sc(value, bound, fn_names, encl, skip_inlined, out)
      collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)
      Array::truncate(bound, saved)
      0
    },
    ELetMut(name, value, body, _) => {
      collect_free_vars_expr_sc(value, bound, fn_names, encl, skip_inlined, out)
      let saved = Array::length(bound)
      Array::push(bound, name)
      collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)
      Array::truncate(bound, saved)
      0
    },
    EAssign(name, value, body) => {
      // The assignment TARGET is a variable reference too: a lambda whose only
      // use of an outer `let mut` is `x = 1` (no read) must still capture it —
      // previously only value/body mentions were collected, so `count += 1` /
      // write-only assigns in closures failed codegen with
      // "undefined variable (local): count" (and is_mut_captured_in, which
      // rides this collector, never promoted the cell).
      // #1203 Codex review (P1): same encl-before-fn_names precedence as the
      // plain EIdent case above -- an enclosing `let mut f` reassigned only
      // via `f = ...`/`f += ...` inside the closure must still be captured
      // even when the linked program also defines an unrelated top-level
      // `fn f`.
      if array_contains_str(bound, name) {
        0
      } else if array_contains_str(encl, name) {
        if array_contains_str(out, name) {
          0
        } else {
          Array::push(out, name)
          0
        }
      } else if bsearch_leftmost(fn_names, name) >= 0 || array_contains_str(out, name) {
        0
      } else {
        Array::push(out, name)
        0
      }
      collect_free_vars_expr_sc(value, bound, fn_names, encl, skip_inlined, out); collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)
    },
    EAssignOp(name, _, value, body) => {
      if array_contains_str(bound, name) {
        0
      } else if array_contains_str(encl, name) {
        if array_contains_str(out, name) {
          0
        } else {
          Array::push(out, name)
          0
        }
      } else if bsearch_leftmost(fn_names, name) >= 0 || array_contains_str(out, name) {
        0
      } else {
        Array::push(out, name)
        0
      }
      collect_free_vars_expr_sc(value, bound, fn_names, encl, skip_inlined, out); collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)
    },
    ESeq(first, second) => {
      collect_free_vars_expr_sc(first, bound, fn_names, encl, skip_inlined, out); collect_free_vars_expr_sc(second, bound, fn_names, encl, skip_inlined, out)
    },
    EWhile(cond, body) => {
      collect_free_vars_expr_sc(cond, bound, fn_names, encl, skip_inlined, out); collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)
    },
    EForIn(var_name, index_name, iter_e, body) => {
      collect_free_vars_expr_sc(iter_e, bound, fn_names, encl, skip_inlined, out)
      let saved = Array::length(bound)
      Array::push(bound, var_name)
      match index_name {
        Some(index_name) => Array::push(bound, index_name),
        None => ()
      }
      collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)
      Array::truncate(bound, saved)
      0
    },
    ETuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        collect_free_vars_expr_sc(Array::get(elems, i), bound, fn_names, encl, skip_inlined, out)
        i = i + 1
      }
      0
    },
    EArray(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        collect_free_vars_expr_sc(Array::get(elems, i), bound, fn_names, encl, skip_inlined, out)
        i = i + 1
      }
      0
    },
    EMatch(scrutinee, arms) => {
      collect_free_vars_expr_sc(scrutinee, bound, fn_names, encl, skip_inlined, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (arm_pat, arm_expr) = Array::get(arms, i)
        let saved = Array::length(bound)
        collect_pattern_bindings(arm_pat, bound)
        collect_free_vars_expr_sc(arm_expr, bound, fn_names, encl, skip_inlined, out)
        Array::truncate(bound, saved)
        i = i + 1
      }
      0
    },
    EFn(_, _, params, _, _, body) => {
      let saved = Array::length(bound)
      let mut pi = 0
      while pi < Array::length(params) {
        let (pname_raw, _) = Array::get(params, pi)
        let pnl = String::length(pname_raw)
        let pname = if pnl > 0 {
          let plc = String::char_code_at(pname_raw, pnl - 1)
          if plc == '~' || plc == '?' {
            pname_raw[0: pnl - 1]
          } else pname_raw
        } else pname_raw
        Array::push(bound, pname)
        pi = pi + 1
      }
      collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)
      Array::truncate(bound, saved)
      0
    },
    EBreak(_) => 0,
    EContinue(_) => 0,
    EReturn(msg) => collect_free_vars_expr_sc(msg, bound, fn_names, encl, skip_inlined, out),
    EHandle(body, arms) => {
      collect_free_vars_expr_sc(body, bound, fn_names, encl, skip_inlined, out)
      let mut hi = 0
      while hi < Array::length(arms) {
        let (_, arm_expr) = Array::get(arms, hi)
        collect_free_vars_expr_sc(arm_expr, bound, fn_names, encl, skip_inlined, out)
        hi = hi + 1
      }
      0
    },
    EDot(obj, _, _, _) => collect_free_vars_expr_sc(obj, bound, fn_names, encl, skip_inlined, out),
    ERecord(_, fields, _) => {
      let mut ri = 0
      while ri < Array::length(fields) {
        let (_, fval) = Array::get(fields, ri)
        collect_free_vars_expr_sc(fval, bound, fn_names, encl, skip_inlined, out)
        ri = ri + 1
      }
      0
    },
    ELabeledArg(_, _, arg_expr) => collect_free_vars_expr_sc(arg_expr, bound, fn_names, encl, skip_inlined, out),
    _ => 0
  }
}

/// Array-taking compatibility entry: builds the membership index per call.
/// Fine for small fn_names (tests, perceus probes); HOT loops over the full
/// fn+ctor table must use collect_free_vars_indexed with a prebuilt index.
export fn collect_free_vars(body: Expr, param_names: Array[String], fn_names: Array[String]) -> Array[String] {
  collect_free_vars_indexed(body, param_names, sorted_names_of(fn_names))
}

/// #799 perf: index-taking entry -- the index is built ONCE per compile
/// (linked_compile) and reused for every lambda.
export fn collect_free_vars_indexed(body: Expr, param_names: Array[String], fn_name_index: Array[String]) -> Array[String] {
  collect_free_vars_indexed_sc(body, param_names, fn_name_index, common_analysis_fresh_string_array(), true)
}

/// #1348: the same walk WITHOUT the inlined-builtin skip, for the used-builtin
/// scan (collect_used_builtin_names, wasi/linked_helpers.vibe) rather than for
/// closure capture.
///
/// These two consumers ask opposite questions of the same walk, and conflating
/// them is what made `Path::resolve` unfixable for a year:
///
/// - CAPTURE asks "is this name a value this lambda must close over?" An
///   inlined builtin is not -- capturing it produces a call_indirect of a
///   nonexistent closure (the #773 story above), so the skip is right.
/// - USED-BUILTIN asks "does this program mention this builtin at all?", and
///   the answer gates whether its host import is even reserved
///   (`need_resolve_path_builtin` etc., linked_compile.vibe). Applying the
///   capture skip here DELETES the evidence: the name vanishes from the used
///   set, no import is reserved, and the inline lowering -- which for
///   `Path::ref`/`Path::resolve` emits a call to the `resolve_path` host
///   import -- targets an index that was never emitted.
///
/// That is the "mechanism not yet understood" recorded in #1218/#1348: adding
/// `Path::resolve` to is_inlined_async_builtin fixed the closure case and
/// simultaneously broke straight-line TOP-LEVEL `Path::is_absolute(
/// Path::resolve(..))`, because the skip is not scoped to lambdas at all --
/// it fires at every call site in the program. The other listed names hid the
/// conflict only because none of them reserves an import (`Path::to_string`
/// is identity, `Path::is_absolute` is a char compare).
export fn collect_free_vars_used_builtins(body: Expr, param_names: Array[String], fn_name_index: Array[String]) -> Array[String] {
  collect_free_vars_indexed_sc(body, param_names, fn_name_index, common_analysis_fresh_string_array(), false)
}

/// #1114: same, plus the ENCLOSING compile scope's local names -- a bare
/// inlined-builtin call callee that one of those shadows must be captured,
/// not inline-lowered. See collect_free_vars_expr's doc comment.
fn collect_free_vars_indexed_sc(body: Expr, param_names: Array[String], fn_name_index: Array[String], encl: Array[String], skip_inlined: Bool) -> Array[String] {
  let out = common_analysis_fresh_string_array()
  // Make a mutable copy of param_names for stack-based push/truncate
  let bound = Array::slice(param_names, 0, Array::length(param_names))
  collect_free_vars_expr_sc(body, bound, fn_name_index, encl, skip_inlined, out)
  out
}

/// #875 fix 2: like collect_free_vars_indexed, but forces `self_name` (the
/// closure's OWN `let rec NAME = (...) -> { ... }` binding name, or "" for
/// "no self-reference to force") into the result when `body` genuinely
/// references it as a free (lexically unshadowed) identifier -- even if
/// `self_name` ALSO happens to collide, by bare string equality, with an
/// unrelated entry already present in `fn_name_index` (ctx.capture_name_index,
/// a shared whole-program name index used to skip capturing bona fide global
/// func/ctor references).
///
/// Why this is needed: collect_free_vars_expr's EIdent case treats ANY name
/// found in fn_name_index as "resolves globally, no capture needed" --
/// correct when the name really is only reachable as a global, but wrong when
/// it is ALSO the closure's own let-rec name. A `let rec check = (i) -> Bool
/// { ... check(i + 1) ... }` closure normally captures "check" as a free
/// variable precisely BECAUSE "check" is otherwise unknown to fn_name_index;
/// the failure mode only appears once some unrelated top-level function
/// (reachable via a widened whole-program-merge import graph, e.g. the
/// compile entry file's own unqualified top-level names) happens to share the
/// bare name "check". When that happens, compile_lambda's capture list
/// silently omits the self-reference, self_cap_idx (compile_expr_tail.vibe)
/// never fires, and the closure's own recursive call site falls through to
/// compile_call's func-table direct-call path -- calling the unrelated global
/// instead of itself (#875).
///
/// Implementation: re-run the SAME free-var walk with an EMPTY fn_name_index
/// (so nothing is excluded as "a global") whenever the normal result doesn't
/// already contain self_name -- this reuses collect_free_vars_expr's existing,
/// well-tested lexical-shadowing logic (bound push/truncate per scope) exactly
/// as-is, so a self_name that IS legitimately shadowed by an inner binding of
/// the same name (e.g. a nested lambda parameter also named "check") is still
/// correctly excluded, matching normal shadowing semantics. Only runs the
/// second walk in the (rare) collision case, so the common case -- no
/// collision, self_name already present -- costs one array-membership check.
/// `encl` (#1114): the enclosing compile scope's local names, so a bare
/// inlined-builtin call callee shadowed by one of them is captured instead
/// of inline-lowered. Pass an empty array for "no enclosing locals".
export fn collect_free_vars_indexed_self(body: Expr, param_names: Array[String], fn_name_index: Array[String], self_name: String, encl: Array[String]) -> Array[String] {
  let captures = collect_free_vars_indexed_sc(body, param_names, fn_name_index, encl, true)
  if self_name == "" || array_contains_str(captures, self_name) {
    captures
  } else {
    let no_globals = common_analysis_fresh_string_array()
    let unfiltered = collect_free_vars_indexed_sc(body, param_names, no_globals, encl, true)
    if array_contains_str(unfiltered, self_name) {
      Array::push(captures, self_name)
      captures
    } else {
      captures
    }
  }
}

/// True exactly when codegen's lambda lowering needs a heap environment.
/// Keep allocation queries on this API instead of reimplementing capture
/// rules: globals, let-rec self references, and enclosing-name shadowing are
/// deliberately the same inputs compile_lambda uses.
export fn lambda_has_captures(body: Expr, params: Array[(String, Option[TypeExpr])], fn_name_index: Array[String], self_name: String, encl: Array[String]) -> Bool {
  let param_names = common_analysis_fresh_string_array()
  let mut i = 0
  while i < Array::length(params) {
    let (name, _) = Array::get(params, i)
    Array::push(param_names, name)
    i = i + 1
  }
  Array::length(collect_free_vars_indexed_self(body, param_names, fn_name_index, self_name, encl)) > 0
}

/// The root identifier of a projection chain (EDot(...EDot(EIdent(root))...)), or
/// "" if `e` is not a projection. (ADR-0055 Stage 4: shared with compile_expr_tail
/// so function-tail param drops can detect an escaping projection of a param.)
export fn proj_root_ident(e: Expr) -> String {
  match e {
    EDot(obj, _, _, _) => proj_root_ident(obj),
    EIdent(nm, _) => nm,
    _ => ""
  }
}

/// #1272: the borrow-returning builtins -- each hands back an INTERIOR
/// reference into its first argument rather than a fresh value, so a scope
/// whose tail is one of these is escaping a pointer into the container, just
/// like `.field` does. Kept in sync with classify_let_value_heap's own
/// hardcoded list (codegen/expr/compile_expr_tail.vibe).
fn borrow_ret_builtin_name(nm: String) -> Bool {
  nm == "Array::get" || nm == "MutList::get" || nm == "__index" || nm == "Map::get" || nm == "__rec_field"
}

/// The container a borrow-returning tail reads from: an identifier, a
/// projection chain rooted at one, or a nested borrow-returning read (an
/// element of an element is still interior to the same root).
fn borrow_tail_root(e: Expr) -> String {
  match e {
    EIdent(nm, _) => nm,
    EDot(obj, _, _, _) => borrow_tail_root(obj),
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if Array::length(args) >= 1 && borrow_ret_builtin_name(nm) {
        borrow_tail_root(Array::get(args, 0))
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

/// #1272: the bare identifier a scope's tail evaluates to, or "". Lets
/// scope_tail_proj_root see through a borrow that was bound to a local name
/// and then returned (`let r = Array::get(f, 1); r`) -- the same escape as
/// returning the read directly, just spelled with one more binding.
fn scope_tail_ident(e: Expr) -> String {
  match e {
    ELet(_, _, b, _) => scope_tail_ident(b),
    ELetMut(_, _, b, _) => scope_tail_ident(b),
    ELetRec(_, _, b) => scope_tail_ident(b),
    ESeq(_, b) => scope_tail_ident(b),
    EAssign(_, _, b) => scope_tail_ident(b),
    EAssignOp(_, _, _, b) => scope_tail_ident(b),
    EIdent(nm, _) => nm,
    _ => ""
  }
}

/// The container root of a borrow-returning CALL, and only a call: an alias is
/// interior to a container exactly when the value it was bound to is a
/// borrowing read.
fn borrow_call_root(e: Expr) -> String {
  match e {
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if Array::length(args) >= 1 && borrow_ret_builtin_name(nm) {
        borrow_tail_root(Array::get(args, 0))
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

/// If the *tail* (result) expression of a scope is a projection chain, return its
/// root identifier; otherwise "". Follows let/seq/assign wrappers to the tail.
///
/// #1272: an element read through a borrow-returning builtin counts as a
/// projection too. Only `EDot` used to, so a scope whose tail read an element
/// out of a container it OWNS -- `let f = [..]; Array::get(f, 1)`, or the same
/// shape at a function tail over a heap parameter -- dropped that container
/// without first retaining the value it was handing back. The caller received
/// a pointer into freed memory; nothing failed until a later allocation reused
/// the cell, so a single call looked correct and two calls returned garbage.
/// Callers use this exclusively to decide "dup the result before dropping the
/// owner", where over-reporting costs a retain (a leak at worst) and
/// under-reporting is the use-after-free above.
export fn scope_tail_proj_root(e: Expr) -> String {
  match e {
    // #1272: `let r = <borrowing read>; .. ; r` escapes the same interior
    // pointer as returning the read itself, so resolve the alias when the
    // scope's tail is exactly this binding and nothing nearer matched.
    ELet(n, v, b, _) => {
      let inner = scope_tail_proj_root(b)
      if inner == "" && scope_tail_ident(b) == n {
        borrow_call_root(v)
      } else {
        inner
      }
    },
    ELetMut(_, _, b, _) => scope_tail_proj_root(b),
    ELetRec(_, _, b) => scope_tail_proj_root(b),
    ESeq(_, b) => scope_tail_proj_root(b),
    EAssign(_, _, b) => scope_tail_proj_root(b),
    EAssignOp(_, _, _, b) => scope_tail_proj_root(b),
    EDot(obj, _, _, _) => proj_root_ident(obj),
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if Array::length(args) >= 1 && borrow_ret_builtin_name(nm) {
        borrow_tail_root(Array::get(args, 0))
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

/// Check if a mutable variable is captured by any nested EFn in the given expression
export fn is_mut_captured_in(expr: Expr, name: String) -> Bool {
  match expr {
    EIdent(_, _) => false,
    EInt(_) => false,
    EBool(_) => false,
    EFloat(_) => false,
    EString(_) => false,
    EUnit => false,
    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),
    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),
    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),
    ECall(callee, args, _) => if is_mut_captured_in(callee, name) {
      true
    }
    else {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if is_mut_captured_in(Array::get(args, i), name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    ELet(n, value, body, _) => if n == name {
      is_mut_captured_in(value, name)
    }
    else {
      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)
    },
    ELetRec(n, value, body) => if n == name {
      false
    }
    else {
      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)
    },
    ELetMut(n, value, body, _) => if n == name {
      is_mut_captured_in(value, name)
    }
    else {
      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)
    },
    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),
    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),
    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),
    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),
    EForIn(_, _, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),
    ETuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if is_mut_captured_in(Array::get(elems, i), name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EArray(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if is_mut_captured_in(Array::get(elems, i), name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EMatch(scrutinee, arms) => if is_mut_captured_in(scrutinee, name) {
      true
    }
    else {
      let mut i = 0
      let mut found = false
      while i < Array::length(arms) {
        let (_, arm_expr) = Array::get(arms, i)
        if is_mut_captured_in(arm_expr, name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EFn(_, _, params, _, _, fn_body) => {
      // Check if name is shadowed by params
      let mut shadowed = false
      let mut pi = 0
      while pi < Array::length(params) {
        let (pname, _) = Array::get(params, pi)
        if pname == name {
          shadowed = true
        }
        pi = pi + 1
      }
      if shadowed {
        false
      }
      else {
        // Check if name is free in this EFn
        let param_names = array_empty()
        let mut pi2 = 0
        while pi2 < Array::length(params) {
          let (pname2, _) = Array::get(params, pi2)
          Array::push(param_names, pname2)
          pi2 = pi2 + 1
        }
        let fv = collect_free_vars(fn_body, param_names, array_empty())
        if array_contains_str(fv, name) {
          true
        }
        else {
          // Also check recursively for deeper nesting
          is_mut_captured_in(fn_body, name)
        }
      }
    },
    // #1262 (Codex review, PR #1685, P2): these carried sub-expressions and
    // returned `false` anyway, so a closure in a `break` PAYLOAD
    // (`break(() -> Int { x })`) or a `continue` argument captured a `let mut`
    // that was never boxed -- the closure then snapshots the value instead of
    // sharing the cell, which is a silently wrong read, not a crash. Same
    // class and same fix as the #629 step 2 arms below. Recursing is always
    // sound here (over-detection only boxes more), and it also restores the
    // contract `vibe escapes --strict` advertises: the strict lane's output is
    // a SUBSET of this one's. Found because the strict predicate reported a
    // break-payload capture this one did not.
    EBreak(opt) => match opt {
      Some(inner) => is_mut_captured_in(inner, name),
      None => false
    },
    EContinue(args) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if is_mut_captured_in(Array::get(args, i), name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EReturn(msg) => is_mut_captured_in(msg, name),
    // #629 step 2: forms that carry sub-expressions which may hold a capturing
    // closure. Previously these fell through to `_ => false`, so a mut captured
    // by a closure INSIDE a struct/record literal, handler, loop, projection,
    // labeled argument, map literal, or spread was not detected — the cell was
    // left a stack-local and the closure captured it by value (snapshot),
    // silently losing the shared mutation. Recursing here is always sound
    // (over-detection only boxes more).
    ERecord(_, fields, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        if is_mut_captured_in(fval, name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EMap(entries) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(entries) {
        let (_, mval) = Array::get(entries, i)
        if is_mut_captured_in(mval, name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EHandle(body, arms) => if is_mut_captured_in(body, name) {
      true
    } else {
      let mut i = 0
      let mut found = false
      while i < Array::length(arms) {
        let (_, arm_expr) = Array::get(arms, i)
        if is_mut_captured_in(arm_expr, name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    ELoop(params, body) => if is_mut_captured_in(body, name) {
      true
    } else {
      let mut i = 0
      let mut found = false
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        if is_mut_captured_in(init, name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EDot(obj, _, _, _) => is_mut_captured_in(obj, name),
    ELabeledArg(_, _, inner) => is_mut_captured_in(inner, name),
    ESpread(inner) => is_mut_captured_in(inner, name),
    _ => false
  }
}

/// Region-lifetime decision for a `let mut name` cell (#629 region inference).
/// Returns true when the cell must be heap-boxed because its region lifetime can
/// extend beyond the binding block (a capturing closure may escape); false keeps
/// it a plain stack-local (region = lexical block). Both backends gate boxing on
/// this single predicate (linear compile_expr_tail / wasm-gc backend_expr).
///
/// Step 1 baseline: a mut captured by ANY nested closure is conservatively
/// treated as escaping — identical to the prior `is_mut_captured_in` gate, so
/// behavior is unchanged. Later steps refine this into a real escape analysis
/// (a capture whose closure provably cannot escape its binding scope stays
/// stack-local). The predicate stays conservative: when escape cannot be ruled
/// out it returns true (box), which is always sound.
export fn mut_needs_ref_cell(body: Expr, name: String) -> Bool {
  is_mut_captured_in(body, name)
}

/// Builtins whose arg0 is BORROWED (read in place, not consumed/dropped). Kept
/// in sync with is_borrow_arg0_call in perceus/index.vibe.
export fn md_is_borrow_arg0_call(f: String) -> Bool {
  f == "__index" || f == "Array::get" || f == "Array::length" || f == "Array::set" || f == "Array::push" || f == "Array::push_all" || f == "ArrayBuilder::push" || f == "MutList::push" || f == "MutList::get" || f == "MutList::length" || f == "MutBytes::push" || f == "MutBytes::length" || f == "StringBuilder::push" || f == "MapBuilder::set" || f == "MapBuilder::has_key" || f == "MapBuilder::get" || f == "Map::get" || f == "Map::keys" || f == "Map::has_key" || f == "Map::set" || f == "Bytes::push" || f == "Bytes::set" || f == "Bytes::get" || f == "Bytes::length" || f == "FrozenArray::get" || f == "FrozenArray::length" || f == "FixedArray::get" || f == "FixedArray::set" || f == "FixedArray::length" || f == "String::join" || f == "eq" || f == "__rec_field"
}

fn md_max(a: Int, b: Int) -> Int {
  if a > b {
    a
  } else {
    b
  }
}

/// How many times is `name` consumed (owning position) along the LONGEST control
/// path of `e`? Used to balance the rc of a value that is referenced but NOT
/// owned at its definition site — a matched ctor field (a borrowed view sharing
/// the scrutinee's refcount; compile_match) or a captured free variable (a
/// borrowed view of the defining scope's binding; compile_lambda). Each owning
/// consume of such a value decrements a refcount it does not own, so the value
/// must be dup'd once PER consume or it is freed more times than dup'd -> double
/// free. Sequential children SUM; alternative children (if-branches, match/handle
/// arms) take the MAX, so the count is an upper bound on the consumes of any
/// executed path (>= actual everywhere -> never under-dup -> no double free;
/// tight on straight-line code -> no over-dup leak). MUST enumerate every Expr
/// variant (modeled on fold_expr): skipping recursion into a child could miss a
/// real consume and wrongly suppress the dup. A bare `EIdent(name)` passed as
/// arg0 of a borrow-arg0 builtin does not consume (it is read in place).
/// Builtin-only view of md_consume_count_b (empty user borrow set): kept as
/// the stable 2-arg entry for callers with no CompileCtx in reach (and the
/// borrow-set computation itself, which must not consume its own output).
export fn md_consume_count(e: Expr, name: String) -> Int {
  let md_no_user_fns: Array[String] = [
  ]
  let md_no_user_masks: Array[Int] = [
  ]
  md_cc_go(e, name, md_no_user_fns, md_no_user_masks)
}

/// Which parameter positions of callee `f` are borrowed: the builtin
/// arg0 list unioned with the user set's per-position mask. `bfns` is
/// sorted and `bmasks` is aligned to it (compute_borrow_param_user_fns).
fn md_borrow_mask_of(f: String, bfns: Array[String], bmasks: Array[Int]) -> Int {
  let bi = bsearch_leftmost(bfns, f)
  let user = if bi >= 0 && bi < Array::length(bmasks) {
    Array::get(bmasks, bi)
  } else {
    0
  }
  if md_is_borrow_arg0_call(f) {
    user|1
  } else {
    user
  }
}

/// All names locally BOUND anywhere inside `e` -- let/let mut/let rec
/// binders, fn params, match/handle pattern binds, loop params, for-in
/// binders. Used by md_consume_count_b to disable the user-borrow-set
/// callee test for any name a local binding could shadow (Codex P1 on
/// #1282): scope-blind bfns matching would treat a call to a same-named
/// LOCAL closure as borrowed-arg0 and omit the compensating dup -- a
/// use-after-free direction. Presence anywhere in the body (not just
/// enclosing scopes) over-approximates shadowing; the failure direction of
/// the approximation is an extra dup (bounded leak), never a missing one.
fn md_collect_shadow_names(e: Expr, out: Array[String]) -> Int {
  match e {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EIdent(_, _) => 0,
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        md_collect_shadow_names(Array::get(items, i), out)
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        md_collect_shadow_names(Array::get(items, i), out)
        i = i + 1
      }
      0
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        md_collect_shadow_names(v, out)
        i = i + 1
      }
      0
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        md_collect_shadow_names(v, out)
        i = i + 1
      }
      0
    },
    EIf(c, t, el) => {
      md_collect_shadow_names(c, out)
      md_collect_shadow_names(t, out)
      md_collect_shadow_names(el, out)
    },
    EWhile(c, b) => {
      md_collect_shadow_names(c, out)
      md_collect_shadow_names(b, out)
    },
    ELet(n, v, b, _) => {
      Array::push(out, n)
      md_collect_shadow_names(v, out)
      md_collect_shadow_names(b, out)
    },
    ELetRec(n, v, b) => {
      Array::push(out, n)
      md_collect_shadow_names(v, out)
      md_collect_shadow_names(b, out)
    },
    ELetMut(n, v, b, _) => {
      Array::push(out, n)
      md_collect_shadow_names(v, out)
      md_collect_shadow_names(b, out)
    },
    EAssign(_, v, b) => {
      md_collect_shadow_names(v, out)
      md_collect_shadow_names(b, out)
    },
    EAssignOp(_, _, v, b) => {
      md_collect_shadow_names(v, out)
      md_collect_shadow_names(b, out)
    },
    ESeq(a, b) => {
      md_collect_shadow_names(a, out)
      md_collect_shadow_names(b, out)
    },
    EMatch(s, arms) => {
      md_collect_shadow_names(s, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (pt, v) = Array::get(arms, i)
        collect_pattern_bindings(pt, out)
        md_collect_shadow_names(v, out)
        i = i + 1
      }
      0
    },
    EHandle(s, arms) => {
      md_collect_shadow_names(s, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (pt, v) = Array::get(arms, i)
        collect_pattern_bindings(pt, out)
        md_collect_shadow_names(v, out)
        i = i + 1
      }
      0
    },
    ELoop(params, b) => {
      let mut i = 0
      while i < Array::length(params) {
        let pr = Array::get(params, i)
        Array::push(out, pr.0)
        md_collect_shadow_names(pr.1, out)
        i = i + 1
      }
      md_collect_shadow_names(b, out)
    },
    EForIn(vn, idx, it, b) => {
      Array::push(out, vn)
      match idx {
        Some(ix) => {
          Array::push(out, ix)
          ()
        },
        None => ()
      }
      md_collect_shadow_names(it, out)
      md_collect_shadow_names(b, out)
    },
    ECall(callee, args, _) => {
      md_collect_shadow_names(callee, out)
      let mut i = 0
      while i < Array::length(args) {
        md_collect_shadow_names(Array::get(args, i), out)
        i = i + 1
      }
      0
    },
    EBinOp(_, l, r) => {
      md_collect_shadow_names(l, out)
      md_collect_shadow_names(r, out)
    },
    EUnaryOp(_, x) => md_collect_shadow_names(x, out),
    EFn(_, _, params, _, _, body) => {
      let mut i = 0
      while i < Array::length(params) {
        let pr = Array::get(params, i)
        Array::push(out, pr.0)
        i = i + 1
      }
      md_collect_shadow_names(body, out)
    },
    EDot(x, _, _, _) => md_collect_shadow_names(x, out),
    ELabeledArg(_, _, v) => md_collect_shadow_names(v, out),
    EReturn(x) => md_collect_shadow_names(x, out),
    EBreak(opt) => match opt {
      Some(v) => md_collect_shadow_names(v, out),
      None => 0
    },
    EContinue(args) => {
      let mut i = 0
      while i < Array::length(args) {
        md_collect_shadow_names(Array::get(args, i), out)
        i = i + 1
      }
      0
    },
    ESpread(x) => md_collect_shadow_names(x, out)
  }
}

/// The shadow-honoring half of md_consume_count_b, split out so callers
/// that count MANY names against the SAME body (compile_match's per-field
/// bind loops, compile_lambda's capture loop) can run the binder prepass
/// ONCE per body instead of once per name -- the per-name form showed up
/// directly in selfcompile wall time.
///
/// Shadows are neutralized by ZEROING the offending entry's mask rather
/// than by removing its name: a zero mask already means "no position of
/// this callee is borrowed", which is exactly what a shadowing local
/// deserves, and it leaves `bfns` shareable so names and masks can never
/// drift out of alignment. Returns `bmasks` itself (no copy) when the body
/// shadows no member.
/// PRECONDITION: `bfns` is sorted and `bmasks` is aligned to it
/// (compute_borrow_param_user_fns produces both together; membership here
/// is bsearch_leftmost).
export fn md_shadow_zeroed_bmasks(e: Expr, bfns: Array[String], bmasks: Array[Int]) -> Array[Int] {
  if Array::length(bfns) == 0 {
    bmasks
  } else {
    let sh: Array[String] = [
    ]
    md_collect_shadow_names(e, sh)
    let mut any_hit = false
    let mut si = 0
    while si < Array::length(sh) {
      if bsearch_leftmost(bfns, Array::get(sh, si)) >= 0 {
        any_hit = true
      } else {
        ()
      }
      si = si + 1
    }
    if !any_hit {
      bmasks
    } else {
      let bmasks2: Array[Int] = [
      ]
      let mut bi = 0
      while bi < Array::length(bfns) {
        let bn = Array::get(bfns, bi)
        let m = if bi < Array::length(bmasks) {
          Array::get(bmasks, bi)
        } else {
          0
        }
        Array::push(bmasks2, if array_contains_str(sh, bn) {
          0
        } else {
          m
        })
        bi = bi + 1
      }
      bmasks2
    }
  }
}

/// md_consume_count against masks ALREADY zeroed by
/// md_shadow_zeroed_bmasks for this same body. The hoisted form of
/// md_consume_count_b -- pass the raw masks here only if they are empty.
export fn md_consume_count_pre(e: Expr, name: String, bfns: Array[String], bmasks_zeroed: Array[Int]) -> Int {
  md_cc_go(e, name, bfns, bmasks_zeroed)
}

/// md_consume_count with the USER borrow-param set threaded through the
/// ECall borrow test. Lexical shadows are honored conservatively (Codex
/// P1 on #1282): any bfns name that also appears as a LOCAL binder
/// anywhere in `e` has its mask zeroed for this body, so a call to a
/// same-named local closure counts as an owning consume (compile_call and
/// the planner give lexical bindings precedence, so the dup it forces is
/// matched by the closure call's real consume; for the rare body that
/// binds the name but still calls the top-level fn, the extra dup is a
/// bounded leak -- never a missing one). One-shot form; loops over many
/// names against one body should hoist md_shadow_zeroed_bmasks instead.
export fn md_consume_count_b(e: Expr, name: String, bfns: Array[String], bmasks: Array[Int]) -> Int {
  md_cc_go(e, name, bfns, md_shadow_zeroed_bmasks(e, bfns, bmasks))
}

fn md_cc_go(e: Expr, name: String, bfns: Array[String], bmasks: Array[Int]) -> Int {
  match e {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EIdent(n, _) => if n == name {
      1
    } else {
      0
    },
    ETuple(items) => {
      let mut acc = 0
      let mut i = 0
      while i < Array::length(items) {
        acc = acc + md_cc_go(Array::get(items, i), name, bfns, bmasks)
        i = i + 1
      }
      acc
    },
    EArray(items) => {
      let mut acc = 0
      let mut i = 0
      while i < Array::length(items) {
        acc = acc + md_cc_go(Array::get(items, i), name, bfns, bmasks)
        i = i + 1
      }
      acc
    },
    ERecord(_, fields, _) => {
      let mut acc = 0
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        acc = acc + md_cc_go(v, name, bfns, bmasks)
        i = i + 1
      }
      acc
    },
    EMap(fields) => {
      let mut acc = 0
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        acc = acc + md_cc_go(v, name, bfns, bmasks)
        i = i + 1
      }
      acc
    },
    EIf(c, t, el) =>
    md_cc_go(c, name, bfns, bmasks) + md_max(md_cc_go(t, name, bfns, bmasks), md_cc_go(el, name, bfns, bmasks)),
    ELet(_, v, b, _) => md_cc_go(v, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),
    ELetRec(_, v, b) => md_cc_go(v, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),
    ELetMut(_, v, b, _) => md_cc_go(v, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),
    EAssign(_, v, b) => md_cc_go(v, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),
    EAssignOp(_, _, v, b) => md_cc_go(v, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),
    ESeq(a, b) => md_cc_go(a, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),
    EMatch(s, arms) => {
      let mut mx = 0
      let mut i = 0
      while i < Array::length(arms) {
        let (_, v) = Array::get(arms, i)
        mx = md_max(mx, md_cc_go(v, name, bfns, bmasks))
        i = i + 1
      }
      // A bare `match name { .. }` BORROWS the scrutinee (its fields become
      // borrowed views reclaimed by the owner's recursive drop); it does not
      // consume `name`. Counting it as a consume would over-dup a re-matched
      // borrowed tail (e.g. deeply-nested `match restN`), leaking/corrupting
      // the chain. A non-ident scrutinee may still consume `name` in a
      // sub-expression, so recurse there.
      let scr = match s {
        EIdent(_, _) => 0,
        _ => md_cc_go(s, name, bfns, bmasks)
      }
      scr + mx
    },
    EHandle(s, arms) => {
      let mut mx = 0
      let mut i = 0
      while i < Array::length(arms) {
        let (_, v) = Array::get(arms, i)
        mx = md_max(mx, md_cc_go(v, name, bfns, bmasks))
        i = i + 1
      }
      let scr = match s {
        EIdent(_, _) => 0,
        _ => md_cc_go(s, name, bfns, bmasks)
      }
      scr + mx
    },
    EWhile(c, b) => md_cc_go(c, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),
    ELoop(params, b) => {
      let mut acc = md_cc_go(b, name, bfns, bmasks)
      let mut i = 0
      while i < Array::length(params) {
        let (_, v) = Array::get(params, i)
        acc = acc + md_cc_go(v, name, bfns, bmasks)
        i = i + 1
      }
      acc
    },
    EForIn(_, _, it, b) => md_cc_go(it, name, bfns, bmasks) + md_cc_go(b, name, bfns, bmasks),
    ECall(callee, args, _) => {
      let bmask = match callee {
        EIdent(f, _) => md_borrow_mask_of(f, bfns, bmasks),
        _ => 0
      }
      // A bare-ident CALLEE is invoked, not consumed — calling a function or a
      // captured closure (incl. a recursive closure's own self-reference) does
      // not drop it. Counting `f(..)` as a consume of `f` over-dups the captured
      // closure once per call (#705: a nested self-recursive closure's self-
      // capture corrupted under RC). Only a non-ident callee can consume `name`
      // in a sub-expression.
      let callee_c = match callee {
        EIdent(_, _) => 0,
        _ => md_cc_go(callee, name, bfns, bmasks)
      }
      let mut acc = callee_c
      let mut ri = 0
      while ri < Array::length(args) {
        let a = Array::get(args, ri)
        // A bare ident at a BORROWED position is read, not consumed. A
        // non-ident there still has to be walked: its subexpressions can
        // consume `name` even though the argument value itself is borrowed
        // (and such a position is disqualified from the borrow set anyway).
        acc = acc + (if bmask_has(bmask, ri) {
          match a {
            EIdent(_, _) => 0,
            _ => md_cc_go(a, name, bfns, bmasks)
          }
        } else {
          md_cc_go(a, name, bfns, bmasks)
        })
        ri = ri + 1
      }
      acc
    },
    EBinOp(_, l, r) => md_cc_go(l, name, bfns, bmasks) + md_cc_go(r, name, bfns, bmasks),
    EUnaryOp(_, x) => md_cc_go(x, name, bfns, bmasks),
    EFn(_, _, _, _, _, body) => md_cc_go(body, name, bfns, bmasks),
    EDot(x, _, _, _) => md_cc_go(x, name, bfns, bmasks),
    ELabeledArg(_, _, v) => md_cc_go(v, name, bfns, bmasks),
    EReturn(x) => md_cc_go(x, name, bfns, bmasks),
    EBreak(opt) => match opt {
      Some(v) => md_cc_go(v, name, bfns, bmasks),
      None => 0
    },
    EContinue(args) => {
      let mut acc = 0
      let mut i = 0
      while i < Array::length(args) {
        acc = acc + md_cc_go(Array::get(args, i), name, bfns, bmasks)
        i = i + 1
      }
      acc
    },
    ESpread(x) => md_cc_go(x, name, bfns, bmasks)
  }
}

//# ADR-0091 zero_alloc (Phase 1)

/// Builtins allowed inside a `#zero_alloc` fn. Allocation classification is
/// owned by the builtin registry so fused primitives and zero-allocation
/// checking cannot drift apart. Unknown builtins still fail closed.
fn za_safe_builtin(f: String) -> Bool {
  !builtin_allocates(f)
}

fn za_first(a: String, b: String) -> String {
  if a != "" {
    a
  } else {
    b
  }
}

/// Extract plain binder names from an EFn parameter list, stripping the
/// `~`/`?` label-sugar suffix (the call-site spelling binds the bare name).
fn za_param_facts(ps: Array[(String, Option[TypeExpr])]) -> Array[String] {
  let out = array_empty()
  let mut pi = 0
  while pi < Array::length(ps) {
    let (raw, annotation) = Array::get(ps, pi)
    let rl = String::length(raw)
    let stripped = if rl > 0 {
      let lc = String::char_code_at(raw, rl - 1)
      if lc == '~' || lc == '?' {
        raw[0: rl - 1]
      } else {
        raw
      }
    } else {
      raw
    }
    Array::push(out, String::concat(stripped, String::concat("\n", typed_alloc_annotation_kind(annotation))))
    pi = pi + 1
  }
  out
}

fn za_param_fact_name(fact: String) -> String {
  let sep = String::index_of(fact, "\n")
  if sep >= 0 {
    String::substring(fact, 0, sep)
  } else {
    fact
  }
}

fn za_param_fact_kind(fact: String) -> String {
  let sep = String::index_of(fact, "\n")
  if sep >= 0 {
    String::substring(fact, sep + 1, String::length(fact))
  } else {
    ""
  }
}

fn typed_alloc_name_kind(names: Array[String], kinds: Array[String], name: String) -> String {
  let mut i = Array::length(names) - 1
  let mut matched = false
  let mut found = ""
  while i >= 0 && !matched {
    if Array::get(names, i) == name && i < Array::length(kinds) {
      matched = true
      found = Array::get(kinds, i)
    } else {
      ()
    }
    i = i - 1
  }
  if matched && found == "" {
    "<unknown>"
  } else {
    found
  }
}

fn typed_alloc_expr_kind(expr: Expr, names: Array[String], kinds: Array[String]) -> String {
  match expr {
    EInt(_) => "Int",
    EFloat(_) => "Double",
    EString(_) => "String",
    EBool(_) => "Bool",
    EIdent(name, _) => typed_alloc_name_kind(names, kinds, name),
    EBinOp(op, lhs, _) => if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" || op == "&&" || op == "||" {
      "Bool"
    } else {
      typed_alloc_expr_kind(lhs, names, kinds)
    },
    EUnaryOp(op, operand) => if op == "!" {
      "Bool"
    } else {
      typed_alloc_expr_kind(operand, names, kinds)
    },
    _ => ""
  }
}

fn typed_alloc_annotation_kind(annotation: Option[TypeExpr]) -> String {
  match annotation {
    Some(TyName(name)) => if name == "Int" || name == "Double" || name == "String" || name == "Bool" {
      name
    } else {
      ""
    },
    _ => ""
  }
}

fn typed_alloc_copy_strings(items: Array[String]) -> Array[String] {
  Array::slice(items, 0, Array::length(items))
}

fn za_lambda_global_index(fn_names: Array[String], ctors: Array[String]) -> Array[String] {
  let names = typed_alloc_copy_strings(fn_names)
  let mut ci = 0
  while ci < Array::length(ctors) {
    Array::push(names, Array::get(ctors, ci))
    ci = ci + 1
  }
  let registry = builtin_registry()
  let mut bi = 0
  while bi < Array::length(registry) {
    let (name, _, _, _, _) = Array::get(registry, bi)
    Array::push(names, name)
    bi = bi + 1
  }
  sorted_names_of(names)
}

/// Classify source operators whose statically evident overload allocates on
/// the linear backend. Lexical type facts survive package linking without
/// relying on file-local offsets. Unknown arithmetic is conservatively
/// reported rather than silently certified by `#zero_alloc`.
export fn typed_operator_alloc_kind(expr: Expr, names: Array[String], kinds: Array[String]) -> String {
  match expr {
    EBinOp(op, lhs, rhs) => if op == "+" || op == "-" || op == "*" || op == "/" {
      let left_kind = typed_alloc_expr_kind(lhs, names, kinds)
      let kind = if left_kind == "" || left_kind == "<unknown>" {
        typed_alloc_expr_kind(rhs, names, kinds)
      } else {
        left_kind
      }
      if kind == "Double" {
        String::concat("operator:Double:", op)
      } else if kind == "String" && op == "+" {
        "operator:String:+"
      } else if kind == "Int" {
        ""
      } else {
        String::concat("operator:unknown:", op)
      }
    } else {
      ""
    },
    EUnaryOp(op, operand) => if op == "-" {
      let kind = typed_alloc_expr_kind(operand, names, kinds)
      if kind == "Double" {
        "operator:Double:-"
      } else if kind == "Int" {
        ""
      } else {
        "operator:unknown:-"
      }
    } else {
      ""
    },
    _ => ""
  }
}

/// Walk an expression under `#zero_alloc` and return "" when it is proven
/// allocation-free, else a description of the first allocation site found.
/// Conservative Phase 1 (ADR-0091): constructors, container/closure/string
/// literals, float literals (heap-boxed on the linear backend), effect
/// handlers, and any call not on the safe-builtin list or resolvable to a
/// proven-clean top-level fn are all rejected. Operators are classified from
/// package-stable lexical type facts so String concatenation and boxed Double
/// arithmetic cannot pass merely because their operands are variables.
fn za_walk(e: Expr, ctors: Array[String], fn_names: Array[String], fn_bodies: Array[Expr], fn_params: Array[Array[String]], visited: Array[String], bound: Array[String], typed_table: Array[String], typed_subst: Array[String]) -> String {
  match e {
    EInt(_) => "",
    EFloat(_) => "float literal (heap-boxed on the linear backend)",
    EString(_) => "",
    EBool(_) => "",
    EIdent(id, _) => if array_contains_str(bound, id) {
      ""
    } else if array_contains_str(ctors, id) {
      String::concat("constructor '", String::concat(id, "'"))
    } else {
      ""
    },
    ETuple(items) => {
      let _ = items
      "tuple literal"
    },
    EArray(_) => "array literal",
    ERecord(_, _, _) => "record/struct literal",
    EMap(_) => "map literal",
    EStringInterp(_) => "string interpolation",
    EFn(_, _, params, _, _, body) => if lambda_has_captures(body, params, za_lambda_global_index(fn_names, ctors), "", bound) {
      "closure literal (allocates its environment)"
    } else {
      ""
    },
    EIf(zc, zt, zf) => za_first(za_walk(zc, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst), za_first(za_walk(zt, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst), za_walk(zf, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst))),
    ELet(zl_name, zv, zb, _) => {
      let value_result = za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst)
      let body_bound = typed_alloc_copy_strings(bound)
      let body_names = typed_alloc_copy_strings(typed_table)
      let body_kinds = typed_alloc_copy_strings(typed_subst)
      Array::push(body_bound, zl_name)
      Array::push(body_names, zl_name)
      Array::push(body_kinds, typed_alloc_expr_kind(zv, typed_table, typed_subst))
      za_first(value_result, za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, body_bound, body_names, body_kinds))
    },
    ELetRec(zlr_name, zv, zb) => {
      let body_bound = typed_alloc_copy_strings(bound)
      let body_names = typed_alloc_copy_strings(typed_table)
      let body_kinds = typed_alloc_copy_strings(typed_subst)
      Array::push(body_bound, zlr_name)
      Array::push(body_names, zlr_name)
      Array::push(body_kinds, typed_alloc_expr_kind(zv, typed_table, typed_subst))
      za_first(za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, body_bound, body_names, body_kinds), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, body_bound, body_names, body_kinds))
    },
    ELetMut(zlm_name, zv, zb, _) => {
      let value_result = za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst)
      let body_bound = typed_alloc_copy_strings(bound)
      let body_names = typed_alloc_copy_strings(typed_table)
      let body_kinds = typed_alloc_copy_strings(typed_subst)
      Array::push(body_bound, zlm_name)
      Array::push(body_names, zlm_name)
      Array::push(body_kinds, typed_alloc_expr_kind(zv, typed_table, typed_subst))
      za_first(value_result, za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, body_bound, body_names, body_kinds))
    },
    EAssign(_, zv, zb) => za_first(za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst)),
    EAssignOp(_, _, zv, zb) => za_first(za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst)),
    ESeq(za, zb) => za_first(za_walk(za, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst)),
    EMatch(scr, arms) => {
      let mut r = za_walk(scr, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (arm_pat, arm_body) = Array::get(arms, ai)
        let _ = collect_pattern_bindings(arm_pat, bound)
        if r == "" {
          r = za_walk(arm_body, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst)
        } else {
          ()
        }
        ai = ai + 1
      }
      r
    },
    EHandle(_, _) => "effect handler (allocates evidence)",
    EWhile(zc, zb) => za_first(za_walk(zc, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst)),
    ELoop(inits, zb) => {
      let mut r = ""
      let loop_bound = typed_alloc_copy_strings(bound)
      let loop_names = typed_alloc_copy_strings(typed_table)
      let loop_kinds = typed_alloc_copy_strings(typed_subst)
      let mut li = 0
      while li < Array::length(inits) {
        let (zloop_name, init_e) = Array::get(inits, li)
        if r == "" {
          r = za_walk(init_e, ctors, fn_names, fn_bodies, fn_params, visited, loop_bound, loop_names, loop_kinds)
        } else {
          ()
        }
        let init_kind = typed_alloc_expr_kind(init_e, loop_names, loop_kinds)
        Array::push(loop_bound, zloop_name)
        Array::push(loop_names, zloop_name)
        Array::push(loop_kinds, init_kind)
        li = li + 1
      }
      za_first(r, za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, loop_bound, loop_names, loop_kinds))
    },
    EForIn(zfi_name, zfi_snd, zsrc, zb) => {
      Array::push(bound, zfi_name)
      match zfi_snd {
        Some(zfi_n2) => Array::push(bound, zfi_n2),
        None => ()
      }
      za_first(za_walk(zsrc, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst))
    },
    ECall(callee, cargs, _) => {
      let mut r = ""
      let mut ci = 0
      while ci < Array::length(cargs) {
        if r == "" {
          r = za_walk(Array::get(cargs, ci), ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst)
        } else {
          ()
        }
        ci = ci + 1
      }
      if r != "" {
        r
      } else {
        match callee {
          // #1274 Codex P1: a param or local shadowing a top-level fn is an
          // INDIRECT callee -- the supplied implementation may allocate, so
          // name-only fn_names resolution must not see it.
          EIdent(cname, _) => if array_contains_str(bound, cname) {
            String::concat("call through local binding '", String::concat(cname, "' (not proven allocation-free)"))
          } else if array_contains_str(ctors, cname) {
            String::concat("constructor '", String::concat(cname, "'"))
          } else if za_safe_builtin(cname) {
            ""
          } else {
            let mut fi = 0
            let mut fidx = 0 - 1
            while fi < Array::length(fn_names) {
              if Array::get(fn_names, fi) == cname {
                fidx = fi
                fi = Array::length(fn_names)
              } else {
                fi = fi + 1
              }
            }
            if fidx >= 0 {
              if array_contains_str(visited, cname) {
                ""
              } else {
                Array::push(visited, cname)
                // Fresh scope for the callee: its own params are its only
                // lexical bindings (the caller's do not leak in).
                let callee_bound = array_empty()
                let callee_typed_names = array_empty()
                let callee_typed_kinds = array_empty()
                let callee_ps = Array::get(fn_params, fidx)
                let mut cbi = 0
                while cbi < Array::length(callee_ps) {
                  let callee_fact = Array::get(callee_ps, cbi)
                  let callee_name = za_param_fact_name(callee_fact)
                  Array::push(callee_bound, callee_name)
                  Array::push(callee_typed_names, callee_name)
                  Array::push(callee_typed_kinds, za_param_fact_kind(callee_fact))
                  cbi = cbi + 1
                }
                let inner = za_walk(Array::get(fn_bodies, fidx), ctors, fn_names, fn_bodies, fn_params, visited, callee_bound, callee_typed_names, callee_typed_kinds)
                if inner == "" {
                  ""
                } else {
                  String::concat("call to '", String::concat(cname, String::concat("' which may allocate: ", inner)))
                }
              }
            } else {
              String::concat("call to '", String::concat(cname, "' (not proven allocation-free)"))
            }
          },
          _ => "indirect call (not proven allocation-free)"
        }
      }
    },
    EBinOp(_, za, zb) => za_first(za_first(za_walk(za, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst), za_walk(zb, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst)), typed_operator_alloc_kind(e, typed_table, typed_subst)),
    EUnaryOp(_, za) => za_first(za_walk(za, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst), typed_operator_alloc_kind(e, typed_table, typed_subst)),
    EDot(zobj, _, _, _) => za_walk(zobj, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst),
    ELabeledArg(_, _, zv) => za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst),
    EReturn(zv) => za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst),
    EBreak(zo) => match zo {
      Some(zv) => za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst),
      None => ""
    },
    EContinue(zvs) => {
      let mut r = ""
      let mut vi = 0
      while vi < Array::length(zvs) {
        if r == "" {
          r = za_walk(Array::get(zvs, vi), ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst)
        } else {
          ()
        }
        vi = vi + 1
      }
      r
    },
    ESpread(zv) => za_walk(zv, ctors, fn_names, fn_bodies, fn_params, visited, bound, typed_table, typed_subst),
    EUnit => ""
  }
}

/// ADR-0091 Phase 1: enforce `#zero_alloc` markers. The parser normalizes the
/// canonical directive (and legacy `@zero_alloc`) to a top-level `SExpr`
/// statement, which the linear backend drops, and it must IMMEDIATELY precede
/// the `fn` declaration it marks (lowered form: `SLet(_, _, name, _,
/// EFn(..))`). Returns "" when every marked fn is proven allocation-free,
/// else a `zero_alloc:`-prefixed diagnostic. Top-level fns only (module
/// bodies are out of scope for this slice); linear backend only.
export fn zero_alloc_check(stmts: Array[Stmt]) -> String {
  let fn_names = array_empty()
  let fn_bodies = array_empty()
  let fn_params = array_empty()
  let ctors = array_empty()
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      SLet(_, _, lname, _, lval) => match lval {
        EFn(_, _, efn_params, _, _, fb) => {
          Array::push(fn_names, lname)
          Array::push(fn_bodies, fb)
          Array::push(fn_params, za_param_facts(efn_params))
        },
        _ => ()
      },
      SEnum(_, _, _, variants, _) => {
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, _) = Array::get(variants, vi)
          Array::push(ctors, vname)
          vi = vi + 1
        }
      },
      SSuberror(_, _, sub_variants) => {
        let mut vi2 = 0
        while vi2 < Array::length(sub_variants) {
          let (vname2, _) = Array::get(sub_variants, vi2)
          Array::push(ctors, vname2)
          vi2 = vi2 + 1
        }
      },
      SStruct(_, sname, _, _, _, _) => Array::push(ctors, sname),
      _ => ()
    }
    si = si + 1
  }
  let mut msg = ""
  let mut mi = 0
  while mi < Array::length(stmts) {
    let is_marker = match Array::get(stmts, mi) {
      SExpr(me) => match me {
        EIdent(mname, _) => mname == "@zero_alloc",
        _ => false
      },
      _ => false
    }
    if is_marker && msg == "" {
      let target_name = if mi + 1 < Array::length(stmts) {
        match Array::get(stmts, mi + 1) {
          SLet(_, _, tname, _, tval) => match tval {
            EFn(_, _, _, _, _, _) => tname,
            _ => ""
          },
          _ => ""
        }
      } else {
        ""
      }
      if target_name == "" {
        msg = "zero_alloc: '#zero_alloc' must immediately precede a fn declaration"
      } else {
        let mut fi2 = 0
        let mut fidx2 = 0 - 1
        while fi2 < Array::length(fn_names) {
          if Array::get(fn_names, fi2) == target_name {
            fidx2 = fi2
            fi2 = Array::length(fn_names)
          } else {
            fi2 = fi2 + 1
          }
        }
        if fidx2 >= 0 {
          let visited = array_empty()
          Array::push(visited, target_name)
          let seed_bound = array_empty()
          let seed_typed_names = array_empty()
          let seed_typed_kinds = array_empty()
          let seed_ps = Array::get(fn_params, fidx2)
          let mut sbi = 0
          while sbi < Array::length(seed_ps) {
            let seed_fact = Array::get(seed_ps, sbi)
            let seed_name = za_param_fact_name(seed_fact)
            Array::push(seed_bound, seed_name)
            Array::push(seed_typed_names, seed_name)
            Array::push(seed_typed_kinds, za_param_fact_kind(seed_fact))
            sbi = sbi + 1
          }
          let r = za_walk(Array::get(fn_bodies, fidx2), ctors, fn_names, fn_bodies, fn_params, visited, seed_bound, seed_typed_names, seed_typed_kinds)
          if r != "" {
            msg = String::concat("zero_alloc: fn '", String::concat(target_name, String::concat("' may allocate: ", r)))
          } else {
            ()
          }
        } else {
          ()
        }
      }
    } else {
      ()
    }
    mi = mi + 1
  }
  msg
}

//# ADR-0092 borrow-inference slice 1: per-fn borrowed arg0

/// Collect every top-level-fn name used as a VALUE (a bare ident in any
/// non-callee position) anywhere under `e`. A fn that only ever appears as
/// the direct callee of a call can safely change its arg0 ABI; one that is
/// aliased, passed, stored, captured, or returned cannot (indirect call
/// sites cannot consult the borrow set).
fn ca_collect_valued_idents(e: Expr, out: Array[String]) -> Int {
  match e {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EIdent(vn, _) => {
      Array::push(out, vn)
      0
    },
    ECall(callee, cargs, _) => {
      match callee {
        EIdent(_, _) => 0,
        _ => ca_collect_valued_idents(callee, out)
      }
      let mut ci = 0
      while ci < Array::length(cargs) {
        let _ = ca_collect_valued_idents(Array::get(cargs, ci), out)
        ci = ci + 1
      }
      0
    },
    ETuple(items) => ca_collect_valued_list(items, out),
    EArray(items) => ca_collect_valued_list(items, out),
    ERecord(_, rfields, _) => {
      let mut ri = 0
      while ri < Array::length(rfields) {
        let (_, rv) = Array::get(rfields, ri)
        let _ = ca_collect_valued_idents(rv, out)
        ri = ri + 1
      }
      0
    },
    EMap(mfields) => {
      let mut mi = 0
      while mi < Array::length(mfields) {
        let (_, mv) = Array::get(mfields, mi)
        let _ = ca_collect_valued_idents(mv, out)
        mi = mi + 1
      }
      0
    },
    EIf(c0, t0, f0) => {
      let _ = ca_collect_valued_idents(c0, out)
      let _ = ca_collect_valued_idents(t0, out)
      ca_collect_valued_idents(f0, out)
    },
    ELet(_, v0, b0, _) => {
      let _ = ca_collect_valued_idents(v0, out)
      ca_collect_valued_idents(b0, out)
    },
    ELetRec(_, v0, b0) => {
      let _ = ca_collect_valued_idents(v0, out)
      ca_collect_valued_idents(b0, out)
    },
    ELetMut(_, v0, b0, _) => {
      let _ = ca_collect_valued_idents(v0, out)
      ca_collect_valued_idents(b0, out)
    },
    EAssign(_, v0, b0) => {
      let _ = ca_collect_valued_idents(v0, out)
      ca_collect_valued_idents(b0, out)
    },
    EAssignOp(_, _, v0, b0) => {
      let _ = ca_collect_valued_idents(v0, out)
      ca_collect_valued_idents(b0, out)
    },
    ESeq(a0, b0) => {
      let _ = ca_collect_valued_idents(a0, out)
      ca_collect_valued_idents(b0, out)
    },
    EMatch(scr, arms) => {
      let _ = ca_collect_valued_idents(scr, out)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, ab) = Array::get(arms, ai)
        let _ = ca_collect_valued_idents(ab, out)
        ai = ai + 1
      }
      0
    },
    EHandle(hb, harms) => {
      let _ = ca_collect_valued_idents(hb, out)
      let mut hi = 0
      while hi < Array::length(harms) {
        let (_, hab) = Array::get(harms, hi)
        let _ = ca_collect_valued_idents(hab, out)
        hi = hi + 1
      }
      0
    },
    EWhile(c0, b0) => {
      let _ = ca_collect_valued_idents(c0, out)
      ca_collect_valued_idents(b0, out)
    },
    ELoop(inits, b0) => {
      let mut li = 0
      while li < Array::length(inits) {
        let (_, iv) = Array::get(inits, li)
        let _ = ca_collect_valued_idents(iv, out)
        li = li + 1
      }
      ca_collect_valued_idents(b0, out)
    },
    EForIn(_, _, s0, b0) => {
      let _ = ca_collect_valued_idents(s0, out)
      ca_collect_valued_idents(b0, out)
    },
    EBinOp(_, a0, b0) => {
      let _ = ca_collect_valued_idents(a0, out)
      ca_collect_valued_idents(b0, out)
    },
    EUnaryOp(_, a0) => ca_collect_valued_idents(a0, out),
    EFn(_, _, _, _, _, fb) => ca_collect_valued_idents(fb, out),
    EDot(o0, _, _, _) => ca_collect_valued_idents(o0, out),
    ELabeledArg(_, _, v0) => ca_collect_valued_idents(v0, out),
    EReturn(v0) => ca_collect_valued_idents(v0, out),
    EBreak(bo) => match bo {
      Some(bv) => ca_collect_valued_idents(bv, out),
      None => 0
    },
    EContinue(cvs) => ca_collect_valued_list(cvs, out),
    ESpread(sv) => ca_collect_valued_idents(sv, out)
  }
}

fn ca_collect_valued_list(items: Array[Expr], out: Array[String]) -> Int {
  let mut i = 0
  while i < Array::length(items) {
    let _ = ca_collect_valued_idents(Array::get(items, i), out)
    i = i + 1
  }
  0
}

fn ca_walk_stmts_valued(stmts: Array[Stmt], out: Array[String]) -> Int {
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      SLet(_, _, _, _, lv) => {
        let _ = ca_collect_valued_idents(lv, out)
        0
      },
      SLetMut(_, _, lv) => {
        let _ = ca_collect_valued_idents(lv, out)
        0
      },
      SLetPat(_, lv) => {
        let _ = ca_collect_valued_idents(lv, out)
        0
      },
      SExpr(se) => {
        let _ = ca_collect_valued_idents(se, out)
        0
      },
      STest(_, tb) => {
        let _ = ca_collect_valued_idents(tb, out)
        0
      },
      SBench(_, bb) => {
        let _ = ca_collect_valued_idents(bb, out)
        0
      },
      SModule(_, _, mb) => ca_walk_stmts_valued(mb, out),
      _ => 0
    }
    si = si + 1
  }
  0
}

/// Callee name / argument POSITION pairs where a call somewhere passes a
/// NON-IDENT argument. A borrowed parameter is never dropped by the callee
/// (the epilogue drop is filtered program-wide in linked_compile), and the
/// call-emission borrow check is shape-independent, so a fresh temporary
/// passed directly at a borrowed position -- `ignore_children(Node(Leaf(i),
/// Leaf(j)))` in the RC reclamation gate fixture -- would be released by
/// NOBODY: the caller has no binding to scope-drop and the callee's drop is
/// gone (one leak per call; compiler-gate 40d catches it at N=20000). Such
/// POSITIONS must keep the owned ABI, so record every (callee, position)
/// with a non-ident argument and clear that bit of the callee's mask.
///
/// Per-position, not per-function: one fresh temp at arg2 disqualifies arg2
/// alone and leaves the fn's other read-only params borrowed. `out` and
/// `out_pos` are parallel -- entry k says "callee out[k] takes a non-ident
/// argument at position out_pos[k]".
///
/// A surviving `ELabeledArg` wrapper is not an `EIdent`, so it disqualifies
/// its position here. That is also what makes positional indexing safe at
/// all: `desugar_labeled_args` (pre-check) reorders fully-labeled calls into
/// declared parameter order and strips the wrappers, and any label it could
/// NOT resolve stays wrapped and lands in this set.
fn ca_collect_nonident_args(e: Expr, out: Array[String], out_pos: Array[Int]) -> Int {
  match e {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EIdent(_, _) => 0,
    ECall(callee, cargs, _) => {
      match callee {
        EIdent(cf, _) => {
          let mut ni = 0
          while ni < Array::length(cargs) {
            match Array::get(cargs, ni) {
              EIdent(_, _) => (),
              _ => {
                Array::push(out, cf)
                Array::push(out_pos, ni)
              }
            }
            ni = ni + 1
          }
          ()
        },
        _ => {
          let _ = ca_collect_nonident_args(callee, out, out_pos)
          ()
        }
      }
      let mut ci = 0
      while ci < Array::length(cargs) {
        let _ = ca_collect_nonident_args(Array::get(cargs, ci), out, out_pos)
        ci = ci + 1
      }
      0
    },
    ETuple(items) => ca_collect_nonident_args_list(items, out, out_pos),
    EArray(items) => ca_collect_nonident_args_list(items, out, out_pos),
    ERecord(_, rfields, _) => {
      let mut ri = 0
      while ri < Array::length(rfields) {
        let (_, rv) = Array::get(rfields, ri)
        let _ = ca_collect_nonident_args(rv, out, out_pos)
        ri = ri + 1
      }
      0
    },
    EMap(mfields) => {
      let mut mi = 0
      while mi < Array::length(mfields) {
        let (_, mv) = Array::get(mfields, mi)
        let _ = ca_collect_nonident_args(mv, out, out_pos)
        mi = mi + 1
      }
      0
    },
    EIf(c0, t0, f0) => {
      let _ = ca_collect_nonident_args(c0, out, out_pos)
      let _ = ca_collect_nonident_args(t0, out, out_pos)
      ca_collect_nonident_args(f0, out, out_pos)
    },
    ELet(_, v0, b0, _) => {
      let _ = ca_collect_nonident_args(v0, out, out_pos)
      ca_collect_nonident_args(b0, out, out_pos)
    },
    ELetRec(_, v0, b0) => {
      let _ = ca_collect_nonident_args(v0, out, out_pos)
      ca_collect_nonident_args(b0, out, out_pos)
    },
    ELetMut(_, v0, b0, _) => {
      let _ = ca_collect_nonident_args(v0, out, out_pos)
      ca_collect_nonident_args(b0, out, out_pos)
    },
    EAssign(_, v0, b0) => {
      let _ = ca_collect_nonident_args(v0, out, out_pos)
      ca_collect_nonident_args(b0, out, out_pos)
    },
    EAssignOp(_, _, v0, b0) => {
      let _ = ca_collect_nonident_args(v0, out, out_pos)
      ca_collect_nonident_args(b0, out, out_pos)
    },
    ESeq(a0, b0) => {
      let _ = ca_collect_nonident_args(a0, out, out_pos)
      ca_collect_nonident_args(b0, out, out_pos)
    },
    EMatch(scr, arms) => {
      let _ = ca_collect_nonident_args(scr, out, out_pos)
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, ab) = Array::get(arms, ai)
        let _ = ca_collect_nonident_args(ab, out, out_pos)
        ai = ai + 1
      }
      0
    },
    EHandle(hb, harms) => {
      let _ = ca_collect_nonident_args(hb, out, out_pos)
      let mut hi = 0
      while hi < Array::length(harms) {
        let (_, hab) = Array::get(harms, hi)
        let _ = ca_collect_nonident_args(hab, out, out_pos)
        hi = hi + 1
      }
      0
    },
    EWhile(c0, b0) => {
      let _ = ca_collect_nonident_args(c0, out, out_pos)
      ca_collect_nonident_args(b0, out, out_pos)
    },
    ELoop(inits, b0) => {
      let mut li = 0
      while li < Array::length(inits) {
        let (_, iv) = Array::get(inits, li)
        let _ = ca_collect_nonident_args(iv, out, out_pos)
        li = li + 1
      }
      ca_collect_nonident_args(b0, out, out_pos)
    },
    EForIn(_, _, s0, b0) => {
      let _ = ca_collect_nonident_args(s0, out, out_pos)
      ca_collect_nonident_args(b0, out, out_pos)
    },
    EBinOp(_, a0, b0) => {
      let _ = ca_collect_nonident_args(a0, out, out_pos)
      ca_collect_nonident_args(b0, out, out_pos)
    },
    EUnaryOp(_, a0) => ca_collect_nonident_args(a0, out, out_pos),
    EFn(_, _, _, _, _, fb) => ca_collect_nonident_args(fb, out, out_pos),
    EDot(o0, _, _, _) => ca_collect_nonident_args(o0, out, out_pos),
    ELabeledArg(_, _, v0) => ca_collect_nonident_args(v0, out, out_pos),
    EReturn(v0) => ca_collect_nonident_args(v0, out, out_pos),
    EBreak(bo) => match bo {
      Some(bv) => ca_collect_nonident_args(bv, out, out_pos),
      None => 0
    },
    EContinue(cvs) => ca_collect_nonident_args_list(cvs, out, out_pos),
    ESpread(sv) => ca_collect_nonident_args(sv, out, out_pos)
  }
}

fn ca_collect_nonident_args_list(items: Array[Expr], out: Array[String], out_pos: Array[Int]) -> Int {
  let mut i = 0
  while i < Array::length(items) {
    let _ = ca_collect_nonident_args(Array::get(items, i), out, out_pos)
    i = i + 1
  }
  0
}

fn ca_walk_stmts_nonident_args(stmts: Array[Stmt], out: Array[String], out_pos: Array[Int]) -> Int {
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      SLet(_, _, _, _, lv) => {
        let _ = ca_collect_nonident_args(lv, out, out_pos)
        0
      },
      SLetMut(_, _, lv) => {
        let _ = ca_collect_nonident_args(lv, out, out_pos)
        0
      },
      SLetPat(_, lv) => {
        let _ = ca_collect_nonident_args(lv, out, out_pos)
        0
      },
      SExpr(se) => {
        let _ = ca_collect_nonident_args(se, out, out_pos)
        0
      },
      STest(_, tb) => {
        let _ = ca_collect_nonident_args(tb, out, out_pos)
        0
      },
      SBench(_, bb) => {
        let _ = ca_collect_nonident_args(bb, out, out_pos)
        0
      },
      SModule(_, _, mb) => ca_walk_stmts_nonident_args(mb, out, out_pos),
      _ => 0
    }
    si = si + 1
  }
  0
}

/// Bit `i` of a borrow mask means "parameter `i` of this fn is BORROWED":
/// the caller keeps ownership across the call, so it emits no transfer dup
/// and the callee emits no epilogue drop. Positions >= `bmask_max_param`
/// are never borrowed -- Int is 62-bit tagged, and a 32-param ceiling keeps
/// every shift far inside it with no arity check at the query sites.
///
/// Kept in sync with the identical helpers in perceus/perceus.vibe and
/// codegen/expr/compile_call.vibe (same convention as is_borrow_arg0_call).
export fn bmask_max_param() -> Int {
  32
}

export fn bmask_has(mask: Int, i: Int) -> Bool {
  i >= 0 && i < 32 && ((mask>>i)&1) == 1
}

/// Strip a labeled/optional parameter's trailing `~`/`?` marker.
fn bp_param_base_name(raw: String) -> String {
  let l = String::length(raw)
  if l > 0 {
    let c = String::char_code_at(raw, l - 1)
    if c == '~' || c == '?' {
      raw[0: l - 1]
    } else {
      raw
    }
  } else {
    raw
  }
}

/// ADR-0092 borrow-inference: for every top-level fn, which of its
/// parameters are only ever READ. Each such position's ABI flips to
/// borrowed, program-wide and in lockstep: the caller's plan counts an
/// ident argument there as a free borrow (no transfer dup) and the callee's
/// plan-site drop for that param is skipped (linked_compile).
///
/// Slice 1 (#1282) inferred position 0 only. This is the per-position
/// generalization: a fn that consumes param0 but only reads param1 now gets
/// param1 borrowed, and a fn all of whose params are read-only gets all of
/// them. **Bit 0 of the result is exactly slice 1's set** -- same
/// eligibility test, same disqualifiers -- which is what makes
/// `mask & 1` a byte-identity differential against the previous compiler.
///
/// Eligibility is decided per position, all conservative:
///   - the fn is a top-level `SLet` + `EFn`, and the position is < arity
///     and < bmask_max_param()
///   - that param's consume count in the body is 0 (only borrow-position
///     uses: projections, borrow-arg0 builtin calls -- md_consume_count)
///   - that param is not mut-captured by an inner closure
///   - the fn body does not shadow it (a rebinding would make the consume
///     count unreliable) -- approximated by md_consume_count only, which
///     counts ANY bare mention; a shadowed rebind's value read would count
///     as a consume and disqualify the position
///   - no call anywhere passes a NON-IDENT argument at that position
///     (ca_collect_nonident_args -- a fresh temp at a borrowed position has
///     no owner left to release it)
/// Whole-fn disqualifiers, which zero the mask outright:
///   - the fn name is used as a VALUE anywhere in the program (indirect
///     call sites cannot consult this set)
///   - the caller passes it in `exclude` (the program entry and the
///     conventional entry names: the host invokes them without consulting
///     the set either)
///
/// `md_consume_count` is used WITHOUT a user borrow set on purpose: this
/// computation must not consume its own output (a fixpoint would make each
/// position's eligibility depend on positions still being decided).
///
/// Returns the SORTED name array of fns with a non-zero mask and fills
/// `out_masks` aligned to it, so a single `bsearch_leftmost` on the names
/// indexes straight into the masks. Sorting and alignment happen here
/// together -- a caller that sorted the names itself would silently
/// misattribute every mask.
export fn compute_borrow_param_user_fns(stmts: Array[Stmt], exclude: Array[String], out_masks: Array[Int]) -> Array[String] {
  let valued = array_empty()
  let _ = ca_walk_stmts_valued(stmts, valued)
  let nonident_fns = array_empty()
  let nonident_pos = array_empty()
  let _ = ca_walk_stmts_nonident_args(stmts, nonident_fns, nonident_pos)
  // Fold the (callee, position) pairs into one mask per callee of the
  // positions that must STAY owned, so the per-function loop below is a
  // single hash lookup instead of a scan of the whole pair list.
  let nonident: MutMap[String, Int] = MutMap::new_string()
  let mut ni = 0
  while ni < Array::length(nonident_fns) {
    let nf = Array::get(nonident_fns, ni)
    let np = Array::get(nonident_pos, ni)
    let prev = match MutMap::get(nonident, nf) {
      Some(m) => m,
      None => 0
    }
    if np >= 0 && np < bmask_max_param() {
      MutMap::set(nonident, nf, prev|(1<<np))
    } else {
      ()
    }
    ni = ni + 1
  }
  // Same shape as compute_may_return_view_fns below: the set is complete
  // before this loop starts and was then linearly scanned once per function.
  let valued_srt = sorted_names_of(valued)
  let excluded_srt = sorted_names_of(exclude)
  let names = array_empty()
  let masks: MutMap[String, Int] = MutMap::new_string()
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      SLet(_, _, fname, _, fval) => match fval {
        EFn(_, _, fps, _, _, fbody) => if bsearch_leftmost(valued_srt, fname) < 0 && bsearch_leftmost(excluded_srt, fname) < 0 {
          let owned_bits = match MutMap::get(nonident, fname) {
            Some(m) => m,
            None => 0
          }
          let mut mask = 0
          let mut pi = 0
          let np = Array::length(fps)
          let lim = if np < bmask_max_param() {
            np
          } else {
            bmask_max_param()
          }
          while pi < lim {
            let (praw, _) = Array::get(fps, pi)
            let pn = bp_param_base_name(praw)
            if pn != "" && !bmask_has(owned_bits, pi) && md_consume_count(fbody, pn) == 0 && !is_mut_captured_in(fbody, pn) {
              mask = mask|(1<<pi)
            } else {
              ()
            }
            pi = pi + 1
          }
          if mask != 0 {
            Array::push(names, fname)
            MutMap::set(masks, fname, mask)
          } else {
            ()
          }
        } else {
          ()
        },
        _ => ()
      },
      _ => ()
    }
    si = si + 1
  }
  // Sort the names, then re-read each mask by name. Rebuilding the mask
  // array from the SORTED names (rather than sorting two arrays in step)
  // makes misalignment unrepresentable.
  let names_srt = sorted_names_of(names)
  let mut oi = 0
  while oi < Array::length(names_srt) {
    Array::push(out_masks, match MutMap::get(masks, Array::get(names_srt, oi)) {
      Some(m) => m,
      None => 0
    })
    oi = oi + 1
  }
  names_srt
}

//# ADR-0092 borrow-inference: may-return-view analysis

/// True when `name` is provably bound to a FRESH (owned) value: it was
/// classified fresh at its binding and no assignment tainted it since.
/// Epoch-keyed membership: `m` maps name -> the generation that last
/// inserted it, so one shared table serves every per-function walk of the
/// fixpoint below -- bumping `gen` retires all previous entries at once
/// with no clearing and no per-function allocation (the naive
/// MutSet-per-walk variant of this index cost +160MB of bump high-water
/// on a selfcompile).
fn mrv_gen_has(m: MutMap[String, Int], gen: Int, name: String) -> Bool {
  match MutMap::get(m, name) {
    Some(g) => g == gen,
    None => false
  }
}

fn mrv_is_fresh_name(fresh_names: MutMap[String, Int], tainted: MutMap[String, Int], gen: Int, name: String) -> Bool {
  mrv_gen_has(fresh_names, gen, name) && !mrv_gen_has(tainted, gen, name)
}

/// Value classification for compute_may_return_view_fns: does `e` evaluate
/// to a provably FRESH/owned value (true), or might it be an unowned
/// interior view (false)? Conservative toward view: only literals, ctor
/// calls, container/closure literals, operators, and calls to
/// known-fresh-returning functions classify fresh; identifiers resolve
/// fresh only through let-chains of fresh values (params, globals, match
/// payload bindings, and borrow-returning builtin results never do).
///
/// The walk doubles as the taint collector, so it MUST recurse into every
/// child (modeled on md_consume_count's completeness): let/letmut bindings
/// record their freshness in `fresh_names`, mut assignments with a
/// non-fresh RHS push the target onto `tainted`, every binder (params are
/// pushed by the caller) lands in `bound` so a call through a local
/// closure is never mistaken for a fresh builtin call, and `EReturn` of a
/// non-fresh value sets `ret_view[0]` (an early return is a tail).
/// Bindings are recorded flat (no scope popping): a name REBOUND to a
/// non-fresh value taints itself, so collisions only ever push toward
/// view -- the safe direction.
fn mrv_fresh(e: Expr, fresh_names: MutMap[String, Int], tainted: MutMap[String, Int], bound: Array[String], gen: Int, user_fns_srt: Array[String], view_set: MutSet[String], ret_view: Array[Int]) -> Bool {
  match e {
    EInt(_) => true,
    EFloat(_) => true,
    EString(_) => true,
    EBool(_) => true,
    EUnit => true,
    EStringInterp(_) => true,
    EIdent(n, _) => mrv_is_fresh_name(fresh_names, tainted, gen, n),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        let _ = mrv_fresh(Array::get(items, i), fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
        i = i + 1
      }
      true
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        let _ = mrv_fresh(Array::get(items, i), fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
        i = i + 1
      }
      true
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        let _ = mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
        i = i + 1
      }
      true
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        let _ = mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
        i = i + 1
      }
      true
    },
    EIf(c, t, el) => {
      let _ = mrv_fresh(c, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      let tf = mrv_fresh(t, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      let ef = mrv_fresh(el, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      tf && ef
    },
    ELet(n, v, b, _) => {
      let vf = mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      Array::push(bound, n)
      if vf {
        MutMap::set(fresh_names, n, gen)
      } else {
        MutMap::set(tainted, n, gen)
      }
      mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
    },
    ELetMut(n, v, b, _) => {
      let vf = mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      Array::push(bound, n)
      if vf {
        MutMap::set(fresh_names, n, gen)
      } else {
        MutMap::set(tainted, n, gen)
      }
      mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
    },
    ELetRec(n, v, b) => {
      let _ = mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      Array::push(bound, n)
      MutMap::set(fresh_names, n, gen)
      mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
    },
    EAssign(n, v, b) => {
      let vf = mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      if vf {
        ()
      } else {
        MutMap::set(tainted, n, gen)
      }
      mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
    },
    EAssignOp(_, _, v, b) => {
      let _ = mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
    },
    ESeq(a, b) => {
      let _ = mrv_fresh(a, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
    },
    EMatch(s, arms) => {
      let _ = mrv_fresh(s, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      let mut all = true
      let mut i = 0
      while i < Array::length(arms) {
        let (p, v) = Array::get(arms, i)
        // Pattern payloads are interior views of the scrutinee: bound but
        // never fresh.
        let _ = collect_pattern_bindings(p, bound)
        if mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view) {
          ()
        } else {
          all = false
        }
        i = i + 1
      }
      all
    },
    EHandle(s, arms) => {
      let _ = mrv_fresh(s, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      let mut all = true
      let mut i = 0
      while i < Array::length(arms) {
        let (p, v) = Array::get(arms, i)
        let _ = collect_pattern_bindings(p, bound)
        if mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view) {
          ()
        } else {
          all = false
        }
        i = i + 1
      }
      all
    },
    EWhile(c, b) => {
      let _ = mrv_fresh(c, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      let _ = mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      true
    },
    ELoop(params, b) => {
      let mut i = 0
      while i < Array::length(params) {
        let (pn, pv) = Array::get(params, i)
        let _ = mrv_fresh(pv, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
        Array::push(bound, pn)
        i = i + 1
      }
      let _ = mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      // A loop's value flows out of `break v` sites we do not track: view.
      false
    },
    EForIn(n1, n2, it, b) => {
      let _ = mrv_fresh(it, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      Array::push(bound, n1)
      match n2 {
        Some(n2s) => Array::push(bound, n2s),
        None => ()
      }
      let _ = mrv_fresh(b, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      true
    },
    ECall(callee, args, _) => {
      let mut arg0_fresh = false
      let mut i = 0
      while i < Array::length(args) {
        let af = mrv_fresh(Array::get(args, i), fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
        if i == 0 {
          arg0_fresh = af
        } else {
          ()
        }
        i = i + 1
      }
      match callee {
        EIdent(f, _) => if array_contains_str(bound, f) {
          // A locally-bound closure: its return is untrackable.
          false
        } else if bsearch_leftmost(user_fns_srt, f) >= 0 {
          !MutSet::has(view_set, f)
        } else if borrow_ret_builtin_name(f) {
          false
        } else {
          // Ctor application or a fresh-returning builtin. (A ctor name is
          // uppercase, but a non-view builtin returns fresh too, so the
          // distinction does not matter here.)
          true
        },
        EFn(_, _, wfps, _, _, wbody) => {
          // #1915: `let x: T = e` parses to the identity application
          // `((__asc: T) -> __asc)(e)` (ascribe_wrap, parser_expr_dispatch.vibe)
          // -- a checker-only ascription device, so the call's freshness is the
          // argument's. Treating the non-ident callee as untrackable here put
          // every function tail-returning an annotated fresh binding (`let out:
          // Array[Int] = []; ...; out` -- the standard builder shape) into the
          // may-return-view set, and every caller then leaked the owned result
          // (view-call scope-end drop suppression, one object per call).
          // Recognized structurally (single param returned unchanged), not by
          // the `__asc` name, so a hand-written identity lambda gets the same
          // precision; anything else stays untrackable as before.
          let ident_ret = if Array::length(wfps) == 1 && Array::length(args) == 1 {
            let (wpn, _) = Array::get(wfps, 0)
            match wbody {
              EIdent(bn, _) => bn == wpn,
              _ => false
            }
          } else {
            false
          }
          if ident_ret {
            arg0_fresh
          } else {
            let _ = mrv_fresh(callee, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
            false
          }
        },
        _ => {
          let _ = mrv_fresh(callee, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
          false
        }
      }
    },
    EBinOp(_, l, r) => {
      let _ = mrv_fresh(l, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      let _ = mrv_fresh(r, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      true
    },
    EUnaryOp(_, x) => {
      let _ = mrv_fresh(x, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      true
    },
    EFn(_, _, fps, _, _, body) => {
      // A closure literal is a fresh value; its body can still taint
      // captured muts, so walk it -- but ITS early returns are not the
      // enclosing function's (dummy ret cell).
      let mut i = 0
      while i < Array::length(fps) {
        let (pn, _) = Array::get(fps, i)
        Array::push(bound, pn)
        i = i + 1
      }
      let dummy_ret = [
        0
      ]
      let _ = mrv_fresh(body, fresh_names, tainted, bound, gen, user_fns_srt, view_set, dummy_ret)
      true
    },
    EDot(x, _, _, _) => {
      let _ = mrv_fresh(x, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
      false
    },
    ELabeledArg(_, _, v) => mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view),
    EReturn(x) => {
      if mrv_fresh(x, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view) {
        ()
      } else {
        Array::set(ret_view, 0, 1)
      }
      true
    },
    EBreak(opt) => {
      let _ = match opt {
        Some(v) => mrv_fresh(v, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view),
        None => true
      }
      true
    },
    EContinue(args) => {
      let mut i = 0
      while i < Array::length(args) {
        let _ = mrv_fresh(Array::get(args, i), fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
        i = i + 1
      }
      true
    },
    ESpread(x) => mrv_fresh(x, fresh_names, tainted, bound, gen, user_fns_srt, view_set, ret_view)
  }
}

/// ADR-0092 borrow-inference: top-level functions whose RETURN VALUE may be
/// an unowned interior view (a borrow-returning builtin result, a match
/// payload, a global, a parameter, or anything reaching a return position
/// that mrv_fresh cannot prove fresh -- e.g. `let mut out = EInt(0); ...
/// out = Array::get(exprs, i) ...; out`). The planner suppresses the
/// retention-driven scope-end drop ONLY for let-bindings calling functions
/// in this set (intersected with the borrow-arg0 set): suppressing for a
/// fresh-returning callee instead leaks its result (caught by the
/// compiler-gate RC reclamation guard), and NOT suppressing for a
/// view-returning one releases a reference the binding never acquired
/// (the codegen_heap_e2e_test over-release). Iterated to a fixpoint so a
/// view propagates through wrapper functions whose tail is a call.
export fn compute_may_return_view_fns(stmts: Array[Stmt]) -> Array[String] {
  let user_fns = array_empty()
  let mut ci = 0
  while ci < Array::length(stmts) {
    match Array::get(stmts, ci) {
      SLet(_, _, fname, _, fval) => match fval {
        EFn(_, _, _, _, _, _) => Array::push(user_fns, fname),
        _ => ()
      },
      _ => ()
    }
    ci = ci + 1
  }
  // ADR-0092 / #1259 perf: `user_fns` holds EVERY user function in the
  // program (~5000 when the compiler compiles itself) and never changes, but
  // it was linearly scanned once per identifier CALL, inside a fixpoint loop
  // that re-walks every body up to 10 times. That single lookup accounted for
  // 2.0s of an 8.4s selfcompile profile. Sorted once here, binary-searched at
  // the call site.
  let user_fns_srt = sorted_names_of(user_fns)
  // The returned array keeps the discovery order; `view_seen` is a parallel
  // membership index (the per-callee scan of the growing view set was the
  // hottest single lookup of a selfcompile profile after the user_fns sort
  // above -- #1259).
  let view_set = array_empty()
  let view_seen = MutSet::new_string()
  let fresh_names: MutMap[String, Int] = MutMap::new_string()
  let tainted: MutMap[String, Int] = MutMap::new_string()
  // `bound` is a shared flat array reset per walk via truncate (the
  // collect_free_vars push/truncate pattern): membership is only checked for
  // call heads and stays function-local-small, while a per-walk table costs
  // an allocation per binder insert -- the selfcompile heap KPI gate is
  // tighter than that CPU win (#1259 follow-up).
  let bound = array_empty()
  let mut gen = 0
  let mut changed = true
  let mut rounds = 0
  while changed && rounds < 10 {
    changed = false
    let mut si = 0
    while si < Array::length(stmts) {
      match Array::get(stmts, si) {
        SLet(_, _, fname, _, fval) => match fval {
          EFn(_, _, fps, _, _, fbody) => if MutSet::has(view_seen, fname) {
            ()
          } else {
            gen = gen + 1
            Array::truncate(bound, 0)
            let mut pi = 0
            while pi < Array::length(fps) {
              let (pn, _) = Array::get(fps, pi)
              Array::push(bound, pn)
              pi = pi + 1
            }
            let ret_view = [
              0
            ]
            let tail_fresh = mrv_fresh(fbody, fresh_names, tainted, bound, gen, user_fns_srt, view_seen, ret_view)
            if !tail_fresh || Array::get(ret_view, 0) == 1 {
              Array::push(view_set, fname)
              MutSet::add(view_seen, fname)
              changed = true
            } else {
              ()
            }
          },
          _ => ()
        },
        _ => ()
      }
      si = si + 1
    }
    rounds = rounds + 1
  }
  view_set
}

//# #1259 step 7 groundwork: lambda-site counting

/// How many lambda table entries compiling `expr` will allocate.
///
/// compile_lambda takes a lambda's function index from the LIVE length of the
/// shared LambdaTable and emits it into the body as a `table_slot` immediate,
/// so a function's output bytes depend on how many lambdas every function
/// compiled before it produced. That is what stops a worker from compiling a
/// body on its own, and removing it is what a frozen WholeProgramPlan means
/// (docs/compiler-parallelism.md).
///
/// Counting is exact rather than an estimate: compile_expr dispatches EFn
/// (tag 24) to compile_lambda unconditionally (compile_expr_tail3.vibe), and
/// compile_lambda's push is unconditional, so one table entry per EFn node
/// reachable in the body -- nested lambdas included, since compile_lambda
/// compiles its own body through the same dispatch.
///
/// The traversal mirrors dce.vibe's collect_refs_into arm for arm. Binding
/// structure is irrelevant here (a count, not a scope analysis), so the arms
/// that clone a bound set there simply recurse.
///
/// It is a PREDICTION of what the sequential walk does, and it is checked
/// against the live length at every allocation rather than trusted -- see
/// CompileCtx.lambda_plan_next. A silent mismatch would key a body's emitted
/// constants to a table slot nothing installs.
export fn count_lambda_sites_expr(expr: Expr) -> Int {
  match expr {
    // #1733: these generated builtins live before func_offset, so their value
    // form is materialized by both backends as a tiny ordinary lambda with a
    // valid table slot. Count that synthetic site in the frozen plan.
    EIdent(name, _) => if name == "FrozenArray::from_array" || name == "FrozenArray::to_array" {
      1
    } else {
      0
    },
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EBreak(_) => 0,
    EContinue(_) => 0,
    EReturn(e) => count_lambda_sites_expr(e),
    EUnaryOp(_, e) => count_lambda_sites_expr(e),
    ESpread(e) => count_lambda_sites_expr(e),
    EDot(obj, _, _, _) => count_lambda_sites_expr(obj),
    ELabeledArg(_, _, e) => count_lambda_sites_expr(e),
    ETuple(items) => count_lambda_sites_exprs(items),
    EArray(items) => count_lambda_sites_exprs(items),
    ERecord(_, fields, _) => count_lambda_sites_fields(fields),
    EMap(fields) => count_lambda_sites_fields(fields),
    EBinOp(_, l, r) => count_lambda_sites_expr(l) + count_lambda_sites_expr(r),
    ESeq(l, r) => count_lambda_sites_expr(l) + count_lambda_sites_expr(r),
    // A direct conversion call stays direct; only a value-position identifier
    // is materialized as the synthetic lambda above.
    ECall(callee, args, _) => {
      let callee_count = match callee {
        EIdent(name, _) => if name == "FrozenArray::from_array" || name == "FrozenArray::to_array" {
          0
        } else {
          count_lambda_sites_expr(callee)
        },
        _ => count_lambda_sites_expr(callee)
      }
      callee_count + count_lambda_sites_exprs(args)
    },
    EIf(cond, then_e, else_e) =>
    count_lambda_sites_expr(cond) + count_lambda_sites_expr(then_e) + count_lambda_sites_expr(else_e),
    ELet(_, val, body, _) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),
    ELetRec(_, val, body) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),
    ELetMut(_, val, body, _) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),
    EAssign(_, val, body) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),
    EAssignOp(_, _, val, body) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),
    EWhile(cond, body) => count_lambda_sites_expr(cond) + count_lambda_sites_expr(body),
    EForIn(_, _, iter, body) => count_lambda_sites_expr(iter) + count_lambda_sites_expr(body),
    ELoop(params, body) => count_lambda_sites_fields(params) + count_lambda_sites_expr(body),
    EMatch(scr, arms) => count_lambda_sites_expr(scr) + count_lambda_sites_arms(arms),
    EHandle(body_expr, arms) => count_lambda_sites_expr(body_expr) + count_lambda_sites_arms(arms),
    // The one arm that counts: this node IS a table entry, and its body may
    // hold more.
    EFn(_, _, _, _, _, body) => 1 + count_lambda_sites_expr(body)
  }
}

fn count_lambda_sites_exprs(items: Array[Expr]) -> Int {
  let n = Array::length(items)
  let mut i = 0
  let mut total = 0
  while i < n {
    total = total + count_lambda_sites_expr(Array::get(items, i))
    i = i + 1
  }
  total
}

fn count_lambda_sites_fields(fields: Array[(String, Expr)]) -> Int {
  let n = Array::length(fields)
  let mut i = 0
  let mut total = 0
  while i < n {
    let (_, val) = Array::get(fields, i)
    total = total + count_lambda_sites_expr(val)
    i = i + 1
  }
  total
}

fn count_lambda_sites_arms(arms: Array[(Pat, Expr)]) -> Int {
  let n = Array::length(arms)
  let mut i = 0
  let mut total = 0
  while i < n {
    let (_, body) = Array::get(arms, i)
    total = total + count_lambda_sites_expr(body)
    i = i + 1
  }
  total
}

/// #729/#730 + #1262: the `Fs::readdir` / `sh_lines` surface, as ordinary AST.
///
/// The host import returns the entries "\n"-joined as ONE packed string (the
/// same ABI as `fs_read_file` -- no host-side array building, RC/bump
/// agnostic). Turning that into `Array[String]` is a source-level rewrite, not
/// codegen, so BOTH lanes want the identical expression and neither should
/// spell it out again: the linear lane had this inline, and reproducing it in
/// the gc lane is exactly the two-copies-that-drift shape #1809 was about.
///
/// Two details are load-bearing:
///
///   - the length guard. An empty directory gives "", and `String::split("", d)`
///     is `[""]`, not `[]` -- so the empty case has to be built separately.
///     `Array::slice(x, 0, 0)` is how an empty array is spelled here.
///   - `String::from_char_code(10)` rather than a `"\n"` literal. A synthesized
///     `EString` is not in the string table (same constraint as
///     `double_to_string_expr`), so it cannot be emitted as a constant.
export fn packed_lines_to_array_expr(raw_call: Expr, tmp_name: String) -> Expr {
  let newline = ECall(EIdent("String::from_char_code", -1), [
    EInt(10)
  ], -1)
  ELet(tmp_name, raw_call, EIf(EBinOp("==", ECall(EIdent("String::length", -1), [
    EIdent(tmp_name, -1)
  ], -1), EInt(0)), ECall(EIdent("Array::slice", -1), [
    EArray([
      newline
    ]),
    EInt(0),
    EInt(0)
  ], -1), ECall(EIdent("String::split", -1), [
    EIdent(tmp_name, -1),
    newline
  ], -1)), -1)
}

/// ADR-0090 (#1262): the region copy-out exits, shared by both backends.
///
/// `MutList::freeze` / `MutList::to_array` must COPY, not alias. Two reasons,
/// and the second is the one that bites: an alias would observe later pushes,
/// and with an arena the region release would leave the escaping value
/// dangling. `Array::slice(tmp, 0, Array::length(tmp))` allocates through the
/// ordinary main-heap path, so the escaping array never points into region
/// storage.
///
/// The value is bound to a temp first so an effectful argument is evaluated
/// once -- `f()` in `MutList::to_array(f())` must not run twice.
export fn region_array_value_copy(value: Expr, tmp: String) -> Expr {
  ELet(tmp, value, ECall(EIdent("Array::slice", -1), [
    EIdent(tmp, -1),
    EInt(0),
    ECall(EIdent("Array::length", -1), [
      EIdent(tmp, -1)
    ], -1)
  ], -1), -1)
}

/// `MutBytes::to_bytes(mb)` -- the same exit for the Bytes half, for the same
/// two reasons (an alias observes later pushes; with an arena the release
/// dangles it). `Bytes::slice` allocates through `Bytes::new`, which is always
/// a main-heap bump, so the escaping value never points into region storage.
export fn region_mutbytes_exit_copy(arg: Expr) -> Expr {
  let tmp = "__mutbytes_exit"
  ELet(tmp, arg, ECall(EIdent("Bytes::slice", -1), [
    EIdent(tmp, -1),
    EInt(0),
    ECall(EIdent("Bytes::length", -1), [
      EIdent(tmp, -1)
    ], -1)
  ], -1), -1)
}

export fn region_mutlist_exit_copy(arg: Expr) -> Expr {
  region_array_value_copy(ECall(EIdent("ArrayBuilder::freeze", -1), [
    arg
  ], -1), "__mutlist_exit")
}
