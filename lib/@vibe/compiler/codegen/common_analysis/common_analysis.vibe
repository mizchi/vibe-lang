import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr, bsearch_leftmost, bytebuf_push, sorted_names_of
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/codegen/common_extractors {
  array_contains_str
}

import @vibe/compiler/codegen/wasm_emit {
  emit_call_indirect,
  emit_else,
  emit_end,
  emit_i32_load,
  emit_i32_wrap_i64,
  emit_i64_and,
  emit_i64_const,
  emit_i64_eq,
  emit_i64_or,
  emit_i64_shl,
  emit_i64_shr_s,
  emit_if_void,
  emit_local_get,
  emit_local_set
}

let op_i64_extend_i32_u = 173

//# Functions

fn common_analysis_fresh_string_array() -> Array[String] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

/// Collect string literals appearing anywhere in a pattern, including inside
/// constructor / tuple / or / struct sub-patterns. #603: codegen now tests a
/// `PString` sub-pattern of a `PCtor`, so its literal must be registered in the
/// string table (previously only top-level `PString` arms were collected).
fn collect_strings_pat(pat: Pat, out: Array[String]) -> Int {
  match pat {
    PString(s) => {
      let mut pf = false
      let mut pi = 0
      while pi < Array::length(out) {
        if Array::get(out, pi) == s {
          pf = true
        }
        pi = pi + 1
      }
      if !pf {
        Array::push(out, s)
      }
      0
    },
    PCtor(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        let _ = collect_strings_pat(Array::get(args, i), out)
        i = i + 1
      }
      0
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        let _ = collect_strings_pat(Array::get(pats, i), out)
        i = i + 1
      }
      0
    },
    POr(l, r) => {
      let _ = collect_strings_pat(l, out)
      let _ = collect_strings_pat(r, out)
      0
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        let _ = collect_strings_pat(fp, out)
        i = i + 1
      }
      0
    },
    _ => 0
  }
}

export fn collect_strings_expr(expr: Expr, out: Array[String]) -> Int {
  match expr {
    EString(s) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(out) {
        if Array::get(out, i) == s {
          found = true
        }
        i = i + 1
      }
      if !found {
        Array::push(out, s)
      }
      0
    },
    EBinOp(_, lhs, rhs) => {
      collect_strings_expr(lhs, out)
      collect_strings_expr(rhs, out)
    },
    EUnaryOp(_, operand) => collect_strings_expr(operand, out),
    EIf(cond, then_e, else_e) => {
      collect_strings_expr(cond, out)
      collect_strings_expr(then_e, out)
      collect_strings_expr(else_e, out)
    },
    ECall(callee, args, _) => {
      collect_strings_expr(callee, out)
      // #784: the bool→string codegen path (compile_call.vibe) synthesizes
      // `if b { "true" } else { "false" }` for a statically-boolean `__to_string`
      // arg. Those EString nodes are created during codegen — AFTER this
      // collection pass — so their literals are otherwise absent from the string
      // table (`string not in table: true`, Codex #785 review, P1). Seed them
      // whenever `__to_string` is called. Over-approximates (also seeds for a
      // purely-integer `__to_string`), which is harmless: two small interned
      // strings.
      match callee {
        EIdent(nm, _) => if nm == "__to_string" {
          collect_strings_expr(EString("true"), out)
          collect_strings_expr(EString("false"), out)
        } else {
          0
        },
        _ => 0
      }
      let mut i = 0
      while i < Array::length(args) {
        collect_strings_expr(Array::get(args, i), out)
        i = i + 1
      }
      0
    },
    ELet(_, value, body, _) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ELetRec(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ELetMut(_, value, body, _) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    EAssign(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    EAssignOp(_, _, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ESeq(first, second) => {
      collect_strings_expr(first, out)
      collect_strings_expr(second, out)
    },
    EWhile(cond, body) => {
      collect_strings_expr(cond, out)
      collect_strings_expr(body, out)
    },
    EForIn(_, _, iter_e, body) => {
      collect_strings_expr(iter_e, out)
      collect_strings_expr(body, out)
    },
    ETuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        collect_strings_expr(Array::get(elems, i), out)
        i = i + 1
      }
      0
    },
    EArray(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        collect_strings_expr(Array::get(elems, i), out)
        i = i + 1
      }
      0
    },
    EMatch(scrutinee, arms) => {
      collect_strings_expr(scrutinee, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, arm_expr) = Array::get(arms, i)
        let _ = collect_strings_pat(pat, out)
        collect_strings_expr(arm_expr, out)
        i = i + 1
      }
      0
    },
    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),
    EReturn(msg) => collect_strings_expr(msg, out),
    EStringInterp(parts) => {
      let mut si_p = 0
      while si_p < Array::length(parts) {
        if si_p % 2 == 0 {
          let part = Array::get(parts, si_p)
          if String::length(part) > 0 {
            let mut found = false
            let mut fi2 = 0
            while fi2 < Array::length(out) {
              if Array::get(out, fi2) == part {
                found = true
              }
              fi2 = fi2 + 1
            }
            if !found {
              Array::push(out, part)
            }
          }
        }
        si_p = si_p + 1
      }
      0
    },
    EHandle(body, arms) => {
      collect_strings_expr(body, out)
      let mut hi = 0
      while hi < Array::length(arms) {
        let (_, arm_expr) = Array::get(arms, hi)
        collect_strings_expr(arm_expr, out)
        hi = hi + 1
      }
      0
    },
    EMap(fields) => {
      let mut mi = 0
      while mi < Array::length(fields) {
        let (key, val) = Array::get(fields, mi)
        let mut kf = false
        let mut ki = 0
        while ki < Array::length(out) {
          if Array::get(out, ki) == key {
            kf = true
          }
          ki = ki + 1
        }
        if !kf {
          Array::push(out, key)
        }
        collect_strings_expr(val, out)
        mi = mi + 1
      }
      0
    },
    ERecord(_, fields, _) => {
      let mut ri = 0
      while ri < Array::length(fields) {
        let (_, fval) = Array::get(fields, ri)
        collect_strings_expr(fval, out)
        ri = ri + 1
      }
      0
    },
    EDot(obj, _, _, _) => collect_strings_expr(obj, out),
    ELabeledArg(_, _, val) => collect_strings_expr(val, out),
    _ => 0
  }
}

/// Extract function param names from SLet(_, _, _, _, EFn(_, _, params, _, _, _))
export fn get_func_param_names(stmt: Stmt) -> Array[String] with { Error } {
  match stmt {
    SLet(_, _, _, _, expr) => match expr {
      EFn(_, _, params, _, _, _) => {
        let names = common_analysis_fresh_string_array()
        let mut i = 0
        while i < Array::length(params) {
          let (pname, _) = Array::get(params, i)
          // Strip labeled/optional markers from param names
          let plen2 = String::length(pname)
          let clean_name = if plen2 > 0 {
            let last_char = String::char_code_at(pname, plen2 - 1)
            if last_char == '~' || last_char == '?' {
              pname[0: plen2 - 1]
            } else pname
          } else pname
          Array::push(names, clean_name)
          i = i + 1
        }
        names
      },
      _ => throw("get_func_param_names: not a function")
    },
    _ => throw("get_func_param_names: not a let statement")
  }
}

/// #721: does the program reference the exception machinery anywhere? EThrow
/// compiles to `throw 2`, EHandle to try_table over tags 0-3, and effect op
/// performs to `throw <eff_tag>` (guarded separately by the effect declaration
/// list). When NONE of these appear, the tag section and the "error" tag
/// export can be omitted entirely -- V8 runs exnref-bearing modules on a
/// slower path, costing pure-compute code ~35% (fib(38): 0.32s with tags vs
/// 0.20s without; wasmtime shows parity, so it is engine behavior, not
/// codegen). Conservative: any EThrow/EHandle at ANY nesting depth counts.
export fn expr_contains_exceptions(expr: Expr) -> Bool {
  match expr {
    EHandle(_, _) => true,
    EBinOp(_, lhs, rhs) => expr_contains_exceptions(lhs) || expr_contains_exceptions(rhs),
    EUnaryOp(_, operand) => expr_contains_exceptions(operand),
    EIf(cond, then_e, else_e) =>
    expr_contains_exceptions(cond) || expr_contains_exceptions(then_e) || expr_contains_exceptions(else_e),
    ECall(callee, args, _) => {
      // A bare `resume(..)` call compiles to `throw 1` (continuation resume)
      // even without a surrounding EHandle in this expression -- a resume
      // misused outside a handler must still produce a VALID module. A user
      // function actually named `resume` merely keeps the tags (harmless
      // over-approximation).
      //
      // #774: `perform Eff::Op(..)` compiles to `throw <eff_tag>`
      // (compile_call.vibe) EVEN WHEN the enclosing file declares no
      // `effect Eff { .. }` of its own (e.g. lib/@vibe/http/http.vibe /
      // lib/@vibe/socket/tcp.vibe perform `Http::*`/`Socket::*` ops whose
      // names never appear as an `SEffectDef` in the compiled unit) --
      // `effect_name_to_tag` falls back to a sentinel tag index in that
      // case. Missing "perform" here (like "resume") made `uses_exceptions`
      // false whenever a compiled unit's ONLY exception-shaped construct was
      // an un-declared-effect `perform` with no `handle`/`throw` anywhere
      // else, so the tag section was omitted -- and the emitted `throw
      // <eff_tag>` then referenced a tag index that plain does not exist,
      // failing wasm validation ("Invalid tag index: N") the moment the
      // function's body is compiled, whether or not it is ever called.
      let mut found = match callee {
        EIdent(cname, _) => cname == "resume" || cname == "perform",
        _ => expr_contains_exceptions(callee)
      }
      let mut i = 0
      while i < Array::length(args) {
        if expr_contains_exceptions(Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ELet(_, value, body, _) => expr_contains_exceptions(value) || expr_contains_exceptions(body),
    ELetRec(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),
    ELetMut(_, value, body, _) => expr_contains_exceptions(value) || expr_contains_exceptions(body),
    EAssign(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),
    EAssignOp(_, _, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),
    ESeq(first, second) => expr_contains_exceptions(first) || expr_contains_exceptions(second),
    EWhile(cond, body) => expr_contains_exceptions(cond) || expr_contains_exceptions(body),
    EForIn(_, _, iter_e, body) => expr_contains_exceptions(iter_e) || expr_contains_exceptions(body),
    ELoop(params, body) => {
      let mut i = 0
      let mut found = expr_contains_exceptions(body)
      while i < Array::length(params) {
        let (_, iv) = Array::get(params, i)
        if expr_contains_exceptions(iv) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EMatch(scrut, arms) => {
      let mut i = 0
      let mut found = expr_contains_exceptions(scrut)
      while i < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, i)
        if expr_contains_exceptions(arm_body) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EFn(_, _, _, _, _, body) => expr_contains_exceptions(body),
    ETuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if expr_contains_exceptions(Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EArray(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if expr_contains_exceptions(Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        if expr_contains_exceptions(fval) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EMap(fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        if expr_contains_exceptions(fval) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EDot(obj, _, _, _) => expr_contains_exceptions(obj),
    ELabeledArg(_, _, inner) => expr_contains_exceptions(inner),
    EReturn(inner) => expr_contains_exceptions(inner),
    ESpread(inner) => expr_contains_exceptions(inner),
    EBreak(opt) => match opt {
      Some(inner) => expr_contains_exceptions(inner),
      None => false
    },
    EContinue(args) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if expr_contains_exceptions(Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EInt(_) => false,
    EFloat(_) => false,
    EString(_) => false,
    EBool(_) => false,
    EIdent(_, _) => false,
    EStringInterp(_) => false,
    EUnit => false
  }
}

export fn stmts_contain_exceptions(stmts: Array[Stmt]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => if expr_contains_exceptions(expr) {
        found = true
      } else {
        ()
      },
      SLetMut(_, _, expr) => if expr_contains_exceptions(expr) {
        found = true
      } else {
        ()
      },
      SLetPat(_, expr) => if expr_contains_exceptions(expr) {
        found = true
      } else {
        ()
      },
      SExpr(expr) => if expr_contains_exceptions(expr) {
        found = true
      } else {
        ()
      },
      STest(_, expr) => if expr_contains_exceptions(expr) {
        found = true
      } else {
        ()
      },
      SBench(_, expr) => if expr_contains_exceptions(expr) {
        found = true
      } else {
        ()
      },
      SModule(_, _, inner) => if stmts_contain_exceptions(inner) {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

export fn collect_strings_stmts(stmts: Array[Stmt]) -> Array[String] {
  let out = common_analysis_fresh_string_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),
      _ => 0
    }
    i = i + 1
  }
  out
}

export fn emit_i64_extend_i32_u(buf: Bytes) -> Unit {
  bytebuf_push(buf, op_i64_extend_i32_u)
}

/// Resolve closure/fn value tag and fill slot_local/env_local
/// After this: slot_local = table slot index, env_local = env pointer (0 for bare fn)
export fn emit_closure_resolve(buf: Bytes, fn_val_local: Int, slot_local: Int, env_local: Int) -> Unit {
  emit_local_get(buf, fn_val_local)
  emit_i64_const(buf, 3)
  emit_i64_and(buf)
  emit_i64_const(buf, 2)
  emit_i64_eq(buf)
  emit_if_void(buf)
  // Bare fn: table_slot = fn_val >> 2, env = 0
  emit_local_get(buf, fn_val_local)
  emit_i64_const(buf, 2)
  emit_i64_shr_s(buf)
  emit_local_set(buf, slot_local)
  emit_i64_const(buf, 0)
  emit_local_set(buf, env_local)
  emit_else(buf)
  // Closure: env = fn_val & ~3, slot = i32.load(env, 0)
  emit_local_get(buf, fn_val_local)
  emit_i64_const(buf, -4)
  emit_i64_and(buf)
  emit_local_set(buf, env_local)
  emit_local_get(buf, env_local)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf, 2, 0)
  emit_i64_extend_i32_u(buf)
  emit_local_set(buf, slot_local)
  emit_end(buf)
}

/// Emit the tail of an indirect closure call (push env, push slot, call_indirect)
export fn emit_closure_call_tail(buf: Bytes, env_local: Int, slot_local: Int, closure_type_base: Int, num_args: Int) -> Unit {
  emit_local_get(buf, env_local)
  emit_local_get(buf, slot_local)
  emit_i32_wrap_i64(buf)
  emit_call_indirect(buf, closure_type_base + num_args)
}

fn collect_pattern_bindings(pat: Pat, bindings: Array[String]) -> Int {
  match pat {
    PBind(name) => {
      Array::push(bindings, name); 0
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        collect_pattern_bindings(Array::get(pats, i), bindings)
        i = i + 1
      }
      0
    },
    PCtor(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        collect_pattern_bindings(Array::get(args, i), bindings)
        i = i + 1
      }
      0
    },
    POr(l, r) => {
      collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fpat) = Array::get(fields, i)
        collect_pattern_bindings(fpat, bindings)
        i = i + 1
      }
      0
    },
    _ => 0
  }
}

/// Inlined async builtins (docs/spec/wasi-p3-async.md) are lowered directly by
/// compile_call rather than living in the func table, so — like operators — they
/// must never be treated as free variables when they appear inside a nested
/// lambda body. Otherwise a thunk such as `() -> { Task::join(t) }` would capture
/// `Task::join` as a closure value and mis-lower the call as an indirect apply.
fn is_inlined_async_builtin(name: String) -> Bool {
  name == "await" || name == "Future::ready" || name == "Stream::empty" || name == "Stream::once" || name == "Stream::map" || name == "Stream::filter" || name == "Stream::fold" || name == "Stream::next" || name == "String::to_bytes" || name == "Stream::to_string"
}

/// #773: the scalar arithmetic/logic intrinsics ("not"/"add"/"sub"/"mul"/"lt")
/// are, like the async builtins above, lowered INLINE by compile_call.vibe
/// (`!prefer_bound_call && fname == "not"` etc.) rather than living in the func
/// table -- UNLESS a user top-level function of the same bare name shadows them,
/// in which case they're already present in `fn_names` (ctx.func_table.names)
/// and excluded by the check above. ("eq"/"Array::length"/"Bytes::length"/
/// "String::length" are unconditionally registered in the func table for every
/// compile, so they never reach this fallback and need no entry here.)
///
/// Before this fix, a closure/lambda literal that referenced one of these bare
/// names as a call callee (e.g. `(b: Bool) -> Bool { not(b) }`) — and did NOT
/// shadow it with a same-named top-level function — fell through to the `else`
/// branch below and was wrongly recorded as a FREE VARIABLE to capture from the
/// enclosing scope. compile_lambda.vibe then allocated a captured-env slot named
/// "not" and, back in compile_call.vibe, `local_idx_hint` found "not" among the
/// closure's own `local_names` (the just-added capture), forcing
/// `prefer_bound_call = true` -- i.e. treating the wrongly captured (and
/// nonexistent-in-the-enclosing-scope) "not" value as a closure to invoke via
/// `call_indirect`. That corrupted the closure's environment and crashed with
/// "unreachable" / "null function or function signature mismatch" at runtime
/// (reported against @vibex/quickcheck's check_int/check_bool + is_ok, whose
/// property closures call `not(...)`).
///
/// #1095: "assert" has the identical `!prefer_bound_call && fname == "assert"`
/// inline-lowering gate in compile_call.vibe, and hit the same bug: a closure
/// body calling bare `assert(...)` got it wrongly captured as a free variable,
/// so `assert(false)` inside a lambda crashed with "null function or function
/// signature mismatch" instead of the expected "unreachable" trap that the
/// same code produces at top level.
fn is_inlined_scalar_builtin(name: String) -> Bool {
  name == "not" || name == "add" || name == "sub" || name == "mul" || name == "lt" || name == "assert"
}

/// Stack-based free variable analysis: uses in-place push/truncate on bound array
/// to avoid O(n) array copies at every scope boundary. This dramatically reduces
/// heap allocation during meta-circular self-compilation.
/// #799 perf: `fn_names` is a MEMBERSHIP INDEX (Map), not an array. The flat
/// fn+ctor name table is thousands of entries in a compiler-closure compile,
/// and this walker consulted it linearly PER IDENT -- ~70% of a full compile's
/// profile was string-equality scans under this function. Callers with a hot
/// loop pass a prebuilt index (ctx.capture_name_index); the Array-taking
/// wrapper below builds one per call for small/cold callers.
/// #640 Stage 2: recognize the parse-time desugar of `throw(x)` —
/// `ECall(EIdent("perform"), [ECall(EIdent("Error::Throw"), payload_args)])`
/// — and return its payload args. None for every other perform (or shape).
fn ca_perform_error_throw_op_args(args: Array[Expr]) -> Option[Array[Expr]] {
  if Array::length(args) == 1 {
    match Array::get(args, 0) {
      ECall(op_callee, op_args, _) => match op_callee {
        EIdent(op_name, _) => if op_name == "Error::Throw" {
          Some(op_args)
        } else {
          None
        },
        _ => None
      },
      _ => None
    }
  } else {
    None
  }
}

/// #1114: the inlined-builtin skip below must also yield to a LOCAL binding
/// in an ENCLOSING scope. `bound` only ever holds the innermost lambda's own
/// binders (it is re-seeded per lambda from that lambda's parameters -- see
/// collect_free_vars_indexed), and `fn_names` only holds TOP-LEVEL names, so
/// neither can see that e.g. `fn outer(not: (Bool) -> Bool)` binds `not` for
/// a nested `() -> { not(true) }`. Without `encl` the skip fired, `not` was
/// never captured, and the call silently lowered to the BUILTIN logical-not
/// instead of invoking the parameter -- a wrong VALUE, not a crash.
/// `encl` is the enclosing compile scope's local names, threaded from
/// compile_lambda; the public wrapper passes an empty array, which reproduces
/// the previous behavior exactly for every other caller.
export fn collect_free_vars_expr(expr: Expr, bound: Array[String], fn_names: Array[String], out: Array[String]) -> Int {
  collect_free_vars_expr_sc(expr, bound, fn_names, common_analysis_fresh_string_array(), out)
}

fn collect_free_vars_expr_sc(expr: Expr, bound: Array[String], fn_names: Array[String], encl: Array[String], out: Array[String]) -> Int {
  match expr {
    // #1203: `encl` (the enclosing scope's own locals, e.g. an outer
    // function's parameters) must be checked BEFORE `fn_names` (top-level
    // globals). Checking `fn_names` first meant a plain identifier reference
    // that is actually shadowed by an enclosing-scope local (e.g.
    // `compose(f, g) = (z) -> g(f(z))`, where `f`/`g` are compose's OWN
    // parameters) was wrongly treated as "already global, no capture needed"
    // whenever the merged program happened to also define a top-level
    // function of the same bare name (`fn f() { .. }` anywhere in the
    // linked program) -- silently dropping a real capture and corrupting
    // the closure's environment layout (wrong field count / call arity)
    // rather than raising any diagnostic.
    EIdent(name, _) => if array_contains_str(bound, name) {
      0
    }
    else if array_contains_str(encl, name) {
      if array_contains_str(out, name) {
        0
      } else {
        Array::push(out, name)
        0
      }
    }
    else if bsearch_leftmost(fn_names, name) >= 0 {
      0
    }
    else if array_contains_str(out, name) {
      0
    }
    else {
      Array::push(out, name)
      0
    },
    EInt(_) => 0,
    EBool(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EUnit => 0,
    EBinOp(_, lhs, rhs) => {
      collect_free_vars_expr_sc(lhs, bound, fn_names, encl, out); collect_free_vars_expr_sc(rhs, bound, fn_names, encl, out)
    },
    EUnaryOp(_, operand) => collect_free_vars_expr_sc(operand, bound, fn_names, encl, out),
    EIf(cond, then_e, else_e) => {
      collect_free_vars_expr_sc(cond, bound, fn_names, encl, out); collect_free_vars_expr_sc(then_e, bound, fn_names, encl, out); collect_free_vars_expr_sc(else_e, bound, fn_names, encl, out)
    },
    // #773/regression fix: the inlined-builtin skip only applies to a bare
    // name used as a CALL CALLEE (`sub(a, b)`), never to a plain identifier
    // reference. Checking it in the generic EIdent branch above would also
    // swallow a real bound-elsewhere variable that merely happens to share
    // one of these short names (e.g. a `sub: String` parameter in
    // lib/@vibe/prelude/string.vibe's string_index_of_from), wrongly
    // skipping its capture into a nested closure and crashing with
    // "undefined variable (ident)" at runtime.
    ECall(EIdent(cname, _), args, _) => if cname == "perform" {
      // #640 Stage 2: `throw(x)` parses to `perform Error::Throw(x)`. The
      // magic `perform` callee and the `Error::Throw` op name are keywords,
      // not capturable values — collecting them as free vars made every
      // throw-bearing LOCAL closure capture a garbage "perform" slot and
      // call through it (null call_indirect / signature mismatch at
      // runtime; the #786 perform-in-closure shape, which throw never had
      // as EThrow). Skip both and recurse into the payload only. A real
      // `perform Eff::Op(..)` keeps the historical collection verbatim
      // (those lambdas are dlh-hoisted before this analysis runs).
      match ca_perform_error_throw_op_args(args) {
        Some(op_args) => {
          let mut i = 0
          while i < Array::length(op_args) {
            collect_free_vars_expr_sc(Array::get(op_args, i), bound, fn_names, encl, out)
            i = i + 1
          }
          0
        },
        None => {
          collect_free_vars_expr_sc(EIdent(cname, 0), bound, fn_names, encl, out)
          let mut i = 0
          while i < Array::length(args) {
            collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, out)
            i = i + 1
          }
          0
        }
      }
    } else if !array_contains_str(bound, cname) && !(bsearch_leftmost(fn_names, cname) >= 0) && !array_contains_str(encl, cname) && (is_inlined_async_builtin(cname) || is_inlined_scalar_builtin(cname)) {
      let mut i = 0
      while i < Array::length(args) {
        collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, out)
        i = i + 1
      }
      0
    } else {
      collect_free_vars_expr_sc(EIdent(cname, 0), bound, fn_names, encl, out)
      let mut i = 0
      while i < Array::length(args) {
        collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, out)
        i = i + 1
      }
      0
    },
    ECall(callee, args, _) => {
      collect_free_vars_expr_sc(callee, bound, fn_names, encl, out)
      let mut i = 0
      while i < Array::length(args) {
        collect_free_vars_expr_sc(Array::get(args, i), bound, fn_names, encl, out)
        i = i + 1
      }
      0
    },
    ELet(name, value, body, _) => {
      collect_free_vars_expr_sc(value, bound, fn_names, encl, out)
      let saved = Array::length(bound)
      Array::push(bound, name)
      collect_free_vars_expr_sc(body, bound, fn_names, encl, out)
      Array::truncate(bound, saved)
      0
    },
    ELetRec(name, value, body) => {
      let saved = Array::length(bound)
      Array::push(bound, name)
      collect_free_vars_expr_sc(value, bound, fn_names, encl, out)
      collect_free_vars_expr_sc(body, bound, fn_names, encl, out)
      Array::truncate(bound, saved)
      0
    },
    ELetMut(name, value, body, _) => {
      collect_free_vars_expr_sc(value, bound, fn_names, encl, out)
      let saved = Array::length(bound)
      Array::push(bound, name)
      collect_free_vars_expr_sc(body, bound, fn_names, encl, out)
      Array::truncate(bound, saved)
      0
    },
    EAssign(name, value, body) => {
      // The assignment TARGET is a variable reference too: a lambda whose only
      // use of an outer `let mut` is `x = 1` (no read) must still capture it —
      // previously only value/body mentions were collected, so `count += 1` /
      // write-only assigns in closures failed codegen with
      // "undefined variable (local): count" (and is_mut_captured_in, which
      // rides this collector, never promoted the cell).
      // #1203 Codex review (P1): same encl-before-fn_names precedence as the
      // plain EIdent case above -- an enclosing `let mut f` reassigned only
      // via `f = ...`/`f += ...` inside the closure must still be captured
      // even when the linked program also defines an unrelated top-level
      // `fn f`.
      if array_contains_str(bound, name) {
        0
      } else if array_contains_str(encl, name) {
        if array_contains_str(out, name) {
          0
        } else {
          Array::push(out, name)
          0
        }
      } else if bsearch_leftmost(fn_names, name) >= 0 || array_contains_str(out, name) {
        0
      } else {
        Array::push(out, name)
        0
      }
      collect_free_vars_expr_sc(value, bound, fn_names, encl, out); collect_free_vars_expr_sc(body, bound, fn_names, encl, out)
    },
    EAssignOp(name, _, value, body) => {
      if array_contains_str(bound, name) {
        0
      } else if array_contains_str(encl, name) {
        if array_contains_str(out, name) {
          0
        } else {
          Array::push(out, name)
          0
        }
      } else if bsearch_leftmost(fn_names, name) >= 0 || array_contains_str(out, name) {
        0
      } else {
        Array::push(out, name)
        0
      }
      collect_free_vars_expr_sc(value, bound, fn_names, encl, out); collect_free_vars_expr_sc(body, bound, fn_names, encl, out)
    },
    ESeq(first, second) => {
      collect_free_vars_expr_sc(first, bound, fn_names, encl, out); collect_free_vars_expr_sc(second, bound, fn_names, encl, out)
    },
    EWhile(cond, body) => {
      collect_free_vars_expr_sc(cond, bound, fn_names, encl, out); collect_free_vars_expr_sc(body, bound, fn_names, encl, out)
    },
    EForIn(var_name, index_name, iter_e, body) => {
      collect_free_vars_expr_sc(iter_e, bound, fn_names, encl, out)
      let saved = Array::length(bound)
      Array::push(bound, var_name)
      match index_name {
        Some(index_name) => Array::push(bound, index_name),
        None => ()
      }
      collect_free_vars_expr_sc(body, bound, fn_names, encl, out)
      Array::truncate(bound, saved)
      0
    },
    ETuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        collect_free_vars_expr_sc(Array::get(elems, i), bound, fn_names, encl, out)
        i = i + 1
      }
      0
    },
    EArray(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        collect_free_vars_expr_sc(Array::get(elems, i), bound, fn_names, encl, out)
        i = i + 1
      }
      0
    },
    EMatch(scrutinee, arms) => {
      collect_free_vars_expr_sc(scrutinee, bound, fn_names, encl, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (arm_pat, arm_expr) = Array::get(arms, i)
        let saved = Array::length(bound)
        collect_pattern_bindings(arm_pat, bound)
        collect_free_vars_expr_sc(arm_expr, bound, fn_names, encl, out)
        Array::truncate(bound, saved)
        i = i + 1
      }
      0
    },
    EFn(_, _, params, _, _, body) => {
      let saved = Array::length(bound)
      let mut pi = 0
      while pi < Array::length(params) {
        let (pname_raw, _) = Array::get(params, pi)
        let pnl = String::length(pname_raw)
        let pname = if pnl > 0 {
          let plc = String::char_code_at(pname_raw, pnl - 1)
          if plc == '~' || plc == '?' {
            pname_raw[0: pnl - 1]
          } else pname_raw
        } else pname_raw
        Array::push(bound, pname)
        pi = pi + 1
      }
      collect_free_vars_expr_sc(body, bound, fn_names, encl, out)
      Array::truncate(bound, saved)
      0
    },
    EBreak(_) => 0,
    EContinue(_) => 0,
    EReturn(msg) => collect_free_vars_expr_sc(msg, bound, fn_names, encl, out),
    EHandle(body, arms) => {
      collect_free_vars_expr_sc(body, bound, fn_names, encl, out)
      let mut hi = 0
      while hi < Array::length(arms) {
        let (_, arm_expr) = Array::get(arms, hi)
        collect_free_vars_expr_sc(arm_expr, bound, fn_names, encl, out)
        hi = hi + 1
      }
      0
    },
    EDot(obj, _, _, _) => collect_free_vars_expr_sc(obj, bound, fn_names, encl, out),
    ERecord(_, fields, _) => {
      let mut ri = 0
      while ri < Array::length(fields) {
        let (_, fval) = Array::get(fields, ri)
        collect_free_vars_expr_sc(fval, bound, fn_names, encl, out)
        ri = ri + 1
      }
      0
    },
    ELabeledArg(_, _, arg_expr) => collect_free_vars_expr_sc(arg_expr, bound, fn_names, encl, out),
    _ => 0
  }
}

/// Array-taking compatibility entry: builds the membership index per call.
/// Fine for small fn_names (tests, perceus probes); HOT loops over the full
/// fn+ctor table must use collect_free_vars_indexed with a prebuilt index.
export fn collect_free_vars(body: Expr, param_names: Array[String], fn_names: Array[String]) -> Array[String] {
  collect_free_vars_indexed(body, param_names, sorted_names_of(fn_names))
}

/// #799 perf: index-taking entry -- the index is built ONCE per compile
/// (linked_compile) and reused for every lambda.
export fn collect_free_vars_indexed(body: Expr, param_names: Array[String], fn_name_index: Array[String]) -> Array[String] {
  collect_free_vars_indexed_sc(body, param_names, fn_name_index, common_analysis_fresh_string_array())
}

/// #1114: same, plus the ENCLOSING compile scope's local names -- a bare
/// inlined-builtin call callee that one of those shadows must be captured,
/// not inline-lowered. See collect_free_vars_expr's doc comment.
fn collect_free_vars_indexed_sc(body: Expr, param_names: Array[String], fn_name_index: Array[String], encl: Array[String]) -> Array[String] {
  let out = common_analysis_fresh_string_array()
  // Make a mutable copy of param_names for stack-based push/truncate
  let bound = Array::slice(param_names, 0, Array::length(param_names))
  collect_free_vars_expr_sc(body, bound, fn_name_index, encl, out)
  out
}

/// #875 fix 2: like collect_free_vars_indexed, but forces `self_name` (the
/// closure's OWN `let rec NAME = (...) -> { ... }` binding name, or "" for
/// "no self-reference to force") into the result when `body` genuinely
/// references it as a free (lexically unshadowed) identifier -- even if
/// `self_name` ALSO happens to collide, by bare string equality, with an
/// unrelated entry already present in `fn_name_index` (ctx.capture_name_index,
/// a shared whole-program name index used to skip capturing bona fide global
/// func/ctor references).
///
/// Why this is needed: collect_free_vars_expr's EIdent case treats ANY name
/// found in fn_name_index as "resolves globally, no capture needed" --
/// correct when the name really is only reachable as a global, but wrong when
/// it is ALSO the closure's own let-rec name. A `let rec check = (i) -> Bool
/// { ... check(i + 1) ... }` closure normally captures "check" as a free
/// variable precisely BECAUSE "check" is otherwise unknown to fn_name_index;
/// the failure mode only appears once some unrelated top-level function
/// (reachable via a widened whole-program-merge import graph, e.g. the
/// compile entry file's own unqualified top-level names) happens to share the
/// bare name "check". When that happens, compile_lambda's capture list
/// silently omits the self-reference, self_cap_idx (compile_expr_tail.vibe)
/// never fires, and the closure's own recursive call site falls through to
/// compile_call's func-table direct-call path -- calling the unrelated global
/// instead of itself (#875).
///
/// Implementation: re-run the SAME free-var walk with an EMPTY fn_name_index
/// (so nothing is excluded as "a global") whenever the normal result doesn't
/// already contain self_name -- this reuses collect_free_vars_expr's existing,
/// well-tested lexical-shadowing logic (bound push/truncate per scope) exactly
/// as-is, so a self_name that IS legitimately shadowed by an inner binding of
/// the same name (e.g. a nested lambda parameter also named "check") is still
/// correctly excluded, matching normal shadowing semantics. Only runs the
/// second walk in the (rare) collision case, so the common case -- no
/// collision, self_name already present -- costs one array-membership check.
/// `encl` (#1114): the enclosing compile scope's local names, so a bare
/// inlined-builtin call callee shadowed by one of them is captured instead
/// of inline-lowered. Pass an empty array for "no enclosing locals".
export fn collect_free_vars_indexed_self(body: Expr, param_names: Array[String], fn_name_index: Array[String], self_name: String, encl: Array[String]) -> Array[String] {
  let captures = collect_free_vars_indexed_sc(body, param_names, fn_name_index, encl)
  if self_name == "" || array_contains_str(captures, self_name) {
    captures
  } else {
    let no_globals = common_analysis_fresh_string_array()
    let unfiltered = collect_free_vars_indexed_sc(body, param_names, no_globals, encl)
    if array_contains_str(unfiltered, self_name) {
      Array::push(captures, self_name)
      captures
    } else {
      captures
    }
  }
}

/// The root identifier of a projection chain (EDot(...EDot(EIdent(root))...)), or
/// "" if `e` is not a projection. (ADR-0055 Stage 4: shared with compile_expr_tail
/// so function-tail param drops can detect an escaping projection of a param.)
export fn proj_root_ident(e: Expr) -> String {
  match e {
    EDot(obj, _, _, _) => proj_root_ident(obj),
    EIdent(nm, _) => nm,
    _ => ""
  }
}

/// #1272: the borrow-returning builtins -- each hands back an INTERIOR
/// reference into its first argument rather than a fresh value, so a scope
/// whose tail is one of these is escaping a pointer into the container, just
/// like `.field` does. Kept in sync with classify_let_value_heap's own
/// hardcoded list (codegen/expr/compile_expr_tail.vibe).
fn borrow_ret_builtin_name(nm: String) -> Bool {
  nm == "Array::get" || nm == "__index" || nm == "Map::get" || nm == "__rec_field"
}

/// The container a borrow-returning tail reads from: an identifier, a
/// projection chain rooted at one, or a nested borrow-returning read (an
/// element of an element is still interior to the same root).
fn borrow_tail_root(e: Expr) -> String {
  match e {
    EIdent(nm, _) => nm,
    EDot(obj, _, _, _) => borrow_tail_root(obj),
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if Array::length(args) >= 1 && borrow_ret_builtin_name(nm) {
        borrow_tail_root(Array::get(args, 0))
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

/// #1272: the bare identifier a scope's tail evaluates to, or "". Lets
/// scope_tail_proj_root see through a borrow that was bound to a local name
/// and then returned (`let r = Array::get(f, 1); r`) -- the same escape as
/// returning the read directly, just spelled with one more binding.
fn scope_tail_ident(e: Expr) -> String {
  match e {
    ELet(_, _, b, _) => scope_tail_ident(b),
    ELetMut(_, _, b, _) => scope_tail_ident(b),
    ELetRec(_, _, b) => scope_tail_ident(b),
    ESeq(_, b) => scope_tail_ident(b),
    EAssign(_, _, b) => scope_tail_ident(b),
    EAssignOp(_, _, _, b) => scope_tail_ident(b),
    EIdent(nm, _) => nm,
    _ => ""
  }
}

/// The container root of a borrow-returning CALL, and only a call: an alias is
/// interior to a container exactly when the value it was bound to is a
/// borrowing read.
fn borrow_call_root(e: Expr) -> String {
  match e {
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if Array::length(args) >= 1 && borrow_ret_builtin_name(nm) {
        borrow_tail_root(Array::get(args, 0))
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

/// If the *tail* (result) expression of a scope is a projection chain, return its
/// root identifier; otherwise "". Follows let/seq/assign wrappers to the tail.
///
/// #1272: an element read through a borrow-returning builtin counts as a
/// projection too. Only `EDot` used to, so a scope whose tail read an element
/// out of a container it OWNS -- `let f = [..]; Array::get(f, 1)`, or the same
/// shape at a function tail over a heap parameter -- dropped that container
/// without first retaining the value it was handing back. The caller received
/// a pointer into freed memory; nothing failed until a later allocation reused
/// the cell, so a single call looked correct and two calls returned garbage.
/// Callers use this exclusively to decide "dup the result before dropping the
/// owner", where over-reporting costs a retain (a leak at worst) and
/// under-reporting is the use-after-free above.
export fn scope_tail_proj_root(e: Expr) -> String {
  match e {
    // #1272: `let r = <borrowing read>; .. ; r` escapes the same interior
    // pointer as returning the read itself, so resolve the alias when the
    // scope's tail is exactly this binding and nothing nearer matched.
    ELet(n, v, b, _) => {
      let inner = scope_tail_proj_root(b)
      if inner == "" && scope_tail_ident(b) == n {
        borrow_call_root(v)
      } else {
        inner
      }
    },
    ELetMut(_, _, b, _) => scope_tail_proj_root(b),
    ELetRec(_, _, b) => scope_tail_proj_root(b),
    ESeq(_, b) => scope_tail_proj_root(b),
    EAssign(_, _, b) => scope_tail_proj_root(b),
    EAssignOp(_, _, _, b) => scope_tail_proj_root(b),
    EDot(obj, _, _, _) => proj_root_ident(obj),
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if Array::length(args) >= 1 && borrow_ret_builtin_name(nm) {
        borrow_tail_root(Array::get(args, 0))
      } else {
        ""
      },
      _ => ""
    },
    _ => ""
  }
}

/// Check if a mutable variable is captured by any nested EFn in the given expression
export fn is_mut_captured_in(expr: Expr, name: String) -> Bool {
  match expr {
    EIdent(_, _) => false,
    EInt(_) => false,
    EBool(_) => false,
    EFloat(_) => false,
    EString(_) => false,
    EUnit => false,
    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),
    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),
    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),
    ECall(callee, args, _) => if is_mut_captured_in(callee, name) {
      true
    }
    else {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if is_mut_captured_in(Array::get(args, i), name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    ELet(n, value, body, _) => if n == name {
      is_mut_captured_in(value, name)
    }
    else {
      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)
    },
    ELetRec(n, value, body) => if n == name {
      false
    }
    else {
      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)
    },
    ELetMut(n, value, body, _) => if n == name {
      is_mut_captured_in(value, name)
    }
    else {
      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)
    },
    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),
    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),
    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),
    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),
    EForIn(_, _, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),
    ETuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if is_mut_captured_in(Array::get(elems, i), name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EArray(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if is_mut_captured_in(Array::get(elems, i), name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EMatch(scrutinee, arms) => if is_mut_captured_in(scrutinee, name) {
      true
    }
    else {
      let mut i = 0
      let mut found = false
      while i < Array::length(arms) {
        let (_, arm_expr) = Array::get(arms, i)
        if is_mut_captured_in(arm_expr, name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EFn(_, _, params, _, _, fn_body) => {
      // Check if name is shadowed by params
      let mut shadowed = false
      let mut pi = 0
      while pi < Array::length(params) {
        let (pname, _) = Array::get(params, pi)
        if pname == name {
          shadowed = true
        }
        pi = pi + 1
      }
      if shadowed {
        false
      }
      else {
        // Check if name is free in this EFn
        let param_names = array_empty()
        let mut pi2 = 0
        while pi2 < Array::length(params) {
          let (pname2, _) = Array::get(params, pi2)
          Array::push(param_names, pname2)
          pi2 = pi2 + 1
        }
        let fv = collect_free_vars(fn_body, param_names, array_empty())
        if array_contains_str(fv, name) {
          true
        }
        else {
          // Also check recursively for deeper nesting
          is_mut_captured_in(fn_body, name)
        }
      }
    },
    EBreak(_) => false,
    EContinue(_) => false,
    EReturn(msg) => is_mut_captured_in(msg, name),
    // #629 step 2: forms that carry sub-expressions which may hold a capturing
    // closure. Previously these fell through to `_ => false`, so a mut captured
    // by a closure INSIDE a struct/record literal, handler, loop, projection,
    // labeled argument, map literal, or spread was not detected — the cell was
    // left a stack-local and the closure captured it by value (snapshot),
    // silently losing the shared mutation. Recursing here is always sound
    // (over-detection only boxes more).
    ERecord(_, fields, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        if is_mut_captured_in(fval, name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EMap(entries) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(entries) {
        let (_, mval) = Array::get(entries, i)
        if is_mut_captured_in(mval, name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EHandle(body, arms) => if is_mut_captured_in(body, name) {
      true
    } else {
      let mut i = 0
      let mut found = false
      while i < Array::length(arms) {
        let (_, arm_expr) = Array::get(arms, i)
        if is_mut_captured_in(arm_expr, name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    ELoop(params, body) => if is_mut_captured_in(body, name) {
      true
    } else {
      let mut i = 0
      let mut found = false
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        if is_mut_captured_in(init, name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EDot(obj, _, _, _) => is_mut_captured_in(obj, name),
    ELabeledArg(_, _, inner) => is_mut_captured_in(inner, name),
    ESpread(inner) => is_mut_captured_in(inner, name),
    _ => false
  }
}

/// Region-lifetime decision for a `let mut name` cell (#629 region inference).
/// Returns true when the cell must be heap-boxed because its region lifetime can
/// extend beyond the binding block (a capturing closure may escape); false keeps
/// it a plain stack-local (region = lexical block). Both backends gate boxing on
/// this single predicate (linear compile_expr_tail / wasm-gc backend_expr).
///
/// Step 1 baseline: a mut captured by ANY nested closure is conservatively
/// treated as escaping — identical to the prior `is_mut_captured_in` gate, so
/// behavior is unchanged. Later steps refine this into a real escape analysis
/// (a capture whose closure provably cannot escape its binding scope stays
/// stack-local). The predicate stays conservative: when escape cannot be ruled
/// out it returns true (box), which is always sound.
export fn mut_needs_ref_cell(body: Expr, name: String) -> Bool {
  is_mut_captured_in(body, name)
}

/// Builtins whose arg0 is BORROWED (read in place, not consumed/dropped). Kept
/// in sync with is_borrow_arg0_call in perceus/index.vibe.
export fn md_is_borrow_arg0_call(f: String) -> Bool {
  f == "__index" || f == "Array::get" || f == "Array::length" || f == "Array::set" || f == "Array::push" || f == "ArrayBuilder::push" || f == "MutList::push" || f == "StringBuilder::push" || f == "MapBuilder::set" || f == "Map::get" || f == "Map::keys" || f == "Map::has_key" || f == "Map::set" || f == "Bytes::push" || f == "Bytes::set" || f == "Bytes::get" || f == "Bytes::length" || f == "FrozenArray::get" || f == "FrozenArray::length" || f == "__rec_field"
}

fn md_max(a: Int, b: Int) -> Int {
  if a > b {
    a
  } else {
    b
  }
}

/// How many times is `name` consumed (owning position) along the LONGEST control
/// path of `e`? Used to balance the rc of a value that is referenced but NOT
/// owned at its definition site — a matched ctor field (a borrowed view sharing
/// the scrutinee's refcount; compile_match) or a captured free variable (a
/// borrowed view of the defining scope's binding; compile_lambda). Each owning
/// consume of such a value decrements a refcount it does not own, so the value
/// must be dup'd once PER consume or it is freed more times than dup'd -> double
/// free. Sequential children SUM; alternative children (if-branches, match/handle
/// arms) take the MAX, so the count is an upper bound on the consumes of any
/// executed path (>= actual everywhere -> never under-dup -> no double free;
/// tight on straight-line code -> no over-dup leak). MUST enumerate every Expr
/// variant (modeled on fold_expr): skipping recursion into a child could miss a
/// real consume and wrongly suppress the dup. A bare `EIdent(name)` passed as
/// arg0 of a borrow-arg0 builtin does not consume (it is read in place).
export fn md_consume_count(e: Expr, name: String) -> Int {
  match e {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EIdent(n, _) => if n == name {
      1
    } else {
      0
    },
    ETuple(items) => {
      let mut acc = 0
      let mut i = 0
      while i < Array::length(items) {
        acc = acc + md_consume_count(Array::get(items, i), name)
        i = i + 1
      }
      acc
    },
    EArray(items) => {
      let mut acc = 0
      let mut i = 0
      while i < Array::length(items) {
        acc = acc + md_consume_count(Array::get(items, i), name)
        i = i + 1
      }
      acc
    },
    ERecord(_, fields, _) => {
      let mut acc = 0
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        acc = acc + md_consume_count(v, name)
        i = i + 1
      }
      acc
    },
    EMap(fields) => {
      let mut acc = 0
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        acc = acc + md_consume_count(v, name)
        i = i + 1
      }
      acc
    },
    EIf(c, t, el) =>
    md_consume_count(c, name) + md_max(md_consume_count(t, name), md_consume_count(el, name)),
    ELet(_, v, b, _) => md_consume_count(v, name) + md_consume_count(b, name),
    ELetRec(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),
    ELetMut(_, v, b, _) => md_consume_count(v, name) + md_consume_count(b, name),
    EAssign(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),
    EAssignOp(_, _, v, b) => md_consume_count(v, name) + md_consume_count(b, name),
    ESeq(a, b) => md_consume_count(a, name) + md_consume_count(b, name),
    EMatch(s, arms) => {
      let mut mx = 0
      let mut i = 0
      while i < Array::length(arms) {
        let (_, v) = Array::get(arms, i)
        mx = md_max(mx, md_consume_count(v, name))
        i = i + 1
      }
      // A bare `match name { .. }` BORROWS the scrutinee (its fields become
      // borrowed views reclaimed by the owner's recursive drop); it does not
      // consume `name`. Counting it as a consume would over-dup a re-matched
      // borrowed tail (e.g. deeply-nested `match restN`), leaking/corrupting
      // the chain. A non-ident scrutinee may still consume `name` in a
      // sub-expression, so recurse there.
      let scr = match s {
        EIdent(_, _) => 0,
        _ => md_consume_count(s, name)
      }
      scr + mx
    },
    EHandle(s, arms) => {
      let mut mx = 0
      let mut i = 0
      while i < Array::length(arms) {
        let (_, v) = Array::get(arms, i)
        mx = md_max(mx, md_consume_count(v, name))
        i = i + 1
      }
      let scr = match s {
        EIdent(_, _) => 0,
        _ => md_consume_count(s, name)
      }
      scr + mx
    },
    EWhile(c, b) => md_consume_count(c, name) + md_consume_count(b, name),
    ELoop(params, b) => {
      let mut acc = md_consume_count(b, name)
      let mut i = 0
      while i < Array::length(params) {
        let (_, v) = Array::get(params, i)
        acc = acc + md_consume_count(v, name)
        i = i + 1
      }
      acc
    },
    EForIn(_, _, it, b) => md_consume_count(it, name) + md_consume_count(b, name),
    ECall(callee, args, _) => {
      let borrow0 = match callee {
        EIdent(f, _) => md_is_borrow_arg0_call(f),
        _ => false
      }
      let start = if borrow0 && Array::length(args) >= 1 {
        1
      } else {
        0
      }
      let head = if start == 1 {
        match Array::get(args, 0) {
          EIdent(_, _) => 0,
          _ => md_consume_count(Array::get(args, 0), name)
        }
      } else {
        0
      }
      // A bare-ident CALLEE is invoked, not consumed — calling a function or a
      // captured closure (incl. a recursive closure's own self-reference) does
      // not drop it. Counting `f(..)` as a consume of `f` over-dups the captured
      // closure once per call (#705: a nested self-recursive closure's self-
      // capture corrupted under RC). Only a non-ident callee can consume `name`
      // in a sub-expression.
      let callee_c = match callee {
        EIdent(_, _) => 0,
        _ => md_consume_count(callee, name)
      }
      let mut acc = callee_c + head
      let mut ri = start
      while ri < Array::length(args) {
        acc = acc + md_consume_count(Array::get(args, ri), name)
        ri = ri + 1
      }
      acc
    },
    EBinOp(_, l, r) => md_consume_count(l, name) + md_consume_count(r, name),
    EUnaryOp(_, x) => md_consume_count(x, name),
    EFn(_, _, _, _, _, body) => md_consume_count(body, name),
    EDot(x, _, _, _) => md_consume_count(x, name),
    ELabeledArg(_, _, v) => md_consume_count(v, name),
    EReturn(x) => md_consume_count(x, name),
    EBreak(opt) => match opt {
      Some(v) => md_consume_count(v, name),
      None => 0
    },
    EContinue(args) => {
      let mut acc = 0
      let mut i = 0
      while i < Array::length(args) {
        acc = acc + md_consume_count(Array::get(args, i), name)
        i = i + 1
      }
      acc
    },
    ESpread(x) => md_consume_count(x, name)
  }
}

//# #1259 step 7 groundwork: lambda-site counting

/// How many lambda table entries compiling `expr` will allocate.
///
/// compile_lambda takes a lambda's function index from the LIVE length of the
/// shared LambdaTable and emits it into the body as a `table_slot` immediate,
/// so a function's output bytes depend on how many lambdas every function
/// compiled before it produced. That is what stops a worker from compiling a
/// body on its own, and removing it is what a frozen WholeProgramPlan means
/// (docs/compiler-parallelism.md).
///
/// Counting is exact rather than an estimate: compile_expr dispatches EFn
/// (tag 24) to compile_lambda unconditionally (compile_expr_tail3.vibe), and
/// compile_lambda's push is unconditional, so one table entry per EFn node
/// reachable in the body -- nested lambdas included, since compile_lambda
/// compiles its own body through the same dispatch.
///
/// The traversal mirrors dce.vibe's collect_refs_into arm for arm. Binding
/// structure is irrelevant here (a count, not a scope analysis), so the arms
/// that clone a bound set there simply recurse.
///
/// It is a PREDICTION of what the sequential walk does, and it is checked
/// against the live length at every allocation rather than trusted -- see
/// CompileCtx.lambda_plan_next. A silent mismatch would key a body's emitted
/// constants to a table slot nothing installs.
export fn count_lambda_sites_expr(expr: Expr) -> Int {
  match expr {
    EIdent(_, _) => 0,
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EBreak(_) => 0,
    EContinue(_) => 0,
    EReturn(e) => count_lambda_sites_expr(e),
    EUnaryOp(_, e) => count_lambda_sites_expr(e),
    ESpread(e) => count_lambda_sites_expr(e),
    EDot(obj, _, _, _) => count_lambda_sites_expr(obj),
    ELabeledArg(_, _, e) => count_lambda_sites_expr(e),
    ETuple(items) => count_lambda_sites_exprs(items),
    EArray(items) => count_lambda_sites_exprs(items),
    ERecord(_, fields, _) => count_lambda_sites_fields(fields),
    EMap(fields) => count_lambda_sites_fields(fields),
    EBinOp(_, l, r) => count_lambda_sites_expr(l) + count_lambda_sites_expr(r),
    ESeq(l, r) => count_lambda_sites_expr(l) + count_lambda_sites_expr(r),
    ECall(callee, args, _) => count_lambda_sites_expr(callee) + count_lambda_sites_exprs(args),
    EIf(cond, then_e, else_e) =>
    count_lambda_sites_expr(cond) + count_lambda_sites_expr(then_e) + count_lambda_sites_expr(else_e),
    ELet(_, val, body, _) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),
    ELetRec(_, val, body) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),
    ELetMut(_, val, body, _) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),
    EAssign(_, val, body) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),
    EAssignOp(_, _, val, body) => count_lambda_sites_expr(val) + count_lambda_sites_expr(body),
    EWhile(cond, body) => count_lambda_sites_expr(cond) + count_lambda_sites_expr(body),
    EForIn(_, _, iter, body) => count_lambda_sites_expr(iter) + count_lambda_sites_expr(body),
    ELoop(params, body) => count_lambda_sites_fields(params) + count_lambda_sites_expr(body),
    EMatch(scr, arms) => count_lambda_sites_expr(scr) + count_lambda_sites_arms(arms),
    EHandle(body_expr, arms) => count_lambda_sites_expr(body_expr) + count_lambda_sites_arms(arms),
    // The one arm that counts: this node IS a table entry, and its body may
    // hold more.
    EFn(_, _, _, _, _, body) => 1 + count_lambda_sites_expr(body)
  }
}

fn count_lambda_sites_exprs(items: Array[Expr]) -> Int {
  let n = Array::length(items)
  let mut i = 0
  let mut total = 0
  while i < n {
    total = total + count_lambda_sites_expr(Array::get(items, i))
    i = i + 1
  }
  total
}

fn count_lambda_sites_fields(fields: Array[(String, Expr)]) -> Int {
  let n = Array::length(fields)
  let mut i = 0
  let mut total = 0
  while i < n {
    let (_, val) = Array::get(fields, i)
    total = total + count_lambda_sites_expr(val)
    i = i + 1
  }
  total
}

fn count_lambda_sites_arms(arms: Array[(Pat, Expr)]) -> Int {
  let n = Array::length(arms)
  let mut i = 0
  let mut total = 0
  while i < n {
    let (_, body) = Array::get(arms, i)
    total = total + count_lambda_sites_expr(body)
    i = i + 1
  }
  total
}
