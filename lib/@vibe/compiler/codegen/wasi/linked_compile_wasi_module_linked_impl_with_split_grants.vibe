        // the vibe_http_*_raw names above).
        "vibe_sh_capture_raw" => sh_capture_idx,
        "vibe_sh_capture_exit_code_raw" => sh_capture_exit_code_idx,
        "vibe_sh_capture_stdout_raw" => sh_capture_stdout_idx,
        "vibe_sh_capture_stderr_raw" => sh_capture_stderr_idx,
        "vibe_sh_capture_close_raw" => sh_capture_close_idx,
        "vibe_process_exit_raw" => process_exit_idx,
        "Stdin::read_stream" => stdin_read_stream_idx,
        "Stdout::write_stream" => stdout_write_stream_idx,
        "Stdout::write_char" => stdout_write_char_idx,
        // #865: Stderr, same shapes as the Stdout pair above.
        "Stderr::write_stream" => stderr_write_stream_idx,
        "Stderr::write_char" => stderr_write_char_idx,
        // #762: RAW host op behind Path::ref / Path::resolve.
        "resolve_path" => resolve_path_idx,
        "Profiler::now_us" => profiler_now_us_idx,
        "Profiler::NowUs" => profiler_now_us_idx,
        "Profiler::heap_bytes" => profiler_heap_bytes_idx,
        "Profiler::HeapBytes" => profiler_heap_bytes_idx,
        "sleep" => sleep_idx,
        // #1227: row-free sibling, same host import.
        "sleep_blocking" => sleep_idx,
        "Stdin::read_char" => stdin_read_char_idx,
        // #1460 Phase 1: the merged `Console` capability lowers onto the very
        // same host imports as the three effects it replaces -- the precedent
        // is `Profiler::now_us` / `Profiler::NowUs` above, two builtin names
        // sharing one index. The stderr pair is spelled apart here because one
        // effect cannot own two `write_stream` operations.
        "Console::read_stream" => stdin_read_stream_idx,
        "Console::read_char" => stdin_read_char_idx,
        "Console::write_stream" => stdout_write_stream_idx,
        "Console::write_char" => stdout_write_char_idx,
        "Console::write_err_stream" => stderr_write_stream_idx,
        "Console::write_err_char" => stderr_write_char_idx,
        // ADR-0089 step 4: raw halves of host_future_get (component adapter
