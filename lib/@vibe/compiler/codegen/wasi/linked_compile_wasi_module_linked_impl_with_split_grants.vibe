  // package-mangled function to the direct byte-scanning builtin. Keep this
  // exact: a prefix match would capture legal user functions such as
  // `__compact_fingerprint_hash_custom` and silently replace their bodies.
  let mut fingerprint_bridge_i = 0
  while fingerprint_bridge_i < Array::length(fn_names_list) {
    if Array::get(fn_names_list, fingerprint_bridge_i) == "__compact_fingerprint_hash_dep_lib__vibe_cache_cache_vibe" {
      Array::set(fn_indices_list, fingerprint_bridge_i, compact_fingerprint_hash_idx)
      Array::set(fn_needs_env_list, fingerprint_bridge_i, false)
    } else {
      ()
    }
    fingerprint_bridge_i = fingerprint_bridge_i + 1
  }
