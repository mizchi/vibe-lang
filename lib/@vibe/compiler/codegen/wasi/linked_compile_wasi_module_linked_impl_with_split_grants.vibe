        "vibe_hf_get_raw" => hf_get_idx,
        "vibe_hf_wait_raw" => hf_wait_idx,
        "vibe_hf_arm_raw" => hf_arm_idx,
        "vibe_hf_wait_any_raw" => hf_wait_any_idx,
        "vibe_hs_arm_raw" => hs_arm_idx,
        "vibe_hf_sleep_arm_raw" => hsl_arm_idx,
        "vibe_hf_cancel_raw" => hf_cancel_idx,
        "vibe_hs_cancel_raw" => hs_cancel_idx,
        "vibe_hf_arg_push_raw" => hf_arg_push_idx,
        "vibe_hf_sleep_cancel_raw" => hsl_cancel_idx,
        "vibe_hs_claim_raw" => hs_claim_idx,
