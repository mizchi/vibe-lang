  let stdin_read_stream_idx = linked_host_plan.stdin_read_stream_idx
  let stdin_read_stream_import_idx = linked_host_plan.stdin_read_stream_import_idx
  let stdout_write_char_idx = linked_host_plan.stdout_write_char_idx
  let stdout_write_char_import_idx = linked_host_plan.stdout_write_char_import_idx
  let stdout_write_stream_idx = linked_host_plan.stdout_write_stream_idx
  let stdout_write_stream_import_idx = linked_host_plan.stdout_write_stream_import_idx
  let str_char_code_at_idx = linked_host_plan.str_char_code_at_idx
  let str_concat_idx = linked_host_plan.str_concat_idx
  let str_eq_idx = linked_host_plan.str_eq_idx
  let str_from_char_code_idx = linked_host_plan.str_from_char_code_idx
  let str_len_idx = linked_host_plan.str_len_idx
  let str_lex_diff_idx = linked_host_plan.str_lex_diff_idx
  let str_operand_abort_idx = linked_host_plan.str_operand_abort_idx
  let str_substring_idx = linked_host_plan.str_substring_idx
  let string_contains_idx = linked_host_plan.string_contains_idx
  let string_ends_with_idx = linked_host_plan.string_ends_with_idx
  let string_index_of_idx = linked_host_plan.string_index_of_idx
  let string_join_idx = linked_host_plan.string_join_idx
  let string_last_index_of_idx = linked_host_plan.string_last_index_of_idx
  let string_split_idx = linked_host_plan.string_split_idx
  let string_starts_with_idx = linked_host_plan.string_starts_with_idx
  let string_trim_idx = linked_host_plan.string_trim_idx
  let tcp_close_idx = linked_host_plan.tcp_close_idx
  let tcp_close_import_idx = linked_host_plan.tcp_close_import_idx
  let tcp_connect_idx = linked_host_plan.tcp_connect_idx
  let tcp_connect_import_idx = linked_host_plan.tcp_connect_import_idx
  let tcp_read_idx = linked_host_plan.tcp_read_idx
  let tcp_read_import_idx = linked_host_plan.tcp_read_import_idx
  let tcp_write_idx = linked_host_plan.tcp_write_idx
  let tcp_write_import_idx = linked_host_plan.tcp_write_import_idx
  let guard_import_names_now = sorted_names_of(Map::keys(used_builtin_names))
  let mut __gim = 0
  while __gim < Array::length(linked_import_names) {
    Array::push(guard_import_names_now, Array::get(linked_import_names, __gim))
    __gim = __gim + 1
  }
  // Global name-membership guard: compile_call's `prefer_bound_call` and the
  // func-table lookups match the SPELLED name across the whole program, and
  // only builtin-spelled names take those branches. Prefix defs are #716
  // path-mangled (`_exp_`/`_dep_` marker), so the names that can flip such a
  // branch are the unmangled source-region ones. `__test_`/`__bench_` blocks
  // are excluded -- nothing calls a test by name -- which is what keeps the
  // append-a-test edit inside the cache.
  let guard_unmangled_now = if pin_region_capacity >= 0 {
    let raw = lc_fresh_string_array()
    let mut __gun = 0
    while __gun < pin_region_src_n {
      let __gname = Array::get(fn_names_list, __gun)
      if !String::contains(__gname, "_exp_") && !String::contains(__gname, "_dep_") && !String::starts_with(__gname, "__test_") && !String::starts_with(__gname, "__bench_") {
        Array::push(raw, __gname)
      } else {
        ()
      }
      __gun = __gun + 1
    }
    sorted_names_of(raw)
  } else {
    lc_fresh_string_array()
  }
  if pin_region_capacity >= 0 && !late_dce_rewrote_bodies {
    Array::push(body_cache_out.guard_meta, pin_region_src_n)
    Array::push(body_cache_out.guard_meta, pin_region_capacity)
    Array::push(body_cache_out.guard_meta, lambda_slot_base)
    Array::push(body_cache_out.guard_meta, num_imported_funcs)
    Array::push(body_cache_out.guard_meta, num_generated)
    let mut __gsy = pin_region_capacity
    while __gsy < num_user_funcs {
      Array::push(body_cache_out.guard_synth_names, Array::get(fn_names_list, __gsy))
      Array::push(body_cache_out.guard_synth_stmts, Array::get(fn_stmt_indices, __gsy))
      __gsy = __gsy + 1
    }
    let mut __gin = 0
    while __gin < Array::length(guard_import_names_now) {
      Array::push(body_cache_out.guard_import_names, Array::get(guard_import_names_now, __gin))
      __gin = __gin + 1
    }
    // ADR-0092 borrow-parameter ABI (call-site sensitive: an edit anywhere
    // can flip an unchanged function's owned/borrowed parameter, changing
    // its drop obligations and every caller's dup obligations). Names are
    // sorted with masks aligned by construction.
    let mut __gbn = 0
    while __gbn < Array::length(lc_borrow_param_user_srt) {
      Array::push(body_cache_out.guard_borrow_names, Array::get(lc_borrow_param_user_srt, __gbn))
      Array::push(body_cache_out.guard_borrow_masks, Array::get(lc_borrow_param_mask, __gbn))
      __gbn = __gbn + 1
    }
    let mut __gum = 0
    while __gum < Array::length(guard_unmangled_now) {
      Array::push(body_cache_out.guard_unmangled_names, Array::get(guard_unmangled_now, __gum))
      __gum = __gum + 1
    }
    // #2669 step 2b's `guard_layout` is recorded further down, once the
    // lambda plan exists -- it is the last of the program-wide inputs to be
    // computed.
  }
  // #2669 step 2a: which of THIS build's user function names identify one
  // function. A name the current build duplicates cannot be used to find a
  // body, whatever the cache happens to hold for it.
  let lc_user_fn_names = lc_fresh_string_array()
  let mut lc_ufn_i = 0
  while lc_ufn_i < num_user_funcs {
    Array::push(lc_user_fn_names, Array::get(fn_names_list, lc_ufn_i))
    lc_ufn_i = lc_ufn_i + 1
  }
  let lc_name_unique = unique_name_flags(lc_user_fn_names)
  let body_cache_in_ok = if Array::length(body_cache_in.fn_indices) == 0 {
    true
  } else if pin_region_capacity < 0 {
    // This compile did not run the pin reorder. Either the stmts were
    // already lowered by an earlier compile in this same process (#1259's
    // replay/sliced lanes re-feed the SAME mutated array, whose layout is
    // exactly the harvest's -- the earlier compile's pads and synthesized
    // lets now read as source names, so the reorder is a no-op skip), or
    // the program has no synthesized functions at all. In both cases the
    // incoming cache came from this identical layout; the cross-compile
    // lane never lands here, because a fresh closure compile always
    // lowers, always synthesizes, and therefore always reorders.
    true
  } else if Array::length(body_cache_in.guard_meta) == 0 {
    // Guard-less but non-empty under a reordering compile: only hand-built
    // test caches look like this (a real harvest of a reordering compile
    // records guards, and codegen_body_cache_filter_src_below empties a
    // guard-less cache before it can cross compiles). Accept unchanged.
    true
  } else {
    !late_dce_rewrote_bodies && Array::length(body_cache_in.guard_meta) == 5 && Array::get(body_cache_in.guard_meta, 0) == pin_region_src_n && Array::get(body_cache_in.guard_meta, 1) == pin_region_capacity && Array::get(body_cache_in.guard_meta, 2) == lambda_slot_base && Array::get(body_cache_in.guard_meta, 3) == num_imported_funcs && Array::get(body_cache_in.guard_meta, 4) == num_generated && Array::length(body_cache_in.guard_synth_names) == num_user_funcs - pin_region_capacity && bcc_guard_synth_matches(body_cache_in, fn_names_list, fn_stmt_indices, pin_region_capacity, num_user_funcs) && bcc_string_lists_equal(body_cache_in.guard_import_names, guard_import_names_now) && bcc_string_lists_equal(body_cache_in.guard_borrow_names, lc_borrow_param_user_srt) && bcc_int_lists_equal(body_cache_in.guard_borrow_masks, lc_borrow_param_mask) && bcc_string_lists_equal(body_cache_in.guard_unmangled_names, guard_unmangled_now)
  }
  let fn_indices_list = lc_fresh_int_array()
  let fn_returns_list = lc_fresh_int_array()
  let mut fi = 0
  while fi < num_user_funcs {
    Array::push(fn_indices_list, fi + func_offset)
    Array::push(fn_returns_list, 1)
    fi = fi + 1
  }
  let builtin_names_list = lc_fresh_string_array()
  let builtin_param_counts = lc_fresh_int_array()
  let builtin_needs_env_list = lc_fresh_bool_array()
  let builtin_indices_list = lc_fresh_int_array()
  let builtin_returns_list = lc_fresh_int_array()
  // #415 B-1: the central registry DRIVES the linear lane's registration.
  // Names, param counts, and returns come straight from builtin_registry()
  // rows with in_linear = true; only the function INDEX is lane-local (the
  // idx bindings computed above), resolved by the match below. Adding a
  // linear builtin = one registry row + one match arm here (+ the import /
  // body wiring); param-count and returns live ONLY in the registry.
  // needs_env is false for every static builtin -- only the linked-import
  // bridges appended after verify carry an env. vibe_rc_drop/vibe_rc_alloc
  // register under RC builds only (mirrored by verify_lane_builtins'
  // vibe_rc_ exemption).
  let registry_rows = builtin_registry()
  let mut reg_i = 0
  while reg_i < Array::length(registry_rows) {
    let (reg_name, reg_params, reg_returns, reg_linear, _) = Array::get(registry_rows, reg_i)
    let reg_include = reg_linear && (enable_rc || !String::starts_with(reg_name, "vibe_rc_"))
    if reg_include {
      let reg_idx = match reg_name {
        "Env::get" => env_get_idx,
        "Env::args_len" => env_args_len_idx,
        "Env::args_get" => env_args_get_idx,
        "Fs::read_file" => fs_read_file_idx,
        "Fs::exists" => fs_exists_idx,
        "Fs::stat_token" => fs_stat_token_idx,
        // #795: alias-collision-proof name, same import index as Fs::stat_token.
        "vibe_fs_stat_token_raw" => fs_stat_token_idx,
        "Fs::write_file" => fs_write_file_idx,
        "Fs::publish_immutable_text" => fs_publish_immutable_text_idx,
        "Fs::write_bytes" => fs_write_bytes_idx,
        "Fs::read_bytes" => fs_read_bytes_idx,
        // #729/#730: RAW half of Fs::readdir -- compile_call lowers the surface.
        "vibe_fs_read_dir_raw" => fs_read_dir_idx,
        "Fs::remove" => fs_remove_idx,
        "Fs::remove_file" => fs_remove_file_idx,
        "Fs::remove_tree" => fs_remove_tree_idx,
        "Fs::mkdir_p" => fs_mkdir_p_idx,
        "Fs::mkdir" => fs_mkdir_idx,
        "Fs::chdir" => fs_chdir_idx,
        "Fs::copy" => fs_copy_idx,
        "Fs::append" => fs_append_idx,
        "Fs::rename" => fs_rename_idx,
        "Fs::is_dir" => fs_is_dir_idx,
        "Fs::is_file" => fs_is_file_idx,
        "Fs::getcwd" => fs_getcwd_idx,
        "vibe_tcp_connect_raw" => tcp_connect_idx,
        "vibe_tcp_read_raw" => tcp_read_idx,
        "vibe_tcp_write_raw" => tcp_write_idx,
        "vibe_tcp_close_raw" => tcp_close_idx,
        // #794: HTTP client host ops (raw dunder surface names, see checker/builtins_net.vibe).
        "vibe_http_request_raw" => http_request_idx,
        "vibe_http_response_status_raw" => http_response_status_idx,
        "vibe_http_response_header_raw" => http_response_header_idx,
        "vibe_http_response_body_raw" => http_response_body_idx,
        "vibe_http_close_raw" => http_close_idx,
        "sh" => sh_idx,
        // RAW half of sh_lines -- compile_call lowers the Array[String] surface.
        "vibe_sh_lines_raw" => sh_lines_idx,
        // #865: structured subprocess result (raw dunder names -- called
