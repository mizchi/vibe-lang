  let arr_concat_idx = linked_host_plan.arr_concat_idx
  let arr_get_idx = linked_host_plan.arr_get_idx
  let arr_len_idx = linked_host_plan.arr_len_idx
  let arr_new_idx = linked_host_plan.arr_new_idx
  let arr_push_all_idx = linked_host_plan.arr_push_all_idx
  let arr_push_idx = linked_host_plan.arr_push_idx
  let arr_set_idx = linked_host_plan.arr_set_idx
  let arr_slice_idx = linked_host_plan.arr_slice_idx
  let arr_truncate_idx = linked_host_plan.arr_truncate_idx
  let array_capacity_idx = linked_host_plan.array_capacity_idx
  let bytes_append_idx = linked_host_plan.bytes_append_idx
  let bytes_blit_idx = linked_host_plan.bytes_blit_idx
  let bytes_capacity_idx = linked_host_plan.bytes_capacity_idx
