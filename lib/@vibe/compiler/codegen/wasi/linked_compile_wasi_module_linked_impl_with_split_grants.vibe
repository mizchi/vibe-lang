        "Bytes::slice" => bytes_slice_idx,
        "__to_string" => identity_idx,
        "vibe_rc_drop" => rc_drop_idx,
        "vibe_rc_dup" => rc_dup_idx,
        "vibe_rc_alloc" => rc_alloc_idx,
        "vibe_heap_grow_check" => heap_grow_check_idx,
        _ => 0 - 1
      }
      if reg_idx < 0 {
        throw("builtin registry drift: no linear function-index mapping for builtin '\{reg_name}' (add a match arm in linked_compile.vibe, #415)")
      } else {
        ()
      }
      Array::push(builtin_names_list, reg_name)
      Array::push(builtin_param_counts, reg_params)
      Array::push(builtin_needs_env_list, false)
      Array::push(builtin_indices_list, reg_idx)
      Array::push(builtin_returns_list, reg_returns)
    } else {
      ()
    }
    reg_i = reg_i + 1
  }
  // #415 B-0: the static registration above must agree with the central
  // registry (name set + params + returns, both directions). Placed BEFORE
  // the linked_imports loop — those are user-declared effect bridges with
  // dynamic names, not builtins.
  verify_lane_builtins("linear", builtin_names_list, builtin_param_counts, builtin_returns_list)
  // ADR-0089 (c) (#1218): the per-name host-future getters. Registered AFTER
  // the registry cross-check above on purpose -- these names are minted from
  // the PROGRAM (one per `host_future_named("...")` import name), so they
  // cannot appear in the static builtin_registry() the check compares
  // against. Shape is fixed and identical for all of them: `() -> Int`, no
  // env, index = the reserved import (see hf_named_import_indices).
  let mut hf_reg_i = 0
  while hf_reg_i < Array::length(hf_all_names) {
    Array::push(builtin_names_list, String::concat(cc_host_future_named_raw_prefix(), Array::get(hf_all_names, hf_reg_i)))
    Array::push(builtin_param_counts, 0)
    Array::push(builtin_needs_env_list, false)
    Array::push(builtin_indices_list, Array::get(hf_named_import_indices, hf_reg_i))
    Array::push(builtin_returns_list, 1)
    hf_reg_i = hf_reg_i + 1
  }
  // ADR-0089 Decision 3 (#1218): the per-name host-stream getters --
  // program-minted like the host-future getters above, same fixed shape
  // (`() -> Int`, no env, index = the reserved import).
  let mut hs_reg_i = 0
  while hs_reg_i < Array::length(hs_named_names) {
    Array::push(builtin_names_list, String::concat(cc_host_stream_named_raw_prefix(), Array::get(hs_named_names, hs_reg_i)))
    Array::push(builtin_param_counts, 0)
    Array::push(builtin_needs_env_list, false)
    Array::push(builtin_indices_list, Array::get(hs_named_import_indices, hs_reg_i))
    Array::push(builtin_returns_list, 1)
    hs_reg_i = hs_reg_i + 1
  }
  let mut li_reg = 0
  while li_reg < Array::length(linked_imports) {
    let (_, lfn_name, lparams, lreturns) = Array::get(linked_imports, li_reg)
    Array::push(builtin_names_list, lfn_name)
    Array::push(builtin_param_counts, lparams)
    Array::push(builtin_needs_env_list, true)
    Array::push(builtin_indices_list, Array::get(linked_import_indices, li_reg))
    Array::push(builtin_returns_list, lreturns)
    li_reg = li_reg + 1
  }
  // #3115 review: read before the builtin names are appended below --
  // afterwards `fn_names_list` always holds every builtin. A user entry comes
  // first, so a call spelled like a builtin resolves to it. The truncate
  // release rests on the builtin semantics of all five of these: a fresh
  // `Array::with_capacity`, receivers that neither keep nor escape the array,
  // and a truncate that actually shortens it.
  let user_shadows_trunc_builtins = array_contains_str(fn_names_list, "Array::truncate") || array_contains_str(fn_names_list, "Array::with_capacity") || array_contains_str(fn_names_list, "Array::push") || array_contains_str(fn_names_list, "Array::length") || array_contains_str(fn_names_list, "Array::get")
  let mut all_fn_i = 0
  while all_fn_i < Array::length(builtin_names_list) {
    Array::push(fn_names_list, Array::get(builtin_names_list, all_fn_i))
    Array::push(fn_param_counts, Array::get(builtin_param_counts, all_fn_i))
    Array::push(fn_needs_env_list, Array::get(builtin_needs_env_list, all_fn_i))
    Array::push(fn_indices_list, Array::get(builtin_indices_list, all_fn_i))
    Array::push(fn_returns_list, Array::get(builtin_returns_list, all_fn_i))
    all_fn_i = all_fn_i + 1
  }
  // Bootstrap bridge for @vibe/cache: an older compiler sees and emits the
