        "vibe_stdin_provider_read_raw" => stdin_provider_read_idx,
        "vibe_stdin_provider_close_raw" => stdin_provider_close_idx,
        "Stdin::read_via_stream" => stdin_provider_acquire_idx,
        "StdinStream::next" => stdin_provider_read_idx,
