/// #2158: every linked compile, with the CHECKER's Double call-result offsets
/// as an extra input.
///
/// Only the entries that (a) run a whole-program check and (b) parsed that
/// program over ONE coherent offset space pass a non-empty array here.
/// `compile_wasi_module_linked_impl` below forwards an empty one, which is the
/// fail-closed default: an empty table classifies nothing, so those lanes keep
/// the pre-#2158 syntactic answer byte for byte.
/// The printer the split path needs, for a caller on the whole-program path.
/// `module_split_none()` fails `module_split_usable`, so the split path is not
/// reached and this is never called. It is NOT a printer and must not become
/// one -- a caller that wants the split path passes a real one.
export fn lc_render_unused(_s: Stmt) -> String {
  ""
}

/// Pre-#2828-rung-2 arity: no launcher grants (fail-closed).
export fn compile_wasi_module_linked_impl_with_typed_offsets(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool, enable_rc: Bool, coverage: Bool, debug_trace: Bool, debug_break: Bool, rc_shadow: Bool, enable_late_dce: Bool, prov: DbgProv, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, slice_lo: Int, slice_hi: Int, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String]) -> Bytes with Exception {
  compile_wasi_module_linked_impl_with_typed_offsets_grants(stmts, entry_name, srcs, linked_imports, library_mode, enable_rc, coverage, debug_trace, debug_break, rc_shadow, enable_late_dce, prov, body_cache_in, body_cache_out, slice_lo, slice_hi, checker_float_call_offsets, checker_int_render_offsets, checker_bool_render_offsets, checker_eq_offsets, checker_eq_type_keys, array_empty())
}

/// #2828 rung 2: the grant-carrying arity. The mvp and rc-shadow lanes
/// both converge here, so this is where their grants rejoin the rc lane's.
export fn compile_wasi_module_linked_impl_with_typed_offsets_grants(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool, enable_rc: Bool, coverage: Bool, debug_trace: Bool, debug_break: Bool, rc_shadow: Bool, enable_late_dce: Bool, prov: DbgProv, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, slice_lo: Int, slice_hi: Int, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String], grants: Array[(String, String)]) -> Bytes with Exception {
  compile_wasi_module_linked_impl_with_split_grants(stmts, entry_name, srcs, linked_imports, library_mode, enable_rc, coverage, debug_trace, debug_break, rc_shadow, enable_late_dce, prov, body_cache_in, body_cache_out, slice_lo, slice_hi, checker_float_call_offsets, checker_int_render_offsets, checker_bool_render_offsets, checker_eq_offsets, checker_eq_type_keys, module_split_none(), lc_render_unused, grants)
}

/// #2575 item 2 step 3b: the same compile, given a `ModuleSplit`. The prelude
/// runs per module where the split describes the statements and whole-program
/// otherwise, and every guard fails open -- see `effect_lowering_prelude_split`.
/// Pre-#2828-rung-2 arity: no launcher grants, so optional capabilities
/// resolve `NotGranted`. Both existing callers keep using this.
export fn compile_wasi_module_linked_impl_with_split(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool, enable_rc: Bool, coverage: Bool, debug_trace: Bool, debug_break: Bool, rc_shadow: Bool, enable_late_dce: Bool, prov: DbgProv, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, slice_lo: Int, slice_hi: Int, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String], split: ModuleSplit, render: (Stmt) -> String) -> Bytes with Exception {
  compile_wasi_module_linked_impl_with_split_grants(stmts, entry_name, srcs, linked_imports, library_mode, enable_rc, coverage, debug_trace, debug_break, rc_shadow, enable_late_dce, prov, body_cache_in, body_cache_out, slice_lo, slice_hi, checker_float_call_offsets, checker_int_render_offsets, checker_bool_render_offsets, checker_eq_offsets, checker_eq_type_keys, split, render, array_empty())
}

/// #2828 rung 2: the grant-carrying arity. See the delegate below.
export fn compile_wasi_module_linked_impl_with_split_grants(stmts: Array[Stmt], entry_name_in: String, srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool, enable_rc: Bool, coverage: Bool, debug_trace: Bool, debug_break: Bool, rc_shadow: Bool, enable_late_dce: Bool, prov: DbgProv, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, slice_lo: Int, slice_hi: Int, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String], split: ModuleSplit, render: (Stmt) -> String, grants: Array[(String, String)]) -> Bytes with Exception {
  // #3132 review: `--entry StringBuilder::new` can name the program's own
  // function, which the rename moves to `StringBuilder::new$user`. Rename
  // first (idempotent, the prelude repeats it) so every lookup and DCE root
  // below sees one spelling; the export keeps the source one.
  rename_builtin_shadow_defs(stmts)
  let entry_name = builtin_shadow_entry_name(stmts, entry_name_in)
  // #1536(c)/#1511(b): the whole effect-lowering prefix lives in
  // effect_lowering_prelude (shared verbatim with `vibe check`); a first
  // error there is exactly the throw each pass used to raise inline here.
  let late_dce_has_entry = lc_defines_top_level(stmts, entry_name)
  let late_dce_roots = lc_late_dce_roots(stmts, entry_name, library_mode || coverage || debug_trace || debug_break || rc_shadow)
  let iw_names = lc_fresh_string_array()
  let iw_wats = lc_fresh_string_array()
  // #2388 step 2: everything the prelude APPENDS past this length is
  // compiler-synthesized (derived comparators, monoify specializations, the
  // __exn_kind_cell thunk, ...) -- the prelude is the container for every
  // AST-mutating pass, so this boundary is exact. The let-name snapshot of
  // the source prefix lets the padding step below verify, fail-safe, that
  // no pass inserted or renamed ahead of the boundary before it trusts it.
  let synth_boundary_stmt = Array::length(stmts)
  let pre_prelude_let_names = lc_fresh_string_array()
  // Interior-line breakpoints: the file each of those names came from, taken
  // while the positions `prov.stmt_file_id` is indexed by are still the
  // program's. See lc_dbg_file_of_fn -- after the prelude they are not.
  let pre_prelude_let_files = lc_fresh_int_array()
  let pre_prelude_let_stmts = lc_fresh_int_array()
  // #2199: the two lanes that READ this snapshot, decided by the parameters
  // alone so the scan below can be gated on them and the import reservations
  // further down can reuse the same answer. `dbg_line_on` is the live
  // `--break` probe; `linemap_on` is the static `vibe.linemap` table, which a
  // production RC compile carries too.
  let dbg_line_on = debug_break && Array::length(prov.files) > 0
  let linemap_on = dbg_line_on || (Array::length(prov.files) > 0 && Array::length(prov.file_nls) > 0)
  // The same, keyed by OWNER: what a lambda hoisted out of each statement
  // would name itself after (`hoisted_lambda_owner_of_stmt`, the hoist's own
  // arms rather than a mirror of them here).
  //
  // The condition is `linemap_on`, the predicate for "someone reads this",
  // not a proxy for it. It used to be "prov carries any stmt_file_id", which
  // was a PROXY for the break lane and correct only while the break lane was
  // the only caller that filled provenance (#2575 item 2 gives the ordinary
  // lane a real `stmt_file_id`); then `debug_break`, which was the same
  // mistake one lane later -- the production linemap reads the owner index
  // through `lc_dbg_file_of_fn` as well, and without these arrays a hoisted
  // lambda from any file but the first resolved to file 0 and reported a
  // fabricated path:line (Codex P2 on PR #2867). A compile with no newline
  // tables (every in-process lane, `linked_compile_prov_inert_test`) still
  // pays nothing; the FS lanes pay one `hoisted_lambda_owner_of_stmt` per
  // top-level statement, ~9.9k of them on the compiler's own closure, and
  // most of those return the declaration's own name with no allocation
  // (`dlh_owner_key_of` kind 0).
  let pre_prelude_owner_keys = lc_fresh_string_array()
  let pre_prelude_owner_files = lc_fresh_int_array()
  let dbg_prov_len = Array::length(prov.stmt_file_id)
  let mut __sbn_i = 0
  while __sbn_i < synth_boundary_stmt {
    // Kept exactly parallel to the names: one push into each per recorded
    // statement. A position the provenance does not cover (an empty
    // `DbgProv`, every non-break build) records file 0, which the lookup
    // never reads because `dbg_line_on` is false there.
    let __sbn_file = if __sbn_i < dbg_prov_len {
      Array::get(prov.stmt_file_id, __sbn_i)
    } else {
      0
    }
    if linemap_on {
      // EVERY statement, including the ones with no name to be known by. A
      // binderless `let _ = ..` holding an effectful local lambda gets an
      // anonymous owner from its POSITION (`:s:<idx>`), which is why the index
      // is passed: the recorder mints exactly that key, and a consumer that
      // recorded nothing for it left the hoisted body at file 0 (Codex round on
      // #2623). Same statement list, same index, so the two agree.
      Array::push(pre_prelude_owner_keys, hoisted_lambda_owner_of_stmt(Array::get(stmts, __sbn_i), __sbn_i))
      Array::push(pre_prelude_owner_files, __sbn_file)
    } else {
      ()
    }
    match Array::get(stmts, __sbn_i) {
      SLet(_, _, __sbn_name, _, _) => {
        Array::push(pre_prelude_let_names, __sbn_name)
        Array::push(pre_prelude_let_files, __sbn_file)
        Array::push(pre_prelude_let_stmts, __sbn_i)
      },
      // The test/bench lowering below rewrites these in place to
      // `SLet(__test_<name>, ...)` / `SLet(__bench_<name>, ...)` before the
      // padding step verifies the prefix, so record the POST-rewrite name.
      STest(__sbn_tname, _) => {
        Array::push(pre_prelude_let_names, String::concat("__test_", __sbn_tname))
        Array::push(pre_prelude_let_files, __sbn_file)
        Array::push(pre_prelude_let_stmts, __sbn_i)
      },
      SBench(__sbn_bname, _) => {
        Array::push(pre_prelude_let_names, String::concat("__bench_", __sbn_bname))
        Array::push(pre_prelude_let_files, __sbn_file)
        Array::push(pre_prelude_let_stmts, __sbn_i)
      },
      _ => ()
    }
    __sbn_i = __sbn_i + 1
  }
  // #2669 step 2b: name -> source file, for the cross-compile body cache.
  //
  // Taken from the same pre-prelude snapshot the break lane resolves a
  // function's file through, and for the same reason: after the prelude a
  // statement's POSITION is no longer the program's, so a cached entry cannot
  // be attributed to a file by where it sits. A name the snapshot does not
  // cover (a synthesized definition, a pad) answers -1, and so does a name two
  // files both declare -- an ambiguous owner is not an owner.
  //
  // `prov` has to cover the whole pre-prelude region for the ids to mean
  // anything: `__sbn_file` above records 0 for a position the provenance does
  // not reach, which would attribute every function to file 0. The FS lane
  // always fills it; the in-process lanes do not, and there the map is empty
  // and the widened filter keeps nothing.
  let lc_fn_file_of = if dbg_prov_len >= synth_boundary_stmt {
    lc_build_name_origin_index(pre_prelude_let_names, pre_prelude_let_files)
  } else {
    MutMap::new_string()
  }
  // Prefix limits use the original merged coordinates, before insertion or
  // DCE compaction. A duplicate name cannot identify one source statement.
  let lc_fn_stmt_of = lc_build_name_origin_index(pre_prelude_let_names, pre_prelude_let_stmts)
  let prelude_errs = effect_lowering_prelude_split_grants(stmts, entry_name, linked_imports, iw_names, iw_wats, checker_eq_offsets, checker_eq_type_keys, split, render, grants)
  if Array::length(prelude_errs) > 0 {
    throw(Array::get(prelude_errs, 0))
  } else {
    ()
  }
  // #1666: prune what the PIPELINE generated, not just what the source wrote.
  //
  // `dce_stmts` already runs once, in `compile_file_fs_mode`'s "mvp" mode --
  // but that is on the merged parse result, BEFORE `desugar_derives` exists.
  // Every `T::equals` / `T::to_string` / `T::compare` / `__arr_*` helper the
  // desugars emit is therefore created after the only reachability check and
  // never faces one: an enum that is declared and never used still shipped its
  // generated `equals` (measured: +247 bytes for a 5-variant enum, identical
  // in "mvp" and "no-dce").
  //
  // This is the one place where that is answerable without ordering questions.
  // `effect_lowering_prelude` above is the container for EVERY AST-mutating
  // pass -- desugar_trait_dicts, the `lc_inject_*` injectors,
  // evidence_dict_pass, suspend CPS -- and everything below only ANALYSES
  // `stmts`. No reference can appear after this line, so reachability computed
  // here is final. Placing it any earlier would have to answer "which later
  // pass can reference a name that is unreachable right now".
  //
  // Pruning is skipped unless `entry_name` actually names a top-level
  // definition. Rooting reachability at a name nothing defines makes the whole
  // program unreachable, and the program then compiles to an empty module
  // instead of reporting the real problem. Two ways in:
  //
  //   - `__no_entry__`: the component lanes' sentinel. A component's surface is
  //     its export (`handler`), not an entry.
  //   - a typo: `vibe build --entry mian` must still say "entry not found".
  //     The gate pins exactly this (ADR-0069 entry hardening), and it is what
  //     caught the first version of this guard, which special-cased only the
  //     sentinel.
  // #2721: removing unreachable declarations preserves the surviving bodies.
  // Their original statement positions are retained in `lc_fn_stmt_of`, so
  // DCE cannot move an edited body into the unchanged source-file prefix.
  // The normal layout guards still decide whether those bodies can replay.
  //
  // #2497 unit 2: before pruning, fold the Bool parameters every call in the
  // program fixes to one literal (`fold_const_bool_params`, core). The lane
  // switches of this very function are the motivating case: the compile-only
  // artifact passes `false` for every instrumented lane, so their arms fold
  // away here and the helpers only they called lose their last call site,
  // which `lc_pf_prune_module` below then removes. Gated exactly like the
  // prune: the pass reasons about EVERY call site, so it needs the
  // whole-program, entry-rooted compile, and a library (`library_mode`)
  // exports every function, so no parameter of one is constant. The
  // instrumented lanes are excluded the same way `lc_pf_prune_module` is
  // (Codex review on #2569): coverage counts branch sites from the source
  // `if`s, so folding one away would shrink the denominator and report a
  // higher branch rate for the same program; a debug-break build maps
  // interior lines onto the statements it emits, and a folded arm has none.
  // Those builds are about observing the program as written, so they get it
  // as written. The inline-wasm texts go along because the prelude has
  // already replaced the `%wasm` marker bodies with a neutral literal, so a
  // `(call $f ..)` in one of them is invisible to the pass's own scan.
  //
  // A folded body no longer matches its source text, so a fold still refuses
  // the body-cache guards below (`late_dce_rewrote_bodies`): a replayed
  // body from a compile whose other call sites passed a different literal
  // would be silently wrong, and refusing the cache for that compile is the
  // honest answer.
  let mut late_dce_rewrote_bodies = false
  if enable_late_dce && late_dce_has_entry {
    let folded_param_reads = if library_mode || coverage || debug_trace || debug_break || rc_shadow {
      0
    } else {
      fold_const_bool_params(stmts, entry_name, iw_wats)
    }
    lc_late_dce_wat_roots(late_dce_roots, stmts, iw_names, iw_wats)
    let dce_pruned = dce_stmts(stmts, late_dce_roots)
    // `stmts` is threaded onward by reference, so the pruned program has to
    // replace its contents rather than rebind the name. `dce_stmts` builds a
    // fresh array, so this never reads what it is overwriting.
    Array::truncate(stmts, 0)
    let mut dce_i = 0
    while dce_i < Array::length(dce_pruned) {
      Array::push(stmts, Array::get(dce_pruned, dce_i))
      dce_i = dce_i + 1
    }
    late_dce_rewrote_bodies = folded_param_reads > 0
  } else {
    ()
  }
  // #3150 / #3189 review: whether a host STREAM read survived is a fact about
  // the program the prune LEFT, like the host-future half below
  // (`lc_stmts_call_host_future`). Asked before the prune it over-counts: the
  // prelude injects the read path for every read WRITTEN, including one in an
  // arm `fold_const_bool_params` just removed, and the hooks then armed a
  // stream nothing reads -- a component with no host stream failed to build
  // ("host_stream_cancel without a host stream"). Asked as "is `__hs_next`
  // still defined" it under-counts (#3150): see lc_program_keeps_stream_read.
  // Read BEFORE the analyses below so the settle rewrite is what they see.
  let lc_stream_reads_survive = lc_program_keeps_stream_read(stmts)
  if lc_stream_reads_survive {
    ()
  } else {
    lc_settle_drop_stream_band(stmts)
  }
  // #2652: the Double runtime prelude (`__vibe_double_to_string` /
  // `__vibe_double_parse`, codegen/common_base/double_runtime.vibe) joins the
  // program HERE: after every AST-mutating pass and the reachability prune,
  // so nothing rewrites or drops it, and before the analyses below, so the
  // borrow masks, float-returning and heap-returning names see it like any
  // other function. It is emitted only when the program can hold a Double,
  // and the module-level late DCE removes it when nothing calls it.
  append_double_runtime(stmts)
  // PR #2708 review: the String length-view runtime prelude (WHATWG
  // replacement decoding), appended under the same rules.
  append_string_views_runtime(stmts)
  // Named and anonymous callbacks share the owning return ABI. Rewrite named
  // bodies before the analyses so direct calls receive that same contract.
  // Read direct parameter passthroughs before cl_own_return_stmts can wrap
  // their tails in compiler-internal owning-return markers.
  let lc_passthrough_ret_params = compute_passthrough_returning(stmts)
  let lc_owned_return_names = if enable_rc {
    cl_own_return_stmts(stmts)
  } else {
    lc_fresh_string_array()
  }
  // #707: functions whose entire body is transitively a tail-call to a
  // borrow-returning builtin (Array::get/Map::get/__index) -- e.g. a thin
  // `peek(toks, pos) -> Array::get(toks, pos)` wrapper. Computed once over the
  // whole merged program and threaded into every function's Perceus plan so a
  // `let v = peek(...)` binding (including the match-scrutinee-lift's
  // `let __m_scrut = peek(...)`, see normalize/index.vibe) is recognized the
  // same as a direct `let v = Array::get(...)` one.
  // Sorted immediately (membership-only from here on: cc_is_borrow_ret_call /
  // classify_let_value_heap query it once per call site across the whole
  // program) so those lookups are bsearch_leftmost instead of a linear scan
  // -- same rationale as ctor_table.names_sorted above.
  let lc_borrow_ret_names = sorted_names_of(compute_borrow_returning_names(stmts))
  // ADR-0092 borrow-inference: program-wide source function borrow masks
  // (read-only, never valued/aliased -- see compute_borrow_param_user_fns).
  // Source-owned shadowable builtins remain present with mask zero when they
  // consume every parameter. The entry fn and conventional entry names are
  // excluded: the host invokes them without consulting the set.
  //
  // Slice 1 (#1282) inferred POSITION 0 only; this is the per-position
  // generalization, so a fn that consumes param0 but only reads param2 now
  // borrows param2. Bit 0 of every mask is exactly slice 1's set.
  //
  // ADR-0092 borrow-inference, per-use-paired accounting. The
  // planner's invariant per binding: acquisitions (initial owned ref +
  // dups) must equal releases (owned consumes + scope-end drop). A
  // view-call binding (value = call to a lc_borrow_view_ret fn) holds NO
  // initial owned reference, so (a) its LAST owned use must dup instead
  // of spending the phantom initial ref (pe_use / the ELet alias mirror)
  // and (b) its scope-end / seq-temp drop is suppressed unconditionally
  // (pe_scope_end) -- not just when all its uses are borrows, which was
  // the round-3 condition that left latent over-releases behind whenever
  // a view binding also had owned consumes or was never used at all.
  // Earlier isolated classes, still covered: fresh-result leak (marking
  // restricted to compute_may_return_view_fns callees, intersected into
  // lc_borrow_view_ret -- a fresh result from a may-return-view callee
  // still leaks, bounded, safe direction), temp-argument leak (a POSITION
  // ever passed a non-ident argument is disqualified via
  // ca_collect_nonident_args), and the lexical-shadow holes (a local
  // shadowing a borrow-set name is an ordinary owned call: pc_count /
  // pc_emit / pctx_mark_view_call all guard on scope, mirroring
  // compile_call's #875 local_idx_hint guard). Known conservative gaps:
  // loop params bound to a view-call init are not marked (their
  // back-edge rebinds make ownership flow-dependent), and a view call
  // reaching a binding through an if/match VALUE position is unmarked
  // (treated owned).
  let lc_borrow_arg0_enabled = true
  // Names arrive SORTED with the masks already aligned to them (the analysis
  // sorts and re-reads the masks by name in one place, so no caller can
  // misalign them). Sorting matters: every membership test on the borrow set
  // -- pc_count / pc_emit per call site, compile_call's borrows_this per
  // call, the md consume-count borrow test -- is a bsearch_leftmost instead
  // of a 500+-name linear scan (profiled at ~35% of selfcompile CPU as
  // array_contains_str + __rt_eq/__rt_str_eq/__rt_arr_get traffic).
  let lc_borrow_param_mask = lc_fresh_int_array()
  let lc_borrow_param_user_srt = if lc_borrow_arg0_enabled {
    compute_borrow_param_user_fns(stmts, lc_analysis_exclude(entry_name), lc_borrow_param_mask)
  } else {
    lc_fresh_string_array()
  }
  // Fns whose RETURN may be an unowned interior view: these mark
  // view_call_let in the planner (see PCtx.view_ret_user and the gate
  // comment above). NOT intersected with the borrow-param set: a callee
  // returns a view regardless of whether any of its params qualified for the
  // borrowed ABI (e.g. a fn disqualified by a non-ident argument call site
  // still hands back an interior view whose binding must not be dropped)
  // -- the round-3 intersection left exactly those bindings with a
  // release they never acquired.
  let lc_borrow_view_ret = if lc_borrow_arg0_enabled {
    sorted_names_of(compute_may_return_view_fns(stmts))
  } else {
    lc_fresh_string_array()
  }
  // #2386: the perceus pass keeps one cached context for these four tables
  // and used to re-compare all four, whole, at every function; pin them once
  // and present the token per function (and per lambda, via CompileCtx).
  let lc_perceus_pin = perceus_pin_tables(lc_borrow_ret_names, lc_borrow_param_user_srt, lc_borrow_param_mask, lc_borrow_view_ret)
  // #710: see CompileCtx.scalar_ret_names' doc comment (common_base/common_base.vibe).
  let lc_scalar_ret_names = sorted_names_of(compute_scalar_returning_names(stmts))
  let fn_names_list = lc_fresh_string_array()
  // #2158: one shared walk, in common_analysis -- see its doc comment for why
  // this is not inlined here any more (#2156 review).
  let float_ret_fn_names = compute_float_returning_names(stmts)
  // #2158: the checker's offset-keyed answer, narrowed to the offsets that name
  // exactly ONE call node in the statements below. Deliberately computed HERE,
  // after `effect_lowering_prelude` above has finished rewriting `stmts`, so
  // the uniqueness is proven against the program codegen actually compiles
  // rather than against whatever the entry handed the checker. Empty in, empty
  // out, without a walk.
  let float_call_offsets = unique_typed_lowering_offsets_in_stmts(stmts, checker_float_call_offsets)
  // #2424: the Int (tag 3) and Bool (tag 5) render-argument tables are
  // installed RAW, and the filter above must not be extended to them.
  //
  // What makes the raw install honest is the checker's agreement rule: an
  // offset is filed only when EVERY typed occurrence there resolves to the
  // wanted type, so a call offset shared with the `CtFn` occurrence of its
  // callee is dropped on disagreement.
  //
  // The reason NOT to filter is stronger than "it is unnecessary" -- the
  // filter and these tables disagree about what a key is, so applying it
  // deletes rows (#2427). `count_typed_lowering_offsets_expr` counts `ECall`
  // and `EDot` and deliberately not `EIdent`, since a call's own offset IS its
  // callee identifier's offset. But tags 3 and 5 key an argument by
  // `typed_lowering_arg_offset`, which DOES answer for `EIdent`, and a bare
  // name is the commonest render argument there is. Measured, one row each:
  //
  //   inspect(v, ..)    name        1 -> 0   dropped
  //   inspect(n(), ..)  call        1 -> 1   kept
  //   inspect(s.a, ..)  projection  1 -> 1   kept
  //
  // `inspect(<name>, ..)` is the repo's preferred assertion idiom, so the
  // symmetric-looking hardening would delete most of the channel at its most
  // common site and restore the syntactic classifier tags 3 and 5 exist to
  // replace (#2462, #2464). The Double table is immune because
  // `typed_lowering_float_key` answers -1 for `EIdent` and never files a
  // name-keyed row. Pinned by tests/typed_lowering_filter_key_space_test.vibe.
  let int_render_offsets = checker_int_render_offsets
  let bool_render_offsets = checker_bool_render_offsets
  let fn_param_counts = lc_fresh_int_array()
  let fn_needs_env_list = lc_fresh_bool_array()
  let fn_stmt_indices = lc_fresh_int_array()
  let thunk_names_list = lc_fresh_string_array()
  let const_int_names_list = lc_fresh_string_array()
  let const_int_values_list = lc_fresh_int_array()
  let export_fn_names = lc_fresh_string_array()
  let export_fn_user_indices = lc_fresh_int_array()
  let test_fn_names = lc_fresh_string_array()
  let empty_tp = array_empty()
  let empty_bounds = array_empty()
  let empty_params = array_empty()
  let mut pi = 0
  while pi < Array::length(stmts) {
    match Array::get(stmts, pi) {
      STest(tname, tbody) => {
        let test_fn = String::concat("__test_", tname)
        Array::push(test_fn_names, test_fn)
        Array::set(stmts, pi, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))
      },
      SBench(bname, bbody) => {
        let bench_fn = String::concat("__bench_", bname)
        Array::push(test_fn_names, bench_fn)
        Array::set(stmts, pi, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))
      },
      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {
        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {
          // #2141: re-spell the stripped formals in the annotations
          // (`__Vfp_<name>`) BEFORE dropping the binder. This strip runs
          // ahead of the __bi param-shape seeding below, so an annotation
          // still spelling `T` would let a same-spelled (merged-in) struct
          // claim the erased param and `a == b` field-compare raw scalars
          // (measured: `eqv[T](1, 2)` answered true; the seeding gate alone
          // could not see it -- the binder list was already empty here).
          let params2 = lc_strip_subst_params(params, tparams)
          let ret2 = match ret {
            Some(rte) => Some(lc_strip_subst_ty(rte, tparams)),
            None => None
          }
          Array::set(stmts, pi, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params2, ret2, eff, body)))
        }
        ,
        _ => ()
      },
      _ => ()
    }
    pi = pi + 1
  }
  if Array::length(test_fn_names) > 0 {
    let mut has_entry = false
    let mut ei = 0
    while ei < Array::length(stmts) {
      match Array::get(stmts, ei) {
        SLet(is_exp, _, name, _, _) => if is_exp && name == entry_name {
          has_entry = true
        },
        _ => ()
      }
      ei = ei + 1
    }
    if !has_entry {
      ()
    }
  }
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    if is_slet(stmt) {
      let name = get_slet_name(stmt)
      let expr = get_slet_expr(stmt)
      let is_export = get_slet_export(stmt)
      let user_idx = Array::length(fn_names_list)
      // #715: `expr_tag(expr)` hoisted out of the `else` branch below and
      // computed here, unconditionally -- so it (like `is_efn(expr)` above)
      // contributes to `expr`'s always-consumed prefix instead of only being
      // paid for on the `else` path. This alone still leaves the `else`
      // branch's own nested if asymmetric (`get_eint_value`=1 use vs the
      // thunk fallback's 0), so the thunk fallback below also aliases `expr`
      // once (`let __sf_thunk_expr = expr`) to match. With both asymmetries
      // resolved, `then` and `else` each consume `expr` the same number of
      // times, so pc_emit's EIf MIN-merge (#705) lands on the SAME remaining
      // count regardless of which branch a given statement actually takes --
      // previously the merge could permanently assume more consumption than
      // a commonly-taken branch (int-constant or thunk statements, which are
      // NOT rare like a false `is_efn` check on a real function body) really
      // performed, skipping the loop-body scope-end drop and leaking `expr`
      // (a heap Expr node) on every such statement.
      let __sf_etag = expr_tag(expr)
      if is_efn(expr) {
        let params = get_efn_params(expr)
        Array::push(fn_names_list, name)
        Array::push(fn_param_counts, Array::length(params))
        Array::push(fn_needs_env_list, true)
        Array::push(fn_stmt_indices, i)
      } else {
        if (__sf_etag == 0) && !is_export {
          Array::push(const_int_names_list, name)
          Array::push(const_int_values_list, get_eint_value(expr))
        } else {
          let __sf_thunk_expr = expr
          Array::push(fn_names_list, name)
          Array::push(fn_param_counts, 0)
          Array::push(fn_needs_env_list, true)
          Array::push(fn_stmt_indices, i)
          Array::push(thunk_names_list, name)
        }
      }
      if is_export || library_mode {
        Array::push(export_fn_names, name)
        Array::push(export_fn_user_indices, user_idx)
      }
    }
    i = i + 1
  }
  // #2388 step 2: pin the compiler-synthesized functions (derived
  // comparators, monoify specializations, trait-operation dispatchers, the
  // __exn_kind_cell thunk) to a capacity-based index region, the same move
  // lambda_slot_base makes for table slots. Their callee indices are embedded
  // as call immediates in bodies all over the program, and they are created
  // by the effect_lowering_prelude either appended past the source program or
  // INSERTED after the last trait/impl (see desugar_trait_dict's insertion
  // scan), so any added source function shifts them.
  //
  // Classification is by NAME SET: every let name present before the prelude
  // (with STest/SBench recorded under their later __test_/__bench_ spelling)
  // is a source function; a function whose name the source never declared is
  // prelude-synthesized. A misclassification cannot produce wrong code --
  // the reorder below is a consistent permutation of the function index
  // space applied before any index is consumed -- it can only cost layout
  // stability, so no verification gate is needed. The one lane skipped is
  // library_mode, which exports every function and gains nothing from edit
  // stability.
  //
  // New order: [source functions][pads to a 1024 capacity][synthesized].
  // Pads are trivial `() -> 0` statements appended past the program; every
  // downstream consumer (lambda planning, body compile, Perceus, the name
  // and type sections) treats them as ordinary tiny functions. They are
  // never called, exported, or given table slots. Export user indices are
  // recomputed by name after the reorder.
  //
  // Coverage builds also skip the reorder: cov_count = num_user_funcs is the
  // function-coverage denominator and the vibe_cov section serializes every
  // user-function name, so never-callable pads would report as up to 1023
  // uncovered functions (measured: a one-test file answered
  // "functions 2/1025"). Coverage is a measurement lane; edit-stable indices
  // buy it nothing.
  // #2388 step 3: the pin region's shape, exposed for the body-cache guards
  // below (-1 = the reorder did not run, so no cross-compile reuse).
  let mut pin_region_src_n = 0 - 1
  let mut pin_region_capacity = 0 - 1
  if !library_mode && !coverage {
    let __pp_sorted = sorted_names_of(pre_prelude_let_names)
    let __pin_total = Array::length(fn_names_list)
    let __pin_src_idx = lc_fresh_int_array()
    let __pin_synth_idx = lc_fresh_int_array()
    let mut __pin_i = 0
    while __pin_i < __pin_total {
      if bsearch_leftmost(__pp_sorted, Array::get(fn_names_list, __pin_i)) >= 0 {
        Array::push(__pin_src_idx, __pin_i)
      } else {
        Array::push(__pin_synth_idx, __pin_i)
      }
      __pin_i = __pin_i + 1
    }
    if Array::length(__pin_synth_idx) > 0 {
      let __pin_src_n = Array::length(__pin_src_idx)
      let __pin_capacity = ((__pin_src_n + 1023) / 1024) * 1024
      pin_region_src_n = __pin_src_n
      pin_region_capacity = __pin_capacity
      let __new_names = lc_fresh_string_array()
      let __new_params = lc_fresh_int_array()
      let __new_env = lc_fresh_bool_array()
      let __new_stmts = lc_fresh_int_array()
      let mut __pin_s = 0
      while __pin_s < __pin_src_n {
        let __pin_from = Array::get(__pin_src_idx, __pin_s)
        Array::push(__new_names, Array::get(fn_names_list, __pin_from))
        Array::push(__new_params, Array::get(fn_param_counts, __pin_from))
        Array::push(__new_env, Array::get(fn_needs_env_list, __pin_from))
        Array::push(__new_stmts, Array::get(fn_stmt_indices, __pin_from))
        __pin_s = __pin_s + 1
      }
      let mut __pin_p = __pin_src_n
      while __pin_p < __pin_capacity {
        // `#` is unspellable in identifiers (the same guarantee #active_region
        // and the #region_N skolems rely on), so a user function can never
        // collide with a pad name and no name lookup can resolve to a pad.
        let __pad_name = String::concat("#slot_pad_", __to_string(__pin_p))
        let __pad_stmt_idx = Array::length(stmts)
        Array::push(stmts, SLet(false, false, __pad_name, None, EFn(empty_tp, empty_bounds, empty_params, None, None, EInt(0))))
        Array::push(__new_names, __pad_name)
        Array::push(__new_params, 0)
        Array::push(__new_env, true)
        Array::push(__new_stmts, __pad_stmt_idx)
        __pin_p = __pin_p + 1
      }
      let mut __pin_y = 0
      while __pin_y < Array::length(__pin_synth_idx) {
        let __pin_from2 = Array::get(__pin_synth_idx, __pin_y)
        Array::push(__new_names, Array::get(fn_names_list, __pin_from2))
        Array::push(__new_params, Array::get(fn_param_counts, __pin_from2))
        Array::push(__new_env, Array::get(fn_needs_env_list, __pin_from2))
        Array::push(__new_stmts, Array::get(fn_stmt_indices, __pin_from2))
        __pin_y = __pin_y + 1
      }
      Array::truncate(fn_names_list, 0)
      Array::truncate(fn_param_counts, 0)
      Array::truncate(fn_needs_env_list, 0)
      Array::truncate(fn_stmt_indices, 0)
      let mut __pin_w = 0
      while __pin_w < Array::length(__new_names) {
        Array::push(fn_names_list, Array::get(__new_names, __pin_w))
        Array::push(fn_param_counts, Array::get(__new_params, __pin_w))
        Array::push(fn_needs_env_list, Array::get(__new_env, __pin_w))
        Array::push(fn_stmt_indices, Array::get(__new_stmts, __pin_w))
        __pin_w = __pin_w + 1
      }
      // Exports were recorded with pre-reorder indices; re-resolve each by
      // name against the reordered list (source names are unique in the
      // merged program -- #716 mangling -- and synthesized names are never
      // exported outside library_mode, which is excluded above).
      let mut __pin_e = 0
      while __pin_e < Array::length(export_fn_names) {
        let __pin_ename = Array::get(export_fn_names, __pin_e)
        let mut __pin_found = -1
        let mut __pin_f = 0
        while __pin_found < 0 && __pin_f < Array::length(fn_names_list) {
          if Array::get(fn_names_list, __pin_f) == __pin_ename {
            __pin_found = __pin_f
          } else {
            ()
          }
          __pin_f = __pin_f + 1
        }
        if __pin_found >= 0 {
          Array::set(export_fn_user_indices, __pin_e, __pin_found)
        } else {
          ()
        }
        __pin_e = __pin_e + 1
      }
    } else {
      ()
    }
  } else {
    ()
  }
  let ctor_names_list = lc_fresh_string_array()
  let ctor_tags_list = lc_fresh_int_array()
  let ctor_field_counts_list = lc_fresh_int_array()
  let ctor_type_names_list = lc_fresh_string_array()
  // Option and Attempt are checker-owned, so their constructors must exist in
  // single-file codegen without an explicit @vibe/core enum declaration.
  // They are fallbacks: a same-named source constructor keeps lexical
  // precedence and its real payload layout.
  let builtin_ctor_names = ["None", "Some", "NotGranted", "Errored", "Granted"]
  let builtin_ctor_tags = [0, 1, 2, 3, 4]
  let builtin_ctor_fields = [0, 1, 0, 1, 1]
  let builtin_ctor_types = ["Option", "Option", "Attempt", "Attempt", "Attempt"]
  let mut builtin_ctor_i = 0
  while builtin_ctor_i < Array::length(builtin_ctor_names) {
    let builtin_ctor_name = Array::get(builtin_ctor_names, builtin_ctor_i)
    if !source_declares_constructor(stmts, builtin_ctor_name) {
      Array::push(ctor_names_list, builtin_ctor_name)
      Array::push(ctor_tags_list, Array::get(builtin_ctor_tags, builtin_ctor_i))
      Array::push(ctor_field_counts_list, Array::get(builtin_ctor_fields, builtin_ctor_i))
      Array::push(ctor_type_names_list, Array::get(builtin_ctor_types, builtin_ctor_i))
    } else {
      ()
    }
    builtin_ctor_i = builtin_ctor_i + 1
  }
  // #1062: sparse `ctor_idx * 64 + field_idx` entries for Double/Float-typed
  // positional constructor fields (see CompileCtx.ctor_float_fields). Built
  // alongside ctor_names_list/ctor_field_counts_list above so ctor_idx here
  // always matches ctor_table_index_of's result for the same name.
  let ctor_float_fields_list = lc_fresh_int_array()
  let mut type_index = 1
  let mut ei2 = 0
  while ei2 < Array::length(stmts) {
    match Array::get(stmts, ei2) {
      SEnum(_, ename, _, variants, _) => {
        type_index = type_index + 1
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vfields) = Array::get(variants, vi)
          Array::push(ctor_names_list, vname)
          Array::push(ctor_tags_list, (type_index<<16)|vi)
          Array::push(ctor_field_counts_list, Array::length(vfields))
          Array::push(ctor_type_names_list, ename)
          push_ctor_float_fields(ctor_float_fields_list, Array::length(ctor_names_list) - 1, vfields)
          vi = vi + 1
        }
        0
      },
      SStruct(_, sname, sfields, _, _, _) => {
        type_index = type_index + 1
        Array::push(ctor_names_list, sname)
        Array::push(ctor_tags_list, type_index<<16)
        Array::push(ctor_field_counts_list, Array::length(sfields))
        Array::push(ctor_type_names_list, sname)
        push_ctor_float_fields(ctor_float_fields_list, Array::length(ctor_names_list) - 1, struct_field_types(sfields))
        0
      },
      SSuberror(_, ename, variants) => {
        // #786: a suberror is a single-typed enum whose constructors produce a
        // throwable value; register its ctors in the ctor table like an enum's
        // so `KeyInvalid("x")` allocates a tagged value instead of resolving to
        // an undefined name at codegen.
        type_index = type_index + 1
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vfields) = Array::get(variants, vi)
          Array::push(ctor_names_list, vname)
          Array::push(ctor_tags_list, (type_index<<16)|vi)
          Array::push(ctor_field_counts_list, Array::length(vfields))
          Array::push(ctor_type_names_list, ename)
          push_ctor_float_fields(ctor_float_fields_list, Array::length(ctor_names_list) - 1, vfields)
          vi = vi + 1
        }
        0
      },
      _ => 0
    }
    ei2 = ei2 + 1
  }
  append_hidden_attempt_constructors(ctor_names_list, ctor_tags_list, ctor_field_counts_list, ctor_type_names_list)
  let struct_names = lc_fresh_string_array()
  let struct_field_names = lc_fresh_string_matrix()
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      SStruct(_, sname, sfields, _, _, _) => {
        Array::push(struct_names, sname)
        let fnames = lc_fresh_string_array()
        let mut sfi = 0
        while sfi < Array::length(sfields) {
          let (fname, _) = Array::get(sfields, sfi)
          Array::push(fnames, fname)
          sfi = sfi + 1
        }
        Array::push(struct_field_names, fnames)
        ()
      },
      _ => ()
    }
    si = si + 1
  }
  // Sorted ctor-name index (see CtorTable.names_sorted): built once here,
  // shared by this table literal and every per-function ctor_table below.
  let (lc_ctor_names_sorted, lc_ctor_names_sorted_pos) = ctor_sorted_index(ctor_names_list)
  // #2386: the struct-name and constructor-type-name views agg_info_of_type_name
  // binary-searches (see CtorTable.struct_names_sorted).
  let (lc_struct_names_sorted, lc_struct_names_sorted_pos) = ctor_sorted_index(struct_names)
  let (lc_type_names_sorted, _) = ctor_sorted_index(ctor_type_names_list)
  // #724 round 2: (fn name -> declared aggregate return shape) table so
  // `let a = f(..)` bindings participate in structural `==` (see
  // compute_agg_returning in common_base).
  let lc_agg_ret_names = lc_fresh_string_array()
  let lc_agg_ret_infos = lc_fresh_int_array()
  compute_agg_returning(stmts, CtorTable::{
    names: ctor_names_list,
    tags: ctor_tags_list,
    field_counts: ctor_field_counts_list,
    type_names: ctor_type_names_list,
    struct_names: struct_names,
    struct_field_names: struct_field_names,
    struct_field_is_ref: array_empty(),
    names_sorted: lc_ctor_names_sorted,
    names_sorted_pos: lc_ctor_names_sorted_pos,
    struct_names_sorted: lc_struct_names_sorted,
    struct_names_sorted_pos: lc_struct_names_sorted_pos,
    type_names_sorted: lc_type_names_sorted
  }, lc_agg_ret_names, lc_agg_ret_infos)
  let (lc_agg_ret_names_sorted, lc_agg_ret_names_sorted_pos) = ctor_sorted_index(lc_agg_ret_names)
  // #791: program-wide (fn name) set for declared-heap-returning top-level
  // functions (see compute_heap_returning in perceus/index.vibe). Consulted
  // by classify_let_value_heap (compile_expr_tail.vibe) to classify
  // `let`/`let mut` bindings whose value is a call by the CALLEE's own
  // declared signature, instead of always over-approximating every call as
  // heap.
  // Sorted for bsearch_leftmost membership at the classify_let_value_heap call
  // site (compile_expr_tail.vibe) -- same rationale as lc_borrow_ret_names above.
  let lc_heap_ret_names = sorted_names_of(compute_heap_returning(stmts))
  let num_user_funcs = Array::length(fn_names_list)
  if num_user_funcs == 0 {
    throw("no functions found to compile")
  }
  // #2388: lambda-slot region base -- num_user_funcs rounded up to the next
  // multiple of 1024. Every closure-creation site embeds `base + planned_index`
  // as an immediate; anchoring the base to a capacity ceiling instead of the
  // exact function count means adding a named function (up to the ceiling)
  // leaves every existing lambda-slot immediate byte-identical — the
  // prefix-stability invariant per-module codegen caching builds on. Measured
  // before this change (one added test in the entry): 581 of 4214 function
  // bodies differed, every one only in a slot immediate.
  let lambda_slot_base = ((num_user_funcs + 1023) / 1024) * 1024
  let mut entry_user_idx = -1
  let mut ei = 0
  while ei < num_user_funcs {
    if Array::get(fn_names_list, ei) == entry_name {
      entry_user_idx = ei
    }
    ei = ei + 1
  }
  // ADR-0069 Phase 1: a missing entry is a compile error. Historically ANY
  // unknown entry name fell through to the test-runner `_start` synthesis, so
  // an entry typo silently produced a no-op module. Only the explicit
  // `__no_entry__` sentinel (vibe test / bench) may synthesize the test runner
  // now. Library mode passes a synthetic entry name it never calls, so it is
  // exempt.
  if entry_user_idx < 0 && !library_mode && entry_name != "__no_entry__" {
    throw("entry `\{entry_name_in}` not found: no exported function named `\{entry_name_in}` (use __no_entry__ to build a test runner)")
  }
  // #2402: the empty string is seeded at pool slot 0, BEFORE the source
  // strings. It is the one compiler-materialised string that user bodies
  // embed (StringBuilder::freeze's join separator, ByteStream::to_string's
  // accumulator); seeded after the source strings it moved whenever an edit
  // added a novel literal, shifting the offset inside every unchanged body
  // that embeds it and defeating cross-compile replay. "" is zero-length,
  // so fronting it changes no other string's data offset. The remaining
  // seeded strings (the #2199 OOB fragments below) stay where they are:
  // only the generated builtin bodies reference them, and those are rebuilt
  // by every compile.
  // #1537: the program is linked here, @vibe/concurrent included, so this is
  // where its host-waitable hooks can get the adapter's bodies -- when the
  // entry boundary settles host futures (it injected `__entry_settle`), and
  // the stream half when a stream read survived the prune
  // (`lc_stream_reads_survive`, above).
  lc_host_hooks_install(stmts, lc_program_defines_top_level(stmts, "__entry_settle") && lc_stmts_call_host_future(stmts), lc_program_defines_top_level(stmts, "__entry_settle") && lc_stream_reads_survive)
  let used_builtin_names = collect_used_builtin_names(stmts, fn_names_list)
  let need_array_capacity = Map::has_key(used_builtin_names, "Array::with_capacity")
  let need_bytes_capacity = Map::has_key(used_builtin_names, "Bytes::with_capacity")
  let (str_table_shared, src_str_base, heap_start, need_div_zero_abort) = lc_build_string_pool(stmts, srcs, need_array_capacity, need_bytes_capacity, rc_shadow)
  let str_strs = str_table_shared.strs
  let str_offsets = str_table_shared.offsets
  let str_lengths = str_table_shared.lengths
  let num_strings = Array::length(str_strs)
  let num_src_pairs = Array::length(srcs)
  let effect_names_list = lc_fresh_string_array()
  let effect_op_keys_list = lc_fresh_string_array()
  let effect_op_arities_list = array_empty()
  let mut eff_collect_i = 0
  while eff_collect_i < Array::length(stmts) {
    match Array::get(stmts, eff_collect_i) {
      SEffectDef(_, eff_name, _, ops) => {
        if !is_exception_effect_name(eff_name) && !array_contains_str(effect_names_list, eff_name) {
          Array::push(effect_names_list, eff_name)
        } else {
          ()
        }
        let mut op_i = 0
        while op_i < Array::length(ops) {
          let (op_name, op_params, _) = Array::get(ops, op_i)
          Array::push(effect_op_keys_list, String::concat(String::concat(eff_name, "::"), op_name))
          Array::push(effect_op_arities_list, Array::length(op_params))
          op_i = op_i + 1
        }
      },
      _ => ()
    }
    eff_collect_i = eff_collect_i + 1
  }
  // ADR-0076 追記34 V2: the per-effect replay regions (#553 -- perform
  // counter / resume-memo control words + memo array, 131072 B per effect
  // tag) are gone with the replay engine itself. Nothing reads or writes
  // below-frontier effect words anymore (perform lowers to a direct
  // builtin call or a bare throw; `resume` never reaches codegen), so the
  // reserve is zero and the heap frontier moves down by (n_effects+1) *
  // 128 KiB per module.
  let eff_reserve = 0
  // Function-level coverage (gated by `coverage`): a 1-byte-per-user-function
  // hit bitmap placed in a dedicated reserve ABOVE the effect regions and BELOW
  // the heap frontier, so it never collides with effect words or the live heap.
  // `cov_base` is a compile-time-constant address baked into each function's
  // prologue store. When coverage is off, cov_reserve is 0 and codegen output is
  // byte-identical to the normal build (the self-host fixpoint is unaffected).
  let cov_count = num_user_funcs
  let cov_base = heap_start + eff_reserve
  let cov_reserve = if coverage {
    ((cov_count + 7) / 8) * 8
  } else {
    0
  }
  // #cov branch coverage: a second 1-byte-per-branch hit region directly above
  // the function-hit region. Branch ids are assigned sequentially during codegen
  // (CovState.next), so the count is not known up front — reserve a fixed cap.
  // 65536 branches is generous headroom (the whole compiler has a few thousand).
  // Off => branch_reserve is 0 and the layout/codegen is byte-identical.
  let cov_branch_cap = 65536
  let cov_branch_base = cov_base + cov_reserve
  let cov_branch_reserve = if coverage {
    cov_branch_cap
  } else {
    0
  }
  // Function-call execution trace (debugger / DAP P1 groundwork, gated by
  // `debug_trace`). A dedicated region directly above the coverage regions and
  // below the heap frontier holds a 4-byte counter cell followed by a fixed-cap
  // log of i32 slots. Each user function's entry, in debug mode, appends its
  // own user index to the log (counter-bounded). A `vibe.trace` custom section
  // records the layout + function names so the runner can dump the entry
  // sequence. Off => trace_reserve is 0 and the layout/codegen is byte-identical
  // to a normal build (the self-host fixpoint is unaffected).
  let trace_cap = 4096
  let trace_counter_addr = cov_branch_base + cov_branch_reserve
  let trace_log_base = trace_counter_addr + 4
  let trace_reserve = if debug_trace {
    4 + trace_cap * 4
  } else {
    0
  }
  // debugger argument inspection (DAP P2, gated by `debug_break`). A dedicated
  // region directly above the trace region holds a 4-byte count cell followed by
  // a fixed-cap array of i64 slots. At each user function entry, in break mode,
  // the function's i64 parameters are spilled here (capped at dbgargs_cap) and
  // the count cell is set, BEFORE calling the `vibe::dbg_break` host hook. The
  // hook reads them out of guest memory and prints `args: [...]`. A
  // `vibe.dbgargs` custom section publishes the two addresses to the runner.
  // Off => dbgargs_reserve is 0 and the layout/codegen is byte-identical to a
  // normal build (the self-host fixpoint is unaffected).
  let dbgargs_cap = 16
  let dbgargs_count_addr = trace_counter_addr + trace_reserve
  let dbgargs_base = dbgargs_count_addr + 8
  let dbgargs_reserve = if debug_break {
    8 + dbgargs_cap * 8
  } else {
    0
  }
  // ADR-0092 (#1262) KPI follow-up 2: size-segregated free-list bins for
  // small RC blocks. 32 bin heads (4 bytes each, sizes 16..264 step 8) live
  // just below the bump base; the bump base moves up by the 128-byte table
  // (rounded to 256 for alignment headroom). Linear memory is zero-page
  // initialized and the data segments end below heap_start, so the bins
  // start empty without an explicit memset. gen_rc_drop_body pushes
  // small freed blocks onto their exact-size bin (O(1) exact fit on the
  // alloc side); everything else stays on the legacy global-2 list with
  // the bounded walk.
  let rc_bins_base = heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve
  let rc_bins_reserve = if enable_rc {
    256
  } else {
    0
  }
  let cov_state = CovState::{
    enabled: coverage,
    base: cov_branch_base,
    cap: cov_branch_cap,
    next: [0],
    cur_fn: [0],
    owners: ArrayBuilder::freeze(ArrayBuilder::new())
  }
  // ADR-0090 (#1262): the region arena segment. `region r { body }` parses to
  // `__region_run(lam)`, so its presence in the canonical free-name set is
  // exactly "this module has a region".
  //
  // The arena is an INDEPENDENT bump segment, not a watermark over the main
  // heap, and that separation is the whole point: the region body allocates
  // ordinary heap values too (a tuple, a string) which are allowed to escape,
  // and a watermark reset over the shared bump pointer would reclaim those.
  // Only `MutList` storage goes here, and the sanctioned exits copy OUT of it
  // (compile_call.vibe :: mutlist_exit_copy) before the segment is released.
  //
  // Layout: [bump ptr @+0][depth @+4][saved bump ptrs @+8, 64 levels][data].
  // The control words live in linear memory rather than wasm globals so the
  // save/restore needs no locals at the call site and no change to the global
  // index formula (g_op_index / thunk globals are positional). Memory is
  // zero-page initialized and the data segments end below heap_start, so a
  // zero bump ptr means "never entered" and the bodies lazily seed it.
  //
  // Bump-lane only. Under RC a region block would carry an RC header and
  // eventually reach the free list, which the bulk release invalidates; the
  // RC lane keeps today's behavior (MutList == ArrayBuilder on the main heap)
  // until the Perceus exemption lands. The bump lane is also where the arena
  // is worth anything: it never frees, so bulk release is pure win.
  let need_region_arena = Map::has_key(used_builtin_names, "__region_run") && !enable_rc
  let region_ctl_base = heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve + rc_bins_reserve
  let region_ptr_addr = if need_region_arena {
    region_ctl_base
  } else {
    -1
  }
  // Derived through the common_base helpers so the emitter (compile_call.vibe,
  // which only receives region_ptr_addr) and this layout cannot drift apart.
  let region_saves_base = region_saves_base_of(region_ctl_base)
  let region_data_base = ((region_saves_base + region_max_depth() * 4 + 7) / 8) * 8
  // 256 KiB. Overflow is not an error: the arena bodies fall back to the main
  // bump heap, which is exactly today's behavior, so a region that outgrows
  // the segment gets no reclamation instead of getting corrupted.
  let region_arena_bytes = 262144
  let region_limit = region_data_base + region_arena_bytes
  let region_reserve = if need_region_arena {
    (region_data_base - region_ctl_base) + region_arena_bytes
  } else {
    0
  }
