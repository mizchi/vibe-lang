/// #644: an Int array of exactly `n` entries, all initialized to `fill`, so
/// callers can index-assign (`Array::set`) into it before the real value at
/// each index is known (linemap_hdrlen_by_bi below: one entry per user
/// function, filled in `ci` order as each function's locals header is
/// assembled).
/// #2669 slice 2: LEB128, signed, at `p` in `body`. `i64.const` and
/// `i32.const` immediates are both signed; reading one unsigned would agree
/// exactly where small slot numbers live and disagree everywhere a check
/// would matter, so the decode has to sign-extend.
fn lc_read_sleb(body: Bytes, p: Int) -> Int with Exception {
  let n = Bytes::length(body)
  let mut acc = 0
  let mut shift = 0
  let mut i = p
  let mut last = 0
  let mut done = false
  while !done {
    if i >= n {
      throw("blind reloc: constant runs past the end of the body")
    } else {
      ()
    }
    let byte = Bytes::get(body, i)
    last = byte
    acc = acc|((byte&127)<<shift)
    shift = shift + 7
    i = i + 1
    if (byte&128) == 0 {
      done = true
    } else {
      ()
    }
  }
  if shift < 64 && (last&64) != 0 {
    acc|(0 - (1<<shift))
  } else {
    acc
  }
}

/// #2669 slice 2: every recorded reference must name the constant it claims.
///
/// See the call site for why this is not optional. `owners` are body ids -- a
/// user function by index, a lambda as `blind_owner_of_lambda` -- and the
/// offsets are relative to that body's instruction stream, which is what
/// `bodies` holds (the locals header is prepended later, at code-section
/// assembly).
export fn lc_verify_blind_relocs(bodies: Array[Bytes], num_generated: Int, lambda_ci_base: Int, owners: Array[Int], offsets: Array[Int], kinds: Array[Int], syms: Array[Int]) -> Unit with Exception {
  let n = Array::length(owners)
  let mut k = 0
  while k < n {
    let owner = Array::get(owners, k)
    // A record still owned by `pending` means a lambda body was compiled and
    // its planned index never arrived, so the reference belongs to no body at
    // all. Louder than leaving it to be misattributed.
    if owner == blind_owner_pending {
      throw("blind reloc: a recorded reference was never assigned an owner (a lambda body compiled without taking its planned index)")
    } else {
      ()
    }
    let ci = if owner >= 0 {
      num_generated + owner
    } else {
      lambda_ci_base + blind_owner_lambda_index(owner)
    }
    // Late DCE replaces an unused GENERATED helper's body with a one-byte
    // stub, which would leave a record naming it pointing into a body that no
    // longer exists. None can: an owner is a user function or a lambda, and
    // both map above num_generated. Checked, not assumed -- the two sites are
    // far apart and only one of them would have to move.
    if ci < num_generated || ci >= Array::length(bodies) {
      throw(String::concat("blind reloc: owner maps outside the user code range: owner ", String::concat(__to_string(owner), String::concat(" -> code index ", __to_string(ci)))))
    } else {
      ()
    }
    let body = Array::get(bodies, ci)
    let off = Array::get(offsets, k)
    if off < 0 || off >= Bytes::length(body) {
      throw(String::concat("blind reloc: offset outside the body: code index ", String::concat(__to_string(ci), String::concat(" offset ", __to_string(off)))))
    } else {
      ()
    }
    let kind = Array::get(kinds, k)
    let sym = Array::get(syms, k)
    let opcode = Bytes::get(body, off)
    let want_op = if kind == blind_kind_fn_value {
      66
    } else if kind == blind_kind_table_slot_i32 {
      65
    } else {
      throw(String::concat("blind reloc: unknown kind ", __to_string(kind)))
    }
    let want_val = if kind == blind_kind_fn_value {
      (sym<<2)|2
    } else {
      sym
    }
    if opcode != want_op {
      throw(String::concat("blind reloc: expected opcode ", String::concat(__to_string(want_op), String::concat(" at code index ", String::concat(__to_string(ci), String::concat(" offset ", String::concat(__to_string(off), String::concat(", found ", __to_string(opcode)))))))))
    } else {
      ()
    }
    let got = lc_read_sleb(body, off + 1)
    if got != want_val {
      throw(String::concat("blind reloc: constant at code index ", String::concat(__to_string(ci), String::concat(" offset ", String::concat(__to_string(off), String::concat(" decodes to ", String::concat(__to_string(got), String::concat(", recorded ", __to_string(want_val)))))))))
    } else {
      ()
    }
    k = k + 1
  }
}

export fn lc_fresh_int_array_of_len(n: Int, fill: Int) -> Array[Int] {
  let arr = lc_fresh_int_array()
  let mut i = 0
  while i < n {
    Array::push(arr, fill)
    i = i + 1
  }
  arr
}

/// #644: append a little-endian 4-byte encoding of `v` to `buf`. Used by the
/// `vibe.linemap` custom section (see below), one of a family of ad hoc
/// raw-int encodings this file already uses for debug sections (compare
/// `vibe.dbgargs`'s address fields a few hundred lines up).
fn bytebuf_push_i32le(buf: Bytes, v: Int) -> Unit {
  bytebuf_push(buf, v&255)
  bytebuf_push(buf, (v>>8)&255)
  bytebuf_push(buf, (v>>16)&255)
  bytebuf_push(buf, (v>>24)&255)
}

/// #1085: the positions a BUILTIN callee borrows (bit 0: arg0, bit 1: arg1 --
/// #2345's `Bytes::index_of_bytes` / `Bytes::compare` read both operands),
/// narrowed by a source definition of the same name. `bfns` / `bmasks` are the
/// program's borrow table, which keeps an authoritative row for every source
/// definition of a borrowing builtin's name (#3128): a call that resolves to
/// that definition borrows only what the definition borrows. A user function
/// with any other name stays 0 here, as before -- this walk counts its
/// arguments as consumed, the conservative direction.
fn lc_builtin_borrow_bits(f: String, bfns: Array[String], bmasks: Array[Int]) -> Int {
  let builtin = md_builtin_borrow_mask(f)
  if builtin == 0 {
    0
  } else {
    builtin&md_borrow_mask_of(f, bfns, bmasks)
  }
}

/// #1085: does `name` have a consuming occurrence OUTSIDE any loop body?
/// The #725 single unconditional epilogue drop for a loop-consumed param
/// is only sound when EVERY consuming occurrence is a loop-borrow site
/// (per-iteration protective dup makes those net-zero, so the param's own
/// reference always survives to the epilogue). A consuming occurrence
/// outside a loop (e.g. `Array::set(buf, i, v)` in a sibling branch of
/// the loop) transfers the own reference on the paths that execute it,
/// and the unconditional drop then over-releases the stored value —
/// use-after-free (issue #1085's minimal repro; the else arm does not
/// even need to run). Occurrence rules mirror consume_count
/// (common_analysis/perceus): borrow-arg0 idents, match/handle
/// scrutinee idents, and call-callee idents do not consume. Loop bodies
/// (EWhile / ELoop / EForIn) are skipped — occurrences there are the
/// loop-borrow sites themselves. Branches use OR (existence), which
/// over-approximates toward suppressing the epilogue drop: the loop-only
/// path then leaks one reference, the safe direction.
export fn lc_has_nonloop_consume(e: Expr, name: String, bfns: Array[String], bmasks: Array[Int]) -> Bool {
  match e {
    EIdent(n, _) => n == name,
    ETuple(items) => lc_hnc_any(items, name, bfns, bmasks),
    EArray(items) => lc_hnc_any(items, name, bfns, bmasks),
    ERecord(_, fields, _) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        if lc_has_nonloop_consume(v, name, bfns, bmasks) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EMap(fields) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        if lc_has_nonloop_consume(v, name, bfns, bmasks) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EIf(c, t, el) => lc_has_nonloop_consume(c, name, bfns, bmasks) || lc_has_nonloop_consume(t, name, bfns, bmasks) || lc_has_nonloop_consume(el, name, bfns, bmasks),
    ELet(_, v, b, _) => lc_has_nonloop_consume(v, name, bfns, bmasks) || lc_has_nonloop_consume(b, name, bfns, bmasks),
    ELetRec(_, v, b) => lc_has_nonloop_consume(v, name, bfns, bmasks) || lc_has_nonloop_consume(b, name, bfns, bmasks),
    ELetMut(_, v, b, _) => lc_has_nonloop_consume(v, name, bfns, bmasks) || lc_has_nonloop_consume(b, name, bfns, bmasks),
    EAssign(_, v, b, _) => lc_has_nonloop_consume(v, name, bfns, bmasks) || lc_has_nonloop_consume(b, name, bfns, bmasks),
    EAssignOp(_, _, v, b, _) => lc_has_nonloop_consume(v, name, bfns, bmasks) || lc_has_nonloop_consume(b, name, bfns, bmasks),
    ESeq(a, b) => lc_has_nonloop_consume(a, name, bfns, bmasks) || lc_has_nonloop_consume(b, name, bfns, bmasks),
    EMatch(s, arms) => {
      let scr = match s {
        EIdent(_, _) => false,
        _ => lc_has_nonloop_consume(s, name, bfns, bmasks)
      }
      let mut found = scr
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ab) = Array::get(arms, i)
        if lc_has_nonloop_consume(ab, name, bfns, bmasks) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EHandle(s, arms) => {
      let scr = match s {
        EIdent(_, _) => false,
        _ => lc_has_nonloop_consume(s, name, bfns, bmasks)
      }
      let mut found = scr
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ab) = Array::get(arms, i)
        if lc_has_nonloop_consume(ab, name, bfns, bmasks) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EWhile(c, _) => lc_has_nonloop_consume(c, name, bfns, bmasks),
    ELoop(params, _) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(params) {
        let (_, v) = Array::get(params, i)
        if lc_has_nonloop_consume(v, name, bfns, bmasks) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EForIn(_, _, it, _) => lc_has_nonloop_consume(it, name, bfns, bmasks),
    ECall(callee, args, _, _) => {
      let borrow_bits = match callee {
        EIdent(f, _) => lc_builtin_borrow_bits(f, bfns, bmasks),
        _ => 0
      }
      let borrow0 = (borrow_bits&1) != 0
      let borrow1 = (borrow_bits&2) != 0
      let callee_c = match callee {
        EIdent(_, _) => false,
        _ => lc_has_nonloop_consume(callee, name, bfns, bmasks)
      }
      let mut found = callee_c
      let mut i = 0
      while i < Array::length(args) {
        let skip_borrowed_head = ((borrow0 && i == 0) || (borrow1 && i == 1)) && (match Array::get(args, i) {
          EIdent(_, _) => true,
          _ => false
        })
        if skip_borrowed_head {
          ()
        } else if lc_has_nonloop_consume(Array::get(args, i), name, bfns, bmasks) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EBinOp(_, l, r, _) => lc_has_nonloop_consume(l, name, bfns, bmasks) || lc_has_nonloop_consume(r, name, bfns, bmasks),
    EUnaryOp(_, x) => lc_has_nonloop_consume(x, name, bfns, bmasks),
    EFn(_, _, _, _, _, fb) => lc_has_nonloop_consume(fb, name, bfns, bmasks),
    EDot(x, _, _, _) => lc_has_nonloop_consume(x, name, bfns, bmasks),
    ELabeledArg(_, _, v) => lc_has_nonloop_consume(v, name, bfns, bmasks),
    EReturn(x) => lc_has_nonloop_consume(x, name, bfns, bmasks),
    EBreak(opt) => match opt {
      Some(v) => lc_has_nonloop_consume(v, name, bfns, bmasks),
      None => false
    },
    EContinue(args) => lc_hnc_any(args, name, bfns, bmasks),
    ESpread(x) => lc_has_nonloop_consume(x, name, bfns, bmasks),
    _ => false
  }
}

fn lc_hnc_any(items: Array[Expr], name: String, bfns: Array[String], bmasks: Array[Int]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(items) {
    if lc_has_nonloop_consume(Array::get(items, i), name, bfns, bmasks) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #1062: positional field types for a struct declaration's field list,
/// dropping the names -- SEnum/SSuberror variants are already unnamed
/// (Array[TypeExpr]), but SStruct fields carry (name, type) pairs.
export fn struct_field_types(sfields: Array[(String, TypeExpr)]) -> Array[TypeExpr] {
  let out = lc_fresh_type_expr_array()
  let mut i = 0
  while i < Array::length(sfields) {
    let (_, ft) = Array::get(sfields, i)
    Array::push(out, ft)
    i = i + 1
  }
  out
}

/// #1062: append `ctor_idx * 64 + field_idx` to `out` for every positional
/// field in `field_types` whose declared type is Double/Float (same TyName
/// check as the annotated-Float/Double-param seeding below). See
/// CompileCtx.ctor_float_fields.
export fn push_ctor_float_fields(out: Array[Int], ctor_idx: Int, field_types: Array[TypeExpr]) -> Unit {
  let mut fi = 0
  while fi < Array::length(field_types) {
    match Array::get(field_types, fi) {
      TyName(ftn) => if ftn == "Float" || ftn == "Double" {
        Array::push(out, ctor_idx * 64 + fi)
      } else {
        ()
      },
      _ => ()
    }
    fi = fi + 1
  }
}

/// #2348: the inline-wasm callee table (name, wasm index, declared arity).
fn lc_fresh_iw_callees() -> Array[(String, Int, Int)] {
  array_empty()
}

export fn lc_fresh_string_matrix() -> Array[Array[String]] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

export fn gen_heap_grow_check_body() -> Bytes {
  let b = bytebuf_new()
  emit_heap_memory_grow_check(b)
  b
}

/// #805 (ADR-0072): collect the inline-wasm fns (`fn f(..) -> Int = wasm
/// "..."`, carried as the parser-internal `%wasm("<WAT>")` marker body) into
/// parallel name/WAT-text arrays and REPLACE each marker body with a neutral
/// EInt(0) IN PLACE — so every downstream analysis (Perceus plans, borrow/
/// scalar-return classification, string-table collection, coverage) sees an
/// ordinary trivial body and the WAT text never leaks into the data section.
/// The per-fn codegen loop then splices the assembled instruction bytes
/// (compile_inline_wat_array_params) instead of running compile_expr for them.
export fn lc_extract_inline_wasm(stmts: Array[Stmt], names: Array[String], wats: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(iw_exp, iw_rec, iw_name, iw_ann, iw_expr) => match iw_expr {
        EFn(iw_tps, iw_tbs, iw_params, iw_ret, iw_eff, iw_body) => match iw_body {
          ECall(iw_cal, iw_args, _, _) => match iw_cal {
            EIdent(iw_cn, _) => if iw_cn == "%wasm" && Array::length(iw_args) == 1 {
              match Array::get(iw_args, 0) {
                EString(iw_wat, _) => {
                  Array::push(names, iw_name)
                  Array::push(wats, iw_wat)
                  Array::set(stmts, i, SLet(iw_exp, iw_rec, iw_name, iw_ann, EFn(iw_tps, iw_tbs, iw_params, iw_ret, iw_eff, EInt(0))))
                },
                _ => ()
              }
            } else {
              ()
            },
            _ => ()
          },
          _ => ()
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

/// #2348: the callee table a `(call $f ...)` inside an inline-wasm body may
/// name — one `(source name, wasm function index, declared param count)` per
/// inline-wasm fn in this module.
///
/// Only inline-wasm fns are listed, deliberately: calling an ordinary vibe fn
/// would need this assembler to model an effect row, RC accounting and a real
/// closure env, none of which it does. The scan is over the USER prefix of the
/// func table (`[0, num_user_funcs)`, the layout func_table_user_index_of
/// documents), so a builtin registered under the same name can never be
/// resolved instead.
export fn lc_build_iw_callees(iw_names: Array[String], ft_names: Array[String], ft_indices: Array[Int], ft_params: Array[Int], num_user_funcs: Int) -> Array[(String, Int, Int)] {
  let out = lc_fresh_iw_callees()
  let limit = if num_user_funcs < Array::length(ft_names) {
    num_user_funcs
  } else {
    Array::length(ft_names)
  }
  let mut i = 0
  while i < Array::length(iw_names) {
    let want = Array::get(iw_names, i)
    let mut j = 0
    while j < limit {
      if Array::get(ft_names, j) == want {
        Array::push(out, (want, Array::get(ft_indices, j), Array::get(ft_params, j)))
        j = limit
      } else {
        j = j + 1
      }
    }
    i = i + 1
  }
  out
}

/// #805 SIMD locals: assemble an inline-wasm fn's body bytes into `body_buf`
/// and write its extra-local counts (i32, i64, v128) into the 3-slot
/// `iw_extra_cell` -- zeros when the function is not inline wasm (iw_found
/// < 0). The counts travel through a pre-existing cell array (the
/// `lambda_plan_cell` pattern) instead of a fresh binding at the call site:
/// the seed compiler loses a NEW `let` binding introduced at that nesting
/// depth of the flattened module source ("unknown name" on every later
/// reference, tuple/mut/plain-Int alike), while reads through an
/// already-in-scope array provably survive (meta_i32 itself is one).
export fn lc_compile_iw_body(body_buf: Bytes, fn_name_dbg: String, iw_wats: Array[String], iw_found: Int, iw_param_names: Array[String], iw_array_params: Array[String], param_count: Int, iw_extra_cell: Array[Int], iw_callees: Array[(String, Int, Int)]) -> Unit with Exception {
  Array::set(iw_extra_cell, 0, 0)
  Array::set(iw_extra_cell, 1, 0)
  Array::set(iw_extra_cell, 2, 0)
  if iw_found < 0 {
    ()
  } else {
    // Declared `(local ...)` runs index from param_count (params + the
    // closure-env slot), matching the i32/i64/v128 header runs the meta
    // arrays receive at the code-section assembly.
    let (iw_bytes, iw_n32, iw_n64, iw_nv) = compile_inline_wat_array_params(fn_name_dbg, Array::get(iw_wats, iw_found), iw_param_names, iw_array_params, param_count, iw_callees)
    bytebuf_push_buf(body_buf, iw_bytes)
    Array::set(iw_extra_cell, 0, iw_n32)
    Array::set(iw_extra_cell, 1, iw_n64)
    Array::set(iw_extra_cell, 2, iw_nv)
  }
}

let default_wasi_memory_min_pages: Int = 64

export fn wasi_memory_min_pages_for_heap(heap_start: Int) -> Int {
  let needed_pages = (heap_start + wasm_page_size - 1) / wasm_page_size
  if needed_pages > default_wasi_memory_min_pages {
    needed_pages
  } else {
    default_wasi_memory_min_pages
  }
}

/// ADR-0069: `Unit` in a declared return position — either the canonical
/// TyUnit (`-> ()`) or the named spelling (`-> Unit`, what parse_type produces
/// and what the `fn main {}` desugar emits).
export fn linked_type_expr_is_unit(t: TypeExpr) -> Bool {
  match t {
    TyUnit => true,
    TyName(n) => n == "Unit",
    _ => false
  }
}

/// #944 (ADR-0073 stage C, "entry boundary A"): does a declared row text
/// contain the literal effect label "Error" as a whole token? Row text is a
/// comma-separated label list ("Error", "Error, Fs", "Stdout, Error", ...);
/// substring matching alone would false-positive on a user effect named
/// e.g. "ErrorLog", so each comma-separated piece is trimmed and compared
/// exactly.
export fn lc_row_has_label(eff: Option[String], label: String) -> Bool {
  match eff {
    Some(row) => {
      let mut found = false
      let mut start = 0
      let n = String::length(row)
      let mut i = 0
      while i <= n {
        let at_sep = if i == n {
          true
        } else {
          String::char_code_at(row, i) == 44
        }
        if at_sep {
          // #1313 rebase fix: compare against the REQUESTED label, with
          // alias-aware equality so `Error` still matches the `Exception`
          // spelling. The rebase resolution had collapsed this to a bare
          // is_exception_effect_name(token) -- ignoring `label` entirely --
          // which made lc_row_has_label(eff, "Async") true only for
          // Error-ish rows: the Async entry boundary was never injected,
          // and gate 77's mixed-convention fixture compiled instead of
          // being rejected (the exact compiler-gate failure on this PR).
          if exception_effect_labels_equal(String::trim(String::substring(row, start, i)), label) {
            found = true
          } else {
            ()
          }
          start = i + 1
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    None => false
  }
}

fn lc_is_stdin_provider_surface(name: String) -> Bool {
  name == "Stdin::read_via_stream" || name == "StdinStream::next" || name == "StdinStream::close" || name == "StdinStream::read_chunk"
}

fn lc_stdin_provider_value_error(name: String) -> String {
  String::concat("stdin provider operations are direct-call-only; wrap `", String::concat(name, "` in an explicitly effectful function"))
}

/// Canonical post-merge validation for #1539. Import value aliases and
/// qualified type heads have already been rewritten to their exact public
/// provider names by the merge boundary. Each such name is legal only as the
/// immediate EIdent callee of a direct ECall; arguments are still traversed.
/// Returning the first source-order error keeps every compile lane on the same
/// actionable diagnostic without rerunning type/effect checking.
export fn lc_validate_stdin_provider_expr(expr: Expr) -> String {
  match expr {
    ECall(EIdent(name, _), args, _, _) => if lc_is_stdin_provider_surface(name) {
      let mut i = 0
      let mut err = ""
      while i < Array::length(args) && err == "" {
        err = lc_validate_stdin_provider_expr(Array::get(args, i))
        i = i + 1
      }
      err
    } else {
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      let mut err = ""
      while i < end && err == "" {
        err = lc_validate_stdin_provider_expr(expr_child_at(i))
        i = i + 1
      }
      expr_children_pop(mark)
      err
    },
    EIdent(name, _) => if lc_is_stdin_provider_surface(name) {
      lc_stdin_provider_value_error(name)
    } else {
      ""
    },
    _ => {
      let mark = expr_children_push(expr)
      let end = expr_children_top()
      let mut i = mark
      let mut err = ""
      while i < end && err == "" {
        err = lc_validate_stdin_provider_expr(expr_child_at(i))
        i = i + 1
      }
      expr_children_pop(mark)
      err
    }
  }
}

export fn lc_entry_declares_async(stmts: Array[Stmt], entry_name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, EFn(_, _, _, _, eff, _)) => if name == entry_name && lc_row_has_label(eff, "Async") {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// ADR-0089 Decision 1, increment 1 (#1218): make `sleep` a real
/// `perform Async::Suspend` when the ENTRY's declared row carries `Async`,
/// and give that program a default (entry-boundary) Async handler so the
/// unhandled sequential case keeps today's blocking behavior.
///
/// The nominal-`Async`-row `sleep` builtin is the label pun ADR-0089
/// Decision 1 exists to remove: its row cannot be discharged by a handler
/// (it is not a `perform` -- measured in #1227), and it is opaque to the
/// ADR-0076 suspend lowering (scps_calls_ok admits performs, pure
/// builtins, ctors, needing/effect-free functions -- a row-carrying host
/// builtin is none of those, re-measured 2026-08-01 after the #1230 loop
/// widening moved that wall). Both problems disappear when the call IS a
/// perform.
///
/// Mechanism (all-AST-synthesis, no checker change -- `sleep` keeps its
/// builtin type `(Int) -> Unit with Async` at check time):
///
///   1. a top-level `let sleep = (ms) -> Unit with Async { if 0 < ms
///      { let _ = perform Async::Suspend(0 - ms) } }` is injected;
///      compile_call's prefer-bound rule (the same one a user-defined
///      `await` rides) then routes every existing call site through it.
///      The negative payload is @vibe/concurrent's sleep-debt convention
///      (0 = yield, 1 = poll, negative = debt), so inside a
///      `spawn_suspend` task the injected perform parks the task exactly
///      like `sleep_wait` does today.
///   2. `effect Async { Suspend(Int) -> Int }` is injected when the
///      merged program does not already declare it (the effect passes
///      need the declaration's operation list).
///   3. the entry body is wrapped in `handle { .. } with Async {
///      Suspend(req) => { if req < 0 { sleep_blocking(0 - req) }; resume(0)
///      } }` -- same synthesis point and shape as the #944 Error boundary
///      above. The arm is TAIL-RESUMPTIVE: in an entry-row-Async program
///      with no suspend-class handler of its own this compiles on the
///      cheap evidence path, and `sleep_blocking` (the row-free host
///      sleep) preserves the blocking semantics. A program that ALSO
///      spawns suspend-class tasks (`TaskGroup::spawn_suspend`) gets the
///      suspend-class spelling of the same arm (`resume` bound first),
///      placed inside the exception boundary (#2065 wall 2,
///      async_boundary_spawn_suspend_test.vibe). A task awaiting a host
///      future or reading a host stream parks on it (#1537,
///      lc_host_hooks_install).
///
/// Keyed on the entry row (like lc_wrap_entry_error_boundary): programs
/// whose entry row has no `Async` -- including the `__no_entry__`
/// test-runner lane and library_mode -- are untouched and keep the
/// blocking `vibe.sleep` builtin lowering. A user-defined top-level
/// `sleep` also disables the injection (their definition already shadows
/// the builtin).
/// Does pattern `p` bind the name `sleep` (an arm under it sees a
/// different `sleep`)?
/// Does `p` bind `target`? Generalized from the `sleep`-only original when
/// ADR-0089 (c)'s named-host-future collector needed the same shadow test
/// for its own name (#1337 Codex review).
export fn lc_pat_binds_name(p: Pat, target: String) -> Bool {
  match p {
    PBind(n) => n == target,
    PCtor(_, ps) => lc_pats_bind_name(ps, target),
    PTuple(ps) => lc_pats_bind_name(ps, target),
    POr(a, b) => lc_pat_binds_name(a, target) || lc_pat_binds_name(b, target),
    PStruct(_, fields) => {
      let mut i = 0
      let mut hit = false
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        if lc_pat_binds_name(fp, target) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    _ => false
  }
}

export fn lc_pats_bind_name(ps: Array[Pat], target: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(ps) {
    if lc_pat_binds_name(Array::get(ps, i), target) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn lc_pat_binds_sleep(p: Pat) -> Bool {
  lc_pat_binds_name(p, "sleep")
}

/// Rewrite calls to the BUILTIN `sleep` into calls to the injected
/// `__slp_perform` (see lc_inject_async_sleep_boundary). `active` goes
/// false for the subtree under any binder that shadows the name -- a local
/// `sleep` binding is the user's own value and must keep resolving to it.
///
/// Why a rename instead of just naming the injected fn `sleep` (which the
/// prefer-bound rule would route to): a top-level fn LITERALLY NAMED after
/// a row-carrying builtin miscompiles today -- the evidence pass classifies
/// the call site by the builtin's nominal row while codegen dispatches to
/// the bound fn, and the emitted call's arity disagrees ("not enough
/// arguments on the stack for call"). Measured on the pre-change compiler
/// with a hand-written `fn sleep`; latent for any user doing the same
/// (recorded in #1218). The fresh name sidesteps that double
/// classification entirely.
export fn lc_rename_sleep_calls(e: Expr, active: Bool) -> Expr {
  match e {
    ECall(callee, args, off, callee_resolution) => {
      let new_args = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(new_args, lc_rename_sleep_calls(Array::get(args, i), active))
        i = i + 1
      }
      let new_callee = match callee {
        EIdent(nm, coff) => if active && nm == "sleep" {
          EIdent("__slp_perform", coff)
        } else {
          callee
        },
        _ => lc_rename_sleep_calls(callee, active)
      }
      ECall(new_callee, new_args, off, callee_resolution)
    },
    ELet(x, v, b, off) => ELet(x, lc_rename_sleep_calls(v, active), lc_rename_sleep_calls(b, active && x != "sleep"), off),
    ELetMut(x, v, b, off) => ELetMut(x, lc_rename_sleep_calls(v, active), lc_rename_sleep_calls(b, active && x != "sleep"), off),
    ELetRec(x, v, b) => {
      let inner = active && x != "sleep"
      ELetRec(x, lc_rename_sleep_calls(v, inner), lc_rename_sleep_calls(b, inner))
    },
    ESeq(a, b) => ESeq(lc_rename_sleep_calls(a, active), lc_rename_sleep_calls(b, active)),
    EIf(c, t, el) => EIf(lc_rename_sleep_calls(c, active), lc_rename_sleep_calls(t, active), lc_rename_sleep_calls(el, active)),
    EMatch(s, arms) => {
      let out: Array[(Pat, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (mp, mb) = Array::get(arms, i)
        Array::push(out, (mp, lc_rename_sleep_calls(mb, active && !lc_pat_binds_sleep(mp))))
        i = i + 1
      }
      EMatch(lc_rename_sleep_calls(s, active), out)
    },
    EHandle(b, arms) => {
      let out: Array[(Pat, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (mp, mb) = Array::get(arms, i)
        Array::push(out, (mp, lc_rename_sleep_calls(mb, active && !lc_pat_binds_sleep(mp))))
        i = i + 1
      }
      EHandle(lc_rename_sleep_calls(b, active), out)
    },
    EFn(tps, tbs, params, ret, eff, b) => {
      let mut shadowed = false
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        if pn == "sleep" {
          shadowed = true
        } else {
          ()
        }
        i = i + 1
      }
      EFn(tps, tbs, params, ret, eff, lc_rename_sleep_calls(b, active && !shadowed))
    },
    EWhile(c, b) => EWhile(lc_rename_sleep_calls(c, active), lc_rename_sleep_calls(b, active)),
    EForIn(x, ix, it, b) => {
      let inner = active && x != "sleep"
      EForIn(x, ix, lc_rename_sleep_calls(it, active), lc_rename_sleep_calls(b, inner))
    },
    ELoop(pairs, b) => {
      let out: Array[(String, Expr)] = array_empty()
      let mut inner = active
      let mut i = 0
      while i < Array::length(pairs) {
        let (pn, pv) = Array::get(pairs, i)
        if pn == "sleep" {
          inner = false
        } else {
          ()
        }
        Array::push(out, (pn, lc_rename_sleep_calls(pv, active)))
        i = i + 1
      }
      ELoop(out, lc_rename_sleep_calls(b, inner))
    },
    EBinOp(op, l, r, boff) => EBinOp(op, lc_rename_sleep_calls(l, active), lc_rename_sleep_calls(r, active), boff),
    EUnaryOp(op, a) => EUnaryOp(op, lc_rename_sleep_calls(a, active)),
    EAssign(x, v, b, target_off) => EAssign(x, lc_rename_sleep_calls(v, active), lc_rename_sleep_calls(b, active), target_off),
    EAssignOp(n, op, v, b, target_off) => EAssignOp(n, op, lc_rename_sleep_calls(v, active), lc_rename_sleep_calls(b, active), target_off),
    EReturn(a) => EReturn(lc_rename_sleep_calls(a, active)),
    EDot(o, f, m, off) => EDot(lc_rename_sleep_calls(o, active), f, m, off),
    ELabeledArg(l, s, v) => ELabeledArg(l, s, lc_rename_sleep_calls(v, active)),
    EBreak(opt) => match opt {
      Some(a) => EBreak(Some(lc_rename_sleep_calls(a, active))),
      None => e
    },
    EContinue(args) => {
      let out = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(out, lc_rename_sleep_calls(Array::get(args, i), active))
        i = i + 1
      }
      EContinue(out)
    },
    ETuple(items) => {
      let out = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(items) {
        Array::push(out, lc_rename_sleep_calls(Array::get(items, i), active))
        i = i + 1
      }
      ETuple(out)
    },
    EArray(items) => {
      let out = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(items) {
        Array::push(out, lc_rename_sleep_calls(Array::get(items, i), active))
        i = i + 1
      }
      EArray(out)
    },
    ERecord(nm, fields, off) => {
      let out: Array[(String, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fn2, fv) = Array::get(fields, i)
        Array::push(out, (fn2, lc_rename_sleep_calls(fv, active)))
        i = i + 1
      }
      ERecord(nm, out, off)
    },
    EMap(fields) => {
      let out: Array[(String, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fk, fv) = Array::get(fields, i)
        Array::push(out, (fk, lc_rename_sleep_calls(fv, active)))
        i = i + 1
      }
      EMap(out)
    },
    ESpread(a) => ESpread(lc_rename_sleep_calls(a, active)),
    _ => e
  }
}
