/// A pre-prelude snapshot (`keys[i]` at `files[i]`) as the index
/// `lc_dbg_file_of_fn` reads, under ONE collision policy: a repeat is
/// AMBIGUOUS, marked with a negative so the lookup can tell it from absent.
///
/// Both of that function's indexes are built here, because both key spaces have
/// a shape nothing uniquifies and the two rules drifted when they were written
/// twice. The name index carries `__test_<label>` / `__bench_<label>`, built
/// from a test's or bench's LABEL; the owner index carries `:t:<label>` /
/// `:b:<label>`, built from the same label. Two modules with a test of the same
/// label collide in each. "Last wins" hands both compiled functions the second
/// module's file and "first wins" hands them the first's -- and a wrong file id
/// is a CLAIM, mapped through the wrong module's newline table, whereas file 0
/// is `lc_dbg_file_of_fn` admitting it has no placement. The owner index said
/// "first wins: a merged program's top-level names are unique", which is true
/// of the other two owner shapes (a plain name, uniquified by the merge;
/// `:s:<tag>:<idx>`, by position) and not of the label ones (Codex P2 on
/// #2623). One function, so a fix to one is a fix to both.
export fn lc_dbg_build_file_index(keys: Array[String], files: Array[Int]) -> MutMap[String, Int] {
  let idx: MutMap[String, Int] = MutMap::new_string()
  let mut i = 0
  while i < Array::length(keys) && i < Array::length(files) {
    let k = Array::get(keys, i)
    if MutMap::has(idx, k) {
      MutMap::set(idx, k, 0 - 1)
    } else {
      MutMap::set(idx, k, Array::get(files, i))
    }
    i = i + 1
  }
  idx
}

/// `lc_dbg_file_of_fn` over the two pre-prelude snapshots the compile takes,
/// for tests. It runs the real builder and the real lookup rather than a
/// restatement of either, so a test written against it cannot pass under a
/// policy the compiler does not have.
/// #2669 step 2b: name -> source file over the pre-prelude snapshot, with an
/// AMBIGUOUS name mapped to -1.
///
/// Ambiguity is real rather than hypothetical: two `test "..."` blocks with the
/// same title lower to one `__test_` name, and two files can hold that pair.
/// First-wins would attribute one file's function to another, which under the
/// widened body cache is exactly the mistake that replays an edited file's
/// stale body.
export fn lc_build_name_origin_index(names: Array[String], files: Array[Int]) -> MutMap[String, Int] {
  let out: MutMap[String, Int] = MutMap::new_string()
  let n = if Array::length(names) < Array::length(files) {
    Array::length(names)
  } else {
    Array::length(files)
  }
  let mut i = 0
  while i < n {
    let nm = Array::get(names, i)
    let f = Array::get(files, i)
    match MutMap::get(out, nm) {
      Some(prev) => if prev != f {
        MutMap::set(out, nm, 0 - 1)
      } else {
        ()
      },
      None => MutMap::set(out, nm, f)
    }
    i = i + 1
  }
  out
}

/// The source file or statement position for `name`, or -1 if ambiguous.
export fn lc_fn_origin_lookup(index: MutMap[String, Int], name: String) -> Int {
  match MutMap::get(index, name) {
    Some(f) => f,
    None => 0 - 1
  }
}

export fn lc_dbg_file_of_fn_for(names: Array[String], name_files: Array[Int], owner_keys: Array[String], owner_files: Array[Int], name: String) -> Int {
  lc_dbg_file_of_fn(lc_dbg_build_file_index(names, name_files), lc_dbg_build_file_index(owner_keys, owner_files), name)
}

/// `lc_dbg_file_placed` over the two snapshots, for tests -- the same
/// arrangement as `lc_dbg_file_of_fn_for`, one rung lower, so a test can pin
/// the DIFFERENCE between the two answers (a placement of 0 and no placement
/// at all) rather than the 0 both spell.
export fn lc_dbg_file_placed_for(names: Array[String], name_files: Array[Int], owner_keys: Array[String], owner_files: Array[Int], name: String) -> Int {
  lc_dbg_file_placed(lc_dbg_build_file_index(names, name_files), lc_dbg_build_file_index(owner_keys, owner_files), name)
}

/// Interior-line breakpoints: the source file a compiled function came from,
/// looked up BY NAME (#2388).
///
/// `prov.stmt_file_id` maps merged PRE-PRELUDE statement positions to files,
/// while the codegen loop below runs over the POST-prelude program -- so
/// indexing it with a post-prelude statement index is only correct while the
/// prelude neither adds nor removes a top-level statement. It does both: every
/// derived comparator, trait-operation dispatcher, monoify specialization and
/// `__exn_kind_cell` is appended past the end, and a hoisted lambda is inserted
/// next to its own declaration (#2620), which SHIFTS every statement after it.
/// Reading the array at a post-prelude index therefore ran off the end --
/// measured before this lookup, a `vibe build` under VIBE_DEBUG_BREAK=1 died
/// with `Array::get: index 4 out of bounds for length 3` on a single file whose
/// only synthesis was one `derive (Eq)`, and `index 7 out of bounds for length
/// 5` on a two-file program with a hoisted lambda. A program with no synthesis
/// at all compiled, which is why the lane looked healthy.
///
/// A NAME is the identity that survives the prelude: the merge makes every
/// top-level name unique (`<name>_dep_<path>` for a private one, `<name>_exp_
/// <path>` for an exported one), so the pre-prelude name -> file index answers
/// for every function the source wrote, whatever the passes did to positions.
///
/// A function the prelude SYNTHESIZED has no pre-prelude name. Where it
/// records the module it belongs to in its own name -- a hoisted lambda,
/// whose top-level definition is its declaration's and no one else's (#2618)
/// -- that owner answers instead, against an index keyed by the hoist's OWN
/// owner spelling (`hoisted_lambda_owner_of_stmt`). Mirroring those spellings
/// here instead covered `SLet` / `STest` / `SBench` and missed `SLetPat`, so a
/// lambda hoisted out of a top-level pattern binding silently fell through to
/// the default (Codex P2 on #2623).
///
/// What records no owner is a program-level definition that belongs to no
/// single file: a comparator derived for a type is emitted once and called
/// from wherever that type is compared. `lc_dbg_file_placed` answers -1 for
/// those, and for every other name it cannot place; this wrapper is the BREAK
/// lane's reading of that, where 0 is a placement rather than a claim -- a
/// breakpoint set in a file is matched by basename against `vibe.dbgfiles`, so
/// the effect is that a synthesized body reports the first file's name, not
/// that a user's breakpoint moves.
///
/// The production `vibe.linemap` (#2199) cannot read it that way: a row is not
/// matched against anything, it is PRINTED at a trap, so file 0 there is a
/// fabricated `path:line` for a body that may be in any file (Codex P2 on PR
/// #2867). That lane takes `lc_dbg_file_placed` directly and emits no rows for
/// a function it refuses to place.
fn lc_dbg_file_of_fn(dbg_name_file: MutMap[String, Int], dbg_owner_file: MutMap[String, Int], name: String) -> Int {
  lc_dbg_file_break(lc_dbg_file_placed(dbg_name_file, dbg_owner_file, name))
}

/// The break lane's reading of a placement, as its own function so the codegen
/// loop -- which already holds the placement and must not look it up twice --
/// and `lc_dbg_file_of_fn_for` (what the tests call) go through the SAME rule.
/// A test against a restatement of it would pass under a policy the compiler
/// does not have.
export fn lc_dbg_file_break(placed: Int) -> Int {
  if placed < 0 {
    0
  } else {
    placed
  }
}

/// The source file `name` is KNOWN to have come from, or -1 when this cannot
/// say: the name is in neither index, or it is in one of them twice (two
/// modules with a same-labelled test lower to one `__test_<label>` name, and
/// one `:t:<label>` owner key). Absent and ambiguous answer alike on purpose
/// -- neither places the body, and a caller that treats "no placement" as a
/// file is wrong the same way for both.
export fn lc_dbg_file_placed(dbg_name_file: MutMap[String, Int], dbg_owner_file: MutMap[String, Int], name: String) -> Int {
  match MutMap::get(dbg_name_file, name) {
    Some(fid) => if fid < 0 {
      // Ambiguous: two pre-prelude statements carry this name, so it places
      // nothing. Answers like an unknown name rather than picking.
      0 - 1
    } else {
      fid
    },
    None => match hoisted_lambda_owner_key(name) {
      Some(owner) => match MutMap::get(dbg_owner_file, owner) {
        // Ambiguous owners refuse exactly like ambiguous names: two pre-prelude
        // statements share this owner key (two modules with a same-labelled
        // test), so the hoisted body belongs to one of two files and this
        // places neither.
        Some(fid) => if fid < 0 {
          0 - 1
        } else {
          fid
        },
        None => 0 - 1
      },
      None => 0 - 1
    }
  }
}

/// #1666: does `name` name a top-level definition in this program?
///
/// Mirrors `stmt_name` in core/dce.vibe -- the same three statement shapes DCE
/// itself treats as named definitions. Used to decide whether reachability can
/// be rooted at an entry name at all.
export fn lc_defines_top_level(stmts: Array[Stmt], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    let named = match Array::get(stmts, i) {
      SLet(_, _, n, _, _) => n == name,
      SFnDecl(_, n, _, _, _) => n == name,
      SLetMut(n, _, _) => n == name,
      _ => false
    }
    if named {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Preserve every named definition that existed before lowering. MVP callers
/// have already removed unreachable source definitions, while ordinary
/// callers still need dead source to be validated; only helpers synthesized by
/// lowering should become newly eligible for this late DCE pass.
fn lc_derive_helper_names(stmts: Array[Stmt]) -> Array[String] {
  let names = lc_fresh_string_array()
  let mut i = 0
  while i < Array::length(stmts) {
    let type_name = match Array::get(stmts, i) {
      SStruct(_, n, _, _, _, _) => n,
      SEnum(_, n, _, _, _) => n,
      _ => ""
    }
    if type_name != "" {
      Array::push(names, String::concat(type_name, "::equals"))
      Array::push(names, String::concat(type_name, "::to_string"))
      Array::push(names, String::concat(type_name, "::hash_key"))
      Array::push(names, String::concat(type_name, "::compare"))
      Array::push(names, String::concat(type_name, "::default"))
    } else {
      ()
    }
    i = i + 1
  }
  names
}

//# ---------------------------------------------------------------------------
//# #2359: whole-module function pruning (exact decode + renumber)
//#
//# The older pass below (search "Binary-size: replace the bodies") shrinks an
//# unreachable generated helper's BODY to `unreachable` but must leave its
//# function index in place, because every call site references indices fixed
//# far earlier. Measured on `bench/binary_size`, that leftover index block is
//# the dominant term in a small module: 74 of `fib`'s 79 functions are
//# byte-identical 3-byte stubs, 371 B = 36% of the file.
//#
//# Removing the slots means renumbering, and renumbering is exactly what that
//# pass's safety argument does not support. It finds call targets by scanning
//# body bytes for `call`(0x10) / `ref.func`(0xd2) and decoding whatever
//# follows as a LEB. A byte that merely LOOKS like an opcode -- one inside
//# another instruction's immediate -- can only ever KEEP a helper that is
//# actually dead, which is harmless when the answer is "stub or not". Rewrite
//# the same byte and the module is corrupt.
//#
//# So this pass decodes instructions properly instead of scanning for them.
//# Every immediate is skipped by its own encoding, so a call opcode is only
//# recognized where an instruction actually starts, and the byte offset of
//# each call immediate is known exactly rather than guessed.
//#
//# The decode carries its own proof: a body is only accepted when the walk
//# lands EXACTLY on its final byte. A mis-decoded immediate desynchronizes the
//# walk, which then overshoots or stops short -- so "my opcode table is
//# incomplete" surfaces as a refusal, never as a wrong rewrite. Any unknown
//# opcode, any desync, any construct below that is not handled (a `ref.func`
//# in a global initializer, an unexpected element-segment encoding) abandons
//# pruning for the WHOLE module and returns the input unchanged. The cost of
//# being wrong about the encoding is the optimization, not the program.
//#
//# Gated to the same builds as the older pass, plus `enable_late_dce`: the
//# `compile_wasi_module_no_dce_impl` lane contracts not to prune, and this
//# honors that rather than making it prune by a different route.
//# ---------------------------------------------------------------------------

/// Read a LEB128 at `p`, returning the decoded value; `cell[0]` receives the
/// position just past it. Unsigned and signed LEBs share a terminator (the
/// first byte with bit 7 clear), so the SAME walk skips both -- only call and
/// ref.func immediates are read for their value, and those are unsigned.
fn lc_pf_leb(b: Bytes, p: Int, cell: Array[Int]) -> Int {
  let mut q = p
  let mut v = 0
  let mut shift = 0
  let mut more = true
  let len = Bytes::length(b)
  while more && q < len {
    let byte = Bytes::get(b, q)
    if shift < 35 {
      v = v|((byte&127)<<shift)
    } else {
      ()
    }
    q = q + 1
    if (byte&128) == 0 {
      more = false
    } else {
      shift = shift + 7
    }
  }
  Array::set(cell, 0, q)
  v
}

/// Skip a LEB128 at `p`, returning the position just past it.
fn lc_pf_skip_leb(b: Bytes, p: Int) -> Int {
  let mut q = p
  let mut more = true
  let len = Bytes::length(b)
  while more && q < len {
    let byte = Bytes::get(b, q)
    q = q + 1
    if (byte&128) == 0 {
      more = false
    } else {
      ()
    }
  }
  q
}

/// Skip a blocktype: `0x40` (empty), a single-byte value type, or a negative
/// LEB type index.
fn lc_pf_skip_blocktype(b: Bytes, p: Int) -> Int {
  let t = Bytes::get(b, p)
  if t == 64 || t == 127 || t == 126 || t == 125 || t == 124 || t == 123 || t == 112 || t == 111 {
    p + 1
  } else {
    lc_pf_skip_leb(b, p)
  }
}

/// Decode one function body's instructions, recording every `call` /
/// `return_call` / `ref.func` immediate into `sink` as one packed Int:
/// `(byte offset of the immediate) << 32 | (function index)`. The immediate's
/// byte length is not stored -- the re-emit skips the LEB again at that
/// offset, which is cheaper than a third parallel array over ~170k sites (the
/// compiler closure). Returns true only when the walk lands EXACTLY on
/// `body_end` -- see the header note: that equality is what makes an
/// incomplete opcode table refuse rather than corrupt.
fn lc_pf_decode_body(b: Bytes, instr_start: Int, body_end: Int, cell: Array[Int], sink: Array[Int]) -> Bool {
  let mut p = instr_start
  let mut ok = true
  while ok && p < body_end {
    let op = Bytes::get(b, p)
    p = p + 1
    if op == 16 || op == 18 || op == 210 {
      // call / return_call / ref.func -- the immediates this pass rewrites.
      let ipos = p
      let v = lc_pf_leb(b, p, cell)
      p = Array::get(cell, 0)
      if v > 4294967295 {
        // Not a u32: the LEB reader admits 35 bits, a function index does not.
        ok = false
      } else {
        Array::push(sink, (ipos<<32)|v)
      }
    } else if op == 2 || op == 3 || op == 4 || op == 6 {
      p = lc_pf_skip_blocktype(b, p)
    } else if op == 31 {
      // try_table: blocktype, then a vector of catch clauses (kinds 0/1 carry
      // a tag index AND a label, kinds 2/3 only a label).
      p = lc_pf_skip_blocktype(b, p)
      let nc = lc_pf_leb(b, p, cell)
      p = Array::get(cell, 0)
      let mut ci = 0
      while ci < nc && p < body_end {
        let kind = Bytes::get(b, p)
        p = p + 1
        p = lc_pf_skip_leb(b, p)
        if kind == 0 || kind == 1 {
          p = lc_pf_skip_leb(b, p)
        } else {
          ()
        }
        ci = ci + 1
      }
    } else if op == 14 {
      // br_table: vector of labels plus the default.
      let n = lc_pf_leb(b, p, cell)
      p = Array::get(cell, 0)
      let mut bi = 0
      while bi <= n && p < body_end {
        p = lc_pf_skip_leb(b, p)
        bi = bi + 1
      }
    } else if op == 28 {
      // select with an explicit result-type vector.
      let n = lc_pf_leb(b, p, cell)
      p = Array::get(cell, 0) + n
    } else if op == 12 || op == 13 || op == 7 || op == 8 || op == 9 || op == 24 || op == 32 || op == 33 || op == 34 || op == 35 || op == 36 || op == 37 || op == 38 || op == 63 || op == 64 || op == 208 {
      p = lc_pf_skip_leb(b, p)
    } else if op == 17 || op == 19 {
      // call_indirect / return_call_indirect: type index then table index.
      // The callee is dynamic, so the funcref table's own entries are roots.
      p = lc_pf_skip_leb(b, p)
      p = lc_pf_skip_leb(b, p)
    } else if op >= 40 && op <= 62 {
      p = lc_pf_skip_leb(b, p)
      p = lc_pf_skip_leb(b, p)
    } else if op == 65 || op == 66 {
      p = lc_pf_skip_leb(b, p)
    } else if op == 67 {
      p = p + 4
    } else if op == 68 {
      p = p + 8
    } else if op == 252 {
      // misc prefix (memory.copy/fill, table ops, saturating truncs)
      let sub = lc_pf_leb(b, p, cell)
      p = Array::get(cell, 0)
      if sub == 8 || sub == 10 || sub == 12 || sub == 14 {
        p = lc_pf_skip_leb(b, p)
        p = lc_pf_skip_leb(b, p)
      } else if sub == 9 || sub == 11 || sub == 13 || sub == 15 || sub == 16 || sub == 17 {
        p = lc_pf_skip_leb(b, p)
      } else {
        ()
      }
    } else if op == 253 {
      // SIMD prefix
      let sub = lc_pf_leb(b, p, cell)
      p = Array::get(cell, 0)
      if sub == 12 || sub == 13 {
        p = p + 16
      } else if sub >= 84 && sub <= 91 {
        p = lc_pf_skip_leb(b, p)
        p = lc_pf_skip_leb(b, p)
        p = p + 1
      } else if sub <= 11 || sub == 92 || sub == 93 {
        p = lc_pf_skip_leb(b, p)
        p = lc_pf_skip_leb(b, p)
      } else if sub >= 21 && sub <= 34 {
        p = p + 1
      } else {
        ()
      }
    } else if op == 0 || op == 1 || op == 5 || op == 11 || op == 15 || op == 25 || op == 26 || op == 27 || op == 209 {
      ()
    } else if op >= 69 && op <= 196 {
      ()
    } else {
      // Unknown opcode: refuse rather than guess (header note).
      ok = false
    }
  }
  ok && p == body_end
}

/// Byte length of `leb128_encode_u32(v)` for `0 <= v < 2^32`. The re-emit
/// below writes every section straight into the output buffer, and a
/// section's length prefix comes BEFORE its content, so each rewritten
/// section is sized by the same walk that later writes it (the `write`
/// flag of the `lc_pf_emit_*` helpers) and this answers what the encoder
/// will take.
fn lc_pf_leb_len(v: Int) -> Int {
  if v < 128 {
    1
  } else if v < 16384 {
    2
  } else if v < 2097152 {
    3
  } else if v < 268435456 {
    4
  } else {
    5
  }
}

/// How many entries `lc_pf_emit_exports` will emit: the section's count minus
/// the `func` exports whose function was pruned. Split out because the vec
/// header carries that number and is written BEFORE the entries, so both the
/// size pass and the write pass need it up front.
fn lc_pf_kept_export_count(mod_bytes: Bytes, sstart: Int, send: Int, cell: Array[Int], newidx: Array[Int]) -> Int {
  let c = lc_pf_leb(mod_bytes, sstart, cell)
  let mut q = Array::get(cell, 0)
  let mut kept = 0
  let mut ei = 0
  while ei < c && q < send {
    let nl = lc_pf_leb(mod_bytes, q, cell)
    q = Array::get(cell, 0) + nl
    let kind = Bytes::get(mod_bytes, q)
    q = q + 1
    let idx = lc_pf_leb(mod_bytes, q, cell)
    q = Array::get(cell, 0)
    if kind == 0 && idx < Array::length(newidx) && Array::get(newidx, idx) < 0 {
      ()
    } else {
      kept = kept + 1
    }
    ei = ei + 1
  }
  kept
}

/// Export section content through `newidx`: every `func` export is renumbered,
/// the others copied. Sizes when `write` is false, writes when true; returns
/// the content length either way.
///
/// #2497 unit 2: an export of a PRUNED function is DROPPED, not refused. This
/// comment used to say such an export "cannot happen unless the two walks
/// disagree", because the roots came from this very section -- and that
/// premise is exactly what `exports_stripped` removes. With the strip
/// announced, only the exports that outlive it are roots, so every other
/// function export names something the pruner is entitled to remove and the
/// strip is about to delete anyway. Keeping the entry would name a function
/// that no longer exists; refusing left the whole module unpruned, measured at
/// 23 KB on the compile-only artifact.
fn lc_pf_emit_exports(mod_bytes: Bytes, sstart: Int, send: Int, cell: Array[Int], newidx: Array[Int], failed: Array[Bool], dst: Bytes, write: Bool) -> Int {
  let c = lc_pf_leb(mod_bytes, sstart, cell)
  // Read the entry position BEFORE counting: `cell` is shared scratch, and
  // `lc_pf_kept_export_count` walks the whole section through it, so calling
  // it first leaves `cell[0]` at the section END. Doing that emitted a header
  // claiming `kept` entries followed by none, and the module failed to parse.
  let mut q = Array::get(cell, 0)
  let kept = lc_pf_kept_export_count(mod_bytes, sstart, send, cell, newidx)
  let mut n = lc_pf_leb_len(kept)
  if write {
    bytebuf_push_vec_header(dst, kept)
  } else {
    ()
  }
  let mut ei = 0
  while ei < c && q < send {
    let nl = lc_pf_leb(mod_bytes, q, cell)
    let nstart = Array::get(cell, 0)
    q = nstart + nl
    let kind = Bytes::get(mod_bytes, q)
    q = q + 1
    let idx = lc_pf_leb(mod_bytes, q, cell)
    q = Array::get(cell, 0)
    // Two different things used to share one refusal here. A `func` export
    // whose function was PRUNED is dropped (#2497 unit 2). An index outside
    // `newidx` is a malformed module -- nothing pruned it, the section simply
    // does not describe this program -- and that still refuses, because the
    // safe answer to "I do not understand this module" is to leave it alone.
    let out_of_range = kind == 0 && idx >= Array::length(newidx)
    let dropped = kind == 0 && !out_of_range && Array::get(newidx, idx) < 0
    if out_of_range {
      lc_pf_refuse(failed, 5)
    } else {
      ()
    }
    if dropped || out_of_range {
      ()
    } else {
      let mut out_idx = idx
      if kind == 0 {
        out_idx = Array::get(newidx, idx)
      } else {
        ()
      }
      n = n + lc_pf_leb_len(nl) + nl + 1 + lc_pf_leb_len(out_idx)
      if write {
        leb128_encode_u32(dst, nl)
        Bytes::blit(dst, mod_bytes, nstart, nstart + nl)
        bytebuf_push(dst, kind)
        leb128_encode_u32(dst, out_idx)
      } else {
        ()
      }
    }
    ei = ei + 1
  }
  n
}

/// Element section content through `newidx` (active table-0 segments only --
/// the section walk already refused any other flag). Same size / write
/// contract as lc_pf_emit_exports.
fn lc_pf_emit_elements(mod_bytes: Bytes, sstart: Int, send: Int, cell: Array[Int], newidx: Array[Int], failed: Array[Bool], dst: Bytes, write: Bool) -> Int {
  let c = lc_pf_leb(mod_bytes, sstart, cell)
  let mut q = Array::get(cell, 0)
  let mut n = lc_pf_leb_len(c)
  if write {
    bytebuf_push_vec_header(dst, c)
  } else {
    ()
  }
  let mut gi = 0
  while gi < c && q < send && !Array::get(failed, 0) {
    let flag = lc_pf_leb(mod_bytes, q, cell)
    q = Array::get(cell, 0)
    n = n + lc_pf_leb_len(flag)
    if write {
      leb128_encode_u32(dst, flag)
    } else {
      ()
    }
    let expr_from = q
    while q < send && Bytes::get(mod_bytes, q) != 11 {
      let iop = Bytes::get(mod_bytes, q)
      q = q + 1
      if iop == 65 || iop == 35 {
        q = lc_pf_skip_leb(mod_bytes, q)
      } else {
        ()
      }
    }
    q = q + 1
    n = n + (q - expr_from)
    if write {
      Bytes::blit(dst, mod_bytes, expr_from, q)
    } else {
      ()
    }
    let nf = lc_pf_leb(mod_bytes, q, cell)
    q = Array::get(cell, 0)
    n = n + lc_pf_leb_len(nf)
    if write {
      leb128_encode_u32(dst, nf)
    } else {
      ()
    }
    let mut fi = 0
    while fi < nf {
      let f = lc_pf_leb(mod_bytes, q, cell)
      q = Array::get(cell, 0)
      if f < Array::length(newidx) && Array::get(newidx, f) >= 0 {
        n = n + lc_pf_leb_len(Array::get(newidx, f))
        if write {
          leb128_encode_u32(dst, Array::get(newidx, f))
        } else {
          ()
        }
      } else {
        Array::set(failed, 0, true)
      }
      fi = fi + 1
    }
    gi = gi + 1
  }
  n
}

/// The function-name subsection (id 1) of the "name" custom section through
/// `newidx`: entries of pruned functions are dropped, the rest renumbered.
/// Returns the subsection's content length; writes it when `write` is true.
fn lc_pf_emit_name_funcs(mod_bytes: Bytes, sub_body: Int, sub_end: Int, cell: Array[Int], newidx: Array[Int], failed: Array[Bool], dst: Bytes, write: Bool) -> Int {
  let cnt = lc_pf_leb(mod_bytes, sub_body, cell)
  let mut q = Array::get(cell, 0)
  let mut kept_n = 0
  let mut kept_bytes = 0
  let mut ni = 0
  while ni < cnt && q < sub_end {
    let idx = lc_pf_leb(mod_bytes, q, cell)
    q = Array::get(cell, 0)
    let slen = lc_pf_leb(mod_bytes, q, cell)
    let sstart = Array::get(cell, 0)
    q = sstart + slen
    if idx < Array::length(newidx) && Array::get(newidx, idx) >= 0 {
      kept_n = kept_n + 1
      kept_bytes = kept_bytes + lc_pf_leb_len(Array::get(newidx, idx)) + lc_pf_leb_len(slen) + slen
    } else {
      ()
    }
    ni = ni + 1
  }
  if q != sub_end {
    Array::set(failed, 0, true)
  } else {
    ()
  }
  if write {
    bytebuf_push_vec_header(dst, kept_n)
    let _cnt2 = lc_pf_leb(mod_bytes, sub_body, cell)
    let mut q2 = Array::get(cell, 0)
    let mut wi = 0
    while wi < cnt && q2 < sub_end {
      let idx = lc_pf_leb(mod_bytes, q2, cell)
      q2 = Array::get(cell, 0)
      let slen = lc_pf_leb(mod_bytes, q2, cell)
      let sstart = Array::get(cell, 0)
      q2 = sstart + slen
      if idx < Array::length(newidx) && Array::get(newidx, idx) >= 0 {
        leb128_encode_u32(dst, Array::get(newidx, idx))
        leb128_encode_u32(dst, slen)
        Bytes::blit(dst, mod_bytes, sstart, sstart + slen)
      } else {
        ()
      }
      wi = wi + 1
    }
  } else {
    ()
  }
  lc_pf_leb_len(kept_n) + kept_bytes
}

/// The "name" custom section's content (`[sstart, send)` of `mod_bytes`,
/// starting at the section-name string) with its function-name subsection
/// remapped through `newidx` and every other subsection copied verbatim. A
/// name section left pointing at old indices would mislabel every frame in a
/// backtrace, which is worse than not shrinking, so a layout this does not
/// understand fails the prune. Same size / write contract as the other
/// `lc_pf_emit_*` helpers.
fn lc_pf_emit_name_section(mod_bytes: Bytes, sstart: Int, send: Int, cell: Array[Int], newidx: Array[Int], failed: Array[Bool], dst: Bytes, write: Bool) -> Int {
  let nlen = lc_pf_leb(mod_bytes, sstart, cell)
  let mut p = Array::get(cell, 0) + nlen
  let mut n = p - sstart
  if write {
    Bytes::blit(dst, mod_bytes, sstart, p)
  } else {
    ()
  }
  while p < send {
    let sub_id = Bytes::get(mod_bytes, p)
    p = p + 1
    let sub_len = lc_pf_leb(mod_bytes, p, cell)
    let sub_body = Array::get(cell, 0)
    let sub_end = sub_body + sub_len
    if sub_id == 1 {
      let names_len = lc_pf_emit_name_funcs(mod_bytes, sub_body, sub_end, cell, newidx, failed, dst, false)
      n = n + 1 + lc_pf_leb_len(names_len) + names_len
      if write {
        bytebuf_push(dst, 1)
        leb128_encode_u32(dst, names_len)
        lc_pf_emit_name_funcs(mod_bytes, sub_body, sub_end, cell, newidx, failed, dst, true)
      } else {
        ()
      }
    } else {
      n = n + 1 + lc_pf_leb_len(sub_len) + sub_len
      if write {
        bytebuf_push(dst, sub_id)
        leb128_encode_u32(dst, sub_len)
        Bytes::blit(dst, mod_bytes, sub_body, sub_end)
      } else {
        ()
      }
    }
    p = sub_end
  }
  n
}

/// Test entry for the #2359 pruner: the same pass the linked lane runs on
/// its finished module bytes. Returns the input unchanged wherever the pass
/// refuses (see lc_pf_prune_module).
export fn late_dce_prune_module(mod_bytes: Bytes) -> Bytes {
  lc_pf_prune_module(mod_bytes, "", false)
}

/// Why the last `lc_pf_prune_module` run left its input alone, for the
/// probes in tests: 0 = it pruned, -1 = nothing was unreachable, otherwise
/// the source line of the refusal or a small code for the early exits
/// (1 = too short or too large, 2 = section walk, 3 = no code section /
/// layout mismatch, 4 = a body did not decode, 5 = a section emitter
/// refused). The pass itself stays silent on purpose (the safe answer is
/// the unpruned module); this only makes that silence inspectable.
let lc_pf_refusal_cell: Array[Int] = [0]

/// Refuse the prune, and record WHERE. One helper rather than the two
/// `Array::set` calls repeated at every refusal site.
///
/// #2574: this shape existed on #2569's branch and was inlined back out,
/// because with it `late_dce_global_init_test`'s second case -- a 46-byte
/// module whose global initializer is `ref.func 0`, i.e. the one path that
/// reaches the refusal at the `ref.func` arm -- died with
///
///   [vibe] stack overflow while type-checking: one expression nests too
///   deeply, or the file has too many top-level declarations.
///
/// at RUN time, inside `late_dce_prune_module`. The first case (an `i32.const`
/// initializer, which prunes) passed, and so did a 3 MB compile-only module, so
/// only the refusing path overflowed. A standalone program of the same shape
/// did not, which is why the issue records that the trigger needs this
/// surrounding function.
///
/// Re-measured on main with the helper restored, it does not reproduce: the
/// test passes on the committed seed AND on a stage2 built from this tree, and
/// all four `compiler_gate.sh` lanes are green. The helper is genuinely on the
/// executed path -- flipping its `true` to `false` takes the same test's answer
/// from 2 to 1 -- so this is not a case of the refusal being skipped.
fn lc_pf_refuse(failed: Array[Bool], site: Int) -> Unit {
  Array::set(failed, 0, true)
  Array::set(lc_pf_refusal_cell, 0, site)
}

export fn late_dce_prune_refusal() -> Int {
  Array::get(lc_pf_refusal_cell, 0)
}

/// Test entry with the strip decision spelled out: `exports_stripped` roots
/// only the exports `executable_export_kept_bytes` keeps for `entry_name`.
export fn late_dce_prune_module_for(mod_bytes: Bytes, entry_name: String, exports_stripped: Bool) -> Bytes {
  lc_pf_prune_module(mod_bytes, entry_name, exports_stripped)
}

/// #2359: drop every function the module cannot reach and renumber what is
/// left. Roots are the exported functions plus every funcref-table entry (a
/// `call_indirect` target is only known dynamically, so a table slot is a
/// root, not an edge). Returns `mod_bytes` unchanged whenever anything is not
/// understood -- see the header note on why refusing is the safe answer.
/// #2497 unit 2: with `exports_stripped`, only the exports that outlive the
/// CLI's executable strip are roots (`executable_export_kept_bytes`, core).
/// A flat module source exports every function, so rooting them all made
/// the pass a no-op on exactly the builds it was meant for: measured on the
/// compile-only artifact, re-running the pruner after the strip removed
/// 23 KB the in-compile run had kept.
export fn lc_pf_prune_module(mod_bytes: Bytes, entry_name: String, exports_stripped: Bool) -> Bytes {
  let cell = lc_fresh_int_array()
  Array::push(cell, 0)
  let failed = lc_fresh_bool_array()
  Array::push(failed, false)
  Array::set(lc_pf_refusal_cell, 0, 0)
  let total = Bytes::length(mod_bytes)
  if total < 8 || total >= 1073741824 {
    Array::set(lc_pf_refusal_cell, 0, 1)
    // Below 8 bytes there is no header; at 1 GiB and above a byte offset no
    // longer fits the packed site record (lc_pf_decode_body).
    mod_bytes
  } else {
    // --- section table -------------------------------------------------
    let sec_id = lc_fresh_int_array()
    let sec_start = lc_fresh_int_array()
    let sec_len = lc_fresh_int_array()
    let mut p = 8
    let mut walk_ok = true
    while walk_ok && p < total {
      let sid = Bytes::get(mod_bytes, p)
      let n = lc_pf_leb(mod_bytes, p + 1, cell)
      let body = Array::get(cell, 0)
      if body + n > total {
        walk_ok = false
        Array::set(lc_pf_refusal_cell, 0, 2)
      } else {
        Array::push(sec_id, sid)
        Array::push(sec_start, body)
        Array::push(sec_len, n)
        p = body + n
      }
    }
    if !walk_ok {
      mod_bytes
    } else {
      let nsec = Array::length(sec_id)
      // --- imported function count, function types, bodies ---------------
      let mut num_imported = 0
      let ftypes = lc_fresh_int_array()
      let mut code_i = -1
      let body_instr = lc_fresh_int_array()
      let body_end = lc_fresh_int_array()
      let body_start = lc_fresh_int_array()
      let roots = lc_fresh_int_array()
      let mut si = 0
      while si < nsec && !Array::get(failed, 0) {
        let sid = Array::get(sec_id, si)
        let sstart = Array::get(sec_start, si)
        let send = sstart + Array::get(sec_len, si)
        if sid == 2 {
          let c = lc_pf_leb(mod_bytes, sstart, cell)
          let mut q = Array::get(cell, 0)
          let mut ii = 0
          while ii < c && q < send {
            let ml = lc_pf_leb(mod_bytes, q, cell)
            q = Array::get(cell, 0) + ml
            let nl = lc_pf_leb(mod_bytes, q, cell)
            q = Array::get(cell, 0) + nl
            let kind = Bytes::get(mod_bytes, q)
            q = q + 1
            if kind == 0 {
              q = lc_pf_skip_leb(mod_bytes, q)
              num_imported = num_imported + 1
            } else if kind == 1 {
              q = q + 1
              let lim = Bytes::get(mod_bytes, q)
              q = lc_pf_skip_leb(mod_bytes, q + 1)
              if lim == 1 {
                q = lc_pf_skip_leb(mod_bytes, q)
              } else {
                ()
              }
            } else if kind == 2 {
              let lim2 = Bytes::get(mod_bytes, q)
              q = lc_pf_skip_leb(mod_bytes, q + 1)
              if lim2 == 1 {
                q = lc_pf_skip_leb(mod_bytes, q)
              } else {
                ()
              }
            } else {
              q = q + 2
            }
            ii = ii + 1
          }
        } else if sid == 3 {
          let c = lc_pf_leb(mod_bytes, sstart, cell)
          let mut q = Array::get(cell, 0)
          let mut ti = 0
          while ti < c {
            let t = lc_pf_leb(mod_bytes, q, cell)
            q = Array::get(cell, 0)
            Array::push(ftypes, t)
            ti = ti + 1
          }
        } else if sid == 6 {
          // A `ref.func` in a global initializer would be an extra root this
          // pass does not model. None is emitted today; refuse if that changes.
          // #2552: decode each initializer -- the byte 0xD2 is also a valid
          // LEB128 byte inside an `i32.const` / `i64.const` immediate (the
          // compiler closure's `i32.const 59768` encodes as `f8 d2 03`), and
          // scanning for it refused whole modules that had no `ref.func` at
          // all, silently skipping the late DCE for them.
          let gcount = lc_pf_leb(mod_bytes, sstart, cell)
          let mut gq = Array::get(cell, 0)
          let mut gk = 0
          while gk < gcount && !Array::get(failed, 0) {
            // valtype, mutability, then one constant instruction and `end`.
            gq = gq + 2
            if gq >= send {
              lc_pf_refuse(failed, 4828)
            } else {
              let iop = Bytes::get(mod_bytes, gq)
              gq = gq + 1
              if iop == 65 || iop == 66 || iop == 35 {
                gq = lc_pf_skip_leb(mod_bytes, gq)
              } else if iop == 67 {
                gq = gq + 4
              } else if iop == 68 {
                gq = gq + 8
              } else if iop == 208 {
                gq = gq + 1
              } else {
                lc_pf_refuse(failed, 4842)
              }
              if !Array::get(failed, 0) {
                if gq < send && Bytes::get(mod_bytes, gq) == 11 {
                  gq = gq + 1
                } else {
                  lc_pf_refuse(failed, 4849)
                }
              } else {
                ()
              }
            }
            gk = gk + 1
          }
          if !Array::get(failed, 0) && gq != send {
            lc_pf_refuse(failed, 4859)
          } else {
            ()
          }
        } else if sid == 7 {
          let c = lc_pf_leb(mod_bytes, sstart, cell)
          let mut q = Array::get(cell, 0)
          let mut ei = 0
          while ei < c && q < send {
            let nl = lc_pf_leb(mod_bytes, q, cell)
            let name_start = Array::get(cell, 0)
            q = name_start + nl
            let kind = Bytes::get(mod_bytes, q)
            q = q + 1
            let idx = lc_pf_leb(mod_bytes, q, cell)
            q = Array::get(cell, 0)
            if kind == 0 && (!exports_stripped || executable_export_kept_bytes(mod_bytes, name_start, nl, entry_name)) {
              Array::push(roots, idx)
            } else {
              ()
            }
            ei = ei + 1
          }
        } else if sid == 9 {
          let c = lc_pf_leb(mod_bytes, sstart, cell)
          let mut q = Array::get(cell, 0)
          let mut gi2 = 0
          while gi2 < c && q < send && !Array::get(failed, 0) {
            let flag = lc_pf_leb(mod_bytes, q, cell)
            q = Array::get(cell, 0)
            if flag != 0 {
              // Only the active-table-0 form is emitted today.
              lc_pf_refuse(failed, 4892)
            } else {
              while q < send && Bytes::get(mod_bytes, q) != 11 {
                let iop = Bytes::get(mod_bytes, q)
                q = q + 1
                if iop == 65 || iop == 35 {
                  q = lc_pf_skip_leb(mod_bytes, q)
                } else {
                  ()
                }
              }
              q = q + 1
              let nf = lc_pf_leb(mod_bytes, q, cell)
              q = Array::get(cell, 0)
              let mut fi = 0
              while fi < nf {
                let f = lc_pf_leb(mod_bytes, q, cell)
                q = Array::get(cell, 0)
                Array::push(roots, f)
                fi = fi + 1
              }
            }
            gi2 = gi2 + 1
          }
        } else if sid == 8 {
          // A start function would be another root; none is emitted today.
          lc_pf_refuse(failed, 4919)
        } else if sid == 10 {
          code_i = si
          let c = lc_pf_leb(mod_bytes, sstart, cell)
          let mut q = Array::get(cell, 0)
          let mut bi = 0
          while bi < c && q < send {
            let sz = lc_pf_leb(mod_bytes, q, cell)
            let bstart = Array::get(cell, 0)
            let bend = bstart + sz
            let nl = lc_pf_leb(mod_bytes, bstart, cell)
            let mut r = Array::get(cell, 0)
            let mut li = 0
            while li < nl {
              r = lc_pf_skip_leb(mod_bytes, r)
              r = r + 1
              li = li + 1
            }
            Array::push(body_start, bstart)
            Array::push(body_instr, r)
            Array::push(body_end, bend)
            q = bend
            bi = bi + 1
          }
        } else {
          ()
        }
        si = si + 1
      }
      let nbodies = Array::length(body_end)
      if Array::get(failed, 0) || code_i < 0 || nbodies == 0 || Array::length(ftypes) != nbodies {
        // Codex review on #2569: a layout mismatch is a refusal too, and the
        // probes must not read the initial 0 ("pruned") for it.
        if Array::get(failed, 0) {
          ()
        } else {
          Array::set(lc_pf_refusal_cell, 0, 3)
        }
        mod_bytes
      } else {
        lc_pf_prune_with_layout(mod_bytes, cell, failed, sec_id, sec_start, sec_len, num_imported, ftypes, body_start, body_instr, body_end, roots, code_i)
      }
    }
  }
}

/// Second half of lc_pf_prune_module: decode every body, close reachability
/// over the call graph, then re-emit the module with the survivors renumbered.
/// Split out only because the section walk above already fills a screen.
///
/// Allocation is the cost to watch here, not time: this runs once per compile
/// on the finished module, and the selfcompile KPI (heap_ptr, the bump
/// high-water) counts every byte it touches. Measured on the compiler closure
/// (3.9 MB module, 4597 bodies, ~170k call sites) the first version spent
/// 46.7 MB: three parallel site arrays (12.6 MB), a fresh buffer per
/// rewritten body plus a code-section buffer appended into the output
/// (19.6 MB), and a copy of every other section on its way through (the
/// name section alone 3.3 MB). Now the sites are one packed array, every
/// section is written straight into the output buffer behind a length
/// computed by the same walk (`lc_pf_leb_len`, the `write` flag of the
/// `lc_pf_emit_*` helpers), and the reachability stack holds each function
/// once. What remains is the site array and the output buffer's own growth.
fn lc_pf_prune_with_layout(mod_bytes: Bytes, cell: Array[Int], failed: Array[Bool], sec_id: Array[Int], sec_start: Array[Int], sec_len: Array[Int], num_imported: Int, ftypes: Array[Int], body_start: Array[Int], body_instr: Array[Int], body_end: Array[Int], roots: Array[Int], code_i: Int) -> Bytes {
  let nbodies = Array::length(body_end)
  // --- decode every body once; remember each call immediate ---------------
  // Sites are stored flat (packed offset << 32 | target, lc_pf_decode_body)
  // with a per-body [begin, end) window into them, so the whole pass
  // allocates a fixed number of arrays regardless of module size.
  let site = lc_fresh_int_array()
  let site_from = lc_fresh_int_array()
  let mut bi = 0
  let mut all_ok = true
  while bi < nbodies && all_ok {
    Array::push(site_from, Array::length(site))
    all_ok = lc_pf_decode_body(mod_bytes, Array::get(body_instr, bi), Array::get(body_end, bi), cell, site)
    bi = bi + 1
  }
  Array::push(site_from, Array::length(site))
  if !all_ok {
    Array::set(lc_pf_refusal_cell, 0, 4)
    mod_bytes
  } else {
    // --- reachability -----------------------------------------------------
    // A function goes onto the stack once, when first seen; a target already
    // marked is not pushed again (the ~170k call edges of the compiler
    // closure would otherwise each cost a stack slot).
    let nfuncs = num_imported + nbodies
    let seen = lc_fresh_bool_array()
    let mut szi = 0
    while szi < nfuncs {
      Array::push(seen, false)
      szi = szi + 1
    }
    let stack = lc_fresh_int_array()
    let mut ri = 0
    while ri < Array::length(roots) {
      let r = Array::get(roots, ri)
      if r >= 0 && r < nfuncs && !Array::get(seen, r) {
        Array::set(seen, r, true)
        Array::push(stack, r)
      } else {
        ()
      }
      ri = ri + 1
    }
    let mut sp = 0
    while sp < Array::length(stack) {
      let f = Array::get(stack, sp)
      sp = sp + 1
      if f >= num_imported {
        let fb = f - num_imported
        let mut k = Array::get(site_from, fb)
        let kend = Array::get(site_from, fb + 1)
        while k < kend {
          let t = Array::get(site, k)&4294967295
          if t < nfuncs && !Array::get(seen, t) {
            Array::set(seen, t, true)
            Array::push(stack, t)
          } else {
            ()
          }
          k = k + 1
        }
      } else {
        ()
      }
    }
    // --- old -> new index map (imports keep their indices) ----------------
    let newidx = lc_fresh_int_array()
    let mut mi = 0
    while mi < num_imported {
      Array::push(newidx, mi)
      mi = mi + 1
    }
    let keep = lc_fresh_int_array()
    let mut ki = 0
    while ki < nbodies {
      if Array::get(seen, ki + num_imported) {
        Array::push(newidx, num_imported + Array::length(keep))
        Array::push(keep, ki)
      } else {
        Array::push(newidx, -1)
      }
      ki = ki + 1
    }
    if Array::length(keep) == nbodies {
      // Nothing to drop: leave the bytes untouched rather than re-emitting
      // an identical module.
      //
      // This early-out is deliberately exact and NOT a dead-fraction
      // threshold. A threshold looks attractive because the re-emit costs
      // compile-time heap in proportion to module size while the saving is
      // only the dead bodies' bytes, so skipping a barely-dead module looks
      // free. It is not free: skipping always buys transient compile heap
      // with permanent OUTPUT size, which is backwards for a pass whose
      // purpose is output size. At the selfcompile KPI input -- 4.4% dead,
      // 203 of 4597 bodies, 93630 B of 3.99 MB -- the whole pass now costs
      // 13275388 heap bytes, and not worth taking while the
      // heap gate still allows growth (its ceiling is the committed baseline
      // + 10%, ci.yml).
      //
      // That rate is not constant, so do not extrapolate this one point. The
      // re-emit's cost tracks module size while the saving tracks
      // dead_fraction * module size, so skipping gets relatively cheaper as
      // the dead fraction falls. A threshold is therefore unmeasured here,
      // not refuted -- justifying one needs heap numbers from the barely-dead
      // inputs that motivate it. What is settled is the direction: skipping
      // never saves output bytes, so the only free case is nothing to drop
      // at all, which is the test above.
      Array::set(lc_pf_refusal_cell, 0, 0 - 1)
      mod_bytes
    } else {
      lc_pf_reemit(mod_bytes, cell, failed, sec_id, sec_start, sec_len, newidx, ftypes, keep, body_start, body_end, site, site_from, num_imported)
    }
  }
}

/// Code-section content for the kept bodies: sizes when `write` is false,
/// writes when true, returns the content length either way. A kept body
/// calling something the walk pruned means the reachability closure and the
/// rewrite disagree, so neither is trusted (fails the prune).
fn lc_pf_emit_code(mod_bytes: Bytes, newidx: Array[Int], keep: Array[Int], body_start: Array[Int], body_end: Array[Int], site: Array[Int], site_from: Array[Int], failed: Array[Bool], dst: Bytes, write: Bool) -> Int {
  let nkeep = Array::length(keep)
  let mut n = lc_pf_leb_len(nkeep)
  if write {
    bytebuf_push_vec_header(dst, nkeep)
  } else {
    ()
  }
  let mut kj = 0
  while kj < nkeep && !Array::get(failed, 0) {
    let b = Array::get(keep, kj)
    // The body's size after renumbering: each immediate is replaced by the
    // LEB of its new index.
    let mut sz = Array::get(body_end, b) - Array::get(body_start, b)
    let kfrom = Array::get(site_from, b)
    let kend = Array::get(site_from, b + 1)
    let mut k = kfrom
    while k < kend {
      let pk = Array::get(site, k)
      let pos = pk>>32
      let target = pk&4294967295
      if target >= Array::length(newidx) || Array::get(newidx, target) < 0 {
        lc_pf_refuse(failed, 5123)
      } else {
        sz = sz - (lc_pf_skip_leb(mod_bytes, pos) - pos) + lc_pf_leb_len(Array::get(newidx, target))
      }
      k = k + 1
    }
    n = n + lc_pf_leb_len(sz) + sz
    if write && !Array::get(failed, 0) {
      leb128_encode_u32(dst, sz)
      let mut prev = Array::get(body_start, b)
      let mut w = kfrom
      while w < kend {
        let pk = Array::get(site, w)
        let pos = pk>>32
        Bytes::blit(dst, mod_bytes, prev, pos)
        leb128_encode_u32(dst, Array::get(newidx, pk&4294967295))
        prev = lc_pf_skip_leb(mod_bytes, pos)
        w = w + 1
      }
      Bytes::blit(dst, mod_bytes, prev, Array::get(body_end, b))
    } else {
      ()
    }
    kj = kj + 1
  }
  n
}

/// Write one section into `out`: id, the content length the sizing walk
/// computed, then the content through the same walk in write mode. The
/// writer landing on any other length than it announced would be a corrupt
/// module, so that is checked and fails the prune.
fn lc_pf_check_written(out: Bytes, content_start: Int, announced: Int, failed: Array[Bool]) -> Unit {
  if bytebuf_length(out) - content_start != announced {
    lc_pf_refuse(failed, 5158)
  } else {
    ()
  }
}

/// #2199: the `vibe.linemap` format marker, written right after the section
/// name and before the first record. See the emission site for why the name
/// alone is not enough to identify the encoding.
export fn lc_linemap_put_magic(dst: Bytes) -> Unit {
  bytebuf_push(dst, 'V')
  bytebuf_push(dst, 'L')
  bytebuf_push(dst, 'M')
  bytebuf_push(dst, '1')
}

/// Is `VLM1` at `pos` in `src`, with `end` the section's end?
fn lc_linemap_has_magic(src: Bytes, pos: Int, end: Int) -> Bool {
  pos + 4 <= end && Bytes::get(src, pos) == 'V' && Bytes::get(src, pos + 1) == 'L' && Bytes::get(src, pos + 2) == 'M' && Bytes::get(src, pos + 3) == '1'
}

/// #2199: remap `vibe.linemap` through the prune's old->new function map, and
/// shift each record's code offset by the call-immediate LEB size change in
/// that body so wasmtime's func_offset still hits the right entry.
///
/// Encoding (compact LEB deltas, one record = four unsigned LEBs):
///   func_delta, offset_delta, file_id, line
/// Records are already in (func, offset) order from sequential compile.
/// func_delta is the increment from the previous func (the first record's
/// func is absolute). When func_delta != 0, offset restarts as an absolute;
/// otherwise offset_delta is from the previous offset. Duplicate
/// (func, offset) rows are not emitted.
///
/// Encode/remap streams one row at a time. Copying the table into scratch
/// arrays showed up as selfcompile bump high-water (#2199, +4% on the
/// compact-encoding commit) because the KPI lane never frees.
fn lc_linemap_put_row(dst: Bytes, f: Int, o: Int, file_id: Int, line: Int, prev_f: Int, prev_o: Int, have: Bool, write: Bool) -> Int {
  let fd = if have {
    f - prev_f
  } else {
    f
  }
  let od = if have && fd == 0 {
    o - prev_o
  } else {
    o
  }
  if write {
    leb128_encode_u32(dst, fd)
    leb128_encode_u32(dst, od)
    leb128_encode_u32(dst, file_id)
    leb128_encode_u32(dst, line)
    0
  } else {
    lc_pf_leb_len(fd) + lc_pf_leb_len(od) + lc_pf_leb_len(file_id) + lc_pf_leb_len(line)
  }
}

fn lc_linemap_remap_stream(mod_bytes: Bytes, rec_start: Int, send: Int, cell: Array[Int], newidx: Array[Int], num_imported: Int, body_start: Array[Int], site: Array[Int], site_from: Array[Int], dst: Bytes, write: Bool) -> Int {
  Array::set(cell, 0, rec_start)
  let mut have_in = false
  let mut func = 0
  let mut off = 0
  // Both records and decoded call sites are ordered by their old offsets.
  // Each size/write pass owns its cursor; advance each body site once rather
  // than re-decoding every immediate for every source row. No scratch table.
  let mut call_next = 0
  let mut call_end = 0
  let mut call_body_start = 0
  let mut call_delta = 0
  let mut have_out = false
  let mut prev_f = 0
  let mut prev_o = 0
  let mut size = 0
  let mut more = true
  while more && Array::get(cell, 0) < send {
    let p0 = Array::get(cell, 0)
    let fd = lc_pf_leb(mod_bytes, p0, cell)
    let p1 = Array::get(cell, 0)
    if p1 > send {
      more = false
    } else {
      let od = lc_pf_leb(mod_bytes, p1, cell)
      let p2 = Array::get(cell, 0)
      if p2 > send {
        more = false
      } else {
        let file_id = lc_pf_leb(mod_bytes, p2, cell)
        let p3 = Array::get(cell, 0)
        if p3 > send {
          more = false
        } else {
          let line = lc_pf_leb(mod_bytes, p3, cell)
          let p4 = Array::get(cell, 0)
          if p4 > send {
            more = false
          } else {
            if have_in && fd == 0 {
              off = off + od
            } else {
              func = if have_in {
                func + fd
              } else {
                fd
              }
              off = od
              have_in = true
              call_next = 0
              call_end = 0
              call_delta = 0
              let body_idx = func - num_imported
              if body_idx >= 0 && body_idx + 1 < Array::length(site_from) && body_idx < Array::length(body_start) {
                call_next = Array::get(site_from, body_idx)
                call_end = Array::get(site_from, body_idx + 1)
                call_body_start = Array::get(body_start, body_idx)
              } else {
                ()
              }
            }
            if func < Array::length(newidx) && Array::get(newidx, func) >= 0 {
              let nf = Array::get(newidx, func)
              // A row at the immediate's start has not crossed its size
              // change yet. Keep the original strict boundary comparison.
              while call_next < call_end && (Array::get(site, call_next)>>32) - call_body_start < off {
                let pk = Array::get(site, call_next)
                let pos = pk>>32
                let target = pk&4294967295
                if target < Array::length(newidx) && Array::get(newidx, target) >= 0 {
                  let old_leb = lc_pf_skip_leb(mod_bytes, pos) - pos
                  call_delta = call_delta + lc_pf_leb_len(Array::get(newidx, target)) - old_leb
                } else {
                  ()
                }
                call_next = call_next + 1
              }
              let no = off + call_delta
              if have_out && nf == prev_f && no == prev_o {
                ()
              } else {
                size = size + lc_linemap_put_row(dst, nf, no, file_id, line, prev_f, prev_o, have_out, write)
                prev_f = nf
                prev_o = no
                have_out = true
              }
            } else {
              ()
            }
          }
        }
      }
    }
  }
  size
}

/// #2199: the section carries a 4-byte format marker between its name and its
/// first record. The prune rewrites the records, so it steps over the marker
/// on the way in and writes a fresh one on the way out.
///
/// A section without the marker is one this compile did not emit, so its
/// records are in an encoding this remap does not know. It is rewritten to
/// the marker and NO records: a table whose function indices the prune just
/// invalidated is worse than none, and a reader that finds no rows reports no
/// location rather than a wrong one.
fn lc_pf_emit_linemap(mod_bytes: Bytes, sstart: Int, send: Int, cell: Array[Int], newidx: Array[Int], num_imported: Int, body_start: Array[Int], site: Array[Int], site_from: Array[Int], dst: Bytes, write: Bool) -> Int {
  let nlen = lc_pf_leb(mod_bytes, sstart, cell)
  let nstart = Array::get(cell, 0)
  let magic_start = nstart + nlen
  let rec_start = if lc_linemap_has_magic(mod_bytes, magic_start, send) {
    magic_start + 4
  } else {
    send
  }
  let rec_size = lc_linemap_remap_stream(mod_bytes, rec_start, send, cell, newidx, num_imported, body_start, site, site_from, dst, false)
  let size = lc_pf_leb_len(nlen) + nlen + 4 + rec_size
  if write {
    leb128_encode_u32(dst, nlen)
    Bytes::blit(dst, mod_bytes, nstart, nstart + nlen)
    lc_linemap_put_magic(dst)
    let _ = lc_linemap_remap_stream(mod_bytes, rec_start, send, cell, newidx, num_imported, body_start, site, site_from, dst, true)
  } else {
    ()
  }
  size
}

/// Final step: write the module back out, substituting the rebuilt function
/// and code sections and remapping every function index the other sections
/// carry (exports, element segments, the name section, vibe.linemap). Every
/// section goes straight into one reserved output: the sizing mode of each
/// helper supplies both its section length and the total capacity before
/// writing begins.
fn lc_pf_reemit(mod_bytes: Bytes, cell: Array[Int], failed: Array[Bool], sec_id: Array[Int], sec_start: Array[Int], sec_len: Array[Int], newidx: Array[Int], ftypes: Array[Int], keep: Array[Int], body_start: Array[Int], body_end: Array[Int], site: Array[Int], site_from: Array[Int], num_imported: Int) -> Bytes {
  // The sizing helpers never write in this mode. Keep their results so the
  // existing sizing walk also determines the one output allocation.
  let sizing = bytebuf_new()
  let lengths = lc_fresh_int_array()
  let name_sections: Array[Bool] = []
  let linemap_sections: Array[Bool] = []
  let nkeep = Array::length(keep)
  let mut total = 8
  let mut si = 0
  while si < Array::length(sec_id) && !Array::get(failed, 0) {
    let sid = Array::get(sec_id, si)
    let sstart = Array::get(sec_start, si)
    let send = sstart + Array::get(sec_len, si)
    let mut size = send - sstart
    let mut is_name = false
    let mut is_linemap = false
    if sid == 3 {
      size = lc_pf_leb_len(nkeep)
      let mut fi = 0
      while fi < nkeep {
        size = size + lc_pf_leb_len(Array::get(ftypes, Array::get(keep, fi)))
        fi = fi + 1
      }
    } else if sid == 10 {
      size = lc_pf_emit_code(mod_bytes, newidx, keep, body_start, body_end, site, site_from, failed, sizing, false)
    } else if sid == 7 {
      size = lc_pf_emit_exports(mod_bytes, sstart, send, cell, newidx, failed, sizing, false)
    } else if sid == 9 {
      size = lc_pf_emit_elements(mod_bytes, sstart, send, cell, newidx, failed, sizing, false)
    } else if sid == 0 {
      let nlen = lc_pf_leb(mod_bytes, sstart, cell)
      let nstart = Array::get(cell, 0)
      is_name = nlen == 4 && Bytes::get(mod_bytes, nstart) == 110 && Bytes::get(mod_bytes, nstart + 1) == 97 && Bytes::get(mod_bytes, nstart + 2) == 109 && Bytes::get(mod_bytes, nstart + 3) == 101
      is_linemap = nlen == 12 && Bytes::get(mod_bytes, nstart) == 118 && Bytes::get(mod_bytes, nstart + 1) == 105 && Bytes::get(mod_bytes, nstart + 2) == 98 && Bytes::get(mod_bytes, nstart + 3) == 101 && Bytes::get(mod_bytes, nstart + 4) == 46 && Bytes::get(mod_bytes, nstart + 5) == 108 && Bytes::get(mod_bytes, nstart + 6) == 105 && Bytes::get(mod_bytes, nstart + 7) == 110 && Bytes::get(mod_bytes, nstart + 8) == 101 && Bytes::get(mod_bytes, nstart + 9) == 109 && Bytes::get(mod_bytes, nstart + 10) == 97 && Bytes::get(mod_bytes, nstart + 11) == 112
      if is_name {
        size = lc_pf_emit_name_section(mod_bytes, sstart, send, cell, newidx, failed, sizing, false)
      } else if is_linemap {
        size = lc_pf_emit_linemap(mod_bytes, sstart, send, cell, newidx, num_imported, body_start, site, site_from, sizing, false)
      } else {
        ()
      }
    } else {
      ()
    }
    Array::push(lengths, size)
    Array::push(name_sections, is_name)
    Array::push(linemap_sections, is_linemap)
    total = total + 1 + lc_pf_leb_len(size) + size
    si = si + 1
  }
  if Array::get(failed, 0) {
    return mod_bytes
  }
  let out = Bytes::with_capacity(total)
  Bytes::blit(out, mod_bytes, 0, 8)
  si = 0
  while si < Array::length(sec_id) && !Array::get(failed, 0) {
    let sid = Array::get(sec_id, si)
    let sstart = Array::get(sec_start, si)
    let send = sstart + Array::get(sec_len, si)
    let size = Array::get(lengths, si)
    bytebuf_push(out, sid)
    leb128_encode_u32(out, size)
    let cstart = bytebuf_length(out)
    if sid == 3 {
      bytebuf_push_vec_header(out, nkeep)
      let mut fi = 0
      while fi < nkeep {
        leb128_encode_u32(out, Array::get(ftypes, Array::get(keep, fi)))
        fi = fi + 1
      }
    } else if sid == 10 {
      lc_pf_emit_code(mod_bytes, newidx, keep, body_start, body_end, site, site_from, failed, out, true)
    } else if sid == 7 {
      lc_pf_emit_exports(mod_bytes, sstart, send, cell, newidx, failed, out, true)
    } else if sid == 9 {
      lc_pf_emit_elements(mod_bytes, sstart, send, cell, newidx, failed, out, true)
    } else if Array::get(name_sections, si) {
      lc_pf_emit_name_section(mod_bytes, sstart, send, cell, newidx, failed, out, true)
    } else if Array::get(linemap_sections, si) {
      lc_pf_emit_linemap(mod_bytes, sstart, send, cell, newidx, num_imported, body_start, site, site_from, out, true)
    } else {
      Bytes::blit(out, mod_bytes, sstart, send)
    }
    lc_pf_check_written(out, cstart, size, failed)
    si = si + 1
  }
  if Array::get(failed, 0) {
    mod_bytes
  } else {
    bytebuf_to_bytes(out)
  }
}

fn lc_is_derive_helper_name(derive_names: Array[String], name: String) -> Bool {
  String::starts_with(name, "__arr_equals__") || String::starts_with(name, "__arr_to_string__") || array_contains_str(derive_names, name)
}

fn lc_export_is_root(name: String, entry_name: String) -> Bool {
  !executable_exports_stripped() || executable_export_kept(name, entry_name)
}

fn lc_fn_alias_name(renames: Array[(String, String)], name: String) -> Bool {
  let mut i = 0
  while i < Array::length(renames) {
    let (alias, _) = Array::get(renames, i)
    if alias == name {
      return true
    }
    i = i + 1
  }
  false
}

fn lc_boundary_has_reexport(locals: Array[String]) -> Bool {
  let mut i = 0
  while i < Array::length(locals) {
    match builtin_iterator_namespace_from_marker(Array::get(locals, i)) {
      Some(_) => (),
      None => return true
    }
    i = i + 1
  }
  false
}

export fn lc_late_dce_roots(stmts: Array[Stmt], entry_name: String, keep_source_defs: Bool) -> Array[String] {
  let roots = lc_fresh_string_array()
  let derive_names = lc_derive_helper_names(stmts)
  let fn_aliases = collect_top_level_fn_alias_renames(stmts)
  let mut keep_all = keep_source_defs
  let mut scan = 0
  while scan < Array::length(stmts) {
    match Array::get(stmts, scan) {
      // An unmerged re-export can bind a renamed imported definition.
      SReExport(_, _) => keep_all = true,
      _ => ()
    }
    scan = scan + 1
  }
  Array::push(roots, entry_name)
  // FS merges put a boundary before each source. A re-export in a dependency
  // preserves that source's definitions, not unrelated definitions in the
  // entry source (which can include dead capability helpers).
  let mut keep_segment = keep_all
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SReExportSourceBoundary(locals, _) => keep_segment = keep_source_defs || lc_boundary_has_reexport(locals),
      SImport(_, _) => match builtin_iterator_serialized_boundary_markers(Array::get(stmts, i)) {
        Some(locals) => keep_segment = keep_source_defs || lc_boundary_has_reexport(locals),
        None => ()
      },
      // Keep ordinary value initializers available to the direct codegen
      // lane's diagnostics. Function values are the definitions whose dead
      // bodies can safely be removed before they commit host imports.
      SLet(exported, _, name, _, value) => if (keep_segment || (exported && lc_export_is_root(name, entry_name)) || match value {
        EFn(_, _, _, _, _, _) => false,
        EIdent(_, _) => !lc_fn_alias_name(fn_aliases, name),
        _ => true
      }) && !lc_is_derive_helper_name(derive_names, name) {
        Array::push(roots, name)
      } else {
        ()
      },
      SFnDecl(exported, name, _, _, _) => if (keep_segment || (exported && lc_export_is_root(name, entry_name))) && !lc_is_derive_helper_name(derive_names, name) {
        Array::push(roots, name)
      } else {
        ()
      },
      SLetMut(name, _, _) => {
        Array::push(roots, name)
      },
      SExport(names) => {
        let mut j = 0
        while j < Array::length(names) {
          let name = Array::get(names, j)
          if lc_export_is_root(name, entry_name) {
            Array::push(roots, name)
          } else {
            ()
          }
          j = j + 1
        }
      },
      STest(name, _) => Array::push(roots, String::concat("__test_", name)),
      SBench(name, _) => Array::push(roots, String::concat("__bench_", name)),
      _ => ()
    }
    i = i + 1
  }
  roots
}

export fn lc_late_dce_wat_roots(roots: Array[String], stmts: Array[Stmt], iw_names: Array[String], iw_wats: Array[String]) -> Unit {
  // The prelude replaces each inline-WAT body with EInt(0), so the ordinary
  // DCE walk cannot see its call edges. Add an edge only when the WAT owner is
  // reachable; iterate because a WAT callee can reach another WAT body.
  let mut changed = Array::length(iw_names) > 0
  while changed {
    changed = false
    let kept = dce_keep_flags(stmts, roots)
    let mut i = 0
    while i < Array::length(iw_names) {
      let owner = Array::get(iw_names, i)
      let mut owner_live = false
      let mut si = 0
      while si < Array::length(stmts) {
        match Array::get(stmts, si) {
          SLet(_, _, name, _, _) => if name == owner && Array::get(kept, si) {
            owner_live = true
          } else {
            ()
          },
          _ => ()
        }
        si = si + 1
      }
      if owner_live {
        let callees = wat_callee_names(Array::get(iw_wats, i))
        let mut j = 0
        while j < Array::length(callees) {
          let callee = Array::get(callees, j)
          if !array_contains_str(roots, callee) {
            Array::push(roots, callee)
            changed = true
          } else {
            ()
          }
          j = j + 1
        }
      } else {
        ()
      }
      i = i + 1
    }
  }
}

// Build the complete pool outside the module emitter so loop temporaries and
// the recursive map-key walk do not inflate that function's Wasm locals.
export fn lc_build_string_pool(stmts: Array[Stmt], srcs: Array[(String, String)], need_array_capacity: Bool, need_bytes_capacity: Bool, rc_shadow: Bool) -> (StrTable, Int, Int, Bool) {
  let str_collected = collect_strings_stmts(stmts)
  let str_strs = lc_fresh_string_array()
  Array::push(str_strs, "")
  let mut __sc = 0
  while __sc < Array::length(str_collected) {
    let __scs = Array::get(str_collected, __sc)
    if String::length(__scs) > 0 {
      Array::push(str_strs, __scs)
    } else {
      ()
    }
    __sc = __sc + 1
  }
  let rec add_map_keys_expr: (Expr) -> Unit = (e) -> {
    match e {
      EMap(fields) => {
        let mut mi = 0
        while mi < Array::length(fields) {
          let (key, val) = Array::get(fields, mi)
          if !array_contains_str(str_strs, key) {
            Array::push(str_strs, key)
          }
          add_map_keys_expr(val)
          mi = mi + 1
        }
      },
      EStringInterp(parts) => {
        let mut pi3 = 0
        while pi3 < Array::length(parts) {
          if pi3 % 2 == 0 {
            let part = Array::get(parts, pi3)
            if String::length(part) > 0 && !array_contains_str(str_strs, part) {
              Array::push(str_strs, part)
            }
          }
          pi3 = pi3 + 1
        }
      },
      ELet(_, val, body, _) => {
        add_map_keys_expr(val); add_map_keys_expr(body)
      },
      ELetMut(_, val, body, _) => {
        add_map_keys_expr(val); add_map_keys_expr(body)
      },
      ELetRec(_, val, body) => {
        add_map_keys_expr(val); add_map_keys_expr(body)
      },
      ESeq(a, b) => {
        add_map_keys_expr(a); add_map_keys_expr(b)
      },
      EIf(c, t, e) => {
        add_map_keys_expr(c); add_map_keys_expr(t); add_map_keys_expr(e)
      },
      EFn(_, _, _, _, _, body) => add_map_keys_expr(body),
      EHandle(body, _) => add_map_keys_expr(body),
      ECall(callee, args, _, _) => {
        add_map_keys_expr(callee)
        let mut ai = 0
        while ai < Array::length(args) {
          add_map_keys_expr(Array::get(args, ai))
          ai = ai + 1
        }
      },
      _ => ()
    }
  }
  let mut __mk = 0
  while __mk < Array::length(stmts) {
    match Array::get(stmts, __mk) {
      SLet(_, _, _, _, expr) => add_map_keys_expr(expr),
      STest(_, expr) => add_map_keys_expr(expr),
      SBench(_, expr) => add_map_keys_expr(expr),
      _ => ()
    }
    __mk = __mk + 1
  }
  // ("" is seeded at pool slot 0 above -- see the #2402 note at the pool's
  // construction.)
  // #2199: every bounds-checked builtin's OOB abort prints
  // `<operation>: index <idx> out of bounds for length <len>` before its
  // `unreachable` (a bare trap reads as a compiler bug). Seed the message
  // fragments so the generated builtin bodies can reference them even when
  // the source never spells them: one prefix per operation, plus the shared
  // middle and the trailing newline (__rt_oob_abort assembles the line).
  seed_builtin_diagnostic_strings(str_strs, need_array_capacity, need_bytes_capacity, rc_shadow)
  // #3126: an `Int` `/` or `%` whose divisor may be zero prints
  // `Int <op> by zero at <path>:<line>:<col>` before it traps. Seed the
  // fragments __rt_div_zero_abort assembles the line from, plus the PATH of
  // every file holding a site, which codegen passes as the call's second
  // argument (line and column ride the third as an integer). Only when the
  // program has such a site, so a module without one stays byte-identical.
  let div_sites: Array[String] = []
  let need_div_zero_abort = collect_int_div_sites(stmts, div_sites, MutSet::new_string(), false)
  if need_div_zero_abort {
    let pool_seen: MutSet[String] = MutSet::new_string()
    let mut __ps = 0
    while __ps < Array::length(str_strs) {
      let _ = MutSet::insert(pool_seen, Array::get(str_strs, __ps))
      __ps = __ps + 1
    }
    let div_frags = [
      div_zero_div_message(),
      div_zero_rem_message(),
      div_zero_at_fragment(),
      div_zero_colon_fragment(),
      "\n"
    ]
    let mut __df = 0
    while __df < Array::length(div_frags) {
      if MutSet::insert(pool_seen, Array::get(div_frags, __df)) {
        Array::push(str_strs, Array::get(div_frags, __df))
      } else {
        ()
      }
      __df = __df + 1
    }
    let mut __ds = 0
    while __ds < Array::length(div_sites) {
      if MutSet::insert(pool_seen, Array::get(div_sites, __ds)) {
        Array::push(str_strs, Array::get(div_sites, __ds))
      } else {
        ()
      }
      __ds = __ds + 1
    }
  } else {
    ()
  }
  let src_str_base = Array::length(str_strs)
  let num_src_pairs = Array::length(srcs)
  let mut __src_i = 0
  while __src_i < num_src_pairs {
    let (__src_path, __src_content) = Array::get(srcs, __src_i)
    Array::push(str_strs, __src_path)
    Array::push(str_strs, __src_content)
    __src_i = __src_i + 1
  }
  let num_strings = Array::length(str_strs)
  let data_base = 64
  let str_offsets = lc_fresh_int_array()
  let str_lengths = lc_fresh_int_array()
  let mut str_pos = data_base
  let mut si = 0
  while si < num_strings {
    let s = Array::get(str_strs, si)
    let slen = String::length(s)
    Array::push(str_offsets, str_pos)
    Array::push(str_lengths, slen)
    str_pos = str_pos + slen
    si = si + 1
  }
  let heap_start = ((str_pos + 7) / 8) * 8
  // #2386: the string table and its index, built once here after the last
  // push to str_strs and shared by every per-function CompileCtx below.
  let str_table_shared = str_table_new(str_strs, str_offsets, str_lengths)
  (str_table_shared, src_str_base, heap_start, need_div_zero_abort)
}
