import ./linked_diagnostics.vibe {
  seed_builtin_diagnostic_strings
}

test "capacity diagnostics follow allocator use and preserve existing pool entries" {
  for array_capacity in [false, true] {
    for bytes_capacity in [false, true] {
      let strings: Array[String] = ["existing", "Array::get: index "]
      seed_builtin_diagnostic_strings(strings = strings, array_capacity = array_capacity, bytes_capacity = bytes_capacity, map_get = false, rc_shadow = false)
      assert(Array::get(strings, at = 0) == "existing")
      let text = String::join(strings, sep = "|")
      assert(String::contains(text, needle = "Array::with_capacity:") == array_capacity)
      assert(String::contains(text, needle = "Bytes::with_capacity:") == bytes_capacity)
      assert(String::contains(text, needle = "String::byte_at: index "))
      assert(Array::length(strings) == 8 + (if array_capacity {
        1
      } else {
        0
      }) + (if bytes_capacity {
        1
      } else {
        0
      }))
    }
  }
}

test "shadow and bounds diagnostics are not duplicated by repeated setup" {
  let strings: Array[String] = []
  seed_builtin_diagnostic_strings(strings = strings, array_capacity = false, bytes_capacity = false, map_get = false, rc_shadow = true)
  seed_builtin_diagnostic_strings(strings = strings, array_capacity = false, bytes_capacity = false, map_get = false, rc_shadow = true)
  assert(Array::length(strings) == 12)
  let text = String::join(strings, sep = "|")
  assert(String::contains(text, needle = "dup of freed value at site "))
  assert(String::contains(text, needle = "drop of freed value at site "))
  assert(String::contains(text, needle = "String::concat operand is not a live string: ptr="))
}

/// #3547: the `Map::get` miss message is pooled only for a program that reads
/// a map, so a module without one pays no bytes for it.
test "the map miss message follows map use" {
  for map_get in [false, true] {
    let strings: Array[String] = []
    seed_builtin_diagnostic_strings(strings = strings, array_capacity = false, bytes_capacity = false, map_get = map_get, rc_shadow = false)
    assert(String::contains(String::join(strings, sep = "|"), needle = "Map::get: key not found") == map_get)
  }
}
