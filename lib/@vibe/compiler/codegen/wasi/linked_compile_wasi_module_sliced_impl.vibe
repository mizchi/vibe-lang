export fn lc_prepare_wasi_module_rc_cached_with_split_grants(stmts_in: Array[Stmt], entry_name: String, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, prov: DbgProv, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String], split: ModuleSplit, render: (Stmt) -> String, grants: Array[(String, String)]) -> LinkedModulePreparation with Exception {
  let stmts = elaborate_heap_params(stmts_in)
  lc_prepare_module_with_split_grants(stmts = stmts, entry_name_in = entry_name, srcs = array_empty(), linked_imports = array_empty(), library_mode = false, enable_rc = true, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = prov, body_cache_in = body_cache_in, body_cache_out = body_cache_out, slice_lo = 0, slice_hi = 0 - 1, checker_float_call_offsets = checker_float_call_offsets, checker_int_render_offsets = checker_int_render_offsets, checker_bool_render_offsets = checker_bool_render_offsets, checker_eq_offsets = checker_eq_offsets, checker_eq_type_keys = checker_eq_type_keys, split = split, render = render, grants = grants)
}

