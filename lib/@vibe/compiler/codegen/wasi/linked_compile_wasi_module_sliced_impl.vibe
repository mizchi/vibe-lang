/// `vibe_cov` custom section. Same as compile_wasi_module_with_sources_impl but
/// with coverage enabled.
export fn compile_wasi_module_with_sources_coverage_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with Exception {
  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, true, true, false, false, false, true, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_discard(), 0, 0 - 1)
}

/// Trace build (debugger / DAP P1 groundwork): compile with function-call
/// execution-trace instrumentation + `vibe.trace` custom section. Same as
/// compile_wasi_module_with_sources_impl but with debug_trace enabled.
export fn compile_wasi_module_with_sources_trace_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with Exception {
