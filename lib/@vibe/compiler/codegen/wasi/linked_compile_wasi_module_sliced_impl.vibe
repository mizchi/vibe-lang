/// #2826 item 3: the shadow-instrumented RC lane (VIBE_RC=shadow) with the
/// module split wired in, so a split/whole parity test can run both lanes'
/// output under the use-after-free / double-free traps. The whole lane's
/// shadow entry above takes `module_split_none()`; this is the same compile
/// with the caller's split and the same `elaborate_heap_params` alignment as
/// `compile_wasi_module_rc_cached_impl_with_split`.
export fn compile_wasi_module_rc_shadow_impl_with_split(stmts_in: Array[Stmt], entry_name: String, prov: DbgProv, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String], split: ModuleSplit, render: (Stmt) -> String) -> Bytes with Exception {
  let stmts = elaborate_heap_params(stmts_in)
  compile_wasi_module_linked_impl_with_split_grants(stmts = stmts, entry_name_in = entry_name, srcs = array_empty(), linked_imports = array_empty(), library_mode = false, enable_rc = true, coverage = false, debug_trace = false, debug_break = false, rc_shadow = true, enable_late_dce = true, prov = prov, body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_discard(), slice_lo = 0, slice_hi = 0 - 1, checker_float_call_offsets = checker_float_call_offsets, checker_int_render_offsets = checker_int_render_offsets, checker_bool_render_offsets = checker_bool_render_offsets, checker_eq_offsets = checker_eq_offsets, checker_eq_type_keys = checker_eq_type_keys, split = split, render = render, grants = array_empty())
}

/// #1259 step 7: compile the module twice -- once compiling every body and
/// harvesting it, once replaying every harvested body -- and return the
/// REPLAYED module, throwing if the two disagree.
///
/// This is the only caller that exercises the replay path, and it exists to
/// keep the two halves honest: a replayed function must be indistinguishable
/// from a compiled one, not merely plausible. It caught the first real
/// divergence -- `table_slots_used` is appended during compilation and read
/// only after the body loop, so a replayed build emitted a smaller element
/// section until the cache started carrying those entries too.
///
/// Deliberately not on any production path: it is strictly slower than
/// compiling once. Callers are the round-trip test and the gate.
/// #1259 step 8: compile the bodies in two disjoint slices, merge the two
/// harvests, replay the merged cache, and return the result -- throwing if it
/// differs from a straight single-pass compile.
///
/// This is the property a `--jobs N` build rests on, reduced to something a
/// single process can check: a body compiled while its neighbours were NOT
/// compiled must be the same bytes as one compiled with all of them. It holds
/// only because everything that used to make a body depend on its neighbours
/// was hoisted ahead of the loop -- the lambda index plan (#1275/#1277), the
/// shared fresh-name counters, and the string table -- so a slice sees exactly
/// the state the whole run would have given it.
///
/// Splitting at the halfway point is arbitrary but not vacuous: it puts the
/// boundary inside the function list, so the second worker starts at a nonzero
/// planned lambda base.
///
/// Test/gate only; it compiles the program three times.
export fn compile_wasi_module_sliced_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception {
  let whole = compile_wasi_module_linked_impl(stmts = stmts, entry_name = entry_name, srcs = array_empty(), linked_imports = array_empty(), library_mode = false, enable_rc = false, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_discard(), slice_lo = 0, slice_hi = 0 - 1)
  let probe = codegen_body_cache_new()
  let _probe_bytes = compile_wasi_module_linked_impl(stmts = stmts, entry_name = entry_name, srcs = array_empty(), linked_imports = array_empty(), library_mode = false, enable_rc = false, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = codegen_body_cache_new(), body_cache_out = probe, slice_lo = 0, slice_hi = 0 - 1)
  let nfns = Array::length(probe.fn_indices)
  let mid = nfns / 2
  let low = codegen_body_cache_new()
  let high = codegen_body_cache_new()
  let _low_bytes = compile_wasi_module_linked_impl(stmts = stmts, entry_name = entry_name, srcs = array_empty(), linked_imports = array_empty(), library_mode = false, enable_rc = false, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = codegen_body_cache_new(), body_cache_out = low, slice_lo = 0, slice_hi = mid)
  let _high_bytes = compile_wasi_module_linked_impl(stmts = stmts, entry_name = entry_name, srcs = array_empty(), linked_imports = array_empty(), library_mode = false, enable_rc = false, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = codegen_body_cache_new(), body_cache_out = high, slice_lo = mid, slice_hi = 0 - 1)
  let merged = codegen_body_cache_merge(a = low, b = high)
  let nmerged = Array::length(merged.fn_indices)
  if nmerged != nfns {
    throw(String::concat("codegen slice merge lost functions: whole ", String::concat(__to_string(nfns), String::concat(", merged ", __to_string(nmerged)))))
  } else {
    ()
  }
  let sliced = compile_wasi_module_linked_impl(stmts = stmts, entry_name = entry_name, srcs = array_empty(), linked_imports = array_empty(), library_mode = false, enable_rc = false, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = merged, body_cache_out = codegen_body_cache_new(), slice_lo = 0, slice_hi = 0 - 1)
  let wn = Bytes::length(whole)
  let sn = Bytes::length(sliced)
  if wn != sn {
    throw(String::concat("codegen slice length mismatch: whole ", String::concat(__to_string(wn), String::concat(" B, sliced ", String::concat(__to_string(sn), " B")))))
  } else {
    ()
  }
  let mut i = 0
  let mut bad = 0 - 1
  while bad < 0 && i < wn {
    if Bytes::get(whole, at = i) != Bytes::get(sliced, at = i) {
      bad = i
    } else {
      i = i + 1
    }
  }
  if bad >= 0 {
    throw(String::concat("codegen slice byte mismatch at offset ", __to_string(bad)))
  } else {
    ()
  }
  sliced
}

export fn compile_wasi_module_replayed_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception {
  let harvest = codegen_body_cache_new()
  let compiled = compile_wasi_module_linked_impl(stmts = stmts, entry_name = entry_name, srcs = array_empty(), linked_imports = array_empty(), library_mode = false, enable_rc = false, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = codegen_body_cache_new(), body_cache_out = harvest, slice_lo = 0, slice_hi = 0 - 1)
  let replayed = compile_wasi_module_linked_impl(stmts = stmts, entry_name = entry_name, srcs = array_empty(), linked_imports = array_empty(), library_mode = false, enable_rc = false, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = harvest, body_cache_out = codegen_body_cache_new(), slice_lo = 0, slice_hi = 0 - 1)
  let ln = Bytes::length(compiled)
  let rn = Bytes::length(replayed)
  if ln != rn {
    throw(String::concat("codegen replay length mismatch: compiled ", String::concat(__to_string(ln), String::concat(" B, replayed ", String::concat(__to_string(rn), " B")))))
  } else {
    ()
  }
  let mut i = 0
  let mut bad = 0 - 1
  while bad < 0 && i < ln {
    if Bytes::get(compiled, at = i) != Bytes::get(replayed, at = i) {
      bad = i
    } else {
      i = i + 1
    }
  }
  if bad >= 0 {
    throw(String::concat("codegen replay byte mismatch at offset ", __to_string(bad)))
  } else {
    ()
  }
  replayed
}

export fn compile_wasi_module_with_sources_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with Exception {
  compile_wasi_module_linked_with_cache_policy(stmts = stmts, entry_name_in = entry_name, srcs = srcs, linked_imports = array_empty(), library_mode = false, enable_rc = false, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_discard(), slice_lo = 0, slice_hi = 0 - 1, checker_float_call_offsets = array_empty(), checker_int_render_offsets = array_empty(), checker_bool_render_offsets = array_empty(), checker_eq_offsets = array_empty(), checker_eq_type_keys = array_empty(), split = module_split_none(), render = lc_render_unused, grants = array_empty(), body_cache_enabled = false)
}

/// #2158: `compile_wasi_module_with_sources_impl` plus the checker's Double
/// call-result offsets. This is the single-source lane
/// (`compile_source_wasi_only`, entry/source_compile/wasi_only/preprocess_compile.vibe),
/// where one text means one offset space with nothing to collide.
/// Pre-#2828-rung-2 arity: no launcher grants (fail-closed).
export fn compile_wasi_module_with_sources_impl_with_typed_offsets(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String]) -> Bytes with Exception {
  compile_wasi_module_with_sources_impl_with_typed_offsets_grants(stmts = stmts, entry_name = entry_name, srcs = srcs, checker_float_call_offsets = checker_float_call_offsets, checker_int_render_offsets = checker_int_render_offsets, checker_bool_render_offsets = checker_bool_render_offsets, checker_eq_offsets = checker_eq_offsets, checker_eq_type_keys = checker_eq_type_keys, grants = array_empty())
}

/// #2828 rung 2: the grant-carrying arity (mvp lane).
export fn compile_wasi_module_with_sources_impl_with_typed_offsets_grants(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String], grants: Array[(String, String)]) -> Bytes with Exception {
  compile_wasi_module_linked_with_cache_policy(stmts = stmts, entry_name_in = entry_name, srcs = srcs, linked_imports = array_empty(), library_mode = false, enable_rc = false, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_discard(), slice_lo = 0, slice_hi = 0 - 1, checker_float_call_offsets = checker_float_call_offsets, checker_int_render_offsets = checker_int_render_offsets, checker_bool_render_offsets = checker_bool_render_offsets, checker_eq_offsets = checker_eq_offsets, checker_eq_type_keys = checker_eq_type_keys, split = module_split_none(), render = lc_render_unused, grants = grants, body_cache_enabled = false)
}

/// Coverage build (#cov): compile with function-level hit instrumentation +
/// `vibe_cov` custom section. Same as compile_wasi_module_with_sources_impl but
/// with coverage enabled.
export fn compile_wasi_module_with_sources_coverage_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with Exception {
  compile_wasi_module_linked_impl(stmts = stmts, entry_name = entry_name, srcs = srcs, linked_imports = array_empty(), library_mode = false, enable_rc = true, coverage = true, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_discard(), slice_lo = 0, slice_hi = 0 - 1)
}

/// Trace build (debugger / DAP P1 groundwork): compile with function-call
/// execution-trace instrumentation + `vibe.trace` custom section. Same as
/// compile_wasi_module_with_sources_impl but with debug_trace enabled.
export fn compile_wasi_module_with_sources_trace_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with Exception {
  compile_wasi_module_linked_impl(stmts = stmts, entry_name = entry_name, srcs = srcs, linked_imports = array_empty(), library_mode = false, enable_rc = true, coverage = false, debug_trace = true, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_discard(), slice_lo = 0, slice_hi = 0 - 1)
}

/// Break build (debugger / DAP P1): compile with `vibe::dbg_break` host-hook
/// instrumentation at each user function entry. Same as
/// compile_wasi_module_with_sources_impl but with debug_break enabled.
export fn compile_wasi_module_with_sources_break_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], prov: DbgProv) -> Bytes with Exception {
  compile_wasi_module_linked_impl(stmts = stmts, entry_name = entry_name, srcs = srcs, linked_imports = array_empty(), library_mode = false, enable_rc = true, coverage = false, debug_trace = false, debug_break = true, rc_shadow = false, enable_late_dce = true, prov = prov, body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_discard(), slice_lo = 0, slice_hi = 0 - 1)
}

/// #2391 (#2425 review round 4): the instrumented builds compile the same
/// program the production lanes do, so they take the same checker Double
/// call-result offsets -- otherwise a coverage/trace/shadow/break build of a
/// program whose Doubles need the channel silently renders raw f64 bits
/// where the ordinary build renders numbers.
export fn compile_wasi_module_with_sources_coverage_impl_with_typed_offsets(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String]) -> Bytes with Exception {
  compile_wasi_module_linked_impl_with_typed_offsets(stmts = stmts, entry_name = entry_name, srcs = srcs, linked_imports = array_empty(), library_mode = false, enable_rc = true, coverage = true, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_discard(), slice_lo = 0, slice_hi = 0 - 1, checker_float_call_offsets = checker_float_call_offsets, checker_int_render_offsets = checker_int_render_offsets, checker_bool_render_offsets = checker_bool_render_offsets, checker_eq_offsets = checker_eq_offsets, checker_eq_type_keys = checker_eq_type_keys)
}

export fn compile_wasi_module_with_sources_trace_impl_with_typed_offsets(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String]) -> Bytes with Exception {
