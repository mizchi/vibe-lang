  compile_wasi_module_linked_impl_with_typed_offsets_grants,
  lc_render_unused
}

/// #2158: the historical signature. Every caller that has no checker offsets to
/// give -- which is every caller but the two `*_with_typed_offsets` entries
/// below -- goes through here and gets an empty table, so its output is
/// unchanged.
export fn compile_wasi_module_linked_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool, enable_rc: Bool, coverage: Bool, debug_trace: Bool, debug_break: Bool, rc_shadow: Bool, enable_late_dce: Bool, prov: DbgProv, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, slice_lo: Int, slice_hi: Int) -> Bytes with Exception {
  compile_wasi_module_linked_impl_with_typed_offsets(stmts, entry_name, srcs, linked_imports, library_mode, enable_rc, coverage, debug_trace, debug_break, rc_shadow, enable_late_dce, prov, body_cache_in, body_cache_out, slice_lo, slice_hi, array_empty(), array_empty(), array_empty(), array_empty(), array_empty())
}

export fn compile_wasi_module_rc_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with Exception {
  let stmts = elaborate_heap_params(stmts_in)
  compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, true, false, false, false, false, true, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_discard(), 0, 0 - 1)
}

/// #2158: `compile_wasi_module_rc_impl` plus the checker's Double call-result
/// offsets. This is the lane `vibe test` and `vibe run` take by default -- the
/// adapter routes anything but an explicit `VIBE_RC=0` here, so a fix wired
/// only into the bump sibling would never be reached by either command.
///
/// `elaborate_heap_params` rewrites the statements before codegen sees them;
/// the offsets are filtered for uniqueness inside the linked impl, AFTER that
/// rewrite, so its output is what the guarantee is proven against.
export fn compile_wasi_module_rc_impl_with_typed_offsets(stmts_in: Array[Stmt], entry_name: String, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String]) -> Bytes with Exception {
  let stmts = elaborate_heap_params(stmts_in)
  compile_wasi_module_linked_impl_with_typed_offsets(stmts, entry_name, array_empty(), array_empty(), false, true, false, false, false, false, true, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_discard(), 0, 0 - 1, checker_float_call_offsets, checker_int_render_offsets, checker_bool_render_offsets, checker_eq_offsets, checker_eq_type_keys)
}

/// #2388 step 3: compile_wasi_module_rc_impl with the body caches threaded
/// through -- `body_cache_in` entries replay instead of compiling (the body
/// loop already consults it, #1259), and `body_cache_out` harvests this
/// compile's bodies for the caller to persist. Everything else matches the
/// plain RC lane flag for flag.
export fn compile_wasi_module_rc_cached_impl(stmts_in: Array[Stmt], entry_name: String, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache) -> Bytes with Exception {
  let stmts = elaborate_heap_params(stmts_in)
  compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, true, false, false, false, false, true, empty_dbg_prov(), body_cache_in, body_cache_out, 0, 0 - 1)
}

/// #2391: `compile_wasi_module_rc_cached_impl` plus the checker's Double
/// call-result offsets (#2158), so the body-cached FS lane compiles the same
/// program the ordinary rc lane does and their outputs stay byte-comparable.
export fn compile_wasi_module_rc_cached_impl_with_typed_offsets(stmts_in: Array[Stmt], entry_name: String, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String]) -> Bytes with Exception {
  compile_wasi_module_rc_cached_impl_with_prov(stmts_in, entry_name, body_cache_in, body_cache_out, empty_dbg_prov(), checker_float_call_offsets, checker_int_render_offsets, checker_bool_render_offsets, checker_eq_offsets, checker_eq_type_keys)
}

/// #2575 item 2: the same RC production compile, given the merged program's
/// statement-to-module map.
///
/// `prov` carries `files` (one basename per module) and `stmt_file_id` (one
/// module id per merged PRE-PRELUDE top-level statement). Empty `file_nls`
/// keeps production `vibe.linemap` off (`linked_compile_prov_inert_test.vibe`
/// pins that compile byte-identical). Non-empty newline tables are #2199's
/// production trap provenance: the section is emitted without debug-break
/// probes. A per-module prelude still does not read `file_nls`.
/// Pre-#2828-rung-2 arity: no launcher grants (fail-closed).
export fn compile_wasi_module_rc_cached_impl_with_prov(stmts_in: Array[Stmt], entry_name: String, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, prov: DbgProv, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String]) -> Bytes with Exception {
  compile_wasi_module_rc_cached_impl_with_prov_grants(stmts_in, entry_name, body_cache_in, body_cache_out, prov, checker_float_call_offsets, checker_int_render_offsets, checker_bool_render_offsets, checker_eq_offsets, checker_eq_type_keys, array_empty())
}

/// #2828 rung 2: the grant-carrying arity, on the lane `vibe run` takes.
export fn compile_wasi_module_rc_cached_impl_with_prov_grants(stmts_in: Array[Stmt], entry_name: String, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, prov: DbgProv, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String], grants: Array[(String, String)]) -> Bytes with Exception {
  compile_wasi_module_rc_cached_impl_with_split_grants(stmts_in, entry_name, body_cache_in, body_cache_out, prov, checker_float_call_offsets, checker_int_render_offsets, checker_bool_render_offsets, checker_eq_offsets, checker_eq_type_keys, module_split_none(), lc_render_unused, grants)
}

/// #2575 item 2 step 3b: the RC production compile with the module split wired
/// in.
///
/// `elaborate_heap_params` runs HERE, once on the merged program, and the
/// prelude's per-module loop starts at pass 1 for exactly that reason (#2647
/// Codex round 4). It pushes one statement per input statement, so
/// `split.stmt_file_id` -- built from the MERGE's counts, before this call --
/// still indexes the array the prelude receives.
/// `linked_compile_prov_inert_test.vibe` pins that alignment, because an edit
/// there would silently misattribute every statement rather than fail.
/// Pre-#2828-rung-2 arity: no launcher grants (fail-closed).
export fn compile_wasi_module_rc_cached_impl_with_split(stmts_in: Array[Stmt], entry_name: String, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, prov: DbgProv, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String], split: ModuleSplit, render: (Stmt) -> String) -> Bytes with Exception {
  compile_wasi_module_rc_cached_impl_with_split_grants(stmts_in, entry_name, body_cache_in, body_cache_out, prov, checker_float_call_offsets, checker_int_render_offsets, checker_bool_render_offsets, checker_eq_offsets, checker_eq_type_keys, split, render, array_empty())
}

/// #2828 rung 2: the grant-carrying arity.
export fn compile_wasi_module_rc_cached_impl_with_split_grants(stmts_in: Array[Stmt], entry_name: String, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, prov: DbgProv, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String], split: ModuleSplit, render: (Stmt) -> String, grants: Array[(String, String)]) -> Bytes with Exception {
  let stmts = elaborate_heap_params(stmts_in)
  compile_wasi_module_linked_impl_with_split_grants(stmts, entry_name, array_empty(), array_empty(), false, true, false, false, false, false, true, prov, body_cache_in, body_cache_out, 0, 0 - 1, checker_float_call_offsets, checker_int_render_offsets, checker_bool_render_offsets, checker_eq_offsets, checker_eq_type_keys, split, render, grants)
}

/// Preserve the post-lowering AST for the explicit `no-dce` compile mode.
