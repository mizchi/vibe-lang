  compile_wasi_module_linked_impl_with_typed_offsets(stmts = stmts, entry_name = entry_name, srcs = srcs, linked_imports = array_empty(), library_mode = false, enable_rc = true, coverage = false, debug_trace = false, debug_break = true, rc_shadow = false, enable_late_dce = true, prov = prov, body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_discard(), slice_lo = 0, slice_hi = 0 - 1, checker_float_call_offsets = checker_float_call_offsets, checker_int_render_offsets = checker_int_render_offsets, checker_bool_render_offsets = checker_bool_render_offsets, checker_eq_offsets = checker_eq_offsets, checker_eq_type_keys = checker_eq_type_keys)
