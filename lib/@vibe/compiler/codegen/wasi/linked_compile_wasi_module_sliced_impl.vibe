/// #2158: the historical signature. Every caller that has no checker offsets to
/// give -- which is every caller but the two `*_with_typed_offsets` entries
/// below -- goes through here and gets an empty table, so its output is
/// unchanged.
export fn compile_wasi_module_linked_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool, enable_rc: Bool, coverage: Bool, debug_trace: Bool, debug_break: Bool, rc_shadow: Bool, enable_late_dce: Bool, prov: DbgProv, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, slice_lo: Int, slice_hi: Int) -> Bytes with Exception {
  compile_wasi_module_linked_impl_with_typed_offsets(stmts = stmts, entry_name = entry_name, srcs = srcs, linked_imports = linked_imports, library_mode = library_mode, enable_rc = enable_rc, coverage = coverage, debug_trace = debug_trace, debug_break = debug_break, rc_shadow = rc_shadow, enable_late_dce = enable_late_dce, prov = prov, body_cache_in = body_cache_in, body_cache_out = body_cache_out, slice_lo = slice_lo, slice_hi = slice_hi, checker_float_call_offsets = array_empty(), checker_int_render_offsets = array_empty(), checker_bool_render_offsets = array_empty(), checker_eq_offsets = array_empty(), checker_eq_type_keys = array_empty())
}

export fn compile_wasi_module_rc_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with Exception {
  let stmts = elaborate_heap_params(stmts_in)
  compile_wasi_module_linked_with_cache_policy(stmts = stmts, entry_name_in = entry_name, srcs = array_empty(), linked_imports = array_empty(), library_mode = false, enable_rc = true, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_discard(), slice_lo = 0, slice_hi = 0 - 1, checker_float_call_offsets = array_empty(), checker_int_render_offsets = array_empty(), checker_bool_render_offsets = array_empty(), checker_eq_offsets = array_empty(), checker_eq_type_keys = array_empty(), split = module_split_none(), render = lc_render_unused, grants = array_empty(), body_cache_enabled = false)
}

/// #2158: `compile_wasi_module_rc_impl` plus the checker's Double call-result
/// offsets. This is the lane `vibe test` and `vibe run` take by default -- the
/// adapter routes anything but an explicit `VIBE_RC=0` here, so a fix wired
/// only into the bump sibling would never be reached by either command.
///
/// `elaborate_heap_params` rewrites the statements before codegen sees them;
/// the offsets are filtered for uniqueness inside the linked impl, AFTER that
/// rewrite, so its output is what the guarantee is proven against.
export fn compile_wasi_module_rc_impl_with_typed_offsets(stmts_in: Array[Stmt], entry_name: String, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String]) -> Bytes with Exception {
  let stmts = elaborate_heap_params(stmts_in)
  compile_wasi_module_linked_with_cache_policy(stmts = stmts, entry_name_in = entry_name, srcs = array_empty(), linked_imports = array_empty(), library_mode = false, enable_rc = true, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_discard(), slice_lo = 0, slice_hi = 0 - 1, checker_float_call_offsets = checker_float_call_offsets, checker_int_render_offsets = checker_int_render_offsets, checker_bool_render_offsets = checker_bool_render_offsets, checker_eq_offsets = checker_eq_offsets, checker_eq_type_keys = checker_eq_type_keys, split = module_split_none(), render = lc_render_unused, grants = array_empty(), body_cache_enabled = false)
}

/// #2388 step 3: compile_wasi_module_rc_impl with the body caches threaded
/// through -- `body_cache_in` entries replay instead of compiling (the body
/// loop already consults it, #1259), and `body_cache_out` harvests this
/// compile's bodies for the caller to persist. Everything else matches the
/// plain RC lane flag for flag.
export fn compile_wasi_module_rc_cached_impl(stmts_in: Array[Stmt], entry_name: String, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache) -> Bytes with Exception {
  let stmts = elaborate_heap_params(stmts_in)
  compile_wasi_module_linked_impl(stmts = stmts, entry_name = entry_name, srcs = array_empty(), linked_imports = array_empty(), library_mode = false, enable_rc = true, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = empty_dbg_prov(), body_cache_in = body_cache_in, body_cache_out = body_cache_out, slice_lo = 0, slice_hi = 0 - 1)
}

/// #2391: `compile_wasi_module_rc_cached_impl` plus the checker's Double
/// call-result offsets (#2158), so the body-cached FS lane compiles the same
/// program the ordinary rc lane does and their outputs stay byte-comparable.
export fn compile_wasi_module_rc_cached_impl_with_typed_offsets(stmts_in: Array[Stmt], entry_name: String, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String]) -> Bytes with Exception {
  compile_wasi_module_rc_cached_impl_with_prov(stmts_in = stmts_in, entry_name = entry_name, body_cache_in = body_cache_in, body_cache_out = body_cache_out, prov = empty_dbg_prov(), checker_float_call_offsets = checker_float_call_offsets, checker_int_render_offsets = checker_int_render_offsets, checker_bool_render_offsets = checker_bool_render_offsets, checker_eq_offsets = checker_eq_offsets, checker_eq_type_keys = checker_eq_type_keys)
}

/// #2575 item 2: the same RC production compile, given the merged program's
/// statement-to-module map.
///
/// `prov` carries `files` (one basename per module) and `stmt_file_id` (one
/// module id per merged PRE-PRELUDE top-level statement). Empty `file_nls`
/// keeps production `vibe.linemap` off (`linked_compile_prov_inert_test.vibe`
/// pins that compile byte-identical). Non-empty newline tables are #2199's
/// production trap provenance: the section is emitted without debug-break
/// probes. A per-module prelude still does not read `file_nls`.
/// Pre-#2828-rung-2 arity: no launcher grants (fail-closed).
export fn compile_wasi_module_rc_cached_impl_with_prov(stmts_in: Array[Stmt], entry_name: String, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, prov: DbgProv, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String]) -> Bytes with Exception {
  compile_wasi_module_rc_cached_impl_with_prov_grants(stmts_in = stmts_in, entry_name = entry_name, body_cache_in = body_cache_in, body_cache_out = body_cache_out, prov = prov, checker_float_call_offsets = checker_float_call_offsets, checker_int_render_offsets = checker_int_render_offsets, checker_bool_render_offsets = checker_bool_render_offsets, checker_eq_offsets = checker_eq_offsets, checker_eq_type_keys = checker_eq_type_keys, grants = array_empty())
}

/// #2828 rung 2: the grant-carrying arity, on the lane `vibe run` takes.
/// Production RC with provenance and grants, with replay and harvest disabled.
export fn compile_wasi_module_rc_impl_with_prov_grants(stmts_in: Array[Stmt], entry_name: String, prov: DbgProv, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String], grants: Array[(String, String)]) -> Bytes with Exception {
  let stmts = elaborate_heap_params(stmts_in)
  compile_wasi_module_linked_with_cache_policy(stmts = stmts, entry_name_in = entry_name, srcs = array_empty(), linked_imports = array_empty(), library_mode = false, enable_rc = true, coverage = false, debug_trace = false, debug_break = false, rc_shadow = false, enable_late_dce = true, prov = prov, body_cache_in = codegen_body_cache_new(), body_cache_out = codegen_body_cache_discard(), slice_lo = 0, slice_hi = 0 - 1, checker_float_call_offsets = checker_float_call_offsets, checker_int_render_offsets = checker_int_render_offsets, checker_bool_render_offsets = checker_bool_render_offsets, checker_eq_offsets = checker_eq_offsets, checker_eq_type_keys = checker_eq_type_keys, split = module_split_none(), render = lc_render_unused, grants = grants, body_cache_enabled = false)
}

export fn compile_wasi_module_rc_cached_impl_with_prov_grants(stmts_in: Array[Stmt], entry_name: String, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, prov: DbgProv, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String], grants: Array[(String, String)]) -> Bytes with Exception {
  compile_wasi_module_rc_cached_impl_with_split_grants(stmts_in = stmts_in, entry_name = entry_name, body_cache_in = body_cache_in, body_cache_out = body_cache_out, prov = prov, checker_float_call_offsets = checker_float_call_offsets, checker_int_render_offsets = checker_int_render_offsets, checker_bool_render_offsets = checker_bool_render_offsets, checker_eq_offsets = checker_eq_offsets, checker_eq_type_keys = checker_eq_type_keys, split = module_split_none(), render = lc_render_unused, grants = grants)
}

/// #2575 item 2 step 3b: the RC production compile with the module split wired
/// in.
///
/// `elaborate_heap_params` runs HERE, once on the merged program, and the
/// prelude's per-module loop starts at pass 1 for exactly that reason (#2647
/// Codex round 4). It pushes one statement per input statement, so
/// `split.stmt_file_id` -- built from the MERGE's counts, before this call --
/// still indexes the array the prelude receives.
/// `linked_compile_prov_inert_test.vibe` pins that alignment, because an edit
/// there would silently misattribute every statement rather than fail.
/// Pre-#2828-rung-2 arity: no launcher grants (fail-closed).
export fn compile_wasi_module_rc_cached_impl_with_split(stmts_in: Array[Stmt], entry_name: String, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, prov: DbgProv, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String], split: ModuleSplit, render: (Stmt) -> String) -> Bytes with Exception {
  compile_wasi_module_rc_cached_impl_with_split_grants(stmts_in = stmts_in, entry_name = entry_name, body_cache_in = body_cache_in, body_cache_out = body_cache_out, prov = prov, checker_float_call_offsets = checker_float_call_offsets, checker_int_render_offsets = checker_int_render_offsets, checker_bool_render_offsets = checker_bool_render_offsets, checker_eq_offsets = checker_eq_offsets, checker_eq_type_keys = checker_eq_type_keys, split = split, render = render, grants = array_empty())
}

/// #2828 rung 2: the grant-carrying arity.
export fn compile_wasi_module_rc_cached_impl_with_split_grants(stmts_in: Array[Stmt], entry_name: String, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, prov: DbgProv, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String], split: ModuleSplit, render: (Stmt) -> String, grants: Array[(String, String)]) -> Bytes with Exception {
  lc_finish_linked_module_with_flags(prepared = lc_prepare_wasi_module_rc_cached_with_split_grants(stmts_in = stmts_in, entry_name = entry_name, body_cache_in = body_cache_in, body_cache_out = body_cache_out, prov = prov, checker_float_call_offsets = checker_float_call_offsets, checker_int_render_offsets = checker_int_render_offsets, checker_bool_render_offsets = checker_bool_render_offsets, checker_eq_offsets = checker_eq_offsets, checker_eq_type_keys = checker_eq_type_keys, split = split, render = render, grants = grants), coverage = false, debug_break = false, debug_trace = false, enable_rc = true, rc_shadow = false)
}

