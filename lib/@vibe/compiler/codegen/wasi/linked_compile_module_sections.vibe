    emit_name(import_content, "vibe")
    emit_name(import_content, "stdin_provider_close")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  let mut hs_emit_i = 0
  while hs_emit_i < Array::length(hs_named_names) {
    emit_name(import_content, "vibe")
    emit_name(import_content, String::concat("host_stream_get$", Array::get(hs_named_names, hs_emit_i)))
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 5)
    hs_emit_i = hs_emit_i + 1
