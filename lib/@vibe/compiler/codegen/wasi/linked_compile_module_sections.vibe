    ()
  }
  // #768: `vibe.fs_rename (i64, i64) -> ()` (type 6, like fs_write_file).
  if fs_rename_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_rename")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 6)
  } else {
    ()
  }
  // #768: `vibe.fs_is_dir (i64) -> i64` (type 3, like fs_exists/fs_read_file).
  if fs_is_dir_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_is_dir")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #768: `vibe.fs_is_file (i64) -> i64` (type 3, like fs_exists).
  if fs_is_file_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_is_file")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #768: `vibe.fs_getcwd () -> i64` (type 5, like profile-now-us).
  if fs_getcwd_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_getcwd")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 5)
  } else {
    ()
  }
  // `vibe.tcp_connect (i64,i64) -> i64` (type 4, like http_response_header).
  if tcp_connect_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "tcp_connect")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 4)
  } else {
    ()
  }
  // `vibe.tcp_read (i64,i64) -> i64` (type 4, like http_response_header).
  if tcp_read_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "tcp_read")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 4)
  } else {
    ()
  }
  // `vibe.tcp_write (i64,i64) -> ()` (type 6, like fs_write_file).
  if tcp_write_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "tcp_write")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 6)
  } else {
    ()
  }
  // `vibe.tcp_close (i64) -> ()` (type 1, like fs_remove).
  if tcp_close_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "tcp_close")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  // #794: `vibe.http_request (i64,i64,i64,i64) -> i64` — the dedicated type
  // appended after base/closure/dbg types (http_request_type_idx).
  if http_request_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "http_request")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, http_request_type_idx)
  } else {
    ()
  }
  // #794: `vibe.http_response_status (i64) -> i64` (type 3, like fs_exists).
  if http_response_status_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "http_response_status")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #794: `vibe.http_response_header (i64, i64) -> i64` (type 4).
  if http_response_header_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "http_response_header")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 4)
  } else {
    ()
  }
  // #794: `vibe.http_response_body (i64) -> i64` (type 3, like fs_read_file).
  if http_response_body_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "http_response_body")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #794: `vibe.http_close (i64) -> ()` (type 1, like fs_remove).
  if http_close_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "http_close")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  // #865: `vibe.sh_capture (i64) -> i64` (type 3, like fs_read_file) -- runs
  // the command once and returns a handle.
  if sh_capture_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "sh_capture")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #865: `vibe.sh_capture_exit_code (i64) -> i64` (type 3, like fs_exists).
  if sh_capture_exit_code_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "sh_capture_exit_code")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #865: `vibe.sh_capture_stdout (i64) -> i64` (type 3, like fs_read_file).
  if sh_capture_stdout_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "sh_capture_stdout")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #865: `vibe.sh_capture_stderr (i64) -> i64` (type 3, like fs_read_file).
  if sh_capture_stderr_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "sh_capture_stderr")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #865: `vibe.sh_capture_close (i64) -> ()` (type 1, like fs_remove).
  if sh_capture_close_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "sh_capture_close")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  // #903/#865: `vibe.process_exit (i64) -> ()` (type 1, like fs_remove).
  if process_exit_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "process_exit")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  // #865: `vibe.stderr_write_stream (i64) -> ()` / `vibe.stderr_write_char
  // (i64) -> ()` (type 1, like Stdout's pair).
  if stderr_write_stream_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "stderr_write_stream")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  if stderr_write_char_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "stderr_write_char")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  if dbg_break_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "dbg_break")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 2)
  }
  // Interior-line breakpoints (span-arc step5): emit the `vibe::dbg_line` import
  // descriptor here, AFTER dbg_break and BEFORE the linked imports, matching its
  // reserved import index order. Type index is the appended `(i32) -> ()` type.
  if dbg_line_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "dbg_line")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, dbg_line_type_idx)
  } else {
    ()
  }
  let mut li_emit = 0
  while li_emit < Array::length(linked_imports) {
    let (lmod, lfn, lparams, _) = Array::get(linked_imports, li_emit)
    emit_name(import_content, lmod)
    emit_name(import_content, lfn)
    bytebuf_push(import_content, 0)
    let type_idx = num_base_types + lparams
    leb128_encode_u32(import_content, type_idx)
    li_emit = li_emit + 1
  }
  bytebuf_push_section(out, 2, import_content)
  let func_type_indices = lc_fresh_int_array()
  // #415 B-1: the builtin type indices are declared next to each body push
  // (push_builtin above), in the exact bodies order — splice them here where
  // a hand-maintained bare number list used to mirror that order from ~1,400
  // lines away.
  let mut bti = 0
  while bti < Array::length(builtin_type_idxs) {
    Array::push(func_type_indices, Array::get(builtin_type_idxs, bti))
    bti = bti + 1
  }
  let mut fti = 0
  while fti < num_user_funcs {
    let upc = Array::get(fn_param_counts, fti)
    Array::push(func_type_indices, num_base_types + upc)
    fti = fti + 1
  }
  Array::push(func_type_indices, 2)
  Array::push(func_type_indices, 5)
  let mut lfi = 0
  while lfi < num_lambdas {
    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1
    Array::push(func_type_indices, num_base_types + lam_user_params)
    lfi = lfi + 1
  }
  if Array::length(func_type_indices) != Array::length(bodies) {
    throw("WASI codegen internal error: function section and code section count mismatch")
  }
  emit_function_section(out, func_type_indices)
  // #2388: lambdas sit at [lambda_slot_base, +num_lambdas) — see the
  // lambda_slot_base doc on CompileCtx. Slots in the reserved gap
  // [num_user_funcs, lambda_slot_base) are never used and stay ref.null.
  let total_table_entries = if num_user_funcs + num_lambdas > 0 {
    lambda_slot_base + num_lambdas
  } else {
    0
  }
  if total_table_entries > 0 {
    emit_table_section_funcref(out, total_table_entries)
  }
  // #2427: under `VIBE_RC=shadow` the bump pointer starts ABOVE the shadow
  // table (`rc_shadow_heap_start()`), so the minimum memory has to cover the
  // table AND everything below it. Adding the reserve to the ordinary heap
  // base -- what this did before -- sized the memory correctly but left the
  // heap growing straight into the table.
  //
  // The table's base is a constant, so the regions BELOW the heap -- static
  // string data from offset 64, then the effect/coverage/trace/rc-bin/region
  // reserves -- have to end below it. They do for every module in this tree
  // (the largest, the generated cli_adapter bundle, holds about 25 MB of
  // string literals against a 256 MiB base), but a module with a few hundred
  // MB of literals would put its own data inside the table: guards would read
  // literal bytes as freed marks and marks would overwrite the literals.
  // Refuse instead. The fix if this ever fires is to derive the base from
  // `fixed_top` and thread it through the builtin body generators the way
  // `bins_base` already is -- not to widen the constant, which cannot help
  // because the heap start rides on it (see `rc_shadow_reserve`).
  let fixed_top = heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve + rc_bins_reserve + region_reserve
  if rc_shadow && fixed_top > rc_shadow_base() {
    throw("VIBE_RC=shadow is unavailable for this module: its static data and fixed reserves end at " + Int::to_string(fixed_top) + " bytes, past the shadow table base at " + Int::to_string(rc_shadow_base()) + ". Compile it with VIBE_RC=1 instead, or shrink the module's string literals.")
  } else {
    ()
  }
  emit_memory_section(out, wasi_memory_min_pages_for_heap(if rc_shadow {
    rc_shadow_heap_start()
  } else {
    fixed_top
  }))
  // #721: emit the tag section only when something can reference a tag --
  // EThrow (`throw 2`), EHandle (try_table over tags 0-3), or a declared
  // effect (per-effect tags at index 4+). Pure-compute modules then carry no
  // exceptions machinery at all, which keeps V8 off its slower exnref module
  // path (~35% wall on call-heavy code; wasmtime is indifferent).
  let uses_exceptions = Array::length(effect_names_list) > 0 || stmts_contain_exceptions(stmts)
  if uses_exceptions {
    let tag_content = bytebuf_new()
    let num_tags = Array::length(effect_names_list) + 4
    bytebuf_push_vec_header(tag_content, num_tags)
    let mut tag_emit_i = 0
    while tag_emit_i < num_tags {
      bytebuf_push(tag_content, 0)
      leb128_encode_u32(tag_content, 1)
      tag_emit_i = tag_emit_i + 1
    }
    bytebuf_push_section(out, 13, tag_content)
  } else {
    ()
  }
  let global_content = bytebuf_new()
  // Base globals (bump ptr, effect state, ..., g_op_index) plus two i64
  // globals per module-level thunk (memo value + init flag) appended last —
  // see the thunk-body memoization above for the index formula.
  let tg_num_thunks = Array::length(thunk_names_list)
  if enable_rc {
    bytebuf_push_vec_header(global_content, 7 + tg_num_thunks * 2)
  } else {
    bytebuf_push_vec_header(global_content, 6 + tg_num_thunks * 2)
  }
  bytebuf_push(global_content, 127)
  bytebuf_push(global_content, 1)
  // #2427: global 0 is the bump pointer. Under shadow RC it starts above the
  // shadow table so the two regions cannot overlap; the fixed regions below
  // (static strings, rc bins, region arena) keep their computed addresses.
  emit_i32_const(global_content, if rc_shadow {
    rc_shadow_heap_start()
  } else {
    fixed_top
  })
  emit_end(global_content)
  bytebuf_push(global_content, 126)
  bytebuf_push(global_content, 1)
  emit_i64_const(global_content, 0)
  emit_end(global_content)
  if enable_rc {
    bytebuf_push(global_content, 127)
    bytebuf_push(global_content, 1)
    emit_i32_const(global_content, 0)
    emit_end(global_content)
  }
  bytebuf_push(global_content, 126)
  bytebuf_push(global_content, 1)
  emit_i64_const(global_content, 0)
  emit_end(global_content)
  bytebuf_push(global_content, 126)
  bytebuf_push(global_content, 1)
  emit_i64_const(global_content, 0)
  emit_end(global_content)
  bytebuf_push(global_content, 127)
  bytebuf_push(global_content, 1)
  emit_i32_const(global_content, heap_start)
  emit_end(global_content)
  // #665: g_op_index (i64, mut) — operation index of the perform unwinding to a
  // handler, for multi-operation dispatch. Appended last; index = rc ? 6 : 5.
  bytebuf_push(global_content, 126)
  bytebuf_push(global_content, 1)
  emit_i64_const(global_content, 0)
  emit_end(global_content)
  let mut tg_gi = 0
  while tg_gi < tg_num_thunks * 2 {
    bytebuf_push(global_content, 126)
    bytebuf_push(global_content, 1)
    emit_i64_const(global_content, 0)
    emit_end(global_content)
    tg_gi = tg_gi + 1
  }
  bytebuf_push_section(out, 6, global_content)
  let start_func_idx = func_offset + num_user_funcs
  let run_func_idx = start_func_idx + 1
  let all_export_names = lc_fresh_string_array()
  let all_export_indices = lc_fresh_int_array()
  if !library_mode {
    Array::push(all_export_names, "_start")
    Array::push(all_export_indices, start_func_idx)
  }
  if !library_mode && entry_func_idx >= 0 && !array_contains_str(all_export_names, entry_name_in) {
    Array::push(all_export_names, entry_name_in)
    Array::push(all_export_indices, entry_func_idx)
  }
  let mut exi = 0
  while exi < Array::length(export_fn_names) {
    // #3132 review: a definition renamed aside for being named like a builtin
    // the compiler calls (`Array::length` -> `Array::length$user`) is still
    // exported under the name the program wrote.
    let ename = builtin_shadow_source_name(Array::get(export_fn_names, exi))
    let skip_export = library_mode && ename == entry_name_in
    if !skip_export && !array_contains_str(all_export_names, ename) {
      Array::push(all_export_names, ename)
      Array::push(all_export_indices, Array::get(export_fn_user_indices, exi) + func_offset)
    }
    exi = exi + 1
  }
  // Per-block test/bench: export each `__test_<name>` / `__bench_<name>` function
  // so a runner can invoke one block at a time (instead of running the whole
  // `_start`, which loops over every block). This is what gives merged builds
  // (#819) per-block failure attribution and a per-block timeout -- once N files
  // share one module, `_start` has no granularity left unless each block is
  // separately addressable. Only `__no_entry__` test/bench builds populate
  // test_fn_names, so normal builds (incl. the compiler self-compile) are
  // byte-identical. The wasm index of a user function at user-index `j` is
  // `j + func_offset`.
  let mut bxi = 0
  while bxi < Array::length(test_fn_names) {
    let bname = Array::get(test_fn_names, bxi)
    let bexportable = String::starts_with(bname, "__bench_") ||
    String::starts_with(bname, "__test_")
    if bexportable && !array_contains_str(all_export_names, bname) {
      let mut bj = 0
      let mut bfound = 0 - 1
      while bj < num_user_funcs {
        if Array::get(fn_names_list, bj) == bname {
          bfound = bj
          bj = num_user_funcs
        } else {
          bj = bj + 1
        }
      }
      if bfound >= 0 {
        Array::push(all_export_names, bname)
        Array::push(all_export_indices, bfound + func_offset)
      }
    }
    bxi = bxi + 1
  }
  let export_content = bytebuf_new()
  // #721: exception tag exports exist only when the tag section does. `error`
  // is the entry-boundary tag; `__exception_throw_tag` is the language-level
  // Exception::Throw tag used by handle expressions and host imports.
  let export_count = Array::length(all_export_names) + 1 +
  (if library_mode {
    0
  } else {
    1 + (if uses_exceptions {
      2
    } else {
      0
    })
  })
  bytebuf_push_vec_header(export_content, export_count)
  let mut efi = 0
  while efi < Array::length(all_export_names) {
    emit_name(export_content, Array::get(all_export_names, efi))
    bytebuf_push(export_content, 0)
    leb128_encode_u32(export_content, Array::get(all_export_indices, efi))
    efi = efi + 1
  }
  emit_name(export_content, "memory")
  bytebuf_push(export_content, 2)
  leb128_encode_u32(export_content, 0)
  if !library_mode {
    emit_name(export_content, "__heap_ptr")
    bytebuf_push(export_content, 3)
    leb128_encode_u32(export_content, 0)
    if uses_exceptions {
      emit_name(export_content, "error")
      bytebuf_push(export_content, 4)
      leb128_encode_u32(export_content, 0)
      emit_name(export_content, "__exception_throw_tag")
      bytebuf_push(export_content, 4)
      leb128_encode_u32(export_content, 2)
    } else {
      ()
    }
  }
  bytebuf_push_section(out, 7, export_content)
  if total_table_entries > 0 {
    // #1107 Phase 4: register ONLY the slots codegen recorded a closure value
    // for (table_slots_used — see CompileCtx). A slot no closure carries can
    // never be call_indirect'ed, so it stays ref.null; slot numbering and the
    // declared table size are untouched. Run-compressed active segments skip
    // the gaps (emit_element_section_active_runs). This also shrinks the DCE
    // root set a downstream optimizer (vibe-opt, wasm-opt) must respect —
    // previously every user function + lambda was elem-rooted.
    let slot_used_flags = lc_fresh_bool_array()
    let mut sfi = 0
    while sfi < total_table_entries {
      Array::push(slot_used_flags, false)
      sfi = sfi + 1
    }
    let mut tsu = 0
    while tsu < Array::length(table_slots_used) {
      let ts = Array::get(table_slots_used, tsu)
      if ts >= 0 && ts < total_table_entries {
        Array::set(slot_used_flags, ts, true)
      } else {
        ()
      }
      tsu = tsu + 1
    }
    let table_slots = lc_fresh_int_array()
    let table_func_indices = lc_fresh_int_array()
    let mut tei = 0
    while tei < total_table_entries {
      if Array::get(slot_used_flags, tei) {
        Array::push(table_slots, tei)
        Array::push(table_func_indices, if tei < num_user_funcs {
          func_offset + tei
        } else {
          run_func_idx + 1 + (tei - lambda_slot_base)
        })
      } else {
        ()
      }
      tei = tei + 1
    }
    if Array::length(table_slots) > 0 {
      emit_element_section_active_runs(out, table_slots, table_func_indices)
    } else {
      ()
    }
  }
  // Binary-size: replace the bodies of generated runtime helpers that no
  // reachable body ever calls with a 1-instruction `unreachable` stub. The
  // helper index block [num_imported_funcs, func_offset) is emitted
  // unconditionally (every call site references FIXED indices computed above),
  // so helpers cannot simply be omitted — but an unreferenced body can shrink
  // to `unreachable` without moving any index. Reachability is a worklist
  // byte-scan over final body bytes for `call`(0x10)/`ref.func`(0xd2)
  // immediates that decode into the helper range, seeded from every
  // non-helper body (user fns + entry glue + lambdas; the funcref table only
  // holds user/lambda indices). A stray 0x10 inside some other immediate can
  // only FALSE-POSITIVE (keeps an unused helper) — never drops a used one,
  // since every real call's opcode byte is also visited. Skipped for
  // instrumentation builds so debug tooling sees unmodified bodies.
  if !coverage && !debug_trace && !debug_break && !rc_shadow {
    let builtin_used = lc_fresh_bool_array()
    let mut sbu_i = 0
    while sbu_i < num_generated {
      Array::push(builtin_used, false)
      sbu_i = sbu_i + 1
    }
    let scan_queue = lc_fresh_int_array()
    let mut sbr = num_generated
    while sbr < Array::length(bodies) {
      Array::push(scan_queue, sbr)
      sbr = sbr + 1
    }
    let mut sq_i = 0
    while sq_i < Array::length(scan_queue) {
      let sb_body = Array::get(bodies, Array::get(scan_queue, sq_i))
      sq_i = sq_i + 1
      let sb_len = Bytes::length(sb_body)
      let mut sb_p = 0
      while sb_p < sb_len {
        let sb_op = Bytes::get(sb_body, sb_p)
        if sb_op == 16 || sb_op == 210 {
          let mut sb_q = sb_p + 1
          let mut sb_v = 0
          let mut sb_shift = 0
          let mut sb_more = true
          let mut sb_valid = false
          while sb_more && sb_q < sb_len && sb_shift < 35 {
            let sb_byte = Bytes::get(sb_body, sb_q)
            sb_v = sb_v|((sb_byte&127)<<sb_shift)
            sb_q = sb_q + 1
            if (sb_byte&128) == 0 {
              sb_more = false
              sb_valid = true
            } else {
              sb_shift = sb_shift + 7
            }
          }
          if sb_valid && sb_v >= num_imported_funcs && sb_v < func_offset {
            let sb_pos = sb_v - num_imported_funcs
            if !Array::get(builtin_used, sb_pos) {
              Array::set(builtin_used, sb_pos, true)
              Array::push(scan_queue, sb_pos)
            } else {
              ()
            }
          } else {
            ()
          }
        } else {
          ()
        }
        sb_p = sb_p + 1
      }
    }
    let mut sb_k = 0
    while sb_k < num_generated {
      if !Array::get(builtin_used, sb_k) {
        let sb_stub = bytebuf_new()
        bytebuf_push(sb_stub, 0)
        Array::set(bodies, sb_k, sb_stub)
        Array::set(meta_i32, sb_k, 0)
        Array::set(meta_i64, sb_k, 0)
      } else {
        ()
      }
      sb_k = sb_k + 1
    }
  } else {
    ()
  }
  let code_content = bytebuf_new()
  bytebuf_push_vec_header(code_content, Array::length(bodies))
  // #644: per-user-function locals-declaration header length, in `bodies`
  // ci-order (`bi = ci - num_generated`, the same relationship `func_offset`
  // encodes for the final wasm function index). Captured below as each
  // func_buf's locals header is assembled, BEFORE `body` (the raw
  // instruction stream body_buf compiled with linemap_state) is appended --
  // this is exactly the byte count linked_compile needs to add to a
  // body_buf-relative linemap offset to match wasmtime's
  // `FrameInfo::func_offset()`, which measures from the first byte of the
  // code entry (the locals header), not the first instruction.
  let linemap_hdrlen_by_bi = if linemap_state.enabled {
    lc_fresh_int_array_of_len(num_user_funcs, 0)
  } else {
    lc_fresh_int_array()
  }
  if Array::length(meta_v128) != Array::length(bodies) {
    throw(String::concat("meta_v128/bodies misalignment: ", String::concat(__to_string(Array::length(meta_v128)), String::concat(" vs ", __to_string(Array::length(bodies))))))
  } else {
    ()
  }
  let mut ci = 0
  while ci < Array::length(bodies) {
    // ADR-0090 dogfood (#1770): each function's code buffer is built, copied
    // into code_content, and discarded -- the buffer itself never escapes the
    // iteration. Backing it with the region arena reclaims the buffer AND its
    // doubling regrows wholesale at the region end instead of leaking them on
    // the bump heap (one buffer per emitted function, the hottest
    // build-and-discard site in a self-compile). The bytebuf_* helpers are
    // unchanged: arena vs main-heap regrow is a property of the buffer's own
    // block (gen_bytes_push_body / gen_bytes_append_body), not of the call
    // site, so a MutBytes flows through them as-is. Needs the
    // mutbytes-2026-08-15 seed (#1801/#1808).
    region r {
      let body = Array::get(bodies, ci)
      let func_buf = MutBytes::empty(r)
      let ni32 = Array::get(meta_i32, ci)
      let ni64 = Array::get(meta_i64, ci)
      // #805 SIMD locals: a third v128 (0x7B) run after the i32/i64 runs.
      // Zero for every function except inline-wasm fns declaring v128 locals,
      // so the header bytes are unchanged wherever the feature is unused.
      let nv128 = Array::get(meta_v128, ci)
      let mut ngroups = 0
      if ni32 > 0 {
        ngroups = ngroups + 1
      } else {
        ()
      }
      if ni64 > 0 {
        ngroups = ngroups + 1
      } else {
        ()
      }
      if nv128 > 0 {
        ngroups = ngroups + 1
      } else {
        ()
      }
      leb128_encode_u32(func_buf, ngroups)
      if ni32 > 0 {
        leb128_encode_u32(func_buf, ni32)
        bytebuf_push(func_buf, 127)
      } else {
        ()
      }
      if ni64 > 0 {
        leb128_encode_u32(func_buf, ni64)
        bytebuf_push(func_buf, 126)
      } else {
        ()
      }
      if nv128 > 0 {
        leb128_encode_u32(func_buf, nv128)
        bytebuf_push(func_buf, 123)
      } else {
        ()
      }
      if linemap_state.enabled {
        let lm_bi = ci - num_generated
        if lm_bi >= 0 && lm_bi < num_user_funcs {
          Array::set(linemap_hdrlen_by_bi, lm_bi, bytebuf_length(func_buf))
        } else {
          ()
        }
      } else {
        ()
      }
      bytebuf_push_buf(func_buf, body)
      bytebuf_push(func_buf, 11)
      leb128_encode_u32(code_content, bytebuf_length(func_buf))
      bytebuf_push_buf(code_content, func_buf)
    }
    ci = ci + 1
  }
  bytebuf_push_section(out, 10, code_content)
  // #644 / #2199: `vibe.linemap` custom section -- a 4-byte format marker,
  // then four unsigned LEB deltas per unique (func, offset): func_delta,
  // offset_delta, file_id, line.
  // Duplicate offsets are collapsed. The offset is shifted by that
  // function's locals-header length (linemap_hdrlen_by_bi) so it lands
  // exactly where wasmtime's FrameInfo::func_offset() measures from. Emitted
  // when linemap_state is enabled AND at least one record exists (production
  // trap provenance, and debug-break). Empty tables are not announced: a
  // named section of zero records is pure waste (#2199).
  //
  // The marker is what makes the name mean one format. #644's table under
  // this same name was 16-byte little-endian records, and those bytes decode
  // as LEB quadruples without complaint -- a module built by any compiler
  // older than #2199 (the committed seed, which is what `vibe test` runs by
  // default) would have reported fabricated functions, offsets, files and
  // lines to the new readers. A reader that does not find `VLM1` has a table
  // it cannot read, and reports no location at all (Codex P2 on PR #2867).
  //
  // #2874: the rows arrive as flushed GROUPS (`linemap_flush_fn`), one per
  // user function, not as four module-wide tables. A group's payload is
  // already in the encoding the section wants except for its first row's
  // offset, which is the only field the locals-header rebase moves -- so this
  // writes the function delta and that one rebased absolute, then blits the
  // group verbatim.
  //
  // The delta encoding needs each emitted group's function index to be
  // greater than the last emitted one, which is how the rows are produced:
  // `cur_fn` is set once per `bi` at the top of the body loop and `bi` only
  // climbs. A group the header table cannot place is skipped whole, exactly
  // as its rows were skipped one at a time before, and skipping does not
  // advance `prev_f`.
  if linemap_state.enabled && Array::length(linemap_state.grp_fn) > 0 {
    let lm_content = bytebuf_new()
    let lm_name = "vibe.linemap"
    leb128_encode_u32(lm_content, String::length(lm_name))
    let mut lmni = 0
    while lmni < String::length(lm_name) {
      bytebuf_push(lm_content, String::char_code_at(lm_name, lmni))
      lmni = lmni + 1
    }
    lc_linemap_put_magic(lm_content)
    let hdr_n = Array::length(linemap_hdrlen_by_bi)
    let lm_ng = Array::length(linemap_state.grp_fn)
    let lm_stream_n = bytebuf_length(linemap_state.stream)
    let mut prev_f = 0
    let mut have = false
    let mut lm_g = 0
    while lm_g < lm_ng {
      let lm_bi = Array::get(linemap_state.grp_fn, lm_g)
      let lm_lo = Array::get(linemap_state.grp_start, lm_g)
      let lm_hi = if lm_g + 1 < lm_ng {
        Array::get(linemap_state.grp_start, lm_g + 1)
      } else {
        lm_stream_n
      }
      if lm_bi >= 0 && lm_bi < hdr_n {
        let lm_func_idx = func_offset + lm_bi
        let lm_off = Array::get(linemap_state.grp_first_off, lm_g) + Array::get(linemap_hdrlen_by_bi, lm_bi)
        leb128_encode_u32(lm_content, if have {
          lm_func_idx - prev_f
        } else {
          lm_func_idx
        })
        leb128_encode_u32(lm_content, lm_off)
        Bytes::blit(lm_content, linemap_state.stream, lm_lo, lm_hi)
        prev_f = lm_func_idx
        have = true
      } else {
        ()
      }
      lm_g = lm_g + 1
    }
    bytebuf_push_section(out, 0, lm_content)
  } else {
    ()
  }
  if num_strings > 0 {
    let data_offsets = lc_fresh_int_array()
    let data_bufs = lc_fresh_bytes_array()
    let mut di = 0
    while di < num_strings {
      Array::push(data_offsets, Array::get(str_offsets, di))
      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))
      di = di + 1
    }
    emit_data_section_multi(out, data_offsets, data_bufs)
  }
  // Name section (debugger P0 / ADR-0035): name the user functions so wasm
  // backtraces and tooling show `main` etc. instead of `<wasm function N>`.
  // User functions occupy consecutive indices starting at `func_offset`.
  // #768: emit ONLY the first num_user_funcs entries -- fn_names_list also
  // carries the builtin/runtime names appended for call resolution (Env::get,
  // Fs::read_file, ...), but those bodies live at LOW indices (below
  // func_offset). Emitting the whole list consecutively shifted every
  // post-user name: `_start` was labeled `Env::get` in crash stacks, which
  // repeatedly sent debugging to functions the trace never touched. `_start`
  // and `run` sit right after the user block, so name them explicitly.
  // #799: name the GENERATED runtime helpers too. Profilers (node --cpu-prof)
  // attributed the hottest samples to anonymous wasm-function[N] frames
  // because only user functions carried name-section entries; the generated
  // string/array/bytes helpers occupy the consecutive index range
  // [num_imported_funcs, func_offset). Unassigned slots (lambda-arity pads
  // etc.) keep the generic "__rt_gen" label.
  let gen_sec_names = lc_fresh_string_array()
  let mut gsn_i = 0
  while gsn_i < num_generated {
    Array::push(gen_sec_names, "__rt_gen")
    gsn_i = gsn_i + 1
  }
  Array::set(gen_sec_names, print_int_idx - num_imported_funcs, "__rt_print_int")
  Array::set(gen_sec_names, print_str_idx - num_imported_funcs, "__rt_print_str")
  Array::set(gen_sec_names, str_len_idx - num_imported_funcs, "__rt_str_len")
  Array::set(gen_sec_names, str_eq_idx - num_imported_funcs, "__rt_str_eq")
  Array::set(gen_sec_names, str_concat_idx - num_imported_funcs, "__rt_str_concat")
  Array::set(gen_sec_names, arr_new_idx - num_imported_funcs, "__rt_arr_new")
  Array::set(gen_sec_names, arr_len_idx - num_imported_funcs, "__rt_arr_len")
  Array::set(gen_sec_names, arr_get_idx - num_imported_funcs, "__rt_arr_get")
  Array::set(gen_sec_names, arr_push_idx - num_imported_funcs, "__rt_arr_push")
  Array::set(gen_sec_names, arr_set_idx - num_imported_funcs, "__rt_arr_set")
  Array::set(gen_sec_names, double_to_int_idx - num_imported_funcs, "__rt_double_to_int")
  Array::set(gen_sec_names, int_to_double_idx - num_imported_funcs, "__rt_int_to_double")
  Array::set(gen_sec_names, int_popcount_idx - num_imported_funcs, "__rt_int_popcount")
  Array::set(gen_sec_names, int_ctz_idx - num_imported_funcs, "__rt_int_ctz")
  Array::set(gen_sec_names, int_clz_idx - num_imported_funcs, "__rt_int_clz")
  Array::set(gen_sec_names, bytes_index_of_bytes_idx - num_imported_funcs, "__rt_bytes_index_of_bytes")
  Array::set(gen_sec_names, bytes_index_of_idx - num_imported_funcs, "__rt_bytes_index_of_byte")
  Array::set(gen_sec_names, bytes_count_byte_idx - num_imported_funcs, "__rt_bytes_count_byte")
  Array::set(gen_sec_names, bytes_last_index_of_idx - num_imported_funcs, "__rt_bytes_last_index_of_byte")
  Array::set(gen_sec_names, bytes_compare_idx - num_imported_funcs, "__rt_bytes_compare")
  Array::set(gen_sec_names, bytes_blit_idx - num_imported_funcs, "__rt_bytes_blit")
  Array::set(gen_sec_names, array_capacity_idx - num_imported_funcs, "__rt_arr_with_capacity")
  Array::set(gen_sec_names, bytes_capacity_idx - num_imported_funcs, "__rt_bytes_with_capacity")
  Array::set(gen_sec_names, str_char_code_at_idx - num_imported_funcs, "__rt_str_char_code_at")
  Array::set(gen_sec_names, str_from_char_code_idx - num_imported_funcs, "__rt_str_from_char_code")
  Array::set(gen_sec_names, str_substring_idx - num_imported_funcs, "__rt_str_substring")
  Array::set(gen_sec_names, identity_idx - num_imported_funcs, "__rt_identity")
  Array::set(gen_sec_names, arr_slice_idx - num_imported_funcs, "__rt_arr_slice")
  Array::set(gen_sec_names, frozen_array_copy_idx - num_imported_funcs, "__rt_frozen_array_copy")
  Array::set(gen_sec_names, arr_concat_idx - num_imported_funcs, "__rt_arr_concat")
  Array::set(gen_sec_names, arr_truncate_idx - num_imported_funcs, "__rt_arr_truncate")
  Array::set(gen_sec_names, string_join_idx - num_imported_funcs, "__rt_string_join")
  Array::set(gen_sec_names, fs_read_file_stub_idx - num_imported_funcs, "__rt_stub_a")
  Array::set(gen_sec_names, fs_exists_stub_idx - num_imported_funcs, "__rt_stub_b")
  Array::set(gen_sec_names, fs_stat_token_stub_idx - num_imported_funcs, "__rt_stub_c")
  Array::set(gen_sec_names, fs_write_file_stub_idx - num_imported_funcs, "__rt_stub_d")
  Array::set(gen_sec_names, fs_publish_immutable_text_stub_idx - num_imported_funcs, "__rt_stub_e")
  Array::set(gen_sec_names, fs_write_bytes_stub_idx - num_imported_funcs, "__rt_stub_f")
  Array::set(gen_sec_names, eq_idx - num_imported_funcs, "__rt_eq")
  Array::set(gen_sec_names, string_ends_with_idx - num_imported_funcs, "__rt_string_ends_with")
  Array::set(gen_sec_names, string_last_index_of_idx - num_imported_funcs, "__rt_string_last_index_of")
  Array::set(gen_sec_names, arr_push_all_idx - num_imported_funcs, "__rt_arr_push_all")
  Array::set(gen_sec_names, string_index_of_idx - num_imported_funcs, "__rt_string_index_of")
  Array::set(gen_sec_names, string_contains_idx - num_imported_funcs, "__rt_string_contains")
  Array::set(gen_sec_names, string_starts_with_idx - num_imported_funcs, "__rt_string_starts_with")
  Array::set(gen_sec_names, string_split_idx - num_imported_funcs, "__rt_string_split")
  Array::set(gen_sec_names, string_trim_idx - num_imported_funcs, "__rt_string_trim")
  Array::set(gen_sec_names, sources_idx - num_imported_funcs, "__rt_sources")
  Array::set(gen_sec_names, bytes_new_idx - num_imported_funcs, "__rt_bytes_new")
  Array::set(gen_sec_names, bytes_len_idx - num_imported_funcs, "__rt_bytes_len")
  Array::set(gen_sec_names, bytes_get_idx - num_imported_funcs, "__rt_bytes_get")
  Array::set(gen_sec_names, bytes_set_idx - num_imported_funcs, "__rt_bytes_set")
  Array::set(gen_sec_names, bytes_push_idx - num_imported_funcs, "__rt_bytes_push")
  Array::set(gen_sec_names, bytes_append_idx - num_imported_funcs, "__rt_bytes_append")
  Array::set(gen_sec_names, bytes_concat_idx - num_imported_funcs, "__rt_bytes_concat")
  Array::set(gen_sec_names, bytes_slice_idx - num_imported_funcs, "__rt_bytes_slice")
  Array::set(gen_sec_names, bytes_from_array_idx - num_imported_funcs, "__rt_bytes_from_array")
  Array::set(gen_sec_names, bytes_to_array_idx - num_imported_funcs, "__rt_bytes_to_array")
  if enable_rc {
    Array::set(gen_sec_names, rc_drop_idx - num_imported_funcs, "__rt_rc_drop")
    Array::set(gen_sec_names, rc_dup_idx - num_imported_funcs, "__rt_rc_dup")
    Array::set(gen_sec_names, rc_alloc_idx - num_imported_funcs, "__rt_rc_alloc")
  } else {
    ()
  }
  Array::set(gen_sec_names, heap_grow_check_idx - num_imported_funcs, "__rt_heap_grow_check")
  Array::set(gen_sec_names, simd_skip_ws_idx - num_imported_funcs, "__rt_simd_skip_ws")
  Array::set(gen_sec_names, simd_scan_alnum_idx - num_imported_funcs, "__rt_simd_scan_alnum")
  Array::set(gen_sec_names, simd_scan_alnum_str_idx - num_imported_funcs, "__rt_simd_scan_alnum_str")
  Array::set(gen_sec_names, simd_scan_string_special_str_idx - num_imported_funcs, "__rt_simd_scan_string_special_str")
  Array::set(gen_sec_names, simd_scan_line_end_str_idx - num_imported_funcs, "__rt_simd_scan_line_end_str")
  Array::set(gen_sec_names, str_lex_diff_idx - num_imported_funcs, "__rt_str_lex_diff")
  Array::set(gen_sec_names, generic_rel_diff_idx - num_imported_funcs, "__rt_generic_rel_diff")
  Array::set(gen_sec_names, generic_add_idx - num_imported_funcs, "__rt_generic_add")
  Array::set(gen_sec_names, compact_fingerprint_hash_idx - num_imported_funcs, "__rt_compact_fingerprint_hash")
  Array::set(gen_sec_names, print_i64_raw_idx - num_imported_funcs, "__rt_print_i64_raw")
  Array::set(gen_sec_names, oob_abort_idx - num_imported_funcs, "__rt_oob_abort")
  if rc_shadow {
    Array::set(gen_sec_names, shadow_uaf_abort_idx - num_imported_funcs, "__rt_shadow_uaf_abort")
  } else {
    ()
  }
  if need_div_zero_abort {
    Array::set(gen_sec_names, div_zero_abort_idx - num_imported_funcs, "__rt_div_zero_abort")
  } else {
    ()
  }
  let name_sec_names = gen_sec_names
  let mut usn_i = 0
  while usn_i < num_user_funcs {
    Array::push(name_sec_names, Array::get(fn_names_list, usn_i))
    usn_i = usn_i + 1
  }
  Array::push(name_sec_names, "_start")
  Array::push(name_sec_names, "run")
  emit_function_name_section(out, name_sec_names, num_imported_funcs)
  // #2359: drop unreachable functions and renumber. Same build gating as the
  // body-stubbing pass above (instrumented builds must see unmodified
  // bodies), plus `enable_late_dce` so the no-DCE lane keeps its contract.
  if enable_late_dce && !coverage && !debug_trace && !debug_break && !rc_shadow {
    lc_pf_prune_module(bytebuf_to_bytes(out), entry_name, executable_exports_stripped())
  } else {
    bytebuf_to_bytes(out)
  }
}
