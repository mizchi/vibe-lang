  }
  if hs_claim_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "host_stream_claim")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // ADR-0089 (c) (#1218): `vibe.host_future_get$<name> () -> i64` (type 5)
  // per named host future -- after the anonymous pair, in the same sorted
  // order the indices were reserved in. The `$<name>` suffix is what the
  // composer reads back to build the component-level import of that name.
  let mut hf_emit_i = 0
  while hf_emit_i < Array::length(hf_named_names) {
    emit_name(import_content, "vibe")
    emit_name(import_content, String::concat("host_future_get$", Array::get(hf_named_names, hf_emit_i)))
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 5)
    hf_emit_i = hf_emit_i + 1
  }
  // #2064: then `vibe.wit_future_get$<address>` (type 5) per WIT function
  // address (`cc_is_wit_future_address`), the metadata import the composer
  // turns into an import of that versioned INTERFACE rather than a root
  // function. Same type, same wait half; reserved after the root names, the
  // order `hf_all_names` fixed.
  let mut hf_wit_emit_i = 0
  while hf_wit_emit_i < Array::length(hf_wit_names) {
    emit_name(import_content, "vibe")
    emit_name(import_content, String::concat("wit_future_get$", Array::get(hf_wit_names, hf_wit_emit_i)))
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 5)
    hf_wit_emit_i = hf_wit_emit_i + 1
  }
  // #2066: then `vibe.wit_response_get$<address>` (type 5) per WIT response,
  // the metadata import the composer turns into a `types` + API interface
  // pair whose function returns `future<response>`. Same wait half.
  // Responses taking the string argument the guest pushed through
  // `vibe.host_arg_push` come first, in hf_all_names' order.
  let mut hf_resp_arg_emit_i = 0
  while hf_resp_arg_emit_i < Array::length(hf_response_arg_addresses) {
    emit_name(import_content, "vibe")
    emit_name(import_content, String::concat("wit_response_arg_get$", Array::get(hf_response_arg_addresses, hf_resp_arg_emit_i)))
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 5)
    hf_resp_arg_emit_i = hf_resp_arg_emit_i + 1
  }
  let mut hf_resp_emit_i = 0
  while hf_resp_emit_i < Array::length(hf_response_addresses) {
    emit_name(import_content, "vibe")
    emit_name(import_content, String::concat("wit_response_get$", Array::get(hf_response_addresses, hf_resp_emit_i)))
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 5)
    hf_resp_emit_i = hf_resp_emit_i + 1
  }
  // ADR-0089 Decision 3 (#1218): `vibe.host_stream_read (i64) -> i64` (type
  // 3), then `vibe.host_stream_get$<name> () -> i64` (type 5) per named
  // host stream -- after the host-future imports, in the same sorted order
  // the indices were reserved in. Component-adapter-provided (spec §3.18);
  // the `$<name>` suffix is what the composer reads back to build the
  // component-level `stream<u8>` import of that name.
  if hs_read_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "host_stream_read")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // ADR-0089 Decision 3 follow-up (#1218): `vibe.host_stream_close
  // (i64) -> i64` (type 3), reserved right after the read half and emitted
  // in that order. Present only when the program actually closes a stream,
  // so draining programs stay byte-identical.
  if hs_close_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "host_stream_close")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
