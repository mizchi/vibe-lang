// Serialize the completed module tables and diagnostic sections.
// Keep lane flags explicit so constant-parameter folding can remove disabled code.
export fn lc_emit_module_sections(input: LinkedSectionInputs, coverage: Bool, debug_break: Bool, debug_trace: Bool, enable_rc: Bool, rc_shadow: Bool) -> Bytes with Exception {
  let arr_concat_idx = input.arr_concat_idx
  let arr_get_idx = input.arr_get_idx
  let arr_len_idx = input.arr_len_idx
  let arr_new_idx = input.arr_new_idx
  let arr_push_all_idx = input.arr_push_all_idx
  let arr_push_idx = input.arr_push_idx
  let arr_set_idx = input.arr_set_idx
  let arr_slice_idx = input.arr_slice_idx
  let arr_truncate_idx = input.arr_truncate_idx
  let array_capacity_idx = input.array_capacity_idx
  let blind_kinds = input.blind_kinds
  let blind_offsets = input.blind_offsets
  let blind_owners = input.blind_owners
  let blind_syms = input.blind_syms
  let bodies = input.bodies
  let builtin_type_idxs = input.builtin_type_idxs
  let bytes_append_idx = input.bytes_append_idx
  let bytes_blit_idx = input.bytes_blit_idx
  let bytes_capacity_idx = input.bytes_capacity_idx
  let bytes_compare_idx = input.bytes_compare_idx
  let bytes_concat_idx = input.bytes_concat_idx
  let bytes_count_byte_idx = input.bytes_count_byte_idx
  let bytes_from_array_idx = input.bytes_from_array_idx
  let bytes_get_idx = input.bytes_get_idx
  let bytes_index_of_bytes_idx = input.bytes_index_of_bytes_idx
  let bytes_index_of_idx = input.bytes_index_of_idx
  let bytes_last_index_of_idx = input.bytes_last_index_of_idx
  let bytes_len_idx = input.bytes_len_idx
  let bytes_new_idx = input.bytes_new_idx
  let bytes_push_idx = input.bytes_push_idx
  let bytes_set_idx = input.bytes_set_idx
  let bytes_slice_idx = input.bytes_slice_idx
  let bytes_to_array_idx = input.bytes_to_array_idx
  let compact_fingerprint_hash_idx = input.compact_fingerprint_hash_idx
  let cov_base = input.cov_base
