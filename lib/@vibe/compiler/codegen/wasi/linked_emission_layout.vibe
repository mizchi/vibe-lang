// Owned emission-layout summaries shared by ordinary emission and preparation.

import @vibe/compiler/core {
  sorted_names_of
}

import @vibe/compiler/codegen/common_base {
  bcc_layout_fp_bools, bcc_layout_fp_ints, bcc_layout_fp_string_matrix, bcc_layout_fp_strings, bcc_layout_fp_strings_upto
}

import ./linked_compile_lc_rename_sleep_calls.vibe {
  lc_fresh_int_array, lc_fresh_string_array
}

import ./linked_compile_linkedhostplan.vibe {
  LinkedBodyInputs
}

/// These owned arrays contain no syntax or function bodies. Preparation can
/// keep the guard while discarding its temporary capture/thunk indices.
export struct LinkedEmissionLayout {
  capture_names: Array[String];
  thunk_names: Array[String];
  guard_layout: Array[Int]
}

export fn lc_build_emission_layout(input: LinkedBodyInputs, lambda_bases: Array[Int], coverage: Bool, enable_rc: Bool, rc_shadow: Bool) -> LinkedEmissionLayout {
  let all_fn_indices_list = input.all_fn_indices_list
  let all_fn_names_list = input.all_fn_names_list
  let all_fn_needs_env_list = input.all_fn_needs_env_list
  let all_fn_param_counts = input.all_fn_param_counts
  let all_fn_returns_list = input.all_fn_returns_list
  let const_int_names_list = input.const_int_names_list
  let const_int_values_list = input.const_int_values_list
  let ctor_field_counts_list = input.ctor_field_counts_list
  let ctor_float_fields_list = input.ctor_float_fields_list
  let ctor_names_list = input.ctor_names_list
  let ctor_tags_list = input.ctor_tags_list
  let ctor_type_names_list = input.ctor_type_names_list
  let dbg_line_on = input.dbg_line_on
  let effect_names_list = input.effect_names_list
  let effect_op_arities_list = input.effect_op_arities_list
  let effect_op_keys_list = input.effect_op_keys_list
  let entry_name = input.entry_name
  let float_ret_fn_names = input.float_ret_fn_names
  let func_offset = input.func_offset
  let has_exceptions = input.has_exceptions
  let heap_grow_check_idx = input.heap_grow_check_idx
  let lambda_slot_base = input.lambda_slot_base
  let lc_agg_ret_infos = input.lc_agg_ret_infos
  let lc_agg_ret_names = input.lc_agg_ret_names
  let lc_borrow_param_mask = input.lc_borrow_param_mask
  let lc_borrow_param_user_srt = input.lc_borrow_param_user_srt
  let lc_borrow_ret_names = input.lc_borrow_ret_names
  let lc_borrow_view_ret = input.lc_borrow_view_ret
  let lc_heap_ret_names = input.lc_heap_ret_names
  let lc_scalar_ret_names = input.lc_scalar_ret_names
  let library_mode = input.library_mode
  let map_build_index_idx = input.map_build_index_idx
  let map_cap_idx = input.map_cap_idx
  let map_hash_idx = input.map_hash_idx
  let map_index_insert_idx = input.map_index_insert_idx
  let map_probe_index_idx = input.map_probe_index_idx
  let num_user_funcs = input.num_user_funcs
  let pin_region_capacity = input.pin_region_capacity
  let rc_alloc_idx = input.rc_alloc_idx
  let rc_drop_idx = input.rc_drop_idx
  let rc_dup_idx = input.rc_dup_idx
  let region_arr_new_idx = input.region_arr_new_idx
  let region_bytes_new_idx = input.region_bytes_new_idx
  let region_ptr_addr = input.region_ptr_addr
  let src_str_base = input.src_str_base
  let str_strs = input.str_strs
  let struct_field_names = input.struct_field_names
  let struct_names = input.struct_names
  let thunk_names_list = input.thunk_names_list
  // #799 perf: ONE membership index over the flat fn + ctor name tables,
  // shared by every per-function CompileCtx below. collect_free_vars_indexed
  // consults it per ident instead of linearly scanning ~thousands of names
  // (which dominated compiler-closure compile profiles).
  // Round 2: a SORTED array + binary search -- the previous MapBuilder index
  // was O(N^2) to build (set scans for duplicates) and O(N) per has_key.
  let capture_index_names = lc_fresh_string_array()
  let mut cib_i = 0
  while cib_i < Array::length(all_fn_names_list) {
    Array::push(capture_index_names, Array::get(all_fn_names_list, cib_i))
    cib_i = cib_i + 1
  }
  let mut cib_j = 0
  while cib_j < Array::length(ctor_names_list) {
    Array::push(capture_index_names, Array::get(ctor_names_list, cib_j))
    cib_j = cib_j + 1
  }
  // #3356: a module-level Int literal (`let base = 10`) is folded into
  // `const_int_names`, not the function table, and codegen reads it there
  // from any frame. Left out of this index, a lambda that read it recorded it
  // as a CAPTURE, found no enclosing local of that name, and stored 0 into its
  // env slot: `let g = (n) -> n + base` answered `n`, and a `let rec` lambda
  // reading it counted down to 0. The lambda plan's walk already counts it as
  // global (`shadow_names_only` below).
  let mut cib_k = 0
  while cib_k < Array::length(const_int_names_list) {
    Array::push(capture_index_names, Array::get(const_int_names_list, cib_k))
    cib_k = cib_k + 1
  }
  let capture_name_index_shared = sorted_names_of(capture_index_names)
  // Codex review on #1186: this was computed inside the `bi < num_user_funcs`
  // loop below, re-sorting the same thunk_names_list once per function
  // instead of once per compile -- hoist it out, same fix shape as
  // capture_name_index_shared above.
  let thunk_names_sorted_shared = sorted_names_of(thunk_names_list)
  // #2669 step 2b: the program-wide inputs a cached body's bytes depend on.
  //
  // Read off the `CompileCtx` construction in `LinkedFunctionPlan::emit`, the
  // whole interface between the program-wide prologue and a body's codegen: a
  // function's bytes are a function of its own AST and this context, and every
  // PER-function field of that context is in turn a function of its own AST
  // and the program-wide values folded here (the Perceus plan, the widest of
  // them, takes only the body plus `lc_perceus_pin` and the borrow tables).
  // So an unchanged file's body compiles to the same bytes exactly while these
  // agree -- which is what the prefix rule used to supply for free, merge
  // order being topological.
  //
  // Enumerating index spaces by inspection is how the reloc scan lost four
  // reference classes one at a time. Enumerating ONE struct's program-wide
  // fields at the site that builds it is a different kind of list: it is
  // closed, it sits next to what it describes, and
  // `lib/@vibe/compiler/tests/body_cache_edit_classes_test.vibe` makes an edit
  // that moves each of them for real and requires the compile to answer what a
  // fresh one answers -- so a slot left out fails as a byte mismatch in a test
  // rather than as a wrong module in someone's build.
  let guard_layout_now = lc_fresh_int_array()
  if pin_region_capacity >= 0 {
    // func_table -- every `call` immediate.
    bcc_layout_fp_strings(guard_layout_now, all_fn_names_list)
    bcc_layout_fp_ints(guard_layout_now, all_fn_indices_list)
    bcc_layout_fp_ints(guard_layout_now, all_fn_param_counts)
    bcc_layout_fp_ints(guard_layout_now, all_fn_returns_list)
    bcc_layout_fp_bools(guard_layout_now, all_fn_needs_env_list)
    //
    // `all_fn_names_list` is the whole vector, so it pins ORDER as well as
    // membership -- the case `guard_unmangled_names` (a sorted set) cannot
    // see. A `__test_` name riding along in it is not over-strict in the way
    // it looks: a renamed test is an edit to the ENTRY file, which is last in
    // merge order, so the prefix the lane narrows to is everything before it
    // -- exactly what it would have replayed anyway.
    // str_table -- every `(offset << 32) | length`.
    bcc_layout_fp_strings_upto(guard_layout_now, str_strs, src_str_base)
    // The scalars the table indices are built on. `lc_perceus_pin` is NOT one
    // of them: it is a process-local monotonic token (`pctx_pin_counter`)
    // memoizing the borrow tables, so it differs between two compiles of the
    // SAME program in one process -- measured, it was the only slot that moved
    // under a leading comment. The tables it stands for are folded below.
    bcc_layout_fp_ints(guard_layout_now, [
      num_user_funcs,
      lambda_slot_base,
      func_offset
    ])
    // The lambda plan -- every `lambda_slot_base + lambda_idx`.
    bcc_layout_fp_ints(guard_layout_now, lambda_bases)
    // ctor_table -- every constructor tag is `(type_index << 16) | variant`,
    // and `type_index` counts type declarations in merge order.
    bcc_layout_fp_strings(guard_layout_now, ctor_names_list)
    bcc_layout_fp_ints(guard_layout_now, ctor_tags_list)
    bcc_layout_fp_ints(guard_layout_now, ctor_field_counts_list)
    bcc_layout_fp_strings(guard_layout_now, ctor_type_names_list)
    bcc_layout_fp_strings(guard_layout_now, struct_names)
    bcc_layout_fp_string_matrix(guard_layout_now, struct_field_names)
    bcc_layout_fp_ints(guard_layout_now, ctor_float_fields_list)
    // Which functions return a Double. The three typed-lowering OFFSET arrays
    // beside it are deliberately NOT folded in: they are source positions in
    // the MERGED text, so appending a comment to any file shifts every offset
    // after it, and the guard would decline on an edit that moves no body's
    // bytes at all. Measured on the compiler's own closure (5242 functions),
    // comment-edited: with them folded in, `offered=4394 recompiled=5155` --
    // the wide lane declined and the build was a cold one in all but name;
    // without them, `recompiled=848`. Same tree, same leaf, one difference.
    // They also do not need to be folded: a replayed body never consults them,
    // and a recompiled one consults them against ITS OWN current offsets,
    // which shift with the same text.
    // What could change an unchanged file's lowering is a cross-file
    // classification change, and those are name-keyed and pinned -- a callee
    // that starts returning Double enters `float_ret_fn_names`, a const that
    // stops being an Int leaves `const_int_names`, a struct field that becomes
    // Double enters `ctor_float_fields`. `body_cache_edit_classes_test.vibe`
    // probes that residue directly rather than leaving it argued.
    bcc_layout_fp_strings(guard_layout_now, float_ret_fn_names)
    // Thunks decide call-vs-value at a reference; a folded const decides the
    // literal a body embeds.
    bcc_layout_fp_strings(guard_layout_now, thunk_names_sorted_shared)
    bcc_layout_fp_strings(guard_layout_now, const_int_names_list)
    bcc_layout_fp_ints(guard_layout_now, const_int_values_list)
    // Generated-builtin indices and the region arena's address. `num_generated`
    // pins their COUNT; these are the assignment.
    bcc_layout_fp_ints(guard_layout_now, [
      rc_drop_idx,
      rc_dup_idx,
      rc_alloc_idx,
      region_ptr_addr,
      region_arr_new_idx,
      region_bytes_new_idx,
      heap_grow_check_idx,
      map_hash_idx,
      map_cap_idx,
      map_build_index_idx,
      map_probe_index_idx,
      map_index_insert_idx
    ])
    // Exception tags: effect `effect_names[i]` routes through tag `3 + i`, so
    // a declared effect added anywhere moves every later `perform`'s tag.
    bcc_layout_fp_strings(guard_layout_now, effect_names_list)
    bcc_layout_fp_strings(guard_layout_now, effect_op_keys_list)
    bcc_layout_fp_ints(guard_layout_now, effect_op_arities_list)
    bcc_layout_fp_bools(guard_layout_now, [has_exceptions])
    // Whole-program return classifications: they decide a call site's shape.
    bcc_layout_fp_strings(guard_layout_now, lc_agg_ret_names)
    bcc_layout_fp_ints(guard_layout_now, lc_agg_ret_infos)
    bcc_layout_fp_strings(guard_layout_now, lc_heap_ret_names)
    bcc_layout_fp_strings(guard_layout_now, lc_scalar_ret_names)
    bcc_layout_fp_strings(guard_layout_now, lc_borrow_ret_names)
    bcc_layout_fp_strings(guard_layout_now, lc_borrow_view_ret)
    bcc_layout_fp_strings(guard_layout_now, lc_borrow_param_user_srt)
    bcc_layout_fp_ints(guard_layout_now, lc_borrow_param_mask)
    // The shared capture-name index a lambda resolves a capture through.
    bcc_layout_fp_strings(guard_layout_now, capture_name_index_shared)
    // Compile modes that change emitted code, and the entry name, which
    // `rc_entry_untag_return` compares each function's own name against.
    bcc_layout_fp_bools(guard_layout_now, [
      enable_rc,
      rc_shadow,
      dbg_line_on,
      coverage,
      library_mode
    ])
    bcc_layout_fp_strings(guard_layout_now, [entry_name])
  } else {
    ()
  }
  LinkedEmissionLayout::{
    capture_names: capture_name_index_shared,
    thunk_names: thunk_names_sorted_shared,
    guard_layout: guard_layout_now
  }
}
