  // #768: reserved immediately after fs_remove; the import emission below must
  // stay in this same order so the index matches the descriptor.
  let fs_mkdir_p_import_idx = if need_fs_mkdir_p_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  // #768: reserved immediately after fs_mkdir_p, in this fixed order; the
  // import emission below must match.
  let fs_mkdir_import_idx = if need_fs_mkdir_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_chdir_import_idx = if need_fs_chdir_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
