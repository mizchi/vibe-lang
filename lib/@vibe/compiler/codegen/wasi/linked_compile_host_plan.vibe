  let stdin_read_stream_import_idx = if need_stdin_read_stream_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let stdout_write_stream_import_idx = if need_stdout_write_stream_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let stdout_write_char_import_idx = if need_stdout_write_char_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  // reserved immediately after stdout_write_char; the import emission below must
  // stay in this same order so the index matches the descriptor.
  let resolve_path_import_idx = if need_resolve_path_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  // #768: reserved immediately after resolve_path; the import emission below
  // must stay in this same order so the index matches the descriptor.
  let fs_remove_import_idx = if need_fs_remove_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  // #2738: reserved immediately after fs_remove; the import emission below must
  // stay in this same order so the index matches the descriptor.
  let fs_remove_file_import_idx = if need_fs_remove_file_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
