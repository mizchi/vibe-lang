/// #644: an Int array of exactly `n` entries, all initialized to `fill`, so
/// callers can index-assign (`Array::set`) into it before the real value at
/// each index is known (linemap_hdrlen_by_bi below: one entry per user
/// function, filled in `ci` order as each function's locals header is
/// assembled).
fn lc_fresh_int_array_of_len(n: Int, fill: Int) -> Array[Int] {
  let arr = lc_fresh_int_array()
  let mut i = 0
  while i < n {
    Array::push(arr, fill)
    i = i + 1
  }
  arr
}

/// #644: append a little-endian 4-byte encoding of `v` to `buf`. Used by the
/// `vibe.linemap` custom section (see below), one of a family of ad hoc
/// raw-int encodings this file already uses for debug sections (compare
/// `vibe.dbgargs`'s address fields a few hundred lines up).
fn bytebuf_push_i32le(buf: Bytes, v: Int) -> Unit {
  bytebuf_push(buf, v&255)
  bytebuf_push(buf, (v>>8)&255)
  bytebuf_push(buf, (v>>16)&255)
  bytebuf_push(buf, (v>>24)&255)
}

/// #1085: builtins whose arg0 is BORROWED (kept in sync with
/// cc_is_borrow_arg0_call in codegen/expr/compile_call.vibe and
/// is_borrow_arg0_call in perceus/perceus.vibe).
fn lc_is_borrow_arg0_call(f: String) -> Bool {
  f == "__index" || f == "Array::get" || f == "Array::length" || f == "Array::set" || f == "Array::push" || f == "ArrayBuilder::push" || f == "StringBuilder::push" || f == "MapBuilder::set" || f == "MapBuilder::has_key" || f == "MapBuilder::get" || f == "Map::get" || f == "Map::keys" || f == "Map::has_key" || f == "Map::has" || f == "Map::set" || f == "Map::size" || f == "Map::values" || f == "Map::delete" || f == "Bytes::push" || f == "Bytes::set" || f == "Bytes::get" || f == "Bytes::length" || f == "MutList::push" || f == "MutList::get" || f == "MutList::length" || f == "MutBytes::push" || f == "MutBytes::length" || f == "FrozenArray::get" || f == "FrozenArray::length" || f == "__rec_field"
}

/// #1085: does `name` have a consuming occurrence OUTSIDE any loop body?
/// The #725 single unconditional epilogue drop for a loop-consumed param
/// is only sound when EVERY consuming occurrence is a loop-borrow site
/// (per-iteration protective dup makes those net-zero, so the param's own
/// reference always survives to the epilogue). A consuming occurrence
/// outside a loop (e.g. `Array::set(buf, i, v)` in a sibling branch of
/// the loop) transfers the own reference on the paths that execute it,
/// and the unconditional drop then over-releases the stored value —
/// use-after-free (issue #1085's minimal repro; the else arm does not
/// even need to run). Occurrence rules mirror consume_count
/// (common_analysis/perceus): borrow-arg0 idents, match/handle
/// scrutinee idents, and call-callee idents do not consume. Loop bodies
/// (EWhile / ELoop / EForIn) are skipped — occurrences there are the
/// loop-borrow sites themselves. Branches use OR (existence), which
/// over-approximates toward suppressing the epilogue drop: the loop-only
/// path then leaks one reference, the safe direction.
fn lc_has_nonloop_consume(e: Expr, name: String) -> Bool {
  match e {
    EIdent(n, _) => n == name,
    ETuple(items) => lc_hnc_any(items, name),
    EArray(items) => lc_hnc_any(items, name),
    ERecord(_, fields, _) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        if lc_has_nonloop_consume(v, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EMap(fields) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        if lc_has_nonloop_consume(v, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EIf(c, t, el) => lc_has_nonloop_consume(c, name) || lc_has_nonloop_consume(t, name) || lc_has_nonloop_consume(el, name),
    ELet(_, v, b, _) => lc_has_nonloop_consume(v, name) || lc_has_nonloop_consume(b, name),
    ELetRec(_, v, b) => lc_has_nonloop_consume(v, name) || lc_has_nonloop_consume(b, name),
    ELetMut(_, v, b, _) => lc_has_nonloop_consume(v, name) || lc_has_nonloop_consume(b, name),
    EAssign(_, v, b) => lc_has_nonloop_consume(v, name) || lc_has_nonloop_consume(b, name),
    EAssignOp(_, _, v, b) => lc_has_nonloop_consume(v, name) || lc_has_nonloop_consume(b, name),
    ESeq(a, b) => lc_has_nonloop_consume(a, name) || lc_has_nonloop_consume(b, name),
    EMatch(s, arms) => {
      let scr = match s {
        EIdent(_, _) => false,
        _ => lc_has_nonloop_consume(s, name)
      }
      let mut found = scr
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ab) = Array::get(arms, i)
        if lc_has_nonloop_consume(ab, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EHandle(s, arms) => {
      let scr = match s {
        EIdent(_, _) => false,
        _ => lc_has_nonloop_consume(s, name)
      }
      let mut found = scr
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ab) = Array::get(arms, i)
        if lc_has_nonloop_consume(ab, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EWhile(c, _) => lc_has_nonloop_consume(c, name),
    ELoop(params, _) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(params) {
        let (_, v) = Array::get(params, i)
        if lc_has_nonloop_consume(v, name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EForIn(_, _, it, _) => lc_has_nonloop_consume(it, name),
    ECall(callee, args, _) => {
      let borrow0 = match callee {
        EIdent(f, _) => lc_is_borrow_arg0_call(f),
        _ => false
      }
      let callee_c = match callee {
        EIdent(_, _) => false,
        _ => lc_has_nonloop_consume(callee, name)
      }
      let mut found = callee_c
      let mut i = 0
      while i < Array::length(args) {
        let skip_borrowed_head = borrow0 && i == 0 && (match Array::get(args, i) {
          EIdent(_, _) => true,
          _ => false
        })
        if skip_borrowed_head {
          ()
        } else if lc_has_nonloop_consume(Array::get(args, i), name) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EBinOp(_, l, r) => lc_has_nonloop_consume(l, name) || lc_has_nonloop_consume(r, name),
    EUnaryOp(_, x) => lc_has_nonloop_consume(x, name),
    EFn(_, _, _, _, _, fb) => lc_has_nonloop_consume(fb, name),
    EDot(x, _, _, _) => lc_has_nonloop_consume(x, name),
    ELabeledArg(_, _, v) => lc_has_nonloop_consume(v, name),
    EReturn(x) => lc_has_nonloop_consume(x, name),
    EBreak(opt) => match opt {
      Some(v) => lc_has_nonloop_consume(v, name),
      None => false
    },
    EContinue(args) => lc_hnc_any(args, name),
    ESpread(x) => lc_has_nonloop_consume(x, name),
    _ => false
  }
}

fn lc_hnc_any(items: Array[Expr], name: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(items) {
    if lc_has_nonloop_consume(Array::get(items, i), name) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #1062: positional field types for a struct declaration's field list,
/// dropping the names -- SEnum/SSuberror variants are already unnamed
/// (Array[TypeExpr]), but SStruct fields carry (name, type) pairs.
fn struct_field_types(sfields: Array[(String, TypeExpr)]) -> Array[TypeExpr] {
  let out = lc_fresh_type_expr_array()
  let mut i = 0
  while i < Array::length(sfields) {
    let (_, ft) = Array::get(sfields, i)
    Array::push(out, ft)
    i = i + 1
  }
  out
}

/// #1062: append `ctor_idx * 64 + field_idx` to `out` for every positional
/// field in `field_types` whose declared type is Double/Float (same TyName
/// check as the annotated-Float/Double-param seeding below). See
/// CompileCtx.ctor_float_fields.
fn push_ctor_float_fields(out: Array[Int], ctor_idx: Int, field_types: Array[TypeExpr]) -> Unit {
  let mut fi = 0
  while fi < Array::length(field_types) {
    match Array::get(field_types, fi) {
      TyName(ftn) => if ftn == "Float" || ftn == "Double" {
        Array::push(out, ctor_idx * 64 + fi)
      } else {
        ()
      },
      _ => ()
    }
    fi = fi + 1
  }
}

fn lc_fresh_string_matrix() -> Array[Array[String]] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

fn gen_heap_grow_check_body() -> Bytes {
  let b = bytebuf_new()
  emit_heap_memory_grow_check(b)
  b
}

/// #805 (ADR-0072): collect the inline-wasm fns (`fn f(..) -> Int = wasm
/// "..."`, carried as the parser-internal `%wasm("<WAT>")` marker body) into
/// parallel name/WAT-text arrays and REPLACE each marker body with a neutral
/// EInt(0) IN PLACE — so every downstream analysis (Perceus plans, borrow/
/// scalar-return classification, string-table collection, coverage) sees an
/// ordinary trivial body and the WAT text never leaks into the data section.
/// The per-fn codegen loop then splices the assembled instruction bytes
/// (compile_inline_wat) instead of running compile_expr for these names.
fn lc_extract_inline_wasm(stmts: Array[Stmt], names: Array[String], wats: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(iw_exp, iw_rec, iw_name, iw_ann, iw_expr) => match iw_expr {
        EFn(iw_tps, iw_tbs, iw_params, iw_ret, iw_eff, iw_body) => match iw_body {
          ECall(iw_cal, iw_args, _) => match iw_cal {
            EIdent(iw_cn, _) => if iw_cn == "%wasm" && Array::length(iw_args) == 1 {
              match Array::get(iw_args, 0) {
                EString(iw_wat) => {
                  Array::push(names, iw_name)
                  Array::push(wats, iw_wat)
                  Array::set(stmts, i, SLet(iw_exp, iw_rec, iw_name, iw_ann, EFn(iw_tps, iw_tbs, iw_params, iw_ret, iw_eff, EInt(0))))
                },
                _ => ()
              }
            } else {
              ()
            },
            _ => ()
          },
          _ => ()
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

/// #805 SIMD locals: assemble an inline-wasm fn's body bytes into `body_buf`
/// and write its extra-local counts (i32, i64, v128) into the 3-slot
/// `iw_extra_cell` -- zeros when the function is not inline wasm (iw_found
/// < 0). The counts travel through a pre-existing cell array (the
/// `lambda_plan_cell` pattern) instead of a fresh binding at the call site:
/// the seed compiler loses a NEW `let` binding introduced at that nesting
/// depth of the flattened module source ("unknown name" on every later
/// reference, tuple/mut/plain-Int alike), while reads through an
/// already-in-scope array provably survive (meta_i32 itself is one).
fn lc_compile_iw_body(body_buf: Bytes, fn_name_dbg: String, iw_wats: Array[String], iw_found: Int, iw_param_names: Array[String], param_count: Int, iw_extra_cell: Array[Int]) -> Unit with Exception {
  Array::set(iw_extra_cell, 0, 0)
  Array::set(iw_extra_cell, 1, 0)
  Array::set(iw_extra_cell, 2, 0)
  if iw_found < 0 {
    ()
  } else {
    // Declared `(local ...)` runs index from param_count (params + the
    // closure-env slot), matching the i32/i64/v128 header runs the meta
    // arrays receive at the code-section assembly.
    let (iw_bytes, iw_n32, iw_n64, iw_nv) = compile_inline_wat_full(fn_name_dbg, Array::get(iw_wats, iw_found), iw_param_names, param_count)
    bytebuf_push_buf(body_buf, iw_bytes)
    Array::set(iw_extra_cell, 0, iw_n32)
    Array::set(iw_extra_cell, 1, iw_n64)
    Array::set(iw_extra_cell, 2, iw_nv)
  }
}

let default_wasi_memory_min_pages = 64

export fn wasi_memory_min_pages_for_heap(heap_start: Int) -> Int {
  let needed_pages = (heap_start + wasm_page_size - 1) / wasm_page_size
  if needed_pages > default_wasi_memory_min_pages {
    needed_pages
  } else {
    default_wasi_memory_min_pages
  }
}

/// ADR-0069: `Unit` in a declared return position — either the canonical
/// TyUnit (`-> ()`) or the named spelling (`-> Unit`, what parse_type produces
/// and what the `fn main {}` desugar emits).
fn linked_type_expr_is_unit(t: TypeExpr) -> Bool {
  match t {
    TyUnit => true,
    TyName(n) => n == "Unit",
    _ => false
  }
}

/// #944 (ADR-0073 stage C, "entry boundary A"): does a declared row text
/// contain the literal effect label "Error" as a whole token? Row text is a
/// comma-separated label list ("Error", "Error, Fs", "Stdout, Error", ...);
/// substring matching alone would false-positive on a user effect named
/// e.g. "ErrorLog", so each comma-separated piece is trimmed and compared
/// exactly.
fn lc_row_has_label(eff: Option[String], label: String) -> Bool {
  match eff {
    Some(row) => {
      let mut found = false
      let mut start = 0
      let n = String::length(row)
      let mut i = 0
      while i <= n {
        let at_sep = if i == n {
          true
        } else {
          String::char_code_at(row, i) == 44
        }
        if at_sep {
          // #1313 rebase fix: compare against the REQUESTED label, with
          // alias-aware equality so `Error` still matches the `Exception`
          // spelling. The rebase resolution had collapsed this to a bare
          // is_exception_effect_name(token) -- ignoring `label` entirely --
          // which made lc_row_has_label(eff, "Async") true only for
          // Error-ish rows: the Async entry boundary was never injected,
          // and gate 77's mixed-convention fixture compiled instead of
          // being rejected (the exact compiler-gate failure on this PR).
          if exception_effect_labels_equal(String::trim(String::substring(row, start, i)), label) {
            found = true
          } else {
            ()
          }
          start = i + 1
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    None => false
  }
}

/// #1461: the requested label is the canonical erased spelling. The comparison
/// inside lc_row_has_label is exception_effect_labels_equal, so a row still
/// spelled `Error` matches this just as it did before the flip.
fn lc_row_has_error(eff: Option[String]) -> Bool {
  lc_row_has_label(eff, "Exception")
}

fn lc_is_stdin_provider_surface(name: String) -> Bool {
  name == "Stdin::read_via_stream" || name == "StdinStream::next" || name == "StdinStream::close" || name == "StdinStream::read_chunk"
}

fn lc_stdin_provider_value_error(name: String) -> String {
  String::concat("stdin provider operations are direct-call-only; wrap `", String::concat(name, "` in an explicitly effectful function"))
}

/// Canonical post-merge validation for #1539. Import value aliases and
/// qualified type heads have already been rewritten to their exact public
/// provider names by the merge boundary. Each such name is legal only as the
/// immediate EIdent callee of a direct ECall; arguments are still traversed.
/// Returning the first source-order error keeps every compile lane on the same
/// actionable diagnostic without rerunning type/effect checking.
fn lc_validate_stdin_provider_expr(expr: Expr) -> String {
  match expr {
    ECall(EIdent(name, _), args, _) => if lc_is_stdin_provider_surface(name) {
      let mut i = 0
      let mut err = ""
      while i < Array::length(args) && err == "" {
        err = lc_validate_stdin_provider_expr(Array::get(args, i))
        i = i + 1
      }
      err
    } else {
      let children = expr_children(expr)
      let mut i = 0
      let mut err = ""
      while i < Array::length(children) && err == "" {
        err = lc_validate_stdin_provider_expr(Array::get(children, i))
        i = i + 1
      }
      err
    },
    EIdent(name, _) => if lc_is_stdin_provider_surface(name) {
      lc_stdin_provider_value_error(name)
    } else {
      ""
    },
    _ => {
      let children = expr_children(expr)
      let mut i = 0
      let mut err = ""
      while i < Array::length(children) && err == "" {
        err = lc_validate_stdin_provider_expr(Array::get(children, i))
        i = i + 1
      }
      err
    }
  }
}

fn lc_validate_stdin_provider_stmts(stmts: Array[Stmt]) -> String {
  let mut i = 0
  let mut err = ""
  while i < Array::length(stmts) && err == "" {
    err = match Array::get(stmts, i) {
      SLet(_, _, _, _, body) => lc_validate_stdin_provider_expr(body),
      SLetMut(_, _, body) => lc_validate_stdin_provider_expr(body),
      STest(_, body) => lc_validate_stdin_provider_expr(body),
      SBench(_, body) => lc_validate_stdin_provider_expr(body),
      SExample(_, body) => lc_validate_stdin_provider_expr(body),
      SExpr(body) => lc_validate_stdin_provider_expr(body),
      SLetPat(_, body) => lc_validate_stdin_provider_expr(body),
      SModule(_, _, inner) => lc_validate_stdin_provider_stmts(inner),
      _ => ""
    }
    i = i + 1
  }
  err
}

/// #1539: direct provider calls are retargeted to compiler-owned wrapper
/// functions because the raw imports do not accept the closure-environment ABI
/// used by ordinary functions. The canonical compile-boundary validator above
/// has rejected every value-position public reference, so this is strictly
/// direct-call lowering and does not provide first-class alias transport.
/// Wrapper bodies alone spell the checker-hidden raw names.
fn lc_inject_stdin_surface_wrappers(stmts: Array[Stmt]) -> Bool {
  let public_names = [
    "Stdin::read_via_stream",
    "StdinStream::next",
    "StdinStream::close",
    "StdinStream::read_chunk"
  ]
  let raw_names = [
    "__stdin_provider_acquire_surface",
    "__stdin_provider_next_surface",
    "__stdin_provider_close_surface",
    "__stdin_provider_read_chunk_surface"
  ]
  let aliases: Array[(String, String)] = [
    (Array::get(public_names, 0), Array::get(raw_names, 0)),
    (Array::get(public_names, 1), Array::get(raw_names, 1)),
    (Array::get(public_names, 2), Array::get(raw_names, 2)),
    (Array::get(public_names, 3), Array::get(raw_names, 3))
  ]
  let mentions = collect_used_builtin_names(stmts, lc_fresh_string_array())
  let needed = Map::has_key(mentions, Array::get(public_names, 0)) || Map::has_key(mentions, Array::get(public_names, 1)) || Map::has_key(mentions, Array::get(public_names, 2)) || Map::has_key(mentions, Array::get(public_names, 3))
  if needed {
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SLet(ex, is_rec, name, ty, body) => Array::set(stmts, i, SLet(ex, is_rec, name, ty, rewrite_import_alias_expr(body, aliases))),
        SLetMut(name, ty, body) => Array::set(stmts, i, SLetMut(name, ty, rewrite_import_alias_expr(body, aliases))),
        STest(name, body) => Array::set(stmts, i, STest(name, rewrite_import_alias_expr(body, aliases))),
        SBench(name, body) => Array::set(stmts, i, SBench(name, rewrite_import_alias_expr(body, aliases))),
        SExpr(body) => Array::set(stmts, i, SExpr(rewrite_import_alias_expr(body, aliases))),
        SLetPat(pat, body) => Array::set(stmts, i, SLetPat(pat, rewrite_import_alias_expr(body, aliases))),
        _ => ()
      }
      i = i + 1
    }
    let no_params: Array[(String, Option[TypeExpr])] = array_empty()
    let next_param: Array[(String, Option[TypeExpr])] = [
      ("__stdin_stream", Some(TyName("StdinStream")))
    ]
    let close_param: Array[(String, Option[TypeExpr])] = [
      ("__stdin_stream", Some(TyName("StdinStream")))
    ]
    let read_chunk_params: Array[(String, Option[TypeExpr])] = [
      ("__stdin_stream", Some(TyName("StdinStream"))),
      ("__stdin_chunk_size", Some(TyName("Int")))
    ]
    let acquire_body = ECall(EIdent("vibe_stdin_provider_acquire_raw", -1), lc_fresh_expr_array(), -1)
    let next_body = ECall(EIdent("vibe_stdin_provider_read_raw", -1), [
      EIdent("__stdin_stream", -1)
    ], -1)
    let close_body = ESeq(ECall(EIdent("vibe_stdin_provider_close_raw", -1), [
      EIdent("__stdin_stream", -1)
    ], -1), EUnit)
    // One-byte String::from_char_code construction preserves every u8 value,
    // including NUL and bytes that are not valid standalone UTF-8. The raw
    // route is validated before conversion so an ABI violation traps instead
    // of being silently truncated by store8.
    let chunk_read = ECall(EIdent("vibe_stdin_provider_read_raw", -1), [
      EIdent("__stdin_stream", -1)
    ], -1)
    let chunk_byte_valid = EBinOp("&&", EBinOp("<=", EInt(0), EIdent("__stdin_chunk_byte", -1)), EBinOp("<=", EIdent("__stdin_chunk_byte", -1), EInt(255)))
    let chunk_push = ESeq(ECall(EIdent("StringBuilder::push", -1), [
      EIdent("__stdin_chunk_builder", -1),
      ECall(EIdent("String::from_char_code", -1), [
        EIdent("__stdin_chunk_byte", -1)
      ], -1)
    ], -1), EAssign("__stdin_chunk_len", EBinOp("+", EIdent("__stdin_chunk_len", -1), EInt(1)), EUnit))
    let chunk_accept = EIf(chunk_byte_valid, chunk_push, ECall(EIdent("assert_true", -1), [
      EBool(false)
    ], -1))
    let chunk_step = ELet("__stdin_chunk_byte", chunk_read, EIf(EBinOp("==", EIdent("__stdin_chunk_byte", -1), EInt(0 - 1)), EAssign("__stdin_chunk_eof", EBool(true), EUnit), chunk_accept), -1)
    let chunk_loop_cond = EBinOp("&&", EBinOp("<", EIdent("__stdin_chunk_len", -1), EIdent("__stdin_chunk_size", -1)), EBinOp("==", EIdent("__stdin_chunk_eof", -1), EBool(false)))
    let chunk_result = EIf(EBinOp("==", EIdent("__stdin_chunk_len", -1), EInt(0)), ECall(EIdent("None", -1), array_empty(), -1), ECall(EIdent("Some", -1), [
      ECall(EIdent("StringBuilder::freeze", -1), [
        EIdent("__stdin_chunk_builder", -1)
      ], -1)
    ], -1))
    let positive_pull = ELet("__stdin_chunk_builder", ECall(EIdent("StringBuilder::new", -1), array_empty(), -1), ELetMut("__stdin_chunk_len", EInt(0), ELetMut("__stdin_chunk_eof", EBool(false), ESeq(EWhile(chunk_loop_cond, chunk_step), chunk_result), -1), -1), -1)
    let read_chunk_ret = TyApp("Option", [
      TyName("String")
    ])
    let read_chunk_body = EIf(EBinOp("<=", EIdent("__stdin_chunk_size", -1), EInt(0)), ECall(EIdent("None", -1), array_empty(), -1), positive_pull)
    Array::push(stmts, SLet(false, false, Array::get(raw_names, 0), None, EFn(lc_fresh_string_array(), array_empty(), no_params, Some(TyName("StdinStream")), None, acquire_body)))
    Array::push(stmts, SLet(false, false, Array::get(raw_names, 1), None, EFn(lc_fresh_string_array(), array_empty(), next_param, Some(TyName("Int")), None, next_body)))
    Array::push(stmts, SLet(false, false, Array::get(raw_names, 2), None, EFn(lc_fresh_string_array(), array_empty(), close_param, Some(TyName("Unit")), None, close_body)))
    Array::push(stmts, SLet(false, false, Array::get(raw_names, 3), None, EFn(lc_fresh_string_array(), array_empty(), read_chunk_params, Some(read_chunk_ret), None, read_chunk_body)))
  } else {
    ()
  }
  needed
}

fn lc_entry_declares_async(stmts: Array[Stmt], entry_name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, EFn(_, _, _, _, eff, _)) => if name == entry_name && lc_row_has_label(eff, "Async") {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// #944 (ADR-0073 stage C): the runtime outermost Error handler. When the
/// ENTRY function's own declared row carries `Error` (`fn main with
/// { Error }` is allowed under checked-Error), an escaping `Exception::Throw`
/// must become a diagnosed, unsuccessful process outcome -- not a raw
/// `WebAssembly.Exception` leaking past the entry into the host. Rewrites
/// the entry function's body, post-check/pre-codegen, into
///
///   handle { <body> } with Exception {
///     Throw(msg) => { Stderr::...(diagnostic); 1 }
///   }
///
/// so the existing (well-exercised) `with Exception` handle lowering does all
/// the work -- no new codegen. The arm never resumes (Error is
/// non-resumable, #640), so replay semantics are irrelevant here. Entries
/// with no `Error` in their row are untouched: under default-on checked
/// Error (stage B) they cannot leak a Throw in the first place. The
/// `__no_entry__` test-runner lane never matches an SLet by this name, so
/// test `_start` synthesis (whose trap-on-assert semantics the unit-test
/// runner depends on) is untouched.
fn lc_wrap_entry_error_boundary(stmts: Array[Stmt], entry_name: String) -> Unit {
  let mut i = 0
  let mut wrapped_any = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, body)) => if name == entry_name && lc_row_has_error(eff) {
        // #1372 review (Codex P1): the bound payload is NOT necessarily a
        // String. ADR-0085's runtime carries a single abortive tag with no
        // kind, so this erased `Exception::Throw` arm also catches every typed
        // `Exception[E]` -- including the `TaskError` that #1324's
        // `TaskGroup::run` throws. Writing that enum pointer straight to
        // `Stderr::write_stream` decoded it as a packed `(ptr<<32)|len`
        // string and dumped the whole data segment.
        //
        // #1374: the throw site now records the payload's static type name in
        // the exception-kind cell, so this arm can tell the cases apart:
        //
        //   String / Int   `__to_string` is FAITHFUL -- ADR-0058's int/string
        //                  discrimination (`64 <= ptr && ptr + len <=
        //                  memory_size`) is the identity on a real string and
        //                  renders an int as its decimal. Unchanged output.
        //   ""             the throw site could not resolve a type name, so
        //                  the payload might be either. Keep #1375's
        //                  conservative `__to_string`: bounded, never a read
        //                  of arbitrary memory.
        //   anything else  a value whose bytes are NOT text (an enum, a
        //                  struct). Print the KIND, not a decimal that reads
        //                  like a message.
        //
        // #1392 slice 3: the throw site now ALSO renders the payload, where its
        // static type is still known, so the "anything else" case prints the
        // VALUE (`Failed("io")`) rather than just its type. The kind branch
        // survives as the fallback for a rendered string the throw site could
        // not produce -- a payload whose type resolved to a declared type with
        // no `T::to_string` renders through the pointer heuristic, and printing
        // `<Kind>` is still better than a decimal there.
        let kind_ident = EIdent("__entry_err_kind", -1)
        let msg_ident = EIdent("__entry_err_rendered", -1)
        let printable = EBinOp("||", ECall(EIdent("String::equals", -1), [
          kind_ident,
          EString("")
        ], -1), EBinOp("||", ECall(EIdent("String::equals", -1), [
          kind_ident,
          EString("String")
        ], -1), ECall(EIdent("String::equals", -1), [
          kind_ident,
          EString("Int")
        ], -1)))
        // A non-empty slot means the throw site found a STRUCTURAL renderer --
        // it writes nothing when all it could produce was the pointer
        // heuristic's own output, precisely so this test can be a plain
        // emptiness check rather than an impossible "is this decimal real"
        // one.
        let rendered_ok = EBinOp("!=", ECall(EIdent("String::length", -1), [
          msg_ident
        ], -1), EInt(0))
        let text = EIf(printable, ECall(EIdent("__to_string", -1), [
          EIdent("__entry_err_msg", -1)
        ], -1), EIf(rendered_ok, msg_ident, ECall(EIdent("String::concat", -1), [
          EString("<"),
          ECall(EIdent("String::concat", -1), [
            kind_ident,
            EString(">")
          ], -1)
        ], -1)))
        let diag = ELet("__entry_err_kind", exn_kind_read_expr(), ELet("__entry_err_rendered", exn_msg_read_expr(), ESeq(ECall(EIdent("Stderr::write_stream", -1), [
          EString("vibe: uncaught error: ")
        ], -1), ESeq(ECall(EIdent("Stderr::write_stream", -1), [
          text
        ], -1), ESeq(ECall(EIdent("Stderr::write_stream", -1), [
          EString("\n")
        ], -1), EInt(1)))), -1), -1)
        let wrapped = EHandle(body, [
          (PCtor("Exception::Throw", [
            PBind("__entry_err_msg")
          ]), diag)
        ])
        Array::set(stmts, i, SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, wrapped)))
        wrapped_any = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  // #1374: this pass runs AFTER desugar_trait_dicts, so the cell it just
  // synthesized a reader for is only guaranteed to exist for a program that
  // itself throws. An entry whose `Error` row comes from an imported module's
  // throw is exactly the case where it would not.
  if wrapped_any {
    ensure_exn_kind_cell(stmts)
  } else {
    ()
  }
}

/// ADR-0089 Decision 1, increment 1 (#1218): make `sleep` a real
/// `perform Async::Suspend` when the ENTRY's declared row carries `Async`,
/// and give that program a default (entry-boundary) Async handler so the
/// unhandled sequential case keeps today's blocking behavior.
///
/// The nominal-`Async`-row `sleep` builtin is the label pun ADR-0089
/// Decision 1 exists to remove: its row cannot be discharged by a handler
/// (it is not a `perform` -- measured in #1227), and it is opaque to the
/// ADR-0076 suspend lowering (scps_calls_ok admits performs, pure
/// builtins, ctors, needing/effect-free functions -- a row-carrying host
/// builtin is none of those, re-measured 2026-08-01 after the #1230 loop
/// widening moved that wall). Both problems disappear when the call IS a
/// perform.
///
/// Mechanism (all-AST-synthesis, no checker change -- `sleep` keeps its
/// builtin type `(Int) -> Unit with Async` at check time):
///
///   1. a top-level `let sleep = (ms) -> Unit with Async { if 0 < ms
///      { let _ = perform Async::Suspend(0 - ms) } }` is injected;
///      compile_call's prefer-bound rule (the same one a user-defined
///      `await` rides) then routes every existing call site through it.
///      The negative payload is @vibex/concurrent's sleep-debt convention
///      (0 = yield, 1 = poll, negative = debt), so inside a
///      `spawn_suspend` task the injected perform parks the task exactly
///      like `sleep_wait` does today.
///   2. `effect Async { Suspend(Int) -> Int }` is injected when the
///      merged program does not already declare it (the effect passes
///      need the declaration's operation list).
///   3. the entry body is wrapped in `handle { .. } with Async {
///      Suspend(req) => { if req < 0 { sleep_blocking(0 - req) }; resume(0)
///      } }` -- same synthesis point and shape as the #944 Error boundary
///      above. The arm is TAIL-RESUMPTIVE: in an entry-row-Async program
///      with no suspend-class handler of its own this compiles on the
///      cheap evidence path, and `sleep_blocking` (the row-free host
///      sleep) preserves the blocking semantics. A program that ALSO uses
///      suspend-class Async handlers (e.g. TaskGroup) under an
///      Async-carrying entry row is rejected by the existing
///      convention-mixing guard -- handle Async yourself before the entry
///      in that case (fixture err_async_boundary_mixed_convention pins the
///      message).
///
/// Keyed on the entry row (like lc_wrap_entry_error_boundary): programs
/// whose entry row has no `Async` -- including the `__no_entry__`
/// test-runner lane and library_mode -- are untouched and keep the
/// blocking `vibe.sleep` builtin lowering. A user-defined top-level
/// `sleep` also disables the injection (their definition already shadows
/// the builtin).
/// Does pattern `p` bind the name `sleep` (an arm under it sees a
/// different `sleep`)?
/// Does `p` bind `target`? Generalized from the `sleep`-only original when
/// ADR-0089 (c)'s named-host-future collector needed the same shadow test
/// for its own name (#1337 Codex review).
fn lc_pat_binds_name(p: Pat, target: String) -> Bool {
  match p {
    PBind(n) => n == target,
    PCtor(_, ps) => lc_pats_bind_name(ps, target),
    PTuple(ps) => lc_pats_bind_name(ps, target),
    POr(a, b) => lc_pat_binds_name(a, target) || lc_pat_binds_name(b, target),
    PStruct(_, fields) => {
      let mut i = 0
      let mut hit = false
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        if lc_pat_binds_name(fp, target) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    _ => false
  }
}

fn lc_pats_bind_name(ps: Array[Pat], target: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(ps) {
    if lc_pat_binds_name(Array::get(ps, i), target) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn lc_pat_binds_sleep(p: Pat) -> Bool {
  lc_pat_binds_name(p, "sleep")
}

/// Rewrite calls to the BUILTIN `sleep` into calls to the injected
/// `__slp_perform` (see lc_inject_async_sleep_boundary). `active` goes
/// false for the subtree under any binder that shadows the name -- a local
/// `sleep` binding is the user's own value and must keep resolving to it.
///
/// Why a rename instead of just naming the injected fn `sleep` (which the
/// prefer-bound rule would route to): a top-level fn LITERALLY NAMED after
/// a row-carrying builtin miscompiles today -- the evidence pass classifies
/// the call site by the builtin's nominal row while codegen dispatches to
/// the bound fn, and the emitted call's arity disagrees ("not enough
/// arguments on the stack for call"). Measured on the pre-change compiler
/// with a hand-written `fn sleep`; latent for any user doing the same
/// (recorded in #1218). The fresh name sidesteps that double
/// classification entirely.
fn lc_rename_sleep_calls(e: Expr, active: Bool) -> Expr {
  match e {
    ECall(callee, args, off) => {
      let new_args = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(new_args, lc_rename_sleep_calls(Array::get(args, i), active))
        i = i + 1
      }
      let new_callee = match callee {
        EIdent(nm, coff) => if active && nm == "sleep" {
          EIdent("__slp_perform", coff)
        } else {
          callee
        },
        _ => lc_rename_sleep_calls(callee, active)
      }
      ECall(new_callee, new_args, off)
    },
    ELet(x, v, b, off) => ELet(x, lc_rename_sleep_calls(v, active), lc_rename_sleep_calls(b, active && x != "sleep"), off),
    ELetMut(x, v, b, off) => ELetMut(x, lc_rename_sleep_calls(v, active), lc_rename_sleep_calls(b, active && x != "sleep"), off),
    ELetRec(x, v, b) => {
      let inner = active && x != "sleep"
      ELetRec(x, lc_rename_sleep_calls(v, inner), lc_rename_sleep_calls(b, inner))
    },
    ESeq(a, b) => ESeq(lc_rename_sleep_calls(a, active), lc_rename_sleep_calls(b, active)),
    EIf(c, t, el) => EIf(lc_rename_sleep_calls(c, active), lc_rename_sleep_calls(t, active), lc_rename_sleep_calls(el, active)),
    EMatch(s, arms) => {
      let out: Array[(Pat, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (mp, mb) = Array::get(arms, i)
        Array::push(out, (mp, lc_rename_sleep_calls(mb, active && !lc_pat_binds_sleep(mp))))
        i = i + 1
      }
      EMatch(lc_rename_sleep_calls(s, active), out)
    },
    EHandle(b, arms) => {
      let out: Array[(Pat, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (mp, mb) = Array::get(arms, i)
        Array::push(out, (mp, lc_rename_sleep_calls(mb, active && !lc_pat_binds_sleep(mp))))
        i = i + 1
      }
      EHandle(lc_rename_sleep_calls(b, active), out)
    },
    EFn(tps, tbs, params, ret, eff, b) => {
      let mut shadowed = false
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        if pn == "sleep" {
          shadowed = true
        } else {
          ()
        }
        i = i + 1
      }
      EFn(tps, tbs, params, ret, eff, lc_rename_sleep_calls(b, active && !shadowed))
    },
    EWhile(c, b) => EWhile(lc_rename_sleep_calls(c, active), lc_rename_sleep_calls(b, active)),
    EForIn(x, ix, it, b) => {
      let inner = active && x != "sleep"
      EForIn(x, ix, lc_rename_sleep_calls(it, active), lc_rename_sleep_calls(b, inner))
    },
    ELoop(pairs, b) => {
      let out: Array[(String, Expr)] = array_empty()
      let mut inner = active
      let mut i = 0
      while i < Array::length(pairs) {
        let (pn, pv) = Array::get(pairs, i)
        if pn == "sleep" {
          inner = false
        } else {
          ()
        }
        Array::push(out, (pn, lc_rename_sleep_calls(pv, active)))
        i = i + 1
      }
      ELoop(out, lc_rename_sleep_calls(b, inner))
    },
    EBinOp(op, l, r) => EBinOp(op, lc_rename_sleep_calls(l, active), lc_rename_sleep_calls(r, active)),
    EUnaryOp(op, a) => EUnaryOp(op, lc_rename_sleep_calls(a, active)),
    EAssign(x, v, b) => EAssign(x, lc_rename_sleep_calls(v, active), lc_rename_sleep_calls(b, active)),
    EAssignOp(n, op, v, b) => EAssignOp(n, op, lc_rename_sleep_calls(v, active), lc_rename_sleep_calls(b, active)),
    EReturn(a) => EReturn(lc_rename_sleep_calls(a, active)),
    EDot(o, f, m, off) => EDot(lc_rename_sleep_calls(o, active), f, m, off),
    ELabeledArg(l, s, v) => ELabeledArg(l, s, lc_rename_sleep_calls(v, active)),
    EBreak(opt) => match opt {
      Some(a) => EBreak(Some(lc_rename_sleep_calls(a, active))),
      None => e
    },
    EContinue(args) => {
      let out = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(out, lc_rename_sleep_calls(Array::get(args, i), active))
        i = i + 1
      }
      EContinue(out)
    },
    ETuple(items) => {
      let out = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(items) {
        Array::push(out, lc_rename_sleep_calls(Array::get(items, i), active))
        i = i + 1
      }
      ETuple(out)
    },
    EArray(items) => {
      let out = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(items) {
        Array::push(out, lc_rename_sleep_calls(Array::get(items, i), active))
        i = i + 1
      }
      EArray(out)
    },
    ERecord(nm, fields, off) => {
      let out: Array[(String, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fn2, fv) = Array::get(fields, i)
        Array::push(out, (fn2, lc_rename_sleep_calls(fv, active)))
        i = i + 1
      }
      ERecord(nm, out, off)
    },
    EMap(fields) => {
      let out: Array[(String, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fk, fv) = Array::get(fields, i)
        Array::push(out, (fk, lc_rename_sleep_calls(fv, active)))
        i = i + 1
      }
      EMap(out)
    },
    ESpread(a) => ESpread(lc_rename_sleep_calls(a, active)),
    _ => e
  }
}

/// Rewrite calls to a surface builtin into calls to its injected fn (the
/// stream sibling of lc_rename_sleep_calls, same shadow discipline: `active`
/// goes false under any binder that shadows the source name). The fresh name
/// sidesteps the nominal-row double-classification hazard documented on
/// lc_rename_sleep_calls.
///
/// Parameterized over (surface, injected) so the host read
/// `host_stream_next` -> `__hs_next`, host close
/// `host_stream_close` -> `__hs_close`, and eager builtin
/// `Stream::next` -> `__sn_next` share one TOTAL walk. A second copy of a
/// 150-line total walk is exactly the kind of thing that drifts and silently
/// stops covering a container.
fn lc_rename_hs_call(e: Expr, active: Bool, from_name: String, to_name: String) -> Expr {
  match e {
    ECall(callee, args, off) => {
      let new_args = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(new_args, lc_rename_hs_call(Array::get(args, i), active, from_name, to_name))
        i = i + 1
      }
      let new_callee = match callee {
        EIdent(nm, coff) => if active && nm == from_name {
          EIdent(to_name, coff)
        } else {
          callee
        },
        _ => lc_rename_hs_call(callee, active, from_name, to_name)
      }
      ECall(new_callee, new_args, off)
    },
    ELet(x, v, b, off) => ELet(x, lc_rename_hs_call(v, active, from_name, to_name), lc_rename_hs_call(b, active && x != from_name, from_name, to_name), off),
    ELetMut(x, v, b, off) => ELetMut(x, lc_rename_hs_call(v, active, from_name, to_name), lc_rename_hs_call(b, active && x != from_name, from_name, to_name), off),
    ELetRec(x, v, b) => {
      let inner = active && x != from_name
      ELetRec(x, lc_rename_hs_call(v, inner, from_name, to_name), lc_rename_hs_call(b, inner, from_name, to_name))
    },
    ESeq(a, b) => ESeq(lc_rename_hs_call(a, active, from_name, to_name), lc_rename_hs_call(b, active, from_name, to_name)),
    EIf(c, t, el) => EIf(lc_rename_hs_call(c, active, from_name, to_name), lc_rename_hs_call(t, active, from_name, to_name), lc_rename_hs_call(el, active, from_name, to_name)),
    EMatch(s, arms) => {
      let out: Array[(Pat, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (mp, mb) = Array::get(arms, i)
        Array::push(out, (mp, lc_rename_hs_call(mb, active && !lc_pat_binds_name(mp, from_name), from_name, to_name)))
        i = i + 1
      }
      EMatch(lc_rename_hs_call(s, active, from_name, to_name), out)
    },
    EHandle(b, arms) => {
      let out: Array[(Pat, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (mp, mb) = Array::get(arms, i)
        Array::push(out, (mp, lc_rename_hs_call(mb, active && !lc_pat_binds_name(mp, from_name), from_name, to_name)))
        i = i + 1
      }
      EHandle(lc_rename_hs_call(b, active, from_name, to_name), out)
    },
    EFn(tps, tbs, params, ret, eff, b) => {
      let mut shadowed = false
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        if pn == from_name {
          shadowed = true
        } else {
          ()
        }
        i = i + 1
      }
      EFn(tps, tbs, params, ret, eff, lc_rename_hs_call(b, active && !shadowed, from_name, to_name))
    },
    EWhile(c, b) => EWhile(lc_rename_hs_call(c, active, from_name, to_name), lc_rename_hs_call(b, active, from_name, to_name)),
    EForIn(x, ix, it, b) => {
      let inner = active && x != from_name
      EForIn(x, ix, lc_rename_hs_call(it, active, from_name, to_name), lc_rename_hs_call(b, inner, from_name, to_name))
    },
    ELoop(pairs, b) => {
      let out: Array[(String, Expr)] = array_empty()
      let mut inner = active
      let mut i = 0
      while i < Array::length(pairs) {
        let (pn, pv) = Array::get(pairs, i)
        if pn == from_name {
          inner = false
        } else {
          ()
        }
        Array::push(out, (pn, lc_rename_hs_call(pv, active, from_name, to_name)))
        i = i + 1
      }
      ELoop(out, lc_rename_hs_call(b, inner, from_name, to_name))
    },
    EBinOp(op, l, r) => EBinOp(op, lc_rename_hs_call(l, active, from_name, to_name), lc_rename_hs_call(r, active, from_name, to_name)),
    EUnaryOp(op, a) => EUnaryOp(op, lc_rename_hs_call(a, active, from_name, to_name)),
    EAssign(x, v, b) => EAssign(x, lc_rename_hs_call(v, active, from_name, to_name), lc_rename_hs_call(b, active, from_name, to_name)),
    EAssignOp(n, op, v, b) => EAssignOp(n, op, lc_rename_hs_call(v, active, from_name, to_name), lc_rename_hs_call(b, active, from_name, to_name)),
    EReturn(a) => EReturn(lc_rename_hs_call(a, active, from_name, to_name)),
    EDot(o, f, m, off) => EDot(lc_rename_hs_call(o, active, from_name, to_name), f, m, off),
    ELabeledArg(l, s, v) => ELabeledArg(l, s, lc_rename_hs_call(v, active, from_name, to_name)),
    EBreak(opt) => match opt {
      Some(a) => EBreak(Some(lc_rename_hs_call(a, active, from_name, to_name))),
      None => e
    },
    EContinue(args) => {
      let out = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(out, lc_rename_hs_call(Array::get(args, i), active, from_name, to_name))
        i = i + 1
      }
      EContinue(out)
    },
    ETuple(items) => {
      let out = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(items) {
        Array::push(out, lc_rename_hs_call(Array::get(items, i), active, from_name, to_name))
        i = i + 1
      }
      ETuple(out)
    },
    EArray(items) => {
      let out = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(items) {
        Array::push(out, lc_rename_hs_call(Array::get(items, i), active, from_name, to_name))
        i = i + 1
      }
      EArray(out)
    },
    ERecord(nm, fields, off) => {
      let out: Array[(String, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fn2, fv) = Array::get(fields, i)
        Array::push(out, (fn2, lc_rename_hs_call(fv, active, from_name, to_name)))
        i = i + 1
      }
      ERecord(nm, out, off)
    },
    EMap(fields) => {
      let out: Array[(String, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fk, fv) = Array::get(fields, i)
        Array::push(out, (fk, lc_rename_hs_call(fv, active, from_name, to_name)))
        i = i + 1
      }
      EMap(out)
    },
    ESpread(a) => ESpread(lc_rename_hs_call(a, active, from_name, to_name)),
    _ => e
  }
}

fn lc_rename_hs_next_calls(e: Expr, active: Bool) -> Expr {
  lc_rename_hs_call(e, active, "host_stream_next", "__hs_next")
}

/// #1536 (a), eager Stream slice: the Array-backed `Stream::next` builtin
/// lowers too late in compile_call for suspend CPS to classify it. Retarget
/// it to the synthetic row-free top-level fn before that pass, just as the
/// host-stream read surface retargets to `__hs_next`.
fn lc_rename_stream_next_calls(e: Expr, active: Bool, target: String) -> Expr {
  lc_rename_hs_call(e, active, "Stream::next", target)
}

/// ADR-0089 Decision 3 follow-up (#1218): the CLOSE retarget, run as its own
/// pass right after the read one. Separate passes rather than one walk with
/// two name tests because shadowing is per-name: `let host_stream_next = ..`
/// must not disable the close rewrite, and vice versa.
fn lc_rename_hs_close_calls(e: Expr, active: Bool) -> Expr {
  lc_rename_hs_call(e, active, "host_stream_close", "__hs_close")
}

/// The close retarget, skipped entirely when the program never closes. The
/// skip is not an optimisation: `__hs_close` is only injected under the same
/// condition, so rewriting a call to it when it does not exist would produce
/// an unresolved name instead of the precise compile_call diagnostic.
fn lc_rename_hs_maybe_close(enabled: Bool, e: Expr, active: Bool) -> Expr {
  if enabled {
    lc_rename_hs_close_calls(e, active)
  } else {
    e
  }
}

/// Deep scan: does `e` contain a `handle ... with Async` (an EHandle with a
/// qualified `Async::<Op>` arm pattern)? Increment 2's codegen key: such a
/// handle discharges the builtin `Async` row at check time
/// (checker_effects.vibe's EHandle arm), so the sleep->perform retarget
/// must fire for these programs too or the user's handler would never see
/// the operations it demonstrably handles.
fn lc_expr_has_async_handle(e: Expr) -> Bool {
  match e {
    EHandle(b, arms) => {
      let mut hit = false
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ab) = Array::get(arms, i)
        match p {
          PCtor(cname, _) => if String::starts_with(cname, "Async::") {
            hit = true
          } else {
            ()
          },
          _ => ()
        }
        if lc_expr_has_async_handle(ab) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit || lc_expr_has_async_handle(b)
    },
    ELet(_, v, b, _) => lc_expr_has_async_handle(v) || lc_expr_has_async_handle(b),
    ELetMut(_, v, b, _) => lc_expr_has_async_handle(v) || lc_expr_has_async_handle(b),
    ELetRec(_, v, b) => lc_expr_has_async_handle(v) || lc_expr_has_async_handle(b),
    ESeq(a, b) => lc_expr_has_async_handle(a) || lc_expr_has_async_handle(b),
    EIf(c, t, el) => lc_expr_has_async_handle(c) || lc_expr_has_async_handle(t) || lc_expr_has_async_handle(el),
    EMatch(s, arms) => {
      let mut hit = lc_expr_has_async_handle(s)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ab) = Array::get(arms, i)
        if lc_expr_has_async_handle(ab) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EFn(_, _, _, _, _, b) => lc_expr_has_async_handle(b),
    EWhile(c, b) => lc_expr_has_async_handle(c) || lc_expr_has_async_handle(b),
    EForIn(_, _, it, b) => lc_expr_has_async_handle(it) || lc_expr_has_async_handle(b),
    ELoop(pairs, b) => {
      let mut hit = lc_expr_has_async_handle(b)
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, pv) = Array::get(pairs, i)
        if lc_expr_has_async_handle(pv) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    // Codex P2 on #1312: record/map fields and break/continue values are
    // expression containers too -- a handler stored in a struct field must
    // key the machinery, or the checker-accepted program silently keeps
    // the blocking builtin.
    ERecord(_, fields, _) => lc_pairs_have_async_handle(fields),
    EMap(fields) => lc_pairs_have_async_handle(fields),
    EBreak(opt) => match opt {
      Some(a) => lc_expr_has_async_handle(a),
      None => false
    },
    EContinue(args) => lc_exprs_have_async_handle(args),
    ECall(callee, args, _) => {
      let mut hit = lc_expr_has_async_handle(callee)
      let mut i = 0
      while i < Array::length(args) {
        if lc_expr_has_async_handle(Array::get(args, i)) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EBinOp(_, l, r) => lc_expr_has_async_handle(l) || lc_expr_has_async_handle(r),
    EUnaryOp(_, a) => lc_expr_has_async_handle(a),
    EAssign(_, v, b) => lc_expr_has_async_handle(v) || lc_expr_has_async_handle(b),
    EAssignOp(_, _, v, b) => lc_expr_has_async_handle(v) || lc_expr_has_async_handle(b),
    EReturn(a) => lc_expr_has_async_handle(a),
    EDot(o, _, _, _) => lc_expr_has_async_handle(o),
    ELabeledArg(_, _, v) => lc_expr_has_async_handle(v),
    ETuple(items) => lc_exprs_have_async_handle(items),
    EArray(items) => lc_exprs_have_async_handle(items),
    ESpread(a) => lc_expr_has_async_handle(a),
    _ => false
  }
}

fn lc_exprs_have_async_handle(es: Array[Expr]) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(es) {
    if lc_expr_has_async_handle(Array::get(es, i)) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn lc_pairs_have_async_handle(pairs: Array[(String, Expr)]) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, i)
    if lc_expr_has_async_handle(v) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// Deep scan: does `e` contain a call whose callee is the bare identifier
/// `target`? Shadow-BLIND on purpose -- this is only the cheap enablement
/// key for the sleep / host-future machinery below (the retarget walk
/// itself is shadow-aware), and a false positive merely enables machinery
/// that then rewrites nothing.
fn lc_expr_calls_name(e: Expr, target: String) -> Bool {
  match e {
    ECall(callee, args, _) => {
      let callee_hit = match callee {
        EIdent(nm, _) => nm == target,
        _ => lc_expr_calls_name(callee, target)
      }
      let mut hit = callee_hit
      let mut i = 0
      while i < Array::length(args) {
        if lc_expr_calls_name(Array::get(args, i), target) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    ELet(_, v, b, _) => lc_expr_calls_name(v, target) || lc_expr_calls_name(b, target),
    ELetMut(_, v, b, _) => lc_expr_calls_name(v, target) || lc_expr_calls_name(b, target),
    ELetRec(_, v, b) => lc_expr_calls_name(v, target) || lc_expr_calls_name(b, target),
    ESeq(a, b) => lc_expr_calls_name(a, target) || lc_expr_calls_name(b, target),
    EIf(c, t, el) => lc_expr_calls_name(c, target) || lc_expr_calls_name(t, target) || lc_expr_calls_name(el, target),
    EMatch(s, arms) => {
      let mut hit = lc_expr_calls_name(s, target)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ab) = Array::get(arms, i)
        if lc_expr_calls_name(ab, target) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EHandle(b, arms) => {
      let mut hit = lc_expr_calls_name(b, target)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ab) = Array::get(arms, i)
        if lc_expr_calls_name(ab, target) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EFn(_, _, _, _, _, b) => lc_expr_calls_name(b, target),
    EWhile(c, b) => lc_expr_calls_name(c, target) || lc_expr_calls_name(b, target),
    EForIn(_, _, it, b) => lc_expr_calls_name(it, target) || lc_expr_calls_name(b, target),
    ELoop(pairs, b) => {
      let mut hit = lc_expr_calls_name(b, target)
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, pv) = Array::get(pairs, i)
        if lc_expr_calls_name(pv, target) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    EBinOp(_, l, r) => lc_expr_calls_name(l, target) || lc_expr_calls_name(r, target),
    EUnaryOp(_, a) => lc_expr_calls_name(a, target),
    EAssign(_, v, b) => lc_expr_calls_name(v, target) || lc_expr_calls_name(b, target),
    EAssignOp(_, _, v, b) => lc_expr_calls_name(v, target) || lc_expr_calls_name(b, target),
    EReturn(a) => lc_expr_calls_name(a, target),
    EDot(o, _, _, _) => lc_expr_calls_name(o, target),
    ELabeledArg(_, _, v) => lc_expr_calls_name(v, target),
    ETuple(items) => lc_exprs_call_name(items, target),
    EArray(items) => lc_exprs_call_name(items, target),
    // #1337 Codex review: these four containers were missing, so a call
    // nested in a record/map literal or a break/continue argument was
    // invisible to every key computed from this walk. Harmless for the
    // sleep key (a miss only leaves the blocking builtin in place), but NOT
    // for the host-future key, which must agree with
    // lc_expr_collect_hf_names -- reserving a per-name import while the
    // boundary machinery stays off leaves the await with nothing to settle
    // it.
    ERecord(_, fields, _) => lc_fields_call_name(fields, target),
    EMap(fields) => lc_fields_call_name(fields, target),
    EBreak(opt) => match opt {
      Some(a) => lc_expr_calls_name(a, target),
      None => false
    },
    EContinue(args) => lc_exprs_call_name(args, target),
    ESpread(a) => lc_expr_calls_name(a, target),
    _ => false
  }
}

fn lc_fields_call_name(fields: Array[(String, Expr)], target: String) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(fields) {
    let (_, fv) = Array::get(fields, i)
    if lc_expr_calls_name(fv, target) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn lc_exprs_call_name(es: Array[Expr], target: String) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(es) {
    if lc_expr_calls_name(Array::get(es, i), target) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn lc_expr_calls_sleep(e: Expr) -> Bool {
  lc_expr_calls_name(e, "sleep")
}

/// ADR-0089 step 4 (#1218): enablement key for the host-future boundary
/// machinery -- does the program call `host_future_get` anywhere?
fn lc_expr_calls_host_future(e: Expr) -> Bool {
  // ADR-0089 (c) (#1218): `host_future_named` fires the SAME machinery --
  // the boundary's `__entry_settle` waitable arm and the wait import are
  // shared by every host future, named or not; only the per-name GET import
  // differs.
  lc_expr_calls_name(e, "host_future_get") || lc_expr_calls_name(e, "host_future_named")
}

/// ADR-0089 (c) (#1218): every component import name a `host_future_named`
/// call in `e` asks for, appended to `out`.
///
/// Two properties this walk MUST have, both learned the hard way (Codex
/// review on #1337):
///
///  - TOTAL over expression containers. A missed container is not a missed
///    optimisation here: compile_call still lowers the nested call to
///    `vibe_hf_get_raw$<name>`, but with no name collected there is no
///    import and no func-table entry, so the program fails to compile
///    (measured: `let r = record { p: host_future_named("price") }` gave
///    `undefined variable (local): vibe_hf_get_raw$price`). Hence this
///    mirrors lc_rename_sleep_calls -- the file's one traversal that is
///    already total -- rather than the deliberately partial
///    lc_expr_calls_name.
///  - SHADOW-AWARE (`active`). A local named `host_future_named` makes the
///    call an ordinary closure call that compile_call does not lower, so
///    collecting its argument would reserve a component import the program
///    never uses -- and an unused import is still one the host must
///    satisfy. Same `active` discipline, and the same binder set, as
///    lc_rename_sleep_calls.
///
/// A non-literal argument is left alone here and rejected with a precise
/// message by compile_call's lowering, which is the one place that knows it
/// is compiling that call.
fn lc_expr_collect_hf_names(e: Expr, active: Bool, out: Array[String]) -> Unit {
  match e {
    ECall(callee, args, _) => {
      match callee {
        EIdent(nm, _) => if active && nm == "host_future_named" && Array::length(args) == 1 {
          match Array::get(args, 0) {
            EString(s) => Array::push(out, s),
            _ => ()
          }
        } else {
          ()
        },
        _ => lc_expr_collect_hf_names(callee, active, out)
      }
      lc_exprs_collect_hf_names(args, active, out)
    },
    ELet(x, v, b, _) => {
      lc_expr_collect_hf_names(v, active, out)
      lc_expr_collect_hf_names(b, active && x != "host_future_named", out)
    },
    ELetMut(x, v, b, _) => {
      lc_expr_collect_hf_names(v, active, out)
      lc_expr_collect_hf_names(b, active && x != "host_future_named", out)
    },
    ELetRec(x, v, b) => {
      let inner = active && x != "host_future_named"
      lc_expr_collect_hf_names(v, inner, out)
      lc_expr_collect_hf_names(b, inner, out)
    },
    ESeq(a, b) => {
      lc_expr_collect_hf_names(a, active, out)
      lc_expr_collect_hf_names(b, active, out)
    },
    EIf(c, t, el) => {
      lc_expr_collect_hf_names(c, active, out)
      lc_expr_collect_hf_names(t, active, out)
      lc_expr_collect_hf_names(el, active, out)
    },
    EMatch(s, arms) => {
      lc_expr_collect_hf_names(s, active, out)
      lc_arms_collect_hf_names(arms, active, out)
    },
    EHandle(b, arms) => {
      lc_expr_collect_hf_names(b, active, out)
      lc_arms_collect_hf_names(arms, active, out)
    },
    EFn(_, _, params, _, _, b) => {
      let mut shadowed = false
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        if pn == "host_future_named" {
          shadowed = true
        } else {
          ()
        }
        i = i + 1
      }
      lc_expr_collect_hf_names(b, active && !shadowed, out)
    },
    EWhile(c, b) => {
      lc_expr_collect_hf_names(c, active, out)
      lc_expr_collect_hf_names(b, active, out)
    },
    EForIn(x, _, it, b) => {
      lc_expr_collect_hf_names(it, active, out)
      lc_expr_collect_hf_names(b, active && x != "host_future_named", out)
    },
    ELoop(pairs, b) => {
      let mut inner = active
      let mut i = 0
      while i < Array::length(pairs) {
        let (pn, pv) = Array::get(pairs, i)
        if pn == "host_future_named" {
          inner = false
        } else {
          ()
        }
        lc_expr_collect_hf_names(pv, active, out)
        i = i + 1
      }
      lc_expr_collect_hf_names(b, inner, out)
    },
    EBinOp(_, l, r) => {
      lc_expr_collect_hf_names(l, active, out)
      lc_expr_collect_hf_names(r, active, out)
    },
    EUnaryOp(_, a) => lc_expr_collect_hf_names(a, active, out),
    EAssign(_, v, b) => {
      lc_expr_collect_hf_names(v, active, out)
      lc_expr_collect_hf_names(b, active, out)
    },
    EAssignOp(_, _, v, b) => {
      lc_expr_collect_hf_names(v, active, out)
      lc_expr_collect_hf_names(b, active, out)
    },
    EReturn(a) => lc_expr_collect_hf_names(a, active, out),
    EDot(o, _, _, _) => lc_expr_collect_hf_names(o, active, out),
    ELabeledArg(_, _, v) => lc_expr_collect_hf_names(v, active, out),
    EBreak(opt) => match opt {
      Some(a) => lc_expr_collect_hf_names(a, active, out),
      None => ()
    },
    EContinue(args) => lc_exprs_collect_hf_names(args, active, out),
    ETuple(items) => lc_exprs_collect_hf_names(items, active, out),
    EArray(items) => lc_exprs_collect_hf_names(items, active, out),
    ERecord(_, fields, _) => lc_fields_collect_hf_names(fields, active, out),
    EMap(fields) => lc_fields_collect_hf_names(fields, active, out),
    ESpread(a) => lc_expr_collect_hf_names(a, active, out),
    _ => ()
  }
}

fn lc_exprs_collect_hf_names(es: Array[Expr], active: Bool, out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(es) {
    lc_expr_collect_hf_names(Array::get(es, i), active, out)
    i = i + 1
  }
}

fn lc_fields_collect_hf_names(fields: Array[(String, Expr)], active: Bool, out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(fields) {
    let (_, fv) = Array::get(fields, i)
    lc_expr_collect_hf_names(fv, active, out)
    i = i + 1
  }
}

fn lc_arms_collect_hf_names(arms: Array[(Pat, Expr)], active: Bool, out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (ap, ab) = Array::get(arms, i)
    lc_expr_collect_hf_names(ab, active && !lc_pat_binds_name(ap, "host_future_named"), out)
    i = i + 1
  }
}

/// Codex P2 on #1339: does the program define a TOP-LEVEL binding with this
/// name? compile_call's prefer-bound rule routes calls to such a definition
/// instead of the builtin lowering, so the import collectors below must not
/// mint component imports from them (an unused `vibe.host_*` import would
/// force an unrelated program into the host-future/stream composition).
/// LOCAL bindings that shadow the name stay shadow-blind here -- the
/// documented hf-collector tradeoff: compile_call resolves those correctly
/// and the worst case is an unused import, never a wrong call target.
fn lc_program_defines_top_level(stmts: Array[Stmt], name: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, nm, _, _) => if nm == name {
        found = true
      } else {
        ()
      },
      SLetMut(nm, _, _) => if nm == name {
        found = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

/// ADR-0089 (c) (#1218): the program's named host futures, deduplicated and
/// SORTED. The order decides core import indices and the composer's
/// component import order, so it must depend only on the name SET -- not on
/// where in the program each call happens to sit (which would make the same
/// program compile to different bytes after an unrelated reorder).
fn lc_collect_host_future_names(stmts: Array[Stmt]) -> Array[String] {
  if lc_program_defines_top_level(stmts, "host_future_named") {
    array_empty()
  } else {
    lc_collect_host_future_names_go(stmts)
  }
}

fn lc_collect_host_future_names_go(stmts: Array[Stmt]) -> Array[String] {
  let raw = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, v) => lc_expr_collect_hf_names(v, true, raw),
      SLetMut(_, _, v) => lc_expr_collect_hf_names(v, true, raw),
      SExpr(v) => lc_expr_collect_hf_names(v, true, raw),
      STest(_, v) => lc_expr_collect_hf_names(v, true, raw),
      SBench(_, v) => lc_expr_collect_hf_names(v, true, raw),
      _ => ()
    }
    i = i + 1
  }
  let sorted = sorted_names_of(raw)
  let out = array_empty()
  let mut k = 0
  while k < Array::length(sorted) {
    let nm = Array::get(sorted, k)
    if k == 0 || Array::get(sorted, k - 1) != nm {
      Array::push(out, nm)
    } else {
      ()
    }
    k = k + 1
  }
  out
}

/// ADR-0089 Decision 3 (#1218): base of the reserved STREAM band in the
/// `Async::Suspend` payload convention. Existing bands: negative = sleep
/// debt, 0 = cooperative yield, 1 = poll wait, [2, 1025] = host-FUTURE
/// waitable (handle + 2; the composer's adapter caps handles at 1023).
/// A stream read parks with `handle + lc_hs_req_base()`, so the stream
/// band is [2048, 3071] -- disjoint from the future band by construction,
/// not by runtime discipline.
fn lc_hs_req_base() -> Int {
  2048
}

/// ADR-0089 Decision 3 (#1218): enablement key for the host-stream boundary
/// machinery -- does the program call `host_stream_named` (create),
/// `host_stream_next` (read) or `host_stream_close` (drop) anywhere? Any of
/// them implies the boundary's stream settle arm and the shared
/// `vibe.host_stream_read` import.
fn lc_expr_calls_host_stream(e: Expr) -> Bool {
  lc_expr_calls_name(e, "host_stream_named") || lc_expr_calls_name(e, "host_stream_next") || lc_expr_calls_name(e, "host_stream_close")
}

/// ADR-0089 Decision 3 (#1218): every component import name a
/// `host_stream_named` call in `e` asks for, appended to `out`. The stream
/// sibling of lc_expr_collect_hf_names, with the SAME two hard
/// requirements that walk documents (#1337/#1339 Codex reviews): TOTAL
/// over expression containers (a missed container is a missing import and
/// a compile failure, not a missed optimisation) and SHADOW-AWARE
/// (`active` goes false under any binder named `host_stream_named` --
/// compile_call routes those calls to the binding, so collecting their
/// argument would mint an import the program never uses). A non-literal
/// argument is left alone here and rejected with a precise message by
/// compile_call's lowering.
fn lc_expr_collect_hs_names(e: Expr, active: Bool, out: Array[String]) -> Unit {
  match e {
    ECall(callee, args, _) => {
      match callee {
        EIdent(nm, _) => if active && nm == "host_stream_named" && Array::length(args) == 1 {
          match Array::get(args, 0) {
            EString(s) => Array::push(out, s),
            _ => ()
          }
        } else {
          ()
        },
        _ => lc_expr_collect_hs_names(callee, active, out)
      }
      lc_exprs_collect_hs_names(args, active, out)
    },
    ELet(x, v, b, _) => {
      lc_expr_collect_hs_names(v, active, out)
      lc_expr_collect_hs_names(b, active && x != "host_stream_named", out)
    },
    ELetMut(x, v, b, _) => {
      lc_expr_collect_hs_names(v, active, out)
      lc_expr_collect_hs_names(b, active && x != "host_stream_named", out)
    },
    ELetRec(x, v, b) => {
      let inner = active && x != "host_stream_named"
      lc_expr_collect_hs_names(v, inner, out)
      lc_expr_collect_hs_names(b, inner, out)
    },
    ESeq(a, b) => {
      lc_expr_collect_hs_names(a, active, out)
      lc_expr_collect_hs_names(b, active, out)
    },
    EIf(c, t, el) => {
      lc_expr_collect_hs_names(c, active, out)
      lc_expr_collect_hs_names(t, active, out)
      lc_expr_collect_hs_names(el, active, out)
    },
    EMatch(s, arms) => {
      lc_expr_collect_hs_names(s, active, out)
      lc_arms_collect_hs_names(arms, active, out)
    },
    EHandle(b, arms) => {
      lc_expr_collect_hs_names(b, active, out)
      lc_arms_collect_hs_names(arms, active, out)
    },
    EFn(_, _, params, _, _, b) => {
      let mut shadowed = false
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        if pn == "host_stream_named" {
          shadowed = true
        } else {
          ()
        }
        i = i + 1
      }
      lc_expr_collect_hs_names(b, active && !shadowed, out)
    },
    EWhile(c, b) => {
      lc_expr_collect_hs_names(c, active, out)
      lc_expr_collect_hs_names(b, active, out)
    },
    EForIn(x, _, it, b) => {
      lc_expr_collect_hs_names(it, active, out)
      lc_expr_collect_hs_names(b, active && x != "host_stream_named", out)
    },
    ELoop(pairs, b) => {
      let mut inner = active
      let mut i = 0
      while i < Array::length(pairs) {
        let (pn, pv) = Array::get(pairs, i)
        if pn == "host_stream_named" {
          inner = false
        } else {
          ()
        }
        lc_expr_collect_hs_names(pv, active, out)
        i = i + 1
      }
      lc_expr_collect_hs_names(b, inner, out)
    },
    EBinOp(_, l, r) => {
      lc_expr_collect_hs_names(l, active, out)
      lc_expr_collect_hs_names(r, active, out)
    },
    EUnaryOp(_, a) => lc_expr_collect_hs_names(a, active, out),
    EAssign(_, v, b) => {
      lc_expr_collect_hs_names(v, active, out)
      lc_expr_collect_hs_names(b, active, out)
    },
    EAssignOp(_, _, v, b) => {
      lc_expr_collect_hs_names(v, active, out)
      lc_expr_collect_hs_names(b, active, out)
    },
    EReturn(a) => lc_expr_collect_hs_names(a, active, out),
    EDot(o, _, _, _) => lc_expr_collect_hs_names(o, active, out),
    ELabeledArg(_, _, v) => lc_expr_collect_hs_names(v, active, out),
    EBreak(opt) => match opt {
      Some(a) => lc_expr_collect_hs_names(a, active, out),
      None => ()
    },
    EContinue(args) => lc_exprs_collect_hs_names(args, active, out),
    ETuple(items) => lc_exprs_collect_hs_names(items, active, out),
    EArray(items) => lc_exprs_collect_hs_names(items, active, out),
    ERecord(_, fields, _) => lc_fields_collect_hs_names(fields, active, out),
    EMap(fields) => lc_fields_collect_hs_names(fields, active, out),
    ESpread(a) => lc_expr_collect_hs_names(a, active, out),
    _ => ()
  }
}

fn lc_exprs_collect_hs_names(es: Array[Expr], active: Bool, out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(es) {
    lc_expr_collect_hs_names(Array::get(es, i), active, out)
    i = i + 1
  }
}

fn lc_fields_collect_hs_names(fields: Array[(String, Expr)], active: Bool, out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(fields) {
    let (_, fv) = Array::get(fields, i)
    lc_expr_collect_hs_names(fv, active, out)
    i = i + 1
  }
}

fn lc_arms_collect_hs_names(arms: Array[(Pat, Expr)], active: Bool, out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(arms) {
    let (ap, ab) = Array::get(arms, i)
    lc_expr_collect_hs_names(ab, active && !lc_pat_binds_name(ap, "host_stream_named"), out)
    i = i + 1
  }
}

/// ADR-0089 Decision 3 (#1218): the program's named host streams,
/// deduplicated and SORTED -- same order discipline as
/// lc_collect_host_future_names (core import indices and the composer's
/// component import order depend only on the name SET), same top-level
/// shadow guard (Codex P2 on #1339).
fn lc_collect_host_stream_names(stmts: Array[Stmt]) -> Array[String] {
  if lc_program_defines_top_level(stmts, "host_stream_named") {
    array_empty()
  } else {
    lc_collect_host_stream_names_go(stmts)
  }
}

fn lc_collect_host_stream_names_go(stmts: Array[Stmt]) -> Array[String] {
  let raw = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, v) => lc_expr_collect_hs_names(v, true, raw),
      SLetMut(_, _, v) => lc_expr_collect_hs_names(v, true, raw),
      SExpr(v) => lc_expr_collect_hs_names(v, true, raw),
      STest(_, v) => lc_expr_collect_hs_names(v, true, raw),
      SBench(_, v) => lc_expr_collect_hs_names(v, true, raw),
      _ => ()
    }
    i = i + 1
  }
  let sorted = sorted_names_of(raw)
  let out = array_empty()
  let mut k = 0
  while k < Array::length(sorted) {
    let nm = Array::get(sorted, k)
    if k == 0 || Array::get(sorted, k - 1) != nm {
      Array::push(out, nm)
    } else {
      ()
    }
    k = k + 1
  }
  out
}

/// Program-level version of lc_expr_calls_host_future, for the passes that
/// need the key BEFORE lc_inject_async_sleep_boundary's own scan runs
/// (await_poll_pass selects the waitable-aware __aw_poll form with it).
fn lc_stmts_call_host_future(stmts: Array[Stmt]) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(stmts) {
    let se = match Array::get(stmts, i) {
      SLet(_, _, _, _, v) => lc_expr_calls_host_future(v),
      SLetMut(_, _, v) => lc_expr_calls_host_future(v),
      SExpr(v) => lc_expr_calls_host_future(v),
      STest(_, v) => lc_expr_calls_host_future(v),
      SBench(_, v) => lc_expr_calls_host_future(v),
      _ => false
    }
    if se {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// #1536 (a), eager Stream slice: the same program-level key as the host
/// boundary machinery, but for `Stream::next`'s row-free synthetic retarget.
/// The rewrite itself is shadow-aware; this key may only over-inject an unused
/// private fn when a shadowed spelling appears.
fn lc_stmts_call_stream_next(stmts: Array[Stmt]) -> Bool {
  let mut hit = false
  let mut i = 0
  while i < Array::length(stmts) {
    let se = match Array::get(stmts, i) {
      SLet(_, _, _, _, v) => lc_expr_calls_name(v, "Stream::next"),
      SLetMut(_, _, v) => lc_expr_calls_name(v, "Stream::next"),
      SExpr(v) => lc_expr_calls_name(v, "Stream::next"),
      STest(_, v) => lc_expr_calls_name(v, "Stream::next"),
      SBench(_, v) => lc_expr_calls_name(v, "Stream::next"),
      _ => false
    }
    if se {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// True when `target` appears as a binder or identifier reference. The
/// retarget's synthetic target must avoid both: a duplicate top-level binding
/// changes an existing definition, while a nested binding captures the newly
/// rewritten call. This deliberately walks every expression shape, rather
/// than treating the `__sn_next` spelling as a private namespace.
fn lc_pat_mentions_name(p: Pat, target: String) -> Bool {
  match p {
    PBind(n) => n == target,
    PCtor(_, ps) => lc_pats_bind_name(ps, target),
    PTuple(ps) => lc_pats_bind_name(ps, target),
    POr(a, b) => lc_pat_mentions_name(a, target) || lc_pat_mentions_name(b, target),
    PStruct(_, fields) => {
      let mut i = 0
      let mut hit = false
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        if lc_pat_mentions_name(fp, target) {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    _ => false
  }
}

fn lc_expr_mentions_name(e: Expr, target: String) -> Bool {
  match e {
    EIdent(n, _) => n == target,
    EFn(_, _, params, _, _, b) => {
      let mut hit = lc_expr_mentions_name(b, target)
      let mut i = 0
      while i < Array::length(params) {
        let (pn, _) = Array::get(params, i)
        if pn == target {
          hit = true
        } else {
          ()
        }
        i = i + 1
      }
      hit
    },
    ELet(n, v, b, _) => n == target || lc_expr_mentions_name(v, target) || lc_expr_mentions_name(b, target),
    ELetMut(n, v, b, _) => n == target || lc_expr_mentions_name(v, target) || lc_expr_mentions_name(b, target),
    ELetRec(n, v, b) => n == target || lc_expr_mentions_name(v, target) || lc_expr_mentions_name(b, target),
    ESeq(a, b) => lc_expr_mentions_name(a, target) || lc_expr_mentions_name(b, target),
    EIf(c, t, el) => lc_expr_mentions_name(c, target) || lc_expr_mentions_name(t, target) || lc_expr_mentions_name(el, target),
    EMatch(s, arms) => lc_expr_mentions_name(s, target) || lc_arms_mention_name(arms, target),
    EHandle(b, arms) => lc_expr_mentions_name(b, target) || lc_arms_mention_name(arms, target),
    EWhile(c, b) => lc_expr_mentions_name(c, target) || lc_expr_mentions_name(b, target),
    EForIn(n, ix, it, b) => n == target || lc_option_name_equals(ix, target) || lc_expr_mentions_name(it, target) || lc_expr_mentions_name(b, target),
    ELoop(pairs, b) => lc_pairs_mention_name(pairs, target) || lc_expr_mentions_name(b, target),
    EAssign(n, v, b) => n == target || lc_expr_mentions_name(v, target) || lc_expr_mentions_name(b, target),
    EAssignOp(n, _, v, b) => n == target || lc_expr_mentions_name(v, target) || lc_expr_mentions_name(b, target),
    EReturn(a) => lc_expr_mentions_name(a, target),
    EDot(o, _, _, _) => lc_expr_mentions_name(o, target),
    ECall(callee, args, _) => lc_expr_mentions_name(callee, target) || lc_exprs_mention_name(args, target),
    EBinOp(_, l, r) => lc_expr_mentions_name(l, target) || lc_expr_mentions_name(r, target),
    EUnaryOp(_, a) => lc_expr_mentions_name(a, target),
    ELabeledArg(_, _, v) => lc_expr_mentions_name(v, target),
    EBreak(opt) => match opt {
      Some(a) => lc_expr_mentions_name(a, target),
      None => false
    },
    EContinue(args) => lc_exprs_mention_name(args, target),
    ETuple(items) => lc_exprs_mention_name(items, target),
    EArray(items) => lc_exprs_mention_name(items, target),
    ERecord(_, fields, _) => lc_fields_mention_name(fields, target),
    EMap(fields) => lc_fields_mention_name(fields, target),
    ESpread(a) => lc_expr_mentions_name(a, target),
    _ => false
  }
}

fn lc_exprs_mention_name(es: Array[Expr], target: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(es) {
    if lc_expr_mentions_name(Array::get(es, i), target) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn lc_arms_mention_name(arms: Array[(Pat, Expr)], target: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(arms) {
    let (p, b) = Array::get(arms, i)
    if lc_pat_mentions_name(p, target) || lc_expr_mentions_name(b, target) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn lc_pairs_mention_name(pairs: Array[(String, Expr)], target: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(pairs) {
    let (n, v) = Array::get(pairs, i)
    if n == target || lc_expr_mentions_name(v, target) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn lc_fields_mention_name(fields: Array[(String, Expr)], target: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    if lc_expr_mentions_name(v, target) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn lc_option_name_equals(opt: Option[String], target: String) -> Bool {
  match opt {
    Some(n) => n == target,
    None => false
  }
}

fn lc_stmts_mention_name(stmts: Array[Stmt], target: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(stmts) {
    let mentioned = match Array::get(stmts, i) {
      SLet(_, _, n, _, e) => n == target || lc_expr_mentions_name(e, target),
      SLetMut(n, _, e) => n == target || lc_expr_mentions_name(e, target),
      SExpr(e) => lc_expr_mentions_name(e, target),
      STest(_, e) => lc_expr_mentions_name(e, target),
      SBench(_, e) => lc_expr_mentions_name(e, target),
      _ => false
    }
    if mentioned {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn lc_fresh_stream_next_target(stmts: Array[Stmt]) -> String {
  let mut suffix = 0
  let mut target = ""
  while target == "" {
    let candidate = if suffix == 0 {
      "__sn_next"
    } else {
      String::concat("__sn_next_", __to_string(suffix))
    }
    if lc_stmts_mention_name(stmts, candidate) {
      suffix = suffix + 1
    } else {
      target = candidate
    }
  }
  target
}

/// #1536 (a), eager Stream slice: make `Stream::next` visible as a concrete
/// row-free top-level call before suspend CPS evaluates eligibility. The
/// target is fresh against every user binding and reference, so rewriting
/// cannot capture a local `__sn_next*` binding. Its ready Future cell is
/// constructed directly: `Future::ready` is user-shadowable and therefore
/// cannot be used inside a synthetic body.
fn lc_inject_stream_next_retarget(stmts: Array[Stmt]) -> Unit {
  // compile_call prefers a real top-level binding over builtin lowering. A
  // user-defined nominal `Stream` therefore owns its generated
  // `Stream::next` method; retargeting that spelling would silently replace
  // the user's iterator semantics with the eager Array-backed builtin.
  if !lc_stmts_call_stream_next(stmts) || lc_program_defines_top_level(stmts, "Stream::next") {
    ()
  } else {
    let target = lc_fresh_stream_next_target(stmts)
    let sn_s = EIdent("__sn_s", -1)
    let sn_option = EIf(ECall(EIdent("lt", -1), [
      EInt(0),
      ECall(EIdent("Array::length", -1), [
        sn_s
      ], -1)
    ], -1), ECall(EIdent("Some", -1), [
      ECall(EIdent("Array::get", -1), [
        sn_s,
        EInt(0)
      ], -1)
    ], -1), ECall(EIdent("None", -1), array_empty(), -1))
    let sn_body = EArray([
      EInt(0),
      sn_option
    ])
    let sn_params: Array[(String, Option[TypeExpr])] = [
      ("__sn_s", None)
    ]
    Array::push(stmts, SLet(false, false, target, None, EFn(lc_fresh_string_array(), array_empty(), sn_params, None, None, sn_body)))
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SLet(ex, isrec, nm, ty, expr) => if nm == target {
          ()
        } else {
          Array::set(stmts, i, SLet(ex, isrec, nm, ty, lc_rename_stream_next_calls(expr, true, target)))
        },
        SLetMut(nm, ty, expr) => {
          Array::set(stmts, i, SLetMut(nm, ty, lc_rename_stream_next_calls(expr, true, target)))
        },
        SExpr(expr) => {
          Array::set(stmts, i, SExpr(lc_rename_stream_next_calls(expr, true, target)))
        },
        STest(nm, expr) => {
          Array::set(stmts, i, STest(nm, lc_rename_stream_next_calls(expr, true, target)))
        },
        SBench(nm, expr) => {
          Array::set(stmts, i, SBench(nm, lc_rename_stream_next_calls(expr, true, target)))
        },
        _ => ()
      }
      i = i + 1
    }
  }
}

/// ADR-0089 (#1218, resolve -> direct wake): can this program call the
/// @vibex/concurrent direct-wake await hooks? Both names must be callable
/// -- as linked imports (the auto-want in linked_artifacts registers them
/// whenever the entry imports anything from a file exporting them) or as
/// local top-level defs (single-file fixtures). Requiring the PAIR keeps
/// the failure mode one-sided: a notify without registrations is a no-op,
/// while a registration without any notify channel would lean on the
/// pump's fallback valve every round.
fn lc_waiter_hooks_available(stmts: Array[Stmt], linked_imports: Array[(String, String, Int, Int)]) -> Bool {
  let mut has_wait = false
  let mut has_notify = false
  let mut li = 0
  while li < Array::length(linked_imports) {
    let (_, lname, _, _) = Array::get(linked_imports, li)
    if lname == "__aw_wait" {
      has_wait = true
    } else {
      ()
    }
    if lname == "__aw_notify_resolve" {
      has_notify = true
    } else {
      ()
    }
    li = li + 1
  }
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      SLet(_, _, nm, _, _) => {
        if nm == "__aw_wait" {
          has_wait = true
        } else {
          ()
        }
        if nm == "__aw_notify_resolve" {
          has_notify = true
        } else {
          ()
        }
      },
      _ => ()
    }
    si = si + 1
  }
  has_wait && has_notify
}

/// Codex P1 on #1312: the SCOPED sleep retarget for programs whose entry
/// row does NOT carry Async (so no boundary handler is installed). A
/// program-wide rewrite there is unsound: a `handle ... with Async`
/// anywhere enabled it, and a sleep in a function never driven by that
/// handler (e.g. an Async-row `fn delay` called from a row-free main)
/// became a perform NOTHING handles -- where the builtin used to block
/// correctly. This walker rewrites only the positions whose performs are
/// guaranteed a handler:
///
///   - the lexical BODY of a `handle ... with Async` (the handler itself),
///   - the body of an Async-ROW closure LITERAL (Vertical B step-splits
///     those, and their steps bubble to whichever handler drives them --
///     spawn_suspend's task bodies are exactly this shape).
///
/// Everything else keeps the blocking builtin, i.e. exactly the
/// pre-ADR-0089-D1 behavior. Under an Async-row entry the caller uses the
/// full walk instead: the injected boundary makes program-wide rewriting
/// sound there.
fn lc_rename_sleep_scoped(e: Expr) -> Expr {
  match e {
    EHandle(b, arms) => {
      let mut is_async_handle = false
      let out: Array[(Pat, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ab) = Array::get(arms, i)
        match p {
          PCtor(cname, _) => if String::starts_with(cname, "Async::") {
            is_async_handle = true
          } else {
            ()
          },
          _ => ()
        }
        Array::push(out, (p, lc_rename_sleep_scoped(ab)))
        i = i + 1
      }
      if is_async_handle {
        EHandle(lc_rename_sleep_calls(b, true), out)
      } else {
        EHandle(lc_rename_sleep_scoped(b), out)
      }
    },
    EFn(tps, tbs, params, ret, eff, b) => if lc_row_has_label(eff, "Async") {
      EFn(tps, tbs, params, ret, eff, lc_rename_sleep_calls(b, true))
    } else {
      EFn(tps, tbs, params, ret, eff, lc_rename_sleep_scoped(b))
    },
    ELet(x, v, b, off) => ELet(x, lc_rename_sleep_scoped(v), lc_rename_sleep_scoped(b), off),
    ELetMut(x, v, b, off) => ELetMut(x, lc_rename_sleep_scoped(v), lc_rename_sleep_scoped(b), off),
    ELetRec(x, v, b) => ELetRec(x, lc_rename_sleep_scoped(v), lc_rename_sleep_scoped(b)),
    ESeq(a, b) => ESeq(lc_rename_sleep_scoped(a), lc_rename_sleep_scoped(b)),
    EIf(c, t, el) => EIf(lc_rename_sleep_scoped(c), lc_rename_sleep_scoped(t), lc_rename_sleep_scoped(el)),
    EMatch(s, arms) => {
      let out: Array[(Pat, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (mp, mb) = Array::get(arms, i)
        Array::push(out, (mp, lc_rename_sleep_scoped(mb)))
        i = i + 1
      }
      EMatch(lc_rename_sleep_scoped(s), out)
    },
    EWhile(c, b) => EWhile(lc_rename_sleep_scoped(c), lc_rename_sleep_scoped(b)),
    EForIn(x, ix, it, b) => EForIn(x, ix, lc_rename_sleep_scoped(it), lc_rename_sleep_scoped(b)),
    ELoop(pairs, b) => {
      let out: Array[(String, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(pairs) {
        let (pn, pv) = Array::get(pairs, i)
        Array::push(out, (pn, lc_rename_sleep_scoped(pv)))
        i = i + 1
      }
      ELoop(out, lc_rename_sleep_scoped(b))
    },
    ECall(callee, args, off) => {
      let out = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(out, lc_rename_sleep_scoped(Array::get(args, i)))
        i = i + 1
      }
      ECall(lc_rename_sleep_scoped(callee), out, off)
    },
    EBinOp(op, l, r) => EBinOp(op, lc_rename_sleep_scoped(l), lc_rename_sleep_scoped(r)),
    EUnaryOp(op, a) => EUnaryOp(op, lc_rename_sleep_scoped(a)),
    EAssign(x, v, b) => EAssign(x, lc_rename_sleep_scoped(v), lc_rename_sleep_scoped(b)),
    EAssignOp(n, op, v, b) => EAssignOp(n, op, lc_rename_sleep_scoped(v), lc_rename_sleep_scoped(b)),
    EReturn(a) => EReturn(lc_rename_sleep_scoped(a)),
    EDot(o, f, m, off) => EDot(lc_rename_sleep_scoped(o), f, m, off),
    ELabeledArg(l, s, v) => ELabeledArg(l, s, lc_rename_sleep_scoped(v)),
    EBreak(opt) => match opt {
      Some(a) => EBreak(Some(lc_rename_sleep_scoped(a))),
      None => e
    },
    EContinue(args) => {
      let out = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(args) {
        Array::push(out, lc_rename_sleep_scoped(Array::get(args, i)))
        i = i + 1
      }
      EContinue(out)
    },
    ETuple(items) => {
      let out = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(items) {
        Array::push(out, lc_rename_sleep_scoped(Array::get(items, i)))
        i = i + 1
      }
      ETuple(out)
    },
    EArray(items) => {
      let out = lc_fresh_expr_array()
      let mut i = 0
      while i < Array::length(items) {
        Array::push(out, lc_rename_sleep_scoped(Array::get(items, i)))
        i = i + 1
      }
      EArray(out)
    },
    ERecord(nm, fields, off) => {
      let out: Array[(String, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fn2, fv) = Array::get(fields, i)
        Array::push(out, (fn2, lc_rename_sleep_scoped(fv)))
        i = i + 1
      }
      ERecord(nm, out, off)
    },
    EMap(fields) => {
      let out: Array[(String, Expr)] = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fk, fv) = Array::get(fields, i)
        Array::push(out, (fk, lc_rename_sleep_scoped(fv)))
        i = i + 1
      }
      EMap(out)
    },
    ESpread(a) => ESpread(lc_rename_sleep_scoped(a)),
    _ => e
  }
}

fn lc_expr_has_spawn_suspend(e: Expr) -> Bool {
  match e {
    ECall(EIdent(name, _), args, _) => {
      if name == "TaskGroup::spawn_suspend" || name == "spawn_suspend" {
        true
      } else {
        lc_exprs_have_spawn_suspend(args)
      }
    },
    ECall(callee, args, _) => lc_expr_has_spawn_suspend(callee) || lc_exprs_have_spawn_suspend(args),
    ELet(_, value, body, _) => lc_expr_has_spawn_suspend(value) || lc_expr_has_spawn_suspend(body),
    ELetMut(_, value, body, _) => lc_expr_has_spawn_suspend(value) || lc_expr_has_spawn_suspend(body),
    ELetRec(_, value, body) => lc_expr_has_spawn_suspend(value) || lc_expr_has_spawn_suspend(body),
    ESeq(a, b) => lc_expr_has_spawn_suspend(a) || lc_expr_has_spawn_suspend(b),
    EIf(c, t, el) => lc_expr_has_spawn_suspend(c) || lc_expr_has_spawn_suspend(t) || lc_expr_has_spawn_suspend(el),
    EFn(_, _, _, _, _, body) => lc_expr_has_spawn_suspend(body),
    // #1342: the arms below were missing, which made the guard depend on WHERE
    // the call sits rather than whether it is there. Measured: `let h =
    // TaskGroup::spawn_suspend(..)` was found and rejected, while
    // `TaskGroup::spawn_suspend(..) + n` -- the same program, the call moved
    // into an operand -- compiled. A partial walk is the worst shape for a
    // guard: it reads as "this is checked" while answering a narrower question.
    EBinOp(_, l, r) => lc_expr_has_spawn_suspend(l) || lc_expr_has_spawn_suspend(r),
    EUnaryOp(_, a) => lc_expr_has_spawn_suspend(a),
    EAssign(_, v, b) => lc_expr_has_spawn_suspend(v) || lc_expr_has_spawn_suspend(b),
    EAssignOp(_, _, v, b) => lc_expr_has_spawn_suspend(v) || lc_expr_has_spawn_suspend(b),
    EWhile(c, b) => lc_expr_has_spawn_suspend(c) || lc_expr_has_spawn_suspend(b),
    EForIn(_, _, it, b) => lc_expr_has_spawn_suspend(it) || lc_expr_has_spawn_suspend(b),
    ELoop(pairs, b) => lc_pairs_have_spawn_suspend(pairs) || lc_expr_has_spawn_suspend(b),
    EMatch(sc, arms) => lc_expr_has_spawn_suspend(sc) || lc_arms_have_spawn_suspend(arms),
    EHandle(b, arms) => lc_expr_has_spawn_suspend(b) || lc_arms_have_spawn_suspend(arms),
    EReturn(a) => lc_expr_has_spawn_suspend(a),
    EBreak(opt) => match opt {
      Some(a) => lc_expr_has_spawn_suspend(a),
      None => false
    },
    EContinue(args) => lc_exprs_have_spawn_suspend(args),
    ETuple(items) => lc_exprs_have_spawn_suspend(items),
    EArray(items) => lc_exprs_have_spawn_suspend(items),
    ERecord(_, fields, _) => lc_pairs_have_spawn_suspend(fields),
    EMap(fields) => lc_pairs_have_spawn_suspend(fields),
    ESpread(a) => lc_expr_has_spawn_suspend(a),
    EDot(o, _, _, _) => lc_expr_has_spawn_suspend(o),
    ELabeledArg(_, _, v) => lc_expr_has_spawn_suspend(v),
    _ => false
  }
}

fn lc_pairs_have_spawn_suspend(pairs: Array[(String, Expr)]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, i)
    if lc_expr_has_spawn_suspend(v) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn lc_arms_have_spawn_suspend(arms: Array[(Pat, Expr)]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(arms) {
    let (_, b) = Array::get(arms, i)
    if lc_expr_has_spawn_suspend(b) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn lc_exprs_have_spawn_suspend(es: Array[Expr]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(es) {
    if lc_expr_has_spawn_suspend(Array::get(es, i)) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn lc_inject_async_sleep_boundary(stmts: Array[Stmt], entry_name: String) -> String {
  let mut entry_has_async = false
  let mut user_defines_sleep = false
  let mut has_async_decl = false
  let mut has_async_handle = false
  let mut calls_sleep = false
  let mut calls_host_future = false
  let mut user_defines_host_future = false
  let mut calls_host_stream = false
  // ADR-0089 Decision 3 follow-up (#1218): tracked SEPARATELY from
  // calls_host_stream, because the injected `__hs_close` is what references
  // `vibe_hs_close_raw` -- injecting it for every stream program would
  // reserve the close import in programs that only ever drain, which is
  // exactly the byte-compat property this surface is supposed to keep.
  let mut calls_host_stream_close = false
  let mut user_defines_host_stream = false
  let mut has_spawn_suspend = false
  let mut has_aw_poll = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, EFn(_, _, _, _, eff, fbody)) => {
        if name == entry_name && lc_row_has_label(eff, "Async") {
          entry_has_async = true
        } else {
          ()
        }
        if name == "sleep" {
          user_defines_sleep = true
        } else {
          ()
        }
        if name == "__aw_poll" {
          has_aw_poll = true
        } else {
          ()
        }
        if lc_expr_has_async_handle(fbody) {
          has_async_handle = true
        } else {
          ()
        }
        if lc_expr_calls_sleep(fbody) {
          calls_sleep = true
        } else {
          ()
        }
        if name == "host_future_get" || name == "host_future_named" {
          user_defines_host_future = true
        } else {
          ()
        }
        if lc_expr_calls_host_future(fbody) {
          calls_host_future = true
        } else {
          ()
        }
        if name == "host_stream_named" || name == "host_stream_next" || name == "host_stream_close" {
          user_defines_host_stream = true
        } else {
          ()
        }
        if lc_expr_calls_host_stream(fbody) {
          calls_host_stream = true
        } else {
          ()
        }
        if lc_expr_calls_name(fbody, "host_stream_close") {
          calls_host_stream_close = true
        } else {
          ()
        }
        if lc_expr_has_spawn_suspend(fbody) {
          has_spawn_suspend = true
        } else {
          ()
        }
      },
      SLet(_, _, name, _, sv) => {
        if name == "sleep" {
          user_defines_sleep = true
        } else {
          ()
        }
        if name == "host_future_get" || name == "host_future_named" {
          user_defines_host_future = true
        } else {
          ()
        }
        if name == "host_stream_named" || name == "host_stream_next" || name == "host_stream_close" {
          user_defines_host_stream = true
        } else {
          ()
        }
        if lc_expr_has_async_handle(sv) {
          has_async_handle = true
        } else {
          ()
        }
        if lc_expr_calls_sleep(sv) {
          calls_sleep = true
        } else {
          ()
        }
        if lc_expr_calls_host_future(sv) {
          calls_host_future = true
        } else {
          ()
        }
        if lc_expr_calls_host_stream(sv) {
          calls_host_stream = true
        } else {
          ()
        }
        if lc_expr_calls_name(sv, "host_stream_close") {
          calls_host_stream_close = true
        } else {
          ()
        }
      },
      SLetMut(_, _, mv) => {
        if lc_expr_has_async_handle(mv) {
          has_async_handle = true
        } else {
          ()
        }
        if lc_expr_calls_sleep(mv) {
          calls_sleep = true
        } else {
          ()
        }
        if lc_expr_calls_host_future(mv) {
          calls_host_future = true
        } else {
          ()
        }
        if lc_expr_calls_host_stream(mv) {
          calls_host_stream = true
        } else {
          ()
        }
        if lc_expr_calls_name(mv, "host_stream_close") {
          calls_host_stream_close = true
        } else {
          ()
        }
      },
      SExpr(se) => {
        if lc_expr_has_async_handle(se) {
          has_async_handle = true
        } else {
          ()
        }
        if lc_expr_calls_sleep(se) {
          calls_sleep = true
        } else {
          ()
        }
        if lc_expr_calls_host_future(se) {
          calls_host_future = true
        } else {
          ()
        }
        if lc_expr_calls_host_stream(se) {
          calls_host_stream = true
        } else {
          ()
        }
        if lc_expr_calls_name(se, "host_stream_close") {
          calls_host_stream_close = true
        } else {
          ()
        }
      },
      STest(_, te) => {
        if lc_expr_has_async_handle(te) {
          has_async_handle = true
        } else {
          ()
        }
        if lc_expr_calls_sleep(te) {
          calls_sleep = true
        } else {
          ()
        }
        if lc_expr_calls_host_future(te) {
          calls_host_future = true
        } else {
          ()
        }
        if lc_expr_calls_host_stream(te) {
          calls_host_stream = true
        } else {
          ()
        }
        if lc_expr_calls_name(te, "host_stream_close") {
          calls_host_stream_close = true
        } else {
          ()
        }
      },
      SBench(_, be) => {
        if lc_expr_has_async_handle(be) {
          has_async_handle = true
        } else {
          ()
        }
        if lc_expr_calls_sleep(be) {
          calls_sleep = true
        } else {
          ()
        }
        if lc_expr_calls_host_future(be) {
          calls_host_future = true
        } else {
          ()
        }
        if lc_expr_calls_host_stream(be) {
          calls_host_stream = true
        } else {
          ()
        }
        if lc_expr_calls_name(be, "host_stream_close") {
          calls_host_stream_close = true
        } else {
          ()
        }
      },
      SEffectDef(_, ename, _, _) => if ename == "Async" {
        has_async_decl = true
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  // #1342: key the guard on the machinery that is actually INJECTED, not on
  // "the program mentions one of these names somewhere". The three predicates
  // below are the same ones the injection uses further down, hoisted so the
  // guard cannot disagree with it -- previously the guard omitted the
  // `!user_defines_*` half, so a program supplying its own `sleep` was told it
  // was mixing conventions with a boundary that was never going to be built.
  let sleep_machinery = calls_sleep && !user_defines_sleep && (entry_has_async || has_async_handle)
  let hf_machinery = calls_host_future && !user_defines_host_future && entry_has_async
  let hs_machinery = calls_host_stream && !user_defines_host_stream && entry_has_async
  if entry_has_async && (sleep_machinery || hf_machinery || hs_machinery) && has_spawn_suspend {
    "Async entry boundary and TaskGroup::spawn_suspend are mixing the step convention; handle Async inside the entry instead"
  } else {
    // Keying (#1218, tightened after gate 19 regressed on the first cut):
    //
    //   sleep machinery (retarget + optional boundary): the program must
    //   actually CALL `sleep` somewhere. The first cut keyed on the entry
    //   row alone, which wrapped every Async-row entry in the boundary
    //   handle -- and the evidence migration then demanded eligibility of
    //   the WHOLE entry body. Gate 19's for-await program (Async row, trait
    //   dict calls, zero sleeps) was ineligible and failed to compile, a
    //   regression for programs that never needed the machinery at all.
    //
    //   effect-decl injection: needed by the sleep machinery, and ALSO when
    //   awaits expanded (__aw_poll present, injected by await_poll_pass just
    //   before this) into a program that handles Async -- the migration of
    //   that handle needs the declaration's operation list.
    //
    // Increment 2 keying is unchanged within the sleep machinery: a
    // `handle ... with Async` anywhere also enables the retarget (the
    // checker lets such a handle discharge the builtin row, so its body's
    // sleeps MUST become performs the handler can receive); the boundary
    // wrap itself stays entry-row-keyed.
    // sleep_machinery / hf_machinery / hs_machinery are computed ABOVE now, so
    // the guard and the injection cannot drift apart (#1342). Their original
    // rationale:
    //
    // ADR-0089 step 4 (#1218): the host-future machinery -- a program that
    // calls `host_future_get` under an Async-row entry gets the boundary
    // handler (with the waitable settle arm below) even with zero sleeps.
    // Entry-row-keyed only: under a user `handle ... with Async` the
    // Suspend(handle + 2) payload reaches that handler instead, where the
    // in-guest scheduler parks it as a poller (deadlock trap -- no
    // completion source exists in-guest, spec §3.13).
    //
    // ADR-0089 Decision 3 (#1218): the host-stream machinery -- same keying
    // discipline as hf_machinery (entry-row-keyed only; under a user
    // `handle ... with Async` the stream payload would reach a handler with
    // no read source, where the in-guest scheduler's poller arm turns it
    // into a deterministic deadlock trap, spec §3.13).
    let decl_needed = !has_async_decl && (sleep_machinery || hf_machinery || hs_machinery || (has_aw_poll && has_async_handle))
    if decl_needed {
      let ops: Array[(String, Array[TypeExpr], TypeExpr)] = [
        ("Suspend", [
          TyName("Int")
        ], TyName("Int"))
      ]
      Array::push(stmts, SEffectDef(false, "Async", lc_fresh_string_array(), ops))
    } else {
      ()
    }
    if !sleep_machinery {
      ()
    } else {
      let ms = EIdent("__slp_ms", -1)
      let suspend = ECall(EIdent("perform", -1), [
        ECall(EIdent("Async::Suspend", -1), [
          EBinOp("-", EInt(0), ms)
        ], -1)
      ], -1)
      let sleep_body = EIf(EBinOp("<", EInt(0), ms), ELet("__slp_w", suspend, EUnit, -1), EUnit)
      let sleep_params: Array[(String, Option[TypeExpr])] = [
        ("__slp_ms", Some(TyName("Int")))
      ]
      Array::push(stmts, SLet(false, false, "__slp_perform", None, EFn(lc_fresh_string_array(), array_empty(), sleep_params, Some(TyName("Unit")), Some("Async"), sleep_body)))
      // Retarget `sleep(..)` calls to the injected fn -- see
      // lc_rename_sleep_calls for why the fn cannot itself be named `sleep`.
      // Codex P1 on #1312: which WALK depends on whether the boundary is
      // installed. Under an Async-row entry the boundary catches every
      // otherwise-unhandled perform, so the program-wide (shadow-aware)
      // rewrite is sound. Without it, only positions guaranteed a handler
      // are rewritten (lc_rename_sleep_scoped) -- everything else keeps the
      // blocking builtin rather than gaining a perform nothing handles.
      let rename_stmt_expr = (rexpr: Expr) -> Expr {
        if entry_has_async {
          lc_rename_sleep_calls(rexpr, true)
        } else {
          // A TOP-LEVEL fn's own EFn node is not a rewrite context in scoped
          // mode -- only nested closure LITERALS are. An Async-row top-level
          // fn (e.g. `fn delay() with Async { sleep(1) }`) may be called
          // from row-free code with no handler in sight, so its sleeps must
          // keep the blocking builtin; a row-annotated literal, by contrast,
          // is step-split by Vertical B and its performs always bubble to
          // the handler that drives it.
          match rexpr {
            EFn(rtps, rtbs, rparams, rret, reff, rbody) => EFn(rtps, rtbs, rparams, rret, reff, lc_rename_sleep_scoped(rbody)),
            _ => lc_rename_sleep_scoped(rexpr)
          }
        }
      }
      let mut r = 0
      while r < Array::length(stmts) {
        match Array::get(stmts, r) {
          SLet(rex, rrec, rname, rty, rexpr) => if rname == "__slp_perform" {
            ()
          } else {
            Array::set(stmts, r, SLet(rex, rrec, rname, rty, rename_stmt_expr(rexpr)))
          },
          SLetMut(mname, mty, mexpr) => {
            Array::set(stmts, r, SLetMut(mname, mty, rename_stmt_expr(mexpr)))
          },
          STest(tname, texpr) => {
            // The unit-test lane (__no_entry__) compiles STest bodies as
            // entries of their own; a sleep inside one must retarget exactly
            // like fn-body sleeps or it stays an opaque builtin call that the
            // suspend lowering rejects (found live: the spawn_suspend +
            // plain-sleep test failed Vertical-B eligibility until this arm
            // existed). Same stmt coverage as await_poll_pass.
            Array::set(stmts, r, STest(tname, rename_stmt_expr(texpr)))
          },
          SBench(bname, bexpr) => {
            Array::set(stmts, r, SBench(bname, rename_stmt_expr(bexpr)))
          },
          SExpr(sexpr) => {
            Array::set(stmts, r, SExpr(rename_stmt_expr(sexpr)))
          },
          _ => ()
        }
        r = r + 1
      }
    }
    if !hs_machinery {
      ()
    } else {
      // ADR-0089 Decision 3 (#1218): the read half of the host-stream
      // surface. `host_stream_next(s)` retargets to the injected
      // `__hs_next`, which performs `Async::Suspend` with the reserved
      // STREAM payload band (handle + lc_hs_req_base(); the future band is
      // handle + 2, and the composer's adapter caps handles at 1023, so
      // the bands can never overlap). The entry boundary's stream arm
      // resumes with the byte the adapter read -- or -1 at end of stream,
      // which the row-free finisher `__hs_fin` latches into the cell
      // (state 3 -> 0) so every later read returns -1 without performing.
      // The perform sits on a let-spine with a row-free tail call, the
      // same shape as __aw_poll's pay/settle chain, so the suspend CPS
      // split accepts it.
      let hsn_s = EIdent("__hsn_s", -1)
      let hsn_state = ECall(EIdent("Array::get", -1), [
        hsn_s,
        EInt(0)
      ], -1)
      let hsn_hnd = ECall(EIdent("Array::get", -1), [
        hsn_s,
        EInt(1)
      ], -1)
      let hsn_suspend = ECall(EIdent("perform", -1), [
        ECall(EIdent("Async::Suspend", -1), [
          EBinOp("+", hsn_hnd, EInt(lc_hs_req_base()))
        ], -1)
      ], -1)
      let hsn_body = EIf(EBinOp("==", hsn_state, EInt(3)), ELet("__hsn_v", hsn_suspend, ECall(EIdent("__hs_fin", -1), [
        hsn_s,
        EIdent("__hsn_v", -1)
      ], -1), -1), EBinOp("-", EInt(0), EInt(1)))
      let hsn_params: Array[(String, Option[TypeExpr])] = [
        ("__hsn_s", None)
      ]
      Array::push(stmts, SLet(false, false, "__hs_next", None, EFn(lc_fresh_string_array(), array_empty(), hsn_params, Some(TyName("Int")), Some("Async"), hsn_body)))
      let hsf_s = EIdent("__hsf_s", -1)
      let hsf_v = EIdent("__hsf_v", -1)
      let hsf_close = ECall(EIdent("Array::set", -1), [
        hsf_s,
        EInt(0),
        EInt(0)
      ], -1)
      let hsf_body = EIf(EBinOp("<", hsf_v, EInt(0)), ESeq(hsf_close, EBinOp("-", EInt(0), EInt(1))), hsf_v)
      let hsf_params: Array[(String, Option[TypeExpr])] = [
        ("__hsf_s", None),
        ("__hsf_v", None)
      ]
      Array::push(stmts, SLet(false, false, "__hs_fin", None, EFn(lc_fresh_string_array(), array_empty(), hsf_params, Some(TyName("Int")), None, hsf_body)))
      // ADR-0089 Decision 3 follow-up (#1218): the DROP half. The read half
      // releases the readable end only once it reaches end of stream, so a
      // guest that stops reading early (`take the first 4 bytes`) used to
      // pin that handle for the component instance's whole lifetime -- the
      // limitation recorded at the end of spec §3.18.
      //
      // `host_stream_close(s)` retargets to this injected `__hs_close`,
      // which is ROW-FREE: dropping a readable end is a canon call that
      // never blocks, so unlike the read there is no perform, no reserved
      // band and no boundary settle arm -- it calls the adapter directly.
      //
      // The cell's state word is what makes it idempotent and safe: the
      // drop happens only for state 3 (open host stream), and the same
      // write that closes the cell (3 -> 0) is what stops a second close --
      // or a later read, which returns -1 through `__hs_next`'s state test
      // -- from reaching the adapter again. A double `stream.drop-readable`
      // on one handle would trap host-side, so this is load-bearing, not
      // just tidy.
      let hsc_s = EIdent("__hsc_s", -1)
      let hsc_state = ECall(EIdent("Array::get", -1), [
        hsc_s,
        EInt(0)
      ], -1)
      let hsc_hnd = ECall(EIdent("Array::get", -1), [
        hsc_s,
        EInt(1)
      ], -1)
      let hsc_drop = ECall(EIdent("vibe_hs_close_raw", -1), [
        hsc_hnd
      ], -1)
      let hsc_mark = ECall(EIdent("Array::set", -1), [
        hsc_s,
        EInt(0),
        EInt(0)
      ], -1)
      let hsc_body = EIf(EBinOp("==", hsc_state, EInt(3)), ELet("__hsc_r", hsc_drop, hsc_mark, -1), EUnit)
      let hsc_params: Array[(String, Option[TypeExpr])] = [
        ("__hsc_s", None)
      ]
      // Injected ONLY when the source actually closes. `__hs_close`'s body is
      // the sole reference to `vibe_hs_close_raw`, and the import is gated on
      // that name being used -- so injecting it unconditionally would hand
      // the close import (and the adapter's drop func) to every draining
      // program too, silently changing bytes that are pinned elsewhere.
      if calls_host_stream_close {
        Array::push(stmts, SLet(false, false, "__hs_close", None, EFn(lc_fresh_string_array(), array_empty(), hsc_params, Some(TyName("Unit")), None, hsc_body)))
      } else {
        ()
      }
      // Program-wide retarget (shadow-aware): the machinery is
      // entry-row-keyed, so the boundary catches every otherwise-unhandled
      // perform -- the same soundness argument as the sleep rewrite's
      // entry_has_async arm. Both surfaces are rewritten here, each by its
      // own pass (shadowing is per-name, see lc_rename_hs_close_calls).
      let mut hsr = 0
      while hsr < Array::length(stmts) {
        match Array::get(stmts, hsr) {
          SLet(hrex, hrrec, hrname, hrty, hrexpr) => if hrname == "__hs_next" || hrname == "__hs_fin" || hrname == "__hs_close" {
            ()
          } else {
            Array::set(stmts, hsr, SLet(hrex, hrrec, hrname, hrty, lc_rename_hs_maybe_close(calls_host_stream_close, lc_rename_hs_next_calls(hrexpr, true), true)))
          },
          SLetMut(hmname, hmty, hmexpr) => {
            Array::set(stmts, hsr, SLetMut(hmname, hmty, lc_rename_hs_maybe_close(calls_host_stream_close, lc_rename_hs_next_calls(hmexpr, true), true)))
          },
          STest(htname, htexpr) => {
            Array::set(stmts, hsr, STest(htname, lc_rename_hs_maybe_close(calls_host_stream_close, lc_rename_hs_next_calls(htexpr, true), true)))
          },
          SBench(hbname, hbexpr) => {
            Array::set(stmts, hsr, SBench(hbname, lc_rename_hs_maybe_close(calls_host_stream_close, lc_rename_hs_next_calls(hbexpr, true), true)))
          },
          SExpr(hsexpr) => {
            Array::set(stmts, hsr, SExpr(lc_rename_hs_maybe_close(calls_host_stream_close, lc_rename_hs_next_calls(hsexpr, true), true)))
          },
          _ => ()
        }
        hsr = hsr + 1
      }
    }
    if entry_has_async && (sleep_machinery || hf_machinery || hs_machinery) {
      let req = EIdent("__entry_slp_req", -1)
      // ADR-0089 D2 (#1218): the boundary is tail-resumptive -- nothing
      // else can run between the perform and the resume -- so a POLL-WAIT
      // payload (req == 1, __aw_poll's retry convention) can never be
      // satisfied here: resuming it would re-poll the same unresolved
      // future forever, a silent livelock. Trap deterministically instead
      // (`assert` lowers to `unreachable` on false -- an unshadowable
      // inline builtin, see compile_call.vibe's #1095 note), mirroring the
      // scheduler's own deadlock-trap rule (conc_require in
      // @vibex/concurrent). Sleep debts (req < 0) settle by blocking;
      // cooperative yields (req == 0) resume for free.
      //
      // ADR-0089 step 4 (#1218): a WAITABLE payload (req >= 2, the reserved
      // band -- req - 2 is a host future handle from `host_future_get`) IS
      // satisfiable here, unlike the poll-wait: `vibe_hf_wait_raw` performs
      // the future.read -> BLOCKED -> waitable.join -> waitable-set.wait
      // sequence in the component adapter (spec §3.13), where the CANONICAL
      // ABI suspends the whole task until the host resolves the future --
      // so a tail-resumptive arm that blocks in it is exactly right. The
      // arm resumes with the value that landed in the read buffer, and
      // __aw_poll's settle writes it into the future cell. Emitted via a
      // synthesized row-free `__entry_settle` fn only when the program
      // calls `host_future_get`, so sleep-only boundaries keep their
      // original (byte-identical) inline arm.
      let arm = if hf_machinery || hs_machinery {
        let q = EIdent("__entry_hf_q", -1)
        let wait_call = ECall(EIdent("vibe_hf_wait_raw", -1), [
          EBinOp("-", q, EInt(2))
        ], -1)
        let trap_zero = ESeq(ECall(EIdent("assert", -1), [
          EBinOp("==", q, EInt(0))
        ], -1), EInt(0))
        let low = if sleep_machinery {
          EIf(EBinOp("<", q, EInt(0)), ESeq(ECall(EIdent("sleep_blocking", -1), [
            EBinOp("-", EInt(0), q)
          ], -1), EInt(0)), trap_zero)
        } else {
          trap_zero
        }
        let mid = if hf_machinery {
          EIf(EBinOp("<", EInt(1), q), wait_call, low)
        } else {
          low
        }
        // ADR-0089 Decision 3 (#1218): the STREAM band (q >= 2048, q -
        // lc_hs_req_base() = the readable end's handle) settles by one
        // blocking `vibe_hs_read_raw` -- the adapter's stream.read +
        // waitable-set.wait when it blocks -- resuming with the byte, or
        // -1 at end of stream. Emitted only under hs_machinery so future-
        // and sleep-only boundaries keep their bytes.
        let settle_body = if hs_machinery {
          let hs_read_call = ECall(EIdent("vibe_hs_read_raw", -1), [
            EBinOp("-", q, EInt(lc_hs_req_base()))
          ], -1)
          EIf(EBinOp("<", EInt(lc_hs_req_base() - 1), q), hs_read_call, mid)
        } else {
          mid
        }
        let settle_params: Array[(String, Option[TypeExpr])] = [
          ("__entry_hf_q", Some(TyName("Int")))
        ]
        Array::push(stmts, SLet(false, false, "__entry_settle", None, EFn(lc_fresh_string_array(), array_empty(), settle_params, Some(TyName("Int")), None, settle_body)))
        ELet("__entry_slp_v", ECall(EIdent("__entry_settle", -1), [
          req
        ], -1), ECall(EIdent("resume", -1), [
          EIdent("__entry_slp_v", -1)
        ], -1), -1)
      } else {
        let settle = EIf(EBinOp("<", req, EInt(0)), ECall(EIdent("sleep_blocking", -1), [
          EBinOp("-", EInt(0), req)
        ], -1), ECall(EIdent("assert", -1), [
          EBinOp("<", req, EInt(1))
        ], -1))
        ESeq(settle, ECall(EIdent("resume", -1), [
          EInt(0)
        ], -1))
      }
      let mut j = 0
      while j < Array::length(stmts) {
        match Array::get(stmts, j) {
          SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, body)) => if name == entry_name {
            let wrapped = EHandle(body, [
              (PCtor("Async::Suspend", [
                PBind("__entry_slp_req")
              ]), arm)
            ])
            Array::set(stmts, j, SLet(exported, is_rec, name, ty, EFn(tps, tbs, params, ret, eff, wrapped)))
          } else {
            ()
          },
          _ => ()
        }
        j = j + 1
      }
    } else {
      ()
    }
    ""
  }
}

/// #1536(c) / #1511(b): the ADR-0076 effect-lowering pass prefix of
/// compile_wasi_module_linked_impl, split out so `vibe check` can run the
/// EXACT eligibility judgement codegen applies (suspend CPS split +
/// evidence-passing migration) without producing wasm — sharing the code is
/// what guarantees check and codegen can never disagree on what is eligible.
/// Returns the errors instead of throwing; an empty result means every pass
/// accepted the program and `stmts` now holds the lowered form the rest of
/// codegen consumes. All of these passes REWRITE `stmts` in place — a
/// check-lane caller must pass a merged AST it is about to discard.
/// `iw_names`/`iw_wats` receive the extracted inline-wasm texts (the compile
/// path emits them later; check discards them).
export fn effect_lowering_prelude(stmts: Array[Stmt], entry_name: String, linked_imports: Array[(String, String, Int, Int)], iw_names: Array[String], iw_wats: Array[String]) -> Array[String] with Exception {
  let errs = lc_fresh_string_array()
  // ADR-0091 Phase 1: enforce `#zero_alloc` markers before any lowering
  // rewrites the marked bodies. No-op when no marker is present.
  let za_msg = zero_alloc_check(stmts)
  if za_msg != "" {
    Array::push(errs, za_msg)
  } else {
    // #1571: expand `inspect(value, content)` into its
    // `__to_string`/`println`/`assert_true` form. The checker runs this too
    // (checker_stmt.vibe), but on the statement array IT was handed --
    // parse_program_with_path hands out a fresh array per caller, so the
    // merged program codegen compiles has never seen that pass. Idempotent
    // (nothing named `inspect` survives it), same as desugar_labeled_args's
    // check-then-codegen double run.
    desugar_inspect_calls(stmts)
    // Method-bearing-trait dictionary passing (#641 PR-3). Universal codegen
    // convergence point — runs here on the fully merged program before generic
    // type params are stripped (just below). No-op unless a method-bearing trait
    // is declared, and idempotent if an earlier pipeline stage already desugared.
    desugar_trait_dicts(stmts)
    // #1262: split eligible tuple-literal `let mut`s (what every `loop (s = ..)`
    // lowers to) into scalar `let mut`s -- no per-iteration tuple box. Runs on
    // both linear entries (compile_module has the same call); gc/interp lanes
    // keep the boxed form, and the rewrite is semantics-preserving so the
    // cross-lane differential gates still agree.
    unbox_tuple_loop_params(stmts)
    // The fully merged AST now carries canonical import value names and
    // qualified type heads. Validate provider direct-call-only syntax here,
    // before top-level alias retargeting could erase a value position and before
    // wrapper injection can introduce any raw provider ABI.
    let provider_value_err = lc_validate_stdin_provider_stmts(stmts)
    if provider_value_err != "" {
      Array::push(errs, provider_value_err)
    } else {
      ()
    }
    // Top-level `let f = g` function aliases: retarget references to the final
    // EFn def so calls do not route through the 0-param thunk registration
    // below (invalid wasm for any call arity). See import_alias_rewrite.vibe.
    if Array::length(errs) == 0 {
      rewrite_top_level_fn_alias_refs(stmts)
      let _ = lc_inject_stdin_surface_wrappers(stmts)
    } else {
      ()
    }
    // #805: inline-wasm fns — extract WAT texts + neutralize marker bodies
    // BEFORE any analysis below (see lc_extract_inline_wasm's doc comment).
    lc_extract_inline_wasm(stmts, iw_names, iw_wats)
    // #tco: rewrite a top-level function's self-tail-recursive calls into the
    // same ELetMut/EWhile/EBreak/EContinue shape `loop (...) { continue(...) }`
    // already lowers to (see self_tail_call.vibe) -- zero wasm call-stack
    // growth per recursive step instead of an unbounded `call`. No-op unless a
    // function is directly self-tail-recursive; runs before the borrow/scalar-
    // return analyses below so they see the rewritten (loop-shaped) body.
    // #1230 (docs/spec/wasi-p3-async.md M1b-3c): expand `await(f)` into the
    // suspend-and-retry loop a PENDING future needs. Runs right after
    // desugar_trait_dicts (which is what produces the `await(..)` call of an
    // async-iterator `for` loop) and BEFORE every effect pass below, so the
    // `perform Async::Suspend(1)` it synthesizes is seen by them exactly like a
    // hand-written one -- lowering `await` inside compile_call, where it used to
    // live, is past the point where a perform can still be handled.
    // waiter_hooks (ADR-0089 #1218): when @vibex/concurrent's direct-wake
    // hooks are callable (linked imports or local defs), poll rounds route
    // through __aw_wait so a Future::resolve can wake the awaiter directly.
    await_poll_pass(stmts, lc_stmts_call_host_future(stmts), lc_waiter_hooks_available(stmts, linked_imports))
    rewrite_self_tail_calls(stmts)
    // #944 (ADR-0073 stage C): entry-boundary Error handler -- see
    // lc_wrap_entry_error_boundary's doc comment. Runs BEFORE the effect
    // passes below so the synthesized handle is visible to them like any
    // hand-written one, and before collect_used_builtin_names so the
    // diagnostic's Stderr host import is collected.
    lc_wrap_entry_error_boundary(stmts, entry_name)
    let async_sleep_boundary_err = lc_inject_async_sleep_boundary(stmts, entry_name)
    if async_sleep_boundary_err != "" {
      Array::push(errs, async_sleep_boundary_err)
    } else {
      // #1536 (a), eager Stream slice: compile_call lowers `Stream::next`
      // directly, which is after suspend_cps_pass and leaves it opaque to the
      // pass. Give it a shadow-aware synthetic top-level spelling first; its
      // row-free body exactly preserves the one-evaluation ready
      // Future[Option[T]] lowering. This must stay before suspend CPS.
      lc_inject_stream_next_retarget(stmts)
      // ADR-0076 (#817) Phase 2: inline `perform` calls that are structurally
      // reachable-only-via-tail-resumptive-handler-arms directly into their
      // handler arm body (single-shot fast path). Conservative: bails out
      // per-handle whenever the handled body contains anything (nested
      // `handle`, closures, or calls to named functions) that could hide a
      // perform outside this direct scan, leaving those to evidence_dict_pass
      // below (which, since 追記34 V2 removed the replay engine, hard-errors on
      // any live non-Error handle it cannot migrate).
      // ADR-0076 Phase 3a (#817, docs/effect-evidence-passing.md 追記27):
      // depth-0 suspend CPS for handle sites whose arms capture `resume` as a
      // first-class value (the suspend class -- ADR-0068's Async::suspend
      // shape). Runs BEFORE the Phase 2 / evidence passes below so they only
      // ever see the sites this pass left alone (a transformed site has no
      // EHandle left at all). A triggered-but-ineligible site is a hard
      // compile error -- a value-referencing arm cannot compile on the replay
      // path, so silent fallback is not an option.
      let scps_errs = suspend_cps_pass(stmts)
      if Array::length(scps_errs) > 0 {
        Array::push(errs, Array::get(scps_errs, 0))
      } else {
        inline_direct_performs(stmts)
        // ADR-0076 (#817) Phase 3, first slice: evidence-dict threading for the
        // narrow case Phase 2 above cannot reach on its own -- a handle body that
        // calls a named top-level function which itself performs the handled
        // effect (docs/effect-evidence-passing.md "追記 2", evidence_dict_pass's
        // own doc comment in common_base/inline_direct_perform.vibe -- appended to
        // that existing cross-file-registered file rather than a new one, to
        // avoid the bootstrap flatten gotcha documented in docs/effectset.md).
        // Runs after Phase 2 so it only sees the handles Phase 2 did
        // not already fully inline; whole-program-conservative and strictly
        // additive (per-effect all-or-nothing), so it never touches a handle or
        // function Phase 2 already resolved or that this pass cannot prove safe.
        let edp_errs = evidence_dict_pass(stmts, entry_name)
        if Array::length(edp_errs) > 0 {
          Array::push(errs, Array::get(edp_errs, 0))
        } else {
          ()
        }
      }
    }
  }
  errs
}

export fn compile_wasi_module_linked_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool, enable_rc: Bool, coverage: Bool, debug_trace: Bool, debug_break: Bool, rc_shadow: Bool, prov: DbgProv, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, slice_lo: Int, slice_hi: Int) -> Bytes with Exception {
  // #1536(c)/#1511(b): the whole effect-lowering prefix lives in
  // effect_lowering_prelude (shared verbatim with `vibe check`); a first
  // error there is exactly the throw each pass used to raise inline here.
  let iw_names = lc_fresh_string_array()
  let iw_wats = lc_fresh_string_array()
  let prelude_errs = effect_lowering_prelude(stmts, entry_name, linked_imports, iw_names, iw_wats)
  if Array::length(prelude_errs) > 0 {
    throw(Array::get(prelude_errs, 0))
  } else {
    ()
  }
  // #707: functions whose entire body is transitively a tail-call to a
  // borrow-returning builtin (Array::get/Map::get/__index) -- e.g. a thin
  // `peek(toks, pos) -> Array::get(toks, pos)` wrapper. Computed once over the
  // whole merged program and threaded into every function's Perceus plan so a
  // `let v = peek(...)` binding (including the match-scrutinee-lift's
  // `let __m_scrut = peek(...)`, see normalize/index.vibe) is recognized the
  // same as a direct `let v = Array::get(...)` one.
  // Sorted immediately (membership-only from here on: cc_is_borrow_ret_call /
  // classify_let_value_heap query it once per call site across the whole
  // program) so those lookups are bsearch_leftmost instead of a linear scan
  // -- same rationale as ctor_table.names_sorted above.
  let lc_borrow_ret_names = sorted_names_of(compute_borrow_returning_names(stmts))
  // ADR-0092 borrow-inference: user fns with at least one borrowed parameter
  // program-wide (read-only, never valued/aliased -- see
  // compute_borrow_param_user_fns). The entry fn and the conventional entry
  // names are excluded: the host invokes them without consulting the set.
  //
  // Slice 1 (#1282) inferred POSITION 0 only; this is the per-position
  // generalization, so a fn that consumes param0 but only reads param2 now
  // borrows param2. Bit 0 of every mask is exactly slice 1's set.
  //
  // ADR-0092 borrow-inference, per-use-paired accounting. The
  // planner's invariant per binding: acquisitions (initial owned ref +
  // dups) must equal releases (owned consumes + scope-end drop). A
  // view-call binding (value = call to a lc_borrow_view_ret fn) holds NO
  // initial owned reference, so (a) its LAST owned use must dup instead
  // of spending the phantom initial ref (pe_use / the ELet alias mirror)
  // and (b) its scope-end / seq-temp drop is suppressed unconditionally
  // (pe_scope_end) -- not just when all its uses are borrows, which was
  // the round-3 condition that left latent over-releases behind whenever
  // a view binding also had owned consumes or was never used at all.
  // Earlier isolated classes, still covered: fresh-result leak (marking
  // restricted to compute_may_return_view_fns callees, intersected into
  // lc_borrow_view_ret -- a fresh result from a may-return-view callee
  // still leaks, bounded, safe direction), temp-argument leak (a POSITION
  // ever passed a non-ident argument is disqualified via
  // ca_collect_nonident_args), and the lexical-shadow holes (a local
  // shadowing a borrow-set name is an ordinary owned call: pc_count /
  // pc_emit / pctx_mark_view_call all guard on scope, mirroring
  // compile_call's #875 local_idx_hint guard). Known conservative gaps:
  // loop params bound to a view-call init are not marked (their
  // back-edge rebinds make ownership flow-dependent), and a view call
  // reaching a binding through an if/match VALUE position is unmarked
  // (treated owned).
  let lc_borrow_arg0_enabled = true
  // Names arrive SORTED with the masks already aligned to them (the analysis
  // sorts and re-reads the masks by name in one place, so no caller can
  // misalign them). Sorting matters: every membership test on the borrow set
  // -- pc_count / pc_emit per call site, compile_call's borrows_this per
  // call, the md consume-count borrow test -- is a bsearch_leftmost instead
  // of a 500+-name linear scan (profiled at ~35% of selfcompile CPU as
  // array_contains_str + __rt_eq/__rt_str_eq/__rt_arr_get traffic).
  let lc_borrow_param_mask = lc_fresh_int_array()
  let lc_borrow_param_user_srt = if lc_borrow_arg0_enabled {
    compute_borrow_param_user_fns(stmts, [
      entry_name,
      "main",
      "_start",
      "cli_main"
    ], lc_borrow_param_mask)
  } else {
    lc_fresh_string_array()
  }
  // Fns whose RETURN may be an unowned interior view: these mark
  // view_call_let in the planner (see PCtx.view_ret_user and the gate
  // comment above). NOT intersected with the borrow-param set: a callee
  // returns a view regardless of whether any of its params qualified for the
  // borrowed ABI (e.g. a fn disqualified by a non-ident argument call site
  // still hands back an interior view whose binding must not be dropped)
  // -- the round-3 intersection left exactly those bindings with a
  // release they never acquired.
  let lc_borrow_view_ret = if lc_borrow_arg0_enabled {
    sorted_names_of(compute_may_return_view_fns(stmts))
  } else {
    lc_fresh_string_array()
  }
  // #710: see CompileCtx.scalar_ret_names' doc comment (common_base/common_base.vibe).
  let lc_scalar_ret_names = sorted_names_of(compute_scalar_returning_names(stmts))
  let fn_names_list = lc_fresh_string_array()
  let fn_param_counts = lc_fresh_int_array()
  let fn_needs_env_list = lc_fresh_bool_array()
  let fn_stmt_indices = lc_fresh_int_array()
  let thunk_names_list = lc_fresh_string_array()
  let const_int_names_list = lc_fresh_string_array()
  let const_int_values_list = lc_fresh_int_array()
  let export_fn_names = lc_fresh_string_array()
  let export_fn_user_indices = lc_fresh_int_array()
  let test_fn_names = lc_fresh_string_array()
  let empty_tp = array_empty()
  let empty_bounds = array_empty()
  let empty_params = array_empty()
  let mut pi = 0
  while pi < Array::length(stmts) {
    match Array::get(stmts, pi) {
      STest(tname, tbody) => {
        let test_fn = String::concat("__test_", tname)
        Array::push(test_fn_names, test_fn)
        Array::set(stmts, pi, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))
      },
      SBench(bname, bbody) => {
        let bench_fn = String::concat("__bench_", bname)
        Array::push(test_fn_names, bench_fn)
        Array::set(stmts, pi, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))
      },
      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {
        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {
          Array::set(stmts, pi, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))
        }
        ,
        _ => ()
      },
      _ => ()
    }
    pi = pi + 1
  }
  if Array::length(test_fn_names) > 0 {
    let mut has_entry = false
    let mut ei = 0
    while ei < Array::length(stmts) {
      match Array::get(stmts, ei) {
        SLet(is_exp, _, name, _, _) => if is_exp && name == entry_name {
          has_entry = true
        },
        _ => ()
      }
      ei = ei + 1
    }
    if !has_entry {
      ()
    }
  }
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    if is_slet(stmt) {
      let name = get_slet_name(stmt)
      let expr = get_slet_expr(stmt)
      let is_export = get_slet_export(stmt)
      let user_idx = Array::length(fn_names_list)
      // #715: `expr_tag(expr)` hoisted out of the `else` branch below and
      // computed here, unconditionally -- so it (like `is_efn(expr)` above)
      // contributes to `expr`'s always-consumed prefix instead of only being
      // paid for on the `else` path. This alone still leaves the `else`
      // branch's own nested if asymmetric (`get_eint_value`=1 use vs the
      // thunk fallback's 0), so the thunk fallback below also aliases `expr`
      // once (`let __sf_thunk_expr = expr`) to match. With both asymmetries
      // resolved, `then` and `else` each consume `expr` the same number of
      // times, so pc_emit's EIf MIN-merge (#705) lands on the SAME remaining
      // count regardless of which branch a given statement actually takes --
      // previously the merge could permanently assume more consumption than
      // a commonly-taken branch (int-constant or thunk statements, which are
      // NOT rare like a false `is_efn` check on a real function body) really
      // performed, skipping the loop-body scope-end drop and leaking `expr`
      // (a heap Expr node) on every such statement.
      let __sf_etag = expr_tag(expr)
      if is_efn(expr) {
        let params = get_efn_params(expr)
        Array::push(fn_names_list, name)
        Array::push(fn_param_counts, Array::length(params))
        Array::push(fn_needs_env_list, true)
        Array::push(fn_stmt_indices, i)
      } else {
        if (__sf_etag == 0) && !is_export {
          Array::push(const_int_names_list, name)
          Array::push(const_int_values_list, get_eint_value(expr))
        } else {
          let __sf_thunk_expr = expr
          Array::push(fn_names_list, name)
          Array::push(fn_param_counts, 0)
          Array::push(fn_needs_env_list, true)
          Array::push(fn_stmt_indices, i)
          Array::push(thunk_names_list, name)
        }
      }
      if is_export || library_mode {
        Array::push(export_fn_names, name)
        Array::push(export_fn_user_indices, user_idx)
      }
    }
    i = i + 1
  }
  let ctor_names_list = lc_fresh_string_array()
  Array::push(ctor_names_list, "None")
  Array::push(ctor_names_list, "Some")
  let ctor_tags_list = lc_fresh_int_array()
  Array::push(ctor_tags_list, 0)
  Array::push(ctor_tags_list, 1)
  let ctor_field_counts_list = lc_fresh_int_array()
  Array::push(ctor_field_counts_list, 0)
  Array::push(ctor_field_counts_list, 1)
  let ctor_type_names_list = lc_fresh_string_array()
  Array::push(ctor_type_names_list, "Option")
  Array::push(ctor_type_names_list, "Option")
  // #1062: sparse `ctor_idx * 64 + field_idx` entries for Double/Float-typed
  // positional constructor fields (see CompileCtx.ctor_float_fields). Built
  // alongside ctor_names_list/ctor_field_counts_list above so ctor_idx here
  // always matches ctor_table_index_of's result for the same name.
  let ctor_float_fields_list = lc_fresh_int_array()
  let mut type_index = 1
  let mut ei2 = 0
  while ei2 < Array::length(stmts) {
    match Array::get(stmts, ei2) {
      SEnum(_, ename, _, variants, _) => {
        type_index = type_index + 1
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vfields) = Array::get(variants, vi)
          Array::push(ctor_names_list, vname)
          Array::push(ctor_tags_list, (type_index<<16)|vi)
          Array::push(ctor_field_counts_list, Array::length(vfields))
          Array::push(ctor_type_names_list, ename)
          push_ctor_float_fields(ctor_float_fields_list, Array::length(ctor_names_list) - 1, vfields)
          vi = vi + 1
        }
        0
      },
      SStruct(_, sname, sfields, _, _, _) => {
        type_index = type_index + 1
        Array::push(ctor_names_list, sname)
        Array::push(ctor_tags_list, type_index<<16)
        Array::push(ctor_field_counts_list, Array::length(sfields))
        Array::push(ctor_type_names_list, sname)
        push_ctor_float_fields(ctor_float_fields_list, Array::length(ctor_names_list) - 1, struct_field_types(sfields))
        0
      },
      SSuberror(_, ename, variants) => {
        // #786: a suberror is a single-typed enum whose constructors produce a
        // throwable value; register its ctors in the ctor table like an enum's
        // so `KeyInvalid("x")` allocates a tagged value instead of resolving to
        // an undefined name at codegen.
        type_index = type_index + 1
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vfields) = Array::get(variants, vi)
          Array::push(ctor_names_list, vname)
          Array::push(ctor_tags_list, (type_index<<16)|vi)
          Array::push(ctor_field_counts_list, Array::length(vfields))
          Array::push(ctor_type_names_list, ename)
          push_ctor_float_fields(ctor_float_fields_list, Array::length(ctor_names_list) - 1, vfields)
          vi = vi + 1
        }
        0
      },
      _ => 0
    }
    ei2 = ei2 + 1
  }
  let struct_names = lc_fresh_string_array()
  let struct_field_names = lc_fresh_string_matrix()
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      SStruct(_, sname, sfields, _, _, _) => {
        Array::push(struct_names, sname)
        let fnames = lc_fresh_string_array()
        let mut sfi = 0
        while sfi < Array::length(sfields) {
          let (fname, _) = Array::get(sfields, sfi)
          Array::push(fnames, fname)
          sfi = sfi + 1
        }
        Array::push(struct_field_names, fnames)
        ()
      },
      _ => ()
    }
    si = si + 1
  }
  // Sorted ctor-name index (see CtorTable.names_sorted): built once here,
  // shared by this table literal and every per-function ctor_table below.
  let (lc_ctor_names_sorted, lc_ctor_names_sorted_pos) = ctor_sorted_index(ctor_names_list)
  // #724 round 2: (fn name -> declared aggregate return shape) table so
  // `let a = f(..)` bindings participate in structural `==` (see
  // compute_agg_returning in common_base).
  let lc_agg_ret_names = lc_fresh_string_array()
  let lc_agg_ret_infos = lc_fresh_int_array()
  compute_agg_returning(stmts, CtorTable::{
    names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, struct_field_is_ref: array_empty(), names_sorted: lc_ctor_names_sorted, names_sorted_pos: lc_ctor_names_sorted_pos
  }, lc_agg_ret_names, lc_agg_ret_infos)
  // #791: program-wide (fn name) set for declared-heap-returning top-level
  // functions (see compute_heap_returning in perceus/index.vibe). Consulted
  // by classify_let_value_heap (compile_expr_tail.vibe) to classify
  // `let`/`let mut` bindings whose value is a call by the CALLEE's own
  // declared signature, instead of always over-approximating every call as
  // heap.
  // Sorted for bsearch_leftmost membership at the classify_let_value_heap call
  // site (compile_expr_tail.vibe) -- same rationale as lc_borrow_ret_names above.
  let lc_heap_ret_names = sorted_names_of(compute_heap_returning(stmts))
  let num_user_funcs = Array::length(fn_names_list)
  if num_user_funcs == 0 {
    throw("no functions found to compile")
  }
  let mut entry_user_idx = -1
  let mut ei = 0
  while ei < num_user_funcs {
    if Array::get(fn_names_list, ei) == entry_name {
      entry_user_idx = ei
    }
    ei = ei + 1
  }
  // ADR-0069 Phase 1: a missing entry is a compile error. Historically ANY
  // unknown entry name fell through to the test-runner `_start` synthesis, so
  // an entry typo silently produced a no-op module. Only the explicit
  // `__no_entry__` sentinel (vibe test / bench) may synthesize the test runner
  // now. Library mode passes a synthetic entry name it never calls, so it is
  // exempt.
  if entry_user_idx < 0 && !library_mode && entry_name != "__no_entry__" {
    throw("entry `\{entry_name}` not found: no exported function named `\{entry_name}` (use __no_entry__ to build a test runner)")
  }
  let str_strs = collect_strings_stmts(stmts)
  let rec add_map_keys_expr: (Expr) -> Unit = (e) -> {
    match e {
      EMap(fields) => {
        let mut mi = 0
        while mi < Array::length(fields) {
          let (key, val) = Array::get(fields, mi)
          if !array_contains_str(str_strs, key) {
            Array::push(str_strs, key)
          }
          add_map_keys_expr(val)
          mi = mi + 1
        }
      },
      EStringInterp(parts) => {
        let mut pi3 = 0
        while pi3 < Array::length(parts) {
          if pi3 % 2 == 0 {
            let part = Array::get(parts, pi3)
            if String::length(part) > 0 && !array_contains_str(str_strs, part) {
              Array::push(str_strs, part)
            }
          }
          pi3 = pi3 + 1
        }
      },
      ELet(_, val, body, _) => {
        add_map_keys_expr(val); add_map_keys_expr(body)
      },
      ELetMut(_, val, body, _) => {
        add_map_keys_expr(val); add_map_keys_expr(body)
      },
      ELetRec(_, val, body) => {
        add_map_keys_expr(val); add_map_keys_expr(body)
      },
      ESeq(a, b) => {
        add_map_keys_expr(a); add_map_keys_expr(b)
      },
      EIf(c, t, e) => {
        add_map_keys_expr(c); add_map_keys_expr(t); add_map_keys_expr(e)
      },
      EFn(_, _, _, _, _, body) => add_map_keys_expr(body),
      EHandle(body, _) => add_map_keys_expr(body),
      ECall(callee, args, _) => {
        add_map_keys_expr(callee)
        let mut ai = 0
        while ai < Array::length(args) {
          add_map_keys_expr(Array::get(args, ai))
          ai = ai + 1
        }
      },
      _ => ()
    }
  }
  let mut __mk = 0
  while __mk < Array::length(stmts) {
    match Array::get(stmts, __mk) {
      SLet(_, _, _, _, expr) => add_map_keys_expr(expr),
      STest(_, expr) => add_map_keys_expr(expr),
      SBench(_, expr) => add_map_keys_expr(expr),
      _ => ()
    }
    __mk = __mk + 1
  }
  // Always seed the empty string so codegen that materialises "" (e.g.
  // StringBuilder::freeze's join separator, Stream::to_string's accumulator)
  // can rely on str_table_lookup("") succeeding even when the source never
  // mentions "" literally.
  if !array_contains_str(str_strs, "") {
    Array::push(str_strs, "")
  }
  let src_str_base = Array::length(str_strs)
  let num_src_pairs = Array::length(srcs)
  let mut __src_i = 0
  while __src_i < num_src_pairs {
    let (__src_path, __src_content) = Array::get(srcs, __src_i)
    Array::push(str_strs, __src_path)
    Array::push(str_strs, __src_content)
    __src_i = __src_i + 1
  }
  let num_strings = Array::length(str_strs)
  let data_base = 64
  let str_offsets = lc_fresh_int_array()
  let str_lengths = lc_fresh_int_array()
  let mut str_pos = data_base
  let mut si = 0
  while si < num_strings {
    let s = Array::get(str_strs, si)
    let slen = String::length(s)
    Array::push(str_offsets, str_pos)
    Array::push(str_lengths, slen)
    str_pos = str_pos + slen
    si = si + 1
  }
  let heap_start = ((str_pos + 7) / 8) * 8
  let effect_names_list = lc_fresh_string_array()
  let effect_op_keys_list = lc_fresh_string_array()
  let effect_op_arities_list = array_empty()
  let mut eff_collect_i = 0
  while eff_collect_i < Array::length(stmts) {
    match Array::get(stmts, eff_collect_i) {
      SEffectDef(_, eff_name, _, ops) => {
        if !is_exception_effect_name(eff_name) && !array_contains_str(effect_names_list, eff_name) {
          Array::push(effect_names_list, eff_name)
        } else {
          ()
        }
        let mut op_i = 0
        while op_i < Array::length(ops) {
          let (op_name, op_params, _) = Array::get(ops, op_i)
          Array::push(effect_op_keys_list, String::concat(String::concat(eff_name, "::"), op_name))
          Array::push(effect_op_arities_list, Array::length(op_params))
          op_i = op_i + 1
        }
      },
      _ => ()
    }
    eff_collect_i = eff_collect_i + 1
  }
  // ADR-0076 追記34 V2: the per-effect replay regions (#553 -- perform
  // counter / resume-memo control words + memo array, 131072 B per effect
  // tag) are gone with the replay engine itself. Nothing reads or writes
  // below-frontier effect words anymore (perform lowers to a direct
  // builtin call or a bare throw; `resume` never reaches codegen), so the
  // reserve is zero and the heap frontier moves down by (n_effects+1) *
  // 128 KiB per module.
  let eff_reserve = 0
  // Function-level coverage (gated by `coverage`): a 1-byte-per-user-function
  // hit bitmap placed in a dedicated reserve ABOVE the effect regions and BELOW
  // the heap frontier, so it never collides with effect words or the live heap.
  // `cov_base` is a compile-time-constant address baked into each function's
  // prologue store. When coverage is off, cov_reserve is 0 and codegen output is
  // byte-identical to the normal build (the self-host fixpoint is unaffected).
  let cov_count = num_user_funcs
  let cov_base = heap_start + eff_reserve
  let cov_reserve = if coverage {
    ((cov_count + 7) / 8) * 8
  } else {
    0
  }
  // #cov branch coverage: a second 1-byte-per-branch hit region directly above
  // the function-hit region. Branch ids are assigned sequentially during codegen
  // (CovState.next), so the count is not known up front — reserve a fixed cap.
  // 65536 branches is generous headroom (the whole compiler has a few thousand).
  // Off => branch_reserve is 0 and the layout/codegen is byte-identical.
  let cov_branch_cap = 65536
  let cov_branch_base = cov_base + cov_reserve
  let cov_branch_reserve = if coverage {
    cov_branch_cap
  } else {
    0
  }
  // Function-call execution trace (debugger / DAP P1 groundwork, gated by
  // `debug_trace`). A dedicated region directly above the coverage regions and
  // below the heap frontier holds a 4-byte counter cell followed by a fixed-cap
  // log of i32 slots. Each user function's entry, in debug mode, appends its
  // own user index to the log (counter-bounded). A `vibe.trace` custom section
  // records the layout + function names so the runner can dump the entry
  // sequence. Off => trace_reserve is 0 and the layout/codegen is byte-identical
  // to a normal build (the self-host fixpoint is unaffected).
  let trace_cap = 4096
  let trace_counter_addr = cov_branch_base + cov_branch_reserve
  let trace_log_base = trace_counter_addr + 4
  let trace_reserve = if debug_trace {
    4 + trace_cap * 4
  } else {
    0
  }
  // debugger argument inspection (DAP P2, gated by `debug_break`). A dedicated
  // region directly above the trace region holds a 4-byte count cell followed by
  // a fixed-cap array of i64 slots. At each user function entry, in break mode,
  // the function's i64 parameters are spilled here (capped at dbgargs_cap) and
  // the count cell is set, BEFORE calling the `vibe::dbg_break` host hook. The
  // hook reads them out of guest memory and prints `args: [...]`. A
  // `vibe.dbgargs` custom section publishes the two addresses to the runner.
  // Off => dbgargs_reserve is 0 and the layout/codegen is byte-identical to a
  // normal build (the self-host fixpoint is unaffected).
  let dbgargs_cap = 16
  let dbgargs_count_addr = trace_counter_addr + trace_reserve
  let dbgargs_base = dbgargs_count_addr + 8
  let dbgargs_reserve = if debug_break {
    8 + dbgargs_cap * 8
  } else {
    0
  }
  // ADR-0092 (#1262) KPI follow-up 2: size-segregated free-list bins for
  // small RC blocks. 32 bin heads (4 bytes each, sizes 16..264 step 8) live
  // just below the bump base; the bump base moves up by the 128-byte table
  // (rounded to 256 for alignment headroom). Linear memory is zero-page
  // initialized and the data segments end below heap_start, so the bins
  // start empty without an explicit memset. gen_rc_drop_body pushes
  // small freed blocks onto their exact-size bin (O(1) exact fit on the
  // alloc side); everything else stays on the legacy global-2 list with
  // the bounded walk.
  let rc_bins_base = heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve
  let rc_bins_reserve = if enable_rc {
    256
  } else {
    0
  }
  let cov_state = CovState::{
    enabled: coverage,
    base: cov_branch_base,
    cap: cov_branch_cap,
    next: [
      0
    ],
    cur_fn: [
      0
    ],
    owners: ArrayBuilder::freeze(ArrayBuilder::new())
  }
  // #799 perf: ONE program walk collecting the canonical free-name set,
  // then every need_<builtin> flag below is a map lookup. Previously each
  // flag re-walked the whole AST (~40 walks) with a linear fn_names scan per
  // ident inside.
  let used_builtin_names = collect_used_builtin_names(stmts, fn_names_list)
  // ADR-0090 (#1262): the region arena segment. `region r { body }` parses to
  // `__region_run(lam)`, so its presence in the canonical free-name set is
  // exactly "this module has a region".
  //
  // The arena is an INDEPENDENT bump segment, not a watermark over the main
  // heap, and that separation is the whole point: the region body allocates
  // ordinary heap values too (a tuple, a string) which are allowed to escape,
  // and a watermark reset over the shared bump pointer would reclaim those.
  // Only `MutList` storage goes here, and the sanctioned exits copy OUT of it
  // (compile_call.vibe :: mutlist_exit_copy) before the segment is released.
  //
  // Layout: [bump ptr @+0][depth @+4][saved bump ptrs @+8, 64 levels][data].
  // The control words live in linear memory rather than wasm globals so the
  // save/restore needs no locals at the call site and no change to the global
  // index formula (g_op_index / thunk globals are positional). Memory is
  // zero-page initialized and the data segments end below heap_start, so a
  // zero bump ptr means "never entered" and the bodies lazily seed it.
  //
  // Bump-lane only. Under RC a region block would carry an RC header and
  // eventually reach the free list, which the bulk release invalidates; the
  // RC lane keeps today's behavior (MutList == ArrayBuilder on the main heap)
  // until the Perceus exemption lands. The bump lane is also where the arena
  // is worth anything: it never frees, so bulk release is pure win.
  let need_region_arena = Map::has_key(used_builtin_names, "__region_run") && !enable_rc
  let region_ctl_base = heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve + rc_bins_reserve
  let region_ptr_addr = if need_region_arena {
    region_ctl_base
  } else {
    -1
  }
  // Derived through the common_base helpers so the emitter (compile_call.vibe,
  // which only receives region_ptr_addr) and this layout cannot drift apart.
  let region_saves_base = region_saves_base_of(region_ctl_base)
  let region_data_base = ((region_saves_base + region_max_depth() * 4 + 7) / 8) * 8
  // 256 KiB. Overflow is not an error: the arena bodies fall back to the main
  // bump heap, which is exactly today's behavior, so a region that outgrows
  // the segment gets no reclamation instead of getting corrupted.
  let region_arena_bytes = 262144
  let region_limit = region_data_base + region_arena_bytes
  let region_reserve = if need_region_arena {
    (region_data_base - region_ctl_base) + region_arena_bytes
  } else {
    0
  }
  let uses_stdin_provider_surface = lc_program_defines_top_level(stmts, "__stdin_provider_acquire_surface")
  // #1539: these imports are component-internal, not a standalone core ABI.
  // compile_source_wasi_only wraps only `run : () -> Int with Async`; reject
  // every other entry explicitly rather than emitting an unsatisfied core.
  if uses_stdin_provider_surface && (entry_name != "run" || !lc_entry_declares_async(stmts, entry_name)) {
    throw("Stdin::read_via_stream requires an Async component entry named run; standalone core/library and non-Async entries cannot provide the stdin lifecycle")
  } else {
    ()
  }
  let need_env_get_builtin = Map::has_key(used_builtin_names, "Env::get")
  let need_env_args_len_builtin = Map::has_key(used_builtin_names, "Env::args_len")
  let need_env_args_get_builtin = Map::has_key(used_builtin_names, "Env::args_get")
  let need_fs_read_file_builtin = Map::has_key(used_builtin_names, "Fs::read_file")
  let need_fs_exists_builtin = Map::has_key(used_builtin_names, "Fs::exists")
  // #795: vibe_fs_stat_token_raw is the alias-collision-proof surface for the
  // same import (lib/@vibe/fs/fs.vibe calls it; see checker/builtins_fs.vibe).
  let need_fs_stat_token_builtin = Map::has_key(used_builtin_names, "Fs::stat_token") || Map::has_key(used_builtin_names, "vibe_fs_stat_token_raw")
  let need_fs_write_file_builtin = Map::has_key(used_builtin_names, "Fs::write_file")
  // Atomically publish text only when the target is absent. Kept unused by
  // compiler sources until the future cache-publisher PR adopts it.
  let need_fs_publish_immutable_text_builtin = Map::has_key(used_builtin_names, "Fs::publish_immutable_text")
  let need_fs_write_bytes_builtin = Map::has_key(used_builtin_names, "Fs::write_bytes")
  // #632: `Fs::read_bytes(path) -> Bytes` — the binary-exact read counterpart of
  // Fs::write_bytes, a `vibe.fs_read_bytes (i64) -> i64` host import (type 3,
  // same shape as fs_read_file). Gated on use so non-users reserve no import
  // (fixpoint-safe). Lets the persistent artifact cache store/load wasm raw.
  let need_fs_read_bytes_builtin = Map::has_key(used_builtin_names, "Fs::read_bytes")
  // #729/#730: `Fs::readdir(path) -> Array[String]` — a `vibe.fs_read_dir
  // (i64) -> i64` host import (type 3, same packed-string shape as
  // fs_read_file: the host returns the byte-sorted entry NAMES "\n"-joined as
  // ONE string, no host-side array building). compile_call lowers the
  // Array[String] surface to `String::split` over that string. Gated on use
  // (fixpoint-safe). Unblocks contract-package sibling auto-discovery and the
  // global store walk.
  let need_fs_readdir_builtin = Map::has_key(used_builtin_names, "Fs::readdir")
  let need_profiler_now_us_builtin = Map::has_key(used_builtin_names, "Profiler::now_us")
  // `Profiler::heap_bytes() -> Int`: a `vibe.profile-heap-bytes () -> i64`
  // host import (type 5, same shape as profile-now-us). Returns the guest's
  // current bump-heap pointer (`__heap_ptr`) so vibe code can attribute its
  // own allocation growth per phase, mirroring how now_us attributes time.
  // Gated on use so non-users reserve no import (fixpoint-safe).
  let need_profiler_heap_bytes_builtin = Map::has_key(used_builtin_names, "Profiler::heap_bytes")
  // `sleep(ms)` (Async): a `vibe.sleep (i64) -> ()` host import. The host
  // implements it as an async function so the guest fiber genuinely
  // suspends/resumes (docs/spec/wasi-p3-async.md §2.3, examples/async_host).
  // Gated on use, so programs without `sleep` reserve no import (fixpoint-safe).
  let need_sleep_builtin = Map::has_key(used_builtin_names, "sleep") || Map::has_key(used_builtin_names, "sleep_blocking")
  // `Stdin::read_char() -> Int`: a value-returning `vibe.stdin_read_char () ->
  // i64` host import. Implemented async by the host (it can suspend the guest
  // until a char is available), so this is the data-consuming analog of `sleep`
  // — the shape of a host async source (HTTP body byte, stdin char). Gated on
  // use (fixpoint-safe).
  let need_stdin_read_char_builtin = Map::has_key(used_builtin_names, "Stdin::read_char")
  // ADR-0089 step 4 (#1218): host-future imports -- `vibe.host_future_get
  // () -> i64` (the tagged readable-end handle) and `vibe.host_future_wait
  // (i64) -> i64` (park on the handle via waitable-set.wait, return the
  // resolved value). Only the component adapter module implements them
  // (spec §3.13/§3.14); a plain-wasm host cannot. One flag gates BOTH:
  // `host_future_get` in user code implies the boundary's `__entry_settle`
  // needs the wait half, and the raw names appear in injected AST after
  // collect (the injection runs before this collect, so they land in
  // used_builtin_names either way). Gated on use (fixpoint-safe).
  // ADR-0089 (c) (#1218): the program's NAMED host futures (sorted, deduped).
  // Each one gets its own `vibe.host_future_get$<name>` core import; they all
  // share the single `vibe.host_future_wait` half, so having any of them
  // implies need_host_future_builtin below.
  let hf_named_names = lc_collect_host_future_names(stmts)
  // The ANONYMOUS `vibe.host_future_get` import is reserved only for the
  // anonymous surface: a program that awaits `host_future_named("price")`
  // alone must import `price`, not a `get-future` nothing calls (an unused
  // import is still an import the host has to satisfy).
  let need_host_future_builtin = Map::has_key(used_builtin_names, "host_future_get") || Map::has_key(used_builtin_names, "vibe_hf_get_raw")
  // The WAIT half is shared by every host future: `__entry_settle`'s
  // waitable arm parks on a handle without caring where it came from.
  let need_host_future_wait_builtin = need_host_future_builtin || Map::has_key(used_builtin_names, "vibe_hf_wait_raw") || Array::length(hf_named_names) > 0
  // ADR-0089 Decision 3 (#1218): the program's NAMED host streams (sorted,
  // deduped). Each gets its own `vibe.host_stream_get$<name>` core import;
  // they all share the single `vibe.host_stream_read` half (park is per
  // read, but the read body only needs the handle), which the injected
  // `__entry_settle` stream arm calls -- the injection runs before the
  // used-name collect, so the raw name also lands in used_builtin_names.
  let hs_named_names = lc_collect_host_stream_names(stmts)
  let need_host_stream_read_builtin = Map::has_key(used_builtin_names, "vibe_hs_read_raw") || Array::length(hs_named_names) > 0
  // ADR-0089 Decision 3 follow-up (#1218): the shared CLOSE half. Gated on
  // ACTUAL use (unlike the read half, which every named stream implies) so
  // a program that always drains to EOS reserves no extra import and its
  // module bytes are unchanged -- the injected `__hs_close` is the only
  // caller, and it only exists when the source called `host_stream_close`.
  let need_host_stream_close_builtin = Map::has_key(used_builtin_names, "vibe_hs_close_raw")
  // #1539 public names and checker-hidden raw names share the exact three
  // component-private import targets. Gate each half independently.
  let need_stdin_provider_acquire_builtin = Map::has_key(used_builtin_names, "vibe_stdin_provider_acquire_raw") || Map::has_key(used_builtin_names, "Stdin::read_via_stream")
  let need_stdin_provider_read_builtin = Map::has_key(used_builtin_names, "vibe_stdin_provider_read_raw") || Map::has_key(used_builtin_names, "StdinStream::next")
  let need_stdin_provider_close_builtin = Map::has_key(used_builtin_names, "vibe_stdin_provider_close_raw") || Map::has_key(used_builtin_names, "StdinStream::close")
  // Process effect host imports: `sh(cmd)` runs a shell command (returns 0) and
  // `sh_lines(cmd)` returns its stdout "\n"-joined as ONE string (same packed
  // ABI as fs_read_dir; compile_call lowers the Array[String] surface to a
  // String::split). Both `vibe.sh` / `vibe.sh_lines (i64) -> i64` host imports,
  // gated on use so non-users reserve no import (fixpoint-safe). Revives the
  // process/time/shell stdlib whose functions call these.
  let need_sh_builtin = Map::has_key(used_builtin_names, "sh")
  let need_sh_lines_builtin = Map::has_key(used_builtin_names, "sh_lines")
  // #865: structured subprocess result host imports -- `vibe_sh_capture_raw`
  // runs the command once (handle), the three accessors read the cached
  // {exit_code, stdout, stderr}, `vibe_sh_capture_close_raw` frees it. Same
  // handle+accessor shape as the #794 HTTP client imports below. Gated on
  // use, same fixpoint-safety discipline as sh/sh_lines above.
  let need_sh_capture_builtin = Map::has_key(used_builtin_names, "vibe_sh_capture_raw")
  let need_sh_capture_exit_code_builtin = Map::has_key(used_builtin_names, "vibe_sh_capture_exit_code_raw")
  let need_sh_capture_stdout_builtin = Map::has_key(used_builtin_names, "vibe_sh_capture_stdout_raw")
  let need_sh_capture_stderr_builtin = Map::has_key(used_builtin_names, "vibe_sh_capture_stderr_raw")
  let need_sh_capture_close_builtin = Map::has_key(used_builtin_names, "vibe_sh_capture_close_raw")
  // #903/#865: `Process::exit(code) -> Unit` -- propagates the guest's exit
  // code to the real OS process exit status via the host runner's
  // exit-trap mechanism (never returns in practice, but is typed Unit --
  // there's no `Never` type). `vibe.process_exit (i64) -> ()` host import,
  // void like Fs::remove/sh_capture_close, gated on use (fixpoint-safe).
  let need_process_exit_builtin = Map::has_key(used_builtin_names, "vibe_process_exit_raw")
  // Stdin/Stdout host effects for vibe/io: `Stdin::read_stream(n) -> String`
  // (`vibe.stdin_read_stream (i64) -> i64`, value-returning like fs_read_file),
  // `Stdout::write_stream(s) -> Unit` and `Stdout::write_char(c) -> Unit`
  // (`vibe.stdout_write_stream` / `vibe.stdout_write_char (i64) -> ()`, void like
  // sleep). All gated on use so non-users reserve no import (fixpoint-safe) —
  // the compiler's own build uses none, so its bytes are unchanged. Revives the
  // io stdlib whose read/print/println/write_char helpers call these builtins.
  // #1460 Phase 1: the `Console::*` spellings share these imports rather than
  // reserving their own. The linear host ABI is `vibe.<snake_name>` -- the
  // module is the literal "vibe" and the field comes from the operation, so
  // it never carried the effect label and merging Stdin/Stdout/Stderr into
  // `Console` is a source-and-checker rename with NO ABI consequence. Reusing
  // the imports also keeps the compiler's own bytes unchanged while both name
  // sets are live, which is what makes the pre-seed-bump build a fixpoint.
  let need_stdin_read_stream_builtin = Map::has_key(used_builtin_names, "Stdin::read_stream") || Map::has_key(used_builtin_names, "Console::read_stream")
  // #929: the println/print BUILTIN lowering (compile_call.vibe) synthesizes
  // calls onto these two imports when no source-provided println/print is
  // merged, so their use also gates the imports in. collect_used_builtin_names
  // only counts FREE names -- a program using @vibe/io's (or its own) println
  // fn does not trip this, exactly matching the lowering's cc_ft_has guard.
  let used_print_builtin = Map::has_key(used_builtin_names, "println") || Map::has_key(used_builtin_names, "print")
  let need_stdout_write_stream_builtin = Map::has_key(used_builtin_names, "Stdout::write_stream") || Map::has_key(used_builtin_names, "Console::write_stream") || used_print_builtin
  let need_stdout_write_char_builtin = Map::has_key(used_builtin_names, "Stdout::write_char") || Map::has_key(used_builtin_names, "Console::write_char") || used_print_builtin
  // #865: `Stderr::write_stream(s) -> Unit` / `Stderr::write_char(c) -> Unit`
  // (`vibe.stderr_write_stream` / `vibe.stderr_write_char (i64) -> ()`, void
  // like stdout's), same shapes/gating as the Stdout pair above.
  let need_stderr_write_stream_builtin = Map::has_key(used_builtin_names, "Stderr::write_stream") || Map::has_key(used_builtin_names, "Console::write_err_stream")
  let need_stderr_write_char_builtin = Map::has_key(used_builtin_names, "Stderr::write_char") || Map::has_key(used_builtin_names, "Console::write_err_char")
  // #762: `Path::ref` / `Path::resolve` both lower (compile_call) to the
  // `resolve_path` host import — resolve a path to absolute against the process
  // CWD. `vibe.resolve_path (i64) -> i64`, value-returning like fs_read_file,
  // gated on either surface name so non-users reserve no import (fixpoint-safe).
  let need_resolve_path_builtin = Map::has_key(used_builtin_names, "Path::ref") || Map::has_key(used_builtin_names, "Path::resolve")
  // #768: `Fs::remove(path) -> Unit` — a `vibe.fs_remove (i64) -> ()` host
  // import (type 1, like sleep/stdout_write_char). Checker-recognized since
  // `builtins_fs.vibe`'s `lookup_fs_remove` but never wired to codegen, so any
  // caller hit "undefined variable (local): Fs::remove @call". Gated on use so
  // non-users reserve no import (fixpoint-safe).
  let need_fs_remove_builtin = Map::has_key(used_builtin_names, "Fs::remove")
