  // dynamic names, not builtins.
  verify_lane_builtins("linear", builtin_names_list, builtin_param_counts, builtin_returns_list)
  let mut li_reg = 0
  while li_reg < Array::length(linked_imports) {
    let (_, lfn_name, lparams, lreturns) = Array::get(linked_imports, li_reg)
    Array::push(builtin_names_list, lfn_name)
    Array::push(builtin_param_counts, lparams)
    Array::push(builtin_needs_env_list, true)
    Array::push(builtin_indices_list, Array::get(linked_import_indices, li_reg))
    Array::push(builtin_returns_list, lreturns)
    li_reg = li_reg + 1
  }
  let mut all_fn_i = 0
  while all_fn_i < Array::length(builtin_names_list) {
    Array::push(fn_names_list, Array::get(builtin_names_list, all_fn_i))
    Array::push(fn_param_counts, Array::get(builtin_param_counts, all_fn_i))
    Array::push(fn_needs_env_list, Array::get(builtin_needs_env_list, all_fn_i))
    Array::push(fn_indices_list, Array::get(builtin_indices_list, all_fn_i))
    Array::push(fn_returns_list, Array::get(builtin_returns_list, all_fn_i))
