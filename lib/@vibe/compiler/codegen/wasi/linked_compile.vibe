  // `debug_trace`). A dedicated region directly above the coverage regions and
  // below the heap frontier holds a 4-byte counter cell followed by a fixed-cap
  // log of i32 slots. Each user function's entry, in debug mode, appends its
  // own user index to the log (counter-bounded). A `vibe.trace` custom section
  // records the layout + function names so the runner can dump the entry
  // sequence. Off => trace_reserve is 0 and the layout/codegen is byte-identical
  // to a normal build (the self-host fixpoint is unaffected).
  let trace_cap = 4096
  let trace_counter_addr = cov_branch_base + cov_branch_reserve
