  let tcp_write_import_idx = if need_tcp_write_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let tcp_close_import_idx = if need_tcp_close_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  // #794: HTTP client imports -- reserved after fs_getcwd (before dbg_break),
  // in the same order as their emission below.
  let http_request_import_idx = if need_http_request_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let http_response_status_import_idx = if need_http_response_status_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let http_response_header_import_idx = if need_http_response_header_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let http_response_body_import_idx = if need_http_response_body_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let http_close_import_idx = if need_http_close_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  // #865: `Process::capture` host imports -- reserved after http_close
  // (before dbg_break), in the same order as their emission below. All five
  // reuse EXISTING base func types (3 = `(i64)->i64`, 1 = `(i64)->()`), so no
  // new type-section entry is needed (unlike #794's http_request).
  let sh_capture_import_idx = if need_sh_capture_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let sh_capture_exit_code_import_idx = if need_sh_capture_exit_code_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let sh_capture_stdout_import_idx = if need_sh_capture_stdout_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let sh_capture_stderr_import_idx = if need_sh_capture_stderr_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let sh_capture_close_import_idx = if need_sh_capture_close_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  // #903/#865: `Process::exit(code)` host import -- void like Fs::remove
  // (type 1), reserved after sh_capture_close, before Stderr.
  let process_exit_import_idx = if need_process_exit_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  // #865: `Stderr::write_stream` / `Stderr::write_char` host imports --
  // reserved after sh_capture_close (before dbg_break), same shapes as the
  // Stdout pair (type 3 value-returning is N/A here; both are void type 1).
  let stderr_write_stream_import_idx = if need_stderr_write_stream_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let stderr_write_char_import_idx = if need_stderr_write_char_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  // debugger breakpoint (DAP P1): in break mode emit a conditional `vibe::dbg_break`
  // host import (() -> ()) called at each user-function entry. Default OFF, so
  // num_imported_funcs / func_offset are unchanged for normal builds (fixpoint).
  let dbg_break_import_idx = if debug_break {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  // Interior-line breakpoints (span-arc step5): in break mode with per-file
  // provenance, reserve a `vibe::dbg_line (i32 file_id, i32 line) -> ()` host
  // import called at each statement boundary. Each function's line is mapped
  // against ITS OWN source file (prov.file_nls[file_id]) so multi-file entries
  // work. Gated on `debug_break && prov has files`, so default builds reserve
  // nothing and stay byte-identical.
  let dbg_line_on = debug_break && Array::length(prov.files) > 0
  let dbg_line_import_idx = if dbg_line_on {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let linked_import_indices = lc_fresh_int_array()
  let linked_import_names = lc_fresh_string_array()
  let mut li_i = 0
  while li_i < Array::length(linked_imports) {
    let (_, lfn_name, _, _) = Array::get(linked_imports, li_i)
    Array::push(linked_import_indices, next_import_idx)
    Array::push(linked_import_names, lfn_name)
    next_import_idx = next_import_idx + 1
    li_i = li_i + 1
  }
  let num_imported_funcs = next_import_idx
  // #644: static (wasm code offset -> file/line) recorder for the
  // `vibe.linemap` custom section, shared by reference across every
  // top-level function's CompileCtx (mirrors cov_state above). Enabled
  // exactly when interior-line probes are (dbg_line_on): the linemap
  // records the SAME probe sites the live `--break`/dbg_line hook uses.
  let linemap_state = LineMapState::{
    enabled: dbg_line_on,
    cur_fn: [
      0
    ],
    funcs: lc_fresh_int_array(),
    offsets: lc_fresh_int_array(),
    file_ids: lc_fresh_int_array(),
    lines: lc_fresh_int_array()
  }
  let print_int_idx = num_imported_funcs
  let print_str_idx = print_int_idx + 1
  let str_len_idx = print_str_idx + 1
  let str_eq_idx = str_len_idx + 1
  let str_concat_idx = str_eq_idx + 1
  let arr_new_idx = str_concat_idx + 1
  let arr_len_idx = arr_new_idx + 1
  let arr_get_idx = arr_len_idx + 1
  let arr_push_idx = arr_get_idx + 1
  let arr_set_idx = arr_push_idx + 1
  let double_to_int_idx = arr_set_idx + 1
  let int_to_double_idx = double_to_int_idx + 1
  let str_char_code_at_idx = int_to_double_idx + 1
  let str_from_char_code_idx = str_char_code_at_idx + 1
  let str_substring_idx = str_from_char_code_idx + 1
  let identity_idx = str_substring_idx + 1
  let arr_slice_idx = identity_idx + 1
  let arr_concat_idx = arr_slice_idx + 1
  let arr_truncate_idx = arr_concat_idx + 1
  let string_join_idx = arr_truncate_idx + 1
  let fs_read_file_stub_idx = string_join_idx + 1
  let fs_exists_stub_idx = fs_read_file_stub_idx + 1
  let fs_stat_token_stub_idx = fs_exists_stub_idx + 1
  let fs_write_file_stub_idx = fs_stat_token_stub_idx + 1
  let fs_write_bytes_stub_idx = fs_write_file_stub_idx + 1
  let eq_idx = fs_write_bytes_stub_idx + 1
  let string_ends_with_idx = eq_idx + 1
  let string_last_index_of_idx = string_ends_with_idx + 1
  let arr_push_all_idx = string_last_index_of_idx + 1
  let string_index_of_idx = arr_push_all_idx + 1
  let string_contains_idx = string_index_of_idx + 1
  let string_starts_with_idx = string_contains_idx + 1
  let string_split_idx = string_starts_with_idx + 1
  let string_trim_idx = string_split_idx + 1
  let sources_idx = string_trim_idx + 1
  let bytes_new_idx = sources_idx + 1
  let bytes_len_idx = bytes_new_idx + 1
  let bytes_get_idx = bytes_len_idx + 1
  let bytes_set_idx = bytes_get_idx + 1
  let bytes_push_idx = bytes_set_idx + 1
  let bytes_append_idx = bytes_push_idx + 1
  let bytes_concat_idx = bytes_append_idx + 1
  let bytes_slice_idx = bytes_concat_idx + 1
  let bytes_from_array_idx = bytes_slice_idx + 1
  let bytes_to_array_idx = bytes_from_array_idx + 1
  let rc_drop_idx = bytes_to_array_idx + 1
  let rc_alloc_idx = rc_drop_idx + 1
  let heap_grow_check_idx = if enable_rc {
    rc_alloc_idx + 1
  } else {
    bytes_to_array_idx + 1
  }
  let simd_skip_ws_idx = heap_grow_check_idx + 1
  let simd_scan_alnum_idx = simd_skip_ws_idx + 1
  let simd_scan_alnum_str_idx = simd_scan_alnum_idx + 1
  let str_lex_diff_idx = simd_scan_alnum_str_idx + 1
  // #973: erased-generic `[T: Ord]`/`[T: Add]` runtime dispatch (see the doc
  // comment on gen_generic_rel_diff_body). Linear lane only -- desugar_trait_dicts
  // is only invoked from this file, so no gc-lane index is needed.
  let generic_rel_diff_idx = str_lex_diff_idx + 1
  let generic_add_idx = generic_rel_diff_idx + 1
  // Map[String,V] O(1)-average get/has_key (side hash index, see the doc
  // comment on gen_map_hash_body in builtin_bodies/bodies_core_b.vibe).
  // Linear lane only -- gc lane's Map stays the existing O(n) scan.
  let map_hash_idx = generic_add_idx + 1
  let map_cap_idx = map_hash_idx + 1
  let map_index_insert_idx = map_cap_idx + 1
  let map_build_index_idx = map_index_insert_idx + 1
  let map_probe_index_idx = map_build_index_idx + 1
  let env_get_idx = if env_get_import_idx >= 0 {
    env_get_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let env_args_len_idx = if env_args_len_import_idx >= 0 {
    env_args_len_import_idx
  } else {
    fs_exists_stub_idx
  }
  let env_args_get_idx = if env_args_get_import_idx >= 0 {
    env_args_get_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let fs_read_file_idx = if fs_read_file_import_idx >= 0 {
    fs_read_file_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let fs_exists_idx = if fs_exists_import_idx >= 0 {
    fs_exists_import_idx
  } else {
    fs_exists_stub_idx
  }
  let fs_stat_token_idx = if fs_stat_token_import_idx >= 0 {
    fs_stat_token_import_idx
  } else {
    fs_stat_token_stub_idx
  }
  let fs_write_file_idx = if fs_write_file_import_idx >= 0 {
    fs_write_file_import_idx
  } else {
    fs_write_file_stub_idx
  }
  let fs_write_bytes_idx = if fs_write_bytes_import_idx >= 0 {
    fs_write_bytes_import_idx
  } else {
    fs_write_bytes_stub_idx
  }
  // #632: no dedicated stub — when read_bytes is unused the builtin index just
  // needs SOME valid never-called slot, so reuse the fs_read_file stub (a
  // `(i64)->i64` placeholder). The real call site only exists when the import is
  // reserved.
  let fs_read_bytes_idx = if fs_read_bytes_import_idx >= 0 {
    fs_read_bytes_import_idx
  } else {
    fs_read_file_stub_idx
  }
  // #729/#730: like read_bytes, no dedicated stub — unused readdir reuses the
  // fs_read_file stub (a `(i64)->i64` never-called placeholder).
  let fs_read_dir_idx = if fs_read_dir_import_idx >= 0 {
    fs_read_dir_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let profiler_now_us_idx = if profiler_now_us_import_idx >= 0 {
    profiler_now_us_import_idx
  } else {
    env_args_len_idx
  }
  // Profiler::heap_bytes call target: the import when reserved, else a
  // never-called `() -> i64` stub (mirrors now_us's fallback).
  let profiler_heap_bytes_idx = if profiler_heap_bytes_import_idx >= 0 {
    profiler_heap_bytes_import_idx
  } else {
    env_args_len_idx
  }
  // `sleep` call target: the import when reserved, else a never-called stub
  // (the builtin is only emitted as a call when the program uses `sleep`, which
  // is exactly when the import is reserved).
  let sleep_idx = if sleep_import_idx >= 0 {
    sleep_import_idx
  } else {
    env_args_len_idx
  }
  let stdin_read_char_idx = if stdin_read_char_import_idx >= 0 {
    stdin_read_char_import_idx
  } else {
    env_args_len_idx
  }
  // sh / sh_lines call targets: the import when reserved, else the fs_read_file
  // stub (a `(i64)->i64` never-called placeholder) — the real call site only
  // exists when the import is reserved (i.e. when the program uses sh/sh_lines).
  let sh_idx = if sh_import_idx >= 0 {
    sh_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let sh_lines_idx = if sh_lines_import_idx >= 0 {
    sh_lines_import_idx
  } else {
    fs_read_file_stub_idx
  }
  // Stdin::read_stream / Stdout::write_stream / Stdout::write_char call targets:
  // the import when reserved, else a never-called stub (read_stream is
  // value-returning like sh -> fs_read_file stub; the void write ops mirror
  // sleep's fallback to env_args_len). The real call site only exists when the
  // matching import is reserved (i.e. when the program uses io).
  let stdin_read_stream_idx = if stdin_read_stream_import_idx >= 0 {
    stdin_read_stream_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let stdout_write_stream_idx = if stdout_write_stream_import_idx >= 0 {
    stdout_write_stream_import_idx
  } else {
    env_args_len_idx
  }
  let stdout_write_char_idx = if stdout_write_char_import_idx >= 0 {
    stdout_write_char_import_idx
  } else {
    env_args_len_idx
  }
  // resolve_path call target: the import when reserved, else the fs_read_file
  // stub (a `(i64)->i64` never-called placeholder — same shape).
  let resolve_path_idx = if resolve_path_import_idx >= 0 {
    resolve_path_import_idx
  } else {
    fs_read_file_stub_idx
  }
  // #768: Fs::remove call target — the import when reserved, else a
  // never-called stub (void return, so mirrors sleep_idx/stdout_write_char_idx's
  // fallback to env_args_len_idx).
  let fs_remove_idx = if fs_remove_import_idx >= 0 {
    fs_remove_import_idx
  } else {
    env_args_len_idx
  }
  // #768: Fs::mkdir_p call target — same fallback shape as fs_remove_idx.
  let fs_mkdir_p_idx = if fs_mkdir_p_import_idx >= 0 {
    fs_mkdir_p_import_idx
  } else {
    env_args_len_idx
  }
  // #768: void Fs ops (mkdir/chdir/copy/append/rename) — same fallback shape
  // as fs_remove_idx/fs_mkdir_p_idx.
  let fs_mkdir_idx = if fs_mkdir_import_idx >= 0 {
    fs_mkdir_import_idx
  } else {
    env_args_len_idx
  }
  let fs_chdir_idx = if fs_chdir_import_idx >= 0 {
    fs_chdir_import_idx
  } else {
    env_args_len_idx
  }
  let fs_copy_idx = if fs_copy_import_idx >= 0 {
    fs_copy_import_idx
  } else {
    env_args_len_idx
  }
  let fs_append_idx = if fs_append_import_idx >= 0 {
    fs_append_import_idx
  } else {
    env_args_len_idx
  }
  let fs_rename_idx = if fs_rename_import_idx >= 0 {
    fs_rename_import_idx
  } else {
    env_args_len_idx
  }
  // #768: value-returning Fs ops (is_dir/is_file bool, getcwd string) —
  // fallback to the fs_read_file stub (an `(i64)->i64`-shaped never-called
  // placeholder), same as other value-returning fallbacks above.
  let fs_is_dir_idx = if fs_is_dir_import_idx >= 0 {
    fs_is_dir_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let fs_is_file_idx = if fs_is_file_import_idx >= 0 {
    fs_is_file_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let fs_getcwd_idx = if fs_getcwd_import_idx >= 0 {
    fs_getcwd_import_idx
  } else {
    env_args_len_idx
  }
  // Socket: never-called placeholders when unused, like the Fs fallbacks
  // above -- tcp_connect/tcp_read return a value (Int handle / String),
  // tcp_write/tcp_close are void (Unit).
  let tcp_connect_idx = if tcp_connect_import_idx >= 0 {
    tcp_connect_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let tcp_read_idx = if tcp_read_import_idx >= 0 {
    tcp_read_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let tcp_write_idx = if tcp_write_import_idx >= 0 {
    tcp_write_import_idx
  } else {
    env_args_len_idx
  }
  let tcp_close_idx = if tcp_close_import_idx >= 0 {
    tcp_close_import_idx
  } else {
    env_args_len_idx
  }
  // #794: never-called placeholders when unused, like the Fs fallbacks above.
  let http_request_idx = if http_request_import_idx >= 0 {
    http_request_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let http_response_status_idx = if http_response_status_import_idx >= 0 {
    http_response_status_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let http_response_header_idx = if http_response_header_import_idx >= 0 {
    http_response_header_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let http_response_body_idx = if http_response_body_import_idx >= 0 {
    http_response_body_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let http_close_idx = if http_close_import_idx >= 0 {
    http_close_import_idx
  } else {
    fs_read_file_stub_idx
  }
  // #865: never-called placeholders when unused, like the http fallbacks
  // above. The four value-returning ops fall back to the fs_read_file stub
  // (a `(i64)->i64` never-called placeholder); the void close op falls back
  // to env_args_len_idx, mirroring fs_remove_idx/http_close_idx's own choice.
  let sh_capture_idx = if sh_capture_import_idx >= 0 {
    sh_capture_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let sh_capture_exit_code_idx = if sh_capture_exit_code_import_idx >= 0 {
    sh_capture_exit_code_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let sh_capture_stdout_idx = if sh_capture_stdout_import_idx >= 0 {
    sh_capture_stdout_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let sh_capture_stderr_idx = if sh_capture_stderr_import_idx >= 0 {
    sh_capture_stderr_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let sh_capture_close_idx = if sh_capture_close_import_idx >= 0 {
    sh_capture_close_import_idx
  } else {
    env_args_len_idx
  }
  // #903/#865: Process::exit call target -- void op, same fallback shape as
  // fs_remove_idx/sh_capture_close_idx.
  let process_exit_idx = if process_exit_import_idx >= 0 {
    process_exit_import_idx
  } else {
    env_args_len_idx
  }
  // #865: Stderr::write_stream / Stderr::write_char call targets -- void ops,
  // same fallback shape as stdout_write_stream_idx/stdout_write_char_idx.
  let stderr_write_stream_idx = if stderr_write_stream_import_idx >= 0 {
    stderr_write_stream_import_idx
  } else {
    env_args_len_idx
  }
  let stderr_write_char_idx = if stderr_write_char_import_idx >= 0 {
    stderr_write_char_import_idx
  } else {
    env_args_len_idx
  }
  // Map hash-index builtins (map_hash_idx..map_probe_index_idx) are the new
  // last-registered builtins -- this MUST track whatever push_builtin call
  // is last, independently of the bodies/meta_i32/meta_i64/builtin_type_idxs
  // array bookkeeping above (num_generated/func_offset below are derived
  // from THIS constant, not from Array::length(bodies), so adding builtins
  // without updating this stale-by-construction line silently shifts every
  // user-function call target in the module by the number of builtins added).
  let max_builtin_func_idx = map_probe_index_idx
  let num_generated = (max_builtin_func_idx - num_imported_funcs) + 1
  let func_offset = num_imported_funcs + num_generated
  let fn_indices_list = lc_fresh_int_array()
  let fn_returns_list = lc_fresh_int_array()
  let mut fi = 0
  while fi < num_user_funcs {
    Array::push(fn_indices_list, fi + func_offset)
    Array::push(fn_returns_list, 1)
    fi = fi + 1
  }
  let builtin_names_list = lc_fresh_string_array()
  let builtin_param_counts = lc_fresh_int_array()
  let builtin_needs_env_list = lc_fresh_bool_array()
  let builtin_indices_list = lc_fresh_int_array()
  let builtin_returns_list = lc_fresh_int_array()
  // #415 B-1: the central registry DRIVES the linear lane's registration.
  // Names, param counts, and returns come straight from builtin_registry()
  // rows with in_linear = true; only the function INDEX is lane-local (the
  // idx bindings computed above), resolved by the match below. Adding a
  // linear builtin = one registry row + one match arm here (+ the import /
  // body wiring); param-count and returns live ONLY in the registry.
  // needs_env is false for every static builtin -- only the linked-import
  // bridges appended after verify carry an env. vibe_rc_drop/vibe_rc_alloc
  // register under RC builds only (mirrored by verify_lane_builtins'
  // vibe_rc_ exemption).
  let registry_rows = builtin_registry()
  let mut reg_i = 0
  while reg_i < Array::length(registry_rows) {
    let (reg_name, reg_params, reg_returns, reg_linear, _) = Array::get(registry_rows, reg_i)
    let reg_include = reg_linear && (enable_rc || !String::starts_with(reg_name, "vibe_rc_"))
    if reg_include {
      let reg_idx = match reg_name {
        "Env::get" => env_get_idx,
        "Env::args_len" => env_args_len_idx,
        "Env::args_get" => env_args_get_idx,
        "Fs::read_file" => fs_read_file_idx,
        "Fs::exists" => fs_exists_idx,
        "Fs::stat_token" => fs_stat_token_idx,
        // #795: alias-collision-proof name, same import index as Fs::stat_token.
        "vibe_fs_stat_token_raw" => fs_stat_token_idx,
        "Fs::write_file" => fs_write_file_idx,
        "Fs::write_bytes" => fs_write_bytes_idx,
        "Fs::read_bytes" => fs_read_bytes_idx,
        // #729/#730: RAW half of Fs::readdir -- compile_call lowers the surface.
        "vibe_fs_read_dir_raw" => fs_read_dir_idx,
        "Fs::remove" => fs_remove_idx,
        "Fs::mkdir_p" => fs_mkdir_p_idx,
        "Fs::mkdir" => fs_mkdir_idx,
        "Fs::chdir" => fs_chdir_idx,
        "Fs::copy" => fs_copy_idx,
        "Fs::append" => fs_append_idx,
        "Fs::rename" => fs_rename_idx,
        "Fs::is_dir" => fs_is_dir_idx,
        "Fs::is_file" => fs_is_file_idx,
        "Fs::getcwd" => fs_getcwd_idx,
        "vibe_tcp_connect_raw" => tcp_connect_idx,
        "vibe_tcp_read_raw" => tcp_read_idx,
        "vibe_tcp_write_raw" => tcp_write_idx,
        "vibe_tcp_close_raw" => tcp_close_idx,
        // #794: HTTP client host ops (raw dunder surface names, see checker/builtins_net.vibe).
        "vibe_http_request_raw" => http_request_idx,
        "vibe_http_response_status_raw" => http_response_status_idx,
        "vibe_http_response_header_raw" => http_response_header_idx,
        "vibe_http_response_body_raw" => http_response_body_idx,
        "vibe_http_close_raw" => http_close_idx,
        "sh" => sh_idx,
        // RAW half of sh_lines -- compile_call lowers the Array[String] surface.
        "vibe_sh_lines_raw" => sh_lines_idx,
        // #865: structured subprocess result (raw dunder names -- called
        // directly from lib/@vibe/process/process.vibe, same convention as
        // the vibe_http_*_raw names above).
        "vibe_sh_capture_raw" => sh_capture_idx,
        "vibe_sh_capture_exit_code_raw" => sh_capture_exit_code_idx,
        "vibe_sh_capture_stdout_raw" => sh_capture_stdout_idx,
        "vibe_sh_capture_stderr_raw" => sh_capture_stderr_idx,
        "vibe_sh_capture_close_raw" => sh_capture_close_idx,
        "vibe_process_exit_raw" => process_exit_idx,
        "Stdin::read_stream" => stdin_read_stream_idx,
        "Stdout::write_stream" => stdout_write_stream_idx,
        "Stdout::write_char" => stdout_write_char_idx,
        // #865: Stderr, same shapes as the Stdout pair above.
        "Stderr::write_stream" => stderr_write_stream_idx,
        "Stderr::write_char" => stderr_write_char_idx,
        // #762: RAW host op behind Path::ref / Path::resolve.
        "resolve_path" => resolve_path_idx,
        "Profiler::now_us" => profiler_now_us_idx,
        "Profiler::NowUs" => profiler_now_us_idx,
        "Profiler::heap_bytes" => profiler_heap_bytes_idx,
        "Profiler::HeapBytes" => profiler_heap_bytes_idx,
        "sleep" => sleep_idx,
        // #1227: row-free sibling, same host import.
        "sleep_blocking" => sleep_idx,
        "Stdin::read_char" => stdin_read_char_idx,
        "simd_skip_ws" => simd_skip_ws_idx,
        "simd_scan_alnum" => simd_scan_alnum_idx,
        "simd_scan_alnum_str" => simd_scan_alnum_str_idx,
        // #746: backs String < > <= >= (desugar rewrites to str_lex_diff(a,b) <op> 0).
        "str_lex_diff" => str_lex_diff_idx,
        // #973: backs `<`/`>`/`<=`/`>=`/`+` on an erased `[T: Ord]`/`[T: Add]`
        // generic operand (desugar_trait_dict.vibe rewrites the binop when the
        // operand's static type is the bare unresolved type parameter).
        "__generic_rel_diff" => generic_rel_diff_idx,
        "__generic_add" => generic_add_idx,
        "print_int" => print_int_idx,
        "print_str" => print_str_idx,
        "String::length" => str_len_idx,
        "String::equals" => str_eq_idx,
        "String::concat" => str_concat_idx,
        "array_new" => arr_new_idx,
        "Array::length" => arr_len_idx,
        "Array::get" => arr_get_idx,
        "Array::push" => arr_push_idx,
        "Array::push_all" => arr_push_all_idx,
        "Array::set" => arr_set_idx,
        "Double::to_int" => double_to_int_idx,
        "Int::to_double" => int_to_double_idx,
        "String::char_code_at" => str_char_code_at_idx,
        "String::from_char_code" => str_from_char_code_idx,
        "String::substring" => str_substring_idx,
        "Array::truncate" => arr_truncate_idx,
        "String::join" => string_join_idx,
        "eq" => eq_idx,
        "String::ends_with" => string_ends_with_idx,
        "String::last_index_of" => string_last_index_of_idx,
        "String::index_of" => string_index_of_idx,
        "String::contains" => string_contains_idx,
        "String::starts_with" => string_starts_with_idx,
        "String::split" => string_split_idx,
        "String::trim" => string_trim_idx,
        "compiler_sources" => sources_idx,
        "ArrayBuilder::new" => arr_new_idx,
        "ArrayBuilder::push" => arr_push_idx,
        "ArrayBuilder::freeze" => identity_idx,
        // #906: FrozenArray[T] -- from_array/to_array are pure identity
        // casts (same runtime layout as Array[T]); get/length alias
        // Array::get/Array::length's own bodies.
        "FrozenArray::from_array" => identity_idx,
        "FrozenArray::to_array" => identity_idx,
        "FrozenArray::get" => arr_get_idx,
        "FrozenArray::length" => arr_len_idx,
        "Array::slice" => arr_slice_idx,
        "Array::concat" => arr_concat_idx,
        "Bytes::new" => bytes_new_idx,
        "Bytes::from_array" => bytes_from_array_idx,
        "Bytes::to_array" => bytes_to_array_idx,
        "Bytes::length" => bytes_len_idx,
        "Bytes::get" => bytes_get_idx,
        "Bytes::set" => bytes_set_idx,
        "Bytes::push" => bytes_push_idx,
        "Bytes::append" => bytes_append_idx,
        "Bytes::concat" => bytes_concat_idx,
        "Bytes::slice" => bytes_slice_idx,
        "Double::to_i64_bits" => identity_idx,
        "__to_string" => identity_idx,
        "vibe_rc_drop" => rc_drop_idx,
        "vibe_rc_alloc" => rc_alloc_idx,
        "vibe_heap_grow_check" => heap_grow_check_idx,
        _ => 0 - 1
      }
      if reg_idx < 0 {
        throw("builtin registry drift: no linear function-index mapping for builtin '\{reg_name}' (add a match arm in linked_compile.vibe, #415)")
      } else {
        ()
      }
      Array::push(builtin_names_list, reg_name)
      Array::push(builtin_param_counts, reg_params)
      Array::push(builtin_needs_env_list, false)
      Array::push(builtin_indices_list, reg_idx)
      Array::push(builtin_returns_list, reg_returns)
    } else {
      ()
    }
    reg_i = reg_i + 1
  }
  // #415 B-0: the static registration above must agree with the central
  // registry (name set + params + returns, both directions). Placed BEFORE
  // the linked_imports loop — those are user-declared effect bridges with
  // dynamic names, not builtins.
  verify_lane_builtins("linear", builtin_names_list, builtin_param_counts, builtin_returns_list)
  let mut li_reg = 0
  while li_reg < Array::length(linked_imports) {
    let (_, lfn_name, lparams, lreturns) = Array::get(linked_imports, li_reg)
    Array::push(builtin_names_list, lfn_name)
    Array::push(builtin_param_counts, lparams)
    Array::push(builtin_needs_env_list, true)
    Array::push(builtin_indices_list, Array::get(linked_import_indices, li_reg))
    Array::push(builtin_returns_list, lreturns)
    li_reg = li_reg + 1
  }
  let mut all_fn_i = 0
  while all_fn_i < Array::length(builtin_names_list) {
    Array::push(fn_names_list, Array::get(builtin_names_list, all_fn_i))
    Array::push(fn_param_counts, Array::get(builtin_param_counts, all_fn_i))
    Array::push(fn_needs_env_list, Array::get(builtin_needs_env_list, all_fn_i))
    Array::push(fn_indices_list, Array::get(builtin_indices_list, all_fn_i))
    Array::push(fn_returns_list, Array::get(builtin_returns_list, all_fn_i))
    all_fn_i = all_fn_i + 1
  }
  let all_fn_names_list = fn_names_list
  let all_fn_param_counts = fn_param_counts
  let all_fn_needs_env_list = fn_needs_env_list
  let all_fn_indices_list = fn_indices_list
  let all_fn_returns_list = fn_returns_list
  // #1100: sorted once here (not inside the per-function loop below, which
  // would re-sort this same, unchanging array on every iteration) for
  // func_table_index_of's O(log N) lookups.
  let (all_fn_names_sorted, all_fn_names_sorted_pos) = ctor_sorted_index(all_fn_names_list)
  let num_base_types = 9
  let lt_w = LambdaTable::{
    bodies: lc_fresh_bytes_array(),
    param_counts: lc_fresh_int_array(),
    captures: lc_fresh_string_matrix(),
    meta_i32: lc_fresh_int_array(),
    meta_i64: lc_fresh_int_array()
  }
  // #1107 Phase 4: module-wide recorder of funcref-table slots that codegen
  // materializes as closure values (see CompileCtx.table_slots_used). Created
  // once here — the per-body CompileCtx constructions below all share this
  // array by reference — and consumed by the element-section emission, which
  // registers only the recorded slots.
  let table_slots_used = lc_fresh_int_array()
  let bodies = lc_fresh_bytes_array()
  let meta_i32 = lc_fresh_int_array()
  let meta_i64 = lc_fresh_int_array()
  let builtin_type_idxs = lc_fresh_int_array()
  // #415 B-1: one call = one builtin body. The body bytes, its extra local
  // counts (meta_i32/meta_i64), and its function-section type index are
  // pushed TOGETHER, killing the four-way positional alignment this block
  // used to share with a bare number list ~1,400 lines below (the function
  // section splices builtin_type_idxs in this same order; a count mismatch
  // still throws there).
  let push_builtin: (Bytes, Int, Int, Int) -> Unit = (body, m32, m64, type_idx) -> {
    Array::push(bodies, body)
    Array::push(meta_i32, m32)
    Array::push(meta_i64, m64)
    Array::push(builtin_type_idxs, type_idx)
  }
  push_builtin(static_print_i64_body(), 3, 1, 1)
  push_builtin(static_print_str_body(), 2, 0, 1)
  push_builtin(if enable_rc {
    gen_str_len_body(true)
  } else {
    static_str_len_body()
  }, 0, 0, 3)
  // #748: SIMD chunk compare needs the extra chunk_limit local (meta_i32 6).
  push_builtin(gen_str_eq_body(), 6, 0, 4)
  push_builtin(gen_str_concat_body(), 6, 0, 4)
  if enable_rc {
    push_builtin(gen_arr_new_body(true, rc_alloc_idx), 1, 0, 5)
    push_builtin(gen_arr_len_body(true), 0, 0, 3)
    push_builtin(gen_arr_get_body(true), 1, 0, 4)
    push_builtin(gen_arr_push_body(true, rc_alloc_idx, rc_shadow), 6, 0, 6)
    push_builtin(gen_arr_set_body(true), 1, 0, 7)
  } else {
    push_builtin(gen_arr_new_body(false, rc_alloc_idx), 1, 0, 5)
    push_builtin(static_arr_len_body(), 0, 0, 3)
    push_builtin(static_arr_get_body(), 1, 0, 4)
    push_builtin(gen_arr_push_body(false, rc_alloc_idx, rc_shadow), 6, 0, 6)
    push_builtin(static_arr_set_body(), 1, 0, 7)
  }
  push_builtin(static_double_to_int_body(), 0, 0, 3)
  push_builtin(static_int_to_double_body(), 0, 0, 3)
  push_builtin(if enable_rc {
    gen_str_char_code_at_body(true)
  } else {
    static_str_char_code_at_body()
  }, 1, 0, 4)
  push_builtin(gen_str_from_char_code_body(enable_rc), 1, 0, 3)
  // #982: substring's clamp prologue needs one i64 scratch (len) — meta 2/1.
  push_builtin(gen_str_substring_body(enable_rc), 2, 1, 8)
  push_builtin(static_identity_body(), 0, 0, 3)
  if enable_rc {
    push_builtin(gen_arr_slice_body(true, rc_alloc_idx, rc_shadow), 7, 1, 8)
  } else {
    // #982: the clamp prologue's i64 len scratch (RC reuses local 10 = elem).
    push_builtin(gen_arr_slice_body(false, rc_alloc_idx, rc_shadow), 6, 1, 8)
  }
  push_builtin(gen_arr_concat_body(), 9, 0, 4)
  push_builtin(if enable_rc {
    gen_arr_truncate_body(true)
  } else {
    static_arr_truncate_body()
  }, 0, 0, 6)
  push_builtin(gen_string_join_body(enable_rc, arr_len_idx, arr_get_idx, str_concat_idx), 9, 1, 4)
  push_builtin(static_fs_stub_body(), 0, 0, 3)
  push_builtin(static_fs_stub_body(), 0, 0, 3)
  push_builtin(static_fs_stub_body(), 0, 0, 3)
  push_builtin(static_fs_write_bytes_stub_body(), 0, 0, 6)
  push_builtin(static_fs_write_bytes_stub_body(), 0, 0, 6)
  push_builtin(gen_eq_body(str_eq_idx), 0, 0, 4)
  push_builtin(gen_string_ends_with_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 2, 1, 4)
  push_builtin(gen_string_last_index_of_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 3, 1, 4)
  if enable_rc {
    push_builtin(gen_arr_push_all_body(true, rc_alloc_idx, rc_shadow), 10, 1, 6)
  } else {
    push_builtin(gen_arr_push_all_body(false, rc_alloc_idx, rc_shadow), 9, 0, 6)
  }
  // #748 memchr rewrite: 8 i32 locals, the i64 substring scratch is gone.
  push_builtin(gen_string_index_of_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 8, 0, 4)
  push_builtin(gen_string_contains_body(enable_rc, string_index_of_idx), 0, 0, 4)
  push_builtin(gen_string_starts_with_body(enable_rc, str_len_idx, str_substring_idx, str_eq_idx), 2, 1, 4)
  push_builtin(gen_string_split_body(enable_rc, arr_new_idx, arr_push_idx, str_len_idx, str_substring_idx, string_index_of_idx), 4, 1, 4)
  push_builtin(gen_string_trim_body(enable_rc, str_len_idx, str_char_code_at_idx, str_substring_idx), 4, 0, 3)
  if num_src_pairs > 0 {
    push_builtin(gen_sources_proper_body(num_src_pairs, str_offsets, str_lengths, src_str_base, arr_new_idx, arr_push_idx), 1, 1, 5)
  } else {
    push_builtin(gen_sources_stub_body(arr_new_idx), 0, 0, 5)
  }
  push_builtin(gen_bytes_new_body(), 1, 0, 5)
  push_builtin(gen_bytes_len_body(enable_rc), 0, 0, 3)
  push_builtin(gen_bytes_get_body(enable_rc), 1, 0, 4)
  push_builtin(gen_bytes_set_body(enable_rc), 1, 0, 7)
  push_builtin(gen_bytes_push_body(enable_rc), 6, 0, 6)
  push_builtin(gen_bytes_append_body(), 8, 0, 6)
  push_builtin(gen_bytes_concat_body(bytes_new_idx, bytes_append_idx), 0, 1, 4)
  push_builtin(gen_bytes_slice_body(enable_rc, bytes_new_idx, bytes_get_idx, bytes_push_idx), 2, 1, 8)
  push_builtin(gen_bytes_from_array_body(enable_rc, arr_len_idx, arr_get_idx, bytes_new_idx, bytes_push_idx), 2, 1, 3)
  push_builtin(gen_bytes_to_array_body(enable_rc, arr_new_idx, arr_push_idx, bytes_len_idx, bytes_get_idx), 2, 1, 3)
  if enable_rc {
    push_builtin(gen_rc_drop_body(rc_drop_idx, rc_shadow, rc_bins_base), 5, 1, 1)
    push_builtin(gen_rc_alloc_body(rc_shadow, rc_bins_base), 5, 0, 3)
  } else {
    ()
  }
  push_builtin(gen_heap_grow_check_body(), 0, 0, 2)
  push_builtin(gen_simd_skip_ws_body(enable_rc), 2, 2, 8)
  push_builtin(gen_simd_scan_alnum_body(enable_rc, false), 1, 3, 8)
  push_builtin(gen_simd_scan_alnum_body(enable_rc, true), 1, 3, 8)
  push_builtin(gen_str_lex_diff_body(enable_rc), 7, 0, 4)
  push_builtin(gen_generic_rel_diff_body(enable_rc, str_lex_diff_idx), 0, 0, 4)
  push_builtin(gen_generic_add_body(str_concat_idx), 0, 0, 4)
  push_builtin(gen_map_hash_body(), 3, 2, 3)
  push_builtin(gen_map_cap_body(), 0, 1, 3)
  push_builtin(gen_map_index_insert_body(), 1, 4, 7)
  push_builtin(gen_map_build_index_body(map_hash_idx, map_cap_idx, map_index_insert_idx, heap_grow_check_idx), 0, 7, 4)
  push_builtin(gen_map_probe_index_body(map_hash_idx, eq_idx), 1, 8, 8)
  // #708: one counter cell shared across every function's lift pass, so each
  // lift site gets a distinct `__m_scrut_N` name (see lift_match_scrutinees).
  let m_scrut_counter = [
    0
  ]
  // #712: one counter cell shared across every function's uniquify pass, so
  // every renamed shadow gets a distinct `__shadow_N_<name>` (see
  // uniquify_shadowed_bindings).
  let uq_shadow_counter = [
    0
  ]
  // #799 perf: ONE membership index over the flat fn + ctor name tables,
  // shared by every per-function CompileCtx below. collect_free_vars_indexed
  // consults it per ident instead of linearly scanning ~thousands of names
  // (which dominated compiler-closure compile profiles).
  // Round 2: a SORTED array + binary search -- the previous MapBuilder index
  // was O(N^2) to build (set scans for duplicates) and O(N) per has_key.
  let capture_index_names = lc_fresh_string_array()
  let mut cib_i = 0
  while cib_i < Array::length(all_fn_names_list) {
    Array::push(capture_index_names, Array::get(all_fn_names_list, cib_i))
    cib_i = cib_i + 1
  }
  let mut cib_j = 0
  while cib_j < Array::length(ctor_names_list) {
    Array::push(capture_index_names, Array::get(ctor_names_list, cib_j))
    cib_j = cib_j + 1
  }
  let capture_name_index_shared = sorted_names_of(capture_index_names)
  // Codex review on #1186: this was computed inside the `bi < num_user_funcs`
  // loop below, re-sorting the same thunk_names_list once per function
  // instead of once per compile -- hoist it out, same fix shape as
  // capture_name_index_shared above.
  let thunk_names_sorted_shared = sorted_names_of(thunk_names_list)
  // #1259 step 7 groundwork: the lambda index plan.
  //
  // count_lambda_sites_expr predicts how many table entries a function's body
  // will allocate WITHOUT compiling the functions before it -- which is the
  // whole point, since compile_lambda currently takes that index from the live
  // length of a shared growing table and emits it into the body. The running
  // total below is that prediction's prefix sum: function bi's range starts
  // where bi-1's ended.
  //
  // Seeded into the ctx and checked at every allocation (compile_lambda), not
  // used: while plan and walk agree, swapping compile_lambda over to the
  // planned value cannot change a byte. This is the evidence for that swap.
  let lambda_plan_cell = lc_fresh_int_array()
  Array::push(lambda_plan_cell, 0)
  let mut lambda_planned_total = 0
  let mut bi = 0
  while bi < num_user_funcs {
    let __bi_stmt = Array::get(stmts, Array::get(fn_stmt_indices, bi))
    // #703 follow-up: under RC, lift temporary match scrutinees into lets so the
    // Perceus pass (which drops named bindings) reclaims them. Applied here, the
    // SAME transformed body feeds both build_perceus_plan (below) and the body
    // compilation, keeping the plan and codegen consistent. Non-RC is unchanged.
    //
    // #712: before lifting scrutinees, alpha-rename any binding that shadows an
    // enclosing one (within this same function) to a fresh unique name, so RC
    // codegen's name-keyed bookkeeping (heap_binding_names, rc_drop_names,
    // rc_alias_dup_names, rc_dup_names, loop_borrowed_names, and the Perceus
    // plan itself) can never confuse two distinct bindings that happen to share
    // a name. See uniquify_shadowed_bindings's doc comment (normalize/index.vibe).
    let __bi_expr = if enable_rc {
      // #715: fresh per-function seen-set -- name uniqueness is only required
      // within one function (Perceus plans and codegen bookkeeping are
      // per-function), and per-function reset keeps first binders unrenamed.
      let uq_seen: Array[String] = [
      ]
      lift_match_scrutinees(uniquify_shadowed_bindings(get_slet_expr(__bi_stmt), Map::new(), uq_shadow_counter, uq_seen), m_scrut_counter)
    } else {
      get_slet_expr(__bi_stmt)
    }
    let body_buf = bytebuf_new()
    // #644: tell the linemap recorder which user function `body_buf`'s
    // offsets belong to (mirrors cov_state.cur_fn below). Set unconditionally
    // -- linemap_record itself is a no-op unless dbg_line_on, so this costs
    // nothing on a normal build.
    Array::set(linemap_state.cur_fn, 0, bi)
    // #cov: mark this user function as executed (store 1 at cov_base + bi).
    // Stack-neutral and local-free, so prepending it to the body is safe.
    if coverage {
      emit_i32_const(body_buf, cov_base + bi)
      emit_i32_const(body_buf, 1)
      emit_i32_store8(body_buf, 0, 0)
      // #cov branch: tell branch instrumentation which function owns the branches
      // emitted while compiling this body.
      Array::set(cov_state.cur_fn, 0, bi)
    } else {
      ()
    }
    // debugger trace (DAP P1 groundwork): in debug mode, append this user
    // function's index `bi` to the in-memory trace log when there is still room.
    // Stack-neutral and local-free, so prepending it to the body is safe:
    //   if load[counter_addr] < cap {
    //     store[log_base + load[counter_addr]*4] = bi
    //     store[counter_addr] = load[counter_addr] + 1
    //   }
    // `counter` is reloaded from memory each time (idempotent), avoiding locals.
    if debug_trace {
      emit_i32_const(body_buf, trace_counter_addr)
      emit_i32_load(body_buf, 2, 0)
      emit_i32_const(body_buf, trace_cap)
      emit_i32_ge_u(body_buf)
      emit_i32_eqz(body_buf)
      emit_if_void(body_buf)
      // store[log_base + counter*4] = bi
      emit_i32_const(body_buf, trace_log_base)
      emit_i32_const(body_buf, trace_counter_addr)
      emit_i32_load(body_buf, 2, 0)
      emit_i32_const(body_buf, 4)
      emit_i32_mul(body_buf)
      emit_i32_add(body_buf)
      emit_i32_const(body_buf, bi)
      emit_i32_store(body_buf, 2, 0)
      // store[counter_addr] = counter + 1
      emit_i32_const(body_buf, trace_counter_addr)
      emit_i32_const(body_buf, trace_counter_addr)
      emit_i32_load(body_buf, 2, 0)
      emit_i32_const(body_buf, 1)
      emit_i32_add(body_buf)
      emit_i32_store(body_buf, 2, 0)
      emit_end(body_buf)
    } else {
      ()
    }
    // #715: computed here, BEFORE the `debug_break` block below, and reused by
    // it via `Array::length(lc_norm_params)` instead of a second independent
    // `is_efn(__bi_expr)`/`get_efn_params(__bi_expr)` call. Both accessors
    // unconditionally rc_drop their argument, so each call is a real "use" of
    // `__bi_expr` for Perceus's purposes; having it called from BOTH branches
    // of the (usually-false) `if debug_break` AND unconditionally right after
    // made the `if debug_break {...} else {...}` construct's `then` branch
    // statically "consume" 2 extra units of `__bi_expr`'s remaining-use budget
    // that, in the overwhelmingly common `debug_break == false` case, never
    // actually execute. perceus/index.vibe's `pc_emit` EIf handling takes the
    // MIN of the two branches' resulting `remaining` and carries it forward
    // (see the #705 comment there) to avoid double-freeing a value fully
    // consumed on the taken branch -- but that also means the *lower* (more-
    // consuming) branch's count wins even when it is the branch that is
    // essentially never taken, permanently starving the dup budget needed by
    // `__bi_expr`'s later, always-executed uses below (`lc_norm_params` itself
    // was one of them) and eventually causing a use of an already-freed
    // pointer (#715's free-list corruption during RC self-hosting). Hoisting
    // this computation out from under `debug_break` removes the only
    // asymmetric-branch use of `__bi_expr` in this function (the other
    // `is_efn(__bi_expr)`-gated branches all have `is_efn(__bi_expr)` true on
    // effectively every real program, so their MIN-selected branch already
    // matches the branch actually taken).
    // #715: `get_slet_type(__bi_stmt)` hoisted out of the `is_efn(__bi_expr)`
    // `then` branch and computed here, unconditionally -- previously it was
    // the ONLY use of `__bi_stmt` inside this specific `if`'s `then` branch
    // (the `else` branch, `array_empty()`, never touches
    // `__bi_stmt`), and `__bi_expr` is NOT an EFn for every `bi` iteration:
    // `fn_names_list`/`fn_stmt_indices` also carry thunk entries (see the
    // classification loop above), so the `else` path here is a real, common
    // occurrence, not a rare edge case. Same leak mechanism as the
    // `lc_norm_params`/`__bi_body`/`dn_expr`/classification-loop fixes above
    // -- `pc_emit`'s EIf MIN-merge (#705) otherwise permanently assumes the
    // `then`-branch's higher `__bi_stmt` consumption even on thunk (`else`)
    // iterations, leaking `__bi_stmt` (a heap Stmt node) on each one.
    let __sf_slet_type = get_slet_type(__bi_stmt)
    let lc_norm_params = if is_efn(__bi_expr) {
      let ps = get_efn_params(__bi_expr)
      let sig_args_raw = fn_type_param_types(__sf_slet_type)
      let single_tuple_param = match sig_args_raw {
        Some(a) => Array::length(ps) == 1 && Array::length(a) > 1,
        None => false
      }
      let np = Array::slice(ps, 0, 0)
      let mut spi = 0
      while spi < Array::length(ps) {
        let (sraw, sty) = Array::get(ps, spi)
        let slen = String::length(sraw)
        let ssn = if slen > 0 {
          let slc = String::char_code_at(sraw, slen - 1)
          if slc == '~' || slc == '?' {
            sraw[0: slen - 1]
          } else {
            sraw
          }
        } else {
          sraw
        }
        let resolved_ty = match sty {
          Some(_) => sty,
          None =>
          match sig_args_raw {
            Some(args) =>
            if single_tuple_param {
              Some(TyTuple(args))
            } else if Array::length(args) == Array::length(ps) {
              Some(Array::get(args, spi))
            } else {
              None
            },
            None => None
          }
        }
        Array::push(np, (ssn, resolved_ty))
        spi = spi + 1
      }
      np
    } else {
      // #715: alias `__sf_slet_type` once here too, matching `then`'s single
      // use (via `fn_type_param_types`) now that it is hoisted above -- see
      // that binding's doc comment.
      let __sf_lnp_ty = __sf_slet_type
      array_empty()
    }
    // debugger breakpoint (DAP P1): in break mode, call the host hook
    // `vibe::dbg_break` at this user function's entry. The hook inspects the
    // wasm backtrace to name the entering function and pauses when it is in the
    // breakpoint set. Stack-neutral (() -> ()), so prepending is safe.
    if debug_break {
      // DAP P2: spill this function's i64 parameters into the dbgargs region so
      // the host hook can read and print them. All user-function wasm params are
      // i64 (vibe value ABI); locals 0..nparams-1 hold the params at entry.
      let dbg_nparams = Array::length(lc_norm_params)
      let dbg_n = if dbg_nparams > dbgargs_cap {
        dbgargs_cap
      } else {
        dbg_nparams
      }
      let mut dbg_pi = 0
      while dbg_pi < dbg_n {
        emit_i32_const(body_buf, dbgargs_base + dbg_pi * 8)
        emit_local_get(body_buf, dbg_pi)
        emit_i64_store(body_buf, 3, 0)
        dbg_pi = dbg_pi + 1
      }
      emit_i32_const(body_buf, dbgargs_count_addr)
      emit_i32_const(body_buf, dbg_n)
      emit_i32_store(body_buf, 2, 0)
      emit_call(body_buf, dbg_break_import_idx)
    } else {
      ()
    }
    let local_names = lc_fresh_string_array()
    let fn_name_dbg = Array::get(fn_names_list, bi)
    let rc_drops = array_empty()
    let rc_alias_dups = array_empty()
    let rc_dups = array_empty()
    let lc_heap_params = lc_fresh_string_array()
    // #715: computed once, unconditionally (regardless of `enable_rc`), and
    // reused below both for the Perceus plan and for the actual codegen call
    // to `compile_expr` -- instead of a separate `get_efn_body(__bi_expr)`
    // call under `enable_rc` (as `fbody`) AND another one further down (as
    // `body`, inside the `is_efn(__bi_expr)` block). Each independent
    // `get_efn_body(__bi_expr)`/`get_efn_params(__bi_expr)` call is a real
    // additional owning "use" of `__bi_expr` for Perceus's purposes (neither
    // is registered in `is_borrow_arg0_call`), inflating the dup budget
    // `__bi_expr` statically needs. See the `lc_norm_params` doc comment
    // above (the same redundant-call pattern, already fixed once for
    // `get_efn_params`) for the full double-free mechanism this avoids.
    let __bi_body = if is_efn(__bi_expr) {
      get_efn_body(__bi_expr)
    } else {
      __bi_expr
    }
    if enable_rc {
      let plan = build_perceus_plan_with_params(lc_norm_params, __bi_body, lc_borrow_ret_names, lc_borrow_arg0_user)
      let mut lhpi = 0
      while lhpi < Array::length(lc_norm_params) {
        let (lhpn, lhpt) = Array::get(lc_norm_params, lhpi)
        if param_is_heap_in_body(lhpn, lhpt, __bi_body) {
          Array::push(lc_heap_params, lhpn)
        } else {
          ()
        }
        lhpi = lhpi + 1
      }
      // ADR-0092 borrow-inference slice 1: when THIS fn's arg0 ABI is
      // borrowed, the caller keeps ownership -- the plan's scope-end drop
      // (and any entry dup) for param0 must not be emitted here.
      let bfn_p0 = if array_contains_str(lc_borrow_arg0_user, fn_name_dbg) && Array::length(lc_norm_params) >= 1 {
        let (bfn_p0n, _) = Array::get(lc_norm_params, 0)
        bfn_p0n
      } else {
        ""
      }
      let mut di = 0
      while di < Array::length(plan) {
        let pa = Array::get(plan, di)
        if pa_is_drop(pa) {
          // Skip ONLY the drop for the borrowed param -- the plan is
          // name-keyed, so a shadowing local sharing param0's name can
          // carry dup/alias-dup actions of its own, and filtering those
          // out under-counts references (use-after-free that only
          // surfaces under allocation churn -- codegen_heap_e2e_test
          // caught it after ~90 compiles). A same-named shadow's own
          // scope-end drop is also skipped here (a bounded leak, safe
          // direction); eligibility makes that rare since a bare read of
          // the shadow disqualifies the fn.
          if pa.name == bfn_p0 && bfn_p0 != "" {
            ()
          } else {
            Array::push(rc_drops, pa.name)
          }
        } else if pa_is_alias_dup(pa) {
          Array::push(rc_alias_dups, pa.name)
        } else if pa_is_dup(pa) {
          Array::push(rc_dups, pa.name)
        } else {
          ()
        }
        di = di + 1
      }
    }
    // Interior-line breakpoints: this function's source file id + that file's
    // newline index (for mapping its statement offsets to lines). Off => 0/empty.
    let dbg_fid = if dbg_line_on {
      Array::get(prov.stmt_file_id, Array::get(fn_stmt_indices, bi))
    } else {
      0
    }
    let dbg_nls = if dbg_line_on {
      Array::get(prov.file_nls, dbg_fid)
    } else {
      lc_fresh_int_array()
    }
    // #1259: this function's preassigned range.
    //
    // `__bi_expr` is the body codegen actually walks (post scrutinee-lift /
    // alpha-rename), so the count comes off it rather than the raw stmt. But
    // for a function DEFINITION it is itself an EFn, and that outer EFn is the
    // function -- codegen takes its params and compiles its body, it never
    // routes it through compile_lambda. Counting it would reserve a table slot
    // per user function that nothing ever fills; the over-count check below
    // caught exactly that on the first function with a lambda in it.
    let lambda_planned_here = if is_efn(__bi_expr) {
      count_lambda_sites_expr(get_efn_body(__bi_expr))
    } else {
      count_lambda_sites_expr(__bi_expr)
    }
    Array::set(lambda_plan_cell, 0, lambda_planned_total)
    lambda_planned_total = lambda_planned_total + lambda_planned_here
    let compile_ctx = CompileCtx::{
      func_table: FuncTable::{
        names: all_fn_names_list,
        indices: all_fn_indices_list,
        params: all_fn_param_counts,
        returns: all_fn_returns_list,
        needs_env: all_fn_needs_env_list,
        names_sorted: all_fn_names_sorted,
        names_sorted_pos: all_fn_names_sorted_pos
      },
      str_table: StrTable::{
        strs: str_strs, offsets: str_offsets, lengths: str_lengths
      },
      lambda_table: lt_w,
      num_user_funcs: num_user_funcs, func_offset: func_offset,
      ref_cell_names: lc_fresh_string_array(),
      ctor_table: CtorTable::{
        names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, names_sorted: lc_ctor_names_sorted, names_sorted_pos: lc_ctor_names_sorted_pos
      },
      ctor_float_fields: ctor_float_fields_list,
      // Sorted copy for compile_expr.vibe's per-identifier membership check
      // (bsearch_leftmost) -- keep `thunk_names_list` itself unsorted, its
      // POSITION is load-bearing for the per-thunk global-slot index lookup
      // a few hundred lines below (tg_k / tg_value_g). Computed once above
      // (thunk_names_sorted_shared), not per-function.
      thunk_names: thunk_names_sorted_shared,
      const_int_names: const_int_names_list,
      const_int_values: const_int_values_list,
      enable_rc: enable_rc,
      rc_shadow: rc_shadow,
      rc_drop_names: rc_drops,
      rc_alias_dup_names: rc_alias_dups,
      heap_binding_names: lc_heap_params,
      rc_drop_func_idx: if enable_rc {
        rc_drop_idx
      } else {
        -1
      },
      rc_alloc_func_idx: if enable_rc {
        rc_alloc_idx
      } else {
        -1
      },
      heap_grow_check_func_idx: heap_grow_check_idx,
      map_hash_func_idx: map_hash_idx,
      map_cap_func_idx: map_cap_idx,
      map_build_index_func_idx: map_build_index_idx,
      map_probe_func_idx: map_probe_index_idx,
      rc_dup_names: rc_dups,
      capture_name_index: capture_name_index_shared,
      float_local_slots: lc_fresh_int_array(),
      int_local_slots: lc_fresh_int_array(),
      agg_local_slots: lc_fresh_int_array(),
      agg_local_exprs: lc_fresh_expr_array(),
      agg_ret_names: lc_agg_ret_names,
      agg_ret_infos: lc_agg_ret_infos,
      heap_ret_names: lc_heap_ret_names,
      effect_names: effect_names_list,
      effect_op_keys: effect_op_keys_list,
      effect_op_arities: effect_op_arities_list,
      cov: cov_state,
      dbg_line_idx: dbg_line_import_idx,
      dbg_line_nl: dbg_nls,
      dbg_line_file_id: dbg_fid,
      loop_borrowed_names: lc_fresh_string_array(),
      loop_consumed_names: lc_fresh_string_array(),
      reuse_scrutinee_names: lc_fresh_string_array(),
      reuse_flag_locals: lc_fresh_int_array(),
      borrow_ret_names: lc_borrow_ret_names,
      borrow_arg0_user: lc_borrow_arg0_user,
      scalar_ret_names: lc_scalar_ret_names,
      pending_letrec_self_name: lc_fresh_string_array(),
      table_slots_used: table_slots_used,
      lambda_plan_next: lambda_plan_cell,
      linemap: linemap_state
    }
    if is_efn(__bi_expr) {
      // #715: `lc_norm_params` (built above from `get_efn_params(__bi_expr)`)
      // already carries each parameter's `~`/`?`-stripped name in `.0` --
      // reuse it instead of a second `get_efn_params(__bi_expr)` call plus a
      // duplicate stripping pass (see the `__bi_body` doc comment above).
      let body = __bi_body
      let mut pi = 0
      while pi < Array::length(lc_norm_params) {
        let (pname, _) = Array::get(lc_norm_params, pi)
        Array::push(local_names, pname)
        pi = pi + 1
      }
      // #724 round 2: seed the aggregate-shape log from ANNOTATED params
      // (param slot i = local i), so `p == q` on tuple/struct/enum-typed
      // params compares structurally.
      let sig_ptypes = fn_type_param_types(__sf_slet_type)
      let mut psi = 0
      while psi < Array::length(lc_norm_params) {
        // Prefer the SLet signature's param types (`let f: (P2) -> ..`);
        // fall back to a per-param annotation (`(p: P2) -> ..`).
        let pann = match sig_ptypes {
          Some(pts) => if Array::length(pts) == Array::length(lc_norm_params) {
            Some(Array::get(pts, psi))
          } else {
            let (_, pa) = Array::get(lc_norm_params, psi)
            pa
          },
          None => {
            let (_, pa) = Array::get(lc_norm_params, psi)
            pa
          }
        }
        match pann {
          Some(pte) => {
            let pinfo = agg_info_of_type_expr(compile_ctx.ctor_table, pte)
            if pinfo > 0 {
              Array::push(compile_ctx.agg_local_slots, psi * 256 + pinfo)
              // #811: agg_local_exprs is the index-aligned PARALLEL of
              // agg_local_slots (agg_log_reset_above2 prunes both in
              // lockstep, reading exprs[i] for every slots[i]). This param
              // seed pushed only to slots, leaving exprs one entry short —
              // every later reset then read exprs out of bounds and
              // compacted the garbage back in. Push the same "no shape
              // expr" placeholder the let-binding site uses.
              Array::push(compile_ctx.agg_local_exprs, EInt(0))
            } else {
              ()
            }
            // Float/Double-typed params feed expr_is_floatish the same way
            // let-bound floats do; without this, `a == b` on annotated float
            // params misses the f64 path and (under RC, where floats are
            // boxed) compares heap pointers — `1.5 == 1.5` came out false.
            //
            // #1015: Bool-typed params feed expr_is_boolish the same way
            // (int_local_slots kind 3, #769 encoding slot*4+kind) let-bound
            // bools do -- without this a Bool-typed param `b` passed straight
            // to `to_string(b)` (e.g. `fn render(b: Bool) -> String {
            // to_string(b) }`) is just a bare EIdent with no tracked slot
            // info, so neither the call-site fast path in
            // codegen/expr/compile_call.vibe nor `"\{b}"` interpolation can
            // recognize it as Bool -- both fall through to the generic
            // runtime bit-pattern heuristic and mis-render `true` as `"1"`.
            match pte {
              TyName(ptn) => if ptn == "Float" || ptn == "Double" {
                Array::push(compile_ctx.float_local_slots, psi * 2 + 1)
              } else if ptn == "Bool" {
                Array::push(compile_ctx.int_local_slots, psi * 4 + 3)
              } else {
                ()
              },
              _ => ()
            }
          },
          None => ()
        }
        psi = psi + 1
      }
      Array::push(local_names, "__env")
      let param_count = Array::length(lc_norm_params) + 1
      if enable_rc {
        let mut edi = 0
        while edi < Array::length(lc_norm_params) {
          let (edn, _edt) = Array::get(lc_norm_params, edi)
          if array_contains_str(lc_heap_params, edn) {
            let mut edc = 0
            let mut edj = 0
            while edj < Array::length(rc_dups) {
              if Array::get(rc_dups, edj) == edn {
                edc = edc + 1
              } else {
                ()
              }
              edj = edj + 1
            }
            let mut ede = 0
            while ede < edc {
              emit_rc_dup_guarded(body_buf, edi, rc_shadow)
              ede = ede + 1
            }
          } else {
            ()
          }
          edi = edi + 1
        }
      } else {
        ()
      }
      // #805: an inline-wasm fn's instruction bytes come from the WAT
      // assembler, not compile_expr (its AST body is a neutral EInt(0) after
      // lc_extract_inline_wasm). Params are Int-only (parser-enforced), so
      // no RC/Perceus bookkeeping applies; no extra locals are introduced
      // (final_nl == param_count => meta extra 0).
      let mut iw_found = -1
      let mut iw_scan = 0
      while iw_scan < Array::length(iw_names) {
        if Array::get(iw_names, iw_scan) == fn_name_dbg {
          iw_found = iw_scan
          iw_scan = Array::length(iw_names)
        } else {
          iw_scan = iw_scan + 1
        }
      }
      // ADR-0092 Phase 1 widening: a function whose body is EXACTLY
      // `match p { ... }` over one of its own heap params (the dominant
      // shape of the compiler's AST-rebuild loops) stages the same reuse
      // fusion the ELet form gets in compile_expr_tail — flag local first,
      // (name, flag) pushed for compile_match, and the param's #725
      // epilogue drop below guarded on the flag.
      let pfuse_name = if enable_rc && rc_drop_idx >= 0 && iw_found < 0 && expr_tag(body) == 16 && is_eident(get_match_scrutinee(body)) {
        get_eident_name(get_match_scrutinee(body))
      } else {
        ""
      }
      let pfuse = pfuse_name != "" && array_contains_str(rc_drops, pfuse_name) && array_contains_str(lc_heap_params, pfuse_name)
      let pfuse_flag = if pfuse {
        Array::push(local_names, "__reuse_flag")
        emit_i64_const(body_buf, 0)
        emit_local_set(body_buf, param_count)
        Array::push(compile_ctx.reuse_scrutinee_names, pfuse_name)
        Array::push(compile_ctx.reuse_flag_locals, param_count)
        param_count
      } else {
        0 - 1
      }
      let final_nl = if iw_found >= 0 {
        let iw_param_names = lc_fresh_string_array()
        let mut iw_pi = 0
        while iw_pi < Array::length(lc_norm_params) {
          let (iw_pn, _) = Array::get(lc_norm_params, iw_pi)
          Array::push(iw_param_names, iw_pn)
          iw_pi = iw_pi + 1
        }
        bytebuf_push_buf(body_buf, compile_inline_wat(fn_name_dbg, Array::get(iw_wats, iw_found), iw_param_names))
        param_count
      } else {
        compile_expr(body_buf, body, local_names, if pfuse {
          param_count + 1
        } else {
          param_count
        }, compile_ctx, -1)
      }
      if pfuse {
        Array::truncate(compile_ctx.reuse_scrutinee_names, Array::length(compile_ctx.reuse_scrutinee_names) - 1)
        Array::truncate(compile_ctx.reuse_flag_locals, Array::length(compile_ctx.reuse_flag_locals) - 1)
      } else {
        ()
      }
      let mut tail_nl = final_nl
      if enable_rc && rc_drop_idx >= 0 {
        let tail_root = scope_tail_proj_root(body)
        // #706 leak follow-up: a loop-borrowed param's protective rc_dup (see
        // compile_call.vibe's cc_is_loop_borrowed_ident sites) is matched by the
        // callee's OWN internal drop each iteration — it never touches this
        // function's own slot-held reference. The Perceus plan still counts that
        // textual occurrence as "one real consume" (so `remaining` hits 0 and no
        // PaDrop is emitted), leaking the binding's own reference once per such
        // occurrence. Count each param's occurrences in loop_consumed_names and
        // emit that many EXTRA rc_drop calls here — purely additive to the
        // existing rc_drops accounting, so it cannot perturb any decision the
        // plan and codegen already agree on elsewhere.
        let mut need_dup = false
        let mut tci = 0
        while tci < Array::length(lc_norm_params) {
          let (tcn, _tct) = Array::get(lc_norm_params, tci)
          let mut tcn_loop_extra = 0
          let mut tcle = 0
          while tcle < Array::length(compile_ctx.loop_consumed_names) {
            if Array::get(compile_ctx.loop_consumed_names, tcle) == tcn {
              tcn_loop_extra = tcn_loop_extra + 1
            } else {
              ()
            }
            tcle = tcle + 1
          }
          // #1085: the loop-count clause only applies when every consuming
          // occurrence is a loop site (see lc_has_nonloop_consume).
          let tcn_loop_drop = tcn_loop_extra > 0 && !lc_has_nonloop_consume(body, tcn)
          if array_contains_str(lc_heap_params, tcn) && (array_contains_str(rc_drops, tcn) || tcn_loop_drop) && tcn == tail_root {
            need_dup = true
          } else {
            ()
          }
          tci = tci + 1
        }
        let rtemp = final_nl
        if need_dup {
          emit_local_set(body_buf, rtemp)
          emit_rc_dup_guarded(body_buf, rtemp, rc_shadow)
          tail_nl = final_nl + 1
        } else {
          ()
        }
        let mut tdj = 0
        while tdj < Array::length(lc_norm_params) {
          let (tdn, _tdt) = Array::get(lc_norm_params, tdj)
          if array_contains_str(lc_heap_params, tdn) {
            // #725: a loop-protected consume (per-iteration dup at the call
            // site, #706 above) is NET-ZERO at runtime — the dup is matched by
            // the callee's own drop each execution and never touches the
            // param's single owned reference. So the epilogue owes EXACTLY ONE
            // drop for that reference, regardless of how many textual
            // loop-consumed SITES exist: a second site in a sibling match arm
            // (even one that never executes — its protective dup is emitted
            // but never runs) previously got its own per-occurrence drop,
            // over-releasing the CALLER's value and poisoning the RC free
            // list (fuzz/findings/issue725/). When a loop site exists it also
            // absorbs the plan's PaDrop (the textual counts ate the budget the
            // plan would otherwise drop), so emit one drop total either way.
            let mut tdn_loop_count = 0
            let mut tdle = 0
            while tdle < Array::length(compile_ctx.loop_consumed_names) {
              if Array::get(compile_ctx.loop_consumed_names, tdle) == tdn {
                tdn_loop_count = tdn_loop_count + 1
              } else {
                ()
              }
              tdle = tdle + 1
            }
            // #1085: the "one epilogue drop when loop sites exist" rule
            // (#725) assumed every textual consume is a net-zero loop site.
            // When a NON-loop consuming occurrence also exists (e.g.
            // `Array::set(buf, i, v)` in a sibling branch of the loop), the
            // path through that real consume transfers the param's own
            // reference and the unconditional drop over-releases the stored
            // value (use-after-free — the loop arm does not even need to
            // execute). Suppress the loop-count drop in that mixed case;
            // the loop-only path then leaks one reference per call, which
            // is the safe direction until path-sensitive accounting lands
            // (fixtures/rc_branch_loop_mixed_consume_test.vibe).
            let tdn_loop_drop = tdn_loop_count > 0 && !lc_has_nonloop_consume(body, tdn)
            if array_contains_str(rc_drops, tdn) || tdn_loop_drop {
              if pfuse_flag >= 0 && tdn == pfuse_name {
                // ADR-0092: a reuse arm consumed this param's reference —
                // drop only on the paths that did not (flag still 0).
                emit_local_get(body_buf, pfuse_flag)
                emit_i64_eqz(body_buf)
                emit_if_void(body_buf)
                emit_local_get(body_buf, tdj)
                emit_call(body_buf, rc_drop_idx)
                emit_end(body_buf)
              } else {
                emit_local_get(body_buf, tdj)
                emit_call(body_buf, rc_drop_idx)
              }
            } else {
              ()
            }
          } else {
            ()
          }
          tdj = tdj + 1
        }
        if need_dup {
          emit_local_get(body_buf, rtemp)
        } else {
          ()
        }
      } else {
        ()
      }
      if enable_rc && fn_name_dbg == entry_name {
        emit_i64_const(body_buf, 1)
        emit_i64_shr_s(body_buf)
      }
      Array::push(bodies, body_buf)
      // #1259: the walk allocated exactly as many lambdas as the plan said.
      // The per-allocation check in compile_lambda catches an UNDER-count (the
      // walk runs past the planned range); this catches an OVER-count, where
      // the plan reserved slots for EFn nodes codegen never reached.
      if Array::get(lambda_plan_cell, 0) != lambda_planned_total {
        throw(String::concat("lambda plan over-count: planned through ", String::concat(__to_string(lambda_planned_total), String::concat(", walk stopped at ", __to_string(Array::get(lambda_plan_cell, 0))))))
      } else {
        ()
      }
      let extra = if tail_nl > param_count {
        tail_nl - param_count
      } else {
        0
      }
      Array::push(meta_i32, 0)
      Array::push(meta_i64, extra)
    } else {
      // Module-level non-function `let` (a THUNK): previously the initializer
      // re-ran on EVERY reference, so a 16-entry lookup table cost an O(size)
      // allocation per access (~148 B/call in bench/_probe_sb_phases.vibe)
      // and, worse, each access saw a FRESH value while the gc backend
      // initializes module globals ONCE — a cross-backend semantics split
      // (mutations visible there, lost here). Memoize: two appended i64
      // globals per thunk (value + init flag; base index rc?7:6, after
      // g_op_index). First call computes and caches, later calls reload.
      // Under RC the cache holds one permanent reference and every return
      // (both paths) hands the caller a guarded-dup'd reference, so consumer
      // drops balance exactly like the old fresh-value contract.
      Array::push(local_names, "__env")
      let param_count = 1
      let mut tg_k = -1
      let mut tg_i = 0
      while tg_i < Array::length(thunk_names_list) {
        if Array::get(thunk_names_list, tg_i) == fn_name_dbg {
          tg_k = tg_i
          tg_i = Array::length(thunk_names_list)
        } else {
          tg_i = tg_i + 1
        }
      }
      let tg_base = if enable_rc {
        7
      } else {
        6
      }
      let tg_value_g = tg_base + tg_k * 2
      let tg_flag_g = tg_value_g + 1
      emit_global_get(body_buf, tg_flag_g)
      emit_i32_wrap_i64(body_buf)
      emit_if_i64(body_buf)
      emit_global_get(body_buf, tg_value_g)
      emit_local_tee(body_buf, 1)
      if enable_rc {
        emit_rc_dup_guarded(body_buf, 1, rc_shadow)
      } else {
        ()
      }
      emit_else(body_buf)
      Array::push(local_names, "__thunk_memo")
      let final_nl = compile_expr(body_buf, __bi_expr, local_names, 2, compile_ctx, -1)
      emit_local_tee(body_buf, 1)
      emit_global_set(body_buf, tg_value_g)
      if enable_rc {
        emit_rc_dup_guarded(body_buf, 1, rc_shadow)
      } else {
        ()
      }
      emit_i64_const(body_buf, 1)
      emit_global_set(body_buf, tg_flag_g)
      emit_local_get(body_buf, 1)
      emit_end(body_buf)
      if enable_rc && fn_name_dbg == entry_name {
        emit_i64_const(body_buf, 1)
        emit_i64_shr_s(body_buf)
      }
      Array::push(bodies, body_buf)
      // #1259: the walk allocated exactly as many lambdas as the plan said.
      // The per-allocation check in compile_lambda catches an UNDER-count (the
      // walk runs past the planned range); this catches an OVER-count, where
      // the plan reserved slots for EFn nodes codegen never reached.
      if Array::get(lambda_plan_cell, 0) != lambda_planned_total {
        throw(String::concat("lambda plan over-count: planned through ", String::concat(__to_string(lambda_planned_total), String::concat(", walk stopped at ", __to_string(Array::get(lambda_plan_cell, 0))))))
      } else {
        ()
      }
      let extra = if final_nl > param_count {
        final_nl - param_count
      } else {
        0
      }
      Array::push(meta_i32, 0)
      Array::push(meta_i64, extra)
    }
    bi = bi + 1
  }
  let num_lambdas = Array::length(lt_w.bodies)
  let start_body = bytebuf_new()
  let entry_func_idx = if entry_user_idx >= 0 {
    entry_user_idx + func_offset
  } else {
    -1
  }
  // ADR-0069: the synthesized `_start` prints the entry's Int return via
  // print_int (the historical `let main: () -> Int` convention), but a
  // Unit-returning entry (`fn main {}` desugars to `() -> Unit`, and any
  // explicit `let main: () -> Unit`) must NOT print — the old behavior
  // appended a stray `0` line after the program's own output. Detect Unit
  // from the entry's declared return type: the EFn return annotation or the
  // binding's `: (..) -> Unit` type annotation.
  let mut entry_returns_unit = false
  if entry_user_idx >= 0 {
    let mut eri = 0
    while eri < Array::length(stmts) {
      match Array::get(stmts, eri) {
        SLet(_, _, ename, eann, eval) => if ename == entry_name {
          let ann_unit = match eann {
            Some(TyFn(_, ann_ret, _)) => linked_type_expr_is_unit(ann_ret),
            _ => false
          }
          let ret_unit = match eval {
            EFn(_, _, _, efn_ret, _, _) => match efn_ret {
              Some(rt) => linked_type_expr_is_unit(rt),
              None => false
            },
            _ => false
          }
          if ann_unit || ret_unit {
            entry_returns_unit = true
          }
        },
        _ => ()
      }
      eri = eri + 1
    }
  }
  if entry_user_idx >= 0 {
    let entry_params = Array::get(fn_param_counts, entry_user_idx)
    if entry_params != 0 {
      throw("WASI entry function must take 0 parameters")
    }
    emit_i64_const(start_body, 0)
    emit_call(start_body, entry_func_idx)
    if entry_returns_unit {
      emit_drop(start_body)
    } else {
      emit_call(start_body, print_int_idx)
    }
  } else {
    let mut sti = 0
    while sti < Array::length(test_fn_names) {
      let stname = Array::get(test_fn_names, sti)
      let mut __stj = 0
      let mut __stf = -1
      while __stj < Array::length(fn_names_list) {
        if Array::get(fn_names_list, __stj) == stname {
          __stf = __stj
        }
        __stj = __stj + 1
      }
      if __stf >= 0 {
        emit_i64_const(start_body, 0)
        emit_call(start_body, func_offset + __stf)
        emit_drop(start_body)
      }
      sti = sti + 1
    }
  }
  Array::push(bodies, start_body)
  Array::push(meta_i32, 0)
  Array::push(meta_i64, 0)
  let run_body = bytebuf_new()
  if entry_func_idx >= 0 {
    emit_i64_const(run_body, 0)
    emit_call(run_body, entry_func_idx)
  } else {
    let mut rti = 0
    while rti < Array::length(test_fn_names) {
      let tname = Array::get(test_fn_names, rti)
      let mut __rtj = 0
      let mut __rtf = -1
      while __rtj < Array::length(fn_names_list) {
        if Array::get(fn_names_list, __rtj) == tname {
          __rtf = __rtj
        }
        __rtj = __rtj + 1
      }
      if __rtf >= 0 {
        emit_i64_const(run_body, 0)
        emit_call(run_body, func_offset + __rtf)
        emit_drop(run_body)
      }
      rti = rti + 1
    }
    emit_i64_const(run_body, 0)
  }
  Array::push(bodies, run_body)
  Array::push(meta_i32, 0)
  Array::push(meta_i64, 0)
  let mut li = 0
  while li < num_lambdas {
    Array::push(bodies, Array::get(lt_w.bodies, li))
    Array::push(meta_i32, Array::get(lt_w.meta_i32, li))
    Array::push(meta_i64, Array::get(lt_w.meta_i64, li))
    li = li + 1
  }
  let mut max_closure_arity = -1
  let mut lai = 0
  while lai < num_lambdas {
    let lpc = Array::get(lt_w.param_counts, lai) - 1
    if lpc > max_closure_arity {
      max_closure_arity = lpc
    }
    lai = lai + 1
  }
  let mut uai = 0
  while uai < num_user_funcs {
    let upc = Array::get(fn_param_counts, uai)
    if upc > max_closure_arity {
      max_closure_arity = upc
    }
    uai = uai + 1
  }
  let mut iai = 0
  while iai < Array::length(linked_imports) {
    let (_, _, ipc, _) = Array::get(linked_imports, iai)
    if ipc > max_closure_arity {
      max_closure_arity = ipc
    }
    iai = iai + 1
  }
  let num_closure_types = if max_closure_arity >= 0 {
    max_closure_arity + 1
  } else {
    0
  }
  // Interior-line breakpoints (span-arc step5): when active, the `vibe::dbg_line`
  // import needs an `(i32) -> ()` func type. No existing base type is `(i32)->()`
  // (type 1 is `(i64)->()`), so append one new type AFTER all base + closure
  // types at index `num_base_types + num_closure_types`. This is strictly beyond
  // every linked-import type index (which use `num_base_types + lparams`, bounded
  // by num_closure_types), so existing indices are unshifted. -1 when off.
  let dbg_line_type_idx = if dbg_line_on {
    num_base_types + num_closure_types
  } else {
    -1
  }
  let extra_dbg_types = if dbg_line_on {
    1
  } else {
    0
  }
  // #794: `vibe.http_request` needs an `(i64,i64,i64,i64) -> i64` func type.
  // No base type has 4 i64 params, and closure types are data-dependent (only
  // present up to the max closure arity in the unit), so append one dedicated
  // type AFTER base + closure + dbg types when the import is live. Off =>
  // byte-identical type section (fixpoint-safe).
  let http_request_type_idx = if need_http_request_builtin {
    num_base_types + num_closure_types + extra_dbg_types
  } else {
    -1
  }
  let extra_http_types = if need_http_request_builtin {
    1
  } else {
    0
  }
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types + extra_dbg_types + extra_http_types)
  emit_func_type_raw(type_content, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(type_content, [
    126
  ], array_empty())
  emit_func_type_raw(type_content, array_empty(), array_empty())
  emit_func_type_raw(type_content, [
    126
  ], [
    126
  ])
  emit_func_type_raw(type_content, [
    126,
    126
  ], [
    126
  ])
  emit_func_type_raw(type_content, array_empty(), [
    126
  ])
  emit_func_type_raw(type_content, [
    126,
    126
  ], array_empty())
  emit_func_type_raw(type_content, [
    126,
    126,
    126
  ], array_empty())
  emit_func_type_raw(type_content, [
    126,
    126,
    126
  ], [
    126
  ])
  let mut cti = 0
  while cti < num_closure_types {
    let num_params = cti + 1
    let ct_params = lc_fresh_int_array()
    let mut cpti = 0
    while cpti < num_params {
      Array::push(ct_params, 126)
      cpti = cpti + 1
    }
    emit_func_type_raw(type_content, ct_params, [
      126
    ])
    cti = cti + 1
  }
  // Interior-line breakpoints: append the `(i32, i32) -> ()` type for
  // `vibe::dbg_line` (127 = i32; params = file_id, line). Only when active, so the
  // type section is byte-identical off.
  if dbg_line_on {
    emit_func_type_raw(type_content, [
      127,
      127
    ], array_empty())
  } else {
    ()
  }
  // #794: the `(i64,i64,i64,i64) -> i64` type for vibe.http_request, appended
  // last so every other type index is unshifted.
  if need_http_request_builtin {
    emit_func_type_raw(type_content, [
      126,
      126,
      126,
      126
    ], [
      126
    ])
  } else {
    ()
  }
  let out = bytebuf_new()
  emit_header(out)
  emit_vibe_abi_custom_section(out, "raw")
  // #cov: emit a `vibe_cov` custom section describing the function-hit bitmap.
  // Layout of the payload: i32 LE cov_base, i32 LE cov_count, then the
  // user-function names (one per line, in bitmap-index order). The consumer
  // reads memory[cov_base .. cov_base+cov_count] after running and maps each
  // hit byte back to a name. Only present in coverage builds.
  if coverage {
    let cov_content = bytebuf_new()
    let cov_name = "vibe_cov"
    leb128_encode_u32(cov_content, String::length(cov_name))
    let mut cni = 0
    while cni < String::length(cov_name) {
      bytebuf_push(cov_content, String::char_code_at(cov_name, cni))
      cni = cni + 1
    }
    bytebuf_push(cov_content, cov_base&255)
    bytebuf_push(cov_content, (cov_base>>8)&255)
    bytebuf_push(cov_content, (cov_base>>16)&255)
    bytebuf_push(cov_content, (cov_base>>24)&255)
    bytebuf_push(cov_content, cov_count&255)
    bytebuf_push(cov_content, (cov_count>>8)&255)
    bytebuf_push(cov_content, (cov_count>>16)&255)
    bytebuf_push(cov_content, (cov_count>>24)&255)
    let mut covni = 0
    while covni < num_user_funcs {
      let covnm = Array::get(fn_names_list, covni)
      let covnml = String::length(covnm)
      let mut covci = 0
      while covci < covnml {
        bytebuf_push(cov_content, String::char_code_at(covnm, covci))
        covci = covci + 1
      }
      bytebuf_push(cov_content, 10)
      covni = covni + 1
    }
    bytebuf_push_section(out, 0, cov_content)
    // #cov branch: a `vibe_cov_branch` custom section describing the branch-hit
    // bitmap. Payload: i32 LE branch_base, i32 LE branch_count, then
    // branch_count i32 LE entries giving the owning user-function index per
    // branch id (in id order). The consumer reads memory[base .. base+count]
    // after running and attributes each hit branch to its function (names from
    // the `vibe_cov` section), so it can report per-function branch coverage.
    let covb_content = bytebuf_new()
    let covb_name = "vibe_cov_branch"
    leb128_encode_u32(covb_content, String::length(covb_name))
    let mut covbni = 0
    while covbni < String::length(covb_name) {
      bytebuf_push(covb_content, String::char_code_at(covb_name, covbni))
      covbni = covbni + 1
    }
    let covb_count = Array::get(cov_state.next, 0)
    bytebuf_push(covb_content, cov_branch_base&255)
    bytebuf_push(covb_content, (cov_branch_base>>8)&255)
    bytebuf_push(covb_content, (cov_branch_base>>16)&255)
    bytebuf_push(covb_content, (cov_branch_base>>24)&255)
    bytebuf_push(covb_content, covb_count&255)
    bytebuf_push(covb_content, (covb_count>>8)&255)
    bytebuf_push(covb_content, (covb_count>>16)&255)
    bytebuf_push(covb_content, (covb_count>>24)&255)
    let mut covbi = 0
    while covbi < covb_count {
      let owner = Array::get(cov_state.owners, covbi)
      bytebuf_push(covb_content, owner&255)
      bytebuf_push(covb_content, (owner>>8)&255)
      bytebuf_push(covb_content, (owner>>16)&255)
      bytebuf_push(covb_content, (owner>>24)&255)
      covbi = covbi + 1
    }
    bytebuf_push_section(out, 0, covb_content)
  } else {
    ()
  }
  // debugger trace (DAP P1 groundwork): emit a `vibe.trace` custom section
  // describing the in-memory trace log. Payload layout: i32 LE counter_addr,
  // i32 LE log_base, i32 LE cap, then the user-function names (one per line, in
  // user-index order — the same list the name section uses). The runner reads
  // memory[counter_addr] for the count, then `count` i32 entries from log_base,
  // and maps each index to a name. Only present in debug-trace builds.
  if debug_trace {
    let tr_content = bytebuf_new()
    let tr_name = "vibe.trace"
    leb128_encode_u32(tr_content, String::length(tr_name))
    let mut trni = 0
    while trni < String::length(tr_name) {
      bytebuf_push(tr_content, String::char_code_at(tr_name, trni))
      trni = trni + 1
    }
    bytebuf_push(tr_content, trace_counter_addr&255)
    bytebuf_push(tr_content, (trace_counter_addr>>8)&255)
    bytebuf_push(tr_content, (trace_counter_addr>>16)&255)
    bytebuf_push(tr_content, (trace_counter_addr>>24)&255)
    bytebuf_push(tr_content, trace_log_base&255)
    bytebuf_push(tr_content, (trace_log_base>>8)&255)
    bytebuf_push(tr_content, (trace_log_base>>16)&255)
    bytebuf_push(tr_content, (trace_log_base>>24)&255)
    bytebuf_push(tr_content, trace_cap&255)
    bytebuf_push(tr_content, (trace_cap>>8)&255)
    bytebuf_push(tr_content, (trace_cap>>16)&255)
    bytebuf_push(tr_content, (trace_cap>>24)&255)
    let mut trni2 = 0
    while trni2 < num_user_funcs {
      let trnm = Array::get(fn_names_list, trni2)
      let trnml = String::length(trnm)
      let mut trci = 0
      while trci < trnml {
        bytebuf_push(tr_content, String::char_code_at(trnm, trci))
        trci = trci + 1
      }
      bytebuf_push(tr_content, 10)
      trni2 = trni2 + 1
    }
    bytebuf_push_section(out, 0, tr_content)
  } else {
    ()
  }
  // debugger argument inspection (DAP P2): emit a `vibe.dbgargs` custom section
  // publishing the addresses + value ABI the runner reads. Payload layout:
  // i32 LE dbgargs_count_addr, i32 LE dbgargs_base, i32 LE tag_mode. At a
  // breakpoint the runner reads memory[count_addr] (i32) for the arg count, then
  // that many i64 values from dbgargs_base, decoding each per tag_mode:
  //   tag_mode 0 (enable_rc off): values are plain untagged i64 ints.
  //   tag_mode 1 (enable_rc on):  values are 1-bit tagged — low bit 0 => int
  //                               (raw >> 1), low bit 1 => heap pointer (hex).
  // Only present in break builds.
  if debug_break {
    let da_content = bytebuf_new()
    let da_name = "vibe.dbgargs"
    leb128_encode_u32(da_content, String::length(da_name))
    let mut dani = 0
    while dani < String::length(da_name) {
      bytebuf_push(da_content, String::char_code_at(da_name, dani))
      dani = dani + 1
    }
    bytebuf_push(da_content, dbgargs_count_addr&255)
    bytebuf_push(da_content, (dbgargs_count_addr>>8)&255)
    bytebuf_push(da_content, (dbgargs_count_addr>>16)&255)
    bytebuf_push(da_content, (dbgargs_count_addr>>24)&255)
    bytebuf_push(da_content, dbgargs_base&255)
    bytebuf_push(da_content, (dbgargs_base>>8)&255)
    bytebuf_push(da_content, (dbgargs_base>>16)&255)
    bytebuf_push(da_content, (dbgargs_base>>24)&255)
    let da_tag_mode = if enable_rc {
      1
    } else {
      0
    }
    bytebuf_push(da_content, da_tag_mode&255)
    bytebuf_push(da_content, (da_tag_mode>>8)&255)
    bytebuf_push(da_content, (da_tag_mode>>16)&255)
    bytebuf_push(da_content, (da_tag_mode>>24)&255)
    bytebuf_push_section(out, 0, da_content)
  } else {
    ()
  }
  // debugger named-parameter inspection (DAP P4): emit a `vibe.dbgnames` custom
  // section listing, per user function (in user-index order — the same order as
  // the name section / fn_names_list / vibe.dbgargs spill), that function's name
  // followed by its parameter names. One record per function, terminated by
  // newline (10); within a record fields are tab-delimited (9): the first field
  // is the function name, the remaining fields are the parameter names. A
  // function with no params emits just its name + newline. Names are capped at
  // dbgargs_cap to match the spilled value count. The runner keys a map by
  // function name so entering-function F's names can be paired with F's spilled
  // values to print `args: [name=value]`. Only present in break builds; off =>
  // byte-identical to a normal build (fixpoint preserved).
  if debug_break {
    let dn_content = bytebuf_new()
    let dn_name = "vibe.dbgnames"
    leb128_encode_u32(dn_content, String::length(dn_name))
    let mut dnni = 0
    while dnni < String::length(dn_name) {
      bytebuf_push(dn_content, String::char_code_at(dn_name, dnni))
      dnni = dnni + 1
    }
    let mut dnfi = 0
    while dnfi < num_user_funcs {
      let dn_fnname = Array::get(fn_names_list, dnfi)
      let mut dn_fci = 0
      while dn_fci < String::length(dn_fnname) {
        bytebuf_push(dn_content, String::char_code_at(dn_fnname, dn_fci))
        dn_fci = dn_fci + 1
      }
      let dn_stmt = Array::get(stmts, Array::get(fn_stmt_indices, dnfi))
      let dn_expr = get_slet_expr(dn_stmt)
      if is_efn(dn_expr) {
        let dn_params = get_efn_params(dn_expr)
        let dn_np = Array::length(dn_params)
        let dn_n = if dn_np > dbgargs_cap {
          dbgargs_cap
        } else {
          dn_np
        }
        let mut dn_pi = 0
        while dn_pi < dn_n {
          let (dn_pname_raw, _) = Array::get(dn_params, dn_pi)
          let dn_pnl = String::length(dn_pname_raw)
          let dn_pname = if dn_pnl > 0 {
            let dn_plc = String::char_code_at(dn_pname_raw, dn_pnl - 1)
            if dn_plc == '~' || dn_plc == '?' {
              dn_pname_raw[0: dn_pnl - 1]
            } else {
              dn_pname_raw
            }
          } else {
            dn_pname_raw
          }
          bytebuf_push(dn_content, 9)
          let mut dn_ci = 0
          while dn_ci < String::length(dn_pname) {
            bytebuf_push(dn_content, String::char_code_at(dn_pname, dn_ci))
            dn_ci = dn_ci + 1
          }
          dn_pi = dn_pi + 1
        }
      } else {
        // #715: `dn_expr` is a fresh per-iteration owned binding (like
        // `__bi_expr` in the main codegen loop above), and -- unlike
        // `__bi_expr` -- `is_efn(dn_expr)` is NOT overwhelmingly true here:
        // `fn_stmt_indices` legitimately mixes real functions with non-
        // function "thunk" entries (constant initializers), so this `else`
        // is a common, not rare, runtime path. An empty `else { () }` uses
        // `dn_expr` zero times while `then` uses it once (via
        // `get_efn_params`), so `pc_emit`'s EIf MIN-merge (#705) permanently
        // carries the `then`-consumed (lower) remaining forward even on the
        // iterations that really take this branch -- the loop-body scope-end
        // drop for `dn_expr` is then skipped based on that borrowed count,
        // leaking `dn_expr` on every thunk entry. Call `is_efn` again here,
        // discarding the result, purely to consume `dn_expr` exactly once --
        // matching `then`'s single consuming use so both branches leave the
        // same remaining count and the plan's assumption holds either way.
        is_efn(dn_expr)
      }
      bytebuf_push(dn_content, 10)
      dnfi = dnfi + 1
    }
    bytebuf_push_section(out, 0, dn_content)
  } else {
    ()
  }
  // Interior-line breakpoints (span-arc step5, multi-file): emit a `vibe.dbgfiles`
  // custom section listing the source-file basenames in file-id order, one per
  // line (terminated by newline 10). `vibe::dbg_line(file_id, line)` passes the
  // file id; the runner indexes this table to recover the basename and match a
  // `--break <file>:<line>` spec. Only present when dbg_line is active, so off =>
  // byte-identical (fixpoint preserved).
  if dbg_line_on {
    let df_content = bytebuf_new()
    let df_name = "vibe.dbgfiles"
    leb128_encode_u32(df_content, String::length(df_name))
    let mut dfni = 0
    while dfni < String::length(df_name) {
      bytebuf_push(df_content, String::char_code_at(df_name, dfni))
      dfni = dfni + 1
    }
    let mut dffi = 0
    while dffi < Array::length(prov.files) {
      let df_base = Array::get(prov.files, dffi)
      let mut df_ci = 0
      while df_ci < String::length(df_base) {
        bytebuf_push(df_content, String::char_code_at(df_base, df_ci))
        df_ci = df_ci + 1
      }
      bytebuf_push(df_content, 10)
      dffi = dffi + 1
    }
    bytebuf_push_section(out, 0, df_content)
  } else {
    ()
  }
  bytebuf_push_section(out, 1, type_content)
