        // #1259 step 7: where this function's table_slots_used entries start.
        // The log is module-level and append-only, so the function's own
        // contribution is exactly the suffix it grows below.
        let __slot_lo = Array::length(table_slots_used)
        let __bi_stmt = Array::get(stmts, Array::get(fn_stmt_indices, bi))
        // #703 follow-up: under RC, lift temporary match scrutinees into lets so the
        // Perceus pass (which drops named bindings) reclaims them. Applied here, the
        // SAME transformed body feeds both build_perceus_plan (below) and the body
        // compilation, keeping the plan and codegen consistent. Non-RC is unchanged.
        //
        // #712: before lifting scrutinees, alpha-rename any binding that shadows an
        // enclosing one (within this same function) to a fresh unique name, so RC
        // codegen's name-keyed bookkeeping (heap_binding_names, rc_drop_names,
        // rc_alias_dup_names, rc_dup_names, loop_borrowed_names, and the Perceus
        // plan itself) can never confuse two distinct bindings that happen to share
        // a name. See uniquify_shadowed_bindings's doc comment (normalize/index.vibe).
        // #1259 step 7: transformed once, up in the planning loop. Re-running the
        // transform here would draw a second set of fresh names from the shared
        // counters and diverge from what the plan counted.
        let __bi_expr = Array::get(planned_bodies, bi)
        let body_buf = bytebuf_new()
        // #644: tell the linemap recorder which user function `body_buf`'s
        // offsets belong to (mirrors cov_state.cur_fn below). Set unconditionally
        // -- linemap_record itself is a no-op unless dbg_line_on, so this costs
        // nothing on a normal build.
        Array::set(linemap_state.cur_fn, 0, bi)
        // #cov: mark this user function as executed (store 1 at cov_base + bi).
        // Stack-neutral and local-free, so prepending it to the body is safe.
        if coverage {
          emit_i32_const(body_buf, cov_base + bi)
          emit_i32_const(body_buf, 1)
          emit_i32_store8(body_buf, 0, 0)
          // #cov branch: tell branch instrumentation which function owns the branches
          // emitted while compiling this body.
          Array::set(cov_state.cur_fn, 0, bi)
        } else {
          ()
        }
        // debugger trace (DAP P1 groundwork): in debug mode, append this user
        // function's index `bi` to the in-memory trace log when there is still room.
        // Stack-neutral and local-free, so prepending it to the body is safe:
        //   if load[counter_addr] < cap {
        //     store[log_base + load[counter_addr]*4] = bi
        //     store[counter_addr] = load[counter_addr] + 1
        //   }
        // `counter` is reloaded from memory each time (idempotent), avoiding locals.
        if debug_trace {
          emit_i32_const(body_buf, trace_counter_addr)
          emit_i32_load(body_buf, 2, 0)
          emit_i32_const(body_buf, trace_cap)
          emit_i32_ge_u(body_buf)
          emit_i32_eqz(body_buf)
          emit_if_void(body_buf)
          // store[log_base + counter*4] = bi
          emit_i32_const(body_buf, trace_log_base)
          emit_i32_const(body_buf, trace_counter_addr)
          emit_i32_load(body_buf, 2, 0)
          emit_i32_const(body_buf, 4)
          emit_i32_mul(body_buf)
          emit_i32_add(body_buf)
          emit_i32_const(body_buf, bi)
          emit_i32_store(body_buf, 2, 0)
          // store[counter_addr] = counter + 1
          emit_i32_const(body_buf, trace_counter_addr)
          emit_i32_const(body_buf, trace_counter_addr)
          emit_i32_load(body_buf, 2, 0)
          emit_i32_const(body_buf, 1)
          emit_i32_add(body_buf)
          emit_i32_store(body_buf, 2, 0)
          emit_end(body_buf)
        } else {
          ()
        }
        // #715: computed here, BEFORE the `debug_break` block below, and reused by
        // it via `Array::length(lc_norm_params)` instead of a second independent
        // `is_efn(__bi_expr)`/`get_efn_params(__bi_expr)` call. Both accessors
        // unconditionally rc_drop their argument, so each call is a real "use" of
        // `__bi_expr` for Perceus's purposes; having it called from BOTH branches
        // of the (usually-false) `if debug_break` AND unconditionally right after
        // made the `if debug_break {...} else {...}` construct's `then` branch
        // statically "consume" 2 extra units of `__bi_expr`'s remaining-use budget
        // that, in the overwhelmingly common `debug_break == false` case, never
        // actually execute. perceus/index.vibe's `pc_emit` EIf handling takes the
        // MIN of the two branches' resulting `remaining` and carries it forward
        // (see the #705 comment there) to avoid double-freeing a value fully
        // consumed on the taken branch -- but that also means the *lower* (more-
        // consuming) branch's count wins even when it is the branch that is
        // essentially never taken, permanently starving the dup budget needed by
        // `__bi_expr`'s later, always-executed uses below (`lc_norm_params` itself
        // was one of them) and eventually causing a use of an already-freed
        // pointer (#715's free-list corruption during RC self-hosting). Hoisting
        // this computation out from under `debug_break` removes the only
        // asymmetric-branch use of `__bi_expr` in this function (the other
        // `is_efn(__bi_expr)`-gated branches all have `is_efn(__bi_expr)` true on
        // effectively every real program, so their MIN-selected branch already
        // matches the branch actually taken).
        // #715: `get_slet_type(__bi_stmt)` hoisted out of the `is_efn(__bi_expr)`
        // `then` branch and computed here, unconditionally -- previously it was
        // the ONLY use of `__bi_stmt` inside this specific `if`'s `then` branch
        // (the `else` branch, `array_empty()`, never touches
        // `__bi_stmt`), and `__bi_expr` is NOT an EFn for every `bi` iteration:
        // `fn_names_list`/`fn_stmt_indices` also carry thunk entries (see the
        // classification loop above), so the `else` path here is a real, common
        // occurrence, not a rare edge case. Same leak mechanism as the
        // `lc_norm_params`/`__bi_body`/`dn_expr`/classification-loop fixes above
        // -- `pc_emit`'s EIf MIN-merge (#705) otherwise permanently assumes the
        // `then`-branch's higher `__bi_stmt` consumption even on thunk (`else`)
        // iterations, leaking `__bi_stmt` (a heap Stmt node) on each one.
        let __sf_slet_type = get_slet_type(__bi_stmt)
        let lc_norm_params = if is_efn(__bi_expr) {
          let ps = get_efn_params(__bi_expr)
          let sig_args_raw = fn_type_param_types(__sf_slet_type)
          let single_tuple_param = match sig_args_raw {
            Some(a) => Array::length(ps) == 1 && Array::length(a) > 1,
            None => false
          }
          let np = Array::slice(ps, 0, 0)
          let mut spi = 0
          while spi < Array::length(ps) {
            let (sraw, sty) = Array::get(ps, spi)
            let slen = String::length(sraw)
            let ssn = if slen > 0 {
              let slc = String::char_code_at(sraw, slen - 1)
              if slc == '~' || slc == '?' {
                sraw[0: slen - 1]
              } else {
                sraw
              }
            } else {
              sraw
            }
            let resolved_ty = match sty {
              Some(_) => sty,
              None =>
              match sig_args_raw {
                Some(args) =>
                if single_tuple_param {
                  Some(TyTuple(args))
                } else if Array::length(args) == Array::length(ps) {
                  Some(Array::get(args, spi))
                } else {
                  None
                },
                None => None
              }
            }
            Array::push(np, (ssn, resolved_ty))
            spi = spi + 1
          }
          np
        } else {
          // #715: alias `__sf_slet_type` once here too, matching `then`'s single
          // use (via `fn_type_param_types`) now that it is hoisted above -- see
          // that binding's doc comment.
          let __sf_lnp_ty = __sf_slet_type
          array_empty()
        }
        // debugger breakpoint (DAP P1): in break mode, call the host hook
        // `vibe::dbg_break` at this user function's entry. The hook inspects the
        // wasm backtrace to name the entering function and pauses when it is in the
        // breakpoint set. Stack-neutral (() -> ()), so prepending is safe.
        if debug_break {
          // DAP P2: spill this function's i64 parameters into the dbgargs region so
          // the host hook can read and print them. All user-function wasm params are
          // i64 (vibe value ABI); locals 0..nparams-1 hold the params at entry.
          let dbg_nparams = Array::length(lc_norm_params)
          let dbg_n = if dbg_nparams > dbgargs_cap {
            dbgargs_cap
          } else {
            dbg_nparams
          }
          let mut dbg_pi = 0
          while dbg_pi < dbg_n {
            emit_i32_const(body_buf, dbgargs_base + dbg_pi * 8)
            emit_local_get(body_buf, dbg_pi)
            emit_i64_store(body_buf, 3, 0)
            dbg_pi = dbg_pi + 1
          }
          emit_i32_const(body_buf, dbgargs_count_addr)
          emit_i32_const(body_buf, dbg_n)
          emit_i32_store(body_buf, 2, 0)
          emit_call(body_buf, dbg_break_import_idx)
        } else {
          ()
        }
        let local_names = lc_fresh_string_array()
        let fn_name_dbg = Array::get(fn_names_list, bi)
        let rc_drops = array_empty()
        let rc_alias_dups = array_empty()
        let rc_dups = array_empty()
        let lc_heap_params = lc_fresh_string_array()
        // #715: computed once, unconditionally (regardless of `enable_rc`), and
        // reused below both for the Perceus plan and for the actual codegen call
        // to `compile_expr` -- instead of a separate `get_efn_body(__bi_expr)`
        // call under `enable_rc` (as `fbody`) AND another one further down (as
        // `body`, inside the `is_efn(__bi_expr)` block). Each independent
        // `get_efn_body(__bi_expr)`/`get_efn_params(__bi_expr)` call is a real
        // additional owning "use" of `__bi_expr` for Perceus's purposes (neither
        // is registered in `is_borrow_arg0_call`), inflating the dup budget
        // `__bi_expr` statically needs. See the `lc_norm_params` doc comment
        // above (the same redundant-call pattern, already fixed once for
        // `get_efn_params`) for the full double-free mechanism this avoids.
        let __bi_body = if is_efn(__bi_expr) {
          get_efn_body(__bi_expr)
        } else {
          __bi_expr
        }
        if enable_rc {
          let bfn_drop_start_cell = lc_fresh_int_array()
          let plan = build_perceus_plan_with_params_split(lc_norm_params, __bi_body, lc_borrow_ret_names, lc_borrow_param_user_srt, lc_borrow_param_mask, lc_borrow_view_ret, bfn_drop_start_cell)
          let bfn_drop_start = if Array::length(bfn_drop_start_cell) > 0 {
            Array::get(bfn_drop_start_cell, 0)
          } else {
            0
          }
          let mut lhpi = 0
          while lhpi < Array::length(lc_norm_params) {
            let (lhpn, lhpt) = Array::get(lc_norm_params, lhpi)
            if param_is_heap_in_body(lhpn, lhpt, __bi_body) {
              Array::push(lc_heap_params, lhpn)
            } else {
              ()
            }
            lhpi = lhpi + 1
          }
          // ADR-0092 borrow-inference: for each of THIS fn's borrowed
          // parameters the caller keeps ownership, so the plan's scope-end
          // drop (and any entry dup) for that param must not be emitted here.
          // Slice 1 skipped param0 alone; the mask names every borrowed
          // position.
          let bfn_bi = bsearch_leftmost(lc_borrow_param_user_srt, fn_name_dbg)
          let bfn_mask = if bfn_bi >= 0 && bfn_bi < Array::length(lc_borrow_param_mask) {
            Array::get(lc_borrow_param_mask, bfn_bi)
          } else {
            0
          }
          let bfn_borrowed = lc_fresh_string_array()
          let mut bfp = 0
          while bfp < Array::length(lc_norm_params) {
            if bmask_has(bfn_mask, bfp) {
              let (bfpn, _) = Array::get(lc_norm_params, bfp)
              Array::push(bfn_borrowed, bfpn)
            } else {
              ()
            }
            bfp = bfp + 1
          }
          let mut di = 0
          while di < Array::length(plan) {
            let pa = Array::get(plan, di)
            if pa_is_drop(pa) {
              // Skip ONLY the drops for the borrowed params. The plan is
              // name-keyed, so matching by name across the WHOLE plan also
              // swallowed the scope-end drop of any body-local binding that
              // shadows a borrowed parameter's name -- a leak this filter used
              // to accept ("bounded, safe direction") on the grounds that the
              // narrow eligibility rule made same-named shadows rare.
              //
              // That is a bad thing to lean on: the shadow exclusion is not a
              // check of its own, it is a side effect of md_consume_count
              // counting ANY bare mention as a consume (see
              // compute_borrow_param_user_fns). Anything that makes the
              // consume count more precise -- e.g. the transitive borrow
              // inference of #1740 -- widens eligibility and turns the "rare"
              // leak into a real one. Positional filtering removes the
              // dependency: the params' own scope-end drops are a SUFFIX of
              // the plan (build_perceus_plan_with_params_split records where
              // it starts), so a body-local drop can no longer be confused
              // with a parameter's.
              //
              // Only DROPS are filtered, never dup/alias-dup: a shadow's dups
              // are its own and removing them under-counts references
              // (use-after-free that only surfaces under allocation churn --
              // codegen_heap_e2e_test caught it after ~90 compiles).
              if di >= bfn_drop_start && array_contains_str(bfn_borrowed, pa.name) {
                ()
              } else {
                Array::push(rc_drops, pa.name)
              }
            } else if pa_is_alias_dup(pa) {
              Array::push(rc_alias_dups, pa.name)
            } else if pa_is_dup(pa) {
              Array::push(rc_dups, pa.name)
            } else {
              ()
            }
            di = di + 1
          }
        }
        // Interior-line breakpoints: this function's source file id + that file's
        // newline index (for mapping its statement offsets to lines). Off => 0/empty.
        let dbg_fid = if dbg_line_on {
          Array::get(prov.stmt_file_id, Array::get(fn_stmt_indices, bi))
        } else {
          0
        }
        let dbg_nls = if dbg_line_on {
          Array::get(prov.file_nls, dbg_fid)
        } else {
          lc_fresh_int_array()
        }
        // #1259 step 7: this function's preassigned range, straight out of the
        // frozen plan -- no counting happens here any more.
        Array::set(lambda_plan_cell, 0, Array::get(lambda_bases, bi))
        let lambda_planned_end = if bi + 1 < num_user_funcs {
          Array::get(lambda_bases, bi + 1)
        } else {
          lambda_base_acc
        }
        let compile_ctx = CompileCtx::{
          func_table: FuncTable::{
            names: all_fn_names_list,
            indices: all_fn_indices_list,
            params: all_fn_param_counts,
            returns: all_fn_returns_list,
            needs_env: all_fn_needs_env_list,
            names_sorted: all_fn_names_sorted,
            names_sorted_pos: all_fn_names_sorted_pos
          },
          str_table: StrTable::{
            strs: str_strs, offsets: str_offsets, lengths: str_lengths
          },
          lambda_table: lt_w,
          num_user_funcs: num_user_funcs, func_offset: func_offset,
          ref_cell_names: lc_fresh_string_array(),
          ctor_table: CtorTable::{
            names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names, struct_field_is_ref: array_empty(), names_sorted: lc_ctor_names_sorted, names_sorted_pos: lc_ctor_names_sorted_pos
          },
          ctor_float_fields: ctor_float_fields_list,
          // Sorted copy for compile_expr.vibe's per-identifier membership check
          // (bsearch_leftmost) -- keep `thunk_names_list` itself unsorted, its
          // POSITION is load-bearing for the per-thunk global-slot index lookup
          // a few hundred lines below (tg_k / tg_value_g). Computed once above
          // (thunk_names_sorted_shared), not per-function.
          thunk_names: thunk_names_sorted_shared,
          const_int_names: const_int_names_list,
          const_int_values: const_int_values_list,
          enable_rc: enable_rc,
          rc_entry_untag_return: enable_rc && fn_name_dbg == entry_name,
          rc_shadow: rc_shadow,
          rc_drop_names: rc_drops,
          rc_alias_dup_names: rc_alias_dups,
          heap_binding_names: lc_heap_params,
          rc_drop_func_idx: if enable_rc {
            rc_drop_idx
          } else {
            -1
          },
          rc_dup_func_idx: if enable_rc {
            rc_dup_idx
          } else {
            -1
          },
          region_ptr_addr: region_ptr_addr,
          region_arr_new_func_idx: region_arr_new_idx,
          region_bytes_new_func_idx: region_bytes_new_idx,
          rc_alloc_func_idx: if enable_rc {
            rc_alloc_idx
          } else {
            -1
          },
          heap_grow_check_func_idx: heap_grow_check_idx,
          map_hash_func_idx: map_hash_idx,
          map_cap_func_idx: map_cap_idx,
          map_build_index_func_idx: map_build_index_idx,
          map_probe_func_idx: map_probe_index_idx,
          rc_dup_names: rc_dups,
          capture_name_index: capture_name_index_shared,
          float_local_slots: lc_fresh_int_array(),
          int_local_slots: lc_fresh_int_array(),
          agg_local_slots: lc_fresh_int_array(),
          agg_local_exprs: lc_fresh_expr_array(),
          agg_ret_names: lc_agg_ret_names,
          agg_ret_infos: lc_agg_ret_infos,
          heap_ret_names: lc_heap_ret_names,
          effect_names: effect_names_list,
          effect_op_keys: effect_op_keys_list,
          effect_op_arities: effect_op_arities_list,
          cov: cov_state,
          dbg_line_idx: dbg_line_import_idx,
          dbg_line_nl: dbg_nls,
          dbg_line_file_id: dbg_fid,
          loop_borrowed_names: lc_fresh_string_array(),
          loop_consumed_names: lc_fresh_string_array(),
          reuse_scrutinee_names: lc_fresh_string_array(),
          reuse_flag_locals: lc_fresh_int_array(),
          borrow_ret_names: lc_borrow_ret_names,
          borrow_param_user: lc_borrow_param_user_srt,
          borrow_param_mask: lc_borrow_param_mask,
          borrow_view_ret: lc_borrow_view_ret,
          scalar_ret_names: lc_scalar_ret_names,
          pending_letrec_self_name: lc_fresh_string_array(),
          table_slots_used: table_slots_used,
          lambda_plan_next: lambda_plan_cell,
          linemap: linemap_state
        }
        if is_efn(__bi_expr) {
          // #715: `lc_norm_params` (built above from `get_efn_params(__bi_expr)`)
          // already carries each parameter's `~`/`?`-stripped name in `.0` --
          // reuse it instead of a second `get_efn_params(__bi_expr)` call plus a
          // duplicate stripping pass (see the `__bi_body` doc comment above).
          let body = __bi_body
          let mut pi = 0
          while pi < Array::length(lc_norm_params) {
            let (pname, _) = Array::get(lc_norm_params, pi)
            Array::push(local_names, pname)
            pi = pi + 1
          }
          // #724 round 2: seed the aggregate-shape log from ANNOTATED params
          // (param slot i = local i), so `p == q` on tuple/struct/enum-typed
          // params compares structurally.
          let sig_ptypes = fn_type_param_types(__sf_slet_type)
          let mut psi = 0
          while psi < Array::length(lc_norm_params) {
            // Prefer the SLet signature's param types (`let f: (P2) -> ..`);
            // fall back to a per-param annotation (`(p: P2) -> ..`).
            let pann = match sig_ptypes {
              Some(pts) => if Array::length(pts) == Array::length(lc_norm_params) {
                Some(Array::get(pts, psi))
              } else {
                let (_, pa) = Array::get(lc_norm_params, psi)
                pa
              },
              None => {
                let (_, pa) = Array::get(lc_norm_params, psi)
                pa
              }
            }
            match pann {
              Some(pte) => {
                let pinfo = agg_info_of_type_expr(compile_ctx.ctor_table, pte)
                if pinfo > 0 {
                  Array::push(compile_ctx.agg_local_slots, psi * 256 + pinfo)
                  // #811: agg_local_exprs is the index-aligned PARALLEL of
                  // agg_local_slots (agg_log_reset_above2 prunes both in
                  // lockstep, reading exprs[i] for every slots[i]). This param
                  // seed pushed only to slots, leaving exprs one entry short —
                  // every later reset then read exprs out of bounds and
                  // compacted the garbage back in. Push the same "no shape
                  // expr" placeholder the let-binding site uses.
                  Array::push(compile_ctx.agg_local_exprs, EInt(0))
                } else {
                  ()
                }
                // Float/Double-typed params feed expr_is_floatish the same way
                // let-bound floats do; without this, `a == b` on annotated float
                // params misses the f64 path and (under RC, where floats are
                // boxed) compares heap pointers — `1.5 == 1.5` came out false.
                //
                // #1015: Bool-typed params feed expr_is_boolish the same way
                // (int_local_slots kind 3, #769 encoding slot*4+kind) let-bound
                // bools do -- without this a Bool-typed param `b` passed straight
                // to `to_string(b)` (e.g. `fn render(b: Bool) -> String {
                // to_string(b) }`) is just a bare EIdent with no tracked slot
                // info, so neither the call-site fast path in
                // codegen/expr/compile_call.vibe nor `"\{b}"` interpolation can
                // recognize it as Bool -- both fall through to the generic
                // runtime bit-pattern heuristic and mis-render `true` as `"1"`.
                match pte {
                  TyName(ptn) => if ptn == "Float" || ptn == "Double" {
                    Array::push(compile_ctx.float_local_slots, psi * 2 + 1)
                  } else if ptn == "Bool" {
                    Array::push(compile_ctx.int_local_slots, psi * 4 + 3)
                  } else {
                    ()
                  },
                  _ => ()
                }
              },
              None => ()
            }
            psi = psi + 1
          }
          Array::push(local_names, "__env")
          let param_count = Array::length(lc_norm_params) + 1
          if enable_rc {
            let mut edi = 0
            while edi < Array::length(lc_norm_params) {
              let (edn, _edt) = Array::get(lc_norm_params, edi)
              if array_contains_str(lc_heap_params, edn) {
                let mut edc = 0
                let mut edj = 0
                while edj < Array::length(rc_dups) {
                  if Array::get(rc_dups, edj) == edn {
                    edc = edc + 1
                  } else {
                    ()
                  }
                  edj = edj + 1
                }
                let mut ede = 0
                while ede < edc {
                  emit_rc_dup_guarded(body_buf, edi, rc_shadow, if enable_rc {
                    rc_dup_idx
                  } else {
                    -1
                  })
                  ede = ede + 1
                }
              } else {
                ()
              }
              edi = edi + 1
            }
          } else {
            ()
          }
          // #805: an inline-wasm fn's instruction bytes come from the WAT
          // assembler, not compile_expr (its AST body is a neutral EInt(0) after
          // lc_extract_inline_wasm). Params are Int-only (parser-enforced), so
          // no RC/Perceus bookkeeping applies; no extra locals are introduced
          // (final_nl == param_count => meta extra 0).
          let mut iw_found = -1
          let mut iw_scan = 0
          while iw_scan < Array::length(iw_names) {
            if Array::get(iw_names, iw_scan) == fn_name_dbg {
              iw_found = iw_scan
              iw_scan = Array::length(iw_names)
            } else {
              iw_scan = iw_scan + 1
            }
          }
          // ADR-0092 Phase 1 widening: a function whose body is EXACTLY
          // `match p { ... }` over one of its own heap params (the dominant
          // shape of the compiler's AST-rebuild loops) stages the same reuse
          // fusion the ELet form gets in compile_expr_tail — flag local first,
          // (name, flag) pushed for compile_match, and the param's #725
          // epilogue drop below guarded on the flag.
          let pfuse_name = if enable_rc && rc_drop_idx >= 0 && iw_found < 0 && expr_tag(body) == 16 && is_eident(get_match_scrutinee(body)) {
            get_eident_name(get_match_scrutinee(body))
          } else {
            ""
          }
          let pfuse = pfuse_name != "" && array_contains_str(rc_drops, pfuse_name) && array_contains_str(lc_heap_params, pfuse_name)
          let pfuse_flag = if pfuse {
            Array::push(local_names, "__reuse_flag")
            emit_i64_const(body_buf, 0)
            emit_local_set(body_buf, param_count)
            Array::push(compile_ctx.reuse_scrutinee_names, pfuse_name)
            Array::push(compile_ctx.reuse_flag_locals, param_count)
            param_count
          } else {
            0 - 1
          }
          let iw_param_names = lc_fresh_string_array()
          let mut iw_pi = 0
          while iw_pi < Array::length(lc_norm_params) {
            let (iw_pn, _) = Array::get(lc_norm_params, iw_pi)
            Array::push(iw_param_names, iw_pn)
            iw_pi = iw_pi + 1
          }
          lc_compile_iw_body(body_buf, fn_name_dbg, iw_wats, iw_found, iw_param_names, param_count, iw_extra_cell)
          let final_nl = if iw_found >= 0 {
            param_count
          } else {
            compile_expr(body_buf, body, local_names, if pfuse {
              param_count + 1
            } else {
              param_count
            }, compile_ctx, -1)
          }
          if pfuse {
            Array::truncate(compile_ctx.reuse_scrutinee_names, Array::length(compile_ctx.reuse_scrutinee_names) - 1)
            Array::truncate(compile_ctx.reuse_flag_locals, Array::length(compile_ctx.reuse_flag_locals) - 1)
          } else {
            ()
          }
          let mut tail_nl = final_nl
          if enable_rc && rc_drop_idx >= 0 {
            let tail_root = scope_tail_proj_root(body)
            // #706 leak follow-up: a loop-borrowed param's protective rc_dup (see
            // compile_call.vibe's cc_is_loop_borrowed_ident sites) is matched by the
            // callee's OWN internal drop each iteration — it never touches this
            // function's own slot-held reference. The Perceus plan still counts that
            // textual occurrence as "one real consume" (so `remaining` hits 0 and no
            // PaDrop is emitted), leaking the binding's own reference once per such
            // occurrence. Count each param's occurrences in loop_consumed_names and
            // emit that many EXTRA rc_drop calls here — purely additive to the
            // existing rc_drops accounting, so it cannot perturb any decision the
            // plan and codegen already agree on elsewhere.
            let mut need_dup = false
            let mut tci = 0
            while tci < Array::length(lc_norm_params) {
              let (tcn, _tct) = Array::get(lc_norm_params, tci)
              let mut tcn_loop_extra = 0
              let mut tcle = 0
              while tcle < Array::length(compile_ctx.loop_consumed_names) {
                if Array::get(compile_ctx.loop_consumed_names, tcle) == tcn {
                  tcn_loop_extra = tcn_loop_extra + 1
                } else {
                  ()
                }
                tcle = tcle + 1
              }
              // #1085: the loop-count clause only applies when every consuming
              // occurrence is a loop site (see lc_has_nonloop_consume).
              let tcn_loop_drop = tcn_loop_extra > 0 && !lc_has_nonloop_consume(body, tcn)
              if array_contains_str(lc_heap_params, tcn) && (array_contains_str(rc_drops, tcn) || tcn_loop_drop) && tcn == tail_root {
                need_dup = true
              } else {
                ()
              }
              tci = tci + 1
            }
            let rtemp = final_nl
            if need_dup {
              emit_local_set(body_buf, rtemp)
              emit_rc_dup_guarded(body_buf, rtemp, rc_shadow, if enable_rc {
                rc_dup_idx
              } else {
                -1
              })
              tail_nl = final_nl + 1
            } else {
              ()
            }
            let mut tdj = 0
            while tdj < Array::length(lc_norm_params) {
              let (tdn, _tdt) = Array::get(lc_norm_params, tdj)
              if array_contains_str(lc_heap_params, tdn) {
                // #725: a loop-protected consume (per-iteration dup at the call
                // site, #706 above) is NET-ZERO at runtime — the dup is matched by
                // the callee's own drop each execution and never touches the
                // param's single owned reference. So the epilogue owes EXACTLY ONE
                // drop for that reference, regardless of how many textual
                // loop-consumed SITES exist: a second site in a sibling match arm
                // (even one that never executes — its protective dup is emitted
                // but never runs) previously got its own per-occurrence drop,
                // over-releasing the CALLER's value and poisoning the RC free
                // list (fuzz/findings/issue725/). When a loop site exists it also
                // absorbs the plan's PaDrop (the textual counts ate the budget the
                // plan would otherwise drop), so emit one drop total either way.
                let mut tdn_loop_count = 0
                let mut tdle = 0
                while tdle < Array::length(compile_ctx.loop_consumed_names) {
                  if Array::get(compile_ctx.loop_consumed_names, tdle) == tdn {
                    tdn_loop_count = tdn_loop_count + 1
                  } else {
                    ()
                  }
                  tdle = tdle + 1
                }
                // #1085: the "one epilogue drop when loop sites exist" rule
                // (#725) assumed every textual consume is a net-zero loop site.
                // When a NON-loop consuming occurrence also exists (e.g.
                // `Array::set(buf, i, v)` in a sibling branch of the loop), the
                // path through that real consume transfers the param's own
                // reference and the unconditional drop over-releases the stored
                // value (use-after-free — the loop arm does not even need to
                // execute). Suppress the loop-count drop in that mixed case;
                // the loop-only path then leaks one reference per call, which
                // is the safe direction until path-sensitive accounting lands
                // (fixtures/rc_branch_loop_mixed_consume_test.vibe).
                let tdn_loop_drop = tdn_loop_count > 0 && !lc_has_nonloop_consume(body, tdn)
                if array_contains_str(rc_drops, tdn) || tdn_loop_drop {
                  if pfuse_flag >= 0 && tdn == pfuse_name {
                    // ADR-0092: a reuse arm consumed this param's reference —
                    // drop only on the paths that did not (flag still 0).
                    emit_local_get(body_buf, pfuse_flag)
                    emit_i64_eqz(body_buf)
                    emit_if_void(body_buf)
                    emit_local_get(body_buf, tdj)
                    emit_call(body_buf, rc_drop_idx)
                    emit_end(body_buf)
                  } else {
                    emit_local_get(body_buf, tdj)
                    emit_call(body_buf, rc_drop_idx)
                  }
                } else {
                  ()
                }
              } else {
                ()
              }
              tdj = tdj + 1
            }
            if need_dup {
              emit_local_get(body_buf, rtemp)
            } else {
              ()
            }
          } else {
            ()
          }
          if enable_rc && fn_name_dbg == entry_name {
            emit_i64_const(body_buf, 1)
            emit_i64_shr_s(body_buf)
          }
          Array::push(bodies, body_buf)
          // #1259: the walk allocated exactly as many lambdas as the plan said.
          // The per-allocation check in compile_lambda catches an UNDER-count (the
          // walk runs past the planned range); this catches an OVER-count, where
          // the plan reserved slots for EFn nodes codegen never reached.
          if Array::get(lambda_plan_cell, 0) != lambda_planned_end {
            throw(String::concat("lambda plan over-count: planned through ", String::concat(__to_string(lambda_planned_end), String::concat(", walk stopped at ", __to_string(Array::get(lambda_plan_cell, 0))))))
          } else {
            ()
          }
          let extra = if tail_nl > param_count {
            tail_nl - param_count
          } else {
            0
          }
          Array::push(meta_i32, Array::get(iw_extra_cell, 0))
          Array::push(meta_i64, extra + Array::get(iw_extra_cell, 1))
          Array::push(meta_v128, Array::get(iw_extra_cell, 2))
        } else {
          // Module-level non-function `let` (a THUNK): previously the initializer
          // re-ran on EVERY reference, so a 16-entry lookup table cost an O(size)
          // allocation per access (~148 B/call in bench/_probe_sb_phases.vibe)
          // and, worse, each access saw a FRESH value while the gc backend
          // initializes module globals ONCE — a cross-backend semantics split
          // (mutations visible there, lost here). Memoize: two appended i64
          // globals per thunk (value + init flag; base index rc?7:6, after
          // g_op_index). First call computes and caches, later calls reload.
          // Under RC the cache holds one permanent reference and every return
          // (both paths) hands the caller a guarded-dup'd reference, so consumer
          // drops balance exactly like the old fresh-value contract.
          Array::push(local_names, "__env")
          let param_count = 1
          let mut tg_k = -1
          let mut tg_i = 0
          while tg_i < Array::length(thunk_names_list) {
            if Array::get(thunk_names_list, tg_i) == fn_name_dbg {
              tg_k = tg_i
              tg_i = Array::length(thunk_names_list)
            } else {
              tg_i = tg_i + 1
            }
          }
          let tg_base = if enable_rc {
            7
          } else {
            6
          }
          let tg_value_g = tg_base + tg_k * 2
          let tg_flag_g = tg_value_g + 1
          emit_global_get(body_buf, tg_flag_g)
          emit_i32_wrap_i64(body_buf)
          emit_if_i64(body_buf)
          emit_global_get(body_buf, tg_value_g)
          emit_local_tee(body_buf, 1)
          if enable_rc {
            emit_rc_dup_guarded(body_buf, 1, rc_shadow, if enable_rc {
              rc_dup_idx
            } else {
              -1
            })
          } else {
            ()
          }
          emit_else(body_buf)
          Array::push(local_names, "__thunk_memo")
          let final_nl = compile_expr(body_buf, __bi_expr, local_names, 2, compile_ctx, -1)
          emit_local_tee(body_buf, 1)
          emit_global_set(body_buf, tg_value_g)
          if enable_rc {
            emit_rc_dup_guarded(body_buf, 1, rc_shadow, if enable_rc {
              rc_dup_idx
            } else {
              -1
            })
          } else {
            ()
          }
          emit_i64_const(body_buf, 1)
          emit_global_set(body_buf, tg_flag_g)
          emit_local_get(body_buf, 1)
          emit_end(body_buf)
          if enable_rc && fn_name_dbg == entry_name {
            emit_i64_const(body_buf, 1)
            emit_i64_shr_s(body_buf)
          }
          Array::push(bodies, body_buf)
          // #1259: the walk allocated exactly as many lambdas as the plan said.
          // The per-allocation check in compile_lambda catches an UNDER-count (the
          // walk runs past the planned range); this catches an OVER-count, where
          // the plan reserved slots for EFn nodes codegen never reached.
          if Array::get(lambda_plan_cell, 0) != lambda_planned_end {
            throw(String::concat("lambda plan over-count: planned through ", String::concat(__to_string(lambda_planned_end), String::concat(", walk stopped at ", __to_string(Array::get(lambda_plan_cell, 0))))))
          } else {
            ()
          }
          let extra = if final_nl > param_count {
            final_nl - param_count
          } else {
            0
          }
          Array::push(meta_i32, 0)
          Array::push(meta_i64, extra)
          Array::push(meta_v128, 0)
        }
        // #1259 step 7: harvest this function's codegen output as a VALUE.
        //
        // Everything the whole-program assembly needs from compiling function `bi`
        // is now in hand: its encoded body, its two meta entries, and the lambdas
        // it produced -- which sit at their PLANNED indices (#1275/#1277), so the
        // table_slot immediates already baked into the body refer to the slots a
        // full assembly will install them at. That is what makes a body compiled
        // in isolation reusable, and it is why the lambda plan had to be frozen
        // first.
        //
        // Harvest is unconditional and cheap (it copies references into parallel
        // arrays, it does not re-encode). The cache is only READ when a caller
        // supplies one.
        codegen_body_cache_record(body_cache_out, bi, bodies, meta_i32, meta_i64, meta_v128, lt_w, Array::get(lambda_bases, bi), lambda_planned_end, table_slots_used, __slot_lo, Array::length(table_slots_used))
      }
    }
    bi = bi + 1
  }
  let num_lambdas = Array::length(lt_w.bodies)
  let start_body = bytebuf_new()
  let entry_func_idx = if entry_user_idx >= 0 {
    entry_user_idx + func_offset
  } else {
    -1
  }
  // ADR-0069: the synthesized `_start` prints the entry's Int return via
  // print_int (the historical `let main: () -> Int` convention), but a
  // Unit-returning entry (`fn main {}` desugars to `() -> Unit`, and any
  // explicit `let main: () -> Unit`) must NOT print — the old behavior
  // appended a stray `0` line after the program's own output. Detect Unit
  // from the entry's declared return type: the EFn return annotation or the
  // binding's `: (..) -> Unit` type annotation.
  let mut entry_returns_unit = false
  if entry_user_idx >= 0 {
    let mut eri = 0
    while eri < Array::length(stmts) {
      match Array::get(stmts, eri) {
        SLet(_, _, ename, eann, eval) => if ename == entry_name {
          let ann_unit = match eann {
            Some(TyFn(_, ann_ret, _)) => linked_type_expr_is_unit(ann_ret),
            _ => false
          }
          let ret_unit = match eval {
            EFn(_, _, _, efn_ret, _, _) => match efn_ret {
              Some(rt) => linked_type_expr_is_unit(rt),
              None => false
            },
            _ => false
          }
          if ann_unit || ret_unit {
            entry_returns_unit = true
          }
        },
        _ => ()
      }
      eri = eri + 1
    }
  }
  if entry_user_idx >= 0 {
    let entry_params = Array::get(fn_param_counts, entry_user_idx)
    if entry_params != 0 {
      throw("WASI entry function must take 0 parameters")
    }
    emit_i64_const(start_body, 0)
    emit_call(start_body, entry_func_idx)
    if entry_returns_unit {
      emit_drop(start_body)
    } else {
      emit_call(start_body, print_int_idx)
    }
  } else {
    let mut sti = 0
    while sti < Array::length(test_fn_names) {
      let stname = Array::get(test_fn_names, sti)
      let mut __stj = 0
      let mut __stf = -1
      while __stj < Array::length(fn_names_list) {
        if Array::get(fn_names_list, __stj) == stname {
          __stf = __stj
        }
        __stj = __stj + 1
      }
      if __stf >= 0 {
        emit_i64_const(start_body, 0)
        emit_call(start_body, func_offset + __stf)
        emit_drop(start_body)
      }
      sti = sti + 1
    }
  }
  Array::push(bodies, start_body)
  Array::push(meta_i32, 0)
  Array::push(meta_i64, 0)
  Array::push(meta_v128, 0)
  let run_body = bytebuf_new()
  if entry_func_idx >= 0 {
    emit_i64_const(run_body, 0)
    emit_call(run_body, entry_func_idx)
  } else {
    let mut rti = 0
    while rti < Array::length(test_fn_names) {
      let tname = Array::get(test_fn_names, rti)
      let mut __rtj = 0
      let mut __rtf = -1
      while __rtj < Array::length(fn_names_list) {
        if Array::get(fn_names_list, __rtj) == tname {
          __rtf = __rtj
        }
        __rtj = __rtj + 1
      }
      if __rtf >= 0 {
        emit_i64_const(run_body, 0)
        emit_call(run_body, func_offset + __rtf)
        emit_drop(run_body)
      }
      rti = rti + 1
    }
    emit_i64_const(run_body, 0)
  }
  Array::push(bodies, run_body)
  Array::push(meta_i32, 0)
  Array::push(meta_i64, 0)
  Array::push(meta_v128, 0)
  let mut li = 0
  while li < num_lambdas {
    Array::push(bodies, Array::get(lt_w.bodies, li))
    Array::push(meta_i32, Array::get(lt_w.meta_i32, li))
    Array::push(meta_i64, Array::get(lt_w.meta_i64, li))
    Array::push(meta_v128, 0)
    li = li + 1
  }
  let mut max_closure_arity = -1
  let mut lai = 0
  while lai < num_lambdas {
    let lpc = Array::get(lt_w.param_counts, lai) - 1
    if lpc > max_closure_arity {
      max_closure_arity = lpc
    }
    lai = lai + 1
  }
  let mut uai = 0
  while uai < num_user_funcs {
    let upc = Array::get(fn_param_counts, uai)
    if upc > max_closure_arity {
      max_closure_arity = upc
    }
    uai = uai + 1
  }
  let mut iai = 0
  while iai < Array::length(linked_imports) {
    let (_, _, ipc, _) = Array::get(linked_imports, iai)
    if ipc > max_closure_arity {
      max_closure_arity = ipc
    }
    iai = iai + 1
  }
  let num_closure_types = if max_closure_arity >= 0 {
    max_closure_arity + 1
  } else {
    0
  }
  // Interior-line breakpoints (span-arc step5): when active, the `vibe::dbg_line`
  // import needs an `(i32) -> ()` func type. No existing base type is `(i32)->()`
  // (type 1 is `(i64)->()`), so append one new type AFTER all base + closure
  // types at index `num_base_types + num_closure_types`. This is strictly beyond
  // every linked-import type index (which use `num_base_types + lparams`, bounded
  // by num_closure_types), so existing indices are unshifted. -1 when off.
  let dbg_line_type_idx = if dbg_line_on {
    num_base_types + num_closure_types
  } else {
    -1
  }
  let extra_dbg_types = if dbg_line_on {
    1
  } else {
    0
  }
  // #794: `vibe.http_request` needs an `(i64,i64,i64,i64) -> i64` func type.
  // No base type has 4 i64 params, and closure types are data-dependent (only
  // present up to the max closure arity in the unit), so append one dedicated
  // type AFTER base + closure + dbg types when the import is live. Off =>
  // byte-identical type section (fixpoint-safe).
  let http_request_type_idx = if need_http_request_builtin {
    num_base_types + num_closure_types + extra_dbg_types
  } else {
    -1
  }
  let extra_http_types = if need_http_request_builtin {
    1
  } else {
    0
  }
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types + extra_dbg_types + extra_http_types)
  emit_func_type_raw(type_content, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(type_content, [
    126
  ], array_empty())
  emit_func_type_raw(type_content, array_empty(), array_empty())
  emit_func_type_raw(type_content, [
    126
  ], [
    126
  ])
  emit_func_type_raw(type_content, [
    126,
    126
  ], [
    126
  ])
  emit_func_type_raw(type_content, array_empty(), [
    126
  ])
  emit_func_type_raw(type_content, [
    126,
    126
  ], array_empty())
  emit_func_type_raw(type_content, [
    126,
    126,
    126
  ], array_empty())
  emit_func_type_raw(type_content, [
    126,
    126,
    126
  ], [
    126
  ])
  let mut cti = 0
  while cti < num_closure_types {
    let num_params = cti + 1
    let ct_params = lc_fresh_int_array()
    let mut cpti = 0
    while cpti < num_params {
      Array::push(ct_params, 126)
      cpti = cpti + 1
    }
    emit_func_type_raw(type_content, ct_params, [
      126
    ])
    cti = cti + 1
  }
  // Interior-line breakpoints: append the `(i32, i32) -> ()` type for
  // `vibe::dbg_line` (127 = i32; params = file_id, line). Only when active, so the
  // type section is byte-identical off.
  if dbg_line_on {
    emit_func_type_raw(type_content, [
      127,
      127
    ], array_empty())
  } else {
    ()
  }
  // #794: the `(i64,i64,i64,i64) -> i64` type for vibe.http_request, appended
  // last so every other type index is unshifted.
  if need_http_request_builtin {
    emit_func_type_raw(type_content, [
      126,
      126,
      126,
      126
    ], [
      126
    ])
  } else {
    ()
  }
  let out = bytebuf_new()
  emit_header(out)
  emit_vibe_abi_custom_section(out, "raw")
  // #cov: emit a `vibe_cov` custom section describing the function-hit bitmap.
  // Layout of the payload: i32 LE cov_base, i32 LE cov_count, then the
  // user-function names (one per line, in bitmap-index order). The consumer
  // reads memory[cov_base .. cov_base+cov_count] after running and maps each
  // hit byte back to a name. Only present in coverage builds.
  if coverage {
    let cov_content = bytebuf_new()
    let cov_name = "vibe_cov"
    leb128_encode_u32(cov_content, String::length(cov_name))
    let mut cni = 0
    while cni < String::length(cov_name) {
      bytebuf_push(cov_content, String::char_code_at(cov_name, cni))
      cni = cni + 1
    }
    bytebuf_push(cov_content, cov_base&255)
    bytebuf_push(cov_content, (cov_base>>8)&255)
    bytebuf_push(cov_content, (cov_base>>16)&255)
    bytebuf_push(cov_content, (cov_base>>24)&255)
    bytebuf_push(cov_content, cov_count&255)
    bytebuf_push(cov_content, (cov_count>>8)&255)
    bytebuf_push(cov_content, (cov_count>>16)&255)
    bytebuf_push(cov_content, (cov_count>>24)&255)
    let mut covni = 0
    while covni < num_user_funcs {
      let covnm = Array::get(fn_names_list, covni)
      let covnml = String::length(covnm)
      let mut covci = 0
      while covci < covnml {
        bytebuf_push(cov_content, String::char_code_at(covnm, covci))
        covci = covci + 1
      }
      bytebuf_push(cov_content, 10)
      covni = covni + 1
    }
    bytebuf_push_section(out, 0, cov_content)
    // #cov branch: a `vibe_cov_branch` custom section describing the branch-hit
    // bitmap. Payload: i32 LE branch_base, i32 LE branch_count, then
    // branch_count i32 LE entries giving the owning user-function index per
    // branch id (in id order). The consumer reads memory[base .. base+count]
    // after running and attributes each hit branch to its function (names from
    // the `vibe_cov` section), so it can report per-function branch coverage.
    let covb_content = bytebuf_new()
    let covb_name = "vibe_cov_branch"
    leb128_encode_u32(covb_content, String::length(covb_name))
    let mut covbni = 0
    while covbni < String::length(covb_name) {
      bytebuf_push(covb_content, String::char_code_at(covb_name, covbni))
      covbni = covbni + 1
    }
    let covb_count = Array::get(cov_state.next, 0)
    bytebuf_push(covb_content, cov_branch_base&255)
    bytebuf_push(covb_content, (cov_branch_base>>8)&255)
    bytebuf_push(covb_content, (cov_branch_base>>16)&255)
    bytebuf_push(covb_content, (cov_branch_base>>24)&255)
    bytebuf_push(covb_content, covb_count&255)
    bytebuf_push(covb_content, (covb_count>>8)&255)
    bytebuf_push(covb_content, (covb_count>>16)&255)
    bytebuf_push(covb_content, (covb_count>>24)&255)
    let mut covbi = 0
    while covbi < covb_count {
      let owner = Array::get(cov_state.owners, covbi)
      bytebuf_push(covb_content, owner&255)
      bytebuf_push(covb_content, (owner>>8)&255)
      bytebuf_push(covb_content, (owner>>16)&255)
      bytebuf_push(covb_content, (owner>>24)&255)
      covbi = covbi + 1
    }
    bytebuf_push_section(out, 0, covb_content)
  } else {
    ()
  }
  // debugger trace (DAP P1 groundwork): emit a `vibe.trace` custom section
  // describing the in-memory trace log. Payload layout: i32 LE counter_addr,
  // i32 LE log_base, i32 LE cap, then the user-function names (one per line, in
  // user-index order — the same list the name section uses). The runner reads
  // memory[counter_addr] for the count, then `count` i32 entries from log_base,
  // and maps each index to a name. Only present in debug-trace builds.
  if debug_trace {
    let tr_content = bytebuf_new()
    let tr_name = "vibe.trace"
    leb128_encode_u32(tr_content, String::length(tr_name))
    let mut trni = 0
    while trni < String::length(tr_name) {
      bytebuf_push(tr_content, String::char_code_at(tr_name, trni))
      trni = trni + 1
    }
    bytebuf_push(tr_content, trace_counter_addr&255)
    bytebuf_push(tr_content, (trace_counter_addr>>8)&255)
    bytebuf_push(tr_content, (trace_counter_addr>>16)&255)
    bytebuf_push(tr_content, (trace_counter_addr>>24)&255)
    bytebuf_push(tr_content, trace_log_base&255)
    bytebuf_push(tr_content, (trace_log_base>>8)&255)
    bytebuf_push(tr_content, (trace_log_base>>16)&255)
    bytebuf_push(tr_content, (trace_log_base>>24)&255)
    bytebuf_push(tr_content, trace_cap&255)
    bytebuf_push(tr_content, (trace_cap>>8)&255)
    bytebuf_push(tr_content, (trace_cap>>16)&255)
    bytebuf_push(tr_content, (trace_cap>>24)&255)
    let mut trni2 = 0
    while trni2 < num_user_funcs {
      let trnm = Array::get(fn_names_list, trni2)
      let trnml = String::length(trnm)
      let mut trci = 0
      while trci < trnml {
        bytebuf_push(tr_content, String::char_code_at(trnm, trci))
        trci = trci + 1
      }
      bytebuf_push(tr_content, 10)
      trni2 = trni2 + 1
    }
    bytebuf_push_section(out, 0, tr_content)
  } else {
    ()
  }
  // debugger argument inspection (DAP P2): emit a `vibe.dbgargs` custom section
  // publishing the addresses + value ABI the runner reads. Payload layout:
  // i32 LE dbgargs_count_addr, i32 LE dbgargs_base, i32 LE tag_mode. At a
  // breakpoint the runner reads memory[count_addr] (i32) for the arg count, then
  // that many i64 values from dbgargs_base, decoding each per tag_mode:
  //   tag_mode 0 (enable_rc off): values are plain untagged i64 ints.
  //   tag_mode 1 (enable_rc on):  values are 1-bit tagged — low bit 0 => int
  //                               (raw >> 1), low bit 1 => heap pointer (hex).
  // Only present in break builds.
  if debug_break {
    let da_content = bytebuf_new()
    let da_name = "vibe.dbgargs"
    leb128_encode_u32(da_content, String::length(da_name))
    let mut dani = 0
    while dani < String::length(da_name) {
      bytebuf_push(da_content, String::char_code_at(da_name, dani))
      dani = dani + 1
    }
    bytebuf_push(da_content, dbgargs_count_addr&255)
    bytebuf_push(da_content, (dbgargs_count_addr>>8)&255)
    bytebuf_push(da_content, (dbgargs_count_addr>>16)&255)
    bytebuf_push(da_content, (dbgargs_count_addr>>24)&255)
    bytebuf_push(da_content, dbgargs_base&255)
    bytebuf_push(da_content, (dbgargs_base>>8)&255)
    bytebuf_push(da_content, (dbgargs_base>>16)&255)
    bytebuf_push(da_content, (dbgargs_base>>24)&255)
    let da_tag_mode = if enable_rc {
      1
    } else {
      0
    }
    bytebuf_push(da_content, da_tag_mode&255)
    bytebuf_push(da_content, (da_tag_mode>>8)&255)
    bytebuf_push(da_content, (da_tag_mode>>16)&255)
    bytebuf_push(da_content, (da_tag_mode>>24)&255)
    bytebuf_push_section(out, 0, da_content)
  } else {
    ()
  }
  // debugger named-parameter inspection (DAP P4): emit a `vibe.dbgnames` custom
  // section listing, per user function (in user-index order — the same order as
  // the name section / fn_names_list / vibe.dbgargs spill), that function's name
  // followed by its parameter names. One record per function, terminated by
  // newline (10); within a record fields are tab-delimited (9): the first field
  // is the function name, the remaining fields are the parameter names. A
  // function with no params emits just its name + newline. Names are capped at
  // dbgargs_cap to match the spilled value count. The runner keys a map by
  // function name so entering-function F's names can be paired with F's spilled
  // values to print `args: [name=value]`. Only present in break builds; off =>
  // byte-identical to a normal build (fixpoint preserved).
  if debug_break {
    let dn_content = bytebuf_new()
    let dn_name = "vibe.dbgnames"
    leb128_encode_u32(dn_content, String::length(dn_name))
    let mut dnni = 0
    while dnni < String::length(dn_name) {
      bytebuf_push(dn_content, String::char_code_at(dn_name, dnni))
      dnni = dnni + 1
    }
    let mut dnfi = 0
    while dnfi < num_user_funcs {
      let dn_fnname = Array::get(fn_names_list, dnfi)
      let mut dn_fci = 0
      while dn_fci < String::length(dn_fnname) {
        bytebuf_push(dn_content, String::char_code_at(dn_fnname, dn_fci))
        dn_fci = dn_fci + 1
      }
      let dn_stmt = Array::get(stmts, Array::get(fn_stmt_indices, dnfi))
      let dn_expr = get_slet_expr(dn_stmt)
      if is_efn(dn_expr) {
        let dn_params = get_efn_params(dn_expr)
        let dn_np = Array::length(dn_params)
        let dn_n = if dn_np > dbgargs_cap {
          dbgargs_cap
        } else {
          dn_np
        }
        let mut dn_pi = 0
        while dn_pi < dn_n {
          let (dn_pname_raw, _) = Array::get(dn_params, dn_pi)
          let dn_pnl = String::length(dn_pname_raw)
          let dn_pname = if dn_pnl > 0 {
            let dn_plc = String::char_code_at(dn_pname_raw, dn_pnl - 1)
            if dn_plc == '~' || dn_plc == '?' {
              dn_pname_raw[0: dn_pnl - 1]
            } else {
              dn_pname_raw
            }
          } else {
            dn_pname_raw
          }
          bytebuf_push(dn_content, 9)
          let mut dn_ci = 0
          while dn_ci < String::length(dn_pname) {
            bytebuf_push(dn_content, String::char_code_at(dn_pname, dn_ci))
            dn_ci = dn_ci + 1
          }
          dn_pi = dn_pi + 1
        }
      } else {
        // #715: `dn_expr` is a fresh per-iteration owned binding (like
        // `__bi_expr` in the main codegen loop above), and -- unlike
        // `__bi_expr` -- `is_efn(dn_expr)` is NOT overwhelmingly true here:
        // `fn_stmt_indices` legitimately mixes real functions with non-
        // function "thunk" entries (constant initializers), so this `else`
        // is a common, not rare, runtime path. An empty `else { () }` uses
        // `dn_expr` zero times while `then` uses it once (via
        // `get_efn_params`), so `pc_emit`'s EIf MIN-merge (#705) permanently
        // carries the `then`-consumed (lower) remaining forward even on the
        // iterations that really take this branch -- the loop-body scope-end
        // drop for `dn_expr` is then skipped based on that borrowed count,
        // leaking `dn_expr` on every thunk entry. Call `is_efn` again here,
        // discarding the result, purely to consume `dn_expr` exactly once --
        // matching `then`'s single consuming use so both branches leave the
        // same remaining count and the plan's assumption holds either way.
        is_efn(dn_expr)
      }
      bytebuf_push(dn_content, 10)
      dnfi = dnfi + 1
    }
    bytebuf_push_section(out, 0, dn_content)
  } else {
    ()
  }
  // Interior-line breakpoints (span-arc step5, multi-file): emit a `vibe.dbgfiles`
  // custom section listing the source-file basenames in file-id order, one per
  // line (terminated by newline 10). `vibe::dbg_line(file_id, line)` passes the
  // file id; the runner indexes this table to recover the basename and match a
  // `--break <file>:<line>` spec. Only present when dbg_line is active, so off =>
  // byte-identical (fixpoint preserved).
  if dbg_line_on {
    let df_content = bytebuf_new()
    let df_name = "vibe.dbgfiles"
    leb128_encode_u32(df_content, String::length(df_name))
    let mut dfni = 0
    while dfni < String::length(df_name) {
      bytebuf_push(df_content, String::char_code_at(df_name, dfni))
      dfni = dfni + 1
    }
    let mut dffi = 0
    while dffi < Array::length(prov.files) {
      let df_base = Array::get(prov.files, dffi)
      let mut df_ci = 0
      while df_ci < String::length(df_base) {
        bytebuf_push(df_content, String::char_code_at(df_base, df_ci))
        df_ci = df_ci + 1
      }
      bytebuf_push(df_content, 10)
      dffi = dffi + 1
    }
    bytebuf_push_section(out, 0, df_content)
  } else {
    ()
  }
  bytebuf_push_section(out, 1, type_content)
  let import_content = bytebuf_new()
  bytebuf_push_vec_header(import_content, num_imported_funcs)
  emit_name(import_content, "wasi_snapshot_preview1")
  emit_name(import_content, "fd_write")
  bytebuf_push(import_content, 0)
  leb128_encode_u32(import_content, 0)
  if env_get_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "env-get")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  }
  if env_args_len_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "args-len")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 5)
  }
  if env_args_get_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "args-get")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  }
  if fs_read_file_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_read_file")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  }
  if fs_exists_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_exists")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  }
  if fs_stat_token_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_stat_token")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  }
  if fs_write_file_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_write_file")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 6)
  }
  if fs_publish_immutable_text_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_publish_immutable_text")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 4)
  }
  if fs_write_bytes_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_write_bytes")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 6)
  }
  // #632: fs_read_bytes — emitted right after fs_write_bytes to match its
  // reserved index. Type 3 is `(i64) -> i64` (same as fs_read_file).
  if fs_read_bytes_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_read_bytes")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  }
  // #729/#730: fs_read_dir — emitted right after fs_read_bytes to match its
  // reserved index. Type 3 is `(i64) -> i64` (same as fs_read_file).
  if fs_read_dir_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_read_dir")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  }
  if profiler_now_us_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "profile-now-us")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 5)
  }
  // `vibe.profile-heap-bytes () -> i64` — emitted right after profile-now-us
  // to match its reserved index. Type 5 is `() -> i64` (same as now-us).
  if profiler_heap_bytes_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "profile-heap-bytes")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 5)
  }
  // `vibe.sleep (i64) -> ()` — reserved index after profiler, matching the
  // allocation order above. Type 1 is `(i64) -> ()`.
  if sleep_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "sleep")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  // `vibe.stdin_read_char () -> i64` — after sleep, matching allocation order.
  // Type 5 is `() -> i64` (same as profile-now-us).
  if stdin_read_char_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "stdin_read_char")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 5)
  } else {
    ()
  }
  // ADR-0089 step 4: `vibe.host_future_get () -> i64` (type 5) and
  // `vibe.host_future_wait (i64) -> i64` (type 3) — after stdin_read_char,
  // matching allocation order. Component-adapter-provided imports (spec
  // §3.13/§3.14); i64 values are guest-tagged on the wire (the adapter
  // shifts), like every generic-path vibe.* Int.
  if hf_get_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "host_future_get")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 5)
  } else {
    ()
  }
  if hf_wait_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "host_future_wait")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // ADR-0089 (c) (#1218): `vibe.host_future_get$<name> () -> i64` (type 5)
  // per named host future -- after the anonymous pair, in the same sorted
  // order the indices were reserved in. The `$<name>` suffix is what the
  // composer reads back to build the component-level import of that name.
  let mut hf_emit_i = 0
  while hf_emit_i < Array::length(hf_named_names) {
    emit_name(import_content, "vibe")
    emit_name(import_content, String::concat("host_future_get$", Array::get(hf_named_names, hf_emit_i)))
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 5)
    hf_emit_i = hf_emit_i + 1
  }
  // ADR-0089 Decision 3 (#1218): `vibe.host_stream_read (i64) -> i64` (type
  // 3), then `vibe.host_stream_get$<name> () -> i64` (type 5) per named
  // host stream -- after the host-future imports, in the same sorted order
  // the indices were reserved in. Component-adapter-provided (spec §3.18);
  // the `$<name>` suffix is what the composer reads back to build the
  // component-level `stream<u8>` import of that name.
  if hs_read_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "host_stream_read")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // ADR-0089 Decision 3 follow-up (#1218): `vibe.host_stream_close
  // (i64) -> i64` (type 3), reserved right after the read half and emitted
  // in that order. Present only when the program actually closes a stream,
  // so draining programs stay byte-identical.
  if hs_close_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "host_stream_close")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #1539: the dedicated stdin provider route uses exact names and tagged
  // i64s. It is intentionally separate from generic HostStream imports.
  if stdin_provider_acquire_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "stdin_provider_acquire")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 5)
  } else {
    ()
  }
  if stdin_provider_read_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "stdin_provider_read")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  if stdin_provider_close_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "stdin_provider_close")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  let mut hs_emit_i = 0
  while hs_emit_i < Array::length(hs_named_names) {
    emit_name(import_content, "vibe")
    emit_name(import_content, String::concat("host_stream_get$", Array::get(hs_named_names, hs_emit_i)))
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 5)
    hs_emit_i = hs_emit_i + 1
  }
  // `vibe.sh (i64) -> i64` and `vibe.sh_lines (i64) -> i64` — reserved after
  // stdin_read_char (before dbg_break), matching allocation order. Type 3 is
  // `(i64) -> i64` (same as fs_read_file / fs_read_dir).
  if sh_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "sh")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  if sh_lines_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "sh_lines")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // `vibe.stdin_read_stream (i64) -> i64` (type 3, like fs_read_file), then the
  // two void `vibe.stdout_write_stream` / `vibe.stdout_write_char (i64) -> ()`
  // (type 1, like sleep) — reserved after sh_lines (before dbg_break), matching
  // allocation order.
  if stdin_read_stream_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "stdin_read_stream")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  if stdout_write_stream_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "stdout_write_stream")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  if stdout_write_char_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "stdout_write_char")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  // `vibe.resolve_path (i64) -> i64` (type 3, like fs_read_file) — reserved after
  // stdout_write_char (before dbg_break), matching allocation order.
  if resolve_path_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "resolve_path")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #768: `vibe.fs_remove (i64) -> ()` (type 1, like sleep) — reserved after
  // resolve_path (before dbg_break), matching allocation order.
  if fs_remove_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_remove")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  // #768: `vibe.fs_mkdir_p (i64) -> ()` (type 1, like fs_remove) — reserved
  // after fs_remove (before dbg_break), matching allocation order.
  if fs_mkdir_p_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_mkdir_p")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  // #768: `vibe.fs_mkdir (i64) -> ()` (type 1, like fs_remove) — reserved
  // after fs_mkdir_p, matching allocation order.
  if fs_mkdir_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_mkdir")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  // #768: `vibe.fs_chdir (i64) -> ()` (type 1, like fs_remove) — reserved
  // after fs_mkdir, matching allocation order.
  if fs_chdir_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_chdir")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  // #768: `vibe.fs_copy (i64, i64) -> ()` (type 6, like fs_write_file).
  if fs_copy_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_copy")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 6)
  } else {
    ()
  }
  // #768: `vibe.fs_append (i64, i64) -> ()` (type 6, like fs_write_file).
  if fs_append_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_append")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 6)
  } else {
    ()
  }
  // #768: `vibe.fs_rename (i64, i64) -> ()` (type 6, like fs_write_file).
  if fs_rename_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_rename")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 6)
  } else {
    ()
  }
  // #768: `vibe.fs_is_dir (i64) -> i64` (type 3, like fs_exists/fs_read_file).
  if fs_is_dir_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_is_dir")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #768: `vibe.fs_is_file (i64) -> i64` (type 3, like fs_exists).
  if fs_is_file_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_is_file")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #768: `vibe.fs_getcwd () -> i64` (type 5, like profile-now-us).
  if fs_getcwd_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "fs_getcwd")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 5)
  } else {
    ()
  }
  // `vibe.tcp_connect (i64,i64) -> i64` (type 4, like http_response_header).
  if tcp_connect_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "tcp_connect")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 4)
  } else {
    ()
  }
  // `vibe.tcp_read (i64,i64) -> i64` (type 4, like http_response_header).
  if tcp_read_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "tcp_read")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 4)
  } else {
    ()
  }
  // `vibe.tcp_write (i64,i64) -> ()` (type 6, like fs_write_file).
  if tcp_write_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "tcp_write")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 6)
  } else {
    ()
  }
  // `vibe.tcp_close (i64) -> ()` (type 1, like fs_remove).
  if tcp_close_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "tcp_close")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  // #794: `vibe.http_request (i64,i64,i64,i64) -> i64` — the dedicated type
  // appended after base/closure/dbg types (http_request_type_idx).
  if http_request_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "http_request")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, http_request_type_idx)
  } else {
    ()
  }
  // #794: `vibe.http_response_status (i64) -> i64` (type 3, like fs_exists).
  if http_response_status_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "http_response_status")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #794: `vibe.http_response_header (i64, i64) -> i64` (type 4).
  if http_response_header_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "http_response_header")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 4)
  } else {
    ()
  }
  // #794: `vibe.http_response_body (i64) -> i64` (type 3, like fs_read_file).
  if http_response_body_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "http_response_body")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #794: `vibe.http_close (i64) -> ()` (type 1, like fs_remove).
  if http_close_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "http_close")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  // #865: `vibe.sh_capture (i64) -> i64` (type 3, like fs_read_file) -- runs
  // the command once and returns a handle.
  if sh_capture_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "sh_capture")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #865: `vibe.sh_capture_exit_code (i64) -> i64` (type 3, like fs_exists).
  if sh_capture_exit_code_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "sh_capture_exit_code")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #865: `vibe.sh_capture_stdout (i64) -> i64` (type 3, like fs_read_file).
  if sh_capture_stdout_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "sh_capture_stdout")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #865: `vibe.sh_capture_stderr (i64) -> i64` (type 3, like fs_read_file).
  if sh_capture_stderr_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "sh_capture_stderr")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 3)
  } else {
    ()
  }
  // #865: `vibe.sh_capture_close (i64) -> ()` (type 1, like fs_remove).
  if sh_capture_close_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "sh_capture_close")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  // #903/#865: `vibe.process_exit (i64) -> ()` (type 1, like fs_remove).
  if process_exit_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "process_exit")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  // #865: `vibe.stderr_write_stream (i64) -> ()` / `vibe.stderr_write_char
  // (i64) -> ()` (type 1, like Stdout's pair).
  if stderr_write_stream_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "stderr_write_stream")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  if stderr_write_char_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "stderr_write_char")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 1)
  } else {
    ()
  }
  if dbg_break_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "dbg_break")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, 2)
  }
  // Interior-line breakpoints (span-arc step5): emit the `vibe::dbg_line` import
  // descriptor here, AFTER dbg_break and BEFORE the linked imports, matching its
  // reserved import index order. Type index is the appended `(i32) -> ()` type.
  if dbg_line_import_idx >= 0 {
    emit_name(import_content, "vibe")
    emit_name(import_content, "dbg_line")
    bytebuf_push(import_content, 0)
    leb128_encode_u32(import_content, dbg_line_type_idx)
  } else {
    ()
  }
  let mut li_emit = 0
  while li_emit < Array::length(linked_imports) {
    let (lmod, lfn, lparams, _) = Array::get(linked_imports, li_emit)
    emit_name(import_content, lmod)
    emit_name(import_content, lfn)
    bytebuf_push(import_content, 0)
    let type_idx = num_base_types + lparams
    leb128_encode_u32(import_content, type_idx)
    li_emit = li_emit + 1
  }
  bytebuf_push_section(out, 2, import_content)
  let func_type_indices = lc_fresh_int_array()
  // #415 B-1: the builtin type indices are declared next to each body push
  // (push_builtin above), in the exact bodies order — splice them here where
  // a hand-maintained bare number list used to mirror that order from ~1,400
  // lines away.
  let mut bti = 0
  while bti < Array::length(builtin_type_idxs) {
    Array::push(func_type_indices, Array::get(builtin_type_idxs, bti))
    bti = bti + 1
  }
  let mut fti = 0
  while fti < num_user_funcs {
    let upc = Array::get(fn_param_counts, fti)
    Array::push(func_type_indices, num_base_types + upc)
    fti = fti + 1
  }
  Array::push(func_type_indices, 2)
  Array::push(func_type_indices, 5)
  let mut lfi = 0
  while lfi < num_lambdas {
    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1
    Array::push(func_type_indices, num_base_types + lam_user_params)
    lfi = lfi + 1
  }
  if Array::length(func_type_indices) != Array::length(bodies) {
    throw("WASI codegen internal error: function section and code section count mismatch")
  }
  emit_function_section(out, func_type_indices)
  let total_table_entries = num_user_funcs + num_lambdas
  if total_table_entries > 0 {
    emit_table_section_funcref(out, total_table_entries)
  }
  emit_memory_section(out, wasi_memory_min_pages_for_heap(heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve + rc_bins_reserve + region_reserve + (if rc_shadow {
    rc_shadow_reserve()
  } else {
    0
  })))
  // #721: emit the tag section only when something can reference a tag --
  // EThrow (`throw 2`), EHandle (try_table over tags 0-3), or a declared
  // effect (per-effect tags at index 4+). Pure-compute modules then carry no
  // exceptions machinery at all, which keeps V8 off its slower exnref module
  // path (~35% wall on call-heavy code; wasmtime is indifferent).
  let uses_exceptions = Array::length(effect_names_list) > 0 || stmts_contain_exceptions(stmts)
  if uses_exceptions {
    let tag_content = bytebuf_new()
    let num_tags = Array::length(effect_names_list) + 4
    bytebuf_push_vec_header(tag_content, num_tags)
    let mut tag_emit_i = 0
    while tag_emit_i < num_tags {
      bytebuf_push(tag_content, 0)
      leb128_encode_u32(tag_content, 1)
      tag_emit_i = tag_emit_i + 1
    }
    bytebuf_push_section(out, 13, tag_content)
  } else {
    ()
  }
  let global_content = bytebuf_new()
  // Base globals (bump ptr, effect state, ..., g_op_index) plus two i64
  // globals per module-level thunk (memo value + init flag) appended last —
  // see the thunk-body memoization above for the index formula.
  let tg_num_thunks = Array::length(thunk_names_list)
  if enable_rc {
    bytebuf_push_vec_header(global_content, 7 + tg_num_thunks * 2)
  } else {
    bytebuf_push_vec_header(global_content, 6 + tg_num_thunks * 2)
  }
  bytebuf_push(global_content, 127)
  bytebuf_push(global_content, 1)
  emit_i32_const(global_content, heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve + rc_bins_reserve + region_reserve)
  emit_end(global_content)
  bytebuf_push(global_content, 126)
  bytebuf_push(global_content, 1)
  emit_i64_const(global_content, 0)
  emit_end(global_content)
  if enable_rc {
    bytebuf_push(global_content, 127)
    bytebuf_push(global_content, 1)
    emit_i32_const(global_content, 0)
    emit_end(global_content)
  }
  bytebuf_push(global_content, 126)
  bytebuf_push(global_content, 1)
  emit_i64_const(global_content, 0)
  emit_end(global_content)
  bytebuf_push(global_content, 126)
  bytebuf_push(global_content, 1)
  emit_i64_const(global_content, 0)
  emit_end(global_content)
  bytebuf_push(global_content, 127)
  bytebuf_push(global_content, 1)
  emit_i32_const(global_content, heap_start)
  emit_end(global_content)
  // #665: g_op_index (i64, mut) — operation index of the perform unwinding to a
  // handler, for multi-operation dispatch. Appended last; index = rc ? 6 : 5.
  bytebuf_push(global_content, 126)
  bytebuf_push(global_content, 1)
  emit_i64_const(global_content, 0)
  emit_end(global_content)
  let mut tg_gi = 0
  while tg_gi < tg_num_thunks * 2 {
    bytebuf_push(global_content, 126)
    bytebuf_push(global_content, 1)
    emit_i64_const(global_content, 0)
    emit_end(global_content)
    tg_gi = tg_gi + 1
  }
  bytebuf_push_section(out, 6, global_content)
  let start_func_idx = func_offset + num_user_funcs
  let run_func_idx = start_func_idx + 1
  let all_export_names = lc_fresh_string_array()
  let all_export_indices = lc_fresh_int_array()
  if !library_mode {
    Array::push(all_export_names, "_start")
    Array::push(all_export_indices, start_func_idx)
  }
  if !library_mode && entry_func_idx >= 0 && !array_contains_str(all_export_names, entry_name) {
    Array::push(all_export_names, entry_name)
    Array::push(all_export_indices, entry_func_idx)
  }
  let mut exi = 0
  while exi < Array::length(export_fn_names) {
    let ename = Array::get(export_fn_names, exi)
    let skip_export = library_mode && ename == entry_name
    if !skip_export && !array_contains_str(all_export_names, ename) {
      Array::push(all_export_names, ename)
      Array::push(all_export_indices, Array::get(export_fn_user_indices, exi) + func_offset)
    }
    exi = exi + 1
  }
  // Per-block test/bench: export each `__test_<name>` / `__bench_<name>` function
  // so a runner can invoke one block at a time (instead of running the whole
  // `_start`, which loops over every block). This is what gives merged builds
  // (#819) per-block failure attribution and a per-block timeout -- once N files
  // share one module, `_start` has no granularity left unless each block is
  // separately addressable. Only `__no_entry__` test/bench builds populate
  // test_fn_names, so normal builds (incl. the compiler self-compile) are
  // byte-identical. The wasm index of a user function at user-index `j` is
  // `j + func_offset`.
  let mut bxi = 0
  while bxi < Array::length(test_fn_names) {
    let bname = Array::get(test_fn_names, bxi)
    let bexportable = String::starts_with(bname, "__bench_") ||
    String::starts_with(bname, "__test_")
    if bexportable && !array_contains_str(all_export_names, bname) {
      let mut bj = 0
      let mut bfound = 0 - 1
      while bj < num_user_funcs {
        if Array::get(fn_names_list, bj) == bname {
          bfound = bj
          bj = num_user_funcs
        } else {
          bj = bj + 1
        }
      }
      if bfound >= 0 {
        Array::push(all_export_names, bname)
        Array::push(all_export_indices, bfound + func_offset)
      }
    }
    bxi = bxi + 1
  }
  let export_content = bytebuf_new()
  // #721: the "error" tag export exists only when the tag section does.
  let export_count = Array::length(all_export_names) + 1 +
  (if library_mode {
    0
  } else {
    1 + (if uses_exceptions {
      1
    } else {
      0
    })
  })
  bytebuf_push_vec_header(export_content, export_count)
  let mut efi = 0
  while efi < Array::length(all_export_names) {
    emit_name(export_content, Array::get(all_export_names, efi))
    bytebuf_push(export_content, 0)
    leb128_encode_u32(export_content, Array::get(all_export_indices, efi))
    efi = efi + 1
  }
  emit_name(export_content, "memory")
  bytebuf_push(export_content, 2)
  leb128_encode_u32(export_content, 0)
  if !library_mode {
    emit_name(export_content, "__heap_ptr")
    bytebuf_push(export_content, 3)
    leb128_encode_u32(export_content, 0)
    if uses_exceptions {
      emit_name(export_content, "error")
      bytebuf_push(export_content, 4)
      leb128_encode_u32(export_content, 0)
    } else {
      ()
    }
  }
  bytebuf_push_section(out, 7, export_content)
  if total_table_entries > 0 {
    // #1107 Phase 4: register ONLY the slots codegen recorded a closure value
    // for (table_slots_used — see CompileCtx). A slot no closure carries can
    // never be call_indirect'ed, so it stays ref.null; slot numbering and the
    // declared table size are untouched. Run-compressed active segments skip
    // the gaps (emit_element_section_active_runs). This also shrinks the DCE
    // root set a downstream optimizer (vibe-opt, wasm-opt) must respect —
    // previously every user function + lambda was elem-rooted.
    let slot_used_flags = lc_fresh_bool_array()
    let mut sfi = 0
    while sfi < total_table_entries {
      Array::push(slot_used_flags, false)
      sfi = sfi + 1
    }
    let mut tsu = 0
    while tsu < Array::length(table_slots_used) {
      let ts = Array::get(table_slots_used, tsu)
      if ts >= 0 && ts < total_table_entries {
        Array::set(slot_used_flags, ts, true)
      } else {
        ()
      }
      tsu = tsu + 1
    }
    let table_slots = lc_fresh_int_array()
    let table_func_indices = lc_fresh_int_array()
    let mut tei = 0
    while tei < total_table_entries {
      if Array::get(slot_used_flags, tei) {
        Array::push(table_slots, tei)
        Array::push(table_func_indices, if tei < num_user_funcs {
          func_offset + tei
        } else {
          run_func_idx + 1 + (tei - num_user_funcs)
        })
      } else {
        ()
      }
      tei = tei + 1
    }
    if Array::length(table_slots) > 0 {
      emit_element_section_active_runs(out, table_slots, table_func_indices)
    } else {
      ()
    }
  }
  // Binary-size: replace the bodies of generated runtime helpers that no
  // reachable body ever calls with a 1-instruction `unreachable` stub. The
  // helper index block [num_imported_funcs, func_offset) is emitted
  // unconditionally (every call site references FIXED indices computed above),
  // so helpers cannot simply be omitted — but an unreferenced body can shrink
  // to `unreachable` without moving any index. Reachability is a worklist
  // byte-scan over final body bytes for `call`(0x10)/`ref.func`(0xd2)
  // immediates that decode into the helper range, seeded from every
  // non-helper body (user fns + entry glue + lambdas; the funcref table only
  // holds user/lambda indices). A stray 0x10 inside some other immediate can
  // only FALSE-POSITIVE (keeps an unused helper) — never drops a used one,
  // since every real call's opcode byte is also visited. Skipped for
  // instrumentation builds so debug tooling sees unmodified bodies.
  if !coverage && !debug_trace && !debug_break && !rc_shadow {
    let builtin_used = lc_fresh_bool_array()
    let mut sbu_i = 0
    while sbu_i < num_generated {
      Array::push(builtin_used, false)
      sbu_i = sbu_i + 1
    }
    let scan_queue = lc_fresh_int_array()
    let mut sbr = num_generated
    while sbr < Array::length(bodies) {
      Array::push(scan_queue, sbr)
      sbr = sbr + 1
    }
    let mut sq_i = 0
    while sq_i < Array::length(scan_queue) {
      let sb_body = Array::get(bodies, Array::get(scan_queue, sq_i))
      sq_i = sq_i + 1
      let sb_len = Bytes::length(sb_body)
      let mut sb_p = 0
      while sb_p < sb_len {
        let sb_op = Bytes::get(sb_body, sb_p)
        if sb_op == 16 || sb_op == 210 {
          let mut sb_q = sb_p + 1
          let mut sb_v = 0
          let mut sb_shift = 0
          let mut sb_more = true
          let mut sb_valid = false
          while sb_more && sb_q < sb_len && sb_shift < 35 {
            let sb_byte = Bytes::get(sb_body, sb_q)
            sb_v = sb_v|((sb_byte&127)<<sb_shift)
            sb_q = sb_q + 1
            if (sb_byte&128) == 0 {
              sb_more = false
              sb_valid = true
            } else {
              sb_shift = sb_shift + 7
            }
          }
          if sb_valid && sb_v >= num_imported_funcs && sb_v < func_offset {
            let sb_pos = sb_v - num_imported_funcs
            if !Array::get(builtin_used, sb_pos) {
              Array::set(builtin_used, sb_pos, true)
              Array::push(scan_queue, sb_pos)
            } else {
              ()
            }
          } else {
            ()
          }
        } else {
          ()
        }
        sb_p = sb_p + 1
      }
    }
    let mut sb_k = 0
    while sb_k < num_generated {
      if !Array::get(builtin_used, sb_k) {
        let sb_stub = bytebuf_new()
        bytebuf_push(sb_stub, 0)
        Array::set(bodies, sb_k, sb_stub)
        Array::set(meta_i32, sb_k, 0)
        Array::set(meta_i64, sb_k, 0)
      } else {
        ()
      }
      sb_k = sb_k + 1
    }
  } else {
    ()
  }
  let code_content = bytebuf_new()
  bytebuf_push_vec_header(code_content, Array::length(bodies))
  // #644: per-user-function locals-declaration header length, in `bodies`
  // ci-order (`bi = ci - num_generated`, the same relationship `func_offset`
  // encodes for the final wasm function index). Captured below as each
  // func_buf's locals header is assembled, BEFORE `body` (the raw
  // instruction stream body_buf compiled with linemap_state) is appended --
  // this is exactly the byte count linked_compile needs to add to a
  // body_buf-relative linemap offset to match wasmtime's
  // `FrameInfo::func_offset()`, which measures from the first byte of the
  // code entry (the locals header), not the first instruction.
  let linemap_hdrlen_by_bi = if linemap_state.enabled {
    lc_fresh_int_array_of_len(num_user_funcs, 0)
  } else {
    lc_fresh_int_array()
  }
  if Array::length(meta_v128) != Array::length(bodies) {
    throw(String::concat("meta_v128/bodies misalignment: ", String::concat(__to_string(Array::length(meta_v128)), String::concat(" vs ", __to_string(Array::length(bodies))))))
  } else {
    ()
  }
  let mut ci = 0
  while ci < Array::length(bodies) {
    // ADR-0090 dogfood (#1770): each function's code buffer is built, copied
    // into code_content, and discarded -- the buffer itself never escapes the
    // iteration. Backing it with the region arena reclaims the buffer AND its
    // doubling regrows wholesale at the region end instead of leaking them on
    // the bump heap (one buffer per emitted function, the hottest
    // build-and-discard site in a self-compile). The bytebuf_* helpers are
    // unchanged: arena vs main-heap regrow is a property of the buffer's own
    // block (gen_bytes_push_body / gen_bytes_append_body), not of the call
    // site, so a MutBytes flows through them as-is. Needs the
    // mutbytes-2026-08-15 seed (#1801/#1808).
    region r {
      let body = Array::get(bodies, ci)
      let func_buf = MutBytes::empty(r)
      let ni32 = Array::get(meta_i32, ci)
      let ni64 = Array::get(meta_i64, ci)
      // #805 SIMD locals: a third v128 (0x7B) run after the i32/i64 runs.
      // Zero for every function except inline-wasm fns declaring v128 locals,
      // so the header bytes are unchanged wherever the feature is unused.
      let nv128 = Array::get(meta_v128, ci)
      let mut ngroups = 0
      if ni32 > 0 {
        ngroups = ngroups + 1
      } else {
        ()
      }
      if ni64 > 0 {
        ngroups = ngroups + 1
      } else {
        ()
      }
      if nv128 > 0 {
        ngroups = ngroups + 1
      } else {
        ()
      }
      leb128_encode_u32(func_buf, ngroups)
      if ni32 > 0 {
        leb128_encode_u32(func_buf, ni32)
        bytebuf_push(func_buf, 127)
      } else {
        ()
      }
      if ni64 > 0 {
        leb128_encode_u32(func_buf, ni64)
        bytebuf_push(func_buf, 126)
      } else {
        ()
      }
      if nv128 > 0 {
        leb128_encode_u32(func_buf, nv128)
        bytebuf_push(func_buf, 123)
      } else {
        ()
      }
      if linemap_state.enabled {
        let lm_bi = ci - num_generated
        if lm_bi >= 0 && lm_bi < num_user_funcs {
          Array::set(linemap_hdrlen_by_bi, lm_bi, bytebuf_length(func_buf))
        } else {
          ()
        }
      } else {
        ()
      }
      bytebuf_push_buf(func_buf, body)
      bytebuf_push(func_buf, 11)
      leb128_encode_u32(code_content, bytebuf_length(func_buf))
      bytebuf_push_buf(code_content, func_buf)
    }
    ci = ci + 1
  }
  bytebuf_push_section(out, 10, code_content)
  // #644: `vibe.linemap` custom section -- one 16-byte little-endian record
  // per recorded probe: `<wasm func index i32> <code offset i32>
  // <file id i32> <line i32>`, back-to-back (record count = content length /
  // 16). Binary rather than text so the runner never needs to parse decimal
  // ASCII for what can be thousands of entries (same rationale as
  // `vibe.dbgargs`'s raw-int encoding above). The offset is shifted by that
  // function's locals-header length (linemap_hdrlen_by_bi) so it lands
  // exactly where wasmtime's FrameInfo::func_offset() measures from. Emitted
  // only when linemap_state is enabled (debug-break builds with interior-
  // line probes); off => no section, byte-identical output.
  if linemap_state.enabled {
    let lm_content = bytebuf_new()
    let lm_name = "vibe.linemap"
    leb128_encode_u32(lm_content, String::length(lm_name))
    let mut lmni = 0
    while lmni < String::length(lm_name) {
      bytebuf_push(lm_content, String::char_code_at(lm_name, lmni))
      lmni = lmni + 1
    }
    let mut lm_k = 0
    while lm_k < Array::length(linemap_state.offsets) {
      let lm_bi = Array::get(linemap_state.funcs, lm_k)
      let lm_func_idx = func_offset + lm_bi
      let lm_off = Array::get(linemap_state.offsets, lm_k) + Array::get(linemap_hdrlen_by_bi, lm_bi)
      let lm_file_id = Array::get(linemap_state.file_ids, lm_k)
      let lm_line = Array::get(linemap_state.lines, lm_k)
      bytebuf_push_i32le(lm_content, lm_func_idx)
      bytebuf_push_i32le(lm_content, lm_off)
      bytebuf_push_i32le(lm_content, lm_file_id)
      bytebuf_push_i32le(lm_content, lm_line)
      lm_k = lm_k + 1
    }
    bytebuf_push_section(out, 0, lm_content)
  } else {
    ()
  }
  if num_strings > 0 {
    let data_offsets = lc_fresh_int_array()
    let data_bufs = lc_fresh_bytes_array()
    let mut di = 0
    while di < num_strings {
      Array::push(data_offsets, Array::get(str_offsets, di))
      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))
      di = di + 1
    }
    emit_data_section_multi(out, data_offsets, data_bufs)
  }
  // Name section (debugger P0 / ADR-0035): name the user functions so wasm
  // backtraces and tooling show `main` etc. instead of `<wasm function N>`.
  // User functions occupy consecutive indices starting at `func_offset`.
  // #768: emit ONLY the first num_user_funcs entries -- fn_names_list also
  // carries the builtin/runtime names appended for call resolution (Env::get,
  // Fs::read_file, ...), but those bodies live at LOW indices (below
  // func_offset). Emitting the whole list consecutively shifted every
  // post-user name: `_start` was labeled `Env::get` in crash stacks, which
  // repeatedly sent debugging to functions the trace never touched. `_start`
  // and `run` sit right after the user block, so name them explicitly.
  // #799: name the GENERATED runtime helpers too. Profilers (node --cpu-prof)
  // attributed the hottest samples to anonymous wasm-function[N] frames
  // because only user functions carried name-section entries; the generated
  // string/array/bytes helpers occupy the consecutive index range
  // [num_imported_funcs, func_offset). Unassigned slots (lambda-arity pads
  // etc.) keep the generic "__rt_gen" label.
  let gen_sec_names = lc_fresh_string_array()
  let mut gsn_i = 0
  while gsn_i < num_generated {
    Array::push(gen_sec_names, "__rt_gen")
    gsn_i = gsn_i + 1
  }
  Array::set(gen_sec_names, print_int_idx - num_imported_funcs, "__rt_print_int")
  Array::set(gen_sec_names, print_str_idx - num_imported_funcs, "__rt_print_str")
  Array::set(gen_sec_names, str_len_idx - num_imported_funcs, "__rt_str_len")
  Array::set(gen_sec_names, str_eq_idx - num_imported_funcs, "__rt_str_eq")
  Array::set(gen_sec_names, str_concat_idx - num_imported_funcs, "__rt_str_concat")
  Array::set(gen_sec_names, arr_new_idx - num_imported_funcs, "__rt_arr_new")
  Array::set(gen_sec_names, arr_len_idx - num_imported_funcs, "__rt_arr_len")
  Array::set(gen_sec_names, arr_get_idx - num_imported_funcs, "__rt_arr_get")
  Array::set(gen_sec_names, arr_push_idx - num_imported_funcs, "__rt_arr_push")
  Array::set(gen_sec_names, arr_set_idx - num_imported_funcs, "__rt_arr_set")
  Array::set(gen_sec_names, double_to_int_idx - num_imported_funcs, "__rt_double_to_int")
  Array::set(gen_sec_names, int_to_double_idx - num_imported_funcs, "__rt_int_to_double")
  Array::set(gen_sec_names, str_char_code_at_idx - num_imported_funcs, "__rt_str_char_code_at")
  Array::set(gen_sec_names, str_from_char_code_idx - num_imported_funcs, "__rt_str_from_char_code")
  Array::set(gen_sec_names, str_substring_idx - num_imported_funcs, "__rt_str_substring")
  Array::set(gen_sec_names, identity_idx - num_imported_funcs, "__rt_identity")
  Array::set(gen_sec_names, arr_slice_idx - num_imported_funcs, "__rt_arr_slice")
  Array::set(gen_sec_names, frozen_array_copy_idx - num_imported_funcs, "__rt_frozen_array_copy")
  Array::set(gen_sec_names, arr_concat_idx - num_imported_funcs, "__rt_arr_concat")
  Array::set(gen_sec_names, arr_truncate_idx - num_imported_funcs, "__rt_arr_truncate")
  Array::set(gen_sec_names, string_join_idx - num_imported_funcs, "__rt_string_join")
  Array::set(gen_sec_names, fs_read_file_stub_idx - num_imported_funcs, "__rt_stub_a")
  Array::set(gen_sec_names, fs_exists_stub_idx - num_imported_funcs, "__rt_stub_b")
  Array::set(gen_sec_names, fs_stat_token_stub_idx - num_imported_funcs, "__rt_stub_c")
  Array::set(gen_sec_names, fs_write_file_stub_idx - num_imported_funcs, "__rt_stub_d")
  Array::set(gen_sec_names, fs_publish_immutable_text_stub_idx - num_imported_funcs, "__rt_stub_e")
  Array::set(gen_sec_names, fs_write_bytes_stub_idx - num_imported_funcs, "__rt_stub_f")
  Array::set(gen_sec_names, eq_idx - num_imported_funcs, "__rt_eq")
  Array::set(gen_sec_names, string_ends_with_idx - num_imported_funcs, "__rt_string_ends_with")
  Array::set(gen_sec_names, string_last_index_of_idx - num_imported_funcs, "__rt_string_last_index_of")
  Array::set(gen_sec_names, arr_push_all_idx - num_imported_funcs, "__rt_arr_push_all")
  Array::set(gen_sec_names, string_index_of_idx - num_imported_funcs, "__rt_string_index_of")
  Array::set(gen_sec_names, string_contains_idx - num_imported_funcs, "__rt_string_contains")
  Array::set(gen_sec_names, string_starts_with_idx - num_imported_funcs, "__rt_string_starts_with")
  Array::set(gen_sec_names, string_split_idx - num_imported_funcs, "__rt_string_split")
  Array::set(gen_sec_names, string_trim_idx - num_imported_funcs, "__rt_string_trim")
  Array::set(gen_sec_names, sources_idx - num_imported_funcs, "__rt_sources")
  Array::set(gen_sec_names, bytes_new_idx - num_imported_funcs, "__rt_bytes_new")
  Array::set(gen_sec_names, bytes_len_idx - num_imported_funcs, "__rt_bytes_len")
  Array::set(gen_sec_names, bytes_get_idx - num_imported_funcs, "__rt_bytes_get")
  Array::set(gen_sec_names, bytes_set_idx - num_imported_funcs, "__rt_bytes_set")
  Array::set(gen_sec_names, bytes_push_idx - num_imported_funcs, "__rt_bytes_push")
  Array::set(gen_sec_names, bytes_append_idx - num_imported_funcs, "__rt_bytes_append")
  Array::set(gen_sec_names, bytes_concat_idx - num_imported_funcs, "__rt_bytes_concat")
  Array::set(gen_sec_names, bytes_slice_idx - num_imported_funcs, "__rt_bytes_slice")
  Array::set(gen_sec_names, bytes_from_array_idx - num_imported_funcs, "__rt_bytes_from_array")
  Array::set(gen_sec_names, bytes_to_array_idx - num_imported_funcs, "__rt_bytes_to_array")
  if enable_rc {
    Array::set(gen_sec_names, rc_drop_idx - num_imported_funcs, "__rt_rc_drop")
    Array::set(gen_sec_names, rc_dup_idx - num_imported_funcs, "__rt_rc_dup")
    Array::set(gen_sec_names, rc_alloc_idx - num_imported_funcs, "__rt_rc_alloc")
  } else {
    ()
  }
  Array::set(gen_sec_names, heap_grow_check_idx - num_imported_funcs, "__rt_heap_grow_check")
  Array::set(gen_sec_names, simd_skip_ws_idx - num_imported_funcs, "__rt_simd_skip_ws")
  Array::set(gen_sec_names, simd_scan_alnum_idx - num_imported_funcs, "__rt_simd_scan_alnum")
  Array::set(gen_sec_names, simd_scan_alnum_str_idx - num_imported_funcs, "__rt_simd_scan_alnum_str")
  Array::set(gen_sec_names, str_lex_diff_idx - num_imported_funcs, "__rt_str_lex_diff")
  Array::set(gen_sec_names, generic_rel_diff_idx - num_imported_funcs, "__rt_generic_rel_diff")
  Array::set(gen_sec_names, generic_add_idx - num_imported_funcs, "__rt_generic_add")
  let name_sec_names = gen_sec_names
  let mut usn_i = 0
  while usn_i < num_user_funcs {
    Array::push(name_sec_names, Array::get(fn_names_list, usn_i))
    usn_i = usn_i + 1
  }
  Array::push(name_sec_names, "_start")
  Array::push(name_sec_names, "run")
  emit_function_name_section(out, name_sec_names, num_imported_funcs)
  bytebuf_to_bytes(out)
}

export fn compile_wasi_module_rc_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with Exception {
  let stmts = elaborate_heap_params(stmts_in)
  compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, true, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)
}

/// #715 recurrence guard: RC + shadow-liveness instrumentation (VIBE_RC=shadow).
export fn compile_wasi_module_rc_shadow_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with Exception {
  let stmts = elaborate_heap_params(stmts_in)
  compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, true, false, false, false, true, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)
}

/// #1259 step 7: compile the module twice -- once compiling every body and
/// harvesting it, once replaying every harvested body -- and return the
/// REPLAYED module, throwing if the two disagree.
///
/// This is the only caller that exercises the replay path, and it exists to
/// keep the two halves honest: a replayed function must be indistinguishable
/// from a compiled one, not merely plausible. It caught the first real
/// divergence -- `table_slots_used` is appended during compilation and read
/// only after the body loop, so a replayed build emitted a smaller element
/// section until the cache started carrying those entries too.
///
/// Deliberately not on any production path: it is strictly slower than
/// compiling once. Callers are the round-trip test and the gate.
/// #1259 step 8: compile the bodies in two disjoint slices, merge the two
/// harvests, replay the merged cache, and return the result -- throwing if it
/// differs from a straight single-pass compile.
///
/// This is the property a `--jobs N` build rests on, reduced to something a
/// single process can check: a body compiled while its neighbours were NOT
/// compiled must be the same bytes as one compiled with all of them. It holds
/// only because everything that used to make a body depend on its neighbours
/// was hoisted ahead of the loop -- the lambda index plan (#1275/#1277), the
/// shared fresh-name counters, and the string table -- so a slice sees exactly
/// the state the whole run would have given it.
///
/// Splitting at the halfway point is arbitrary but not vacuous: it puts the
/// boundary inside the function list, so the second worker starts at a nonzero
/// planned lambda base.
///
/// Test/gate only; it compiles the program three times.
export fn compile_wasi_module_sliced_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception {
  let whole = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)
  let probe = codegen_body_cache_new()
  let _probe_bytes = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), probe, 0, 0 - 1)
  let nfns = Array::length(probe.fn_indices)
  let mid = nfns / 2
  let low = codegen_body_cache_new()
  let high = codegen_body_cache_new()
  let _low_bytes = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), low, 0, mid)
  let _high_bytes = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), high, mid, 0 - 1)
  let merged = codegen_body_cache_merge(low, high)
  let nmerged = Array::length(merged.fn_indices)
  if nmerged != nfns {
    throw(String::concat("codegen slice merge lost functions: whole ", String::concat(__to_string(nfns), String::concat(", merged ", __to_string(nmerged)))))
  } else {
    ()
  }
  let sliced = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, false, false, false, false, false, empty_dbg_prov(), merged, codegen_body_cache_new(), 0, 0 - 1)
  let wn = Bytes::length(whole)
  let sn = Bytes::length(sliced)
  if wn != sn {
    throw(String::concat("codegen slice length mismatch: whole ", String::concat(__to_string(wn), String::concat(" B, sliced ", String::concat(__to_string(sn), " B")))))
  } else {
    ()
  }
  let mut i = 0
  let mut bad = 0 - 1
  while bad < 0 && i < wn {
    if Bytes::get(whole, i) != Bytes::get(sliced, i) {
      bad = i
    } else {
      i = i + 1
    }
  }
  if bad >= 0 {
    throw(String::concat("codegen slice byte mismatch at offset ", __to_string(bad)))
  } else {
    ()
  }
  sliced
}

export fn compile_wasi_module_replayed_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception {
  let harvest = codegen_body_cache_new()
  let compiled = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), harvest, 0, 0 - 1)
  let replayed = compile_wasi_module_linked_impl(stmts, entry_name, array_empty(), array_empty(), false, false, false, false, false, false, empty_dbg_prov(), harvest, codegen_body_cache_new(), 0, 0 - 1)
  let ln = Bytes::length(compiled)
  let rn = Bytes::length(replayed)
  if ln != rn {
    throw(String::concat("codegen replay length mismatch: compiled ", String::concat(__to_string(ln), String::concat(" B, replayed ", String::concat(__to_string(rn), " B")))))
  } else {
    ()
  }
  let mut i = 0
  let mut bad = 0 - 1
  while bad < 0 && i < ln {
    if Bytes::get(compiled, i) != Bytes::get(replayed, i) {
      bad = i
    } else {
      i = i + 1
    }
  }
  if bad >= 0 {
    throw(String::concat("codegen replay byte mismatch at offset ", __to_string(bad)))
  } else {
    ()
  }
  replayed
}

export fn compile_wasi_module_with_sources_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with Exception {
  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, false, false, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)
}

/// Coverage build (#cov): compile with function-level hit instrumentation +
/// `vibe_cov` custom section. Same as compile_wasi_module_with_sources_impl but
/// with coverage enabled.
export fn compile_wasi_module_with_sources_coverage_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with Exception {
  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, true, true, false, false, false, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)
}

/// Trace build (debugger / DAP P1 groundwork): compile with function-call
/// execution-trace instrumentation + `vibe.trace` custom section. Same as
/// compile_wasi_module_with_sources_impl but with debug_trace enabled.
export fn compile_wasi_module_with_sources_trace_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with Exception {
  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, true, false, true, false, false, empty_dbg_prov(), codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)
}

/// Break build (debugger / DAP P1): compile with `vibe::dbg_break` host-hook
/// instrumentation at each user function entry. Same as
/// compile_wasi_module_with_sources_impl but with debug_break enabled.
export fn compile_wasi_module_with_sources_break_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], prov: DbgProv) -> Bytes with Exception {
  compile_wasi_module_linked_impl(stmts, entry_name, srcs, array_empty(), false, true, false, false, true, false, prov, codegen_body_cache_new(), codegen_body_cache_new(), 0, 0 - 1)
}
