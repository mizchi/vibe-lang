import @vibe/compiler/core {
  Stmt
}
import @vibe/core {
  struct MutMap
}
import ./linked_compile_lc_rename_sleep_calls.vibe {
  PreludeEnv
}
import ./linked_compile_linkedhostplan.vibe {
  PreludeTail
}
import ./linked_compile_lc_inject_async_sleep_boundary.vibe {
  oracle_stmt_key
}

/// A frozen module-input boundary after passes 0..3. The executor owns the
/// module AST mutations and must merge every side channel before returning.
/// Interfaces and shared facts remain read-only throughout the batch.
export struct PreludeModuleBatch {
  parts: Array[Array[Stmt]];
  context_pool: Array[Stmt];
  context_indices: Array[Array[Int]];
  entry_fid: Int;
  entry_name: String;
  offsets: Array[Int];
  keys: Array[String];
  env: PreludeEnv;
  synth: Array[String];
  tail: PreludeTail;
  diagnostics: Array[String]
}

let module_executor_scope: Array[Bool] = [false]
let module_batch_executors: Array[(PreludeModuleBatch) -> Unit with Exception] = [
]

export fn enter_module_executor_scope() -> Unit with Exception {
  if Array::get(module_executor_scope, 0) {
    throw("lowering: a module executor is already active")
  } else ()
  Array::set(module_executor_scope, 0, true)
}

export fn leave_module_executor_scope() -> Unit {
  Array::set(module_executor_scope, 0, false)
}

/// Scope one batch executor to a single compile, restoring the sequential
/// path after success or failure. Per-module and batch scopes cannot nest.
export fn prelude_with_module_batch_executor(executor: (PreludeModuleBatch) -> Unit with Exception, action: () -> Bytes with Env + Exception + Fs) -> Bytes with Env + Exception + Fs {
  enter_module_executor_scope()
  Array::push(module_batch_executors, executor)
  handle {
    let result = action()
    Array::truncate(module_batch_executors, 0)
    leave_module_executor_scope()
    result
  } with { Exception::Throw(message) => {
    Array::truncate(module_batch_executors, 0)
    leave_module_executor_scope()
    throw(message)
  } }
}

export fn prelude_module_batch_active() -> Bool {
  Array::length(module_batch_executors) != 0
}

export fn prelude_execute_module_batch(batch: PreludeModuleBatch) -> Unit with Exception {
  Array::get(module_batch_executors, 0)(batch)
}

/// The same exact-closure projection as the sequential module loop. Build it
/// before any owned AST is rewritten so synthesis cannot change visibility.
export fn prelude_batch_context_indices(parts: Array[Array[Stmt]], interfaces: Array[Array[Stmt]], interface_keys: Array[Array[String]], closure: Array[Array[Int]]) -> (Array[Stmt], Array[Array[Int]]) with Exception {
  let count = Array::length(parts)
  if Array::length(closure) != count {
    throw("lowering: import closure does not match the module batch")
  } else ()
  let pool: Array[Stmt] = []
  let starts: Array[Int] = []
  for rows in interfaces {
    Array::push(starts, Array::length(pool))
    for row in rows {
      Array::push(pool, row)
    }
  }
  let contexts: Array[Array[Int]] = []
  let mut i = 0
  while i < count {
    let own_keys: MutMap[String, Bool] = MutMap::new_string()
    for stmt in Array::get(parts, i) {
      MutMap::set(own_keys, oracle_stmt_key(stmt), true)
    }
    let context: Array[Int] = []
    for dependency in Array::get(closure, i) {
      if dependency != i && dependency >= 0 && dependency < count {
        let rows = Array::get(interfaces, dependency)
        let keys = Array::get(interface_keys, dependency)
        let mut j = 0
        while j < Array::length(rows) {
          if !MutMap::has(own_keys, Array::get(keys, j)) {
            Array::push(context, Array::get(starts, dependency) + j)
          } else ()
          j = j + 1
        }
      } else ()
    }
    Array::push(contexts, context)
    i = i + 1
  }
  (pool, contexts)
}

/// Materialize the exact dependency projection for legacy callers.
export fn prelude_batch_contexts(parts: Array[Array[Stmt]], interfaces: Array[Array[Stmt]], interface_keys: Array[Array[String]], closure: Array[Array[Int]]) -> Array[Array[Stmt]] with Exception {
  let (pool, indices) = prelude_batch_context_indices(parts, interfaces, interface_keys, closure)
  let contexts: Array[Array[Stmt]] = []
  for ids in indices {
    let rows: Array[Stmt] = []
    for id in ids {
      Array::push(rows, Array::get(pool, id))
    }
    Array::push(contexts, rows)
  }
  contexts
}
