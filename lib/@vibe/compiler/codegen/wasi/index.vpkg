// @vibe/compiler/codegen/wasi — WASI-lane WASM module compile entry points
// (ADR-0070 Phase 3, #897, compiler-internal batch). Compiled into the
// compiler itself via compiler_sources_manifest.tsv (group `codegen`,
// dual-row: this contract + wasi.vibe).
//
// The old index.vibe was not the whole implementation: it defines 4
// no-sources convenience wrappers directly, then re-exports 7
// linked/RC-lane entry points from the sibling linked_compile.vibe
// (`export ./linked_compile.vibe { ... }`, #726 -- straight to the defining
// file, no chained re-export). Both halves of that surface are declared
// here; no external file imports linked_compile.vibe/linked_helpers.vibe
// directly (verified repo-wide), so this directory has no boundary
// spillover the way entry/source_compile and entry/compiler/fs_compile do.
// No exported types: Stmt (../../core) and DbgProv (../common_base) are
// structural signature text resolved against the implementation import when
// the facade is merged in (normalize/perceus precedent).

fn wasi_memory_min_pages_for_heap(heap_start: Int) -> Int
fn stmts_use_builtin(stmts: Array[Stmt], fn_names: Array[String], target: String) -> Bool
fn collect_used_builtin_names_into(stmts: Array[Stmt], fn_names: Array[String], fn_name_index: Array[String], sink: Array[(String, Bool)]) -> Unit
fn collect_used_builtin_names(stmts: Array[Stmt], fn_names: Array[String]) -> Map[String, Bool]
fn compile_wasi_module_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception
fn compile_wasi_module_coverage_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception
fn compile_wasi_module_trace_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception
fn compile_wasi_module_break_impl(stmts: Array[Stmt], entry_name: String, prov: DbgProv) -> Bytes with Exception
fn compile_wasi_module_with_sources_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with Exception
fn compile_wasi_module_with_sources_coverage_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with Exception
fn compile_wasi_module_with_sources_trace_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)]) -> Bytes with Exception
fn compile_wasi_module_with_sources_break_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], prov: DbgProv) -> Bytes with Exception
fn compile_wasi_module_linked_impl(stmts: Array[Stmt], entry_name: String, srcs: Array[(String, String)], linked_imports: Array[(String, String, Int, Int)], library_mode: Bool, enable_rc: Bool, coverage: Bool, debug_trace: Bool, debug_break: Bool, rc_shadow: Bool, prov: DbgProv, body_cache_in: CodegenBodyCache, body_cache_out: CodegenBodyCache, slice_lo: Int, slice_hi: Int) -> Bytes with Exception
fn compile_wasi_module_replayed_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception
fn compile_wasi_module_sliced_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception
fn compile_wasi_module_rc_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with Exception
fn compile_wasi_module_rc_shadow_impl(stmts_in: Array[Stmt], entry_name: String) -> Bytes with Exception
// #1511(b)/#1536(c): check-time replay of the compile pipeline's effect-
// lowering rejections (ADR-0076 eligibility, suspend CPS shapes) -- same
// passes, same verdicts, no codegen. Mutates `stmts_in` like a compile;
// callers pass a scratch parse.
fn effect_lowering_errors(stmts_in: Array[Stmt], entry_name: String) -> Array[String] with Exception
