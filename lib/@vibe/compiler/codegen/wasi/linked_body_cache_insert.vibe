// lib/@vibe/compiler/codegen/wasi/linked_body_cache_insert.vibe -- replaying
// cached bodies across a build that ADDED functions (#2669).

import @vibe/compiler/core {
  Expr, bsearch_leftmost, expr_children, sorted_names_of
}

import ./linked_compile_lc_rename_sleep_calls.vibe {
  lc_fresh_bool_array, lc_fresh_int_array, lc_fresh_string_array
}

//# Why a fingerprint guard declines an added function
//
// The layout guard pins every program-wide table a body is compiled against,
// and adding a function moves most of them: the function vector gains a name
// and loses a pad, the lambda plan shifts behind the new function, and every
// name-keyed set (return classes, the capture index, the borrow table) gains
// an entry. So adding one helper to the file being edited used to recompile
// every body in the program.
//
// None of that reaches a body that sits BELOW the new function and never
// spells its name. Its own index, its lambdas' indices and every function it
// calls are below the insertion (merge order is topological, so it calls
// nothing later), and a lookup keyed by a name it does not spell cannot
// answer differently. What has to be shown is that nothing ELSE moved: every
// table, restricted to the names the harvest already had, must be exactly the
// harvest's. That is a restriction, so it needs the harvest's names, not
// their fingerprint (`guard_src_names`); the restricted tables are then
// fingerprinted the same way the harvest's were, and compared.

/// The source-region functions this build added to the harvest's, when the
/// difference is ONLY additions. `names` is sorted; `first` is the lowest
/// added index; `old_src_n` is the harvest's source-region length. `ok` is
/// false when the harvest's names are not, in order, a subsequence of this
/// build's -- a removal, a reorder, or an added name that also existed
/// before (which would make "which one was added" a guess).
export struct LcInsertion {
  ok: Bool;
  names: Array[String];
  first: Int;
  old_src_n: Int
}

export fn lc_insertion_none() -> LcInsertion {
  LcInsertion::{
    ok: false,
    names: lc_fresh_string_array(),
    first: 0 - 1,
    old_src_n: 0 - 1
  }
}

/// Is `ins` a usable insertion: well-formed and actually adding something?
export fn lc_insertion_active(ins: LcInsertion) -> Bool {
  ins.ok && Array::length(ins.names) > 0
}

/// Compare the harvest's source region with this build's `[0, new_src_n)`.
export fn lc_insertion_of(old_src: Array[String], new_names: Array[String], new_src_n: Int) -> LcInsertion {
  let old_n = Array::length(old_src)
  if old_n == 0 || new_src_n < old_n || new_src_n > Array::length(new_names) {
    lc_insertion_none()
  } else {
    let added = lc_fresh_string_array()
    let mut first = 0 - 1
    let mut j = 0
    let mut i = 0
    while i < new_src_n {
      let name = Array::get(new_names, i)
      if j < old_n && name == Array::get(old_src, j) {
        j = j + 1
      } else {
        if first < 0 {
          first = i
        } else {
          ()
        }
        Array::push(added, name)
      }
      i = i + 1
    }
    if j != old_n || Array::length(added) != new_src_n - old_n {
      lc_insertion_none()
    } else {
      let old_sorted = sorted_names_of(old_src)
      let added_sorted = sorted_names_of(added)
      let mut clean = true
      let mut k = 0
      while clean && k < Array::length(added_sorted) {
        let name = Array::get(added_sorted, k)
        // An added name the harvest also had, or one added twice: the walk
        // above matched SOME occurrence, and nothing says it was the right one.
        if bsearch_leftmost(old_sorted, name) >= 0 || (k > 0 && Array::get(added_sorted, k - 1) == name) {
          clean = false
        } else {
          ()
        }
        k = k + 1
      }
      if clean {
        LcInsertion::{
          ok: true,
          names: added_sorted,
          first: first,
          old_src_n: old_n
        }
      } else {
        lc_insertion_none()
      }
    }
  }
}

/// Is `expected` exactly `xs[lo..hi)`?
export fn lc_names_range_equal(expected: Array[String], xs: Array[String], lo: Int, hi: Int) -> Bool {
  if lo < 0 || hi > Array::length(xs) || hi - lo != Array::length(expected) {
    false
  } else {
    let mut same = true
    let mut i = lo
    while same && i < hi {
      if Array::get(xs, i) != Array::get(expected, i - lo) {
        same = false
      } else {
        i = i + 1
      }
    }
    same
  }
}

fn lc_is_added(ins: LcInsertion, name: String) -> Bool {
  bsearch_leftmost(ins.names, name) >= 0
}

/// `xs` without the added names, order kept.
export fn lc_without_added(ins: LcInsertion, xs: Array[String]) -> Array[String] {
  let out = lc_fresh_string_array()
  for x in xs {
    if !lc_is_added(ins, x) {
      Array::push(out, x)
    } else {
      ()
    }
  }
  out
}

/// The values aligned with `names`, without the added names' entries.
export fn lc_without_added_ints(ins: LcInsertion, names: Array[String], vals: Array[Int]) -> Array[Int] {
  let out = lc_fresh_int_array()
  let mut i = 0
  while i < Array::length(names) && i < Array::length(vals) {
    if !lc_is_added(ins, Array::get(names, i)) {
      Array::push(out, Array::get(vals, i))
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// The function vector as the harvest would have laid it out: the added
/// functions removed from the source region, and the pads they took put back
/// at the harvest's positions (`#slot_pad_<index>`, no parameters, an env,
/// an index of `func_offset + position`). An index that was not its
/// position's (a bridged builtin) is kept as it is; one that was is
/// renumbered with its new position. The synthesized region and everything
/// past the user functions are copied unchanged. The five vectors stay
/// aligned.
export struct LcRestrictedFns {
  names: Array[String];
  indices: Array[Int];
  params: Array[Int];
  returns: Array[Int];
  envs: Array[Bool]
}

export fn lc_restricted_fn_vectors(ins: LcInsertion, names: Array[String], indices: Array[Int], params: Array[Int], returns: Array[Int], envs: Array[Bool], new_src_n: Int, capacity: Int, func_offset: Int) -> LcRestrictedFns {
  let out = LcRestrictedFns::{
    names: lc_fresh_string_array(),
    indices: lc_fresh_int_array(),
    params: lc_fresh_int_array(),
    returns: lc_fresh_int_array(),
    envs: lc_fresh_bool_array()
  }
  let mut i = 0
  while i < new_src_n {
    let name = Array::get(names, i)
    if !lc_is_added(ins, name) {
      let at = Array::length(out.names)
      let idx = Array::get(indices, i)
      Array::push(out.names, name)
      Array::push(out.indices, if idx == func_offset + i {
        func_offset + at
      } else {
        idx
      })
      Array::push(out.params, Array::get(params, i))
      Array::push(out.returns, Array::get(returns, i))
      Array::push(out.envs, Array::get(envs, i))
    } else {
      ()
    }
    i = i + 1
  }
  // A pad's return entry is whatever this build gives one; take it from a
  // surviving pad, or from the first added function's slot when none is left.
  let pad_return = if new_src_n < capacity {
    Array::get(returns, new_src_n)
  } else {
    Array::get(returns, ins.first)
  }
  let mut p = Array::length(out.names)
  while p < capacity {
    Array::push(out.names, String::concat("#slot_pad_", __to_string(p)))
    Array::push(out.indices, func_offset + p)
    Array::push(out.params, 0)
    Array::push(out.returns, pad_return)
    Array::push(out.envs, true)
    p = p + 1
  }
  let mut r = capacity
  while r < Array::length(names) {
    Array::push(out.names, Array::get(names, r))
    Array::push(out.indices, Array::get(indices, r))
    Array::push(out.params, Array::get(params, r))
    Array::push(out.returns, Array::get(returns, r))
    Array::push(out.envs, Array::get(envs, r))
    r = r + 1
  }
  out
}

/// The lambda plan without the added functions' lambdas: each function's
/// lambda count is kept, the added ones are dropped, the put-back pads hold
/// none, and the bases are summed again from the first one.
export fn lc_restricted_lambda_bases(ins: LcInsertion, names: Array[String], lambda_bases: Array[Int], lambda_count: Int, new_src_n: Int) -> Array[Int] {
  let n = Array::length(lambda_bases)
  let counts = lc_fresh_int_array()
  let mut i = 0
  while i < n {
    let hi = if i + 1 < n {
      Array::get(lambda_bases, i + 1)
    } else {
      lambda_count
    }
    let keep = i >= new_src_n || !lc_is_added(ins, Array::get(names, i))
    if keep {
      Array::push(counts, hi - Array::get(lambda_bases, i))
    } else {
      ()
    }
    if i + 1 == new_src_n {
      let mut z = 0
      while z < Array::length(ins.names) {
        Array::push(counts, 0)
        z = z + 1
      }
    } else {
      ()
    }
    i = i + 1
  }
  let out = lc_fresh_int_array()
  let mut acc = if n > 0 {
    Array::get(lambda_bases, 0)
  } else {
    0
  }
  for c in counts {
    Array::push(out, acc)
    acc = acc + c
  }
  out
}

fn lc_mentions_any(e: Expr, sorted: Array[String]) -> Bool {
  match e {
    EIdent(n, _) => bsearch_leftmost(sorted, n) >= 0,
    _ => {
      let kids = expr_children(e)
      let mut hit = false
      let mut i = 0
      while !hit && i < Array::length(kids) {
        hit = lc_mentions_any(Array::get(kids, i), sorted)
        i = i + 1
      }
      hit
    }
  }
}

/// Per user function, 1 when its cached body may still be replayed under
/// `ins`: it sits below the first added index, and its body never spells an
/// added name -- not as a call, not as a captured local that a new global
/// of the same spelling would stop the capture of.
export fn lc_insertion_replayable(ins: LcInsertion, bodies: Array[Expr], num_user_funcs: Int) -> Array[Int] {
  let out = lc_fresh_int_array()
  let mut bi = 0
  while bi < num_user_funcs {
    Array::push(out, if bi < ins.first && !lc_mentions_any(Array::get(bodies, bi), ins.names) {
      1
    } else {
      0
    })
    bi = bi + 1
  }
  out
}
