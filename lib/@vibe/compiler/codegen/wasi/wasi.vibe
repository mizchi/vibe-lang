import @vibe/compiler/core {
  Stmt
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/codegen/common_base {
  DbgProv
}

// Straight to the defining file (#726): the old ./linked_impl.vibe middleman
// was a chained re-export the FS merge does not resolve transitively -- and it
// never re-exported compile_wasi_module_rc_shadow_impl at all (the flat
// bundle's first-match hid that).
export ./linked_compile.vibe {
  compile_wasi_module_linked_impl,
  compile_wasi_module_linked_impl_with_typed_offsets,
  compile_wasi_module_no_dce_impl,
  compile_wasi_module_no_dce_impl_with_typed_offsets,
  compile_wasi_module_rc_impl,
  compile_wasi_module_rc_impl_with_typed_offsets,
  compile_wasi_module_rc_shadow_impl,
  compile_wasi_module_with_sources_break_impl,
  compile_wasi_module_with_sources_coverage_impl,
  compile_wasi_module_with_sources_impl,
  compile_wasi_module_with_sources_impl_with_typed_offsets,
  compile_wasi_module_with_sources_trace_impl,
  effect_lowering_prelude
}

export fn compile_wasi_module_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception {
  compile_wasi_module_with_sources_impl(stmts, entry_name, array_empty())
}

/// #2158: `compile_wasi_module_impl` plus the checker's Double call-result
/// offsets, for an entry that checked the whole program it is compiling.
export fn compile_wasi_module_impl_with_typed_offsets(stmts: Array[Stmt], entry_name: String, checker_float_call_offsets: Array[Int], checker_int_render_offsets: Array[Int], checker_bool_render_offsets: Array[Int], checker_eq_offsets: Array[Int], checker_eq_type_keys: Array[String]) -> Bytes with Exception {
  compile_wasi_module_with_sources_impl_with_typed_offsets(stmts, entry_name, array_empty(), checker_float_call_offsets, checker_int_render_offsets, checker_bool_render_offsets, checker_eq_offsets, checker_eq_type_keys)
}

export fn compile_wasi_module_coverage_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception {
  compile_wasi_module_with_sources_coverage_impl(stmts, entry_name, array_empty())
}

export fn compile_wasi_module_trace_impl(stmts: Array[Stmt], entry_name: String) -> Bytes with Exception {
  compile_wasi_module_with_sources_trace_impl(stmts, entry_name, array_empty())
}

export fn compile_wasi_module_break_impl(stmts: Array[Stmt], entry_name: String, prov: DbgProv) -> Bytes with Exception {
  compile_wasi_module_with_sources_break_impl(stmts, entry_name, array_empty(), prov)
}
