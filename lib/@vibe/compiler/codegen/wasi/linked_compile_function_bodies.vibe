  // lift site gets a distinct `__m_scrut_N` name (see lift_match_scrutinees).
  let m_scrut_counter = [0]
  // #712: one counter cell shared across every function's uniquify pass, so
  // every renamed shadow gets a distinct `__shadow_N_<name>` (see
  // uniquify_shadowed_bindings).
  let uq_shadow_counter = [0]
