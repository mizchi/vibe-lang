let function_executors: Array[(LinkedFunctionPlan, LinkedBodyInputs, Bool, Bool, Bool, Bool, Bool) -> LinkedBodyPlan with Exception] = [
]

/// Scope one native transport adapter to a single compile. Workers use emit
/// directly; the ordinary compiler never installs an adapter or serializes IR.
/// Reentry is refused and the default is restored after success or Exception.
export fn function_with_executor(executor: (LinkedFunctionPlan, LinkedBodyInputs, Bool, Bool, Bool, Bool, Bool) -> LinkedBodyPlan with Exception, action: () -> Bytes with Env + Exception + Fs) -> Bytes with Env + Exception + Fs {
  if Array::length(function_executors) != 0 {
    throw("function workers: an executor is already active")
  } else ()
  Array::push(function_executors, value = executor)
  handle {
    let result = action()
    Array::truncate(function_executors, length = 0)
    result
  } with { Exception::Throw(message) => {
    Array::truncate(function_executors, length = 0)
    throw(message)
  } }
}

// Compile generated and user bodies into the existing shared tables.
// Keep lane flags explicit so constant-parameter folding can remove disabled code.
export fn lc_build_function_bodies(input: LinkedBodyInputs, coverage: Bool, debug_break: Bool, debug_trace: Bool, enable_rc: Bool, rc_shadow: Bool) -> LinkedBodyPlan with Exception {
  let plan = lc_prepare_function_plan(stmts = input.stmts, fn_stmt_indices = input.fn_stmt_indices, fn_names_list = input.fn_names_list, num_user_funcs = input.num_user_funcs, const_int_names_list = input.const_int_names_list, ctor_names_list = input.ctor_names_list, enable_rc = enable_rc)
  lc_execute_function_plan(plan = plan, input = input, coverage = coverage, debug_break = debug_break, debug_trace = debug_trace, enable_rc = enable_rc, rc_shadow = rc_shadow)
}

/// Execute a previously prepared canonical plan exactly once at the chosen boundary.
/// Preparation does not invoke an executor or compile a throwaway module.
export fn lc_execute_function_plan(plan: LinkedFunctionPlan, input: LinkedBodyInputs, coverage: Bool, debug_break: Bool, debug_trace: Bool, enable_rc: Bool, rc_shadow: Bool) -> LinkedBodyPlan with Exception {
  lc_execute_function_plan_with_cache_policy(plan = plan, input = input, coverage = coverage, debug_break = debug_break, debug_trace = debug_trace, enable_rc = enable_rc, rc_shadow = rc_shadow, body_cache_enabled = true)
}

/// Explicit cache policy stays a direct Bool so executable specialization can
/// remove replay and harvest code without interpreting mutable cache records.
export fn lc_execute_function_plan_with_cache_policy(plan: LinkedFunctionPlan, input: LinkedBodyInputs, coverage: Bool, debug_break: Bool, debug_trace: Bool, enable_rc: Bool, rc_shadow: Bool, body_cache_enabled: Bool) -> LinkedBodyPlan with Exception {
  if Array::length(function_executors) == 0 {
    LinkedFunctionPlan::emit_with_cache_policy(plan, input = input, coverage = coverage, debug_break = debug_break, debug_trace = debug_trace, enable_rc = enable_rc, rc_shadow = rc_shadow, body_cache_enabled = body_cache_enabled)
  } else {
    // Registered executors own their cache/transport protocol. Keep their
    // callback ABI unchanged; the direct Bool specializes the serial emitter.
    Array::get(function_executors, at = 0)(plan, input, coverage, debug_break, debug_trace, enable_rc, rc_shadow)
  }
}

// Reuse one canonical plan across emission slices. Other shared codegen tables
// still belong to the serial caller; this entry does not make them thread-safe.
export fn LinkedFunctionPlan::emit(_ function_plan: LinkedFunctionPlan, input: LinkedBodyInputs, coverage: Bool, debug_break: Bool, debug_trace: Bool, enable_rc: Bool, rc_shadow: Bool) -> LinkedBodyPlan with Exception {
  LinkedFunctionPlan::emit_with_cache_policy(function_plan, input = input, coverage = coverage, debug_break = debug_break, debug_trace = debug_trace, enable_rc = enable_rc, rc_shadow = rc_shadow, body_cache_enabled = true)
}

/// Explicit cache policy stays a direct Bool so executable specialization can
/// remove replay and harvest code without interpreting mutable cache records.
export fn LinkedFunctionPlan::emit_with_cache_policy(_ function_plan: LinkedFunctionPlan, input: LinkedBodyInputs, coverage: Bool, debug_break: Bool, debug_trace: Bool, enable_rc: Bool, rc_shadow: Bool, body_cache_enabled: Bool) -> LinkedBodyPlan with Exception {
  if function_plan.enable_rc != enable_rc || Array::length(function_plan.bodies) != input.num_user_funcs || Array::length(function_plan.source_types) != input.num_user_funcs || Array::length(function_plan.lambda_bases) != input.num_user_funcs {
    throw("function plan: RC mode or function count does not match body inputs")
  } else {
    ()
  }
  let all_fn_indices_list = input.all_fn_indices_list
  let all_fn_names_list = input.all_fn_names_list
  let all_fn_names_sorted = input.all_fn_names_sorted
  let all_fn_names_sorted_pos = input.all_fn_names_sorted_pos
  let all_fn_needs_env_list = input.all_fn_needs_env_list
  let all_fn_param_counts = input.all_fn_param_counts
  let all_fn_returns_list = input.all_fn_returns_list
  let arr_get_idx = input.arr_get_idx
  let arr_len_idx = input.arr_len_idx
  let arr_new_idx = input.arr_new_idx
  let arr_push_idx = input.arr_push_idx
  let arr_slice_idx = input.arr_slice_idx
  let blind_kinds = input.blind_kinds
  let blind_offsets = input.blind_offsets
  let blind_owners = input.blind_owners
  let blind_syms = input.blind_syms
  let body_cache_in = input.body_cache_in
  let body_cache_edit = input.body_cache_edit
  let body_cache_strict = input.body_cache_strict
  let body_cache_in_ok = input.body_cache_in_ok
  let body_cache_out = input.body_cache_out
  let bool_render_offsets = input.bool_render_offsets
  let bytes_append_idx = input.bytes_append_idx
  let bytes_get_idx = input.bytes_get_idx
  let bytes_len_idx = input.bytes_len_idx
  let bytes_new_idx = input.bytes_new_idx
  let bytes_push_idx = input.bytes_push_idx
  let const_int_names_list = input.const_int_names_list
  let const_int_values_list = input.const_int_values_list
  let cov_base = input.cov_base
  let cov_state = input.cov_state
  let ctor_field_counts_list = input.ctor_field_counts_list
  let ctor_float_fields_list = input.ctor_float_fields_list
  let ctor_names_list = input.ctor_names_list
  let ctor_tags_list = input.ctor_tags_list
  let ctor_type_names_list = input.ctor_type_names_list
  let dbg_break_import_idx = input.dbg_break_import_idx
  let dbg_line_import_idx = input.dbg_line_import_idx
  let dbg_line_on = input.dbg_line_on
  let dbg_name_file = input.dbg_name_file
  let dbg_owner_file = input.dbg_owner_file
  let dbgargs_base = input.dbgargs_base
  let dbgargs_cap = input.dbgargs_cap
  let dbgargs_count_addr = input.dbgargs_count_addr
  let div_zero_abort_idx = input.div_zero_abort_idx
  let effect_names_list = input.effect_names_list
  let effect_op_arities_list = input.effect_op_arities_list
  let effect_op_keys_list = input.effect_op_keys_list
  let entry_name = input.entry_name
  let eq_idx = input.eq_idx
  let fi = input.fi
  let float_call_offsets = input.float_call_offsets
  let float_ret_fn_names = input.float_ret_fn_names
  let fn_names_list = input.fn_names_list
  let func_offset = input.func_offset
  let heap_grow_check_idx = input.heap_grow_check_idx
  let int_render_offsets = input.int_render_offsets
  let iw_callees = input.iw_callees
  let iw_names = input.iw_names
  let iw_wats = input.iw_wats
  let lambda_slot_base = input.lambda_slot_base
  let lc_agg_ret_infos = input.lc_agg_ret_infos
  let lc_agg_ret_names = input.lc_agg_ret_names
  let lc_agg_ret_names_sorted = input.lc_agg_ret_names_sorted
  let lc_agg_ret_names_sorted_pos = input.lc_agg_ret_names_sorted_pos
  let lc_borrow_param_mask = input.lc_borrow_param_mask
  let lc_borrow_param_user_srt = input.lc_borrow_param_user_srt
  let lc_borrow_ret_names = input.lc_borrow_ret_names
  let lc_borrow_view_ret = input.lc_borrow_view_ret
  let lc_ctor_names_sorted = input.lc_ctor_names_sorted
  let lc_ctor_names_sorted_pos = input.lc_ctor_names_sorted_pos
  let lc_fn_file_of = input.lc_fn_file_of
  let lc_fn_stmt_of = input.lc_fn_stmt_of
  let lc_heap_ret_names = input.lc_heap_ret_names
  let lc_name_unique = input.lc_name_unique
  let lc_owned_return_names = input.lc_owned_return_names
  let lc_passthrough_ret_params = input.lc_passthrough_ret_params
  let lc_perceus_pin = input.lc_perceus_pin
  let lc_scalar_ret_names = input.lc_scalar_ret_names
  let lc_struct_names_sorted = input.lc_struct_names_sorted
  let lc_struct_names_sorted_pos = input.lc_struct_names_sorted_pos
  let lc_type_names_sorted = input.lc_type_names_sorted
  let library_mode = input.library_mode
  let linemap_off = lc_function_linemap_new(false)
  let linemap_on = input.linemap_on
  let linemap_state = input.linemap_state
  // One scratch per emitter/worker, reused only after canonical publication.
  // The module's line-map accumulator is never passed to compile_expr.
  let function_linemap = lc_function_linemap_new(linemap_on)
  let function_cov_off = cov_disabled()
  let lt_w = input.lt_w
  let map_build_index_idx = input.map_build_index_idx
  let map_cap_idx = input.map_cap_idx
  let map_hash_idx = input.map_hash_idx
  let map_index_insert_idx = input.map_index_insert_idx
  let map_probe_index_idx = input.map_probe_index_idx
  let need_array_capacity = input.need_array_capacity
  let need_bytes_capacity = input.need_bytes_capacity
  let need_div_zero_abort = input.need_div_zero_abort
  let need_region_arena = input.need_region_arena
  let num_src_pairs = input.num_src_pairs
  let num_user_funcs = input.num_user_funcs
  let oob_abort_idx = input.oob_abort_idx
  let pi = input.pi
  let pin_region_capacity = input.pin_region_capacity
  let print_i64_raw_idx = input.print_i64_raw_idx
  let print_str_idx = input.print_str_idx
  let prov = input.prov
  let rc_alloc_idx = input.rc_alloc_idx
  let rc_bins_base = input.rc_bins_base
  let rc_drop_idx = input.rc_drop_idx
  let rc_dup_idx = input.rc_dup_idx
  let region_arr_new_idx = input.region_arr_new_idx
  let region_bytes_new_idx = input.region_bytes_new_idx
  let region_data_base = input.region_data_base
  let region_limit = input.region_limit
  let region_ptr_addr = input.region_ptr_addr
  let shadow_uaf_abort_idx = input.shadow_uaf_abort_idx
  let slice_hi = input.slice_hi
  let slice_lo = input.slice_lo
  let src_str_base = input.src_str_base
  let has_exceptions = input.has_exceptions
  let str_char_code_at_idx = input.str_char_code_at_idx
  let str_concat_idx = input.str_concat_idx
  let str_eq_idx = input.str_eq_idx
  let str_len_idx = input.str_len_idx
  let str_lengths = input.str_lengths
  let str_lex_diff_idx = input.str_lex_diff_idx
  let str_offsets = input.str_offsets
  let str_operand_abort_idx = input.str_operand_abort_idx
  let str_strs = input.str_strs
  let str_substring_idx = input.str_substring_idx
  let str_table_shared = input.str_table_shared
  let string_index_of_idx = input.string_index_of_idx
  let struct_field_names = input.struct_field_names
  let struct_names = input.struct_names
  let table_slots_used = input.table_slots_used
  let thunk_names_list = input.thunk_names_list
  let trace_cap = input.trace_cap
  let trace_counter_addr = input.trace_counter_addr
  let trace_log_base = input.trace_log_base
  let user_shadows_trunc_builtins = input.user_shadows_trunc_builtins
  let builtins = lc_build_builtin_bodies(input = input, enable_rc = enable_rc, rc_shadow = rc_shadow)
  let bodies = builtins.bodies
  let meta_i32 = builtins.meta_i32
  let meta_i64 = builtins.meta_i64
  let meta_v128 = builtins.meta_v128
  let builtin_type_idxs = builtins.builtin_type_idxs
  // Scratch cell lc_compile_iw_body fills per function (see its doc comment
  // for why this is a cell and not a return value).
  let iw_extra_cell = lc_fresh_int_array()
  Array::push(iw_extra_cell, value = 0)
  Array::push(iw_extra_cell, value = 0)
  Array::push(iw_extra_cell, value = 0)
  // Canonical ranges were planned before emission. Each function starts a
  // private table and cursor at its range base, including when emitted alone.
  let planned_bodies = function_plan.bodies
  let lambda_bases = function_plan.lambda_bases
  let lambda_base_acc = function_plan.lambda_count
  let emission_layout = lc_build_emission_layout(input = input, lambda_bases = lambda_bases, lambda_count = lambda_base_acc, coverage = coverage, enable_rc = enable_rc, rc_shadow = rc_shadow)
  let capture_name_index_shared = emission_layout.capture_names
  let thunk_names_sorted_shared = emission_layout.thunk_names
  let guard_layout_now = emission_layout.guard_layout
  if body_cache_enabled && pin_region_capacity >= 0 {
    // #2669: the halves a later source edit is compared on.
    for v in emission_layout.guard_layout_global {
      Array::push(body_cache_out.guard_layout_global, value = v)
    }
    for v in emission_layout.src_rows {
      Array::push(body_cache_out.guard_src_rows, value = v)
    }
    for v in emission_layout.src_lambdas {
      Array::push(body_cache_out.guard_src_lambdas, value = v)
    }
    for v in emission_layout.type_names {
      Array::push(body_cache_out.guard_type_names, value = v)
    }
    for v in emission_layout.type_rows {
      Array::push(body_cache_out.guard_type_rows, value = v)
    }
    for v in emission_layout.effect_names {
      Array::push(body_cache_out.guard_effect_names, value = v)
    }
    for v in emission_layout.effect_rows {
      Array::push(body_cache_out.guard_effect_rows, value = v)
    }
    for v in emission_layout.struct_names {
      Array::push(body_cache_out.guard_struct_names, value = v)
    }
    for v in emission_layout.struct_fields {
      Array::push(body_cache_out.guard_struct_fields, value = v)
    }
    for v in thunk_names_list {
      Array::push(body_cache_out.guard_thunk_names, value = v)
    }
    for v in input.ctor_names_list {
      Array::push(body_cache_out.guard_ctor_names, value = v)
    }
    for v in input.ctor_tags_list {
      Array::push(body_cache_out.guard_ctor_tags, value = v)
    }
    let mut __glc2 = 0
    while __glc2 < Array::length(guard_layout_now) {
      Array::push(body_cache_out.guard_layout, value = Array::get(guard_layout_now, at = __glc2))
      __glc2 = __glc2 + 1
    }
    // #2669: the pool the string references in this harvest name, by slot.
    // Not part of `guard_layout`: a replaying compile relocates them through
    // it instead of declining (linked_body_cache_strings.vibe).
    let mut __gsp = 0
    while __gsp < src_str_base {
      Array::push(body_cache_out.guard_str_pool, value = Array::get(str_strs, at = __gsp))
      __gsp = __gsp + 1
    }
  } else {
    ()
  }
  // #2669 step 2b: may this compile replay bodies from unchanged files that
  // sit AFTER the edit, or only from the unchanged leading prefix?
  //
  // `decode_body_cache_payload_for` has already kept the wider set; this is
  // the other half of the contract, and the two are deliberately separate
