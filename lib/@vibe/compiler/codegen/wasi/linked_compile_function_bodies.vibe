  // a value form, user functions were the only such name that could collide --
  // nothing else in `compile_expr.vibe`'s ladder can be spelled `A::b`. A bare
  // name (`eq`, `not`) can be a module-level int constant or a constructor,
  // and both compile today: measured on ae838ff, `let eq = 5` reads 5 through
  // `const_int_names` and `enum E { eq }` constructs through the ctor table.
  // The arm now sits below both, so the plan has to see both or it counts a
  // slot the walk never allocates.
  //
  // Module-level GLOBALS need no row here: on this lane a top-level `let` that
  // is not an int literal becomes a thunk in `fn_names_list`, so it is already
  // a user function. (The gc lane keeps them in `gc_global_names`, and that
  // lane has no lambda plan to agree with.)
  let shadow_names_only: Array[String] = []
  let mut ufn_i = 0
  while ufn_i < num_user_funcs {
    Array::push(shadow_names_only, Array::get(fn_names_list, ufn_i))
    ufn_i = ufn_i + 1
  }
  let mut shadow_ci = 0
  while shadow_ci < Array::length(const_int_names_list) {
    Array::push(shadow_names_only, Array::get(const_int_names_list, shadow_ci))
    shadow_ci = shadow_ci + 1
  }
  let mut shadow_ki = 0
  while shadow_ki < Array::length(ctor_names_list) {
    Array::push(shadow_names_only, Array::get(ctor_names_list, shadow_ki))
    shadow_ki = shadow_ki + 1
  }
  let user_fn_names_sorted = sorted_names_of(shadow_names_only)
  let planned_bodies: Array[Expr] = []
  let lambda_bases = lc_fresh_int_array()
  let mut lambda_base_acc = 0
  let mut pbi = 0
  while pbi < num_user_funcs {
    let pb_stmt = Array::get(stmts, Array::get(fn_stmt_indices, pbi))
    // Shadow uniquify runs in BOTH lanes now. It was RC-only (#712,
    // name-keyed RC bookkeeping), but the bump lane needs it for a harder
    // reason: its codegen never restores `local_names` when an inner binding
    // scope closes mid-function (a match catch-all arm's binders, a
    // block-valued `let`'s inner lets), so a later same-name reference
    // resolved to the DEAD inner slot and read its value — silently wrong,
