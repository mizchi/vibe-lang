  push_builtin(gen_arr_truncate_body(enable_rc), 0, 0, 6)
  push_builtin(gen_string_join_body(enable_rc, arr_len_idx, arr_get_idx, str_concat_idx), 9, 1, 4)
  push_builtin(static_fs_stub_body(), 0, 0, 3)
  push_builtin(static_fs_stub_body(), 0, 0, 3)
  push_builtin(static_fs_stub_body(), 0, 0, 3)
