// Compile generated and user bodies into the existing shared tables.
// Keep lane flags explicit so constant-parameter folding can remove disabled code.
export fn lc_build_function_bodies(input: LinkedBodyInputs, coverage: Bool, debug_break: Bool, debug_trace: Bool, enable_rc: Bool, rc_shadow: Bool) -> LinkedBodyPlan with Exception {
  let all_fn_indices_list = input.all_fn_indices_list
  let all_fn_names_list = input.all_fn_names_list
  let all_fn_names_sorted = input.all_fn_names_sorted
  let all_fn_names_sorted_pos = input.all_fn_names_sorted_pos
  let all_fn_needs_env_list = input.all_fn_needs_env_list
  let all_fn_param_counts = input.all_fn_param_counts
  let all_fn_returns_list = input.all_fn_returns_list
  let arr_get_idx = input.arr_get_idx
  let arr_len_idx = input.arr_len_idx
  let arr_new_idx = input.arr_new_idx
  let arr_push_idx = input.arr_push_idx
  let arr_slice_idx = input.arr_slice_idx
  let blind_kinds = input.blind_kinds
  let blind_offsets = input.blind_offsets
  let blind_owners = input.blind_owners
  let blind_syms = input.blind_syms
  let body_cache_in = input.body_cache_in
  let body_cache_in_ok = input.body_cache_in_ok
  let body_cache_out = input.body_cache_out
  let bool_render_offsets = input.bool_render_offsets
  let bytes_append_idx = input.bytes_append_idx
  let bytes_get_idx = input.bytes_get_idx
  let bytes_len_idx = input.bytes_len_idx
  let bytes_new_idx = input.bytes_new_idx
  let bytes_push_idx = input.bytes_push_idx
  let const_int_names_list = input.const_int_names_list
  let const_int_values_list = input.const_int_values_list
  let cov_base = input.cov_base
  let cov_state = input.cov_state
  let ctor_field_counts_list = input.ctor_field_counts_list
  let ctor_float_fields_list = input.ctor_float_fields_list
  let ctor_names_list = input.ctor_names_list
  let ctor_tags_list = input.ctor_tags_list
  let ctor_type_names_list = input.ctor_type_names_list
  let dbg_break_import_idx = input.dbg_break_import_idx
  let dbg_line_import_idx = input.dbg_line_import_idx
  let dbg_line_on = input.dbg_line_on
  let dbg_name_file = input.dbg_name_file
  let dbg_owner_file = input.dbg_owner_file
  let dbgargs_base = input.dbgargs_base
  let dbgargs_cap = input.dbgargs_cap
  let dbgargs_count_addr = input.dbgargs_count_addr
  let div_zero_abort_idx = input.div_zero_abort_idx
  let effect_names_list = input.effect_names_list
  let effect_op_arities_list = input.effect_op_arities_list
  let effect_op_keys_list = input.effect_op_keys_list
  let entry_name = input.entry_name
  let eq_idx = input.eq_idx
  let fi = input.fi
  let float_call_offsets = input.float_call_offsets
  let float_ret_fn_names = input.float_ret_fn_names
  let fn_names_list = input.fn_names_list
  let fn_stmt_indices = input.fn_stmt_indices
  let func_offset = input.func_offset
  let heap_grow_check_idx = input.heap_grow_check_idx
  let int_render_offsets = input.int_render_offsets
  let iw_callees = input.iw_callees
  let iw_names = input.iw_names
  let iw_wats = input.iw_wats
  let lambda_slot_base = input.lambda_slot_base
  let late_dce_rewrote_bodies = input.late_dce_rewrote_bodies
  let lc_agg_ret_infos = input.lc_agg_ret_infos
