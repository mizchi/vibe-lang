  //
  // count_lambda_sites_expr predicts how many table entries a function's body
  // will allocate WITHOUT compiling the functions before it -- which is the
  // whole point, since compile_lambda currently takes that index from the live
  // length of a shared growing table and emits it into the body. The running
  // total below is that prediction's prefix sum: function bi's range starts
  // where bi-1's ended.
  //
  // Seeded into the ctx and checked at every allocation (compile_lambda), not
  // used: while plan and walk agree, swapping compile_lambda over to the
  // planned value cannot change a byte. This is the evidence for that swap.
  let lambda_plan_cell = lc_fresh_int_array()
  Array::push(lambda_plan_cell, 0)
