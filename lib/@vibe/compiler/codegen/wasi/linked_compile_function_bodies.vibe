  push_builtin(static_int_to_double_body(), 0, 0, 3)
  push_builtin(gen_str_char_code_at_body(enable_rc, oob_ccat_fat, oob_abort_idx), 1, 0, 4)
  push_builtin(gen_str_from_char_code_body(enable_rc), 1, 0, 3)
  // #982: substring's clamp prologue needs one i64 scratch (len) — meta 2/1.
