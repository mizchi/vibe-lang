  let num_src_pairs = input.num_src_pairs
  let num_user_funcs = input.num_user_funcs
  let oob_abort_idx = input.oob_abort_idx
  let pi = input.pi
  let pin_region_capacity = input.pin_region_capacity
  let print_i64_raw_idx = input.print_i64_raw_idx
  let print_str_idx = input.print_str_idx
  let prov = input.prov
  let rc_alloc_idx = input.rc_alloc_idx
  let rc_bins_base = input.rc_bins_base
  let rc_drop_idx = input.rc_drop_idx
  let rc_dup_idx = input.rc_dup_idx
  let region_arr_new_idx = input.region_arr_new_idx
  let region_bytes_new_idx = input.region_bytes_new_idx
  let region_data_base = input.region_data_base
  let region_limit = input.region_limit
  let region_ptr_addr = input.region_ptr_addr
  let shadow_uaf_abort_idx = input.shadow_uaf_abort_idx
  let slice_hi = input.slice_hi
  let slice_lo = input.slice_lo
  let src_str_base = input.src_str_base
  let stmts = input.stmts
  let str_char_code_at_idx = input.str_char_code_at_idx
  let str_concat_idx = input.str_concat_idx
  let str_eq_idx = input.str_eq_idx
  let str_len_idx = input.str_len_idx
  let str_lengths = input.str_lengths
  let str_lex_diff_idx = input.str_lex_diff_idx
  let str_offsets = input.str_offsets
  let str_operand_abort_idx = input.str_operand_abort_idx
  let str_strs = input.str_strs
  let str_substring_idx = input.str_substring_idx
  let str_table_shared = input.str_table_shared
  let string_index_of_idx = input.string_index_of_idx
  let struct_field_names = input.struct_field_names
  let struct_names = input.struct_names
  let table_slots_used = input.table_slots_used
  let thunk_names_list = input.thunk_names_list
  let trace_cap = input.trace_cap
  let trace_counter_addr = input.trace_counter_addr
  let trace_log_base = input.trace_log_base
  let user_shadows_trunc_builtins = input.user_shadows_trunc_builtins
  let bodies = lc_fresh_bytes_array()
