  push_builtin(gen_oob_abort_body(print_str_idx, print_i64_raw_idx, oob_mid_fat, oob_nl_fat), 0, 0, 7)
  // #2344: same order as int_popcount_idx / int_ctz_idx / int_clz_idx above.
