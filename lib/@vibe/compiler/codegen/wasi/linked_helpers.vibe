//# Imports

import .. / .. / builtin_name.vibe {
  canonical_builtin_name
}

import .. / .. / core {
  Expr, Stmt
}

import .. / common_analysis {
  collect_free_vars, collect_free_vars_indexed
}

import .. / common_extractors {
  array_contains_str
}

//# Functions

let expr_uses_builtin: (Expr, Array[String], String) -> Bool = (expr, fn_names, target) -> {
  let free_vars = collect_free_vars(expr, Array::slice([
    ""
  ], 0, 0), fn_names)
  let normalized_target = canonical_builtin_name(target)
  let mut i = 0
  let mut found = false
  while i < Array::length(free_vars) && !found {
    found = canonical_builtin_name(Array::get(free_vars, i)) == normalized_target
    i = i + 1
  }
  found
}

export let rec stmts_use_builtin: (Array[Stmt], Array[String], String) -> Bool = (stmts, fn_names, target) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) && !found {
    found = match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => expr_uses_builtin(expr, fn_names, target),
      SLetMut(_, _, expr) => expr_uses_builtin(expr, fn_names, target),
      STest(_, expr) => expr_uses_builtin(expr, fn_names, target),
      SBench(_, expr) => expr_uses_builtin(expr, fn_names, target),
      SExpr(expr) => expr_uses_builtin(expr, fn_names, target),
      SModule(_, _, inner) => stmts_use_builtin(inner, fn_names, target),
      _ => false
    }
    i = i + 1
  }
  found
}

// #798 perf: ONE walk over the whole program collecting every free name's
// canonical builtin form into a set. linked_compile's ~40 need_<builtin>
// flags used to each call stmts_use_builtin -- a full-AST walk per flag,
// with a linear fn_names scan per ident inside -- which was a top entry in
// compiler-closure compile profiles. Same semantics: a name counts as "used"
// only where it is FREE (not a user fn, not locally bound), and the flag
// reads compare canonical names exactly like expr_uses_builtin did.
let push_free_canonical: (Expr, Map[String, Bool], Array[(String, Bool)]) -> Unit = (expr, fn_name_index, sink) -> {
  let fvs = collect_free_vars_indexed(expr, Array::slice([
    ""
  ], 0, 0), fn_name_index)
  let mut j = 0
  while j < Array::length(fvs) {
    Array::push(sink, (canonical_builtin_name(Array::get(fvs, j)), true))
    j = j + 1
  }
}

export let rec collect_used_builtin_names_into: (Array[Stmt], Array[String], Map[String, Bool], Array[(String, Bool)]) -> Unit = (stmts, fn_names, fn_name_index, sink) -> {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => push_free_canonical(expr, fn_name_index, sink),
      SLetMut(_, _, expr) => push_free_canonical(expr, fn_name_index, sink),
      STest(_, expr) => push_free_canonical(expr, fn_name_index, sink),
      SBench(_, expr) => push_free_canonical(expr, fn_name_index, sink),
      SExpr(expr) => push_free_canonical(expr, fn_name_index, sink),
      SModule(_, _, inner) => collect_used_builtin_names_into(inner, fn_names, fn_name_index, sink),
      _ => ()
    }
    i = i + 1
  }
}


export let collect_used_builtin_names: (Array[Stmt], Array[String]) -> Map[String, Bool] = (stmts, fn_names) -> {
  let idx_b = MapBuilder::new()
  let mut i = 0
  while i < Array::length(fn_names) {
    MapBuilder::set(idx_b, Array::get(fn_names, i), true)
    i = i + 1
  }
  let fn_name_index = MapBuilder::freeze(idx_b)
  let sink = Array::slice([
    ("", false)
  ], 0, 0)
  collect_used_builtin_names_into(stmts, fn_names, fn_name_index, sink)
  let set_b = MapBuilder::new()
  let mut k = 0
  while k < Array::length(sink) {
    let (nm, _) = Array::get(sink, k)
    MapBuilder::set(set_b, nm, true)
    k = k + 1
  }
  MapBuilder::freeze(set_b)
}
