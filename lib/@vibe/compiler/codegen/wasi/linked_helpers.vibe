//# Imports

import @vibe/compiler/core {
  canonical_builtin_name
}

import @vibe/core {
  array_empty, struct MutSet
}

import @vibe/compiler/core {
  Expr, Stmt, expr_any_node, sorted_names_of
}

import @vibe/compiler/codegen/common_analysis {
  collect_free_vars, collect_free_vars_used_builtins
}

import @vibe/compiler/codegen/common_extractors {
  array_contains_str
}

//# Functions

fn expr_uses_builtin(expr: Expr, fn_names: Array[String], target: String) -> Bool {
  let free_vars = collect_free_vars(expr, array_empty(), fn_names)
  let normalized_target = canonical_builtin_name(target)
  let mut i = 0
  let mut found = false
  while i < Array::length(free_vars) && !found {
    found = canonical_builtin_name(Array::get(free_vars, i)) == normalized_target
    i = i + 1
  }
  found
}

export fn stmts_use_builtin(stmts: Array[Stmt], fn_names: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) && !found {
    found = match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => expr_uses_builtin(expr, fn_names, target),
      SLetMut(_, _, expr) => expr_uses_builtin(expr, fn_names, target),
      STest(_, expr) => expr_uses_builtin(expr, fn_names, target),
      SBench(_, expr) => expr_uses_builtin(expr, fn_names, target),
      SExpr(expr) => expr_uses_builtin(expr, fn_names, target),
      SModule(_, _, inner) => stmts_use_builtin(inner, fn_names, target),
      _ => false
    }
    i = i + 1
  }
  found
}

/// #799 perf: ONE walk over the whole program collecting every free name's
/// canonical builtin form into a set. linked_compile's ~40 need_<builtin>
/// flags used to each call stmts_use_builtin -- a full-AST walk per flag,
/// with a linear fn_names scan per ident inside -- which was a top entry in
/// compiler-closure compile profiles. Same semantics: a name counts as "used"
/// only where it is FREE (not a user fn, not locally bound), and the flag
/// reads compare canonical names exactly like expr_uses_builtin did.
fn push_free_canonical(expr: Expr, fn_name_index: Array[String], sink: Array[(String, Bool)], seen_raw: MutSet[String]) -> Unit {
  // #1348: collect_free_vars_USED_BUILTINS, not ..._indexed. The capture
  // variant drops inlined-builtin call callees, which is right for closure
  // capture and exactly wrong here -- the dropped name is the only evidence
  // that the builtin's host import must be reserved. See the doc comment on
  // collect_free_vars_used_builtins (codegen/common_analysis).
  //
  // #2479: a name is canonicalized ONCE per program. Every top-level body
  // used to push every free name it saw, so `canonical_builtin_name` (a
  // 40-arm string match) and the final map insert ran once per OCCURRENCE
  // across the whole program; `seen_raw` cuts that to once per distinct name.
  let fvs = collect_free_vars_used_builtins(expr, array_empty(), fn_name_index)
  let mut j = 0
  while j < Array::length(fvs) {
    let raw = Array::get(fvs, j)
    if MutSet::has(seen_raw, raw) {
      ()
    } else {
      MutSet::add(seen_raw, raw)
      Array::push(sink, (canonical_builtin_name(raw), true))
    }
    j = j + 1
  }
}

export fn collect_used_builtin_names_into(stmts: Array[Stmt], fn_names: Array[String], fn_name_index: Array[String], sink: Array[(String, Bool)]) -> Unit {
  let seen_raw: MutSet[String] = MutSet::new_string()
  collect_used_builtin_names_into_seen(stmts, fn_names, fn_name_index, sink, seen_raw)
}

fn collect_used_builtin_names_into_seen(stmts: Array[Stmt], fn_names: Array[String], fn_name_index: Array[String], sink: Array[(String, Bool)], seen_raw: MutSet[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => push_free_canonical(expr, fn_name_index, sink, seen_raw),
      SLetMut(_, _, expr) => push_free_canonical(expr, fn_name_index, sink, seen_raw),
      STest(_, expr) => push_free_canonical(expr, fn_name_index, sink, seen_raw),
      SBench(_, expr) => push_free_canonical(expr, fn_name_index, sink, seen_raw),
      SExpr(expr) => push_free_canonical(expr, fn_name_index, sink, seen_raw),
      SModule(_, _, inner) => collect_used_builtin_names_into_seen(inner, fn_names, fn_name_index, sink, seen_raw),
      _ => ()
    }
    i = i + 1
  }
}

export fn collect_used_builtin_names(stmts: Array[Stmt], fn_names: Array[String]) -> Map[String, Bool] {
  // Sorted membership index (see core/sorted_index.vibe) -- the MapBuilder
  // version was O(N^2) to build and O(N) per lookup.
  let fn_name_index = sorted_names_of(fn_names)
  let sink = array_empty()
  collect_used_builtin_names_into(stmts, fn_names, fn_name_index, sink)
  let set_b = MapBuilder::new()
  let mut k = 0
  while k < Array::length(sink) {
    let (nm, _) = Array::get(sink, k)
    MapBuilder::set(set_b, nm, true)
    k = k + 1
  }
  MapBuilder::freeze(set_b)
}

fn expr_is_map_literal(e: Expr) -> Bool {
  match e {
    EMap(_) => true,
    _ => false
  }
}

fn expr_is_array_literal(e: Expr) -> Bool {
  match e {
    EArray(_) => true,
    _ => false
  }
}

fn expr_is_lambda(e: Expr) -> Bool {
  match e {
    EFn(_, _, _, _, _, _) => true,
    _ => false
  }
}

fn top_value_any_node(expr: Expr, pred: (Expr) -> Bool, skip_top_fn: Bool) -> Bool {
  match expr {
    EFn(_, _, _, _, _, body) => if skip_top_fn {
      expr_any_node(body, pred)
    } else {
      expr_any_node(expr, pred)
    },
    _ => expr_any_node(expr, pred)
  }
}

fn exprs_any_node(exprs: Array[Expr], pred: (Expr) -> Bool) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(exprs) && !found {
    found = expr_any_node(Array::get(exprs, i), pred)
    i = i + 1
  }
  found
}

/// Does any node of any expression the statements carry satisfy `pred`?
/// With `skip_top_fn`, a top-level `let f = (..) -> body` is searched from
/// its BODY: that lambda becomes a function, not a value an expression
/// builds. The match names every `Stmt` variant and has no `_` arm, so a
/// variant added later stops this file compiling until it is classified: a
/// skipped expression would answer "no" and drop an rc_drop arm the program
/// needs.
fn stmts_any_node(stmts: Array[Stmt], pred: (Expr) -> Bool, skip_top_fn: Bool) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) && !found {
    found = match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => top_value_any_node(expr, pred, skip_top_fn),
      SFnDecl(_, _, expr, attrs, extra) => top_value_any_node(expr, pred, skip_top_fn) || exprs_any_node(attrs, pred) || exprs_any_node(extra, pred),
      SLetMut(_, _, expr) => expr_any_node(expr, pred),
      SLetPat(_, expr) => expr_any_node(expr, pred),
      STest(_, expr) => expr_any_node(expr, pred),
      SBench(_, expr) => expr_any_node(expr, pred),
      SExample(_, expr) => expr_any_node(expr, pred),
      SExpr(expr) => expr_any_node(expr, pred),
      SModule(_, _, inner) => stmts_any_node(inner, pred, skip_top_fn),
      SEnum(_, _, _, _, _) => false,
      SSuberror(_, _, _) => false,
      SStruct(_, _, _, _, _, _) => false,
      STypeAlias(_, _, _, _) => false,
      STrait(_, _, _, _, _, _) => false,
      SImpl(_, _, _, _) => false,
      SExternLet(_, _) => false,
      SImport(_, _) => false,
      SExport(_) => false,
      SReExport(_, _) => false,
      SAliasDecl(_, _) => false,
      SReExportSourceBoundary(_, _) => false,
      SQualifiedPatternRefs(_) => false,
      STestEffectRows(_) => false,
      SPositionalParams(_) => false,
      SEffectDef(_, _, _, _) => false,
      SEffectSet(_, _, _) => false,
      SResource(_, _) => false
    }
    i = i + 1
  }
  found
}

/// Can this program make a closure block (rc class 7) or a ref cell (class
/// 8)? compile_lambda makes the first, for a lambda compiled as a value that
/// captures something, and a ref cell only boxes a `let mut` such a lambda
/// captures. Both need a lambda nested in an expression; a top-level
/// function definition is not one.
export fn program_makes_closure_blocks(stmts: Array[Stmt]) -> Bool {
  stmts_any_node(stmts, expr_is_lambda, true)
}

/// Does the program write an array literal? On the RC lane a literal
/// allocates its array block (rc class 5) inline; every other array is made
/// by the `arr_new` / `Array::slice` / `Array::with_capacity` helpers, whose
/// reachability lc_emit_module_sections reads off the final bodies.
export fn program_has_array_literal(stmts: Array[Stmt]) -> Bool {
  stmts_any_node(stmts, expr_is_array_literal, false)
}

/// Can this program make a map block (rc class 6, or the class-9
/// `MapBuilder` handle)? Codegen makes one in exactly five places -- a map
/// literal (`Map::new()` and `Map::from_pairs(..)` parse to one), `Map::set`,
/// `Map::delete`, `MapBuilder::new` and `MapBuilder::freeze` -- so the answer
/// is "the program has a map literal, or names anything under `Map::` /
/// `MapBuilder::`". The name test is deliberately wider than the five: a
/// `Map::get` with no creator anywhere is not a case worth a narrower rule.
/// `used` is `collect_used_builtin_names` over the same statements.
export fn program_makes_map_blocks(stmts: Array[Stmt], used: Map[String, Bool]) -> Bool {
  let names = Map::keys(used)
  let mut i = 0
  let mut found = false
  while i < Array::length(names) && !found {
    let n = Array::get(names, i)
    found = String::starts_with(n, "Map::") || String::starts_with(n, "MapBuilder::")
    i = i + 1
  }
  found || stmts_any_node(stmts, expr_is_map_literal, false)
}
