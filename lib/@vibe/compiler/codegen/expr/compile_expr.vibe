//# Functions

fn is_frozen_array_conversion_name(name: String) -> Bool {
  name == "FrozenArray::from_array" || name == "FrozenArray::to_array"
}

/// Builtin indices live before `func_offset`, while ordinary closure table
/// slots are relative to it. Materialize these two first-class builtins as a
/// one-argument lambda so their value form uses the same direct runtime body
/// as a source call instead of encoding a negative table slot (#1733).
fn frozen_array_conversion_closure(name: String) -> Expr {
  let param = "__frozen_array_value"
  let params: Array[(String, Option[TypeExpr])] = [
    (param, None)
  ]
  EFn(array_empty(), array_empty(), params, None, None, ECall(EIdent(name, -1), [
    EIdent(param, -1)
  ], -1))
}

/// #672: emit structural equality for two tuples (non-rc layout: element i at
/// ptr+i*8, value = raw pointer). The arity comes from whichever operand is a
/// tuple literal (the checker guarantees same-arity tuples on both sides).
/// Evaluates each operand to a pointer in a temp local, then ANDs an element-wise
/// generic `eq` over all elements. Produces a raw i64 0/1. `compile_expr_fn` is
/// the main expression compiler, threaded to avoid a forward reference.
fn emit_tuple_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, num: Int, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let aptr = next_local
  Array::push(local_names, "__eqa")
  let bptr = next_local + 1
  Array::push(local_names, "__eqb")
  let nl1 = compile_expr_fn(buf, lhs, local_names, next_local + 2, ctx, ld)
  // RC tuples are tagged (`value = (block_start+8)|1`) and carry an 8-byte
  // header (type_id/length) before the fields, unlike the bare `i*8`-packed
  // non-RC layout — untag and skip the header so field reads land on the
  // actual elements instead of the header words (previously read as if they
  // were fields 0/1, making equal-valued tuples at different addresses
  // compare unequal; this is also why the RC path was disabled entirely
  // before this fix).
  if ctx.enable_rc {
    emit_i64_const(buf, -2)
    emit_i64_and(buf)
  } else {
    ()
  }
  emit_local_set(buf, aptr)
  let nl2 = compile_expr_fn(buf, rhs, local_names, nl1, ctx, ld)
  if ctx.enable_rc {
    emit_i64_const(buf, -2)
    emit_i64_and(buf)
  } else {
    ()
  }
  emit_local_set(buf, bptr)
  let field_off = if ctx.enable_rc {
    8
  } else {
    0
  }
  let (eq_fidx, _, _) = resolve_func(ctx.func_table, "eq")
  emit_i64_const(buf, 1)
  let mut i = 0
  while i < num {
    emit_local_get(buf, aptr)
    emit_i32_wrap_i64(buf)
    emit_i64_load(buf, 3, field_off + i * 8)
    emit_local_get(buf, bptr)
    emit_i32_wrap_i64(buf)
    emit_i64_load(buf, 3, field_off + i * 8)
    emit_call(buf, eq_fidx)
    emit_i64_and(buf)
    i = i + 1
  }
  nl2
}

/// #672: structural equality for two enum constructor values (non-rc layout:
/// value = ptr|1, tag i32 at ptr+0, field i at ptr+8+i*8). One operand is a ctor
/// literal so the field count `fc` is statically known. Compares the runtime
/// tags first (different variants => not equal, e.g. `Circle(5) != Point`), then
/// — when tags match — ANDs an element-wise generic `eq` over the `fc` fields.
/// Flat ctors (Int/String/Bool fields) are correct; nested-ctor fields fall back
/// to `eq` (so recursive types stay non-structural — tracked in #672).
fn emit_ctor_struct_eq(buf: Bytes, lhs: Expr, rhs: Expr, fc: Int, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let aptr = next_local
  Array::push(local_names, "__ceqa")
  let bptr = next_local + 1
  Array::push(local_names, "__ceqb")
  let nl1 = compile_expr_fn(buf, lhs, local_names, next_local + 2, ctx, ld)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_local_set(buf, aptr)
  let nl2 = compile_expr_fn(buf, rhs, local_names, nl1, ctx, ld)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_local_set(buf, bptr)
  emit_local_get(buf, aptr)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf, 2, 0)
  emit_local_get(buf, bptr)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_eq(buf)
  emit_if_i64(buf)
  let (eq_fidx, _, _) = resolve_func(ctx.func_table, "eq")
  if fc == 63 {
    // #724 round 2: DYNAMIC field count — fc 63 marks an enum-typed value
    // whose variant (hence argc) is only known at runtime. Equal tags imply
    // equal argc, so loop over argc@4 read from the value itself.
    let res_l = nl2
    let cnt_l = nl2 + 1
    let ii_l = nl2 + 2
    Array::push(local_names, "__ceq_res")
    Array::push(local_names, "__ceq_cnt")
    Array::push(local_names, "__ceq_i")
    emit_i64_const(buf, 1)
    emit_local_set(buf, res_l)
    emit_local_get(buf, aptr)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 4)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, cnt_l)
    emit_i64_const(buf, 0)
    emit_local_set(buf, ii_l)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf, ii_l)
    emit_local_get(buf, cnt_l)
    emit_i64_ge_s(buf)
    emit_br_if(buf, 1)
    emit_local_get(buf, res_l)
    emit_local_get(buf, aptr)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf, ii_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 8)
    emit_i32_mul(buf)
    emit_i32_add(buf)
    emit_i64_load(buf, 3, 8)
    emit_local_get(buf, bptr)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf, ii_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 8)
    emit_i32_mul(buf)
    emit_i32_add(buf)
    emit_i64_load(buf, 3, 8)
    emit_call(buf, eq_fidx)
    emit_i64_and(buf)
    emit_local_set(buf, res_l)
    emit_local_get(buf, ii_l)
    emit_i64_const(buf, 1)
    emit_i64_add(buf)
    emit_local_set(buf, ii_l)
    emit_br(buf, 0)
    emit_end(buf)
    emit_end(buf)
    emit_local_get(buf, res_l)
    emit_else(buf)
    emit_i64_const(buf, 0)
    emit_end(buf)
    nl2 + 3
  } else {
    emit_i64_const(buf, 1)
    let mut i = 0
    while i < fc {
      emit_local_get(buf, aptr)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, 8 + i * 8)
      emit_local_get(buf, bptr)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, 8 + i * 8)
      emit_call(buf, eq_fidx)
      emit_i64_and(buf)
      i = i + 1
    }
    emit_else(buf)
    emit_i64_const(buf, 0)
    emit_end(buf)
    nl2
  }
}

/// #672 (post-#724): true when `e` is a shape AST node the recursive
/// structural comparator below can walk directly — a tuple literal, a
/// payload-ctor call, a nullary-ctor ident, or a record literal (records and
/// ctors share the runtime [tag@0][argc@4][fields@8+] layout since #722).
fn is_agg_shape(e: Expr, ct: CtorTable) -> Bool {
  is_etuple(e) || is_ctor_call(e, ct) || is_nullary_ctor_ident(e, ct) || is_erecord(e)
}

/// #672 (post-#724): the shape literal for a FIELD sub-expression `el` inside
/// an enclosing tuple/ctor/record shape, resolving one level further than
/// is_agg_shape alone — `el` may itself be a tracked-variable ident (e.g. the
/// `a` in `(a, 3)` where `let a = (1, 2)` earlier) rather than a literal
/// written inline. Returns `el` itself when it is already a literal shape, the
/// ident's tracked agg_local_exprs shape when it resolves to one, or EInt(0)
/// (not an aggregate shape — a plain leaf, gated by is_agg_shape at the call
/// site) otherwise. This is what lets `(a, 3) == (b, 3)` recurse into `a`/`b`'s
/// OWN tracked nested shape instead of only comparing the outer pair.
fn resolved_element_shape(el: Expr, ctx: CompileCtx, local_names: Array[String]) -> Expr {
  if is_agg_shape(el, ctx.ctor_table) {
    el
  } else if is_eident(el) {
    let s = agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, el, local_names)
    if is_agg_shape(s, ctx.ctor_table) {
      s
    } else {
      EInt(0)
    }
  } else {
    EInt(0)
  }
}

/// #672 (post-#724): the field VALUE expressions of a ctor/record shape, in
/// runtime field order — `Array::length` of the result is the field count.
/// Mirrors the `S::{ .. }` ECall-sugar unwrap the existing (flat, #724)
/// cfc computation used, so a defensively-parsed record-sugar ctor call
/// (single ERecord arg) reports its RECORD's field count/exprs, not the
/// call's own 1-arg arity.
fn ctor_shape_field_exprs(shape: Expr, ct: CtorTable) -> Array[Expr] with Exception {
  if is_ctor_call(shape, ct) {
    let cargs = get_ecall_args(shape)
    if Array::length(cargs) == 1 {
      match Array::get(cargs, 0) {
        ERecord(_, rfields, _) => {
          let out = array_empty()
          let mut i = 0
          while i < Array::length(rfields) {
            let (_, fv) = Array::get(rfields, i)
            Array::push(out, fv)
            i = i + 1
          }
          out
        },
        _ => cargs
      }
    } else {
      cargs
    }
  } else {
    match shape {
      ERecord(_, rfields, _) => {
        let out = array_empty()
        let mut i = 0
        while i < Array::length(rfields) {
          let (_, fv) = Array::get(rfields, i)
          Array::push(out, fv)
          i = i + 1
        }
        out
      },
      _ => array_empty()
    }
  }
}

/// #672 (post-#724): RECURSIVE structural equality driven by a shape AST node
/// (a tuple / ctor / record literal — see is_agg_shape). The two values under
/// comparison are already evaluated into local slots `asl`/`bsl` (raw i64:
/// pointer for aggregates, scalar otherwise — the same representation
/// compile_expr leaves on the stack, whether freshly evaluated or loaded back
/// out of a parent aggregate's field). Leaves a single i64 0/1 on the stack.
///
/// For each field: when the shape says the field is ITSELF an aggregate
/// (nested tuple/ctor/record), the field's raw i64 is loaded into fresh locals
/// and this function RECURSES on that field's own shape sub-expression —
/// fixing the residual #672 gap (nested aggregates compared elementwise via
/// the type-blind generic `eq`, which pointer-compares two structurally-equal
/// but distinctly-allocated nested aggregates as unequal). A field whose shape
/// is not statically an aggregate (scalar, or an opaque call-result / bound
/// name we cannot see the literal shape of) keeps the old generic-`eq` leaf
/// comparison — same residual as before, just one level shallower.
fn emit_eq_shape_slots(buf: Bytes, shape: Expr, asl: Int, bsl: Int, local_names: Array[String], nl0: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let (eq_fidx, _, _) = resolve_func(ctx.func_table, "eq")
  if is_etuple(shape) {
    let elems = get_etuple_elems(shape)
    let num = Array::length(elems)
    let ap = nl0
    Array::push(local_names, "__seqta")
    let bp = nl0 + 1
    Array::push(local_names, "__seqtb")
    emit_local_get(buf, asl)
    if ctx.enable_rc {
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
    } else {
      ()
    }
    emit_local_set(buf, ap)
    emit_local_get(buf, bsl)
    if ctx.enable_rc {
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
    } else {
      ()
    }
    emit_local_set(buf, bp)
    let field_off = if ctx.enable_rc {
      8
    } else {
      0
    }
    emit_i64_const(buf, 1)
    let mut nl = nl0 + 2
    let mut i = 0
    while i < num {
      let el = Array::get(elems, i)
      let el_shape = resolved_element_shape(el, ctx, local_names)
      if is_agg_shape(el_shape, ctx.ctor_table) {
        let na = nl
        Array::push(local_names, "__seqea")
        let nb = nl + 1
        Array::push(local_names, "__seqeb")
        emit_local_get(buf, ap)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, field_off + i * 8)
        emit_local_set(buf, na)
        emit_local_get(buf, bp)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, field_off + i * 8)
        emit_local_set(buf, nb)
        nl = emit_eq_shape_slots(buf, el_shape, na, nb, local_names, nl + 2, ctx, ld, ce)
        emit_i64_and(buf)
      } else {
        emit_local_get(buf, ap)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, field_off + i * 8)
        emit_local_get(buf, bp)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, field_off + i * 8)
        emit_call(buf, eq_fidx)
        emit_i64_and(buf)
      }
      i = i + 1
    }
    nl
  } else if is_ctor_call(shape, ctx.ctor_table) || is_nullary_ctor_ident(shape, ctx.ctor_table) || is_erecord(shape) {
    let field_exprs = ctor_shape_field_exprs(shape, ctx.ctor_table)
    let fc = Array::length(field_exprs)
    let ap = nl0
    Array::push(local_names, "__seqca")
    let bp = nl0 + 1
    Array::push(local_names, "__seqcb")
    emit_local_get(buf, asl)
    emit_i64_const(buf, -2)
    emit_i64_and(buf)
    emit_local_set(buf, ap)
    emit_local_get(buf, bsl)
    emit_i64_const(buf, -2)
    emit_i64_and(buf)
    emit_local_set(buf, bp)
    emit_local_get(buf, ap)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0)
    emit_local_get(buf, bp)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0)
    emit_i32_eq(buf)
    emit_if_i64(buf)
    emit_i64_const(buf, 1)
    let mut nl = nl0 + 2
    let mut i = 0
    while i < fc {
      let el = Array::get(field_exprs, i)
      let el_shape = resolved_element_shape(el, ctx, local_names)
      if is_agg_shape(el_shape, ctx.ctor_table) {
        let na = nl
        Array::push(local_names, "__seqfa")
        let nb = nl + 1
        Array::push(local_names, "__seqfb")
        emit_local_get(buf, ap)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, 8 + i * 8)
        emit_local_set(buf, na)
        emit_local_get(buf, bp)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, 8 + i * 8)
        emit_local_set(buf, nb)
        nl = emit_eq_shape_slots(buf, el_shape, na, nb, local_names, nl + 2, ctx, ld, ce)
        emit_i64_and(buf)
      } else {
        emit_local_get(buf, ap)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, 8 + i * 8)
        emit_local_get(buf, bp)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, 8 + i * 8)
        emit_call(buf, eq_fidx)
        emit_i64_and(buf)
      }
      i = i + 1
    }
    emit_else(buf)
    emit_i64_const(buf, 0)
    emit_end(buf)
    nl
  } else {
    // Not a statically-known aggregate shape (scalar leaf, or an opaque
    // sub-value whose shape this pass cannot see) — the pre-#672-nested
    // generic-eq comparison, unchanged.
    emit_local_get(buf, asl)
    emit_local_get(buf, bsl)
    emit_call(buf, eq_fidx)
    nl0
  }
}

/// #672 (post-#724): top-level wrapper — evaluate `lhs`/`rhs` (via `ce`, the
/// main expression compiler) into fresh raw-value locals, then drive the
/// RECURSIVE structural walk from `shape` (a tuple/ctor/record literal AST —
/// either operand's literal, or a tracked variable's recorded shape literal,
/// see CompileCtx.agg_local_exprs). Supersedes the flat emit_tuple_struct_eq /
/// emit_ctor_struct_eq for every case where an actual shape LITERAL is known
/// (nested elements now recurse instead of falling back to generic `eq`);
/// callers fall back to the old flat comparators when only a shallow kind+n
/// is known (no literal in scope — e.g. a round-2 declared-return-type or
/// dynamic-argc tracked binding), which is unchanged from before this change.
fn emit_eq_shape_top(buf: Bytes, shape: Expr, lhs: Expr, rhs: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let aptr = next_local
  Array::push(local_names, "__seqa")
  let bptr = next_local + 1
  Array::push(local_names, "__seqb")
  let nl1 = ce(buf, lhs, local_names, next_local + 2, ctx, ld)
  emit_local_set(buf, aptr)
  let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)
  emit_local_set(buf, bptr)
  emit_eq_shape_slots(buf, shape, aptr, bptr, local_names, nl2, ctx, ld, ce)
}

/// #672: emit the equality test for `lhs == rhs`, leaving a raw i64 0/1 on the
/// stack (1 = equal). Routes through the structural comparators when an operand
/// is a tuple / ctor literal (non-rc), else the generic runtime `eq`. Every `==`
/// / `!=` codegen site — the general expression form AND the if / `!`-if / while
/// condition fast-paths — calls this, so structural equality is consistent
/// across all of them (the post-processing each site applies to the 0/1 result —
/// `i32_wrap`/`i32_eqz`/rc-shift — is unchanged).
fn emit_eq_value(buf: Bytes, lhs: Expr, rhs: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  // #724: aggregate shape of a bare-ident operand whose `let` value was a
  // tuple/ctor/record literal (kind*64+n, or -1) — extends the structural
  // comparators below to both-sides-bound comparisons.
  let lhs_agg = agg_info_of_ident(ctx.agg_local_slots, lhs, local_names)
  let rhs_agg = agg_info_of_ident(ctx.agg_local_slots, rhs, local_names)
  if is_etuple(lhs) || is_etuple(rhs) {
    // #672: a tuple LITERAL operand always carries its own shape — always
    // safe (and correct for nesting) to drive the recursive comparator.
    let lit = if is_etuple(lhs) {
      lhs
    } else {
      rhs
    }
    emit_eq_shape_top(buf, lit, lhs, rhs, local_names, next_local, ctx, ld, ce)
  } else if lhs_agg / 64 == 1 || rhs_agg / 64 == 1 {
    // Tracked tuple binding on at least one side; the checker guarantees the
    // other side is the same tuple type, so its arity matches. #672: when the
    // tracked slot's recorded shape is an actual tuple LITERAL (agg_local_exprs
    // — a direct `let a = (..)` or an alias of one), recurse through it so
    // nested elements compare structurally too; otherwise (no literal in
    // scope, e.g. a round-2 declared-return-type tuple) fall back to the flat,
    // depth-1 comparator exactly as before this change.
    let tshape = if lhs_agg / 64 == 1 {
      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, lhs, local_names)
    } else {
      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, rhs, local_names)
    }
    if is_etuple(tshape) {
      emit_eq_shape_top(buf, tshape, lhs, rhs, local_names, next_local, ctx, ld, ce)
    } else {
      let tn = if lhs_agg / 64 == 1 {
        lhs_agg % 64
      } else {
        rhs_agg % 64
      }
      emit_tuple_struct_eq(buf, lhs, rhs, tn, local_names, next_local, ctx, ld, ce)
    }
  } else if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) || is_ctor_call(rhs, ctx.ctor_table) || is_nullary_ctor_ident(rhs, ctx.ctor_table) {
    // #672: a payload/nullary ctor LITERAL operand always carries its own
    // shape — always safe to drive the recursive comparator.
    let clit = if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) {
      lhs
    } else {
      rhs
    }
    emit_eq_shape_top(buf, clit, lhs, rhs, local_names, next_local, ctx, ld, ce)
  } else if lhs_agg / 64 == 2 || rhs_agg / 64 == 2 {
    // Tracked ctor/record binding: values carry [tag@0][argc@4][fields@8+],
    // so the tag-comparing structural walk applies. #672: recurse through the
    // tracked slot's recorded shape LITERAL when one is on file (a direct
    // `let`/alias of a ctor/record literal); otherwise (round-2
    // declared-type or dynamic-argc tracking, no literal in scope) fall back
    // to the flat, depth-1 comparator exactly as before this change — when
    // BOTH sides are tracked as DIFFERENT variants the field counts can
    // differ, so that fallback walks the larger count (the tag comparison
    // short-circuits unequal variants before any field read).
    let cshape = if lhs_agg / 64 == 2 {
      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, lhs, local_names)
    } else {
      agg_expr_of_ident(ctx.agg_local_slots, ctx.agg_local_exprs, rhs, local_names)
    }
    if is_agg_shape(cshape, ctx.ctor_table) {
      emit_eq_shape_top(buf, cshape, lhs, rhs, local_names, next_local, ctx, ld, ce)
    } else {
      let lfc = if lhs_agg / 64 == 2 {
        lhs_agg % 64
      } else {
        0
      }
      let rfc = if rhs_agg / 64 == 2 {
        rhs_agg % 64
      } else {
        0
      }
      let cfc = if lfc > rfc {
        lfc
      } else {
        rfc
      }
      emit_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, ce)
    }
  } else if expr_is_intish(lhs, local_names, ctx) || expr_is_intish(rhs, local_names, ctx) {
    // A definitely-integer comparison: a direct i64.eq is both faster and
    // CORRECT for the full value range, sidestepping the `eq` builtin's
    // string-pointer fall-back. The type checker guarantees the other operand
    // is the same scalar type, so one intish side is enough.
    let nl1 = ce(buf, lhs, local_names, next_local, ctx, ld)
    let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)
    emit_i64_eq(buf)
    emit_i64_extend_i32_s(buf)
    nl2
  } else {
    let nl1 = ce(buf, lhs, local_names, next_local, ctx, ld)
    let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)
    let (eq_fidx, _, _) = resolve_func(ctx.func_table, "eq")
    emit_call(buf, eq_fidx)
    nl2
  }
}

//# Chain-interior renorm elision (#1877). On the untagged lane every Int
//# `+`/`-`/`*`/`/`/`<<`/unary-minus renormalizes its result (sign-extend from
//# bit 62, emit_wrap63_untagged). When such a result is consumed by ANOTHER
//# wrapping op, the interior renorm is redundant: the renorm rewrites only
//# bit 63, and `+`/`-`/`*`/`<<`(lhs)/unary-minus derive bits 0..62 of their
//# result from bits 0..62 of their operands alone (carries/borrows/partial
//# products only propagate upward). So only the chain's OUTERMOST renorm is
//# emitted, and the observed value of every op stays byte-identical to the
//# renorm-per-op spec. Everything that observes the true value — `/`/`%`/`>>`
//# operands, comparisons, bitops, shift amounts, call arguments, stores —
//# compiles through plain compile_expr and always receives a normalized value.

/// True iff `e` compiles through the untagged Int-arith path AND ends with a
/// renorm — i.e. the exact exprs whose trailing renorm a wrapping consumer may
/// elide. Mirrors the EBinop/EUnaryOp dispatch below: `&&`/`||`/`==`/`!=` are
/// diverted before the arith fallthrough, floatish operands take the f64 path.
fn is_untagged_wrap_arith(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with Exception {
  let t = expr_tag(e)
  if t == 5 {
    let op = get_ebinop_op(e)
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "<<" {
      !expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) && !expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)
    } else {
      false
    }
  } else if t == 6 {
    if get_eunaryop_op(e) == "-" {
      !expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)
    } else {
      false
    }
  } else {
    false
  }
}

/// Compile one operand of the Int op `op`. When the consumer op wraps —
/// `+`/`-`/`*`, or the shifted side of `<<` — and the operand is itself a
/// wrapping arith expr on the untagged lane, compile it WITHOUT its trailing
/// renorm (the consumer's own renorm re-derives bit 63). Every other case is
/// plain compile_expr. `is_lhs` distinguishes `<<`'s shifted side (wrapping)
/// from its shift amount (observed as-is).
fn compile_int_operand(buf: Bytes, op: String, is_lhs: Bool, e: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int) -> Int with Exception {
  let tolerant = op == "+" || op == "-" || op == "*" || (op == "<<" && is_lhs)
  if tolerant && !ctx.enable_rc && is_untagged_wrap_arith(e, local_names, ctx) {
    compile_wrap_arith_loose(buf, e, local_names, next_local, ctx, ld)
  } else {
    compile_expr(buf, e, local_names, next_local, ctx, ld)
  }
}

/// Compile a wrap-arith expr (is_untagged_wrap_arith == true, untagged lane)
/// with its trailing renorm ELIDED: bits 0..62 of the emitted value are exact,
/// bit 63 is unspecified. Only reachable as the operand of a wrapping consumer
/// whose own renorm (or an ancestor's, inductively) runs before any observer.
/// Operands of an interior `/` still normalize (tolerant is false for `/`),
/// so division always sees true values; only its RESULT renorm is deferred.
fn compile_wrap_arith_loose(buf: Bytes, e: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int) -> Int with Exception {
  let t = expr_tag(e)
  if t == 5 {
    let op = get_ebinop_op(e)
    let nl1 = compile_int_operand(buf, op, true, get_ebinop_lhs(e), local_names, next_local, ctx, ld)
    let nl2 = compile_int_operand(buf, op, false, get_ebinop_rhs(e), local_names, nl1, ctx, ld)
    emit_binop_op(buf, op)
    nl2
  } else {
    emit_i64_const(buf, 0)
    let nl = compile_int_operand(buf, "-", false, get_eunaryop_expr(e), local_names, next_local, ctx, ld)
    emit_i64_sub(buf)
    nl
  }
}

export fn compile_expr(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int) -> Int with Exception {
  let __tag = expr_tag(expr)
  if __tag == 0 {
    let n = get_eint_value(expr)
    emit_i64_const(buf, n)
    if ctx.enable_rc {
      emit_i64_const(buf, 1)
      emit_i64_shl(buf)
    }
    next_local
  } else if __tag == 1 {
    let b_val = get_ebool_value(expr)
    emit_i64_const(buf, if b_val {
      if ctx.enable_rc {
        2
      } else {
        1
      }
    } else {
      0
    })
    next_local
  } else if __tag == 2 {
    let v = get_efloat_value(expr)
    let lo = Double::to_i64_bits_lo(v)
    let hi = Double::to_i64_bits_hi(v)
    emit_f64_const_lohi(buf, lo, hi)
    emit_i64_reinterpret_f64(buf)
    if ctx.enable_rc {
      Array::push(local_names, "__fbits")
      Array::push(local_names, "__fbox")
      emit_box_float(buf, ctx, next_local, next_local + 1)
      next_local + 2
    } else {
      next_local
    }
  } else if __tag == 3 {
    let s = get_estring_value(expr)
    let idx = str_table_lookup(ctx.str_table.strs, s)
    emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))
    next_local
  } else if __tag == 4 {
    let name = get_eident_name(expr)
    let len = Array::length(local_names)
    let mut __tl_i = len - 1
    let mut __tl_result = -1
    while __tl_i >= 0 {
      if Array::get(local_names, __tl_i) == name {
        __tl_result = __tl_i
        __tl_i = -1
      } else {
        __tl_i = __tl_i - 1
      }
    }
    let local_idx = __tl_result
    if local_idx >= 0 {
      if array_contains_str(ctx.ref_cell_names, name) {
        emit_local_get(buf, local_idx)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, 0)
      } else {
        emit_local_get(buf, local_idx)
      }
      next_local
    } else if is_frozen_array_conversion_name(name) {
      compile_expr(buf, frozen_array_conversion_closure(name), local_names, next_local, ctx, ld)
    } else {
      let mut __ci_idx = -1
      let __ci_len = Array::length(ctx.const_int_names)
      let mut __ci_j = 0
      while __ci_j < __ci_len {
        if Array::get(ctx.const_int_names, __ci_j) == name {
          __ci_idx = __ci_j
          __ci_j = __ci_len
        } else {
          __ci_j = __ci_j + 1
        }
      }
      if __ci_idx >= 0 {
        emit_i64_const(buf, Array::get(ctx.const_int_values, __ci_idx))
        if ctx.enable_rc {
          emit_i64_const(buf, 1)
          emit_i64_shl(buf)
        }
        next_local
      } else {
        let ctor_idx = ctor_table_index_of(ctx.ctor_table, name)
        if ctor_idx >= 0 {
          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)
          let ptr_l = next_local
          Array::push(local_names, "__ctor_ptr")
          if ctx.enable_rc {
            emit_i64_const(buf, 16)
            emit_call(buf, ctx.rc_alloc_func_idx)
            emit_local_set(buf, ptr_l)
            emit_local_get(buf, ptr_l)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, 16)
            emit_i32_store(buf, 2, 0)
            emit_local_get(buf, ptr_l)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, 1)
            emit_i32_store(buf, 2, 4)
            emit_local_get(buf, ptr_l)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, 1)
            emit_i32_store8(buf, 0, 7)
            emit_local_get(buf, ptr_l)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, tag_c)
            emit_i32_store(buf, 2, 8)
            emit_local_get(buf, ptr_l)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, 0)
            emit_i32_store(buf, 2, 12)
            emit_local_get(buf, ptr_l)
            emit_i64_const(buf, 8)
            emit_i64_add(buf)
            emit_i64_const(buf, 1)
            emit_i64_or(buf)
            next_local + 1
          } else {
            emit_global_get(buf, 0)
            emit_i64_extend_i32_u(buf)
            emit_local_set(buf, ptr_l)
            emit_global_get(buf, 0)
            emit_i32_const(buf, 8)
            emit_i32_add(buf)
            emit_global_set(buf, 0)
            emit_heap_grow_after_heap_set(buf, ctx)
            emit_local_get(buf, ptr_l)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, tag_c)
            emit_i32_store(buf, 2, 0)
            emit_local_get(buf, ptr_l)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, 0)
            emit_i32_store(buf, 2, 4)
            emit_local_get(buf, ptr_l)
            emit_i64_const(buf, 1)
            emit_i64_or(buf)
            next_local + 1
          }
        } else {
          let __tf_result = func_table_index_of(ctx.func_table, name)
          if __tf_result < 0 {
            // See `resolve_local` in common_base: reaching here means the
            // checker let an unresolved name through. Lead with whose bug it
            // is; the locals dump stays for whoever debugs the compiler.
            let mut diag = String::concat(codegen_unresolved_name_prefix(), name)
            diag = String::concat(diag, String::concat("` (ident", codegen_unresolved_name_suffix()))
            diag = String::concat(diag, " | locals=[")
            let mut di = 0
            while di < len {
              if di > 0 {
                diag = String::concat(diag, ",")
              }
              diag = String::concat(diag, Array::get(local_names, di))
              di = di + 1
            }
            diag = String::concat(diag, "]")
            throw(diag)
          }
          let fni = __tf_result
          let fidx = Array::get(ctx.func_table.indices, fni)
          if bsearch_leftmost(ctx.thunk_names, name) >= 0 {
            emit_i64_const(buf, 0)
            emit_call(buf, fidx)
            next_local
          } else {
            let table_slot = fidx - ctx.func_offset
            Array::push(ctx.table_slots_used, table_slot)
            emit_i64_const(buf, (table_slot<<2)|2)
            next_local
          }
        }
      }
    }
  } else if __tag == 5 {
    let op = get_ebinop_op(expr)
    let lhs = get_ebinop_lhs(expr)
    let rhs = get_ebinop_rhs(expr)
    if op == "&&" || op == "||" {
      // Short-circuit lowering. The old eager `i64.and`/`i64.or` (still what
      // emit_binop_op does) evaluated BOTH operands, so `false && inc()` ran
      // inc()'s side effects. Bool reprs: false = 0 in both lanes, true = 2
      // (tagged) under RC / 1 otherwise; eqz treats any non-zero as true.
      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)
      emit_i64_eqz(buf)
      if op == "&&" {
        emit_if_i64(buf)
        emit_i64_const(buf, 0)
        emit_else(buf)
        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)
        emit_end(buf)
        nl2
      } else {
        emit_if_i64(buf)
        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)
        emit_else(buf)
        emit_i64_const(buf, if ctx.enable_rc {
          2
        } else {
          1
        })
        emit_end(buf)
        nl2
      }
    } else if op == "==" && !(ctx.enable_rc && (expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx))) {
      // #704: float `==`/`!=` under RC must NOT go through emit_eq_value — under
      // RC a float is a BOXED heap value, so the generic eq compares box
      // pointers (always unequal for two distinct boxes), making `0.0 == 0.0`
      // false. Divert floatish RC `==`/`!=` to the float branch below, which
      // unboxes and compares values with f64_eq/f64_ne. (Non-RC keeps the raw
      // i64-bits compare here, so the default path is byte-identical.)
      let nle = emit_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr)
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      }
      nle
    } else if op == "!=" && !(ctx.enable_rc && (expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx))) {
      let nle = emit_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr)
      emit_i64_eqz(buf)
      emit_i64_extend_i32_s(buf)
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      }
      nle
    } else if expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx) {
      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)
      if ctx.enable_rc {
        emit_unbox_float(buf)
      }
      emit_f64_reinterpret_i64(buf)
      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)
      if ctx.enable_rc {
        emit_unbox_float(buf)
      }
      emit_f64_reinterpret_i64(buf)
      if op == "+" || op == "-" || op == "*" || op == "/" {
        if op == "+" {
          emit_f64_add(buf)
        } else if op == "-" {
          emit_f64_sub(buf)
        } else if op == "*" {
          emit_f64_mul(buf)
        } else {
          emit_f64_div(buf)
        }
        emit_i64_reinterpret_f64(buf)
        if ctx.enable_rc {
          Array::push(local_names, "__fbits")
          Array::push(local_names, "__fbox")
          emit_box_float(buf, ctx, nl2, nl2 + 1)
          nl2 + 2
        } else {
          nl2
        }
      } else {
        if op == "==" {
          emit_f64_eq(buf)
        } else if op == "!=" {
          emit_f64_ne(buf)
        } else if op == "<" {
          emit_f64_lt(buf)
        } else if op == ">" {
          emit_f64_gt(buf)
        } else if op == "<=" {
          emit_f64_le(buf)
        } else if op == ">=" {
          emit_f64_ge(buf)
        } else {
          throw(String::concat("unsupported float binop: ", op))
        }
        emit_i64_extend_i32_s(buf)
        if ctx.enable_rc {
          emit_i64_const(buf, 1)
          emit_i64_shl(buf)
        }
        nl2
      }
    } else if ctx.enable_rc {
      if op == "<<" {
        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)
        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)
        emit_i64_const(buf, 1)
        emit_i64_shr_s(buf)
        emit_i64_shl(buf)
        nl2
      } else if op == ">>" {
        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)
        emit_i64_const(buf, 1)
        emit_i64_shr_s(buf)
        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)
        emit_i64_const(buf, 1)
        emit_i64_shr_s(buf)
        emit_i64_shr_s(buf)
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
        nl2
      } else {
        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)
        // #1877: untag the LHS BEFORE the multiply — (t>>1)*u = tagged(a*b),
        // which overflows i64 exactly at the payload's 63-bit boundary. The
        // old post-multiply untag ((t*u)>>1) pre-wrapped the 4ab intermediate
        // one bit early, making RC `*` the lone 62-bit op.
        if op == "*" {
          emit_i64_const(buf, 1)
          emit_i64_shr_s(buf)
        } else {
          ()
        }
        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)
        emit_binop_op(buf, op)
        if op == "/" {
          emit_i64_const(buf, 1)
          emit_i64_shl(buf)
        } else if op == "<" || op == ">" || op == "<=" || op == ">=" {
          emit_i64_const(buf, 1)
          emit_i64_shl(buf)
        } else {
          ()
        }
        nl2
      }
    } else {
      // Wrapping consumers elide the operand's own trailing renorm (see
      // compile_int_operand above); this op's renorm re-derives bit 63.
      let nl1 = compile_int_operand(buf, op, true, lhs, local_names, next_local, ctx, ld)
      let nl2 = compile_int_operand(buf, op, false, rhs, local_names, nl1, ctx, ld)
      emit_binop_op(buf, op)
      emit_arith_wrap_int(buf, false, op)
      nl2
    }
  } else if __tag == 6 {
    let op = get_eunaryop_op(expr)
    let operand = get_eunaryop_expr(expr)
    if op == "-" {
      if expr_is_floatish(operand, local_names, ctx) {
        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)
        // #745: under RC the operand is a BOXED float — unbox before the
        // f64.neg and rebox the result, exactly like the float binop path.
        // Without this, `-1.0` negated the box POINTER and the "float" that
        // escaped was garbage bits.
        if ctx.enable_rc {
          emit_unbox_float(buf)
        }
        emit_f64_reinterpret_i64(buf)
        emit_f64_neg(buf)
        emit_i64_reinterpret_f64(buf)
        if ctx.enable_rc {
          Array::push(local_names, "__fbits")
          Array::push(local_names, "__fbox")
          emit_box_float(buf, ctx, nl, nl + 1)
          nl + 2
        } else {
          nl
        }
      } else {
        emit_i64_const(buf, 0)
        let nl = compile_int_operand(buf, "-", false, operand, local_names, next_local, ctx, ld)
        emit_i64_sub(buf)
        // #1877: -MIN (2^62) is the one in-range operand whose negation
        // leaves the 63-bit range — untagged lanes renormalize like binop
        // `-` (RC wraps naturally: 0 - tagged(MIN) overflows i64 back to
        // tagged(MIN)).
        emit_arith_wrap_int(buf, ctx.enable_rc, "-")
        nl
      }
    } else if op == "!" {
      let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)
      emit_i64_eqz(buf)
      emit_i64_extend_i32_s(buf)
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      }
      nl
    } else {
      throw(String::concat("unsupported unary op: ", op))
    }
  } else if __tag == 7 {
    let cond = get_eif_cond(expr)
    let then_e = get_eif_then(expr)
    let else_e = get_eif_else(expr)
    let cond_tag = expr_tag(cond)
    let nl1 = if cond_tag == 5 {
      let cop = get_ebinop_op(cond)
      if cop == "==" || cop == "!=" || cop == "<" || cop == ">" || cop == "<=" || cop == ">=" {
        let clhs = get_ebinop_lhs(cond)
        let crhs = get_ebinop_rhs(cond)
        if cop == "==" && !(ctx.enable_rc && (expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx))) {
          let cnl2 = emit_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr)
          emit_i32_wrap_i64(buf)
          cnl2
        } else if cop == "!=" && !(ctx.enable_rc && (expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx))) {
          let cnl2 = emit_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr)
          emit_i32_wrap_i64(buf)
          emit_i32_eqz(buf)
          cnl2
        } else if expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx) {
          // #704: unbox boxed floats under RC before reinterpreting as f64, and
          // handle ==/!= here (f64_eq/f64_ne) so float equality in an if/while
          // condition compares values, not box pointers.
          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)
          if ctx.enable_rc {
            emit_unbox_float(buf)
          } else {
            ()
          }
          emit_f64_reinterpret_i64(buf)
          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)
          if ctx.enable_rc {
            emit_unbox_float(buf)
          } else {
            ()
          }
          emit_f64_reinterpret_i64(buf)
          if cop == "==" {
            emit_f64_eq(buf)
          }
          else if cop == "!=" {
            emit_f64_ne(buf)
          }
          else if cop == "<" {
            emit_f64_lt(buf)
          }
          else if cop == ">" {
            emit_f64_gt(buf)
          }
          else if cop == "<=" {
            emit_f64_le(buf)
          }
          else {
            emit_f64_ge(buf)
          }
          cnl2
        } else {
          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)
          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)
          if cop == "<" {
            emit_i64_lt_s(buf)
          }
          else if cop == ">" {
            emit_i64_gt_s(buf)
          }
          else if cop == "<=" {
            emit_i64_le_s(buf)
          }
          else {
            emit_i64_ge_s(buf)
          }
          cnl2
        }
      } else {
        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)
        emit_i32_wrap_i64(buf)
        cnl
      }
    } else if cond_tag == 1 {
      let b_val = get_ebool_value(cond)
      emit_i32_const(buf, if b_val {
        1
      } else {
        0
      })
      next_local
    } else if cond_tag == 6 {
      let uop = get_eunaryop_op(cond)
      let uoperand = get_eunaryop_expr(cond)
      if uop == "!" {
        let inner_tag = expr_tag(uoperand)
        if inner_tag == 5 {
          let iop = get_ebinop_op(uoperand)
          if iop == "==" || iop == "!=" || iop == "<" || iop == ">" || iop == "<=" || iop == ">=" {
            let ilhs = get_ebinop_lhs(uoperand)
            let irhs = get_ebinop_rhs(uoperand)
            if iop == "==" && !(ctx.enable_rc && (expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx))) {
              let inl2 = emit_eq_value(buf, ilhs, irhs, local_names, next_local, ctx, ld, compile_expr)
              emit_i32_wrap_i64(buf)
              emit_i32_eqz(buf)
              inl2
            } else if iop == "!=" && !(ctx.enable_rc && (expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx))) {
              let inl2 = emit_eq_value(buf, ilhs, irhs, local_names, next_local, ctx, ld, compile_expr)
              emit_i32_wrap_i64(buf)
              emit_i32_eqz(buf)
              emit_i32_eqz(buf)
              inl2
            } else if expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx) {
              // #704: unbox boxed floats under RC; handle ==/!= via f64_eq/f64_ne.
              // This arm is `!(ilhs iop irhs)`, so the trailing eqz negates.
              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)
              if ctx.enable_rc {
                emit_unbox_float(buf)
              } else {
                ()
              }
              emit_f64_reinterpret_i64(buf)
              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)
              if ctx.enable_rc {
                emit_unbox_float(buf)
              } else {
                ()
              }
              emit_f64_reinterpret_i64(buf)
              if iop == "==" {
                emit_f64_eq(buf)
              }
              else if iop == "!=" {
                emit_f64_ne(buf)
              }
              else if iop == "<" {
                emit_f64_lt(buf)
              }
              else if iop == ">" {
                emit_f64_gt(buf)
              }
              else if iop == "<=" {
                emit_f64_le(buf)
              }
              else {
                emit_f64_ge(buf)
              }
              emit_i32_eqz(buf)
              inl2
            } else {
              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)
              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)
              if iop == "<" {
                emit_i64_lt_s(buf)
              }
              else if iop == ">" {
                emit_i64_gt_s(buf)
              }
              else if iop == "<=" {
                emit_i64_le_s(buf)
              }
              else {
                emit_i64_ge_s(buf)
              }
              emit_i32_eqz(buf)
              inl2
            }
          } else {
            let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)
            emit_i32_wrap_i64(buf)
            cnl
          }
        } else {
          let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)
          emit_i32_wrap_i64(buf)
          cnl
        }
      } else {
        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)
        emit_i32_wrap_i64(buf)
        cnl
      }
    } else {
      let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)
      emit_i32_wrap_i64(buf)
      cnl
    }
    emit_if_i64(buf)
    let ld_inner = if ld >= 0 {
      ld + 1
    } else {
      -1
    }
    let names_len_before = Array::length(local_names)
    // #cov branch: the then-branch was taken.
    cov_emit_branch(buf, ctx.cov)
    let nl2 = compile_expr(buf, then_e, local_names, nl1, ctx, ld_inner)
    emit_else(buf)
    Array::truncate(local_names, names_len_before)
    // #678: the then-branch may have logged integral slots >= names_len_before
    // that the else-branch is about to reuse; drop them so a non-`let` rebind
    // there is not misread as int.
    int_log_reset_above(ctx, names_len_before)
    agg_log_reset_above2(ctx.agg_local_slots, ctx.agg_local_exprs, names_len_before)
    // #1062 follow-up: same prune for the float log -- the then-branch may
    // contain a nested match whose ctor-field bind (bind_match_pat) logged a
    // slot >= names_len_before as floatish; the else-branch reusing that slot
    // for a non-float value must not inherit the stale mark.
    float_log_reset_above(ctx, names_len_before)
    // #cov branch: the else-branch was taken.
    cov_emit_branch(buf, ctx.cov)
    let nl3 = compile_expr(buf, else_e, local_names, nl1, ctx, ld_inner)
    emit_end(buf)
    let max_nl_if = if nl2 > nl3 {
      nl2
    } else {
      nl3
    }
    while Array::length(local_names) < max_nl_if {
      Array::push(local_names, "")
    }
    max_nl_if
  } else if __tag == 8 {
    compile_call(buf, get_ecall_callee(expr), get_ecall_args(expr), local_names, next_local, ctx, ld, compile_expr)
  } else {
    compile_expr_tail(buf, expr, local_names, next_local, ctx, ld, compile_expr)
  }
}
