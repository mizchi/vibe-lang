import ./compile_match.vibe {
  compile_match
}

//# Functions

export fn compile_expr_tail5(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Error) -> Int with Error {
  match expr {
    EForIn(_, _, _, _) => throw("unsupported expression in codegen: EForIn"),
    EHandle(body, arms) => compile_expr_tail6(buf, body, arms, local_names, next_local, ctx, ld, compile_expr)
    ,
    EStringInterp(parts) => compile_expr_tail7(buf, parts, local_names, next_local, ctx, ld, compile_expr)
    ,
    ELabeledArg(_, _, val) => compile_expr(buf, val, local_names, next_local, ctx, ld)
    ,
    _ => throw("unsupported expression in codegen: unknown")
  }
}
