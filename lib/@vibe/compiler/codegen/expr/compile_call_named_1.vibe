    // EBinOp path's retag) -- untagged here means callers see 0 (== false
    // tagged) but a true result reads as 1 instead of the expected 2.
    if ctx.enable_rc {
      emit_i64_const(buf, 1)
      emit_i64_shl(buf)
    } else {
      ()
    }
    nl
  }
  else if !prefer_bound_call && fname == "simd_skip_ws" {
