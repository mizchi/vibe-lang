    emit_local_get(buf, pos_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf, mask_l)
    emit_i32_wrap_i64(buf)
    bytebuf_push(buf, 104)
    // i32.ctz
    emit_i32_add(buf)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, res_l)
    emit_br(buf, 2)
    emit_end(buf)
    // loop $scan
    emit_end(buf)
    // block $tail
    // scalar tail: loop $tscan
    emit_loop_void(buf)
    // if (pos >= len) { res = pos; br $ret }
    emit_local_get(buf, pos_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf, len_l)
    emit_i32_wrap_i64(buf)
    emit_i32_ge_u(buf)
    emit_if_void(buf)
    emit_local_get(buf, pos_l)
    emit_local_set(buf, res_l)
    emit_br(buf, 2)
    emit_end(buf)
    // b = load8_u(base + pos)
    emit_local_get(buf, base_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf, pos_l)
    emit_i32_wrap_i64(buf)
    emit_i32_add(buf)
    emit_i32_load8_u(buf, 0, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, b_l)
    // non_ws = (b!=32) & (b!=9) & (b!=10) & (b!=13)
    emit_local_get(buf, b_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 32)
    emit_i32_ne(buf)
    emit_local_get(buf, b_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 9)
    emit_i32_ne(buf)
    bytebuf_push(buf, 113)
    // i32.and
    emit_local_get(buf, b_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 10)
    emit_i32_ne(buf)
    bytebuf_push(buf, 113)
    emit_local_get(buf, b_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 13)
    emit_i32_ne(buf)
    bytebuf_push(buf, 113)
    // if (non_ws) { res = pos; br $ret }
    emit_if_void(buf)
    emit_local_get(buf, pos_l)
    emit_local_set(buf, res_l)
    emit_br(buf, 2)
    emit_end(buf)
    // pos += 1; br $tscan
    emit_local_get(buf, pos_l)
    emit_i64_const(buf, 1)
    emit_i64_add(buf)
    emit_local_set(buf, pos_l)
    emit_br(buf, 0)
    emit_end(buf)
    // loop $tscan
    emit_end(buf)
    // block $ret
    emit_local_get(buf, res_l)
    nl + 7
  }
  else if !prefer_bound_call && fname == "perform" {
    let op_expr = Array::get(args, 0)
    let op_head = if is_eident(op_expr) {
      get_eident_name(op_expr)
    } else if expr_tag(op_expr) == 8 {
      let op_callee = get_ecall_callee(op_expr)
      if is_eident(op_callee) {
        get_eident_name(op_callee)
      } else {
        ""
      }
    } else {
      ""
    }
    // #640: `perform Exception::Throw(x)` IS `throw(x)`. `Error` is never in
    // ctx.effect_names (linked_compile.vibe excludes it), so the generic
    // lowering below would assign it the out-of-range fallback tag 3+n and
    // a `with Exception` handler (which catches tag 2, the EThrow tag — see
    // compile_expr_tail6.vibe) would never see it. Emit the exact EThrow
    // sequence instead (compile payload, throw tag 2), skipping the
    // perform-counter/memo-region machinery — Error is non-resumable.
    if is_exception_throw_operation(op_head) {
      let mut enl = next_local
      let thrown = if expr_tag(op_expr) == 8 && Array::length(get_ecall_args(op_expr)) > 0 {
        Array::get(get_ecall_args(op_expr), 0)
      } else {
        EUnit
      }
      if expr_tag(op_expr) == 8 && Array::length(get_ecall_args(op_expr)) > 0 {
        enl = ce(buf, thrown, local_names, enl, ctx, ld)
      } else {
        emit_i64_const(buf, 0)
      }
      let thrown_local = if ctx.enable_rc {
        emit_local_tee(buf, enl)
        enl
      } else {
        0 - 1
      }
      // #3141: the throw leaves every scope up to the innermost `handle`.
      rc_exit_release(buf, ctx, local_names, 3, thrown, thrown_local)
      bytebuf_push(buf, 8)
      bytebuf_push(buf, 2)
      if thrown_local >= 0 {
        enl + 1
      } else {
        enl
      }
    } else if is_exception_operation_name(op_head) {
      throw(String::concat("perform ", String::concat(op_head, ": the abortive Exception alias has a single operation, Throw (#1279)")))
    } else {
      // ADR-0076 追記34 V2: the perform-counter/memo frontier is gone.
      // A perform that reaches codegen was NOT migrated by
      // evidence_dict_pass -- i.e. its effect has no live handle
      // anywhere (a handled perform is rewritten into a dict call, a
      // mock over a host-effect label included) -- so at RUNTIME it can
      // only ever be an unhandled effect: it lowers to a value plus a
      // bare throw (exactly the old memo-miss leg minus the counter/
      // memo bookkeeping), which traps if it somehow executes. In
      // practice these sites are DEAD code that codegen must still
      // emit (dce-tolerated unreachable wrappers, e.g. lib/@vibe/fs's
      // perform wrappers in a program that never handles Fs), and the
      // throw's stack polymorphism is ALSO what keeps them valid: in a
      // program whose value aliases occupy a canonical builtin name
      // (`let Fs::read_file = read_file`, fs.vibe #795), the
      // op_is_builtin leg's recursive compile can resolve into the
      // alias hijack and leave an inconsistent stack -- harmless under
      // the throw, an invalid module without it (found live when V2's
      // first cut dropped the throw for host-mapped ops).
      let mut nl = next_local
      let eff_tag = effect_name_to_tag(ctx.effect_names, op_head)
      let op_canon = canonical_builtin_name(op_head)
      let op_is_builtin = func_table_index_of(ctx.func_table, op_canon) >= 0
      if op_is_builtin {
        nl = ce(buf, op_expr, local_names, nl, ctx, ld)
      } else if expr_tag(op_expr) == 8 {
        let op_args = get_ecall_args(op_expr)
        if Array::length(op_args) > 1 {
          // Multi-value payload (#548): pack all op args into a tuple (one
          // heap ref threaded as the single thrown value).
          nl = ce(buf, ETuple(op_args), local_names, nl, ctx, ld)
        } else if Array::length(op_args) > 0 {
          nl = ce(buf, Array::get(op_args, 0), local_names, nl, ctx, ld)
        } else {
          emit_i64_const(buf, 0)
        }
      } else {
        emit_i64_const(buf, 0)
      }
      bytebuf_push(buf, 8)
      bytebuf_push(buf, eff_tag)
      nl
    }
  }
  else if !prefer_bound_call && fname == "path" {
    ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
  }
  else if fname == "__lambda_return_owned" && get_eident_off(callee) < 0 {
    // #2754: lambda return ABI. Resolve at the return site while the lexical
    // scope is live; a global contract cannot describe a local callback.
    let value = Array::get(args, 0)
    let borrowed = match value {
      EDot(_, _, _, _) => true,
      ECall(EIdent(cn, _), _, _) => find_local_slot(local_names, cn) < 0 && (is_borrow_ret_builtin(cn) || bsearch_leftmost(ctx.borrow_ret_names, cn) >= 0),
      EIdent(n, _) => array_contains_str(ctx.loop_borrowed_names, n) || array_contains_str(ctx.ref_cell_names, n),
      _ => false
    }
    let nl = ce(buf, value, local_names, next_local, ctx, ld)
    if borrowed {
      // Expression compilation can reserve unnamed scratch slots.
      while Array::length(local_names) <= nl {
        Array::push(local_names, "")
      }
      emit_local_set(buf, nl)
      emit_rc_dup_guarded(buf, nl, ctx.rc_shadow, ctx.rc_dup_func_idx)
      emit_local_get(buf, nl)
      nl + 1
    } else {
      nl
    }
  }
  else if fname == "__loop_tail_retain" {
    // #768: codegen-internal marker (retain_wrap_branch_tails,
    // compile_expr_tail.vibe) -- a loop-borrowed bare ident / projection
    // escaping an if/match branch as the branch VALUE into a
    // scope-end-dropped `let`. Compile the read, then guarded rc_dup so the
    // per-iteration drop consumes the dup, not the loop-carried reference.
    // Never present in user AST (synthesized during codegen only).
    let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    let v_l = nl
    Array::push(local_names, "__ltr_v")
    emit_local_set(buf, v_l)
    emit_rc_dup_guarded(buf, v_l, ctx.rc_shadow, ctx.rc_dup_func_idx)
    emit_local_get(buf, v_l)
    nl + 1
  }
  else if !prefer_bound_call && (fname == "Path::ref" || fname == "Path::resolve") && Array::length(args) == 1 {
    // #762: both resolve their argument to an absolute path against the
    // process CWD via the `resolve_path` host import. The runtime op is
    // identical; the effect distinction (Path::ref pure, Path::resolve
    // `with Env`) lives in the checker's builtin signatures.
    ce(buf, ECall(EIdent("resolve_path", -1), [Array::get(args, 0)], -1), local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "Path::to_string" && Array::length(args) == 1 {
    // #762: PathRef / DynamicPath wrap a raw String; to_string is identity.
    ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "Path::is_absolute" && Array::length(args) == 1 {
    // #762: absolute iff the path begins with '/'. eq(char_code_at(x, 0), 47)
    // avoids synthesizing a "/" string (which would not be in the string
    // table).
    ce(buf, ECall(EIdent("eq", -1), [
      ECall(EIdent("String::char_code_at", -1), [Array::get(args, 0), EInt(0)], -1),
      EInt(47)
    ], -1), local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "__float_bits" {
    ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
  }
  else if fname == "Int::to_string" && Array::length(args) == 1 {
    // Cheatsheet-documented alias of the integer `__to_string` path (the
    // argument is Int by signature, so the string-pointer heuristic's int
    // route applies).
    ce(buf, ECall(EIdent("__to_string", -1), [Array::get(args, 0)], -1), local_names, next_local, ctx, ld)
  }
  else if fname == "Fs::readdir" && Array::length(args) == 1 {
    // #729/#730: readdir's surface is Array[String], but the host import
    // (`vibe_fs_read_dir_raw`, linked_compile) returns the byte-sorted entry
    // names NUL-joined as ONE packed string (#2957: a name may contain "\n"
    // but never NUL; same ABI as fs_read_file —
    // no host-side array building, RC/bump agnostic). Lower to ordinary
    // AST so String::split's codegen does the array work. An empty dir
    // returns "" which must yield [] — but split("", d) is [""] — hence
    // the length guard. String pieces are built with String::from_char_code
    // because a synthesized EString is not in the string table (same
    // constraint as double_to_string_expr).
    // #1262: shared with the gc lane -- the rewrite is source-level, so both
    // lanes take it from packed_dir_entries_to_array_expr rather than each
    // spelling it out (see that function for the empty-dir and string-table
    // constraints).
    ce(buf, packed_dir_entries_to_array_expr(ECall(EIdent("vibe_fs_read_dir_raw", -1), [
      Array::get(args, 0)
    ], -1), "__rd_names"), local_names, next_local, ctx, ld)
  }
  else if fname == "sh_lines" && Array::length(args) >= 1 {
    // `sh_lines(cmd) -> Array[String]`: the host import (`vibe_sh_lines_raw`,
    // linked_compile) runs the command and returns its stdout "\n"-joined as
    // ONE packed string (same ABI as fs_read_dir_nul). Lower to `String::split`
    // over it, with the empty-output guard yielding [] (split("", d) is [""]).
    // #777: any args beyond the first are labeled boolean flags folded
    // into the command string by `sh_lines_flag_cmd` (single-arg calls are
    // the common case and pass straight through unchanged).
    let sh_cmd = sh_lines_flag_cmd(Array::get(args, 0), args, 1)
    ce(buf, ELet("__sh_out", ECall(EIdent("vibe_sh_lines_raw", -1), [sh_cmd], -1), EIf(EBinOp("==", ECall(EIdent("String::length", -1), [
      // review-lint: allow-fixed-synthetic-name -- existing conversion temporaries preserved by the module split
      EIdent("__sh_out", -1)
    ], -1), EInt(0), -1), ECall(EIdent("Array::slice", -1), [
      EArray([ECall(EIdent("String::from_char_code", -1), [EInt(10)], -1)]),
      EInt(0),
      EInt(0)
    ], -1), ECall(EIdent("String::split", -1), [
      EIdent("__sh_out", -1),
      ECall(EIdent("String::from_char_code", -1), [EInt(10)], -1)
    ], -1)), -1), local_names, next_local, ctx, ld)
  }
  else if fname == "__to_string" && Array::length(args) == 1 && cc_expr_is_floatish(Array::get(args, 0), local_names, ctx) {
    // #744: a statically-floatish argument takes the Double formatter of
    // the runtime prelude (#2652) — the generic handler below would
    // stringify the raw f64 bits (or the box pointer under RC) as an
    // integer.
    double_runtime_require(ctx.func_table, double_runtime_to_string_name())
    ce(buf, double_to_string_expr(Array::get(args, 0)), local_names, next_local, ctx, ld)
  }
  else if fname == "__to_string" && Array::length(args) == 1 && cc_expr_is_boolish(Array::get(args, 0), local_names, ctx) {
    // #784: a statically-boolean argument formats as "true"/"false", not the
    // integer 1/0 the generic path below would emit. Reuse the existing
    // if/EString codegen: `if b { "true" } else { "false" }`.
    ce(buf, EIf(Array::get(args, 0), EString("true", -1), EString("false", -1)), local_names, next_local, ctx, ld)
  }
  else if fname == "__to_string" && Array::length(args) == 1 && cc_expr_is_stringish(Array::get(args, 0), local_names, ctx) {
    // #950: a statically-String argument IS the result — the generic
    // handler below already returns a string value unchanged at runtime,
    // but only after a string-pointer heuristic that requires ptr >= 64,
    // so the legal packed empty-string encoding 0 (ptr 0, len 0 — e.g.
    // `String::join([], sep)`'s empty case) was misread as Int 0 and
    // printed "0". Emitting the argument directly is byte-for-byte the
    // same dataflow as the generic path's string identity branch, minus
    // the misfiring heuristic. Appending the 0-encoded empty string via
    // String::concat copies 0 bytes, so `"[\{String::join([], "-")}]"`
    // now renders "[]".
    ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
  }
  else if fname == "__to_string" {
    let ts_arg0 = Array::get(args, 0)
    if ts_offset_refuses_render(ts_arg0, ctx) {
      throw(unrenderable_render_message(ts_arg0))
    }
    let ts_arg_is_int = ts_known_int(ts_arg0, local_names, ctx)
    let mut nl = ce(buf, ts_arg0, local_names, next_local, ctx, ld)
    let val_l = nl
    let neg_l = nl + 1
    let cur_l = nl + 2
    let abs_l = nl + 3
    let hp_l = nl + 4
    let len_l = nl + 5
    Array::push(local_names, "__ts_val")
    Array::push(local_names, "__ts_neg")
    Array::push(local_names, "__ts_cur")
    Array::push(local_names, "__ts_abs")
    Array::push(local_names, "__ts_hp")
    Array::push(local_names, "__ts_len")
    emit_local_set(buf, val_l)
    emit_block_i64(buf)
    if ts_arg_is_int {
      // #678: the argument is statically a known Int (literal or int-bound
      // local) — never run it through the string-pointer heuristic (a large
      // int like `1 << 40` has a zero low word and an in-bounds high word, so
      // it would be misread as an empty string). Force the integer path with
      // a false (i32) condition — the heuristic below also yields an i32 bool.
      emit_i32_const(buf, 0)
    } else {
      emit_local_get(buf, val_l)
      emit_i64_const(buf, 32)
      bytebuf_push(buf, 136)
      emit_local_tee(buf, abs_l)
      emit_i64_const(buf, 64)
      emit_i64_ge_s(buf)
      emit_local_get(buf, abs_l)
      // #606: a string is represented as (ptr << 32) | len, and `__to_string`
      // returns the value unchanged when it looks like a string pointer. A
      // string can live anywhere in linear memory — including the static data
      // section (token / literal strings), whose offset is ABOVE the heap bump
      // pointer during early compilation. The old bound `ptr < heap_ptr`
      // (global 0) misclassified such strings as ints and stringified their raw
      // i64, leaking a heap pointer (e.g. labeled param `x~` printed as
      // `1285664100319233~`). Use the full linear-memory size (memory.size
      // pages * 65536) as the upper bound so any in-bounds pointer is
      // recognized; a small int still has a zero high word and takes the int
      // path below.
      bytebuf_push(buf, 63)
      bytebuf_push(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_i64_const(buf, 65536)
      emit_i64_mul(buf)
      emit_i64_lt_s(buf)
      bytebuf_push(buf, 113)
      // #664: ALSO require the candidate string to FIT in linear memory:
      // ptr + len <= memory_size. The `ptr < memory_size` bound above is not
      // enough — a large integer (e.g. a 61-bit `Fs::stat_token`) whose HIGH
      // word happens to land below memory_size is otherwise misread as a string
      // pointer, and its LOW word becomes a multi-gigabyte "length". The next
      // `String::concat` then `memory.copy`s that bogus length and traps with
      // "memory access out of bounds" (the #664 crash, triggered during the
      // persistent-sources-cache write `__to_string(Fs::stat_token(path))`). A
      // real string always satisfies ptr + len <= memory_size, so adding this
      // bound keeps genuine strings on the identity path while routing such
      // large integers back to the integer-stringify path below.
      emit_local_get(buf, abs_l)
      emit_local_get(buf, val_l)
      emit_i64_const(buf, 4294967295)
      emit_i64_and(buf)
      emit_i64_add(buf)
      bytebuf_push(buf, 63)
      bytebuf_push(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_i64_const(buf, 65536)
      emit_i64_mul(buf)
      emit_i64_le_s(buf)
      bytebuf_push(buf, 113)
    }
    emit_if_void(buf)
    emit_local_get(buf, val_l)
    emit_br(buf, 1)
    emit_end(buf)
    // Under RC a scalar Int is tagged `n << 1` (low bit 0 marks a non-heap
    // value; see `Int::to_double` / `Double::to_int` which shift to/from this
    // form). Arithmetic stays in tagged space and compares correctly, but the
    // digit loop below renders the RAW i64 — so without untagging it prints
    // `2n` (e.g. 42 -> "84"). Recover the logical value with an arithmetic
    // (sign-preserving) shift right by 1. Strings already returned above via
    // the `br`, so this only touches the integer path.
    if ctx.enable_rc {
      emit_local_get(buf, val_l)
      emit_i64_const(buf, 1)
      emit_i64_shr_s(buf)
      emit_local_set(buf, val_l)
    }
    emit_i64_const(buf, 46)
    emit_local_set(buf, cur_l)
    emit_local_get(buf, val_l)
    emit_i64_const(buf, 0)
    emit_i64_lt_s(buf)
    emit_i64_extend_i32_s(buf)
    emit_local_set(buf, neg_l)
    emit_local_get(buf, val_l)
    emit_i64_const(buf, 0)
    emit_i64_lt_s(buf)
    emit_if_i64(buf)
    emit_i64_const(buf, 0)
    emit_local_get(buf, val_l)
    emit_i64_sub(buf)
    emit_else(buf)
    emit_local_get(buf, val_l)
    emit_end(buf)
    emit_local_set(buf, abs_l)
    emit_local_get(buf, abs_l)
    emit_i64_eqz(buf)
    emit_if_void(buf)
    emit_local_get(buf, cur_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 48)
    emit_i32_store8(buf, 0, 0)
    emit_local_get(buf, cur_l)
    emit_i64_const(buf, 1)
    emit_i64_sub(buf)
    emit_local_set(buf, cur_l)
    emit_end(buf)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf, abs_l)
    emit_i64_eqz(buf)
    emit_br_if(buf, 1)
    emit_local_get(buf, cur_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf, abs_l)
    emit_i64_const(buf, 10)
    emit_i64_rem_s(buf)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 48)
    emit_i32_add(buf)
    emit_i32_store8(buf, 0, 0)
    emit_local_get(buf, cur_l)
    emit_i64_const(buf, 1)
    emit_i64_sub(buf)
    emit_local_set(buf, cur_l)
    emit_local_get(buf, abs_l)
    emit_i64_const(buf, 10)
    emit_i64_div_s(buf)
    emit_local_set(buf, abs_l)
    emit_br(buf, 0)
    emit_end(buf)
    emit_end(buf)
    emit_local_get(buf, neg_l)
    emit_i32_wrap_i64(buf)
    emit_if_void(buf)
    emit_local_get(buf, cur_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 45)
    emit_i32_store8(buf, 0, 0)
    emit_local_get(buf, cur_l)
    emit_i64_const(buf, 1)
    emit_i64_sub(buf)
    emit_local_set(buf, cur_l)
    emit_end(buf)
    emit_global_get(buf, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, hp_l)
    emit_i64_const(buf, 46)
    emit_local_get(buf, cur_l)
    emit_i64_sub(buf)
    emit_local_set(buf, len_l)
    // Bump the heap pointer and run the grow check BEFORE the memory.copy
    // into the fresh allocation. The copy used to come first, which traps
    // with "memory access out of bounds" whenever the previous allocation
    // left global 0 within `len` bytes of the current memory end (the grow
    // check only guarantees the heap pointer itself is addressable, not a
    // full page of headroom). Hit in practice by large multi-module FS
    // compiles (#533 measurement: ~200-file cold-cache walk).
    emit_local_get(buf, hp_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf, len_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 7)
    emit_i32_add(buf)
    emit_i32_const(buf, -8)
    bytebuf_push(buf, 113)
    emit_i32_add(buf)
    emit_global_set(buf, 0)
    emit_heap_grow_after_heap_set(buf, ctx)
    emit_local_get(buf, hp_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf, cur_l)
    emit_i64_const(buf, 1)
    emit_i64_add(buf)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf, len_l)
    emit_i32_wrap_i64(buf)
    emit_memory_copy(buf)
    emit_local_get(buf, hp_l)
    emit_i64_const(buf, 32)
    emit_i64_shl(buf)
    emit_local_get(buf, len_l)
    emit_i64_or(buf)
    emit_end(buf)
    nl + 6
  }
  else if fname == "Double::to_int" || fname == "Float::to_int" {
    // #997: `i64.trunc_f64_s` TRAPS (an unhandled wasm trap, not a
    // catchable vibe `Error`) on NaN, +-Infinity, or any magnitude
    // outside the i64 range -- this is the inline lowering for a direct
    // `Double::to_int(...)` call, which is the COMMON case and bypasses
    // the builtin-body function table entirely (see
    // gen_double_to_int_body / gc_gen_double_to_int_body for the
    // indirect-call / first-class-value path, which carries the
    // identical guard). No feature flag on this wasm target makes
    // `i64.trunc_sat_f64_s` available, so NaN and out-of-i64-range
    // values saturate to 0 by hand instead of trunc'ing at all.
    // #3135: the argument's box is borrowed (md_is_double_reader) or, when
    // it is a temporary, released here (emit_float_operand_bits).
    let nl = emit_float_operand_bits(buf, Array::get(args, 0), local_names, next_local, ctx, ld, ce)
    let val_l = nl
    Array::push(local_names, "__d2i_val")
    emit_local_set(buf, val_l)
    // #1050: under RC the truncated i64 gets tagged via `n << 1` below, and
    // that shift itself overflows (silently flipping sign) once |n| reaches
    // 2^62 -- even though trunc_f64_s is happily defined for any magnitude
    // up to 2^63. So the bound guard has to protect the narrower domain the
    // tag can actually carry (vibe's tagged Int range is +-2^61, see
    // CLAUDE.md), not trunc_f64_s's own +-2^63 domain, whenever the result
    // is going to be tagged. Anything the tag can't carry saturates to 0,
    // consistent with the NaN saturation below instead of trunc'ing.
    // #2978: the Int range is +-2^62 on every lane (#1877), so both bounds
    // are 2^62; a value outside it saturates to Int::max_value /
    // Int::min_value, and NaN answers 0.
    let bound_hi = 1137704960
    let neg_bound_hi = 3285188608
    // NaN: x != x is only true for NaN.
    emit_local_get(buf, val_l)
    emit_f64_reinterpret_i64(buf)
    emit_local_get(buf, val_l)
    emit_f64_reinterpret_i64(buf)
    emit_f64_ne(buf)
    emit_if_i64(buf)
    emit_i64_const(buf, 0)
    emit_else(buf)
    // Upper bound: x < 2^63 (or the narrower +-2^61 taggable bound under RC).
    emit_local_get(buf, val_l)
    emit_f64_reinterpret_i64(buf)
    emit_f64_const_lohi(buf, 0, bound_hi)
    emit_f64_lt(buf)
    emit_if_i64(buf)
    // Lower bound: x >= -2^63 (or the narrower +-2^61 taggable bound under RC).
    emit_local_get(buf, val_l)
    emit_f64_reinterpret_i64(buf)
    emit_f64_const_lohi(buf, 0, neg_bound_hi)
    emit_f64_ge(buf)
    emit_if_i64(buf)
    emit_local_get(buf, val_l)
    emit_f64_reinterpret_i64(buf)
    emit_i64_trunc_f64_s(buf)
    emit_else(buf)
    emit_i64_const(buf, 0 - 4611686018427387903 - 1)
    emit_end(buf)
    emit_else(buf)
    emit_i64_const(buf, 4611686018427387903)
    emit_end(buf)
    emit_end(buf)
    if ctx.enable_rc {
      emit_i64_const(buf, 1)
      emit_i64_shl(buf)
    }
    nl + 1
  }
  else if fname == "Int::to_double" || fname == "Int::to_float" {
    let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    if ctx.enable_rc {
      emit_i64_const(buf, 1)
      emit_i64_shr_s(buf)
    }
    emit_f64_convert_i64_s(buf)
    emit_i64_reinterpret_f64(buf)
    if ctx.enable_rc {
      Array::push(local_names, "__fbits")
      Array::push(local_names, "__fbox")
      emit_box_float(buf, ctx, nl, nl + 1)
      nl + 2
    } else {
      nl
    }
  }
  else if fname == "Float::to_double" || fname == "Double::to_float" {
    ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
  }
  else if (fname == "Double::to_string" || fname == "Float::to_string") && !cc_single_name_shadowed(fname, local_names, ctx) {
    // #767: the same lowering `__to_string` takes for a statically-floatish
    // argument (see the __to_string branch above) — one call into the
    // runtime prelude (#2652) — just exposed under its documented qualified
    // name too.
    double_runtime_require(ctx.func_table, double_runtime_to_string_name())
    ce(buf, double_to_string_expr(Array::get(args, 0)), local_names, next_local, ctx, ld)
  }
  else if fname == "String::unicode_length" && Array::length(args) == 1 && !cc_single_name_shadowed(fname, local_names, ctx) {
    // #2630: the code-point view of a byte string -- one call into the
    // String length-view runtime prelude (string_views_runtime.vibe), the
    // lowering both lanes share (string_length_exprs.vibe). Guarded like
    // the other builtin arms: a program's own `fn String::unicode_length`
    // is that program's function, not this one (Codex review on #2708).
    string_views_runtime_require(ctx.func_table, string_views_runtime_unicode_name())
    ce(buf, string_unicode_length_expr(Array::get(args, 0)), local_names, next_local, ctx, ld)
  }
  else if fname == "String::utf16_length" && Array::length(args) == 1 && !cc_single_name_shadowed(fname, local_names, ctx) {
    string_views_runtime_require(ctx.func_table, string_views_runtime_utf16_name())
    ce(buf, string_utf16_length_expr(Array::get(args, 0)), local_names, next_local, ctx, ld)
  }
  else if fname == "String::utf8_length" && Array::length(args) == 1 && !cc_single_name_shadowed(fname, local_names, ctx) {
    // #2630: a String IS its UTF-8 bytes (ADR-0098), so the UTF-8 length is
    // the byte length.
    ce(buf, ECall(EIdent("String::length", -1), [Array::get(args, 0)], -1), local_names, next_local, ctx, ld)
  }
  else if fname == "Int::parse" {
    ce(buf, int_parse_expr(Array::get(args, 0)), local_names, next_local, ctx, ld)
  }
  else if fname == "Double::parse" && !cc_single_name_shadowed(fname, local_names, ctx) {
    double_runtime_require(ctx.func_table, double_runtime_parse_name())
    ce(buf, double_parse_expr(Array::get(args, 0)), local_names, next_local, ctx, ld)
  }
  else if fname == "Double::abs" || fname == "Double::floor" || fname == "Double::ceil" {
    let nl = emit_float_operand_bits(buf, Array::get(args, 0), local_names, next_local, ctx, ld, ce)
    emit_f64_reinterpret_i64(buf)
    if fname == "Double::abs" {
      emit_f64_abs(buf)
    } else if fname == "Double::floor" {
      emit_f64_floor(buf)
    } else {
      emit_f64_ceil(buf)
    }
    emit_i64_reinterpret_f64(buf)
    if ctx.enable_rc {
      Array::push(local_names, "__fop_bits")
      Array::push(local_names, "__fop_box")
      emit_box_float(buf, ctx, nl, nl + 1)
      nl + 2
    } else {
      nl
    }
  }
  else if fname == "Double::max" || fname == "Double::min" {
    let mut nl = emit_float_operand_bits(buf, Array::get(args, 0), local_names, next_local, ctx, ld, ce)
    emit_f64_reinterpret_i64(buf)
    nl = emit_float_operand_bits(buf, Array::get(args, 1), local_names, nl, ctx, ld, ce)
    emit_f64_reinterpret_i64(buf)
    if fname == "Double::max" {
      emit_f64_max(buf)
    } else {
      emit_f64_min(buf)
    }
    emit_i64_reinterpret_f64(buf)
    if ctx.enable_rc {
      Array::push(local_names, "__fminmax_bits")
      Array::push(local_names, "__fminmax_box")
      emit_box_float(buf, ctx, nl, nl + 1)
      nl + 2
    } else {
      nl
    }
  }
  else if fname == "Char::to_int" || fname == "Char::from_int" {
    // Char's runtime representation IS the (tagged) code point; both
    // conversions are identities. Char::from_int used to sneak through a
    // fallback path while Char::to_int died with "undefined variable
    // (local): Char::to_int @call" (bench/bench_char_conversion.vibe,
    // @vibe/builtin/char.vibe's lower/upper).
    ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "resume" {
    // ADR-0076 追記34 V2: the replay engine (memo region + tag-1 rethrow
    // this call used to compile to) is gone. Every lowering that keeps
    // `resume` meaningful rewrites it away before codegen (edp's
    // tail-resumptive dict members, scps's continuation calls), and
    // compile_expr_tail6 no longer compiles non-Error handler arms at
    // all -- so a `resume` reaching this point means an upstream pass
    // failed to consume its handle. Fail loudly instead of emitting a
    // write into a region that no longer exists.
    throw("internal: `resume` reached codegen -- its handle was neither migrated (evidence dict) nor CPS-transformed (suspend class), and the replay engine was removed (ADR-0076 追記34 V2)")
  } else {
    cc_compile_named_2(buf, callee, args, local_names, next_local, ctx, ld, ce, fname, fn_idx_in_list, resolved_name, local_idx_hint, prefer_bound_call, ctor_lookup_idx, compile_call_core_fn)
  }
}
