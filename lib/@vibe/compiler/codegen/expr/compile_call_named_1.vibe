fn rc_exit_result_is_name(e: Expr, name: String) -> Bool {
  match e {
    EIdent(result, _) => result == name,
    ELet(bound, value, tail, _) => bound != name && (if rc_exit_result_is_name(tail, bound) {
      rc_exit_result_is_name(value, name)
    } else {
      !rc_exit_mentions_name(value, name) && rc_exit_result_is_name(tail, name)
    }),
    ELetMut(bound, value, tail, _) => bound != name && !rc_exit_mentions_name(value, name) && rc_exit_result_is_name(tail, name),
    ELetRec(bound, value, tail) => bound != name && !rc_exit_mentions_name(value, name) && rc_exit_result_is_name(tail, name),
    ESeq(head, tail) => !rc_exit_mentions_name(head, name) && rc_exit_result_is_name(tail, name),
    EAssign(target, value, tail) => target != name && !rc_exit_mentions_name(value, name) && rc_exit_result_is_name(tail, name),
    EAssignOp(target, _, value, tail) => target != name && !rc_exit_mentions_name(value, name) && rc_exit_result_is_name(tail, name),
    _ => false
  }
}

export fn rc_exit_follow_value_source(e: Expr, sources: Array[(String, Expr)], limit: Int) -> Expr {
  match e {
    ECall(EIdent("__lambda_return_owned", off), args, _) => if off < 0 && Array::length(args) == 1 {
      rc_exit_follow_value_source(Array::get(args, 0), sources, limit)
    } else {
      e
    },
    EIdent(name, _) => {
      let mut i = limit - 1
      while i >= 0 {
        let row = Array::get(sources, i)
        if row.0 == name {
          return rc_exit_follow_value_source(row.1, sources, i)
        }
        i = i - 1
      }
      e
    },
    _ => e
  }
}

/// A recursive binder may be transferred on one return branch and abandoned
/// on the other. The planner merges their counts, so compare the returned
/// pointer with the binder only when the result is the binder or a known
/// passthrough of it. Result wrappers are followed only while their earlier
/// expressions cannot consume the binder.
export fn rc_exit_passthrough_rec_result(e: Expr, name: String, local_names: Array[String], shadowed: Array[String], ctx: CompileCtx) -> Bool {
  if array_contains_str(shadowed, name) {
    return false
  }
  match e {
    EIdent(n, _) => n == name,
    // Named owning-return normalization can wrap the branch's call before
    // this exit sees it. The marker preserves pointer identity.
    ECall(EIdent("__lambda_return_owned", off), args, _) => if off < 0 && Array::length(args) == 1 {
      rc_exit_passthrough_rec_result(Array::get(args, 0), name, local_names, shadowed, ctx)
    } else {
      false
    },
    ECall(EIdent(callee, _), args, _) => {
      if find_local_slot(local_names, callee) >= 0 {
        return false
      }
      for row in ctx.passthrough_ret_params {
        if row.0 == callee && row.1 < Array::length(args) {
          if rc_exit_passthrough_rec_result(Array::get(args, row.1), name, local_names, shadowed, ctx) {
            return true
          }
        }
      }
      false
    },
    ELet(bound, value, tail, _) => if bound == name {
      false
    } else if rc_exit_result_is_name(tail, bound) || rc_exit_passthrough_rec_result(tail, bound, local_names, shadowed, ctx) {
      rc_exit_passthrough_rec_result(value, name, local_names, shadowed, ctx)
    } else if rc_exit_mentions_name(value, name) {
      false
    } else {
      rc_exit_passthrough_rec_result(tail, name, local_names, shadowed, ctx)
    },
    ELetMut(bound, value, tail, _) => if bound == name || rc_exit_mentions_name(value, name) {
      false
    } else {
      rc_exit_passthrough_rec_result(tail, name, local_names, shadowed, ctx)
    },
    ESeq(head, tail) => !rc_exit_mentions_name(head, name) && rc_exit_passthrough_rec_result(tail, name, local_names, shadowed, ctx),
    EAssign(target, value, tail) => target != name && !rc_exit_mentions_name(value, name) && rc_exit_passthrough_rec_result(tail, name, local_names, shadowed, ctx),
    EAssignOp(target, _, value, tail) => target != name && !rc_exit_mentions_name(value, name) && rc_exit_passthrough_rec_result(tail, name, local_names, shadowed, ctx),
    EIf(cond, yes, no) => !rc_exit_mentions_name(cond, name) && rc_exit_passthrough_rec_result(yes, name, local_names, shadowed, ctx) && rc_exit_passthrough_rec_result(no, name, local_names, shadowed, ctx),
    EMatch(scrutinee, arms) => {
      if rc_exit_mentions_name(scrutinee, name) || Array::length(arms) == 0 {
        return false
      }
      for arm in arms {
        let arm_shadowed: Array[String] = []
        for bound in shadowed {
          Array::push(arm_shadowed, bound)
        }
        let _ = collect_pattern_bindings(arm.0, arm_shadowed)
        if !rc_exit_passthrough_rec_result(arm.1, name, local_names, arm_shadowed, ctx) {
          return false
        }
      }
      true
    },
    _ => false
  }
}

fn rc_exit_conditional_rec_transfer(e: Expr, name: String, local_names: Array[String], ctx: CompileCtx) -> Bool with Exception {
  match e {
    ECall(EIdent("__lambda_return_owned", off), args, _) => if off < 0 && Array::length(args) == 1 {
      rc_exit_conditional_rec_transfer(Array::get(args, 0), name, local_names, ctx)
    } else {
      false
    },
    ECall(EIdent(callee, _), args, _) => {
      if find_local_slot(local_names, callee) >= 0 {
        return false
      }
      for row in ctx.passthrough_ret_params {
        if row.0 == callee && row.1 < Array::length(args) {
          return rc_exit_conditional_rec_transfer(Array::get(args, row.1), name, local_names, ctx)
        }
      }
      // A helper with more than one parameter-returning exit has no single
      // passthrough source. Compare its actual result with the recursive
      // owner before deciding whether the exit may release that owner.
      for arg in args {
        if rc_exit_mentions_name(arg, name) {
          return true
        }
      }
      false
    },
    ELet(bound, value, tail, _) => bound != name && (if rc_exit_result_is_name(tail, bound) || rc_exit_passthrough_rec_result(tail, bound, local_names, [
    ], ctx) {
      rc_exit_conditional_rec_transfer(value, name, local_names, ctx)
    } else {
      !rc_exit_mentions_name(value, name) && rc_exit_conditional_rec_transfer(tail, name, local_names, ctx)
    }),
    ELetMut(bound, value, tail, _) => bound != name && (if rc_exit_result_is_name(tail, bound) || rc_exit_passthrough_rec_result(tail, bound, local_names, [
    ], ctx) {
      rc_exit_conditional_rec_transfer(value, name, local_names, ctx)
    } else {
      !rc_exit_mentions_name(value, name) && rc_exit_conditional_rec_transfer(tail, name, local_names, ctx)
    }),
    ELetRec(bound, value, tail) => bound != name && (if rc_exit_result_is_name(tail, bound) || rc_exit_passthrough_rec_result(tail, bound, local_names, [
    ], ctx) {
      rc_exit_conditional_rec_transfer(value, name, local_names, ctx)
    } else {
      !rc_exit_mentions_name(value, name) && rc_exit_conditional_rec_transfer(tail, name, local_names, ctx)
    }),
    ESeq(head, tail) => !rc_exit_mentions_name(head, name) && rc_exit_conditional_rec_transfer(tail, name, local_names, ctx),
    EAssign(target, value, tail) => target != name && !rc_exit_mentions_name(value, name) && rc_exit_conditional_rec_transfer(tail, name, local_names, ctx),
    EAssignOp(target, _, value, tail) => target != name && !rc_exit_mentions_name(value, name) && rc_exit_conditional_rec_transfer(tail, name, local_names, ctx),
    EIf(_, yes, no) => rc_exit_passthrough_rec_result(yes, name, local_names, [], ctx) && rc_exit_fresh_independent_closure(no, name, local_names, ctx, [
    ]) || rc_exit_passthrough_rec_result(no, name, local_names, [], ctx) && rc_exit_fresh_independent_closure(yes, name, local_names, ctx, [
    ]),
    EMatch(scrutinee, arms) => {
      let mut seen_rec = false
      let mut safe = Array::length(arms) > 0
      for arm in arms {
        let binds: Array[String] = []
        let _ = collect_pattern_bindings(arm.0, binds)
        if rc_exit_passthrough_rec_result(arm.1, name, local_names, binds, ctx) {
          seen_rec = true
        } else if !rc_exit_fresh_independent_closure(arm.1, name, local_names, ctx, if rc_exit_independent_pattern_source(scrutinee, name, local_names, ctx) {
          binds
        } else {
          []
        }) {
          safe = false
        }
      }
      safe && seen_rec
    },
    _ => false
  }
}

/// Does another binding in `[lo, len)` -- another local -- share entry `i`'s
/// name? (A `let` and its view pin are one binding, one local.)
fn rc_exit_name_shared(names: Array[String], info: Array[Int], lo: Int, i: Int) -> Bool {
  let n = Array::get(names, i)
  let local = Array::get(info, i * 3 + 1)
  let mut shared = false
  let mut k = lo
  while !shared && k < Array::length(names) {
    if k != i && Array::get(names, k) == n && Array::get(info, k * 3 + 1) != local {
      shared = true
    } else {
      ()
    }
    k = k + 1
  }
  shared
}

/// A break result that is either a recursive owner or a fresh closure already
/// has one owned reference on each path. The exit compares the stored pointer
/// with the recursive owner and releases only the unselected owner.
export fn rc_exit_break_result_owns_rec(value: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with Exception {
  if Array::length(ctx.rc_exit_state) < 3 || Array::get(ctx.rc_exit_state, 1) != 0 || Array::get(ctx.rc_exit_state, 2) != 0 {
    return false
  }
  let nlets = Array::length(ctx.rc_exit_lets)
  let inner = if nlets > 0 {
    Array::get(ctx.rc_exit_lets, nlets - 1)
  } else {
    ""
  }
  if !rc_exit_site_matches(ctx, Array::get(ctx.rc_exit_state, 0), 1, perceus_exit_fingerprint(EUnit), inner) {
    return false
  }
  let names = ctx.rc_exit_stack_names
  let info = ctx.rc_exit_stack_info
  let mut lo = 0
  let mut j = Array::length(names) - 1
  while j >= 0 {
    if Array::get(info, j * 3) == 100 {
      lo = j + 1
      j = 0 - 1
    } else {
      j = j - 1
    }
  }
  let mut i = lo
  while i < Array::length(names) {
    let name = Array::get(names, i)
    if Array::get(info, i * 3) == 6 && !rc_exit_name_shared(names, info, lo, i) && find_local_slot(local_names, name) == Array::get(info, i * 3 + 1) && rc_exit_conditional_rec_transfer(value, name, local_names, ctx) {
      return true
    }
    i = i + 1
  }
  false
}

/// #3141: release what an early exit leaves, right before the exit's own
/// transfer (`return`, `br`, `throw`); the operand, when there is one, is
/// already on the wasm stack and stays there (`rc_drop` returns nothing).
/// `kind` is the plan's exit kind: 0 return (the whole function), 1 break /
/// 2 continue (the innermost loop body), 3 throw (the innermost `handle`
/// body, else the whole function).
///
/// Each exit takes one ordinal, which must match the plan's `PaExitSite`
/// for it; the first mismatch disables every later exit of the function.
/// An owned binding releases what the plan's `PaExitDrop` row says it still
/// holds; a cell and a view pin, whose scope ends release them on every
/// path, release once. A name the operand may still read through is kept,
/// and so is a name two entries in range share, and so is an entry whose
/// name resolves to another local here (a pattern binder or `for` element
/// shadowing it): the plan's row for that name describes the shadowing
/// binding, not this one.
///
/// The operand is not the only value an exit hands on: an assignment it
/// follows (`rc_exit_note_store`) may have put a view of a binding the exit
/// leaves into a slot that outlives it -- `break v` of a parameterized loop
/// is `__loop_result = v; break`, and `continue(a)` assigns the loop's
/// parameters. Those values are held to the operand's test too.
export fn rc_exit_release(buf: Bytes, ctx: CompileCtx, local_names: Array[String], kind: Int, operand: Expr, result_local: Int) -> Unit with Exception {
  if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && Array::length(ctx.rc_exit_state) >= 3 {
    let mut exit_result = (result_local, operand)
    if kind == 1 {
      let mut ri = Array::length(ctx.rc_exit_result_stores) - 1
      while ri >= 0 {
        let row = Array::get(ctx.rc_exit_result_stores, ri)
        if row.0 == "__loop_result" || (String::starts_with(row.0, "__shadow_") && String::ends_with(row.0, "___loop_result")) {
          exit_result = (find_local_slot(local_names, row.0), row.1)
          ri = 0 - 1
        } else {
          ri = ri - 1
        }
      }
    } else if kind == 0 || kind == 3 {
      exit_result = (result_local, rc_exit_follow_value_source(operand, ctx.rc_exit_result_stores, Array::length(ctx.rc_exit_result_stores)))
    }
    let ord = Array::get(ctx.rc_exit_state, 0)
    Array::set(ctx.rc_exit_state, 0, ord + 1)
    let nlets = Array::length(ctx.rc_exit_lets)
    let inner = if nlets > 0 {
      Array::get(ctx.rc_exit_lets, nlets - 1)
    } else {
      ""
    }
    if Array::get(ctx.rc_exit_state, 1) != 0 {
      ()
    } else if !rc_exit_site_matches(ctx, ord, kind, perceus_exit_fingerprint(operand), inner) {
      Array::set(ctx.rc_exit_state, 1, 1)
    } else {
      let keep: Array[String] = []
      let mut ki = 0
      while ki < Array::length(ctx.rc_exit_keep) {
        Array::push(keep, Array::get(ctx.rc_exit_keep, ki))
        ki = ki + 1
      }
      // A branch-local fresh closure can make the general operand walk fail.
      // Keep that conservative result for other owners; the direct recursive
      // closure comparison below is safe independently of those owners.
      let operand_ok = rc_exit_operand_ok(operand, local_names, ctx, keep)
      if Array::get(ctx.rc_exit_state, 2) == 0 {
        let names = ctx.rc_exit_stack_names
        let info = ctx.rc_exit_stack_info
        // The range the exit leaves: down to the boundary it stops at. A
        // `break` / `continue` outside every loop body releases nothing.
        let mut lo = 0
        let mut bounded = kind == 0 || kind == 3
        let mut j = Array::length(names) - 1
        while j >= 0 {
          let ek = Array::get(info, j * 3)
          if (kind == 1 || kind == 2) && ek == 100 {
            lo = j + 1
            bounded = true
            j = 0 - 1
          } else if kind == 3 && ek == 101 {
            lo = j + 1
            j = 0 - 1
          } else {
            j = j - 1
          }
        }
        if bounded {
          let mut i = Array::length(names) - 1
          while i >= lo {
            let n = Array::get(names, i)
            let ek = Array::get(info, i * 3)
            let local = Array::get(info, i * 3 + 1)
            let flag = Array::get(info, i * 3 + 2)
            let conditional_rec = exit_result.0 >= 0 && ek == 6 && !rc_exit_name_shared(names, info, lo, i) && find_local_slot(local_names, n) == local && rc_exit_conditional_rec_transfer(exit_result.1, n, local_names, ctx)
            let count = if conditional_rec {
              1
            } else if !operand_ok || ek >= 100 || array_contains_str(keep, n) || rc_exit_name_shared(names, info, lo, i) || find_local_slot(local_names, n) != local {
              0
            } else if ek == 4 || ek == 5 {
              1
            } else {
              let planned = rc_exit_plan_count(ctx, ord, n)
              if planned < 0 {
                // #3175: a split binding's row -- release once, and only
                // under the path flag its scope-end drop is guarded on. With
                // no such flag the path that consumed it would release it
                // again, so the exit releases nothing.
                if ek == 0 && flag >= 0 && rc_exit_is_path_flag(ctx, flag) {
                  1
                } else {
                  0
                }
              } else if ek == 2 {
                planned - 1
              } else if ek == 6 && planned > 1 {
                // A local recursive binder owns one closure reference. The
                // weak self edge cannot add another release at this exit.
                1
              } else {
                planned
              }
            }
            if count > 0 {
              if conditional_rec {
                emit_local_get(buf, exit_result.0)
                emit_local_get(buf, local)
                emit_i64_ne(buf)
                emit_if_void(buf)
              } else if flag >= 0 {
                emit_local_get(buf, flag)
                emit_i64_eqz(buf)
                emit_if_void(buf)
              } else {
                ()
              }
              let mut c = 0
              while c < count {
                emit_local_get(buf, local)
                if ek == 4 {
                  // A cell's local holds the even payload address; the
                  // block's references are the odd-tagged pointer (see the
                  // ELetMut scope end).
                  emit_i64_const(buf, 1)
                  emit_i64_or(buf)
                } else {
                  ()
                }
                emit_call(buf, ctx.rc_drop_func_idx)
                c = c + 1
              }
              if conditional_rec || flag >= 0 {
                emit_end(buf)
              } else {
                ()
              }
            } else {
              ()
            }
            i = i - 1
          }
        } else {
          ()
        }
      } else {
        ()
      }
    }
  } else {
    ()
  }
}

/// #3141: an assignment `x = value` is about to compile its continuation,
/// where an early exit may still come. If `value` is a view of a binding
/// such an exit leaves, the slot `x` holds it past the release -- `break v`
/// of a parameterized loop is `__loop_result = v; break`, and `__loop_result`
/// is a plain local that neither retains what it stores nor releases it.
/// So the value is held to the exit operand's test (`rc_exit_operand_ok`),
/// evaluated here, where its names still resolve to what the store read:
/// what it keeps is kept by every exit in the continuation, and a value it
/// cannot place makes every one of them release nothing. The caller skips
/// a store that retained its value. Returns the token `rc_exit_end_store`
/// takes once the continuation is compiled.
export fn rc_exit_note_store(ctx: CompileCtx, local_names: Array[String], value: Expr) -> Int with Exception {
  if ctx.enable_rc && Array::length(ctx.rc_exit_state) >= 3 {
    let mark = Array::length(ctx.rc_exit_keep)
    let keep: Array[String] = []
    let ok = rc_exit_operand_ok(value, local_names, ctx, keep)
    let mut i = 0
    while i < Array::length(keep) {
      Array::push(ctx.rc_exit_keep, Array::get(keep, i))
      i = i + 1
    }
    if ok {
      mark * 2
    } else {
      Array::set(ctx.rc_exit_state, 2, Array::get(ctx.rc_exit_state, 2) + 1)
      mark * 2 + 1
    }
  } else {
    0 - 1
  }
}

/// #3141: the continuation of the store `token` came from is compiled; its
/// value no longer constrains the exits that follow.
export fn rc_exit_end_store(ctx: CompileCtx, token: Int) -> Unit {
  if token >= 0 {
    Array::truncate(ctx.rc_exit_keep, token / 2)
    if token % 2 == 1 {
      Array::set(ctx.rc_exit_state, 2, Array::get(ctx.rc_exit_state, 2) - 1)
    } else {
      ()
    }
  } else {
    ()
  }
}

/// #3141: does a `let mut` initialized with `value` hold a reference of its
/// own, by the exit operand's test? Only then may an exit release the slot.
export fn rc_exit_value_owned(ctx: CompileCtx, local_names: Array[String], value: Expr) -> Bool with Exception {
  let keep: Array[String] = []
  rc_exit_operand_ok(value, local_names, ctx, keep) && Array::length(keep) == 0
}

// Ordered named-call dispatch group.
export fn cc_compile_named_1(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception, fname: String, fn_idx_in_list: Int, resolved_name: String, local_idx_hint: Int, prefer_bound_call: Bool, ctor_lookup_idx: Int, compile_call_core_fn: (Bytes, Expr, Array[Expr], Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception) -> Int with Exception {
  if ctor_lookup_idx >= 0 {
    let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)
    let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)
    let ptr_local = next_local
    Array::push(local_names, "__ctor_ptr")
    let actual_args = if Array::length(args) == 1 {
      match Array::get(args, 0) {
        ERecord(_, rec_fields, _) => {
          let mut si2 = 0
          let mut sn_idx = -1
          while si2 < Array::length(ctx.ctor_table.struct_names) {
            if Array::get(ctx.ctor_table.struct_names, si2) == fname {
              sn_idx = si2
              si2 = Array::length(ctx.ctor_table.struct_names)
            } else {
              si2 = si2 + 1
            }
          }
          if sn_idx >= 0 {
            let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)
            let ordered = array_empty()
            let mut oi = 0
            while oi < Array::length(def_fnames) {
              let target_name = Array::get(def_fnames, oi)
              let mut ri = 0
              let mut found_rfv = EUnit
              while ri < Array::length(rec_fields) {
                let (rfn, rfv) = Array::get(rec_fields, ri)
                if rfn == target_name {
                  found_rfv = rfv
                  ri = Array::length(rec_fields)
                } else {
                  ri = ri + 1
                }
              }
              Array::push(ordered, found_rfv)
              oi = oi + 1
            }
            ordered
          } else {
            args
          }
        },
        _ => args
      }
    } else {
      args
    }
    if ctx.enable_rc {
      let total = 16 + fc * 8
      // ADR-0092 / #2389 (plan-guided wide reuse): while a same-size
      // token is armed (compile_match staged the unique scrutinee block
      // of an enclosing rebuild arm), allocate from it. The innermost
      // token of this field count is taken: an outer arm's token is a
      // valid same-size block too (that arm is still running, its block
      // claimed and idle), so a site inside a nested fused arm of another
      // arity still reuses. The token local is 0 on the shared path and
      // after an earlier site consumed it; either way the fresh branch
      // below is byte-identical to the unarmed emission, and a reused
      // block only needs the tag/arity rewrite -- its size, rc word, and
      // class byte are already exactly a fresh same-size block's.
      let mut __rt_top = Array::length(ctx.reuse_tok_locals) - 1
      while __rt_top >= 0 && Array::get(ctx.reuse_tok_arities, __rt_top) != fc {
        __rt_top = __rt_top - 1
      }
      let __rt_use = __rt_top >= 0
      if __rt_use {
        Array::set(ctx.reuse_tok_emitted, __rt_top, Array::get(ctx.reuse_tok_emitted, __rt_top) + 1)
        let __rt_tok = Array::get(ctx.reuse_tok_locals, __rt_top)
        emit_local_get(buf, __rt_tok)
        emit_i64_eqz(buf)
        emit_if_void(buf)
        emit_i64_const(buf, total)
        emit_call(buf, ctx.rc_alloc_func_idx)
        emit_local_set(buf, ptr_local)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, total)
        emit_i32_store(buf, 2, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 1)
        emit_i32_store(buf, 2, 4)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 1)
        emit_i32_store8(buf, 0, 7)
        emit_else(buf)
        emit_local_get(buf, __rt_tok)
        emit_local_set(buf, ptr_local)
        emit_i64_const(buf, 0)
        emit_local_set(buf, __rt_tok)
        emit_end(buf)
      } else {
        emit_i64_const(buf, total)
        emit_call(buf, ctx.rc_alloc_func_idx)
        emit_local_set(buf, ptr_local)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, total)
        emit_i32_store(buf, 2, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 1)
        emit_i32_store(buf, 2, 4)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 1)
        emit_i32_store8(buf, 0, 7)
      }
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, tag)
      emit_i32_store(buf, 2, 8)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, fc)
      emit_i32_store(buf, 2, 12)
      let mut nl_c = next_local + 1
      let mut fi_c = 0
      while fi_c < Array::length(actual_args) {
        let carg_c = Array::get(actual_args, fi_c)
        nl_c = ce(buf, carg_c, local_names, nl_c, ctx, ld)
        let val_local = nl_c
        Array::push(local_names, "__ctor_val")
        emit_local_set(buf, val_local)
        nl_c = nl_c + 1
        // A heap field projection `a.f` stored into a constructor is a borrow;
        // the constructed value OWNS its fields (drop class 1 recurses), so
        // retain it or the source's drop double-frees it (e.g. `Some(b.items)`
        // returned while `b` is dropped). Mirrors the ERecord field-store dup
        // (#704). Perceus emits no action for bare projections.
        // #715: also retain a bare-ident arg whose binding is borrow-bound or
        // loop-borrowed (cc_is_loop_borrowed_ident) -- same gap as the ETuple
        // case in compile_expr_tail2.vibe (see the comment there).
        if ctx.enable_rc && (cc_is_projection(carg_c) || cc_is_ref_cell_read(carg_c, ctx) || cc_is_borrow_ret_call(carg_c, ctx) || cc_is_loop_borrowed_ident(carg_c, ctx)) {
          emit_rc_dup_guarded(buf, val_local, ctx.rc_shadow, ctx.rc_dup_func_idx)
        } else {
          ()
        }
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, val_local)
        emit_i64_store(buf, 3, 16 + fi_c * 8)
        fi_c = fi_c + 1
      }
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 8)
      emit_i64_add(buf)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
      nl_c
    } else {
      let obj_size = 8 + fc * 8
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, ptr_local)
      emit_global_get(buf, 0)
      emit_i32_const(buf, obj_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_grow_after_heap_set(buf, ctx)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, tag)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, fc)
      emit_i32_store(buf, 2, 4)
      let mut nl_c = next_local + 1
      let mut fi_c = 0
      while fi_c < Array::length(actual_args) {
        nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ctx, ld)
        let val_local = nl_c
        Array::push(local_names, "__ctor_val")
        emit_local_set(buf, val_local)
        nl_c = nl_c + 1
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, val_local)
        emit_i64_store(buf, 3, 8 + fi_c * 8)
        fi_c = fi_c + 1
      }
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
      nl_c
    }
  }
  else if !cc_ladder_tests_name(fname) || cc_source_defines_borrow_builtin(ctx, fname, fn_idx_in_list) {
    // #2386: no arm below tests this callee (cc_ladder_names holds every
    // name they compare against), so only the resolved-call fallback can
    // apply; take it without the ~150 compares.
    // #3128: nor may an arm fire for a borrowing builtin the program
    // defines itself. The planner already reads that definition's own
    // ownership (compute_borrow_param_user_fns keeps its row), so an
    // inlined `Map::size` / `Map::get` / `StringBuilder::push` ... would
    // both ignore the program's function and leak the reference the call
    // site now hands over.
    cc_compile_resolved_call(buf, resolved_name, args, local_names, next_local, ctx, ld, ce, fn_idx_in_list, local_idx_hint)
  }
  else if fname == "eq" && Array::length(args) == 2 && local_idx_hint < 0 && (cc_expr_is_floatish(Array::get(args, 0), local_names, ctx) || cc_expr_is_floatish(Array::get(args, 1), local_names, ctx)) && func_table_user_index_of(ctx.func_table, fname, ctx.num_user_funcs) < 0 {
    // #745: under RC floats are BOXED — the scalar i64.eq below would
    // compare box pointers, so `eq(0.0125, 0.0125)` returned false. Take
    // the same unbox + f64.eq path the `==` binop uses.
    //
    // #2426: this arm was RC-only, and its reason was explicitly "non-RC
    // floats are raw f64 bits, where bitwise i64.eq matches the existing
    // `==` behavior". That justification is gone: `==` now takes a real
    // f64 comparison on every lane, so keeping `eq` on raw bits under
    // non-RC would make the two spellings of ONE concept disagree --
    // measured on `VIBE_RC=0` before this change, `eq(0.0, -0.0)` was
    // false while `0.0 == -0.0` was true, and `eq(nan, nan)` was true
    // while `nan == nan` was false. The unbox and the Bool tag below are
    // the only RC-specific steps, so both are guarded instead.
    //
    // #2309: `local_idx_hint < 0` for the same reason as the scalar arm
    // below -- and this arm had NO guard at all, so it was the sharper of
    // the two: `let eq = (a: Double, b: Double) -> Double { a + b }` then
    // `eq(1.5, 2.5)` printed `0` under RC, which is the production lane.
    let mut nl = emit_float_operand_bits(buf, Array::get(args, 0), local_names, next_local, ctx, ld, ce)
    emit_f64_reinterpret_i64(buf)
    nl = emit_float_operand_bits(buf, Array::get(args, 1), local_names, nl, ctx, ld, ce)
    emit_f64_reinterpret_i64(buf)
    emit_f64_eq(buf)
    emit_i64_extend_i32_s(buf)
    // Tag the Bool like the scalar branch below (ADR-0055). Untagged lanes
    // hold a Bool as a raw 0/1, so the shift is RC-only.
    if ctx.enable_rc {
      emit_i64_const(buf, 1)
      emit_i64_shl(buf)
    }
    nl
  }
  else if fname == "eq" && Array::length(args) == 2 && local_idx_hint < 0 && (!prefer_bound_call || cc_arg_is_scalarish(Array::get(args, 0), local_names, ctx) || cc_arg_is_scalarish(Array::get(args, 1), local_names, ctx)) && func_table_user_index_of(ctx.func_table, fname, ctx.num_user_funcs) < 0 {
    // Direct i64.eq for `eq(a, b)` when it is the builtin and at least one
    // operand is provably scalar. This sidesteps the bound `eq`'s string
    // fallback, which reads OOB on Int values resembling fat-pointers (#705):
    // `==` already dispatches intish operands this way via emit_eq_value, and
    // `eq` must match. A genuinely string/heap `eq` (no scalar operand) still
    // falls through to the bound call below.
    //
    // #710/#711: keeping the scalarish disjunct (not just !prefer_bound_call)
    // is required -- prefer_bound_call is a global cross-file name match, not
    // scoped to the calling file (see #711), so dropping it regressed
    // leb128_test.vibe. Root fix tracked in #711.
    //
    // #2309: but that disjunct let the builtin beat a LEXICAL binding too,
    // and there it is simply wrong: `let eq = (a: Int, b: Int) -> Int { a + b }`
    // then `eq(1, 2)` compiled to `i64.eq` and printed `0`. No diagnostic,
    // no trap -- the checker had already typed the call against the user's
    // `eq` and agreed it was an `Int`.
    //
    // `local_idx_hint < 0` splits the two readings of `prefer_bound_call`
    // apart. `fn_idx_in_list` is the over-broad half #711 is about (a name
    // match against the whole program's function table, not the calling
    // file), and it is still consulted exactly as before -- leb128_test.vibe
    // keeps taking the inline path. `local_idx_hint` is a lexical binding in
    // THIS closure's local names, which is unambiguous, so it wins.
    //
    // That covers a LEXICAL binding only. A top-level `fn eq(a: Int, b: Int)
    // -> Int { a + b }` leaves `local_idx_hint` at -1, so `eq(1, 2)` still
    // printed `0` (Codex review on #2312). `fn_idx_in_list` cannot decide it
    // either: `eq` is in the linear func table unconditionally, so that index
    // is >= 0 for EVERY call whether or not anyone defined one -- which is
    // precisely why the scalarish disjunct had to exist.
    //
    // `func_table_user_index_of` is the missing distinction, and it is the
    // one #711 asks for: a definition belonging to THIS program, told from a
    // generated builtin positionally (user entries are the table's prefix)
    // rather than by name. Last in the condition so the scan runs only when
    // the arm would otherwise claim the call.
    //
    // Reading `local_idx_hint` at all is only sound for a name the capture
    // scan cannot invent (#1095, and see the `assert` arms below). `eq` is
    // in the LINEAR and gc func tables unconditionally
    // (core/builtin_registry.vibe), so `collect_free_vars_expr_sc`'s
    // `fn_names` guard skips it and no lambda records a phantom capture for
    // it. That is why it needs no `is_inlined_scalar_builtin` registration.
    let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
    emit_i64_eq(buf)
    emit_i64_extend_i32_s(buf)
    // ADR-0055: under RC a Bool is a TAGGED scalar (true = 1<<1). The raw
    // i64.eq result is 0/1 (untagged); tag it so `eq(..) == true`/`if`/derived
    // comparisons see the same representation as a bool literal (#705 — without
    // this, `eq(a,b) == true` compared untagged 1 against tagged 2 and failed).
    // The bump backend leaves bools untagged, so only shift under RC.
    if ctx.enable_rc {
      emit_i64_const(buf, 1)
      emit_i64_shl(buf)
    } else {
      ()
    }
    nl
  }
  else if Array::length(args) == 1 && (cc_expr_is_floatish(Array::get(args, 0), local_names, ctx) || cc_expr_is_boolish(Array::get(args, 0), local_names, ctx) || cc_expr_is_stringish(Array::get(args, 0), local_names, ctx)) && fname == namespace_exported_name("lib/@vibe/builtin/builtin_traits.vibe", "to_string") {
    // #1015: the prelude generic wrapper `to_string[T: Show](x: T) -> String
    // { __to_string(x) }` (lib/@vibe/builtin/builtin_traits.vibe) compiles
    // to exactly ONE shared wasm function body -- there is no
    // monomorphization pass that duplicates a generic function body per
    // instantiation. Inside that body `x` is a bare parameter of the
    // opaque type param T, so the `__to_string` builtin lowering below --
    // which classifies its argument via the syntactic cc_expr_is_floatish/
    // boolish/stringish checks -- can never recognize `x` as Bool/Float/
    // String there; it always falls to the generic runtime bit-pattern
    // heuristic. `Show` is a marker-only trait (never declared with method
    // signatures, so #641's dictionary-passing desugar -- which only
    // handles method-bearing traits -- never synthesizes a runtime witness
    // for it) and Bool has NO runtime tag distinguishing it from Int:
    // `true`/`false` compile to raw i64 1/0 (linear) or tagged 2/0 (RC),
    // bit-identical to Int 1/0 in both backends. So the runtime heuristic
    // cannot possibly classify a Bool argument reached this way -- it
    // silently mis-stringifies `true` as `"1"` (confirmed via a standalone
    // repro: the generic fallback itself does not crash for input 0/1, it
    // just returns the wrong string; the reported "RuntimeError:
    // unreachable" is `assert(to_string(true) == "true")` failing on that
    // wrong value and THEN trapping).
    //
    // Fix: at the CALL SITE `to_string(arg)`, the ORIGINAL argument
    // expression is still visible (unlike inside the generic body), so
    // when it is statically classifiable by the same cc_expr_is_* checks
    // the `__to_string` builtin uses, bypass the generic `to_string`
    // function call entirely and inline it as `__to_string(arg)` directly
    // -- hitting the correct existing static fast path. This is purely
    // additive: a call whose argument is NOT statically classifiable
    // (e.g. forwarding another opaque generic parameter) still falls
    // through unchanged to the ordinary bound call below.
    //
    // `fname` is essentially NEVER the bare `"to_string"` at this point:
    // #716 export-name visibility renames every exported value def of a
    // non-entry file to `name_exp_<sanitized path>` (namespace_exported_name,
    // lib/@vibe/compiler/core/import_alias_rewrite.vibe) and rewrites every
    // importer's reference to match, so a call to the prelude's `to_string`
    // (defined in lib/@vibe/builtin/builtin_traits.vibe, a non-entry file)
    // arrives here as `to_string_exp_lib__vibe_prelude_builtin_traits_vibe`
    // -- verified with throw()-based instrumentation. A prior fix attempt
    // for this issue special-cased only the bare name (fname equal to the
    // plain string "to_string") and was silently dead code because it
    // never fired for this reason.
    //
    // This match is intentionally the EXACT mangled name (via
    // `namespace_exported_name` -- the SAME function the renaming pass
    // itself uses, not a hand-copied string literal), not a bare-name or
    // prefix match: an earlier version of this fix matched fname against
    // either the bare "to_string" or, via String::starts_with, anything
    // prefixed "to_string_exp_", which was unsound -- code review (#1015)
    // correctly pointed out that
    // (a) the bare form also matches a user's OWN `to_string` defined
    // directly in an entry file (never renamed, so indistinguishable from
    // the prelude's by name alone), and (b) the prefix form also matches
    // ANY other file's own exported `to_string` (e.g. a user module
    // exporting `to_string`, mangled to `to_string_exp_<that file's own
    // sanitized path>`), silently overriding either user function's real
    // behavior with the Bool/Float/String formatter. The exact mangled
    // name embeds the full defining-file path, so it can only ever refer
    // to THIS specific prelude definition. Guarding with `!prefer_bound_call`
    // instead (as sibling `not`/`eq` branches above do) does NOT work here
    // and was tried and rejected: unlike `not`/`eq`, which are pure
    // compiler-provided fallbacks with no real backing definition unless a
    // user shadows them, `to_string` ALWAYS resolves to a real declared
    // function (the prelude's own, if nothing else) -- so `prefer_bound_call`
    // is unconditionally true even for the correct, un-shadowed prelude
    // call (confirmed with throw()-based instrumentation: `prefer_bound_call
    // = T` at the real failing call site), and gating on `!prefer_bound_call`
    // would make this branch never fire at all.
    //
    // Condition order matters here (selfcompile KPI heap regression found
    // during review): `namespace_exported_name(...)` builds a fresh string
    // via StringBuilder on every call, and this bump-allocated compiler
    // never reclaims that memory mid-compile, so evaluating it FIRST --
    // as the original version of this branch did -- ran it once per
    // ECall node in the ENTIRE compiled program (this `else if` chain is
    // walked for every function call), not just once per `to_string`
    // call. `&&` short-circuits (desugars to `if`, see docs/user/reference/cheatsheet.md),
    // so putting the cheap arity check and the shape-based
    // floatish/boolish/stringish classification first means the
    // allocating name comparison only runs for the rare 1-arg calls whose
    // argument is already known-classifiable -- functionally identical
    // result, far fewer StringBuilder allocations across a whole compile.
    ce(buf, ECall(EIdent("__to_string", -1), [Array::get(args, 0)], -1), local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "not" {
    let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    emit_i64_eqz(buf)
    emit_i64_extend_i32_s(buf)
    if ctx.enable_rc {
      emit_i64_const(buf, 1)
      emit_i64_shl(buf)
    } else {
      ()
    }
    nl
  }
  else if fname == "Double::from_i64_bits" {
    // The linear value ABI carries Double as raw f64 bits in an i64 (boxed
    // under RC). This builtin is therefore an inline representation
    // conversion, not a function-table call. Keeping it inline also means a
    // closure body cannot accidentally capture and call a nonexistent
    // first-class builtin slot (#1805).
    let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    if ctx.enable_rc {
      emit_i64_const(buf, 1)
      emit_i64_shr_s(buf)
      Array::push(local_names, "__from_bits_raw")
      Array::push(local_names, "__from_bits_box")
      emit_box_float(buf, ctx, nl, nl + 1)
      nl + 2
    } else {
      nl
    }
  }
  else if !prefer_bound_call && fname == "await" {
    // M1b-3b (docs/internal/design/wasi-p3-async.md): a `Future[T]` is the two-element
    // array `[state, payload]` (future_state_ready() = 0), so awaiting a
    // ready future reads slot 1. The state slot exists so a PENDING future
    // (a suspending source: host async import, spawned subtask) can be told
    // apart here without changing the representation again -- lowering that
    // arm to a suspend is M1b-3c.
    ce(buf, ECall(EIdent("Array::get", -1), [Array::get(args, 0), EInt(1)], -1), local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "Future::ready" {
    // Future::ready(x) is the already-resolved future carrying x. See the
    // `await` branch above for the representation.
    ce(buf, future_ready_expr(Array::get(args, 0)), local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "Future::pending" {
    // #1230: an UNRESOLVED future -- state 1, payload slot reserved. The
    // await hoist (await_poll_pass) sees a non-zero state and suspends with
    // the poll-wait reason until someone calls Future::resolve on this same
    // array, so the producer decides when it completes.
    ce(buf, EArray([EInt(1), EInt(0)]), local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "host_future_get" {
    // ADR-0089 step 4 (#1218): a HOST-supplied future -- state 2 (the
    // waitable state), payload = the host future handle. vibe_hf_get_raw
    // lowers to the `vibe.host_future_get` import, which only the
    // component adapter module provides (spec §3.13/§3.14): it
    // async-lowers the component-level `get-future` import (eagerly --
    // pair creation never suspends) and hands back the readable end's
    // handle. Awaiting this cell parks with the reserved waitable payload
    // (handle + 2, __aw_poll's waitable arm) until the entry boundary
    // settles it via waitable-set.wait.
    let no_args = Array::slice([EInt(0)], 0, 0)
    ce(buf, EArray([
      EInt(2),
      ECall(EIdent("vibe_hf_get_raw", -1), no_args, -1)
    ]), local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "host_future_named" {
    // ADR-0089 (c) (#1218): the SAME cell shape as host_future_get -- state
    // 2 (waitable), payload = the host future handle -- but the handle
    // comes from a per-NAME raw builtin, so a program can hold several
    // distinct host futures at once. `vibe_hf_get_raw$<name>` lowers to
    // the `vibe.host_future_get$<name>` core import, which the component
    // adapter satisfies from the component-level `<name>: func() ->
    // future<u32>` import (spec §3.16).
    //
    // The name must be a STRING LITERAL: it is an import name, decided at
    // compile time, not a value. Anything else is a hard error here rather
    // than a mysterious missing import later.
    let name_arg = Array::get(args, 0)
    let hf_name = match name_arg {
      EString(s, _) => s,
      _ => throw("host_future_named: the import name must be a string literal (it becomes a component import name, so it is fixed at compile time)")
    }
    if !cc_is_valid_host_future_name(hf_name) && !cc_is_wit_future_address(hf_name) {
      throw("host_future_named: invalid import name '\{hf_name}' -- must be lower kebab-case ([a-z][a-z0-9-]*), the component-model label shape, or a WIT function address like 'example:prices/api@1.0.0#get-price'")
    } else {
      ()
    }
    let named_no_args = Array::slice([EInt(0)], 0, 0)
    ce(buf, EArray([
      EInt(2),
      ECall(EIdent(String::concat(cc_host_future_named_raw_prefix(), hf_name), -1), named_no_args, -1)
    ]), local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "host_response_named" {
    // #2066: the host_future_named cell over a WIT RESPONSE. The raw getter
    // is the named-future one with a `!` in front of the address, which
    // linked_compile reads back as "this is a response" and imports as
    // `vibe.wit_response_get$<address>`; the wait half is shared.
    let hr_name_arg = Array::get(args, 0)
    let hr_name = match hr_name_arg {
      EString(s, _) => s,
      _ => throw("host_response_named: the WIT function address must be a string literal (it becomes a component import, so it is fixed at compile time)")
    }
    if !cc_is_wit_future_address(hr_name) {
      throw("host_response_named: invalid address '\{hr_name}' -- must be a WIT function address like 'example:http/client@1.0.0#fetch'")
    } else {
      ()
    }
    let hr_no_args = Array::slice([EInt(0)], 0, 0)
    ce(buf, EArray([
      EInt(2),
      ECall(EIdent(String::concat(cc_host_future_named_raw_prefix(), String::concat("!", hr_name)), -1), hr_no_args, -1)
    ]), local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "host_response_named_with" {
    // #2066: a WIT response whose function takes one `string` (the
    // request's URL, say). The adapter cannot read the guest's memory, so
    // the argument crosses a byte at a time into the adapter's argument
    // buffer (`vibe_hf_arg_push_raw`, the `vibe.host_arg_push` import) and
    // the getter lowers that buffer as the string parameter. The `!?`
    // marker tells linked_compile to import the getter as
    // `vibe.wit_response_arg_get$<address>`.
    let hra_name = match Array::get(args, 0) {
      EString(s, _) => s,
      _ => throw("host_response_named_with: the WIT function address must be a string literal (it becomes a component import, so it is fixed at compile time)")
    }
    // `<address>?<label>`: the parameter's WIT label rides the address so
    // the composer declares the function exactly as the WIT does.
    let hra_q = String::index_of(hra_name, "?")
    let hra_ok = hra_q > 0 && cc_is_wit_future_address(String::substring(hra_name, 0, hra_q)) && cc_is_valid_host_future_name(String::substring(hra_name, hra_q + 1, String::length(hra_name)))
    if !hra_ok {
      throw("host_response_named_with: invalid address '\{hra_name}' -- must be a WIT function address and its parameter label, like 'example:http/client@1.0.0#fetch?url'")
    } else {
      ()
    }
    let hra_push = ESeq(ECall(EIdent("vibe_hf_arg_push_raw", -1), [
      ECall(EIdent("String::char_code_at", -1), [
        EIdent("__hra_s", -1),
        EIdent("__hra_i", -1)
      ], -1)
    ], -1), EAssign("__hra_i", ECall(EIdent("add", -1), [
      EIdent("__hra_i", -1),
      EInt(1)
    ], -1), EUnit))
    let hra_no_args = Array::slice([EInt(0)], 0, 0)
    let hra_get = EArray([
      EInt(2),
      ECall(EIdent(String::concat(cc_host_future_named_raw_prefix(), String::concat("!?", hra_name)), -1), hra_no_args, -1)
    ])
    let hra_cond = ECall(EIdent("lt", -1), [
      EIdent("__hra_i", -1),
      ECall(EIdent("String::length", -1), [EIdent("__hra_s", -1)], -1)
    ], -1)
    let hra_loop = ELetMut("__hra_i", EInt(0), ESeq(EWhile(hra_cond, hra_push), hra_get), -1)
    // review-lint: allow-fixed-synthetic-name
    let hra_synth = ELet("__hra_s", Array::get(args, 1), hra_loop, -1)
    // review-lint: allow-fixed-synthetic-name
    ce(buf, hra_synth, local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "HostResponse::status" {
    // #2066: a response is `(status << 32) | body` -- the record's flat
    // lowering in one scalar (the component adapter packs it).
    ce(buf, EBinOp(">>", Array::get(args, 0), EInt(32), -1), local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "HostResponse::body" {
    // The body's readable end as a host-stream cell (state 3). The low half
    // is `handle | generation << 10`; the adapter's claim answers the
    // handle once per response and traps on a second claim or a stale
    // generation, so a body has one reader however the response was shared.
    ce(buf, EArray([
      EInt(3),
      ECall(EIdent("vibe_hs_claim_raw", -1), [
        EBinOp("&", Array::get(args, 0), EInt(4294967295), -1)
      ], -1)
    ]), local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "host_stream_named" {
    // ADR-0089 Decision 3 (#1218): a NAMED host stream -- state 3 (the
    // host-stream state, distinct from every future cell state so a
    // future cell can never be read as a stream or vice versa), payload =
    // the readable end's handle. `vibe_hs_get_raw$<name>` lowers to the
    // `vibe.host_stream_get$<name>` core import, which the component
    // adapter satisfies from the component-level `<name>: func() ->
    // stream<u8>` import (spec §3.18). Same literal/label rules as
    // host_future_named: the name is an import name, fixed at compile
    // time.
    let hs_name_arg = Array::get(args, 0)
    let hs_name = match hs_name_arg {
      EString(s, _) => s,
      _ => throw("host_stream_named: the import name must be a string literal (it becomes a component import name, so it is fixed at compile time)")
    }
    if hs_name == "stdin" {
      throw("host_stream_named(\"stdin\") is reserved; use Stdin::read_via_stream()")
    } else if !cc_is_valid_host_future_name(hs_name) {
      throw("host_stream_named: invalid import name '\{hs_name}' -- must be lower kebab-case ([a-z][a-z0-9-]*), the component-model label shape")
    } else {
      ()
    }
    let hs_no_args = Array::slice([EInt(0)], 0, 0)
    ce(buf, EArray([
      EInt(3),
      ECall(EIdent(String::concat(cc_host_stream_named_raw_prefix(), hs_name), -1), hs_no_args, -1)
    ]), local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "host_stream_next" {
    // ADR-0089 Decision 3 (#1218): reads are retargeted to the injected
    // `__hs_next` by linked_compile's boundary machinery (Async-row
    // entry). A call that still spells the surface name here means the
    // machinery did not fire -- there is no read source without the entry
    // boundary + component adapter, so fail with the reason instead of an
    // "undefined variable" later.
    throw("host_stream_next: requires an Async-row entry (the entry boundary performs the stream read via the component adapter, spec §3.18); a row-free or library-mode program has no read source")
  }
  else if !prefer_bound_call && (fname == "host_stream_close" || fname == "HostStream::close") {
    // ADR-0089 Decision 3 follow-up (#1218): closes are retargeted to the
    // injected `__hs_close` by the same entry-row-keyed machinery that
    // installs the read path. The close itself performs nothing, but it
    // is only MEANINGFUL alongside that machinery -- a program with no
    // Async-row entry has no adapter to drop the readable end through, so
    // a surviving surface call here means there is no stream to close.
    // The message names the spelling the program actually wrote: a
    // diagnostic that renames the call is one more thing for the reader to
    // reconcile before they can act on it.
    throw(String::concat(fname, ": requires an Async-row entry (the readable end is dropped through the component adapter, spec §3.18); a row-free or library-mode program has no stream to close"))
  }
  else if !prefer_bound_call && fname == "Future::resolve" {
    // #1230: complete a pending future IN PLACE -- payload first, then clear
    // the state. The write order is what makes the observation safe: an
    // awaiter only reads the payload once the state says ready, so it can
    // never see the state cleared ahead of the value it describes.
    //
    // ADR-0089 (#1218, resolve -> direct wake): when the program can call
    // @vibe/concurrent's `__aw_notify_resolve` (func_table carries it --
    // linked import or local def), append the notify AFTER the state
    // clear so direct-parked awaiters (registered via __aw_wait) become
    // resumable immediately. Purely additive: without the hook the old
    // two-set lowering is emitted byte-identically, and a missed notify
    // (hook absent in THIS unit but awaiters registered in another) is
    // rescued by the scheduler's fallback valve.
    let fut = Array::get(args, 0)
    let set_payload = ECall(EIdent("Array::set", -1), [
      fut,
      EInt(1),
      Array::get(args, 1)
    ], -1)
    let set_state = ECall(EIdent("Array::set", -1), [fut, EInt(0), EInt(0)], -1)
    let resolved = if func_table_index_of(ctx.func_table, "__aw_notify_resolve") >= 0 {
      ESeq(set_payload, ESeq(set_state, ECall(EIdent("__aw_notify_resolve", -1), [
        fut
      ], -1)))
    } else {
      ESeq(set_payload, set_state)
    }
    ce(buf, resolved, local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "String::to_bytes" {
    // String::to_bytes(s) : ByteStream (ADR-0089 D4/D5, #1954).
    // Eagerly materialise the string's bytes into the Array that backs a
    // Stream[Int], so request/response bodies can be consumed with the Stream
    // combinators. Synthesized as a `let mut arr = []; while i < length(s) {
    // Array::push(arr, char_code_at(s, i)); i = i + 1 }; arr` loop and lowered
    // via `ce`, so String::length/char_code_at + the loop counter follow the
    // same (RC) tagging conventions as ordinary source. char_code_at reads one
    // byte (i32.load8_u), so this is byte-accurate.
    let s_expr = Array::get(args, 0)
    let loop_body = ESeq(ECall(EIdent("Array::push", -1), [
      EIdent("__tb_arr", -1),
      ECall(EIdent("String::char_code_at", -1), [
        EIdent("__tb_s", -1),
        EIdent("__tb_i", -1)
      ], -1)
    ], -1), EAssign("__tb_i", ECall(EIdent("add", -1), [
      EIdent("__tb_i", -1),
      EInt(1)
    ], -1), EUnit))
    let synth = ELet("__tb_s", s_expr, ELetMut("__tb_arr", EArray(array_empty()), ELetMut("__tb_i", EInt(0), ESeq(EWhile(ECall(EIdent("lt", -1), [
      // review-lint: allow-fixed-synthetic-name -- existing conversion temporaries preserved by the module split
      EIdent("__tb_i", -1),
      ECall(EIdent("String::length", -1), [EIdent("__tb_s", -1)], -1)
    ], -1), loop_body), EIdent("__tb_arr", -1)), -1), -1), -1)
    ce(buf, synth, local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "ByteStream::to_string" {
    // ByteStream::to_string(bs) : String (docs/spec
    // §M2c-2). Collect a Stream[Int] of byte codes into a String, e.g. to
    // build a response body. Synthesized as `let parts = []; while i <
    // length(bs) { Array::push(parts, String::from_char_code(bs[i])); i = i +
    // 1 }; String::join(parts, "")` and lowered via `ce`. Pushing one-char
    // pieces and joining once is O(n); the earlier `acc = String::concat(acc,
    // ...)` accumulator was O(n^2) (each concat copied the whole prefix), the
    // dominant cost in the streaming bench (4 KB to_string: 1.77s -> see
    // scripts/bench_streaming.sh). linked_compile always seeds "" into the
    // string table, so the join separator literal resolves.
    let bs_expr = Array::get(args, 0)
    let ts_body = ESeq(ECall(EIdent("Array::push", -1), [
      EIdent("__ts_parts", -1),
      ECall(EIdent("String::from_char_code", -1), [
        ECall(EIdent("Array::get", -1), [
          EIdent("__ts_arr", -1),
          EIdent("__ts_i", -1)
        ], -1)
      ], -1)
    ], -1), EAssign("__ts_i", ECall(EIdent("add", -1), [
      EIdent("__ts_i", -1),
      EInt(1)
    ], -1), EUnit))
    let synth = ELet("__ts_arr", bs_expr, ELetMut("__ts_parts", EArray(array_empty()), ELetMut("__ts_i", EInt(0), ESeq(EWhile(ECall(EIdent("lt", -1), [
      // review-lint: allow-fixed-synthetic-name -- existing conversion temporaries preserved by the module split
      EIdent("__ts_i", -1),
      ECall(EIdent("Array::length", -1), [EIdent("__ts_arr", -1)], -1)
    ], -1), ts_body), ECall(EIdent("String::join", -1), [
      EIdent("__ts_parts", -1),
      EString("", -1)
    ], -1)), -1), -1), -1)
    ce(buf, synth, local_names, next_local, ctx, ld)
  }
  else if !prefer_bound_call && fname == "add" {
    let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
    emit_i64_add(buf)
    emit_arith_wrap_int(buf, ctx.enable_rc, "+")
    nl
  }
  else if !prefer_bound_call && fname == "sub" {
    let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
    emit_i64_sub(buf)
    emit_arith_wrap_int(buf, ctx.enable_rc, "-")
    nl
  }
  else if !prefer_bound_call && fname == "mul" {
    let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    // Under RC, untag the first tagged operand BEFORE the multiply so the
    // product is tagged(a*b) and wraps at the payload's 63-bit boundary,
    // exactly like the `*` EBinOp path (#1877).
    if ctx.enable_rc {
      emit_i64_const(buf, 1)
      emit_i64_shr_s(buf)
    } else {
      ()
    }
    nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
    emit_i64_mul(buf)
    emit_arith_wrap_int(buf, ctx.enable_rc, "*")
    nl
  }
  else if !prefer_bound_call && fname == "lt" {
    let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
    emit_i64_lt_s(buf)
    emit_i64_extend_i32_s(buf)
