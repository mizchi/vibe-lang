//# Functions

// #613 follow-up: bind every `PBind` reachable under a container pattern
// (tuple or constructor) at ANY nesting depth, skipping literal / wildcard
// sub-patterns. `base_local` holds the (possibly tagged) pointer to the
// container whose fields hold the sub-pattern values. `is_ctor_layout`
// selects the field layout: a constructor stores its tag at offset 0 and
// fields at `8 + i*8` with the pointer always tag-cleared; a tuple stores
// fields at `8 + i*8` (RC, tagged) or `i*8` (non-RC, untagged). Used for
// conditional match arms whose top pattern is a bare tuple with literal
// siblings (`(false, n) => ..`), where the binding pass previously emitted
// nothing and any use of `n` trapped codegen with "undefined variable".

//# ADR-0092 Phase 1: drop-guided reuse (narrow fusion; see
//# CompileCtx.reuse_scrutinee_names). Local mirrors of compile_call's
//# cc_is_* arg classifiers (same-file rule for the bundle flatten tool).

fn mr_is_projection(_ e: Expr) -> Bool {
  match e {
    EDot(_, _, _, _) => true,
    _ => false
  }
}

fn mr_is_borrow_ret_call(e: Expr, ctx: CompileCtx) -> Bool {
  match e {
    ECall(callee, _, _, _) =>
    match callee {
      EIdent(f, _) => is_borrow_ret_builtin(f) || bsearch_leftmost(sorted = ctx.borrow_ret_names, name = f) >= 0,
      _ => false
    },
    _ => false
  }
}

fn mr_is_loop_borrowed_ident(e: Expr, ctx: CompileCtx) -> Bool {
  match e {
    EIdent(name, _) => array_contains_str(arr = ctx.loop_borrowed_names, s = name) && !array_contains_str(arr = ctx.ref_cell_names, s = name),
    _ => false
  }
}

fn mr_spine_tail(_ e: Expr) -> Expr with Exception {
  if expr_tag(e) == 9 {
    mr_spine_tail(get_elet_body(e))
  } else {
    e
  }
}

/// A let-spine prefix is admissible when every spine binding carries NO
/// planned RC action (not in rc_drop/rc_dup/rc_alias_dup) -- such bindings
/// compile as plain value+local_set with no bookkeeping to reproduce, so the
/// reuse path can compile them verbatim without re-implementing
/// compile_expr_tail's ELet dup/drop machinery. Scalar temporaries
/// (`let s = x + y`) are the common case; anything the plan tracks makes the
/// arm ineligible (normal path).
fn mr_spine_lets_ok(e: Expr, ctx: CompileCtx) -> Bool with Exception {
  if expr_tag(e) == 9 {
    let n = get_elet_name(e)
    // #3190: a value whose tail the plan took as a `PaStoreDup` row needs
    // the retain the `let` lowering gives it; the plain value compile of the
    // fused spine gives none, so the binding would hand the ctor a reference
    // its source still releases. Declining sends the arm down that lowering.
    if array_contains_str(arr = ctx.rc_drop_names, s = n) || array_contains_str(arr = ctx.rc_dup_names, s = n) || array_contains_str(arr = ctx.rc_alias_dup_names, s = n) || store_dup_tail_present(e = get_elet_val(e), ctx = ctx) {
      false
    } else {
      mr_spine_lets_ok(e = get_elet_body(e), ctx = ctx)
    }
  } else {
    true
  }
}

/// #3190: does a branch or block tail of `e` name an occurrence one of the
/// plan's `PaStoreDup` rows names? The `let` lowering retains such a tail
/// (compile_expr_tail's `let_retain_store_dup_tails`, which asks this first so
/// that a value with none is not rebuilt), and the plan left the source its
/// own reference. The rows are keyed by the occurrence's source offset, so
/// matching (name, offset) without resolving scopes can only say yes where
/// that rewrite may retain.
export fn store_dup_tail_present(e: Expr, ctx: CompileCtx) -> Bool {
  if Array::length(ctx.rc_store_dup_offs) == 0 {
    false
  } else {
    match e {
      EIdent(x, off) => {
        let mut found = false
        let mut i = 0
        while !found && off >= 0 && i < Array::length(ctx.rc_store_dup_offs) {
          found = Array::get(ctx.rc_store_dup_offs, at = i) == off && Array::get(ctx.rc_store_dup_names, at = i) == x
          i = i + 1
        }
        found
      },
      EIf(_, t, el) => store_dup_tail_present(e = t, ctx = ctx) || store_dup_tail_present(e = el, ctx = ctx),
      EMatch(_, arms) => store_dup_arm_tail_present(arms = arms, ctx = ctx),
      EHandle(hb, arms) => store_dup_tail_present(e = hb, ctx = ctx) || store_dup_arm_tail_present(arms = arms, ctx = ctx),
      ELet(_, _, b, _) => store_dup_tail_present(e = b, ctx = ctx),
      ELetMut(_, _, b, _) => store_dup_tail_present(e = b, ctx = ctx),
      ELetRec(_, _, b) => store_dup_tail_present(e = b, ctx = ctx),
      ESeq(_, b) => store_dup_tail_present(e = b, ctx = ctx),
      EAssign(_, _, b, _) => store_dup_tail_present(e = b, ctx = ctx),
      EAssignOp(_, _, _, b, _) => store_dup_tail_present(e = b, ctx = ctx),
      _ => false
    }
  }
}

fn store_dup_arm_tail_present(arms: Array[(Pat, Expr)], ctx: CompileCtx) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(arms) {
    let (_, ab) = Array::get(arms, at = i)
    found = store_dup_tail_present(e = ab, ctx = ctx)
    i = i + 1
  }
  found
}

/// Eligibility for the reuse fusion on ONE conditional arm: the staged
/// scrutinee (top of ctx.reuse_scrutinee_names) is this match's own bare-ident
/// scrutinee, the arm pattern is `PCtor` whose args are all PBind/PWild with
/// every PBind consumed EXACTLY once in the arm body (ownership then moves
/// cleanly: no bind-time dup, no binding-scope drop -- this is what lets
/// uniqueness cascade through a recursive rebuild instead of dying at depth
/// 1), the arm body is EXACTLY a constructor call with the SAME field count
/// (same block size, 16 + 8n, by ctor layout), the target ctor has no
/// boxed-float fields (their store path differs), and the scrutinee name is
/// not referenced anywhere in the arm body (the arm consumes the reference up
/// front). Returns the target ctor_table index, or -1 when the arm must
/// compile through the normal borrow-bind path (scope-end drop covers it).
fn mr_reuse_eligible(p: Pat, body: Expr, scrutinee: Expr, ctx: CompileCtx) -> Int with Exception {
  let mr_tail = mr_spine_tail(body)
  // #2389 review: a `return` inside a spine-let VALUE could skip the
  // consuming tail after the block is claimed; the planner's blocker
  // predicate covers that shape for both fusion tiers.
  if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && ctx.rc_alloc_func_idx >= 0 && Array::length(ctx.reuse_scrutinee_names) > 0 && is_pctor(p) && is_eident(scrutinee) && expr_tag(mr_tail) == 8 && mr_spine_lets_ok(e = body, ctx = ctx) && !reuse_arm_has_blocker(body) {
    let sname = Array::get(ctx.reuse_scrutinee_names, at = Array::length(ctx.reuse_scrutinee_names) - 1)
    if get_eident_name(scrutinee) == sname {
      let pargs = get_pctor_args(p)
      let arity = Array::length(pargs)
      let callee = get_ecall_callee(mr_tail)
      if arity >= 1 && is_eident(callee) {
        let ci = ctor_table_index_of(ct = ctx.ctor_table, name = get_eident_name(callee))
        let src_ci = ctor_table_index_of(ct = ctx.ctor_table, name = get_pctor_name(p))
        if ci >= 0 && src_ci >= 0 && Array::get(ctx.ctor_table.field_counts, at = ci) == arity && Array::length(get_ecall_args(mr_tail)) == arity {
          let mut shape_ok = true
          let mr_bmasks = md_shadow_zeroed_bmasks(e = body, bfns = ctx.borrow_param_user, bmasks = ctx.borrow_param_mask)
          let mut fj = 0
          while fj < arity {
            let pa = Array::get(pargs, at = fj)
            // Neither side may have a boxed-float field: the target's store
            // path differs, and a SOURCE float payload would bypass
            // bind_match_pat's float_local_slots registration (the raw-load
            // bind below doesn't know field types), so e.g. `-x` on the
            // binding would negate the box pointer (Codex review P1).
            if ctor_field_is_float(ctx = ctx, ctor_idx = ci, field_idx = fj) || ctor_field_is_float(ctx = ctx, ctor_idx = src_ci, field_idx = fj) {
              shape_ok = false
            } else if is_pbind(pa) {
              // Mode 1 only for the narrow tier (a raw transfer whose
              // single consume is the bind's ONLY occurrence): a mixed
              // consume-plus-borrow bind could be read after the consume
              // freed the transferred child (PR #2416 review); the wide
              // tier additionally admits mode 0.
              if reuse_bind_mode(arm_body = body, bn = get_pbind_name(pa), borrow_param_fns = ctx.borrow_param_user, bmasks = mr_bmasks) != 1 {
                shape_ok = false
              } else {
                ()
              }
            } else if is_pwild(pa) {
              ()
            } else {
              shape_ok = false
            }
            fj = fj + 1
          }
          let __no_params: Array[String] = []
          let __no_fns: Array[String] = []
          if shape_ok && !array_contains_str(arr = collect_free_vars(body = body, param_names = __no_params, fn_names = __no_fns), s = sname) {
            ci
          } else {
            0 - 1
          }
        } else {
          0 - 1
        }
      } else {
        0 - 1
      }
    } else {
      0 - 1
    }
  } else {
    0 - 1
  }
}

/// Compile an eligible arm with in-place block reuse, Perceus-shaped:
/// consume the scrutinee reference FIRST, then run one shared continuation.
///   1. bind payloads as raw loads (no bind-time dup -- eligibility proved
///      each PBind is consumed exactly once, so ownership transfers).
///   2. test the block's rc word: exactly `1 | (class 1 << 24)` means ours is
///      the only reference -- keep the block as a reuse token (children now
///      owned by the payload bindings; PWild children are dropped here, they
///      are ours and unused). Otherwise dup each PBind payload (the bindings
///      become owners), release our reference with a guarded drop (never
///      frees: rc > 1 on this path; immortal-saturated words also land here
///      and their drop is a no-op), and zero the token.
///   3. either way the ELet's staged reference is consumed: set the flag so
///      the scope-end drop is skipped on this arm's path.
///   4. compute the constructor's field values (payloads referenced exactly
///      once move through; non-payload borrowed-view args get the same
///      owning-position retain compile_call's ctor path applies).
///   5. token != 0 -> rewrite tag + fields in place (size/rc/class/field
///      count already correct); token == 0 -> fresh __rc_alloc identical to
///      compile_call's ctor path.
fn mr_compile_reuse_arm(buf: Bytes, body: Expr, pat: Pat, scrut_local: Int, flag_local: Int, arity: Int, ctor_idx: Int, local_names: Array[String], ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let args = get_ecall_args(mr_spine_tail(body))
  let pargs = get_pctor_args(pat)
  let tag = Array::get(ctx.ctor_table.tags, at = ctor_idx)
  // 1. raw payload binds: field j lives at (scrut & ~1) + 8 + 8j.
  let mut bi = 0
  while bi < arity {
    let pa = Array::get(pargs, at = bi)
    if is_pbind(pa) {
      let bl = Array::length(local_names)
      emit_local_get(buf = buf, idx = scrut_local)
      emit_i64_const(buf = buf, value = 0 - 2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf = buf, align = 3, offset = 8 + bi * 8)
      emit_local_set(buf = buf, idx = bl)
      Array::push(local_names, value = get_pbind_name(pa))
    } else {
      ()
    }
    bi = bi + 1
  }
  // ADR-0062 shadow lane: route the scrutinee through a guarded dup+drop
  // pair before consuming it. Net-zero on the refcount, but both halves
  // check the shadow liveness byte, so reusing (or releasing) a block the
  // shadow ledger already considers freed traps deterministically here
  // instead of corrupting the free list downstream.
  if ctx.rc_shadow {
    emit_rc_dup_guarded(buf = buf, local_idx = scrut_local, rc_shadow = true, dup_fn_idx = ctx.rc_dup_func_idx)
    emit_local_get(buf = buf, idx = scrut_local)
    emit_call(buf = buf, func_idx = ctx.rc_drop_func_idx)
  } else {
    ()
  }
  // 2. consume the reference; tk = block base or 0.
  let tk = Array::length(local_names)
  Array::push(local_names, value = "__reuse_tk")
  emit_local_get(buf = buf, idx = scrut_local)
  emit_i64_const(buf = buf, value = 0 - 2)
  emit_i64_and(buf)
  emit_i64_const(buf = buf, value = 8)
  emit_i64_sub(buf)
  emit_local_set(buf = buf, idx = tk)
  emit_local_get(buf = buf, idx = tk)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf = buf, align = 2, offset = 4)
  emit_i32_const(buf = buf, value = 16777217)
  emit_i32_eq(buf)
  emit_if_void(buf)
  let mut wj = 0
  while wj < arity {
    if is_pwild(Array::get(pargs, at = wj)) {
      emit_local_get(buf = buf, idx = tk)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf = buf, align = 3, offset = 16 + wj * 8)
      emit_call(buf = buf, func_idx = ctx.rc_drop_func_idx)
    } else {
      ()
    }
    wj = wj + 1
  }
  emit_else(buf)
  let mut dj = 0
  let mut bl2 = 0
  while dj < arity {
    if is_pbind(Array::get(pargs, at = dj)) {
      // payload locals sit just below tk, in pattern order
      let nbinds_before = mr_binds_before(pargs = pargs, idx = dj)
      emit_rc_dup_guarded(buf = buf, local_idx = tk - mr_bind_count(pargs) + nbinds_before, rc_shadow = ctx.rc_shadow, dup_fn_idx = ctx.rc_dup_func_idx)
      bl2 = bl2 + 1
    } else {
      ()
    }
    dj = dj + 1
  }
  emit_local_get(buf = buf, idx = scrut_local)
  emit_call(buf = buf, func_idx = ctx.rc_drop_func_idx)
  emit_i64_const(buf = buf, value = 0)
  emit_local_set(buf = buf, idx = tk)
  emit_end(buf)
  emit_i64_const(buf = buf, value = 1)
  emit_local_set(buf = buf, idx = flag_local)
  // 3b. admissible let-spine prefix: plain value + local_set per binding
  // (mr_spine_lets_ok proved the plan owes them no dup/drop), evaluated
  // AFTER the reference is consumed -- payloads are owned by their
  // bindings, so spine code may consume them exactly once as usual.
  let mut mr_sp = body
  while expr_tag(mr_sp) == 9 {
    let spv = get_elet_val(mr_sp)
    let spn = get_elet_name(mr_sp)
    let spnl = ce(buf, spv, local_names, Array::length(local_names), ctx, ld)
    emit_local_set(buf = buf, idx = spnl)
    Array::push(local_names, value = spn)
    mr_sp = get_elet_body(mr_sp)
  }
  // 4. field values.
  let vals: Array[Int] = []
  let mut nl = Array::length(local_names)
  let mut i = 0
  while i < arity {
    let a = Array::get(args, at = i)
    nl = ce(buf, a, local_names, nl, ctx, ld)
    let vl = nl
    Array::push(local_names, value = "__reuse_val")
    emit_local_set(buf = buf, idx = vl)
    if mr_is_loop_borrowed_ident(e = a, ctx = ctx) {
      Array::push(ctx.loop_consumed_names, value = get_eident_name(a))
      emit_rc_dup_guarded(buf = buf, local_idx = vl, rc_shadow = ctx.rc_shadow, dup_fn_idx = ctx.rc_dup_func_idx)
    } else if mr_is_projection(a) || mr_is_borrow_ret_call(e = a, ctx = ctx) {
      emit_rc_dup_guarded(buf = buf, local_idx = vl, rc_shadow = ctx.rc_shadow, dup_fn_idx = ctx.rc_dup_func_idx)
    } else {
      ()
    }
    Array::push(vals, value = vl)
    nl = nl + 1
    i = i + 1
  }
  // 5. reuse or fresh-alloc; both branches yield the tagged value.
  emit_local_get(buf = buf, idx = tk)
  emit_i64_eqz(buf)
  emit_i32_eqz(buf)
  emit_if_i64(buf)
  emit_local_get(buf = buf, idx = tk)
  emit_i32_wrap_i64(buf)
  emit_ctor_tag(buf = buf, ctx = ctx, tag = tag)
  emit_i32_store(buf = buf, align = 2, offset = 8)
  let mut sj = 0
  while sj < arity {
    emit_local_get(buf = buf, idx = tk)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf = buf, idx = Array::get(vals, at = sj))
    emit_i64_store(buf = buf, align = 3, offset = 16 + sj * 8)
    sj = sj + 1
  }
  emit_local_get(buf = buf, idx = tk)
  emit_i64_const(buf = buf, value = 8)
  emit_i64_add(buf)
  emit_i64_const(buf = buf, value = 1)
  emit_i64_or(buf)
  emit_else(buf)
  let total = 16 + arity * 8
  emit_i64_const(buf = buf, value = total)
  emit_call(buf = buf, func_idx = ctx.rc_alloc_func_idx)
  emit_local_set(buf = buf, idx = tk)
  emit_local_get(buf = buf, idx = tk)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = total)
  emit_i32_store(buf = buf, align = 2, offset = 0)
  emit_local_get(buf = buf, idx = tk)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = 1)
  emit_i32_store(buf = buf, align = 2, offset = 4)
  emit_local_get(buf = buf, idx = tk)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = 1)
  emit_i32_store8(buf = buf, align = 0, offset = 7)
  emit_local_get(buf = buf, idx = tk)
  emit_i32_wrap_i64(buf)
  emit_ctor_tag(buf = buf, ctx = ctx, tag = tag)
  emit_i32_store(buf = buf, align = 2, offset = 8)
  emit_local_get(buf = buf, idx = tk)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = arity)
  emit_i32_store(buf = buf, align = 2, offset = 12)
  let mut fj2 = 0
  while fj2 < arity {
    emit_local_get(buf = buf, idx = tk)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf = buf, idx = Array::get(vals, at = fj2))
    emit_i64_store(buf = buf, align = 3, offset = 16 + fj2 * 8)
    fj2 = fj2 + 1
  }
  emit_local_get(buf = buf, idx = tk)
  emit_i64_const(buf = buf, value = 8)
  emit_i64_add(buf)
  emit_i64_const(buf = buf, value = 1)
  emit_i64_or(buf)
  emit_end(buf)
  nl
}

fn mr_bind_count(_ pargs: Array[Pat]) -> Int {
  let mut n = 0
  let mut i = 0
  while i < Array::length(pargs) {
    if is_pbind(Array::get(pargs, at = i)) {
      n = n + 1
    } else {
      ()
    }
    i = i + 1
  }
  n
}

fn mr_binds_before(pargs: Array[Pat], idx: Int) -> Int {
  let mut n = 0
  let mut i = 0
  while i < idx {
    if is_pbind(Array::get(pargs, at = i)) {
      n = n + 1
    } else {
      ()
    }
    i = i + 1
  }
  n
}

//# ADR-0092 / #2389: plan-guided WIDE reuse. The narrow fusion above needs
//# an action-free let spine and a constructor tail; the wide path lifts
//# both by compiling the arm body through the ORDINARY machinery with the
//# token armed on the ctx stacks, and letting compile_call's constructor
//# path consume it at the first same-size allocation that RUNS -- the
//# spine tail, a branch of an `if`/`match` tail, a site after a statement
//# prefix, or an interior intermediate (the token is just a same-size
//# block, and consuming zeroes the local so later sites allocate fresh).
//# A path on which no site ran releases the claimed block at arm end
//# (mr_emit_token_release), so an armed token cannot leak; the planner
//# refused arms with any control transfer that could skip that arm end,
//# and the eligibility check below re-proves it on the very arm being
//# fused -- the plan row's (name, arity) key cannot tell sibling arms
//# apart. When the spine tail itself is a same-size constructor it is the
//# guaranteed consumer and no release code is emitted.

/// Does the Perceus plan carry a PaReuseToken candidate for (name, arity)?
fn mr_reuse_plan_has(ctx: CompileCtx, name: String, arity: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(ctx.rc_reuse_token_names) {
    if Array::get(ctx.rc_reuse_token_names, at = i) == name && Array::get(ctx.rc_reuse_token_arities, at = i) == arity {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Is there a constructor call of `arity` fields anywhere in `e` that this
/// arm's armed token can feed -- a site compile_call's constructor path
/// compiles (ident callee in the ctor table, same field count, positional
/// args)? Lambda interiors are excluded: a lambda body compiles in its own
/// frame with its own (empty) token state. The ctor-table twin of the
/// planner's spelling-based reuse_arm_has_ctor_site.
fn mr_has_ctor_site(e: Expr, arity: Int, ctx: CompileCtx) -> Bool with Exception {
  if is_efn(e) {
    false
  } else {
    let here = if expr_tag(e) == 8 {
      let callee = get_ecall_callee(e)
      if is_eident(callee) {
        let ci = ctor_table_index_of(ct = ctx.ctor_table, name = get_eident_name(callee))
        ci >= 0 && Array::get(ctx.ctor_table.field_counts, at = ci) == arity && Array::length(get_ecall_args(e)) == arity
      } else {
        false
      }
    } else {
      false
    }
    if here {
      true
    } else {
      let mark = expr_children_push(e)
      let end = expr_children_top()
      let mut i = mark
      let mut found = false
      while !found && i < end {
        if mr_has_ctor_site(e = expr_child_at(i), arity = arity, ctx = ctx) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      expr_children_pop(mark)
      found
    }
  }
}

/// Is the arm's let-spine tail a same-size constructor call -- the
/// consumer that runs on every non-unwinding path, so the arm needs no
/// token release code?
fn mr_tail_is_ctor_site(body: Expr, arity: Int, ctx: CompileCtx) -> Bool with Exception {
  let mr_tail = mr_spine_tail(body)
  if expr_tag(mr_tail) == 8 {
    let callee = get_ecall_callee(mr_tail)
    if is_eident(callee) {
      let ci = ctor_table_index_of(ct = ctx.ctor_table, name = get_eident_name(callee))
      ci >= 0 && Array::get(ctx.ctor_table.field_counts, at = ci) == arity && Array::length(get_ecall_args(mr_tail)) == arity
    } else {
      false
    }
  } else {
    false
  }
}

/// Wide-fusion eligibility: the staged scrutinee (top of
/// ctx.reuse_scrutinee_names) is this match's own bare-ident scrutinee,
/// the plan carries a PaReuseToken candidate for (name, arity), the arm
/// pattern is `PCtor` over PBind/PWild args whose binds are not
/// alias-bound and whose SOURCE fields are not boxed floats (the raw
/// payload binds below bypass bind_match_pat's float_local_slots
/// registration; the target constructor compiles through compile_call's
/// ordinary path, whose stores are byte-identical between a fresh block
/// and a reused one, so it needs no float exclusion), the arm never
/// mentions the scrutinee, contains no control transfer (re-running the
/// planner's own `reuse_arm_has_blocker` on THIS arm: the plan row is
/// keyed (name, arity), which cannot distinguish sibling arms, so an
/// eligible arm's row must never authorize a same-shape sibling whose
/// `return` could skip the arm end and leak the claimed block), and holds
/// a same-size constructor site somewhere outside lambda interiors. Every
/// bind mode is admissible (mr_compile_reuse_arm_wide keeps a held bind's
/// child alive). Returns the pattern arity, or -1.
fn mr_reuse_wide_eligible(p: Pat, body: Expr, scrutinee: Expr, ctx: CompileCtx) -> Int with Exception {
  if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && ctx.rc_alloc_func_idx >= 0 && Array::length(ctx.reuse_scrutinee_names) > 0 && is_pctor(p) && is_eident(scrutinee) {
    let sname = Array::get(ctx.reuse_scrutinee_names, at = Array::length(ctx.reuse_scrutinee_names) - 1)
    let pargs = get_pctor_args(p)
    let arity = Array::length(pargs)
    if arity >= 1 && get_eident_name(scrutinee) == sname && mr_reuse_plan_has(ctx = ctx, name = sname, arity = arity) && !reuse_arm_has_blocker(body) && mr_has_ctor_site(e = body, arity = arity, ctx = ctx) {
      let src_ci = ctor_table_index_of(ct = ctx.ctor_table, name = get_pctor_name(p))
      if src_ci >= 0 {
        let mut shape_ok = true
        let mut fj = 0
        while fj < arity {
          let pa = Array::get(pargs, at = fj)
          if ctor_field_is_float(ctx = ctx, ctor_idx = src_ci, field_idx = fj) {
            shape_ok = false
          } else if is_pbind(pa) {
            // An alias-bound name declines: aliasing can hide an owner the
            // consume count doesn't see.
            if array_contains_str(arr = ctx.rc_alias_dup_names, s = get_pbind_name(pa)) {
              shape_ok = false
            } else {
              ()
            }
          } else if is_pwild(pa) {
            ()
          } else {
            shape_ok = false
          }
          fj = fj + 1
        }
        let __no_params: Array[String] = []
        let __no_fns: Array[String] = []
        if shape_ok && !array_contains_str(arr = collect_free_vars(body = body, param_names = __no_params, fn_names = __no_fns), s = sname) {
          arity
        } else {
          0 - 1
        }
      } else {
        0 - 1
      }
    } else {
      0 - 1
    }
  } else {
    0 - 1
  }
}

/// Compile a wide-eligible arm: the token-staging prelude is the narrow
/// path's steps 1-3 (raw payload binds; the shadow-lane dup+drop probe;
/// the rc-word uniqueness test that either keeps the block as
/// `__reuse_tk` -- dropping PWild children we now own -- or dups the
/// PBind payloads, releases the shared reference, and zeroes the token;
/// the flag set so the staging ELet skips its scope-end drop), plus the
/// per-bind references a held bind needs (below). The body then compiles
/// through the ORDINARY expression machinery with the token armed on the
/// ctx stacks; compile_call's constructor path consumes it at the first
/// same-size site that runs, and the arm end releases whatever is still
/// owed: a held or borrow-only bind's base reference, and -- unless the
/// spine tail is itself the consumer -- an unconsumed token.
///
/// Per-bind accounting, by mode (reuse_bind_mode): a raw-transfer bind
/// (mode 1) owns exactly the child on the unique path and one dup on the
/// shared path, and its single consume releases it. Every other bind
/// keeps its child alive for the WHOLE arm: with `k` consumes it holds
/// `k` references for them -- the normal path's dup-per-consume,
/// bind_match_pat's model -- plus one base reference released at arm end.
/// On the unique path the raw child supplies the base and `k` dups the
/// rest; on the shared path all `k + 1` are dups (the scrutinee's own
/// reference is dropped at staging, so a bind left as a borrowed view
/// would depend on the OTHER reference surviving the arm, which arm code
/// can release). `k = 0` is the borrow-only bind (reads only); a held
/// bind's read sequenced after its consume sees a child the base
/// reference still holds, never a freed one.
fn mr_compile_reuse_arm_wide(buf: Bytes, body: Expr, pat: Pat, scrut_local: Int, flag_local: Int, arity: Int, local_names: Array[String], ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let pargs = get_pctor_args(pat)
  // Per-bind held count, indexed by PATTERN position: -1 = raw transfer
  // (no arm-end release), k >= 0 = the bind's consume count, with a base
  // reference released at arm end. PWild positions carry -1 (their
  // children are dropped at staging on the unique path, and never bound).
  let __wcc_bmasks = md_shadow_zeroed_bmasks(e = body, bfns = ctx.borrow_param_user, bmasks = ctx.borrow_param_mask)
  let held: Array[Int] = []
  let mut any_held = false
  let mut ci = 0
  while ci < arity {
    let cpa = Array::get(pargs, at = ci)
    if is_pbind(cpa) {
      let __bn = get_pbind_name(cpa)
      if reuse_bind_mode(arm_body = body, bn = __bn, borrow_param_fns = ctx.borrow_param_user, bmasks = __wcc_bmasks) == 1 {
        Array::push(held, value = 0 - 1)
      } else {
        Array::push(held, value = md_view_consume_count_pre(e = body, name = __bn, bfns = ctx.borrow_param_user, bmasks_zeroed = __wcc_bmasks))
        any_held = true
      }
    } else {
      Array::push(held, value = 0 - 1)
    }
    ci = ci + 1
  }
  let mut bi = 0
  while bi < arity {
    let pa = Array::get(pargs, at = bi)
    if is_pbind(pa) {
      let bl = Array::length(local_names)
      emit_local_get(buf = buf, idx = scrut_local)
      emit_i64_const(buf = buf, value = 0 - 2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf = buf, align = 3, offset = 8 + bi * 8)
      emit_local_set(buf = buf, idx = bl)
      Array::push(local_names, value = get_pbind_name(pa))
    } else {
      ()
    }
    bi = bi + 1
  }
  if ctx.rc_shadow {
    emit_rc_dup_guarded(buf = buf, local_idx = scrut_local, rc_shadow = true, dup_fn_idx = ctx.rc_dup_func_idx)
    emit_local_get(buf = buf, idx = scrut_local)
    emit_call(buf = buf, func_idx = ctx.rc_drop_func_idx)
  } else {
    ()
  }
  let tk = Array::length(local_names)
  Array::push(local_names, value = "__reuse_tk")
  emit_local_get(buf = buf, idx = scrut_local)
  emit_i64_const(buf = buf, value = 0 - 2)
  emit_i64_and(buf)
  emit_i64_const(buf = buf, value = 8)
  emit_i64_sub(buf)
  emit_local_set(buf = buf, idx = tk)
  emit_local_get(buf = buf, idx = tk)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf = buf, align = 2, offset = 4)
  emit_i32_const(buf = buf, value = 16777217)
  emit_i32_eq(buf)
  emit_if_void(buf)
  let mut wj = 0
  while wj < arity {
    if is_pwild(Array::get(pargs, at = wj)) {
      emit_local_get(buf = buf, idx = tk)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf = buf, align = 3, offset = 16 + wj * 8)
      emit_call(buf = buf, func_idx = ctx.rc_drop_func_idx)
    } else {
      ()
    }
    wj = wj + 1
  }
  // Unique path: a held bind's raw child is its base reference; give it
  // one more per consume.
  let mut hj = 0
  while hj < arity {
    if is_pbind(Array::get(pargs, at = hj)) && Array::get(held, at = hj) > 0 {
      emit_rc_dup_guarded_n(buf = buf, local_idx = tk - mr_bind_count(pargs) + mr_binds_before(pargs = pargs, idx = hj), n = Array::get(held, at = hj), rc_shadow = ctx.rc_shadow, dup_fn_idx = ctx.rc_dup_func_idx)
    } else {
      ()
    }
    hj = hj + 1
  }
  emit_else(buf)
  let mut dj = 0
  while dj < arity {
    if is_pbind(Array::get(pargs, at = dj)) {
      // Shared path: EVERY bind is dup'd into ownership -- one reference
      // for a raw-transfer bind (its consume releases it), and for a held
      // or borrow-only bind the base reference plus one per consume. The
      // scrutinee's reference is dropped right below, so nothing may stay
      // a borrowed view of the block.
      let nbinds_before = mr_binds_before(pargs = pargs, idx = dj)
      let __hk = Array::get(held, at = dj)
      let __ndups = if __hk >= 0 {
        __hk + 1
      } else {
        1
      }
      emit_rc_dup_guarded_n(buf = buf, local_idx = tk - mr_bind_count(pargs) + nbinds_before, n = __ndups, rc_shadow = ctx.rc_shadow, dup_fn_idx = ctx.rc_dup_func_idx)
    } else {
      ()
    }
    dj = dj + 1
  }
  emit_local_get(buf = buf, idx = scrut_local)
  emit_call(buf = buf, func_idx = ctx.rc_drop_func_idx)
  emit_i64_const(buf = buf, value = 0)
  emit_local_set(buf = buf, idx = tk)
  emit_end(buf)
  emit_i64_const(buf = buf, value = 1)
  emit_local_set(buf = buf, idx = flag_local)
  let tail_consumes = mr_tail_is_ctor_site(body = body, arity = arity, ctx = ctx)
  Array::push(ctx.reuse_tok_locals, value = tk)
  Array::push(ctx.reuse_tok_arities, value = arity)
  Array::push(ctx.reuse_tok_emitted, value = 0)
  let nl2 = ce(buf, body, local_names, Array::length(local_names), ctx, ld)
  // Arm-end release of every held / borrow-only bind's base reference
  // (raw-transferred on the unique path, dup'd on the shared path -- both
  // exactly one). Emitted after the body value, which stays on the wasm
  // stack untouched (rc_drop returns nothing). A scalar payload no-ops
  // inside rc_drop (even tag).
  if any_held {
    let mut fj = 0
    while fj < arity {
      if is_pbind(Array::get(pargs, at = fj)) && Array::get(held, at = fj) >= 0 {
        emit_local_get(buf = buf, idx = tk - mr_bind_count(pargs) + mr_binds_before(pargs = pargs, idx = fj))
        emit_call(buf = buf, func_idx = ctx.rc_drop_func_idx)
      } else {
        ()
      }
      fj = fj + 1
    }
  } else {
    ()
  }
  let __rt_at = Array::length(ctx.reuse_tok_emitted) - 1
  let __rt_emitted = Array::get(ctx.reuse_tok_emitted, at = __rt_at)
  Array::truncate(ctx.reuse_tok_locals, length = __rt_at)
  Array::truncate(ctx.reuse_tok_arities, length = __rt_at)
  Array::truncate(ctx.reuse_tok_emitted, length = __rt_at)
  if tail_consumes {
    // The spine-tail constructor runs on every non-unwinding path and is
    // compiled by compile_call with this token on top of the stack, so a
    // zero site count means the eligibility and the emission disagree --
    // a compile-time error, never a silent leak.
    if __rt_emitted == 0 {
      throw("internal: ADR-0092 wide reuse armed a token its constructor tail did not consume -- eligibility and emission disagree")
    } else {
      ()
    }
  } else {
    // The consumer sits in a branch, behind a statement prefix, or inside
    // a nested arm that may have built its constructor inline (the narrow
    // fusion allocates on its own), so some path can reach the arm end
    // with the token still armed. Release it there.
    mr_emit_token_release(buf = buf, tk = tk, ctx = ctx)
  }
  nl2
}

/// Release an unconsumed reuse token at arm end: `tk` is still the block
/// base when no same-size constructor ran on this path. The block's
/// children were transferred to the payload binds at staging (and PWild
/// children dropped), so zero the field count and let rc_drop free the
/// shell alone: at rc 1 it walks `count` class-1 fields (gen_rc_drop_body)
/// and then pushes the block onto its size bin exactly as a normal last
/// drop would. On the shared path and after a consumer `tk` is 0 and this
/// is a no-op. Emitted after the arm's value, which stays on the wasm
/// stack.
fn mr_emit_token_release(buf: Bytes, tk: Int, ctx: CompileCtx) -> Unit {
  emit_local_get(buf = buf, idx = tk)
  emit_i64_eqz(buf)
  emit_i32_eqz(buf)
  emit_if_void(buf)
  emit_local_get(buf = buf, idx = tk)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = 0)
  emit_i32_store(buf = buf, align = 2, offset = 12)
  emit_local_get(buf = buf, idx = tk)
  emit_i64_const(buf = buf, value = 8)
  emit_i64_add(buf)
  emit_i64_const(buf = buf, value = 1)
  emit_i64_or(buf)
  emit_call(buf = buf, func_idx = ctx.rc_drop_func_idx)
  emit_end(buf)
}

/// Emit `n` guarded rc_dups of `local_idx` (one per owning consume of a matched
/// field; see md_consume_count). n<=0 emits nothing.
fn emit_rc_dup_guarded_n(buf: Bytes, local_idx: Int, n: Int, rc_shadow: Bool, dup_fn_idx: Int) -> Unit {
  let mut k = 0
  while k < n {
    emit_rc_dup_guarded(buf = buf, local_idx = local_idx, rc_shadow = rc_shadow, dup_fn_idx = dup_fn_idx)
    k = k + 1
  }
}

/// A nested tuple needs a probe word only when its elements test a value.
/// Scalar matches and irrefutable tuple bindings reserve no extra locals.
fn match_tuple_probe_needed(p: Pat, nested: Bool) -> Bool {
  match p {
    PTuple(parts) => {
      let mut needed = nested && !is_catchall_pat(p)
      for part in parts {
        if match_tuple_probe_needed(p = part, nested = true) {
          needed = true
        }
      }
      needed
    },
    PCtor(_, parts) => {
      let mut needed = false
      for part in parts {
        if match_tuple_probe_needed(p = part, nested = true) {
          needed = true
        }
      }
      needed
    },
    POr(left, right) => match_tuple_probe_needed(p = left, nested = nested) || match_tuple_probe_needed(p = right, nested = nested),
    _ => false
  }
}

/// A tuple pattern reads either a raw bump tuple or a tagged record.
/// Tagged records always have a type/length header, including bump mode;
/// RC tuples also have that header. Preserve the original word in `scratch`
/// before untagging, so nested probes evaluate their parent load only once.
fn emit_match_fields_base(buf: Bytes, scratch: Int, constant_header: Bool) -> Unit {
  if !constant_header {
    emit_local_tee(buf = buf, idx = scratch)
  }
  emit_i64_const(buf = buf, value = -2)
  emit_i64_and(buf)
  if !constant_header {
    emit_local_get(buf = buf, idx = scratch)
    emit_i64_const(buf = buf, value = 1)
    emit_i64_and(buf)
    emit_i64_const(buf = buf, value = 3)
    emit_i64_shl(buf)
    emit_i64_add(buf)
  }
}

fn bind_match_pat(buf: Bytes, base_local: Int, container_pat: Pat, is_ctor_layout: Bool, local_names: Array[String], ctx: CompileCtx, body: Expr, md_bmasks: Array[Int]) -> Unit with Exception {
  let elems = if is_ctor_layout {
    get_pctor_args(container_pat)
  } else {
    get_ptuple_pats(container_pat)
  }
  // #1062: a bound field's declared type is only known here for the ctor
  // layout (a bare tuple pattern has no declared field types to consult) --
  // resolve the matched constructor's ctor_idx ONCE per call so the loop
  // below can ask ctor_field_is_float per positional field. -1 (not a ctor
  // layout) makes ctor_field_is_float trivially return false.
  let __bmp_ctor_idx = if is_ctor_layout {
    ctor_table_index_of(ct = ctx.ctor_table, name = get_pctor_name(container_pat))
  } else {
    -1
  }
  let mut i = 0
  while i < Array::length(elems) {
    let ep = Array::get(elems, at = i)
    let off = if is_ctor_layout {
      8 + i * 8
    } else if ctx.enable_rc {
      8 + i * 8
    } else {
      i * 8
    }
    if is_pbind(ep) {
      let nm = get_pbind_name(ep)
      let fl = Array::length(local_names)
      emit_local_get(buf = buf, idx = base_local)
      emit_match_fields_base(buf = buf, scratch = base_local, constant_header = is_ctor_layout || ctx.enable_rc)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf = buf, align = 3, offset = off)
      emit_local_set(buf = buf, idx = fl)
      // #1062: a Double/Float-typed constructor field bound by a pattern
      // (`Circle(r) => r * r`) must be registered into float_local_slots
      // exactly like a `let`-bound float, else it falls through to the
      // integer-multiply path -- under RC that multiplies two boxed-float
      // POINTERS together, producing a bogus pointer that traps ("memory
      // access out of bounds") when later dereferenced. __bmp_ctor_idx is
      // -1 for a bare tuple pattern, and ctor_field_is_float trivially
      // returns false for a -1 ctor_idx, so this is a no-op there.
      if ctor_field_is_float(ctx = ctx, ctor_idx = __bmp_ctor_idx, field_idx = i) {
        Array::push(ctx.float_local_slots, value = fl * 2 + 1)
      } else {
        ()
      }
      // #715 follow-up: this helper previously bound the field without ever
      // dup'ing it, regardless of how many owning uses `nm` has in `body` — a
      // matched field is a borrowed view sharing the container's refcount
      // (see #702/#705 at the inline call sites in `compile_match`), so an
      // owning consume plus the container's own recursive drop double-frees
      // the same block. Mirror the inline sites' guarded per-consume dup.
      // #1097 (historical): this used to ALSO add one dup per closure
      // literal capturing `nm` (md_capturing_fn_count) because closure envs
      // held captures as borrows. The owned-captures ABI (ADR-0076 追記31
      // Vertical A) moved that +1 into compile_lambda's creation-site dup,
      // so only the owning-consume compensation remains here.
      if ctx.enable_rc {
        emit_rc_dup_guarded_n(buf = buf, local_idx = fl, n = md_view_consume_count_pre_store(e = body, name = nm, bfns = ctx.borrow_param_user, bmasks_zeroed = md_bmasks, store_names = ctx.rc_store_dup_names, store_offs = ctx.rc_store_dup_offs), rc_shadow = ctx.rc_shadow, dup_fn_idx = ctx.rc_dup_func_idx)
      } else {
        ()
      }
      Array::push(local_names, value = nm)
    } else if is_ptuple(ep) {
      let sl = Array::length(local_names)
      emit_local_get(buf = buf, idx = base_local)
      emit_match_fields_base(buf = buf, scratch = base_local, constant_header = is_ctor_layout || ctx.enable_rc)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf = buf, align = 3, offset = off)
      emit_local_set(buf = buf, idx = sl)
      Array::push(local_names, value = "__bind_sub")
      bind_match_pat(buf = buf, base_local = sl, container_pat = ep, is_ctor_layout = false, local_names = local_names, ctx = ctx, body = body, md_bmasks = md_bmasks)
    } else if is_pctor(ep) {
      let sl = Array::length(local_names)
      emit_local_get(buf = buf, idx = base_local)
      emit_match_fields_base(buf = buf, scratch = base_local, constant_header = is_ctor_layout || ctx.enable_rc)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf = buf, align = 3, offset = off)
      emit_local_set(buf = buf, idx = sl)
      Array::push(local_names, value = "__bind_sub")
      bind_match_pat(buf = buf, base_local = sl, container_pat = ep, is_ctor_layout = true, local_names = local_names, ctx = ctx, body = body, md_bmasks = md_bmasks)
    } else {
      ()
    }
    i = i + 1
  }
}

/// The index of `field` WITHIN the struct named `sname`. A struct value lays its
/// fields out exactly like a constructor — tag/header at 0, field i at `8 + i*8`,
/// pointer tag-cleared — so the offset is `8 + index*8`, identical to what
/// `obj.field` reads. The matched struct name MUST drive the lookup: two structs
/// can share a field name at different positions (`A { x; y }` vs `B { y; x }`),
/// so a name-agnostic "first struct that declares the field" scan binds the wrong
/// offset. Only when `sname` is not in the table do we fall back to that scan.
fn find_struct_index(ctx: CompileCtx, sname: String) -> Int {
  struct_index_named(ct = ctx.ctor_table, name = sname)
}

fn field_index_in(fnames: Array[String], field: String) -> Int {
  let mut fi = 0
  let mut found = -1
  while fi < Array::length(fnames) {
    if Array::get(fnames, at = fi) == field {
      found = fi
      fi = Array::length(fnames)
    } else {
      fi = fi + 1
    }
  }
  found
}

fn struct_field_index(ctx: CompileCtx, sname: String, field: String) -> Int with Exception {
  layout_read(String::concat(".", field))
  let sidx = find_struct_index(ctx = ctx, sname = sname)
  if sidx >= 0 {
    let found = field_index_in(fnames = struct_field_names_at(ct = ctx.ctor_table, si = sidx), field = field)
    if found < 0 {
      throw(String::concat(String::concat(String::concat("unknown field `", field), "` in struct "), sname))
    } else {
      found
    }
  } else {
    // `sname` not found in the struct table: fall back to the legacy global
    // first-match scan so unqualified / synthetic names still resolve.
    let gfound = struct_first_field_slot(ct = ctx.ctor_table, field = field)
    if gfound < 0 {
      throw(String::concat("unknown struct field in pattern: ", field))
    } else {
      gfound
    }
  }
}

/// Bind every variable in a struct pattern `S::{ f1: p1, f2: p2, ... }` whose
/// value is the (tagged) struct pointer in `base_local`. Each field is loaded by
/// NAME (offset `8 + struct_field_index*8`), then its sub-pattern is bound:
/// a `PBind` becomes a local; a tuple/constructor sub-pattern recurses through
/// the positional `bind_match_pat`; a nested struct recurses here. Literal /
/// wildcard sub-patterns bind nothing (a struct pattern with a literal field is
/// refutable and is not routed here — see `is_catchall_pat`).
fn bind_struct_pat(buf: Bytes, base_local: Int, sname: String, fields: Array[(String, Pat)], local_names: Array[String], ctx: CompileCtx, body: Expr, md_bmasks: Array[Int]) -> Unit with Exception {
  let mut i = 0
  while i < Array::length(fields) {
    let (fname, subpat) = Array::get(fields, at = i)
    let off = 8 + struct_field_index(ctx = ctx, sname = sname, field = fname) * 8
    if is_pbind(subpat) {
      let nm = get_pbind_name(subpat)
      let fl = Array::length(local_names)
      emit_local_get(buf = buf, idx = base_local)
      emit_i64_const(buf = buf, value = -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf = buf, align = 3, offset = off)
      emit_local_set(buf = buf, idx = fl)
      // #715 follow-up: same missing-dup gap as `bind_match_pat` above, for an
      // irrefutable struct-pattern field. The former #1097 capturing-literal
      // term moved to compile_lambda's creation-site dup (owned-captures).
      if ctx.enable_rc {
        emit_rc_dup_guarded_n(buf = buf, local_idx = fl, n = md_view_consume_count_pre_store(e = body, name = nm, bfns = ctx.borrow_param_user, bmasks_zeroed = md_bmasks, store_names = ctx.rc_store_dup_names, store_offs = ctx.rc_store_dup_offs), rc_shadow = ctx.rc_shadow, dup_fn_idx = ctx.rc_dup_func_idx)
      } else {
        ()
      }
      Array::push(local_names, value = nm)
    } else if is_ptuple(subpat) {
      let sl = Array::length(local_names)
      emit_local_get(buf = buf, idx = base_local)
      emit_i64_const(buf = buf, value = -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf = buf, align = 3, offset = off)
      emit_local_set(buf = buf, idx = sl)
      Array::push(local_names, value = "__bind_sub")
      bind_match_pat(buf = buf, base_local = sl, container_pat = subpat, is_ctor_layout = false, local_names = local_names, ctx = ctx, body = body, md_bmasks = md_bmasks)
    } else if is_pctor(subpat) {
      let sl = Array::length(local_names)
      emit_local_get(buf = buf, idx = base_local)
      emit_i64_const(buf = buf, value = -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf = buf, align = 3, offset = off)
      emit_local_set(buf = buf, idx = sl)
      Array::push(local_names, value = "__bind_sub")
      bind_match_pat(buf = buf, base_local = sl, container_pat = subpat, is_ctor_layout = true, local_names = local_names, ctx = ctx, body = body, md_bmasks = md_bmasks)
    } else {
      match subpat {
        PStruct(__sname, sfields) => {
          let sl = Array::length(local_names)
          emit_local_get(buf = buf, idx = base_local)
          emit_i64_const(buf = buf, value = -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf = buf, align = 3, offset = off)
          emit_local_set(buf = buf, idx = sl)
          Array::push(local_names, value = "__bind_sub")
          bind_struct_pat(buf = buf, base_local = sl, sname = __sname, fields = sfields, local_names = local_names, ctx = ctx, body = body, md_bmasks = md_bmasks)
        },
        _ => ()
      }
    }
    i = i + 1
  }
}

/// #2827: `compile_match`'s pattern tests, as functions rather than closures
/// over its locals. A closure would capture `ctx`, and borrow inference counts
/// a capture as a consume, which made `ctx` owned in `compile_match` and up
/// its callers to `compile_expr`.
///
/// A test reads the value at one position of the scrutinee. `path` says how to
/// load it: from `scrut_local`, each step `(0, k, _)` reads constructor field
/// `k`, and each `(1, k, scratch)` reads tuple element `k`, probing the fields'
/// base with `scratch`.
fn match_emit_load(buf: Bytes, scrut_local: Int, path: Array[(Int, Int, Int)], ctx: CompileCtx) -> Unit {
  emit_local_get(buf = buf, idx = scrut_local)
  let mut i = 0
  while i < Array::length(path) {
    let (kind, k, scratch) = Array::get(path, at = i)
    if kind == 0 {
      emit_i64_const(buf = buf, value = -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf = buf, align = 3, offset = 8 + k * 8)
    } else {
      emit_match_fields_base(buf = buf, scratch = scratch, constant_header = ctx.enable_rc)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf = buf, align = 3, offset = if ctx.enable_rc {
        8 + k * 8
      } else {
        k * 8
      })
    }
    i = i + 1
  }
}

/// `path` with one more step.
fn match_path_then(path: Array[(Int, Int, Int)], kind: Int, k: Int, scratch: Int) -> Array[(Int, Int, Int)] {
  let out = Array::slice(path, start = 0, end = Array::length(path))
  Array::push(out, value = (kind, k, scratch))
  out
}

/// #613 follow-up: discriminate literal sub-patterns at EVERY nesting level,
/// not just the top constructor-argument level. This emits a single i32
/// boolean ("does the value at `path` match `sp`?") with NO trailing AND,
/// recursing through ctor args, tuple elements, and or-branches. Without
/// recursing, `N(W(false), n)` matched `N(W(true), _)`, `T((false, n))` matched
/// `T((true, _))`, and or-branches `(1, _) | (2, _)` / `"a" | "b"` matched
/// anything -- silent wrong results. Bindings/wildcards always match (push 1).
fn match_emit_pat_test(buf: Bytes, sp: Pat, path: Array[(Int, Int, Int)], scrut_local: Int, tuple_probe_local: Int, ctx: CompileCtx) -> Unit with Exception {
  match sp {
    POr(__l, __r) => {
      // (left matches) OR (right matches) at this same position.
      match_emit_pat_test(buf = buf, sp = __l, path = path, scrut_local = scrut_local, tuple_probe_local = tuple_probe_local, ctx = ctx)
      match_emit_pat_test(buf = buf, sp = __r, path = path, scrut_local = scrut_local, tuple_probe_local = tuple_probe_local, ctx = ctx)
      bytebuf_push(buf = buf, byte = 114)
    },
    _ => {
      if is_pfloat(sp) {
        // Bit-exact f64 compare: bump lane holds raw bits, RC lane a boxed
        // pointer (unbox first). f64.eq gives `==` semantics (0.0 == -0.0).
        match_emit_load(buf = buf, scrut_local = scrut_local, path = path, ctx = ctx)
        if ctx.enable_rc {
          emit_unbox_float(buf)
        } else {
          ()
        }
        emit_f64_reinterpret_i64(buf)
        let __pfv = get_pfloat_value(sp)
        emit_f64_const_lohi(buf = buf, lo = Float64::to_i64_bits_lo(__pfv), hi = Float64::to_i64_bits_hi(__pfv))
        emit_f64_eq(buf)
      } else if is_pint(sp) {
        match_emit_load(buf = buf, scrut_local = scrut_local, path = path, ctx = ctx)
        emit_i64_const(buf = buf, value = get_pint_value(sp))
        if ctx.enable_rc {
          emit_i64_const(buf = buf, value = 1)
          emit_i64_shl(buf)
        }
        emit_i64_eq(buf)
      } else if is_pbool(sp) {
        match_emit_load(buf = buf, scrut_local = scrut_local, path = path, ctx = ctx)
        emit_i64_const(buf = buf, value = if get_pbool_value(sp) {
          1
        } else {
          0
        })
        if ctx.enable_rc {
          emit_i64_const(buf = buf, value = 1)
          emit_i64_shl(buf)
        }
        emit_i64_eq(buf)
      } else if is_pstring(sp) {
        let __sv = get_pstring_value(sp)
        let __si = str_table_index_of(st = ctx.str_table, s = __sv)
        if __si >= 0 {
          let (__seq_fi, _, _) = resolve_func(ft = ctx.func_table, name = "eq")
          match_emit_load(buf = buf, scrut_local = scrut_local, path = path, ctx = ctx)
          emit_str_ref_slot(buf = buf, ctx = ctx, slot = __si)
          emit_call(buf = buf, func_idx = __seq_fi)
          emit_i32_wrap_i64(buf)
        } else {
          // String literal absent from the table: conservatively match (the
          // prior behavior emitted no test at all).
          emit_i32_const(buf = buf, value = 1)
        }
      } else if is_pctor(sp) {
        let __ncname = get_pctor_name(sp)
        let __nci = ctor_table_index_of(ct = ctx.ctor_table, name = __ncname)
        let __ntag = if __nci >= 0 {
          Array::get(ctx.ctor_table.tags, at = __nci)
        } else {
          -1
        }
        match_emit_load(buf = buf, scrut_local = scrut_local, path = path, ctx = ctx)
        emit_i64_const(buf = buf, value = -2)
        emit_i64_and(buf)
        emit_i32_wrap_i64(buf)
        emit_i32_load(buf = buf, align = 2, offset = 0)
        emit_ctor_tag(buf = buf, ctx = ctx, tag = __ntag)
        emit_i32_eq(buf)
        let __nargs = get_pctor_args(sp)
        // #705: payload sub-tests must NOT run when the tag test above
        // failed. The value may be a different constructor (or a scalar)
        // whose slot at `8 + k*8` is not a valid value of this ctor's field
        // type; a nested tag test would dereference that garbage — a
        // data-dependent OOB that crashed the RC-built compiler's
        // check_expr / seed_var_types on `Some(TDEnum(..))`-style patterns.
        // Guard the sub-tests behind the tag test with `if (result i32)`
        // so the AND short-circuits. Binds/wildcards add no test.
        let mut __nany = false
        let mut __nj = 0
        while __nj < Array::length(__nargs) {
          let __np = Array::get(__nargs, at = __nj)
          if is_pbind(__np) || is_pwild(__np) {
            ()
          } else {
            __nany = true
          }
          __nj = __nj + 1
        }
        if __nany {
          bytebuf_push(buf = buf, byte = 4)
          bytebuf_push(buf = buf, byte = 127)
          emit_i32_const(buf = buf, value = 1)
          let mut __nk = 0
          while __nk < Array::length(__nargs) {
            let __nkk = __nk
            let __np2 = Array::get(__nargs, at = __nkk)
            if is_pbind(__np2) || is_pwild(__np2) {
              ()
            } else {
              match_emit_pat_test(buf = buf, sp = __np2, path = match_path_then(path = path, kind = 0, k = __nkk, scratch = 0), scrut_local = scrut_local, tuple_probe_local = tuple_probe_local, ctx = ctx)
              bytebuf_push(buf = buf, byte = 113)
            }
            __nk = __nk + 1
          }
          emit_else(buf)
          emit_i32_const(buf = buf, value = 0)
          emit_end(buf)
        } else {
          ()
        }
      } else if is_ptuple(sp) {
        emit_i32_const(buf = buf, value = 1)
        let __tpats = get_ptuple_pats(sp)
        let mut __tk = 0
        while __tk < Array::length(__tpats) {
          let __tkk = __tk
          match_emit_pat_test(buf = buf, sp = Array::get(__tpats, at = __tkk), path = match_path_then(path = path, kind = 1, k = __tkk, scratch = tuple_probe_local), scrut_local = scrut_local, tuple_probe_local = tuple_probe_local, ctx = ctx)
          bytebuf_push(buf = buf, byte = 113)
          __tk = __tk + 1
        }
      } else {
        // PBind / PWild: always matches.
        emit_i32_const(buf = buf, value = 1)
      }
    }
  }
}

/// AND a position's match test onto the accumulator already on the stack.
/// Bindings/wildcards add no constraint, so they emit nothing (keeping the
/// accumulator untouched) rather than `const 1; and`.
fn match_emit_sub_tests(buf: Bytes, sp: Pat, path: Array[(Int, Int, Int)], scrut_local: Int, tuple_probe_local: Int, ctx: CompileCtx) -> Unit with Exception {
  if is_pbind(sp) || is_pwild(sp) {
    ()
  } else {
    match_emit_pat_test(buf = buf, sp = sp, path = path, scrut_local = scrut_local, tuple_probe_local = tuple_probe_local, ctx = ctx)
    bytebuf_push(buf = buf, byte = 113)
  }
}

/// The test of a conditional arm whose pattern is none of the shapes
/// `compile_match` tests inline: or-patterns and the literals they join.
fn match_emit_or_check(buf: Bytes, pat: Pat, scrut_local: Int, tuple_probe_local: Int, ctx: CompileCtx) -> Unit with Exception {
  match pat {
    POr(left, right) => {
      match_emit_or_check(buf = buf, pat = left, scrut_local = scrut_local, tuple_probe_local = tuple_probe_local, ctx = ctx)
      match_emit_or_check(buf = buf, pat = right, scrut_local = scrut_local, tuple_probe_local = tuple_probe_local, ctx = ctx)
      bytebuf_push(buf = buf, byte = 114)
    },
    PInt(n) => {
      emit_local_get(buf = buf, idx = scrut_local)
      emit_i64_const(buf = buf, value = n)
      if ctx.enable_rc {
        emit_i64_const(buf = buf, value = 1)
        emit_i64_shl(buf)
      }
      emit_i64_eq(buf)
    },
    PFloat(fv) => {
      // A float or-branch (`0.0|180.0`) previously fell through to
      // `_ => const 1` (always-true). Same f64 compare as
      // match_emit_pat_test's PFloat branch.
      emit_local_get(buf = buf, idx = scrut_local)
      if ctx.enable_rc {
        emit_unbox_float(buf)
      } else {
        ()
      }
      emit_f64_reinterpret_i64(buf)
      emit_f64_const_lohi(buf = buf, lo = Float64::to_i64_bits_lo(fv), hi = Float64::to_i64_bits_hi(fv))
      emit_f64_eq(buf)
    },
    PCtor(cname, cargs) => {
      let ci = ctor_table_index_of(ct = ctx.ctor_table, name = pattern_ctor_base_name(cname))
      let ctag = if ci >= 0 {
        Array::get(ctx.ctor_table.tags, at = ci)
      } else {
        -1
      }
      emit_local_get(buf = buf, idx = scrut_local)
      emit_i64_const(buf = buf, value = -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_i32_load(buf = buf, align = 2, offset = 0)
      emit_ctor_tag(buf = buf, ctx = ctx, tag = ctag)
      emit_i32_eq(buf)
      if Array::length(cargs) == 1 {
        match Array::get(cargs, at = 0) {
          PInt(n) => {
            emit_local_get(buf = buf, idx = scrut_local)
            emit_i64_const(buf = buf, value = -2)
            emit_i64_and(buf)
            emit_i32_wrap_i64(buf)
            emit_i64_load(buf = buf, align = 3, offset = 8)
            emit_i64_const(buf = buf, value = n)
            if ctx.enable_rc {
              emit_i64_const(buf = buf, value = 1)
              emit_i64_shl(buf)
            }
            emit_i64_eq(buf)
            bytebuf_push(buf = buf, byte = 113)
          },
          _ => ()
        }
      }
    },
    PBool(b) => {
      // An or-branch boolean literal (`true | ..`) previously fell
      // through to `_ => const 1` (always-true), so `"a"|"b"` /
      // `(1,_)|(2,_)` / bool ors silently matched everything.
      emit_local_get(buf = buf, idx = scrut_local)
      emit_i64_const(buf = buf, value = if b {
        if ctx.enable_rc {
          2
        } else {
          1
        }
      } else {
        0
      })
      emit_i64_eq(buf)
    },
    PString(sv) => {
      let __si = str_table_index_of(st = ctx.str_table, s = sv)
      if __si >= 0 {
        let (__eqfi, _, _) = resolve_func(ft = ctx.func_table, name = "eq")
        emit_local_get(buf = buf, idx = scrut_local)
        emit_str_ref_slot(buf = buf, ctx = ctx, slot = __si)
        emit_call(buf = buf, func_idx = __eqfi)
        emit_i32_wrap_i64(buf)
      } else {
        emit_i32_const(buf = buf, value = 1)
      }
    },
    PTuple(tpats) => {
      // A tuple or-branch (`(1, _) | (2, _)`): no tag to test, so
      // start from `true` and AND-in a field-vs-literal test for
      // every literal element (binds/wildcards add none).
      emit_i32_const(buf = buf, value = 1)
      let mut __ok = 0
      while __ok < Array::length(tpats) {
        let __okk = __ok
        match_emit_sub_tests(buf = buf, sp = Array::get(tpats, at = __okk), path = [
          (1, __okk, scrut_local)
        ], scrut_local = scrut_local, tuple_probe_local = tuple_probe_local, ctx = ctx)
        __ok = __ok + 1
      }
    },
    _ => emit_i32_const(buf = buf, value = 1)
  }
}

export fn compile_match(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let __match_scrutinee = get_match_scrutinee(expr)
  let __match_arms = get_match_arms(expr)
  let scrut_local = next_local
  Array::push(local_names, value = "__match_scrut")
  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)
  emit_local_set(buf = buf, idx = scrut_local)
  // One scratch word suffices for nested tuple/record field probes. A
  // parent load completes before its child writes this word again.
  let mut needs_tuple_probe = false
  if !ctx.enable_rc {
    for arm in __match_arms {
      if match_tuple_probe_needed(p = arm.0, nested = false) {
        needs_tuple_probe = true
      }
    }
  }
  let tuple_probe_local = if !needs_tuple_probe {
    -1
  } else {
    let slot = Array::length(local_names)
    Array::push(local_names, value = "")
    slot
  }
  let num_arms = Array::length(__match_arms)
  let catchall_idx = find_catchall_idx(__match_arms)
  let num_cond_arms = catchall_idx
  let mut ai = 0
  let mut max_nl = if tuple_probe_local >= 0 && tuple_probe_local + 1 > nl1 {
    tuple_probe_local + 1
  } else {
    nl1
  }
  let names_len_at_match = Array::length(local_names)
  // #965 review (#984): ref_cell_names is name-keyed. An arm's captured
  // `let mut n` stayed registered as a ref cell after the local_names
  // truncate below, so a LATER arm's `n` resolved to the outer scalar slot
  // but was loaded through the ref-cell path (garbage in the bump lane; the
  // RC lane α-renames shadows first). Restore it with the same discipline.
  let ref_cells_at_match = Array::length(ctx.ref_cell_names)
  while ai < num_cond_arms {
    Array::truncate(local_names, length = names_len_at_match)
    Array::truncate(ctx.ref_cell_names, length = ref_cells_at_match)
    // #678: a previous arm may have logged integral slots >= names_len_at_match
    // that this arm's pattern binders (non-`let`, so they log nothing) reuse;
    // drop them so a string bound there is not misread as int by `==`.
    int_log_reset_above(ctx = ctx, floor = names_len_at_match)
    agg_log_reset_above2(arr = ctx.agg_local_slots, exprs = ctx.agg_local_exprs, floor = names_len_at_match)
    // #1062 follow-up: same prune for the float log -- a previous arm's
    // Double-typed ctor-field bind (bind_match_pat, see ctor_field_is_float)
    // may have logged a slot >= names_len_at_match that THIS arm's pattern
    // binder reuses for a non-float field; without dropping it here the
    // stale float=1 entry survives and misroutes the new field's arithmetic
    // through the f64 path.
    float_log_reset_above(ctx = ctx, floor = names_len_at_match)
    let (__cond_p, __arm_body) = Array::get(__match_arms, at = ai)
    let __cond_done = if is_pfloat(__cond_p) {
      // Top-level float literal arm (`match d { 0.0 => .. }`): same f64
      // compare as match_emit_pat_test's PFloat branch.
      emit_local_get(buf = buf, idx = scrut_local)
      if ctx.enable_rc {
        emit_unbox_float(buf)
      } else {
        ()
      }
      emit_f64_reinterpret_i64(buf)
      let __apfv = get_pfloat_value(__cond_p)
      emit_f64_const_lohi(buf = buf, lo = Float64::to_i64_bits_lo(__apfv), hi = Float64::to_i64_bits_hi(__apfv))
      emit_f64_eq(buf)
      emit_if_i64(buf)
      0
    } else if is_pint(__cond_p) {
      emit_local_get(buf = buf, idx = scrut_local)
      emit_i64_const(buf = buf, value = get_pint_value(__cond_p))
      // ADR-0055 Stage 1: scrutinee is a tagged int; tag the literal to match.
      if ctx.enable_rc {
        emit_i64_const(buf = buf, value = 1)
        emit_i64_shl(buf)
      }
      emit_i64_eq(buf)
      emit_if_i64(buf)
      0
    } else {
      if is_pbool(__cond_p) {
        emit_local_get(buf = buf, idx = scrut_local)
        emit_i64_const(buf = buf, value = if get_pbool_value(__cond_p) {
          if ctx.enable_rc {
            2
          } else {
            1
          }
        } else {
          0
        })
        emit_i64_eq(buf)
        emit_if_i64(buf)
        0
      } else {
        if is_pctor(__cond_p) {
          let cname_cond = get_pctor_name(__cond_p)
          let ctor_ci = ctor_table_index_of(ct = ctx.ctor_table, name = cname_cond)
          let expected_tag = if ctor_ci >= 0 {
            Array::get(ctx.ctor_table.tags, at = ctor_ci)
          } else {
            -1
          }
          emit_local_get(buf = buf, idx = scrut_local)
          emit_i64_const(buf = buf, value = -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i32_load(buf = buf, align = 2, offset = 0)
          emit_ctor_tag(buf = buf, ctx = ctx, tag = expected_tag)
          emit_i32_eq(buf)
          // #603/#608/#613: the tag test alone is not enough — literal
          // sub-patterns must be checked at EVERY nesting level, else
          // `I(1)`/`I("x")` match `I(2)`/`I("y")`, nested `N(W(false),_)` matches
          // `N(W(true),_)`, and tuple `T((false,_))` matches `T((true,_))`. AND-in
          // a recursive field-vs-literal test per constructor argument. Bindings
          // and wildcards add no test. This bug silently broke
          // `match stmt { SEnum(false, ...) => ... }` in the compiler's own
          // namespace pass, mis-namespacing exported enums.
          let __cargs_cond = get_pctor_args(__cond_p)
          // #705: same short-circuit guard as `match_emit_pat_test` — payload
          // sub-tests only run when the arm's tag test matched, else a nested
          // tag test dereferences a slot that is not a valid tagged value.
          let mut __cany = false
          let mut __cj = 0
          while __cj < Array::length(__cargs_cond) {
            let __cp = Array::get(__cargs_cond, at = __cj)
            if is_pbind(__cp) || is_pwild(__cp) {
              ()
            } else {
              __cany = true
            }
            __cj = __cj + 1
          }
          if __cany {
            bytebuf_push(buf = buf, byte = 4)
            bytebuf_push(buf = buf, byte = 127)
            emit_i32_const(buf = buf, value = 1)
            let mut __ck = 0
            while __ck < Array::length(__cargs_cond) {
              let __ckk = __ck
              match_emit_sub_tests(buf = buf, sp = Array::get(__cargs_cond, at = __ckk), path = [
                (0, __ckk, 0)
              ], scrut_local = scrut_local, tuple_probe_local = tuple_probe_local, ctx = ctx)
              __ck = __ck + 1
            }
            emit_else(buf)
            emit_i32_const(buf = buf, value = 0)
            emit_end(buf)
          } else {
            ()
          }
          emit_if_i64(buf)
          0
        } else {
          if is_pstring(__cond_p) {
            let sval = get_pstring_value(__cond_p)
            let str_idx = str_table_index_of(st = ctx.str_table, s = sval)
            if str_idx >= 0 {
              let (str_eq_fi, _, _) = resolve_func(ft = ctx.func_table, name = "eq")
              emit_local_get(buf = buf, idx = scrut_local)
              emit_str_ref_slot(buf = buf, ctx = ctx, slot = str_idx)
              emit_call(buf = buf, func_idx = str_eq_fi)
              emit_i32_wrap_i64(buf)
              emit_if_i64(buf)
            }
            0
          } else if is_ptuple(__cond_p) {
            // A bare tuple cond pattern (`(false, n) => ..`) has no tag to test;
            // previously it fell through to `match_emit_or_check`'s `_ => const 1`,
            // making the arm UNCONDITIONALLY match — `(false, n)` matched
            // `(true, 5)` (silent wrong result, the #613 unsoundness for bare
            // tuples). Start from a `true` accumulator and AND-in a recursive
            // field-vs-literal test for every literal element (binds/wildcards
            // add no test, so an all-bind tuple stays always-true).
            emit_i32_const(buf = buf, value = 1)
            let __tpats_cond = get_ptuple_pats(__cond_p)
            let mut __tck = 0
            while __tck < Array::length(__tpats_cond) {
              let __tckk = __tck
              match_emit_sub_tests(buf = buf, sp = Array::get(__tpats_cond, at = __tckk), path = [
                (1, __tckk, scrut_local)
              ], scrut_local = scrut_local, tuple_probe_local = tuple_probe_local, ctx = ctx)
              __tck = __tck + 1
            }
            emit_if_i64(buf)
            0
          } else {
            match_emit_or_check(buf = buf, pat = __cond_p, scrut_local = scrut_local, tuple_probe_local = tuple_probe_local, ctx = ctx)
            emit_if_i64(buf)
            0
          }
        }
      }
    }
    // #cov branch: this conditional arm was taken (start of the if-then block).
    cov_emit_branch(buf = buf, cov = ctx.cov)
    let ld_arm = if ld >= 0 {
      ld + ai + 1
    } else {
      -1
    }
    let arm_nl = if is_pctor(__cond_p) {
      // #703/#705: the #702 dup of a matched heap field must give the binding
      // ONE owned reference per owning consume in the arm body (see
      // bind_match_pat's md_consume_count note). Binding is delegated to the
      // recursive bind_match_pat so nested ctor/tuple sub-patterns bind at ANY
      // depth — the previous inline loop stopped at depth 2, so the `v` in
      // `Some(Some(Some(v)))` was never emitted and its use trapped codegen
      // (resolve_local fails). Discrimination already recurses (#603/#608).
      // ADR-0092 Phase 1: an eligible rebuild arm consumes the staged
      // scrutinee reference up front (unique -> in-place reuse token,
      // shared -> dup payloads + guarded release) and skips the normal
      // borrow-bind path entirely. Every other arm compiles exactly as
      // before, including its bind-time payload dups.
      let __mr_ci = mr_reuse_eligible(p = __cond_p, body = __arm_body, scrutinee = __match_scrutinee, ctx = ctx)
      if __mr_ci >= 0 {
        let __mr_flag = Array::get(ctx.reuse_flag_locals, at = Array::length(ctx.reuse_flag_locals) - 1)
        mr_compile_reuse_arm(buf = buf, body = __arm_body, pat = __cond_p, scrut_local = scrut_local, flag_local = __mr_flag, arity = Array::length(get_pctor_args(__cond_p)), ctor_idx = __mr_ci, local_names = local_names, ctx = ctx, ld = ld_arm, ce = ce)
      } else {
        // ADR-0092 / #2389: the wide fusion covers arms the narrow path
        // declines because their let spine carries planned RC actions --
        // the compiler's own rebuild hot path. Narrow keeps precedence so
        // previously fused arms stay byte-identical.
        let __mr_wci = mr_reuse_wide_eligible(p = __cond_p, body = __arm_body, scrutinee = __match_scrutinee, ctx = ctx)
        if __mr_wci >= 0 {
          let __mr_wflag = Array::get(ctx.reuse_flag_locals, at = Array::length(ctx.reuse_flag_locals) - 1)
          mr_compile_reuse_arm_wide(buf = buf, body = __arm_body, pat = __cond_p, scrut_local = scrut_local, flag_local = __mr_wflag, arity = __mr_wci, local_names = local_names, ctx = ctx, ld = ld_arm, ce = ce)
        } else {
          let __arm_bm = md_shadow_zeroed_bmasks(e = __arm_body, bfns = ctx.borrow_param_user, bmasks = ctx.borrow_param_mask)
          bind_match_pat(buf = buf, base_local = scrut_local, container_pat = __cond_p, is_ctor_layout = true, local_names = local_names, ctx = ctx, body = __arm_body, md_bmasks = __arm_bm)
          mpr_compile_arm(buf = buf, pat = __cond_p, body = __arm_body, names_mark = names_len_at_match, local_names = local_names, ctx = ctx, ld = ld_arm, md_bmasks = __arm_bm, ce = ce)
        }
      }
    } else if is_ptuple(__cond_p) {
      // A bare tuple arm pattern with literal siblings (`(false, n) => ..`):
      // discrimination already tested the literals above, but the binding pass
      // emitted nothing here, so `n` was undefined. Load the scrutinee tuple
      // pointer and bind every reachable PBind (skipping literals/wildcards).
      let tup_ptr = Array::length(local_names)
      emit_local_get(buf = buf, idx = scrut_local)
      emit_local_set(buf = buf, idx = tup_ptr)
      Array::push(local_names, value = "__cond_tup")
      let __tup_bm = md_shadow_zeroed_bmasks(e = __arm_body, bfns = ctx.borrow_param_user, bmasks = ctx.borrow_param_mask)
      bind_match_pat(buf = buf, base_local = tup_ptr, container_pat = __cond_p, is_ctor_layout = false, local_names = local_names, ctx = ctx, body = __arm_body, md_bmasks = __tup_bm)
      mpr_compile_arm(buf = buf, pat = __cond_p, body = __arm_body, names_mark = names_len_at_match, local_names = local_names, ctx = ctx, ld = ld_arm, md_bmasks = __tup_bm, ce = ce)
    } else {
      ce(buf, __arm_body, local_names, nl1, ctx, ld_arm)
    }
    if arm_nl > max_nl {
      max_nl = arm_nl
    }
    emit_else(buf)
    ai = ai + 1
  }
  Array::truncate(local_names, length = names_len_at_match)
  Array::truncate(ctx.ref_cell_names, length = ref_cells_at_match)
  // #678: same prune before the catch-all arm's pattern binders reuse the slots.
  int_log_reset_above(ctx = ctx, floor = names_len_at_match)
  agg_log_reset_above2(arr = ctx.agg_local_slots, exprs = ctx.agg_local_exprs, floor = names_len_at_match)
  // #1062 follow-up: same prune for the float log -- see the analogous call
  // above.
  float_log_reset_above(ctx = ctx, floor = names_len_at_match)
  let ld_catch = if ld >= 0 {
    ld + num_cond_arms
  } else {
    -1
  }
  let catch_nl = if catchall_idx < num_arms {
    let __catch_arm = Array::get(__match_arms, at = catchall_idx)
    let (__catch_p, __catch_body) = __catch_arm
    0
    // #cov branch: the catch-all (none of the conditional arms matched). Only a
    // real decision point when there is at least one conditional arm.
    if num_cond_arms > 0 {
      cov_emit_branch(buf = buf, cov = ctx.cov)
    } else {
      ()
    }
    if is_pbind(__catch_p) {
      let bname = get_pbind_name(__catch_p)
      let bind_local = Array::length(local_names)
      emit_local_get(buf = buf, idx = scrut_local)
      emit_local_set(buf = buf, idx = bind_local)
      // #2126: a catch-all binder ALIASES the scrutinee. Every other binding
      // path dups (bind_match_pat dups each PBind payload, see its doc); this
      // one did not, so the binding carried no reference of its own. Handing
      // it to a callee that OWNS its parameter -- `tk_name tok drop 1`, and
      // `tk_name` is not in the borrow_param set -- made the callee release a
      // reference the binder never held, freeing the scrutinee out from under
      // whatever still pointed at it. When the scrutinee is an array element
      // (`match peek(toks, pos) { .. token => f(token) }`) that is the array's
      // element: a later read of the same index gets freed memory whose tag
      // matches no constructor, which an exhaustive match reports as
      // `unreachable` and a match with a `_` arm consumes silently.
      //
      // The Perceus plan cannot cover this: it has no rows for the enclosing
      // function at all, so no PaDup was ever planned to insert here.
      //
      // #4161: each consume needs its own reference. When the consume sites
      // are identifiable, take those references on demand.
      let __catch_pbm = md_shadow_zeroed_bmasks(e = __catch_body, bfns = ctx.borrow_param_user, bmasks = ctx.borrow_param_mask)
      let __catch_n = if ctx.enable_rc && ctx.rc_dup_func_idx >= 0 {
        md_view_consume_count_pre_store(e = __catch_body, name = bname, bfns = ctx.borrow_param_user, bmasks_zeroed = __catch_pbm, store_names = ctx.rc_store_dup_names, store_offs = ctx.rc_store_dup_offs)
      } else {
        0
      }
      Array::push(local_names, value = bname)
      let consumes = mpr_catch_consumes(body = __catch_body, name = bname, count = __catch_n, bmasks = __catch_pbm, local_names = local_names, ctx = ctx)
      if Array::length(consumes) > 0 {
        let flags = Array::length(ctx.rc_path_flag_names)
        let marks = Array::length(ctx.rc_consume_mark_names)
        Array::push(ctx.rc_path_flag_names, value = bname)
        // Nonnegative entries count consumes in a wasm flag local. Encode
        // the binder's slot below -1 for a retain at its marked use.
        Array::push(ctx.rc_path_flag_locals, value = -2 - bind_local)
        for off in consumes {
          Array::push(ctx.rc_consume_mark_names, value = bname)
          Array::push(ctx.rc_consume_mark_offs, value = off)
        }
        let next = ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
        Array::truncate(ctx.rc_path_flag_names, length = flags)
        Array::truncate(ctx.rc_path_flag_locals, length = flags)
        Array::truncate(ctx.rc_consume_mark_names, length = marks)
        Array::truncate(ctx.rc_consume_mark_offs, length = marks)
        next
      } else {
        if ctx.enable_rc && ctx.rc_dup_func_idx >= 0 {
          emit_rc_dup_guarded_n(buf = buf, local_idx = bind_local, n = if __catch_n > 1 {
            __catch_n
          } else {
            1
          }, rc_shadow = ctx.rc_shadow, dup_fn_idx = ctx.rc_dup_func_idx)
        }
        if __catch_n > 0 {
          mpr_compile_arm(buf = buf, pat = __catch_p, body = __catch_body, names_mark = names_len_at_match, local_names = local_names, ctx = ctx, ld = ld_catch, md_bmasks = __catch_pbm, ce = ce)
        } else {
          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
        }
      }
    } else {
      if is_pctor(__catch_p) {
        // #705 dup note as above; recursive bind_match_pat replaces the
        // depth-1 inline loop (same depth-3 gap as the cond arms).
        let __catch_bm = md_shadow_zeroed_bmasks(e = __catch_body, bfns = ctx.borrow_param_user, bmasks = ctx.borrow_param_mask)
        bind_match_pat(buf = buf, base_local = scrut_local, container_pat = __catch_p, is_ctor_layout = true, local_names = local_names, ctx = ctx, body = __catch_body, md_bmasks = __catch_bm)
        mpr_compile_arm(buf = buf, pat = __catch_p, body = __catch_body, names_mark = names_len_at_match, local_names = local_names, ctx = ctx, ld = ld_catch, md_bmasks = __catch_bm, ce = ce)
      } else {
        if is_ptuple(__catch_p) {
          let ptr_local2 = Array::length(local_names)
          emit_local_get(buf = buf, idx = scrut_local)
          emit_local_set(buf = buf, idx = ptr_local2)
          Array::push(local_names, value = "__tup_ptr2")
          // Recursive bind (was a depth-2 inline loop; nested ctor elements
          // inside the tuple were never bound).
          let __ctup_bm = md_shadow_zeroed_bmasks(e = __catch_body, bfns = ctx.borrow_param_user, bmasks = ctx.borrow_param_mask)
          bind_match_pat(buf = buf, base_local = ptr_local2, container_pat = __catch_p, is_ctor_layout = false, local_names = local_names, ctx = ctx, body = __catch_body, md_bmasks = __ctup_bm)
          mpr_compile_arm(buf = buf, pat = __catch_p, body = __catch_body, names_mark = names_len_at_match, local_names = local_names, ctx = ctx, ld = ld_catch, md_bmasks = __ctup_bm, ce = ce)
        } else {
          match __catch_p {
            PStruct(__sname, __sfields) => {
              // An irrefutable struct pattern `S::{ x, y }` as the catch-all arm:
              // bind every field by name from the scrutinee struct pointer.
              let __sp_ptr = Array::length(local_names)
              emit_local_get(buf = buf, idx = scrut_local)
              emit_local_set(buf = buf, idx = __sp_ptr)
              Array::push(local_names, value = "__struct_ptr")
              let __cst_bm = md_shadow_zeroed_bmasks(e = __catch_body, bfns = ctx.borrow_param_user, bmasks = ctx.borrow_param_mask)
              bind_struct_pat(buf = buf, base_local = __sp_ptr, sname = __sname, fields = __sfields, local_names = local_names, ctx = ctx, body = __catch_body, md_bmasks = __cst_bm)
              mpr_compile_arm(buf = buf, pat = __catch_p, body = __catch_body, names_mark = names_len_at_match, local_names = local_names, ctx = ctx, ld = ld_catch, md_bmasks = __cst_bm, ce = ce)
            },
            _ => ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)
          }
        }
      }
    }
  } else {
    bytebuf_push(buf = buf, byte = 0)
    0
  }
  if catch_nl > max_nl {
    max_nl = catch_nl
  }
  let mut ci2 = 0
  while ci2 < num_cond_arms {
    emit_end(buf)
    ci2 = ci2 + 1
  }
  while Array::length(local_names) < max_nl {
    Array::push(local_names, value = "")
  }
  max_nl
}
