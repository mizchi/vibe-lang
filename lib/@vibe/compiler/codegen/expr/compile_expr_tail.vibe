        }
        nl2
      }
    } else {
      nl2
    }
  } else if __tag == 10 {
    let name = get_eletrec_name(expr)
    let value = get_eletrec_val(expr)
    let body = get_eletrec_body(expr)
    let local_idx = next_local
    Array::push(local_names, name)
    // #875 fix 2: hint compile_lambda (the immediate, sole callee that
    // compiling an EFn value dispatches to) that NAME is this closure's own
    // let-rec binding, so its capture computation force-includes NAME even if
    // NAME collides with an unrelated entry in ctx.capture_name_index. Only
    // set when `value` is actually an EFn (a non-lambda let-rec value, e.g.
    // `let rec x = some_expr`, has no self-capture concept); compile_lambda
    // consumes and clears this immediately, so it cannot leak to any other
    // lambda compiled afterward. See CompileCtx.pending_letrec_self_name.
    if is_efn(value) {
      Array::truncate(ctx.pending_letrec_self_name, 0)
      Array::push(ctx.pending_letrec_self_name, name)
    } else {
      ()
    }
    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)
    emit_local_set(buf, local_idx)
    if is_efn(value) {
      let params = get_efn_params(value)
      let fn_body = get_efn_body(value)
