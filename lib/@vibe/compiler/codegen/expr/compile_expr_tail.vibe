//# Functions

/// #1899: local copy of compile_lambda.vibe's `strip_param_label_marker` --
/// see its doc comment for why this is copied rather than imported. A labeled
/// (`x~`) or optional (`x?`) parameter binds plain `x` in the body, and the
/// capture scan has to be told the name the body actually uses.
fn cet_strip_param_label_marker(n: String) -> String {
  let ln = String::length(n)
  if ln > 0 {
    let c = String::char_code_at(n, ln - 1)
    if c == '~' || c == '?' {
      n[0: ln - 1]
    } else {
      n
    }
  } else {
    n
  }
}

/// ADR-0055 tag repair for compound assignment: under RC both operands are
/// tagged (n<<1), so `+`, `-`, `%` preserve the tag for free; `/` yields
/// a/b untagged (shift left once, applied by the POST fix below). `*` is
/// repaired BEFORE the multiply instead (#1877): untagging the loaded LHS
/// first ((t>>1)*u = tagged(a*b)) makes the product overflow i64 exactly at
/// the payload's 63-bit boundary, where every other RC op already wraps —
/// the old post-multiply `>>1` pre-wrapped the intermediate one bit early.
fn emit_assignop_rc_mul_pre(buf: Bytes, enable_rc: Bool, op: String) -> Unit {
  if enable_rc && op == "*" {
    emit_i64_const(buf, 1)
    emit_i64_shr_s(buf)
  } else {
    ()
  }
}

fn emit_assignop_rc_tag_fix(buf: Bytes, enable_rc: Bool, op: String) -> Unit {
  if enable_rc && op == "/" {
    emit_i64_const(buf, 1)
    emit_i64_shl(buf)
  } else {
    ()
  }
}

/// Interior-line breakpoints (span-arc step5): when break-mode line instrumentation
/// is active (ctx.dbg_line_idx >= 0), emit `i32.const <line>` + `call dbg_line` for
/// the statement whose value subexpression is `value`, deriving the 1-based source
/// line from the value's first offset. No-op when off or when no offset is found,
/// so the default codegen path is byte-identical. Stack-neutral: dbg_line is
/// `(i32) -> ()`, the i32 const it consumes leaves the stack unchanged.
fn emit_dbg_line_for(buf: Bytes, value: Expr, ctx: CompileCtx) -> Unit {
  emit_dbg_line_stmt(buf, value, -1, ctx)
}

/// #644 / #2199: append one (owning function, body-relative byte offset, file
/// id, line) entry to `lm` for the `vibe.linemap` custom section. Called at
/// statement boundaries and at call sites so a trap inside a bounds-checked
/// builtin attributes the ACCESS, not a helper. No-op when `lm` is disabled
/// (no file newline tables, and every lambda-derived ctx).
fn linemap_record(lm: LineMapState, buf: Bytes, file_id: Int, line: Int) -> Unit {
  if lm.enabled {
    let off = bytebuf_length(buf)
    let fn_i = Array::get(lm.cur_fn, 0)
    let n = Array::length(lm.offsets)
    let same_fn = n > 0 && Array::get(lm.funcs, n - 1) == fn_i
    if same_fn && Array::get(lm.offsets, n - 1) == off {
      // Same (func, offset) as the previous probe: keep ONE row and let the
      // later record win so a call-site OOB attributes the access, not the
      // enclosing statement (#2199 size).
      Array::set(lm.file_ids, n - 1, file_id)
      Array::set(lm.lines, n - 1, line)
    } else if same_fn && Array::get(lm.file_ids, n - 1) == file_id && Array::get(lm.lines, n - 1) == line {
      // A row that answers what the row already covering this offset answers.
      // Resolution is "the last row at or before the target", so every offset
      // this one would cover resolves to the same (file, line) without it.
      // Dropping it is what keeps the enclosing-site re-assert
      // (`linemap_leave_call_site`) free on the common case where a call and
      // its arguments are written on one line.
      ()
    } else {
      Array::push(lm.funcs, fn_i)
      Array::push(lm.offsets, off)
      Array::push(lm.file_ids, file_id)
      Array::push(lm.lines, line)
    }
  } else {
    ()
  }
}

/// #2199: record the current body offset against `expr`'s source line, so a
/// trap in a callee can resolve the caller's frame, and make that line the
/// ENCLOSING SITE while `expr` is compiled. Returns the site that was in
/// effect, which `linemap_leave_call_site` takes back. No-op (and 0) when
/// linemap is off or the expression has no source offset.
export fn linemap_enter_call_site(buf: Bytes, expr: Expr, ctx: CompileCtx) -> Int {
  if ctx.linemap.enabled {
    let prev = Array::get(ctx.linemap.site, 0)
    let off = first_offset(expr)
    if off >= 0 {
      let line = offset_to_line(ctx.dbg_line_nl, off)
      linemap_record(ctx.linemap, buf, ctx.dbg_line_file_id, line)
      Array::set(ctx.linemap.site, 0, line)
    } else {
      ()
    }
    prev
  } else {
    0
  }
}

/// The other half. `prev` becomes the site again AND is recorded here, at the
/// offset the finished call left behind.
///
/// This is the row an enclosing call's trap resolves to: arguments are
/// compiled before the call instruction, so a call in one of them
/// (`Array::get(xs, compute_index())`) is the last row before the outer
/// `call` and would otherwise own it -- the array access reported at
/// `compute_index()`'s line (Codex P2 on PR #2867). A statement sets the site
/// too, so the last call in a statement restores the statement's own line
/// rather than leaving the innermost callee's.
///
/// Free where nothing moved: `linemap_record` drops a row that answers
/// identically to the one already in place, which is every call whose
/// arguments are written on its own line.
///
/// Where a statement is a bare call, nothing records a statement site for it,
/// so the restored site is the PREVIOUS statement's line. That row covers only
/// the bytes between this call and the next recorded site -- stack cleanup and
/// the function epilogue, which contain no call to trap in.
export fn linemap_leave_call_site(buf: Bytes, ctx: CompileCtx, prev: Int) -> Unit {
  if ctx.linemap.enabled {
    Array::set(ctx.linemap.site, 0, prev)
    if prev > 0 {
      linemap_record(ctx.linemap, buf, ctx.dbg_line_file_id, prev)
    } else {
      ()
    }
  } else {
    ()
  }
}

/// #644: like emit_dbg_line_for, but with the STATEMENT's own source offset as
/// the fallback anchor. `let a = 1` binds a bare literal whose subexpression
/// carries no offset (first_offset = -1) -- the ELet/ELetMut node's stmt offset
/// (the `let` keyword token) still locates the line, so the probe is emitted
/// and the line is breakpoint-able.
///
/// #2199: linemap recording is independent of the live dbg_line probe. A
/// production compile records the statement even when `dbg_line_idx < 0`.
fn emit_dbg_line_stmt(buf: Bytes, value: Expr, stmt_off: Int, ctx: CompileCtx) -> Unit {
  let voff = first_offset(value)
  let off = if voff >= 0 {
    voff
  } else {
    stmt_off
  }
  if off >= 0 && ctx.linemap.enabled {
    let line = offset_to_line(ctx.dbg_line_nl, off)
    linemap_record(ctx.linemap, buf, ctx.dbg_line_file_id, line)
    // #2199: and this statement is the enclosing site until the next one, so
    // the last call in it restores THIS line rather than leaving the
    // innermost callee's behind for whatever the statement emits after it.
    Array::set(ctx.linemap.site, 0, line)
  } else {
    ()
  }
  if ctx.dbg_line_idx >= 0 && off >= 0 {
    let line = offset_to_line(ctx.dbg_line_nl, off)
    emit_i32_const(buf, ctx.dbg_line_file_id)
    emit_i32_const(buf, line)
    emit_call(buf, ctx.dbg_line_idx)
  } else {
    ()
  }
}

fn is_edot(e: Expr) -> Bool {
  match e {
    EDot(_, _, _, _) => true,
    _ => false
  }
}

fn efn_is_capturing(value: Expr, ctx: CompileCtx) -> Bool with Exception {
  let params = get_efn_params(value)
  let pnames = array_empty()
  let mut pi = 0
  while pi < Array::length(params) {
    let (pn, _) = Array::get(params, pi)
    Array::push(pnames, pn)
    pi = pi + 1
  }
  let caps = collect_free_vars_indexed(get_efn_body(value), pnames, ctx.capture_name_index)
  Array::length(caps) > 0
}

fn slot_is_floatish(ctx: CompileCtx, slot: Int) -> Bool {
  let arr = ctx.float_local_slots
  let mut j = Array::length(arr) - 1
  let mut result = false
  while j >= 0 {
    let entry = Array::get(arr, j)
    if entry / 2 == slot {
      result = (entry % 2) == 1
      j = -1
    } else {
      j = j - 1
    }
  }
  result
}

/// #678: is the local in `slot` known to hold an Int/Bool? Mirrors
/// slot_is_floatish over ctx.int_local_slots. #769 encoding: `slot*4 + kind`,
/// kind 0 = cleared (reclassifying rebind of a reused slot), 1 = Int, 2 =
/// String (#950), 3 = Bool -- bit 0 still means "intish" (both 1 and 3), so
/// every pre-existing intish consumer is unchanged, while kind 3 additionally
/// lets `__to_string` format a bool-bound IDENT as "true"/"false" (the
/// #784/#785-P2 gap: `let b = true; "\{b}"` printed the raw integer) and kind
/// 2 routes a string-bound IDENT down `__to_string`'s identity path (the #950
/// gap: `let j = String::join([], "-"); "\{j}"` printed "0", the packed
/// empty-string encoding misread as an Int). Most-recent entry wins; the log
/// is pruned at branch/arm boundaries (int_log_reset_above) so a slot reused
/// by a non-`let` binder reads false here rather than a stale entry.
fn slot_is_intish(ctx: CompileCtx, slot: Int) -> Bool {
  let arr = ctx.int_local_slots
  let mut j = Array::length(arr) - 1
  let mut result = false
  while j >= 0 {
    let entry = Array::get(arr, j)
    if entry / 4 == slot {
      result = (entry % 2) == 1
      j = -1
    } else {
      j = j - 1
    }
  }
  result
}

/// #769: is the local in `slot` known to hold specifically a Bool (kind 3)?
fn slot_is_boolish(ctx: CompileCtx, slot: Int) -> Bool {
  let arr = ctx.int_local_slots
  let mut j = Array::length(arr) - 1
  let mut result = false
  while j >= 0 {
    let entry = Array::get(arr, j)
    if entry / 4 == slot {
      result = (entry % 4) == 3
      j = -1
    } else {
      j = j - 1
    }
  }
  result
}

/// #950: is the local in `slot` known to hold specifically a String (kind 2)?
/// Consulted only by the rebind-clear logic at the `let`/`let mut` logging
/// sites (a non-string rebind of a previously-stringish slot must log a
/// kind-0 override, or a later bare-ident read would see the stale kind-2
/// entry and take __to_string's identity path on a non-string value).
fn slot_is_stringish(ctx: CompileCtx, slot: Int) -> Bool {
  let arr = ctx.int_local_slots
  let mut j = Array::length(arr) - 1
  let mut result = false
  while j >= 0 {
    let entry = Array::get(arr, j)
    if entry / 4 == slot {
      result = (entry % 4) == 2
      j = -1
    } else {
      j = j - 1
    }
  }
  result
}

/// #2462/#2464: does the CHECKER say this render/`eq` argument is a `Bool`?
/// Keyed by `typed_lowering_arg_offset`, the producer's own key -- see
/// `bool_offset_says_bool` in compile_call.vibe, the twin of this.
fn tail_offset_says_bool(e: Expr, ctx: CompileCtx) -> Bool {
  let off = typed_lowering_arg_offset(e)
  off >= 0 && array_contains_int(ctx.bool_render_offsets, off)
}

/// #769: does `e` statically evaluate to a Bool? Bool literals, comparison /
/// logical operators, `!`, and -- via the kind-3 slot log above -- a bare ident
/// `let`-bound to a boolish value. Syntactic over-approximation like
/// expr_is_intish; consumers use it only to pick "true"/"false" formatting.
export fn expr_is_boolish(raw_e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with Exception {
  let e = cl_return_operand(raw_e)
  let tag = expr_tag(e)
  // #2462/#2464: the checker's answer first, as an extra `||` -- same channel
  // and same key as `cc_expr_is_boolish`'s arm in compile_call.vibe. These two
  // copies must agree; a table consulted by only one of them is a coin flip on
  // which copy a given site reaches.
  if tail_offset_says_bool(e, ctx) {
    true
  } else if tag == 1 {
    true
  } else if tag == 4 {
    let nm = get_eident_name(e)
    let mut i = Array::length(local_names) - 1
    let mut slot = -1
    while i >= 0 {
      if Array::get(local_names, i) == nm {
        slot = i
        i = -1
      } else {
        i = i - 1
      }
    }
    if slot >= 0 {
      slot_is_boolish(ctx, slot)
    } else {
      false
    }
  } else if tag == 5 {
    let op = get_ebinop_op(e)
    op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&&" || op == "||"
  } else if tag == 6 {
    get_eunaryop_op(e) == "!"
  } else if tag == 16 {
    // #815: an `is` expression desugars at parse time to a match whose arms
    // all return Bool literals — classify such a match as boolish so
    // `"\{opt is None}"` prints true/false instead of the raw 0/1.
    // #825: arm bodies recurse through expr_is_boolish (not just Bool
    // literals), because the structural `==` dispatch on Option/Result/tuple
    // lowers to nested matches whose leaf arms are `==`/`&&` chains and Bool
    // literals — so `"\{Some(1) == Some(1)}"` prints true, not 1.
    let arms = get_match_arms(e)
    let alen2 = Array::length(arms)
    if alen2 == 0 {
      false
    } else {
      let mut all_bool = true
      let mut bi2 = 0
      while bi2 < alen2 {
        if !expr_is_boolish(get_arm_body(Array::get(arms, bi2)), local_names, ctx) {
          all_bool = false
        } else {
          ()
        }
        bi2 = bi2 + 1
      }
      all_bool
    }
  } else if tag == 9 {
    // #825: the normalize pass lifts a non-ident match scrutinee into
    // `let __m_scrut_N = <e> in match ...` (lift_match_scrutinees), so a
    // boolish match arrives here wrapped in a let — classify by the BODY.
    // Same for the other body-position wrappers below.
    expr_is_boolish(get_elet_body(e), local_names, ctx)
  } else if tag == 10 {
    expr_is_boolish(get_eletrec_body(e), local_names, ctx)
  } else if tag == 11 {
    expr_is_boolish(get_eletmut_body(e), local_names, ctx)
  } else if tag == 14 {
    expr_is_boolish(get_eseq_second(e), local_names, ctx)
  } else if tag == 7 {
    // An if-expression is boolish when BOTH branches are.
    expr_is_boolish(get_eif_then(e), local_names, ctx) && expr_is_boolish(get_eif_else(e), local_names, ctx)
  } else if tag == 8 {
    // #815: the `==` desugar rewrites array equality to the compiler-emitted
    // `__arr_equals__<key>` helper and struct/enum equality to `T::equals`
    // (both Bool-returning), so the EBinOp shape above is gone by codegen.
    // `__arr_equals__` is a reserved compiler prefix; `::equals` (2 args) is
    // the == rewrite's exact output shape. A `not(...)` wrap (the `!=`
    // rewrite's output) is classified only when its single argument is itself
    // boolish, `not` is not locally shadowed, AND no USER function is named
    // `not` -- see the cc_expr_is_boolish twin in compile_call.vibe for what
    // that last guard fixed and why the typed channel could not.
    let bcallee = get_ecall_callee(e)
    if is_eident(bcallee) {
      let bcn = get_eident_name(bcallee)
      String::starts_with(bcn, "__arr_equals__") || (String::ends_with(bcn, "::equals") && Array::length(get_ecall_args(e)) == 2) || (bcn == "not" && Array::length(get_ecall_args(e)) == 1 && find_local_slot(local_names, "not") < 0 && func_table_user_index_of(ctx.func_table, "not", ctx.num_user_funcs) < 0 && expr_is_boolish(Array::get(get_ecall_args(e), 0), local_names, ctx)) || cc_builtin_call_ret_kind(e, local_names, ctx) == 1
    } else if is_efn(bcallee) && Array::length(get_ecall_args(e)) == 1 {
      // #815: `let x: Bool = e` parses to the ascription marker
      // `((__asc: Bool) -> __asc)(e)` (ELet carries no type field, see
      // parser_expr_dispatch's ascribe_wrap) — honor the annotation so the
      // binding's slot is logged boolish even when `e` itself is opaque.
      // The SECOND and later ascriptions in one function arrive with the
      // param renamed to `__shadow_<n>___asc` (normalize's
      // uniquify_shadowed_bindings; per-function `seen` de-dup), so match
      // that renamed form too — otherwise only the first annotated let per
      // function was classified (#825 follow-up).
      let fparams = get_efn_params(bcallee)
      if Array::length(fparams) == 1 {
        let (asc_name, asc_ty) = Array::get(fparams, 0)
        (asc_name == "__asc" || (String::starts_with(asc_name, "__shadow_") && String::ends_with(asc_name, "___asc"))) && (match asc_ty {
          Some(TyName(tn)) => tn == "Bool",
          _ => false
        })
      } else {
        false
      }
    } else {
      false
    }
  } else {
    false
  }
}

/// Blocker-3 (ADR-0055): does `e` statically evaluate to an f64 bit pattern?
/// Syntactic over-approximation (the AST is untyped): float literals, float
/// arithmetic / comparison over floatish operands, float-producing conversions,
/// and — crucially — a *variable* bound to a floatish value (tracked in
/// ctx.float_local_slots as `let`s compile). This lets `let x = 1.5; x + y`
/// take the f64 path. Shared by compile_expr (binop/unary instruction choice)
/// and the `let` handler below (which populates float_local_slots).
/// #2424: did the CHECKER say this exact node is a `Double`?
///
/// The Double twin of the Int render/`eq` term. Same contract, same fail-closed
/// ends: an extra term in FRONT of the syntactic classifier, never a
/// replacement, so the table can only add a classification the shape rules
/// missed. The key is `typed_lowering_float_key` (@vibe/compiler/core), shared
/// with the producer rather than restated here: a projection answers with its
/// FIELD-NAME offset, and a bare NAME answers -1, because a call node's offset
/// is its callee identifier's offset and this array carries call results. Its
/// doc comment carries the whole argument.
///
/// This is what closes the row `float_call_offsets` structurally could not: a
/// Double-typed STRUCT FIELD. That table is keyed by CALL offsets, so it had no
/// projection arm at all, and measured before this change `b.ratio` on a
/// `struct DBox { ratio: Double }` rendered `256` on the RC lane and trapped on
/// gc, while the same Double through a tuple element or a plain `let` answered
/// `1.5`. Tag 4 rows arrive in the SAME array (see split_typed_lowering_offsets)
/// because both answer one question, and they agree on calls: a call node's
/// `typed_lowering_arg_offset` IS its call offset.
fn tail_offset_says_float(e: Expr, ctx: CompileCtx) -> Bool {
  let off = typed_lowering_float_key(e)
  off >= 0 && array_contains_int(ctx.float_call_offsets, off)
}

export fn expr_is_floatish(raw_e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with Exception {
  let e = cl_return_operand(raw_e)
  tail_offset_says_float(e, ctx) || expr_is_floatish_syntactic(e, local_names, ctx)
}

fn expr_is_floatish_syntactic(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with Exception {
  // fbox (#797): `t.N` tuple projection survives to codegen as EDot (expr_tag
  // -1), NOT as __rec_field (that lowering is only produced for tuple
  // DESTRUCTURING and record-pattern desugars). Heap fields store floats as
  // raw f64 bits (boxed under RC), so the reader must recover float-ness
  // statically -- without this, `let t = (1.5, 2.5); t.0 + t.1` integer-adds
  // two bit patterns into NaN and Double::to_int traps. The #724 agg log
  // keeps the backing ETuple expression per slot; recurse into the projected
  // element. Untracked bindings stay false (same over-approximation as the
  // rest of this predicate).
  let dot_float = match e {
    EDot(dobj, dfield, _, _) => {
      let fc = String::char_code_at(dfield, 0)
      if fc >= 48 && fc <= 57 && is_eident(dobj) {
        let slot = find_local_slot(local_names, get_eident_name(dobj))
        if slot >= 0 {
          let info = agg_slot_lookup(ctx.agg_local_slots, slot)
          if info >= 0 && info / 64 == 1 {
            let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)
            if is_etuple(backing) {
              let elems = get_etuple_elems(backing)
              let mut k = 0
              let mut fp = 0
              while fp < String::length(dfield) {
                k = k * 10 + (String::char_code_at(dfield, fp) - 48)
                fp = fp + 1
              }
              if k >= 0 && k < Array::length(elems) {
                expr_is_floatish(Array::get(elems, k), local_names, ctx)
              } else {
                false
              }
            } else {
              false
            }
          } else {
            false
          }
        } else {
          false
        }
      } else {
        false
      }
    },
    _ => false
  }
  let tag = expr_tag(e)
  if dot_float {
    true
  } else if tag == 2 {
    true
  } else if tag == 4 {
    let nm = get_eident_name(e)
    let len = Array::length(local_names)
    let mut i = len - 1
    let mut slot = -1
    while i >= 0 {
      if Array::get(local_names, i) == nm {
        slot = i
        i = -1
      } else {
        i = i - 1
      }
    }
    if slot >= 0 {
      slot_is_floatish(ctx, slot)
    } else {
      false
    }
  } else if tag == 5 {
    let op = get_ebinop_op(e)
    // #744: arithmetic only. A float COMPARISON (`n < 0.0`) yields a Bool —
    // including `<`/`>`/`<=`/`>=` here marked a let-bound comparison result
    // as floatish, and a later `neg && ...` on that Bool took the float binop
    // path and threw "unsupported float binop: &&".
    if op == "+" || op == "-" || op == "*" || op == "/" {
      expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)
    } else {
      false
    }
  } else if tag == 6 {
    let op = get_eunaryop_op(e)
    if op == "-" {
      expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)
    } else {
      false
    }
  } else if tag == 7 || tag == 9 || tag == 10 || tag == 11 || tag == 14 || tag == 16 {
    // #2426 follow-up (Codex review on #2430): a Double that arrives through a
    // JOIN was invisible here, so `let a = if c { 0.0 } else { 1.0 }` left the
    // slot unclassified and `a == b` fell back to a raw bit compare -- on
    // every lane, RC included. Measured before this change: the `if`, `match`
    // and block forms all answered `0.0 == -0.0` false and `nan == nan` true.
    //
    // The arms are the ones `expr_is_boolish`, in this same file, has had since #825
    // -- if / match / the three let wrappers the normalize pass introduces /
    // sequence -- with the same AND semantics, which is the fail-closed
    // direction: a join is a Double only when EVERY way out of it is.
    if tag == 7 {
      expr_is_floatish(get_eif_then(e), local_names, ctx) && expr_is_floatish(get_eif_else(e), local_names, ctx)
    } else if tag == 9 {
      // A join arm that ends in its OWN binder -- `if c { let x = 0.0; x }` --
      // is the shape a bare body recursion misses, because the body is
      // `EIdent(x)` and `x` has no slot at classification time (Codex review
      // on #2432). It is answerable WITHOUT an environment: the body is a
      // single identifier and the `let` immediately above it binds that exact
      // name, so no inner scope can intervene and no outer binding of the same
      // name is reachable. Anything further -- `let x = 0.0; let z = x; z` --
      // is NOT answerable this way and stays open, measured: it still compares
      // by raw bits on all three lanes. Closing it needs the binding's TYPE,
      // which is #2424's channel; the alternative, an environment carried
      // through the descent, is the design CLAUDE.md records going silently
      // wrong (an outer `let v = 1` read for an inner `v` of another type).
      let jb9 = get_elet_body(e)
      if expr_tag(jb9) == 4 && get_eident_name(jb9) == get_elet_name(e) {
        expr_is_floatish(get_elet_val(e), local_names, ctx)
      } else {
        expr_is_floatish(jb9, local_names, ctx)
      }
    } else if tag == 10 {
      let jb10 = get_eletrec_body(e)
      if expr_tag(jb10) == 4 && get_eident_name(jb10) == get_eletrec_name(e) {
        expr_is_floatish(get_eletrec_val(e), local_names, ctx)
      } else {
        expr_is_floatish(jb10, local_names, ctx)
      }
    } else if tag == 11 {
      let jb11 = get_eletmut_body(e)
      if expr_tag(jb11) == 4 && get_eident_name(jb11) == get_eletmut_name(e) {
        expr_is_floatish(get_eletmut_val(e), local_names, ctx)
      } else {
        expr_is_floatish(jb11, local_names, ctx)
      }
    } else if tag == 14 {
      expr_is_floatish(get_eseq_second(e), local_names, ctx)
    } else {
      let jarms = get_match_arms(e)
      let jn = Array::length(jarms)
      if jn == 0 {
        false
      } else {
        let mut jall = true
        let mut ji = 0
        while ji < jn {
          if !expr_is_floatish(get_arm_body(Array::get(jarms, ji)), local_names, ctx) {
            jall = false
          } else {
            ()
          }
          ji = ji + 1
        }
        jall
      }
    }
  } else if tag == 8 {
    let callee = get_ecall_callee(e)
    if array_contains_int(ctx.float_call_offsets, get_ecall_off(e)) {
      // #2158: the CHECKER said this exact call node's result is a Double.
      // The twin of the term cc_expr_is_floatish (compile_call.vibe) adds --
      // this file holds the linear lane's SECOND hand-written copy of the
      // classifier, and #2158 already had to be fixed twice for exactly that
      // reason, so both copies get it. See CompileCtx.float_call_offsets.
      //
      // Asked before the callee shape, for the reason its twin records: the
      // table is offset-keyed, so nesting it under `is_eident` hid it from
      // every call whose callee is not a name.
      true
    } else if is_eident(callee) {
      let fname = get_eident_name(callee)
      if fname == "Int::to_double" || fname == "Int::to_float" || fname == "Float::to_double" || fname == "Double::to_float" || fname == "Double::from_i64_bits" {
        true
      } else if cc_fn_returns_float(local_names, ctx, fname) {
        // #2158: a call to a user function DECLARED `-> Double` / `-> Float`.
        // Without this, `let a = half(5.0)` left the slot unclassified, so a
        // later `${a}` fell through to __to_string's runtime bit-pattern
        // heuristic and printed the f64 bits as an Int.
        true
      } else if fname == "__rec_field" {
        // fbox (#797): `t.0` on a TRACKED tuple-literal binding (`let t =
        // (1.5, 2.5)`). Heap fields store floats as RAW f64 bits, so the
        // reader must recover float-ness statically -- without this, `t.0 +
        // t.1` integer-adds two bit patterns into NaN and `Double::to_int`
        // traps ("invalid conversion to integer"). The #724 agg log already
        // keeps the backing ETuple expression per slot; recurse into the
        // projected element. Non-literal / untracked bindings stay false
        // (same over-approximation as the rest of this predicate).
        let args = get_ecall_args(e)
        if Array::length(args) == 2 && is_eident(Array::get(args, 0)) && expr_tag(Array::get(args, 1)) == 0 {
          let slot = find_local_slot(local_names, get_eident_name(Array::get(args, 0)))
          if slot >= 0 {
            let info = agg_slot_lookup(ctx.agg_local_slots, slot)
            if info >= 0 && info / 64 == 1 {
              let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)
              if is_etuple(backing) {
                let elems = get_etuple_elems(backing)
                let k = get_eint_value(Array::get(args, 1))
                if k >= 0 && k < Array::length(elems) {
                  expr_is_floatish(Array::get(elems, k), local_names, ctx)
                } else {
                  false
                }
              } else {
                false
              }
            } else {
              false
            }
          } else {
            false
          }
        } else {
          false
        }
      } else {
        false
      }
    } else if is_efn(callee) && Array::length(get_ecall_args(e)) == 1 {
      // #1153/#1185 (+ #1207 Codex review P2): `let x: Double = e` / `let x:
      // Float = e` parses to the ascription marker `((__asc: Double) ->
      // __asc)(e)` (parser_expr_dispatch's ascribe_wrap) -- mirrors
      // expr_is_boolish's identical `is_efn(callee)` case for `Bool` (#815),
      // just never extended to Float/Double. Without this, an explicitly-
      // annotated Double/Float `let` is invisible to float_local_slots:
      // under RC a float is a BOXED heap value (#704), so a `==`/`!=`
      // between two such misclassified slots falls through emit_eq_value's
      // generic `eq` fallback, which compares the two DISTINCT boxes by
      // pointer rather than unboxing and comparing values -- silently
      // `false` for equal doubles. The same misclassification also feeds
      // `__to_string`/string interpolation, which then reads the boxed
      // pointer as if it were a plain Int (#1153: garbage output).
      // Matches the COMPLETE synthetic identity-lambda shape (no type
      // params, no declared return type, no effect row, body exactly
      // `EIdent(<the param's own name>, _)`) -- the same precision
      // checker.vibe's `ascription_lambda_ann` uses for this identical
      // marker -- so a hand-written IIFE that merely happens to name its
      // param `__asc`/`__shadow_*___asc` (e.g. `((__asc: Double) -> String
      // { "hello" })(1.0)`) isn't misread as this marker.
      match callee {
        EFn(tparams, _, params, ret_ty, effect, body) => if Array::length(tparams) == 0 && Array::length(params) == 1 && (match ret_ty {
          None => true,
          Some(_) => false
        }) && (match effect {
          None => true,
          Some(_) => false
        }) {
          let (asc_name, asc_ty) = Array::get(params, 0)
          if asc_name == "__asc" || (String::starts_with(asc_name, "__shadow_") && String::ends_with(asc_name, "___asc")) {
            match body {
              EIdent(bname, _) => if bname == asc_name {
                match asc_ty {
                  Some(TyName(tn)) => tn == "Double" || tn == "Float",
                  _ => false
                }
              } else {
                false
              },
              _ => false
            }
          } else {
            false
          }
        } else {
          false
        },
        _ => false
      }
    } else {
      false
    }
  } else {
    false
  }
}

/// #678: is `e` unambiguously an integer/bool scalar — never a string or float?
/// Such an operand makes `==`/`!=` a direct i64.eq instead of the polymorphic
/// `eq` builtin, whose string fall-back misreads a large integer as a string
/// fat-pointer `(ptr<<32)|len` (two unequal ints with a zero low word compare
/// EQUAL). Integral by SHAPE: literals, bitwise/comparison/logical operators,
/// non-float arithmetic. A bare identifier is integral when its slot was bound
/// to a definitely-integral value (ctx.int_local_slots, the dual of
/// expr_is_floatish) — sound because that log is pruned at every branch/arm
/// boundary (int_log_reset_above), so a slot reused by a non-`let` binder
/// holding a string is never read as int. Unclassified operands (a call return,
/// an untracked param/capture) stay false and fall back to the bounds-guarded
/// `eq` — the narrow remaining residual.
export fn expr_is_intish(raw_e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with Exception {
  let e = cl_return_operand(raw_e)
  let tag = expr_tag(e)
  if tag == 0 {
    true
  } else if tag == 1 {
    true
  } else if tag == 4 {
    let nm = get_eident_name(e)
    let len = Array::length(local_names)
    let mut i = len - 1
    let mut slot = -1
    while i >= 0 {
      if Array::get(local_names, i) == nm {
        slot = i
        i = -1
      } else {
        i = i - 1
      }
    }
    if slot >= 0 {
      slot_is_intish(ctx, slot)
    } else {
      false
    }
  } else if tag == 5 {
    let op = get_ebinop_op(e)
    if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" || op == "%" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "==" || op == "!=" || op == "&&" || op == "||" {
      true
    } else if op == "+" || op == "-" || op == "*" || op == "/" {
      !expr_is_floatish(e, local_names, ctx)
    } else {
      false
    }
  } else if tag == 6 {
    let op = get_eunaryop_op(e)
    // `~` is Int by construction -- the checker admits no other operand type --
    // so it is intish unconditionally, unlike unary `-`, which may be a float
    // negation. Without this the generic `eq` path reads the operand as a
    // (ptr|len) string: `~a == ~b` answered `true` for distinct integers whose
    // low 32 bits are zero, and `__to_string` printed them empty (#2344).
    op == "!" || op == "~"
  } else {
    false
  }
}

fn assign_value_mentions(value: Expr, name: String) -> Bool {
  let empty1 = array_empty()
  let empty2 = array_empty()
  array_contains_str(collect_free_vars(value, empty1, empty2), name)
}

fn reassign_carry_safe(e: Expr, name: String) -> Bool {
  if !assign_value_mentions(e, name) {
    true
  } else {
    match e {
      EIdent(_, _) => true,
      EDot(_, _, _, _) => proj_root_ident(e) == name,
      EBinOp(_, l, r, _) => reassign_carry_safe(l, name) && reassign_carry_safe(r, name),
      EUnaryOp(_, x) => reassign_carry_safe(x, name),
      _ => false
    }
  }
}

fn emit_rc_value_ptr_i32(buf: Bytes, local_idx: Int, tagged: Bool) -> Unit {
  emit_local_get(buf, local_idx)
  if tagged {
    emit_i64_const(buf, -2)
    emit_i64_and(buf)
  } else {
    ()
  }
  emit_i32_wrap_i64(buf)
}

fn emit_rc_drop_local(buf: Bytes, local_idx: Int, tagged: Bool) -> Unit {
  // #720: a saturated rc (low 24 bits == 0xFFFFFF) marks an immortal block
  // (see emit_rc_word_inc_saturating) -- never decrement, never free.
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 16777215)
  bytebuf_push(buf, 113)
  emit_i32_const(buf, 16777215)
  emit_i32_ne(buf)
  emit_if_void(buf)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 1)
  emit_i32_sub(buf)
  emit_i32_store(buf, 2, 0)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 256)
  emit_i32_mul(buf)
  emit_i32_eqz(buf)
  emit_if_void(buf)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_global_get(buf, 2)
  emit_i32_store(buf, 2, 0)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_global_set(buf, 2)
  emit_end(buf)
  emit_end(buf)
}

fn reassign_self_reusable(value: Expr, name: String) -> Bool with Exception {
  if is_etuple(value) {
    let elems = get_etuple_elems(value)
    let mut i = 0
    let mut ok = true
    while i < Array::length(elems) {
      if !reassign_carry_safe(Array::get(elems, i), name) {
        ok = false
      } else {
        ()
      }
      i = i + 1
    }
    ok
  } else {
    false
  }
}

/// #791: shared RC heap-classification for a `let`/`let mut` binding's INITIAL
/// value, extracted so ELet (tag 9) and ELetMut (tag 11) can never drift apart
/// again -- the entire #715/#791 bug family was ELetMut silently missing shape
/// coverage (EIf/EMatch/ELet/ESeq/EDot/EFn/generic-ECall) that ELet already
/// had, one shape re-discovered and patched at a time without ever being
/// ported to the sibling form. Requires `value` to already be compiled and
/// stored into `local_idx` (so the is_edot/is_eident-alias branches' immediate
/// `emit_rc_dup_guarded(buf, local_idx, ...)` targets the right local) --
/// call this AFTER `compile_expr(buf, value, ...)` + the corresponding
/// `emit_local_set`/`emit_local_tee`, never before. Pushes `name` into
/// `ctx.heap_binding_names` whenever the value's shape can't be proven scalar;
/// over-classifying is a leak/no-op at worst (guarded dup/drop no-ops on a
/// tagged-even scalar), under-classifying is the corruption class both issues
/// hit. Returns (rc_kind, is_borrow_ret_ext) exactly as the original inline
/// ELet chain did, for callers that still need those (loop_borrowed_names
/// scoping for a borrow-returning call's alias).
fn classify_let_value_heap(buf: Bytes, value: Expr, name: String, local_idx: Int, local_names: Array[String], ctx: CompileCtx) -> (Int, Bool) with Exception {
  let mut rc_kind = 0
  let mut is_borrow_ret_ext = false
  if ctx.enable_rc {
    if expr_is_floatish(value, local_names, ctx) {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if is_etuple(value) {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if is_earray(value) {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if is_erecord(value) {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if is_ctor_call(value, ctx.ctor_table) {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if is_eident(value) {
      let src = get_eident_name(value)
      // An alias of a source this pass never classified -- a pattern or
      // destructure binder (`let (t, s, c) = f(); let mut s1 = s`) is the
      // common one, since only this file registers heap bindings -- is still
      // heap when the Perceus plan tracks the ALIAS: the plan budgeted its
      // dups and its scope-end drop as an owned heap binding. Declining here
      // applied that plan by halves: the budget dups landed on the initial
      // value at the declaration, while the reassignment re-budget and the
      // scope-end drop (both gated on heap_binding_names) were skipped. A
      // `let mut` reassigned in a loop then reached its later owning uses
      // one reference short per extra use, and an owning callee freed the
      // value the next use still held -- the checker's handle arm returned
      // a `Subst` whose cell the tuple around it had been allocated into.
      if array_contains_str(ctx.heap_binding_names, src) || array_contains_str(ctx.rc_drop_names, name) || array_contains_str(ctx.rc_dup_names, name) {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
        if array_contains_str(ctx.rc_alias_dup_names, name) {
          emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow, ctx.rc_dup_func_idx)
        } else {
          ()
        }
      } else {
        ()
      }
    } else if expr_tag(value) == 8 {
      let callee = get_ecall_callee(value)
      let is_borrow_ret = call_returns_borrow(value, local_names, ctx)
      // #791: consult the DECLARED return-type table (compute_heap_returning,
      // built once from a syntactic scan of top-level signatures -- see its
      // doc comment) before falling back to the blanket "any ECall is heap"
      // default. This makes the common `let mut s = Set::new()` case
      // precise (uses the function's OWN declared `-> Set[T]` signature)
      // instead of over-approximating every call, without needing full
      // checker-inferred types threaded through codegen.
      let is_declared_heap_ret = if is_eident(callee) {
        bsearch_leftmost(ctx.heap_ret_names, get_eident_name(callee)) >= 0
      } else {
        false
      }
      let is_builtin_scalar_ret = if is_eident(callee) {
        let cn = get_eident_name(callee)
        let is_always_registered = cn == "Array::length" || cn == "Bytes::length" || cn == "String::length" || cn == "eq"
        let is_user_shadowed = !is_always_registered && func_table_index_of(ctx.func_table, cn) >= 0
        !is_user_shadowed && (cn == "Array::length" || cn == "Bytes::length" || cn == "String::length" || cn == "String::unicode_length" || cn == "String::utf16_length" || cn == "String::utf8_length" || cn == "Map::has_key" || cn == "MapBuilder::has_key" || cn == "eq" || cn == "not" || cn == "add" || cn == "sub" || cn == "mul" || cn == "lt")
      } else {
        false
      }
      let is_scalar_ret = if is_eident(callee) {
        bsearch_leftmost(ctx.scalar_ret_names, get_eident_name(callee)) >= 0 || is_builtin_scalar_ret
      } else {
        false
      }
      if is_borrow_ret || is_scalar_ret {
        ()
      } else if is_declared_heap_ret {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else {
        // No declared signature resolved either way (unannotated callee, a
        // local closure, or a shadowed/unresolved name) -- default to heap,
        // same "leak/no-op at worst" over-approximation the rest of this
        // chain already relies on.
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      }
      is_borrow_ret_ext = is_borrow_ret
    } else if is_edot(value) {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
      emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow, ctx.rc_dup_func_idx)
    } else if is_efn(value) {
      if efn_is_capturing(value, ctx) {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else {
        ()
      }
    } else if expr_tag(value) == 7 {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if expr_tag(value) == 16 {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if expr_tag(value) == 9 || expr_tag(value) == 14 || expr_tag(value) == 10 || expr_tag(value) == 11 || expr_tag(value) == 12 || expr_tag(value) == 13 {
      // #2733: a WRAPPER value -- a block, or a binder/assignment chain --
      // produces whatever its RESULT SPINE ends in, which is what has to be
      // classified. Reading the top node instead made every one of these
      // owning, so a block around a borrow-returning call got a scope-end
      // drop that freed an element its container still owned. Tags 10..13
      // reached the same default through the catch-all below; they are
      // pulled in here so one rule covers the whole wrapper class.
      //
      // Only the borrowed direction changes: a spine this cannot place still
      // falls through to heap exactly as before.
      let spine_self = Array::get(local_names, local_idx)
      Array::set(local_names, local_idx, "")
      let spine_borrowed = value_spine_borrowed(value, local_names, array_empty(), array_empty(), ctx)
      Array::set(local_names, local_idx, spine_self)
      if spine_borrowed {
        // Decline the drop, and mark the binding borrow-bound for its body
        // scope so a consuming use dups it -- the same shape the
        // `is_borrow_ret` arm above takes for a call value node.
        is_borrow_ret_ext = true
      } else {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      }
    } else {
      let __sf_tag = expr_tag(value)
      if is_eident(value) || __sf_tag == 0 || __sf_tag == 1 || __sf_tag == 2 || __sf_tag == 3 || __sf_tag == 22 {
        ()
      } else {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      }
    }
  } else {
    ()
  }
  (rc_kind, is_borrow_ret_ext)
}

/// Record wasm local `slot` in `local_names`, so the array spans it.
///
/// `local_names` is indexed BY wasm local index -- `compile_expr` resolves an
/// identifier to its slot by position -- so a lowering that CLAIMS a slot has
/// to give it an entry in the same breath. Every other claim in codegen does:
/// `compile_call` pushes `__map_arr` .. `__map_uniq` and `__argdup` /
/// `__argtmp`, one name per scratch local it takes. The scope-end promotion did
/// not, and #2792 is what that cost: it used `nl2` and returned `nl2 + 1` while
/// pushing nothing, leaving the array one short of the next binding's index, so
/// the next `let` in the ENCLOSING scope ran `Array::set(local_names,
/// local_idx, "")` one past the end and the compiler ABORTED --
/// `Array::set: index 12 out of bounds for length 12`, no diagnostic, no source
/// position, nothing naming an edit. The bump lane has no promotion and
/// compiled the same program, so the two lanes disagreed on whether the program
/// exists.
///
/// The promotion is written out TWICE -- once in the `ELet` lowering, once in
/// `ELetMut`'s -- and only the first was found at first. `let mut ys = [..]`
/// inside the wrapper aborted identically until review on #2797 named the
/// second. That is the argument for a helper over a fourth hand-rolled copy:
/// the sites that claim a slot are enumerable (`emit_local_set(buf, nl2)` finds
/// exactly these two), and one call is what makes each of them checkable.
///
/// The entry is the empty no-name marker, never a spelling: the slot is
/// addressed by index and never looked up by name, and `compile_expr` resolves
/// identifiers through this array with LAST MATCH WINNING, so a real name here
/// would make a same-named outer binding read as this scratch slot (Codex on
/// #2725).
///
/// Padding up to `slot` first is what makes this safe to call after a lowering
/// that already left the array short. It deliberately does NOT push when the
/// array already spans `slot`: appending there would put the marker at one
/// index and the slot at another, which is the very misalignment it exists to
/// prevent -- so a caller that needs the slot to be FRESH tests that itself
/// (`path_drop` below does).
fn cet_record_local_slot(local_names: Array[String], slot: Int) -> Unit {
  while Array::length(local_names) < slot + 1 {
    Array::push(local_names, "")
  }
}

/// Did the spine's own `ELet` lowering already retain the escaping element for
/// `root`? The assignment retain must not be stacked on top of that one, and
/// must not be withheld when it was never taken. The two mistakes are not
/// symmetric -- the first leaks, the second frees a reference the container
/// still owns -- so this answers only where it can establish the retain, and
/// the caller retains wherever it cannot.
///
/// The NAME alone does not establish it, which is the correction this function
/// carries. `x = { let ys = Array::get(xss, 0); Array::get(ys, 0) }` binds `ys`
/// in the spine exactly as the owning shape does, but `classify_let_value_heap`
/// leaves a borrow-returning call at `rc_kind == 0`, so that binder gets no
/// scope-end drop and the promotion guarded by it never runs. Suppressing there
/// left the owning slot holding a reference nobody took: measured `850` on the
/// RC lane against the bump lane's `770`, the second read answering with the
/// filler. Pinned by `assign_borrow_bound_binder` in
/// fixtures/rc_wrapper_assign_borrow_test.vibe.
///
/// So the test mirrors the promotion's OWN guard -- `rc_kind > 0 &&
/// array_contains_str(ctx.rc_drop_names, name)` -- instead of approximating it.
/// `heap_binding_names` is the record `classify_let_value_heap` writes on
/// exactly its `rc_kind = 2` paths, and both callers run after the value is
/// compiled, so the record is already there to read. Reading those flat
/// whole-function lists by name is exact rather than approximate because
/// normalize alpha-renames every shadowing binder (#715): within one function a
/// name is one binding.
///
/// `reuse_fusion` is the promotion's remaining guard and is deliberately not
/// tested, because it cannot hold here: it requires the binder's body to be an
/// `EMatch`, and `scope_tail_proj_root` answers "" for one, so a spine whose
/// root is this binder never took that branch.
fn spine_binder_promoted(root: String, binders: Array[String], ctx: CompileCtx) -> Bool {
  array_contains_str(binders, root) && array_contains_str(ctx.heap_binding_names, root) && array_contains_str(ctx.rc_drop_names, root)
}

/// After the store, does the plan spend MORE references on this slot than the
/// #791 budget re-application below hands it?
///
/// This is the counterpart #2786's "Fix shape" asks for -- the retain and the
/// planner have to agree about what the slot holds -- and it is arithmetic over
/// what the planner itself recorded, not a syntactic property of the value.
///
/// A store of an OWNED value gives the slot one reference of its own, so the
/// plan balances: the dups the budget re-applies plus that one cover the
/// consumes that follow. A BORROWED value gives it none. So the slot is short
/// exactly when the consumes after the store outnumber the dups, and the retain
/// is what puts the missing one back.
///
/// The consumes after the store are the scope-end drop, if one is planned
/// (`rc_drop_names`), plus the owning uses in the assignment's own continuation.
/// The dups are the occurrences of the name in `rc_dup_names`, which is what the
/// budget loop below iterates -- reading the same list keeps the two from
/// disagreeing about the count.
///
/// Measured with `vibe rc-plan`, which prints the same plan linked_compile
/// threads into codegen, on the fixtures that carry each shape:
///
///   | fixture case                       | plan for the slot | short |
///   |------------------------------------|-------------------|------:|
///   | `assign_self_borrow_unused`        | drop 1            |   yes |
///   | `assign_self_borrow_use`           | drop 1            |   yes |
///   | `assign_self_borrow_then_consume`  | dup 1, drop 1     |   yes |
///   | `once_owning_self`                 | drop 1            |   yes |
///   | `assign_self_owning_use`           | dup 1             |    no |
///   | a consuming self-use, later read   | dup 1, drop 1     |    no |
///   | a leaf derived from the slot       | dup 1, drop 1     |    no |
///
/// The first is #2786's repro, which traps in `__rt_rc_alloc` on main. The third
/// needs the `> dups` arithmetic and not the drop record alone: its consuming
/// use puts the slot in the budget, and a clause keyed on `rc_drop_names` with
/// `rc_dup_names` as a veto declines it and leaves that spelling broken.
///
/// The last two rows are the ones a bolder clause gets wrong. Retaining a
/// consuming self-use's slot, or one whose stored value came OUT of the slot,
/// adds a reference nothing releases -- 80 B per assignment on the shapes
/// measured, the same rate as #2760's own leak.
///
/// `md_consume_count_b` is asked about the CONTINUATION, never about the value.
/// Asking it about the value was tried (#2799) and is wrong: whether it reads a
/// call as owning depends on the borrow masks that file's OTHER call sites
/// produce -- `total` comes back borrow-inferred in one fixture here and not in
/// another -- so the clause answers differently for the same spelling depending
/// on its neighbours. The plan does not have that property: it is computed for
/// the function being compiled. What the continuation contributes is an owning
/// use the drop record cannot see, and there an under-count only leaves today's
/// answer standing.
fn assign_slot_short_after_store(name: String, body: Expr, ctx: CompileCtx) -> Bool {
  let mut dups = 0
  let mut i = 0
  while i < Array::length(ctx.rc_dup_names) {
    if Array::get(ctx.rc_dup_names, i) == name {
      dups = dups + 1
    } else {
      ()
    }
    i = i + 1
  }
  let scope_end = if array_contains_str(ctx.rc_drop_names, name) {
    1
  } else {
    0
  }
  scope_end + md_consume_count_b(body, name, ctx.borrow_param_user, ctx.borrow_param_mask) > dups
}

/// Does a value's STRAIGHT-LINE spine hand a mutable slot a reference the
/// scope does not own? The twin of `pc_count`'s ELetMut `borrowed_call`: the
/// retain this gates and the owning plan that arm records must cover the same
/// values, or codegen and the planner disagree about what the slot holds.
///
/// TWO leaf kinds are unowned, and they are enumerated here once rather than
/// one per review round (#2760): a call returning a borrow, and a PROJECTION,
/// which is a view into its parent exactly as that call result is.
///
/// The two arms are NOT separable, which was measured rather than assumed --
/// attributed on `6507c60` by building each variant against
/// fixtures/rc_mut_init_proj_leak_test.vibe:
///
///   unpatched                  268 B at N=20000,       268 B at N=40000
///   assignment arm ONLY  1,600,348 B at N=20000, 3,200,348 B at N=40000
///   both arms                  348 B at N=20000,       348 B at N=40000
///
/// The assignment arm below retains a wrapped borrow on the way IN; without
/// the projection arm the initializer never recorded the slot owning, so
/// nothing spends that retain and it leaks at a rate that scales with N. This
/// is the shape of caution #1 on #2760 -- a one-sided change to what codegen
/// records is what the planner then disagrees with -- so adding either arm
/// alone is worse than adding neither.
///
/// Both callers compose this with the top-node tests they already ran, so a
/// leaf this declines keeps today's answer -- it can only ADD a retain, never
/// withdraw one. That is why the projection arm can be conservative about a
/// root it cannot place without narrowing anything.
fn spine_leaf_unowned(value: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool {
  let binders = array_empty()
  let leaf = mib_spine_leaf(value, binders)
  match leaf {
    // The spine's own binder must not be retained TWICE. When the wrapper binds
    // the borrow's SOURCE and OWNS it -- `x = { let ys = [..]; Array::get(ys,
    // 0) }` -- the inner `ELet` lowering already promotes the escaping element
    // before dropping `ys`, keyed on `scope_tail_proj_root(body) == n`.
    // Retaining it again here gives the slot two references and its drop spends
    // one, so every assignment leaks the element permanently.
    //
    // Measured on `6507c60` at N=20000: 164 B unpatched against 1,600,084 B
    // with this clause classifying from the leaf callee alone -- 80 B per
    // iteration, so it SCALES. Bounded by
    // fixtures/rc_wrapper_assign_double_retain_test.vibe (gate row 40e2).
    //
    // `scope_tail_proj_root` is asked for the root because it is the SAME
    // predicate the inner lowering keys on, so the two cannot read the spine
    // differently. But the root being a spine binder is NOT on its own evidence
    // that the lowering retained, which is what `spine_binder_promoted` exists
    // to establish -- see its doc comment for the shape that proved it.
    ECall(EIdent(cn, _), _, _) => if array_contains_str(binders, cn) || !call_returns_borrow(leaf, local_names, ctx) {
      false
    } else {
      let tail_root = scope_tail_proj_root(value)
      String::length(tail_root) == 0 || !spine_binder_promoted(tail_root, binders, ctx)
    },
    // A BARE projection is retained by `classify_let_value_heap`'s own
    // `is_edot(value)` arm, and by the assignment path's own top-node clause.
    // Only a WRAPPED one arrives here unretained; firing on the bare one too
    // would retain it a second time, which is the leak this arm exists to
    // remove. `is_edot(value)` is exactly "the spine walk moved".
    //
    // A projection rooted at a binder the spine OWNS is declined, for the same
    // reason as the `ECall` arm above: that binder's own `ELet` lowering
    // promotes the escaping element -- retains it before dropping the binder --
    // so retaining again here gives the slot two references while its drop
    // spends one, and every assignment leaks.
    //
    // Being a spine binder is NOT on its own evidence of that promotion. This
    // arm tested the name until #2796, which is the same mistake #2793 found one
    // arm over, reached through a projection leaf instead of a call. A binder
    // bound to a BORROW -- `x = { let h = Array::get(hs, 0); h.node }` -- stays
    // at `rc_kind == 0`: no entry in `heap_binding_names`, no scope-end drop, so
    // nothing promoted and nothing already retained. Declining there costs the
    // slot a reference the container still owns, and its drop releases it.
    // Measured on `main` at 702c134 and on the committed seed alike: 850 on the
    // RC lane against the bump lane's 770, the second read of the element
    // answering with the filler.
    //
    // An unplaceable root (`f().a`) is still declined, and that one IS only
    // today's answer kept -- main emits nothing there either, and widening it
    // needs its own measurement of what the retain would be following.
    EDot(_, _, _, _) => if is_edot(value) {
      false
    } else {
      let root = proj_root_ident(leaf)
      String::length(root) > 0 && !spine_binder_promoted(root, binders, ctx)
    },
    _ => false
  }
}

/// The leaf of a STRAIGHT-LINE spine, collecting the names it binds. Mirrors
/// `pmvc_spine_leaf` in perceus.vibe; branching stops the walk because the
/// plan it pairs with records one answer per binding.
fn mib_spine_leaf(e: Expr, binders: Array[String]) -> Expr {
  match e {
    ELet(n, _, b, _) => {
      Array::push(binders, n)
      mib_spine_leaf(b, binders)
    },
    ELetMut(n, _, b, _) => {
      Array::push(binders, n)
      mib_spine_leaf(b, binders)
    },
    ELetRec(n, _, b) => {
      Array::push(binders, n)
      mib_spine_leaf(b, binders)
    },
    ESeq(_, b) => mib_spine_leaf(b, binders),
    EAssign(_, _, b) => mib_spine_leaf(b, binders),
    EAssignOp(_, _, _, b) => mib_spine_leaf(b, binders),
    _ => e
  }
}

/// The direct-call borrow contract, shared by initialization and assignment.
///
/// The tables are keyed by GLOBAL name, so a callee whose spelling resolves
/// to a LOCAL -- a parameter or a local closure shadowing a borrow-returning
/// top-level function -- is not described by them. Reading one anyway calls a
/// fresh owned result borrowed; on the assignment path that adds a retain
/// nothing spends, measured at 80 B per iteration (244 B on main against
/// 1,600,164 B at N=20000). A local resolves to no contract, which is not the
/// same as a borrow contract.
fn call_returns_borrow(value: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool {
  match value {
    ECall(EIdent(cn, _), _, _) => find_local_slot(local_names, cn) < 0 && (is_borrow_ret_builtin(cn) || bsearch_leftmost(ctx.borrow_ret_names, cn) >= 0),
    _ => false
  }
}

/// #768 (heap-corruption root cause): a `let` whose value is an if/match and
/// whose scope-end drop is planned (rc_drop_names) consumes ONE reference per
/// EXECUTION -- but a branch tail that is a bare loop-borrowed ident (or a
/// projection off one) is a BORROWED read of a loop-carried binding, and the
/// static Perceus dup budget cannot cover per-iteration reads (same class as
/// #706's call-arg case, which dups at consuming call sites). Without a dup the
/// per-iteration drop eats the loop-carried reference itself: refcount reaches
/// 0 while the outer structure still points at the block, the free-list reuses
/// it, and the next allocation aliases live data (use-after-free observed as
/// the ensure_grouped_source_bucket / loader_manifest_sources_test corruption:
/// `let bucket = if cached { last } else { ensure(...) }` inside `while`).
/// This rewrite wraps exactly those branch tails in a codegen-internal
/// `__loop_tail_retain(x)` marker (compile_call emits value + guarded rc_dup),
/// so the drop consumes the dup instead. Tails bound INSIDE the branch (fresh
/// call results like the `ensure(...)` arm) are not loop-borrowed and stay
/// unwrapped -- no new retention on the owned path. Guarded dup no-ops on
/// scalars/non-RC values; worst case is the codebase-wide "leak, never corrupt"
/// trade.
fn retain_wrap_branch_tails(e: Expr, ctx: CompileCtx) -> Expr with Exception {
  match e {
    EIdent(x, p) => if array_contains_str(ctx.loop_borrowed_names, x) && !array_contains_str(ctx.ref_cell_names, x) {
      ECall(EIdent("__loop_tail_retain", -1), [EIdent(x, p)], -1)
    } else {
      e
    },
    EDot(_, _, _, _) => {
      let root = proj_root_ident(e)
      if String::length(root) > 0 && array_contains_str(ctx.loop_borrowed_names, root) && !array_contains_str(ctx.ref_cell_names, root) {
        ECall(EIdent("__loop_tail_retain", -1), [e], -1)
      } else {
        e
      }
    },
    EIf(c, t, el) => EIf(c, retain_wrap_branch_tails(t, ctx), retain_wrap_branch_tails(el, ctx)),
    EMatch(scrut, arms) => {
      if Array::length(arms) == 0 {
        e
      } else {
        let out = array_empty()
        let mut ai = 0
        while ai < Array::length(arms) {
          let (apat, abody) = Array::get(arms, ai)
          Array::push(out, (apat, retain_wrap_branch_tails(abody, ctx)))
          ai = ai + 1
        }
        EMatch(scrut, out)
      }
    },
    ELet(n, v, b, soff) => ELet(n, v, retain_wrap_branch_tails(b, ctx), soff),
    ELetMut(n, v, b, soff) => ELetMut(n, v, retain_wrap_branch_tails(b, ctx), soff),
    ESeq(a, b) => ESeq(a, retain_wrap_branch_tails(b, ctx)),
    EAssign(n, v, b) => EAssign(n, v, retain_wrap_branch_tails(b, ctx)),
    EAssignOp(n, op, v, b) => EAssignOp(n, op, v, retain_wrap_branch_tails(b, ctx)),
    _ => e
  }
}

/// #768 (companion to retain_wrap_branch_tails): true when an if/match VALUE
/// has at least one branch tail that is a BORROWED read -- a loop-borrowed /
/// borrow-bound bare ident, a projection, or a borrow-returning call. A `let`
/// bound to such a value is itself a (conditional) borrowed view, so it must be
/// marked borrow-bound for its body scope exactly like #708 marks a direct
/// `let x = Array::get(..)`: otherwise the borrow is laundered through the
/// alias chain and a consuming call's #706/#708 arg dup never fires (observed:
/// build_merged_stmts_inline's `let namespaced_stmts = if entry {
/// export_renamed } else { namespace(...) }` passed to an owning callee, whose
/// param drop freed the block `file_stmts` still owned -- the function-exit
/// recursive drop then double-freed it, shadow-trapped at that exact site).
/// The owned branch (fresh call result) sees at most an extra guarded dup at
/// consuming sites -- the codebase-wide "leak, never corrupt" trade.
fn value_has_borrowed_branch_tail(e: Expr, ctx: CompileCtx) -> Bool {
  match e {
    EIdent(x, _) => array_contains_str(ctx.loop_borrowed_names, x) && !array_contains_str(ctx.ref_cell_names, x),
    EDot(_, _, _, _) => true,
    ECall(callee, _, _) => match callee {
      EIdent(cn, _) => is_borrow_ret_builtin(cn) || bsearch_leftmost(ctx.borrow_ret_names, cn) >= 0,
      _ => false
    },
    EIf(_, t, el) => value_has_borrowed_branch_tail(t, ctx) || value_has_borrowed_branch_tail(el, ctx),
    EMatch(_, arms) => {
      let mut found = false
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, abody) = Array::get(arms, ai)
        if value_has_borrowed_branch_tail(abody, ctx) {
          found = true
          ai = Array::length(arms)
        } else {
          ai = ai + 1
        }
      }
      found
    },
    ELet(_, _, b, _) => value_has_borrowed_branch_tail(b, ctx),
    ELetMut(_, _, b, _) => value_has_borrowed_branch_tail(b, ctx),
    ESeq(_, b) => value_has_borrowed_branch_tail(b, ctx),
    EAssign(_, _, b) => value_has_borrowed_branch_tail(b, ctx),
    EAssignOp(_, _, _, b) => value_has_borrowed_branch_tail(b, ctx),
    _ => false
  }
}

/// Binder names of one match-arm pattern, or `false` when the shape is one
/// this cannot enumerate (`POr` and `PStruct` have no extractor in this
/// package). The caller then declines the arm rather than walking it with an
/// incomplete scope, which is the fail-closed direction: an unseen binder is
/// exactly the shadow the scope check exists to catch.
fn pvo_pat_binds(p: Pat, out: Array[String]) -> Bool with Exception {
  if is_pbind(p) {
    Array::push(out, get_pbind_name(p))
    true
  } else if is_pwild(p) || is_pint(p) || is_pbool(p) || is_pstring(p) {
    true
  } else if is_pctor(p) {
    let args = get_pctor_args(p)
    let mut ok = true
    let mut i = 0
    while i < Array::length(args) {
      if pvo_pat_binds(Array::get(args, i), out) {
        ()
      } else {
        ok = false
      }
      i = i + 1
    }
    ok
  } else if is_ptuple(p) {
    let ps = get_ptuple_pats(p)
    let mut ok = true
    let mut i = 0
    while i < Array::length(ps) {
      if pvo_pat_binds(Array::get(ps, i), out) {
        ()
      } else {
        ok = false
      }
      i = i + 1
    }
    ok
  } else {
    false
  }
}

/// #2389 per-path release: does this value hand the binding a reference the
/// scope OWNS -- the one the ordinary rule would have planned a scope-end drop
/// for, had the branch merge not zeroed the count?
///
/// Reads the value's RESULT SPINE recursively -- through block bodies (`let` /
/// `;` chains) and conditional branches -- and requires EVERY leaf to answer
/// yes. The recursion mirrors `value_has_borrowed_branch_tail` above, which is
/// the existing precedent for reading a `let` value this way. At each leaf it
/// is an ALLOW-LIST: a shape nobody enumerated fails closed, because a
/// denylist over an open set of shapes cannot be finished (this test began as
/// `expr_tag(value) != 8` and was holed twice in one review -- a call wrapped
/// in a block, and an `if` whose branches are calls, are neither tag 8).
///
/// Admitted:
///
/// - an allocation made at the SITE: a tuple, a record, an array literal, a
///   constructor call. Owned by construction.
/// - a call to a NAMED function whose DECLARED return type is heap
///   (`ctx.heap_ret_names`, #791's signature scan) and which neither returns a
///   borrow (#707's `borrow_ret_names` / the intrinsic set) nor may return an
///   interior view (#768's `borrow_view_ret`) -- and whose name is bound
///   NOWHERE that reaches this call. All three of those tables are keyed by
///   global name while the call dispatches to whatever the name resolves to
///   at the site, so a parameter or a local closure shadowing a
///   heap-returning global would otherwise be read through the global's
///   contract. The `agg_ret` lookup below excludes a local for the same
///   reason (#724 round 2).
///
///   Scope is read from TWO places because neither alone is complete.
///   `local_names` is the post-compilation array, and holds the binders of
///   any straight-line spine the value compiled through -- but a branch
///   truncates it (`compile_expr`'s if lowering restores `names_len_before`
///   before the else arm; `compile_match` does the same between arms), so a
///   shadow introduced INSIDE an arm is already gone from it when this runs.
///   `bound` is therefore rebuilt as the walk descends: each wrapper carries
///   its own binder into its body and each arm its pattern binds into that
///   arm, dropped again on the way out. An arm whose pattern this cannot
///   enumerate declines rather than being walked with an incomplete scope.
///   Measured: with the scope check removed, `let mk = (ys) -> Array::get(ys,
///   0); let t = mk(xs)` under a heap-returning global `mk` emits the guarded
///   drop for a binding holding an element `xs` owns (+18 B of code); no
///   arrangement of it was found that turns that into a wrong answer, so the
///   check is taken for the rule, not for a repro. That is the callee's own
///   contract, read off its signature -- NOT the "any ECall is heap" default
///   `classify_let_value_heap` falls back to. That default is an
///   over-approximation deliberately chosen because a dup/drop no-ops on what
///   it gets wrong (an even-tagged scalar, a string/bytes fat pointer). The
///   drop this pass gives back is no such no-op, so it reads a contract or
///   declines. `String` and `Bytes` are not heap to `type_expr_is_heap`, which
///   is the same answer `__rt_rc_drop` gives them (it returns early on a fat
///   pointer), so a `-> String` callee declines here and costs nothing.
///
/// Declined, each for its own reason: an INDIRECT call (there is no signature
/// to read); an alias or a projection (their reference is acquired by the
/// alias-dup / projection-dup machinery, whose own bookkeeping owns that
/// question); a literal or an arithmetic value (it holds no reference at all,
/// and `bench/exec/sort_ints.vibe`'s `let mid = (lo + hi) / 2` took a flag
/// local, two stores and a guarded `rc_drop` for a heap figure that did not
/// move -- 32,828 B either way -- and +2.84% fuel); a lambda; a loop; a
/// `handle`.
fn path_value_owned(e: Expr, local_names: Array[String], bound: Array[String], ctx: CompileCtx) -> Bool with Exception {
  match e {
    ETuple(_) => true,
    EArray(_) => true,
    ERecord(_, _, _) => true,
    ECall(callee, _, _) => match callee {
      EIdent(cn, _) => if is_ctor_call(e, ctx.ctor_table) {
        true
      } else {
        find_local_slot(local_names, cn) < 0 && !array_contains_str(bound, cn) && bsearch_leftmost(ctx.heap_ret_names, cn) >= 0 && !is_borrow_ret_builtin(cn) && bsearch_leftmost(ctx.borrow_ret_names, cn) < 0 && bsearch_leftmost(ctx.borrow_view_ret, cn) < 0
      },
      _ => false
    },
    EIf(_, t, el) => path_value_owned(t, local_names, bound, ctx) && path_value_owned(el, local_names, bound, ctx),
    // An arm-less match produces no value on any path, so there is nothing to
    // own; `&&` over zero arms would answer true.
    EMatch(_, arms) => if Array::length(arms) == 0 {
      false
    } else {
      let mut ok = true
      let mut i = 0
      while i < Array::length(arms) {
        let (ap, ab) = Array::get(arms, i)
        let mark = Array::length(bound)
        if pvo_pat_binds(ap, bound) && path_value_owned(ab, local_names, bound, ctx) {
          ()
        } else {
          ok = false
        }
        Array::truncate(bound, mark)
        i = i + 1
      }
      ok
    },
    ELet(n, _, b, _) => {
      let mark = Array::length(bound)
      Array::push(bound, n)
      let r = path_value_owned(b, local_names, bound, ctx)
      Array::truncate(bound, mark)
      r
    },
    ELetMut(n, _, b, _) => {
      let mark = Array::length(bound)
      Array::push(bound, n)
      let r = path_value_owned(b, local_names, bound, ctx)
      Array::truncate(bound, mark)
      r
    },
    ELetRec(n, _, b) => {
      let mark = Array::length(bound)
      Array::push(bound, n)
      let r = path_value_owned(b, local_names, bound, ctx)
      Array::truncate(bound, mark)
      r
    },
    ESeq(_, b) => path_value_owned(b, local_names, bound, ctx),
    EAssign(_, _, b) => path_value_owned(b, local_names, bound, ctx),
    EAssignOp(_, _, _, b) => path_value_owned(b, local_names, bound, ctx),
    _ => false
  }
}

/// #2733: does this value's RESULT SPINE hand the binding back a reference
/// the scope does not own?
///
/// Every borrow test in this file reads the value's TOP node, so a WRAPPER --
/// a block, i.e. an `ELet` / `ESeq` chain -- hides what the value actually
/// produces. `classify_let_value_heap` consults a callee only at
/// `expr_tag(value) == 8`, `value_has_borrowed_branch_tail` is consulted only
/// for an if/match value node, and `pctx_mark_view_call` matches an `ECall`
/// value only. The binding is then classified as owning a reference it never
/// acquired, and its scope-end drop frees an element the container still
/// owns -- silently, since `__rt_rc_drop` hands the block straight back to the
/// free list for the next allocation to reuse.
///
/// ANY leaf answering yes is enough. One drop is emitted for the binding, so
/// a single path that hands back a borrow makes that drop a premature free.
/// Unowned leaves:
///
/// - an identifier without an owned reference. For an enclosing binding, use
///   the heap ownership record used by the direct alias arm, excluding the
///   borrowed bindings handled by `value_has_borrowed_branch_tail`. Perceus
///   moves an owner's last reference into this result (or retains a non-last
///   use); an alias of a borrowed value has no such reference. For an inner
///   binder, `bound` / `bound_owned` carry the initializer's classification,
///   keeping a chain (`let t = <borrow>` then a branch returning `t`) borrowed.
/// - a projection (`EDot`): a field read is a view into its parent.
/// - a call to a borrow-returning builtin or to `borrow_ret_names`, matching
///   the direct-call arm of `classify_let_value_heap`. The planner separately
///   handles `borrow_view_ret` on straight-line spines; that conservative
///   may-view set is not a result-ownership contract for branch leaves.
/// - a match arm whose pattern `pvo_pat_binds` cannot enumerate: an unseen
///   binder is exactly the shadow this scope check exists to catch.
///
/// A leaf this cannot place keeps today's answer rather than flipping to
/// borrowed. `classify_let_value_heap` already defaults an unresolved call to
/// heap, and a drop on the scalar or string most of them return is a no-op;
/// widening that default is a separate change with its own measurement.
fn value_spine_borrowed(e: Expr, local_names: Array[String], bound: Array[String], bound_owned: Array[Int], ctx: CompileCtx) -> Bool with Exception {
  match e {
    EIdent(x, _) => {
      let bi = find_local_slot(bound, x)
      if bi < 0 {
        !array_contains_str(ctx.heap_binding_names, x) || (array_contains_str(ctx.loop_borrowed_names, x) && !array_contains_str(ctx.ref_cell_names, x))
      } else {
        Array::get(bound_owned, bi) == 0
      }
    },
    EDot(_, _, _, _) => true,
    ECall(callee, _, _) => match callee {
      EIdent(cn, _) => if is_ctor_call(e, ctx.ctor_table) {
        false
      } else if find_local_slot(bound, cn) >= 0 || find_local_slot(local_names, cn) >= 0 {
        // Keep the existing owning-call ABI for callbacks. A local spelling
        // cannot resolve through the global borrow-return tables.
        false
      } else {
        is_borrow_ret_builtin(cn) || bsearch_leftmost(ctx.borrow_ret_names, cn) >= 0
      },
      _ => false
    },
    EIf(_, t, el) => value_spine_borrowed(t, local_names, bound, bound_owned, ctx) || value_spine_borrowed(el, local_names, bound, bound_owned, ctx),
    EMatch(_, arms) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(arms) {
        let (ap, ab) = Array::get(arms, i)
        let mark = Array::length(bound)
        if pvo_pat_binds(ap, bound) {
          // bind_match_pat retains a payload when the arm consumes it. A
          // payload returned through this spine transfers that reference.
          vsb_pad_owned(bound, bound_owned, 1)
          if value_spine_borrowed(ab, local_names, bound, bound_owned, ctx) {
            found = true
          } else {
            ()
          }
        } else {
          found = true
        }
        Array::truncate(bound, mark)
        Array::truncate(bound_owned, mark)
        i = i + 1
      }
      found
    },
    ELet(n, v, b, _) => vsb_under_binder(n, v, b, local_names, bound, bound_owned, ctx),
    // A MUTABLE binder carries no borrow-ness. Its value can be replaced
    // after this walk records it -- `let mut t = <borrow>; t = <alloc>; t`
    // hands back the allocation, and an `EAssign` walks its continuation, not
    // its target -- so a flag taken from the initial value is a statement
    // about a value the binding may no longer hold. Recording it as owned is
    // today's answer and keeps the assignment from being able to invalidate
    // anything: only an `ELetMut` binder is assignable, so no flag this walk
    // does record can go stale. Measured at 80 B per iteration when it did;
    // the shape is `via_mut` in fixtures/rc_reclaim_leak_test.vibe.
    //
    // It is still PUSHED, so that a leaf spelling it reads this binder and
    // not an outer one this wrapper marked borrowed.
    ELetMut(n, _, b, _) => {
      let mark = Array::length(bound)
      Array::push(bound, n)
      Array::push(bound_owned, 1)
      let r = value_spine_borrowed(b, local_names, bound, bound_owned, ctx)
      Array::truncate(bound, mark)
      Array::truncate(bound_owned, mark)
      r
    },
    ELetRec(n, v, b) => vsb_under_binder(n, v, b, local_names, bound, bound_owned, ctx),
    ESeq(_, b) => value_spine_borrowed(b, local_names, bound, bound_owned, ctx),
    EAssign(_, _, b) => value_spine_borrowed(b, local_names, bound, bound_owned, ctx),
    EAssignOp(_, _, _, b) => value_spine_borrowed(b, local_names, bound, bound_owned, ctx),
    _ => false
  }
}

/// Extend `bound_owned` to `bound`'s length with `flag`, so the two stay
/// index-aligned after `pvo_pat_binds` has pushed an arm's binders.
fn vsb_pad_owned(bound: Array[String], bound_owned: Array[Int], flag: Int) -> Int {
  while Array::length(bound_owned) < Array::length(bound) {
    Array::push(bound_owned, flag)
  }
  0
}

/// Walk a binder's body with `n` recorded as owned or borrowed according to
/// its own value's spine. Pushed and truncated in lockstep with
/// `bound_owned`, so a name that shadows an outer binder of the other kind
/// answers for the inner one (`find_local_slot` takes the LAST match).
fn vsb_under_binder(n: String, v: Expr, b: Expr, local_names: Array[String], bound: Array[String], bound_owned: Array[Int], ctx: CompileCtx) -> Bool with Exception {
  // A bare projection is borrowed, but binding it emits an immediate retain
  // in classify_let_value_heap. The new name therefore owns its reference.
  let v_borrowed = !is_edot(v) && value_spine_borrowed(v, local_names, bound, bound_owned, ctx)
  let mark = Array::length(bound)
  Array::push(bound, n)
  if v_borrowed {
    Array::push(bound_owned, 0)
  } else {
    Array::push(bound_owned, 1)
  }
  let r = value_spine_borrowed(b, local_names, bound, bound_owned, ctx)
  Array::truncate(bound, mark)
  Array::truncate(bound_owned, mark)
  r
}

/// #768: apply the branch-tail retain rewrite (see retain_wrap_branch_tails)
/// when this binding's scope-end drop is planned AND we are inside a loop
/// (loop_borrowed_names non-empty -- empty outside loops and under bump, so
/// codegen elsewhere is byte-identical). Only if/match values are rewritten;
/// the top-level node kind is preserved, so classification of the ORIGINAL
/// `value` below stays valid.
fn retain_wrap_let_value(value: Expr, name: String, ctx: CompileCtx) -> Expr with Exception {
  if ctx.enable_rc && (expr_tag(value) == 7 || expr_tag(value) == 16) && Array::length(ctx.loop_borrowed_names) > 0 && array_contains_str(ctx.rc_drop_names, name) {
    retain_wrap_branch_tails(value, ctx)
  } else {
    value
  }
}

export fn compile_expr_tail(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let __tag = expr_tag(expr)
  if __tag == 9 {
    let name = get_elet_name(expr)
    let value = get_elet_val(expr)
    let body = get_elet_body(expr)
    let local_idx = next_local
    emit_dbg_line_stmt(buf, value, get_elet_off(expr), ctx)
    // #1120 Codex review (P1): the slot is pushed BEFORE the value compiles
    // (its index must be reserved), but a NON-RECURSIVE `let` binder is not
    // in scope inside its own initializer -- `let add = (x, y) -> Int {
    // add(x, y) }` deliberately means the BUILTIN add. Mask the name for the
    // duration of the value so nothing resolves to (or, since #1114, treats
    // as an enclosing shadow and captures) the not-yet-initialized slot; the
    // INDEX stays allocated, only the name is hidden, and it is restored
    // before the body compiles. `let rec` keeps its name visible -- that is
    // what makes self-reference work (see ctx.pending_letrec_self_name).
    Array::push(local_names, name)
    Array::set(local_names, local_idx, "")
    let nl = compile_expr(buf, retain_wrap_let_value(value, name, ctx), local_names, next_local + 1, ctx, ld)
    Array::set(local_names, local_idx, name)
    emit_local_set(buf, local_idx)
    let val_is_float = expr_is_floatish(value, local_names, ctx)
    if val_is_float {
      Array::push(ctx.float_local_slots, local_idx * 2 + 1)
    } else if slot_is_floatish(ctx, local_idx) {
      Array::push(ctx.float_local_slots, local_idx * 2)
    }
    // #678: log whether this binding holds a definitely-integral value, so a
    // later bare-ident `==` on it bypasses the string-pointer-misreading `eq`.
    // Always (re)log when the slot was previously classified, so a rebind of a
    // reused slot overrides the earlier entry. #769/#950 encoding: slot*4 +
    // kind (0 clear / 1 int / 2 string / 3 bool) -- see slot_is_intish.
    if expr_is_boolish(value, local_names, ctx) {
      Array::push(ctx.int_local_slots, local_idx * 4 + 3)
    } else if expr_is_intish(value, local_names, ctx) {
      Array::push(ctx.int_local_slots, local_idx * 4 + 1)
    } else if cc_expr_is_stringish(value, local_names, ctx) {
      Array::push(ctx.int_local_slots, local_idx * 4 + 2)
    } else if slot_is_intish(ctx, local_idx) || slot_is_stringish(ctx, local_idx) {
      Array::push(ctx.int_local_slots, local_idx * 4)
    }
    // #724: log this binding's AGGREGATE shape (tuple arity / ctor-record
    // field count) so `a == b` with both sides bound takes the structural
    // comparators. kind*64+n; 0 overrides a reused slot. See
    // CompileCtx.agg_local_slots.
    let agg_entry = if is_etuple(value) {
      64 + Array::length(get_etuple_elems(value))
    } else if is_ctor_call(value, ctx.ctor_table) {
      let cargs = get_ecall_args(value)
      // `S::{ ... }` sugar arrives as ECall(S, [ERecord]) — the runtime
      // field count is the record's, not the call arity.
      let fcnt = if Array::length(cargs) == 1 {
        match Array::get(cargs, 0) {
          ERecord(_, rfields, _) => Array::length(rfields),
          _ => Array::length(cargs)
        }
      } else {
        Array::length(cargs)
      }
      128 + fcnt
    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {
      128
    } else if is_erecord(value) {
      // Records are [tag@0][len@4][fields@8+] since #722, walkable like ctors.
      match value {
        ERecord(_, rfields, _) => 128 + Array::length(rfields),
        _ => 0
      }
    } else if expr_tag(value) == 8 {
      // #724 round 2: `let a = f(..)` — classify by f's DECLARED return type
      // (agg_ret table). Only for a global fn name (a local shadowing `f`
      // makes this a closure call of unknown type).
      match get_ecall_callee(value) {
        EIdent(cfn, _) => if find_local_slot(local_names, cfn) < 0 {
          let rinfo = agg_ret_lookup_indexed(ctx.agg_ret_names_sorted, ctx.agg_ret_names_sorted_pos, ctx.agg_ret_infos, cfn)
          if rinfo > 0 {
            rinfo
          } else {
            0
          }
        } else {
          0
        },
        _ => 0
      }
    } else if is_eident(value) {
      // Alias of a tracked binding: propagate its shape.
      let src_slot = find_local_slot(local_names, get_eident_name(value))
      if src_slot >= 0 {
        let src_info = agg_slot_lookup(ctx.agg_local_slots, src_slot)
        if src_info > 0 {
          src_info
        } else {
          0
        }
      } else {
        0
      }
    } else {
      0
    }
    // #672 (post-#724): the shape LITERAL backing `agg_entry`, kept in
    // lockstep with agg_local_slots (see CompileCtx.agg_local_exprs) so a
    // both-sides-tracked `a == b` can recurse into NESTED aggregate elements
    // (e.g. `let a = ((1,2),3)`) instead of only comparing the top-level
    // shape. An alias propagates its SOURCE's shape expr (not just the
    // kind+n int); everything else that isn't a literal (call-result via
    // agg_ret, round-2 param/return tracking) has no literal to recurse
    // into, so it stores the inert EInt(0) placeholder — those tracked
    // slots still get correct TOP-level structural comparison (unchanged
    // from before this change) but nested elements under them keep the
    // pre-existing generic-eq fallback.
    let agg_shape_expr = if is_etuple(value) {
      value
    } else if is_ctor_call(value, ctx.ctor_table) {
      value
    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {
      value
    } else if is_erecord(value) {
      value
    } else if is_eident(value) {
      let src_slot = find_local_slot(local_names, get_eident_name(value))
      if src_slot >= 0 {
        agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, src_slot)
      } else {
        EInt(0)
      }
    } else {
      EInt(0)
    }
    Array::push(ctx.agg_local_slots, local_idx * 256 + agg_entry)
    Array::push(ctx.agg_local_exprs, agg_shape_expr)
    let (rc_kind, is_borrow_ret_ext) = classify_let_value_heap(buf, value, name, local_idx, local_names, ctx)
    if ctx.enable_rc && rc_kind > 0 {
      let mut dbi = 0
      while dbi < Array::length(ctx.rc_dup_names) {
        if Array::get(ctx.rc_dup_names, dbi) == name {
          emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow, ctx.rc_dup_func_idx)
        } else {
          ()
        }
        dbi = dbi + 1
      }
    } else {
      ()
    }
    // #712: this `let` may SHADOW an outer loop-borrowed identifier of the same
    // name (e.g. `while ... { let x = ...; f(x) }` rebinding `x` inside a loop
    // whose header already loop-borrowed an outer `x`, #706). cc_is_loop_borrowed_ident
    // (compile_call.vibe) matches by NAME ONLY, so without this an owning call on
    // the INNER `x` would be mistaken for a reference to the OUTER loop-carried
    // one -- a spurious rc_dup now, and (via loop_consumed_names) a spurious extra
    // epilogue rc_drop for a parameter this `let` never touches. Mask every
    // existing occurrence of `name` out of loop_borrowed_names for exactly the
    // scope of `body`, then restore the same count after; membership is all
    // `array_contains_str` ever tests, so compacting out of order is safe.
    let mut lb_shadow_removed = 0
    if ctx.enable_rc {
      let lb_arr = ctx.loop_borrowed_names
      let lb_n = Array::length(lb_arr)
      let mut lb_w = 0
      let mut lb_i = 0
      while lb_i < lb_n {
        let e = Array::get(lb_arr, lb_i)
        if e == name {
          lb_shadow_removed = lb_shadow_removed + 1
        } else {
          Array::set(lb_arr, lb_w, e)
          lb_w = lb_w + 1
        }
        lb_i = lb_i + 1
      }
      Array::truncate(lb_arr, lb_w)
    } else {
      ()
    }
    // #708 follow-up: scope `name` into loop_borrowed_names for exactly the
    // extent of `body`'s compilation (push before, truncate after), so a bare
    // later reference to a borrow-bound name gets the same retain-before-
    // owning-call treatment a loop-carried parameter already gets. Safe to do
    // even outside a loop (loop_borrowed_names is otherwise empty there, and
    // this push/truncate pair never leaks past this let's own body).
    let lb_mark = Array::length(ctx.loop_borrowed_names)
    // #768: an if/match value with a borrowed branch tail makes this binding a
    // (conditional) borrowed view too -- mark it borrow-bound for the body
    // scope so consuming calls dup it (see value_has_borrowed_branch_tail).
    let value_borrow_like = ctx.enable_rc && (expr_tag(value) == 7 || expr_tag(value) == 16) && value_has_borrowed_branch_tail(value, ctx)
    if ctx.enable_rc && (is_borrow_ret_ext || value_borrow_like) {
      Array::push(ctx.loop_borrowed_names, name)
    } else {
      ()
    }
    // ADR-0092 Phase 1 (drop-guided reuse): when this binding's planned
    // scope-end drop can move to last use inside a body that is EXACTLY
    // `match name { ... }`, stage the fusion — allocate a flag local
    // (0 = not reused on the taken path) and expose (name, flag) to
    // compile_match via the ctx stacks (push/truncate, loop_borrowed_names
    // discipline). An arm that consumes the unique block in place sets the
    // flag; the scope-end drop below is then guarded on it, so every path
    // still consumes exactly one reference.
    let reuse_fusion = ctx.enable_rc && rc_kind > 0 && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.rc_drop_names, name) && expr_tag(body) == 16 && is_eident(get_match_scrutinee(body)) && get_eident_name(get_match_scrutinee(body)) == name
    let reuse_flag_l = if reuse_fusion {
      Array::push(local_names, "__reuse_flag")
      emit_i64_const(buf, 0)
      emit_local_set(buf, nl)
      Array::push(ctx.reuse_scrutinee_names, name)
      Array::push(ctx.reuse_flag_locals, nl)
      nl
    } else {
      0 - 1
    }
    let nl_after_reuse = if reuse_fusion {
      nl + 1
    } else {
      nl
    }
    // #2389 per-path release: a branch merge planned this binding's scope-end
    // drop away because SOME branch spends its initial reference, so the
    // branches that do not spend it never release the value. Give the drop
    // back, guarded by a flag local the plan's marked occurrences set (see
    // compile_expr's EIdent case) -- 0 at the scope end means this path still
    // holds the reference. Disjoint from the reuse fusion above by
    // construction: a path-drop binding has no planned PaDrop, which that
    // fusion requires.
    //
    // Two conditions beyond the plan's own, both about whether the INITIAL
    // reference is one this binding really holds:
    //
    // - not a borrow-bound binding (#708/#768: a borrow-returning call, or an
    //   if/match whose branch tail is borrowed). It holds a reference it never
    //   acquired, exactly as the ordinary scope-end drop below leaves it to
    //   loop_borrowed_names.
    // - every leaf of the value's RESULT SPINE is a reference this scope owns
    //   (`path_value_owned` above, an allow-list read through block bodies and
    //   conditional branches).
    //
    // - not an Int-valued binding: it holds no reference at all, so a guarded
    //   drop over it is pure instruction cost. Redundant under the allow-list
    //   for the forms it admits, kept because it is the reason a value holding
    //   no reference must never be guarded (see `path_value_owned`).
    //
    // - the flag local's index is the one `local_names` is about to record it
    //   at. `local_names` is indexed BY wasm local index, and the value's own
    //   compile may have taken scratch locals without naming them, so the
    //   allocation below pads up to `nl_after_reuse` first. Padding cannot fix
    //   the other direction: an array already LONGER than the index would put
    //   the flag's name at one position and its slot at another, and from
    //   there every later binding reads a slot that is not its own -- wrong
    //   values, no trap. No shape was found that reaches it; it costs one
    //   comparison and turns a silent aliasing bug into a declined binding.
    //
    // Ordered so the plan-row membership test comes BEFORE the spine walk:
    // `&&` short-circuits (compile_expr's own lowering for it does), and
    // `rc_path_drop_names` holds only the split bindings of the function being
    // compiled -- so a `let` that is not in it, which is almost every `let` in
    // the program and every one on the bump lane, never pays for
    // `path_value_owned`. Every operand is pure, so the order is a cost
    // choice only.
    //
    // The binding's OWN slot is masked for the scope read, exactly as it is
    // masked while the value compiles above (#1120): a non-recursive `let`
    // binder is not in scope inside its own initializer, so `let mk = mk(i)`
    // calls the GLOBAL `mk`. `local_names[local_idx]` has been restored by
    // now, so without the mask `find_local_slot` finds this binding itself and
    // declines a result the callee's contract says is owned -- the safe
    // direction, but it keeps the leak this pass exists to remove. Measured:
    // with the mask removed, `let mk = mk(3)` under a heap-returning global
    // `mk` compiles 18 B smaller, which is the guarded drop not being emitted.
    let pd_candidate = ctx.enable_rc && rc_kind > 0 && ctx.rc_drop_func_idx >= 0 && !is_borrow_ret_ext && !value_borrow_like && array_contains_str(ctx.rc_path_drop_names, name)
    let path_value_ok = if pd_candidate {
      let pd_self = Array::get(local_names, local_idx)
      Array::set(local_names, local_idx, "")
      let r = path_value_owned(value, local_names, array_empty(), ctx)
      Array::set(local_names, local_idx, pd_self)
      r
    } else {
      false
    }
    let path_drop = pd_candidate && path_value_ok && !expr_is_intish(value, local_names, ctx) && Array::length(local_names) <= nl_after_reuse
    let path_flag_l = if path_drop {
      // The flag takes a wasm local of its own, so `local_names` gains its
      // entry here -- through the same helper the scope-end promotion below
      // uses, which is what keeps the two copies of this discipline from
      // drifting apart again (#2792 was one of them forgetting). `path_drop`
      // above already established that the array does not run PAST this index,
      // the one direction padding cannot repair.
      cet_record_local_slot(local_names, nl_after_reuse)
      emit_i64_const(buf, 0)
      emit_local_set(buf, nl_after_reuse)
      Array::push(ctx.rc_path_flag_names, name)
      Array::push(ctx.rc_path_flag_locals, nl_after_reuse)
      nl_after_reuse
    } else {
      0 - 1
    }
    let nl_body = if path_drop {
      nl_after_reuse + 1
    } else {
      nl_after_reuse
    }
    let nl2 = compile_expr(buf, body, local_names, nl_body, ctx, ld)
    if path_drop {
      Array::truncate(ctx.rc_path_flag_names, Array::length(ctx.rc_path_flag_names) - 1)
      Array::truncate(ctx.rc_path_flag_locals, Array::length(ctx.rc_path_flag_locals) - 1)
      emit_local_get(buf, path_flag_l)
      emit_i64_eqz(buf)
      emit_if_void(buf)
      emit_local_get(buf, local_idx)
      emit_call(buf, ctx.rc_drop_func_idx)
      emit_end(buf)
    } else {
      ()
    }
    if reuse_fusion {
      Array::truncate(ctx.reuse_scrutinee_names, Array::length(ctx.reuse_scrutinee_names) - 1)
      Array::truncate(ctx.reuse_flag_locals, Array::length(ctx.reuse_flag_locals) - 1)
    } else {
      ()
    }
