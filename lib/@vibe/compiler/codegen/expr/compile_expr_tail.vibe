//# Functions

// ADR-0055 tag repair for compound assignment: under RC both operands are
// tagged (n<<1), so `+`, `-`, `%` preserve the tag for free, but `*` yields
// ab<<2 (shift right once) and `/` yields a/b untagged (shift left once).
// The raw emit_assignop_op alone silently doubled `x *= 2` results under RC.
let emit_assignop_rc_tag_fix: (Bytes, Bool, String) -> Unit = (buf, enable_rc, op) -> {
  if enable_rc && op == "*" {
    emit_i64_const(buf, 1)
    emit_i64_shr_s(buf)
  } else if enable_rc && op == "/" {
    emit_i64_const(buf, 1)
    emit_i64_shl(buf)
  } else {
    ()
  }
}


// Interior-line breakpoints (span-arc step5): when break-mode line instrumentation
// is active (ctx.dbg_line_idx >= 0), emit `i32.const <line>` + `call dbg_line` for
// the statement whose value subexpression is `value`, deriving the 1-based source
// line from the value's first offset. No-op when off or when no offset is found,
// so the default codegen path is byte-identical. Stack-neutral: dbg_line is
// `(i32) -> ()`, the i32 const it consumes leaves the stack unchanged.
let emit_dbg_line_for: (Bytes, Expr, CompileCtx) -> Unit = (buf, value, ctx) -> {
  emit_dbg_line_stmt(buf, value, -1, ctx)
}

// #644: like emit_dbg_line_for, but with the STATEMENT's own source offset as
// the fallback anchor. `let a = 1` binds a bare literal whose subexpression
// carries no offset (first_offset = -1) -- the ELet/ELetMut node's stmt offset
// (the `let` keyword token) still locates the line, so the probe is emitted
// and the line is breakpoint-able.
let emit_dbg_line_stmt: (Bytes, Expr, Int, CompileCtx) -> Unit = (buf, value, stmt_off, ctx) -> {
  if ctx.dbg_line_idx >= 0 {
    let voff = first_offset(value)
    let off = if voff >= 0 { voff } else { stmt_off }
    if off >= 0 {
      let line = offset_to_line(ctx.dbg_line_nl, off)
      emit_i32_const(buf, ctx.dbg_line_file_id)
      emit_i32_const(buf, line)
      emit_call(buf, ctx.dbg_line_idx)
    } else {
      ()
    }
  } else {
    ()
  }
}

let is_edot: (Expr) -> Bool = (e) -> {
  match e {
    EDot(_, _, _, _) => true,
    _ => false
  }
}

let efn_is_capturing: (Expr, CompileCtx) -> Bool with { Error } = (value, ctx) -> {
  let params = get_efn_params(value)
  let pnames = Array::slice([
    ""
  ], 0, 0)
  let mut pi = 0
  while pi < Array::length(params) {
    let (pn, _) = Array::get(params, pi)
    Array::push(pnames, pn)
    pi = pi + 1
  }
  let caps = collect_free_vars_indexed(get_efn_body(value), pnames, ctx.capture_name_index)
  Array::length(caps) > 0
}

let slot_is_floatish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {
  let arr = ctx.float_local_slots
  let mut j = Array::length(arr) - 1
  let mut result = false
  while j >= 0 {
    let entry = Array::get(arr, j)
    if entry / 2 == slot {
      result = (entry % 2) == 1
      j = -1
    } else {
      j = j - 1
    }
  }
  result
}

// #678: is the local in `slot` known to hold an Int/Bool? Mirrors
// slot_is_floatish over ctx.int_local_slots. #769 encoding: `slot*4 + kind`,
// kind 0 = cleared (non-int rebind of a reused slot), 1 = Int, 3 = Bool --
// bit 0 still means "intish" (both 1 and 3), so every pre-existing intish
// consumer is unchanged, while kind 3 additionally lets `__to_string` format
// a bool-bound IDENT as "true"/"false" (the #784/#785-P2 gap: `let b = true;
// "\{b}"` printed the raw integer). Most-recent entry wins; the log is pruned
// at branch/arm boundaries (int_log_reset_above) so a slot reused by a
// non-`let` binder reads false here rather than a stale entry.
let slot_is_intish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {
  let arr = ctx.int_local_slots
  let mut j = Array::length(arr) - 1
  let mut result = false
  while j >= 0 {
    let entry = Array::get(arr, j)
    if entry / 4 == slot {
      result = (entry % 2) == 1
      j = -1
    } else {
      j = j - 1
    }
  }
  result
}

// #769: is the local in `slot` known to hold specifically a Bool (kind 3)?
let slot_is_boolish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {
  let arr = ctx.int_local_slots
  let mut j = Array::length(arr) - 1
  let mut result = false
  while j >= 0 {
    let entry = Array::get(arr, j)
    if entry / 4 == slot {
      result = (entry % 4) == 3
      j = -1
    } else {
      j = j - 1
    }
  }
  result
}

// #769: does `e` statically evaluate to a Bool? Bool literals, comparison /
// logical operators, `!`, and -- via the kind-3 slot log above -- a bare ident
// `let`-bound to a boolish value. Syntactic over-approximation like
// expr_is_intish; consumers use it only to pick "true"/"false" formatting.
export let rec expr_is_boolish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {
  let tag = expr_tag(e)
  if tag == 1 {
    true
  } else if tag == 4 {
    let nm = get_eident_name(e)
    let mut i = Array::length(local_names) - 1
    let mut slot = -1
    while i >= 0 {
      if Array::get(local_names, i) == nm {
        slot = i
        i = -1
      } else {
        i = i - 1
      }
    }
    if slot >= 0 {
      slot_is_boolish(ctx, slot)
    } else {
      false
    }
  } else if tag == 5 {
    let op = get_ebinop_op(e)
    op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&&" || op == "||"
  } else if tag == 6 {
    get_eunaryop_op(e) == "!"
  } else {
    false
  }
}

// Blocker-3 (ADR-0055): does `e` statically evaluate to an f64 bit pattern?
// Syntactic over-approximation (the AST is untyped): float literals, float
// arithmetic / comparison over floatish operands, float-producing conversions,
// and — crucially — a *variable* bound to a floatish value (tracked in
// ctx.float_local_slots as `let`s compile). This lets `let x = 1.5; x + y`
// take the f64 path. Shared by compile_expr (binop/unary instruction choice)
// and the `let` handler below (which populates float_local_slots).
export let rec expr_is_floatish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {
  // fbox (#797): `t.N` tuple projection survives to codegen as EDot (expr_tag
  // -1), NOT as __rec_field (that lowering is only produced for tuple
  // DESTRUCTURING and record-pattern desugars). Heap fields store floats as
  // raw f64 bits (boxed under RC), so the reader must recover float-ness
  // statically -- without this, `let t = (1.5, 2.5); t.0 + t.1` integer-adds
  // two bit patterns into NaN and Double::to_int traps. The #724 agg log
  // keeps the backing ETuple expression per slot; recurse into the projected
  // element. Untracked bindings stay false (same over-approximation as the
  // rest of this predicate).
  let dot_float = match e {
    EDot(dobj, dfield, _, _) => {
      let fc = String::char_code_at(dfield, 0)
      if fc >= 48 && fc <= 57 && is_eident(dobj) {
        let slot = find_local_slot(local_names, get_eident_name(dobj))
        if slot >= 0 {
          let info = agg_slot_lookup(ctx.agg_local_slots, slot)
          if info >= 0 && info / 64 == 1 {
            let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)
            if is_etuple(backing) {
              let elems = get_etuple_elems(backing)
              let mut k = 0
              let mut fp = 0
              while fp < String::length(dfield) {
                k = k * 10 + (String::char_code_at(dfield, fp) - 48)
                fp = fp + 1
              }
              if k >= 0 && k < Array::length(elems) {
                expr_is_floatish(Array::get(elems, k), local_names, ctx)
              } else {
                false
              }
            } else {
              false
            }
          } else {
            false
          }
        } else {
          false
        }
      } else {
        false
      }
    },
    _ => false
  }
  let tag = expr_tag(e)
  if dot_float {
    true
  } else if tag == 2 {
    true
  } else if tag == 4 {
    let nm = get_eident_name(e)
    let len = Array::length(local_names)
    let mut i = len - 1
    let mut slot = -1
    while i >= 0 {
      if Array::get(local_names, i) == nm {
        slot = i
        i = -1
      } else {
        i = i - 1
      }
    }
    if slot >= 0 {
      slot_is_floatish(ctx, slot)
    } else {
      false
    }
  } else if tag == 5 {
    let op = get_ebinop_op(e)
    // #744: arithmetic only. A float COMPARISON (`n < 0.0`) yields a Bool —
    // including `<`/`>`/`<=`/`>=` here marked a let-bound comparison result
    // as floatish, and a later `neg && ...` on that Bool took the float binop
    // path and threw "unsupported float binop: &&".
    if op == "+" || op == "-" || op == "*" || op == "/" {
      expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)
    } else {
      false
    }
  } else if tag == 6 {
    let op = get_eunaryop_op(e)
    if op == "-" {
      expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)
    } else {
      false
    }
  } else if tag == 8 {
    let callee = get_ecall_callee(e)
    if is_eident(callee) {
      let fname = get_eident_name(callee)
      if fname == "Int::to_double" || fname == "Int::to_float" || fname == "Float::to_double" || fname == "Double::to_float" || fname == "Double::from_i64_bits" {
        true
      } else if fname == "__rec_field" {
        // fbox (#797): `t.0` on a TRACKED tuple-literal binding (`let t =
        // (1.5, 2.5)`). Heap fields store floats as RAW f64 bits, so the
        // reader must recover float-ness statically -- without this, `t.0 +
        // t.1` integer-adds two bit patterns into NaN and `Double::to_int`
        // traps ("invalid conversion to integer"). The #724 agg log already
        // keeps the backing ETuple expression per slot; recurse into the
        // projected element. Non-literal / untracked bindings stay false
        // (same over-approximation as the rest of this predicate).
        let args = get_ecall_args(e)
        if Array::length(args) == 2 && is_eident(Array::get(args, 0)) && expr_tag(Array::get(args, 1)) == 0 {
          let slot = find_local_slot(local_names, get_eident_name(Array::get(args, 0)))
          if slot >= 0 {
            let info = agg_slot_lookup(ctx.agg_local_slots, slot)
            if info >= 0 && info / 64 == 1 {
              let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)
              if is_etuple(backing) {
                let elems = get_etuple_elems(backing)
                let k = get_eint_value(Array::get(args, 1))
                if k >= 0 && k < Array::length(elems) {
                  expr_is_floatish(Array::get(elems, k), local_names, ctx)
                } else {
                  false
                }
              } else {
                false
              }
            } else {
              false
            }
          } else {
            false
          }
        } else {
          false
        }
      } else {
        false
      }
    } else {
      false
    }
  } else {
    false
  }
}

// #678: is `e` unambiguously an integer/bool scalar — never a string or float?
// Such an operand makes `==`/`!=` a direct i64.eq instead of the polymorphic
// `eq` builtin, whose string fall-back misreads a large integer as a string
// fat-pointer `(ptr<<32)|len` (two unequal ints with a zero low word compare
// EQUAL). Integral by SHAPE: literals, bitwise/comparison/logical operators,
// non-float arithmetic. A bare identifier is integral when its slot was bound
// to a definitely-integral value (ctx.int_local_slots, the dual of
// expr_is_floatish) — sound because that log is pruned at every branch/arm
// boundary (int_log_reset_above), so a slot reused by a non-`let` binder
// holding a string is never read as int. Unclassified operands (a call return,
// an untracked param/capture) stay false and fall back to the bounds-guarded
// `eq` — the narrow remaining residual.
export let expr_is_intish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {
  let tag = expr_tag(e)
  if tag == 0 {
    true
  } else if tag == 1 {
    true
  } else if tag == 4 {
    let nm = get_eident_name(e)
    let len = Array::length(local_names)
    let mut i = len - 1
    let mut slot = -1
    while i >= 0 {
      if Array::get(local_names, i) == nm {
        slot = i
        i = -1
      } else {
        i = i - 1
      }
    }
    if slot >= 0 {
      slot_is_intish(ctx, slot)
    } else {
      false
    }
  } else if tag == 5 {
    let op = get_ebinop_op(e)
    if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" || op == "%" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "==" || op == "!=" || op == "&&" || op == "||" {
      true
    } else if op == "+" || op == "-" || op == "*" || op == "/" {
      !expr_is_floatish(e, local_names, ctx)
    } else {
      false
    }
  } else if tag == 6 {
    let op = get_eunaryop_op(e)
    op == "!"
  } else {
    false
  }
}


let assign_value_mentions: (Expr, String) -> Bool = (value, name) -> {
  let empty1 = Array::slice([
    ""
  ], 0, 0)
  let empty2 = Array::slice([
    ""
  ], 0, 0)
  array_contains_str(collect_free_vars(value, empty1, empty2), name)
}

let rec reassign_carry_safe: (Expr, String) -> Bool = (e, name) -> {
  if !assign_value_mentions(e, name) {
    true
  } else {
    match e {
      EIdent(_, _) => true,
      EDot(_, _, _, _) => proj_root_ident(e) == name,
      EBinOp(_, l, r) => reassign_carry_safe(l, name) && reassign_carry_safe(r, name),
      EUnaryOp(_, x) => reassign_carry_safe(x, name),
      _ => false
    }
  }
}

let emit_rc_value_ptr_i32: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {
  emit_local_get(buf, local_idx)
  if tagged {
    emit_i64_const(buf, -2)
    emit_i64_and(buf)
  } else {
    ()
  }
  emit_i32_wrap_i64(buf)
}

let emit_rc_drop_local: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {
  // #720: a saturated rc (low 24 bits == 0xFFFFFF) marks an immortal block
  // (see emit_rc_word_inc_saturating) -- never decrement, never free.
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 16777215)
  bytebuf_push(buf, 113)
  emit_i32_const(buf, 16777215)
  emit_i32_ne(buf)
  emit_if_void(buf)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 1)
  emit_i32_sub(buf)
  emit_i32_store(buf, 2, 0)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 256)
  emit_i32_mul(buf)
  emit_i32_eqz(buf)
  emit_if_void(buf)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_global_get(buf, 2)
  emit_i32_store(buf, 2, 0)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_global_set(buf, 2)
  emit_end(buf)
  emit_end(buf)
}

let reassign_self_reusable: (Expr, String) -> Bool with { Error } = (value, name) -> {
  if is_etuple(value) {
    let elems = get_etuple_elems(value)
    let mut i = 0
    let mut ok = true
    while i < Array::length(elems) {
      if !reassign_carry_safe(Array::get(elems, i), name) {
        ok = false
      } else {
        ()
      }
      i = i + 1
    }
    ok
  } else {
    false
  }
}

// #791: shared RC heap-classification for a `let`/`let mut` binding's INITIAL
// value, extracted so ELet (tag 9) and ELetMut (tag 11) can never drift apart
// again -- the entire #715/#791 bug family was ELetMut silently missing shape
// coverage (EIf/EMatch/ELet/ESeq/EDot/EFn/generic-ECall) that ELet already
// had, one shape re-discovered and patched at a time without ever being
// ported to the sibling form. Requires `value` to already be compiled and
// stored into `local_idx` (so the is_edot/is_eident-alias branches' immediate
// `emit_rc_dup_guarded(buf, local_idx, ...)` targets the right local) --
// call this AFTER `compile_expr(buf, value, ...)` + the corresponding
// `emit_local_set`/`emit_local_tee`, never before. Pushes `name` into
// `ctx.heap_binding_names` whenever the value's shape can't be proven scalar;
// over-classifying is a leak/no-op at worst (guarded dup/drop no-ops on a
// tagged-even scalar), under-classifying is the corruption class both issues
// hit. Returns (rc_kind, is_borrow_ret_ext) exactly as the original inline
// ELet chain did, for callers that still need those (loop_borrowed_names
// scoping for a borrow-returning call's alias).
let classify_let_value_heap: (Bytes, Expr, String, Int, Array[String], CompileCtx) -> (Int, Bool) with { Error } = (buf, value, name, local_idx, local_names, ctx) -> {
  let mut rc_kind = 0
  let mut is_borrow_ret_ext = false
  if ctx.enable_rc {
    if expr_is_floatish(value, local_names, ctx) {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if is_etuple(value) {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if is_earray(value) {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if is_erecord(value) {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if is_ctor_call(value, ctx.ctor_table) {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if is_eident(value) {
      let src = get_eident_name(value)
      if array_contains_str(ctx.heap_binding_names, src) {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
        if array_contains_str(ctx.rc_alias_dup_names, name) {
          emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)
        } else {
          ()
        }
      } else {
        ()
      }
    } else if expr_tag(value) == 8 {
      let callee = get_ecall_callee(value)
      let is_borrow_ret = if is_eident(callee) {
        let cn = get_eident_name(callee)
        cn == "Array::get" || cn == "__index" || cn == "Map::get" || cn == "__rec_field" || array_contains_str(ctx.borrow_ret_names, cn)
      } else {
        false
      }
      // #791: consult the DECLARED return-type table (compute_heap_returning,
      // built once from a syntactic scan of top-level signatures -- see its
      // doc comment) before falling back to the blanket "any ECall is heap"
      // default. This makes the common `let mut s = Set::new()` case
      // precise (uses the function's OWN declared `-> Set[T]` signature)
      // instead of over-approximating every call, without needing full
      // checker-inferred types threaded through codegen.
      let is_declared_heap_ret = if is_eident(callee) {
        array_contains_str(ctx.heap_ret_names, get_eident_name(callee))
      } else {
        false
      }
      let is_builtin_scalar_ret = if is_eident(callee) {
        let cn = get_eident_name(callee)
        let is_always_registered = cn == "Array::length" || cn == "Bytes::length" || cn == "String::length" || cn == "eq"
        let is_user_shadowed = !is_always_registered && array_contains_str(ctx.func_table.names, cn)
        !is_user_shadowed && (cn == "Array::length" || cn == "Bytes::length" || cn == "String::length" || cn == "Map::has_key" || cn == "Array::contains" || cn == "eq" || cn == "not" || cn == "add" || cn == "sub" || cn == "mul" || cn == "lt")
      } else {
        false
      }
      let is_scalar_ret = if is_eident(callee) {
        array_contains_str(ctx.scalar_ret_names, get_eident_name(callee)) || is_builtin_scalar_ret
      } else {
        false
      }
      if is_borrow_ret || is_scalar_ret {
        ()
      } else if is_declared_heap_ret {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else {
        // No declared signature resolved either way (unannotated callee, a
        // local closure, or a shadowed/unresolved name) -- default to heap,
        // same "leak/no-op at worst" over-approximation the rest of this
        // chain already relies on.
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      }
      is_borrow_ret_ext = is_borrow_ret
    } else if is_edot(value) {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
      emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)
    } else if is_efn(value) {
      if efn_is_capturing(value, ctx) {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else {
        ()
      }
    } else if expr_tag(value) == 7 {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if expr_tag(value) == 16 {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else if expr_tag(value) == 9 || expr_tag(value) == 14 {
      rc_kind = 2
      Array::push(ctx.heap_binding_names, name)
    } else {
      let __sf_tag = expr_tag(value)
      if is_eident(value) || __sf_tag == 0 || __sf_tag == 1 || __sf_tag == 2 || __sf_tag == 3 || __sf_tag == 22 {
        ()
      } else {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      }
    }
  } else {
    ()
  }
  (rc_kind, is_borrow_ret_ext)
}

// #768 (heap-corruption root cause): a `let` whose value is an if/match and
// whose scope-end drop is planned (rc_drop_names) consumes ONE reference per
// EXECUTION -- but a branch tail that is a bare loop-borrowed ident (or a
// projection off one) is a BORROWED read of a loop-carried binding, and the
// static Perceus dup budget cannot cover per-iteration reads (same class as
// #706's call-arg case, which dups at consuming call sites). Without a dup the
// per-iteration drop eats the loop-carried reference itself: refcount reaches
// 0 while the outer structure still points at the block, the free-list reuses
// it, and the next allocation aliases live data (use-after-free observed as
// the ensure_grouped_source_bucket / loader_manifest_sources_test corruption:
// `let bucket = if cached { last } else { ensure(...) }` inside `while`).
// This rewrite wraps exactly those branch tails in a codegen-internal
// `__loop_tail_retain(x)` marker (compile_call emits value + guarded rc_dup),
// so the drop consumes the dup instead. Tails bound INSIDE the branch (fresh
// call results like the `ensure(...)` arm) are not loop-borrowed and stay
// unwrapped -- no new retention on the owned path. Guarded dup no-ops on
// scalars/non-RC values; worst case is the codebase-wide "leak, never corrupt"
// trade.
let rec retain_wrap_branch_tails: (Expr, CompileCtx) -> Expr with { Error } = (e, ctx) -> {
  match e {
    EIdent(x, p) => if array_contains_str(ctx.loop_borrowed_names, x) && !array_contains_str(ctx.ref_cell_names, x) {
      ECall(EIdent("__loop_tail_retain", -1), [
        EIdent(x, p)
      ], -1)
    } else {
      e
    },
    EDot(_, _, _, _) => {
      let root = proj_root_ident(e)
      if String::length(root) > 0 && array_contains_str(ctx.loop_borrowed_names, root) && !array_contains_str(ctx.ref_cell_names, root) {
        ECall(EIdent("__loop_tail_retain", -1), [
          e
        ], -1)
      } else {
        e
      }
    },
    EIf(c, t, el) => EIf(c, retain_wrap_branch_tails(t, ctx), retain_wrap_branch_tails(el, ctx)),
    EMatch(scrut, arms) => {
      if Array::length(arms) == 0 {
        e
      } else {
        let out = Array::slice([
          Array::get(arms, 0)
        ], 0, 0)
        let mut ai = 0
        while ai < Array::length(arms) {
          let (apat, abody) = Array::get(arms, ai)
          Array::push(out, (apat, retain_wrap_branch_tails(abody, ctx)))
          ai = ai + 1
        }
        EMatch(scrut, out)
      }
    },
    ELet(n, v, b, soff) => ELet(n, v, retain_wrap_branch_tails(b, ctx), soff),
    ELetMut(n, v, b, soff) => ELetMut(n, v, retain_wrap_branch_tails(b, ctx), soff),
    ESeq(a, b) => ESeq(a, retain_wrap_branch_tails(b, ctx)),
    EAssign(n, v, b) => EAssign(n, v, retain_wrap_branch_tails(b, ctx)),
    EAssignOp(o, n, v, b) => EAssignOp(o, n, v, retain_wrap_branch_tails(b, ctx)),
    _ => e
  }
}

// #768 (companion to retain_wrap_branch_tails): true when an if/match VALUE
// has at least one branch tail that is a BORROWED read -- a loop-borrowed /
// borrow-bound bare ident, a projection, or a borrow-returning call. A `let`
// bound to such a value is itself a (conditional) borrowed view, so it must be
// marked borrow-bound for its body scope exactly like #708 marks a direct
// `let x = Array::get(..)`: otherwise the borrow is laundered through the
// alias chain and a consuming call's #706/#708 arg dup never fires (observed:
// build_merged_stmts_inline's `let namespaced_stmts = if entry {
// export_renamed } else { namespace(...) }` passed to an owning callee, whose
// param drop freed the block `file_stmts` still owned -- the function-exit
// recursive drop then double-freed it, shadow-trapped at that exact site).
// The owned branch (fresh call result) sees at most an extra guarded dup at
// consuming sites -- the codebase-wide "leak, never corrupt" trade.
let rec value_has_borrowed_branch_tail: (Expr, CompileCtx) -> Bool = (e, ctx) -> {
  match e {
    EIdent(x, _) => array_contains_str(ctx.loop_borrowed_names, x) && !array_contains_str(ctx.ref_cell_names, x),
    EDot(_, _, _, _) => true,
    ECall(callee, _, _) => match callee {
      EIdent(cn, _) => cn == "Array::get" || cn == "__index" || cn == "Map::get" || cn == "__rec_field" || array_contains_str(ctx.borrow_ret_names, cn),
      _ => false
    },
    EIf(_, t, el) => value_has_borrowed_branch_tail(t, ctx) || value_has_borrowed_branch_tail(el, ctx),
    EMatch(_, arms) => {
      let mut found = false
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, abody) = Array::get(arms, ai)
        if value_has_borrowed_branch_tail(abody, ctx) {
          found = true
          ai = Array::length(arms)
        } else {
          ai = ai + 1
        }
      }
      found
    },
    ELet(_, _, b, _) => value_has_borrowed_branch_tail(b, ctx),
    ELetMut(_, _, b, _) => value_has_borrowed_branch_tail(b, ctx),
    ESeq(_, b) => value_has_borrowed_branch_tail(b, ctx),
    EAssign(_, _, b) => value_has_borrowed_branch_tail(b, ctx),
    EAssignOp(_, _, _, b) => value_has_borrowed_branch_tail(b, ctx),
    _ => false
  }
}

// #768: apply the branch-tail retain rewrite (see retain_wrap_branch_tails)
// when this binding's scope-end drop is planned AND we are inside a loop
// (loop_borrowed_names non-empty -- empty outside loops and under bump, so
// codegen elsewhere is byte-identical). Only if/match values are rewritten;
// the top-level node kind is preserved, so classification of the ORIGINAL
// `value` below stays valid.
let retain_wrap_let_value: (Expr, String, CompileCtx) -> Expr with { Error } = (value, name, ctx) -> {
  if ctx.enable_rc && (expr_tag(value) == 7 || expr_tag(value) == 16) && Array::length(ctx.loop_borrowed_names) > 0 && array_contains_str(ctx.rc_drop_names, name) {
    retain_wrap_branch_tails(value, ctx)
  } else {
    value
  }
}

export let compile_expr_tail: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {
  let __tag = expr_tag(expr)
  if __tag == 9 {
    let name = get_elet_name(expr)
    let value = get_elet_val(expr)
    let body = get_elet_body(expr)
    let local_idx = next_local
    emit_dbg_line_stmt(buf, value, get_elet_off(expr), ctx)
    Array::push(local_names, name)
    let nl = compile_expr(buf, retain_wrap_let_value(value, name, ctx), local_names, next_local + 1, ctx, ld)
    emit_local_set(buf, local_idx)
    let val_is_float = expr_is_floatish(value, local_names, ctx)
    if val_is_float {
      Array::push(ctx.float_local_slots, local_idx * 2 + 1)
    } else if slot_is_floatish(ctx, local_idx) {
      Array::push(ctx.float_local_slots, local_idx * 2)
    }
    // #678: log whether this binding holds a definitely-integral value, so a
    // later bare-ident `==` on it bypasses the string-pointer-misreading `eq`.
    // Always (re)log when the slot was previously int, so a non-int rebind of a
    // reused slot overrides the earlier entry. #769 encoding: slot*4 + kind
    // (0 clear / 1 int / 3 bool) -- see slot_is_intish.
    if expr_is_boolish(value, local_names, ctx) {
      Array::push(ctx.int_local_slots, local_idx * 4 + 3)
    } else if expr_is_intish(value, local_names, ctx) {
      Array::push(ctx.int_local_slots, local_idx * 4 + 1)
    } else if slot_is_intish(ctx, local_idx) {
      Array::push(ctx.int_local_slots, local_idx * 4)
    }
    // #724: log this binding's AGGREGATE shape (tuple arity / ctor-record
    // field count) so `a == b` with both sides bound takes the structural
    // comparators. kind*64+n; 0 overrides a reused slot. See
    // CompileCtx.agg_local_slots.
    let agg_entry = if is_etuple(value) {
      64 + Array::length(get_etuple_elems(value))
    } else if is_ctor_call(value, ctx.ctor_table) {
      let cargs = get_ecall_args(value)
      // `S::{ ... }` sugar arrives as ECall(S, [ERecord]) — the runtime
      // field count is the record's, not the call arity.
      let fcnt = if Array::length(cargs) == 1 {
        match Array::get(cargs, 0) {
          ERecord(_, rfields) => Array::length(rfields),
          _ => Array::length(cargs)
        }
      } else {
        Array::length(cargs)
      }
      128 + fcnt
    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {
      128
    } else if is_erecord(value) {
      // Records are [tag@0][len@4][fields@8+] since #722, walkable like ctors.
      match value {
        ERecord(_, rfields) => 128 + Array::length(rfields),
        _ => 0
      }
    } else if expr_tag(value) == 8 {
      // #724 round 2: `let a = f(..)` — classify by f's DECLARED return type
      // (agg_ret table). Only for a global fn name (a local shadowing `f`
      // makes this a closure call of unknown type).
      match get_ecall_callee(value) {
        EIdent(cfn, _) => if find_local_slot(local_names, cfn) < 0 {
          let rinfo = agg_ret_lookup(ctx.agg_ret_names, ctx.agg_ret_infos, cfn)
          if rinfo > 0 {
            rinfo
          } else {
            0
          }
        } else {
          0
        },
        _ => 0
      }
    } else if is_eident(value) {
      // Alias of a tracked binding: propagate its shape.
      let src_slot = find_local_slot(local_names, get_eident_name(value))
      if src_slot >= 0 {
        let src_info = agg_slot_lookup(ctx.agg_local_slots, src_slot)
        if src_info > 0 {
          src_info
        } else {
          0
        }
      } else {
        0
      }
    } else {
      0
    }
    // #672 (post-#724): the shape LITERAL backing `agg_entry`, kept in
    // lockstep with agg_local_slots (see CompileCtx.agg_local_exprs) so a
    // both-sides-tracked `a == b` can recurse into NESTED aggregate elements
    // (e.g. `let a = ((1,2),3)`) instead of only comparing the top-level
    // shape. An alias propagates its SOURCE's shape expr (not just the
    // kind+n int); everything else that isn't a literal (call-result via
    // agg_ret, round-2 param/return tracking) has no literal to recurse
    // into, so it stores the inert EInt(0) placeholder — those tracked
    // slots still get correct TOP-level structural comparison (unchanged
    // from before this change) but nested elements under them keep the
    // pre-existing generic-eq fallback.
    let agg_shape_expr = if is_etuple(value) {
      value
    } else if is_ctor_call(value, ctx.ctor_table) {
      value
    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {
      value
    } else if is_erecord(value) {
      value
    } else if is_eident(value) {
      let src_slot = find_local_slot(local_names, get_eident_name(value))
      if src_slot >= 0 {
        agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, src_slot)
      } else {
        EInt(0)
      }
    } else {
      EInt(0)
    }
    Array::push(ctx.agg_local_slots, local_idx * 256 + agg_entry)
    Array::push(ctx.agg_local_exprs, agg_shape_expr)
    let (rc_kind, is_borrow_ret_ext) = classify_let_value_heap(buf, value, name, local_idx, local_names, ctx)
    if ctx.enable_rc && rc_kind > 0 {
      let mut dbi = 0
      while dbi < Array::length(ctx.rc_dup_names) {
        if Array::get(ctx.rc_dup_names, dbi) == name {
          emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)
        } else {
          ()
        }
        dbi = dbi + 1
      }
    } else {
      ()
    }
    // #712: this `let` may SHADOW an outer loop-borrowed identifier of the same
    // name (e.g. `while ... { let x = ...; f(x) }` rebinding `x` inside a loop
    // whose header already loop-borrowed an outer `x`, #706). cc_is_loop_borrowed_ident
    // (compile_call.vibe) matches by NAME ONLY, so without this an owning call on
    // the INNER `x` would be mistaken for a reference to the OUTER loop-carried
    // one -- a spurious rc_dup now, and (via loop_consumed_names) a spurious extra
    // epilogue rc_drop for a parameter this `let` never touches. Mask every
    // existing occurrence of `name` out of loop_borrowed_names for exactly the
    // scope of `body`, then restore the same count after; membership is all
    // `array_contains_str` ever tests, so compacting out of order is safe.
    let mut lb_shadow_removed = 0
    if ctx.enable_rc {
      let lb_arr = ctx.loop_borrowed_names
      let lb_n = Array::length(lb_arr)
      let mut lb_w = 0
      let mut lb_i = 0
      while lb_i < lb_n {
        let e = Array::get(lb_arr, lb_i)
        if e == name {
          lb_shadow_removed = lb_shadow_removed + 1
        } else {
          Array::set(lb_arr, lb_w, e)
          lb_w = lb_w + 1
        }
        lb_i = lb_i + 1
      }
      Array::truncate(lb_arr, lb_w)
    } else {
      ()
    }
    // #708 follow-up: scope `name` into loop_borrowed_names for exactly the
    // extent of `body`'s compilation (push before, truncate after), so a bare
    // later reference to a borrow-bound name gets the same retain-before-
    // owning-call treatment a loop-carried parameter already gets. Safe to do
    // even outside a loop (loop_borrowed_names is otherwise empty there, and
    // this push/truncate pair never leaks past this let's own body).
    let lb_mark = Array::length(ctx.loop_borrowed_names)
    // #768: an if/match value with a borrowed branch tail makes this binding a
    // (conditional) borrowed view too -- mark it borrow-bound for the body
    // scope so consuming calls dup it (see value_has_borrowed_branch_tail).
    let value_borrow_like = ctx.enable_rc && (expr_tag(value) == 7 || expr_tag(value) == 16) && value_has_borrowed_branch_tail(value, ctx)
    if ctx.enable_rc && (is_borrow_ret_ext || value_borrow_like) {
      Array::push(ctx.loop_borrowed_names, name)
    } else {
      ()
    }
    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)
    if ctx.enable_rc && (is_borrow_ret_ext || value_borrow_like) {
      Array::truncate(ctx.loop_borrowed_names, lb_mark)
    } else {
      ()
    }
    // #712: restore the shadow-masked occurrences now that `body` (the only
    // scope where `name` shadows the outer loop-borrowed binding) is compiled.
    let mut lb_restore_i = 0
    while lb_restore_i < lb_shadow_removed {
      Array::push(ctx.loop_borrowed_names, name)
      lb_restore_i = lb_restore_i + 1
    }
    if ctx.enable_rc && rc_kind > 0 && array_contains_str(ctx.rc_drop_names, name) {
      if ctx.rc_drop_func_idx >= 0 && scope_tail_proj_root(body) == name {
        emit_local_set(buf, nl2)
        emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow)
        emit_local_get(buf, local_idx)
        emit_call(buf, ctx.rc_drop_func_idx)
        emit_local_get(buf, nl2)
        nl2 + 1
      } else {
        if ctx.rc_drop_func_idx >= 0 {
          emit_local_get(buf, local_idx)
          emit_call(buf, ctx.rc_drop_func_idx)
        } else if rc_kind == 1 {
          emit_rc_drop_local(buf, local_idx, false)
        } else {
          emit_rc_drop_local(buf, local_idx, true)
        }
        nl2
      }
    } else {
      nl2
    }
  } else if __tag == 10 {
    let name = get_eletrec_name(expr)
    let value = get_eletrec_val(expr)
    let body = get_eletrec_body(expr)
    let local_idx = next_local
    Array::push(local_names, name)
    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)
    emit_local_set(buf, local_idx)
    if is_efn(value) {
      let params = get_efn_params(value)
      let fn_body = get_efn_body(value)
      let param_names_bp = Array::slice([
        ""
      ], 0, 0)
      let mut bpi = 0
      while bpi < Array::length(params) {
        let (pn, _) = Array::get(params, bpi)
        Array::push(param_names_bp, pn)
        bpi = bpi + 1
      }
      let caps = collect_free_vars_indexed(fn_body, param_names_bp, ctx.capture_name_index)
      let mut self_cap_idx = -1
      let mut bci = 0
      while bci < Array::length(caps) {
        if Array::get(caps, bci) == name {
          self_cap_idx = bci
        }
        bci = bci + 1
      }
      if self_cap_idx >= 0 {
        emit_local_get(buf, local_idx)
        emit_i64_const(buf, -4)
        emit_i64_and(buf)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, local_idx)
        emit_i64_store(buf, 3, 8 + self_cap_idx * 8)
      }
      0
    } else {
      0
    }
    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)
    nl2
  } else if __tag == 11 {
    let name = get_eletmut_name(expr)
    let value = get_eletmut_val(expr)
    let body = get_eletmut_body(expr)
    let local_idx = next_local
    emit_dbg_line_stmt(buf, value, get_eletmut_off(expr), ctx)
    Array::push(local_names, name)
    if expr_is_floatish(value, local_names, ctx) {
      Array::push(ctx.float_local_slots, local_idx * 2 + 1)
    } else if slot_is_floatish(ctx, local_idx) {
      Array::push(ctx.float_local_slots, local_idx * 2)
    }
    // #678: track integral mutable bindings too (an Int local stays Int across
    // reassignments — the checker forbids changing its type), so a bare-ident
    // `==` on it uses the direct i64 path. #769: slot*4 + kind encoding, bool
    // tracked as kind 3 (a mut Bool stays Bool across reassignments too).
    if expr_is_boolish(value, local_names, ctx) {
      Array::push(ctx.int_local_slots, local_idx * 4 + 3)
    } else if expr_is_intish(value, local_names, ctx) {
      Array::push(ctx.int_local_slots, local_idx * 4 + 1)
    } else if slot_is_intish(ctx, local_idx) {
      Array::push(ctx.int_local_slots, local_idx * 4)
    }
    if mut_needs_ref_cell(body, name) {
      Array::push(ctx.ref_cell_names, name)
      if ctx.enable_rc && ctx.rc_alloc_func_idx >= 0 && ctx.rc_drop_func_idx >= 0 && expr_is_intish(value, local_names, ctx) {
        // #699 RC-managed ref cell: a captured `let mut` is heap-boxed for
        // by-reference sharing; under RC make that box an RC object so it is
        // reclaimed instead of leaking. Layout [alloc_size@0][rc_count@4 +
        // class8@7][payload@8]; the cell local holds vptr=block+8 (even) so the
        // read/write/assign-op sites are byte-identical to the raw-box path. The
        // capturing closure dups it (compile_lambda.vibe) and drops it via the
        // class-7 owned-capture recursion (gen_rc_drop_body); the defining scope
        // drops it inline below. Restricted to intish (scalar) values so the
        // payload is never a heap object that the body could return (no
        // use-after-free): class-8 payload-drop then stays a no-op.
        emit_i64_const(buf, 16)
        emit_call(buf, ctx.rc_alloc_func_idx)
        emit_local_set(buf, local_idx)
        emit_local_get(buf, local_idx)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 16)
        emit_i32_store(buf, 2, 0)
        emit_local_get(buf, local_idx)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 1)
        emit_i32_store(buf, 2, 4)
        emit_local_get(buf, local_idx)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 8)
        emit_i32_store8(buf, 0, 7)
        emit_local_get(buf, local_idx)
        emit_i64_const(buf, 8)
        emit_i64_add(buf)
        emit_local_set(buf, local_idx)
        emit_local_get(buf, local_idx)
        emit_i32_wrap_i64(buf)
        let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)
        emit_i64_store(buf, 3, 0)
        let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)
        emit_local_get(buf, local_idx)
        emit_i64_const(buf, 1)
        emit_i64_or(buf)
        emit_call(buf, ctx.rc_drop_func_idx)
        nl2
      } else {
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_tee(buf, local_idx)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 8)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_grow_after_heap_set(buf, ctx)
      emit_local_get(buf, local_idx)
      emit_i32_wrap_i64(buf)
      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)
      emit_i64_store(buf, 3, 0)
      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)
      nl2
      }
    } else {
      // #768: same branch-tail retain rewrite as ELet (see retain_wrap_let_value).
      let nl = compile_expr(buf, retain_wrap_let_value(value, name, ctx), local_names, next_local + 1, ctx, ld)
      emit_local_set(buf, local_idx)
      // #791: classify AFTER the value is compiled + stored (local_idx now
      // holds it), matching ELet's ordering -- classify_let_value_heap's
      // is_edot/is_eident-alias branches emit an immediate guarded dup
      // against local_idx, which only makes sense once it holds the fresh
      // value. See classify_let_value_heap's doc comment for why ELetMut
      // needs the identical (not just overlapping) classification ELet
      // uses -- this used to be a narrower, hand-duplicated condition list
      // that repeatedly drifted out of sync with ELet's (the #715/#791 bug
      // family); sharing one function makes that drift impossible.
      let (_mut_rc_kind, _mut_is_borrow_ret_ext) = classify_let_value_heap(buf, value, name, local_idx, local_names, ctx)
      // #715: the ELet path (tag 9) emits every dup the Perceus plan budgeted
      // for a binding (ctx.rc_dup_names) at its declaration site -- this
      // ELetMut path never did, while the matching scope-end drop below DID
      // fire. A `let mut found = None; while .. { match found { .. } }; found`
      // accumulator (checker_effects.vibe's lookup_fn_effs) gets a planned
      // dup from the #706 borrow-retention bump (the bare `match found`
      // borrow) plus a planned scope-end drop; with the dup silently skipped,
      // the tail-returned Option's only reference was consumed by the return
      // AND by the drop -- the caller's lifted `__m_scrut_N` scrutinee then
      // recursively re-dropped the freed block (byte-exact double-free
      // confirmed by the drop-site-stamped shadow diagnostic: first free at
      // this branch's scope-end drop, second inside
      // check_perform_effects_expr_tx). The guarded dup no-ops on scalars, so
      // over-emission for a scalar-planned name is harmless.
      if ctx.enable_rc {
        let mut mdbi = 0
        while mdbi < Array::length(ctx.rc_dup_names) {
          if Array::get(ctx.rc_dup_names, mdbi) == name {
            emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)
          } else {
            ()
          }
          mdbi = mdbi + 1
        }
      } else {
        ()
      }
      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)
      if ctx.enable_rc && array_contains_str(ctx.heap_binding_names, name) && array_contains_str(ctx.rc_drop_names, name) && ctx.rc_drop_func_idx >= 0 {
        if scope_tail_proj_root(body) == name {
          emit_local_set(buf, nl2)
          emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow)
          emit_local_get(buf, local_idx)
          emit_call(buf, ctx.rc_drop_func_idx)
          emit_local_get(buf, nl2)
          nl2 + 1
        } else {
          emit_local_get(buf, local_idx)
          emit_call(buf, ctx.rc_drop_func_idx)
          nl2
        }
      } else {
        nl2
      }
    }
  } else if __tag == 12 {
    let name = get_eassign_name(expr)
    let value = get_eassign_val(expr)
    let body = get_eassign_body(expr)
    let idx = resolve_local(local_names, name, "assign")
    if array_contains_str(ctx.ref_cell_names, name) {
      emit_local_get(buf, idx)
      emit_i32_wrap_i64(buf)
      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)
      emit_i64_store(buf, 3, 0)
      compile_expr(buf, body, local_names, nl, ctx, ld)
    } else {
      let is_heap_mut = ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.heap_binding_names, name)
      let is_self = assign_value_mentions(value, name)
      if is_heap_mut && is_self && reassign_self_reusable(value, name) {
        let old_temp = next_local
        let scratch = next_local + 1
        let base = next_local + 2
        emit_local_get(buf, idx)
        emit_local_set(buf, old_temp)
        let elems = get_etuple_elems(value)
        let mut ei = 0
        while ei < Array::length(elems) {
          let elem = Array::get(elems, ei)
          if (is_eident(elem) && get_eident_name(elem) == name) || (is_edot(elem) && proj_root_ident(elem) == name) {
            let _ = compile_expr(buf, elem, local_names, base, ctx, ld)
            emit_local_set(buf, scratch)
            emit_rc_dup_guarded(buf, scratch, ctx.rc_shadow)
          } else {
            ()
          }
          ei = ei + 1
        }
        let nl = compile_expr(buf, value, local_names, base, ctx, ld)
        emit_local_set(buf, idx)
        emit_local_get(buf, old_temp)
        emit_call(buf, ctx.rc_drop_func_idx)
        compile_expr(buf, body, local_names, nl, ctx, ld)
      } else {
        if is_heap_mut && !is_self {
          emit_local_get(buf, idx)
          emit_call(buf, ctx.rc_drop_func_idx)
        } else {
          ()
        }
        let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)
        emit_local_set(buf, idx)
        if is_heap_mut && !is_self && is_edot(value) {
          emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)
        } else {
          ()
        }
        // #715/#791: the Perceus plan's dup budget for a `let mut` binding
        // (ctx.rc_dup_names occurrences) is applied ONCE, to the INITIAL value
        // at the declaration site -- but the scope-end drop and every
        // remaining owning use consume the binding's CURRENT value. After a
        // reassignment, the freshly stored value carries only its own single
        // reference; without re-applying the budget here, the tail use plus
        // the scope-end drop over-consume it by exactly the planned dup count
        // (checker_effects.vibe's lookup_fn_effs: `let mut found = None;
        // ... found = Some(..) ...; found` -- the returned Some was freed by
        // the binding's scope-end drop while the caller still held it; the
        // #706 borrow-retention bump from the bare `match found` is what put
        // the +1 in the budget). Worst case this over-retains (a leak) when
        // part of the budget was already spent before the reassign -- the
        // codebase-wide "leak/no-op at worst, never corrupt" trade.
        //
        // #791: this budget reapplication was gated on `!is_self`, so a
        // SELF-referential reassignment (`s = f(s, ...)`, e.g. a loop
        // accumulator `s = Set::add(s, i)`) never got it -- only the narrow
        // `reassign_self_reusable` tuple-element branch above has its own
        // protection, and non-tuple self-reassignment (an ECall RHS, the
        // common accumulator shape) falls through to this same `else` with
        // no compensating dup at all. The freshly stored value then carries
        // only the single reference `f` returned, so the FIRST subsequent
        // owning use of `s` (which internally drops its param) frees it
        // prematurely; later uses read/reuse the freed block, corrupting
        // memory once an intervening allocation reuses it (2+ further uses
        // needed to observe it -- 1 further use still "works" because
        // nothing has overwritten the freed-but-untouched memory yet).
        // Reproduced/diagnosed via #791 (examples/set_test.vibe "multiple
        // adds"): `let mut s = Set::new(); while ... { s = Set::add(s, i) };
        // assert(Set::size(s)==20); assert(Set::contains(s,0));
        // assert(Set::contains(s,19))` traps under RC1 -- `Set::size`/
        // `Set::contains` take `s` by projection only (`s.items`), which
        // Perceus's use-counting doesn't count as an owning use, so both
        // functions unconditionally drop `s` in their epilogue; the caller
        // must dup before every non-last such call, exactly like the
        // `!is_self` case already handles. Applying the same budget here
        // (mirroring the `!is_self` path) fixes it: at worst an extra dup on
        // an already-dead reference (a leak, per the trade-off above), never
        // a missing one.
        if ctx.enable_rc && is_heap_mut {
          let mut adbi = 0
          while adbi < Array::length(ctx.rc_dup_names) {
            if Array::get(ctx.rc_dup_names, adbi) == name {
              emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)
            } else {
              ()
            }
            adbi = adbi + 1
          }
        } else {
          ()
        }
        compile_expr(buf, body, local_names, nl, ctx, ld)
      }
    }
  } else if __tag == 13 {
    let name = get_eassignop_name(expr)
    let op = get_eassignop_op(expr)
    let value = get_eassignop_val(expr)
    let body = get_eassignop_body(expr)
    let idx = resolve_local(local_names, name, "assignop")
    if array_contains_str(ctx.ref_cell_names, name) {
      emit_local_get(buf, idx)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, idx)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, 0)
      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)
      emit_assignop_op(buf, op)
      emit_assignop_rc_tag_fix(buf, ctx.enable_rc, op)
      emit_i64_store(buf, 3, 0)
      compile_expr(buf, body, local_names, nl, ctx, ld)
    } else {
      emit_local_get(buf, idx)
      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)
      emit_assignop_op(buf, op)
      emit_assignop_rc_tag_fix(buf, ctx.enable_rc, op)
      emit_local_set(buf, idx)
      compile_expr(buf, body, local_names, nl, ctx, ld)
    }
  } else if __tag == 14 {
    let first = get_eseq_first(expr)
    let second = get_eseq_second(expr)
    emit_dbg_line_for(buf, first, ctx)
    let nl = compile_expr(buf, first, local_names, next_local, ctx, ld)
    emit_drop(buf)
    compile_expr(buf, second, local_names, nl, ctx, ld)
  } else {
    compile_expr_tail2(buf, expr, local_names, next_local, ctx, ld, compile_expr)
  }
}
