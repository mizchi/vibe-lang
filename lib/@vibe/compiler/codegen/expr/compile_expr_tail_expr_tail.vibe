/// #768: apply the branch-tail retain rewrite (see retain_wrap_branch_tails)
/// when this binding's scope-end drop is planned AND we are inside a loop
/// (loop_borrowed_names non-empty -- empty outside loops and under bump, so
/// codegen elsewhere is byte-identical). Only if/match values are rewritten;
/// the top-level node kind is preserved, so classification of the ORIGINAL
/// `value` below stays valid.
///
/// #3103: a branch tail that calls a borrow-returning function needs the
/// retain whether or not a loop encloses the `let` -- nothing else gives the
/// binding the reference its planned drop spends -- so such a tail triggers
/// the rewrite outside a loop too. A value with no such tail keeps the
/// loop-only gate, so its codegen is unchanged.
fn retain_wrap_let_value(value: Expr, name: String, local_names: Array[String], ctx: CompileCtx) -> Expr with Exception {
  if ctx.enable_rc && is_branching_value(value) && array_contains_str(ctx.rc_drop_names, name) && (Array::length(ctx.loop_borrowed_names) > 0 || branch_tail_calls_borrow(value, local_names, array_empty(), ctx)) {
    retain_wrap_branch_tails(value, local_names, array_empty(), ctx)
  } else {
    value
  }
}

export fn compile_expr_tail(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let __tag = expr_tag(expr)
  if __tag == 9 {
    let name = get_elet_name(expr)
    let value = get_elet_val(expr)
    let body = get_elet_body(expr)
    let local_idx = next_local
    emit_dbg_line_stmt(buf, value, get_elet_off(expr), ctx)
    // #1120 Codex review (P1): the slot is pushed BEFORE the value compiles
    // (its index must be reserved), but a NON-RECURSIVE `let` binder is not
    // in scope inside its own initializer -- `let add = (x, y) -> Int {
    // add(x, y) }` deliberately means the BUILTIN add. Mask the name for the
    // duration of the value so nothing resolves to (or, since #1114, treats
    // as an enclosing shadow and captures) the not-yet-initialized slot; the
    // INDEX stays allocated, only the name is hidden, and it is restored
    // before the body compiles. `let rec` keeps its name visible -- that is
    // what makes self-reference work (see ctx.pending_letrec_self_name).
    cet_record_local_slot(local_names, local_idx)
    Array::set(local_names, local_idx, "")
    // #3190: the tails the plan's `PaStoreDup` rows name retain in place
    // (`let_retain_store_dup_tails`). The rewritten value is also what the
    // ownership classifiers below read, so a retained tail is an owned one;
    // the slot's KIND (float / int / aggregate) is still read off `value`.
    // A binder another branch of which still hands back a view stays
    // borrow-bound (`value_borrow_like` below), and its owning uses retain
    // again: on the retained branch that leaks one reference, where not
    // retaining it would let a store of the binder (`cur = c`, which takes a
    // heap binding as owned) release the reference the plan left with `p`.
    let value_sd = let_retain_store_dup_tails(value, local_names, ctx)
    let nl = compile_expr(buf, retain_wrap_let_value(value_sd, name, local_names, ctx), local_names, next_local + 1, ctx, ld)
    let seq_owned_return = seq_lambda_returns_owned(value, local_names, ctx)
    Array::set(local_names, local_idx, name)
    emit_local_set(buf, local_idx)
    if seq_owned_return {
      Array::push(ctx.seq_owned_return_slots, local_idx * 2 + 1)
    } else if seq_local_call_owns_result(ctx, local_idx) {
      Array::push(ctx.seq_owned_return_slots, local_idx * 2)
    }
    // #3113: a read of a captured cell arrives behind an owning-store marker
    // (cl_own_cell_stmts); classify the slot from the value it wraps.
    let class_value = cet_strip_owned_markers(value)
    let val_is_float = expr_is_floatish(class_value, local_names, ctx)
    if val_is_float {
      Array::push(ctx.float_local_slots, local_idx * 2 + 1)
    } else if slot_is_floatish(ctx, local_idx) {
      Array::push(ctx.float_local_slots, local_idx * 2)
    }
    // #678: log whether this binding holds a definitely-integral value, so a
    // later bare-ident `==` on it bypasses the string-pointer-misreading `eq`.
    // Always (re)log when the slot was previously classified, so a rebind of a
    // reused slot overrides the earlier entry. #769/#950 encoding: slot*4 +
    // kind (0 clear / 1 int / 2 string / 3 bool) -- see slot_is_intish.
    if expr_is_boolish(class_value, local_names, ctx) {
      Array::push(ctx.int_local_slots, local_idx * 4 + 3)
    } else if expr_is_intish(class_value, local_names, ctx) {
      Array::push(ctx.int_local_slots, local_idx * 4 + 1)
    } else if cc_expr_is_stringish(class_value, local_names, ctx) {
      Array::push(ctx.int_local_slots, local_idx * 4 + 2)
    } else if slot_is_intish(ctx, local_idx) || slot_is_stringish(ctx, local_idx) {
      Array::push(ctx.int_local_slots, local_idx * 4)
    }
    // #724: log this binding's AGGREGATE shape (tuple arity / ctor-record
    // field count) so `a == b` with both sides bound takes the structural
    // comparators. kind*64+n; 0 overrides a reused slot. See
    // CompileCtx.agg_local_slots.
    let agg_entry = if is_etuple(value) {
      64 + Array::length(get_etuple_elems(value))
    } else if is_ctor_call(value, ctx.ctor_table) {
      let cargs = get_ecall_args(value)
      // `S::{ ... }` sugar arrives as ECall(S, [ERecord]) — the runtime
      // field count is the record's, not the call arity.
      let fcnt = if Array::length(cargs) == 1 {
        match Array::get(cargs, 0) {
          ERecord(_, rfields, _) => Array::length(rfields),
          _ => Array::length(cargs)
        }
      } else {
        Array::length(cargs)
      }
      128 + fcnt
    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {
      128
    } else if is_erecord(value) {
      // Records are [tag@0][len@4][fields@8+] since #722, walkable like ctors.
      match value {
        ERecord(_, rfields, _) => 128 + Array::length(rfields),
        _ => 0
      }
    } else if expr_tag(value) == 8 {
      // #724 round 2: `let a = f(..)` — classify by f's DECLARED return type
      // (agg_ret table). Only for a global fn name (a local shadowing `f`
      // makes this a closure call of unknown type).
      match get_ecall_callee(value) {
        EIdent(cfn, _) => if find_local_slot(local_names, cfn) < 0 {
          let rinfo = agg_ret_lookup_indexed(ctx.agg_ret_names_sorted, ctx.agg_ret_names_sorted_pos, ctx.agg_ret_infos, cfn)
          if rinfo > 0 {
            rinfo
          } else {
            0
          }
        } else {
          0
        },
        _ => 0
      }
    } else if is_eident(value) {
      // Alias of a tracked binding: propagate its shape.
      let src_slot = find_local_slot(local_names, get_eident_name(value))
      if src_slot >= 0 {
        let src_info = agg_slot_lookup(ctx.agg_local_slots, src_slot)
        if src_info > 0 {
          src_info
        } else {
          0
        }
      } else {
        0
      }
    } else {
      0
    }
    // #672 (post-#724): the shape LITERAL backing `agg_entry`, kept in
    // lockstep with agg_local_slots (see CompileCtx.agg_local_exprs) so a
    // both-sides-tracked `a == b` can recurse into NESTED aggregate elements
    // (e.g. `let a = ((1,2),3)`) instead of only comparing the top-level
    // shape. An alias propagates its SOURCE's shape expr (not just the
    // kind+n int); everything else that isn't a literal (call-result via
    // agg_ret, round-2 param/return tracking) has no literal to recurse
    // into, so it stores the inert EInt(0) placeholder — those tracked
    // slots still get correct TOP-level structural comparison (unchanged
    // from before this change) but nested elements under them keep the
    // pre-existing generic-eq fallback.
    let agg_shape_expr = if is_etuple(value) {
      value
    } else if is_ctor_call(value, ctx.ctor_table) {
      value
    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {
      value
    } else if is_erecord(value) {
      value
    } else if is_eident(value) {
      let src_slot = find_local_slot(local_names, get_eident_name(value))
      if src_slot >= 0 {
        agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, src_slot)
      } else {
        EInt(0)
      }
    } else {
      EInt(0)
    }
    Array::push(ctx.agg_local_slots, local_idx * 256 + agg_entry)
    Array::push(ctx.agg_local_exprs, agg_shape_expr)
    let (rc_kind, is_borrow_ret_ext) = classify_let_value_heap(buf, value_sd, name, local_idx, local_names, ctx)
    // #3114: `let w = v` over a borrow-bound `v` that left `w` owning nothing
    // (rc_kind 0: the Perceus plan inherits `v`'s no-reference class, so `w`
    // has no scope-end drop) is the same borrowed view under another name.
    // Mark it borrow-bound for its body like `v`, so a consuming call, a
    // push, or a return retains it exactly as it would retain `v`. Read here,
    // before the #712 mask below removes `name` -- `let v = v` must still see
    // the outer `v`.
    let alias_borrow_like = ctx.enable_rc && rc_kind == 0 && is_eident(value) && array_contains_str(ctx.loop_borrowed_names, get_eident_name(value)) && !array_contains_str(ctx.ref_cell_names, get_eident_name(value))
    if ctx.enable_rc && rc_kind > 0 {
      let mut dbi = 0
      while dbi < Array::length(ctx.rc_dup_names) {
        if Array::get(ctx.rc_dup_names, dbi) == name {
          emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow, ctx.rc_dup_func_idx)
        } else {
          ()
        }
        dbi = dbi + 1
      }
    } else {
      ()
    }
    // #2837 dup-on-escape: the plan pinned this binding because it derives
    // from a local array a truncate may now release while the binding is
    // still live. Take a reference of its own here and give it back at the
    // scope end below, so the value outlives the truncate exactly as long as
    // the binding does. Balanced on every path that reaches the scope end; a
    // path that leaves early (return, break) keeps it, which leaks. The name
    // goes on the live stack the truncate lowering checks before releasing.
    let view_pin = ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.rc_trunc_pin_names, name)
    let pins_mark = Array::length(ctx.rc_pins_live)
    if view_pin {
      emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow, ctx.rc_dup_func_idx)
      Array::push(ctx.rc_pins_live, name)
    } else {
      ()
    }
    // #712: this `let` may SHADOW an outer loop-borrowed identifier of the same
    // name (e.g. `while ... { let x = ...; f(x) }` rebinding `x` inside a loop
    // whose header already loop-borrowed an outer `x`, #706). cc_is_loop_borrowed_ident
    // (compile_call.vibe) matches by NAME ONLY, so without this an owning call on
    // the INNER `x` would be mistaken for a reference to the OUTER loop-carried
    // one -- a spurious rc_dup now, and (via loop_consumed_names) a spurious extra
    // epilogue rc_drop for a parameter this `let` never touches. Mask every
    // existing occurrence of `name` out of loop_borrowed_names for exactly the
    // scope of `body`, then restore the same count after; membership is all
    // `array_contains_str` ever tests, so compacting out of order is safe.
    let mut lb_shadow_removed = 0
    if ctx.enable_rc {
      let lb_arr = ctx.loop_borrowed_names
      let lb_n = Array::length(lb_arr)
      let mut lb_w = 0
      let mut lb_i = 0
      while lb_i < lb_n {
        let e = Array::get(lb_arr, lb_i)
        if e == name {
          lb_shadow_removed = lb_shadow_removed + 1
        } else {
          Array::set(lb_arr, lb_w, e)
          lb_w = lb_w + 1
        }
        lb_i = lb_i + 1
      }
      Array::truncate(lb_arr, lb_w)
    } else {
      ()
    }
    // #708 follow-up: scope `name` into loop_borrowed_names for exactly the
    // extent of `body`'s compilation (push before, truncate after), so a bare
    // later reference to a borrow-bound name gets the same retain-before-
    // owning-call treatment a loop-carried parameter already gets. Safe to do
    // even outside a loop (loop_borrowed_names is otherwise empty there, and
    // this push/truncate pair never leaks past this let's own body).
    let lb_mark = Array::length(ctx.loop_borrowed_names)
    // #768: an if/match value with a borrowed branch tail makes this binding a
    // (conditional) borrowed view too -- mark it borrow-bound for the body
    // scope so consuming calls dup it (see value_has_borrowed_branch_tail).
    // #3190: a tail the plan's store row retained holds a reference of its
    // own, so it is read off `value_sd`, where it is no longer a bare name.
    let value_borrow_like = ctx.enable_rc && is_branching_value(value) && value_has_borrowed_branch_tail(value_sd, local_names, array_empty(), ctx)
    if ctx.enable_rc && (is_borrow_ret_ext || value_borrow_like || alias_borrow_like) {
      Array::push(ctx.loop_borrowed_names, name)
    } else {
      ()
    }
    // ADR-0092 Phase 1 (drop-guided reuse): when this binding's planned
    // scope-end drop can move to last use inside a body that is EXACTLY
    // `match name { ... }`, stage the fusion — allocate a flag local
    // (0 = not reused on the taken path) and expose (name, flag) to
    // compile_match via the ctx stacks (push/truncate, loop_borrowed_names
    // discipline). An arm that consumes the unique block in place sets the
    // flag; the scope-end drop below is then guarded on it, so every path
    // still consumes exactly one reference.
    let reuse_fusion = ctx.enable_rc && rc_kind > 0 && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.rc_drop_names, name) && expr_tag(body) == 16 && is_eident(get_match_scrutinee(body)) && get_eident_name(get_match_scrutinee(body)) == name
    let reuse_flag_l = if reuse_fusion {
      Array::push(local_names, "__reuse_flag")
      emit_i64_const(buf, 0)
      emit_local_set(buf, nl)
      Array::push(ctx.reuse_scrutinee_names, name)
      Array::push(ctx.reuse_flag_locals, nl)
      nl
    } else {
      0 - 1
    }
    let nl_after_reuse = if reuse_fusion {
      nl + 1
    } else {
      nl
    }
    // #2389 per-path release: a branch merge planned this binding's scope-end
    // drop away because SOME branch spends its initial reference, so the
    // branches that do not spend it never release the value. Give the drop
    // back, guarded by a flag local the plan's marked occurrences set (see
    // compile_expr's EIdent case) -- 0 at the scope end means this path still
    // holds the reference. Disjoint from the reuse fusion above by
    // construction: a path-drop binding has no planned PaDrop, which that
    // fusion requires.
    //
    // Two conditions beyond the plan's own, both about whether the INITIAL
    // reference is one this binding really holds:
    //
    // - not a borrow-bound binding (#708/#768: a borrow-returning call, or an
    //   if/match whose branch tail is borrowed). It holds a reference it never
    //   acquired, exactly as the ordinary scope-end drop below leaves it to
    //   loop_borrowed_names.
    // - every leaf of the value's RESULT SPINE is a reference this scope owns
    //   (`path_value_owned` above, an allow-list read through block bodies and
    //   conditional branches).
    //
    // - not an Int-valued binding: it holds no reference at all, so a guarded
    //   drop over it is pure instruction cost. Redundant under the allow-list
    //   for the forms it admits, kept because it is the reason a value holding
    //   no reference must never be guarded (see `path_value_owned`).
    //
    // - the flag local's index is the one `local_names` is about to record it
    //   at. `local_names` is indexed BY wasm local index, and the value's own
    //   compile may have taken scratch locals without naming them, so the
    //   allocation below pads up to `nl_after_reuse` first. Padding cannot fix
    //   the other direction: an array already LONGER than the index would put
    //   the flag's name at one position and its slot at another, and from
    //   there every later binding reads a slot that is not its own -- wrong
    //   values, no trap. No shape was found that reaches it; it costs one
    //   comparison and turns a silent aliasing bug into a declined binding.
    //
    // Ordered so the plan-row membership test comes BEFORE the spine walk:
    // `&&` short-circuits (compile_expr's own lowering for it does), and
    // `rc_path_drop_names` holds only the split bindings of the function being
    // compiled -- so a `let` that is not in it, which is almost every `let` in
    // the program and every one on the bump lane, never pays for
    // `path_value_owned`. Every operand is pure, so the order is a cost
    // choice only.
    //
    // The binding's OWN slot is masked for the scope read, exactly as it is
    // masked while the value compiles above (#1120): a non-recursive `let`
    // binder is not in scope inside its own initializer, so `let mk = mk(i)`
    // calls the GLOBAL `mk`. `local_names[local_idx]` has been restored by
    // now, so without the mask `find_local_slot` finds this binding itself and
    // declines a result the callee's contract says is owned -- the safe
    // direction, but it keeps the leak this pass exists to remove. Measured:
    // with the mask removed, `let mk = mk(3)` under a heap-returning global
    // `mk` compiles 18 B smaller, which is the guarded drop not being emitted.
    let pd_candidate = ctx.enable_rc && rc_kind > 0 && ctx.rc_drop_func_idx >= 0 && !is_borrow_ret_ext && !value_borrow_like && array_contains_str(ctx.rc_path_drop_names, name)
    let path_value_ok = if pd_candidate {
      let pd_self = Array::get(local_names, local_idx)
      Array::set(local_names, local_idx, "")
      let r = path_value_owned(value, local_names, array_empty(), ctx)
      Array::set(local_names, local_idx, pd_self)
      r
    } else {
      false
    }
    let path_drop = pd_candidate && path_value_ok && !expr_is_intish(value, local_names, ctx) && Array::length(local_names) <= nl_after_reuse
    let path_flag_l = if path_drop {
      // The flag takes a wasm local of its own, so `local_names` gains its
      // entry here -- through the same helper the scope-end promotion below
      // uses, which is what keeps the two copies of this discipline from
      // drifting apart again (#2792 was one of them forgetting). `path_drop`
      // above already established that the array does not run PAST this index,
      // the one direction padding cannot repair.
      cet_record_local_slot(local_names, nl_after_reuse)
      emit_i64_const(buf, 0)
      emit_local_set(buf, nl_after_reuse)
      Array::push(ctx.rc_path_flag_names, name)
      Array::push(ctx.rc_path_flag_locals, nl_after_reuse)
      nl_after_reuse
    } else {
      0 - 1
    }
    let nl_body = if path_drop {
      nl_after_reuse + 1
    } else {
      nl_after_reuse
    }
    // #3141: what an early exit out of `body` releases for this binding. An
    // owned binding (not borrow-bound: it holds a reference only when it
    // acquired one, the same test the scope-end drop and the dups above
    // make) releases what the plan says it still holds, guarded on the flag
    // its scope-end drop is guarded on; a view pin is a reference of its own.
    let xmark = Array::length(ctx.rc_exit_stack_names)
    if ctx.enable_rc {
      Array::push(ctx.rc_exit_lets, name)
      if ctx.rc_drop_func_idx >= 0 && rc_kind > 0 && !is_borrow_ret_ext && !value_borrow_like && !alias_borrow_like {
        rc_exit_push(ctx.rc_exit_stack_names, ctx.rc_exit_stack_info, name, 0, local_idx, if path_drop {
          path_flag_l
        } else if reuse_fusion {
          reuse_flag_l
        } else {
          0 - 1
        })
      } else {
        ()
      }
      if view_pin {
        rc_exit_push(ctx.rc_exit_stack_names, ctx.rc_exit_stack_info, name, 5, local_idx, 0 - 1)
      } else {
        ()
      }
    } else {
      ()
    }
    let source_mark = Array::length(ctx.rc_exit_result_stores)
    if ctx.enable_rc {
      Array::push(ctx.rc_exit_result_stores, (name, value))
    }
    let nl2 = compile_expr(buf, body, local_names, nl_body, ctx, ld)
    Array::truncate(ctx.rc_exit_result_stores, source_mark)
    if ctx.enable_rc {
      rc_exit_truncate(ctx, xmark)
      Array::truncate(ctx.rc_exit_lets, Array::length(ctx.rc_exit_lets) - 1)
    } else {
      ()
    }
    if view_pin {
      Array::truncate(ctx.rc_pins_live, pins_mark)
    } else {
      ()
    }
    if path_drop {
      Array::truncate(ctx.rc_path_flag_names, Array::length(ctx.rc_path_flag_names) - 1)
      Array::truncate(ctx.rc_path_flag_locals, Array::length(ctx.rc_path_flag_locals) - 1)
      emit_local_get(buf, path_flag_l)
      emit_i64_eqz(buf)
      emit_if_void(buf)
      emit_local_get(buf, local_idx)
      emit_call(buf, ctx.rc_drop_func_idx)
      emit_end(buf)
    } else {
      ()
    }
    if reuse_fusion {
      Array::truncate(ctx.reuse_scrutinee_names, Array::length(ctx.reuse_scrutinee_names) - 1)
      Array::truncate(ctx.reuse_flag_locals, Array::length(ctx.reuse_flag_locals) - 1)
    } else {
      ()
    }
    if ctx.enable_rc && (is_borrow_ret_ext || value_borrow_like || alias_borrow_like) {
      Array::truncate(ctx.loop_borrowed_names, lb_mark)
    } else {
      ()
    }
    // #712: restore the shadow-masked occurrences now that `body` (the only
    // scope where `name` shadows the outer loop-borrowed binding) is compiled.
    let mut lb_restore_i = 0
    while lb_restore_i < lb_shadow_removed {
      Array::push(ctx.loop_borrowed_names, name)
      lb_restore_i = lb_restore_i + 1
    }
    let nl_let = if ctx.enable_rc && rc_kind > 0 && array_contains_str(ctx.rc_drop_names, name) {
      if reuse_fusion {
        // ADR-0092: drop only when no arm consumed the block via reuse.
        emit_local_get(buf, reuse_flag_l)
        emit_i64_eqz(buf)
        emit_if_void(buf)
        emit_local_get(buf, local_idx)
        emit_call(buf, ctx.rc_drop_func_idx)
        emit_end(buf)
        nl2
      } else if ctx.rc_drop_func_idx >= 0 && scope_tail_proj_root(body) == name {
        emit_local_set(buf, nl2)
        emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow, ctx.rc_dup_func_idx)
        emit_local_get(buf, local_idx)
        emit_call(buf, ctx.rc_drop_func_idx)
        emit_local_get(buf, nl2)
        cet_record_local_slot(local_names, nl2)
        nl2 + 1
      } else {
        if ctx.rc_drop_func_idx >= 0 {
          // ADR-0092 note: an inline shared-decrement drop fast path was
          // tried here and at the fn epilogues (PR #1274) -- it measured
          // FLAT on the selfcompile KPI (the allocator, not drop call
          // overhead, dominated) while growing every drop site ~5B -> ~70B,
          // which failed the output-size ratchet (+14% closure_indirect).
          // Reverted to the plain runtime call; the allocator-side wins
          // (bounded walk + size bins) carry the measured improvement.
          emit_local_get(buf, local_idx)
          emit_call(buf, ctx.rc_drop_func_idx)
        } else if rc_kind == 1 {
          emit_rc_drop_local(buf, local_idx, false)
        } else {
          emit_rc_drop_local(buf, local_idx, true)
        }
        nl2
      }
    } else {
      nl2
    }
    // #2837: release the pin taken at the bind site. The body's value stays
    // on the stack underneath, as it does for the scope-end drop above.
    if view_pin {
      emit_local_get(buf, local_idx)
      emit_call(buf, ctx.rc_drop_func_idx)
    } else {
      ()
    }
    nl_let
  } else if __tag == 10 {
    let name = get_eletrec_name(expr)
    let value = get_eletrec_val(expr)
    let body = get_eletrec_body(expr)
    let local_idx = next_local
    cet_record_local_slot(local_names, local_idx)
    Array::set(local_names, local_idx, name)
    // #875 fix 2: hint compile_lambda (the immediate, sole callee that
    // compiling an EFn value dispatches to) that NAME is this closure's own
    // let-rec binding, so its capture computation force-includes NAME even if
    // NAME collides with an unrelated entry in ctx.capture_name_index. Only
    // set when `value` is actually an EFn (a non-lambda let-rec value, e.g.
    // `let rec x = some_expr`, has no self-capture concept); compile_lambda
    // consumes and clears this immediately, so it cannot leak to any other
    // lambda compiled afterward. See CompileCtx.pending_letrec_self_name.
    if is_efn(value) {
      Array::truncate(ctx.pending_letrec_self_name, 0)
      Array::push(ctx.pending_letrec_self_name, name)
    } else {
      ()
    }
    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)
    emit_local_set(buf, local_idx)
    if seq_lambda_returns_owned(value, local_names, ctx) {
      Array::push(ctx.seq_owned_return_slots, local_idx * 2 + 1)
    } else if seq_local_call_owns_result(ctx, local_idx) {
      Array::push(ctx.seq_owned_return_slots, local_idx * 2)
    }
    if is_efn(value) {
      let params = get_efn_params(value)
      let fn_body = get_efn_body(value)
      // #1899: strip the label marker, exactly as compile_lambda does. This
      // recomputation has to agree with its `captures` or self_cap_idx points
      // at the wrong slot -- so fixing only one side is worse than fixing
      // neither.
      let param_names_bp = array_empty()
      let mut bpi = 0
      while bpi < Array::length(params) {
        let (pn, _) = Array::get(params, bpi)
        Array::push(param_names_bp, cet_strip_param_label_marker(pn))
        bpi = bpi + 1
      }
      // #875 fix 2: same force-include as compile_lambda's own capture
      // computation above -- this is a REDUNDANT recomputation (must match
      // compile_lambda's `captures` exactly to find the right self_cap_idx
      // slot), so it needs the same self_name override, passed directly
      // since `name` is already in scope here (no ctx hint needed at this
      // call site).
      // #1114: `local_names` (the enclosing scope) must be passed here too --
      // this recomputation has to match compile_lambda's `captures` EXACTLY
      // or self_cap_idx points at the wrong slot.
      let caps = collect_free_vars_indexed_self(fn_body, param_names_bp, ctx.capture_name_index, name, local_names)
      let mut self_cap_idx = -1
      let mut bci = 0
      while bci < Array::length(caps) {
        if Array::get(caps, bci) == name {
          self_cap_idx = bci
        }
        bci = bci + 1
      }
      if self_cap_idx >= 0 {
        emit_local_get(buf, local_idx)
        emit_i64_const(buf, -4)
        emit_i64_and(buf)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, local_idx)
        emit_i64_store(buf, 3, 8 + self_cap_idx * 8)
      }
      0
    } else {
      0
    }
    // Perceus plans the recursive binding as an owner, but unlike ELet this
    // arm used to leave its final reference alive. Its self capture is weak;
    // releasing the binder at scope end therefore also frees the closure.
    let exit_mark = Array::length(ctx.rc_exit_stack_names)
    let owns_closure = ctx.enable_rc && is_efn(value)
    if owns_closure {
      Array::push(ctx.rc_exit_lets, name)
    } else {
      ()
    }
    if owns_closure && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.rc_drop_names, name) {
      rc_exit_push(ctx.rc_exit_stack_names, ctx.rc_exit_stack_info, name, 6, local_idx, 0 - 1)
    } else {
      ()
    }
    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)
    if owns_closure {
      rc_exit_truncate(ctx, exit_mark)
      Array::truncate(ctx.rc_exit_lets, Array::length(ctx.rc_exit_lets) - 1)
    } else {
      ()
    }
    if owns_closure && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.rc_drop_names, name) {
      if scope_tail_ident(body) == name || rc_scope_tail_borrows_name(body, name, local_names, ctx) {
        emit_local_set(buf, nl2)
        // A branch can return this closure on only one path. Retain the
        // result only when it is the binder about to be released.
        emit_local_get(buf, nl2)
        emit_local_get(buf, local_idx)
        emit_i64_eq(buf)
        emit_if_void(buf)
        emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow, ctx.rc_dup_func_idx)
        emit_end(buf)
        emit_local_get(buf, local_idx)
        emit_call(buf, ctx.rc_drop_func_idx)
        emit_local_get(buf, nl2)
        cet_record_local_slot(local_names, nl2)
        nl2 + 1
      } else {
        emit_local_get(buf, local_idx)
        emit_call(buf, ctx.rc_drop_func_idx)
        nl2
      }
    } else {
      nl2
    }
  } else if __tag == 11 {
    let name = get_eletmut_name(expr)
    let value = get_eletmut_val(expr)
    let body = get_eletmut_body(expr)
    let local_idx = next_local
    emit_dbg_line_stmt(buf, value, get_eletmut_off(expr), ctx)
    cet_record_local_slot(local_names, local_idx)
    // #1120 Codex review (P1): same non-recursive-binder masking as ELet
    // above -- `let mut add = (x, y) -> Int { add(x, y) }` means the BUILTIN
    // add. Keep it masked through initializer ownership classification too;
    // restore it before compiling the body, where the binder IS in scope.
    Array::set(local_names, local_idx, "")
    // #3113: a captured cell's initializer arrives wrapped in owning-store
    // markers (cl_own_cell_stmts). They change who owns the value, never its
    // representation, so the slot is classified from the unwrapped value.
    let class_value = cet_strip_owned_markers(value)
    if seq_lambda_returns_owned(class_value, local_names, ctx) {
      Array::push(ctx.seq_owned_return_slots, local_idx * 2 + 1)
    } else if seq_local_call_owns_result(ctx, local_idx) {
      Array::push(ctx.seq_owned_return_slots, local_idx * 2)
    }
    if expr_is_floatish(class_value, local_names, ctx) {
      Array::push(ctx.float_local_slots, local_idx * 2 + 1)
    } else if slot_is_floatish(ctx, local_idx) {
      Array::push(ctx.float_local_slots, local_idx * 2)
    }
    // #678: track integral mutable bindings too (an Int local stays Int across
    // reassignments — the checker forbids changing its type), so a bare-ident
    // `==` on it uses the direct i64 path. #769/#950: slot*4 + kind encoding,
    // bool tracked as kind 3, string as kind 2 (a mut Bool/String stays that
    // type across reassignments too).
    if expr_is_boolish(class_value, local_names, ctx) {
      Array::push(ctx.int_local_slots, local_idx * 4 + 3)
    } else if expr_is_intish(class_value, local_names, ctx) {
      Array::push(ctx.int_local_slots, local_idx * 4 + 1)
    } else if cc_expr_is_stringish(class_value, local_names, ctx) {
      Array::push(ctx.int_local_slots, local_idx * 4 + 2)
    } else if slot_is_intish(ctx, local_idx) || slot_is_stringish(ctx, local_idx) {
      Array::push(ctx.int_local_slots, local_idx * 4)
    }
    if mut_needs_ref_cell(body, name) {
      Array::push(ctx.ref_cell_names, name)
      if ctx.enable_rc && ctx.rc_alloc_func_idx >= 0 && ctx.rc_drop_func_idx >= 0 {
        // #699 RC-managed ref cell: a captured `let mut` is heap-boxed for
        // by-reference sharing; under RC make that box an RC object so it is
        // reclaimed instead of leaking. Layout [alloc_size@0][rc_count@4 +
        // class8@7][payload@8]; the cell local holds vptr=block+8 (even) so the
        // read/write/assign-op sites are byte-identical to the raw-box path. The
        // capturing closure dups it (compile_lambda.vibe) and drops it via the
        // class-7 owned-capture recursion (gen_rc_drop_body); the defining scope
        // drops it inline below. The class-8 drop releases the payload with
        // the cell (__rt_rc_drop), so the cell OWNS one reference to it:
        // #3113 made every store an owned one (cl_own_cell_stmts marks the
        // initializer and each assignment, the assignment releases the value
        // it replaces) and every read that leaves for an owning place a
        // retained one (cc_is_ref_cell_read).
        //
        // ADR-0092 (#1262): this used to ALSO require
        // `expr_is_intish(value, ..)`, which made the two sides of the ref-cell
        // contract disagree. `Array::push(ctx.ref_cell_names, name)` above is
        // UNCONDITIONAL, and compile_lambda keys the RC-owned-capture treatment
        // (odd tagging + emit_rc_word_inc_saturating at box-4 + the class-7
        // recursive __rt_rc_drop) purely off `ref_cell_names`. A non-intish
        // init -- `let mut x = -1` is enough, since expr_is_intish only accepts
        // `!` among unary ops -- took the raw 8-byte HEADERLESS box below while
        // the closure kept treating it as an RC object. That incremented a
        // nonexistent rc word in whatever preceded the box, and later pushed a
        // headerless pointer onto the free list; the allocator's walk then
