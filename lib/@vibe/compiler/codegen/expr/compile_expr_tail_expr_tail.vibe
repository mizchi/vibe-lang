      // result is discarded. It is an owning slot like any heap `let mut`:
      // the EAssign lowering retains an unowned store, and the scope end
      // drops what it holds when the plan says the result is not handed out
      // (`perceus_loop_result_slot`, which classifies the slot the same way).
      let loop_slot = ctx.enable_rc && perceus_loop_result_slot(name, value, body)
      if loop_slot && !array_contains_str(ctx.heap_binding_names, name) {
        Array::push(ctx.heap_binding_names, name)
      } else {
        ()
      }
      if loop_slot {
        Array::push(ctx.rc_loop_result_slots, name)
      } else {
        ()
      }
      // A borrowed call initializes an owning mutable slot. Its later value
      // may be a fresh allocation, so keeping the initializer's borrow flag
      // would suppress both the slot's drop and a wrapper result's drop.
      // Retain now: even an unassigned slot may be returned through a wrapper
      // without taking a reference away from the original container.
      // pc_count's ELetMut arm supplies the matching ordinary owning plan.
      // The initializer may WRAP the call. This must fire on exactly the
      // values `pc_count`'s ELetMut arm plans as owning, so it reads the same
      // straight-line spine leaf rather than `_mut_is_borrow_ret_ext`, whose
      // wrapper answer is broader (branches, projections, aliases) than the
      // plan's.
      let spine_retained = ctx.enable_rc && spine_leaf_unowned(value, local_names, ctx)
      if spine_retained {
        emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow, ctx.rc_dup_func_idx)
        Array::push(ctx.heap_binding_names, name)
      } else {
        ()
      }
      // #3184: an initializer that NAMES a view (`let mut cur = v`, `v` a
      // borrowed `let` or a `for` element), or one the plan asks to retain
      // (`PaStoreDup`: an owned binding from outside the loop this `let mut`
      // is declared in), gives the slot a reference of its own, exactly as a
      // store of the same value does (the EAssign arm). The plan already
      // treats the slot as owning; without the retain its scope end, or the
      // owning use its value was handed to, released the view's owner's
      // reference.
      let init_retained = ctx.enable_rc && !spine_retained && (assign_ident_is_view(value, local_names, ctx) || assign_ident_store_dup(value, local_names, ctx))
      if init_retained {
        emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow, ctx.rc_dup_func_idx)
        if array_contains_str(ctx.heap_binding_names, name) {
          ()
        } else {
          Array::push(ctx.heap_binding_names, name)
        }
      } else {
        ()
      }
      // #3141: may an early exit out of `body` release this slot? Only when
      // it holds a reference of its own -- retained just above, or a heap
      // value the exit operand's test vouches for (read here, while the
      // binder is still masked) -- so that every store after this one keeps
      // the slot owning (compile_expr_tail's EAssign arm, and the plan's
      // `pe_emit_exit_rows` for what it then holds).
      let exit_owned = ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && (spine_retained || init_retained || (_mut_rc_kind > 0 && rc_exit_value_owned(ctx, local_names, value_sd)))
      // `let mut peek = peek(xs, 0)` calls the outer `peek`. Both ownership
      // classifiers above must see that same scope, even though the value
      // has already been stored so their retains can target local_idx.
      Array::set(local_names, local_idx, name)
      // A mutable binding may hold a different value on every path through
      // its body. Move its planned dups to the owning use sites only when
      // every row has an identifiable source occurrence.
      let mut_use_mark = Array::length(ctx.rc_mut_use_names)
      let mut mut_use_sites = ctx.enable_rc && !array_contains_str(ctx.ref_cell_names, name)
      let mut mdi = 0
      while mdi < Array::length(ctx.rc_dup_names) {
        if Array::get(ctx.rc_dup_names, mdi) == name && Array::get(ctx.rc_dup_offsets, mdi) < 0 {
          mut_use_sites = false
        } else {
          ()
        }
        mdi = mdi + 1
      }
      // An early exit spends the plan's remaining dup budget at once. Keep
      // that budget at the binding/store sites when this binding has an exit
      // drop row; no use-site dup has run yet on an exit before those uses.
      let mut mei = 0
      while mei < Array::length(ctx.rc_exit_plan_names) {
        if Array::get(ctx.rc_exit_plan_names, mei) == name && Array::get(ctx.rc_exit_plan_info, mei * 4) == 1 {
          mut_use_sites = false
        } else {
          ()
        }
        mei = mei + 1
      }
      if mut_use_sites {
        Array::push(ctx.rc_mut_use_names, name)
      } else {
        ()
      }
      // #715: the ELet path (tag 9) emits every dup the Perceus plan budgeted
      // for a binding (ctx.rc_dup_names) at its declaration site -- this
      // ELetMut path never did, while the matching scope-end drop below DID
      // fire. A `let mut found = None; while .. { match found { .. } }; found`
      // accumulator (checker_effects.vibe's lookup_fn_effs) gets a planned
      // dup from the #706 borrow-retention bump (the bare `match found`
      // borrow) plus a planned scope-end drop; with the dup silently skipped,
      // the tail-returned Option's only reference was consumed by the return
      // AND by the drop -- the caller's lifted `__m_scrut_N` scrutinee then
      // recursively re-dropped the freed block (byte-exact double-free
      // confirmed by the drop-site-stamped shadow diagnostic: first free at
      // this branch's scope-end drop, second inside
      // check_perform_effects_expr_tx). The guarded dup no-ops on scalars, so
      // over-emission for a scalar-planned name is harmless.
      if ctx.enable_rc && !mut_use_sites {
        let mut mdbi = 0
        while mdbi < Array::length(ctx.rc_dup_names) {
          if Array::get(ctx.rc_dup_names, mdbi) == name {
            emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow, ctx.rc_dup_func_idx)
          } else {
            ()
          }
          mdbi = mdbi + 1
        }
      } else {
        ()
      }
      // #3141: an early exit out of `body` releases what the slot holds at
      // that point, as many times as the plan's row says.
      let xmark = Array::length(ctx.rc_exit_stack_names)
      if exit_owned {
        rc_exit_push(ctx.rc_exit_stack_names, ctx.rc_exit_stack_info, name, 0, local_idx, 0 - 1)
      } else {
        ()
      }
      let source_mark = Array::length(ctx.rc_exit_result_stores)
      if ctx.enable_rc {
        Array::push(ctx.rc_exit_result_stores, (name, value_sd))
      }
      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)
      Array::truncate(ctx.rc_exit_result_stores, source_mark)
      Array::truncate(ctx.rc_mut_use_names, mut_use_mark)
      if exit_owned {
        rc_exit_truncate(ctx, xmark)
      } else {
        ()
      }
      if loop_slot {
        Array::truncate(ctx.rc_loop_result_slots, Array::length(ctx.rc_loop_result_slots) - 1)
      } else {
        ()
      }
      if ctx.enable_rc && array_contains_str(ctx.heap_binding_names, name) && array_contains_str(ctx.rc_drop_names, name) && ctx.rc_drop_func_idx >= 0 {
        if scope_tail_proj_root(body) == name {
          emit_local_set(buf, nl2)
          emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow, ctx.rc_dup_func_idx)
          emit_local_get(buf, local_idx)
          emit_call(buf, ctx.rc_drop_func_idx)
          emit_local_get(buf, nl2)
          cet_record_local_slot(local_names, nl2)
          nl2 + 1
        } else {
          emit_local_get(buf, local_idx)
          emit_call(buf, ctx.rc_drop_func_idx)
          nl2
        }
      } else {
        nl2
      }
    }
  } else if __tag == 12 {
    let name = get_eassign_name(expr)
    let value = get_eassign_val(expr)
    let body = get_eassign_body(expr)
    let idx = resolve_local(local_names, name, "assign")
    if seq_lambda_returns_owned(cet_strip_owned_markers(value), local_names, ctx) {
      Array::push(ctx.seq_owned_return_slots, idx * 2 + 1)
    } else if seq_local_call_owns_result(ctx, idx) {
      Array::push(ctx.seq_owned_return_slots, idx * 2)
    }
    if array_contains_str(ctx.ref_cell_names, name) && ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {
      // #3113: the RC cell owns its payload (its drop releases it), and
      // cl_own_cell_stmts has already made the stored value an owned one. So
      // the assignment replaces one owned reference with another: compute the
      // new value first -- it may read the cell -- then store it and release
      // the old payload, which no longer has an owner.
      let vnl = compile_expr(buf, rc_mut_rec_transfer_value(value, local_names, ctx, [
      ]), local_names, next_local, ctx, ld)
      // Expression compilation can reserve unnamed scratch slots; claim two
      // past them, the way the lambda-return marker does.
      let new_l = vnl
      let old_l = vnl + 1
      cet_record_local_slot(local_names, old_l)
      let nl = vnl + 2
      emit_local_set(buf, new_l)
      emit_local_get(buf, idx)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, 0)
      emit_local_set(buf, old_l)
      emit_local_get(buf, idx)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, new_l)
      emit_i64_store(buf, 3, 0)
      emit_local_get(buf, old_l)
      emit_call(buf, ctx.rc_drop_func_idx)
      compile_expr(buf, body, local_names, nl, ctx, ld)
    } else if array_contains_str(ctx.ref_cell_names, name) {
      emit_local_get(buf, idx)
      emit_i32_wrap_i64(buf)
      let nl = compile_expr(buf, if ctx.enable_rc {
        rc_mut_rec_transfer_value(value, local_names, ctx, [])
      } else {
        value
      }, local_names, next_local, ctx, ld)
      emit_i64_store(buf, 3, 0)
      compile_expr(buf, body, local_names, nl, ctx, ld)
    } else {
      let is_heap_mut = ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.heap_binding_names, name)
      let is_self = assign_value_mentions(value, name)
      if is_heap_mut && is_self && reassign_self_reusable(value, name) {
        let old_temp = next_local
        let scratch = next_local + 1
        let base = next_local + 2
        emit_local_get(buf, idx)
        emit_local_set(buf, old_temp)
        let elems = get_etuple_elems(value)
        let mut ei = 0
        while ei < Array::length(elems) {
          let elem = Array::get(elems, ei)
          if (is_eident(elem) && get_eident_name(elem) == name) || (is_edot(elem) && proj_root_ident(elem) == name) {
            let _ = compile_expr(buf, elem, local_names, base, ctx, ld)
            emit_local_set(buf, scratch)
            emit_rc_dup_guarded(buf, scratch, ctx.rc_shadow, ctx.rc_dup_func_idx)
          } else {
            ()
          }
          ei = ei + 1
        }
        let nl = compile_expr(buf, value, local_names, base, ctx, ld)
        emit_local_set(buf, idx)
        emit_local_get(buf, old_temp)
        emit_call(buf, ctx.rc_drop_func_idx)
        // #3141: an early exit in the continuation must not release what
        // the stored value may still read (see rc_exit_note_store).
        let xtok = rc_exit_note_store(ctx, local_names, value)
        let rnl = compile_expr(buf, body, local_names, nl, ctx, ld)
        rc_exit_end_store(ctx, xtok)
        rnl
      } else {
        // #3184: a slot that owns what it holds must take a reference of its
        // own when the stored name holds none -- a borrowed `let`, a `for`
        // element, an alias of either (`assign_name_is_view`) -- or when the
        // plan says the store runs once per iteration of a loop the name's
        // owner was declared outside of (`PaStoreDup`, see perceus.vibe's
        // `pe_store_dup`). Otherwise the owner's scope end releases the value
        // the slot still holds: `let v = Array::get(xs, 0); cur = v` in a loop
        // body left `cur` on a block the body's drop of `xs` freed, and
        // `cur = p` freed `p` on the second iteration. The retain is taken
        // through the name's own local BEFORE the old value is released, so a
        // name viewing into the slot's old value survives that release.
        let slot_owning = is_heap_mut || (ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && is_loop_result_slot(name))
        let store_retain = !is_self && ((slot_owning && assign_ident_is_view(value, local_names, ctx)) || assign_ident_store_dup(value, local_names, ctx))
        // #3184: a branch or block tail of the value is a store of its own:
        // one naming an owned binding from outside the loop retains where the
        // plan's `PaStoreDup` row says (`assign_retain_store_dup_tails`,
        // whatever the slot -- the plan kept the binding's own reference), and
        // a conditional stored into an owning slot retains the branches that
        // hand back a view, and only those (`assign_retain_view_tails`).
        let value = if ctx.enable_rc && !is_eident(value) && Array::length(ctx.rc_store_dup_names) > 0 {
          assign_retain_store_dup_tails(value, local_names, array_empty(), ctx)
        } else {
          value
        }
        let value = if slot_owning && !is_self && is_branching_value(mib_spine_leaf(value, array_empty())) {
          assign_retain_view_tails(value, local_names, array_empty(), array_empty(), ctx)
        } else {
          value
        }
        // A tail retained in place takes its reference as the value is
        // computed, so the slot's old value -- which a view may read into --
        // is released after it, with the new value on the stack, instead of
        // before.
        let tails_retained = assign_tails_retained(value)
        if store_retain {
          emit_rc_dup_guarded(buf, find_local_slot(local_names, get_eident_name(value)), ctx.rc_shadow, ctx.rc_dup_func_idx)
        } else {
          ()
        }
        if is_heap_mut && !is_self && !tails_retained {
          emit_local_get(buf, idx)
          emit_call(buf, ctx.rc_drop_func_idx)
        } else {
          ()
        }
        // ADR-0092 for maps: `x = f(.., x, ..)` MOVES x's current value into
        // the call (perceus.vibe pe_self_reassign_moves) -- the loop-carried
        // dup that cc_is_loop_borrowed_ident would add to that occurrence
        // is off for the right-hand side (name masked out of
        // loop_borrowed_names, restored after, the #712 mechanism): the
        // old value is consumed and the binding takes the result, so
        // nothing carries across the back-edge but the new value.
        let self_moves = is_heap_mut && is_self && md_self_reassign_move_arg(value, name, ctx.borrow_param_user, ctx.borrow_param_mask)
        let mut sm_removed = 0
        if self_moves {
          let lb_arr = ctx.loop_borrowed_names
          let lb_n = Array::length(lb_arr)
          let mut lb_w = 0
          let mut lb_i = 0
          while lb_i < lb_n {
            let e = Array::get(lb_arr, lb_i)
            if e == name {
              sm_removed = sm_removed + 1
            } else {
              Array::set(lb_arr, lb_w, e)
              lb_w = lb_w + 1
            }
            lb_i = lb_i + 1
          }
          Array::truncate(lb_arr, lb_w)
        } else {
          ()
        }
        let value_for_compile = if ctx.enable_rc && slot_owning {
          rc_mut_rec_transfer_value(value, local_names, ctx, [])
        } else {
          value
        }
        let nl = compile_expr(buf, value_for_compile, local_names, next_local, ctx, ld)
        while sm_removed > 0 {
          Array::push(ctx.loop_borrowed_names, name)
          sm_removed = sm_removed - 1
        }
        if is_heap_mut && !is_self && tails_retained {
          emit_local_get(buf, idx)
          emit_call(buf, ctx.rc_drop_func_idx)
        } else {
          ()
        }
        // An owning mutable slot must acquire a borrowed replacement just
        // as it acquires a borrowed initializer. Otherwise its next drop
        // would release the container's reference instead of its own.
        //
        // #2760: both clauses above read the value's TOP node, so a WRAPPER
        // -- a block, i.e. an `ELet` / `ESeq` chain -- was neither, and
        // `x = { let k = 0; Array::get(xs, k) }` stored a borrow into a slot
        // that stays owning. Its drop then freed an element the container
        // still owned, and the next read of that element answered with
        // whatever allocation reused the block: `total(xs[0])` read 15
        // instead of 7 on the production default lane, no trap. The spine
        // walk answers for BOTH unowned leaf kinds at once; it is a third
        // clause rather than a replacement so the top-node answers, including
        // the shapes it declines, are untouched.
        //
        // #2786: a SELF-MENTIONING right-hand side needs the same spine walk,
        // gated on the plan rather than on the mention. `is_self` is
        // `assign_value_mentions` -- "the value has `name` as a free variable",
        // ANY mention -- so it lumps together a wrapper that merely READS the
        // slot on the way to an unrelated borrow and one whose stored value
        // comes out of the slot itself. Only the first is short a reference.
        //
        // `x = { Array::length(x); Array::get(xss, 0) }` stores a borrow of
        // `xss` into a slot whose scope-end drop is planned, and nothing gave
        // that slot a reference: the drop releases what `xss` still owns, the
        // free list takes the block twice, and the next allocation traps in
        // `__rt_rc_alloc`. Measured on `b7cd8c1`, still the issue's own repro.
        //
        // What separates it from the shapes that must NOT be retained is
        // `assign_slot_short_after_store` -- see its comment for the plans, and
        // for why the value's own consume count answers the wrong question here.
        // Whether the mention is at a borrowed or an owning position is NOT the
        // test, which is the correction #2786's body needed: the two shapes it
        // contrasts, `Array::length(x)` and `let t0 = total(x)`, are separated
        // by what the PLAN records for the slot and not by the position, and the
        // second of them is short a reference too in the spelling the leak lane
        // carries.
        //
        // #3184: the loop-result slot (`break v` is `__loop_result = v;
        // break`) owns what it stores too -- the loop's value is handed on as
        // an owned one -- so a view stored there is retained like one stored
        // into an owning slot; it drops nothing, as it holds only its `0`
        // initializer until the store. And a WRAPPED name is a view as well:
        // `cur = { let v = Array::get(xs, 0); v }` (`spine_leaf_ident_view`).
        let replacement_unowned = if !slot_owning {
          false
        } else if is_self {
          is_heap_mut && (call_returns_borrow(value, local_names, ctx) || (spine_leaf_unowned(value, local_names, ctx) && assign_slot_short_after_store(name, body, ctx)))
        } else {
          is_edot(value) || call_returns_borrow(value, local_names, ctx) || spine_leaf_unowned(value, local_names, ctx) || spine_leaf_ident_view(value, local_names, ctx)
        }
        // #2786, the release half. A slot that ACQUIRES its replacement has to
        // let go of what it held, or the retain trades a use-after-free for a
        // leak of the same size. The `!is_self` path above already drops the old
        // value before the store; this path cannot, because the value it is
        // about to evaluate may READ the slot -- which is what `is_self` means --
        // so the drop moves after the store and reads a saved copy.
        //
        // Measured at N=20000 on the issue's own shape, `x = { Array::length(x);
        // Array::get(xss, 0) }`: 2,160,328 B with the retain alone against 436 B
        // on main, where the heap only stayed flat because the unbalanced drop
        // was handing the container's blocks back to the allocator -- the answer
        // was wrong (10 against the bump lane's 70) and the heap looked thrifty
        // for the same reason. With the release: 412 B, the same as the
        // `!is_self` spelling of the same program.
        //
        // TWO conditions, and neither is belt-and-braces. The value must not
        // have CONSUMED the slot (`let k = sink(x)`), or the saved copy is
        // already dead and this drop is the second one. And the stored value must
        // not be derived FROM the slot (`x = { Array::length(x); pick(x) }`, a
        // user borrow-returning function, the only spelling whose type can match
        // the slot's own) -- releasing there frees exactly the reference just
        // stored. No battery shape reaches the second guard, because the plan
        // budgets a dup for a self-derived leaf and the arithmetic above declines
        // it first (measured: `dup 1, drop 1` for both `pick(x)` spellings, and
        // `dup 2, drop 1` once a consuming use is added). It is kept because the
        // property is structural -- a slot cannot release what it just stored --
        // and not because a measurement pins it.
        //
        // #3135: an OPERATOR result needs the same release though it is owned.
        // `acc = acc + x` on a `Double` reads the slot as a borrow (the plan's
        // `pc_operand_count`) and stores a fresh box, so nothing consumed the
        // box the slot held and every such reassignment leaked 16 B. An
        // operator's result is never derived from its operands' blocks (an
        // Int, a Bool or a fresh box), so the second guard does not apply to
        // it; the consume count still does.
        let leaf = mib_spine_leaf(value, array_empty())
        let fresh_operator_leaf = match leaf {
          EBinOp(_, _, _, _) => true,
          EUnaryOp(_, _) => true,
          _ => false
        }
        let fresh_scalar_array_leaf = reassign_fresh_scalar_array(leaf, local_names, ctx)
        let release_old = is_self && (replacement_unowned || fresh_operator_leaf || fresh_scalar_array_leaf) && is_heap_mut && ctx.rc_drop_func_idx >= 0 && md_consume_count_b(value, name, ctx.borrow_param_user, ctx.borrow_param_mask) == 0 && (fresh_operator_leaf || fresh_scalar_array_leaf || !assign_value_mentions(leaf, name))
        let nl_after = if release_old {
          emit_local_get(buf, idx)
          emit_local_set(buf, nl)
          cet_record_local_slot(local_names, nl)
          nl + 1
        } else {
          nl
        }
        emit_local_set(buf, idx)
        // #3168: a parameterized loop's result slot owns what its `break v`
        // stores, and the loop hands that on (or its scope end releases it).
        // A value the exit operand's test cannot vouch for as owned -- a
        // borrowed `let` alias, a pattern binder, a `for` element -- is
        // retained, the direction that can only leak.
        let conditional_break_rec = is_loop_result_slot(name) && rc_exit_break_result_owns_rec(get_eassign_val(expr), local_names, ctx)
        let slot_retain = is_heap_mut && !replacement_unowned && !store_retain && !tails_retained && array_contains_str(ctx.rc_loop_result_slots, name) && !conditional_break_rec && !rc_exit_value_owned(ctx, local_names, value)
        if replacement_unowned || slot_retain {
          emit_rc_dup_guarded(buf, idx, ctx.rc_shadow, ctx.rc_dup_func_idx)
        } else {
          ()
        }
        if release_old {
          emit_local_get(buf, nl)
          emit_call(buf, ctx.rc_drop_func_idx)
        } else {
          ()
        }
        // #715/#791: the Perceus plan's dup budget for a `let mut` binding
        // (ctx.rc_dup_names occurrences) is applied ONCE, to the INITIAL value
        // at the declaration site -- but the scope-end drop and every
        // remaining owning use consume the binding's CURRENT value. After a
        // reassignment, the freshly stored value carries only its own single
        // reference; without re-applying the budget here, the tail use plus
        // the scope-end drop over-consume it by exactly the planned dup count
        // (checker_effects.vibe's lookup_fn_effs: `let mut found = None;
        // ... found = Some(..) ...; found` -- the returned Some was freed by
        // the binding's scope-end drop while the caller still held it; the
        // #706 borrow-retention bump from the bare `match found` is what put
        // the +1 in the budget). Worst case this over-retains (a leak) when
        // part of the budget was already spent before the reassign -- the
        // codebase-wide "leak/no-op at worst, never corrupt" trade.
        //
        // #791: this budget reapplication was gated on `!is_self`, so a
        // SELF-referential reassignment (`s = f(s, ...)`, e.g. a loop
        // accumulator `s = Set::add(s, i)`) never got it -- only the narrow
        // `reassign_self_reusable` tuple-element branch above has its own
        // protection, and non-tuple self-reassignment (an ECall RHS, the
        // common accumulator shape) falls through to this same `else` with
        // no compensating dup at all. The freshly stored value then carries
        // only the single reference `f` returned, so the FIRST subsequent
        // owning use of `s` (which internally drops its param) frees it
        // prematurely; later uses read/reuse the freed block, corrupting
        // memory once an intervening allocation reuses it (2+ further uses
        // needed to observe it -- 1 further use still "works" because
        // nothing has overwritten the freed-but-untouched memory yet).
        // Reproduced/diagnosed via #791 (examples/set_test.vibe "multiple
        // adds"): `let mut s = Set::new(); while ... { s = Set::add(s, i) };
        // assert(Set::size(s)==20); assert(Set::contains(s,0));
        // assert(Set::contains(s,19))` traps under RC1 -- `Set::size`/
        // `Set::contains` take `s` by projection only (`s.items`), which
        // Perceus's use-counting doesn't count as an owning use, so both
        // functions unconditionally drop `s` in their epilogue; the caller
        // must dup before every non-last such call, exactly like the
        // `!is_self` case already handles. Applying the same budget here
        // (mirroring the `!is_self` path) fixes it: at worst an extra dup on
        // an already-dead reference (a leak, per the trade-off above), never
        // a missing one.
        if ctx.enable_rc && is_heap_mut && !array_contains_str(ctx.rc_mut_use_names, name) {
          let mut adbi = 0
          while adbi < Array::length(ctx.rc_dup_names) {
            if Array::get(ctx.rc_dup_names, adbi) == name {
              emit_rc_dup_guarded(buf, idx, ctx.rc_shadow, ctx.rc_dup_func_idx)
            } else {
              ()
            }
            adbi = adbi + 1
          }
        } else {
          ()
        }
        // #3141: an early exit in the continuation must not release what the
        // stored value may still read (see rc_exit_note_store) -- unless the
        // slot retained it above and so holds a reference of its own.
        let xtok = if replacement_unowned || store_retain || slot_retain {
          0 - 1
        } else {
          rc_exit_note_store(ctx, local_names, value)
        }
        let result_store_mark = Array::length(ctx.rc_exit_result_stores)
        if ctx.enable_rc && is_loop_result_slot(name) {
          Array::push(ctx.rc_exit_result_stores, (name, get_eassign_val(expr)))
        }
        let rnl = compile_expr(buf, body, local_names, nl_after, ctx, ld)
        Array::truncate(ctx.rc_exit_result_stores, result_store_mark)
        rc_exit_end_store(ctx, xtok)
        rnl
      }
    }
  } else if __tag == 13 {
    let name = get_eassignop_name(expr)
    let op = get_eassignop_op(expr)
    let value = get_eassignop_val(expr)
    let body = get_eassignop_body(expr)
    let idx = resolve_local(local_names, name, "assignop")
    if (op == "+" || op == "-" || op == "*" || op == "/") && (slot_is_floatish(ctx, idx) || expr_is_floatish(value, local_names, ctx)) {
      // Reuse the ordinary Double binop and assignment paths. They unbox the
      // operands, rebox the result under RC, and release the old owned slot.
      compile_expr(buf, EAssign(name, EBinOp(op, EIdent(name, -1), value, -1), body), local_names, next_local, ctx, ld)
    } else if array_contains_str(ctx.ref_cell_names, name) {
      emit_local_get(buf, idx)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, idx)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, 0)
      emit_assignop_rc_mul_pre(buf, ctx.enable_rc, op)
      let nl = emit_int_div_zero_guard(buf, op, value, first_offset(value), ctx, local_names, compile_expr(buf, value, local_names, next_local, ctx, ld))
      emit_assignop_op(buf, op)
      emit_assignop_rc_tag_fix(buf, ctx.enable_rc, op)
      emit_arith_wrap_int(buf, ctx.enable_rc, op)
      emit_i64_store(buf, 3, 0)
      compile_expr(buf, body, local_names, nl, ctx, ld)
    } else {
      emit_local_get(buf, idx)
      emit_assignop_rc_mul_pre(buf, ctx.enable_rc, op)
      let nl = emit_int_div_zero_guard(buf, op, value, first_offset(value), ctx, local_names, compile_expr(buf, value, local_names, next_local, ctx, ld))
      emit_assignop_op(buf, op)
      emit_assignop_rc_tag_fix(buf, ctx.enable_rc, op)
      emit_arith_wrap_int(buf, ctx.enable_rc, op)
      emit_local_set(buf, idx)
      compile_expr(buf, body, local_names, nl, ctx, ld)
    }
  } else if __tag == 14 {
    let first = get_eseq_first(expr)
    let second = get_eseq_second(expr)
    emit_dbg_line_for(buf, first, ctx)
    // #1916: a `for` at the head of a sequence is statement-shaped (same
    // classification the checker uses, #1679) -- its comprehension result is
    // discarded right here by the emit_drop below, so compile it in the
    // no-collect form instead of materializing an array nobody reads.
    // `forin_is_discarded_seq_head` is shared with the captured-cell marker
    // (cl_own_cells), which must not retain a body value this form drops.
    let nl = if forin_is_discarded_seq_head(first) {
      compile_forin_loop(buf, first, local_names, next_local, ctx, ld, compile_expr, false)
    } else {
      compile_expr(buf, first, local_names, next_local, ctx, ld)
    }
    if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && seq_discard_owns_result(first, local_names, ctx) {
      emit_call(buf, ctx.rc_drop_func_idx)
    } else {
      emit_drop(buf)
    }
    compile_expr(buf, second, local_names, nl, ctx, ld)
  } else {
    compile_expr_tail2(buf, expr, local_names, next_local, ctx, ld, compile_expr)
  }
}
