    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, cnt_l)
    emit_i64_const(buf, 0)
    emit_local_set(buf, i_l)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf, i_l)
    emit_local_get(buf, cnt_l)
    emit_i64_ge_s(buf)
    emit_br_if(buf, 1)
    emit_local_get(buf, res_l)
    emit_local_get(buf, map_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf, i_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 16)
    emit_i32_mul(buf)
    emit_i32_add(buf)
    emit_i64_load(buf, 3, 8)
    // #2683: the key is now owned by the map AND the array (a scalar or
    // string key makes this a guarded no-op).
    if ctx.enable_rc {
      emit_local_tee(buf, tmp_l)
      emit_rc_dup_guarded(buf, tmp_l, ctx.rc_shadow, ctx.rc_dup_func_idx)
    } else {
      ()
    }
    emit_call(buf, arr_push_fi)
    emit_local_get(buf, i_l)
    emit_i64_const(buf, 1)
    emit_i64_add(buf)
    emit_local_set(buf, i_l)
    emit_br(buf, 0)
    emit_end(buf)
    emit_end(buf)
    cc_map_release_temp_arg0(buf, Array::get(args, 0), map_l, ctx)
    emit_local_get(buf, res_l)
    nl + 5
  }
  else if fname == "Map::values" {
