    let (arr_push_fi, _, _) = resolve_func(ctx.func_table, "Array::push")
    let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    let map_l = nl
    let res_l = nl + 1
    let cnt_l = nl + 2
    let i_l = nl + 3
    let tmp_l = nl + 4
    Array::push(local_names, "__values_map")
    Array::push(local_names, "__values_res")
    Array::push(local_names, "__values_cnt")
    Array::push(local_names, "__values_i")
    Array::push(local_names, "__values_tmp")
    emit_local_set(buf, map_l)
    emit_local_get(buf, map_l)
    emit_i64_const(buf, -2)
    emit_i64_and(buf)
    emit_local_set(buf, map_l)
    emit_call(buf, arr_new_fi)
    emit_local_set(buf, res_l)
    emit_local_get(buf, map_l)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, cnt_l)
    emit_i64_const(buf, 0)
    emit_local_set(buf, i_l)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf, i_l)
    emit_local_get(buf, cnt_l)
    emit_i64_ge_s(buf)
    emit_br_if(buf, 1)
    emit_local_get(buf, res_l)
    emit_local_get(buf, map_l)
    emit_i32_wrap_i64(buf)
    emit_local_get(buf, i_l)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 16)
    emit_i32_mul(buf)
    emit_i32_add(buf)
    emit_i64_load(buf, 3, 16)
    // #2683: the map keeps its value and the array takes a reference of
    // its own (an RC map is dropped when its owner is; the array's walking
    // drop must not free what the map still holds).
    if ctx.enable_rc {
      emit_local_tee(buf, tmp_l)
      emit_rc_dup_guarded(buf, tmp_l, ctx.rc_shadow, ctx.rc_dup_func_idx)
    } else {
      ()
    }
    emit_call(buf, arr_push_fi)
    emit_local_get(buf, i_l)
    emit_i64_const(buf, 1)
    emit_i64_add(buf)
    emit_local_set(buf, i_l)
    emit_br(buf, 0)
    emit_end(buf)
    emit_end(buf)
    cc_map_release_temp_arg0(buf, Array::get(args, 0), map_l, ctx)
    emit_local_get(buf, res_l)
    nl + 5
  }
  else if fname == "Map::size" {
    let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    let map_l = nl
    let cnt_l = nl + 1
    Array::push(local_names, "__size_map")
    Array::push(local_names, "__size_cnt")
    emit_local_set(buf, map_l)
    emit_local_get(buf, map_l)
    emit_i64_const(buf, -2)
    emit_i64_and(buf)
    emit_local_set(buf, map_l)
    emit_local_get(buf, map_l)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0)
    emit_i64_extend_i32_u(buf)
    // Under RC an Int is a TAGGED scalar (n << 1); the raw i32 count loaded
    // above is untagged, so tag it here. Without this the tagged lane's
    // return/untag path (`>> 1`) halves the count (2-elem map reported 1).
    // The bump backend leaves Ints untagged, so only shift under RC.
    if ctx.enable_rc {
      emit_i64_const(buf, 1)
      emit_i64_shl(buf)
    } else {
      ()
    }
    emit_local_set(buf, cnt_l)
    cc_map_release_temp_arg0(buf, Array::get(args, 0), map_l, ctx)
    emit_local_get(buf, cnt_l)
    nl + 2
  }
  else if fname == "Map::get" {
    let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
    let (map_get_eq_idx, _, _) = resolve_func(ctx.func_table, "eq")
    let map_local = nl
    let key_local = nl + 1
    let count_local = nl + 2
    let idx_local = nl + 3
    Array::push(local_names, "__map_ref")
    Array::push(local_names, "__map_key")
    Array::push(local_names, "__map_cnt")
    Array::push(local_names, "__map_i")
    emit_local_set(buf, key_local)
    emit_local_set(buf, map_local)
    emit_local_get(buf, map_local)
    emit_i64_const(buf, -2)
    emit_i64_and(buf)
    emit_local_set(buf, map_local)
    emit_local_get(buf, map_local)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, count_local)
    if ctx.map_probe_func_idx >= 0 {
      let idxptr_local = nl + 4
      Array::push(local_names, "__map_idxptr")
      emit_local_get(buf, map_local)
      emit_i32_wrap_i64(buf)
      emit_i32_load(buf, 2, 4)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, idxptr_local)
      emit_local_get(buf, idxptr_local)
      emit_i64_eqz(buf)
      emit_if_i64(buf)
      cc_map_get_linear_scan(buf, map_local, key_local, count_local, idx_local, map_get_eq_idx)
      emit_else(buf)
      emit_local_get(buf, map_local)
      emit_local_get(buf, count_local)
      emit_local_get(buf, key_local)
      emit_call(buf, ctx.map_probe_func_idx)
      emit_local_set(buf, idx_local)
      emit_local_get(buf, idx_local)
      emit_i64_const(buf, 0)
      emit_i64_lt_s(buf)
      emit_if_i64(buf)
      // #2990: see `cc_map_get_linear_scan`.
      bytebuf_push(buf, 0)
      emit_else(buf)
      emit_local_get(buf, map_local)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, idx_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 16)
      emit_i32_mul(buf)
      emit_i32_add(buf)
      emit_i64_load(buf, 3, 16)
      emit_end(buf)
      emit_end(buf)
      nl + 5
    } else {
      cc_map_get_linear_scan(buf, map_local, key_local, count_local, idx_local, map_get_eq_idx)
      nl + 4
    }
  }
  else if fname == "Map::has_key" || fname == "Map::has" || fname == "map_has" {
    let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
    let (eq_fi, _, _) = resolve_func(ctx.func_table, "eq")
    let map_l = nl; let key_l = nl + 1; let cnt_l = nl + 2; let i_l = nl + 3
    // idxptr_l is only READ when ctx.map_probe_func_idx >= 0, but reserved
    // unconditionally so this arm always returns the same local count.
    let idxptr_l = nl + 4
    Array::push(local_names, "__hk_map"); Array::push(local_names, "__hk_key")
    Array::push(local_names, "__hk_cnt"); Array::push(local_names, "__hk_i")
    Array::push(local_names, "__hk_idxptr")
    emit_local_set(buf, key_l); emit_local_set(buf, map_l)
    emit_local_get(buf, map_l); emit_i64_const(buf, -2); emit_i64_and(buf); emit_local_set(buf, map_l)
    emit_local_get(buf, map_l); emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0); emit_i64_extend_i32_u(buf); emit_local_set(buf, cnt_l)
    if ctx.map_probe_func_idx >= 0 {
      emit_local_get(buf, map_l)
      emit_i32_wrap_i64(buf)
      emit_i32_load(buf, 2, 4)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, idxptr_l)
      emit_local_get(buf, idxptr_l)
      emit_i64_eqz(buf)
      emit_if_i64(buf)
      cc_map_has_linear_scan(buf, map_l, key_l, cnt_l, i_l, eq_fi)
      emit_else(buf)
      emit_local_get(buf, map_l)
      emit_local_get(buf, cnt_l)
      emit_local_get(buf, key_l)
      emit_call(buf, ctx.map_probe_func_idx)
      emit_i64_const(buf, 0)
      emit_i64_ge_s(buf)
      emit_if_i64(buf)
      emit_i64_const(buf, 1)
      emit_else(buf)
      emit_i64_const(buf, 0)
      emit_end(buf)
      emit_end(buf)
    } else {
      cc_map_has_linear_scan(buf, map_l, key_l, cnt_l, i_l, eq_fi)
    }
    // Under RC a Bool is a TAGGED scalar (n << 1); the block yields a raw 0/1,
    // so tag it to match tagged Bool literals (see Array::any). Latent
    // `Map::has_key(..) == true` mismatch under VIBE_RC=1.
    if ctx.enable_rc {
      emit_i64_const(buf, 1)
      emit_i64_shl(buf)
    } else {
      ()
    }
    // i_l is dead after the scan: park the answer there across the release.
    emit_local_set(buf, i_l)
    cc_map_release_temp_arg0(buf, Array::get(args, 0), map_l, ctx)
    emit_local_get(buf, i_l)
    nl + 5
  }
  else if fname == "Map::remove" {
    ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
  }
  else if fname == "Map::set" {
    let (eq_fi_ms, _, _) = resolve_func(ctx.func_table, "eq")
    let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
    // Map::set STORES key and value — retain borrowed args (#745).
    nl = cc_retain_stored_arg(buf, Array::get(args, 1), local_names, nl, ctx)
    nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)
    nl = cc_retain_stored_arg(buf, Array::get(args, 2), local_names, nl, ctx)
    let map_l = nl
    let key_l = nl + 1
    let val_l = nl + 2
    let cnt_l = nl + 3
    let new_l = nl + 4
    let idx_l = nl + 5
    let found_l = nl + 6
    let tmp_l = nl + 7
    let ip_l = nl + 8
    let cap_l = nl + 9
    Array::push(local_names, "__ms_map")
    Array::push(local_names, "__ms_key")
    Array::push(local_names, "__ms_val")
    Array::push(local_names, "__ms_cnt")
    Array::push(local_names, "__ms_new")
    Array::push(local_names, "__ms_idx")
    Array::push(local_names, "__ms_found")
    Array::push(local_names, "__ms_tmp")
    Array::push(local_names, "__ms_ip")
    Array::push(local_names, "__ms_cap")
    emit_local_set(buf, val_l)
    emit_local_set(buf, key_l)
    emit_local_set(buf, map_l)
    // ADR-0092 for maps: the map is CONSUMED here (an owning position; see
    // md_is_borrow_arg0_call), unless the argument is a view or a
    // planner-borrowed binding -- then take a reference of our own, as
    // MapBuilder::freeze does. The tagged value is retained; the untagged
    // pointer the reads use is derived after.
    cc_hof_retain_arg(buf, Array::get(args, 0), map_l, fname, 0, ctx)
    emit_local_get(buf, map_l)
    emit_i64_const(buf, -2)
    emit_i64_and(buf)
    emit_local_set(buf, map_l)
    emit_local_get(buf, map_l)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, cnt_l)
    // The copy path: a fresh block of count + 1 entries, the source's
    // entries copied (and, on the RC lane, retained), the new entry
    // replacing or appended.
    let copy_path = () -> {
      if ctx.enable_rc {
        // #2683: an RC map block (class 6) sized for count + 1 entries.
        cc_map_alloc_rc(buf, new_l, 6, () -> {
          emit_local_get(buf, cnt_l)
          emit_i64_const(buf, 1)
          emit_i64_add(buf)
          emit_i64_const(buf, 16)
          emit_i64_mul(buf)
          emit_i64_const(buf, 8)
          emit_i64_add(buf)
        }, ctx)
      } else {
        emit_global_get(buf, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, new_l)
        emit_global_get(buf, 0)
        emit_local_get(buf, cnt_l)
        emit_i64_const(buf, 1)
        emit_i64_add(buf)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 16)
        emit_i32_mul(buf)
        emit_i32_const(buf, 8)
        emit_i32_add(buf)
        emit_i32_add(buf)
        emit_global_set(buf, 0)
        emit_heap_grow_after_heap_set(buf, ctx)
      }
      emit_i64_const(buf, 0)
      emit_local_set(buf, idx_l)
      emit_i64_const(buf, 0)
      emit_local_set(buf, found_l)
      emit_block_void(buf)
      emit_loop_void(buf)
      emit_local_get(buf, idx_l)
      emit_local_get(buf, cnt_l)
      emit_i64_ge_s(buf)
      emit_br_if(buf, 1)
      emit_local_get(buf, new_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, idx_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 16)
      emit_i32_mul(buf)
      emit_i32_add(buf)
      emit_local_get(buf, map_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, idx_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 16)
      emit_i32_mul(buf)
      emit_i32_add(buf)
      emit_i64_load(buf, 3, 8)
      // #2683: the copied key is owned by both maps (see the value below).
      if ctx.enable_rc {
        emit_local_tee(buf, tmp_l)
        emit_rc_dup_guarded(buf, tmp_l, ctx.rc_shadow, ctx.rc_dup_func_idx)
      } else {
        ()
      }
      emit_i64_store(buf, 3, 8)
      emit_local_get(buf, map_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, idx_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 16)
      emit_i32_mul(buf)
      emit_i32_add(buf)
      emit_i64_load(buf, 3, 8)
      emit_local_get(buf, key_l)
      emit_call(buf, eq_fi_ms)
      emit_i32_wrap_i64(buf)
      emit_if_void(buf)
      emit_local_get(buf, new_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, idx_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 16)
      emit_i32_mul(buf)
      emit_i32_add(buf)
      emit_local_get(buf, val_l)
      emit_i64_store(buf, 3, 16)
      emit_i64_const(buf, 1)
      emit_local_set(buf, found_l)
      // #2683: the key already present is kept; the caller's key was
      // retained for storage and is not stored -- release it.
      if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {
        emit_local_get(buf, key_l)
        emit_call(buf, ctx.rc_drop_func_idx)
      } else {
        ()
      }
      emit_else(buf)
      emit_local_get(buf, new_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, idx_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 16)
      emit_i32_mul(buf)
      emit_i32_add(buf)
      emit_local_get(buf, map_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, idx_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 16)
      emit_i32_mul(buf)
      emit_i32_add(buf)
      emit_i64_load(buf, 3, 16)
