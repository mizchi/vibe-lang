    }
    if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {
      // ADR-0092 for maps: a uniquely referenced source is updated in
      // place and is the result; a shared one is copied, then the
      // consumed reference is released.
      cc_map_emit_unique_test(buf, map_l)
      emit_if_void(buf)
      cc_map_set_in_place(buf, map_l, key_l, val_l, cnt_l, new_l, idx_l, found_l, tmp_l, ip_l, cap_l, eq_fi_ms, ctx)
      emit_else(buf)
      copy_path()
      cc_map_release_ptr(buf, map_l, ctx)
      emit_end(buf)
    } else {
      copy_path()
    }
    cc_map_value_out(buf, new_l, ctx)
    nl + 10
  } else {
    cc_compile_named_3(buf, callee, args, local_names, next_local, ctx, ld, ce, fname, fn_idx_in_list, resolved_name, local_idx_hint, prefer_bound_call, ctor_lookup_idx, compile_call_core_fn)
  }
}
