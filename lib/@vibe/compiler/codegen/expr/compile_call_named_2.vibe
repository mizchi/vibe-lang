      // is borrowed here and keeps its reference.
      if ctx.enable_rc {
        emit_local_tee(buf, tmp_l)
        emit_rc_dup_guarded(buf, tmp_l, ctx.rc_shadow, ctx.rc_dup_func_idx)
      } else {
        ()
      }
      emit_i64_store(buf, 3, 16)
      emit_end(buf)
      emit_local_get(buf, idx_l)
      emit_i64_const(buf, 1)
      emit_i64_add(buf)
      emit_local_set(buf, idx_l)
      emit_br(buf, 0)
      emit_end(buf)
      emit_end(buf)
      emit_local_get(buf, found_l)
      emit_i64_eqz(buf)
      emit_if_void(buf)
      emit_local_get(buf, new_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, cnt_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 16)
      emit_i32_mul(buf)
      emit_i32_add(buf)
      emit_local_get(buf, key_l)
      emit_i64_store(buf, 3, 8)
      emit_local_get(buf, new_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, cnt_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 16)
      emit_i32_mul(buf)
      emit_i32_add(buf)
      emit_local_get(buf, val_l)
      emit_i64_store(buf, 3, 16)
      emit_local_get(buf, new_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, cnt_l)
      emit_i64_const(buf, 1)
      emit_i64_add(buf)
      emit_i32_wrap_i64(buf)
      emit_i32_store(buf, 2, 0)
      emit_else(buf)
      emit_local_get(buf, new_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, cnt_l)
      emit_i32_wrap_i64(buf)
      emit_i32_store(buf, 2, 0)
      emit_end(buf)
      // #Map-hash-index: (re-loading the just-written final count from new_l
      // rather than re-deriving it from found_l/cnt_l) build + attach the
      // O(1)-average side index when it's worth it (count>=8). idx_l/found_l
      // are dead after the copy loop above -- reused here as scratch (final
      // count, then the built index pointer) so this needs no new locals.
      if ctx.map_build_index_func_idx >= 0 {
        emit_local_get(buf, new_l)
        emit_i32_wrap_i64(buf)
        emit_i32_load(buf, 2, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, idx_l)
        emit_local_get(buf, idx_l)
        emit_i64_const(buf, 8)
        emit_i64_ge_s(buf)
        emit_if_void(buf)
        emit_local_get(buf, new_l)
        emit_local_get(buf, idx_l)
        emit_call(buf, ctx.map_build_index_func_idx)
        emit_local_set(buf, found_l)
        emit_local_get(buf, new_l)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, found_l)
        emit_i32_wrap_i64(buf)
        emit_i32_store(buf, 2, 4)
        emit_end(buf)
      } else {
