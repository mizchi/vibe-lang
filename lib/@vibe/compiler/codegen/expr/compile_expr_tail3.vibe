//# Functions

export fn compile_expr_tail3(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Error) -> Int with Error {
  let __tag = expr_tag(expr)
  if __tag == 19 {
    let cond = get_ewhile_cond(expr)
    let body = get_ewhile_body(expr)
    // #706: the locals live at the loop header are loop-borrowed — a consume of
    // one inside the cond/body re-executes each iteration and must dup so the
    // value survives the back-edge. Record them (RC only); restore after. Names
    // declared inside the body are appended past lb_base and removed by truncate.
    let lb_base = Array::length(ctx.loop_borrowed_names)
    if ctx.enable_rc {
      let mut lbi = 0
      while lbi < Array::length(local_names) {
        Array::push(ctx.loop_borrowed_names, Array::get(local_names, lbi))
        lbi = lbi + 1
      }
    } else {
      ()
    }
    emit_block_void(buf)
    emit_loop_void(buf)
    // ld measures wasm blocks between the current position and the INNERMOST
    // loop header (EBreak emits `br ld+1`, EContinue `br ld`). A new loop
    // RESETS that distance to 0 — the previous `ld + 1` only converted the
    // top-level -1 correctly; for a while nested in another loop it kept
    // counting from the OUTER loop, so an inner `break` jumped to the outer
    // loop header (observed as an infinite insertion sort in
    // fixtures/index_assign_test.vibe).
    let w_ld_in = 0
    let w_cond_tag = expr_tag(cond)
    let nl1 = if w_cond_tag == 5 {
      let wcop = get_ebinop_op(cond)
      if wcop == "<" || wcop == ">" || wcop == "<=" || wcop == ">=" {
        let wlhs = get_ebinop_lhs(cond)
        let wrhs = get_ebinop_rhs(cond)
        let wnl1 = compile_expr(buf, wlhs, local_names, next_local, ctx, w_ld_in)
        let wnl2 = compile_expr(buf, wrhs, local_names, wnl1, ctx, w_ld_in)
        if wcop == "<" {
          emit_i64_lt_s(buf); emit_i32_eqz(buf)
        }
        else if wcop == ">" {
          emit_i64_gt_s(buf); emit_i32_eqz(buf)
        }
        else if wcop == "<=" {
          emit_i64_le_s(buf); emit_i32_eqz(buf)
        }
        else {
          emit_i64_ge_s(buf); emit_i32_eqz(buf)
        }
        wnl2
      } else {
        let wnl = compile_expr(buf, cond, local_names, next_local, ctx, w_ld_in)
        emit_i64_eqz(buf)
        wnl
      }
    } else {
      let wnl = compile_expr(buf, cond, local_names, next_local, ctx, w_ld_in)
      emit_i64_eqz(buf)
      wnl
    }
    emit_br_if(buf, 1)
    let nl2 = compile_expr(buf, body, local_names, nl1, ctx, w_ld_in)
    emit_drop(buf)
    emit_br(buf, 0)
    emit_end(buf)
    emit_end(buf)
    Array::truncate(ctx.loop_borrowed_names, lb_base)
    emit_i64_const(buf, 0)
    nl2
  } else if __tag == 20 {
    emit_br(buf, ld + 1)
    emit_i64_const(buf, 0)
    next_local
  } else if __tag == 21 {
    emit_br(buf, ld)
    emit_i64_const(buf, 0)
    next_local
  } else if __tag == 22 {
    emit_i64_const(buf, 0)
    next_local
  } else if __tag == 24 {
    compile_lambda(buf, get_efn_params(expr), get_efn_body(expr), local_names, next_local, ctx, ld, compile_expr)
  } else if __tag == 26 {
    let ret_expr = get_ereturn_expr(expr)
    let nl = compile_expr(buf, ret_expr, local_names, next_local, ctx, ld)
    emit_return(buf)
    nl
  } else {
    compile_expr_tail4(buf, expr, local_names, next_local, ctx, ld, compile_expr)
  }
}
