//# Functions

fn return_result_mentions(e: Expr, name: String) -> Bool {
  array_contains_str(collect_free_vars(e, [], []), name)
}

fn return_result_is_name(e: Expr, name: String) -> Bool {
  match cl_return_operand(e) {
    EIdent(result, _) => result == name,
    ELet(bound, value, tail, _) => bound != name && (if return_result_is_name(tail, bound) {
      return_result_is_name(value, name)
    } else {
      !return_result_mentions(value, name) && return_result_is_name(tail, name)
    }),
    ELetMut(bound, value, tail, _) => bound != name && !return_result_mentions(value, name) && return_result_is_name(tail, name),
    ELetRec(bound, value, tail) => bound != name && !return_result_mentions(value, name) && return_result_is_name(tail, name),
    ESeq(head, tail) => !return_result_mentions(head, name) && return_result_is_name(tail, name),
    EAssign(target, value, tail) => target != name && !return_result_mentions(value, name) && return_result_is_name(tail, name),
    EAssignOp(target, _, value, tail) => target != name && !return_result_mentions(value, name) && return_result_is_name(tail, name),
    _ => false
  }
}

fn return_result_has_branch(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool {
  match cl_return_operand(e) {
    EIf(_, _, _) => true,
    EMatch(_, _) => true,
    ECall(EIdent(callee, _), args, _) => {
      if find_local_slot(local_names, callee) >= 0 {
        return false
      }
      for row in ctx.passthrough_ret_params {
        if row.0 == callee && row.1 < Array::length(args) {
          return return_result_has_branch(Array::get(args, row.1), local_names, ctx)
        }
      }
      false
    },
    ELet(name, value, body, _) => return_result_has_branch(body, local_names, ctx) || (return_result_is_name(body, name) || rc_exit_passthrough_rec_result(body, name, local_names, [
    ], ctx)) && return_result_has_branch(value, local_names, ctx),
    ELetMut(name, value, body, _) => return_result_has_branch(body, local_names, ctx) || (return_result_is_name(body, name) || rc_exit_passthrough_rec_result(body, name, local_names, [
    ], ctx)) && return_result_has_branch(value, local_names, ctx),
    ELetRec(name, value, body) => return_result_has_branch(body, local_names, ctx) || (return_result_is_name(body, name) || rc_exit_passthrough_rec_result(body, name, local_names, [
    ], ctx)) && return_result_has_branch(value, local_names, ctx),
    ESeq(_, tail) => return_result_has_branch(tail, local_names, ctx),
    EAssign(_, _, tail) => return_result_has_branch(tail, local_names, ctx),
    EAssignOp(_, _, _, tail) => return_result_has_branch(tail, local_names, ctx),
    _ => false
  }
}

export fn compile_expr_tail3(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let __tag = expr_tag(expr)
  if __tag == 19 {
    let cond = get_ewhile_cond(expr)
    let body = get_ewhile_body(expr)
    // #706: the locals live at the loop header are loop-borrowed — a consume of
    // one inside the cond/body re-executes each iteration and must dup so the
    // value survives the back-edge. Record them (RC only); restore after. Names
    // declared inside the body are appended past lb_base and removed by truncate.
    let lb_base = Array::length(ctx.loop_borrowed_names)
    if ctx.enable_rc {
      let mut lbi = 0
      while lbi < Array::length(local_names) {
        Array::push(ctx.loop_borrowed_names, Array::get(local_names, lbi))
        lbi = lbi + 1
      }
    } else {
      ()
    }
    // #3141: a `break` / `continue` below leaves only what the body binds.
    let xmark = Array::length(ctx.rc_exit_stack_names)
    rc_exit_push(ctx.rc_exit_stack_names, ctx.rc_exit_stack_info, "", 100, 0 - 1, 0 - 1)
    emit_block_void(buf)
    emit_loop_void(buf)
    // ld measures wasm blocks between the current position and the INNERMOST
    // loop header (EBreak emits `br ld+1`, EContinue `br ld`). A new loop
    // RESETS that distance to 0 — the previous `ld + 1` only converted the
    // top-level -1 correctly; for a while nested in another loop it kept
    // counting from the OUTER loop, so an inner `break` jumped to the outer
    // loop header (observed as an infinite insertion sort in
    // fixtures/index_assign_test.vibe).
    let w_ld_in = 0
    let w_cond_tag = expr_tag(cond)
    let nl1 = if w_cond_tag == 5 {
      let wcop = get_ebinop_op(cond)
      // #3135: the fast path compares i64s, which is an Int comparison only.
      // A `Double` operand is a box pointer on the RC lane, so
      // `while x < 3.0` compared two ADDRESSES: measured on main at
      // c04f4d619, a loop counting x from 0.5 past 3.0 trapped in the
      // allocator, and with the operand boxes released it answered after one
      // iteration instead of three. A `Double` comparison takes the general
      // path, which compares f64 values (compile_expr's float binop arm).
      if (wcop == "<" || wcop == ">" || wcop == "<=" || wcop == ">=") && !cc_operands_floatish(get_ebinop_lhs(cond), get_ebinop_rhs(cond), local_names, ctx) {
        let wlhs = get_ebinop_lhs(cond)
        let wrhs = get_ebinop_rhs(cond)
        let wnl1 = compile_expr(buf, wlhs, local_names, next_local, ctx, w_ld_in)
        let wnl2 = compile_expr(buf, wrhs, local_names, wnl1, ctx, w_ld_in)
        if wcop == "<" {
          emit_i64_lt_s(buf); emit_i32_eqz(buf)
        }
        else if wcop == ">" {
          emit_i64_gt_s(buf); emit_i32_eqz(buf)
        }
        else if wcop == "<=" {
          emit_i64_le_s(buf); emit_i32_eqz(buf)
        }
        else {
          emit_i64_ge_s(buf); emit_i32_eqz(buf)
        }
        wnl2
      } else {
        let wnl = compile_expr(buf, cond, local_names, next_local, ctx, w_ld_in)
        emit_i64_eqz(buf)
        wnl
      }
    } else {
      let wnl = compile_expr(buf, cond, local_names, next_local, ctx, w_ld_in)
      emit_i64_eqz(buf)
      wnl
    }
    emit_br_if(buf, 1)
    let nl2 = compile_expr(buf, body, local_names, nl1, ctx, w_ld_in)
    emit_drop(buf)
    emit_br(buf, 0)
    emit_end(buf)
    emit_end(buf)
    rc_exit_truncate(ctx, xmark)
    Array::truncate(ctx.loop_borrowed_names, lb_base)
    emit_i64_const(buf, 0)
    nl2
  } else if __tag == 20 {
    // #3141: release the loop body's scopes the `br` jumps past.
    let brk_operand = match expr {
      EBreak(Some(v)) => v,
      _ => EUnit
    }
    rc_exit_release(buf, ctx, local_names, 1, brk_operand, 0 - 1)
    emit_br(buf, ld + 1)
    emit_i64_const(buf, 0)
    next_local
  } else if __tag == 21 {
    rc_exit_release(buf, ctx, local_names, 2, EUnit, 0 - 1)
    emit_br(buf, ld)
    emit_i64_const(buf, 0)
    next_local
  } else if __tag == 22 {
    emit_i64_const(buf, 0)
    next_local
  } else if __tag == 24 {
    compile_lambda(buf, get_efn_params(expr), get_efn_body(expr), local_names, next_local, ctx, ld, compile_expr)
  } else if __tag == 26 {
    let ret_expr = get_ereturn_expr(expr)
    let owned_ret = if ctx.enable_rc && ctx.rc_owned_return {
      cl_own_return(ret_expr)
    } else {
      ret_expr
    }
    let nl = compile_expr(buf, owned_ret, local_names, next_local, ctx, ld)
    let needs_result_local = ctx.enable_rc && return_result_has_branch(ret_expr, local_names, ctx)
    if needs_result_local {
      emit_local_tee(buf, nl)
      while Array::length(local_names) <= nl {
        Array::push(local_names, "")
      }
    } else {
      ()
    }
    // #3141: the value is on the stack; release every scope the `return`
    // leaves before it transfers.
    rc_exit_release(buf, ctx, local_names, 0, ret_expr, if needs_result_local {
      nl
    } else {
      0 - 1
    })
    // #1696: the exported entry's result is untagged, but that untag is emitted
    // AFTER the body -- and `return` branches out of the function, past it. So
    // the same untag has to happen here, or `return 777` hands the host 1554.
    // Keep this shift identical to the tail-position one in linked_compile.vibe.
    if ctx.rc_entry_untag_return {
      emit_i64_const(buf, 1)
      emit_i64_shr_s(buf)
    } else {
      ()
    }
    emit_return(buf)
    if needs_result_local {
      nl + 1
    } else {
      nl
    }
  } else {
    compile_expr_tail4(buf, expr, local_names, next_local, ctx, ld, compile_expr)
  }
}
