//# Functions

/// A field projection `a.f` (EDot) read as a record-field value is a BORROW of
/// the source aggregate. The constructed record OWNS its fields (its drop class
/// recursively drops them), so the borrowed projection must be retained (#704)
/// — otherwise dropping the source frees the value while the new record still
/// points at it. Perceus tracks named bindings but emits no action for bare
/// projections, so this guarded dup is the only owner-increment and does not
/// double-count. Lambda literals (EFn) and other fresh values are already owned.
fn expr_is_projection(e: Expr) -> Bool {
  match e {
    EDot(_, _, _, _) => true,
    _ => false
  }
}

export fn compile_expr_tail4(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  match expr {
    EDot(obj, field, _, _) => {
      let fc = String::char_code_at(field, 0)
      if fc >= 48 && fc <= 57 {
        // `t.N` tuple projection: purely positional.
        let mut vi = 0
        let mut vp = 0
        while vp < String::length(field) {
          vi = vi * 10 + (String::char_code_at(field, vp) - 48)
          vp = vp + 1
        }
        let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)
        // RC mode: the tuple value is an odd pointer (Stage 2); untag before use.
        if ctx.enable_rc {
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
        }
        emit_i32_wrap_i64(buf)
        // RC mode: tuples carry an 8-byte header, so the payload starts at +8.
        let toff = if ctx.enable_rc {
          8 + vi * 8
        } else {
          vi * 8
        }
        emit_i64_load(buf, 3, toff)
        nl1
      } else {
        // #722: name-based struct field access. The slot index depends on
        // WHICH struct the value is — a same-named field can live at a
        // different slot in another struct. When every declaring struct
        // agrees on the slot, load it statically (the common case). When
        // they disagree, dispatch at runtime on the value's ctor tag
        // (value+0), falling back to the first-declared struct's slot for
        // legacy untagged records.
        let cands = struct_field_candidates(ctx.ctor_table, field)
        if Array::length(cands) == 0 {
          throw(String::concat("unknown struct field: ", field))
        }
        let (_, idx0) = Array::get(cands, 0)
        let dispatch = struct_field_dispatch_cases(cands)
        let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)
        emit_i64_const(buf, -2)
        emit_i64_and(buf)
        if Array::length(dispatch) == 0 {
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, 8 + idx0 * 8)
          nl1
        } else {
          let obj_l = nl1
          Array::push(local_names, "__dot_obj")
          emit_local_set(buf, obj_l)
          let mut di = 0
          while di < Array::length(dispatch) {
            let (dtag, didx) = Array::get(dispatch, di)
            emit_local_get(buf, obj_l)
            emit_i32_wrap_i64(buf)
            emit_i32_load(buf, 2, 0)
            emit_i32_const(buf, dtag)
            emit_i32_eq(buf)
            emit_if_i64(buf)
            emit_local_get(buf, obj_l)
            emit_i32_wrap_i64(buf)
            emit_i64_load(buf, 3, 8 + didx * 8)
            emit_else(buf)
            di = di + 1
          }
          emit_local_get(buf, obj_l)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, 8 + idx0 * 8)
          let mut de = 0
          while de < Array::length(dispatch) {
            emit_end(buf)
            de = de + 1
          }
          nl1 + 1
        }
      }
    },
    ERecord(rec_rn, fields, _) => {
      let flen = Array::length(fields)
      // #722: resolve the record to a struct by exact field-name set and, on a
      // match, lay it out in the struct's DECLARED field order with the
      // struct's ctor tag stamped at value+0 — byte-compatible with the
      // `S::{...}` ctor construction path (which already reorders). This is
      // what makes the tag-dispatching field access above type-correct for
      // bare-record construction (hand-built ASTs, name-dropped literals).
      // #1839: an EXPLICIT anonymous literal (rec_rn == "", the `record`
      // keyword) is exempt from that resolution — it always keeps literal
      // order + tag 0, matching the checker (no struct capture) and the
      // anon-record dot-access desugar (positional reads over literal
      // order). Reordering it to a same-field-set struct's declared order
      // made the parser's positional record destructure read swapped values.
      let lit_names = array_empty()
      let mut lni = 0
      while lni < flen {
        let (lfn, _) = Array::get(fields, lni)
        Array::push(lit_names, lfn)
        lni = lni + 1
      }
      let rec_si = if rec_rn == "" {
        -1
      } else {
        struct_index_by_field_set(ctx.ctor_table, lit_names)
      }
      let rec_tag = if rec_si >= 0 {
        struct_tag_by_index(ctx.ctor_table, rec_si)
      } else {
        0
      }
      let rec_fields = if rec_si >= 0 {
        let def_fnames = Array::get(ctx.ctor_table.struct_field_names, rec_si)
        let ordered = array_empty()
        let mut oi = 0
        while oi < Array::length(def_fnames) {
          let target_name = Array::get(def_fnames, oi)
          let mut ri2 = 0
          while ri2 < flen {
            let (rfn, rfv) = Array::get(fields, ri2)
            if rfn == target_name {
              Array::push(ordered, (rfn, rfv))
              ri2 = flen
            } else {
              ri2 = ri2 + 1
            }
          }
          oi = oi + 1
        }
        ordered
      } else {
        fields
      }
      let ptr_local = next_local
      Array::push(local_names, "__rec_ptr")
      if ctx.enable_rc {
        // RC layout (mirrors the tuple in compile_expr_tail2.vibe):
        //   block_start: [alloc_size@0][rc_count@4][type_id@8][length@12][payload@16...]
        // The record value is (block_start+8) | 1 (records stay tagged), so the
        // live header is [alloc_size@ptr-8][rc_count@ptr-4][type_id@ptr+0]
        // [length@ptr+4] and field access stays at +8 (untag cancels the +8
        // pointer shift). type_id 0 preserves the existing record read semantics.
        let total = 16 + flen * 8
        // ADR-0055 Stage 4: allocate via the free-list search helper (vibe_rc_alloc).
        emit_i64_const(buf, total)
        emit_call(buf, ctx.rc_alloc_func_idx)
        emit_local_set(buf, ptr_local)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, total)
        emit_i32_store(buf, 2, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 1)
        emit_i32_store(buf, 2, 4)
        // ADR-0055 Stage 2c/3: drop-class byte (block+7) = 1 (field-vector); a
        // record is [type_id@value+0][len@value+4][fields@value+8+i*8], the same
        // shape the recursive rc_drop loops.
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 1)
        emit_i32_store8(buf, 0, 7)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, rec_tag)
        emit_i32_store(buf, 2, 8)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, flen)
        emit_i32_store(buf, 2, 12)
        let mut nl_r = next_local + 1
        let mut ri = 0
        while ri < flen {
          let (_, fexpr) = Array::get(rec_fields, ri)
          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)
          let val_local = nl_r
          Array::push(local_names, "__rec_val")
          emit_local_set(buf, val_local)
          nl_r = nl_r + 1
          // #708 follow-up (Codex review): a record field sourced from a
          // borrow-returning call (Array::get/Map::get/__rec_field/a user
          // wrapper) is exactly as much a borrow as a bare projection `a.f`
          // (see the comment above) -- without this retain, dropping the
          // source container after storing its element into an owning
          // record double-frees the element once the record is later
          // dropped too.
          // #715: also retain a bare-ident field whose binding is borrow-bound
          // or loop-borrowed (cc_is_loop_borrowed_ident) -- same gap as the
          // ETuple case in compile_expr_tail2.vibe (see the comment there).
          if ctx.enable_rc && (expr_is_projection(fexpr) || cc_is_borrow_ret_call(fexpr, ctx) || cc_is_loop_borrowed_ident(fexpr, ctx)) {
            emit_rc_dup_guarded(buf, val_local, ctx.rc_shadow, ctx.rc_dup_func_idx)
          } else {
            ()
          }
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, val_local)
          emit_i64_store(buf, 3, 16 + ri * 8)
          ri = ri + 1
        }
        // record value = (block_start + 8) | 1
        emit_local_get(buf, ptr_local)
        emit_i64_const(buf, 8)
        emit_i64_add(buf)
        emit_i64_const(buf, 1)
        emit_i64_or(buf)
        nl_r
      } else {
        let obj_size = 8 + flen * 8
        emit_global_get(buf, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, ptr_local)
        emit_global_get(buf, 0)
        emit_i32_const(buf, obj_size)
        emit_i32_add(buf)
        emit_global_set(buf, 0)
        emit_heap_grow_after_heap_set(buf, ctx)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, rec_tag)
        emit_i32_store(buf, 2, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, flen)
        emit_i32_store(buf, 2, 4)
        let mut nl_r = next_local + 1
        let mut ri = 0
        while ri < flen {
          let (_, fexpr) = Array::get(rec_fields, ri)
          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)
          let val_local = nl_r
          Array::push(local_names, "__rec_val")
          emit_local_set(buf, val_local)
          nl_r = nl_r + 1
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, val_local)
          emit_i64_store(buf, 3, 8 + ri * 8)
          ri = ri + 1
        }
        emit_local_get(buf, ptr_local)
        emit_i64_const(buf, 1)
        emit_i64_or(buf)
        nl_r
      }
    },
    EMap(fields) => {
      let flen = Array::length(fields)
      let obj_size = 8 + flen * 2 * 8
      let ptr_local = next_local
      Array::push(local_names, "__map_ptr")
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, ptr_local)
      emit_global_get(buf, 0)
      emit_i32_const(buf, obj_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_grow_after_heap_set(buf, ctx)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, flen)
      emit_i32_store(buf, 2, 0)
      let mut nl_m = next_local + 1
      let mut mi = 0
      while mi < flen {
        let (key, val_expr) = Array::get(fields, mi)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        let key_idx = str_table_lookup(ctx.str_table.strs, key)
        if key_idx >= 0 {
          emit_str_ref(buf, Array::get(ctx.str_table.offsets, key_idx), Array::get(ctx.str_table.lengths, key_idx))
        } else {
          emit_i64_const(buf, 0)
        }
        emit_i64_store(buf, 3, 8 + mi * 16)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        nl_m = compile_expr(buf, val_expr, local_names, nl_m, ctx, ld)
        let val_local = nl_m
        Array::push(local_names, "__map_val")
        emit_local_set(buf, val_local)
        nl_m = nl_m + 1
        emit_local_get(buf, val_local)
        emit_i64_store(buf, 3, 8 + mi * 16 + 8)
        mi = mi + 1
      }
      emit_local_get(buf, ptr_local)
      nl_m
    },
    _ => compile_expr_tail5(buf, expr, local_names, next_local, ctx, ld, compile_expr)
  }
}
