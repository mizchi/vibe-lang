//# Functions

/// #3113: a read of a captured `let mut` is a borrowed view of its RC cell's
/// payload (the cell keeps owning it), so a literal that stores it retains it,
/// as it does a projection. File-local copy of compile_call.vibe's
/// `cc_is_ref_cell_read`.
fn cet4_is_ref_cell_read(e: Expr, ctx: CompileCtx) -> Bool {
  match e {
    EIdent(n, _) => array_contains_str(arr = ctx.ref_cell_names, s = n),
    _ => false
  }
}

/// A projection off a FRESH owned value -- `mk(i).y`, `pair(a, b).0`, the
/// result of a call no binding holds -- reads the field and then has nothing
/// left that owns the source. The plan never sees the temporary (Perceus
/// tracks named bindings only), so nothing released it and every evaluation
/// leaked the whole block, 32 B for a two-field struct. When the object is
/// such a temporary (`cc_is_owned_temp`, the classifier #2682 already trusts
/// to release a temporary handed to a borrowed position), keep its value in a
/// local so the field load can be followed by the release. Answers -1 and
/// leaves the stack alone otherwise.
fn cet4_hold_owned_temp(buf: Bytes, obj: Expr, local_names: Array[String], tmp_l: Int, ctx: CompileCtx) -> Int {
  if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && cc_is_owned_temp(e = obj, ctx = ctx) {
    Array::push(local_names, value = "__dot_tmp")
    emit_local_tee(buf = buf, idx = tmp_l)
    tmp_l
  } else {
    0 - 1
  }
}

/// The other half of `cet4_hold_owned_temp`, with the field on the stack. A
/// projection is a borrowed view everywhere downstream (an owning consumer
/// retains it, a borrowing one does not release it), so the field is retained
/// before the temporary is dropped: the drop releases the temporary's own
/// reference to it, and the retain is what keeps a heap field alive for the
/// consumer. A scalar field makes the retain a no-op. The cost of a heap field
/// is that its retained reference is never released, which is the reference
/// the leaked temporary used to hold, so the field leaks exactly as before and
/// the block around it no longer does. Answers the next free local.
fn cet4_release_owned_temp(buf: Bytes, local_names: Array[String], next_local: Int, tmp_l: Int, ctx: CompileCtx) -> Int {
  if tmp_l < 0 {
    next_local
  } else {
    let fld_l = next_local
    Array::push(local_names, value = "__dot_fld")
    emit_local_set(buf = buf, idx = fld_l)
    emit_rc_dup_guarded(buf = buf, local_idx = fld_l, rc_shadow = ctx.rc_shadow, dup_fn_idx = ctx.rc_dup_func_idx)
    emit_local_get(buf = buf, idx = tmp_l)
    emit_call(buf = buf, func_idx = ctx.rc_drop_func_idx)
    emit_local_get(buf = buf, idx = fld_l)
    next_local + 1
  }
}

export fn compile_expr_tail4(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  match expr {
    EDot(obj, field, _, _) => {
      let fc = String::char_code_at(field, at = 0)
      if fc >= 48 && fc <= 57 {
        // `t.N` tuple projection: purely positional.
        let mut vi = 0
        let mut vp = 0
        while vp < String::length(field) {
          vi = vi * 10 + (String::char_code_at(field, at = vp) - 48)
          vp = vp + 1
        }
        let nl0 = compile_expr(buf, obj, local_names, next_local, ctx, ld)
        let tmp_l = cet4_hold_owned_temp(buf = buf, obj = obj, local_names = local_names, tmp_l = nl0, ctx = ctx)
        let nl1 = if tmp_l >= 0 {
          nl0 + 1
        } else {
          nl0
        }
        // RC mode: the tuple value is an odd pointer (Stage 2); untag before use.
        if ctx.enable_rc {
          emit_i64_const(buf = buf, value = -2)
          emit_i64_and(buf)
        }
        emit_i32_wrap_i64(buf)
        // RC mode: tuples carry an 8-byte header, so the payload starts at +8.
        let toff = if ctx.enable_rc {
          8 + vi * 8
        } else {
          vi * 8
        }
        emit_i64_load(buf = buf, align = 3, offset = toff)
        cet4_release_owned_temp(buf = buf, local_names = local_names, next_local = nl1, tmp_l = tmp_l, ctx = ctx)
      } else {
        // #722: name-based struct field access. The slot index depends on
        // WHICH struct the value is — a same-named field can live at a
        // different slot in another struct. When every declaring struct
        // agrees on the slot, load it statically (the common case). When
        // they disagree, dispatch at runtime on the value's ctor tag
        // (value+0), falling back to the first-declared struct's slot for
        // legacy untagged records.
        let cands = struct_field_candidates(ct = ctx.ctor_table, field = field)
        if Array::length(cands) == 0 {
          throw(String::concat("unknown struct field: ", field))
        }
        let (_, idx0) = Array::get(cands, at = 0)
        let dispatch = struct_field_dispatch_cases(cands)
        let nl0 = compile_expr(buf, obj, local_names, next_local, ctx, ld)
        let tmp_l = cet4_hold_owned_temp(buf = buf, obj = obj, local_names = local_names, tmp_l = nl0, ctx = ctx)
        let nl1 = if tmp_l >= 0 {
          nl0 + 1
        } else {
          nl0
        }
        emit_i64_const(buf = buf, value = -2)
        emit_i64_and(buf)
        if Array::length(dispatch) == 0 {
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf = buf, align = 3, offset = 8 + idx0 * 8)
          cet4_release_owned_temp(buf = buf, local_names = local_names, next_local = nl1, tmp_l = tmp_l, ctx = ctx)
        } else {
          let obj_l = nl1
          Array::push(local_names, value = "__dot_obj")
          emit_local_set(buf = buf, idx = obj_l)
          let mut di = 0
          while di < Array::length(dispatch) {
            let (dtag, didx) = Array::get(dispatch, at = di)
            emit_local_get(buf = buf, idx = obj_l)
            emit_i32_wrap_i64(buf)
            emit_i32_load(buf = buf, align = 2, offset = 0)
            emit_ctor_tag(buf = buf, ctx = ctx, tag = dtag)
            emit_i32_eq(buf)
            emit_if_i64(buf)
            emit_local_get(buf = buf, idx = obj_l)
            emit_i32_wrap_i64(buf)
            emit_i64_load(buf = buf, align = 3, offset = 8 + didx * 8)
            emit_else(buf)
            di = di + 1
          }
          emit_local_get(buf = buf, idx = obj_l)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf = buf, align = 3, offset = 8 + idx0 * 8)
          let mut de = 0
          while de < Array::length(dispatch) {
            emit_end(buf)
            de = de + 1
          }
          cet4_release_owned_temp(buf = buf, local_names = local_names, next_local = nl1 + 1, tmp_l = tmp_l, ctx = ctx)
        }
      }
    },
    ERecord(rec_rn, fields, _) => {
      let flen = Array::length(fields)
      // #722: resolve the record to a struct by exact field-name set and, on a
      // match, lay it out in the struct's DECLARED field order with the
      // struct's ctor tag stamped at value+0 — byte-compatible with the
      // `S::{...}` ctor construction path (which already reorders). This is
      // what makes the tag-dispatching field access above type-correct for
      // bare-record construction (hand-built ASTs, name-dropped literals).
      // #1839: an EXPLICIT anonymous literal (rec_rn == "", the `record`
      // keyword) is exempt from that resolution — it always keeps literal
      // order + tag 0, matching the checker (no struct capture) and the
      // anon-record dot-access desugar (positional reads over literal
      // order). Reordering it to a same-field-set struct's declared order
      // made the parser's positional record destructure read swapped values.
      let lit_names = array_empty()
      let mut lni = 0
      while lni < flen {
        let (lfn, _) = Array::get(fields, at = lni)
        Array::push(lit_names, value = lfn)
        lni = lni + 1
      }
      let rec_si = if rec_rn == "" {
        -1
      } else {
        struct_index_by_field_set(ct = ctx.ctor_table, lit_names = lit_names)
      }
      let rec_tag = if rec_si >= 0 {
        struct_tag_by_index(ct = ctx.ctor_table, si = rec_si)
      } else {
        0
      }
      let rec_fields = if rec_si >= 0 {
        let def_fnames = struct_field_names_at(ct = ctx.ctor_table, si = rec_si)
        let ordered = array_empty()
        let mut oi = 0
        while oi < Array::length(def_fnames) {
          let target_name = Array::get(def_fnames, at = oi)
          let mut ri2 = 0
          while ri2 < flen {
            let (rfn, rfv) = Array::get(fields, at = ri2)
            if rfn == target_name {
              Array::push(ordered, value = (rfn, rfv))
              ri2 = flen
            } else {
              ri2 = ri2 + 1
            }
          }
          oi = oi + 1
        }
        ordered
      } else {
        fields
      }
      let ptr_local = next_local
      Array::push(local_names, value = "__rec_ptr")
      if ctx.enable_rc {
        // RC layout (mirrors the tuple in compile_expr_tail2.vibe):
        //   block_start: [alloc_size@0][rc_count@4][type_id@8][length@12][payload@16...]
        // The record value is (block_start+8) | 1 (records stay tagged), so the
        // live header is [alloc_size@ptr-8][rc_count@ptr-4][type_id@ptr+0]
        // [length@ptr+4] and field access stays at +8 (untag cancels the +8
        // pointer shift). type_id 0 preserves the existing record read semantics.
        let total = 16 + flen * 8
        // ADR-0055 Stage 4: allocate via the free-list search helper (vibe_rc_alloc).
        emit_i64_const(buf = buf, value = total)
        emit_call(buf = buf, func_idx = ctx.rc_alloc_func_idx)
        emit_local_set(buf = buf, idx = ptr_local)
        emit_local_get(buf = buf, idx = ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf = buf, value = total)
        emit_i32_store(buf = buf, align = 2, offset = 0)
        emit_local_get(buf = buf, idx = ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf = buf, value = 1)
        emit_i32_store(buf = buf, align = 2, offset = 4)
        // ADR-0055 Stage 2c/3: drop-class byte (block+7) = 1 (field-vector); a
        // record is [type_id@value+0][len@value+4][fields@value+8+i*8], the same
        // shape the recursive rc_drop loops.
        emit_local_get(buf = buf, idx = ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf = buf, value = 1)
        emit_i32_store8(buf = buf, align = 0, offset = 7)
        emit_local_get(buf = buf, idx = ptr_local)
        emit_i32_wrap_i64(buf)
        emit_ctor_tag(buf = buf, ctx = ctx, tag = rec_tag)
        emit_i32_store(buf = buf, align = 2, offset = 8)
        emit_local_get(buf = buf, idx = ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf = buf, value = flen)
        emit_i32_store(buf = buf, align = 2, offset = 12)
        let mut nl_r = next_local + 1
        let mut ri = 0
        while ri < flen {
          let (_, fexpr) = Array::get(rec_fields, at = ri)
          // #4141: the per-site retain below reads the item's TOP node, so a view
          // on a result path of a COMPOUND item -- `(if c { p.f } else { [] },
          // 1)`, `{ let k = 1; Array::get(xs, at = 0) }` -- was stored unretained
          // and the literal's drop released its source's value once too often.
          // Retain those tails the way a compound call argument's are
          // (`cc_retain_view_tails`); a bare item is left to the check below.
          nl_r = compile_expr(buf, cet4_retain_item_tails(e = fexpr, local_names = local_names, ctx = ctx), local_names, nl_r, ctx, ld)
          let val_local = nl_r
          Array::push(local_names, value = "__rec_val")
          emit_local_set(buf = buf, idx = val_local)
          nl_r = nl_r + 1
          // #704: a field projection `a.f` read as a record-field value is a
          // BORROW of the source aggregate. The record OWNS its fields (its
          // drop class recursively drops them), so the projection is
          // retained, or dropping the source frees the value while the record
          // still points at it. Perceus emits no action for a bare
          // projection, so this guarded dup is the only owner-increment. A
          // read off an owned temporary already carries its own reference
          // (cc_is_owned_projection) and moves in like any fresh value.
          // #708 follow-up (Codex review): a record field sourced from a
          // borrow-returning call (Array::get/Map::get/__rec_field/a user
          // wrapper) is exactly as much a borrow as a bare projection --
          // without this retain, dropping the source container after storing
          // its element into an owning record double-frees the element once
          // the record is later dropped too.
          // #715: also retain a bare-ident field whose binding is borrow-bound
          // or loop-borrowed (cc_is_loop_borrowed_ident) -- same gap as the
          // ETuple case in compile_expr_tail2.vibe (see the comment there).
          if ctx.enable_rc && (cc_is_borrowed_projection(e = fexpr, ctx = ctx) || cet4_is_ref_cell_read(e = fexpr, ctx = ctx) || cc_is_borrow_ret_call(e = fexpr, ctx = ctx) || cc_is_loop_borrowed_ident(e = fexpr, ctx = ctx)) {
            emit_rc_dup_guarded(buf = buf, local_idx = val_local, rc_shadow = ctx.rc_shadow, dup_fn_idx = ctx.rc_dup_func_idx)
          } else {
            ()
          }
          emit_local_get(buf = buf, idx = ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf = buf, idx = val_local)
          emit_i64_store(buf = buf, align = 3, offset = 16 + ri * 8)
          ri = ri + 1
        }
        // record value = (block_start + 8) | 1
        emit_local_get(buf = buf, idx = ptr_local)
        emit_i64_const(buf = buf, value = 8)
        emit_i64_add(buf)
        emit_i64_const(buf = buf, value = 1)
        emit_i64_or(buf)
        nl_r
      } else {
        let obj_size = 8 + flen * 8
        emit_global_get(buf = buf, idx = 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf = buf, idx = ptr_local)
        emit_global_get(buf = buf, idx = 0)
        emit_i32_const(buf = buf, value = obj_size)
        emit_i32_add(buf)
        emit_global_set(buf = buf, idx = 0)
        emit_heap_grow_after_heap_set(buf = buf, ctx = ctx)
        emit_local_get(buf = buf, idx = ptr_local)
        emit_i32_wrap_i64(buf)
        emit_ctor_tag(buf = buf, ctx = ctx, tag = rec_tag)
        emit_i32_store(buf = buf, align = 2, offset = 0)
        emit_local_get(buf = buf, idx = ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf = buf, value = flen)
        emit_i32_store(buf = buf, align = 2, offset = 4)
        let mut nl_r = next_local + 1
        let mut ri = 0
        while ri < flen {
          let (_, fexpr) = Array::get(rec_fields, at = ri)
          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)
          let val_local = nl_r
          Array::push(local_names, value = "__rec_val")
          emit_local_set(buf = buf, idx = val_local)
          nl_r = nl_r + 1
          emit_local_get(buf = buf, idx = ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf = buf, idx = val_local)
          emit_i64_store(buf = buf, align = 3, offset = 8 + ri * 8)
          ri = ri + 1
        }
        emit_local_get(buf = buf, idx = ptr_local)
        emit_i64_const(buf = buf, value = 1)
        emit_i64_or(buf)
        nl_r
      }
    },
    EMap(fields) => {
      // `Map::new()` and `Map::from_pairs(..)` both parse to this literal
      // (#960). Layout: [count@0 (i32)][index@4 (i32, 0 = none)]
      // [entries@8+16i: key, value] -- the same block Map::set and
      // MapBuilder::freeze produce. #2683: on the RC lane it is an RC block
      // of class 6 (rc_drop walks the entries and frees the index), handed
      // out TAGGED like every other rc block; it used to be a raw bump
      // allocation, even and invisible to the RC machinery, so no map was
      // ever reclaimed. The bump lane keeps the raw allocation.
      let flen = Array::length(fields)
      let obj_size = 8 + flen * 2 * 8
      let ptr_local = next_local
      Array::push(local_names, value = "__map_ptr")
      if ctx.enable_rc {
        cc_map_alloc_rc(buf = buf, ptr_l = ptr_local, class = 6, push_payload = () -> {
          emit_i64_const(buf = buf, value = obj_size)
        }, ctx = ctx)
      } else {
        emit_global_get(buf = buf, idx = 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf = buf, idx = ptr_local)
        emit_global_get(buf = buf, idx = 0)
        emit_i32_const(buf = buf, value = obj_size)
        emit_i32_add(buf)
        emit_global_set(buf = buf, idx = 0)
        emit_heap_grow_after_heap_set(buf = buf, ctx = ctx)
      }
      emit_local_get(buf = buf, idx = ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf = buf, value = flen)
      emit_i32_store(buf = buf, align = 2, offset = 0)
      let mut nl_m = next_local + 1
      let mut mi = 0
      while mi < flen {
        let (key, val_expr) = Array::get(fields, at = mi)
        emit_local_get(buf = buf, idx = ptr_local)
        emit_i32_wrap_i64(buf)
        let key_idx = str_table_index_of(st = ctx.str_table, s = key)
        if key_idx >= 0 {
          emit_str_ref_slot(buf = buf, ctx = ctx, slot = key_idx)
        } else {
          emit_i64_const(buf = buf, value = 0)
        }
        emit_i64_store(buf = buf, align = 3, offset = 8 + mi * 16)
        emit_local_get(buf = buf, idx = ptr_local)
        emit_i32_wrap_i64(buf)
        // #4141: a compound value's view tails, as for the other literals.
        nl_m = compile_expr(buf, cet4_retain_item_tails(e = val_expr, local_names = local_names, ctx = ctx), local_names, nl_m, ctx, ld)
        let val_local = nl_m
        Array::push(local_names, value = "__map_val")
        emit_local_set(buf = buf, idx = val_local)
        nl_m = nl_m + 1
        // #2683: the literal OWNS its values, so a value that is a borrowed
        // view -- a projection, a borrow-returning call, a loop-borrowed
        // name -- is retained, exactly as the array / tuple / record
        // literals do (#704/#708/#706); an owned temporary moves in.
        let val_is_proj = cc_is_borrowed_projection(e = val_expr, ctx = ctx)
        if ctx.enable_rc && (val_is_proj || cet4_is_ref_cell_read(e = val_expr, ctx = ctx) || cc_is_borrow_ret_call(e = val_expr, ctx = ctx) || cc_is_loop_borrowed_ident(e = val_expr, ctx = ctx)) {
          emit_rc_dup_guarded(buf = buf, local_idx = val_local, rc_shadow = ctx.rc_shadow, dup_fn_idx = ctx.rc_dup_func_idx)
        } else {
          ()
        }
        emit_local_get(buf = buf, idx = val_local)
        emit_i64_store(buf = buf, align = 3, offset = 8 + mi * 16 + 8)
        mi = mi + 1
      }
      emit_local_get(buf = buf, idx = ptr_local)
      if ctx.enable_rc {
        emit_i64_const(buf = buf, value = 1)
        emit_i64_or(buf)
      } else {
        ()
      }
      nl_m
    },
    _ => compile_expr_tail5(buf = buf, expr = expr, local_names = local_names, next_local = next_local, ctx = ctx, ld = ld, compile_expr = compile_expr)
  }
}

/// #4141: a record or map literal item with the views on its result path
/// retained (`cc_retain_view_tails_unlogged`); the item itself on a lane
/// with no reference counts, and for a bare item, which the literal's
/// per-site check retains.
fn cet4_retain_item_tails(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Expr {
  if ctx.enable_rc && ctx.rc_dup_func_idx >= 0 {
    cc_retain_view_tails_unlogged(e = e, local_names = local_names, ctx = ctx)
  } else {
    e
  }
}
