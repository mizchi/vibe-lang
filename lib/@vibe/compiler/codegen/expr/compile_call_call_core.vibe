/// #2837: release `x[new_len .. len)` with the ordinary decrement
/// (`__rt_rc_drop`, never a raw free), BEFORE the truncate stores the new
/// length -- the destructor walks only the live prefix, so an element outside
/// it is released here or never. A scalar element is a no-op inside the drop
/// helper (it tests the tag), so an `Array[Int]` pays the walk and nothing
/// else. Leaves the stack as it found it; the ordinary truncate call follows.
fn cc_emit_truncate_release(buf: Bytes, args: Array[Expr], kind: Int, local_names: Array[String], next_local: Int, ctx: CompileCtx) -> Int with Exception {
  let x_slot = find_local_slot(local_names, get_eident_name(Array::get(args, 0)))
  let len_l = next_local
  let idx_l = next_local + 1
  while Array::length(local_names) < next_local + 2 {
    Array::push(local_names, "")
  }
  // len_l = old length (untagged)
  emit_local_get(buf, x_slot)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf, 2, 4)
  emit_i64_extend_i32_u(buf)
  emit_local_set(buf, len_l)
  // idx_l = new length (untagged)
  let n = Array::get(args, 1)
  if kind == 1 {
    emit_i64_const(buf, get_eint_value(n))
  } else {
    emit_local_get(buf, find_local_slot(local_names, get_eident_name(n)))
    emit_i64_const(buf, 1)
    emit_i64_shr_s(buf)
  }
  emit_local_set(buf, idx_l)
  emit_block_void(buf)
  emit_loop_void(buf)
  emit_local_get(buf, idx_l)
  emit_local_get(buf, len_l)
  emit_i64_ge_s(buf)
  emit_br_if(buf, 1)
  emit_local_get(buf, idx_l)
  emit_i64_const(buf, 0)
  emit_i64_lt_s(buf)
  emit_br_if(buf, 1)
  // __rt_rc_drop(load_i64(data_ptr + idx * 8))
  emit_local_get(buf, x_slot)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf, 2, 8)
  emit_local_get(buf, idx_l)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 8)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_i64_load(buf, 3, 0)
  emit_call(buf, ctx.rc_drop_func_idx)
  emit_local_get(buf, idx_l)
  emit_i64_const(buf, 1)
  emit_i64_add(buf)
  emit_local_set(buf, idx_l)
  emit_br(buf, 0)
  emit_end(buf)
  emit_end(buf)
  next_local + 2
}

export fn compile_call(buf: Bytes, callee: Expr, args: Array[Expr], resolution: Array[Int], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  if is_efn(callee) {
    match ascription_call_value(callee, args) {
      Some(value) => {
        let nl = ce(buf, value, local_names, next_local, ctx, ld)
        // Match the owning result of the old identity closure call. Borrowed
        // arguments still need retaining, including the loop compensation.
        let loop_borrow = ctx.enable_rc && cc_is_loop_borrowed_ident(value, ctx)
        if ctx.enable_rc && (cc_is_projection(value) || cc_is_ref_cell_read(value, ctx) || cc_is_borrow_ret_call(value, ctx) || loop_borrow) {
          if loop_borrow {
            Array::push(ctx.loop_consumed_names, get_eident_name(value))
          } else ()
          Array::push(local_names, "__ascription_argdup")
          emit_local_tee(buf, nl)
          emit_rc_dup_guarded(buf, nl, ctx.rc_shadow, ctx.rc_dup_func_idx)
          return nl + 1
        } else {
          return nl
        }
      },
      None => ()
    }
  } else ()
  let operation = resolved_callee_operation(resolution)
  if is_eident(callee) && get_eident_name(callee) == "__region_run" && Array::length(args) == 1 {
    if ctx.region_ptr_addr >= 0 {
      emit_region_enter(buf, ctx.region_ptr_addr)
      if ctx.region_exn_tag >= 0 {
        emit_region_try_prologue(buf, ctx.region_exn_tag)
        let r = ce(buf, ECall(Array::get(args, 0), [EInt(0)], -1, []), local_names, next_local, ctx, region_try_body_ld(ld))
        emit_region_try_epilogue(buf, ctx.region_ptr_addr, ctx.region_exn_tag)
        r
      } else {
        let r = ce(buf, ECall(Array::get(args, 0), [EInt(0)], -1, []), local_names, next_local, ctx, ld)
        emit_region_exit(buf, ctx.region_ptr_addr)
        r
      }
    } else {
      ce(buf, ECall(Array::get(args, 0), [EInt(0)], -1, []), local_names, next_local, ctx, ld)
    }
  } else if operation == builtin_mutlist_empty && Array::length(args) == 1 {
    if ctx.region_arr_new_func_idx >= 0 {
      emit_call(buf, ctx.region_arr_new_func_idx)
      next_local
    } else {
      let no_args = Array::slice([EInt(0)], 0, 0)
      ce(buf, ECall(EIdent("ArrayBuilder::new", -1), no_args, -1, []), local_names, next_local, ctx, ld)
    }
  } else if (operation == builtin_mutlist_freeze || operation == builtin_mutlist_to_array) && Array::length(args) == 1 {
    ce(buf, mutlist_exit_copy(Array::get(args, 0)), local_names, next_local, ctx, ld)
  } else if operation == builtin_mutbytes_empty && Array::length(args) == 1 {
    if ctx.region_bytes_new_func_idx >= 0 {
      emit_call(buf, ctx.region_bytes_new_func_idx)
      next_local
    } else {
      let no_args = Array::slice([EInt(0)], 0, 0)
      ce(buf, ECall(EIdent("Bytes::new", -1), no_args, -1, []), local_names, next_local, ctx, ld)
    }
  } else if operation == builtin_mutbytes_to_bytes && Array::length(args) == 1 {
    ce(buf, mutbytes_exit_copy(Array::get(args, 0)), local_names, next_local, ctx, ld)
  } else if is_eident(callee) && frozen_array_conversion_copy(get_eident_name(callee)) != "" && Array::length(args) == 1 && func_table_index_of(ctx.func_table, get_eident_name(callee)) >= 0 && !array_contains_str(local_names, get_eident_name(callee)) {
    ce(buf, array_value_copy(Array::get(args, 0), frozen_array_conversion_copy(get_eident_name(callee))), local_names, next_local, ctx, ld)
  } else if is_eident(callee) && get_eident_name(callee) == "Map::iter_get" && Array::length(args) == 2 && func_table_index_of(ctx.func_table, "Map::iter_get") < 0 && !array_contains_str(local_names, "Map::iter_get") {
    compile_map_iter_get_checked(buf, Array::get(args, 0), Array::get(args, 1), local_names, next_local, ctx, ld, ce)
  } else if is_eident(callee) && get_eident_name(callee) == "Array::truncate" && !array_contains_str(local_names, "Array::truncate") && cc_truncate_release_kind(args, local_names, ctx) > 0 {
    // #2837: release the removed suffix first, then the ordinary truncate.
    let nl = cc_emit_truncate_release(buf, args, cc_truncate_release_kind(args, local_names, ctx), local_names, next_local, ctx)
    compile_call_core_resolved(buf, callee, args, resolution, local_names, nl, ctx, ld, ce)
  } else {
    compile_call_core_resolved(buf, callee, args, resolution, local_names, next_local, ctx, ld, ce)
  }
}

fn compile_call_core(buf: Bytes, callee: Expr, raw_args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  compile_call_core_resolved(buf, callee, raw_args, [], local_names, next_local, ctx, ld, ce)
}

fn compile_call_core_resolved(buf: Bytes, callee: Expr, raw_args: Array[Expr], resolution: Array[Int], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let args = cc_own_cell_compound_args(callee, raw_args, local_names, ctx)
  if is_eident(callee) {
    let source_name = get_eident_name(callee)
    // Builtin aliases are source-compatible fallbacks, not reserved names.
    // Preserve the same shadowing rule as the checker: resolve the original
    // spelling first, and canonicalize only when no function/local binds it.
    let source_is_bound = func_table_index_of(ctx.func_table, source_name) >= 0 || array_contains_str(local_names, source_name)
    let fname00 = if source_is_bound {
      source_name
    } else {
      canonical_builtin_name(source_name)
    }
    // #1508 second barrier: the five CLIENT-side `Http::*` builtins are
    // checker-legal as direct spellings (checker/builtin_sigs/builtins_net.vibe), but only
    // the raw dunder names lib/@vibe/http calls internally (#794) had codegen
    // wiring -- a bare file calling `Http::request(..)` died here with
    // "reached code generation unresolved". Lower the direct spellings onto
    // the very same host imports. Guarded on the name not resolving to
    // anything real: a unit bundling lib/@vibe/http binds these names to its
    // value aliases (`export let Http::request = request`, #795), and a bound
    // name must keep winning. Server-side ops (listen/accept/respond/...)
    // stay perform-based and are NOT aliased.
    let http_raw = http_client_surface_to_raw(fname00)
    let fname0 = if String::length(http_raw) > 0 && func_table_index_of(ctx.func_table, fname00) < 0 && !array_contains_str(local_names, fname00) {
      http_raw
    } else {
      fname00
    }
    // #1538: the eager `Stream::empty` / `once` / `map` / `filter` / `fold`
    // aliases used to live here, backed by the Array machinery. They are
    // retired -- ADR-0089 Decision 3 makes AsyncIter the one iteration story.
    // The nominal `ByteStream` conversion pair keeps its own branches below.
    //
    // Shared aliases name builtin operations after the checker resolved the
    // source reference. Constructors and both copying exits are lowered above.
    let resolved_alias = builtin_operation_alias(resolved_callee_operation(resolution))
    let fname = if resolved_alias != "" {
      resolved_alias
    } else {
      fname0
    }
    // Only a target the program also defines needs the builtin-only lookup;
    // otherwise the table holds one entry under that name and the ordinary
    // lookup already answers the builtin. The ownership lookups of the
    // resolved call then read the name the planner saw (`fname0`), not the
    // program's function of the target's spelling.
    let mut_alias_pos = if resolved_alias != "" && (func_table_user_index_of(ctx.func_table, fname, ctx.num_user_funcs) >= 0 || array_contains_str(local_names, fname)) {
      func_table_builtin_pos_of(ctx.func_table, fname, ctx.num_user_funcs)
    } else {
      -1
    }
    let fn_idx_in_list = if mut_alias_pos >= 0 {
      mut_alias_pos
    } else {
      func_table_index_of(ctx.func_table, fname)
    }
    let resolved_name = if mut_alias_pos >= 0 {
      fname0
    } else {
      fname
    }
    let mut local_idx_hint = -1
    let mut li = Array::length(local_names) - 1
    while li >= 0 {
      if Array::get(local_names, li) == fname {
        local_idx_hint = li
        li = -1
      } else {
        li = li - 1
      }
    }
    if mut_alias_pos >= 0 {
      local_idx_hint = -1
    }
    let prefer_bound_call = fn_idx_in_list >= 0 || local_idx_hint >= 0
    let ctor_lookup_idx = ctor_table_index_of(ctx.ctor_table, fname)
    cc_compile_named_1(buf, callee, args, local_names, next_local, ctx, ld, ce, fname, fn_idx_in_list, resolved_name, local_idx_hint, prefer_bound_call, ctor_lookup_idx, compile_call_core)
  } else {
    let num_args = Array::length(args)
    let fn_val_local = next_local
    let slot_local = next_local + 1
    let env_local = next_local + 2
    let mut nl = next_local + 3
    Array::push(local_names, "__fn_val")
    Array::push(local_names, "__slot")
    Array::push(local_names, "__env")
    nl = ce(buf, callee, local_names, nl, ctx, ld)
    emit_local_set(buf, fn_val_local)
    emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
    let mut ci = 0
    while ci < num_args {
      let carg = Array::get(args, ci)
      nl = ce(buf, carg, local_names, nl, ctx, ld)
      // #706: dup a loop-borrowed owning arg passed to a closure call.
      // #708: also retain a projection / borrow-returning-call arg (see the
      // matching comment on the other closure-call path above).
      let is_loop_borrow3 = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx)
      if ctx.enable_rc && (cc_is_projection(carg) || cc_is_ref_cell_read(carg, ctx) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow3) {
        // #706 leak follow-up: log so the epilogue compensates (see above).
        if is_loop_borrow3 {
          Array::push(ctx.loop_consumed_names, get_eident_name(carg))
        } else {
          ()
        }
        Array::push(local_names, "__argdup")
        emit_local_tee(buf, nl)
        emit_rc_dup_guarded(buf, nl, ctx.rc_shadow, ctx.rc_dup_func_idx)
        nl = nl + 1
      } else {
        ()
      }
      ci = ci + 1
    }
    emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)
    if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && is_efn(callee) {
      // An immediately invoked lambda creates an owning closure value. The
      // call consumes its arguments, but it does not consume the callee.
      let result_local = nl
      Array::push(local_names, "__immediate_call_result")
      emit_local_set(buf, result_local)
      emit_local_get(buf, fn_val_local)
      emit_call(buf, ctx.rc_drop_func_idx)
      emit_local_get(buf, result_local)
      nl + 1
    } else {
      nl
    }
  }
}
