/// #2837: release `x[new_len .. len)` with the ordinary decrement
/// (`__rt_rc_drop`, never a raw free), BEFORE the truncate stores the new
/// length -- the destructor walks only the live prefix, so an element outside
/// it is released here or never. A scalar element is a no-op inside the drop
/// helper (it tests the tag), so an `Array[Int]` pays the walk and nothing
/// else. Leaves the stack as it found it; the ordinary truncate call follows.
fn cc_emit_truncate_release(buf: Bytes, args: Array[Expr], kind: Int, local_names: Array[String], next_local: Int, ctx: CompileCtx) -> Int with Exception {
  let x_slot = find_local_slot(names = local_names, name = get_eident_name(Array::get(args, at = 0)))
  let len_l = next_local
  let idx_l = next_local + 1
  while Array::length(local_names) < next_local + 2 {
    Array::push(local_names, value = "")
  }
  // len_l = old length (untagged)
  emit_local_get(buf = buf, idx = x_slot)
  emit_i64_const(buf = buf, value = -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf = buf, align = 2, offset = 4)
  emit_i64_extend_i32_u(buf)
  emit_local_set(buf = buf, idx = len_l)
  // idx_l = new length (untagged)
  let n = Array::get(args, at = 1)
  if kind == 1 {
    emit_i64_const(buf = buf, value = get_eint_value(n))
  } else {
    emit_local_get(buf = buf, idx = find_local_slot(names = local_names, name = get_eident_name(n)))
    emit_i64_const(buf = buf, value = 1)
    emit_i64_shr_s(buf)
  }
  emit_local_set(buf = buf, idx = idx_l)
  emit_block_void(buf)
  emit_loop_void(buf)
  emit_local_get(buf = buf, idx = idx_l)
  emit_local_get(buf = buf, idx = len_l)
  emit_i64_ge_s(buf)
  emit_br_if(buf = buf, label = 1)
  emit_local_get(buf = buf, idx = idx_l)
  emit_i64_const(buf = buf, value = 0)
  emit_i64_lt_s(buf)
  emit_br_if(buf = buf, label = 1)
  // __rt_rc_drop(load_i64(data_ptr + idx * 8))
  emit_local_get(buf = buf, idx = x_slot)
  emit_i64_const(buf = buf, value = -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf = buf, align = 2, offset = 8)
  emit_local_get(buf = buf, idx = idx_l)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf = buf, value = 8)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_i64_load(buf = buf, align = 3, offset = 0)
  emit_call(buf = buf, func_idx = ctx.rc_drop_func_idx)
  emit_local_get(buf = buf, idx = idx_l)
  emit_i64_const(buf = buf, value = 1)
  emit_i64_add(buf)
  emit_local_set(buf = buf, idx = idx_l)
  emit_br(buf = buf, label = 0)
  emit_end(buf)
  emit_end(buf)
  next_local + 2
}

fn compile_call_inner(buf: Bytes, callee: Expr, args: Array[Expr], resolution: Array[Int], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let operation = resolved_callee_operation(resolution)
  if operation == builtin_frame_scope && Array::length(args) == 2 {
    let frame = next_local
    let payload = next_local + 1
    Array::push(local_names, value = ""); Array::push(local_names, value = ""); Array::push(local_names, value = "")
    let nl = ce(buf, Array::get(args, at = 0), local_names, next_local + 3, ctx, ld)
    emit_local_set(buf = buf, idx = frame)
    let control_tag = 4 + Array::length(ctx.effect_names)
    emit_frame_scope_prologue(buf = buf, control_tag = control_tag)
    let exit_mark = Array::length(ctx.rc_exit_stack_names)
    rc_exit_push(names = ctx.rc_exit_stack_names, info = ctx.rc_exit_stack_info, name = "", kind = 102, local = -1, flag = -1)
    let result = ce(buf, Array::get(args, at = 1), local_names, nl, ctx, if ld >= 0 {
      ld + 4
    } else {
      -1
    })
    rc_exit_truncate(ctx = ctx, mark = exit_mark)
    emit_frame_scope_epilogue(buf = buf, control_tag = control_tag, frame = frame, payload = payload, result = next_local + 2, rc = ctx.enable_rc, shadow = ctx.rc_shadow, dup_index = ctx.rc_dup_func_idx, drop_index = ctx.rc_drop_func_idx, cookie = frame_cookie(ctx.rc_exit_state))
    return result
  }
  if operation == builtin_frame_jump && Array::length(args) == 3 {
    let nl = ce(buf, ETuple([Array::get(args, at = 0), Array::get(args, at = 1)]), local_names, next_local, ctx, ld)
    let payload = nl
    let frame = nl + 1
    Array::push(local_names, value = ""); Array::push(local_names, value = "")
    emit_local_set(buf = buf, idx = payload)
    emit_frame_check_payload(buf = buf, payload = payload, frame = frame, rc = ctx.enable_rc)
    let end_local = ce(buf, ECall(EIdent("abort", -2), [Array::get(args, at = 2)], -1, [
    ]), local_names, nl + 2, ctx, ld)
    emit_drop(buf)
    emit_end(buf)
    rc_exit_release(buf = buf, ctx = ctx, local_names = local_names, kind = 4, operand = EUnit, result_local = -1)
    frame_cookie_set(buf = buf, state = ctx.rc_exit_state, value = 1)
    emit_local_get(buf = buf, idx = payload)
    bytebuf_push(buf = buf, byte = 8); leb128_encode_u32(buf = buf, value = 4 + Array::length(ctx.effect_names))
    return end_local
  }
  if is_eident(callee) && get_eident_name(callee) == "__region_run" && Array::length(args) == 1 {
    if ctx.region_ptr_addr >= 0 {
      emit_region_enter(buf = buf, region_ptr_addr = ctx.region_ptr_addr)
      if ctx.region_exn_tag >= 0 {
        emit_region_try_prologue(buf = buf, catch_tag = ctx.region_exn_tag)
        let r = ce(buf, ECall(Array::get(args, at = 0), [EInt(0)], -1, []), local_names, next_local, ctx, region_try_body_ld(ld))
        emit_region_try_epilogue(buf = buf, region_ptr_addr = ctx.region_ptr_addr, catch_tag = ctx.region_exn_tag)
        r
      } else {
        let r = ce(buf, ECall(Array::get(args, at = 0), [EInt(0)], -1, []), local_names, next_local, ctx, ld)
        emit_region_exit(buf = buf, region_ptr_addr = ctx.region_ptr_addr)
        r
      }
    } else {
      ce(buf, ECall(Array::get(args, at = 0), [EInt(0)], -1, []), local_names, next_local, ctx, ld)
    }
  } else if operation == builtin_mutlist_empty && Array::length(args) == 1 {
    if ctx.region_arr_new_func_idx >= 0 {
      emit_call(buf = buf, func_idx = ctx.region_arr_new_func_idx)
      next_local
    } else {
      let no_args = Array::slice([EInt(0)], start = 0, end = 0)
      ce(buf, ECall(EIdent("ArrayBuilder::new", -1), no_args, -1, []), local_names, next_local, ctx, ld)
    }
  } else if (operation == builtin_mutlist_freeze || operation == builtin_mutlist_to_array) && Array::length(args) == 1 {
    ce(buf, mutlist_exit_copy(Array::get(args, at = 0)), local_names, next_local, ctx, ld)
  } else if operation == builtin_mutbytes_empty && Array::length(args) == 1 {
    if ctx.region_bytes_new_func_idx >= 0 {
      emit_call(buf = buf, func_idx = ctx.region_bytes_new_func_idx)
      next_local
    } else {
      let no_args = Array::slice([EInt(0)], start = 0, end = 0)
      ce(buf, ECall(EIdent("Bytes::new", -1), no_args, -1, []), local_names, next_local, ctx, ld)
    }
  } else if operation == builtin_mutbytes_to_bytes && Array::length(args) == 1 {
    ce(buf, mutbytes_exit_copy(Array::get(args, at = 0)), local_names, next_local, ctx, ld)
  } else if is_eident(callee) && frozen_array_conversion_copy(get_eident_name(callee)) != "" && Array::length(args) == 1 && func_table_index_of(ft = ctx.func_table, name = get_eident_name(callee)) >= 0 && !array_contains_str(arr = local_names, s = get_eident_name(callee)) {
    ce(buf, array_value_copy(value = Array::get(args, at = 0), tmp = frozen_array_conversion_copy(get_eident_name(callee))), local_names, next_local, ctx, ld)
  } else if is_eident(callee) && get_eident_name(callee) == "Map::iter_get" && Array::length(args) == 2 && func_table_index_of(ft = ctx.func_table, name = "Map::iter_get") < 0 && !array_contains_str(arr = local_names, s = "Map::iter_get") {
    compile_map_iter_get_checked(buf = buf, map_expr = Array::get(args, at = 0), index_expr = Array::get(args, at = 1), local_names = local_names, next_local = next_local, ctx = ctx, ld = ld, ce = ce)
  } else if is_eident(callee) && get_eident_name(callee) == "Array::truncate" && !array_contains_str(arr = local_names, s = "Array::truncate") && cc_truncate_release_kind(args = args, local_names = local_names, ctx = ctx) > 0 {
    // #2837: release the removed suffix first, then the ordinary truncate.
    let nl = cc_emit_truncate_release(buf = buf, args = args, kind = cc_truncate_release_kind(args = args, local_names = local_names, ctx = ctx), local_names = local_names, next_local = next_local, ctx = ctx)
    compile_call_core_resolved(buf = buf, callee = callee, raw_args = args, resolution = resolution, local_names = local_names, next_local = nl, ctx = ctx, ld = ld, ce = ce)
  } else {
    compile_call_core_resolved(buf = buf, callee = callee, raw_args = args, resolution = resolution, local_names = local_names, next_local = next_local, ctx = ctx, ld = ld, ce = ce)
  }
}

fn compile_call_core(buf: Bytes, callee: Expr, raw_args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  compile_call_core_resolved(buf = buf, callee = callee, raw_args = raw_args, resolution = [], local_names = local_names, next_local = next_local, ctx = ctx, ld = ld, ce = ce)
}

fn compile_call_core_resolved(buf: Bytes, callee: Expr, raw_args: Array[Expr], resolution: Array[Int], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let args = cc_own_cell_compound_args(callee = callee, args = raw_args, local_names = local_names, ctx = ctx)
  // Retain captured-cell reads on compound result paths before inlining,
  // as on the ordinary closure-call path.
  if is_efn(callee) {
    match ascription_call_value(callee = callee, args = args) {
      Some(value) => {
        let nl = ce(buf, value, local_names, next_local, ctx, ld)
        // Match the owning result of the old identity closure call. Borrowed
        // arguments still need retaining, including the loop compensation.
        let loop_borrow = ctx.enable_rc && cc_is_loop_borrowed_ident(e = value, ctx = ctx)
        if ctx.enable_rc && (cc_is_borrowed_projection(e = value, ctx = ctx) || cc_is_ref_cell_read(e = value, ctx = ctx) || cc_is_borrow_ret_call(e = value, ctx = ctx) || loop_borrow) {
          if loop_borrow {
            Array::push(ctx.loop_consumed_names, value = get_eident_name(value))
          } else ()
          // Anonymous scratch slots must not hide a source binding.
          Array::push(local_names, value = "")
          emit_local_tee(buf = buf, idx = nl)
          emit_rc_dup_guarded(buf = buf, local_idx = nl, rc_shadow = ctx.rc_shadow, dup_fn_idx = ctx.rc_dup_func_idx)
          return nl + 1
        } else {
          return nl
        }
      },
      None => ()
    }
  } else ()
  if is_eident(callee) {
    let source_name = get_eident_name(callee)
    // Builtin aliases are source-compatible fallbacks, not reserved names.
    // Preserve the same shadowing rule as the checker: resolve the original
    // spelling first, and canonicalize only when no function/local binds it.
    let source_is_bound = func_table_index_of(ft = ctx.func_table, name = source_name) >= 0 || array_contains_str(arr = local_names, s = source_name)
    let fname00 = if source_is_bound {
      source_name
    } else {
      canonical_builtin_name(source_name)
    }
    // #1508 second barrier: the five CLIENT-side `Http::*` builtins are
    // checker-legal as direct spellings (checker/builtin_sigs/builtins_net.vibe), but only
    // the raw dunder names lib/@vibe/http calls internally (#794) had codegen
    // wiring -- a bare file calling `Http::request(..)` died here with
    // "reached code generation unresolved". Lower the direct spellings onto
    // the very same host imports. Guarded on the name not resolving to
    // anything real: a unit bundling lib/@vibe/http binds these names to its
    // value aliases (`export let Http::request = request`, #795), and a bound
    // name must keep winning. Server-side ops (listen/accept/respond/...)
    // stay perform-based and are NOT aliased.
    let http_raw = http_client_surface_to_raw(fname00)
    let fname0 = if String::length(http_raw) > 0 && func_table_index_of(ft = ctx.func_table, name = fname00) < 0 && !array_contains_str(arr = local_names, s = fname00) {
      http_raw
    } else {
      fname00
    }
    // #1538: the eager `Stream::empty` / `once` / `map` / `filter` / `fold`
    // aliases used to live here, backed by the Array machinery. They are
    // retired -- ADR-0089 Decision 3 makes AsyncIter the one iteration story.
    // The nominal `ByteStream` conversion pair keeps its own branches below.
    //
    // Shared aliases name builtin operations after the checker resolved the
    // source reference. Constructors and both copying exits are lowered above.
    let resolved_alias = builtin_operation_alias(resolved_callee_operation(resolution))
    let fname = if resolved_alias != "" {
      resolved_alias
    } else {
      fname0
    }
    // Only a target the program also defines needs the builtin-only lookup;
    // otherwise the table holds one entry under that name and the ordinary
    // lookup already answers the builtin. The ownership lookups of the
    // resolved call then read the name the planner saw (`fname0`), not the
    // program's function of the target's spelling.
    let mut_alias_pos = if resolved_alias != "" && (func_table_user_index_of(ft = ctx.func_table, name = fname, num_user_funcs = ctx.num_user_funcs) >= 0 || array_contains_str(arr = local_names, s = fname)) {
      func_table_builtin_pos_of(ft = ctx.func_table, name = fname, num_user_funcs = ctx.num_user_funcs)
    } else {
      -1
    }
    let fn_idx_in_list = if mut_alias_pos >= 0 {
      mut_alias_pos
    } else {
      func_table_index_of(ft = ctx.func_table, name = fname)
    }
    let resolved_name = if mut_alias_pos >= 0 {
      fname0
    } else {
      fname
    }
    let mut local_idx_hint = -1
    let mut li = Array::length(local_names) - 1
    while li >= 0 {
      if Array::get(local_names, at = li) == fname {
        local_idx_hint = li
        li = -1
      } else {
        li = li - 1
      }
    }
    if mut_alias_pos >= 0 {
      local_idx_hint = -1
    }
    let prefer_bound_call = fn_idx_in_list >= 0 || local_idx_hint >= 0
    let ctor_lookup_idx = ctor_table_index_of(ct = ctx.ctor_table, name = fname)
    cc_compile_named_1(buf = buf, callee = callee, args = args, local_names = local_names, next_local = next_local, ctx = ctx, ld = ld, ce = ce, fname = fname, fn_idx_in_list = fn_idx_in_list, resolved_name = resolved_name, local_idx_hint = local_idx_hint, prefer_bound_call = prefer_bound_call, ctor_lookup_idx = ctor_lookup_idx, compile_call_core_fn = compile_call_core)
  } else {
    let num_args = Array::length(args)
    let fn_val_local = next_local
    let slot_local = next_local + 1
    let env_local = next_local + 2
    let mut nl = next_local + 3
    Array::push(local_names, value = "__fn_val")
    Array::push(local_names, value = "__slot")
    Array::push(local_names, value = "__env")
    nl = ce(buf, callee, local_names, nl, ctx, ld)
    emit_local_set(buf = buf, idx = fn_val_local)
    emit_closure_resolve(buf = buf, fn_val_local = fn_val_local, slot_local = slot_local, env_local = env_local)
    let mut ci = 0
    while ci < num_args {
      let carg = Array::get(args, at = ci)
      nl = ce(buf, carg, local_names, nl, ctx, ld)
      // #706: dup a loop-borrowed owning arg passed to a closure call.
      // #708: also retain a projection / borrow-returning-call arg (see the
      // matching comment on the other closure-call path above).
      let is_loop_borrow3 = ctx.enable_rc && cc_is_loop_borrowed_ident(e = carg, ctx = ctx)
      if ctx.enable_rc && (cc_is_borrowed_projection(e = carg, ctx = ctx) || cc_is_ref_cell_read(e = carg, ctx = ctx) || cc_is_borrow_ret_call(e = carg, ctx = ctx) || is_loop_borrow3) {
        // #706 leak follow-up: log so the epilogue compensates (see above).
        if is_loop_borrow3 {
          Array::push(ctx.loop_consumed_names, value = get_eident_name(carg))
        } else {
          ()
        }
        Array::push(local_names, value = "__argdup")
        emit_local_tee(buf = buf, idx = nl)
        emit_rc_dup_guarded(buf = buf, local_idx = nl, rc_shadow = ctx.rc_shadow, dup_fn_idx = ctx.rc_dup_func_idx)
        nl = nl + 1
      } else {
        ()
      }
      ci = ci + 1
    }
    emit_closure_call_tail(buf = buf, env_local = env_local, slot_local = slot_local, closure_type_base = 9, num_args = num_args)
    if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && is_efn(callee) {
      // An immediately invoked lambda creates an owning closure value. The
      // call consumes its arguments, but it does not consume the callee.
      let result_local = nl
      Array::push(local_names, value = "__immediate_call_result")
      emit_local_set(buf = buf, idx = result_local)
      emit_local_get(buf = buf, idx = fn_val_local)
      emit_call(buf = buf, func_idx = ctx.rc_drop_func_idx)
      emit_local_get(buf = buf, idx = result_local)
      nl + 1
    } else {
      nl
    }
  }
}

export fn compile_call(buf: Bytes, callee: Expr, args: Array[Expr], resolution: Array[Int], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let site = return_call_site(resolution)
  if site < 0 || !ctx.enable_rc {
    compile_call_inner(buf = buf, callee = callee, args = args, resolution = resolution, local_names = local_names, next_local = next_local, ctx = ctx, ld = ld, ce = ce)
  } else {
    let payload = next_local
    Array::push(local_names, value = "")
    let control_tag = 4 + Array::length(ctx.effect_names)
    emit_block_i64(buf); emit_block_i64(buf)
    bytebuf_push(buf = buf, byte = 31); bytebuf_push(buf = buf, byte = 126); leb128_encode_u32(buf = buf, value = 1)
    bytebuf_push(buf = buf, byte = 0); leb128_encode_u32(buf = buf, value = control_tag); leb128_encode_u32(buf = buf, value = 0)
    let end_local = compile_call_inner(buf = buf, callee = callee, args = args, resolution = return_call_original(resolution), local_names = local_names, next_local = next_local + 1, ctx = ctx, ld = if ld >= 0 {
      ld + 3
    } else {
      -1
    }, ce = ce)
    emit_end(buf); emit_br(buf = buf, label = 1); emit_end(buf)
    emit_local_set(buf = buf, idx = payload)
    let cookie = frame_cookie(ctx.rc_exit_state)
    if cookie < 0 {
      throw("internal: return control call has no activation cookie")
    }
    emit_local_get(buf = buf, idx = cookie); emit_i64_eqz(buf); emit_if_void(buf)
    rc_exit_release(buf = buf, ctx = ctx, local_names = local_names, kind = 5, operand = EInt(site), result_local = -1)
    frame_cookie_set(buf = buf, state = ctx.rc_exit_state, value = 1)
    emit_end(buf)
    emit_local_get(buf = buf, idx = payload); bytebuf_push(buf = buf, byte = 8); leb128_encode_u32(buf = buf, value = control_tag)
    emit_end(buf)
    end_local
  }
}
