//# Functions

export fn compile_lambda(buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let param_names_arr = array_empty()
  let mut pi = 0
  while pi < Array::length(params) {
    let (pname, _) = Array::get(params, pi)
    Array::push(param_names_arr, pname)
    pi = pi + 1
  }
  // #875 fix 2: consume the "currently-compiling let-rec closure's own name"
  // hint (set by compile_expr_tail.vibe's ELetRec handler immediately before
  // it calls compile_expr on this exact EFn value -- see
  // CompileCtx.pending_letrec_self_name's doc comment). Read + clear it right
  // away (before computing captures, and well before any recursive call that
  // could set it again for a nested let-rec) so it never leaks past this one
  // lambda. Any EFn that is NOT a let-rec's own value (anonymous lambda,
  // non-rec `let`) finds this empty and behaves exactly as before.
  let self_name = if Array::length(ctx.pending_letrec_self_name) > 0 {
    let sn = Array::get(ctx.pending_letrec_self_name, 0)
    Array::truncate(ctx.pending_letrec_self_name, 0)
    sn
  } else {
    ""
  }
  // #1114: `local_names` is the ENCLOSING scope's locals. A bare
  // inlined-builtin call callee (`not`/`add`/`assert`/...) that one of
  // them shadows must be captured from here, not inline-lowered to the
  // builtin -- see collect_free_vars_expr's doc comment.
  let captures = collect_free_vars_indexed_self(fn_body, param_names_arr, ctx.capture_name_index, self_name, local_names)
  let num_captures = Array::length(captures)
  let user_params = Array::length(params)
  let lam_buf = bytebuf_new()
  let lam_locals = array_empty()
  let mut lpi = 0
  while lpi < user_params {
    let (lpname_raw, _) = Array::get(params, lpi)
    let lpnlen = String::length(lpname_raw)
    let lpname = if lpnlen > 0 {
      let lpc = String::char_code_at(lpname_raw, lpnlen - 1)
      if lpc == '~' {
        lpname_raw[0: lpnlen - 1]
      } else if lpc == '?' {
        lpname_raw[0: lpnlen - 1]
      } else {
        lpname_raw
      }
    } else lpname_raw
    Array::push(lam_locals, lpname)
    lpi = lpi + 1
  }
  Array::push(lam_locals, "__env")
  let env_param_idx = user_params
  let lam_nl_start = user_params + 1
  let lam_ref_cells = array_empty()
  let mut ci3 = 0
  let mut lam_nl = lam_nl_start
  let cl_md_bmasks = md_shadow_zeroed_bmasks(fn_body, ctx.borrow_param_user, ctx.borrow_param_mask)
  while ci3 < num_captures {
    let cap_local = lam_nl
    let cap_name = Array::get(captures, ci3)
    emit_local_get(lam_buf, env_param_idx)
    emit_i32_wrap_i64(lam_buf)
    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)
    // #699: a captured RC ref cell is stored odd-tagged in the env (so the
    // closure's class-7 drop classifies and frees it). The inner body uses the
    // cell as an even vptr (load/store at +0), so untag on load back.
    if ctx.enable_rc && array_contains_str(ctx.ref_cell_names, cap_name) {
      emit_i64_const(lam_buf, -2)
      emit_i64_and(lam_buf)
    }
    emit_local_set(lam_buf, cap_local)
    Array::push(lam_locals, cap_name)
    if array_contains_str(ctx.ref_cell_names, cap_name) {
      Array::push(lam_ref_cells, cap_name)
    } else {
      ()
    }
    // #705: a captured non-refcell heap var is a BORROWED view of the defining
    // scope's binding — the env store (below) does NOT bump its rc, and the
    // body's perceus plan never tracks a free var, so any owning consume inside
    // the closure decrements a refcount the closure does not own. Left unbalanced
    // that frees the defining scope's value early (double free / heap cycle when
    // a recursive closure consumes a captured list each iteration — e.g. a set
    // op's `contains(b, head)` over a borrowed `b`). Dup the capture once per
    // owning consume here in the prologue: it runs per invocation, so a recursive
    // closure consuming the capture each call stays balanced (defining scope
    // still drops it exactly once). Ref-cell captures (#699) own their cell via
    // the env store and are reclaimed by the closure's class-7 drop; skip them.
    if ctx.enable_rc && !array_contains_str(ctx.ref_cell_names, cap_name) {
      let cap_consumes = md_consume_count_pre(fn_body, cap_name, ctx.borrow_param_user, cl_md_bmasks)
      let mut cdup = 0
      while cdup < cap_consumes {
        emit_rc_dup_guarded(lam_buf, cap_local, ctx.rc_shadow, ctx.rc_dup_func_idx)
        cdup = cdup + 1
      }
    } else {
      ()
    }
    lam_nl = lam_nl + 1
    ci3 = ci3 + 1
  }
  let norm_params = Array::slice(params, 0, 0)
  let mut npi = 0
  while npi < Array::length(params) {
    let (rawn, pty) = Array::get(params, npi)
    let rnlen = String::length(rawn)
    let sn = if rnlen > 0 {
      let lc = String::char_code_at(rawn, rnlen - 1)
      if lc == '~' || lc == '?' {
        rawn[0: rnlen - 1]
      } else {
        rawn
      }
    } else {
      rawn
    }
    Array::push(norm_params, (sn, pty))
    npi = npi + 1
  }
  let lam_drops = array_empty()
  let lam_alias_dups = array_empty()
  let lam_dups = array_empty()
  let lam_heap_params = array_empty()
  if ctx.enable_rc {
    let lam_plan = build_perceus_plan_with_params(norm_params, fn_body, ctx.borrow_ret_names, ctx.borrow_param_user, ctx.borrow_param_mask, ctx.borrow_view_ret)
    let mut ldi = 0
    while ldi < Array::length(lam_plan) {
      let lpa = Array::get(lam_plan, ldi)
      if pa_is_drop(lpa) {
        Array::push(lam_drops, lpa.name)
      } else if pa_is_alias_dup(lpa) {
        Array::push(lam_alias_dups, lpa.name)
      } else if pa_is_dup(lpa) {
        Array::push(lam_dups, lpa.name)
      } else {
        ()
      }
      ldi = ldi + 1
    }
    let mut hpi = 0
    while hpi < Array::length(norm_params) {
      let (hpn, hpt) = Array::get(norm_params, hpi)
      if param_is_heap_in_body(hpn, hpt, fn_body) {
        Array::push(lam_heap_params, hpn)
      } else {
        ()
      }
      hpi = hpi + 1
    }
  }
  // #744: annotated Float/Double LAMBDA params seed float_local_slots exactly
  // like top-level fn params do (linked_compile's psi loop) — without this a
  // local `(v: Double, by: Double) -> Double { v * by }` compiled `v * by` as
  // an INTEGER multiply of the f64 bits (and under RC compared/box-leaked
  // pointers), so closure float math was silently garbage.
  let lam_float_slots = array_empty()
  // #1015: annotated Bool LAMBDA params seed int_local_slots (kind 3 =
  // boolish, #769 encoding slot*4+kind) exactly like top-level fn params do
  // (linked_compile's psi loop) — without this a Bool-typed lambda param
  // passed to `to_string(b)` (or interpolated as `"\{b}"`) is an untracked
  // bare EIdent and falls through to the generic runtime bit-pattern
  // heuristic, mis-rendering `true` as `"1"`.
  let lam_bool_slots = array_empty()
  let mut lfs_i = 0
  while lfs_i < user_params {
    let (_, lfs_ann) = Array::get(norm_params, lfs_i)
    match lfs_ann {
      Some(lfs_ty) => match lfs_ty {
        TyName(lfs_tn) => if lfs_tn == "Float" || lfs_tn == "Double" {
          Array::push(lam_float_slots, lfs_i * 2 + 1)
        } else if lfs_tn == "Bool" {
          Array::push(lam_bool_slots, lfs_i * 4 + 3)
        } else {
          ()
        },
        _ => ()
      },
      None => ()
    }
    lfs_i = lfs_i + 1
  }
  let lam_ctx = CompileCtx::{
    func_table: ctx.func_table, str_table: ctx.str_table,
    lambda_table: ctx.lambda_table,
    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,
    ref_cell_names: lam_ref_cells, ctor_table: ctx.ctor_table,
    ctor_float_fields: ctx.ctor_float_fields,
    thunk_names: ctx.thunk_names,
    const_int_names: ctx.const_int_names,
    const_int_values: ctx.const_int_values,
    enable_rc: ctx.enable_rc,
    rc_entry_untag_return: false,
    rc_shadow: ctx.rc_shadow,
    rc_drop_names: lam_drops,
    rc_alias_dup_names: lam_alias_dups,
    heap_binding_names: lam_heap_params,
    rc_drop_func_idx: ctx.rc_drop_func_idx,
    rc_dup_func_idx: ctx.rc_dup_func_idx,
    region_ptr_addr: ctx.region_ptr_addr,
    region_arr_new_func_idx: ctx.region_arr_new_func_idx,
    rc_alloc_func_idx: ctx.rc_alloc_func_idx,
    heap_grow_check_func_idx: ctx.heap_grow_check_func_idx,
    map_hash_func_idx: ctx.map_hash_func_idx,
    map_cap_func_idx: ctx.map_cap_func_idx,
    map_build_index_func_idx: ctx.map_build_index_func_idx,
    map_probe_func_idx: ctx.map_probe_func_idx,
    rc_dup_names: lam_dups,
    capture_name_index: ctx.capture_name_index,
    float_local_slots: lam_float_slots,
    int_local_slots: lam_bool_slots,
    agg_local_slots: array_empty(),
    agg_local_exprs: array_empty(),
    agg_ret_names: ctx.agg_ret_names,
    agg_ret_infos: ctx.agg_ret_infos,
    heap_ret_names: ctx.heap_ret_names,
    effect_names: ctx.effect_names,
    effect_op_keys: ctx.effect_op_keys,
    effect_op_arities: ctx.effect_op_arities,
    cov: ctx.cov,
    dbg_line_idx: ctx.dbg_line_idx,
    dbg_line_nl: ctx.dbg_line_nl,
    dbg_line_file_id: ctx.dbg_line_file_id,
    loop_borrowed_names: array_empty(),
    loop_consumed_names: array_empty(),
    reuse_scrutinee_names: array_empty(),
    reuse_flag_locals: array_empty(),
    borrow_ret_names: ctx.borrow_ret_names,
    borrow_param_user: ctx.borrow_param_user,
    borrow_param_mask: ctx.borrow_param_mask,
    borrow_view_ret: ctx.borrow_view_ret,
    scalar_ret_names: ctx.scalar_ret_names,
    // #875 fix 2: a nested `let rec` inside THIS lambda's own body must not
    // see a stale hint left over from compiling this lambda's own value (that
    // hint was already read+cleared on `ctx`, above, before we got here --
    // this is an independent, freshly-derived ctx for the body, so start it
    // empty too rather than aliasing ctx's now-cleared array).
    pending_letrec_self_name: array_empty(),
    table_slots_used: ctx.table_slots_used,
    // Shared BY REFERENCE, like table_slots_used above: a nested lambda
    // advances the same counter its enclosing function does.
    lambda_plan_next: ctx.lambda_plan_next,
    // #644: lambda bodies compile into their OWN wasm function + body_buf,
    // not the enclosing top-level function's -- a linemap entry recorded
    // here would carry the WRONG owning function index and an offset into
    // the wrong buffer. Force disabled rather than propagating ctx.linemap
    // (documented gap: lambda-body statements are absent from the static
    // linemap; their live `--break`/dbg_line hooks are unaffected).
    linemap: linemap_disabled()
  }
  if ctx.enable_rc {
    let mut dpi = 0
    while dpi < Array::length(norm_params) {
      let (dpn, dpt) = Array::get(norm_params, dpi)
      if param_is_heap_in_body(dpn, dpt, fn_body) {
        let mut dcount = 0
        let mut dqi = 0
        while dqi < Array::length(lam_dups) {
          if Array::get(lam_dups, dqi) == dpn {
            dcount = dcount + 1
          } else {
            ()
          }
          dqi = dqi + 1
        }
        let mut de = 0
        while de < dcount {
          emit_rc_dup_guarded(lam_buf, dpi, ctx.rc_shadow, ctx.rc_dup_func_idx)
          de = de + 1
        }
      } else {
        ()
      }
      dpi = dpi + 1
    }
  } else {
    ()
  }
  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, -1)
  let mut tail_lam_nl = final_lam_nl
  if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {
    let tail_root = scope_tail_proj_root(fn_body)
    let mut need_dup = false
    let mut ti = 0
    while ti < Array::length(norm_params) {
      let (tpn, tpt) = Array::get(norm_params, ti)
      if param_is_heap_in_body(tpn, tpt, fn_body) && array_contains_str(lam_drops, tpn) && tpn == tail_root {
        need_dup = true
      } else {
        ()
      }
      ti = ti + 1
    }
    let rtemp = final_lam_nl
    if need_dup {
      emit_local_set(lam_buf, rtemp)
      emit_rc_dup_guarded(lam_buf, rtemp, ctx.rc_shadow, ctx.rc_dup_func_idx)
      tail_lam_nl = final_lam_nl + 1
    } else {
      ()
    }
    let mut tj = 0
    while tj < Array::length(norm_params) {
      let (dpn2, dpt2) = Array::get(norm_params, tj)
      if param_is_heap_in_body(dpn2, dpt2, fn_body) && array_contains_str(lam_drops, dpn2) {
        emit_local_get(lam_buf, tj)
        emit_call(lam_buf, ctx.rc_drop_func_idx)
      } else {
        ()
      }
      tj = tj + 1
    }
    if need_dup {
      emit_local_get(lam_buf, rtemp)
    } else {
      ()
    }
  } else {
    ()
  }
  // #1259 step 7. The function index this lambda gets -- and, a few lines
  // down, the `table_slot` immediate baked into the emitted body.
  //
  // It USED to be `Array::length(ctx.lambda_table.bodies)`: the live length of
  // a shared, growing table. That made a function's output bytes depend on how
  // many lambdas every function compiled before it produced, which is the one
  // thing that stopped a worker from ever compiling a body on its own, and
  // exactly what docs/compiler-parallelism.md forbids ("may not append to a
  // shared LambdaTable, allocate global ids").
  //
  // It now comes from the PLAN: count_lambda_sites_expr counts the EFn nodes
  // in each user function's body and linked_compile prefix-sums those into a
  // per-function base, all without compiling anything. The live length is
  // still computed and still compared, as an invariant rather than as the
  // source of truth -- the two agreeing everywhere is what made this swap a
  // no-op on the emitted bytes, and a future divergence would mean the count
  // and the walk disagree about which EFn nodes get compiled. Keying a body's
  // constants to a table slot nothing installs is precisely the silent
  // corruption the plan exists to prevent, so it stays fatal.
  //
  // No plan (an empty cell) means this ctx was built outside the planned body
  // loop; the live length is then the only answer available and still the
  // right one, since nothing else is allocating into the table concurrently.
  let live_idx = Array::length(ctx.lambda_table.bodies)
  let lambda_idx = if Array::length(ctx.lambda_plan_next) > 0 {
    let planned = Array::get(ctx.lambda_plan_next, 0)
    if planned != live_idx {
      throw(String::concat("lambda plan mismatch: planned index ", String::concat(__to_string(planned), String::concat(", walk allocated ", __to_string(live_idx)))))
    } else {
      ()
    }
    Array::set(ctx.lambda_plan_next, 0, planned + 1)
    planned
  } else {
    live_idx
  }
  Array::push(ctx.lambda_table.bodies, lam_buf)
  Array::push(ctx.lambda_table.param_counts, user_params + 1)
  Array::push(ctx.lambda_table.captures, captures)
  let mut extra_lam = 0
  let min_lam_nl = user_params + 1
  if tail_lam_nl > min_lam_nl {
    extra_lam = tail_lam_nl - min_lam_nl
  }
  Array::push(ctx.lambda_table.meta_i32, 0)
  Array::push(ctx.lambda_table.meta_i64, extra_lam)
  let table_slot = ctx.num_user_funcs + lambda_idx
  Array::push(ctx.table_slots_used, table_slot)
  if num_captures == 0 {
    emit_i64_const(buf, (table_slot<<2)|2)
    next_local
  } else {
    let ptr_local = next_local
    let nl2 = next_local + 1
    Array::push(local_names, "__closure_ptr")
    let cap_off = if ctx.enable_rc {
      16
    } else {
      8
    }
    if ctx.enable_rc {
      let total = 16 + num_captures * 8
      emit_i64_const(buf, total)
      emit_call(buf, ctx.rc_alloc_func_idx)
      emit_local_set(buf, ptr_local)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, total)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 1)
      emit_i32_store(buf, 2, 4)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 7)
      emit_i32_store8(buf, 0, 7)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, table_slot)
      emit_i32_store(buf, 2, 8)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, num_captures)
      emit_i32_store(buf, 2, 12)
    } else {
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_tee(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 8 + num_captures * 8)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_grow_after_heap_set(buf, ctx)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, table_slot)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, num_captures)
      emit_i32_store(buf, 2, 4)
    }
    let mut csi = 0
    while csi < num_captures {
      let cap_name = Array::get(captures, csi)
      let mut __cap_resolve = -1
      let mut __cri = Array::length(local_names) - 1
      while __cri >= 0 {
        if Array::get(local_names, __cri) == cap_name {
          __cap_resolve = __cri
          __cri = -1
        } else {
          __cri = __cri - 1
        }
      }
      if __cap_resolve >= 0 {
        if ctx.enable_rc && array_contains_str(ctx.ref_cell_names, cap_name) {
          // #699: own the captured RC ref cell. Store it odd-tagged so the
          // closure's class-7 drop (gen_rc_drop_body) recognises it as an owned
          // heap value, and bump its refcount (unguarded — a ref cell is always
          // heap) so the shared cell survives until BOTH the defining scope and
          // this closure have dropped it.
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, __cap_resolve)
          emit_i64_const(buf, 1)
          emit_i64_or(buf)
          emit_i64_store(buf, 3, cap_off + csi * 8)
          emit_rc_word_inc_saturating(buf, () -> {
            emit_local_get(buf, __cap_resolve)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, 4)
            emit_i32_sub(buf)
          })
        } else {
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, __cap_resolve)
          emit_i64_store(buf, 3, cap_off + csi * 8)
          // owned-captures ABI (ADR-0076 追記31 Vertical A): the env OWNS
          // every heap capture — dup at creation, released by the closure's
          // class-7 recursive drop. Scalars and string/bytes fat pointers are
          // no-ops on BOTH sides (guarded dup mirrors gen_rc_drop_body's
          // entry checks), so the pair stays balanced across all shapes.
          // The let-rec SELF capture stays weak (no dup; the binder patches
          // the slot after creation and the drop loop skips self-pointing
          // slots) — dup'ing here would (a) leak one stale closure per loop
          // iteration when the letrec local is re-bound, and (b) make the
          // self-cycle unreclaimable.
          if ctx.enable_rc && cap_name != self_name {
            emit_rc_dup_guarded(buf, __cap_resolve, ctx.rc_shadow, ctx.rc_dup_func_idx)
          } else {
            ()
          }
        }
      } else {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i64_const(buf, 0)
        emit_i64_store(buf, 3, cap_off + csi * 8)
      }
      csi = csi + 1
    }
    if ctx.enable_rc {
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 8)
      emit_i64_add(buf)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
    } else {
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
    }
    nl2
  }
}
