//# Functions

/// #1899: a parameter's binding name, with the label marker removed.
///
/// `x~: Int` (labeled) and `x?: Int` (optional) reach codegen as the parameter
/// names `x~` and `x?`; the body binds and refers to `x`. Every consumer that
/// answers "what does this lambda bind" has to agree on that, or a name that IS
/// bound looks free.
///
/// Deliberately file-local, and copied verbatim into compile_expr_tail.vibe
/// rather than exported: a brand-new cross-file export and its first
/// cross-file caller in the same commit are silently dropped by the
/// merge/flatten tool (the gotcha `edp_strip_tilde` in
/// codegen/common_base/inline_direct_perform.vibe records).
fn strip_param_label_marker(n: String) -> String {
  let ln = String::length(n)
  if ln > 0 {
    let c = String::char_code_at(n, ln - 1)
    if c == '~' || c == '?' {
      n[0: ln - 1]
    } else {
      n
    }
  } else {
    n
  }
}

/// Normalize mixed fresh/view results to an owning return contract, including
/// direct-only functions: their results can be stored in an owning aggregate.
/// Named callbacks use the same contract as anonymous callbacks. Pure borrowed
/// accessors keep their existing ABI unless they are used as callbacks.
export fn cl_own_return_stmts(stmts: Array[Stmt]) -> Array[String] {
  let valued = array_empty()
  let _ = ca_walk_stmts_valued(stmts, valued)
  let valued_names = sorted_names_of(valued)
  let borrowed = sorted_names_of(compute_borrow_returning_names(stmts))
  let mixed = array_empty()
  for name in compute_may_return_view_fns(stmts) {
    if bsearch_leftmost(borrowed, name) < 0 {
      Array::push(mixed, name)
    }
  }
  let candidates = sorted_names_of(mixed)
  let owned = array_empty()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(ex, is_rec, n, ty, EFn(tps, bounds, ps, ret, eff, body)) => {
        if bsearch_leftmost(valued_names, n) >= 0 || bsearch_leftmost(candidates, n) >= 0 {
          Array::push(owned, n)
          Array::set(stmts, i, SLet(ex, is_rec, n, ty, EFn(tps, bounds, ps, ret, eff, cl_own_return(body))))
        }
      },
      _ => ()
    }
    i = i + 1
  }
  // The may-view analysis already follows helper calls to a fixed point.
  // Normalize every candidate before recomputing the callers' RC contracts;
  // retaining a mixed result after its branches merge would leak fresh paths.
  // #3113: captured `let mut` cells own what is stored into them. Rewritten
  // here, before the borrow / view analyses and the Perceus plans read the
  // bodies, for the same reason as the return normalization above.
  cl_own_cell_stmts(stmts)
  sorted_names_of(owned)
}

/// Compiler-internal return markers preserve the operand's representation.
export fn cl_return_operand(e: Expr) -> Expr {
  match e {
    ECall(EIdent(n, off), args, _) => if n == "__lambda_return_owned" && off < 0 && Array::length(args) == 1 {
      Array::get(args, 0)
    } else {
      e
    },
    _ => e
  }
}

/// Normalize lambda return paths to the owning indirect-call ABI. Bindings
/// feeding a return normalize their compound initializer too: an if producing
/// either a fresh object or a borrow cannot be retained uniformly after merging.
/// The Perceus plan sees this body, so the new owning bindings get their normal
/// dup/drop budget. Capture discovery still reads the source body.
export fn cl_own_return(e: Expr) -> Expr {
  cl_own_return_into(e, array_empty(), true)
}

fn cl_contains_return(e: Expr) -> Bool {
  match e {
    EReturn(_) => true,
    EFn(_, _, _, _, _, _) => false,
    _ => {
      let mark = expr_children_push(e)
      let end = expr_children_top()
      let mut i = mark
      let mut found = false
      while i < end && !found {
        found = cl_contains_return(expr_child_at(i))
        i = i + 1
      }
      expr_children_pop(mark)
      found
    }
  }
}

fn cl_own_return_list(items: Array[Expr], needed: Array[String]) -> Array[Expr] {
  let out = array_empty()
  for item in items {
    Array::push(out, cl_own_return_into(item, needed, false))
  }
  out
}

fn cl_own_return_fields(fields: Array[(String, Expr)], needed: Array[String]) -> Array[(String, Expr)] {
  let out = array_empty()
  for field in fields {
    Array::push(out, (field.0, cl_own_return_into(field.1, needed, false)))
  }
  out
}

fn cl_own_return_into(e: Expr, needed: Array[String], tail: Bool) -> Expr {
  // An early return is a result path even inside a non-tail initializer,
  // condition or argument. Leave the common return-free subtrees shared.
  if !tail && !cl_contains_return(e) {
    e
  } else {
    match e {
      EReturn(value) => EReturn(cl_own_return_into(value, needed, true)),
      EIdent(n, _) => {
        Array::push(needed, n)
        ECall(EIdent("__lambda_return_owned", -1), [e], -1)
      },
      EDot(obj, field, off, field_off) => {
        let value = EDot(cl_own_return_into(obj, needed, false), field, off, field_off)
        if tail {
          ECall(EIdent("__lambda_return_owned", -1), [value], -1)
        } else {
          value
        }
      },
      ECall(callee, args, off) => {
        let already_owned = match callee {
          EIdent("__lambda_return_owned", marker_off) => marker_off < 0,
          _ => false
        }
        if already_owned {
          e
        } else {
          let value = if cl_contains_return(e) {
            ECall(cl_own_return_into(callee, needed, false), cl_own_return_list(args, needed), off)
          } else {
            e
          }
          if tail {
            ECall(EIdent("__lambda_return_owned", -1), [value], -1)
          } else {
            value
          }
        }
      },
      EIf(c, t, f) => EIf(cl_own_return_into(c, needed, false), cl_own_return_into(t, needed, tail), cl_own_return_into(f, needed, tail)),
      EMatch(s, arms) => {
        let out = array_empty()
        for arm in arms {
          Array::push(out, (arm.0, cl_own_return_into(arm.1, needed, tail)))
        }
        EMatch(cl_own_return_into(s, needed, false), out)
      },
      EHandle(body, arms) => {
        let out = array_empty()
        for arm in arms {
          Array::push(out, (arm.0, cl_own_return_into(arm.1, needed, tail)))
        }
        EHandle(cl_own_return_into(body, needed, tail), out)
      },
      ELet(n, v, b, off) => {
        let body = cl_own_return_into(b, needed, tail)
        let value = if array_contains_str(needed, n) {
          cl_own_binding_value(v, needed)
        } else {
          cl_own_return_into(v, needed, false)
        }
        ELet(n, value, body, off)
      },
      ELetMut(n, v, b, off) => {
        let body = cl_own_return_into(b, needed, tail)
        ELetMut(n, cl_own_return_into(v, needed, false), body, off)
      },
      ELetRec(n, v, b) => ELetRec(n, cl_own_return_into(v, needed, false), cl_own_return_into(b, needed, tail)),
      ESeq(a, b) => {
        let body = cl_own_return_into(b, needed, tail)
        ESeq(cl_own_return_into(a, needed, false), body)
      },
      EAssign(n, v, b) => EAssign(n, cl_own_return_into(v, needed, false), cl_own_return_into(b, needed, tail)),
      EAssignOp(n, op, v, b) => EAssignOp(n, op, cl_own_return_into(v, needed, false), cl_own_return_into(b, needed, tail)),
      ETuple(items) => ETuple(cl_own_return_list(items, needed)),
      EArray(items) => EArray(cl_own_return_list(items, needed)),
      ERecord(n, fields, args) => ERecord(n, cl_own_return_fields(fields, needed), args),
      EMap(fields) => EMap(cl_own_return_fields(fields, needed)),
      EWhile(c, body) => EWhile(cl_own_return_into(c, needed, false), cl_own_return_into(body, needed, false)),
      ELoop(inits, body) => ELoop(cl_own_return_fields(inits, needed), cl_own_return_into(body, needed, false)),
      EForIn(n, label, iter, body) => EForIn(n, label, cl_own_return_into(iter, needed, false), cl_own_return_into(body, needed, false)),
      EBinOp(op, a, b, off) => EBinOp(op, cl_own_return_into(a, needed, false), cl_own_return_into(b, needed, false), off),
      EUnaryOp(op, value) => EUnaryOp(op, cl_own_return_into(value, needed, false)),
      ELabeledArg(n, label, value) => ELabeledArg(n, label, cl_own_return_into(value, needed, tail)),
      EBreak(Some(value)) => EBreak(Some(cl_own_return_into(value, needed, false))),
      EContinue(args) => EContinue(cl_own_return_list(args, needed)),
      ESpread(value) => ESpread(cl_own_return_into(value, needed, false)),
      _ => e
    }
  }
}

fn cl_own_binding_value(e: Expr, needed: Array[String]) -> Expr {
  match e {
    EIdent(n, _) => {
      Array::push(needed, n); e
    },
    EIf(_, _, _) => cl_own_return_into(e, needed, true),
    EMatch(_, _) => cl_own_return_into(e, needed, true),
    EHandle(_, _) => cl_own_return_into(e, needed, true),
    ELet(_, _, _, _) => cl_own_return_into(e, needed, true),
    ELetMut(_, _, _, _) => cl_own_return_into(e, needed, true),
    ELetRec(_, _, _) => cl_own_return_into(e, needed, true),
    ESeq(_, _) => cl_own_return_into(e, needed, true),
    EAssign(_, _, _) => cl_own_return_into(e, needed, true),
    EAssignOp(_, _, _, _) => cl_own_return_into(e, needed, true),
    _ => cl_own_return_into(e, needed, false)
  }
}

/// #3113: a `let mut` that a closure captures lives in an RC cell, and the
/// cell OWNS its payload -- dropping the cell releases it. So every value that
/// goes INTO the cell is a consuming use, and every read of the cell that
/// leaves it for an owning place is a borrow that has to be retained.
///
/// Neither held. The initializer was stored as compiled, so a borrowed one
/// (`Array::get(xs, i)`, a projection, a branch or block ending in either)
/// entered the cell with no reference of its own, and the cell's drop freed an
/// element its container still owned. An assignment did the same, and the
/// scope's own tail -- `{ let mut d = ..; ..; d }` -- handed the payload out
/// while the cell's drop released it.
///
/// This rewrites those three places to the same owning contract a lambda's
/// RETURN already uses (`cl_own_return_into`): every result path ends in the
/// `__lambda_return_owned` marker, and codegen retains exactly the paths whose
/// value is a borrow (a projection, a borrow-returning call, a ref-cell or
/// loop-borrowed name), with the lexical scope live. It runs BEFORE the
/// Perceus plan, so a binding feeding such a path is planned as an owner and
/// no leaf is retained twice -- which is what a codegen-only walk could not
/// get right (#3108: a pattern binder the match lowering had already retained
/// leaked, and a block ending in a borrow-bound name was missed).
///
/// Other bindings get the narrower treatment: an `ELet` / uncaptured `let mut`
/// initializer, or an assignment to an uncaptured name, has only a bare read
/// of a cell name at a result path marked. `let e = d` is otherwise planned as
/// a MOVE out of `d`, which the cell never gives up.
///
/// Aggregate literals (tuple / array / record / map) own their items, so a
/// cell read on any item's result path is marked here too. A call argument is
/// owning or borrowed depending on the callee's borrow mask, which is not known
/// yet, so a cell read handed to an owning parameter or a constructor field is
/// retained in codegen instead (`cc_is_ref_cell_read` for a bare read,
/// `cc_own_cell_compound_args` for one on a branch or block tail).
///
/// A `test` / `bench` / `example` block is rewritten here too: this runs
/// before those are lowered to `SLet`s, so a captured `let mut` written
/// directly in one was otherwise left unmarked (#3130 review).
fn cl_own_cell_stmts(stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(ex, is_rec, n, ty, value) => if cl_has_letmut(value) {
        Array::set(stmts, i, SLet(ex, is_rec, n, ty, cl_own_cells(value, array_empty())))
      } else {
        ()
      },
      STest(n, body) => if cl_has_letmut(body) {
        Array::set(stmts, i, STest(n, cl_own_cells(body, array_empty())))
      } else {
        ()
      },
      SBench(n, body) => if cl_has_letmut(body) {
        Array::set(stmts, i, SBench(n, cl_own_cells(body, array_empty())))
      } else {
        ()
      },
      SExample(n, body) => if cl_has_letmut(body) {
        Array::set(stmts, i, SExample(n, cl_own_cells(body, array_empty())))
      } else {
        ()
      },
      SExpr(body) => if cl_has_letmut(body) {
        Array::set(stmts, i, SExpr(cl_own_cells(body, array_empty())))
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
}

/// Cheap pre-check: most bodies declare no `let mut` at all, and those are
/// left as the same tree.
fn cl_has_letmut(e: Expr) -> Bool {
  match e {
    ELetMut(_, _, _, _) => true,
    _ => {
      let mark = expr_children_push(e)
      let end = expr_children_top()
      let mut i = mark
      let mut found = false
      while i < end && !found {
        found = cl_has_letmut(expr_child_at(i))
        i = i + 1
      }
      expr_children_pop(mark)
      found
    }
  }
}

/// `cells` without `n`: a binder of that spelling shadows the cell below it.
fn cl_cells_without(cells: Array[String], n: String) -> Array[String] {
  if array_contains_str(cells, n) {
    let out = array_empty()
    for c in cells {
      if c != n {
        Array::push(out, c)
      }
    }
    out
  } else {
    cells
  }
}

fn cl_cells_without_all(cells: Array[String], names: Array[String]) -> Array[String] {
  let mut out = cells
  for n in names {
    out = cl_cells_without(out, n)
  }
  out
}

/// Every name a pattern binds, including struct-field and or-pattern binders.
fn cl_pat_binds(p: Pat, out: Array[String]) -> Unit {
  match p {
    PBind(n) => Array::push(out, n),
    PCtor(_, args) => for a in args {
      cl_pat_binds(a, out)
    },
    PTuple(ps) => for a in ps {
      cl_pat_binds(a, out)
    },
    POr(a, b) => {
      cl_pat_binds(a, out)
      cl_pat_binds(b, out)
    },
    PStruct(_, fields) => for f in fields {
      cl_pat_binds(f.1, out)
    },
    _ => ()
  }
}

fn cl_arms_cells(arms: Array[(Pat, Expr)], cells: Array[String]) -> Array[(Pat, Expr)] {
  let out = array_empty()
  for arm in arms {
    let binds = array_empty()
    cl_pat_binds(arm.0, binds)
    Array::push(out, (arm.0, cl_own_cells(arm.1, cl_cells_without_all(cells, binds))))
  }
  out
}

fn cl_list_cells(items: Array[Expr], cells: Array[String]) -> Array[Expr] {
  let out = array_empty()
  for item in items {
    Array::push(out, cl_own_cells(item, cells))
  }
  out
}

fn cl_fields_cells(fields: Array[(String, Expr)], cells: Array[String]) -> Array[(String, Expr)] {
  let out = array_empty()
  for field in fields {
    Array::push(out, (field.0, cl_own_cells(field.1, cells)))
  }
  out
}

/// The items of a tuple / array literal: each OWNS what it holds, so a cell
/// read on any of an item's result paths is marked -- a bare `d`, and the
/// branch or block tail of `[if c { d } else { fresh() }]` alike (#3130
/// review: only the bare form was retained, so the array and the cell shared
/// one reference).
fn cl_agg_cells(items: Array[Expr], cells: Array[String]) -> Array[Expr] {
  let out = array_empty()
  for item in items {
    Array::push(out, cl_cell_tails(cl_own_cells(item, cells), cells, true))
  }
  out
}

/// `cl_agg_cells` for the fields of a record / struct / map literal.
fn cl_agg_fields_cells(fields: Array[(String, Expr)], cells: Array[String]) -> Array[(String, Expr)] {
  let out = array_empty()
  for field in fields {
    Array::push(out, (field.0, cl_cell_tails(cl_own_cells(field.1, cells), cells, true)))
  }
  out
}

/// #3113 / #3130 review: the ONE walk of an expression's RESULT SPINE -- the
/// sub-expressions whose value becomes the whole expression's value. Every
/// captured-cell marker goes through it (the store into a cell, a cell read in
/// an aggregate item or a binding value, a cell read in an owning call
/// argument), so a result-bearing form is either walked for all of them or
/// for none. Each review round of #3130 found one more form one of the
/// hand-written copies had skipped (`if` / `match` / block, then `handle`).
///
/// The `Expr` constructors (lib/@vibe/ast/index.vpkg), and which carry a
/// result tail:
///
///   EIf(_, t, f)            t and f
///   EMatch(_, arms)         every arm body; the arm's pattern binders shadow
///   EHandle(body, arms)     the body and every handler-arm body; an arm's
///                           pattern binders shadow
///   ELet / ELetMut / ELetRec(n, _, b)   b; `n` shadows
///   ESeq(_, b)              b
///   EAssign / EAssignOp(_, .., b)       b (the continuation)
///   ELabeledArg(_, _, v)    v (a transparent wrapper)
///   ELoop(params, body)     each `break v` in the body that targets this
///                           loop: v; the params shadow. The payload is
///                           searched through the same statement / tail
///                           positions this walk descends, not into operands.
///
///   No result tail -- the walk stops there and hands the node to `leaf`:
///   EInt EFloat EString EBool EUnit EStringInterp EIdent EDot ECall ETuple
///   EArray ERecord EMap EBinOp EUnaryOp ESpread; EFn (a value, not run);
///   EWhile (Unit); EForIn (a fresh array: its BODY is an owning place, which
///   `cl_own_cells` marks as an aggregate item, not a tail of the for-in);
///   EReturn / EBreak / EContinue (they leave the expression instead of
///   producing its value).
///
/// A new constructor falls into the `_` arm, i.e. is treated as a leaf; add it
/// to this list either way.
///
/// `leaf(node, shadow)` rewrites a leaf; `shadow` holds the names bound
/// between the root and that leaf. `bind(n, v)` rewrites a `let`'s value
/// after its body has been walked (the store walk uses it to normalize a
/// binding that feeds a result path); a walk with no use for it passes
/// `rs_keep_bind`.
export fn rs_map(e: Expr, shadow: Array[String], leaf: (Expr, Array[String]) -> Expr, bind: (String, Expr) -> Expr) -> Expr {
  match e {
    EIf(c, t, f) => EIf(c, rs_map(t, shadow, leaf, bind), rs_map(f, shadow, leaf, bind)),
    EMatch(sc, arms) => EMatch(sc, rs_map_arms(arms, shadow, leaf, bind)),
    EHandle(body, arms) => EHandle(rs_map(body, shadow, leaf, bind), rs_map_arms(arms, shadow, leaf, bind)),
    ELet(n, v, b, off) => {
      let b2 = rs_map(b, rs_with(shadow, n), leaf, bind)
      ELet(n, bind(n, v), b2, off)
    },
    ELetMut(n, v, b, off) => ELetMut(n, v, rs_map(b, rs_with(shadow, n), leaf, bind), off),
    ELetRec(n, v, b) => ELetRec(n, v, rs_map(b, rs_with(shadow, n), leaf, bind)),
    ESeq(a, b) => ESeq(a, rs_map(b, shadow, leaf, bind)),
    EAssign(n, v, b) => EAssign(n, v, rs_map(b, shadow, leaf, bind)),
    EAssignOp(n, op, v, b) => EAssignOp(n, op, v, rs_map(b, shadow, leaf, bind)),
    ELabeledArg(n, l, v) => ELabeledArg(n, l, rs_map(v, shadow, leaf, bind)),
    ELoop(params, body) => {
      let names = array_empty()
      for p in params {
        Array::push(names, p.0)
      }
      ELoop(params, rs_breaks(body, rs_with_all(shadow, names), leaf, bind))
    },
    _ => leaf(e, shadow)
  }
}

/// Does `e` have a result tail `rs_map` walks into (see its table)?
export fn rs_has_tail(e: Expr) -> Bool {
  match e {
    EIf(_, _, _) => true,
    EMatch(_, _) => true,
    EHandle(_, _) => true,
    ELet(_, _, _, _) => true,
    ELetMut(_, _, _, _) => true,
    ELetRec(_, _, _) => true,
    ESeq(_, _) => true,
    EAssign(_, _, _) => true,
    EAssignOp(_, _, _, _) => true,
    ELabeledArg(_, _, _) => true,
    ELoop(_, _) => true,
    _ => false
  }
}

/// The value-less walk callback: leave every `let` value as it is.
export fn rs_keep_bind(n: String, v: Expr) -> Expr {
  let _ = n
  v
}

fn rs_map_arms(arms: Array[(Pat, Expr)], shadow: Array[String], leaf: (Expr, Array[String]) -> Expr, bind: (String, Expr) -> Expr) -> Array[(Pat, Expr)] {
  let out = array_empty()
  for arm in arms {
    let binds = array_empty()
    cl_pat_binds(arm.0, binds)
    Array::push(out, (arm.0, rs_map(arm.1, rs_with_all(shadow, binds), leaf, bind)))
  }
  out
}

/// `break v` payloads of the enclosing `loop`, reached through the positions
/// a statement or a tail can occupy. A nested loop / while / for-in / lambda
/// owns its own breaks and is not entered.
fn rs_breaks(e: Expr, shadow: Array[String], leaf: (Expr, Array[String]) -> Expr, bind: (String, Expr) -> Expr) -> Expr {
  match e {
    EBreak(Some(v)) => EBreak(Some(rs_map(v, shadow, leaf, bind))),
    EIf(c, t, f) => EIf(c, rs_breaks(t, shadow, leaf, bind), rs_breaks(f, shadow, leaf, bind)),
    EMatch(sc, arms) => {
      let out = array_empty()
      for arm in arms {
        let binds = array_empty()
        cl_pat_binds(arm.0, binds)
        Array::push(out, (arm.0, rs_breaks(arm.1, rs_with_all(shadow, binds), leaf, bind)))
      }
      EMatch(sc, out)
    },
    EHandle(body, arms) => {
      let out = array_empty()
      for arm in arms {
        let binds = array_empty()
        cl_pat_binds(arm.0, binds)
        Array::push(out, (arm.0, rs_breaks(arm.1, rs_with_all(shadow, binds), leaf, bind)))
      }
      EHandle(rs_breaks(body, shadow, leaf, bind), out)
    },
    ELet(n, v, b, off) => ELet(n, rs_breaks(v, shadow, leaf, bind), rs_breaks(b, rs_with(shadow, n), leaf, bind), off),
    ELetMut(n, v, b, off) => ELetMut(n, rs_breaks(v, shadow, leaf, bind), rs_breaks(b, rs_with(shadow, n), leaf, bind), off),
    ELetRec(n, v, b) => ELetRec(n, v, rs_breaks(b, rs_with(shadow, n), leaf, bind)),
    ESeq(a, b) => ESeq(rs_breaks(a, shadow, leaf, bind), rs_breaks(b, shadow, leaf, bind)),
    EAssign(n, v, b) => EAssign(n, rs_breaks(v, shadow, leaf, bind), rs_breaks(b, shadow, leaf, bind)),
    EAssignOp(n, op, v, b) => EAssignOp(n, op, rs_breaks(v, shadow, leaf, bind), rs_breaks(b, shadow, leaf, bind)),
    _ => e
  }
}

fn rs_with(shadow: Array[String], n: String) -> Array[String] {
  let out = Array::slice(shadow, 0, Array::length(shadow))
  Array::push(out, n)
  out
}

fn rs_with_all(shadow: Array[String], names: Array[String]) -> Array[String] {
  let out = Array::slice(shadow, 0, Array::length(shadow))
  for n in names {
    Array::push(out, n)
  }
  out
}

/// Is `e` a read of a cell not shadowed on the way to it, directly or (with
/// `through_dot`) through a projection off one?
fn cl_is_cell_read(e: Expr, cells: Array[String], shadow: Array[String], through_dot: Bool) -> Bool {
  match e {
    EIdent(x, _) => array_contains_str(cells, x) && !array_contains_str(shadow, x),
    EDot(obj, _, _, _) => through_dot && cl_is_cell_read(obj, cells, shadow, true),
    _ => false
  }
}

/// Mark the result paths of `e` that read a cell (`rs_map`).
fn cl_cell_tails(e: Expr, cells: Array[String], through_dot: Bool) -> Expr {
  if Array::length(cells) == 0 {
    e
  } else {
    rs_map(e, array_empty(), (x: Expr, shadow: Array[String]) -> Expr {
      if cl_is_cell_read(x, cells, shadow, through_dot) {
        ECall(EIdent("__lambda_return_owned", -1), [x], -1)
      } else {
        x
      }
    }, rs_keep_bind)
  }
}

/// The value stored into a cell, normalized to the owning contract: every
/// result leaf that can hold a reference is marked, and codegen retains the
/// ones that are borrows. A `let` whose name reaches a result leaf has its own
/// value normalized the same way, so a block ending in a borrow-bound name is
/// owned by the time it reaches the cell.
fn cl_cell_store_value(v: Expr) -> Expr {
  let needed: Array[String] = []
  cl_store_walk(v, needed)
}

fn cl_store_walk(v: Expr, needed: Array[String]) -> Expr {
  rs_map(v, array_empty(), (x: Expr, shadow: Array[String]) -> Expr {
    let _ = shadow
    cl_store_leaf(x, needed)
  }, (n: String, bv: Expr) -> Expr {
    if array_contains_str(needed, n) {
      match bv {
        EIdent(src, _) => {
          Array::push(needed, src)
          bv
        },
        _ => if rs_has_tail(bv) {
          cl_store_walk(bv, needed)
        } else {
          bv
        }
      }
    } else {
      bv
    }
  })
}

fn cl_store_leaf(x: Expr, needed: Array[String]) -> Expr {
  match x {
    EIdent(n, _) => {
      Array::push(needed, n)
      ECall(EIdent("__lambda_return_owned", -1), [x], -1)
    },
    EDot(_, _, _, _) => ECall(EIdent("__lambda_return_owned", -1), [x], -1),
    ECall(EIdent("__lambda_return_owned", off), _, _) => if off < 0 {
      x
    } else {
      ECall(EIdent("__lambda_return_owned", -1), [x], -1)
    },
    ECall(_, _, _) => ECall(EIdent("__lambda_return_owned", -1), [x], -1),
    _ => x
  }
}

/// #3130 review: is `e` a `for` in the one position whose lowering does NOT
/// collect its body values -- the head of a sequence, compiled with
/// `compile_forin_loop(.., collect = false)`, which drops each body value off
/// the stack without releasing it? That lowering (compile_expr_tail.vibe's
/// ESeq arm) and the cell marker (`cl_own_cells`) both ask THIS, so the two
/// cannot disagree about which for-ins collect. Every other `for` collects
/// into a fresh array that owns (and eventually releases) its items.
export fn forin_is_discarded_seq_head(e: Expr) -> Bool {
  match e {
    EForIn(_, _, _, _) => true,
    _ => false
  }
}

/// A `for`: its iterand and body are walked as usual; when it COLLECTS, the
/// body's value is an owning place (an item of the result array), so a cell
/// read on its result path is marked. A discarded one's body value is dropped
/// unreleased, so marking it would retain a reference nothing releases -- one
/// per iteration.
fn cl_forin_cells(e: Expr, cells: Array[String], collects: Bool) -> Expr {
  match e {
    EForIn(n, label, iter, body) => {
      let inner = match label {
        Some(l) => cl_cells_without(cl_cells_without(cells, n), l),
        None => cl_cells_without(cells, n)
      }
      let body2 = cl_own_cells(body, inner)
      let body3 = if collects {
        cl_cell_tails(body2, inner, true)
      } else {
        body2
      }
      EForIn(n, label, cl_own_cells(iter, cells), body3)
    },
    _ => cl_own_cells(e, cells)
  }
}

fn cl_own_cells(e: Expr, cells: Array[String]) -> Expr {
  match e {
    ELetMut(n, v, b, off) => {
      let v2 = cl_own_cells(v, cells)
      if is_mut_captured_in(b, n) {
        // A fresh array: `cl_cells_without` hands `cells` itself back when
        // `n` is not in it, and the enclosing scope must not see `n`.
        let inner = array_empty()
        for c in cl_cells_without(cells, n) {
          Array::push(inner, c)
        }
        Array::push(inner, n)
        let b2 = cl_cell_tails(cl_own_cells(b, inner), [n], true)
        ELetMut(n, cl_cell_store_value(v2), b2, off)
      } else {
        ELetMut(n, cl_cell_tails(v2, cells, false), cl_own_cells(b, cl_cells_without(cells, n)), off)
      }
    },
    ELet(n, v, b, off) => {
      let v2 = cl_cell_tails(cl_own_cells(v, cells), cells, false)
      ELet(n, v2, cl_own_cells(b, cl_cells_without(cells, n)), off)
    },
    ELetRec(n, v, b) => {
      let inner = cl_cells_without(cells, n)
      ELetRec(n, cl_own_cells(v, inner), cl_own_cells(b, inner))
    },
    EAssign(n, v, b) => {
      let v2 = cl_own_cells(v, cells)
      let v3 = if array_contains_str(cells, n) {
        cl_cell_store_value(v2)
      } else {
        cl_cell_tails(v2, cells, false)
      }
      EAssign(n, v3, cl_own_cells(b, cells))
    },
    EAssignOp(n, op, v, b) => EAssignOp(n, op, cl_own_cells(v, cells), cl_own_cells(b, cells)),
    ESeq(a, b) => {
      // A discarded `for` collects nothing, so its body is no owning place.
      let a2 = if forin_is_discarded_seq_head(a) {
        cl_forin_cells(a, cells, false)
      } else {
        cl_own_cells(a, cells)
      }
      ESeq(a2, cl_own_cells(b, cells))
    },
    EIf(c, t, f) => EIf(cl_own_cells(c, cells), cl_own_cells(t, cells), cl_own_cells(f, cells)),
    EMatch(s, arms) => EMatch(cl_own_cells(s, cells), cl_arms_cells(arms, cells)),
    EHandle(body, arms) => EHandle(cl_own_cells(body, cells), cl_arms_cells(arms, cells)),
    EFn(tps, bounds, ps, ret, eff, body) => {
      let names = array_empty()
      for p in ps {
        Array::push(names, strip_param_label_marker(p.0))
      }
      EFn(tps, bounds, ps, ret, eff, cl_own_cells(body, cl_cells_without_all(cells, names)))
    },
    ECall(callee, args, off) => ECall(cl_own_cells(callee, cells), cl_list_cells(args, cells), off),
    ETuple(items) => ETuple(cl_agg_cells(items, cells)),
    EArray(items) => EArray(cl_agg_cells(items, cells)),
    ERecord(n, fields, args) => ERecord(n, cl_agg_fields_cells(fields, cells), args),
    EMap(fields) => EMap(cl_agg_fields_cells(fields, cells)),
    EWhile(c, body) => EWhile(cl_own_cells(c, cells), cl_own_cells(body, cells)),
    ELoop(inits, body) => {
      let names = array_empty()
      for init in inits {
        Array::push(names, init.0)
      }
      ELoop(cl_fields_cells(inits, cells), cl_own_cells(body, cl_cells_without_all(cells, names)))
    },
    EForIn(_, _, _, _) => cl_forin_cells(e, cells, true),
    EBinOp(op, a, b, off) => EBinOp(op, cl_own_cells(a, cells), cl_own_cells(b, cells), off),
    EUnaryOp(op, value) => EUnaryOp(op, cl_own_cells(value, cells)),
    EDot(obj, field, off, field_off) => EDot(cl_own_cells(obj, cells), field, off, field_off),
    ELabeledArg(n, label, value) => ELabeledArg(n, label, cl_own_cells(value, cells)),
    EReturn(value) => EReturn(cl_own_cells(value, cells)),
    EBreak(Some(value)) => EBreak(Some(cl_own_cells(value, cells))),
    EContinue(args) => EContinue(cl_list_cells(args, cells)),
    ESpread(value) => ESpread(cl_own_cells(value, cells)),
    _ => e
  }
}

export fn compile_lambda(buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  // #1899: the capture scan must be told the parameters under the SAME names
  // the body uses. A labeled parameter is parsed as `x~` and an optional one as
  // `x?` (parser_base.vibe's parse_one_param_with_binder_context), while the
  // body refers to plain `x` -- and `lam_locals` / `norm_params` below already
  // strip the marker for exactly that reason. Passing the raw name here instead
  // made every labeled parameter miss, so the body's `x` was recorded as a FREE
  // variable and captured from the enclosing scope, which is empty: the call
  // returned 0, with no diagnostic, because capturing is a legal operation and
  // nothing downstream can tell the capture was bogus.
  let param_names_arr = array_empty()
  let mut pi = 0
  while pi < Array::length(params) {
    let (pname, _) = Array::get(params, pi)
    Array::push(param_names_arr, strip_param_label_marker(pname))
    pi = pi + 1
  }
  // #875 fix 2: consume the "currently-compiling let-rec closure's own name"
  // hint (set by compile_expr_tail.vibe's ELetRec handler immediately before
  // it calls compile_expr on this exact EFn value -- see
  // CompileCtx.pending_letrec_self_name's doc comment). Read + clear it right
  // away (before computing captures, and well before any recursive call that
  // could set it again for a nested let-rec) so it never leaks past this one
  // lambda. Any EFn that is NOT a let-rec's own value (anonymous lambda,
  // non-rec `let`) finds this empty and behaves exactly as before.
  let self_name = if Array::length(ctx.pending_letrec_self_name) > 0 {
    let sn = Array::get(ctx.pending_letrec_self_name, 0)
    Array::truncate(ctx.pending_letrec_self_name, 0)
    sn
  } else {
    ""
  }
  // #1114: `local_names` is the ENCLOSING scope's locals. A bare
  // inlined-builtin call callee (`not`/`add`/`assert`/...) that one of
  // them shadows must be captured from here, not inline-lowered to the
  // builtin -- see collect_free_vars_expr's doc comment.
  let captures = collect_free_vars_indexed_self(fn_body, param_names_arr, ctx.capture_name_index, self_name, local_names)
  let num_captures = Array::length(captures)
  let user_params = Array::length(params)
  let lam_buf = bytebuf_new()
  let lam_locals = array_empty()
  let mut lpi = 0
  while lpi < user_params {
    let (lpname_raw, _) = Array::get(params, lpi)
    let lpnlen = String::length(lpname_raw)
    let lpname = if lpnlen > 0 {
      let lpc = String::char_code_at(lpname_raw, lpnlen - 1)
      if lpc == '~' {
        lpname_raw[0: lpnlen - 1]
      } else if lpc == '?' {
        lpname_raw[0: lpnlen - 1]
      } else {
        lpname_raw
      }
    } else lpname_raw
    Array::push(lam_locals, lpname)
    lpi = lpi + 1
  }
  Array::push(lam_locals, "__env")
  let env_param_idx = user_params
  let lam_nl_start = user_params + 1
  let lam_ref_cells = array_empty()
  let mut ci3 = 0
  let mut lam_nl = lam_nl_start
  let cl_md_bmasks = md_shadow_zeroed_bmasks(fn_body, ctx.borrow_param_user, ctx.borrow_param_mask)
  while ci3 < num_captures {
    let cap_local = lam_nl
    let cap_name = Array::get(captures, ci3)
    emit_local_get(lam_buf, env_param_idx)
    emit_i32_wrap_i64(lam_buf)
    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)
    // #699: a captured RC ref cell is stored odd-tagged in the env (so the
    // closure's class-7 drop classifies and frees it). The inner body uses the
    // cell as an even vptr (load/store at +0), so untag on load back.
    if ctx.enable_rc && array_contains_str(ctx.ref_cell_names, cap_name) {
      emit_i64_const(lam_buf, -2)
      emit_i64_and(lam_buf)
    }
    emit_local_set(lam_buf, cap_local)
    Array::push(lam_locals, cap_name)
    if array_contains_str(ctx.ref_cell_names, cap_name) {
      Array::push(lam_ref_cells, cap_name)
    } else {
      ()
    }
    // #705: a captured non-refcell heap var is a BORROWED view of the defining
    // scope's binding — the env store (below) does NOT bump its rc, and the
    // body's perceus plan never tracks a free var, so any owning consume inside
    // the closure decrements a refcount the closure does not own. Left unbalanced
    // that frees the defining scope's value early (double free / heap cycle when
    // a recursive closure consumes a captured list each iteration — e.g. a set
    // op's `contains(b, head)` over a borrowed `b`). Dup the capture once per
    // owning consume here in the prologue: it runs per invocation, so a recursive
    // closure consuming the capture each call stays balanced (defining scope
    // still drops it exactly once). Ref-cell captures (#699) own their cell via
    // the env store and are reclaimed by the closure's class-7 drop; skip them.
    if ctx.enable_rc && !array_contains_str(ctx.ref_cell_names, cap_name) {
      let cap_consumes = md_consume_count_pre(fn_body, cap_name, ctx.borrow_param_user, cl_md_bmasks)
      let mut cdup = 0
      while cdup < cap_consumes {
        emit_rc_dup_guarded(lam_buf, cap_local, ctx.rc_shadow, ctx.rc_dup_func_idx)
        cdup = cdup + 1
      }
    } else {
      ()
    }
    lam_nl = lam_nl + 1
    ci3 = ci3 + 1
  }
  let norm_params = Array::slice(params, 0, 0)
  let mut npi = 0
  while npi < Array::length(params) {
    let (rawn, pty) = Array::get(params, npi)
    let rnlen = String::length(rawn)
    let sn = if rnlen > 0 {
      let lc = String::char_code_at(rawn, rnlen - 1)
      if lc == '~' || lc == '?' {
        rawn[0: rnlen - 1]
      } else {
        rawn
      }
    } else {
      rawn
    }
    Array::push(norm_params, (sn, pty))
    npi = npi + 1
  }
  let result_body = if ctx.enable_rc {
    cl_own_return(fn_body)
  } else {
    fn_body
  }
  let lam_drops = array_empty()
  let lam_alias_dups = array_empty()
  let lam_dups = array_empty()
  let lam_heap_params = array_empty()
  let lam_reuse_names = array_empty()
  let lam_reuse_arities = array_empty()
  let lam_path_drops = array_empty()
  let lam_mark_names = array_empty()
  let lam_mark_offs = array_empty()
  let lam_trunc_release = array_empty()
  let lam_trunc_pin_arrays = array_empty()
  let lam_trunc_pin_names = array_empty()
  if ctx.enable_rc {
    let lam_plan = build_perceus_plan_pinned(ctx.perceus_pin, norm_params, result_body, ctx.borrow_ret_names, ctx.borrow_param_user, ctx.borrow_param_mask, ctx.borrow_view_ret)
    let mut ldi = 0
    while ldi < Array::length(lam_plan) {
      let lpa = Array::get(lam_plan, ldi)
      if pa_is_drop(lpa) {
        Array::push(lam_drops, lpa.name)
      } else if pa_is_alias_dup(lpa) {
        Array::push(lam_alias_dups, lpa.name)
      } else if pa_is_dup(lpa) {
        Array::push(lam_dups, lpa.name)
      } else if pa_is_reuse_token(lpa) {
        // ADR-0092 / #2389 plan-side reuse candidates (arity in `extra`).
        Array::push(lam_reuse_names, lpa.name)
        Array::push(lam_reuse_arities, lpa.extra)
      } else if pa_is_path_drop(lpa) {
        // #2389 per-path release, as in linked_compile's planned-bodies loop.
        Array::push(lam_path_drops, lpa.name)
      } else if pa_is_consume_mark(lpa) {
        Array::push(lam_mark_names, lpa.name)
        Array::push(lam_mark_offs, lpa.use_offset)
      } else {
        ()
      }
      ldi = ldi + 1
    }
    // #2837: a lambda's result convention is not an immediate this lowering
    // can vouch for, so a row that needs one is dropped.
    perceus_truncate_rows(lam_plan, false, lam_trunc_release, lam_trunc_pin_arrays, lam_trunc_pin_names)
    let mut hpi = 0
    while hpi < Array::length(norm_params) {
      let (hpn, hpt) = Array::get(norm_params, hpi)
      if param_is_heap_in_body(hpn, hpt, fn_body) {
        Array::push(lam_heap_params, hpn)
      } else {
        ()
      }
      hpi = hpi + 1
    }
  }
  // #744: annotated Float/Double LAMBDA params seed float_local_slots exactly
  // like top-level fn params do (linked_compile's psi loop) — without this a
  // local `(v: Double, by: Double) -> Double { v * by }` compiled `v * by` as
  // an INTEGER multiply of the f64 bits (and under RC compared/box-leaked
  // pointers), so closure float math was silently garbage.
  let lam_float_slots = array_empty()
  // #1015: annotated Bool LAMBDA params seed int_local_slots (kind 3 =
  // boolish, #769 encoding slot*4+kind) exactly like top-level fn params do
  // (linked_compile's psi loop) — without this a Bool-typed lambda param
  // passed to `to_string(b)` (or interpolated as `"\{b}"`) is an untracked
  // bare EIdent and falls through to the generic runtime bit-pattern
  // heuristic, mis-rendering `true` as `"1"`.
  let lam_bool_slots = array_empty()
  let mut lfs_i = 0
  while lfs_i < user_params {
    let (_, lfs_ann) = Array::get(norm_params, lfs_i)
    match lfs_ann {
      Some(lfs_ty) => match lfs_ty {
        TyName(lfs_tn) => if lfs_tn == "Float" || lfs_tn == "Double" {
          Array::push(lam_float_slots, lfs_i * 2 + 1)
        } else if lfs_tn == "Bool" {
          Array::push(lam_bool_slots, lfs_i * 4 + 3)
        } else if lfs_tn == "Int" {
          // #2422: the Int arm of the same seeding, added when the top-level
          // param loop got one. `(n: Int) -> String { __to_string(n) }` sent
          // `64 << 32` through the runtime string-pointer heuristic and
          // returned the empty string.
          Array::push(lam_bool_slots, lfs_i * 4 + 1)
        } else {
          ()
        },
        _ => ()
      },
      None => ()
    }
    lfs_i = lfs_i + 1
  }
  // #2669 slice 2: everything recorded from here on belongs to THIS lambda's
  // body (or to one nested inside it, which reassigns its own) until the
  // plan hands over an index below.
  let blind_lo = Array::length(ctx.blind_reloc_owners)
  let lam_ctx = CompileCtx::{
    func_table: ctx.func_table,
    str_table: ctx.str_table,
    lambda_table: ctx.lambda_table,
    num_user_funcs: ctx.num_user_funcs,
    lambda_slot_base: ctx.lambda_slot_base,
    func_offset: ctx.func_offset,
    ref_cell_names: lam_ref_cells,
    ctor_table: ctx.ctor_table,
    ctor_float_fields: ctx.ctor_float_fields,
    perceus_pin: ctx.perceus_pin,
    float_ret_fns: ctx.float_ret_fns,
    float_call_offsets: ctx.float_call_offsets,
    int_render_offsets: ctx.int_render_offsets,
    bool_render_offsets: ctx.bool_render_offsets,
    thunk_names: ctx.thunk_names,
    const_int_names: ctx.const_int_names,
    const_int_values: ctx.const_int_values,
    enable_rc: ctx.enable_rc,
    rc_entry_untag_return: false,
    rc_owned_return: true,
    rc_shadow: ctx.rc_shadow,
    rc_drop_names: lam_drops,
    rc_alias_dup_names: lam_alias_dups,
    heap_binding_names: lam_heap_params,
    rc_drop_func_idx: ctx.rc_drop_func_idx,
    rc_dup_func_idx: ctx.rc_dup_func_idx,
    region_ptr_addr: ctx.region_ptr_addr,
    region_arr_new_func_idx: ctx.region_arr_new_func_idx,
    region_bytes_new_func_idx: ctx.region_bytes_new_func_idx,
    region_exn_tag: ctx.region_exn_tag,
    rc_alloc_func_idx: ctx.rc_alloc_func_idx,
    heap_grow_check_func_idx: ctx.heap_grow_check_func_idx,
    map_hash_func_idx: ctx.map_hash_func_idx,
    map_cap_func_idx: ctx.map_cap_func_idx,
    map_build_index_func_idx: ctx.map_build_index_func_idx,
    map_probe_func_idx: ctx.map_probe_func_idx,
    map_index_insert_func_idx: ctx.map_index_insert_func_idx,
    rc_dup_names: lam_dups,
    capture_name_index: ctx.capture_name_index,
    float_local_slots: lam_float_slots,
    int_local_slots: lam_bool_slots,
    agg_local_slots: array_empty(),
    agg_local_exprs: array_empty(),
    agg_ret_names: ctx.agg_ret_names,
    agg_ret_infos: ctx.agg_ret_infos,
    agg_ret_names_sorted: ctx.agg_ret_names_sorted,
    agg_ret_names_sorted_pos: ctx.agg_ret_names_sorted_pos,
    heap_ret_names: ctx.heap_ret_names,
    effect_names: ctx.effect_names,
    effect_op_keys: ctx.effect_op_keys,
    effect_op_arities: ctx.effect_op_arities,
    cov: ctx.cov,
    dbg_line_idx: ctx.dbg_line_idx,
    dbg_line_nl: ctx.dbg_line_nl,
    dbg_line_file_id: ctx.dbg_line_file_id,
    loop_borrowed_names: array_empty(),
    loop_consumed_names: array_empty(),
    rc_path_drop_names: lam_path_drops,
    rc_consume_mark_names: lam_mark_names,
    rc_consume_mark_offs: lam_mark_offs,
    rc_path_flag_names: array_empty(),
    rc_path_flag_locals: array_empty(),
    rc_trunc_release: lam_trunc_release,
    rc_trunc_pin_arrays: lam_trunc_pin_arrays,
    rc_trunc_pin_names: lam_trunc_pin_names,
    rc_pins_live: array_empty(),
    rc_trunc_builtin: ctx.rc_trunc_builtin,
    reuse_scrutinee_names: array_empty(),
    reuse_flag_locals: array_empty(),
    rc_reuse_token_names: lam_reuse_names,
    rc_reuse_token_arities: lam_reuse_arities,
    reuse_tok_locals: array_empty(),
    reuse_tok_arities: array_empty(),
    reuse_tok_emitted: array_empty(),
    borrow_ret_names: ctx.borrow_ret_names,
    borrow_param_user: ctx.borrow_param_user,
    borrow_param_mask: ctx.borrow_param_mask,
    borrow_view_ret: ctx.borrow_view_ret,
    scalar_ret_names: ctx.scalar_ret_names,
    // #875 fix 2: a nested `let rec` inside THIS lambda's own body must not
    // see a stale hint left over from compiling this lambda's own value (that
    // hint was already read+cleared on `ctx`, above, before we got here --
    // this is an independent, freshly-derived ctx for the body, so start it
    // empty too rather than aliasing ctx's now-cleared array).
    pending_letrec_self_name: array_empty(),
    table_slots_used: ctx.table_slots_used,
    // Shared BY REFERENCE, like table_slots_used above: a nested lambda
    // advances the same counter its enclosing function does.
    lambda_plan_next: ctx.lambda_plan_next,
    // #644: lambda bodies compile into their OWN wasm function + body_buf,
    // not the enclosing top-level function's -- a linemap entry recorded
    // here would carry the WRONG owning function index and an offset into
    // the wrong buffer. Force disabled rather than propagating ctx.linemap
    // (documented gap: lambda-body statements are absent from the static
    // linemap; their live `--break`/dbg_line hooks are unaffected).
    linemap: linemap_disabled(),
    // #2669 slice 2: the payload arrays are SHARED, like table_slots_used --
    // a lambda body's references belong in the module-level log. Only the
    // owner cell is this body's own, and it holds `pending` because the
    // lambda's index is not drawn from the plan until the body is finished
    // (see blind_reloc_assign_pending below).
    blind_reloc_owner_cell: [blind_owner_pending],
    blind_reloc_owners: ctx.blind_reloc_owners,
    blind_reloc_offsets: ctx.blind_reloc_offsets,
    blind_reloc_kinds: ctx.blind_reloc_kinds,
    blind_reloc_syms: ctx.blind_reloc_syms
  }
  if ctx.enable_rc {
    let mut dpi = 0
    while dpi < Array::length(norm_params) {
      let (dpn, dpt) = Array::get(norm_params, dpi)
      if param_is_heap_in_body(dpn, dpt, fn_body) {
        let mut dcount = 0
        let mut dqi = 0
        while dqi < Array::length(lam_dups) {
          if Array::get(lam_dups, dqi) == dpn {
            dcount = dcount + 1
          } else {
            ()
          }
          dqi = dqi + 1
        }
        let mut de = 0
        while de < dcount {
          emit_rc_dup_guarded(lam_buf, dpi, ctx.rc_shadow, ctx.rc_dup_func_idx)
          de = de + 1
        }
      } else {
        ()
      }
      dpi = dpi + 1
    }
  } else {
    ()
  }
  let final_lam_nl = compile_fn(lam_buf, result_body, lam_locals, lam_nl, lam_ctx, -1)
  if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {
    let mut tj = 0
    while tj < Array::length(norm_params) {
      let (dpn2, dpt2) = Array::get(norm_params, tj)
      if param_is_heap_in_body(dpn2, dpt2, fn_body) && array_contains_str(lam_drops, dpn2) {
        emit_local_get(lam_buf, tj)
        emit_call(lam_buf, ctx.rc_drop_func_idx)
      } else {
        ()
      }
      tj = tj + 1
    }
  }
  // #1259 step 7. The function index this lambda gets -- and, a few lines
  // down, the `table_slot` immediate baked into the emitted body.
  //
  // It USED to be `Array::length(ctx.lambda_table.bodies)`: the live length of
  // a shared, growing table. That made a function's output bytes depend on how
  // many lambdas every function compiled before it produced, which is the one
  // thing that stopped a worker from ever compiling a body on its own, and
  // exactly what docs/internal/design/compiler-parallelism.md forbids ("may not append to a
  // shared LambdaTable, allocate global ids").
  //
  // It now comes from the PLAN: count_lambda_sites_expr counts the EFn nodes
  // in each user function's body and linked_compile prefix-sums those into a
  // per-function base, all without compiling anything. The live length is
  // still computed and still compared, as an invariant rather than as the
  // source of truth -- the two agreeing everywhere is what made this swap a
  // no-op on the emitted bytes, and a future divergence would mean the count
  // and the walk disagree about which EFn nodes get compiled. Keying a body's
  // constants to a table slot nothing installs is precisely the silent
  // corruption the plan exists to prevent, so it stays fatal.
  //
  // No plan (an empty cell) means this ctx was built outside the planned body
  // loop; the live length is then the only answer available and still the
  // right one, since nothing else is allocating into the table concurrently.
  let live_idx = Array::length(ctx.lambda_table.bodies)
  let lambda_idx = if Array::length(ctx.lambda_plan_next) > 0 {
    let planned = Array::get(ctx.lambda_plan_next, 0)
    if planned != live_idx {
      throw(String::concat("lambda plan mismatch: planned index ", String::concat(__to_string(planned), String::concat(", walk allocated ", __to_string(live_idx)))))
    } else {
      ()
    }
    Array::set(ctx.lambda_plan_next, 0, planned + 1)
    planned
  } else {
    live_idx
  }
  Array::push(ctx.lambda_table.bodies, lam_buf)
  Array::push(ctx.lambda_table.param_counts, user_params + 1)
  Array::push(ctx.lambda_table.captures, captures)
  let mut extra_lam = 0
  let min_lam_nl = user_params + 1
  if final_lam_nl > min_lam_nl {
    extra_lam = final_lam_nl - min_lam_nl
  }
  Array::push(ctx.lambda_table.meta_i32, 0)
  Array::push(ctx.lambda_table.meta_i64, extra_lam)
  blind_reloc_assign_pending(ctx, blind_lo, blind_owner_of_lambda(lambda_idx))
  let table_slot = ctx.lambda_slot_base + lambda_idx
  Array::push(ctx.table_slots_used, table_slot)
  if num_captures == 0 {
    blind_reloc_record(ctx, buf, blind_kind_fn_value, table_slot)
    emit_i64_const(buf, (table_slot<<2)|2)
    next_local
  } else {
    let ptr_local = next_local
    let nl2 = next_local + 1
    Array::push(local_names, "__closure_ptr")
    let cap_off = if ctx.enable_rc {
      16
    } else {
      8
    }
    if ctx.enable_rc {
      let total = 16 + num_captures * 8
      emit_i64_const(buf, total)
      emit_call(buf, ctx.rc_alloc_func_idx)
      emit_local_set(buf, ptr_local)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, total)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 1)
      emit_i32_store(buf, 2, 4)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 7)
      emit_i32_store8(buf, 0, 7)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      blind_reloc_record(ctx, buf, blind_kind_table_slot_i32, table_slot)
      emit_i32_const(buf, table_slot)
      emit_i32_store(buf, 2, 8)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, num_captures)
      emit_i32_store(buf, 2, 12)
    } else {
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_tee(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 8 + num_captures * 8)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_grow_after_heap_set(buf, ctx)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      blind_reloc_record(ctx, buf, blind_kind_table_slot_i32, table_slot)
      emit_i32_const(buf, table_slot)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, num_captures)
      emit_i32_store(buf, 2, 4)
    }
    let mut csi = 0
    while csi < num_captures {
      let cap_name = Array::get(captures, csi)
      let mut __cap_resolve = -1
      let mut __cri = Array::length(local_names) - 1
      while __cri >= 0 {
        if Array::get(local_names, __cri) == cap_name {
          __cap_resolve = __cri
          __cri = -1
        } else {
          __cri = __cri - 1
        }
      }
      if __cap_resolve >= 0 {
        if ctx.enable_rc && array_contains_str(ctx.ref_cell_names, cap_name) {
          // #699: own the captured RC ref cell. Store it odd-tagged so the
          // closure's class-7 drop (gen_rc_drop_body) recognises it as an owned
          // heap value, and bump its refcount (unguarded — a ref cell is always
          // heap) so the shared cell survives until BOTH the defining scope and
          // this closure have dropped it.
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, __cap_resolve)
          emit_i64_const(buf, 1)
          emit_i64_or(buf)
          emit_i64_store(buf, 3, cap_off + csi * 8)
          emit_rc_word_inc_saturating(buf, () -> {
            emit_local_get(buf, __cap_resolve)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, 4)
            emit_i32_sub(buf)
          })
        } else {
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, __cap_resolve)
          emit_i64_store(buf, 3, cap_off + csi * 8)
          // owned-captures ABI (ADR-0076 追記31 Vertical A): the env OWNS
          // every heap capture — dup at creation, released by the closure's
          // class-7 recursive drop. Scalars and string/bytes fat pointers are
          // no-ops on BOTH sides (guarded dup mirrors gen_rc_drop_body's
          // entry checks), so the pair stays balanced across all shapes.
          // The let-rec SELF capture stays weak (no dup; the binder patches
          // the slot after creation and the drop loop skips self-pointing
          // slots) — dup'ing here would (a) leak one stale closure per loop
          // iteration when the letrec local is re-bound, and (b) make the
          // self-cycle unreclaimable.
          if ctx.enable_rc && cap_name != self_name {
            emit_rc_dup_guarded(buf, __cap_resolve, ctx.rc_shadow, ctx.rc_dup_func_idx)
          } else {
            ()
          }
        }
      } else {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i64_const(buf, 0)
        emit_i64_store(buf, 3, cap_off + csi * 8)
      }
      csi = csi + 1
    }
    if ctx.enable_rc {
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 8)
      emit_i64_add(buf)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
    } else {
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
    }
    nl2
  }
}
