    emit_local_set(buf, ptr_local)
    emit_local_get(buf, ptr_local)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, cap_local)
    emit_local_get(buf, cap_local)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 2147483647)
    emit_i32_gt_u(buf)
    emit_if_i64(buf)
    emit_local_get(buf, obj_local)
    emit_call(buf, bl_idx)
    emit_else(buf)
    emit_local_get(buf, obj_local)
    emit_call(buf, al_idx)
    emit_end(buf)
    emit_else(buf)
    emit_local_get(buf, obj_local)
    emit_call(buf, sl_idx)
    emit_end(buf)
    nl
  }
  else if fname == "__index" {
    let (sg_idx, _, _) = resolve_func(ctx.func_table, "String::char_code_at")
    let (bg_idx, _, _) = resolve_func(ctx.func_table, "Bytes::get")
    let (ag_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
    let obj_local = next_local
    let idx_local = next_local + 1
    let ptr_local = next_local + 2
    let cap_local = next_local + 3
    Array::push(local_names, "__index_obj")
    Array::push(local_names, "__index_idx")
    Array::push(local_names, "__index_ptr")
    Array::push(local_names, "__index_cap")
    let mut nl = next_local + 4
    nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)
    emit_local_set(buf, obj_local)
    nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
    emit_local_set(buf, idx_local)
    emit_local_get(buf, obj_local)
    emit_i64_const(buf, 32)
    emit_i64_shr_s(buf)
    emit_i64_eqz(buf)
    emit_if_i64(buf)
    emit_local_get(buf, obj_local)
    emit_local_set(buf, ptr_local)
    emit_local_get(buf, ptr_local)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, cap_local)
    emit_local_get(buf, cap_local)
    emit_i32_wrap_i64(buf)
    emit_i32_const(buf, 2147483647)
    emit_i32_gt_u(buf)
    emit_if_i64(buf)
    emit_local_get(buf, obj_local)
    emit_local_get(buf, idx_local)
    emit_call(buf, bg_idx)
    emit_else(buf)
    emit_local_get(buf, obj_local)
    emit_local_get(buf, idx_local)
    emit_call(buf, ag_idx)
    emit_end(buf)
    emit_else(buf)
    emit_local_get(buf, obj_local)
    emit_local_get(buf, idx_local)
    emit_call(buf, sg_idx)
    emit_end(buf)
    nl
  }
  else if fname == "__set_field" {
    let field = get_estring_value(Array::get(args, 1))
    let fc = String::char_code_at(field, 0)
    let is_numeric = fc >= 48 && fc <= 57
    if is_numeric {
      let mut vi = 0
      let mut vp = 0
      while vp < String::length(field) {
        vi = vi * 10 + (String::char_code_at(field, vp) - 48)
        vp = vp + 1
      }
      if cc_setf_releases(args, local_names, ctx) {
        cc_setf_release_store(buf, args, vi * 8, local_names, next_local, ctx, ld, ce)
      } else {
        let mut nl = next_local
        nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)
        emit_i64_const(buf, -2)
        emit_i64_and(buf)
        emit_i32_wrap_i64(buf)
        nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)
        nl = cc_retain_stored_arg(buf, Array::get(args, 2), local_names, nl, ctx)
        emit_i64_store(buf, 3, vi * 8)
        emit_i64_const(buf, 0)
        nl
      }
    } else {
      // #722: same struct-tag dispatch as the EDot read path
      // (compile_expr_tail4.vibe) — a same-named `mut` field can live at a
      // different slot in another struct, and the static first-match store
      // would corrupt the wrong slot.
      let cands = struct_field_candidates(ctx.ctor_table, field)
      if Array::length(cands) == 0 {
        throw(String::concat("unknown struct field: ", field))
      }
      let (_, idx0) = Array::get(cands, 0)
      let dispatch = struct_field_dispatch_cases(cands)
      if Array::length(dispatch) == 0 && cc_setf_releases(args, local_names, ctx) {
        cc_setf_release_store(buf, args, 8 + idx0 * 8, local_names, next_local, ctx, ld, ce)
      } else if Array::length(dispatch) == 0 {
        let mut nl = next_local
        nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)
        emit_i64_const(buf, -2)
        emit_i64_and(buf)
        emit_i32_wrap_i64(buf)
        nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)
        nl = cc_retain_stored_arg(buf, Array::get(args, 2), local_names, nl, ctx)
        emit_i64_store(buf, 3, 8 + idx0 * 8)
        emit_i64_const(buf, 0)
        nl
      } else {
        let mut nl = next_local
        nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)
        emit_i64_const(buf, -2)
        emit_i64_and(buf)
        let obj_l = nl
        Array::push(local_names, "__setf_obj")
        emit_local_set(buf, obj_l)
        nl = ce(buf, Array::get(args, 2), local_names, nl + 1, ctx, ld)
        nl = cc_retain_stored_arg(buf, Array::get(args, 2), local_names, nl, ctx)
        let val_l = nl
        Array::push(local_names, "__setf_val")
        emit_local_set(buf, val_l)
        // #3140: the slot differs per struct, so each arm swaps its own.
        let release = cc_setf_releases(args, local_names, ctx)
        let old_l = nl + 1
        if release {
          Array::push(local_names, "__setf_old")
        } else {
          ()
        }
        let mut di = 0
        while di < Array::length(dispatch) {
          let (dtag, didx) = Array::get(dispatch, di)
          emit_local_get(buf, obj_l)
          emit_i32_wrap_i64(buf)
          emit_i32_load(buf, 2, 0)
          emit_i32_const(buf, dtag)
          emit_i32_eq(buf)
          emit_if_void(buf)
          if release {
            cc_setf_swap(buf, obj_l, val_l, old_l, 8 + didx * 8, ctx)
          } else {
            emit_local_get(buf, obj_l)
            emit_i32_wrap_i64(buf)
            emit_local_get(buf, val_l)
            emit_i64_store(buf, 3, 8 + didx * 8)
          }
          emit_else(buf)
          di = di + 1
        }
        if release {
          cc_setf_swap(buf, obj_l, val_l, old_l, 8 + idx0 * 8, ctx)
        } else {
          emit_local_get(buf, obj_l)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, val_l)
          emit_i64_store(buf, 3, 8 + idx0 * 8)
        }
        let mut de = 0
        while de < Array::length(dispatch) {
          emit_end(buf)
          de = de + 1
        }
        emit_i64_const(buf, 0)
        if release {
          nl + 2
        } else {
          nl + 1
        }
      }
    }
  }
  else if fname == "FixedArray::length" || fname == "Int64Array::length" {
    ce(buf, ECall(EIdent("Array::length", -1), args, -1), local_names, next_local, ctx, ld)
  }
  else if fname == "FixedArray::get" || fname == "Int64Array::get" {
    ce(buf, ECall(EIdent("Array::get", -1), args, -1), local_names, next_local, ctx, ld)
  }
  else if fname == "FixedArray::set" || fname == "FixedArray::unsafe_set" || fname == "Int64Array::set" {
    ce(buf, ECall(EIdent("Array::set", -1), args, -1), local_names, next_local, ctx, ld)
  }
  else if fname == "FixedArray::make" || fname == "Int64Array::make" {
    let n_expr = Array::get(args, 0)
    let init_expr = Array::get(args, 1)
    let loop_body = ESeq(ECall(EIdent("Array::push", -1), [
      EIdent("__fam_arr", -1),
      EIdent("__fam_init", -1)
    ], -1), EAssign("__fam_i", EBinOp("+", EIdent("__fam_i", -1), EInt(1), -1), EUnit))
    let synth = ELet("__fam_n", n_expr, ELet("__fam_init", init_expr, ELetMut("__fam_arr", EArray(array_empty()), ELetMut("__fam_i", EInt(0), ESeq(EWhile(EBinOp("<", EIdent("__fam_i", -1), EIdent("__fam_n", -1), -1), loop_body), EIdent("__fam_arr", -1)), -1), -1), -1), -1)
    // review-lint: allow-fixed-synthetic-name
    ce(buf, synth, local_names, next_local, ctx, ld)
  }
  else if fname == "FixedArray::blit" {
    // blit(dst, dst_off, src, src_off, len): element-by-element copy, same
    // semantics as gc/backend_call.vibe's FixedArray::blit.
    let dst_expr = Array::get(args, 0)
    let doff_expr = Array::get(args, 1)
    let src_expr = Array::get(args, 2)
    let soff_expr = Array::get(args, 3)
    let len_expr = Array::get(args, 4)
    let loop_body = ESeq(ECall(EIdent("Array::set", -1), [
      EIdent("__fb_dst", -1),
      EBinOp("+", EIdent("__fb_doff", -1), EIdent("__fb_i", -1), -1),
      ECall(EIdent("Array::get", -1), [
        EIdent("__fb_src", -1),
        EBinOp("+", EIdent("__fb_soff", -1), EIdent("__fb_i", -1), -1)
      ], -1)
    ], -1), EAssign("__fb_i", EBinOp("+", EIdent("__fb_i", -1), EInt(1), -1), EUnit))
    let synth = ELet("__fb_dst", dst_expr, ELet("__fb_doff", doff_expr, ELet("__fb_src", src_expr, ELet("__fb_soff", soff_expr, ELet("__fb_len", len_expr, ELetMut("__fb_i", EInt(0), ESeq(EWhile(EBinOp("<", EIdent("__fb_i", -1), EIdent("__fb_len", -1), -1), loop_body), EUnit), -1), -1), -1), -1), -1), -1)
    // review-lint: allow-fixed-synthetic-name
    ce(buf, synth, local_names, next_local, ctx, ld)
  }
  else if fname == "Bytes::fill" {
    // fill(dst, value, count): append `count` copies of `value` to dst.
    // gc-only in the builtin registry; synthesized for the linear backend
    // via Bytes::push (same technique as FixedArray::make).
    let dst_expr = Array::get(args, 0)
    let val_expr = Array::get(args, 1)
    let count_expr = Array::get(args, 2)
    let loop_body = ESeq(ECall(EIdent("Bytes::push", -1), [
      EIdent("__bf2_dst", -1),
      EIdent("__bf2_val", -1)
    ], -1), EAssign("__bf2_i", EBinOp("+", EIdent("__bf2_i", -1), EInt(1), -1), EUnit))
    let synth = ELet("__bf2_dst", dst_expr, ELet("__bf2_val", val_expr, ELet("__bf2_count", count_expr, ELetMut("__bf2_i", EInt(0), ESeq(EWhile(EBinOp("<", EIdent("__bf2_i", -1), EIdent("__bf2_count", -1), -1), loop_body), EUnit), -1), -1), -1), -1)
    // review-lint: allow-fixed-synthetic-name
    ce(buf, synth, local_names, next_local, ctx, ld)
  }
  else if fname == "Bytes::new" && Array::length(args) == 1 {
    // Bytes::new(n): length-n zero-filled buffer (MoonBit semantics). The
    // runtime bytes_new takes no operands, so the generic path used to emit
    // the argument and then call it anyway — the operand stayed stranded on
    // the value stack and the whole module failed validation at
    // instantiation time. Synthesize new() + a zero-push loop instead.
    ce(buf, sized_bytes_new_expr(Array::get(args, 0)), local_names, next_local, ctx, ld)
  } else {
    cc_compile_resolved_call(buf, resolved_name, args, local_names, next_local, ctx, ld, ce, fn_idx_in_list, local_idx_hint)
  }
}
