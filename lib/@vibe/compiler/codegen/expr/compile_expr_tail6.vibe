//# Functions

export fn compile_expr_tail6(buf: Bytes, body: Expr, arms: Array[(Pat, Expr)], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  if Array::length(arms) > 0 {
    let (catch_pat, fallback_expr) = Array::get(arms, 0)
    let is_error = is_pctor(catch_pat) && is_exception_throw_handler_name(get_pctor_name(catch_pat))
    // ADR-0076 追記34 V2: the replay frontier is gone, so this function
    // lowers ONLY `with Exception` handles. Every reachable non-Error handle
    // has already been consumed upstream (inline_direct_performs, scps,
    // evidence_dict_pass -- whose live-handle check hard-errors on any
    // survivor); the only non-Error handle that can still get here sits in
    // a provably-DEAD function (dce keep flag false) that codegen must
    // still emit, so it lowers to a single `unreachable` (valid in an i64
    // expression position via stack polymorphism, and by construction
    // never executed).
    if !is_error {
      bytebuf_push(buf, 0)
      next_local
    } else {
      let catch_tag = 2
      emit_block_i64(buf)
      emit_loop_void(buf)
      emit_block_i64(buf)
      bytebuf_push(buf, 31)
      bytebuf_push(buf, 126)
      bytebuf_push(buf, 1)
      bytebuf_push(buf, 0)
      bytebuf_push(buf, catch_tag)
      bytebuf_push(buf, 0)
      // #965: names the handled BODY binds must not stay resolvable while the
      // HANDLER arms compile below. resolve_local matches last-wins, so a body
      // `let n = ...` shadowing an outer `n` made an arm's `n` read the body's
      // (never-assigned-on-throw) wasm local — parse_program_recovering's
      // resync scan read tokens-total `n` as the parse_stmt tuple's inner `n`
      // (always 0 on the throw path) and went inert. match arms already
      // restore scope (compile_match truncates); handle alone leaked. The RC
      // lane never hit this because uniquify_shadowed_bindings (#712) α-renames
      // shadows first — the bump lane (VIBE_RC=0, which builds the compiler
      // itself) does not run it. MASK the body's names to an unresolvable
      // sentinel instead of truncating: the wasm local INDICES must stay
      // allocated (#665 — truncation would let sibling arms reuse live slots).
      // ref_cell_names is name-keyed too: a captured `let mut n` in the body
      // pushes "n" there, and with the names masked below an arm's `n` would
      // resolve to the OUTER scalar slot while still being loaded through the
      // ref-cell path (garbage). Unlike local slots, these entries carry no
      // index, so plain truncation is the correct scope restore.
      let body_names_start = Array::length(local_names)
      let body_ref_cells_start = Array::length(ctx.ref_cell_names)
      let _nl1 = compile_expr(buf, body, local_names, next_local, ctx, ld)
      let mut mask_i = body_names_start
      while mask_i < Array::length(local_names) {
        Array::set(local_names, mask_i, "")
        mask_i = mask_i + 1
      }
      Array::truncate(ctx.ref_cell_names, body_ref_cells_start)
      emit_end(buf)
      emit_br(buf, 2)
      emit_end(buf)
      if is_pctor(catch_pat) {
        let cargs = get_pctor_args(catch_pat)
        let decl_arity = effect_op_declared_arity(ctx.effect_op_keys, ctx.effect_op_arities, get_pctor_name(catch_pat))
        if decl_arity > 1 {
          let ptr_l = Array::length(local_names)
          emit_local_set(buf, ptr_l)
          Array::push(local_names, "__eff_payload")
          let ncargs = Array::length(cargs)
          let mut ci = 0
          while ci < decl_arity {
            if ci < ncargs {
              let cp = Array::get(cargs, ci)
              if is_pbind(cp) {
                let pname = get_pbind_name(cp)
                let fl = Array::length(local_names)
                emit_local_get(buf, ptr_l)
                if ctx.enable_rc {
                  emit_i64_const(buf, -2)
                  emit_i64_and(buf)
                } else {
                  ()
                }
                emit_i32_wrap_i64(buf)
                emit_i64_load(buf, 3, if ctx.enable_rc {
                  8 + ci * 8
                } else {
                  ci * 8
                })
                emit_local_set(buf, fl)
                Array::push(local_names, pname)
                if ctx.enable_rc {
                  emit_rc_dup_guarded(buf, fl, ctx.rc_shadow, ctx.rc_dup_func_idx)
                } else {
                  ()
                }
              } else if is_pwild(cp) {
                ()
              } else {
                throw("handle: only simple bindings or '_' are supported in multi-argument effect op patterns (see #548)")
              }
            } else {
              ()
            }
            ci = ci + 1
          }
          if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {
            emit_local_get(buf, ptr_l)
            emit_call(buf, ctx.rc_drop_func_idx)
          } else {
            ()
          }
        } else if Array::length(cargs) > 0 && is_pbind(Array::get(cargs, 0)) {
          let pname = get_pbind_name(Array::get(cargs, 0))
          let bl = Array::length(local_names)
          emit_local_set(buf, bl)
          Array::push(local_names, pname)
        } else {
          emit_drop(buf)
        }
      } else if is_pbind(catch_pat) {
        let pname = get_pbind_name(catch_pat)
        let bl = Array::length(local_names)
        emit_local_set(buf, bl)
        Array::push(local_names, pname)
      } else {
        emit_drop(buf)
      }
      emit_block_i64(buf)
      bytebuf_push(buf, 31)
      bytebuf_push(buf, 126)
      bytebuf_push(buf, 1)
      bytebuf_push(buf, 0)
      bytebuf_push(buf, 1)
      bytebuf_push(buf, 0)
      let nl2 = compile_expr(buf, fallback_expr, local_names, Array::length(local_names), ctx, ld)
      emit_end(buf)
      emit_br(buf, 2)
      emit_end(buf)
      emit_drop(buf)
      emit_br(buf, 0)
      emit_end(buf)
      bytebuf_push(buf, 0)
      emit_end(buf)
      // #965: retire everything this handle introduced (payload binds,
      // __eff_payload temps, arm-body lets) before compilation continues
      // past the handle expression — same last-wins leak one level out.
      // Indices stay allocated (no truncate, #665).
      let mut post_mask_i = body_names_start
      while post_mask_i < Array::length(local_names) {
        Array::set(local_names, post_mask_i, "")
        post_mask_i = post_mask_i + 1
      }
      Array::truncate(ctx.ref_cell_names, body_ref_cells_start)
      nl2
    }
  } else {
    compile_expr(buf, body, local_names, next_local, ctx, ld)
  }
}
