version 0.0.1

// @vibe/compiler/codegen/expr — ADR-0070 / #897 compiler-internal contract.
// Directory-shared-scope package: expr.vibe (facade), core.vibe/support.vibe
// (re-export shims), compile_call.vibe, compile_expr.vibe,
// compile_expr_tail{,2..7}.vibe, compile_lambda.vibe, compile_match.vibe,
// compile_module_expr.vibe.

fn compile_expr(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int) -> Int with { Error }
fn compile_module_expr(stmts: Array[Stmt]) -> Bytes with { Error }
fn compile_call(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }
fn cc_is_borrow_ret_call(e: Expr, ctx: CompileCtx) -> Bool
fn cc_builtin_call_ret_kind(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Int with { Error }
fn cc_expr_is_stringish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error }
fn cc_is_loop_borrowed_ident(e: Expr, ctx: CompileCtx) -> Bool
fn expr_is_boolish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error }
fn expr_is_floatish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error }
fn expr_is_intish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with { Error }
fn compile_expr_tail(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }
fn compile_expr_tail2(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }
fn compile_expr_tail3(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }
fn compile_expr_tail4(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }
fn compile_expr_tail5(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }
fn compile_expr_tail6(buf: Bytes, body: Expr, arms: Array[(Pat, Expr)], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }
fn compile_expr_tail7(buf: Bytes, parts: Array[String], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }
fn compile_lambda(buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }
fn compile_match(buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error }
