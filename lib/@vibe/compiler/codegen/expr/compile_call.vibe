      if Array::length(args) > 0 {
        nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)
        if fname == "Env::args_get" {
          emit_i64_const(buf, 1)
          emit_i64_shr_s(buf)
        } else {
          ()
        }
      } else {
        ()
      }
      emit_call(buf, hi_idx)
      if fname == "Env::args_get" {
        ()
      } else {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      }
      nl
    }
    else if ctx.enable_rc && (fname == "vibe_http_response_status_raw" || fname == "vibe_http_response_body_raw" || fname == "vibe_http_close_raw") {
      // #794: same raw-ABI shim as the #705 block above for the HTTP client
      // host imports. The handle param is a guest-tagged Int (untag it);
      // response_status returns a raw Int (tag it). response_body returns a
      // packed string (same in both modes) and close returns nothing --
      // leaving a raw int result untagged would repeat the #768 Fs::is_dir
      // odd-raw-value RC-pointer misread (raw handle 1 is odd).
      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_i64_const(buf, 1)
      emit_i64_shr_s(buf)
      emit_call(buf, hi_idx)
      if fname == "vibe_http_response_status_raw" {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      } else if fname == "vibe_http_close_raw" {
        // (i64) -> () import: the surrounding expression still expects a
        // value, so push the Unit 0 the generic returns==0 path would.
        emit_i64_const(buf, 0)
      } else {
        ()
      }
      nl
    }
    else if ctx.enable_rc && fname == "vibe_http_response_header_raw" {
      // #794: (handle: Int -> untag, name: String -> pass) -> String (pass).
      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_i64_const(buf, 1)
      emit_i64_shr_s(buf)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_call(buf, hi_idx)
      nl
    }
    else if ctx.enable_rc && fname == "vibe_http_request_raw" {
      // #794: four packed-string params pass through; the raw Int handle
      // result must be tagged (it is 1-based, so leaving it raw hands the RC
      // machinery an odd non-pointer -- the exact #768 failure shape).
      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)
      nl = ce(buf, Array::get(args, 3), local_names, nl, ctx, ld)
      emit_call(buf, hi_idx)
      emit_i64_const(buf, 1)
      emit_i64_shl(buf)
      nl
    }
    else if ctx.enable_rc && fname == "vibe_sh_capture_raw" {
      // #865: same raw-ABI shim shape as vibe_http_request_raw above -- one
      // packed-string param passes through; the raw Int handle result must
      // be tagged (untagged, it's the same #768 odd-raw-value RC-pointer
      // misread the http/#705 shims above all guard against).
      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_call(buf, hi_idx)
      emit_i64_const(buf, 1)
      emit_i64_shl(buf)
      nl
    }
    else if ctx.enable_rc && (fname == "vibe_sh_capture_exit_code_raw" || fname == "vibe_sh_capture_stdout_raw" || fname == "vibe_sh_capture_stderr_raw" || fname == "vibe_sh_capture_close_raw" || fname == "vibe_process_exit_raw") {
      // #865: same raw-ABI shim shape as the vibe_http_response_status_raw /
      // vibe_http_response_body_raw / vibe_http_close_raw group above -- the
      // handle param is a guest-tagged Int (untag it); exit_code returns a
      // raw Int (tag it), stdout/stderr return packed strings (same in both
      // modes, pass through), close returns nothing (push Unit 0).
      // #903: vibe_process_exit_raw takes the same shape as close (one
      // tagged-Int arg to untag, no meaningful return -- the host runner
      // traps/exits before ever returning, but codegen still needs SOME
      // Unit value on the stack for the (never-reached) fallthrough).
      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_i64_const(buf, 1)
      emit_i64_shr_s(buf)
      emit_call(buf, hi_idx)
      if fname == "vibe_sh_capture_exit_code_raw" {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      } else if fname == "vibe_sh_capture_close_raw" || fname == "vibe_process_exit_raw" {
        emit_i64_const(buf, 0)
      } else {
        ()
      }
      nl
    }
    // #1460: the `Console` spellings share the imports, so they inherit the
    // gap too -- they are registered into the func table the same way, with
    // no shim. Caught by running the probe rather than by a type error: the
    // tagged byte is invisible output (write_char(65) sends 130, a control
    // character), so the calls looked like silent no-ops.
    // #1746: the name list moved into cc_raw_abi_shim_applies, which also
    // checks the name still DENOTES the host import -- see its doc comment.
    else if ctx.enable_rc && cc_raw_abi_shim_applies(ctx.func_table, ctx.func_offset, fname) {
      // #930: same raw-ABI shim shape as the #705 Fs::exists family and the
      // #865 vibe_process_exit_raw case above -- these three were registered
      // straight into the func table (linked_compile's name->import map) with
      // NO shim, so the generic call path handed the host a guest-TAGGED int
      // (write_char(65) wrote byte 130 -- "42" printed as "hd" -- and
      // read_stream(n) read 2n bytes). Untag the int param; write_char's
      // void import pushes Unit 0, read_stream's packed-string result passes
      // through unchanged (same in both modes). `sleep` has the exact same
      // gap -- #705's own comment flagged it ("still lacks this shim") --
      // and slept for 2x the requested duration under RC (`sleep_ms(500)`
      // took ~1000ms wall time) until folded into this group; same void
      // shape as write_char.
      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_i64_const(buf, 1)
      emit_i64_shr_s(buf)
      emit_call(buf, hi_idx)
      // The read half returns a packed string; the write halves are void and
      // need the Unit 0 pushed for them. #1460 keeps both spellings of the
      // read on the value-returning side.
      if fname == "Stdin::read_stream" || fname == "Console::read_stream" {
        ()
      } else {
        emit_i64_const(buf, 0)
      }
      nl
    }
    else if ctx.enable_rc && fname == "vibe_tcp_connect_raw" {
      // Same raw-ABI shim shape as the #705/#930 families above -- registered
      // straight into the func table (linked_compile's name->import map) with
      // no shim, so under RC the generic call path handed the host a
      // guest-TAGGED port (tcp_connect("127.0.0.1", 7) dialed port 14). Host
      // arg passes through (packed string); the tagged Int port must be
