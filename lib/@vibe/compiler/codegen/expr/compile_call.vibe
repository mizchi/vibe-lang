//# Functions

/// Map::has_key's original O(n) linear scan, factored out for the same reason
/// as cc_map_get_linear_scan above. Leaves a raw untagged 0/1 i64 -- callers
/// apply the RC bool-tag shift uniformly after picking either this or the
/// probe-index path.
fn cc_map_has_linear_scan(buf: Bytes, map_local: Int, key_local: Int, count_local: Int, idx_local: Int, eq_idx: Int) -> Unit {
  emit_i64_const(buf, 0)
  emit_local_set(buf, idx_local)
  emit_block_i64(buf)
  emit_block_void(buf)
  emit_loop_void(buf)
  emit_local_get(buf, idx_local)
  emit_local_get(buf, count_local)
  emit_i64_ge_s(buf)
  emit_br_if(buf, 1)
  emit_local_get(buf, map_local)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf, idx_local)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 16)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_i64_load(buf, 3, 8)
  emit_local_get(buf, key_local)
  emit_call(buf, eq_idx)
  emit_i32_wrap_i64(buf)
  emit_if_void(buf)
  emit_i64_const(buf, 1)
  emit_br(buf, 3)
  emit_end(buf)
  emit_local_get(buf, idx_local)
  emit_i64_const(buf, 1)
  emit_i64_add(buf)
  emit_local_set(buf, idx_local)
  emit_br(buf, 0)
  emit_end(buf)
  emit_end(buf)
  emit_i64_const(buf, 0)
  emit_end(buf)
}

/// Map::get's original O(n) linear scan, factored out so the O(1)-average
/// hash-index path (see ctx.map_probe_func_idx) can fall back to it verbatim
/// for maps below the index-build threshold (index_ptr==0 at runtime) without
/// duplicating the bytecode. `map_local` must already be untagged (map & -2)
/// and `count_local` already loaded. Leaves the found value (or 0) as the
/// single i64 result -- callers needing this as a sub-expression (e.g. inside
/// another `if_i64`'s branch) can emit it directly; callers needing it as
/// their own function's tail value can emit it as the last instruction.
fn cc_map_get_linear_scan(buf: Bytes, map_local: Int, key_local: Int, count_local: Int, idx_local: Int, eq_idx: Int) -> Unit {
  emit_i64_const(buf, 0)
  emit_local_set(buf, idx_local)
  emit_block_i64(buf)
  emit_block_void(buf)
  emit_loop_void(buf)
  emit_local_get(buf, idx_local)
  emit_local_get(buf, count_local)
  emit_i64_ge_s(buf)
  emit_br_if(buf, 1)
  emit_local_get(buf, map_local)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf, idx_local)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 16)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_i64_load(buf, 3, 8)
  emit_local_get(buf, key_local)
  emit_call(buf, eq_idx)
  emit_i32_wrap_i64(buf)
  emit_if_void(buf)
  emit_local_get(buf, map_local)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf, idx_local)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 16)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_i64_load(buf, 3, 16)
  emit_br(buf, 3)
  emit_end(buf)
  emit_local_get(buf, idx_local)
  emit_i64_const(buf, 1)
  emit_i64_add(buf)
  emit_local_set(buf, idx_local)
  emit_br(buf, 0)
  emit_end(buf)
  emit_end(buf)
  emit_i64_const(buf, 0)
  emit_end(buf)
}

/// A field projection `a.f` (EDot) passed as an argument to an owning user
/// function (which drops its parameters) is a borrow of the source aggregate.
/// Without a retain the callee's param-drop frees it while the source still
/// references it — a double-free that corrupts the free list (e.g. derived
/// `T::equals` passing `a.items` to the consuming `__arr_equals__` helper, #704).
/// #929: non-throwing func-table membership probe (resolve_func throws on a
/// missing name). The println/print fallback lowering below must yield to a
/// SOURCE-provided definition (@vibe/io's println, or a user shadow) whenever
/// one is merged into the program.
fn cc_ft_has(ft: FuncTable, name: String) -> Bool {
  func_table_index_of(ft, name) >= 0
}

/// Perceus emits no action for bare projections, so this guarded dup is the only
/// owner-increment. Scalars are no-ops; this is NOT applied to borrow-arg0
/// builtins (Array::get/length etc.), which do not drop their argument.
/// #1746: does the RC raw-ABI shim (the #705/#930/#1460 group below) actually
/// apply to this call?
///
/// The shim rewrites the call for the HOST IMPORT's ABI -- it untags the Int
/// argument and, for the void half, pushes the `Unit` the import does not
/// return. Dispatching on the NAME alone assumed the name still denotes that
/// import. A program defining its own top-level `fn sleep(ms: Int) -> Unit`
/// resolves it to that function instead, and the shim then emitted
/// `call <guest fn>` followed by the extra `i64.const 0` -- a module that
/// FAILED VALIDATION with no diagnostic at all (measured under VIBE_RC=1;
/// VIBE_RC=0 was fine, which is why no gate saw it).
///
/// The discriminator is the resolved function INDEX. User functions are laid
/// out at `fi + func_offset` (linked_compile.vibe, where
/// `func_offset = num_imported_funcs + num_generated`), so an index below
/// `func_offset` is an import or a generated builtin body and anything at or
/// above it is the program's own code. This is the same test the wasm-gc
/// backend already uses to recover a user function's table slot
/// (`fidx - ctx.func_offset`, gc/backend_expr.vibe).
///
/// The return COUNT does not work here, and measuring is what showed it: the
/// count comes from the registry row's `CtUnit`, so the import reports 1 just
/// as a guest `-> Unit` function does. Gating on it left the shim off the real
/// import, and `sleep(400)` then took ~795ms instead of ~400ms -- the exact
/// doubling #930 recorded when the shim was missing.
///
/// Only `sleep` is reachable today: for the five `::`-qualified names the
/// checker demands their capability row at the call site and a plain guest
/// function does not discharge it (`effect row mismatch for 'main': missing
/// { Stdin::... }`, measured for all five). `sleep` gets through because for an
/// UNQUALIFIED name the checker does honour the user's shadowing definition.
/// The index test covers all seven anyway rather than relying on that.
fn cc_raw_abi_shim_applies(ft: FuncTable, func_offset: Int, fname: String) -> Bool with Exception {
  if fname == "Stdout::write_char" || fname == "Stderr::write_char" || fname == "Stdin::read_stream" || fname == "sleep" || fname == "Console::write_char" || fname == "Console::write_err_char" || fname == "Console::read_stream" {
    let (idx, _, _) = resolve_func(ft, fname)
    idx < func_offset
  } else {
    false
  }
}

fn cc_is_projection(e: Expr) -> Bool {
  match e {
    EDot(_, _, _, _) => true,
    _ => false
  }
}

/// #705: a borrow-RETURNING builtin call (`Array::get` / `Map::get` / `__index`)
/// yields a borrowed view of a heap element — its refcount is NOT bumped, like a
/// projection `a.f`. When that result is consumed in an OWNING position (a ctor
/// field, or an owning call arg of a fn that drops its params), it must be
/// rc_dup'd or the container's recursive drop and the consume double-free the
/// same element (e.g. `chk(Array::get(ps, i))` recursing over a heap array, or
/// `validate(s, Map::get(obj, key))`). Scalars are even so the guarded dup is a
/// runtime no-op for `Array[Int]` etc.
export fn cc_is_borrow_ret_call(e: Expr, ctx: CompileCtx) -> Bool {
  match e {
    ECall(callee, _, _) =>
    match callee {
      EIdent(f, _) => is_borrow_ret_builtin(f) || bsearch_leftmost(ctx.borrow_ret_names, f) >= 0,
      _ => false
    },
    _ => false
  }
}

/// Is `e` provably a scalar (Int/Bool) by structure alone — an int/bool literal,
/// a bitwise/shift/comparison/logical binop, or a logical `!`? Conservative: no
/// ident-slot/type lookup and no arith ops (+,-,*,/ can be Float). Used to route
/// an explicit `eq(a, b)` to a direct i64.eq when an operand is provably scalar,
/// matching how the `==` binop dispatches intish operands (emit_eq_value). Without
/// this, `eq(int, int)` falls through to the generic bound `eq` whose
/// `looks_like_string`/str_eq fallback reads OOB on ints resembling fat-pointers
/// (#678 residual) — e.g. leb128's `eq(val, 0)` trapped under RC (#705).
fn cc_arg_is_scalarish(e: Expr) -> Bool with Exception {
  let t = expr_tag(e)
  if t == 0 || t == 1 {
    true
  } else if t == 5 {
    let op = get_ebinop_op(e)
    op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" || op == "%" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "==" || op == "!=" || op == "&&" || op == "||"
  } else if t == 6 {
    let uop = get_eunaryop_op(e)
    // `!x` is Bool; `-x` is scalar iff its operand is (so a negative int literal
    // like `-1`, which parses as unary minus of `1`, is detected as scalar).
    uop == "!" || (uop == "-" && cc_arg_is_scalarish(get_eunaryop_expr(e)))
  } else {
    false
  }
}

/// #745: local mirror of compile_expr_tail's expr_is_floatish/slot_is_floatish
/// (importing them here would be a cycle: compile_expr_tail imports this file).
/// Used to route `eq(a, b)` with a float operand onto the unbox + f64.eq path
/// under RC — the scalar i64.eq below compares BOX POINTERS for boxed floats,
/// so `eq(0.0125, 0.0125)` came out false and the assert trapped.
fn cc_slot_is_floatish(ctx: CompileCtx, slot: Int) -> Bool {
  let arr = ctx.float_local_slots
  let mut j = Array::length(arr) - 1
  let mut result = false
  while j >= 0 {
    let entry = Array::get(arr, j)
    if entry / 2 == slot {
      result = (entry % 2) == 1
      j = -1
    } else {
      j = j - 1
    }
  }
  result
}

/// #2158: is `fname` a user function DECLARED to return Double/Float?
///
/// The table is built once, in the pre-pass in wasi/linked_compile.vibe, so
/// this is a linear scan over a small list rather than a type lookup --
/// codegen has no types to look up (see CompileCtx.float_ret_fns).
///
/// `local_names` is not optional: the table is keyed by NAME, and a local
/// binding of the same name shadows the top-level declaration. Without this
/// check, `fn value() -> Double` at the top level made `let value = () -> Int
/// { 1 }; __to_string(value())` render the Int through the float path and
/// print 0 -- a silently wrong answer this predicate itself introduced
/// (#2156 review). Taking `local_names` as a parameter rather than leaving
/// the check to each caller is what keeps the next call site from repeating
/// it; codegen already has two hand-written copies of the floatish
/// classifier, which is how #2158 needed fixing twice.
export fn cc_fn_returns_float(local_names: Array[String], ctx: CompileCtx, fname: String) -> Bool {
  if find_local_slot(local_names, fname) >= 0 {
    false
  } else {
    let arr = ctx.float_ret_fns
    let mut i = Array::length(arr) - 1
    let mut found = false
    while i >= 0 {
      if Array::get(arr, i) == fname {
        found = true
        i = -1
      } else {
        i = i - 1
      }
    }
    found
  }
}

fn cc_expr_is_floatish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with Exception {
  // fbox (#797): mirror of expr_is_floatish's EDot tuple-projection case --
  // `t.N` on a tracked tuple-literal binding recurses into the backing
  // ETuple element via the #724 agg log.
  let dot_float = match e {
    EDot(dobj, dfield, _, _) => {
      let fc = String::char_code_at(dfield, 0)
      if fc >= 48 && fc <= 57 && is_eident(dobj) {
        let slot = find_local_slot(local_names, get_eident_name(dobj))
        if slot >= 0 {
          let info = agg_slot_lookup(ctx.agg_local_slots, slot)
          if info >= 0 && info / 64 == 1 {
            let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)
            if is_etuple(backing) {
              let elems = get_etuple_elems(backing)
              let mut k = 0
              let mut fp = 0
              while fp < String::length(dfield) {
                k = k * 10 + (String::char_code_at(dfield, fp) - 48)
                fp = fp + 1
              }
              if k >= 0 && k < Array::length(elems) {
                cc_expr_is_floatish(Array::get(elems, k), local_names, ctx)
              } else {
                false
              }
            } else {
              false
            }
          } else {
            false
          }
        } else {
          false
        }
      } else {
        false
      }
    },
    _ => false
  }
  let tag = expr_tag(e)
  if dot_float {
    true
  } else if tag == 2 {
    true
  } else if tag == 4 {
    let nm = get_eident_name(e)
    let len = Array::length(local_names)
    let mut i = len - 1
    let mut slot = -1
    while i >= 0 {
      if Array::get(local_names, i) == nm {
        slot = i
        i = -1
      } else {
        i = i - 1
      }
    }
    if slot >= 0 {
      cc_slot_is_floatish(ctx, slot)
    } else {
      false
    }
  } else if tag == 5 {
    let op = get_ebinop_op(e)
    if op == "+" || op == "-" || op == "*" || op == "/" {
      cc_expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || cc_expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)
    } else {
      false
    }
  } else if tag == 6 {
    let op = get_eunaryop_op(e)
    if op == "-" {
      cc_expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)
    } else {
      false
    }
  } else if tag == 8 {
    let callee = get_ecall_callee(e)
    if array_contains_int(ctx.float_call_offsets, get_ecall_off(e)) {
      // #2158: the CHECKER said this exact call node's result is a Double.
      //
      // Asked BEFORE the callee shape is dispatched on, because the table is
      // keyed by the call node's own source OFFSET and knows nothing about the
      // callee. Nesting it under `is_eident` made it unreachable for a call
      // whose callee is not a name -- an IIFE `(() -> { 2.5 })()` had its
      // offset recorded by the checker and never read, and printed `204`, the
      // f64 bits (#2226 review, measured).
      //
      // Strictly ADDITIVE -- an extra term in front of the syntactic tests
      // below, never a replacement for them, so this can only add a Double
      // classification and never remove one. It reaches the shapes the
      // name-keyed `float_ret_fns` structurally cannot: a generic instantiated
      // at Double, a call through a local alias or a lambda binding,
      // `Array::get` on an `Array[Double]`. Retiring the name table is #2166
      // and is deliberately NOT this change.
      //
      // No `local_names` guard is needed (unlike cc_fn_returns_float below):
      // being offset-keyed, a local binding that shadows a top-level
      // `-> Double` function is a different call node at a different offset
      // and cannot collide with it.
      true
    } else if is_eident(callee) {
      let fname = get_eident_name(callee)
      if fname == "Int::to_double" || fname == "Int::to_float" || fname == "Float::to_double" || fname == "Double::to_float" || fname == "Double::from_i64_bits" {
        true
      } else if cc_fn_returns_float(local_names, ctx, fname) {
        // #2158: a call to a user function DECLARED `-> Double` / `-> Float`.
        // Without this the call fell through to the runtime bit-pattern
        // heuristic, so `"\{half(5.0)}"` rendered the f64 as an integer --
        // compiling clean and printing a plausible wrong number. The declared
        // return type was right there in the signature; codegen just had no
        // table to read it from. CompileCtx.float_ret_fns is that table.
        true
      } else if fname == "__rec_field" {
        // fbox (#797): mirror of expr_is_floatish's tuple-projection case --
        // `t.0` on a tracked tuple-literal binding recurses into the backing
        // ETuple element via the #724 agg log (heap fields hold raw f64 bits,
        // so the reader must recover float-ness statically).
        let args = get_ecall_args(e)
        if Array::length(args) == 2 && is_eident(Array::get(args, 0)) && expr_tag(Array::get(args, 1)) == 0 {
          let slot = find_local_slot(local_names, get_eident_name(Array::get(args, 0)))
          if slot >= 0 {
            let info = agg_slot_lookup(ctx.agg_local_slots, slot)
            if info >= 0 && info / 64 == 1 {
              let backing = agg_expr_lookup(ctx.agg_local_slots, ctx.agg_local_exprs, slot)
              if is_etuple(backing) {
                let elems = get_etuple_elems(backing)
                let k = get_eint_value(Array::get(args, 1))
                if k >= 0 && k < Array::length(elems) {
                  cc_expr_is_floatish(Array::get(elems, k), local_names, ctx)
                } else {
                  false
                }
              } else {
                false
              }
            } else {
              false
            }
          } else {
            false
          }
        } else {
          false
        }
      } else {
        false
      }
    } else if is_efn(callee) && Array::length(get_ecall_args(e)) == 1 {
      // #1153/#1185 (+ #1207 Codex review P2): mirror of expr_is_floatish's
      // identical ascribe_wrap case (compile_expr_tail.vibe) for this
      // file's local copy -- see that fix's comment for the full mechanism
      // and for why the match requires the COMPLETE synthetic identity-
      // lambda shape (no type params, no declared return type, no effect
      // row, body exactly `EIdent(<the param's own name>, _)`), not just
      // the param's own name/type.
      match callee {
        EFn(tparams, _, params, ret_ty, effect, body) => if Array::length(tparams) == 0 && Array::length(params) == 1 && (match ret_ty {
          None => true,
          Some(_) => false
        }) && (match effect {
          None => true,
          Some(_) => false
        }) {
          let (asc_name, asc_ty) = Array::get(params, 0)
          if asc_name == "__asc" || (String::starts_with(asc_name, "__shadow_") && String::ends_with(asc_name, "___asc")) {
            match body {
              EIdent(bname, _) => if bname == asc_name {
                match asc_ty {
                  Some(TyName(tn)) => tn == "Double" || tn == "Float",
                  _ => false
                }
              } else {
                false
              },
              _ => false
            }
          } else {
            false
          }
        } else {
          false
        },
        _ => false
      }
    } else {
      false
    }
  } else {
    false
  }
}

/// #950: FIRST-match index of `name` in the func table, or -1 on a miss.
/// Mirrors resolve_func's scan (first match wins) without throwing, so a
/// classifier can ask "which entry would actually serve this call?".
fn cc_ft_first_idx(ft: FuncTable, name: String) -> Int {
  func_table_index_of(ft, name)
}

/// #950: declared return kind of a call whose callee resolves to a BUILTIN —
/// 0 = unknown, 1 = Bool, 2 = String. This is the type-directed half of the
/// interpolation display fix: `"\{String::contains(a, b)}"` printed 1/0 and
/// `"\{String::join([], "-")}"` printed 0 (the packed empty-string encoding,
/// misread as Int by __to_string's runtime string-pointer heuristic), because
/// the display classifiers were purely syntactic and never consulted the
/// builtin's declared return type.
///
/// Shadow-safety (the reason #784 deliberately skipped name-based
/// classification): the func table lays out USER functions first (indices
/// < ctx.num_user_funcs) and appends the registered builtins after them, and
/// call emission resolves FIRST match (resolve_func) / prefers a bound call
/// (prefer_bound_call). So the builtin's declared type only applies when the
/// name is NOT locally bound AND its first func-table match (if any) is NOT a
/// user function. A user/prelude shadow therefore classifies as 0 (unknown),
/// exactly matching what the actual call emission dispatches to. Name sets
/// mirror the checker's declared types (checker/checker.vibe
/// direct_builtin_return / core/builtin_registry.vibe).
export fn cc_builtin_call_ret_kind(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Int with Exception {
  if expr_tag(e) == 8 {
    let bcallee = get_ecall_callee(e)
    if is_eident(bcallee) {
      let bn = canonical_builtin_name(get_eident_name(bcallee))
      let kind = if bn == "eq" || bn == "not" || bn == "String::equals" || bn == "String::contains" || bn == "String::starts_with" || bn == "String::ends_with" || bn == "Array::contains" || bn == "Array::any" || bn == "Array::all" || bn == "Map::has_key" || bn == "Map::has" || bn == "map_has" || bn == "MapBuilder::has_key" || bn == "Path::is_absolute" || bn == "Fs::exists" || bn == "Fs::is_dir" || bn == "Fs::is_file" {
        1
      } else if bn == "__to_string" || bn == "Int::to_string" || bn == "Double::to_string" || bn == "Float::to_string" || bn == "String::concat" || bn == "String::substring" || bn == "String::trim" || bn == "String::from_char_code" || bn == "String::join" || bn == "Env::get" || bn == "Env::args_get" || bn == "Fs::read_file" || bn == "Fs::getcwd" || bn == "sh" {
        2
      } else {
        0
      }
      if kind == 0 {
        0
      } else if find_local_slot(local_names, bn) >= 0 {
        0
      } else {
        let fi = cc_ft_first_idx(ctx.func_table, bn)
        if fi >= 0 && fi < ctx.num_user_funcs {
          0
        } else {
          kind
        }
      }
    } else {
      0
    }
  } else {
    0
  }
}

/// #950: is `e` statically a String? The stringish sibling of
/// cc_expr_is_boolish below (same structure, same slot-log discipline: kind-2
/// entries in ctx.int_local_slots track `let`-bound strings, see
/// compile_expr_tail's slot_is_intish doc). Consumed by the `__to_string`
/// dispatch: a statically-String segment IS the result, so it bypasses the
/// runtime string-pointer heuristic — which misreads the packed empty-string
/// encoding 0 (e.g. `String::join([], sep)`, ptr 0 / len 0) as Int 0 and
/// printed "0" for a perfectly legal empty string.
export fn cc_expr_is_stringish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with Exception {
  let tag = expr_tag(e)
  if tag == 3 {
    true
  } else if tag == 4 {
    // A bare ident `let`-bound to a stringish value — kind-2 entry in
    // ctx.int_local_slots (slot*4 + kind). Same scan as the boolish kind-3
    // lookup below.
    let nm = get_eident_name(e)
    let mut i = Array::length(local_names) - 1
    let mut slot = -1
    while i >= 0 {
      if Array::get(local_names, i) == nm {
        slot = i
        i = -1
      } else {
        i = i - 1
      }
    }
    if slot >= 0 {
      let arr = ctx.int_local_slots
      let mut j = Array::length(arr) - 1
      let mut result = false
      while j >= 0 {
        let entry = Array::get(arr, j)
        if entry / 4 == slot {
          result = (entry % 4) == 2
          j = -1
        } else {
          j = j - 1
        }
      }
      result
    } else {
      false
    }
  } else if tag == 9 {
    cc_expr_is_stringish(get_elet_body(e), local_names, ctx)
  } else if tag == 10 {
    cc_expr_is_stringish(get_eletrec_body(e), local_names, ctx)
  } else if tag == 11 {
    cc_expr_is_stringish(get_eletmut_body(e), local_names, ctx)
  } else if tag == 14 {
    cc_expr_is_stringish(get_eseq_second(e), local_names, ctx)
  } else if tag == 7 {
    cc_expr_is_stringish(get_eif_then(e), local_names, ctx) && cc_expr_is_stringish(get_eif_else(e), local_names, ctx)
  } else if tag == 16 {
    let arms = get_match_arms(e)
    let alen2 = Array::length(arms)
    if alen2 == 0 {
      false
    } else {
      let mut all_str = true
      let mut si2 = 0
      while si2 < alen2 {
        if !cc_expr_is_stringish(get_arm_body(Array::get(arms, si2)), local_names, ctx) {
          all_str = false
        } else {
          ()
        }
        si2 = si2 + 1
      }
      all_str
    }
  } else if tag == 8 {
    let bcallee = get_ecall_callee(e)
    if is_efn(bcallee) && Array::length(get_ecall_args(e)) == 1 {
      // `let s: String = e` ascription marker `((__asc: String) -> __asc)(e)`
      // — honor the annotation (same shapes as the Bool arm in
      // cc_expr_is_boolish below, incl. the uniquify-renamed form).
      let fparams = get_efn_params(bcallee)
      if Array::length(fparams) == 1 {
        let (asc_name, asc_ty) = Array::get(fparams, 0)
        (asc_name == "__asc" || (String::starts_with(asc_name, "__shadow_") && String::ends_with(asc_name, "___asc"))) && (match asc_ty {
          Some(TyName(tn)) => tn == "String",
          _ => false
        })
      } else {
        false
      }
    } else {
      cc_builtin_call_ret_kind(e, local_names, ctx) == 2
    }
  } else {
    false
  }
}

/// #784: is `e` statically — BY SHAPE — a Bool via an UNSHADOWABLE form? A bool
/// literal, a comparison / logical binary op, or a `!` unary. These lower directly
/// (operators bypass name resolution) so the classification is always correct.
/// Used to route `"\{b}"` / `__to_string(b)` to a "true"/"false" formatter instead
/// of the integer path (which prints 1/0, since Bool and Int share the tagged-int
/// runtime representation). Purely syntactic, like `cc_expr_is_floatish`.
///
/// #950: calls to bool-returning BUILTINS are now classified through
/// cc_builtin_call_ret_kind (see the tag-8 arm), which checks the same
/// user-shadow conditions the actual call emission honors via
/// `prefer_bound_call` — closing the gap #784 documented (a name-only match
/// would have misformatted a shadowed function's result; the shadow-aware
/// lookup does not). A bool bound to a local and then interpolated is covered
/// by the kind-3 slot log. Never fires for an integer expression, so the
/// pervasive `__to_string(<int>)` calls (lengths, offsets, ids) are untouched.
fn cc_expr_is_boolish(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with Exception {
  let tag = expr_tag(e)
  if tag == 1 {
    true
  } else if tag == 4 {
    // #769: a bare ident `let`-bound to a boolish value -- kind-3 entry in
    // ctx.int_local_slots (slot*4 + kind, see compile_expr_tail's
    // slot_is_intish). Closes the documented #785-P2 gap where
    // `let b = true; "\{b}"` printed the raw integer. Duplicated slot scan
    // (expr_is_boolish lives in compile_expr_tail, which imports this file --
    // importing back would be circular).
    let nm = get_eident_name(e)
    let mut i = Array::length(local_names) - 1
    let mut slot = -1
    while i >= 0 {
      if Array::get(local_names, i) == nm {
        slot = i
        i = -1
      } else {
        i = i - 1
      }
    }
    if slot >= 0 {
      let arr = ctx.int_local_slots
      let mut j = Array::length(arr) - 1
      let mut result = false
      while j >= 0 {
        let entry = Array::get(arr, j)
        if entry / 4 == slot {
          result = (entry % 4) == 3
          j = -1
        } else {
          j = j - 1
        }
      }
      result
    } else {
      false
    }
  } else if tag == 5 {
    let op = get_ebinop_op(e)
    op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&&" || op == "||"
  } else if tag == 6 {
    get_eunaryop_op(e) == "!"
  } else if tag == 16 {
    // #815: an `is` expression desugars at parse time to a match whose arms
    // all return Bool literals — classify such a match as boolish so
    // `"\{opt is None}"` prints true/false instead of the raw 0/1.
    // #825: arm bodies recurse through cc_expr_is_boolish (not just Bool
    // literals), because the structural `==` dispatch on Option/Result/tuple
    // lowers to nested matches whose leaf arms are `==`/`&&` chains and Bool
    // literals — so `"\{Some(1) == Some(1)}"` prints true, not 1.
    let arms = get_match_arms(e)
    let alen2 = Array::length(arms)
    if alen2 == 0 {
      false
    } else {
      let mut all_bool = true
      let mut bi2 = 0
      while bi2 < alen2 {
        if !cc_expr_is_boolish(get_arm_body(Array::get(arms, bi2)), local_names, ctx) {
          all_bool = false
        } else {
          ()
        }
        bi2 = bi2 + 1
      }
      all_bool
    }
  } else if tag == 9 {
    // #825: the normalize pass lifts a non-ident match scrutinee into
    // `let __m_scrut_N = <e> in match ...` (lift_match_scrutinees), so a
    // boolish match arrives here wrapped in a let — classify by the BODY.
    // Same for the other body-position wrappers below.
    cc_expr_is_boolish(get_elet_body(e), local_names, ctx)
  } else if tag == 10 {
    cc_expr_is_boolish(get_eletrec_body(e), local_names, ctx)
  } else if tag == 11 {
    cc_expr_is_boolish(get_eletmut_body(e), local_names, ctx)
  } else if tag == 14 {
    cc_expr_is_boolish(get_eseq_second(e), local_names, ctx)
  } else if tag == 7 {
    // An if-expression is boolish when BOTH branches are.
    cc_expr_is_boolish(get_eif_then(e), local_names, ctx) && cc_expr_is_boolish(get_eif_else(e), local_names, ctx)
  } else if tag == 8 {
    // #815: the `==` desugar rewrites array equality to the compiler-emitted
    // `__arr_equals__<key>` helper and struct/enum equality to `T::equals`
    // (both Bool-returning), so the EBinOp shape above is gone by codegen.
    // `__arr_equals__` is a reserved compiler prefix; `::equals` (2 args) is
    // the == rewrite's exact output shape. A `not(...)` wrap (the `!=`
    // rewrite's output) is classified only when its single argument is itself
    // boolish AND `not` is not locally shadowed (display-only risk, see the
    // expr_is_boolish twin in compile_expr_tail.vibe).
    let bcallee = get_ecall_callee(e)
    if is_eident(bcallee) {
      let bcn = get_eident_name(bcallee)
      String::starts_with(bcn, "__arr_equals__") || (String::ends_with(bcn, "::equals") && Array::length(get_ecall_args(e)) == 2) || (bcn == "not" && Array::length(get_ecall_args(e)) == 1 && find_local_slot(local_names, "not") < 0 && cc_expr_is_boolish(Array::get(get_ecall_args(e), 0), local_names, ctx)) || cc_builtin_call_ret_kind(e, local_names, ctx) == 1
    } else if is_efn(bcallee) && Array::length(get_ecall_args(e)) == 1 {
      // #815: `let x: Bool = e` parses to the ascription marker
      // `((__asc: Bool) -> __asc)(e)` (see parser_expr_dispatch's
      // ascribe_wrap) — honor the annotation so the binding's slot is logged
      // boolish even when `e` itself is opaque.
      // The SECOND and later ascriptions in one function arrive with the
      // param renamed to `__shadow_<n>___asc` (normalize's
      // uniquify_shadowed_bindings; per-function `seen` de-dup), so match
      // that renamed form too — otherwise only the first annotated let per
      // function was classified (#825 follow-up).
      let fparams = get_efn_params(bcallee)
      if Array::length(fparams) == 1 {
        let (asc_name, asc_ty) = Array::get(fparams, 0)
        (asc_name == "__asc" || (String::starts_with(asc_name, "__shadow_") && String::ends_with(asc_name, "___asc"))) && (match asc_ty {
          Some(TyName(tn)) => tn == "Bool",
          _ => false
        })
      } else {
        false
      }
    } else {
      false
    }
  } else {
    false
  }
}

/// #706: is `e` a bare reference to a value live-in to an enclosing loop (and not
/// a `mut` ref-cell, whose reassignment already manages its own drop)? Passing
/// such a value to a consuming (owning) parameter inside the loop frees it on the
/// first iteration; dup'ing at the call site keeps the loop-carried reference
/// alive across the back-edge. rc_dup is a no-op on scalars, so a scalar loop var
/// caught here costs only a wasted (guarded) dup, not a correctness problem.
export fn cc_is_loop_borrowed_ident(e: Expr, ctx: CompileCtx) -> Bool {
  match e {
    EIdent(name, _) =>
    array_contains_str(ctx.loop_borrowed_names, name) && !array_contains_str(ctx.ref_cell_names, name),
    _ => false
  }
}

/// Emit checked Map key-slot access without synthesizing source-visible calls.
/// The bounds check and trap must not resolve through user definitions of
/// `Map::size` or `Array::get`.
fn compile_map_iter_get_checked(buf: Bytes, map_expr: Expr, index_expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  let map_l = next_local
  let index_l = next_local + 1
  let len_l = next_local + 2
  // `[` cannot occur in a source identifier, so these slots cannot shadow
  // or be shadowed by user bindings during name-to-local lookup.
  Array::push(local_names, "[temp]__map_iter_get_map")
  Array::push(local_names, "[temp]__map_iter_get_index")
  Array::push(local_names, "[temp]__map_iter_get_len")
  let mut nl = next_local + 3
  nl = ce(buf, map_expr, local_names, nl, ctx, ld)
  emit_local_set(buf, map_l)
  nl = ce(buf, index_expr, local_names, nl, ctx, ld)
  emit_local_set(buf, index_l)
  emit_local_get(buf, map_l)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_local_set(buf, map_l)
  if ctx.enable_rc {
    emit_local_get(buf, index_l)
    emit_i64_const(buf, 1)
    emit_i64_shr_s(buf)
    emit_local_set(buf, index_l)
  } else {
    ()
  }
  emit_local_get(buf, map_l)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf, 2, 0)
  emit_i64_extend_i32_u(buf)
  emit_local_set(buf, len_l)
  emit_local_get(buf, index_l)
  emit_i64_const(buf, 0)
  emit_i64_lt_s(buf)
  emit_if_void(buf)
  bytebuf_push(buf, 0)
  emit_end(buf)
  emit_local_get(buf, index_l)
  emit_local_get(buf, len_l)
  emit_i64_ge_s(buf)
  emit_if_void(buf)
  bytebuf_push(buf, 0)
  emit_end(buf)
  emit_local_get(buf, map_l)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf, index_l)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 16)
  emit_i32_mul(buf)
  emit_i32_add(buf)
  emit_i64_load(buf, 3, 8)
  nl
}

/// The borrowed-parameter mask for a call to top-level fn `fname`: the
/// authoritative source/user mask when present, otherwise the builtin mask.
/// Lexical shadowing is handled by the caller (the #875 local_idx_hint guard
/// already routes a shadowed name elsewhere).
fn cc_borrow_mask(ctx: CompileCtx, fname: String) -> Int {
  md_borrow_mask_of(fname, ctx.borrow_param_user, ctx.borrow_param_mask)
}

fn cc_bmask_has(mask: Int, i: Int) -> Bool {
  i >= 0 && i < 32 && ((mask>>i)&1) == 1
}

/// #745: retain a borrowed argument that a STORING inline builtin (Map::set /
/// MapBuilder::set key+value) keeps a reference to. The generic owning-call
/// path already dups projection / borrow-returning-call / loop-borrowed args
/// (see the `__argdup` sites below), but the inline-emitted builtins compile
/// their args directly and skipped it — json's `build_json_map` stored
/// `Array::get(vals, i)` un-retained, and once `vals` died the map's entry
/// pointed at freed memory (ctor match on `Map::get` then read garbage).
/// Expects the freshly compiled arg on the wasm stack; leaves it there.
fn cc_retain_stored_arg(buf: Bytes, carg: Expr, local_names: Array[String], nl: Int, ctx: CompileCtx) -> Int with Exception {
  let is_loop_borrow = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx)
  if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow) {
    // #706 leak follow-up: a loop-borrowed trigger needs the epilogue's
    // compensating drop, same as the generic path's `__argdup` sites.
    if is_loop_borrow {
      Array::push(ctx.loop_consumed_names, get_eident_name(carg))
    } else {
      ()
    }
    Array::push(local_names, "__argdup")
    emit_local_tee(buf, nl)
    emit_rc_dup_guarded(buf, nl, ctx.rc_shadow, ctx.rc_dup_func_idx)
    nl + 1
  } else {
    nl
  }
}

/// #664/#678: is `e` statically — BY SHAPE — a known integer that must NOT be run
/// through `__to_string`'s string-pointer heuristic (which misreads a large int
/// as an empty string)? An Int literal, or a bitwise/shift/mod expression (those
/// operators are never float or string). Bare idents are deliberately excluded:
/// a per-slot "is int" log is unsound because slots are reused across scopes
/// without updating it. Covers `"\{1 << 40}"` and integer-literal interpolation.
fn ts_known_int(e: Expr, local_names: Array[String], ctx: CompileCtx) -> Bool with Exception {
  let tag = expr_tag(e)
  if tag == 0 {
    true
  } else if tag == 5 {
    let op = get_ebinop_op(e)
    op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" || op == "%"
  } else if tag == 6 {
    // #2344: `~` is Int by construction, and its result is exactly the shape
    // the runtime string-pointer heuristic misreads -- `~((0 - (64 << 32)) - 1)`
    // has a zero low word, so `__to_string` rendered it as the empty string.
    // Unary `-` stays out: it may be a float negation, which the floatish
    // branch above already routes to the Double formatter.
    get_eunaryop_op(e) == "~"
  } else if tag == 8 {
    // #769 (#664 follow-up): a DIRECT call to a known Int-returning builtin is
    // statically an Int -- force the integer path. The #664 runtime bound
    // (`ptr + len <= memory_size`) is load-dependent: once the process has
    // grown to hundreds of MB (a cold full-closure FS compile), a 61-bit
    // `Fs::stat_token` hash whose high word lands below memory_size and whose
    // low word keeps ptr+len in bounds passes the string-pointer heuristic and
    // is emitted as GARBAGE BYTES (observed: a deterministic ~100MB
    // persistent-source-groups cache row for one specific file, "invalid
    // persistent source group cache group row" on re-read). The bound can
    // never be airtight for 61-bit hashes; static knowledge is.
    match get_ecall_callee(e) {
      EIdent(cn, _) => cn == "Fs::stat_token" || cn == "vibe_fs_stat_token_raw" || cn == "Profiler::now_us" || cn == "Profiler::heap_bytes" || cn == "Env::args_len" || cn == "String::length" || cn == "Array::length" || cn == "Bytes::length" || cn == "String::char_code_at" || cn == "String::index_of" || cn == "String::last_index_of" || cn == "Stdin::read_char",
      _ => false
    }
  } else {
    false
  }
}

/// A synthesized `EString` literal is NOT in the compile unit's string table
/// (same constraint double_to_string_expr documents) — a flag label is only
/// known at codegen time, so it can't have been pre-interned like a literal
/// from the original source. Build it char-by-char via `String::from_char_code`
/// + `String::concat` instead, exactly like double_to_string_expr's `ch_minus`
/// / `ch_dot` pieces. `s` must be non-empty (callers only pass " -<label>").
/// #1230 (docs/spec/wasi-p3-async.md M1b-3b→M1b-3c): the runtime shape of
/// `Future[T]` — the two-element array `[state, payload]`.
///
/// Slot 0 is the state, slot 1 the value. Only `ready` (0) exists today: every
/// in-tree future source (`Future::ready` and
/// user code that returns `Future[T]` by calling `Future::ready`) resolves
/// eagerly, so `await` reads slot 1 unconditionally. Carrying the state slot
/// now is what lets a PENDING source be added without a second representation
/// change: `await` grows a branch on slot 0 instead of a new memory layout.
///
/// The previous encoding was the payload itself (`await` and `Future::ready`
/// both compiled to the identity), which left no room to distinguish the two.
fn future_state_ready() -> Int {
  0
}

/// A ready `Future[T]` carrying `payload` — synthesized as ordinary source so
/// the array follows the same (RC) value conventions as any other literal.
fn future_ready_expr(payload: Expr) -> Expr {
  EArray([EInt(future_state_ready()), payload])
}

/// ADR-0089 (c) (#1218): the raw-builtin name that carries a NAMED host
/// future's component import name. One name = one core import
/// (`vibe.host_future_get$<name>`) = one component import, so the suffix is
/// part of the callee name rather than a runtime argument. Shared with
/// linked_compile (import reservation + registration) and component_codegen
/// (import-name recovery) through this one spelling.
export fn cc_host_future_named_raw_prefix() -> String {
  "vibe_hf_get_raw$"
}

/// ADR-0089 Decision 3 (#1218): the stream sibling of
/// cc_host_future_named_raw_prefix -- the raw-builtin name that carries a
/// NAMED host stream's component import name. One name = one core import
/// (`vibe.host_stream_get$<name>`) = one component import. Shared with
/// linked_compile (import reservation + registration) and component_codegen
/// (import-name recovery) through this one spelling.
export fn cc_host_stream_named_raw_prefix() -> String {
  "vibe_hs_get_raw$"
}

/// A component import name must be a lower kebab-case identifier
/// (`[a-z][a-z0-9-]*`) -- the component-model's own `label` shape, and what
/// keeps the derived core import name unambiguous when component_codegen
/// splits it back off at the `$`.
fn cc_is_valid_host_future_name(s: String) -> Bool {
  let n = String::length(s)
  if n == 0 {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while i < n {
      let c = String::char_code_at(s, i)
      let is_lower = c >= 97 && c <= 122
      let is_digit = c >= 48 && c <= 57
      let is_dash = c == 45
      let allowed = if i == 0 {
        is_lower
      } else {
        is_lower || is_digit || is_dash
      }
      if !allowed {
        ok = false
      } else {
        ()
      }
      i = i + 1
    }
    ok
  }
}

fn uninterned_string_expr(s: String, i: Int) -> Expr {
  let ch = ECall(EIdent("String::from_char_code", -1), [
    EInt(String::char_code_at(s, i))
  ], -1)
  if i >= String::length(s) - 1 {
    ch
  } else {
    ECall(EIdent("String::concat", -1), [ch, uninterned_string_expr(s, i + 1)], -1)
  }
}

/// #777: `sh_lines(cmd, flag1 = boolExpr1, flag2 = boolExpr2, ...)` — extra
/// labeled boolean args (beyond the command string) become `-<label>`
/// appended to the command when the labeled expression is true, so callers
/// can write `sh_lines("ls", a = true)` instead of building the flag string
/// by hand. NOTE: argument labels are NOT part of a general keyword-argument
/// feature here — labels are purely decorative for ordinary calls (args
/// still bind positionally), so this reads the literal label text directly
/// off the `ELabeledArg` AST node rather than relying on any label-based
/// rebinding machinery (there isn't one).
fn sh_lines_flag_cmd(acc: Expr, args: Array[Expr], i: Int) -> Expr {
  if i >= Array::length(args) {
    acc
  } else {
    let next_acc = match Array::get(args, i) {
      ELabeledArg(label, _, cond) => EIf(cond, ECall(EIdent("String::concat", -1), [
        acc,
        uninterned_string_expr(String::concat(" -", label), 0)
      ], -1), acc),
      _ => acc
    }
    sh_lines_flag_cmd(next_acc, args, i + 1)
  }
}

/// ADR-0090's sanctioned region exits, lowered as a real COPY out of the
/// list's storage rather than the identity cast the rest of the FrozenArray
/// surface uses.
///
/// `FrozenArray::from_array` / `to_array` are pure identity casts
/// (docs/compiler-parallelism.md) -- the Frozen claim is type-level, and the
/// caller is trusted not to keep mutating the source. `MutList` cannot borrow
/// that convention, for two reasons:
///
/// 1. **It is already observably wrong.** `let out = MutList::freeze(l);
///    MutList::push(l, 3); out` sees the 3 -- a `FrozenArray` that changes
///    under you, which is the silent-wrong direction. The list handle is
///    still in scope at the exit, unlike the consuming builder idiom
///    `ArrayBuilder::freeze` was written for.
/// 2. **The arena needs it.** ADR-0090's release is a watermark reset over
///    the whole region segment. An identity cast hands the caller a pointer
///    INTO that segment, so the escaping value would dangle the moment the
///    arena slice lands. "Escape only via freeze / copy-out" is exactly this
///    copy; without it there is no sound release point.
///
/// The value is bound to a temp first so an effectful argument
/// (`MutList::freeze(make_list(r))`) is evaluated once, not twice.
fn mutlist_exit_copy(arg: Expr) -> Expr {
  array_value_copy(ECall(EIdent("ArrayBuilder::freeze", -1), [arg], -1), "__mutlist_exit")
}

/// ADR-0090 MutBytes: `MutBytes::to_bytes(mb)` -- the copy-out exit, for the
/// same two reasons as mutlist_exit_copy above (an alias would observe later
/// pushes, and the arena release would dangle it). `Bytes::slice(tmp, 0,
/// Bytes::length(tmp))` allocates the copy via `Bytes::new`, which is always
/// a main-heap bump, so the escaping value never points into the arena. The
/// value is bound to a temp so an effectful argument is evaluated once.
fn mutbytes_exit_copy(arg: Expr) -> Expr {
  let tmp = "__mutbytes_exit"
  ELet(tmp, arg, ECall(EIdent("Bytes::slice", -1), [
    EIdent(tmp, -1),
    EInt(0),
    ECall(EIdent("Bytes::length", -1), [EIdent(tmp, -1)], -1)
  ], -1), -1)
}

/// `Array::slice(v, 0, Array::length(v))` -- a fresh array with the same
/// elements. The value is bound to `tmp` first so an effectful argument is
/// evaluated once, not twice.
fn array_value_copy(value: Expr, tmp: String) -> Expr {
  ELet(tmp, value, ECall(EIdent("Array::slice", -1), [
    EIdent(tmp, -1),
    EInt(0),
    ECall(EIdent("Array::length", -1), [EIdent(tmp, -1)], -1)
  ], -1), -1)
}

/// #1733: `FrozenArray[T]` is not merely "an immutable array" -- it is a
/// member of the Send allowlist (ADR-0082 / ADR-0068 / #906), and the reason
/// it is Send-eligible is that it cannot change. Both of its conversions were
/// pure identity casts (docs/compiler-parallelism.md), so that claim did not
/// hold in either direction:
///
///   from_array: `let f = FrozenArray::from_array(a)` then `Array::push(a, x)`
///               changes `f`.
///   to_array:   `let o = FrozenArray::to_array(f)` then `Array::push(o, x)`
///               changes `f`.
///
/// Fixing only one of the two leaves the contract broken through the other,
/// so both copy. `get` / `length` stay aliases of the Array bodies: they read,
/// and reading cannot break immutability.
///
/// The cost is real -- freezing is now O(n) -- but it is paid only at the
/// Frozen boundary. `ArrayBuilder::freeze` is untouched, so the
/// build-then-freeze hot path (1,953 call sites in the compiler) is
/// unaffected.
fn frozen_array_conversion_copy(name: String) -> String {
  if name == "FrozenArray::from_array" {
    "__frozen_in"
  } else if name == "FrozenArray::to_array" {
    "__frozen_out"
  } else {
    ""
  }
}

/// ADR-0090 Phase 1 arity rewrites, applied before the main dispatch:
/// - `__region_run(lam)` (the reserved lowering of `region r { body }`)
///   runs the body closure immediately with a dummy region token (0). The
///   token only exists for the checker's skolem escape scan; it has no
///   runtime representation. When the module has an arena
///   (`ctx.region_ptr_addr >= 0`), the call is bracketed by the arena
///   watermark save/restore, including the #1937 try_table catch so a
///   throw still runs exit then rethrows.
/// - `MutList::empty(r)` allocates a fresh growable array, ignoring the
///   region token argument. The token is not evaluated: by construction it
///   is the pure region binder ident the parser emitted. With an arena it
///   comes from the segment; without one it is `ArrayBuilder::new` as before.
/// - `MutList::push(l, v)` needs no rewrite: it still aliases
///   `ArrayBuilder::push`, whose body decides the regrow lane by asking
///   whether the ARRAY's block is inside the arena segment. Which lane is a
///   property of the array, not of the call site.
/// - `MutList::freeze(l)` / `MutList::to_array(l)` copy out -- see
///   `mutlist_exit_copy` for why these two do not share the identity cast,
///   and why the arena has no sound release point without them.
export fn compile_call(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  if is_eident(callee) && get_eident_name(callee) == "__region_run" && Array::length(args) == 1 {
    if ctx.region_ptr_addr >= 0 {
      emit_region_enter(buf, ctx.region_ptr_addr)
      if ctx.region_exn_tag >= 0 {
        emit_region_try_prologue(buf, ctx.region_exn_tag)
        let r = ce(buf, ECall(Array::get(args, 0), [EInt(0)], -1), local_names, next_local, ctx, region_try_body_ld(ld))
        emit_region_try_epilogue(buf, ctx.region_ptr_addr, ctx.region_exn_tag)
        r
      } else {
        let r = ce(buf, ECall(Array::get(args, 0), [EInt(0)], -1), local_names, next_local, ctx, ld)
        emit_region_exit(buf, ctx.region_ptr_addr)
        r
      }
    } else {
      ce(buf, ECall(Array::get(args, 0), [EInt(0)], -1), local_names, next_local, ctx, ld)
    }
  } else if is_eident(callee) && get_eident_name(callee) == "MutList::empty" && Array::length(args) == 1 {
    if ctx.region_arr_new_func_idx >= 0 {
      emit_call(buf, ctx.region_arr_new_func_idx)
      next_local
    } else {
      let no_args = Array::slice([EInt(0)], 0, 0)
      ce(buf, ECall(EIdent("ArrayBuilder::new", -1), no_args, -1), local_names, next_local, ctx, ld)
    }
  } else if is_eident(callee) && (get_eident_name(callee) == "MutList::freeze" || get_eident_name(callee) == "MutList::to_array") && Array::length(args) == 1 {
    ce(buf, mutlist_exit_copy(Array::get(args, 0)), local_names, next_local, ctx, ld)
  } else if is_eident(callee) && get_eident_name(callee) == "MutBytes::empty" && Array::length(args) == 1 {
    if ctx.region_bytes_new_func_idx >= 0 {
      emit_call(buf, ctx.region_bytes_new_func_idx)
      next_local
    } else {
      let no_args = Array::slice([EInt(0)], 0, 0)
      ce(buf, ECall(EIdent("Bytes::new", -1), no_args, -1), local_names, next_local, ctx, ld)
    }
  } else if is_eident(callee) && get_eident_name(callee) == "MutBytes::to_bytes" && Array::length(args) == 1 {
    ce(buf, mutbytes_exit_copy(Array::get(args, 0)), local_names, next_local, ctx, ld)
  } else if is_eident(callee) && frozen_array_conversion_copy(get_eident_name(callee)) != "" && Array::length(args) == 1 && func_table_index_of(ctx.func_table, get_eident_name(callee)) >= 0 && !array_contains_str(local_names, get_eident_name(callee)) {
    ce(buf, array_value_copy(Array::get(args, 0), frozen_array_conversion_copy(get_eident_name(callee))), local_names, next_local, ctx, ld)
  } else if is_eident(callee) && get_eident_name(callee) == "Map::iter_get" && Array::length(args) == 2 && func_table_index_of(ctx.func_table, "Map::iter_get") < 0 && !array_contains_str(local_names, "Map::iter_get") {
    compile_map_iter_get_checked(buf, Array::get(args, 0), Array::get(args, 1), local_names, next_local, ctx, ld, ce)
  } else {
    compile_call_core(buf, callee, args, local_names, next_local, ctx, ld, ce)
  }
}

fn http_client_surface_to_raw(name: String) -> String {
  match name {
    "Http::request" => "vibe_http_request_raw",
    "Http::response_status" => "vibe_http_response_status_raw",
    "Http::response_header" => "vibe_http_response_header_raw",
    "Http::response_body" => "vibe_http_response_body_raw",
    "Http::close" => "vibe_http_close_raw",
    _ => ""
  }
}

fn compile_call_core(buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with Exception) -> Int with Exception {
  if is_eident(callee) {
    let source_name = get_eident_name(callee)
    // Builtin aliases are source-compatible fallbacks, not reserved names.
    // Preserve the same shadowing rule as the checker: resolve the original
    // spelling first, and canonicalize only when no function/local binds it.
    let source_is_bound = func_table_index_of(ctx.func_table, source_name) >= 0 || array_contains_str(local_names, source_name)
    let fname00 = if source_is_bound {
      source_name
    } else {
      canonical_builtin_name(source_name)
    }
    // #1508 second barrier: the five CLIENT-side `Http::*` builtins are
    // checker-legal as direct spellings (checker/builtins_net.vibe), but only
    // the raw dunder names lib/@vibe/http calls internally (#794) had codegen
    // wiring -- a bare file calling `Http::request(..)` died here with
    // "reached code generation unresolved". Lower the direct spellings onto
    // the very same host imports. Guarded on the name not resolving to
    // anything real: a unit bundling lib/@vibe/http binds these names to its
    // value aliases (`export let Http::request = request`, #795), and a bound
    // name must keep winning. Server-side ops (listen/accept/respond/...)
    // stay perform-based and are NOT aliased.
    let http_raw = http_client_surface_to_raw(fname00)
    let fname0 = if String::length(http_raw) > 0 && func_table_index_of(ctx.func_table, fname00) < 0 && !array_contains_str(local_names, fname00) {
      http_raw
    } else {
      fname00
    }
    // #1538: the eager `Stream::empty` / `once` / `map` / `filter` / `fold`
    // aliases used to live here, backed by the Array machinery. They are
    // retired -- ADR-0089 Decision 3 makes AsyncIter the one iteration story.
    // The nominal `ByteStream` conversion pair keeps its own branches below.
    //
    // ADR-0090 Phase 1: MutList[T, r] is a checker-only phantom over the
    // same growable-array runtime layout ArrayBuilder uses, so push aliases
    // ArrayBuilder::push. `MutList::empty` / `freeze` / `to_array` and
    // `__region_run` are rewritten in compile_call before dispatching here --
    // in particular the two exits COPY (mutlist_exit_copy) instead of
    // aliasing, so these freeze rows are only a fallback for a call that got
    // past the checker with the wrong arity.
    let fname = if fname0 == "MutList::push" {
      "ArrayBuilder::push"
    } else if fname0 == "MutList::freeze" {
      "ArrayBuilder::freeze"
    } else if fname0 == "MutList::to_array" {
      "ArrayBuilder::freeze"
    } else if fname0 == "MutList::get" {
      "Array::get"
    } else if fname0 == "MutList::length" {
      "Array::length"
    } else if fname0 == "MutList::truncate" {
      "Array::truncate"
    } else if fname0 == "MutBytes::push" {
      "Bytes::push"
    } else if fname0 == "MutBytes::append" {
      "Bytes::append"
    } else if fname0 == "MutBytes::length" {
      "Bytes::length"
    } else {
      fname0
    }
    let fn_idx_in_list = func_table_index_of(ctx.func_table, fname)
    let mut local_idx_hint = -1
    let mut li = Array::length(local_names) - 1
    while li >= 0 {
      if Array::get(local_names, li) == fname {
        local_idx_hint = li
        li = -1
      } else {
        li = li - 1
      }
    }
    let prefer_bound_call = fn_idx_in_list >= 0 || local_idx_hint >= 0
    let ctor_lookup_idx = ctor_table_index_of(ctx.ctor_table, fname)
    if ctor_lookup_idx >= 0 {
      let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)
      let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)
      let ptr_local = next_local
      Array::push(local_names, "__ctor_ptr")
      let actual_args = if Array::length(args) == 1 {
        match Array::get(args, 0) {
          ERecord(_, rec_fields, _) => {
            let mut si2 = 0
            let mut sn_idx = -1
            while si2 < Array::length(ctx.ctor_table.struct_names) {
              if Array::get(ctx.ctor_table.struct_names, si2) == fname {
                sn_idx = si2
                si2 = Array::length(ctx.ctor_table.struct_names)
              } else {
                si2 = si2 + 1
              }
            }
            if sn_idx >= 0 {
              let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)
              let ordered = array_empty()
              let mut oi = 0
              while oi < Array::length(def_fnames) {
                let target_name = Array::get(def_fnames, oi)
                let mut ri = 0
                let mut found_rfv = EUnit
                while ri < Array::length(rec_fields) {
                  let (rfn, rfv) = Array::get(rec_fields, ri)
                  if rfn == target_name {
                    found_rfv = rfv
                    ri = Array::length(rec_fields)
                  } else {
                    ri = ri + 1
                  }
                }
                Array::push(ordered, found_rfv)
                oi = oi + 1
              }
              ordered
            } else {
              args
            }
          },
          _ => args
        }
      } else {
        args
      }
      if ctx.enable_rc {
        let total = 16 + fc * 8
        emit_i64_const(buf, total)
        emit_call(buf, ctx.rc_alloc_func_idx)
        emit_local_set(buf, ptr_local)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, total)
        emit_i32_store(buf, 2, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 1)
        emit_i32_store(buf, 2, 4)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 1)
        emit_i32_store8(buf, 0, 7)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, tag)
        emit_i32_store(buf, 2, 8)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, fc)
        emit_i32_store(buf, 2, 12)
        let mut nl_c = next_local + 1
        let mut fi_c = 0
        while fi_c < Array::length(actual_args) {
          let carg_c = Array::get(actual_args, fi_c)
          nl_c = ce(buf, carg_c, local_names, nl_c, ctx, ld)
          let val_local = nl_c
          Array::push(local_names, "__ctor_val")
          emit_local_set(buf, val_local)
          nl_c = nl_c + 1
          // A heap field projection `a.f` stored into a constructor is a borrow;
          // the constructed value OWNS its fields (drop class 1 recurses), so
          // retain it or the source's drop double-frees it (e.g. `Some(b.items)`
          // returned while `b` is dropped). Mirrors the ERecord field-store dup
          // (#704). Perceus emits no action for bare projections.
          // #715: also retain a bare-ident arg whose binding is borrow-bound or
          // loop-borrowed (cc_is_loop_borrowed_ident) -- same gap as the ETuple
          // case in compile_expr_tail2.vibe (see the comment there).
          if ctx.enable_rc && (cc_is_projection(carg_c) || cc_is_borrow_ret_call(carg_c, ctx) || cc_is_loop_borrowed_ident(carg_c, ctx)) {
            emit_rc_dup_guarded(buf, val_local, ctx.rc_shadow, ctx.rc_dup_func_idx)
          } else {
            ()
          }
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, val_local)
          emit_i64_store(buf, 3, 16 + fi_c * 8)
          fi_c = fi_c + 1
        }
        emit_local_get(buf, ptr_local)
        emit_i64_const(buf, 8)
        emit_i64_add(buf)
        emit_i64_const(buf, 1)
        emit_i64_or(buf)
        nl_c
      } else {
        let obj_size = 8 + fc * 8
        emit_global_get(buf, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, ptr_local)
        emit_global_get(buf, 0)
        emit_i32_const(buf, obj_size)
        emit_i32_add(buf)
        emit_global_set(buf, 0)
        emit_heap_grow_after_heap_set(buf, ctx)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, tag)
        emit_i32_store(buf, 2, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, fc)
        emit_i32_store(buf, 2, 4)
        let mut nl_c = next_local + 1
        let mut fi_c = 0
        while fi_c < Array::length(actual_args) {
          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ctx, ld)
          let val_local = nl_c
          Array::push(local_names, "__ctor_val")
          emit_local_set(buf, val_local)
          nl_c = nl_c + 1
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, val_local)
          emit_i64_store(buf, 3, 8 + fi_c * 8)
          fi_c = fi_c + 1
        }
        emit_local_get(buf, ptr_local)
        emit_i64_const(buf, 1)
        emit_i64_or(buf)
        nl_c
      }
    }
    else if fname == "eq" && Array::length(args) == 2 && local_idx_hint < 0 && ctx.enable_rc && (cc_expr_is_floatish(Array::get(args, 0), local_names, ctx) || cc_expr_is_floatish(Array::get(args, 1), local_names, ctx)) && func_table_user_index_of(ctx.func_table, fname, ctx.num_user_funcs) < 0 {
      // #745: under RC floats are BOXED — the scalar i64.eq below would
      // compare box pointers, so `eq(0.0125, 0.0125)` returned false. Take
      // the same unbox + f64.eq path the `==` binop uses. Non-RC floats are
      // raw f64 bits in an i64, where bitwise i64.eq matches the existing
      // `==` behavior, so this branch is RC-only.
      //
      // #2309: `local_idx_hint < 0` for the same reason as the scalar arm
      // below -- and this arm had NO guard at all, so it was the sharper of
      // the two: `let eq = (a: Double, b: Double) -> Double { a + b }` then
      // `eq(1.5, 2.5)` printed `0` under RC, which is the production lane.
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_unbox_float(buf)
      emit_f64_reinterpret_i64(buf)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_unbox_float(buf)
      emit_f64_reinterpret_i64(buf)
      emit_f64_eq(buf)
      emit_i64_extend_i32_s(buf)
      // Tag the Bool like the scalar branch below (ADR-0055).
      emit_i64_const(buf, 1)
      emit_i64_shl(buf)
      nl
    }
    else if fname == "eq" && Array::length(args) == 2 && local_idx_hint < 0 && (!prefer_bound_call || cc_arg_is_scalarish(Array::get(args, 0)) || cc_arg_is_scalarish(Array::get(args, 1))) && func_table_user_index_of(ctx.func_table, fname, ctx.num_user_funcs) < 0 {
      // Direct i64.eq for `eq(a, b)` when it is the builtin and at least one
      // operand is provably scalar. This sidesteps the bound `eq`'s string
      // fallback, which reads OOB on Int values resembling fat-pointers (#705):
      // `==` already dispatches intish operands this way via emit_eq_value, and
      // `eq` must match. A genuinely string/heap `eq` (no scalar operand) still
      // falls through to the bound call below.
      //
      // #710/#711: keeping the scalarish disjunct (not just !prefer_bound_call)
      // is required -- prefer_bound_call is a global cross-file name match, not
      // scoped to the calling file (see #711), so dropping it regressed
      // leb128_test.vibe. Root fix tracked in #711.
      //
      // #2309: but that disjunct let the builtin beat a LEXICAL binding too,
      // and there it is simply wrong: `let eq = (a: Int, b: Int) -> Int { a + b }`
      // then `eq(1, 2)` compiled to `i64.eq` and printed `0`. No diagnostic,
      // no trap -- the checker had already typed the call against the user's
      // `eq` and agreed it was an `Int`.
      //
      // `local_idx_hint < 0` splits the two readings of `prefer_bound_call`
      // apart. `fn_idx_in_list` is the over-broad half #711 is about (a name
      // match against the whole program's function table, not the calling
      // file), and it is still consulted exactly as before -- leb128_test.vibe
      // keeps taking the inline path. `local_idx_hint` is a lexical binding in
      // THIS closure's local names, which is unambiguous, so it wins.
      //
      // That covers a LEXICAL binding only. A top-level `fn eq(a: Int, b: Int)
      // -> Int { a + b }` leaves `local_idx_hint` at -1, so `eq(1, 2)` still
      // printed `0` (Codex review on #2312). `fn_idx_in_list` cannot decide it
      // either: `eq` is in the linear func table unconditionally, so that index
      // is >= 0 for EVERY call whether or not anyone defined one -- which is
      // precisely why the scalarish disjunct had to exist.
      //
      // `func_table_user_index_of` is the missing distinction, and it is the
      // one #711 asks for: a definition belonging to THIS program, told from a
      // generated builtin positionally (user entries are the table's prefix)
      // rather than by name. Last in the condition so the scan runs only when
      // the arm would otherwise claim the call.
      //
      // Reading `local_idx_hint` at all is only sound for a name the capture
      // scan cannot invent (#1095, and see the `assert` arms below). `eq` is
      // in the LINEAR and gc func tables unconditionally
      // (core/builtin_registry.vibe), so `collect_free_vars_expr_sc`'s
      // `fn_names` guard skips it and no lambda records a phantom capture for
      // it. That is why it needs no `is_inlined_scalar_builtin` registration.
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_eq(buf)
      emit_i64_extend_i32_s(buf)
      // ADR-0055: under RC a Bool is a TAGGED scalar (true = 1<<1). The raw
      // i64.eq result is 0/1 (untagged); tag it so `eq(..) == true`/`if`/derived
      // comparisons see the same representation as a bool literal (#705 — without
      // this, `eq(a,b) == true` compared untagged 1 against tagged 2 and failed).
      // The bump backend leaves bools untagged, so only shift under RC.
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      } else {
        ()
      }
      nl
    }
    else if Array::length(args) == 1 && (cc_expr_is_floatish(Array::get(args, 0), local_names, ctx) || cc_expr_is_boolish(Array::get(args, 0), local_names, ctx) || cc_expr_is_stringish(Array::get(args, 0), local_names, ctx)) && fname == namespace_exported_name("lib/@vibe/builtin/builtin_traits.vibe", "to_string") {
      // #1015: the prelude generic wrapper `to_string[T: Show](x: T) -> String
      // { __to_string(x) }` (lib/@vibe/builtin/builtin_traits.vibe) compiles
      // to exactly ONE shared wasm function body -- there is no
      // monomorphization pass that duplicates a generic function body per
      // instantiation. Inside that body `x` is a bare parameter of the
      // opaque type param T, so the `__to_string` builtin lowering below --
      // which classifies its argument via the syntactic cc_expr_is_floatish/
      // boolish/stringish checks -- can never recognize `x` as Bool/Float/
      // String there; it always falls to the generic runtime bit-pattern
      // heuristic. `Show` is a marker-only trait (never declared with method
      // signatures, so #641's dictionary-passing desugar -- which only
      // handles method-bearing traits -- never synthesizes a runtime witness
      // for it) and Bool has NO runtime tag distinguishing it from Int:
      // `true`/`false` compile to raw i64 1/0 (linear) or tagged 2/0 (RC),
      // bit-identical to Int 1/0 in both backends. So the runtime heuristic
      // cannot possibly classify a Bool argument reached this way -- it
      // silently mis-stringifies `true` as `"1"` (confirmed via a standalone
      // repro: the generic fallback itself does not crash for input 0/1, it
      // just returns the wrong string; the reported "RuntimeError:
      // unreachable" is `assert(to_string(true) == "true")` failing on that
      // wrong value and THEN trapping).
      //
      // Fix: at the CALL SITE `to_string(arg)`, the ORIGINAL argument
      // expression is still visible (unlike inside the generic body), so
      // when it is statically classifiable by the same cc_expr_is_* checks
      // the `__to_string` builtin uses, bypass the generic `to_string`
      // function call entirely and inline it as `__to_string(arg)` directly
      // -- hitting the correct existing static fast path. This is purely
      // additive: a call whose argument is NOT statically classifiable
      // (e.g. forwarding another opaque generic parameter) still falls
      // through unchanged to the ordinary bound call below.
      //
      // `fname` is essentially NEVER the bare `"to_string"` at this point:
      // #716 export-name visibility renames every exported value def of a
      // non-entry file to `name_exp_<sanitized path>` (namespace_exported_name,
      // lib/@vibe/compiler/core/import_alias_rewrite.vibe) and rewrites every
      // importer's reference to match, so a call to the prelude's `to_string`
      // (defined in lib/@vibe/builtin/builtin_traits.vibe, a non-entry file)
      // arrives here as `to_string_exp_lib__vibe_prelude_builtin_traits_vibe`
      // -- verified with throw()-based instrumentation. A prior fix attempt
      // for this issue special-cased only the bare name (fname equal to the
      // plain string "to_string") and was silently dead code because it
      // never fired for this reason.
      //
      // This match is intentionally the EXACT mangled name (via
      // `namespace_exported_name` -- the SAME function the renaming pass
      // itself uses, not a hand-copied string literal), not a bare-name or
      // prefix match: an earlier version of this fix matched fname against
      // either the bare "to_string" or, via String::starts_with, anything
      // prefixed "to_string_exp_", which was unsound -- code review (#1015)
      // correctly pointed out that
      // (a) the bare form also matches a user's OWN `to_string` defined
      // directly in an entry file (never renamed, so indistinguishable from
      // the prelude's by name alone), and (b) the prefix form also matches
      // ANY other file's own exported `to_string` (e.g. a user module
      // exporting `to_string`, mangled to `to_string_exp_<that file's own
      // sanitized path>`), silently overriding either user function's real
      // behavior with the Bool/Float/String formatter. The exact mangled
      // name embeds the full defining-file path, so it can only ever refer
      // to THIS specific prelude definition. Guarding with `!prefer_bound_call`
      // instead (as sibling `not`/`eq` branches above do) does NOT work here
      // and was tried and rejected: unlike `not`/`eq`, which are pure
      // compiler-provided fallbacks with no real backing definition unless a
      // user shadows them, `to_string` ALWAYS resolves to a real declared
      // function (the prelude's own, if nothing else) -- so `prefer_bound_call`
      // is unconditionally true even for the correct, un-shadowed prelude
      // call (confirmed with throw()-based instrumentation: `prefer_bound_call
      // = T` at the real failing call site), and gating on `!prefer_bound_call`
      // would make this branch never fire at all.
      //
      // Condition order matters here (selfcompile KPI heap regression found
      // during review): `namespace_exported_name(...)` builds a fresh string
      // via StringBuilder on every call, and this bump-allocated compiler
      // never reclaims that memory mid-compile, so evaluating it FIRST --
      // as the original version of this branch did -- ran it once per
      // ECall node in the ENTIRE compiled program (this `else if` chain is
      // walked for every function call), not just once per `to_string`
      // call. `&&` short-circuits (desugars to `if`, see docs/cheatsheet.md),
      // so putting the cheap arity check and the shape-based
      // floatish/boolish/stringish classification first means the
      // allocating name comparison only runs for the rare 1-arg calls whose
      // argument is already known-classifiable -- functionally identical
      // result, far fewer StringBuilder allocations across a whole compile.
      ce(buf, ECall(EIdent("__to_string", -1), [Array::get(args, 0)], -1), local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "not" {
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_i64_eqz(buf)
      emit_i64_extend_i32_s(buf)
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      } else {
        ()
      }
      nl
    }
    else if fname == "Double::from_i64_bits" {
      // The linear value ABI carries Double as raw f64 bits in an i64 (boxed
      // under RC). This builtin is therefore an inline representation
      // conversion, not a function-table call. Keeping it inline also means a
      // closure body cannot accidentally capture and call a nonexistent
      // first-class builtin slot (#1805).
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shr_s(buf)
        Array::push(local_names, "__from_bits_raw")
        Array::push(local_names, "__from_bits_box")
        emit_box_float(buf, ctx, nl, nl + 1)
        nl + 2
      } else {
        nl
      }
    }
    else if !prefer_bound_call && fname == "await" {
      // M1b-3b (docs/spec/wasi-p3-async.md): a `Future[T]` is the two-element
      // array `[state, payload]` (future_state_ready() = 0), so awaiting a
      // ready future reads slot 1. The state slot exists so a PENDING future
      // (a suspending source: host async import, spawned subtask) can be told
      // apart here without changing the representation again -- lowering that
      // arm to a suspend is M1b-3c.
      ce(buf, ECall(EIdent("Array::get", -1), [Array::get(args, 0), EInt(1)], -1), local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "Future::ready" {
      // Future::ready(x) is the already-resolved future carrying x. See the
      // `await` branch above for the representation.
      ce(buf, future_ready_expr(Array::get(args, 0)), local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "Future::pending" {
      // #1230: an UNRESOLVED future -- state 1, payload slot reserved. The
      // await hoist (await_poll_pass) sees a non-zero state and suspends with
      // the poll-wait reason until someone calls Future::resolve on this same
      // array, so the producer decides when it completes.
      ce(buf, EArray([EInt(1), EInt(0)]), local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "host_future_get" {
      // ADR-0089 step 4 (#1218): a HOST-supplied future -- state 2 (the
      // waitable state), payload = the host future handle. vibe_hf_get_raw
      // lowers to the `vibe.host_future_get` import, which only the
      // component adapter module provides (spec §3.13/§3.14): it
      // async-lowers the component-level `get-future` import (eagerly --
      // pair creation never suspends) and hands back the readable end's
      // handle. Awaiting this cell parks with the reserved waitable payload
      // (handle + 2, __aw_poll's waitable arm) until the entry boundary
      // settles it via waitable-set.wait.
      let no_args = Array::slice([EInt(0)], 0, 0)
      ce(buf, EArray([
        EInt(2),
        ECall(EIdent("vibe_hf_get_raw", -1), no_args, -1)
      ]), local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "host_future_named" {
      // ADR-0089 (c) (#1218): the SAME cell shape as host_future_get -- state
      // 2 (waitable), payload = the host future handle -- but the handle
      // comes from a per-NAME raw builtin, so a program can hold several
      // distinct host futures at once. `vibe_hf_get_raw$<name>` lowers to
      // the `vibe.host_future_get$<name>` core import, which the component
      // adapter satisfies from the component-level `<name>: func() ->
      // future<u32>` import (spec §3.16).
      //
      // The name must be a STRING LITERAL: it is an import name, decided at
      // compile time, not a value. Anything else is a hard error here rather
      // than a mysterious missing import later.
      let name_arg = Array::get(args, 0)
      let hf_name = match name_arg {
        EString(s) => s,
        _ => throw("host_future_named: the import name must be a string literal (it becomes a component import name, so it is fixed at compile time)")
      }
      if !cc_is_valid_host_future_name(hf_name) {
        throw("host_future_named: invalid import name '\{hf_name}' -- must be lower kebab-case ([a-z][a-z0-9-]*), the component-model label shape")
      } else {
        ()
      }
      let named_no_args = Array::slice([EInt(0)], 0, 0)
      ce(buf, EArray([
        EInt(2),
        ECall(EIdent(String::concat(cc_host_future_named_raw_prefix(), hf_name), -1), named_no_args, -1)
      ]), local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "host_stream_named" {
      // ADR-0089 Decision 3 (#1218): a NAMED host stream -- state 3 (the
      // host-stream state, distinct from every future cell state so a
      // future cell can never be read as a stream or vice versa), payload =
      // the readable end's handle. `vibe_hs_get_raw$<name>` lowers to the
      // `vibe.host_stream_get$<name>` core import, which the component
      // adapter satisfies from the component-level `<name>: func() ->
      // stream<u8>` import (spec §3.18). Same literal/label rules as
      // host_future_named: the name is an import name, fixed at compile
      // time.
      let hs_name_arg = Array::get(args, 0)
      let hs_name = match hs_name_arg {
        EString(s) => s,
        _ => throw("host_stream_named: the import name must be a string literal (it becomes a component import name, so it is fixed at compile time)")
      }
      if hs_name == "stdin" {
        throw("host_stream_named(\"stdin\") is reserved; use Stdin::read_via_stream()")
      } else if !cc_is_valid_host_future_name(hs_name) {
        throw("host_stream_named: invalid import name '\{hs_name}' -- must be lower kebab-case ([a-z][a-z0-9-]*), the component-model label shape")
      } else {
        ()
      }
      let hs_no_args = Array::slice([EInt(0)], 0, 0)
      ce(buf, EArray([
        EInt(3),
        ECall(EIdent(String::concat(cc_host_stream_named_raw_prefix(), hs_name), -1), hs_no_args, -1)
      ]), local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "host_stream_next" {
      // ADR-0089 Decision 3 (#1218): reads are retargeted to the injected
      // `__hs_next` by linked_compile's boundary machinery (Async-row
      // entry). A call that still spells the surface name here means the
      // machinery did not fire -- there is no read source without the entry
      // boundary + component adapter, so fail with the reason instead of an
      // "undefined variable" later.
      throw("host_stream_next: requires an Async-row entry (the entry boundary performs the stream read via the component adapter, spec §3.18); a row-free or library-mode program has no read source")
    }
    else if !prefer_bound_call && fname == "host_stream_close" {
      // ADR-0089 Decision 3 follow-up (#1218): closes are retargeted to the
      // injected `__hs_close` by the same entry-row-keyed machinery that
      // installs the read path. The close itself performs nothing, but it
      // is only MEANINGFUL alongside that machinery -- a program with no
      // Async-row entry has no adapter to drop the readable end through, so
      // a surviving surface call here means there is no stream to close.
      throw("host_stream_close: requires an Async-row entry (the readable end is dropped through the component adapter, spec §3.18); a row-free or library-mode program has no stream to close")
    }
    else if !prefer_bound_call && fname == "Future::resolve" {
      // #1230: complete a pending future IN PLACE -- payload first, then clear
      // the state. The write order is what makes the observation safe: an
      // awaiter only reads the payload once the state says ready, so it can
      // never see the state cleared ahead of the value it describes.
      //
      // ADR-0089 (#1218, resolve -> direct wake): when the program can call
      // @vibe/concurrent's `__aw_notify_resolve` (func_table carries it --
      // linked import or local def), append the notify AFTER the state
      // clear so direct-parked awaiters (registered via __aw_wait) become
      // resumable immediately. Purely additive: without the hook the old
      // two-set lowering is emitted byte-identically, and a missed notify
      // (hook absent in THIS unit but awaiters registered in another) is
      // rescued by the scheduler's fallback valve.
      let fut = Array::get(args, 0)
      let set_payload = ECall(EIdent("Array::set", -1), [
        fut,
        EInt(1),
        Array::get(args, 1)
      ], -1)
      let set_state = ECall(EIdent("Array::set", -1), [fut, EInt(0), EInt(0)], -1)
      let resolved = if func_table_index_of(ctx.func_table, "__aw_notify_resolve") >= 0 {
        ESeq(set_payload, ESeq(set_state, ECall(EIdent("__aw_notify_resolve", -1), [
          fut
        ], -1)))
      } else {
        ESeq(set_payload, set_state)
      }
      ce(buf, resolved, local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "String::to_bytes" {
      // String::to_bytes(s) : ByteStream (ADR-0089 D4/D5, #1954).
      // Eagerly materialise the string's bytes into the Array that backs a
      // Stream[Int], so request/response bodies can be consumed with the Stream
      // combinators. Synthesized as a `let mut arr = []; while i < length(s) {
      // Array::push(arr, char_code_at(s, i)); i = i + 1 }; arr` loop and lowered
      // via `ce`, so String::length/char_code_at + the loop counter follow the
      // same (RC) tagging conventions as ordinary source. char_code_at reads one
      // byte (i32.load8_u), so this is byte-accurate.
      let s_expr = Array::get(args, 0)
      let loop_body = ESeq(ECall(EIdent("Array::push", -1), [
        EIdent("__tb_arr", -1),
        ECall(EIdent("String::char_code_at", -1), [
          EIdent("__tb_s", -1),
          EIdent("__tb_i", -1)
        ], -1)
      ], -1), EAssign("__tb_i", ECall(EIdent("add", -1), [
        EIdent("__tb_i", -1),
        EInt(1)
      ], -1), EUnit))
      let synth = ELet("__tb_s", s_expr, ELetMut("__tb_arr", EArray(array_empty()), ELetMut("__tb_i", EInt(0), ESeq(EWhile(ECall(EIdent("lt", -1), [
        EIdent("__tb_i", -1),
        ECall(EIdent("String::length", -1), [EIdent("__tb_s", -1)], -1)
      ], -1), loop_body), EIdent("__tb_arr", -1)), -1), -1), -1)
      ce(buf, synth, local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "ByteStream::to_string" {
      // ByteStream::to_string(bs) : String (docs/spec
      // §M2c-2). Collect a Stream[Int] of byte codes into a String, e.g. to
      // build a response body. Synthesized as `let parts = []; while i <
      // length(bs) { Array::push(parts, String::from_char_code(bs[i])); i = i +
      // 1 }; String::join(parts, "")` and lowered via `ce`. Pushing one-char
      // pieces and joining once is O(n); the earlier `acc = String::concat(acc,
      // ...)` accumulator was O(n^2) (each concat copied the whole prefix), the
      // dominant cost in the streaming bench (4 KB to_string: 1.77s -> see
      // scripts/bench_streaming.sh). linked_compile always seeds "" into the
      // string table, so the join separator literal resolves.
      let bs_expr = Array::get(args, 0)
      let ts_body = ESeq(ECall(EIdent("Array::push", -1), [
        EIdent("__ts_parts", -1),
        ECall(EIdent("String::from_char_code", -1), [
          ECall(EIdent("Array::get", -1), [
            EIdent("__ts_arr", -1),
            EIdent("__ts_i", -1)
          ], -1)
        ], -1)
      ], -1), EAssign("__ts_i", ECall(EIdent("add", -1), [
        EIdent("__ts_i", -1),
        EInt(1)
      ], -1), EUnit))
      let synth = ELet("__ts_arr", bs_expr, ELetMut("__ts_parts", EArray(array_empty()), ELetMut("__ts_i", EInt(0), ESeq(EWhile(ECall(EIdent("lt", -1), [
        EIdent("__ts_i", -1),
        ECall(EIdent("Array::length", -1), [EIdent("__ts_arr", -1)], -1)
      ], -1), ts_body), ECall(EIdent("String::join", -1), [
        EIdent("__ts_parts", -1),
        EString("")
      ], -1)), -1), -1), -1)
      ce(buf, synth, local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "add" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_add(buf)
      emit_arith_wrap_int(buf, ctx.enable_rc, "+")
      nl
    }
    else if !prefer_bound_call && fname == "sub" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_sub(buf)
      emit_arith_wrap_int(buf, ctx.enable_rc, "-")
      nl
    }
    else if !prefer_bound_call && fname == "mul" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      // Under RC, untag the first tagged operand BEFORE the multiply so the
      // product is tagged(a*b) and wraps at the payload's 63-bit boundary,
      // exactly like the `*` EBinOp path (#1877).
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shr_s(buf)
      } else {
        ()
      }
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_mul(buf)
      emit_arith_wrap_int(buf, ctx.enable_rc, "*")
      nl
    }
    else if !prefer_bound_call && fname == "lt" {
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_lt_s(buf)
      emit_i64_extend_i32_s(buf)
      // Under RC, Bool values are also tagged `(0|1) << 1` (mirrors the `<`
      // EBinOp path's retag) -- untagged here means callers see 0 (== false
      // tagged) but a true result reads as 1 instead of the expected 2.
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      } else {
        ()
      }
      nl
    }
    else if !prefer_bound_call && fname == "simd_skip_ws" {
      // #536 Phase 3: fused SIMD whitespace skip.
      // simd_skip_ws(src: Bytes, pos: Int, len: Int) -> Int returns the first
      // index >= pos that is NOT ASCII whitespace (' ' \t \n \r), or len if all
      // remaining bytes are whitespace. Scans 16 bytes at a time with the v128
      // chunk kept on the operand stack for the whole loop, plus a scalar tail.
      // Bytes layout (gen_bytes_get_body): [alloc@0][len@4][payload_ptr@8].
      //
      // "On the operand stack" is the whole design, not an implementation
      // detail: a lowering that lets the vector become a vibe VALUE has to give
      // it a heap box, and #2342 retired the `v128_*` intrinsic surface for
      // exactly that -- 16 unreclaimable bytes per operation, 22x slower than
      // the same algorithm written as one kernel. Any fused scanner added here
      // keeps this shape.
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)
      let base_l = nl
      let pos_l = nl + 1
      let len_l = nl + 2
      let res_l = nl + 3
      let mask_l = nl + 4
      let addr_l = nl + 5
      let b_l = nl + 6
      Array::push(local_names, "__sw_base")
      Array::push(local_names, "__sw_pos")
      Array::push(local_names, "__sw_len")
      Array::push(local_names, "__sw_res")
      Array::push(local_names, "__sw_mask")
      Array::push(local_names, "__sw_addr")
      Array::push(local_names, "__sw_b")
      // stack: srcval, posval, lenval
      emit_local_set(buf, len_l)
      emit_local_set(buf, pos_l)
      // top = srcval; base = payload_ptr (i32 @ +8) extended to i64
      emit_i32_wrap_i64(buf)
      emit_i32_load(buf, 2, 8)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, base_l)
      // res defaults to len (every path overwrites it; keep it defined)
      emit_local_get(buf, len_l)
      emit_local_set(buf, res_l)
      emit_block_void(buf)
      // $ret
      emit_block_void(buf)
      // $tail
      emit_loop_void(buf)
      // $scan: if (pos + 16 > len) br $tail
      emit_local_get(buf, pos_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 16)
      emit_i32_add(buf)
      emit_local_get(buf, len_l)
      emit_i32_wrap_i64(buf)
      emit_i32_gt_u(buf)
      emit_if_void(buf)
      emit_br(buf, 2)
      emit_end(buf)
      // addr = base + pos
      emit_local_get(buf, base_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, pos_l)
      emit_i32_wrap_i64(buf)
      emit_i32_add(buf)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, addr_l)
      // is_ws = (c==0x20) | (c==0x09) | (c==0x0A) | (c==0x0D), v128 on stack
      emit_local_get(buf, addr_l)
      emit_i32_wrap_i64(buf)
      emit_v128_load(buf, 0, 0)
      emit_v128_const_splat_byte(buf, 32)
      emit_i8x16_eq(buf)
      emit_local_get(buf, addr_l)
      emit_i32_wrap_i64(buf)
      emit_v128_load(buf, 0, 0)
      emit_v128_const_splat_byte(buf, 9)
      emit_i8x16_eq(buf)
      emit_v128_or(buf)
      emit_local_get(buf, addr_l)
      emit_i32_wrap_i64(buf)
      emit_v128_load(buf, 0, 0)
      emit_v128_const_splat_byte(buf, 10)
      emit_i8x16_eq(buf)
      emit_v128_or(buf)
      emit_local_get(buf, addr_l)
      emit_i32_wrap_i64(buf)
      emit_v128_load(buf, 0, 0)
      emit_v128_const_splat_byte(buf, 13)
      emit_i8x16_eq(buf)
      emit_v128_or(buf)
      // mask = bitmask(not(is_ws)): bit i set => lane i is NON-whitespace
      emit_v128_not(buf)
      emit_i8x16_bitmask(buf)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, mask_l)
      // if (mask == 0) { pos += 16; br $scan }
      emit_local_get(buf, mask_l)
      emit_i32_wrap_i64(buf)
      emit_i32_eqz(buf)
      emit_if_void(buf)
      emit_local_get(buf, pos_l)
      emit_i64_const(buf, 16)
      emit_i64_add(buf)
      emit_local_set(buf, pos_l)
      emit_br(buf, 1)
      emit_end(buf)
      // found: res = pos + ctz(mask); br $ret
      emit_local_get(buf, pos_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, mask_l)
      emit_i32_wrap_i64(buf)
      bytebuf_push(buf, 104)
      // i32.ctz
      emit_i32_add(buf)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, res_l)
      emit_br(buf, 2)
      emit_end(buf)
      // loop $scan
      emit_end(buf)
      // block $tail
      // scalar tail: loop $tscan
      emit_loop_void(buf)
      // if (pos >= len) { res = pos; br $ret }
      emit_local_get(buf, pos_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, len_l)
      emit_i32_wrap_i64(buf)
      emit_i32_ge_u(buf)
      emit_if_void(buf)
      emit_local_get(buf, pos_l)
      emit_local_set(buf, res_l)
      emit_br(buf, 2)
      emit_end(buf)
      // b = load8_u(base + pos)
      emit_local_get(buf, base_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, pos_l)
      emit_i32_wrap_i64(buf)
      emit_i32_add(buf)
      emit_i32_load8_u(buf, 0, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, b_l)
      // non_ws = (b!=32) & (b!=9) & (b!=10) & (b!=13)
      emit_local_get(buf, b_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 32)
      emit_i32_ne(buf)
      emit_local_get(buf, b_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 9)
      emit_i32_ne(buf)
      bytebuf_push(buf, 113)
      // i32.and
      emit_local_get(buf, b_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 10)
      emit_i32_ne(buf)
      bytebuf_push(buf, 113)
      emit_local_get(buf, b_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 13)
      emit_i32_ne(buf)
      bytebuf_push(buf, 113)
      // if (non_ws) { res = pos; br $ret }
      emit_if_void(buf)
      emit_local_get(buf, pos_l)
      emit_local_set(buf, res_l)
      emit_br(buf, 2)
      emit_end(buf)
      // pos += 1; br $tscan
      emit_local_get(buf, pos_l)
      emit_i64_const(buf, 1)
      emit_i64_add(buf)
      emit_local_set(buf, pos_l)
      emit_br(buf, 0)
      emit_end(buf)
      // loop $tscan
      emit_end(buf)
      // block $ret
      emit_local_get(buf, res_l)
      nl + 7
    }
    else if !prefer_bound_call && fname == "perform" {
      let op_expr = Array::get(args, 0)
      let op_head = if is_eident(op_expr) {
        get_eident_name(op_expr)
      } else if expr_tag(op_expr) == 8 {
        let op_callee = get_ecall_callee(op_expr)
        if is_eident(op_callee) {
          get_eident_name(op_callee)
        } else {
          ""
        }
      } else {
        ""
      }
      // #640: `perform Exception::Throw(x)` IS `throw(x)`. `Error` is never in
      // ctx.effect_names (linked_compile.vibe excludes it), so the generic
      // lowering below would assign it the out-of-range fallback tag 3+n and
      // a `with Exception` handler (which catches tag 2, the EThrow tag — see
      // compile_expr_tail6.vibe) would never see it. Emit the exact EThrow
      // sequence instead (compile payload, throw tag 2), skipping the
      // perform-counter/memo-region machinery — Error is non-resumable.
      if is_exception_throw_operation(op_head) {
        let mut enl = next_local
        if expr_tag(op_expr) == 8 && Array::length(get_ecall_args(op_expr)) > 0 {
          enl = ce(buf, Array::get(get_ecall_args(op_expr), 0), local_names, enl, ctx, ld)
        } else {
          emit_i64_const(buf, 0)
        }
        bytebuf_push(buf, 8)
        bytebuf_push(buf, 2)
        enl
      } else if is_exception_operation_name(op_head) {
        throw(String::concat("perform ", String::concat(op_head, ": the abortive Exception alias has a single operation, Throw (#1279)")))
      } else {
        // ADR-0076 追記34 V2: the perform-counter/memo frontier is gone.
        // A perform that reaches codegen was NOT migrated by
        // evidence_dict_pass -- i.e. its effect has no live handle
        // anywhere (a handled perform is rewritten into a dict call, a
        // mock over a host-effect label included) -- so at RUNTIME it can
        // only ever be an unhandled effect: it lowers to a value plus a
        // bare throw (exactly the old memo-miss leg minus the counter/
        // memo bookkeeping), which traps if it somehow executes. In
        // practice these sites are DEAD code that codegen must still
        // emit (dce-tolerated unreachable wrappers, e.g. lib/@vibe/fs's
        // perform wrappers in a program that never handles Fs), and the
        // throw's stack polymorphism is ALSO what keeps them valid: in a
        // program whose value aliases occupy a canonical builtin name
        // (`let Fs::read_file = read_file`, fs.vibe #795), the
        // op_is_builtin leg's recursive compile can resolve into the
        // alias hijack and leave an inconsistent stack -- harmless under
        // the throw, an invalid module without it (found live when V2's
        // first cut dropped the throw for host-mapped ops).
        let mut nl = next_local
        let eff_tag = effect_name_to_tag(ctx.effect_names, op_head)
        let op_canon = canonical_builtin_name(op_head)
        let op_is_builtin = func_table_index_of(ctx.func_table, op_canon) >= 0
        if op_is_builtin {
          nl = ce(buf, op_expr, local_names, nl, ctx, ld)
        } else if expr_tag(op_expr) == 8 {
          let op_args = get_ecall_args(op_expr)
          if Array::length(op_args) > 1 {
            // Multi-value payload (#548): pack all op args into a tuple (one
            // heap ref threaded as the single thrown value).
            nl = ce(buf, ETuple(op_args), local_names, nl, ctx, ld)
          } else if Array::length(op_args) > 0 {
            nl = ce(buf, Array::get(op_args, 0), local_names, nl, ctx, ld)
          } else {
            emit_i64_const(buf, 0)
          }
        } else {
          emit_i64_const(buf, 0)
        }
        bytebuf_push(buf, 8)
        bytebuf_push(buf, eff_tag)
        nl
      }
    }
    else if !prefer_bound_call && fname == "path" {
      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    }
    else if fname == "__loop_tail_retain" {
      // #768: codegen-internal marker (retain_wrap_branch_tails,
      // compile_expr_tail.vibe) -- a loop-borrowed bare ident / projection
      // escaping an if/match branch as the branch VALUE into a
      // scope-end-dropped `let`. Compile the read, then guarded rc_dup so the
      // per-iteration drop consumes the dup, not the loop-carried reference.
      // Never present in user AST (synthesized during codegen only).
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      let v_l = nl
      Array::push(local_names, "__ltr_v")
      emit_local_set(buf, v_l)
      emit_rc_dup_guarded(buf, v_l, ctx.rc_shadow, ctx.rc_dup_func_idx)
      emit_local_get(buf, v_l)
      nl + 1
    }
    else if !prefer_bound_call && (fname == "Path::ref" || fname == "Path::resolve") && Array::length(args) == 1 {
      // #762: both resolve their argument to an absolute path against the
      // process CWD via the `resolve_path` host import. The runtime op is
      // identical; the effect distinction (Path::ref pure, Path::resolve
      // `with Env`) lives in the checker's builtin signatures.
      ce(buf, ECall(EIdent("resolve_path", -1), [Array::get(args, 0)], -1), local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "Path::to_string" && Array::length(args) == 1 {
      // #762: PathRef / DynamicPath wrap a raw String; to_string is identity.
      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "Path::is_absolute" && Array::length(args) == 1 {
      // #762: absolute iff the path begins with '/'. eq(char_code_at(x, 0), 47)
      // avoids synthesizing a "/" string (which would not be in the string
      // table).
      ce(buf, ECall(EIdent("eq", -1), [
        ECall(EIdent("String::char_code_at", -1), [Array::get(args, 0), EInt(0)], -1),
        EInt(47)
      ], -1), local_names, next_local, ctx, ld)
    }
    else if !prefer_bound_call && fname == "__float_bits" {
      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    }
    else if fname == "Int::to_string" && Array::length(args) == 1 {
      // Cheatsheet-documented alias of the integer `__to_string` path (the
      // argument is Int by signature, so the string-pointer heuristic's int
      // route applies).
      ce(buf, ECall(EIdent("__to_string", -1), [Array::get(args, 0)], -1), local_names, next_local, ctx, ld)
    }
    else if fname == "Fs::readdir" && Array::length(args) == 1 {
      // #729/#730: readdir's surface is Array[String], but the host import
      // (`vibe_fs_read_dir_raw`, linked_compile) returns the byte-sorted entry
      // names "\n"-joined as ONE packed string (same ABI as fs_read_file —
      // no host-side array building, RC/bump agnostic). Lower to ordinary
      // AST so String::split's codegen does the array work. An empty dir
      // returns "" which must yield [] — but split("", d) is [""] — hence
      // the length guard. String pieces are built with String::from_char_code
      // because a synthesized EString is not in the string table (same
      // constraint as double_to_string_expr).
      // #1262: shared with the gc lane -- the rewrite is source-level, so both
      // lanes take it from packed_lines_to_array_expr rather than each
      // spelling it out (see that function for the empty-dir and string-table
      // constraints).
      ce(buf, packed_lines_to_array_expr(ECall(EIdent("vibe_fs_read_dir_raw", -1), [
        Array::get(args, 0)
      ], -1), "__rd_names"), local_names, next_local, ctx, ld)
    }
    else if fname == "sh_lines" && Array::length(args) >= 1 {
      // `sh_lines(cmd) -> Array[String]`: the host import (`vibe_sh_lines_raw`,
      // linked_compile) runs the command and returns its stdout "\n"-joined as
      // ONE packed string (same ABI as fs_read_dir). Lower to `String::split`
      // over it, with the empty-output guard yielding [] (split("", d) is [""]).
      // #777: any args beyond the first are labeled boolean flags folded
      // into the command string by `sh_lines_flag_cmd` (single-arg calls are
      // the common case and pass straight through unchanged).
      let sh_cmd = sh_lines_flag_cmd(Array::get(args, 0), args, 1)
      ce(buf, ELet("__sh_out", ECall(EIdent("vibe_sh_lines_raw", -1), [sh_cmd], -1), EIf(EBinOp("==", ECall(EIdent("String::length", -1), [
        EIdent("__sh_out", -1)
      ], -1), EInt(0)), ECall(EIdent("Array::slice", -1), [
        EArray([ECall(EIdent("String::from_char_code", -1), [EInt(10)], -1)]),
        EInt(0),
        EInt(0)
      ], -1), ECall(EIdent("String::split", -1), [
        EIdent("__sh_out", -1),
        ECall(EIdent("String::from_char_code", -1), [EInt(10)], -1)
      ], -1)), -1), local_names, next_local, ctx, ld)
    }
    else if fname == "__to_string" && Array::length(args) == 1 && cc_expr_is_floatish(Array::get(args, 0), local_names, ctx) {
      // #744: a statically-floatish argument takes the synthesized Double
      // formatter — the generic handler below would stringify the raw f64
      // bits (or the box pointer under RC) as an integer.
      ce(buf, double_to_string_expr(Array::get(args, 0)), local_names, next_local, ctx, ld)
    }
    else if fname == "__to_string" && Array::length(args) == 1 && cc_expr_is_boolish(Array::get(args, 0), local_names, ctx) {
      // #784: a statically-boolean argument formats as "true"/"false", not the
      // integer 1/0 the generic path below would emit. Reuse the existing
      // if/EString codegen: `if b { "true" } else { "false" }`.
      ce(buf, EIf(Array::get(args, 0), EString("true"), EString("false")), local_names, next_local, ctx, ld)
    }
    else if fname == "__to_string" && Array::length(args) == 1 && cc_expr_is_stringish(Array::get(args, 0), local_names, ctx) {
      // #950: a statically-String argument IS the result — the generic
      // handler below already returns a string value unchanged at runtime,
      // but only after a string-pointer heuristic that requires ptr >= 64,
      // so the legal packed empty-string encoding 0 (ptr 0, len 0 — e.g.
      // `String::join([], sep)`'s empty case) was misread as Int 0 and
      // printed "0". Emitting the argument directly is byte-for-byte the
      // same dataflow as the generic path's string identity branch, minus
      // the misfiring heuristic. Appending the 0-encoded empty string via
      // String::concat copies 0 bytes, so `"[\{String::join([], "-")}]"`
      // now renders "[]".
      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
    }
    else if fname == "__to_string" {
      let ts_arg0 = Array::get(args, 0)
      let ts_arg_is_int = ts_known_int(ts_arg0, local_names, ctx)
      let mut nl = ce(buf, ts_arg0, local_names, next_local, ctx, ld)
      let val_l = nl
      let neg_l = nl + 1
      let cur_l = nl + 2
      let abs_l = nl + 3
      let hp_l = nl + 4
      let len_l = nl + 5
      Array::push(local_names, "__ts_val")
      Array::push(local_names, "__ts_neg")
      Array::push(local_names, "__ts_cur")
      Array::push(local_names, "__ts_abs")
      Array::push(local_names, "__ts_hp")
      Array::push(local_names, "__ts_len")
      emit_local_set(buf, val_l)
      emit_block_i64(buf)
      if ts_arg_is_int {
        // #678: the argument is statically a known Int (literal or int-bound
        // local) — never run it through the string-pointer heuristic (a large
        // int like `1 << 40` has a zero low word and an in-bounds high word, so
        // it would be misread as an empty string). Force the integer path with
        // a false (i32) condition — the heuristic below also yields an i32 bool.
        emit_i32_const(buf, 0)
      } else {
        emit_local_get(buf, val_l)
        emit_i64_const(buf, 32)
        bytebuf_push(buf, 136)
        emit_local_tee(buf, abs_l)
        emit_i64_const(buf, 64)
        emit_i64_ge_s(buf)
        emit_local_get(buf, abs_l)
        // #606: a string is represented as (ptr << 32) | len, and `__to_string`
        // returns the value unchanged when it looks like a string pointer. A
        // string can live anywhere in linear memory — including the static data
        // section (token / literal strings), whose offset is ABOVE the heap bump
        // pointer during early compilation. The old bound `ptr < heap_ptr`
        // (global 0) misclassified such strings as ints and stringified their raw
        // i64, leaking a heap pointer (e.g. labeled param `x~` printed as
        // `1285664100319233~`). Use the full linear-memory size (memory.size
        // pages * 65536) as the upper bound so any in-bounds pointer is
        // recognized; a small int still has a zero high word and takes the int
        // path below.
        bytebuf_push(buf, 63)
        bytebuf_push(buf, 0)
        emit_i64_extend_i32_u(buf)
        emit_i64_const(buf, 65536)
        emit_i64_mul(buf)
        emit_i64_lt_s(buf)
        bytebuf_push(buf, 113)
        // #664: ALSO require the candidate string to FIT in linear memory:
        // ptr + len <= memory_size. The `ptr < memory_size` bound above is not
        // enough — a large integer (e.g. a 61-bit `Fs::stat_token`) whose HIGH
        // word happens to land below memory_size is otherwise misread as a string
        // pointer, and its LOW word becomes a multi-gigabyte "length". The next
        // `String::concat` then `memory.copy`s that bogus length and traps with
        // "memory access out of bounds" (the #664 crash, triggered during the
        // persistent-sources-cache write `__to_string(Fs::stat_token(path))`). A
        // real string always satisfies ptr + len <= memory_size, so adding this
        // bound keeps genuine strings on the identity path while routing such
        // large integers back to the integer-stringify path below.
        emit_local_get(buf, abs_l)
        emit_local_get(buf, val_l)
        emit_i64_const(buf, 4294967295)
        emit_i64_and(buf)
        emit_i64_add(buf)
        bytebuf_push(buf, 63)
        bytebuf_push(buf, 0)
        emit_i64_extend_i32_u(buf)
        emit_i64_const(buf, 65536)
        emit_i64_mul(buf)
        emit_i64_le_s(buf)
        bytebuf_push(buf, 113)
      }
      emit_if_void(buf)
      emit_local_get(buf, val_l)
      emit_br(buf, 1)
      emit_end(buf)
      // Under RC a scalar Int is tagged `n << 1` (low bit 0 marks a non-heap
      // value; see `Int::to_double` / `Double::to_int` which shift to/from this
      // form). Arithmetic stays in tagged space and compares correctly, but the
      // digit loop below renders the RAW i64 — so without untagging it prints
      // `2n` (e.g. 42 -> "84"). Recover the logical value with an arithmetic
      // (sign-preserving) shift right by 1. Strings already returned above via
      // the `br`, so this only touches the integer path.
      if ctx.enable_rc {
        emit_local_get(buf, val_l)
        emit_i64_const(buf, 1)
        emit_i64_shr_s(buf)
        emit_local_set(buf, val_l)
      }
      emit_i64_const(buf, 46)
      emit_local_set(buf, cur_l)
      emit_local_get(buf, val_l)
      emit_i64_const(buf, 0)
      emit_i64_lt_s(buf)
      emit_i64_extend_i32_s(buf)
      emit_local_set(buf, neg_l)
      emit_local_get(buf, val_l)
      emit_i64_const(buf, 0)
      emit_i64_lt_s(buf)
      emit_if_i64(buf)
      emit_i64_const(buf, 0)
      emit_local_get(buf, val_l)
      emit_i64_sub(buf)
      emit_else(buf)
      emit_local_get(buf, val_l)
      emit_end(buf)
      emit_local_set(buf, abs_l)
      emit_local_get(buf, abs_l)
      emit_i64_eqz(buf)
      emit_if_void(buf)
      emit_local_get(buf, cur_l)
