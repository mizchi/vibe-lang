      emit_i32_mul(buf)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_grow_after_heap_set(buf, ctx)
      emit_local_get(buf, ns_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, st_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, mc_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 16)
      emit_i32_mul(buf)
      emit_memory_copy(buf)
      emit_local_get(buf, mb_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, ns_l)
      emit_i64_store(buf, 3, 8)
      emit_local_get(buf, mb_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, cap_l)
