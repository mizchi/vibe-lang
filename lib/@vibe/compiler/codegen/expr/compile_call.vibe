      // `set` can grow by reallocating storage through the handle. `freeze`
      // copies the entries into a fresh plain Map block ([count@0]
      // [entries@8+16i]), keeping Map layout compatibility. Blocks are raw
      // bump allocations in BOTH RC and bump modes (the same convention as
      // Map::set's output); the even, untagged handle value is invisible to
      // the RC machinery.
      let ptr_l = next_local
      Array::push(local_names, "__mb_ptr")
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, ptr_l)
      emit_global_get(buf, 0)
      emit_i32_const(buf, 144)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_grow_after_heap_set(buf, ctx)
      emit_local_get(buf, ptr_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 0)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_l)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 8)
      emit_i32_store(buf, 2, 4)
      emit_local_get(buf, ptr_l)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, ptr_l)
      emit_i64_const(buf, 16)
      emit_i64_add(buf)
      emit_i64_store(buf, 3, 8)
      emit_local_get(buf, ptr_l)
