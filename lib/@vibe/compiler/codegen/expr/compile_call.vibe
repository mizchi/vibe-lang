      // shims above guard against).
      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_const(buf, 1)
      emit_i64_shr_s(buf)
      emit_call(buf, hi_idx)
      emit_i64_const(buf, 1)
      emit_i64_shl(buf)
      nl
    }
    else if ctx.enable_rc && fname == "vibe_tcp_read_raw" {
      // Both params are guest-tagged Ints (handle, max_bytes) -- untag each;
      // the packed-string result passes through unchanged (same in both modes).
      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_i64_const(buf, 1)
      emit_i64_shr_s(buf)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_i64_const(buf, 1)
      emit_i64_shr_s(buf)
      emit_call(buf, hi_idx)
      nl
    }
    else if ctx.enable_rc && fname == "vibe_tcp_write_raw" {
      // handle: Int -> untag; data: String -> pass; void import, push Unit 0.
      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)
      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_i64_const(buf, 1)
      emit_i64_shr_s(buf)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_call(buf, hi_idx)
      emit_i64_const(buf, 0)
      nl
    }
    else if ctx.enable_rc && fname == "vibe_tcp_close_raw" {
      // handle: Int -> untag; void import, push Unit 0. Tolerates unknown
      // handles host-side (a double-close must not kill the guest).
      let (hi_idx, _, _) = resolve_func(ctx.func_table, fname)
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_i64_const(buf, 1)
      emit_i64_shr_s(buf)
      emit_call(buf, hi_idx)
      emit_i64_const(buf, 0)
      nl
    }
    else if (fname == "println" || fname == "print") && !cc_ft_has(ctx.func_table, fname) {
      // #929: the println/print checker builtins had NO linear-lane lowering
      // at all -- builtin_registry marks them in_linear_table=false on the
      // assumption that "a real prelude source function" serves the linear
      // lane (see the FixedArray comment above), but that function lives in
