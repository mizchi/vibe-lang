      // and user shadows winning), lower directly onto the Stdout host
      // imports on BOTH lanes: the packed-string arg passes through to
      // write_stream unchanged (same in both modes), and println appends a
      // RAW newline byte via write_char -- a direct emit_call to the import
      // index bypasses each lane's arg conversion (the RC/raw ABI hands the
      // host raw ints anyway, and the non-RC lane's untagging lives in the
      // generic call path we are NOT going through), so the raw byte value
      // is correct on BOTH lanes. Import gating in linked_compile.vibe
      // includes println/print for exactly this path.
      let (ws_idx, _, _) = resolve_func(ctx.func_table, "Stdout::write_stream")
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      emit_call(buf, ws_idx)
      if fname == "println" {
        let (wc_idx, _, _) = resolve_func(ctx.func_table, "Stdout::write_char")
        emit_i64_const(buf, 10)
        emit_call(buf, wc_idx)
      } else {
        ()
      }
      emit_i64_const(buf, 0)
      nl
    }
    else if fname == "__rec_field" {
      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)
      let idx_expr = Array::get(args, 1)
      let field_idx = get_eint_value(idx_expr)
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, 8 + field_idx * 8)
      nl
    }
    else if fname == "__len" {
      let (sl_idx, _, _) = resolve_func(ctx.func_table, "String::length")
      let (bl_idx, _, _) = resolve_func(ctx.func_table, "Bytes::length")
      let (al_idx, _, _) = resolve_func(ctx.func_table, "Array::length")
      let obj_local = next_local
      let ptr_local = next_local + 1
      let cap_local = next_local + 2
      Array::push(local_names, "__len_obj")
      Array::push(local_names, "__len_ptr")
      Array::push(local_names, "__len_cap")
      let mut nl = next_local + 3
      nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)
      emit_local_set(buf, obj_local)
      emit_local_get(buf, obj_local)
      emit_i64_const(buf, 32)
      emit_i64_shr_s(buf)
      emit_i64_eqz(buf)
      emit_if_i64(buf)
      emit_local_get(buf, obj_local)
      emit_local_set(buf, ptr_local)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_load(buf, 2, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, cap_local)
      emit_local_get(buf, cap_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 2147483647)
      emit_i32_gt_u(buf)
      emit_if_i64(buf)
      emit_local_get(buf, obj_local)
      emit_call(buf, bl_idx)
      emit_else(buf)
      emit_local_get(buf, obj_local)
      emit_call(buf, al_idx)
      emit_end(buf)
      emit_else(buf)
      emit_local_get(buf, obj_local)
      emit_call(buf, sl_idx)
      emit_end(buf)
      nl
    }
    else if fname == "__index" {
      let (sg_idx, _, _) = resolve_func(ctx.func_table, "String::char_code_at")
      let (bg_idx, _, _) = resolve_func(ctx.func_table, "Bytes::get")
      let (ag_idx, _, _) = resolve_func(ctx.func_table, "Array::get")
      let obj_local = next_local
      let idx_local = next_local + 1
      let ptr_local = next_local + 2
      let cap_local = next_local + 3
      Array::push(local_names, "__index_obj")
      Array::push(local_names, "__index_idx")
      Array::push(local_names, "__index_ptr")
      Array::push(local_names, "__index_cap")
      let mut nl = next_local + 4
      nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)
      emit_local_set(buf, obj_local)
      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)
      emit_local_set(buf, idx_local)
      emit_local_get(buf, obj_local)
      emit_i64_const(buf, 32)
      emit_i64_shr_s(buf)
      emit_i64_eqz(buf)
      emit_if_i64(buf)
      emit_local_get(buf, obj_local)
      emit_local_set(buf, ptr_local)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_load(buf, 2, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, cap_local)
      emit_local_get(buf, cap_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 2147483647)
      emit_i32_gt_u(buf)
      emit_if_i64(buf)
      emit_local_get(buf, obj_local)
      emit_local_get(buf, idx_local)
      emit_call(buf, bg_idx)
      emit_else(buf)
      emit_local_get(buf, obj_local)
      emit_local_get(buf, idx_local)
      emit_call(buf, ag_idx)
      emit_end(buf)
      emit_else(buf)
      emit_local_get(buf, obj_local)
      emit_local_get(buf, idx_local)
      emit_call(buf, sg_idx)
      emit_end(buf)
      nl
    }
    else if fname == "__set_field" {
      let field = get_estring_value(Array::get(args, 1))
      let fc = String::char_code_at(field, 0)
      let is_numeric = fc >= 48 && fc <= 57
      if is_numeric {
        let mut vi = 0
        let mut vp = 0
        while vp < String::length(field) {
          vi = vi * 10 + (String::char_code_at(field, vp) - 48)
          vp = vp + 1
        }
        let mut nl = next_local
        nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)
        emit_i64_const(buf, -2)
        emit_i64_and(buf)
        emit_i32_wrap_i64(buf)
        nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)
        emit_i64_store(buf, 3, vi * 8)
        emit_i64_const(buf, 0)
        nl
      } else {
        // #722: same struct-tag dispatch as the EDot read path
        // (compile_expr_tail4.vibe) — a same-named `mut` field can live at a
        // different slot in another struct, and the static first-match store
        // would corrupt the wrong slot.
        let cands = struct_field_candidates(ctx.ctor_table, field)
        if Array::length(cands) == 0 {
          throw(String::concat("unknown struct field: ", field))
        }
        let (_, idx0) = Array::get(cands, 0)
        let dispatch = struct_field_dispatch_cases(cands)
        if Array::length(dispatch) == 0 {
          let mut nl = next_local
          nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)
          emit_i64_store(buf, 3, 8 + idx0 * 8)
          emit_i64_const(buf, 0)
          nl
        } else {
          let mut nl = next_local
          nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          let obj_l = nl
          Array::push(local_names, "__setf_obj")
          emit_local_set(buf, obj_l)
          nl = ce(buf, Array::get(args, 2), local_names, nl + 1, ctx, ld)
          let val_l = nl
          Array::push(local_names, "__setf_val")
          emit_local_set(buf, val_l)
          let mut di = 0
          while di < Array::length(dispatch) {
            let (dtag, didx) = Array::get(dispatch, di)
            emit_local_get(buf, obj_l)
            emit_i32_wrap_i64(buf)
            emit_i32_load(buf, 2, 0)
            emit_i32_const(buf, dtag)
            emit_i32_eq(buf)
            emit_if_void(buf)
            emit_local_get(buf, obj_l)
            emit_i32_wrap_i64(buf)
            emit_local_get(buf, val_l)
            emit_i64_store(buf, 3, 8 + didx * 8)
            emit_else(buf)
            di = di + 1
          }
          emit_local_get(buf, obj_l)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, val_l)
          emit_i64_store(buf, 3, 8 + idx0 * 8)
          let mut de = 0
          while de < Array::length(dispatch) {
            emit_end(buf)
            de = de + 1
          }
          emit_i64_const(buf, 0)
          nl + 1
        }
      }
    }
    // #775: FixedArray rides on the linear-memory Array exactly like the gc
    // backend does (gc/backend_call.vibe's FixedArray::* cases) — these were
    // registered in builtin_registry with in_linear_table=false, in_gc_table=
    // true, but (unlike println/map_has/etc, whose linear lane is served by a
    // real prelude source function) no linear codegen case existed at all, so
    // any linear-backend caller of FixedArray::make/length/get/set/
    // unsafe_set/blit fell through to the generic call path, which treated
    // the qualified name as a local variable and threw "undefined variable
    // (local): FixedArray::make @call" (5 optimizer/zlib test files, #775).
    // length/get/set/unsafe_set are pure renames onto the existing
    // Array::length/get/set builtins (identical arity), re-lowered through
    // `ce` so they get the same RC/perceus treatment as ordinary source.
    // make/blit are synthesized as source-shaped `let`/`while` ASTs (mirrors
    // String::to_bytes / ByteStream::to_string above) rather than hand-emitted
    // wasm, so the perceus loop-borrow dup logic (EWhile's population of
    // ctx.loop_borrowed_names, compile_expr_tail2.vibe:287) correctly dups
    // the repeatedly-pushed `init` value across FixedArray::make's loop
    // iterations under RC — a hand-emitted raw loop here would silently
    // double-free `init` on the second push.
    // #835: Int64Array::make/length/get/set piggyback on the exact same
    // Array aliasing (Array[Int] already stores the full tagged Int per cell
    // in both backends, so there is no truncation to work around here the
    // way the retired MoonBit host needed a dedicated i64-cell object).
    else if fname == "FixedArray::length" || fname == "Int64Array::length" {
      ce(buf, ECall(EIdent("Array::length", -1), args, -1), local_names, next_local, ctx, ld)
    }
    else if fname == "FixedArray::get" || fname == "Int64Array::get" {
      ce(buf, ECall(EIdent("Array::get", -1), args, -1), local_names, next_local, ctx, ld)
    }
    else if fname == "FixedArray::set" || fname == "FixedArray::unsafe_set" || fname == "Int64Array::set" {
      ce(buf, ECall(EIdent("Array::set", -1), args, -1), local_names, next_local, ctx, ld)
    }
    else if fname == "FixedArray::make" || fname == "Int64Array::make" {
      let n_expr = Array::get(args, 0)
      let init_expr = Array::get(args, 1)
      let loop_body = ESeq(ECall(EIdent("Array::push", -1), [
        EIdent("__fam_arr", -1),
        EIdent("__fam_init", -1)
      ], -1), EAssign("__fam_i", EBinOp("+", EIdent("__fam_i", -1), EInt(1)), EUnit))
      let synth = ELet("__fam_n", n_expr, ELet("__fam_init", init_expr, ELetMut("__fam_arr", EArray(array_empty()), ELetMut("__fam_i", EInt(0), ESeq(EWhile(EBinOp("<", EIdent("__fam_i", -1), EIdent("__fam_n", -1)), loop_body), EIdent("__fam_arr", -1)), -1), -1), -1), -1)
      ce(buf, synth, local_names, next_local, ctx, ld)
    }
    else if fname == "FixedArray::blit" {
      // blit(dst, dst_off, src, src_off, len): element-by-element copy, same
      // semantics as gc/backend_call.vibe's FixedArray::blit.
      let dst_expr = Array::get(args, 0)
      let doff_expr = Array::get(args, 1)
      let src_expr = Array::get(args, 2)
      let soff_expr = Array::get(args, 3)
      let len_expr = Array::get(args, 4)
      let loop_body = ESeq(ECall(EIdent("Array::set", -1), [
        EIdent("__fb_dst", -1),
        EBinOp("+", EIdent("__fb_doff", -1), EIdent("__fb_i", -1)),
        ECall(EIdent("Array::get", -1), [
          EIdent("__fb_src", -1),
          EBinOp("+", EIdent("__fb_soff", -1), EIdent("__fb_i", -1))
        ], -1)
      ], -1), EAssign("__fb_i", EBinOp("+", EIdent("__fb_i", -1), EInt(1)), EUnit))
      let synth = ELet("__fb_dst", dst_expr, ELet("__fb_doff", doff_expr, ELet("__fb_src", src_expr, ELet("__fb_soff", soff_expr, ELet("__fb_len", len_expr, ELetMut("__fb_i", EInt(0), ESeq(EWhile(EBinOp("<", EIdent("__fb_i", -1), EIdent("__fb_len", -1)), loop_body), EUnit), -1), -1), -1), -1), -1), -1)
      ce(buf, synth, local_names, next_local, ctx, ld)
    }
    else if fname == "Bytes::blit" {
      // blit(dst, src, start, end): append src[start..end) to dst (half-open
      // range), matching lib/@vibe/builtin/bytes_test.vibe's expectation and the
      // gc backend's gen_bytes_blit_body. gc-only in the builtin registry; this
      // synthesizes the loop for the linear backend (same technique as
      // FixedArray::make/blit above) so `Bytes::push` handles the buffer growth
      // and RC bookkeeping instead of hand-emitted wasm.
      let dst_expr = Array::get(args, 0)
      let src_expr = Array::get(args, 1)
      let start_expr = Array::get(args, 2)
      let end_expr = Array::get(args, 3)
      let loop_body = ESeq(ECall(EIdent("Bytes::push", -1), [
        EIdent("__bb_dst", -1),
        ECall(EIdent("Bytes::get", -1), [
          EIdent("__bb_src", -1),
          EIdent("__bb_i", -1)
        ], -1)
      ], -1), EAssign("__bb_i", EBinOp("+", EIdent("__bb_i", -1), EInt(1)), EUnit))
      let synth = ELet("__bb_dst", dst_expr, ELet("__bb_src", src_expr, ELet("__bb_start", start_expr, ELet("__bb_end", end_expr, ELetMut("__bb_i", EIdent("__bb_start", -1), ESeq(EWhile(EBinOp("<", EIdent("__bb_i", -1), EIdent("__bb_end", -1)), loop_body), EUnit), -1), -1), -1), -1), -1)
      ce(buf, synth, local_names, next_local, ctx, ld)
    }
    else if fname == "Bytes::fill" {
      // fill(dst, value, count): append `count` copies of `value` to dst.
      // gc-only in the builtin registry; synthesized for the linear backend
      // via Bytes::push (same technique as Bytes::blit / FixedArray::make).
      let dst_expr = Array::get(args, 0)
      let val_expr = Array::get(args, 1)
      let count_expr = Array::get(args, 2)
      let loop_body = ESeq(ECall(EIdent("Bytes::push", -1), [
        EIdent("__bf2_dst", -1),
        EIdent("__bf2_val", -1)
      ], -1), EAssign("__bf2_i", EBinOp("+", EIdent("__bf2_i", -1), EInt(1)), EUnit))
      let synth = ELet("__bf2_dst", dst_expr, ELet("__bf2_val", val_expr, ELet("__bf2_count", count_expr, ELetMut("__bf2_i", EInt(0), ESeq(EWhile(EBinOp("<", EIdent("__bf2_i", -1), EIdent("__bf2_count", -1)), loop_body), EUnit), -1), -1), -1), -1)
      ce(buf, synth, local_names, next_local, ctx, ld)
    }
    else if fname == "Bytes::new" && Array::length(args) == 1 {
      // Bytes::new(n): length-n zero-filled buffer (MoonBit semantics). The
      // runtime bytes_new takes no operands, so the generic path used to emit
      // the argument and then call it anyway — the operand stayed stranded on
      // the value stack and the whole module failed validation at
      // instantiation time. Synthesize new() + a zero-push loop instead.
      ce(buf, sized_bytes_new_expr(Array::get(args, 0)), local_names, next_local, ctx, ld)
    }
    else {
      // #875: a name that is BOTH a func_table entry (some unrelated
      // top-level/entry-file function reachable in this merged program) AND a
      // properly in-scope LOCAL binding (e.g. a nested `let rec NAME = ...`
      // closure) must resolve to the LOCAL — lexical scoping always wins.
      // Before this guard, `fn_idx_in_list >= 0` alone gated the direct-call
      // path below, so a local closure whose bare name happened to collide
      // with some other reachable function (most commonly the compile
      // entry file's own top-level helpers, which build_export_rename_plan
      // deliberately leaves unqualified) was miscompiled into a direct call
      // to that unrelated function instead of a closure_resolve/call_indirect
      // to the actual in-scope value — a wasm-validation-time arity mismatch
      // with no compile-time diagnostic. See #875.
      if fn_idx_in_list >= 0 && local_idx_hint < 0 {
        let fidx = Array::get(ctx.func_table.indices, fn_idx_in_list)
        let has_ret = Array::get(ctx.func_table.returns, fn_idx_in_list)
        let needs_env = Array::get(ctx.func_table.needs_env, fn_idx_in_list)
        let mut nl = next_local
        // Hoisted: one bsearch per CALL instead of one per argument.
        let cc_bmask = cc_borrow_mask(ctx, fname)
        let mut ci = 0
        while ci < Array::length(args) {
          let carg = Array::get(args, ci)
          nl = ce(buf, carg, local_names, nl, ctx, ld)
          // Retain a heap projection passed to an OWNING parameter (the callee
          // drops its params). Skip arg0 of a borrow-arg0 builtin (Array::get /
          // length / push / set, etc.): it does NOT drop that argument, so a dup
          // there would never be matched and would leak one reference per call
          // (#704). Mirrors `is_borrow_arg0_call` in perceus/index.vibe.
          // ADR-0092 borrow-inference: a user fn's borrowed parameter gets
          // the same call-site treatment as the builtin arg0 list, at ANY
          // position -- the callee does not drop that argument, so the
          // caller must not dup it.
          let borrows_this = cc_bmask_has(cc_bmask, ci)
          let is_loop_borrow1 = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx) && !borrows_this
          if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow1) && !borrows_this {
            // #706 leak follow-up: this dup's matching consume is INSIDE the loop
            // (the callee drops its own copy each iteration) and never touches
            // the binding's own slot-held reference, so the function epilogue
            // must emit one extra compensating drop for it. Log only the
            // loop-borrow trigger — the projection/borrow-ret-call cases already
            // have correct accounting via the existing rc_drops mechanism.
            if is_loop_borrow1 {
              Array::push(ctx.loop_consumed_names, get_eident_name(carg))
            } else {
              ()
            }
            Array::push(local_names, "__argdup")
            emit_local_tee(buf, nl)
            emit_rc_dup_guarded(buf, nl, ctx.rc_shadow, ctx.rc_dup_func_idx)
            nl = nl + 1
          } else {
            ()
          }
          ci = ci + 1
        }
        if needs_env {
          emit_i64_const(buf, 0)
        }
        emit_call(buf, fidx)
        if has_ret == 0 {
          emit_i64_const(buf, 0)
        }
        nl
      } else {
        let local_idx2 = if local_idx_hint >= 0 {
          local_idx_hint
        } else {
          resolve_local(local_names, fname, "call")
        }
        let num_args = Array::length(args)
        let fn_val_local = next_local
        let slot_local = next_local + 1
        let env_local = next_local + 2
        let mut nl = next_local + 3
        Array::push(local_names, "__fn_val")
        Array::push(local_names, "__slot")
        Array::push(local_names, "__env")
        emit_local_get(buf, local_idx2)
        // #2012: a captured `let mut` local holds a cell address, not the
        // function value. Load the i64 in the cell before closure_resolve
        // or the cell pointer is used as a table index.
        if array_contains_str(ctx.ref_cell_names, fname) {
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, 0)
        } else {
          ()
        }
        emit_local_set(buf, fn_val_local)
        emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
        let mut ci = 0
        while ci < num_args {
          let carg = Array::get(args, ci)
          nl = ce(buf, carg, local_names, nl, ctx, ld)
          // #706: a closure consumes its args; dup a loop-borrowed owning arg so
          // it survives the back-edge (mirrors the direct-call path above).
          // #708: also retain a projection / borrow-returning-call arg here, same
          // as the direct-call path (line ~2607) already does -- a closure param
          // is dropped by the callee's own exit epilogue exactly like a direct
          // call's owning param, so a bare borrowed view passed through (e.g. the
          // recursive-descent parser's `parse_recur(tokens, ...)` family calling
          // through a `let rec`-captured closure value) was double-freed the same
          // way #704/#706's direct-call cases were, just one call-shape over.
          let is_loop_borrow2 = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx)
          if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow2) {
            // #706 leak follow-up: log so the epilogue compensates (see above).
            if is_loop_borrow2 {
              Array::push(ctx.loop_consumed_names, get_eident_name(carg))
            } else {
              ()
            }
            Array::push(local_names, "__argdup")
            emit_local_tee(buf, nl)
            emit_rc_dup_guarded(buf, nl, ctx.rc_shadow, ctx.rc_dup_func_idx)
            nl = nl + 1
          } else {
            ()
          }
          ci = ci + 1
        }
        emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)
        nl
      }
    }
  } else {
    let num_args = Array::length(args)
    let fn_val_local = next_local
    let slot_local = next_local + 1
    let env_local = next_local + 2
    let mut nl = next_local + 3
    Array::push(local_names, "__fn_val")
    Array::push(local_names, "__slot")
    Array::push(local_names, "__env")
    nl = ce(buf, callee, local_names, nl, ctx, ld)
    emit_local_set(buf, fn_val_local)
    emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
    let mut ci = 0
    while ci < num_args {
      let carg = Array::get(args, ci)
      nl = ce(buf, carg, local_names, nl, ctx, ld)
      // #706: dup a loop-borrowed owning arg passed to a closure call.
      // #708: also retain a projection / borrow-returning-call arg (see the
      // matching comment on the other closure-call path above).
      let is_loop_borrow3 = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx)
      if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow3) {
        // #706 leak follow-up: log so the epilogue compensates (see above).
        if is_loop_borrow3 {
          Array::push(ctx.loop_consumed_names, get_eident_name(carg))
        } else {
          ()
        }
        Array::push(local_names, "__argdup")
        emit_local_tee(buf, nl)
        emit_rc_dup_guarded(buf, nl, ctx.rc_shadow, ctx.rc_dup_func_idx)
        nl = nl + 1
      } else {
        ()
      }
      ci = ci + 1
    }
    emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)
    nl
  }
}
