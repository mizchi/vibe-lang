export let array_contains_str: (Array[String], String) -> Bool = (arr, s) -> {
  let len = Array::length(arr)
  let mut i = 0
  let mut found = false
  while i < len {
    if Array::get(arr, i) == s {
      found = true
      i = len
    } else {
      i = i + 1
    }
  }
  found
}

