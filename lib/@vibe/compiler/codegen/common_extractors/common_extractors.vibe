//# Imports

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr, bytebuf_push, leb128_encode_u32
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/codegen/wasm_emit {
  emit_i64_add, emit_i64_div_s, emit_i64_mul, emit_i64_rem_s, emit_i64_sub
}

let op_prefix = 252

//# Functions

/// Interior-line breakpoints (span-arc step5): return the first available source
/// char-offset for `e`, walking into the most-representative child until an
/// offset-carrying node is found, or -1 if none. EIdent/ECall/EDot carry real
/// char-offsets; for ECall/EDot prefer the node's own offset, else recurse into
/// the callee/base. A statement's offset is thus derived from its VALUE
/// subexpression. Flat single match, tail-recursive into one child per arm.
export fn first_offset(e: Expr) -> Int {
  match e {
    EIdent(_, off) => off,
    ECall(callee, _, off) => if off >= 0 {
      off
    } else {
      first_offset(callee)
    },
    EDot(base, _, off, _) => if off >= 0 {
      off
    } else {
      first_offset(base)
    },
    EBinOp(_, lhs, _) => first_offset(lhs),
    EUnaryOp(_, inner) => first_offset(inner),
    ELet(_, val, _, _) => first_offset(val),
    ELetRec(_, val, _) => first_offset(val),
    ELetMut(_, val, _, _) => first_offset(val),
    EAssign(_, val, _) => first_offset(val),
    EAssignOp(_, _, val, _) => first_offset(val),
    ESeq(first, _) => first_offset(first),
    EIf(cond, _, _) => first_offset(cond),
    EMatch(scrut, _) => first_offset(scrut),
    EReturn(inner) => first_offset(inner),
    _ => -1
  }
}

/// Interior-line breakpoints: convert a 0-based source char-offset to a 1-based
/// line number using a sorted array of newline char-offsets: line = 1 + (count of
/// newline offsets strictly less than `off`). Linear scan (programs are small).
export fn offset_to_line(nl: Array[Int], off: Int) -> Int {
  let n = Array::length(nl)
  let mut i = 0
  let mut count = 0
  while i < n {
    if Array::get(nl, i) < off {
      count = count + 1
    } else {
      ()
    }
    i = i + 1
  }
  count + 1
}

/// Interior-line breakpoints: build a sorted array of the char-offsets of each
/// '\n' in `src`. Empty when `src` is empty.
export fn build_newline_offsets(src: String) -> Array[Int] {
  let arr = array_empty()
  let n = String::length(src)
  let mut i = 0
  while i < n {
    if String::char_code_at(src, i) == 10 {
      Array::push(arr, i)
    } else {
      ()
    }
    i = i + 1
  }
  arr
}

