export fn array_contains_str(arr: Array[String], s: String) -> Bool {
  let len = Array::length(arr)
  let mut i = 0
  let mut found = false
  while i < len {
    if Array::get(arr, i) == s {
      found = true
      i = len
    } else {
      i = i + 1
    }
  }
  found
}

/// #1015: Int twin of array_contains_str, for slot-indexed tracking arrays
/// (CompileCtxGc.gc_bool_locals and its local_names-derived lookups in
/// codegen/gc/backend_expr.vibe and codegen/gc/backend_call.vibe). Plain
/// membership, no encoding -- see gc_bool_locals' doc comment on
/// CompileCtxGc for why no encoding is needed.
export fn array_contains_int(arr: Array[Int], v: Int) -> Bool {
  let len = Array::length(arr)
  let mut i = 0
  let mut found = false
  while i < len {
    if Array::get(arr, i) == v {
      found = true
      i = len
    } else {
      i = i + 1
    }
  }
  found
}

