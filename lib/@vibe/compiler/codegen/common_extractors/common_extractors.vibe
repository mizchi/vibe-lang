/// Check if a pattern is unconditionally matching (catch-all)
export fn is_catchall_pat(p: Pat) -> Bool {
  match p {
    PWild => true,
    PBind(_) => true,
    PTuple(pats) => {
      // PTuple is catch-all only if ALL sub-patterns are catch-all
      let mut i = 0
      let mut all_catch = true
      while i < Array::length(pats) {
        if !is_catchall_pat(Array::get(pats, i)) {
          all_catch = false
        }
        i = i + 1
      }
      all_catch
    },
    PStruct(_, fields) => {
      // A struct pattern is irrefutable (catch-all) exactly when every field
      // sub-pattern is — a struct has a single shape, so the only thing that can
      // make it refutable is a literal field sub-pattern. (`S::{ x, y }` binds;
      // `S::{ x: 5 }` is refutable and needs a discriminating test instead.)
      let mut i = 0
      let mut all_catch = true
      while i < Array::length(fields) {
        let (_, sp) = Array::get(fields, i)
        if !is_catchall_pat(sp) {
          all_catch = false
        }
        i = i + 1
      }
      all_catch
    },
    _ => false
  }
}

/// Emit WASM instruction for an assign operator (+=, -=, etc.)
export fn emit_assignop_op(buf: Bytes, op: String) -> Unit with Exception {
  if op == "+" {
    emit_i64_add(buf)
  }
  else if op == "-" {
    emit_i64_sub(buf)
  }
  else if op == "*" {
    emit_i64_mul(buf)
  }
  else if op == "/" {
    emit_i64_div_s(buf)
  }
  else if op == "%" {
    emit_i64_rem_s(buf)
  }
  else {
    throw(String::concat("unsupported assign op: ", op))
  }
}

export fn emit_memory_copy(buf: Bytes) -> Unit {
  bytebuf_push(buf, op_prefix)
  leb128_encode_u32(buf, 10)
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 0)
}

/// memory.fill: stack operands (dest, value, size) -> fills `size` bytes at
/// `dest` with the low byte of `value`. Bulk-memory op 11 (same 0xFC prefix
/// family as memory.copy above). Used to zero-init (or 0xFF-sentinel-init) a
/// fresh hash-index table in one instruction instead of a store loop.
export fn emit_memory_fill(buf: Bytes) -> Unit {
  bytebuf_push(buf, op_prefix)
  leb128_encode_u32(buf, 11)
  bytebuf_push(buf, 0)
}

