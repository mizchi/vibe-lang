generated_hash =

// @vibe/compiler/codegen/common_extractors — bodyless AST field extractors
// (get_e*/get_p* accessors) plus a handful of small string/offset/array
// helpers shared across codegen (ADR-0070 Phase 3, #897, compiler-internal
// batch). Compiled into the compiler itself via
// compiler_sources_manifest.tsv (group `codegen`, dual-row: this contract +
// common_extractors.vibe).
//
// The old index.vibe was not a facade but the whole implementation (the
// package is single-file), so it moved verbatim to common_extractors.vibe.
// No exported types: every struct/enum this package touches (Expr/Pat/Stmt/
// TypeExpr from ../../core) is structural signature text resolved against
// the implementation import when the facade is merged in (normalize/perceus
// precedent — no re-import needed here). No `version` binding existed
// (compiler-internal package).

fn first_offset(e: Expr) -> Int
fn offset_to_line(nl: Array[Int], off: Int) -> Int
fn build_newline_offsets(src: String) -> Array[Int]
fn get_ebinop_lhs(expr: Expr) -> Expr with Error
fn get_ebinop_rhs(expr: Expr) -> Expr with Error
fn get_ecall_args(expr: Expr) -> Array[Expr] with Error
