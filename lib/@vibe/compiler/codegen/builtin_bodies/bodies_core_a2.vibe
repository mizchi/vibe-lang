//# Functions

export fn gen_identity_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  b
}

export fn gen_arr_slice_body(enable_rc: Bool, rc_alloc_idx: Int, rc_shadow: Bool) -> Bytes {
  let b = bytebuf_new()
  if enable_rc {
    // ADR-0055 Stage 4: build the slice as a self-describing RC block, the same
    // shape as gen_arr_new / a literal array, so the recursive rc_drop and the
    // free-list can reach it. Layout: [alloc_size@0][rc_count@4][class=5@7],
    // value = block+8, value[0]=cap value[4]=len value[8]=data_ptr=block+20.
    // The copied elements are shared with the source, so each RC-managed element
    // is dup'd (guarded) — without this the source drop frees them while the
    // slice still references them (use-after-free / trap, issue #500).
    // locals: 3=src_val 4=src_data 5=count 6=block 7=data_ptr 8=cap 9=i (i32),
    //         10=elem (i64).
    // src_val = wrap(arr & -2)  (untag the odd source pointer)
    emit_local_get(b, 0)
    emit_i64_const(b, -2)
    emit_i64_and(b)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 3)
    // src_data = src_val[8]
    emit_local_get(b, 3)
    emit_i32_load(b, 2, 8)
    emit_local_set(b, 4)
    // count = untag(end) - untag(start)
    emit_local_get(b, 2)
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
    emit_i32_wrap_i64(b)
    emit_local_get(b, 1)
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
    emit_i32_wrap_i64(b)
    emit_i32_sub(b)
    emit_local_set(b, 5)
    // cap = count + 8
    emit_local_get(b, 5)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_local_set(b, 8)
    // block = wrap(__rc_alloc(20 + cap*8))
    emit_i32_const(b, 20)
    emit_local_get(b, 8)
    emit_i32_const(b, 3)
    bytebuf_push(b, 116)
    emit_i32_add(b)
    emit_i64_extend_i32_u(b)
    emit_call(b, rc_alloc_idx)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 6)
    // block[0] = alloc_size = 20 + cap*8
    emit_local_get(b, 6)
    emit_i32_const(b, 20)
    emit_local_get(b, 8)
    emit_i32_const(b, 3)
    bytebuf_push(b, 116)
    emit_i32_add(b)
    emit_i32_store(b, 2, 0)
    // block[4] = rc_count = 1
    emit_local_get(b, 6)
    emit_i32_const(b, 1)
    emit_i32_store(b, 2, 4)
    // block[7] = class = 5 (array); high byte of the rc_count word
    emit_local_get(b, 6)
    emit_i32_const(b, 5)
    emit_i32_store8(b, 0, 7)
    // value[0] (block+8) = cap
    emit_local_get(b, 6)
    emit_local_get(b, 8)
    emit_i32_store(b, 2, 8)
    // value[4] (block+12) = len = count
    emit_local_get(b, 6)
    emit_local_get(b, 5)
    emit_i32_store(b, 2, 12)
    // data_ptr = block+20
    emit_local_get(b, 6)
    emit_i32_const(b, 20)
    emit_i32_add(b)
    emit_local_set(b, 7)
    // value[8] (block+16) = data_ptr
    emit_local_get(b, 6)
    emit_local_get(b, 7)
    emit_i32_store(b, 2, 16)
    // memory_copy: dst=data_ptr, src=src_data + untag(start)*8, len=count*8
    emit_local_get(b, 7)
    emit_local_get(b, 4)
    emit_local_get(b, 1)
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
    emit_i32_wrap_i64(b)
    emit_i32_const(b, 3)
    bytebuf_push(b, 116)
    emit_i32_add(b)
    emit_local_get(b, 5)
    emit_i32_const(b, 3)
    bytebuf_push(b, 116)
    emit_memory_copy(b)
    // dup each copied RC-managed element (guarded: odd && high32==0)
    emit_i32_const(b, 0)
    emit_local_set(b, 9)
    emit_block_void(b)
    emit_loop_void(b)
    emit_local_get(b, 9)
    emit_local_get(b, 5)
    emit_i32_ge_u(b)
    emit_br_if(b, 1)
    // elem = load_i64(data_ptr + i*8)
    emit_local_get(b, 7)
    emit_local_get(b, 9)
    emit_i32_const(b, 3)
    bytebuf_push(b, 116)
    emit_i32_add(b)
    emit_i64_load(b, 3, 0)
    emit_local_set(b, 10)
    // if (elem & 1) — odd heap pointer
    emit_local_get(b, 10)
    emit_i64_const(b, 1)
    emit_i64_and(b)
    emit_i32_wrap_i64(b)
    emit_if_void(b)
    // if (elem >> 32) == 0 — not a string/bytes fat pointer
    emit_local_get(b, 10)
    emit_i64_const(b, 32)
    emit_i64_shr_s(b)
    emit_i64_eqz(b)
    emit_if_void(b)
    // #715 recurrence guard (VIBE_RC=shadow): trap on dup-of-freed element.
    if rc_shadow {
      emit_local_get(b, 10)
      emit_i64_const(b, -2)
      emit_i64_and(b)
      emit_i32_wrap_i64(b)
      emit_i32_const(b, rc_shadow_base())
      emit_i32_add(b)
      emit_i32_load8_u(b, 0, 0)
      emit_if_void(b)
      bytebuf_push(b, 0)
      emit_end(b)
    } else {
      ()
    }
    // rc_count++ at (elem & -2) - 4
    emit_rc_word_inc_saturating(b, () -> {
      emit_local_get(b, 10)
      emit_i64_const(b, -2)
      emit_i64_and(b)
      emit_i32_wrap_i64(b)
      emit_i32_const(b, 4)
      emit_i32_sub(b)
    })
    emit_end(b)
    emit_end(b)
    // i++
    emit_local_get(b, 9)
    emit_i32_const(b, 1)
    emit_i32_add(b)
    emit_local_set(b, 9)
    emit_br(b, 0)
    emit_end(b)
    emit_end(b)
    // return (block+8) | 1  (odd-tagged value pointer)
    emit_local_get(b, 6)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_i64_extend_i32_u(b)
    emit_i64_const(b, 1)
    emit_i64_or(b)
  } else {
    emit_local_get(b, 0)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 3)
    emit_local_get(b, 3)
    emit_i32_load(b, 2, 8)
    emit_local_set(b, 4)
    emit_local_get(b, 2)
    emit_i32_wrap_i64(b)
    emit_local_get(b, 1)
    emit_i32_wrap_i64(b)
    emit_i32_sub(b)
    emit_local_set(b, 5)
    emit_local_get(b, 5)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_local_set(b, 8)
    emit_global_get(b, 0)
    emit_local_tee(b, 6)
    emit_i32_const(b, 12)
    emit_local_get(b, 8)
    emit_i32_const(b, 3)
    bytebuf_push(b, 116)
    emit_i32_add(b)
    emit_i32_add(b)
    emit_global_set(b, 0)
    emit_heap_memory_grow_check(b)
    emit_local_get(b, 6)
    emit_local_get(b, 8)
    emit_i32_store(b, 2, 0)
    emit_local_get(b, 6)
    emit_local_get(b, 5)
    emit_i32_store(b, 2, 4)
    emit_local_get(b, 6)
    emit_i32_const(b, 12)
    emit_i32_add(b)
    emit_local_set(b, 7)
    emit_local_get(b, 6)
    emit_local_get(b, 7)
    emit_i32_store(b, 2, 8)
    emit_local_get(b, 7)
    emit_local_get(b, 4)
    emit_local_get(b, 1)
    emit_i32_wrap_i64(b)
    emit_i32_const(b, 3)
    bytebuf_push(b, 116)
    emit_i32_add(b)
    emit_local_get(b, 5)
    emit_i32_const(b, 3)
    bytebuf_push(b, 116)
    emit_memory_copy(b)
    emit_local_get(b, 6)
    emit_i64_extend_i32_u(b)
  }
  b
}

export fn gen_bytes_get_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  // #811: unsigned bounds check (idx as u32 >= len traps; negatives too).
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)
  emit_i32_ge_u(b)
  emit_if_void(b)
  bytebuf_push(b, 0)
  emit_end(b)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  // ADR-0055 Stage 1: the index arrives tagged (n<<1); untag before use.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i64_extend_i32_u(b)
  // ADR-0055 Stage 1: the byte is a count entering the value world; tag it.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  b
}

export fn gen_bytes_len_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)
  emit_i64_extend_i32_u(b)
  // ADR-0055 Stage 1: the length is a count entering the value world; tag it.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  b
}

// simd_skip_ws(buf: Bytes, pos: Int, len: Int) -> Int
// Returns the smallest index i in [pos, len) such that buf[i] is not an ASCII
// whitespace byte (space/tab/LF/CR); returns len if every byte in the range is
// whitespace. A SIMD fast path skips whole 16-byte chunks that are entirely
// whitespace; a scalar tail handles the final partial chunk and the chunk that
// first contains a non-whitespace byte. The v128 values stay on the operand
// stack (no v128 local), so the function declares only i32/i64 locals.
//   locals: i32 { 3: addr (data ptr), 4: byte } ; i64 { 5: p, 6: n }
export fn gen_simd_skip_ws_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  // addr = data pointer of the Bytes object (payload pointer at obj+8)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 3)
  // p = untag(pos)
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_local_set(b, 5)
  // n = untag(len)
  emit_local_get(b, 2)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_local_set(b, 6)
  // --- SIMD fast path: skip 16-byte chunks that are entirely whitespace ---
  emit_block_void(b)
  emit_loop_void(b)
  // if p + 16 > n: leave the fast path
  emit_local_get(b, 5)
  emit_i64_const(b, 16)
  emit_i64_add(b)
  emit_local_get(b, 6)
  emit_i64_gt_s(b)
  emit_br_if(b, 1)
  // is_space (0x20)
  emit_local_get(b, 3)
  emit_local_get(b, 5)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_v128_load(b, 0, 0)
  emit_i64_const(b, 32)
  emit_i32_wrap_i64(b)
  emit_i8x16_splat(b)
  emit_i8x16_eq(b)
  // is_tab (0x09)
  emit_local_get(b, 3)
  emit_local_get(b, 5)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_v128_load(b, 0, 0)
  emit_i64_const(b, 9)
  emit_i32_wrap_i64(b)
  emit_i8x16_splat(b)
  emit_i8x16_eq(b)
  emit_v128_or(b)
  // is_lf (0x0A)
  emit_local_get(b, 3)
  emit_local_get(b, 5)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_v128_load(b, 0, 0)
  emit_i64_const(b, 10)
  emit_i32_wrap_i64(b)
  emit_i8x16_splat(b)
  emit_i8x16_eq(b)
  emit_v128_or(b)
  // is_cr (0x0D)
  emit_local_get(b, 3)
  emit_local_get(b, 5)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_v128_load(b, 0, 0)
  emit_i64_const(b, 13)
  emit_i32_wrap_i64(b)
  emit_i8x16_splat(b)
  emit_i8x16_eq(b)
  emit_v128_or(b)
  // non-whitespace bitmask: bit set => byte is NOT whitespace
  emit_v128_not(b)
  emit_i8x16_bitmask(b)
  // if any non-whitespace byte in this chunk, hand off to the scalar tail
  emit_br_if(b, 1)
  // whole chunk is whitespace: advance 16 and continue
  emit_local_get(b, 5)
  emit_i64_const(b, 16)
  emit_i64_add(b)
  emit_local_set(b, 5)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  // --- scalar tail: advance p while p < n and buf[p] is whitespace ---
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 5)
  emit_local_get(b, 6)
  emit_i64_ge_s(b)
  emit_br_if(b, 1)
  // byte = load8u(addr + p)
  emit_local_get(b, 3)
  emit_local_get(b, 5)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_local_set(b, 4)
  // is_ws = (byte==0x20)+(byte==0x09)+(byte==0x0A)+(byte==0x0D); the equalities
  // are mutually exclusive so the sum is 0 or 1 (avoids needing i32.or).
  emit_local_get(b, 4)
  emit_i32_const(b, 32)
  emit_i32_eq(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 9)
  emit_i32_eq(b)
  emit_i32_add(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 10)
  emit_i32_eq(b)
  emit_i32_add(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 13)
  emit_i32_eq(b)
  emit_i32_add(b)
  // if NOT whitespace, stop
  emit_i32_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 5)
  emit_i64_const(b, 1)
  emit_i64_add(b)
  emit_local_set(b, 5)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  // return tag(p)
  emit_local_get(b, 5)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  b
}

// simd_scan_alnum(buf: Bytes, pos: Int, len: Int) -> Int
// Returns the smallest index i in [pos, len) such that buf[i] is NOT an
// identifier byte ([A-Za-z0-9_]); returns len if every byte in the range is an
// identifier byte. Used to scan to the end of an identifier/number run. A SIMD
// fast path skips whole 16-byte chunks that are entirely identifier bytes; a
// scalar tail handles the final partial chunk and the chunk that first contains
// a non-identifier byte. Range membership uses the wrap-subtract trick
// (x - lo) <=u (hi - lo). v128 stays on the operand stack (no v128 local).
//   locals: i32 { 3: addr } ; i64 { 4: p, 5: n, 6: byte }
export fn gen_simd_scan_alnum_body(enable_rc: Bool, is_string: Bool) -> Bytes {
  let b = bytebuf_new()
  // addr = pointer to the byte payload. Bytes: the payload pointer lives at
  // obj+8. String: the value packs (ptr|len) with char data at (value >> 32).
  emit_local_get(b, 0)
  if is_string {
    emit_i64_const(b, 32)
    emit_i64_shr_s(b)
    emit_i32_wrap_i64(b)
  } else {
    emit_i32_wrap_i64(b)
    emit_i32_load(b, 2, 8)
  }
  emit_local_set(b, 3)
  // p = untag(pos)
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_local_set(b, 4)
  // n = untag(len)
  emit_local_get(b, 2)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_local_set(b, 5)
  // --- SIMD fast path: skip 16-byte chunks that are entirely identifier bytes ---
  emit_block_void(b)
  emit_loop_void(b)
  // if p + 16 > n: leave the fast path
  emit_local_get(b, 4)
  emit_i64_const(b, 16)
  emit_i64_add(b)
  emit_local_get(b, 5)
  emit_i64_gt_s(b)
  emit_br_if(b, 1)
  // digit: (x - 0x30) <=u 9
  emit_local_get(b, 3)
  emit_local_get(b, 4)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_v128_load(b, 0, 0)
  emit_i64_const(b, 48)
  emit_i32_wrap_i64(b)
  emit_i8x16_splat(b)
  emit_i8x16_sub(b)
  emit_i64_const(b, 9)
  emit_i32_wrap_i64(b)
  emit_i8x16_splat(b)
  emit_i8x16_le_u(b)
  // upper: (x - 0x41) <=u 25
  emit_local_get(b, 3)
  emit_local_get(b, 4)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_v128_load(b, 0, 0)
  emit_i64_const(b, 65)
  emit_i32_wrap_i64(b)
  emit_i8x16_splat(b)
  emit_i8x16_sub(b)
  emit_i64_const(b, 25)
  emit_i32_wrap_i64(b)
  emit_i8x16_splat(b)
  emit_i8x16_le_u(b)
  emit_v128_or(b)
  // lower: (x - 0x61) <=u 25
  emit_local_get(b, 3)
  emit_local_get(b, 4)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_v128_load(b, 0, 0)
  emit_i64_const(b, 97)
  emit_i32_wrap_i64(b)
  emit_i8x16_splat(b)
  emit_i8x16_sub(b)
  emit_i64_const(b, 25)
  emit_i32_wrap_i64(b)
  emit_i8x16_splat(b)
  emit_i8x16_le_u(b)
  emit_v128_or(b)
  // underscore: x == 0x5F
  emit_local_get(b, 3)
  emit_local_get(b, 4)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_v128_load(b, 0, 0)
  emit_i64_const(b, 95)
  emit_i32_wrap_i64(b)
  emit_i8x16_splat(b)
  emit_i8x16_eq(b)
  emit_v128_or(b)
  // non-identifier bitmask: bit set => byte is NOT an identifier byte
  emit_v128_not(b)
  emit_i8x16_bitmask(b)
  // if any non-identifier byte in this chunk, hand off to the scalar tail
  emit_br_if(b, 1)
  // whole chunk is identifier bytes: advance 16 and continue
  emit_local_get(b, 4)
  emit_i64_const(b, 16)
  emit_i64_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  // --- scalar tail: advance p while p < n and buf[p] is an identifier byte ---
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i64_ge_s(b)
  emit_br_if(b, 1)
  // byte = load8u(addr + p), widened to i64
  emit_local_get(b, 3)
  emit_local_get(b, 4)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i64_extend_i32_u(b)
  emit_local_set(b, 6)
  // is_id = digit + upper + lower + underscore (mutually exclusive => 0 or 1).
  // each range is (byte >= lo) * (byte <= hi) via i64 compares + i32.mul.
  emit_local_get(b, 6)
  emit_i64_const(b, 48)
  emit_i64_ge_s(b)
  emit_local_get(b, 6)
  emit_i64_const(b, 57)
  emit_i64_le_s(b)
  emit_i32_mul(b)
  emit_local_get(b, 6)
  emit_i64_const(b, 65)
  emit_i64_ge_s(b)
  emit_local_get(b, 6)
  emit_i64_const(b, 90)
  emit_i64_le_s(b)
  emit_i32_mul(b)
  emit_i32_add(b)
  emit_local_get(b, 6)
  emit_i64_const(b, 97)
  emit_i64_ge_s(b)
  emit_local_get(b, 6)
  emit_i64_const(b, 122)
  emit_i64_le_s(b)
  emit_i32_mul(b)
  emit_i32_add(b)
  emit_local_get(b, 6)
  emit_i64_const(b, 95)
  emit_i64_eq(b)
  emit_i32_add(b)
  // if NOT an identifier byte, stop
  emit_i32_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 4)
  emit_i64_const(b, 1)
  emit_i64_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  // return tag(p)
  emit_local_get(b, 4)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  b
}

export fn gen_bytes_new_body() -> Bytes {
  let b = bytebuf_new()
  emit_global_get(b, 0)
  emit_local_tee(b, 0)
  emit_i32_const(b, 76)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_heap_memory_grow_check(b)
  emit_local_get(b, 0)
  emit_i32_const(b, 0 - 64)
  emit_i32_store(b, 2, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 0)
  emit_i32_store(b, 2, 4)
  emit_local_get(b, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_i32_store(b, 2, 8)
  emit_local_get(b, 0)
  emit_i64_extend_i32_u(b)
  b
}

export fn gen_bytes_set_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  // #811: unsigned bounds check (idx as u32 >= len traps; negatives too).
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)
  emit_i32_ge_u(b)
  emit_if_void(b)
  bytebuf_push(b, 0)
  emit_end(b)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 3)
  emit_local_get(b, 3)
  emit_local_get(b, 1)
  // ADR-0055 Stage 1: index arrives tagged; untag before use.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_local_get(b, 2)
  // ADR-0055 Stage 1: byte value arrives tagged; untag before storing.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_store8(b, 0, 0)
  b
}

export fn gen_bytes_blit_body(enable_rc: Bool, bytes_get_idx: Int, bytes_push_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 2)
  // ADR-0055 Stage 1: start/end indices arrive tagged; untag for loop bounds.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_local_get(b, 3)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 1)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  // ADR-0055 Stage 1: tag the index passed to the value-world bytes_get.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, bytes_get_idx)
  emit_call(b, bytes_push_idx)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  b
}

export fn gen_bytes_fill_body(enable_rc: Bool, bytes_push_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_i32_const(b, 0)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  // ADR-0055 Stage 1: count arrives tagged; untag for the loop bound. The byte
  // value (local 1) is passed straight to the value-world bytes_push, which
  // untags it itself.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 4)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 1)
  emit_call(b, bytes_push_idx)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  b
}

export fn gen_bytes_push_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 0)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 4)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 5)
  emit_i32_const(b, 0)
  emit_local_get(b, 3)
  emit_i32_sub(b)
  emit_local_set(b, 7)
  emit_local_get(b, 4)
  emit_local_get(b, 7)
  emit_i32_ge_u(b)
  emit_if_void(b)
  emit_local_get(b, 7)
  emit_i32_const(b, 2)
  emit_i32_mul(b)
  emit_local_set(b, 7)
  emit_global_get(b, 0)
  emit_local_tee(b, 6)
  emit_local_get(b, 7)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_heap_memory_grow_check(b)
  emit_local_get(b, 6)
  emit_local_get(b, 5)
  emit_local_get(b, 4)
  emit_memory_copy(b)
  emit_local_get(b, 2)
  emit_i32_const(b, 0)
  emit_local_get(b, 7)
  emit_i32_sub(b)
  emit_i32_store(b, 2, 0)
  emit_local_get(b, 2)
  emit_local_get(b, 6)
  emit_i32_store(b, 2, 8)
  emit_local_get(b, 6)
  emit_local_set(b, 5)
  emit_end(b)
  emit_local_get(b, 5)
  emit_local_get(b, 4)
  emit_i32_add(b)
  emit_local_get(b, 1)
  // ADR-0055 Stage 1: byte value arrives tagged; untag before storing.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 4)
  b
}

export fn gen_bytes_slice_body(enable_rc: Bool, bytes_new_idx: Int, bytes_get_idx: Int, bytes_push_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_call(b, bytes_new_idx)
  emit_local_set(b, 5)
  emit_local_get(b, 1)
  // ADR-0055 Stage 1: start/end indices arrive tagged; untag for loop bounds.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 4)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 5)
  emit_local_get(b, 0)
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  // ADR-0055 Stage 1: tag the index passed to the value-world bytes_get.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, bytes_get_idx)
  emit_call(b, bytes_push_idx)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 5)
  b
}

export fn gen_arr_push_all_body(enable_rc: Bool, rc_alloc_idx: Int, rc_shadow: Bool) -> Bytes {
  let b = bytebuf_new()
  if enable_rc {
    // ADR-0055 Stage 4: in-place append that keeps `a` a valid RC array. Untag
    // both pointers; grow via __rc_alloc into a headered data block (freeing the
    // old grown buffer to the free-list, mirroring gen_arr_push); and guard-dup
    // each appended element from `b` so both `a` and `b` can be dropped safely.
    // locals: 2=a_val 3=b_val 4=len_a 5=len_b 6=data_a 7=data_b 8=cap_a
    //         9=newcap 10=block 11=i (i32), 12=elem (i64).
    emit_local_get(b, 0)
    emit_i64_const(b, -2)
    emit_i64_and(b)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 2)
    emit_local_get(b, 1)
    emit_i64_const(b, -2)
    emit_i64_and(b)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 3)
    emit_local_get(b, 2)
    emit_i32_load(b, 2, 4)
    emit_local_set(b, 4)
    emit_local_get(b, 3)
    emit_i32_load(b, 2, 4)
    emit_local_set(b, 5)
    emit_local_get(b, 2)
    emit_i32_load(b, 2, 8)
    emit_local_set(b, 6)
    emit_local_get(b, 3)
    emit_i32_load(b, 2, 8)
    emit_local_set(b, 7)
    emit_local_get(b, 2)
    emit_i32_load(b, 2, 0)
    emit_local_set(b, 8)
    // if (len_a + len_b > cap_a): grow
    emit_local_get(b, 4)
    emit_local_get(b, 5)
    emit_i32_add(b)
    emit_local_get(b, 8)
    emit_i32_gt_u(b)
    emit_if_void(b)
    // newcap = (len_a+len_b)*2
    emit_local_get(b, 4)
    emit_local_get(b, 5)
    emit_i32_add(b)
    emit_i32_const(b, 2)
    emit_i32_mul(b)
    emit_local_set(b, 9)
    // block = wrap(__rc_alloc(newcap*8 + 8)); data lives at block+8
    emit_local_get(b, 9)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_i64_extend_i32_u(b)
    emit_call(b, rc_alloc_idx)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 10)
    emit_local_get(b, 10)
    emit_local_get(b, 9)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_i32_store(b, 2, 0)
    // copy old elements into block+8
    emit_local_get(b, 10)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_local_get(b, 6)
    emit_local_get(b, 4)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_memory_copy(b)
    // free old buffer if it was a separate grown block (data_a != a_val+12)
    emit_local_get(b, 6)
    emit_local_get(b, 2)
    emit_i32_const(b, 12)
    emit_i32_add(b)
    emit_i32_ne(b)
    emit_if_void(b)
    // #715 recurrence guard (VIBE_RC=shadow): double-free check for the
    // grown buffer -- a second free-list push of the same buffer makes two
    // later allocations return overlapping memory (type confusion), which
    // plain marking cannot catch. Works under quarantine too (marks are
    // permanent).
    if rc_shadow {
      emit_local_get(b, 6)
      emit_i32_const(b, rc_shadow_base())
      emit_i32_add(b)
      emit_i32_load8_u(b, 0, 0)
      emit_if_void(b)
      bytebuf_push(b, 0)
      emit_end(b)
    } else {
      ()
    }
    // #715 recurrence guard (VIBE_RC=shadow): mark the old grown buffer freed.
    if rc_shadow {
      emit_local_get(b, 6)
      emit_i32_const(b, rc_shadow_base())
      emit_i32_add(b)
      emit_i32_const(b, 1)
      emit_i32_store8(b, 0, 0)
    } else {
      ()
    }
    emit_local_get(b, 6)
    emit_i32_const(b, 4)
    emit_i32_sub(b)
    emit_global_get(b, 2)
    emit_i32_store(b, 2, 0)
    emit_local_get(b, 6)
    emit_global_set(b, 2)
    emit_end(b)
    // cap = newcap; data_ptr = block+8; data_a = block+8
    emit_local_get(b, 2)
    emit_local_get(b, 9)
    emit_i32_store(b, 2, 0)
    emit_local_get(b, 2)
    emit_local_get(b, 10)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_i32_store(b, 2, 8)
    emit_local_get(b, 10)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_local_set(b, 6)
    emit_end(b)
    // copy b's elements into data_a + len_a*8
    emit_local_get(b, 6)
    emit_local_get(b, 4)
    emit_i32_const(b, 3)
    bytebuf_push(b, 116)
    emit_i32_add(b)
    emit_local_get(b, 7)
    emit_local_get(b, 5)
    emit_i32_const(b, 3)
    bytebuf_push(b, 116)
    emit_memory_copy(b)
    // len = len_a + len_b
    emit_local_get(b, 2)
    emit_local_get(b, 4)
    emit_local_get(b, 5)
    emit_i32_add(b)
    emit_i32_store(b, 2, 4)
    // dup each appended element from b (guarded: odd && high32==0)
    emit_i32_const(b, 0)
    emit_local_set(b, 11)
    emit_block_void(b)
    emit_loop_void(b)
    emit_local_get(b, 11)
    emit_local_get(b, 5)
    emit_i32_ge_u(b)
    emit_br_if(b, 1)
    emit_local_get(b, 7)
    emit_local_get(b, 11)
    emit_i32_const(b, 3)
    bytebuf_push(b, 116)
    emit_i32_add(b)
    emit_i64_load(b, 3, 0)
    emit_local_set(b, 12)
    emit_local_get(b, 12)
    emit_i64_const(b, 1)
    emit_i64_and(b)
    emit_i32_wrap_i64(b)
    emit_if_void(b)
    emit_local_get(b, 12)
    emit_i64_const(b, 32)
    emit_i64_shr_s(b)
    emit_i64_eqz(b)
    emit_if_void(b)
    // #715 recurrence guard (VIBE_RC=shadow): trap on dup-of-freed element.
    if rc_shadow {
      emit_local_get(b, 12)
      emit_i64_const(b, -2)
      emit_i64_and(b)
      emit_i32_wrap_i64(b)
      emit_i32_const(b, rc_shadow_base())
      emit_i32_add(b)
      emit_i32_load8_u(b, 0, 0)
      emit_if_void(b)
      bytebuf_push(b, 0)
      emit_end(b)
    } else {
      ()
    }
    emit_rc_word_inc_saturating(b, () -> {
      emit_local_get(b, 12)
      emit_i64_const(b, -2)
      emit_i64_and(b)
      emit_i32_wrap_i64(b)
      emit_i32_const(b, 4)
      emit_i32_sub(b)
    })
    emit_end(b)
    emit_end(b)
    emit_local_get(b, 11)
    emit_i32_const(b, 1)
    emit_i32_add(b)
    emit_local_set(b, 11)
    emit_br(b, 0)
    emit_end(b)
    emit_end(b)
  } else {
    emit_local_get(b, 0)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 2)
    emit_local_get(b, 1)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 3)
    emit_local_get(b, 2)
    emit_i32_load(b, 2, 4)
    emit_local_set(b, 4)
    emit_local_get(b, 3)
    emit_i32_load(b, 2, 4)
    emit_local_set(b, 5)
    emit_local_get(b, 2)
    emit_i32_load(b, 2, 8)
    emit_local_set(b, 6)
    emit_local_get(b, 3)
    emit_i32_load(b, 2, 8)
    emit_local_set(b, 7)
    emit_local_get(b, 2)
    emit_i32_load(b, 2, 0)
    emit_local_set(b, 8)
    emit_local_get(b, 4)
    emit_local_get(b, 5)
    emit_i32_add(b)
    emit_local_get(b, 8)
    emit_i32_gt_u(b)
    emit_if_void(b)
    emit_local_get(b, 4)
    emit_local_get(b, 5)
    emit_i32_add(b)
    emit_i32_const(b, 2)
    emit_i32_mul(b)
    emit_local_set(b, 9)
    emit_global_get(b, 0)
    emit_local_tee(b, 10)
    emit_local_get(b, 9)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_i32_add(b)
    emit_global_set(b, 0)
    emit_heap_memory_grow_check(b)
    emit_local_get(b, 10)
    emit_local_get(b, 6)
    emit_local_get(b, 4)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_memory_copy(b)
    emit_local_get(b, 2)
    emit_local_get(b, 9)
    emit_i32_store(b, 2, 0)
    emit_local_get(b, 2)
    emit_local_get(b, 10)
    emit_i32_store(b, 2, 8)
    emit_local_get(b, 10)
    emit_local_set(b, 6)
    emit_end(b)
    emit_local_get(b, 6)
    emit_local_get(b, 4)
    emit_i32_const(b, 3)
    bytebuf_push(b, 116)
    emit_i32_add(b)
    emit_local_get(b, 7)
    emit_local_get(b, 5)
    emit_i32_const(b, 3)
    bytebuf_push(b, 116)
    emit_memory_copy(b)
    emit_local_get(b, 2)
    emit_local_get(b, 4)
    emit_local_get(b, 5)
    emit_i32_add(b)
    emit_i32_store(b, 2, 4)
  }
  b
}

export fn gen_bytes_append_body(enable_rc: Bool, bytes_len_idx: Int, bytes_get_idx: Int, bytes_push_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 1)
  emit_call(b, bytes_len_idx)
  // ADR-0055 Stage 1: bytes_len now returns a tagged count; untag for the bound.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_i32_const(b, 0)
  emit_local_set(b, 3)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 1)
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  // ADR-0055 Stage 1: tag the index passed to the value-world bytes_get.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, bytes_get_idx)
  emit_call(b, bytes_push_idx)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  b
}

export fn gen_bytes_concat_body(bytes_new_idx: Int, bytes_append_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_call(b, bytes_new_idx)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_local_get(b, 0)
  emit_call(b, bytes_append_idx)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_call(b, bytes_append_idx)
  emit_local_get(b, 2)
  b
}

export fn gen_bytes_to_array_body(enable_rc: Bool, arr_new_idx: Int, arr_push_idx: Int, bytes_len_idx: Int, bytes_get_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_call(b, arr_new_idx)
  emit_local_set(b, 3)
  emit_local_get(b, 0)
  emit_call(b, bytes_len_idx)
  // ADR-0055 Stage 1: bytes_len now returns a tagged count; untag for the bound.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 1)
  emit_i32_const(b, 0)
  emit_local_set(b, 2)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 3)
  emit_local_get(b, 0)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  // ADR-0055 Stage 1: tag the index passed to value-world bytes_get. The byte
  // it returns is tagged, which is exactly what arr_push stores.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, bytes_get_idx)
  emit_call(b, arr_push_idx)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 2)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 3)
  b
}

export fn gen_bytes_from_array_body(enable_rc: Bool, arr_len_idx: Int, arr_get_idx: Int, bytes_new_idx: Int, bytes_push_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_call(b, bytes_new_idx)
  emit_local_set(b, 3)
  emit_local_get(b, 0)
  emit_call(b, arr_len_idx)
  // ADR-0055 Stage 1: arr_len now returns a tagged count; untag for the bound.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 1)
  emit_i32_const(b, 0)
  emit_local_set(b, 2)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 3)
  emit_local_get(b, 0)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  // ADR-0055 Stage 1: tag the index passed to value-world arr_get. The value it
  // returns is tagged, which is exactly what the value-world bytes_push untags.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, arr_get_idx)
  emit_call(b, bytes_push_idx)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 2)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 3)
  b
}
