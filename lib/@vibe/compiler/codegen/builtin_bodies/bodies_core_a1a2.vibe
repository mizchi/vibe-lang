//# Functions

export fn gen_arr_get_body(enable_rc: Bool, oob_prefix_fat: Int, oob_abort_idx: Int) -> Bytes {
  let b = bytebuf_new()
  // #811: bounds check — an out-of-range (or negative) index silently read
  // adjacent memory ([1,2,3][5] returned garbage). One UNSIGNED compare
  // catches both directions (idx as u32 >= len rejects negatives too) and
  // traps via `unreachable`.
  //
  // #2199: before the trap, call __rt_oob_abort with this operation's
  // prefix, the signed index, and the length -- a bare `unreachable` is
  // indistinguishable from a compiler bug to the reader, and the two values
  // turn "my index is wrong" into "index 10 against length 3".
  // `oob_prefix_fat` is the prefix's raw (ptr<<32)|len string-table constant
  // (exactly what __rt_print_str takes on both lanes; no RC tag is involved
  // in either) and `oob_abort_idx` the abort helper's function index. Pass
  // oob_abort_idx < 0 to omit the call and emit the historical bare-trap
  // body (the static twin pins that form).
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_get(b, 0)
  if enable_rc {
    emit_i64_const(b, -2)
    emit_i64_and(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)
  emit_i32_ge_u(b)
  emit_if_void(b)
  if oob_abort_idx >= 0 {
    emit_i64_const(b, oob_prefix_fat)
    emit_local_get(b, 1)
    if enable_rc {
      emit_i64_const(b, 1)
      emit_i64_shr_s(b)
    }
    emit_local_get(b, 0)
    if enable_rc {
      emit_i64_const(b, -2)
      emit_i64_and(b)
    }
    emit_i32_wrap_i64(b)
    emit_i32_load(b, 2, 4)
    emit_i64_extend_i32_u(b)
    emit_call(b, oob_abort_idx)
  } else {
    ()
  }
  bytebuf_push(b, 0)
  emit_end(b)
  emit_local_get(b, 0)
  // ADR-0055 Stage 2b: array value is an odd pointer; untag before use.
  if enable_rc {
    emit_i64_const(b, -2)
    emit_i64_and(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  // ADR-0055 Stage 1: the index arrives tagged (n<<1); untag before use.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_i32_add(b)
  emit_i64_load(b, 3, 0)
  b
}

export fn gen_arr_len_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  // ADR-0055 Stage 2b: array value is an odd pointer; untag before use.
  if enable_rc {
    emit_i64_const(b, -2)
    emit_i64_and(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)
  emit_i64_extend_i32_u(b)
  // ADR-0055 Stage 1: length is a count entering the value world; tag it.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  b
}

export fn gen_arr_new_body(enable_rc: Bool, rc_alloc_idx: Int) -> Bytes {
  let b = bytebuf_new()
  if enable_rc {
    // ADR-0055 Stage 2c: give array_new the same RC block header as literal
    // arrays ([alloc_size@0][rc_count@4][class@7]), value = block+8, so EVERY
    // odd array pointer is self-describing and the recursive rc_drop can reach
    // it safely. capacity 8, length 0, data_ptr = value+12 (block+20), inline
    // buffer 8 slots → total 84 (== a cap-8 literal, so the free-list reuses it).
    // ADR-0055 Stage 4: allocate via the free-list search helper (vibe_rc_alloc) so
    // a freed array block is reused — a raw bump leaks one block per array_new in
    // a build-and-discard loop.
    emit_i64_const(b, 84)
    emit_call(b, rc_alloc_idx)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 0)
    emit_local_get(b, 0)
    emit_i32_const(b, 84)
    emit_i32_store(b, 2, 0)
    emit_local_get(b, 0)
    emit_i32_const(b, 1)
    emit_i32_store(b, 2, 4)
    emit_local_get(b, 0)
    emit_i32_const(b, 5)
    emit_i32_store8(b, 0, 7)
    emit_local_get(b, 0)
    emit_i32_const(b, 8)
    emit_i32_store(b, 2, 8)
    emit_local_get(b, 0)
    emit_i32_const(b, 0)
    emit_i32_store(b, 2, 12)
    emit_local_get(b, 0)
    emit_local_get(b, 0)
    emit_i32_const(b, 20)
    emit_i32_add(b)
    emit_i32_store(b, 2, 16)
    emit_local_get(b, 0)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_i64_extend_i32_u(b)
    emit_i64_const(b, 1)
    emit_i64_or(b)
  } else {
    // Non-RC (bump) lane: [capacity@0][length@4][data_ptr@8] + an inline slot
    // buffer at +12. The bump allocator never frees, so the inline buffer is
    // paid for whether or not anything is ever pushed -- and `array_empty()`
    // (`ArrayBuilder::freeze(ArrayBuilder::new())`, 1,953 call sites in the
    // compiler source) lands here for every empty AST field.
    //
    // Default capacity is 2, not 8: measured on the selfcompile KPI input
    // (cold cache, docs/perf-snapshot-2026-08-07.md §3.1), 8 -> 4 -> 2 moves
    // heap_ptr_bytes 1,167,101,072 -> 1,051,249,096 -> 1,005,293,432
    // (-9.9%, -13.9%). Regrow is `newcap = cap * 2` and the bump lane leaks
    // the old buffer, so a smaller default is only a win if most arrays stay
    // short -- across a whole compile they do. They do NOT everywhere: the
    // lexer's token arrays grow far past 8, and `lex_checker_vibe`'s
    // bytes_per_op is byte-identical (2,198,112) at cap 2 and cap 8.
    //
    // The RC branch above keeps capacity 8: its free list reuses blocks by
    // size class, so the same reasoning does not carry over unmeasured.
    emit_global_get(b, 0)
    emit_local_tee(b, 0)
    emit_i32_const(b, 28)
    emit_i32_add(b)
    emit_global_set(b, 0)
    emit_heap_memory_grow_check(b)
    emit_local_get(b, 0)
    emit_i32_const(b, 2)
    emit_i32_store(b, 2, 0)
    emit_local_get(b, 0)
    emit_i32_const(b, 0)
    emit_i32_store(b, 2, 4)
    emit_local_get(b, 0)
    emit_local_get(b, 0)
    emit_i32_const(b, 12)
    emit_i32_add(b)
    emit_i32_store(b, 2, 8)
    emit_local_get(b, 0)
    emit_i64_extend_i32_u(b)
  }
  b
}

/// ADR-0090 (#1262): `MutList::empty(r)` on the bump lane. Same block layout
/// as the non-RC `gen_arr_new_body` -- `[capacity@0][length@4][data_ptr@8]`
/// plus an inline 2-slot buffer at +12, 28 bytes total -- but bumped out of
/// the region arena segment instead of the main heap, so `__region_run` can
/// release the whole segment by resetting one word.
///
/// Arena exhaustion is NOT an error. It falls back to the main bump heap,
/// which is byte-for-byte what this call did before the arena existed: the
/// region simply gets no reclamation for the blocks that did not fit. A trap
/// here would turn "your region got big" into a crash, and a silent wrap
/// would corrupt the heap above the segment -- the fallback is the only
/// option that keeps the arena a pure optimization.
///
/// Locals: 0 = block pointer, 1 = arena bump pointer.
export fn gen_region_arr_new_body(region_ptr_addr: Int, region_data_base: Int, region_limit: Int) -> Bytes {
  let b = bytebuf_new()
  // local1 = load(region_ptr_addr); zero means "never entered" (linear memory
  // is zero-page initialized and the data segments end below heap_start), so
  // seed it with the segment base rather than paying for a start-function.
  emit_i32_const(b, region_ptr_addr)
  emit_i32_load(b, 2, 0)
  emit_local_set(b, 1)
  emit_local_get(b, 1)
  emit_i32_eqz(b)
  emit_if_void(b)
  emit_i32_const(b, region_data_base)
  emit_local_set(b, 1)
  emit_end(b)
  emit_local_get(b, 1)
  emit_i32_const(b, 28)
  emit_i32_add(b)
  emit_i32_const(b, region_limit)
  emit_i32_gt_u(b)
  emit_if_void(b)
  // Arena full: main-heap bump, exactly the pre-arena path.
  emit_global_get(b, 0)
  emit_local_tee(b, 0)
  emit_i32_const(b, 28)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_heap_memory_grow_check(b)
  emit_else(b)
  emit_local_get(b, 1)
  emit_local_set(b, 0)
  emit_i32_const(b, region_ptr_addr)
  emit_local_get(b, 1)
  emit_i32_const(b, 28)
  emit_i32_add(b)
  emit_i32_store(b, 2, 0)
  emit_end(b)
  emit_local_get(b, 0)
  emit_i32_const(b, 2)
  emit_i32_store(b, 2, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 0)
  emit_i32_store(b, 2, 4)
  emit_local_get(b, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_i32_store(b, 2, 8)
  emit_local_get(b, 0)
  emit_i64_extend_i32_u(b)
  b
}

/// ADR-0090 MutBytes: `MutBytes::empty(r)` allocated from the region arena.
/// Mirrors gen_region_arr_new_body above, with the Bytes block shape from
/// gen_bytes_new_body: 76 bytes = [-capacity(64)@0][length(0)@4][data@8 ->
/// block+12 inline buffer]. Same "never entered" seed and same main-heap
/// fallback when the segment is exhausted (less reclamation, never a wrong
/// answer). 76 keeps the arena bump 4-aligned, matching the 28-byte arr
/// blocks; regrows bump by multiples of 8 (see gen_bytes_push_body).
export fn gen_region_bytes_new_body(region_ptr_addr: Int, region_data_base: Int, region_limit: Int) -> Bytes {
  let b = bytebuf_new()
  emit_i32_const(b, region_ptr_addr)
  emit_i32_load(b, 2, 0)
  emit_local_set(b, 1)
  emit_local_get(b, 1)
  emit_i32_eqz(b)
  emit_if_void(b)
  emit_i32_const(b, region_data_base)
  emit_local_set(b, 1)
  emit_end(b)
  emit_local_get(b, 1)
  emit_i32_const(b, 76)
  emit_i32_add(b)
  emit_i32_const(b, region_limit)
  emit_i32_gt_u(b)
  emit_if_void(b)
  emit_global_get(b, 0)
  emit_local_tee(b, 0)
  emit_i32_const(b, 76)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_heap_memory_grow_check(b)
  emit_else(b)
  emit_local_get(b, 1)
  emit_local_set(b, 0)
  emit_i32_const(b, region_ptr_addr)
  emit_local_get(b, 1)
  emit_i32_const(b, 76)
  emit_i32_add(b)
  emit_i32_store(b, 2, 0)
  emit_end(b)
  emit_local_get(b, 0)
  emit_i32_const(b, 0 - 64)
  emit_i32_store(b, 2, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 0)
  emit_i32_store(b, 2, 4)
  emit_local_get(b, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_i32_store(b, 2, 8)
  emit_local_get(b, 0)
  emit_i64_extend_i32_u(b)
  b
}

export fn gen_arr_set_body(enable_rc: Bool, oob_prefix_fat: Int, oob_abort_idx: Int) -> Bytes {
  let b = bytebuf_new()
  // #811: same unsigned bounds check as gen_arr_get_body — an OOB set
  // silently corrupted adjacent memory. #2199: same formatted abort as
  // gen_arr_get_body (see its comment); oob_abort_idx < 0 omits the call.
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_get(b, 0)
  if enable_rc {
    emit_i64_const(b, -2)
    emit_i64_and(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)
  emit_i32_ge_u(b)
  emit_if_void(b)
  if oob_abort_idx >= 0 {
    emit_i64_const(b, oob_prefix_fat)
    emit_local_get(b, 1)
    if enable_rc {
      emit_i64_const(b, 1)
      emit_i64_shr_s(b)
    }
    emit_local_get(b, 0)
    if enable_rc {
      emit_i64_const(b, -2)
      emit_i64_and(b)
    }
    emit_i32_wrap_i64(b)
    emit_i32_load(b, 2, 4)
    emit_i64_extend_i32_u(b)
    emit_call(b, oob_abort_idx)
  } else {
    ()
  }
  bytebuf_push(b, 0)
  emit_end(b)
  emit_local_get(b, 0)
  // ADR-0055 Stage 2b: array value is an odd pointer; untag before use.
  if enable_rc {
    emit_i64_const(b, -2)
    emit_i64_and(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 3)
  emit_local_get(b, 3)
  emit_local_get(b, 1)
  // ADR-0055 Stage 1: the index arrives tagged (n<<1); untag before use.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_i32_add(b)
  emit_local_get(b, 2)
  emit_i64_store(b, 3, 0)
  b
}

/// Push the bin-head address for `ptr_local`'s block size:
/// bins_base + (((size - 16) >> 3) << 2). Pure push.
fn emit_rc_bin_addr(b: Bytes, ptr_local: Int, bins_base: Int) -> Unit {
  emit_local_get(b, ptr_local)
  emit_i32_const(b, 8)
  emit_i32_sub(b)
  emit_i32_load(b, 2, 0)
  emit_i32_const(b, 16)
  emit_i32_sub(b)
  emit_i32_const(b, 3)
  // i32.shr_u (0x76)
  bytebuf_push(b, 118)
  emit_i32_const(b, 2)
  // i32.shl (0x74)
  bytebuf_push(b, 116)
  emit_i32_const(b, bins_base)
  emit_i32_add(b)
}

/// Legacy LIFO free push onto global 2, linking through the rc word.
fn emit_rc_legacy_free_push(b: Bytes, ptr_local: Int) -> Unit {
  emit_local_get(b, ptr_local)
  emit_i32_const(b, 4)
  emit_i32_sub(b)
  emit_global_get(b, 2)
  emit_i32_store(b, 2, 0)
  emit_local_get(b, ptr_local)
  emit_global_set(b, 2)
}

/// ADR-0092 (#1262) size-segregated free-list bins: push the freed block in
/// `ptr_local` (a value pointer; header at ptr-8) onto its exact-size bin
/// when the block is small (size 16..264, 8-aligned -- 32 bins of 4 bytes
/// at `bins_base`, bin index (size-16)>>3), else onto the legacy global-2
/// list. The bin link reuses the rc word at ptr-4, same as the legacy list.
/// Pure emission; recomputes size/bin address instead of taking a scratch
/// local so callers' local layouts stay untouched.
fn emit_rc_free_push(b: Bytes, ptr_local: Int, bins_base: Int) -> Unit {
  // (size & 7) == 0 ?
  emit_local_get(b, ptr_local)
  emit_i32_const(b, 8)
  emit_i32_sub(b)
  emit_i32_load(b, 2, 0)
  emit_i32_const(b, 7)
  // i32.and (0x71)
  bytebuf_push(b, 113)
  emit_i32_eqz(b)
  emit_if_void(b)
  // (size - 16) <u 249 ?  [i.e. 16 <= size <= 264]
  emit_local_get(b, ptr_local)
  emit_i32_const(b, 8)
  emit_i32_sub(b)
  emit_i32_load(b, 2, 0)
  emit_i32_const(b, 16)
  emit_i32_sub(b)
  emit_i32_const(b, 249)
  // i32.lt_u (0x49)
  bytebuf_push(b, 73)
  emit_if_void(b)
  // store(ptr-4, load(binaddr)); store(binaddr, ptr)
  emit_local_get(b, ptr_local)
  emit_i32_const(b, 4)
  emit_i32_sub(b)
  emit_rc_bin_addr(b, ptr_local, bins_base)
  emit_i32_load(b, 2, 0)
  emit_i32_store(b, 2, 0)
  emit_rc_bin_addr(b, ptr_local, bins_base)
  emit_local_get(b, ptr_local)
  emit_i32_store(b, 2, 0)
  emit_else(b)
  emit_rc_legacy_free_push(b, ptr_local)
  emit_end(b)
  emit_else(b)
  emit_rc_legacy_free_push(b, ptr_local)
  emit_end(b)
}

/// ADR-0055 Stage 3: the generic recursive rc_drop helper (linear RC backend).
/// Signature (i64 value) -> (): decrement the value's reference count and, at
/// zero, recursively drop its heap fields before pushing the block onto the
/// free-list (global 2). `self_idx` is this function's own wasm index so it can
/// recurse into fields to arbitrary depth.
///
/// Value representation (ADR-0055): a heap pointer is odd (`(block+8)|1`); an
/// int/bool is even (`n<<1`). The block header is
///   [alloc_size@block+0][rc_count@block+4 (class id in high byte)] and
///   value = block+8 → live header at value-8 / value-4, payload at value+8.
/// The drop-class byte (value-1) is: 1 = field-vector (tuple/record/ctor/
/// closure: [_@value+0][count@value+4][fields@value+8+i*8]); 5 = array
/// (length@value+4, data_ptr@value+8, elements at data_ptr+i*8). Anything else
/// (leaf: int/bool/string/float/bare-fn, or an unheadered pointer) is freed
/// without following fields.
///
/// Locals: 0 = i64 v (param); 1 vptr, 2 class, 3 cnt, 4 idx, 5 dptr (i32);
/// 6 = i64 field value.
/// ADR-0092 (#1262): the out-of-line dup helper (`__rt_rc_dup`). One param
/// (local 0) = the tagged value; no extra locals; no result.
///
/// The body is emit_rc_dup_inline at local 0 -- literally the same emitter
/// the inline form uses -- so the out-of-line and inline dups can never
/// disagree about what a dup does, including the VIBE_RC=shadow
/// freed-block trap, which is baked in here per module instead of at every
/// site.
export fn gen_rc_dup_body(rc_shadow: Bool, uaf_abort_idx: Int, prefix_fat: Int) -> Bytes {
  let b = bytebuf_new()
  emit_rc_dup_inline(b, 0, rc_shadow, uaf_abort_idx, prefix_fat)
  b
}

export fn gen_rc_drop_body(self_idx: Int, rc_shadow: Bool, bins_base: Int, uaf_abort_idx: Int, prefix_fat: Int) -> Bytes {
  let b = bytebuf_new()
  // not a heap pointer (even) → nothing to do
  emit_local_get(b, 0)
  emit_i64_const(b, 1)
  emit_i64_and(b)
  emit_i64_eqz(b)
  emit_if_void(b)
  emit_return(b)
  emit_end(b)
  // string/bytes fat pointer ((offset<<32)|length): the data offset (>= 64)
  // lives in the high 32 bits, whereas every heap block address is < 2^32
  // (high 32 bits == 0). So if (v >> 32) != 0 it is a leaf fat pointer, not an
  // RC block → skip. (Values here are positive, so shr_s == shr_u.)
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i64_eqz(b)
  emit_i32_eqz(b)
  emit_if_void(b)
  emit_return(b)
  emit_end(b)
  // vptr = (v & -2) as i32  (untag the odd pointer to the value pointer)
  emit_local_get(b, 0)
  emit_i64_const(b, -2)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 1)
  // #715 recurrence guard (VIBE_RC=shadow): trap BEFORE the rc-- below if the
  // shadow byte says this block is already freed. For a freed block, vptr-4
  // is the free-list NEXT link, so a drop-of-freed would silently corrupt the
  // list (decrement the link) and usually return without reaching zero --
  // the entry check is the only reliable place to catch it. #1987: name the
  // current seq and the freeing seq instead of a bare unreachable.
  if rc_shadow {
    emit_shadow_bump_seq(b)
    emit_local_get(b, 1)
    emit_shadow_slot_from_vptr(b)
    emit_i32_load8_u(b, 0, 0)
    emit_if_void(b)
    emit_shadow_uaf_trap(b, () -> {
      emit_local_get(b, 1)
    }, uaf_abort_idx, prefix_fat)
    emit_end(b)
  } else {
    ()
  }
  // #720: a saturated rc (low 24 bits == 0xFFFFFF) marks an immortal block
  // (see emit_rc_word_inc_saturating) -- never decrement, never free.
  emit_local_get(b, 1)
  emit_i32_const(b, 4)
  emit_i32_sub(b)
  emit_i32_load(b, 2, 0)
  emit_i32_const(b, 16777215)
  bytebuf_push(b, 113)
  emit_i32_const(b, 16777215)
  emit_i32_eq(b)
  emit_if_void(b)
  emit_return(b)
  emit_end(b)
  // rc_count-- : store(vptr-4, load(vptr-4) - 1). The class byte is the high
  // byte of the same word; subtracting 1 from a non-zero rc never borrows into
  // it, so it is preserved.
  emit_local_get(b, 1)
  emit_i32_const(b, 4)
  emit_i32_sub(b)
  emit_local_get(b, 1)
  emit_i32_const(b, 4)
  emit_i32_sub(b)
  emit_i32_load(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_i32_store(b, 2, 0)
  // if rc (low 24 bits) != 0 → still referenced → return. `* 256` shifts the
  // class byte out of the 32-bit word so only rc is tested.
  emit_local_get(b, 1)
  emit_i32_const(b, 4)
  emit_i32_sub(b)
  emit_i32_load(b, 2, 0)
  emit_i32_const(b, 256)
  emit_i32_mul(b)
  emit_i32_eqz(b)
  emit_i32_eqz(b)
  emit_if_void(b)
  emit_return(b)
  emit_end(b)
  // class = load8u(vptr-1)
  emit_local_get(b, 1)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_i32_load8_u(b, 0, 0)
  emit_local_set(b, 2)
  // field-vector (class 1): for idx in 0..count: rc_drop(load_i64(vptr+8+idx*8))
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_eq(b)
  emit_if_void(b)
  emit_local_get(b, 1)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 3)
  emit_i32_const(b, 0)
  emit_local_set(b, 4)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_local_get(b, 3)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 1)
  emit_local_get(b, 4)
  emit_i32_const(b, 8)
  emit_i32_mul(b)
  emit_i32_add(b)
  emit_i64_load(b, 3, 8)
  emit_local_set(b, 6)
  emit_local_get(b, 6)
  emit_call(b, self_idx)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_end(b)
  // array (class 5): for idx in 0..length: rc_drop(load_i64(data_ptr+idx*8))
  emit_local_get(b, 2)
  emit_i32_const(b, 5)
  emit_i32_eq(b)
  emit_if_void(b)
  emit_local_get(b, 1)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 3)
  emit_local_get(b, 1)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 5)
  emit_i32_const(b, 0)
  emit_local_set(b, 4)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_local_get(b, 3)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 5)
  emit_local_get(b, 4)
  emit_i32_const(b, 8)
  emit_i32_mul(b)
  emit_i32_add(b)
  emit_i64_load(b, 3, 0)
  emit_local_set(b, 6)
  emit_local_get(b, 6)
  emit_call(b, self_idx)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  // ADR-0055 Stage 4: free a grown (separate) data buffer. An inline buffer sits
  // at value+12 (vptr+12) and is freed with the block; a buffer grown by
  // Array::push is a headered block of its own (data_ptr = its value pointer, so
  // size@data_ptr-8, next@data_ptr-4) — push onto the free-list head when
  // data_ptr != vptr+12. Elements were already dropped by the loop above.
  emit_local_get(b, 5)
  emit_local_get(b, 1)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_i32_ne(b)
  emit_if_void(b)
  // #715 recurrence guard (VIBE_RC=shadow): double-free check for the
  // grown buffer -- a second free-list push of the same buffer makes two
  // later allocations return overlapping memory (type confusion), which
  // plain marking cannot catch.
  if rc_shadow {
    emit_local_get(b, 5)
    emit_shadow_slot_from_vptr(b)
    emit_i32_load8_u(b, 0, 0)
    emit_if_void(b)
    emit_shadow_uaf_trap(b, () -> {
      emit_local_get(b, 5)
    }, uaf_abort_idx, prefix_fat)
    emit_end(b)
  } else {
    ()
  }
  // #715 / #1987: mark the grown buffer freed and stamp the freeing seq.
  if rc_shadow {
    emit_shadow_mark_freed(b, () -> {
      emit_local_get(b, 5)
    })
  } else {
    ()
  }
  emit_rc_free_push(b, 5, bins_base)
  emit_end(b)
  emit_end(b)
  // map (class 6): count@value+0, then `count` entries of (key@+8, val@+16) on a
  // 16-byte stride (MapBuilder layout). Recursively drop each key and val, then
  // fall through to the common block free. (cnt = local 3, idx = local 4.)
  emit_local_get(b, 2)
  emit_i32_const(b, 6)
  emit_i32_eq(b)
  emit_if_void(b)
  emit_local_get(b, 1)
  emit_i32_load(b, 2, 0)
  emit_local_set(b, 3)
  emit_i32_const(b, 0)
  emit_local_set(b, 4)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_local_get(b, 3)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 1)
  emit_local_get(b, 4)
  emit_i32_const(b, 16)
  emit_i32_mul(b)
  emit_i32_add(b)
  emit_i64_load(b, 3, 8)
  emit_local_set(b, 6)
  emit_local_get(b, 6)
  emit_call(b, self_idx)
  emit_local_get(b, 1)
  emit_local_get(b, 4)
  emit_i32_const(b, 16)
  emit_i32_mul(b)
  emit_i32_add(b)
  emit_i64_load(b, 3, 16)
  emit_local_set(b, 6)
  emit_local_get(b, 6)
  emit_call(b, self_idx)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_end(b)
  // #699 ref cell (class 8): a heap-boxed `let mut` holds a single value at
  // vptr+0. Drop it recursively (scalar payloads are a no-op via the odd-check),
  // then fall through to the common free.
  emit_local_get(b, 2)
  emit_i32_const(b, 8)
  emit_i32_eq(b)
  emit_if_void(b)
  emit_local_get(b, 1)
  emit_i64_load(b, 3, 0)
  emit_local_set(b, 6)
  emit_local_get(b, 6)
  emit_call(b, self_idx)
  emit_end(b)
  // closure (class 7): the env at vptr+8 holds `count`(@vptr+4) captures.
  // owned-captures ABI (ADR-0076 追記31 Vertical A): every capture is OWNED —
  // compile_lambda dups plain heap captures at creation and #699 ref cells
  // keep their odd-tagged unguarded inc — so drop each slot recursively,
  // exactly like the class-1 field-vector loop (the recursive call's own
  // entry checks skip scalars and string/bytes fat pointers, which received
  // no dup; that includes the old #769 hazard, since the probe that trapped
  // on odd-length captured strings is gone). The ONE exception is the
  // let-rec SELF capture: the binder patches the closure into its own env
  // without a dup (a dup would make the self-cycle unreclaimable), so skip
  // any slot whose untagged pointer is this block's own vptr. Then fall
  // through to the common free.
  emit_local_get(b, 2)
  emit_i32_const(b, 7)
  emit_i32_eq(b)
  emit_if_void(b)
  emit_local_get(b, 1)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 3)
  emit_i32_const(b, 0)
  emit_local_set(b, 4)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_local_get(b, 3)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 1)
  emit_local_get(b, 4)
  emit_i32_const(b, 8)
  emit_i32_mul(b)
  emit_i32_add(b)
  emit_i64_load(b, 3, 8)
  emit_local_set(b, 6)
  emit_local_get(b, 6)
  emit_i64_const(b, -2)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_get(b, 1)
  emit_i32_ne(b)
  emit_if_void(b)
  emit_local_get(b, 6)
  emit_call(b, self_idx)
  emit_end(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_end(b)
  // #715 / #1987: mark this block freed and stamp the freeing seq so a later
  // dup-of-freed or drop-of-freed can name both ends.
  if rc_shadow {
    emit_shadow_mark_freed(b, () -> {
      emit_local_get(b, 1)
    })
  } else {
    ()
  }
  // free: push the block onto its size bin (small) or the legacy global-2
  // list, reusing the rc slot (vptr-4) as the next pointer.
  emit_rc_free_push(b, 1, bins_base)
  b
}

/// ADR-0055 Stage 4: generic free-list allocator. Param 0 (i64) = block size in
/// bytes; returns the i64 block_start of a reusable block. The single LIFO
/// free-list (global 2) holds value pointers linked through the rc_count word
/// (cur-4) with the alloc_size at cur-8. A head-only size check (the previous
/// inline allocator) misses a matching block whenever it is not at the head — so
/// allocating sizes A,B,A,B... while freeing them recursively (which reverses the
/// order on the LIFO) bump-allocates every other block even though a perfectly
/// sized free block exists deeper in the list (a fragmentation "leak"). This
/// Push the bin-head address for the requested size in local 3:
/// bins_base + (((sz - 16) >> 3) << 2). Pure push (alloc-side sibling of
/// emit_rc_bin_addr, which reads the size from a block header instead).
fn emit_rc_alloc_bin_addr(b: Bytes, bins_base: Int) -> Unit {
  emit_local_get(b, 3)
  emit_i32_const(b, 16)
  emit_i32_sub(b)
  emit_i32_const(b, 3)
  // i32.shr_u (0x76)
  bytebuf_push(b, 118)
  emit_i32_const(b, 2)
  // i32.shl (0x74)
  bytebuf_push(b, 116)
  emit_i32_const(b, bins_base)
  emit_i32_add(b)
}

/// helper instead WALKS the list for an exact-fit block and unlinks it, falling
/// back to a bump only when none exists. Exact-fit only (no splitting), so it is
/// drop-in compatible with the recursive rc_drop free path.
///
/// ADR-0092 (#1262) KPI follow-up: the walk is BOUNDED to the first 16
/// nodes. The unbounded walk made every miss O(free-list length) -- on the
/// selfcompile workload the list grows to thousands of mixed-size nodes and
/// vibe_rc_alloc alone measured 44% of the whole compile's CPU (profile of
/// the RC-built stage2, 2026-07-31). A LIFO head keeps the most recent
/// frees first, so same-size churn (the common alloc/free loop pattern)
/// still hits within a few nodes; a deeper exact fit is abandoned in favor
/// of a bump, trading bounded fragmentation for O(1) allocation.
/// Locals: 0=size(i64 param) 1=cur 2=prev 3=sz(i32) 4=result 5=budget.
export fn gen_rc_alloc_body(rc_shadow: Bool, bins_base: Int) -> Bytes {
  let b = bytebuf_new()
  // sz = (i32) size
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  // ADR-0092 (#1262) size-segregated bins: a small aligned size (16..264,
  // 8-aligned) checks its exact-size bin first -- O(1) exact fit for the
  // dominant ctor-block traffic (matching gen_rc_drop_body's bin push).
  // Bin miss falls through to the bounded legacy walk below (which still
  // recycles blocks freed by the array/bytes grow paths onto global 2).
  emit_local_get(b, 3)
  emit_i32_const(b, 7)
  // i32.and (0x71)
  bytebuf_push(b, 113)
  emit_i32_eqz(b)
  emit_if_void(b)
  emit_local_get(b, 3)
  emit_i32_const(b, 16)
  emit_i32_sub(b)
  emit_i32_const(b, 249)
  // i32.lt_u (0x49)
  bytebuf_push(b, 73)
  emit_if_void(b)
  // result(4) = load(binaddr); if nonzero: unlink + return result-8
  emit_rc_alloc_bin_addr(b, bins_base)
  emit_i32_load(b, 2, 0)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_if_void(b)
  emit_rc_alloc_bin_addr(b, bins_base)
  emit_local_get(b, 4)
  emit_i32_const(b, 4)
  emit_i32_sub(b)
  emit_i32_load(b, 2, 0)
  emit_i32_store(b, 2, 0)
  if rc_shadow {
    emit_local_get(b, 4)
    emit_shadow_slot_from_vptr(b)
    emit_i32_const(b, 0)
    emit_i32_store(b, 2, 0)
  } else {
    ()
  }
  emit_local_get(b, 4)
  emit_i32_const(b, 8)
  emit_i32_sub(b)
  emit_i64_extend_i32_u(b)
  emit_return(b)
  emit_end(b)
  emit_end(b)
  emit_end(b)
  // cur = free-list head (global 2); prev = 0; budget = 16
  emit_global_get(b, 2)
  emit_local_set(b, 1)
  emit_i32_const(b, 0)
  emit_local_set(b, 2)
  emit_i32_const(b, 16)
  emit_local_set(b, 5)
  emit_block_void(b)
  emit_loop_void(b)
  // cur == 0 → not found, break to the bump path
  emit_local_get(b, 1)
  emit_i32_eqz(b)
  emit_br_if(b, 1)
  // budget == 0 → give up the walk, break to the bump path
  emit_local_get(b, 5)
  emit_i32_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 5)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 5)
  // load(cur-8) == sz → exact-fit block found
  emit_local_get(b, 1)
  emit_i32_const(b, 8)
  emit_i32_sub(b)
  emit_i32_load(b, 2, 0)
  emit_local_get(b, 3)
  emit_i32_eq(b)
  emit_if_void(b)
  // unlink cur: prev == 0 ? global2 = load(cur-4) : store(prev-4, load(cur-4))
  emit_local_get(b, 2)
  emit_i32_eqz(b)
  emit_if_void(b)
  emit_local_get(b, 1)
  emit_i32_const(b, 4)
  emit_i32_sub(b)
  emit_i32_load(b, 2, 0)
  emit_global_set(b, 2)
  emit_else(b)
  emit_local_get(b, 2)
  emit_i32_const(b, 4)
  emit_i32_sub(b)
  emit_local_get(b, 1)
  emit_i32_const(b, 4)
  emit_i32_sub(b)
  emit_i32_load(b, 2, 0)
  emit_i32_store(b, 2, 0)
  emit_end(b)
  // #715 recurrence guard (VIBE_RC=shadow): the block is live again -- clear
  // its freed-marker byte so later dups/drops of the reused block are legal.
  if rc_shadow {
    emit_local_get(b, 1)
    emit_shadow_slot_from_vptr(b)
    emit_i32_const(b, 0)
    emit_i32_store(b, 2, 0)
  } else {
    ()
  }
  // return block_start = cur - 8
  emit_local_get(b, 1)
  emit_i32_const(b, 8)
  emit_i32_sub(b)
  emit_i64_extend_i32_u(b)
  emit_return(b)
  emit_end(b)
  // prev = cur; cur = load(cur-4); continue
  emit_local_get(b, 1)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i32_const(b, 4)
  emit_i32_sub(b)
  emit_i32_load(b, 2, 0)
  emit_local_set(b, 1)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  // bump: result = global0; global0 += sz; return (i64) result
  emit_global_get(b, 0)
  emit_local_set(b, 4)
  emit_global_get(b, 0)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_heap_memory_grow_check(b)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  b
}

export fn gen_str_len_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  // ADR-0055 Stage 1: the length is a count entering the value world; tag it
  // (n<<1) under RC so the uniform caller-side untag recovers the true length.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  b
}
