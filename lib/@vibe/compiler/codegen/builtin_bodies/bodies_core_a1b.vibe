//# Imports

import ./array_capacity.vibe {
  emit_array_double_capacity, emit_array_heap_growth_check
}

import @vibe/compiler/core {
  bytebuf_new, bytebuf_push
}

import @vibe/compiler/codegen/common_analysis {
  emit_i64_extend_i32_u
}

import @vibe/compiler/codegen/common_base {
  emit_i32_eqz,
  emit_i32_ge_u,
  emit_i32_gt_u,
  emit_i32_mul,
  emit_i32_ne,
  emit_i32_sub,
  emit_i64_store,
  emit_shadow_mark_freed,
  emit_shadow_slot_from_vptr
}

import @vibe/compiler/codegen/common_extractors {
  emit_memory_copy
}

import @vibe/compiler/codegen/wasm_emit {
  emit_call,
  emit_else,
  emit_end,
  emit_global_get,
  emit_global_set,
  emit_heap_memory_grow_check,
  emit_i32_add,
  emit_i32_const,
  emit_i32_load,
  emit_i32_store,
  emit_i32_wrap_i64,
  emit_i64_add,
  emit_i64_and,
  emit_i64_const,
  emit_i64_gt_s,
  emit_i64_mul,
  emit_if_void,
  emit_local_get,
  emit_local_set,
  emit_local_tee
}

//# Functions

/// `arena_ptr_addr >= 0` selects the ADR-0090 region arena for the regrow
/// buffer (bump lane only -- see the layout comment in linked_compile.vibe).
/// The arena variant needs one extra i32 local (8) for the arena pointer, so
/// it is pushed with meta_i32 = 7; the plain variant is byte-identical to
/// what it emitted before the arena existed. Exhaustion falls back to the
/// main bump heap rather than trapping, so an oversized region loses
/// reclamation instead of correctness.
export fn gen_arr_push_body(enable_rc: Bool, rc_alloc_idx: Int, rc_shadow: Bool, arena_ptr_addr: Int, arena_data_base: Int, arena_limit: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  // ADR-0055 Stage 2b: array value is an odd pointer; untag once at the top
  // (everything downstream uses local 2 = the wrapped address).
  if enable_rc {
    emit_i64_const(b, -2)
    emit_i64_and(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 0)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 4)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 5)
  emit_local_get(b, 4)
  emit_local_get(b, 3)
  emit_i32_ge_u(b)
  emit_if_void(b)
  // newcap = cap * 2 (local 7)
  emit_array_double_capacity(b, 3, 7)
  if enable_rc {
    // ADR-0055 Stage 4: allocate the grown buffer as a HEADERED, reusable block
    // ([alloc_size@block+0], data_ptr = block+8) via vibe_rc_alloc, so it can be
    // freed/reused like any block. A raw-bump buffer has no header and leaks both
    // on every regrow and when the array is dropped.
    // block_start (local 6) = wrap(vibe_rc_alloc(newcap*8 + 8))
    emit_local_get(b, 7)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_i64_extend_i32_u(b)
    emit_call(b, rc_alloc_idx)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 6)
    // alloc_size header at block_start+0 (= newcap*8 + 8)
    emit_local_get(b, 6)
    emit_local_get(b, 7)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_i32_store(b, 2, 0)
    // copy old elements into the new buffer's data area (block_start+8)
    emit_local_get(b, 6)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_local_get(b, 5)
    emit_local_get(b, 4)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_memory_copy(b)
    // free the OLD buffer if it was a separate (grown) block, i.e. data_ptr
    // (local 5) != value+12 (the inline buffer at vptr+12). Push its value
    // pointer onto the free-list head (size@-8, next@-4 are already in place).
    emit_local_get(b, 5)
    emit_local_get(b, 2)
    emit_i32_const(b, 12)
    emit_i32_add(b)
    emit_i32_ne(b)
    emit_if_void(b)
    // #715 recurrence guard (VIBE_RC=shadow): double-free check for the
    // grown buffer -- a second free-list push of the same buffer makes two
    // later allocations return overlapping memory (type confusion), which
    // plain marking cannot catch.
    if rc_shadow {
      emit_local_get(b, 5)
      emit_shadow_slot_from_vptr(b)
      emit_i32_load(b, 2, 0)
      emit_if_void(b)
      bytebuf_push(b, 0)
      emit_end(b)
    } else {
      ()
    }
    // #715 recurrence guard (VIBE_RC=shadow): mark the old grown buffer freed.
    if rc_shadow {
      emit_shadow_mark_freed(b, () -> {
        emit_local_get(b, 5)
      })
    } else {
      ()
    }
    emit_local_get(b, 5)
    emit_i32_const(b, 4)
    emit_i32_sub(b)
    emit_global_get(b, 2)
    emit_i32_store(b, 2, 0)
    emit_local_get(b, 5)
    emit_global_set(b, 2)
    emit_end(b)
    // capacity = newcap; data_ptr = block_start+8; local5 = block_start+8
    emit_local_get(b, 2)
    emit_local_get(b, 7)
    emit_i32_store(b, 2, 0)
    emit_local_get(b, 2)
    emit_local_get(b, 6)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_i32_store(b, 2, 8)
    emit_local_get(b, 6)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_local_set(b, 5)
  } else {
    // non-RC: raw-bump a headerless buffer (never freed — the default path does
    // not reclaim). ADR-0090: inside a region the buffer comes from the arena
    // segment instead, so the whole growth history is released with the
    // region rather than leaked for the rest of the program.
    let emit_main_heap_bump: () -> Unit = () -> {
      emit_array_heap_growth_check(b, 7)
      emit_global_get(b, 0)
      emit_local_tee(b, 6)
      emit_local_get(b, 7)
      emit_i32_const(b, 8)
      emit_i32_mul(b)
      emit_i32_add(b)
      emit_global_set(b, 0)
      emit_heap_memory_grow_check(b)
    }
    if arena_ptr_addr >= 0 {
      // Which lane the regrow comes from is a property of THE ARRAY, not of
      // the call site: an array whose block sits inside the arena segment is
      // region storage and must keep growing there, or the bulk release would
      // leave the live buffer behind while reclaiming the block that points at
      // it. Everything else (ordinary Arrays, including ones built inside a
      // region body) keeps using the main heap, which the release never
      // touches. Two nested range tests instead of an `and` so the common
      // "not a region array" case exits on the first compare.
      // Region array: bump the arena, falling back to the main heap when the
      // segment is exhausted (less reclamation, never a wrong answer).
      let emit_arena_bump: () -> Unit = () -> {
        emit_i32_const(b, arena_ptr_addr)
        emit_i32_load(b, 2, 0)
        emit_local_set(b, 8)
        emit_local_get(b, 8)
        emit_i32_eqz(b)
        emit_if_void(b)
        emit_i32_const(b, arena_data_base)
        emit_local_set(b, 8)
        emit_end(b)
        emit_local_get(b, 8)
        emit_i64_extend_i32_u(b)
        emit_local_get(b, 7)
        emit_i64_extend_i32_u(b)
        emit_i64_const(b, 8)
        emit_i64_mul(b)
        emit_i64_add(b)
        emit_i64_const(b, arena_limit)
        emit_i64_gt_s(b)
        emit_if_void(b)
        emit_main_heap_bump()
        emit_else(b)
        emit_local_get(b, 8)
        emit_local_set(b, 6)
        emit_i32_const(b, arena_ptr_addr)
        emit_local_get(b, 8)
        emit_local_get(b, 7)
        emit_i32_const(b, 8)
        emit_i32_mul(b)
        emit_i32_add(b)
        emit_i32_store(b, 2, 0)
        emit_end(b)
      }
      emit_local_get(b, 2)
      emit_i32_const(b, arena_data_base)
      emit_i32_ge_u(b)
      emit_if_void(b)
      emit_i32_const(b, arena_limit)
      emit_local_get(b, 2)
      emit_i32_gt_u(b)
      emit_if_void(b)
      // Codex #1801 P1 (applies to MutList identically -- this body predates
      // the review): an arena array regrown while a NESTED region is active
      // must not place its replacement above the inner region's saved
      // watermark, or the inner exit rewinds over live data. A block below
      // saves[depth-1] belongs to an outer region -> main-heap fallback
      // (no reclamation, never a wrong answer); depth past the 64-slot save
      // stack has no watermark to compare -> same fallback. Layout: depth at
      // arena_ptr_addr+4, saves at +8 (common_base region helpers).
      emit_i32_const(b, arena_ptr_addr + 4)
      emit_i32_load(b, 2, 0)
      emit_local_tee(b, 8)
      emit_i32_const(b, 64)
      emit_i32_gt_u(b)
      emit_if_void(b)
      emit_main_heap_bump()
      emit_else(b)
      emit_local_get(b, 8)
      emit_i32_eqz(b)
      emit_if_void(b)
      emit_arena_bump()
      emit_else(b)
      emit_i32_const(b, arena_ptr_addr + 8)
      emit_local_get(b, 8)
      emit_i32_const(b, 1)
      emit_i32_sub(b)
      emit_i32_const(b, 4)
      emit_i32_mul(b)
      emit_i32_add(b)
      emit_i32_load(b, 2, 0)
      emit_local_get(b, 2)
      emit_i32_gt_u(b)
      emit_if_void(b)
      emit_main_heap_bump()
      emit_else(b)
      emit_arena_bump()
      emit_end(b)
      emit_end(b)
      emit_end(b)
      emit_else(b)
      emit_main_heap_bump()
      emit_end(b)
      emit_else(b)
      emit_main_heap_bump()
      emit_end(b)
    } else {
      emit_main_heap_bump()
    }
    emit_local_get(b, 6)
    emit_local_get(b, 5)
    emit_local_get(b, 4)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_memory_copy(b)
    emit_local_get(b, 2)
    emit_local_get(b, 7)
    emit_i32_store(b, 2, 0)
    emit_local_get(b, 2)
    emit_local_get(b, 6)
    emit_i32_store(b, 2, 8)
    emit_local_get(b, 6)
    emit_local_set(b, 5)
  }
  emit_end(b)
  emit_local_get(b, 5)
  emit_local_get(b, 4)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_i32_add(b)
  emit_local_get(b, 1)
  emit_i64_store(b, 3, 0)
  emit_local_get(b, 2)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 4)
  b
}
