/// `Bytes::count(hay, byte)` -- how many times `byte` occurs (#2345).
///
/// The only one of this family that reads the SIMD mask as an ANSWER rather
/// than as a hint, and that difference is a correctness requirement, not a
/// speed one. `i8x16.splat` takes the low 8 bits of its operand, so a needle
/// of 300 splats as 44 and a needle of -1 splats as 255. `Bytes::index_of` and
/// `Bytes::last_index_of` survive that because their mask only decides WHERE
/// to hand over to a scalar loop that compares the full i64 -- the mask can
/// cost a scan, never change an answer. Counting straight out of
/// `i64.popcnt(bitmask)` has no such verification step, so an out-of-range
/// needle would silently return the count of some OTHER byte.
///
/// Hence the guard: `needle >>> 8 != 0` (unsigned, so it catches negatives
/// too) answers 0 without entering the scan at all.
///
/// Complete 16-byte chunks contribute `popcnt(i8x16.bitmask(...))` each; the
/// final partial chunk is counted by a branchless scalar loop that adds the
/// comparison result directly.
///
///   locals: i32 { 2: addr } ; i64 { 3: i, 4: len, 5: needle, 6: count }
export fn gen_bytes_count_byte_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 2)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)
  emit_i64_extend_i32_u(b)
  emit_local_set(b, 4)
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_local_set(b, 5)
  emit_i64_const(b, 0)
  emit_local_set(b, 3)
  emit_i64_const(b, 0)
  emit_local_set(b, 6)
  emit_local_get(b, 5)
  emit_i64_const(b, 8)
  emit_i64_shr_u(b)
  emit_i64_eqz(b)
  emit_if_i64(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_i64_const(b, 16)
  emit_i64_add(b)
  emit_local_get(b, 4)
  emit_i64_gt_s(b)
  emit_br_if(b, 1)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_v128_load(b, 0, 0)
  emit_local_get(b, 5)
  emit_i32_wrap_i64(b)
  emit_i8x16_splat(b)
  emit_i8x16_eq(b)
  emit_i8x16_bitmask(b)
  emit_i64_extend_i32_u(b)
  emit_i64_popcnt(b)
  emit_local_get(b, 6)
  emit_i64_add(b)
  emit_local_set(b, 6)
  emit_local_get(b, 3)
  emit_i64_const(b, 16)
  emit_i64_add(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 4)
  emit_i64_ge_s(b)
  emit_br_if(b, 1)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 5)
  emit_i64_eq(b)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 6)
  emit_i64_add(b)
  emit_local_set(b, 6)
  emit_local_get(b, 3)
  emit_i64_const(b, 1)
  emit_i64_add(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 6)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_else(b)
  emit_i64_const(b, 0)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_end(b)
  b
}

/// `Bytes::last_index_of(hay, byte)` -- the LAST index holding `byte`, or -1
/// (#2345).
///
/// One cursor, `hi`, walks down. The chunk phase tests [hi-15, hi] and drops
/// `hi` by 16 while the mask is empty; the windows are disjoint and are visited
/// from the end, so the first one that reports a match is the LAST chunk
/// containing the byte. The scalar phase then walks down from `hi` and stops on
/// the first full-width match, which is therefore the last occurrence overall.
///
/// The two phases share `hi` and the function returns it unconditionally,
/// because both ways out already leave the right value in it: the scalar loop
/// exits either on a match (with `hi` at that index) or by decrementing to -1,
/// which is the not-found answer. No final comparison, and no separate
/// sentinel that could disagree with the loop.
///
/// Like `Bytes::index_of` and unlike `Bytes::count`, the mask is only a hint:
/// an out-of-range needle can make a chunk look interesting, and the scalar
/// walk then simply runs to the bottom and answers -1.
///
///   locals: i32 { 2: addr } ; i64 { 3: hi, 4: len, 5: needle }
export fn gen_bytes_last_index_of_byte_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 2)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)
  emit_i64_extend_i32_u(b)
  emit_local_set(b, 4)
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_local_set(b, 5)
  emit_local_get(b, 4)
  emit_i64_const(b, 1)
  emit_i64_sub(b)
  emit_local_set(b, 3)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_i64_const(b, 15)
  emit_i64_lt_s(b)
  emit_br_if(b, 1)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i64_const(b, 15)
  emit_i64_sub(b)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_v128_load(b, 0, 0)
  emit_local_get(b, 5)
  emit_i32_wrap_i64(b)
  emit_i8x16_splat(b)
  emit_i8x16_eq(b)
  emit_i8x16_bitmask(b)
  emit_br_if(b, 1)
  emit_local_get(b, 3)
  emit_i64_const(b, 16)
  emit_i64_sub(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_br_if(b, 1)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 5)
  emit_i64_eq(b)
  emit_br_if(b, 1)
  emit_local_get(b, 3)
  emit_i64_const(b, 1)
  emit_i64_sub(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 3)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  b
}

/// `Bytes::compare(a, b)` -- lexicographic ordering (#2345). -1, 0 or 1.
///
/// The last member of #2345's Layer 2 surface, and the only one that is not a
/// search: `Bytes < Bytes` was a type error, so there was no way to order byte
/// strings at all.
///
/// Two phases, like the searches, but the vector phase asks the opposite
/// question. `i8x16.eq` sets a lane to all-ones where the bytes MATCH, so
/// `i8x16.bitmask` is 0xFFFF exactly when a whole 16-byte chunk is equal.
/// Anything else means the first difference is inside this chunk, and the
/// scalar loop then finds which byte it is. The searches break OUT of their
/// vector loop on a hit; this one breaks out on a MISS.
///
/// The compare itself is unsigned. Bytes are `i32.load8_u`, so both sides are
/// 0..255 and the i64 signed compare below cannot see a negative -- but the
/// distinction matters for the contract: `compare` orders by BYTE VALUE, so
/// 0x80 is greater than 0x7F, which a signed byte compare would invert.
///
/// A common prefix falls through to the lengths, which is what makes this
/// lexicographic rather than a memcmp: "ab" < "abc".
///
///   locals: i32 { 2: pa, 3: pb } ; i64 { 4: i, 5: n, 6: la, 7: lb }
export fn gen_bytes_compare_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 3)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)
  emit_i64_extend_i32_u(b)
  emit_local_set(b, 6)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)
  emit_i64_extend_i32_u(b)
  emit_local_set(b, 7)
  emit_local_get(b, 6)
  emit_local_get(b, 7)
  emit_i64_lt_s(b)
  emit_if_i64(b)
  emit_local_get(b, 6)
  emit_else(b)
  emit_local_get(b, 7)
  emit_end(b)
  emit_local_set(b, 5)
  emit_i64_const(b, 0)
  emit_local_set(b, 4)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_i64_const(b, 16)
  emit_i64_add(b)
  emit_local_get(b, 5)
  emit_i64_gt_s(b)
  emit_br_if(b, 1)
  emit_local_get(b, 2)
  emit_local_get(b, 4)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_v128_load(b, 0, 0)
  emit_local_get(b, 3)
  emit_local_get(b, 4)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_v128_load(b, 0, 0)
  emit_i8x16_eq(b)
  emit_i8x16_bitmask(b)
  emit_i32_const(b, 65535)
  emit_i32_ne(b)
  emit_br_if(b, 1)
  emit_local_get(b, 4)
  emit_i64_const(b, 16)
  emit_i64_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i64_ge_s(b)
  emit_br_if(b, 1)
  emit_local_get(b, 2)
  emit_local_get(b, 4)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_local_get(b, 3)
  emit_local_get(b, 4)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i32_ne(b)
  emit_br_if(b, 1)
  emit_local_get(b, 4)
  emit_i64_const(b, 1)
  emit_i64_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i64_lt_s(b)
  emit_if_i64(b)
  emit_local_get(b, 2)
  emit_local_get(b, 4)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 3)
  emit_local_get(b, 4)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i64_extend_i32_u(b)
  emit_i64_lt_s(b)
  emit_if_i64(b)
  emit_i64_const(b, -1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_else(b)
  emit_i64_const(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_end(b)
  emit_else(b)
  emit_local_get(b, 6)
  emit_local_get(b, 7)
  emit_i64_lt_s(b)
  emit_if_i64(b)
  emit_i64_const(b, -1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_else(b)
  emit_local_get(b, 6)
  emit_local_get(b, 7)
  emit_i64_gt_s(b)
  emit_if_i64(b)
  emit_i64_const(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_else(b)
  emit_i64_const(b, 0)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_end(b)
  emit_end(b)
  emit_end(b)
  b
}

/// `Bytes::index_of_bytes(hay, needle)` -- the substring search, over two heap
/// handles instead of two String fat values.
///
/// It does NOT carry a copy of the search. It packs each handle into the fat
/// value `String` already uses -- `(data_ptr << 32) | len`, read at offsets 8
/// and 4 -- and CALLS `String::index_of`, which owns the length guard, the RC
/// tagging of the result, and the windowed SIMD loop
/// (`emit_windowed_substring_search`).
///
/// #2345 step 2 inlined the loop into this body instead, via the shared emit
/// helper. That is a code EXPANDER, not a wasm function, so the loop was
/// duplicated in the output: the wasm-gc lane, which links builtins
/// unconditionally, grew +2.8-3.9% on all nine perf scenarios even for
/// programs that never call this. One `call` replaces ~215 B of duplicated
/// body, and the loop's needle can go back to reading local 1 (see the comment
/// at that site), which returns the +0.61% string_ops fuel the synthesis cost.
///
/// The loads are the same ones `gen_bytes_get_body` does and are deliberately
/// NOT untagged: a `Bytes` handle is a raw pointer in the value world, and only
/// `Int` carries the `n << 1` tag.
export fn gen_bytes_index_of_bytes_body(string_index_of_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_tee(b, 2)
  emit_i32_load(b, 2, 8)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 4)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_local_tee(b, 3)
  emit_i32_load(b, 2, 8)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 3)
  emit_i32_load(b, 2, 4)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  emit_call(b, string_index_of_idx)
  b
}

