export fn gen_str_char_code_at_body(enable_rc: Bool, oob_prefix_fat: Int, oob_abort_idx: Int) -> Bytes {
  let b = bytebuf_new()
  // #811: bounds check — idx (untagged, i32-wrapped) must be < length (the
  // fat pointer's low 32 bits). ge_u catches negative indices too (they wrap
  // to huge unsigned values). OOB reads previously returned adjacent memory.
  // #2199: before the trap, call __rt_oob_abort with this operation's prefix
  // plus the signed index and the length, so the abort line names the
  // operation and both values. oob_abort_idx < 0 emits the historical
  // bare-trap form (the static twin pins that shape).
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  bytebuf_push(b, 79)
  emit_if_void(b)
  if oob_abort_idx >= 0 {
    emit_i64_const(b, oob_prefix_fat)
    emit_local_get(b, 1)
    if enable_rc {
      emit_i64_const(b, 1)
      emit_i64_shr_s(b)
    }
    emit_local_get(b, 0)
    emit_i32_wrap_i64(b)
    emit_i64_extend_i32_u(b)
    emit_call(b, oob_abort_idx)
  } else {
    ()
  }
  bytebuf_push(b, 0)
  emit_end(b)
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  // ADR-0055 Stage 1: the index argument is a tagged int (idx<<1) under RC;
  // untag it before using it as a byte offset.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i64_extend_i32_u(b)
  // ADR-0055 Stage 1: the char code is a count entering the value world; tag it.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  b
}

export fn gen_string_ends_with_body(enable_rc: Bool, str_len_idx: Int, str_substring_idx: Int, str_eq_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  // ADR-0055: String::length is value-world (tagged) under RC; untag to a raw
  // length. `substring` stays raw, so its args are passed raw as before.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  bytebuf_push(b, 75)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_else(b)
  emit_local_get(b, 0)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_sub(b)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_substring_idx)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_local_get(b, 1)
  emit_call(b, str_eq_idx)
  emit_end(b)
  // ADR-0055: starts_with/ends_with return a value-world Bool. str_eq returns raw
  // 0/1 and the needle-too-long branch returns raw 0, so tag the unified if
  // result (true=2) so callers comparing `== true` or storing it see the tag.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  b
}

