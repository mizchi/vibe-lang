//# Functions

export fn gen_print_i64_body() -> Bytes {
  let b = bytebuf_new()
  emit_i32_const(b, 46)
  emit_local_set(b, 2)
  emit_i32_const(b, 47)
  emit_i32_const(b, 10)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_local_set(b, 1)
  emit_local_get(b, 1)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_local_get(b, 0)
  emit_i64_sub(b)
  emit_else(b)
  emit_local_get(b, 0)
  emit_end(b)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_if_void(b)
  emit_local_get(b, 2)
  emit_i32_const(b, 48)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 4)
  emit_i64_const(b, 10)
  emit_i64_rem_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_const(b, 48)
  emit_i32_add(b)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_local_get(b, 4)
  emit_i64_const(b, 10)
  emit_i64_div_s(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 1)
  emit_if_void(b)
  emit_local_get(b, 2)
  emit_i32_const(b, 45)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_end(b)
  emit_i32_const(b, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_i32_const(b, 47)
  emit_local_get(b, 2)
  emit_i32_sub(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  b
}

/// #2199 ask 2: `__rt_print_i64_raw` -- gen_print_i64_body minus the trailing
/// newline, so a decimal value can sit inside a larger line (the OOB abort
/// message interleaves string fragments and numbers). Digits are built
/// backwards from scratch address 46 exactly as in gen_print_i64_body; the
/// only differences are that no byte 10 is stored at 47 and the iov length
/// stops at 46 instead. Locals match print_i64 (3 x i32 + 1 x i64, type 1).
export fn gen_print_i64_raw_body() -> Bytes {
  let b = bytebuf_new()
  emit_i32_const(b, 46)
  emit_local_set(b, 2)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_local_set(b, 1)
  emit_local_get(b, 1)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_local_get(b, 0)
  emit_i64_sub(b)
  emit_else(b)
  emit_local_get(b, 0)
  emit_end(b)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_if_void(b)
  emit_local_get(b, 2)
  emit_i32_const(b, 48)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 4)
  emit_i64_const(b, 10)
  emit_i64_rem_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_const(b, 48)
  emit_i32_add(b)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_local_get(b, 4)
  emit_i64_const(b, 10)
  emit_i64_div_s(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 1)
  emit_if_void(b)
  emit_local_get(b, 2)
  emit_i32_const(b, 45)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_end(b)
  emit_i32_const(b, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_i32_const(b, 46)
  emit_local_get(b, 2)
  emit_i32_sub(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  b
}

/// #2199 ask 2: `__rt_oob_abort(prefix_fat, idx, len)` -- the shared
/// formatted abort for every bounds-checked builtin. Prints
/// `<prefix><idx> out of bounds for length <len>\n` and traps, so each trap
/// site only pushes its own prefix constant plus the two values (~20 bytes)
/// instead of carrying the message assembly. `prefix_fat` / `oob_mid_fat` /
/// `oob_nl_fat` are raw (ptr<<32)|len string-table constants (exactly what
/// __rt_print_str takes on both lanes; no RC tag is involved). idx is the
/// untagged SIGNED index -- a negative index prints as negative, not as the
/// huge unsigned value the ge_u check saw. Ends in `unreachable`; the call
/// never returns (type (i64,i64,i64) -> ()).
export fn gen_oob_abort_body(print_str_idx: Int, print_i64_raw_idx: Int, oob_mid_fat: Int, oob_nl_fat: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, print_str_idx)
  emit_local_get(b, 1)
  emit_call(b, print_i64_raw_idx)
  emit_i64_const(b, oob_mid_fat)
  emit_call(b, print_str_idx)
  emit_local_get(b, 2)
  emit_call(b, print_i64_raw_idx)
  emit_i64_const(b, oob_nl_fat)
  emit_call(b, print_str_idx)
  bytebuf_push(b, 0)
  b
}

/// #3126: the fixed fragments of the division-by-zero line. Seeded into the
/// string pool only when a program has a guarded `/` or `%`, on both lanes.
export fn div_zero_div_message() -> String {
  "Int `/` by zero"
}

export fn div_zero_rem_message() -> String {
  "Int `%` by zero"
}

export fn div_zero_at_fragment() -> String {
  " at "
}

export fn div_zero_colon_fragment() -> String {
  ":"
}

/// #3126: `__rt_div_zero_abort(op, loc_fat, line_col)` -- what an `Int` `/` or
/// `%` whose divisor is zero calls instead of letting `i64.div_s` /
/// `i64.rem_s` trap with the engine's bare `divide by zero`. Prints
/// `Int <op> by zero at <path>:<line>:<col>\n` and traps.
///
/// `op` is 0 for `/` and 1 for `%`. `loc_fat` is a raw `(ptr << 32) | len`
/// string-table constant -- what `print_str` takes on both lanes -- or 0 when
/// the compile could not place the site, and then the line stops after the
/// operation rather than inventing a location. The linear lane passes the
/// PATH there and `(line << 32) | col` in `line_col`, printed through
/// `print_i64_raw_idx`; the gc lane has no integer printer, passes the whole
/// `path:line:col` string and 0, and generates this with
/// `print_i64_raw_idx < 0`. Each guarded site pushes three constants and a
/// call, so the message assembly lives here once. Type
/// `(i64, i64, i64) -> ()`; the call never returns.
export fn gen_div_zero_abort_body(print_str_idx: Int, print_i64_raw_idx: Int, div_fat: Int, rem_fat: Int, at_fat: Int, colon_fat: Int, nl_fat: Int) -> Bytes {
  let b = bytebuf_new()
  emit_i64_const(b, div_fat)
  emit_i64_const(b, rem_fat)
  emit_local_get(b, 0)
  emit_i64_eqz(b)
  // select (0x1B): the first operand when `op == 0`.
  bytebuf_push(b, 27)
  emit_call(b, print_str_idx)
  emit_local_get(b, 1)
  emit_i64_eqz(b)
  emit_i32_eqz(b)
  emit_if_void(b)
  emit_i64_const(b, at_fat)
  emit_call(b, print_str_idx)
  emit_local_get(b, 1)
  emit_call(b, print_str_idx)
  if print_i64_raw_idx >= 0 {
    emit_i64_const(b, colon_fat)
    emit_call(b, print_str_idx)
    emit_local_get(b, 2)
    emit_i64_const(b, 32)
    emit_i64_shr_u(b)
    emit_call(b, print_i64_raw_idx)
    emit_i64_const(b, colon_fat)
    emit_call(b, print_str_idx)
    emit_local_get(b, 2)
    emit_i64_const(b, 4294967295)
    emit_i64_and(b)
    emit_call(b, print_i64_raw_idx)
  } else {
    ()
  }
  emit_end(b)
  emit_i64_const(b, nl_fat)
  emit_call(b, print_str_idx)
  bytebuf_push(b, 0)
  b
}

export fn gen_print_str_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 1)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_i32_const(b, 0)
  emit_local_get(b, 1)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_local_get(b, 2)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  b
}

export fn gen_arr_concat_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 4)
  emit_local_get(b, 3)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 5)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 6)
  emit_local_get(b, 3)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 7)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i32_add(b)
  emit_local_set(b, 8)
  emit_global_get(b, 0)
  emit_local_tee(b, 9)
  emit_i32_const(b, 12)
  emit_local_get(b, 8)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_i32_add(b)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_heap_memory_grow_check(b)
  emit_local_get(b, 9)
  emit_local_get(b, 8)
  emit_i32_store(b, 2, 0)
  emit_local_get(b, 9)
  emit_local_get(b, 8)
  emit_i32_store(b, 2, 4)
  emit_local_get(b, 9)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_local_set(b, 10)
  emit_local_get(b, 9)
  emit_local_get(b, 10)
  emit_i32_store(b, 2, 8)
  emit_local_get(b, 10)
  emit_local_get(b, 6)
  emit_local_get(b, 4)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_memory_copy(b)
  emit_local_get(b, 10)
  emit_local_get(b, 4)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_i32_add(b)
  emit_local_get(b, 7)
  emit_local_get(b, 5)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_memory_copy(b)
  emit_local_get(b, 9)
  emit_i64_extend_i32_u(b)
  b
}

/// Trap unless `ptr_local`/`len_local` describe a live string. Reports the
/// pair, so the caller sees the operand rather than a memory fault.
///
/// Three tests, and each one is load-bearing for a different case:
///
///   - `ptr <u 64` -- #973's bound, established for exactly this situation
///     (concatenating a value that might be an int): every ordinary small
///     `Int` implies a `ptr` of 0..63, while a real string's address is >= 64.
///   - `len >u frontier` -- a string cannot be longer than the guest heap it
///     was built in. This is the test that catches #2427, whose operand was a
///     tagged `Int` decoding to a 3.04 GiB "length".
///   - `ptr + len > memory.size` in **i64** -- the #664 out-of-bounds guard,
///     spelled as `emit_looks_like_string` spells it. i64 because the i32 form
///     WRAPS: with a 2.5 GiB frontier, `ptr` and `len` both 2.3 GiB sum to
///     644 MB in i32 and sail through (#2489 review).
///
/// The end-range test deliberately bounds by MEMORY, not by the frontier.
/// Under `VIBE_WASM_HOST_ALLOC_MODE=arena` the runner allocates host-returned
/// strings at `__heap_ptr + guard` and advances only its own private pointer,
/// never `global 0` -- so a perfectly good `Fs::read_file` result lives ABOVE
/// the frontier, and a frontier-bounded test would reject every one of them
/// (#2489 review). Bounding by memory accepts them and still rejects anything
/// unaddressable.
///
/// `(ptr=0, len=0)` is EXEMPT: the legal packed empty-string encoding
/// `compile_call`'s `__to_string` arm names, which copies zero bytes.
/// Measured, I could not get it to reach this builtin from in-language code --
/// `String::join([], sep)`, the `"[\{...}]"` interpolation that comment gives
/// as its example, and concat with an empty operand on either side all pass
/// the unexempted guard on both lanes. It is kept as a correctness argument,
/// not a reproduction.
fn emit_str_operand_guard(b: Bytes, ptr_local: Int, len_local: Int, abort_idx: Int, prefix_fat: Int) -> Unit {
  // 64 >u ptr
  emit_i32_const(b, 64)
  emit_local_get(b, ptr_local)
  emit_i32_gt_u(b)
  // || len >u frontier
  emit_local_get(b, len_local)
  emit_global_get(b, 0)
  emit_i32_gt_u(b)
  // i32.or (0x72)
  bytebuf_push(b, 114)
  // || (i64)ptr + (i64)len > memory.size * 65536
  emit_local_get(b, ptr_local)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, len_local)
  emit_i64_extend_i32_u(b)
  emit_i64_add(b)
  // memory.size (0x3F 0x00) in bytes, as emit_mem_size_bytes does
  bytebuf_push(b, 63)
  bytebuf_push(b, 0)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 65536)
  emit_i64_mul(b)
  emit_i64_gt_s(b)
  // i32.or (0x72)
  bytebuf_push(b, 114)
  // && !(the packed empty string)
  emit_local_get(b, ptr_local)
  emit_local_get(b, len_local)
  // i32.or (0x72)
  bytebuf_push(b, 114)
  emit_i32_eqz(b)
  emit_i32_eqz(b)
  // i32.and (0x71)
  bytebuf_push(b, 113)
  emit_if_void(b)
  emit_i64_const(b, prefix_fat)
  emit_local_get(b, ptr_local)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, len_local)
  emit_i64_extend_i32_u(b)
  emit_call(b, abort_idx)
  emit_end(b)
}

/// #2427: `rc_shadow` adds a plausibility check on both operands.
///
/// This body decodes `ptr = v >> 32` and `len = v & 0xFFFFFFFF` from whatever
/// i64 it is handed. A value that is not a string at all -- a tagged `Int`
/// (`n << 1`), a pointer, a stale word read out of a block that was freed and
/// re-issued -- decodes into a wild ptr/len and traps inside `memory.copy`
/// with a bare "memory access out of bounds" that names nothing. Under shadow
/// the operand is printed instead, and its bits say what it really was.
///
/// A live string satisfies `ptr >= 64` (static string data starts at 64),
/// `len <= global 0` (the bump frontier), and `ptr + len <= memory.size` --
/// see `emit_str_operand_guard` for why the end is bounded by memory rather
/// than by the frontier. String buffers carry no header and are never freed,
/// so there is no shadow slot to consult here -- this is a range check, not a
/// mark check, which is why it is a separate abort from the UAF one.
export fn gen_str_concat_body(rc_shadow: Bool, str_operand_abort_idx: Int, bad_operand_fat: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_local_get(b, 1)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  if rc_shadow {
    emit_str_operand_guard(b, 4, 2, str_operand_abort_idx, bad_operand_fat)
    emit_str_operand_guard(b, 5, 3, str_operand_abort_idx, bad_operand_fat)
  } else {
    ()
  }
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_local_set(b, 7)
  emit_global_get(b, 0)
  emit_local_tee(b, 6)
  emit_local_get(b, 7)
  emit_i32_add(b)
  emit_i32_const(b, 7)
  emit_i32_add(b)
  emit_i32_const(b, -8)
  bytebuf_push(b, 113)
  emit_global_set(b, 0)
  emit_heap_memory_grow_check(b)
  emit_local_get(b, 6)
  emit_local_get(b, 4)
  emit_local_get(b, 2)
  emit_memory_copy(b)
  emit_local_get(b, 6)
  emit_local_get(b, 2)
  emit_i32_add(b)
  emit_local_get(b, 5)
  emit_local_get(b, 3)
  emit_memory_copy(b)
  emit_local_get(b, 6)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 7)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  b
}

/// String::join(arr, sep): single-allocation O(n) join.
///
/// Strings are represented inline as the i64 (ptr << 32) | len (see
/// gen_str_concat_body); the bytes live at ptr in the bump heap. The previous
/// implementation accumulated `acc = concat(acc, sep); acc = concat(acc,
/// arr[i])`, which copied the whole prefix each step — O(n^2) time and O(n^2)
/// bump garbage (the streaming bench's dominant cost, and an OOM/out-of-bounds
/// risk at ~4 KB; see scripts/bench_streaming.sh). Instead: pass 1 sums the
/// total length, allocate the result once, pass 2 memcpy's each piece (and the
/// separator) into place — O(n). This also speeds up StringBuilder::freeze,
/// which lowers to String::join(parts, "").
///
/// Locals (params 0=arr, 1=sep are i64): i32 group [2..10] = n, i, total,
/// sep_len, sep_ptr, base, pos, cur_ptr, cur_len; i64 group [11] = cur. Keep
/// meta_i32=9 / meta_i64=1 in linked_compile in sync. arr_len/arr_get use the
/// untagged convention (matching the prior body); ptr/len are extracted exactly
/// as gen_str_concat_body does.
export fn gen_string_join_body(enable_rc: Bool, arr_len_idx: Int, arr_get_idx: Int, str_concat_idx: Int) -> Bytes {
  let _ = str_concat_idx
  let b = bytebuf_new()
  // n = arr_len(arr). Under RC `arr_len` returns the length TAGGED (len<<1) and
  // `arr_get` expects the index TAGGED (#705) — this body otherwise uses the raw
  // untagged convention, so untag the count here and tag each index below, or
  // the loop runs 2*len times (OOB) and reads element i/2.
  emit_local_get(b, 0)
  emit_call(b, arr_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  } else {
    ()
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  // empty array -> the canonical empty-string shape `(ptr << 32) | 0` with a
  // REAL pointer (the current bump pointer; length 0, so nothing is read
  // through it and no allocation happens). The previous `i64.const 0` was
  // indistinguishable from the tagged Int 0, so the value compared and
  // concatenated as an empty string but RENDERED as `0` --
  // `"\{String::join([], ",")}"` printed `0` (#2143). Every other
  // empty-string producer (literal, substring, trim, split) already carries
  // a real pointer; join was the only 0-shaped empty.
  emit_local_get(b, 2)
  emit_i32_eqz(b)
  emit_if_i64(b)
  emit_global_get(b, 0)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_else(b)
  // sep_len = lo32(sep); sep_ptr = hi32(sep)
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_local_get(b, 1)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 6)
  // pass 1: total = sum of len(arr[i])
  emit_i32_const(b, 0)
  emit_local_set(b, 4)
  emit_i32_const(b, 0)
  emit_local_set(b, 3)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  } else {
    ()
  }
  emit_call(b, arr_get_idx)
  emit_local_set(b, 11)
  emit_local_get(b, 4)
  emit_local_get(b, 11)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_local_set(b, 4)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  // total += sep_len * (n - 1)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_i32_mul(b)
  emit_i32_add(b)
  emit_local_set(b, 4)
  // base = bump(total); pos = base
  emit_global_get(b, 0)
  emit_local_tee(b, 7)
  emit_local_get(b, 4)
  emit_i32_add(b)
  emit_i32_const(b, 7)
  emit_i32_add(b)
  emit_i32_const(b, -8)
  bytebuf_push(b, 113)
  emit_global_set(b, 0)
  emit_heap_memory_grow_check(b)
  emit_local_get(b, 7)
  emit_local_set(b, 8)
  // pass 2: copy sep (when i>0) then arr[i] bytes
  emit_i32_const(b, 0)
  emit_local_set(b, 3)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  // if i != 0: memcpy(pos, sep_ptr, sep_len); pos += sep_len
  emit_local_get(b, 3)
  emit_i32_const(b, 0)
  emit_i32_ne(b)
  emit_if_void(b)
  emit_local_get(b, 8)
  emit_local_get(b, 6)
  emit_local_get(b, 5)
  emit_memory_copy(b)
  emit_local_get(b, 8)
  emit_local_get(b, 5)
  emit_i32_add(b)
  emit_local_set(b, 8)
  emit_end(b)
  // cur = arr[i]; cur_ptr = hi32(cur); cur_len = lo32(cur)
  emit_local_get(b, 0)
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  } else {
    ()
  }
  emit_call(b, arr_get_idx)
  emit_local_set(b, 11)
  emit_local_get(b, 11)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 9)
  emit_local_get(b, 11)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 10)
  // memcpy(pos, cur_ptr, cur_len); pos += cur_len
  emit_local_get(b, 8)
  emit_local_get(b, 9)
  emit_local_get(b, 10)
  emit_memory_copy(b)
  emit_local_get(b, 8)
  emit_local_get(b, 10)
  emit_i32_add(b)
  emit_local_set(b, 8)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  // result = (base << 32) | total
  emit_local_get(b, 7)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  emit_end(b)
  b
}

export fn gen_string_trim_body(enable_rc: Bool, str_len_idx: Int, str_char_code_at_idx: Int, str_substring_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 1)
  emit_i32_const(b, 0)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_local_set(b, 3)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  // ADR-0055: char_code_at is value-world under RC — tag the index it consumes.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_char_code_at_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_tee(b, 4)
  emit_i32_const(b, 32)
  emit_i32_eq(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 9)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_local_get(b, 4)
  emit_i32_const(b, 10)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_local_get(b, 4)
  emit_i32_const(b, 13)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_i32_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 2)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  bytebuf_push(b, 76)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_char_code_at_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_tee(b, 4)
  emit_i32_const(b, 32)
  emit_i32_eq(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 9)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_local_get(b, 4)
  emit_i32_const(b, 10)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_local_get(b, 4)
  emit_i32_const(b, 13)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_i32_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 0)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_substring_idx)
  b
}

let static_eq_body_bytes: Bytes = Bytes::from_array([32, 0, 32, 1, 81, 173])

export fn static_eq_body() -> Bytes {
  static_eq_body_bytes
}

fn truncate_emit_ptr(b: Bytes, enable_rc: Bool) -> Unit {
  emit_local_get(b, 0)
  // ADR-0055: untag the odd array pointer under RC.
  if enable_rc {
    emit_i64_const(b, -2)
    emit_i64_and(b)
  }
  emit_i32_wrap_i64(b)
}

// The full i64 length, untagged but not narrowed.
fn truncate_emit_new_len64(b: Bytes, enable_rc: Bool) -> Unit {
  emit_local_get(b, 1)
  // ADR-0055: the new length arrives tagged; untag before storing.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
}

// Only ever SHRINKS (#2837 review): a length at or above the current one, or a
// negative one (huge as unsigned), leaves the array untouched. Storing it
// would expose slots past the live prefix -- stale, beyond the capacity, or
// already released by a planned truncate release. The comparison is on the
// full i64: narrowing first would wrap `1 << 32` to 0 and empty the array.
export fn gen_arr_truncate_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  truncate_emit_new_len64(b, enable_rc)
  truncate_emit_ptr(b, enable_rc)
  emit_i32_load(b, 2, 4)
  emit_i64_extend_i32_u(b)
  // i64.lt_u
  bytebuf_push(b, 84)
  emit_if_void(b)
  truncate_emit_ptr(b, enable_rc)
  truncate_emit_new_len64(b, enable_rc)
  emit_i32_wrap_i64(b)
  emit_i32_store(b, 2, 4)
  emit_end(b)
  b
}

export fn gen_string_split_body(enable_rc: Bool, arr_new_idx: Int, arr_push_idx: Int, str_len_idx: Int, str_substring_idx: Int, string_index_of_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_call(b, arr_new_idx)
  emit_local_set(b, 6)
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  // An EMPTY separator used to spin forever: `String::index_of(suffix, "")`
  // answers 0 at every cursor, so the loop pushed an empty part and advanced
  // by `idx + sep_len` == 0. It ended in "memory access out of bounds" inside
  // __rt_arr_push once the array outgrew the heap. `[s]` is the answer the
  // scalar `String::split` in lib/@vibe/builtin/string.vibe has always given
  // for this case; the two now agree instead of one of them dying.
  emit_local_get(b, 3)
  emit_i32_eqz(b)
  emit_if_void(b)
  emit_local_get(b, 6)
  emit_local_get(b, 0)
  emit_i32_const(b, 0)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_substring_idx)
  emit_call(b, arr_push_idx)
  emit_local_get(b, 6)
  emit_return(b)
  emit_end(b)
  emit_i32_const(b, 0)
  emit_local_set(b, 4)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_substring_idx)
  emit_local_get(b, 1)
  emit_call(b, string_index_of_idx)
  // ADR-0055: String::index_of returns a tagged index under RC; untag for use.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_local_get(b, 5)
  emit_i32_const(b, 0)
  bytebuf_push(b, 72)
  emit_br_if(b, 1)
  emit_local_get(b, 6)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i32_add(b)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_substring_idx)
  emit_call(b, arr_push_idx)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i32_add(b)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 6)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_substring_idx)
  emit_call(b, arr_push_idx)
  emit_local_get(b, 6)
  b
}

/// #997: `i64.trunc_f64_s` TRAPS (an unhandled wasm `unreachable`-style trap,
/// not a catchable vibe error) on NaN, +-Infinity, or any magnitude outside
/// the i64 range -- so `Double::to_int(0.0 / 0.0)` used to abort the whole
/// program instead of returning a value. This wasm build targets neither the
/// nontrapping-float-to-int-conversions proposal nor any other feature flag
/// that would make `i64.trunc_sat_f64_s` available (no emit helper for it
/// exists in wasm_emit, and none of this compiler's wasmtime invocations pass
/// a feature flag for it -- unlike e.g. the gc backend's explicit `-W gc=y`),
/// so the guard is done by hand: NaN and out-of-i64-range values saturate to
/// 0 (a "tolerate, don't trap" choice consistent with e.g. Array::slice's
/// clamping elsewhere in this file) instead of trunc'ing at all.
export fn gen_double_to_int_body() -> Bytes {
  let b = bytebuf_new()
  // NaN: x != x is only true for NaN.
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_f64_ne(b)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_else(b)
  // Upper bound: trunc_f64_s is defined for x < 2^63.
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_f64_const_lohi(b, 0, 1137704960)
  emit_f64_lt(b)
  emit_if_i64(b)
  // Lower bound: trunc_f64_s is defined for x >= -2^63.
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_f64_const_lohi(b, 0, 3285188608)
  emit_f64_ge(b)
  emit_if_i64(b)
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_i64_trunc_f64_s(b)
  emit_else(b)
  // #2978: below the range saturates to Int::min_value.
  emit_i64_const(b, 0 - 4611686018427387903 - 1)
  emit_end(b)
  emit_else(b)
  // #2978: above the range (and +Infinity) saturates to Int::max_value.
  emit_i64_const(b, 4611686018427387903)
  emit_end(b)
  emit_end(b)
  b
}

//# #2344: scalar bit primitives
//
// `Int` is a 63-bit two's complement value, NOT an i64, and on the RC lane it
// arrives tagged as `n<<1`. Both facts change the answer, so each body untags
// (RC only), normalises the 63-bit view, applies the wasm instruction, and
// retags. `popcount(-1)` must be 63, not 64.
//
// All three are branch-free. The masks are built by arithmetic because a vibe
// `Int` literal cannot spell 0x7FFF_FFFF_FFFF_FFFF or 0x8000_0000_0000_0000.

/// Untag on the RC lane; a no-op on the bump lane, where `Int` is raw.
fn emit_untag_int(b: Bytes, enable_rc: Bool) -> Unit {
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  } else {
    ()
  }
}

/// Retag on the RC lane; a no-op on the bump lane.
fn emit_retag_int(b: Bytes, enable_rc: Bool) -> Unit {
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  } else {
    ()
  }
}

/// `Int::popcount(x)` — set bits in the 63-bit two's complement value.
///
/// Bit 63 of the untagged i64 is a copy of the sign bit, so a bare `i64.popcnt`
/// would answer one too many for every negative input. Mask it off with
/// `(-1 >>> 1)` = 0x7FFF_FFFF_FFFF_FFFF first, which leaves bits 0..62 — exactly
/// the 63-bit view — so `popcount(-1)` is 63.
export fn gen_int_popcount_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_untag_int(b, enable_rc)
  emit_i64_const(b, 0 - 1)
  emit_i64_const(b, 1)
  emit_i64_shr_u(b)
  emit_i64_and(b)
  emit_i64_popcnt(b)
  emit_retag_int(b, enable_rc)
  b
}

/// `Int::ctz(x)` — trailing zeros, 63 for 0.
///
/// `i64.ctz` answers 64 for zero, which is outside the 63-bit width. Setting
/// bit 63 first (`-1 << 63` = 0x8000_0000_0000_0000) makes zero answer 63 and
/// leaves every other input alone, since a non-zero value's lowest set bit is
/// below bit 63.
export fn gen_int_ctz_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_untag_int(b, enable_rc)
  emit_i64_const(b, 0 - 1)
  emit_i64_const(b, 63)
  emit_i64_shl(b)
  emit_i64_or(b)
  emit_i64_ctz(b)
  emit_retag_int(b, enable_rc)
  b
}

/// `Int::clz(x)` — leading zeros in the 63-bit view, 63 for 0.
///
/// Shifting left by one moves the 63-bit view's top bit (62) into the i64's top
/// bit, so `i64.clz` of `x<<1` counts leading zeros of the 63-bit value. The
/// `| 1` only decides the zero case: `clz(1)` is 63, and for any non-zero input
/// a set low bit cannot change the leading-zero count.
export fn gen_int_clz_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_untag_int(b, enable_rc)
  emit_i64_const(b, 1)
  emit_i64_shl(b)
  emit_i64_const(b, 1)
  emit_i64_or(b)
  emit_i64_clz(b)
  emit_retag_int(b, enable_rc)
  b
}

export fn gen_int_to_double_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_f64_convert_i64_s(b)
  emit_i64_reinterpret_f64(b)
  b
}

/// #982: substring had ZERO bounds checks — the packed `(ptr+start)<<32 |
/// (end-start)` view silently read adjacent heap for `end > len`, produced a
/// u32-wrapped length ~4294967294 for `end < start` (i64_extend_i32_u on the
/// negative difference), and read BEFORE the string for a negative `start`.
/// Clamp start into [0, len] and end into [start', len] up front (the same
/// tolerate-not-trap choice as Array::slice below), so every downstream packed
/// view stays inside the source string and `end < start` yields "". Locals:
/// 3/4 = existing i32 scratch, 5 = NEW i64 scratch holding len (meta bumped
/// 2/0 -> 2/1 at the linked_compile push_builtin site).
export fn gen_str_substring_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  // local5 = len (i64, untagged): the packed string's low 32 bits.
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i64_extend_i32_u(b)
  emit_local_set(b, 5)
  // param1 (start) := retag(clamp(untag(start), 0, len))
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_else(b)
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_local_get(b, 5)
  emit_i64_gt_s(b)
  emit_if_i64(b)
  emit_local_get(b, 5)
  emit_else(b)
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_end(b)
  emit_end(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_local_set(b, 1)
  // param2 (end) := retag(clamp(untag(end), untag(start'), len))
  emit_local_get(b, 2)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i64_lt_s(b)
  emit_if_i64(b)
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_else(b)
  emit_local_get(b, 2)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_local_get(b, 5)
  emit_i64_gt_s(b)
  emit_if_i64(b)
  emit_local_get(b, 5)
  emit_else(b)
  emit_local_get(b, 2)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_end(b)
  emit_end(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_local_set(b, 2)
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  // ADR-0055: start/end arrive tagged (n<<1) under RC; untag for raw arithmetic.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i64_sub(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_local_get(b, 3)
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  b
}

export fn gen_fs_exists_stub_body() -> Bytes {
  let b = bytebuf_new()
  emit_i64_const(b, 0)
  b
}

export fn gen_string_contains_body(enable_rc: Bool, string_index_of_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_local_get(b, 1)
  emit_call(b, string_index_of_idx)
  // index_of returns a tagged index (-2 for "not found") under RC; `>= 0` still
  // holds since the tag preserves sign. Tag the resulting Bool into the value
  // world (true=2/false=0).
  emit_i64_const(b, 0)
  emit_i64_ge_s(b)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  b
}

/// #748 (ADR-0054 step 3): SIMD memchr substring search. The old body called
/// str_substring + str_eq PER POSITION (two function calls each, ~5.6ns/byte).
/// Now: the needle's first byte is splatted and 16-byte haystack windows with
/// no occurrence are skipped via v128.load + i8x16.eq + v128.any_true; a
/// first-byte hit verifies with ONE str_eq call on a zero-copy packed view
/// ((hp+i)<<32 | ndl_len) — no substring allocation, and the verify rides
/// str_eq's own SIMD chunk path for long needles. Params 0=hay 1=ndl (raw
/// packed). Locals (all i32, meta 8/0): 2=hay_len 3=ndl_len 4=i 5=hay_ptr
/// 6=ndl_ptr 7=first_byte 8=limit (= hay_len - ndl_len, last valid start)
/// 9=chunk_limit (window phase bound; 0 when the range is under 16 starts).
/// #2345: the windowed substring search, emitted over the i32 locals its ONE
/// caller -- `gen_string_index_of_body` -- has already populated:
///
///   local 2  haystack length      local 5  haystack data pointer
///   local 3  needle length        local 6  needle data pointer
///   local 8  last valid start (hay_len - ndl_len)
///
/// and locals 4 / 7 / 9 as scratch, plus `local 1` read straight through to
/// `str_eq` as the needle fat value. That last one is why the caller must be a
/// String: `local 1` is the caller's own second parameter.
///
/// It briefly had a second caller. `Bytes::index_of_bytes` filled the same
/// locals from a heap handle and inlined this helper, with the needle
/// synthesised from locals 6/3 so it did not depend on `local 1`. That is
/// gone: this is an emit HELPER, a code expander rather than a wasm function,
/// so the second caller duplicated ~215 B of loop into the output and the
/// wasm-gc lane -- which links builtins unconditionally -- grew 2.8-3.9% on
/// every perf scenario, including programs that never search bytes. The
/// synthesis cost 0.61% string_ops fuel on top, six instructions per candidate
/// where `local.get 1` is one. `gen_bytes_index_of_bytes_body` now packs its
/// two handles into fat values once and CALLS `String::index_of`, which
/// removed both.
///
/// So the extraction no longer buys a shared caller; what it buys is that the
/// search is readable on its own, separate from the unpacking above it.
///
/// Still byte-for-byte the emitter calls that were inline in
/// gen_string_index_of_body. The SIMD window (splat the needle's first byte,
/// scan 16 bytes with i8x16.eq + v128.any_true, skip the whole window when no
/// candidate byte is present, scalar full-match only on candidate windows)
/// lives here; ADR-0054 measured it at ~5.1x over the scalar baseline.
fn emit_windowed_substring_search(b: Bytes, enable_rc: Bool, str_eq_idx: Int) -> Unit {
  emit_block_i64(b)
  emit_local_get(b, 3)
  emit_i32_eqz(b)
  emit_if_void(b)
  emit_i64_const(b, 0)
  emit_br(b, 1)
  emit_end(b)
  emit_local_get(b, 6)
  emit_i32_load8_u(b, 0, 0)
  emit_local_set(b, 7)
  emit_i32_const(b, 0)
  emit_local_set(b, 4)
  emit_i32_const(b, 0)
  emit_local_set(b, 9)
  emit_local_get(b, 8)
  emit_i32_const(b, 15)
  emit_i32_ge_u(b)
  emit_if_void(b)
  emit_local_get(b, 8)
  emit_i32_const(b, 14)
  emit_i32_sub(b)
  emit_local_set(b, 9)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_local_get(b, 8)
  emit_i32_gt_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 4)
  emit_local_get(b, 9)
  emit_i32_ge_u(b)
  emit_i32_eqz(b)
  emit_if_void(b)
  emit_local_get(b, 5)
  emit_local_get(b, 4)
  emit_i32_add(b)
  emit_v128_load(b, 0, 0)
  emit_local_get(b, 7)
  emit_i8x16_splat(b)
  emit_i8x16_eq(b)
  emit_v128_any_true(b)
  emit_i32_eqz(b)
  emit_if_void(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 16)
  emit_i32_add(b)
  emit_local_set(b, 4)
  emit_br(b, 2)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 5)
  emit_local_get(b, 4)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_local_get(b, 7)
  emit_i32_ne(b)
  emit_i32_eqz(b)
  emit_if_void(b)
  emit_local_get(b, 5)
  emit_local_get(b, 4)
  emit_i32_add(b)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  // Local 1 is the caller's second PARAMETER, and `str_eq` can only consume it
  // when it is a String fat value. #2345 step 2 briefly SYNTHESISED the needle
  // here from locals 6/3 instead, so that a Bytes caller with a heap handle in
  // local 1 could reach this loop. That cost 6 instructions per candidate
  // instead of 1 and measured +0.61% fuel on the string_ops scenario. It is
  // gone: `Bytes::index_of_bytes` now packs its two handles into fat values
  // ONCE, in its own prologue, and CALLS `String::index_of` -- so every caller
  // that reaches this line has a fat value in local 1 again.
  emit_local_get(b, 1)
  emit_call(b, str_eq_idx)
  emit_i32_wrap_i64(b)
  emit_if_void(b)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_br(b, 4)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_i64_const(b, -1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_end(b)
  emit_end(b)
}

export fn gen_string_index_of_body(enable_rc: Bool, str_len_idx: Int, str_substring_idx: Int, str_eq_idx: Int) -> Bytes {
  let _ = str_substring_idx
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  // ADR-0055: String::length is value-world (tagged) under RC; untag both
  // lengths for raw arithmetic, tag the returned index back at the exits.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  emit_i32_gt_u(b)
  emit_if_i64(b)
  emit_i64_const(b, -1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_else(b)
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_local_get(b, 1)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 6)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_sub(b)
  emit_local_set(b, 8)
  emit_windowed_substring_search(b, enable_rc, str_eq_idx)
  b
}

/// `Bytes::index_of(hay, byte)` -- the SINGLE-BYTE search (#2345). Returns the
/// smallest index holding `byte`, or -1.
///
/// It is a separate body from `Bytes::index_of_bytes` rather than a special
/// case of it, and that is the whole reason the surface has two names: this
/// needle is an `Int`, so there is no needle SPAN to hand to `str_eq`. The
/// substring loop compares spans, so it cannot serve this shape at all.
///
/// The kernel is `gen_simd_scan_line_end_body`'s (bodies_core_a2.vibe), which
/// is the same search with LF hardcoded: complete 16-byte chunks go through
/// `v128.load` + `i8x16.splat` + `i8x16.eq` + `i8x16.bitmask`, and the first
/// chunk that reports ANY match hands over to the exact scalar loop, which
/// also covers the final partial chunk. Two differences: the needle is a
/// runtime local instead of a constant 10, and absence answers -1 instead of
/// `len`.
///
/// A needle outside 0..255 answers -1, and does so correctly rather than by
/// accident: `i8x16.splat` takes the low 8 bits, so the vector phase can
/// report a candidate chunk for (say) 300 as if it were 44 -- but it only ever
/// hands over to the scalar loop, which compares the full i64 and never
/// matches. The vector phase can cost a scan; it cannot change an answer.
///
/// The handle loads are the same ones `gen_bytes_get_body` does and are
/// deliberately NOT untagged: a `Bytes` handle is a raw pointer in the value
/// world, and only `Int` carries the `n << 1` tag -- which is why the NEEDLE
/// is untagged here and the haystack is not.
///
///   locals: i32 { 2: addr } ; i64 { 3: i, 4: len, 5: needle }
export fn gen_bytes_index_of_byte_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 2)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)
  emit_i64_extend_i32_u(b)
  emit_local_set(b, 4)
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_local_set(b, 5)
  emit_i64_const(b, 0)
  emit_local_set(b, 3)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_i64_const(b, 16)
  emit_i64_add(b)
  emit_local_get(b, 4)
  emit_i64_gt_s(b)
  emit_br_if(b, 1)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_v128_load(b, 0, 0)
  emit_local_get(b, 5)
  emit_i32_wrap_i64(b)
  emit_i8x16_splat(b)
  emit_i8x16_eq(b)
  emit_i8x16_bitmask(b)
  emit_br_if(b, 1)
  emit_local_get(b, 3)
  emit_i64_const(b, 16)
  emit_i64_add(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 4)
  emit_i64_ge_s(b)
  emit_br_if(b, 1)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i64_extend_i32_u(b)
  emit_local_get(b, 5)
  emit_i64_eq(b)
  emit_br_if(b, 1)
  emit_local_get(b, 3)
  emit_i64_const(b, 1)
  emit_i64_add(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 3)
  emit_local_get(b, 4)
  emit_i64_eq(b)
  emit_if_i64(b)
  emit_i64_const(b, -1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_else(b)
  emit_local_get(b, 3)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_end(b)
  b
}
