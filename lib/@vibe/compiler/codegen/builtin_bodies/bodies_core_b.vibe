export fn gen_str_from_char_code_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  emit_global_get(b, 0)
  emit_local_tee(b, 1)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_const(b, 7)
  emit_i32_add(b)
  emit_i32_const(b, -8)
  bytebuf_push(b, 113)
  emit_global_set(b, 0)
  emit_heap_memory_grow_check(b)
  emit_local_get(b, 1)
  emit_local_get(b, 0)
  // ADR-0055 #705: the char code arrives as a tagged Int (code<<1, see
  // gen_str_char_code_at_body); untag before storing the byte, or every byte is
  // doubled (e.g. decode_string produced 'h'<<1='\xd0'… so `== "hello"` failed).
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  } else {
    ()
  }
  emit_i32_wrap_i64(b)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 1)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_i64_const(b, 1)
  emit_i64_or(b)
  b
}

export fn gen_string_starts_with_body(enable_rc: Bool, str_len_idx: Int, str_substring_idx: Int, str_eq_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  bytebuf_push(b, 75)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_else(b)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_substring_idx)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_local_get(b, 1)
  emit_call(b, str_eq_idx)
  emit_end(b)
  // ADR-0055: starts_with/ends_with return a value-world Bool. str_eq returns raw
  // 0/1 and the needle-too-long branch returns raw 0, so tag the unified if
  // result (true=2) so callers comparing `== true` or storing it see the tag.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  b
}

