  emit_local_set(b, 4)
  emit_br(b, 2)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 5)
  emit_local_get(b, 4)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_local_get(b, 7)
  emit_i32_ne(b)
  emit_i32_eqz(b)
  emit_if_void(b)
  emit_local_get(b, 5)
  emit_local_get(b, 4)
  emit_i32_add(b)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  emit_local_get(b, 1)
