//# Functions

export fn gen_print_i64_body() -> Bytes {
  let b = bytebuf_new()
  emit_i32_const(b, 46)
  emit_local_set(b, 2)
  emit_i32_const(b, 47)
  emit_i32_const(b, 10)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_local_set(b, 1)
  emit_local_get(b, 1)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_local_get(b, 0)
  emit_i64_sub(b)
  emit_else(b)
  emit_local_get(b, 0)
  emit_end(b)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_if_void(b)
  emit_local_get(b, 2)
  emit_i32_const(b, 48)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 4)
  emit_i64_const(b, 10)
  emit_i64_rem_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_const(b, 48)
  emit_i32_add(b)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_local_get(b, 4)
  emit_i64_const(b, 10)
  emit_i64_div_s(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 1)
  emit_if_void(b)
  emit_local_get(b, 2)
  emit_i32_const(b, 45)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_end(b)
  emit_i32_const(b, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_i32_const(b, 47)
  emit_local_get(b, 2)
  emit_i32_sub(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  b
}

/// #2199 ask 2: `__rt_print_i64_raw` -- gen_print_i64_body minus the trailing
/// newline, so a decimal value can sit inside a larger line (the OOB abort
/// message interleaves string fragments and numbers). Digits are built
/// backwards from scratch address 46 exactly as in gen_print_i64_body; the
/// only differences are that no byte 10 is stored at 47 and the iov length
/// stops at 46 instead. Locals match print_i64 (3 x i32 + 1 x i64, type 1).
export fn gen_print_i64_raw_body() -> Bytes {
  let b = bytebuf_new()
  emit_i32_const(b, 46)
  emit_local_set(b, 2)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_local_set(b, 1)
  emit_local_get(b, 1)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_local_get(b, 0)
  emit_i64_sub(b)
  emit_else(b)
  emit_local_get(b, 0)
  emit_end(b)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_if_void(b)
  emit_local_get(b, 2)
  emit_i32_const(b, 48)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 4)
  emit_i64_const(b, 10)
  emit_i64_rem_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_const(b, 48)
  emit_i32_add(b)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_local_get(b, 4)
  emit_i64_const(b, 10)
  emit_i64_div_s(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 1)
  emit_if_void(b)
  emit_local_get(b, 2)
  emit_i32_const(b, 45)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 2)
  emit_end(b)
  emit_i32_const(b, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_i32_const(b, 46)
  emit_local_get(b, 2)
  emit_i32_sub(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  b
}

/// #2199 ask 2: `__rt_oob_abort(prefix_fat, idx, len)` -- the shared
/// formatted abort for every bounds-checked builtin. Prints
/// `<prefix><idx> out of bounds for length <len>\n` and traps, so each trap
/// site only pushes its own prefix constant plus the two values (~20 bytes)
/// instead of carrying the message assembly. `prefix_fat` / `oob_mid_fat` /
/// `oob_nl_fat` are raw (ptr<<32)|len string-table constants (exactly what
/// __rt_print_str takes on both lanes; no RC tag is involved). idx is the
/// untagged SIGNED index -- a negative index prints as negative, not as the
/// huge unsigned value the ge_u check saw. Ends in `unreachable`; the call
/// never returns (type (i64,i64,i64) -> ()).
export fn gen_oob_abort_body(print_str_idx: Int, print_i64_raw_idx: Int, oob_mid_fat: Int, oob_nl_fat: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, print_str_idx)
  emit_local_get(b, 1)
  emit_call(b, print_i64_raw_idx)
  emit_i64_const(b, oob_mid_fat)
  emit_call(b, print_str_idx)
  emit_local_get(b, 2)
  emit_call(b, print_i64_raw_idx)
  emit_i64_const(b, oob_nl_fat)
  emit_call(b, print_str_idx)
  bytebuf_push(b, 0)
  b
}

export fn gen_print_str_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 1)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_i32_const(b, 0)
  emit_local_get(b, 1)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_local_get(b, 2)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  b
}

export fn gen_arr_concat_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 4)
  emit_local_get(b, 3)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 5)
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 6)
  emit_local_get(b, 3)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 7)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i32_add(b)
  emit_local_set(b, 8)
  emit_global_get(b, 0)
  emit_local_tee(b, 9)
  emit_i32_const(b, 12)
  emit_local_get(b, 8)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_i32_add(b)
  emit_i32_add(b)
  emit_global_set(b, 0)
  emit_heap_memory_grow_check(b)
  emit_local_get(b, 9)
  emit_local_get(b, 8)
  emit_i32_store(b, 2, 0)
  emit_local_get(b, 9)
  emit_local_get(b, 8)
  emit_i32_store(b, 2, 4)
  emit_local_get(b, 9)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_local_set(b, 10)
  emit_local_get(b, 9)
  emit_local_get(b, 10)
  emit_i32_store(b, 2, 8)
  emit_local_get(b, 10)
  emit_local_get(b, 6)
  emit_local_get(b, 4)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_memory_copy(b)
  emit_local_get(b, 10)
  emit_local_get(b, 4)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_i32_add(b)
  emit_local_get(b, 7)
  emit_local_get(b, 5)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_memory_copy(b)
  emit_local_get(b, 9)
  emit_i64_extend_i32_u(b)
  b
}

export fn gen_str_concat_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_local_get(b, 1)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_local_set(b, 7)
  emit_global_get(b, 0)
  emit_local_tee(b, 6)
  emit_local_get(b, 7)
  emit_i32_add(b)
  emit_i32_const(b, 7)
  emit_i32_add(b)
  emit_i32_const(b, -8)
  bytebuf_push(b, 113)
  emit_global_set(b, 0)
  emit_heap_memory_grow_check(b)
  emit_local_get(b, 6)
  emit_local_get(b, 4)
  emit_local_get(b, 2)
  emit_memory_copy(b)
  emit_local_get(b, 6)
  emit_local_get(b, 2)
  emit_i32_add(b)
  emit_local_get(b, 5)
  emit_local_get(b, 3)
  emit_memory_copy(b)
  emit_local_get(b, 6)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 7)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  b
}

/// String::join(arr, sep): single-allocation O(n) join.
///
/// Strings are represented inline as the i64 (ptr << 32) | len (see
/// gen_str_concat_body); the bytes live at ptr in the bump heap. The previous
/// implementation accumulated `acc = concat(acc, sep); acc = concat(acc,
/// arr[i])`, which copied the whole prefix each step — O(n^2) time and O(n^2)
/// bump garbage (the streaming bench's dominant cost, and an OOM/out-of-bounds
/// risk at ~4 KB; see scripts/bench_streaming.sh). Instead: pass 1 sums the
/// total length, allocate the result once, pass 2 memcpy's each piece (and the
/// separator) into place — O(n). This also speeds up StringBuilder::freeze,
/// which lowers to String::join(parts, "").
///
/// Locals (params 0=arr, 1=sep are i64): i32 group [2..10] = n, i, total,
/// sep_len, sep_ptr, base, pos, cur_ptr, cur_len; i64 group [11] = cur. Keep
/// meta_i32=9 / meta_i64=1 in linked_compile in sync. arr_len/arr_get use the
/// untagged convention (matching the prior body); ptr/len are extracted exactly
/// as gen_str_concat_body does.
export fn gen_string_join_body(enable_rc: Bool, arr_len_idx: Int, arr_get_idx: Int, str_concat_idx: Int) -> Bytes {
  let _ = str_concat_idx
  let b = bytebuf_new()
  // n = arr_len(arr). Under RC `arr_len` returns the length TAGGED (len<<1) and
  // `arr_get` expects the index TAGGED (#705) — this body otherwise uses the raw
  // untagged convention, so untag the count here and tag each index below, or
  // the loop runs 2*len times (OOB) and reads element i/2.
  emit_local_get(b, 0)
  emit_call(b, arr_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  } else {
    ()
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  // empty array -> the canonical empty-string shape `(ptr << 32) | 0` with a
  // REAL pointer (the current bump pointer; length 0, so nothing is read
  // through it and no allocation happens). The previous `i64.const 0` was
  // indistinguishable from the tagged Int 0, so the value compared and
  // concatenated as an empty string but RENDERED as `0` --
  // `"\{String::join([], ",")}"` printed `0` (#2143). Every other
  // empty-string producer (literal, substring, trim, split) already carries
  // a real pointer; join was the only 0-shaped empty.
  emit_local_get(b, 2)
  emit_i32_eqz(b)
  emit_if_i64(b)
  emit_global_get(b, 0)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_else(b)
  // sep_len = lo32(sep); sep_ptr = hi32(sep)
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_local_get(b, 1)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 6)
  // pass 1: total = sum of len(arr[i])
  emit_i32_const(b, 0)
  emit_local_set(b, 4)
  emit_i32_const(b, 0)
  emit_local_set(b, 3)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  } else {
    ()
  }
  emit_call(b, arr_get_idx)
  emit_local_set(b, 11)
  emit_local_get(b, 4)
  emit_local_get(b, 11)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_local_set(b, 4)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  // total += sep_len * (n - 1)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_i32_mul(b)
  emit_i32_add(b)
  emit_local_set(b, 4)
  // base = bump(total); pos = base
  emit_global_get(b, 0)
  emit_local_tee(b, 7)
  emit_local_get(b, 4)
  emit_i32_add(b)
  emit_i32_const(b, 7)
  emit_i32_add(b)
  emit_i32_const(b, -8)
  bytebuf_push(b, 113)
  emit_global_set(b, 0)
  emit_heap_memory_grow_check(b)
  emit_local_get(b, 7)
  emit_local_set(b, 8)
  // pass 2: copy sep (when i>0) then arr[i] bytes
  emit_i32_const(b, 0)
  emit_local_set(b, 3)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  // if i != 0: memcpy(pos, sep_ptr, sep_len); pos += sep_len
  emit_local_get(b, 3)
  emit_i32_const(b, 0)
  emit_i32_ne(b)
  emit_if_void(b)
  emit_local_get(b, 8)
  emit_local_get(b, 6)
  emit_local_get(b, 5)
  emit_memory_copy(b)
  emit_local_get(b, 8)
  emit_local_get(b, 5)
  emit_i32_add(b)
  emit_local_set(b, 8)
  emit_end(b)
  // cur = arr[i]; cur_ptr = hi32(cur); cur_len = lo32(cur)
  emit_local_get(b, 0)
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  } else {
    ()
  }
  emit_call(b, arr_get_idx)
  emit_local_set(b, 11)
  emit_local_get(b, 11)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 9)
  emit_local_get(b, 11)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 10)
  // memcpy(pos, cur_ptr, cur_len); pos += cur_len
  emit_local_get(b, 8)
  emit_local_get(b, 9)
  emit_local_get(b, 10)
  emit_memory_copy(b)
  emit_local_get(b, 8)
  emit_local_get(b, 10)
  emit_i32_add(b)
  emit_local_set(b, 8)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  // result = (base << 32) | total
  emit_local_get(b, 7)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  emit_end(b)
  b
}

export fn gen_string_trim_body(enable_rc: Bool, str_len_idx: Int, str_char_code_at_idx: Int, str_substring_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 1)
  emit_i32_const(b, 0)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_local_set(b, 3)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  // ADR-0055: char_code_at is value-world under RC — tag the index it consumes.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_char_code_at_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_tee(b, 4)
  emit_i32_const(b, 32)
  emit_i32_eq(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 9)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_local_get(b, 4)
  emit_i32_const(b, 10)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_local_get(b, 4)
  emit_i32_const(b, 13)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_i32_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 2)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  bytebuf_push(b, 76)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_char_code_at_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_tee(b, 4)
  emit_i32_const(b, 32)
  emit_i32_eq(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 9)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_local_get(b, 4)
  emit_i32_const(b, 10)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_local_get(b, 4)
  emit_i32_const(b, 13)
  emit_i32_eq(b)
  bytebuf_push(b, 114)
  emit_i32_eqz(b)
  emit_br_if(b, 1)
  emit_local_get(b, 3)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 3)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 0)
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_local_get(b, 3)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_substring_idx)
  b
}

let static_eq_body_bytes = Bytes::from_array([32, 0, 32, 1, 81, 173])

export fn static_eq_body() -> Bytes {
  static_eq_body_bytes
}

export fn gen_arr_truncate_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  // ADR-0055: untag the odd array pointer under RC.
  if enable_rc {
    emit_i64_const(b, -2)
    emit_i64_and(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_get(b, 1)
  // ADR-0055: the new length arrives tagged; untag before storing.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_store(b, 2, 4)
  b
}

export fn gen_string_split_body(enable_rc: Bool, arr_new_idx: Int, arr_push_idx: Int, str_len_idx: Int, str_substring_idx: Int, string_index_of_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_call(b, arr_new_idx)
  emit_local_set(b, 6)
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_i32_const(b, 0)
  emit_local_set(b, 4)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_substring_idx)
  emit_local_get(b, 1)
  emit_call(b, string_index_of_idx)
  // ADR-0055: String::index_of returns a tagged index under RC; untag for use.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_local_get(b, 5)
  emit_i32_const(b, 0)
  bytebuf_push(b, 72)
  emit_br_if(b, 1)
  emit_local_get(b, 6)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i32_add(b)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_substring_idx)
  emit_call(b, arr_push_idx)
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i32_add(b)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 6)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_local_get(b, 2)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_substring_idx)
  emit_call(b, arr_push_idx)
  emit_local_get(b, 6)
  b
}

/// #997: `i64.trunc_f64_s` TRAPS (an unhandled wasm `unreachable`-style trap,
/// not a catchable vibe error) on NaN, +-Infinity, or any magnitude outside
/// the i64 range -- so `Double::to_int(0.0 / 0.0)` used to abort the whole
/// program instead of returning a value. This wasm build targets neither the
/// nontrapping-float-to-int-conversions proposal nor any other feature flag
/// that would make `i64.trunc_sat_f64_s` available (no emit helper for it
/// exists in wasm_emit, and none of this compiler's wasmtime invocations pass
/// a feature flag for it -- unlike e.g. the gc backend's explicit `-W gc=y`),
/// so the guard is done by hand: NaN and out-of-i64-range values saturate to
/// 0 (a "tolerate, don't trap" choice consistent with e.g. Array::slice's
/// clamping elsewhere in this file) instead of trunc'ing at all.
export fn gen_double_to_int_body() -> Bytes {
  let b = bytebuf_new()
  // NaN: x != x is only true for NaN.
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_f64_ne(b)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_else(b)
  // Upper bound: trunc_f64_s is defined for x < 2^63.
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_f64_const_lohi(b, 0, 1138753536)
  emit_f64_lt(b)
  emit_if_i64(b)
  // Lower bound: trunc_f64_s is defined for x >= -2^63.
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_f64_const_lohi(b, 0, 3286237184)
  emit_f64_ge(b)
  emit_if_i64(b)
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_i64_trunc_f64_s(b)
  emit_else(b)
  emit_i64_const(b, 0)
  emit_end(b)
  emit_else(b)
  emit_i64_const(b, 0)
  emit_end(b)
  emit_end(b)
  b
}

export fn gen_int_to_double_body() -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_f64_convert_i64_s(b)
  emit_i64_reinterpret_f64(b)
  b
}

/// #982: substring had ZERO bounds checks — the packed `(ptr+start)<<32 |
/// (end-start)` view silently read adjacent heap for `end > len`, produced a
/// u32-wrapped length ~4294967294 for `end < start` (i64_extend_i32_u on the
/// negative difference), and read BEFORE the string for a negative `start`.
/// Clamp start into [0, len] and end into [start', len] up front (the same
/// tolerate-not-trap choice as Array::slice below), so every downstream packed
/// view stays inside the source string and `end < start` yields "". Locals:
/// 3/4 = existing i32 scratch, 5 = NEW i64 scratch holding len (meta bumped
/// 2/0 -> 2/1 at the linked_compile push_builtin site).
export fn gen_str_substring_body(enable_rc: Bool) -> Bytes {
  let b = bytebuf_new()
  // local5 = len (i64, untagged): the packed string's low 32 bits.
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i64_extend_i32_u(b)
  emit_local_set(b, 5)
  // param1 (start) := retag(clamp(untag(start), 0, len))
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_else(b)
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_local_get(b, 5)
  emit_i64_gt_s(b)
  emit_if_i64(b)
  emit_local_get(b, 5)
  emit_else(b)
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_end(b)
  emit_end(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_local_set(b, 1)
  // param2 (end) := retag(clamp(untag(end), untag(start'), len))
  emit_local_get(b, 2)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i64_lt_s(b)
  emit_if_i64(b)
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_else(b)
  emit_local_get(b, 2)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_local_get(b, 5)
  emit_i64_gt_s(b)
  emit_if_i64(b)
  emit_local_get(b, 5)
  emit_else(b)
  emit_local_get(b, 2)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_end(b)
  emit_end(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_local_set(b, 2)
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  // ADR-0055: start/end arrive tagged (n<<1) under RC; untag for raw arithmetic.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i64_sub(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_local_get(b, 3)
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  b
}

export fn gen_fs_exists_stub_body() -> Bytes {
  let b = bytebuf_new()
  emit_i64_const(b, 0)
  b
}

export fn gen_string_contains_body(enable_rc: Bool, string_index_of_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_local_get(b, 1)
  emit_call(b, string_index_of_idx)
  // index_of returns a tagged index (-2 for "not found") under RC; `>= 0` still
  // holds since the tag preserves sign. Tag the resulting Bool into the value
  // world (true=2/false=0).
  emit_i64_const(b, 0)
  emit_i64_ge_s(b)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  b
}

/// #748 (ADR-0054 step 3): SIMD memchr substring search. The old body called
/// str_substring + str_eq PER POSITION (two function calls each, ~5.6ns/byte).
/// Now: the needle's first byte is splatted and 16-byte haystack windows with
/// no occurrence are skipped via v128.load + i8x16.eq + v128.any_true; a
/// first-byte hit verifies with ONE str_eq call on a zero-copy packed view
/// ((hp+i)<<32 | ndl_len) — no substring allocation, and the verify rides
/// str_eq's own SIMD chunk path for long needles. Params 0=hay 1=ndl (raw
/// packed). Locals (all i32, meta 8/0): 2=hay_len 3=ndl_len 4=i 5=hay_ptr
/// 6=ndl_ptr 7=first_byte 8=limit (= hay_len - ndl_len, last valid start)
/// 9=chunk_limit (window phase bound; 0 when the range is under 16 starts).
export fn gen_string_index_of_body(enable_rc: Bool, str_len_idx: Int, str_substring_idx: Int, str_eq_idx: Int) -> Bytes {
  let _ = str_substring_idx
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  // ADR-0055: String::length is value-world (tagged) under RC; untag both
  // lengths for raw arithmetic, tag the returned index back at the exits.
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  emit_i32_gt_u(b)
  emit_if_i64(b)
  emit_i64_const(b, -1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_else(b)
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_local_get(b, 1)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 6)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_sub(b)
  emit_local_set(b, 8)
  emit_block_i64(b)
  emit_local_get(b, 3)
  emit_i32_eqz(b)
  emit_if_void(b)
  emit_i64_const(b, 0)
  emit_br(b, 1)
  emit_end(b)
  emit_local_get(b, 6)
  emit_i32_load8_u(b, 0, 0)
  emit_local_set(b, 7)
  emit_i32_const(b, 0)
  emit_local_set(b, 4)
  emit_i32_const(b, 0)
  emit_local_set(b, 9)
  emit_local_get(b, 8)
  emit_i32_const(b, 15)
  emit_i32_ge_u(b)
  emit_if_void(b)
  emit_local_get(b, 8)
  emit_i32_const(b, 14)
  emit_i32_sub(b)
  emit_local_set(b, 9)
  emit_end(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_local_get(b, 8)
  emit_i32_gt_u(b)
