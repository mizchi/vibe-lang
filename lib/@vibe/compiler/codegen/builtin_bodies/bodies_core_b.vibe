export fn gen_string_last_index_of_body(enable_rc: Bool, str_len_idx: Int, str_substring_idx: Int, str_eq_idx: Int) -> Bytes {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_call(b, str_len_idx)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 3)
  emit_local_get(b, 2)
  bytebuf_push(b, 75)
  emit_if_i64(b)
  emit_i64_const(b, -1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_else(b)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_sub(b)
  emit_local_set(b, 4)
  emit_block_i64(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 0)
  bytebuf_push(b, 72)
  emit_br_if(b, 1)
  emit_local_get(b, 0)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_local_get(b, 4)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_call(b, str_substring_idx)
  emit_local_set(b, 5)
  emit_local_get(b, 5)
  emit_local_get(b, 1)
  emit_call(b, str_eq_idx)
  emit_i32_wrap_i64(b)
  emit_if_void(b)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_br(b, 3)
  emit_end(b)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_sub(b)
  emit_local_set(b, 4)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_i64_const(b, -1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  emit_end(b)
  emit_end(b)
  b
}

