//# Imports

import ./loader_hotspot_probe.vibe {
  load_loader_hotspot_fixture, load_loader_hotspot_indexed_fixture, probe_loader_manifest_list_filter_indexed_count_with_index
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/loader {
  build_manifest_path_index, build_manifest_source_index
}

let empty_source_pairs: Array[(String, String)] = array_empty()
let empty_paths: Array[String] = array_empty()
let empty_source_index = build_manifest_source_index(empty_source_pairs)

let cache_preloaded_sources: Array[Array[(String, String)]] = [
  empty_source_pairs
]
let cache_needed_paths: Array[Array[String]] = [
  empty_paths
]
let cache_indexed_needed_paths: Array[Array[String]] = [
  empty_paths
]
let cache_preloaded_source_index: Array[Map[String, String]] = [
  empty_source_index
]
let cache_needed_path_index: Array[Map[String, Bool]] = [
  build_manifest_path_index(empty_paths)
]

fn bench_setup() -> Int with Exception + Fs {
  let (_base_dir, _manifest_rows, preloaded_sources, _needed_sources, needed_paths) = load_loader_hotspot_fixture()
  cache_preloaded_sources[0] = preloaded_sources
  cache_needed_paths[0] = needed_paths
  let (_indexed_base_dir, _indexed_manifest_rows, _indexed_preloaded_sources, _indexed_needed_sources, indexed_needed_paths, preloaded_source_index, needed_path_index, _) = load_loader_hotspot_indexed_fixture()
  cache_indexed_needed_paths[0] = indexed_needed_paths
  cache_preloaded_source_index[0] = preloaded_source_index
  cache_needed_path_index[0] = needed_path_index
  0
}

bench "loader_manifest_list_filter_linear" {
  let filtered_sources = array_empty()
  let mut i = 0
  while i < Array::length(cache_preloaded_sources[0]) {
    let (path, source) = Array::get(cache_preloaded_sources[0], i)
    let mut found = false
    let mut pi = 0
    while pi < Array::length(cache_needed_paths[0]) {
      if Array::get(cache_needed_paths[0], pi) == path {
        found = true
        pi = Array::length(cache_needed_paths[0])
      } else {
        pi = pi + 1
      }
    }
    if found {
      Array::push(filtered_sources, (path, source))
    }
    i = i + 1
  }
  let _ = Array::length(filtered_sources)
}

bench "loader_manifest_list_filter_path_indexed" {
  let _ = probe_loader_manifest_list_filter_indexed_count_with_index(cache_preloaded_sources[0], cache_needed_path_index[0])
}

bench "loader_manifest_list_filter_indexed" {
  let filtered_sources = array_empty()
  let mut i = 0
  while i < Array::length(cache_indexed_needed_paths[0]) {
    let path = Array::get(cache_indexed_needed_paths[0], i)
    if Map::has_key(cache_preloaded_source_index[0], path) {
      Array::push(filtered_sources, (path, Map::get(cache_preloaded_source_index[0], path)))
    }
    i = i + 1
  }
  let _ = Array::length(filtered_sources)
}
