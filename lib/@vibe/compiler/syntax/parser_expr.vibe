//# Imports

// #753 (ADR-0065 Phase 3): the lexer/parser/printer live in the
// @vibe/parser contract package; this module is a re-export shim so the
// compiler's existing import spellings keep working.
export ../../../../lib/@vibe/parser {
  parse,
  parse_expr,
  parse_fn_signature,
  parse_ok,
  shift_expr_offsets,
  shift_stmt_offsets,
  shift_stmts_offsets,
  rewrite_string_binops_stmts
}
