/// Debug probe: lex only
export fn selfbuild_probe_lex() -> Int with Exception {
  let tokens = lex("let add: (Int, Int) -> Int = (a, b) -> { a + b }")
  Array::length(tokens)
}

/// Debug probe: parse only
export fn selfbuild_probe_parse() -> Int with Exception {
  let tokens = lex("let add: (Int, Int) -> Int = (a, b) -> { a + b }")
  let stmts = parse_program(tokens)
  Array::length(stmts)
}

