  let bytes = build_cli_adapter_bytes()
  Bytes::length(bytes)
}

export fn selfbuild_probe_compile_env_get_len() -> Int with Exception {
  let bytes = compile_source_wasi("let main: () -> Int = () -> { let _x = perform Env::Get(\"VIBE_INPUT\"); 0 }", "main")
  Bytes::length(bytes)
}

export fn selfbuild_probe_compile_fs_read_file_len() -> Int with Exception {
  let bytes = compile_source_wasi("let main: () -> Int = () -> { let _x = perform Fs::ReadFile(\"/tmp/in.txt\"); 0 }", "main")
  Bytes::length(bytes)
}

export fn selfbuild_probe_compile_fs_write_bytes_len() -> Int with Exception {
  let bytes = compile_source_wasi("let main: () -> Int = () -> { Fs::write_bytes(\"/tmp/out.wasm\", Bytes::from_array([1])); 0 }", "main")
  Bytes::length(bytes)
}

