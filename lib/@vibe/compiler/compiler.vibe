fn build_cli_adapter_bytes() -> Bytes with Exception {
  let module_source = cli_adapter_module_source()
  if module_source == "" {
    throw("cli_adapter_module_source is empty")
  }
  let adapter_path = "lib/@vibe/compiler/cli_adapter.vibe"
  let source_groups = cli_adapter_source_groups()
  let (bytes, _) = compile_with_source_groups_via_module_source_wasi_unchecked_cached(db_new(), module_source, adapter_path, source_groups, "cli_main")
  bytes
}

/// ADR-0055 #493 cutover: RC-codegen variant of build_cli_adapter_bytes.
/// Compiles the WHOLE compiler (its own embedded module source) under
/// the Perceus RC backend. Running this through stage1 is the decisive
/// whole-compiler-under-RC validity signal for the cutover.
fn build_cli_adapter_bytes_rc() -> Bytes with Exception {
  let module_source = cli_adapter_module_source()
  if module_source == "" {
    throw("cli_adapter_module_source is empty")
  }
  let adapter_path = "lib/@vibe/compiler/cli_adapter.vibe"
  let source_groups = cli_adapter_source_groups()
  let (bytes, _) = compile_with_source_groups_via_module_source_wasi_unchecked_rc(db_new(), module_source, adapter_path, source_groups, "cli_main")
  bytes
}

fn string_to_bytes(s: String) -> Bytes {
  let out = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Bytes::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  out
}

fn compile_cli_adapter_to(output_path: String) -> Int with Exception + Fs {
  if output_path == "" {
    1
  } else {
    let bytes = build_cli_adapter_bytes()
    Fs::write_bytes(output_path, bytes)
    0
  }
}

let cli_trigger_path = "_build/bench/cli_adapter/.compile_cli_trigger"
let cli_stage1_path = "_build/bench/cli_adapter/cli_stage1.wasm"
let cli_merged_dump_path = "_build/bench/cli_adapter/cli_adapter_merged_dump.vibe"
let cli_module_dump_path = "_build/bench/cli_adapter/cli_adapter_module_dump.vibe"

// #768/#778/#769: the entries below use direct-call form
// (Fs::exists/Fs::read_file/Env::get/Env::args_len/Env::args_get), not
// `perform <Effect>::<Op>` -- the perform/effect-op codegen path for magic
// host effects can crash with an uncaught wasm exception (#778) or fail to
// resolve at all (#769's `undefined variable (ident): Env::ArgsLen`, hit
// when this file is loaded standalone through the FS-compile dynamic
// loader rather than the bundle-based self-hosting build) in a small
// compiled unit. This file's own probe helpers below (`compile_source_wasi`
// on a literal source string containing `perform Env::Get(...)`/
// `perform Fs::ReadFile(...)`) are deliberately left untouched -- they test
// that shape of code, not this file's own logic.

/// Lightweight entry for WASI _start/run wrapper.
export fn selfbuild_entry() -> Int with Exception + Fs {
  handle {
    if Fs::exists(cli_trigger_path) {
      compile_cli_adapter_to(cli_stage1_path)
    } else {
      0
    }
  } with Exception {
    Throw(_) => 0
  }
}

export fn selfbuild_write_cli_adapter() -> Int with Exception + Fs {
  compile_cli_adapter_to(cli_stage1_path)
}

export fn selfbuild_dump_cli_adapter_merged_source() -> Int with Exception + Fs {
  Fs::write_bytes(cli_merged_dump_path, string_to_bytes(cli_adapter_merged_source()))
  0
}

export fn selfbuild_dump_cli_adapter_module_source() -> Int with Exception + Fs {
  Fs::write_bytes(cli_module_dump_path, string_to_bytes(cli_adapter_module_source()))
  0
}

export fn selfbuild_dump_cli_adapter_merged_source_env() -> Int with Exception + Fs + Env {
  let output_path = Env::get("VIBE_OUTPUT")
  Fs::write_bytes(output_path, string_to_bytes(cli_adapter_merged_source()))
  0
}

