export fn probe_write_bytes_smoke() -> Int with Exception + Fs + Env {
  let output_path = Env::get("VIBE_OUTPUT")
  Fs::write_bytes(output_path, string_to_bytes("ok\n"))
  0
}

export fn selfbuild_cli_env_entry() -> Int with Exception + Fs + Env {
  let input_path = Env::get("VIBE_INPUT")
  let output_path = Env::get("VIBE_OUTPUT")
  let entry_name = Env::get("VIBE_ENTRY")
  if input_path == "" {
    1
  }
  else if output_path == "" {
    1
  }
  else if entry_name == "" {
    1
  }
  else {
    let source = Fs::read_file(input_path)
    let bytes = compile_source_wasi_only(source, entry_name)
    Fs::write_bytes(output_path, bytes)
    0
  }
}

export fn selfbuild_probe_cli_env_read_len() -> Int with Exception + Fs + Env {
  let input_path = Env::get("VIBE_INPUT")
  let source = Fs::read_file(input_path)
  String::length(source)
}

export fn selfbuild_probe_cli_env_compile_len() -> Int with Exception + Fs + Env {
  let input_path = Env::get("VIBE_INPUT")
  let entry_name = Env::get("VIBE_ENTRY")
  let source = Fs::read_file(input_path)
  let bytes = compile_source_wasi_only(source, entry_name)
  Bytes::length(bytes)
}

export fn selfbuild_probe_cli_args_read_len() -> Int with Exception + Fs + Env {
  let input_path = if Env::args_len() > 0 {
    Env::args_get(0)
  } else {
    ""
  }
  let source = Fs::read_file(input_path)
  String::length(source)
}

export fn selfbuild_probe_cli_args_compile_len() -> Int with Exception + Fs + Env {
  let input_path = if Env::args_len() > 0 {
    Env::args_get(0)
  } else {
    ""
  }
  let entry_name = if Env::args_len() > 2 {
    Env::args_get(2)
  } else {
    ""
  }
  let source = Fs::read_file(input_path)
  let bytes = compile_source_wasi_only(source, entry_name)
  Bytes::length(bytes)
}

export fn selfbuild_cli_args_entry() -> Int with Exception + Fs + Env {
  let input_path = if Env::args_len() > 0 {
    Env::args_get(0)
  } else {
    ""
  }
  let output_path = if Env::args_len() > 1 {
    Env::args_get(1)
  } else {
    ""
  }
  let entry_name = if Env::args_len() > 2 {
    Env::args_get(2)
  } else {
    ""
  }
  if input_path == "" {
    1
  }
  else if output_path == "" {
    1
  }
  else if entry_name == "" {
    1
  }
  else {
    let source = Fs::read_file(input_path)
    // ADR-0055 #493 cutover: the Perceus RC codegen path is the DEFAULT; set
    // VIBE_RC=0 to opt back into the legacy bump path. The #705 RC fixes brought
    // the corpus to parity (28/29; v128 is RC-unsupported by design). The
    // selfbuild / bootstrap / bump-baseline gates pin VIBE_RC=0 (scripts/*.sh) so
    // they self-reproduce byte-identically on the proven bump path until an
    // RC compiler self-build fixpoint is validated; everything else reclaims.
    let bytes = if Env::get("VIBE_RC") != "0" {
      compile_source_wasi_only_rc(source, entry_name)
    } else {
      compile_source_wasi_only(source, entry_name)
    }
    Fs::write_bytes(output_path, bytes)
    0
  }
}

export fn selfbuild_cli_entry() -> Int with Exception + Fs + Env {
  let input_path = "_build/bench/cli_adapter/adapter_input.vibe"
  let output_path = "_build/bench/cli_adapter/adapter_output.wasm"
  if input_path == "" {
    1
  }
  else if output_path == "" {
    1
  }
  else {
    let (bytes, _) = compile_file_fs_cached(db_new(), input_path, "main")
    Fs::write_bytes(output_path, bytes)
    0
  }
}

/// selfbuild helper: use the compiler's own compile pipeline to compile stage2.
export fn selfbuild_compile_stage2() -> Bytes with Exception {
  let main_source = selfbuild_runtime_entry_source()
  if main_source == "" {
    throw("selfbuild_runtime_entry_source is empty")
  }
  compile_source_wasi_only(main_source, "selfbuild_entry")
}

export fn selfbuild_compile_cli_adapter() -> Bytes with Exception {
  build_cli_adapter_bytes()
}

/// ADR-0055 #493 cutover: whole-compiler-under-RC entry. Writes the RC-compiled
/// compiler to VIBE_OUTPUT. Invoked through stage1 by the rc bootstrap
/// gate so the compiler compiles *itself* under the Perceus RC backend.
export fn selfbuild_compile_cli_adapter_rc_env() -> Int with Exception + Fs + Env {
  let output_path = Env::get("VIBE_OUTPUT")
  if output_path == "" {
    1
  } else {
    let bytes = build_cli_adapter_bytes_rc()
    Fs::write_bytes(output_path, bytes)
    0
  }
}

/// Companion default-backend entry, so the gate can compare RC vs default for the
/// same whole-compiler self-compile through one code path.
export fn selfbuild_compile_cli_adapter_env() -> Int with Exception + Fs + Env {
  let output_path = Env::get("VIBE_OUTPUT")
  if output_path == "" {
    1
  } else {
    let bytes = build_cli_adapter_bytes()
    Fs::write_bytes(output_path, bytes)
    0
  }
}

