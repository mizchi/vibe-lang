import @vibe/compiler/core {
  Expr, Stmt
}
import @vibe/compiler/lowering/railway_origin {
  erase_railway_origin_markers_reporting_change
}

fn last_identifier(stmts: Array[Stmt]) -> (String, Int) {
  match Array::get(stmts, 0) {
    SExpr(ESpread(EIdent(name, off))) => (name, off),
    _ => ("unexpected expression", -1)
  }
}

test "erasing a nested railway marker preserves its source offset" {
  let stmts = [SExpr(ESpread(EIdent("__try_none", 23)))]
  inspect(erase_railway_origin_markers_reporting_change(stmts), content = "true")
  inspect(last_identifier(stmts), content = "(None, 23)")
  inspect(erase_railway_origin_markers_reporting_change(stmts), content = "false")
}
