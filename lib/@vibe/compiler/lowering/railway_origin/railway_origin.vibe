// Remove railway origin markers after type checking, preserving source offsets.

import @vibe/compiler/core {
  Expr, Pat, Stmt
}
import @vibe/core {
  array_empty
}

/// After check has classified lowered `let*` via `__try_none`, rewrite that
/// origin marker back to the prelude `None` constructor so codegen does not
/// see an unresolved name. Must not run before check — the marker is what
/// distinguishes `let*` from a user-written `None => None` on the unlocated
/// `parse_program` path (every offset is -1).
fn erase_try_none_expr(expr: Expr, changed: Option[Array[Bool]]) -> Expr {
  match expr {
    EIdent(name, off) => {
      if name == "__try_none" {
        match changed {
          Some(cell) => {
            Array::set(cell, at = 0, value = true)
          },
          None => {
            ()
          }
        }
        EIdent("None", off)
      } else {
        expr
      }
    },
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_, _) => expr,
    EBool(_) => expr,
    EUnit => expr,
    EStringInterp(_) => expr,
    ESpread(e) => ESpread(erase_try_none_expr(expr = e, changed = changed)),
    ETuple(elems) => ETuple(for e in elems {
      erase_try_none_expr(expr = e, changed = changed)
    }),
    EArray(elems) => EArray(for e in elems {
      erase_try_none_expr(expr = e, changed = changed)
    }),
    ERecord(rn, fields, targs) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fval) = Array::get(fields, at = i)
        Array::push(out, value = (fname, erase_try_none_expr(expr = fval, changed = changed)))
        i = i + 1
      }
      ERecord(rn, out, targs)
    },
    EMap(fields) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (k, v) = Array::get(fields, at = i)
        Array::push(out, value = (k, erase_try_none_expr(expr = v, changed = changed)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(erase_try_none_expr(expr = c, changed = changed), erase_try_none_expr(expr = t, changed = changed), erase_try_none_expr(expr = e, changed = changed)),
    ELet(name, val, body, soff) => ELet(name, erase_try_none_expr(expr = val, changed = changed), erase_try_none_expr(expr = body, changed = changed), soff),
    ELetRec(name, val, body) => ELetRec(name, erase_try_none_expr(expr = val, changed = changed), erase_try_none_expr(expr = body, changed = changed)),
    ELetMut(name, val, body, soff) => ELetMut(name, erase_try_none_expr(expr = val, changed = changed), erase_try_none_expr(expr = body, changed = changed), soff),
    EAssign(name, val, cont, target_off) => EAssign(name, erase_try_none_expr(expr = val, changed = changed), erase_try_none_expr(expr = cont, changed = changed), target_off),
    EAssignOp(name, op, val, cont, target_off) => EAssignOp(name, op, erase_try_none_expr(expr = val, changed = changed), erase_try_none_expr(expr = cont, changed = changed), target_off),
    ESeq(a, b) => ESeq(erase_try_none_expr(expr = a, changed = changed), erase_try_none_expr(expr = b, changed = changed)),
    EMatch(scrut, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, at = i)
        Array::push(out, value = (p, erase_try_none_expr(expr = b, changed = changed)))
        i = i + 1
      }
      EMatch(erase_try_none_expr(expr = scrut, changed = changed), out)
    },
    EHandle(scrut, arms) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, at = i)
        Array::push(out, value = (p, erase_try_none_expr(expr = b, changed = changed)))
        i = i + 1
      }
      EHandle(erase_try_none_expr(expr = scrut, changed = changed), out)
    },
    EWhile(c, b) => EWhile(erase_try_none_expr(expr = c, changed = changed), erase_try_none_expr(expr = b, changed = changed)),
    ELoop(params, body) => ELoop(for param in params {
      let (name, init) = param
      (name, erase_try_none_expr(expr = init, changed = changed))
    }, erase_try_none_expr(expr = body, changed = changed)),
    EForIn(name, idx, iter, body) => EForIn(name, idx, erase_try_none_expr(expr = iter, changed = changed), erase_try_none_expr(expr = body, changed = changed)),
    ECall(callee, args, off, callee_resolution) => ECall(erase_try_none_expr(expr = callee, changed = changed), for a in args {
      erase_try_none_expr(expr = a, changed = changed)
    }, off, callee_resolution),
    EBinOp(op, l, r, boff) => EBinOp(op, erase_try_none_expr(expr = l, changed = changed), erase_try_none_expr(expr = r, changed = changed), boff),
    EUnaryOp(op, e) => EUnaryOp(op, erase_try_none_expr(expr = e, changed = changed)),
    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, erase_try_none_expr(expr = body, changed = changed)),
    EDot(obj, field, off, fdoff) => EDot(erase_try_none_expr(expr = obj, changed = changed), field, off, fdoff),
    ELabeledArg(label, name, body) => ELabeledArg(label, name, erase_try_none_expr(expr = body, changed = changed)),
    EReturn(e) => EReturn(erase_try_none_expr(expr = e, changed = changed)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(erase_try_none_expr(expr = e, changed = changed))),
      None => expr
    },
    EContinue(exprs) => EContinue(for e in exprs {
      erase_try_none_expr(expr = e, changed = changed)
    })
  }
}

fn erase_try_none_stmt(s: Stmt, changed: Option[Array[Bool]]) -> Stmt {
  match s {
    SLet(exp, isrec, fname, ann, body) => SLet(exp, isrec, fname, ann, erase_try_none_expr(expr = body, changed = changed)),
    SLetMut(name, ty, e) => SLetMut(name, ty, erase_try_none_expr(expr = e, changed = changed)),
    STest(name, body) => STest(name, erase_try_none_expr(expr = body, changed = changed)),
    SBench(name, body) => SBench(name, erase_try_none_expr(expr = body, changed = changed)),
    SExpr(e) => SExpr(erase_try_none_expr(expr = e, changed = changed)),
    SModule(exp, name, body) => SModule(exp, name, for inner in body {
      erase_try_none_stmt(s = inner, changed = changed)
    }),
    _ => s
  }
}

/// Does `erase_try_none_expr` have anything to rewrite in `expr`? The same
/// walk, reading only: the marker is rare, and rebuilding every node of every
/// statement to find none cost ~16 MB of the self-compile heap. Visits exactly
/// the children the rewrite visits, so a `false` here means the rewrite would
/// have returned an equal tree.
fn has_try_none_expr(_ expr: Expr) -> Bool {
  match expr {
    EIdent(name, _) => name == "__try_none",
    ESpread(e) => has_try_none_expr(e),
    ETuple(elems) => has_try_none_exprs(elems),
    EArray(elems) => has_try_none_exprs(elems),
    ERecord(_, fields, _) => {
      let mut found = false
      let mut i = 0
      while !found && i < Array::length(fields) {
        let (_, fval) = Array::get(fields, at = i)
        found = has_try_none_expr(fval)
        i = i + 1
      }
      found
    },
    EMap(fields) => {
      let mut found = false
      let mut i = 0
      while !found && i < Array::length(fields) {
        let (_, v) = Array::get(fields, at = i)
        found = has_try_none_expr(v)
        i = i + 1
      }
      found
    },
    EIf(c, t, e) => has_try_none_expr(c) || has_try_none_expr(t) || has_try_none_expr(e),
    ELet(_, val, body, _) => has_try_none_expr(val) || has_try_none_expr(body),
    ELetRec(_, val, body) => has_try_none_expr(val) || has_try_none_expr(body),
    ELetMut(_, val, body, _) => has_try_none_expr(val) || has_try_none_expr(body),
    EAssign(_, val, cont, _) => has_try_none_expr(val) || has_try_none_expr(cont),
    EAssignOp(_, _, val, cont, _) => has_try_none_expr(val) || has_try_none_expr(cont),
    ESeq(a, b) => has_try_none_expr(a) || has_try_none_expr(b),
    EMatch(scrut, arms) => has_try_none_expr(scrut) || has_try_none_arms(arms),
    EHandle(scrut, arms) => has_try_none_expr(scrut) || has_try_none_arms(arms),
    EWhile(c, b) => has_try_none_expr(c) || has_try_none_expr(b),
    ELoop(params, body) => {
      let mut found = false
      let mut i = 0
      while !found && i < Array::length(params) {
        let (_, init) = Array::get(params, at = i)
        found = has_try_none_expr(init)
        i = i + 1
      }
      found || has_try_none_expr(body)
    },
    EForIn(_, _, iter, body) => has_try_none_expr(iter) || has_try_none_expr(body),
    ECall(callee, args, _, _) => has_try_none_expr(callee) || has_try_none_exprs(args),
    EBinOp(_, l, r, _) => has_try_none_expr(l) || has_try_none_expr(r),
    EUnaryOp(_, e) => has_try_none_expr(e),
    EFn(_, _, _, _, _, body) => has_try_none_expr(body),
    EDot(obj, _, _, _) => has_try_none_expr(obj),
    ELabeledArg(_, _, body) => has_try_none_expr(body),
    EReturn(e) => has_try_none_expr(e),
    EBreak(opt) => match opt {
      Some(e) => has_try_none_expr(e),
      None => false
    },
    EContinue(exprs) => has_try_none_exprs(exprs),
    _ => false
  }
}

fn has_try_none_exprs(_ exprs: Array[Expr]) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(exprs) {
    found = has_try_none_expr(Array::get(exprs, at = i))
    i = i + 1
  }
  found
}

fn has_try_none_arms(_ arms: Array[(Pat, Expr)]) -> Bool {
  let mut found = false
  let mut i = 0
  while !found && i < Array::length(arms) {
    let (_, b) = Array::get(arms, at = i)
    found = has_try_none_expr(b)
    i = i + 1
  }
  found
}

fn has_try_none_stmt(_ s: Stmt) -> Bool {
  match s {
    SLet(_, _, _, _, body) => has_try_none_expr(body),
    SLetMut(_, _, e) => has_try_none_expr(e),
    STest(_, body) => has_try_none_expr(body),
    SBench(_, body) => has_try_none_expr(body),
    SExpr(e) => has_try_none_expr(e),
    SModule(_, _, body) => {
      let mut found = false
      let mut i = 0
      while !found && i < Array::length(body) {
        found = has_try_none_stmt(Array::get(body, at = i))
        i = i + 1
      }
      found
    },
    _ => false
  }
}

fn erase_railway_origin_markers_impl(stmts: Array[Stmt], changed: Option[Array[Bool]]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, at = i)
    if has_try_none_stmt(stmt) {
      Array::set(stmts, at = i, value = erase_try_none_stmt(s = stmt, changed = changed))
    }
    i = i + 1
  }
}

export fn erase_railway_origin_markers_reporting_change(_ stmts: Array[Stmt]) -> Bool {
  let changed = [false]
  erase_railway_origin_markers_impl(stmts = stmts, changed = Some(changed))
  Array::get(changed, at = 0)
}

export fn erase_railway_origin_markers(_ stmts: Array[Stmt]) -> Unit {
  erase_railway_origin_markers_impl(stmts = stmts, changed = None)
}
