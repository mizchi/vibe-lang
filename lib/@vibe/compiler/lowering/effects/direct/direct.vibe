import @vibe/compiler/core {
  Expr, Pat, Stmt, canonical_builtin_name, is_exception_throw_handler_name, registry_pure_builtin_names
}

import @vibe/core {
  eq_string, hash_string, struct MutSet
}

/// Builtin call classification for the effect lowerings.
///
/// This package held `inline_direct_performs` -- ADR-0076 Phase 2, the pass
/// that spliced a handler arm into a `perform` it could see lexically. #2500
/// deleted it: evidence passing (Phase 3) now covers every shape it covered,
/// measured at 1321/1321 on the unit corpus with the pass switched off, so
/// keeping a second lowering only kept "which lowering did this program take"
/// as a thing that could differ.
///
/// What remains is the classification the OTHER lowerings read: which builtin
/// calls provably cannot perform, and whether a handle's arms discharge an
/// Error operation. The `idp_` prefix is historical -- the names are cited
/// from `evidence.vibe`, `queries.vibe` and `suspend.vibe`, and
/// `verify_pure_builtin_name_agreement` exists to fail the build if a second
/// copy of the audited list appears, so they are renamed in one deliberate
/// move or not at all.

/// call` (this pass, and `scps_named_call_ok`'s suspend-class lowering
/// through it) and `edp_is_pure_builtin_call` (the evidence pass's safety
/// scans) share one table; the evidence pass used to keep a second copy whose
/// doc comment claimed to mirror this one and did not. The audit criterion is
/// the same for both, so a name belongs to both or to neither.
export fn idp_pure_builtin_names() -> Array[String] {
  let out = registry_pure_builtin_names()
  // Names that are not registry rows. A new REGISTRY builtin belongs on
  // the row's is_pure flag, not here; extras that later gain a row must
  // leave this list (the census of extras vs registry is in
  // tests/builtin_registry_classification_test.vibe).
  let extras = [
    "String::unicode_length",
    "String::utf16_length",
    "String::utf8_length",
    "String::to_lower",
    "String::to_upper",
    "string_char_at",
    "Int::to_string",
    "Int::parse",
    "Float64::to_string",
    "Float64::abs",
    "Float64::floor",
    "Float64::ceil",
    "Float64::max",
    "Float64::min",
    "Float64::parse",
    "Float32::to_int",
    "Float32::to_string",
    "Map::size",
    "__index",
    // #3707: the other parser sugars that read a value. `x[a:b]` is
    // `__slice(x, a, b)`, an open end adds `__len(x)`, and a `record { .. }`
    // pattern reads each field with `__rec_field(r, i)`. None performs or
    // takes a function. Off this table, either lowering read the call as
    // opaque: the evidence pass declined to migrate the effect of any
    // function that sliced, so its handle was refused at build time.
    "__slice",
    "__len",
    "__rec_field",
    // #3626: a refutable `let`'s mismatch arm prints a pooled line and
    // traps; it performs nothing and calls nothing the program wrote.
    "__let_refuted",
    "Future::pending",
    "Future::ready",
    "Future::resolve",
    "host_future_get",
    "host_future_named",
    "host_stream_named",
    "HostStream::next",
    "HostStream::close",
    "host_response_named",
    "host_response_named_with",
    "HostResponse::status",
    "HostResponse::body"
  ]
  let mut i = 0
  while i < Array::length(extras) {
    Array::push(out, value = Array::get(extras, at = i))
    i = i + 1
  }
  out
}

/// ADR-0089 (c) (#1218): the per-name raw halves of `host_future_named`.
/// compile_call mints one callee name per import name, so the exact-match
/// list above cannot enumerate them; the prefix is the whole criterion (the
/// suffix is a validated component label, and every such callee is the same
/// `() -> Int` adapter import).
export fn idp_is_host_future_named_raw(_ nm: String) -> Bool {
  String::starts_with(nm, prefix = "vibe_hf_get_raw$")
}

/// ADR-0089 Decision 3 (#1218): the per-name raw halves of
/// `host_stream_named` (`vibe_hs_get_raw$<name>`), same prefix criterion --
/// every such callee is the same `() -> Int` adapter import.
export fn idp_is_host_stream_named_raw(_ nm: String) -> Bool {
  String::starts_with(nm, prefix = "vibe_hs_get_raw$")
}

// #1875 R3: module-level memo -- this predicate runs per CALL NODE of the
// whole merged program during the direct-perform inlining walk, and used to
// rebuild the table (and scan it without early exit) on every probe.
let idp_pure_builtin_names_table: Array[String] = idp_pure_builtin_names()

// #3856: the same table as a set, since membership is asked per call node.
let idp_pure_builtin_names_set: MutSet[String] = idp_names_set(idp_pure_builtin_names_table)

fn idp_names_set(_ names: Array[String]) -> MutSet[String] {
  let out: MutSet[String] = MutSet::with_capacity(hash_fn = hash_string, eq_fn = eq_string, capacity = Array::length(names) * 10 / 7 + 1)
  for name in names {
    MutSet::add(out, x = name)
  }
  out
}

/// #3176: the table's spellings the program being lowered declares at top
/// level, written by `idp_note_program_decls` at the entry of each pass that
/// reads `idp_is_pure_builtin_call`.
///
/// A program may declare its own `fn Future::ready`, `fn Int::to_string` or
/// `fn string_char_at`, and a call of that spelling then reaches the
/// program's function, whatever its row says -- not the builtin the table
/// audited. The predicate answered from the spelling alone, so the suspend
/// and evidence lowerings took such a function for one that cannot perform:
/// measured on main at 05f044574, a row-variable `fn Future::ready(n: Int, g:
/// (Int) -> Int with e) -> Int with e` handed a literal that performs `Ask`
/// answered 389 instead of 111 under a handler that stores `resume`, and
/// trapped with `null function or function signature mismatch` under a
/// tail-resumptive one, where the same function spelled `relay` is refused
/// at compile time. A name the program declares is judged as the program's
/// function, by its declared row, like any other.
///
/// Names the builtin-shadow rename moves (`Map::size` -> `Map::size$user`,
/// see `rename_builtin_shadow_defs`) never land here: that pass runs first,
/// and the builtin spelling then means the builtin again.
let idp_program_decls: Array[String] = []

/// Is `nm` on the audited table, by its own spelling or its canonical one?
fn idp_on_pure_table(_ nm: String) -> Bool {
  // #3136: a legacy alias (`String::from_byte` for `from_char_code`,
  // `String::byte_at` for `char_code_at`) is the same builtin, so it is
  // judged by its canonical name. The table lists canonical names only;
  // matching the spelling alone refused a handle around `from_byte` and
  // compiled an `Async` serve handler calling it to `unreachable`.
  MutSet::has(idp_pure_builtin_names_set, x = nm) || MutSet::has(idp_pure_builtin_names_set, x = canonical_builtin_name(nm))
}

/// #3176: does the program being lowered declare a top-level binding that a
/// call spelled `nm` reaches instead of the builtin?
fn idp_program_declares(_ nm: String) -> Bool {
  let cn = canonical_builtin_name(nm)
  let mut i = 0
  let mut found = false
  while i < Array::length(idp_program_decls) && !found {
    let d = Array::get(idp_program_decls, at = i)
    if d == nm || d == cn {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// #3176: record which of the table's spellings `stmts` declares at top
/// level (a function, a value, an extern, a module member). Replaces what the
/// previous program recorded, so call it at the entry of every pass that asks
/// `idp_is_pure_builtin_call` about this program.
export fn idp_note_program_decls(_ stmts: Array[Stmt]) -> Unit {
  Array::truncate(idp_program_decls, length = 0)
  idp_note_program_decls_into(stmts)
}

fn idp_note_program_decls_into(_ stmts: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, _) => idp_note_program_decl(name),
      SLetMut(name, _, _) => idp_note_program_decl(name),
      SFnDecl(_, name, _, _, _) => idp_note_program_decl(name),
      SExternLet(name, _) => idp_note_program_decl(name),
      SModule(_, _, inner) => idp_note_program_decls_into(inner),
      _ => ()
    }
    i = i + 1
  }
}

fn idp_note_program_decl(_ name: String) -> Unit {
  if idp_on_pure_table(name) && !idp_program_declares(name) {
    Array::push(idp_program_decls, value = name)
  } else {
    ()
  }
}

export fn idp_is_pure_builtin_call(_ nm: String) -> Bool {
  if idp_is_host_future_named_raw(nm) || idp_is_host_stream_named_raw(nm) {
    true
  } else {
    idp_on_pure_table(nm) && !idp_program_declares(nm)
  }
}

fn idp_pat_qname(_ pat: Pat) -> String {
  match pat {
    PCtor(name, _) => name,
    _ => ""
  }
}

/// #1087: `Error` is NON-resumable (#640) -- a `handle .. with Exception` arm
/// never calls resume; its value must become the whole handle's result and
/// the rest of the body must NOT run. The splice below implements exactly
/// the opposite (resumptive) semantics: the arm body replaces the perform
/// in place, so its value becomes the PERFORM's result and the body's
/// continuation keeps running. In tail position the two coincide (which is
/// why the bug stayed hidden); for a non-tail `throw` the arm's value is
/// discarded and the body continues -- a silent wrong-value miscompile.
/// Any handle whose arms discharge an Error operation is therefore never
/// eligible for this pass and stays on the try_table lowering
/// (compile_expr_tail6.vibe), whose catch-and-branch shape aborts the body
/// correctly in every position.
export fn idp_arms_discharge_error(_ arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (p, _) = Array::get(arms, at = i)
    let q = idp_pat_qname(p)
    if is_exception_throw_handler_name(q) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}
