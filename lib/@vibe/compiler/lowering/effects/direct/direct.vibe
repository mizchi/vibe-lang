import @vibe/compiler/core {
  Expr, Pat, canonical_builtin_name, is_exception_throw_handler_name, registry_pure_builtin_names
}

/// Builtin call classification for the effect lowerings.
///
/// This package held `inline_direct_performs` -- ADR-0076 Phase 2, the pass
/// that spliced a handler arm into a `perform` it could see lexically. #2500
/// deleted it: evidence passing (Phase 3) now covers every shape it covered,
/// measured at 1321/1321 on the unit corpus with the pass switched off, so
/// keeping a second lowering only kept "which lowering did this program take"
/// as a thing that could differ.
///
/// What remains is the classification the OTHER lowerings read: which builtin
/// calls provably cannot perform, and whether a handle's arms discharge an
/// Error operation. The `idp_` prefix is historical -- the names are cited
/// from `evidence.vibe`, `queries.vibe` and `suspend.vibe`, and
/// `verify_pure_builtin_name_agreement` exists to fail the build if a second
/// copy of the audited list appears, so they are renamed in one deliberate
/// move or not at all.

/// call` (this pass, and `scps_named_call_ok`'s suspend-class lowering
/// through it) and `edp_is_pure_builtin_call` (the evidence pass's safety
/// scans) share one table; the evidence pass used to keep a second copy whose
/// doc comment claimed to mirror this one and did not. The audit criterion is
/// the same for both, so a name belongs to both or to neither.
export fn idp_pure_builtin_names() -> Array[String] {
  let out = registry_pure_builtin_names()
  // Names that are not registry rows. A new REGISTRY builtin belongs on
  // the row's is_pure flag, not here; extras that later gain a row must
  // leave this list (the census of extras vs registry is in
  // tests/builtin_registry_classification_test.vibe).
  let extras = [
    "String::unicode_length",
    "String::utf16_length",
    "String::utf8_length",
    "String::to_lower",
    "String::to_upper",
    "string_char_at",
    "Int::to_string",
    "Int::parse",
    "Double::to_string",
    "Double::abs",
    "Double::floor",
    "Double::ceil",
    "Double::max",
    "Double::min",
    "Double::parse",
    "Float::to_int",
    "Float::to_string",
    "Map::size",
    "__index",
    "Future::pending",
    "Future::ready",
    "Future::resolve",
    "host_future_get",
    "host_future_named",
    "host_stream_named",
    "HostStream::next",
    "HostStream::close",
    "host_response_named",
    "host_response_named_with",
    "HostResponse::status",
    "HostResponse::body"
  ]
  let mut i = 0
  while i < Array::length(extras) {
    Array::push(out, Array::get(extras, i))
    i = i + 1
  }
  out
}

/// ADR-0089 (c) (#1218): the per-name raw halves of `host_future_named`.
/// compile_call mints one callee name per import name, so the exact-match
/// list above cannot enumerate them; the prefix is the whole criterion (the
/// suffix is a validated component label, and every such callee is the same
/// `() -> Int` adapter import).
export fn idp_is_host_future_named_raw(nm: String) -> Bool {
  String::starts_with(nm, "vibe_hf_get_raw$")
}

/// ADR-0089 Decision 3 (#1218): the per-name raw halves of
/// `host_stream_named` (`vibe_hs_get_raw$<name>`), same prefix criterion --
/// every such callee is the same `() -> Int` adapter import.
export fn idp_is_host_stream_named_raw(nm: String) -> Bool {
  String::starts_with(nm, "vibe_hs_get_raw$")
}

// #1875 R3: module-level memo -- this predicate runs per CALL NODE of the
// whole merged program during the direct-perform inlining walk, and used to
// rebuild the table (and scan it without early exit) on every probe.
let idp_pure_builtin_names_table: Array[String] = idp_pure_builtin_names()

export fn idp_is_pure_builtin_call(nm: String) -> Bool {
  if idp_is_host_future_named_raw(nm) || idp_is_host_stream_named_raw(nm) {
    true
  } else {
    // #3136: a legacy alias (`String::from_byte` for `from_char_code`,
    // `String::byte_at` for `char_code_at`) is the same builtin, so it is
    // judged by its canonical name. The table lists canonical names only;
    // matching the spelling alone refused a handle around `from_byte` and
    // compiled an `Async` serve handler calling it to `unreachable`.
    let cn = canonical_builtin_name(nm)
    let names = idp_pure_builtin_names_table
    let mut i = 0
    let mut found = false
    while i < Array::length(names) && !found {
      if Array::get(names, i) == nm || Array::get(names, i) == cn {
        found = true
      } else {
        ()
      }
      i = i + 1
    }
    found
  }
}

fn idp_pat_qname(pat: Pat) -> String {
  match pat {
    PCtor(name, _) => name,
    _ => ""
  }
}

/// #1087: `Error` is NON-resumable (#640) -- a `handle .. with Exception` arm
/// never calls resume; its value must become the whole handle's result and
/// the rest of the body must NOT run. The splice below implements exactly
/// the opposite (resumptive) semantics: the arm body replaces the perform
/// in place, so its value becomes the PERFORM's result and the body's
/// continuation keeps running. In tail position the two coincide (which is
/// why the bug stayed hidden); for a non-tail `throw` the arm's value is
/// discarded and the body continues -- a silent wrong-value miscompile.
/// Any handle whose arms discharge an Error operation is therefore never
/// eligible for this pass and stays on the try_table lowering
/// (compile_expr_tail6.vibe), whose catch-and-branch shape aborts the body
/// correctly in every position.
export fn idp_arms_discharge_error(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arms) {
    let (p, _) = Array::get(arms, i)
    let q = idp_pat_qname(p)
    if is_exception_throw_handler_name(q) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}
