}

fn array_empty_str() -> Array[String] {
  Array::slice([""], 0, 0)
}

fn array_empty_expr() -> Array[Expr] {
  Array::slice([EUnit], 0, 0)
}

fn array_empty_ecfg() -> Array[(String, Array[String], Array[String])] {
  Array::slice([("", array_empty_str(), array_empty_str())], 0, 0)
}

fn array_empty_scope() -> Array[(String, String)] {
  Array::slice([("", "")], 0, 0)
}

fn array_empty_kind_scope() -> Array[(String, Int)] {
  Array::slice([("", 0)], 0, 0)
}

/// ============================================================
/// ADR-0076 Phase 3a+3b (#817, docs/effect-evidence-passing.md 追記27-29):
/// suspend CPS -- lowering for the third handler class ("suspend": a
/// handler arm STORES `resume` as a first-class value and calls it later,
/// at most once, from a different dynamic extent -- exactly ADR-0068's
/// Async::suspend shape, the scheduler primitive @vibe/concurrent needs).
///
/// Trigger: a `handle` site where at least one arm references `resume` as a
/// bare VALUE (not only as the direct call `resume(x)` -- #942 keeps the
/// tail constraint on that form, and the checker's arm-scope binding of
/// `resume` makes the value form legal in declared-effect arms). Sites with
/// no value reference are completely untouched -- they keep today's
/// replay / Phase-2-inline / evidence-dict paths bit-for-bit.
///
/// Lowering (everything built from EXISTING AST nodes -- no new IR, no new
/// runtime type). Per EFFECT E (injected once, shared by every site and
/// clone -- 3b's call-crossing requires a step type independent of any one
/// handle site):
///
///   enum __ScpsStep_E {                    // variants keyed by NAME
///     __ScpsDone_E(R);                     // computation finished with R
///     __ScpsY_E_op(P..., (Q) -> __ScpsStep_E)  // one per DECLARED op:
///   }                                      //   payload + continuation
///
///   let rec __scps_bubble_E = (st, k) -> match st {   // step composition
///     __ScpsDone_E(v) => k(v),
///     __ScpsY_E_op(p.., kk) => __ScpsY_E_op(p.., (rv) ->
///       __scps_bubble_E(kk(rv), k))        // re-wrap: bubble one level up
///   }
///
/// Per triggered handle site: the body is split at each direct `perform`
/// on its evaluation spine into continuation closures producing
/// __ScpsStep_E values, and the whole handle expression becomes
///
///   let rec __scps_driveN = (st) -> match st {
///     __ScpsDone_E(v) => v,
///     __ScpsY_E_op(p.., k) => {
///       let __scps_onceN = [false]
///       let resume = (rv) -> if __scps_onceN[0] { diag + trap } else {
///         __scps_onceN[0] = true; __scps_driveN(k(rv)) }
///       ARM                              // original arm body, unchanged --
///     }                                  // `resume` is now a plain local
///   }
///   __scps_driveN(<split body>)
///
/// 3b (yield bubbling / selective CPS, wasm_of_ocaml-style): a call in the
/// body (or in a clone body) to a named top-level function `f` whose
/// declared row CONTAINS E is now supported. A CPS CLONE `__scps_cps_E_f`
/// is synthesized -- f's body run through the SAME spine split, so the
/// clone returns __ScpsStep_E (its direct performs become __ScpsY
/// constructions, its own calls to other row-carrying functions become
/// bubble compositions, recursively over a worklist). The ORIGINAL f is
/// left completely untouched for every other caller (tail-resumptive
/// handles via replay / Phase 2 / evidence-dict) -- the double-compilation
/// approach, so this pass never conflicts with those paths. Call sites in
/// suspend-lowered code become
///
///   let x = f(a)  REST   ==>   __scps_bubble_E(__scps_cps_E_f(a),
///                                              (x) -> <split REST>)
///   tail f(a)            ==>   __scps_cps_E_f(a)      // step passthrough
///
/// A clone's EFn carries eff=None deliberately: evidence_dict_pass scans
/// declared rows to build its needing set, and a clone (whose performs are
/// already gone) must not sink an effect's evidence eligibility.
///
///   An arm that stores `resume` and returns without calling it makes the
///   whole handle return the arm's value (the suspend). Calling the stored
///   closure later runs the remaining body up to the next perform, where the
///   SAME driver dispatches the next arm -- a scheduler receives the next
///   continuation exactly as ADR-0068 requires. One-shot is enforced
///   dynamically: the second call of the same continuation writes a
///   diagnostic to stderr and traps (assert(false) miscompiles inside
///   closures, #1095, and Exception::Throw would leak past a no-Error-row
///   entry as a raw exception -- see the trap construction below). Direct
///   tail `resume(v)` calls in a triggered arm route through the same
///   closure (codegen's prefer_bound_call), so the one-shot flag covers
///   them too.
///
/// Eligibility (checked per site and per clone; an INELIGIBLE triggered
/// site is a hard compile error via the returned error list -- never a
/// silent fallback, because a value-referencing arm cannot compile on the
/// replay path at all):
///   - every `perform` of a handled operation, and every call to a
///     row-carrying (needing) function, appears directly on the body's
///     let/seq/tail/branch-tail spine, which includes a `while` / `loop`
///     body (converted to a recursive step-returning closure, #1230/#1536 --
///     including one carrying `break` / `continue`, but not `return`).
///     `for` forms and nested expression positions are not eligible;
///   - every OTHER call in the body is provably unable to perform E:
///     a `perform` of another effect, a hand-audited pure builtin
///     (idp_pure_builtin_names), an enum/suberror constructor application,
///     or a named top-level function whose declared row is CONCRETE and
///     does not contain E (checker row soundness: an unhandled perform of
///     E inside f forces E -- or a row variable -- into f's declared row,
///     so a concrete E-free row cannot reach one). A row-VARIABLE row
///     (`with e` / `with X + e`) on a non-needing callee is
///     ineligible -- the variable could be instantiated to E via a closure
///     argument this pass cannot see;
///   - no nested handle, and no closure containing a handled-op perform or
///     needing call.
/// Arm BODIES are unrestricted (under the driver they are plain code).
///
/// Runs from compile_wasi_module_linked_impl (linear backend) BEFORE
/// inline_direct_performs / evidence_dict_pass, so those passes only ever
/// see the sites this one left alone. The gc backend does not run this pass
/// (linear-first per 追記27) -- a resume-value program on gc fails loudly in
/// gc codegen instead.
export fn suspend_cps_pass(stmts: Array[Stmt]) -> Array[String] {
  let errs = array_empty_str()
  // #1102 perf: allocation-free pre-scan. scps_rewrite reconstructs every
  // node, so it must only run on statements that actually contain a
  // triggered handle — and when NOTHING triggers (every ordinary program,
  // including the compiler itself), skip the fact-table construction
  // below entirely. See scps_expr_has_trigger.
  let mut any_trigger = false
  let mut i0 = 0
  while i0 < Array::length(stmts) {
    if scps_stmt_has_trigger(Array::get(stmts, i0)) {
      any_trigger = true
    } else {
      ()
    }
    i0 = i0 + 1
  }
  if !any_trigger {
    errs
  } else {
    let effect_defs = edp_collect_effect_defs(stmts)
    let fn_defs = edp_collect_fn_defs(stmts)
    let es_names = array_empty()
    let es_members_list = array_empty()
    edp_es_collect_into(stmts, es_names, es_members_list)
    let ctor_names = scps_collect_ctor_names(stmts)
    let ctx = (stmts, effect_defs, fn_defs, es_names, es_members_list, ctor_names)
    let st = (scps_ctr_box(), array_empty_str(), array_empty_str(), array_empty_str(), array_empty_str(), scps_empty_stmts(), errs)
    // closure-CPS (追記31 Vertical B) phase 1: the CPS-mode effect set.
    let cps_effs = scps_collect_cps_effs(stmts)
    let ecfgs = array_empty_ecfg()
    let mut ce = 0
    while ce < Array::length(cps_effs) {
      Array::push(ecfgs, scps_ecfg_for(ctx, Array::get(cps_effs, ce)))
      ce = ce + 1
    }
    // phase 2 (prepass, ALL statements): step-split needing literals and fix
    // up arg conventions at E-row param positions. Records which effects got
    // step-compiled closure values (split_effs) for the phase-5 guard.
    let split_effs = array_empty_str()
    let mut ip = 0
    while ip < (if Array::length(ecfgs) > 0 {
      Array::length(stmts)
    } else {
      0
    }) {
      match Array::get(stmts, ip) {
        // A TOP-LEVEL fn value is the 3b needing-fn world: the ORIGINAL must
        // stay untouched (dual entry -- cps callers go through the
        // __scps_cps_* clone), so the literal-split rule must not apply to
        // the top node itself; only its body's NESTED literals are prepass
        // material. Splitting it here double-wrapped the clone (emit_clone
        // re-split an already-split body into Done(Y(..))).
        SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, ip, SLet(exported, is_rec, name, ty, match expr {
          EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, scps_prepass_expr(b, ecfgs, ctx, st, split_effs, scps_scope_bind_params(array_empty_kind_scope(), params, "", ctx))),
          _ => scps_prepass_expr(expr, ecfgs, ctx, st, split_effs, array_empty_kind_scope())
        })),
        SLetMut(name, ty, expr) => Array::set(stmts, ip, SLetMut(name, ty, match expr {
          EFn(tps, tbs, params, ret, eff, b) => EFn(tps, tbs, params, ret, eff, scps_prepass_expr(b, ecfgs, ctx, st, split_effs, scps_scope_bind_params(array_empty_kind_scope(), params, "", ctx))),
          _ => scps_prepass_expr(expr, ecfgs, ctx, st, split_effs, array_empty_kind_scope())
        })),
        SExpr(expr) => Array::set(stmts, ip, SExpr(scps_prepass_expr(expr, ecfgs, ctx, st, split_effs, array_empty_kind_scope()))),
        STest(tn, expr) => Array::set(stmts, ip, STest(tn, scps_prepass_expr(expr, ecfgs, ctx, st, split_effs, array_empty_kind_scope()))),
        SBench(bn, expr) => Array::set(stmts, ip, SBench(bn, scps_prepass_expr(expr, ecfgs, ctx, st, split_effs, array_empty_kind_scope()))),
        _ => ()
      }
      ip = ip + 1
    }
    // phase 3: transform triggered handle sites (scope threads the lexical
    // step-typed bindings down to each site).
    let scope = array_empty_scope()
    let mut i = 0
    while i < Array::length(stmts) {
      if scps_stmt_has_trigger(Array::get(stmts, i)) {
        match Array::get(stmts, i) {
          SLet(exported, is_rec, name, ty, expr) => Array::set(stmts, i, SLet(exported, is_rec, name, ty, scps_rewrite(expr, ctx, st, cps_effs, scope))),
          SLetMut(name, ty, expr) => Array::set(stmts, i, SLetMut(name, ty, scps_rewrite(expr, ctx, st, cps_effs, scope))),
          SExpr(expr) => Array::set(stmts, i, SExpr(scps_rewrite(expr, ctx, st, cps_effs, scope))),
          STest(tn, expr) => Array::set(stmts, i, STest(tn, scps_rewrite(expr, ctx, st, cps_effs, scope))),
          SBench(bn, expr) => Array::set(stmts, i, SBench(bn, scps_rewrite(expr, ctx, st, cps_effs, scope))),
          _ => ()
        }
      } else {
        ()
      }
      i = i + 1
    }
    // phase 4: process the clone worklist -- it can grow while being
    // processed (a clone's own body may need further clones).
    let (_, _, _, q_eff, q_fn, inj, _) = st
    let mut qi = 0
    while qi < Array::length(q_fn) {
      scps_emit_clone(Array::get(q_eff, qi), Array::get(q_fn, qi), ctx, st)
      qi = qi + 1
    }
    let mut j = 0
    while j < Array::length(inj) {
      Array::push(stmts, Array::get(inj, j))
      j = j + 1
    }
    // phase 5: convention-consistency guard.
    if Array::length(split_effs) > 0 {
      let mut gi = 0
      while gi < Array::length(stmts) {
        match scps_stmt_expr_of(Array::get(stmts, gi)) {
          Some(expr) => scps_guard_untriggered(expr, split_effs, errs),
          None => ()
        }
        gi = gi + 1
      }
    } else {
      ()
    }
    errs
  }
}

// --- pass state accessors. st = (site counter box, injected effect list,
// clone keys ("E||f"), clone queue effects, clone queue fn names,
// injected stmts, errors).

fn scps_ctr_box() -> Array[Int] {
  [0]
}

fn scps_next_site(st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Int {
  let (ctr, _, _, _, _, _, _) = st
  let site = Array::get(ctr, 0)
  Array::set(ctr, 0, site + 1)
  site
}

fn scps_st_errs(st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Array[String] {
  let (_, _, _, _, _, _, errs) = st
  errs
}

fn scps_st_inj(st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Array[Stmt] {
  let (_, _, _, _, _, inj, _) = st
  inj
}

// --- typed-empty helpers (function-signature-driven literal typing, same
// trick as array_empty_str/array_empty_expr above).

fn scps_empty_stmts() -> Array[Stmt] {
  Array::slice([SExpr(EUnit)], 0, 0)
}

fn scps_empty_pats() -> Array[Pat] {
  Array::slice([PWild], 0, 0)
}

fn scps_empty_arms() -> Array[(Pat, Expr)] {
  Array::slice([(PWild, EUnit)], 0, 0)
}

fn scps_empty_tys() -> Array[TypeExpr] {
  Array::slice([TyUnit], 0, 0)
}

fn scps_empty_ctors() -> Array[(String, Array[TypeExpr])] {
  Array::slice([("", scps_empty_tys())], 0, 0)
}

fn scps_empty_tbs() -> Array[(String, Array[String])] {
  Array::slice([("", array_empty_str())], 0, 0)
}

fn scps_empty_params() -> Array[(String, Option[TypeExpr])] {
  Array::slice([("", None)], 0, 0)
}

/// One-parameter closure literal -- continuation, resume wrapper, and driver
/// are all 1-param closures.
fn scps_mk_fn1(param: String, body: Expr) -> Expr {
  let ps = scps_empty_params()
  Array::push(ps, (param, None))
  EFn(array_empty_str(), scps_empty_tbs(), ps, None, None, body)
}

/// A one-parameter continuation that preserves the source callee's declared
/// result type. The suspend split runs after checking, so this annotation is
/// codegen provenance rather than a new typing claim. In particular, a
/// `Double` returned by a needing call must still mark the bubble callback's
/// local slot as floatish; dropping the annotation made `let k = resume;
/// k(v)` stringify the raw f64 bits through the Int path (#2188).
fn scps_mk_fn1_typed(param: String, ty: Option[TypeExpr], body: Expr) -> Expr {
  let ps = scps_empty_params()
  Array::push(ps, (param, ty))
  EFn(array_empty_str(), scps_empty_tbs(), ps, None, None, body)
}

fn scps_mk_fn2(p1: String, p2: String, body: Expr) -> Expr {
  let ps = scps_empty_params()
  Array::push(ps, (p1, None))
  Array::push(ps, (p2, None))
  EFn(array_empty_str(), scps_empty_tbs(), ps, None, None, body)
}

// --- generated-name builders. Step/Done/Y are PER-EFFECT (shared across
// sites and clones); driver locals get a per-site ordinal.

fn scps_step_name(eff: String) -> String {
  String::concat("__ScpsStep_", eff)
}

fn scps_done_name(eff: String) -> String {
  String::concat("__ScpsDone_", eff)
}

fn scps_y_name(eff: String, opname: String) -> String {
  String::concat(String::concat(String::concat("__ScpsY_", eff), "_"), opname)
}

fn scps_bubble_name(eff: String) -> String {
  String::concat("__scps_bubble_", eff)
}

fn scps_sanitize(name: String) -> String {
  let parts = String::split(name, "::")
  String::join(parts, "__")
}

fn scps_clone_name(eff: String, fname: String) -> String {
  String::concat(String::concat(String::concat("__scps_cps_", eff), "_"), scps_sanitize(fname))
}

fn scps_local(prefix: String, site: Int) -> String {
  String::concat(prefix, Int::to_string(site))
}

fn scps_op_suffix(qname: String) -> String {
  let ci = String::index_of(qname, "::")
  if ci > 0 {
    String::substring(qname, ci + 2, String::length(qname))
  } else {
    qname
  }
}

// --- program-fact helpers over the pass context. ctx = (stmts, effect
// defs, fn defs, effectset names, effectset member lists, ctor names).

fn scps_collect_ctor_names(stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty_str()
  Array::push(out, "Some")
  Array::push(out, "Ok")
  Array::push(out, "Err")
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(_, _, _, ctors, _) => {
        let mut ci = 0
        while ci < Array::length(ctors) {
          let (cn, _) = Array::get(ctors, ci)
          Array::push(out, cn)
          ci = ci + 1
        }
      },
      SSuberror(_, _, ctors) => {
        let mut ci = 0
        while ci < Array::length(ctors) {
          let (cn, _) = Array::get(ctors, ci)
          Array::push(out, cn)
          ci = ci + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// Declared ops of `eff` as (opname, arity); found=false when `eff` is not
/// a declared effect in this program.
fn scps_effect_decl_ops(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), eff: String) -> (Bool, Array[(String, Int)]) {
  let (_, effect_defs, _, _, _, _) = ctx
  let out = Array::slice([("", 0)], 0, 0)
  let mut found = false
  let mut i = 0
  while i < Array::length(effect_defs) {
    let (name, ops) = Array::get(effect_defs, i)
    if name == eff {
      found = true
      let mut oi = 0
      while oi < Array::length(ops) {
        let (opname, params, _) = Array::get(ops, oi)
        Array::push(out, (opname, Array::length(params)))
        oi = oi + 1
      }
    } else {
      ()
    }
    i = i + 1
  }
  (found, out)
}

/// Top-level functions whose declared row CONTAINS eff (effectset-aware,
/// via the same edp_row_is_exactly containment evidence_dict_pass uses).
/// #1721 (P0): the same whole-program shadowing drop the evidence pass does.
///
/// This pass matches a call's callee by NAME ONLY against `needing` and
/// retargets it to the `__scps_cps_E_*` clone. `edp_alpha_rename_shadowed`
/// exists to make that safe, but it runs inside `evidence_dict_pass`, which
/// `linked_compile` calls AFTER `suspend_cps_pass` -- so this pass sees the
/// un-renamed local. A local `let helper = () -> Int { 7 }` shadowing a needing
/// `fn helper() -> Int with Ask` had its call rewritten to the top-level
/// function's clone: measured 1511 where 1507 is correct, no diagnostic.
///
/// Dropping is whole-program-conservative rather than scope-threaded, matching
/// `edp_drop_shadowed_needing`'s own established trade (see its doc comment):
/// a needing function whose name is ALSO reused as a binder somewhere loses its
/// needing status here, which costs eligibility, never correctness.
fn scps_needing_for(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), eff: String) -> Array[String] {
  let (stmts, _, fn_defs, es_names, es_members_list, _) = ctx
  edp_drop_shadowed_needing(edp_needing_names(fn_defs, eff, es_names, es_members_list), stmts)
}

/// (is a known top-level fn, its declared row string -- "" for none).
fn scps_fn_row_of(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), name: String) -> (Bool, String) {
  let (_, _, fn_defs, _, _, _) = ctx
  let mut found = false
  let mut row = ""
  let mut i = 0
  while i < Array::length(fn_defs) {
    let (_, _, _, fname, _, frow) = Array::get(fn_defs, i)
    if fname == name {
      found = true
      row = frow
    } else {
      ()
    }
    i = i + 1
  }
  (found, row)
}

/// Does this annotation mention a FUNCTION type anywhere -- directly, or
/// nested inside a type argument or a tuple?
fn scps_ty_has_fn(t: TypeExpr) -> Bool {
  match t {
    TyFn(_, _, _) => true,
    TyApp(_, args) => scps_ty_list_has_fn(args),
    TyTuple(items) => scps_ty_list_has_fn(items),
    _ => false
  }
}

fn scps_ty_list_has_fn(ts: Array[TypeExpr]) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(ts) {
    if scps_ty_has_fn(Array::get(ts, i)) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// The declared RETURN type of a top-level function, if it has one.
///
/// Read off the `EFn` itself: fn_defs carries the BINDING's annotation in that
/// slot (`let f: T = ..`), which is not the same thing and is normally absent.
fn scps_fn_ret_ty(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), name: String) -> Option[TypeExpr] {
  let (stmts, _, _, _, _, _) = ctx
  let mut out = None
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, snm, _, EFn(_, _, _, fret, _, _)) => if snm == name {
        out = fret
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

/// #1536: is this callee FIRST ORDER -- every declared parameter annotated,
/// and no annotation mentioning a function type anywhere?
///
/// That is what makes a row VARIABLE harmless. `fn twice(x: Int) -> Int with e`
/// declares "performs whatever my arguments perform", and with no argument able
/// to carry a row, `e` can only be instantiated to the empty row: the call
/// cannot perform the migrated effect, whatever the call site looks like. A
/// single function-typed parameter (at any depth -- `Array[(Int) -> Int with e]`
/// counts) breaks that argument, so those keep the existing rejection, as does
/// a callee with an unannotated parameter or no definition in scope.
fn scps_callee_first_order(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), name: String) -> Bool {
  let (stmts, _, _, _, _, _) = ctx
  let mut found = false
  let mut ok = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, snm, _, EFn(_, _, params, _, _, _)) => if snm == name {
        found = true
        let mut all = true
        let mut pi = 0
        while pi < Array::length(params) {
          let (_, pty) = Array::get(params, pi)
          match pty {
            Some(t) => if scps_ty_has_fn(t) {
              all = false
            } else {
              ()
            },
            None => {
              all = false
            }
          }
          pi = pi + 1
        }
        ok = all
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found && ok
}

/// #1727 gap 1: the ARGUMENT side of the first-order rule above.
///
/// `scps_callee_first_order` refuses every callee that takes a function,
/// because an argument could instantiate the callee's row variable to the
/// handled effect. That is sound but it reads the callee alone -- and whether
/// the variable can become `eff` is a property of what actually arrives HERE.
/// When every function-typed parameter receives a literal this pass already
/// proves inert for `eff` (`scps_is_inert_literal` -- no `eff` in its row, no
/// row variable of its own, not a step literal, no tainted call in its body),
/// the row variable cannot be instantiated to `eff` at this call site, so the
/// call is E-free for the same reason a first-order one is.
///
/// Fails closed on everything else: a callee this pass cannot find, an
/// untyped parameter, a missing argument, or a function-typed parameter
/// receiving anything other than an inert literal -- a name, a call result, a
/// field access. Those are the shapes whose row this pass cannot read, which
/// is the same line `resolve_row_var_instantiation` draws on the checker side.
fn scps_callee_fn_args_inert(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), name: String, args: Array[Expr], eff: String, needing: Array[String]) -> Bool {
  let (stmts, _, _, _, _, _) = ctx
  let mut found = false
  let mut ok = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, snm, _, EFn(_, _, params, _, _, _)) => if snm == name {
        found = true
        let mut all = true
        let mut pi = 0
        while pi < Array::length(params) {
          let (_, pty) = Array::get(params, pi)
          match pty {
            Some(t) => if scps_ty_has_fn(t) {
              if pi < Array::length(args) && scps_is_inert_literal(Array::get(args, pi), eff, needing, ctx) {
                ()
              } else {
                all = false
              }
            } else {
              ()
            },
            None => {
              all = false
            }
          }
          pi = pi + 1
        }
        ok = all
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found && ok
}

/// #1727 gap 1: `scps_named_call_ok` plus the argument-side widening above.
/// Only reachable when the name-only rule already refused, and only admits the
/// one clause it refused for -- a known function whose row does NOT carry
/// `eff` but DOES carry a variable, called with provably inert functions.
fn scps_named_call_with_args_ok(name: String, args: Array[Expr], sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), scope: Array[(String, Int)]) -> Bool {
  if scps_named_call_ok(name, sctx, ctx, scope) {
    true
  } else {
    let (eff, _, needing, _, _) = sctx
    // A local binding keeps the lexical classification rule; only top-level
    // functions have a declared row this can read.
    if scps_local_class(scope, name) >= 0 {
      false
    } else {
      let (is_fn, row) = scps_fn_row_of(ctx, name)
      is_fn && !scps_row_contains(ctx, row, eff) && scps_row_has_var(row) && scps_callee_fn_args_inert(ctx, name, args, eff, needing)
    }
  }
}

/// A row item starting with a lowercase letter is a row VARIABLE (`with
/// { e }` / `with X + e`): the variable can be instantiated to the
/// migrated effect via a closure argument this pass cannot see, so such a
/// callee is never "provably E-free" from its declaration alone (the call
/// site can still prove it -- see scps_callee_fn_args_inert). Effect names /
/// effectset aliases / qualified ops are all capitalized or contain `::`.
fn scps_row_has_var(row: String) -> Bool {
  if row == "" {
    false
  } else {
    let parts = String::split(row, ",")
    let mut has = false
    let mut i = 0
    while i < Array::length(parts) {
      let item = String::trim(Array::get(parts, i))
      if String::length(item) > 0 && String::index_of(item, "::") < 0 {
        let c = String::char_code_at(item, 0)
        if c >= 97 && c <= 122 {
          has = true
        } else {
          ()
        }
      } else {
        ()
      }
      i = i + 1
    }
    has
  }
}

fn scps_row_contains(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), row: String, eff: String) -> Bool {
  let (_, _, _, es_names, es_members_list, _) = ctx
  if row == "" {
    false
  } else {
    edp_row_is_exactly(row, eff, es_names, es_members_list)
  }
}

fn scps_is_ctor_name(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), nm: String) -> Bool {
  let (_, _, _, _, _, ctor_names) = ctx
  edp_str_array_contains(ctor_names, nm)
}

fn scps_perform_args(e: Expr) -> Array[Expr] {
  match e {
    ECall(_, pargs, _) => if Array::length(pargs) == 1 {
      match Array::get(pargs, 0) {
        ECall(_, op_args, _) => op_args,
        _ => array_empty_expr()
      }
    } else {
      array_empty_expr()
    },
    _ => array_empty_expr()
  }
}

fn scps_call_args(e: Expr) -> Array[Expr] {
  match e {
    ECall(_, args, _) => args,
    _ => array_empty_expr()
  }
}

/// The row string of a function-typed annotation, "" when absent/not a fn.
fn scps_ty_row(ty: Option[TypeExpr]) -> String {
  match ty {
    Some(t) => match t {
      TyFn(_, _, row_opt) => match row_opt {
        Some(row) => row,
        None => ""
      },
      _ => ""
    },
    None => ""
  }
}

/// Is `v` an EFn literal already step-split for `eff` (its body mentions the
/// generated step runtime for that effect)? The generated namespace is
/// reserved (`__Scps`/`__scps_`), so a mention is unambiguous.
///
/// #1371: a CPS CLONE call counts too. A literal whose body is a bare TAIL
/// call to a needing fn splits to the step PASSTHROUGH form
/// (`__scps_cps_E_f(a)`, see scps_split_tail) -- it constructs no step of its
/// own, so it mentions none of the other three names. Missing it here made
/// the arg-position fixup in scps_prepass_expr split the literal a SECOND
/// time, Done-wrapping a body that already returns a step: the task settled
/// with the step OBJECT as its value (a heap pointer read back as the
/// result) and the continuation was never resumed, so a `throw` past the
/// first suspension never ran either. Both call sites that ask this question
/// (the arg-position fixup and the let-bound cps-local rule) need the clone
/// form to answer yes.
fn scps_literal_is_step_for(v: Expr, eff: String) -> Bool {
  match v {
    EFn(_, _, _, _, _, b) => {
      let dn = scps_done_name(eff)
      let bn = scps_bubble_name(eff)
      scps_mentions_step(b, dn, scps_y_name(eff, ""), bn) || scps_mentions_step(b, dn, scps_clone_name(eff, ""), bn)
    },
    _ => false
  }
}

fn scps_mentions_step(e: Expr, dn: String, yprefix: String, bn: String) -> Bool {
  edp_rq_fold(RQMentionsStep(dn, yprefix, bn), e) > 0
}

/// Does the subtree contain a SUSPENDABLE -- a perform of a handled op or
/// a call to a needing function -- ANYWHERE, including inside nested
/// closures and nested handles (both make its timing/ownership dynamic,
/// which the spine split must treat as ineligible in that position)?
fn scps_contains_susp(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {
  edp_rq_fold(RQContainsSusp(sctx), e) > 0
}

fn scps_exprs_contain_susp(es: Array[Expr], sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {
  edp_rq_exprs(RQContainsSusp(sctx), es) > 0
}

/// #1536: is `v` a closure literal this pass can prove INERT for `eff`? Its row
/// must be free of the effect (and of a row variable), it must not be
/// step-split, and its own body must pass the taint scan. A local bound to one
/// is safe both to CALL and to CAPTURE: the call cannot perform, and it returns
/// an ordinary value rather than a step.
///
/// A step-split literal stays out -- calling one yields a step, meaningful only
/// on the CPS spine, and handing it onward is what #1707 guards.
fn scps_is_inert_literal(v: Expr, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Bool {
  match v {
    EFn(_, _, vparams, _, vef, vb) => {
      let row_ok = match vef {
        Some(row) => !scps_row_contains(ctx, row, eff) && !scps_row_has_var(row),
        None => true
      }
      row_ok && !scps_literal_is_step_for(v, eff) && !scps_inert_taint(vb, eff, needing, scps_locals_with_params(array_empty_str(), vparams), ctx)
    },
    _ => false
  }
}

/// Spine names bound to such literals, for the capture-side gate.
fn scps_inert_local_literals(e: Expr, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), out: Array[String]) -> Unit {
  match e {
    ELet(nm, v, b, _) => {
      if scps_is_inert_literal(v, eff, needing, ctx) {
        Array::push(out, nm)
      } else {
        ()
      }
      scps_inert_local_literals(b, eff, needing, ctx, out)
    },
    ELetMut(_, _, b, _) => scps_inert_local_literals(b, eff, needing, ctx, out),
    ELetRec(_, _, b) => scps_inert_local_literals(b, eff, needing, ctx, out),
    ESeq(_, b) => scps_inert_local_literals(b, eff, needing, ctx, out),
    EAssign(_, _, b) => scps_inert_local_literals(b, eff, needing, ctx, out),
    EAssignOp(_, _, _, b) => scps_inert_local_literals(b, eff, needing, ctx, out),
    _ => ()
  }
}

/// #1718 / #1720: lexical authority for every named call in the suspend
/// eligibility and diagnostic walks. Kinds are deliberately internal integers:
/// 0 = opaque, 1 = proven inert, 2 = CPS/step. The array is an immutable stack;
/// reverse lookup makes the latest (currently visible) binder authoritative.
fn scps_local_class(scope: Array[(String, Int)], name: String) -> Int {
  let mut i = Array::length(scope) - 1
  let mut kind = -1
  while i >= 0 && kind < 0 {
    let (nm, k) = Array::get(scope, i)
    if nm == name {
      kind = k
    } else {
      ()
    }
    i = i - 1
  }
  kind
}

fn scps_scope_bind(scope: Array[(String, Int)], name: String, kind: Int) -> Array[(String, Int)] {
  let out = Array::slice(scope, 0, Array::length(scope))
  Array::push(out, (name, kind))
  out
}

fn scps_scope_bind_names(scope: Array[(String, Int)], names: Array[String], kind: Int) -> Array[(String, Int)] {
  let out = Array::slice(scope, 0, Array::length(scope))
  let mut i = 0
  while i < Array::length(names) {
    Array::push(out, (Array::get(names, i), kind))
    i = i + 1
  }
  out
}

fn scps_scope_bind_opt(scope: Array[(String, Int)], name: Option[String], kind: Int) -> Array[(String, Int)] {
  match name {
    Some(nm) => scps_scope_bind(scope, nm, kind),
    None => scope
  }
}

fn scps_scope_bind_params(scope: Array[(String, Int)], params: Array[(String, Option[TypeExpr])], eff: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Array[(String, Int)] {
  let out = Array::slice(scope, 0, Array::length(scope))
  let mut i = 0
  while i < Array::length(params) {
    let (nm, ty) = Array::get(params, i)
    let row = scps_ty_row(ty)
    let kind = if row != "" && scps_row_contains(ctx, row, eff) {
      2
    } else {
      0
    }
    Array::push(out, (nm, kind))
    i = i + 1
  }
  out
}

fn scps_scope_bind_pat(scope: Array[(String, Int)], p: Pat) -> Array[(String, Int)] {
  let names = array_empty_str()
  scps_pat_collect_binds(p, names)
  scps_scope_bind_names(scope, names, 0)
}

fn scps_scope_from_visible(visible: Array[(String, String)], eff: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Array[(String, Int)] {
  let scope: Array[(String, Int)] = []
  let mut i = 0
  while i < Array::length(visible) {
    let (nm, row) = Array::get(visible, i)
    let kind = if row != "" && scps_row_contains(ctx, row, eff) {
      2
    } else {
      0
    }
    Array::push(scope, (nm, kind))
    i = i + 1
  }
  scope
}

fn scps_scope_from_params(params: Array[(String, Option[TypeExpr])], eff: String, inert_generated: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Array[(String, Int)] {
  let scope: Array[(String, Int)] = []
  let mut i = 0
  while i < Array::length(params) {
    let (nm, ty) = Array::get(params, i)
    let row = scps_ty_row(ty)
    let kind = if edp_str_array_contains(inert_generated, nm) {
      1
    } else if row != "" && scps_row_contains(ctx, row, eff) {
      2
    } else {
      0
    }
    Array::push(scope, (nm, kind))
    i = i + 1
  }
  scope
}

/// One shared named-callee predicate for eligibility and culprit diagnostics.
/// Lexical classification MUST precede every spelling-based authorization,
/// including the generated prefix: source is allowed to spell `__scps_*`, so a
/// source-bound opaque local of that spelling must remain opaque.
fn scps_named_call_ok(name: String, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), scope: Array[(String, Int)]) -> Bool {
  let (eff, _, needing, _, _) = sctx
  let kind = scps_local_class(scope, name)
  if kind >= 0 {
    kind == 1 || kind == 2
  } else if String::starts_with(name, "__scps_") || String::starts_with(name, "__Scps") {
    true
  } else if idp_is_pure_builtin_call(name) || scps_is_safe_mut_builtin(name) || scps_is_ctor_name(ctx, name) || edp_str_array_contains(needing, name) {
    true
  } else {
    let (is_fn, row) = scps_fn_row_of(ctx, name)
    is_fn && !scps_row_contains(ctx, row, eff) && (!scps_row_has_var(row) || scps_callee_first_order(ctx, name))
  }
}

/// --- body call policy: a call in a suspend-lowered body must be provably
/// unable to perform E outside this pass's sight. Every recursive edge carries
/// the same immutable lexical classification stack.
fn scps_calls_ok(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), scope: Array[(String, Int)]) -> Bool {
  let (eff, _, needing, _, _) = sctx
  match e {
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if nm == "perform" && Array::length(args) == 1 {
        match Array::get(args, 0) {
          EIdent(_, _) => true,
          ECall(opc, op_args, _) => match opc {
            EIdent(_, _) => scps_exprs_calls_ok(op_args, sctx, ctx, scope),
            _ => false
          },
          _ => false
        }
      } else if scps_named_call_with_args_ok(nm, args, sctx, ctx, scope) {
        scps_exprs_calls_ok(args, sctx, ctx, scope)
      } else {
        false
      },
      _ => false
    },
    ELet(nm, v, b, _) => {
      let vok = scps_calls_ok(v, sctx, ctx, scope)
      let kind = if scps_is_inert_literal(v, eff, needing, ctx) {
        1
      } else if scps_literal_is_step_for(v, eff) {
        2
      } else {
        0
      }
      vok && scps_calls_ok(b, sctx, ctx, scps_scope_bind(scope, nm, kind))
    },
    ELetMut(nm, v, b, _) => scps_calls_ok(v, sctx, ctx, scope) && scps_calls_ok(b, sctx, ctx, scps_scope_bind(scope, nm, 0)),
    ELetRec(nm, v, b) => {
      let ext = scps_scope_bind(scope, nm, 0)
      scps_calls_ok(v, sctx, ctx, ext) && scps_calls_ok(b, sctx, ctx, ext)
    },
    ESeq(a, b) => scps_calls_ok(a, sctx, ctx, scope) && scps_calls_ok(b, sctx, ctx, scope),
    EIf(c, t, el) => scps_calls_ok(c, sctx, ctx, scope) && scps_calls_ok(t, sctx, ctx, scope) && scps_calls_ok(el, sctx, ctx, scope),
    EMatch(s, arms) => {
      let mut ok = scps_calls_ok(s, sctx, ctx, scope)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        if !scps_calls_ok(ex, sctx, ctx, scps_scope_bind_pat(scope, p)) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok
    },
    EHandle(_, _) => false,
    EFn(_, _, params, _, _, b) => scps_calls_ok(b, sctx, ctx, scps_scope_bind_params(scope, params, eff, ctx)),
    EWhile(c, b) => scps_calls_ok(c, sctx, ctx, scope) && scps_calls_ok(b, sctx, ctx, scope),
    EForIn(nm, idx, it, b) => {
      let body_scope = scps_scope_bind_opt(scps_scope_bind(scope, nm, 0), idx, 0)
      scps_calls_ok(it, sctx, ctx, scope) && scps_calls_ok(b, sctx, ctx, body_scope)
    },
    ELoop(pairs, b) => {
      let names = array_empty_str()
      let mut i = 0
      let mut ok = true
      while i < Array::length(pairs) {
        let (nm, v) = Array::get(pairs, i)
        Array::push(names, nm)
        if !scps_calls_ok(v, sctx, ctx, scope) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok && scps_calls_ok(b, sctx, ctx, scps_scope_bind_names(scope, names, 0))
    },
    EBinOp(_, l, r, _) => scps_calls_ok(l, sctx, ctx, scope) && scps_calls_ok(r, sctx, ctx, scope),
    EUnaryOp(_, e2) => scps_calls_ok(e2, sctx, ctx, scope),
    EAssign(_, v, c) => scps_calls_ok(v, sctx, ctx, scope) && scps_calls_ok(c, sctx, ctx, scope),
    EAssignOp(_, _, v, c) => scps_calls_ok(v, sctx, ctx, scope) && scps_calls_ok(c, sctx, ctx, scope),
    EReturn(e2) => scps_calls_ok(e2, sctx, ctx, scope),
    EDot(o, _, _, _) => scps_calls_ok(o, sctx, ctx, scope),
    ELabeledArg(_, _, v) => scps_calls_ok(v, sctx, ctx, scope),
    EBreak(opt) => match opt {
      Some(e2) => scps_calls_ok(e2, sctx, ctx, scope),
      None => true
    },
    EContinue(args) => scps_exprs_calls_ok(args, sctx, ctx, scope),
    ETuple(elems) => scps_exprs_calls_ok(elems, sctx, ctx, scope),
    EArray(elems) => scps_exprs_calls_ok(elems, sctx, ctx, scope),
    ERecord(_, fields, _) => scps_fields_calls_ok(fields, sctx, ctx, scope),
    EMap(fields) => scps_fields_calls_ok(fields, sctx, ctx, scope),
    ESpread(e2) => scps_calls_ok(e2, sctx, ctx, scope),
    _ => true
  }
}

fn scps_exprs_calls_ok(es: Array[Expr], sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), scope: Array[(String, Int)]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(es) {
    if !scps_calls_ok(Array::get(es, i), sctx, ctx, scope) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn scps_fields_calls_ok(fields: Array[(String, Expr)], sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), scope: Array[(String, Int)]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    if !scps_calls_ok(v, sctx, ctx, scope) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

/// --- #1536 / #1514 parity: name the call scps_calls_ok rejected. This walk
/// shares both scps_named_call_ok and the exact lexical stack transitions.
fn scps_first_bad_call_info(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), scope: Array[(String, Int)]) -> (Bool, String, Int) {
  let (eff, _, needing, _, _) = sctx
  match e {
    ECall(callee, args, off) => match callee {
      EIdent(nm, ioff) => if nm == "perform" && Array::length(args) == 1 {
        match Array::get(args, 0) {
          EIdent(_, _) => (false, "", -1),
          ECall(opc, op_args, _) => match opc {
            EIdent(_, _) => scps_first_bad_call_info_exprs(op_args, sctx, ctx, scope),
            _ => (true, nm, scps_pick_off(ioff, off))
          },
          _ => (true, nm, scps_pick_off(ioff, off))
        }
      } else if scps_named_call_ok(nm, sctx, ctx, scope) {
        scps_first_bad_call_info_exprs(args, sctx, ctx, scope)
      } else {
        (true, nm, scps_pick_off(ioff, off))
      },
      EDot(_, field, _, fdoff) => (true, field, fdoff),
      _ => (true, "", off)
    },
    ELet(nm, v, b, _) => {
      let first = scps_first_bad_call_info(v, sctx, ctx, scope)
      let (found, _, _) = first
      if found {
        first
      } else {
        let kind = if scps_is_inert_literal(v, eff, needing, ctx) {
          1
        } else if scps_literal_is_step_for(v, eff) {
          2
        } else {
          0
        }
        scps_first_bad_call_info(b, sctx, ctx, scps_scope_bind(scope, nm, kind))
      }
    },
    ELetMut(nm, v, b, _) => {
      let first = scps_first_bad_call_info(v, sctx, ctx, scope)
      let (found, _, _) = first
      if found {
        first
      } else {
        scps_first_bad_call_info(b, sctx, ctx, scps_scope_bind(scope, nm, 0))
      }
    },
    ELetRec(nm, v, b) => {
      let ext = scps_scope_bind(scope, nm, 0)
      scps_first_bad_call_info_pair(v, b, sctx, ctx, ext)
    },
    ESeq(a, b) => scps_first_bad_call_info_pair(a, b, sctx, ctx, scope),
    EIf(c, t, el) => {
      let first = scps_first_bad_call_info_pair(c, t, sctx, ctx, scope)
      let (found, _, _) = first
      if found {
        first
      } else {
        scps_first_bad_call_info(el, sctx, ctx, scope)
      }
    },
    EMatch(s, arms) => {
      let first = scps_first_bad_call_info(s, sctx, ctx, scope)
      let (first_found, _, _) = first
      if first_found {
        first
      } else {
        let mut found = false
        let mut nm = ""
        let mut off = -1
        let mut i = 0
        while i < Array::length(arms) && !found {
          let (p, ex) = Array::get(arms, i)
          let (f, n, o) = scps_first_bad_call_info(ex, sctx, ctx, scps_scope_bind_pat(scope, p))
          found = f
          nm = n
          off = o
          i = i + 1
        }
        (found, nm, off)
      }
    },
    EHandle(_, _) => (true, "", -1),
    EFn(_, _, params, _, _, b) => scps_first_bad_call_info(b, sctx, ctx, scps_scope_bind_params(scope, params, eff, ctx)),
    EWhile(c, b) => scps_first_bad_call_info_pair(c, b, sctx, ctx, scope),
    EForIn(nm, idx, it, b) => {
      let first = scps_first_bad_call_info(it, sctx, ctx, scope)
      let (found, _, _) = first
      if found {
        first
      } else {
        let body_scope = scps_scope_bind_opt(scps_scope_bind(scope, nm, 0), idx, 0)
        scps_first_bad_call_info(b, sctx, ctx, body_scope)
      }
    },
    ELoop(pairs, b) => {
      let names = array_empty_str()
      let mut found = false
      let mut nm = ""
      let mut off = -1
      let mut i = 0
      while i < Array::length(pairs) && !found {
        let (ln, v) = Array::get(pairs, i)
        Array::push(names, ln)
        let (f, n, o) = scps_first_bad_call_info(v, sctx, ctx, scope)
        found = f
        nm = n
        off = o
        i = i + 1
      }
      if found {
        (found, nm, off)
      } else {
        scps_first_bad_call_info(b, sctx, ctx, scps_scope_bind_names(scope, names, 0))
      }
    },
    EBinOp(_, l, r, _) => scps_first_bad_call_info_pair(l, r, sctx, ctx, scope),
    EUnaryOp(_, e2) => scps_first_bad_call_info(e2, sctx, ctx, scope),
    EAssign(_, v, c) => scps_first_bad_call_info_pair(v, c, sctx, ctx, scope),
    EAssignOp(_, _, v, c) => scps_first_bad_call_info_pair(v, c, sctx, ctx, scope),
    EReturn(e2) => scps_first_bad_call_info(e2, sctx, ctx, scope),
    EDot(o, _, _, _) => scps_first_bad_call_info(o, sctx, ctx, scope),
    ELabeledArg(_, _, v) => scps_first_bad_call_info(v, sctx, ctx, scope),
    EBreak(opt) => match opt {
      Some(e2) => scps_first_bad_call_info(e2, sctx, ctx, scope),
      None => (false, "", -1)
    },
    EContinue(args) => scps_first_bad_call_info_exprs(args, sctx, ctx, scope),
    ETuple(elems) => scps_first_bad_call_info_exprs(elems, sctx, ctx, scope),
    EArray(elems) => scps_first_bad_call_info_exprs(elems, sctx, ctx, scope),
    ERecord(_, fields, _) => scps_first_bad_call_info_fields(fields, sctx, ctx, scope),
    EMap(fields) => scps_first_bad_call_info_fields(fields, sctx, ctx, scope),
    ESpread(e2) => scps_first_bad_call_info(e2, sctx, ctx, scope),
    _ => (false, "", -1)
  }
}

fn scps_pick_off(ident_off: Int, call_off: Int) -> Int {
  if ident_off >= 0 {
    ident_off
  } else {
    call_off
  }
}

fn scps_first_bad_call_info_pair(a: Expr, b: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), scope: Array[(String, Int)]) -> (Bool, String, Int) {
  let first = scps_first_bad_call_info(a, sctx, ctx, scope)
  let (found, _, _) = first
  if found {
    first
  } else {
    scps_first_bad_call_info(b, sctx, ctx, scope)
  }
}

fn scps_first_bad_call_info_exprs(es: Array[Expr], sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), scope: Array[(String, Int)]) -> (Bool, String, Int) {
  let mut i = 0
  let mut found = false
  let mut nm = ""
  let mut off = -1
  while i < Array::length(es) && !found {
    let (f, n, o) = scps_first_bad_call_info(Array::get(es, i), sctx, ctx, scope)
    found = f
    nm = n
    off = o
    i = i + 1
  }
  (found, nm, off)
}

fn scps_first_bad_call_info_fields(fields: Array[(String, Expr)], sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), scope: Array[(String, Int)]) -> (Bool, String, Int) {
  let mut i = 0
  let mut found = false
  let mut nm = ""
  let mut off = -1
  while i < Array::length(fields) && !found {
    let (_, v) = Array::get(fields, i)
    let (f, n, o) = scps_first_bad_call_info(v, sctx, ctx, scope)
    found = f
    nm = n
    off = o
    i = i + 1
  }
  (found, nm, off)
}

/// Render the two culprit fragments for a suspend-lowering ineligibility error.
fn scps_culprit_parts(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), scope: Array[(String, Int)]) -> (String, String) {
  let (found, nm, off) = scps_first_bad_call_info(e, sctx, ctx, scope)
  if !found {
    ("", "")
  } else {
    let clause = if String::length(nm) > 0 {
      String::concat(" (here: the call to '", String::concat(nm, "')"))
    } else {
      ""
    }
    let marker = if off >= 0 {
      if String::length(nm) > 0 {
        String::concat(" [@off=", String::concat(__to_string(off), String::concat(":", String::concat(__to_string(off + String::length(nm)), "]"))))
      } else {
        String::concat(" [@off=", String::concat(__to_string(off), "]"))
      }
    } else {
      ""
    }
    (clause, marker)
  }
}

// --- step constructors.

fn scps_mk_yield(eff: String, opname: String, args: Array[Expr], bind_name: String, cont_body: Expr) -> Expr {
  let payload = array_empty_expr()
  let mut i = 0
  while i < Array::length(args) {
    Array::push(payload, Array::get(args, i))
    i = i + 1
  }
  Array::push(payload, scps_mk_fn1(bind_name, cont_body))
  ECall(EIdent(scps_y_name(eff, opname), -1), payload, -1)
}

fn scps_mk_done(eff: String, v: Expr) -> Expr {
  ECall(EIdent(scps_done_name(eff), -1), [v], -1)
}

// --- per-effect runtime injection: the __ScpsStep_E enum (from the
// effect DECLARATION, so every op has its variant regardless of which
// sites/clones use it) and the __scps_bubble_E composition combinator.
// Injected once per effect per program.

fn scps_ensure_effect_runtime(eff: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Unit {
  let (_, injected, _, _, _, inj, _) = st
  if edp_str_array_contains(injected, eff) {
    ()
  } else {
    Array::push(injected, eff)
    let (_, decl_ops) = scps_effect_decl_ops(ctx, eff)
    // enum
    let ctors = scps_empty_ctors()
    let done_tys = scps_empty_tys()
    Array::push(done_tys, TyName("Int"))
    Array::push(ctors, (scps_done_name(eff), done_tys))
    let mut ei = 0
    while ei < Array::length(decl_ops) {
      let (opname, arity) = Array::get(decl_ops, ei)
      let ytys = scps_empty_tys()
      let mut ti = 0
      while ti < arity + 1 {
        Array::push(ytys, TyName("Int"))
        ti = ti + 1
      }
      Array::push(ctors, (scps_y_name(eff, opname), ytys))
      ei = ei + 1
    }
    Array::push(inj, SEnum(false, scps_step_name(eff), array_empty_str(), ctors, array_empty_str()))
    // bubble: (st, k) -> match st { Done(v) => k(v),
    //   Y_op(p.., kk) => Y_op(p.., (rv) -> bubble(kk(rv), k)) }
    let bname = scps_bubble_name(eff)
    let marms = scps_empty_arms()
    let done_pats = scps_empty_pats()
    Array::push(done_pats, PBind("__scps_bv"))
    Array::push(marms, (PCtor(scps_done_name(eff), done_pats), ECall(EIdent("__scps_bk", -1), [
      EIdent("__scps_bv", -1)
    ], -1)))
    let mut bi = 0
    while bi < Array::length(decl_ops) {
      let (opname, arity) = Array::get(decl_ops, bi)
      let ypats = scps_empty_pats()
      let yargs = array_empty_expr()
      let mut pi = 0
      while pi < arity {
        let pname = scps_local("__scps_bp", pi)
        Array::push(ypats, PBind(pname))
        Array::push(yargs, EIdent(pname, -1))
        pi = pi + 1
      }
      Array::push(ypats, PBind("__scps_bkk"))
      let rewrap = scps_mk_fn1("__scps_brv", ECall(EIdent(bname, -1), [
        ECall(EIdent("__scps_bkk", -1), [EIdent("__scps_brv", -1)], -1),
        EIdent("__scps_bk", -1)
      ], -1))
      Array::push(yargs, rewrap)
      Array::push(marms, (PCtor(scps_y_name(eff, opname), ypats), ECall(EIdent(scps_y_name(eff, opname), -1), yargs, -1)))
      bi = bi + 1
    }
    let bfn = scps_mk_fn2("__scps_bst", "__scps_bk", EMatch(EIdent("__scps_bst", -1), marms))
    Array::push(inj, SLet(false, true, bname, None, bfn))
  }
}

// --- clone worklist.

fn scps_need_clone(eff: String, fname: String, st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Unit {
  let (_, _, clone_keys, q_eff, q_fn, _, _) = st
  let key = String::concat(String::concat(eff, "||"), fname)
  if edp_str_array_contains(clone_keys, key) {
    ()
  } else {
    Array::push(clone_keys, key)
    Array::push(q_eff, eff)
    Array::push(q_fn, fname)
  }
}

// --- the body split: `e` sits in TAIL position of the computation being
// lowered (a handle body or a clone body); the result is an expression
// producing a __ScpsStep_E value. Suspendables (direct performs of E,
// calls to needing functions) are only recognized on the
// let/seq/tail/branch-tail spine. A direct recognized suspension may also
// occupy an if condition, match scrutinee, or plain-assignment RHS: it is
// first named by a fresh ELet, then the existing spine machinery resumes into
// selection/assignment or a while condition. A suspension nested in a COMPOUND
// -- an operand, a call argument, a constructor payload -- is linearized onto
// the same spine first (scps_anf_compound). Tail `&&` / `||` is first lowered
// to an equivalent EIf, so its condition and selected RHS can use the existing
// branch splitter; conditional positions nested in non-tail compounds still
// fail closed. Closure literals are handled on their own prepass step spine;
// supported nested different-effect handles keep their existing ownership path.

fn scps_direct_spine_input(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {
  let (_, ops, _, _, _) = sctx
  scps_as_target_perform(e, ops) >= 0 || scps_as_needing_call(e, sctx) != "" || scps_as_cps_local_call(e, sctx) != ""
}

fn scps_selection_fresh(e: Expr, site: Int) -> String {
  // Reuse the scope-blind collision probe used by sequence-head floating.
  // Passing the whole selection expression ensures the generated binder is
  // absent from both the input and every continuation branch/arm.
  scps_seq_float_fresh("select", e, EUnit, site)
}

// --- #1536 (a) v8: compound input linearization.
//
// The spine above recognizes a suspension only when it IS the whole let value,
// assignment RHS, selection input or statement. Written any other way -- as an
// operand (`acc + perform Get(i)`, which is also what `acc += perform Get(i)`
// becomes once the mutable local is boxed), a call/constructor argument
// (`Some(perform Get(i))`), a comparison in a `while` condition -- the same
// program was rejected, so the accepted spelling depended on where the
// suspension happened to sit rather than on what it did.
//
// The rewrite is A-normalization stopping at the FIRST suspension:
//
//   f(g(x), perform Op(i)) + 1
//     ==>  let h0 = g(x); let h1 = perform Op(i); f(h0, h1) + 1
//
// Every subexpression the original evaluates BEFORE the suspension is named,
// in evaluation order, so nothing is reordered across it: the let chain
// replays the same reads at the same points and only the suspension itself
// moves onto the spine, where the existing machinery splits it. Whatever
// followed the suspension stays where it is and therefore still runs after
// the resume. Suspensions after the first are left in the residual and picked
// up by the next pass over it, so one operand chain converges in as many
// rounds as it has suspensions.
//
// Only strictly-evaluated positions are traversed. A suspension that some
// execution reaching the compound would NOT reach -- inside an if/match branch
// or the right operand of `&&` / `||` -- is not linearizable this way and
// stays fail-closed. Closure literals are step-split by `scps_prepass_expr` on
// their own spine, and supported nested different-effect handles keep their
// existing handler-ownership lowering; neither is floated by this helper.

/// Is `e` a recognized suspension whose own inputs are already suspension-free
/// -- i.e. one the spine can name as it stands?
fn scps_anf_ready(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {
  let (_, ops, _, _, _) = sctx
  if scps_as_target_perform(e, ops) >= 0 {
    !scps_exprs_contain_susp(scps_perform_args(e), sctx)
  } else if scps_as_needing_call(e, sctx) != "" || scps_as_cps_local_call(e, sctx) != "" {
    !scps_exprs_contain_susp(scps_call_args(e), sctx)
  } else {
    false
  }
}

/// Values that may stay where they are instead of being named: evaluating them
/// is unobservable and cannot yield a different result across a suspension.
///
/// A `let mut` read is deliberately NOT one of these. By the time this runs,
/// scps_cellify has rewritten it into `Array::get(cell, 0)`, which is named
/// like any other computation -- so the read keeps happening at its original
/// point in the program even when the suspension is to its right, which is
/// exactly what `acc += perform ..` needs.
///
/// A closure literal is one: the language rejects capturing a `let mut`
/// (err_type_closure_capture_mut), so everything a literal captures is either
/// immutable or a shared cell, and building it earlier or later is the same.
fn scps_anf_is_atom(e: Expr) -> Bool {
  match e {
    EInt(_) => true,
    EFloat(_) => true,
    EString(_) => true,
    EBool(_) => true,
    EUnit => true,
    EIdent(_, _) => true,
    EFn(_, _, _, _, _, _) => true,
    _ => false
  }
}

/// Control transfers are not values; naming one would move the transfer.
fn scps_anf_nameable(e: Expr) -> Bool {
  match e {
    EReturn(_) => false,
    EBreak(_) => false,
    EContinue(_) => false,
    _ => true
  }
}

/// ctr = (next binder ordinal, blocked flag). The flag lets `scps_anf_name`,
/// which has to return an expression, still refuse a position.
fn scps_anf_ctr() -> Array[Int] {
  [0, 0]
}

fn scps_anf_fresh(probe: Expr, site: Int, ctr: Array[Int]) -> String {
  let n = Array::get(ctr, 0)
  Array::set(ctr, 0, n + 1)
  // Probe the WHOLE enclosing expression, not just the compound: the binders
  // this mints scope over the continuation too, so a user spelling anywhere
  // in it must push the generated name aside.
  scps_seq_float_fresh(String::concat("anf", Int::to_string(n)), probe, EUnit, site)
}

fn scps_anf_bind(e: Expr, probe: Expr, site: Int, ctr: Array[Int], bn: Array[String], bv: Array[Expr]) -> Expr {
  let h = scps_anf_fresh(probe, site, ctr)
  Array::push(bn, h)
  Array::push(bv, e)
  EIdent(h, -1)
}

/// Name one subexpression that the original evaluates before the suspension.
fn scps_anf_name(e: Expr, probe: Expr, site: Int, ctr: Array[Int], bn: Array[String], bv: Array[Expr]) -> Expr {
  match e {
    // Argument syntax, not a value: name what it wraps.
    ELabeledArg(l, m, v) => ELabeledArg(l, m, scps_anf_name(v, probe, site, ctr, bn, bv)),
    ESpread(v) => ESpread(scps_anf_name(v, probe, site, ctr, bn, bv)),
    _ => if scps_anf_is_atom(e) {
      e
    } else if scps_anf_nameable(e) {
      scps_anf_bind(e, probe, site, ctr, bn, bv)
    } else {
      Array::set(ctr, 1, 1)
      e
    }
  }
}

/// Walk `e` in evaluation order. Status 0 = no suspension in `e` (unchanged),
/// 1 = the first suspension was named and `e` rebuilt around it, 2 = blocked.
fn scps_anf_walk(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), probe: Expr, site: Int, ctr: Array[Int], bn: Array[String], bv: Array[Expr]) -> (Int, Expr) {
  if !scps_contains_susp(e, sctx) {
    (0, e)
  } else if scps_anf_ready(e, sctx) {
    (1, scps_anf_bind(e, probe, site, ctr, bn, bv))
  } else {
    match e {
      // A suspension inside a call's arguments -- including the operand list
      // of a not-yet-ready `perform Op(..)`, which is a call two levels down.
      // The callee is evaluated first and is left alone: naming it would turn
      // a by-name call into a call through a local binding, which is the one
      // shape the suspend lowering cannot see through.
      ECall(callee, args, off) => if scps_contains_susp(callee, sctx) || !scps_anf_is_atom(callee) {
        (2, e)
      } else {
        let (s, args2) = scps_anf_walk_exprs(args, sctx, probe, site, ctr, bn, bv)
        if s == 1 {
          (1, ECall(callee, args2, off))
        } else {
          (2, e)
        }
      },
      EBinOp(op, l, r, boff) => if op == "&&" || op == "||" {
        // Only the left operand is unconditionally evaluated.
        if scps_contains_susp(r, sctx) {
          // #1536: the whole short-circuit is nameable for the same reason a
          // selection is -- this walk only reaches strictly evaluated
          // positions -- but only if the spine will then accept
          // `let h = l && r`. Unlike a selection, that acceptance is
          // conditional, and a decline would send the value straight back
          // here to be named again, which does not converge. So ask the
          // decision procedure itself (its verdict depends only on the RHS,
          // not on the binder or the continuation it would build).
          if scps_contains_susp(l, sctx) {
            (2, e)
          } else {
            match scps_let_shortcircuit_bind("__scps_sc_probe", r, EUnit, -1, site, sctx, false) {
              Some(_) => (1, scps_anf_bind(e, probe, site, ctr, bn, bv)),
              None => (2, e)
            }
          }
        } else {
          let (s, l2) = scps_anf_walk(l, sctx, probe, site, ctr, bn, bv)
          if s == 1 {
            (1, EBinOp(op, l2, r, boff))
          } else {
            (2, e)
          }
        }
      } else if scps_contains_susp(l, sctx) {
        let (s, l2) = scps_anf_walk(l, sctx, probe, site, ctr, bn, bv)
        if s == 1 {
          (1, EBinOp(op, l2, r, boff))
        } else {
          (2, e)
        }
      } else {
        let l2 = scps_anf_name(l, probe, site, ctr, bn, bv)
        let (s, r2) = scps_anf_walk(r, sctx, probe, site, ctr, bn, bv)
        if s == 1 {
          (1, EBinOp(op, l2, r2, boff))
        } else {
          (2, e)
        }
      },
      EUnaryOp(op, a) => {
        let (s, a2) = scps_anf_walk(a, sctx, probe, site, ctr, bn, bv)
        if s == 1 {
          (1, EUnaryOp(op, a2))
        } else {
          (2, e)
        }
      },
      EDot(o, f, off, foff) => {
        let (s, o2) = scps_anf_walk(o, sctx, probe, site, ctr, bn, bv)
        if s == 1 {
          (1, EDot(o2, f, off, foff))
        } else {
          (2, e)
        }
      },
      ELabeledArg(l, m, v) => {
        let (s, v2) = scps_anf_walk(v, sctx, probe, site, ctr, bn, bv)
        if s == 1 {
          (1, ELabeledArg(l, m, v2))
        } else {
          (2, e)
        }
      },
      ESpread(a) => {
        let (s, a2) = scps_anf_walk(a, sctx, probe, site, ctr, bn, bv)
        if s == 1 {
          (1, ESpread(a2))
        } else {
          (2, e)
        }
      },
      ETuple(items) => {
        let (s, items2) = scps_anf_walk_exprs(items, sctx, probe, site, ctr, bn, bv)
        if s == 1 {
          (1, ETuple(items2))
        } else {
          (2, e)
        }
      },
      EArray(items) => {
        let (s, items2) = scps_anf_walk_exprs(items, sctx, probe, site, ctr, bn, bv)
        if s == 1 {
          (1, EArray(items2))
        } else {
          (2, e)
        }
      },
      ERecord(rn, fields, targs) => {
        let (s, fields2) = scps_anf_walk_fields(fields, sctx, probe, site, ctr, bn, bv)
        if s == 1 {
          (1, ERecord(rn, fields2, targs))
        } else {
          (2, e)
        }
      },
      EMap(fields) => {
        let (s, fields2) = scps_anf_walk_fields(fields, sctx, probe, site, ctr, bn, bv)
        if s == 1 {
          (1, EMap(fields2))
        } else {
          (2, e)
        }
      },
      // #1536: a selection is NOT walked into -- naming a suspension that
      // lives in one branch would run the operation on the path that does not
      // select that branch. But the selection AS A WHOLE is an ordinary
      // subexpression of the compound, and this walk only reaches strictly
      // evaluated positions, so it can be named exactly where it stands. That
      // puts `let h = if c { .. } else { .. }` on the spine, which the binding
      // distribution then lowers -- so `1 + (if c { perform .. } else { 0 })`
      // is accepted without the conditional position ever being floated out of.
      //
      // A selection carrying `break` / `continue` / `return` is left blocked
      // here rather than named: those transfers do not survive being moved
      // into a binding, and the distribution refuses them anyway.
      EIf(_, _, _) => if scps_has_loop_ctl(e) {
        (2, e)
      } else {
        (1, scps_anf_bind(e, probe, site, ctr, bn, bv))
      },
      EMatch(_, _) => if scps_has_loop_ctl(e) {
        (2, e)
      } else {
        (1, scps_anf_bind(e, probe, site, ctr, bn, bv))
      },
      _ => (2, e)
    }
  }
}

fn scps_anf_walk_exprs(es: Array[Expr], sctx: (String, Array[String], Array[String], Int, Array[String]), probe: Expr, site: Int, ctr: Array[Int], bn: Array[String], bv: Array[Expr]) -> (Int, Array[Expr]) {
  let mut idx = -1
  let mut i = 0
  while i < Array::length(es) {
    if idx < 0 {
      if scps_contains_susp(Array::get(es, i), sctx) {
        idx = i
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  if idx < 0 {
    (0, es)
  } else {
    let out = array_empty_expr()
    let mut j = 0
    while j < idx {
      Array::push(out, scps_anf_name(Array::get(es, j), probe, site, ctr, bn, bv))
      j = j + 1
    }
    let (s, hit) = scps_anf_walk(Array::get(es, idx), sctx, probe, site, ctr, bn, bv)
    Array::push(out, hit)
    // Everything after the first suspension keeps its place: it already ran
    // after it, and it still does.
    let mut k = idx + 1
    while k < Array::length(es) {
      Array::push(out, Array::get(es, k))
      k = k + 1
    }
    if s == 1 {
      (1, out)
    } else {
      (2, es)
    }
  }
}

fn scps_anf_walk_fields(fields: Array[(String, Expr)], sctx: (String, Array[String], Array[String], Int, Array[String]), probe: Expr, site: Int, ctr: Array[Int], bn: Array[String], bv: Array[Expr]) -> (Int, Array[(String, Expr)]) {
  let mut idx = -1
  let mut i = 0
  while i < Array::length(fields) {
    let (_, fv) = Array::get(fields, i)
    if idx < 0 {
      if scps_contains_susp(fv, sctx) {
        idx = i
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  if idx < 0 {
    (0, fields)
  } else {
    let out = scps_empty_pairs()
    let mut j = 0
    while j < idx {
      let (fn0, fv0) = Array::get(fields, j)
      Array::push(out, (fn0, scps_anf_name(fv0, probe, site, ctr, bn, bv)))
      j = j + 1
    }
    let (hn, hv) = Array::get(fields, idx)
    let (s, hit) = scps_anf_walk(hv, sctx, probe, site, ctr, bn, bv)
    Array::push(out, (hn, hit))
    let mut k = idx + 1
    while k < Array::length(fields) {
      Array::push(out, Array::get(fields, k))
      k = k + 1
    }
    if s == 1 {
      (1, out)
    } else {
      (2, fields)
    }
  }
}

/// Linearize `sub` (a compound occupying a spine slot of `probe`). Returns
/// `(ok, binder names, binder values, residual)`; the binders are meant to be
/// wrapped around the whole rebuilt slot with `scps_anf_wrap`.
fn scps_anf_compound(sub: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), probe: Expr, site: Int) -> (Bool, Array[String], Array[Expr], Expr) {
  let bn = array_empty_str()
  let bv = array_empty_expr()
  let ctr = scps_anf_ctr()
  let (s, out) = scps_anf_walk(sub, sctx, probe, site, ctr, bn, bv)
  if s == 1 && Array::get(ctr, 1) == 0 && Array::length(bn) > 0 {
    (true, bn, bv, out)
  } else {
    // Partial bindings are dropped with the arrays; nothing observed them.
    (false, bn, bv, sub)
  }
}

fn scps_anf_wrap(bn: Array[String], bv: Array[Expr], body: Expr) -> Expr {
  let mut out = body
  let mut i = Array::length(bn) - 1
  while i >= 0 {
    out = ELet(Array::get(bn, i), Array::get(bv, i), out, -1)
    i = i - 1
  }
  out
}

/// Push one immutable-let binding into the terminal of a selected short-circuit
/// RHS block. Only parser-produced let/sequence continuation spines are
/// traversed, and every suspending spine element must already be a direct input
/// accepted by scps_split_tail. A plain terminal is valid only after that spine
/// carried the selected suspension; control-transfer and arbitrary compound
/// terminals stay closed.
/// Moving the outer continuation under a traversed let widens that binder, so
/// alpha-rename it first using the seq-float freshness contract.
fn scps_let_shortcircuit_bind(result: String, rhs: Expr, continuation: Expr, result_off: Int, site: Int, sctx: (String, Array[String], Array[String], Int, Array[String]), carried: Bool) -> Option[Expr] {
  match rhs {
    ELet(x, v, b, off) => {
      let susp = scps_contains_susp(v, sctx)
      if susp && !scps_direct_spine_input(v, sctx) {
        None
      } else {
        let nx = scps_seq_float_fresh(x, b, continuation, site)
        match scps_let_shortcircuit_bind(result, scps_rename_ident(b, x, nx), continuation, result_off, site, sctx, carried || susp) {
          Some(rest) => Some(ELet(nx, v, rest, off)),
          None => None
        }
      }
    },
    ESeq(a, b) => {
      let susp = scps_contains_susp(a, sctx)
      if susp && !scps_direct_spine_input(a, sctx) {
        None
      } else {
        match scps_let_shortcircuit_bind(result, b, continuation, result_off, site, sctx, carried || susp) {
          Some(rest) => Some(ESeq(a, rest)),
          None => None
        }
      }
    },
    // A source control transfer cannot be rebound inside the synthetic resume
    // continuation: it would target that closure rather than its source scope.
    EReturn(_) => None,
    EBreak(_) => None,
    EContinue(_) => None,
    // #1536: a COMPOUND terminal (`perform Op(1) > 0`) is bound as it stands.
    // The binding this produces lives inside the SELECTED branch of the
    // lowered conditional, so everything in it is strictly evaluated once the
    // branch is taken -- which is exactly the precondition the spine's
    // linearization needs. If that linearization cannot handle the compound
    // after all, the split refuses there, as it would have here.
    _ => if scps_contains_susp(rhs, sctx) {
      Some(ELet(result, rhs, continuation, result_off))
    } else if carried {
      Some(ELet(result, rhs, continuation, result_off))
    } else {
      None
    }
  }
}

fn scps_split_tail(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> (Bool, Expr) {
  let (eff, ops, _, site, cps_locals) = sctx
  if !scps_contains_susp(e, sctx) {
    (true, scps_mk_done(eff, e))
  } else {
    let tail_idx = scps_as_target_perform(e, ops)
    let tail_needing = scps_as_needing_call(e, sctx)
    let tail_cps = scps_as_cps_local_call(e, sctx)
    if tail_idx >= 0 {
      // tail `perform Op(a..)` -- the op's value IS the computation's value.
      let targs = scps_perform_args(e)
      if scps_exprs_contain_susp(targs, sctx) {
        (false, e)
      } else {
        let tv = scps_local("__scps_tv", site)
        (true, scps_mk_yield(eff, scps_op_suffix(Array::get(ops, tail_idx)), targs, tv, scps_mk_done(eff, EIdent(tv, -1))))
      }
    } else if tail_needing != "" {
      // tail call to a needing fn -- its clone already returns a step.
      let cargs = scps_call_args(e)
      if scps_exprs_contain_susp(cargs, sctx) {
        (false, e)
      } else {
        scps_need_clone(eff, tail_needing, st)
        (true, ECall(EIdent(scps_clone_name(eff, tail_needing), -1), cargs, -1))
      }
    } else if tail_cps != "" {
      // closure-CPS (追記31 Vertical B): tail call through a step-typed
      // closure binding -- the call already returns a step. Passthrough.
      let cargs = scps_call_args(e)
      if scps_exprs_contain_susp(cargs, sctx) {
        (false, e)
      } else {
        (true, e)
      }
    } else {
      match e {
        // #1536 tail short-circuit: preserve conditional RHS evaluation by
        // expressing the whole tail boolean as the equivalent conditional.
        // Re-entering this function reuses the established EIf condition and
        // branch splitting, including exact-once resume behavior. This arm is
        // deliberately tail-only; generic compound ANF still refuses to walk
        // the RHS of && / || in assignments, calls, selections and seq heads.
        EBinOp(op, l, r, _) => if op == "&&" {
          scps_split_tail(EIf(l, r, EBool(false)), sctx, ctx, st)
        } else if op == "||" {
          scps_split_tail(EIf(l, EBool(true), r), sctx, ctx, st)
        } else {
          let (aok, abn, abv, e2) = scps_anf_compound(e, sctx, e, site)
          if aok {
            scps_split_tail(scps_anf_wrap(abn, abv, e2), sctx, ctx, st)
          } else {
            (false, e)
          }
        },
        ELet(x, v, b, off) => {
          // #1536 immutable-let short-circuit: only a whole initializer with
          // a non-suspending left operand may distribute its binding and
          // continuation into the conditionally evaluated branches. Generic
          // compound ANF remains fail-closed for short-circuit RHS positions.
          let shortcircuit = match v {
            EBinOp(op, l, r, _) => if !scps_contains_susp(l, sctx) && scps_contains_susp(r, sctx) {
              match scps_let_shortcircuit_bind(x, r, b, off, site, sctx, false) {
                Some(selected) => if op == "&&" {
                  Some(EIf(l, selected, ELet(x, EBool(false), b, off)))
                } else if op == "||" {
                  Some(EIf(l, ELet(x, EBool(true), b, off), selected))
                } else {
                  None
                },
                None => None
              }
            } else {
              None
            },
            _ => None
          }
          match shortcircuit {
            Some(lowered) => scps_split_tail(lowered, sctx, ctx, st),
            None => {
              let vp = scps_as_target_perform(v, ops)
              let vn = scps_as_needing_call(v, sctx)
              let vc = scps_as_cps_local_call(v, sctx)
              if vp >= 0 {
                let vargs = scps_perform_args(v)
                if scps_exprs_contain_susp(vargs, sctx) {
                  (false, e)
                } else {
                  let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
                  (bok, scps_mk_yield(eff, scps_op_suffix(Array::get(ops, vp)), vargs, x, bexpr))
                }
              } else if vn != "" {
                let vargs = scps_call_args(v)
                if scps_exprs_contain_susp(vargs, sctx) {
                  (false, e)
                } else {
                  scps_need_clone(eff, vn, st)
                  let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
                  (bok, ECall(EIdent(scps_bubble_name(eff), -1), [
                    ECall(EIdent(scps_clone_name(eff, vn), -1), vargs, -1),
                    scps_mk_fn1_typed(x, scps_call_ret_ty(v, ctx, e), bexpr)
                  ], -1))
                }
              } else if vc != "" {
                // closure-CPS: `let x = f(a) REST` where `f` is a step-typed
                // closure binding -- bubble the step it returns, no clone.
                let vargs = scps_call_args(v)
                if scps_exprs_contain_susp(vargs, sctx) {
                  (false, e)
                } else {
                  let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
                  (bok, ECall(EIdent(scps_bubble_name(eff), -1), [
                    v,
                    scps_mk_fn1(x, bexpr)
                  ], -1))
                }
              } else if scps_contains_susp(v, sctx) {
                // #1536: a block or a selection that IS the whole bound value
                // moves the binding inward instead of asking the compound ANF
                // to walk a position it cannot.
                match scps_bind_value_float(false, x, v, b, off, site) {
                  Some(lowered) => scps_split_tail(lowered, sctx, ctx, st),
                  None => {
                    // #1536 (a) v8: the value is a compound around the suspension.
                    let (aok, abn, abv, av) = scps_anf_compound(v, sctx, e, site)
                    if aok {
                      scps_split_tail(scps_anf_wrap(abn, abv, ELet(x, av, b, off)), sctx, ctx, st)
                    } else {
                      (false, e)
                    }
                  }
                }
              } else {
                // closure-CPS: a let-bound literal the prepass step-split makes
                // `x` a step-typed binding for the rest of this spine; a
                // non-step rebind of an existing cps-local name masks it.
                let is_step_lit = scps_literal_is_step_for(v, eff)
                let (_, s_ops, s_needing, s_site, s_cps) = sctx
                let sctx2 = if is_step_lit {
                  let ext = Array::slice(s_cps, 0, Array::length(s_cps))
                  Array::push(ext, x)
                  (eff, s_ops, s_needing, s_site, ext)
                } else if edp_str_array_contains(s_cps, x) {
                  let masked = array_empty_str()
                  let mut mi = 0
                  while mi < Array::length(s_cps) {
                    let mnm = Array::get(s_cps, mi)
                    if mnm == x {
                      ()
                    } else {
                      Array::push(masked, mnm)
                    }
                    mi = mi + 1
                  }
                  (eff, s_ops, s_needing, s_site, masked)
                } else {
                  sctx
                }
                let (bok, bexpr) = scps_split_tail(b, sctx2, ctx, st)
                (bok, ELet(x, v, bexpr, off))
              }
            }
          }
        },
        ESeq(a, b) => match a {
          // #1230: a loop in statement position takes `b` as its exit
          // continuation -- see scps_split_while. Only when the loop
          // ITSELF suspends: a loop that merely PRECEDES a suspension
          // stays an ordinary `while` (Codex P1 on #1263). Converting one
          // that never suspends would trade a constant-space loop for
          // recursion the tail-call rewrite can no longer flatten (it runs
          // before this pass), so a long ordinary loop would exhaust the
          // wasm call stack on its way to a suspension further down.
          EWhile(wc, wb) => if scps_contains_susp(a, sctx) {
            scps_split_while(wc, wb, b, sctx, ctx, st)
          } else {
            let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
            (bok, ESeq(a, bexpr))
          },
          // #1536 (a) v3, let-floating: a suspending let-chain compound in
          // SEQUENCE HEAD position (what an async-iterator `for` in statement
          // position desugars to -- `ELet(__iter_src, ..)` terminating in the
          // loop, with the rest of the body as the seq tail) is rebalanced
          // onto the continuation spine this split already handles:
          //   ESeq(ELet(x, v, k), b)  ==>  ELet(nx, v, ESeq(k[x:=nx], b))
          // Widening the binder's scope over `b` is only sound if `b` cannot
          // capture it, so the binder is ALWAYS alpha-renamed to a
          // site-suffixed fresh spelling first (shadow-aware, assignment
          // targets included -- scps_rename_ident): any `x` free in `b`
          // refers to an OUTER binding and must keep doing so. Two floated
          // binders collide in `nx` only if they share the original name, and
          // then surface block scoping already guarantees the inner one
          // shadows every use the rename could reach. Non-suspending heads
          // keep the ordinary statement path below (same reasoning as the
          // `while` arm above: no gratuitous restructuring).
          ELet(x, v, k, off) => if scps_contains_susp(a, sctx) {
            let nx = scps_seq_float_fresh(x, k, b, site)
            scps_split_tail(ELet(nx, v, ESeq(scps_rename_ident(k, x, nx), b), off), sctx, ctx, st)
          } else {
            let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
            (bok, ESeq(a, bexpr))
          },
          ELetMut(x, v, k, off) => if scps_contains_susp(a, sctx) {
            let nx = scps_seq_float_fresh(x, k, b, site)
            scps_split_tail(ELetMut(nx, v, ESeq(scps_rename_ident(k, x, nx), b), off), sctx, ctx, st)
          } else {
            let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
            (bok, ESeq(a, bexpr))
          },
          // #1536 (a) v4: distribute the sequence continuation through a
          // suspending conditional. The condition remains outside the
          // branches, so it is evaluated exactly once before exactly one
          // branch and its continuation. Branch-local lets remain lexical
          // to their branch because `b` is an ESeq sibling, not their body.
          EIf(c, t, el) => if scps_contains_susp(a, sctx) {
            if scps_direct_spine_input(c, sctx) {
              let sx = scps_selection_fresh(e, site)
              scps_split_tail(ELet(sx, c, EIf(EIdent(sx, -1), ESeq(t, b), ESeq(el, b)), -1), sctx, ctx, st)
            } else if scps_contains_susp(c, sctx) {
              let (aok, abn, abv, ac) = scps_anf_compound(c, sctx, e, site)
              if aok {
                scps_split_tail(scps_anf_wrap(abn, abv, ESeq(EIf(ac, t, el), b)), sctx, ctx, st)
              } else {
                (false, e)
              }
            } else {
              scps_split_tail(EIf(c, ESeq(t, b), ESeq(el, b)), sctx, ctx, st)
            }
          } else {
            let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
            (bok, ESeq(a, bexpr))
          },
          // #1536 (a) v4: likewise distribute through match after first
          // alpha-renaming every pattern binder. The tail was outside the
          // match originally; without the rename, a pattern binding could
          // capture an outer reference in the duplicated tail.
          EMatch(s, arms) => if scps_contains_susp(a, sctx) {
            if scps_direct_spine_input(s, sctx) {
              let sx = scps_selection_fresh(e, site)
              scps_split_tail(ELet(sx, s, EMatch(EIdent(sx, -1), scps_seq_float_match_arms(arms, b, site)), -1), sctx, ctx, st)
            } else if scps_contains_susp(s, sctx) {
              let (aok, abn, abv, as2) = scps_anf_compound(s, sctx, e, site)
              if aok {
                scps_split_tail(scps_anf_wrap(abn, abv, ESeq(EMatch(as2, arms), b)), sctx, ctx, st)
              } else {
                (false, e)
              }
            } else {
              scps_split_tail(EMatch(s, scps_seq_float_match_arms(arms, b, site)), sctx, ctx, st)
            }
          } else {
            let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
            (bok, ESeq(a, bexpr))
          },
          // Reassociate a suspending nested sequence head so its own head
          // surfaces for the arms above: ESeq(ESeq(a1, a2), b) ==>
          // ESeq(a1, ESeq(a2, b)). Strictly decreases head size, so the
          // rewrite loop terminates.
          ESeq(a1, a2) => if scps_contains_susp(a, sctx) {
            scps_split_tail(ESeq(a1, ESeq(a2, b)), sctx, ctx, st)
          } else {
            let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
            (bok, ESeq(a, bexpr))
          },
          _ => {
            let ap = scps_as_target_perform(a, ops)
            let an = scps_as_needing_call(a, sctx)
            if ap >= 0 {
              let aargs = scps_perform_args(a)
              if scps_exprs_contain_susp(aargs, sctx) {
                (false, e)
              } else {
                let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
                (bok, scps_mk_yield(eff, scps_op_suffix(Array::get(ops, ap)), aargs, scps_local("__scps_w", site), bexpr))
              }
            } else if an != "" {
              let aargs = scps_call_args(a)
              if scps_exprs_contain_susp(aargs, sctx) {
                (false, e)
              } else {
                scps_need_clone(eff, an, st)
                let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
                (bok, ECall(EIdent(scps_bubble_name(eff), -1), [
                  ECall(EIdent(scps_clone_name(eff, an), -1), aargs, -1),
                  scps_mk_fn1(scps_local("__scps_w", site), bexpr)
                ], -1))
              }
            } else if scps_as_cps_local_call(a, sctx) != "" {
              // closure-CPS: statement-position call through a step-typed
              // closure binding -- bubble, discard the resumed value.
              let aargs = scps_call_args(a)
              if scps_exprs_contain_susp(aargs, sctx) {
                (false, e)
              } else {
                let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
                (bok, ECall(EIdent(scps_bubble_name(eff), -1), [
                  a,
                  scps_mk_fn1(scps_local("__scps_w", site), bexpr)
                ], -1))
              }
            } else if scps_contains_susp(a, sctx) {
              // #1536 (a) v8: a compound STATEMENT around the suspension --
              // `Array::push(out, perform Op(i))`, or the `Array::set` that a
              // boxed `acc += perform ..` became.
              let (aok, abn, abv, a2) = scps_anf_compound(a, sctx, e, site)
              if aok {
                scps_split_tail(scps_anf_wrap(abn, abv, ESeq(a2, b)), sctx, ctx, st)
              } else {
                (false, e)
              }
            } else {
              let (bok, bexpr) = scps_split_tail(b, sctx, ctx, st)
              (bok, ESeq(a, bexpr))
            }
          }
        },
        EIf(c, t, el) => if scps_direct_spine_input(c, sctx) {
          let sx = scps_selection_fresh(e, site)
          scps_split_tail(ELet(sx, c, EIf(EIdent(sx, -1), t, el), -1), sctx, ctx, st)
        } else if scps_contains_susp(c, sctx) {
          let (aok, abn, abv, ac) = scps_anf_compound(c, sctx, e, site)
          if aok {
            scps_split_tail(scps_anf_wrap(abn, abv, EIf(ac, t, el)), sctx, ctx, st)
          } else {
            (false, e)
          }
        } else {
          let (tok, te) = scps_split_tail(t, sctx, ctx, st)
          let (eok, ee) = scps_split_tail(el, sctx, ctx, st)
          if tok && eok {
            (true, EIf(c, te, ee))
          } else {
            (false, e)
          }
        },
        EMatch(s, arms) => if scps_direct_spine_input(s, sctx) {
          let sx = scps_selection_fresh(e, site)
          scps_split_tail(ELet(sx, s, EMatch(EIdent(sx, -1), arms), -1), sctx, ctx, st)
        } else if scps_contains_susp(s, sctx) {
          let (aok, abn, abv, as2) = scps_anf_compound(s, sctx, e, site)
          if aok {
            scps_split_tail(scps_anf_wrap(abn, abv, EMatch(as2, arms)), sctx, ctx, st)
          } else {
            (false, e)
          }
        } else {
          let out = scps_empty_arms()
          let mut ok = true
          let mut i = 0
          while i < Array::length(arms) {
            let (mp, mb) = Array::get(arms, i)
            let (aok, ae) = scps_split_tail(mb, sctx, ctx, st)
            if !aok {
              ok = false
            } else {
              ()
            }
            Array::push(out, (mp, ae))
            i = i + 1
          }
          if ok {
            (true, EMatch(s, out))
          } else {
            (false, e)
          }
        },
        // #1536 (a) v6: a plain assignment RHS that is itself one direct
        // recognized suspension can use the established let spine. Probe the
        // whole assignment when minting the binder so assignment targets and
        // continuation names cannot collide with it. Compound RHS and
        // EAssignOp deliberately keep the generic fail-closed path.
        EAssign(x, v, b) => if scps_direct_spine_input(v, sctx) {
          let ax = scps_seq_float_fresh("assign", e, EUnit, site)
          scps_split_tail(ELet(ax, v, EAssign(x, EIdent(ax, -1), b), -1), sctx, ctx, st)
        } else if scps_contains_susp(v, sctx) {
          // #1536: a block or a selection as the whole RHS moves the assignment
          // inward, exactly as a binding does. A target boxed by cellification
          // was already reshaped before that rewrite (scps_float_direct_assign);
          // this arm covers targets bound outside this spine.
          match scps_assign_value_float(x, v, b, site) {
            Some(lowered) => scps_split_tail(lowered, sctx, ctx, st),
            None => {
              // #1536 (a) v8: compound RHS (`x = f(perform Op())`). An `x op=`
              // RHS arrives here too, as the `Array::set` head scps_cellify
              // makes of it.
              let (aok, abn, abv, av) = scps_anf_compound(v, sctx, e, site)
              if aok {
                scps_split_tail(scps_anf_wrap(abn, abv, EAssign(x, av, b)), sctx, ctx, st)
              } else {
                (false, e)
              }
            }
          }
        } else {
          (false, e)
        },
        ELetMut(x, v, b, off) => if scps_contains_susp(v, sctx) {
          // #1536: block- or selection-valued initializer -- move the
          // `let mut` inward. A distributed branch then boxes its own copy of
          // the continuation, which is what the cell is for.
          match scps_bind_value_float(true, x, v, b, off, site) {
            Some(lowered) => scps_split_tail(lowered, sctx, ctx, st),
            None => {
              // #1536 (a) v8: compound initializer. The binders wrap outside
              // the `let mut`, so the cell is still created after they run.
              let (aok, abn, abv, av) = scps_anf_compound(v, sctx, e, site)
              if aok {
                scps_split_tail(scps_anf_wrap(abn, abv, ELetMut(x, av, b, off)), sctx, ctx, st)
              } else {
                (false, e)
              }
            }
          }
        } else {
          // #1230: box the mutable local so every continuation closure on
          // this spine shares one cell instead of capturing a copy.
          let (_, s_ops, s_needing, s_site, s_cps) = sctx
          let masked = array_empty_str()
          let mut mi = 0
          while mi < Array::length(s_cps) {
            let mnm = Array::get(s_cps, mi)
            if mnm == x {
              ()
            } else {
              Array::push(masked, mnm)
            }
            mi = mi + 1
          }
          let sctx2 = (eff, s_ops, s_needing, s_site, masked)
          // Float a direct assignment suspension before cellification turns a
          // write to `x` into Array::set(...). After that rewrite the perform
          // would be nested in a builtin argument and no longer recognizable.
          let b2 = scps_float_direct_assign(b, sctx2, site)
          let (bok, bexpr) = scps_split_tail(scps_cellify(b2, x), sctx2, ctx, st)
          let cell = array_empty_expr()
          Array::push(cell, v)
          (bok, ELet(x, EArray(cell), bexpr, off))
        },
        EWhile(c, b) => scps_split_while(c, b, EUnit, sctx, ctx, st),
        // #1536 (a) v8: a compound in TAIL position (`1 + perform Op()`,
        // `Some(perform Op())`). Tail && / || was handled above without asking
        // generic ANF to traverse its conditional RHS. Everything else not
        // linearizable -- a for form, nested closure/handle, or transfer --
        // still lands on (false, e).
        _ => {
          let (aok, abn, abv, e2) = scps_anf_compound(e, sctx, e, site)
          if aok {
            scps_split_tail(scps_anf_wrap(abn, abv, e2), sctx, ctx, st)
          } else {
            (false, e)
          }
        }
      }
    }
  }
}

/// Name direct suspension RHS values before mutable-local boxing. This pass
/// traverses continuation-spine positions; expression normalization separately
/// handles supported closure and nested-handle forms before this pass.
///
/// #1536: a block- or selection-valued RHS is reshaped here too, and for the
/// same reason it has to happen BEFORE cellification: once `x = v` has become
/// `Array::set(x, 0, v)`, `v` is a builtin argument, and floating it out of
/// there would mean duplicating the evaluation of the other arguments.
fn scps_float_direct_assign(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), site: Int) -> Expr {
  match e {
    EAssign(x, v, b) => if scps_direct_spine_input(v, sctx) {
      let ax = scps_seq_float_fresh("assign", e, EUnit, site)
      ELet(ax, v, EAssign(x, EIdent(ax, -1), scps_float_direct_assign(b, sctx, site)), -1)
    } else if scps_contains_susp(v, sctx) {
      match scps_assign_value_float(x, v, b, site) {
        // Each float strictly shrinks the RHS, so re-running this walk on the
        // result converges instead of looping.
        Some(lowered) => scps_float_direct_assign(lowered, sctx, site),
        None => EAssign(x, v, scps_float_direct_assign(b, sctx, site))
      }
    } else {
      EAssign(x, v, scps_float_direct_assign(b, sctx, site))
    },
    EAssignOp(nm, op, v, b) => EAssignOp(nm, op, v, scps_float_direct_assign(b, sctx, site)),
    ELet(x, v, b, off) => ELet(x, v, scps_float_direct_assign(b, sctx, site), off),
    ELetMut(x, v, b, off) => ELetMut(x, v, scps_float_direct_assign(b, sctx, site), off),
    ELetRec(x, v, b) => ELetRec(x, v, scps_float_direct_assign(b, sctx, site)),
    ESeq(a, b) => ESeq(a, scps_float_direct_assign(b, sctx, site)),
    EIf(c, t, el) => EIf(c, scps_float_direct_assign(t, sctx, site), scps_float_direct_assign(el, sctx, site)),
    EMatch(s, arms) => {
      let out = scps_empty_arms()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        Array::push(out, (p, scps_float_direct_assign(b, sctx, site)))
        i = i + 1
      }
      EMatch(s, out)
    },
    _ => e
  }
}

// --- loop widening (#1230): `while` and `let mut` on the spine.
//
// The split above turns "the rest of the computation after a perform" into
// a closure. Two ordinary constructs used to fall outside it:
//
//   * `let mut x = v` -- the rest-closure would capture `x` by value, so a
//     write performed after a resume would be invisible to the code that
//     continues. Fixed by BOXING: `let x = [v]`, reads become
//     `Array::get(x, 0)` and writes `Array::set(x, 0, ..)`. The box is a
//     heap value, so every closure on the spine shares the same cell. The
//     one-shot flag the driver already emits (`[false]`) is the same trick.
//
//   * `while c { body }` -- a perform inside the body has no single
//     continuation split point, because the continuation is "the rest of
//     THIS iteration, then the loop again". Fixed by converting the loop to
//     a recursive step-returning closure: `let rec lp = () -> { if c {
//     <split of `body; lp()`> } else { <split of the rest> } }; lp()`. The
//     loop's own continuation is then just a tail call to `lp`, which the
//     closure-CPS path (`scps_as_cps_local_call`) already knows how to
//     bubble -- no new step shape and no ABI change. `lp` is registered as
//     a cps-local for exactly that reason.
//
// Note this synthesizes a LOCAL recursive closure, not a top-level
// function: the split runs after type checking and after `scps_calls_ok`
// has already vetted the ORIGINAL body, so the "a local closure is not
// see-through" eligibility rule (which is about code this pass did not
// write) does not apply to the code it emits itself. Every iteration that
// performs returns a step to the driver rather than recursing, so the
// native stack only grows across consecutive non-performing iterations.
//
// `break`/`continue`/`return` inside such a loop are still rejected: they
// have no meaning once the loop is a function, and rewriting them would
// need the escape continuation this slice does not build.

fn scps_has_loop_ctl(e: Expr) -> Bool {
  edp_rq_fold(RQLoopControl, e) > 0
}

fn scps_params_bind_name(params: Array[(String, Option[TypeExpr])], x: String) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(params) {
    let (nm, _) = Array::get(params, i)
    if nm == x {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_cell_get(x: String, off: Int) -> Expr {
  ECall(EIdent("Array::get", -1), [EIdent(x, off), EInt(0)], -1)
}

fn scps_cell_set(x: String, v: Expr) -> Expr {
  ECall(EIdent("Array::set", -1), [EIdent(x, -1), EInt(0), v], -1)
}

/// Rewrite every read and write of the local `x` in `e` into 1-element
/// Array cell operations, stopping at any binder that shadows the name.
/// See the boxing rationale above.
fn scps_cellify(e: Expr, x: String) -> Expr {
  match e {
    EIdent(nm, off) => if nm == x {
      scps_cell_get(nm, off)
    } else {
      e
    },
    EAssign(nm, v, b) => if nm == x {
      ESeq(scps_cell_set(nm, scps_cellify(v, x)), scps_cellify(b, x))
    } else {
      EAssign(nm, scps_cellify(v, x), scps_cellify(b, x))
    },
    // EAssignOp is (NAME, op, value, continuation) -- the target comes first,
    // the operator second. Reading them the other way round made this test
    // compare `"+"` against a variable name, so it never fired: `x += v` was
    // left writing the raw local while every read of `x` around it had become
    // a cell read, and the write was silently lost across the suspension.
    EAssignOp(nm, op, v, b) => if nm == x {
      ESeq(scps_cell_set(nm, EBinOp(op, scps_cell_get(nm, -1), scps_cellify(v, x), -1)), scps_cellify(b, x))
    } else {
      EAssignOp(nm, op, scps_cellify(v, x), scps_cellify(b, x))
    },
    ELet(nm, v, b, off) => ELet(nm, scps_cellify(v, x), if nm == x {
      b
    } else {
      scps_cellify(b, x)
    }, off),
    ELetMut(nm, v, b, off) => ELetMut(nm, scps_cellify(v, x), if nm == x {
      b
    } else {
      scps_cellify(b, x)
    }, off),
    ELetRec(nm, v, b) => if nm == x {
      e
    } else {
      ELetRec(nm, scps_cellify(v, x), scps_cellify(b, x))
    },
    ESeq(a, b) => ESeq(scps_cellify(a, x), scps_cellify(b, x)),
    EIf(c, t, el) => EIf(scps_cellify(c, x), scps_cellify(t, x), scps_cellify(el, x)),
    EMatch(s, arms) => EMatch(scps_cellify(s, x), scps_cellify_arms(arms, x)),
    EHandle(b, arms) => EHandle(scps_cellify(b, x), scps_cellify_arms(arms, x)),
    EFn(tps, tbs, params, rt, ef, b) => if scps_params_bind_name(params, x) {
      e
    } else {
      EFn(tps, tbs, params, rt, ef, scps_cellify(b, x))
    },
    EWhile(c, b) => EWhile(scps_cellify(c, x), scps_cellify(b, x)),
    EForIn(nm, idx, it, b) => {
      let shadowed = nm == x || match idx {
        Some(inm) => inm == x,
        None => false
      }
      EForIn(nm, idx, scps_cellify(it, x), if shadowed {
        b
      } else {
        scps_cellify(b, x)
      })
    },
    ELoop(pairs, b) => {
      let mut shadowed = false
      let out = scps_empty_pairs()
      let mut i = 0
      while i < Array::length(pairs) {
        let (nm, v) = Array::get(pairs, i)
        if nm == x {
          shadowed = true
        } else {
          ()
        }
        Array::push(out, (nm, scps_cellify(v, x)))
        i = i + 1
      }
      ELoop(out, if shadowed {
        b
      } else {
        scps_cellify(b, x)
      })
    },
    ECall(callee, args, off) => ECall(scps_cellify(callee, x), scps_cellify_exprs(args, x), off),
    EBinOp(op, l, r, boff) => EBinOp(op, scps_cellify(l, x), scps_cellify(r, x), boff),
    EUnaryOp(op, a) => EUnaryOp(op, scps_cellify(a, x)),
    EReturn(a) => EReturn(scps_cellify(a, x)),
    EDot(o, f, off, foff) => EDot(scps_cellify(o, x), f, off, foff),
    ELabeledArg(l, m, v) => ELabeledArg(l, m, scps_cellify(v, x)),
    EBreak(opt) => match opt {
      Some(a) => EBreak(Some(scps_cellify(a, x))),
      None => e
    },
    EContinue(args) => EContinue(scps_cellify_exprs(args, x)),
    ETuple(items) => ETuple(scps_cellify_exprs(items, x)),
    EArray(items) => EArray(scps_cellify_exprs(items, x)),
    ERecord(rn, fields, targs) => ERecord(rn, scps_cellify_pairs(fields, x), targs),
    EMap(fields) => EMap(scps_cellify_pairs(fields, x)),
    ESpread(a) => ESpread(scps_cellify(a, x)),
    _ => e
  }
}

fn scps_empty_pairs() -> Array[(String, Expr)] {
  Array::slice([("", EUnit)], 0, 0)
}

fn scps_cellify_exprs(es: Array[Expr], x: String) -> Array[Expr] {
  let out = array_empty_expr()
  let mut i = 0
  while i < Array::length(es) {
    Array::push(out, scps_cellify(Array::get(es, i), x))
    i = i + 1
  }
  out
}

fn scps_cellify_pairs(pairs: Array[(String, Expr)], x: String) -> Array[(String, Expr)] {
  let out = scps_empty_pairs()
  let mut i = 0
  while i < Array::length(pairs) {
    let (nm, v) = Array::get(pairs, i)
    Array::push(out, (nm, scps_cellify(v, x)))
    i = i + 1
  }
  out
}

fn scps_cellify_arms(arms: Array[(Pat, Expr)], x: String) -> Array[(Pat, Expr)] {
  let out = scps_empty_arms()
  let mut i = 0
  while i < Array::length(arms) {
    let (p, ex) = Array::get(arms, i)
    Array::push(out, (p, if scps_pat_binds_name(p, x) {
      ex
    } else {
      scps_cellify(ex, x)
    }))
    i = i + 1
  }
  out
}

/// #1536: the suspend lowering rewrites a body into a machine whose pieces
/// return a STEP, not the body's own value. A `return` written in that body
/// therefore no longer leaves the enclosing function -- it hands its value to
/// the driver as if it were a step. Until the lowering can carry an escape,
/// this is refused up front rather than compiled into a runtime trap: it used
/// to type-check, compile clean, and trap on the path that took the `return`.
///
/// The `return` inside a nested closure is unaffected (it targets that
/// closure) and stays accepted -- scps_body_has_return stops at EFn.
fn scps_return_in_split_msg(subject: String) -> String {
  String::concat(subject, " cannot contain a `return`: the suspend lowering turns the body into continuations that return a step, so the `return` would hand its own value to the driver instead of leaving the function. Produce the early-exit value instead of returning it (bind it and select on it), or move the `return` outside the handle. A `return` inside a nested closure targets that closure and is fine (#1536, ADR-0076 Phase 3a/3b)")
}

/// Is this type annotation `Array[..]`? Only the head name is inspected: what
/// the rewrite below needs is that the value is an array at run time, not what
/// it holds.
fn scps_ty_is_array(ty: Option[TypeExpr]) -> Bool {
  match ty {
    Some(t) => match t {
      TyApp(nm, _) => nm == "Array",
      TyName(nm) => nm == "Array",
      _ => false
    },
    None => false
  }
}

/// Is this annotation `String`? Both spellings, as the Array check does.
fn scps_ty_is_string(ty: Option[TypeExpr]) -> Bool {
  match ty {
    Some(t) => match t {
      TyName(nm) => nm == "String",
      TyApp(nm, _) => nm == "String",
      _ => false
    },
    None => false
  }
}

/// #1536: the declared return type of `v`, when `v` is a call to a top-level
/// function named by a bare identifier.
///
/// The `scps_binds_name` probe is the soundness guard, not a nicety (#1714,
/// P0 -- measured answering 0 where 215 is correct, with no diagnostic).
/// `scps_fn_ret_ty` looks a name up in the module's top-level statements, so a
/// LOCAL binding of the same spelling -- `let make = () -> "s"` shadowing a
/// top-level `fn make() -> Array[Int]` -- would answer about the wrong
/// function and hand the walk a proof that indexes a String with `Array::get`.
/// The probe is deliberately scope-blind: any binder anywhere in the walked
/// expression that spells `cn` disqualifies the proof. That over-refuses (a
/// binding in an unrelated branch counts) and never over-accepts, which is the
/// direction this pass has to err in.
/// #1727 gap 2: the return type the LOCAL binding of `name` declares, when the
/// pass can be sure which binding that is.
///
/// `scps_call_ret_ty` refuses a callee a local binder hides, and #1714 is why:
/// the top-level declaration is not what runs, and trusting it made codegen
/// index a String as an Array and silently return 0. But that argument is about
/// the WRONG declaration being read -- the local's own literal declares its
/// return type right at the binding, and reading THAT is not a guess.
///
/// Fails closed unless the name has exactly ONE binder anywhere in `root` and
/// that binder is an immutable `let` holding a closure literal with a declared
/// return type. Two binders mean the pass cannot say which value reaches the
/// call, which is #1714's hazard in different dress; `let` (not `let mut`)
/// means no later assignment can replace it.
fn scps_let_fn_ret_ty(e: Expr, name: String) -> Option[TypeExpr] {
  match e {
    ELet(nm, v, b, _) => if nm == name {
      match v {
        EFn(_, _, _, ret, _, _) => ret,
        _ => None
      }
    } else {
      match scps_let_fn_ret_ty(v, name) {
        Some(t) => Some(t),
        None => scps_let_fn_ret_ty(b, name)
      }
    },
    _ => {
      let kids = expr_children(e)
      let mut i = 0
      let mut done = false
      let mut found: Option[TypeExpr] = None
      while i < Array::length(kids) && !done {
        let r = scps_let_fn_ret_ty(Array::get(kids, i), name)
        match r {
          Some(t) => {
            found = Some(t)
            done = true
          },
          None => ()
        }
        i = i + 1
      }
      found
    }
  }
}

fn scps_local_binding_ret_ty(root: Expr, name: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Option[TypeExpr] {
  // A name that is ALSO a top-level function stays refused. The binder probe is
  // scope-blind, so a single local binder sitting in a branch that does not
  // reach the call would be read while the call actually resolves to the
  // top-level fn -- over-accepting in exactly the direction #1714 forbids
  // (fixtures/err_effect_for_shadowed_callee.vibe is that program). With no
  // top-level candidate, the only thing the call can resolve to is a local
  // binder, and requiring exactly one leaves nothing to choose between.
  let (is_fn, _) = scps_fn_row_of(ctx, name)
  if is_fn {
    None
  } else if edp_rq_fold(RQScpsBindsName(name), root) == 1 {
    scps_let_fn_ret_ty(root, name)
  } else {
    None
  }
}

fn scps_call_ret_ty(v: Expr, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), root: Expr) -> Option[TypeExpr] {
  match v {
    ECall(callee, _, _) => match callee {
      EIdent(cn, _) => if scps_binds_name(root, cn) {
        scps_local_binding_ret_ty(root, cn, ctx)
      } else {
        scps_fn_ret_ty(ctx, cn)
      },
      _ => None
    },
    _ => None
  }
}

/// #1536: the same question for a BUILTIN callee. `for x in Array::concat(a, b)`
/// proves nothing through `scps_fn_ret_ty` -- a builtin has no top-level `fn` to
/// read a return type off -- but the registry has carried its signature all
/// along, so consult it rather than refuse.
///
/// Answers "array" / "string" / "" (unproved). Only the two kinds this walk can
/// lower are mapped; everything else stays unproved, as does a builtin the
/// registry does not expose to user code.
fn scps_builtin_ret_kind(name: String) -> String {
  match lookup_registry_builtin(name) {
    Some(t) => match t {
      CtFn(_, ret, _) => match ret {
        CtArray(_) => "array",
        CtString => "string",
        _ => ""
      },
      _ => ""
    },
    None => ""
  }
}

/// The iterand kind a CALL proves: "array", "string", or "" (unproved).
///
/// A top-level `fn`'s declared return type first, then the builtin registry.
/// Both go through the same scope-blind shadowing guard (#1714) -- a `::`
/// qualified builtin can never be shadowed by a local binder, but an
/// unqualified one can, so the guard covers the lookup rather than the caller.
fn scps_call_kind(v: Expr, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), root: Expr) -> String {
  let declared = scps_call_ret_ty(v, ctx, root)
  if scps_ty_is_array(declared) {
    "array"
  } else if scps_ty_is_string(declared) {
    "string"
  } else {
    match v {
      ECall(callee, _, _) => match callee {
        EIdent(cn, _) => if scps_binds_name(root, cn) {
          ""
        } else {
          scps_builtin_ret_kind(cn)
        },
        _ => ""
      },
      _ => ""
    }
  }
}

fn scps_string_names_seed(params: Array[(String, Option[TypeExpr])]) -> Array[String] {
  let out = array_empty_str()
  let mut i = 0
  while i < Array::length(params) {
    let (nm, ty) = Array::get(params, i)
    if scps_ty_is_string(ty) {
      Array::push(out, nm)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn scps_string_names_with(known: Array[String], nm: String, v: Expr, ty: Option[TypeExpr], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), root: Expr) -> Array[String] {
  let out = array_empty_str()
  let mut i = 0
  while i < Array::length(known) {
    let k = Array::get(known, i)
    if k == nm {
      ()
    } else {
      Array::push(out, k)
    }
    i = i + 1
  }
  let proved = match v {
    EString(_) => true,
    _ => scps_ty_is_string(ty) || scps_call_kind(v, ctx, root) == "string"
  }
  if proved {
    Array::push(out, nm)
  } else {
    ()
  }
  out
}

/// #1536: the String half. Codegen materializes a String iterand's char codes
/// into a fresh array and iterates that (#807); indexing the String directly
/// walks the same sequence, and Strings are immutable so nothing can change
/// under the loop. `String::length` / `String::char_code_at` are the builtins
/// codegen itself uses to do that materializing.
fn scps_string_for_rewrite(name: String, str_nm: String, body: Expr, iname: String) -> Expr {
  let len_call = ECall(EIdent("String::length", -1), [EIdent(str_nm, -1)], -1)
  let at_call = ECall(EIdent("String::char_code_at", -1), [
    EIdent(str_nm, -1),
    EIdent(iname, -1)
  ], -1)
  let step = EAssign(iname, EBinOp("+", EIdent(iname, -1), EInt(1), -1), body)
  EWhile(EBinOp("<", EIdent(iname, -1), len_call, -1), ELet(name, at_call, step, -1))
}

/// Names this walk can prove hold an Array, without asking the checker: a
/// parameter annotated `Array[..]`, or a `let` bound to an array literal or
/// carrying the same annotation. Anything else is simply not proved, and the
/// `for` over it keeps the treatment it has today (refusal).
fn scps_array_names_seed(params: Array[(String, Option[TypeExpr])]) -> Array[String] {
  let out = array_empty_str()
  let mut i = 0
  while i < Array::length(params) {
    let (nm, ty) = Array::get(params, i)
    if scps_ty_is_array(ty) {
      Array::push(out, nm)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn scps_array_names_with(known: Array[String], nm: String, v: Expr, ty: Option[TypeExpr], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), root: Expr) -> Array[String] {
  let out = array_empty_str()
  let mut i = 0
  while i < Array::length(known) {
    let k = Array::get(known, i)
    if k == nm {
      ()
    } else {
      Array::push(out, k)
    }
    i = i + 1
  }
  let proved = match v {
    EArray(_) => true,
    _ => scps_ty_is_array(ty) || scps_call_kind(v, ctx, root) == "array"
  }
  if proved {
    Array::push(out, nm)
  } else {
    ()
  }
  out
}

/// #1536: `for x in xs { .. perform .. }` in statement position, where `xs` is
/// PROVED to hold an Array.
///
/// The proof matters because codegen keeps `EForIn` to the end and decides at
/// RUN TIME whether the iterand is a String, materializing its bytes first
/// (#807). Rewriting the loop at source level would make a String iterate zero
/// times, so it is only sound where the value cannot be one.
///
///   for x in xs { body }  ==>  let mut i = 0
///                              while i < Array::length(xs) {
///                                let x = Array::get(xs, i)
///                                i = i + 1
///                                body
///                              }
///
/// `Array::length` is re-read every iteration, as `for` requires (a body that
/// grows the array iterates further). The index advances BEFORE the body so a
/// `continue` in it cannot spin.
///
/// Only the shapes this proves are rewritten; every other `for` keeps the
/// treatment it has today, which for a suspending body is refusal. So this can
/// only turn a rejection into an acceptance -- no program that compiles today
/// changes.
fn scps_array_for_rewrite(name: String, arr: String, body: Expr, iname: String) -> Expr {
  let len_call = ECall(EIdent("Array::length", -1), [EIdent(arr, -1)], -1)
  let get_call = ECall(EIdent("Array::get", -1), [
    EIdent(arr, -1),
    EIdent(iname, -1)
  ], -1)
  let step = EAssign(iname, EBinOp("+", EIdent(iname, -1), EInt(1), -1), body)
  EWhile(EBinOp("<", EIdent(iname, -1), len_call, -1), ELet(name, get_call, step, -1))
}

/// Walk the spine, tracking which names are proved arrays, and rewrite the
/// statement-position `for` loops over them. `ctr` keeps generated index names
/// distinct between sibling loops.
/// Walk entry: `root` is the whole expression this walk was handed, and is
/// threaded down unchanged so the deep cases can run the scope-blind shadowing
/// probe below against it.
fn scps_elim_array_for(e: Expr, known: Array[String], kstr: Array[String], site: Int, ctr: Array[Int], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Expr {
  scps_elim_for_walk(e, known, kstr, site, ctr, ctx, e)
}

fn scps_elim_for_walk(e: Expr, known: Array[String], kstr: Array[String], site: Int, ctr: Array[Int], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), root: Expr) -> Expr {
  match e {
    ESeq(a, b) => match a {
      EForIn(nm, idx, it, fbody) => {
        let arr = match it {
          EIdent(inm, _) => if edp_str_array_contains(known, inm) {
            inm
          } else {
            ""
          },
          _ => ""
        }
        let indexed = match idx {
          Some(_) => true,
          None => false
        }
        let sname = match it {
          EIdent(inm, _) => if edp_str_array_contains(kstr, inm) {
            inm
          } else {
            ""
          },
          _ => ""
        }
        // #1536: a CALL iterand is proved by the callee's declared return type.
        // The value is bound once before the loop, exactly as `for` evaluates
        // its iterand once -- the name-based cases already have a name to reuse.
        let callkind = scps_call_kind(it, ctx, root)
        // #1536: a LITERAL iterand proves itself. `for x in [1, 2, 3]` and
        // `for c in "abc"` carry their kind in the syntax, so they need no
        // annotation and no callee lookup.
        let lit_is_arr = match it {
          EArray(_) => true,
          _ => false
        }
        let lit_is_str = match it {
          EString(_) => true,
          _ => false
        }
        let call_is_arr = callkind == "array" || lit_is_arr
        let call_is_str = callkind == "string" || lit_is_str
        if indexed {
          ESeq(a, scps_elim_for_walk(b, known, kstr, site, ctr, ctx, root))
        } else if arr == "" && sname == "" && !call_is_arr && !call_is_str {
          ESeq(a, scps_elim_for_walk(b, known, kstr, site, ctr, ctx, root))
        } else {
          // One fresh counter per loop: the ordinal keeps sibling loops apart
          // and the scope-blind probe keeps it clear of anything the user
          // spelled in the loop or its continuation.
          let n = Array::get(ctr, 0)
          Array::set(ctr, 0, n + 1)
          let iname = scps_seq_float_fresh(String::concat("foriter", Int::to_string(n)), e, EUnit, site)
          let inner = scps_elim_for_walk(fbody, known, kstr, site, ctr, ctx, root)
          let srcname = if arr != "" {
            arr
          } else if sname != "" {
            sname
          } else {
            scps_seq_float_fresh(String::concat("forsrc", Int::to_string(n)), e, EUnit, site)
          }
          let as_str = if arr != "" {
            false
          } else if sname != "" {
            true
          } else {
            call_is_str
          }
          let lowered = if as_str {
            scps_string_for_rewrite(nm, srcname, inner, iname)
          } else {
            scps_array_for_rewrite(nm, srcname, inner, iname)
          }
          let loop_part = ELetMut(iname, EInt(0), ESeq(lowered, scps_elim_for_walk(b, known, kstr, site, ctr, ctx, root)), -1)
          if arr == "" && sname == "" {
            ELet(srcname, it, loop_part, -1)
          } else {
            loop_part
          }
        }
      },
      _ => ESeq(a, scps_elim_for_walk(b, known, kstr, site, ctr, ctx, root))
    },
    ELet(x, v, b, off) => ELet(x, v, scps_elim_for_walk(b, scps_array_names_with(known, x, v, None, ctx, root), scps_string_names_with(kstr, x, v, None, ctx, root), site, ctr, ctx, root), off),
    ELetMut(x, v, b, off) => ELetMut(x, v, scps_elim_for_walk(b, scps_array_names_with(known, x, v, None, ctx, root), scps_string_names_with(kstr, x, v, None, ctx, root), site, ctr, ctx, root), off),
    ELetRec(x, v, b) => ELetRec(x, v, scps_elim_for_walk(b, known, kstr, site, ctr, ctx, root)),
    EAssign(x, v, b) => EAssign(x, v, scps_elim_for_walk(b, known, kstr, site, ctr, ctx, root)),
    EAssignOp(x, op, v, b) => EAssignOp(x, op, v, scps_elim_for_walk(b, known, kstr, site, ctr, ctx, root)),
    EIf(c, t, el) => EIf(c, scps_elim_for_walk(t, known, kstr, site, ctr, ctx, root), scps_elim_for_walk(el, known, kstr, site, ctr, ctx, root)),
    EWhile(c, b) => EWhile(c, scps_elim_for_walk(b, known, kstr, site, ctr, ctx, root)),
    EMatch(sc, arms) => {
      let out = scps_empty_arms()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        Array::push(out, (p, scps_elim_for_walk(ex, known, kstr, site, ctr, ctx, root)))
        i = i + 1
      }
      EMatch(sc, out)
    },
    _ => e
  }
}

/// #1536: hoist `return` to the tail position it already denotes, so the split
/// never sees one.
///
/// In a needing fn's clone, and in a closure literal, `return v` means exactly
/// "this computation's value is v" -- which is what the TAIL of the body means
/// too. So the fix is not to carry an escape through the step machine; it is to
/// move the `return` to the tail it is already talking about:
///
///   return v;  REST                    ==>  v                (REST is dead)
///   if c { .. return .. } else { .. };  REST
///                                      ==>  if c { ..; REST } else { ..; REST }
///
/// The second rule is the continuation distribution the suspension slices
/// already use, with the same capture rule for match arms. It fires only when a
/// branch actually returns, so non-returning code keeps its shape.
///
/// Whatever this cannot reach -- a `return` inside a loop, a let initializer, an
/// operand -- is LEFT IN PLACE, and the caller rejects the body when any
/// `return` survives. Being incomplete here therefore costs a rejection, never
/// a miscompile, which is what makes it safe to land the reachable half first.
///
/// A nested closure is not entered: its `return` targets that closure and is
/// already correct (`_ => e` covers EFn, EWhile, ELoop and EForIn alike).
/// Does this expression hold a `return` inside a LOOP? Used only by the
/// walk's fallback, to tell "a plain return the hoist will handle" from "a
/// loop return this walk did not reach and must refuse". Nested closures are
/// not entered (their `return` is their own).
fn scps_loop_return_nested(e: Expr) -> Bool {
  match e {
    EFn(_, _, _, _, _, _) => false,
    EWhile(_, b) => scps_body_has_return(b),
    ELoop(_, b) => scps_body_has_return(b),
    EForIn(_, _, _, b) => scps_body_has_return(b),
    ELet(_, v, b, _) => scps_loop_return_nested(v) || scps_loop_return_nested(b),
    ELetMut(_, v, b, _) => scps_loop_return_nested(v) || scps_loop_return_nested(b),
    ELetRec(_, v, b) => scps_loop_return_nested(v) || scps_loop_return_nested(b),
    ESeq(a, b) => scps_loop_return_nested(a) || scps_loop_return_nested(b),
    EAssign(_, v, b) => scps_loop_return_nested(v) || scps_loop_return_nested(b),
    EAssignOp(_, _, v, b) => scps_loop_return_nested(v) || scps_loop_return_nested(b),
    EIf(c, t, el) => scps_loop_return_nested(c) || scps_loop_return_nested(t) || scps_loop_return_nested(el),
    EMatch(s, arms) => scps_loop_return_nested(s) || scps_loop_arms_return_nested(arms),
    EHandle(b, arms) => scps_loop_return_nested(b) || scps_loop_arms_return_nested(arms),
    _ => false
  }
}

fn scps_loop_arms_return_nested(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(arms) {
    let (_, ex) = Array::get(arms, i)
    if scps_loop_return_nested(ex) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// `if returned { break } else { () }` -- placed after a nested returning loop
/// so the exit keeps travelling outward one level at a time.
fn scps_loop_return_guard(flag: String) -> Expr {
  EIf(EIdent(flag, -1), EBreak(None), EUnit)
}

/// Replace every `return v` in a loop body with "record and leave the loop".
/// The recorded value is picked up by the `if returned { return .. }` the
/// caller places after the loop, where the ordinary hoist can reach it.
/// Nested closures keep their own `return` (`_ => e` covers EFn).
fn scps_loop_return_to_break(e: Expr, flag: String, slot: String) -> Expr {
  match e {
    EReturn(v) => EAssign(slot, v, EAssign(flag, EBool(true), EBreak(None))),
    ESeq(a, b) => match a {
      EReturn(v) => EAssign(slot, v, EAssign(flag, EBool(true), EBreak(None))),
      // A NESTED loop that returns: rewrite it the same way, then guard the
      // enclosing loop's continuation. `break` leaves one level, so each level
      // needs its own -- that is what carries the exit outward.
      EWhile(c, wb) => if scps_body_has_return(wb) {
        ESeq(EWhile(c, scps_loop_return_to_break(wb, flag, slot)), ESeq(scps_loop_return_guard(flag), scps_loop_return_to_break(b, flag, slot)))
      } else {
        ESeq(a, scps_loop_return_to_break(b, flag, slot))
      },
      _ => ESeq(scps_loop_return_to_break(a, flag, slot), scps_loop_return_to_break(b, flag, slot))
    },
    // A nested returning loop in TAIL position still needs the guard: without
    // it the enclosing loop would simply iterate again.
    EWhile(c, wb) => if scps_body_has_return(wb) {
      ESeq(EWhile(c, scps_loop_return_to_break(wb, flag, slot)), scps_loop_return_guard(flag))
    } else {
      e
    },
    ELet(x, v, b, off) => ELet(x, v, scps_loop_return_to_break(b, flag, slot), off),
    ELetMut(x, v, b, off) => ELetMut(x, v, scps_loop_return_to_break(b, flag, slot), off),
    ELetRec(x, v, b) => ELetRec(x, v, scps_loop_return_to_break(b, flag, slot)),
    EAssign(x, v, b) => EAssign(x, v, scps_loop_return_to_break(b, flag, slot)),
    EAssignOp(x, op, v, b) => EAssignOp(x, op, v, scps_loop_return_to_break(b, flag, slot)),
    EIf(c, t, el) => EIf(c, scps_loop_return_to_break(t, flag, slot), scps_loop_return_to_break(el, flag, slot)),
    EMatch(s, arms) => {
      let out = scps_empty_arms()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, body) = Array::get(arms, i)
        Array::push(out, (p, scps_loop_return_to_break(body, flag, slot)))
        i = i + 1
      }
      EMatch(s, out)
    },
    _ => e
  }
}

/// #1536: a `return` inside a suspending `while` body. The hoist below cannot
/// move it to the body's tail -- a loop body's tail is the NEXT ITERATION, not
/// the function's value -- and the loop closure the split builds cannot return
/// from the function around it. Nothing new is needed to express it, though:
/// `break` already leaves such a loop (追記47), and a `return` on the spine
/// AFTER the loop is already handled. So record the value, leave the loop, and
/// return it outside:
///
///   while c { .. return v .. }   ==>  let mut returned = false
///   REST                              let mut slot = 0
///                                     while c { .. slot = v; returned = true; break .. }
///                                     if returned { return slot } else { REST }
///
/// The trailing `return` is then hoisted by scps_elim_returns like any other.
/// Both binders are minted with the usual scope-blind freshness probe.
///
/// A `return` nested several loops deep works too: each level records-and-breaks
/// and is followed by a guard that carries the exit outward one level at a time
/// (scps_loop_return_guard). Returns None only for a loop return this walk did
/// not reach at all, leaving the body for the caller to refuse.
fn scps_elim_loop_returns(e: Expr, site: Int) -> Option[Expr] {
  match e {
    ESeq(a, b) => match a {
      EWhile(c, wb) => if scps_body_has_return(wb) {
        let flag = scps_seq_float_fresh("returned", e, EUnit, site)
        let slot = scps_seq_float_fresh("retslot", e, EUnit, site)
        let wb2 = scps_loop_return_to_break(wb, flag, slot)
        Some(ELetMut(flag, EBool(false), ELetMut(slot, EInt(0), ESeq(EWhile(c, wb2), EIf(EIdent(flag, -1), EReturn(EIdent(slot, -1)), b)), -1), -1))
      } else {
        match scps_elim_loop_returns(b, site) {
          Some(b2) => Some(ESeq(a, b2)),
          None => None
        }
      },
      _ => match scps_elim_loop_returns(b, site) {
        Some(b2) => Some(ESeq(a, b2)),
        None => None
      }
    },
    ELet(x, v, b, off) => match scps_elim_loop_returns(b, site) {
      Some(b2) => Some(ELet(x, v, b2, off)),
      None => None
    },
    ELetMut(x, v, b, off) => match scps_elim_loop_returns(b, site) {
      Some(b2) => Some(ELetMut(x, v, b2, off)),
      None => None
    },
    ELetRec(x, v, b) => match scps_elim_loop_returns(b, site) {
      Some(b2) => Some(ELetRec(x, v, b2)),
      None => None
    },
    EAssign(x, v, b) => match scps_elim_loop_returns(b, site) {
      Some(b2) => Some(EAssign(x, v, b2)),
      None => None
    },
    EAssignOp(x, op, v, b) => match scps_elim_loop_returns(b, site) {
      Some(b2) => Some(EAssignOp(x, op, v, b2)),
      None => None
    },
    // A bare loop in TAIL position has no continuation to guard; the `return`
    // becomes the value of what follows it, which is nothing.
    EWhile(c, wb) => if scps_body_has_return(wb) {
      let flag = scps_seq_float_fresh("returned", e, EUnit, site)
      let slot = scps_seq_float_fresh("retslot", e, EUnit, site)
      let wb2 = scps_loop_return_to_break(wb, flag, slot)
      Some(ELetMut(flag, EBool(false), ELetMut(slot, EInt(0), ESeq(EWhile(c, wb2), EIf(EIdent(flag, -1), EReturn(EIdent(slot, -1)), EUnit)), -1), -1))
    } else {
      Some(e)
    },
    // Everything else passes through UNCHANGED. A plain `return` here is not
    // this rewrite's business -- scps_elim_returns hoists it. Only a `return`
    // sitting inside a loop this walk did not reach (one held by a selection
    // branch, an initializer, an operand) is refused, by returning None for
    // the caller to turn into the #1691 diagnostic.
    _ => if scps_loop_return_nested(e) {
      None
    } else {
      Some(e)
    }
  }
}

/// What a hoisted `return v` becomes. With no cell (`flag == ""`) the value IS
/// the result -- the function case, where the body's tail is what `return`
/// already denotes. With a cell, the value is recorded and the body finishes
/// with a placeholder, because the caller (a handle) must hand its own value
/// back before the real return can happen outside it.
fn scps_return_terminal(v: Expr, flag: String, slot: String) -> Expr {
  if flag == "" {
    v
  } else {
    EAssign(slot, v, EAssign(flag, EBool(true), EInt(0)))
  }
}

fn scps_elim_returns(e: Expr, site: Int) -> Expr {
  scps_elim_returns_to(e, site, "", "")
}

fn scps_elim_returns_to(e: Expr, site: Int, flag: String, slot: String) -> Expr {
  match e {
    EReturn(v) => scps_return_terminal(v, flag, slot),
    ESeq(a, b) => match a {
      // A transfer makes the rest of the sequence unreachable.
      EReturn(v) => scps_return_terminal(v, flag, slot),
      EIf(c, t, el) => if scps_body_has_return(t) || scps_body_has_return(el) {
        scps_elim_returns_to(EIf(c, ESeq(t, b), ESeq(el, b)), site, flag, slot)
      } else {
        ESeq(a, scps_elim_returns_to(b, site, flag, slot))
      },
      EMatch(s, arms) => if scps_body_arms_have_return(arms) {
        scps_elim_returns_to(EMatch(s, scps_seq_float_match_arms(arms, b, site)), site, flag, slot)
      } else {
        ESeq(a, scps_elim_returns_to(b, site, flag, slot))
      },
      _ => ESeq(a, scps_elim_returns_to(b, site, flag, slot))
    },
    ELet(x, v, b, off) => ELet(x, v, scps_elim_returns_to(b, site, flag, slot), off),
    ELetMut(x, v, b, off) => ELetMut(x, v, scps_elim_returns_to(b, site, flag, slot), off),
    ELetRec(x, v, b) => ELetRec(x, v, scps_elim_returns_to(b, site, flag, slot)),
    EAssign(x, v, b) => EAssign(x, v, scps_elim_returns_to(b, site, flag, slot)),
    EAssignOp(x, op, v, b) => EAssignOp(x, op, v, scps_elim_returns_to(b, site, flag, slot)),
    EIf(c, t, el) => EIf(c, scps_elim_returns_to(t, site, flag, slot), scps_elim_returns_to(el, site, flag, slot)),
    EMatch(s, arms) => {
      let out = scps_empty_arms()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, body) = Array::get(arms, i)
        Array::push(out, (p, scps_elim_returns_to(body, site, flag, slot)))
        i = i + 1
      }
      EMatch(s, out)
    },
    _ => e
  }
}

/// A `return` inside the loop body targets the FUNCTION, which a loop closure
/// cannot express. Nested closures own their own `return`, so the scan stops
/// at them (the same boundary scps_has_loop_ctl uses).
fn scps_body_has_return(e: Expr) -> Bool {
  edp_rq_fold(RQBodyReturn, e) > 0
}

fn scps_body_arms_have_return(arms: Array[(Pat, Expr)]) -> Bool {
  edp_rq_arms(RQBodyReturn, arms, false) > 0
}

/// #1536: is this expression an unconditional transfer out of the enclosing
/// loop iteration? Nothing sequenced after one runs, which is what lets the
/// repeat-append and the ctl rewrite below drop the dead tail.
/// Does every execution of `e` leave the loop (or restart it)?
///
/// #1536 P0: this used to recognize only a BARE `break` / `continue`, so the
/// ordinary spelling `if done { acc = v; break }` -- a transfer with a
/// statement in front of it -- was not seen as a transfer at all. The
/// continuation was then neither dropped by the normalizer nor cut by the
/// rewrite, and since a rewritten transfer is a plain CALL (`k(v)`), execution
/// FELL THROUGH it and kept looping. That compiled clean and silently returned
/// a different answer than the same loop without a suspension in it.
///
/// A selection counts only when EVERY branch transfers. Nested loops, closures
/// and handles are not entered: their transfers are not this loop's.
fn scps_is_ctl_terminator(e: Expr) -> Bool {
  match e {
    EBreak(_) => true,
    EContinue(_) => true,
    ESeq(_, b) => scps_is_ctl_terminator(b),
    ELet(_, _, b, _) => scps_is_ctl_terminator(b),
    ELetMut(_, _, b, _) => scps_is_ctl_terminator(b),
    ELetRec(_, _, b) => scps_is_ctl_terminator(b),
    EAssign(_, _, b) => scps_is_ctl_terminator(b),
    EAssignOp(_, _, _, b) => scps_is_ctl_terminator(b),
    EIf(_, t, el) => scps_is_ctl_terminator(t) && scps_is_ctl_terminator(el),
    EMatch(_, arms) => scps_arms_are_ctl_terminators(arms),
    _ => false
  }
}

/// Every arm transfers -- and an empty arm list does not (nothing transfers).
fn scps_arms_are_ctl_terminators(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut all = Array::length(arms) > 0
  while i < Array::length(arms) {
    let (_, ex) = Array::get(arms, i)
    if scps_is_ctl_terminator(ex) {
      ()
    } else {
      all = false
    }
    i = i + 1
  }
  all
}

/// Put every transfer of THIS loop in a TAIL slot of the body, so the append
/// and the rewrite below see it as one. A transfer written mid-sequence --
/// `if i >= n { break }` followed by the rest of the body, the ordinary
/// spelling -- is not a tail until the sequence continuation is distributed
/// into the branches it can transfer out of; after that, the statements
/// sequenced behind the transfer are dead and drop.
///
/// Distribution only fires for a head that actually carries a transfer, so a
/// body without `break`/`continue` keeps its shape. Match arms get the same
/// binder alpha-rename the #1610 sequence-head distribution uses, for the same
/// reason: the continuation moves under the arm's scope.
fn scps_loop_normalize_ctl(e: Expr, site: Int) -> Expr {
  match e {
    ESeq(a, b) => if scps_is_ctl_terminator(a) {
      a
    } else if scps_loop_ctl_remains(a) {
      match a {
        EIf(c, t, el) => scps_loop_normalize_ctl(EIf(c, ESeq(t, b), ESeq(el, b)), site),
        EMatch(s, arms) => scps_loop_normalize_ctl(EMatch(s, scps_seq_float_match_arms(arms, b, site)), site),
        _ => ESeq(scps_loop_normalize_ctl(a, site), scps_loop_normalize_ctl(b, site))
      }
    } else {
      ESeq(a, scps_loop_normalize_ctl(b, site))
    },
    ELet(x, v, b, off) => ELet(x, v, scps_loop_normalize_ctl(b, site), off),
    ELetMut(x, v, b, off) => ELetMut(x, v, scps_loop_normalize_ctl(b, site), off),
    ELetRec(x, v, b) => ELetRec(x, v, scps_loop_normalize_ctl(b, site)),
    EAssign(nm, v, b) => EAssign(nm, v, scps_loop_normalize_ctl(b, site)),
    EAssignOp(nm, op, v, b) => EAssignOp(nm, op, v, scps_loop_normalize_ctl(b, site)),
    EIf(c, t, el) => EIf(c, scps_loop_normalize_ctl(t, site), scps_loop_normalize_ctl(el, site)),
    EMatch(s, arms) => {
      let out = scps_empty_arms()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        Array::push(out, (p, scps_loop_normalize_ctl(ex, site)))
        i = i + 1
      }
      EMatch(s, out)
    },
    _ => e
  }
}

/// Like scps_seq_append, but for a `loop` body: a tail that already transfers
/// (`break` / `continue`) keeps its own transfer instead of falling through to
/// the repeat call, and statements sequenced after a transfer are dropped as
/// the dead code they are. Nested loops and closures are not spine positions,
/// so their own `break`/`continue` are never touched here.
fn scps_loop_append_repeat(e: Expr, k: Expr) -> Expr {
  match e {
    EBreak(_) => e,
    EContinue(_) => e,
    ELet(x, v, b, off) => ELet(x, v, scps_loop_append_repeat(b, k), off),
    ELetMut(x, v, b, off) => ELetMut(x, v, scps_loop_append_repeat(b, k), off),
    ELetRec(x, v, b) => ELetRec(x, v, scps_loop_append_repeat(b, k)),
    ESeq(a, b) => if scps_is_ctl_terminator(a) {
      a
    } else {
      ESeq(a, scps_loop_append_repeat(b, k))
    },
    EAssign(nm, v, b) => EAssign(nm, v, scps_loop_append_repeat(b, k)),
    EAssignOp(nm, op, v, b) => EAssignOp(nm, op, v, scps_loop_append_repeat(b, k)),
    EIf(c, t, el) => EIf(c, scps_loop_append_repeat(t, k), scps_loop_append_repeat(el, k)),
    EMatch(s, arms) => {
      let out = scps_empty_arms()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        Array::push(out, (p, scps_loop_append_repeat(ex, k)))
        i = i + 1
      }
      EMatch(s, out)
    },
    EUnit => k,
    _ => ESeq(e, k)
  }
}

/// The `loop`'s parameters as call arguments, for the repeat call and for a
/// bare `continue` (which the surface language defines as "repeat with the
/// parameters unchanged").

/// Rewrite THIS loop's transfers into calls on the CPS spine:
///   `break v`      -> `k(v)`        (the loop's exit continuation)
///   `continue(as)` -> `lp(as)`      (bare `continue` repeats the parameters)
/// Nested loops (`while` / `for` / `loop`) and closures own the transfers
/// written inside them, so the walk stops there. Values are not descended
/// into: a transfer buried in one (`let x = if c { break } else { 1 }`) is
/// left alone and then rejected by scps_loop_ctl_remains, rather than
/// silently rewritten into a value position where it means something else.
fn scps_loop_rewrite_ctl(e: Expr, lp: String, kname: String) -> Expr {
  match e {
    EBreak(opt) => {
      let bv = match opt {
        Some(v) => v,
        None => EUnit
      }
      let args = array_empty_expr()
      Array::push(args, bv)
      ECall(EIdent(kname, -1), args, -1)
    },
    // The parser's loop desugar leaves `continue` payload-less (it assigns the
    // parameters first), so a payload here is a shape this pass has never seen:
    // leave it, and scps_loop_ctl_remains rejects the site.
    EContinue(args) => if Array::length(args) == 0 {
      ECall(EIdent(lp, -1), array_empty_expr(), -1)
    } else {
      e
    },
    EWhile(_, _) => e,
    EForIn(_, _, _, _) => e,
    ELoop(_, _) => e,
    EFn(_, _, _, _, _, _) => e,
    EHandle(_, _) => e,
    ESeq(a, b) => {
      let a2 = scps_loop_rewrite_ctl(a, lp, kname)
      if scps_is_ctl_terminator(a) {
        a2
      } else {
        ESeq(a2, scps_loop_rewrite_ctl(b, lp, kname))
      }
    },
    ELet(x, v, b, off) => ELet(x, v, scps_loop_rewrite_ctl(b, lp, kname), off),
    ELetMut(x, v, b, off) => ELetMut(x, v, scps_loop_rewrite_ctl(b, lp, kname), off),
    ELetRec(x, v, b) => ELetRec(x, v, scps_loop_rewrite_ctl(b, lp, kname)),
    EAssign(nm, v, b) => EAssign(nm, v, scps_loop_rewrite_ctl(b, lp, kname)),
    EAssignOp(nm, op, v, b) => EAssignOp(nm, op, v, scps_loop_rewrite_ctl(b, lp, kname)),
    EIf(c, t, el) => EIf(c, scps_loop_rewrite_ctl(t, lp, kname), scps_loop_rewrite_ctl(el, lp, kname)),
    EMatch(s, arms) => {
      let out = scps_empty_arms()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        Array::push(out, (p, scps_loop_rewrite_ctl(ex, lp, kname)))
        i = i + 1
      }
      EMatch(s, out)
    },
    _ => e
  }
}

/// Any transfer belonging to THIS loop that the rewrite above did not reach
/// (a `break` inside a let value, a call argument, an operand, ...). The scan
/// uses the same nested-loop / closure boundaries, so an inner loop's own
/// transfers do not count. `return` counts too: the loop becomes a closure,
/// and a closure cannot return from the function that encloses it.
fn scps_loop_ctl_remains(e: Expr) -> Bool {
  match e {
    EBreak(_) => true,
    EContinue(_) => true,
    EWhile(_, _) => false,
    EForIn(_, _, _, _) => false,
    ELoop(_, _) => false,
    EFn(_, _, _, _, _, _) => false,
    ELet(_, v, b, _) => scps_loop_ctl_remains(v) || scps_loop_ctl_remains(b),
    ELetMut(_, v, b, _) => scps_loop_ctl_remains(v) || scps_loop_ctl_remains(b),
    ELetRec(_, v, b) => scps_loop_ctl_remains(v) || scps_loop_ctl_remains(b),
    ESeq(a, b) => scps_loop_ctl_remains(a) || scps_loop_ctl_remains(b),
    EIf(c, t, el) => scps_loop_ctl_remains(c) || scps_loop_ctl_remains(t) || scps_loop_ctl_remains(el),
    EMatch(s, arms) => scps_loop_ctl_remains(s) || scps_loop_arms_ctl_remain(arms),
    EHandle(b, arms) => scps_loop_ctl_remains(b) || scps_loop_arms_ctl_remain(arms),
    ECall(callee, args, _) => scps_loop_ctl_remains(callee) || scps_loop_exprs_ctl_remain(args),
    EBinOp(_, l, r, _) => scps_loop_ctl_remains(l) || scps_loop_ctl_remains(r),
    EUnaryOp(_, a) => scps_loop_ctl_remains(a),
    EAssign(_, v, b) => scps_loop_ctl_remains(v) || scps_loop_ctl_remains(b),
    EAssignOp(_, _, v, b) => scps_loop_ctl_remains(v) || scps_loop_ctl_remains(b),
    EDot(o, _, _, _) => scps_loop_ctl_remains(o),
    ELabeledArg(_, _, v) => scps_loop_ctl_remains(v),
    ETuple(items) => scps_loop_exprs_ctl_remain(items),
    EArray(items) => scps_loop_exprs_ctl_remain(items),
    ERecord(_, fields, _) => scps_loop_fields_ctl_remain(fields),
    EMap(fields) => scps_loop_fields_ctl_remain(fields),
    ESpread(a) => scps_loop_ctl_remains(a),
    _ => false
  }
}

fn scps_loop_exprs_ctl_remain(es: Array[Expr]) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(es) {
    if scps_loop_ctl_remains(Array::get(es, i)) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_loop_arms_ctl_remain(arms: Array[(Pat, Expr)]) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(arms) {
    let (_, ex) = Array::get(arms, i)
    if scps_loop_ctl_remains(ex) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_loop_fields_ctl_remain(fields: Array[(String, Expr)]) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(fields) {
    let (_, ex) = Array::get(fields, i)
    if scps_loop_ctl_remains(ex) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// "Run `e` (for its effects), then `k`" -- pushed into `e`'s TAIL slots
/// rather than wrapped as `ESeq(e, k)`, because the splitter only
/// recognizes a suspendable in a sequence's HEAD when that head is the
/// perform/call itself. A branch gets `k` in each arm (duplicated, but `k`
/// is only ever the loop's own zero-argument self-call).
fn scps_seq_append(e: Expr, k: Expr) -> Expr {
  match e {
    ELet(x, v, b, off) => ELet(x, v, scps_seq_append(b, k), off),
    ELetMut(x, v, b, off) => ELetMut(x, v, scps_seq_append(b, k), off),
    ELetRec(x, v, b) => ELetRec(x, v, scps_seq_append(b, k)),
    ESeq(a, b) => ESeq(a, scps_seq_append(b, k)),
    EAssign(nm, v, b) => EAssign(nm, v, scps_seq_append(b, k)),
    EAssignOp(nm, op, v, b) => EAssignOp(nm, op, v, scps_seq_append(b, k)),
    EIf(c, t, el) => EIf(c, scps_seq_append(t, k), scps_seq_append(el, k)),
    EMatch(s, arms) => {
      let out = scps_empty_arms()
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        Array::push(out, (p, scps_seq_append(ex, k)))
        i = i + 1
      }
      EMatch(s, out)
    },
    EUnit => k,
    _ => ESeq(e, k)
  }
}

/// Split `while c { body } ; rest` (rest is EUnit when the loop is itself
/// in tail position) into a recursive step-returning closure. See the
/// rationale above.
fn scps_split_while(c: Expr, body: Expr, rest: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> (Bool, Expr) {
  let (eff, s_ops, s_needing, s_site, s_cps) = sctx
  let orig = ESeq(EWhile(c, body), rest)
  // #1536: `break` / `continue` are now carried (see scps_split_while_ctl);
  // `return` still is not -- the loop becomes a closure, and a closure cannot
  // return from the function around it.
  if scps_body_has_return(body) {
    (false, orig)
  } else if scps_loop_ctl_remains(body) {
    scps_split_while_ctl(c, body, rest, sctx, ctx, st)
  } else {
    let lp = scps_local("__scps_lp", scps_next_site(st))
    let ext = Array::slice(s_cps, 0, Array::length(s_cps))
    Array::push(ext, lp)
    let sctx2 = (eff, s_ops, s_needing, s_site, ext)
    let step = scps_seq_append(body, ECall(EIdent(lp, -1), array_empty_expr(), -1))
    if scps_direct_spine_input(c, sctx) {
      // #1536 (a) v8: evaluate one directly recognized suspending condition
      // once per loop check, then resume into the existing recursive loop
      // selection. Probe the whole loop + continuation so the fresh binder
      // cannot capture a user spelling in the condition, body, or rest.
      let cx = scps_seq_float_fresh("while", orig, EUnit, s_site)
      let loop_body = ELet(cx, c, EIf(EIdent(cx, -1), step, rest), -1)
      let (lok, lowered) = scps_split_tail(loop_body, sctx2, ctx, st)
      if lok {
        let lam = EFn(array_empty_str(), scps_empty_tbs(), scps_empty_params(), None, None, lowered)
        (true, ELetRec(lp, lam, ECall(EIdent(lp, -1), array_empty_expr(), -1)))
      } else {
        (false, orig)
      }
    } else if scps_contains_susp(c, sctx) {
      // #1536 (a) v8: a compound condition (`perform Next() > 0`). The whole
      // let chain goes INSIDE the loop closure, so the condition -- named
      // parts included -- is re-evaluated on every check, as `while` requires.
      let (aok, abn, abv, ac) = scps_anf_compound(c, sctx, orig, s_site)
      if aok {
        let loop_body = scps_anf_wrap(abn, abv, EIf(ac, step, rest))
        let (lok, lowered) = scps_split_tail(loop_body, sctx2, ctx, st)
        if lok {
          let lam = EFn(array_empty_str(), scps_empty_tbs(), scps_empty_params(), None, None, lowered)
          (true, ELetRec(lp, lam, ECall(EIdent(lp, -1), array_empty_expr(), -1)))
        } else {
          (false, orig)
        }
      } else {
        (false, orig)
      }
    } else {
      let (iok, ibody) = scps_split_tail(step, sctx2, ctx, st)
      let (rok, rbody) = scps_split_tail(rest, sctx2, ctx, st)
      if iok && rok {
        let lam = EFn(array_empty_str(), scps_empty_tbs(), scps_empty_params(), None, None, EIf(c, ibody, rbody))
        (true, ELetRec(lp, lam, ECall(EIdent(lp, -1), array_empty_expr(), -1)))
      } else {
        (false, orig)
      }
    }
  }
}

/// #1536: `while c { body } ; rest` whose body carries `break` / `continue`.
/// The plain path above inlines `rest` into the loop closure's exit branch,
/// which only works when that branch is the single exit. With transfers there
/// are several, so the exit becomes its own closure and every transfer is a
/// call on the CPS spine:
///
///   let     k  = (bv) -> <rest, split>     // one exit continuation, shared
///   let rec lp = ()   -> <body', split>
///   lp()
///
/// where body' rewrites `break` to `k(unit)`, `continue` to `lp()`, and
/// appends `lp()` to every remaining tail (falling off the body's end repeats,
/// as it does today). Both closures are registered as step-typed cps-locals,
/// so the existing closure-CPS bubbling carries their results without a clone.
///
/// This is also what makes the surface `loop (p = e, ..) { .. }` form work:
/// the parser desugars it (desugar_loop_body) into mutable parameter locals
/// plus exactly this shape -- `while true` with bare `break` / `continue` --
/// long before this pass runs, which is why there is no ELoop case here.
fn scps_split_while_ctl(c: Expr, body: Expr, rest: Expr, sctx: (String, Array[String], Array[String], Int, Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> (Bool, Expr) {
  let (eff, s_ops, s_needing, s_site, s_cps) = sctx
  let orig = ESeq(EWhile(c, body), rest)
  let lsite = scps_next_site(st)
  // These names become binders around rewritten pieces of both the original
  // loop and its continuation. A user may legally spell the same reserved-
  // looking names, so mint each one with a scope-blind collision probe over
  // the complete original expression before moving either piece beneath it.
  let lp = scps_loop_ctl_fresh("__scps_lp", orig, lsite)
  let kname = scps_loop_ctl_fresh("__scps_lpk", orig, lsite)
  let bv = scps_loop_ctl_fresh("__scps_lpv", orig, lsite)
  let repeat = ECall(EIdent(lp, -1), array_empty_expr(), -1)
  let normalized = scps_loop_normalize_ctl(body, lsite)
  let rewritten = scps_loop_rewrite_ctl(scps_loop_append_repeat(normalized, repeat), lp, kname)
  // Anything the rewrite could not place on the spine (a transfer inside a
  // value, a call argument, an operand) stays fail-closed.
  if scps_loop_ctl_remains(rewritten) {
    (false, orig)
  } else {
    let ext = Array::slice(s_cps, 0, Array::length(s_cps))
    Array::push(ext, lp)
    Array::push(ext, kname)
    let sctx2 = (eff, s_ops, s_needing, s_site, ext)
    let exit_args = array_empty_expr()
    Array::push(exit_args, EUnit)
    let exit_call = ECall(EIdent(kname, -1), exit_args, -1)
    // #1536 (a) v8: a compound suspending condition is linearized INSIDE the
    // loop closure, so it is re-evaluated on every check like the direct one.
    let (cok, cbn, cbv, ac) = if scps_direct_spine_input(c, sctx) || !scps_contains_susp(c, sctx) {
      (false, array_empty_str(), array_empty_expr(), c)
    } else {
      scps_anf_compound(c, sctx, orig, s_site)
    }
    let loop_body = if scps_direct_spine_input(c, sctx) {
      let cx = scps_seq_float_fresh("while", orig, EUnit, s_site)
      ELet(cx, c, EIf(EIdent(cx, -1), rewritten, exit_call), -1)
    } else if cok {
      scps_anf_wrap(cbn, cbv, EIf(ac, rewritten, exit_call))
    } else {
      EIf(c, rewritten, exit_call)
    }
    if !scps_direct_spine_input(c, sctx) && !cok && scps_contains_susp(c, sctx) {
      (false, orig)
    } else {
      let (lok, lowered) = scps_split_tail(loop_body, sctx2, ctx, st)
      let (kok, kbody) = scps_split_tail(rest, sctx2, ctx, st)
      if lok && kok {
        let lam = EFn(array_empty_str(), scps_empty_tbs(), scps_empty_params(), None, None, lowered)
        (true, ELet(kname, scps_mk_fn1(bv, kbody), ELetRec(lp, lam, ECall(EIdent(lp, -1), array_empty_expr(), -1)), -1))
      } else {
        (false, orig)
      }
    }
  }
}

// --- per-site transform: driver synthesis. Returns None (with a pushed
// error) when the site is ineligible -- the caller keeps the original
// node, and the pass's caller turns the error list into a hard compile
// failure (a value-referencing arm can never compile on the replay path,
// so silence is not an option).

fn scps_transform_handle(body: Expr, arms: Array[(Pat, Expr)], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), scope: Array[(String, String)]) -> Option[Expr] {
  let errs = scps_st_errs(st)
  // effect identity: every arm must be `Eff::Op` for one shared DECLARED
  // effect, and Error (non-resumable) arms may not appear.
  let mut eff = ""
  let mut shape_ok = true
  let mut si = 0
  while si < Array::length(arms) {
    let (p, _) = Array::get(arms, si)
    match p {
      PCtor(q, _) => {
        let ci = String::index_of(q, "::")
        if ci > 0 {
          let qe = String::substring(q, 0, ci)
          if eff == "" {
            eff = qe
          } else if eff == qe {
            ()
          } else {
            shape_ok = false
          }
        } else {
          shape_ok = false
        }
      },
      _ => {
        shape_ok = false
      }
    }
    si = si + 1
  }
  let (eff_declared, decl_ops) = scps_effect_decl_ops(ctx, eff)
  if !shape_ok || idp_arms_discharge_error(arms) || !eff_declared {
    Array::push(errs, "a handler arm captures `resume` as a value, but this handle has an Error arm (Error is non-resumable, #640), mixes effects, or handles a non-declared effect -- not supported by the suspend lowering (#817, ADR-0076)")
    None
  } else {
    let ops_qnames = array_empty_str()
    let mut oi = 0
    while oi < Array::length(decl_ops) {
      let (opname, _) = Array::get(decl_ops, oi)
      Array::push(ops_qnames, String::concat(String::concat(eff, "::"), opname))
      oi = oi + 1
    }
    let needing = scps_needing_for(ctx, eff)
    let site = scps_next_site(st)
    // closure-CPS (追記31 Vertical B): lexical bindings whose row carries
    // the handled effect (enclosing-fn params with an annotated E-row, and
    // let-bound literals the prepass step-split) are callable step sources
    // inside this body. Last binding of a name wins ("" row = mask).
    let cps_seed = array_empty_str()
    let seen_scope = array_empty_str()
    let mut sci = Array::length(scope) - 1
    while sci >= 0 {
      let (snm, srow) = Array::get(scope, sci)
      if edp_str_array_contains(seen_scope, snm) {
        ()
      } else {
        Array::push(seen_scope, snm)
        if srow != "" && scps_row_contains(ctx, srow, eff) {
          Array::push(cps_seed, snm)
        } else {
          ()
        }
      }
      sci = sci - 1
    }
    let sctx = (eff, ops_qnames, needing, site, cps_seed)
    // Every currently visible binding participates, not just step sources:
    // an opaque local must mask every same-spelled top-level authorization.
    let call_scope = scps_scope_from_visible(scope, eff, ctx)
    if !scps_calls_ok(body, sctx, ctx, call_scope) {
      // #1536 / #1514 parity: name the offending call and carry its offset
      // as the ` [@off=N:M]` marker the located lanes resolve (and every
      // lane strips), same contract as the handle-side culprit marker.
      let (culprit_clause, culprit_marker) = scps_culprit_parts(body, sctx, ctx, call_scope)
      let mut scps_msg = "a handler arm captures `resume` as a value (suspend class, ADR-0076 Phase 3a/3b), but the handle body calls something this suspend lowering cannot see through (a local closure, a method-style callee, a nested handle, or a function whose declared row has a row variable)"
      scps_msg = String::concat(scps_msg, culprit_clause)
      scps_msg = String::concat(scps_msg, " -- only `perform`, pure builtins, constructors, provably effect-free functions, and functions whose concrete row carries the handled effect may be called in the handled body (#817)")
      scps_msg = String::concat(scps_msg, culprit_marker)
      Array::push(errs, scps_msg)
      None
    } else {
      // #1536: a `for` over a proved array is lowered here too, not only in a
      // needing fn's clone -- the handle body is a spine like any other. It has
      // no parameters of its own, so the proof comes from array literals bound
      // on that spine.
      let body2 = scps_elim_array_for(body, array_empty_str(), array_empty_str(), site, scps_anf_ctr(), ctx)
      let (split_ok, split_body) = scps_split_tail(body2, sctx, ctx, st)
      if !split_ok {
        Array::push(errs, "a handler arm captures `resume` as a value (suspend class, ADR-0076 Phase 3a/3b), but a perform of the handled effect (or a call to a function that performs it) is not directly on the handle body's let/seq/tail/branch-tail spine (a loop body containing `return`, a `for` form, nested closures/handles, and a selected `&&` / `||` right operand that transfers control with `return` / `break` / `continue` are not eligible; a suspension inside an `if` / `match` branch or a `&&` / `||` right operand IS eligible wherever the selection or the short-circuit itself is strictly evaluated (a statement, the tail, the whole value of a `let` / `let mut` / assignment, or a strictly evaluated part of a compound); a `while` / `loop` spine is, including one carrying `break` / `continue`, and so is a suspension inside an operand, a call argument or a constructor payload, #1230/#1536) (#817)")
        None
      } else {
        scps_ensure_effect_runtime(eff, ctx, st)
        let drive = scps_local("__scps_drive", site)
        let kname = scps_local("__scps_k", site)
        let once = scps_local("__scps_once", site)
        let rv = scps_local("__scps_rv", site)
        let vname = scps_local("__scps_v", site)
        let dmarms = scps_empty_arms()
        let done_pats = scps_empty_pats()
        Array::push(done_pats, PBind(vname))
        Array::push(dmarms, (PCtor(scps_done_name(eff), done_pats), EIdent(vname, -1)))
        let mut di = 0
        while di < Array::length(arms) {
          let (p, ab) = Array::get(arms, di)
          let (aq, subpats) = match p {
            PCtor(q, sp) => (q, sp),
            _ => ("", scps_empty_pats())
          }
          let ypats = scps_empty_pats()
          let mut pi = 0
          while pi < Array::length(subpats) {
            Array::push(ypats, Array::get(subpats, pi))
            pi = pi + 1
          }
          Array::push(ypats, PBind(kname))
          let once_get = ECall(EIdent("Array::get", -1), [
            EIdent(once, -1),
            EInt(0)
          ], -1)
          // One-shot violation: write the diagnostic and TRAP via an
          // out-of-bounds Array::get (clean `unreachable`, verified to
          // trap correctly INSIDE a closure). NOT assert(false) (#1095:
          // assert inside a closure miscompiles to a null indirect call)
          // and NOT Exception::Throw (the #944 entry boundary only wraps
          // entries whose declared row carries Error, so a synthesized
          // throw in a program with no Error row would leak to the host
          // as a raw WebAssembly.Exception with no message at all).
          let trap = ESeq(ECall(EIdent("Stderr::write_stream", -1), [
            EString("vibe: resume one-shot continuation called twice (#817, ADR-0076 Phase 3a)\n")
          ], -1), ECall(EIdent("Array::get", -1), [EArray([EInt(0)]), EInt(1)], -1))
          let set_true = ECall(EIdent("Array::set", -1), [
            EIdent(once, -1),
            EInt(0),
            EBool(true)
          ], -1)
          let drive_call = ECall(EIdent(drive, -1), [
            ECall(EIdent(kname, -1), [EIdent(rv, -1)], -1)
          ], -1)
          let rfn = scps_mk_fn1(rv, EIf(once_get, trap, ESeq(set_true, drive_call)))
          let lowered = ELet(once, EArray([EBool(false)]), ELet("resume", rfn, ab, -1), -1)
          Array::push(dmarms, (PCtor(scps_y_name(eff, scps_op_suffix(aq)), ypats), lowered))
          di = di + 1
        }
        let stn = scps_local("__scps_st", site)
        let dfn = scps_mk_fn1(stn, EMatch(EIdent(stn, -1), dmarms))
        Some(ELetRec(drive, dfn, ECall(EIdent(drive, -1), [split_body], -1)))
      }
    }
  }
}

// --- #1536 (a): inert closure-param see-through.
//
// A ROW-FREE function-typed parameter (`pred: (x: T) -> Bool`) is not
// automatically safe to call from a CPS clone: #761 charges a closure
// literal's performs to the ENCLOSING function's row, so "declared row is
// empty => cannot perform" does not hold for values arriving through a
// parameter (docs/spec/wasi-p3-async.md §2.2). What IS sound is an
// argument-flow proof: the clone `__scps_cps_E_f` is only ever invoked
// from BY-NAME call sites of `f` (a call through a binding that aliases
// `f` runs the untouched original), so if every by-name site of `f`
// passes a provably suspend-inert value in that slot -- a closure literal
// whose body cannot reach a perform of E (no perform at all, no needing
// name, no opaque callee), or the enclosing top-level fn's own row-free
// param whose slot is proven the same way (delegation, e.g.
// `AsyncIter::any` forwarding `pred` to `AsyncIter::find`) -- then a call
// through that parameter inside the clone cannot suspend and compiles as
// a plain call.
//
// Mechanically the proof does NOT widen `sctx`: a proven param is
// alpha-renamed into the reserved `__scps_inert_<site>_<name>` namespace
// inside the clone only (shadow-aware, scps_rename_ident), and both
// scps_calls_ok and scps_first_bad_call_info already accept the
// `__scps_` prefix, while scps_split_tail treats the call as an ordinary
// spine element (it is neither a needing call nor a cps-local call), so
// no bubble is emitted -- exactly the plain-call semantics the proof
// grants. An unproven param is left alone and keeps today's rejection.
//
// Conservative by construction: ANY perform inside a candidate literal
// taints it (even of an unrelated tail-resumptive effect -- alias
// spellings make per-effect matching unreliable here), as does any
// reference to a needing name (call or value), any opaque/method/row-var
// callee, any nested handle, a labeled/spread argument at a site, a
// value reference to `f` itself anywhere, or a rebind of the forwarded
// param name anywhere in the delegating fn's body.

/// Shadow-aware alpha-rename of local name `x` to `nx` in `e` -- reads,
/// writes and compound-assign targets, stopping at any binder that
/// shadows `x`. Traversal mirrors scps_cellify.
fn scps_rename_ident(e: Expr, x: String, nx: String) -> Expr {
  match e {
    EIdent(nm, off) => if nm == x {
      EIdent(nx, off)
    } else {
      e
    },
    EAssign(nm, v, b) => if nm == x {
      EAssign(nx, scps_rename_ident(v, x, nx), scps_rename_ident(b, x, nx))
    } else {
      EAssign(nm, scps_rename_ident(v, x, nx), scps_rename_ident(b, x, nx))
    },
    // (NAME, op, ..) again: read the other way round, a floated binder's
    // rename skipped `x op= v` targets while renaming everything else.
    EAssignOp(nm, op, v, b) => if nm == x {
      EAssignOp(nx, op, scps_rename_ident(v, x, nx), scps_rename_ident(b, x, nx))
    } else {
      EAssignOp(nm, op, scps_rename_ident(v, x, nx), scps_rename_ident(b, x, nx))
    },
    ELet(nm, v, b, off) => ELet(nm, scps_rename_ident(v, x, nx), if nm == x {
      b
    } else {
      scps_rename_ident(b, x, nx)
    }, off),
    ELetMut(nm, v, b, off) => ELetMut(nm, scps_rename_ident(v, x, nx), if nm == x {
      b
    } else {
      scps_rename_ident(b, x, nx)
    }, off),
    ELetRec(nm, v, b) => if nm == x {
      e
    } else {
      ELetRec(nm, scps_rename_ident(v, x, nx), scps_rename_ident(b, x, nx))
    },
    ESeq(a, b) => ESeq(scps_rename_ident(a, x, nx), scps_rename_ident(b, x, nx)),
    EIf(c, t, el) => EIf(scps_rename_ident(c, x, nx), scps_rename_ident(t, x, nx), scps_rename_ident(el, x, nx)),
    EMatch(s, arms) => EMatch(scps_rename_ident(s, x, nx), scps_rename_ident_arms(arms, x, nx)),
    EHandle(b, arms) => EHandle(scps_rename_ident(b, x, nx), scps_rename_ident_arms(arms, x, nx)),
    EFn(tps, tbs, params, rt, ef, b) => if scps_params_bind_name(params, x) {
      e
    } else {
      EFn(tps, tbs, params, rt, ef, scps_rename_ident(b, x, nx))
    },
    EWhile(c, b) => EWhile(scps_rename_ident(c, x, nx), scps_rename_ident(b, x, nx)),
    EForIn(nm, idx, it, b) => {
      let shadowed = nm == x || match idx {
        Some(inm) => inm == x,
        None => false
      }
      EForIn(nm, idx, scps_rename_ident(it, x, nx), if shadowed {
        b
      } else {
        scps_rename_ident(b, x, nx)
      })
    },
    ELoop(pairs, b) => {
      let mut shadowed = false
      let out = scps_empty_pairs()
      let mut i = 0
      while i < Array::length(pairs) {
        let (nm, v) = Array::get(pairs, i)
        if nm == x {
          shadowed = true
        } else {
          ()
        }
        Array::push(out, (nm, scps_rename_ident(v, x, nx)))
        i = i + 1
      }
      ELoop(out, if shadowed {
        b
      } else {
        scps_rename_ident(b, x, nx)
      })
    },
    ECall(callee, args, off) => ECall(scps_rename_ident(callee, x, nx), scps_rename_ident_exprs(args, x, nx), off),
    EBinOp(op, l, r, boff) => EBinOp(op, scps_rename_ident(l, x, nx), scps_rename_ident(r, x, nx), boff),
    EUnaryOp(op, a) => EUnaryOp(op, scps_rename_ident(a, x, nx)),
    EReturn(a) => EReturn(scps_rename_ident(a, x, nx)),
    EDot(o, f, off, foff) => EDot(scps_rename_ident(o, x, nx), f, off, foff),
    ELabeledArg(l, m, v) => ELabeledArg(l, m, scps_rename_ident(v, x, nx)),
    EBreak(opt) => match opt {
      Some(a) => EBreak(Some(scps_rename_ident(a, x, nx))),
      None => e
    },
    EContinue(args) => EContinue(scps_rename_ident_exprs(args, x, nx)),
    ETuple(items) => ETuple(scps_rename_ident_exprs(items, x, nx)),
    EArray(items) => EArray(scps_rename_ident_exprs(items, x, nx)),
    ERecord(rn, fields, targs) => ERecord(rn, scps_rename_ident_pairs(fields, x, nx), targs),
    EMap(fields) => EMap(scps_rename_ident_pairs(fields, x, nx)),
    ESpread(a) => ESpread(scps_rename_ident(a, x, nx)),
    _ => e
  }
}

fn scps_rename_ident_exprs(es: Array[Expr], x: String, nx: String) -> Array[Expr] {
  let out = array_empty_expr()
  let mut i = 0
  while i < Array::length(es) {
    Array::push(out, scps_rename_ident(Array::get(es, i), x, nx))
    i = i + 1
  }
  out
}

fn scps_rename_ident_pairs(pairs: Array[(String, Expr)], x: String, nx: String) -> Array[(String, Expr)] {
  let out = scps_empty_pairs()
  let mut i = 0
  while i < Array::length(pairs) {
    let (nm, v) = Array::get(pairs, i)
    Array::push(out, (nm, scps_rename_ident(v, x, nx)))
    i = i + 1
  }
  out
}

fn scps_rename_ident_arms(arms: Array[(Pat, Expr)], x: String, nx: String) -> Array[(Pat, Expr)] {
  let out = scps_empty_arms()
  let mut i = 0
  while i < Array::length(arms) {
    let (p, ex) = Array::get(arms, i)
    Array::push(out, (p, if scps_pat_binds_name(p, x) {
      ex
    } else {
      scps_rename_ident(ex, x, nx)
    }))
    i = i + 1
  }
  out
}

/// True if ANY binder anywhere in `e` (let / let mut / let rec / closure
/// param / for / loop / match / handle arm pattern) binds `x`. Used as the
/// conservative shadow check before trusting a forwarded param name at a
/// delegating call site.
fn scps_binds_name(e: Expr, x: String) -> Bool {
  edp_rq_fold(RQScpsBindsName(x), e) > 0
}

/// True if `x` occurs ANYWHERE in `e` as an identifier reference or an
/// assignment target (scope-blind on purpose: this feeds the seq-float's
/// freshness probe, where any occurrence at all -- bound or free -- means
/// the candidate spelling is not safe to mint). Binder occurrences are
/// scps_binds_name's job; scps_mentions_name below ORs the two.
fn scps_refs_name(e: Expr, x: String) -> Bool {
  edp_rq_fold(RQRefsName(x), e) > 0
}

fn scps_mentions_name(e: Expr, x: String) -> Bool {
  scps_binds_name(e, x) || scps_refs_name(e, x)
}

/// Mint a loop-control continuation name that cannot capture or be captured
/// when the original loop body and continuation are moved beneath synthetic
/// binders. The probe is deliberately scope-blind: any binding or reference
/// in the complete original expression disqualifies the candidate spelling.
fn scps_loop_ctl_fresh(prefix: String, orig: Expr, site: Int) -> String {
  let base = scps_local(prefix, site)
  let mut nx = base
  let mut i = 0
  while scps_mentions_name(orig, nx) {
    i = i + 1
    nx = String::concat(String::concat(base, "_"), Int::to_string(i))
  }
  nx
}

/// Mint the seq-float's alpha-renaming target: `__scps_seq<site>_<x>`,
/// bumped with a numeric suffix until the spelling occurs NOWHERE in the
/// floated continuation `k` or the sequence tail `b` (Codex P1 on #1607:
/// nothing stops a user binding or referencing the generated spelling
/// literally, and a collision either captures the tail's outer reference
/// or lets an inner binder capture the renamed occurrences -- both
/// silent-wrong). The probe is scope-blind (any occurrence disqualifies),
/// so the minted name is fresh for both roles by construction.
fn scps_seq_float_fresh(x: String, k: Expr, b: Expr, site: Int) -> String {
  let base = String::concat(String::concat(scps_local("__scps_seq", site), "_"), x)
  let mut nx = base
  let mut i = 0
  while scps_mentions_name(k, nx) || scps_mentions_name(b, nx) {
    i = i + 1
    nx = String::concat(String::concat(base, "_"), Int::to_string(i))
  }
  nx
}

/// Alpha-rename one arm's pattern binders away from every name the code that
/// is about to be moved UNDER that arm (`b`) reads, and rename the arm body to
/// match. `b` was outside the match originally, so any name free in it refers
/// to an outer binding and must keep doing so once it sits inside the arm.
/// Shared by every distribution below so they all get the same guarantee.
fn scps_float_match_arm_rename(p: Pat, body: Expr, b: Expr, site: Int, arm: Int) -> (Pat, Expr) {
  let names = array_empty()
  scps_pat_collect_binds(p, names)
  let mut p2 = p
  let mut body2 = body
  let mut ni = 0
  while ni < Array::length(names) {
    let nm = Array::get(names, ni)
    let mut seen = false
    let mut prev = 0
    while prev < ni {
      if Array::get(names, prev) == nm {
        seen = true
      } else {
        ()
      }
      prev = prev + 1
    }
    if seen {
      ()
    } else {
      let nx = scps_seq_float_match_fresh(nm, p2, body2, b, site, arm)
      p2 = scps_rename_pat_ident(p2, nm, nx)
      body2 = scps_rename_ident(body2, nm, nx)
    }
    ni = ni + 1
  }
  (p2, body2)
}

/// Append the original sequence tail to every match arm without letting a
/// pattern binder capture a name in that tail. Each arm gets fresh binders
/// and a correspondingly alpha-renamed body before `b` is placed under the
/// arm scope. The scrutinee remains outside this helper and is evaluated once.
fn scps_seq_float_match_arms(arms: Array[(Pat, Expr)], b: Expr, site: Int) -> Array[(Pat, Expr)] {
  let out = scps_empty_arms()
  let mut i = 0
  while i < Array::length(arms) {
    let (p, body) = Array::get(arms, i)
    let (p2, body2) = scps_float_match_arm_rename(p, body, b, site, i)
    Array::push(out, (p2, ESeq(body2, b)))
    i = i + 1
  }
  out
}

/// Rebuild the binding a distributed selection branch now owns.
fn scps_mk_bind(is_mut: Bool, x: String, v: Expr, b: Expr, off: Int) -> Expr {
  if is_mut {
    ELetMut(x, v, b, off)
  } else {
    ELet(x, v, b, off)
  }
}

/// Bind each arm's own value and continue there, capture-safely.
fn scps_bind_float_match_arms(arms: Array[(Pat, Expr)], is_mut: Bool, x: String, b: Expr, off: Int, site: Int) -> Array[(Pat, Expr)] {
  let out = scps_empty_arms()
  let mut i = 0
  while i < Array::length(arms) {
    let (p, body) = Array::get(arms, i)
    let (p2, body2) = scps_float_match_arm_rename(p, body, b, site, i)
    Array::push(out, (p2, scps_mk_bind(is_mut, x, body2, b, off)))
    i = i + 1
  }
  out
}

/// #1536: `let x = { stmt.. ; value } REST` -- a BLOCK as the whole bound
/// value. The block's statement prefix runs before the value either way, so
/// the binding can simply move inward past it and let the ordinary spine pick
/// the prefix up:
///
///   let x = { a; v }        REST  ==>  a;              let x = v  REST
///   let x = { let y = e; v} REST  ==>  let y' = e;     let x = v[y:=y']  REST
///
/// A floated `let` binder widens its scope over the continuation, so it is
/// alpha-renamed first (`REST` was outside the block, so a name free there
/// refers to an outer binding) -- the same rule and the same fresh-name probe
/// the sequence-head float uses.
///
/// This is what makes a branch with statements in it work after the selection
/// distribution below: `if c { log(); perform Op() }` becomes a block-valued
/// binding in the branch it was distributed into.
fn scps_bind_block_float(is_mut: Bool, x: String, v: Expr, b: Expr, off: Int, site: Int) -> Option[Expr] {
  match v {
    ESeq(a, v2) => Some(ESeq(a, scps_mk_bind(is_mut, x, v2, b, off))),
    // An assignment statement inside the block carries the rest of the block
    // as its own continuation rather than appearing as an ESeq head. It binds
    // nothing, so it moves out unchanged. (A write to a mutable this spine
    // boxed has already become an `Array::set` statement by now; this is the
    // spelling a target bound outside the spine still has.)
    EAssign(y, v1, v2) => Some(EAssign(y, v1, scps_mk_bind(is_mut, x, v2, b, off))),
    EAssignOp(y, op, v1, v2) => Some(EAssignOp(y, op, v1, scps_mk_bind(is_mut, x, v2, b, off))),
    ELet(y, v1, v2, o) => {
      let ny = scps_seq_float_fresh(y, v2, b, site)
      Some(ELet(ny, v1, scps_mk_bind(is_mut, x, scps_rename_ident(v2, y, ny), b, off), o))
    },
    ELetMut(y, v1, v2, o) => {
      let ny = scps_seq_float_fresh(y, v2, b, site)
      Some(ELetMut(ny, v1, scps_mk_bind(is_mut, x, scps_rename_ident(v2, y, ny), b, off), o))
    },
    _ => None
  }
}

/// #1536: `let x = <if/match> REST` where the selection is the WHOLE bound
/// value. Naming a suspension that lives in one branch is not available here
/// -- it would run the operation on the path that does not select that branch
/// -- but the binding does not have to stay outside the selection:
///
///   let x = if c { t } else { e }  REST
///     ==>  if c { let x = t  REST } else { let x = e  REST }
///
/// The condition/scrutinee stays where it was, so it is still evaluated
/// exactly once and before exactly one branch; each branch's own value is
/// what `x` is bound to there, and the continuation runs once after it. This
/// is the same continuation distribution a selection in SEQUENCE HEAD
/// position already gets (#1610) -- the only difference is that the branch
/// value is consumed by a binder instead of discarded.
///
/// Match arms additionally alpha-rename their pattern binders, because the
/// continuation was outside the match and its free names must not be
/// captured by an arm binding.
///
/// A selection carrying `break` / `continue` / `return` stays fail-closed:
/// those transfers are rewritten against the loop shape this pass builds, and
/// duplicating the continuation under them is not part of this slice.
fn scps_bind_selection_distribute(is_mut: Bool, x: String, v: Expr, b: Expr, off: Int, site: Int) -> Option[Expr] {
  if scps_has_loop_ctl(v) {
    None
  } else {
    match v {
      EIf(c, t, el) => Some(EIf(c, scps_mk_bind(is_mut, x, t, b, off), scps_mk_bind(is_mut, x, el, b, off))),
      EMatch(s, arms) => Some(EMatch(s, scps_bind_float_match_arms(arms, is_mut, x, b, off, site))),
      _ => None
    }
  }
}

/// Assign each arm's own value to the same target and continue there.
fn scps_assign_float_match_arms(arms: Array[(Pat, Expr)], x: String, b: Expr, site: Int) -> Array[(Pat, Expr)] {
  let out = scps_empty_arms()
  let mut i = 0
  while i < Array::length(arms) {
    let (p, body) = Array::get(arms, i)
    let (p2, body2) = scps_float_match_arm_rename(p, body, b, site, i)
    Array::push(out, (p2, EAssign(x, body2, b)))
    i = i + 1
  }
  out
}

/// #1536: the assignment mirror of `scps_bind_value_float`. `x = { a; v } REST`
/// and `x = if c { t } else { e } REST` are the same two shapes, and the same
/// two rewrites apply -- the only difference is that the value lands in an
/// existing target instead of a new binder, so no binder needs minting.
///
/// The target name is untouched, so it still refers to whatever it referred to
/// before: a `let` floated out of the block is alpha-renamed (it would
/// otherwise widen its scope over the continuation), and a distributed match
/// arm renames its pattern binders (the continuation was outside the match).
fn scps_assign_value_float(x: String, v: Expr, b: Expr, site: Int) -> Option[Expr] {
  match v {
    ESeq(a, v2) => Some(ESeq(a, EAssign(x, v2, b))),
    // An assignment statement inside the block carries the rest of the block
    // as its own continuation, so the prefix is already spelled this way
    // rather than as an ESeq. It binds nothing, so it just moves out.
    EAssign(y, v1, v2) => Some(EAssign(y, v1, EAssign(x, v2, b))),
    EAssignOp(y, op, v1, v2) => Some(EAssignOp(y, op, v1, EAssign(x, v2, b))),
    ELet(y, v1, v2, o) => {
      let ny = scps_seq_float_fresh(y, v2, b, site)
      Some(ELet(ny, v1, EAssign(x, scps_rename_ident(v2, y, ny), b), o))
    },
    ELetMut(y, v1, v2, o) => {
      let ny = scps_seq_float_fresh(y, v2, b, site)
      Some(ELetMut(ny, v1, EAssign(x, scps_rename_ident(v2, y, ny), b), o))
    },
    EIf(c, t, el) => if scps_has_loop_ctl(v) {
      None
    } else {
      Some(EIf(c, EAssign(x, t, b), EAssign(x, el, b)))
    },
    EMatch(s, arms) => if scps_has_loop_ctl(v) {
      None
    } else {
      Some(EMatch(s, scps_assign_float_match_arms(arms, x, b, site)))
    },
    _ => None
  }
}

/// #1536: move a `let` / `let mut` inward through the shape of its own value.
/// Both rewrites below strictly shrink that value, so re-splitting the result
/// converges: a block-valued selection branch floats its statement prefix out,
/// then binds whatever the branch actually evaluates to.
fn scps_bind_value_float(is_mut: Bool, x: String, v: Expr, b: Expr, off: Int, site: Int) -> Option[Expr] {
  match scps_bind_block_float(is_mut, x, v, b, off, site) {
    Some(lowered) => Some(lowered),
    None => scps_bind_selection_distribute(is_mut, x, v, b, off, site)
  }
}

/// Fresh name for one distributed match arm. Besides the arm body and shared
/// tail, probe the pattern itself: a target already bound by a sibling field
/// or an or-pattern would change its binding relation.
fn scps_seq_float_match_fresh(x: String, p: Pat, body: Expr, b: Expr, site: Int, arm: Int) -> String {
  let arm_base = String::concat(String::concat(scps_local("__scps_match", site), "_"), Int::to_string(arm))
  let base = String::concat(String::concat(arm_base, "_"), x)
  let mut nx = base
  let mut i = 0
  while scps_pat_binds_name(p, nx) || scps_mentions_name(body, nx) || scps_mentions_name(b, nx) {
    i = i + 1
    nx = String::concat(String::concat(base, "_"), Int::to_string(i))
  }
  nx
}

fn scps_rename_pat_ident(p: Pat, x: String, nx: String) -> Pat {
  match p {
    PBind(nm) => if nm == x {
      PBind(nx)
    } else {
      p
    },
    PCtor(nm, ps) => PCtor(nm, scps_rename_pat_idents(ps, x, nx)),
    PTuple(ps) => PTuple(scps_rename_pat_idents(ps, x, nx)),
    POr(a, b) => POr(scps_rename_pat_ident(a, x, nx), scps_rename_pat_ident(b, x, nx)),
    PStruct(nm, fields) => {
      let out = array_empty()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fp) = Array::get(fields, i)
        Array::push(out, (fname, scps_rename_pat_ident(fp, x, nx)))
        i = i + 1
      }
      PStruct(nm, out)
    },
    _ => p
  }
}

fn scps_rename_pat_idents(ps: Array[Pat], x: String, nx: String) -> Array[Pat] {
  let out = scps_empty_pats()
  let mut i = 0
  while i < Array::length(ps) {
    Array::push(out, scps_rename_pat_ident(Array::get(ps, i), x, nx))
    i = i + 1
  }
  out
}

/// True if `e` could reach a suspend of the effect under proof: ANY
/// perform (per-effect matching is unreliable under alias spellings, so
/// every perform taints), any reference to a needing name (call OR value
/// -- a value escape could smuggle a performer), any callee that is not a
/// pure/safe-mut builtin, a ctor, or a named top-level fn with a concrete
/// eff-free row, any reference into the reserved `__scps_`/`__Scps`
/// namespace, or any nested handle. Nested closure literals are recursed
/// (their row annotation carrying `eff` also taints -- convention
/// mixing).
///
/// `locals` carries the names BOUND WITHIN the candidate literal (its
/// params plus let/letrec/for/loop/match binders on the path): a bare
/// identifier outside that set is a CAPTURED value of unknown provenance
/// -- it may alias a closure the phase-2 prepass step-compiled (a
/// captured performing literal is spelled through its binding, not
/// inline) -- so passing one into an accepted callee would launder a
/// suspending closure through the plain-call convention. Everything not
/// locally bound taints, except ctor references (Codex review on #1602).
fn scps_inert_taint(e: Expr, eff: String, needing: Array[String], locals: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Bool {
  match e {
    EIdent(nm, _) => !edp_str_array_contains(locals, nm) && !scps_is_ctor_name(ctx, nm),
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if nm == "perform" {
        true
      } else if edp_str_array_contains(needing, nm) || String::starts_with(nm, "__scps_") || String::starts_with(nm, "__Scps") {
        true
      } else if idp_is_pure_builtin_call(nm) || scps_is_safe_mut_builtin(nm) || scps_is_ctor_name(ctx, nm) {
        scps_inert_taint_exprs(args, eff, needing, locals, ctx)
      } else {
        let (is_fn, row) = scps_fn_row_of(ctx, nm)
        if is_fn && !scps_row_contains(ctx, row, eff) && (!scps_row_has_var(row) || scps_callee_first_order(ctx, nm)) {
          scps_inert_taint_exprs(args, eff, needing, locals, ctx)
        } else {
          true
        }
      },
      _ => true
    },
    EHandle(_, _) => true,
    EFn(_, _, fparams, _, ef, b) => match ef {
      Some(row) => scps_row_contains(ctx, row, eff) || scps_row_has_var(row) || scps_inert_taint(b, eff, needing, scps_locals_with_params(locals, fparams), ctx),
      None => scps_inert_taint(b, eff, needing, scps_locals_with_params(locals, fparams), ctx)
    },
    ELet(nm, v, b, _) => scps_inert_taint(v, eff, needing, locals, ctx) || scps_inert_taint(b, eff, needing, scps_locals_with(locals, nm), ctx),
    ELetMut(nm, v, b, _) => scps_inert_taint(v, eff, needing, locals, ctx) || scps_inert_taint(b, eff, needing, scps_locals_with(locals, nm), ctx),
    ELetRec(nm, v, b) => {
      let ext = scps_locals_with(locals, nm)
      scps_inert_taint(v, eff, needing, ext, ctx) || scps_inert_taint(b, eff, needing, ext, ctx)
    },
    ESeq(a, b) => scps_inert_taint(a, eff, needing, locals, ctx) || scps_inert_taint(b, eff, needing, locals, ctx),
    EIf(c, t, el) => scps_inert_taint(c, eff, needing, locals, ctx) || scps_inert_taint(t, eff, needing, locals, ctx) || scps_inert_taint(el, eff, needing, locals, ctx),
    EMatch(s, arms) => scps_inert_taint(s, eff, needing, locals, ctx) || scps_inert_taint_arms(arms, eff, needing, locals, ctx),
    EWhile(c, b) => scps_inert_taint(c, eff, needing, locals, ctx) || scps_inert_taint(b, eff, needing, locals, ctx),
    EForIn(nm, idx, it, b) => {
      let ext = scps_locals_with(locals, nm)
      let ext2 = match idx {
        Some(inm) => scps_locals_with(ext, inm),
        None => ext
      }
      scps_inert_taint(it, eff, needing, locals, ctx) || scps_inert_taint(b, eff, needing, ext2, ctx)
    },
    ELoop(pairs, b) => {
      let mut ext = locals
      let mut hit = false
      let mut i = 0
      while i < Array::length(pairs) {
        let (nm, v) = Array::get(pairs, i)
        if scps_inert_taint(v, eff, needing, locals, ctx) {
          hit = true
        } else {
          ()
        }
        ext = scps_locals_with(ext, nm)
        i = i + 1
      }
      hit || scps_inert_taint(b, eff, needing, ext, ctx)
    },
    EBinOp(_, l, r, _) => scps_inert_taint(l, eff, needing, locals, ctx) || scps_inert_taint(r, eff, needing, locals, ctx),
    EUnaryOp(_, a) => scps_inert_taint(a, eff, needing, locals, ctx),
    EAssign(_, v, b) => scps_inert_taint(v, eff, needing, locals, ctx) || scps_inert_taint(b, eff, needing, locals, ctx),
    EAssignOp(_, _, v, b) => scps_inert_taint(v, eff, needing, locals, ctx) || scps_inert_taint(b, eff, needing, locals, ctx),
    EReturn(a) => scps_inert_taint(a, eff, needing, locals, ctx),
    EDot(o, _, _, _) => scps_inert_taint(o, eff, needing, locals, ctx),
    ELabeledArg(_, _, v) => scps_inert_taint(v, eff, needing, locals, ctx),
    EBreak(opt) => match opt {
      Some(a) => scps_inert_taint(a, eff, needing, locals, ctx),
      None => false
    },
    EContinue(args) => scps_inert_taint_exprs(args, eff, needing, locals, ctx),
    ETuple(items) => scps_inert_taint_exprs(items, eff, needing, locals, ctx),
    EArray(items) => scps_inert_taint_exprs(items, eff, needing, locals, ctx),
    ERecord(_, fields, _) => scps_inert_taint_pairs(fields, eff, needing, locals, ctx),
    EMap(fields) => scps_inert_taint_pairs(fields, eff, needing, locals, ctx),
    ESpread(a) => scps_inert_taint(a, eff, needing, locals, ctx),
    _ => false
  }
}

fn scps_locals_with(locals: Array[String], nm: String) -> Array[String] {
  let out = Array::slice(locals, 0, Array::length(locals))
  Array::push(out, nm)
  out
}

fn scps_locals_with_params(locals: Array[String], params: Array[(String, Option[TypeExpr])]) -> Array[String] {
  let out = Array::slice(locals, 0, Array::length(locals))
  let mut i = 0
  while i < Array::length(params) {
    let (pnm, _) = Array::get(params, i)
    Array::push(out, pnm)
    i = i + 1
  }
  out
}

fn scps_pat_collect_binds(p: Pat, acc: Array[String]) -> Unit {
  match p {
    PBind(n) => Array::push(acc, n),
    PCtor(_, ps) => scps_pats_collect_binds(ps, acc),
    PTuple(ps) => scps_pats_collect_binds(ps, acc),
    POr(a, b) => {
      scps_pat_collect_binds(a, acc)
      scps_pat_collect_binds(b, acc)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        scps_pat_collect_binds(fp, acc)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn scps_pats_collect_binds(ps: Array[Pat], acc: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(ps) {
    scps_pat_collect_binds(Array::get(ps, i), acc)
    i = i + 1
  }
}

fn scps_inert_taint_exprs(es: Array[Expr], eff: String, needing: Array[String], locals: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(es) {
    if scps_inert_taint(Array::get(es, i), eff, needing, locals, ctx) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_inert_taint_pairs(pairs: Array[(String, Expr)], eff: String, needing: Array[String], locals: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, i)
    if scps_inert_taint(v, eff, needing, locals, ctx) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

fn scps_inert_taint_arms(arms: Array[(Pat, Expr)], eff: String, needing: Array[String], locals: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Bool {
  let mut i = 0
  let mut hit = false
  while i < Array::length(arms) {
    let (p, ex) = Array::get(arms, i)
    let ext = Array::slice(locals, 0, Array::length(locals))
    scps_pat_collect_binds(p, ext)
    if scps_inert_taint(ex, eff, needing, ext, ctx) {
      hit = true
    } else {
      ()
    }
    i = i + 1
  }
  hit
}

/// Is argument `a` (found in a proven-slot position at a by-name call
/// site) suspend-inert? A closure literal must have a taint-free body and
/// must not itself declare a row carrying `eff`; a bare identifier is
/// accepted only as the enclosing top-level fn's own function-typed param
/// whose slot is (recursively) proven and never rebound anywhere in that
/// fn's body. Everything else is not provable.
fn scps_arg_is_inert(a: Expr, has_encl: Bool, encl_params: Array[(String, Option[TypeExpr])], encl_body: Expr, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), encl_name: String, visiting: Array[String]) -> Bool {
  match a {
    EFn(_, _, aparams, _, ef, b) => {
      let row_ok = match ef {
        Some(row) => !scps_row_contains(ctx, row, eff) && !scps_row_has_var(row),
        None => true
      }
      // The taint scan starts with ONLY the literal's own params as
      // locally-bound names: any other bare identifier in the body is a
      // captured value of unknown provenance and taints (it may alias a
      // step-compiled closure -- Codex review on #1602).
      // #1536: the literal's own params PLUS enclosing names bound to
      // provably-inert literals. Everything else stays a captured value of
      // unknown provenance and taints, as before.
      let seed = scps_locals_with_params(array_empty_str(), aparams)
      if has_encl {
        scps_inert_local_literals(encl_body, eff, needing, ctx, seed)
      } else {
        ()
      }
      row_ok && !scps_inert_taint(b, eff, needing, seed, ctx)
    },
    EIdent(an, _) => if has_encl {
      let mut slot = -1
      let mut i = 0
      while i < Array::length(encl_params) {
        let (pnm, _) = Array::get(encl_params, i)
        if pnm == an && slot < 0 {
          slot = i
        } else {
          ()
        }
        i = i + 1
      }
      if slot < 0 {
        false
      } else if scps_binds_name(encl_body, an) {
        false
      } else {
        scps_param_slot_inert(encl_name, slot, eff, needing, ctx, visiting)
      }
    } else {
      false
    },
    _ => false
  }
}

/// True when every occurrence of `fname` in `e` is a by-name call whose
/// argument in `slot` is suspend-inert -- and `fname` never escapes as a
/// bare value. Binders shadowing `fname` stop the scan (calls below them
/// are not calls to the top-level fn).
fn scps_slot_sites_ok(e: Expr, fname: String, slot: Int, has_encl: Bool, encl_params: Array[(String, Option[TypeExpr])], encl_body: Expr, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), encl_name: String, visiting: Array[String]) -> Bool {
  // Phase 3 has already rewritten suspend-context call sites of `fname`
  // to its CPS-clone spelling (args preserved) by the time phase 4 runs
  // this proof, so a site counts under EITHER name -- missing the
  // rewritten spelling would let a tainted argument through unseen.
  let cname = scps_clone_name(eff, fname)
  match e {
    EIdent(nm, _) => nm != fname && nm != cname,
    ECall(callee, args, _) => {
      let head_ok = match callee {
        EIdent(nm, _) => if nm == fname || nm == cname {
          let mut shape_ok = slot < Array::length(args)
          let mut ai = 0
          while ai < Array::length(args) {
            match Array::get(args, ai) {
              ELabeledArg(_, _, _) => {
                shape_ok = false
              },
              ESpread(_) => {
                shape_ok = false
              },
              _ => ()
            }
            ai = ai + 1
          }
          shape_ok && scps_arg_is_inert(Array::get(args, slot), has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)
        } else {
          true
        },
        _ => scps_slot_sites_ok(callee, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)
      }
      let mut ok = head_ok
      let mut i = 0
      while i < Array::length(args) {
        // Bare-ident args recurse like everything else: EIdent(fname) in
        // ANY argument position (including a self-call's own slot) is a
        // value escape and must fail via the EIdent arm.
        if !scps_slot_sites_ok(Array::get(args, i), fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok
    },
    EFn(_, _, params, _, _, b) => if scps_params_bind_name(params, fname) {
      true
    } else {
      scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)
    },
    ELet(nm, v, b, _) => scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && (nm == fname || scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)),
    ELetMut(nm, v, b, _) => scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && (nm == fname || scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)),
    ELetRec(nm, v, b) => if nm == fname {
      true
    } else {
      scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)
    },
    ESeq(a, b) => scps_slot_sites_ok(a, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EIf(c, t, el) => scps_slot_sites_ok(c, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(t, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(el, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EMatch(s, arms) => {
      let mut ok = scps_slot_sites_ok(s, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        if scps_pat_binds_name(p, fname) {
          ()
        } else if !scps_slot_sites_ok(ex, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok
    },
    EHandle(b, arms) => {
      let mut ok = scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        if scps_pat_binds_name(p, fname) {
          ()
        } else if !scps_slot_sites_ok(ex, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok
    },
    EWhile(c, b) => scps_slot_sites_ok(c, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EForIn(nm, idx, it, b) => {
      let shadowed = nm == fname || match idx {
        Some(inm) => inm == fname,
        None => false
      }
      scps_slot_sites_ok(it, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && (shadowed || scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting))
    },
    ELoop(pairs, b) => {
      let mut shadowed = false
      let mut ok = true
      let mut i = 0
      while i < Array::length(pairs) {
        let (nm, v) = Array::get(pairs, i)
        if nm == fname {
          shadowed = true
        } else {
          ()
        }
        if !scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) {
          ok = false
        } else {
          ()
        }
        i = i + 1
      }
      ok && (shadowed || scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting))
    },
    EBinOp(_, l, r, _) => scps_slot_sites_ok(l, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(r, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EUnaryOp(_, a) => scps_slot_sites_ok(a, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EAssign(_, v, b) => scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EAssignOp(_, _, v, b) => scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) && scps_slot_sites_ok(b, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EReturn(a) => scps_slot_sites_ok(a, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EDot(o, _, _, _) => scps_slot_sites_ok(o, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    ELabeledArg(_, _, v) => scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EBreak(opt) => match opt {
      Some(a) => scps_slot_sites_ok(a, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
      None => true
    },
    EContinue(args) => scps_slot_sites_ok_exprs(args, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    ETuple(items) => scps_slot_sites_ok_exprs(items, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EArray(items) => scps_slot_sites_ok_exprs(items, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    ERecord(_, fields, _) => scps_slot_sites_ok_pairs(fields, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    EMap(fields) => scps_slot_sites_ok_pairs(fields, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    ESpread(a) => scps_slot_sites_ok(a, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting),
    _ => true
  }
}

fn scps_slot_sites_ok_exprs(es: Array[Expr], fname: String, slot: Int, has_encl: Bool, encl_params: Array[(String, Option[TypeExpr])], encl_body: Expr, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), encl_name: String, visiting: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(es) {
    if !scps_slot_sites_ok(Array::get(es, i), fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

fn scps_slot_sites_ok_pairs(pairs: Array[(String, Expr)], fname: String, slot: Int, has_encl: Bool, encl_params: Array[(String, Option[TypeExpr])], encl_body: Expr, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), encl_name: String, visiting: Array[String]) -> Bool {
  let mut i = 0
  let mut ok = true
  while i < Array::length(pairs) {
    let (_, v) = Array::get(pairs, i)
    if !scps_slot_sites_ok(v, fname, slot, has_encl, encl_params, encl_body, eff, needing, ctx, encl_name, visiting) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

/// Prove param slot `slot` of top-level fn `fname` suspend-inert for
/// `eff`: the slot's declared type must be function-typed with a row that
/// is absent, or concrete and eff-free; and every by-name occurrence of
/// `fname` program-wide must be a call passing an inert value in that
/// slot. Delegation cycles are handled coinductively: a slot already on
/// the `visiting` stack contributes no new taint evidence and is treated
/// as inert within its own proof.
fn scps_param_slot_inert(fname: String, slot: Int, eff: String, needing: Array[String], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), visiting: Array[String]) -> Bool {
  let key = String::concat(String::concat(fname, "||"), Int::to_string(slot))
  if edp_str_array_contains(visiting, key) {
    true
  } else {
    let (stmts, _, fn_defs, _, _, _) = ctx
    let slot_ok = match edp_params_of_fn(stmts, fn_defs, fname) {
      Some(params) => if slot < Array::length(params) {
        let (_, pty) = Array::get(params, slot)
        let prow = scps_ty_row(pty)
        match pty {
          Some(TyFn(_, _, _)) => !scps_row_contains(ctx, prow, eff) && !scps_row_has_var(prow),
          _ => false
        }
      } else {
        false
      },
      None => false
    }
    if !slot_ok {
      false
    } else {
      let visiting2 = Array::slice(visiting, 0, Array::length(visiting))
      Array::push(visiting2, key)
      let mut ok = true
      let mut i = 0
      while i < Array::length(stmts) {
        match Array::get(stmts, i) {
          SLet(_, _, dnm, _, dexpr) => match dexpr {
            EFn(_, _, dparams, _, _, dbody) => {
              if !scps_slot_sites_ok(dbody, fname, slot, true, dparams, dbody, eff, needing, ctx, dnm, visiting2) {
                ok = false
              } else {
                ()
              }
            },
            _ => if !scps_slot_sites_ok(dexpr, fname, slot, false, scps_empty_params(), EUnit, eff, needing, ctx, "", visiting2) {
              ok = false
            } else {
              ()
            }
          },
          SLetMut(_, _, mexpr) => if !scps_slot_sites_ok(mexpr, fname, slot, false, scps_empty_params(), EUnit, eff, needing, ctx, "", visiting2) {
            ok = false
          } else {
            ()
          },
          SExpr(sexpr) => if !scps_slot_sites_ok(sexpr, fname, slot, false, scps_empty_params(), EUnit, eff, needing, ctx, "", visiting2) {
            ok = false
          } else {
            ()
          },
          STest(_, texpr) => if !scps_slot_sites_ok(texpr, fname, slot, false, scps_empty_params(), EUnit, eff, needing, ctx, "", visiting2) {
            ok = false
          } else {
            ()
          },
          SBench(_, bexpr) => if !scps_slot_sites_ok(bexpr, fname, slot, false, scps_empty_params(), EUnit, eff, needing, ctx, "", visiting2) {
            ok = false
          } else {
            ()
          },
          _ => ()
        }
        i = i + 1
      }
      ok
    }
  }
}

// --- CPS clone emission (3b). The clone's EFn deliberately carries
// ret=None and eff=None: the return type is now __ScpsStep_E (an
// annotation would lie, and codegen ignores it post-check), and the row
// must not re-enter evidence_dict_pass's needing collection (the clone
// no longer performs anything directly).

fn scps_emit_clone(eff: String, fname: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Unit {
  let (stmts, _, fn_defs, _, _, _) = ctx
  let errs = scps_st_errs(st)
  let mut def_idx = -1
  let mut fi = 0
  while fi < Array::length(fn_defs) {
    let (idx, _, _, name, _, _) = Array::get(fn_defs, fi)
    if name == fname {
      def_idx = idx
    } else {
      ()
    }
    fi = fi + 1
  }
  if def_idx < 0 {
    Array::push(errs, String::concat(String::concat("suspend lowering: internal error -- no top-level definition found for `", fname), "` while emitting its CPS clone (#817)"))
  } else {
    match Array::get(stmts, def_idx) {
      SLet(_, _, _, _, EFn(tps, tbs, params, _, _, fbody)) => {
        scps_ensure_effect_runtime(eff, ctx, st)
        let (_, decl_ops) = scps_effect_decl_ops(ctx, eff)
        let ops_qnames = array_empty_str()
        let mut oi = 0
        while oi < Array::length(decl_ops) {
          let (opname, _) = Array::get(decl_ops, oi)
          Array::push(ops_qnames, String::concat(String::concat(eff, "::"), opname))
          oi = oi + 1
        }
        let needing = scps_needing_for(ctx, eff)
        let site = scps_next_site(st)
        // closure-CPS (追記31 Vertical B): the clone's own params whose
        // annotated row carries the effect are step-typed closure sources
        // (`run_with(f: () -> T with E)` called from a suspend body).
        let cps_seed = array_empty_str()
        let mut cpi = 0
        while cpi < Array::length(params) {
          let (pnm, pty) = Array::get(params, cpi)
          let prow = scps_ty_row(pty)
          if prow != "" && scps_row_contains(ctx, prow, eff) {
            Array::push(cps_seed, pnm)
          } else {
            ()
          }
          cpi = cpi + 1
        }
        // #1536 (a): a row-free (or concrete eff-free row) function-typed
        // param whose every by-name call site provably receives a
        // suspend-inert value is renamed into the reserved __scps_inert_
        // namespace inside this clone, which both eligibility walkers
        // already accept and the split leaves as a plain call (see the
        // inert see-through block above). An unproven param stays as-is
        // and keeps the existing rejection.
        let cparams = scps_empty_params()
        // Explicit authority for compiler-renamed inert parameters. Do not
        // infer this from the reserved spelling: source may use that prefix.
        let inert_generated = array_empty_str()
        let mut fbody2 = fbody
        let mut ipi = 0
        while ipi < Array::length(params) {
          let (pnm, pty) = Array::get(params, ipi)
          let prow = scps_ty_row(pty)
          let in_seed = edp_str_array_contains(cps_seed, pnm)
          let candidate = match pty {
            Some(TyFn(_, _, _)) => !in_seed && !scps_row_contains(ctx, prow, eff) && !scps_row_has_var(prow),
            _ => false
          }
          if candidate && scps_param_slot_inert(fname, ipi, eff, needing, ctx, array_empty_str()) {
            let inm = String::concat(String::concat(scps_local("__scps_inert_", site), "_"), pnm)
            Array::push(cparams, (inm, pty))
            Array::push(inert_generated, inm)
            fbody2 = scps_rename_ident(fbody2, pnm, inm)
          } else {
            Array::push(cparams, (pnm, pty))
          }
          ipi = ipi + 1
        }
        let sctx = (eff, ops_qnames, needing, site, cps_seed)
        let call_scope = scps_scope_from_params(cparams, eff, inert_generated, ctx)
        if !scps_calls_ok(fbody2, sctx, ctx, call_scope) {
          // #1536 / #1514 parity: name the offending call inside `fname`'s
          // body. The offset indexes the module that defines `fname`, which
          // may not be the entry file -- verify_culprit_off_marker degrades
          // a basis mismatch to the unlocated message.
          let (culprit_clause, culprit_marker) = scps_culprit_parts(fbody2, sctx, ctx, call_scope)
          let mut scps_msg = String::concat(String::concat(String::concat("function `", fname), String::concat("` (whose row carries ", eff)), ") is called from a suspend-class handle body, but its own body calls something the suspend lowering cannot see through (a local closure, a method-style callee, a nested handle, or a row-variable callee)")
          scps_msg = String::concat(scps_msg, culprit_clause)
          scps_msg = String::concat(scps_msg, " (#817, ADR-0076 Phase 3b)")
          scps_msg = String::concat(scps_msg, culprit_marker)
          Array::push(errs, scps_msg)
        } else {
          // #1536: `return v` in this body means "this function's value is v",
          // which is what its tail means -- hoist it there. Anything left
          // unreachable by that hoist is refused below rather than split.
          // #1536: rewrite `for x in xs` over a PROVED array into the indexed
          // while form first -- the split handles `while`, and the proof comes
          // from this function's own parameter annotations plus array literals
          // bound on the spine, so no checker channel is needed.
          let fbody2a = scps_elim_array_for(fbody2, scps_array_names_seed(cparams), scps_string_names_seed(cparams), site, scps_anf_ctr(), ctx)
          let fbody3 = scps_elim_returns(match scps_elim_loop_returns(fbody2a, site) {
            Some(lifted) => lifted,
            None => fbody2a
          }, site)
          if scps_body_has_return(fbody3) {
            Array::push(errs, scps_return_in_split_msg(String::concat(String::concat(String::concat("function `", fname), String::concat("` (whose row carries ", eff)), ") is called from a suspend-class handle body, so its body")))
          } else {
            let (split_ok, split_body) = scps_split_tail(fbody3, sctx, ctx, st)
            if !split_ok {
              Array::push(errs, String::concat(String::concat(String::concat("function `", fname), String::concat("` (whose row carries ", eff)), ") is called from a suspend-class handle body, but a perform of that effect (or a call to a function that performs it) is not directly on its body's let/seq/tail/branch-tail spine (a loop body containing `return`, a `for` form, nested closures/handles, and a selected `&&` / `||` right operand that transfers control with `return` / `break` / `continue` are not eligible; a suspension inside an `if` / `match` branch or a `&&` / `||` right operand IS eligible wherever the selection or the short-circuit itself is strictly evaluated (a statement, the tail, the whole value of a `let` / `let mut` / assignment, or a strictly evaluated part of a compound); a `while` / `loop` spine is, including one carrying `break` / `continue`, and so is a suspension inside an operand, a call argument or a constructor payload, #1230/#1536) (#817, ADR-0076 Phase 3b)"))
            } else {
              Array::push(scps_st_inj(st), SLet(false, true, scps_clone_name(eff, fname), None, EFn(tps, tbs, cparams, None, None, split_body)))
            }
          }
        }
      },
      _ => Array::push(errs, String::concat(String::concat("suspend lowering: internal error -- `", fname), "` is not a plain top-level function definition (#817)"))
    }
  }
}

// --- the whole-program rewrite walk. Bottom-up at EHandle: inner sites
// transform first, then this site's own trigger is evaluated on the
// already-rewritten arms/body. closure-CPS (追記31 Vertical B): the walk
// threads a lexical `scope` of (name, row) pairs -- fn params with their
// annotated row (or "" mask), let-bound step-split literals with the
// effect they were split for, every other binder as a "" mask -- so a
// transform site can seed its step-typed closure bindings.

fn scps_scope_push_pat(p: Pat, scope: Array[(String, String)]) -> Unit {
  match p {
    PBind(n) => Array::push(scope, (n, "")),
    PCtor(_, ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        scps_scope_push_pat(Array::get(ps, i), scope)
        i = i + 1
      }
    },
    PTuple(ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        scps_scope_push_pat(Array::get(ps, i), scope)
        i = i + 1
      }
    },
    POr(a, b) => {
      scps_scope_push_pat(a, scope)
      scps_scope_push_pat(b, scope)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        scps_scope_push_pat(fp, scope)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// The row to record for a let binding of `v`: the effect a step-split
/// literal was split for, else "" (mask).
fn scps_let_bind_row(v: Expr, cps_effs: Array[String]) -> String {
  let mut row = ""
  let mut i = 0
  while i < Array::length(cps_effs) {
    let eff = Array::get(cps_effs, i)
    if row == "" && scps_literal_is_step_for(v, eff) {
      row = eff
    } else {
      ()
    }
    i = i + 1
  }
  row
}

fn scps_rewrite(e: Expr, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), cps_effs: Array[String], scope: Array[(String, String)]) -> Expr {
  match e {
    EHandle(body, arms) => {
      let rbody = scps_rewrite(body, ctx, st, cps_effs, scope)
      let rarms = for a in arms {
        let (p, ex) = a
        let amark = Array::length(scope)
        scps_scope_push_pat(p, scope)
        let rex = scps_rewrite(ex, ctx, st, cps_effs, scope)
        Array::truncate(scope, amark)
        (p, rex)
      }
      let mut triggered = false
      let mut ai = 0
      while ai < Array::length(rarms) {
        let (ap, ab) = Array::get(rarms, ai)
        if scps_arm_refs_resume_value(ab, scps_pat_binds_resume(ap)) {
          triggered = true
        } else {
          ()
        }
        ai = ai + 1
      }
      if triggered {
        // #1536: a `return` in a HANDLE body means "leave the enclosing
        // function", not "the handle's value", so it cannot be hoisted to the
        // body's tail the way a function's own return is. The value is
        // recorded in a cell declared OUTSIDE the handle, the body finishes
        // with a placeholder, and the real return happens after the handle --
        // where it is an ordinary spine return the hoist handles if this whole
        // thing is itself inside a body being split.
        if scps_body_has_return(rbody) {
          let hsite = scps_next_site(st)
          let probe = EHandle(rbody, rarms)
          let flag = scps_seq_float_fresh("hreturned", probe, EUnit, hsite)
          let slot = scps_seq_float_fresh("hretslot", probe, EUnit, hsite)
          let hv = scps_seq_float_fresh("hvalue", probe, EUnit, hsite)
          // The loop pass lifts a loop return onto the spine as an ordinary
          // `return`; the capture then turns THAT into the cell write, so the
          // two compose without the loop pass knowing about the cell.
          let captured = scps_elim_returns_to(match scps_elim_loop_returns(rbody, hsite) {
            Some(lifted) => lifted,
            None => rbody
          }, hsite, flag, slot)
          if scps_body_has_return(captured) {
            Array::push(scps_st_errs(st), scps_return_in_split_msg("a handler arm captures `resume` as a value, so this handle body"))
            EHandle(rbody, rarms)
          } else {
            let inner = match scps_transform_handle(captured, rarms, ctx, st, scope) {
              Some(t) => t,
              None => EHandle(captured, rarms)
            }
            ELetMut(flag, EBool(false), ELetMut(slot, EInt(0), ELet(hv, inner, EIf(EIdent(flag, -1), EReturn(EIdent(slot, -1)), EIdent(hv, -1)), -1), -1), -1)
          }
        } else {
          match scps_transform_handle(rbody, rarms, ctx, st, scope) {
            Some(t) => t,
            None => EHandle(rbody, rarms)
          }
        }
      } else {
        EHandle(rbody, rarms)
      }
    },
    EFn(tps, tbs, params, ret, eff, b) => {
      let fmark = Array::length(scope)
      let mut fpi = 0
      while fpi < Array::length(params) {
        let (pnm, pty) = Array::get(params, fpi)
        Array::push(scope, (pnm, scps_ty_row(pty)))
        fpi = fpi + 1
      }
      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)
      Array::truncate(scope, fmark)
      EFn(tps, tbs, params, ret, eff, rb)
    },
    ELet(n, v, b, off) => {
      let rv = scps_rewrite(v, ctx, st, cps_effs, scope)
      let lmark = Array::length(scope)
      Array::push(scope, (n, scps_let_bind_row(rv, cps_effs)))
      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)
      Array::truncate(scope, lmark)
      ELet(n, rv, rb, off)
    },
    ELetMut(n, v, b, off) => {
      let rv = scps_rewrite(v, ctx, st, cps_effs, scope)
      let lmark = Array::length(scope)
      Array::push(scope, (n, ""))
      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)
      Array::truncate(scope, lmark)
      ELetMut(n, rv, rb, off)
    },
    ELetRec(n, v, b) => {
      let lmark = Array::length(scope)
      Array::push(scope, (n, ""))
      let rv = scps_rewrite(v, ctx, st, cps_effs, scope)
      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)
      Array::truncate(scope, lmark)
      ELetRec(n, rv, rb)
    },
    ESeq(a, b) => ESeq(scps_rewrite(a, ctx, st, cps_effs, scope), scps_rewrite(b, ctx, st, cps_effs, scope)),
    EIf(c, t, el) => EIf(scps_rewrite(c, ctx, st, cps_effs, scope), scps_rewrite(t, ctx, st, cps_effs, scope), scps_rewrite(el, ctx, st, cps_effs, scope)),
    EMatch(s, arms) => EMatch(scps_rewrite(s, ctx, st, cps_effs, scope), for a in arms {
      let (p, ex) = a
      let amark = Array::length(scope)
      scps_scope_push_pat(p, scope)
      let rex = scps_rewrite(ex, ctx, st, cps_effs, scope)
      Array::truncate(scope, amark)
      (p, rex)
    }),
    EWhile(c, b) => EWhile(scps_rewrite(c, ctx, st, cps_effs, scope), scps_rewrite(b, ctx, st, cps_effs, scope)),
    EForIn(n, idx, it, b) => {
      let rit = scps_rewrite(it, ctx, st, cps_effs, scope)
      let fmark = Array::length(scope)
      Array::push(scope, (n, ""))
      match idx {
        Some(ix) => Array::push(scope, (ix, "")),
        None => ()
      }
      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)
      Array::truncate(scope, fmark)
      EForIn(n, idx, rit, rb)
    },
    ECall(callee, args, off) => ECall(scps_rewrite(callee, ctx, st, cps_effs, scope), for a in args {
      scps_rewrite(a, ctx, st, cps_effs, scope)
    }, off),
    EBinOp(op, l, r, boff) => EBinOp(op, scps_rewrite(l, ctx, st, cps_effs, scope), scps_rewrite(r, ctx, st, cps_effs, scope), boff),
    EUnaryOp(op, e2) => EUnaryOp(op, scps_rewrite(e2, ctx, st, cps_effs, scope)),
    EAssign(n, v, c) => EAssign(n, scps_rewrite(v, ctx, st, cps_effs, scope), scps_rewrite(c, ctx, st, cps_effs, scope)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, scps_rewrite(v, ctx, st, cps_effs, scope), scps_rewrite(c, ctx, st, cps_effs, scope)),
    EDot(o, f, off1, off2) => EDot(scps_rewrite(o, ctx, st, cps_effs, scope), f, off1, off2),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, scps_rewrite(v, ctx, st, cps_effs, scope)),
    EReturn(e2) => EReturn(scps_rewrite(e2, ctx, st, cps_effs, scope)),
    EBreak(opt) => EBreak(match opt {
      Some(e2) => Some(scps_rewrite(e2, ctx, st, cps_effs, scope)),
      None => None
    }),
    EContinue(args) => EContinue(for a in args {
      scps_rewrite(a, ctx, st, cps_effs, scope)
    }),
    ETuple(elems) => ETuple(for a in elems {
      scps_rewrite(a, ctx, st, cps_effs, scope)
    }),
    EArray(elems) => EArray(for a in elems {
      scps_rewrite(a, ctx, st, cps_effs, scope)
    }),
    ERecord(n, fields, tas) => ERecord(n, for f in fields {
      let (fn2, v) = f
      (fn2, scps_rewrite(v, ctx, st, cps_effs, scope))
    }, tas),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, scps_rewrite(v, ctx, st, cps_effs, scope))
    }),
    ESpread(e2) => ESpread(scps_rewrite(e2, ctx, st, cps_effs, scope)),
    ELoop(pairs, b) => {
      let rpairs = for p in pairs {
        let (n, v) = p
        (n, scps_rewrite(v, ctx, st, cps_effs, scope))
      }
      let lmark = Array::length(scope)
      let mut lpi = 0
      while lpi < Array::length(pairs) {
        let (n, _) = Array::get(pairs, lpi)
        Array::push(scope, (n, ""))
        lpi = lpi + 1
      }
      let rb = scps_rewrite(b, ctx, st, cps_effs, scope)
      Array::truncate(scope, lmark)
      ELoop(rpairs, rb)
    },
    _ => e
  }
}

/// Additional builtins that are safe in a SUSPEND-lowered body but are
/// deliberately NOT on idp_pure_builtin_names: they MUTATE (Array::push /
/// Array::set / builder ops) or trap (assert), so adding them to the
/// shared list would newly change which handles Phase 2's INLINE pass
/// (and evidence_dict_pass) migrate off the replay path -- a behavior
/// change for replay-pinned fixtures this pass has no business making.
/// For the suspend lowering the only property that matters is the same
/// one the pure list encodes: checker-verified effect `None` and no
/// function-typed parameter, so the call can neither perform the handled
/// effect itself nor invoke a user closure that might. Each name below
/// was checked against the checker's builtin tables on those two axes.
fn scps_is_safe_mut_builtin(nm: String) -> Bool {
  let names = [
    "Array::push",
    "Array::set",
    "Array::slice",
    "ArrayBuilder::new",
    "ArrayBuilder::push",
    "ArrayBuilder::freeze",
    "Map::set",
    "Map::delete",
    "Bytes::set",
    "StringBuilder::new",
    "StringBuilder::push",
    "StringBuilder::freeze",
    // parser-desugar internals: `o.f = v` → __set_field(o, "f", v) and
    // `a[i]` → __index(a, i) (channel blocking slice — a suspend-class
    // clone body mutating a struct field, e.g. Channel.pend_seq, arrives
    // as a __set_field call). Both are checker-verified effect-free and
    // take no function-typed argument.
    "__set_field",
    "__index",
    "assert"
  ]
  let mut i = 0
  let mut found = false
  while i < Array::length(names) {
    if Array::get(names, i) == nm {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

// --- closure-CPS (追記31 Vertical B) whole-program phases.
//
// Phase 1 (collector): the set of effects with at least one TRIGGERED
// handle site anywhere -- the "CPS-mode" effects. Only these can require
// literal step-splitting.

fn scps_collect_cps_effs_expr(e: Expr, out: Array[String]) -> Unit {
  match e {
    EHandle(b, arms) => {
      scps_collect_cps_effs_expr(b, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ex) = Array::get(arms, i)
        if scps_arm_refs_resume_value(ex, scps_pat_binds_resume(p)) {
          match p {
            PCtor(q, _) => {
              let ci = String::index_of(q, "::")
              if ci > 0 {
                let qe = String::substring(q, 0, ci)
                if edp_str_array_contains(out, qe) {
                  ()
                } else {
                  Array::push(out, qe)
                }
              } else {
                ()
              }
            },
            _ => ()
          }
        } else {
          ()
        }
        scps_collect_cps_effs_expr(ex, out)
        i = i + 1
      }
    },
    EFn(_, _, _, _, _, b) => scps_collect_cps_effs_expr(b, out),
    ELet(_, v, b, _) => {
      scps_collect_cps_effs_expr(v, out)
      scps_collect_cps_effs_expr(b, out)
    },
    ELetMut(_, v, b, _) => {
      scps_collect_cps_effs_expr(v, out)
      scps_collect_cps_effs_expr(b, out)
    },
    ELetRec(_, v, b) => {
      scps_collect_cps_effs_expr(v, out)
      scps_collect_cps_effs_expr(b, out)
    },
    ESeq(a, b) => {
      scps_collect_cps_effs_expr(a, out)
      scps_collect_cps_effs_expr(b, out)
    },
    EIf(c, t, el) => {
      scps_collect_cps_effs_expr(c, out)
      scps_collect_cps_effs_expr(t, out)
      scps_collect_cps_effs_expr(el, out)
    },
    EMatch(s, arms) => {
      scps_collect_cps_effs_expr(s, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, i)
        scps_collect_cps_effs_expr(ex, out)
        i = i + 1
      }
    },
    ECall(callee, args, _) => {
      scps_collect_cps_effs_expr(callee, out)
      let mut i = 0
      while i < Array::length(args) {
        scps_collect_cps_effs_expr(Array::get(args, i), out)
        i = i + 1
      }
    },
    EWhile(c, b) => {
      scps_collect_cps_effs_expr(c, out)
      scps_collect_cps_effs_expr(b, out)
    },
    EForIn(_, _, it, b) => {
      scps_collect_cps_effs_expr(it, out)
      scps_collect_cps_effs_expr(b, out)
    },
    ELoop(pairs, b) => {
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, v) = Array::get(pairs, i)
        scps_collect_cps_effs_expr(v, out)
        i = i + 1
      }
      scps_collect_cps_effs_expr(b, out)
    },
    EBinOp(_, l, r, _) => {
      scps_collect_cps_effs_expr(l, out)
      scps_collect_cps_effs_expr(r, out)
    },
    EUnaryOp(_, x) => scps_collect_cps_effs_expr(x, out),
    EAssign(_, v, c) => {
      scps_collect_cps_effs_expr(v, out)
      scps_collect_cps_effs_expr(c, out)
    },
    EAssignOp(_, _, v, c) => {
      scps_collect_cps_effs_expr(v, out)
      scps_collect_cps_effs_expr(c, out)
    },
    EReturn(x) => scps_collect_cps_effs_expr(x, out),
    EDot(o, _, _, _) => scps_collect_cps_effs_expr(o, out),
    ELabeledArg(_, _, v) => scps_collect_cps_effs_expr(v, out),
    EBreak(opt) => match opt {
      Some(x) => scps_collect_cps_effs_expr(x, out),
      None => ()
    },
    EContinue(args) => {
      let mut i = 0
      while i < Array::length(args) {
        scps_collect_cps_effs_expr(Array::get(args, i), out)
        i = i + 1
      }
    },
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        scps_collect_cps_effs_expr(Array::get(items, i), out)
        i = i + 1
      }
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        scps_collect_cps_effs_expr(Array::get(items, i), out)
        i = i + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        scps_collect_cps_effs_expr(v, out)
        i = i + 1
      }
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        scps_collect_cps_effs_expr(v, out)
        i = i + 1
      }
    },
    ESpread(x) => scps_collect_cps_effs_expr(x, out),
    _ => ()
  }
}

fn scps_stmt_expr_of(s: Stmt) -> Option[Expr] {
  match s {
    SLet(_, _, _, _, expr) => Some(expr),
    SLetMut(_, _, expr) => Some(expr),
    SExpr(expr) => Some(expr),
    STest(_, expr) => Some(expr),
    SBench(_, expr) => Some(expr),
    _ => None
  }
}

fn scps_collect_cps_effs(stmts: Array[Stmt]) -> Array[String] {
  let out = array_empty_str()
  let mut i = 0
  while i < Array::length(stmts) {
    match scps_stmt_expr_of(Array::get(stmts, i)) {
      Some(expr) => scps_collect_cps_effs_expr(expr, out),
      None => ()
    }
    i = i + 1
  }
  out
}

// Does a literal BODY need eff -- a raw perform of a handled op or a call
// to a needing fn -- OUTSIDE any nested handle that itself discharges eff?
// (A literal whose performs are all under its own lexical `handle ... with
// eff` -- e.g. a TaskGroup::run body containing settle(handle {..}) -- is
// self-contained and must NOT be step-split.)

fn scps_lit_needs(e: Expr, sctx: (String, Array[String], Array[String], Int, Array[String])) -> Bool {
  edp_rq_fold(RQLiteralNeeds(sctx), e) > 0
}

// Phase 2 (prepass): step-split every EFn literal that needs a CPS-mode
// effect, and at call sites of known top-level fns rewrite arguments in
// E-row param positions (a pure literal gets Done-wrapped so it matches
// the step convention its consumer expects; a bare needing-fn reference
// becomes its CPS clone). Runs over ALL statements -- a spawn call site
// in user code carries no handle of its own.

fn scps_ecfg_for(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), eff: String) -> (String, Array[String], Array[String]) {
  let (_, decl_ops) = scps_effect_decl_ops(ctx, eff)
  let ops_qnames = array_empty_str()
  let mut oi = 0
  while oi < Array::length(decl_ops) {
    let (opname, _) = Array::get(decl_ops, oi)
    Array::push(ops_qnames, String::concat(String::concat(eff, "::"), opname))
    oi = oi + 1
  }
  (eff, ops_qnames, scps_needing_for(ctx, eff))
}

fn scps_fn_def_index(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), name: String) -> Int {
  let (_, _, fn_defs, _, _, _) = ctx
  let mut def_idx = -1
  let mut fi = 0
  while fi < Array::length(fn_defs) {
    let (idx, _, _, fnm, _, _) = Array::get(fn_defs, fi)
    if fnm == name {
      def_idx = idx
    } else {
      ()
    }
    fi = fi + 1
  }
  def_idx
}

fn scps_fn_def_params_at(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), def_idx: Int) -> Option[Array[(String, Option[TypeExpr])]] {
  let (stmts, _, _, _, _, _) = ctx
  if def_idx < 0 || def_idx >= Array::length(stmts) {
    None
  } else {
    match Array::get(stmts, def_idx) {
      SLet(_, _, _, _, EFn(_, _, params, _, _, _)) => Some(params),
      _ => None
    }
  }
}

fn scps_fn_def_params(ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), name: String) -> Option[Array[(String, Option[TypeExpr])]] {
  scps_fn_def_params_at(ctx, scps_fn_def_index(ctx, name))
}

// Prepass-only scope provenance. 0/1/2 retain the eligibility classes above;
// 3 + statement index means this local is an immutable alias of that known
// top-level function, so its parameter convention must survive the rename.
fn scps_prepass_alias_class(scope: Array[(String, Int)], target: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Int {
  let local = scps_local_class(scope, target)
  if local >= 3 {
    local
  } else if local >= 0 {
    0
  } else {
    let def_idx = scps_fn_def_index(ctx, target)
    if def_idx >= 0 {
      def_idx + 3
    } else {
      0
    }
  }
}

fn scps_prepass_bind_local(scope: Array[(String, Int)], name: String, value: Expr, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Array[(String, Int)] {
  let kind = match value {
    EIdent(target, _) => scps_prepass_alias_class(scope, target, ctx),
    _ => 0
  }
  scps_scope_bind(scope, name, kind)
}

fn scps_prepass_callee_params(scope: Array[(String, Int)], name: String, ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String])) -> Option[Array[(String, Option[TypeExpr])]] {
  let local = scps_local_class(scope, name)
  if local >= 3 {
    scps_fn_def_params_at(ctx, local - 3)
  } else if local >= 0 {
    None
  } else {
    scps_fn_def_params(ctx, name)
  }
}

/// Step-split one literal for `eff`. Pushes errors on ineligibility;
/// returns the literal unchanged in that case (the error is fatal anyway).
fn scps_split_literal(tps: Array[String], tbs: Array[(String, Array[String])], params: Array[(String, Option[TypeExpr])], b: Expr, ecfg: (String, Array[String], Array[String]), ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String])) -> Expr {
  let (eff, ops_qnames, needing) = ecfg
  let errs = scps_st_errs(st)
  let site = scps_next_site(st)
  let cps_seed = array_empty_str()
  let mut cpi = 0
  while cpi < Array::length(params) {
    let (pnm, pty) = Array::get(params, cpi)
    let prow = scps_ty_row(pty)
    if prow != "" && scps_row_contains(ctx, prow, eff) {
      Array::push(cps_seed, pnm)
    } else {
      ()
    }
    cpi = cpi + 1
  }
  let sctx = (eff, ops_qnames, needing, site, cps_seed)
  let call_scope = scps_scope_from_params(params, eff, array_empty_str(), ctx)
  if !scps_calls_ok(b, sctx, ctx, call_scope) {
    // #1536 / #1514 parity: name the offending call in the literal's body.
    let (culprit_clause, culprit_marker) = scps_culprit_parts(b, sctx, ctx, call_scope)
    let mut scps_msg = String::concat(String::concat("a closure literal whose row carries ", eff), " (suspend class, ADR-0076 追記31 Vertical B) calls something the suspend lowering cannot see through (a local closure, a method-style callee, a nested handle, or a row-variable callee)")
    scps_msg = String::concat(scps_msg, culprit_clause)
    scps_msg = String::concat(scps_msg, " (#817)")
    scps_msg = String::concat(scps_msg, culprit_marker)
    Array::push(errs, scps_msg)
    EFn(tps, tbs, params, None, None, b)
  } else if scps_body_has_return(scps_elim_returns(match scps_elim_loop_returns(b, site) {
    Some(lifted) => lifted,
    None => b
  }, site)) {
    Array::push(errs, scps_return_in_split_msg(String::concat(String::concat("a closure literal whose row carries ", eff), " (suspend class) is split into continuations, so its body")))
    EFn(tps, tbs, params, None, None, b)
  } else {
    // #1536: same hoist -- `return v` in a closure literal is that closure's
    // own value, which is what its tail is.
    let (split_ok, split_body) = scps_split_tail(scps_elim_array_for(scps_elim_returns(match scps_elim_loop_returns(b, site) {
      Some(lifted) => lifted,
      None => b
    }, site), scps_array_names_seed(params), scps_string_names_seed(params), site, scps_anf_ctr(), ctx), sctx, ctx, st)
    if !split_ok {
      Array::push(errs, String::concat(String::concat("a closure literal whose row carries ", eff), " (suspend class, ADR-0076 追記31 Vertical B) performs it (or calls a function that performs it) off the let/seq/tail/branch-tail spine (a loop body containing `return`, a `for` form, nested closures/handles, and a selected `&&` / `||` right operand that transfers control with `return` / `break` / `continue` are not eligible; a suspension inside an `if` / `match` branch or a `&&` / `||` right operand IS eligible wherever the selection or the short-circuit itself is strictly evaluated (a statement, the tail, the whole value of a `let` / `let mut` / assignment, or a strictly evaluated part of a compound); a `while` / `loop` spine is, including one carrying `break` / `continue`, and so is a suspension inside an operand, a call argument or a constructor payload, #1230/#1536) (#817)"))
      EFn(tps, tbs, params, None, None, b)
    } else {
      scps_ensure_effect_runtime(eff, ctx, st)
      EFn(tps, tbs, params, None, None, split_body)
    }
  }
}

fn scps_prepass_expr(e: Expr, ecfgs: Array[(String, Array[String], Array[String])], ctx: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(Int, Bool, Bool, String, Option[TypeExpr], String)], Array[String], Array[Array[String]], Array[String]), st: (Array[Int], Array[String], Array[String], Array[String], Array[String], Array[Stmt], Array[String]), split_effs: Array[String], scope: Array[(String, Int)]) -> Expr {
  match e {
    EFn(tps, tbs, params, ret, eff, b) => {
      let b2 = scps_prepass_expr(b, ecfgs, ctx, st, split_effs, scps_scope_bind_params(scope, params, "", ctx))
      let mut hit_eff = ""
      let mut multi = false
      let mut ei = 0
      while ei < Array::length(ecfgs) {
        let (ceff, cops, cneeding) = Array::get(ecfgs, ei)
        let probe = (ceff, cops, cneeding, 0, array_empty_str())
        if scps_lit_needs(b2, probe) {
          if hit_eff == "" {
            hit_eff = ceff
          } else {
            multi = true
          }
        } else {
          ()
        }
        ei = ei + 1
      }
      if multi {
        Array::push(scps_st_errs(st), "a closure literal raw-performs more than one suspend-class effect -- not supported (split the effect or handle one of them inside the literal) (ADR-0076 追記31 Vertical B)")
        EFn(tps, tbs, params, ret, eff, b2)
      } else if hit_eff != "" {
        let mut cfg = ("", array_empty_str(), array_empty_str())
        let mut ci = 0
        while ci < Array::length(ecfgs) {
          let (ceff, _, _) = Array::get(ecfgs, ci)
          if ceff == hit_eff {
            cfg = Array::get(ecfgs, ci)
          } else {
            ()
          }
          ci = ci + 1
        }
        if edp_str_array_contains(split_effs, hit_eff) {
          ()
        } else {
          Array::push(split_effs, hit_eff)
        }
        scps_split_literal(tps, tbs, params, b2, cfg, ctx, st)
      } else {
        EFn(tps, tbs, params, ret, eff, b2)
      }
    },
    ECall(callee, args, off) => {
      let mut rcallee = scps_prepass_expr(callee, ecfgs, ctx, st, split_effs, scope)
      let rargs = for a in args {
        scps_prepass_expr(a, ecfgs, ctx, st, split_effs, scope)
      }
      // arg-position convention fixups against the callee's declared params.
      //
      // #1723: this lookup is BY NAME against the module's top level and this
      // walk tracks no local bindings, so a local shadowing `fname` would have
      // the top-level function's parameter rows applied to a call that never
      // reaches it -- Done-wrapping a pure literal the local closure then calls
      // under the plain convention (the #1707 shape, inverted). It is currently
      // unreachable ONLY because the checker refuses those programs first, and
      // it refuses them for the same shadowing reason (#1723 is that bug). Fix
      // the checker and this opens: thread a locals set through
      // scps_prepass_expr in the same change.
      match rcallee {
        EIdent(fname, _) => {
          match scps_prepass_callee_params(scope, fname, ctx) {
            Some(fparams) => {
              let mut aj = 0
              while aj < Array::length(rargs) {
                if aj < Array::length(fparams) {
                  let (_, pty) = Array::get(fparams, aj)
                  let prow = scps_ty_row(pty)
                  // #1707: the mirror of the fixup below. A literal the prepass
                  // STEP-SPLIT returns `__ScpsStep_E`, so it may only land in a
                  // parameter whose declared row carries E. Passed to a plain
                  // parameter, the callee calls it under the ordinary convention
                  // and hands the step OBJECT back as the value -- that compiled
                  // clean and silently returned a heap pointer as an Int.
                  let mut ei0 = 0
                  while ei0 < Array::length(ecfgs) {
                    let (ceff0, _, _) = Array::get(ecfgs, ei0)
                    // A parameter whose row is a row VARIABLE is exempt: the
                    // variable can be instantiated to this effect at the call
                    // site, which is exactly what makes
                    // `TaskGroup::run[T, rg, e](body: (..) -> T with e)` able to
                    // receive a step-returning literal. Only a CONCRETE row that
                    // does not carry the effect is a plain-convention parameter.
                    if !scps_row_has_var(prow) && !scps_row_contains(ctx, prow, ceff0) && scps_literal_is_step_for(Array::get(rargs, aj), ceff0) {
                      Array::push(scps_st_errs(st), String::concat(String::concat(String::concat("a closure literal that performs `", ceff0), "` (so it is compiled to return a step) is passed to a parameter of `"), String::concat(String::concat(fname, "` whose type does not declare that effect -- the callee would call it under the plain convention and hand the step object back as the value. Declare the parameter as `(..) -> .. with "), String::concat(ceff0, "`, or move the performing call out of the literal (#1707, ADR-0076 追記31 Vertical B)"))))
                    } else {
                      ()
                    }
                    ei0 = ei0 + 1
                  }
                  if prow != "" {
                    let mut ei2 = 0
                    while ei2 < Array::length(ecfgs) {
                      let (ceff, _, cneeding) = Array::get(ecfgs, ei2)
                      if scps_row_contains(ctx, prow, ceff) {
                        match Array::get(rargs, aj) {
                          EFn(atps, atbs, aparams, aret, aeff, ab) => if scps_literal_is_step_for(Array::get(rargs, aj), ceff) {
                            ()
                          } else {
                            // pure literal in an E-row position: Done-wrap so
                            // it matches the step convention.
                            let mut cfg2 = ("", array_empty_str(), array_empty_str())
                            let mut ci2 = 0
                            while ci2 < Array::length(ecfgs) {
                              let (ceff2, _, _) = Array::get(ecfgs, ci2)
                              if ceff2 == ceff {
                                cfg2 = Array::get(ecfgs, ci2)
                              } else {
                                ()
                              }
                              ci2 = ci2 + 1
                            }
                            if edp_str_array_contains(split_effs, ceff) {
                              ()
                            } else {
                              Array::push(split_effs, ceff)
                            }
                            Array::set(rargs, aj, scps_split_literal(atps, atbs, aparams, ab, cfg2, ctx, st))
                          },
                          EIdent(anm, aoff) => if edp_str_array_contains(cneeding, anm) {
                            scps_need_clone(ceff, anm, st)
                            if edp_str_array_contains(split_effs, ceff) {
                              ()
                            } else {
                              Array::push(split_effs, ceff)
                            }
                            Array::set(rargs, aj, EIdent(scps_clone_name(ceff, anm), aoff))
                          } else {
                            ()
                          },
                          _ => ()
                        }
                      } else {
                        ()
                      }
                      ei2 = ei2 + 1
                    }
                  } else {
                    ()
                  }
                } else {
                  ()
                }
                aj = aj + 1
              }
            },
            None => ()
          }
        },
        _ => ()
      }
      ECall(rcallee, rargs, off)
    },
    EHandle(b, arms) => EHandle(scps_prepass_expr(b, ecfgs, ctx, st, split_effs, scope), for a in arms {
      let (p, ex) = a
      (p, scps_prepass_expr(ex, ecfgs, ctx, st, split_effs, scps_scope_bind_pat(scope, p)))
    }),
    ELet(n, v, b, off) => {
      let v2 = scps_prepass_expr(v, ecfgs, ctx, st, split_effs, scope)
      ELet(n, v2, scps_prepass_expr(b, ecfgs, ctx, st, split_effs, scps_prepass_bind_local(scope, n, v2, ctx)), off)
    },
    ELetMut(n, v, b, off) => ELetMut(n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs, scope), scps_prepass_expr(b, ecfgs, ctx, st, split_effs, scps_scope_bind(scope, n, 0)), off),
    ELetRec(n, v, b) => {
      let inner = scps_scope_bind(scope, n, 0)
      ELetRec(n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs, inner), scps_prepass_expr(b, ecfgs, ctx, st, split_effs, inner))
    },
    ESeq(a, b) => ESeq(scps_prepass_expr(a, ecfgs, ctx, st, split_effs, scope), scps_prepass_expr(b, ecfgs, ctx, st, split_effs, scope)),
    EIf(c, t, el) => EIf(scps_prepass_expr(c, ecfgs, ctx, st, split_effs, scope), scps_prepass_expr(t, ecfgs, ctx, st, split_effs, scope), scps_prepass_expr(el, ecfgs, ctx, st, split_effs, scope)),
    EMatch(s, arms) => EMatch(scps_prepass_expr(s, ecfgs, ctx, st, split_effs, scope), for a in arms {
      let (p, ex) = a
      (p, scps_prepass_expr(ex, ecfgs, ctx, st, split_effs, scps_scope_bind_pat(scope, p)))
    }),
    EWhile(c, b) => EWhile(scps_prepass_expr(c, ecfgs, ctx, st, split_effs, scope), scps_prepass_expr(b, ecfgs, ctx, st, split_effs, scope)),
    EForIn(n, idx, it, b) => {
      let inner = scps_scope_bind_opt(scps_scope_bind(scope, n, 0), idx, 0)
      EForIn(n, idx, scps_prepass_expr(it, ecfgs, ctx, st, split_effs, scope), scps_prepass_expr(b, ecfgs, ctx, st, split_effs, inner))
    },
    EBinOp(op, l, r, boff) => EBinOp(op, scps_prepass_expr(l, ecfgs, ctx, st, split_effs, scope), scps_prepass_expr(r, ecfgs, ctx, st, split_effs, scope), boff),
    EUnaryOp(op, x) => EUnaryOp(op, scps_prepass_expr(x, ecfgs, ctx, st, split_effs, scope)),
    EAssign(n, v, c) => EAssign(n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs, scope), scps_prepass_expr(c, ecfgs, ctx, st, split_effs, scope)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, scps_prepass_expr(v, ecfgs, ctx, st, split_effs, scope), scps_prepass_expr(c, ecfgs, ctx, st, split_effs, scope)),
    EDot(o, f, off1, off2) => EDot(scps_prepass_expr(o, ecfgs, ctx, st, split_effs, scope), f, off1, off2),
    ELabeledArg(l, n, v) => ELabeledArg(l, n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs, scope)),
    EReturn(x) => EReturn(scps_prepass_expr(x, ecfgs, ctx, st, split_effs, scope)),
    EBreak(opt) => EBreak(match opt {
      Some(x) => Some(scps_prepass_expr(x, ecfgs, ctx, st, split_effs, scope)),
      None => None
    }),
    EContinue(args) => EContinue(for a in args {
      scps_prepass_expr(a, ecfgs, ctx, st, split_effs, scope)
    }),
    ETuple(items) => ETuple(for a in items {
      scps_prepass_expr(a, ecfgs, ctx, st, split_effs, scope)
    }),
    EArray(items) => EArray(for a in items {
      scps_prepass_expr(a, ecfgs, ctx, st, split_effs, scope)
    }),
    ERecord(n, fields, tas) => ERecord(n, for f in fields {
      let (fn2, v) = f
      (fn2, scps_prepass_expr(v, ecfgs, ctx, st, split_effs, scope))
    }, tas),
    EMap(fields) => EMap(for f in fields {
      let (fn2, v) = f
      (fn2, scps_prepass_expr(v, ecfgs, ctx, st, split_effs, scope))
    }),
    ESpread(x) => ESpread(scps_prepass_expr(x, ecfgs, ctx, st, split_effs, scope)),
    ELoop(pairs, b) => {
      let names = array_empty_str()
      let rpairs = for p in pairs {
        let (n, v) = p
        Array::push(names, n)
        (n, scps_prepass_expr(v, ecfgs, ctx, st, split_effs, scope))
      }
      ELoop(rpairs, scps_prepass_expr(b, ecfgs, ctx, st, split_effs, scps_scope_bind_names(scope, names, 0)))
    },
    _ => e
  }
}

// Phase 5 (guard): once ANY literal/arg was step-compiled for an effect,
// the step convention is global for that effect's closure values -- an
// UNTRIGGERED handle for it left in the program (evidence/Phase 2/replay
// bound) would call them under the value convention. v1: hard error.

fn scps_guard_untriggered(e: Expr, guard_effs: Array[String], errs: Array[String]) -> Unit {
  match e {
    EHandle(b, arms) => {
      scps_guard_untriggered(b, guard_effs, errs)
      if Array::length(arms) > 0 {
        let (p0, _) = Array::get(arms, 0)
        match p0 {
          PCtor(q, _) => {
            let ci = String::index_of(q, "::")
            if ci > 0 && edp_str_array_contains(guard_effs, String::substring(q, 0, ci)) {
              Array::push(errs, String::concat(String::concat("effect ", String::substring(q, 0, ci)), " has step-compiled closure values (a literal or argument was CPS-lowered for it), but this handle for it does not capture `resume` as a value -- mixing the step convention with tail-resumptive/replay handling of the same effect is not supported; split the effect or make every handler suspend-class (ADR-0076 追記31 Vertical B)"))
            } else {
              ()
            }
          },
          _ => ()
        }
      } else {
        ()
      }
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, i)
        scps_guard_untriggered(ex, guard_effs, errs)
        i = i + 1
      }
    },
    EFn(_, _, _, _, _, b) => scps_guard_untriggered(b, guard_effs, errs),
    ELet(_, v, b, _) => {
      scps_guard_untriggered(v, guard_effs, errs)
      scps_guard_untriggered(b, guard_effs, errs)
    },
    ELetMut(_, v, b, _) => {
      scps_guard_untriggered(v, guard_effs, errs)
      scps_guard_untriggered(b, guard_effs, errs)
    },
    ELetRec(_, v, b) => {
      scps_guard_untriggered(v, guard_effs, errs)
      scps_guard_untriggered(b, guard_effs, errs)
    },
    ESeq(a, b) => {
      scps_guard_untriggered(a, guard_effs, errs)
      scps_guard_untriggered(b, guard_effs, errs)
    },
    EIf(c, t, el) => {
      scps_guard_untriggered(c, guard_effs, errs)
      scps_guard_untriggered(t, guard_effs, errs)
      scps_guard_untriggered(el, guard_effs, errs)
    },
    EMatch(s, arms) => {
      scps_guard_untriggered(s, guard_effs, errs)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ex) = Array::get(arms, i)
        scps_guard_untriggered(ex, guard_effs, errs)
        i = i + 1
      }
    },
    ECall(callee, args, _) => {
      scps_guard_untriggered(callee, guard_effs, errs)
      let mut i = 0
      while i < Array::length(args) {
        scps_guard_untriggered(Array::get(args, i), guard_effs, errs)
        i = i + 1
      }
    },
    EWhile(c, b) => {
      scps_guard_untriggered(c, guard_effs, errs)
      scps_guard_untriggered(b, guard_effs, errs)
    },
    EForIn(_, _, it, b) => {
      scps_guard_untriggered(it, guard_effs, errs)
      scps_guard_untriggered(b, guard_effs, errs)
    },
    ELoop(pairs, b) => {
      let mut i = 0
      while i < Array::length(pairs) {
        let (_, v) = Array::get(pairs, i)
        scps_guard_untriggered(v, guard_effs, errs)
        i = i + 1
      }
      scps_guard_untriggered(b, guard_effs, errs)
    },
    EBinOp(_, l, r, _) => {
      scps_guard_untriggered(l, guard_effs, errs)
      scps_guard_untriggered(r, guard_effs, errs)
    },
    EUnaryOp(_, x) => scps_guard_untriggered(x, guard_effs, errs),
    EAssign(_, v, c) => {
      scps_guard_untriggered(v, guard_effs, errs)
      scps_guard_untriggered(c, guard_effs, errs)
    },
    EAssignOp(_, _, v, c) => {
      scps_guard_untriggered(v, guard_effs, errs)
      scps_guard_untriggered(c, guard_effs, errs)
    },
    EReturn(x) => scps_guard_untriggered(x, guard_effs, errs),
    EDot(o, _, _, _) => scps_guard_untriggered(o, guard_effs, errs),
    ELabeledArg(_, _, v) => scps_guard_untriggered(v, guard_effs, errs),
    EBreak(opt) => match opt {
      Some(x) => scps_guard_untriggered(x, guard_effs, errs),
      None => ()
    },
    EContinue(args) => {
      let mut i = 0
      while i < Array::length(args) {
        scps_guard_untriggered(Array::get(args, i), guard_effs, errs)
        i = i + 1
      }
    },
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        scps_guard_untriggered(Array::get(items, i), guard_effs, errs)
        i = i + 1
      }
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        scps_guard_untriggered(Array::get(items, i), guard_effs, errs)
        i = i + 1
      }
    },
    ERecord(_, fields, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        scps_guard_untriggered(v, guard_effs, errs)
        i = i + 1
      }
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, v) = Array::get(fields, i)
        scps_guard_untriggered(v, guard_effs, errs)
        i = i + 1
      }
    },
    ESpread(x) => scps_guard_untriggered(x, guard_effs, errs),
    _ => ()
  }
}

/// --- allocation-free trigger pre-scan (#1102 perf). scps_rewrite
/// reconstructs every node it walks, so running it unconditionally deep-
/// copied the ENTIRE program's top-level bodies on every compile — for a
/// program with no suspend-class handles at all (the compiler itself:
/// ~4k handles, every one a plain `with Exception`) that was pure allocation
/// churn, a measurable slice of the selfcompile heap KPI. This walk
/// allocates nothing and answers "does this expression contain ANY handle
/// arm that value-references `resume`?"; the pass skips fact-table
/// construction entirely when no statement triggers, and leaves
/// non-triggering statements' trees fully shared (unreconstructed).
fn scps_expr_has_trigger(e: Expr) -> Bool {
  edp_rq_fold(RQTrigger, e) > 0
}

fn scps_stmt_has_trigger(s: Stmt) -> Bool {
  match s {
    SLet(_, _, _, _, expr) => scps_expr_has_trigger(expr),
    SLetMut(_, _, expr) => scps_expr_has_trigger(expr),
    SExpr(expr) => scps_expr_has_trigger(expr),
    STest(_, expr) => scps_expr_has_trigger(expr),
    SBench(_, expr) => scps_expr_has_trigger(expr),
    _ => false
  }
}
