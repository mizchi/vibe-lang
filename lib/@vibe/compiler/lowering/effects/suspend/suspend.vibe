  Expr, Pat, Stmt, TypeExpr, expr_children, lookup_registry_builtin
}

import @vibe/core {
  array_empty
}

import @vibe/compiler/lowering/effects/direct {
  idp_arms_discharge_error, idp_is_pure_builtin_call
}

import @vibe/compiler/lowering/effects/evidence {
  edp_collect_effect_defs, edp_collect_fn_defs, edp_drop_shadowed_needing, edp_es_collect_into, edp_needing_names, edp_params_of_fn
}

import @vibe/compiler/lowering/effects/queries {
  EdpReadQuery,
  edp_row_is_exactly,
  edp_rq_arms,
  edp_rq_exprs,
  edp_rq_fold,
  edp_str_array_contains,
  scps_arm_refs_resume_value,
  scps_as_cps_local_call,
  scps_as_needing_call,
  scps_as_target_perform,
  scps_pat_binds_name,
