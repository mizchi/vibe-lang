// The suspend pass keeps one binder census for the statement list it lowers
// (#3856), as each statement's share of it, and refreshes only the statement
// it wrote (#4039). These pin what that rests on: the census is the kept one
// until it is dropped or told of a write; a reported write leaves it equal to
// one built again from scratch; the argument conditions keep the census they
// were handed; and alias inlining says when it changed the statements, so the
// pass knows when to drop it.
import @vibe/compiler/core {
  Expr, Stmt
}
import @vibe/core {
  struct MutSet
}
import @vibe/compiler/lowering/effects/evidence {
  edp_collect_fn_defs
}
import @vibe/compiler/lowering/effects/queries {
  edp_collect_program_binders, edp_is_program_binder
}
import @vibe/compiler/lowering/effects/suspend {
  scps_census,
  scps_census_appended,
  scps_census_drop,
  scps_census_kept,
  scps_census_note,
  scps_census_replaced,
  scps_inline_fn_aliases_stmts
}

fn top_fn(name: String, body: Expr) -> Stmt {
  SLet(false, false, name, None, EFn([], [], [], None, None, body))
}

fn call(_ name: String) -> Expr {
  ECall(EIdent(name, -1), [], -1, [])
}

fn binds(fname: String, x: String) -> Stmt {
  top_fn(name = fname, body = ELet(x, EInt(1), EIdent(x, -1), -1))
}

/// The kept census holds exactly the names one walked from scratch holds.
fn census_matches_rebuild(_ stmts: Array[Stmt]) -> Bool {
  let kept = scps_census(stmts)
  let fresh = edp_collect_program_binders(stmts)
  let mut same = MutSet::size(kept) == MutSet::size(fresh)
  for nm in MutSet::to_array(fresh) {
    if !MutSet::has(kept, x = nm) {
      same = false
    } else ()
  }
  same
}

test "the census is the kept one until it is dropped" {
  let stmts = [
    top_fn(name = "f", body = ELet("x", EInt(1), EIdent("x", -1), -1))
  ]
  scps_census_drop()
  inspect(MutSet::has(scps_census(stmts), x = "x"), content = "true")
  // A write the census has not been told about: it still answers for the
  // statements it was walked from.
  Array::set(stmts, at = 0, value = top_fn(name = "f", body = ELet("y", EInt(1), EIdent("y", -1), -1)))
  inspect(MutSet::has(scps_census(stmts), x = "y"), content = "false")
  scps_census_drop()
  inspect(MutSet::has(scps_census(stmts), x = "y"), content = "true")
  inspect(MutSet::has(scps_census(stmts), x = "x"), content = "false")
}

test "alias inlining says whether it changed the statements" {
  let plain = [
    top_fn(name = "f", body = EInt(1)),
    top_fn(name = "g", body = ELet("v", EInt(2), call("f"), -1))
  ]
  scps_census_drop()
  scps_census_note(plain)
  inspect(scps_inline_fn_aliases_stmts(stmts = plain, fn_defs = edp_collect_fn_defs(plain)), content = "false")
  let aliased = [
    top_fn(name = "f", body = EInt(1)),
    top_fn(name = "g", body = ELet("h", EIdent("f", -1), call("h"), -1))
  ]
  scps_census_drop()
  scps_census_note(aliased)
  inspect(scps_inline_fn_aliases_stmts(stmts = aliased, fn_defs = edp_collect_fn_defs(aliased)), content = "true")
  // The alias's `let` is gone, so a census kept from before no longer
  // describes the statements: the pass drops it after a `true`.
  scps_census_drop()
  inspect(MutSet::has(scps_census(aliased), x = "h"), content = "false")
}

test "a reported write refreshes that statement's share alone" {
  // `x` is bound by two statements: taking it out of one keeps it.
  let stmts = [binds(fname = "f", x = "x"), binds(fname = "g", x = "x")]
  scps_census_drop()
  inspect(MutSet::has(scps_census(stmts), x = "x"), content = "true")
  Array::set(stmts, at = 0, value = binds(fname = "f", x = "y"))
  scps_census_replaced(stmts = stmts, i = 0)
  inspect(MutSet::has(scps_census(stmts), x = "x"), content = "true")
  inspect(MutSet::has(scps_census(stmts), x = "y"), content = "true")
  inspect(census_matches_rebuild(stmts), content = "true")
  Array::set(stmts, at = 1, value = binds(fname = "g", x = "z"))
  scps_census_replaced(stmts = stmts, i = 1)
  inspect(MutSet::has(scps_census(stmts), x = "x"), content = "false")
  inspect(census_matches_rebuild(stmts), content = "true")
  // An index the kept census does not describe: it is built again.
  Array::push(stmts, value = binds(fname = "h", x = "w"))
  scps_census_replaced(stmts = stmts, i = 2)
  inspect(MutSet::has(scps_census(stmts), x = "w"), content = "true")
  inspect(census_matches_rebuild(stmts), content = "true")
}

test "appended statements add their shares" {
  let stmts = [binds(fname = "f", x = "x")]
  scps_census_drop()
  inspect(MutSet::has(scps_census(stmts), x = "x"), content = "true")
  Array::push(stmts, value = binds(fname = "g", x = "y"))
  Array::push(stmts, value = binds(fname = "h", x = "x"))
  scps_census_appended(stmts)
  inspect(MutSet::has(scps_census(stmts), x = "y"), content = "true")
  inspect(census_matches_rebuild(stmts), content = "true")
  // A list shorter than the kept one is not an append: built again.
  Array::truncate(stmts, length = 1)
  Array::set(stmts, at = 0, value = binds(fname = "f", x = "z"))
  scps_census_appended(stmts)
  inspect(MutSet::has(scps_census(stmts), x = "y"), content = "false")
  inspect(census_matches_rebuild(stmts), content = "true")
}

test "the argument conditions keep the census they were handed" {
  let stmts = [binds(fname = "f", x = "x")]
  scps_census_drop()
  scps_census_note(stmts)
  Array::set(stmts, at = 0, value = binds(fname = "f", x = "y"))
  scps_census_replaced(stmts = stmts, i = 0)
  // The kept census moved on; what was noted did not.
  inspect(MutSet::has(scps_census(stmts), x = "x"), content = "false")
  inspect(edp_is_program_binder("x"), content = "true")
  inspect(edp_is_program_binder("y"), content = "false")
  scps_census_note(stmts)
  inspect(edp_is_program_binder("y"), content = "true")
}

test "the kept census is offered only while it is kept, and as it stands" {
  // What `suspend_cps_pass` hands the handler-set split (#4041): the census
  // as the pass left it, or nothing, never one the pass dropped.
  let stmts = [binds(fname = "f", x = "x")]
  scps_census_drop()
  inspect(scps_census_kept() is None, content = "true")
  let _ = scps_census(stmts)
  Array::set(stmts, at = 0, value = binds(fname = "f", x = "y"))
  scps_census_replaced(stmts = stmts, i = 0)
  let offered = match scps_census_kept() {
    Some(kept) => MutSet::has(kept, x = "y") && !MutSet::has(kept, x = "x"),
    None => false
  }
  inspect(offered, content = "true")
  inspect(census_matches_rebuild(stmts), content = "true")
  scps_census_drop()
  inspect(scps_census_kept() is None, content = "true")
}
